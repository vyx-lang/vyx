        let registered = rt_registered_remaining(base);
        var span = bytes;
        if (registered > 0) { span = registered; }
        if (span <= 0) { return null; }
        let region = rt_alloc_bytes(56);
        if (region == null) { return null; }
        memset(region, 0, 56);
        rt_write_ptr(region, base);
        rt_write_i64(region + 8, span);
        if (owned != 0) { rt_write_i64(region + 16, 1); }
        rt_write_i64(region + 24, 1);
        rt_registry_acquire();
        rt_write_ptr(region + 48, runtime_pointer_regions);
        runtime_pointer_regions = region;
        rt_registry_release();
        rt_region_cache_store(base, bytes, owned, capability, region);
        return rt_pointer_tag(region, capability);
    }

    public fn vyx_pointer_allocation_register(base: rawptr, bytes: i64) -> rawptr {
        if (base == null || bytes <= 0) { return base; }
        rt_region_cache_bump_epoch();
        rt_registry_acquire();
        var allocation = runtime_pointer_allocations;
        while (allocation != null) {
            if (rt_read_ptr(allocation) == base) {
                rt_write_i64(allocation + 8, bytes);
                rt_write_i64(allocation + 16, 1);
                rt_registry_release();
                return base;
            }
            allocation = rt_read_ptr(allocation + 24);
        }
        allocation = rt_alloc_bytes(32);
        if (allocation == null) {
            rt_registry_release();
            abort();
            return null;
        }
        memset(allocation, 0, 32);
        rt_write_ptr(allocation, base);
        rt_write_i64(allocation + 8, bytes);
        rt_write_i64(allocation + 16, 1);
        rt_write_ptr(allocation + 24, runtime_pointer_allocations);
        runtime_pointer_allocations = allocation;
        rt_registry_release();
        return base;
    }

    public fn vyx_pointer_allocation_unregister(base: rawptr) {
        if (base == null) { return; }
        var bytes: i64 = 1;
        rt_registry_acquire();
        var allocation = runtime_pointer_allocations;
        while (allocation != null) {
            if (rt_read_i64(allocation + 16) != 0 && rt_read_ptr(allocation) == base) {
                bytes = rt_read_i64(allocation + 8);
                break;
            }
            allocation = rt_read_ptr(allocation + 24);
        }
        rt_registry_release();
        rt_invalidate_span(base, bytes);
    }

    public fn vyx_pointer_allocation_unregister_range(base: rawptr, bytes: i64) {
        rt_invalidate_span(base, bytes);
    }

    public fn vyx_pointer_allocation_realloc(old_base: rawptr,
                                             new_base: rawptr,
                                             bytes: i64) -> rawptr {
        if (new_base == null) { return null; }
        if (old_base != null) { vyx_pointer_allocation_unregister(old_base); }
        return vyx_pointer_allocation_register(new_base, bytes);
    }

    public fn vyx_pointer_region_retag(metadata: rawptr, capability: i32) -> rawptr {
        if (metadata == null) { return null; }
        if (capability < 0 || capability > 2) {
            abort();
            return null;
        }
        return rt_pointer_tag(rt_pointer_region(metadata), capability);
    }

    public fn vyx_pointer_region_set_dimension(metadata: rawptr,
                                                rank: i32,
                                                level: i32,
                                                extent: i64,
                                                stride: i64) {
        let region = rt_pointer_region(metadata);
        if (region == null || rank <= 0 || level < 0 || level >= rank
            || extent <= 0 || stride <= 0) {
            abort();
            return;
        }
        rt_registry_acquire();
        var dimensions = rt_read_ptr(region + 40);
        if (rt_read_i64(region + 32) != (rank as i64) || dimensions == null) {
            let replacement = rt_alloc_bytes((rank as i64) * 16);
            if (replacement == null) {
                rt_registry_release();
                abort();
                return;
            }
            memset(replacement, 0, ((rank as i64) * 16) as u64);
            if (dimensions != null) { free(dimensions); }
            dimensions = replacement;
            rt_write_ptr(region + 40, dimensions);
            rt_write_i64(region + 32, rank as i64);
        }
        rt_write_i64(dimensions + (level as i64) * 16, extent);
        rt_write_i64(dimensions + (level as i64) * 16 + 8, stride);
        rt_registry_release();
        rt_region_cache_evict(region);
    }

    public fn vyx_pointer_handle_alive(address: rawptr, metadata: rawptr) -> i32 {
        let region = rt_pointer_region(metadata);
        if (address != null && region != null
            && __vyx_atomic_load_i64_intrinsic(region + 24) != 0) {
            return 1;
        }
        return 0;
    }

    public fn vyx_pointer_region_rank(metadata: rawptr) -> i32 {
        let region = rt_pointer_region(metadata);
        if (region == null) { return 0; }
        return rt_read_i64(region + 32) as i32;
    }

    public fn vyx_pointer_checked_address(address: rawptr,
                                           metadata: rawptr,
                                           index: i64,
                                           element_size: i64) -> rawptr {
        return rt_pointer_checked_address(address, metadata, index, element_size, 0);
    }

    public fn vyx_pointer_checked_address_typed(address: rawptr,
                                                 metadata: rawptr,
                                                 index: i64,
                                                 element_size: i64,
                                                 pointer_depth: i32) -> rawptr {
        return rt_pointer_checked_address(address,
                                          metadata,
                                          index,
                                          element_size,
                                          pointer_depth);
    }

    public fn vyx_pointer_region_delete(metadata: rawptr) -> rawptr {
        let region = rt_pointer_region(metadata);
        if (region == null) { return null; }
        let capability = rt_pointer_capability(metadata);
        if (capability == 1 || capability == 2) {
            abort();
            return null;
        }
        let prior = __vyx_atomic_fetch_add_i64_intrinsic(region + 24, -1);
        if (prior != 1) {
            __vyx_atomic_fetch_add_i64_intrinsic(region + 24, 1);
            return null;
        }
        var released: rawptr = null;
        if (rt_read_i64(region + 16) != 0) { released = rt_read_ptr(region); }
        rt_write_ptr(region, null);
        rt_write_i64(region + 8, 0);
        return released;
    }
}
