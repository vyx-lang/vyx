// Clone and cmake-build oneTBB, then copy tbb12 into bootstrap_compiler/out.
// Invoked as `vyx: ../runtime/scripts/prepare_tbb.vyx` from bootstrap_compiler/.
use std.fs;
use std.process;
use std.string;

fn join2(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    if (a.endsWith("/") || a.endsWith("\\")) { return a + b; }
    return a + "/" + b;
}

fn sh(cmd: string) -> i32 {
    print("[tbb] " + cmd);
    return exec(cmd);
}

fn env_cstr(name: string) -> string {
    let p = env(name);
    if (p == null) { return ""; }
    return from_cstr(p);
}

fn is_windows() -> bool {
    // `OS=Windows_NT` is set by cmd.exe and PowerShell, but NOT by MSYS/Git Bash,
    // which strips it. Falling through to the Unix branch there makes cmake
    // receive a literal `$(nproc)` (Vyx's exec() does not go through a shell on
    // Windows) and the TBB prebuild hook fails. Probe more than one signal.
    if (env_cstr("OS") == "Windows_NT") { return true; }
    if (env_cstr("windir").len > 0) { return true; }
    if (env_cstr("SYSTEMROOT").len > 0) { return true; }
    if (env_cstr("COMSPEC").len > 0) { return true; }
    if (isDir("C:/Windows")) { return true; }
    return false;
}

fn find_llvm() -> string {
    var llvm = env_cstr("LLVM_ROOT");
    if (llvm.len == 0) {
        if (fileExists("../clang/bin/clang++.exe") || fileExists("../clang/bin/clang++")) {
            llvm = "../clang";
        } else {
            llvm = "/usr/lib/llvm-22";
        }
    }
    return llvm;
}

fn find_cxx() -> string {
    let llvm = find_llvm();
    if (is_windows()) {
        let cl = join2(llvm, "bin/clang-cl.exe");
        if (fileExists(cl)) { return cl; }
        let cxx = join2(llvm, "bin/clang++.exe");
        if (fileExists(cxx)) { return cxx; }
        return "clang-cl";
    }
    let cxx = join2(llvm, "bin/clang++");
    if (fileExists(cxx)) { return cxx; }
    return "clang++";
}

fn find_ninja() -> string {
    let llvm = find_llvm();
    if (is_windows()) {
        let a = join2(llvm, "bin/ninja.exe");
        if (fileExists(a)) { return a; }
    } else {
        let a = join2(llvm, "bin/ninja");
        if (fileExists(a)) { return a; }
    }
    return "ninja";
}

fn jobs() -> string {
    if (is_windows()) {
        let n = env_cstr("NUMBER_OF_PROCESSORS");
        if (n.len > 0) { return n; }
        // MSYS/Git Bash does not export NUMBER_OF_PROCESSORS. Returning empty
        // makes the caller omit --parallel so cmake/ninja pick their default
        // concurrency, which is better than hardcoding an arbitrary 4.
        return "";
    }
    return "$(nproc)";
}

fn ensure_dir(path: string) -> i32 {
    if (isDir(path) || fileExists(path)) { return 0; }
    if (is_windows()) { return makeDir(path); }
    return sh("mkdir -p \"" + path + "\"");
}

fn tbb_dll_path(build: string) -> string {
    let a = join2(build, "tbb_out_release/tbb12.dll");
    if (fileExists(a)) { return a; }
    let b = join2(build, "clang_22.1_cxx_64_md_release/tbb12.dll");
    if (fileExists(b)) { return b; }
    return "";
}

fn tbb_implib_path(build: string) -> string {
    let a = join2(build, "tbb_out_release/tbb12.lib");
    if (fileExists(a)) { return a; }
    let b = join2(build, "clang_22.1_cxx_64_md_release/tbb12.lib");
    if (fileExists(b)) { return b; }
    return "";
}

fn tbb_so_path(build: string) -> string {
    let a = join2(build, "tbb_out_release/libtbb.so");
    if (fileExists(a)) { return a; }
    let b = join2(build, "tbb_out_release/libtbb.so.12");
    if (fileExists(b)) { return b; }
    return "";
}

fn ensure_src(src: string, tag: string) -> i32 {
    let hdr = join2(src, "include/oneapi/tbb/parallel_for.h");
    if (fileExists(hdr)) { return 0; }
    if (ensure_dir("../runtime/vendor") != 0) { return 1; }
    return sh("git clone --depth 1 --branch " + tag
              + " https://github.com/uxlfoundation/oneTBB.git \"" + src + "\"");
}

fn ensure_build(src: string, build: string) -> i32 {
    if (is_windows()) {
        if (tbb_dll_path(build).len > 0 && tbb_implib_path(build).len > 0) { return 0; }
    } else {
        if (tbb_so_path(build).len > 0) { return 0; }
    }
    let cxx = find_cxx();
    let ninja = find_ninja();
    var cfg = "cmake -S \"" + src + "\" -B \"" + build + "\" -G Ninja"
            + " -DCMAKE_BUILD_TYPE=Release"
            + " -DCMAKE_CXX_COMPILER=\"" + cxx + "\""
            + " -DCMAKE_MAKE_PROGRAM=\"" + ninja + "\""
            + " -DTBB_TEST=OFF -DTBB4PY_BUILD=OFF -DTBBMALLOC_BUILD=OFF"
            + " -DTBB_STRICT=OFF -DTBB_ENABLE_IPO=OFF"
            + " -DTBB_OUTPUT_DIR_BASE=tbb_out";
    if (is_windows()) {
        cfg = cfg + " -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL";
    }
    if (sh(cfg) != 0) { return 1; }
    var build_cmd = "cmake --build \"" + build + "\"";
    let j = jobs();
    if (j.len > 0) { build_cmd = build_cmd + " --parallel " + j; }
    return sh(build_cmd);
}

fn install_to_out(build: string, out_dir: string) -> i32 {
    if (ensure_dir(out_dir) != 0) { return 1; }
    if (is_windows()) {
        let dll = tbb_dll_path(build);
        let lib = tbb_implib_path(build);
        if (dll.len == 0 || lib.len == 0) {
            print("error: oneTBB build produced no tbb12.dll/lib");
            return 1;
        }
        let out_dll = join2(out_dir, "tbb12.dll");
        let out_lib = join2(out_dir, "tbb12.lib");
        // A self-hosted compiler may already have this DLL loaded. Windows
        // refuses to overwrite a loaded DLL even when the bytes are identical.
        if (!fileExists(out_dll.clone()) || readFile(dll.clone()) != readFile(out_dll.clone())) {
            if (copyFile(dll, out_dll) != 0) { return 1; }
        }
        if (!fileExists(out_lib.clone()) || readFile(lib.clone()) != readFile(out_lib.clone())) {
            if (copyFile(lib, out_lib) != 0) { return 1; }
        }
        print("[tbb] copied tbb12.dll tbb12.lib -> " + out_dir);
        return 0;
    }
    let so = tbb_so_path(build);
    if (so.len == 0) {
        print("error: oneTBB build produced no libtbb");
        return 1;
    }
    if (copyFile(so, join2(out_dir, "libtbb.so")) != 0) { return 1; }
    print("[tbb] copied libtbb -> " + out_dir);
    return 0;
}

fn main() -> i32 {
    var tag = env_cstr("TBB_TAG");
    if (tag.len == 0) { tag = "v2022.1.0"; }
    let src = "../runtime/vendor/oneTBB";
    let build = join2(src, "cmake-build");
    let out_dir = "out";
    if (ensure_src(src, tag) != 0) { return 1; }
    if (ensure_build(src, build) != 0) { return 1; }
    if (install_to_out(build, out_dir) != 0) { return 1; }
    print("[tbb] oneTBB ready");
    return 0;
}
