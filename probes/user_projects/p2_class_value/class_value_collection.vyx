module probe.class_value_collection;

use std.io;
use std.collections;

// The self-host "true copy" bug class. A class field that owns heap memory
// (Vec<T> holds a rawptr) must be copied deeply when the class value is
// copied — otherwise two "independent" copies alias the same backing buffer.

class Bag {
    public items: Vec<i32>;

    public fn add(self, v: i32) -> void { self.items.push(v); }
    public fn at(self, i: i64) -> i32 { return self.items.get(i); }
    public fn total(self) -> i32 {
        var t = 0;
        var i: i64 = 0;
        while (i < self.items.size()) {
            t = t + self.items.get(i);
            i = i + 1;
        }
        return t;
    }
}

fn main() -> i32 {
    var a = Bag { items: Vec::<i32>.new() };
    a.add(1);
    a.add(2);
    if (a.total() != 3) { return 1; }

    // Copy the class value. Under real value semantics `b` owns its own
    // buffer, so in-place edits to `b` must not be visible through `a`.
    var b = a;

    // In-place overwrite of an existing slot: the sharpest aliasing test,
    // because len does not change (len is a scalar field, buffer is shared
    // memory if the copy is shallow).
    b.items.set(0, 999);
    let a0 = a.at(0);
    let b0 = b.at(0);
    println(f"after b.set(0,999): a[0]=${a0} b[0]=${b0}");
    if (a0 != 1) { return 2; }        // aliasing bug if a0 == 999
    if (b0 != 999) { return 3; }

    // Growth on the copy: a's length/total must be unaffected.
    b.add(100);
    let at = a.total();
    let bt = b.total();
    println(f"after b.add(100): a.total=${at} b.total=${bt}");
    if (at != 3) { return 4; }
    if (bt != 1101) { return 5; }     // 999 + 2 + 100

    println("class_value_collection ok");
    return 0;
}
