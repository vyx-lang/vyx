module probe.class_value;

use std.io;

// Class is a stack value type now. A user expects value semantics:
// copying a class copies its fields; passing by value hands the callee an
// independent copy; returning by value hands the caller a fresh instance.

class Counter {
    public n: i32;

    public fn inc(self) -> void { self.n = self.n + 1; }
    public fn get(self) -> i32 { return self.n; }
}

// Pass by value: mutating the parameter must NOT touch the caller's value.
fn bump(c: Counter) -> void {
    c.inc();
    c.inc();
}

// Return by value: a fresh Counter escapes the callee.
fn make(start: i32) -> Counter {
    var c = Counter { n: start };
    c.inc();
    return c;
}

fn main() -> i32 {
    var a = Counter { n: 0 };
    a.inc();
    a.inc();
    if (a.get() != 2) { return 1; }

    // copy: b starts as a snapshot of a
    var b = a;
    b.inc();
    if (a.get() != 2) { return 2; }   // a must be independent of b
    if (b.get() != 3) { return 3; }

    // pass by value: bump must not change a
    bump(a);
    if (a.get() != 2) { return 4; }

    // return by value
    var m = make(10);
    if (m.get() != 11) { return 5; }
    // and m must be independent of anything inside make
    m.inc();
    if (m.get() != 12) { return 6; }

    println("class_value ok");
    return 0;
}
