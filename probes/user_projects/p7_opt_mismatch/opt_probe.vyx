module probe.opt_probe;

use std.io;

// Same program compiled at -O0 and -O2 must produce identical output and exit
// code. It mixes constant-foldable arithmetic, a dead branch, a loop the
// optimizer may strength-reduce, and a class value threaded through calls so
// SCCP / copy-prop / DCE all have something to chew on.

class Sum {
    public total: i64;
    public fn add(self, x: i64) -> void { self.total = self.total + x; }
    public fn get(self) -> i64 { return self.total; }
}

fn dead_branch(x: i32) -> i32 {
    // condition is statically false; body must never affect the result
    if (x * 0 == 1) {
        return 999;
    }
    return x;
}

fn fold_me() -> i64 {
    let a: i64 = 2 + 3 * 4;        // 14
    let b: i64 = (a - 4) * 2;      // 20
    return a + b;                  // 34
}

fn loop_sum(n: i64) -> i64 {
    var s = Sum { total: 0 };
    var i: i64 = 0;
    while (i < n) {
        s.add(i);
        i = i + 1;
    }
    return s.get();
}

fn main() -> i32 {
    let f = fold_me();                 // 34
    let d = dead_branch(7);            // 7
    let l = loop_sum(100);             // 4950
    let acc: i64 = f + (d as i64) + l; // 34 + 7 + 4950 = 4991

    println(f"result=${acc}");
    if (acc != 4991i64) { return 1; }
    return 0;
}
