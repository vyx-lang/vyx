module probe.nested_direct;

use std.io;

// The case a real user reaches for first: call a mutating method directly on
// a nested field, `squad.leader.damage(20)`. Two acceptable outcomes:
//   1. it mutates in place (leader.hp drops), or
//   2. it is rejected at compile time with a clear diagnostic.
// The failure we are hunting is a silent no-op: it compiles, runs, and the
// mutation lands on a throwaway temporary while the real field is untouched.

class Unit {
    public hp: i32;
    public fn damage(self, d: i32) -> void { self.hp = self.hp - d; }
}

class Squad {
    public leader: Unit;
}

fn main() -> i32 {
    var squad = Squad { leader: Unit { hp: 100 } };

    squad.leader.damage(20);

    let hp = squad.leader.hp;
    println(f"leader.hp after direct nested mutate=${hp}");

    // A user expects in-place mutation to land: hp should be 80. If it stayed
    // 100 the call silently hit a temporary copy (miscompile).
    if (squad.leader.hp != 80) { return 1; }

    println("nested_direct ok");
    return 0;
}
