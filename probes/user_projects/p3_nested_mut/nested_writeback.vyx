module probe.nested_writeback;

use std.io;

// The mutation pattern the compiler *does* support for value-type fields:
// pull the nested field into a standalone local `var`, mutate it via a
// method, then write it back. No `&mut self.field` — that form is rejected
// by the compiler on purpose.

class Unit {
    public hp: i32;

    public fn damage(self, d: i32) -> void { self.hp = self.hp - d; }
    public fn heal(self, d: i32) -> void { self.hp = self.hp + d; }
}

class Squad {
    public leader: Unit;
    public size: i32;
}

fn main() -> i32 {
    var squad = Squad { leader: Unit { hp: 100 }, size: 3 };

    // extract -> mutate -> write back
    var u = squad.leader;
    u.damage(30);
    u.heal(5);
    squad.leader = u;

    let hp = squad.leader.hp;
    println(f"leader.hp=${hp}");
    if (squad.leader.hp != 75) { return 1; }

    // do it again to be sure the write-back is not a one-shot fluke
    var u2 = squad.leader;
    u2.damage(25);
    squad.leader = u2;
    if (squad.leader.hp != 50) { return 2; }

    println("nested_writeback ok");
    return 0;
}
