module probe.chained;

use std.io;

// Static factory + fluent chaining on a value-type class. Each `add` mutates
// and returns self; a real builder pattern. Under value semantics the chain
// operates on the temporary threaded through the calls, and the final result
// must reflect every step.

class Accum {
    public parts: i32;
    public sum: i32;

    public static fn create() -> Accum { return Accum { parts: 0, sum: 0 }; }

    public fn add(self, v: i32) -> Accum {
        self.parts = self.parts + 1;
        self.sum = self.sum + v;
        return self;
    }

    public fn build(self) -> i32 { return self.sum; }
    public fn count(self) -> i32 { return self.parts; }
}

fn main() -> i32 {
    let total = Accum.create().add(1).add(2).add(3).add(4).build();
    if (total != 10) { return 1; }

    let n = Accum.create().add(5).add(5).count();
    if (n != 2) { return 2; }

    // split the chain across a local to ensure the intermediate value is a
    // real, usable Accum, not chain-only sugar
    var acc = Accum.create();
    acc = acc.add(100);
    acc = acc.add(200);
    if (acc.build() != 300) { return 3; }
    if (acc.count() != 2) { return 4; }

    println("chained ok");
    return 0;
}
