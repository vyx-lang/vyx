module probe.overload;

use std.io;

// Free-function overloading by arity and by parameter type — something users
// routinely expect. If the language does not support overloading this must
// fail with a clear diagnostic at compile time (recorded as a language gap),
// never silently pick the wrong one.

fn area(s: i32) -> i32 { return s * s; }
fn area(w: i32, h: i32) -> i32 { return w * h; }

fn describe(x: i32) -> i32 { return x + 1; }
fn describe(x: i64) -> i32 { return (x + 2i64) as i32; }

fn main() -> i32 {
    if (area(5) != 25) { return 1; }
    if (area(3, 4) != 12) { return 2; }

    if (describe(10) != 11) { return 3; }
    if (describe(10i64) != 12) { return 4; }

    println("overload ok");
    return 0;
}
