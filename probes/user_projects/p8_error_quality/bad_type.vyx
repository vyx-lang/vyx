module probe.bad_type;

use std.io;

// Intentionally invalid: assign a string literal to an i32 binding and then
// do arithmetic on it. The compiler must reject this with a type-mismatch
// diagnostic and a non-zero exit. It must not crash, hang, or exit 0.

fn main() -> i32 {
    let x: i32 = "not a number";
    let y: i32 = x + 1;
    println(y.toString());
    return 0;
}
