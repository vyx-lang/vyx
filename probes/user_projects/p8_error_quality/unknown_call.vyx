module probe.unknown_call;

use std.io;

// Intentionally invalid: call a function that was never declared and a method
// that does not exist on the type. The compiler must report an
// unresolved-name / no-such-method diagnostic and exit non-zero, not
// SIGSEGV, hang, or silently succeed.

class Widget {
    public id: i32;
    public fn name(self) -> i32 { return self.id; }
}

fn main() -> i32 {
    let w = Widget { id: 7 };
    let a = totally_undefined_function(w, 3);
    let b = w.method_that_does_not_exist(42);
    return a + b;
}
