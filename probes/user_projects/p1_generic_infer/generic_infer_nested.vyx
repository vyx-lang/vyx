module probe.generic_infer_nested;

use std.io;

// Nested generic inference without turbofish: the result of one inferred call
// feeds another. A user writes this without thinking. It is isolated here
// because it exposes a lowering failure the single-level cases do not.

fn identity<T>(x: T) -> T {
    return x;
}

fn main() -> i32 {
    let c = identity(identity(5));
    if (c != 5) { return 1; }
    println("generic_infer_nested ok");
    return 0;
}
