module probe.generic_infer;

use std.io;

// Generic inference WITHOUT turbofish. A real user writes `identity(11)`,
// not `identity::<i32>(11)`. Exercise inference on free functions, on
// multi-param generics, on nested generic types, and on methods of a
// generic type.

fn identity<T>(x: T) -> T {
    return x;
}

fn pick_first<A, B>(a: A, b: B) -> A {
    return a;
}

fn pick_second<A, B>(a: A, b: B) -> B {
    return b;
}

class Pair<A, B> {
    public first: A;
    public second: B;

    public fn get_first(self) -> A { return self.first; }
    public fn get_second(self) -> B { return self.second; }
}

class Wrap<T> {
    public inner: T;

    public fn plus(self, d: T) -> T { return self.inner + d; }
}

fn main() -> i32 {
    // free-function inference, no turbofish
    let a = identity(11);
    if (a != 11) { return 1; }

    let b = identity(20i64);
    if (b != 20i64) { return 2; }

    // multi-param inference with mixed widths
    let f = pick_first(7, 100i64);
    if (f != 7) { return 4; }

    let s = pick_second(7, 100i64);
    if (s != 100i64) { return 5; }

    // nested generic struct: build then read via methods
    let p = Pair::<i32, i64> { first: 3, second: 4i64 };
    if (p.get_first() != 3) { return 6; }
    if (p.get_second() != 4i64) { return 7; }

    // method on a generic type, arg inferred from receiver instantiation
    let w = Wrap::<i32> { inner: 30 };
    if (w.plus(12) != 42) { return 8; }

    println("generic_infer ok");
    return 0;
}
