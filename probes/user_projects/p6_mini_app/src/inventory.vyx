module app.inventory;

use std.collections;

// A small data model: items with a stock quantity and a unit price, held in a
// Vec of class values. Read-modify-write of an element (`get` -> mutate ->
// `set`) is the everyday value-semantics pattern for a Vec of classes.

class Item {
    public sku: i32;
    public qty: i32;
    public price: i32;

    public fn value(self) -> i32 { return self.qty * self.price; }
}

class Inventory {
    public items: Vec<Item>;

    public static fn empty() -> Inventory {
        return Inventory { items: Vec::<Item>.new() };
    }

    public fn add(self, it: Item) -> void { self.items.push(it); }

    public fn count(self) -> i64 { return self.items.size(); }

    public fn total_value(self) -> i32 {
        var t = 0;
        var i: i64 = 0;
        while (i < self.items.size()) {
            let it = self.items.get(i);
            t = t + it.value();
            i = i + 1;
        }
        return t;
    }

    public fn restock(self, sku: i32, extra: i32) -> bool {
        var i: i64 = 0;
        while (i < self.items.size()) {
            var it = self.items.get(i);
            if (it.sku == sku) {
                it.qty = it.qty + extra;
                self.items.set(i, it);
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}
