module app;

use std.io;
use app.inventory;

fn main() -> i32 {
    var inv = Inventory.empty();
    inv.add(Item { sku: 1, qty: 3, price: 100 });
    inv.add(Item { sku: 2, qty: 5, price: 40 });
    inv.add(Item { sku: 3, qty: 2, price: 250 });

    // 3*100 + 5*40 + 2*250 = 1000
    let before = inv.total_value();
    println(f"items=${inv.count()} total=${before}");
    if (before != 1000) { return 1; }

    // restock sku 2: qty 5 -> 15, adds 10*40 = 400
    let ok = inv.restock(2, 10);
    if (!ok) { return 2; }

    let after = inv.total_value();
    println(f"after restock total=${after}");
    if (after != 1400) { return 3; }

    // restocking a missing sku reports failure without touching totals
    if (inv.restock(99, 1)) { return 4; }
    if (inv.total_value() != 1400) { return 5; }

    println("mini_app ok");
    return 0;
}
