module probe.control_flow;

use std.io;

// A class local born before the branches, mutated inside if/else and inside a
// loop, then read after everything joins. This exercises multi-block storage
// for a stack class value across a real CFG (the automatic class-storage
// planner has to keep one slot live across every block).

class Acc {
    public v: i32;
    public fn add(self, x: i32) -> void { self.v = self.v + x; }
}

fn compute(flag: bool, n: i32) -> i32 {
    var acc = Acc { v: 0 };
    if (flag) {
        acc.add(100);
    } else {
        acc.add(1);
    }

    var i = 0;
    while (i < n) {
        acc.add(i);
        i = i + 1;
    }

    // early-return branch that still reads the same local
    if (acc.v > 1000) {
        return acc.v;
    }
    return acc.v;
}

fn accumulate_in_loop(n: i32) -> i32 {
    // a fresh class local created and rebound each iteration, plus one that
    // persists — checks that per-iteration temporaries do not clobber the
    // persistent slot
    var carry = Acc { v: 0 };
    var i = 0;
    while (i < n) {
        var step = Acc { v: i };
        step.add(1);
        carry.add(step.v);
        i = i + 1;
    }
    return carry.v;
}

fn main() -> i32 {
    // flag=true: 100 + (0+1+2+3+4) = 110
    if (compute(true, 5) != 110) { return 1; }
    // flag=false: 1 + (0+1+2) = 4
    if (compute(false, 3) != 4) { return 2; }

    // sum over i in [0,4) of (i+1) = 1+2+3+4 = 10
    if (accumulate_in_loop(4) != 10) { return 3; }

    println("control_flow ok");
    return 0;
}
