// Appended to verbatim production batch execution and dependency functions.
fn main() -> i32 {
    let mode = getArg(1);
    let jobs = build_parse_int(getArg(2));
    let child = getArg(3);
    let failing = mode == "failure";
    let tree_success = mode == "tree_success";
    let count: i64 = 40;
    var actions = Vec::<BuildAction>.with_capacity(count);
    var i: i64 = 0;
    while (i < count) {
        let id = i.toString();
        let output = "action_" + id + ".obj";
        var action: BuildAction;
        action.step = id;
        action.source = "native_child_" + id + ".cc";
        action.output = output;
        var child_mode = "success";
        var delay = "150";
        if (tree_success) { child_mode = "tree_success"; delay = "250"; }
        if (failing) {
            child_mode = "tree";
            if (i == 0) { child_mode = "failure"; }
            delay = "800";
        }
        action.command = build_quote(child) + " " + child_mode + " " + id
            + " " + build_quote(build_task_tmp_output(output)) + " " + delay;
        action.log_path = "";
        action.state = build_action_ready();
        action.is_vyx = false;
        action.priority = count - i;
        // The fixture child has no compiler state. This test reservation is
        // intentionally sized for that actual workload, in bytes.
        action.memory_bytes = 8 * 1048576;
        action.cost_key = "";
        action.process_id = 0;
        action.started_ms = 0;
        action.elapsed_ms = 0;
        action.peak_resident_bytes = -1;
        action.peak_private_bytes = -1;
        action.cpu_time_us = -1;
        action.exit_code = -1;
        actions.push(action);
        i = i + 1;
    }
    if (failing) { writeFile("action_0.obj", "previous-good-output"); }
    let result = build_run_action_batch(&mut actions, jobs, count);
    var cancelled: i64 = 0;
    i = 0;
    while (i < count) {
        let action = actions.get_ptr(i);
        if (action[0].process_id != 0 || action[0].state == build_action_running()) {
            print("FAIL: live process retained after batch"); return 2;
        }
        if (!failing) {
            if (action[0].state != build_action_succeeded() || action[0].exit_code != 0
                || action[0].peak_resident_bytes < 0 || action[0].peak_private_bytes < 0
                || action[0].cpu_time_us < 0
                || readFile(action[0].output) != "complete " + i.toString()
                || fileExists(build_task_tmp_output(action[0].output))) {
                print("FAIL: success state, telemetry or output publication " + i.toString()); return 3;
            }
        } else if (i == 0) {
            if (action[0].state != build_action_failed() || action[0].exit_code != 17
                || readFile(action[0].output) != "previous-good-output"
                || !fileExists(build_task_tmp_output(action[0].output))) {
                print("FAIL: failed action state or failed artifact published"); return 4;
            }
        } else {
            if (action[0].state == build_action_cancelled()) { cancelled = cancelled + 1; }
            elif (action[0].state != build_action_ready()) {
                print("FAIL: remaining action neither pending nor cancelled"); return 5;
            }
            if (fileExists(action[0].output)) {
                print("FAIL: cancelled action published output"); return 6;
            }
        }
        i = i + 1;
    }
    actions.destroy();
    if (failing) {
        if (result == 0 || (jobs > 1 && cancelled == 0)) {
            print("FAIL: failed batch accepted or no running sibling cancelled"); return 7;
        }
    } else if (result != 0) { print("FAIL: successful batch rejected"); return 8; }
    print("build_actions: OK " + mode + " jobs=" + jobs.toString()
        + " cancelled=" + cancelled.toString());
    return 0;
}
