extern "dci" {
    struct Blk {
        public a: i64;
        public b: i64;
        public c: i64;
        public d: i64;
    };

    fn make_blk(seed: i64) -> Blk;
    fn packed_sum(lhs: Blk, rhs: Blk) -> i32;
}

fn main() -> i32 {
    let lhs = make_blk(1);
    let rhs = make_blk(2);
    return packed_sum(lhs, rhs);
}
