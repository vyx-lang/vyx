use std.vio;

var log: i32 = 0;

@[async]
fn yielder() -> i32 {
    await Task::<i32>.yield_now();
    log = log * 10 + 1;
    return 0;
}

@[async]
fn quick() -> i32 {
    log = log * 10 + 2;
    return 0;
}

fn main() -> i32 {
    let a = yielder();
    let b = quick();
    await a;
    await b;
    if (log != 21) { return log; }
    if (vio_sched_pending_returns() < 1) { return 3; }
    return 0;
}
