use std.vio;

var log: i32 = 0;

@[async]
fn sleeper() -> i32 {
    await Task::<i32>.sleep(20);
    log = log * 10 + 1;
    return 0;
}

@[async]
fn quick() -> i32 {
    log = log * 10 + 2;
    return 0;
}

fn main() -> i32 {
    let a = sleeper();
    let b = quick();
    await a;
    await b;
    if (log != 21) { return log; }
    return 0;
}
