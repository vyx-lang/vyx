// This is an explicit view of a Rust borrow, not a replacement Rust type.
// The producer measures its layout and retains &[u8] in every API signature.
@[repr(C)]
struct dci.RustSlice_u8 {
    public data: rawptr;
    public len: usize;
}

@[dci_import(".cache/crc32fast.dcib")]
extern "dci" {
    fn crc32_hash(buf: dci.RustSlice_u8) -> u32;
}

@[dci_import(".cache/adler2.dcib")]
extern "dci" {
    fn adler32_slice(buf: dci.RustSlice_u8) -> u32;
}

extern "C" {
    fn malloc(size: usize) -> rawptr;
    fn free(pointer: rawptr);
    fn fopen(filename: rawptr, mode: rawptr) -> rawptr;
    fn fread(buffer: *u8, size: usize, count: usize, file: rawptr) -> usize;
    fn fclose(file: rawptr) -> i32;
}

fn checksum_file(path: string, length: usize) -> i32 {
    let file = fopen(path.c_str(), "rb".c_str());
    if (file == null) { return 10; }
    let bytes = malloc(length + 1);
    let count = fread(bytes, 1, length, file);
    fclose(file);
    if (count != length) { free(bytes); return 11; }

    let whole = dci.RustSlice_u8 { data: bytes, len: length };
    let expected_crc = crc32_hash(whole);
    let expected_adler = adler32_slice(whole);
    let crc_result = crc32_hash(whole);
    let adler_result = adler32_slice(whole);
    if (crc_result != expected_crc) { free(bytes); return 12; }
    if (adler_result != expected_adler) { free(bytes); return 13; }

    free(bytes);
    print(length);
    print(crc_result);
    print(adler_result);
    return 0;
}

fn main() -> i32 {
    if (checksum_file(".cache/inputs/input-0.bin", 0) != 0) { return 1; }
    if (checksum_file(".cache/inputs/input-1.bin", 1) != 0) { return 2; }
    if (checksum_file(".cache/inputs/input-7.bin", 7) != 0) { return 3; }
    if (checksum_file(".cache/inputs/input-16.bin", 16) != 0) { return 4; }
    if (checksum_file(".cache/inputs/input-255.bin", 255) != 0) { return 5; }
    if (checksum_file(".cache/inputs/input-4096.bin", 4096) != 0) { return 6; }
    if (checksum_file(".cache/inputs/input-65537.bin", 65537) != 0) { return 7; }
    if (checksum_file(".cache/inputs/input-1048576.bin", 1048576) != 0) { return 8; }
    return 0;
}
