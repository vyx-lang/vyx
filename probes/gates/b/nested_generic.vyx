class Wrap<T> {
    public v: T;
    public fn get(self) -> T { return self.v; }
}

class Pair<A, B> {
    public first: A;
    public second: B;
    public fn fst(self) -> A { return self.first; }
    public fn snd(self) -> B { return self.second; }
}

class Triple<A, B, C> {
    public a: A;
    public b: B;
    public c: C;
    public fn get_c(self) -> C { return self.c; }
}

fn main() -> i32 {
    print("hello");
    let inner = Wrap::<i32> { v: 7 };
    let outer = Wrap::<Wrap<i32>> { v: inner };
    if (outer.get().get() != 7) { return 1; }

    let inner2 = Wrap::<i32> { v: 7 };
    let p = Pair::<i32, Wrap<i32>> { first: 3, second: inner2 };
    if (p.fst() != 3) { return 2; }
    if (p.snd().get() != 7) { return 3; }

    let inner3 = Wrap::<i32> { v: 7 };
    let inner4 = Wrap::<Wrap<i32>> { v: inner3 };
    let inner5 = Wrap::<i32> { v: 9 };
    let t = Triple::<i32, Wrap<i32>, Wrap<Wrap<i32>>> { a: 3, b: inner5, c: inner4 };
    if (t.get_c().get().get() != 7) { return 4; }
    return 0;
}
