use std.collections;

fn main() -> i32 {
    var pointers = Vec::<*char>::with_capacity(4);
    var pointer: *char = null;
    pointers.push(pointer);
    if (pointers.len != 1 || pointers.elem_size != sizeof::<*char>()) { return 1; }
    // The C argv bridge uses raw addresses; Vyx pointers retain their metadata.
    if (sizeof::<rawptr>() != 8 || pointers.elem_size != 16) { return 2; }
    var arguments = Vec::<string>::with_capacity(4);
    arguments.push("argument with spaces");
    let address = arguments[0].c_str();
    if (address == null || arguments[0].len != 20) { return 3; }
    print("pointer generic storage OK");
    return 0;
}
