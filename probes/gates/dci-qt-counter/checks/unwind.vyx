@[dci_import("contracts/qt_widgets_unwind.dcib")]
extern "dci" {
    class QString { QString(text: *char); ~QString(); };
    class QWidget { virtual fn setVisible(visible: bool); };
    class QFrame : QWidget { };
    class QLCDNumber : QFrame {
        QLCDNumber(parent: *QWidget);
        ~QLCDNumber();
        public fn display(value: i32);
        public fn intValue() const -> i32;
    };
    class QAbstractButton : QWidget { };
    class QPushButton : QAbstractButton {
        QPushButton(text: &QString, parent: *QWidget);
        ~QPushButton();
    };
    fn qt_counter_watch(widget: *QWidget, id: i32);
    fn qt_counter_throw(mode: i32) -> i32;
    fn qt_counter_call_visible(widget: *QWidget) -> i32;
}
extern "C" { fn qt_counter_harness(callback: rawptr, mode: i32) -> i32; }

fn leaf(mode: i32) -> i32 {
    var title = QString("shared ABI".c_str() as *char);
    var lcd = QLCDNumber(null);
    var button = QPushButton(&title, null);
    qt_counter_watch(lcd as *QWidget, 1);
    qt_counter_watch(button as *QWidget, 2);
    lcd.display(123);
    if (lcd.intValue() != 123) { return 1; }
    return qt_counter_throw(mode);
}

fn middle(mode: i32) -> i32 { return leaf(mode); }

var g_throw_mode: i32 = 0;
var g_constructor_fails: bool = false;
class ThrowingLcd : QLCDNumber {
    ThrowingLcd() {
        g_throw_mode = 2;
        qt_counter_watch(self as *QWidget, 1);
        if (g_constructor_fails) { let result = qt_counter_throw(3); }
    }
    override fn setVisible(visible: bool) {
        let unused = visible;
        let result = qt_counter_throw(g_throw_mode);
    }
};
fn reverse(mode: i32) -> i32 {
    g_constructor_fails = mode == 3;
    var lcd = ThrowingLcd();
    return qt_counter_call_visible(lcd as *QWidget);
}

fn main() -> i32 {
    for (mode in 0..2) {
        let result = qt_counter_harness(middle as rawptr, mode);
        if (result != 0) { return result; }
    }
    let reversed = qt_counter_harness(reverse as rawptr, 2);
    if (reversed != 0) { return reversed; }
    let failed_constructor = qt_counter_harness(reverse as rawptr, 3);
    if (failed_constructor != 0) { return failed_constructor; }
    print("Qt original exception and cleanup OK");
    return 0;
}
