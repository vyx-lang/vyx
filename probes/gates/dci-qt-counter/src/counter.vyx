module app.counter;
use qt.widgets;

public class Counter : QWidget {
    public value: i32;
    public lcd: *QLCDNumber;

    Counter() { self.value = 0; self.lcd = null; }

    public fn attach(display: *QLCDNumber) {
        self.lcd = display;
        (*self.lcd).display(self.value);
    }

    public fn change(delta: i32) {
        self.value = self.value + delta;
        if (self.lcd != null) { (*self.lcd).display(self.value); }
    }
};

@[no_mangle]
public fn counter_increment(state: rawptr, checked: bool) {
    let unused = checked;
    // The connection's context is this Counter; Qt disconnects it before the
    // borrowed user address can outlive that context.
    unsafe {
        let counter = state as *Counter;
        (*counter).change(1);
    }
}

@[no_mangle]
public fn counter_decrement(state: rawptr, checked: bool) {
    let unused = checked;
    unsafe {
        let counter = state as *Counter;
        (*counter).change(-1);
    }
}
