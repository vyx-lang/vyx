use std.collections;
use qt.widgets;
use app.counter;
use app.counter_test;

extern "C" { fn getenv(name: rawptr) -> rawptr; }

fn run_widgets(self_test: bool) -> i32 {
    var window = Counter();
    var title = QString("Vyx · Qt Counter".c_str() as *char);
    window.setWindowTitle(&title);
    window.resize(420, 300);
    let parent = window as *QWidget;
    var plus_text = QString("+".c_str() as *char);
    var minus_text = QString("−".c_str() as *char);
    // Children and the layout leave scope before their parent window.
    var lcd = QLCDNumber(parent);
    var plus = QPushButton(&plus_text, parent);
    var minus = QPushButton(&minus_text, parent);
    var layout = QVBoxLayout(parent);
    lcd.setDigitCount(8);
    window.attach(lcd as *QLCDNumber);
    layout.addWidget(lcd as *QWidget);
    layout.addWidget(plus as *QWidget);
    layout.addWidget(minus as *QWidget);
    let context = window as *QObject;
    let state = window as rawptr;
    if (!plus.on_clicked(context, counter_increment, state)
        || !minus.on_clicked(context, counter_decrement, state)) {
        print("Qt signal connection failed");
        return 1;
    }
    window.show();
    if (self_test) {
        var check = CounterCheck(window as *Counter, plus as *QPushButton, minus as *QPushButton);
        return QApplication.exec();
    }
    return QApplication.exec();
}

fn main() -> i32 {
    var argc = argCount();
    // Keep every argument string and the mutable argv array alive until after
    // QApplication is destroyed. Qt may remove options from this array.
    var arguments = Vec::<string>::with_capacity(argc as i64);
    // C argv is an array of native addresses, not Vyx pointer handles.
    var pointers = Vec::<rawptr>::with_capacity((argc + 1) as i64);
    var i: i32 = 0;
    while (i < argc) { arguments.push(getArg(i)); i = i + 1; }
    i = 0;
    while (i < argc) { pointers.push(arguments[i as i64].c_str()); i = i + 1; }
    pointers.push(null);
    var app = QApplication(&mut argc, pointers.data as **char);
    return run_widgets(getenv("DCI_QT_COUNTER_SELFTEST".c_str()) != null);
}
