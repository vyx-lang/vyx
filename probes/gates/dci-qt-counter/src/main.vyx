// Qt Widgets Counter through DCI: QApplication + QLCDNumber + QPushButton.
@[dci_import("../contracts/qt_widgets.dcib")]
@[cpp_include("qt_widgets_dci.hpp")]
extern "dci" {
    class QMouseEvent { };
    class QTimerEvent { };

    class QString {
        QString(text: *i8);
    };

    class QApplication {
        QApplication(argc: &mut i32, argv: **i8, flags: i32);
        public static fn exec() -> i32;
    };

    class QWidget {
        public fn resize(w: i32, h: i32);
        public fn show();
        public fn setGeometry(x: i32, y: i32, w: i32, h: i32);
        public fn setParent(parent: *QWidget);
        public fn setWindowTitle(title: &QString);
        public fn startTimer(interval: i32, timer_type: i32) -> i32;
        virtual fn mouseReleaseEvent(event: *QMouseEvent);
        virtual fn timerEvent(event: *QTimerEvent);
    };

    class QAbstractButton : QWidget {
        public fn setText(text: &QString);
        public fn isDown() const -> bool;
    };

    class QPushButton : QAbstractButton {
        QPushButton(parent: *QWidget);
        QPushButton(text: &QString, parent: *QWidget);
    };

    class QLCDNumber : QWidget {
        QLCDNumber(parent: *QWidget);
        public fn display(num: i32);
        public fn setDigitCount(n: i32);
    };
}

extern "C" {
    fn malloc(n: usize) -> rawptr;
    fn memcpy(dst: rawptr, src: rawptr, n: usize) -> rawptr;
}

let QT_APPLICATION_FLAGS: i32 = 394243;
let TIMER_COARSE: i32 = 1;

var g_value: i32 = 0;
var g_lcd: *QLCDNumber = null;
var g_plus: *QPushButton = null;
var g_minus: *QPushButton = null;
var g_plus_was: bool = false;
var g_minus_was: bool = false;

fn make_argv(arg0: *i8) -> **i8 {
    let buf = malloc(16);
    var p0: *i8 = arg0;
    var p1: *i8 = null;
    memcpy(buf, (&mut p0) as rawptr, 8);
    memcpy(buf + 8, (&mut p1) as rawptr, 8);
    return buf as **i8;
}

fn apply_value() {
    if (g_lcd != null) {
        (*g_lcd).display(g_value);
    }
}

class Counter : QLCDNumber {
    Counter() {
        g_value = 0;
        g_plus_was = false;
        g_minus_was = false;
    }

    override fn mouseReleaseEvent(event: *QMouseEvent) {
        let unused = event;
    }

    override fn timerEvent(event: *QTimerEvent) {
        let unused = event;
        var plus_down = false;
        var minus_down = false;
        if (g_plus != null) {
            plus_down = (*g_plus).isDown();
        }
        if (g_minus != null) {
            minus_down = (*g_minus).isDown();
        }
        if (plus_down && !g_plus_was) {
            g_value = g_value + 1;
            apply_value();
        }
        if (minus_down && !g_minus_was) {
            g_value = g_value - 1;
            apply_value();
        }
        g_plus_was = plus_down;
        g_minus_was = minus_down;
    }
};

fn main() -> i32 {
    var argc: i32 = 1;
    let argv = make_argv("dci_qt_counter".c_str() as *i8);
    var app = QApplication(&mut argc, argv, QT_APPLICATION_FLAGS);
    let keep_app = &mut app;

    var window = Counter();
    g_lcd = window as *QLCDNumber;
    (*g_lcd).setDigitCount(8);
    (*g_lcd).display(0);
    (*g_lcd).resize(420, 240);
    (*g_lcd).startTimer(50, TIMER_COARSE);

    let parent = g_lcd as *QWidget;
    var plus_text = QString("+".c_str() as *i8);
    var minus_text = QString("-".c_str() as *i8);
    var title = QString("Counter".c_str() as *i8);
    (*g_lcd).setWindowTitle(&title);
    var plus = QPushButton(&plus_text, parent);
    var minus = QPushButton(&minus_text, parent);
    g_plus = plus as *QPushButton;
    g_minus = minus as *QPushButton;
    plus.setGeometry(20, 190, 180, 40);
    minus.setGeometry(220, 190, 180, 40);

    (*g_lcd).show();
    plus.show();
    minus.show();
    let rc = QApplication.exec();
    let keep = keep_app;
    return rc;
}
