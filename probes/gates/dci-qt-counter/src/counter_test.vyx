module app.counter_test;
use qt.widgets;
use app.counter;

// Regression driver, separate from the counter's state and event handling.
public class CounterCheck : QObject {
    public counter: *Counter;
    public plus: *QPushButton;
    public minus: *QPushButton;
    public tick: i32;

    CounterCheck(counter: *Counter, plus: *QPushButton, minus: *QPushButton) {
        self.counter = counter;
        self.plus = plus;
        self.minus = minus;
        self.tick = 0;
        self.startTimer(50);
    }

    override fn timerEvent(event: *QTimerEvent) {
        if (event == null) { QApplication.exit(3); return; }
        if (self.tick == 0) { (*self.plus).click(); }
        if (self.tick == 1) { (*self.plus).setDown(true); }
        var expected: i32 = 1;
        if (self.tick == 3) {
            (*self.plus).setDown(false);
            (*self.minus).click();
            var i: i32 = 0;
            while (i < 1000) { (*self.plus).click(); (*self.minus).click(); i = i + 1; }
            expected = 0;
        }
        if (self.tick == 4) { expected = 0; }
        // run_widgets owns the Counter until QApplication.exec returns, and
        // destroys this timer object before the Counter leaves that scope.
        unsafe {
            let counter = self.counter;
            let lcd = (*counter).lcd;
            if ((*counter).value != expected || (*lcd).intValue() != expected) {
                print("dci-qt-counter FAIL: signal/instance/LCD state");
                QApplication.exit(1);
                return;
            }
            if (self.tick == 4) {
                var other = Counter();
                other.change(42);
                if (other.value != 42 || (*counter).value != 0) { QApplication.exit(2); return; }
                print("dci-qt-counter OK: buttons, held press, LCD, virtual timer; typed clicked, instance state, layouts");
                QApplication.exit(0);
            }
        }
        self.tick = self.tick + 1;
    }
};
