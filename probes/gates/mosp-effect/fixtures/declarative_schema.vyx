// Package-declared Effect schema data is validated without executing code.
use bootstrap.effect_attributes;

fn main() -> i32 {
    let header = "MOSP-EFFECT-SCHEMAS\t1";
    if (!effect_attribute_schema_header_valid(header)) { return 1; }

    let row = "S\tstorage.cache\t1\tfunction|module\tlevel:enum[abi|layout];retain:bool:false\trecord";
    if (!effect_attribute_schema_row_valid(row)) { return 2; }
    if (effect_attribute_schema_field_count(row) != 6) { return 3; }
    if (effect_attribute_schema_field(row, 1) != "storage.cache") { return 4; }

    let text = header + "\n" + row + "\n";
    if (!effect_attribute_schema_text_valid(text) || effect_attribute_schema_row_count(text) != 1) { return 5; }
    if (effect_attribute_schema_row_at(text, 0) != row) { return 6; }

    // Arguments are accepted in any order but normalized to schema order.
    let supplied = "retain=true,level=\"abi\"";
    if (!effect_attribute_schema_args_valid(row, supplied)) { return 7; }
    if (effect_attribute_schema_args_normalize(row, supplied) != "level=\"abi\",retain=true") { return 8; }

    // Defaults are materialized and enum values are canonical quoted strings.
    if (effect_attribute_schema_args_normalize(row, "level=layout") != "level=\"layout\",retain=false") { return 9; }
    if (effect_attribute_schema_args_error(row, "level=abi,level=layout") != "duplicate-argument:level") { return 10; }
    if (effect_attribute_schema_args_error(row, "level=abi,unknown=true") != "unknown-argument:unknown") { return 11; }
    if (effect_attribute_schema_args_error(row, "level=bad") != "invalid-value:level") { return 12; }

    // Invalid package schemas fail closed before they can register a handler.
    let bad_name = "S\tcache\t1\tfunction\tlevel:enum[a|b]\trecord";
    let bad_param = "S\tstorage.bad\t1\tfunction\tlevel:enum[a|a]\trecord";
    let bad_target = "S\tstorage.bad_target\t1\tthread\tlevel:bool\trecord";
    if (effect_attribute_schema_row_valid(bad_name) || effect_attribute_schema_row_valid(bad_param)
        || effect_attribute_schema_row_valid(bad_target)) { return 13; }
    if (effect_attribute_schema_text_valid(header + "\n" + row + "\n" + row + "\n")) { return 14; }

    print("declarative-schema-aot-ok\n");
    return 0;
}
