// DCI export Effect boundary: the declaration becomes an AOT export root and
// the sealed plan can be selected into a deterministic sidecar artifact.
@[dci_export(symbol="effect_gate_add")]
public fn effect_gate_exported(value: i32) -> i32 {
    return value + 7;
}

// Deliberately reversed source order: the provenance sidecar must sort export
// rows rather than inherit source or hash-table traversal order.
@[dci_export(symbol="z_effect_gate")]
public fn z_effect_gate(value: i32) -> i32 { return value + 2; }

@[dci_export(symbol="a_effect_gate")]
public fn a_effect_gate(value: i32) -> i32 { return value + 1; }

fn main() -> i32 {
    if (effect_gate_exported(5) != 12) { return 1; }
    return 0;
}
