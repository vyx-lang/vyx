// Standard-library Effect integration smoke.
//
// Importing std.vio exercises the real package registry and brings the
// platform-selected implementations into the same compilation unit.  The
// local platform marker makes the assertion observable without depending on
// an implementation detail of the package's private declarations.
use std.vio;

@[platform("windows")]
fn stdlib_platform_value() -> i32 {
    return 41;
}

fn main() -> i32 {
    // vio_now is provided by the package's Windows branch.  Calling it keeps
    // this fixture on the package path rather than testing an isolated attr.
    let now = vio_now();
    if (now < 0) { return 1; }
    if (stdlib_platform_value() != 41) { return 2; }
    print("stdlib-effect-aot-ok\n");
    return 0;
}
