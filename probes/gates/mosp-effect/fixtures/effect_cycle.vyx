use bootstrap.effect_manifest;

fn main() -> i32 {
    // Module-qualified declaration identities make this a cross declaration /
    // cross module graph rather than a same-name toy cycle.
    var graph = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-cycle",
        "source-cycle", "compiler-cycle");
    if (!graph.add_record("module.alpha::decode", "migrate", "v=2",
                          "migration", "declaration", "vyx", "abi-v1", 1, "")) { return 10; }
    if (!graph.add_record("module.beta::normalize", "reflect", "",
                          "reflection", "declaration", "vyx", "abi-v1", 1, "")) { return 11; }
    if (!graph.add_record("module.gamma::encode", "dci_import", "",
                          "abi", "declaration", "vyx", "abi-v1", 1, "")) { return 12; }
    if (!graph.add_edge("module.alpha::decode", "module.beta::normalize", "migrate", "digest-ab")) { return 13; }
    if (!graph.add_edge("module.beta::normalize", "module.gamma::encode", "reflect", "digest-bg")) { return 14; }
    if (!graph.add_edge("module.alpha::decode", "module.gamma::encode", "dci", "digest-ag")) {
        return 15;
    }
    // A second insertion order must produce the same serialized edge rows.
    var reordered = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-cycle",
        "source-cycle", "compiler-cycle");
    if (!reordered.add_edge("module.beta::normalize", "module.gamma::encode", "reflect", "digest-bg")) { return 16; }
    if (!reordered.add_edge("module.alpha::decode", "module.beta::normalize", "migrate", "digest-ab")) { return 17; }
    if (!reordered.add_edge("module.alpha::decode", "module.gamma::encode", "dci", "digest-ag")) { return 18; }
    if (reordered.cycle_count_value() != 0) { return 19; }
    reordered.seal();
    let wire = reordered.serialize();
    let parsed = effect_manifest_deserialize(wire);
    if (parsed.status() != effect_manifest_fresh()) { return 20; }
    if (parsed.dependency_count != 3) { return 21; }
    if (parsed.dependency_row(0).indexOf("D\tedge:") < 0) { return 22; }
    print("effect-edge-wire-ok");

    var cyclic = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-cycle",
        "source-cycle", "compiler-cycle");
    if (!cyclic.add_edge("module.alpha::decode", "module.beta::normalize", "migrate", "")) { return 30; }
    if (!cyclic.add_edge("module.beta::normalize", "module.gamma::encode", "reflect", "")) { return 31; }
    if (cyclic.add_edge("module.gamma::encode", "module.alpha::decode", "dci", "")) { return 32; }
    if (cyclic.cycle_count_value() != 1) { return 33; }
    if (cyclic.status() != effect_manifest_rejected()) { return 34; }
    let diagnostic = cyclic.cycle_diagnostic(0);
    if (diagnostic.indexOf("EFFECT-CYCLE") < 0
        || diagnostic.indexOf("module.gamma::encode -> module.alpha::decode") < 0) {
        return 35;
    }
    print("effect-cycle-rejected");

    // Exercise the non-first outgoing branch: A->B is a dead end while
    // A->C->D->E closes back to A.  A cycle detector that follows only one
    // lexicographically selected edge would miss this back edge.
    var branched = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-cycle-branch",
        "source-cycle", "compiler-cycle");
    if (!branched.add_edge("A", "B", "requires", "")) { return 36; }
    if (!branched.add_edge("A", "C", "requires", "")) { return 37; }
    if (!branched.add_edge("C", "D", "requires", "")) { return 38; }
    if (!branched.add_edge("D", "E", "requires", "")) { return 39; }
    if (branched.add_edge("E", "A", "requires", "")) { return 40; }
    if (branched.cycle_count_value() != 1
        || branched.cycle_diagnostic(0).indexOf("A -> C -> D -> E -> A") < 0) {
        return 41;
    }
    print("effect-cycle-branch-rejected");
    return 0;
}
