use bootstrap.effect_manifest;

fn main() -> i32 {
    var manifest = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate",
        "source-a", "compiler-a");
    if (!manifest.add_record("effect-gate.main", "myAttr", "level=abi",
                             "reflection", "module", "vyx", "abi-v1", 1, "")) {
        return 10;
    }
    if (!manifest.add_dependency("std", "1.0", "digest-a")) { return 11; }
    manifest.seal();
    let wire = manifest.serialize();

    // A round trip is fresh only when all envelope fields and the fingerprint
    // match the consumer.  This is the API-level manifest evidence; compiler
    // cross-module emission/consumption remains a separate gate.
    let fresh = effect_manifest_deserialize(wire);
    if (fresh.validate("vyx", "abi-v1", "module", "source-a", "compiler-a")
        != effect_manifest_fresh()) { return 12; }
    print("manifest-fresh");

    let target = effect_manifest_deserialize(wire);
    if (target.validate("cpp", "abi-v1", "module", "source-a", "compiler-a")
        != effect_manifest_target_mismatch()) { return 13; }
    print("target-mismatch");

    let abi = effect_manifest_deserialize(wire);
    if (abi.validate("vyx", "abi-v2", "module", "source-a", "compiler-a")
        != effect_manifest_abi_mismatch()) { return 14; }
    print("abi-mismatch");

    let scope = effect_manifest_deserialize(wire);
    if (scope.validate("vyx", "abi-v1", "unit", "source-a", "compiler-a")
        != effect_manifest_scope_mismatch()) { return 19; }
    print("scope-mismatch");

    let source = effect_manifest_deserialize(wire);
    if (source.validate("vyx", "abi-v1", "module", "source-b", "compiler-a")
        != effect_manifest_source_stale()) { return 15; }
    print("source-stale");

    let compiler = effect_manifest_deserialize(wire);
    if (compiler.validate("vyx", "abi-v1", "module", "source-a", "compiler-b")
        != effect_manifest_compiler_stale()) { return 16; }
    print("compiler-stale");

    let version = effect_manifest_deserialize(
        "H\t2\tvyx\tabi-v1\tmodule\teffect-gate\tsource-a\tcompiler-a\t0\n");
    if (version.validate("vyx", "abi-v1", "module", "source-a", "compiler-a")
        != effect_manifest_stale_version()) { return 17; }
    print("version-stale");

    let corrupt = effect_manifest_deserialize(wire + "X\tunknown\n");
    if (corrupt.status() != effect_manifest_malformed()) { return 18; }
    print("malformed-rejected");

    // A blank row is not a record terminator.  It must not allow trailing
    // bytes to disappear from the signed envelope.
    let blank = effect_manifest_deserialize(wire + "\nX\tunknown\n");
    if (blank.status() != effect_manifest_malformed()) { return 23; }
    print("manifest-blank-line-rejected");

    // Canonical row ordering is part of the cache key.  Two producers that
    // discover the same facts/dependencies in opposite orders must emit the
    // same wire bytes and dependency summary.
    var ordered = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate", "source-order", "compiler-a");
    if (!ordered.add_record("effect-gate.alpha", "reflect", "name=a",
                            "reflection", "module", "vyx", "abi-v1", 0, "")) {
        return 24;
    }
    if (!ordered.add_record("effect-gate.beta", "migrate", "name=b",
                            "migrate", "module", "vyx", "abi-v1", 0, "")) {
        return 25;
    }
    if (!ordered.add_dependency("dep-a", "1", "digest-a")) { return 26; }
    if (!ordered.add_dependency("dep-b", "1", "digest-b")) { return 27; }
    ordered.seal();

    var reversed = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate", "source-order", "compiler-a");
    if (!reversed.add_record("effect-gate.beta", "migrate", "name=b",
                             "migrate", "module", "vyx", "abi-v1", 0, "")) {
        return 28;
    }
    if (!reversed.add_record("effect-gate.alpha", "reflect", "name=a",
                             "reflection", "module", "vyx", "abi-v1", 0, "")) {
        return 29;
    }
    if (!reversed.add_dependency("dep-b", "1", "digest-b")) { return 30; }
    if (!reversed.add_dependency("dep-a", "1", "digest-a")) { return 31; }
    reversed.seal();
    if (ordered.fingerprint != reversed.fingerprint
        || ordered.dependency_summary() != reversed.dependency_summary()
        || ordered.serialize() != reversed.serialize()) {
        return 32;
    }
    print("manifest-order-independent-fingerprint");

    // A changed dependency is an invalidation input even when all Effect rows
    // remain byte-for-byte identical.
    var changed = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate", "source-order", "compiler-a");
    if (!changed.add_record("effect-gate.alpha", "reflect", "name=a",
                            "reflection", "module", "vyx", "abi-v1", 0, "")) {
        return 33;
    }
    if (!changed.add_record("effect-gate.beta", "migrate", "name=b",
                            "migrate", "module", "vyx", "abi-v1", 0, "")) {
        return 34;
    }
    if (!changed.add_dependency("dep-a", "1", "digest-changed")) { return 35; }
    if (!changed.add_dependency("dep-b", "1", "digest-b")) { return 36; }
    changed.seal();
    if (changed.fingerprint == ordered.fingerprint
        || changed.dependency_summary() == ordered.dependency_summary()) {
        return 37;
    }
    print("manifest-dependency-invalidation");

    // A non-repeatable fact identity cannot silently acquire a second value.
    var identity = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate", "source-identity", "compiler-a");
    if (!identity.add_record("effect-gate.same", "reflect", "name=one",
                             "reflection", "module", "vyx", "abi-v1", 0, "")) {
        return 38;
    }
    if (identity.add_record("effect-gate.same", "reflect", "name=two",
                            "reflection", "module", "vyx", "abi-v1", 0, "")) {
        return 39;
    }
    if (identity.conflict_count != 1) { return 40; }
    identity.seal();
    if (identity.validate("vyx", "abi-v1", "module", "source-identity", "compiler-a")
        != effect_manifest_malformed()) { return 41; }
    print("manifest-identity-conflict");

    // Unknown percent escapes and negative flags are rejected before rows are
    // admitted to the consumer state.
    let bad_escape = effect_manifest_deserialize(
        "H\t1\tvyx%41\tabi-v1\tmodule\teffect-gate\tsource-a\tcompiler-a\t0\n");
    if (bad_escape.status() != effect_manifest_malformed()) { return 42; }
    var bad_flags = EffectManifest.create(
        "vyx", "abi-v1", "module", "effect-gate", "source-flags", "compiler-a");
    if (bad_flags.add_record("effect-gate.flags", "reflect", "",
                             "reflection", "module", "vyx", "abi-v1", 8, "")) {
        return 43;
    }
    if (bad_flags.add_record("effect-gate.flags-composite", "reflect", "",
                             "reflection", "module", "vyx", "abi-v1", 3, "")) {
        return 44;
    }
    if (bad_flags.malformed_count != 2) { return 45; }
    print("manifest-encoding-and-flags-rejected");
    return 0;
}
