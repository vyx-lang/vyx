// Source-level declarative Effect syntax.  The declaration is data consumed
// by the compiler EffectPlan; it does not emit a runtime function.
effect reflect_alias {
    phase: metadata;
    reads: [migrate.field_alias, reflect.registration];
    provides: [reflect.name_alias];
    requires: [stable_identity];
    capability: [retain_metadata];
}

fn main() -> i32 {
    print("effect-decl-parser-ok");
    return 0;
}
