@[myAttr(level="abi", retain=true)]
fn marker() -> i32 {
    return 7;
}

// The declarative myAttr handler derives a retain capability.  This function
// is intentionally uncalled: its presence in MIR proves the handler result,
// rather than the raw attribute spelling, authorized codegen reachability.
@[myAttr(level="layout", retain=true)]
fn custom_kept() -> i32 {
    return 17;
}

@[reflect("EffectGateType")]
public class EffectGateType {
    public value: i32;
}

fn main() -> i32 {
    if (marker() != 7) { return 1; }
    print("custom-attr-aot-ok");
    return 0;
}
