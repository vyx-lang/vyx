attribute acme.layout {
    version: 1;
    targets: [function, type, field];
    extends: [acme.base];

    arguments {
        mode: enum("abi", "layout");
        retain: bool = false;
    }

    consequence: retain;
}

attribute acme.note {
    version: 1;
    targets: [function];

    arguments {
        label: string = "startup";
        code: u8 = 7;
    }

    consequence: record;
}
