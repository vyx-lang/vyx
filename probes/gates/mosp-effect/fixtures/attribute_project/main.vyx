// The build discovers all schemas before it compiles Vyx source.  No schema
// environment variable or per-command input is required.
@[acme.layout(mode="layout", align=8)]
class AttrRecord {
    @[acme.base(align=4)]
    public value: i32;
}

class AttrOtherRecord {
    @[acme.base(align=8)]
    public value: i32;
}

@[acme.layout(mode="abi", align=16, retain=true)]
fn attr_kept() -> i32 {
    return 29;
}

@[acme.note(code=255)]
fn attr_marker() -> i32 {
    return 7;
}

@[acme.base(align=2147483647)]
fn attr_i32_max() -> i32 {
    return 0;
}

fn main() -> i32 {
    var record = AttrRecord{5};
    if (record.value != 5) { return 1; }
    var other = AttrOtherRecord{9};
    if (other.value != 9) { return 2; }
    print("attribute-project-aot-ok");
    return 0;
}
