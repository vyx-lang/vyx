use bootstrap.effect_attributes;

fn schema(params: string) -> string {
    return "attribute acme.base { version: 1; targets: [function]; arguments { "
        + params + " } consequence: record; }";
}

fn main() -> i32 {
    let base = schema("align: i32 = 0; label: string = \"arguments version: targets: consequence:\";");
    let derived = "attribute acme.layout { version: 1; targets: [function]; extends: [acme.base]; arguments { retain: bool = false; } consequence: retain; }";
    let table = effect_attribute_source_schema_text(derived + "\n// forward reference\n" + base);
    if (!effect_attribute_schema_text_valid(table) || effect_attribute_schema_row_count(table) != 2) { return 1; }
    let layout = effect_attribute_schema_row_at(table, 0);
    if (effect_attribute_schema_args_error(layout, "align=2147483648").len == 0) { return 2; }
    if (!effect_attribute_schema_args_valid(layout, "align=-2147483648")) { return 3; }
    if (effect_attribute_schema_args_normalize(layout, "align=16")
        != "align=16,label=\"arguments version: targets: consequence:\",retain=false") { return 4; }

    let scalars = effect_attribute_source_schema_text(schema(
        "a: i8 = -128; b: i16 = -32768; c: i32 = -2147483648; d: i64 = -9223372036854775808; "
        + "e: u8 = 255; f: u16 = 65535; g: u32 = 4294967295; h: u64 = 18446744073709551615; "
        + "i: f32 = 1.5; j: f64 = 1.25e100; k: str = \"ok\";"));
    if (!effect_attribute_schema_text_valid(scalars)) { return 5; }
    if (effect_attribute_source_error(schema("align: int = 0;")).len == 0) { return 6; }
    if (effect_attribute_source_error(schema("align: i8 = 128;")).len == 0) { return 7; }
    if (effect_attribute_source_error(schema("align: u64 = 18446744073709551616;")).len == 0) { return 8; }
    if (effect_attribute_source_error(schema("align: f32 = 1e100;")).len == 0) { return 9; }
    if (effect_attribute_source_error(schema("align: bool = 1;")).len == 0) { return 10; }
    if (effect_attribute_source_error(schema("mode: enum(\"a\", \"a\");")).len == 0) { return 11; }
    if (effect_attribute_source_error(schema("align: i32 = 0")).len == 0) { return 12; }
    if (effect_attribute_source_error("junk " + base).len == 0) { return 13; }
    if (effect_attribute_source_error(base + " junk").len == 0) { return 14; }
    if (effect_attribute_source_error("attribute acme.bad { version: 1; targets: [function]; consequence: record; }").len == 0) { return 15; }
    if (effect_attribute_source_error("attribute acme.bad { version: 1; targets: [function]; arguments {} consequence: record; unknown: 1; }").len == 0) { return 16; }
    if (effect_attribute_source_error("attribute acme.bad { version: 1; targets: [function]; arguments {} consequence: record; consequence: retain; }").len == 0) { return 17; }
    if (effect_attribute_source_error("attribute acme.bad { version: 1; targets: [function]; extends: [acme.missing]; arguments {} consequence: record; }").len == 0) { return 18; }
    if (effect_attribute_source_error("attribute acme.bad { version: 1; targets: [function]; extends: [acme.bad]; arguments {} consequence: record; }").len == 0) { return 19; }
    if (effect_attribute_source_error(base + base).len == 0) { return 20; }
    if (effect_attribute_source_error(derived.replace("retain: bool = false;", "align: i32 = 0;") + base).len == 0) { return 21; }
    print("attribute-source-api-aot-ok");
    return 0;
}
