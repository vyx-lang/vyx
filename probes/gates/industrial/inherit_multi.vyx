class Left {
    public a: i32;
    public fn fa(self) -> i32 { return self.a; }
}

class Right {
    public c: i32;
    public fn fc(self) -> i32 { return self.c; }
}

class Mix : Left, Right {
    public b: i32;
    public fn sum(self) -> i32 { return self.fa() + self.b + self.fc(); }
}

fn main() -> i32 {
    let m = Mix { a: 1, c: 2, b: 4 };
    if (m.a != 1) { return 1; }
    if (m.c != 2) { return 2; }
    if (m.b != 4) { return 3; }
    if (m.fa() != 1) { return 4; }
    if (m.fc() != 2) { return 5; }
    if (m.sum() != 7) { return 6; }
    return 0;
}
