interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
    public fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

class Holder {
    public s: dyn Shape;
}

fn main() -> i32 {
    let h = Holder { s: Circle { r: 5 } };
    if (h.s.area() != 25) { return 1; }
    return 0;
}
