use std.ref;

interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

fn make<T>(t: T) -> Box<dyn Shape> {
    return Box::<dyn Shape>.new(t);
}

fn main() -> i32 {
    if (make::<Circle>(Circle { r: 3 }).deref().area() != 9) { return 1; }
    return 0;
}
