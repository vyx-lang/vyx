class Base {
    public x: i32;
    public fn get(self) -> i32 { return self.x; }
}

class Child : Base {
    public y: i32;
    public override fn get(self) -> i32 { return self.x + self.y; }
}

fn main() -> i32 {
    let c = Child { x: 3, y: 4 };
    if (c.get() != 7) { return 1; }
    if (c.x != 3) { return 2; }
    return 0;
}
