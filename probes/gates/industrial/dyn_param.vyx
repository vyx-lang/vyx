interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
    public fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

fn go(x: dyn Shape) -> i32 {
    return x.area();
}

fn main() -> i32 {
    let c = Circle { r: 3 };
    if (go(c) != 9) { return 1; }
    if (go(c as dyn Shape) != 9) { return 2; }
    return 0;
}
