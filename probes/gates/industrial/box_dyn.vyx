use std.ref;

interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
}

class Square {
    public s: i32;
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Square {
    fn area(self) -> i32 { return self.s * self.s; }
}

fn boxed_area(b: Box<dyn Shape>) -> i32 {
    return b.deref().area();
}

fn main() -> i32 {
    let c = Box::<dyn Shape>.new(Circle { r: 3 });
    let s = Box::<dyn Shape>.new(Square { s: 4 });
    if (boxed_area(c) != 9) { return 1; }
    if (boxed_area(s) != 16) { return 2; }
    return 0;
}
