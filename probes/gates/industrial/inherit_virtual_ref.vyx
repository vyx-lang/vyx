class Base {
    public x: i32;
    public fn get(self) -> i32 { return self.x; }
}

class Child : Base {
    public y: i32;
    public override fn get(self) -> i32 { return self.x + self.y; }
}

fn go(b: &Base) -> i32 {
    return b.get();
}

fn main() -> i32 {
    let c = Child { x: 3, y: 4 };
    // Unique rule: class method lookup is the peeled static type.
    // `&Child` viewed as `&Base` is Base, so this is Base.get (x == 3).
    // Runtime virtual dispatch is `dyn Trait`, not class inheritance.
    if (go(&c) != 3) { return 1; }
    if (c.get() != 7) { return 2; }
    return 0;
}
