interface Greeter {
    fn greet(self) -> i32;
    fn hello(self) -> i32 { return self.greet() + 1; }
}

class En {
    public n: i32;
}

impl Greeter for En {
    fn greet(self) -> i32 { return self.n; }
}

fn main() -> i32 {
    let e = En { n: 6 };
    if (e.hello() != 7) { return 1; }
    let d: dyn Greeter = e;
    if (d.hello() != 7) { return 2; }
    return 0;
}
