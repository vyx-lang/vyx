fn take8(x: i8) -> i8 { return x; }
fn take32(x: i32) -> i32 { return x; }
fn take64(x: i64) -> i64 { return x; }
fn takeu8(x: u8) -> u8 { return x; }
fn takeu32(x: u32) -> u32 { return x; }
fn takeusize(x: usize) -> usize { return x; }

fn main() -> i32 {
    let a: i8 = 3;
    if (take8(a) != 3) { return 1; }
    let b: i32 = 5;
    if (take32(b) != 5) { return 2; }
    if (take32(7) != 7) { return 3; }
    let c: i8 = 4;
    if (take32(c) != 4) { return 4; }
    if (take64(c) != 4) { return 5; }
    let d: u8 = 9;
    if (takeu8(d) != 9) { return 6; }
    if (takeu32(d) != 9) { return 7; }
    if (takeu8(11) != 11) { return 8; }
    if (takeusize(13) != 13) { return 9; }
    return 0;
}
