interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
    public fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

fn make() -> dyn Shape {
    return Circle { r: 4 };
}

fn make_ref(c: &Circle) -> &dyn Shape {
    return c;
}

fn main() -> i32 {
    if (make().area() != 16) { return 1; }
    let c = Circle { r: 3 };
    if (make_ref(&c).area() != 9) { return 2; }
    return 0;
}
