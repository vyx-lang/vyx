interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
    public fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

class Holder {
    public s: dyn Shape;
}

fn main() -> i32 {
    var x: dyn Shape = Circle { r: 2 };
    if (x.area() != 4) { return 1; }
    x = Circle { r: 3 };
    if (x.area() != 9) { return 2; }
    var h = Holder { s: Circle { r: 4 } };
    h.s = Circle { r: 5 };
    if (h.s.area() != 25) { return 3; }
    return 0;
}
