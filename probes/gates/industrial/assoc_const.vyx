trait Bounded {
    const MAX: i64;
    fn value(self) -> i64;
}

class U8Like {
    public v: i64;
    const MAX: i64 = 255;
    public fn value(self) -> i64 { return self.v; }
}

fn clamp<T>(x: T) -> i64 where T: Bounded {
    let v = x.value();
    if (v > T::MAX) { return T::MAX; }
    return v;
}

fn main() -> i32 {
    let a = clamp::<U8Like>(U8Like { v: 300 });
    let b = clamp::<U8Like>(U8Like { v: 123 });
    if (a != 255) { return 1; }
    if (b != 123) { return 2; }
    return 0;
}
