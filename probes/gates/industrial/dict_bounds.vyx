use std.collections;

fn main() -> i32 {
    var d = Dict::<string, i32>.new();
    d.put("a", 10);
    d.put("b", 20);
    if (!d.contains("a")) { return 1; }
    if (d.get("a") != 10) { return 2; }
    if (d.get("b") != 20) { return 3; }
    if (d.contains("missing")) { return 4; }
    return 0;
}
