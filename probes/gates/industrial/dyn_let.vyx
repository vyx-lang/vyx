interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
    public fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

fn main() -> i32 {
    let c = Circle { r: 3 };
    let x: dyn Shape = c;
    if (x.area() != 9) { return 1; }
    let d = Circle { r: 3 };
    let y: &dyn Shape = &d;
    if (y.area() != 9) { return 2; }
    return 0;
}
