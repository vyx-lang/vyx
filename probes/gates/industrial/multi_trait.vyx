interface Named {
    fn name(self) -> i32;
}

interface Countable {
    fn count(self) -> i32;
}

class Dog {
    public n: i32;
}

impl Named for Dog {
    fn name(self) -> i32 { return 1; }
}

impl Countable for Dog {
    fn count(self) -> i32 { return self.n; }
}

fn describe<T>(v: T) -> i32 where T: Named + Countable {
    return v.name() + v.count();
}

fn main() -> i32 {
    let d = Dog { n: 4 };
    if (describe::<Dog>(d) != 5) { return 1; }
    return 0;
}
