use std.collections;

interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
}

class Square {
    public s: i32;
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

impl Shape for Square {
    fn area(self) -> i32 { return self.s * self.s; }
}

fn total(items: Vec<dyn Shape>) -> i32 {
    var t: i32 = 0;
    var i: i64 = 0;
    while (i < items.size()) {
        t = t + items.get(i).area();
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    var v = Vec::<dyn Shape>.new();
    v.push(Circle { r: 3 });
    v.push(Square { s: 4 });
    if (total(v) != 25) { return 1; }
    return 0;
}
