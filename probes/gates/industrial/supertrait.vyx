interface Shape {
    fn area(self) -> i32;
}

interface Drawable : Shape {
    fn draw(self) -> i32;
}

class Circle {
    public r: i32;
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

impl Drawable for Circle {
    fn draw(self) -> i32 { return self.area(); }
}

fn go(x: dyn Drawable) -> i32 {
    return x.area() + x.draw();
}

fn main() -> i32 {
    let c = Circle { r: 3 };
    if (go(c) != 18) { return 1; }
    return 0;
}
