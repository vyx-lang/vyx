use std.collections;
use std.ref;

interface Shape {
    fn area(self) -> i32;
}

class Circle {
    public r: i32;
}

impl Shape for Circle {
    fn area(self) -> i32 { return self.r * self.r; }
}

fn main() -> i32 {
    var d = Dict::<string, Box<dyn Shape>>.new();
    d.put("c", Box::<dyn Shape>.new(Circle { r: 3 }));
    if (d.get("c").deref().area() != 9) { return 1; }
    return 0;
}
