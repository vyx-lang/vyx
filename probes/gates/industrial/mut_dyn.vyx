interface Counter {
    fn bump(self) -> void;
    fn get(self) -> i32;
}

class Cell {
    public n: i32;
}

impl Counter for Cell {
    fn bump(self) -> void { self.n = self.n + 1; }
    fn get(self) -> i32 { return self.n; }
}

fn bump_one(c: &mut dyn Counter) -> void {
    c.bump();
}

fn main() -> i32 {
    var x = Cell { n: 3 };
    bump_one(&mut x);
    if (x.n != 4) { return 1; }
    return 0;
}
