struct Vec2 {
    public x: i32;
    public y: i32;
}

struct Vec3 : Vec2 {
    public z: i32;
}

class Base {
    public x: i32;
    public fn get(self) -> i32 { return self.x; }
}

class Child : Base {
    public y: i32;
}

fn main() -> i32 {
    let v = Vec3 { x: 1, y: 2, z: 3 };
    if (v.x + v.y + v.z != 6) { return 1; }
    let c = Child { x: 3, y: 4 };
    if (c.get() != 3) { return 2; }
    if (c.y != 4) { return 3; }
    return 0;
}
