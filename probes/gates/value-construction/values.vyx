use std.string;
use std.ref;

interface Metric { fn measure() -> i64; }
class Record { public value: i64; }
type RecordAlias = Record;
impl Metric for Record { public fn measure() -> i64 { return self.value; } }

class Counter {
    public value: i64;
    public Counter(value: i64) { self.value = value; }
}

class Factory {
    public value: i64;
    public static fn new(value: i64) -> Factory { return Factory { value: value + 1 }; }
}

fn make<T, ...Args>(...args: Args) -> T { return construct::<T>(args...); }

fn main() -> i32 {
    let empty = Record.new();
    if (empty.value != 0) { return 1; }
    let same = Record.new(Record { value: 7 });
    if (same.value != 7) { return 2; }
    let aliased = RecordAlias.new(Record { value: 9 });
    if (aliased.value != 9) { return 11; }
    let made = make::<Record>(Record { value: 11 });
    if (made.value != 11) { return 3; }
    let counter = Counter.new(41 as i64);
    if (counter.value != 41) { return 4; }
    let factory = Factory.new(41 as i64);
    if (factory.value != 42) { return 5; }
    let boxed = Box::<Counter>.new(43 as i64);
    if (boxed.deref().value != 43) { return 6; }
    let dyn_value = Box::<dyn Metric>.new(Record { value: 47 });
    if (dyn_value.deref().measure() != 47) { return 7; }
    var short = String.new("short");
    if (short.as_str() != "short" || !short.isSmall()) { return 8; }
    var heap = make::<String>("0123456789012345678901234567890123456789");
    if (heap.as_str() != "0123456789012345678901234567890123456789" || !heap.isHeap()) { return 9; }
    var moved = String.new(String.from("0123456789012345678901234567890123456789"));
    if (moved.as_str() != heap.as_str()) { return 10; }
    print("value-construction=ok");
    return 0;
}
