module probes.generic_impl_scope;

use std.defaults;
use std.core;

class GenericStore<K, V> where K: Ord + Eq {
    public count: i64;

    public fn empty_value(&mut self, key: K) -> V where V: Default {
        let value: V = V::default_value();
        return value;
    }
}

impl Default for GenericStore<K, V> where K: Ord + Eq {
    static fn default_value() -> GenericStore<K, V> {
        return GenericStore { count: 0 };
    }
}
