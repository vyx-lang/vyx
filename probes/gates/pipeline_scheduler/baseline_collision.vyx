// Appended to verbatim baseline cache helpers from git HEAD.
fn main() -> i32 {
    if (build_cache_record_digest("Aa") != build_cache_record_digest("B@")) { return 1; }
    let old_index = build_cache_digest_index("padding-record-one\npadding-record-two\npadding-record-three\nAa\n");
    if (!build_cache_has_indexed(old_index, "B@", "fixtures/present.obj")) {
        print("index=[" + old_index + "] digest=[" + build_cache_record_digest("B@") + "]");
        print("object exists=" + fileExists("fixtures/present.obj").toString());
        print("FAIL: baseline did not reproduce the old collision"); return 2;
    }
    print("baseline cache collision reproduced");
    return 0;
}
