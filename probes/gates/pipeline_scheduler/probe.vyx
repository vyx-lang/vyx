// Appended to production helper definitions by run.ps1.
fn detached_builder(text: string) -> string {
    var builder = StringBuilder.withCapacity(text.len + 1);
    builder.append(text);
    var owned = builder.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    return result;
}

// Fixture construction/serialization are assertion adapters only. Priority and
// launch ordering come from verbatim production functions; the executor retains
// typed actions and stable numeric IDs instead of this text representation.
fn probe_sorted_tasks(rows: string, count: i64) -> string {
    var actions = Vec::<BuildAction>.with_capacity(count);
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= rows.len) {
        if (pos == rows.len || rows.charAt(pos) == 10) {
            if (pos > start) {
                let row = rows.substring(start, pos);
                var action: BuildAction;
                action.step = build_field(row, 0);
                action.source = build_field(row, 1);
                action.output = build_field(row, 2);
                action.command = build_field(row, 3);
                action.priority = build_task_priority(row);
                // Sentinels ensure reordering IDs cannot modify the actions.
                action.state = build_action_ready();
                action.process_id = -77;
                action.peak_resident_bytes = 101;
                action.peak_private_bytes = 202;
                action.cpu_time_us = 303;
                action.exit_code = -19;
                actions.push(action);
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    var order = build_action_launch_order(&mut actions);
    var output = StringBuilder.withCapacity(rows.len + 1);
    var i: i64 = 0;
    while (i < order.len) {
        let id = order.get(i);
        if (id < 0 || id >= actions.len) { return "FAIL: invalid action ID"; }
        let action = actions.get_ptr(id);
        if (action[0].state != build_action_ready() || action[0].process_id != -77
            || action[0].peak_resident_bytes != 101 || action[0].peak_private_bytes != 202
            || action[0].cpu_time_us != 303 || action[0].exit_code != -19) {
            return "FAIL: sorting mutated action state or telemetry";
        }
        output.append(action[0].step);
        output.append("\t");
        output.append(action[0].source);
        output.append("\t");
        output.append(action[0].output);
        output.append("\t");
        output.append(action[0].command);
        output.append("\n");
        i = i + 1;
    }
    var owned = output.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    order.destroy();
    actions.destroy();
    return result;
}

fn main() -> i32 {
    let interface_task = "1\tproducer.vyx\tproducer.vyi\tcommand";
    let object_task = "2\tproducer.vyx\tproducer.obj\tcommand";
    let native_task = "3\tproducer.cpp\tproducer.obj\tcommand";
    if (!build_task_uses_vyx_frontend(interface_task) || build_task_is_vyx_codegen(interface_task)
        || !build_task_uses_vyx_frontend(object_task) || !build_task_is_vyx_codegen(object_task)
        || build_task_uses_vyx_frontend(native_task) || build_task_is_vyx_codegen(native_task)) {
        print("FAIL: interface frontend memory classification differs from codegen slots"); return 31;
    }
    let mode = getArg(1);
    if (mode == "ownership") {
        let lengths = "0|1|23|24|63|64";
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= lengths.len) {
            if (i == lengths.len || lengths.charAt(i) == 124) {
                let size = lengths.substring(start, i);
                let original = readFile("fixtures/length_" + size + ".txt");
                let first = detached_builder(original);
                // Reuse the helper's stack and destroy another String owner.
                let later = detached_builder("overwrite the prior String owner's inline storage");
                if (first != original || later != "overwrite the prior String owner's inline storage") {
                    print("FAIL: detached String owner boundary " + size); return 30;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        print("pipeline_scheduler: OK ownership 0/1/23/24/63/64");
        return 0;
    }
    let object = "fixtures/present.obj";
    let cache = "Aa\r\nrecord-one\n";
    let index = build_cache_digest_index(cache);
    if (build_cache_record_digest("Aa") != build_cache_record_digest("B@")) {
        print("FAIL: fixture is not an equal-length hash collision"); return 1;
    }
    if (!build_cache_has_indexed(cache, index, "Aa", object)) {
        print("FAIL: exact CRLF cache record"); return 2;
    }
    if (build_cache_has_indexed(cache, index, "B@", object)) {
        print("FAIL: colliding record was accepted"); return 3;
    }
    if (build_cache_has_indexed(cache, index, "Aa", "fixtures/missing.obj")) {
        print("FAIL: missing object was accepted"); return 4;
    }
    if (build_cache_has_indexed(cache, index, "record-on", object)) {
        print("FAIL: partial record was accepted"); return 5;
    }
    let last_cache = "Aa\nB@";
    let last_index = build_cache_digest_index(last_cache);
    if (!build_cache_has_indexed(last_cache, last_index, "B@", object)) {
        print("FAIL: final line or collision candidate scan"); return 6;
    }
    if (build_cache_has_indexed("", build_cache_digest_index(""), "Aa", object)) {
        print("FAIL: empty cache"); return 7;
    }
    let single_cache = "Aa\n";
    if (!build_cache_has_indexed(single_cache, build_cache_digest_index(single_cache), "Aa", object)) {
        print("FAIL: single short cache record"); return 8;
    }

    let old_records = "a\ta.obj\told\nb\tb.obj\tkeep\n";
    let updates = "a\ta.obj\tnew\na\ta.obj\tshadow\nc\tc.obj\tappended\n";
    let expected_merge = "a\ta.obj\tnew\nb\tb.obj\tkeep\nc\tc.obj\tappended\n";
    if (build_cache_replace_many(old_records, updates) != expected_merge) {
        print("FAIL: cache replacement, append, duplicate or preservation order"); return 40;
    }
    if (build_cache_replace_many("", updates) != "a\ta.obj\tnew\nc\tc.obj\tappended\n") {
        print("FAIL: initial cache merge must keep first record for duplicate key"); return 41;
    }
    if (build_cache_replace_many(old_records, "") != old_records
        || build_cache_replace_many("", "") != "") {
        print("FAIL: empty cache records"); return 42;
    }
    if (build_records_find_by_key(updates, "a\ta.obj") != "a\ta.obj\tnew"
        || build_records_find_by_key(updates, "absent\tabsent.obj") != "") {
        print("FAIL: exact first-record lookup"); return 43;
    }
    let short_merge = build_cache_replace_many("a\tb\tx\n", "a\tb\ty\n");
    let long_input = readFile("fixtures/long_records.tsv");
    let long_merge = build_cache_replace_many(long_input, "a\tb\tz\n");
    if (short_merge != "a\tb\ty\n"
        || long_merge != readFile("fixtures/long_records_expected.tsv")) {
        print("FAIL: short/long cache output lifetime or unmatched record order"); return 44;
    }

    let gib: i64 = 1073741824;
    if (build_resource_credit(-1, 4 * gib) != 0 || build_resource_credit(0, 4 * gib) != 0) {
        print("FAIL: unknown memory credit"); return 10;
    }
    if (build_resource_credit(9 * gib, 4 * gib) != 4 * gib) {
        print("FAIL: resident usage above reservation over-credited"); return 11;
    }
    if (build_resource_credit(2 * gib, 4 * gib) != 2 * gib) {
        print("FAIL: observed resident credit"); return 12;
    }
    if (build_resource_credit(2 * gib, 0) != 0) {
        print("FAIL: zero reservation credit"); return 13;
    }
    if (build_resource_headroom(gib, 0, 3 * gib) != 0) {
        print("FAIL: zero memory headroom"); return 14;
    }
    let low = build_resource_headroom(5 * gib, 0, 3 * gib);
    let recovered = build_resource_headroom(15 * gib, 0, 3 * gib);
    if (low != 2 * gib || recovered != 12 * gib) {
        print("FAIL: free memory recovery"); return 15;
    }
    let before_launch = build_resource_headroom(15 * gib, 0, 3 * gib);
    let during_launch = build_resource_headroom(11 * gib, build_resource_credit(4 * gib, 4 * gib), 3 * gib);
    if (before_launch != during_launch) {
        print("FAIL: active resident memory double-counted"); return 16;
    }
    if (build_resource_limit(12 * gib, 20 * gib, 5 * gib) != 5 * gib) {
        print("FAIL: manual memory cap"); return 17;
    }
    if (build_resource_limit(2 * gib, 20 * gib, 10 * gib) != 2 * gib) {
        print("FAIL: manual budget bypassed available memory"); return 18;
    }
    if (build_resource_limit(12 * gib, 2 * gib, 0) != 2 * gib
        || build_resource_limit(12 * gib, -1, 0) != 12 * gib
        || build_resource_limit(-1, 2 * gib, 0) != 2 * gib) {
        print("FAIL: independent physical and commit headroom"); return 19;
    }
    if (build_resource_headroom(-1, gib, 0) != -1
        || build_resource_limit(-1, -1, 0) != -1
        || build_resource_fits(0, gib, -1)) {
        print("FAIL: unknown headroom must not invent available memory"); return 25;
    }
    if (!build_resource_fits(gib, gib, 2 * gib)
        || build_resource_fits(gib, gib + 1, 2 * gib)
        || build_resource_fits(3 * gib, gib, 2 * gib)
        || build_resource_fits(0, 0, gib)
        || build_resource_fits(-1, gib, 2 * gib)) {
        print("FAIL: byte-accurate admission bounds"); return 26;
    }
    if (!build_resource_fits(0, gib / 2, gib - 1)
        || build_resource_fits(0, gib, gib - 1)) {
        print("FAIL: sub-GiB memory budget was rounded"); return 27;
    }
    let maximum: i64 = 9223372036854775807;
    if (!build_active_memory_exhausted(2 * gib - 1, 8 * gib, 4 * gib)
        || !build_active_memory_exhausted(8 * gib, 2 * gib - 1, 4 * gib)
        || build_active_memory_exhausted(2 * gib, 2 * gib, 4 * gib)
        || build_active_memory_exhausted(-1, -1, 4 * gib)
        || !build_active_memory_exhausted(-1, gib, 4 * gib)
        || !build_active_memory_exhausted(gib, -1, 4 * gib)
        || build_active_memory_exhausted(0, 0, 0)
        || !build_active_memory_exhausted(gib / 8 - 1, -1, gib / 4)
        || build_active_memory_exhausted(gib / 8, -1, gib / 4)
        || build_active_memory_exhausted(2 * gib, -1, maximum)) {
        print("FAIL: active batch exhaustion threshold"); return 36;
    }
    let host_reserve = build_resource_default_reserve(12 * gib);
    if (host_reserve != 4 * gib
        || build_resource_default_reserve(gib / 2) != gib / 4
        || build_resource_fits(7 * gib, gib + 1,
            build_resource_headroom(6 * gib, 6 * gib, host_reserve))) {
        print("FAIL: active workers spent the host reserve"); return 33;
    }
    if (build_resource_cold_estimate(maximum, true) != maximum
        || build_resource_measured_estimate(maximum, -1) != maximum
        || build_resource_measured_estimate(-1, -1) != 0
        || build_resource_measured_estimate(100, 200) != 250) {
        print("FAIL: cost estimates overflow or invent telemetry"); return 29;
    }
    let key = "vyx-action-cost-v1\ncompiler\n100\ncommand\n";
    writeFile("fixtures/cost.obj.vyx-cost", key + "100\t200");
    if (build_action_memory_estimate("fixtures/cost.obj", key, 100, true) != 250) {
        print("FAIL: measured cost profile ignored"); return 30;
    }
    let cold = build_resource_cold_estimate(100, true);
    if (build_action_memory_estimate("fixtures/no-profile.obj", key, 100, true, 1048576)
            != cold + 268435456
        || build_action_memory_estimate("fixtures/no-profile.obj", key, 100, true, maximum) != maximum
        || build_action_memory_estimate("fixtures/cost.obj", key, 100, true, 1048576) != 250) {
        print("FAIL: peer interfaces omitted from cold estimates or measured profile overridden"); return 34;
    }
    let peer_task = "88\tsrc/app/View.vyx\tfixtures/no-profile.obj\tcompile\t128199\t11578063\t1048576";
    let peer_primary = build_parse_i64(build_field(peer_task, 4));
    let peer_inputs = build_parse_i64(build_field(peer_task, 5));
    if (peer_primary != 128199 || peer_inputs != 11578063
        || build_action_memory_estimate(build_field(peer_task, 2), key,
            peer_primary, build_task_uses_vyx_frontend(peer_task), peer_inputs,
            build_parse_i64(build_field(peer_task, 6)))
           != build_resource_cold_estimate(128199, true) + 2963984128 + gib) {
        print("FAIL: task transport lost its peer input estimate"); return 35;
    }
    if (build_action_memory_estimate("fixtures/no-profile.obj", key, 100, true, 0, maximum) != maximum
        || build_action_memory_estimate("fixtures/cost.obj", key, 100, true, 1048576, 1048576) != 250) {
        print("FAIL: imported source estimate overflow or measured profile replaced"); return 36;
    }
    var import_index = BuildSourceIndex.create(6);
    import_index.add("fixtures/primary.vyx", "A", "module:A", "");
    import_index.add("fixtures/primary-peer.vyx", "A", "module:A", "B.Type|B.Other");
    import_index.add("fixtures/import-b.vyx", "B", "module:B", "A.Back");
    import_index.add("fixtures/import-b-peer.vyx", "B", "module:B", "C.Type");
    import_index.add("fixtures/import-c.vyx", "C", "module:C", "B.Type");
    import_index.add("fixtures/unrelated.vyx", "BExtra", "module:BExtra", "");
    var import_walk = BuildPartitionWalkScratch.create(6);
    if (build_import_source_bytes(0, &mut import_index, &mut import_walk) != 60
        || build_import_source_bytes(4, &mut import_index, &mut import_walk) != 150
        || build_import_source_bytes(-1, &mut import_index, &mut import_walk) != 0) {
        print("FAIL: imported source closure omitted siblings, duplicated a cycle, or included unrelated modules"); return 37;
    }
    import_walk.destroy(); import_index.destroy();
    if (build_action_memory_estimate("fixtures/cost.obj", key + "changed", 100, true) != cold) {
        print("FAIL: stale command/tool profile accepted"); return 31;
    }
    writeFile("fixtures/cost.obj.vyx-cost", key + "-1\t-1");
    if (build_action_memory_estimate("fixtures/cost.obj", key, 100, true) != cold) {
        print("FAIL: unknown peak treated as zero cost"); return 32;
    }
    if (!build_resource_fits(maximum - 1, 1, maximum)
        || build_resource_fits(maximum - 1, 2, maximum)) {
        print("FAIL: reservation sum overflow"); return 28;
    }

    let tasks = readFile("fixtures/tasks.tsv");
    let sorted = probe_sorted_tasks(tasks, 96);
    let expected = readFile("fixtures/expected_" + mode + ".tsv");
    if (sorted != expected) {
        writeFile("actual_" + mode + ".tsv", sorted);
        print("FAIL: 96-task order or stable equal cost, mode=" + mode); return 20;
    }
    if (probe_sorted_tasks("", 0) != "") {
        print("FAIL: empty queue"); return 21;
    }
    let single = "1\tfixtures/one.vyx\titem.obj\tcommand\n";
    if (probe_sorted_tasks(single, 1) != single) {
        print("FAIL: single queue"); return 22;
    }
    if (mode == "cold") {
        let short_tasks = "0\ta\tb\tc\n1\td\te\tf\n";
        if (probe_sorted_tasks(short_tasks, 2) != short_tasks) {
            print("FAIL: short task queue escaped String inline storage"); return 24;
        }
        // These equal-size files use names favored by the old scheduler.
        // Renaming unchanged content must leave their planner order intact.
        let named = readFile("fixtures/named.tsv");
        let renamed = readFile("fixtures/renamed.tsv");
        if (probe_sorted_tasks(named, 3) != named
            || probe_sorted_tasks(renamed, 3) != renamed) {
            print("FAIL: filename affected equal-cost order"); return 23;
        }
    }
    print("pipeline_scheduler: OK " + mode);
    return 0;
}
