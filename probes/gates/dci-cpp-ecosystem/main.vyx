@[dci_import("contracts/icu.dcib")]
extern "dci" {
    class UnicodeString {
        UnicodeString();
        UnicodeString(capacity: i32, code_point: i32, count: i32);
        UnicodeString(other: &UnicodeString);
        ~UnicodeString();
        public fn length() const -> i32;
        public fn getCapacity() const -> i32;
        public fn charAt(offset: i32) const -> u16;
        public fn char32At(offset: i32) const -> i32;
        public fn countChar32(start: i32, length: i32) const -> i32;
        public fn moveIndex32(index: i32, delta: i32) const -> i32;
        public fn caseCompare(other: &UnicodeString, options: u32) const -> i8;
        public fn compareCodePointOrder(other: &UnicodeString) const -> i8;
        public fn append(code_point: i32) -> &UnicodeString;
        public fn toUpper() -> &UnicodeString;
        public fn toLower() -> &UnicodeString;
    };
}

fn main() -> i32 {
    var empty = UnicodeString();
    if (empty.length() != 0) { return 1; }
    var round: i32 = 0;
    var checksum: i64 = 0;
    while (round < 512) {
        // ICU allocates UTF-16 storage and fills supplementary code points.
        // This crosses its inline-buffer threshold and exercises surrogate
        // iteration, upstream copy semantics, and C++ destruction each round.
        let count: i32 = 32 + round % 97;
        var text = UnicodeString(1, 128512, count);
        if (text.length() != 2 * count) { return 2; }
        if (text.getCapacity() < text.length()) { return 3; }
        if (text.countChar32(0, text.length()) != count) { return 4; }
        if (text.charAt(0) != 55357) { return 5; }
        if (text.charAt(1) != 56832) { return 6; }
        if (text.char32At(0) != 128512) { return 7; }
        if (text.moveIndex32(0, count) != text.length()) { return 8; }
        if (text.moveIndex32(text.length(), -count) != 0) { return 9; }
        var copy = UnicodeString(&text);
        if (copy.length() != text.length()) { return 10; }
        if (copy.countChar32(0, copy.length()) != count) { return 11; }
        checksum += copy.char32At(copy.length() - 1) as i64;
        round += 1;
    }
    if (checksum != 65798144) { return 12; }
    // Case folding uses ICU's installed Unicode data, not fixture logic.
    var lower_accent = UnicodeString(1, 233, 64);
    var upper_accent = UnicodeString(1, 201, 64);
    if (lower_accent.caseCompare(&upper_accent, 0 as u32) != 0) { return 13; }
    if (lower_accent.compareCodePointOrder(&upper_accent) <= 0) { return 14; }
    var final_sigma = UnicodeString(1, 962, 32);
    var upper_sigma = UnicodeString(1, 931, 32);
    if (final_sigma.caseCompare(&upper_sigma, 0 as u32) != 0) { return 15; }
    var upper_i = UnicodeString(1, 73, 32);
    var lower_i = UnicodeString(1, 105, 32);
    if (upper_i.caseCompare(&lower_i, 0 as u32) != 0) { return 16; }
    if (upper_i.caseCompare(&lower_i, 1 as u32) == 0) { return 17; }
    var mutable_text = UnicodeString(1, 97, 128);
    mutable_text.toUpper();
    if (mutable_text.charAt(0) != 65) { return 18; }
    mutable_text.append(128512);
    if (mutable_text.length() != 130) { return 19; }
    if (mutable_text.countChar32(0, mutable_text.length()) != 129) { return 20; }
    mutable_text.toLower();
    if (mutable_text.charAt(0) != 97) { return 21; }
    var saved_copy = UnicodeString(&mutable_text);
    mutable_text.toUpper();
    if (saved_copy.charAt(0) != 97) { return 22; }
    var sharp_s = UnicodeString(1, 223, 2);
    sharp_s.toUpper();
    if (sharp_s.length() != 4) { return 23; }
    if (sharp_s.charAt(0) != 83 || sharp_s.charAt(3) != 83) { return 24; }
    print("DCI ICU 78.3 OK");
    return 0;
}
