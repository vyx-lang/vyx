@[dci_import("../../../tests/projects/dci_complex_abi/contracts/Complex.dcib")]
extern "dci" {
    class abi_complex.BigState {
        BigState(seed: i32);
        ~BigState();
        public fn sum() const -> i64;
    };
}

extern "C" {
    fn tracked_live() -> i32;
    fn tracked_balanced() -> i32;
}

fn scoped(early: bool) -> i64 {
    let value = abi_complex.BigState(10);
    if (early) { return value.sum(); }
    return value.sum();
}

fn borrowed(value: *abi_complex.BigState) -> i64 {
    return value.sum();
}

fn main() -> i32 {
    var i: i32 = 0;
    while (i < 2048) {
        if (scoped(i % 2 == 0) != 46) { return 1; }
        i = i + 1;
    }
    if (tracked_live() != 0) { return 2; }
    {
        var value = abi_complex.BigState(10);
        value = abi_complex.BigState(20);
        if (borrowed(value as *abi_complex.BigState) != 86) { return 3; }
    }
    if (tracked_live() != 0) { return 4; }
    for (j in 0..8) {
        let value = abi_complex.BigState(10);
        if (j == 2) { continue; }
        if (j == 5) { break; }
        if (value.sum() != 46) { return 5; }
    }
    if (tracked_balanced() != 1) { return 6; }
    print("dci_storage OK");
    return 0;
}
