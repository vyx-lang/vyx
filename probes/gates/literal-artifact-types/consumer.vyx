use literal_probe;

fn main() -> i32 {
    if (masked::<i32>(0) != 194) { return 1; }
    if (default_width::<i32>(0) != 32) { return 2; }
    if (wide_width::<i32>(0) != 64) { return 3; }
    if (suffix_width::<i32>(0) != 64) { return 4; }
    if (narrow_suffix_width::<i32>(0) != 8) { return 5; }
    return 0;
}
