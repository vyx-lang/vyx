module literal_probe;

fn width(value: i32) -> i32 { return 32; }
fn width(value: i64) -> i32 { return 64; }
fn byte_width(value: u8) -> i32 { return 8; }
fn byte_width(value: i32) -> i32 { return 32; }
fn take_i32(value: i32) -> i32 { return value; }

public fn masked<T>(unused: T) -> i32 {
    let byte: i32 = 194;
    let value = byte & 255;
    return take_i32(value);
}

public fn default_width<T>(unused: T) -> i32 {
    let value = 7;
    return width(value);
}

public fn wide_width<T>(unused: T) -> i32 {
    let value = 2147483648;
    return width(value);
}

public fn suffix_width<T>(unused: T) -> i32 {
    let value = 7i64;
    return width(value);
}

public fn narrow_suffix_width<T>(unused: T) -> i32 {
    let value = 7u8;
    return byte_width(value);
}
