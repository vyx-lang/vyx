use std.string;

fn main() -> i32 {
    var cursor = StrChars.from_str("aé中😀");
    if ((cursor.next().unwrap() as i32) != 97) { return 1; }
    if ((cursor.next().unwrap() as i32) != 233) { return 2; }
    if ((cursor.next().unwrap() as i32) != 20013) { return 3; }
    if ((cursor.next().unwrap() as i32) != 128512) { return 4; }
    if (cursor.has_next()) { return 5; }
    if (cursor.next().is_some()) { return 6; }
    var bytes: [u8; 4] = [255, 194, 65, 128];
    unsafe {
        let invalid = str_from_parts((&bytes[0]) as rawptr, 4, 0, 0);
        var broken = StrChars.from_str(invalid);
        if ((broken.next().unwrap() as i32) != 65533) { return 7; }
        if ((broken.next().unwrap() as i32) != 65533) { return 8; }
        if ((broken.next().unwrap() as i32) != 65) { return 9; }
        if ((broken.next().unwrap() as i32) != 65533) { return 10; }
        if (broken.has_next()) { return 11; }
    }
    return 0;
}
