use std.core;
var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
class Consumer {
    fn compare(&self, item: Token) -> i64 { return item.id; }
}
fn main() -> i32 {
    let item = Token { id: 7 };
    let consumer = Consumer {};
    let value = consumer.compare(item);
    print(value, "/", item.id);
    return 0;
}
