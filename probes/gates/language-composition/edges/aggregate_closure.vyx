use std.core;
@[c_repr]
struct Triple { public first: i64; public second: i64; public third: i64; }
fn main() -> i32 {
    var calls: i64 = 0;
    let bias: i64 = 7;
    let transform = [bias, &calls](value: Triple) => {
        calls += 1;
        return Triple { first: value.first + bias, second: value.second + bias, third: value.third + bias };
    };
    let output = transform(Triple { first: 4294967296, second: 2, third: 3 });
    print(output.first, "/", output.second, "/", output.third, "/", calls);
    return 0;
}
