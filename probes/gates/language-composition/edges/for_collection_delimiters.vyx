class Seed { public value: i64; }
class Holder { public values: [i64; 2]; }
fn make(seed: Seed) -> [i64; 2] { return [seed.value, seed.value + 1]; }
fn main() -> i32 {
    let holder = Holder { values: [2 as i64, 3 as i64] };
    var total: i64 = 0;
    for item in &holder.values { total += item; }
    for item in make(Seed { value: 7 }) { total += item; }
    for item in (make(Seed { value: 10 })) { total += item; }
    for item in [1 as i64, 2 as i64] { total += item; }
    for (item in make(Seed { value: 1 })) { total += item; }
    print(total);
    return 0;
}
