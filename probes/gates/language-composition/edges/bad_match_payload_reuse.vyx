use std.core;
use std.string;
class Token {
    public text: String;
    fn drop(&mut self) { self.text.drop(); }
}
fn main() -> i32 {
    let source = Option::<Token>.some(Token { text: String.from("owned match payload beyond inline capacity") });
    match (source) { Some(value) => { print(value.text.as_str()); } None => {} }
    match (source) { Some(value) => { print(value.text.as_str()); } None => {} }
    return 0;
}
