use std.core;
use std.collections;
use std.string;
use std.clone;

var drops: i64 = 0;
var clones: i64 = 0;
class Payload {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn payload(id: i64) -> Payload {
    return Payload { id: id, text: String.from("stack payload must retain independent heap storage") };
}
impl Clone for Payload {
    fn clone(&self) -> Payload {
        clones += 1;
        return Payload { id: self.id, text: self.text.clone() };
    }
}
fn main() -> i32 {
    {
        var values = Stack::<Payload>.new();
        var i: i64 = 0;
        while (i < 40) { values.push(payload(i)); i += 1; }
        if (drops != 0) { return 1; }
        { let top = values.peek(); if (top.id != 39) { return 2; } }
        if (drops != 1 || clones != 1) { return 3; }
        { let first = values.get(0); if (first.id != 0) { return 4; } }
        if (drops != 2 || clones != 2) { return 5; }
        if ((*values.get_ptr(0)).text.as_str() != "stack payload must retain independent heap storage") { return 6; }
        values.set(0, payload(100));
        if (drops != 3) { return 7; }
        {
            var copy = values.clone();
            if (drops != 3 || clones != 42) { return 8; }
            let top = copy.pop();
            if (top.id != 39) { return 9; }
        }
        if (drops != 43) { return 10; }
        { let top = values.pop(); if (top.id != 39) { return 11; } }
        if (drops != 44) { return 12; }
        values.clear();
        if (drops != 83 || !values.isEmpty()) { return 13; }
        values.push(payload(200));
        values.destroy();
        values.destroy();
        if (drops != 84) { return 14; }
    }
    {
        let items = [payload(300), payload(301)];
        {
            let values = Stack::<Payload>.from_array(to_rawptr(&items) as *Payload, 2);
            if ((*values.get_ptr(0)).id != 300 || clones != 44) { return 15; }
        }
        if (drops != 86 || items[0].text.as_str() != "stack payload must retain independent heap storage") { return 16; }
    }
    print(drops, "/", clones);
    return 0;
}
