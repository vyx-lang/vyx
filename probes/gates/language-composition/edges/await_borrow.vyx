use std.core;
use std.vio;

fn extract<T>(pending: &Task<T>) -> T { return await pending; }

fn main() -> i32 {
    let a = Task::<i32>.ready(11);
    let b = Promise::<i64>.ready(17);
    var c = Task::<i32>.ready(14);
    let first = extract::<i32>(&a);
    let second = await (&b);
    let third = await (&mut c);
    if (first != 11 || second != 17 || third != 14) { return 1; }
    if (!a.is_done() || !b.is_done() || !c.is_done()) { return 2; }
    print(first + second as i32 + third);
    return 0;
}
