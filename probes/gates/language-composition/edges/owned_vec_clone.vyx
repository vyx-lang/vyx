use std.core;
use std.string;
use std.collections;
var drops: i64 = 0;
var clones: i64 = 0;
var errors: i64 = 0;
class Item {
    public number: i64;
    public text: String;
    fn clone(&self) -> Item {
        clones += 1;
        return Item { number: self.number + 100, text: self.text.clone() };
    }
    fn drop(&mut self) {
        if (self.text.as_str() != "owned payload remains valid after cloned elements are released") { errors += 1; }
        drops += 1;
    }
    fn get(&self) -> i64 { return self.number; }
}
fn visit(mode: i32) -> i64 {
    var items = Vec::<Item>.new();
    for n in 1..4 {
        items.push(Item { number: n, text: String.from("owned payload remains valid after cloned elements are released") });
    }
    var total: i64 = 0;
    if (mode == 0) {
        for item in items { total += item.get(); }
    } else if (mode == 1) {
        for (item in &items) {
            if (item.get() == 102) { continue; }
            total += item.get();
            if (item.get() == 103) { break; }
        }
    } else {
        var iter = items.iter();
        for (item in &mut iter) { total += item.get(); }
    }
    if (drops != clones || items.get_ref(0).get() != 1) { errors += 1; }
    if (items.get_ref(0).text.as_str() != "owned payload remains valid after cloned elements are released") { errors += 1; }
    return total;
}
fn main() -> i32 {
    for mode in [0 as i32, 1 as i32, 2 as i32] {
        drops = 0; clones = 0; errors = 0;
        let total = visit(mode);
        print(total, "/", clones, "/", drops, "/", errors);
    }
    return 0;
}
