use std.core;
extern "C" { fn printf(format: rawptr, ...) -> i32; }
var order: i64 = 0;
fn mark(value: i32) -> i32 { order = order * 10 + value as i64; return value; }
fn format() -> rawptr { order = order * 10 + 3; return "%d/%d\n".c_str(); }
fn main() -> i32 {
    unsafe { printf(format: format(), mark(1), mark(2)); }
    print(order);
    order = 0;
    unsafe { printf(mark(1), format: format(), mark(2)); }
    print(order);
    return 0;
}
