use std.core;
use std.string;
var drops: i64 = 0;
var defers: i64 = 0;
var errors: i64 = 0;
class Tracked {
    public value: i64;
    public text: String;
    fn drop(&mut self) {
        if (self.text.as_str() != "owned iterator payload larger than inline storage") { errors += 1; }
        drops += 1;
    }
    fn get(&self) -> i64 { return self.value; }
}
class Cursor {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 3; }
    fn next() -> Option<Tracked> {
        if (self.pos >= 3) { return Option::<Tracked>.none(); }
        self.pos += 1;
        return Option::<Tracked>.some(Tracked { value: self.pos,
            text: String.from("owned iterator payload larger than inline storage") });
    }
}
fn visit(mode: i32) -> i64 {
    var total: i64 = 0;
    for item in (Cursor { pos: 0 }) {
        defer {
            if (item.text.as_str() != "owned iterator payload larger than inline storage") { errors += 1; }
            defers += 1;
        }
        if (mode == 2) { continue; }
        total += item.get();
        if (mode == 1) { break; }
        if (mode == 3 && total == 3) { return total; }
    }
    return total;
}
fn take_first() -> Option<Tracked> {
    for item in (Cursor { pos: 0 }) { return Option::<Tracked>.some(item); }
    return Option::<Tracked>.none();
}
fn consume(item: Tracked) -> i64 {
    // Value parameters follow the existing explicit cleanup convention;
    // rebinding into a local gives this consumer a lexical owner.
    let owner = item;
    return owner.get();
}
fn consume_all<C>(cursor: C) -> i64 {
    var total: i64 = 0;
    for item in cursor { total += consume(item); }
    return total;
}
fn consume_some() -> i64 {
    var total: i64 = 0;
    for item in (Cursor { pos: 0 }) {
        if (item.get() == 2) { total += consume(item); }
        else { total += item.get(); }
    }
    return total;
}
error CheckError { Rejected }
fn check(value: i64) -> Result<i64, CheckError> {
    if (value == 2) { fail CheckError.Rejected; }
    return value;
}
fn propagate() -> Result<i64, CheckError> {
    var total: i64 = 0;
    for item in (Cursor { pos: 0 }) {
        defer { defers += 1; }
        total += check(item.get())?;
    }
    return total;
}
fn main() -> i32 {
    for mode in [0 as i32, 1 as i32, 2 as i32, 3 as i32] {
        drops = 0; defers = 0; errors = 0;
        let total = visit(mode);
        print(total, "/", drops, "/", defers, "/", errors);
    }
    drops = 0; defers = 0; errors = 0;
    {
        let item = take_first().unwrap();
        print(item.get(), "/", drops, "/", errors);
    }
    print(drops, "/", errors);
    drops = 0; defers = 0; errors = 0;
    let result = propagate();
    let value = match result { case Ok(v) => v, case Err(_) => -7 as i64, };
    print(value, "/", drops, "/", defers, "/", errors);
    drops = 0; errors = 0;
    let consumed = consume_all(Cursor { pos: 0 });
    print(consumed, "/", drops, "/", errors);
    drops = 0; errors = 0;
    let partly_consumed = consume_some();
    print(partly_consumed, "/", drops, "/", errors);
    return 0;
}
