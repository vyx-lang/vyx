use std.core;
use std.string;
var clones: i64 = 0;
var drops: i64 = 0;
var errors: i64 = 0;
class Item {
    public number: i64;
    public text: String;
    fn clone(&self) -> Item {
        clones += 1;
        return Item { number: self.number + 100, text: self.text.clone() };
    }
    fn drop(&mut self) {
        if (self.text.as_str() != "fixed array payload must remain valid after cloned elements are released") { errors += 1; }
        drops += 1;
        self.text.drop();
    }
}
fn visit(mode: i32) -> i64 {
    let items = [
        Item { number: 1, text: String.from("fixed array payload must remain valid after cloned elements are released") },
        Item { number: 2, text: String.from("fixed array payload must remain valid after cloned elements are released") }
    ];
    var total: i64 = 0;
    if (mode == 0) {
        for item in items { total += item.number; }
    } else {
        for (item in &items) {
            total += item.number;
            if (mode == 1) { break; }
            continue;
        }
    }
    if (clones != drops || items[0].number != 1 || items[1].number != 2) { errors += 1; }
    return total;
}
fn main() -> i32 {
    for mode in [0 as i32, 1 as i32, 2 as i32] {
        clones = 0; drops = 0; errors = 0;
        let total = visit(mode);
        print(total, "/", clones, "/", drops, "/", errors);
    }
    return 0;
}
