use std.core;
use std.collections;
var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
fn consume(item: Token) -> i64 { return item.id; }
fn consume_return(item: Token) -> Token { return item; }
fn borrow(item: &Token) -> i64 { return item.id; }
fn consume_vec(items: Vec<Token>) -> i64 { return items.len; }
fn main() -> i32 {
    let value = consume(Token { id: 7 });
    print(value, "/", drops);
    let returned = consume_return(Token { id: 9 });
    print(returned.id, "/", drops);
    let borrowed = Token { id: 4 };
    print(borrow(borrowed), "/", drops);
    var items = Vec::<Token>.new();
    items.push(Token { id: 1 });
    items.push(Token { id: 2 });
    let count = consume_vec(items);
    print(count, "/", drops);
    return 0;
}
