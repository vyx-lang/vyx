use std.core;
use std.string;
fn consume(value: String) -> i64 { return value.len; }
fn main() -> i32 {
    let outer = String.from("an outer owner cannot be consumed repeatedly");
    var total: i64 = 0;
    for item in [1 as i64, 2 as i64] { total += consume(outer) + item; }
    print(total);
    return 0;
}
