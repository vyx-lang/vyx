use std.core;
use std.collections;
use std.string;
use std.clone;
use std.hash;

var made: i64 = 0;
var drops: i64 = 0;
var clones: i64 = 0;
class OwnedKey {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn key(id: i64) -> OwnedKey {
    made += 1;
    return OwnedKey { id: id, text: String.from("dictionary key with independent heap storage beyond inline capacity") };
}
impl Hashable for OwnedKey {
    fn hash(&self) -> i64 { return self.id; }
}
impl Eq for OwnedKey {
    @[borrow_args]
    fn operator_eq(&self, other: OwnedKey) -> bool { return self.id == other.id; }
}
impl Clone for OwnedKey {
    fn clone(&self) -> OwnedKey { clones += 1; return key(self.id); }
}
fn main() -> i32 {
    {
        var values = Dict::<OwnedKey, String>.new();
        let query = key(11);
        let slot = values.get_ptr(query);
        unsafe { *slot = String.from("dictionary value with independent heap storage beyond inline capacity"); }
        values.put(key(11), String.from("replacement value with independent heap storage beyond inline capacity"));
        print(made, "/", drops, "/", clones);
        {
            let copies = values.keys();
            print(copies.get_ref(0).id, "/", copies.get_ref(0).text.as_str());
        }
        print(made, "/", drops, "/", clones);
        print(values.remove(query));
        print(query.text.as_str());
        print(made, "/", drops, "/", clones);
    }
    print(made, "/", drops, "/", clones);
    return 0;
}
