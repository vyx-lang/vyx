use std.core;
use std.string;
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, count: i64) -> rawptr;
    fn memmove(dst: rawptr, src: rawptr, count: i64) -> rawptr;
}
var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn copy_bytes(slot: rawptr, item: Token, count: i64, moving: bool) -> i64 {
    unsafe {
        if (moving) {
            memmove(slot, to_rawptr(&item), count);
        } else {
            memcpy(count: count, src: to_rawptr(&item), dst: slot);
        }
    }
    // The source remains owned here, even when all its bytes were copied.
    if (item.text.as_str() != "byte copying never transfers this owned resource") { return 99; }
    return item.id;
}
fn main() -> i32 {
    let slot = malloc(sizeof::<Token>());
    var mode: i32 = 0;
    while (mode < 6) {
        var count: i64 = 0;
        if (mode % 3 == 1) { count = 1; }
        elif (mode % 3 == 2) { count = sizeof::<Token>(); }
        drops = 0;
        let id = copy_bytes(slot, Token {
            id: 7,
            text: String.from("byte copying never transfers this owned resource")
        }, count, mode >= 3);
        print(id, "/", drops);
        mode += 1;
    }
    // No T was constructed in slot; the copied representation is not an owner.
    free(slot);
    return 0;
}
