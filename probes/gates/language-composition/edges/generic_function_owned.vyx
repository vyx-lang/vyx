use std.core;
use std.string;
use std.collections;

var drops: i32 = 0;
class Parcel {
    public text: String;
    public fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn identity<T>(value: T) -> T { return value; }
fn dispose<T>(value: T) {}
fn apply<T>(f: fn(T) -> T, value: T) -> T { return f(value); }
fn add<T>(value: T) -> T { return value + 1; }

fn main() -> i32 {
    {
        let pass = identity::<Parcel>;
        let value = pass(Parcel { text: String.from("generic function value owns its returned payload") });
        if (drops != 0 || value.text.as_str() != "generic function value owns its returned payload") { return 1; }
    }
    if (drops != 1) { return 2; }
    {
        let value = apply::<Parcel>(identity::<Parcel>, Parcel { text: String.from("higher order owned argument") });
        if (drops != 1 || value.text.as_str() != "higher order owned argument") { return 3; }
    }
    if (drops != 2) { return 4; }
    let sink = dispose::<Parcel>;
    sink(Parcel { text: String.from("discarded callback argument must be destroyed") });
    if (drops != 3) { return 5; }
    var numbers = Vec::<i64>.new();
    numbers.push(10);
    numbers.push(20);
    let mapped = numbers.iter().map::<i64>(add::<i64>);
    if (mapped.next().unwrap() != 11 || mapped.next().unwrap() != 21) { return 6; }
    print(drops);
    return 0;
}
