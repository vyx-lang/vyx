interface App {
    fn id(&self) -> i32;
}

class AppBase : App {
    public n: i32;

    public fn id(&self) -> i32 {
        return self.n;
    }
}

class Profile : AppBase {
}

fn run(app: dyn App) -> i32 {
    return app.id();
}

fn main() -> i32 {
    let p = Profile { n: 1 };
    return run(p) - 1;
}
