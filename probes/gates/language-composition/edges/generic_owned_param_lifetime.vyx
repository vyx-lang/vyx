use std.core;
var drops: i64 = 0;
trait Readable { fn read(&self) -> i64; }
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
impl Readable for Token { fn read(&self) -> i64 { return self.id; } }
fn consume<T>(item: T) -> i64 where T: Readable { return item.read(); }
fn consume_return<T>(item: T) -> T { return item; }
fn main() -> i32 {
    let value = consume::<Token>(Token { id: 7 });
    print(value, "/", drops);
    let returned = consume_return::<Token>(Token { id: 9 });
    print(returned.id, "/", drops);
    return 0;
}
