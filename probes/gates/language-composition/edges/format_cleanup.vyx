use std.core;
use std.string;
use std.fmt;
class Label { public value: i64; }
impl Display for Label {
    fn display() -> str { return format("label=%lld", self.value); }
}
fn main() -> i32 {
    let text = str_dup("existing owner stays alive");
    print(text, "/", 42 as i64);
    print(text, "/", 7 as i64);
    str_drop(text);
    let owned = String.from("owned string remains alive");
    print(owned, "/", 9 as i64);
    print(Label { value: 11 });
    return 0;
}
