use std.core;
var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
fn write_value<T>(slot: rawptr, value: T) {
    unsafe { *(slot as *T) = value; }
}
fn store_copy(slot: rawptr, item: Token) {
    write_value(value: item, slot: slot);
}
fn store_move(slot: rawptr, item: Token) {
    write_value(slot: slot, value: item);
}
fn main() -> i32 {
    var storage: i64 = 0;
    store_copy(to_rawptr(&storage), Token { id: 7 });
    print(storage, "/", drops);
    { let recovered: Token = *((to_rawptr(&storage)) as *Token); }
    print(drops);
    store_move(to_rawptr(&storage), Token { id: 9 });
    print(storage, "/", drops);
    { let recovered: Token = *((to_rawptr(&storage)) as *Token); }
    print(drops);
    return 0;
}
