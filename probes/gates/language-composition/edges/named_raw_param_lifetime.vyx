use std.core;
extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, count: i64) -> rawptr;
    fn memmove(dst: rawptr, src: rawptr, count: i64) -> rawptr;
}
var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
fn store_copy(slot: rawptr, item: Token) {
    memcpy(count: sizeof::<Token>(), src: to_rawptr(&item), dst: slot);
}
fn store_move(slot: rawptr, item: Token) {
    memmove(src: to_rawptr(&item), count: sizeof::<Token>(), dst: slot);
}
fn main() -> i32 {
    var storage: i64 = 0;
    store_copy(to_rawptr(&storage), Token { id: 7 });
    print(storage, "/", drops);
    { let recovered: Token = *((to_rawptr(&storage)) as *Token); }
    print(drops);
    store_move(to_rawptr(&storage), Token { id: 9 });
    print(storage, "/", drops);
    { let recovered: Token = *((to_rawptr(&storage)) as *Token); }
    print(drops);
    return 0;
}
