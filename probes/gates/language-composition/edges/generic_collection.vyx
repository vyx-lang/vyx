use std.core;
class Cursor<Tag, Item> {
    public first: Item;
    public second: Item;
    public position: i32;
    fn has_next() -> bool { return self.position < 2; }
    fn next() -> Option<Item> {
        if (self.position == 0) { self.position = 1; return Option::<Item>.some(self.first); }
        if (self.position == 1) { self.position = 2; return Option::<Item>.some(self.second); }
        return Option::<Item>.none();
    }
}
fn sum<Collection>(values: Collection) -> i64 {
    var result: i64 = 0;
    for value in values { result += value; }
    return result;
}
fn main() -> i32 {
    let values = Cursor::<u8, i64> {first: 4294967296, second: 4294967299, position: 0};
    print(sum(values));
    return 0;
}
