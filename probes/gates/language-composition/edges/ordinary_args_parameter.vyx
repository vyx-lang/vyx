use std.core;
fn select(args: i64, enabled: bool = true) -> i64 { return enabled ? args : -args; }
fn identity<T>(args: T) -> T { return args; }
class Receiver {
    fn select(&self, args: i64, enabled: bool) -> i64 { return enabled ? args : -args; }
}
fn main() -> i32 {
    print(select(args: 42));
    print(select(enabled: false, args: 7));
    print(identity(args: 9 as i64));
    let receiver = Receiver {};
    print(receiver.select(enabled: false, args: 11));
    return 0;
}
