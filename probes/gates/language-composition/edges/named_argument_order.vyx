use std.core;
var order: i64 = 0;
fn mark(value: i64) -> i64 { order = order * 10 + value; return value; }
fn encode(first: i64, second: i64) -> i64 { return first * 10 + second; }
class Receiver {
    public base: i64;
    fn encode(&self, first: i64, second: i64) -> i64 { return self.base + first * 10 + second; }
    fn update(&mut self, first: i64, second: i64) { self.base = first * 10 + second; }
}
fn make_receiver() -> Receiver { order = order * 10 + 3; return Receiver { base: 100 }; }
fn main() -> i32 {
    let value = encode(second: mark(2), first: mark(1));
    print(value, "/", order);
    order = 0;
    let method_value = make_receiver().encode(second: mark(2), first: mark(1));
    print(method_value, "/", order);
    order = 0;
    let pipe_value = mark(3) |> encode(second: mark(2));
    print(pipe_value, "/", order);
    order = 0;
    var receiver = Receiver { base: 100 };
    receiver.update(second: mark(2), first: mark(1));
    print(receiver.base, "/", order);
    return 0;
}
