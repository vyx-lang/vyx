use std.core;
interface Metric {
    fn score(&self, value: i32) -> i64;
    fn score(&self, value: f64) -> i64;
}
class Meter { public base: i64; }
impl Metric for Meter {
    fn score(&self, value: i32) -> i64 { return self.base + value as i64; }
    fn score(&self, value: f64) -> i64 { return self.base + (value * 10.0) as i64; }
}
fn evaluate(value: &dyn Metric) -> i64 {
    return value.score(3 as i32) * 100 + value.score(2.0);
}
fn main() -> i32 {
    let value = Meter { base: 5 };
    print(evaluate(&value));
    return 0;
}
