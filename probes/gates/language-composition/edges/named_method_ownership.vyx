use std.core;
use std.ref;

var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
class Consumer {
    fn compare(&self, item: Token) -> i64 { return item.id; }
    fn hash(&self, item: Token) -> i64 { return item.id; }
    fn operator_eq(&self, item: Token) -> bool { return item.id == 3; }
    @[borrow_args]
    fn inspect(&self, item: Token) -> i64 { return item.id; }
}
class Factory {
    static fn of(owner: Ref<i64>, item: Token) -> i64 { return item.id; }
}
fn main() -> i32 {
    let consumer = Consumer {};
    let first = consumer.compare(Token { id: 1 });
    print(first, "/", drops);
    let second = consumer.hash(Token { id: 2 });
    print(second, "/", drops);
    let third = consumer.operator_eq(Token { id: 3 });
    print(third, "/", drops);
    let owner = Ref::<i64>.new(11);
    let fourth = Factory.of(owner.clone(), Token { id: 4 });
    print(fourth, "/", drops);
    {
        let borrowed = Token { id: 5 };
        print(consumer.inspect(borrowed), "/", drops);
        print(borrowed.id, "/", drops);
    }
    print(drops);
    return 0;
}
