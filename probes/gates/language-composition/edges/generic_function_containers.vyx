use std.core;
use std.collections;

extern "C" { fn abs(value: i32) -> i32; }

fn identity<T>(value: T) -> T { return value; }
fn other<T>(value: T) -> T { return value + 1; }
fn optional<T>(value: T) -> Option<T> { return Option::<T>.some(value); }
fn invoke<T>(callback: fn(T) -> T, value: T) -> T { return callback(value); }

fn main() -> i32 {
    let callbacks = [identity::<i64>, other::<i64>];
    let first = callbacks[1];
    if (first(41) != 42) { return 1; }
    let pair = (identity::<i32>, identity::<i64>);
    let second = pair.1;
    if (second(4294967299) != 4294967299) { return 2; }
    let selected = if (true) { identity::<i64> } else { other::<i64> };
    if (selected(42) != 42) { return 3; }
    let wrapped = Option::<fn(i64) -> i64>.some(identity::<i64>);
    let unwrapped = wrapped.unwrap();
    if (unwrapped(42) != 42) { return 4; }
    let returning = Option::<fn(i64) -> Option<i64>>.some(optional::<i64>).unwrap();
    if (returning(42).unwrap() != 42) { return 5; }
    let higher = Option::<fn(fn(i64) -> i64, i64) -> i64>.some(invoke::<i64>).unwrap();
    if (higher(other::<i64>, 41) != 42) { return 6; }
    var sequence = Vec::<fn(i64) -> i64>.new();
    sequence.push(identity::<i64>);
    sequence.push(other::<i64>);
    let last = sequence.pop();
    let initial = sequence.pop();
    if (last(initial(41)) != 42) { return 7; }
    let c_callback = Option::<cfn(i32) -> i32>.some(abs).unwrap();
    unsafe { if (c_callback(-42) != 42) { return 8; } }
    print(42);
    return 0;
}
