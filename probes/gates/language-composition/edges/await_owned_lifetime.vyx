use std.core;
use std.string;
use std.vio;

var drops: i32 = 0;
class Parcel {
    public text: String;
    public fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn parcel(text: str) -> Parcel { return Parcel { text: String.from(text) }; }

fn main() -> i32 {
    {
        let pending = Task::<Parcel>.ready(parcel("taken"));
        let alias = pending.clone();
        if (drops != 0) { return 1; }
        {
            let value = await (&alias);
            if (value.text.as_str() != "taken" || drops != 0) { return 2; }
        }
        if (drops != 1 || !pending.poll()) { return 3; }
    }
    if (drops != 1) { return 4; }
    {
        let abandoned = Task::<Parcel>.ready(parcel("abandoned"));
        let alias = abandoned.clone();
        abandoned.drop();
        if (drops != 1) { return 5; }
    }
    if (drops != 2) { return 6; }
    {
        let pending = Promise::<Parcel>.ready(parcel("first"));
        pending.resolve(parcel("duplicate"));
        if (drops != 3) { return 7; }
        let value = await pending;
        if (value.text.as_str() != "first") { return 8; }
    }
    if (drops != 4) { return 9; }
    {
        let failed = Promise::<Parcel>.failed(9);
        failed.resolve(parcel("rejected"));
        if (drops != 5 || !failed.is_failed()) { return 10; }
    }
    if (drops != 5) { return 11; }
    {
        let pending = Task::<Parcel>.ready(parcel("temporary"));
        let length = (await pending).text.as_str().len;
        if (length != 9 || drops != 6) { return 13; }
    }
    await Task::<Parcel>.ready(parcel("ignored"));
    if (drops != 7) { return 14; }
    {
        let text = Task::<str>.ready(str_dup("unread text"));
    }
    {
        let pending = Promise::<str>.ready(str_dup("read text"));
        let text = await pending;
        if (text != "read text") { return 12; }
    }
    print(drops);
    return 0;
}
