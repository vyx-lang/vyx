use std.core;
var drops: i64 = 0;
var clones: i64 = 0;
class Token {
    public id: i64;
    fn clone(&self) -> Token { clones += 1; return Token { id: self.id + 10 }; }
    fn drop(&mut self) { drops += 1; }
}
fn visit() -> i64 {
    let items = [[Token { id: 1 }, Token { id: 2 }], [Token { id: 3 }, Token { id: 4 }]];
    var total: i64 = 0;
    for row in items { for (item in &row) { total += item.id; } }
    if (items[0][0].id != 1 || items[1][1].id != 4) { return -1; }
    return total;
}
fn main() -> i32 {
    let total = visit();
    print(total, "/", clones, "/", drops);
    let numbers = [[1 as i64, 2 as i64], [3 as i64, 4 as i64]];
    var sum: i64 = 0;
    for row in numbers { for number in row { sum += number; } }
    print(sum);
    return 0;
}
