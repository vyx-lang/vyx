use std.core;
var drops: i64 = 0;
var order: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; order = order * 10 + self.id; }
}
fn make() -> [Token; 2] { return [Token { id: 1 }, Token { id: 2 }]; }
fn nested() {
    let items = [[Token { id: 1 }, Token { id: 2 }], [Token { id: 3 }, Token { id: 4 }]];
}
fn moved() -> i64 {
    let original = make();
    let destination = original;
    return destination[0].id + destination[1].id;
}
fn early(flag: bool) -> i64 {
    let items = make();
    if (flag) { return 7; }
    return items[0].id;
}
fn rebound(items: [Token; 2]) -> i64 {
    let owner = items;
    return owner[0].id + owner[1].id;
}
fn reassigned() {
    var items = make();
    items = make();
}
fn conditional(flag: bool) {
    let items = if (flag) { make() } else { make() };
}
fn main() -> i32 {
    nested(); print(drops, "/", order);
    drops = 0; order = 0;
    let sum = moved(); print(sum, "/", drops, "/", order);
    drops = 0; order = 0;
    let first = early(true); print(first, "/", drops, "/", order);
    drops = 0; order = 0;
    let second = early(false); print(second, "/", drops, "/", order);
    drops = 0; order = 0;
    let argument = rebound(make()); print(argument, "/", drops, "/", order);
    drops = 0; order = 0;
    reassigned(); print(drops, "/", order);
    drops = 0; order = 0;
    conditional(true); print(drops, "/", order);
    drops = 0; order = 0;
    conditional(false); print(drops, "/", order);
    return 0;
}
