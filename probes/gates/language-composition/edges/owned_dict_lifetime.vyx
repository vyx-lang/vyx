use std.core;
use std.collections;
use std.string;
use std.clone;
use std.defaults;

var drops: i64 = 0;
var clones: i64 = 0;
class Payload {
    public id: i64;
    public text: String;
    fn drop(&mut self) {
        if (self.id >= 0) { drops += 1; }
        self.text.drop();
    }
}
fn payload(id: i64) -> Payload {
    return Payload { id: id, text: String.from("dictionary payload must own independent storage beyond the inline buffer") };
}
impl Default for Payload {
    static fn default_value() -> Payload {
        return Payload { id: -1, text: String.empty() };
    }
}
impl Clone for Payload {
    fn clone(&self) -> Payload {
        clones += 1;
        return Payload { id: self.id, text: self.text.clone() };
    }
}
fn main() -> i32 {
    {
        var values = Dict::<i64, Payload>.new();
        values.put(7, payload(1));
        values.put(7, payload(2));
        print(drops);
        {
            let copy = values.get(7);
            print(copy.id, "/", copy.text.as_str());
        }
        print(drops, "/", clones);
        {
            let found = values.try_get(7);
            match (found) {
                Some(copy) => { print(copy.id, "/", copy.text.as_str()); }
                None => { return 1; }
            }
        }
        print(drops, "/", clones);
        print(values.remove(7));
        print(drops);
        values.put(9, payload(3));
        {
            let copies = values.values_vec();
            print(copies.get_ref(0).id);
        }
        print(drops, "/", clones);
        values.clear();
        print(drops);
        values.put(11, payload(4));
    }
    print(drops, "/", clones);
    return 0;
}
