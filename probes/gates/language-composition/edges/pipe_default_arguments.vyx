use std.core;
var order: i64 = 0;
fn mark(value: i64) -> i64 { order = order * 10 + value; return value; }
fn encode(first: i64 = mark(7), second: i64 = mark(8)) -> i64 { return first * 10 + second; }
fn enabled(value: bool, amount: i64 = 9) -> i64 { return value ? amount : -amount; }
class Receiver {
    fn encode(&self, first: i64 = mark(7), second: i64 = mark(8)) -> i64 {
        return first * 10 + second;
    }
}
fn main() -> i32 {
    print(mark(3) |> encode(second: mark(2)));
    print(order);
    print(true |> enabled(6));
    print(false |> enabled());
    order = 0;
    print(mark(4) |> encode());
    print(order);
    order = 0;
    print(mark(2) |> encode(second: mark(3) |> encode(second: mark(4))));
    print(order);
    order = 0;
    let receiver = Receiver {};
    print(mark(3) |> receiver.encode(second: mark(2)));
    print(order);
    return 0;
}
