use std.core;
use std.string;
var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn choose(item: Token, select: bool) -> Token {
    return select ? item : Token { id: 9, text: String.from("replacement owns its string storage") };
}
fn exercise(select: bool) {
    drops = 0;
    {
        let selected = choose(Token { id: 7, text: String.from("selected parameter owns its string storage") }, select);
        if (select) { assert_eq(selected.text.as_str(), "selected parameter owns its string storage"); }
        else { assert_eq(selected.text.as_str(), "replacement owns its string storage"); }
        print(selected.id, "/", drops);
    }
    print(drops);
}
fn main() -> i32 {
    exercise(true);
    exercise(false);
    return 0;
}
