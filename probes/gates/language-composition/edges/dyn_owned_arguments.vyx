use std.core;
use std.string;
var calls: i64 = 0;
var drops: i64 = 0;
class Parcel {
    public value: i64;
    public text: String;
    public fn drop(&mut self) { drops += 1; self.text.drop(); }
}
interface Work {
    fn apply(&self, input: Parcel) -> Parcel;
    fn apply(&self, input: i64) -> i64;
}
class Machine { public bias: i64; }
impl Work for Machine {
    fn apply(&self, input: Parcel) -> Parcel {
        calls += 1;
        input.value += self.bias;
        return input;
    }
    fn apply(&self, input: i64) -> i64 { calls += 1; return self.bias + input; }
}
fn dispatch(machine: &dyn Work) -> i64 {
    let result = machine.apply(Parcel { value: 7, text: String.from("dynamic owned payload") });
    if (result.text.as_str() != "dynamic owned payload") { return -1000; }
    return result.value + machine.apply(5 as i64);
}
fn main() -> i32 {
    let machine = Machine { bias: 4 };
    let result = dispatch(&machine);
    print(result, "/", calls, "/", drops);
    return 0;
}
