use std.core;
use std.string;

var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn token(id: i64) -> Token {
    return Token { id: id, text: String.from("match payload owns real storage beyond the inline capacity") };
}
fn make(id: i64) -> Option<Token> { return Some(token(id)); }
enum Envelope {
    Present(Token),
    Empty,
    fn observe(&self) -> i64 {
        match (self) {
            Present(item) => { return item.id; }
            Empty => { return 0; }
        }
    }
}
fn forward() -> Token {
    match (make(2)) {
        Some(item) => { return item; }
        None => { return token(99); }
    }
}
fn main() -> i32 {
    match (make(1)) {
        Some(item) => { print(item.id, "/", item.text.as_str()); }
        None => { return 1; }
    }
    print(drops);
    {
        let item = forward();
        print(item.id, "/", drops);
    }
    print(drops);
    {
        let item = match make(3) {
            Some(value) => value,
            None => token(99),
        };
        print(item.id, "/", drops);
    }
    print(drops);
    let packet = Envelope.Present(token(4));
    print(packet.observe(), "/", drops);
    print(packet.observe(), "/", drops);
    match (packet) {
        Present(item) if false => { return 2; }
        Present(item) => { print(item.id, "/", drops); }
        Empty => { return 3; }
    }
    print(drops);
    return 0;
}
