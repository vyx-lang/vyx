interface Comp {
    fn id(&self) -> string;
}

class CompBase : Comp {
    public fn id(&self) -> string {
        return "ok";
    }
}

class Child : CompBase {
    public static fn create() -> Child {
        return Child {};
    }
}

class App {
    public static fn run(component: dyn Comp) -> string {
        return component.id();
    }

    public static fn run(components: i32) -> string {
        return "i32";
    }

    public static fn run(component: dyn Comp, extra: i32) -> string {
        return component.id();
    }
}

fn main() -> i32 {
    if (App.run(Child.create()) != "ok") { return 1; }
    return 0;
}
