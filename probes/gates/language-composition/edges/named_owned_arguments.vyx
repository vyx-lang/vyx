use std.core;
use std.string;
var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn consume(owner: Token, view: &Token) -> i64 {
    assert_eq(owner.text.as_str(), "owning argument keeps its full string payload");
    assert_eq(view.text.as_str(), "borrowed argument keeps its original string payload");
    return owner.id + view.id;
}
class Consumer {
    fn consume(&self, owner: Token, view: &Token) -> i64 { return owner.id + view.id; }
}
trait Identified { fn get(&self) -> i64; }
impl Identified for Token { fn get(&self) -> i64 { return self.id; } }
fn consume_generic<T>(owner: T, view: &T) -> i64 where T: Identified { return owner.get() + view.get(); }
fn main() -> i32 {
    let viewed = Token { id: 2, text: String.from("borrowed argument keeps its original string payload") };
    let owned = Token { id: 5, text: String.from("owning argument keeps its full string payload") };
    let value = consume(view: viewed, owner: owned);
    print(value, "/", drops, "/", viewed.id);
    assert_eq(viewed.text.as_str(), "borrowed argument keeps its original string payload");
    let consumer = Consumer {};
    let method_owned = Token { id: 5, text: String.from("method argument retains its owned string payload") };
    let method_value = consumer.consume(view: viewed, owner: method_owned);
    print(method_value, "/", drops, "/", viewed.id);
    let generic_owned = Token { id: 5, text: String.from("generic argument retains its owned string payload") };
    let generic_value = consume_generic(view: viewed, owner: generic_owned);
    print(generic_value, "/", drops, "/", viewed.id);
    assert_eq(viewed.text.as_str(), "borrowed argument keeps its original string payload");
    return 0;
}
