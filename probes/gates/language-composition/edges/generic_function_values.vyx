use std.core;

fn identity<T>(value: T) -> T { return value; }
fn invoke<T>(f: fn(T) -> T, value: T) -> T { return f(value); }
fn provider<T>() -> fn(T) -> T { return identity::<T>; }
class Triple { public a: i64; public b: i64; public c: i64; }

var hits: i32 = 0;
fn account<T>(context: rawptr) { hits += sizeof::<T>() as i32; }

fn main() -> i32 {
    let narrow = identity::<i32>;
    let wide = identity::<i64>;
    if (narrow(7) != 7 || wide(4294967299) != 4294967299) { return 1; }
    if (invoke::<i64>(identity::<i64>, 4294967301) != 4294967301) { return 2; }
    let returned = provider::<i64>();
    if (returned(4294967303) != 4294967303) { return 3; }
    let aggregate = identity::<Triple>;
    let value = aggregate(Triple { a: 4294967299, b: -7, c: 11 });
    if (value.a != 4294967299 || value.b != -7 || value.c != 11) { return 4; }
    let callback = account::<i64>;
    let address = callback as rawptr;
    let callable = address as fn(rawptr) -> void;
    callable(null);
    if (hits != 8) { return 5; }
    print(42);
    return 0;
}
