use std.core;
use std.collections;
use std.string;
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, count: i64) -> rawptr;
}
fn copy_bytes(slot: rawptr, text: str, count: i64) {
    unsafe { memcpy(slot, to_rawptr(&text), count); }
}
fn maybe_store(slot: rawptr, text: str, enabled: bool) {
    if (enabled) { unsafe { *(slot as *str) = text; } }
}
fn store_deferred(slot: rawptr, text: str, enabled: bool) {
    defer { if (enabled) { unsafe { *(slot as *str) = text; } } }
}
fn store_matched(slot: rawptr, text: str, enabled: bool) {
    match (enabled) {
        true => { unsafe { *(slot as *str) = text; } }
        false => {}
    }
}
fn store_for(slot: rawptr, text: str, enabled: bool) {
    for (var i: i32 = 0; enabled && i < 1; i += 1) {
        unsafe { *(slot as *str) = text; }
        break;
    }
}
fn exercise(enabled: bool, mode: i32) {
    let slot = malloc(sizeof::<str>());
    var source = Vec::<str>.new();
    source.push("alpha tagged storage remains valid");
    source.push("bravo tagged storage remains valid");
    for text in source {
        if (mode == 0) { maybe_store(slot, text, enabled); }
        elif (mode == 1) { store_deferred(slot, text, enabled); }
        elif (mode == 2) { store_matched(slot, text, enabled); }
        else { store_for(slot, text, enabled); }
        if (enabled) {
            let saved = *(slot as *str);
            print(saved);
            str_drop(saved);
        }
    }
    // These copies leave each independently cloned iteration value owned by
    // its caller; both empty and complete byte copies must retain cleanup.
    var count: i64 = 0;
    for text in source {
        copy_bytes(slot, text, count);
        count = sizeof::<str>();
    }
    free(slot);
}
fn main() -> i32 {
    var mode: i32 = 0;
    while (mode < 4) {
        exercise(false, mode);
        exercise(true, mode);
        mode += 1;
    }
    return 0;
}
