use std.core;
use std.collections;
var drops: i64 = 0;
class MoveOnly {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
fn main() -> i32 {
    {
        var stack = Stack::<MoveOnly>.new();
        stack.push(MoveOnly { id: 1 });
        stack.push(MoveOnly { id: 2 });
        { let last = stack.pop(); if (last.id != 2) { return 1; } }
        if (drops != 1) { return 2; }
        stack.clear();
        if (drops != 2) { return 3; }
        stack.push(MoveOnly { id: 3 });
    }
    {
        var queue = Queue::<MoveOnly>.new();
        queue.enqueue(MoveOnly { id: 4 });
        queue.enqueue(MoveOnly { id: 5 });
        { let first = queue.dequeue(); if (first.id != 4) { return 4; } }
        if (drops != 4) { return 5; }
        queue.clear();
        if (drops != 5) { return 6; }
        queue.enqueue(MoveOnly { id: 6 });
    }
    print(drops);
    return 0;
}
