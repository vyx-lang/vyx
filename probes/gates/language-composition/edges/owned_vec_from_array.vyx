use std.core;
use std.collections;
use std.string;
use std.clone;
var drops: i64 = 0;
var clones: i64 = 0;
class Payload {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
impl Clone for Payload {
    fn clone(&self) -> Payload {
        clones += 1;
        return Payload { id: self.id, text: self.text.clone() };
    }
}
fn main() -> i32 {
    {
        let items = [
            Payload { id: 1, text: String.from("raw array source must retain independent heap storage") },
            Payload { id: 2, text: String.from("raw array source must retain independent heap storage") }
        ];
        {
            let copies = Vec::<Payload>.from_array(to_rawptr(&items) as *Payload, 2);
            if (copies.get_ref(0).id != 1 || copies.get_ref(1).id != 2 || clones != 2) { return 1; }
        }
        if (drops != 2 || items[1].text.as_str() != "raw array source must retain independent heap storage") { return 2; }
    }
    print(drops, "/", clones);
    return 0;
}
