use std.core;
class Answer { public value: i64; public extra: i64; public last: i64; }
interface Metric {
    fn score(&self, value: i32) -> i64;
    fn score(&self, value: f64) -> Answer;
}
class Meter<T> { public base: i64; public tag: T; }
impl<T> Metric for Meter<T> {
    fn score(&self, value: i32) -> i64 { return self.base + value as i64; }
    fn score(&self, value: f64) -> Answer {
        return Answer { value: self.base + (value * 10.0) as i64, extra: 3, last: 4 };
    }
}
fn evaluate(value: &dyn Metric) -> i64 {
    let first = value.score(3 as i32);
    let second = value.score(2.0);
    return first * 100 + second.value + second.extra + second.last;
}
fn main() -> i32 {
    let value = Meter::<i32> { base: 5, tag: 1 };
    print(evaluate(&value));
    return 0;
}
