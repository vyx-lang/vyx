use std.core;
var order: i64 = 0;
fn mark(value: i64) -> i64 { order = order * 10 + value; return value; }
fn total<...Ts>(enabled: bool, ...args: Ts) -> i64 {
    var result: i64 = 0;
    for item in args { result += item as i64; }
    return enabled ? result : -result;
}
fn show<...Ts>(label: str, ...args: Ts) {
    print(label, ":", args[0], "/", args[1]);
}
fn main() -> i32 {
    print(total(enabled: true, mark(1), mark(2)));
    print(order);
    show(17, label: "mixed", "payload");
    show(label: "front", 19, "tail");
    order = 0;
    print(total(mark(1), enabled: false, mark(2)));
    print(order);
    return 0;
}
