use std.core;

fn choose<T>(value: T) -> i64 { return 11; }
fn choose<T, U>(value: T, second: U) -> i64 { return 31; }
fn one_factory<T>() -> fn(T) -> i64 { return choose::<T>; }
fn two_factory<T, U>() -> fn(T, U) -> i64 { return choose::<T, U>; }

fn main() -> i32 {
    let one = choose::<i32>;
    let two = choose::<i32, i64>;
    if (one(9) + two(9, 4294967299) != 42) { return 1; }
    let first = one_factory::<i32>();
    let second = two_factory::<i32, i64>();
    if (first(3) + second(4, 4294967299) != 42) { return 2; }
    print(42);
    return 0;
}
