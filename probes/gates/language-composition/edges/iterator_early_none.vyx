use std.core;
var calls: i64 = 0;
var drops: i64 = 0;
class Item { public value: i64; fn drop(&mut self) { drops += 1; } }
class Cursor {
    public pos: i64;
    fn has_next() -> bool { return true; }
    fn next() -> Option<Item> {
        calls += 1;
        if (self.pos != 0) { return Option::<Item>.none(); }
        self.pos = 1;
        return Option::<Item>.some(Item { value: 42 });
    }
}
fn main() -> i32 {
    var sum: i64 = 0;
    for item in (Cursor { pos: 0 }) { sum += item.value; }
    print(sum, "/", drops, "/", calls);
    return 0;
}
