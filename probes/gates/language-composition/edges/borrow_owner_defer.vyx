use std.core;
var drops: i64 = 0;
var defers: i64 = 0;
var seen: i64 = 0;
class Tracked {
    public value: i64;
    fn drop(&mut self) { self.value = 99; drops += 1; }
    fn get(&self) -> i64 { return self.value; }
}
error CheckError { Rejected }
fn checked(item: &Tracked) -> Result<i64, CheckError> {
    if (item.get() < 0) { fail CheckError.Rejected; }
    return item.get() + 1;
}
fn forward(x: i64) -> Result<i64, CheckError> {
    let view = &Tracked { value: x };
    defer { seen = view.get(); defers += 1; }
    let item = checked(view)?;
    return item + 2;
}
fn main() -> i32 {
    for x in [-7 as i64, 0 as i64, 13 as i64] {
        drops = 0; defers = 0; seen = 123;
        let r = forward(x);
        let n = match r { case Ok(v) => v, case Err(_) => -7 as i64, };
        print(n, "/", drops, "/", defers, "/", seen);
    }
    return 0;
}
