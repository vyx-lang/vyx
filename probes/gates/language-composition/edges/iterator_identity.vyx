use std.core;
class Iterator<T> {
    public data: rawptr;
    public len: i64;
    public pos: i64;
    fn has_next() -> bool { return self.pos < self.len; }
    fn next() -> Option<i64> {
        if (self.pos >= self.len) { return Option::<i64>.none(); }
        self.pos += 1;
        return Option::<i64>.some(1000 + self.pos);
    }
}
fn main() -> i32 {
    var sum: i64 = 0;
    for value in (Iterator::<u8> { data: null, len: 2, pos: 0 }) { sum += value; }
    print(sum);
    return 0;
}
