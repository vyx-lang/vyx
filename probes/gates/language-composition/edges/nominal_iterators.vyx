use std.core;
var calls: i64 = 0;
class First {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 2; }
    fn next() -> Option<i64> {
        self.pos += 1; calls += 1;
        return Option::<i64>.some(self.pos + 100);
    }
}
class Second {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 2; }
    fn next() -> Option<i64> {
        self.pos += 1; calls += 10;
        return Option::<i64>.some(self.pos + 1000);
    }
}
fn sum<T>(values: T) -> i64 {
    var total: i64 = 0;
    for item in values { total += item; }
    return total;
}
fn main() -> i32 {
    let first = sum(First { pos: 0 });
    let second = sum(Second { pos: 0 });
    print(first, "/", second, "/", calls);
    return 0;
}
