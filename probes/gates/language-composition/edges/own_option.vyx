use std.core;
use std.string;
public var drops:i64=0;
public var defers:i64=0;
public class Tracked { public value:i64; public fn drop(&mut self){ drops+=1; } public fn get(&self)->i64{return self.value;} }
public error CheckError { Rejected }
fn create(x:i64)->Option<Tracked>{ if(x<0){return Option::<Tracked>.none();} return Option::<Tracked>.some(Tracked{value:x+1}); }
fn forward(x:i64)->Option<i64>{ let guard=Tracked{value:x}; defer {defers+=1;} let item=create(x)?; return Option::<i64>.some(item.get()+2); }
fn main()->i32{ for x in [-7 as i64,0 as i64,13 as i64] { drops=0;defers=0;let r=forward(x);let n=match r {case Some(v)=>v,default=>-5 as i64,}; print(n,"/",drops,"/",defers); }return 0; }
