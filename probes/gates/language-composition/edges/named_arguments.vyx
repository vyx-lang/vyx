use std.core;
fn select(value: i64, enabled: bool) -> i64 { return enabled ? value : -value; }
fn defaults(value: i64 = 7, enabled: bool = true) -> i64 { return select(value, enabled); }
fn overloaded(value: i64, enabled: bool) -> i64 { return select(value, enabled); }
fn overloaded(value: bool, enabled: i64) -> i64 { return value ? enabled + 100 : enabled; }
fn first<T, U>(value: T, other: U) -> T { return value; }
class Consumer {
    fn select(&self, value: i64, enabled: bool) -> i64 { return enabled ? value + 1 : -value; }
}
fn main() -> i32 {
    print(select(enabled: true, value: 42));
    print(defaults(enabled: false));
    print(overloaded(enabled: true, value: 9 as i64));
    print(first(other: false, value: 13 as i64));
    print(select(6 as i64, enabled: false));
    print(select(enabled: true, 8 as i64));
    let consumer = Consumer {};
    print(consumer.select(enabled: true, value: 20));
    return 0;
}
