use std.core;
use std.string;
var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn take(args: Token) -> i64 { return args.id + args.text.len; }
fn borrow(args: &Token) -> i64 { return args.id + args.text.len; }
fn pipe_take(value: Token, enabled: bool = true) -> i64 { return value.id + value.text.len; }
fn pipe_borrow(value: &Token, enabled: bool = true) -> i64 { return value.id; }
fn main() -> i32 {
    let item = Token { id: 7, text: String.from("payload") };
    print(take(args: item), "/", drops);
    let other = Token { id: 9, text: String.from("second owned payload larger than inline storage") };
    print(borrow(args: &other), "/", drops);
    print(other.id);
    let third = Token { id: 11, text: String.from("third") };
    print(third |> pipe_take(), "/", drops);
    print(&other |> pipe_borrow(), "/", drops);
    print(other.id);
    return 0;
}
