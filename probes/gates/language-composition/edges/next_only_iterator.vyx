use std.core;
var calls: i64 = 0;
class Decoy {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 2; }
}
class Cursor {
    public pos: i64;
    fn next() -> Option<i64> {
        calls += 1;
        if (self.pos == 2) { return Option::<i64>.none(); }
        self.pos += 1;
        return Option::<i64>.some(4294967296 + self.pos);
    }
}
fn main() -> i32 {
    let decoy = Decoy { pos: 0 };
    if (!decoy.has_next()) { return 1; }
    var sum: i64 = 0;
    for value in (Cursor { pos: 0 }) { sum += value; }
    print(sum, "/", calls);
    return 0;
}
