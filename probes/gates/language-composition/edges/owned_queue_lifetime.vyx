use std.core;
use std.collections;
use std.string;
use std.clone;

var drops: i64 = 0;
var clones: i64 = 0;
class Payload {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn payload(id: i64) -> Payload {
    return Payload { id: id, text: String.from("queue payload must retain independent heap storage") };
}
impl Clone for Payload {
    fn clone(&self) -> Payload {
        clones += 1;
        return Payload { id: self.id, text: self.text.clone() };
    }
}
fn main() -> i32 {
    {
        var values = Queue::<Payload>.new();
        var i: i64 = 0;
        while (i < 12) { values.enqueue(payload(i)); i += 1; }
        if (drops != 0) { return 1; }
        i = 0;
        while (i < 8) {
            let item = values.dequeue();
            if (item.id != i) { return 2; }
            i += 1;
        }
        if (drops != 8) { return 3; }
        i = 12;
        // Wrap the ring, then grow it while the head is nonzero.
        while (i < 40) { values.enqueue(payload(i)); i += 1; }
        if (drops != 8 || values.len() != 32) { return 4; }
        { let first = values.peek(); if (first.id != 8) { return 5; } }
        { let last = values.get(31); if (last.id != 39) { return 6; } }
        if (drops != 10 || clones != 2) { return 7; }
        values.set(0, payload(100));
        if (drops != 11) { return 8; }
        {
            var copy = values.clone();
            if (drops != 11 || clones != 34 || copy.len() != 32) { return 9; }
            let first = copy.dequeue();
            if (first.id != 100) { return 10; }
        }
        if (drops != 43 || (*values.get_ptr(0)).text.as_str() != "queue payload must retain independent heap storage") { return 11; }
        values.clear();
        if (drops != 75 || !values.isEmpty()) { return 12; }
        values.enqueue(payload(200));
        values.destroy();
        values.destroy();
        if (drops != 76) { return 13; }
    }
    {
        let items = [payload(300), payload(301)];
        {
            let values = Queue::<Payload>.from_array(to_rawptr(&items) as *Payload, 2);
            if ((*values.get_ptr(0)).id != 300 || clones != 36) { return 14; }
        }
        if (drops != 78 || items[0].text.as_str() != "queue payload must retain independent heap storage") { return 15; }
    }
    print(drops, "/", clones);
    return 0;
}
