use std.core;
use std.string;
public var drops:i64=0;
public var defers:i64=0;
public class Tracked { public value:i64; public fn drop(&mut self){ drops+=1; } public fn get(&self)->i64{return self.value;} }
public error CheckError { Rejected }
fn observe(item:&Tracked)->Result<i64,CheckError>{if(item.get()<0){fail CheckError.Rejected;}return item.get()+1;}
fn forward(x:i64)->Result<i64,CheckError>{defer{defers+=1;}let item=observe(&Tracked{value:x})?;return item+2;}
fn main()->i32{for x in [-7 as i64,0 as i64,13 as i64]{drops=0;defers=0;let r=forward(x);let n=match r{case Ok(v)=>v,case Err(_)=>-7 as i64,};print(n,"/",drops,"/",defers);}return 0;}
