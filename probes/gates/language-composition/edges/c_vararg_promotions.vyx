use std.core;
extern "C" { fn printf(format: rawptr, ...) -> i32; }
fn main() -> i32 {
    let negative: i8 = -7;
    let fraction: f32 = 1.5;
    let enabled: bool = true;
    unsafe { printf("%d/%.1f/%d\n".c_str(), negative, fraction, enabled); }
    let byte: u8 = 250;
    let signed_short: i16 = -30000;
    let unsigned_short: u16 = 65000;
    unsafe {
        printf(format: "%d/%d/%d/%d/%.1f/%d\n".c_str(), negative,
            byte, signed_short, unsigned_short, fraction, enabled);
    }
    return 0;
}
