use std.core;
class Tracked { public value: i64; fn drop(&mut self) {} }
class Cursor {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 2; }
    fn next() -> Option<Tracked> {
        self.pos += 1;
        return Option::<Tracked>.some(Tracked { value: self.pos });
    }
}
fn consume(item: Tracked) -> i64 { return item.value; }
fn main() -> i32 {
    for item in (Cursor { pos: 0 }) { print(consume(item)); print(item.value); }
    return 0;
}
