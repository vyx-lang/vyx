use std.core;
use std.string;
use std.collections;
fn main() -> i32 {
    var values = Vec::<String>.new();
    values.push(String.from("owned vector element larger than inline storage"));
    for item in values { print(item.as_str()); }
    for (item in &values) { print(item.as_str()); }
    for (item in &mut values) { print(item.as_str()); }
    let iter = values.iter();
    for item in iter { print(item.as_str()); }
    print(values.get_ref(0).as_str());
    return 0;
}
