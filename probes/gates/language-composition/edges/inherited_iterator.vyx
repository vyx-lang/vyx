use std.core;
class BaseCursor {
    public pos: i64;
    fn has_next() -> bool { return self.pos < 2; }
    fn next() -> Option<i64> {
        if (self.pos >= 2) { return Option::<i64>.none(); }
        self.pos += 1;
        return Option::<i64>.some(self.pos);
    }
}
class Cursor: BaseCursor { public extra: i64; }
class MiddleCursor: BaseCursor { public middle: i64; }
class LeafCursor: MiddleCursor { public extra: i64; }
fn sum_generic<T>(cursor: T) -> i64 {
    var sum: i64 = 0;
    for value in cursor { sum += value; }
    return sum;
}
fn main() -> i32 {
    var sum: i64 = 0;
    let cursor = Cursor { pos: 0, extra: 9 };
    while (cursor.has_next()) { sum += cursor.next().unwrap(); }
    print(sum);
    let inherited = Cursor { pos: 0, extra: 17 };
    var inherited_sum: i64 = 0;
    for item in inherited { inherited_sum += item; }
    print(inherited_sum);
    let leaf = LeafCursor { pos: 0, middle: 5, extra: 17 };
    print(sum_generic(leaf));
    return 0;
}
