use std.core;
use std.collections;
var clones: i64 = 0;
@[c_repr]
struct Record {
    public first: i64;
    public second: i64;
    public third: i64;
}
impl Record {
    fn clone(&self) -> Record {
        clones += 1;
        return Record { first: self.first + 7, second: self.second, third: self.third };
    }
}
fn main() -> i32 {
    var items = Vec::<Record>.new();
    items.push(Record { first: 4294967296, second: 2, third: 3 });
    items.push(Record { first: 4294967297, second: 5, third: 6 });
    var sum: i64 = 0;
    for item in items { sum += item.first; }
    print(sum, "/", clones);
    return 0;
}
