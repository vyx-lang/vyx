use std.core;
error CheckError { Rejected }
fn checked(x: i64) -> Result<i64, CheckError> {
    if (x < 0) { fail CheckError.Rejected; }
    return x;
}
fn main() -> i32 {
    let calc = [](x: i64) => {
        while (true) { return x + 7; }
    };
    print(calc(4294967296));
    let forward = [](x: i64) => {
        while (true) {
            let value = checked(x)?;
            return Result::<i64, CheckError>.ok(value + 7);
        }
    };
    for x in [-1 as i64, 4294967296 as i64] {
        let result = forward(x);
        let value = match result { case Ok(v) => v, case Err(_) => -7 as i64, };
        print(value);
    }
    return 0;
}
