use std.core;
error CheckError { Rejected }
fn checked(x: i64) -> Result<i64, CheckError> {
    if (x < 0) { fail CheckError.Rejected; }
    return x + 1;
}
fn main() -> i32 {
    let calc = [](x: i64) => {
        let value = checked(x)?;
        return Result::<i64, CheckError>.ok(value + 2);
    };
    for x in [-7 as i64, 0 as i64, 13 as i64] {
        let result = calc(x);
        let value = match result { case Ok(v) => v, case Err(_) => -7 as i64, };
        print(value);
    }
    return 0;
}
