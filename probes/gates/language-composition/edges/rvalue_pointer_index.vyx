use std.core;
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
}
var order: i64 = 0;
var drops: i64 = 0;
class Token {
    public id: i64;
    fn drop(&mut self) { drops += 1; }
}
fn base(slot: rawptr) -> *i64 { order = order * 10 + 1; return slot as *i64; }
fn index() -> i64 { order = order * 10 + 2; return 0; }
fn value() -> i64 { order = order * 10 + 3; return 4294967303; }
fn store<T>(slot: rawptr, item: T) {
    unsafe { (slot as *T)[0] = item; }
}
fn main() -> i32 {
    let slot = malloc(32);
    unsafe { base(slot)[index()] = value(); }
    print(*(slot as *i64), "/", order);
    unsafe { ((slot + 8) as *i64)[0] = 4294967311; }
    print(((slot + 8) as *i64)[0]);
    store(slot, Token { id: 9 });
    print(drops);
    { let recovered: Token = *(slot as *Token); print(recovered.id); }
    print(drops);
    free(slot);
    return 0;
}
