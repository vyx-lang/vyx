use std.core;
use std.collections;
use std.string;
use std.clone;
// Primitive str keeps explicit cleanup at this API boundary. Unlike String,
// arbitrary str-returning calls do not establish a lexical owner today.
fn show_and_drop(value: str) { print(value); str_drop(value); }
fn main() -> i32 {
    {
        var values = Stack::<str>.new();
        values.push("stack text owns tagged heap storage".clone());
        show_and_drop(values.peek());
        { let copy = values.clone(); show_and_drop(copy.get(0)); }
        values.set(0, "replacement stack text".clone());
        show_and_drop(values.pop());
        values.push("stack clear must release this storage".clone());
        values.clear();
        values.push("stack destructor must release this storage".clone());
    }
    {
        var values = Queue::<str>.new();
        values.enqueue("queue text owns tagged heap storage".clone());
        show_and_drop(values.peek());
        { let copy = values.clone(); show_and_drop(copy.get(0)); }
        values.set(0, "replacement queue text".clone());
        show_and_drop(values.dequeue());
        values.enqueue("queue clear must release this storage".clone());
        values.clear();
        values.enqueue("queue destructor must release this storage".clone());
    }
    return 0;
}
