use std.core;
use std.string;
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
}
var drops: i64 = 0;
class Token {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn maybe_store(slot: rawptr, item: Token, store: bool) {
    if (store) {
        unsafe { *(slot as *Token) = item; }
    }
}
fn store_after_return(slot: rawptr, item: Token, store: bool) {
    if (!store) { return; }
    unsafe { *(slot as *Token) = item; }
}
fn store_in_loop(slot: rawptr, item: Token, store: bool) {
    while (store) {
        unsafe { *(slot as *Token) = item; }
        break;
    }
}
fn store_in_defer(slot: rawptr, item: Token, store: bool) {
    defer {
        if (store) { unsafe { *(slot as *Token) = item; } }
    }
}
fn write_token(slot: rawptr, item: Token) -> bool {
    unsafe { *(slot as *Token) = item; }
    return true;
}
fn store_short_circuit(slot: rawptr, item: Token, store: bool) -> bool {
    return store && write_token(slot, item);
}
fn exercise(mode: i32, store: bool) -> i64 {
    drops = 0;
    let slot = malloc(sizeof::<Token>());
    let item = Token { id: 7, text: String.from("raw storage retains the complete owned payload") };
    if (mode == 0) { maybe_store(slot, item, store); }
    elif (mode == 1) { store_after_return(slot, item, store); }
    elif (mode == 2) { store_in_loop(slot, item, store); }
    elif (mode == 3) { store_in_defer(slot, item, store); }
    else { let written = store_short_circuit(slot, item, store); }
    let before = drops;
    if (store) {
        let recovered: Token = *(slot as *Token);
        if (recovered.id != 7 || recovered.text.as_str() != "raw storage retains the complete owned payload") { return 99; }
    }
    free(slot);
    return before * 10 + drops;
}
fn main() -> i32 {
    var mode: i32 = 0;
    while (mode < 5) {
        print(exercise(mode, false), "/", exercise(mode, true));
        mode += 1;
    }
    return 0;
}
