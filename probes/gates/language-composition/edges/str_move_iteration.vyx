use std.core;
use std.collections;
fn main() -> i32 {
    var copies = Vec::<str>.new();
    {
        var source = Vec::<str>.new();
        source.push("alpha survives its source vector");
        source.push("bravo survives its source vector");
        for item in source { copies.push(item); }
    }
    for item in copies { print(item); }
    let view = copies.get_ref(0);
    print(*view);
    return 0;
}
