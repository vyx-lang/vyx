module BoxAbiConsumer;

use BoxAbi;
use BoxFactory;
use std.collections;

class ConsumerHandler : Handler {
    public command: string;
    public caption: string;
    public detail: string;
    public amount: i32;

    public fn matches(&self, action: Action) -> bool {
        return action.name == self.command;
    }

    public fn execute(&self, action: Action, world: World) -> World {
        if (self.detail != "exe payload") { return world.add(-1000); }
        return world.add(self.amount);
    }

    public fn dup(&self) -> Box<dyn Handler> {
        return Box::<dyn Handler>.new(ConsumerHandler {
            command: self.command.clone(), caption: self.caption.clone(),
            detail: self.detail.clone(), amount: self.amount
        });
    }

    public fn label(&self) -> string { return self.caption; }
}

fn main() -> i32 {
    // EXE-created object: the DLL calls its vtable and stores the cloned Box.
    var original = World.create();
    original = original.register(Box::<dyn Handler>.new(ConsumerHandler {
        command: "increment", caption: "EXE handler", detail: "exe payload", amount: 9
    }));
    var cloned = duplicateWorld(&original);
    original.destroy();
    if (cloned.firstLabel() != "EXE handler") { return 1; }
    cloned = applyWorld(cloned, Action.create("ignored"));
    if (cloned.counter != 0) { return 2; }
    cloned = applyWorld(cloned, Action.create("increment"));
    if (cloned.counter != 9) { return 3; }
    cloned.destroy();

    // DLL-created object: EXE dispatches and clones it, then releases its
    // original handle before exercising every method on the clone.
    var native = createNativeHandler();
    let native_clone = native.deref().dup();
    native.drop();
    if (native_clone.deref().label() != "DLL handler") { return 4; }
    if (!native_clone.deref().matches(Action.create("native"))) { return 5; }
    var result = native_clone.deref().execute(Action.create("native"), World.create());
    if (result.counter != 17) { return 6; }
    result.destroy();
    native_clone.drop();
    print("box_dll: OK");
    return 0;
}
