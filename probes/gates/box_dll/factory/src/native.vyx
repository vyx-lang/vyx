module BoxFactory;

use BoxAbi;
use std.collections;

class NativeHandler : Handler {
    public command: string;
    public caption: string;
    public detail: string;
    public amount: i32;

    public fn matches(&self, action: Action) -> bool {
        return action.name == self.command;
    }

    public fn execute(&self, action: Action, world: World) -> World {
        if (self.detail != "dll payload") { return world.add(-1000); }
        return world.add(self.amount);
    }

    public fn dup(&self) -> Box<dyn Handler> {
        return Box::<dyn Handler>.new(NativeHandler {
            command: self.command.clone(), caption: self.caption.clone(),
            detail: self.detail.clone(), amount: self.amount
        });
    }

    public fn label(&self) -> string { return self.caption; }
}

public fn createNativeHandler() -> Box<dyn Handler> {
    return Box::<dyn Handler>.new(NativeHandler {
        command: "native", caption: "DLL handler", detail: "dll payload", amount: 17
    });
}
