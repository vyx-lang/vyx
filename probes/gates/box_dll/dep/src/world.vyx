module BoxAbi;

use std.collections;

public class World {
    public counter: i32;
    public handlers: Vec<Box<dyn Handler>>;

    public static fn create() -> World {
        return World { counter: 0, handlers: Vec::<Box<dyn Handler>>::new() };
    }

    public fn add(mut self, amount: i32) -> World {
        self.counter = self.counter + amount;
        return self;
    }

    public fn register(mut self, handler: Box<dyn Handler>) -> World {
        self.handlers.push(handler);
        return self;
    }

    public fn firstLabel(&self) -> string {
        return self.handlers.get(0).deref().label();
    }

    public fn destroy(&mut self) {
        var i: i64 = 0;
        while (i < self.handlers.len) {
            self.handlers.get(i).drop();
            i = i + 1;
        }
        self.handlers.destroy();
    }
}
