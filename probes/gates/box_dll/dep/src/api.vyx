module BoxAbi;

use std.collections;

public class Action {
    public name: string;
    public static fn create(name: string) -> Action {
        return Action { name: name };
    }
}

// Deliberately not lexicographic: caller and object producer must agree
// despite different local declarations and codegen unit boundaries.
public interface Handler {
    fn label(&self) -> string;
    fn matches(&self, action: Action) -> bool;
    fn execute(&self, action: Action, world: World) -> World;
    fn dup(&self) -> Box<dyn Handler>;
}
