module BoxAbi;

use std.collections;

// Separate from the clone codegen unit. This unit invokes only matches
// and execute, and never constructs a concrete handler or its vtable.
public fn applyWorld(world: World, action: Action) -> World {
    var i: i64 = 0;
    while (i < world.handlers.len) {
        let handler = world.handlers.get(i).deref();
        if (handler.matches(action)) {
            return handler.execute(action, world);
        }
        i = i + 1;
    }
    return world;
}
