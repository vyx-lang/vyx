module BoxAbi;

use std.collections;

// This codegen unit only invokes dup. Its vtable ABI still includes every
// declared interface method, including methods unused in this unit.
public fn duplicateWorld(world: &World) -> World {
    var result = World.create();
    result.counter = world.counter;
    var i: i64 = 0;
    while (i < world.handlers.len) {
        result.handlers.push(world.handlers.get(i).deref().dup());
        i = i + 1;
    }
    return result;
}
