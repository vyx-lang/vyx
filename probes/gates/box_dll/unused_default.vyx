extern "C" {
    fn box_dll_unreachable_default() -> i32;
}

// Keeping declaration shells must not make unused default bodies live.
// There is intentionally no implementation of this external function.
interface UnusedDefault {
    fn reserved(&self) -> i32 { return box_dll_unreachable_default(); }
}

fn main() -> i32 { return 0; }
