fn view_wrap(p: rawptr, n: i64) -> string {
    return from_cstr_view_len(p, n);
}

fn raw_wrap(p: rawptr, n: i64) -> string {
    return from_raw_string_parts(p, n, 0, 0);
}

fn intern_wrap(p: rawptr, n: i64) -> string {
    return from_raw_string_parts(p, n, 0, 0);
}

fn main() -> i32 {
    let p = "hello_view_probe".c_str();
    let a = view_wrap(p, 16);
    let b = raw_wrap(p, 16);
    if (a.len != 16) { return 1; }
    if (b.len != 16) { return 2; }
    print(a);
    return 0;
}
