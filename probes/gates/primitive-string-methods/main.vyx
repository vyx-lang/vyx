module probes.primitive_string_methods;

class Version {
    value: i32;
    public fn toString() -> string { return "version"; }
}

class Label {
    value: i32;
    public fn to_string() -> string { return "label"; }
}

fn main() -> i32 {
    let number: i32 = 10;
    let signed: i64 = -5000000000;
    let unsigned: u64 = (0 as u64) - (1 as u64);
    let truth = true;
    let falsehood = false;
    let small_float: f32 = 1.5;
    let wide_float: f64 = 1.5;
    let text = "A\0B";
    let snake: string = number.to_string();
    let camel: string = number.toString();
    if (snake != "10" || camel != "10") { return 1; }
    if (signed.to_string() != "-5000000000") { return 2; }
    if (unsigned.to_string() != "18446744073709551615") { return 3; }
    if (truth.to_string() != "true" || falsehood.to_string() != "false") { return 4; }
    if (small_float.to_string() != "1.5" || wide_float.to_string() != "1.5") { return 5; }
    if (text.to_string() != "A\0B" || text.toString() != "A\0B") { return 6; }
    let version = Version { value: 1 };
    let label = Label { value: 2 };
    if (version.toString() != "version" || label.to_string() != "label") { return 7; }
    print("primitive string methods ok");
    return 0;
}
