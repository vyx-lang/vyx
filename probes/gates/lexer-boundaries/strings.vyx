use std.string;

extern "C" {
    fn printf(format: rawptr, value: i32) -> i32;
}

fn main() -> i32 {
    // Both NUL escapes and bytes after them must survive AST/HIR/MIR lowering.
    let bytes = "a\0b";
    if (bytes.len != 3 || bytes.charAt(0) != 97 || bytes.charAt(1) != 0 || bytes.charAt(2) != 98) {
        return 1;
    }
    let zeros = "\0x\0";
    if (zeros.len != 3 || zeros.charAt(0) != 0 || zeros.charAt(2) != 0) { return 2; }
    if ('\n' != 10 || '\r' != 13 || '\0' != 0) { return 5; }
    let escapes = "\n\r\t\\\"\'\$\0";
    if (escapes.len != 8 || escapes.charAt(1) != 13 || escapes.charAt(7) != 0) { return 6; }
    let joined = "left\0${42}\0right";
    if (joined.len != 13 || joined.charAt(4) != 0 || joined.charAt(7) != 0 || joined.charAt(12) != 116) {
        return 3;
    }
    let embedded = "${"a\0b"}";
    if (embedded.len != 3 || embedded.charAt(1) != 0 || embedded.charAt(2) != 98) { return 4; }
    print(bytes);
    print(zeros);
    print(joined);
    var dynamic = String.empty();
    dynamic.push(97);
    dynamic.push(0);
    dynamic.push(98);
    print(dynamic);
    print("ordered=", 17, ":", dynamic, ":tail");
    print("interpolate=${dynamic}");
    printf("%d:".c_str(), 23);
    print("printf-bytes");
    printf("%d:".c_str(), 24);
    print(dynamic);
    var heap = String.withCapacity(64);
    heap.append("01234567890123456789012345678901");
    heap.push(0);
    heap.push(121);
    if (!heap.isHeap() || heap.len != 34) { return 7; }
    print("heap=", heap);
    heap.push(122);
    if (heap.len != 35 || heap.byteAt(34) != 122) { return 8; }
    print("heap-again=", heap);

    // Interpolation accepts the same triple-quoted token as a let initializer.
    print("multiline=${"""
        }
        {
        """}");
    print("raw=${"""\q } {"""}");
    print("nested=${"answer=${"ok"}"}");
    print("legacy=${\"a\"}");
    print("comments=${1 /* outer } /* nested { */ */ + 2}");
    /* Valid nested comments may end at EOF after the final declaration. */
    print("bytes=ok");
    return 0;
}
/* outer /* inner */ end */
