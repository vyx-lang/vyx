use identity.left;
use identity.right;

type LeftAlias = identity.left.Record;

fn read_left(value: &identity.left.Record) -> i64 { return value.value; }
fn read_right(value: &identity.right.Record) -> i64 { return value.prefix + value.value; }
fn read_alias(value: &LeftAlias) -> i64 { return value.value; }
fn read_box(value: &identity.left.Box<i64>) -> i64 { return value.value; }

fn main() -> i32 {
    var a = identity.left.Record { value: 17 };
    let b = identity.right.Record { prefix: 100, value: 42 };
    if (read_left(&a) != 17 || read_right(&b) != 142 || read_alias(&a) != 17) { return 1; }
    a = identity.left.Record { value: 23 };
    if (read_left(&a) != 23) { return 2; }
    var boxed: identity.left.Box<i64> = identity.left.Box<i64> { value: 31 };
    if (read_box(&boxed) != 31) { return 3; }
    let shared: &identity.left.Record = &mut a;
    if (read_left(shared) != 23) { return 4; }
    print("nominal-identity=ok");
    return 0;
}
