module gate.platform_api;

@[platform("windows")]
extern "C" {
    fn GetFileAttributesA(path: rawptr) -> u32;
    @[link_name("gate_windows")]
    fn platform_choice() -> i32;
    @[platform("linux")]
    fn gate_parent_child_disjoint() -> i32;
}

@[platform("posix")]
extern "C" {
    fn opendir(path: rawptr) -> rawptr;
    @[platform("linux")]
    @[link_name("gate_linux")]
    fn platform_choice() -> i32;
    @[platform("android")]
    @[link_name("gate_android")]
    fn platform_choice() -> i32;
    @[platform("macos")]
    @[link_name("gate_macos")]
    fn platform_choice() -> i32;
    @[platform("linux")]
    @[platform("macos")]
    fn gate_repeated_clause_union() -> i32;
}

extern "C" {
    @[ffi_returns_independent]
    fn gate_independent(out_length: rawptr) -> rawptr;
    @[opaque("@[platform(\"windows\")] @ffi_returns_independent |effect:platform|")]
    fn gate_opaque_payload() -> rawptr;
}

@[platform("windows")]
public fn ordinary() -> i32 { return 1; }
@[platform("linux")]
public fn ordinary() -> i32 { return 2; }
@[platform("android")]
public fn ordinary() -> i32 { return 3; }
@[platform("macos")]
public fn ordinary() -> i32 { return 4; }

@[platform("windows")]
public class WindowsOnly { public value: i32; }
@[platform("posix")]
public class PosixOnly { public value: i32; }
@[platform("windows")]
public enum WindowsState { Ready }
@[platform("posix")]
public enum PosixState { Ready }
@[platform("windows")]
public type PlatformInteger = i32;
@[platform("posix")]
public type PlatformInteger = i64;
@[platform("windows")]
public const platform_constant: i32 = 1;
@[platform("posix")]
public const platform_constant: i32 = 2;
