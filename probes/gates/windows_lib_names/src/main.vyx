module probes.windows_lib_names;

extern "C" {
    fn manifest_curl() -> i32;
    fn manifest_ssl() -> i32;
    fn manifest_crypto() -> i32;
}

fn main() -> i32 {
    if (manifest_curl() + manifest_ssl() + manifest_crypto() != 6) {
        return 1;
    }
    print("windows library names OK");
    return 0;
}
