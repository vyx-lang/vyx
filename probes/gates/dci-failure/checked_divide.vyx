@[dci_import("contracts/abi_fixtures.dcib")]
@[cpp_include("abi_fixtures.hpp")]
extern "dci" {
    class dci.Failure {
        public type_identity: rawptr;
        public type_identity_len: u64;
        public message: rawptr;
        public message_len: u64;
        public payload: rawptr;
        public payload_size: u64;
        public payload_align: u64;
        public producer_tag: u32;
    };

    fn checked_divide(a: i32, b: i32) -> Result<i32, dci.Failure>;
}

extern "C" {
    fn dci_failure_probe_expected_identity_length() -> u64;
    fn dci_failure_probe_check_and_destroy(failure: rawptr) -> i32;
    fn dci_failure_probe_destroyed_count() -> i32;
    fn dci_failure_probe_clobber_stack(seed: u64) -> u64;
}

@[noinline]
fn divide_result(a: i32, b: i32) -> Result<i32, dci.Failure> {
    return checked_divide(a, b);
}

@[noinline]
fn relay_result(a: i32, b: i32) -> Result<i32, dci.Failure> {
    return divide_result(a, b);
}

fn validate_failure(result: Result<i32, dci.Failure>) -> i32 {
    match (result) {
        case Ok(_) => { return 4; }
        case Err(e) => {
            // Check fields through Vyx's own Result and DCI field lowering.
            if (e.message_len != 37) { return 5; }
            if (e.message == null) { return 6; }
            if (e.type_identity_len != dci_failure_probe_expected_identity_length()) { return 7; }
            if (e.type_identity == null) { return 8; }
            if (e.producer_tag != 1) { return 9; }
            if (e.payload == null || e.payload_size == 0 || e.payload_align == 0) { return 10; }

            // This declaration has no automatic drop. The helper checks the
            // exact native strings/payload, then destroys its contents once.
            let native_check = dci_failure_probe_check_and_destroy(to_rawptr(&e));
            if (native_check != 0) { return native_check; }
            if (e.message != null || e.message_len != 0) { return 11; }
            if (e.type_identity != null || e.type_identity_len != 0) { return 12; }
            if (e.payload != null || e.payload_size != 0 || e.producer_tag != 0) { return 13; }
            return 0;
        }
    }
}

fn main() -> i32 {
    match (checked_divide(10, 2)) {
        case Ok(v) => { if (v != 5) { return 2; } }
        case Err(_) => { return 3; }
    }
    match (relay_result(18, 3)) {
        case Ok(v) => { if (v != 6) { return 14; } }
        case Err(_) => { return 15; }
    }

    var iteration: i32 = 0;
    while (iteration < 8) {
        let direct_check = validate_failure(checked_divide(1, 0));
        if (direct_check != 0) { return direct_check; }

        let returned = relay_result(7, 0);
        // Overwrite call-stack storage after both noinline Vyx frames return.
        // A Result pointing into a callee's temporary must not pass by luck.
        if (dci_failure_probe_clobber_stack(51) != 1125) { return 16; }
        let returned_check = validate_failure(returned);
        if (returned_check != 0) { return 100 + returned_check; }
        iteration = iteration + 1;
    }
    if (dci_failure_probe_destroyed_count() != 16) { return 17; }
    print("dci failure payload OK");
    return 0;
}
