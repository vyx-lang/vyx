@[dci_import("contracts/abi_fixtures.dcib")]
@[cpp_include("abi_fixtures.hpp")]
extern "dci" {
    class dci.Failure {
        public type_identity: rawptr;
        public type_identity_len: u64;
        public message: rawptr;
        public message_len: u64;
        public payload: rawptr;
        public payload_size: u64;
        public payload_align: u64;
        public producer_tag: u32;
    };

    fn checked_divide(a: i32, b: i32) -> Result<i32, dci.Failure>;
}

fn main() -> i32 {
    match (checked_divide(10, 2)) {
        case Ok(v) => { if (v != 5) { return 2; } }
        case Err(_) => { return 3; }
    }
    match (checked_divide(1, 0)) {
        case Ok(_) => { return 4; }
        case Err(e) => {
            if (e.message_len == 0) { return 5; }
            return 0;
        }
    }
}
