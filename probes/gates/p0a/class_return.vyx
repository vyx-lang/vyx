module probe.class_return;

use std.io;
use std.collections;

// P0a: a class owning a heap-backed field (Vec<i32> holds a rawptr).
// A method mutates that heap field, then the class is returned BY VALUE.
// The caller must observe the mutation — writes must not be "stranded"
// (lost) the moment the class crosses a by-value return boundary.

class Bag {
    public items: Vec<i32>;

    public fn add(self, v: i32) -> void { self.items.push(v); }
    public fn total(self) -> i32 {
        var t = 0;
        var i: i64 = 0;
        while (i < self.items.size()) {
            t = t + self.items.get(i);
            i = i + 1;
        }
        return t;
    }
}

// Build a Bag, mutate its heap-backed field, then return by value.
fn make() -> Bag {
    var b = Bag { items: Vec::<i32>.new() };
    b.add(10);
    b.add(20);
    return b;
}

fn main() -> i32 {
    var m = make();
    // If the write to the heap field was stranded on the value return,
    // total() will not see 30.
    if (m.total() != 30) { return 1; }

    // The returned value must still be a live, mutable Bag.
    m.add(5);
    if (m.total() != 35) { return 2; }

    println("class_return ok");
    return 0;
}
