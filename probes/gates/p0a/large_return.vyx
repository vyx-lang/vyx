module probe.large_return;

// P0a: a class larger than two machine words (32 bytes) is returned by
// value after a method mutates its fields. Lowering must use sret (not a
// first-class LLVM struct return) so the writes are not stranded.

class Big {
    public a: i64
    public b: i64
    public c: i64
    public d: i64

    public fn bump(self) -> void {
        self.a = self.a + 1;
        self.b = self.b + 2;
        self.c = self.c + 3;
        self.d = self.d + 4;
    }

    public fn sum(self) -> i64 {
        return self.a + self.b + self.c + self.d;
    }
}

fn make() -> Big {
    var x = Big { a: 10, b: 20, c: 30, d: 40 };
    x.bump();
    return x;
}

fn take(x: Big) -> i64 {
    return x.sum();
}

fn main() -> i32 {
    var x = make();
    if (x.sum() != 110) { return 1; }
    if (take(x) != 110) { return 2; }
    return 0;
}
