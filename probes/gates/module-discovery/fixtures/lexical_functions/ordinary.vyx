module lexical_function_identity.ordinary_consumer;
use lexical_function_identity.left;
use lexical_function_identity.right;

fn main() -> i32 {
    let a = lexical_function_identity.left::left_answer(20);
    let b = lexical_function_identity.right::right_answer(1);
    print("ordinary lexical functions a=${a} b=${b}");
    if (a != 21 || b != 21) { return 1; }
    print("ordinary lexical functions PASS");
    return 0;
}
