module lexical_function_identity.generic_consumer;
use lexical_function_identity.left;
use lexical_function_identity.right;

fn main() -> i32 {
    let a = lexical_function_identity.left::left_generic::<i32>(20);
    let b = lexical_function_identity.right::right_generic::<i32>(1);
    print("generic lexical functions a=${a} b=${b}");
    if (a != 11 || b != 22) { return 1; }
    print("generic lexical functions PASS");
    return 0;
}
