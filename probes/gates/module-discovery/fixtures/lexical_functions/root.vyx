use lexical_function_identity.right;

fn helper(value: i32) -> i32 { return value + 1; }
fn helper(value: bool) -> i32 { return -1; }
fn helper_generic<T>(value: T) -> i32 { return 11; }

fn main() -> i32 {
    let b = lexical_function_identity.right::right_answer(1);
    let a = helper(20);
    let c = helper_generic::<i32>(20);
    print("root lexical functions a=${a} b=${b} c=${c}");
    if (a != 21 || b != 21 || c != 11) { return 1; }
    print("root lexical functions PASS");
    return 0;
}
