module module_function_identity.same;
fn identity_specialized_duplicate<i32>(value: i32) -> i32 { return value; }

module module_function_identity.other;
fn identity_specialized_duplicate<i32>(value: i32) -> i32 { return value + 1; }

module module_function_identity.same;
fn identity_specialized_duplicate<i32>(value: i32) -> i32 { return value + 2; }
