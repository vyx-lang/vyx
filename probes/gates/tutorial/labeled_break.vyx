fn main() -> i32 {
    var quoted = 0;
    'outer: while (quoted < 10) {
        while (true) {
            break 'outer;
        }
        quoted = quoted + 1;
    }
    if (quoted != 0) { return 1; }

    var named = 0;
    outer: while (named < 10) {
        while (true) {
            break outer;
        }
        named = named + 1;
    }
    if (named != 0) { return 2; }

    var continued = 0;
    var i = 0;
    'skip: while (i < 3) {
        i = i + 1;
        var j = 0;
        while (j < 10) {
            j = j + 1;
            if (j == 1) { continue 'skip; }
            continued = continued + 1;
        }
        continued = continued + 100;
    }
    if (i != 3 || continued != 0) { return 3; }
    return 0;
}
