trait Measure { fn sum(self) -> i32; }

class Base { public x: i32; }
class Child : Base { public y: i32; }

impl Measure for Child {
    fn sum(self) -> i32 { return self.x + self.y; }
}

fn main() -> i32 {
    let child = Child { x: 20, y: 22 };
    if (child.x != 20 || child.y != 22 || child.sum() != 42) { return 1; }
    print(child.sum());
    return 0;
}
