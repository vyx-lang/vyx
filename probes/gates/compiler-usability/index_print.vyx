use std.collections;

fn main() -> i32 {
    var v = Vec::<i32>.new();
    defer { v.destroy(); }
    v.push(12345);
    v.push(-6789);
    let i = 1;
    let y = v[i];
    print(y);
    print("y=${y} direct=${v[i]}");
    print(v[i]);
    let values = [12345, -6789];
    let z = values[i];
    print(z);
    var words = Vec::<string>.new();
    defer { words.destroy(); }
    words.push("alpha");
    words.push("beta");
    let word = words[i];
    print(word);
    print("word=${word} direct=${words[i]}");
    print(words[i]);
    var fractions = Vec::<f64>.new();
    defer { fractions.destroy(); }
    fractions.push(12.5);
    let fraction = fractions[0];
    print(fraction);
    print("fraction=${fraction}");
    var flags = Vec::<bool>.new();
    defer { flags.destroy(); }
    flags.push(true);
    let flag = flags[0];
    print("flag=${flag}");
    var small = Vec::<f32>.new();
    defer { small.destroy(); }
    small.push(1.25);
    let small_value = small[0];
    print(small_value);
    print("small=${small_value}");
    var wide = Vec::<u64>.new();
    defer { wide.destroy(); }
    wide.push(-1 as u64);
    let unsigned_value = wide[0];
    print("unsigned=${unsigned_value}");
    if (words.get(i) != "beta") { return 1; }
    return 0;
}
