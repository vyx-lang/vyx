use std.vio;
use std.string;

var cleanups: i32 = 0;
class Packet {
    public code: i32;
    public text: String;
    public fn drop(&mut self) { cleanups += 1; self.text.drop(); }
}

@[async]
fn produce(seed: i32) -> Packet {
    let text = String.from("owned async result");
    await Task::<i32>.yield_now();
    await Task::<i32>.sleep(1);
    return Packet { code: seed, text: text };
}

fn main() -> i32 {
    for (index in 0..32) {
        let round = index as i32;
        {
            let first = produce(round);
            let second = produce(round + 1000);
            let a = await first;
            let b = await second;
            if (a.code != round || b.code != round + 1000) { return 1; }
            if (a.text.as_str() != "owned async result" || b.text.as_str() != "owned async result") { return 2; }
            if (cleanups != round * 2) { return 3; }
        }
        if (cleanups != (round + 1) * 2) { return 4; }
    }
    print(42);
    return 0;
}
