use std.vio;

class Input {
    public code: i32;
    public text: string;

    @[async]
    public fn bump(self, increment: i32) -> i32 {
        self.code = self.code + increment;
        await Task::<i32>.yield_now();
        self.code = self.code + increment;
        await Task::<i32>.sleep(1);
        return self.code;
    }
}

@[async]
fn inspect(mut input: Input) -> i32 {
    input.code = input.code + 10;
    input.text = input.text + "-first";
    await Task::<i32>.yield_now();
    if (!input.text.endsWith("-first")) { return -1; }
    input.code = input.code + 100;
    input.text = input.text + "-second";
    await Task::<i32>.sleep(1);
    if (!input.text.endsWith("-first-second")) { return -2; }
    return input.code;
}

@[async]
fn advance(mut value: i32) -> i32 {
    value = value + 10;
    await Task::<i32>.yield_now();
    if (value < 10) { return -1; }
    value = value + 100;
    await Task::<i32>.sleep(1);
    return value;
}

@[async]
fn rename(mut label: string) -> i32 {
    label = label + "-first";
    await Task::<i32>.yield_now();
    if (!label.endsWith("-first")) { return -1; }
    label = label + "-second";
    await Task::<i32>.sleep(1);
    if (!label.endsWith("-first-second")) { return -2; }
    return label.len as i32;
}

fn main() -> i32 {
    for (round in 0..32) {
        let first = advance(round);
        let second = advance(round + 1000);
        let a = await first;
        let b = await second;
        if (a != round + 110 || b != round + 1110) {
            print("round=${round} a=${a} b=${b}");
            return 1;
        }
        let name_a = rename("alpha");
        let name_b = rename("beta");
        if (await name_a != 18 || await name_b != 17) { return 2; }
        let input_a = inspect(Input { code: round, text: "alpha" });
        let input_b = inspect(Input { code: round + 1000, text: "beta" });
        if (await input_a != round + 110 || await input_b != round + 1110) { return 3; }
        var left = Input { code: round, text: "left" };
        var right = Input { code: round + 1000, text: "right" };
        let left_task = left.bump(5);
        let right_task = right.bump(7);
        if (await left_task != round + 10 || await right_task != round + 1014) { return 4; }
        if (left.code != round + 10 || right.code != round + 1014) { return 5; }
    }
    print(42);
    return 0;
}
