use std.vio;

class Message { public code: i32; public text: string; }

@[async]
fn make_text(seed: i32) -> string {
    let text = "message-${seed}";
    await Task::<i32>.yield_now();
    return text + "-ready";
}

@[async]
fn make_message(seed: i32) -> Message {
    let text = await make_text(seed);
    await Task::<i32>.sleep(1);
    return Message { code: seed + 10, text: text };
}

fn main() -> i32 {
    for (round in 0..32) {
        let first = make_message(round);
        let second = make_message(round + 1000);
        let a = await first;
        let b = await second;
        if (a.code != round + 10 || b.code != round + 1010) { return 1; }
        if (a.text != "message-${round}-ready" || b.text != "message-${round + 1000}-ready") { return 2; }
    }
    print(42);
    return 0;
}
