use std.vio;

@[async]
fn twice_after_yield(value: i32) -> i32 {
    let saved = value * 2;
    await Task::<i32>.yield_now();
    return saved;
}

@[async]
fn delayed_add(a: i32, b: i32) -> i32 {
    let before = a + b;
    await Task::<i32>.yield_now();
    let doubled = await twice_after_yield(before);
    let after = doubled / 2 + 1;
    await Task::<i32>.sleep(1);
    return after - 1;
}

fn main() -> i32 {
    for (round in 0..32) {
        let a = delayed_add(round, 22);
        let b = delayed_add(20, round);
        let first = await a;
        let second = await b;
        if (first != round + 22 || second != round + 20) {
            print("round=${round} first=${first} second=${second}");
            return 1;
        }
    }
    print(42);
    return 0;
}
