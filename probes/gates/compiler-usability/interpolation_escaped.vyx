fn main() -> i32 {
    let text = "alpha";
    print("legacy=${text.contains(\"a\")}");
    print("braces=${\"}\"}:${\"{\"}");
    print("quote=${\"\\\"\"}");
    print("slash=${\"\\\\\"}");
    print("mixed=${text.contains(\"a\")} ${text.contains("l")}");
    print("nested=${\"inner=${"ok"}\"}");
    print("char=${\'}\'}");
    print("comment=${1 /* \" } */ + 2}");
    print("quote-brace=${\"\\\"}\\\"\"}");
    return 0;
}
