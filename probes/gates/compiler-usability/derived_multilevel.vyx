trait Sum { fn sum(self) -> i32; }
trait Label { fn label(self) -> string; }

class Root { public x: i32; public name: string; }
class Middle : Root { public y: i32; }
class Leaf : Middle { public z: i32; public tail: string; }

impl Sum for Leaf {
    fn sum(self) -> i32 { return self.x + self.y + self.z; }
}
impl Label for Leaf {
    fn label(self) -> string { return self.name + ":" + self.tail; }
}

fn main() -> i32 {
    let leaf = Leaf { x: 10, name: "root", y: 20, z: 12, tail: "leaf" };
    if (leaf.x != 10 || leaf.y != 20 || leaf.z != 12) { return 1; }
    if (leaf.name != "root" || leaf.tail != "leaf") { return 2; }
    if (leaf.sum() != 42 || leaf.label() != "root:leaf") { return 3; }
    print(42);
    return 0;
}
