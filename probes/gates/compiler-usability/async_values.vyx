use std.vio;
use std.collections;

var cleanups: i32 = 0;

class State { public number: i32; public text: string; }

@[async]
fn preserve(seed: i32) -> i32 {
    var state = State { number: seed, text: "task-${seed}" };
    var numbers = Vec::<i32>.new();
    numbers.push(seed);
    numbers.push(seed + 1);
    var text = "before-${seed}";
    defer { cleanups = cleanups + 1; }
    await Task::<i32>.yield_now();
    if (state.number != seed || state.text != "task-${seed}") { return -1; }
    if (numbers.get(0) != seed || numbers.get(1) != seed + 1) { return -2; }
    if (text != "before-${seed}") { return -3; }
    state.number = state.number + 10;
    state.text = state.text + "-after";
    numbers.push(seed + 2);
    text = text + "-after";
    await Task::<i32>.sleep(1);
    if (state.number != seed + 10 || state.text != "task-${seed}-after") { return -4; }
    if (numbers.len != 3 || numbers.get(2) != seed + 2) { return -5; }
    if (text != "before-${seed}-after") { return -6; }
    numbers.destroy();
    return state.number;
}

fn main() -> i32 {
    for (round in 0..32) {
        let first = preserve(round);
        let second = preserve(round + 1000);
        let a = await first;
        let b = await second;
        if (a != round + 10 || b != round + 1010 || cleanups != (round + 1) * 2) {
            print("round=${round} a=${a} b=${b} cleanups=${cleanups}");
            return 1;
        }
    }
    print(42);
    return 0;
}
