fn main() -> i32 {
    var lists = Vec<str>.new();
    lists.push(""); lists.push("foo"); lists.push("|foo||foobar|bar|");
    lists.push("读取|λ|a::b|a|b"); lists.push("identity::<i32>|direct|identity::<i32>");
    var queries = Vec<str>.new();
    queries.push(""); queries.push("foo"); queries.push("foobar"); queries.push("bar");
    queries.push("读取"); queries.push("λ"); queries.push("a::b"); queries.push("a|b");
    queries.push("foo|foobar"); queries.push("identity::<i32>"); queries.push("direct");
    var i: i64 = 0;
    while (i < lists.len) {
        var j: i64 = 0;
        while (j < queries.len) {
            let roots = lists.get(i); let name = queries.get(j);
            let original = name.len > 0 && hir_builder_string_contains("|" + roots + "|", "|" + name + "|");
            if (hir_builder_root_name_contains(roots, name) != original) {
                print("Root membership mismatch: " + roots + " / " + name); return 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (hir_builder_generic_root_names("direct|other") != "") { return 2; }
    if (hir_builder_generic_root_names("|direct|identity::<i32>|other|identity::<i32>|nested<fn(i32)->i32>|")
        != "identity::<i32>|identity::<i32>|nested<fn(i32)->i32>") { return 3; }
    if (hir_builder_generic_root_names("empty<>|broken<i32|ok:<i32>|plain<i64>")
        != "ok:<i32>|plain<i64>") { return 4; }
    var long_roots = "";
    i = 0;
    while (i < 1000) { long_roots = long_roots + "|root_" + i.toString(); i = i + 1; }
    // Warm runtime buffers, then repeat lookups against the same source bytes.
    if (!hir_builder_root_name_contains(long_roots, "root_999")) { return 5; }
    let before = vyx_rt_process_private_bytes();
    i = 0;
    while (i < 5000) {
        if (!hir_builder_root_name_contains(long_roots, "root_999")) { return 6; }
        if (hir_builder_root_name_contains(long_roots, "root_9999")) { return 7; }
        if (hir_builder_generic_root_names(long_roots).len != 0) { return 8; }
        i = i + 1;
    }
    let growth = vyx_rt_process_private_bytes() - before;
    print("Export root checks private_delta=" + growth.toString());
    if (growth > 8388608) { return 9; }
    lists.destroy(); queries.destroy();
    return 0;
}
