// Appended to the production HIR map implementation by run.ps1.
fn main() -> i32 {
    var raw = HirRawIntMap.create();
    var decl = HirDeclInstanceMap.create();
    var i: i32 = 1;
    while (i <= 20000) {
        let identity = ((i as i64) * 16) as rawptr;
        raw = hir_raw_int_map_put(raw, identity, i * 3);
        decl = hir_decl_instance_map_put(decl, identity, "param", i, i + 1);
        decl = hir_decl_instance_map_put(decl, identity, "other", i + 10, i + 11);
        i = i + 1;
    }
    i = 20000;
    while (i > 0) {
        let identity = ((i as i64) * 16) as rawptr;
        if (hir_raw_int_map_get(raw, identity) != i * 3) { return 1; }
        if (hir_decl_instance_map_item(decl, identity, "param") != i) { return 2; }
        if (hir_decl_instance_map_function(decl, identity, "other") != i + 11) { return 3; }
        if (hir_decl_instance_map_item(decl, identity, "missing") != 0) { return 4; }
        raw.put(identity, 0);
        decl.put(identity, "param", i + 100, 17);
        if (raw.get(identity) != 0) { return 5; }
        if (decl.item(identity, "param") != i + 100) { return 6; }
        if (decl.function(identity, "param") != 17) { return 7; }
        if (decl.item(identity, "other") != i + 10) { return 8; }
        i = i - 1;
    }
    if (raw.count != 20000 || decl.count != 40000) { return 9; }
    if (raw.get(null) != -1 || raw.get(9999999 as rawptr) != -1) { return 10; }
    if (decl.item(null, "param") != 0 || decl.item(16 as rawptr, "") != 0) { return 11; }
    // Overwriting an old node does not reorder reverse provenance.
    if (decl.decl_for_function(17) != 320000 as rawptr) { return 12; }
    raw = hir_raw_int_map_dispose(raw);
    decl.dispose();
    if (raw.head != null || raw.buckets != null || raw.count != 0) { return 13; }
    if (decl.head != null || decl.buckets != null || decl.count != 0) { return 14; }
    raw.put(16 as rawptr, 42);
    decl.put(16 as rawptr, "param", 42, 43);
    if (raw.get(16 as rawptr) != 42 || decl.function(16 as rawptr, "param") != 43) { return 15; }
    raw = hir_raw_int_map_dispose(raw);
    decl = hir_decl_instance_map_dispose(decl);
    print("HIR cache index: PASS (20000 identities, updates, rehash, teardown)");
    return 0;
}
