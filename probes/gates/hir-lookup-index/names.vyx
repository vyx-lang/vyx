fn main() -> i32 {
    var matcher = NameMatcher { marker: 0 };
    var requests = Vec<str>.new();
    requests.push(""); requests.push("foo"); requests.push("foo_bar");
    requests.push("operator+"); requests.push("operator_add"); requests.push("+");
    requests.push("operator[]"); requests.push("operator_index");
    requests.push("λ"); requests.push("读取"); requests.push("foo::bar");
    var names = Vec<str>.new();
    names.push(""); names.push("Other::different_method"); names.push("foobar");
    names.push("Type::fooSuffix"); names.push("_3A_3Afoo_3A_3A");
    names.push("_3A_3Afoo_5Fbar_3A_3A"); names.push("_3A_3A_5Ffoo_3A_3A");
    var i: i64 = 0;
    while (i < requests.len) {
        let request = requests.get(i);
        names.push(request); names.push("Owner::" + request);
        names.push("Owner_3A_3A" + request + "_3A_3Aother");
        names.push("Owner_3A_3A" + policy_mangle_part(request) + "_3A_3Aother");
        i = i + 1;
    }
    i = 0;
    while (i < requests.len) {
        var j: i64 = 0;
        while (j < names.len) {
            let request = requests.get(i); let name = names.get(j);
            if (matcher.function_name_matches_method(name, request) != matcher.baseline_function_name_matches_method(name, request)) {
                print("Name mismatch: " + name + " / " + request); return 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let before = vyx_rt_process_private_bytes();
    i = 0;
    while (i < 100000) {
        if (matcher.function_name_matches_method("Other::different_method", "unrelated_name")) { return 2; }
        i = i + 1;
    }
    let after = vyx_rt_process_private_bytes();
    if (before < 0 || after < 0 || after - before > 8388608) { return 3; }
    print("method names PASS private_delta=" + (after - before).toString());
    names.destroy(); requests.destroy();
    return 0;
}
