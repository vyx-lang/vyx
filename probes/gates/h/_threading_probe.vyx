use std.sync;
use std.threading;
use std.thread_pool;

var g_hits: rawptr = null;

fn bump(_arg: rawptr) -> i64 {
    var i: i32 = 0;
    while (i < 10000) {
        atomic_inc(g_hits);
        i = i + 1;
    }
    return 7;
}

fn pool_job(ctx: rawptr, _index: i64) {
    atomic_inc(ctx);
}

fn main() -> i32 {
    if (thread_available_parallelism() < 1) { return 1; }
    g_hits = atomic_new(0);
    let h1 = thread_spawn(bump as rawptr, null);
    let h2 = thread_spawn(bump as rawptr, null);
    if (h1 == null || h2 == null) { return 2; }
    let r1 = thread_join_result(h1);
    let r2 = thread_join_result(h2);
    if (r1 != 7 || r2 != 7) { return 3; }
    if (atomic_load(g_hits) != 20000) { return 4; }

    let mutex = Mutex::<i32>.new(0);
    mutex.lock();
    mutex.set(42);
    mutex.unlock();
    if (mutex.get() != 42) { return 5; }
    mutex.destroy();

    let sum = atomic_new(0);
    parallel_for(32, pool_job as rawptr, sum);
    if (atomic_load(sum) != 32) { return 6; }
    task_group_run(8, pool_job as rawptr, sum);
    if (atomic_load(sum) != 40) { return 7; }

    atomic_destroy(g_hits);
    atomic_destroy(sum);
    print("hello");
    return 0;
}
