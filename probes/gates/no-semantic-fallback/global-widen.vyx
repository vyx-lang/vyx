module global_widen_probe;
let offset: i32 = 4;
let poison: i32 = 1717986918;
let negative: i8 = -42;
let unsigned: u8 = 255;
let narrow_signed: i16 = -4429;
let narrow_unsigned: u16 = 65535;
fn signed(value: i64) -> i64 { return value; }
fn positive(value: u64) -> u64 { return value; }
fn main() -> i32 {
    if (signed(offset) != 4) { return 1; }
    if (signed(negative) != -42) { return 2; }
    if (positive(unsigned) != 255) { return 3; }
    if (signed(narrow_signed) != -4429) { return 4; }
    if (positive(narrow_unsigned) != 65535) { return 5; }
    return 0;
}
