module trait_parameter_probe;
use std.clone;
use std.hash;

class CloneOnly { public value: i32; }
impl Clone for CloneOnly {
    fn clone(&self) -> CloneOnly { return CloneOnly { value: self.value }; }
}
class Key : Hashable, Eq {
    public value: i32;
    fn hash(&self) -> i64 { return self.value as i64; }
    fn operator_eq(&self, other: Key) -> bool { return self.value == other.value; }
}
fn separate<T, U>(value: &T, key: &U) -> T where T: Clone, U: Hashable + Eq {
    return value.clone();
}
fn main() -> i32 {
    let value = CloneOnly { value: 4429 };
    let key = Key { value: 42 };
    let copied = separate(&value, &key);
    if (copied.value != 4429) { return 1; }
    return 0;
}
