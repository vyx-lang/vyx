module console_probe;
use std.string;
use std.fmt;
use std.collections;
use std.env;
use std.hash;
use std.core;

class Label { public value: i32; }
impl Display for Label {
    fn display() -> str { return "label"; }
}

fn main() -> i32 {
    var owned = String.from("owned");
    let label = Label { value: 4429 };
    let unsigned: u64 = 18446744073709551615 as u64;
    print("4429/", -42 as i64, "/", unsigned, "/", true, "/", 20320 as char, "/", owned, "/", label);
    if (owned.as_str() != "owned" || label.value != 4429) { return 1; }
    print("A\0B");
    var values = Vec::<i32>.new();
    values.push(42);
    let scalar = 42;
    print(values[0], "/", &scalar);
    println();
    assert(true);
    assert_eq(42, 42);
    if (argCount() < 1 || getArg(0).len == 0
        || args_count() != argCount() || arg(0) != getArg(0)) { return 2; }
    if (hash(42) != hash_i32(42) || compare(4, 7) != -1
        || !operator_eq("a", "a")) { return 3; }
    let present = Option::<i32>.some(42);
    let absent = Option::<i32>.none();
    let result = Result::<i32, i32>.ok(42);
    if (present.unwrap() != 42 || !absent.isNone() || result.unwrap() != 42) { return 4; }
    return 0;
}
