module shadow_probe;
struct Answer { public first: i64; public second: i64; }

fn print(value: i64) -> Answer { return Answer { first: value, second: 29 }; }
fn println(value: i64) -> i64 { return value + 1; }
fn malloc(size: i64) -> Answer { return Answer { first: size, second: 7 }; }
fn memset(value: i64) -> i64 { return value + 2; }
fn strlen(value: i64) -> i64 { return value + 3; }
fn argCount() -> i32 { return 42; }
fn getArg(index: i32) -> Answer { return Answer { first: index as i64, second: 6 }; }
fn format(value: i64) -> i64 { return value + 4; }
fn int_to_string(value: i64) -> i64 { return value + 5; }
fn assert(value: i64) -> i64 { return value + 6; }
fn sizeof(value: i64) -> i64 { return value + 7; }
fn hash(value: i64) -> i64 { return value + 8; }

fn main() -> i32 {
    let result = print(44);
    if (result.first != 44 || result.second != 29 || println(41) != 42) { return 1; }
    let allocated = malloc(35);
    if (allocated.first != 35 || allocated.second != 7) { return 2; }
    if (memset(40) != 42 || strlen(39) != 42 || argCount() != 42) { return 3; }
    let argument = getArg(36);
    if (argument.first + argument.second != 42) { return 4; }
    if (format(38) != 42 || int_to_string(37) != 42 || assert(36) != 42) { return 5; }
    if (sizeof(35) != 42 || hash(34) != 42) { return 6; }
    return 0;
}
