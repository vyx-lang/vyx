class Sink {
    public fn count(value: u64) -> u64 { return value; }
    public fn small(value: u8) -> u8 { return value; }
    public fn signed(value: i8) -> i8 { return value; }
    public fn run() -> u64 { return self.count(2); }
}
fn main() -> i32 {
    let sink = Sink {};
    if (sink.run() != 2 || sink.count(3) != 3
        || sink.small(255) != 255 || sink.signed(-1) != -1) { return 1; }
    return 0;
}
