module nonclone_container_probe;
use std.collections;
use std.clone;

class NotClone { public value: i32; }
fn require_clone<T>(value: &T) -> T where T: Clone { return value.clone(); }
fn main() -> i32 {
    let values = Vec::<NotClone>.new();
    let copied = require_clone(&values);
    return 0;
}
