module container_clone_probe;
use std.collections;
use std.string;
use std.clone;

@[derive(Clone)]
class Bundle {
    public values: Vec<String>;
    public table: Dict<str, String>;
}

fn require_clone<T>(value: &T) -> T where T: Clone {
    return value.clone();
}

fn main() -> i32 {
    var values = Vec::<String>.new();
    values.push(String.from("a sufficiently long independently owned value"));
    var table = Dict::<str, String>.new();
    table.put("key", String.from("a sufficiently long independently owned dictionary value"));
    var original = Bundle { values: values, table: table };
    var copied = require_clone(&original);
    copied.values.set(0, String.from("changed"));
    copied.table.put("key", String.from("changed"));
    if (original.values.get_ref(0).as_str() != "a sufficiently long independently owned value") { return 1; }
    if (original.table.get("key").as_str() != "a sufficiently long independently owned dictionary value") { return 2; }
    var inner = Vec::<i32>.new();
    inner.push(42);
    var nested = Vec::<Vec<i32>>.new();
    nested.push(inner);
    var twin = require_clone(&nested);
    twin.get_mut(0).push(7);
    if (nested.get_ref(0).len != 1 || twin.get_ref(0).len != 2) { return 3; }
    copied.values.destroy();
    copied.table.destroy();
    twin.destroy();
    if (original.values.get_ref(0).len < 40 || nested.get_ref(0).get(0) != 42) { return 4; }
    return 0;
}
