use std.collections;
use std.string;
class Names {
    public fn operator[](&self, index: i64) -> str { return "declared"; }
}
fn main() -> i32 {
    var values = Vec::<str>::new();
    values.push("value");
    if (values[0].c_str() == null || values[0].len != 5) { return 1; }
    var names = Names {};
    if (names[0].len != 8) { return 2; }
    return 0;
}
