extern "C" {
    fn __vyx_atomic_load_i64_intrinsic(value: rawptr) -> i64;
    fn __vyx_atomic_fetch_add_i64_intrinsic(value: rawptr, delta: i64) -> i64;
    fn __vyx_atomic_compare_exchange_i64_intrinsic(value: rawptr, expected: i64, desired: i64) -> i64;
}
fn main() -> i32 {
    var value: i64 = 10;
    let pointer = to_rawptr(&value);
    if (__vyx_atomic_load_i64_intrinsic(pointer) != 10) { return 1; }
    if (__vyx_atomic_fetch_add_i64_intrinsic(pointer, 2) != 10) { return 2; }
    if (__vyx_atomic_compare_exchange_i64_intrinsic(pointer, 12, 42) != 12) { return 3; }
    if (__vyx_atomic_load_i64_intrinsic(pointer) != 42) { return 4; }
    return 0;
}
