module nested_arity;

// Negative case: `Grp.A` declares (T,T,V) -- three parameters -- so a use site
// that spells only two of them must be rejected rather than silently binding
// the tail parameter to nothing.
struct Grp<T> {
    struct A<T, V> {
        public a: T;
        public b: V;
    }
    public data: *T = null;
}

fn main() {
    var c = Grp<i32>::A<i32> { a: 1, b: 2.5 };
    print(c.a);
}
