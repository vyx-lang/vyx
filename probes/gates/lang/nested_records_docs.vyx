module nested_docs;

// The three snippets from `docs/ADVANCED_FEATURES.md` (lesson 32 area,
// "Nested records") and `docs/高级特性_ZH.md`, compiled verbatim as one
// program: the documentation must be a `boot` compile away from reality.

struct FreqArray<T> {
    struct A<T> { public a: T; }        // same list as the parent: adds nothing
    struct B<U> { public b: U; }        // adds U
    struct C<T, V> { public c1: T; public c2: V; }   // restates T, adds V
    struct D<K, V> { public d1: K; public d2: V; }   // all new names
    public data: *T = null;
}

struct L1<T> {
    struct L2<U> {
        struct L3<V> {
            public a: T;
            public b: U;
            public c: V;
        }
    }
}

struct Holder {
    c: FreqArray<i32>::C<i32, f64>;
    deep: L1<i32>::L2<f64>::L3<i8>;
}

class Box<T> {
    class Inner {
        public v: i64;
        Inner(n: i64) { self.v = n; }
        public fn get(&mut self) -> i64 { return self.v; }
    }
    public t: T;
}

fn main() -> i32 {
    let a = FreqArray<i32>::A { a: 11 };
    let b = FreqArray<i32>::B<f64> { b: 2.5 };
    let c = FreqArray<i32>::C<i32, f64> { c1: 3, c2: 4.5 };
    let d = FreqArray<i32>::D<i64, f64> { d1: 5, d2: 6.5 };
    print("${a.a} ${b.b} ${c.c1} ${c.c2} ${d.d1} ${d.d2}");

    let h = Holder { c: FreqArray<i32>::C<i32, f64> { c1: 7, c2: 8.5 },
                     deep: L1<i32>::L2<f64>::L3<i8> { a: 91, b: 92.5, c: 93 } };
    print("${h.c.c1} ${h.c.c2} ${h.deep.a} ${h.deep.b} ${h.deep.c}");

    var boxed = Box<i32>::Inner(42);
    print("${boxed.get()}");
    print("nested-docs-ok");
    return 0;
}
