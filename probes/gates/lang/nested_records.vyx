module nest;

// ── 1. 嵌套参数表与父级完全相同（双 T）⇒ 使用处无需写实参
struct Pal<T> {
    struct A<T> {
        public a: T;
    }
    public data: *T = null;
}

// ── 2. 嵌套引入不同名的参数 ⇒ 使用处补齐
struct Arr<T> {
    struct A<U> {
        public a: U;
    }
    public data: *T = null;
}

// ── 3. 嵌套重复父级参数名并追加新参数 ⇒ 使用处写全表
struct Grp<T> {
    struct A<T, V> {
        public a: T;
        public b: V;
    }
    public data: *T = null;
}

// ── 4. 嵌套参数全为新名 ⇒ 使用处写全表（父实参在前）
struct Map4<T> {
    struct A<K, V> {
        public a: K;
        public b: V;
    }
    public data: *T = null;
}

// ── 4b. 嵌套记录不写自己的参数表 ⇒ 继承父级全部参数
struct Bare<T> {
    struct A {
        public a: T;
    }
    public data: *T = null;
}

// ── 5. 任意深度嵌套
struct L1<T> {
    struct L2<K> {
        struct L3<V> {
            public a: T;
            public b: K;
            public c: V;
        }
    }
}

// ── 5b. 深度嵌套且参数表逐层重复（双 T 链）
struct Top<T> {
    struct Mid<T> {
        struct Leaf<T> {
            public v: T;
        }
    }
}

// ── class 嵌套 + 方法 + 构造函数 + 类型位置
class Holder<T> {
    class Inner<T> {
        public v: i64;
        Inner(n: i64) { self.v = n; }
        public fn get(&mut self) -> i64 { return self.v; }
    }
    public t: T;
}
class HolderU<T> {
    class Inner<U> {
        public v: U;
        Inner(x: U) { self.v = x; }
        public fn get(&mut self) -> U { return self.v; }
    }
    public t: T;
}

struct UseTypes {
    pa: Pal<i32>::A;
    pb: Arr<i32>::A<f64>;
    pc: Grp<i32>::A<i32, f64>;
    pd: Map4<i32>::A<i64, f64>;
    pe: L1<i32>::L2<f64>::L3<i8>;
}

fn main() {
    var c1 = Pal<i32>::A { a: 11 };
    print(c1.a);

    var c2 = Arr<i32>::A<f64> { a: 22.5 };
    print(c2.a);

    var c3 = Grp<i32>::A<i32, f64> { a: 33, b: 44.5 };
    print(c3.a);
    print(c3.b);

    var c4 = Map4<i32>::A<i64, f64> { a: 55, b: 66.5 };
    print(c4.a);
    print(c4.b);

    var c5 = L1<i32>::L2<f64>::L3<i8> { a: 71, b: 72.5, c: 73 };
    print(c5.a);
    print(c5.b);
    print(c5.c);

    var c0 = Bare<i32>::A { a: 12 };
    print(c0.a);

    var c6 = Top<i32>::Mid::Leaf { v: 81 };
    print(c6.v);

    var m = Holder<i32>::Inner { v: 42 };
    print(m.get());
    var m2 = Holder<i32>::Inner(43);
    print(m2.get());

    var n = HolderU<i32>::Inner<f64>(2.5);
    print(n.get());

    var u = UseTypes { pa: Pal::<i32>::A { a: 91 },
                       pb: Arr::<i32>::A::<f64> { a: 92.5 },
                       pc: Grp::<i32>::A::<i32, f64> { a: 93, b: 94.5 },
                       pd: Map4::<i32>::A::<i64, f64> { a: 95, b: 96.5 },
                       pe: L1::<i32>::L2::<f64>::L3::<i8> { a: 97, b: 98.5, c: 99 } };
    print(u.pa.a);
    print(u.pb.a);
    print(u.pc.a);
    print(u.pc.b);
    print(u.pd.a);
    print(u.pd.b);
    print(u.pe.a);
    print(u.pe.b);
    print(u.pe.c);
    print("nested5-ok");
}
