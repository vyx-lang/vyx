// Real QtCore through DCI: QPoint is the Qt class, qVersion is Qt's export.
@[dci_import("../contracts/qt.dcib")]
@[cpp_include("QtCore/QtCore")]
extern "dci" {
    class QPoint {
        QPoint();
        QPoint(xpos: i32, ypos: i32);
        public xp: i32;
        public yp: i32;
        public fn isNull() const -> bool;
        public fn x() const -> i32;
        public fn y() const -> i32;
        public fn manhattanLength() const -> i32;
    };

    fn qVersion() -> *i8;
}

fn main() -> i32 {
    let ver = qVersion();
    if (ver == null) {
        print("dci-qt FAIL version");
        return 1;
    }
    var p = QPoint(3, 4);
    if (p.x() != 3) {
        print("dci-qt FAIL x");
        return 2;
    }
    if (p.y() != 4) {
        print("dci-qt FAIL y");
        return 3;
    }
    if (p.manhattanLength() != 7) {
        print("dci-qt FAIL manhattan");
        return 4;
    }
    if (p.isNull()) {
        print("dci-qt FAIL isNull");
        return 5;
    }
    print("dci-qt OK");
    return 0;
}
