@[dci_import("../contracts/qt.dcib")]
@[cpp_include("QtCore/QtCore")]
extern "dci" {
    class QPoint {
        QPoint();
        QPoint(xpos: i32, ypos: i32);
        public xp: i32;
        public yp: i32;
        public fn isNull() const -> bool;
        public fn x() const -> i32;
        public fn y() const -> i32;
        public fn manhattanLength() const -> i32;
    };
}

fn main() -> i32 {
    var p = QPoint(3, 4);
    if (p.x() != 3) { return 2; }
    if (p.y() != 4) { return 3; }
    if (p.manhattanLength() != 7) { return 4; }
    if (p.isNull()) { return 5; }
    print("dci-qt QPoint OK");
    return 0;
}
