fn bare_plus_one(x: i64) -> i64 { return x + 1; }

fn main() -> i32 {
    let base: i64 = 5;
    let add_base = [base](x: i64) => x + base;
    let opt_bare = Option::<fn(i64) -> i64>.some(bare_plus_one);
    let opt_closure = Option::<fn(i64) -> i64>.some(add_base);
    let f_opt_bare = opt_bare.unwrap();
    let f_opt_closure = opt_closure.unwrap();
    if (f_opt_bare(40) != 41) { return 12; }
    if (f_opt_closure(2) != 7) { return 13; }
    return 0;
}
