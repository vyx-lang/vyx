use std.collections;
use std.core;

fn main() -> i32 {
    let a = Option::<i32>.some(10);
    if (!a.is_some()) { return 10; }
    if (a.unwrap_or(0) != 10) { return 11; }

    var v = Vec::<Option::<i32>>.new();
    v.push(Option::<i32>.some(10));
    v.push(Option::<i32>.none());
    v.push(Option::<i32>.some(30));

    let o0 = v.get(0);
    if (!o0.is_some()) { return 20; }
    if (o0.unwrap_or(-1) != 10) { return 21; }

    let o1 = v.get(1);
    if (!o1.is_none()) { return 22; }
    if (o1.unwrap_or(7) != 7) { return 23; }

    let o2 = v.get(2);
    if (!o2.is_some()) { return 24; }
    if (o2.unwrap_or(-1) != 30) { return 25; }

    return 0;
}
