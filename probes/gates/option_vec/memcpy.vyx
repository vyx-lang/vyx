use std.core;

extern "C" {
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn main() -> i32 {
    let a = Option::<i32>.some(10);
    var out: Option<i32> = Option::<i32>.none();
    memcpy(to_rawptr(&out), to_rawptr(&a), sizeof::<Option<i32>>());
    if (!out.is_some()) { return 1; }
    if (out.unwrap_or(-1) != 10) { return 2; }
    print("sizeof Option<i32>=${sizeof::<Option<i32>>()}");
    return 0;
}
