class View {
    public n: i32;

    public fn dup(&self) -> View {
        return View { n: self.n };
    }

    public fn tree(mut self) -> i32 {
        return self.n;
    }
}

class Rt {
    public root: View;

    public fn toUi(&self) -> i32 {
        return self.root.tree();
    }
}

fn main() -> i32 {
    let r = Rt { root: View { n: 3 } };
    return r.toUi() - 3;
}
