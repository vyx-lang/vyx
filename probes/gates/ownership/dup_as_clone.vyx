use std.collections;

class Item {
    public n: i32;
    public id: string;

    public static fn create(n: i32, id: string) -> Item {
        return Item { n: n, id: id };
    }

    public fn dup(&self) -> Item {
        return Item { n: self.n, id: self.id };
    }
}

fn main() -> i32 {
    let a = Item.create(7, "x");
    if (a.n != 7) { return 1; }
    let b = a.clone();
    if (b.n != 7) { return 2; }
    var v = Vec::<Item>.new();
    v.push(Item.create(3, "y"));
    let c = v.get(0);
    if (c.n != 3) { return 3; }
    return 0;
}
