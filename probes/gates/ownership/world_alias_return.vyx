use std.collections;

class World {
    public xs: Vec<i32>;

    public static fn create() -> World {
        return World { xs: Vec::<i32>.new() };
    }

    public fn dup(&self) -> World {
        var out = World.create();
        var i: i64 = 0;
        while (i < self.xs.len) {
            out.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }

    public fn setX(mut self, v: i32) -> World {
        self.xs.push(v);
        return self;
    }
}

fn bindActions(world: World) -> World {
    var out = world;
    out = out.setX(1);
    return out;
}

fn main() -> i32 {
    var w = World.create();
    w = bindActions(w);
    if (w.xs.len != 1) { return 1; }
    if (w.xs.get(0) != 1) { return 2; }
    return 0;
}
