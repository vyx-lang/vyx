class Host {
    public n: i32;

    public fn drop() {}

    public fn destroy(&mut self) {}

    public fn count(&self) -> i32 {
        return self.n;
    }
}

fn viewFrom(h: Host) -> i32 {
    return h.n;
}

fn main() -> i32 {
    var host = Host { n: 1 };
    let c = viewFrom(host);
    if (host.count() != 1) { return 1; }
    host.destroy();
    return c - 1;
}
