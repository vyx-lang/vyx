use std.collections;

class Node {
    public xs: Vec<i32>;

    public static fn create() -> Node {
        return Node { xs: Vec::<i32>.new() };
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }

    public fn dup(&self) -> Node {
        var n = Node.create();
        var i: i64 = 0;
        while (i < self.xs.len) {
            n.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return n;
    }

    public fn push(mut self, v: i32) -> Node {
        self.xs.push(v);
        return self;
    }
}

fn main() -> i32 {
    let n = Node.create().push(1).push(2);
    if (n.xs.len != 2) { return 1; }
    if (n.xs.get(0) != 1) { return 2; }
    if (n.xs.get(1) != 2) { return 3; }
    return 0;
}
