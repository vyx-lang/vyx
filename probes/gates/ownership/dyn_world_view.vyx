use std.collections;

class World {
    public xs: Vec<i32>;

    public static fn create() -> World {
        return World { xs: Vec::<i32>.new() };
    }

    public fn dup(&self) -> World {
        var out = World.create();
        var i: i64 = 0;
        while (i < self.xs.len) {
            out.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }
}

class Node {
    public xs: Vec<i32>;

    public static fn create() -> Node {
        return Node { xs: Vec::<i32>.new() };
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }

    public fn dup(&self) -> Node {
        var out = Node.create();
        var i: i64 = 0;
        while (i < self.xs.len) {
            out.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return out;
    }
}

interface Comp {
    fn id(&self) -> string;
    fn configure(&self, world: World) -> World;
    fn view(&self, world: World) -> Node;
}

class Empty : Comp {
    public component_id: string;

    public static fn create(id: string) -> Empty {
        return Empty { component_id: id };
    }

    public fn id(&self) -> string {
        return self.component_id;
    }

    public fn configure(&self, world: World) -> World {
        return world;
    }

    public fn view(&self, world: World) -> Node {
        return Node.create();
    }
}

fn run(c: dyn Comp) -> i32 {
    var world = World.create();
    world.xs.push(3);
    world = c.configure(world);
    if (world.xs.len != 1) { return 10; }
    let v = c.view(world);
    if (v.xs.len != 0) { return 11; }
    return 0;
}

fn main() -> i32 {
    return run(Empty.create("empty"));
}
