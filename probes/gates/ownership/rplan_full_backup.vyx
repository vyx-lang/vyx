    public fn dependencyValid(index: i32) -> bool {
        return true;
    }

    public fn dependenciesValid() -> bool {
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            if (!self.dependencyValid(i)) { return false; }
            i = i + 1;
        }
        if (!self.dependenciesCoverLifetimes()) { return false; }
        return true;
    }

    public fn dependencyCoversResource(resource_index: i32) -> bool {
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        let resource = self.resources.get(resource_index as i64);
        if (resource.first_pass == resource.last_pass) { return true; }
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.resource_index == resource_index
                && dependency.from_pass == resource.first_pass
                && dependency.to_pass == resource.last_pass) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn expectedDependencyCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            if (self.resourceLifetimeValid(i)) {
                let resource = self.resources.get(i as i64);
                if (resource.first_pass < resource.last_pass) {
                    count = count + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn dependencyCoverageCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            if (self.resourceLifetimeValid(i)) {
                let resource = self.resources.get(i as i64);
                if (resource.first_pass < resource.last_pass && self.dependencyCoversResource(i)) {
                    count = count + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn dependenciesCoverLifetimes() -> bool {
        let expected = self.expectedDependencyCount();
        if (self.dependencyCoverageCount() != expected) { return false; }
        if (self.dependencies.len as i32 != expected) { return false; }
        return true;
    }

    public fn passDependencyInCount(pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.to_pass == pass_index) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passDependencyOutCount(pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.from_pass == pass_index) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passHasDependency(from_pass: i32, to_pass: i32) -> bool {
        if (from_pass < 0 || from_pass >= self.passes.len as i32) { return false; }
        if (to_pass < 0 || to_pass >= self.passes.len as i32) { return false; }
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.from_pass == from_pass && dependency.to_pass == to_pass) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn dependencySpan(index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return 0; }
        let dependency = self.dependencies.get(index as i64);
        return dependency.to_pass - dependency.from_pass;
    }

    public fn maxDependencySpan() -> i32 {
        var max_span: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let span = self.dependencySpan(i);
            if (span > max_span) { max_span = span; }
            i = i + 1;
        }
        return max_span;
    }

    public fn totalDependencySpan() -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            total = total + self.dependencySpan(i);
            i = i + 1;
        }
        return total;
    }

    public fn uniquePassDependencyPairCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                let previous = self.dependencies.get(j as i64);
                if (previous.from_pass == dependency.from_pass && previous.to_pass == dependency.to_pass) {
                    seen = true;
                }
                j = j + 1;
            }
            if (!seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn duplicatePassDependencyPairCount() -> i32 {
        let unique_count = self.uniquePassDependencyPairCount();
        if (self.dependencies.len as i32 <= unique_count) { return 0; }
        return self.dependencies.len as i32 - unique_count;
    }

    public fn passDependencyPairDensityPermille() -> i32 {
        let possible_pairs = (self.passes.len as i32 * (self.passes.len as i32 - 1)) / 2;
        if (possible_pairs <= 0) { return 0; }
        return ((self.uniquePassDependencyPairCount() as i64) * 1000 / (possible_pairs as i64)) as i32;
    }

    public fn passScheduleLevel(pass_index: i32) -> i32 {
        return 0;
    }

    public fn scheduleLevelCount() -> i32 {
        if (self.passes.len as i32 <= 0) { return 0; }
        var max_level: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            let level = self.passScheduleLevel(i);
            if (level > max_level) { max_level = level; }
            i = i + 1;
        }
        return max_level + 1;
    }

    public fn passCountAtScheduleLevel(level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn scheduledPassAt(level: i32, slot: i32) -> i32 {
        if (level < 0 || slot < 0) { return -1; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) {
                if (count == slot) { return i; }
                count = count + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn scheduledPassSlot(pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return -1; }
        let level = self.passScheduleLevel(pass_index);
        if (level < 0) { return -1; }
        var slot: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) {
                if (i == pass_index) { return slot; }
                slot = slot + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn resourceIntersectsScheduleLevel(resource_index: i32, level: i32) -> bool {
        if (level < 0) { return false; }
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            if (self.passScheduleLevel(pass_i) == level && self.resourceActiveAtPass(resource_index, pass_i)) {
                return true;
            }
            pass_i = pass_i + 1;
        }
        return false;
    }

    public fn scheduleLevelActiveResourceCount(level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var resource_i: i32 = 0;
        while (resource_i < self.resources.len as i32) {
            if (self.resourceIntersectsScheduleLevel(resource_i, level)) {
                count = count + 1;
            }
            resource_i = resource_i + 1;
        }
        return count;
    }

    public fn scheduleLevelActiveResourceEstimatedBytes(level: i32) -> u64 {
        if (level < 0) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var resource_i: i32 = 0;
        while (resource_i < self.resources.len as i32) {
            if (self.resourceIntersectsScheduleLevel(resource_i, level)) {
                bytes = bytes + self.resources.get(resource_i as i64).estimated_bytes;
            }
            resource_i = resource_i + 1;
        }
        return bytes;
    }

    public fn maxScheduleLevelActiveResourceCount() -> i32 {
        var peak: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let count = self.scheduleLevelActiveResourceCount(level);
            if (count > peak) { peak = count; }
            level = level + 1;
        }
        return peak;
    }

    public fn maxScheduleLevelActiveResourceEstimatedBytes() -> u64 {
        var peak: u64 = 0 as u64;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let bytes = self.scheduleLevelActiveResourceEstimatedBytes(level);
            if (bytes > peak) { peak = bytes; }
            level = level + 1;
        }
        return peak;
    }

    public fn scheduleLevelDependencyInCount(level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (to_level == level && from_level != to_level) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn scheduleLevelDependencyOutCount(level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (from_level == level && from_level != to_level) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn scheduleOrderValid() -> bool {
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (from_level < 0 || to_level < 0) { return false; }
            if (dependency.from_pass != dependency.to_pass && from_level >= to_level) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn maxScheduleWidth() -> i32 {
        var max_width: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let width = self.passCountAtScheduleLevel(level);
            if (width > max_width) { max_width = width; }
            level = level + 1;
        }
        return max_width;
    }

    public fn scheduleSlotCount() -> i32 {
        return self.scheduleLevelCount() * self.maxScheduleWidth();
    }

    public fn scheduleSlackPassCount() -> i32 {
        let slots = self.scheduleSlotCount();
        if (slots <= self.passes.len as i32) { return 0; }
        return slots - self.passes.len as i32;
    }

    public fn serialScheduleLevelCount() -> i32 {
        var count: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            if (self.passCountAtScheduleLevel(level) == 1) { count = count + 1; }
            level = level + 1;
        }
        return count;
    }

    public fn parallelScheduleLevelCount() -> i32 {
        var count: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            if (self.passCountAtScheduleLevel(level) > 1) { count = count + 1; }
            level = level + 1;
        }
        return count;
    }

    public fn scheduleUtilizationPermille() -> i32 {
        let slots = self.scheduleSlotCount();
        if (slots <= 0) { return 0; }
        return ((self.passes.len as i32 as i64) * 1000 / (slots as i64)) as i32;
    }

    public fn criticalPathPassCount() -> i32 {
        return self.scheduleLevelCount();
    }

    public fn physicalResourceCountByKind(kind: RenderResourceKind) -> i32 {
        var pages = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.kind.equals(kind)) {
                var seen = false;
                var page_i: i32 = 0;
                while (page_i < (pages.len as i32)) {
                    if (pages.get(page_i as i64) == resource.page_id) {
                        seen = true;
                    }
                    page_i = page_i + 1;
                }
                if (!seen) {
                    pages.push(resource.page_id);
                }
            }
            i = i + 1;
        }
        let count = pages.len as i32;
        pages.destroy();
        return count;
    }

    public fn physicalResourceCount() -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            count = count + self.physicalResourceCountByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn physicalResourceEstimatedBytesByKind(kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.kind.equals(kind)) {
                var seen_page = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen = self.resources.get(seen_i as i64);
                    if (seen.kind.equals(kind) && seen.page_id == resource.page_id) {
                        seen_page = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen_page) {
                    var page_bytes = resource.estimated_bytes;
                    var scan_i: i32 = i + 1;
                    while (scan_i < self.resources.len as i32) {
                        let scan = self.resources.get(scan_i as i64);
                        if (scan.kind.equals(kind) && scan.page_id == resource.page_id && scan.estimated_bytes > page_bytes) {
                            page_bytes = scan.estimated_bytes;
                        }
                        scan_i = scan_i + 1;
                    }
                    bytes = bytes + page_bytes;
                }
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn physicalResourceEstimatedBytes() -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var seen_page = false;
            var seen_i: i32 = 0;
            while (seen_i < i) {
                let seen = self.resources.get(seen_i as i64);
                if (seen.kind.equals(resource.kind) && seen.page_id == resource.page_id) {
                    seen_page = true;
                }
                seen_i = seen_i + 1;
            }
            if (!seen_page) {
                var page_bytes = resource.estimated_bytes;
                var scan_i: i32 = i + 1;
                while (scan_i < self.resources.len as i32) {
                    let scan = self.resources.get(scan_i as i64);
                    if (scan.kind.equals(resource.kind) && scan.page_id == resource.page_id && scan.estimated_bytes > page_bytes) {
                        page_bytes = scan.estimated_bytes;
                    }
                    scan_i = scan_i + 1;
                }
                bytes = bytes + page_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn minimumPhysicalResourceCount() -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            count = count + self.minimumPhysicalResourceCountByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn minimumPhysicalResourceEstimatedBytes() -> u64 {
        var bytes: u64 = 0 as u64;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            bytes = bytes + self.minimumPhysicalResourceEstimatedBytesByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return bytes;
    }

    public fn minimumPhysicalResourceCountByKind(kind: RenderResourceKind) -> i32 {
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(0);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) == 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                }
                assigned.set(best_index as i64, 1);
            }
        }
        let count = page_last_pass.len as i32;
        page_last_pass.destroy();
        assigned.destroy();
        return count;
    }

    public fn minimumPhysicalResourceEstimatedBytesByKind(kind: RenderResourceKind) -> u64 {
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(0);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var page_bytes = Vec::<u64>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) == 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        if (resource.estimated_bytes > page_bytes.get(page_i as i64)) {
                            page_bytes.set(page_i as i64, resource.estimated_bytes);
                        }
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                    page_bytes.push(resource.estimated_bytes);
                }
                assigned.set(best_index as i64, 1);
            }
        }
        var bytes: u64 = 0 as u64;
        i = 0;
        while (i < (page_bytes.len as i32)) {
            bytes = bytes + page_bytes.get(i as i64);
            i = i + 1;
        }
        page_bytes.destroy();
        page_last_pass.destroy();
        assigned.destroy();
        return bytes;
    }

    public fn resourceReuseOpportunityCountByKind(kind: RenderResourceKind) -> i32 {
        let physical = self.physicalResourceCountByKind(kind);
        let minimum = self.minimumPhysicalResourceCountByKind(kind);
        if (physical <= minimum) { return 0; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityCount() -> i32 {
        let physical = self.physicalResourceCount();
        let minimum = self.minimumPhysicalResourceCount();
        if (physical <= minimum) { return 0; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityBytesByKind(kind: RenderResourceKind) -> u64 {
        let physical = self.physicalResourceEstimatedBytesByKind(kind);
        let minimum = self.minimumPhysicalResourceEstimatedBytesByKind(kind);
        if (physical <= minimum) { return 0 as u64; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityBytes() -> u64 {
        let physical = self.physicalResourceEstimatedBytes();
        let minimum = self.minimumPhysicalResourceEstimatedBytes();
        if (physical <= minimum) { return 0 as u64; }
        return physical - minimum;
    }

    public fn layerTargetPhysicalCount() -> i32 {
        return self.physicalResourceCountByKind(RenderResourceKind.layerColorTarget());
    }

    public fn layerTargetReuseCount() -> i32 {
        let physical = self.layerTargetPhysicalCount();
        if (self.layer_pass_count <= physical) { return 0; }
        return self.layer_pass_count - physical;
    }

    public fn resourceLifetimesOverlap(a: i32, b: i32) -> bool {
        if (!self.resourceLifetimeValid(a) || !self.resourceLifetimeValid(b)) { return false; }
        let left = self.resources.get(a as i64);
        let right = self.resources.get(b as i64);
        if (left.last_pass < right.first_pass) { return false; }
        if (right.last_pass < left.first_pass) { return false; }
        return true;
    }

    public fn resourceCanAlias(a: i32, b: i32) -> bool {
        if (a == b) { return false; }
        if (!self.resourceLifetimeValid(a) || !self.resourceLifetimeValid(b)) { return false; }
        let left = self.resources.get(a as i64);
        let right = self.resources.get(b as i64);
        if (!left.kind.equals(right.kind)) { return false; }
        return !self.resourceLifetimesOverlap(a, b);
    }

    public fn plannedPhysicalResourcePage(resource_index: i32) -> i32 {
        if (!self.resourceLifetimeValid(resource_index)) { return -1; }
        let target = self.resources.get(resource_index as i64);
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(-1);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) < 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(target.kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        assigned.set(best_index as i64, page_i);
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                    assigned.set(best_index as i64, (page_last_pass.len as i32) - 1);
                }
                if (best_index == resource_index) {
                    let page = assigned.get(best_index as i64);
                    page_last_pass.destroy();
                    assigned.destroy();
                    return page;
                }
            }
        }
        page_last_pass.destroy();
        assigned.destroy();
        return -1;
    }

    public fn resourcesSharePlannedPhysicalPage(a: i32, b: i32) -> bool {
        if (!self.resourceCanAlias(a, b)) { return false; }
        return self.plannedPhysicalResourcePage(a) == self.plannedPhysicalResourcePage(b);
    }

    public fn aliasableResourcePairCount(kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let left = self.resources.get(i as i64);
            if (left.kind.equals(kind)) {
                var j: i32 = i + 1;
                while (j < self.resources.len as i32) {
                    let right = self.resources.get(j as i64);
                    if (right.kind.equals(kind) && self.resourceCanAlias(i, j)) {
                        count = count + 1;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn totalAliasableResourcePairCount() -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            count = count + self.aliasableResourcePairCount(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn passCanMerge(a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.passes.len as i32 || b >= self.passes.len as i32) { return false; }
        if (a == b) { return false; }
        let left = self.passAt(a);
        let right = self.passAt(b);
        if (!left.kind.equals(right.kind)) { return false; }
        if (left.target_id != right.target_id) { return false; }
        if (left.clear || right.clear) { return false; }
        if (self.passHasDependency(a, b) || self.passHasDependency(b, a)) { return false; }
        if (left.first_command + left.command_count == right.first_command) { return true; }
        if (right.first_command + right.command_count == left.first_command) { return true; }
        return false;
    }

    public fn mergeCandidatePairCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            var j: i32 = i + 1;
            while (j < self.passes.len as i32) {
                if (self.passCanMerge(i, j)) { count = count + 1; }
                j = j + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn adjacentMergeCandidateCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while ((i + 1) < self.passes.len as i32) {
            if (self.passCanMerge(i, i + 1)) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passCanMergeWithPrevious(pass_index: i32) -> bool {
        if (pass_index <= 0 || pass_index >= self.passes.len as i32) { return false; }
        return self.passCanMerge(pass_index - 1, pass_index);
    }

    public fn passCanMergeWithNext(pass_index: i32) -> bool {
        if (pass_index < 0 || (pass_index + 1) >= self.passes.len as i32) { return false; }
        return self.passCanMerge(pass_index, pass_index + 1);
    }

    public fn adjacentMergeablePassCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithPrevious(i) || self.passCanMergeWithNext(i)) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn mergeRunCount() -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                count = count + 1;
                while (self.passCanMergeWithNext(i)) {
                    i = i + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn longestMergeRunLength() -> i32 {
        var best: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                var len: i32 = 1;
                while (self.passCanMergeWithNext(i)) {
                    len = len + 1;
                    i = i + 1;
                }
                if (len > best) { best = len; }
            }
            i = i + 1;
        }
        return best;
    }

    public fn mergeCompressionOpportunityCount() -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                var len: i32 = 1;
                while (self.passCanMergeWithNext(i)) {
                    len = len + 1;
                    i = i + 1;
                }
                total = total + len - 1;
            }
            i = i + 1;
        }
        return total;
    }

    public fn passOrderValid() -> bool {
        if (self.passes.len as i32 <= 0) { return true; }
        var seen_color = false;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            let pass = self.passAt(i);
            if (pass.kind.equals(RenderPassKind.color())) {
                if (i != self.passes.len as i32 - 1) { return false; }
                seen_color = true;
            } else {
                if (seen_color) { return false; }
            }
            if (pass.kind.equals(RenderPassKind.composite())) {
                var has_prior_layer = false;
                var prior_i: i32 = 0;
                while (prior_i < i) {
                    let prior = self.passAt(prior_i);
                    if (prior.kind.equals(RenderPassKind.layer()) && prior.target_id == pass.target_id) {
                        has_prior_layer = true;
                    }
                    prior_i = prior_i + 1;
                }
                if (!has_prior_layer) { return false; }
            }
            i = i + 1;
        }
        var dep_i: i32 = 0;
        while (dep_i < self.dependencies.len as i32) {
            let dependency = self.dependencyAt(dep_i);
            if (dependency.from_pass > dependency.to_pass) { return false; }
            dep_i = dep_i + 1;
        }
        return true;
    }

    public fn destroy(&mut self) {
        self.passes.destroy();
        self.resources.destroy();
        self.dependencies.destroy();
        self.command_count = 0;
        self.draw_count = 0;
        self.solid_draw_count = 0;
        self.textured_draw_count = 0;
        self.segment_count = 0;
        self.solid_segment_count = 0;
        self.textured_segment_count = 0;
        self.texture_page_count = 0;
        self.clip_change_count = 0;
        self.clip_path_count = 0;
        self.clip_path_cpu_coverage_count = 0;
        self.clip_path_bounds_fallback_count = 0;
        self.transform_change_count = 0;
        self.pipeline_change_count = 0;
        self.default_pipeline_change_count = 0;
        self.custom_pipeline_change_count = 0;
        self.unique_pipeline_count = 0;
        self.last_pipeline_id = -1;
        self.layer_change_count = 0;
        self.layer_pass_count = 0;
        self.max_layer_depth = 0;
        self.estimated_solid_vertices = 0;
        self.estimated_textured_vertices = 0;
        self.clip_expansion_vertex_reserve = 0;
        self.clip_mask_vertex_capacity_estimate = 0;
        self.clip_stencil_target_bytes_estimate = 0 as u64;
        self.layer_composite_vertex_reserve = 0;
        self.solid_vertex_capacity_estimate = 0;
        self.textured_vertex_capacity_estimate = 0;
        self.has_clear = false;
    }
}

public class RenderExecutionPlan {
    public scheduled_passes: Vec<i32>;
    public scheduled_levels: Vec<i32>;
    public scheduled_slots: Vec<i32>;
    public resource_physical_pages: Vec<i32>;
    public merge_run_first_passes: Vec<i32>;
    public merge_run_lengths: Vec<i32>;
    public pass_binding_first_indices: Vec<i32>;
    public pass_binding_counts: Vec<i32>;
    public pass_merge_run_indices: Vec<i32>;
    public binding_pass_indices: Vec<i32>;
    public binding_logical_resources: Vec<i32>;
    public binding_physical_pages: Vec<i32>;
    public binding_estimated_bytes: Vec<u64>;

    public static fn empty() -> RenderExecutionPlan {
        return RenderExecutionPlan {
            scheduled_passes: Vec::<i32>.new(),
            scheduled_levels: Vec::<i32>.new(),
            scheduled_slots: Vec::<i32>.new(),
            resource_physical_pages: Vec::<i32>.new(),
            merge_run_first_passes: Vec::<i32>.new(),
            merge_run_lengths: Vec::<i32>.new(),
            pass_binding_first_indices: Vec::<i32>.new(),
            pass_binding_counts: Vec::<i32>.new(),
            pass_merge_run_indices: Vec::<i32>.new(),
            binding_pass_indices: Vec::<i32>.new(),
            binding_logical_resources: Vec::<i32>.new(),
            binding_physical_pages: Vec::<i32>.new(),
            binding_estimated_bytes: Vec::<u64>.new()
        };
    }

    @[borrow_args]
    public static fn build(plan: RenderPlan) -> RenderExecutionPlan {
        var out = RenderExecutionPlan.empty();
        var level: i32 = 0;
        let level_count = plan.scheduleLevelCount();
        while (level < level_count) {
            var slot: i32 = 0;
            let pass_count = plan.passCountAtScheduleLevel(level);
            while (slot < pass_count) {
                let pass_index = plan.scheduledPassAt(level, slot);
                if (pass_index >= 0) {
                    out.scheduled_passes.push(pass_index);
                    out.scheduled_levels.push(level);
                    out.scheduled_slots.push(slot);
                }
                slot = slot + 1;
            }
            level = level + 1;
        }

        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            out.resource_physical_pages.push(plan.plannedPhysicalResourcePage(resource_i));
            resource_i = resource_i + 1;
        }

        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            if (plan.passCanMergeWithNext(pass_i)) {
                let first_pass = pass_i;
                var run_length: i32 = 1;
                while (plan.passCanMergeWithNext(pass_i)) {
                    run_length = run_length + 1;
                    pass_i = pass_i + 1;
                }
                out.merge_run_first_passes.push(first_pass);
                out.merge_run_lengths.push(run_length);
            }
            pass_i = pass_i + 1;
        }

        var scheduled_i: i32 = 0;
        while (scheduled_i < out.scheduledPassCount()) {
            let pass_index = out.scheduledPassAt(scheduled_i);
            out.pass_binding_first_indices.push(out.binding_logical_resources.len as i32);
            var binding_count: i32 = 0;
            resource_i = 0;
            while (resource_i < plan.resources.len as i32) {
                if (plan.resourceActiveAtPass(resource_i, pass_index)) {
                    out.binding_pass_indices.push(pass_index);
                    out.binding_logical_resources.push(resource_i);
                    out.binding_physical_pages.push(out.logicalResourcePhysicalPage(resource_i));
                    out.binding_estimated_bytes.push(plan.resourceEstimatedBytes(resource_i));
                    binding_count = binding_count + 1;
                }
                resource_i = resource_i + 1;
            }
            out.pass_binding_counts.push(binding_count);
            out.pass_merge_run_indices.push(out.mergeRunIndexForPass(pass_index));
            scheduled_i = scheduled_i + 1;
        }
        return out;
    }

    public fn scheduledPassCount() -> i32 {
        return self.scheduled_passes.len as i32;
    }

    public fn scheduledPassAt(index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_passes.get(index as i64);
    }

    public fn scheduledPassLevelAt(index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_levels.get(index as i64);
    }

    public fn scheduledPassSlotAt(index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_slots.get(index as i64);
    }

    public fn scheduledOrderIndex(pass_index: i32) -> i32 {
        var i: i32 = 0;
        while (i < self.scheduledPassCount()) {
            if (self.scheduled_passes.get(i as i64) == pass_index) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn logicalResourceCount() -> i32 {
        return self.resource_physical_pages.len as i32;
    }

    public fn logicalResourcePhysicalPage(index: i32) -> i32 {
        if (index < 0 || index >= self.logicalResourceCount()) { return -1; }
        return self.resource_physical_pages.get(index as i64);
    }

    public fn logicalResourcesSharePhysicalPage(a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.logicalResourceCount() || b >= self.logicalResourceCount()) { return false; }
        if (a == b) { return false; }
        let left = self.logicalResourcePhysicalPage(a);
        let right = self.logicalResourcePhysicalPage(b);
        return left >= 0 && left == right;
    }

    @[borrow_args]
    public fn logicalResourcesSharePhysicalPageForPlan(plan: RenderPlan, a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.logicalResourceCount() || b >= self.logicalResourceCount()) { return false; }
        if (a >= plan.resources.len as i32 || b >= plan.resources.len as i32) { return false; }
        if (!plan.resourceAt(a).kind.equals(plan.resourceAt(b).kind)) { return false; }
        return self.logicalResourcesSharePhysicalPage(a, b);
    }

    @[borrow_args]
    public fn physicalResourceCountForPlan(plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            count = count + self.physicalResourceCountByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalResourceCountByKindForPlan(plan: RenderPlan, kind: RenderResourceKind) -> i32 {
        var pages = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind)) {
                let physical_page = self.logicalResourcePhysicalPage(i);
                var seen = false;
                var page_i: i32 = 0;
                while (page_i < (pages.len as i32)) {
                    if (pages.get(page_i as i64) == physical_page) { seen = true; }
                    page_i = page_i + 1;
                }
                if (!seen && physical_page >= 0) { pages.push(physical_page); }
            }
            i = i + 1;
        }
        let count = pages.len as i32;
        pages.destroy();
        return count;
    }

    @[borrow_args]
    public fn physicalResourceEstimatedBytesForPlan(plan: RenderPlan) -> u64 {
        var bytes: u64 = 0 as u64;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            bytes = bytes + self.physicalResourceEstimatedBytesByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn physicalResourceEstimatedBytesByKindForPlan(plan: RenderPlan, kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind)) {
                let physical_page = self.logicalResourcePhysicalPage(i);
                var seen = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen_resource = plan.resourceAt(seen_i);
                    if (seen_resource.kind.equals(kind) && self.logicalResourcePhysicalPage(seen_i) == physical_page) {
                        seen = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen && physical_page >= 0) {
                    var page_bytes = resource.estimated_bytes;
                    var scan_i = i + 1;
                    while (scan_i < plan.resources.len as i32 && scan_i < self.logicalResourceCount()) {
                        let scan = plan.resourceAt(scan_i);
                        if (scan.kind.equals(kind) && self.logicalResourcePhysicalPage(scan_i) == physical_page && scan.estimated_bytes > page_bytes) {
                            page_bytes = scan.estimated_bytes;
                        }
                        scan_i = scan_i + 1;
                    }
                    bytes = bytes + page_bytes;
                }
            }
            i = i + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn physicalPageLogicalResourceCountByKindForPlan(plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalPageFirstPassByKindForPlan(plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return -1; }
        var first: i32 = -1;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && plan.resourceLifetimeValid(i)) {
                if (first < 0 || resource.first_pass < first) {
                    first = resource.first_pass;
                }
            }
            i = i + 1;
        }
        return first;
    }

    @[borrow_args]
    public fn physicalPageLastPassByKindForPlan(plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return -1; }
        var last: i32 = -1;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && plan.resourceLifetimeValid(i)) {
                if (resource.last_pass > last) {
                    last = resource.last_pass;
                }
            }
            i = i + 1;
        }
        return last;
    }

    @[borrow_args]
    public fn physicalPageEstimatedBytesByKindForPlan(plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> u64 {
        if (physical_page < 0) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && resource.estimated_bytes > bytes) {
                bytes = resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn resourceAliasSetSizeForPlan(plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return 0; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageLogicalResourceCountByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetFirstPassForPlan(plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return -1; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageFirstPassByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetLastPassForPlan(plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return -1; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageLastPassByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetEstimatedBytesForPlan(plan: RenderPlan, resource_index: i32) -> u64 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return 0 as u64; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageEstimatedBytesByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn logicalResourceIsAliasedForPlan(plan: RenderPlan, resource_index: i32) -> bool {
        return self.resourceAliasSetSizeForPlan(plan, resource_index) > 1;
    }

    @[borrow_args]
    public fn aliasedLogicalResourceCountForPlan(plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            if (self.logicalResourceIsAliasedForPlan(plan, i)) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn aliasGroupCountByKindForPlan(plan: RenderPlan, kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            let physical_page = self.logicalResourcePhysicalPage(i);
            if (resource.kind.equals(kind) && physical_page >= 0 && self.physicalPageLogicalResourceCountByKindForPlan(plan, kind, physical_page) > 1) {
                var seen = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen_resource = plan.resourceAt(seen_i);
                    if (seen_resource.kind.equals(kind) && self.logicalResourcePhysicalPage(seen_i) == physical_page) {
                        seen = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen) { count = count + 1; }
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn aliasGroupCountForPlan(plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 7) {
            count = count + self.aliasGroupCountByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalResourceSavingsBytesForPlan(plan: RenderPlan) -> u64 {
        let logical = plan.totalResourceEstimatedBytes();
        let physical = self.physicalResourceEstimatedBytesForPlan(plan);
        if (logical <= physical) { return 0 as u64; }
        return logical - physical;
    }

    @[borrow_args]
    public fn physicalResourceSavingsPermilleForPlan(plan: RenderPlan) -> i32 {
        let logical = plan.totalResourceEstimatedBytes();
        if (logical == 0 as u64) { return 0; }
        return ((self.physicalResourceSavingsBytesForPlan(plan) * (1000 as u64)) / logical) as i32;
    }

    public fn mergeRunCount() -> i32 {
        return self.merge_run_first_passes.len as i32;
    }

    public fn mergeRunFirstPass(index: i32) -> i32 {
        if (index < 0 || index >= self.mergeRunCount()) { return -1; }
        return self.merge_run_first_passes.get(index as i64);
    }

    public fn mergeRunLength(index: i32) -> i32 {
        if (index < 0 || index >= self.mergeRunCount()) { return 0; }
        return self.merge_run_lengths.get(index as i64);
    }

    public fn mergeRunLastPass(index: i32) -> i32 {
        let first = self.mergeRunFirstPass(index);
        let length = self.mergeRunLength(index);
        if (first < 0 || length <= 0) { return -1; }
        return first + length - 1;
    }

    public fn mergeRunIndexForPass(pass_index: i32) -> i32 {
        if (pass_index < 0) { return -1; }
        var i: i32 = 0;
        while (i < self.mergeRunCount()) {
            if (pass_index >= self.mergeRunFirstPass(i) && pass_index <= self.mergeRunLastPass(i)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn compiledBindingCount() -> i32 {
        return self.binding_logical_resources.len as i32;
    }

    public fn scheduledPassBindingFirstIndex(order_index: i32) -> i32 {
        if (order_index < 0 || order_index >= self.scheduledPassCount()) { return -1; }
        return self.pass_binding_first_indices.get(order_index as i64);
    }

    public fn scheduledPassBindingCount(order_index: i32) -> i32 {
        if (order_index < 0 || order_index >= self.scheduledPassCount()) { return 0; }
        return self.pass_binding_counts.get(order_index as i64);
    }

    public fn passBindingCount(pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return 0; }
        return self.scheduledPassBindingCount(order_index);
    }

    public fn passBindingFirstIndex(pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return -1; }
        return self.scheduledPassBindingFirstIndex(order_index);
    }

    public fn passMergeRunIndex(pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return -1; }
        return self.pass_merge_run_indices.get(order_index as i64);
    }

    public fn bindingPassIndex(index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_pass_indices.get(index as i64);
    }

    public fn bindingLogicalResource(index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_logical_resources.get(index as i64);
    }

    public fn bindingPhysicalPage(index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_physical_pages.get(index as i64);
    }

    public fn bindingEstimatedBytes(index: i32) -> u64 {
        if (index < 0 || index >= self.compiledBindingCount()) { return 0 as u64; }
        return self.binding_estimated_bytes.get(index as i64);
    }

    public fn passBindingLogicalResourceAt(pass_index: i32, slot: i32) -> i32 {
        if (slot < 0) { return -1; }
        let first = self.passBindingFirstIndex(pass_index);
        if (first < 0 || slot >= self.passBindingCount(pass_index)) { return -1; }
        return self.bindingLogicalResource(first + slot);
    }

    public fn passBindingPhysicalPageAt(pass_index: i32, slot: i32) -> i32 {
        if (slot < 0) { return -1; }
        let first = self.passBindingFirstIndex(pass_index);
        if (first < 0 || slot >= self.passBindingCount(pass_index)) { return -1; }
        return self.bindingPhysicalPage(first + slot);
    }

    @[borrow_args]
    public fn compiledBindingsValidForPlan(plan: RenderPlan) -> bool {
        if (self.scheduledPassCount() != self.pass_binding_first_indices.len as i32) { return false; }
        if (self.scheduledPassCount() != self.pass_binding_counts.len as i32) { return false; }
        if (self.scheduledPassCount() != self.pass_merge_run_indices.len as i32) { return false; }
        if (self.binding_pass_indices.len != self.binding_logical_resources.len) { return false; }
        if (self.binding_pass_indices.len != self.binding_physical_pages.len) { return false; }
        if (self.binding_pass_indices.len != self.binding_estimated_bytes.len) { return false; }
        var order_i: i32 = 0;
        while (order_i < self.scheduledPassCount()) {
            let pass_index = self.scheduledPassAt(order_i);
            let first = self.scheduledPassBindingFirstIndex(order_i);
            let count = self.scheduledPassBindingCount(order_i);
            if (first < 0 || count < 0 || first + count > self.compiledBindingCount()) { return false; }
            if (count != plan.activeResourceCountAtPass(pass_index)) { return false; }
            var slot: i32 = 0;
            while (slot < count) {
                let binding_index = first + slot;
                let resource_index = self.bindingLogicalResource(binding_index);
                if (self.bindingPassIndex(binding_index) != pass_index) { return false; }
                if (resource_index < 0 || resource_index >= plan.resources.len as i32) { return false; }
                if (!plan.resourceActiveAtPass(resource_index, pass_index)) { return false; }
                if (self.bindingPhysicalPage(binding_index) != self.logicalResourcePhysicalPage(resource_index)) { return false; }
                if (self.bindingEstimatedBytes(binding_index) != plan.resourceEstimatedBytes(resource_index)) { return false; }
                slot = slot + 1;
            }
            order_i = order_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn physicalPageHasLifetimeConflictForPlan(plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> bool {
        if (physical_page < 0) { return true; }
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let left = plan.resourceAt(i);
            if (left.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page) {
                var j: i32 = i + 1;
                while (j < plan.resources.len as i32 && j < self.logicalResourceCount()) {
                    let right = plan.resourceAt(j);
                    if (right.kind.equals(kind) && self.logicalResourcePhysicalPage(j) == physical_page && plan.resourceLifetimesOverlap(i, j)) {
                        return true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    @[borrow_args]
    public fn allocatorValidForPlan(plan: RenderPlan) -> bool {
        if (self.logicalResourceCount() != plan.resources.len as i32) { return false; }
        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            if (!plan.resourceLifetimeValid(resource_i)) { return false; }
            if (self.logicalResourcePhysicalPage(resource_i) < 0) { return false; }
            let resource = plan.resourceAt(resource_i);
            if (self.physicalPageHasLifetimeConflictForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_i))) {
                return false;
            }
            resource_i = resource_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn passCompilerValidForPlan(plan: RenderPlan) -> bool {
        if (!self.compiledBindingsValidForPlan(plan)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            if (self.scheduledOrderIndex(pass_i) < 0) { return false; }
            if (self.passMergeRunIndex(pass_i) != self.mergeRunIndexForPass(pass_i)) { return false; }
            pass_i = pass_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn isValidFor(plan: RenderPlan) -> bool {
        if (self.scheduledPassCount() != plan.passes.len as i32) { return false; }
        if (self.logicalResourceCount() != plan.resources.len as i32) { return false; }
        if (self.mergeRunCount() != plan.mergeRunCount()) { return false; }
        if (!self.allocatorValidForPlan(plan)) { return false; }
        if (!self.passCompilerValidForPlan(plan)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            let order_index = self.scheduledOrderIndex(pass_i);
            if (order_index < 0) { return false; }
            if (self.scheduledPassLevelAt(order_index) != plan.passScheduleLevel(pass_i)) { return false; }
            if (self.scheduledPassSlotAt(order_index) != plan.scheduledPassSlot(pass_i)) { return false; }
            pass_i = pass_i + 1;
        }
        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            if (self.logicalResourcePhysicalPage(resource_i) != plan.plannedPhysicalResourcePage(resource_i)) { return false; }
            resource_i = resource_i + 1;
        }
        var run_i: i32 = 0;
        while (run_i < self.mergeRunCount()) {
            if (self.mergeRunLength(run_i) <= 1) { return false; }
            if (!plan.passCanMergeWithNext(self.mergeRunFirstPass(run_i))) { return false; }
            run_i = run_i + 1;
        }
        return true;
    }

    public fn destroy(&mut self) {
        self.scheduled_passes.destroy();
        self.scheduled_levels.destroy();
        self.scheduled_slots.destroy();
        self.resource_physical_pages.destroy();
        self.merge_run_first_passes.destroy();
        self.merge_run_lengths.destroy();
        self.pass_binding_first_indices.destroy();
        self.pass_binding_counts.destroy();
        self.pass_merge_run_indices.destroy();
        self.binding_pass_indices.destroy();
        self.binding_logical_resources.destroy();
        self.binding_physical_pages.destroy();
        self.binding_estimated_bytes.destroy();
    }
}
