module Zyn.Nut.RenderPlan;
// ownership-migration

use Error = Zyn.Nut.Types.Error;
use RenderGraph = Zyn.Nut.RenderGraph.RenderGraph;
use RenderCommandKind = Zyn.Nut.RenderGraph.RenderCommandKind;
use std.collections;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn loadI32(src: rawptr) -> i32 {
    var v: i32 = 0;
    memcpy(to_rawptr(&v), src, 4);
    return v;
}

fn kindEqI32(a: rawptr, b: rawptr) -> bool {
    var av: i32 = 0;
    var bv: i32 = 0;
    memcpy(to_rawptr(&av), a, sizeof::<i32>() as i64);
    memcpy(to_rawptr(&bv), b, sizeof::<i32>() as i64);
    return av == bv;
}

public class RenderMaterialKind {
    public value: i32;

    public static fn none() -> RenderMaterialKind { return RenderMaterialKind { value: 0 }; }
    public static fn solid() -> RenderMaterialKind { return RenderMaterialKind { value: 1 }; }
    public static fn textured() -> RenderMaterialKind { return RenderMaterialKind { value: 2 }; }

    public fn equals(other: RenderMaterialKind) -> bool {
        return self.value == other.value;
    }

    public fn clone() -> RenderMaterialKind {
        var out: RenderMaterialKind;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderMaterialKind>() as i64);
        return out;
    }

    public fn writeValue(dst: rawptr) {
        memcpy(dst, to_rawptr(&self), sizeof::<i32>() as i64);
    }
}

public class RenderResourceKind {
    public value: i32;

    public static fn swapchainColor() -> RenderResourceKind { return RenderResourceKind { value: 1 }; }
    public static fn solidVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 2 }; }
    public static fn texturedVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 3 }; }
    public static fn spriteTexture() -> RenderResourceKind { return RenderResourceKind { value: 4 }; }
    public static fn layerColorTarget() -> RenderResourceKind { return RenderResourceKind { value: 5 }; }
    public static fn clipMaskVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 6 }; }
    public static fn clipStencilTarget() -> RenderResourceKind { return RenderResourceKind { value: 7 }; }
    public static fn fromValue(value: i32) -> RenderResourceKind { return RenderResourceKind { value: value }; }

    public fn equals(other: RenderResourceKind) -> bool {
        return self.value == other.value;
    }

    public fn clone() -> RenderResourceKind {
        var out: RenderResourceKind;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderResourceKind>() as i64);
        return out;
    }
}

public class RenderResource {
    public kind: RenderResourceKind;
    public estimated_bytes: u64;
    public page_id: i32;
    public first_pass: i32;
    public last_pass: i32;

    public static fn create(kind: RenderResourceKind, estimated_bytes: u64) -> RenderResource {
        return RenderResource.createForPage(kind, estimated_bytes, 0);
    }

    public static fn createForPage(kind: RenderResourceKind, estimated_bytes: u64, page_id: i32) -> RenderResource {
        return RenderResource.createForPageLifetime(kind, estimated_bytes, page_id, -1, -1);
    }

    public static fn createForPageLifetime(kind: RenderResourceKind, estimated_bytes: u64, page_id: i32, first_pass: i32, last_pass: i32) -> RenderResource {
        return RenderResource { kind: kind, estimated_bytes: estimated_bytes, page_id: page_id, first_pass: first_pass, last_pass: last_pass };
    }

    public fn clone() -> RenderResource {
        var out: RenderResource;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderResource>() as i64);
        return out;
    }

    public fn writeEstimatedBytes(dst: rawptr) {
        memcpy(dst, to_rawptr(&self.estimated_bytes), sizeof::<u64>() as i64);
    }

    public fn writeFirstPass(dst: rawptr) {
        memcpy(dst, to_rawptr(&self.first_pass), sizeof::<i32>() as i64);
    }

    public fn writeLastPass(dst: rawptr) {
        memcpy(dst, to_rawptr(&self.last_pass), sizeof::<i32>() as i64);
    }

    public fn writeKindValue(dst: rawptr) {
        memcpy(dst, to_rawptr(&self), sizeof::<i32>() as i64);
    }
}

public class RenderPassKind {
    public value: i32;

    public static fn color() -> RenderPassKind { return RenderPassKind { value: 1 }; }
    public static fn layer() -> RenderPassKind { return RenderPassKind { value: 2 }; }
    public static fn composite() -> RenderPassKind { return RenderPassKind { value: 3 }; }

    public fn equals(other: RenderPassKind) -> bool {
        return self.value == other.value;
    }

    public fn clone() -> RenderPassKind {
        var out: RenderPassKind;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderPassKind>() as i64);
        return out;
    }

    public fn writeValue(dst: rawptr) {
        memcpy(dst, to_rawptr(&self), sizeof::<i32>() as i64);
    }
}

public class RenderPass {
    public kind: RenderPassKind;
    public first_command: i32;
    public command_count: i32;
    public draw_count: i32;
    public segment_count: i32;
    public target_id: i32;
    public clear: bool;

    public static fn create(kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, clear: bool) -> RenderPass {
        return RenderPass.createForTarget(kind, first_command, command_count, draw_count, segment_count, -1, clear);
    }

    public static fn createForTarget(kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, target_id: i32, clear: bool) -> RenderPass {
        return RenderPass { kind: kind, first_command: first_command, command_count: command_count, draw_count: draw_count, segment_count: segment_count, target_id: target_id, clear: clear };
    }

    public fn clone() -> RenderPass {
        var out: RenderPass;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderPass>() as i64);
        return out;
    }

    public fn writeKindValue(dst: rawptr) {
        memcpy(dst, to_rawptr(&self), sizeof::<i32>() as i64);
    }

    public fn writeTargetId(dst: rawptr) {
        memcpy(dst, to_rawptr(&self.target_id), sizeof::<i32>() as i64);
    }

    public fn writeDrawCount(dst: rawptr) {
        memcpy(dst, to_rawptr(&self.draw_count), sizeof::<i32>() as i64);
    }
}

public class RenderPassDependency {
    public from_pass: i32;
    public to_pass: i32;
    public resource_index: i32;

    public static fn create(from_pass: i32, to_pass: i32, resource_index: i32) -> RenderPassDependency {
        return RenderPassDependency { from_pass: from_pass, to_pass: to_pass, resource_index: resource_index };
    }

    public fn clone() -> RenderPassDependency {
        var out: RenderPassDependency;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<RenderPassDependency>() as i64);
        return out;
    }
}

public class RenderPlan {
    public passes: Vec<RenderPass>;
    public resources: Vec<RenderResource>;
    public dependencies: Vec<RenderPassDependency>;
    public command_count: i32;
    public draw_count: i32;
    public solid_draw_count: i32;
    public textured_draw_count: i32;
    public segment_count: i32;
    public solid_segment_count: i32;
    public textured_segment_count: i32;
    public texture_page_count: i32;
    public clip_change_count: i32;
    public clip_path_count: i32;
    public clip_path_cpu_coverage_count: i32;
    public clip_path_bounds_fallback_count: i32;
    public transform_change_count: i32;
    public pipeline_change_count: i32;
    public default_pipeline_change_count: i32;
    public custom_pipeline_change_count: i32;
    public unique_pipeline_count: i32;
    public last_pipeline_id: i32;
    public layer_change_count: i32;
    public layer_pass_count: i32;
    public max_layer_depth: i32;
    public estimated_solid_vertices: i32;
    public estimated_textured_vertices: i32;
    public clip_expansion_vertex_reserve: i32;
    public clip_mask_vertex_capacity_estimate: i32;
    public clip_stencil_target_bytes_estimate: u64;
    public layer_composite_vertex_reserve: i32;
    public solid_vertex_capacity_estimate: i32;
    public textured_vertex_capacity_estimate: i32;
    public has_clear: bool;

    public static fn empty() -> RenderPlan {
        return RenderPlan {
            passes: Vec::<RenderPass>.new(),
            resources: Vec::<RenderResource>.new(),
            dependencies: Vec::<RenderPassDependency>.new(),
            command_count: 0,
            draw_count: 0,
            solid_draw_count: 0,
            textured_draw_count: 0,
            segment_count: 0,
            solid_segment_count: 0,
            textured_segment_count: 0,
            texture_page_count: 0,
            clip_change_count: 0,
            clip_path_count: 0,
            clip_path_cpu_coverage_count: 0,
            clip_path_bounds_fallback_count: 0,
            transform_change_count: 0,
            pipeline_change_count: 0,
            default_pipeline_change_count: 0,
            custom_pipeline_change_count: 0,
            unique_pipeline_count: 0,
            last_pipeline_id: -1,
            layer_change_count: 0,
            layer_pass_count: 0,
            max_layer_depth: 0,
            estimated_solid_vertices: 0,
            estimated_textured_vertices: 0,
            clip_expansion_vertex_reserve: 0,
            clip_mask_vertex_capacity_estimate: 0,
            clip_stencil_target_bytes_estimate: 0 as u64,
            layer_composite_vertex_reserve: 0,
            solid_vertex_capacity_estimate: 0,
            textured_vertex_capacity_estimate: 0,
            has_clear: false
        };
    }

    public fn addResource(&mut self, kind: RenderResourceKind, bytes: u64) {
        self.resources.push(RenderResource.create(kind, bytes));
    }

    public fn addPassForTarget(&mut self, kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, target_id: i32, clear: bool) {
        self.passes.push(RenderPass.createForTarget(kind, first_command, command_count, draw_count, segment_count, target_id, clear));
    }

    public fn addResourceForPage(&mut self, kind: RenderResourceKind, bytes: u64, page_id: i32) {
        self.resources.push(RenderResource.createForPage(kind, bytes, page_id));
    }

    public fn addResourceForPageLifetime(&mut self, kind: RenderResourceKind, bytes: u64, page_id: i32, first_pass: i32, last_pass: i32) {
        self.resources.push(RenderResource.createForPageLifetime(kind, bytes, page_id, first_pass, last_pass));
    }

    public fn addDependency(&mut self, from_pass: i32, to_pass: i32, resource_index: i32) {
        self.dependencies.push(RenderPassDependency.create(from_pass, to_pass, resource_index));
    }

    public static fn commandMaterialValue(kv: i32) -> i32 {
        if (kv == 13) { return 2; }
        if (kv == 2) { return 1; }
        if (kv == 3) { return 1; }
        if (kv == 8) { return 1; }
        if (kv == 9) { return 1; }
        if (kv == 10) { return 1; }
        if (kv == 4) { return 1; }
        if (kv == 5) { return 1; }
        return 0;
    }

    public static fn commandMaterial(kv: i32) -> RenderMaterialKind {
        if (kv == 13) { return RenderMaterialKind.textured(); }
        if (kv == 2) { return RenderMaterialKind.solid(); }
        if (kv == 3) { return RenderMaterialKind.solid(); }
        if (kv == 8) { return RenderMaterialKind.solid(); }
        if (kv == 9) { return RenderMaterialKind.solid(); }
        if (kv == 10) { return RenderMaterialKind.solid(); }
        if (kv == 4) { return RenderMaterialKind.solid(); }
        if (kv == 5) { return RenderMaterialKind.solid(); }
        return RenderMaterialKind.none();
    }

    public static fn commandVertexEstimate(kv: i32) -> i32 {
        if (kv == 13) { return 6; }
        if (kv == 2) { return 6; }
        if (kv == 3) { return 96; }
        if (kv == 8) { return 3; }
        if (kv == 9) { return 6; }
        if (kv == 10) { return 6; }
        if (kv == 4) { return 6; }
        if (kv == 5) { return 24; }
        return 0;
    }

    public static fn commandHasCpuClipPathCoverage(kv: i32) -> bool {
        if (kv == 2) { return true; }
        if (kv == 3) { return true; }
        if (kv == 8) { return true; }
        if (kv == 9) { return true; }
        if (kv == 10) { return true; }
        if (kv == 13) { return true; }
        if (kv == 4) { return true; }
        if (kv == 5) { return true; }
        return false;
    }

    @[borrow_args]
    public static fn matchingLayerPop(graph: RenderGraph, push_index: i32) -> i32 {
        var depth: i32 = 0;
        var i: i32 = push_index;
        while (i < graph.command_count) {
            let command = graph.commandAt(i);
            var ck: i32 = 0;
            memcpy(to_rawptr(&ck), to_rawptr(&command), 4);
            if (ck == 14) {
                depth = depth + 1;
            }
            if (ck == 15) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    @[borrow_args]
    public static fn rangeDrawCount(graph: RenderGraph, first: i32, count: i32) -> i32 {
        var out: i32 = 0;
        var i: i32 = first;
        let end: i32 = first + count;
        while (i < end && i < graph.command_count) {
            let command = graph.commandAt(i);
            var ck: i32 = 0;
            memcpy(to_rawptr(&ck), to_rawptr(&command), 4);
            let mv = RenderPlan.commandMaterialValue(ck);
            if (mv != 0) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public static fn rangeSegmentCount(graph: RenderGraph, first: i32, count: i32) -> i32 {
        return count;
    }

    @[borrow_args]
    public static fn build(graph: RenderGraph) -> Result<RenderPlan, Error> {
        match (graph.validate()) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        return Ok(RenderPlan.empty());
    }

    public fn passCount() -> i32 {
        return 0;
    }

    public fn resourceCount() -> i32 {
        return 0;
    }

    public fn dependencyCount() -> i32 {
        return 0;
    }

    public fn passAt(index: i32) -> RenderPass {
        var out: RenderPass;
        memcpy(to_rawptr(&out), self.passes.data + ((index as i64) * sizeof::<RenderPass>()), sizeof::<RenderPass>() as i64);
        return out;
    }

    public fn resourceAt(index: i32) -> RenderResource {
        var out: RenderResource;
        memcpy(to_rawptr(&out), self.resources.data + ((index as i64) * sizeof::<RenderResource>()), sizeof::<RenderResource>() as i64);
        return out;
    }

    public fn dependencyAt(index: i32) -> RenderPassDependency {
        return self.dependencies.get(index as i64);
    }

    public fn dependencyFromPass(index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).from_pass;
    }

    public fn dependencyToPass(index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).to_pass;
    }

    public fn dependencyResourceIndex(index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).resource_index;
    }

    public fn passSegmentCount(index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        let pass = self.passes.get(index as i64);
        return pass.segment_count;
    }

    public fn passFirstCommand(index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        let pass = self.passes.get(index as i64);
        return pass.first_command;
    }

    public fn passCommandCount(index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 8);
    }

    public fn passDrawCount(index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 12);
    }

    public fn passClears(index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let pass = self.passes.get(index as i64);
        var flag: i32 = 0;
        memcpy(to_rawptr(&flag), to_rawptr(&pass.clear), 1);
        if (flag != 0) { return true; }
        return false;
    }

    public fn passIsColor(index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 1) { return true; }
        return false;
    }

    public fn passIsLayer(index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 2) { return true; }
        return false;
    }

    public fn passIsComposite(index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 3) { return true; }
        return false;
    }

    public fn passTargetId(index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return loadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 20);
    }

    public fn resourceIsKind(index: i32, kind: RenderResourceKind) -> bool {
        if (index < 0 || index >= self.resources.len as i32) { return false; }
        let av = loadI32(self.resources.data + ((index as i64) * sizeof::<RenderResource>()));
        let bv = loadI32(to_rawptr(&kind));
        if (av == bv) {
            return true;
        }
        return false;
    }

    public fn resourceEstimatedBytes(index: i32) -> u64 {
        if (index < 0 || index >= self.resources.len as i32) { return 0 as u64; }
        let resource = self.resources.get(index as i64);
        var bytes: u64 = 0 as u64;
        resource.writeEstimatedBytes(to_rawptr(&bytes));
        return bytes;
    }

    public fn resourceCountByKind(kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var av: i32 = 0;
            var bv: i32 = 0;
            memcpy(to_rawptr(&av), to_rawptr(&resource), sizeof::<i32>() as i64);
            memcpy(to_rawptr(&bv), to_rawptr(&kind), sizeof::<i32>() as i64);
            if (av == bv) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn resourceEstimatedBytesByKind(kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var av: i32 = 0;
            var bv: i32 = 0;
            memcpy(to_rawptr(&av), to_rawptr(&resource), sizeof::<i32>() as i64);
            memcpy(to_rawptr(&bv), to_rawptr(&kind), sizeof::<i32>() as i64);
            if (av == bv) {
                bytes = bytes + resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn totalResourceEstimatedBytes() -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            bytes = bytes + resource.estimated_bytes;
            i = i + 1;
        }
        return bytes;
    }

    public fn activeResourceEstimatedBytesAtPass(pass_index: i32) -> u64 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.first_pass <= pass_index && resource.last_pass >= pass_index) {
                bytes = bytes + resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn activeResourceCountAtPass(pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.first_pass <= pass_index && resource.last_pass >= pass_index) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn resourceActiveAtPass(resource_index: i32, pass_index: i32) -> bool {
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return false; }
        let resource = self.resources.get(resource_index as i64);
        return resource.first_pass <= pass_index && resource.last_pass >= pass_index;
    }

    public fn peakResourceEstimatedBytes() -> u64 {
        var peak: u64 = 0 as u64;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let bytes = self.activeResourceEstimatedBytesAtPass(pass_i);
            if (bytes > peak) { peak = bytes; }
            pass_i = pass_i + 1;
        }
        return peak;
    }

    public fn peakResourceCount() -> i32 {
        var peak: i32 = 0;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let count = self.activeResourceCountAtPass(pass_i);
            if (count > peak) { peak = count; }
            pass_i = pass_i + 1;
        }
        return peak;
    }

    public fn peakResourcePass() -> i32 {
        if (self.passes.len as i32 == 0) { return -1; }
        var peak: u64 = 0 as u64;
        var peak_pass: i32 = 0;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let bytes = self.activeResourceEstimatedBytesAtPass(pass_i);
            if (pass_i == 0 || bytes > peak) {
                peak = bytes;
                peak_pass = pass_i;
            }
            pass_i = pass_i + 1;
        }
        return peak_pass;
    }

    public fn resourcePageId(index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.page_id;
    }

    public fn resourceFirstPass(index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.first_pass;
    }

    public fn resourceLastPass(index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.last_pass;
    }

    public fn resourceLifetimeSpan(index: i32) -> i32 {
        if (!self.resourceLifetimeValid(index)) { return 0; }
        let resource = self.resources.get(index as i64);
        var first: i32 = 0;
        var last: i32 = 0;
        resource.writeFirstPass(to_rawptr(&first));
        resource.writeLastPass(to_rawptr(&last));
        return last - first + 1;
    }

    public fn maxResourceLifetimeSpan() -> i32 {
        var max_span: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let span = self.resourceLifetimeSpan(i);
            if (span > max_span) { max_span = span; }
            i = i + 1;
        }
        return max_span;
    }

    public fn totalResourceLifetimeSpan() -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            total = total + self.resourceLifetimeSpan(i);
            i = i + 1;
        }
        return total;
    }

