use std.collections;

class Holder {
    public items: Vec<i32>;

    public static fn create() -> Holder {
        var items = Vec::<i32>.new();
        items.push(7);
        return Holder { items: items };
    }

    public fn first(&self) -> i32 {
        return self.items.get(0);
    }
}

fn main() -> i32 {
    let h = Holder.create();
    if (h.first() == 7) { return 0; }
    return 1;
}
