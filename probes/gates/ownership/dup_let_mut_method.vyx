class ViewLike {
    public n: i32;

    public fn dup(&self) -> ViewLike {
        return ViewLike { n: self.n };
    }

    public fn bump(&mut self) {
        self.n = self.n + 1;
    }
}

fn main() -> i32 {
    let v = ViewLike { n: 1 };
    v.bump();
    if (v.n != 2) { return 1; }
    return 0;
}
