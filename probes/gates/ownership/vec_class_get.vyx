use std.collections;

class Glyph {
    public cluster: u32;
    public x: i32;

    public static fn create(cluster: u32, x: i32) -> Glyph {
        return Glyph { cluster: cluster, x: x };
    }

    public fn clone() -> Glyph {
        return Glyph.create(self.cluster, self.x);
    }
}

class Holder {
    public glyphs: Vec<Glyph>;

    public static fn create() -> Holder {
        var glyphs = Vec::<Glyph>.new();
        glyphs.push(Glyph.create(1 as u32, 4));
        return Holder { glyphs: glyphs };
    }

    public fn at(&self, index: i32) -> Glyph {
        return self.glyphs.get(index as i64);
    }

    public fn clusterAt(&self, index: i32) -> u32 {
        return self.at(index).cluster;
    }
}

fn main() -> i32 {
    let h = Holder.create();
    if (h.clusterAt(0) == 1 as u32) { return 0; }
    return 1;
}
