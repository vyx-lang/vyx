use std.collections;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

public class ShapedGlyph {
    public font_id: u32;
    public glyph_index: u32;
    public cluster: u32;
    public x: i32;
    public y: i32;
    public advance_x: i32;
    public advance_y: i32;
    public offset_x: i32;
    public offset_y: i32;

    public static fn create(font_id: u32, glyph_index: u32, cluster: u32, x: i32, y: i32, advance_x: i32, advance_y: i32, offset_x: i32, offset_y: i32) -> ShapedGlyph {
        return ShapedGlyph {
            font_id: font_id,
            glyph_index: glyph_index,
            cluster: cluster,
            x: x,
            y: y,
            advance_x: advance_x,
            advance_y: advance_y,
            offset_x: offset_x,
            offset_y: offset_y
        };
    }

    public fn clone() -> ShapedGlyph {
        var out: ShapedGlyph;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<ShapedGlyph>() as i64);
        return out;
    }
}

public class TextLayout {
    public glyphs: Vec<ShapedGlyph>;
    public advance_x: i32;
    public advance_y: i32;

    public static fn create() -> TextLayout {
        return TextLayout { glyphs: Vec::<ShapedGlyph>.new(), advance_x: 0, advance_y: 0 };
    }

    public fn pushGlyph(mut self, glyph: ShapedGlyph) -> TextLayout {
        self.glyphs.push(glyph);
        return self;
    }

    public fn glyphCount(&self) -> i32 {
        return self.glyphs.len as i32;
    }

    public fn glyphAt(&self, index: i32) -> ShapedGlyph {
        return self.glyphs.get(index as i64);
    }

    public fn firstGlyphIndexForCluster(&self, cluster: u32) -> i32 {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).cluster == cluster) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn lastGlyphIndexForCluster(&self, cluster: u32) -> i32 {
        var out: i32 = -1;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).cluster == cluster) { out = i; }
            i = i + 1;
        }
        return out;
    }

    public fn clustersHaveContiguousRuns(&self) -> bool {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster;
            let first = self.firstGlyphIndexForCluster(cluster);
            let last = self.lastGlyphIndexForCluster(cluster);
            var j = first;
            while (j <= last) {
                if (self.glyphAt(j).cluster != cluster) { return false; }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }
}

fn main() -> i32 {
    var layout = TextLayout.create();
    layout = layout.pushGlyph(ShapedGlyph.create(0 as u32, 1 as u32, 0 as u32, 0, 0, 10, 0, 0, 0));
    if (layout.clustersHaveContiguousRuns()) { return 0; }
    return 1;
}
