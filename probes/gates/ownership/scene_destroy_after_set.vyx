use std.collections;

class World {
    public xs: Vec<i32>;

    public static fn create() -> World {
        return World { xs: Vec::<i32>.new() };
    }

    public fn dup(&self) -> World {
        var out = World.create();
        var i: i64 = 0;
        while (i < self.xs.len) {
            out.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }
}

class Scene {
    public world: World;

    public static fn create() -> Scene {
        return Scene { world: World.create() };
    }

    public fn setWorld(&self, world: World) -> Scene {
        var bound = world.dup();
        return Scene { world: bound.dup() };
    }
}

fn sceneFrom() -> Scene {
    var world = World.create();
    world.xs.push(7);
    var scene = Scene.create().setWorld(world);
    world.destroy();
    return scene;
}

fn main() -> i32 {
    let s = sceneFrom();
    if (s.world.xs.len != 1) { return 1; }
    if (s.world.xs.get(0) != 7) { return 2; }
    return 0;
}
