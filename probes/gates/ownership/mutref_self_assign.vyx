class Nav {
    public n: i32;

    public fn dup(&self) -> Nav {
        return Nav { n: self.n };
    }

    public fn record(&self, n: i32) -> Nav {
        return Nav { n: n };
    }

    public fn pop(&mut self) {
        self = self.record(self.n + 1);
    }
}

fn main() -> i32 {
    var n = Nav { n: 1 };
    n.pop();
    if (n.n != 2) { return 1; }
    return 0;
}
