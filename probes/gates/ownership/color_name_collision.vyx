public class Color {
    public r: f32;
    public g: f32;
    public b: f32;
    public a: f32;

    public static fn rgba(r: f32, g: f32, b: f32, a: f32) -> Color {
        return Color { r: r, g: g, b: b, a: a };
    }

    public fn clone(&self) -> Color {
        return Color.rgba(self.r, self.g, self.b, self.a);
    }
}

public class RenderPassKind {
    public value: i32;

    public static fn color() -> RenderPassKind { return RenderPassKind { value: 1 }; }
    public static fn layer() -> RenderPassKind { return RenderPassKind { value: 2 }; }

    public fn clone(&self) -> RenderPassKind {
        return RenderPassKind { value: self.value };
    }
}

fn main() -> i32 {
    let k = RenderPassKind.color();
    let c = Color.rgba(1.0, 0.0, 0.0, 1.0);
    let d = c.clone();
    let k2 = k.clone();
    if (k2.value == 1 && d.r > 0.5) { return 0; }
    return 1;
}
