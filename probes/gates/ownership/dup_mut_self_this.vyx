class ViewLike {
    public n: i32;

    public fn dup(&self) -> ViewLike {
        return ViewLike { n: self.n };
    }

    public fn destroy(&mut self) {}

    public fn applyStyle(mut self, x: i32) -> ViewLike {
        self.n = x;
        return self;
    }

    public fn append(&mut self) -> i32 {
        self.applyStyle(2);
        return self.n;
    }

    public fn boxNode(mut self) -> i32 {
        self.applyStyle(3);
        return self.n;
    }
}

fn main() -> i32 {
    var v = ViewLike { n: 1 };
    if (v.append() != 2) { return 1; }
    if (v.n != 2) { return 2; }
    if (v.boxNode() != 3) { return 3; }
    if (v.n != 3) { return 4; }
    return 0;
}
