class Cell {
    public n: i32;

    public fn get(&self) -> i32 {
        return self.n;
    }

    public fn bump(&mut self) {
        self.n = self.n + 1;
    }

    public fn take(own self) -> i32 {
        return self.n;
    }

    public fn take_mut(mut self) -> i32 {
        self.n = self.n + 1;
        return self.n;
    }

    public fn via_this(self) -> i32 {
        self.bump();
        return self.get();
    }
}

fn via_mutref(c: &mut Cell) {
    c.bump();
}

fn via_shared(c: &Cell) -> i32 {
    return c.get();
}

fn consume_owned(c: Cell) -> i32 {
    return c.take();
}

fn main() -> i32 {
    var x = Cell { n: 3 };
    if (via_shared(&x) != 3) { return 1; }
    via_mutref(&mut x);
    if (x.n != 4) { return 2; }
    if (x.via_this() != 5) { return 3; }
    let mut y = Cell { n: 10 };
    y.bump();
    if (y.get() != 11) { return 4; }
    let v = consume_owned(y);
    if (v != 11) { return 5; }
    var z = Cell { n: 7 };
    let w = z.take_mut();
    if (w != 8) { return 6; }
    return 0;
}
