use std.collections;

class Node {
    public xs: Vec<i32>;

    public static fn create() -> Node {
        var xs = Vec::<i32>.new();
        xs.push(7);
        return Node { xs: xs };
    }

    public fn dup(&self) -> Node {
        var out = Node { xs: Vec::<i32>.new() };
        var i: i64 = 0;
        while (i < self.xs.len) {
            out.xs.push(self.xs.get(i));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.xs.destroy();
    }
}

fn main() -> i32 {
    var v = Vec::<Node>.new();
    v.push(Node.create());
    let a = v.get(0);
    if (a.xs.len != 1) { return 1; }
    if (a.xs.get(0) != 7) { return 2; }
    let b = v.get(0);
    if (b.xs.len != 1) { return 3; }
    if (b.xs.get(0) != 7) { return 4; }
    a.destroy();
    if (v.get(0).xs.len != 1) { return 5; }
    return 0;
}
