use std.collections;
use std.string;

// A borrowed indexed foreach must not byte-copy an owning element.  Until
// generic Clone lowering accepts an element address, the compiler must reject
// this program instead of producing a second owner for the same storage.
fn main() -> i32 {
    var values = Vec::<String>::new();
    values.push(String.from("owned"));
    for (value in &values) {
        print(value);
    }
    return 0;
}
