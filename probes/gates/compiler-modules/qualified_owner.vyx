module module_contract.extensions;
use module_contract.counter;

class Counter {
    public value: i32
}

impl Counter {
    public fn local_only(self) -> i32 {
        return self.value;
    }
}

impl module_contract.counter.Counter {
    public fn extension(self) -> i32 {
        return self.value;
    }
}

impl i32 {
    public fn double_value(self) -> i32 {
        return self * 2;
    }
}
