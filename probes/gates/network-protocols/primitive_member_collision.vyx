module probes.network_primitive_collision;

// Primitive builtins retain their receiver identity when an imported/user
// method has the same name and explicit argument count.
class Version {
    major: i32;
    public fn toString() -> string { return "version"; }
}

class Label {
    value: i32;
    public fn to_string() -> string { return "label"; }
}

fn main() -> i32 {
    let count: i32 = 10;
    let wide: i64 = 5000000000;
    let truth: bool = true;
    let version = Version { major: 1 };
    let label = Label { value: 2 };
    if (count.toString() != "10") { return 1; }
    if (wide.toString() != "5000000000") { return 2; }
    if (truth.toString() != "true") { return 3; }
    if (version.toString() != "version") { return 4; }
    if (label.to_string() != "label") { return 5; }
    print("primitive member identity ok");
    return 0;
}
