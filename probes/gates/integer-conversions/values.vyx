use std.collections;

class Packet { public value: i8; }
fn widen(value: i8) -> i64 { return value; }
fn byte(value: i8) -> i8 { return value; }

fn main() -> i32 {
    let high: i8 = 127;
    let low: i8 = -128;
    let unsigned: u8 = 255;
    if (widen(high) != 127 || widen(low) != -128 || unsigned != 255 || byte(127) != 127) { return 1; }
    let wide: i32 = 300;
    let narrowed: i8 = wide as i8;
    if (narrowed != 44) { return 2; }
    var packet = Packet { value: 1 };
    packet.value = 127;
    var array: [i8; 2] = [1, 2];
    array[0] = 127;
    var value: i8 = 1;
    let pointer: &mut i8 = &mut value;
    *pointer = 127;
    var vec = Vec::<i8>.new();
    vec.push(1);
    vec[0] = 127;
    if (packet.value != 127 || array[0] != 127 || value != 127 || vec.get(0) != 127) { return 3; }
    print("integer-conversions=ok");
    return 0;
}
