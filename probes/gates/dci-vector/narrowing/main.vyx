@[dci_import("../vector.dcib")]
extern "dci" {
    @[dci_list_init(true)]
    class std.vector<T> {
        vector();
        ~vector();
        public fn size() const -> u64;
    };
}

fn main() -> i32 {
    // The original C++ brace initializer must reject double -> int narrowing.
    var a = std.vector<i32>{1.5};
    return a.size() as i32;
}
