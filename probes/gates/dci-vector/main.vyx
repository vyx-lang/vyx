@[dci_import("vector.dcib")]
extern "dci" {
    @[dci_list_init(true)]
    class std.vector<T> {
        vector();
        ~vector();
        public fn push_back(value: &T);
        public fn size() const -> u64;
        public fn capacity() const -> u64;
        public fn reserve(n: u64);
        public fn clear();
        public fn pop_back();
        public fn at(n: u64) -> &mut T;
        public fn data() -> *T;
    };
}

extern "C" {
    fn vector_check_i32(value: rawptr, stage: i32, seed: i32) -> i32;
    fn vector_check_f64(value: rawptr, stage: i32, seed: i32) -> i32;
    fn vector_note_i32(value: rawptr) -> i32;
    fn vector_note_f64(value: rawptr) -> i32;
    fn vector_harness(stress: rawptr, throwing: rawptr) -> i32;
}

fn stress_i32(seed: i32) -> i32 {
    var a = std.vector<i32>{1,2,3,4,5};
    if (vector_check_i32(a as rawptr, 0, seed) != 0) { return 10; }
    a.reserve(32);
    if (a.capacity() < 32) { return 11; }
    if (vector_check_i32(a as rawptr, 1, seed) != 0) { return 12; }
    for (i in 0..4096) {
        let value: i32 = seed + i * 3;
        a.push_back(&value);
    }
    if (a.size() != 4101) { return 13; }
    if (vector_check_i32(a as rawptr, 2, seed) != 0) { return 14; }
    var j: u64 = 0;
    while (j < a.size()) {
        let cell = a.at(j);
        *cell = *cell + seed + 7;
        j = j + 17;
    }
    var first = a.data();
    *first = *first + 11;
    if (vector_check_i32(a as rawptr, 3, seed) != 0) { return 15; }
    for (i in 0..1024) { a.pop_back(); }
    if (vector_check_i32(a as rawptr, 4, seed) != 0) { return 16; }
    a.clear();
    if (a.size() != 0) { return 17; }
    if (vector_check_i32(a as rawptr, 5, seed) != 0) { return 18; }
    for (i in 0..128) {
        let value: i32 = seed - i;
        a.push_back(&value);
    }
    if (vector_check_i32(a as rawptr, 6, seed) != 0) { return 19; }
    return 0;
}

fn stress_f64(seed: i32) -> i32 {
    var a = std.vector<f64>{0.5,1.5,2.5};
    if (vector_check_f64(a as rawptr, 0, seed) != 0) { return 20; }
    a.reserve(16);
    if (a.capacity() < 16) { return 21; }
    if (vector_check_f64(a as rawptr, 1, seed) != 0) { return 22; }
    for (i in 0..2048) {
        let value: f64 = (seed as f64) + (i as f64) * 0.25;
        a.push_back(&value);
    }
    if (a.size() != 2051) { return 23; }
    if (vector_check_f64(a as rawptr, 2, seed) != 0) { return 24; }
    var j: u64 = 0;
    while (j < a.size()) {
        let cell = a.at(j);
        *cell = *cell + (seed as f64) + 0.5;
        j = j + 19;
    }
    var first = a.data();
    *first = *first + 0.25;
    if (vector_check_f64(a as rawptr, 3, seed) != 0) { return 25; }
    for (i in 0..512) { a.pop_back(); }
    if (vector_check_f64(a as rawptr, 4, seed) != 0) { return 26; }
    a.clear();
    if (a.size() != 0) { return 27; }
    if (vector_check_f64(a as rawptr, 5, seed) != 0) { return 28; }
    for (i in 0..64) {
        let value: f64 = (seed as f64) - (i as f64) * 0.5;
        a.push_back(&value);
    }
    if (vector_check_f64(a as rawptr, 6, seed) != 0) { return 29; }
    return 0;
}

fn stress(seed: i32) -> i32 {
    let int_result = stress_i32(seed);
    if (int_result != 0) { return int_result; }
    return stress_f64(seed);
}

fn throwing(mode: i32) -> i32 {
    var a = std.vector<i32>{1,2,3,4,5};
    var b = std.vector<f64>{0.5,1.5,2.5};
    if (vector_note_i32(a as rawptr) != 0) { return 30; }
    if (vector_note_f64(b as rawptr) != 0) { return 31; }
    // Invoke the original standard library bounds check and exception type.
    if (mode == 0) {
        let invalid = a.at(a.size());
        return *invalid;
    }
    let invalid = b.at(b.size());
    return *invalid as i32;
}

fn main() -> i32 {
    let result = vector_harness(stress as rawptr, throwing as rawptr);
    if (result != 0) { return result; }
    print("dci_vector OK");
    return 0;
}
