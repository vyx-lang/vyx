// Regression: match is a value expression and supports enum payload binds.
enum Maybe {
    None,
    Some(i32),
}

var subject_calls: i32 = 0;

fn make_subject() -> Maybe {
    subject_calls = subject_calls + 1;
    return Maybe.Some(41);
}

fn classify(x: i32) -> i32 {
    return match x {
        case 0 => 10,
        default => 20,
    };
}

fn classify_payload(m: Maybe) -> i32 {
    return match (m) {
        case Some(v) => v + 1,
        case None => 0,
    };
}

fn nested(m: Maybe) -> i32 {
    return match m {
        case Some(v) => match v {
            case 41 => 1,
            default => 2,
        },
        case None => 3,
    };
}

fn block_tail(m: Maybe) -> i32 {
    return match (m) {
        case Some(v) => { let x = v + 1; x; }
        case None => { 0; }
    };
}

fn guarded(m: Maybe) -> i32 {
    return match (m) {
        case Some(v) if v > 0 => v,
        case Some(v) => 0,
        default => -1,
    };
}

fn return_from_arm(m: Maybe) -> i32 {
    return match m {
        case Some(v) => { return v + 1; }
        case None => { return 0; }
    };
}

fn main() -> i32 {
    if (classify(0) != 10) { return 1; }
    if (classify(7) != 20) { return 2; }
    if (classify_payload(Maybe.Some(41)) != 42) { return 3; }
    if (classify_payload(Maybe.None) != 0) { return 4; }
    if (nested(Maybe.Some(41)) != 1) { return 5; }
    if (nested(Maybe.Some(7)) != 2) { return 6; }
    if (nested(Maybe.None) != 3) { return 7; }
    if (block_tail(Maybe.Some(4)) != 5) { return 8; }
    if (block_tail(Maybe.None) != 0) { return 9; }
    if (guarded(Maybe.Some(2)) != 2) { return 10; }
    if (guarded(Maybe.Some(0)) != 0) { return 11; }
    if (guarded(Maybe.None) != -1) { return 12; }
    if (return_from_arm(Maybe.Some(4)) != 5) { return 13; }
    if (return_from_arm(Maybe.None) != 0) { return 14; }
    let one_shot = match make_subject() {
        case Some(v) => v + 1,
        case None => -1,
    };
    if (one_shot != 42) { return 15; }
    if (subject_calls != 1) { return 16; }
    if ((match (Maybe.Some(6)) { case Some(v) => v, default => 0, }) + 1 != 7) { return 17; }
    return 0;
}
