extern "C" { fn native_duplicate(value: i32) -> i32; }

@[export_name("native_duplicate")]
public fn first_definition(value: i32) -> i32 { return value + 100; }

@[export_name("native_duplicate")]
public fn second_definition(value: i32) -> i32 { return value + 7; }

fn main() -> i32 { return native_duplicate(35); }
