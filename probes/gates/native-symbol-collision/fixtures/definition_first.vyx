module native_symbol_producer;

@[export_name("native_shared")]
public fn native_definition(value: i32) -> i32 { return value + 7; }

extern "C" {
    fn native_shared(value: i32) -> i32;
    @[link_name("native_shared")]
    fn native_shared_alias(value: i32) -> i32;
}

@[export_name("native_call_both")]
public fn call_both(value: i32) -> i32 {
    return native_shared(value) + native_shared_alias(value);
}
