fn identity<T>(value: T) -> T { return value; }
fn left(value: i32) -> i32 { return identity::<i32>(value); }
fn right(value: i32) -> i32 { return identity::<i32>(value); }

fn main() -> i32 {
    if (left(41) + right(1) != 42) { return 1; }
    print("repeated closed generic PASS");
    return 0;
}
