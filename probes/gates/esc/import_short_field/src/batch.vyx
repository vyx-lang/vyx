module Probe.Batch;

use Probe.Types;

public class SolidBatch {
    public dummy: i32;

    public static fn create() -> SolidBatch {
        return SolidBatch { dummy: 0 };
    }

    public fn addUnitCircle(&mut self) -> i32 {
        let circle = Circle.xy(1.0, 2.0, 3.0);
        let center = Point.xy(circle.x, circle.y);
        if (center.x > 0.0) { return 0; }
        return 1;
    }
}
