module Probe.Types;

public fn helper() -> i32 {
    return 0;
}

public class Point {
    public x: f32;
    public y: f32;

    public static fn xy(x: f32, y: f32) -> Point {
        return Point { x: x, y: y };
    }
}

public class Circle {
    public x: f32;
    public y: f32;
    public radius: f32;

    public static fn xy(x: f32, y: f32, radius: f32) -> Circle {
        return Circle { x: x, y: y, radius: radius };
    }
}
