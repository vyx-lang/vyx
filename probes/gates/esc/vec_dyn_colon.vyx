use std.collections;

interface Comp {
    fn id(&self) -> i32;
}

class ViewComp : Comp {
    public n: i32;

    public fn id(&self) -> i32 {
        return self.n;
    }
}

fn main() -> i32 {
    var items = Vec::<dyn Comp>.new();
    items.push(ViewComp { n: 1 });
    return items.get(0).id() - 1;
}
