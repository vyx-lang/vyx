module Probe.UI;

use Canvas = Probe.Nut.Canvas.Canvas;
use SpriteBatch = Probe.Nut.Atlas.SpriteBatch;
use TextLayout = Probe.Nut.Text.TextLayout;

fn main() -> i32 {
    let batch = SpriteBatch {};
    if (Canvas.takeSprite(&batch) != 9) { return 1; }
    let layout = TextLayout.sample();
    if (Canvas.takeGlyph(&layout) != 16) { return 2; }
    return 0;
}
