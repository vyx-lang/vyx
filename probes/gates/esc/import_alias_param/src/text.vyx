module Probe.Nut.Text;

public class ShapedGlyph {
    public font_id: u32;
    public glyph_index: u32;
    public x: i32;
}

public class TextLayout {
    public advance_x: i32;

    public static fn sample() -> TextLayout {
        return TextLayout { advance_x: 4 };
    }

    public fn glyphCount(&self) -> i32 {
        return 1;
    }

    public fn glyphAt(&self, index: i32) -> ShapedGlyph {
        return ShapedGlyph {
            font_id: 7 as u32,
            glyph_index: 3 as u32,
            x: 2 + index
        };
    }
}
