module Probe.Nut.Atlas;

public class Sprite {
    public tag: i32;

    public static fn create(tag: i32) -> Sprite {
        return Sprite { tag: tag };
    }
}

public class SpriteBatch {
    public fn spriteCount(&self) -> i32 {
        return 1;
    }

    public fn spriteAt(&self, index: i32) -> Sprite {
        return Sprite.create(9 + index);
    }
}
