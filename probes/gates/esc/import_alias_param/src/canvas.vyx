module Probe.Nut.Canvas;

use Sprite = Probe.Nut.Atlas.Sprite;
use SpriteBatch = Probe.Nut.Atlas.SpriteBatch;
use TextLayout = Probe.Nut.Text.TextLayout;

public class Canvas {
    public static fn takeSprite(batch: &SpriteBatch) -> i32 {
        return batch.spriteAt(0).tag;
    }

    public static fn takeGlyph(layout: &TextLayout) -> i32 {
        let shaped = layout.glyphAt(0);
        return (shaped.font_id as i32) + (shaped.glyph_index as i32) + shaped.x + layout.advance_x;
    }
}
