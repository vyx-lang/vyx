module F32Dll;

public fn give() -> f32 {
    return 1280.0;
}

public fn take(x: f32) -> i32 {
    return x as i32;
}

public fn roundtrip(x: f32) -> f32 {
    return x;
}

public class Fat {
    public a: string;
    public b: string;
    public c: string;
    public d: string;
    public n: i32;

    public static fn create() -> Fat {
        return Fat { a: "a", b: "b", c: "c", d: "d", n: 1 };
    }
}

public class Tree {
    public w: f32;
    public h: f32;
    public n: i32;
    public a: string;
    public b: string;
    public c: string;
}

public class Quad {
    public x: f32;
    public y: f32;
    public w: f32;
    public h: f32;

    public static fn xywh(x: f32, y: f32, w: f32, h: f32) -> Quad {
        return Quad { x: x, y: y, w: w, h: h };
    }
}

public class Box {
    public w: f32;
    public h: f32;

    public static fn create() -> Box {
        return Box { w: 0.0, h: 0.0 };
    }

    public fn size(mut self, w: f32, h: f32) -> Box {
        self.w = w;
        self.h = h;
        return self;
    }

    @[borrow_args]
    public fn toTree(mut self, w: f32, h: f32, extra: Fat) -> Tree {
        return Tree { w: w, h: h, n: extra.n, a: extra.a, b: extra.b, c: extra.c };
    }

    public fn toTreeNoBorrow(mut self, w: f32, h: f32, extra: Fat) -> Tree {
        return Tree { w: w, h: h, n: extra.n, a: extra.a, b: extra.b, c: extra.c };
    }
}

public class Host {
    public static fn make(w: f32, h: f32) -> Box {
        return Box { w: w, h: h };
    }

    public static fn makeAfterNames(id: string, w: f32, h: f32) -> Box {
        return Box { w: w, h: h };
    }
}

public class RT {
    public w: f32;
    public h: f32;

    public static fn create(f: Fat, w: f32, h: f32) -> RT {
        return RT { w: w, h: h };
    }

    public static fn create3(f: Fat, g: Fat, k: Fat, w: f32, h: f32) -> RT {
        return RT { w: w, h: h };
    }
}
