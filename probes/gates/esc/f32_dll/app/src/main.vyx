use Box = F32Dll.Box;
use Fat = F32Dll.Fat;
use Host = F32Dll.Host;
use Quad = F32Dll.Quad;
use RT = F32Dll.RT;
use give = F32Dll.give;
use take = F32Dll.take;
use roundtrip = F32Dll.roundtrip;

fn main() -> i32 {
    let g = give();
    if ((g as i32) != 1280) { return 1; }
    if (take(352.0) != 352) { return 2; }
    let r = roundtrip(372.0);
    if ((r as i32) != 372) { return 3; }

    var b = Box.create();
    b = b.size(352.0, 372.0);
    if ((b.w as i32) != 352) { return 4; }
    if ((b.h as i32) != 372) { return 5; }

    let c = Host.make(1280.0, 720.0);
    if ((c.w as i32) != 1280) { return 6; }
    if ((c.h as i32) != 720) { return 7; }

    let d = Host.makeAfterNames("x", 1280.0, 720.0);
    if ((d.w as i32) != 1280) { return 8; }
    if ((d.h as i32) != 720) { return 9; }

    let fat = Fat.create();
    let rt = RT.create(fat, 1280.0, 720.0);
    if ((rt.w as i32) != 1280) { return 10; }
    if ((rt.h as i32) != 720) { return 11; }

    let rt3 = RT.create3(Fat.create(), Fat.create(), Fat.create(), 1280.0, 720.0);
    if ((rt3.w as i32) != 1280) { return 12; }
    if ((rt3.h as i32) != 720) { return 13; }

    var box = Box.create();
    let tree = box.toTree(1280.0, 720.0, Fat.create());
    if ((tree.w as i32) != 1280) { return 14; }
    if ((tree.h as i32) != 720) { return 15; }

    var box2 = Box.create();
    let tree2 = box2.toTreeNoBorrow(1280.0, 720.0, Fat.create());
    if ((tree2.w as i32) != 1280) { return 16; }
    if ((tree2.h as i32) != 720) { return 17; }

    let q = Quad.xywh(0.0, 0.0, 1280.0, 720.0);
    if ((q.w as i32) != 1280) { return 18; }
    if ((q.h as i32) != 720) { return 19; }

    return 0;
}
