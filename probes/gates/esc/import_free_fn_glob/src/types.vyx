module Probe.Types;

public class Point {
    public x: f32;
    public y: f32;

    public static fn xy(x: f32, y: f32) -> Point {
        return Point { x: x, y: y };
    }
}

public class Quad {
    public p0: Point;

    public static fn of(p0: Point) -> Quad {
        return Quad { p0: p0 };
    }
}

public class Rectangle {
    public x: f32;
    public y: f32;
    public w: f32;
    public h: f32;

    public static fn xywh(x: f32, y: f32, w: f32, h: f32) -> Rectangle {
        return Rectangle { x: x, y: y, w: w, h: h };
    }
}
