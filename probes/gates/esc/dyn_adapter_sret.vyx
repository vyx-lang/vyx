interface App {
    fn identity(&self) -> Ident;
    fn configure(&self, spec: Spec) -> Spec;
}

class Ident {
    public name: string;
    public identifier: string;
    public version: string;
    public organization: string;
}

class Spec {
    public title: string;
    public width: i32;
    public height: i32;
}

class Host : App {
    public fn identity(&self) -> Ident {
        return Ident {
            name: "n",
            identifier: "i",
            version: "v",
            organization: "o"
        };
    }

    public fn configure(&self, spec: Spec) -> Spec {
        return spec;
    }
}

fn run(app: dyn App) -> i32 {
    let id = app.identity();
    if (id.name.len < 1) { return 1; }
    let spec = Spec { title: "t", width: 8, height: 4 };
    let out = app.configure(spec);
    if (out.width != 8) { return 2; }
    return 0;
}

fn main() -> i32 {
    let h = Host {};
    return run(h);
}
