module Probe.HostDynPeer;

use Paint = Probe.Nut.Scene.Paint;

public class AppHost {
    public static fn run(scene: dyn Scene) -> string {
        return scene.id();
    }
}

fn main() -> i32 {
    let paint = Paint.create();
    if (paint.n != 7) { return 2; }
    let lifecycle_scene = SceneBase.create("zyn.app.lifecycle", "App Lifecycle");
    if (AppHost.run(lifecycle_scene) != "zyn.app.lifecycle") { return 1; }
    return 0;
}
