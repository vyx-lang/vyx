class Inner {
    public n: i32;
    public fn drop() {}

    public fn bump(mut self, x: i32) -> Inner {
        self.n = x;
        return self;
    }
}

class Boxy {
    public inner: Inner;

    public fn bump(&mut self, x: i32) {
        self.inner = self.inner.bump(x);
    }

    public fn get(&self) -> i32 {
        return self.inner.n;
    }
}

fn main() -> i32 {
    var b = Boxy { inner: Inner { n: 0 } };
    b.bump(1);
    return b.get() - 1;
}
