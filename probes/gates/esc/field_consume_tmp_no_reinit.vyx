class Inner {
    public n: i32;
    public fn drop() {}

    public fn bump(mut self, x: i32) -> Inner {
        self.n = x;
        return self;
    }
}

class Boxy {
    public inner: Inner;
    public flag: bool;

    public fn bounce(mut self) -> Boxy {
        var tmp = self.inner.bump(1);
        self.flag = false;
        return self;
    }
}

fn main() -> i32 {
    var b = Boxy { inner: Inner { n: 0 }, flag: true };
    b = b.bounce();
    return 0;
}
