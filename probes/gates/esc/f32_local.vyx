class Color {
    public r: f32;
    public g: f32;
    public b: f32;
    public a: f32;

    public static fn rgba(r: f32, g: f32, b: f32, a: f32) -> Color {
        return Color { r: r, g: g, b: b, a: a };
    }
}

public fn f32Zero() -> f32 { return 0.0; }

fn main() -> i32 {
    let c = Color.rgba(0.05, 0.0, 0.0, 1.0);
    let z: f32 = f32Zero();
    if (c.r > z) { return 0; }
    return 1;
}
