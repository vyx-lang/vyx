module Probe.App;

use std.collections;

interface Component {
    fn id(&self) -> string;
}

class View {
    public n: i32;

    public fn dup(&self) -> View {
        return View { n: self.n };
    }
}

class ViewComponent : Component {
    public component_id: string;
    private root_view: View;

    public static fn create(id: string, root: View) -> ViewComponent {
        return ViewComponent { component_id: id, root_view: root.dup() };
    }

    public fn id(&self) -> string {
        return self.component_id;
    }
}

class Components {
    private items: Vec<dyn Component>;

    public static fn create() -> Components {
        return Components { items: Vec::<dyn Component>.new() };
    }

    public fn view(mut self, id: string, root: View) -> Components {
        self.items.push(ViewComponent.create(id, root));
        return self;
    }

    public fn count(&self) -> i32 {
        return self.items.len as i32;
    }
}

fn main() -> i32 {
    var c = Components.create();
    c = c.view("x", View { n: 1 });
    return c.count() - 1;
}
