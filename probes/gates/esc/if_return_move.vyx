class Boxy {
    public n: i32;
    public fn drop() {}
}

fn take(mut b: Boxy) -> i32 {
    return b.n;
}

fn consume_then_return(flag: bool) -> i32 {
    var next = Boxy { n: 3 };
    if (flag) {
        return take(next);
    }
    return take(next);
}

fn consume_if_else(flag: bool) -> i32 {
    var next = Boxy { n: 4 };
    if (flag) {
        return take(next);
    } else {
        return take(next);
    }
}

fn main() -> i32 {
    return consume_then_return(true) + consume_if_else(false) - 7;
}
