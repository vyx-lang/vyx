class Inner {
    public n: i32;
    public fn drop() {}

    public fn bump(mut self, x: i32) -> Inner {
        self.n = x;
        return self;
    }
}

class Boxy {
    public inner: Inner;

    public fn steal(&mut self) -> i32 {
        let _ignored = self.inner.bump(1);
        return self.inner.n;
    }
}

fn main() -> i32 {
    var b = Boxy { inner: Inner { n: 0 } };
    return b.steal();
}
