class Inner {
    public n: i32;
    public fn drop() {}

    public fn bump(mut self, x: i32) -> Inner {
        self.n = x;
        return self;
    }
}

class Boxy {
    public inner: Inner;
    public flag: bool;

    public fn bump(mut self, x: i32) -> Boxy {
        self.inner = self.inner.bump(x);
        self.flag = false;
        return self;
    }
}

fn main() -> i32 {
    var b = Boxy { inner: Inner { n: 0 }, flag: true };
    b = b.bump(1);
    if (b.flag) { return 2; }
    return b.inner.n - 1;
}
