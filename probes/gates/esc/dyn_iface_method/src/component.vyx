module Probe.App;

public interface Comp {
    fn id(&self) -> string;
    fn configure(&self, tag: i32) -> i32;
}

public class Item : Comp {
    public name: string;

    public static fn create(name: string) -> Item {
        return Item { name: name };
    }

    public fn id(&self) -> string {
        return self.name;
    }

    public fn configure(&self, tag: i32) -> i32 {
        return tag + 1;
    }
}
