module Probe.Types;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

public fn typesLoadF32(src: rawptr) -> f32 {
    var out: f32 = 0.0;
    memcpy(to_rawptr(&out), src, 4);
    return out;
}

public fn f32Zero() -> f32 { return 0.0; }

public class Color {
    public r: f32;
    public g: f32;
    public b: f32;
    public a: f32;

    public static fn rgba(r: f32, g: f32, b: f32, a: f32) -> Color {
        return Color { r: r, g: g, b: b, a: a };
    }

    public fn clone(&self) -> Color {
        var out: Color;
        memcpy(to_rawptr(&out), to_rawptr(&self), sizeof::<Color>() as i64);
        return out;
    }

    public fn withAlphaMultiplier(&self, alpha: f32) -> Color {
        let base = to_rawptr(&self);
        let r = typesLoadF32(base);
        let g = typesLoadF32(base + 4);
        let b = typesLoadF32(base + 8);
        let a = typesLoadF32(base + 12);
        return Color.rgba(r, g, b, a * alpha);
    }
}
