module Probe.App;

use Window = Probe.Win.Window;

fn take(s: string) -> i32 {
    if (s == "x") { return 0; }
    return 1;
}

fn main() -> i32 {
    let w = Window { n: 1 };
    match (w.startTextInput()) {
        case Ok(_) => { return 2; }
        case Err(e) => { return take(e.message); }
    }
}
