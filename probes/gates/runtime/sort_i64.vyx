module probe.runtime.sort_i64;

use std.collections;

fn main() -> i32 {
    var small = Vec::<i64>.new();
    small.push(3);
    small.push(-2);
    small.push(1);
    small.push(-2);
    small.push(0);
    small.sort();
    if (small.get(0) != -2) { return 1; }
    if (small.get(1) != -2) { return 2; }
    if (small.get(2) != 0) { return 3; }
    if (small.get(3) != 1) { return 4; }
    if (small.get(4) != 3) { return 5; }

    var radix = Vec::<i64>.new();
    var n: i64 = 0;
    while (n < 70000) {
        radix.push(n - 35000);
        n = n + 1;
    }
    radix.sort();
    var i: i64 = 1;
    while (i < radix.len) {
        if (radix.get(i - 1) > radix.get(i)) { return 6; }
        i = i + 1;
    }
    if (radix.get(0) != -35000) { return 7; }
    if (radix.get(69999) != 34999) { return 8; }

    print("ok");
    return 0;
}
