module tbb_pool_probe;

/// Gate probe for `std.thread_pool`: typed `cfn` callbacks on the TBB
/// work-stealing pool (parallel_for / task_group_run / task_arena).

use std.thread_pool;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

const N: i64 = 4096;

// ── bodies (C-ABI callbacks, one per API variant) ──────────────────────────

@[no_mangle]
fn body_fill(ctx: rawptr, i: i64) {
    var v: i64 = i * 2;
    memcpy(ctx + i * 8, to_rawptr(&v), 8);
}

@[no_mangle]
fn body_fill_task_group(ctx: rawptr, i: i64) {
    var v: i64 = 1000000 + i;
    memcpy(ctx + i * 8, to_rawptr(&v), 8);
}

@[no_mangle]
fn body_fill_arena(ctx: rawptr, i: i64) {
    var v: i64 = 2000000 + i;
    memcpy(ctx + i * 8, to_rawptr(&v), 8);
}

fn slot(ctx: rawptr, i: i64) -> i64 {
    var v: i64 = 0;
    memcpy(to_rawptr(&v), ctx + i * 8, 8);
    return v;
}

fn expect(cond: bool, what: string) {
    if (!cond) {
        panic("FAIL: " + what);
    }
}

fn main() -> i32 {
    let buf = malloc(N * 8);
    if (buf == null) { panic("malloc failed"); }

    // 1) parallel_for: every slot written exactly as i*2.
    parallel_for(N, body_fill, buf);
    var i: i64 = 0;
    while (i < N) {
        expect(slot(buf, i) == i * 2, "parallel_for slot " + "${i}");
        i = i + 1;
    }

    // 2) task_group_run: one task per index.
    task_group_run(N, body_fill_task_group, buf);
    i = 0;
    while (i < N) {
        expect(slot(buf, i) == 1000000 + i, "task_group slot " + "${i}");
        i = i + 1;
    }

    // 3) arena: bounded-concurrency parallel_for.
    let arena = arena_new(2);
    expect(arena_max_concurrency(arena) >= 1, "arena concurrency");
    arena_parallel_for(arena, N, body_fill_arena, buf);
    i = 0;
    while (i < N) {
        expect(slot(buf, i) == 2000000 + i, "arena slot " + "${i}");
        i = i + 1;
    }
    arena_free(arena);
    arena_free(null);

    // 4) degenerate ranges must be no-ops, not crashes.
    parallel_for(0, body_fill, buf);
    parallel_for(-5, body_fill, buf);
    task_group_run(0, body_fill, buf);

    free(buf);

    print("tbb_pool_probe OK: pool=" + "${pool_max_concurrency()}"
        + " threads, " + "${N}" + " slots verified x3");
    return 0;
}
