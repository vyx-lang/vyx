fn require(ok: bool, name: string) -> bool {
    if (!ok) { print("FAIL " + name); }
    return ok;
}

fn main() -> i32 {
    if (!require(build_resource_credit(-1, 10) == 0, "unknown telemetry earns no credit")) { return 1; }
    if (!require(build_resource_credit(20, 10) == 10, "credit cannot exceed reservation")) { return 2; }
    if (!require(build_resource_headroom(-1, 20, 10) == -1, "unknown physical headroom stays unknown")) { return 3; }
    if (!require(build_resource_limit(100, 40, 0) == 40, "commit and physical constraints remain separate")) { return 4; }
    if (!require(build_resource_limit(100, -1, 0) == 100, "unknown commit uses physical constraint")) { return 5; }
    if (!require(!build_resource_fits(0, 1, -1), "unknown budget does not admit a worker")) { return 6; }
    if (!require(!build_resource_fits(10, 1, 10), "occupied budget does not admit another worker")) { return 7; }
    if (!require(build_resource_cold_estimate(-1, true) == build_resource_cold_estimate(0, true), "negative source size clamps to zero")) { return 8; }
    let max: i64 = 9223372036854775807;
    if (!require(build_resource_cold_estimate(max, true) == max, "cold estimate saturates instead of wrapping")) { return 9; }
    if (!require(build_resource_measured_estimate(0, max) == max, "measured estimate saturates instead of wrapping")) { return 10; }
    if (!require(build_resource_measured_estimate(-1, -1) == 0, "unknown peaks do not create history")) { return 11; }
    // A 32 GiB host retaining 8 GiB for the driver/other processes and a
    // 3 GiB reserve can admit the two measured compiler consumers together.
    let main_prior = build_resource_cold_estimate(296325, true);
    let llvm_prior = build_resource_cold_estimate(1886553, true);
    let budget: i64 = (21 as i64) * (1073741824 as i64);
    if (!require(build_resource_fits(main_prior, llvm_prior, budget), "cold priors permit the measured pair")) { return 12; }
    if (!require(build_resource_cold_estimate(2000000, true) >= llvm_prior, "larger sources never reduce the prior")) { return 13; }
    if (!require(build_resource_measured_estimate(800, 400) == 1000, "measured resident peak keeps headroom")) { return 14; }
    if (!require(build_resource_cold_estimate(131072, true) >= build_resource_cold_estimate(131071, true), "small to medium boundary never lowers the prior")) { return 15; }
    if (!require(build_resource_cold_estimate(1572864, true) >= build_resource_cold_estimate(1572863, true), "medium to large boundary never lowers the prior")) { return 16; }
    let medium_pair = build_resource_cold_estimate(1213628, true) + build_resource_cold_estimate(1048625, true);
    if (!require(medium_pair < (9 as i64) * (536870912 as i64), "medium workers do not inherit the large-unit slope")) { return 17; }
    if (!require(build_resource_live_margin(-1, 1000) == 0, "unknown usage contributes no shared margin")) { return 18; }
    if (!require(build_resource_live_margin(1000, 1100) == 100, "shared margin cannot exceed reserved growth")) { return 19; }
    if (!require(build_resource_live_margin(1000, 900) == 0, "unreserved usage contributes no margin")) { return 20; }
    let action_usage: i64 = 4000;
    let action_reservation = build_resource_measured_estimate(action_usage, action_usage);
    let cushion: i64 = 3000;
    let remaining = build_resource_remaining_reserve(cushion, build_resource_live_margin(action_usage, action_reservation));
    if (!require(action_reservation + remaining - action_usage == cushion, "active growth plus remaining cushion preserves the default reserve")) { return 21; }
    if (!require(build_resource_remaining_reserve(cushion, -1) == cushion, "unknown margin preserves the full cushion")) { return 22; }
    if (!require(build_resource_remaining_reserve(cushion, max) == 0, "margin beyond the cushion cannot create negative reserve")) { return 23; }
    if (!require(llvm_prior > build_resource_measured_estimate(2125561856, 2185211904), "large cold prior exceeds measured post-fix peak plus growth")) { return 24; }
    let cold_budget: i64 = (8 as i64) * (1073741824 as i64);
    if (!require(build_resource_fits(main_prior + build_resource_cold_estimate(1213628, true), llvm_prior, cold_budget), "corrected large prior admits measured source workers together")) { return 25; }
    if (!require(build_resource_default_reserve(-1) == (3 as i64) * (1073741824 as i64), "unknown availability keeps the conservative cushion")) { return 26; }
    if (!require(build_resource_default_reserve(0) == 268435456, "small budgets keep a positive cushion")) { return 27; }
    if (!require(build_resource_default_reserve((8 as i64) * (1073741824 as i64)) == 1073741824, "busy host reserve follows available memory")) { return 28; }
    if (!require(build_resource_default_reserve(max) == (3 as i64) * (1073741824 as i64), "large budgets cap without overflow")) { return 29; }
    if (!require(build_resource_default_reserve((32 as i64) * (1073741824 as i64)) >= build_resource_default_reserve((8 as i64) * (1073741824 as i64)), "larger availability never lowers the reserve")) { return 30; }
    print("build resource policy PASS");
    return 0;
}
