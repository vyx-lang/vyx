module bootstrap_stdlib_probe;
use std.core;
use std.collections;
use std.string;

fn main() -> i32 {
    var values = Vec<i32>.new();
    values.push(19);
    values.push(23);
    let cursor = values.iter();
    var sum: i32 = 0;
    while (true) {
        match (cursor.next()) {
            Some(value) => { sum = sum + value; }
            None => { break; }
        }
    }
    assert(sum == 42 && values.len == 2, "iterator and vector agree on storage ownership");
    let copy = values.clone();
    assert(copy.get(1) == 23, "canonical Vec clone");
    var text = StringBuilder.create();
    text.append("stage0=");
    text.appendI64(4429);
    let built = text.build();
    assert(built.as_str() == "stage0=4429", "StringBuilder uses the selected string module");
    print("bootstrap standard library ok");
    return 0;
}
