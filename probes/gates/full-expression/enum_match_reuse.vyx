use std.core;
class Resource { public value: i32; public fn drop() {} }
enum Envelope {
    Value(Resource), Empty,
    fn drop() { match (self) { case Value(payload) => { let owner = payload; } default => {} } }
}
fn main() -> i32 {
    let value = Envelope.Value(Resource { value: 7 });
    match (value) { case Value(payload) => { assert(payload.value == 7); } default => {} }
    match (value) { case Value(payload) => { print(payload.value); } default => {} }
    return 0;
}
