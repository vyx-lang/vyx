use std.core;
use std.string;

// String methods return views. Primitive str intrinsics with the same spelling
// allocate, so return proofs must distinguish their actual selected targets.
fn bad_substring() -> str {
    let owner = String.from("a heap string that cannot survive the local owner");
    return owner.substring(0, 19);
}

fn bad_trim() -> str {
    let owner = String.from(" a heap string that cannot survive the local owner ");
    return owner.trim();
}

fn main() -> i32 {
    print(bad_substring());
    print(bad_trim());
    return 0;
}
