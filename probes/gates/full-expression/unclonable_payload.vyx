use std.ref;

extern "C" { fn malloc(size: i64) -> rawptr; fn free(ptr: rawptr); }
class Unique {
    public data: rawptr;
    public fn drop() { if (self.data != null) { free(self.data); self.data = null; } }
}
fn main() -> i32 {
    let owner = Box::<Unique>.new(Unique { data: malloc(8) });
    let illegal = owner.get();
    return 0;
}
