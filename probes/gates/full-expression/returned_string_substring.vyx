use std.core;
use std.string;

// The selected String method returns a view into the local owner's storage.
// Keep each escaping method in its own compilation: streaming verification
// stops after the first failing function.
fn bad_substring() -> str {
    let owner = String.from("a heap string that cannot survive the local owner");
    return owner.substring(0, 19);
}

fn main() -> i32 {
    print(bad_substring());
    return 0;
}
