var released: i64 = 0;

class Packet<T> {
    public value: T;
    public fn drop(&mut self) { released = released + (repr_sizeof::<T>() as i64); }
}

fn make32() -> Packet<i32> { return Packet<i32> { value: 7 }; }
fn make64() -> Packet<i64> { return Packet<i64> { value: 11 }; }

@[borrow_args]
fn inspect32(packet: Packet<i32>) -> i32 { return packet.value; }
@[borrow_args]
fn inspect64(packet: Packet<i64>) -> i64 { return packet.value; }

fn main() -> i32 {
    let first = inspect32(make32());
    if (first != 7 || released != 4) { return 1; }
    let second = inspect64(make64());
    if (second != 11 || released != 12) { return 2; }
    let third = inspect32(make32());
    if (third != 7 || released != 16) { return 3; }
    print("generic-owners=ok");
    return 0;
}
