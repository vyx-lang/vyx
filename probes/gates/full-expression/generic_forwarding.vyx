module forwarding_scope {
    public fn choose<T>(value: T) -> i32 { return 1; }
    public fn choose<str>(value: str) -> i32 { return 2; }
    public fn forward<T>(value: T) -> i32 { return choose::<T>(value); }
}

fn choose<T>(value: T) -> i32 { return 10; }
fn choose<str>(value: str) -> i32 { return 20; }
fn forward<T>(value: T) -> i32 { return choose::<T>(value); }

fn main() -> i32 {
    if (forward::<i32>(42) != 10) { return 1; }
    if (forward::<str>("view") != 20) { return 2; }
    if (forward::<string>("view") != 20) { return 3; }
    if (forwarding_scope.forward::<i32>(42) != 1) { return 4; }
    if (forwarding_scope.forward::<str>("view") != 2) { return 5; }
    print("generic-forwarding=ok");
    return 0;
}
