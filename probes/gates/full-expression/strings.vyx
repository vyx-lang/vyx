use std.string;

fn main() -> i32 {
    print(String.from("0123456789012345678901234567890123"));
    print(String.from("short"));
    if (String.from("0123456789012345678901234567890123").len != 34) { return 1; }
    var i = 0;
    while (i < 10000) {
        if (String.from("0123456789012345678901234567890123").len != 34) { return 2; }
        i = i + 1;
    }
    let retained = String.from("0123456789012345678901234567890123");
    print(retained);
    print(retained);
    return 0;
}
