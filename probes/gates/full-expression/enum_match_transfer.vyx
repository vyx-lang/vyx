use std.core;

var made: i32 = 0;
var released: i32 = 0;
var shells: i32 = 0;

class Resource {
    public value: i32;
    public static fn create(value: i32) -> Resource { made += 1; return Resource { value: value }; }
    public fn drop() { released += 1; }
}

enum Envelope<T> {
    Value(T), Empty,
    fn drop() {
        shells += 1;
        match (self) {
            case Value(payload) => { let owner: T = payload; }
            default => {}
        }
    }
    fn take(own self) -> T {
        match (self) {
            case Value(payload) => { return payload; }
            default => { panic("missing payload"); }
        }
    }
    fn present(&self) -> bool {
        match (self) { case Value(_) => { return true; } default => { return false; } }
    }
}

fn take_owned() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(7));
    let payload = value.take();
    assert(payload.value == 7 && released == 0, "extraction keeps the payload alive");
}
fn match_local() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(8));
    match (value) { case Value(payload) => { assert(payload.value == 8); } default => {} }
}
fn match_temporary() {
    match (Envelope::<Resource>.Value(Resource.create(9))) {
        case Value(payload) => { assert(payload.value == 9); }
        default => {}
    }
}
fn match_guard() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(10));
    let before = released;
    match (value) {
        case Value(payload) if payload.value == 0 => { panic("guard must fail"); }
        case Value(payload) => { assert(payload.value == 10 && released == before); }
        default => {}
    }
}
fn match_discard() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(11));
    match (value) { case Value(_) => {} default => {} }
}
fn match_expression() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(12));
    let payload = match (value) { case Value(payload) => payload, default => Resource.create(0), };
    assert(payload.value == 12, "expression transfers payload to its result");
}
fn borrowed() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(13));
    let before = released;
    assert(value.present() && value.present() && released == before);
}
fn default_arm() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(14));
    match (value) { case Empty => {} default => {} }
}
enum PairEnvelope {
    Pair(Resource, i64, Resource), Empty,
    fn drop() {
        shells += 1;
        match (self) { case Pair(left, _, right) => { let a = left; let b = right; } default => {} }
    }
}
fn multiple_payloads() {
    let value = PairEnvelope.Pair(Resource.create(15), 4294967297 as i64, Resource.create(16));
    let before = released;
    match (value) {
        case Pair(left, 0, right) => { panic("constant pattern must fail"); }
        case Pair(left, number, _) if number == 4294967297 => { assert(left.value == 15 && released == before); }
        default => { panic("expected second arm"); }
    }
}
fn guard_falls_back() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(17));
    let before = released;
    match (value) {
        case Value(payload) if payload.value == 0 => { panic("guard must fail"); }
        default => { assert(released == before); }
    }
}
fn repeated_moves() {
    var i = 0;
    while (i < 3) {
        let value: Envelope<Resource> = Envelope.Value(Resource.create(i));
        match (value) { case Value(payload) => { assert(payload.value == i); } default => {} }
        i += 1;
    }
}
fn temporary_fallback() {
    let before = released;
    match (Envelope::<Resource>.Value(Resource.create(18))) {
        case Value(payload) if payload.value == 0 => { panic("guard must fail"); }
        default => { assert(released == before, "temporary remains alive through failed guard"); }
    }
}
fn borrow_argument(value: &Envelope<Resource>) {
    match (value) { case Value(payload) => { assert(payload.value == 19); } default => {} }
}
fn borrow_local() {
    let value: Envelope<Resource> = Envelope.Value(Resource.create(19));
    let before = released;
    borrow_argument(&value); borrow_argument(&value);
    assert(released == before && value.present());
}
fn inspect_result(value: &Result<i32, Resource>) {
    match (value) { case Err(problem) => { assert(problem.value == 20); } default => { panic("expected error"); } }
}
fn inspect_option(value: &Option<Resource>) -> i32 {
    return match (value) { case Some(payload) => payload.value, default => 0, };
}
fn inspect_mut_result(value: &mut Result<i32, Resource>) -> i32 {
    return match (value) { case Err(problem) => problem.value, default => 0, };
}
fn inspect_mut_option(value: &mut Option<Resource>) -> i32 {
    match (value) {
        case Some(payload) if payload.value == 0 => { panic("guard must fail"); }
        case Some(payload) => { return payload.value; }
        default => { return 0; }
    }
}
fn borrowed_standard_enums() {
    var problem: Result<i32, Resource> = Err(Resource.create(20));
    var option: Option<Resource> = Some(Resource.create(21));
    let before = released;
    inspect_result(&problem); inspect_result(&problem);
    assert(inspect_option(&option) == 21 && inspect_option(&option) == 21 && released == before);
    assert(inspect_mut_result(&mut problem) == 20 && inspect_mut_result(&mut problem) == 20);
    assert(inspect_mut_option(&mut option) == 21 && inspect_mut_option(&mut option) == 21);
    var success: Result<i32, Resource> = Ok(42);
    var empty: Option<Resource> = None;
    assert(inspect_mut_result(&mut success) == 0 && inspect_option(&empty) == 0);
    assert(inspect_mut_option(&mut empty) == 0 && released == before);
    // Explicitly extract into owning locals: automatic standard enum cleanup
    // remains tracked by enum-payload-cleanup, independently of borrowed match.
    let first = problem.unwrap_err();
    let second = option.unwrap();
    assert(first.value == 20 && second.value == 21);
}
fn main() -> i32 {
    take_owned(); assert(made == 1 && released == 1, "own receiver");
    match_local(); assert(made == 2 && released == 2, "local match");
    match_temporary(); assert(made == 3 && released == 3, "temporary match");
    match_guard(); assert(made == 4 && released == 4, "guarded match");
    match_discard(); assert(made == 5 && released == 5, "wildcard cleanup");
    match_expression(); assert(made == 6 && released == 6, "expression match");
    borrowed(); assert(made == 7 && released == 7, "borrow retains owner");
    default_arm(); assert(made == 8 && released == 8, "default retains owner");
    assert(shells == 2, "only intact envelopes execute their destructor");
    multiple_payloads(); assert(made == 10 && released == 10, "bound and discarded payloads");
    guard_falls_back(); assert(made == 11 && released == 11 && shells == 3, "failed guard retains owner");
    repeated_moves(); assert(made == 14 && released == 14 && shells == 3, "loop transfer");
    temporary_fallback(); assert(made == 15 && released == 15 && shells == 4, "temporary default cleanup");
    borrow_local(); assert(made == 16 && released == 16 && shells == 5, "reference patterns borrow");
    borrowed_standard_enums(); assert(made == 18 && released == 18, "standard Result/Option reference matches");
    print("enum-match-transfer=ok");
    return 0;
}
