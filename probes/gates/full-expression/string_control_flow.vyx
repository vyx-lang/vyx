use std.core;
use std.string;

fn copy_text(input: str) -> str { return input.clone(); }

fn main() -> i32 {
    let text = copy_text("owned string inside conditional walker");
    let value = if (false) { 0 } elif (true) { 1 } else { text.len as i32 };
    let other = if (false) { 0 } else if (false) { 1 } else { 2 };
    assert_eq(value, 1);
    assert_eq(other, 2);
    assert_eq(text, "owned string inside conditional walker");
    print("string-control-flow=ok");
    return 0;
}
