use std.core;
use std.string;

var owner_drops: i32 = 0;

class BorrowingOwner {
    public text: str;
    public fn drop(&mut self) { owner_drops += 1; str_drop(self.text); }
    public fn clone(&self) -> str { return self.text; }
    public fn toUpper(&self) -> str { return self.text; }
    public fn toLower(&self) -> str { return self.text; }
    public fn trim(&self) -> str { return self.text; }
    public fn replace(&self) -> str { return self.text; }
    public fn substring(&self) -> str { return self.text; }
    public fn repeat(&self) -> str { return self.text; }
}

fn str_dup(owner: &BorrowingOwner) -> str { return owner.text; }
fn readFile(owner: &BorrowingOwner) -> str { return owner.text; }

fn churn() {
    var i: i32 = 0;
    while (i < 64) {
        let replacement = String.from("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
        i += 1;
    }
}

fn exercise() {
    let expected = "borrowed class field must remain valid until its owner is dropped";
    let owner = BorrowingOwner { text: expected.clone() };
    { let view = owner.clone(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.toUpper(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.toLower(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.trim(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.replace(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.substring(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = owner.repeat(); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = str_dup(&owner); print(view); }
    churn(); assert_eq(owner.text, expected);
    { let view = readFile(&owner); print(view); }
    churn(); assert_eq(owner.text, expected);
    assert_eq(owner_drops, 0);
}

fn main() -> i32 {
    exercise();
    assert_eq(owner_drops, 1);
    print("lookalike-string-calls=ok");
    return 0;
}
