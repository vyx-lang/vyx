use std.collections;
use std.ref;
use std.string;

extern "C" {
    fn payload_allocate(id: i32) -> rawptr;
    fn payload_expect(allocated: i32, released: i32);
}

fn owned(id: i32) -> str {
    return from_raw_string_parts(payload_allocate(id), 32, 33, 1);
}

fn vector_values() {
    var values = Vec::<str>.new();
    values.push(owned(1));
    values.push(owned(2));
    values.set(0, owned(3));
    payload_expect(3, 1);
    values.set_unchecked(1, owned(4));
    payload_expect(4, 2);
    values.clear();
    values.clear();
    payload_expect(4, 4);
    values.push(owned(5));
}

fn unique_value() {
    var boxed = Box::<str>.new(owned(6));
    boxed.set(owned(7));
    payload_expect(7, 6);
}

fn shared_value() {
    var shared = Ref::<str>.new(owned(8));
    var alias = shared.clone();
    shared.set(owned(9));
    payload_expect(9, 8);
    if (alias.deref().len != 32) { panic("shared payload replaced incorrectly"); }
}

fn nested_values() {
    var values = Vec::<Box<str>>.new();
    values.push(Box::<str>.new(owned(10)));
    values.push(Box::<str>.new(owned(11)));
    values.set(0, Box::<str>.new(owned(12)));
    payload_expect(12, 10);
}

fn literal_values() {
    var values = Vec::<str>.new();
    values.push("static view");
    values.clear();
    var boxed = Box::<str>.new("static view");
    var shared = Ref::<str>.new("static view");
}

fn compatibility_spelling() {
    var values = Vec::<string>.new();
    values.push(owned(13));
    values.resize(0, "static view");
    payload_expect(13, 13);
}

fn main() -> i32 {
    vector_values();
    payload_expect(5, 5);
    unique_value();
    payload_expect(7, 7);
    shared_value();
    payload_expect(9, 9);
    nested_values();
    payload_expect(12, 12);
    compatibility_spelling();
    payload_expect(13, 13);
    literal_values();
    payload_expect(13, 13);
    print("stored-strings=ok");
    return 0;
}
