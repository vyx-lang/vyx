use std.string;

fn main() -> i32 {
    let view: str = String.from("0123456789012345678901234567890123");
    print(view);
    // Additional heap activity must not invalidate the binding's backing owner.
    var i = 0;
    while (i < 1000) {
        let other = String.from("abcdefghijklmnopqrstuvwxyz0123456789");
        i = i + 1;
    }
    if (view != "0123456789012345678901234567890123") { return 1; }
    print(view);
    return 0;
}
