use std.clone;
use std.collections;
use std.ref;

var drops: i32 = 0;
var clones: i32 = 0;
class Payload {
    public value: i32;
    public fn drop() { drops += 1; }
}
impl Clone for Payload {
    fn clone() -> Payload { clones += 1; return Payload { value: self.value }; }
}

fn exercise() -> i32 {
    var values = Vec::<Box<Payload>>.new();
    values.push(Box::<Payload>.new(Payload { value: 1 }));
    values.push(Box::<Payload>.new(Payload { value: 2 }));
    values.set(0, Box::<Payload>.new(Payload { value: 3 }));
    values.set_unchecked(1, Box::<Payload>.new(Payload { value: 4 }));
    if (drops != 2 || clones != 0) { return 1; }
    values.clear();
    values.clear();
    if (drops != 4 || values.len != 0) { return 2; }
    let seed = Box::<Payload>.new(Payload { value: 5 });
    values.resize(3, seed);
    if (clones != 3 || seed.deref().value != 5) { return 3; }
    values.resize(1, seed);
    if (drops != 6 || clones != 3 || values.len != 1) { return 4; }
    let removed = values.pop();
    if (removed.deref().value != 5 || values.len != 0 || drops != 6) { return 5; }
    values.push(Box::<Payload>.new(Payload { value: 6 }));
    let filled = Vec::<Box<Payload>>.filled(2, seed);
    if (clones != 5 || filled.get_ref(0).deref().value != 5) { return 6; }
    return 0;
}

fn main() -> i32 {
    let status = exercise();
    if (status != 0) { print("status=${status} drops=${drops} clones=${clones}"); return status; }
    if (drops != 11 || clones != 5) {
        print("drops=${drops} clones=${clones}");
        return 7;
    }
    print("vec-owning-mutations=ok");
    return 0;
}
