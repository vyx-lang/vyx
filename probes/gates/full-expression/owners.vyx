var made: i32 = 0;
var dropped: i32 = 0;
var order: i64 = 0;

class Token {
    public id: i32;
    public fn drop(&mut self) { dropped = dropped + 1; }
    public fn peek(&self) -> i32 { return self.id; }
}

fn make(id: i32) -> Token {
    made = made + 1;
    order = order * 10 + id;
    return Token { id: id };
}

@[borrow_args]
fn inspect(token: Token) -> i32 { return token.id; }

@[borrow_args]
fn pair(left: i32, right: Token) -> i32 { return left + right.id; }

fn first() -> i32 { order = order * 10 + 1; return 1; }

fn consume(token: Token) -> i32 {
    let moved = token;
    return moved.id;
}

fn forwarded() -> Token { return make(8); }

fn main() -> i32 {
    if (inspect(make(2)) != 2) { return 1; }
    if (made != 1 || dropped != 1) { return 2; }
    if (make(3).peek() != 3) { return 3; }
    if (made != 2 || dropped != 2) { return 4; }
    make(4);
    if (made != 3 || dropped != 3) { return 5; }
    order = 0;
    if (pair(first(), make(2)) != 3 || order != 12) { return 6; }
    if (made != 4 || dropped != 4) { return 7; }
    if (false && inspect(make(5)) == 5) { return 8; }
    if (!(true || inspect(make(6)) == 6)) { return 9; }
    if (made != 4 || dropped != 4) { return 10; }
    if (!(true && inspect(make(7)) == 7)) { return 11; }
    if (made != 5 || dropped != 5) { return 12; }
    if ((false ? inspect(make(1)) : inspect(make(2))) != 2) { return 13; }
    if (made != 6 || dropped != 6) { return 14; }
    var i = 0;
    while (inspect(make(3)) == 3 && i < 3) {
        i = i + 1;
        if (made != dropped) { return 15; }
        inspect(make(4));
        if (made != dropped) { return 16; }
    }
    if (made != dropped) { return 17; }
    {
        let owner = forwarded();
        if (owner.id != 8 || made != dropped + 1) { return 18; }
    }
    if (made != dropped) { return 19; }
    if (consume(make(9)) != 9) { return 20; }
    if (made != dropped) { return 21; }
    {
        let selected = false ? make(1) : make(2);
        if (selected.id != 2 || made != dropped + 1) { return 22; }
    }
    if (made != dropped) { return 23; }
    {
        let selected = if (true) { make(3) } else { make(4) };
        if (selected.id != 3 || made != dropped + 1) { return 24; }
    }
    if (made != dropped) { return 25; }
    order = 0;
    if (pair(first(), false ? make(3) : make(2)) != 3 || order != 12) { return 26; }
    if (made != dropped) { return 27; }
    {
        let view: &Token = make(4);
        if (view.id != 4 || made != dropped + 1) { return 28; }
    }
    if (made != dropped) { return 29; }
    print("owners=ok");
    return 0;
}
