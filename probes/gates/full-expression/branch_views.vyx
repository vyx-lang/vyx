use std.string;

fn main() -> i32 {
    // The view must keep the selected branch's String owner alive for the
    // binding, while the unselected branch is cleaned up normally.
    let left: str = if (true) {
        String.from("01234567890123456789012345678901").as_str()
    } else {
        String.from("short").as_str()
    };
    let right: str = if (false) {
        String.from("01234567890123456789012345678901").as_str()
    } else {
        String.from("short").as_str()
    };
    if (left.len != 32 || right.len != 5) { return 1; }
    print(left);
    print(right);
    return 0;
}
