module support.scoped_library;

fn internal_helper() -> i32 { return 41; }
public fn delegated<T>(value: T) -> i32 { return internal_helper(); }

fn overloaded(value: str) -> i32 { return 23; }
fn overloaded(value: i32) -> i32 { return 17; }
public fn dispatch<T>(value: T) -> i32 { return overloaded(value); }
