use std.core;
use support.scoped_library;

fn internal_helper() -> i32 { return 99; }

fn main() -> i32 {
    assert_eq(delegated::<i32>(7), 41);
    assert_eq(internal_helper(), 99);
    assert_eq(dispatch::<i32>(7), 17);
    assert_eq(dispatch::<str>("x"), 23);
    print("generic-call-scope=ok");
    return 0;
}
