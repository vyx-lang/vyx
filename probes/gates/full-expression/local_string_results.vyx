use std.core;
use std.string;

extern "C" { fn allocation_checkpoint(stage: i32); }

fn copy_text(source: str) -> str { return source.clone(); }
fn forward_copy(source: str) -> str { return copy_text(source); }
fn generic_copy<T>(value: T, source: str) -> str { return source.clone(); }

fn copied_substring() -> str {
    let owner = String.from("local string result must own its independently allocated bytes");
    return owner.raw().substring(0, 19);
}

fn copied_trim() -> str {
    let owner = String.from(" local string result must own its independently allocated bytes ");
    return owner.raw().trim();
}

fn intrinsic_copy() {
    let source = "local string result must own its independently allocated bytes";
    let text = from_cstr_len(source.c_str(), source.len);
    assert_eq(text, source);
}

fn library_copy() {
    let text = str_dup("local string result must own its independently allocated bytes");
    assert_eq(text, "local string result must own its independently allocated bytes");
}

fn intrinsic_clone() {
    let text = "local string result must own its independently allocated bytes".clone();
    assert_eq(text, "local string result must own its independently allocated bytes");
}

fn forwarded_copy() {
    let text = forward_copy("local string result must own its independently allocated bytes");
    assert_eq(text, "local string result must own its independently allocated bytes");
}

fn transforms() {
    let upper = "local string result".toUpper();
    assert_eq(upper, "LOCAL STRING RESULT");
    let lower = "LOCAL STRING RESULT".toLower();
    assert_eq(lower, "local string result");
    let replaced = "local string result".replace("local", "owned");
    assert_eq(replaced, "owned string result");
    let repeated = "local string result".repeat(2);
    assert_eq(repeated, "local string resultlocal string result");
}

fn returned_transforms() {
    let sliced = copied_substring();
    assert_eq(sliced, "local string result");
    let trimmed = copied_trim();
    assert_eq(trimmed, "local string result must own its independently allocated bytes");
}

fn generic_result() {
    let text = generic_copy::<i32>(7, "a closed generic result must have exactly one owner");
    assert_eq(text, "a closed generic result must have exactly one owner");
}

fn manually_released_generic() {
    let text = generic_copy::<i32>(7, "a manually released generic result is not released twice");
    assert_eq(text, "a manually released generic result is not released twice");
    str_drop(text);
}

fn borrowed_alias() {
    let text = generic_copy::<i32>(7, "an alias must not acquire its own destructor");
    { let alias = text; assert_eq(alias, "an alias must not acquire its own destructor"); }
    assert_eq(text, "an alias must not acquire its own destructor");
    str_drop(text);
}

fn scalar_result() -> i32 {
    let text = forward_copy("independent bytes");
    return (text.len - 17) as i32;
}

fn conditional_result() {
    let text = forward_copy("independent bytes");
    let code = if (false) { 0 } elif (false) { 1 } else { 17 };
    assert_eq(code, 17);
    assert_eq(text, "independent bytes");
}

fn main() -> i32 {
    intrinsic_copy(); allocation_checkpoint(1);
    library_copy(); allocation_checkpoint(2);
    intrinsic_clone(); allocation_checkpoint(3);
    forwarded_copy(); allocation_checkpoint(4);
    transforms(); allocation_checkpoint(5);
    returned_transforms(); allocation_checkpoint(6);
    generic_result(); allocation_checkpoint(7);
    manually_released_generic(); allocation_checkpoint(8);
    borrowed_alias(); allocation_checkpoint(9);
    assert_eq(scalar_result(), 0); allocation_checkpoint(10);
    conditional_result(); allocation_checkpoint(11);
    print("local-string-results=ok");
    return 0;
}
