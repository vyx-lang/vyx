use std.core;
use std.string;

var view_drops: i32 = 0;
class TextOwner {
    public text: String;
    public static fn make() -> TextOwner { return TextOwner { text: String.from("a sufficiently long string lives for the entire enum binding scope") }; }
    public fn view(&self) -> str { return self.text.as_str(); }
    public fn drop() { view_drops += 1; self.text.destroy(); }
}
enum View { Text(str), Empty }

fn caller_view(text: str) -> View { return View.Text(text); }
fn literal_view() -> View { return View.Text("static text"); }
fn bound_caller_view(text: str) -> View { let result = View.Text(text); return result; }
fn expect_text(value: View, expected: str) {
    match (value) {
        case Text(text) => { assert(text == expected, "caller/static borrows can be returned in enums"); }
        default => { panic("wrong view tag"); }
    }
}

fn inspect() {
    let value = View.Text(TextOwner.make().view());
    assert(view_drops == 0, "enum view owner must live with the enum binding");
    match (value) {
        case Text(text) => { assert(text == "a sufficiently long string lives for the entire enum binding scope"); }
        default => { panic("wrong enum tag"); }
    }
}
fn main() -> i32 {
    inspect();
    assert(view_drops == 1, "backing owner released at binding scope end");
    let caller = String.from("the caller owns the backing allocation beyond the returned enum");
    expect_text(caller_view(caller.as_str()), caller.as_str());
    expect_text(bound_caller_view(caller.as_str()), caller.as_str());
    expect_text(literal_view(), "static text");
    print("enum-views=ok");
    return 0;
}
