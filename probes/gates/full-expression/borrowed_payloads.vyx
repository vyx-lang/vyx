use std.clone;
use std.collections;
use std.ref;

var clones: i32 = 0;
var drops: i32 = 0;

class Payload {
    public value: i32;
    public fn drop() { drops += 1; }
}

impl Clone for Payload {
    fn clone() -> Payload {
        clones += 1;
        return Payload { value: self.value };
    }
}

fn exercise() -> i32 {
    var shared = Ref::<Payload>.new(Payload { value: 7 });
    var alias = shared.clone();
    let view = alias.deref();
    if (view.value != 7 || clones != 0 || drops != 0) { return 1; }
    let independent = shared.get();
    if (independent.value != 7 || clones != 1) { return 2; }

    var boxed = Box::<Payload>.new(Payload { value: 11 });
    var cloned = boxed.clone();
    let copied = boxed.get();
    if (clones != 3 || cloned.deref().value != 11 || copied.value != 11) { return 3; }
    cloned.deref();
    if (drops != 0 || boxed.deref().value != 11) { return 4; }

    var slots = Vec::<Box<Payload>>.new();
    slots.push(Box::<Payload>.new(Payload { value: 23 }));
    let slot = slots.get_ref(0);
    if (slot.deref().value != 23 || clones != 3 || drops != 0) { return 5; }
    let slot_copy = slots.get(0);
    if (slot_copy.deref().value != 23 || clones != 4 || drops != 0) { return 6; }
    return 0;
}

fn main() -> i32 {
    let status = exercise();
    if (status != 0) { return status; }
    if (drops != 7 || clones != 4) {
        print("payloads drops=${drops} clones=${clones}");
        return 7;
    }
    print("borrowed-payloads=ok");
    return 0;
}
