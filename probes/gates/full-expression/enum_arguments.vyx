use std.core;

var made: i32 = 0;
var released: i32 = 0;

class Resource {
    public value: i32;
    public static fn create(value: i32) -> Resource { made += 1; return Resource { value: value }; }
    public fn drop() { released += 1; }
}

// This fixture supplies an explicit destructor. Automatic enum-payload drop
// inference is a separate regression in enum-payload-cleanup.
enum Owned<T> {
    Value(T), Empty,
    fn drop() {
        match (self) {
            case Value(payload) => { let owner: T = payload; }
            default => {}
        }
    }
}

enum Mixed {
    Pair(i32, i64), TextAndNumber(string, i32), Empty,
}

fn temporary_payload() {
    let wrapped: Owned<Resource> = Owned.Value(Resource.create(42));
    assert(released == 0, "variant owns the temporary until its scope ends");
}
fn local_payload() {
    let payload = Resource.create(7);
    let wrapped: Owned<Resource> = Owned.Value(payload);
    assert(released == 1, "variant moves a local payload");
}
fn factory() -> Owned<Resource> { return Owned.Value(Resource.create(9)); }
fn returned_payload() {
    let wrapped = factory();
    assert(released == 2, "returning an owning variant transfers its payload");
}
fn mixed_types() {
    let a = Mixed.Pair(1, 4294967297 as i64);
    match (a) {
        case Pair(first, second) => { assert(first == 1 && second == 4294967297, "each payload uses its own declared type"); }
        default => { panic("wrong pair tag"); }
    }
    let b = Mixed.TextAndNumber("abc", 73);
    match (b) {
        case TextAndNumber(text, number) => { assert(text == "abc" && number == 73, "heterogeneous string/integer payloads"); }
        default => { panic("wrong text tag"); }
    }
}
fn main() -> i32 {
    temporary_payload();
    assert(made == 1 && released == 1, "temporary payload released once");
    local_payload();
    assert(made == 2 && released == 2, "local payload released once");
    returned_payload();
    assert(made == 3 && released == 3, "returned payload released once");
    mixed_types();
    print("enum-arguments=ok");
    return 0;
}
