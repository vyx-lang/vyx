use std.collections;
use std.ref;

class Point { public x: i64; public y: i64; }
enum State { Ready, Done }

fn main() -> i32 {
    var numbers = Vec::<i64>.new();
    numbers.push(17);
    numbers.push(29);
    if (numbers.get(0) != 17 || numbers.get_unchecked(1) != 29) { return 1; }
    if (numbers.get_ref(0).clone() != 17) { return 2; }
    let small = Box::<i32>.new(42);
    let shared = Ref::<i64>.new(61);
    if (small.get() != 42 || shared.get() != 61) { return 3; }
    var points = Vec::<Point>.new();
    points.push(Point { x: 3, y: 5 });
    let point = points.get(0);
    if (point.x != 3 || point.y != 5) { return 4; }
    var states = Vec::<State>.new();
    states.push(State::Ready);
    if (states.get_unchecked(0) != State::Ready) { return 5; }
    var outer = Vec::<Vec<i64>>.new();
    var inner = Vec::<i64>.new();
    inner.push(73);
    outer.push(inner);
    let copied = outer.get_unchecked(0);
    if (copied.get(0) != 73 || outer.get_ref(0).len != 1) { return 6; }
    print("clone-reference-values=ok");
    return 0;
}
