use std.core;
use std.string;

var user_calls: i32 = 0;

// A user function with this spelling is an ordinary borrowed call. It cannot
// consume the argument or become the compiler's primitive-string destructor.
fn str_drop(text: str) {
    user_calls += 1;
}

fn exercise() {
    let text = "the lifecycle function must belong to the actual standard library".clone();
    str_drop(text);
    assert_eq(text, "the lifecycle function must belong to the actual standard library");
}

fn main() -> i32 {
    exercise();
    assert_eq(user_calls, 1);
    print("string-drop-identity=ok");
    assert_eq(user_calls, 1);
    return 0;
}
