use std.string;

var made: i32 = 0;
var dropped: i32 = 0;

class Token {
    public id: i32;
    public fn drop(&mut self) { dropped = dropped + 1; }
}
fn make(id: i32) -> Token { made = made + 1; return Token { id: id }; }

fn choose(flag: bool) -> i32 {
    let left = make(1);
    let right = make(2);
    let selected = flag ? left : right;
    return selected.id;
}

fn main() -> i32 {
    if (choose(true) != 1 || made != dropped) { return 1; }
    if (choose(false) != 2 || made != dropped) { return 2; }
    var i = 0;
    while (i < 1000) {
        let left = String.from("01234567890123456789012345678901");
        let right = String.from("short");
        let selected = (i % 2 == 0) ? left : right;
        if (selected.len != ((i % 2 == 0) ? 32 : 5)) { return 3; }
        i = i + 1;
    }
    print("conditional-owners=ok");
    return 0;
}
