fn main() -> i32 {
    var a = "aa";
    var b = "ab";
    if (a.compare(b) >= 0) { return 1; }
    if (b.compare(a) <= 0) { return 2; }
    if (a.compare(a) != 0) { return 3; }
    var c = a.clone();
    if (c.len != 2) { return 4; }
    if (c.compare(a) != 0) { return 5; }
    if (!str_equals(a, c)) { return 6; }
    if (str_equals(a, b)) { return 7; }
    return 0;
}
