use std.string;

type OwnedText = String;

fn main() -> i32 {
    var small = String.from("a\0b");
    print(small);
    small.push(99);
    if (small.len != 4 || small.byteAt(3) != 99) { return 1; }
    print(small);

    let aliased: OwnedText = String.from("alias\0ok");
    print(aliased);
    let qualified: std.string.String = String.from("qualified");
    print(qualified);

    var heap = String.withCapacity(64);
    heap.append("01234567890123456789012345678901");
    heap.push(0);
    heap.push(121);
    if (!heap.isHeap() || heap.len != 34) { return 2; }
    print(heap);
    heap.push(122);
    if (heap.len != 35 || heap.byteAt(34) != 122) { return 3; }
    print(heap);
    print("identity=ok");
    return 0;
}
