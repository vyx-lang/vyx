module application.text;

// The language-item fact grants the ABI; the class name is irrelevant.
@[lang_item("string")]
class Utf8Owner {
    public ptr: rawptr;
    public len: i64;
    public cap: i64;
    public owned: i64;
    public inline0: i64;
    public inline1: i64;
    public inline2: i64;
}

fn main() -> i32 {
    let text = Utf8Owner {
        ptr: null, len: 3, cap: 23, owned: 0,
        inline0: 0x620061, inline1: 0, inline2: 0
    };
    print("declared=", text);
    print("declared-again=", text);
    return 0;
}
