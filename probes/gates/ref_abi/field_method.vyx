module probe.ref_abi_field_method;

class Fat {
    public a: i64
    public b: i64
    public c: i64
    public d: i64
    public e: i64
    public f: i64
    public g: i64
    public h: i64
    public name: string

    public fn get(&self) -> i64 {
        return self.a;
    }
}

class Host {
    public m: Fat

    public fn via_field(self) -> i64 {
        return self.m.get();
    }

    public fn via_ref(self) -> i64 {
        return (&self.m).get();
    }
}

fn main() -> i32 {
    var h = Host {
        m: Fat { a: 7, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 8, name: "x" }
    };
    if (h.via_field() != 7) { return 1; }
    if (h.via_ref() != 7) { return 2; }
    return 0;
}
