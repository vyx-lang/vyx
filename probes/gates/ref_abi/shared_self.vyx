module probe.ref_abi_shared_self;

class Cell {
    public n: i64

    public fn get(&self) -> i64 {
        return self.n;
    }

    public fn bump(&mut self) -> void {
        self.n = self.n + 1;
    }
}

fn read_cell(c: &Cell) -> i64 {
    return c.get();
}

fn main() -> i32 {
    var x = Cell { n: 3 };
    if (read_cell(&x) != 3) { return 1; }
    x.bump();
    if (x.n != 4) { return 2; }
    return 0;
}
