module probe.ref_abi;

// Isolated cases: overlapping borrows are a checker issue, not this probe.
// Each function owns its locals and only creates one live borrow at a time.

class Cell {
    public x: i64
    public y: i64
    public z: i64

    public fn bump(self) -> void {
        self.x = self.x + 1;
    }

    public fn get_x(self) -> i64 {
        return self.x;
    }
}

class Wrap {
    public cell: Cell
}

fn add_mut(c: &mut Cell, n: i64) -> void {
    c.x = c.x + n;
}

fn read_ref(c: &Cell) -> i64 {
    return c.x;
}

fn take_copy(c: Cell) -> i64 {
    return c.x;
}

fn case_shared_local() -> i32 {
    var c = Cell { x: 1, y: 2, z: 3 };
    let r = &c;
    if (read_ref(r) != 1) { return 1; }
    if (read_ref(&c) != 1) { return 2; }
    return 0;
}

fn case_mut_local() -> i32 {
    var c = Cell { x: 1, y: 2, z: 3 };
    add_mut(&mut c, 10);
    if (c.x != 11) { return 3; }
    add_mut(&mut c, 1);
    if (c.x != 12) { return 4; }
    return 0;
}

fn case_named_mut_local() -> i32 {
    var c = Cell { x: 1, y: 2, z: 3 };
    let m = &mut c;
    add_mut(m, 10);
    if (c.x != 11) { return 14; }
    return 0;
}

fn case_method_on_value() -> i32 {
    var c = Cell { x: 12, y: 2, z: 3 };
    c.bump();
    if (c.x != 13) { return 5; }
    if (c.get_x() != 13) { return 6; }
    return 0;
}

fn case_nested_mutref() -> i32 {
    var w = Wrap { cell: Cell { x: 100, y: 0, z: 0 } };
    add_mut(&mut w.cell, 5);
    if (w.cell.x != 105) { return 7; }
    if (read_ref(&w.cell) != 105) { return 8; }
    return 0;
}

fn case_nested_field_method() -> i32 {
    var w = Wrap { cell: Cell { x: 105, y: 0, z: 0 } };
    w.cell.bump();
    if (w.cell.x != 106) { return 9; }
    if (w.cell.get_x() != 106) { return 10; }
    return 0;
}

fn bump_nested(w: &mut Wrap) -> void {
    add_mut(&mut w.cell, 1);
}

fn case_mutref_of_mutref_field() -> i32 {
    var w = Wrap { cell: Cell { x: 106, y: 0, z: 0 } };
    bump_nested(&mut w);
    if (w.cell.x != 107) { return 11; }
    return 0;
}

fn case_deref_copy_local() -> i32 {
    var c = Cell { x: 13, y: 2, z: 3 };
    let r = &c;
    let copied = take_copy(*r);
    if (copied != 13) { return 12; }
    return 0;
}

fn case_deref_copy_nested() -> i32 {
    var w = Wrap { cell: Cell { x: 107, y: 0, z: 0 } };
    let nested_copy = take_copy(*(&w.cell));
    if (nested_copy != 107) { return 13; }
    return 0;
}

fn main() -> i32 {
    var rc = case_shared_local();
    if (rc != 0) { return rc; }
    rc = case_mut_local();
    if (rc != 0) { return rc; }
    rc = case_named_mut_local();
    if (rc != 0) { return rc; }
    rc = case_method_on_value();
    if (rc != 0) { return rc; }
    rc = case_nested_mutref();
    if (rc != 0) { return rc; }
    rc = case_nested_field_method();
    if (rc != 0) { return rc; }
    rc = case_mutref_of_mutref_field();
    if (rc != 0) { return rc; }
    rc = case_deref_copy_local();
    if (rc != 0) { return rc; }
    rc = case_deref_copy_nested();
    if (rc != 0) { return rc; }
    return 0;
}
