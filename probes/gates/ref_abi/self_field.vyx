module probe.ref_abi_self_field;

class Cell {
    public x: i64
    public y: i64
    public z: i64
    public w: i64

    public fn bump(self) -> void {
        self.x = self.x + 1;
    }

    public fn get_x(self) -> i64 {
        return self.x;
    }
}

class Wrap {
    public cell: Cell
    public extra: i64

    public fn bump_cell(self) -> void {
        self.cell.bump();
    }

    public fn add_via_mutref(self, n: i64) -> void {
        add_mut(&mut self.cell, n);
    }

    public fn read_via_ref(self) -> i64 {
        return read_ref(&self.cell);
    }

    public fn copy_cell(self) -> i64 {
        return take_copy(*(&self.cell));
    }
}

fn add_mut(c: &mut Cell, n: i64) -> void {
    c.x = c.x + n;
}

fn read_ref(c: &Cell) -> i64 {
    return c.x;
}

fn take_copy(c: Cell) -> i64 {
    return c.x + c.y + c.z + c.w;
}

fn take_mut_copy(c: &mut Cell) -> i64 {
    return take_copy(*c);
}

class Big {
    public a: i64
    public b: i64
    public c: i64
    public d: i64
    public e: i64
    public f: i64
    public g: i64
    public h: i64

    public fn bump(self) -> void {
        self.a = self.a + 1;
    }

    public fn sum(self) -> i64 {
        return self.a + self.b + self.c + self.d + self.e + self.f + self.g + self.h;
    }
}

class BigWrap {
    public big: Big

    public fn bump_big(self) -> void {
        self.big.bump();
    }

    public fn add_big(self, n: i64) -> void {
        add_big_mut(&mut self.big, n);
    }
}

fn add_big_mut(b: &mut Big, n: i64) -> void {
    b.a = b.a + n;
}

fn take_big(b: Big) -> i64 {
    return b.sum();
}

fn take_big_from_mut(b: &mut Big) -> i64 {
    return take_big(*b);
}

fn main() -> i32 {
    var w = Wrap { cell: Cell { x: 10, y: 20, z: 30, w: 40 }, extra: 0 };
    w.bump_cell();
    if (w.cell.x != 11) { return 1; }
    w.add_via_mutref(4);
    if (w.cell.x != 15) { return 2; }
    if (w.read_via_ref() != 15) { return 3; }
    if (w.copy_cell() != 105) { return 4; }

    var c = Cell { x: 1, y: 2, z: 3, w: 4 };
    if (take_mut_copy(&mut c) != 10) { return 5; }

    var bw = BigWrap {
        big: Big { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
    };
    bw.bump_big();
    if (bw.big.a != 2) { return 6; }
    bw.add_big(10);
    if (bw.big.a != 12) { return 7; }
    if (take_big_from_mut(&mut bw.big) != 47) { return 8; }
    if (bw.big.a != 12) { return 9; }
    return 0;
}
