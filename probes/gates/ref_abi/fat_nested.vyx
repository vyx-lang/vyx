module probe.ref_abi_fat;

class Inner {
    public a: i64
    public b: i64
    public c: i64
    public d: i64
    public name: string

    public fn bump(self) -> void {
        self.a = self.a + 1;
    }

    public fn get_a(self) -> i64 {
        return self.a;
    }

    public fn get_name(self) -> string {
        return self.name;
    }
}

class Builder {
    public unit: Inner
    public tag: string
    public n0: i64
    public n1: i64
    public n2: i64
    public n3: i64
    public n4: i64
    public n5: i64
}

fn add_mut(u: &mut Inner, n: i64) -> void {
    u.a = u.a + n;
}

fn take_copy(u: Inner) -> i64 {
    return u.a;
}

fn pipeline(u: &mut Inner) -> void {
    add_mut(u, 1);
    u.bump();
}

fn run_nested(b: &mut Builder) -> void {
    pipeline(&mut b.unit);
}

fn from_mut_copy(u: &mut Inner) -> i64 {
    return take_copy(*u);
}

fn main() -> i32 {
    var b = Builder {
        unit: Inner { a: 10, b: 20, c: 30, d: 40, name: "u" },
        tag: "b",
        n0: 0, n1: 1, n2: 2, n3: 3, n4: 4, n5: 5
    };
    run_nested(&mut b);
    if (b.unit.a != 12) { return 1; }
    if (b.unit.get_a() != 12) { return 2; }
    if (b.unit.get_name() != "u") { return 3; }
    if (from_mut_copy(&mut b.unit) != 12) { return 4; }
    b.unit.bump();
    if (b.unit.a != 13) { return 5; }
    return 0;
}
