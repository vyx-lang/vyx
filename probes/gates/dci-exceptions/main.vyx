@[dci_import("shared.dcib")]
extern "dci" {
    class eh.Guard {
        Guard(id: i32);
        ~Guard();
    };
    fn contract_throw(mode: i32) -> i32;
}
extern "C" {
    fn harness(callback: rawptr, mode: i32) -> i32;
    fn record_drop(id: i32);
}

class LocalGuard {
    public id: i32
    public LocalGuard(id: i32) { return LocalGuard { id: id }; }
    public static fn new(id: i32) -> LocalGuard { return LocalGuard { id: id }; }
    public fn drop() { record_drop(self.id); }
}

fn leaf(mode: i32) -> i32 {
    var outer = eh.Guard(1);
    if (mode == 2) {
        let failed = eh.Guard(-9);
        return 99;
    }
    {
        var inner = eh.Guard(2);
        if (mode == 3) { return 30; }
        if (mode == 10) {
            outer = eh.Guard(11);
            return 31;
        }
        if (mode == 4) { inner = eh.Guard(4); }
        if (mode == 5) {
            for (i in 0..4) {
                let loop = eh.Guard(5);
                if (i == 0) { continue; }
                if (i == 1) { break; }
            }
        }
        if (mode == 6) {
            let local = LocalGuard.new(6);
            return contract_throw(mode);
        }
        if (mode == 7) {
            let literal = LocalGuard { id: 7 };
            return contract_throw(mode);
        }
        if (mode == 8) {
            let bomb = eh.Guard(8);
            return contract_throw(mode);
        }
        if (mode == 9) {
            let constructed = LocalGuard(9);
            return contract_throw(mode);
        }
        return contract_throw(mode);
    }
}

fn middle(mode: i32) -> i32 {
    let guard = eh.Guard(3);
    return leaf(mode);
}

fn main() -> i32 {
    for (mode in 0..11) {
        let result = harness(middle as rawptr, mode);
        if (result != 0) { return result; }
    }
    print("dci shared unwind OK");
    return 0;
}
