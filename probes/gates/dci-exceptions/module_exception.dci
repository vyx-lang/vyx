{
  "$schema": "dci-1.0.schema.json",
  "dci": "1.0",
  "kind": "abi",
  "profile": {
    "id": "dci.shared-unwind.exception-module",
    "version": "1.0",
    "level": "L1",
    "consumer_modes": [
      "direct"
    ],
    "obligation_mode": "required"
  },
  "source": {
    "language": "contract-fixture",
    "adapter": {
      "name": "checked-fixture",
      "version": "1.0"
    }
  },
  "target": {
    "triple": "x86_64-pc-windows-msvc",
    "architecture": "x86_64",
    "pointer_width": 64,
    "endianness": "little",
    "object_format": "coff",
    "environment": "windows",
    "abi": "system",
    "abi_family": "win64"
  },
  "control_flow": {
    "default_boundary": "shared_abi",
    "propagation": {
      "mode": "shared_abi",
      "abi": "dci.eh.msvc-cxx.v1"
    }
  },
  "exports": {
    "symbols": [
      {
        "name": "contract_throw",
        "link_name": "contract_throw",
        "kind": "function",
        "calling_convention": "system",
        "params": [
          {
            "name": "value",
            "type": {
              "name": "i32",
              "kind": "primitive",
              "nullable": false,
              "reference": "value"
            },
            "location": "abi",
            "ownership": "copy"
          }
        ],
        "return": {
          "type": {
            "name": "i32",
            "kind": "primitive",
            "nullable": false,
            "reference": "value"
          },
          "location": "abi",
          "ownership": "copy"
        },
        "abi": {
          "calling_convention": "system",
          "variadic": false,
          "parameters": [
            {
              "index": 0,
              "passing": "direct",
              "size": 4
            }
          ],
          "return": {
            "passing": "direct",
            "size": 4
          }
        }
      }
    ],
    "layouts": []
  },
  "obligations": {
    "version": "1",
    "lifecycle": [],
    "exceptions": [
      {
        "subject": "contract_throw",
        "boundary": "shared_abi",
        "abi": "dci.eh.msvc-cxx.v1",
        "cleanup": "unwind",
        "must_preserve_identity": true
      }
    ],
    "edges": [
      {
        "from": "exception:contract_throw",
        "to": "lifecycle:eh::Guard",
        "kind": "cleanup-before-propagate"
      }
    ]
  }
}