@[dci_import("inline.dcib")]
extern "dci" {
    struct eh.Inline { public slot: i64; };
    fn inline_create(seed: i64) -> eh.Inline;
    fn inline_destroy(value: *eh.Inline);
    fn contract_throw(mode: i32) -> i32;
}
extern "C" { fn inline_harness(callback: rawptr) -> i32; }

fn scoped(mode: i32) -> i32 {
    let inline = inline_create(10);
    return contract_throw(mode);
}
fn main() -> i32 { return inline_harness(scoped as rawptr); }
