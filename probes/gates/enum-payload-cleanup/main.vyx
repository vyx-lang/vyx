use std.core;
extern "C" {
    fn witness_create(); fn witness_destroy();
    fn witness_created() -> i32; fn witness_destroyed() -> i32;
}
class Witness {
    public token: i32;
    public static fn make() -> Witness { witness_create(); return Witness { token: 1 }; }
    public fn drop() { witness_destroy(); }
}
fn direct_result() { let value: Result<i32, Witness> = Err(Witness.make()); }
fn predicate_result() { let value: Result<i32, Witness> = Err(Witness.make()); assert(value.is_err()); }
fn temporary_result() { assert(Result::<i32, Witness>.err(Witness.make()).is_err()); }
fn direct_option() { let value: Option<Witness> = Some(Witness.make()); }
fn unpack_result() { let value: Result<i32, Witness> = Err(Witness.make()); let payload = value.unwrap_err(); }
fn main() -> i32 {
    direct_result(); predicate_result(); temporary_result(); direct_option(); unpack_result();
    print("enum payload witnesses created=", witness_created(), " destroyed=", witness_destroyed());
    assert(witness_created() == 5 && witness_destroyed() == 5, "owning enum payloads must each be destroyed exactly once");
    return 0;
}
