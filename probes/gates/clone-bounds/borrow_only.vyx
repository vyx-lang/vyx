use std.ref;
use std.collections;

extern "C" { fn malloc(size: i64) -> rawptr; fn free(data: rawptr); }
var drops: i32 = 0;
class Unique {
    public data: rawptr;
    public value: i64;
    public fn drop() {
        if (self.data != null) {
            free(self.data);
            self.data = null;
            drops = drops + 1;
        }
    }
}

fn borrow_only() -> i32 {
    let boxed = Box::<Unique>.new(Unique { data: malloc(8), value: 11 });
    let shared = Ref::<Unique>.new(Unique { data: malloc(8), value: 17 });
    let shared_again = shared.clone();
    var items = Vec::<Unique>.new();
    items.push(Unique { data: malloc(8), value: 23 });
    if (boxed.deref().value != 11 || shared_again.deref().value != 17) { return 1; }
    if (items.get_ref(0).value != 23) { return 2; }
    var handles = Vec::<Ref<Unique>>.new();
    handles.push(shared.clone());
    let copied = handles.get(0);
    let boxed_shared = Box::<Ref<Unique>>.new(shared.clone());
    let copied_again = boxed_shared.get();
    if (copied.deref().value != 17 || copied_again.deref().value != 17) { return 4; }
    var mapping = Dict::<i32, Ref<Unique>>.new();
    mapping.put(1, shared.clone());
    let mapped = mapping.get(1);
    var stack = Stack::<Ref<Unique>>.new();
    stack.push(shared.clone());
    let top = stack.peek();
    var queue = Queue::<Ref<Unique>>.new();
    queue.enqueue(shared.clone());
    let front = queue.peek();
    if (mapped.deref().value != 17 || top.deref().value != 17 || front.deref().value != 17) { return 5; }


    return 0;
}

fn main() -> i32 {
    let result = borrow_only();
    if (result != 0) { return result; }
    if (drops != 3) { return 3; }
    print("borrow-only=ok");
    return 0;
}
