use std.ref;
use std.clone;

interface Measure { fn measure(&self) -> i64; }
class Measured { public value: i64; }
impl Measure for Measured {
    fn measure(&self) -> i64 { return self.value; }
}

class Cell<T> {
    public value: T;
    public fn read<U>(&self, value: &U) -> U where U: Clone { return value.clone(); }
    public fn measure(&self) -> i64 where T: Measure { return self.value.measure(); }
}

class Holder<T> {
    public owner: Box<T>;
    public fn load(&self) -> T where T: Clone { return self.owner.get(); }
}

fn bounded<T>(value: &Box<T>) -> T where T: Clone { return value.get(); }
fn forwarded<T>(value: &Box<T>) -> T { return value.get(); }

fn main() -> i32 {
    let cell = Cell::<Measured> { value: Measured { value: 29 } };
    let source: i64 = 31;
    if (cell.read::<i64>(&source) != 31 || cell.measure() != 29) { return 1; }
    let boxed = Box::<i64>.new(37);
    if (bounded::<i64>(&boxed) != 37 || forwarded::<i64>(&boxed) != 37) { return 2; }
    let holder = Holder::<i64> { owner: Box::<i64>.new(47) };
    if (holder.load() != 47) { return 3; }
    print("generic-bounds=ok");
    return 0;
}
