use std.ref;
use std.collections;

var clones: i32 = 0;
class Value {
    public number: i64;
    public fn clone(&self) -> Value {
        clones += 1;
        return Value { number: self.number };
    }
}

fn main() -> i32 {
    let boxed = Box::<Value>.new(Value { number: 41 });
    let copied = boxed.get();
    var values = Vec::<Value>.new();
    values.push(Value { number: 43 });
    let other = values.get(0);
    if (copied.number != 41 || other.number != 43 || clones != 2) { return 1; }
    print("structural-clone=ok");
    return 0;
}
