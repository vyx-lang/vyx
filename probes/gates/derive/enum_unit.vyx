module probe.derive.enum_unit;

use std.hash;

@[derive(Clone, Eq, Ord, Hashable)]
enum Color {
    Red,
    Green,
    Blue,
}

fn main() -> i32 {
    let a = Color::Red();
    let b = a.clone();
    if (!a.operator_eq(b)) { return 1; }
    let g = Color::Green();
    if (a.operator_eq(g)) { return 2; }
    if (a.compare(g) >= 0) { return 3; }
    if (g.compare(a) <= 0) { return 4; }
    if (a.hash() == g.hash()) { return 5; }
    return 0;
}
