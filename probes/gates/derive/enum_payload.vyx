module probe.derive.enum_payload;

use std.collections;

@[derive(Clone)]
enum Msg {
    Empty,
    Nums(Vec<i32>),
}

fn main() -> i32 {
    var src = Vec::<i32>.new();
    src.push(1);
    var a = Nums(src);
    var b = a.clone();
    match (b) {
        case Nums(items) => {
            items.push(2);
            if (items.size() != 2) { return 2; }
        }
        default => { return 9; }
    }
    match (a) {
        case Nums(items) => {
            if (items.size() != 1) { return 1; }
            if (items.get(0) != 1) { return 3; }
        }
        default => { return 8; }
    }
    let empty = Empty;
    var c = empty.clone();
    match (c) {
        case Empty => { return 0; }
        default => { return 7; }
    }
}
