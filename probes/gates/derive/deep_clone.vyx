module probe.derive.deep_clone;

use std.collections;

@[derive(Clone)]
class Bag {
    public items: Vec<i32>;
}

fn main() -> i32 {
    var a = Bag { items: Vec::<i32>.new() };
    a.items.push(1);
    var b = a.clone();
    b.items.push(2);
    if (a.items.size() != 1) { return 1; }
    if (b.items.size() != 2) { return 2; }
    if (a.items.get(0) != 1) { return 3; }
    if (b.items.get(0) != 1) { return 4; }
    if (b.items.get(1) != 2) { return 5; }
    return 0;
}
