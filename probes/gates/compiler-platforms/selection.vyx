module platform_selection;

@[platform("windows")]
public let SELECTED_GLOBAL: i32 = 11;
@[platform("linux")]
public let SELECTED_GLOBAL: i32 = 22;
@[platform("macos")]
public let SELECTED_GLOBAL: i32 = 33;
@[platform("android")]
public let SELECTED_GLOBAL: i32 = 44;

@[platform("windows")]
public const SELECTED_CONST: i32 = 101;
@[platform("linux")]
public const SELECTED_CONST: i32 = 102;
@[platform("macos")]
public const SELECTED_CONST: i32 = 103;
@[platform("android")]
public const SELECTED_CONST: i32 = 104;

public fn selected_global() -> i32 { return SELECTED_GLOBAL; }
public fn selected_constant() -> i32 { return SELECTED_CONST; }
