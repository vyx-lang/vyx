// Test-only loader/lookup controls. The runner injects the real production
// sema_lazy_load_pending_until_symbol and its variant/prelude query helpers.
// This is a loader-contract unit test, not a real module parser substitute.
public class ImportEpochContract {
    public pending_imports: string;
    public profile_lazy_pending_calls: i64;
    public lazy_import_epoch: i64;
    public fixture_mode: i32;
    public fixture_known: bool;
    public known_queries: i32;
    public load_attempts: i32;
    public after_attempts: i32;
    public miss_notes: i32;

    public fn sema_symbol_known(self, name: string) -> bool {
        self.known_queries = self.known_queries + 1;
        return self.fixture_known;
    }
    public fn sema_load_type_alias_target_if_any(self, name: string) -> bool { return false; }
    public fn sema_lazy_symbol_miss_seen(self, name: string) -> bool { return false; }
    public fn sema_lazy_symbol_miss_note(self, name: string) { self.miss_notes = self.miss_notes + 1; }
    public fn sema_pending_registry_has_symbol(self, name: string) -> bool { return true; }
    public fn sema_load_registry_symbol_any(self, name: string) -> bool { return false; }
    public fn fixture_nested_import(self) {
        self.lazy_import_epoch = self.lazy_import_epoch + 1;
        self.fixture_known = true;
    }
    public fn sema_load_module_symbol(self, mod: string, name: string) -> bool {
        self.load_attempts = self.load_attempts + 1;
        if (mod == "After") { self.after_attempts = self.after_attempts + 1; }
        if (mod != "Mutation") { return false; }
        if (self.fixture_mode == 0) {
            self.lazy_import_epoch = self.lazy_import_epoch + 1;
            self.fixture_known = true;
            return false;
        }
        if (self.fixture_mode == 2) { return true; }
        if (self.fixture_mode == 3) { self.fixture_nested_import(); return false; }
        if (self.fixture_mode == 4) { self.lazy_import_epoch = self.lazy_import_epoch + 1; }
        return false;
    }

    // PRODUCTION_METHODS
}

fn main() -> i32 {
    var mode: i32 = 0;
    while (mode < 5) {
        var probe: ImportEpochContract;
        probe.pending_imports = "Idle\nMutation\nAfter\n";
        probe.fixture_mode = mode;
        probe.fixture_known = false;
        probe.lazy_import_epoch = 0;
        probe.profile_lazy_pending_calls = 0;
        probe.known_queries = 0;
        probe.load_attempts = 0;
        probe.after_attempts = 0;
        probe.miss_notes = 0;
        let known = probe.sema_lazy_load_pending_until_symbol("target");
        if (mode == 0 || mode == 3) {
            if (!known || probe.load_attempts != 2 || probe.after_attempts != 0
                || probe.known_queries != 2 || probe.lazy_import_epoch != 1) {
                print("FAIL: false-but-mutating loader was not observed immediately"); return 1;
            }
        } else {
            var expected_queries: i32 = 2;
            if (mode == 4) { expected_queries = 3; }
            if (known || probe.load_attempts != 3 || probe.after_attempts != 1
                || probe.known_queries != expected_queries) {
                print("FAIL: unchanged loader or changed unresolved facts query count"); return 2;
            }
            if (mode == 2 && probe.miss_notes != 0) {
                print("FAIL: existing progress result semantics changed"); return 3;
            }
        }
        mode = mode + 1;
    }
    print("frontend_epoch: OK false-mutating / unchanged / true-unchanged / nested / changed-miss");
    return 0;
}
