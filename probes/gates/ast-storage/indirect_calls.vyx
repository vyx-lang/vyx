module probes.ast_storage.indirect_calls;

extern "C" { fn abs(value: i32) -> i32; }

fn increment(value: i32) -> i32 { return value + 1; }
fn invoke(callback: fn(i32) -> i32, value: i32) -> i32 {
    return callback(value);
}
fn main() -> i32 {
    let callback = increment;
    if (callback(41) != 42 || invoke(callback, 10) != 11) { return 1; }
    let native = abs;
    if (native(-17) != 17) { return 2; }
    print("indirect calls ok");
    return 0;
}
