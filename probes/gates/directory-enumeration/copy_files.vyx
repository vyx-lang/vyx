use std.core;
use std.fs;

fn main() -> i32 {
    assert_eq(argCount(), 3);
    let source = getArg(1);
    let destination = getArg(2);
    assert_eq(copyFilesWithExtension(source, destination, ".vyx"), 2);
    assert_eq(readFile(destination + "/main.vyx"), "main payload");
    print("directory copy PASS");
    return 0;
}
