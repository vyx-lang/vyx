use std.ref;
use std.collections;

interface MutableValue { fn bump(&mut self) -> i32; }
class Value : MutableValue {
    public n: i32;
    public fn bump(&mut self) -> i32 { self.n = self.n + 1; return self.n; }
}

fn main() -> i32 {
    var value = Box::<Value>.new(Value { n: 41 });
    { var item = value.deref_mut(); if (item.bump() != 42) { return 1; } }
    if (value.deref().n != 42) { return 2; }
    value.drop();
    var dynamic = Box::<dyn MutableValue>.new(Value { n: 7 });
    { var item = dynamic.deref_mut(); if (item.bump() != 8) { return 3; } }
    dynamic.drop();
    var values = Vec::<Value>.new();
    values.push(Value { n: 9 });
    {
        var item = values.get_mut(0);
        if (item.bump() != 10) { return 4; }
    }
    { let item = values.get_ref(0); if (item.n != 10) { return 5; } }
    values.destroy();
    print("Box mutable borrow PASS");
    return 0;
}
