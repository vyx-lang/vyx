use std.ffi;

fn main() -> i32 {
    let n: c_int = 40;
    let m: c_int = 2;
    if ((n + m) != 42) { return 1; }
    let owned = CString.from_string("hello");
    if (owned.as_ptr() == null) { return 2; }
    let borrowed = owned.as_c_str();
    if (borrowed.to_string() != "hello") { return 3; }
    print("ok");
    return 0;
}
