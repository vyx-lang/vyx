@[repr(C)]
class Point {
    public x: i32;
    public y: i32;
}

@[repr(C, packed)]
class Packed {
    public a: i8;
    public b: i32;
}

@[repr(C, align(16))]
class Aligned {
    public x: i32;
}

@[repr(C)]
class Quad {
    public a: i32;
    public b: i32;
    public c: i32;
    public d: i32;
}

@[repr(C)]
class F2 {
    public a: f32;
    public b: f32;
}

extern "C" {
    fn point_sum(p: Point) -> i32;
    @[link_name("named_sum")]
    fn renamed_sum(a: i32, b: i32) -> i32;
    fn packed_size() -> i32;
    fn packed_off_b() -> i32;
    fn aligned_size() -> i32;
    fn aligned_align() -> i32;
    fn fill_packed(p: rawptr);
    fn read_packed_b(p: rawptr) -> i32;
    fn call_cb(cb: cfn(i32) -> i32, x: i32) -> i32;
    fn sum_ints(n: i32, ...) -> i32;
    fn c_strlen_i32(s: rawptr) -> i32;
    fn call_exported(a: i32, b: i32) -> i32;
    fn call_export_name(a: i32, b: i32) -> i32;
    fn make_point(x: i32, y: i32) -> Point;
    fn quad_sum(q: Quad) -> i32;
    fn packed_val(p: Packed) -> i32;
    fn f2_sum(s: F2) -> f32;
}

@[no_mangle]
public fn vyx_add(a: i32, b: i32) -> i32 {
    return a + b;
}

@[no_mangle]
public fn bump_c(x: i32) -> i32 {
    return x + 1;
}

@[export_name("vyx_times")]
public fn product(a: i32, b: i32) -> i32 {
    return a * b;
}

fn main() -> i32 {
    let p = Point { x: 10, y: 32 };
    if (point_sum(p) != 42) { return 1; }
    if (renamed_sum(20, 22) != 42) { return 2; }

    var packed = Packed { a: 7, b: 99 };
    if (read_packed_b(to_rawptr(&packed)) != 99) { return 3; }
    fill_packed(to_rawptr(&packed));
    if (packed.a != 1) { return 4; }
    if (packed.b != 2) { return 5; }
    if (sizeof::<Packed>() != packed_size() as i64) { return 6; }
    if (packed_off_b() != 1) { return 7; }

    if (sizeof::<Aligned>() != aligned_size() as i64) { return 8; }
    if (alignof::<Aligned>() != aligned_align() as i64) { return 9; }

    if (call_cb(bump_c, 41) != 42) { return 10; }
    if (sum_ints(3, 10, 20, 12) != 42) { return 11; }
    if (call_exported(20, 22) != 42) { return 12; }
    if (call_export_name(6, 7) != 42) { return 14; }

    let made = make_point(10, 32);
    if (point_sum(made) != 42) { return 15; }
    let q = Quad { a: 10, b: 11, c: 12, d: 9 };
    if (quad_sum(q) != 42) { return 16; }
    if (packed_val(packed) != 3) { return 17; }
    let fs = F2 { a: 2.0, b: 40.0 };
    if ((f2_sum(fs) as i32) != 42) { return 18; }

    let hello = "hello";
    if (c_strlen_i32(hello.c_str()) != 5) { return 13; }
    print("ok");
    return 0;
}
