module main;

use std.string;

fn main() -> i32 {
    var text = String.from("abcdef");
    text = text.substring(1, 4);
    if (text.length() != 3 || !text.startsWith("bcd")) { return 1; }

    let slice: String = text.substring(0, 2);
    if (slice.length() != 2 || !slice.startsWith("bc")) { return 2; }

    var literal = String.empty();
    literal = "xyz";
    if (literal.length() != 3 || !literal.startsWith("xyz")) { return 3; }

    let annotated: String = "hello";
    if (annotated.length() != 5 || !annotated.startsWith("hello")) { return 4; }

    let upper = text.toUpper();
    if (upper.length() != 3 || !upper.startsWith("BCD")) { return 5; }
    let replaced = text.replace("c", "X");
    if (replaced.length() != 3 || !replaced.startsWith("bXd")) { return 6; }

    var heap = String.withCapacity(64);
    heap.append("abcdefghijklmnopqrstuvwxyz0123456789");
    heap = heap.substring(2, 28);
    if (heap.length() != 26 || !heap.startsWith("cde")) { return 7; }
    return 0;
}
