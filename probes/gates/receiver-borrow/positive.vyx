use std.collections;

class Buffer {
    public values: Vec<i32>;
    public marker: i64;

    public static fn create() -> Buffer {
        var values = Vec::<i32>.new();
        values.push(7);
        return Buffer { values: values, marker: 1234 };
    }

    public fn append(mut self, value: i32) -> Buffer {
        let before = inspectBorrowed(&self);
        appendBorrowed(&mut self, value);
        if (inspectBorrowed(&self) != before + 1) { panic("receiver mutation was lost"); }
        return self;
    }

    public fn size(&self) -> i64 { return self.values.len; }
    public fn destroy(&mut self) { self.values.destroy(); }
}

fn inspectBorrowed(value: &Buffer) -> i64 {
    if (value.marker != 1234) { panic("shared receiver borrow has wrong object address"); }
    return value.values.len;
}

fn appendBorrowed(value: &mut Buffer, next: i32) {
    if (value.marker != 1234 || value.values.len < 1 || value.values.len > 3) {
        panic("mutable receiver borrow has wrong object address");
    }
    value.values.push(next);
}

fn main() -> i32 {
    var buffer = Buffer.create().append(9).append(11);
    if (buffer.size() != 3 || buffer.values.get(0) != 7
        || buffer.values.get(1) != 9 || buffer.values.get(2) != 11) { return 1; }
    // Inline locals use a different representation from owning receivers.
    appendBorrowed(&mut buffer, 13);
    if (inspectBorrowed(&buffer) != 4 || buffer.values.get(3) != 13) { return 2; }
    buffer.destroy();
    print("receiver-borrow: OK");
    return 0;
}
