extern "C" {
    fn vyx_rt_raw_dup_bytes_total() -> i64;
    fn vyx_rt_process_private_bytes() -> i64;
    fn vyx_rt_process_peak_private_bytes() -> i64;
    fn vyx_bootstrap_now_ms() -> i64;
}

fn encoded_result(value: string) -> string {
    return value.len.toString() + ":" + value + "\n";
}

fn input_case(i: i64) -> string {
    if (i == 0) { return ""; }
    if (i == 1) { return "|"; }
    if (i == 2) { return "||"; }
    if (i == 3) { return "a"; }
    if (i == 4) { return "aa"; }
    if (i == 5) { return "b"; }
    if (i == 6) { return "a|b"; }
    if (i == 7) { return "b|a"; }
    if (i == 8) { return "|a"; }
    if (i == 9) { return "a|"; }
    if (i == 10) { return "|a|"; }
    if (i == 11) { return "a||b"; }
    if (i == 12) { return "a|a|b"; }
    if (i == 13) { return "b|a|b"; }
    if (i == 14) { return "Aa"; }
    if (i == 15) { return "B@"; }
    if (i == 16) { return "Aa|B@"; }
    if (i == 17) { return "B@|Aa|B@"; }
    if (i == 18) { return "a|Aa|aa"; }
    if (i == 19) { return " "; }
    if (i == 20) { return " a "; }
    if (i == 21) { return "\ta\r\n"; }
    if (i == 22) { return "a | b"; }
    if (i == 23) { return " a |a|a "; }
    if (i == 24) { return "a\tb"; }
    if (i == 25) { return readFile("whitespace.txt"); }
    if (i == 26) { return "module.Type.method"; }
    if (i == 27) { return "module.Type.method2"; }
    if (i == 28) { return "Namespace::Generic<i32>"; }
    if (i == 29) { return "函数|方法"; }
    if (i == 30) { return readFile("spaces_long.txt"); }
    return readFile("trim_long.txt");
}

fn main() -> i32 {
    if (getArg(1) == "memory") {
        let input = readFile(getArg(2));
        let before_private = vyx_rt_process_private_bytes();
        let started = vyx_bootstrap_now_ms();
        let merged = build_pipe_set_merge("", input);
        let elapsed = vyx_bootstrap_now_ms() - started;
        let after_private = vyx_rt_process_private_bytes();
        let peak_private = vyx_rt_process_peak_private_bytes();
        if (merged != input) { print("FAIL: large merge content/order"); return 1; }
        print("input_bytes=" + input.len.toString()
            + " private_before=" + before_private.toString() + " private_after=" + after_private.toString()
            + " peak_private=" + peak_private.toString() + " wall_ms=" + elapsed.toString());
        return 0;
    }
    let output_path = getArg(2);
    writeFile(output_path, "");
    var i: i64 = 0;
    while (i < 32) {
        var j: i64 = 0;
        while (j < 32) {
            let set = input_case(i);
            let value = input_case(j);
            if (getArg(1) == "debug") { writeFile("last_pair.txt", i.toString() + " " + j.toString()); }
            appendFile(output_path, encoded_result(build_pipe_set_has(set, value).toString()));
            appendFile(output_path, encoded_result(build_pipe_set_add(set, value)));
            appendFile(output_path, encoded_result(build_pipe_set_merge(set, value)));
            j = j + 1;
        }
        i = i + 1;
    }
    // Short return values must own their storage after StringBuilder teardown.
    let lengths = "0|1|23|24|63|64";
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= lengths.len) {
        if (pos == lengths.len || lengths.charAt(pos) == 124) {
            let length = lengths.substring(start, pos);
            let input = readFile("length_" + length + ".txt");
            let merged = build_pipe_set_merge("", input);
            let added = build_pipe_set_add("prefix", input);
            var churn: i32 = 0;
            while (churn < 16) {
                let other = build_pipe_set_merge("unrelated", "Aa|B@|more");
                if (other != "unrelated|Aa|B@|more") { return 2; }
                churn = churn + 1;
            }
            if (merged != input) { print("FAIL: short merge lifetime " + length); return 3; }
            var expected = "prefix";
            if (input.len > 0) { expected = expected + "|" + input; }
            if (added != expected) { print("FAIL: short add lifetime " + length); return 4; }
            appendFile(output_path, encoded_result(merged));
            appendFile(output_path, encoded_result(added));
            start = pos + 1;
        }
        pos = pos + 1;
    }
    print("build sets equivalence corpus OK");
    return 0;
}
