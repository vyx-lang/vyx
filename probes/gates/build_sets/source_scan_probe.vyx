fn main() -> i32 {
    if (!check_generic_root_scans()) { return 70; }
    if (build_ascii_lower("ABcZ09-/中文") != "abcz09-/中文") { return 40; }
    if (build_ascii_lower("") != "" || build_host_path("") != "") { return 41; }
    if (build_is_windows() && build_host_path("a/b\\c/中文") != "a\\b\\c\\中文") { return 42; }
    if (!build_is_windows() && build_host_path("a/b\\c/中文") != "a/b/c/中文") { return 43; }
    if (build_safe_obj_name("A1.z/b\\c:中文", ".obj") != "A1_z_b_c_______.obj") { return 44; }
    if (build_safe_obj_name("", ".obj") != ".obj") { return 45; }
    if (!build_source_contains_code_token("extern \"dci\"", "extern \"dci\"")) { return 50; }
    if (!build_source_contains_code_token("//extern \"dci\"\nextern \"cpp\"", "extern \"cpp\"")) { return 51; }
    if (build_source_contains_code_token("\"extern \\\"dci\\\"\"\n'extern' /*extern \"dci\"*/\n//extern \"dci\"", "extern \"dci\"")) { return 52; }
    if (build_source_contains_code_token("", "extern") || build_source_contains_code_token("exter", "extern") || build_source_contains_code_token("extern", "")) { return 53; }
    let attr = "@[" + "dci_import(";
    writeFile("imports.vyx", "//" + attr + "\"ghost.dcib\")]\n/*" + attr + "'ghost2.dcib')]*/\nlet text=\"" + attr + "'ghost3.dcib')]\";\n" + attr + "'one.dcib')]\n" + attr + "\"two.dcib\")]\n" + attr + "'one.dcib')]\n");
    let imports = build_dci_import_for_group("imports.vyx\n");
    if (dci_path_list_count(imports) != 2 || !dci_path_list_at(imports, 0).endsWith("one.dcib") || !dci_path_list_at(imports, 1).endsWith("two.dcib")) { return 56; }
    let dollar = "$";
    if (build_expand_env("A/$VYX_SCAN_TEST_VALUE/B") != "A/fixture-value/B") { return 30; }
    if (build_expand_env(dollar + "{ VYX_SCAN_TEST_VALUE }") != "fixture-value") { return 31; }
    if (build_expand_env(dollar + "{VYX_SCAN_TEST_EMPTY:-" + dollar + "{VYX_SCAN_TEST_VALUE}/default}") != "fixture-value/default") { return 32; }
    if (build_expand_env(dollar + "{VYX_SCAN_TEST_LITERAL:-fallback}") != "fallback") { return 33; }
    let unmatched = "before$!" + dollar + "{unclosed";
    if (build_expand_env(unmatched) != unmatched) { return 34; }
    if (build_expand_env("$VYX_SCAN_TEST_EMPTY/end") != "/end") { return 35; }
    if (build_is_windows() && build_expand_env("%VYX_SCAN_TEST_VALUE%/%%/%unclosed") != "fixture-value//%unclosed") { return 36; }
    if (!build_is_windows() && build_expand_env("%VYX_SCAN_TEST_VALUE%") != "%VYX_SCAN_TEST_VALUE%") { return 37; }
    if (build_quote_arg("") != "\"\"") { return 20; }
    if (build_quote_arg("alpha\\path with spaces") != "\"alpha\\path with spaces\"") { return 21; }
    if (build_quote_arg("a\"b") != "\"a\\\"b\"") { return 22; }
    if (build_quote_arg("中文") != "\"中文\"") { return 23; }
    let rows = "a\t1\t0\tfirst\r\na-long\t1\t0\tsecond\nempty\t1\t0\t\nlast\t1\t0\tend";
    let keys = "a\t1\t0\t|a-long\t1\t0\t|empty\t1\t0\t|missing\t1\t0\t|last\t1\t0\t";
    let expected = "first|second||<MISS>|end";
    var result: string = "";
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= keys.len) {
        if (pos == keys.len || keys.charAt(pos) == 124) {
            if (start > 0) { result = result + "|"; }
            result = result + build_source_scan_cache_get(rows, keys.substring(start, pos));
            start = pos + 1;
        }
        pos = pos + 1;
    }
    if (result != expected) { print("scan cache lookup FAIL"); return 1; }
    if (build_source_scan_cache_get("\n\r\n", "any") != "<MISS>") { return 2; }
    g_build_module_name_cache = rows;
    g_build_module_identity_cache = rows;
    if (build_module_name_cache_get("a-long\t1\t0\t") != "second" || build_module_identity_cache_get("last\t1\t0\t") != "end") { return 59; }
    let lookup_before = vyx_rt_process_private_bytes();
    var lookup_i: i32 = 0;
    while (lookup_i < 20000) {
        if (build_module_name_cache_get("missing\t1\t0\t") != "<MISS>" || build_module_identity_cache_get("last\t1\t0\t") != "end") { return 60; }
        lookup_i = lookup_i + 1;
    }
    if (vyx_rt_process_private_bytes() - lookup_before > 33554432) { return 61; }
    writeFile("first.vyx", "one");
    writeFile("second.vyx", "two");
    let first = build_source_text_for_scan("first.vyx");
    if (first != "one" || build_source_text_for_scan("second.vyx") != "two") { return 3; }
    if (build_source_text_for_scan("first.vyx").c_str() != first.c_str()) { return 4; }
    writeFile("first.vyx", "changed length");
    if (build_source_text_for_scan("first.vyx") != "changed length") { return 5; }
    writeFile("module.vyx", "use std.math;\nimport std::threading;\n");
    if (!build_source_uses_std_module("module.vyx", "std.math") || !build_source_uses_std_module("module.vyx", "std.threading")) { return 47; }
    if (build_source_uses_std_module("module.vyx", "std.vio") || build_source_uses_std_module("absent.vyx", "std.math")) { return 48; }
    writeFile("module.vyx", "use std.vio;\n");
    if (!build_source_uses_std_module("module.vyx", "std.vio") || build_source_uses_std_module("module.vyx", "std.math")) { return 49; }
    var payload = StringBuilder.withCapacity(2097152);
    var i: i32 = 0;
    while (i < 32768) { payload.append("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"); i = i + 1; }
    var owned = payload.intoString();
    let quote_before = vyx_rt_process_private_bytes();
    if (build_source_contains_code_token(owned.raw(), "extern \"dci\"")) { return 54; }
    if (vyx_rt_process_private_bytes() - quote_before > 33554432) { return 55; }
    if (build_ascii_lower(owned.raw()) != owned.raw() || build_host_path(owned.raw()) != owned.raw()) { return 46; }
    let expanded = build_expand_env(owned.raw());
    if (expanded != owned.raw()) { return 38; }
    if (vyx_rt_process_private_bytes() - quote_before > 33554432) { return 39; }
    let quote = build_quote_arg(owned.raw());
    if (quote.len != 2097154 || quote.charAt(0) != 34 || quote.charAt(2097153) != 34) { return 24; }
    if (vyx_rt_process_private_bytes() - quote_before > 33554432) { return 25; }
    let rows = "anchor\n" + owned.raw();
    let rows_before = vyx_rt_process_private_bytes();
    var lookup: i32 = 0;
    while (lookup < 100) {
        if (build_append_unique_line(rows, "anchor") != rows) { return 62; }
        if (rows.charAt(7) != 48) { return 63; }
        lookup = lookup + 1;
    }
    if (vyx_rt_process_private_bytes() - rows_before > 33554432) { return 64; }
    writeFile("large.vyx", owned.raw());
    let import_before = vyx_rt_process_private_bytes();
    if (build_dci_import_for_group("large.vyx\n") != "") { return 57; }
    if (vyx_rt_process_private_bytes() - import_before > 33554432) { return 58; }
    owned.destroy();
    payload.destroy();
    let before = vyx_rt_process_private_bytes();
    i = 0;
    while (i < 500) {
        let text = build_source_text_for_scan("large.vyx");
        if (text.len != 2097152 || text.charAt(100) != 52) { return 6; }
        i = i + 1;
    }
    let delta = vyx_rt_process_private_bytes() - before;
    if (before < 0 || delta > 33554432) { print("source scan retained-memory FAIL"); return 7; }
    print("scan cache PASS private_delta=" + delta.toString());
    return 0;
}
