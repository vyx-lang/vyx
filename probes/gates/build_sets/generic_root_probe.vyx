fn check_generic_root_scans() -> bool {
    var texts = Vec::<string>.with_capacity(12);
    texts.push("");
    texts.push("f::<i32>(); f::<i64>(); f::<i32>();");
    texts.push("foo::<i32>(); af::<i32>(); namespace.f::<u8>(); .f::<u16>(); f::<u32>();");
    texts.push("outer::<inner::<i32>>(); tail::<u8>();");
    texts.push("outer::< inner::<i32>, g::<u8> >();");
    texts.push("f::<Vec<Pair<i32, u64>>>(); inner::<i16>();");
    texts.push("f::<i32(); g::<u8>();");
    texts.push("//f::<i16>();\n\"g::<u64>()\"; f::< >();");
    texts.push("outer::<inner::<i32>>(); outer::<inner::<u64>>();");
    texts.push("ident::<i32>(); identifier::<u8>(); _ident::<u16>(); 0ident::<u32>();");
    var sets = Vec::<string>.with_capacity(9);
    sets.push("");
    sets.push("f");
    sets.push("g|f");
    sets.push("outer");
    sets.push("inner");
    sets.push("outer|inner|g|tail");
    sets.push("foo|af|f|g|ident|identifier|_ident|0ident");
    sets.push("|f||g|f|");
    sets.push("absent");
    var i: i64 = 0;
    while (i < texts.len) {
        let path = "generic-roots-" + i.toString() + ".vyx";
        let text = texts.get(i);
        writeFile(path, text);
        var j: i64 = 0;
        while (j < sets.len) {
            let names = sets.get(j);
            let expected = build_generic_call_roots_for_names_in_text(text, names);
            let actual = build_generic_call_roots_for_source(path, names);
            if (actual != expected) {
                print("generic spans differ text=${i} set=${j}: ${actual} / ${expected}");
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    writeFile("generic-changing.vyx", "f::<i32>();");
    if (build_generic_call_roots_for_source("generic-changing.vyx", "f") != "f::<i32>") { return false; }
    writeFile("generic-changing.vyx", "f::<u64>(); g::<u8>();");
    if (build_generic_call_roots_for_source("generic-changing.vyx", "f|g") != "f::<u64>|g::<u8>") { return false; }
    var large = StringBuilder.withCapacity(1048576);
    i = 0;
    while (i < 16384) { large.append("let ordinary_name = ordinary_value + other_value;\n"); i = i + 1; }
    large.append("f::<i32>(); outer::<inner::<u64>>();");
    var owned = large.intoString();
    writeFile("generic-large.vyx", owned.raw());
    let expected = build_generic_call_roots_for_names_in_text(owned.raw(), "f|inner");
    if (build_generic_call_roots_for_source("generic-large.vyx", "f|inner") != expected) { return false; }
    let count = g_build_generic_call_rows.len;
    let before = vyx_rt_process_private_bytes();
    i = 0;
    while (i < 200) {
        if (build_generic_call_roots_for_source("generic-large.vyx", "f|inner") != expected) { return false; }
        i = i + 1;
    }
    if (g_build_generic_call_rows.len != count || vyx_rt_process_private_bytes() - before > 8388608) { return false; }
    owned.destroy();
    large.destroy();
    texts.destroy();
    sets.destroy();
    print("generic span scans: 90 reference comparisons and cache invalidation PASS");
    return true;
}
