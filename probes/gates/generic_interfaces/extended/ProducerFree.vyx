module ProducerFree;

type HiddenInt = i32;
let HIDDEN_BIAS: i32 = 7;

fn private_bias(x: HiddenInt) -> HiddenInt {
    return x + HIDDEN_BIAS;
}

fn inner<T>(value: T) -> T {
    return value;
}

public fn nested<T>(value: T) -> T {
    return inner(inner(value));
}

public fn private_value() -> i32 {
    return private_bias(5);
}
