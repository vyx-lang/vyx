module Cross.Consumer;

use Cross.GlobalEnum;
use Status = Cross.GlobalEnum.Status;

// This declaration deliberately shifts local HIR item ids before the imported
// global.  The linker identity must come from Cross.GlobalEnum.exported_counter
// instead of the producer/consumer-local item number.
var consumer_first: i32 = 1;

fn read_status(value: Status) -> i32 {
    // The enum and its variants are declared in the producer.  This match is
    // intentionally in the consumer so a local HIR owner must not be guessed
    // from the short `Ready` spelling.
    match (value) {
        case Ready => { return 1; }
        case Done => { return 2; }
        default => { return 3; }
    }
}

fn main() -> i32 {
    if (exported_counter != 41) { return 1; }
    if (exported_message != "cross-module string") { return 4; }
    let value: Status = Status::Ready();
    if (read_status(value) != 1) { return 2; }
    if (status_tag(value) != 1) { return 3; }
    return 0;
}
