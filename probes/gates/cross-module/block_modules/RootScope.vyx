var counter: i32 = 5;
const LIMIT: i32 = 7;

module RootNeighbor {
    public var counter: i32 = 17;
    public const LIMIT: i32 = 19;
    public fn read_neighbor() -> i32 { return counter + LIMIT; }
}

var root_snapshot: i32 = LIMIT;
fn main() -> i32 {
    if (counter != 5 || LIMIT != 7 || root_snapshot != 7) { return 1; }
    if (RootNeighbor::read_neighbor() != 36) { return 2; }
    counter = 11;
    if (counter != 11 || RootNeighbor::counter != 17) { return 3; }
    print("block module contract OK");
    return 0;
}
