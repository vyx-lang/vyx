module Cross.GlobalEnum;

public var exported_counter: i32 = 41;
public var exported_message: string = "cross-module string";

public enum Status {
    Ready,
    Done,
}

public fn status_tag(value: Status) -> i32 {
    match (value) {
        case Ready => { return 1; }
        case Done => { return 2; }
        default => { return 3; }
    }
}
