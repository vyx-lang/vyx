module DuplicateA;

use ProducerFree;

public fn duplicate_a() -> i32 {
    // Keep this call in a direct return expression.  The module-qualified
    // resolver must substitute T=i32 before return checking; a comparison
    // context can otherwise hide the unresolved T behind expected typing.
    return ProducerFree::nested::<i32>(40) + 1;
}

fn main() -> i32 {
    return duplicate_a() - 41;
}
