module PrivateStorage;

// The producer must own this storage even though only the exported generic
// body references it. Instantiating that body must not create consumer copies.
var hidden_counter: i32 = 17;

public fn advance<T>(value: T) -> i32 {
    hidden_counter = hidden_counter + 1;
    return hidden_counter;
}

public fn producer_tag() -> i32 { return 1; }
