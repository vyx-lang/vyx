fn baseline_reset() -> i32 {
    let token = malloc(8);
    let p = llvm_mir_alloc_ptr_map(262148);
    let n = llvm_mir_alloc_i32_map(262148);
    llvm_mir_map_put(p, 262146, token);
    llvm_mir_i32_map_put(n, 262146, 77);
    llvm_mir_ptr_map_zero(p);
    llvm_mir_i32_map_zero(n);
    let stale_ptr = llvm_mir_map_get(p, 262146) != null;
    let stale_int = llvm_mir_i32_map_get(n, 262146) != 0;
    if (stale_ptr) { print("legacy reset retained pointer above 262144"); }
    if (stale_int) { print("legacy reset retained i32 above 262144"); }
    probe_dispose(p);
    probe_dispose(n);
    free(token);
    if (stale_ptr || stale_int) { return 17; }
    return 0;
}

fn exercise_maps() -> i32 {
    let first = malloc(8);
    let second = malloc(8);
    let p = llvm_mir_alloc_ptr_map(1);
    let n = llvm_mir_alloc_i32_map(1);
    let alias_p = p;
    let alias_n = n;
    if (llvm_mir_map_get(p, 700000) != null) { return 21; }
    if (llvm_mir_i32_map_get(n, 700000) != 0) { return 22; }
    llvm_mir_map_put(p, 1, first);
    llvm_mir_i32_map_put(n, 1, -9);
    llvm_mir_map_put(p, 262144, first);
    llvm_mir_i32_map_put(n, 262144, 14);
    llvm_mir_map_put(p, 262145, second);
    llvm_mir_i32_map_put(n, 262145, 15);
    llvm_mir_map_put(p, 700000, second);
    llvm_mir_i32_map_put(n, 700000, 70);
    if (llvm_mir_map_get(alias_p, 1) != first) { return 23; }
    if (llvm_mir_i32_map_get(alias_n, 1) != -9) { return 24; }
    if (llvm_mir_map_get(alias_p, 262144) != first) { return 25; }
    if (llvm_mir_i32_map_get(alias_n, 262145) != 15) { return 26; }
    if (llvm_mir_map_get(alias_p, 700000) != second) { return 27; }
    if (llvm_mir_i32_map_get(alias_n, 700000) != 70) { return 28; }
    if (llvm_mir_map_get(p, 500000) != null) { return 29; }
    if (llvm_mir_i32_map_get(n, 500000) != 0) { return 30; }
    llvm_mir_map_clear_range(p, 262145, 699999);
    llvm_mir_i32_map_clear_range(n, 262145, 699999);
    if (llvm_mir_map_get(p, 262144) != first) { return 31; }
    if (llvm_mir_i32_map_get(n, 262144) != 14) { return 32; }
    if (llvm_mir_map_get(p, 262145) != null) { return 33; }
    if (llvm_mir_i32_map_get(n, 262145) != 0) { return 34; }
    if (llvm_mir_map_get(p, 700000) != second) { return 35; }
    if (llvm_mir_i32_map_get(n, 700000) != 70) { return 36; }
    llvm_mir_map_clear_range(p, 700001, 700000);
    llvm_mir_i32_map_clear_range(n, 700001, 700000);
    if (llvm_mir_map_get(p, 700000) != second) { return 37; }
    if (llvm_mir_i32_map_get(n, 700000) != 70) { return 38; }
    llvm_mir_map_clear_range(p, 700000, 2147483647);
    llvm_mir_i32_map_clear_range(n, 700000, 2147483647);
    if (llvm_mir_map_get(p, 700000) != null) { return 39; }
    if (llvm_mir_i32_map_get(n, 700000) != 0) { return 40; }
    llvm_mir_ptr_map_zero(p);
    llvm_mir_i32_map_zero(n);
    llvm_mir_map_put(p, 700002, second);
    llvm_mir_i32_map_put(n, 700002, 72);
    if (llvm_mir_map_get(p, 1) != null) { return 41; }
    if (llvm_mir_i32_map_get(n, 1) != 0) { return 42; }
    if (llvm_mir_map_get(p, 262144) != null) { return 43; }
    if (llvm_mir_i32_map_get(n, 262144) != 0) { return 44; }
    llvm_mir_map_clear_range(p, -10, 2147483647);
    llvm_mir_i32_map_clear_range(n, -10, 2147483647);
    if (llvm_mir_map_get(p, 700002) != null) { return 45; }
    if (llvm_mir_i32_map_get(n, 700002) != 0) { return 46; }
    llvm_mir_map_put(p, 0, first);
    llvm_mir_i32_map_put(n, -1, 1);
    if (llvm_mir_map_get(p, 0) != null) { return 47; }
    if (llvm_mir_i32_map_get(n, -1) != 0) { return 48; }
    probe_dispose(p);
    probe_dispose(n);
    probe_dispose(null);
    free(first);
    free(second);
    var round: i32 = 0;
    while (round < 1000) {
        let small = llvm_mir_alloc_i32_map(1);
        llvm_mir_i32_map_put(small, round + 2, round + 1);
        if (llvm_mir_i32_map_get(small, round + 2) != round + 1) { return 49; }
        probe_dispose(small);
        round = round + 1;
    }
    return 0;
}

fn main() -> i32 {
    if (argCount() > 1 && getArg(1) == "oom-create") {
        let map = llvm_mir_alloc_ptr_map(1000000000);
        probe_dispose(map);
        print("ERROR: initial allocation failure returned success");
        return 91;
    }
    if (argCount() > 1 && getArg(1) == "oom") {
        let map = llvm_mir_alloc_ptr_map(1);
        llvm_mir_map_put(map, 1000000000, null);
        probe_dispose(map);
        print("ERROR: allocation failure returned success");
        return 90;
    }
    let baseline = baseline_reset();
    if (baseline != 0) { return baseline; }
    if (argCount() > 1 && getArg(1) == "baseline") { return 0; }
    let status = exercise_maps();
    if (status != 0) { return status; }
    print("lower_maps: OK");
    return 0;
}
