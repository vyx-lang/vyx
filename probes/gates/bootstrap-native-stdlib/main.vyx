use std.core;
use std.serde.json;
use std.serde.toml;
use std.clone;
use std.collections;

fn main() -> i32 {
    assert(toml_array_to_lines("[\"one\", \"two words\"]") == "one\ntwo words\n", "compiler manifest helper");
    var root = Toml.parse("[server]\nport=42\n").unwrap();
    let child = root.require("server").unwrap();
    let retained = child.clone();
    root.destroy();
    assert(retained.require("port").unwrap().as_i64().unwrap() == 42, "native TOML storage and Vyx ownership");
    let json = Json.parse("{\"ok\":true}").unwrap();
    assert(json.get_bool("ok").unwrap(), "compiler JSON native dependency");
    let defaults = Dict::<string, i32>.new();
    assert(defaults.get("absent") == 0, "public Default constraint across independent stdlib modules");
    print("bootstrap native stdlib closure ok");
    return 0;
}
