module bootstrap_visibility_probe;
use std.clone;

public class PublicHandle<T> { public token: i64; }
impl Clone for PublicHandle<T> {
    public fn clone(&self) -> PublicHandle<T> { return PublicHandle { token: self.token }; }
}
class PrivateHandle<T> { public token: i64; }
impl Clone for PrivateHandle<T> {
    public fn clone(&self) -> PrivateHandle<T> { return PrivateHandle { token: self.token }; }
}
trait PrivateTrait { fn private_marker() -> i64; }
impl PrivateTrait for PublicHandle<T> {
    public fn private_marker(&self) -> i64 { return self.token; }
}
