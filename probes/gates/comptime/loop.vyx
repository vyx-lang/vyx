module probe.ctfold.loop;

@[comptime]
fn sum_to(n: i32) -> i32 {
    var i = 0;
    var acc = 0;
    while (i < n) {
        i += 1;
        acc += i;
    }
    return acc;
}

@[comptime]
fn for_sum(n: i32) -> i32 {
    var acc = 0;
    for (var i = 0; i < n; i += 1) {
        acc += i;
    }
    return acc;
}

@[comptime]
fn with_break(n: i32) -> i32 {
    var i = 0;
    var acc = 0;
    while (i < n) {
        i += 1;
        if (i == 3) {
            break;
        }
        acc += i;
    }
    return acc;
}

@[comptime]
fn with_continue(n: i32) -> i32 {
    var i = 0;
    var acc = 0;
    while (i < n) {
        i += 1;
        if (i == 2) {
            continue;
        }
        acc += i;
    }
    return acc;
}

@[comptime]
fn io_and_file() -> i32 {
    print("ct-io");
    println("!");
    if (ct_file_size("probes/gates/comptime/loop.vyx") > 0) {
        return 1;
    }
    return 0;
}

fn main() -> i32 {
    let a = comptime sum_to(4);
    if (a != 10) { return 1; }
    let b = comptime for_sum(5);
    if (b != 10) { return 2; }
    let c = comptime with_break(10);
    if (c != 3) { return 3; }
    let d = comptime with_continue(4);
    if (d != 8) { return 4; }
    let e = comptime io_and_file();
    if (e != 1) { return 5; }
    return 0;
}
