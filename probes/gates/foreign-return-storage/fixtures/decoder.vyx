use std.string;

extern "C" {
    @[ffi_returns_independent]
    fn vyx_decode_string_escapes_len(raw: rawptr, n: i64, length_out: rawptr) -> rawptr;
    fn vyx_free_pooled_string(ptr: rawptr);
}

fn decode(raw: str) -> str {
    var length: i64 = 0;
    let buffer = vyx_decode_string_escapes_len(raw.c_str(), raw.len, to_rawptr(&length));
    return from_cstr_view_len(buffer, length);
}

fn main() -> i32 {
    let value = decode("a\\0b\\n");
    assert_eq(value.len, 4i64);
    assert_eq(value.charAt(0), 97);
    assert_eq(value.charAt(1), 0);
    assert_eq(value.charAt(2), 98);
    assert_eq(value.charAt(3), 10);
    vyx_free_pooled_string(value.c_str());
    print("decoder PASS");
    return 0;
}
