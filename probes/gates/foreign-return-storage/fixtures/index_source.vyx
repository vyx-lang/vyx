use std.string;

extern "C" {
    @[ffi_returns_independent]
    fn gate_index_source(path: rawptr, length: rawptr) -> rawptr;
}

fn source(path: str) -> str {
    var length: i64 = 0;
    let buffer = gate_index_source(path.clone().c_str(), to_rawptr(&length));
    if (buffer != null) { return str_from_parts(buffer, length, 0, 0); }
    return "missing";
}

fn inline_source() -> str {
    var length: i64 = 0;
    return from_cstr_view_len(gate_index_source(String.from("document.vyx").c_str(),
                                               to_rawptr(&length)), 18);
}

fn main() -> i32 {
    assert_eq(source("document.vyx"), "index-owned source");
    assert_eq(source("missing.vyx"), "missing");
    assert_eq(inline_source(), "index-owned source");
    print("index source PASS");
    return 0;
}
