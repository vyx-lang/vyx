module probe.str.search;

fn main() -> i32 {
    let s = "abcdef";
    if (!s.contains("cd")) { return 1; }
    if (!s.contains("a")) { return 2; }
    if (!s.contains("f")) { return 3; }
    if (s.contains("xyz")) { return 4; }
    if (s.contains("abcdefg")) { return 5; }
    if (!s.contains("")) { return 6; }
    return 0;
}
