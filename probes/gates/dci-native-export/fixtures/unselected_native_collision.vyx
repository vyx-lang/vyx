module native_export_symbol_collision;

// This declaration is not selected for DCIB publication, but its native
// name is still a producer definition. Matching physical signatures must
// never allow it to replace the selected export's body.
@[export_name("native_gate_collision")]
public fn different_definition(value: i32) -> i32 { return value + 100; }

@[dci_export(symbol="native_gate_collision")]
public fn selected_definition(value: i32) -> i32 { return value + 7; }
