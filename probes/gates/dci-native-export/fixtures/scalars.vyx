module native_export_scalars;

fn add_seven(value: i32) -> i32 { return value + 7; }

// This helper is reachable from an export, but is not selected for publication.
public fn unselected_helper(value: i32) -> i32 { return value + 100; }

@[dci_export(symbol="native_gate_add")]
public fn exported_add(value: i32) -> i32 { return add_seven(value); }

@[dci_export(symbol="native_gate_i64")]
public fn exported_i64(value: i64) -> i64 { return value + 7; }

@[dci_export(symbol="native_gate_f32")]
public fn exported_f32(value: f32) -> f32 { return value + 7.0; }

@[dci_export(symbol="native_gate_f64")]
public fn exported_f64(value: f64) -> f64 { return value + 7.0; }

@[dci_export(symbol="native_gate_bool")]
public fn exported_bool(value: bool) -> bool { return !value; }

@[dci_export(symbol="native_gate_void")]
public fn exported_void() { return; }

@[dci_export(symbol="native_gate_pointer")]
public fn exported_pointer(value: rawptr) -> rawptr { return value; }

@[dci_export]
public fn exported_default(value: i32) -> i32 { return value + 8; }
