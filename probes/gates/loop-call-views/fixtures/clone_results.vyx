use std.core;
use std.string;

fn copy_clone(input: str) -> str {
    let owner = String.from(input);
    return owner.raw().clone();
}

fn forwarded_clone(input: str) -> str { return copy_clone(input); }

fn main() -> i32 {
    var i: i32 = 0;
    while (i < 64) {
        let short = forwarded_clone("short");
        let long = forwarded_clone("an independently cloned result must survive its original String owner");
        assert_eq(short, "short");
        assert_eq(long, "an independently cloned result must survive its original String owner");
        i += 1;
    }
    print("clone results PASS");
    return 0;
}
