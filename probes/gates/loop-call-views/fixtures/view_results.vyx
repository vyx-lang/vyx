use std.core;
use std.string;
fn borrowed(owner: &String) -> str { return owner.raw(); }
fn copied(owner: &String) -> str { return owner.raw().clone(); }
fn independent(owner: &String) -> str { return "static"; }
fn choices(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return owner.length() > 2 ? "long" : "short";
}
fn branches(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return if (owner.length() > 2) { print(owner.raw()); "long" } else { "short" };
}
fn matching(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return match (owner.length() > 2) { case true => "long", case false => "short", };
}
fn clone_local(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    let cloned = copied(&owner);
    return cloned;
}
fn static_local(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return independent(&owner);
}
fn nested_copy(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return clone_local(owner.c_str(), owner.length());
}
fn generic_copy<T>(owner: &String, marker: T) -> str { return owner.raw().clone(); }
fn generic_local(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return generic_copy(&owner, 1);
}
fn piped_copy(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return &owner |> copied();
}
fn main() -> i32 {
    let text = "long input uses heap storage rather than inline storage";
    let owner = String.from(text);
    assert_eq(borrowed(&owner), text);
    assert_eq(copied(&owner), text);
    assert_eq(clone_local(text.c_str(), text.len), text);
    assert_eq(static_local(text.c_str(), text.len), "static");
    assert_eq(nested_copy(text.c_str(), text.len), text);
    assert_eq(generic_local(text.c_str(), text.len), text);
    assert_eq(piped_copy(text.c_str(), text.len), text);
    assert_eq(choices(text.c_str(), text.len), "long");
    assert_eq(branches(text.c_str(), text.len), "long");
    assert_eq(matching(text.c_str(), text.len), "long");
    print("view results PASS");
    return 0;
}
