use std.string;
class Pretender {
    public text: String;
    fn clone(&self) -> str { return self.text.raw(); }
    fn drop(&mut self) { self.text.drop(); }
}
fn invalid_view() -> str {
    let owner = Pretender {text: String.from("clone method name is not an ownership contract")};
    return owner.clone();
}
fn main() -> i32 { print(invalid_view()); return 0; }
