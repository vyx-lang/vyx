use std.core;
use std.string;
class Model {
    public position: i64;
    public text: String;
}
fn step(q: &mut Model, token: i32) -> i64 {
    let bytes = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let owner = String.fromBytes(bytes.c_str(), bytes.len);
    let view = owner.raw();
    assert_eq(view.len, 62i64);
    assert_eq(view, bytes);
    q.position += token as i64;
    assert_eq(q.text.as_str(), "state survives repeated nested mutable borrows");
    return q.position;
}
fn forward(q: &mut Model, n: i32) -> i64 {
    var sum: i64 = 0;
    var i: i32 = 0;
    while (i < n) { sum += step(q, i + 1); i += 1; }
    return sum;
}
fn middle(q: &mut Model, n: i32) -> i64 {
    var sum: i64 = 0;
    var i: i32 = 0;
    while (i < n) { sum += forward(q, 4); i += 1; }
    return sum;
}
fn outer(q: &mut Model, n: i32) -> i64 {
    var sum: i64 = 0;
    var i: i32 = 0;
    while (i < n) { sum += middle(q, 3); i += 1; }
    return sum;
}
fn copy_bytes(buf: rawptr, n: i64) -> String {
    let owned = String.fromBytes(buf, n);
    return owned;
}
fn main() -> i32 {
    var q = Model {position: 0, text: String.from("state survives repeated nested mutable borrows")};
    assert_eq(forward(&mut q, 4), 20i64);
    assert_eq(q.position, 10i64);
    q.position = 0;
    assert_eq(middle(&mut q, 3), 180i64);
    assert_eq(q.position, 30i64);
    q.position = 0;
    assert_eq(outer(&mut q, 2), 720i64);
    assert_eq(q.position, 60i64);
    let input = "owned return is independent of the caller bytes";
    let copied = copy_bytes(input.c_str(), input.len);
    assert_eq(copied.as_str(), input);
    print("nested owner PASS");
    return 0;
}
