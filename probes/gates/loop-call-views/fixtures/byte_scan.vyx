fn at(buf: *u8, i: i32) -> i32 {
    unsafe { return buf[i] as i32; }
}

fn probe(buf: *u8, n: i32) -> i32 {
    var p: i32 = 0;
    while (p < n && at(buf, p) != 32) { p = p + 1; }
    return p;
}

fn main() -> i32 {
    let input = "GET /health HTTP/1.1";
    let p = input.c_str() as *u8;
    let result = probe(p, input.len as i32);
    print(result);
    if (result != 3) { return 1; }
    return 0;
}
