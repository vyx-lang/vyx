use std.string;

fn copy_clone(input: str) -> str {
    let owner = String.from(input);
    return owner.raw().clone();
}

fn main() -> i32 {
    let short = copy_clone("short");
    let long = copy_clone("0123456789012345678901234567890123456789");
    return ((short.len - 5) + (long.len - 40)) as i32;
}
