use std.string;

fn inspect_bytes(buf: *u8, n: i32) -> i64 {
    let view = String.fromBytes(buf as rawptr, n as i64);
    return view.length();
}

fn repeated(buf: *u8, n: i32) -> i64 {
    var total: i64 = 0;
    var i: i32 = 0;
    while (i < 4) {
        total = total + inspect_bytes(buf, n);
        i = i + 1;
    }
    return total;
}

fn main() -> i32 {
    let input = "GET /health";
    let total = repeated(input.c_str() as *u8, input.len as i32);
    print(total);
    if (total != 44) { return 1; }
    return 0;
}
