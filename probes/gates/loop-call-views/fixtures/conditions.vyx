use std.core;
var calls: i32 = 0;
fn check(value: bool) -> bool { calls += 1; return value; }
fn at(buf: *u8, i: i32) -> i32 {
    calls += 1;
    unsafe { return buf[i] as i32; }
}
fn bytes_eq(buf: *u8, start: i32, count: i32, text: str) -> bool {
    calls += 1;
    if (count != text.len) { return false; }
    var i: i32 = 0;
    unsafe {
        while (i < count) {
            if (buf[start + i] != (text.c_str() as *u8)[i]) { return false; }
            i += 1;
        }
    }
    return true;
}
fn route(buf: *u8, n: i32) -> bool {
    var p: i32 = 0;
    while (p < n && at(buf, p) != 32) { p += 1; }
    let method_len = p;
    p += 1;
    var end = p;
    while (end < n && at(buf, end) != 32 && at(buf, end) != 13) { end += 1; }
    return bytes_eq(buf, 0, method_len, "GET") && bytes_eq(buf, p, end - p, "/health");
}
fn main() -> i32 {
    calls = 0;
    assert_eq(check(false) && check(true), false);
    assert_eq(calls, 1);
    calls = 0;
    assert_eq(check(true) || check(false), true);
    assert_eq(calls, 1);
    calls = 0;
    assert_eq(check(true) && check(false), false);
    assert_eq(calls, 2);
    calls = 0;
    assert_eq(check(false) || check(true), true);
    assert_eq(calls, 2);
    let input = "GET /health HTTP/1.1";
    var i: i32 = 0;
    while (i < 5) {
        assert_eq(route(input.c_str() as *u8, input.len as i32), true);
        i += 1;
    }
    let other = "POST /health HTTP/1.1";
    assert_eq(route(other.c_str() as *u8, other.len as i32), false);
    calls = 0;
    assert_eq(route(input.c_str() as *u8, 0), false);
    assert_eq(calls, 1);
    print("conditions PASS");
    return 0;
}
