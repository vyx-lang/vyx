use std.core;
use std.string;
fn overwritten(flag: bool) -> str {
    let owner = String.from("local owning storage that will be destroyed");
    var view = owner.raw();
    if (flag) { view = "left"; } else { view = "right"; }
    return view;
}
fn overwritten_loop() -> str {
    let owner = String.from("local owning storage that will be destroyed");
    var view = owner.raw();
    while (true) { view = "loop"; break; }
    return view;
}
fn returning_branch(flag: bool) -> str {
    let owner = String.from("local owning storage that will be destroyed");
    var view = owner.raw();
    if (flag) { return "early"; }
    view = "late";
    return view;
}
fn borrowed_scalar(input: &i32) -> &i32 { return input; }
fn main() -> i32 {
    assert_eq(overwritten(true), "left");
    assert_eq(overwritten(false), "right");
    assert_eq(overwritten_loop(), "loop");
    assert_eq(returning_branch(true), "early");
    assert_eq(returning_branch(false), "late");
    let input: i32 = 42;
    assert_eq(*borrowed_scalar(&input), 42);
    print("view mutation PASS");
    return 0;
}
