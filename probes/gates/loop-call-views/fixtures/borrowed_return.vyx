use std.core;
use std.string;
fn borrow_bytes(owner: &String) -> str { return owner.raw(); }
fn clone_bytes(owner: &String) -> str { return owner.raw().clone(); }
fn owned_copy(buf: rawptr, n: i64) -> str {
    let owner = String.fromBytes(buf, n);
    return clone_bytes(&owner);
}
fn constant_result(owner: &String) -> str { return "static result"; }
fn main() -> i32 {
    let text = "heap-backed bytes that outlive a borrowed-return call";
    let owner = String.fromBytes(text.c_str(), text.len);
    assert_eq(borrow_bytes(&owner), text);
    let copied = owned_copy(text.c_str(), text.len);
    assert_eq(copied, text);
    assert_eq(constant_result(&owner), "static result");
    print("borrowed return PASS");
    return 0;
}
