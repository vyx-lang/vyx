use std.core;
use std.string;

fn copy_owner(value: str) -> str {
    var owner = String.from(value);
    let copied = from_cstr_len(owner.c_str(), owner.length());
    owner.destroy();
    return copied;
}

fn copy_builder(value: str) -> str {
    var builder = StringBuilder.withCapacity(8);
    builder.append(value);
    var owner = builder.intoString();
    let copied = from_cstr_len(owner.c_str(), owner.length());
    owner.destroy();
    builder.destroy();
    return copied;
}

fn aliased_copy(value: str) -> str {
    let copied = copy_builder(value);
    return copied;
}

fn chosen_copy(value: str, flag: bool) -> str {
    if (flag) { return copy_owner(value); }
    return copy_builder(value);
}

fn main() -> i32 {
    let small = "short";
    let large = "a returned copy must outlive the local owner and builder that supplied its bytes";
    var index: i32 = 0;
    while (index < 64) {
        assert_eq(copy_owner(small), small);
        assert_eq(copy_owner(large), large);
        assert_eq(copy_builder(small), small);
        assert_eq(copy_builder(large), large);
        assert_eq(aliased_copy(large), large);
        assert_eq(chosen_copy(small, true), small);
        assert_eq(chosen_copy(large, false), large);
        index += 1;
    }
    print("builder results PASS");
    return 0;
}
