module duplicate_mutref;
public class Model { public position: i32; }
public fn selected(model: &mut Model, port: i32) -> i32 { print("first"); return port; }
public fn selected(model: &mut Model, port: i32) -> i32 { print("second"); return port + 1; }
fn main() -> i32 { var model = Model { position: 0 }; print(selected(&mut model, 1)); return 0; }
