use std.string;
fn invalid_view(n: i32) -> str {
    let owner = String.from("local owning storage that will be destroyed");
    var first: str = "static";
    var second: str = "static";
    var i: i32 = 0;
    while (i < n) {
        second = first;
        first = owner.raw();
        i += 1;
    }
    return second;
}
fn main() -> i32 { print(invalid_view(2)); return 0; }
