
fn main() -> i32 {
    var map = BuildSourceMap.create(0);
    map.put("Aa", 1);
    map.put("B@", 2);
    if (BuildSourceMap.hash("Aa") != BuildSourceMap.hash("B@")) { return 10; }
    var i: i64 = 0;
    while (i < 1024) { map.put("source_" + i.toString(), i); i = i + 1; }
    i = 0;
    while (i < 1024) {
        if (map.get("source_" + i.toString()) != i) { return 11; }
        i = i + 1;
    }
    map.put("Aa", 4);
    if (map.get("Aa") != 4 || map.get("B@") != 2 || map.get("missing") != -1) { return 12; }
    map.destroy();
    writeFile("a.vyx", "module Root;\nuse Tree.Leaf.member;\nuse Tree;\npublic fn a() -> i32;\n");
    writeFile("b.vyx", "module Tree;\nuse Root;\npublic fn b() -> i32;\n");
    writeFile("c.vyx", "module Tree.Leaf;\nuse Tree;\npublic fn c() -> i32;\n");
    writeFile("d.vyx", "module Tree;\npublic fn d() -> i32;\n");
    var index = build_make_source_index("a.vyx\nb.vyx\nc.vyx\nd.vyx\n");
    if (index.source_id("a.vyx") != 0 || index.source_id("absent") != -1) { return 1; }
    if (index.module_id("Tree.Leaf.member") != 2) { return 2; }
    if (index.module_id("Tree.member") != 1 || index.module_id("Tree") != 1) { return 3; }
    if (index.module_id("TreeWrong") != -1 || index.module_id("Tree.") != -1) { return 4; }
    if (index.sources_for_group("module:Tree") != "b.vyx\nd.vyx\n") { return 5; }
    let expected = "dep_iface:" + build_source_interface_stamp("c.vyx")
                   + "dep_iface:" + build_source_interface_stamp("b.vyx");
    let actual = build_partition_dependency_stamp(0, &mut index);
    if (actual != expected) { print(actual); print(expected); return 6; }
    // Cycles terminate; source order and first duplicate-module behavior stay stable.
    if (build_partition_dependency_stamp(0, &mut index) != actual) { return 7; }
    // Compare real peer-list files with the pre-index implementation. Only the
    // two Tree files are peers; singleton modules must not gain sibling lists.
    let sources = "a.vyx\nb.vyx\nc.vyx\nd.vyx\n";
    if (build_emit_peer_vyi_files("", sources, "interfaces", "reference-peers",
                                  "", "", "", 1, "", 0, 0) != 0) { return 13; }
    if (build_write_peer_vyi_units(&mut index, "interfaces", "indexed-peers") != 0) { return 14; }
    if (readFile(build_peer_vyi_unit_path("reference-peers", "b.vyx"))
        != readFile(build_peer_vyi_unit_path("indexed-peers", "b.vyx"))) { return 15; }
    if (readFile(build_peer_vyi_unit_path("reference-peers", "d.vyx"))
        != readFile(build_peer_vyi_unit_path("indexed-peers", "d.vyx"))) { return 16; }
    if (fileExists(build_peer_vyi_unit_path("indexed-peers", "a.vyx"))
        || fileExists(build_peer_vyi_unit_path("indexed-peers", "c.vyx"))) { return 17; }
    // A real filesystem write failure must stop planning, not report success.
    writeFile("occupied", "not a directory");
    if (build_write_peer_vyi_units(&mut index, "interfaces", "occupied") != 1) { return 18; }
    index.destroy();
    let prior_closure = reference_auto_imports("a.vyx", false, "", "");
    let indexed_closure = build_auto_vyx_import_sources_mode("a.vyx", false, "", "");
    if (prior_closure != indexed_closure) { print(prior_closure); print(indexed_closure); return 9; }
    // A new target snapshot observes a changed module, even at the same path.
    writeFile("d.vyx", "module Changed.ModuleName;\npublic fn d() -> i32;\n");
    var next = build_make_source_index("d.vyx\n");
    if (next.module_id("Changed.ModuleName") != 0 || next.module_id("Tree") != -1) { return 8; }
    next.destroy();
    print("source index: lookup, groups, cycle, ordered closure, target refresh OK");
    return 0;
}
