module builder_regression;
use std.string;
use std.collections;

class ShadowStringBuilder {
    public code: i64;
    public static fn create() -> ShadowStringBuilder {
        return ShadowStringBuilder { code: 77 };
    }
    public fn append(value: str) { self.code = self.code + value.len; }
}

fn make_builder() -> std.string.StringBuilder {
    return std.string.StringBuilder.create();
}

fn main() -> i32 {
    var builder = make_builder();
    builder.appendI64(4429);
    let first = builder.build();
    if (first.as_str() != "4429") { return 1; }
    builder.clear();
    let negative: i64 = -42;
    let unsigned: u64 = 18446744073709551615 as u64;
    builder.append(negative.toString());
    builder.append("/");
    builder.append(unsigned.toString());
    let integers = builder.build();
    if (integers.as_str() != "-42/18446744073709551615") { return 2; }
    builder.clear();
    var i: i32 = 0;
    while (i < 128) { builder.append("abcdefgh"); i = i + 1; }
    let transferred = builder.intoString();
    if (transferred.len != 1024 || transferred.substring(0, 8) != "abcdefgh") { return 3; }
    builder.append("reuse");
    let reused = builder.build();
    builder.destroy();
    if (first.as_str() != "4429" || reused.as_str() != "reuse" || transferred.len != 1024) { return 4; }
    var reserved = std.string.StringBuilder.withCapacity(256);
    reserved.appendU64(unsigned);
    let reserved_text = reserved.build();
    reserved.destroy();
    if (reserved_text.as_str() != "18446744073709551615") { return 5; }
    var shadow = ShadowStringBuilder.create();
    let value: i64 = 4429;
    shadow.append(value.toString());
    if (shadow.code != 81) { return 6; }
    print("StringBuilder ABI ok");
    return 0;
}
