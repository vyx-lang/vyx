module borrow_invalidation_valid;

class Buffer {
    var data: [i32; 1];

    Buffer() {
        self.data[0] = 1;
    }

    public fn at(self) -> &mut i32 {
        return &mut self.data[0];
    }

    public fn mutate(self) {
        self.data[0] = 2;
    }
}

fn main() {
    var value = Buffer();
    let view = value.at();
    *view = 3;
    value.mutate();
    return 0;
}
