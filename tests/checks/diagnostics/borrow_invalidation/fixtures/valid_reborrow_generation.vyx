module borrow_invalidation_reborrow;

class Buffer {
    var data: [i32; 1];

    Buffer() {
        self.data[0] = 1;
    }

    public fn at(self) -> &mut i32 {
        return &mut self.data[0];
    }

    public fn mutate(self) {
        self.data[0] = self.data[0] + 1;
    }
}

fn main() {
    var value = Buffer();
    var view = value.at();
    value.mutate();
    value.mutate();
    view = value.at();
    *view = 9;
    return 0;
}
