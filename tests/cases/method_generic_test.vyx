/// method_generic_test.vyx — exercises method-level generic monomorphization (P1c-D)
///
/// Tests that `recv.method::<U>(args)` correctly:
///   1. Produces a Mono-emitted FunctionDecl named "ClassName<T>.method<U>"
///   2. CodeGen calls findClassMethod("ClassName<T>", "method<U>") and finds it.
///   3. The body is correctly substituted for both class-level (T) and
///      method-level (U) generic parameters.
///
/// These tests are intended to be run after P1c-D integration (once cmake/ninja
/// completes the build).  They cover the primary path (instance method turbofish)
/// and secondary paths (static method turbofish, chained calls).

// ────────────────────────────────────────────────────────────────────
//  1. Basic instance method with method-level generic
// ────────────────────────────────────────────────────────────────────
//
// Iterator<T> is a simple wrapper that carries a single value.  The `map`
// method introduces a method-level generic U and returns an Iterator<U>.
//
// Call: `it.map::<i64>(fn(x: i32) -> i64 { x as i64 })`
// Mangled name produced by Mono: "Iterator<i32>.map<i64>"
// findClassMethod("Iterator<i32>", "map<i64>") must return a valid function.

class Iterator<T> {
    public value: T;

    public static fn new(v: T) -> Iterator<T> {
        return Iterator { value: v };
    }

    // Method-level generic U: T is the element type, U is the mapped type.
    public fn map<U>(f: fn(T) -> U) -> Iterator<U> {
        let result: U = f(self.value);
        return Iterator { value: result };
    }

    public fn get() -> T {
        return self.value;
    }
}

fn test_basic_map() -> i64 {
    let it = Iterator::<i32>.new(42);
    // Turbofish: map::<i64> — Mono should emit Iterator<i32>.map<i64>
    let mapped = it.map::<i64>(fn(x: i32) -> i64 { return x as i64 + 1; });
    return mapped.get();
}

// ────────────────────────────────────────────────────────────────────
//  2. Two method-level generics (zip)
// ────────────────────────────────────────────────────────────────────

class Pair<A> {
    public first: A;

    public static fn new(a: A) -> Pair<A> {
        return Pair { first: a };
    }

    // zip introduces a method-level generic B.
    public fn zip<B>(b: B) -> Pair<A> {
        // For simplicity, just return self (we don't have a Pair<A,B> to return yet)
        return self;
    }

    public fn get_first() -> A {
        return self.first;
    }
}

fn test_zip() -> i32 {
    let p = Pair::<i32>.new(10);
    // Mono should emit Pair<i32>.zip<string>
    let _ = p.zip::<string>("hello");
    return p.get_first();
}

// ────────────────────────────────────────────────────────────────────
//  3. Method-level generic on a non-generic class (plain class)
// ────────────────────────────────────────────────────────────────────
//
// If the enclosing class itself is not generic, the method turbofish
// still has method-level type parameters.  Mangled name: "Converter.cast<f64>"

class Converter {
    public fn cast<U>(x: i32) -> U {
        // trivial body — the return is an integer coercion
        return x as U;
    }
}

fn test_plain_class_method_generic() -> f64 {
    let c = Converter {};
    // Mono should emit Converter.cast<f64>
    let result = c.cast::<f64>(7);
    return result;
}

// ────────────────────────────────────────────────────────────────────
//  4. Chained method-level generic call via intermediate field
// ────────────────────────────────────────────────────────────────────
//
// Exercises the field-chain dispatch path in emitMethodCall where
// obj.field.method::<U>(args) is resolved through the field's struct type.

class Wrapper<T> {
    public inner: Iterator<T>;

    public static fn new(v: T) -> Wrapper<T> {
        return Wrapper { inner: Iterator::<T>.new(v) };
    }
}

fn test_chained_method_generic() -> i64 {
    let w = Wrapper::<i32>.new(100);
    // Chain: w.inner.map::<i64>(f) — field-chain path in CodeGenMethodCall
    let mapped = w.inner.map::<i64>(fn(x: i32) -> i64 { return x as i64 * 2; });
    return mapped.get();
}

// ────────────────────────────────────────────────────────────────────
//  5. Self-dispatch of method-level generic inside a class method
// ────────────────────────────────────────────────────────────────────
//
// `self.method::<U>(...)` exercises the SelfExpr dispatch path.

class Transformer<T> {
    public data: T;

    public static fn new(d: T) -> Transformer<T> {
        return Transformer { data: d };
    }

    public fn apply<U>(f: fn(T) -> U) -> U {
        return f(self.data);
    }

    public fn run() -> i64 {
        // Self-dispatch with method turbofish: Mono substitutes Transformer<T>
        // -> Transformer<i32> through the active env so the synthetic
        // FunctionDecl ends up as Transformer<i32>.apply<i64>.
        return self.apply::<i64>(fn(x: i32) -> i64 { return x as i64 + 10; });
    }
}

fn test_self_dispatch_method_generic() -> i64 {
    let t = Transformer::<i32>.new(5);
    return t.run();
}

// ────────────────────────────────────────────────────────────────────
//  Entry point
// ────────────────────────────────────────────────────────────────────

fn main() -> i32 {
    let r1 = test_basic_map();
    // Expected: 43 (42 + 1)
    assert(r1 == 43);

    let r2 = test_zip();
    // Expected: 10
    assert(r2 == 10);

    let r3 = test_plain_class_method_generic();
    // Expected: 7.0
    assert(r3 == 7.0);

    let r4 = test_chained_method_generic();
    // Expected: 200 (100 * 2)
    assert(r4 == 200);

    let r5 = test_self_dispatch_method_generic();
    // Expected: 15 (5 + 10)
    assert(r5 == 15);

    return 0;
}
