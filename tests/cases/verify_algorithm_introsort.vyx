module verify_algorithm_introsort;

use std.algorithm;
use std.core;
use std.string;

fn check_i64_concrete() -> i32 {
    var v = Vec::<i64>.with_capacity(257);
    var i: i64 = 0;
    while (i < 257) {
        v.push_unchecked(((257 - i) * 37) % 23);
        i = i + 1;
    }

    sort(v);
    if (!is_sorted(v)) { return 1; }
    if (v.get_unchecked(0) != 0) { return 2; }
    if (v.get_unchecked(v.len - 1) != 22) { return 3; }
    return 0;
}

fn check_i32_generic() -> i32 {
    var v = Vec::<i32>.with_capacity(300);
    var i: i64 = 0;
    while (i < 300) {
        let x = (((299 - i) * 1103515245 + 12345) % 97) as i32;
        v.push_unchecked(x);
        i = i + 1;
    }

    sort::<i32>(v);
    if (!is_sorted::<i32>(v)) { return 10; }
    let hit = binary_search_ord::<i32>(v, 42);
    if (hit.isSome() && v.get_unchecked(hit.unwrap()) != 42) { return 11; }
    return 0;
}

fn check_strings() -> i32 {
    var v = Vec::<string>.with_capacity(12);
    v.push_unchecked("kiwi");
    v.push_unchecked("apple");
    v.push_unchecked("pear");
    v.push_unchecked("apple");
    v.push_unchecked("banana");
    v.push_unchecked("banana");
    v.push_unchecked("zebra");
    v.push_unchecked("fig");
    v.push_unchecked("fig");
    v.push_unchecked("date");
    v.push_unchecked("elder");
    v.push_unchecked("cherry");

    sort::<string>(v);
    if (!is_sorted::<string>(v)) { return 20; }
    if (v.get_unchecked(0) != "apple") { return 21; }
    if (v.get_unchecked(1) != "apple") { return 22; }
    if (v.get_unchecked(v.len - 1) != "zebra") { return 23; }
    return 0;
}

fn check_owned_strings() -> i32 {
    var v = Vec::<string>.with_capacity(2048);
    var i: i64 = 0;
    while (i < 2048) {
        var builder = StringBuilder.create();
        builder.append("v");
        builder.appendInt((i * 37) % 997);
        builder.append("_");
        builder.appendInt(i);
        let built = builder.intoString();
        v.push_unchecked(built.raw().clone());
        i = i + 1;
    }

    sort::<string>(v);
    if (!is_sorted::<string>(v)) { return 30; }
    var checksum: i64 = 0;
    i = 1;
    while (i < v.len) {
        checksum = checksum + v.get_unchecked(i).len * ((i % 13) + 1);
        i = i + 1;
    }
    i = 0;
    while (i < v.len) {
        str_drop(v.get_unchecked(i));
        i = i + 1;
    }
    v.destroy();
    if (checksum != 119527) { return 31; }
    return 0;
}

fn main() -> i32 {
    let a = check_i64_concrete();
    if (a != 0) { return a; }
    let b = check_i32_generic();
    if (b != 0) { return b; }
    let c = check_strings();
    if (c != 0) { return c; }
    let d = check_owned_strings();
    if (d != 0) { return d; }
    print("ok");
    return 0;
}
