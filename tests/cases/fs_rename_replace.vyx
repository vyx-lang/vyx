use std.fs;

// Mirrors the atomic-output publication sequence used by the project builder.
// It must work when all paths are composed strings rather than literals.
fn main() -> i32 {
    let stem = "tests/.cache/fs_rename_replace";
    let pending = stem + ".tmp";
    let published = stem + ".vyi";
    let backup = published + ".old";

    deleteFile(pending);
    deleteFile(published);
    deleteFile(backup);
    if (writeFile(pending, "new-interface") != 0) { return 11; }
    if (writeFile(published, "old-interface") != 0) { return 12; }
    if (renameFile(published, backup) != 0) { return 13; }
    if (renameFile(pending, published) != 0) { return 14; }
    if (!fileExists(published) || readFile(published) != "new-interface") { return 15; }
    if (!fileExists(backup) || readFile(backup) != "old-interface") { return 16; }
    if (deleteFile(published) != 0 || deleteFile(backup) != 0) { return 17; }

    print("fs_rename_replace OK");
    return 0;
}
