// Dict map + Vec-backed sorted-key checks (BTreeMap is not the current std surface).
module verify_dict_map;

use std.core;
use std.collections;
use std.string;

fn main() -> i32 {
    var m = Dict::<i32, string>.new();
    m.put(3, "three");
    m.put(1, "one");
    m.put(2, "two");

    if (m.size() != 3) { return 1; }
    if (m.get(1) != "one") { return 2; }
    if (m.get(3) != "three") { return 3; }
    if (m.get(2) != "two") { return 4; }

    m.put(2, "TWO");
    if (m.size() != 3) { return 10; }
    if (m.get(2) != "TWO") { return 11; }

    if (!m.contains(1)) { return 12; }
    if (m.contains(99)) { return 13; }
    if (!m.remove(1)) { return 14; }
    if (m.contains(1)) { return 15; }
    if (m.size() != 2) { return 16; }
    if (m.remove(999)) { return 18; }

    var s = Vec::<string>.new();
    s.push("banana");
    s.push("apple");
    s.push("cherry");
    if (s.size() != 3) { return 24; }

    var has_apple = false;
    var i: i64 = 0;
    while (i < s.size()) {
        if (s.get(i) == "apple") { has_apple = true; }
        i = i + 1;
    }
    if (!has_apple) { return 5; }

    var empty = Dict::<i64, i64>.new();
    if (empty.size() != 0) { return 30; }

    print("ok");
    return 0;
}
