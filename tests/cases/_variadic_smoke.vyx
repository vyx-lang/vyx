// Variadic generic smoke test
// Tests:
//   1. args.len  → compile-time constant i64
//   2. args[0]   → first pack element
//   3. args[1]   → second pack element
//   4. for (var d in args) → expansion statement (unrolls to N copies)

fn foo<...Ts>(...args: Ts) -> i32 {
    let n = args.len;      // i64 constant = sizeof...(Ts)
    let a = args[0];
    let b = args[1];
    // Use the values so they aren't dead-code eliminated before the
    // return-code check can observe full pack expansion.
    return (n as i32) + (a - a) + (b - b);
}

fn main() -> i32 {
    let r = foo(1, 2, 3);  // Ts = <i32, i32, i32>, n = 3
    // Treat rc==0 as success for the gate harness: encode the assertion
    // as `r == 3 ? 0 : r` so a correct expansion exits cleanly.
    if (r == 3) { return 0; }
    return r;
}
