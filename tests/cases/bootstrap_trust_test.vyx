// Bootstrap trust root verification test
// Tests critical features used by the bootstrap compiler
use std.collections;
use std.string;

fn test_string_ops() {
    print("=== String Operations ===");
    
    let s = "hello world";
    print("len: ${s.len}");
    
    if (s.contains("world")) { print("contains: PASS"); }
    else { print("contains: FAIL"); }
    
    let idx = s.indexOf("world");
    print("indexOf: ${idx}");
    
    if (s.startsWith("hello")) { print("startsWith: PASS"); }
    else { print("startsWith: FAIL"); }
    
    if (s.endsWith("world")) { print("endsWith: PASS"); }
    else { print("endsWith: FAIL"); }
    
    let sub = s.substring(0, 5);
    print("substring: ${sub}");
    
    let r = "aXbXcX".replace("X", "Y");
    print("replace all: ${r}");
    
    let r2 = "hello".replace("zzz", "nope");
    print("replace none: ${r2}");
    
    let t = "  hello  ".trim();
    print("trim: '${t}'");
    
    let u = "hello".toUpper();
    let l = "HELLO".toLower();
    print("toUpper: ${u}, toLower: ${l}");
    
    if ("".isEmpty()) { print("isEmpty: PASS"); }
    else { print("isEmpty: FAIL"); }
    
    let ch = "abc".charAt(1);
    print("charAt(1): ${ch}");
    
    let x: i64 = 42;
    let msg = "val=${x}, double=${x * 2}";
    print("interpolation: ${msg}");
}

struct Point {
    x: i64
    y: i64
}

fn make_point(x: i64, y: i64) -> Point {
    var p: Point;
    p.x = x;
    p.y = y;
    return p;
}

fn add_points(a: Point, b: Point) -> Point {
    var r: Point;
    r.x = a.x + b.x;
    r.y = a.y + b.y;
    return r;
}

fn test_structs() {
    print("\n=== Struct Operations ===");
    
    var p1 = make_point(10, 20);
    var p2 = make_point(30, 40);
    let p3 = add_points(p1, p2);
    print("p3: (${p3.x}, ${p3.y})");
    
    p1.x = 100;
    print("modified p1.x: ${p1.x}");
    
    if (p3.x == 40 && p3.y == 60) { print("add_points: PASS"); }
    else { print("add_points: FAIL"); }
}

struct Node {
    value: i64
    name: string
    active: bool
}

fn test_struct_with_string() {
    print("\n=== Struct with String ===");
    
    var n: Node;
    n.value = 42;
    n.name = "test_node";
    n.active = true;
    
    print("node: ${n.name} = ${n.value}");
    if (n.active) { print("active: PASS"); }
    else { print("active: FAIL"); }
    
    n.name = "renamed";
    print("renamed: ${n.name}");
}

class Counter {
    public value: i64;

    public static fn new() -> Counter {
        return Counter { value: 0 };
    }
    
    public fn increment() {
        self.value = self.value + 1;
    }
    
    public fn add(n: i64) {
        self.value = self.value + n;
    }
    
    public fn get_value() -> i64 {
        return self.value;
    }
}

fn test_classes() {
    print("\n=== Class Operations ===");
    
    let c = Counter.new();
    c.increment();
    c.increment();
    c.increment();
    c.add(10);
    print("counter: ${c.get_value()}");
    
    if (c.get_value() == 13) { print("counter: PASS"); }
    else { print("counter: FAIL"); }
}

// String append pattern (struct + in-place mutation; avoids class+string field crash)
struct StringBuilder {
    buf: string;
    count: i64;
}

fn test_string_builder() {
    print("\n=== StringBuilder Pattern ===");

    var sb = StringBuilder { buf: "", count: 0 };
    sb.buf = sb.buf + "hello";
    sb.count = sb.count + 1;
    sb.buf = sb.buf + " ";
    sb.count = sb.count + 1;
    sb.buf = sb.buf + "world";
    sb.count = sb.count + 1;
    print("result: ${sb.buf}");
    print("count: ${sb.count}");

    if (sb.count == 3) { print("count: PASS"); }
    else { print("count: FAIL"); }
}

fn test_vec() {
    print("\n=== Vec Operations ===");
    
    var v = Vec::<i64>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    print("vec len: ${v.len}");
    print("vec[0]: ${v.get(0)}");
    print("vec[1]: ${v.get(1)}");
    print("vec[2]: ${v.get(2)}");
    if (v.len == 3 && v.get(0) == 10 && v.get(2) == 30) { print("vec: PASS"); }
    else { print("vec: FAIL"); }
    
    var sv = Vec::<string>.new();
    sv.push("hello");
    sv.push("world");
    print("str vec[0]: ${sv.get(0)}");
    print("str vec[1]: ${sv.get(1)}");
    if (sv.len == 2) { print("str vec: PASS"); }
    else { print("str vec: FAIL"); }
}

fn test_dict() {
    print("\n=== Dict Operations ===");
    
    var d = Dict::<string, i64>.new();
    d.put("one", 1);
    d.put("two", 2);
    d.put("three", 3);
    
    if (d.contains("one")) { print("dict contains: PASS"); }
    else { print("dict contains: FAIL"); }
    
    let val = d.get("two");
    print("dict get: ${val}");
    if (val == 2) { print("dict get: PASS"); }
    else { print("dict get: FAIL"); }
    
    let keys = d.keys();
    print("dict keys len: ${keys.len}");
    
    d.put("one", 100);
    let val2 = d.get("one");
    print("dict overwrite: ${val2}");
    if (val2 == 100) { print("dict overwrite: PASS"); }
    else { print("dict overwrite: FAIL"); }
    
    var sd = Dict::<string, string>.new();
    sd.put("key", "value");
    let sv = sd.get("key");
    print("str dict: ${sv}");
    if (sv == "value") { print("str dict: PASS"); }
    else { print("str dict: FAIL"); }
}

fn test_if_chain() {
    print("\n=== If/Elif Chain ===");
    
    let x: i64 = 3;
    var label = "";
    if (x == 1) { label = "one"; }
    elif (x == 2) { label = "two"; }
    elif (x == 3) { label = "three"; }
    else { label = "other"; }
    print("label: ${label}");
    if (label == "three") { print("elif: PASS"); }
    else { print("elif: FAIL"); }
}

fn test_control_flow() {
    print("\n=== Control Flow ===");
    
    // While loop
    var sum: i64 = 0;
    var i: i64 = 1;
    while (i <= 10) {
        sum = sum + i;
        i = i + 1;
    }
    print("sum 1..10: ${sum}");
    if (sum == 55) { print("while: PASS"); }
    else { print("while: FAIL"); }
    
    // For-style with while
    var prod: i64 = 1;
    var j: i64 = 1;
    while (j <= 5) {
        prod = prod * j;
        j = j + 1;
    }
    print("5!: ${prod}");
    if (prod == 120) { print("factorial: PASS"); }
    else { print("factorial: FAIL"); }
    
    // Nested loops with break
    var found: i64 = 0;
    var a: i64 = 0;
    while (a < 10) {
        var b: i64 = 0;
        while (b < 10) {
            if (a * 10 + b == 42) {
                found = a * 10 + b;
                break;
            }
            b = b + 1;
        }
        if (found > 0) { break; }
        a = a + 1;
    }
    print("break found 42: ${found}");
    if (found == 42) { print("break: PASS"); }
    else { print("break: FAIL"); }
    
    // Continue
    var even_sum: i64 = 0;
    var k: i64 = 1;
    while (k <= 10) {
        if (k % 2 != 0) { k = k + 1; continue; }
        even_sum = even_sum + k;
        k = k + 1;
    }
    print("even sum: ${even_sum}");
    if (even_sum == 30) { print("continue: PASS"); }
    else { print("continue: FAIL"); }
}

fn fibonacci(n: i64) -> i64 {
    if (n <= 1) { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn test_recursion() {
    print("\n=== Recursion ===");
    let f10 = fibonacci(10);
    print("fib(10): ${f10}");
    if (f10 == 55) { print("recursion: PASS"); }
    else { print("recursion: FAIL"); }
}

fn test_string_heavy() {
    print("\n=== String Heavy ===");
    
    // Building strings incrementally
    var result = "";
    var i: i64 = 0;
    while (i < 5) {
        result = result + "item${i},";
        i = i + 1;
    }
    print("built: ${result}");
    
    // Chained replace
    var code = "fn main() { let x = 1; let y = 2; }";
    let r1 = code.replace("fn", "func");
    let r2 = r1.replace("let", "var");
    print("code transform: ${r2}");
    
    // String comparison
    let a = "hello";
    let b = "hello";
    let c = "world";
    if (a == b) { print("str eq: PASS"); }
    else { print("str eq: FAIL"); }
    if (a != c) { print("str neq: PASS"); }
    else { print("str neq: FAIL"); }
}

fn test_arithmetic() {
    print("\n=== Arithmetic ===");
    
    let a: i64 = 100;
    let b: i64 = 37;
    print("add: ${a + b}");
    print("sub: ${a - b}");
    print("mul: ${a * b}");
    print("div: ${a / b}");
    print("mod: ${a % b}");
    
    // Bitwise
    let x: i64 = 255;
    let y: i64 = 170;
    print("and: ${x & y}");
    print("or: ${x | y}");
    print("xor: ${x ^ y}");
    
    // Shifts
    let s: i64 = 1;
    print("shl 5: ${s << 5}");
    let big: i64 = 256;
    print("shr 3: ${big >> 3}");
    
    // Float
    let f1: f64 = 3.14;
    let f2: f64 = 2.71;
    print("fadd: ${f1 + f2}");
    
    // Cast
    let i_val: i64 = 42;
    let f_val = i_val as f64;
    print("i64->f64: ${f_val}");
}

fn test_conditionals() {
    print("\n=== Conditionals ===");
    
    let x: i64 = 10;
    
    if (x > 5) { print("gt: PASS"); }
    else { print("gt: FAIL"); }
    
    if (x < 20) { print("lt: PASS"); }
    else { print("lt: FAIL"); }
    
    if (x >= 10) { print("gte: PASS"); }
    else { print("gte: FAIL"); }
    
    if (x <= 10) { print("lte: PASS"); }
    else { print("lte: FAIL"); }
    
    if (x == 10) { print("eq: PASS"); }
    else { print("eq: FAIL"); }
    
    if (x != 11) { print("neq: PASS"); }
    else { print("neq: FAIL"); }
    
    // Logical operators
    if (x > 5 && x < 15) { print("and: PASS"); }
    else { print("and: FAIL"); }
    
    if (x < 5 || x > 8) { print("or: PASS"); }
    else { print("or: FAIL"); }
    
    // Ternary-like if
    let label = if (x > 5) { "big" } else { "small" };
    print("if-expr: ${label}");
}

fn test_extern() {
    print("\n=== Extern C ===");
    print("time(): SKIP (no POSIX gettimeofday on this host)");
}

fn main() -> i32 {
    print("Bootstrap Trust Root Test");
    print("=========================");
    
    test_string_ops();
    test_structs();
    test_struct_with_string();
    test_classes();
    test_string_builder();
    test_vec();
    test_dict();
    test_if_chain();
    test_control_flow();
    test_recursion();
    test_string_heavy();
    test_arithmetic();
    test_conditionals();
    test_extern();
    
    print("\n=========================");
    print("All tests completed!");
    return 0;
}
