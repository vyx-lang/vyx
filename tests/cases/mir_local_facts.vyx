// PROJECT-BUILD-ONLY: opaque sink declarations are intentionally unresolved.
// P4 L0 local storage / escape facts fixture.
//
// This source is intentionally consumed through --dump-mir2 only. The
// opaque C declaration gives the local-facts analysis conservative call
// boundaries without requiring a native implementation or an executable.

extern "C" {
    fn opaque_local_sink(address: rawptr) -> i32;
    fn opaque_value_sink(value: i32) -> i32;
}

struct LocalFactsRecord {
    field: i32
    spare: i32
}

// The transport audit must find the root local past the old L0 resolver's
// 16-projection recursion cap.
struct Deep0 { value: i32 }
struct Deep1 { field: Deep0 }
struct Deep2 { field: Deep1 }
struct Deep3 { field: Deep2 }
struct Deep4 { field: Deep3 }
struct Deep5 { field: Deep4 }
struct Deep6 { field: Deep5 }
struct Deep7 { field: Deep6 }
struct Deep8 { field: Deep7 }
struct Deep9 { field: Deep8 }
struct Deep10 { field: Deep9 }
struct Deep11 { field: Deep10 }
struct Deep12 { field: Deep11 }
struct Deep13 { field: Deep12 }
struct Deep14 { field: Deep13 }
struct Deep15 { field: Deep14 }
struct Deep16 { field: Deep15 }
struct Deep17 { field: Deep16 }

@[c_repr]
enum LocalFactsOpenTag {
    Only,
}

fn scalar_nested_scope(seed: i32) -> i32 {
    let outer_scalar: i32 = seed + 1;
    {
        let nested_scalar: i32 = outer_scalar + 1;
        if (nested_scalar == seed + 2) { return outer_scalar; }
    }
    return outer_scalar;
}

fn opaque_direct_address(seed: i32) -> i32 {
    var direct_local: i32 = seed;
    let opaque_result = opaque_local_sink(&direct_local);
    return direct_local + opaque_result;
}

// The scalar only crosses an ordinary by-value call. L0 has no address escape
// to report here; L1 must still make it a transport barrier.
fn opaque_by_value(seed: i32) -> i32 {
    let by_value_local: i32 = seed + 1;
    let opaque_result = opaque_value_sink(by_value_local);
    return opaque_result;
}

// Likewise, constructing an aggregate from a scalar is not an address escape
// by itself, but it must not become a future lifetime/slot-reuse proof.
fn aggregate_transport(seed: i32) -> i32 {
    let aggregate_source: i32 = seed + 1;
    let aggregate_record = LocalFactsRecord { field: aggregate_source, spare: seed };
    return aggregate_record.field;
}

fn deep_projection_transport(seed: i32) -> i32 {
    var deep_projection_local: Deep17;
    deep_projection_local.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.value = seed;
    let opaque_result = opaque_value_sink(deep_projection_local.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.field.value);
    return opaque_result;
}

fn record_field_address(seed: i32) -> i32 {
    var record_local = LocalFactsRecord { field: seed, spare: seed + 1 };
    let opaque_result = opaque_local_sink(&record_local.field);
    return record_local.field + record_local.spare + opaque_result;
}

fn array_index_address(seed: i32, index: i32) -> i32 {
    var array_local: [i32; 4];
    array_local[0] = seed;
    array_local[1] = seed + 1;
    array_local[2] = seed + 2;
    array_local[3] = seed + 3;
    let opaque_result = opaque_local_sink(&array_local[index]);
    return array_local[index] + opaque_result;
}

fn dereference_address(seed: i32) -> i32 {
    var dereference_value: i32 = seed;
    let dereference_ptr: rawptr = to_rawptr(&dereference_value);
    let opaque_result = opaque_local_sink(&*dereference_ptr);
    return dereference_value + opaque_result;
}

fn return_local_addr(seed: i32) -> rawptr {
    var return_address_local: i32 = seed;
    let return_address: rawptr = to_rawptr(&return_address_local);
    return return_address;
}

fn closure_value_capture(seed: i32) -> i32 {
    let value_capture_source: i32 = seed;
    let read_value_capture = [value_capture_source]() -> i32 => {
        return value_capture_source;
    };
    return read_value_capture();
}

fn closure_reference_capture(seed: i32) -> i32 {
    var reference_capture_source: i32 = seed;
    let increment_reference_capture = [&reference_capture_source]() -> i32 => {
        reference_capture_source = reference_capture_source + 1;
        return reference_capture_source;
    };
    return increment_reference_capture();
}

fn early_return_local(flag: bool, seed: i32) -> i32 {
    let early_local: i32 = seed + 10;
    if (flag) { return early_local; }
    return early_local + 1;
}

fn cfg_closed_simple(seed: i32) -> i32 {
    {
        let cfg_closed_local: i32 = seed + 1;
        let cfg_closed_copy: i32 = cfg_closed_local;
    }
    return seed;
}

fn cfg_early_closed(flag: bool, seed: i32) -> i32 {
    let cfg_early_local: i32 = seed + 1;
    var result: i32 = 0;
    if (flag) {
        result = 1;
    } else {
        result = cfg_early_local;
    }
    return result;
}

fn cfg_open_empty_match(value: LocalFactsOpenTag) -> i32 {
    let cfg_open_local: i32 = 1;
    match (value) {
    }
}

fn loop_local(limit: i32) -> i32 {
    var index: i32 = 0;
    var total: i32 = 0;
    while (index < limit) {
        let iteration_local: i32 = index + 1;
        total = total + iteration_local;
        index = index + 1;
    }
    return total;
}

fn main() -> i32 {
    // The fixture is not executed by mir_local_facts.ps1: calls to
    // opaque_local_sink deliberately remain unresolved native boundaries.
    scalar_nested_scope(0);
    opaque_direct_address(0);
    opaque_by_value(0);
    aggregate_transport(0);
    deep_projection_transport(0);
    record_field_address(0);
    array_index_address(0, 0);
    dereference_address(0);
    return_local_addr(0);
    closure_value_capture(0);
    closure_reference_capture(0);
    early_return_local(false, 0);
    cfg_closed_simple(0);
    cfg_early_closed(false, 0);
    cfg_open_empty_match(LocalFactsOpenTag.Only);
    loop_local(0);
    return 0;
}
