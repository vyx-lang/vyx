fn choose(a: i32, b: i32) -> i32 {
    let x = if (a == 1) {
        10;
    } elif (b == 2) {
        20;
    } else {
        return 30;
    };
    return x + 1;
}

fn main() -> i32 {
    if (choose(1, 0) != 11) { return 1; }
    if (choose(0, 2) != 21) { return 2; }
    if (choose(0, 0) != 30) { return 3; }
    return 0;
}
