/// Lesson extras: suffixes, strings, if-expr, named args, constructor, arrays, tuples.

class Counter {
    public value: i32;

    public Counter(start: i32) {
        return Counter { value: start };
    }

    public fn increment() {
        self.value = self.value + 1;
    }
}

fn add(a: i32, b: i32 = 1) -> i32 {
    return a + b;
}

fn make_rect(x: i32, y: i32, w: i32, h: i32) -> i32 {
    return x * 1000 + y * 100 + w * 10 + h;
}

fn choose(flag: i32) -> i32 {
    return if (flag == 1) { 10 } else { 20 };
}

fn main() -> i32 {
    let hex = 0x2A;
    let bin = 0b101010;
    let oct = 0o52;
    let wide: i64 = 100i64;
    let byte: u8 = 255u8;
    if (hex != 42 || bin != 42 || oct != 42 || wide != 100 || byte != 255u8) { return 1; }

    let name = "Vyx";
    if ("hello ${name}" != "hello Vyx") { return 2; }
    if (f"hello ${name}" != "hello Vyx") { return 3; }
    let block = """line1
line2""";
    if (!block.contains("line1") || !block.contains("line2")) { return 4; }

    if (choose(1) != 10 || choose(0) != 20) { return 5; }

    if (add(3) != 4 || add(3, 4) != 7) { return 6; }
    if (add(a: 3, b: 4) != 7 || add(b: 4, a: 3) != 7) { return 7; }
    if (make_rect(w: 3, h: 4, x: 1, y: 2) != 1234) { return 8; }

    let c = Counter(10);
    c.increment();
    if (c.value != 11) { return 9; }

    var values: [i32; 3] = [1, 2, 3];
    var zeros: [i32; 4] = [0; 4];
    if (values[0] != 1 || values[2] != 3 || zeros[3] != 0) { return 11; }

    let t = (10, 20);
    if (t.0 != 10 || t.1 != 20) { return 12; }

    return 0;
}
