extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
}

@[c_repr]
enum SccpPlainTag {
    Cold,
    Warm,
    Hot,
}

@[c_repr]
enum SccpPayloadTag {
    Empty,
    Value(i32),
}

fn same_join(flag: bool) -> i32 {
    var same_value: i32 = 0;
    if (flag) {
        same_value = 17i32;
    } else {
        same_value = 17i32;
    }
    let same_copy: i32 = same_value;
    if (same_copy == 17i32) { return 101; }
    return -1;
}

fn different_join(flag: bool) -> i32 {
    var different_value: i32 = 0;
    if (flag) {
        different_value = 3i32;
    } else {
        different_value = 4i32;
    }
    let different_copy: i32 = different_value;
    if (different_copy == 3i32) { return 3; }
    return 4;
}

fn same_width_join(flag: bool) -> i32 {
    var width_value: u8 = 0u8;
    if (flag) {
        width_value = 255u8;
    } else {
        width_value = 255u8;
    }
    let width_copy: u8 = width_value;
    if (width_copy == 255u8) { return 102; }
    return -2;
}

fn same_null_join(flag: bool) -> i32 {
    var null_value: rawptr = null;
    if (flag) {
        null_value = null;
    } else {
        null_value = null;
    }
    let null_copy: rawptr = null_value;
    if (null_copy == null) { return 103; }
    return -3;
}

fn loop_same(count: i32) -> i32 {
    var loop_value: i32 = 9;
    var index: i32 = 0;
    while (index < count) {
        loop_value = 9;
        index = index + 1;
    }
    let loop_copy: i32 = loop_value;
    if (loop_copy == 9i32) { return 104; }
    return -4;
}

fn loop_changes(count: i32) -> i32 {
    var changing_value: i32 = 9;
    var index: i32 = 0;
    while (index < count) {
        changing_value = 10;
        index = index + 1;
    }
    let changing_copy: i32 = changing_value;
    if (changing_copy == 9i32) { return 9; }
    return 10;
}

fn escaped_local() -> i32 {
    var escaped_value: bool = true;
    let replacement: bool = false;
    unsafe { memcpy(to_rawptr(&escaped_value), to_rawptr(&replacement), 1); }
    let escaped_copy: bool = escaped_value;
    if (escaped_copy) { return 1; }
    return 0;
}

fn captured_local() -> i32 {
    var captured_value: bool = true;
    let clear_capture = [&captured_value]() -> i32 => {
        captured_value = false;
        return 0;
    };
    clear_capture();
    let captured_copy: bool = captured_value;
    if (captured_copy) { return 1; }
    return 0;
}

fn opaque_bool(flag: bool) -> bool {
    return flag;
}

fn call_result(flag: bool) -> i32 {
    let call_value: bool = opaque_bool(flag);
    if (call_value) { return 1; }
    return 0;
}

fn plain_enum_same_join(flag: bool) -> i32 {
    var tag: SccpPlainTag = SccpPlainTag.Cold;
    if (flag) {
        tag = SccpPlainTag.Warm;
    } else {
        tag = SccpPlainTag.Warm;
    }
    let enum_observed: SccpPlainTag = tag;
    match (enum_observed) {
        case Cold => { return -21; }
        case Warm => { return 211; }
        case Hot => { return -22; }
        default => { return -23; }
    }
}

fn plain_enum_different_join(flag: bool) -> i32 {
    var tag: SccpPlainTag = SccpPlainTag.Cold;
    if (flag) {
        tag = SccpPlainTag.Warm;
    } else {
        tag = SccpPlainTag.Cold;
    }
    let enum_different_observed: SccpPlainTag = tag;
    match (enum_different_observed) {
        case Cold => { return 301; }
        case Warm => { return 302; }
        case Hot => { return 303; }
        default => { return -31; }
    }
}

fn plain_enum_constructor_call_stays_dynamic() -> i32 {
    let call_constructed: SccpPlainTag = SccpPlainTag::Warm();
    match (call_constructed) {
        case Cold => { return -41; }
        case Warm => { return 411; }
        case Hot => { return -42; }
        default => { return -43; }
    }
}

fn payload_enum_stays_dynamic() -> i32 {
    let payload_observed: SccpPayloadTag = SccpPayloadTag.Empty;
    match (payload_observed) {
        case Empty => { return 421; }
        case Value(_) => { return -51; }
        default => { return -52; }
    }
}

fn plain_enum_guard_stays_dynamic(flag: bool) -> i32 {
    let guarded_observed: SccpPlainTag = SccpPlainTag.Warm;
    match (guarded_observed) {
        case Warm if flag => { return 431; }
        case Warm => { return 432; }
        default => { return -61; }
    }
}

fn plain_enum_default_stays_dynamic() -> i32 {
    let default_observed: SccpPlainTag = SccpPlainTag.Cold;
    match (default_observed) {
        case Warm => { return -62; }
        default => { return 441; }
    }
}

fn main() -> i32 {
    if (same_join(true) != 101) { return 1; }
    if (same_join(false) != 101) { return 2; }
    if (different_join(true) != 3) { return 3; }
    if (different_join(false) != 4) { return 4; }
    if (same_width_join(true) != 102) { return 5; }
    if (same_width_join(false) != 102) { return 6; }
    if (same_null_join(true) != 103) { return 7; }
    if (same_null_join(false) != 103) { return 8; }
    if (loop_same(0) != 104) { return 9; }
    if (loop_same(4) != 104) { return 10; }
    if (loop_changes(0) != 9) { return 11; }
    if (loop_changes(4) != 10) { return 12; }
    if (escaped_local() != 0) { return 13; }
    if (captured_local() != 0) { return 14; }
    if (call_result(true) != 1) { return 15; }
    if (call_result(false) != 0) { return 16; }
    if (plain_enum_same_join(true) != 211) { return 17; }
    if (plain_enum_same_join(false) != 211) { return 18; }
    if (plain_enum_different_join(true) != 302) { return 19; }
    if (plain_enum_different_join(false) != 301) { return 20; }
    if (plain_enum_constructor_call_stays_dynamic() != 411) { return 21; }
    if (payload_enum_stays_dynamic() != 421) { return 22; }
    if (plain_enum_guard_stays_dynamic(true) != 431) { return 23; }
    if (plain_enum_guard_stays_dynamic(false) != 432) { return 24; }
    if (plain_enum_default_stays_dynamic() != 441) { return 25; }
    print("mir_sccp OK");
    return 0;
}
