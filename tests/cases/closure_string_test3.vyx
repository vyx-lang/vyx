fn main() -> i32 {
    let a = "first";
    let b = "second";
    let c = "third";

    let pick = |idx: i32| -> string {
        if (idx == 0) { return a; }
        if (idx == 1) { return b; }
        return c;
    };

    print(pick(0));
    print(pick(1));
    print(pick(2));

    let counter = 0;
    let inc = |step: i32| -> i32 { return counter + step; };
    print(inc(10));
    print(inc(20));
    return 0;
}
