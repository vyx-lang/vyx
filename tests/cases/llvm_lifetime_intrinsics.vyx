// The positive case stays in one MIR block and has one lexical storage
// interval. The branch case deliberately needs multiple blocks and must stay
// outside the first lifetime-intrinsic proof slice.

fn direct_scalar(value: i32) -> i32 {
    let scoped = value + 7;
    return scoped;
}

// The two inner locals are same-type, direct, address-free intervals in the
// one return block. The P4 reuse slice may map `second` to `first`'s alloca,
// but it must still emit separate lifetime.start/end pairs in source order.
fn sequential_reuse(value: i32) -> i32 {
    var result: i32 = 0;
    {
        let first: i32 = value + 2;
        result = first;
    }
    {
        let second: i32 = result + 3;
        result = second;
    }
    return result;
}

// The outer interval overlaps inner and remains live after inner's dead
// marker. Even though both are i32 and one block, they must not share a slot.
fn overlap_guard(value: i32) -> i32 {
    var result: i32 = 0;
    {
        let outer: i32 = value + 1;
        {
            let inner: i32 = value + 2;
            result = outer + inner;
        }
        result = result + outer;
    }
    return result;
}

fn branch_excluded(value: i32, flag: bool) -> i32 {
    let scoped = value + 1;
    if (flag) { return scoped; }
    return scoped + 1;
}

fn main() -> i32 {
    if (direct_scalar(35) != 42) { return 1; }
    if (sequential_reuse(37) != 42) { return 2; }
    if (overlap_guard(10) != 34) { return 3; }
    if (branch_excluded(40, true) != 41) { return 4; }
    if (branch_excluded(40, false) != 42) { return 5; }
    print("llvm_lifetime_intrinsics OK");
    return 0;
}
