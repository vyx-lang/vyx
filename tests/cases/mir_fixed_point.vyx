var direct_call_count: i32 = 0;

fn fold_copy_and_constant_branch() -> i32 {
    let pure_eval: i32 = (7i32 + 6i32) * 3i32;
    let copied: i32 = pure_eval;
    if (true) {
        return copied;
    }
    return -1;
}

fn choose_select(flag: bool, left: i32, right: i32) -> i32 {
    let selected: i32 = if (flag) {
        left;
    } else {
        right;
    };
    return selected;
}

fn direct_call_must_remain(value: i32) -> i32 {
    direct_call_count = direct_call_count + 1;
    return value;
}

fn direct_call_negative() -> i32 {
    let kept_call: i32 = direct_call_must_remain(29i32);
    return kept_call;
}

fn main() -> i32 {
    if (fold_copy_and_constant_branch() != 39i32) { return 1; }
    if (choose_select(true, 10i32, 20i32) != 10i32) { return 2; }
    if (choose_select(false, 10i32, 20i32) != 20i32) { return 3; }
    if (direct_call_negative() != 29i32) { return 4; }
    if (direct_call_count != 1i32) { return 5; }
    print("mir_fixed_point OK");
    return 0;
}
