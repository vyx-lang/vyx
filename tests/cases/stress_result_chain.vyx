use std.core;

error E1 { A, B, C, D }
error E2 { X, Y, Z }

fn step1(n: i32) -> Result<i32, E1> {
    if (n < 0) { fail E1.A; }
    return n + 1;
}

fn step2(n: i32) -> Result<i32, E1> {
    if (n > 1000) { fail E1.B; }
    return n * 2;
}

fn step3(n: i32) -> Result<i32, E1> {
    if (n == 0) { fail E1.C; }
    return n + 10;
}

fn pipeline(start: i32) -> Result<i32, E1> {
    let a = step1(start)?;
    let b = step2(a)?;
    let c = step3(b)?;
    return c;
}

fn main() -> i32 {
    let r1 = pipeline(0)?;
    print(r1);

    let r2 = pipeline(5)?;
    print(r2);

    let r3 = pipeline(10)?;
    print(r3);

    let r4 = pipeline(99)?;
    print(r4);

    var i = 0;
    while (i < 50) {
        let r = pipeline(i)?;
        i = i + 1;
    }
    print(i);

    return 0;
}
