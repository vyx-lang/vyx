use std.string;

fn main() -> i32 {
    var a = ""; var b = ""; var c2 = ""; var d = "";
    var output = ""; var result = ""; var res = "";
    var i: i64 = 0;
    while (i < 6) {
        if (i % 3 == 0) {
            a = a + "X,"; b = b + "X,"; c2 = c2 + "X,"; d = d + "X,";
            output = output + "X,"; result = result + "X,"; res = res + "X,";
        } else {
            a = a + "${i},"; b = b + "${i},"; c2 = c2 + "${i},"; d = d + "${i},";
            output = output + "${i},"; result = result + "${i},"; res = res + "${i},";
        }
        i = i + 1;
    }
    print("a: ${a.contains(\"X\")}  b: ${b.contains(\"X\")}  c2: ${c2.contains(\"X\")}  d: ${d.contains(\"X\")}");
    print("output: ${output.contains(\"X\")}  result: ${result.contains(\"X\")}  res: ${res.contains(\"X\")}");
    return 0;
}
