fn apply(f: fn(i32) -> i32, val: i32) -> i32 {
    return f(val);
}

fn main() -> i32 {
    let base = 100;
    let mul = |x: i32| -> i32 { return x * base; };
    print(mul(3));

    let offset = 42;
    let adder = |x: i32| -> i32 { return x + offset; };
    print(adder(8));

    let a = 10;
    let b = 20;
    let sum_ab = |x: i32| -> i32 { return a + b + x; };
    print(sum_ab(5));
    return 0;
}
