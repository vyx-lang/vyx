var condition_effects: i32 = 0;

fn effect_condition() -> bool {
    condition_effects = condition_effects + 1;
    return condition_effects == 1;
}

fn pure_empty_branch(flag: bool) -> i32 {
    var value: i32 = 40;
    if (flag) {
    }
    value = value + 2;
    return value;
}

fn impure_empty_branch() -> i32 {
    if (effect_condition()) {
    }
    return condition_effects;
}

fn default_only(value: i32) -> i32 {
    var selected: i32 = 0;
    match (value) {
        default => { selected = 7; }
    }
    return selected;
}

fn constant_dead_arm() -> i32 {
    var selected: i32 = 0;
    if (true) {
        selected = 11;
    } else {
        selected = 99;
    }
    return selected;
}

fn loop_sum(limit: i32) -> i32 {
    var index: i32 = 0;
    var total: i32 = 0;
    while (index < limit) {
        total = total + index;
        index = index + 1;
    }
    return total;
}

fn main() -> i32 {
    if (pure_empty_branch(true) != 42) { return 1; }
    if (pure_empty_branch(false) != 42) { return 2; }
    if (impure_empty_branch() != 1) { return 3; }
    if (condition_effects != 1) { return 4; }
    if (default_only(123) != 7) { return 5; }
    if (constant_dead_arm() != 11) { return 6; }
    if (loop_sum(5) != 10) { return 7; }
    print("mir_cfg_simplify OK");
    return 0;
}
