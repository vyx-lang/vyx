use std.string;

fn automatic_string_loop_drop() -> i64 {
    var total: i64 = 0;
    var index: i64 = 0;
    while (index < 256) {
        let raw = "drop-${index}-AbC";
        let upper = raw.toUpper();
        let lower = upper.toLower();
        if (lower.startsWith("drop-") && upper.endsWith("ABC")) {
            total = total + raw.len + upper.len + lower.len;
        }
        index = index + 1;
    }
    return total;
}

// A literal is a tag-safe initial value. Once this local is replaced by a
// fresh concatenation result, each following self-update must release the
// previous allocation and the scope exit must release the final one.
fn automatic_string_reassignment_drop() -> i64 {
    var text = "";
    var index: i64 = 0;
    while (index < 1024) {
        text = text + "reassign-ownership-";
        index = index + 1;
    }
    return text.len;
}

fn main() -> i32 {
    let integer_text = int_to_string(42);
    if (integer_text.cap != 3 || integer_text.owned != 3) { return 11; }
    str_drop(integer_text);

    let boolean_text = bool_to_string(true);
    if (boolean_text.cap != 5 || boolean_text.owned != 3) { return 12; }
    str_drop(boolean_text);

    var part = "abcdef".substring(1, 4);
    if (part != "bcd") { return 13; }
    if (part.owned != 1) { return 14; }
    part += "!";
    if (part != "bcd!") { return 15; }
    if (part.owned != 4) { return 16; }
    str_drop(part);

    print(12345);
    let real_value: f64 = 3.5;
    print(real_value);

    let upper = "Abc".toUpper();
    if (upper != "ABC" || upper.cap != 4 || upper.owned != 4) { return 17; }
    str_drop(upper);
    let lower = "AbC".toLower();
    if (lower != "abc" || lower.cap != 4 || lower.owned != 4) { return 18; }
    str_drop(lower);
    let trimmed = "  text  ".trim();
    if (trimmed != "text" || trimmed.cap != 5 || trimmed.owned != 3) { return 19; }
    str_drop(trimmed);
    let replaced = "a-b-a".replace("a", "xy");
    if (replaced != "xy-b-xy" || replaced.cap != 8 || replaced.owned != 3) { return 20; }
    str_drop(replaced);

    let empty_upper = "".toUpper();
    if (empty_upper != "" || empty_upper.cap != 1 || empty_upper.owned != 4) { return 22; }
    str_drop(empty_upper);
    let empty_lower = "".toLower();
    if (empty_lower != "" || empty_lower.cap != 1 || empty_lower.owned != 4) { return 23; }
    str_drop(empty_lower);
    let empty_trimmed = "   ".trim();
    if (empty_trimmed != "" || empty_trimmed.cap != 1 || empty_trimmed.owned != 3) { return 24; }
    str_drop(empty_trimmed);
    let empty_replaced = "a".replace("a", "");
    if (empty_replaced != "" || empty_replaced.cap != 1 || empty_replaced.owned != 3) { return 25; }
    str_drop(empty_replaced);

    var empty_modern = String.fromStrResult("".toUpper());
    if (!empty_modern.isEmpty()) { return 26; }
    empty_modern.destroy();

    let interpolated = "real=${real_value}";
    if (interpolated != "real=3.5" || interpolated.owned != 4) { return 21; }
    str_drop(interpolated);

    // Direct consumers must release owning rvalues after use, while reads of
    // named values remain borrowed until their explicit drop below.
    print(int_to_string(67890));
    print("MiXeD".toUpper());
    let runtime_nested = "runtime=${int_to_string(2468)}";
    if (runtime_nested != "runtime=2468" || runtime_nested.owned != 4) { return 27; }
    str_drop(runtime_nested);
    let mixed_source = "MiXeD";
    let upper_nested = "upper=${mixed_source.toUpper()}";
    if (upper_nested != "upper=MIXED" || upper_nested.owned != 4) { return 28; }
    str_drop(upper_nested);

    let borrowed = int_to_string(77);
    print(borrowed);
    if (borrowed != "77" || borrowed.owned != 3) { return 29; }
    let borrowed_nested = "borrowed=${borrowed}";
    if (borrowed_nested != "borrowed=77" || borrowed_nested.owned != 4) { return 30; }
    if (borrowed != "77") { return 31; }
    str_drop(borrowed_nested);
    str_drop(borrowed);

    // Primitive str clone must allocate an independent owning value. A
    // shallow ABI copy duplicates the ownership tag and becomes dangling as
    // soon as either handle is released.
    let clone_source = "Clone contract".toUpper();
    let clone_copy = clone_source.clone();
    if (clone_copy.ptr == clone_source.ptr || clone_copy != "CLONE CONTRACT") { return 38; }
    str_drop(clone_source);
    if (clone_copy != "CLONE CONTRACT" || clone_copy.owned != 3) { return 39; }
    str_drop(clone_copy);

    // Repeated self-assignment must keep geometric capacity instead of
    // rebuilding an exact-size allocation at every append. This exercises
    // the builtin `str` path used by ordinary `text = text + piece` code.
    var grown = "";
    var append_index: i64 = 0;
    while (append_index < 2048) {
        grown = grown + "x";
        append_index = append_index + 1;
    }
    if (grown.len != 2048 || grown.charAt(0) != 'x' || grown.charAt(2047) != 'x') { return 32; }
    if (grown.cap < 2049 || grown.owned != 1) { return 33; }
    str_drop(grown);

    // The in-place branch must accept a directly consumed borrowed slice and
    // preserve the source bytes while appending into the same allocation.
    var alias_reuse = "abcd";
    alias_reuse = alias_reuse + "0123456789";
    alias_reuse = alias_reuse + from_cstr_view_len(alias_reuse.ptr + 2, 4);
    if (alias_reuse != "abcd0123456789cd01" || alias_reuse.owned != 1) { return 34; }
    str_drop(alias_reuse);

    // Force the replacement-allocation branch with a suffix pointing into the
    // old allocation. The source must be copied before that allocation drops.
    let alias_growth_raw = malloc(5);
    if (alias_growth_raw == null) { return 35; }
    memcpy(alias_growth_raw, "abcd".ptr, 5);
    var alias_growth = from_raw_string_parts(alias_growth_raw, 4, 5, 1);
    alias_growth = alias_growth + from_cstr_view_len(alias_growth.ptr + 1, 2);
    if (alias_growth != "abcdbc" || alias_growth.owned != 1 || alias_growth.cap < 7) { return 36; }
    str_drop(alias_growth);

    // Keeping a derived view in a named local deliberately invalidates the
    // uniqueness proof. The conservative concat path must retain correct bytes
    // and report the pool allocator that owns the replacement.
    var alias_fallback = "abcd";
    alias_fallback = alias_fallback + "0123456789";
    let alias_fallback_suffix = from_cstr_view_len(alias_fallback.ptr + 2, 4);
    alias_fallback = alias_fallback + alias_fallback_suffix;
    if (alias_fallback != "abcd0123456789cd01" || alias_fallback.owned != 4) { return 41; }
    str_drop(alias_fallback);

    // No explicit str_drop calls occur inside this loop. The three owning
    // locals must be released at the loop body's lexical scope boundary.
    if (automatic_string_loop_drop() != 8886) { return 37; }
    if (automatic_string_reassignment_drop() != 19456) { return 40; }

    print("codegen_string_temp_ownership OK");
    return 0;
}
