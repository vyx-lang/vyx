use std.core;

error ParseError {
    InvalidChar,
    Overflow,
    Empty
}

@[auto_wrap]
fn parse_int(val: i32) -> Result<i32, ParseError> {
    if (val < 0) {
        fail ParseError.InvalidChar;
    }
    return val * 2;
}

@[auto_wrap]
fn chain_parse() -> Result<i32, ParseError> {
    let a = parse_int(5)?;
    let b = parse_int(10)?;
    return a + b;
}

fn main() -> i32 {
    let r1 = parse_int(7)?;
    print(r1);

    let r2 = chain_parse()?;
    print(r2);

    let r3 = parse_int(0)?;
    print(r3);

    let r4 = parse_int(1)?;
    print(r4);

    return 0;
}
