use std.core;
use std.fmt;
use std.string;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
}

fn check_view_iterators() -> bool {
    let text: str = "A¢€𐍈";
    var direct_count: i64 = 0;
    var direct_sum: i64 = 0;
    for (scalar in text) {
        direct_count = direct_count + 1;
        direct_sum = direct_sum + scalar as i64;
    }
    if (direct_count != 4 || direct_sum != 74967) {
        print("view direct count=${direct_count} sum=${direct_sum}");
        return false;
    }

    var byte_count: i64 = 0;
    var byte_sum: i64 = 0;
    for (byte in text.bytes()) {
        byte_count = byte_count + 1;
        byte_sum = byte_sum + byte as i64;
    }
    if (byte_count != 10 || byte_sum != 1610) {
        print("view bytes count=${byte_count} sum=${byte_sum}");
        return false;
    }

    var char_count: i64 = 0;
    var char_sum: i64 = 0;
    for (scalar in text.chars()) {
        char_count = char_count + 1;
        char_sum = char_sum + scalar as i64;
    }
    if (char_count != 4 || char_sum != 74967) {
        print("view chars count=${char_count} sum=${char_sum}");
        return false;
    }
    return true;
}

fn check_owned_iterators() -> bool {
    var small = String.from("small");
    var direct_sum: i64 = 0;
    for (scalar in small) { direct_sum = direct_sum + scalar as i64; }
    var small_sum: i64 = 0;
    for (byte in small.bytes()) { small_sum = small_sum + byte as i64; }
    if (!small.isSmall() || direct_sum != 537 || small_sum != 537 || small.as_str() != "small") {
        small.destroy();
        return false;
    }

    var large = String.from("A¢€𐍈-abcdefghijklmnopqrstuvwxyz");
    var char_count: i64 = 0;
    var prefix_sum: i64 = 0;
    for (scalar in large.chars()) {
        if (char_count < 4) { prefix_sum = prefix_sum + scalar as i64; }
        char_count = char_count + 1;
    }
    let valid = large.isHeap()
        && char_count == 31
        && prefix_sum == 74967
        && large.starts_with("A¢€𐍈-");
    small.destroy();
    large.destroy();
    return valid;
}

fn check_next_and_invalid_utf8() -> bool {
    var cursor = "A".chars();
    let first = cursor.next();
    let end = cursor.next();
    if (first.isNone() || first.unwrap() as i64 != 65 || end.isSome()) {
        return false;
    }

    let data = malloc(3);
    if (data == null) { return false; }
    var b0: i32 = 192;
    var b1: i32 = 175;
    var b2: i32 = 65;
    memcpy(data, to_rawptr(&b0), 1);
    memcpy(data + 1, to_rawptr(&b1), 1);
    memcpy(data + 2, to_rawptr(&b2), 1);
    let invalid = from_cstr_view_len(data, 3);
    var count: i64 = 0;
    var sum: i64 = 0;
    for (scalar in invalid.chars()) {
        count = count + 1;
        sum = sum + scalar as i64;
    }
    free(data);
    return count == 3 && sum == 131131;
}

fn main() -> i32 {
    if (sizeof::<char>() != 4 || alignof::<char>() != 4) { return 5; }
    if (char_to_string(162 as char) != "¢"
        || char_to_string(8364 as char) != "€"
        || char_to_string(66376 as char) != "𐍈") {
        return 6;
    }
    if (!check_view_iterators()) { return 1; }
    if (!check_owned_iterators()) { return 2; }
    if (!check_next_and_invalid_utf8()) { return 3; }

    var empty_bytes: i64 = 0;
    var empty_direct: i64 = 0;
    for (_scalar in "") { empty_direct = empty_direct + 1; }
    for (_byte in "".bytes()) { empty_bytes = empty_bytes + 1; }
    var empty_chars: i64 = 0;
    for (_scalar in "".chars()) { empty_chars = empty_chars + 1; }
    if (empty_direct != 0 || empty_bytes != 0 || empty_chars != 0) { return 4; }

    print("string_iterators OK");
    return 0;
}
