use std.vio;

var g_thread_slot_a: i32 = 0;
var g_thread_slot_b: i32 = 0;
var g_coroutine_seen: i32 = 0;

@[async]
fn async_leaf(base: i32, delay_ms: i32) -> i32 {
    vio_sleep(delay_ms);
    return base + 1;
}

@[async]
fn async_chain(base: i32) -> i32 {
    let first = await async_leaf(base, 2);
    let second = await async_leaf(first, 2);
    let ready = await Task::<i32>.ready(5);
    return second + ready;
}

@[async]
fn async_pair_sum(a: i32, b: i32) -> i32 {
    let left = async_chain(a);
    let right = async_chain(b);
    let lv = await left;
    let rv = await right;
    return lv + rv;
}

fn write_slot_a(ctx: rawptr) -> i32 {
    vio_sleep(5);
    g_thread_slot_a = 11;
    return 0;
}

fn write_slot_b(ctx: rawptr) -> i32 {
    vio_sleep(1);
    g_thread_slot_b = 31;
    return 0;
}

fn coroutine_worker(ctx: rawptr) -> i32 {
    g_coroutine_seen = 1;
    yield WaitForNextTick();
    g_coroutine_seen = g_coroutine_seen + 2;
    return 0;
}

fn main() -> i32 {
    vio_start();

    let chain = async_chain(20);
    let chain_value = await chain;
    print("async chain value: ");
    print(chain_value);
    print("\n");
    if (chain_value != 27) { return 1; }

    let pair_value = await async_pair_sum(1, 10);
    print("async pair value: ");
    print(pair_value);
    print("\n");
    if (pair_value != 25) { return 2; }

    let p = Promise::<i32>.failed(7001);
    if (!p.is_done()) { return 3; }
    if (!p.is_failed()) { return 4; }
    if (p.error_code() != 7001) { return 5; }

    let t = Task::<i32>.failed(7002);
    if (!t.is_done()) { return 6; }
    if (!t.is_failed()) { return 7; }
    if (t.error_code() != 7002) { return 8; }

    let rc_a = vio_run_wait_ctx(write_slot_a as i64, null, 1000);
    let rc_b = vio_run_wait_ctx(write_slot_b as i64, null, 1000);
    if (rc_a != 0 || rc_b != 0) { return 9; }
    if (g_thread_slot_a != 11 || g_thread_slot_b != 31) { return 10; }

    let handle = StartCoruntine(coroutine_worker as i64);
    if (!handle.is_valid()) { return 11; }
    StopCoruntine(handle);
    if (g_coroutine_seen != 3) { return 12; }

    print("async/coroutine stress ok\n");
    vio_stop();
    return 0;
}
