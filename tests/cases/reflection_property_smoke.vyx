module tests.reflection_property_smoke;

use std.reflect;

@[reflect("TypeName")]
public class A {
    public data: i64;
}

fn main() -> i32 {
    var src = A { data: 10 };
    let t = getType("TypeName");

    let inst = t.bind(&src);
    let p = inst.getProperty("data");
    if (!p.valid) { return 1; }
    if (p.view::<i64>() != 10) { return 2; }
    p.write::<i64>(42);
    if (src.data != 42) { return 3; }

    let owned = t.attach(A { data: 7 });
    if (!owned.valid) { return 4; }
    let owned_prop = owned.getProperty("data");
    if (!owned_prop.valid) { return 5; }
    if (owned_prop.view::<i64>() != 7) { return 6; }

    let blank = t.create();
    if (!blank.valid) { return 7; }
    let blank_prop = blank.getProperty("data");
    if (!blank_prop.valid) { return 8; }
    if (blank_prop.view::<i64>() != 0) { return 9; }
    blank_prop.write::<i64>(99);
    let blank_view = blank.view::<A>();
    if (blank_view.data != 99) { return 10; }
    return 0;
}
