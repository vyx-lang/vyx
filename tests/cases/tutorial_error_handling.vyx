use std.core;

error ParseError {
    InvalidNumber
}

fn parse_number(input: string) -> Result<i32, ParseError> {
    if (input == "42") { return 42; }
    fail ParseError.InvalidNumber;
}

fn parse_plus_one(input: string) -> Result<i32, ParseError> {
    let value = parse_number(input)?;
    return value + 1;
}

fn lookup_name(id: i32) -> Option<string> {
    if (id == 1) { return Some("Vyx"); }
    return None;
}

fn main() -> i32 {
    let parsed = parse_plus_one("42");
    if (!parsed.is_ok() || parsed.unwrap() != 43) { return 1; }

    let failed = parse_plus_one("not-a-number");
    if (!failed.is_err() || failed.unwrap_or(99) != 99) { return 2; }
    match (failed) {
        case Err(_) => { }
        case Ok(_) => { return 3; }
    }

    let found = lookup_name(1);
    let missing = lookup_name(9);
    if (!found.isSome() || found.unwrap() != "Vyx") { return 4; }
    if (!missing.isNone() || missing.unwrap_or("fallback") != "fallback") { return 5; }
    return 0;
}
