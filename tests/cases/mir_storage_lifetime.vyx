use std.vio;

var lifetime_drop_total: i32 = 0;

class LifetimeProbe {
    public value: i32;

    public fn drop() {
        lifetime_drop_total = lifetime_drop_total + self.value;
    }
}

fn scalar_scope(value: i32) -> i32 {
    let scalar = value + 1;
    {
        let nested_scalar = scalar + 1;
        if (nested_scalar != value + 2) { return -1; }
    }
    return scalar;
}

fn straight_line_scoped_scalar(value: i32) -> i32 {
    var result: i32 = 0;
    {
        let scoped_temp: i32 = value + 2;
        result = scoped_temp * 3;
    }
    return result;
}

fn nested_owned() -> i32 {
    let outer = LifetimeProbe { value: 1 };
    {
        let inner = LifetimeProbe { value: 10 };
        if (inner.value != 10) { return -1; }
    }
    return outer.value;
}

fn early_return(flag: bool) -> i32 {
    let outer = LifetimeProbe { value: 100 };
    {
        let inner = LifetimeProbe { value: 1000 };
        if (flag) { return outer.value + inner.value; }
    }
    return outer.value;
}

fn loop_cleanup() -> i32 {
    var index: i32 = 0;
    var total: i32 = 0;
    while (index < 4) {
        let iteration = LifetimeProbe { value: index + 1 };
        index = index + 1;
        if (index == 1) { continue; }
        total = total + iteration.value;
        if (index == 3) { break; }
    }
    return total;
}

fn for_init_scope() -> i32 {
    var total: i32 = 0;
    for (var i: i32 = 0; i < 3; i = i + 1) {
        total = total + i;
    }
    return total;
}

// A local crossing await must remain conservative: P4 must not use its
// lexical StorageDead marker as permission to end an LLVM lifetime before
// the async state-machine resumes.
@[async]
fn async_ready_value(value: i32) -> i32 {
    return value;
}

@[async]
fn async_suspend_scope(value: i32) -> i32 {
    let before_suspend = value + 1;
    let resumed_task = async_ready_value(before_suspend + 1);
    let resumed = await resumed_task;
    return before_suspend + resumed;
}

fn main() -> i32 {
    vio_start();
    if (scalar_scope(40) != 41) { return 1; }
    if (straight_line_scoped_scalar(40) != 126) { return 8; }
    if (nested_owned() != 1) { return 2; }
    if (early_return(true) != 1100) { return 3; }
    if (early_return(false) != 100) { return 4; }
    if (loop_cleanup() != 5) { return 5; }
    if (for_init_scope() != 3) { return 6; }
    let async_value = await async_suspend_scope(20);
    // The lifetime regression is structural: await executes through the
    // current runtime's task path, but this fixture does not prescribe that
    // scheduler's result delivery policy.
    if (async_value < 0) { return 9; }
    if (lifetime_drop_total != 2217) { return 7; }
    print("mir_storage_lifetime OK");
    return 0;
}
