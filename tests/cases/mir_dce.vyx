var effect_count: i32 = 0;
var drop_count: i32 = 0;

class DceDropProbe {
    public value: i32;

    public fn drop() {
        drop_count = drop_count + 1;
    }
}

fn tick() -> i32 {
    effect_count = effect_count + 1;
    return effect_count;
}

fn identity(value: i32) -> i32 {
    return value;
}

fn dead_param_compare(value: i32) -> i32 {
    value;
    value == value;
    value < 99;
    return 17;
}

fn local_read_must_remain(value: i32) -> i32 {
    let local = identity(value);
    local == 17;
    return value;
}

fn keep_direct_call() -> i32 {
    tick();
    return effect_count;
}

fn keep_binary_call() -> i32 {
    tick() + 1;
    return effect_count;
}

fn keep_auto_drop() -> i32 {
    {
        let probe = DceDropProbe { value: 1 };
    }
    return drop_count;
}

fn main() -> i32 {
    if (dead_param_compare(9) != 17) { return 1; }
    if (local_read_must_remain(9) != 9) { return 2; }
    if (keep_auto_drop() != 1) { return 3; }
    if (keep_direct_call() != 1) { return 4; }
    if (keep_binary_call() != 2) { return 5; }
    print("mir_dce OK");
    return 0;
}
