use std.vio;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn thread_worker(ctx: rawptr) -> i32 {
    let val: i64 = 1234;
    unsafe {
        memcpy(ctx, to_rawptr(&val), 8);
    }
    return 0;
}

fn fiber_worker(ctx: rawptr) -> i32 {
    var val: i64 = 0;
    unsafe {
        memcpy(to_rawptr(&val), ctx, 8);
        val = val + 1;
        memcpy(ctx, to_rawptr(&val), 8);
    }
    return 0;
}

var zero_arg_callback_seen: i32 = 0;

fn zero_arg_callback() -> i32 {
    zero_arg_callback_seen = 1;
    return 0;
}

fn multiarg_raw_callback(hwnd: rawptr, msg: u32, wparam: u64, lparam: i64) -> rawptr {
    if (msg == 0 && wparam == 0 && lparam == 0) { return hwnd; }
    return null;
}

fn main() -> i32 {
    let callback_ptr = multiarg_raw_callback as rawptr;
    if (callback_ptr == null) {
        return 6;
    }

    var thread_slot: i64 = 0;
    let thread_rc = vio_run_wait_ctx(thread_worker as i64, to_rawptr(&thread_slot), 1000);
    if (thread_rc != 0) {
        return 1;
    }
    if (thread_slot != 1234) {
        return 2;
    }

    let zero_arg_rc = vio_run_wait_ctx(zero_arg_callback as i64, null, 1000);
    if (zero_arg_rc != 0 || zero_arg_callback_seen != 1) {
        return 7;
    }

    let main_fiber = vio_fiber_start();
    if (main_fiber == null) {
        return 3;
    }
    var fiber_slot: i64 = 7;
    let fiber = StartCoroutineCtx(main_fiber, fiber_worker as i64, to_rawptr(&fiber_slot));
    if (fiber == null) {
        vio_fiber_stop(main_fiber);
        return 4;
    }
    if (fiber_slot != 8) {
        vio_fiber_delete(fiber);
        vio_fiber_stop(main_fiber);
        return 5;
    }

    vio_fiber_delete(fiber);
    vio_fiber_stop(main_fiber);
    return 0;
}
