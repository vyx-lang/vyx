use std.core;

error NetError {
    Timeout,
    Refused,
    Reset
}

fn fetch(code: i32) -> Result<i32, NetError> {
    if (code == 1) {
        fail NetError.Timeout;
    }
    return code + 100;
}

fn process() -> Result<i32, NetError> {
    let val = fetch(0)?;
    return val + 1;
}

fn main() -> i32 {
    let x = fetch(5)?;
    print(x);

    let y = process()?;
    print(y);

    let z = fetch(50)?;
    print(z);

    return 0;
}
