// common_verify: arithmetic (no imports; run: vyxc --run this file)
fn main() -> i32 {
    assert(1 + 2 == 3);
    assert(10 - 4 == 6);
    assert(3 * 7 == 21);
    assert(20 / 4 == 5);
    assert(20 % 6 == 2);
    assert((5 | 2) == 7);
    assert((5 & 2) == 0);
    assert((5 ^ 2) == 7);
    assert((1 << 3) == 8);
    assert((16 >> 2) == 4);
    let a: i32 = 40;
    let b: i32 = 2;
    assert(a + b == 42);
    return 0;
}
