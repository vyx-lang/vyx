// common_verify: enum and match
enum Axis {
    X,
    Y
}

fn axis_tag(a: Axis) -> i32 {
    match (a) {
        case X => { return 1; }
        case Y => { return 2; }
        default => { return 0; }
    }
}

fn main() -> i32 {
    assert(axis_tag(Axis.X) == 1);
    assert(axis_tag(Axis.Y) == 2);
    return 0;
}
