// common_verify: string concat and interpolation
use std.string;

fn main() -> i32 {
    let a = "ab";
    let b = "cd";
    let c = a + b;
    assert(c == "abcd");
    let n: i32 = 5;
    let s = "x${n}y";
    assert(s == "x5y");

    var acc = "seed";
    var i: i64 = 0;
    while (i < 8) {
        let piece = "x${i}";
        acc = acc + piece;
        i = i + 1;
    }
    assert(acc == "seedx0x1x2x3x4x5x6x7");

    var aliased = "seed";
    let before = aliased;
    aliased = aliased + "x";
    assert(before == "seed");
    assert(aliased == "seedx");
    assert(aliased.contains("edx"));
    assert(aliased.startsWith("seed"));
    return 0;
}
