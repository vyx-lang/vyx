// common_verify: std.fs file/directory classification
use std.fs;

fn main() -> i32 {
    if (!isDir("tests")) { return 1; }
    if (!isDir("tests/cases/smoke/common")) { return 2; }
    if (isDir("tests/cases/smoke/common/common_fs_paths.vyx")) { return 3; }
    if (!fileExists("tests/cases/smoke/common/common_fs_paths.vyx")) { return 4; }
    if (!isFile("tests/cases/smoke/common/common_fs_paths.vyx")) { return 5; }
    if (isFile("tests/cases/smoke/common")) { return 6; }
    return 0;
}
