// common_verify: branches and loops
fn main() -> i32 {
    var x: i32 = 0;
    if (0) {
        x = 1;
    } elif (1) {
        x = 2;
    } else {
        x = 3;
    }
    assert(x == 2);

    var i: i32 = 0;
    var s: i32 = 0;
    while (i < 5) {
        s = s + i;
        i = i + 1;
    }
    assert(s == 10);

    var j: i32 = 0;
    while (j < 3) {
        if (j == 1) {
            break;
        }
        j = j + 1;
    }
    assert(j == 1);

    return 0;
}
