fn classify(flag: bool) -> i32 {
    let folded: i32 = (2i32 + 3i32) * 4i32;
    var selected: i32 = 0;
    if (folded == 20i32) {
        selected = 40;
    } else {
        selected = -100;
    }

    if (flag) {
        selected = selected + 2;
    } else {
        selected = selected + 1;
    }

    match (selected) {
        case 42 => { return 420; }
        case 41 => { return 410; }
        default => { return -1; }
    }
}

fn main() -> i32 {
    if (classify(true) != 420) { return 1; }
    if (classify(false) != 410) { return 2; }
    print("mir_pass_analysis OK");
    return 0;
}
