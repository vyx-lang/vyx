extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(value: rawptr);
}

fn main() -> i32 {
    let storage = malloc(32);
    if (storage == null) { return 1; }

    // These are runtime values (and therefore cannot be folded into literal
    // GEP indexes). They exercise signed extension, unsigned extension and
    // 64-to-32 truncation in the target-aware lowering path.
    let signed_zero: i32 = argCount() - argCount();
    let unsigned_zero: u32 = (argCount() as u32) - (argCount() as u32);
    let wide_zero: i64 = (argCount() as i64) - (argCount() as i64);
    let signed_dynamic = storage + signed_zero;
    let unsigned_dynamic = signed_dynamic + unsigned_zero;
    let wide_dynamic = unsigned_dynamic + wide_zero;
    if (wide_dynamic != storage) {
        free(storage);
        return 2;
    }

    ptr_write_i32(storage + 4, 1234);
    if (ptr_read_i32(4 + storage) != 1234) {
        free(storage);
        return 3;
    }

    let tail = storage + 12;
    if (tail - 8 != storage + 4) {
        free(storage);
        return 4;
    }

    free(storage);
    print("llvm_pointer_gep OK");
    return 0;
}
