use std.math;

class Line {
    public x0: f32;
    public y0: f32;
    public x1: f32;
    public y1: f32;
}

fn near(a: f64, b: f64) -> bool {
    return abs_f64(a - b) <= 0.000001;
}

fn main() -> i32 {
    let line = Line { x0: 3.0 as f32, y0: 4.0 as f32, x1: 6.0 as f32, y1: 8.0 as f32 };
    let dx = line.x1 - line.x0;
    let dy = line.y1 - line.y0;
    let len = sqrt((dx as f64) * (dx as f64) + (dy as f64) * (dy as f64));
    if (!near(len, 5.0)) { return 1; }
    let half = line.x1 / (2.0 as f32);
    let nx = ((0.0 as f32) - dy) / half;
    let ny = dx / half;
    if (!near(nx as f64, -1.333333)) { return 2; }
    if (!near(ny as f64, 1.0)) { return 3; }
    return 0;
}
