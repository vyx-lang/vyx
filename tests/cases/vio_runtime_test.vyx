use std.vio;

fn main() -> i32 {
    if (vio_start() != 0) { return 1; }
    if (!vio_is_started()) { return 2; }
    let t0 = now();
    yield WaitForNextTick();
    sleep(1);
    let t1 = now();
    if (t1 < t0) { return 3; }
    vio_stop();
    if (vio_is_started()) { return 4; }
    return 0;
}
