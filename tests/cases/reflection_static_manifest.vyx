module tests.reflection_static_manifest;

use std.reflect;

@[reflect("TypeName")]
public class A {
    public data: i64;
    @[hidden]
    public hiddenData: i64;
    private privateData: i64;

    public fn Method(a: i32) -> i32 {
        return a + 1;
    }
}

fn main() -> i32 {
    var src = A {
        data: 10,
        hiddenData: 11,
        privateData: 12
    };

    let t = getType("TypeName");
    if (!t.valid) { return 1; }
    if (t.name != "TypeName") { return 2; }
    if (t.field_count != 1) { return 3; }
    if (t.method_count != 1) { return 4; }

    let f = t.getField("data");
    if (!f.valid) { return 5; }
    if (f.name != "data") { return 6; }
    if (t.getField("hiddenData").valid) { return 7; }
    if (t.getField("privateData").valid) { return 8; }

    let inst = t.bind(&src);
    let p = inst.getProperty("data");
    if (!p.valid) { return 9; }
    if (p.view::<i64>() != 10) { return 10; }
    p.write::<i64>(42);
    if (src.data != 42) { return 11; }

    let rawp = p.as::<i64>();
    if (*rawp != 42) { return 12; }
    p.write::<i64>(64);
    if (*rawp != 64) { return 13; }

    let m = inst.getMethod("Method");
    if (!m.valid) { return 14; }
    if (m.param_count != 1) { return 15; }
    if (m.return_type != "i32") { return 16; }

    print(t.name);
    print(src.data.toString());
    return 0;
}
