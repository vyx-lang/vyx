use std.collections;
error TestErr {
    Failed,
    Skipped
}

fn make_value(i: i32) -> Result<i32, TestErr> {
    if (i < 0) { fail TestErr.Failed; }
    return i * 3;
}

fn main() -> i32 {
    let s1 = "Hello";
    let s2 = "World";
    let empty = "";

    print(s1.len);
    print(s2.len);
    print(empty.len == 0);
    print(s1.len == 0);
    print(s1 == s1);
    print(s1 == s2);

    let capture_s1 = |x: i32| -> string { return s1; };
    let capture_s2 = |x: i32| -> string { return s2; };

    var i = 0;
    while (i < 100) {
        let a = capture_s1(i);
        let b = capture_s2(i);
        let v = make_value(i)?;
        i = i + 1;
    }

    print(capture_s1(0));
    print(capture_s2(0));
    print(i);

    let v = Vec::<i32>.new();
    var j = 0;
    while (j < 50) {
        v.push(j);
        j = j + 1;
    }
    print(v.len);
    v.destroy();

    return 0;
}
