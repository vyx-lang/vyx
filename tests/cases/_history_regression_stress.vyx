use std.collections;
use std.ref;

struct BigToken {
    a0: i64
    a1: i64
    a2: i64
    a3: i64
    a4: i64
    a5: i64
    a6: i64
    a7: i64
    a8: i64
    a9: i64
    a10: i64
    a11: i64
    a12: i64
    a13: i64
    a14: i64
    a15: i64
}

fn make_token(seed: i64) -> BigToken {
    return BigToken {
        a0: seed,
        a1: seed + 1,
        a2: seed + 2,
        a3: seed + 3,
        a4: seed + 4,
        a5: seed + 5,
        a6: seed + 6,
        a7: seed + 7,
        a8: seed + 8,
        a9: seed + 9,
        a10: seed + 10,
        a11: seed + 11,
        a12: seed + 12,
        a13: seed + 13,
        a14: seed + 14,
        a15: seed + 15
    };
}

fn early_return_helper(probe: Ref<i64>) {
    var local = probe.clone();
    {
        if (local.count() == 2) {
            return;
        }
    }
}

fn test_big_vec_push() -> i32 {
    var tokens = Vec::<BigToken>.with_capacity(4);
    var i: i64 = 0;
    while (i < 96) {
        tokens.push(make_token(i * 10));
        i = i + 1;
    }

    if (tokens.len != 96) { return 1; }
    let mid = tokens.get(42);
    if (mid.a0 != 420) { return 2; }
    if (mid.a15 != 435) { return 3; }
    let last = tokens.get(95);
    if (last.a7 != 957) { return 4; }
    return 0;
}

fn test_dict_string_key_constraints() -> i32 {
    var keywords = Dict::<string, i64>.new();
    var i: i64 = 0;
    while (i < 80) {
        keywords.put("kw_${i}", i);
        i = i + 1;
    }

    if (keywords.len != 80) { return 10; }
    if (keywords.get("kw_0") != 0) { return 11; }
    if (keywords.get("kw_42") != 42) { return 12; }
    if (keywords.get("kw_79") != 79) { return 13; }
    if (!keywords.contains("kw_42")) { return 14; }
    return 0;
}

fn test_nested_dict_vec_value() -> i32 {
    var ast = Dict::<string, Vec::<string>>.new();

    var fn_children = Vec::<string>.new();
    fn_children.push("name");
    fn_children.push("params");
    fn_children.push("body");
    ast.put("FnDecl", fn_children);

    var if_children = Vec::<string>.new();
    if_children.push("condition");
    if_children.push("then_block");
    if_children.push("else_block");
    ast.put("IfStmt", if_children);

    if (ast.len != 2) { return 20; }
    let got = ast.get("FnDecl");
    if (got.len != 3) { return 21; }
    if (got.get(0) != "name") { return 22; }
    if (got.get(2) != "body") { return 23; }
    return 0;
}

fn test_vec_of_dict_scope_stack() -> i32 {
    var scopes = Vec::<Dict::<string, i64>>.new();

    var global_scope = Dict::<string, i64>.new();
    global_scope.put("print", 1);
    global_scope.put("main", 2);
    scopes.push(global_scope);

    var fn_scope = Dict::<string, i64>.new();
    fn_scope.put("x", 10);
    fn_scope.put("y", 20);
    scopes.push(fn_scope);

    var block_scope = Dict::<string, i64>.new();
    block_scope.put("tmp", 100);
    block_scope.put("x", 99);
    scopes.push(block_scope);

    if (scopes.len != 3) { return 24; }

    var found = false;
    var found_val: i64 = 0;
    var si = scopes.len - 1;
    while (si >= 0) {
        let scope = scopes.get(si);
        if (scope.contains("x")) {
            found = true;
            found_val = scope.get("x");
            break;
        }
        si = si - 1;
    }
    if (!found) { return 25; }
    if (found_val != 99) { return 26; }

    return 0;
}

fn test_ref_weak_reassign_and_return() -> i32 {
    var r1 = Ref::<i64>.new(10);
    var w1 = Weak::<i64>.of(r1);
    if (w1.strong_count() != 1) { return 30; }

    r1 = Ref::<i64>.new(20);
    if (w1.strong_count() != 0) { return 31; }
    if (r1.count() != 1) { return 32; }

    var r2 = Ref::<i64>.new(100);
    early_return_helper(r2.clone());
    if (r2.count() != 1) { return 33; }
    return 0;
}

fn test_closure_return_drop_boundary() -> i32 {
    var owner = Ref::<i64>.new(77);
    var weak = Weak::<i64>.of(owner);

    let f = |x: i32| -> i32 {
        if (x > 0) { return 11; }
        return 0;
    };

    if (f(1) != 11) { return 40; }
    if (weak.strong_count() != 1) { return 41; }
    if (owner.count() != 1) { return 42; }
    return 0;
}

fn main() -> i32 {
    var rc = test_big_vec_push();
    if (rc != 0) { return rc; }

    rc = test_dict_string_key_constraints();
    if (rc != 0) { return rc; }

    rc = test_nested_dict_vec_value();
    if (rc != 0) { return rc; }

    rc = test_vec_of_dict_scope_stack();
    if (rc != 0) { return rc; }

    rc = test_ref_weak_reassign_and_return();
    if (rc != 0) { return rc; }

    rc = test_closure_return_drop_boundary();
    if (rc != 0) { return rc; }

    return 0;
}
