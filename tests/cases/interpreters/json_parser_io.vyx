use std.fs;
use std.io;
use std.string;

fn json_is_digit(ch: i32) -> bool {
    return ch >= 48 && ch <= 57;
}

class JsonParser {
    public text: string;
    public pos: i64;
    public ok: bool;
    public objects: i64;
    public arrays: i64;
    public keys: i64;
    public strings: i64;
    public numbers: i64;
    public bools: i64;
    public nulls: i64;
    public number_sum: i64;
    public max_depth: i64;

    public static fn new(text: string) -> JsonParser {
        return JsonParser {
            text: text,
            pos: 0,
            ok: true,
            objects: 0,
            arrays: 0,
            keys: 0,
            strings: 0,
            numbers: 0,
            bools: 0,
            nulls: 0,
            number_sum: 0,
            max_depth: 0
        };
    }

    fn bump_depth(depth: i64) {
        if (depth > self.max_depth) {
            self.max_depth = depth;
        }
    }

    fn skip_ws() {
        while (self.pos < self.text.len) {
            let ch = self.text.charAt(self.pos);
            if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
                self.pos = self.pos + 1;
            } else {
                break;
            }
        }
    }

    fn consume(ch: i32) -> bool {
        self.skip_ws();
        if (self.pos >= self.text.len) {
            self.ok = false;
            return false;
        }
        if (self.text.charAt(self.pos) != ch) {
            self.ok = false;
            return false;
        }
        self.pos = self.pos + 1;
        return true;
    }

    fn parse_string_token(count_value: bool) -> bool {
        self.skip_ws();
        if (self.pos >= self.text.len || self.text.charAt(self.pos) != 34) {
            self.ok = false;
            return false;
        }
        self.pos = self.pos + 1;
        while (self.pos < self.text.len) {
            let ch = self.text.charAt(self.pos);
            if (ch == 92) {
                self.pos = self.pos + 2;
            } elif (ch == 34) {
                self.pos = self.pos + 1;
                if (count_value) { self.strings = self.strings + 1; }
                return true;
            } else {
                self.pos = self.pos + 1;
            }
        }
        self.ok = false;
        return false;
    }

    fn match_lit(lit: string) -> bool {
        self.skip_ws();
        if (self.pos + lit.len > self.text.len) {
            self.ok = false;
            return false;
        }
        if (self.text.substring(self.pos, self.pos + lit.len) != lit) {
            self.ok = false;
            return false;
        }
        self.pos = self.pos + lit.len;
        return true;
    }

    fn parse_number() -> bool {
        self.skip_ws();
        var sign: i64 = 1;
        if (self.pos < self.text.len && self.text.charAt(self.pos) == 45) {
            sign = -1;
            self.pos = self.pos + 1;
        }
        if (self.pos >= self.text.len || !json_is_digit(self.text.charAt(self.pos))) {
            self.ok = false;
            return false;
        }
        var val: i64 = 0;
        while (self.pos < self.text.len && json_is_digit(self.text.charAt(self.pos))) {
            val = val * 10 + ((self.text.charAt(self.pos) - 48) as i64);
            self.pos = self.pos + 1;
        }
        if (self.pos < self.text.len && self.text.charAt(self.pos) == 46) {
            self.pos = self.pos + 1;
            while (self.pos < self.text.len && json_is_digit(self.text.charAt(self.pos))) {
                self.pos = self.pos + 1;
            }
        }
        self.numbers = self.numbers + 1;
        self.number_sum = self.number_sum + sign * val;
        return true;
    }

    fn parse_array(depth: i64) -> bool {
        if (!self.consume(91)) { return false; }
        self.arrays = self.arrays + 1;
        self.bump_depth(depth);
        self.skip_ws();
        if (self.pos < self.text.len && self.text.charAt(self.pos) == 93) {
            self.pos = self.pos + 1;
            return true;
        }
        while (self.ok) {
            if (!self.parse_value(depth + 1)) { return false; }
            self.skip_ws();
            if (self.pos < self.text.len && self.text.charAt(self.pos) == 44) {
                self.pos = self.pos + 1;
            } elif (self.pos < self.text.len && self.text.charAt(self.pos) == 93) {
                self.pos = self.pos + 1;
                return true;
            } else {
                self.ok = false;
                return false;
            }
        }
        return false;
    }

    fn parse_object(depth: i64) -> bool {
        if (!self.consume(123)) { return false; }
        self.objects = self.objects + 1;
        self.bump_depth(depth);
        self.skip_ws();
        if (self.pos < self.text.len && self.text.charAt(self.pos) == 125) {
            self.pos = self.pos + 1;
            return true;
        }
        while (self.ok) {
            if (!self.parse_string_token(false)) { return false; }
            self.keys = self.keys + 1;
            if (!self.consume(58)) { return false; }
            if (!self.parse_value(depth + 1)) { return false; }
            self.skip_ws();
            if (self.pos < self.text.len && self.text.charAt(self.pos) == 44) {
                self.pos = self.pos + 1;
            } elif (self.pos < self.text.len && self.text.charAt(self.pos) == 125) {
                self.pos = self.pos + 1;
                return true;
            } else {
                self.ok = false;
                return false;
            }
        }
        return false;
    }

    fn parse_value(depth: i64) -> bool {
        self.skip_ws();
        if (self.pos >= self.text.len) {
            self.ok = false;
            return false;
        }
        let ch = self.text.charAt(self.pos);
        if (ch == 123) {
            return self.parse_object(depth);
        }
        if (ch == 91) {
            return self.parse_array(depth);
        }
        if (ch == 34) {
            return self.parse_string_token(true);
        }
        if (ch == 45 || json_is_digit(ch)) {
            return self.parse_number();
        }
        if (ch == 116) {
            if (!self.match_lit("true")) { return false; }
            self.bools = self.bools + 1;
            return true;
        }
        if (ch == 102) {
            if (!self.match_lit("false")) { return false; }
            self.bools = self.bools + 1;
            return true;
        }
        if (ch == 110) {
            if (!self.match_lit("null")) { return false; }
            self.nulls = self.nulls + 1;
            return true;
        }
        self.ok = false;
        return false;
    }

    public fn parse() -> bool {
        let parsed = self.parse_value(1);
        self.skip_ws();
        if (!parsed || self.pos != self.text.len) {
            self.ok = false;
        }
        return self.ok;
    }
}

fn main() -> i32 {
    let path = "vyx_json_parser_io.tmp.json";
    let json =
        "{ \"name\": \"vyx\", \"enabled\": true, \"count\": 3, " +
        "\"items\": [1, 2, 3, {\"kind\":\"io\", \"valid\": false, \"empty\": null}], " +
        "\"nested\": {\"a\": {\"b\": [10, -4]}} }";

    if (writeFile(path, json) != 0) {
        println("json write failed");
        return 1;
    }
    let loaded = readFile(path);
    if (loaded.len == 0 || !fileExists(path)) {
        println("json read failed");
        return 2;
    }

    var parser = JsonParser.new(loaded);
    let ok = parser.parse();
    println("json ok=${ok} objects=${parser.objects} arrays=${parser.arrays} keys=${parser.keys}");
    println("json strings=${parser.strings} numbers=${parser.numbers} bools=${parser.bools} nulls=${parser.nulls}");
    println("json sum=${parser.number_sum} depth=${parser.max_depth} bytes=${loaded.len}");
    deleteFile(path);

    if (!ok) { return 10; }
    if (parser.objects != 4) { return 11; }
    if (parser.arrays != 2) { return 12; }
    if (parser.keys != 10) { return 13; }
    if (parser.strings != 2) { return 14; }
    if (parser.numbers != 6) { return 15; }
    if (parser.bools != 2) { return 16; }
    if (parser.nulls != 1) { return 17; }
    if (parser.number_sum != 15) { return 18; }
    if (parser.max_depth != 4) { return 19; }
    println("json_parser_io OK");
    return 0;
}
