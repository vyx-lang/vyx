use std.collections;
use std.fs;
use std.io;
use std.string;

class BrainfuckResult {
    public ok: bool;
    public output: String;
    public steps: i64;

    public static fn new(ok: bool, output: String, steps: i64) -> BrainfuckResult {
        return BrainfuckResult { ok: ok, output: output, steps: steps };
    }
}

fn interpret_brainfuck(program: string, input: string) -> BrainfuckResult {
    var jumps = Vec::<i64>.new();
    var ji: i64 = 0;
    while (ji < program.len) {
        jumps.push(-1);
        ji = ji + 1;
    }

    var stack = Vec::<i64>.new();
    ji = 0;
    while (ji < program.len) {
        let ch = program.charAt(ji);
        if (ch == 91) {
            stack.push(ji);
        } elif (ch == 93) {
            if (stack.len == 0) { return BrainfuckResult.new(false, String.from("bad-brackets"), 0); }
            let start = stack.pop();
            jumps.set(start, ji);
            jumps.set(ji, start);
        }
        ji = ji + 1;
    }
    if (stack.len != 0) {
        return BrainfuckResult.new(false, String.from("bad-brackets"), 0);
    }

    var tape = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 64) {
        tape.push(0);
        i = i + 1;
    }

    var out = StringBuilder.create();
    var ip: i64 = 0;
    var ptr: i64 = 0;
    var input_pos: i64 = 0;
    var steps: i64 = 0;

    while (ip < program.len) {
        let op = program.charAt(ip);
        if (op == 62) {
            ptr = ptr + 1;
            while (ptr >= tape.len) {
                tape.push(0);
            }
        } elif (op == 60) {
            if (ptr == 0) { return BrainfuckResult.new(false, String.from("ptr-underflow"), steps); }
            ptr = ptr - 1;
        } elif (op == 43) {
            tape.set(ptr, (tape.get(ptr) + 1) % 256);
        } elif (op == 45) {
            tape.set(ptr, (tape.get(ptr) + 255) % 256);
        } elif (op == 46) {
            out.appendChar(tape.get(ptr) as i32);
        } elif (op == 44) {
            if (input_pos < input.len) {
                tape.set(ptr, input.charAt(input_pos) as i64);
                input_pos = input_pos + 1;
            } else {
                tape.set(ptr, 0);
            }
        } elif (op == 91) {
            if (tape.get(ptr) == 0) {
                ip = jumps.get(ip);
            }
        } elif (op == 93) {
            if (tape.get(ptr) != 0) {
                ip = jumps.get(ip);
            }
        }
        ip = ip + 1;
        steps = steps + 1;
        if (steps > 100000) { return BrainfuckResult.new(false, String.from("step-limit"), steps); }
    }

    let result = out.build();
    out.destroy();
    return BrainfuckResult.new(true, result, steps);
}

fn run_from_files(program_path: string, input_path: string) -> BrainfuckResult {
    let program = readFile(program_path);
    let input = readFile(input_path);
    if (program.len == 0 || !fileExists(program_path)) {
        return BrainfuckResult.new(false, String.from("missing-program"), 0);
    }
    return interpret_brainfuck(program, input);
}

fn main() -> i32 {
    let loop_path = "vyx_bf_loop_io.tmp.bf";
    let loop_in_path = "vyx_bf_loop_io.tmp.in";
    let echo_path = "vyx_bf_echo_io.tmp.bf";
    let echo_in_path = "vyx_bf_echo_io.tmp.in";

    let loop_program = "++++++++[>++++++++<-]>+.+.+.";
    let echo_program = ",[.,]";
    if (writeFile(loop_path, loop_program) != 0) { println("bf write loop failed"); return 1; }
    if (writeFile(loop_in_path, "") != 0) { println("bf write loop input failed"); return 2; }
    if (writeFile(echo_path, echo_program) != 0) { println("bf write echo failed"); return 3; }
    if (writeFile(echo_in_path, "Vyx-IO") != 0) { println("bf write echo input failed"); return 4; }

    let loop_result = run_from_files(loop_path, loop_in_path);
    let echo_result = run_from_files(echo_path, echo_in_path);

    println("bf loop ok=${loop_result.ok} output=${loop_result.output} steps=${loop_result.steps}");
    println("bf echo ok=${echo_result.ok} output=${echo_result.output} steps=${echo_result.steps}");

    deleteFile(loop_path);
    deleteFile(loop_in_path);
    deleteFile(echo_path);
    deleteFile(echo_in_path);

    if (!loop_result.ok || loop_result.output != "ABC") { return 10; }
    if (!echo_result.ok || echo_result.output != "Vyx-IO") { return 11; }
    println("brainfuck_interpreter_io OK");
    return 0;
}
