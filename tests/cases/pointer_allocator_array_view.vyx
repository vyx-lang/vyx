use std.collections;

fn main() -> i32 {
    var values = Vec::<i32>.new();
    var i: i32 = 0;
    while (i < 100) {
        values.push(i);
        i = i + 1;
    }
    i = 0;
    while (i < 100) {
        if (values.get(i as i64) != i) { return 2; }
        i = i + 1;
    }
    values.set(0, 99);
    if (values.get(0) != 99) { return 3; }
    print("pointer_allocator_array_view OK");
    return 0;
}
