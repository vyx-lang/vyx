module test_inherited_large_tail_string_fields;

use std.string;

interface SceneLike {
    fn id() -> string;
    fn action() -> string;
    fn composed() -> string;
}

class BaseScene : SceneLike {
    public scene_id: string;
    public scene_title: string;
    public enter_count: i32;
    public update_count: i32;
    public leave_count: i32;
    public last_frame_index: u64;

    public fn id() -> string {
        return self.scene_id;
    }

    public fn action() -> string {
        return "";
    }

    public fn composed() -> string {
        return "";
    }
}

class TasksScene : BaseScene {
    public input_resource: string;
    public items_resource: string;
    public checked_resource: string;
    public input_set_action: string;
    public add_action: string;
    public toggle_action_prefix: string;
    public seed_demo_item: bool;

    public static fn create(seed_demo_item: bool) -> TasksScene {
        return TasksScene {
            scene_id: "tasks",
            scene_title: "Zyn Tasks",
            enter_count: 0,
            update_count: 0,
            leave_count: 0,
            last_frame_index: 0 as u64,
            input_resource: "tasks.input",
            items_resource: "tasks.items",
            checked_resource: "tasks.items:checked",
            input_set_action: "tasks.input.set",
            add_action: "tasks.add",
            toggle_action_prefix: "tasks.toggle.",
            seed_demo_item: seed_demo_item
        };
    }

    public fn action() -> string {
        return self.add_action;
    }

    public fn entry(input_resource: string, input_set_action: string, add_action: string) -> string {
        return input_resource + "|" + input_set_action + "|" + add_action;
    }

    public fn composed() -> string {
        return self.entry(self.input_resource, self.input_set_action, self.add_action);
    }
}

fn action_from_dyn(scene: dyn SceneLike) -> string {
    return scene.action();
}

fn composed_from_dyn(scene: dyn SceneLike) -> string {
    return scene.composed();
}

fn main() -> i32 {
    let scene = TasksScene.create(true);
    if (scene.scene_id != "tasks") { return 1; }
    if (scene.input_resource != "tasks.input") { return 2; }
    if (scene.input_set_action != "tasks.input.set") { return 3; }
    if (scene.add_action != "tasks.add") { return 4; }
    if (scene.toggle_action_prefix != "tasks.toggle.") { return 5; }
    if (!scene.seed_demo_item) { return 6; }
    if (action_from_dyn(scene as dyn SceneLike) != "tasks.add") { return 7; }
    if (composed_from_dyn(scene as dyn SceneLike) != "tasks.input|tasks.input.set|tasks.add") { return 8; }
    return 0;
}
