module lang_validation;

use std.collections;

class View {
    public value: i32;
    private children: Vec<View>;

    public static fn create(value: i32) -> View {
        return View { value: value, children: Vec::<View>.new() };
    }

    public static fn row() -> View {
        return View.create(0);
    }

    @[borrow_args]
    public fn children(items: Vec<View>) -> View {
        var i: i32 = 0;
        while (i < (items.len as i32)) {
            self.children.push(items.get(i as i64).clone());
            i = i + 1;
        }
        return self;
    }

    public fn childCount() -> i32 {
        return self.children.len as i32;
    }

    public fn childAt(index: i32) -> View {
        return self.children.get(index as i64).clone();
    }

    public fn clone() -> View {
        var out = View.create(self.value);
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            out.children.push(self.children.get(i as i64).clone());
            i = i + 1;
        }
        return out;
    }

    public fn destroy() {
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            var child = self.children.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.children.destroy();
    }
}

fn main() -> i32 {
    let a = View.create(1);
    let b = View.create(2);
    let c = View.create(3);
    let d = View.create(4);
    var items = Vec::<View>.new();
    items.push(a);
    items.push(b);
    items.push(c);
    items.push(d);
    var row = View.row().children(items);
    if (row.childCount() != 4) { row.destroy(); items.destroy(); return 1; }
    if (row.childAt(2).value != 3) { row.destroy(); items.destroy(); return 2; }
    row.destroy();
    items.destroy();
    return 0;
}
