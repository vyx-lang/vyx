use std.ref;
use std.collections;
use std.string;

class Cell {
    public value: i32

    public static fn new(v: i32) -> Cell {
        return Cell { value: v };
    }

    public fn get_value() -> i32 {
        return self.value;
    }

    public fn same_value(other: Cell) -> bool {
        return self.value == other.value;
    }
}

class Holder {
    public cell: Ref<Cell>

    public static fn new(v: i32) -> Holder {
        return Holder { cell: Ref::<Cell>.new(Cell.new(v)) };
    }

    public fn read() -> i32 {
        return self.cell.deref().get_value();
    }

    public fn same() -> bool {
        return self.cell.deref().same_value(self.cell.deref());
    }
}

class Item {
    public name: string

    public static fn new(n: string) -> Item {
        return Item { name: n };
    }

    public fn get_name() -> string {
        return self.name;
    }
}

fn join_items(items: Vec<Ref<Item>>) -> string {
    var result = "";
    for (i in 0..items.len) {
        let item = items.get(i);
        result = result + item.deref().get_name();
    }
    return result;
}

fn main() -> i32 {
    let h = Holder.new(42);
    if (h.read() != 42) { return 1 as i32; }
    if (h.same() == false) { return 1 as i32; }
    if (sizeof::<Ref<Item>>() != 16) { return 1 as i32; }

    var items = Vec::<Ref<Item>>.new();
    items.push(Ref::<Item>.new(Item.new("hello")));
    items.push(Ref::<Item>.new(Item.new(" world")));
    if (join_items(items) != "hello world") { return 1 as i32; }

    return 0 as i32;
}
