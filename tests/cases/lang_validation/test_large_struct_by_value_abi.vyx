module test_large_struct_by_value_abi;

class LargeConfig {
    public a0: i64;
    public a1: i64;
    public a2: i64;
    public a3: i64;
    public a4: i64;
    public a5: i64;
    public a6: i64;
    public a7: i64;
    public a8: i64;
    public a9: i64;
    public label: string;

    public static fn create(seed: i64, label: string) -> LargeConfig {
        return LargeConfig {
            a0: seed,
            a1: seed + 1,
            a2: seed + 2,
            a3: seed + 3,
            a4: seed + 4,
            a5: seed + 5,
            a6: seed + 6,
            a7: seed + 7,
            a8: seed + 8,
            a9: seed + 9,
            label: label
        };
    }

    public fn total() -> i64 {
        return self.a0 + self.a1 + self.a2 + self.a3 + self.a4
            + self.a5 + self.a6 + self.a7 + self.a8 + self.a9;
    }
}

class LargeConsumer {
    public static fn staticTotal(cfg: LargeConfig) -> i64 {
        return cfg.total();
    }

    public fn instanceTotal(cfg: LargeConfig) -> i64 {
        return cfg.total();
    }

    public static fn staticLabel(cfg: LargeConfig) -> string {
        return cfg.label;
    }
}

fn take_large(cfg: LargeConfig) -> i64 {
    return cfg.total();
}

fn main() -> i32 {
    let cfg = LargeConfig.create(10, "large");
    if (take_large(cfg) != 145) { return 1; }
    if (LargeConsumer.staticTotal(cfg) != 145) { return 2; }

    let consumer = LargeConsumer {};
    if (consumer.instanceTotal(cfg) != 145) { return 3; }
    if (LargeConsumer.staticLabel(cfg) != "large") { return 4; }

    return 0;
}
