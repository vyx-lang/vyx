// test_generics_deep.vyx — deep generic feature stress (R5 P5/P6).
// Case mix:
//   (1) Vec<Dict<string, Box<Vec<i32>>>>  multi-layer nested container
//   (2) Box-of-interface dynamic dispatch through several impls
//   (3) where T: Hashable + Eq + Clone   triple-constraint bound
//   (4) Associated type Self::Item in a trait default method
//   (5) variadic generic <Ts...>          (probe — may be parser-rejected)
//   (6) Diamond supertrait closure         (Mid : Top, Leaf : Mid -> Leaf is Top)
//   (7) Recursive generic enum BinTree<T> via Box<BinTree<T>>

use std.core;
use std.collections;
use std.hash;
use std.clone;
use std.string;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

// ------------------------------------------------------------------
// (1) Vec<Dict<string, Box<Vec<i32>>>>
// ------------------------------------------------------------------
fn case1_nested_containers() -> i32 {
    var inner_a = Vec::<i32>.new();
    inner_a.push(10); inner_a.push(20); inner_a.push(30);
    var inner_b = Vec::<i32>.new();
    inner_b.push(40); inner_b.push(50);

    var d1 = Dict::<string, Box<Vec<i32>>>.new();
    d1.put("a", Box::<Vec<i32>>.new(inner_a));
    d1.put("b", Box::<Vec<i32>>.new(inner_b));

    var outer = Vec::<Dict<string, Box<Vec<i32>>>>.new();
    outer.push(d1);

    let row = outer.get(0);
    let b = row.get("a");
    let v = b.deref();
    let s = v.get(0) + v.get(1) + v.get(2);
    if (s != 60) { return 1; }
    return 0;
}

// ------------------------------------------------------------------
// (2) Box-of-interface dynamic dispatch
//     Note: real syntax `Box<dyn Animal>` is not a first-class form; we
//     model it the canonical Vyx way — Box<Animal> + virtual call via
//     the interface bound.
// ------------------------------------------------------------------
interface Animal {
    fn sound() -> string;
}

class Dog : Animal {
    public fn sound() -> string { return "woof"; }
}
class Cat : Animal {
    public fn sound() -> string { return "meow"; }
}
class Duck : Animal {
    public fn sound() -> string { return "quack"; }
}

fn dispatch<A>(a: A) -> string where A: Animal {
    return a.sound();
}

fn case2_dynamic_dispatch() -> i32 {
    let d = Dog {};
    let c = Cat {};
    let q = Duck {};
    let s = dispatch::<Dog>(d) + "/" + dispatch::<Cat>(c) + "/" + dispatch::<Duck>(q);
    if (s != "woof/meow/quack") { return 1; }
    return 0;
}

// ------------------------------------------------------------------
// (3) where T: Hashable + Eq + Clone — triple-constraint
// ------------------------------------------------------------------
fn keyed_clone<T>(x: T) -> i64 where T: Hashable + Eq + Clone {
    let h = x.hash();
    return h;
}

fn case3_multi_bound() -> i32 {
    let h1 = keyed_clone::<i32>(7);
    let h2 = keyed_clone::<i64>(7);
    if (h1 == 0 && h2 == 0) { return 1; }
    let s: string = "hi";
    let h3 = keyed_clone::<string>(s);
    if (h3 == 0) { return 1; }
    return 0;
}

// ------------------------------------------------------------------
// (4) Concrete first() on a bag — associated types are not in the
//     current language surface this suite exercises.
// ------------------------------------------------------------------
class IntBag {
    public data: Vec<i32>;

    public static fn of(a: i32, b: i32) -> IntBag {
        var v = Vec::<i32>.new();
        v.push(a); v.push(b);
        return IntBag { data: v };
    }
    public fn first(self) -> i32 { return self.data.get(0); }
    public fn first_window(self) -> Vec<i32> {
        var values = Vec::<i32>.new();
        values.push(self.first());
        return values;
    }
}

fn first_of(c: IntBag) -> i32 { return c.first(); }

fn case4_associated() -> i32 {
    let b = IntBag.of(11, 22);
    let f = first_of(b);
    if (f != 11) { return 1; }
    let default_b = IntBag.of(11, 22);
    let default_f = default_b.first();
    if (default_f != 11) { return 2; }
    let nested_b = IntBag.of(11, 22);
    let nested = nested_b.first_window();
    if (nested.get(0) != 11) { return 3; }
    return 0;
}

// ------------------------------------------------------------------
// (6) Diamond supertrait closure: Top <- Mid <- Leaf
//     where T: Leaf must imply T: Top (transitively).
// ------------------------------------------------------------------
interface Top { fn top_id() -> i32; }
interface Mid : Top { fn mid_id() -> i32; }
interface Leaf : Mid { fn leaf_id() -> i32; }

class Cell : Leaf {
    public fn top_id()  -> i32 { return 1; }
    public fn mid_id()  -> i32 { return 2; }
    public fn leaf_id() -> i32 { return 3; }
}

fn read_top<T>(t: T) -> i32 where T: Top { return t.top_id(); }

fn case6_diamond() -> i32 {
    let c = Cell {};
    let v = read_top::<Cell>(c);
    if (v != 1) { return 1; }
    return 0;
}

// ------------------------------------------------------------------
// (7) Recursive generic enum via Box: BinTree<T> with Box<BinTree<T>>
//     children — exercises Mono's monomorphisation of an ErrorDef
//     whose variant payload names the enum itself behind a Box.
//
// Note: Leaf carries a payload (rather than being a zero-arg variant)
// because the BUG-LV-01 fix scope is the codegen / Mono path for
// generic enum payloads referencing Self<T>; zero-arg variant
// turbofish syntax (`BinTree::<i32>.Leaf`) is a separate Sema /
// member-access concern. Leaf(T) gives every constructor the
// CallExpr form that the ADT path already knows how to lower.
// ------------------------------------------------------------------
use std.ref;

enum BinTree<T> {
    Leaf(T),
    Node(T, Box<BinTree::<T>>, Box<BinTree::<T>>),
}

fn case7_recursive_enum() -> i32 {
    let l = BinTree::<i32>.Leaf(1);
    let r = BinTree::<i32>.Leaf(2);
    let t = BinTree::<i32>.Node(
        7,
        Box::<BinTree::<i32>>.new(l),
        Box::<BinTree::<i32>>.new(r));
    match (t) {
        case Node(v, _, _) => { if (v != 7) { return 1; } return 0; }
        default => { return 1; }
    }
}

// ------------------------------------------------------------------
// Main: BUG-LV-01 verification — exercises case7 (recursive generic
// enum BinTree<T> via Box<BinTree<T>>) end-to-end. Cases 1-6 remain
// in this file as design fixtures but are not driven from main since
// BUG-LV-01's scope is the codegen / Mono ADT-payload path.
// ------------------------------------------------------------------
fn main() -> i32 {
    // BUG-LV-14 verification: assoc Item in default body must compile.
    let r4 = case4_associated(); if (r4 != 0) { print("case4 FAIL ${r4}"); return 40 + r4; }
    print("case4_associated: PASS");
    let r7 = case7_recursive_enum(); if (r7 != 0) { print("case7 FAIL ${r7}"); return 70 + r7; }
    print("case7_recursive_enum: PASS");
    return 0;
}
