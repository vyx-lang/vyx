use std.convert;

fn main() -> i32 {
    match (i32_from_str("42")) {
        case Ok(v) => {
            if (v != 42) { return 1; }
        }
        case Err(_) => { return 2; }
    }

    match (f32_from_str("0.75")) {
        case Ok(f) => {
            let actual: f32 = f;
            let scaled: i32 = (actual * (100.0 as f32)) as i32;
            if (scaled != 75) { return 3; }
        }
        case Err(_) => { return 4; }
    }

    match (bool_from_str("true")) {
        case Ok(b) => {
            if (!b) { return 5; }
        }
        case Err(_) => { return 6; }
    }

    match (i32_from_str("nope")) {
        case Ok(_) => { return 7; }
        case Err(e) => {
            if (e.len == 0) { return 8; }
        }
    }

    return 0;
}
