module lang_validation;

use std.collections;

class ResourceView {
    public label: string;
    public values: Vec<i32>;

    public static fn create(label: string, value: i32) -> ResourceView {
        var values = Vec::<i32>.new();
        values.push(value);
        return ResourceView { label: label, values: values };
    }

    public fn clone() -> ResourceView {
        var values = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < (self.values.len as i32)) {
            values.push(self.values.get(i as i64));
            i = i + 1;
        }
        return ResourceView { label: self.label, values: values };
    }

    public fn value() -> i32 {
        return self.values.get(0);
    }

    public fn destroy() {
        self.values.destroy();
    }
}

class ResourceRow {
    private children: Vec<ResourceView>;

    public static fn create() -> ResourceRow {
        return ResourceRow { children: Vec::<ResourceView>.new() };
    }

    public fn child(value: ResourceView) -> ResourceRow {
        self.children.push(value.clone());
        return self;
    }

    public fn children2(items: [ResourceView; 2]) -> ResourceRow {
        self.children.push(items[0].clone());
        self.children.push(items[1].clone());
        return self;
    }

    public fn count() -> i32 {
        return self.children.len as i32;
    }

    public fn at(index: i32) -> ResourceView {
        return self.children.get(index as i64).clone();
    }

    public fn destroy() {
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            var child = self.children.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.children.destroy();
    }
}

class TreeView {
    public label: string;
    public children: Vec<TreeView>;

    public static fn leaf(label: string) -> TreeView {
        return TreeView { label: label, children: Vec::<TreeView>.new() };
    }

    public static fn row() -> TreeView {
        return TreeView { label: "row", children: Vec::<TreeView>.new() };
    }

    public fn child(value: TreeView) -> TreeView {
        self.children.push(value.clone());
        return self;
    }

    public fn children4(items: [TreeView; 4]) -> TreeView {
        self.children.push(items[0].clone());
        self.children.push(items[1].clone());
        self.children.push(items[2].clone());
        self.children.push(items[3].clone());
        return self;
    }

    public fn clone() -> TreeView {
        var out = TreeView { label: self.label, children: Vec::<TreeView>.new() };
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            out.children.push(self.children.get(i as i64).clone());
            i = i + 1;
        }
        return out;
    }

    public fn count() -> i32 {
        return self.children.len as i32;
    }

    public fn childAt(index: i32) -> TreeView {
        return self.children.get(index as i64).clone();
    }

    public fn destroy() {
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            var child = self.children.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.children.destroy();
    }
}

fn main() -> i32 {
    let a = ResourceView.create("a", 10);
    let b = ResourceView.create("b", 20);
    var row = ResourceRow.create().children2([a, b]);
    if (row.count() != 2) { row.destroy(); return 1; }
    let first = row.at(0);
    let second = row.at(1);
    if (first.value() != 10) { row.destroy(); first.destroy(); second.destroy(); return 2; }
    if (second.value() != 20) { row.destroy(); first.destroy(); second.destroy(); return 3; }
    first.destroy();
    second.destroy();
    row.destroy();
    a.destroy();
    b.destroy();

    let t0 = TreeView.leaf("zero");
    let t1 = TreeView.leaf("one");
    let t2 = TreeView.leaf("two");
    let t3 = TreeView.leaf("three");
    var branch = TreeView.row().children4([t0, t1, t2, t3]);
    if (branch.count() != 4) { branch.destroy(); t0.destroy(); t1.destroy(); t2.destroy(); t3.destroy(); return 4; }
    let c2 = branch.childAt(2);
    if (c2.label != "two") { branch.destroy(); c2.destroy(); t0.destroy(); t1.destroy(); t2.destroy(); t3.destroy(); return 5; }
    var root = TreeView.row().child(branch.clone());
    if (root.count() != 1) { root.destroy(); branch.destroy(); c2.destroy(); t0.destroy(); t1.destroy(); t2.destroy(); t3.destroy(); return 6; }
    root.destroy();
    branch.destroy();
    c2.destroy();
    t0.destroy();
    t1.destroy();
    t2.destroy();
    t3.destroy();
    return 0;
}
