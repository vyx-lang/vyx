use std.collections;

class FloatRect {
    public x: f32;
    public width: f32;

    public static fn xywh(x: f32, width: f32) -> FloatRect {
        return FloatRect { x: x, width: width };
    }
}

class FloatNode {
    public bounds: FloatRect;

    public static fn create() -> FloatNode {
        return FloatNode { bounds: FloatRect.xywh(24.0, 212.0) };
    }
}

class FloatTree {
    public nodes: Vec<FloatNode>;

    public static fn create() -> FloatTree {
        var nodes = Vec::<FloatNode>.new();
        nodes.push(FloatNode.create());
        return FloatTree { nodes: nodes };
    }

    public fn nodeAt(index: i32) -> FloatNode {
        return self.nodes.get(index as i64);
    }

    public fn destroy() {
        self.nodes.destroy();
    }
}

fn main() -> i32 {
    let tree = FloatTree.create();
    let node = tree.nodeAt(0);
    let drag_x = node.bounds.x + (node.bounds.width * 0.25);
    let ratio = (drag_x - node.bounds.x) / node.bounds.width;

    if (!(ratio > 0.24 && ratio < 0.26)) {
        tree.destroy();
        return 1;
    }

    tree.destroy();
    return 0;
}
