use std.core;

var g_hits: i32 = 0;

fn hit_true() -> bool {
    g_hits = g_hits + 1;
    return true;
}

fn hit_false() -> bool {
    g_hits = g_hits + 10;
    return false;
}

fn compare_guard(receiver_is_null: bool, method_name: string) -> i32 {
    if (receiver_is_null || method_name != "compare") { return 1; }
    return 0;
}

fn check(cond: bool, code: i32) -> i32 {
    if (cond) { return 0; }
    return code;
}

fn main() -> i32 {
    var rc = check(true || hit_false(), 1);
    if (rc != 0) { return rc; }
    rc = check(g_hits == 0, 2);
    if (rc != 0) { return rc; }

    rc = check(!(false && hit_true()), 3);
    if (rc != 0) { return rc; }
    rc = check(g_hits == 0, 4);
    if (rc != 0) { return rc; }

    rc = check(compare_guard(false, "remove") == 1, 5);
    if (rc != 0) { return rc; }
    rc = check(compare_guard(false, "compare") == 0, 6);
    if (rc != 0) { return rc; }
    rc = check(compare_guard(true, "compare") == 1, 7);
    if (rc != 0) { return rc; }

    rc = check((0 == 0 || hit_true()), 8);
    if (rc != 0) { return rc; }
    rc = check(g_hits == 0, 9);
    if (rc != 0) { return rc; }

    print("PASS: logic_chain_short_circuit");
    return 0;
}
