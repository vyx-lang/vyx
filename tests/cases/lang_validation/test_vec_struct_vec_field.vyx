use std.collections;

class PointBag {
    public points: Vec<i32>;

    public static fn create() -> PointBag {
        return PointBag { points: Vec::<i32>.new() };
    }

    public fn add(v: i32) -> PointBag {
        self.points.push(v);
        return self;
    }
}

fn main() -> i32 {
    var bag = PointBag.create().add(10).add(20).add(30);
    if (bag.points.len != 3) { return 1; }
    if (bag.points.get(0) != 10) { return 2; }
    if (bag.points.get(2) != 30) { return 3; }

    var bags = Vec::<PointBag>.new();
    bags.push(bag);
    if (bags.len != 1) { return 4; }

    let stored = bags.get(0);
    if (stored.points.len != 3) { return 5; }
    if (stored.points.get(1) != 20) { return 6; }
    return 0;
}
