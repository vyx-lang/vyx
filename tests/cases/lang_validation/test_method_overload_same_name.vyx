module lang_validation;

class Item {
    public value: i32;

    public static fn create(value: i32) -> Item {
        return Item { value: value };
    }

    public fn clone() -> Item {
        return Item { value: self.value };
    }
}

class Row {
    public total: i32;

    public static fn create() -> Row {
        return Row { total: 0 };
    }

    public fn child(value: Item) -> Row {
        self.total = value.value;
        return self;
    }

    public fn child(values: [Item; 2]) -> Row {
        self.total = values[0].value + values[1].value;
        return self;
    }
}

fn main() -> i32 {
    let a = Item.create(7);
    let b = Item.create(11);
    let c = Item.create(13);
    var single = Row.create().child(a);
    var pair = Row.create().child([b, c]);
    if (single.total != 7) { return 1; }
    if (pair.total != 24) { return 2; }
    return 0;
}
