class ChainNode {
    public name: string;
    public width_value: i32;
    public height_value: i32;

    public static fn create() -> ChainNode {
        return ChainNode {
            name: "",
            width_value: 0,
            height_value: 0
        };
    }

    public fn id(name: string) -> ChainNode {
        self.name = name;
        return self;
    }

    public fn size(width: i32, height: i32) -> ChainNode {
        self.width_value = width;
        self.height_value = height;
        return self;
    }

    public fn child(node: ChainNode) -> ChainNode {
        self.width_value = self.width_value + node.width_value;
        self.height_value = self.height_value + node.height_value;
        return self;
    }
}

fn main() -> i32 {
    let node = ChainNode.create()
        .id("root")
        .size(1, 2)
        .child(ChainNode.create()
            .id("title")
            .size(3, 4))
        .child(ChainNode.create()
            .id("body")
            .size(5, 6))
        .child(ChainNode.create()
            .id("actions")
            .size(7, 8))
        .child(ChainNode.create()
            .id("note")
            .size(9, 10));

    if (node.name != "root") { return 1; }
    if (node.width_value != 25) { return 2; }
    if (node.height_value != 30) { return 3; }
    return 0;
}
