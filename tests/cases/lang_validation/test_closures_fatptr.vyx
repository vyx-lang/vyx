// test_closures_fatptr.vyx — closure fat-ptr / capture / trampoline stress.
// Case mix:
//   (1) byRef vs move capture — byRef mutates the outer var,
//       move materialises a private copy inside the closure env.
//   (2) make_adder(x) -> fn(i64)->i64           closure-returning-closure (curry).
//   (3) Vec<fn(i64)->i64> push & invoke         heterogeneous closures in a Vec.
//   (4) bare fn assigned into a `fn(i64)->i64`  arg → fat-ptr trampoline.
//   (5) Vec.iter().map(closure) over Iterator<T>::map<U>(f: fn(T)->U).
//   (6) closure with no explicit return-type    Sema infers via inferredType.
//
// Run via:
//   build\vyxc.exe --run tests\cases\lang_validation\test_closures_fatptr.vyx
//
// All cases must return 0 from main; failures encode case index in the exit code.

use std.core;
use std.collections;

// ------------------------------------------------------------------
// (1) byRef-style auto-capture vs explicit by-value (move) capture.
//
// (1a) Lambda `|...|` form scrapes outer scope at construction time
//      and stores each captured slot inside the heap env; subsequent
//      writes inside the closure body mutate the env so successive
//      invocations observe accumulated state (FnMut). This is the
//      idiomatic "byRef" path in current Vyx, since the closure and
//      the env share the same storage for the captured slot.
//
// (1b) Explicit `[name]` (no leading `&`) makes a private copy of the
//      outer value into the closure env — the move-semantic path.
//      Mutating the outer afterwards does NOT affect the closure's
//      captured copy (and the outer can be dropped independently).
// ------------------------------------------------------------------
fn case1_capture_modes() -> i32 {
    // BUG-LV-08 guard: `[&name]` MUST capture by reference and the
    // closure body's writes to `counter` MUST propagate back to the
    // outer alloca after each invocation. After bump(7); bump(13) the
    // outer `counter` is observed as 20 (= 0 + 7 + 13).
    var counter: i64 = 0;
    let bump = [&counter](v: i64) => {
        counter = counter + v;
        return counter;
    };
    let after_first  = bump(7);
    let after_second = bump(13);
    if (after_first  != 7)  { return 1; }
    if (after_second != 20) { return 2; }
    if (counter      != 20) { return 4; }

    // BUG-LV-09 guard: `[name = expr]` form computes `expr` in outer scope
    // and binds the result as a fresh capture `name` on the closure env.
    // After construction, mutating the outer `tag` MUST NOT affect the
    // closure's snapshot because the move-capture took its own copy.
    var tag: i64 = 100;
    let report = [snapshot = tag](extra: i64) => snapshot + extra;
    tag = -999;
    let r = report(5);
    if (r != 105) { return 3; }
    return 0;
}

// ------------------------------------------------------------------
// (2) Closure returning a closure (curry).
//     The returned `fn(i64)->i64` is a fat-ptr (env+code) packaged by
//     CodeGenClosure.cpp. The captured `x` lives on the heap env.
// ------------------------------------------------------------------
fn make_adder(x: i64) -> fn(i64) -> i64 {
    return |a: i64| -> i64 { return a + x; };
}

fn case2_curry() -> i32 {
    let add10 = make_adder(10);
    let add100 = make_adder(100);
    let s = add10(5) + add100(5);
    if (s != 120) { return 1; }
    if (add10(0) != 10) { return 2; }
    return 0;
}

// ------------------------------------------------------------------
// (3) Vec<fn(i64)->i64>: bare functions stored alongside closures.
//     Vec uses raw fn-ptr storage; closures (fat-ptr) are not
//     interchangeable with bare fn slots in Vec, so the case stores
//     bare functions and calls them through the slot to verify
//     element-typed dispatch in a generic Vec<fn(...)>.
// ------------------------------------------------------------------
fn step_inc(x: i64) -> i64 { return x + 1; }
fn step_dbl(x: i64) -> i64 { return x * 2; }
fn step_sub(x: i64) -> i64 { return x - 3; }

fn case3_vec_of_fn() -> i32 {
    var fns = Vec::<fn(i64) -> i64>.new();
    fns.push(step_inc);
    fns.push(step_dbl);
    fns.push(step_sub);

    let f0 = fns.get(0);
    let f1 = fns.get(1);
    let f2 = fns.get(2);
    let total = f0(10) + f1(10) + f2(10);
    if (total != (11 + 20 + 7)) { return 1; }
    return 0;
}

// ------------------------------------------------------------------
// (4) Bare fn passed where a `fn(i64)->i64` is expected.
//     CodeGen wraps the plain function pointer in a fat-ptr with a
//     null env and a tiny trampoline so call sites use one ABI only.
// ------------------------------------------------------------------
fn double(x: i64) -> i64 { return x * 2; }
fn negate(x: i64) -> i64 { return 0 - x; }

fn apply_fn(f: fn(i64) -> i64, v: i64) -> i64 { return f(v); }

fn case4_bare_fn_to_fatptr() -> i32 {
    let a = apply_fn(double, 21);
    let b = apply_fn(negate, 42);
    if (a != 42) { return 1; }
    if (b != -42) { return 2; }
    return 0;
}

// ------------------------------------------------------------------
// (5) Closure threaded through `Vec<T>.iter().map<U>(f).collect()`.
//     The closure captures the outer `scale` so the fat-ptr env is
//     non-empty, and the `Iterator<T>.map<U>(f: fn(T)->U)` slot is the
//     final target — exercising the full
//        closure-build → fat-ptr-store → method-arg-pass → inner
//        `_map_fn(i, raw)` dispatch
//     pipeline. A previous regression segfaulted here when the inner
//     dispatcher dropped the closure env between the method's `self`
//     and `f` argument slots; this case is the canonical guard.
// ------------------------------------------------------------------
fn case5_iter_map_closure_collect() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3); v.push(4);

    let scale: i32 = 10;
    let mapped = v.iter().map::<i32>(|x: i32| -> i32 { return x * scale; });
    let out = mapped.collect();

    if (out.size() != 4) { return 1; }
    var total: i32 = 0;
    var i: i64 = 0;
    while (i < out.size()) { total = total + out.get(i); i = i + 1; }
    if (total != 100) { return 2; }
    return 0;
}

// ------------------------------------------------------------------
// (6) Closure body with NO explicit return-type annotation, used in
//     two-step form: bind the lambda to a `let` first, then pass that
//     name across an `fn(i32)->i32` parameter slot. Sema must
//     back-propagate the parameter's expected return type onto the
//     closure's `inferredType` AND emitClosure must consult that
//     `inferredType` when picking `retTy` (the binary-op product would
//     otherwise default to i32 and the captured-bind path could lose
//     the result type entirely on the second use).
// ------------------------------------------------------------------
fn apply_i32(f: fn(i32) -> i32, v: i32) -> i32 { return f(v); }

fn case6_inferred_return_two_step() -> i32 {
    let plus7 = |x: i32| { return x + 7; };
    if (apply_i32(plus7, 35) != 42) { return 1; }

    let sq = |x: i32| { return x * x; };
    if (apply_i32(sq, 9) != 81) { return 2; }

    if (apply_i32(plus7, -7) != 0) { return 3; }
    return 0;
}

// ------------------------------------------------------------------
// Main: run every case; return first non-zero failure code.
// ------------------------------------------------------------------
fn main() -> i32 {
    let r1 = case1_capture_modes();           if (r1 != 0) { print("case1 FAIL ${r1}"); return 10 + r1; }
    let r2 = case2_curry();                   if (r2 != 0) { print("case2 FAIL ${r2}"); return 20 + r2; }
    let r3 = case3_vec_of_fn();               if (r3 != 0) { print("case3 FAIL ${r3}"); return 30 + r3; }
    let r4 = case4_bare_fn_to_fatptr();       if (r4 != 0) { print("case4 FAIL ${r4}"); return 40 + r4; }
    let r5 = case5_iter_map_closure_collect(); if (r5 != 0) { print("case5 FAIL ${r5}"); return 50 + r5; }
    let r6 = case6_inferred_return_two_step(); if (r6 != 0) { print("case6 FAIL ${r6}"); return 60 + r6; }
    print("test_closures_fatptr all OK");
    return 0;
}
