module test_assoc_type_struct_init;

// Regression (2026-09-14): associated types / associated consts written
// inside a class body are TYPE-LEVEL members — they occupy no layout slot —
// so a struct literal must never be asked to supply them.
//
// The parser builds them as `de_FIELD` nodes tagged `|kind:assoc_type` /
// `|kind:assoc_const` (see `Parser.parse_type_member` / `parse_const_member`,
// which is what `GlobalAllocator` in `std/allocator.vyx` relies on). Sema's
// "missing field" walk used to see a field named `Error` with no initializer
// and demand `GlobalAllocator { Error: ... }` — a diagnostic with no legal
// fix, because there is nowhere to store the value. Both the completeness
// check and the "known member" check now use `derive_is_instance_field`,
// which is also what decides layout membership.

trait Allocator {
    type Error;
    fn alloc(size: i64) -> i32;
}

class GlobalAllocator : Allocator {
    type Error = i32;

    public static fn create() -> GlobalAllocator {
        return GlobalAllocator {};
    }

    public fn alloc(size: i64) -> i32 {
        return 7;
    }
}

class Bounded {
    type Item = i32;
    const LIMIT: i64 = 8;
    // Same class of member, no initializer — must be skipped for the same
    // reason (it is a type-level declaration, not storage).
    const CAP: i64;

    public n: i64;

    public static fn make(n: i64) -> Bounded {
        return Bounded { n: n };
    }

    public fn over(limit: i64) -> bool {
        return self.n > limit;
    }
}

fn main() -> i32 {
    let g = GlobalAllocator.create();
    if (g.alloc(8) != 7) { return 1; }

    var b = Bounded.make(4);
    if (b.n != 4) { return 2; }
    if (b.over(8)) { return 3; }
    return 0;
}
