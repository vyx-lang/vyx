// Regression: Vec<dyn Interface> must use one canonical interface ABI type
// even when the source expression carries a module-qualified dyn name.
//
// This mirrors Zyn's app-layer shape: prebuilt UI resources are stored in a
// heterogeneous view list, then reused by a declarative container API.

module lang_validation;

use std.collections;

trait View {
    fn render(self) -> string;
}

class Button {
    public label: string;
    public action_name: string;

    public static fn create(label: string) -> Button {
        return Button { label: label, action_name: "" };
    }

    public fn action(name: string) -> Button {
        self.action_name = name;
        return self;
    }

    public fn render(self) -> string {
        return "button:" + self.label + ":" + self.action_name;
    }
}

class Text {
    public value: string;

    public static fn create(value: string) -> Text {
        return Text { value: value };
    }

    public fn render(self) -> string {
        return "text:" + self.value;
    }
}

class Row {
    private items: Vec<dyn View>;

    public static fn create() -> Row {
        return Row { items: Vec::<dyn View>.new() };
    }

    public fn child(v: dyn View) -> Row {
        self.items.push(v);
        return self;
    }

    public fn children2(items: [Button; 2]) -> Row {
        self.items.push(items[0]);
        self.items.push(items[1]);
        return self;
    }

    public fn render(self) -> string {
        var out = "row";
        var i: i64 = 0;
        while (i < self.items.size()) {
            out = out + "|" + self.items.get(i).render();
            i = i + 1;
        }
        return out;
    }
}

fn main() -> i32 {
    let btn1 = Button.create("-").action("counter.decrement");
    let btn2 = Button.create("+").action("counter.increment");
    let row1 = Row.create().children2([btn1, btn2]);
    let text = Text.create("Count");
    let row2 = Row.create().child(text).child(Button.create("Reset").action("counter.reset"));
    let s1 = row1.render();
    let s2 = row2.render();
    print(s1);
    print(s2);
    if (!s1.contains("counter.decrement")) { return 1; }
    if (!s1.contains("counter.increment")) { return 2; }
    if (!s2.contains("text:Count")) { return 3; }
    if (!s2.contains("counter.reset")) { return 4; }
    return 0;
}
