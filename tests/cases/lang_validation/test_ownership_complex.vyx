module tests.cases.lang_validation.test_ownership_complex;

use std.collections;
use std.ref;

// ============================================================
// helpers used by individual cases.
// ============================================================

@[borrow_args]
fn vec_sum(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for (i in 0..v.len) { s = s + v.get(i); }
    return s;
}

@[borrow_args]
fn first_elem(v: Vec<i64>) -> i64 {
    return v.get(0);
}

fn vec_consume(v: Vec<i64>) -> i64 {
    return v.len;
}

@[borrow_args]
fn early_return_helper(probe: Ref<i64>) -> i64 {
    var local = probe.clone();
    if (local.count() >= 2) {
        return local.count();
    }
    return 0;
}

enum Cargo {
    Heap(Vec<i64>),
    Boxed(Box<i64>),
    Empty,
}

fn cargo_size(c: Cargo) -> i64 {
    match (c) {
        case Heap(v)  => { return v.len; }
        case Boxed(b) => { return b.deref(); }
        case Empty    => { return 0; }
    }
}

// ============================================================
// case 1 — Vec/Dict multi-level move into nested containers
// ============================================================

fn case_nested_move() -> bool {
    var inner1 = Vec::<i64>.new();
    inner1.push(10); inner1.push(20);
    var inner2 = Vec::<i64>.new();
    inner2.push(30);

    var outer = Vec::<Vec<i64>>.new();
    outer.push(inner1);
    outer.push(inner2);
    if (outer.len != 2) { return false; }

    let v0 = outer.get(0);
    let v1 = outer.get(1);
    if (v0.len != 2) { return false; }
    if (v1.len != 1) { return false; }
    if (v0.get(0) != 10) { return false; }
    if (v0.get(1) != 20) { return false; }
    if (v1.get(0) != 30) { return false; }

    var d = Dict::<string, Vec<i64>>.new();
    var nums = Vec::<i64>.new();
    nums.push(7); nums.push(8); nums.push(9);
    d.put("nums", nums);
    if (d.length() != 1) { return false; }
    if (!d.contains("nums")) { return false; }
    let got = d.get("nums");
    if (got.len != 3) { return false; }
    if (got.get(2) != 9) { return false; }
    return true;
}

// ============================================================
// case 2 — container.get returning a borrowed view across fn
// ============================================================

fn case_get_view_cross_fn() -> bool {
    var v = Vec::<i64>.new();
    v.push(100); v.push(200); v.push(300);

    let first = first_elem(v);
    let mid = v.get(1);
    let s = vec_sum(v);
    return first == 100 && mid == 200 && s == 600;
}

// ============================================================
// case 3 — @[borrow_args] interacting with clone, then move
// ============================================================

fn case_borrow_then_clone_then_move() -> bool {
    var v = Vec::<i64>.new();
    v.push(1); v.push(2); v.push(3);

    let s1 = vec_sum(v);
    let cloned = v.clone();
    let consumed_len = vec_consume(v);

    let s2 = vec_sum(cloned);
    return s1 == 6 && consumed_len == 3 && s2 == 6;
}

// ============================================================
// case 4 — Ref<T>/Box<T> auto refcount inc / dec
// ============================================================

fn case_ref_count_auto() -> bool {
    var r = Ref::<i64>.new(11);
    if (r.count() != 1) { return false; }
    {
        var r2 = r.clone();
        if (r.count() != 2) { return false; }
        {
            var r3 = r2.clone();
            if (r.count() != 3) { return false; }
        }
        if (r.count() != 2) { return false; }
    }
    return r.count() == 1;
}

fn case_box_deref() -> bool {
    var b = Box::<i64>.new(1234);
    let v = b.get();
    return v == 1234;
}

// ============================================================
// case 5 — early-return drop completeness
// ============================================================

fn case_early_return_drop() -> bool {
    var r = Ref::<i64>.new(99);
    if (r.count() != 1) { return false; }
    let observed = early_return_helper(r);
    if (observed != 2) { return false; }
    return r.count() == 1;
}

// ============================================================
// case 6 — match arms move the scrutinee, drop on arm exit
// ============================================================

fn case_match_move_resource() -> bool {
    var v = Vec::<i64>.new();
    v.push(10); v.push(20); v.push(30);
    let s1 = cargo_size(Cargo.Heap(v));
    let b  = Box::<i64>.new(42);
    let s2 = cargo_size(Cargo.Boxed(b));
    let s3 = cargo_size(Cargo.Empty);
    return s1 == 3 && s2 == 42 && s3 == 0;
}

// ============================================================
// runner
// ============================================================

fn main() -> i32 {
    var pass: i64 = 0;
    var total: i64 = 0;

    total = total + 1;
    if (case_nested_move()) { print("case_nested_move: PASS"); pass = pass + 1; }
    else { print("case_nested_move: FAIL"); }

    total = total + 1;
    if (case_get_view_cross_fn()) { print("case_get_view_cross_fn: PASS"); pass = pass + 1; }
    else { print("case_get_view_cross_fn: FAIL"); }

    total = total + 1;
    if (case_borrow_then_clone_then_move()) { print("case_borrow_then_clone_then_move: PASS"); pass = pass + 1; }
    else { print("case_borrow_then_clone_then_move: FAIL"); }

    total = total + 1;
    if (case_ref_count_auto()) { print("case_ref_count_auto: PASS"); pass = pass + 1; }
    else { print("case_ref_count_auto: FAIL"); }

    total = total + 1;
    if (case_box_deref()) { print("case_box_deref: PASS"); pass = pass + 1; }
    else { print("case_box_deref: FAIL"); }

    total = total + 1;
    if (case_early_return_drop()) { print("case_early_return_drop: PASS"); pass = pass + 1; }
    else { print("case_early_return_drop: FAIL"); }

    total = total + 1;
    if (case_match_move_resource()) { print("case_match_move_resource: PASS"); pass = pass + 1; }
    else { print("case_match_move_resource: FAIL"); }

    print("TOTAL: ${pass}/${total}");
    if (pass == total) { return 0; }
    return 1;
}
