module test_static_method_alias_collision;

use FileSystem = test_static_method_alias_collision::FileSystem;

public class FileSystem {
    public static fn remove(path: string) -> i32 {
        if (path == "abc") { return 7; }
        return 8;
    }
}

fn remove(path: rawptr) -> i32 {
    return 99;
}

fn main() -> i32 {
    let v = FileSystem.remove("abc");
    if (v != 7) {
        print("FAIL: static alias collision ${v}");
        return 1;
    }
    print("PASS: static alias collision");
    return 0;
}
