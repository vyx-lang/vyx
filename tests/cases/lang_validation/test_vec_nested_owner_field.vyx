use std.collections;

class Point {
    public x: i32;
    public y: i32;

    public static fn xy(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }

    public fn clone() -> Point {
        return Point.xy(self.x, self.y);
    }
}

class Path {
    public points: Vec<Point>;
    public closed: bool;

    public static fn create() -> Path {
        return Path { points: Vec::<Point>.new(), closed: false };
    }

    public fn add(point: Point) -> Path {
        self.points.push(point);
        return self;
    }

    public fn close() -> Path {
        self.closed = true;
        return self;
    }

    public fn clone() -> Path {
        var out = Path.create();
        var i: i64 = 0;
        while (i < self.points.len) {
            out.points.push(self.points.get(i).clone());
            i = i + 1;
        }
        out.closed = self.closed;
        return out;
    }
}

class Command {
    public kind: i32;
    public path: Path;

    public static fn withPath(path: Path) -> Command {
        return Command { kind: 7, path: path.clone() };
    }

    public fn clone() -> Command {
        return Command { kind: self.kind, path: self.path.clone() };
    }
}

fn main() -> i32 {
    var path = Path.create()
        .add(Point.xy(1, 2))
        .add(Point.xy(3, 4))
        .add(Point.xy(5, 6))
        .close();
    if (path.points.len != 3) { return 1; }

    var command = Command.withPath(path);
    if (command.path.points.len != 3) { return 2; }

    var commands = Vec::<Command>.new();
    commands.push(command);
    if (commands.len != 1) { return 3; }

    let stored = commands.get(0);
    if (stored.kind != 7) { return 4; }
    if (stored.path.points.len != 3) { return 5; }
    if (stored.path.points.get(1).x != 3) { return 6; }
    return 0;
}
