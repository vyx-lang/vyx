fn f32_offset(base: f32, pad: f32) -> f32 {
    let x = base + pad - 24.0;
    return x;
}

fn f32_nested(base: f32, height: f32) -> f32 {
    let y = base + ((height - 2.0) * 0.5);
    return y;
}

class FloatPoint {
    public x: f32;
    public y: f32;

    public static fn xy(x: f32, y: f32) -> FloatPoint {
        return FloatPoint { x: x, y: y };
    }
}

class FloatRect {
    public x: f32;
    public width: f32;

    public static fn create(x: f32, width: f32) -> FloatRect {
        return FloatRect { x: x, width: width };
    }
}

fn field_float_to_f32_param(rect: FloatRect) -> f32 {
    let drag_x = rect.x + (rect.width * 0.25);
    let point = FloatPoint.xy(drag_x, 0.0);
    return point.x;
}

fn main() -> i32 {
    let a = f32_offset(30.0, 2.0);
    if (a != 8.0) { return 1; }

    let b = f32_nested(10.0, 20.0);
    if (b != 19.0) { return 2; }

    let c = (1.0 + 2.0) * 3.0;
    if (c != 9.0) { return 3; }

    let rect = FloatRect.create(24.0, 160.0);
    let d = field_float_to_f32_param(rect);
    if (d != 64.0) { return 4; }

    var ratio: f32 = 0.0;
    ratio = (64.0 - 24.0) / 160.0;
    if (ratio != 0.25) { return 5; }

    return 0;
}
