// Self-host adversarial gate.
//
// Focuses on compiler-shaped corner cases that are easy to miss when the
// implementation is only tested with scalar Results:
//   - string Err payload propagation through `?` from wide Ok payloads
//   - Result<Option<Vec<string>>, string> matching and moving
//   - const move-only Vec values passed by value
//   - Vec<fn(...)> built inside a function, returned through Result, then called

module lang_validation;

use std.core;
use std.collections;

fn check(name: string, cond: bool) -> i32 {
    if (cond) {
        print("PASS: ${name}");
        return 0;
    }
    print("FAIL: ${name}");
    return 1;
}

fn consume_vec(v: Vec<string>) -> i64 {
    return v.len;
}

fn make_words(ok: bool) -> Result<Vec<string>, string> {
    if (!ok) { return Err("lex-empty"); }
    var out = Vec::<string>.new();
    out.push("fn");
    out.push("main");
    out.push("return");
    return Ok(out);
}

fn count_words(ok: bool) -> Result<i32, string> {
    let words = make_words(ok)?;
    if (words.get(0) != "fn") { return Err("bad-first-token"); }
    return words.len as i32;
}

fn maybe_words(mode: i32) -> Result<Option<Vec<string>>, string> {
    if (mode < 0) { return Err("negative-mode"); }
    if (mode == 0) { return Ok(None); }
    let words = make_words(true)?;
    return Ok(Some(words));
}

fn option_payload_score(mode: i32) -> Result<i32, string> {
    let opt = maybe_words(mode)?;
    match (opt) {
        case Some(words) => {
            let n = consume_vec(words);
            return n as i32;
        }
        default => {
            return 0;
        }
    }
}

fn pass_plus_one(x: i64) -> i64 { return x + 1; }
fn pass_times_two(x: i64) -> i64 { return x * 2; }

fn make_passes(bias: i64) -> Result<Vec<fn(i64) -> i64>, string> {
    if (bias < 0) { return Err("negative-bias"); }
    let add_bias = [bias](x: i64) => x + bias;
    var passes = Vec::<fn(i64) -> i64>.new();
    passes.push(add_bias);
    passes.push(pass_plus_one);
    passes.push(pass_times_two);
    return Ok(passes);
}

fn run_passes(seed: i64, bias: i64) -> Result<i64, string> {
    let passes = make_passes(bias)?;
    let a = passes.get(0)(seed);
    let b = passes.get(1)(a);
    let c = passes.get(2)(b);
    return c;
}

fn direct_const_move() -> i32 {
    let names = make_words(true).unwrap();
    let n = consume_vec(names);
    if (n == 3) { return 0; }
    return 1;
}

fn main() -> i32 {
    var failed: i32 = 0;

    let ok_count = count_words(true);
    match (ok_count) {
        case Ok(n) => { failed += check("wide_result_ok_payload", n == 3); }
        default => { failed += check("wide_result_ok_payload", false); }
    }

    let bad_count = count_words(false);
    match (bad_count) {
        case Err(e) => { failed += check("wide_result_string_err", e == "lex-empty"); }
        default => { failed += check("wide_result_string_err", false); }
    }

    let some_score = option_payload_score(1);
    match (some_score) {
        case Ok(n) => { failed += check("result_option_vec_some", n == 3); }
        default => { failed += check("result_option_vec_some", false); }
    }

    let none_score = option_payload_score(0);
    match (none_score) {
        case Ok(n) => { failed += check("result_option_vec_none", n == 0); }
        default => { failed += check("result_option_vec_none", false); }
    }

    let opt_err = option_payload_score(-1);
    match (opt_err) {
        case Err(e) => { failed += check("result_option_vec_err", e == "negative-mode"); }
        default => { failed += check("result_option_vec_err", false); }
    }

    let cb = run_passes(10, 7);
    match (cb) {
        case Ok(v) => { failed += check("returned_vec_closure_fatptr", v == 36); }
        default => { failed += check("returned_vec_closure_fatptr", false); }
    }

    let cb_err = run_passes(10, -1);
    match (cb_err) {
        case Err(e) => { failed += check("returned_vec_closure_err", e == "negative-bias"); }
        default => { failed += check("returned_vec_closure_err", false); }
    }

    failed += check("direct_const_move_only_vec", direct_const_move() == 0);

    if (failed != 0) { return failed; }
    print("test_selfhost_adversarial_gate all OK");
    return 0;
}
