module test_fluent_builder;

use std.collections;

class FluentBuilder {
    public left: Vec<i32>;
    public right: Vec<i64>;
    public count: i32;
    public enabled: bool;

    public static fn create() -> FluentBuilder {
        return FluentBuilder {
            left: Vec::<i32>.new(),
            right: Vec::<i64>.new(),
            count: 0,
            enabled: false
        };
    }

    public fn addLeft(v: i32) -> FluentBuilder {
        self.left.push(v);
        return self;
    }

    public fn addRight(v: i64) -> FluentBuilder {
        self.right.push(v);
        return self;
    }

    public fn setCount(v: i32) -> FluentBuilder {
        self.count = v;
        return self;
    }

    public fn enable() -> FluentBuilder {
        self.enabled = true;
        return self;
    }

    public fn destroy() {
        self.left.destroy();
        self.right.destroy();
    }
}

fn main() -> i32 {
    var cfg = FluentBuilder.create()
        .addLeft(1)
        .addRight(10)
        .addLeft(2)
        .addRight(20)
        .setCount(3)
        .enable();

    if (cfg.left.len != 2) { return 1; }
    if (cfg.right.len != 2) { return 2; }
    if (cfg.left.get(0) != 1 || cfg.left.get(1) != 2) { return 3; }
    if (cfg.right.get(0) != 10 || cfg.right.get(1) != 20) { return 4; }
    if (cfg.count != 3 || !cfg.enabled) { return 5; }

    cfg.destroy();
    return 0;
}
