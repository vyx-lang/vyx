module test_large_struct_bool_vec_tail;

use std.collections;
use std.core;

class TailPayload {
    public a0: i64;
    public a1: i64;
    public a2: i64;
    public a3: i64;
    public a4: i64;
    public a5: i64;
    public label: string;
    public enabled: bool;
    public state: i32;

    public static fn create(label: string, enabled: bool, state: i32) -> TailPayload {
        return TailPayload {
            a0: 10,
            a1: 11,
            a2: 12,
            a3: 13,
            a4: 14,
            a5: 15,
            label: label,
            enabled: enabled,
            state: state
        };
    }

    public fn withState(state: i32) -> TailPayload {
        self.state = state;
        if (state != 0) { self.enabled = true; } else { self.enabled = false; }
        return self;
    }

    public fn clone() -> TailPayload {
        return TailPayload {
            a0: self.a0,
            a1: self.a1,
            a2: self.a2,
            a3: self.a3,
            a4: self.a4,
            a5: self.a5,
            label: self.label,
            enabled: self.enabled,
            state: self.state
        };
    }
}

class TailStore {
    private items: Vec<TailPayload>;
    private states: Vec<i32>;

    public static fn create() -> TailStore {
        return TailStore { items: Vec::<TailPayload>.new(), states: Vec::<i32>.new() };
    }

    public fn add(value: TailPayload) -> TailStore {
        self.items.push(value.clone());
        self.states.push(value.state);
        return self;
    }

    public fn at(index: i32) -> TailPayload {
        return self.items.get(index as i64).clone();
    }

    public fn stateAt(index: i32) -> i32 {
        return self.states.get(index as i64);
    }

    public fn destroy() {
        self.items.destroy();
        self.states.destroy();
    }
}

fn make_payload(state: i32) -> TailPayload {
    var payload = TailPayload.create("tail", false, 0);
    payload = payload.withState(state);
    return payload;
}

fn main() -> i32 {
    let direct = make_payload(7);
    if (!direct.enabled) { return 1; }
    if (direct.state != 7) { return 2; }
    if (direct.label != "tail") { return 3; }

    var store = TailStore.create();
    store = store.add(direct);
    if (store.stateAt(0) != 7) { store.destroy(); return 4; }

    let loaded = store.at(0);
    if (!loaded.enabled) { store.destroy(); return 5; }
    if (loaded.state != 7) { store.destroy(); return 6; }
    if (loaded.label != "tail") { store.destroy(); return 7; }

    store.destroy();
    return 0;
}
