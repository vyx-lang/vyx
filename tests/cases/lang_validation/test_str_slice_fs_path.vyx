use std.fs;
use std.string;

fn main() -> i32 {
    let full = "xxxtests/.cache/str_slice_fs_path_probe.txtyyy";
    let path = full.substring(3, full.len - 3);

    if (writeFile(path, "slice-ok") != 0) {
        return 1;
    }
    if (!fileExists(path)) {
        return 2;
    }
    let loaded = readFile(path);
    if (loaded != "slice-ok") {
        deleteFile(path);
        return 3;
    }
    if (fileSize(path) != 8) {
        deleteFile(path);
        return 4;
    }
    if (deleteFile(path) != 0) {
        return 5;
    }
    if (fileExists(path)) {
        return 6;
    }
    print("test_str_slice_fs_path OK");
    return 0;
}
