// =====================================================================
//  Edge / stress validation suite — 9 boundary scenarios.
//
//  Format mirrors tests/cases/stress/test_containers_stress.vyx:
//    every assertion is funneled through `check(name, cond)` which keeps
//    a global pass/fail counter. Each case prints a banner; the whole
//    file ends with a summary that returns nonzero if any check failed.
//
//  Cases:
//    (1) empty containers — Vec/Dict push & pop round-trip back to empty
//    (2) Vec push 10000 elements then sum (Gauss formula)              [scaled]
//    (3) deep recursion — fib_iter to depth 1000 (avoid stack overflow)
//    (4) i64 boundary  — MAX/MIN ± 1 round-trips don't corrupt
//    (5) f64 small kernel — Leibniz π approximation, 5000 terms
//    (6) large string — 100 KB via str_repeat (scaled down from 1 MB)
//    (7) nested closures — 5 captures depth, summed
//    (8) nested try? — 5-level Result propagation
//    (9) drop on failure path — Ref<i64> rc bookkeeping after fail
// =====================================================================

use std.collections;
use std.dict;
use std.string;
use std.ref;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { pass_count = pass_count + 1; }
    else { print("FAIL: ${name}"); fail_count = fail_count + 1; }
}

// ---------------------------------------------------------------------
// (1) empty containers
// ---------------------------------------------------------------------
fn test_empty_containers() {
    print("\n--- (1) empty containers ---");
    var v = Vec::<i64>.new();
    check("vec_empty_len", v.len == 0);
    v.push(7);
    let p = v.pop();
    check("vec_round_trip_pop", p == 7 && v.len == 0);

    var d = Dict::<string, i64>.new();
    check("dict_empty_len", d.len == 0);
    d.insert("k", 42);
    check("dict_after_insert", d.len == 1 && d.get("k") == 42);
    d.remove("k");
    check("dict_round_trip_remove", d.len == 0);
}

// ---------------------------------------------------------------------
// (2) Vec push 10k + sum (Gauss: n*(n-1)/2 with n=10000 -> 49995000)
// ---------------------------------------------------------------------
fn test_vec_10k_sum() {
    print("\n--- (2) Vec push 10000 + sum ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 10000) {
        v.push(i);
        i = i + 1;
    }
    check("vec_len_10000", v.len == 10000);

    var s: i64 = 0;
    var j: i64 = 0;
    while (j < v.len) {
        s = s + v.get(j);
        j = j + 1;
    }
    check("vec_sum_10000", s == 49995000);
}

// ---------------------------------------------------------------------
// (3) iterative recursion-equivalent depth 1000
//     Use iterative fib so we don't blow the stack while still
//     exercising 1000 sequential frames worth of work.
// ---------------------------------------------------------------------
fn fib_iter(n: i64) -> i64 {
    var a: i64 = 0;
    var b: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

// Tail-style countdown that recurses 1000 deep on a small frame —
// this validates the call-frame side without overflow.
fn countdown(n: i64, acc: i64) -> i64 {
    if (n <= 0) { return acc; }
    return countdown(n - 1, acc + 1);
}

fn test_recursion_depth_1000() {
    print("\n--- (3) recursion / iter depth 1000 ---");
    let f = fib_iter(20);
    check("fib_iter_20_eq_6765", f == 6765);
    let c = countdown(1000, 0);
    check("countdown_1000", c == 1000);
}

// ---------------------------------------------------------------------
// (4) i64 boundary arithmetic
// ---------------------------------------------------------------------
fn test_i64_boundaries() {
    print("\n--- (4) i64 boundary values ---");
    let i64_max: i64 = 9223372036854775807;
    let i64_min: i64 = -9223372036854775807 - 1;
    check("i64_max_minus_one_plus_one",
          (i64_max - 1) + 1 == i64_max);
    check("i64_min_plus_one_minus_one",
          (i64_min + 1) - 1 == i64_min);
    // Avoid signed overflow: subtract within representable range only.
    let near_max: i64 = i64_max - 1000;
    let near_min: i64 = i64_min + 1000;
    check("i64_near_max_distance",
          (near_max - near_min) > 0 || (near_max - near_min) < 0);
    check("i64_zero_id", i64_max + 0 == i64_max && i64_min + 0 == i64_min);
    check("i64_neg_pos_round_trip",
          -(i64_max) + i64_max == 0 && -(i64_min + 1) + (i64_min + 1) == 0);
}

// ---------------------------------------------------------------------
// (5) f64 small kernel — Leibniz π approximation, 5000 terms
//     Series: π/4 = 1 - 1/3 + 1/5 - 1/7 + ...
//     With 5000 terms |error| < ~2e-4, so 3.14 < π_approx < 3.15.
// ---------------------------------------------------------------------
fn test_f64_pi() {
    print("\n--- (5) f64 PI Leibniz approx ---");
    var pi4: f64 = 0.0;
    var sign: f64 = 1.0;
    var k: i64 = 0;
    while (k < 5000) {
        let denom: f64 = (k as f64) * 2.0 + 1.0;
        pi4 = pi4 + sign / denom;
        sign = -sign;
        k = k + 1;
    }
    let pi: f64 = pi4 * 4.0;
    check("pi_approx_above_3_14", pi > 3.14);
    check("pi_approx_below_3_15", pi < 3.15);
}

// ---------------------------------------------------------------------
// (6) large string — 100 KB via str_repeat (scaled down from 1 MB)
// ---------------------------------------------------------------------
fn test_large_string() {
    print("\n--- (6) large string (100 KB) ---");
    let unit = "abcdefghij";       // 10 bytes
    let big = str_repeat(unit, 10000); // 100_000 bytes
    check("big_len_100000", big.len == 100000);
    check("big_first_char_a", big.charAt(0) == 97);
    check("big_last_char_j", big.charAt(99999) == 106);
    check("big_mid_pattern_b", big.charAt(50001) == 98);
}

// ---------------------------------------------------------------------
// (7) nested closures — 5 captures depth
//     Each closure captures the parameters of every enclosing closure.
//     Calling l1(1) drives lN(N) -> sum 1..5 == 15.
// ---------------------------------------------------------------------
fn test_nested_closures() {
    print("\n--- (7) nested closures (5 levels) ---");
    let l1 = |a: i64| -> i64 {
        let l2 = |b: i64| -> i64 {
            let l3 = |c: i64| -> i64 {
                let l4 = |d: i64| -> i64 {
                    let l5 = |e: i64| -> i64 {
                        return a + b + c + d + e;
                    };
                    return l5(5);
                };
                return l4(4);
            };
            return l3(3);
        };
        return l2(2);
    };
    let total = l1(1);
    check("nested_closure_5_sum_15", total == 15);
}

// ---------------------------------------------------------------------
// (8) nested try? — 5-level Result propagation
// ---------------------------------------------------------------------
error EdgeErr {
    Boom
}

fn lvl5(x: i64) -> Result<i64, EdgeErr> {
    if (x < 0) { fail EdgeErr.Boom; }
    return x + 1;
}
fn lvl4(x: i64) -> Result<i64, EdgeErr> {
    let y = lvl5(x)?;
    return y + 1;
}
fn lvl3(x: i64) -> Result<i64, EdgeErr> {
    let y = lvl4(x)?;
    return y + 1;
}
fn lvl2(x: i64) -> Result<i64, EdgeErr> {
    let y = lvl3(x)?;
    return y + 1;
}
fn lvl1(x: i64) -> Result<i64, EdgeErr> {
    let y = lvl2(x)?;
    return y + 1;
}

fn run_nested_try(start: i64) -> Result<i64, EdgeErr> {
    let v = lvl1(start)?;
    return v;
}

fn test_nested_try() {
    print("\n--- (8) nested try? (5 levels) ---");
    // happy path: 0 -> +5
    let r = run_nested_try(0);
    match (r) {
        case Ok(v) => { check("try5_happy_eq_5", v == 5); }
        default => { check("try5_happy_eq_5", false); }
    }
    // sad path: -1 propagates the error all the way out
    let r2 = run_nested_try(-1);
    var got_err: bool = false;
    match (r2) {
        case Err(_) => { got_err = true; }
        default => { got_err = false; }
    }
    check("try5_err_propagates", got_err);
}

// ---------------------------------------------------------------------
// (9) drop on failure path — verify Ref<i64> rc bookkeeping after fail.
//     `holder` clones probe (rc -> 2), then fails. On fail the function
//     unwinds, dropping `holder`, returning rc to 1.
// ---------------------------------------------------------------------
fn drop_path(probe: Ref<i64>, do_fail: bool) -> Result<i64, EdgeErr> {
    var holder = probe.clone();
    if (do_fail) {
        fail EdgeErr.Boom;
    }
    return holder.get();
}

fn test_drop_on_fail() {
    print("\n--- (9) drop on failure path ---");
    var r = Ref::<i64>.new(123);
    check("ref_initial_count_1", r.count() == 1);

    // Sanity: success path returns rc to 1 after function exit.
    let ok_r = drop_path(r.clone(), false);
    var ok_val: i64 = 0;
    match (ok_r) {
        case Ok(v) => { ok_val = v; }
        default => { ok_val = -1; }
    }
    check("drop_path_ok_value", ok_val == 123);
    check("ref_count_after_ok", r.count() == 1);

    // Failure path: fail must still drop `holder` before unwinding.
    let bad_r = drop_path(r.clone(), true);
    var saw_err: bool = false;
    match (bad_r) {
        case Err(_) => { saw_err = true; }
        default => { saw_err = false; }
    }
    check("drop_path_fail_observed", saw_err);
    // After fail, the strict drop-on-unwind contract requires rc bookkeeping
    // to fully unwind — both `holder = probe.clone()` (inside drop_path) AND
    // the cloned `r.clone()` argument must be dropped before the Result
    // surfaces. BUG-LV-07: previously `emitFailExpr` skipped the auto-drop
    // walk, leaving rc=3 here. After the fix (CodeGenClosure::emitFailExpr
    // now calls `emitScopeExitDrops()` mirroring `emitReturnStmt`) rc returns
    // to 1, matching the success-path baseline above.
    let final_count = r.count();
    print("  drop_on_fail final r.count() = ${final_count}");
    check("ref_count_after_fail", final_count == 1);
    check("ref_value_intact_after_fail", r.get() == 123);
}

// ---------------------------------------------------------------------
// driver
// ---------------------------------------------------------------------
fn main() -> i32 {
    test_empty_containers();
    test_vec_10k_sum();
    test_recursion_depth_1000();
    test_i64_boundaries();
    test_f64_pi();
    test_large_string();
    test_nested_closures();
    test_nested_try();
    test_drop_on_fail();

    print("\n============================================================");
    print("Edge stress: ${pass_count} passed, ${fail_count} failed");
    print("============================================================");

    if (fail_count > 0) { return 1; }
    return 0;
}
