module test_imported_member_assignment_codegen;

use import_member_assign_dep;

fn main() -> i32 {
    let widget = ImportedWidget.toggled("imported", true);
    if (widget.name != "imported") { return 1; }
    if (!widget.enabled) { return 2; }
    if (widget.state != 1) { return 3; }
    return 0;
}
