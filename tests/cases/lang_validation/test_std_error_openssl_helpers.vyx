use std.error;
use std.security.openssl;

fn check(cond: bool, code: i32) -> i32 {
    if (cond) { return 0; }
    return code;
}

fn main() -> i32 {
    var bytes: [u8; 4];
    bytes[0] = 0 as u8;
    bytes[1] = 15 as u8;
    bytes[2] = 16 as u8;
    bytes[3] = 255 as u8;

    var rc = check(bytes_to_hex(to_rawptr(&bytes), 4) == "000f10ff", 1);
    if (rc != 0) { return rc; }
    rc = check(bytes_to_hex(null, 4) == "", 2);
    if (rc != 0) { return rc; }
    rc = check(bytes_to_hex(to_rawptr(&bytes), 0) == "", 3);
    if (rc != 0) { return rc; }

    let root = ErrorContext.with_file("missing config", "app.vyx", 12);
    let wrapped = chain("startup failed", root);
    rc = check(wrapped.chain_length() == 2, 4);
    if (rc != 0) { return rc; }
    let shown = wrapped.display();
    rc = check(shown.contains("Error: startup failed"), 5);
    if (rc != 0) { return rc; }
    rc = check(shown.contains("Caused by:"), 6);
    if (rc != 0) { return rc; }
    rc = check(shown.contains("missing config at app.vyx:12"), 7);
    if (rc != 0) { return rc; }

    print("PASS: std_error_openssl_helpers");
    return 0;
}
