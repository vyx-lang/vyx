module test_dyn_inherited_interface_impl;

interface Identity {
    fn id() -> string;
}

interface Labelled {
    fn id() -> string;
    fn label() -> string;
}

class BaseComponent : Identity {
    public component_id: string;

    public fn id() -> string {
        return self.component_id;
    }
}

class StatelessComponent : BaseComponent {
}

class EntryComponent : StatelessComponent {
    public label_text: string;

    public static fn create(id: string, label: string) -> EntryComponent {
        return EntryComponent {
            component_id: id,
            label_text: label
        };
    }

    public fn label() -> string {
        return self.label_text;
    }
}

class LeafComponent : EntryComponent {
    public static fn create(id: string, label: string) -> LeafComponent {
        return LeafComponent {
            component_id: id,
            label_text: label
        };
    }
}

fn read_identity(x: dyn Identity) -> string {
    return x.id();
}

fn read_labelled(x: dyn Labelled) -> string {
    return x.id() + ":" + x.label();
}

fn generic_identity<T>(x: T) -> string where T: Identity {
    return x.id();
}

fn main() -> i32 {
    let entry = EntryComponent.create("entry", "Entry");
    let leaf = LeafComponent.create("leaf", "Leaf");

    if (entry.id() != "entry") { return 1; }
    if (leaf.id() != "leaf") { return 2; }
    if (read_identity(entry as dyn Identity) != "entry") { return 3; }
    if (read_identity(leaf as dyn Identity) != "leaf") { return 4; }
    if (entry.id() + ":" + entry.label() != "entry:Entry") { return 5; }
    if (leaf.id() + ":" + leaf.label() != "leaf:Leaf") { return 6; }
    if (generic_identity::<EntryComponent>(entry) != "entry") { return 7; }
    if (generic_identity::<LeafComponent>(leaf) != "leaf") { return 8; }
    return 0;
}
