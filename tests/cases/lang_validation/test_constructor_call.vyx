module tests.lang_validation.test_constructor_call;

class Meter {
    public value: i32;

    public Meter() {
        return Meter { value: 0 };
    }

    public Meter(value: i32) {
        return Meter { value: value };
    }

    public Meter(value: i64) {
        return Meter { value: value as i32 };
    }

    public fn get() -> i32 {
        return self.value;
    }
}

class Box<T> {
    public data: T;

    public Box(data: T) {
        return Box { data: data };
    }

    public fn get() -> T {
        return self.data;
    }
}

fn main() -> i32 {
    let zero = Meter();
    if (zero.get() != 0) { return 1; }

    let small = Meter(7);
    if (small.get() != 7) { return 2; }

    let wide = Meter(9 as i64);
    if (wide.get() != 9) { return 3; }

    let boxed = Box::<i32>(42);
    if (boxed.get() != 42) { return 4; }
    if ("data is:${boxed.data}" != "data is:42") { return 5; }

    return 0;
}
