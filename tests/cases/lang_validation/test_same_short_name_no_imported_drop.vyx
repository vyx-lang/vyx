struct StringBuilder {
    buf: string;
    count: i64;
}

fn fill() {
    var sb = StringBuilder { buf: "", count: 0 };
    sb.buf = sb.buf + "hello";
    sb.buf = sb.buf + " ";
    sb.buf = sb.buf + "world";
    print(sb.buf);
}

fn main() -> i32 {
    fill();
    print("after local StringBuilder");
    return 0;
}
