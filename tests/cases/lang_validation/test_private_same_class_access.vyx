module lang_validation;

use std.collections;

class Bag {
    private items: Vec<i32>;

    public static fn create() -> Bag {
        return Bag { items: Vec::<i32>.new() };
    }

    public fn add(value: i32) -> Bag {
        self.items.push(value);
        return self;
    }

    public fn clone() -> Bag {
        var out = Bag.create();
        var i: i32 = 0;
        while (i < (self.items.len as i32)) {
            out.items.push(self.items.get(i as i64));
            i = i + 1;
        }
        return out;
    }

    public fn len() -> i32 {
        return self.items.len as i32;
    }

    public fn destroy() {
        self.items.destroy();
    }
}

fn main() -> i32 {
    var a = Bag.create().add(1).add(2);
    var b = a.clone();
    if (b.len() != 2) { a.destroy(); b.destroy(); return 1; }
    a.destroy();
    b.destroy();
    return 0;
}
