use std.collections;
use std.string;

extern "C" {
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
}

fn write_i64(ptr: rawptr, value: i64) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 8);
}

fn read_i64(ptr: rawptr) -> i64 {
    var v: i64 = 0;
    memcpy(to_rawptr(&v), ptr, 8);
    return v;
}

fn case_string_sso() -> i32 {
    var s = String.from("small");
    if (!s.isSmall()) { return 1; }
    if (s.length() != 5) { return 2; }
    if (s.capacity() != string_sso_capacity()) { return 3; }
    if (s.raw() != "small") { return 4; }

    s.append(" value");
    if (!s.isSmall()) { return 5; }
    if (s.raw() != "small value") { return 6; }

    var tail = String.from(" tail");
    s.appendString(tail.clone());
    if (s.raw() != "small value tail") { return 7; }
    if (tail.raw() != " tail") { return 8; }

    s.reserve(80);
    if (!s.isHeap()) { return 9; }
    if (s.capacity() < 80) { return 10; }
    if (s.raw() != "small value tail") { return 11; }

    var copy = s.clone();
    s.clear();
    if (!s.isEmpty()) { return 12; }
    if (copy.raw() != "small value tail") { return 13; }

    var small_heap = String.withCapacity(96);
    small_heap.append("tiny");
    if (!small_heap.isHeap()) { return 14; }
    small_heap.shrinkToFit();
    if (!small_heap.isSmall()) { return 15; }
    if (small_heap.raw() != "tiny") { return 16; }

    let joined = copy.concat(tail.raw());
    if (joined.raw() != "small value tail tail") { return 17; }

    s.destroy();
    tail.destroy();
    copy.destroy();
    small_heap.destroy();
    joined.destroy();
    return 0;
}

fn case_string_builder_into_string() -> i32 {
    var sb = StringBuilder.withCapacity(2);
    sb.append("ab");
    sb.appendChar(99);
    sb.appendInt(42);
    if (sb.length() != 5) { return 1; }
    if (sb.build() != "abc42") { return 2; }

    var owned = sb.intoString();
    if (sb.length() != 0) { return 3; }
    if (owned.raw() != "abc42") { return 4; }

    sb.destroy();
    if (owned.raw() != "abc42") { return 5; }
    owned.destroy();
    return 0;
}

fn case_global_allocator() -> i32 {
    let p = malloc(64);
    if (p == null) { return 1; }
    write_i64(p, 123456);
    let p2 = realloc(p, 128);
    if (p2 == null) { return 3; }
    if (read_i64(p2) != 123456) { return 5; }
    free(p2);
    return 0;
}

fn main() -> i32 {
    let r1 = case_string_sso();
    if (r1 != 0) { print("case_string_sso FAIL ${r1}"); return 10 + r1; }

    let r2 = case_string_builder_into_string();
    if (r2 != 0) { print("case_string_builder_into_string FAIL ${r2}"); return 20 + r2; }

    let r3 = case_global_allocator();
    if (r3 != 0) { print("case_global_allocator FAIL ${r3}"); return 30 + r3; }

    print("test_modern_string_allocator all OK");
    return 0;
}
