module test_static_method_resolution_edges;

class UiNode {
    public text: string;
    public padding: i32;

    public static fn text(value: string) -> UiNode {
        return UiNode { text: value, padding: 0 };
    }

    public static fn dropEvent() -> UiNode {
        return UiNode { text: "dropEvent", padding: 7 };
    }

    public fn withPadding(p: i32) -> UiNode {
        self.padding = p;
        return self;
    }

    public fn score() -> i32 {
        if (self.text == "hello" && self.padding == 4) { return 10; }
        if (self.text == "dropEvent" && self.padding == 7) { return 20; }
        return 0;
    }
}

class UiEvent {
    public kind: UiNode;

    public static fn empty() -> UiEvent {
        return UiEvent { kind: UiNode.dropEvent() };
    }

    public fn setKind(kind: UiNode) -> UiEvent {
        self.kind = kind;
        return self;
    }
}

fn main() -> i32 {
    let label = UiNode.text("hello").withPadding(4);
    if (label.score() != 10) { return 1; }

    let dropped = UiNode.dropEvent();
    if (dropped.score() != 20) { return 2; }

    var ev = UiEvent.empty();
    ev = ev.setKind(UiNode.text("hello").withPadding(4));
    if (ev.kind.score() != 10) { return 3; }

    return 0;
}
