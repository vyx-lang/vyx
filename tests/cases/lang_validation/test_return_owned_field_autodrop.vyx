module lang_validation;

use std.collections;

class OwnedList {
    public items: Vec<i32>;

    public static fn empty() -> OwnedList {
        return OwnedList { items: Vec::<i32>.new() };
    }

    public static fn fromVec(items: Vec<i32>) -> OwnedList {
        return OwnedList { items: items };
    }

    public fn pushValue(value: i32) -> OwnedList {
        self.items.push(value);
        return self;
    }

    public fn count() -> i32 {
        return self.items.len as i32;
    }

    public fn at(index: i32) -> i32 {
        return self.items.get(index as i64);
    }

    public fn drop() {
        self.items.destroy();
    }
}

fn make_from_local_owner() -> OwnedList {
    var out = OwnedList.empty();
    out = out.pushValue(5);
    out = out.pushValue(8);
    return out;
}

fn make_from_local_vec() -> OwnedList {
    var items = Vec::<i32>.new();
    items.push(13);
    items.push(21);
    return OwnedList.fromVec(items);
}

fn main() -> i32 {
    var a = make_from_local_owner();
    if (a.count() != 2) { a.drop(); return 1; }
    if (a.at(0) != 5) { a.drop(); return 2; }
    if (a.at(1) != 8) { a.drop(); return 3; }
    a.drop();

    var b = make_from_local_vec();
    if (b.count() != 2) { b.drop(); return 4; }
    if (b.at(0) != 13) { b.drop(); return 5; }
    if (b.at(1) != 21) { b.drop(); return 6; }
    b.drop();
    return 0;
}
