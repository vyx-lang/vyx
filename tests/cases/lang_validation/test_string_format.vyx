// test_string_format.vyx — string / format / encoding / path stress.
// Cases mirror test_generics_deep.vyx style: each `caseN` returns 0
// on success, non-zero on failure.  `main` prints `caseN FAIL k` and
// returns a unique non-zero code so the failing slot is identifiable
// from a single `--run` invocation.

use std.core;
use std.collections;
use std.algorithm;
use std.string;
use std.fmt;
use std.encoding;
use std.path;

// ------------------------------------------------------------------
// (1) StringBuilder: 1000+ append iterations.
//     Build "ab" * 600 = 1200-byte string and verify length + tail.
// ------------------------------------------------------------------
fn case1_string_builder_loop() -> i32 {
    var sb = StringBuilder.create();
    var i: i64 = 0;
    while (i < 600) {
        sb.append("ab");
        i = i + 1;
    }
    if (sb.length() != 1200) { return 1; }
    let s = sb.build();
    if (s.len != 1200) { return 2; }
    if (s.substring(0, 4) != "abab") { return 3; }
    if (s.substring(1196, 1200) != "abab") { return 4; }
    sb.destroy();
    return 0;
}

// ------------------------------------------------------------------
// (2) format / i64_to_string / f64_to_string conversions.
// ------------------------------------------------------------------
fn case2_format_conversions() -> i32 {
    if (i64_to_string(12345) != "12345") { return 1; }
    if (i64_to_string(-99)   != "-99")   { return 2; }
    if (i64_to_string(0)     != "0")     { return 3; }

    let pi = f64_to_string(3.14);
    if (pi.len == 0) { return 4; }
    if (!pi.contains("3.14")) { return 5; }

    let f0 = f64_to_string(0.0);
    if (f0.len == 0) { return 6; }

    if (format("[%lld]", 42) != "[42]")           { return 7; }
    if (format("(%s,%lld)", "x", 7) != "(x,7)")   { return 8; }
    return 0;
}

// ------------------------------------------------------------------
// (3) split / join / replace / trim.
// ------------------------------------------------------------------
fn case3_split_join_replace_trim() -> i32 {
    let parts = str_split("alpha,beta,gamma", ",");
    if (parts.len != 3) { return 1; }
    if (parts.get(0) != "alpha") { return 2; }
    if (parts.get(2) != "gamma") { return 3; }

    let joined = str_join(parts, "|");
    if (joined != "alpha|beta|gamma") { return 4; }

    let r = str_replace("foo bar foo baz foo", "foo", "Q");
    if (r != "Q bar Q baz Q") { return 5; }

    let r2 = str_replace("aaaaa", "aa", "b");
    if (r2 != "bba") { return 6; }

    if (str_trim("   hello   ").len != 5) { return 7; }
    if (str_trim("\t\n hi \r\n") != "hi") { return 8; }
    if (str_trim("        ") != "") { return 9; }
    return 0;
}

// ------------------------------------------------------------------
// (4) UTF-8 multi-byte substring — must not crash on byte boundaries.
//     "你好世界" = 12 bytes (each char is 3 bytes in UTF-8).
// ------------------------------------------------------------------
fn case4_utf8_substring_safe() -> i32 {
    let s = "你好世界";
    if (s.len != 12) { return 1; }

    // Whole-string roundtrip — exercises substring at zero / full len.
    if (s.substring(0, 12) != "你好世界") { return 2; }

    // Out-of-range hi clamps to len (str_substring contract).
    if (s.substring(0, 999) != "你好世界") { return 3; }

    // Out-of-range lo clamps to 0.
    if (s.substring(-5, 6).len != 6) { return 4; }

    // Whole-codepoint slice on byte boundary 0..3 = "你".
    let one = s.substring(0, 3);
    if (one.len != 3) { return 5; }
    if (one != "你") { return 6; }

    // Empty slice when hi <= lo.
    if (s.substring(5, 5) != "") { return 7; }
    if (s.substring(8, 4) != "") { return 8; }

    // Concatenation roundtrip on UTF-8 byte slices.
    let concat = s.substring(0, 6) + s.substring(6, 12);
    if (concat != "你好世界") { return 9; }
    return 0;
}

// ------------------------------------------------------------------
// (5) Vec<string> sort — manual bubble sort via str_compare so we do
//     not depend on `Ord`-based generic dispatch through Vec<T>.sort.
// ------------------------------------------------------------------
@[borrow_args]
fn sort_strings_inplace(v: Vec<string>) {
    let n = v.len;
    var i: i64 = 0;
    while (i < n) {
        var j: i64 = 0;
        while (j + 1 < n - i) {
            let a = v.get(j);
            let b = v.get(j + 1);
            if (str_compare(a, b) > 0) { v.swap(j, j + 1); }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn case5_vec_string_sort() -> i32 {
    var v = Vec::<string>.new();
    v.push("delta"); v.push("alpha"); v.push("charlie");
    v.push("bravo"); v.push("echo");
    sort_strings_inplace(v);
    if (v.get(0) != "alpha")   { return 1; }
    if (v.get(1) != "bravo")   { return 2; }
    if (v.get(2) != "charlie") { return 3; }
    if (v.get(3) != "delta")   { return 4; }
    if (v.get(4) != "echo")    { return 5; }

    // Reverse-sorted input is also handled.
    var w = Vec::<string>.new();
    w.push("zzz"); w.push("yyy"); w.push("xxx");
    sort_strings_inplace(w);
    if (w.get(0) != "xxx") { return 6; }
    if (w.get(2) != "zzz") { return 7; }
    return 0;
}

// ------------------------------------------------------------------
// (6) JSON nested concatenation through StringBuilder.
//     Produces  {"name":"Alice","tags":["a","b","c"],"meta":{"n":3}}.
// ------------------------------------------------------------------
fn case6_json_nested_concat() -> i32 {
    var tags = Vec::<string>.new();
    tags.push("a"); tags.push("b"); tags.push("c");

    var sb = StringBuilder.create();
    sb.append("{\"name\":\"Alice\",\"tags\":[");
    var i: i64 = 0;
    while (i < tags.len) {
        if (i > 0) { sb.append(","); }
        sb.append("\"");
        sb.append(tags.get(i));
        sb.append("\"");
        i = i + 1;
    }
    sb.append("],\"meta\":{\"n\":");
    sb.appendInt(tags.len);
    sb.append("}}");

    let json = sb.build();
    let expect = "{\"name\":\"Alice\",\"tags\":[\"a\",\"b\",\"c\"],\"meta\":{\"n\":3}}";
    if (json != expect) { return 1; }

    if (!json.contains("\"Alice\"")) { return 2; }
    if (!json.contains("\"n\":3"))   { return 3; }
    sb.destroy();
    return 0;
}

// ------------------------------------------------------------------
// (7) hex / base64 round-trip in a loop.
// ------------------------------------------------------------------
fn case7_hex_base64_loop() -> i32 {
    let inputs = ["Hello", "Vyx-2026", "x", "AAA"];
    var k: i64 = 0;
    while (k < 4) {
        let s = inputs[k];
        var iter: i64 = 0;
        while (iter < 3) {
            let h = hex_encode(s);
            let back = hex_decode(h);
            if (back != s) { return 1; }

            let b = base64_encode(s);
            let b2 = base64_decode(b);
            if (b2 != s) { return 2; }

            iter = iter + 1;
        }
        k = k + 1;
    }

    // hex of "Hi" = "4869" (0x48 'H', 0x69 'i').
    if (hex_encode("Hi") != "4869") { return 3; }
    if (hex_decode("4869") != "Hi") { return 4; }

    // base64 of "M" (1 byte) is "TQ==".
    if (base64_encode("M") != "TQ==") { return 5; }
    return 0;
}

// ------------------------------------------------------------------
// (8) Path concatenation + std.path predicates.
// ------------------------------------------------------------------
fn join_path(dir: string, file: string) -> string {
    if (dir.len == 0) { return file; }
    let last = dir.charAt(dir.len - 1);
    if (last == 47 || last == 92) { return dir + file; }
    return dir + "/" + file;
}

fn case8_path_concat() -> i32 {
    let p1 = join_path("docs", "readme.md");
    if (p1 != "docs/readme.md") { return 1; }

    let p2 = join_path("docs/", "readme.md");
    if (p2 != "docs/readme.md") { return 2; }

    let p3 = join_path("a", join_path("b", "c.txt"));
    if (p3 != "a/b/c.txt") { return 3; }

    if (is_absolute("C:\\Users\\me") != 1) { return 4; }
    if (is_absolute("/etc/hosts") != 1) { return 5; }
    if (is_absolute("relative.txt") != 0) { return 6; }
    if (is_absolute("") != 0) { return 7; }

    let sep = path_separator();
    if (sep != 92) { return 8; }
    return 0;
}

// ------------------------------------------------------------------
// Main: dispatch each case; first non-zero failure prints + propagates.
// ------------------------------------------------------------------
fn main() -> i32 {
    let r1 = case1_string_builder_loop();    if (r1 != 0) { print("case1 FAIL ${r1}"); return 10 + r1; }
    let r2 = case2_format_conversions();     if (r2 != 0) { print("case2 FAIL ${r2}"); return 20 + r2; }
    let r3 = case3_split_join_replace_trim();if (r3 != 0) { print("case3 FAIL ${r3}"); return 30 + r3; }
    let r4 = case4_utf8_substring_safe();    if (r4 != 0) { print("case4 FAIL ${r4}"); return 40 + r4; }
    let r5 = case5_vec_string_sort();        if (r5 != 0) { print("case5 FAIL ${r5}"); return 50 + r5; }
    let r6 = case6_json_nested_concat();     if (r6 != 0) { print("case6 FAIL ${r6}"); return 60 + r6; }
    let r7 = case7_hex_base64_loop();        if (r7 != 0) { print("case7 FAIL ${r7}"); return 70 + r7; }
    let r8 = case8_path_concat();            if (r8 != 0) { print("case8 FAIL ${r8}"); return 80 + r8; }
    print("test_string_format all OK");
    return 0;
}
