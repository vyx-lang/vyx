module test_multi_string_field_args_preserve_tail;

use std.string;

class Sink {
    public a: string;
    public b: string;
    public c: string;

    public static fn create(a: string, b: string, c: string) -> Sink {
        return Sink { a: a, b: b, c: c };
    }

    public fn checkAfterReadingFirstTwo() -> i32 {
        let aa = "a=" + self.a;
        let bb = "b=" + self.b;
        if (aa != "a=one") { return 10; }
        if (bb != "b=two") { return 11; }
        if (self.c != "three") { return 12; }
        return 0;
    }
}

class Base {
    public p0: string;
    public p1: string;
    public p2: i32;
    public p3: u64;
}

class Source : Base {
    public a: string;
    public b: string;
    public c: string;

    public static fn create() -> Source {
        return Source {
            p0: "base0",
            p1: "base1",
            p2: 7,
            p3: 9 as u64,
            a: "one",
            b: "two",
            c: "three"
        };
    }

    public fn toSink() -> Sink {
        return Sink.create(self.a, self.b, self.c);
    }
}

fn main() -> i32 {
    let s = Source.create().toSink();
    if (s.a != "one") { return 1; }
    if (s.b != "two") { return 2; }
    if (s.c != "three") { return 3; }
    if (Source.create().toSink().checkAfterReadingFirstTwo() != 0) { return 4; }
    return 0;
}
