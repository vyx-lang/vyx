module import_member_assign_dep;

public class ImportedWidget {
    public name: string;
    public enabled: bool;
    public state: i32;

    public static fn create(name: string) -> ImportedWidget {
        return ImportedWidget { name: name, enabled: false, state: 0 };
    }

    public static fn toggled(name: string, value: bool) -> ImportedWidget {
        var widget = ImportedWidget.create(name);
        widget.enabled = value;
        if (value) { widget.state = 1; } else { widget.state = 0; }
        return widget;
    }
}
