use std.collections;

class Point {
    public x: f32;
    public y: f32;

    public static fn xy(x: f32, y: f32) -> Point {
        return Point { x: x, y: y };
    }

    public fn clone() -> Point { return Point.xy(self.x, self.y); }
}

class Rect {
    public x: f32;
    public y: f32;
    public w: f32;
    public h: f32;

    public static fn xywh(x: f32, y: f32, w: f32, h: f32) -> Rect {
        return Rect { x: x, y: y, w: w, h: h };
    }

    public fn clone() -> Rect { return Rect.xywh(self.x, self.y, self.w, self.h); }
}

class Path {
    public points: Vec<Point>;
    public closed: bool;

    public static fn create() -> Path {
        return Path { points: Vec::<Point>.new(), closed: false };
    }

    public fn moveTo(point: Point) -> Path {
        self.points.destroy();
        self.points = Vec::<Point>.new();
        self.points.push(point);
        self.closed = false;
        return self;
    }

    public fn lineTo(point: Point) -> Path {
        self.points.push(point);
        return self;
    }

    public fn close() -> Path {
        self.closed = true;
        return self;
    }

    public fn isFillable() -> bool {
        return self.closed && self.points.len >= 3;
    }

    public fn clone() -> Path {
        var out = Path.create();
        var i: i64 = 0;
        while (i < self.points.len) {
            out.points.push(self.points.get(i).clone());
            i = i + 1;
        }
        out.closed = self.closed;
        return out;
    }
}

class CommandKind {
    public value: i32;
    public static fn none() -> CommandKind { return CommandKind { value: 0 }; }
    public static fn clipPath() -> CommandKind { return CommandKind { value: 16 }; }
    public fn clone() -> CommandKind { return CommandKind { value: self.value }; }
}

class Command {
    public kind: CommandKind;
    public r0: Rect;
    public r1: Rect;
    public p0: Point;
    public p1: Point;
    public p2: Point;
    public p3: Point;
    public v0: f32;
    public v1: f32;
    public v2: f32;
    public v3: f32;
    public path: Path;

    public static fn clipPath(clip_path: Path) -> Command {
        return Command {
            kind: CommandKind.clipPath(),
            r0: Rect.xywh(0.0, 0.0, 0.0, 0.0),
            r1: Rect.xywh(1.0, 2.0, 3.0, 4.0),
            p0: Point.xy(0.0, 0.0),
            p1: Point.xy(1.0, 0.0),
            p2: Point.xy(1.0, 1.0),
            p3: Point.xy(0.0, 1.0),
            v0: 10.0,
            v1: 20.0,
            v2: 30.0,
            v3: 40.0,
            path: clip_path.clone()
        };
    }

    public fn clone() -> Command {
        return Command {
            kind: self.kind.clone(),
            r0: self.r0.clone(),
            r1: self.r1.clone(),
            p0: self.p0.clone(),
            p1: self.p1.clone(),
            p2: self.p2.clone(),
            p3: self.p3.clone(),
            v0: self.v0,
            v1: self.v1,
            v2: self.v2,
            v3: self.v3,
            path: self.path.clone()
        };
    }
}

class Graph {
    public commands: Vec<Command>;

    public static fn create() -> Graph {
        return Graph { commands: Vec::<Command>.new() };
    }

    public fn pushClipPath(path: Path) -> Graph {
        if (!path.isFillable()) { return self; }
        self.commands.push(Command.clipPath(path));
        return self;
    }

    public fn commandAt(index: i32) -> Command {
        return self.commands.get(index as i64);
    }
}

fn main() -> i32 {
    var path = Path.create()
        .moveTo(Point.xy(50.0, 10.0))
        .lineTo(Point.xy(90.0, 50.0))
        .lineTo(Point.xy(50.0, 90.0))
        .lineTo(Point.xy(10.0, 50.0))
        .close();
    if (!path.isFillable()) { return 1; }
    var graph = Graph.create().pushClipPath(path);
    if (graph.commands.len != 1) { return 2; }
    if (!graph.commandAt(0).path.isFillable()) { return 7; }
    if (graph.commandAt(0).path.points.len != 4) { return 8; }
    let command = graph.commandAt(0);
    if (command.kind.value != 16) { return 3; }
    if (!command.path.isFillable()) { return 4; }
    if (command.path.points.len != 4) { return 5; }
    if (command.path.points.get(2).y != 90.0) { return 6; }
    return 0;
}
