// Self-host bootstrap gate.
//
// This is not a self-hosted compiler implementation.  It is a compiler-shaped
// executable workload: token stream -> parser nodes -> symbol/index tables ->
// diagnostics/codegen text -> callback scoring.  The goal is to keep the
// language/runtime paths that a Vyx-written compiler depends on under one
// focused regression test.

module lang_validation;

use std.core;
use std.collections;
use std.ref;
use std.string;

error BootstrapErr {
    Empty,
    Unexpected,
    Missing,
}

class MiniToken {
    public kind: i32
    public text: string

    public static fn new(kind: i32, text: string) -> MiniToken {
        return MiniToken { kind: kind, text: text };
    }
}

class MiniNode {
    public tag: string
    public name: string
    public arity: i32

    public static fn new(tag: string, name: string, arity: i32) -> MiniNode {
        return MiniNode { tag: tag, name: name, arity: arity };
    }
}

fn check(name: string, cond: bool) -> i32 {
    if (cond) {
        print("PASS: ${name}");
        return 0;
    }
    print("FAIL: ${name}");
    return 1;
}

fn is_ident_char(ch: i32) -> bool {
    return char_is_alpha(ch) || char_is_digit(ch) || ch == 95;
}

fn lex_source(source: string) -> Result<Vec<MiniToken>, BootstrapErr> {
    if (source.len == 0) { fail BootstrapErr.Empty; }

    var out = Vec::<MiniToken>.new();
    var pos: i64 = 0;
    while (pos < source.len) {
        while (pos < source.len && str_char_at(source, pos) == 32) {
            pos += 1;
        }
        if (pos >= source.len) { break; }

        let ch = str_char_at(source, pos);
        var end = pos + 1;
        var kind: i32 = 3;

        if (char_is_alpha(ch) || ch == 95) {
            kind = 1;
            while (end < source.len && is_ident_char(str_char_at(source, end))) {
                end += 1;
            }
        } elif (char_is_digit(ch)) {
            kind = 2;
            while (end < source.len && char_is_digit(str_char_at(source, end))) {
                end += 1;
            }
        } elif (ch == 45 && pos + 1 < source.len && str_char_at(source, pos + 1) == 62) {
            kind = 4;
            end = pos + 2;
        }

        out.push(MiniToken.new(kind, str_substring(source, pos, end)));
        pos = end;
    }

    if (out.len == 0) { fail BootstrapErr.Empty; }
    return out;
}

fn parse_tokens(tokens: Vec<MiniToken>) -> Result<Vec<MiniNode>, BootstrapErr> {
    if (tokens.len < 8) { fail BootstrapErr.Unexpected; }

    var nodes = Vec::<MiniNode>.new();
    var scopes = Vec::<string>.new();
    scopes.push("module");

    var i: i64 = 0;
    while (i < tokens.len) {
        let t = tokens.get(i);
        if (t.text == "fn" && i + 1 < tokens.len) {
            let name_tok = tokens.get(i + 1);
            nodes.push(MiniNode.new("fn", name_tok.text, 3));
            scopes.push("fn:" + name_tok.text);
            i += 2;
        } elif (t.text == "let" && i + 1 < tokens.len) {
            let name_tok = tokens.get(i + 1);
            nodes.push(MiniNode.new("let", name_tok.text, 1));
            i += 2;
        } elif (t.text == "return" && i + 1 < tokens.len) {
            nodes.push(MiniNode.new("return", "expr", 1));
            i += 2;
        } elif (t.text == "}") {
            if (scopes.len > 1) { scopes.pop(); }
            i += 1;
        } else {
            i += 1;
        }
    }

    if (nodes.len < 3) { fail BootstrapErr.Missing; }
    if (scopes.len != 1) { fail BootstrapErr.Unexpected; }
    return nodes;
}

fn analyze_nodes(nodes: Vec<MiniNode>) -> Result<i32, BootstrapErr> {
    var by_tag = Dict::<string, Vec<string>>.new();
    var fn_names = Vec::<string>.new();
    var let_names = Vec::<string>.new();
    var return_names = Vec::<string>.new();
    by_tag.put("fn", fn_names);
    by_tag.put("let", let_names);
    by_tag.put("return", return_names);

    var arity_total: i32 = 0;
    var i: i64 = 0;
    while (i < nodes.len) {
        let node = nodes.get(i);
        let bucket = by_tag.get(node.tag);
        bucket.push(node.name);
        by_tag.put(node.tag, bucket);
        arity_total += node.arity;
        i += 1;
    }

    let fns = by_tag.get("fn");
    let lets = by_tag.get("let");
    let rets = by_tag.get("return");
    if (fns.len != 2) { fail BootstrapErr.Missing; }
    if (lets.len != 2) { fail BootstrapErr.Missing; }
    if (rets.len != 2) { fail BootstrapErr.Missing; }
    if (fns.get(0) != "add") { fail BootstrapErr.Unexpected; }
    if (fns.get(1) != "main") { fail BootstrapErr.Unexpected; }
    return arity_total;
}

fn emit_ir_stub(score: i32) -> string {
    var lines = Vec::<string>.new();
    lines.push("define i32 @main() {");
    lines.push("entry:");
    lines.push("  %score = add i32 0, " + "${score}");
    lines.push("  ret i32 %score");
    lines.push("}");

    var out = "";
    var i: i64 = 0;
    while (i < lines.len) {
        out = out + lines.get(i) + "\n";
        i += 1;
    }
    return out;
}

fn plus_one(x: i64) -> i64 { return x + 1; }
fn times_two(x: i64) -> i64 { return x * 2; }

fn callback_score(seed: i64) -> i64 {
    let bias: i64 = 7;
    let add_bias = [bias](x: i64) => x + bias;

    var passes = Vec::<fn(i64) -> i64>.new();
    passes.push(add_bias);
    passes.push(plus_one);
    passes.push(times_two);

    let a = passes.get(0)(seed);
    let b = passes.get(1)(a);
    let c = passes.get(2)(b);
    return c;
}

fn nested_box_gate() -> i32 {
    let inner = Box::<i32>.new(42);
    let outer = Box::<Box<i32>>.new(inner);
    let got = outer.deref().deref();
    if (got != 42) { return 1; }
    return 0;
}

fn run_pipeline() -> Result<i32, BootstrapErr> {
    let source =
        "fn add(a: i32, b: i32) -> i32 { return a + b; } " +
        "fn main() -> i32 { let x = add(20, 22); let y = x; return y; }";
    let tokens = lex_source(source)?;
    let nodes = parse_tokens(tokens)?;
    let arity = analyze_nodes(nodes)?;
    let ir = emit_ir_stub(arity);

    if (!ir.contains("define i32 @main")) { fail BootstrapErr.Missing; }
    if (!ir.contains("ret i32")) { fail BootstrapErr.Missing; }

    let cb = callback_score(arity as i64);
    if (cb != ((arity as i64 + 7 + 1) * 2)) { fail BootstrapErr.Unexpected; }

    if (nested_box_gate() != 0) { fail BootstrapErr.Unexpected; }
    return arity;
}

fn main() -> i32 {
    var failed: i32 = 0;
    let empty = lex_source("");
    match (empty) {
        case Err(e) => {
            match (e) {
                case Empty => { failed += check("empty_source_err", true); }
                default => { failed += check("empty_source_err", false); }
            }
        }
        default => { failed += check("empty_source_err", false); }
    }

    let result = run_pipeline();
    match (result) {
        case Ok(score) => {
            failed += check("pipeline_score", score == 10);
        }
        case Err(_) => {
            failed += check("pipeline_score", false);
        }
    }

    if (failed != 0) { return failed; }
    print("test_selfhost_bootstrap_gate all OK");
    return 0;
}
