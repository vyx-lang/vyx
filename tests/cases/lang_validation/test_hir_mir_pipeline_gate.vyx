module lang_validation;

use std.core;
use std.collections;

fn check(cond: bool, code: i32) -> i32 {
    if (cond) { return 0; }
    return code;
}

fn choose_score(a: i32, b: i32) -> i32 {
    let x = if (a == 1) {
        10;
    } elif (b == 2) {
        20;
    } else {
        return 30;
    };
    return x + 1;
}

fn identity<T>(value: T) -> T {
    return value;
}

fn rawptr_offset_gate() -> i32 {
    var slots: [rawptr; 2];
    slots[0] = null;
    slots[1] = null;
    let base = to_rawptr(&slots);
    let next: rawptr = base + 8;
    if (base == null || next == null) { return 1; }
    return 0;
}

fn logic_chain_gate(i: i32, values: Vec<i32>) -> i32 {
    if (i == 0 || values.get(99) == 1) { return 0; }
    return 1;
}

fn generic_vec_gate() -> i32 {
    var values = Vec::<i32>.new();
    values.push(41);
    values.push(identity::<i32>(1));
    if (values.len != 2) { return 1; }
    if (values.get(0) + values.get(1) != 42) { return 2; }
    return logic_chain_gate(0, values);
}

fn main() -> i32 {
    var rc = check(choose_score(1, 0) == 11, 1);
    if (rc != 0) { return rc; }
    rc = check(choose_score(0, 2) == 21, 2);
    if (rc != 0) { return rc; }
    rc = check(choose_score(0, 0) == 30, 3);
    if (rc != 0) { return rc; }

    rc = check(rawptr_offset_gate() == 0, 4);
    if (rc != 0) { return rc; }
    rc = check(generic_vec_gate() == 0, 5);
    if (rc != 0) { return rc; }

    let tag = identity::<string>(if (true) { "hir"; } else { "mir"; });
    rc = check(tag == "hir", 6);
    if (rc != 0) { return rc; }

    print("PASS: hir_mir_pipeline_gate");
    return 0;
}
