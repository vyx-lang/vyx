use std.core;

error LowErr {
    Empty,
    Bad,
}

error HighErr {
    Lifted,
    Bubbled,
    NotFound,
}

fn pass(name: string) { print("PASS: ${name}"); }
fn fail_msg(name: string) { print("FAIL: ${name}"); }
fn check(name: string, cond: bool) -> i32 {
    if (cond) { pass(name); return 0; }
    fail_msg(name); return 1;
}

// (1) Result 多层 ? 传播 + 中间层 map_err
fn parse_low(s: string) -> Result<i32, LowErr> {
    if (s == "") { fail LowErr.Empty; }
    if (s == "x") { fail LowErr.Bad; }
    if (s == "1") { return 1; }
    if (s == "2") { return 2; }
    return 99;
}

fn lift_err(e: LowErr) -> HighErr {
    match (e) {
        case Empty => { return HighErr.Lifted; }
        default => { return HighErr.Bubbled; }
    }
}

// Note: avoid `Result.map_err<F>(...)` due to bootstrap-compiler instability
// with generic method instantiation across error enums; the lift is inlined.
fn parse_mid(s: string) -> Result<i32, HighErr> {
    let raw: Result<i32, LowErr> = parse_low(s);
    match (raw) {
        case Ok(v) => { return v + 10; }
        case Err(e) => {
            match (e) {
                case Empty => { fail HighErr.Lifted; }
                default => { fail HighErr.Bubbled; }
            }
        }
    }
    fail HighErr.Bubbled;
}

fn parse_top(s: string) -> Result<i32, HighErr> {
    let v = parse_mid(s)?;
    return v * 2;
}

fn test_propagation() -> i32 {
    var failed: i32 = 0;
    let r1 = parse_top("1");
    match (r1) {
        case Ok(v) => { failed = failed + check("p1_ok_value", v == 22); }
        default => { failed = failed + check("p1_ok_branch", false); }
    }
    let r2 = parse_top("");
    match (r2) {
        case Err(e) => {
            match (e) {
                case Lifted => { failed = failed + check("p2_lifted", true); }
                default => { failed = failed + check("p2_lifted", false); }
            }
        }
        default => { failed = failed + check("p2_err_branch", false); }
    }
    let r3 = parse_top("x");
    match (r3) {
        case Err(e) => {
            match (e) {
                case Bubbled => { failed = failed + check("p3_bubbled", true); }
                default => { failed = failed + check("p3_bubbled", false); }
            }
        }
        default => { failed = failed + check("p3_err_branch", false); }
    }
    return failed;
}

// (2) Option chain unwrap_or / and_then / filter
fn lookup(id: i32) -> Option<i32> {
    if (id == 1) { return Some(10); }
    if (id == 2) { return Some(20); }
    return None;
}

fn double_pos(v: i32) -> Option<i32> {
    if (v > 0) { return Some(v * 2); }
    return None;
}

fn is_even(v: i32) -> bool { return v % 2 == 0; }

fn test_option_chain() -> i32 {
    var failed: i32 = 0;
    // BUG-LV-11 fix: Option<T>.filter(pred) is now scheduled by Mono via
    // the lang-item-ErrorDef branch in findLazyMethodForCall (without
    // turbofish, without @[lazy]). Predicate written as a closure literal
    // so the fat-fn-pointer ABI is set up by the same path Vec.iter().filter
    // already uses.
    let s1: Option<i32> = lookup(1);
    let m1: Option<i32> = s1.and_then::<i32>(double_pos);
    let f1: Option<i32> = m1.filter(|v: i32| -> bool { return v % 2 == 0; });
    let a: i32 = f1.unwrap_or(-1);
    failed = failed + check("opt_chain_hit", a == 20);

    let s2: Option<i32> = lookup(99);
    let m2: Option<i32> = s2.and_then::<i32>(double_pos);
    let f2: Option<i32> = m2.filter(|v: i32| -> bool { return v % 2 == 0; });
    let b: i32 = f2.unwrap_or(-1);
    failed = failed + check("opt_chain_miss", b == -1);

    let s3: Option<i32> = lookup(2);
    let f3: Option<i32> = s3.filter(|v: i32| -> bool { return v % 2 == 0; });
    let c: i32 = f3.unwrap_or(-1);
    failed = failed + check("opt_filter_pass", c == 20);
    return failed;
}

// (3) try (?) 表达式在表达式位置使用 (binding RHS / return RHS)
fn add_two(s1: string, s2: string) -> Result<i32, HighErr> {
    let a = parse_mid(s1)?;
    let b = parse_mid(s2)?;
    return a + b;
}

fn passthrough(s: string) -> Result<i32, HighErr> {
    return parse_mid(s)?;
}

fn test_try_in_expression() -> i32 {
    var failed: i32 = 0;
    let r1 = add_two("1", "2");
    match (r1) {
        case Ok(v) => { failed = failed + check("try_expr_ok", v == 23); }
        default => { failed = failed + check("try_expr_ok_branch", false); }
    }
    let r2 = add_two("1", "");
    match (r2) {
        case Err(_) => { failed = failed + check("try_expr_err", true); }
        default => { failed = failed + check("try_expr_err_branch", false); }
    }
    return failed;
}

// (4) match 穷尽性 + guard
fn classify(n: i32) -> string {
    if (n == 0) { return "zero"; }
    if (n < 0) { return "neg"; }
    if (n > 100) { return "big"; }
    return "small_pos";
}

fn test_match_guard() -> i32 {
    var failed: i32 = 0;
    failed = failed + check("guard_zero", classify(0) == "zero");
    failed = failed + check("guard_neg", classify(-3) == "neg");
    failed = failed + check("guard_big", classify(200) == "big");
    failed = failed + check("guard_small", classify(7) == "small_pos");
    return failed;
}

// (5) 嵌套 match Result<Option<i32>, HighErr>
fn lookup_or_err(id: i32) -> Result<Option<i32>, HighErr> {
    if (id < 0) { fail HighErr.NotFound; }
    if (id == 1) { return Ok(Some(10)); }
    if (id == 2) { return Ok(Some(20)); }
    return Ok(None);
}

fn classify_nested(id: i32) -> string {
    match (lookup_or_err(id)) {
        case Ok(opt) => {
            match (opt) {
                case Some(v) => {
                    if (v > 15) { return "big"; }
                    return "small";
                }
                default => { return "absent"; }
            }
        }
        default => { return "error"; }
    }
}

fn test_nested_match() -> i32 {
    var failed: i32 = 0;
    failed = failed + check("nest_big", classify_nested(2) == "big");
    failed = failed + check("nest_small", classify_nested(1) == "small");
    failed = failed + check("nest_absent", classify_nested(99) == "absent");
    failed = failed + check("nest_error", classify_nested(-1) == "error");
    return failed;
}

// (6) early return / break / continue replay auto-drop + defer
fn early_return_with_defer(n: i32) -> i32 {
    var trace: i32 = 0;
    defer { trace = trace + 1; }
    defer { trace = trace + 10; }
    if (n == 1) { return trace; }
    if (n == 2) { return trace + 100; }
    return -1;
}

fn defer_in_loop_break() -> i32 {
    var trace: i32 = 0;
    for (var i: i32 = 0; i < 5; i++) {
        defer { trace = trace + 1; }
        if (i == 3) { break; }
    }
    return trace;
}

fn defer_in_loop_continue() -> i32 {
    var trace: i32 = 0;
    for (var i: i32 = 0; i < 5; i++) {
        defer { trace = trace + 1; }
        if (i % 2 == 0) { continue; }
        trace = trace + 100;
    }
    return trace;
}

fn test_defer_replay() -> i32 {
    var failed: i32 = 0;
    let r1 = early_return_with_defer(1);
    failed = failed + check("defer_early_ret", r1 == 0);
    let r2 = defer_in_loop_break();
    failed = failed + check("defer_loop_break", r2 >= 4);
    let r3 = defer_in_loop_continue();
    failed = failed + check("defer_loop_cont", r3 >= 5);
    return failed;
}

// (7) fail variant 不同所有权路径：bare 变体 vs payload 变体
error PathErr {
    NoData,
    BadInput(string),
}

fn produce(kind: i32) -> Result<i32, PathErr> {
    if (kind == 0) { return Ok(7); }
    if (kind == 1) { fail PathErr.NoData; }
    fail PathErr.BadInput("oops");
}

fn test_fail_paths() -> i32 {
    var failed: i32 = 0;
    let r0 = produce(0);
    match (r0) {
        case Ok(v) => { failed = failed + check("path_ok", v == 7); }
        default => { failed = failed + check("path_ok_branch", false); }
    }
    let r1 = produce(1);
    match (r1) {
        case Err(e) => {
            match (e) {
                case NoData => { failed = failed + check("path_bare", true); }
                default => { failed = failed + check("path_bare", false); }
            }
        }
        default => { failed = failed + check("path_bare_branch", false); }
    }
    let r2 = produce(2);
    match (r2) {
        case Err(e) => {
            match (e) {
                case BadInput(s) => { failed = failed + check("path_payload", s == "oops"); }
                default => { failed = failed + check("path_payload", false); }
            }
        }
        default => { failed = failed + check("path_payload_branch", false); }
    }
    return failed;
}

fn main() -> i32 {
    var failed: i32 = 0;
    print("--- (1) Result multi-? + map_err ---");
    failed = failed + test_propagation();
    print("--- (2) Option chain ---");
    failed = failed + test_option_chain();
    print("--- (3) try (?) in expression ---");
    failed = failed + test_try_in_expression();
    print("--- (4) match exhaustive + guard ---");
    failed = failed + test_match_guard();
    print("--- (5) nested match Result<Option<T>,E> ---");
    failed = failed + test_nested_match();
    print("--- (6) early return/break/continue + defer ---");
    failed = failed + test_defer_replay();
    print("--- (7) fail variant ownership paths ---");
    failed = failed + test_fail_paths();

    if (failed == 0) {
        print("All error_flow tests passed.");
        return 0;
    }
    print("${failed} test(s) failed.");
    return 1;
}
