module test_inherited_struct_init_tail_fields;

use std.string;

interface BaseIface {
    fn id() -> string;
}

class BaseComponent : BaseIface {
    public component_id: string;

    public fn id() -> string {
        return self.component_id;
    }
}

class StatelessComponent : BaseComponent {
}

class EntryComponent : StatelessComponent {
    public input_resource: string;
    public input_set_action: string;
    public add_action: string;

    public static fn create(input_resource: string, input_set_action: string, add_action: string) -> EntryComponent {
        return EntryComponent {
            component_id: "entry",
            input_resource: input_resource,
            input_set_action: input_set_action,
            add_action: add_action
        };
    }

    public fn build() -> string {
        let input = "input=" + self.input_resource;
        let set = "set=" + self.input_set_action;
        if (input != "input=tasks.input") { return "bad-input"; }
        if (set != "set=tasks.input.set") { return "bad-set"; }
        return self.add_action;
    }
}

fn main() -> i32 {
    let entry = EntryComponent.create("tasks.input", "tasks.input.set", "tasks.add");
    if (entry.component_id != "entry") { return 1; }
    if (entry.input_resource != "tasks.input") { return 2; }
    if (entry.input_set_action != "tasks.input.set") { return 3; }
    if (entry.add_action != "tasks.add") { return 4; }
    if (EntryComponent.create("tasks.input", "tasks.input.set", "tasks.add").build() != "tasks.add") { return 5; }
    return 0;
}
