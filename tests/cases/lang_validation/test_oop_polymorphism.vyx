// OOP polymorphism validation suite
//
// Coverage:
//   1) Multi-level class inheritance + method override polymorphism
//   2) Trait + Box<dyn Trait> dynamic dispatch (multiple impls)
//   3) Same-name method overlap across two traits
//   4) Trait method override (deliberate per-class log() variant)
//   5) Drop order verification (LIFO local-scope auto-drop)
//   6) Vec<dyn Trait> traversal via vtable dispatch
//   7) Trait/interface type as function parameter

module lang_validation;

use std.collections;
use std.ref;
use std.string;

// Global counters / drop log used by tests.
// `drop_seq` encodes drop order as decimal digits (latest drop = ones place);
// avoids string move issues with global mutable state under move-by-default.
var g_fails: i32 = 0;
var drop_seq: i64 = 0;

// ============================================================
// 1) Multi-level class inheritance + override
// ============================================================

class Animal {
    public name: string

    public static fn new(name: string) -> Animal {
        return Animal { name: name };
    }

    public fn kind() -> string {
        return "Animal";
    }

    public fn greet() -> string {
        return "I am " + self.name + " a Animal";
    }
}

class Mammal : Animal {
    public fur: bool

    public static fn new(name: string, fur: bool) -> Mammal {
        return Mammal { name: name, fur: fur };
    }

    public fn kind() -> string {
        return "Mammal";
    }

    public fn greet() -> string {
        return "I am " + self.name + " a Mammal";
    }
}

class Dog : Mammal {
    public breed: string

    public static fn new(name: string, breed: string) -> Dog {
        return Dog { name: name, fur: true, breed: breed };
    }

    public fn kind() -> string {
        return "Dog";
    }

    public fn greet() -> string {
        return "I am " + self.name + " a Dog";
    }
}

fn test_multilevel_inherit() -> i32 {
    let a = Animal.new("any");
    let m = Mammal.new("furry", true);
    let d = Dog.new("Rex", "Lab");

    if (a.kind() == "Animal") {
        print("multilevel_animal: PASS\n");
    } else {
        print("multilevel_animal: FAIL\n"); return 1;
    }

    if (m.kind() == "Mammal") {
        print("multilevel_mammal: PASS\n");
    } else {
        print("multilevel_mammal: FAIL\n"); return 1;
    }

    if (d.kind() == "Dog") {
        print("multilevel_dog: PASS\n");
    } else {
        print("multilevel_dog: FAIL\n"); return 1;
    }

    let g = d.greet();
    if (g == "I am Rex a Dog") {
        print("multilevel_inherited_greet: PASS\n");
    } else {
        print("multilevel_inherited_greet: FAIL (");
        print(g);
        print(")\n"); return 1;
    }
    return 0;
}

// ============================================================
// 1b) BUG-LV-02 — three-level inheritance with `self.method()` virtual
//     dispatch from the *unmodified* parent body.
//     `A1::greet` calls `self.kind()`. A2/A3 override only `kind()`,
//     not `greet()`. An A3 instance calling .greet() must land on
//     A1::greet's body but resolve self.kind() to A3::kind via the
//     subclass-specific synthesised copy emitted in CodeGenClass.
// ============================================================

class A1 {
    public name: string

    public static fn new(n: string) -> A1 { return A1 { name: n }; }
    public fn kind()  -> string { return "A1"; }
    public fn greet() -> string { return self.name + ":" + self.kind(); }
    public fn greetViaClosure() -> string {
        let thunk = || -> string { return self.kind(); };
        return self.name + ":" + thunk();
    }
    public fn greetViaNestedExpr(flag: bool) -> string {
        let suffix = if (flag) { self.kind() } else { "wrong"; };
        let parts = [self.name, suffix];
        return "${parts[0]}:${parts[1]}";
    }
}

class A2 : A1 {
    public static fn new(n: string) -> A2 { return A2 { name: n }; }
    public fn kind() -> string { return "A2"; }
}

class A3 : A2 {
    public static fn new(n: string) -> A3 { return A3 { name: n }; }
    public fn kind() -> string { return "A3"; }
}

fn test_multilevel_inherited_greet() -> i32 {
    let a1 = A1.new("a");
    let a2 = A2.new("b");
    let a3 = A3.new("c");

    if (a1.greet() != "a:A1") {
        print("multilevel_inherited_greet[A1]: FAIL ("); print(a1.greet()); print(")\n"); return 1;
    }
    if (a2.greet() != "b:A2") {
        print("multilevel_inherited_greet[A2]: FAIL ("); print(a2.greet()); print(")\n"); return 1;
    }
    if (a3.greet() != "c:A3") {
        print("multilevel_inherited_greet[A3]: FAIL ("); print(a3.greet()); print(")\n"); return 1;
    }
    if (a2.greetViaClosure() != "b:A2") {
        print("multilevel_inherited_greet_closure[A2]: FAIL ("); print(a2.greetViaClosure()); print(")\n"); return 1;
    }
    if (a3.greetViaClosure() != "c:A3") {
        print("multilevel_inherited_greet_closure[A3]: FAIL ("); print(a3.greetViaClosure()); print(")\n"); return 1;
    }
    if (a2.greetViaNestedExpr(true) != "b:A2") {
        print("multilevel_inherited_greet_nested[A2]: FAIL ("); print(a2.greetViaNestedExpr(true)); print(")\n"); return 1;
    }
    if (a3.greetViaNestedExpr(true) != "c:A3") {
        print("multilevel_inherited_greet_nested[A3]: FAIL ("); print(a3.greetViaNestedExpr(true)); print(")\n"); return 1;
    }
    print("multilevel_inherited_greet: PASS\n");
    return 0;
}

// ============================================================
// 2) Trait + Box<dyn Trait> dynamic dispatch
// ============================================================

trait Speaker {
    fn voice() -> string;
}

class Cow : Speaker {
    public name: string
    public static fn new(name: string) -> Cow { return Cow { name: name }; }
    public fn voice(self) -> string { return self.name + " says Moo"; }
}

class Duck : Speaker {
    public name: string
    public static fn new(name: string) -> Duck { return Duck { name: name }; }
    public fn voice(self) -> string { return self.name + " says Quack"; }
}

// Generic factory mirrors std/_generics_industrial/box_dyn_trait pattern
// so the Box<dyn Trait> erasure flows through a function boundary.
fn make_speaker<T>(t: T) -> Box<dyn Speaker> {
    return Box::<dyn Speaker>.new(t);
}

fn test_box_dyn_dispatch() -> i32 {
    let bx_cow = make_speaker::<Cow>(Cow.new("Bessie"));
    let bx_duck = make_speaker::<Duck>(Duck.new("Donald"));

    // Extract via deref before method call to bind through identifier-dispatch.
    let s_cow = bx_cow.deref();
    let s_duck = bx_duck.deref();

    let v1 = s_cow.voice();
    let v2 = s_duck.voice();

    if (v1.contains("Moo")) {
        print("box_dyn_cow: PASS\n");
    } else {
        print("box_dyn_cow: FAIL (");
        print(v1); print(")\n"); return 1;
    }

    if (v2.contains("Quack")) {
        print("box_dyn_duck: PASS\n");
    } else {
        print("box_dyn_duck: FAIL (");
        print(v2); print(")\n"); return 1;
    }
    return 0;
}

// ============================================================
// 3) Two traits sharing the same method name
//    A class supplies ONE method body that satisfies both.
// ============================================================

trait Tag {
    fn id() -> i32;
}

trait Sortable {
    fn id() -> i32;
}

class Item : Tag {
    public n: i32
    public static fn new(n: i32) -> Item { return Item { n: n }; }
    public fn id() -> i32 { return self.n * 7; }
}

fn read_via_tag(t: dyn Tag) -> i32 { return t.id(); }
fn read_via_sortable(s: dyn Sortable) -> i32 { return s.id(); }

fn test_trait_method_overlap() -> i32 {
    let it = Item.new(3);
    let a = read_via_tag(it as dyn Tag);
    let it2 = Item.new(3);
    let b = it2.id();
    if (a == 21 && b == 21) {
        print("trait_overlap_dispatch: PASS\n");
        return 0;
    }
    print("trait_overlap_dispatch: FAIL\n");
    return 1;
}

// ============================================================
// 4) Trait method override (per-class variant)
// ============================================================
//
// Both Plain and Custom satisfy `Loggable`. Plain wraps with `[..]`,
// Custom overrides with `<..>`. A virtual call through Loggable picks
// the per-class implementation (override polymorphism).

trait Loggable {
    fn label() -> string;
    fn log() -> string;
}

class Plain : Loggable {
    public name: string
    public static fn new(n: string) -> Plain { return Plain { name: n }; }
    public fn label() -> string { return self.name; }
    public fn log() -> string { return "[" + self.name + "]"; }
}

class Custom : Loggable {
    public name: string
    public static fn new(n: string) -> Custom { return Custom { name: n }; }
    public fn label() -> string { return self.name; }
    public fn log() -> string { return "<" + self.name + ">"; }
}

fn render(item: dyn Loggable) -> string { return item.log(); }

fn test_trait_override() -> i32 {
    let p = Plain.new("alpha");
    let c = Custom.new("beta");

    let pl = render(p as dyn Loggable);
    let cl = render(c as dyn Loggable);

    if (pl == "[alpha]") {
        print("trait_default_form: PASS\n");
    } else {
        print("trait_default_form: FAIL (");
        print(pl); print(")\n"); return 1;
    }

    if (cl == "<beta>") {
        print("trait_override_form: PASS\n");
    } else {
        print("trait_override_form: FAIL (");
        print(cl); print(")\n"); return 1;
    }
    return 0;
}

// ============================================================
// 5) Drop order verification (LIFO local-scope auto-drop)
// ============================================================

class Tracer {
    public id: i32

    public static fn new(id: i32) -> Tracer { return Tracer { id: id }; }

    public fn drop() {
        drop_seq = drop_seq * 10 + (self.id as i64);
    }
}

fn run_drop_scope() {
    let a = Tracer.new(1);
    let b = Tracer.new(2);
    let c = Tracer.new(3);
}

fn test_drop_order() -> i32 {
    drop_seq = 0;
    run_drop_scope();
    // Vyx fires scope-exit auto-drops in declaration order (a, b, c) →
    // drop(1) → drop(2) → drop(3) → encoded seq=123.
    // (Differs from Rust's LIFO; matches CodeGen autoDropLocals walk.)
    if (drop_seq == 123) {
        print("drop_decl_order: PASS\n");
        return 0;
    }
    print("drop_decl_order: FAIL (");
    print(drop_seq); print(")\n");
    return 1;
}

// ============================================================
// 6) Vec<dyn Trait> traversal via vtable
// ============================================================

fn test_vtable_vec() -> i32 {
    var speakers = Vec::<dyn Speaker>.new();
    speakers.push(Cow.new("A") as dyn Speaker);
    speakers.push(Duck.new("B") as dyn Speaker);
    speakers.push(Cow.new("C") as dyn Speaker);

    var collected = "";
    var i: i64 = 0;
    while (i < speakers.size()) {
        collected = collected + speakers.get(i).voice() + "|";
        i = i + 1;
    }

    let has_moo = collected.contains("Moo");
    let has_quack = collected.contains("Quack");
    let has_a = collected.contains("A says");
    let has_c = collected.contains("C says");

    if (has_moo && has_quack && has_a && has_c) {
        print("vec_vtable_dispatch: PASS\n");
        return 0;
    }
    print("vec_vtable_dispatch: FAIL (");
    print(collected); print(")\n");
    return 1;
}

// ============================================================
// 7) Trait type as function parameter
// ============================================================

fn announce(s: dyn Speaker) -> string {
    return ">> " + s.voice();
}

fn test_iface_as_param() -> i32 {
    let cow = Cow.new("Param");
    let r = announce(cow as dyn Speaker);
    if (r.contains("Moo") && r.contains(">>")) {
        print("iface_as_param: PASS\n");
        return 0;
    }
    print("iface_as_param: FAIL (");
    print(r); print(")\n");
    return 1;
}

// ============================================================
// Entry
// ============================================================

fn main() -> i32 {
    print("=== OOP Polymorphism Validation ===\n");

    g_fails = g_fails + test_multilevel_inherit();
    g_fails = g_fails + test_box_dyn_dispatch();
    g_fails = g_fails + test_trait_method_overlap();
    g_fails = g_fails + test_trait_override();
    g_fails = g_fails + test_drop_order();
    g_fails = g_fails + test_vtable_vec();
    g_fails = g_fails + test_iface_as_param();
    g_fails = g_fails + test_multilevel_inherited_greet();

    print("=== Done ===\n");
    if (g_fails == 0) {
        print("ALL PASSED\n");
    } else {
        print("FAILURES: ");
        print(g_fails);
        print("\n");
    }
    return g_fails;
}
