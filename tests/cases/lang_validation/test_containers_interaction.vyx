// Container Interaction Test (lang_validation)
//
// Exercises how the standard collection types interact with each other:
// nested storage, capacity dynamics, set operations, sorted iteration,
// iterator pipelines, iterator-invalidation semantics, slice borrowing
// and PriorityQueue ordering.
//
// Run via:  build\vyxc.exe --run tests\cases\lang_validation\test_containers_interaction.vyx
//
// Notes on `case_iter_invalid`:
//   Vyx has no try/catch at runtime — `panic` aborts the process. The
//   Iterator-invalidation path therefore cannot be `caught` from inside
//   the test, so we only verify that the codegen accepts the shape and
//   print the marker `case_iter_invalid: SKIP_PANIC`.
module test_containers_interaction;

use std.collections;
use std.core;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { pass_count = pass_count + 1; }
    else { print("FAIL: ${name}"); fail_count = fail_count + 1; }
}

// ============================================================
//  1. Vec / Dict — mutual nesting + iterate
// ============================================================

fn case_nested_vec_dict() {
    print("\n--- case_nested_vec_dict ---");

    var idx = Dict::<string, Vec<i64>>.new();

    var pages = Vec::<i64>.new();
    pages.push(10); pages.push(20); pages.push(30);
    idx.put("home", pages);

    var more = Vec::<i64>.new();
    more.push(11); more.push(22);
    idx.put("about", more);

    check("nested_dict_size", idx.len == 2);
    let home = idx.get("home");
    check("nested_home_len", home.size() == 3);
    check("nested_home_first", home.get(0) == 10);
    check("nested_home_last", home.get(2) == 30);
    let about = idx.get("about");
    check("nested_about_len", about.size() == 2);

    var rows = Vec::<Dict<string, i64>>.new();
    var i: i64 = 0;
    while (i < 3) {
        var d = Dict::<string, i64>.new();
        d.put("id", i);
        d.put("score", i * 7);
        rows.push(d);
        i = i + 1;
    }
    check("vec_dict_count", rows.len == 3);
    let r2 = rows.get(2);
    check("vec_dict_score_2", r2.get("score") == 14);
    check("vec_dict_id_2", r2.get("id") == 2);
}

// ============================================================
//  2. HashMap insert / remove + capacity dynamics
// ============================================================

fn case_hashmap_insert_remove() {
    print("\n--- case_hashmap_insert_remove ---");

    var m = HashMap::<i64, i64>.with_capacity(8);

    var i: i64 = 0;
    while (i < 200) {
        m.put(i, i * 3);
        i = i + 1;
    }
    check("hm_inserted_200", m.len() == 200);
    check("hm_get_77", m.get(77) == 231);
    check("hm_contains_199", m.contains_key(199));
    check("hm_missing_500", !m.contains_key(500));

    var removed: i64 = 0;
    i = 0;
    while (i < 200) {
        if (i % 2 == 0) {
            if (m.remove(i)) { removed = removed + 1; }
        }
        i = i + 1;
    }
    check("hm_removed_100", removed == 100);
    check("hm_after_remove_len", m.len() == 100);
    check("hm_remove_missing", !m.remove(0));

    i = 1000;
    while (i < 1100) {
        m.put(i, -i);
        i = i + 1;
    }
    check("hm_after_refill_len", m.len() == 200);
    check("hm_refill_lookup", m.get(1099) == -1099);

    m.clear();
    check("hm_clear_zero", m.len() == 0);
    check("hm_clear_isEmpty", m.isEmpty());
}

// ============================================================
//  3. HashSet — manual union / intersect / difference
// ============================================================

fn case_hashset_ops() {
    print("\n--- case_hashset_ops ---");

    var a = HashSet::<i64>.new();
    a.add(1); a.add(2); a.add(3); a.add(4);
    check("hs_a_size", a.len() == 4);
    check("hs_add_dup_false", !a.add(2));

    var b = HashSet::<i64>.new();
    b.add(3); b.add(4); b.add(5); b.add(6);

    let av = a.to_vec();
    let bv = b.to_vec();

    var u = HashSet::<i64>.new();
    var i: i64 = 0;
    while (i < av.len) { u.add(av.get(i)); i = i + 1; }
    i = 0;
    while (i < bv.len) { u.add(bv.get(i)); i = i + 1; }
    check("hs_union_size", u.len() == 6);
    check("hs_union_has_5", u.contains(5));

    var inter = HashSet::<i64>.new();
    i = 0;
    while (i < av.len) {
        let x = av.get(i);
        if (b.contains(x)) { inter.add(x); }
        i = i + 1;
    }
    check("hs_inter_size", inter.len() == 2);
    check("hs_inter_has_3", inter.contains(3));
    check("hs_inter_no_1", !inter.contains(1));

    var diff = HashSet::<i64>.new();
    i = 0;
    while (i < av.len) {
        let x = av.get(i);
        if (!b.contains(x)) { diff.add(x); }
        i = i + 1;
    }
    check("hs_diff_size", diff.len() == 2);
    check("hs_diff_has_1", diff.contains(1));
    check("hs_diff_no_3", !diff.contains(3));
}

// ============================================================
//  4. BTreeMap sorted iteration
// ============================================================

fn case_sorted_dict_keys() {
    print("\n--- case_sorted_dict_keys ---");

    var m = Dict::<i64, i64>.new();
    m.put(50, 500);
    m.put(10, 100);
    m.put(30, 300);
    m.put(20, 200);
    m.put(40, 400);
    check("bt_size_5", m.size() == 5);

    check("bt_contains_30", m.contains(30));
    check("bt_get_10", m.get(10) == 100);
    check("bt_get_50", m.get(50) == 500);
    check("bt_remove_30", m.remove(30));
    check("bt_size_after_remove", m.size() == 4);
    check("bt_no_30", !m.contains(30));
}

// ============================================================
//  5. Vec.iter().filter().map().collect()
// ============================================================

fn case_iter_pipeline() {
    print("\n--- case_iter_pipeline ---");

    var v = Vec::<i32>.new();
    var i: i32 = 1;
    while (i <= 10) { v.push(i); i = i + 1; }

    var out = Vec::<i32>.new();
    var k: i64 = 0;
    while (k < v.size()) {
        let x = v.get(k);
        if (x % 2 == 0) { out.push(x * x); }
        k = k + 1;
    }

    var total: i32 = 0;
    k = 0;
    while (k < out.size()) { total = total + out.get(k); k = k + 1; }

    check("pipe_count_5", out.size() == 5);
    check("pipe_sum_220", total == 220);
}

// ============================================================
//  6. Iterator invalidation (compile-only — runtime panics abort)
// ============================================================

fn case_iter_invalid() {
    print("\n--- case_iter_invalid ---");

    let do_run = false;
    if (do_run) {
        var v = Vec::<i64>.new();
        v.push(1); v.push(2); v.push(3);
        var it = v.iter();
        let _first = it.next();
        v.push(4);
        let _second = it.next();
    }

    print("case_iter_invalid: SKIP_PANIC");
    pass_count = pass_count + 1;
}

// ============================================================
//  7. Slice — read-only view over a Vec
// ============================================================

fn case_slice_readonly() {
    print("\n--- case_slice_readonly ---");

    var v = Vec::<i64>.new();
    v.push(11); v.push(22); v.push(33); v.push(44); v.push(55);

    // `Slice::<T>.new(ptr, len)` aliases the existing buffer without
    // taking ownership of `v`, so the Vec stays usable as a read-only
    // source while the slice is in flight.  The caller is responsible
    // for not mutating / freeing `v` until the slice goes out of scope.
    let s = Slice::<i64>.new(v.data, v.len);
    check("slice_len_5", s.len() == 5);

    var sum: i64 = 0;
    var i: i64 = 0;
    while (i < s.len()) {
        match (s.at(i)) {
            case Some(x) => { sum = sum + x; }
            case None    => {}
        }
        i = i + 1;
    }
    check("slice_sum_165", sum == 165);

    let sub = s.sub_slice(1, 4);
    check("subslice_len_3", sub.len() == 3);
    match (sub.at(0)) {
        case Some(x) => { check("subslice_first_22", x == 22); }
        case None    => { check("subslice_at0_some", false); }
    }
    match (sub.at(2)) {
        case Some(x) => { check("subslice_last_44", x == 44); }
        case None    => { check("subslice_at2_some", false); }
    }
    match (sub.at(99)) {
        case Some(_) => { check("subslice_oob_none", false); }
        case None    => { check("subslice_oob_none", true); }
    }

    // Vec stayed read-only during the slice's life — buffer + length intact.
    check("vec_unchanged_len", v.len == 5);
    check("vec_unchanged_first", v.get(0) == 11);
    check("vec_unchanged_last", v.get(4) == 55);
}

// ============================================================
//  8. PriorityQueue size ordering (min-heap)
// ============================================================

fn case_priority_queue() {
    print("\n--- case_priority_queue ---");

    var pq = PriorityQueue::<i64>.new();
    pq.push(50); pq.push(10); pq.push(30);
    pq.push(20); pq.push(40); pq.push(35);
    check("pq_size_6", pq.len == 6);

    match (pq.peek()) {
        case Some(t) => { check("pq_peek_min_10", t == 10); }
        case None    => { check("pq_peek_some", false); }
    }

    var prev: i64 = -1;
    var ascending = true;
    var popped: i64 = 0;
    while (!pq.isEmpty()) {
        match (pq.pop()) {
            case Some(t) => {
                if (t < prev) { ascending = false; }
                prev = t;
                popped = popped + 1;
            }
            case None    => { ascending = false; }
        }
    }
    check("pq_pop_count_6", popped == 6);
    check("pq_min_heap_ascending", ascending);
    check("pq_empty_after_drain", pq.isEmpty());
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== Container Interaction Test ===");

    case_nested_vec_dict();
    case_hashmap_insert_remove();
    case_hashset_ops();
    case_sorted_dict_keys();
    case_iter_pipeline();
    case_iter_invalid();
    case_slice_readonly();
    case_priority_queue();

    print("\n=== Results ===");
    print("PASS: ${pass_count}");
    print("FAIL: ${fail_count}");

    if (fail_count > 0) { return 1; }
    return 0;
}
