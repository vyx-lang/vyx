module lang_validation;

use std.collections;

class Item {
    public value: i32;

    public static fn create(value: i32) -> Item {
        return Item { value: value };
    }

    public fn clone() -> Item {
        return Item { value: self.value };
    }
}

class Row {
    public items: Vec<Item>;

    public static fn create() -> Row {
        return Row { items: Vec::<Item>.new() };
    }

    @[borrow_args]
    public fn children(items: Vec<Item>) -> Row {
        var i: i32 = 0;
        while (i < (items.len as i32)) {
            self.items.push(items.get(i as i64).clone());
            i = i + 1;
        }
        return self;
    }

    public fn count() -> i32 {
        return self.items.len as i32;
    }

    public fn total() -> i32 {
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < (self.items.len as i32)) {
            out = out + self.items.get(i as i64).value;
            i = i + 1;
        }
        return out;
    }

    public fn destroy() {
        self.items.destroy();
    }
}

fn main() -> i32 {
    var children = Vec::<Item>.new();
    children.push(Item.create(1));
    children.push(Item.create(2));
    children.push(Item.create(3));
    children.push(Item.create(4));
    var row = Row.create().children(children);
    if (row.count() != 4) { row.destroy(); children.destroy(); return 1; }
    if (row.total() != 10) { row.destroy(); children.destroy(); return 2; }
    row.destroy();
    children.destroy();
    return 0;
}
