use std.collections;

fn bare_twice(x: i64) -> i64 { return x * 2; }
fn bare_plus_one(x: i64) -> i64 { return x + 1; }

fn main() -> i32 {
    let base: i64 = 5;
    let factor: i64 = 3;
    let offset: i64 = 9;
    let add_base = [base](x: i64) => x + base;
    let mul_factor = [factor](x: i64) => x * factor;
    let add_offset = [offset](x: i64) => x + offset;
    let alias: fn(i64) -> i64 = bare_plus_one;

    var fns = Vec::<fn(i64) -> i64>.new();
    fns.push(add_base);
    fns.push(mul_factor);
    fns.push(bare_twice);
    fns.push_unchecked(bare_plus_one);

    fns.set(1, add_offset);
    fns.set_unchecked(2, bare_twice);

    let f0 = fns.get(0);
    let f2 = fns.get(2);

    let r0 = f0(10);
    let r1 = fns.get(1)(4);
    let r2 = f2(7);
    let r3 = fns.get_unchecked(3)(8);
    let r4 = fns.pop()(20);

    fns.push(alias);
    let r5 = fns.pop()(30);

    fns.insert(1, bare_plus_one);
    let f_first = fns.first();
    let f_last = fns.last();
    let f_removed = fns.remove(1);
    let f_removed_at = fns.removeAt(1);

    let r6 = f_first(3);
    let r7 = f_last(6);
    let r8 = f_removed(10);
    let r9 = f_removed_at(1);
    let r10 = fns.last()(5);

    let opt_bare = Option::<fn(i64) -> i64>.some(bare_plus_one);
    let opt_closure = Option::<fn(i64) -> i64>.some(add_base);
    let f_opt_bare = opt_bare.unwrap();
    let f_opt_closure = opt_closure.unwrap();
    let f_opt_typed: fn(i64) -> i64 = opt_bare.unwrap();

    let r11 = f_opt_bare(40);
    let r12 = f_opt_closure(2);
    let r13 = f_opt_typed(50);

    if (r0 != 15) { return 1 as i32; }
    if (r1 != 13) { return 2 as i32; }
    if (r2 != 14) { return 3 as i32; }
    if (r3 != 9) { return 4 as i32; }
    if (r4 != 21) { return 5 as i32; }
    if (r5 != 31) { return 6 as i32; }
    if (r6 != 8) { return 7 as i32; }
    if (r7 != 12) { return 8 as i32; }
    if (r8 != 11) { return 9 as i32; }
    if (r9 != 10) { return 10 as i32; }
    if (r10 != 10) { return 11 as i32; }
    if (r11 != 41) { return 12 as i32; }
    if (r12 != 7) { return 13 as i32; }
    if (r13 != 51) { return 14 as i32; }
    return 0 as i32;
}
