use std.string;

fn scalar_read_loop(n: i64) -> i64 {
    var hits: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        let token = "key-${i}";
        let first = token.charAt(0);
        let has_key = token.startsWith("key-");
        if (first == 'k' && has_key) { hits = hits + 1; }
        i = i + 1;
    }
    return hits;
}

fn fresh_transform_loop(n: i64) -> i64 {
    var hits: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        let raw = "AbC-${i}-zZ";
        let upper = raw.toUpper();
        let lower = upper.toLower();
        if (raw.startsWith("AbC-") && upper.contains("ABC") && lower.endsWith("zz")) {
            hits = hits + 1;
        }
        i = i + 1;
    }
    return hits;
}

fn assignment_copy_loop(n: i64) -> i64 {
    var out = "";
    var i: i64 = 0;
    while (i < n) {
        let piece = "x${i}";
        out = out + piece;
        i = i + 1;
    }
    if (out.startsWith("x0") && out.len > n) { return 1; }
    return 0;
}

fn direct_alias_stays_borrowed() -> i64 {
    let owner = "Owned alias".toUpper();
    let alias = owner;
    if (alias != "OWNED ALIAS" || owner != "OWNED ALIAS") { return 0; }
    str_drop(owner);
    return 1;
}

fn main() -> i32 {
    if (scalar_read_loop(200000) != 200000) { return 1; }
    if (fresh_transform_loop(200000) != 200000) { return 2; }
    if (assignment_copy_loop(20000) != 1) { return 3; }
    if (direct_alias_stays_borrowed() != 1) { return 4; }
    return 0;
}
