use std.string;

fn main() -> i32 {
    var result = "";
    var i: i64 = 0;
    while (i < 10) {
        if (i % 3 == 0) { result = result + "Fizz,"; }
        elif (i % 5 == 0) { result = result + "Buzz,"; }
        else { result = result + "${i},"; }
        i = i + 1;
    }
    print("result: '${result}'");
    print("contains Fizz: ${result.contains(\"Fizz\")}");
    return 0;
}
