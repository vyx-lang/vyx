// A default `class` is a fully stack value type with the same ABI as `struct`
// and C++ value objects: automatic storage, by-value return, inline nested
// subobjects, and pointer-to-object method receivers.  The only heap path is
// an explicit `new` (released by `delete`).
//
// This case locks the value ABI against every former "class always heap"
// fallback.  The companion IR check
// (tests/checks/memory/class_value_abi.ps1) asserts each value function below
// never calls vyx_class_alloc_abi/malloc, while `heap_new` still allocates,
// across O0/O2 and JIT/AOT (and MIR2CPP unless skipped).

class Pt {
    public x: i64;
    public y: i64;
    // Constructor builds into the receiver record and returns it by value.
    Pt(a: i64, b: i64) { self.x = a; self.y = b; }
    public fn sum() -> i64 { return self.x + self.y; }
}

struct Dim {
    public w: i64;
    public h: i64;
}

class Inner {
    public a: i64;
    public b: i64;
}

// Nested class field stored inline (not a boxed inner pointer), plus a mixed
// scalar + nested struct + nested class layout.
class Shape {
    public dim: Dim;
    public origin: Inner;
    public scale: i64;
    public fn area() -> i64 {
        return self.dim.w * self.dim.h * self.scale + self.origin.a + self.origin.b;
    }
}

class Wrap<T> {
    public v: T;
    Wrap(val: T) { self.v = val; }
    public fn get() -> T { return self.v; }
}

// (1) `Foo { ... }.method()` on a temporary literal.
@[noinline]
fn temp_literal_method() -> i64 {
    return Pt { x: 5, y: 6 }.sum();
}

// (1) `let x = Foo { ... }; x.method()` on a named local.
@[noinline]
fn local_literal_method() -> i64 {
    let p = Pt { x: 7, y: 8 };
    return p.sum();
}

// (2) `fn make() -> Foo { Foo { ... } }` — by-value return of a literal.
@[noinline]
fn make_value() -> Pt {
    return Pt { x: 100, y: 1 };
}

// (2) Named return: `let x = Foo { ... }; return x;`.
@[noinline]
fn named_return(seed: i64) -> Pt {
    let p = Pt { x: seed, y: seed + 2 };
    return p;
}

// (3) Constructed inside if/else — not in the entry block.
@[noinline]
fn cond_ctor(sel: i64) -> i64 {
    var r: i64 = 0;
    if (sel > 0) {
        let p = Pt(sel, sel + 1);
        r = p.sum();
    } else {
        let p = Pt(9, 9);
        r = p.sum();
    }
    return r;
}

// (3) Constructed inside match arms.
@[noinline]
fn match_ctor(sel: i64) -> i64 {
    var r: i64 = 0;
    match (sel) {
        case 0 => { let p = Pt { x: 1, y: 2 }; r = p.sum(); }
        default => { let p = Pt { x: 7, y: 8 }; r = p.sum(); }
    }
    return r;
}

// (3) Constructed inside a loop body.
@[noinline]
fn loop_ctor(iters: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < iters) {
        let p = Pt { x: i, y: i + 1 };
        total = total + p.sum();
        i = i + 1;
    }
    return total;
}

// (4)/(5) Inline nested class field + mixed scalar/struct/class layout.
@[noinline]
fn nested_mixed() -> i64 {
    let s = Shape {
        dim: Dim { w: 3, h: 4 },
        origin: Inner { a: 1, b: 1 },
        scale: 2,
    };
    return s.area();
}

// (6) Generic class constructor + local.
@[noinline]
fn generic_ctor() -> i64 {
    let w = Wrap<i64>(77);
    return w.get();
}

// (7) Uninitialized `var x: Foo;` then field-wise initialization.
@[noinline]
fn uninit_then_init(a: i64) -> i64 {
    var p: Pt;
    p.x = a;
    p.y = a * 3;
    return p.x + p.y;
}

// (8) Explicit `new` stays heap; `delete` releases it.
@[noinline]
fn heap_new(seed: i64) -> i64 {
    let p = new Pt { x: seed, y: seed + 7 };
    let r = p.sum();
    delete p;
    return r;
}

fn main() -> i32 {
    if (temp_literal_method() != 11) { return 1; }
    if (local_literal_method() != 15) { return 2; }
    if (make_value().sum() != 101) { return 3; }
    if (named_return(5).sum() != 12) { return 4; }
    if (cond_ctor(5) != 11) { return 5; }
    if (cond_ctor(-1) != 18) { return 6; }
    if (match_ctor(0) != 3) { return 7; }
    if (match_ctor(9) != 15) { return 8; }
    if (loop_ctor(4) != 16) { return 9; }
    if (nested_mixed() != 26) { return 10; }
    if (generic_ctor() != 77) { return 11; }
    if (uninit_then_init(4) != 16) { return 12; }
    if (heap_new(5) != 17) { return 13; }
    print("class_value_abi OK");
    return 0;
}
