// RUNTIME-NEGATIVE: awaiting a Promise rejected by another worker must terminate.
use std.vio;

var g_pending: Promise<i32>;

fn reject_worker(ctx: rawptr) -> i32 {
    vio_sleep(5);
    g_pending.reject(99);
    return 0;
}

fn main() -> i32 {
    g_pending = Promise::<i32>.new();
    let rc = vio_run(reject_worker as i64);
    if (rc != 0) { return 10; }
    let value = await g_pending;
    print(value);
    return 0;
}
