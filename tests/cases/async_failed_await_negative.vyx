// RUNTIME-NEGATIVE: awaiting a rejected Promise/Task must terminate instead of
// returning an invented value.
use std.vio;

fn main() -> i32 {
    let failed = Task::<i32>.failed(42);
    if (!failed.is_done()) { return 10; }
    if (!failed.is_failed()) { return 11; }
    if (failed.error_code() != 42) { return 12; }
    let value = await failed;
    print(value);
    return 0;
}
