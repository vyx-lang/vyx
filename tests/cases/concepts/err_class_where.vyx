// P2-C1: negative sample — class template with `where T: Trait`.
// Bad does not implement Greetable; Cache<Bad> instantiation should fail.
// Expected: error[P2C-001] "Bad' does not satisfy constraint 'Greetable'".

interface Greetable {
    fn greet() -> i32;
}

struct Bad {
    n: i32
}

class Cache<T> where T: Greetable {
    public item: T
}

fn main() -> i32 {
    let b = Bad { n: 0 };
    var holder: Cache<Bad>;
    holder = Cache::<Bad> { item: b };
    return holder.item.n;
}
