// P2-C1: positive sample combining `where T: Trait` on a struct template
// with a concrete instantiation that satisfies the trait.
// Int implements Comparable; Pair<Int> instantiation passes the where check.

interface Comparable {
    fn cmp_int(other: i32) -> i32;
}

struct Int {
    v: i32
}

impl Int {
    fn cmp_int(other: i32) -> i32 {
        return self.v - other;
    }
}

struct Holder<T> where T: Comparable {
    item: T
}

fn main() -> i32 {
    let x = Int { v: 0 };
    let h = Holder::<Int> { item: x };
    return h.item.cmp_int(0);
}
