// P2-C1: positive sample for `where T: Trait` on a struct template.
// Two distinct concrete types both satisfy Comparable; instantiation passes.

interface Comparable {
    fn cmp_int(other: i32) -> i32;
}

struct A {
    v: i32
}

impl A {
    fn cmp_int(other: i32) -> i32 {
        return self.v - other;
    }
}

struct B {
    v: i32
}

impl B {
    fn cmp_int(other: i32) -> i32 {
        return self.v - other;
    }
}

struct Holder<T> where T: Comparable {
    item: T
}

fn main() -> i32 {
    let a = A { v: 1 };
    let b = B { v: 2 };
    let ha = Holder::<A> { item: a };
    let hb = Holder::<B> { item: b };
    return ha.item.cmp_int(1) + hb.item.cmp_int(2);
}
