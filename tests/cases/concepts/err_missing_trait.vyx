// P2-C1: negative sample — Foo has no `cmp_int` so `T: Comparable` fails.
// Expected: error[P2C-001] "Foo' does not satisfy constraint 'Comparable'".

interface Comparable {
    fn cmp_int(other: i32) -> i32;
}

struct Foo {
    name: i32
}

fn pick<T>(a: T) -> T where T: Comparable {
    return a;
}

fn main() -> i32 {
    let f = Foo { name: 0 };
    let g = pick::<Foo>(f);
    return g.name;
}
