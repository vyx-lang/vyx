fn main() -> i32 {
    let a: i8 = 1i8;
    let b: i16 = 2i16;
    let c: i32 = 3i32;
    let d: i64 = 4i64;
    let e: u8 = 5u8;
    let f: u16 = 6u16;
    let g: u32 = 7u32;
    let h: u64 = 8u64;
    let i: isize = 9isize;
    let u: usize = 10usize;
    let total: i64 = (a as i64) + (b as i64) + (c as i64) + d
        + (e as i64) + (f as i64) + (g as i64) + (h as i64)
        + (i as i64) + (u as i64);
    return (total as i32) - 55;
}
