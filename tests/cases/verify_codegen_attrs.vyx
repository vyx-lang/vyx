module verify_codegen_attrs;

@[inline]
fn attr_inc(x: i32) -> i32 {
    return x + 1;
}

@[noinline]
fn attr_dec(x: i32) -> i32 {
    return x - 1;
}

@[cold]
fn attr_cold(x: i32) -> i32 {
    if (x < 0) { return -x; }
    return x;
}

@[hot]
fn attr_hot(x: i32) -> i32 {
    return x + 2;
}

@[noinline]
fn attr_generic<T>(x: T) -> T {
    return x;
}

@[inline]
@[noinline]
fn attr_noinline_wins(x: i32) -> i32 {
    return x + 3;
}

@[cold]
@[hot]
fn attr_hot_wins(x: i32) -> i32 {
    return x + 4;
}

fn main() -> i32 {
    let a = attr_inc(41);
    let b = attr_dec(43);
    let c = attr_cold(-42);
    let d = attr_hot(40);
    let e = attr_generic::<i32>(42);
    let f = attr_noinline_wins(39);
    let g = attr_hot_wins(38);
    if (a != 42) { return 1; }
    if (b != 42) { return 2; }
    if (c != 42) { return 3; }
    if (d != 42) { return 4; }
    if (e != 42) { return 5; }
    if (f != 42) { return 6; }
    if (g != 42) { return 7; }
    return 0;
}
