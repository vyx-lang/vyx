use std.ref;

fn main() -> i32 {
    let owner = Ref::<i64>.new(7);
    let boxed = Box::<Ref<i64>>.new(owner.clone());
    if (owner.count() != 2) { return 1; }
    boxed.drop();
    if (owner.count() != 1) { return 2; }
    // Explicit drop is idempotent; the scope cleanup must not double free.
    boxed.drop();
    return 0;
}
