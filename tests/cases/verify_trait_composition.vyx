// Verify test for trait composition (supertrait) syntax
// (`trait Num : Add + Sub + ... {}`, 2026-04-23).
//
// Confirms:
//   * `trait Num : Add + Sub + Mul + Div + Zero + One {}` parses and
//     registers every supertrait in traitSupertraits_.
//   * `where T: Num` implicitly carries T: Add / Sub / Mul / Div /
//     Zero / One — Sema walks the supertrait graph, so callers do not
//     need to list the component bounds.
//   * Primitives continue to satisfy the composed trait via their
//     separate supertrait impls (std/ops.vyx + std/num.vyx).
module verify_trait_composition;

use std.core;
use std.collections;
use std.num;
use std.ops;

// Only `where T: Num` — no separately-listed supertraits.  The
// supertrait graph supplies Add (operator_add), Zero (T::zero()),
// and the remaining Sub / Mul / Div / One requirements at check time.
fn generic_sum<T>(xs: Vec<T>) -> T where T: Num {
    var s = T::zero();
    var i: i64 = 0;
    while (i < xs.size()) {
        s = s.operator_add(xs.get(i));
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    let s = generic_sum::<i32>(v);
    if (s != 6) { return 1; }
    return 0;
}
