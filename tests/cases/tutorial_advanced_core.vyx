use std.collections;
use std.ref;
use std.sync;
use std.hash;
use std.clone;
use std.fmt;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

var resource_drops: i32 = 0;

class Resource {
    public id: i32;
    public fn drop() { resource_drops = resource_drops + 1; }
}

@[derive(Eq, Clone, Hashable, Ord, Debug, Display)]
class Pair {
    public x: i64;
    public y: i64;
}

enum Signal {
    Stop,
    Go(i32)
}

trait Shape { fn area(self) -> f64; }
struct Circle { radius: f64; }
struct Square { side: f64; }
impl Shape for Circle {
    fn area(self) -> f64 { return self.radius * self.radius * 3.14159; }
}
impl Shape for Square {
    fn area(self) -> f64 { return self.side * self.side; }
}

fn double(value: i64) -> i64 { return value * 2; }
fn add_ten(value: i64) -> i64 { return value + 10; }

fn main() -> i32 {
    let a = Ref::<i32>.new(10);
    let b = a.clone();
    if (a.deref() != 10 || b.deref() != 10 || a.count() != 2) { return 1; }
    let weak = Weak::<i32>.of(a);
    match (weak.upgrade()) {
        case Some(strong) => {
            if (strong.deref() != 10) { return 16; }
        }
        case None => { return 16; }
    }

    let unique = Box::<i32>.new(7);
    if (unique.deref() != 7) { return 2; }

    var values = Vec::<i32>.new();
    values.push(20);
    values.push(22);
    if (values.get(0) + values.get(1) != 42) { return 3; }
    values.destroy();

    let mutex = Mutex::<i32>.new(0);
    mutex.lock();
    mutex.set(42);
    mutex.unlock();
    if (mutex.get() != 42) { return 4; }
    mutex.destroy();

    let pair = Pair { x: 7, y: 9 };
    if (!pair.clone().operator_eq(pair)) { return 5; }
    if (pair.hash() == 0 || pair.compare(pair) != 0) { return 6; }

    let memory = malloc(8);
    let source: i64 = 42;
    var copied: i64 = 0;
    unsafe { memcpy(memory, to_rawptr(&source), 8); }
    unsafe { memcpy(to_rawptr(&copied), memory, 8); }
    free(memory);
    if (copied != 42) { return 8; }

    {
        let resource = Resource { id: 1 };
        if (resource.id != 1) { return 9; }
    }
    if (resource_drops != 1) { return 10; }

    let circle = Circle { radius: 2.0 };
    if (circle.area() < 12.0 || circle.area() > 13.0) { return 11; }
    var shapes = Vec::<dyn Shape>.new();
    shapes.push(Circle { radius: 2.0 });
    shapes.push(Square { side: 3.0 });
    var shape_total: f64 = 0.0;
    var shape_index: i64 = 0;
    while (shape_index < shapes.size()) {
        shape_total = shape_total + shapes.get(shape_index).area();
        shape_index = shape_index + 1;
    }
    if (shape_total < 21.0 || shape_total > 22.0) { return 12; }
    let piped = 16 |> double() |> add_ten();
    if (piped != 42) { return 13; }
    var selected = 0;
    match (Signal::Go(42)) {
        case Stop => { selected = 1; }
        case Go(value) => { selected = value; }
        default => { selected = -1; }
    }
    if (selected != 42) { return 14; }
    return 0;
}
