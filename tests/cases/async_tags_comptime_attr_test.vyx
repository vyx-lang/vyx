use std.vio;

@[comptime]
fn ct_add(a: i64, b: i64) -> i64 {
    return a + b;
}

@[async]
fn make_ready() -> Task<i64> {
    return Task::<i64>.ready(ct_add(20, 22));
}

public @[task]
fn tagged_task() -> i32 {
    return 7;
}

@[coroutine]
fn tagged_coroutine() -> i32 {
    yield;
    yield WaitForNextTick();
    return 9;
}

@[corountine]
fn tagged_corountine() -> i32 {
    yield;
    yield WaitForNextTick();
    return 10;
}

fn main() -> i32 {
    let ready_task = make_ready();
    let v = await ready_task;
    print("async task value: ");
    print(v);
    print("\n");
    if (v != 42) { return 1; }

    let task_result = await tagged_task();
    print("tagged task value: ");
    print(task_result);
    print("\n");
    if (task_result != 7) { return 2; }

    let coroutine_result = tagged_coroutine();
    print("coroutine value: ");
    print(coroutine_result);
    print("\n");
    if (coroutine_result != 9) { return 3; }

    let corountine_result = tagged_corountine();
    print("corountine alias value: ");
    print(corountine_result);
    print("\n");
    if (corountine_result != 10) { return 4; }

    print("async tags ok\n");
    return 0;
}
