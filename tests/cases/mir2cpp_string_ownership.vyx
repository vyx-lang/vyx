// PROJECT-BUILD-ONLY: exercised through the MIR2CPP path in runtime_memory_attrs.ps1.
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
    fn vyx_alloc_string_len(len: i64) -> rawptr;
    fn vyx_dup_bytes_raw(src: rawptr, len: i64) -> rawptr;
}

fn main() -> i32 {
    let literal = "borrowed";
    if (literal.ptr == null || literal.len != 8 || literal.cap != 0 || literal.owned != 0) {
        return 10;
    }

    let integer_text = int_to_string(42);
    if (integer_text != "42" || integer_text.cap != 3 || integer_text.owned != 2) { return 11; }
    let boolean_text = bool_to_string(true);
    if (boolean_text != "true" || boolean_text.cap != 5 || boolean_text.owned != 2) { return 12; }

    let joined = "ab" + "cd";
    if (joined != "abcd" || joined.ptr == null || joined.cap != 5 || joined.owned != 2) { return 13; }

    let borrowed = from_cstr_view_len(joined.ptr + 1, 2);
    if (borrowed != "bc" || borrowed.cap != 0 || borrowed.owned != 0) { return 14; }
    let copied = from_cstr_len(borrowed.ptr, borrowed.len);
    if (copied != "bc" || copied.cap != 3 || copied.owned != 2) { return 15; }

    let raw_storage = malloc(8);
    if (raw_storage == null) { return 16; }
    memcpy(raw_storage, "xy".ptr, 3);
    let adopted = from_raw_string_parts(raw_storage, 2, 8, 1);
    if (adopted.ptr != raw_storage || adopted != "xy" || adopted.cap != 8 || adopted.owned != 1) {
        return 17;
    }
    str_drop(adopted);

    let empty_upper = "".toUpper();
    if (empty_upper != "" || empty_upper.ptr == null || empty_upper.cap != 1 || empty_upper.owned != 2) { return 18; }
    let empty_lower = "".toLower();
    if (empty_lower != "" || empty_lower.ptr == null || empty_lower.cap != 1 || empty_lower.owned != 2) { return 19; }
    let empty_trimmed = "   ".trim();
    if (empty_trimmed != "" || empty_trimmed.ptr == null || empty_trimmed.cap != 1 || empty_trimmed.owned != 2) { return 20; }
    let empty_replaced = "a".replace("a", "");
    if (empty_replaced != "" || empty_replaced.ptr == null || empty_replaced.cap != 1 || empty_replaced.owned != 2) { return 21; }

    // Exercise both runtime allocation domains. Arena storage must never be
    // passed to free(), while an owned=3 heap result must be released by the
    // runtime module that allocated it.
    let arena_storage = vyx_alloc_string_len(2);
    if (arena_storage == null) { return 22; }
    memcpy(arena_storage, "ar".ptr, 2);
    let arena_owned = from_raw_string_parts(arena_storage, 2, 3, 3);
    if (arena_owned != "ar" || arena_owned.cap != 3 || arena_owned.owned != 3) { return 23; }
    str_drop(arena_owned);

    let runtime_storage = vyx_dup_bytes_raw("rt".ptr, 2);
    if (runtime_storage == null) { return 24; }
    let runtime_owned = from_raw_string_parts(runtime_storage, 2, 3, 3);
    if (runtime_owned != "rt" || runtime_owned.cap != 3 || runtime_owned.owned != 3) { return 25; }
    str_drop(runtime_owned);

    print("mir2cpp_string_ownership OK");
    return 0;
}
