use std.string;

fn main() -> i32 {
    let clone_source = "Clone contract".toUpper();
    let clone_copy = clone_source.clone();
    if (clone_copy.ptr == clone_source.ptr || clone_copy != "CLONE CONTRACT") { return 1; }
    str_drop(clone_source);
    if (clone_copy != "CLONE CONTRACT" || clone_copy.owned != 3) { return 2; }
    str_drop(clone_copy);

    // The additive ABI must allocate even an empty clone. This distinguishes
    // it from the legacy shared-empty bootstrap clone contract and ensures the
    // owned==3 runtime release path is safe on every input length.
    let empty_clone = "".clone();
    if (empty_clone.len != 0 || empty_clone.owned != 3 || empty_clone.ptr == null) { return 3; }
    str_drop(empty_clone);

    print("codegen_string_clone_abi OK");
    return 0;
}
