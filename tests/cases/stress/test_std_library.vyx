use std.core;
use std.collections;
use std.algorithm;
use std.math;
use std.hash;
use std.string;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) {
        print("PASS: ${name}");
        pass_count = pass_count + 1;
    } else {
        print("FAIL: ${name}");
        fail_count = fail_count + 1;
    }
}

// ============================================================
//  std.string tests
// ============================================================

fn test_string_basics() {
    print("\n=== std.string basics ===");

    let s = "hello world";
    check("str_length", s.len == 11);
    check("str_not_empty", !str_is_empty(s));
    check("str_empty", str_is_empty(""));
    check("str_equals_same", str_equals("abc", "abc"));
    check("str_equals_diff", !str_equals("abc", "xyz"));
}

fn test_string_search() {
    print("\n=== std.string search ===");

    let s = "hello world";
    check("str_contains_yes", str_contains(s, "world"));
    check("str_contains_no", !str_contains(s, "xyz"));
    check("str_contains_empty", str_contains(s, ""));
    check("str_starts_with", str_starts_with(s, "hello"));
    check("str_starts_with_no", !str_starts_with(s, "world"));
    check("str_ends_with", str_ends_with(s, "world"));
    check("str_ends_with_no", !str_ends_with(s, "hello"));

    let idx = str_index_of(s, "world");
    check("str_index_of_found", idx == 6);
    let idx2 = str_index_of(s, "xyz");
    check("str_index_of_missing", idx2 == -1);
}

fn test_string_manipulation() {
    print("\n=== std.string manipulation ===");

    let sub = str_substring("hello world", 0, 5);
    check("str_substring", sub == "hello");

    let sub2 = str_substr("hello world", 6, 5);
    check("str_substr", sub2 == "world");

    let upper = str_to_upper("hello");
    check("str_to_upper", upper == "HELLO");

    let lower = str_to_lower("HELLO");
    check("str_to_lower", lower == "hello");

    let trimmed = str_trim("  hello  ");
    check("str_trim", trimmed == "hello");

    let repeated = str_repeat("ab", 3);
    check("str_repeat", repeated == "ababab");

    let replaced = str_replace("hello world", "world", "vyx");
    check("str_replace", replaced == "hello vyx");
}

fn test_string_char_ops() {
    print("\n=== std.string char ops ===");

    let ch = str_char_at("ABCDE", 0);
    check("str_char_at_A", ch == 65);

    let ch2 = str_char_at("ABCDE", 4);
    check("str_char_at_E", ch2 == 69);

    check("char_is_digit_5", char_is_digit(53));
    check("char_is_digit_A", !char_is_digit(65));
    check("char_is_alpha_A", char_is_alpha(65));
    check("char_is_alpha_5", !char_is_alpha(53));
    check("char_is_upper_A", char_is_upper(65));
    check("char_is_lower_a", char_is_lower(97));
}

fn test_string_to_int() {
    print("\n=== std.string to_int ===");

    let n1 = str_to_int("42");
    check("str_to_int_42", n1 == 42);

    let n2 = str_to_int("0");
    check("str_to_int_0", n2 == 0);

    let n3 = str_to_int("-7");
    check("str_to_int_neg", n3 == -7);
}

// ============================================================
//  std.collections — Vec<T>
// ============================================================

fn test_vec_operations() {
    print("\n=== Vec<T> operations ===");

    var v = Vec::<i64>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    v.push(40);
    v.push(50);

    check("vec_len==5", v.len == 5);
    check("vec_get_0", v.get(0) == 10);
    check("vec_get_4", v.get(4) == 50);

    v.set(2, 99);
    check("vec_set", v.get(2) == 99);

    let popped = v.pop();
    check("vec_pop==50", popped == 50);
    check("vec_len_after_pop==4", v.len == 4);

    check("vec_contains_20", v.contains(20));
    check("vec_not_contains_50", !v.contains(50));

    let last = v.last();
    check("vec_last==40", last == 40);

    v.clear();
    check("vec_clear_len0", v.len == 0);
}

fn test_vec_bulk() {
    print("\n=== Vec<T> bulk operations ===");

    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 500) {
        v.push(i * 3);
        i = i + 1;
    }
    check("vec_bulk_500", v.len == 500);
    check("vec_bulk_get_0", v.get(0) == 0);
    check("vec_bulk_get_100", v.get(100) == 300);
    check("vec_bulk_get_499", v.get(499) == 1497);

    var sum: i64 = 0;
    i = 0;
    while (i < v.len) {
        sum = sum + v.get(i);
        i = i + 1;
    }
    let expected_sum: i64 = 3 * (499 * 500 / 2);
    check("vec_bulk_sum", sum == expected_sum);
}

fn test_vec_string() {
    print("\n=== Vec<string> ===");

    var vs = Vec::<string>.new();
    vs.push("alpha");
    vs.push("beta");
    vs.push("gamma");
    vs.push("delta");

    check("vec_str_len==4", vs.len == 4);
    check("vec_str_get_0", vs.get(0) == "alpha");
    check("vec_str_get_3", vs.get(3) == "delta");

    let popped = vs.pop();
    check("vec_str_pop", popped == "delta");
    check("vec_str_after_pop", vs.len == 3);
}

fn test_vec_i32() {
    print("\n=== Vec<i32> ===");

    var v = Vec::<i32>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    check("vec_i32_len==3", v.len == 3);
    check("vec_i32_get_0", v.get(0) == 1);
    check("vec_i32_get_2", v.get(2) == 3);
}

// ============================================================
//  std.collections — Dict<K, V>
// ============================================================

fn test_dict_operations() {
    print("\n=== Dict<K,V> operations ===");

    var d = Dict::<string, i64>.new();
    d.put("one", 1);
    d.put("two", 2);
    d.put("three", 3);

    check("dict_len==3", d.len == 3);
    check("dict_get_one", d.get("one") == 1);
    check("dict_get_three", d.get("three") == 3);
    check("dict_contains_two", d.contains("two"));
    check("dict_not_contains_four", !d.contains("four"));

    d.put("two", 22);
    check("dict_overwrite", d.get("two") == 22);
    check("dict_len_after_overwrite", d.len == 3);

    d.remove("one");
    check("dict_remove", !d.contains("one"));
    check("dict_len_after_remove", d.len == 2);
}

fn test_dict_bulk() {
    print("\n=== Dict<K,V> bulk ===");

    var d = Dict::<string, i64>.new();
    var i: i64 = 0;
    while (i < 100) {
        d.put("k${i}", i * 10);
        i = i + 1;
    }
    check("dict_bulk_len==100", d.len == 100);
    check("dict_bulk_get_k0", d.get("k0") == 0);
    check("dict_bulk_get_k50", d.get("k50") == 500);
    check("dict_bulk_get_k99", d.get("k99") == 990);
    check("dict_bulk_contains", d.contains("k42"));
    check("dict_bulk_not_contains", !d.contains("k100"));
}

fn test_dict_int_keys() {
    print("\n=== Dict<i64,i64> ===");

    var d = Dict::<i64, i64>.new();
    d.put(1, 100);
    d.put(2, 200);
    d.put(3, 300);

    check("dict_int_get_1", d.get(1) == 100);
    check("dict_int_get_3", d.get(3) == 300);
    check("dict_int_contains", d.contains(2));
}

// ============================================================
//  std.collections — Set<T>
// ============================================================

fn test_set_operations() {
    print("\n=== Set<T> operations ===");

    var s = Set::<i64>.new();
    s.add(10);
    s.add(20);
    s.add(30);
    s.add(10);

    check("set_dedup_len==3", s.len == 3);
    check("set_contains_10", s.contains(10));
    check("set_contains_30", s.contains(30));
    check("set_not_contains_40", !s.contains(40));

    s.remove(20);
    check("set_remove_len==2", s.len == 2);
    check("set_remove_not_contains", !s.contains(20));
}

// ============================================================
//  std.collections — algorithms (sort, search)
// ============================================================

fn test_sort_and_search() {
    print("\n=== sort & search ===");

    var v = Vec::<i64>.new();
    v.push(5);
    v.push(3);
    v.push(8);
    v.push(1);
    v.push(9);
    v.push(2);
    v.push(7);
    v.push(4);
    v.push(6);
    v.push(10);

    check("before_sort_not_sorted", !is_sorted(v));

    sort(v);
    check("after_sort_sorted", is_sorted(v));
    check("sort_first==1", v.get(0) == 1);
    check("sort_last==10", v.get(9) == 10);

    let idx = binary_search(v, 7);
    check("binary_search_7", idx == 6);

    let idx2 = binary_search(v, 11);
    check("binary_search_missing", idx2 == -1);

    let found = find(v, 5);
    check("find_5", found == 4);
}

fn test_aggregate_functions() {
    print("\n=== aggregate functions ===");

    var v = Vec::<i64>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    v.push(40);
    v.push(50);

    check("sum==150", sum(v) == 150);
    check("max==50", max(v) == 50);
    check("min==10", min(v) == 10);
    check("count_30", count(v, 30) == 1);
}

fn test_vec_reverse() {
    print("\n=== vec reverse ===");

    var v = Vec::<i64>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    reverse(v);
    check("reverse_first==5", v.get(0) == 5);
    check("reverse_last==1", v.get(4) == 1);
    check("reverse_mid==3", v.get(2) == 3);
}

// ============================================================
//  std.math tests
// ============================================================

fn test_math_basics() {
    print("\n=== std.math basics ===");

    check("math_gcd_12_8", gcd(12, 8) == 4);
    check("math_gcd_100_75", gcd(100, 75) == 25);
    check("math_lcm_4_6", lcm(4, 6) == 12);

    check("math_power_2_10", power(2, 10) == 1024);
    check("math_power_3_5", power(3, 5) == 243);
    check("math_isqrt_100", isqrt(100) == 10);
    check("math_isqrt_99", isqrt(99) == 9);
}

fn test_math_primes() {
    print("\n=== std.math primes ===");

    check("math_is_prime_2", is_prime(2) == 1);
    check("math_is_prime_7", is_prime(7) == 1);
    check("math_is_prime_4", is_prime(4) == 0);
    check("math_is_prime_97", is_prime(97) == 1);
    check("math_is_prime_100", is_prime(100) == 0);
}

// ============================================================
//  std.hash tests
// ============================================================

fn test_hash_functions() {
    print("\n=== std.hash ===");

    let h1 = hash_i64(42);
    let h2 = hash_i64(42);
    check("hash_deterministic", h1 == h2);

    let h3 = hash_i64(0);
    let h4 = hash_i64(1);
    check("hash_different_inputs", h3 != h4);

    let hs1 = hash_string("hello");
    let hs2 = hash_string("hello");
    check("hash_string_deterministic", hs1 == hs2);

    let hs3 = hash_string("hello");
    let hs4 = hash_string("world");
    check("hash_string_different", hs3 != hs4);

    let hs5 = hash_string("");
    check("hash_empty_string", hs5 != 0);
}

// ============================================================
//  Combined stress: data structure interactions
// ============================================================

fn test_combined_stress() {
    print("\n=== combined stress ===");

    var words = Vec::<string>.new();
    words.push("apple");
    words.push("banana");
    words.push("cherry");
    words.push("date");
    words.push("elderberry");

    var freq = Dict::<string, i64>.new();
    var i: i64 = 0;
    while (i < words.len) {
        let w = words.get(i);
        if (freq.contains(w)) {
            freq.put(w, freq.get(w) + 1);
        } else {
            freq.put(w, 1);
        }
        i = i + 1;
    }

    words.push("apple");
    words.push("banana");
    i = 0;
    while (i < words.len) {
        let w = words.get(i);
        if (freq.contains(w)) {
            freq.put(w, freq.get(w) + 1);
        } else {
            freq.put(w, 1);
        }
        i = i + 1;
    }

    check("combined_apple_freq", freq.get("apple") == 3);
    check("combined_banana_freq", freq.get("banana") == 3);
    check("combined_cherry_freq", freq.get("cherry") == 2);

    var unique = Set::<i64>.new();
    var numbers = Vec::<i64>.new();
    i = 0;
    while (i < 50) {
        numbers.push(i % 10);
        i = i + 1;
    }

    i = 0;
    while (i < numbers.len) {
        unique.add(numbers.get(i));
        i = i + 1;
    }
    check("combined_unique_count==10", unique.len == 10);
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== Vyx Std Library Stress Test ===");

    test_string_basics();
    test_string_search();
    test_string_manipulation();
    test_string_char_ops();
    test_string_to_int();

    test_vec_operations();
    test_vec_bulk();
    test_vec_string();
    test_vec_i32();

    test_dict_operations();
    test_dict_bulk();
    test_dict_int_keys();

    test_set_operations();

    test_sort_and_search();
    test_aggregate_functions();
    test_vec_reverse();

    test_math_basics();
    test_math_primes();

    test_hash_functions();

    test_combined_stress();

    print("\n=== Results ===");
    print("PASS: ${pass_count}");
    print("FAIL: ${fail_count}");

    if (fail_count > 0) {
        return 1;
    }
    return 0;
}
