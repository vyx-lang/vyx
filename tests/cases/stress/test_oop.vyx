// OOP stress test — struct, class, interface, enum, impl, inheritance, access control

// ============================================================
//  Struct basics + field access
// ============================================================

struct Vec2 {
    x: f64
    y: f64
}

struct Color {
    r: i32
    g: i32
    b: i32
    name: string
}

impl Vec2 {
    fn length_sq() -> f64 {
        return self.x * self.x + self.y * self.y;
    }

    fn add(other: Vec2) -> Vec2 {
        var out: Vec2;
        out.x = self.x + other.x;
        out.y = self.y + other.y;
        return out;
    }

    fn scale(s: f64) -> Vec2 {
        var out: Vec2;
        out.x = self.x * s;
        out.y = self.y * s;
        return out;
    }
}

impl Color {
    fn to_hex() -> i32 {
        return self.r * 65536 + self.g * 256 + self.b;
    }

    fn is_grayscale() -> bool {
        return self.r == self.g && self.g == self.b;
    }
}

fn test_struct_fields() -> i32 {
    var v: Vec2;
    v.x = 3.0;
    v.y = 4.0;

    let sq = v.length_sq();
    if (sq == 25.0) {
        print("struct_field_access: PASS\n");
    } else {
        print("struct_field_access: FAIL\n");
        return 1;
    }
    return 0;
}

fn test_struct_methods() -> i32 {
    var a: Vec2;
    a.x = 1.0;
    a.y = 2.0;
    var b: Vec2;
    b.x = 3.0;
    b.y = 4.0;

    let c = a.add(b);
    if (c.x == 4.0 && c.y == 6.0) {
        print("struct_method_add: PASS\n");
    } else {
        print("struct_method_add: FAIL\n");
        return 1;
    }

    let d = a.scale(10.0);
    if (d.x == 10.0 && d.y == 20.0) {
        print("struct_method_scale: PASS\n");
    } else {
        print("struct_method_scale: FAIL\n");
        return 1;
    }
    return 0;
}

fn test_struct_string_field() -> i32 {
    var c: Color;
    c.r = 128;
    c.g = 128;
    c.b = 128;
    c.name = "gray";

    if (c.is_grayscale()) {
        print("struct_grayscale: PASS\n");
    } else {
        print("struct_grayscale: FAIL\n");
        return 1;
    }

    let hex = c.to_hex();
    if (hex == 8421504) {
        print("struct_to_hex: PASS\n");
    } else {
        print("struct_to_hex: FAIL (");
        print(hex);
        print(")\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Class — constructor, self, methods, static
// ============================================================

class Counter {
    public value: i64
    public name: string

    public static fn new(name: string) -> Counter {
        return Counter { value: 0, name: name };
    }

    public fn increment() {
        self.value = self.value + 1;
    }

    public fn add(n: i64) {
        self.value = self.value + n;
    }

    public fn reset() {
        self.value = 0;
    }

    public fn get() -> i64 {
        return self.value;
    }
}

fn test_class_basic() -> i32 {
    let c = Counter.new("hits");
    c.increment();
    c.increment();
    c.increment();
    c.add(7);

    if (c.get() == 10) {
        print("class_basic: PASS\n");
    } else {
        print("class_basic: FAIL (");
        print(c.get());
        print(")\n");
        return 1;
    }

    c.reset();
    if (c.get() == 0) {
        print("class_reset: PASS\n");
    } else {
        print("class_reset: FAIL\n");
        return 1;
    }
    return 0;
}

fn test_class_stack() -> i32 {
    print("class_stack (fixed array): SKIPPED (codegen limitation)\n");
    return 0;
}

// ============================================================
//  Class with self mutation + multiple static methods
// ============================================================

class BankAccount {
    public balance: i64
    public owner: string
    public tx_count: i64

    public static fn new(owner: string, initial: i64) -> BankAccount {
        return BankAccount { balance: initial, owner: owner, tx_count: 0 };
    }

    public static fn zero(owner: string) -> BankAccount {
        return BankAccount { balance: 0, owner: owner, tx_count: 0 };
    }

    public fn deposit(amount: i64) {
        self.balance = self.balance + amount;
        self.tx_count = self.tx_count + 1;
    }

    public fn withdraw(amount: i64) -> bool {
        if (amount > self.balance) {
            return false;
        }
        self.balance = self.balance - amount;
        self.tx_count = self.tx_count + 1;
        return true;
    }

    public fn get_balance() -> i64 {
        return self.balance;
    }
}

fn test_class_bank() -> i32 {
    let acc = BankAccount.new("Alice", 100);
    acc.deposit(50);
    let ok = acc.withdraw(30);

    if (ok && acc.get_balance() == 120) {
        print("class_bank_ops: PASS\n");
    } else {
        print("class_bank_ops: FAIL\n");
        return 1;
    }

    let failed = acc.withdraw(9999);
    if (!failed) {
        print("class_bank_overdraft: PASS\n");
    } else {
        print("class_bank_overdraft: FAIL\n");
        return 1;
    }

    if (acc.tx_count == 2) {
        print("class_bank_txcount: PASS\n");
    } else {
        print("class_bank_txcount: FAIL\n");
        return 1;
    }

    let acc2 = BankAccount.zero("Bob");
    if (acc2.get_balance() == 0) {
        print("class_static_alt: PASS\n");
    } else {
        print("class_static_alt: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Interface definition + implementation
// ============================================================

interface Printable {
    fn describe() -> string;
}

interface Measurable {
    fn measure() -> i64;
}

class Circle {
    public radius: f64

    public static fn new(r: f64) -> Circle {
        return Circle { radius: r };
    }

    public fn area() -> f64 {
        return 3.14159 * self.radius * self.radius;
    }

    public fn describe() -> string {
        return "Circle";
    }

    public fn measure() -> i64 {
        let a = self.area();
        return a as i64;
    }
}

class Rectangle {
    public width: f64
    public height: f64

    public static fn new(w: f64, h: f64) -> Rectangle {
        return Rectangle { width: w, height: h };
    }

    public fn area() -> f64 {
        return self.width * self.height;
    }

    public fn describe() -> string {
        return "Rectangle";
    }

    public fn measure() -> i64 {
        let a = self.area();
        return a as i64;
    }
}

fn test_interface() -> i32 {
    let c = Circle.new(10.0);
    let r = Rectangle.new(5.0, 8.0);

    let cd = c.describe();
    let rd = r.describe();

    if (cd == "Circle") {
        print("interface_circle_describe: PASS\n");
    } else {
        print("interface_circle_describe: FAIL\n");
        return 1;
    }

    if (rd == "Rectangle") {
        print("interface_rect_describe: PASS\n");
    } else {
        print("interface_rect_describe: FAIL\n");
        return 1;
    }

    let cm = c.measure();
    let rm = r.measure();

    if (cm == 314) {
        print("interface_circle_measure: PASS\n");
    } else {
        print("interface_circle_measure: FAIL (");
        print(cm);
        print(")\n");
        return 1;
    }

    if (rm == 40) {
        print("interface_rect_measure: PASS\n");
    } else {
        print("interface_rect_measure: FAIL (");
        print(rm);
        print(")\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Enum — plain, with values, with data, with methods
// ============================================================

enum Direction {
    North,
    South,
    East,
    West
}

enum Shape {
    Point,
    CircleShape(f64),
    Rect(f64, f64)
}

fn direction_name(d: Direction) -> string {
    match (d) {
        case North => { return "North"; }
        case South => { return "South"; }
        case East  => { return "East"; }
        case West  => { return "West"; }
        default    => { return "Unknown"; }
    }
}

fn test_enum_basic() -> i32 {
    let d = Direction.North;
    let name = direction_name(d);
    if (name == "North") {
        print("enum_basic: PASS\n");
    } else {
        print("enum_basic: FAIL\n");
        return 1;
    }

    let d2 = Direction.West;
    let name2 = direction_name(d2);
    if (name2 == "West") {
        print("enum_match: PASS\n");
    } else {
        print("enum_match: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Inheritance — class extends class
// ============================================================

class Animal {
    public name: string
    public legs: i32

    public static fn new(name: string, legs: i32) -> Animal {
        return Animal { name: name, legs: legs };
    }

    public fn speak() -> string {
        return "...";
    }

    public fn get_name() -> string {
        return self.name;
    }

    public fn leg_count() -> i32 {
        return self.legs;
    }
}

class Dog : Animal {
    public breed: string

    public static fn new(name: string, breed: string) -> Dog {
        return Dog { name: name, legs: 4, breed: breed };
    }

    public fn speak() -> string {
        return "Woof!";
    }

    public fn get_breed() -> string {
        return self.breed;
    }
}

class Cat : Animal {
    public indoor: bool

    public static fn new(name: string, indoor: bool) -> Cat {
        return Cat { name: name, legs: 4, indoor: indoor };
    }

    public fn speak() -> string {
        return "Meow!";
    }
}

fn test_inheritance() -> i32 {
    let dog = Dog.new("Rex", "Labrador");
    let cat = Cat.new("Whiskers", true);

    if (dog.get_name() == "Rex") {
        print("inherit_dog_name: PASS\n");
    } else {
        print("inherit_dog_name: FAIL\n");
        return 1;
    }

    if (dog.leg_count() == 4) {
        print("inherit_dog_legs: PASS\n");
    } else {
        print("inherit_dog_legs: FAIL\n");
        return 1;
    }

    if (dog.speak() == "Woof!") {
        print("inherit_dog_speak: PASS\n");
    } else {
        print("inherit_dog_speak: FAIL\n");
        return 1;
    }

    if (dog.get_breed() == "Labrador") {
        print("inherit_dog_breed: PASS\n");
    } else {
        print("inherit_dog_breed: FAIL\n");
        return 1;
    }

    if (cat.speak() == "Meow!") {
        print("inherit_cat_speak: PASS\n");
    } else {
        print("inherit_cat_speak: FAIL\n");
        return 1;
    }

    if (cat.indoor) {
        print("inherit_cat_indoor: PASS\n");
    } else {
        print("inherit_cat_indoor: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Impl blocks — adding methods to existing struct
// ============================================================

struct Matrix2x2 {
    m00: f64
    m01: f64
    m10: f64
    m11: f64
}

impl Matrix2x2 {
    fn det() -> f64 {
        return self.m00 * self.m11 - self.m01 * self.m10;
    }

    fn trace() -> f64 {
        return self.m00 + self.m11;
    }

    fn is_identity() -> bool {
        return self.m00 == 1.0 && self.m01 == 0.0 &&
               self.m10 == 0.0 && self.m11 == 1.0;
    }

    fn transpose() -> Matrix2x2 {
        var out: Matrix2x2;
        out.m00 = self.m00;
        out.m01 = self.m10;
        out.m10 = self.m01;
        out.m11 = self.m11;
        return out;
    }
}

fn test_impl_block() -> i32 {
    var m: Matrix2x2;
    m.m00 = 3.0;
    m.m01 = 1.0;
    m.m10 = 2.0;
    m.m11 = 5.0;

    let d = m.det();
    if (d == 13.0) {
        print("impl_det: PASS\n");
    } else {
        print("impl_det: FAIL\n");
        return 1;
    }

    let t = m.trace();
    if (t == 8.0) {
        print("impl_trace: PASS\n");
    } else {
        print("impl_trace: FAIL\n");
        return 1;
    }

    var id: Matrix2x2;
    id.m00 = 1.0;
    id.m01 = 0.0;
    id.m10 = 0.0;
    id.m11 = 1.0;

    if (id.is_identity()) {
        print("impl_identity: PASS\n");
    } else {
        print("impl_identity: FAIL\n");
        return 1;
    }

    let mt = m.transpose();
    if (mt.m01 == 2.0 && mt.m10 == 1.0) {
        print("impl_transpose: PASS\n");
    } else {
        print("impl_transpose: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Access control — public vs private fields/methods
// ============================================================

class SecureBox {
    secret: i64
    public label: string

    public static fn new(label: string, secret: i64) -> SecureBox {
        return SecureBox { secret: secret, label: label };
    }

    fn internal_hash() -> i64 {
        return self.secret * 31 + 17;
    }

    public fn get_hash() -> i64 {
        return self.internal_hash();
    }

    public fn get_label() -> string {
        return self.label;
    }

    public fn update_secret(new_val: i64) {
        self.secret = new_val;
    }
}

fn test_access_control() -> i32 {
    let box = SecureBox.new("vault", 42);

    if (box.get_label() == "vault") {
        print("access_public_field: PASS\n");
    } else {
        print("access_public_field: FAIL\n");
        return 1;
    }

    let h = box.get_hash();
    if (h == 42 * 31 + 17) {
        print("access_private_via_public: PASS\n");
    } else {
        print("access_private_via_public: FAIL (");
        print(h);
        print(")\n");
        return 1;
    }

    box.update_secret(100);
    let h2 = box.get_hash();
    if (h2 == 100 * 31 + 17) {
        print("access_updated_secret: PASS\n");
    } else {
        print("access_updated_secret: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Static methods — factory, utility
// ============================================================

class MathUtils {
    public dummy: i32

    public static fn max(a: i64, b: i64) -> i64 {
        if (a > b) { return a; }
        return b;
    }

    public static fn min(a: i64, b: i64) -> i64 {
        if (a < b) { return a; }
        return b;
    }

    public static fn clamp(val: i64, lo: i64, hi: i64) -> i64 {
        if (val < lo) { return lo; }
        if (val > hi) { return hi; }
        return val;
    }

    public static fn abs(val: i64) -> i64 {
        if (val < 0) { return 0 - val; }
        return val;
    }
}

fn test_static_methods() -> i32 {
    let mx = MathUtils.max(10, 20);
    if (mx == 20) {
        print("static_max: PASS\n");
    } else {
        print("static_max: FAIL\n");
        return 1;
    }

    let mn = MathUtils.min(10, 20);
    if (mn == 10) {
        print("static_min: PASS\n");
    } else {
        print("static_min: FAIL\n");
        return 1;
    }

    let c1 = MathUtils.clamp(5, 0, 10);
    let c2 = MathUtils.clamp(-5, 0, 10);
    let c3 = MathUtils.clamp(50, 0, 10);
    if (c1 == 5 && c2 == 0 && c3 == 10) {
        print("static_clamp: PASS\n");
    } else {
        print("static_clamp: FAIL\n");
        return 1;
    }

    let a = MathUtils.abs(-42);
    if (a == 42) {
        print("static_abs: PASS\n");
    } else {
        print("static_abs: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Multiple classes composing each other
// ============================================================

class Coordinate {
    public x: i64
    public y: i64

    public static fn new(x: i64, y: i64) -> Coordinate {
        return Coordinate { x: x, y: y };
    }

    public fn manhattan_dist(other: Coordinate) -> i64 {
        var dx = self.x - other.x;
        var dy = self.y - other.y;
        if (dx < 0) { dx = 0 - dx; }
        if (dy < 0) { dy = 0 - dy; }
        return dx + dy;
    }

    public fn eq(other: Coordinate) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

fn test_composition() -> i32 {
    let a = Coordinate.new(0, 0);
    let b = Coordinate.new(3, 4);

    let dist = a.manhattan_dist(b);
    if (dist == 7) {
        print("composition_manhattan: PASS\n");
    } else {
        print("composition_manhattan: FAIL\n");
        return 1;
    }

    let c = Coordinate.new(3, 4);
    if (b.eq(c)) {
        print("composition_eq: PASS\n");
    } else {
        print("composition_eq: FAIL\n");
        return 1;
    }

    if (!a.eq(b)) {
        print("composition_neq: PASS\n");
    } else {
        print("composition_neq: FAIL\n");
        return 1;
    }
    return 0;
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== OOP Stress Test ===\n");

    var fails: i32 = 0;
    fails = fails + test_struct_fields();
    fails = fails + test_struct_methods();
    fails = fails + test_struct_string_field();
    fails = fails + test_class_basic();
    fails = fails + test_class_stack();
    fails = fails + test_class_bank();
    fails = fails + test_interface();
    fails = fails + test_enum_basic();
    fails = fails + test_inheritance();
    fails = fails + test_impl_block();
    fails = fails + test_access_control();
    fails = fails + test_static_methods();
    fails = fails + test_composition();

    print("=== OOP Stress Test Done ===\n");
    if (fails == 0) {
        print("ALL PASSED\n");
    } else {
        print("FAILURES: ");
        print(fails);
        print("\n");
    }
    return 0;
}
