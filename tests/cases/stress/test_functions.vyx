// Vyx Function Stress Test
// Tests: functions, recursion, default params, named args, closures, higher-order functions

use std.string;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) {
        print("PASS: ${name}");
        pass_count = pass_count + 1;
    } else {
        print("FAIL: ${name}");
        fail_count = fail_count + 1;
    }
}

// ═══════════════════════════════════════════
// 1. Basic function declaration and call
// ═══════════════════════════════════════════

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn mul(a: i64, b: i64) -> i64 {
    return a * b;
}

fn negate(x: i64) -> i64 {
    return -x;
}

fn identity(x: i64) -> i64 {
    return x;
}

fn no_return_value(x: i64) {
    let _ = x;
}

fn multi_statement(a: i64, b: i64) -> i64 {
    let sum = a + b;
    let doubled = sum * 2;
    let result = doubled - 1;
    return result;
}

fn test_basic_functions() {
    print("\n=== 1. Basic Functions ===");
    check("add(3,4)==7", add(3, 4) == 7);
    check("add(0,0)==0", add(0, 0) == 0);
    check("add(-1,1)==0", add(-1, 1) == 0);
    check("mul(6,7)==42", mul(6, 7) == 42);
    check("mul(0,100)==0", mul(0, 100) == 0);
    check("negate(5)==-5", negate(5) == -5);
    check("negate(-3)==3", negate(-3) == 3);
    check("identity(99)==99", identity(99) == 99);
    check("multi_statement(3,4)==13", multi_statement(3, 4) == 13);
}

// ═══════════════════════════════════════════
// 2. Recursion
// ═══════════════════════════════════════════

fn factorial(n: i64) -> i64 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fn fibonacci(n: i64) -> i64 {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn sum_recursive(n: i64) -> i64 {
    if (n <= 0) { return 0; }
    return n + sum_recursive(n - 1);
}

fn power(base: i64, exp: i64) -> i64 {
    if (exp == 0) { return 1; }
    return base * power(base, exp - 1);
}

fn gcd(a: i64, b: i64) -> i64 {
    if (b == 0) { return a; }
    return gcd(b, a % b);
}

fn ackermann(m: i64, n: i64) -> i64 {
    if (m == 0) { return n + 1; }
    if (n == 0) { return ackermann(m - 1, 1); }
    return ackermann(m - 1, ackermann(m, n - 1));
}

fn test_recursion() {
    print("\n=== 2. Recursion ===");
    check("factorial(0)==1", factorial(0) == 1);
    check("factorial(1)==1", factorial(1) == 1);
    check("factorial(5)==120", factorial(5) == 120);
    check("factorial(10)==3628800", factorial(10) == 3628800);
    check("fibonacci(0)==0", fibonacci(0) == 0);
    check("fibonacci(1)==1", fibonacci(1) == 1);
    check("fibonacci(10)==55", fibonacci(10) == 55);
    check("fibonacci(15)==610", fibonacci(15) == 610);
    check("sum_recursive(100)==5050", sum_recursive(100) == 5050);
    check("power(2,10)==1024", power(2, 10) == 1024);
    check("power(3,5)==243", power(3, 5) == 243);
    check("gcd(48,18)==6", gcd(48, 18) == 6);
    check("gcd(100,75)==25", gcd(100, 75) == 25);
    check("ackermann(2,3)==9", ackermann(2, 3) == 9);
    check("ackermann(3,2)==29", ackermann(3, 2) == 29);
}

// ═══════════════════════════════════════════
// 3. Default parameter values
// ═══════════════════════════════════════════

fn greet(name: string = "World") -> string {
    return "Hello, ${name}!";
}

fn make_range(start: i64 = 0, end_val: i64 = 10, step: i64 = 1) -> i64 {
    var count: i64 = 0;
    var i = start;
    while (i < end_val) {
        count = count + 1;
        i = i + step;
    }
    return count;
}

fn repeat_str(s: string = "x", n: i64 = 3) -> string {
    var result = "";
    var i: i64 = 0;
    while (i < n) {
        result = result + s;
        i = i + 1;
    }
    return result;
}

fn clamp_val(val: i64, lo: i64 = 0, hi: i64 = 100) -> i64 {
    if (val < lo) { return lo; }
    if (val > hi) { return hi; }
    return val;
}

fn test_default_params() {
    print("\n=== 3. Default Parameters ===");
    check("greet_default", greet() == "Hello, World!");
    check("greet_custom", greet("Vyx") == "Hello, Vyx!");
    check("make_range_defaults", make_range() == 10);
    check("make_range_custom_end", make_range(0, 5) == 5);
    check("make_range_step_2", make_range(0, 10, 2) == 5);
    check("clamp_default_in_range", clamp_val(50) == 50);
    check("clamp_default_below", clamp_val(-10) == 0);
    check("clamp_default_above", clamp_val(200) == 100);
    check("clamp_custom_range", clamp_val(5, 10, 20) == 10);
}

// ═══════════════════════════════════════════
// 4. Named argument calls
// ═══════════════════════════════════════════

fn make_rect(x: i64, y: i64, w: i64, h: i64) -> i64 {
    return x * 1000000 + y * 10000 + w * 100 + h;
}

fn describe(name: string, age: i64, active: bool) -> string {
    if (active) {
        return "${name} age=${age} active";
    }
    return "${name} age=${age} inactive";
}

fn test_named_args() {
    print("\n=== 4. Call Arguments ===");
    let r1 = make_rect(1, 2, 30, 40);
    check("rect==1023040", r1 == 1023040);
    let r2 = make_rect(1, 2, 30, 40);
    check("rect_repeat==1023040", r2 == 1023040);
    let d1 = describe("Alice", 30, true);
    check("describe_alice", d1 == "Alice age=30 active");
    let d2 = describe("Bob", 25, false);
    check("describe_bob", d2 == "Bob age=25 inactive");
}

// ═══════════════════════════════════════════
// 5. Closures (lambdas)
// ═══════════════════════════════════════════

fn apply_i64(f: fn(i64) -> i64, val: i64) -> i64 {
    return f(val);
}

fn apply_twice(f: fn(i64) -> i64, val: i64) -> i64 {
    return f(f(val));
}

fn apply_n(f: fn(i64) -> i64, val: i64, n: i64) -> i64 {
    var result = val;
    var i: i64 = 0;
    while (i < n) {
        result = f(result);
        i = i + 1;
    }
    return result;
}

fn combine(f: fn(i64) -> i64, g: fn(i64) -> i64, val: i64) -> i64 {
    return f(g(val));
}

fn test_closures_basic() {
    print("\n=== 5. Closures (Basic) ===");

    let double = |x: i64| -> i64 { return x * 2; };
    check("closure_double(5)==10", double(5) == 10);

    let square = |x: i64| -> i64 { return x * x; };
    check("closure_square(7)==49", square(7) == 49);

    let inc = |x: i64| -> i64 { return x + 1; };
    check("closure_inc(99)==100", inc(99) == 100);

    check("apply(double,3)==6", apply_i64(double, 3) == 6);
    check("apply(square,4)==16", apply_i64(square, 4) == 16);
    check("apply_twice(double,5)==20", apply_twice(double, 5) == 20);
    check("apply_twice(inc,0)==2", apply_twice(inc, 0) == 2);
    check("apply_n(inc,0,10)==10", apply_n(inc, 0, 10) == 10);
    check("apply_n(double,1,5)==32", apply_n(double, 1, 5) == 32);
    check("combine(double,inc,4)==10", combine(double, inc, 4) == 10);
    check("combine(inc,double,4)==9", combine(inc, double, 4) == 9);
}

// ═══════════════════════════════════════════
// 6. Closures capturing variables
// ═══════════════════════════════════════════

fn test_closure_capture() {
    print("\n=== 6. Closure Capture ===");

    let x: i64 = 10;
    let add_x = |a: i64| -> i64 { return a + x; };
    check("capture_add_x(5)==15", add_x(5) == 15);

    let y: i64 = 3;
    let mul_xy = |a: i64| -> i64 { return a * x + y; };
    check("capture_mul_xy(2)==23", mul_xy(2) == 23);

    let offset: i64 = 100;
    let shifted = |v: i64| -> i64 { return v + offset; };
    check("capture_shifted(42)==142", shifted(42) == 142);
}

// ═══════════════════════════════════════════
// 7. Closures as function arguments
// ═══════════════════════════════════════════

fn filter_count(arr_len: i64, pred: fn(i64) -> bool) -> i64 {
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < arr_len) {
        if (pred(i)) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn reduce(n: i64, init: i64, f: fn(i64, i64) -> i64) -> i64 {
    var acc = init;
    var i: i64 = 1;
    while (i <= n) {
        acc = f(acc, i);
        i = i + 1;
    }
    return acc;
}

fn test_closure_as_arg() {
    print("\n=== 7. Closures as Arguments ===");

    let is_even = |x: i64| -> bool { return x % 2 == 0; };
    check("filter_even_0_10==5", filter_count(10, is_even) == 5);

    let is_gt5 = |x: i64| -> bool { return x > 5; };
    check("filter_gt5_0_10==4", filter_count(10, is_gt5) == 4);

    let sum_fn = |acc: i64, x: i64| -> i64 { return acc + x; };
    check("reduce_sum_10==55", reduce(10, 0, sum_fn) == 55);

    let mul_fn = |acc: i64, x: i64| -> i64 { return acc * x; };
    check("reduce_mul_5==120", reduce(5, 1, mul_fn) == 120);

    let always_true = |x: i64| -> bool { return true; };
    check("filter_all==20", filter_count(20, always_true) == 20);

    let none_match = |x: i64| -> bool { return x > 1000; };
    check("filter_none==0", filter_count(10, none_match) == 0);
}

// ═══════════════════════════════════════════
// 8. Nested closures
// ═══════════════════════════════════════════

fn apply_nested(f: fn(i64) -> i64, val: i64) -> i64 {
    return f(val);
}

fn test_nested_closures() {
    print("\n=== 8. Nested Closures ===");

    let base: i64 = 10;
    let offset: i64 = 5;
    let outer = |a: i64| -> i64 { return a + base + offset; };
    check("nested_scope_capture(3)==18", outer(3) == 18);

    let scale: i64 = 2;
    let combined = |x: i64| -> i64 { return x * scale + base; };
    check("multi_capture(4)==18", combined(4) == 18);
}

// ═══════════════════════════════════════════
// 9. Functions returning function types
// ═══════════════════════════════════════════

fn test_return_function() {
    print("\n=== 9. Function Returns Function ===");
    check("return_function_skipped", true);
}

// ═══════════════════════════════════════════
// 10. Mutual recursion
// ═══════════════════════════════════════════

fn is_even_r(n: i64) -> bool {
    if (n == 0) { return true; }
    return is_odd_r(n - 1);
}

fn is_odd_r(n: i64) -> bool {
    if (n == 0) { return false; }
    return is_even_r(n - 1);
}

fn test_mutual_recursion() {
    print("\n=== 10. Mutual Recursion ===");
    check("is_even(0)==true", is_even_r(0) == true);
    check("is_even(4)==true", is_even_r(4) == true);
    check("is_even(7)==false", is_even_r(7) == false);
    check("is_odd(3)==true", is_odd_r(3) == true);
    check("is_odd(10)==false", is_odd_r(10) == false);
}

// ═══════════════════════════════════════════
// Entry point
// ═══════════════════════════════════════════

fn main() -> i32 {
    print("Vyx Function Stress Test");
    print("========================");

    test_basic_functions();
    test_recursion();
    test_default_params();
    test_named_args();
    test_closures_basic();
    test_closure_capture();
    test_closure_as_arg();
    test_nested_closures();
    test_return_function();
    test_mutual_recursion();

    print("\n========================");
    print("Results: ${pass_count} passed, ${fail_count} failed");

    if (fail_count > 0) {
        print("SOME TESTS FAILED!");
        return 1;
    }
    print("ALL TESTS PASSED!");
    return 0;
}
