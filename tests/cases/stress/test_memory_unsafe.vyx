extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
}

fn test_malloc_free() {
    print("=== malloc/free ===");
    let p = malloc(64);
    if (p != null) { print("malloc: PASS"); }
    else { print("malloc: FAIL"); }
    free(p);
    print("free: PASS");
}

fn test_memset_memcpy() {
    print("\n=== memset/memcpy ===");
    let buf = malloc(32);
    memset(buf, 0, 32);

    var val: i64 = 0;
    unsafe { memcpy(to_rawptr(&val), buf, 8); }
    if (val == 0) { print("memset zero: PASS"); }
    else { print("memset zero: FAIL"); }

    var src: i64 = 123456;
    unsafe { memcpy(buf, to_rawptr(&src), 8); }
    var dst: i64 = 0;
    unsafe { memcpy(to_rawptr(&dst), buf, 8); }
    if (dst == 123456) { print("memcpy roundtrip: PASS"); }
    else { print("memcpy roundtrip: FAIL (got ${dst})"); }

    free(buf);
}

fn test_pointer_arithmetic() {
    print("\n=== Pointer Arithmetic ===");
    let buf = malloc(64);

    var i: i64 = 0;
    while (i < 8) {
        var v: i64 = (i + 1) * 10;
        unsafe { memcpy(buf + i * 8, to_rawptr(&v), 8); }
        i = i + 1;
    }

    var pass = true;
    i = 0;
    while (i < 8) {
        var read_val: i64 = 0;
        unsafe { memcpy(to_rawptr(&read_val), buf + i * 8, 8); }
        let expected = (i + 1) * 10;
        if (read_val != expected) {
            print("ptr arith[${i}]: FAIL (expected ${expected}, got ${read_val})");
            pass = false;
        }
        i = i + 1;
    }
    if (pass) { print("ptr arithmetic write/read: PASS"); }

    free(buf);
}

fn test_realloc() {
    print("\n=== realloc ===");
    let p = malloc(16);
    var x: i64 = 999;
    unsafe { memcpy(p, to_rawptr(&x), 8); }

    let p2 = realloc(p, 64);
    if (p2 != null) { print("realloc non-null: PASS"); }
    else { print("realloc non-null: FAIL"); }

    var y: i64 = 0;
    unsafe { memcpy(to_rawptr(&y), p2, 8); }
    if (y == 999) { print("realloc preserves data: PASS"); }
    else { print("realloc preserves data: FAIL (got ${y})"); }

    free(p2);
}

fn test_null_check() {
    print("\n=== Null Pointer ===");
    var p: rawptr = null;
    if (p == null) { print("null init: PASS"); }
    else { print("null init: FAIL"); }

    p = malloc(8);
    if (p != null) { print("non-null after malloc: PASS"); }
    else { print("non-null after malloc: FAIL"); }

    free(p);
    p = null;
    if (p == null) { print("null after reset: PASS"); }
    else { print("null after reset: FAIL"); }
}

fn test_to_rawptr() {
    print("\n=== to_rawptr ===");

    var a: i64 = 42;
    let pa = to_rawptr(&a);
    if (pa != null) { print("to_rawptr non-null: PASS"); }
    else { print("to_rawptr non-null: FAIL"); }

    var b: i64 = 0;
    unsafe { memcpy(to_rawptr(&b), pa, 8); }
    if (b == 42) { print("to_rawptr read: PASS"); }
    else { print("to_rawptr read: FAIL (got ${b})"); }

    var new_val: i64 = 77;
    unsafe { memcpy(pa, to_rawptr(&new_val), 8); }
    if (a == 77) { print("to_rawptr write-through: PASS"); }
    else { print("to_rawptr write-through: FAIL (got ${a})"); }
}

fn test_mut_ref_as_rawptr() {
    print("\n=== &mut as rawptr ===");

    var val: i64 = 100;
    let p = to_rawptr(&val);
    if (p != null) { print("to_rawptr(&var): PASS"); }
    else { print("to_rawptr(&var): FAIL"); }

    var write: i64 = 200;
    unsafe { memcpy(p, to_rawptr(&write), 8); }
    if (val == 200) { print("write-through: PASS"); }
    else { print("write-through: FAIL (got ${val})"); }
}

fn test_multi_slot_buffer() {
    print("\n=== Multi-slot Buffer ===");
    let slots = 16;
    let buf = malloc(slots * 8);
    memset(buf, 0, slots * 8);

    var i: i64 = 0;
    while (i < slots) {
        var v: i64 = i * i;
        unsafe { memcpy(buf + i * 8, to_rawptr(&v), 8); }
        i = i + 1;
    }

    var pass = true;
    i = 0;
    while (i < slots) {
        var out: i64 = 0;
        unsafe { memcpy(to_rawptr(&out), buf + i * 8, 8); }
        if (out != i * i) {
            print("slot[${i}]: FAIL (expected ${i * i}, got ${out})");
            pass = false;
        }
        i = i + 1;
    }
    if (pass) { print("16-slot buffer: PASS"); }

    free(buf);
}

fn test_byte_level_ops() {
    print("\n=== Byte-level Ops ===");
    let buf = malloc(8);
    memset(buf, 0xFF, 8);

    var byte_val: i64 = 0;
    unsafe { memcpy(to_rawptr(&byte_val), buf, 1); }
    let masked = byte_val & 0xFF;
    if (masked == 0xFF) { print("memset 0xFF byte read: PASS"); }
    else { print("memset 0xFF byte read: FAIL (got ${masked})"); }

    memset(buf, 0xAB, 4);
    var first: i64 = 0;
    unsafe { memcpy(to_rawptr(&first), buf, 1); }
    let first_masked = first & 0xFF;
    if (first_masked == 0xAB) { print("partial memset: PASS"); }
    else { print("partial memset: FAIL (got ${first_masked})"); }

    free(buf);
}

fn test_struct_via_rawptr() {
    print("\n=== Struct via rawptr ===");
    let buf = malloc(24);

    var x: i64 = 10;
    var y: i64 = 20;
    var z: i64 = 30;
    unsafe {
        memcpy(buf, to_rawptr(&x), 8);
        memcpy(buf + 8, to_rawptr(&y), 8);
        memcpy(buf + 16, to_rawptr(&z), 8);
    }

    var rx: i64 = 0;
    var ry: i64 = 0;
    var rz: i64 = 0;
    unsafe {
        memcpy(to_rawptr(&rx), buf, 8);
        memcpy(to_rawptr(&ry), buf + 8, 8);
        memcpy(to_rawptr(&rz), buf + 16, 8);
    }

    if (rx == 10 && ry == 20 && rz == 30) { print("struct layout read: PASS"); }
    else { print("struct layout read: FAIL (${rx}, ${ry}, ${rz})"); }

    free(buf);
}

fn test_double_free_guard() {
    print("\n=== Alloc/Free Pattern ===");
    var i: i64 = 0;
    var pass = true;
    while (i < 100) {
        let p = malloc(128);
        if (p == null) { pass = false; }
        free(p);
        i = i + 1;
    }
    if (pass) { print("100x malloc/free: PASS"); }
    else { print("100x malloc/free: FAIL"); }
}

fn main() -> i32 {
    print("Memory Unsafe Stress Test");
    print("=========================");

    test_malloc_free();
    test_memset_memcpy();
    test_pointer_arithmetic();
    test_realloc();
    test_null_check();
    test_to_rawptr();
    test_mut_ref_as_rawptr();
    test_multi_slot_buffer();
    test_byte_level_ops();
    test_struct_via_rawptr();
    test_double_free_guard();

    print("\n=========================");
    print("All memory tests completed!");
    return 0;
}
