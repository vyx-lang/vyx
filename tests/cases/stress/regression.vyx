use std.collections;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); pass_count = pass_count + 1; }
    else { print("FAIL: ${name}"); fail_count = fail_count + 1; }
}

// =============================================
// 1a. Closure captures string + i32 + bool (new patterns)
// =============================================

fn test_closure_multi_type_capture() {
    let base: i32 = 100;
    let scale: i32 = 3;
    let add_mode: bool = true;

    let compute = |x: i32| -> i32 {
        if (add_mode) {
            return base + x * scale;
        }
        return -1;
    };

    check("cls_multi_type_add1", compute(1) == 103);
    check("cls_multi_type_add5", compute(5) == 115);
    check("cls_multi_type_add0", compute(0) == 100);

    let offset: i32 = 50;
    let factor: i32 = 2;
    let enabled: bool = false;
    let calc = |v: i32| -> i32 {
        if (enabled) { return (v + offset) * factor; }
        return 0;
    };
    check("cls_multi_type_disabled", calc(10) == 0);
}

// =============================================
// 1b. Closure modifies captured var — accumulator
// =============================================

fn test_closure_var_accumulator() {
    var total: i32 = 0;
    var idx: i32 = 0;
    while (idx < 5) {
        let step = idx * 10;
        let adder = |x: i32| -> i32 { return total + x + step; };
        total = adder(1);
        idx += 1;
    }
    check("cls_var_accum", total == 105);

    var flag: bool = false;
    let toggle_check = |v: i32| -> bool { return !flag && v > 0; };
    check("cls_var_bool_read", toggle_check(1) == true);
    flag = true;
    let toggle_check2 = |v: i32| -> bool { return !flag && v > 0; };
    check("cls_var_bool_updated", toggle_check2(1) == false);
}

// =============================================
// 1c. Closure calling another closure — composition
// =============================================

fn test_closure_composition() {
    let add_five = |x: i32| -> i32 { return x + 5; };
    let triple = |x: i32| -> i32 { return x * 3; };
    let composed = |x: i32| -> i32 { return triple(add_five(x)); };

    check("cls_compose_0", composed(0) == 15);
    check("cls_compose_10", composed(10) == 45);

    let negate = |x: i32| -> i32 { return -x; };
    let deep = |x: i32| -> i32 { return negate(composed(x)); };
    check("cls_compose_deep", deep(2) == -21);
}

// =============================================
// 2. Dict<string, Vec<string>> — different scenario
// =============================================

fn test_nested_generic_roles() {
    var roles = Dict::<string, Vec::<string>>.new();

    var admins = Vec::<string>.new();
    admins.push("alice");
    admins.push("bob");
    admins.push("carol");
    roles.put("admin", admins);

    var guests = Vec::<string>.new();
    guests.push("dave");
    roles.put("guest", guests);

    check("ng_roles_admin_len", roles.get("admin").len == 3);
    check("ng_roles_guest_len", roles.get("guest").len == 1);
    check("ng_roles_admin_1", roles.get("admin").get(1) == "bob");
    check("ng_roles_guest_0", roles.get("guest").get(0) == "dave");
    check("ng_roles_no_mod", !roles.contains("moderator"));

    var mods = Vec::<string>.new();
    mods.push("eve");
    mods.push("frank");
    roles.put("moderator", mods);
    check("ng_roles_mod_added", roles.contains("moderator") && roles.get("moderator").len == 2);
}

// =============================================
// 3a. Match guard — string length based
// =============================================

fn classify_len(n: i32, threshold: i32) -> i32 {
    if (n == 0) { return 0; }
    if (n < threshold) { return 1; }
    if (n == threshold) { return 2; }
    if (n > threshold && n <= 10) { return 3; }
    return 4;
}

fn test_match_guard_strlen() {
    let threshold: i32 = 5;
    check("mg_strlen_short", classify_len(3, threshold) == 1);
    check("mg_strlen_exact", classify_len(5, threshold) == 2);
    check("mg_strlen_medium", classify_len(8, threshold) == 3);
    check("mg_strlen_long", classify_len(20, threshold) == 4);
}

// =============================================
// 3b. Match guard referencing external var in loop
// =============================================

fn test_match_guard_dynamic() {
    var lo: i32 = 10;
    var hi: i32 = 90;
    var bucket: i32 = 0;

    var vals = Vec::<i32>.new();
    vals.push(5);
    vals.push(50);
    vals.push(95);

    var low_count: i32 = 0;
    var mid_count: i32 = 0;
    var hi_count: i32 = 0;

    var idx: i64 = 0;
    while (idx < vals.len) {
        let v = vals.get(idx);
        let vi = v as i32;
        if (vi < lo) { low_count += 1; }
        else if (vi >= lo && vi <= hi) { mid_count += 1; }
        else if (vi > hi) { hi_count += 1; }
        idx += 1;
    }

    check("mg_dyn_low", low_count == 1);
    check("mg_dyn_mid", mid_count == 1);
    check("mg_dyn_hi", hi_count == 1);
}

// =============================================
// 4. |> pipe chain — multi-step numeric
// =============================================

fn inc_i64(x: i64) -> i64 { return x + 1; }
fn halve_i64(x: i64) -> i64 { return x / 2; }
fn negate_i64(x: i64) -> i64 { return -x; }

fn test_pipe_multi_step() {
    let a: i32 = 20;
    let a64 = a as i64;
    let r1 = a64 |> halve_i64() |> inc_i64();
    check("pipe_halve_inc", r1 == 11);

    let b: i32 = 8;
    let b64 = b as i64;
    let r2 = b64 |> inc_i64() |> halve_i64() |> negate_i64();
    check("pipe_3step_neg", r2 == -4);

    let c: i32 = 100;
    let c64 = c as i64;
    let r3 = c64 |> halve_i64() |> halve_i64() |> halve_i64() |> inc_i64();
    check("pipe_4step_chain", r3 == 13);

    let back: i32 = r1 as i32;
    check("pipe_cast_roundtrip", back == 11);
}

// =============================================
// 5. Custom error + fail + try chain — validation pipeline
// =============================================

error ValidationError {
    TooShort,
    TooLong,
    BadFormat,
}

fn validate_length(val: i32) -> Result<i32, ValidationError> {
    if (val < 3) { fail ValidationError.TooShort; }
    if (val > 100) { fail ValidationError.TooLong; }
    return val;
}

fn validate_range(val: i32) -> Result<i32, ValidationError> {
    let checked = validate_length(val)?;
    if (checked % 2 != 0) { fail ValidationError.BadFormat; }
    return checked;
}

fn validate_full(val: i32) -> Result<i32, ValidationError> {
    let valid = validate_range(val)?;
    return valid * 10;
}

fn test_validation_chain() {
    let r1 = validate_full(20);
    match (r1) {
        case Ok(v) => { check("val_chain_ok", v == 200); }
        case Err(_) => { check("val_chain_ok", false); }
        default => { check("val_chain_ok", false); }
    }

    let r2 = validate_full(1);
    match (r2) {
        case Err(_) => { check("val_chain_short", true); }
        case Ok(_) => { check("val_chain_short", false); }
        default => { check("val_chain_short", false); }
    }

    let r3 = validate_full(15);
    match (r3) {
        case Err(_) => { check("val_chain_odd", true); }
        case Ok(_) => { check("val_chain_odd", false); }
        default => { check("val_chain_odd", false); }
    }

    let r4 = validate_full(200);
    match (r4) {
        case Err(_) => { check("val_chain_toolong", true); }
        case Ok(_) => { check("val_chain_toolong", false); }
        default => { check("val_chain_toolong", false); }
    }
}

// =============================================
// 6. Enum with data variants — expression tree
// =============================================

@[c_repr]
enum Expr {
    Literal(i32),
    Negate(i32),
    Double(i32),
    Zero,
}

fn eval_expr(e: Expr) -> i32 {
    var r: i32 = 0;
    match (e) {
        case Literal(v) => { r = v; }
        case Negate(v) => { r = -v; }
        case Double(v) => { r = v * 2; }
        case Zero => { r = 0; }
        default => { r = -999; }
    }
    return r;
}

fn test_enum_expr_tree() {
    check("enum_literal", eval_expr(Expr.Literal(42)) == 42);
    check("enum_negate", eval_expr(Expr.Negate(7)) == -7);
    check("enum_double", eval_expr(Expr.Double(15)) == 30);
    check("enum_zero", eval_expr(Expr.Zero) == 0);

    let sum = eval_expr(Expr.Literal(10)) + eval_expr(Expr.Double(5)) + eval_expr(Expr.Negate(3));
    check("enum_expr_sum", sum == 17);
}

// =============================================
// 7. u32 bitwise + u64 conversion
// =============================================

fn test_unsigned_ops() {
    let a: u32 = 0xF0F0F0F0;
    let b = a >> 8;
    check("u32_shift_f0", b == 0x00F0F0F0);

    let c: u32 = 0xABCD0000;
    let d = c >> 16;
    check("u32_shift_abcd", d == 0x0000ABCD);

    let e: u32 = 1;
    let f = e << 31;
    check("u32_lshift_31", f == 0x80000000);

    let g: u32 = 0xDEADBEEF;
    let h = g >> 24;
    check("u32_shift_dead", h == 0xDE);

    let big: u32 = 4000000000;
    let half = big >> 1;
    check("u32_big_half", half == 2000000000);
}

// =============================================
// 8. Default parameters — mixed types, partial calls
// =============================================

fn build_tag(name: string = "default", ver: i32 = 1, sep: string = "-", suffix: string = "release") -> string {
    return "${name}${sep}v${ver}${sep}${suffix}";
}

fn test_default_params_mixed() {
    check("def_all_default", build_tag() == "default-v1-release");
    check("def_name_only", build_tag("myapp") == "myapp-v1-release");
    check("def_name_ver", build_tag("myapp", 3) == "myapp-v3-release");
    check("def_name_ver_sep", build_tag("pkg", 2, "_") == "pkg_v2_release");
    check("def_all_custom", build_tag("lib", 5, ".", "beta") == "lib.v5.beta");
}

fn calc_area(w: i32 = 10, h: i32 = 10, scale: i32 = 1) -> i32 {
    return w * h * scale;
}

fn test_default_params_numeric() {
    check("def_num_all", calc_area() == 100);
    check("def_num_w", calc_area(5) == 50);
    check("def_num_wh", calc_area(3, 4) == 12);
    check("def_num_whs", calc_area(3, 4, 2) == 24);
}

// =============================================
// 9. Struct with multiple array fields — computation
// =============================================

struct Matrix2x3 {
    row0: [i32; 3]
    row1: [i32; 3]
}

fn test_struct_array_compute() {
    var m = Matrix2x3 { row0: [1, 2, 3], row1: [4, 5, 6] };

    let row0_sum = m.row0[0] + m.row0[1] + m.row0[2];
    let row1_sum = m.row1[0] + m.row1[1] + m.row1[2];
    check("sarr_row0_sum", row0_sum == 6);
    check("sarr_row1_sum", row1_sum == 15);

    m.row0[0] = 10;
    m.row0[2] = 30;
    m.row1[1] = 50;
    check("sarr_modified_r0", m.row0[0] == 10 && m.row0[1] == 2 && m.row0[2] == 30);
    check("sarr_modified_r1", m.row1[0] == 4 && m.row1[1] == 50 && m.row1[2] == 6);

    let dot = m.row0[0] * m.row1[0] + m.row0[1] * m.row1[1] + m.row0[2] * m.row1[2];
    check("sarr_dot_product", dot == 320);
}

struct Pair3 {
    xs: [i32; 3]
    ys: [i32; 3]
    zs: [i32; 3]
}

fn test_struct_triple_array() {
    var p = Pair3 { xs: [1, 0, 0], ys: [0, 1, 0], zs: [0, 0, 1] };

    let sum_all = p.xs[0] + p.xs[1] + p.xs[2] + p.ys[0] + p.ys[1] + p.ys[2] + p.zs[0] + p.zs[1] + p.zs[2];
    check("sarr3_identity_sum", sum_all == 3);

    p.xs[1] = 5;
    p.ys[0] = 7;
    p.zs[2] = 9;
    check("sarr3_write_xs", p.xs[1] == 5);
    check("sarr3_write_ys", p.ys[0] == 7);
    check("sarr3_write_zs", p.zs[2] == 9);
}

// =============================================
// 10. Comprehensive: generics + closures + match + error
// =============================================

error PipeError {
    EmptyInput,
    Overflow,
}

fn safe_double(v: i32) -> Result<i32, PipeError> {
    if (v > 500) { fail PipeError.Overflow; }
    return v * 2;
}

fn test_comprehensive_pipeline() {
    var items = Vec::<i32>.new();
    items.push(10);
    items.push(250);
    items.push(600);
    items.push(42);

    let bonus = |x: i32| -> i32 { return x + 5; };

    var success_sum: i32 = 0;
    var err_count: i32 = 0;
    var processed: i32 = 0;

    var i: i64 = 0;
    while (i < items.len) {
        let raw = items.get(i);
        let boosted = bonus(raw);
        let result = safe_double(boosted);
        match (result) {
            case Ok(val) => {
                processed += 1;
                if (val > 100) { success_sum += val; }
                else { success_sum += 1; }
            }
            case Err(_) => { err_count += 1; }
            default => {}
        }
        i += 1;
    }

    check("combo_pipe_processed", processed == 3);
    check("combo_pipe_errors", err_count == 1);
    check("combo_pipe_sum", success_sum == 512);
}

// =============================================
// Entry point
// =============================================

fn main() -> i32 {
    print("=== Regression Test Suite v2 ===");

    test_closure_multi_type_capture();
    test_closure_var_accumulator();
    test_closure_composition();
    test_nested_generic_roles();
    test_match_guard_strlen();
    test_match_guard_dynamic();
    test_pipe_multi_step();
    test_validation_chain();
    test_enum_expr_tree();
    test_unsigned_ops();
    test_default_params_mixed();
    test_default_params_numeric();
    test_struct_array_compute();
    test_struct_triple_array();
    test_comprehensive_pipeline();

    print("=== Results: ${pass_count} passed, ${fail_count} failed ===");
    if (fail_count == 0) {
        print("ALL REGRESSION TESTS PASSED");
    } else {
        print("SOME TESTS FAILED");
    }
    return 0;
}
