use std.collections;
use std.string;

fn test_string_interpolation() -> i32 {
    let name = "world";
    let greeting = "hello ${name}";
    if (greeting == "hello world") {
        print("string_interpolation: PASS");
    } else {
        print("string_interpolation: FAIL got '${greeting}'");
        return 1;
    }

    let num: i64 = 42;
    let msg = "value is ${num}";
    if (msg == "value is 42") {
        print("string_interpolation_int: PASS");
    } else {
        print("string_interpolation_int: FAIL got '${msg}'");
        return 1;
    }

    let a = "foo";
    let b = "bar";
    let combined = "${a}_${b}";
    if (combined == "foo_bar") {
        print("string_interpolation_multi: PASS");
    } else {
        print("string_interpolation_multi: FAIL got '${combined}'");
        return 1;
    }

    return 0;
}

fn test_string_concat() -> i32 {
    let s1 = "hello" + " " + "world";
    if (s1 == "hello world") {
        print("string_concat: PASS");
    } else {
        print("string_concat: FAIL got '${s1}'");
        return 1;
    }

    var acc = "";
    var i: i64 = 0;
    while (i < 5) {
        acc = acc + "x";
        i = i + 1;
    }
    if (acc == "xxxxx") {
        print("string_concat_loop: PASS");
    } else {
        print("string_concat_loop: FAIL got '${acc}'");
        return 1;
    }

    return 0;
}

fn test_string_compare() -> i32 {
    let a = "abc";
    let b = "abc";
    let c = "def";

    if (a == b) {
        print("string_eq: PASS");
    } else {
        print("string_eq: FAIL");
        return 1;
    }

    if (a != c) {
        print("string_neq: PASS");
    } else {
        print("string_neq: FAIL");
        return 1;
    }

    let empty1 = "";
    let empty2 = "";
    if (empty1 == empty2) {
        print("string_empty_eq: PASS");
    } else {
        print("string_empty_eq: FAIL");
        return 1;
    }

    if (a.contains("bc")) {
        print("string_contains: PASS");
    } else {
        print("string_contains: FAIL");
        return 1;
    }

    return 0;
}

fn test_vec_basic() -> i32 {
    var v = Vec::<i32>.new();
    v.push(10);
    v.push(20);
    v.push(30);

    if (v.len == 3) {
        print("vec_len: PASS");
    } else {
        print("vec_len: FAIL got ${v.len}");
        return 1;
    }

    let val0 = v.get(0);
    let val1 = v.get(1);
    let val2 = v.get(2);
    if (val0 == 10 && val1 == 20 && val2 == 30) {
        print("vec_get: PASS");
    } else {
        print("vec_get: FAIL");
        return 1;
    }

    v.set(1, 99);
    if (v.get(1) == 99) {
        print("vec_set: PASS");
    } else {
        print("vec_set: FAIL");
        return 1;
    }

    let popped = v.pop();
    if (popped == 30 && v.len == 2) {
        print("vec_pop: PASS");
    } else {
        print("vec_pop: FAIL");
        return 1;
    }

    return 0;
}

fn test_vec_i64() -> i32 {
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 100) {
        v.push(i * i);
        i = i + 1;
    }

    if (v.len == 100) {
        print("vec_i64_push100: PASS");
    } else {
        print("vec_i64_push100: FAIL len=${v.len}");
        return 1;
    }

    if (v.get(10) == 100 && v.get(99) == 9801) {
        print("vec_i64_values: PASS");
    } else {
        print("vec_i64_values: FAIL");
        return 1;
    }

    if (v.contains(49)) {
        print("vec_i64_contains: PASS");
    } else {
        print("vec_i64_contains: FAIL");
        return 1;
    }

    return 0;
}

fn test_dict_basic() -> i32 {
    var d = Dict::<string, i32>.new();
    d.put("alpha", 1);
    d.put("beta", 2);
    d.put("gamma", 3);

    if (d.len == 3) {
        print("dict_len: PASS");
    } else {
        print("dict_len: FAIL got ${d.len}");
        return 1;
    }

    let v1 = d.get("alpha");
    let v2 = d.get("beta");
    let v3 = d.get("gamma");
    if (v1 == 1 && v2 == 2 && v3 == 3) {
        print("dict_get: PASS");
    } else {
        print("dict_get: FAIL");
        return 1;
    }

    if (d.contains("beta")) {
        print("dict_contains_yes: PASS");
    } else {
        print("dict_contains_yes: FAIL");
        return 1;
    }

    if (!d.contains("missing")) {
        print("dict_contains_no: PASS");
    } else {
        print("dict_contains_no: FAIL");
        return 1;
    }

    d.put("alpha", 100);
    if (d.get("alpha") == 100 && d.len == 3) {
        print("dict_overwrite: PASS");
    } else {
        print("dict_overwrite: FAIL");
        return 1;
    }

    return 0;
}

fn test_dict_int_keys() -> i32 {
    var d = Dict::<i64, i64>.new();
    var i: i64 = 0;
    while (i < 50) {
        d.put(i, i * 10);
        i = i + 1;
    }

    if (d.len == 50) {
        print("dict_int_len: PASS");
    } else {
        print("dict_int_len: FAIL got ${d.len}");
        return 1;
    }

    if (d.get(25) == 250 && d.get(0) == 0 && d.get(49) == 490) {
        print("dict_int_get: PASS");
    } else {
        print("dict_int_get: FAIL");
        return 1;
    }

    d.remove(25);
    if (!d.contains(25) && d.len == 49) {
        print("dict_int_remove: PASS");
    } else {
        print("dict_int_remove: FAIL");
        return 1;
    }

    return 0;
}

fn test_array_fixed() -> i32 {
    let arr = [10, 20, 30, 40, 50];
    if (arr[0] == 10 && arr[2] == 30 && arr[4] == 50) {
        print("array_fixed_access: PASS");
    } else {
        print("array_fixed_access: FAIL");
        return 1;
    }

    return 0;
}

fn test_tuple() -> i32 {
    let t = (42, "hello", 3);
    let v0 = t._0;
    let v1 = t._1;
    let v2 = t._2;
    if (v0 == 42 && v2 == 3) {
        print("tuple_access: PASS");
    } else {
        print("tuple_access: FAIL");
        return 1;
    }

    return 0;
}

fn main() -> i32 {
    print("=== Strings & Collections Stress Test ===");

    var failures: i32 = 0;
    failures = failures + test_string_interpolation();
    failures = failures + test_string_concat();
    failures = failures + test_string_compare();
    failures = failures + test_vec_basic();
    failures = failures + test_vec_i64();
    failures = failures + test_dict_basic();
    failures = failures + test_dict_int_keys();
    failures = failures + test_array_fixed();
    failures = failures + test_tuple();

    if (failures == 0) {
        print("=== ALL TESTS PASSED ===");
    } else {
        print("=== ${failures} TEST(S) FAILED ===");
    }

    return 0;
}
