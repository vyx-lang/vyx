use std.core;
use std.collections;
use std.algorithm;
use std.string;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { pass_count = pass_count + 1; }
    else { print("FAIL: ${name}"); fail_count = fail_count + 1; }
}

// ============================================================
//  Vec<i64> — exhaustive
// ============================================================

fn test_vec_empty() {
    print("\n--- Vec empty state ---");
    var v = Vec::<i64>.new();
    check("vec_empty_len", v.len == 0);
    v.push(1);
    check("vec_push_one", v.len == 1 && v.get(0) == 1);
    let p = v.pop();
    check("vec_pop_to_empty", v.len == 0 && p == 1);
}

fn test_vec_push_pop_cycle() {
    print("\n--- Vec push/pop cycles ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 1000) {
        v.push(i);
        i = i + 1;
    }
    check("vec_push_1000", v.len == 1000);

    i = 999;
    var ok = true;
    while (i >= 0) {
        let p = v.pop();
        if (p != i) { ok = false; }
        i = i - 1;
    }
    check("vec_pop_1000_LIFO", ok && v.len == 0);
}

fn test_vec_random_access() {
    print("\n--- Vec random access ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 500) {
        v.push(i * i);
        i = i + 1;
    }
    check("vec_get_0", v.get(0) == 0);
    check("vec_get_1", v.get(1) == 1);
    check("vec_get_100", v.get(100) == 10000);
    check("vec_get_499", v.get(499) == 249001);

    v.set(250, -1);
    check("vec_set_250", v.get(250) == -1);
    v.set(0, 999);
    check("vec_set_0", v.get(0) == 999);
}

fn test_vec_grow_shrink() {
    print("\n--- Vec grow/shrink ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 5000) {
        v.push(i);
        i = i + 1;
    }
    check("vec_grow_5000", v.len == 5000);
    check("vec_grow_val_4999", v.get(4999) == 4999);

    i = 0;
    while (i < 4000) {
        v.pop();
        i = i + 1;
    }
    check("vec_shrink_to_1000", v.len == 1000);
    check("vec_shrink_last", v.get(999) == 999);

    i = 0;
    while (i < 3000) {
        v.push(i + 10000);
        i = i + 1;
    }
    check("vec_regrow_4000", v.len == 4000);
    check("vec_regrow_first_part", v.get(0) == 0);
    check("vec_regrow_new_part", v.get(1000) == 10000);
}

fn test_vec_contains_search() {
    print("\n--- Vec contains/search ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 200) {
        v.push(i * 2);
        i = i + 1;
    }
    check("vec_contains_0", v.contains(0));
    check("vec_contains_100", v.contains(100));
    check("vec_contains_398", v.contains(398));
    check("vec_not_contains_1", !v.contains(1));
    check("vec_not_contains_3", !v.contains(3));
    check("vec_not_contains_399", !v.contains(399));
}

fn test_vec_clear_reuse() {
    print("\n--- Vec clear/reuse ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 100) {
        v.push(i);
        i = i + 1;
    }
    v.clear();
    check("vec_clear_empty", v.len == 0);

    i = 0;
    while (i < 50) {
        v.push(i + 1000);
        i = i + 1;
    }
    check("vec_reuse_len", v.len == 50);
    check("vec_reuse_val", v.get(0) == 1000);
}

fn test_vec_swap() {
    print("\n--- Vec swap ---");
    var v = Vec::<i64>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    v.swap(0, 2);
    check("vec_swap_0_2", v.get(0) == 30 && v.get(2) == 10);
    v.swap(0, 1);
    check("vec_swap_0_1", v.get(0) == 20 && v.get(1) == 30);
}

fn test_vec_insert_remove() {
    print("\n--- Vec insert/remove_at ---");
    var v = Vec::<i64>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    v.insert(2, 99);
    check("vec_insert_len", v.len == 6);
    check("vec_insert_val", v.get(2) == 99);
    check("vec_insert_shifted", v.get(3) == 3);

    v.remove(2);
    check("vec_remove_len", v.len == 5);
    check("vec_remove_val", v.get(2) == 3);
}

// ============================================================
//  Vec<string> — intensive
// ============================================================

fn test_vec_string_intensive() {
    print("\n--- Vec<string> intensive ---");
    var v = Vec::<string>.new();
    var i: i64 = 0;
    while (i < 200) {
        v.push("item_${i}");
        i = i + 1;
    }
    check("vec_str_200", v.len == 200);
    check("vec_str_get_0", v.get(0) == "item_0");
    check("vec_str_get_99", v.get(99) == "item_99");
    check("vec_str_get_199", v.get(199) == "item_199");

    var found = false;
    i = 0;
    while (i < v.len) {
        if (v.get(i) == "item_150") { found = true; }
        i = i + 1;
    }
    check("vec_str_find_150", found);
}

fn test_vec_string_concat() {
    print("\n--- Vec<string> build ---");
    var parts = Vec::<string>.new();
    parts.push("Hello");
    parts.push(", ");
    parts.push("World");
    parts.push("!");

    var result = "";
    var i: i64 = 0;
    while (i < parts.len) {
        result = result + parts.get(i);
        i = i + 1;
    }
    check("vec_str_join", result == "Hello, World!");
}

// ============================================================
//  Vec<i32>
// ============================================================

fn test_vec_i32_intensive() {
    print("\n--- Vec<i32> intensive ---");
    var v = Vec::<i32>.new();
    var i: i32 = 0;
    while (i < 300) {
        v.push(i * 3 + 1);
        i = i + 1;
    }
    check("vec_i32_300", v.len == 300);
    check("vec_i32_get_0", v.get(0) == 1);
    check("vec_i32_get_100", v.get(100) == 301);
    check("vec_i32_get_299", v.get(299) == 898);

    var sum: i32 = 0;
    var j: i64 = 0;
    while (j < v.len) {
        sum = sum + v.get(j);
        j = j + 1;
    }
    check("vec_i32_sum", sum > 0);
}

// ============================================================
//  Dict<string, i64> — exhaustive
// ============================================================

fn test_dict_basic_ops() {
    print("\n--- Dict basic ops ---");
    var d = Dict::<string, i64>.new();
    d.put("a", 1);
    d.put("b", 2);
    d.put("c", 3);
    check("dict_len_3", d.len == 3);
    check("dict_get_a", d.get("a") == 1);
    check("dict_get_c", d.get("c") == 3);
    check("dict_contains_b", d.contains("b"));
    check("dict_not_contains_d", !d.contains("d"));
}

fn test_dict_overwrite() {
    print("\n--- Dict overwrite ---");
    var d = Dict::<string, i64>.new();
    d.put("key", 100);
    check("dict_ow_first", d.get("key") == 100);
    d.put("key", 200);
    check("dict_ow_second", d.get("key") == 200 && d.len == 1);
    d.put("key", 300);
    check("dict_ow_third", d.get("key") == 300 && d.len == 1);
}

fn test_dict_remove() {
    print("\n--- Dict remove ---");
    var d = Dict::<string, i64>.new();
    d.put("x", 10);
    d.put("y", 20);
    d.put("z", 30);
    d.remove("y");
    check("dict_rm_len", d.len == 2);
    check("dict_rm_gone", !d.contains("y"));
    check("dict_rm_x_ok", d.get("x") == 10);
    check("dict_rm_z_ok", d.get("z") == 30);

    d.put("y", 99);
    check("dict_rm_readd", d.get("y") == 99 && d.len == 3);
}

fn test_dict_bulk_500() {
    print("\n--- Dict bulk 500 ---");
    var d = Dict::<string, i64>.new();
    var i: i64 = 0;
    while (i < 500) {
        d.put("key_${i}", i);
        i = i + 1;
    }
    check("dict_bulk_500_len", d.len == 500);
    check("dict_bulk_500_get_0", d.get("key_0") == 0);
    check("dict_bulk_500_get_250", d.get("key_250") == 250);
    check("dict_bulk_500_get_499", d.get("key_499") == 499);

    var ok = true;
    i = 0;
    while (i < 500) {
        if (!d.contains("key_${i}")) { ok = false; }
        if (d.get("key_${i}") != i) { ok = false; }
        i = i + 1;
    }
    check("dict_bulk_500_all_correct", ok);
}

fn test_dict_remove_bulk() {
    print("\n--- Dict remove bulk ---");
    var d = Dict::<string, i64>.new();
    var i: i64 = 0;
    while (i < 100) {
        d.put("k${i}", i);
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        d.remove("k${i}");
        i = i + 1;
    }
    check("dict_rm_bulk_len", d.len == 50);

    var ok = true;
    i = 0;
    while (i < 50) {
        if (d.contains("k${i}")) { ok = false; }
        i = i + 1;
    }
    check("dict_rm_bulk_gone", ok);

    ok = true;
    i = 50;
    while (i < 100) {
        if (!d.contains("k${i}") || d.get("k${i}") != i) { ok = false; }
        i = i + 1;
    }
    check("dict_rm_bulk_remaining", ok);
}

// ============================================================
//  Dict<i64, i64>
// ============================================================

fn test_dict_int_keys_stress() {
    print("\n--- Dict<i64,i64> stress ---");
    var d = Dict::<i64, i64>.new();
    var i: i64 = 0;
    while (i < 300) {
        d.put(i, i * i);
        i = i + 1;
    }
    check("dict_int_300_len", d.len == 300);
    check("dict_int_get_0", d.get(0) == 0);
    check("dict_int_get_10", d.get(10) == 100);
    check("dict_int_get_299", d.get(299) == 89401);

    d.remove(150);
    check("dict_int_rm", !d.contains(150) && d.len == 299);
}

// ============================================================
//  Dict<string, string>
// ============================================================

fn test_dict_string_string() {
    print("\n--- Dict<string,string> ---");
    var d = Dict::<string, string>.new();
    d.put("name", "Vyx");
    d.put("version", "0.1.0");
    d.put("author", "user");

    check("dict_ss_get_name", d.get("name") == "Vyx");
    check("dict_ss_get_ver", d.get("version") == "0.1.0");
    check("dict_ss_len", d.len == 3);

    d.put("name", "VyxLang");
    check("dict_ss_overwrite", d.get("name") == "VyxLang");
}

// ============================================================
//  Set<i64> — exhaustive
// ============================================================

fn test_set_dedup() {
    print("\n--- Set dedup ---");
    var s = Set::<i64>.new();
    var i: i64 = 0;
    while (i < 100) {
        s.add(i % 10);
        i = i + 1;
    }
    check("set_dedup_100_to_10", s.len == 10);

    var ok = true;
    i = 0;
    while (i < 10) {
        if (!s.contains(i)) { ok = false; }
        i = i + 1;
    }
    check("set_dedup_all_present", ok);
    check("set_not_contains_10", !s.contains(10));
}

fn test_set_remove_stress() {
    print("\n--- Set remove stress ---");
    var s = Set::<i64>.new();
    var i: i64 = 0;
    while (i < 50) {
        s.add(i);
        i = i + 1;
    }
    check("set_add_50", s.len == 50);

    i = 0;
    while (i < 25) {
        s.remove(i * 2);
        i = i + 1;
    }
    check("set_rm_even_len", s.len == 25);

    var ok = true;
    i = 0;
    while (i < 25) {
        if (s.contains(i * 2)) { ok = false; }
        if (!s.contains(i * 2 + 1)) { ok = false; }
        i = i + 1;
    }
    check("set_rm_even_correct", ok);
}

// ============================================================
//  String operations — intensive
// ============================================================

fn test_string_interpolation_stress() {
    print("\n--- String interpolation stress ---");
    var i: i64 = 0;
    var ok = true;
    while (i < 100) {
        let s = "val_${i}";
        if (s.len < 5) { ok = false; }
        i = i + 1;
    }
    check("str_interp_100", ok);
}

fn test_string_concat_stress() {
    print("\n--- String concat stress ---");
    var s = "";
    var i: i64 = 0;
    while (i < 200) {
        s = s + "x";
        i = i + 1;
    }
    check("str_concat_200", s.len == 200);
}

fn test_string_compare_stress() {
    print("\n--- String compare stress ---");
    var ok = true;
    var i: i64 = 0;
    while (i < 100) {
        let a = "test_${i}";
        let b = "test_${i}";
        if (a != b) { ok = false; }
        i = i + 1;
    }
    check("str_cmp_100_equal", ok);

    ok = true;
    i = 0;
    while (i < 99) {
        let a = "test_${i}";
        let b = "test_${i + 1}";
        if (a == b) { ok = false; }
        i = i + 1;
    }
    check("str_cmp_99_not_equal", ok);
}

fn test_string_contains_stress() {
    print("\n--- String contains stress ---");
    let haystack = "the quick brown fox jumps over the lazy dog";
    check("str_cont_the", haystack.contains("the"));
    check("str_cont_fox", haystack.contains("fox"));
    check("str_cont_dog", haystack.contains("dog"));
    check("str_cont_empty", haystack.contains(""));
    check("str_not_cont_cat", !haystack.contains("cat"));
    check("str_not_cont_xyz", !haystack.contains("xyz"));
}

// ============================================================
//  Sort / Algorithm stress
// ============================================================

fn test_sort_stress() {
    print("\n--- Sort stress ---");

    var v = Vec::<i64>.new();
    var i: i64 = 100;
    while (i > 0) {
        v.push(i);
        i = i - 1;
    }
    check("sort_reverse_unsorted", !is_sorted(v));
    sort(v);
    check("sort_reverse_sorted", is_sorted(v));
    check("sort_reverse_first", v.get(0) == 1);
    check("sort_reverse_last", v.get(99) == 100);

    var v2 = Vec::<i64>.new();
    i = 0;
    while (i < 100) {
        v2.push(42);
        i = i + 1;
    }
    sort(v2);
    check("sort_uniform", is_sorted(v2) && v2.get(0) == 42);

    var v3 = Vec::<i64>.new();
    i = 0;
    while (i < 50) {
        v3.push(i);
        i = i + 1;
    }
    sort(v3);
    check("sort_already_sorted", is_sorted(v3) && v3.get(0) == 0);
}

fn test_binary_search_stress() {
    print("\n--- Binary search stress ---");
    var v = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 200) {
        v.push(i * 5);
        i = i + 1;
    }

    check("bsearch_0", binary_search(v, 0) == 0);
    check("bsearch_50", binary_search(v, 50) == 10);
    check("bsearch_995", binary_search(v, 995) == 199);
    check("bsearch_miss_1", binary_search(v, 1) == -1);
    check("bsearch_miss_996", binary_search(v, 996) == -1);
}

// ============================================================
//  Combined: compiler bootstrap simulation
// ============================================================

fn test_symbol_table_sim() {
    print("\n--- Symbol table simulation ---");
    var symbols = Dict::<string, i64>.new();

    var i: i64 = 0;
    while (i < 200) {
        symbols.put("var_${i}", i);
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        symbols.put("fn_${i}", 1000 + i);
        i = i + 1;
    }
    i = 0;
    while (i < 20) {
        symbols.put("class_${i}", 2000 + i);
        i = i + 1;
    }

    check("sym_total_270", symbols.len == 270);
    check("sym_var_0", symbols.get("var_0") == 0);
    check("sym_fn_25", symbols.get("fn_25") == 1025);
    check("sym_class_10", symbols.get("class_10") == 2010);

    symbols.put("var_50", 9999);
    check("sym_update", symbols.get("var_50") == 9999);
}

fn test_token_list_sim() {
    print("\n--- Token list simulation ---");
    var tokens = Vec::<string>.new();
    tokens.push("fn");
    tokens.push("main");
    tokens.push("(");
    tokens.push(")");
    tokens.push("->");
    tokens.push("i32");
    tokens.push("{");
    tokens.push("return");
    tokens.push("0");
    tokens.push(";");
    tokens.push("}");

    check("tok_count_11", tokens.len == 11);
    check("tok_first_fn", tokens.get(0) == "fn");
    check("tok_last_brace", tokens.get(10) == "}");

    var keywords = Dict::<string, i64>.new();
    keywords.put("fn", 1);
    keywords.put("return", 1);
    keywords.put("i32", 1);

    var kw_count: i64 = 0;
    var j: i64 = 0;
    while (j < tokens.len) {
        if (keywords.contains(tokens.get(j))) {
            kw_count = kw_count + 1;
        }
        j = j + 1;
    }
    check("tok_keyword_count", kw_count == 3);
}

fn test_ast_children_sim() {
    print("\n--- AST children simulation ---");
    var node_types = Vec::<i64>.new();
    var node_names = Vec::<string>.new();

    var i: i64 = 0;
    while (i < 500) {
        node_types.push(i % 8);
        node_names.push("node_${i}");
        i = i + 1;
    }

    var type_counts = Dict::<i64, i64>.new();
    i = 0;
    while (i < node_types.len) {
        let t = node_types.get(i);
        if (type_counts.contains(t)) {
            type_counts.put(t, type_counts.get(t) + 1);
        } else {
            type_counts.put(t, 1);
        }
        i = i + 1;
    }

    check("ast_type_0_count", type_counts.get(0) == 63);
    check("ast_type_7_count", type_counts.get(7) == 62);
    check("ast_node_name_0", node_names.get(0) == "node_0");
    check("ast_node_name_499", node_names.get(499) == "node_499");
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== Container Stress Test (Bootstrap Critical) ===");

    test_vec_empty();
    test_vec_push_pop_cycle();
    test_vec_random_access();
    test_vec_grow_shrink();
    test_vec_contains_search();
    test_vec_clear_reuse();
    test_vec_swap();
    test_vec_insert_remove();

    test_vec_string_intensive();
    test_vec_string_concat();
    test_vec_i32_intensive();

    test_dict_basic_ops();
    test_dict_overwrite();
    test_dict_remove();
    test_dict_bulk_500();
    test_dict_remove_bulk();
    test_dict_int_keys_stress();
    test_dict_string_string();

    test_set_dedup();
    test_set_remove_stress();

    test_string_interpolation_stress();
    test_string_concat_stress();
    test_string_compare_stress();
    test_string_contains_stress();

    test_sort_stress();
    test_binary_search_stress();

    test_symbol_table_sim();
    test_token_list_sim();
    test_ast_children_sim();

    print("\n=== Results ===");
    print("PASS: ${pass_count}");
    print("FAIL: ${fail_count}");

    if (fail_count > 0) { return 1; }
    print("ALL TESTS PASSED");
    return 0;
}
