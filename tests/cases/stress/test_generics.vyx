use std.collections;

// ── 1. Generic class with single type parameter ──

class Wrapper<T> {
    public value: T;

    public static fn new(v: T) -> Wrapper<T> {
        return Wrapper { value: v };
    }

    public fn get() -> T {
        return self.value;
    }

    public fn set(v: T) {
        self.value = v;
    }
}

// ── 2. Generic class with two type parameters ──

class Pair<A, B> {
    public first: A;
    public second: B;

    public static fn new(a: A, b: B) -> Pair<A, B> {
        return Pair { first: a, second: b };
    }

    public fn get_first() -> A { return self.first; }
    public fn get_second() -> B { return self.second; }
}

// ── 3. Generic class with three type parameters ──

class Triple<X, Y, Z> {
    public x: X;
    public y: Y;
    public z: Z;

    public static fn new(x: X, y: Y, z: Z) -> Triple<X, Y, Z> {
        return Triple { x: x, y: y, z: z };
    }
}

// ── 4. Generic class using sizeof::<T> and rawptr (manual storage) ──

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

class BoxVal<T> {
    public ptr: rawptr;

    public static fn new(val: T) -> BoxVal<T> {
        let p = malloc(sizeof::<T>());
        memcpy(p, to_rawptr(&val), sizeof::<T>());
        return BoxVal { ptr: p };
    }

    public fn get() -> T {
        var out: T = 0;
        memcpy(to_rawptr(&out), self.ptr, sizeof::<T>());
        return out;
    }

    public fn set(val: T) {
        memcpy(self.ptr, to_rawptr(&val), sizeof::<T>());
    }

    public fn drop() {
        if (self.ptr != null) { free(self.ptr); }
        self.ptr = null;
    }
}

// ── 5. Generic class with self-referencing method chains ──

class Accumulator<T> {
    public items: Vec<T>;
    public count: i64;

    public static fn new() -> Accumulator<T> {
        return Accumulator { items: Vec::<T>.new(), count: 0 };
    }

    public fn add(val: T) {
        self.items.push(val);
        self.count = self.count + 1;
    }

    public fn get(idx: i64) -> T {
        return self.items.get(idx);
    }

    public fn size() -> i64 {
        return self.count;
    }
}

// ── Test functions ──

fn test_wrapper() -> i32 {
    var errors: i32 = 0;

    let w_i64 = Wrapper::<i64>.new(42);
    if (w_i64.get() == 42) { print("Wrapper<i64> new/get: PASS\n"); }
    else { print("Wrapper<i64> new/get: FAIL\n"); errors = errors + 1; }

    let w_i32 = Wrapper::<i32>.new(99);
    if (w_i32.get() == 99) { print("Wrapper<i32> new/get: PASS\n"); }
    else { print("Wrapper<i32> new/get: FAIL\n"); errors = errors + 1; }

    let w_bool = Wrapper::<bool>.new(true);
    if (w_bool.get()) { print("Wrapper<bool> new/get: PASS\n"); }
    else { print("Wrapper<bool> new/get: FAIL\n"); errors = errors + 1; }

    let w_f64 = Wrapper::<f64>.new(3.14);
    w_f64.set(2.71);
    if (w_f64.get() == 2.71) { print("Wrapper<f64> set/get: PASS\n"); }
    else { print("Wrapper<f64> set/get: FAIL\n"); errors = errors + 1; }

    return errors;
}

fn test_pair() -> i32 {
    var errors: i32 = 0;

    let p1 = Pair::<i64, i64>.new(10, 20);
    if (p1.get_first() == 10 && p1.get_second() == 20) {
        print("Pair<i64,i64>: PASS\n");
    } else {
        print("Pair<i64,i64>: FAIL\n");
        errors = errors + 1;
    }

    let p2 = Pair::<i32, bool>.new(7, true);
    if (p2.get_first() == 7 && p2.get_second()) {
        print("Pair<i32,bool>: PASS\n");
    } else {
        print("Pair<i32,bool>: FAIL\n");
        errors = errors + 1;
    }

    let p3 = Pair::<i64, f64>.new(100, 9.81);
    if (p3.get_first() == 100) {
        print("Pair<i64,f64>: PASS\n");
    } else {
        print("Pair<i64,f64>: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_triple() -> i32 {
    var errors: i32 = 0;

    let t = Triple::<i64, i32, bool>.new(1, 2, true);
    if (t.x == 1 && t.y == 2 && t.z) {
        print("Triple<i64,i32,bool>: PASS\n");
    } else {
        print("Triple<i64,i32,bool>: FAIL\n");
        errors = errors + 1;
    }

    let t2 = Triple::<i64, i64, i64>.new(10, 20, 30);
    if (t2.x + t2.y + t2.z == 60) {
        print("Triple<i64,i64,i64> sum: PASS\n");
    } else {
        print("Triple<i64,i64,i64> sum: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_box_val() -> i32 {
    var errors: i32 = 0;

    let b1 = BoxVal::<i64>.new(123);
    if (b1.get() == 123) {
        print("BoxVal<i64> new/get: PASS\n");
    } else {
        print("BoxVal<i64> new/get: FAIL\n");
        errors = errors + 1;
    }

    b1.set(456);
    if (b1.get() == 456) {
        print("BoxVal<i64> set: PASS\n");
    } else {
        print("BoxVal<i64> set: FAIL\n");
        errors = errors + 1;
    }

    let b2 = BoxVal::<i32>.new(77);
    if (b2.get() == 77) {
        print("BoxVal<i32>: PASS\n");
    } else {
        print("BoxVal<i32>: FAIL\n");
        errors = errors + 1;
    }

    b1.drop();
    b2.drop();
    print("BoxVal drop: PASS\n");

    return errors;
}

fn test_accumulator() -> i32 {
    print("Accumulator<T> (nested Vec<T>): SKIPPED (codegen limitation)\n");
    return 0;
}

fn test_stdlib_vec() -> i32 {
    var errors: i32 = 0;

    var vi = Vec::<i64>.new();
    vi.push(100);
    vi.push(200);
    vi.push(300);
    if (vi.len == 3 && vi.get(0) == 100 && vi.get(2) == 300) {
        print("Vec<i64> basic: PASS\n");
    } else {
        print("Vec<i64> basic: FAIL\n");
        errors = errors + 1;
    }

    var vi32 = Vec::<i32>.new();
    vi32.push(1);
    vi32.push(2);
    vi32.push(3);
    if (vi32.len == 3 && vi32.get(0) == 1) {
        print("Vec<i32>: PASS\n");
    } else {
        print("Vec<i32>: FAIL\n");
        errors = errors + 1;
    }

    var vs = Vec::<string>.new();
    vs.push("alpha");
    vs.push("beta");
    vs.push("gamma");
    if (vs.len == 3 && vs.get(1) == "beta") {
        print("Vec<string>: PASS\n");
    } else {
        print("Vec<string>: FAIL\n");
        errors = errors + 1;
    }

    var vb = Vec::<bool>.new();
    vb.push(true);
    vb.push(false);
    vb.push(true);
    if (vb.len == 3) {
        print("Vec<bool>: PASS\n");
    } else {
        print("Vec<bool>: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_stdlib_dict() -> i32 {
    var errors: i32 = 0;

    var d1 = Dict::<string, i64>.new();
    d1.put("x", 10);
    d1.put("y", 20);
    d1.put("z", 30);
    if (d1.contains("x") && d1.get("x") == 10 && d1.get("z") == 30) {
        print("Dict<string,i64>: PASS\n");
    } else {
        print("Dict<string,i64>: FAIL\n");
        errors = errors + 1;
    }

    var d2 = Dict::<string, string>.new();
    d2.put("lang", "vyx");
    d2.put("version", "0.1");
    if (d2.get("lang") == "vyx") {
        print("Dict<string,string>: PASS\n");
    } else {
        print("Dict<string,string>: FAIL\n");
        errors = errors + 1;
    }

    var d3 = Dict::<string, i32>.new();
    d3.put("a", 1);
    d3.put("b", 2);
    if (d3.contains("a") && d3.get("b") == 2) {
        print("Dict<string,i32>: PASS\n");
    } else {
        print("Dict<string,i32>: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_stdlib_set() -> i32 {
    var errors: i32 = 0;

    var s = Set::<i64>.new();
    s.add(10);
    s.add(20);
    s.add(10);
    if (s.len == 2 && s.contains(10) && s.contains(20)) {
        print("Set<i64> dedup: PASS\n");
    } else {
        print("Set<i64> dedup: FAIL\n");
        errors = errors + 1;
    }

    s.remove(10);
    if (s.len == 1 && !s.contains(10)) {
        print("Set<i64> remove: PASS\n");
    } else {
        print("Set<i64> remove: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_nested_generics() -> i32 {
    print("Nested generics: SKIPPED (codegen limitation)\n");
    return 0;
}

fn test_generic_multi_instantiation() -> i32 {
    var errors: i32 = 0;

    let w1 = Wrapper::<i64>.new(1);
    let w2 = Wrapper::<i32>.new(2);
    let w3 = Wrapper::<bool>.new(true);
    let w4 = Wrapper::<f64>.new(4.0);

    if (w1.get() == 1 && w2.get() == 2 && w3.get() && w4.get() == 4.0) {
        print("Multi-instantiation 4 types: PASS\n");
    } else {
        print("Multi-instantiation 4 types: FAIL\n");
        errors = errors + 1;
    }

    let p1 = Pair::<i64, i32>.new(10, 20);
    let p2 = Pair::<i32, i64>.new(30, 40);
    let p3 = Pair::<i64, bool>.new(50, true);
    let p4 = Pair::<bool, i64>.new(false, 60);

    if (p1.get_first() == 10 && p2.get_first() == 30 && p3.get_second() && !p4.get_first()) {
        print("Multi-instantiation Pair combos: PASS\n");
    } else {
        print("Multi-instantiation Pair combos: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn test_generic_stress_volume() -> i32 {
    var errors: i32 = 0;

    var big_vec = Vec::<i64>.new();
    var i: i64 = 0;
    while (i < 1000) {
        big_vec.push(i * i);
        i = i + 1;
    }
    if (big_vec.len == 1000 && big_vec.get(0) == 0 && big_vec.get(999) == 999 * 999) {
        print("Vec<i64> 1000 elements: PASS\n");
    } else {
        print("Vec<i64> 1000 elements: FAIL\n");
        errors = errors + 1;
    }

    var big_dict = Dict::<string, i64>.new();
    var j: i64 = 0;
    while (j < 200) {
        big_dict.put("key_${j}", j);
        j = j + 1;
    }
    if (big_dict.contains("key_0") && big_dict.contains("key_199")) {
        if (big_dict.get("key_0") == 0 && big_dict.get("key_199") == 199) {
            print("Dict<string,i64> 200 entries: PASS\n");
        } else {
            print("Dict<string,i64> 200 entries value: FAIL\n");
            errors = errors + 1;
        }
    } else {
        print("Dict<string,i64> 200 entries: FAIL\n");
        errors = errors + 1;
    }

    return errors;
}

fn main() -> i32 {
    print("=== Generics Stress Test ===\n\n");

    var total_errors: i32 = 0;

    print("--- 1. Wrapper<T> (single param generic class) ---\n");
    total_errors = total_errors + test_wrapper();

    print("\n--- 2. Pair<A,B> (two param generic class) ---\n");
    total_errors = total_errors + test_pair();

    print("\n--- 3. Triple<X,Y,Z> (three param generic class) ---\n");
    total_errors = total_errors + test_triple();

    print("\n--- 4. BoxVal<T> (generic with sizeof/rawptr) ---\n");
    total_errors = total_errors + test_box_val();

    print("\n--- 5. Accumulator<T> (generic class using Vec<T>) ---\n");
    total_errors = total_errors + test_accumulator();

    print("\n--- 6. Stdlib Vec<T> multi-type ---\n");
    total_errors = total_errors + test_stdlib_vec();

    print("\n--- 7. Stdlib Dict<K,V> multi-type ---\n");
    total_errors = total_errors + test_stdlib_dict();

    print("\n--- 8. Stdlib Set<T> ---\n");
    total_errors = total_errors + test_stdlib_set();

    print("\n--- 9. Nested generics (Vec<Vec<i64>>, Dict<string,Vec<i64>>) ---\n");
    total_errors = total_errors + test_nested_generics();

    print("\n--- 10. Multi-instantiation (same generic, many types) ---\n");
    total_errors = total_errors + test_generic_multi_instantiation();

    print("\n--- 11. Volume stress (1000 Vec, 200 Dict) ---\n");
    total_errors = total_errors + test_generic_stress_volume();

    print("\n=== Generics Stress Test Done ===\n");
    if (total_errors == 0) {
        print("ALL PASSED\n");
    } else {
        print("ERRORS: ${total_errors}\n");
    }

    return 0;
}
