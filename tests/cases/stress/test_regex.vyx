use std.regex;
use std.collections;
use std.string;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); }
    else { print("FAIL: ${name}"); }
}

// ============================================================
//  std.regex basic functions
// ============================================================

fn test_match_char() {
    print("\n=== match_char ===");
    check("dot_matches_A", match_char(65, 46) == 1);
    check("dot_matches_0", match_char(48, 46) == 1);
    check("dot_matches_space", match_char(32, 46) == 1);
    check("exact_A_A", match_char(65, 65) == 1);
    check("exact_A_B", match_char(65, 66) == 0);
    check("exact_0_0", match_char(48, 48) == 1);
}

fn test_is_word_char() {
    print("\n=== is_word_char ===");
    check("word_A", is_word_char(65) == 1);
    check("word_Z", is_word_char(90) == 1);
    check("word_a", is_word_char(97) == 1);
    check("word_z", is_word_char(122) == 1);
    check("word_0", is_word_char(48) == 1);
    check("word_9", is_word_char(57) == 1);
    check("word__", is_word_char(95) == 1);
    check("not_word_space", is_word_char(32) == 0);
    check("not_word_dot", is_word_char(46) == 0);
    check("not_word_at", is_word_char(64) == 0);
}

fn test_is_digit_char() {
    print("\n=== is_digit_char ===");
    check("digit_0", is_digit_char(48) == 1);
    check("digit_5", is_digit_char(53) == 1);
    check("digit_9", is_digit_char(57) == 1);
    check("not_digit_A", is_digit_char(65) == 0);
    check("not_digit_space", is_digit_char(32) == 0);
}

fn test_is_whitespace() {
    print("\n=== is_whitespace ===");
    check("ws_space", is_whitespace(32) == 1);
    check("ws_tab", is_whitespace(9) == 1);
    check("ws_newline", is_whitespace(10) == 1);
    check("ws_cr", is_whitespace(13) == 1);
    check("not_ws_A", is_whitespace(65) == 0);
    check("not_ws_0", is_whitespace(48) == 0);
}

// ============================================================
//  Pattern matching — lexer-level token classification
// ============================================================

fn classify_char(ch: i32) -> string {
    if (is_whitespace(ch) == 1) { return "ws"; }
    if (is_digit_char(ch) == 1) { return "digit"; }
    if (is_word_char(ch) == 1) { return "word"; }
    if (ch == 40 || ch == 41) { return "paren"; }
    if (ch == 123 || ch == 125) { return "brace"; }
    if (ch == 91 || ch == 93) { return "bracket"; }
    if (ch == 59) { return "semi"; }
    if (ch == 58) { return "colon"; }
    if (ch == 44) { return "comma"; }
    if (ch == 46) { return "dot"; }
    if (ch == 61) { return "eq"; }
    if (ch == 43 || ch == 45 || ch == 42 || ch == 47) { return "op"; }
    if (ch == 60 || ch == 62) { return "angle"; }
    if (ch == 34) { return "quote"; }
    return "other";
}

fn test_char_classification() {
    print("\n=== Char classification ===");
    check("classify_A", classify_char(65) == "word");
    check("classify_5", classify_char(53) == "digit");
    check("classify_sp", classify_char(32) == "ws");
    check("classify_(", classify_char(40) == "paren");
    check("classify_{", classify_char(123) == "brace");
    check("classify_;", classify_char(59) == "semi");
    check("classify_+", classify_char(43) == "op");
    check("classify_<", classify_char(60) == "angle");
    check("classify_\"", classify_char(34) == "quote");
}

// ============================================================
//  Lexer simulation — string scanning with regex-like patterns
// ============================================================

fn scan_identifier(s: string, start: i64) -> i64 {
    var pos = start;
    let first = str_char_at(s, pos);
    if (is_word_char(first) == 0 || is_digit_char(first) == 1) { return start; }
    while (pos < s.len) {
        let ch = str_char_at(s, pos);
        if (is_word_char(ch) == 0) { break; }
        pos += 1;
    }
    return pos;
}

fn scan_number(s: string, start: i64) -> i64 {
    var pos = start;
    while (pos < s.len && is_digit_char(str_char_at(s, pos)) == 1) {
        pos += 1;
    }
    return pos;
}

fn scan_whitespace(s: string, start: i64) -> i64 {
    var pos = start;
    while (pos < s.len && is_whitespace(str_char_at(s, pos)) == 1) {
        pos += 1;
    }
    return pos;
}

fn test_lexer_scanning() {
    print("\n=== Lexer scanning ===");

    let src = "fn main() -> i32";
    var pos: i64 = 0;

    let end1 = scan_identifier(src, pos);
    check("scan_fn", end1 == 2 && str_substring(src, pos, end1) == "fn");
    pos = scan_whitespace(src, end1);

    let end2 = scan_identifier(src, pos);
    check("scan_main", str_substring(src, pos, end2) == "main");
    pos = end2;

    check("scan_paren", str_char_at(src, pos) == 40);
}

fn test_full_tokenize() {
    print("\n=== Full tokenize ===");

    let src = "let x: i32 = 42;";
    var tokens = Vec::<string>.new();
    var pos: i64 = 0;

    while (pos < src.len) {
        pos = scan_whitespace(src, pos);
        if (pos >= src.len) { break; }

        let ch = str_char_at(src, pos);

        if (is_word_char(ch) == 1 && is_digit_char(ch) == 0) {
            let end = scan_identifier(src, pos);
            tokens.push(str_substring(src, pos, end));
            pos = end;
        } elif (is_digit_char(ch) == 1) {
            let end = scan_number(src, pos);
            tokens.push(str_substring(src, pos, end));
            pos = end;
        } else {
            let tok = str_substring(src, pos, pos + 1);
            tokens.push(tok);
            pos += 1;
        }
    }

    check("full_tok_count", tokens.len == 7);
    check("full_tok_let", tokens.get(0) == "let");
    check("full_tok_x", tokens.get(1) == "x");
    check("full_tok_colon", tokens.get(2) == ":");
    check("full_tok_i32", tokens.get(3) == "i32");
    check("full_tok_eq", tokens.get(4) == "=");
    check("full_tok_42", tokens.get(5) == "42");
    check("full_tok_semi", tokens.get(6) == ";");
}

// ============================================================
//  Pattern matching — wildcard glob simulation
// ============================================================

fn glob_match(pattern: string, text: string) -> bool {
    var pi: i64 = 0;
    var ti: i64 = 0;
    var star_pi: i64 = -1;
    var star_ti: i64 = -1;

    while (ti < text.len) {
        if (pi < pattern.len && match_char(str_char_at(text, ti), str_char_at(pattern, pi)) == 1) {
            pi += 1;
            ti += 1;
        } elif (pi < pattern.len && str_char_at(pattern, pi) == 42) {
            star_pi = pi;
            star_ti = ti;
            pi += 1;
        } elif (star_pi >= 0) {
            pi = star_pi + 1;
            star_ti += 1;
            ti = star_ti;
        } else {
            return false;
        }
    }
    while (pi < pattern.len && str_char_at(pattern, pi) == 42) {
        pi += 1;
    }
    return pi == pattern.len;
}

fn test_new_char_classes() {
    print("\n=== New char classes ===");
    check("hex_a", is_hex_char(97) == 1);
    check("hex_f", is_hex_char(102) == 1);
    check("hex_A", is_hex_char(65) == 1);
    check("hex_9", is_hex_char(57) == 1);
    check("not_hex_g", is_hex_char(103) == 0);

    check("is_alpha_A", is_alpha(65) == 1);
    check("is_alpha_z", is_alpha(122) == 1);
    check("not_alpha_5", is_alpha(53) == 0);
    check("is_alnum_5", is_alnum(53) == 1);
    check("is_alnum_A", is_alnum(65) == 1);
    check("not_alnum_sp", is_alnum(32) == 0);

    check("to_upper_a", to_upper(97) == 65);
    check("to_upper_A", to_upper(65) == 65);
    check("to_lower_A", to_lower(65) == 97);
    check("to_lower_a", to_lower(97) == 97);
}

fn test_glob_match_std() {
    print("\n=== Glob matching (std) ===");
    check("glob_exact", glob_match("hello", "hello"));
    check("glob_star_end", glob_match("hel*", "hello"));
    check("glob_star_start", glob_match("*llo", "hello"));
    check("glob_star_mid", glob_match("h*o", "hello"));
    check("glob_star_all", glob_match("*", "anything"));
    check("glob_dot", glob_match("h.llo", "hello"));
    check("glob_no_match", !glob_match("xyz", "hello"));
    check("glob_star_multi", glob_match("*.vyx", "main.vyx"));
    check("glob_complex", glob_match("test_*_stress.*", "test_vec_stress.vyx"));
    check("glob_question", glob_match("h?llo", "hello"));
    check("glob_q_no", !glob_match("h?lo", "hello"));
}

fn test_scan_helpers() {
    print("\n=== Scan helpers ===");

    let src = "hello123  world";
    let e1 = scan_while_word(src, 0);
    check("scan_word_hello123", e1 == 8);
    let e2 = scan_while_ws(src, e1);
    check("scan_ws", e2 == 10);
    let e3 = scan_while_word(src, e2);
    check("scan_word_world", e3 == 15);

    let nums = "42abc";
    let e4 = scan_while_digit(nums, 0);
    check("scan_digit_42", e4 == 2);

    check("char_at_h", char_at(src, 0) == 104);
    check("char_at_oob", char_at(src, 999) == -1);
}

fn test_wildcard_find() {
    print("\n=== Wildcard find ===");

    check("wf_exact", wildcard_find("hello world", "world") == 6);
    check("wf_start", wildcard_find("hello world", "hello") == 0);
    check("wf_missing", wildcard_find("hello world", "xyz") == -1);
    check("wf_question", wildcard_find("hello world", "w?rld") == 6);
    check("wf_dot", wildcard_find("hello world", "w.rld") == 6);
}

fn main() -> i32 {
    print("=== Regex & Pattern Matching Stress Test ===");

    test_match_char();
    test_is_word_char();
    test_is_digit_char();
    test_is_whitespace();
    test_new_char_classes();
    test_char_classification();
    test_lexer_scanning();
    test_full_tokenize();
    test_glob_match_std();
    test_scan_helpers();
    test_wildcard_find();

    print("\n=== Regex Tests Complete ===");
    return 0;
}
