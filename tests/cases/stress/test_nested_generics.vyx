use std.collections;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); pass_count += 1; }
    else { print("FAIL: ${name}"); fail_count += 1; }
}

fn test_vec_of_vec() {
    print("\n--- Vec<Vec<i64>> ---");
    var outer = Vec::<Vec::<i64>>.new();
    var row1 = Vec::<i64>.new();
    row1.push(1);
    row1.push(2);
    row1.push(3);
    var row2 = Vec::<i64>.new();
    row2.push(10);
    row2.push(20);
    outer.push(row1);
    outer.push(row2);

    check("vv_len", outer.len == 2);
    let r0 = outer.get(0);
    check("vv_r0_len", r0.len == 3);
    check("vv_r0_get0", r0.get(0) == 1);
    check("vv_r0_get2", r0.get(2) == 3);
    let r1 = outer.get(1);
    check("vv_r1_get0", r1.get(0) == 10);
    check("vv_r1_get1", r1.get(1) == 20);
}

fn test_dict_of_vec() {
    print("\n--- Dict<string,Vec<i64>> ---");
    var d = Dict::<string, Vec::<i64>>.new();
    var v1 = Vec::<i64>.new();
    v1.push(100);
    v1.push(200);
    d.put("nums", v1);

    check("dv_contains", d.contains("nums"));
    let retrieved = d.get("nums");
    check("dv_len", retrieved.len == 2);
    check("dv_get0", retrieved.get(0) == 100);
    check("dv_get1", retrieved.get(1) == 200);
}

fn test_3layer_vec() {
    print("\n--- Vec<Vec<Vec<i64>>> (3D) ---");
    var cube = Vec::<Vec::<Vec::<i64>>>.new();
    var layer = Vec::<Vec::<i64>>.new();
    var row = Vec::<i64>.new();
    row.push(42);
    layer.push(row);
    cube.push(layer);

    check("3d_len", cube.len == 1);
    let l0 = cube.get(0);
    check("3d_l0_len", l0.len == 1);
    let r0 = l0.get(0);
    check("3d_r0_len", r0.len == 1);
    check("3d_val", r0.get(0) == 42);
}

fn test_matrix_sim() {
    print("\n--- Matrix (Vec<Vec<i64>>) ---");
    var matrix = Vec::<Vec::<i64>>.new();
    var i: i64 = 0;
    while (i < 5) {
        var row = Vec::<i64>.new();
        var j: i64 = 0;
        while (j < 5) {
            row.push(i * 5 + j);
            j += 1;
        }
        matrix.push(row);
        i += 1;
    }
    check("mat_rows", matrix.len == 5);
    let r2 = matrix.get(2);
    check("mat_r2_cols", r2.len == 5);
    check("mat_2_3", r2.get(3) == 13);
    check("mat_0_0", matrix.get(0).get(0) == 0);
    check("mat_4_4", matrix.get(4).get(4) == 24);
}

fn test_dict_of_dict() {
    print("\n--- Dict<string,Dict<string,i64>> ---");
    var outer = Dict::<string, Dict::<string, i64>>.new();
    var inner = Dict::<string, i64>.new();
    inner.put("x", 10);
    inner.put("y", 20);
    outer.put("point1", inner);

    check("dd_contains", outer.contains("point1"));
    let p = outer.get("point1");
    check("dd_x", p.get("x") == 10);
    check("dd_y", p.get("y") == 20);
}

fn main() -> i32 {
    print("=== Nested Generics Test ===");

    test_vec_of_vec();
    test_dict_of_vec();
    test_3layer_vec();
    test_matrix_sim();
    test_dict_of_dict();

    print("\n=== Results ===");
    if (fail_count > 0) {
        print("FAIL: ${fail_count}");
        return 1;
    }
    print("ALL PASSED");
    return 0;
}
