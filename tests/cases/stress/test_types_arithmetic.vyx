fn main() -> i32 {
    var pass_count: i32 = 0;
    var fail_count: i32 = 0;

    // ============================================================
    //  1. Basic integer types - declarations and identity
    // ============================================================

    let a_i8: i8 = 127;
    let a_i16: i16 = 32767;
    let a_i32: i32 = 2147483647;
    let a_i64: i64 = 9223372036854775807;

    let a_u8: u8 = 255;
    let a_u16: u16 = 65535;
    let a_u32: u32 = 4294967295;
    let a_u64: u64 = 4000000000;

    if (a_i8 == 127) { print("PASS: i8 max"); pass_count += 1; }
    else { print("FAIL: i8 max"); fail_count += 1; }

    if (a_i16 == 32767) { print("PASS: i16 max"); pass_count += 1; }
    else { print("FAIL: i16 max"); fail_count += 1; }

    if (a_i32 == 2147483647) { print("PASS: i32 max"); pass_count += 1; }
    else { print("FAIL: i32 max"); fail_count += 1; }

    if (a_i64 == 9223372036854775807) { print("PASS: i64 max"); pass_count += 1; }
    else { print("FAIL: i64 max"); fail_count += 1; }

    if (a_u8 == 255) { print("PASS: u8 max"); pass_count += 1; }
    else { print("FAIL: u8 max"); fail_count += 1; }

    if (a_u16 == 65535) { print("PASS: u16 max"); pass_count += 1; }
    else { print("FAIL: u16 max"); fail_count += 1; }

    if (a_u32 == 4294967295) { print("PASS: u32 max"); pass_count += 1; }
    else { print("FAIL: u32 max"); fail_count += 1; }

    if (a_u64 == 4000000000) { print("PASS: u64 large"); pass_count += 1; }
    else { print("FAIL: u64 large"); fail_count += 1; }

    // Signed min values
    let min_i8: i8 = (-128) as i8;
    let min_i16: i16 = (-32768) as i16;
    let min_i32: i32 = (-2147483647 - 1) as i32;

    if (min_i8 == -128) { print("PASS: i8 min"); pass_count += 1; }
    else { print("FAIL: i8 min"); fail_count += 1; }

    if (min_i16 == -32768) { print("PASS: i16 min"); pass_count += 1; }
    else { print("FAIL: i16 min"); fail_count += 1; }

    if (min_i32 == -2147483648) { print("PASS: i32 min"); pass_count += 1; }
    else { print("FAIL: i32 min"); fail_count += 1; }

    // ============================================================
    //  2. Floating point types
    // ============================================================

    let f1: f32 = 3.14;
    let f2: f64 = 2.718281828459045;

    if (f1 > 3.13 && f1 < 3.15) { print("PASS: f32 value"); pass_count += 1; }
    else { print("FAIL: f32 value"); fail_count += 1; }

    if (f2 > 2.718 && f2 < 2.719) { print("PASS: f64 value"); pass_count += 1; }
    else { print("FAIL: f64 value"); fail_count += 1; }

    // ============================================================
    //  3. Bool type
    // ============================================================

    let bt: bool = true;
    let bf: bool = false;

    if (bt == true) { print("PASS: bool true"); pass_count += 1; }
    else { print("FAIL: bool true"); fail_count += 1; }

    if (bf == false) { print("PASS: bool false"); pass_count += 1; }
    else { print("FAIL: bool false"); fail_count += 1; }

    if (bt && !bf) { print("PASS: bool logic"); pass_count += 1; }
    else { print("FAIL: bool logic"); fail_count += 1; }

    if (bt || bf) { print("PASS: bool or"); pass_count += 1; }
    else { print("FAIL: bool or"); fail_count += 1; }

    // ============================================================
    //  4. Char type
    // ============================================================

    let c1: char = 'A';
    let c2: char = 'z';

    if (c1 == 'A') { print("PASS: char A"); pass_count += 1; }
    else { print("FAIL: char A"); fail_count += 1; }

    if (c2 == 'z') { print("PASS: char z"); pass_count += 1; }
    else { print("FAIL: char z"); fail_count += 1; }

    // ============================================================
    //  5. Arithmetic operations on i32
    // ============================================================

    let x: i32 = 100;
    let y: i32 = 37;

    let add_r: i32 = x + y;
    if (add_r == 137) { print("PASS: i32 add"); pass_count += 1; }
    else { print("FAIL: i32 add, got ${add_r}"); fail_count += 1; }

    let sub_r: i32 = x - y;
    if (sub_r == 63) { print("PASS: i32 sub"); pass_count += 1; }
    else { print("FAIL: i32 sub, got ${sub_r}"); fail_count += 1; }

    let mul_r: i32 = x * y;
    if (mul_r == 3700) { print("PASS: i32 mul"); pass_count += 1; }
    else { print("FAIL: i32 mul, got ${mul_r}"); fail_count += 1; }

    let div_r: i32 = x / y;
    if (div_r == 2) { print("PASS: i32 div"); pass_count += 1; }
    else { print("FAIL: i32 div, got ${div_r}"); fail_count += 1; }

    let mod_r: i32 = x % y;
    if (mod_r == 26) { print("PASS: i32 mod"); pass_count += 1; }
    else { print("FAIL: i32 mod, got ${mod_r}"); fail_count += 1; }

    // Negative arithmetic
    let neg1: i32 = -50;
    let neg2: i32 = -20;

    let neg_add: i32 = neg1 + neg2;
    if (neg_add == -70) { print("PASS: negative add"); pass_count += 1; }
    else { print("FAIL: negative add, got ${neg_add}"); fail_count += 1; }

    let neg_sub: i32 = neg1 - neg2;
    if (neg_sub == -30) { print("PASS: negative sub"); pass_count += 1; }
    else { print("FAIL: negative sub, got ${neg_sub}"); fail_count += 1; }

    let neg_mul: i32 = neg1 * neg2;
    if (neg_mul == 1000) { print("PASS: negative mul"); pass_count += 1; }
    else { print("FAIL: negative mul, got ${neg_mul}"); fail_count += 1; }

    // ============================================================
    //  6. Arithmetic on i64
    // ============================================================

    let lx: i64 = 1000000000;
    let ly: i64 = 2000000000;
    let lsum: i64 = lx + ly;
    if (lsum == 3000000000) { print("PASS: i64 add large"); pass_count += 1; }
    else { print("FAIL: i64 add large"); fail_count += 1; }

    let lprod: i64 = lx * 3;
    if (lprod == 3000000000) { print("PASS: i64 mul large"); pass_count += 1; }
    else { print("FAIL: i64 mul large"); fail_count += 1; }

    // ============================================================
    //  7. Floating point arithmetic
    // ============================================================

    let fa: f64 = 10.5;
    let fb: f64 = 3.2;

    let fadd: f64 = fa + fb;
    if (fadd > 13.6 && fadd < 13.8) { print("PASS: f64 add"); pass_count += 1; }
    else { print("FAIL: f64 add"); fail_count += 1; }

    let fsub: f64 = fa - fb;
    if (fsub > 7.2 && fsub < 7.4) { print("PASS: f64 sub"); pass_count += 1; }
    else { print("FAIL: f64 sub"); fail_count += 1; }

    let fmul: f64 = fa * fb;
    if (fmul > 33.5 && fmul < 33.7) { print("PASS: f64 mul"); pass_count += 1; }
    else { print("FAIL: f64 mul"); fail_count += 1; }

    let fdiv: f64 = fa / fb;
    if (fdiv > 3.28 && fdiv < 3.29) { print("PASS: f64 div"); pass_count += 1; }
    else { print("FAIL: f64 div"); fail_count += 1; }

    // ============================================================
    //  8. Comparison operators
    // ============================================================

    let cmp_a: i32 = 10;
    let cmp_b: i32 = 20;

    if (cmp_a < cmp_b) { print("PASS: i32 less than"); pass_count += 1; }
    else { print("FAIL: i32 less than"); fail_count += 1; }

    if (cmp_b > cmp_a) { print("PASS: i32 greater than"); pass_count += 1; }
    else { print("FAIL: i32 greater than"); fail_count += 1; }

    if (cmp_a <= 10) { print("PASS: i32 less equal"); pass_count += 1; }
    else { print("FAIL: i32 less equal"); fail_count += 1; }

    if (cmp_b >= 20) { print("PASS: i32 greater equal"); pass_count += 1; }
    else { print("FAIL: i32 greater equal"); fail_count += 1; }

    if (cmp_a != cmp_b) { print("PASS: i32 not equal"); pass_count += 1; }
    else { print("FAIL: i32 not equal"); fail_count += 1; }

    if (cmp_a == 10) { print("PASS: i32 equal"); pass_count += 1; }
    else { print("FAIL: i32 equal"); fail_count += 1; }

    // Float comparison
    let cmp_f1: f64 = 1.0;
    let cmp_f2: f64 = 2.0;

    if (cmp_f1 < cmp_f2) { print("PASS: f64 less than"); pass_count += 1; }
    else { print("FAIL: f64 less than"); fail_count += 1; }

    if (cmp_f2 > cmp_f1) { print("PASS: f64 greater than"); pass_count += 1; }
    else { print("FAIL: f64 greater than"); fail_count += 1; }

    // Unsigned comparison
    let cmp_u1: u32 = 10;
    let cmp_u2: u32 = 20;

    if (cmp_u1 < cmp_u2) { print("PASS: u32 less than"); pass_count += 1; }
    else { print("FAIL: u32 less than"); fail_count += 1; }

    if (cmp_u2 > cmp_u1) { print("PASS: u32 greater than"); pass_count += 1; }
    else { print("FAIL: u32 greater than"); fail_count += 1; }

    // ============================================================
    //  9. Bitwise operations
    // ============================================================

    let bw_a: i32 = 0xFF;
    let bw_b: i32 = 0x0F;

    let bw_and: i32 = bw_a & bw_b;
    if (bw_and == 0x0F) { print("PASS: bitwise AND"); pass_count += 1; }
    else { print("FAIL: bitwise AND, got ${bw_and}"); fail_count += 1; }

    let bw_or: i32 = bw_a | bw_b;
    if (bw_or == 0xFF) { print("PASS: bitwise OR"); pass_count += 1; }
    else { print("FAIL: bitwise OR, got ${bw_or}"); fail_count += 1; }

    let bw_xor: i32 = bw_a ^ bw_b;
    if (bw_xor == 0xF0) { print("PASS: bitwise XOR"); pass_count += 1; }
    else { print("FAIL: bitwise XOR, got ${bw_xor}"); fail_count += 1; }

    let bw_not: i32 = ~0;
    if (bw_not == -1) { print("PASS: bitwise NOT"); pass_count += 1; }
    else { print("FAIL: bitwise NOT, got ${bw_not}"); fail_count += 1; }

    // Shift operations
    let sh_val: i32 = 1;
    let sh_left: i32 = sh_val << 4;
    if (sh_left == 16) { print("PASS: shift left"); pass_count += 1; }
    else { print("FAIL: shift left, got ${sh_left}"); fail_count += 1; }

    let sh_right: i32 = 256 >> 3;
    if (sh_right == 32) { print("PASS: shift right"); pass_count += 1; }
    else { print("FAIL: shift right, got ${sh_right}"); fail_count += 1; }

    // Unsigned shift
    let ush_val: u32 = 0x80000000;
    let ush_right: u32 = ush_val >> 1;
    if (ush_right == 0x40000000) { print("PASS: unsigned shift right"); pass_count += 1; }
    else { print("FAIL: unsigned shift right"); fail_count += 1; }

    // ============================================================
    //  10. Type casting (as)
    // ============================================================

    let cast_i32: i32 = 42;
    let cast_to_i64: i64 = cast_i32 as i64;
    if (cast_to_i64 == 42) { print("PASS: i32 as i64"); pass_count += 1; }
    else { print("FAIL: i32 as i64"); fail_count += 1; }

    let cast_to_f64: f64 = cast_i32 as f64;
    if (cast_to_f64 > 41.9 && cast_to_f64 < 42.1) { print("PASS: i32 as f64"); pass_count += 1; }
    else { print("FAIL: i32 as f64"); fail_count += 1; }

    let cast_f: f64 = 3.99;
    let cast_to_i: i32 = cast_f as i32;
    if (cast_to_i == 3) { print("PASS: f64 as i32 truncates"); pass_count += 1; }
    else { print("FAIL: f64 as i32 truncates, got ${cast_to_i}"); fail_count += 1; }

    let cast_neg_f: f64 = -7.8;
    let cast_neg_to_i: i32 = cast_neg_f as i32;
    if (cast_neg_to_i == -7) { print("PASS: negative f64 as i32"); pass_count += 1; }
    else { print("FAIL: negative f64 as i32, got ${cast_neg_to_i}"); fail_count += 1; }

    // Widen small int
    let cast_i8v: i8 = 100;
    let cast_i8_to_i32: i32 = cast_i8v as i32;
    if (cast_i8_to_i32 == 100) { print("PASS: i8 as i32"); pass_count += 1; }
    else { print("FAIL: i8 as i32"); fail_count += 1; }

    // Narrow large int
    let cast_big: i32 = 300;
    let cast_big_to_i8: i8 = cast_big as i8;
    if (cast_big_to_i8 == 44) { print("PASS: i32 as i8 truncation"); pass_count += 1; }
    else { print("FAIL: i32 as i8 truncation"); fail_count += 1; }

    // Unsigned to signed
    let cast_u: u32 = 200;
    let cast_u_to_i: i32 = cast_u as i32;
    if (cast_u_to_i == 200) { print("PASS: u32 as i32"); pass_count += 1; }
    else { print("FAIL: u32 as i32"); fail_count += 1; }

    // f32 to f64
    let cast_f32v: f32 = 1.5;
    let cast_f32_to_f64: f64 = cast_f32v as f64;
    if (cast_f32_to_f64 > 1.4 && cast_f32_to_f64 < 1.6) { print("PASS: f32 as f64"); pass_count += 1; }
    else { print("FAIL: f32 as f64"); fail_count += 1; }

    // ============================================================
    //  11. Compound assignment operators
    // ============================================================

    var ca: i32 = 10;
    ca += 5;
    if (ca == 15) { print("PASS: +="); pass_count += 1; }
    else { print("FAIL: +=, got ${ca}"); fail_count += 1; }

    ca -= 3;
    if (ca == 12) { print("PASS: -="); pass_count += 1; }
    else { print("FAIL: -=, got ${ca}"); fail_count += 1; }

    ca *= 4;
    if (ca == 48) { print("PASS: *="); pass_count += 1; }
    else { print("FAIL: *=, got ${ca}"); fail_count += 1; }

    ca /= 6;
    if (ca == 8) { print("PASS: /="); pass_count += 1; }
    else { print("FAIL: /=, got ${ca}"); fail_count += 1; }

    ca %= 3;
    if (ca == 2) { print("PASS: %="); pass_count += 1; }
    else { print("FAIL: %=, got ${ca}"); fail_count += 1; }

    // Bitwise compound assignments
    var bca: i32 = 0xFF;
    bca &= 0x0F;
    if (bca == 0x0F) { print("PASS: &="); pass_count += 1; }
    else { print("FAIL: &=, got ${bca}"); fail_count += 1; }

    bca |= 0xF0;
    if (bca == 0xFF) { print("PASS: |="); pass_count += 1; }
    else { print("FAIL: |=, got ${bca}"); fail_count += 1; }

    bca ^= 0x0F;
    if (bca == 0xF0) { print("PASS: ^="); pass_count += 1; }
    else { print("FAIL: ^=, got ${bca}"); fail_count += 1; }

    var shca: i32 = 1;
    shca <<= 8;
    if (shca == 256) { print("PASS: <<="); pass_count += 1; }
    else { print("FAIL: <<=, got ${shca}"); fail_count += 1; }

    shca >>= 4;
    if (shca == 16) { print("PASS: >>="); pass_count += 1; }
    else { print("FAIL: >>=, got ${shca}"); fail_count += 1; }

    // Float compound assignment
    var fca: f64 = 10.0;
    fca += 2.5;
    if (fca > 12.4 && fca < 12.6) { print("PASS: f64 +="); pass_count += 1; }
    else { print("FAIL: f64 +="); fail_count += 1; }

    fca *= 2.0;
    if (fca > 24.9 && fca < 25.1) { print("PASS: f64 *="); pass_count += 1; }
    else { print("FAIL: f64 *="); fail_count += 1; }

    // ============================================================
    //  12. Mixed-width integer arithmetic
    // ============================================================

    let mix_a: i16 = 100;
    let mix_b: i32 = 200;
    let mix_r: i32 = (mix_a as i32) + mix_b;
    if (mix_r == 300) { print("PASS: i16+i32 mixed"); pass_count += 1; }
    else { print("FAIL: i16+i32 mixed"); fail_count += 1; }

    let mix_u8: u8 = 200;
    let mix_u16: u16 = 1000;
    let mix_u_r: u16 = (mix_u8 as u16) + mix_u16;
    if (mix_u_r == 1200) { print("PASS: u8+u16 mixed"); pass_count += 1; }
    else { print("FAIL: u8+u16 mixed"); fail_count += 1; }

    // ============================================================
    //  13. Overflow boundary tests (wrapping behavior)
    // ============================================================

    let ovf_u8: u8 = 255;
    let ovf_u8_r: u8 = ovf_u8 + 1 as u8;
    if (ovf_u8_r == 0) { print("PASS: u8 overflow wraps to 0"); pass_count += 1; }
    else { print("FAIL: u8 overflow"); fail_count += 1; }

    let ovf_i8_max: i8 = 127;
    let ovf_i8_r: i8 = ovf_i8_max + 1 as i8;
    if (ovf_i8_r == -128) { print("PASS: i8 overflow wraps to -128"); pass_count += 1; }
    else { print("FAIL: i8 overflow"); fail_count += 1; }

    // ============================================================
    //  14. Zero and identity operations
    // ============================================================

    let z: i32 = 0;
    let val: i32 = 42;

    if (val + z == 42) { print("PASS: add zero identity"); pass_count += 1; }
    else { print("FAIL: add zero identity"); fail_count += 1; }

    if (val * 1 == 42) { print("PASS: mul one identity"); pass_count += 1; }
    else { print("FAIL: mul one identity"); fail_count += 1; }

    if (val * z == 0) { print("PASS: mul zero"); pass_count += 1; }
    else { print("FAIL: mul zero"); fail_count += 1; }

    if (val - val == 0) { print("PASS: self subtract"); pass_count += 1; }
    else { print("FAIL: self subtract"); fail_count += 1; }

    // ============================================================
    //  15. Unary operators
    // ============================================================

    let pos: i32 = 42;
    let negated: i32 = -pos;
    if (negated == -42) { print("PASS: unary negate"); pass_count += 1; }
    else { print("FAIL: unary negate"); fail_count += 1; }

    let double_neg: i32 = -negated;
    if (double_neg == 42) { print("PASS: double negate"); pass_count += 1; }
    else { print("FAIL: double negate"); fail_count += 1; }

    let not_true: bool = !true;
    if (not_true == false) { print("PASS: not true"); pass_count += 1; }
    else { print("FAIL: not true"); fail_count += 1; }

    let not_false: bool = !false;
    if (not_false == true) { print("PASS: not false"); pass_count += 1; }
    else { print("FAIL: not false"); fail_count += 1; }

    // ============================================================
    //  16. Chained and complex expressions
    // ============================================================

    let chain: i32 = 2 + 3 * 4;
    if (chain == 14) { print("PASS: precedence mul before add"); pass_count += 1; }
    else { print("FAIL: precedence, got ${chain}"); fail_count += 1; }

    let paren: i32 = (2 + 3) * 4;
    if (paren == 20) { print("PASS: parenthesized expr"); pass_count += 1; }
    else { print("FAIL: parenthesized expr, got ${paren}"); fail_count += 1; }

    let complex: i32 = ((10 + 20) * 3 - 5) / 5;
    if (complex == 17) { print("PASS: complex arithmetic"); pass_count += 1; }
    else { print("FAIL: complex arithmetic, got ${complex}"); fail_count += 1; }

    // ============================================================
    //  Summary
    // ============================================================

    print("");
    print("========================================");
    print("Total PASS: ${pass_count}");
    print("Total FAIL: ${fail_count}");
    print("========================================");

    return fail_count;
}
