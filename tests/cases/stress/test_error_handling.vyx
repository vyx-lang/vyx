use std.core;

error ParseError {
    UnexpectedToken,
    InvalidNumber(string),
    MissingField(string),
}

error IOError {
    NotFound,
    PermissionDenied,
    Timeout,
}

fn always_fail_parse() -> Result<i32, ParseError> {
    fail ParseError.UnexpectedToken;
}

fn parse_number(input: string) -> Result<i32, ParseError> {
    if (input == "42") {
        return 42;
    }
    if (input == "0") {
        return 0;
    }
    fail ParseError.InvalidNumber;
}

fn read_config(path: string) -> Result<string, IOError> {
    if (path == "valid.conf") {
        return "key=value";
    }
    fail IOError.NotFound;
}

fn chain_parse(input: string) -> Result<i32, ParseError> {
    let val = parse_number(input)?;
    return val + 100;
}

fn double_chain(input: string) -> Result<i32, ParseError> {
    let a = parse_number(input)?;
    let b = parse_number("42")?;
    return a + b;
}

fn find_item(id: i32) -> Option<string> {
    if (id == 1) { return Some("apple"); }
    if (id == 2) { return Some("banana"); }
    return None;
}

fn find_price(name: string) -> Option<i32> {
    if (name == "apple") { return Some(3); }
    if (name == "banana") { return Some(5); }
    return None;
}

fn test_error_definition() -> i32 {
    let r1 = always_fail_parse();
    match (r1) {
        case Err(_) => { print("PASS: error definition - fail returns Err"); }
        case Ok(_) => { print("FAIL: error definition - expected Err"); return 1; }
    }
    return 0;
}

fn test_fail_expression() -> i32 {
    let r1 = parse_number("42");
    match (r1) {
        case Ok(v) => {
            if (v == 42) { print("PASS: fail expr - Ok(42) on valid input"); }
            else { print("FAIL: fail expr - expected 42, got ${v}"); return 1; }
        }
        case Err(_) => { print("FAIL: fail expr - expected Ok"); return 1; }
    }

    let r2 = parse_number("bad");
    match (r2) {
        case Err(_) => { print("PASS: fail expr - Err on invalid input"); }
        case Ok(_) => { print("FAIL: fail expr - expected Err on bad input"); return 1; }
    }
    return 0;
}

fn test_try_expression() -> i32 {
    let r1 = chain_parse("42");
    match (r1) {
        case Ok(v) => {
            if (v == 142) { print("PASS: try expr - propagated Ok gives 142"); }
            else { print("FAIL: try expr - expected 142, got ${v}"); return 1; }
        }
        case Err(_) => { print("FAIL: try expr - expected Ok from chain_parse"); return 1; }
    }

    let r2 = chain_parse("bad");
    match (r2) {
        case Err(_) => { print("PASS: try expr - error propagated through ?"); }
        case Ok(_) => { print("FAIL: try expr - expected Err propagation"); return 1; }
    }
    return 0;
}

fn make_ok_10() -> Result<i32, ParseError> {
    return 10;
}

fn test_result_usage() -> i32 {
    let r1 = make_ok_10();
    if (r1.is_ok()) { print("PASS: Result - Ok is_ok() returns true"); }
    else { print("FAIL: Result - Ok is_ok() should be true"); return 1; }

    let r2: Result<i32, ParseError> = parse_number("bad");
    if (r2.is_err()) { print("PASS: Result - Err is_err() returns true"); }
    else { print("FAIL: Result - Err is_err() should be true"); return 1; }

    let v = r1.unwrap();
    if (v == 10) { print("PASS: Result - unwrap Ok gives 10"); }
    else { print("FAIL: Result - unwrap Ok expected 10, got ${v}"); return 1; }

    let d = r2.unwrap_or(99);
    if (d == 99) { print("PASS: Result - unwrap_or Err gives default 99"); }
    else { print("FAIL: Result - unwrap_or expected 99, got ${d}"); return 1; }

    return 0;
}

fn test_error_propagation() -> i32 {
    let r1 = double_chain("42");
    match (r1) {
        case Ok(v) => {
            if (v == 84) { print("PASS: propagation - double chain Ok gives 84"); }
            else { print("FAIL: propagation - expected 84, got ${v}"); return 1; }
        }
        case Err(_) => { print("FAIL: propagation - expected Ok"); return 1; }
    }

    let r2 = double_chain("bad");
    match (r2) {
        case Err(_) => { print("PASS: propagation - first ? propagates Err"); }
        case Ok(_) => { print("FAIL: propagation - expected Err propagation"); return 1; }
    }

    return 0;
}

fn test_match_result() -> i32 {
    let r1 = read_config("valid.conf");
    match (r1) {
        case Ok(s) => { print("PASS: match Result - Ok branch matched"); }
        case Err(_) => { print("FAIL: match Result - expected Ok branch"); return 1; }
    }

    let r2 = read_config("missing.conf");
    match (r2) {
        case Err(_) => { print("PASS: match Result - Err branch matched"); }
        case Ok(_) => { print("FAIL: match Result - expected Err branch"); return 1; }
    }

    let r3 = parse_number("0");
    match (r3) {
        case Ok(v) => {
            if (v == 0) { print("PASS: match Result - Ok(0) correctly matched"); }
            else { print("FAIL: match Result - expected 0, got ${v}"); return 1; }
        }
        case Err(_) => { print("FAIL: match Result - expected Ok(0)"); return 1; }
    }

    return 0;
}

fn test_option_usage() -> i32 {
    let o1 = find_item(1);
    match (o1) {
        case Some(name) => { print("PASS: Option - Some found 'apple'"); }
        case None => { print("FAIL: Option - expected Some for id=1"); return 1; }
    }

    let o2 = find_item(999);
    match (o2) {
        case None => { print("PASS: Option - None for missing id"); }
        case Some(_) => { print("FAIL: Option - expected None for id=999"); return 1; }
    }

    if (o1.isSome()) { print("PASS: Option - isSome() on Some is true"); }
    else { print("FAIL: Option - isSome() should be true"); return 1; }

    if (o2.isNone()) { print("PASS: Option - isNone() on None is true"); }
    else { print("FAIL: Option - isNone() should be true"); return 1; }

    let v = o1.unwrap();
    if (v == "apple") { print("PASS: Option - unwrap Some gives 'apple'"); }
    else { print("FAIL: Option - unwrap expected 'apple'"); return 1; }

    let d = o2.unwrap_or("default");
    if (d == "default") { print("PASS: Option - unwrap_or None gives 'default'"); }
    else { print("FAIL: Option - unwrap_or expected 'default'"); return 1; }

    return 0;
}

fn main() -> i32 {
    var failed: i32 = 0;

    failed = failed + test_error_definition();
    failed = failed + test_fail_expression();
    failed = failed + test_try_expression();
    failed = failed + test_result_usage();
    failed = failed + test_error_propagation();
    failed = failed + test_match_result();
    failed = failed + test_option_usage();

    if (failed == 0) {
        print("All error handling tests passed.");
    } else {
        print("${failed} test group(s) failed.");
    }

    return 0;
}
