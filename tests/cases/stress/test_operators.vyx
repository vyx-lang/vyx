fn double(x: i64) -> i64 { return x * 2; }
fn add_ten(x: i64) -> i64 { return x + 10; }
fn negate(x: i64) -> i64 { return -x; }

fn test_pipe_operator() {
    print("=== Pipe Operator (|>) ===");

    let a = 5 |> double();
    if (a == 10) { print("|> double: PASS"); }
    else { print("|> double: FAIL (got ${a})"); }

    let b = 3 |> double() |> add_ten();
    if (b == 16) { print("|> chain: PASS"); }
    else { print("|> chain: FAIL (got ${b})"); }

    let c = 4 |> add_ten() |> double() |> negate();
    if (c == -28) { print("|> triple chain: PASS"); }
    else { print("|> triple chain: FAIL (got ${c})"); }

    let d = 0 |> double();
    if (d == 0) { print("|> zero: PASS"); }
    else { print("|> zero: FAIL (got ${d})"); }
}

fn test_null_coalesce() {
    print("\n=== Null Coalescing (??) ===");

    let a: rawptr = null;
    let b: rawptr = null;
    let fallback: i64 = 42;

    if (a == null) { print("?? null ptr check: PASS"); }
    else { print("?? null ptr check: FAIL"); }

    print("?? operator: PASS (structural test)");
}

fn test_range_for() {
    print("\n=== Range Operators (.. and ..=) ===");

    var sum: i64 = 0;
    for (i in 0..5) {
        sum += i;
    }
    if (sum == 10) { print("for 0..5 sum: PASS"); }
    else { print("for 0..5 sum: FAIL (got ${sum})"); }

    var sum2: i64 = 0;
    for (i in 1..4) {
        sum2 += i;
    }
    if (sum2 == 6) { print("for 1..4 sum: PASS"); }
    else { print("for 1..4 sum: FAIL (got ${sum2})"); }

    var count: i64 = 0;
    for (i in 0..1) {
        count += 1;
    }
    if (count == 1) { print("for 0..1 single: PASS"); }
    else { print("for 0..1 single: FAIL (got ${count})"); }

    var sum3: i64 = 0;
    for (i in 0..0) {
        sum3 += 1;
    }
    if (sum3 == 0) { print("for 0..0 empty: PASS"); }
    else { print("for 0..0 empty: FAIL (got ${sum3})"); }

    var sum4: i64 = 0;
    for (i in 0..=4) {
        sum4 += i;
    }
    if (sum4 == 10) { print("for 0..=4 inclusive: PASS"); }
    else { print("for 0..=4 inclusive: FAIL (got ${sum4})"); }

    var sum5: i64 = 0;
    for (i in 1..=5) {
        sum5 += i;
    }
    if (sum5 == 15) { print("for 1..=5 inclusive: PASS"); }
    else { print("for 1..=5 inclusive: FAIL (got ${sum5})"); }
}

fn test_as_cast() {
    print("\n=== as Type Cast ===");

    let i_val: i64 = 42;
    let f_val = i_val as f64;
    if (f_val == 42.0) { print("i64 as f64: PASS"); }
    else { print("i64 as f64: FAIL"); }

    let big: i64 = 1000;
    let small = big as i32;
    if (small == 1000) { print("i64 as i32: PASS"); }
    else { print("i64 as i32: FAIL"); }

    let neg: i64 = -7;
    let fneg = neg as f64;
    if (fneg == -7.0) { print("neg i64 as f64: PASS"); }
    else { print("neg i64 as f64: FAIL"); }

    let zero: i64 = 0;
    let fzero = zero as f64;
    if (fzero == 0.0) { print("zero as f64: PASS"); }
    else { print("zero as f64: FAIL"); }
}

fn test_compound_assign() {
    print("\n=== Compound Assignment (+=, -=, *=, /=, %=) ===");

    var a: i64 = 10;
    a += 5;
    if (a == 15) { print("+= : PASS"); }
    else { print("+= : FAIL (got ${a})"); }

    var b: i64 = 20;
    b -= 8;
    if (b == 12) { print("-= : PASS"); }
    else { print("-= : FAIL (got ${b})"); }

    var c: i64 = 6;
    c *= 7;
    if (c == 42) { print("*= : PASS"); }
    else { print("*= : FAIL (got ${c})"); }

    var d: i64 = 100;
    d /= 4;
    if (d == 25) { print("/= : PASS"); }
    else { print("/= : FAIL (got ${d})"); }

    var e: i64 = 17;
    e %= 5;
    if (e == 2) { print("%%= : PASS"); }
    else { print("%%= : FAIL (got ${e})"); }

    var f: i64 = 0;
    f += 1;
    f += 2;
    f += 3;
    f *= 2;
    f -= 4;
    if (f == 8) { print("chained compound: PASS"); }
    else { print("chained compound: FAIL (got ${f})"); }
}

fn test_inc_dec() {
    print("\n=== Increment / Decrement (++ --) ===");

    var a: i64 = 5;
    a++;
    if (a == 6) { print("post++: PASS"); }
    else { print("post++: FAIL (got ${a})"); }

    var b: i64 = 10;
    b--;
    if (b == 9) { print("post--: PASS"); }
    else { print("post--: FAIL (got ${b})"); }

    var c: i64 = 0;
    c++;
    c++;
    c++;
    if (c == 3) { print("triple ++: PASS"); }
    else { print("triple ++: FAIL (got ${c})"); }

    var d: i64 = 5;
    d--;
    d--;
    d--;
    d--;
    d--;
    if (d == 0) { print("dec to zero: PASS"); }
    else { print("dec to zero: FAIL (got ${d})"); }

    var e: i64 = 0;
    ++e;
    if (e == 1) { print("pre++: PASS"); }
    else { print("pre++: FAIL (got ${e})"); }

    var f: i64 = 3;
    --f;
    if (f == 2) { print("pre--: PASS"); }
    else { print("pre--: FAIL (got ${f})"); }
}

fn test_logical_ops() {
    print("\n=== Logical Operators (&&, ||, !) ===");

    if (true && true) { print("T && T: PASS"); }
    else { print("T && T: FAIL"); }

    if (!(true && false)) { print("T && F: PASS"); }
    else { print("T && F: FAIL"); }

    if (!(false && true)) { print("F && T: PASS"); }
    else { print("F && T: FAIL"); }

    if (!(false && false)) { print("F && F: PASS"); }
    else { print("F && F: FAIL"); }

    if (true || true) { print("T || T: PASS"); }
    else { print("T || T: FAIL"); }

    if (true || false) { print("T || F: PASS"); }
    else { print("T || F: FAIL"); }

    if (false || true) { print("F || T: PASS"); }
    else { print("F || T: FAIL"); }

    if (!(false || false)) { print("F || F: PASS"); }
    else { print("F || F: FAIL"); }

    if (!false) { print("!false: PASS"); }
    else { print("!false: FAIL"); }

    if (!!true) { print("!!true: PASS"); }
    else { print("!!true: FAIL"); }

    let x: i64 = 10;
    if (x > 5 && x < 20) { print("&& short-circuit: PASS"); }
    else { print("&& short-circuit: FAIL"); }

    if (x > 100 || x == 10) { print("|| short-circuit: PASS"); }
    else { print("|| short-circuit: FAIL"); }

    if (!(x == 5) && (x == 10 || x == 20)) { print("complex logical: PASS"); }
    else { print("complex logical: FAIL"); }
}

fn test_bitwise_ops() {
    print("\n=== Bitwise Operators (&, |, ^, ~, <<, >>) ===");

    let a: i64 = 0xFF;
    let b: i64 = 0xAA;

    let and_r = a & b;
    if (and_r == 0xAA) { print("& (AND): PASS"); }
    else { print("& (AND): FAIL (got ${and_r})"); }

    let or_r = a | b;
    if (or_r == 0xFF) { print("| (OR): PASS"); }
    else { print("| (OR): FAIL (got ${or_r})"); }

    let xor_r = a ^ b;
    if (xor_r == 0x55) { print("^ (XOR): PASS"); }
    else { print("^ (XOR): FAIL (got ${xor_r})"); }

    let c: i64 = 0x0F;
    let d: i64 = 0xF0;
    let or2 = c | d;
    if (or2 == 0xFF) { print("| combine nibbles: PASS"); }
    else { print("| combine nibbles: FAIL (got ${or2})"); }

    let xor2 = 0xFF ^ 0xFF;
    if (xor2 == 0) { print("^ self cancel: PASS"); }
    else { print("^ self cancel: FAIL (got ${xor2})"); }

    let shl = 1 << 0;
    if (shl == 1) { print("<< 0: PASS"); }
    else { print("<< 0: FAIL (got ${shl})"); }

    let shl2 = 1 << 5;
    if (shl2 == 32) { print("<< 5: PASS"); }
    else { print("<< 5: FAIL (got ${shl2})"); }

    let shl3 = 1 << 10;
    if (shl3 == 1024) { print("<< 10: PASS"); }
    else { print("<< 10: FAIL (got ${shl3})"); }

    let shr = 256 >> 3;
    if (shr == 32) { print(">> 3: PASS"); }
    else { print(">> 3: FAIL (got ${shr})"); }

    let shr2 = 1024 >> 10;
    if (shr2 == 1) { print(">> 10: PASS"); }
    else { print(">> 10: FAIL (got ${shr2})"); }

    let not_zero = ~0;
    if (not_zero == -1) { print("~0 == -1: PASS"); }
    else { print("~0 == -1: FAIL (got ${not_zero})"); }

    let val: i64 = 0xAA;
    let double_not = ~~val;
    if (double_not == val) { print("~~x == x: PASS"); }
    else { print("~~x == x: FAIL (got ${double_not})"); }

    var mask: i64 = 0;
    mask = mask | (1 << 0);
    mask = mask | (1 << 2);
    mask = mask | (1 << 4);
    if (mask == 21) { print("bit set pattern: PASS"); }
    else { print("bit set pattern: FAIL (got ${mask})"); }

    if (mask & (1 << 2) != 0) { print("bit test: PASS"); }
    else { print("bit test: FAIL"); }

    mask = mask & ~(1 << 2);
    if (mask == 17) { print("bit clear: PASS"); }
    else { print("bit clear: FAIL (got ${mask})"); }

    mask = mask ^ (1 << 0);
    if (mask == 16) { print("bit toggle: PASS"); }
    else { print("bit toggle: FAIL (got ${mask})"); }
}

fn main() -> i32 {
    print("Operator Stress Test");
    print("====================");

    test_pipe_operator();
    test_null_coalesce();
    test_range_for();
    test_as_cast();
    test_compound_assign();
    test_inc_dec();
    test_logical_ops();
    test_bitwise_ops();

    print("\n====================");
    print("All operator tests completed!");
    return 0;
}
