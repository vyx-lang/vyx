// Test: Fixed-size array fields in structs

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) {
        print("PASS: ${name}");
        pass_count = pass_count + 1;
    } else {
        print("FAIL: ${name}");
        fail_count = fail_count + 1;
    }
}

struct Vec4 {
    data: [i32; 4]
}

fn test_struct_array_access() {
    print("\n=== Struct Array Field Access ===");

    var v = Vec4 { data: [1, 2, 3, 4] };
    check("v.data[0]==1", v.data[0] == 1);
    check("v.data[1]==2", v.data[1] == 2);
    check("v.data[2]==3", v.data[2] == 3);
    check("v.data[3]==4", v.data[3] == 4);

    v.data[0] = 10;
    check("v.data[0]==10_after_assign", v.data[0] == 10);
}

fn main() -> i32 {
    test_struct_array_access();
    print("\n=== RESULTS: ${pass_count} passed, ${fail_count} failed ===");
    if (fail_count > 0) { return 1; }
    return 0;
}
