use std.core;
use std.collections;
use std.algorithm;
use std.string;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); pass_count += 1; }
    else { print("FAIL: ${name}"); fail_count += 1; }
}

// ============================================================
//  1. Dict<string, Vec<string>> — AST child name lists
// ============================================================

fn test_ast_node_children() {
    print("\n=== Dict<string,Vec<string>> AST nodes ===");

    var ast = Dict::<string, Vec::<string>>.new();

    var fn_children = Vec::<string>.new();
    fn_children.push("name");
    fn_children.push("params");
    fn_children.push("return_type");
    fn_children.push("body");
    ast.put("FnDecl", fn_children);

    var if_children = Vec::<string>.new();
    if_children.push("condition");
    if_children.push("then_block");
    if_children.push("else_block");
    ast.put("IfStmt", if_children);

    var call_children = Vec::<string>.new();
    call_children.push("callee");
    call_children.push("arg0");
    call_children.push("arg1");
    call_children.push("arg2");
    ast.put("CallExpr", call_children);

    var class_children = Vec::<string>.new();
    class_children.push("name");
    class_children.push("fields");
    class_children.push("methods");
    class_children.push("parent");
    class_children.push("interfaces");
    ast.put("ClassDecl", class_children);

    check("ast_4_nodes", ast.len == 4);

    let fn_c = ast.get("FnDecl");
    check("fn_has_4_children", fn_c.len == 4);
    check("fn_first_child", fn_c.get(0) == "name");
    check("fn_last_child", fn_c.get(3) == "body");

    let if_c = ast.get("IfStmt");
    check("if_has_3_children", if_c.len == 3);
    check("if_condition", if_c.get(0) == "condition");

    let call_c = ast.get("CallExpr");
    check("call_has_4_children", call_c.len == 4);

    let class_c = ast.get("ClassDecl");
    check("class_has_5_children", class_c.len == 5);
    check("class_interfaces", class_c.get(4) == "interfaces");

    var all_names = Vec::<string>.new();
    var total_children: i64 = 0;
    let keys = ast.keys();
    var i: i64 = 0;
    while (i < keys.len) {
        let key = keys.get(i);
        all_names.push(key);
        let children = ast.get(key);
        total_children += children.len;
        i += 1;
    }
    check("total_children_16", total_children == 16);
    check("all_keys_4", all_names.len == 4);
}

// ============================================================
//  2. Large string operations — token processing simulation
// ============================================================

fn test_string_token_processing() {
    print("\n=== String token processing ===");

    let source = "fn main() -> i32 { let x: i64 = 42; return x + 1; }";

    check("source_len", source.len > 40);

    var pos: i64 = 0;
    var token_count: i64 = 0;
    var tokens = Vec::<string>.new();

    while (pos < source.len) {
        while (pos < source.len && str_char_at(source, pos) == 32) {
            pos += 1;
        }
        if (pos >= source.len) { break; }

        var end = pos;
        let ch = str_char_at(source, pos);

        if (ch == 40 || ch == 41 || ch == 123 || ch == 125 || ch == 59 || ch == 58 || ch == 44) {
            end = pos + 1;
        } elif (ch == 45 && pos + 1 < source.len && str_char_at(source, pos + 1) == 62) {
            end = pos + 2;
        } elif (ch == 43) {
            end = pos + 1;
        } elif (ch == 61) {
            end = pos + 1;
        } elif (char_is_digit(ch)) {
            while (end < source.len && char_is_digit(str_char_at(source, end))) {
                end += 1;
            }
        } elif (char_is_alpha(ch) || ch == 95) {
            while (end < source.len) {
                let c = str_char_at(source, end);
                if (char_is_alpha(c) || char_is_digit(c) || c == 95) { end += 1; }
                else { break; }
            }
        } else {
            end = pos + 1;
        }

        let tok = str_substring(source, pos, end);
        tokens.push(tok);
        token_count += 1;
        pos = end;
    }

    check("tok_count>10", token_count > 10);
    check("tok_first_fn", tokens.get(0) == "fn");
    check("tok_main", tokens.get(1) == "main");

    var keyword_count: i64 = 0;
    var keywords = Dict::<string, i64>.new();
    keywords.put("fn", 1);
    keywords.put("let", 1);
    keywords.put("return", 1);
    keywords.put("i32", 1);
    keywords.put("i64", 1);

    var ki: i64 = 0;
    while (ki < tokens.len) {
        if (keywords.contains(tokens.get(ki))) {
            keyword_count += 1;
        }
        ki += 1;
    }
    check("keyword_count>=3", keyword_count >= 3);

    var has_42 = false;
    var fi: i64 = 0;
    while (fi < tokens.len) {
        if (tokens.get(fi) == "42") { has_42 = true; }
        fi += 1;
    }
    check("found_literal_42", has_42);
}

fn test_string_substring_stress() {
    print("\n=== String substring stress ===");

    let long_str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    var ok = true;
    var i: i64 = 0;
    while (i < 50) {
        let sub = str_substring(long_str, i, i + 3);
        if (sub.len != 3) { ok = false; }
        i += 1;
    }
    check("substring_50x", ok);

    var idx = str_index_of(long_str, "xyz");
    check("index_of_xyz", idx == 23);
    idx = str_index_of(long_str, "XYZ");
    check("index_of_XYZ", idx == 49);
    idx = str_index_of(long_str, "!!!");
    check("index_of_missing", idx == -1);

    let replaced = str_replace(long_str, "abc", "ABC");
    check("replace_start", str_starts_with(replaced, "ABC"));

    var parts = str_split(long_str, "m");
    check("split_count", parts.len == 2);
}

// ============================================================
//  3. Vec as scope stack — parser state simulation
// ============================================================

fn test_scope_stack() {
    print("\n=== Scope stack ===");

    var scope_stack = Vec::<string>.new();
    scope_stack.push("global");

    scope_stack.push("fn_main");
    scope_stack.push("if_block");
    check("scope_depth_3", scope_stack.len == 3);
    check("scope_current", scope_stack.last() == "if_block");

    scope_stack.pop();
    check("scope_pop_if", scope_stack.last() == "fn_main");

    scope_stack.push("while_block");
    scope_stack.push("nested_if");
    check("scope_depth_4", scope_stack.len == 4);

    scope_stack.pop();
    scope_stack.pop();
    scope_stack.pop();
    check("scope_back_global", scope_stack.len == 1 && scope_stack.last() == "global");
}

fn test_symbol_scope_sim() {
    print("\n=== Symbol scope simulation ===");

    var scopes = Vec::<Dict::<string, i64>>.new();

    var global_scope = Dict::<string, i64>.new();
    global_scope.put("print", 1);
    global_scope.put("main", 2);
    scopes.push(global_scope);

    var fn_scope = Dict::<string, i64>.new();
    fn_scope.put("x", 10);
    fn_scope.put("y", 20);
    scopes.push(fn_scope);

    var block_scope = Dict::<string, i64>.new();
    block_scope.put("tmp", 100);
    block_scope.put("x", 99);
    scopes.push(block_scope);

    check("scope_count_3", scopes.len == 3);

    var found = false;
    var found_val: i64 = 0;
    var si = scopes.len - 1;
    while (si >= 0) {
        let scope = scopes.get(si);
        if (scope.contains("x")) {
            found = true;
            found_val = scope.get("x");
            break;
        }
        si -= 1;
    }
    check("lookup_x_shadowed", found && found_val == 99);

    found = false;
    si = scopes.len - 1;
    while (si >= 0) {
        let scope = scopes.get(si);
        if (scope.contains("print")) {
            found = true;
            break;
        }
        si -= 1;
    }
    check("lookup_print_global", found);

    found = false;
    si = scopes.len - 1;
    while (si >= 0) {
        let scope = scopes.get(si);
        if (scope.contains("nonexist")) {
            found = true;
            break;
        }
        si -= 1;
    }
    check("lookup_missing", !found);
}

// ============================================================
//  4. String concat code generation simulation
// ============================================================

fn test_codegen_string_build() {
    print("\n=== Codegen string build ===");

    var code = "";
    code = code + "define i32 @main() {\n";
    code = code + "entry:\n";
    code = code + "  %x = alloca i32\n";
    code = code + "  store i32 42, ptr %x\n";
    code = code + "  %v = load i32, ptr %x\n";
    code = code + "  %r = add i32 %v, 1\n";
    code = code + "  ret i32 %r\n";
    code = code + "}\n";

    check("codegen_len>100", code.len > 100);
    check("codegen_has_define", code.contains("define"));
    check("codegen_has_entry", code.contains("entry:"));
    check("codegen_has_alloca", code.contains("alloca"));
    check("codegen_has_store", code.contains("store"));
    check("codegen_has_ret", code.contains("ret"));
}

fn test_codegen_multiline_build() {
    print("\n=== Codegen multiline build ===");

    var lines = Vec::<string>.new();
    var i: i64 = 0;
    while (i < 100) {
        let line = "  %v" + "${i}" + " = add i64 %v" + "${i}" + ", 1";
        lines.push(line);
        i += 1;
    }

    var code = "";
    i = 0;
    while (i < lines.len) {
        code = code + lines.get(i) + "\n";
        i += 1;
    }

    check("multiline_100_lines", lines.len == 100);
    check("multiline_has_add", code.contains("add i64"));
    check("multiline_line0_ok", lines.get(0).len > 10);
    check("multiline_long", code.len > 2000);
}

fn test_codegen_interp_stress() {
    print("\n=== Codegen interpolation stress ===");

    var labels = Vec::<string>.new();
    var i: i64 = 0;
    while (i < 200) {
        labels.push("bb_${i}");
        i += 1;
    }
    check("labels_200", labels.len == 200);
    check("label_first", labels.get(0) == "bb_0");
    check("label_last", labels.get(199) == "bb_199");
    check("label_mid", labels.get(100) == "bb_100");

    var emit_buf = Vec::<string>.new();
    i = 0;
    while (i < 50) {
        let line = "  %r" + "${i}" + " = call i64 @func(i64 " + "${i}" + ")";
        emit_buf.push(line);
        i += 1;
    }
    check("emit_50_lines", emit_buf.len == 50);
    check("emit_line0_has_call", emit_buf.get(0).contains("call"));
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== Bootstrap Pattern Stress Test ===");

    test_ast_node_children();
    test_string_token_processing();
    test_string_substring_stress();
    test_scope_stack();
    test_symbol_scope_sim();
    test_codegen_string_build();
    test_codegen_multiline_build();
    test_codegen_interp_stress();

    print("\n=== Results ===");
    print("PASS: ${pass_count}  FAIL: ${fail_count}");
    if (fail_count > 0) { return 1; }
    print("ALL PASSED");
    return 0;
}
