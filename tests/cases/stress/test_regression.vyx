use std.collections;

var pass_count: i64 = 0;
var fail_count: i64 = 0;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); pass_count = pass_count + 1; }
    else { print("FAIL: ${name}"); fail_count = fail_count + 1; }
}

// =============================================
// 1a. Closure captures string + i32 + bool
// =============================================

fn test_closure_multi_capture() {
    let n: i32 = 10;
    let b: bool = true;

    let f = |x: i32| -> i32 {
        if (b) {
            return n + x;
        }
        return -1;
    };

    check("closure_capture_i32_bool", f(5) == 15);
    check("closure_capture_i32_bool2", f(0) == 10);

    let extra: i64 = 100;
    let g = |x: i32| -> i64 {
        let sum: i32 = n + x;
        return (sum as i64) + extra;
    };
    check("closure_capture_3types", g(5) == 115);
}

// =============================================
// 1b. Closure modifies var variable
// =============================================

fn test_closure_modify_var() {
    var base: i32 = 10;
    let compute = |d: i32| -> i32 { return base + d; };
    check("closure_read_var", compute(5) == 15);

    base = 20;
    let compute2 = |d: i32| -> i32 { return base + d; };
    check("closure_read_updated_var", compute2(5) == 25);
}

// =============================================
// 1c. Closure captures another closure and calls it
// =============================================

fn test_closure_captures_closure() {
    let doubler = |x: i32| -> i32 { return x * 2; };
    let wrapper = |v: i32| -> i32 { return doubler(v) + 1; };
    check("closure_captures_closure", wrapper(5) == 11);
    check("closure_captures_closure2", wrapper(0) == 1);
}

// =============================================
// 2. Dict::<string, Vec::<string>> nested generic
// =============================================

fn test_nested_generic() {
    var d = Dict::<string, Vec::<string>>.new();

    var v1 = Vec::<string>.new();
    v1.push("apple");
    v1.push("banana");
    d.put("fruits", v1);

    var v2 = Vec::<string>.new();
    v2.push("red");
    v2.push("green");
    v2.push("blue");
    d.put("colors", v2);

    check("nested_generic_contains", d.contains("fruits") && d.contains("colors"));

    let fruits = d.get("fruits");
    let colors = d.get("colors");
    check("nested_generic_fruits", fruits.len == 2 && fruits.get(0) == "apple");
    check("nested_generic_colors", colors.len == 3 && colors.get(2) == "blue");
}

// =============================================
// 3. Match guard multi-branch + default + external var
// =============================================

fn score_against_limit(n: i32, limit: i32) -> i32 {
    if (n > limit && n < 100) { return 1; }
    if (n >= 100) { return 2; }
    if (n == limit) { return 3; }
    if (n > 0 && n < limit) { return 4; }
    if (n <= 0) { return 5; }
    return -1;
}

fn score_sign(n: i32, limit: i32) -> i32 {
    if (n > limit) { return 1; }
    if (n > 0) { return 2; }
    if (n == 0) { return 3; }
    if (n < 0) { return 4; }
    return -1;
}

fn test_match_guard_external() {
    let limit: i32 = 50;
    check("match_guard_ext_75", score_against_limit(75, limit) == 1);
    check("match_guard_ext_50", score_against_limit(50, limit) == 3);
    check("match_guard_ext_neg", score_sign(-10, limit) == 4);
}

// =============================================
// 4. |> chain + type conversion
// =============================================

fn dbl_i64(x: i64) -> i64 { return x * 2; }
fn add_ten_i64(x: i64) -> i64 { return x + 10; }
fn square_i64(x: i64) -> i64 { return x * x; }

fn test_pipe_chain_cast() {
    let v: i32 = 5;
    let v64 = v as i64;
    let r1 = v64 |> dbl_i64() |> add_ten_i64();
    check("pipe_chain_cast_2step", r1 == 20);

    let w: i32 = 3;
    let w64 = w as i64;
    let r2 = w64 |> add_ten_i64() |> dbl_i64() |> square_i64();
    check("pipe_chain_cast_3step", r2 == 676);

    let back: i32 = r1 as i32;
    check("pipe_cast_back", back == 20);
}

// =============================================
// 5. Custom error + fail + try chain 3 layers
// =============================================

error AppError {
    NotFound,
    InvalidInput(string),
    InternalError,
}

fn layer3_ok() -> Result<i32, AppError> {
    return 100;
}

fn layer3_fail() -> Result<i32, AppError> {
    fail AppError.NotFound;
}

fn layer2_ok() -> Result<i32, AppError> {
    let v = layer3_ok()?;
    return v + 10;
}

fn layer2_fail() -> Result<i32, AppError> {
    let v = layer3_fail()?;
    return v + 10;
}

fn layer1_ok() -> Result<i32, AppError> {
    let v = layer2_ok()?;
    return v + 1;
}

fn layer1_fail() -> Result<i32, AppError> {
    let v = layer2_fail()?;
    return v + 1;
}

fn test_error_try_chain() {
    let r1 = layer1_ok();
    match (r1) {
        case Ok(v) => { check("try_chain_3_ok", v == 111); }
        case Err(_) => { check("try_chain_3_ok", false); }
        default => { check("try_chain_3_ok", false); }
    }

    let r2 = layer1_fail();
    match (r2) {
        case Err(_) => { check("try_chain_3_err_propagated", true); }
        case Ok(_) => { check("try_chain_3_err_propagated", false); }
        default => { check("try_chain_3_err_propagated", false); }
    }
}

// =============================================
// 6. Enum with data, match
// =============================================

@[c_repr]
enum Token {
    Number(i32),
    Score(f64),
    Empty,
}

fn test_enum_with_data() {
    let t1 = Token.Number(42);
    let t2 = Token.Score(9.5);
    let t3 = Token.Empty;

    var r1: i32 = 0;
    match (t1) {
        case Number(n) => { r1 = n; }
        case Score(_) => { r1 = -1; }
        case Empty => { r1 = -2; }
        default => { r1 = -3; }
    }
    check("enum_data_number", r1 == 42);

    var r2: f64 = 0.0;
    match (t2) {
        case Number(_) => { r2 = -1.0; }
        case Score(s) => { r2 = s; }
        case Empty => { r2 = -2.0; }
        default => { r2 = -3.0; }
    }
    check("enum_data_score", r2 == 9.5);

    var r3: i32 = -99;
    match (t3) {
        case Number(_) => { r3 = 1; }
        case Score(_) => { r3 = 2; }
        case Empty => { r3 = 0; }
        default => { r3 = -1; }
    }
    check("enum_data_empty", r3 == 0);
}

// =============================================
// 7. u32 large number right shift
// =============================================

fn test_u32_big_shift() {
    let a: u32 = 0x80000000;
    let b = a >> 1;
    check("u32_big_rshift_1", b == 0x40000000);

    let c: u32 = 0xFFFFFFFF;
    let d = c >> 16;
    check("u32_big_rshift_16", d == 0xFFFF);

    let e: u32 = 3000000000;
    let shifted = e >> 4;
    check("u32_big_rshift_large", shifted == 187500000);
}

// =============================================
// 8. Multiple default parameters combination
// =============================================

fn config(w: i32 = 800, h: i32 = 600, depth: i32 = 32, title: string = "App") -> string {
    return "${title}_${w}x${h}x${depth}";
}

fn test_multi_default_params() {
    check("defaults_all", config() == "App_800x600x32");
    check("defaults_w_only", config(1024) == "App_1024x600x32");
    check("defaults_wh", config(1920, 1080) == "App_1920x1080x32");
    check("defaults_whd", config(640, 480, 16) == "App_640x480x16");
    check("defaults_all_custom", config(320, 240, 8, "Game") == "Game_320x240x8");
}

// =============================================
// 9. Struct with multiple array fields
// =============================================

struct GridRow {
    a: [i32; 4]
    b: [i32; 3]
}

fn test_struct_multi_array() {
    var g = GridRow { a: [1, 2, 3, 4], b: [10, 20, 30] };

    check("struct_multi_arr_read_a", g.a[0] == 1 && g.a[1] == 2 && g.a[2] == 3 && g.a[3] == 4);
    check("struct_multi_arr_read_b", g.b[0] == 10 && g.b[1] == 20 && g.b[2] == 30);

    g.a[0] = 100;
    g.b[2] = 300;
    check("struct_multi_arr_write", g.a[0] == 100 && g.b[2] == 300);

    let sum = g.a[0] + g.a[1] + g.a[2] + g.a[3] + g.b[0] + g.b[1] + g.b[2];
    check("struct_multi_arr_sum", sum == 439);
}

// =============================================
// 10. Comprehensive: generics + closures + match + error
// =============================================

error ProcessError {
    InvalidValue,
    Overflow,
}

fn process_val(v: i32) -> Result<i32, ProcessError> {
    if (v < 0) { fail ProcessError.InvalidValue; }
    if (v > 1000) { fail ProcessError.Overflow; }
    return v * 2;
}

fn test_comprehensive() {
    var vals = Vec::<i32>.new();
    vals.push(10);
    vals.push(-5);
    vals.push(42);
    vals.push(2000);

    let transform = |x: i32| -> i32 { return x + 100; };

    var ok_count: i32 = 0;
    var err_count: i32 = 0;
    var total: i32 = 0;

    var i: i64 = 0;
    while (i < vals.len) {
        let v = vals.get(i);
        let tv = transform(v);
        let r = process_val(tv);
        match (r) {
            case Ok(val) => {
                ok_count += 1;
                if (val > 200) { total += val; }
                else { total += 1; }
            }
            case Err(_) => { err_count += 1; }
            default => {}
        }
        i += 1;
    }

    check("combo_ok_count", ok_count == 3);
    check("combo_err_count", err_count == 1);
    check("combo_total", total == 505);
}

// =============================================
// Entry point
// =============================================

fn main() -> i32 {
    print("=== Regression Test Suite ===");

    test_closure_multi_capture();
    test_closure_modify_var();
    test_closure_captures_closure();
    test_nested_generic();
    test_match_guard_external();
    test_pipe_chain_cast();
    test_error_try_chain();
    test_enum_with_data();
    test_u32_big_shift();
    test_multi_default_params();
    test_struct_multi_array();
    test_comprehensive();

    print("=== Results: ${pass_count} passed, ${fail_count} failed ===");
    if (fail_count == 0) {
        print("ALL REGRESSION TESTS PASSED");
    } else {
        print("SOME TESTS FAILED");
    }
    return 0;
}
