fn test_passed(name: string) { print("PASS: ${name}"); }
fn test_failed(name: string) { print("FAIL: ${name}"); }
fn check(name: string, cond: bool) { if (cond) { test_passed(name); } else { test_failed(name); } }

// ============================================================
//  match integer — basic cases
// ============================================================

fn test_match_int_basic() {
    var r1: i32 = 0;
    var r2: i32 = 0;
    var r3: i32 = 0;

    match (1) {
        case 0 => { r1 = 10; }
        case 1 => { r1 = 11; }
        case 2 => { r1 = 12; }
        default => { r1 = -1; }
    }

    match (0) {
        case 0 => { r2 = 100; }
        case 1 => { r2 = 101; }
        default => { r2 = -1; }
    }

    match (99) {
        case 0 => { r3 = 0; }
        case 1 => { r3 = 1; }
        default => { r3 = 999; }
    }

    check("match_int_basic", r1 == 11 && r2 == 100 && r3 == 999);
}

fn test_match_int_negative() {
    var r: i32 = 0;
    var x: i32 = -1;
    match (x) {
        case 0 => { r = 0; }
        case 1 => { r = 1; }
        default => { r = -99; }
    }
    check("match_int_negative", r == -99);
}

fn test_match_int_many_cases() {
    var results: i32 = 0;
    var i: i32 = 0;
    while (i < 8) {
        var r: i32 = 0;
        match (i) {
            case 0 => { r = 10; }
            case 1 => { r = 20; }
            case 2 => { r = 30; }
            case 3 => { r = 40; }
            case 4 => { r = 50; }
            case 5 => { r = 60; }
            case 6 => { r = 70; }
            case 7 => { r = 80; }
            default => { r = -1; }
        }
        results = results + r;
        i = i + 1;
    }
    check("match_int_many_cases", results == 360);
}

// ============================================================
//  match string — basic cases
// ============================================================

fn test_match_string_basic() {
    var r: i32 = 0;
    match ("hello") {
        case "world" => { r = 1; }
        case "hello" => { r = 2; }
        case "foo" => { r = 3; }
        default => { r = -1; }
    }
    check("match_string_basic", r == 2);
}

fn test_match_string_default() {
    var r: i32 = 0;
    match ("unknown") {
        case "a" => { r = 1; }
        case "b" => { r = 2; }
        default => { r = 42; }
    }
    check("match_string_default", r == 42);
}

fn test_match_string_empty() {
    var r: i32 = 0;
    match ("") {
        case "" => { r = 1; }
        case "notempty" => { r = 2; }
        default => { r = -1; }
    }
    check("match_string_empty", r == 1);
}

fn test_match_string_variable() {
    let s = "bar";
    var r: i32 = 0;
    match (s) {
        case "foo" => { r = 1; }
        case "bar" => { r = 2; }
        case "baz" => { r = 3; }
        default => { r = -1; }
    }
    check("match_string_variable", r == 2);
}

fn test_match_string_in_loop() {
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < 3) {
        var tag = "b";
        if (i == 0) { tag = "a"; }
        elif (i == 2) { tag = "c"; }

        match (tag) {
            case "a" => { total = total + 1; }
            case "b" => { total = total + 10; }
            case "c" => { total = total + 100; }
            default => { total = total + 1000; }
        }
        i = i + 1;
    }
    check("match_string_in_loop", total == 111);
}

// ============================================================
//  match with guard conditions
// ============================================================

fn test_match_guard_int() {
    var x: i32 = 15;
    var r: i32 = 0;
    if (x < 0) { r = -1; }
    else if (x < 10) { r = 1; }
    else if (x < 20) { r = 2; }
    else if (x < 100) { r = 3; }
    else { r = 99; }
    check("match_guard_int", r == 2);
}

fn test_match_guard_boundary() {
    var r1: i32 = 0;
    var r2: i32 = 0;
    var r3: i32 = 0;

    var a: i32 = 0;
    if (a < 0) { r1 = -1; }
    else if (a == 0) { r1 = 0; }
    else if (a > 0) { r1 = 1; }
    else { r1 = 99; }

    var b: i32 = -1;
    if (b < 0) { r2 = -1; }
    else if (b == 0) { r2 = 0; }
    else { r2 = 99; }

    var c: i32 = 100;
    if (c < 50) { r3 = 1; }
    else if (c >= 50) { r3 = 2; }
    else { r3 = 99; }

    check("match_guard_boundary", r1 == 0 && r2 == -1 && r3 == 2);
}

fn test_match_guard_complex() {
    var x: i32 = 42;
    var r: i32 = 0;
    if (x % 2 == 0 && x > 40) { r = 1; }
    else if (x % 2 == 0) { r = 2; }
    else { r = 3; }
    check("match_guard_complex", r == 1);
}

// ============================================================
//  match enum variant — basic ADT matching
// ============================================================

@[c_repr]
enum Color {
    Red,
    Green,
    Blue,
}

fn color_to_int(c: Color) -> i32 {
    var r: i32 = -1;
    match (c) {
        case Red => { r = 0; }
        case Green => { r = 1; }
        case Blue => { r = 2; }
        default => { r = -1; }
    }
    return r;
}

fn test_match_enum_basic() {
    let r = color_to_int(Color.Red);
    let g = color_to_int(Color.Green);
    let b = color_to_int(Color.Blue);
    check("match_enum_basic", r == 0 && g == 1 && b == 2);
}

@[c_repr]
enum Shape {
    Circle(f64),
    Rect(f64),
    Point,
}

fn test_match_enum_with_data() {
    var r1: i32 = 0;
    var r2: i32 = 0;
    var r3: i32 = 0;

    let s1 = Shape.Circle(3.14);
    match (s1) {
        case Circle(v) => { r1 = 1; }
        case Rect(v) => { r1 = 2; }
        case Point => { r1 = 3; }
        default => { r1 = -1; }
    }

    let s2 = Shape.Rect(5.0);
    match (s2) {
        case Circle(v) => { r2 = 1; }
        case Rect(v) => { r2 = 2; }
        case Point => { r2 = 3; }
        default => { r2 = -1; }
    }

    let s3 = Shape.Point;
    match (s3) {
        case Circle(v) => { r3 = 1; }
        case Rect(v) => { r3 = 2; }
        case Point => { r3 = 3; }
        default => { r3 = -1; }
    }

    check("match_enum_with_data", r1 == 1 && r2 == 2 && r3 == 3);
}

fn test_match_enum_binding() {
    let s = Shape.Circle(2.5);
    var extracted: f64 = 0.0;
    match (s) {
        case Circle(radius) => { extracted = radius; }
        case Rect(side) => { extracted = side; }
        default => {}
    }
    check("match_enum_binding", extracted == 2.5);
}

fn test_match_enum_wildcard() {
    let s = Shape.Rect(10.0);
    var matched = false;
    match (s) {
        case Circle(_) => { matched = false; }
        case Rect(_) => { matched = true; }
        default => { matched = false; }
    }
    check("match_enum_wildcard", matched);
}

// ============================================================
//  default branch — various positions and types
// ============================================================

fn test_match_default_only_branch() {
    var r: i32 = 0;
    match (42) {
        case 999 => { r = 1; }
        default => { r = 77; }
    }
    check("match_default_only_branch", r == 77);
}

fn test_match_default_with_side_effects() {
    var counter: i32 = 0;
    var i: i32 = 0;
    while (i < 5) {
        match (i) {
            case 2 => { counter = counter + 100; }
            default => { counter = counter + 1; }
        }
        i = i + 1;
    }
    check("match_default_with_side_effects", counter == 104);
}

// ============================================================
//  match nesting — match inside match
// ============================================================

fn test_match_nested_int() {
    var x: i32 = 2;
    var y: i32 = 1;
    var r: i32 = 0;

    match (x) {
        case 1 => {
            match (y) {
                case 0 => { r = 10; }
                case 1 => { r = 11; }
                default => { r = 19; }
            }
        }
        case 2 => {
            match (y) {
                case 0 => { r = 20; }
                case 1 => { r = 21; }
                default => { r = 29; }
            }
        }
        default => { r = -1; }
    }
    check("match_nested_int", r == 21);
}

fn test_match_nested_string_int() {
    let mode = "fast";
    var level: i32 = 3;
    var r: i32 = 0;

    match (mode) {
        case "slow" => {
            match (level) {
                case 1 => { r = 1; }
                default => { r = 2; }
            }
        }
        case "fast" => {
            match (level) {
                case 1 => { r = 10; }
                case 2 => { r = 20; }
                case 3 => { r = 30; }
                default => { r = 99; }
            }
        }
        default => { r = -1; }
    }
    check("match_nested_string_int", r == 30);
}

fn test_match_nested_enum() {
    let c = Color.Blue;
    let s = Shape.Circle(1.0);
    var r: i32 = 0;

    match (c) {
        case Red => {
            r = 100;
        }
        case Green => {
            r = 200;
        }
        case Blue => {
            match (s) {
                case Circle(_) => { r = 301; }
                case Rect(_) => { r = 302; }
                case Point => { r = 303; }
                default => { r = 399; }
            }
        }
        default => { r = -1; }
    }
    check("match_nested_enum", r == 301);
}

// ============================================================
//  match as expression (simulate via assignment in arms)
// ============================================================

fn test_match_as_expr_int() {
    var result: string = "";
    var x: i32 = 2;
    match (x) {
        case 0 => { result = "zero"; }
        case 1 => { result = "one"; }
        case 2 => { result = "two"; }
        case 3 => { result = "three"; }
        default => { result = "other"; }
    }
    check("match_as_expr_int", result == "two");
}

fn test_match_as_expr_enum() {
    let s = Shape.Rect(7.0);
    var desc = "";
    match (s) {
        case Circle(r) => { desc = "circle"; }
        case Rect(side) => { desc = "rect"; }
        case Point => { desc = "point"; }
        default => { desc = "unknown"; }
    }
    check("match_as_expr_enum", desc == "rect");
}

fn classify(val: i32) -> string {
    var result = "";
    match (val) {
        default => {}
    }
    if (val < 0) { result = "negative"; }
    else if (val == 0) { result = "zero"; }
    else if (val <= 10) { result = "small"; }
    else if (val <= 100) { result = "medium"; }
    else { result = "large"; }
    return result;
}

fn test_match_as_expr_guard() {
    let r1 = classify(-5);
    let r2 = classify(0);
    let r3 = classify(7);
    let r4 = classify(50);
    let r5 = classify(999);
    check("match_as_expr_guard",
        r1 == "negative" && r2 == "zero" && r3 == "small" &&
        r4 == "medium" && r5 == "large");
}

// ============================================================
//  match — stress: repeated matching, many branches
// ============================================================

fn test_match_stress_loop() {
    var sum: i32 = 0;
    var i: i32 = 0;
    while (i < 100) {
        var v: i32 = i % 5;
        match (v) {
            case 0 => { sum = sum + 1; }
            case 1 => { sum = sum + 2; }
            case 2 => { sum = sum + 3; }
            case 3 => { sum = sum + 4; }
            case 4 => { sum = sum + 5; }
            default => {}
        }
        i = i + 1;
    }
    check("match_stress_loop", sum == 300);
}

fn test_match_stress_string_loop() {
    var count_a: i32 = 0;
    var count_b: i32 = 0;
    var count_c: i32 = 0;
    var count_d: i32 = 0;
    var i: i32 = 0;
    while (i < 40) {
        var tag = "d";
        var m: i32 = i % 4;
        if (m == 0) { tag = "a"; }
        elif (m == 1) { tag = "b"; }
        elif (m == 2) { tag = "c"; }

        match (tag) {
            case "a" => { count_a = count_a + 1; }
            case "b" => { count_b = count_b + 1; }
            case "c" => { count_c = count_c + 1; }
            case "d" => { count_d = count_d + 1; }
            default => {}
        }
        i = i + 1;
    }
    check("match_stress_string_loop",
        count_a == 10 && count_b == 10 && count_c == 10 && count_d == 10);
}

fn test_match_enum_in_loop() {
    var red_count: i32 = 0;
    var green_count: i32 = 0;
    var blue_count: i32 = 0;
    var i: i32 = 0;
    while (i < 30) {
        var c = Color.Red;
        var m: i32 = i % 3;
        if (m == 1) { c = Color.Green; }
        elif (m == 2) { c = Color.Blue; }

        match (c) {
            case Red => { red_count = red_count + 1; }
            case Green => { green_count = green_count + 1; }
            case Blue => { blue_count = blue_count + 1; }
            default => {}
        }
        i = i + 1;
    }
    check("match_enum_in_loop",
        red_count == 10 && green_count == 10 && blue_count == 10);
}

// ============================================================
//  main entry point
// ============================================================

fn main() -> i32 {
    print("=== Match Pattern Stress Test ===");

    test_match_int_basic();
    test_match_int_negative();
    test_match_int_many_cases();

    test_match_string_basic();
    test_match_string_default();
    test_match_string_empty();
    test_match_string_variable();
    test_match_string_in_loop();

    test_match_guard_int();
    test_match_guard_boundary();
    test_match_guard_complex();

    test_match_enum_basic();
    test_match_enum_with_data();
    test_match_enum_binding();
    test_match_enum_wildcard();

    test_match_default_only_branch();
    test_match_default_with_side_effects();

    test_match_nested_int();
    test_match_nested_string_int();
    test_match_nested_enum();

    test_match_as_expr_int();
    test_match_as_expr_enum();
    test_match_as_expr_guard();

    test_match_stress_loop();
    test_match_stress_string_loop();
    test_match_enum_in_loop();

    print("=== Match Pattern Stress Test Complete ===");
    return 0;
}
