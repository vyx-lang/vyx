fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); }
    else { print("FAIL: ${name}"); }
}

// ============================================================
//  sizeof — compile-time type size
// ============================================================

fn test_sizeof() {
    print("\n=== sizeof ===");

    let s_i8 = sizeof::<i8>();
    check("sizeof_i8==1", s_i8 == 1);

    let s_i16 = sizeof::<i16>();
    check("sizeof_i16==2", s_i16 == 2);

    let s_i32 = sizeof::<i32>();
    check("sizeof_i32==4", s_i32 == 4);

    let s_i64 = sizeof::<i64>();
    check("sizeof_i64==8", s_i64 == 8);

    let s_f32 = sizeof::<f32>();
    check("sizeof_f32==4", s_f32 == 4);

    let s_f64 = sizeof::<f64>();
    check("sizeof_f64==8", s_f64 == 8);

    let s_bool = sizeof::<bool>();
    check("sizeof_bool==1", s_bool == 1);

    let s_rawptr = sizeof::<rawptr>();
    check("sizeof_rawptr==8", s_rawptr == 8);
}

// ============================================================
//  sizeof with structs
// ============================================================

struct Point { x: f64  y: f64 }

struct Small { a: i32  b: i32 }

struct Mixed { a: i8  b: i64  c: i32 }

fn test_sizeof_struct() {
    print("\n=== sizeof struct ===");

    let s_point = sizeof::<Point>();
    check("sizeof_Point==16", s_point == 16);

    let s_small = sizeof::<Small>();
    check("sizeof_Small==8", s_small == 8);

    let s_mixed = sizeof::<Mixed>();
    check("sizeof_Mixed>0", s_mixed > 0);
}

// ============================================================
//  type_name — compile-time type name string
// ============================================================

fn test_type_name() {
    print("\n=== type_name ===");

    let n_i32 = type_name::<i32>();
    check("type_name_i32", n_i32 == "i32");

    let n_i64 = type_name::<i64>();
    check("type_name_i64", n_i64 == "i64");

    let n_f64 = type_name::<f64>();
    check("type_name_f64", n_f64 == "f64");

    let n_bool = type_name::<bool>();
    check("type_name_bool", n_bool == "bool");

    let n_string = type_name::<string>();
    check("type_name_string", n_string == "string" || n_string == "__String");
}

// ============================================================
//  sizeof in generic context
// ============================================================

class SizedBox<T> {
    public data: rawptr;
    public type_size: i64;

    public static fn new() -> SizedBox<T> {
        let sz = sizeof::<T>();
        return SizedBox { data: null, type_size: sz };
    }

    public fn elem_size() -> i64 {
        return sizeof::<T>();
    }
}

fn test_sizeof_generic() {
    print("\n=== sizeof in generics ===");

    let b1 = SizedBox::<i32>.new();
    check("generic_sizeof_i32==4", b1.type_size == 4);
    check("generic_elem_i32==4", b1.elem_size() == 4);

    let b2 = SizedBox::<i64>.new();
    check("generic_sizeof_i64==8", b2.type_size == 8);

    let b3 = SizedBox::<f64>.new();
    check("generic_sizeof_f64==8", b3.type_size == 8);
}

// ============================================================
//  static_assert
// ============================================================

fn test_static_assert() {
    print("\n=== static_assert ===");
    static_assert(1 + 1 == 2, "basic math");
    static_assert(sizeof::<i32>() == 4, "i32 is 4 bytes");
    static_assert(sizeof::<i64>() == 8, "i64 is 8 bytes");
    check("static_assert_compiled", true);
}

// ============================================================
//  comptime fn — compile-time callable functions
// ============================================================

comptime fn ct_add(a: i64, b: i64) -> i64 {
    return a + b;
}

comptime fn ct_factorial(n: i64) -> i64 {
    if (n <= 1) { return 1; }
    return n * ct_factorial(n - 1);
}

comptime fn ct_fib(n: i64) -> i64 {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return ct_fib(n - 1) + ct_fib(n - 2);
}

comptime fn ct_max(a: i64, b: i64) -> i64 {
    if (a > b) { return a; }
    return b;
}

fn test_comptime_fn() {
    print("\n=== comptime fn ===");

    let r1 = ct_add(3, 4);
    check("ct_add(3,4)==7", r1 == 7);

    let r2 = ct_factorial(5);
    check("ct_factorial(5)==120", r2 == 120);

    let r3 = ct_factorial(10);
    check("ct_factorial(10)==3628800", r3 == 3628800);

    let r4 = ct_fib(10);
    check("ct_fib(10)==55", r4 == 55);

    let r5 = ct_max(42, 17);
    check("ct_max(42,17)==42", r5 == 42);

    let r6 = ct_add(ct_max(10, 20), ct_factorial(3));
    check("ct_compose", r6 == 26);
}

// ============================================================
//  to_rawptr / from_cstr — memory intrinsics
// ============================================================

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn test_to_rawptr() {
    print("\n=== to_rawptr ===");

    var val: i64 = 42;
    let p = to_rawptr(&val);
    check("to_rawptr_nonnull", p != null);

    var read_back: i64 = 0;
    unsafe { memcpy(to_rawptr(&read_back), p, 8); }
    check("to_rawptr_roundtrip", read_back == 42);
}

fn test_alloc_dealloc() {
    print("\n=== alloc/dealloc ===");

    let p = malloc(sizeof::<i64>() * 10);
    check("alloc_nonnull", p != null);

    var i: i64 = 0;
    while (i < 10) {
        var v = i * 100;
        unsafe { memcpy(p + i * 8, to_rawptr(&v), 8); }
        i += 1;
    }

    var val: i64 = 0;
    unsafe { memcpy(to_rawptr(&val), p + 5 * 8, 8); }
    check("alloc_read_500", val == 500);

    free(p);
    check("dealloc_ok", true);
}

// ============================================================
//  Entry point
// ============================================================

fn main() -> i32 {
    print("=== Compile-Time Features Stress Test ===");

    test_sizeof();
    test_sizeof_struct();
    test_type_name();
    test_sizeof_generic();
    test_static_assert();
    test_comptime_fn();
    test_to_rawptr();
    test_alloc_dealloc();

    print("\n=== Compile-Time Tests Complete ===");
    return 0;
}
