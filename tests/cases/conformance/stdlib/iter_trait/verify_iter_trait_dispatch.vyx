// Concrete Iterator walk without generic Iter<T> bounds.
module p7_iter_dispatch;

use std.core;
use std.collections;

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(42);
    var it = v.iter();
    match (it.next()) {
        case Some(x) => {
            if (x != 42) { print("FAIL got ${x}"); return 1; }
        }
        case None => { print("FAIL got None"); return 1; }
    }
    print("ok");
    return 0;
}
