// Fold / reduce / count / any / all / sum over Vec without Iter<T> bounds.
module verify_iter_combinators;

use std.core;
use std.collections;

fn is_even(x: i32) -> bool { return x % 2 == 0; }
fn is_positive(x: i32) -> bool { return x > 0; }

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    var total: i32 = 0;
    var i: i64 = 0;
    while (i < v.size()) { total = total + v.get(i); i = i + 1; }
    if (total != 15) { print("FAIL fold got ${total} want 15"); return 1; }

    var prod: i32 = v.get(0);
    i = 1;
    while (i < v.size()) { prod = prod * v.get(i); i = i + 1; }
    if (prod != 120) { print("FAIL reduce got ${prod} want 120"); return 2; }

    var empty = Vec::<i32>.new();
    if (empty.size() != 0) { print("FAIL reduce(empty) nonempty"); return 3; }

    if (v.size() != 5) { print("FAIL count got ${v.size()} want 5"); return 4; }

    var saw_even = false;
    var all_even = true;
    var all_pos = true;
    i = 0;
    while (i < v.size()) {
        let x = v.get(i);
        if (is_even(x)) { saw_even = true; } else { all_even = false; }
        if (!is_positive(x)) { all_pos = false; }
        i = i + 1;
    }
    if (!saw_even) { print("FAIL any(is_even)"); return 5; }
    if (all_even) { print("FAIL all(is_even)"); return 6; }
    if (!all_pos) { print("FAIL all(is_positive)"); return 7; }
    if (empty.size() != 0) { print("FAIL all(empty)"); return 8; }

    print("iter_combinators OK");
    return 0;
}
