// Regression: generic function-value calls must keep scalar substitutions
// canonical.  A separator space in `fn(i32, i32)` used to intern ` i32` as a
// class row, so LLVM loaded the accumulator and callback arguments as ptr.
module verify_iter_fold_function_value;

use std.core;
use std.collections;

fn add_i32(a: i32, b: i32) -> i32 {
    return a + b;
}

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(1);
    values.push(2);
    let result = fold::<i32, Iterator<i32>, i32>(values.iter(), 0, add_i32);
    if (result != 3) { return 1; }
    print("iter_fold_function_value OK");
    return 0;
}
