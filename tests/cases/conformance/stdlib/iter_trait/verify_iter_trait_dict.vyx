// Phase 7: verify DictValIterator satisfies Iter<i64> via trait bound.
//
// Note: `Dict.keys()` returns `Vec<K>` (not DictKeyIterator), so we can't
// exercise DictKeyIterator directly here — its `: Iter<i64>` conformance is
// declared for documentation + future-use only.  `Dict.values()` returns
// `DictValIterator` so we test that path end-to-end.
module p7_iter_dict;

use std.core;
use std.collections;

fn first<T, I>(it: I) -> Option<T> where I: Iter<T> {
    return it.next();
}

fn main() -> i32 {
    var d = Dict::<i64, i64>.new();
    d.put(10, 100);
    d.put(20, 200);
    d.put(30, 300);

    // Dict.values() returns DictValIterator which declares `: Iter<i64>`.
    let vals_it = d.values();
    match (first::<i64, DictValIterator>(vals_it)) {
        case Some(v) => {
            if (v != 100 && v != 200 && v != 300) {
                print("FAIL unexpected val ${v}");
                return 1;
            }
            print("dict_iter val=${v}");
        }
        case None => {
            print("FAIL got None");
            return 1;
        }
    }

    d.destroy();
    return 0;
}
