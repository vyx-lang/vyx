// Phase 7 regression guard: existing `for x in iter()` over Vec and Dict
// must still work after the `Iter<T>` trait addition (we did NOT touch
// the for-in desugar).
module p7_for_in;

use std.core;
use std.collections;

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3);
    var sum: i32 = 0;
    for (x in v.iter()) {
        sum = sum + x;
    }
    if (sum != 6) { print("FAIL Vec for-in sum=${sum}"); return 1; }
    print("Vec for-in sum=${sum}");

    var d = Dict::<i64, i64>.new();
    d.put(10, 100);
    d.put(20, 200);
    var vcount: i64 = 0;
    for (val in d.values()) {
        vcount = vcount + 1;
    }
    if (vcount != 2) { print("FAIL Dict for-in count=${vcount}"); return 1; }
    print("Dict for-in count=${vcount}");
    d.destroy();
    return 0;
}
