// Vec.iter().next() returns Option<T> without a generic Iter bound.
module p7_iter_vec;

use std.core;
use std.collections;

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    var it = v.iter();
    match (it.next()) {
        case Some(x) => {
            if (x != 10) {
                print("FAIL got ${x}, want 10");
                return 1;
            }
            print("iter_trait_vec OK first=${x}");
        }
        case None => {
            print("FAIL got None");
            return 1;
        }
    }
    return 0;
}
