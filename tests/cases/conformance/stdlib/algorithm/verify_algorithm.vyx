// Phase 7 follow-up: generic algorithms over `Ord`.
//
// Covers `min` / `max` / `clamp` (scalar) and `sort` + `is_sorted` +
// `binary_search_ord` over `Vec<T>` for both a numeric primitive (`i32`)
// and `string`.  `where T: Ord` should dispatch `.compare` through the
// primitive impls in `std/hash.vyx` for primitives and through user
// `impl Ord` blocks for nominal types.
//
// Phase 9b merged `min_ord` / `max_ord` / `sort_ord` / `clamp_ord` /
// `is_sorted_ord` into the bare names (`min`, `max`, `sort`, `clamp`,
// `is_sorted`) now that free-function overload dispatch can pick between
// `std.collections`'s concrete `Vec<i64>` variants and these trait-bound
// generic variants.  `binary_search_ord` kept its suffix — both
// collections and algorithm define generic `binary_search<T>` with the
// same arity so an overload merge would be ambiguous.
module p7_algorithm_verify;

use std.algorithm;
use std.core;
use std.string;

fn main() -> i32 {
    // ── i32 path ──────────────────────────────────────────────
    var v = Vec::<i32>.new();
    v.push(3);
    v.push(1);
    v.push(4);
    v.push(1);
    v.push(5);
    v.push(9);
    v.push(2);
    v.push(6);
    sort::<i32>(v);
    if (!is_sorted::<i32>(v)) { return 1; }
    if (v.get(0) != 1) { return 2; }
    if (v.get(7) != 9) { return 3; }

    let idx = binary_search_ord::<i32>(v, 5);
    if (idx.isNone()) { return 4; }

    let m = min::<i32>(3, 7);
    if (m != 3) { return 5; }

    let mx = max::<i32>(3, 7);
    if (mx != 7) { return 6; }

    let c = clamp::<i32>(15, 0, 10);
    if (c != 10) { return 7; }
    let c2 = clamp::<i32>(-5, 0, 10);
    if (c2 != 0) { return 8; }
    let c3 = clamp::<i32>(5, 0, 10);
    if (c3 != 5) { return 9; }

    // ── string path — exercises `impl Ord for string` (str_compare) ──
    var strs = Vec::<string>.new();
    strs.push("banana");
    strs.push("apple");
    strs.push("cherry");
    sort::<string>(strs);
    if (strs.get(0) != "apple") { return 10; }
    if (strs.get(1) != "banana") { return 11; }
    if (strs.get(2) != "cherry") { return 12; }

    // ── Edge cases ────────────────────────────────────────────
    // Empty / single-element sort — must be no-op, not panic.
    var empty = Vec::<i32>.new();
    sort::<i32>(empty);
    if (empty.len != 0) { return 13; }
    var one = Vec::<i32>.new();
    one.push(42);
    sort::<i32>(one);
    if (one.get(0) != 42) { return 14; }

    // binary_search_ord miss returns None.
    let miss = binary_search_ord::<i32>(v, 100);
    if (!miss.isNone()) { return 15; }

    // binary_search_ord on empty vec — returns None without panicking.
    let miss2 = binary_search_ord::<i32>(empty, 1);
    if (!miss2.isNone()) { return 16; }

    print("ok");
    return 0;
}
