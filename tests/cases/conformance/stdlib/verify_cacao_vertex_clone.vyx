// Vec.get must clone the owning semantic string rather than copying its header.
use std.cacao;
use std.collections;
use std.string;

fn main() -> i32 {
    var attributes = Vec::<VertexInputAttribute>.new();
    let semantic = "TEX" + "COORD";
    attributes.push(VertexInputAttribute.create(2 as u32, 1 as u32, 3 as u32, 16 as u32, semantic, 1 as u32));
    let copied = attributes.get(0);
    attributes.destroy();
    if (copied.semantic_name != "TEXCOORD" || copied.location != 2 as u32 || copied.binding != 1 as u32 || copied.offset != 16 as u32 || copied.semantic_index != 1 as u32) { return 1; }
    print("cacao_vertex_clone OK");
    return 0;
}
