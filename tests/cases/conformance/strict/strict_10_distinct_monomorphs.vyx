// STRICT: distinct const values must produce distinct instantiations.
// Guards against the mangled-name collision bug where all Size<N> calls
// returned the first N seen.

fn const_id<const N: i64>() -> i64 { return N; }

fn main() -> i32 {
    // First a big one, then small — if mangle collides, small returns big.
    let big   = const_id::<100>();
    let small = const_id::<1>();
    let med   = const_id::<50>();

    if (big != 100)  { return 1; }
    if (small != 1)  { return 2; }
    if (med != 50)   { return 3; }

    // Interleave
    let a = const_id::<7>();
    let b = const_id::<7>();    // same — reuses instance
    let c = const_id::<8>();    // different
    if (a != 7 || b != 7 || c != 8) { return 4; }

    return 0;
}
