// STRICT: typeof(x) and T::name should produce matching strings for the
// concrete instantiation. Cross-check reflection consistency.

fn both<T>(v: T) -> i32 {
    let a = typeof(v);
    let b = T::name;
    if (a != b) { return 1; }
    return 0;
}

fn main() -> i32 {
    let r1 = both::<i32>(42);
    if (r1 != 0) { return 10; }

    let r2 = both::<string>("hi");
    if (r2 != 0) { return 20; }

    return 0;
}
