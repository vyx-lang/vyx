// STRICT-NEGATIVE: N=0 hits predicate, must emit P2D-004.
// Guards against the "unexpected-pass" bug where verifyConstPredicates
// was silently skipped.

fn needs_positive<const N: i64>() -> i64 where N > 0 {
    return N;
}

fn main() -> i32 {
    let zero = needs_positive::<0>();     // MUST fail with P2D-004
    return 0;
}
