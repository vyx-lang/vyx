// STRICT-NEGATIVE: applying `only_struct::<C>` to a class must fail P2D-007.
// Guards against the constraint not actually firing on instantiation.

struct S { x: i32; }
class C  { public x: i32; }

fn only_struct<T>(v: T) -> i32 where T::kind == "struct" {
    return 1;
}

fn main() -> i32 {
    let c = C { x: 7 };
    let r = only_struct::<C>(c);     // MUST fail — C is not a struct
    return 0;
}
