// STRICT: pack fold with non-commutative operator (subtraction).
// Guards against assuming + or * only; checks left-to-right associativity.

fn sub_fold<...Ts>(...args: Ts) -> i64 {
    return args...-;      // (((a0 - a1) - a2) - a3) OR (a0 - (a1 - (a2 - a3)))
                          // left-assoc: 10-1-2-3 = 4
}

fn main() -> i32 {
    let r = sub_fold(10, 1, 2, 3);
    // left-assoc: 10 - 1 - 2 - 3 = 4
    if (r != 4) { return 1; }

    let r2 = sub_fold(100, 50);
    if (r2 != 50) { return 2; }

    let r3 = sub_fold(7);
    if (r3 != 7) { return 3; }

    return 0;
}
