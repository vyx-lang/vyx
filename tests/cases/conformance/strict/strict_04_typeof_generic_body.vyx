// STRICT: typeof() inside a generic function — must return the concrete
// instantiated type, not the literal "T".

fn name_of<T>(v: T) -> string {
    return typeof(v);
}

fn main() -> i32 {
    if (name_of(42) != "i32")      { return 1; }
    if (name_of("hi") != "string") { return 2; }
    if (name_of(3.14) != "f64")    { return 3; }
    if (name_of(true) != "bool")   { return 4; }
    return 0;
}
