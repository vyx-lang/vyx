// STRICT: N boundary values — N=1 passes, N=0 fails predicate.
// Guards against implementations that compare against literal 16 instead of N.

fn needs_positive<const N: i64>() -> i64 where N > 0 {
    return N;
}

fn main() -> i32 {
    let one = needs_positive::<1>();       // minimal passing
    if (one != 1) { return 1; }

    let big = needs_positive::<999>();     // larger
    if (big != 999) { return 2; }

    let tiny = needs_positive::<42>();
    if (tiny != 42) { return 3; }

    return 0;
}
