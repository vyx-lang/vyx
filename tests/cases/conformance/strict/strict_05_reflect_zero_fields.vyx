// STRICT: T::fields on an empty class — expansion produces 0 iterations.
// Guards against off-by-one / crash on empty field list.

class Empty { }

fn count_fields<T>() -> i32 {
    var n: i32 = 0;
    for f in T::fields { n = n + 1; }
    return n;
}

fn main() -> i32 {
    let c = count_fields::<Empty>();
    if (c != 0) { return 1; }
    return 0;
}
