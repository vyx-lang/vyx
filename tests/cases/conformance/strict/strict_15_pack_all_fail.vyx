// STRICT-NEGATIVE: `all<Ts>: Printable` with a non-conforming pack member
// MUST emit P2D-005 with index.

interface Printable { fn to_string() -> string; }

class Good : Printable {
    public fn to_string() -> string { return "ok"; }
}

class Bad { public name: string; }    // no Printable impl

fn dump<...Ts>(...args: Ts) where all<Ts>: Printable { }

fn main() -> i32 {
    let g = Good { };
    let b = Bad { name: "x" };
    dump(g, b);            // P2D-005: pack member at index 1 ('Bad') fails
    return 0;
}
