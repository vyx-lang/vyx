// STRICT: mix of type param + const param — substitution must keep them
// positionally separate, neither type nor const leaking into the other.

fn echo<T, const N: i64>() -> i64 where N > 0 {
    let t = T::name;
    print(t);           // "i32" / "string" / …
    return N;
}

fn main() -> i32 {
    let a = echo::<i32, 1>();
    if (a != 1) { return 1; }

    let b = echo::<string, 99>();
    if (b != 99) { return 2; }

    // Swap type and const order of instantiation — must not alias.
    let c = echo::<bool, 5>();
    let d = echo::<i32, 5>();       // same N, different T
    let e = echo::<i32, 10>();      // same T, different N
    if (c != 5 || d != 5 || e != 10) { return 3; }

    return 0;
}
