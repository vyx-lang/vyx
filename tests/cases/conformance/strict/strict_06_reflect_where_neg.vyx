// STRICT: `where T::kind != "struct"` negation branch.
// Guards against parser accepting only `==` and dropping `!=`.

struct S { x: i32; }
class C  { public x: i32; }

fn classes_only<T>(v: T) -> i32 where T::kind != "struct" {
    return 42;
}

fn main() -> i32 {
    let c = C { x: 7 };
    let r = classes_only::<C>(c);
    if (r != 42) { return 1; }
    return 0;
}
