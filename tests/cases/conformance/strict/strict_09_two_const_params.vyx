// STRICT: two independent const params — ensure both get distinct bindings.
// Guards against second param being cached/aliased with first.

fn area<const W: i64, const H: i64>() -> i64
    where W > 0 + H > 0 {
    return W * H;
}

fn main() -> i32 {
    let a = area::<3, 5>();       // 15
    if (a != 15) { return 1; }

    let b = area::<5, 3>();       // 15 — same mangled value but different binding order
    if (b != 15) { return 2; }

    let c = area::<10, 10>();     // 100
    if (c != 100) { return 3; }

    let d = area::<2, 7>();       // 14
    if (d != 14) { return 4; }

    return 0;
}
