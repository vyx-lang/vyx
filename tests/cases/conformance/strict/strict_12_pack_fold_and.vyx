// STRICT: pack fold `&&` with mixed true/false.
// Guards against && being treated as bitwise-and or fold ignoring first arg.

fn all_true<...Bs>(...flags: Bs) -> bool {
    return flags...&&;
}

fn main() -> i32 {
    let a = all_true(true, true, true);          // true
    if (!a) { return 1; }

    let b = all_true(true, false, true);         // false
    if (b) { return 2; }

    let c = all_true(false, true, true);         // false — first arg
    if (c) { return 3; }

    let d = all_true(false);                     // single false
    if (d) { return 4; }

    let e = all_true(true);                      // single true
    if (!e) { return 5; }

    return 0;
}
