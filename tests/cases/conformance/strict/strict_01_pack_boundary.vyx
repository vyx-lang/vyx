// STRICT: pack boundary cases — 0, 1, many elements.
// Guards against implementations that hardcode len>=2.

fn pack_len<...Ts>(...args: Ts) -> i64 {
    return args.len;
}

fn main() -> i32 {
    let zero = pack_len();               // 0-arg pack
    if (zero != 0) { return 1; }

    let one  = pack_len(42);             // 1-arg pack
    if (one != 1) { return 2; }

    let five = pack_len(1, 2, 3, 4, 5);   // 5-arg pack
    if (five != 5) { return 3; }

    return 0;
}
