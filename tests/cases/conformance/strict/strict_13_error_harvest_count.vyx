// STRICT-NEGATIVE: exactly 3 distinct generic errors in one TU, expect
// the summary note to report "3 distinct failure(s)".

interface Printable { fn label() -> string; }
interface Comparable { fn cmp(other: i64) -> i64; }

class A { }         // missing label()
class B { }         // missing label()

fn log<T>(v: T) where T: Printable { print(v.label()); }
fn cmp<T>(v: T, n: i64) where T: Comparable { v.cmp(n); }
fn cycle<T>(v: T) -> T { return cycle(v); }    // self-cycle → MONO-001

fn main() -> i32 {
    let a = A {};
    let b = B {};
    log::<A>(a);          // P2D-002 error #1
    log::<B>(b);          // P2D-002 error #2 (different concrete type)
    cmp::<A>(a, 0);       // P2D-002 error #3
    let x = cycle::<i32>(1);    // MONO-001 error #4
    return 0;
}
