// P3-Q: `for f in T::fields` — compile-time expansion over class fields.

class Point {
    public x: i32;
    public y: i32;
    public z: i32;
}

fn count_fields<T>() -> i32 {
    var n: i32 = 0;
    for f in T::fields {
        n = n + 1;
    }
    return n;
}

fn main() -> i32 {
    let c = count_fields::<Point>();
    if (c != 3) { return 1; }
    return 0;
}
