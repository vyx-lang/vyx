// P3-P: `all<Ts>: Trait` pack-wide conformance check.

interface Printable { fn to_string() -> string; }

class Tag : Printable {
    public id: i32;
    public fn to_string() -> string { return "tag"; }
}

class Label : Printable {
    public name: string;
    public fn to_string() -> string { return "label"; }
}

fn dump<...Ts>(...args: Ts) where all<Ts>: Printable {
    for a in args { print(a.to_string()); }
}

fn main() -> i32 {
    let t = Tag { id: 42 };
    let l = Label { name: "A" };
    dump(t, l);
    return 0;
}
