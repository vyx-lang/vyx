// P3-Q: `where T::kind == "struct"` — reflection-constrained generic.

struct Point { x: i32; y: i32; }
class Widget  { public label: string; }

fn only_struct<T>(v: T) -> i32 where T::kind == "struct" {
    return 1;
}

fn main() -> i32 {
    let p = Point { x: 0, y: 0 };
    let r = only_struct::<Point>(p);
    if (r != 1) { return 1; }
    // `only_struct::<Widget>(w)` would P2D-xxx at compile time.
    return 0;
}
