// P3-P: `Ts.len op N` — pack cardinality refinement in where-clause.

fn first<...Ts>(...args: Ts) -> i64 where Ts.len > 0 {
    return args[0];
}

fn main() -> i32 {
    let v = first(10, 20, 30);
    if (v != 10) { return 1; }
    // Attempting `first()` here would fail `Ts.len > 0` at compile.
    return 0;
}
