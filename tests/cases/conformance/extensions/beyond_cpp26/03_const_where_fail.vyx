// P3-O: expected P2D-004 when const predicate is violated.
// Expected diagnostic line (near exact):
//   error[P2D-004]: const predicate `N > 0` not satisfied (N = 0)
// Followed by "instantiation chain:" notes.

class NonEmpty<T, const N: usize>
    where N > 0 {
    public data: [T; N];
}

fn main() -> i32 {
    let bad = NonEmpty::<i32, 0>.new();    // P2D-004: N=0 fails `N > 0`
    return 0;
}
