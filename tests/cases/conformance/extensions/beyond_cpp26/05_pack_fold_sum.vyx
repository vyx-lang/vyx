// P3-P: pack fold expression `args...+` — beyond C++26 (value-only folds).

fn sum_all<...Ts>(...args: Ts) -> i64 {
    return args...+;   // expands to args_0 + args_1 + ... + args_N-1
}

fn all_of<...Bs>(...flags: Bs) -> bool {
    return flags...&&;   // fold with && — short-circuit chain
}

fn main() -> i32 {
    let s = sum_all(1, 2, 3, 4, 5);    // expects 15
    if (s != 15) { return 1; }

    let t1 = all_of(true, true, true);
    let t2 = all_of(true, false, true);
    if (!t1) { return 2; }
    if (t2)  { return 3; }
    return 0;
}
