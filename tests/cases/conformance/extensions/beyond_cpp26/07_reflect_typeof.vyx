// P3-Q: `typeof(expr)` returns compile-time string with the canonical type
// name. Surpasses C++'s typeid().name() (runtime + implementation-defined).

fn main() -> i32 {
    let x: i32 = 42;
    if (typeof(x) != "i32") { return 1; }

    let s: string = "hi";
    if (typeof(s) != "string") { return 3; }

    let f: f64 = 3.14;
    if (typeof(f) != "f64") { return 4; }

    let b: bool = true;
    if (typeof(b) != "bool") { return 5; }

    return 0;
}
