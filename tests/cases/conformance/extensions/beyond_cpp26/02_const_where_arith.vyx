// P3-O: arithmetic + multi-predicate combinations in where-clause.

fn capacity<T, const N: i64>() -> i64
    where N > 0 + N * 2 <= 32 + N % 4 == 0 {
    return N;
}

fn main() -> i32 {
    let a = capacity::<i64, 8>();    // 8>0, 16<=32, 8%4==0 → ok
    let b = capacity::<i64, 4>();    // 4>0, 8<=32, 4%4==0 → ok
    if (a != 8)  { return 1; }
    if (b != 4)  { return 2; }
    return 0;
}
