// P3-R: multi-error harvest — 3 unrelated template failures reported in one build.
// Expected: P2D-002 (missing method), P2D-002 again with dedup note (5 sites collapsed),
//           MONO-001 (cycle). Compiler DOES NOT stop-at-first.

interface Printable { fn label(self) -> string; }

class Foo {}      // missing `label` required by Printable

fn log<T>(v: T) where T: Printable {
    print(v.label());
}

fn cycle<T>(v: T) -> T {
    return cycle(v);   // infinite recursion → MONO-001 self-cycle
}

fn main() -> i32 {
    let f = Foo {};
    log::<Foo>(f);       // P2D-002 site 1
    log::<Foo>(f);       // site 2 (dedup)
    log::<Foo>(f);       // site 3 (dedup)
    log::<Foo>(f);       // site 4 (dedup)
    log::<Foo>(f);       // site 5 (dedup)
    let x = cycle::<i32>(42);  // MONO-001
    return 0;
}
