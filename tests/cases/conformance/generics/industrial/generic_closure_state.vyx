module gen_industrial;

use std.core;

fn make_counter<T>(start: T, step: T) -> fn() -> T {
    var cur: T = start;
    return || -> T {
        let v = cur;
        cur = cur + step;
        return v;
    };
}

fn main() -> i32 {
    let it_i32 = make_counter::<i32>(0, 1);
    let it_i64 = make_counter::<i64>(100, 5);

    let a = it_i32(); let b = it_i32(); let c = it_i32();
    let x = it_i64(); let y = it_i64();

    print("generic_closure_state i32=[${a},${b},${c}] i64=[${x},${y}]");
    if (a == 0 && b == 1 && c == 2 && x == 100 && y == 105) { return 0; }
    return 1;
}
