module gen_industrial;

use std.collections;

fn main() -> i32 {
    var grid = Vec::<Vec<i32>>.new();
    var r: i32 = 0;
    while (r < 3) {
        var row = Vec::<i32>.new();
        var c: i32 = 0;
        while (c < 3) {
            row.push(r * 10 + c);
            c = c + 1;
        }
        grid.push(row);
        r = r + 1;
    }
    let last = grid.get(2);
    let v = last.get(2);
    let popped = last.pop();
    let row0_size = grid.get(0).size();
    print("nested_vec_vec rows=${grid.size()} v=${v} popped=${popped} row0_size=${row0_size}");
    if (v == 22 && popped == 22 && row0_size == 3) { return 0; }
    return 1;
}
