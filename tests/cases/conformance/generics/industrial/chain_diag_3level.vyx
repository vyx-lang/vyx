// P2D-001 industrial diagnostic sample: 3-level monomorphization chain.
//
//   main → outer<T> → mid<T> → inner<T>     (each layer carries `where T: Add`)
//   instantiate with MyTag, which does NOT implement Add
//
// Expected sema output (compile-time error, not codegen):
//   1) `error[P2D-001]: trait bound not satisfied: type 'MyTag' does not satisfy constraint 'Add'`
//   2) source span (`-->` line + caret) at the call site
//   3) compact `note: required method 'add_int' is not implemented for 'MyTag'`
//   4) compact `note: help: implement 'Add' for 'MyTag', or remove the 'where T: Add' constraint`
//   5) compact `note: instantiation chain:` followed by THREE numbered frames:
//        1. outer<MyTag> with [T=MyTag] instantiated at file:LINE:COL
//        2. mid<MyTag>   with [T=MyTag] instantiated at file:LINE:COL
//        3. inner<MyTag> with [T=MyTag] instantiated at file:LINE:COL
//
// NOTE: the parser currently rejects `fn op_add(self, ...)` inside trait
// bodies, so we model `Add` as an interface whose required method is a
// regular non-self function `add_int(other: i32) -> i32`. The mechanism
// being exercised (multi-level instantiation chain in P2D-001 output) is
// independent of self/Self and only needs *some* unsatisfied bound to
// trigger; the chain depth of 3 is the property under test.

interface Add {
    fn add_int(other: i32) -> i32;
}

fn inner<T>(a: T) -> T where T: Add {
    return a;
}

fn mid<T>(x: T) -> T where T: Add {
    return inner::<T>(x);
}

fn outer<T>(p: T) -> T where T: Add {
    return mid::<T>(p);
}

struct MyTag {
    name: i32
}

fn main() -> i32 {
    let a = MyTag { name: 0 };
    let r = outer::<MyTag>(a);
    return r.name;
}
