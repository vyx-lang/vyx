module gen_industrial;

use std.collections;

fn add1(x: i32) -> i32 { return x + 1; }
fn mul3(x: i32) -> i32 { return x * 3; }
fn neg(x: i32) -> i32  { return -x; }

fn main() -> i32 {
    var pipe = Vec::<fn(i32) -> i32>.new();
    pipe.push(add1);
    pipe.push(mul3);
    pipe.push(neg);

    var x: i32 = 5;
    var i: i64 = 0;
    while (i < pipe.size()) {
        x = pipe.get(i)(x);
        i = i + 1;
    }
    // (5+1)*3 = 18 -> -18
    print("vec_of_fn x=${x}");
    if (x == -18) { return 0; }
    return 1;
}
