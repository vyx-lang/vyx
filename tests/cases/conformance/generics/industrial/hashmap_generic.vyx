// C8 industrial supp: HashMap<K,V> generic instantiation across two key types
module gen_industrial;

use std.hashmap;

fn main() -> i32 {
    var m1 = HashMap::<string, i64>.new();
    m1.put("a", 1);
    m1.put("b", 2);
    let v_a = m1.get("a");

    var m2 = HashMap::<i64, string>.new();
    m2.put(10, "ten");
    m2.put(20, "twenty");
    let v_10 = m2.get(10);

    print("hashmap_generic v_a=${v_a} v_10=${v_10} m1_sz=${m1.size()} m2_sz=${m2.size()}");
    if (v_a == 1 && v_10 == "ten" && m1.size() == 2 && m2.size() == 2) { return 0; }
    return 1;
}
