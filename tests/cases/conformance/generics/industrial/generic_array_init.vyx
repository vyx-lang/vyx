module gen_industrial;

use std.core;

// 用泛型函数初始化固定数组
fn fill_with<T, const N: i64>(v: T) -> [N]T {
    var a: [N]T = [v; N];
    return a;
}

fn sum_arr<T, const N: i64>(a: [N]T, zero: T) -> T {
    var s: T = zero;
    var i: i64 = 0;
    while (i < N) { s = s + a[i]; i = i + 1; }
    return s;
}

fn main() -> i32 {
    let a = fill_with::<i32, 6>(3);
    let b = fill_with::<i64, 4>(10);
    let sa = sum_arr::<i32, 6>(a, 0);
    let sb = sum_arr::<i64, 4>(b, 0);
    print("generic_array_init sa=${sa} sb=${sb}");
    if (sa == 18 && sb == 40) { return 0; }
    return 1;
}
