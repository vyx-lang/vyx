// Renamed user trait from Iterator<T> to UserIter<T> to avoid collision
// with std.collections.Iterator, and MyRange/Range is kept distinct.
module gen_industrial;

use std.core;
use std.collections;

trait UserIter<T> {
    fn next(self) -> Option<T>;
}

class MyRange {
    public cur: i32;
    public end: i32;

    public static fn new(lo: i32, hi: i32) -> MyRange {
        return MyRange { cur: lo, end: hi };
    }

    public fn next(self) -> Option<i32> {
        if (self.cur >= self.end) { return Option::<i32>.none(); }
        let v = self.cur;
        self.cur = self.cur + 1;
        return Option::<i32>.some(v);
    }
}

fn collect<T, I>(it: I) -> Vec<T> where I: UserIter<T> {
    var out = Vec::<T>.new();
    while (true) {
        let n = it.next();
        if (n.isNone()) { break; }
        out.push(n.unwrap());
    }
    return out;
}

fn main() -> i32 {
    let v = collect::<i32, MyRange>(MyRange.new(0, 5));
    var s: i32 = 0;
    var i: i64 = 0;
    while (i < v.size()) { s = s + v.get(i); i = i + 1; }
    print("generic_iterator size=${v.size()} sum=${s}");
    if (v.size() == 5 && s == 10) { return 0; }
    return 1;
}
