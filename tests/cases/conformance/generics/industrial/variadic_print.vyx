module gen_industrial;

use std.core;

fn sum_all<T>(args: ...T) -> T {
    var s: T = args[0];
    var i: i64 = 1;
    while (i < args.len) {
        s = s + args[i];
        i = i + 1;
    }
    return s;
}

fn print_many<T>(label: string, args: ...T) {
    print("variadic_print[${label}] count=${args.len} first=${args[0]} last=${args[args.len-1]}");
}

fn pack_len<T>(args: ...T) -> i64 {
    return args.len;
}

fn pack_edges<T>(args: ...T) -> T {
    return args[0] + args[args.len - 1];
}

fn main() -> i32 {
    let s_i = sum_all::<i64>(1, 2, 3, 4, 5);
    let s_f = sum_all::<f64>(1.5, 2.5, 3.0);
    let edge_i = pack_edges::<i64>(10, 20, 30, 40);
    let count_i = pack_len::<i64>(10, 20, 30, 40);
    print_many::<i32>("ints", 10, 20, 30, 40);
    print("variadic_print s_i=${s_i} s_f=${s_f}");
    if (s_i != 15) { return 1; }
    if (s_f != 7.0) { return 2; }
    if (edge_i != 50) { return 3; }
    if (count_i != 4) { return 4; }
    return 0;
}
