module gen_industrial;

use std.core;
use std.string;

trait Loggable    { fn label(self) -> string; }
trait Numeric     { fn to_i64(self) -> i64; }

class Tagged { public name: string; public n: i64;
    public fn label(self) -> string { return self.name; }
    public fn to_i64(self) -> i64 { return self.n; }
}

// where 子句的复合: T: Loggable + Numeric
fn describe<T>(v: T) -> string where T: Loggable + Numeric {
    let n = v.to_i64();
    return v.label() + "=" + n.toString();
}

fn main() -> i32 {
    let t = Tagged { name: "score", n: 88 };
    let s = describe::<Tagged>(t);
    print("where_or_clause s=${s}");
    if (s.contains("score") && s.contains("88")) { return 0; }
    return 1;
}
