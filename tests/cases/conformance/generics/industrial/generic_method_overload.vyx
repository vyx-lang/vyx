module gen_industrial;

use std.collections;

class Container<T> {
    public buf: Vec<T>;

    public static fn new() -> Container<T> {
        return Container::<T> { buf: Vec::<T>.new() };
    }

    public fn push(self, v: T) { self.buf.push(v); }

    public fn push_many<U>(self, others: Vec<U>, conv: fn(U) -> T) {
        var i: i64 = 0;
        while (i < others.size()) {
            self.buf.push(conv(others.get(i)));
            i = i + 1;
        }
    }

    public fn fold<R>(self, init: R, f: fn(R, T) -> R) -> R {
        var acc = init;
        var i: i64 = 0;
        while (i < self.buf.size()) {
            acc = f(acc, self.buf.get(i));
            i = i + 1;
        }
        return acc;
    }
}

fn to_i64(x: i32) -> i64 { return x as i64; }
fn add_i64(a: i64, b: i64) -> i64 { return a + b; }

fn main() -> i32 {
    var c = Container::<i64>.new();
    var src = Vec::<i32>.new();
    src.push(10); src.push(20); src.push(30);
    c.push_many::<i32>(src, to_i64);
    let s = c.fold::<i64>(0, add_i64);
    print("generic_method_overload sum=${s}");
    if (s == 60) { return 0; }
    return 1;
}
