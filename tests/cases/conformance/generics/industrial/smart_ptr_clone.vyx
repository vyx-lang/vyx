module gen_industrial;

use std.core;
use std.collections;

trait Cloneable { fn clone(self) -> Self; }

class Node {
    public val: i32;
    public static fn of(v: i32) -> Node { return Node { val: v }; }
    public fn clone(self) -> Node { return Node { val: self.val }; }
}

fn duplicate<T>(t: T) -> Vec<T> where T: Cloneable {
    var v = Vec::<T>.new();
    v.push(t.clone());
    v.push(t.clone());
    v.push(t.clone());
    return v;
}

fn main() -> i32 {
    let v = duplicate::<Node>(Node.of(99));
    let s = v.get(0).val + v.get(1).val + v.get(2).val;
    print("smart_ptr_clone size=${v.size()} sum=${s}");
    if (v.size() == 3 && s == 297) { return 0; }
    return 1;
}
