module gen_industrial;

use std.collections;

// 互递归泛型: A<T> uses B<T>; B<T> uses A<i32>
class B<T> {
    public tag: T;
    public depth: i32;

    public static fn new(t: T) -> B<T> {
        return B::<T> { tag: t, depth: 0 };
    }
}

class A<T> {
    public payload: T;
    public bridge: B<T>;
    public anchor: B<i32>;

    public static fn new(p: T) -> A<T> {
        return A::<T> {
            payload: p,
            bridge: B::<T>.new(p),
            anchor: B::<i32>.new(0),
        };
    }
}

fn main() -> i32 {
    let a_int = A::<i32>.new(7);
    let a_str = A::<string>.new("k");
    let s = a_int.payload + a_int.anchor.depth + a_str.anchor.depth;
    print("mono_cycle a_int.payload=${a_int.payload} a_str.bridge.tag=${a_str.bridge.tag} sum=${s}");
    if (s == 7 && a_str.bridge.tag == "k") { return 0; }
    return 1;
}
