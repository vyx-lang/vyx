module gen_industrial;

use std.collections;
use std.string;

trait Renderer { fn render(self) -> string; }

class TextR { public s: string; public fn render(self) -> string { return "T:" + self.s; } }
class HtmlR { public s: string; public fn render(self) -> string { return "<p>" + self.s + "</p>"; } }
class JsonR { public s: string; public fn render(self) -> string { return "{\"v\":\"" + self.s + "\"}"; } }

fn main() -> i32 {
    // Distinct payloads per renderer: a dyn method that reads a stale,
    // zeroed or cross-object `self.s` cannot satisfy the exact-equality
    // checks below (the old prefix/suffix assertions passed even when
    // the field payload was lost).
    var registry = Dict::<string, Box<dyn Renderer>>.new();
    registry.put("text",  Box::<dyn Renderer>.new(TextR { s: "alpha" }));
    registry.put("html",  Box::<dyn Renderer>.new(HtmlR { s: "beta" }));
    registry.put("json",  Box::<dyn Renderer>.new(JsonR { s: "gamma" }));

    let t = registry.get("text").deref().render();
    let h = registry.get("html").deref().render();
    let j = registry.get("json").deref().render();
    let n = registry.size();
    print("trait_obj_dyn_dict t=${t} h=${h} j=${j} n=${n}");
    if (n != 3) { print("FAIL: size ${n} != 3"); return 1; }
    if (t != "T:alpha") { print("FAIL: text render `${t}` != `T:alpha`"); return 2; }
    if (h != "<p>beta</p>") { print("FAIL: html render `${h}` != `<p>beta</p>`"); return 3; }
    if (j != "{\"v\":\"gamma\"}") { print("FAIL: json render `${j}` != `{\"v\":\"gamma\"}`"); return 4; }
    return 0;
}
