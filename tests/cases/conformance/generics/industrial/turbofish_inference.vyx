// C8 industrial supp: explicit turbofish vs argument-driven inference
module gen_industrial;

fn identity<T>(x: T) -> T {
    return x;
}

fn pair<A, B>(a: A, b: B) -> A {
    return a;
}

fn main() -> i32 {
    let a = identity::<i32>(7);
    let b = identity(11);
    let c = identity::<string>("z");
    let d = pair::<i32, string>(99, "ignored");
    let e = pair(1, "also ignored");

    print("turbofish_inference a=${a} b=${b} c=${c} d=${d} e=${e}");
    if (a == 7 && b == 11 && c == "z" && d == 99 && e == 1) { return 0; }
    return 1;
}
