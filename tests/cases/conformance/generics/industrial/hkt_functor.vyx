module gen_industrial;

use std.core;
use std.collections;

fn fmap_vec_i32_string(fa: Vec<i32>, f: fn(i32) -> string) -> Vec<string> {
    var out = Vec::<string>.new();
    var i: i64 = 0;
    while (i < fa.size()) {
        out.push(f(fa.get(i)));
        i = i + 1;
    }
    return out;
}

fn to_str(x: i32) -> string { return "n${x}"; }

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3);
    let r = fmap_vec_i32_string(v, to_str);
    print("hkt_functor r0=${r.get(0)} r2=${r.get(2)} sz=${r.size()}");
    if (r.size() == 3 && r.get(0) == "n1" && r.get(2) == "n3") { return 0; }
    return 1;
}
