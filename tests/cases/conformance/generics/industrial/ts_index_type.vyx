// P2-generics-industrial C6: variadic type-pack indexing in type position.
//
// Builds on P1a value-position pack indexing (`args[i]`) by allowing
// the same `Ts[i]` shape in type position — return types and let
// bindings can refer to the i-th type bound to a variadic type pack.
module gen_industrial;

// Return-type uses Ts[0]: must match the type of the first packed
// argument after variadic instantiation.
fn head<...Ts>(...args: Ts) -> Ts[0] {
    return args[0];
}

// Return-type uses Ts[1]: same idea for the second slot. Exercises a
// non-zero literal index path.
fn second<...Ts>(...args: Ts) -> Ts[1] {
    return args[1];
}

// Local var uses Ts[0] in type position too; verifies that
// PackIndexType is rewritten not just on returnType but also inside
// statement-level type annotations.
fn first_via_local<...Ts>(...args: Ts) -> Ts[0] {
    let v: Ts[0] = args[0];
    return v;
}

fn main() -> i32 {
    let h: i32 = head(11, 22, 33);
    let s: i32 = second(11, 22, 33);
    let l: i32 = first_via_local(11, 22, 33);

    print("ts_index_type head=${h} second=${s} local=${l}");
    if (h == 11 && s == 22 && l == 11) { return 0; }
    return 1;
}
