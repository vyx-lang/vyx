module gen_industrial;

use std.collections;

fn main() -> i32 {
    var m = HashMap::<string, i64>.new();
    m.put("a", 1);
    m.put("b", 2);
    m.put("c", 3);
    m.put("d", 4);

    let keys = m.keys();
    var key_total: i64 = 0;
    var i: i64 = 0;
    while (i < keys.size()) {
        let k = keys.get(i);
        key_total = key_total + (k.charAt(0) as i64);
        i = i + 1;
    }
    let vals = m.values();
    var val_sum: i64 = 0;
    i = 0;
    while (i < vals.size()) {
        val_sum = val_sum + vals.get(i);
        i = i + 1;
    }
    print("hashmap_iter_kv keys_first_char_sum=${key_total} val_sum=${val_sum} size=${m.size()}");
    if (val_sum == 10 && m.size() == 4) { return 0; }
    return 1;
}
