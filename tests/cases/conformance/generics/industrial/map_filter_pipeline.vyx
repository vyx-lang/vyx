// C8 industrial supp: iterator-style map+filter+sum pipeline on generic Vec
module gen_industrial;

use std.collections;

fn main() -> i32 {
    var v = Vec::<i32>.new();
    var i: i32 = 1;
    while (i <= 10) { v.push(i); i = i + 1; }

    // Note: map/filter/collect live on Iterator<T>, not Slice<T>. Use
    // `v.iter()` to get an Iterator over a Vec, not `Slice::<T>.from_vec(v)`.
    let evens = v.iter().filter(|x: i32| -> bool { return x % 2 == 0; });
    let squared = evens.map::<i32>(|x: i32| -> i32 { return x * x; });
    let result = squared.collect();

    var total: i32 = 0;
    var k: i64 = 0;
    while (k < result.size()) { total = total + result.get(k); k = k + 1; }

    print("map_filter_pipeline n=${result.size()} total=${total}");
    if (result.size() == 5 && total == 220) { return 0; }
    return 1;
}
