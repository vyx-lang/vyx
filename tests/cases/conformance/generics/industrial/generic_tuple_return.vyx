module gen_industrial;

use std.core;

fn swap_tuple<T, U>(a: T, b: U) -> (U, T) {
    return (b, a);
}

fn main() -> i32 {
    let s = swap_tuple(21, 1.5);
    if (s.0 != 1.5) { return 1; }
    if (s.1 != 21) { return 2; }
    let t = swap_tuple("left", 7);
    if (t.0 != 7) { return 3; }
    if (t.1 != "left") { return 4; }
    print("generic_tuple_return ok");
    return 0;
}
