module gen_industrial;

use std.core;

fn pack_size<T>() -> i64 {
    return sizeof::<T>();
}

class Big { public a: i64; public b: i64; public c: i64; }

fn main() -> i32 {
    let s_i8  = pack_size::<i8>();
    let s_i32 = pack_size::<i32>();
    let s_i64 = pack_size::<i64>();
    let s_str = pack_size::<string>();
    let s_big = pack_size::<Big>();
    print("sizeof_dispatch i8=${s_i8} i32=${s_i32} i64=${s_i64} str=${s_str} big=${s_big}");
    if (s_i8 == 1 && s_i32 == 4 && s_i64 == 8 && s_str >= 16 && s_big >= 24) { return 0; }
    return 1;
}
