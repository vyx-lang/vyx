// C8 industrial supp: generic class with generic method (two-level mono)
module gen_industrial;

class Box2<T> {
    public val: T;

    public static fn of(v: T) -> Box2<T> { return Box2::<T> { val: v }; }
    public fn map<U>(f: fn(T) -> U) -> Box2<U> { return Box2::<U>.of(f(self.val)); }
    public fn get() -> T { return self.val; }
}

fn main() -> i32 {
    let b = Box2::<i32>.of(7);
    let bs = b.map::<string>(|x: i32| -> string { return "v=${x}"; });
    let bi = b.map::<i64>(|x: i32| -> i64 { return (x as i64) * 100; });
    let s = bs.get();
    let n = bi.get();

    print("generic_class_method s=${s} n=${n}");
    if (s == "v=7" && n == 700) { return 0; }
    return 1;
}
