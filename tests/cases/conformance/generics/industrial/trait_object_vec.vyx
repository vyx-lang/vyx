// C8 industrial supp: Vec of trait objects (dyn dispatch)
module gen_industrial;

use std.collections;

trait Shape { fn area(self) -> f64; }

struct Circle { r: f64; }
struct Square { side: f64; }

impl Shape for Circle { fn area(self) -> f64 { return self.r * self.r * 3.14159; } }
impl Shape for Square { fn area(self) -> f64 { return self.side * self.side; } }

fn main() -> i32 {
    var shapes = Vec::<dyn Shape>.new();
    shapes.push(Circle { r: 2.0 });
    shapes.push(Square { side: 3.0 });

    var total: f64 = 0.0;
    var i: i64 = 0;
    while (i < shapes.size()) {
        total = total + shapes.get(i).area();
        i = i + 1;
    }

    print("trait_object_vec total=${total}");
    if (total > 21.0 && total < 22.0) { return 0; }
    return 1;
}
