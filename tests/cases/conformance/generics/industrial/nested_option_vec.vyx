// C8 industrial supp: Vec<Option<i32>>
module gen_industrial;

use std.collections;
use std.core;

fn main() -> i32 {
    var v = Vec::<Option::<i32>>.new();
    v.push(Option::<i32>.some(10));
    v.push(Option::<i32>.none());
    v.push(Option::<i32>.some(30));
    v.push(Option::<i32>.none());

    var sum: i32 = 0;
    var some_count: i64 = 0;
    var i: i64 = 0;
    while (i < v.size()) {
        let o = v.get(i);
        if (o.is_some()) {
            sum = sum + o.unwrap_or(0);
            some_count = some_count + 1;
        }
        i = i + 1;
    }

    print("nested_option_vec n=${v.size()} sum=${sum} somes=${some_count}");
    if (v.size() == 4 && sum == 40 && some_count == 2) { return 0; }
    return 1;
}
