module gen_industrial;

use std.core;

trait BoundedInt {
    const MAX: i64;
    const MIN: i64;
    fn value(self) -> i64;
}

class U8Like {
    public v: i64;
    const MAX: i64 = 255;
    const MIN: i64 = 0;

    public static fn of(v: i64) -> U8Like { return U8Like { v: v }; }
    public fn value(self) -> i64 { return self.v; }
}

fn clamp<T>(x: T) -> i64 where T: BoundedInt {
    let v = x.value();
    if (v < T::MIN) { return T::MIN; }
    if (v > T::MAX) { return T::MAX; }
    return v;
}

fn main() -> i32 {
    let a = clamp::<U8Like>(U8Like.of(300));
    let b = clamp::<U8Like>(U8Like.of(-7));
    let c = clamp::<U8Like>(U8Like.of(123));
    print("trait_assoc_const a=${a} b=${b} c=${c}");
    if (a == 255 && b == 0 && c == 123) { return 0; }
    return 1;
}
