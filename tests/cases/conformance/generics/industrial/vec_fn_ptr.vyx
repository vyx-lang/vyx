// C8 industrial supp: Vec<fn(i32) -> i32> first-class function pointers in containers
module gen_industrial;

use std.collections;

fn inc(x: i32) -> i32 { return x + 1; }
fn dbl(x: i32) -> i32 { return x * 2; }
fn neg(x: i32) -> i32 { return 0 - x; }

fn main() -> i32 {
    var fns = Vec::<fn(i32) -> i32>.new();
    fns.push(inc);
    fns.push(dbl);
    fns.push(neg);

    var v: i32 = 5;
    var i: i64 = 0;
    while (i < fns.size()) {
        let f = fns.get(i);
        v = f(v);
        i = i + 1;
    }

    print("vec_fn_ptr final=${v}");
    if (v == -12) { return 0; }
    return 1;
}
