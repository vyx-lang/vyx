module gen_industrial;

use std.core;

// 零大小类型 (ZST) 作为 phantom 类型参数
struct PhantomData<T> {}

class TypedId<Tag> {
    public raw: i64;
    public _ph: PhantomData<Tag>;

    public static fn of(v: i64) -> TypedId<Tag> {
        return TypedId::<Tag> { raw: v, _ph: PhantomData::<Tag> {} };
    }
}

struct UserTag {}
struct OrderTag {}

fn id_of_user(id: TypedId<UserTag>) -> i64  { return id.raw; }
fn id_of_order(id: TypedId<OrderTag>) -> i64 { return id.raw; }

fn main() -> i32 {
    let u = TypedId::<UserTag>.of(101);
    let o = TypedId::<OrderTag>.of(7);
    let s = id_of_user(u) + id_of_order(o);
    print("zero_size_marker sum=${s}");
    if (s == 108) { return 0; }
    return 1;
}
