module gen_industrial;

// P2-C2: full template specialization
//
// Two parts:
//   1. fn marker<T>(x: T) -> i32 — generic template returning 0.
//      A hand-written specialization `fn marker<i32>(x: i32) -> i32 { 42 }`
//      proves the call `marker::<i32>(...)` routes to the specialized body.
//   2. class Holder<T> { value: T; ... } — generic class with a `tag()`
//      method returning 0. A hand-written specialization
//      `class Holder<i32> { value: i32; fn tag() -> i32 { 7 } }`
//      proves field/method access on `Holder<i32>` uses the specialized body.

fn marker<T>(x: T) -> i32 {
    return 0;
}

fn marker<i32>(x: i32) -> i32 {
    print("[full_spec] marker<i32> body");
    return 42;
}

class Holder<T> {
    public value: T;

    public static fn make(v: T) -> Holder<T> {
        return Holder<T> { value: v };
    }

    public fn tag() -> i32 {
        return 0;
    }
}

class Holder<i32> {
    public value: i32;

    public static fn make(v: i32) -> Holder<i32> {
        return Holder<i32> { value: v };
    }

    public fn tag() -> i32 {
        print("[full_spec] Holder<i32>.tag body");
        return 7;
    }
}

fn main() -> i32 {
    let m = marker::<i32>(123);
    let h = Holder::<i32>.make(99);
    let t = h.tag();
    print("full_spec m=${m} v=${h.value} t=${t}");
    if (m == 42 && h.value == 99 && t == 7) {
        return 0;
    }
    return 1;
}
