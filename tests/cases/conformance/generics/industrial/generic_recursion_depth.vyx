module gen_industrial;

use std.core;

// 深递归泛型实例化深度压力 (sema/codegen 必须收敛)
class Wrap<T> {
    public inner: T;
    public static fn of(t: T) -> Wrap<T> { return Wrap::<T> { inner: t }; }
}

fn unwrap1<T>(w: Wrap<T>) -> T { return w.inner; }

fn main() -> i32 {
    let w1 = Wrap::<i32>.of(7);
    let w2 = Wrap::<Wrap<i32>>.of(w1);
    let w3 = Wrap::<Wrap<Wrap<i32>>>.of(w2);
    let w4 = Wrap::<Wrap<Wrap<Wrap<i32>>>>.of(w3);
    let w5 = Wrap::<Wrap<Wrap<Wrap<Wrap<i32>>>>>.of(w4);

    let v1 = unwrap1::<Wrap<Wrap<Wrap<Wrap<i32>>>>>(w5);
    let v2 = unwrap1::<Wrap<Wrap<Wrap<i32>>>>(v1);
    let v3 = unwrap1::<Wrap<Wrap<i32>>>(v2);
    let v4 = unwrap1::<Wrap<i32>>(v3);
    let v5 = unwrap1::<i32>(v4);

    print("generic_recursion_depth v5=${v5}");
    if (v5 == 7) { return 0; }
    return 1;
}
