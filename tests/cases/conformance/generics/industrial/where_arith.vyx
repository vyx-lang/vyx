module gen_industrial;

use std.core;
use std.ops;

fn fma<T>(a: T, b: T, c: T) -> T where T: Add + Mul {
    return (a * b) + c;
}

fn poly2<T>(x: T, a: T, b: T, c: T) -> T where T: Add + Mul {
    return fma::<T>(fma::<T>(a, x, b), x, c);
}

fn main() -> i32 {
    let r1 = fma::<i32>(3, 4, 5);
    let r2 = poly2::<i32>(2, 1, 3, 5);
    print("where_arith r1=${r1} r2=${r2}");
    if (r1 == 17 && r2 == 15) { return 0; }
    return 1;
}
