module gen_industrial;

use std.core;
use std.collections;

class IntBag {
    public data: Vec<i32>;

    public static fn from(v: Vec<i32>) -> IntBag {
        return IntBag { data: v };
    }

    public fn first(self) -> i32 { return self.data.get(0); }
    public fn count(self) -> i64 { return self.data.size(); }
}

fn head_of(c: IntBag) -> i32 {
    return c.first();
}

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(11); v.push(22); v.push(33);
    let n = v.size();
    let bag = IntBag.from(v);
    let h = bag.first();
    print("dependent_item head=${h} count=${n}");
    if (h == 11 && n == 3) { return 0; }
    return 1;
}
