module gen_industrial;

use std.collections;

// 偏特化: Dict<string, V> 提供更高效的字符串键路径
class StrDict<V> {
    public inner: Dict<string, V>;

    public static fn new() -> StrDict<V> {
        return StrDict::<V> { inner: Dict::<string, V>.new() };
    }

    public fn put_lower(key: string, val: V) {
        self.inner.put(key.toLower(), val);
    }

    public fn get_lower(self, key: string) -> V {
        return self.inner.get(key.toLower());
    }

    public fn size(self) -> i64 { return self.inner.size(); }
}

fn main() -> i32 {
    var sd = StrDict::<i32>.new();
    sd.put_lower("Alpha", 1);
    sd.put_lower("BETA", 2);
    sd.put_lower("gamma", 3);
    let a = sd.get_lower("ALPHA");
    let b = sd.get_lower("beta");
    let c = sd.get_lower("Gamma");
    let n = sd.size();
    print("partial_spec_dict a=${a} b=${b} c=${c} n=${n}");
    if (a == 1 && b == 2 && c == 3 && n == 3) { return 0; }
    return 1;
}
