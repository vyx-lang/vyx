module gen_industrial;

use std.core;

fn parse_pos(s: string) -> Result<i32, string> {
    if (s.isEmpty()) { return Result::<i32, string>.err("empty"); }
    var v: i32 = 0;
    var i: i64 = 0;
    while (i < s.len) {
        let c = s.charAt(i);
        if (c < '0' || c > '9') { return Result::<i32, string>.err("nondigit"); }
        v = v * 10 + (c as i32 - '0' as i32);
        i = i + 1;
    }
    return Result::<i32, string>.ok(v);
}

fn main() -> i32 {
    let a = parse_pos("123");
    let b = parse_pos("4x");
    let c = parse_pos("");
    let av = a.unwrapOr(-1);
    let bv = b.unwrapOr(-2);
    let cv = c.unwrapOr(-3);
    print("result_either a=${av} b=${bv} c=${cv}");
    if (av == 123 && bv == -2 && cv == -3) { return 0; }
    return 1;
}
