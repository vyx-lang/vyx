module gen_industrial;

use std.core;
use std.collections;

fn make_adder<T>(base: T) -> fn(T) -> T {
    return |x: T| -> T { return x + base; };
}

fn apply_each<T>(v: Vec<T>, f: fn(T) -> T) -> Vec<T> {
    var out = Vec::<T>.new();
    var i: i64 = 0;
    while (i < v.size()) {
        out.push(f(v.get(i)));
        i = i + 1;
    }
    return out;
}

fn main() -> i32 {
    let add10 = make_adder::<i32>(10);
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3);
    let r = apply_each::<i32>(v, add10);
    let sum = r.get(0) + r.get(1) + r.get(2);
    print("lambda_capture_generic sum=${sum}");
    if (sum == 36) { return 0; }
    return 1;
}
