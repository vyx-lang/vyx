// C8 industrial supp: Result<T,E> chain map / and_then
module gen_industrial;

use std.result;

fn parse_pos(n: i32) -> Result<i32, string> {
    if (n > 0) { return Result::<i32, string>.ok(n); }
    return Result::<i32, string>.err("nonpositive");
}

fn main() -> i32 {
    let r1 = parse_pos(5);
    let r2 = parse_pos(0 - 1);

    let r1v = r1.unwrap_or(-1);
    let r2v = r2.unwrap_or(-1);

    let mapped = r1.map(|x: i32| -> i32 { return x * 10; });
    let mv = mapped.unwrap_or(0);

    print("result_chain r1=${r1v} r2=${r2v} mapped=${mv}");
    if (r1v == 5 && r2v == -1 && mv == 50) { return 0; }
    return 1;
}
