module gen_industrial;

use std.core;

// 含 const 表达式的非类型参数
class FixedRing<T, const Cap: i64> {
    public buf: [Cap]T;
    public head: i64;
    public count: i64;

    public static fn new() -> FixedRing<T, Cap> {
        return FixedRing::<T, Cap> { buf: [0; Cap], head: 0, count: 0 };
    }

    public fn push(self, v: T) {
        let idx = (self.head + self.count) % Cap;
        self.buf[idx] = v;
        if (self.count < Cap) { self.count = self.count + 1; }
        else { self.head = (self.head + 1) % Cap; }
    }

    public fn at(self, i: i64) -> T {
        return self.buf[(self.head + i) % Cap];
    }
}

fn main() -> i32 {
    var r = FixedRing::<i32, 4>.new();
    var i: i32 = 0;
    while (i < 6) { r.push(i); i = i + 1; }
    let s = r.at(0) + r.at(1) + r.at(2) + r.at(3);
    print("generic_const_expr s=${s} count=${r.count}");
    if (s == 14 && r.count == 4) { return 0; }
    return 1;
}
