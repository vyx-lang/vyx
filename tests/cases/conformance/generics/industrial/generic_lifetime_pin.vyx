module gen_industrial;

use std.core;
use std.collections;

// 模拟 lifetime / 借用: 把 owner Vec 与 view 一同打包, view 携带 owner 的 raw 指针
class Pinned<T> {
    public owner: Vec<T>;
    public view_ptr: rawptr;
    public view_len: i64;

    public static fn pin(v: Vec<T>) -> Pinned<T> {
        let p = to_rawptr(&v);
        let n = v.size();
        return Pinned::<T> { owner: v, view_ptr: p, view_len: n };
    }
}

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3); v.push(4);
    let pn = Pinned::<i32>.pin(v);
    let n = pn.view_len;
    let first = pn.owner.get(0);
    let last = pn.owner.get(pn.owner.size() - 1);
    print("generic_lifetime_pin n=${n} first=${first} last=${last}");
    if (n == 4 && first == 1 && last == 4) { return 0; }
    return 1;
}
