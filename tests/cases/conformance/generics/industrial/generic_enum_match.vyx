module gen_industrial;

use std.core;

enum Either<L, R> {
    Left(L),
    Right(R),
}

fn unwrap_left<L, R>(e: Either<L, R>, dflt: L) -> L {
    match (e) {
        case Left(v) => { return v; }
        case Right(_) => { return dflt; }
    }
}

fn unwrap_right<L, R>(e: Either<L, R>, dflt: R) -> R {
    match (e) {
        case Left(_) => { return dflt; }
        case Right(v) => { return v; }
    }
}

fn main() -> i32 {
    let a: Either<i32, string> = Either::<i32, string>.Left(42);
    let b: Either<i32, string> = Either::<i32, string>.Right("ok");
    let av = unwrap_left::<i32, string>(a, -1);
    let bv = unwrap_right::<i32, string>(b, "?");
    print("generic_enum_match av=${av} bv=${bv}");
    if (av == 42 && bv == "ok") { return 0; }
    return 1;
}
