module gen_industrial;

use std.collections;

fn main() -> i32 {
    var d = Dict::<string, Vec<i64>>.new();
    var a = Vec::<i64>.new();
    a.push(100);
    a.push(200);
    a.push(300);
    d.put("alpha", a);

    var b = Vec::<i64>.new();
    b.push(7);
    b.push(8);
    d.put("beta", b);

    let alpha_vec = d.get("alpha");
    let alpha_sum = alpha_vec.get(0) + alpha_vec.get(1) + alpha_vec.get(2);
    let beta_len = d.get("beta").size();
    let has_alpha = d.contains("alpha");
    let has_zeta = d.contains("zeta");
    print("nested_dict_vec alpha_sum=${alpha_sum} beta_len=${beta_len} has_alpha=${has_alpha} has_zeta=${has_zeta}");
    if (alpha_sum == 600 && beta_len == 2 && has_alpha && !has_zeta) { return 0; }
    return 1;
}
