module gen_industrial;

use std.collections;

trait Job {
    fn run(self) -> i32;
}

class Inc { public n: i32; public fn run(self) -> i32 { return self.n + 1; } }
class Sq  { public n: i32; public fn run(self) -> i32 { return self.n * self.n; } }
class Neg { public n: i32; public fn run(self) -> i32 { return -self.n; } }

fn run_all(jobs: Vec<Box<dyn Job>>) -> i32 {
    var s: i32 = 0;
    var i: i64 = 0;
    while (i < jobs.size()) {
        s = s + jobs.get(i).deref().run();
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    var v = Vec::<Box<dyn Job>>.new();
    v.push(Box::<dyn Job>.new(Inc { n: 9 }));
    v.push(Box::<dyn Job>.new(Sq  { n: 4 }));
    v.push(Box::<dyn Job>.new(Neg { n: 3 }));
    let r = run_all(v);
    print("trait_obj_storage r=${r}");
    if (r == 23) { return 0; }
    return 1;
}
