module gen_industrial;

use std.collections;

// HashSet<Vec<i32>> = Dict<Vec<i32>, bool>
fn main() -> i32 {
    var hs = Dict::<Vec<i32>, bool>.new();

    var k1 = Vec::<i32>.new();
    k1.push(1); k1.push(2); k1.push(3);
    hs.put(k1, true);

    var k2 = Vec::<i32>.new();
    k2.push(4); k2.push(5);
    hs.put(k2, true);

    var probe = Vec::<i32>.new();
    probe.push(1); probe.push(2); probe.push(3);
    let has1 = hs.contains(probe);

    var miss = Vec::<i32>.new();
    miss.push(9);
    let has_miss = hs.contains(miss);

    let n = hs.size();
    print("second_order size=${n} has1=${has1} has_miss=${has_miss}");
    if (n == 2 && has1 && !has_miss) { return 0; }
    return 1;
}
