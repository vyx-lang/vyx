module gen_industrial;

use std.hashset;

fn main() -> i32 {
    var values = HashSet::<i64>.new();
    if (!values.add(7)) { return 1; }
    if (values.add(7)) { return 2; }
    if (!values.add(11)) { return 3; }
    if (!values.contains(7) || !values.contains(11)) { return 4; }
    if (values.size() != 2) { return 5; }
    if (!values.remove(7) || values.contains(7)) { return 6; }
    print("hashset_direct_import OK");
    return 0;
}
