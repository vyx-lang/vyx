module gen_industrial;

use std.core;

// 非类型模板参数: Array<T, N>, N 为 const i64
class Array<T, const N: i64> {
    public buf: [N]T;
    public len: i64;

    public static fn zeroed() -> Array<T, N> {
        return Array::<T, N> { buf: [0; N], len: N };
    }

    public fn fill(v: T) {
        var i: i64 = 0;
        while (i < N) { self.buf[i] = v; i = i + 1; }
    }

    public fn sum(self) -> T {
        var s: T = self.buf[0];
        var i: i64 = 1;
        while (i < N) { s = s + self.buf[i]; i = i + 1; }
        return s;
    }
}

fn main() -> i32 {
    var a = Array::<i32, 8>.zeroed();
    a.fill(7);
    let s = a.sum();
    print("nontype_array N=${a.len} sum=${s}");
    if (s == 56 && a.len == 8) { return 0; }
    return 1;
}
