module gen_industrial;

use std.collections;

trait Shape {
    fn area(self) -> f64;
}

class Circle {
    public r: f64;
    public static fn new(r: f64) -> Circle { return Circle { r: r }; }
    public fn area(self) -> f64 { return 3.14159265 * self.r * self.r; }
}

class Square {
    public s: f64;
    public static fn new(s: f64) -> Square { return Square { s: s }; }
    public fn area(self) -> f64 { return self.s * self.s; }
}

fn total_area(items: Vec<dyn Shape>) -> f64 {
    var t: f64 = 0.0;
    var i: i64 = 0;
    while (i < items.size()) {
        t = t + items.get(i).area();
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    var v = Vec::<dyn Shape>.new();
    v.push(Circle.new(1.0));
    v.push(Square.new(2.0));
    let a = total_area(v);
    print("trait_obj_dispatch total=${a}");
    if (a > 7.0 && a < 8.0) { return 0; }
    return 1;
}
