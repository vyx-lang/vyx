// C8 industrial supp: storing a generic-instantiated fn ptr in a typed local
module gen_industrial;

fn id_i32(x: i32) -> i32 { return x; }
fn id_i64(x: i64) -> i64 { return x; }

fn apply_i32(f: fn(i32) -> i32, v: i32) -> i32 { return f(v); }
fn apply_i64(f: fn(i64) -> i64, v: i64) -> i64 { return f(v); }

fn main() -> i32 {
    let f1: fn(i32) -> i32 = id_i32;
    let f2: fn(i64) -> i64 = id_i64;

    let r1 = apply_i32(f1, 7);
    let r2 = apply_i64(f2, 700);

    print("generic_fn_alias r1=${r1} r2=${r2}");
    if (r1 == 7 && r2 == 700) { return 0; }
    return 1;
}
