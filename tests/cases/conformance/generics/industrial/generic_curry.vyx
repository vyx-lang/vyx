module gen_industrial;

use std.core;

fn curry<A, B, C>(f: fn(A, B) -> C) -> fn(A) -> fn(B) -> C {
    return |a: A| -> fn(B) -> C {
        return |b: B| -> C { return f(a, b); };
    };
}

fn add_i32(a: i32, b: i32) -> i32 { return a + b; }
fn mul_i32(a: i32, b: i32) -> i32 { return a * b; }

fn main() -> i32 {
    let cadd = curry::<i32, i32, i32>(add_i32);
    let cmul = curry::<i32, i32, i32>(mul_i32);
    let add5 = cadd(5);
    let times3 = cmul(3);
    let r = times3(add5(7));
    print("generic_curry r=${r}");
    if (r == 36) { return 0; }
    return 1;
}
