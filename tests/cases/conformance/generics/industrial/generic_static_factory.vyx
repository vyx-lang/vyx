module gen_industrial;

use std.core;
use std.collections;

class Pool<T> {
    public items: Vec<T>;

    public static fn empty() -> Pool<T> { return Pool::<T> { items: Vec::<T>.new() }; }

    public static fn singleton(v: T) -> Pool<T> {
        var p = Pool::<T>.empty();
        p.items.push(v);
        return p;
    }

    public static fn repeated(v: T, n: i64) -> Pool<T> {
        var p = Pool::<T>.empty();
        var i: i64 = 0;
        while (i < n) { p.items.push(v); i = i + 1; }
        return p;
    }

    public fn total(self) -> i64 { return self.items.size(); }
}

fn main() -> i32 {
    let a = Pool::<i32>.singleton(7);
    let b = Pool::<string>.repeated("x", 5);
    let c = Pool::<i64>.empty();
    print("generic_static_factory a=${a.total()} b=${b.total()} c=${c.total()}");
    if (a.total() == 1 && b.total() == 5 && c.total() == 0) { return 0; }
    return 1;
}
