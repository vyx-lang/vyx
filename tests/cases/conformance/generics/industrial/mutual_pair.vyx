module gen_industrial;

use std.core;

struct Pair<A, B> {
    first: A;
    second: B;
}

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
    return Pair::<B, A> { first: p.second, second: p.first };
}

fn main() -> i32 {
    let p = Pair::<i32, string> { first: 42, second: "hello" };
    let q = swap::<i32, string>(p);
    let r = swap::<string, i32>(q);
    print("mutual_pair p.first=${p.first} q.first=${q.first} q.second=${q.second} r.first=${r.first}");
    if (p.first == 42 && q.second == 42 && r.first == 42 && r.second == "hello") {
        return 0;
    }
    return 1;
}
