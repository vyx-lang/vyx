// C8 industrial supp: Box<Box<i32>> double-indirected ownership
// Tests that Box<Box<T>> instantiates Box twice correctly, both via
// inline `.deref().deref()` chained calls and via a
// `fn deref2<T>(b: Box<Box<T>>) -> T` generic helper.
//
// The helper form used to trigger an unbounded monomorphisation cascade
// (Box<Box<T>> → Box<Box<Box<T>>> → …) — now caught by Mono's recursive
// isUnboundGeneric filter + nesting-depth guard (MONO-003).
//
// The chained `.deref().deref()` form used to fail CodeGen method lookup
// on inline call-expression receivers — now fixed by CodeGenMethodCall's
// structural field-type recovery + dyn-Trait inferredType check.
module gen_industrial;

use std.ref;

fn deref2<T>(b: Box<Box<T>>) -> T {
    return b.deref().deref();
}

fn main() -> i32 {
    let inner = Box::<i32>.new(42);
    let outer = Box::<Box<i32>>.new(inner);

    let v1 = outer.deref().deref();
    let v2 = deref2::<i32>(outer);

    let s_inner = Box::<string>.new("hi");
    let s_outer = Box::<Box<string>>.new(s_inner);
    let s_val = deref2::<string>(s_outer);

    print("nested_box_generic v1=${v1} v2=${v2} s=${s_val}");
    if (v1 == 42 && v2 == 42 && s_val == "hi") { return 0; }
    return 1;
}
