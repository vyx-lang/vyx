// C8 industrial supp: generic MyStack<T> built atop Vec<T>
// (renamed from Stack to avoid collision with std.collections.Stack)
module gen_industrial;

use std.collections;

class MyStack<T> {
    public buf: Vec<T>;

    public static fn new() -> MyStack<T> { return MyStack::<T> { buf: Vec::<T>.new() }; }
    public fn push(v: T) { self.buf.push(v); }
    public fn pop() -> T { return self.buf.pop(); }
    public fn len() -> i64 { return self.buf.size(); }
    public fn peek() -> T { return self.buf.get(self.buf.size() - 1); }
}

fn main() -> i32 {
    var s = MyStack::<i64>.new();
    s.push(10); s.push(20); s.push(30);
    let top = s.peek();
    let p = s.pop();
    let n = s.len();

    print("generic_default_param top=${top} pop=${p} n=${n}");
    if (top == 30 && p == 30 && n == 2) { return 0; }
    return 1;
}
