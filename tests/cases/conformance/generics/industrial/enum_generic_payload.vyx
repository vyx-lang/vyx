// C8 industrial supp: generic enum with payload (sum type)
module gen_industrial;

enum Either<L, R> {
    Left(L),
    Right(R),
}

fn pick_left<L, R>(e: Either<L, R>, fallback: L) -> L {
    match (e) {
        case Left(v) => { return v; }
        case Right(_) => { return fallback; }
    }
}

fn main() -> i32 {
    let a = Either::<i32, string>.Left(42);
    let b = Either::<i32, string>.Right("hello");

    let av = pick_left::<i32, string>(a, -1);
    let bv = pick_left::<i32, string>(b, -1);

    print("enum_generic_payload av=${av} bv=${bv}");
    if (av == 42 && bv == -1) { return 0; }
    return 1;
}
