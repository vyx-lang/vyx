module gen_industrial;

use std.core;

// concept (C++20 风) 风格的约束 + requires 子句
concept Addable<T> requires (T a, T b) { a + b -> T; }

fn pair_sum<T>(a: T, b: T) -> T requires Addable<T> {
    return a + b;
}

fn triple_sum<T>(a: T, b: T, c: T) -> T requires Addable<T> {
    return pair_sum::<T>(pair_sum::<T>(a, b), c);
}

fn main() -> i32 {
    let i = triple_sum::<i32>(10, 20, 30);
    let f = triple_sum::<f64>(1.5, 2.5, 4.0);
    print("generic_concept_check i=${i} f=${f}");
    if (i == 60 && f > 7.9 && f < 8.1) { return 0; }
    return 1;
}
