module gen_industrial;

use std.collections;
use std.hash;

fn dedup_count<T>(v: Vec<T>) -> i64 where T: Eq + Hashable {
    var seen = Dict::<T, bool>.new();
    var n: i64 = 0;
    var i: i64 = 0;
    while (i < v.size()) {
        let k = v.get(i);
        if (!seen.contains(k)) {
            seen.put(k, true);
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(2); v.push(3); v.push(1); v.push(4);
    let n = dedup_count::<i32>(v);
    print("where_eq_hash distinct=${n}");
    if (n == 4) { return 0; }
    return 1;
}
