module gen_industrial;

use std.core;

fn safe_div(a: i32, b: i32) -> Option<i32> {
    if (b == 0) { return Option::<i32>.none(); }
    return Option::<i32>.some(a / b);
}

fn safe_sqrt(x: i32) -> Option<i32> {
    if (x < 0) { return Option::<i32>.none(); }
    var r: i32 = 0;
    while ((r + 1) * (r + 1) <= x) { r = r + 1; }
    return Option::<i32>.some(r);
}

fn main() -> i32 {
    let r1 = safe_div(100, 4);
    let r2 = r1.andThen::<i32>(safe_sqrt);
    let r3 = safe_div(10, 0).orElse::<i32>(safe_sqrt(81));
    let v2 = r2.unwrapOr(-1);
    let v3 = r3.unwrapOr(-1);
    print("option_chain v2=${v2} v3=${v3}");
    if (v2 == 5 && v3 == 9) { return 0; }
    return 1;
}
