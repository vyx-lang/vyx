module gen_industrial;

use std.core;

trait Sized {
    fn size(self) -> i64;

    fn is_empty(self) -> bool {
        return self.size() == 0;
    }

    fn ratio<T>(self, other: T) -> i64 where T: Sized {
        let a = self.size();
        let b = other.size();
        if (b == 0) { return 0; }
        return (a * 100) / b;
    }
}

class Bag {
    public n: i64;
    public static fn of(n: i64) -> Bag { return Bag { n: n }; }
    public fn size(self) -> i64 { return self.n; }
}

fn main() -> i32 {
    let b1 = Bag.of(10);
    let b2 = Bag.of(4);
    let r = b1.ratio::<Bag>(b2);
    let e = Bag.of(0).is_empty();
    print("trait_default_method ratio=${r} empty=${e}");
    if (r == 250 && e) { return 0; }
    return 1;
}
