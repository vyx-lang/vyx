module gen_industrial;

use std.collections;
use std.string;

trait Greeter {
    fn greet(self) -> string;
}

class En { public name: string; public fn greet(self) -> string { return "hello " + self.name; } }
class Zh { public name: string; public fn greet(self) -> string { return "ni hao " + self.name; } }

fn make<T>(t: T) -> Box<dyn Greeter> {
    return Box::<dyn Greeter>.new(t);
}

fn main() -> i32 {
    let bx_en = make::<En>(En { name: "Alice" });
    let bx_zh = make::<Zh>(Zh { name: "Bob" });
    let g_en = bx_en.deref();
    let g_zh = bx_zh.deref();
    let s1 = g_en.greet();
    let s2 = g_zh.greet();
    print("box_dyn_trait s1=${s1} s2=${s2}");
    if (s1.contains("Alice") && s2.contains("Bob")) { return 0; }
    return 1;
}
