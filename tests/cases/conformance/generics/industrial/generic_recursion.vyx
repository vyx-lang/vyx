// C8 industrial supp: generic recursive function
module gen_industrial;

fn count_down<T>(n: T, zero: T, one: T) -> T {
    if (n == zero) { return zero; }
    return one + count_down::<T>(n - one, zero, one);
}

fn main() -> i32 {
    let r1 = count_down::<i32>(5, 0, 1);
    let r2 = count_down::<i64>(10, 0, 1);

    print("generic_recursion r1=${r1} r2=${r2}");
    if (r1 == 5 && r2 == 10) { return 0; }
    return 1;
}
