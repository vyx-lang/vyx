module gen_industrial;

use std.collections;

class Tree<T> {
    public value: T;
    public children: Vec<Box<Tree<T>>>;

    public static fn leaf(v: T) -> Tree<T> {
        return Tree::<T> { value: v, children: Vec::<Box<Tree<T>>>.new() };
    }

    public fn add_child(child: Tree<T>) {
        self.children.push(Box::<Tree<T>>.new(child));
    }

    public fn count(self) -> i64 {
        var n: i64 = 1;
        var i: i64 = 0;
        while (i < self.children.size()) {
            n = n + self.children.get(i).deref().count();
            i = i + 1;
        }
        return n;
    }
}

fn main() -> i32 {
    var root = Tree::<i32>.leaf(1);
    root.add_child(Tree::<i32>.leaf(2));
    root.add_child(Tree::<i32>.leaf(3));
    let total = root.count();
    print("recursive_tree count=${total} root_val=${root.value}");
    if (total == 3 && root.value == 1) { return 0; }
    return 1;
}
