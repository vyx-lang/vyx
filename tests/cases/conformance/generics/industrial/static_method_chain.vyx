module gen_industrial;

use std.collections;

fn dbl(x: i32) -> i32 { return x * 2; }

fn main() -> i32 {
    var v = Vec::<i32>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);

    // Note: map/collect live on Iterator<T>, not Slice<T>. The static-
    // method-chain exercise uses `v.iter().map(...).collect()` instead.
    let mapped = v.iter().map::<i32>(dbl).collect();

    var sum: i32 = 0;
    var i: i64 = 0;
    while (i < mapped.size()) {
        sum = sum + mapped.get(i);
        i = i + 1;
    }
    print("static_method_chain mapped_size=${mapped.size()} sum=${sum}");
    if (sum == 20 && mapped.size() == 4) { return 0; }
    return 1;
}
