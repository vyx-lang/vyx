module gen_industrial;

use std.core;
use std.collections;

class Span<T> {
    public src: Vec<T>;
    public lo: i64;
    public hi: i64;

    public static fn of(v: Vec<T>, lo: i64, hi: i64) -> Span<T> {
        return Span::<T> { src: v, lo: lo, hi: hi };
    }

    public fn len(self) -> i64 { return self.hi - self.lo; }
    public fn at(self, i: i64) -> T { return self.src.get(self.lo + i); }
}

fn sum_span<T>(s: Span<T>, zero: T) -> T {
    var acc: T = zero;
    var i: i64 = 0;
    while (i < s.len()) { acc = acc + s.at(i); i = i + 1; }
    return acc;
}

fn main() -> i32 {
    var v = Vec::<i32>.new();
    var k: i32 = 0;
    while (k < 10) { v.push(k); k = k + 1; }
    let lo: i64 = 2;
    let hi: i64 = 7;
    let s = Span::<i32>.of(v, lo, hi);
    let n = hi - lo;
    let total = sum_span::<i32>(s, 0);
    print("span_view len=${n} total=${total}");
    if (n == 5 && total == 20) { return 0; }
    return 1;
}
