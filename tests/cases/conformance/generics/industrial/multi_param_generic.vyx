// C8 industrial supp: multi-parameter generic struct + free function
module gen_industrial;

struct Triple<A, B, C> { a: A; b: B; c: C; }

fn pack<A, B, C>(a: A, b: B, c: C) -> Triple<A, B, C> {
    return Triple::<A, B, C> { a: a, b: b, c: c };
}

fn rotate<A, B, C>(t: Triple<A, B, C>) -> Triple<B, C, A> {
    return Triple::<B, C, A> { a: t.b, b: t.c, c: t.a };
}

fn main() -> i32 {
    let t = pack::<i32, string, bool>(1, "x", true);
    let r = rotate::<i32, string, bool>(t);
    let s = rotate::<string, bool, i32>(r);
    // After two left-rotates of (A=i32,B=string,C=bool):
    //   first  → Triple<B,C,A> = (a="x", b=true, c=1)
    //   second → Triple<C,A,B> = (a=true, b=1,   c="x")
    // So s has layout (bool, i32, string).
    let s_a = s.a; let s_b = s.b; let s_c = s.c;

    print("multi_param_generic a=${s_a} b=${s_b} c=${s_c}");
    if (s_a == true && s_b == 1 && s_c == "x") { return 0; }
    return 1;
}
