// C8 industrial supp: diamond-shaped generic dependencies
// X<T> uses Vec<T>, Dict<string, T>, and Pair<T, T>
module gen_industrial;

use std.collections;

class Diamond<T> {
    public list: Vec<T>;
    public dict: Dict<string, T>;
    public pair: Pair<T, T>;

    public static fn new(a: T, b: T) -> Diamond<T> {
        var l = Vec::<T>.new();
        l.push(a); l.push(b);
        var d = Dict::<string, T>.new();
        d.put("first", a); d.put("second", b);
        return Diamond::<T> { list: l, dict: d, pair: Pair::<T, T>.new(a, b) };
    }
}

fn main() -> i32 {
    let dm = Diamond::<i64>.new(10, 20);
    let l_sz = dm.list.size();
    let d_sz = dm.dict.size();
    let pf = dm.pair.first;
    let ps = dm.pair.second;
    print("diamond_inherit_generic l=${l_sz} d=${d_sz} pf=${pf} ps=${ps}");
    if (l_sz == 2 && d_sz == 2 && pf == 10 && ps == 20) { return 0; }
    return 1;
}
