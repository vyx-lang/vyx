// ADV3: where-clause with `N * 2 == M`  — cross-const arithmetic predicate.

fn rel<const N: i64, const M: i64>() -> i64 where N * 2 == M {
    return N + M;
}

fn main() -> i32 {
    let r = rel::<3, 6>();   // 3*2==6 OK, returns 9
    if (r != 9) { return 1; }

    let r2 = rel::<5, 10>();  // 5*2==10 OK, 15
    if (r2 != 15) { return 2; }

    return 0;
}
