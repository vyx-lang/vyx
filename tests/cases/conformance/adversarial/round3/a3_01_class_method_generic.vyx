// ADV3: class-level T + method-level U (double-level generic).

class Wrapper<T> {
    public v: i64;
    public fn map<U>(f: fn(i64) -> i64) -> i64 {
        return f(self.v);
    }
}

fn dbl(x: i64) -> i64 { return x * 2; }

fn main() -> i32 {
    var w = Wrapper::<i32>.new();
    w.v = 0;
    let r = w.map::<i64>(dbl);
    if (r != 0) { return 1; }   // v = 0, dbl(0) = 0
    return 0;
}
