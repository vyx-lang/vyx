// ADV3: Option<T> return from generic function + match.

use std.core;

fn first_or<T>(v: Option<T>, def: T) -> T {
    match (v) {
        case Some(x) => { return x; }
        default => { return def; }
    }
}

fn main() -> i32 {
    let a: Option<i64> = Some(42);
    let b: Option<i64> = None;
    let r1 = first_or::<i64>(a, -1);    // 42
    let r2 = first_or::<i64>(b, -1);    // -1
    if (r1 != 42) { return 1; }
    if (r2 != -1) { return 2; }
    return 0;
}
