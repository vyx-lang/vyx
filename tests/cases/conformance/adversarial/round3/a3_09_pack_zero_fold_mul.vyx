// ADV3: empty pack * fold should emit 1 (identity).
// Exercises the new empty-pack identity path for * specifically.

fn prod<...Ts>(...args: Ts) -> i64 { return args...*; }

fn main() -> i32 {
    let p0 = prod();       // 1 (multiplicative identity)
    let p1 = prod(7);      // 7
    let p2 = prod(3, 4);   // 12
    if (p0 != 1)  { return 1; }
    if (p1 != 7)  { return 2; }
    if (p2 != 12) { return 3; }
    return 0;
}
