// Regression: two variadic functions coexist in one TU, with one called from
// inside a string interpolation. Previously the interpolation fast-path in
// Sema::analyzeExprImpl returned `string` without walking `${...}` parts, so
// any generic / variadic call nested inside an interpolation was never fed
// through `instantiateTemplateIfNeeded`. The monomorph was never pushed, the
// call-site identifier stayed un-mangled, and lld-link reported
// `undefined symbol: <base name>`.
use std.core;

fn sum_homo<...Ts>(...args: Ts) -> i64 {
    return args[0] + args[1] + args[2];
}

fn show_hetero<...Ts>(...args: Ts) {
    print("hetero[0]=${args[0]}");
    print("hetero[1]=${args[1]}");
}

fn main() -> i32 {
    // The call is intentionally nested inside a `${...}` interpolation.
    // That is the exact shape that triggered the linker failure before the
    // fix in `SemaExpr.cpp` (analyzeExprImpl for StringInterpolation).
    print("sum=${sum_homo(10, 20, 30)}");
    // A second variadic in the same TU, called outside an interpolation.
    // Both must land in the module as distinct mangled monomorphs.
    show_hetero(42, "world");
    return 0;
}
