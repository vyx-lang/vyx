// ADV3: T::fields on a primitive type — should produce 0 iterations or error.

fn safe_count<T>() -> i32 {
    var n: i32 = 0;
    for f in T::fields { n = n + 1; }
    return n;
}

fn main() -> i32 {
    let n = safe_count::<i32>();   // primitive: expect 0
    if (n != 0) { return 1; }
    return 0;
}
