// ADV3: generic class with a field whose type is the generic param.

class Wrapper<T> {
    public value: T;

    public static fn new_default() -> Wrapper<T> {
        var z: T;
        return Wrapper { value: z };
    }
}

fn main() -> i32 {
    let w = Wrapper::<i64>.new_default();
    if (w.value != 0) { return 1; }
    return 0;
}
