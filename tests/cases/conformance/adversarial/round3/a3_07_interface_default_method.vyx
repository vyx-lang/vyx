// ADV3: interface with default method body + class overrides.

use std.string;

interface Greeter {
    fn greet() -> string;
    fn hello() -> string { return "hello " + self.greet(); }
}

class En : Greeter {
    public fn greet() -> string { return "world"; }
}

fn main() -> i32 {
    let e = En {};
    let s = e.hello();
    if (s != "hello world") { return 1; }
    return 0;
}
