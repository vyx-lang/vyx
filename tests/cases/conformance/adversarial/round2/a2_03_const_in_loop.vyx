// ADV2: const N in a while-loop condition.

fn count_down<const N: i64>() -> i64 where N > 0 {
    var i: i64 = N;
    var total: i64 = 0;
    while (i > 0) {
        total = total + i;
        i = i - 1;
    }
    return total;
}

fn main() -> i32 {
    let sum5 = count_down::<5>();   // 5+4+3+2+1 = 15
    if (sum5 != 15) { return 1; }

    let sum3 = count_down::<3>();   // 3+2+1 = 6
    if (sum3 != 6) { return 2; }

    return 0;
}
