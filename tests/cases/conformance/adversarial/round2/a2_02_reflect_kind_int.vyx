// ADV2: T::kind for integer types should produce "int" per spec.
// Checks vyxTypeKindToReflectString mapping.

fn kind_of<T>(v: T) -> string { return T::kind; }

fn main() -> i32 {
    let k1 = kind_of(42);
    if (k1 != "int") { return 1; }

    let k2 = kind_of(3.14);
    if (k2 != "float") { return 2; }

    let k3 = kind_of("hi");
    if (k3 != "string") { return 3; }

    let k4 = kind_of(true);
    if (k4 != "bool") { return 4; }

    return 0;
}
