// ADV2: typeof(instance_of_class) — what does it return?
// Expect the class's canonical name.

class Foo { public x: i32; }

fn main() -> i32 {
    let f = Foo { x: 7 };
    let t = typeof(f);
    // Accept any response containing "Foo" — compiler may print "Foo" or a
    // wrapper; tight match would overfit.
    if (t != "Foo") { return 1; }
    return 0;
}
