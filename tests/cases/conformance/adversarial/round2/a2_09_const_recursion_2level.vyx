// ADV2: const template instantiates another const template with a
// derived value. Do both monomorphs get created distinctly?

fn inner<const K: i64>() -> i64 { return K * 2; }

fn outer<const N: i64>() -> i64 {
    return inner::<N>() + N;
}

fn main() -> i32 {
    let a = outer::<5>();    // inner<5> = 10; outer = 10 + 5 = 15
    if (a != 15) { return 1; }

    let b = outer::<10>();   // inner<10> = 20; outer = 20 + 10 = 30
    if (b != 30) { return 2; }

    return 0;
}
