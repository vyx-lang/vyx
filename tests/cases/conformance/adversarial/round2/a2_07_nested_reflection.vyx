// ADV2: T::name of a user-defined class, then typeof(T::name).
// Chains reflection + typeof.

use std.string;

class Widget { public id: i32; }

fn intro<T>() -> string {
    let n: string = T::name;
    let t: string = typeof(n);
    // Build a composite string: "<T::name>:<typeof>"
    return n + ":" + t;
}

fn main() -> i32 {
    let s = intro::<Widget>();
    // Expected: "Widget:string"
    if (s != "Widget:string") { return 1; }
    return 0;
}
