// ADV2: generic function A calls generic function B — does Mono
// cascade instantiate B<i32> when A<i32> is requested?

fn inner<T>(v: T) -> string { return T::name; }

fn outer<T>(v: T) -> string {
    return inner::<T>(v);
}

fn main() -> i32 {
    let s = outer::<i32>(42);
    if (s != "i32") { return 1; }

    let s2 = outer::<string>("hi");
    if (s2 != "string") { return 2; }

    return 0;
}
