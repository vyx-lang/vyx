// ADV2: same concept constraint satisfied by multiple concrete types.
// Check concept resolution doesn't cache across types.

interface Named { fn name() -> string; }

class Dog : Named { public fn name() -> string { return "dog"; } }
class Cat : Named { public fn name() -> string { return "cat"; } }
class Cow : Named { public fn name() -> string { return "cow"; } }

fn say<T>(v: T) -> string where T: Named { return v.name(); }

fn main() -> i32 {
    let d = Dog {};
    let c = Cat {};
    let w = Cow {};
    let n1 = say::<Dog>(d);
    let n2 = say::<Cat>(c);
    let n3 = say::<Cow>(w);
    if (n1 != "dog") { return 1; }
    if (n2 != "cat") { return 2; }
    if (n3 != "cow") { return 3; }
    return 0;
}
