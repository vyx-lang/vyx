// ADV2: class with const-generic param.  ClassTemplate instantiation
// path (different from fn) must handle N→literal.

class Buffer<T, const N: i64> {
    public size: i64;
    public static fn make() -> Buffer<T, N> {
        return Buffer { size: N };
    }
}

fn main() -> i32 {
    let b = Buffer::<i32, 16>.make();
    if (b.size != 16) { return 1; }
    return 0;
}
