// ADV2: pack fold with multiplication — factorial-lite pattern.

fn product<...Ts>(...args: Ts) -> i64 {
    return args...*;
}

fn main() -> i32 {
    let r = product(1, 2, 3, 4, 5);   // 120
    if (r != 120) { return 1; }

    let r2 = product(7);              // single element — should be 7
    if (r2 != 7) { return 2; }

    return 0;
}
