// ADV2: two separate variadic functions called back-to-back with
// different type packs. Mono must keep their monomorphs distinct.

fn sum_ints<...Ts>(...args: Ts) -> i64 { return args...+; }
fn sum_floats<...Ts>(...args: Ts) -> f64 { return args...+; }

fn main() -> i32 {
    let a = sum_ints(1, 2, 3);           // 6
    let b = sum_floats(1.5, 2.5);         // 4.0
    let c = sum_ints(10, 20, 30, 40);     // 100

    if (a != 6)   { return 1; }
    if (b != 4.0) { return 2; }
    if (c != 100) { return 3; }
    return 0;
}
