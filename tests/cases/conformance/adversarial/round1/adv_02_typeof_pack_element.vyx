// ADV: typeof(e) on a pack expansion element. Does Mono's pack-subst
// interact with typeof correctly? Untested composition.

fn print_types<...Ts>(...args: Ts) -> i64 {
    var n: i64 = 0;
    for a in args {
        print(typeof(a));
        n = n + 1;
    }
    return n;
}

fn main() -> i32 {
    let n = print_types(1, "hi", true);
    if (n != 3) { return 1; }
    return 0;
}
