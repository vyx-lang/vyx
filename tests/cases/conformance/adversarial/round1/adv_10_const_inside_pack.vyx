// ADV: mix variadic + const param. Completely untested composition.

fn repeat_const<const N: i64, ...Ts>(...args: Ts) -> i64 where N > 0 {
    // Return pack length times N; simple product.
    return args.len * N;
}

fn main() -> i32 {
    let r = repeat_const::<3>(1, 2, 3, 4);   // 4 args * 3 = 12
    if (r != 12) { return 1; }
    return 0;
}
