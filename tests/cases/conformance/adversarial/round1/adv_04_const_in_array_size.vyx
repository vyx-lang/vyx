// ADV: use `N` as the size of a fixed-size array inside a function body.
// Non-trivial — requires const-N to substitute into type annotation, not
// just expression.

fn make_zeros<const N: i64>() -> i64 where N > 0 {
    var arr: [i64; N];
    var i: i64 = 0;
    while (i < N) {
        arr[i] = 0;
        i = i + 1;
    }
    return arr[0];
}

fn main() -> i32 {
    let z = make_zeros::<8>();
    if (z != 0) { return 1; }
    return 0;
}
