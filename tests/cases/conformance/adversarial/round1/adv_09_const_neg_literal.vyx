// ADV: negative integer as const arg. Parser accepts `-<intlit>` form.

fn abs_val<const N: i64>() -> i64 {
    if (N < 0) { return 0 - N; }
    return N;
}

fn main() -> i32 {
    let a = abs_val::<-42>();
    if (a != 42) { return 1; }

    let b = abs_val::<99>();
    if (b != 99) { return 2; }

    return 0;
}
