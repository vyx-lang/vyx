// ADV: T::name inside a GENERIC CLASS method body. My Sema lowering pass
// runs on function bodies, not class method bodies — probably broken.

class BoxDemo<T> {
    public v: i32;
    public fn describe() -> string {
        return T::name;
    }
}

fn main() -> i32 {
    let b = BoxDemo::<i32>.new();
    let s = b.describe();
    if (s != "i32") { return 1; }
    return 0;
}
