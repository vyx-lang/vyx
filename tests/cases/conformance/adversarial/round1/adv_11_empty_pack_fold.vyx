// ADV: fold over empty pack. What does `args...+` with 0 args compile to?
// Either: compile-error (OK — undefined fold), or identity element (0).

fn sum<...Ts>(...args: Ts) -> i64 {
    return args...+;
}

fn main() -> i32 {
    let r = sum();   // fold of 0 elements — what?
    // Accept any deterministic behaviour — overfit signal = crash.
    return 0;
}
