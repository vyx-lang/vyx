// ADV: const predicate comparing two const params (not literal).
// Probably broken — my const evaluator was written for N-op-literal.

fn ratio<const A: i64, const B: i64>() -> i64 where A > B {
    return A - B;
}

fn main() -> i32 {
    let r = ratio::<10, 3>();       // 10 > 3 OK, returns 7
    if (r != 7) { return 1; }

    let r2 = ratio::<100, 99>();    // 100 > 99 OK, returns 1
    if (r2 != 1) { return 2; }

    return 0;
}
