// ADV: reflect fields of a class with a parent class. Does inheritance
// flatten into T::fields?

class Base {
    public b1: i32;
    public b2: i32;
}

class Derived : Base {
    public d1: i32;
}

fn count<T>() -> i32 {
    var n: i32 = 0;
    for f in T::fields { n = n + 1; }
    return n;
}

fn main() -> i32 {
    let c = count::<Derived>();
    // Expected: 3 (b1, b2, d1) if inheritance is flattened; 1 otherwise.
    // Either outcome is acceptable; overfit risk = crash / wrong count.
    if (c < 1 || c > 5) { return c; }   // sanity bound
    return 0;
}
