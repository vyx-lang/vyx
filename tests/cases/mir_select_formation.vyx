var select_effects: i32 = 0;

fn tick(value: i32) -> i32 {
    select_effects = select_effects + 1;
    return value;
}

fn choose(flag: bool, left: i32, right: i32) -> i32 {
    let result: i32 = if (flag) {
        left;
    } else {
        right;
    };
    return result;
}

fn call_arm_must_remain_branch(flag: bool) -> i32 {
    let result: i32 = if (flag) {
        tick(11);
    } else {
        tick(22);
    };
    return result;
}

fn main() -> i32 {
    if (choose(true, 10, 20) != 10) { return 1; }
    if (choose(false, 10, 20) != 20) { return 2; }
    if (call_arm_must_remain_branch(true) != 11) { return 3; }
    if (call_arm_must_remain_branch(false) != 22) { return 4; }
    if (select_effects != 2) { return 5; }
    print("mir_select_formation OK");
    return 0;
}
