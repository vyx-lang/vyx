// Active LLVM/MIR string-length regression. The unknown-C case intentionally
// crosses a raw C pointer boundary and must keep its strlen scan.
extern "C" {
    fn getenv(name: rawptr) -> rawptr;
    fn malloc(size: i64) -> rawptr;
    fn free(value: rawptr);
}

fn header_len_direct_int_to_string() -> i32 {
    let text = int_to_string(-314159);
    let ok = text == "-314159" && text.len == 7;
    if (!ok) { return 11; }
    return 0;
}

fn header_len_numeric_to_string() -> i32 {
    let value: i64 = -2024;
    let text = value.toString();
    let interpolated = "value=${value}";
    let ok = text == "-2024" && text.len == 5
        && interpolated == "value=-2024" && interpolated.len == 11;
    if (!ok) { return 21; }
    return 0;
}

fn header_len_unsigned_to_string() -> i32 {
    let value: u64 = ~0u64;
    let direct = value.toString();
    let interpolated = "value=${value}";
    var builder = StringBuilder.create();
    builder.append(value.toString());
    let built = builder.build();
    let ok = direct == "18446744073709551615" && direct.len == 20
        && interpolated == "value=18446744073709551615" && interpolated.len == 26
        && built == "18446744073709551615";
    builder.destroy();
    if (!ok) { return 24; }
    return 0;
}

fn header_len_float_to_string() -> i32 {
    let positive: f64 = 3.5;
    let negative: f64 = -12.25;
    let direct = positive.toString();
    let signed = negative.toString();
    let interpolated = "float=${positive}";
    let ok = direct == "3.5" && direct.len == 3
        && signed == "-12.25" && signed.len == 6
        && interpolated == "float=3.5" && interpolated.len == 9;
    if (!ok) { return 26; }
    return 0;
}

fn header_len_bool_to_string() -> i32 {
    let direct = bool_to_string(true);
    // Keep the member conversion dynamic so O2 must retain the length select.
    let value: bool = argCount() > 0;
    let member = value.toString();
    var member_ok = false;
    if (value) {
        member_ok = member == "true" && member.len == 4;
    } else {
        member_ok = member == "false" && member.len == 5;
    }
    let ok = direct == "true" && direct.len == 4 && member_ok;
    if (!ok) { return 31; }
    return 0;
}

fn header_len_scalar_print() -> i32 {
    print(-42);
    let max: u64 = ~0u64;
    print(max);
    let dynamic_bool = argCount() > 1;
    if (dynamic_bool) {
        print(!dynamic_bool);
    } else {
        print(dynamic_bool);
    }
    if (dynamic_bool) {
        print(dynamic_bool);
    } else {
        print(!dynamic_bool);
    }
    return 0;
}

fn header_len_pointer_to_string() -> i32 {
    let storage = malloc(1);
    if (storage == null) { return 41; }
    let text = storage.toString();
    let count = text.len;
    free(storage);
    if (count <= 0) { return 42; }
    return 0;
}

fn header_len_ascii_case() -> i32 {
    let upper = "aZ09!".toUpper();
    let lower = "Qx72?".toLower();
    let ok = upper == "AZ09!" && upper.len == 5
        && lower == "qx72?" && lower.len == 5;
    if (!ok) { return 51; }
    return 0;
}

// Keep this as a direct String regression rather than only exercising the
// StringBuilder path above.  The four decimal appends cross the SSO boundary,
// so it validates both the shared-MIR rewrite and String's grow/write path.
fn header_len_string_append_decimal() -> i32 {
    let min: i64 = -9223372036854775807 - 1;
    let max: u64 = ~0u64;
    var text = String.empty();
    text.append(min.toString());
    text.append("|");
    text.append(max.toString());
    text.append("|");
    text.append(min.toString());
    text.append("|");
    text.append(max.toString());
    let decimal_ok = text.raw() == "-9223372036854775808|18446744073709551615|-9223372036854775808|18446744073709551615"
        && text.len == 83;
    text.destroy();
    if (!decimal_ok) { return 54; }

    var source = String.from("aZ09!");
    let upper = source.toUpper();
    let lower = upper.toLower();
    let case_ok = upper.raw() == "AZ09!" && lower.raw() == "az09!";
    lower.destroy();
    upper.destroy();
    source.destroy();
    if (!case_ok) { return 55; }
    return 0;
}

fn header_len_substring() -> i32 {
    let source = "prefix:target:suffix";
    let part = source.substring(7, 13);
    let ok = part == "target" && part.len == 6;
    if (!ok) { return 61; }
    return 0;
}

fn header_len_unknown_cstr() -> i32 {
    // getenv returns an opaque C string. It is not a Vyx string value and has
    // no Vyx length header, so from_cstr must retain its strlen scan.
    let raw = getenv("VYX_HEADER_STRING_LEN_TEST".ptr);
    // The dedicated IR regression supplies this variable. The full module
    // sweep does not own the caller environment, so use PATH solely as a
    // portable non-null opaque-C fallback; it must follow the same scan path.
    let source = if (raw == null) { getenv("PATH".ptr) } else { raw };
    if (source == null) { return 71; }
    let text = from_cstr(source);
    let count = text.len;
    if (count <= 0) { return 72; }
    return 0;
}

fn main() -> i32 {
    let direct = header_len_direct_int_to_string();
    if (direct != 0) { return direct; }
    let numeric = header_len_numeric_to_string();
    if (numeric != 0) { return numeric; }
    let unsigned_result = header_len_unsigned_to_string();
    if (unsigned_result != 0) { return unsigned_result; }
    let float_value = header_len_float_to_string();
    if (float_value != 0) { return float_value; }
    let boolean = header_len_bool_to_string();
    if (boolean != 0) { return boolean; }
    let scalar_print = header_len_scalar_print();
    if (scalar_print != 0) { return scalar_print; }
    let pointer = header_len_pointer_to_string();
    if (pointer != 0) { return pointer; }
    let ascii = header_len_ascii_case();
    if (ascii != 0) { return ascii; }
    let string_decimal = header_len_string_append_decimal();
    if (string_decimal != 0) { return string_decimal; }
    let substring = header_len_substring();
    if (substring != 0) { return substring; }
    let unknown = header_len_unknown_cstr();
    if (unknown != 0) { return unknown; }
    print("llvm_header_string_len OK");
    return 0;
}
