use std.vio;

@[async]
fn async_ready_value(value: i32) -> i32 {
    return value;
}

@[async]
fn async_suspend_scope(value: i32) -> i32 {
    let before_suspend = value + 1;
    let resumed_task = async_ready_value(before_suspend + 1);
    let resumed = await resumed_task;
    return before_suspend + resumed;
}

fn main() -> i32 {
    vio_start();
    let async_value = await async_suspend_scope(20);
    if (async_value < 0) { return 1; }
    print("async_suspend_lifetime_min OK");
    return 0;
}
