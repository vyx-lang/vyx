use std.collections;
use std.core;

error ParseError {
    InvalidNumber
}

fn identity<T>(x: T) -> T { return x; }

fn add<T>(left: T, right: T) -> T where T: Add { return left + right; }

fn classify(value: i32) -> i32 {
    match (value) {
        case 0 => { return 10; }
        case 1 => { return 20; }
        default => { return 30; }
    }
}

fn classify_command(command: string) -> i32 {
    match (command) {
        case "start" => { return 1; }
        case "quit" => { return 2; }
        default => { return 3; }
    }
}

fn parse_number(input: string) -> Result<i32, ParseError> {
    if (input == "42") { return 42; }
    fail ParseError.InvalidNumber;
}

fn parse_plus_one(input: string) -> Result<i32, ParseError> {
    let value = parse_number(input)?;
    return value + 1;
}

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(20);
    values.push(22);
    if (values.count() != 2 || values.get(0) + values.get(1) != 42) { return 1; }

    var scores = Dict::<string, i32>.new();
    scores.put("alice", 42);
    if (!scores.contains("alice") || scores.get("alice") != 42) { return 2; }

    let plus7 = |x: i32| { return x + 7; };
    if (plus7(35) != 42 || identity::<i32>(42) != 42 || add::<i32>(20, 22) != 42) { return 3; }
    if (classify(0) != 10 || classify(9) != 30) { return 4; }
    if (classify_command("quit") != 2 || classify_command("other") != 3) { return 5; }

    let text = "Hello, World!";
    if (!text.contains("World")) { return 6; }
    if (text.index_of("World") != 7) { return 7; }
    if (!text.starts_with("Hello") || !text.ends_with("!")) { return 8; }
    if (text.substring(0, 5) != "Hello") { return 9; }
    if (text.to_upper() != "HELLO, WORLD!") { return 10; }
    if (text.to_lower() != "hello, world!") { return 11; }

    var arithmetic = 10;
    arithmetic += 5;
    arithmetic *= 2;
    if (arithmetic != 30 || (0xFF & 0x0F) != 0x0F) { return 12; }

    match (parse_plus_one("42")) {
        case Ok(value) => { if (value != 43) { return 13; } }
        case Err(_) => { return 14; }
    }
    match (parse_plus_one("bad")) {
        case Ok(_) => { return 15; }
        case Err(_) => { }
    }

    values.destroy();
    scores.destroy();
    return 0;
}
