module tests.reflection_full_model;

use std.reflect;

@[reflect("NamedInterface")]
public interface Named {
    fn tag() -> i32;
}

@[reflect("ParentType")]
public class Parent {
    @[reflect("baseValue", alias=["base_alias"])]
    public base: i64;

    public fn parentAdd(a: i32) -> i32 {
        return (self.base as i32) + a;
    }
}

@[reflect("ChildType", alias=["ChildAlias"])]
public class Child : Parent + Named {
    @[reflect("data", alias=["value", "payload"])]
    public child_data: i64;

    @[hidden]
    public skipped: i64;

    private secret: i64;

    @[reflect("sum", alias=["addAlias"])]
    public fn add(a: i32) -> i32 {
        return (self.base as i32) + (self.child_data as i32) + a;
    }

    public fn tag() -> i32 {
        return 77;
    }
}

type BoundAdd = fn(i32) -> i32;
type RawAdd = unsafe fn(receiver: rawptr, a: i32) -> i32;

fn main() -> i32 {
    var src = Child {
        base: 10,
        child_data: 20,
        skipped: 30,
        secret: 40
    };

    let t = getType("ChildAlias");
    if (!t.valid) { return 1; }
    if (t.name != "ChildType") { return 2; }
    if (!t.matches::<Child>()) { return 3; }
    if (t.parentName() != "ParentType") { return 4; }
    if (!t.parentType().valid) { return 5; }
    if (t.interfaceCount() != 1) { return 6; }
    if (t.interfaceName(0) != "NamedInterface") { return 7; }
    if (!t.interfaceType(0).valid) { return 8; }

    let inherited = t.getField("base_alias");
    if (!inherited.valid) { return 9; }
    if (inherited.name != "baseValue") { return 10; }
    let field = t.getField("payload");
    if (!field.valid) { return 11; }
    if (field.name != "data") { return 12; }
    if (t.getField("skipped").valid) { return 13; }
    if (t.getField("secret").valid) { return 14; }

    var inst = t.bind(&src);
    if (!inst.valid) { return 15; }
    let prop = inst.getProperty("value");
    if (!prop.valid) { return 16; }
    if (prop.view::<i64>() != 20) { return 17; }
    inst.write::<i64>(prop, 35);
    if (src.child_data != 35) { return 18; }
    let prop_ref = prop.as::<i64>();
    ptr_write_i64(prop_ref as rawptr, 36);
    if (src.child_data != 36) { return 19; }

    var rebound = t.create();
    if (!rebound.valid) { return 20; }
    rebound = &src;
    rebound.getProperty("data").write::<i64>(41);
    if (src.child_data != 41) { return 21; }

    var copied = t.create();
    if (!copied.valid) { return 22; }
    copied = Child { base: 1, child_data: 2, skipped: 3, secret: 4 };
    let copied_view = copied.view::<Child>();
    if (copied_view.base != 1 || copied_view.child_data != 2) { return 23; }
    let copied_ptr = copied.as::<Child>();
    ptr_write_i64((copied_ptr as rawptr) + field.offset, 44);
    if (copied.view::<Child>().child_data != 44) { return 24; }
    print("reflect copied ok");

    let m = inst.getMethod("addAlias");
    if (!m.valid) { return 25; }
    if (m.name != "sum") { return 26; }
    if (!m.hasAlias("addAlias")) { return 27; }
    if (m.param_count != 1) { return 28; }
    if (m.paramType(0) != "i32") { return 29; }
    if (m.return_type != "i32") { return 30; }
    print("reflect method metadata ok");
    let bound: BoundAdd = m.as::<BoundAdd>();
    print("reflect method as ok");
    if (bound(1) != 52) { return 31; }
    print("reflect bound method ok");

    let raw: RawAdd = t.getMethod("sum").as::<RawAdd>();
    if (raw(to_rawptr(&src), 2) != 53) { return 32; }
    print("reflect raw method ok");

    let parent_method = inst.getMethod("parentAdd");
    if (!parent_method.valid) { return 33; }
    let parent_bound: BoundAdd = parent_method.as::<BoundAdd>();
    if (parent_bound(5) != 15) { return 34; }

    print(t.name);
    print(src.child_data.toString());
    return 0;
}
