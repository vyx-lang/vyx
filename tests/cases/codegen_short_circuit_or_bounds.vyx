use std.collections;

var g_hits: i32 = 0;

fn hit(v: bool) -> bool {
    g_hits = g_hits + 1;
    return v;
}

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(7);

    let i = 0;
    if (i == 0 || values.get(99) == 1) {
    } else {
        return 1;
    }

    if (i != 0 && values.get(99) == 1) { return 2; }

    let left_or = true || hit(true);
    if (!left_or) { return 3; }
    if (g_hits != 0) { return 4; }

    let left_and = false && hit(true);
    if (left_and) { return 5; }
    if (g_hits != 0) { return 6; }

    let right_or = false || hit(true);
    if (!right_or) { return 7; }
    if (g_hits != 1) { return 8; }

    let right_and = true && hit(true);
    if (!right_and) { return 9; }
    if (g_hits != 2) { return 10; }

    let nested = (false && hit(true)) || (true || hit(false));
    if (!nested) { return 11; }
    if (g_hits != 2) { return 12; }

    let not_nested = !((false && hit(true)) || false);
    if (!not_nested) { return 13; }
    if (g_hits != 2) { return 14; }

    return 0;
}
