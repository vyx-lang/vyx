// P4-D follow-up #5 verification: early return / break / continue from
// a nested block must drop every enclosing scope's heap-owning locals
// before transferring control.
//
// Strategy: pass a Weak<i64> (`probe_w`) into helper; helper allocates
// a fresh Ref::<i64>.new(...) and clones it onto probe (sharing same
// rc cell). Then helper returns from a nested block. Caller observes
// `probe_w.strong_count()`:
//   * Without #5 fix: the helper's `local` Ref binding is never dropped
//     because early-return bypasses block-end. probe_w sees strong=1.
//   * With #5 fix: helper's local Ref is dropped before ret. probe_w
//     sees strong=0.
//
// The clone-onto-probe trick avoids needing the helper to "return"
// the local out: probe is a parameter (the rc cell is shared via
// the clone) and survives the helper return so we can observe.

use std.ref;

fn helper(probe: Ref<i64>) {
    var local = probe.clone();
    // Now probe + local both alias the same rc cell. probe.strong = 2.
    {
        if (local.count() == 2) {
            // Early return from nested scope. With the fix, `local` is
            // dropped here -> probe.strong drops back to 1. Without fix,
            // probe.strong stays at 2 (leak: local never dropped on this
            // path).
            return;
        }
    }
}

fn main() -> i32 {
    var r = Ref::<i64>.new(100);
    if (r.count() != 1) { return 1; }
    helper(r.clone());
    // After helper returns, the temporary clone passed in was dropped at
    // helper exit (function-body end). What we want to verify: helper's
    // OWN local `local` was dropped on the early-return path inside the
    // nested block. If yes, r.count() should be 1 again (helper's clone
    // arg dropped at helper-exit, helper's local dropped before early
    // return). If no (limit #5 not fixed), helper's local would still
    // hold a strong reference -> r.count() == 2.
    if (r.count() != 1) { return 2; }
    return 0;
}
