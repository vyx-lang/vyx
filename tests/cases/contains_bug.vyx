use std.string;

fn main() -> i32 {
    // Test 1: direct concat in loop
    var s1 = "";
    var i: i64 = 0;
    while (i < 3) {
        s1 = s1 + "X,";
        i = i + 1;
    }
    print("s1='${s1}' contains X: ${s1.contains(\"X\")}");
    
    // Test 2: conditional concat in loop
    var s2 = "";
    i = 0;
    while (i < 6) {
        if (i % 2 == 0) {
            s2 = s2 + "E,";
        } else {
            s2 = s2 + "O,";
        }
        i = i + 1;
    }
    print("s2='${s2}' contains E: ${s2.contains(\"E\")}");
    
    // Test 3: elif chain concat
    var s3 = "";
    i = 0;
    while (i < 6) {
        if (i % 3 == 0) {
            s3 = s3 + "A,";
        } elif (i % 3 == 1) {
            s3 = s3 + "B,";
        } else {
            s3 = s3 + "C,";
        }
        i = i + 1;
    }
    print("s3='${s3}' contains A: ${s3.contains(\"A\")}");
    
    return 0;
}
