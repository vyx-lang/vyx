fn main() -> i32 {
    let s1 = "alpha";
    let s2 = "beta";
    let s3 = "gamma";
    let s4 = "delta";
    let s5 = "epsilon";

    let get1 = |x: i32| -> string { return s1; };
    let get2 = |x: i32| -> string { return s2; };
    let get3 = |x: i32| -> string { return s3; };
    let get4 = |x: i32| -> string { return s4; };
    let get5 = |x: i32| -> string { return s5; };

    var i = 0;
    while (i < 100) {
        let r1 = get1(i);
        let r2 = get2(i);
        let r3 = get3(i);
        let r4 = get4(i);
        let r5 = get5(i);
        i = i + 1;
    }

    print(get1(0));
    print(get2(0));
    print(get3(0));
    print(get4(0));
    print(get5(0));
    print(i);
    return 0;
}
