class SymbolBox {
    public value: i32;

    public fn operator[](self, idx: i32) -> i32 {
        return self.value + idx;
    }

    public fn operator+(self, other: SymbolBox) -> SymbolBox {
        return SymbolBox { value: self.value + other.value };
    }
}

fn id<const N: i64>() -> i64 {
    return N;
}

fn main() -> i32 {
    static_assert(1 + 1 == 2);
    static_assert(sizeof::<i32>() == 4, "i32 is 4 bytes");
    if (sizeof::<i32>() != 4 || sizeof::<i64>() != 8) { return 1; }
    if (alignof::<i32>() != 4) { return 2; }
    if (id::<5>() != 5) { return 3; }

    let a = SymbolBox { value: 4 };
    let b = SymbolBox { value: 9 };
    let c = a + b;
    if (a[3] != 7) { return 4; }
    if (c.value != 13) { return 5; }
    return 0;
}
