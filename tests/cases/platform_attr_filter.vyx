@[platform("__never__")] {
    fn never_block_value() -> i32 {
        return missing_symbol_from_inactive_platform_block;
    }
}

@[platform("__never__")]
fn never_decl_value() -> i32 {
    return missing_symbol_from_inactive_platform_decl;
}

@[platform("windows")]
fn platform_value() -> i32 {
    return 1;
}

@[platform("linux")]
fn platform_value() -> i32 {
    return 2;
}

@[platform("android")]
fn platform_value() -> i32 {
    return 3;
}

@[platform("macos")]
fn platform_value() -> i32 {
    return 4;
}

fn main() -> i32 {
    let v = platform_value();
    if (v >= 1 && v <= 4) {
        return 0;
    }
    return 1;
}
