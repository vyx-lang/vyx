use std.collections;

fn main() -> i32 {
    let s = stack_new();
    stack_push(s, 10);
    stack_push(s, 20);
    stack_push(s, 30);
    let top = stack_peek(s);
    let popped = stack_pop(s);
    let len = stack_len(s);
    stack_free(s);
    if (top == 30 && popped == 30 && len == 2) {
        print("stack API OK");
        return 0;
    }
    print("stack API BROKEN");
    return 1;
}
