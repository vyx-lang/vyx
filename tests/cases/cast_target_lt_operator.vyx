// A primitive cast followed by `<` is a comparison: `x as u64 < y` means
// `(x as u64) < y`. A nominal cast may instead have closed type arguments.
//
// It used to be parsed the other way: `parse_type` greedily read the `<` as a
// generic argument list opener, so the whole tail was swallowed.  Without a
// later `>` that meant `expected ')', got `` at EOF; with one (e.g.
// `x as u64 < b && c > d`) it silently mis-parsed instead.
//
// The operator sweep below is deliberately wide — `<` was the only victim,
// and every other form must keep working after the fix.

use std.collections;

fn cast_lt(a: i64, b: u64) -> bool { return a as u64 < b; }
fn cast_le(a: i64, b: u64) -> bool { return a as u64 <= b; }
fn cast_gt(a: i64, b: u64) -> bool { return a as u64 > b; }
fn cast_ge(a: i64, b: u64) -> bool { return a as u64 >= b; }
fn cast_eq(a: i64, b: u64) -> bool { return a as u64 == b; }
fn cast_ne(a: i64, b: u64) -> bool { return a as u64 != b; }

// `<` inside a larger boolean expression — this is where a stray `>` used to
// be mis-consumed as the closer of a bogus argument list.
fn cast_lt_compound(a: i64, b: u64, c: u64, d: u64) -> bool {
    return a as u64 < b && c > d;
}

// Explicit grouping stays equivalent.
fn cast_lt_grouped(a: i64, b: u64) -> bool { return (a as u64) < b; }

// Chained casts still resolve targets correctly.
fn cast_chain_lt(a: i64, b: u64) -> bool { return a as u64 as u64 < b; }

// A cast inside a call argument is not special-cased away.
fn helps(e: bool, r: i32) -> i32 {
    if (e) { return r; }
    return 0;
}
fn cast_lt_in_call(a: i64, b: u64) -> i32 { return helps(a as u64 < b, 7); }

type CastCount = u64;
fn cast_named_lt(a: i64, b: u64) -> bool { return a as CastCount < b; }

class CastBox<T> { public value: T; }
fn cast_generic_ptr(p: *CastBox<i32>) -> *CastBox<i32> {
    return p as *CastBox<i32>;
}
fn cast_nested_generic_ptr(p: *CastBox<CastBox<i32>>) -> *CastBox<CastBox<i32>> {
    return p as *CastBox<CastBox<i32>>;
}

// Generic argument lists *outside* a cast target must be untouched.
fn generic_unaffected() -> i32 {
    let v = Vec::<i64>.new();
    v.push(11);
    v.push(31);
    return v.get(0) as i32 + v.get(1) as i32;
}

fn main() -> i32 {
    if (!cast_lt(3, 5)) { return 1; }
    if (cast_lt(5, 3)) { return 2; }
    if (!cast_le(3, 3)) { return 3; }
    if (cast_le(4, 3)) { return 4; }
    if (!cast_gt(9, 5)) { return 5; }
    if (cast_gt(3, 5)) { return 6; }
    if (!cast_ge(5, 5)) { return 7; }
    if (cast_ge(4, 5)) { return 8; }
    if (!cast_eq(4, 4)) { return 9; }
    if (!cast_ne(4, 5)) { return 10; }
    if (!cast_lt_compound(1, 5, 9, 2)) { return 11; }
    if (cast_lt_compound(9, 5, 9, 2)) { return 12; }
    if (!cast_lt_grouped(3, 5)) { return 13; }
    if (!cast_chain_lt(3, 5)) { return 14; }
    if (cast_lt_in_call(2, 5) != 7) { return 15; }
    if (cast_lt_in_call(8, 5) != 0) { return 16; }
    if (generic_unaffected() != 42) { return 17; }
    if (!cast_named_lt(3, 5)) { return 18; }
    return 0;
}
