// Verify test for std/num.vyx — Zero / One / Num traits + primitive
// impls (see std/num.vyx doc for details).
//
// Confirms:
//   * `T::zero()` / `T::one()` dispatch statically from inside a generic
//     body with `where T: Zero` / `where T: One` bounds (Phase 8c).
//   * Generic numeric folds (sum, product) work across i32 / f64 using
//     the combined `Num + Zero + One + Add + Mul` bound set.
//   * Unsigned integer impls are reachable too.
module verify_num;

use std.core;
use std.collections;
use std.num;
use std.ops;

fn generic_sum<T>(xs: Vec<T>) -> T where T: Num, T: Zero, T: Add {
    var s = T::zero();                          // Phase 8c static dispatch
    var i: i64 = 0;
    while (i < xs.size()) {
        s = s.operator_add(xs.get(i));          // routed via `Add` trait
        i = i + 1;
    }
    return s;
}

fn generic_product<T>(xs: Vec<T>) -> T where T: Num, T: One, T: Mul {
    var p = T::one();
    var i: i64 = 0;
    while (i < xs.size()) {
        p = p.operator_mul(xs.get(i));
        i = i + 1;
    }
    return p;
}

fn main() -> i32 {
    // ---- i32 sum / product ----
    var v = Vec::<i32>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    let s = generic_sum::<i32>(v.clone());
    if (s != 15) { return 1; }

    let p = generic_product::<i32>(v);
    if (p != 120) { return 2; }

    // ---- f64 sum (1.5 + 2.5 + 3.0 == 7.0) ----
    var fv = Vec::<f64>.new();
    fv.push(1.5);
    fv.push(2.5);
    fv.push(3.0);

    let fs = generic_sum::<f64>(fv);
    // Exact binary representability of 1.5 / 2.5 / 3.0 / 7.0 means the
    // sum is exact — compare for equality without an epsilon.
    if (fs != 7.0) { return 3; }

    // ---- Empty-vector sums degenerate to the additive identity ----
    var ev = Vec::<i32>.new();
    let es = generic_sum::<i32>(ev);
    if (es != 0) { return 4; }

    // ---- Empty-vector product degenerates to the multiplicative identity ----
    var ev2 = Vec::<i32>.new();
    let ep = generic_product::<i32>(ev2);
    if (ep != 1) { return 5; }

    // (Unsigned types — u32 / u64 — are not currently reachable through
    // `generic_sum` because std/ops.vyx's `impl Add` blocks cover only
    // the signed integer + float family.  Once `impl Add for u32 / u64`
    // lands the same generic_sum call works verbatim; meanwhile their
    // `Zero` / `One` impls still satisfy the markers for user code that
    // needs identity values without the Add bound.)

    return 0;
}
