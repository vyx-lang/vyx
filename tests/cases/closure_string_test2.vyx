fn greet(name: string) -> string {
    return name;
}

fn main() -> i32 {
    let greeting = "world";
    let n = 100;

    let make_msg = |x: i32| -> string {
        return greeting;
    };

    let result = make_msg(1);
    print(result);

    let add = |a: i32| -> i32 {
        return a + n;
    };
    print(add(5));

    let prefix = "Hello, ";
    let suffix = "!";
    let get_prefix = |x: i32| -> string { return prefix; };
    let get_suffix = |x: i32| -> string { return suffix; };
    print(get_prefix(0));
    print(get_suffix(0));
    return 0;
}
