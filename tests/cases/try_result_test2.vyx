use std.core;

error FileError {
    NotFound,
    PermissionDenied,
    IoError
}

@[auto_wrap]
fn read_value() -> Result<i32, FileError> {
    return 99;
}

@[auto_wrap]
fn read_zero() -> Result<i32, FileError> {
    return 0;
}

@[auto_wrap]
fn read_negative() -> Result<i32, FileError> {
    return -7;
}

fn fail_fn() -> Result<i32, FileError> {
    fail FileError.PermissionDenied;
}

fn main() -> i32 {
    let a = read_value()?;
    print(a);

    let b = read_zero()?;
    print(b);

    let c = read_negative()?;
    print(c);

    return 0;
}
