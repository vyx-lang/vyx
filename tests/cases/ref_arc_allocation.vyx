use std.ref;

@[noinline]
fn arc_hot(seed: i64) -> i64 {
    let owner = Ref::<i64>.new(seed * 13 + 7);
    let alias = owner.clone();
    return alias.deref();
}

@[noinline]
fn escaped_arc(seed: i64) -> Ref<i64> {
    return Ref::<i64>.new(seed + 5);
}

fn main() -> i32 {
    if (arc_hot(4) != 59) { return 1; }

    var owner = escaped_arc(8);
    var weak = owner.downgrade();
    if (owner.deref() != 13 || owner.count() != 1 || owner.weak_count() != 1) { return 2; }
    owner.drop();
    if (weak.strong_count() != 0) { return 3; }
    match (weak.upgrade()) {
        case Some(_) => { return 4; }
        case None => {}
    }
    weak.drop();
    return 0;
}
