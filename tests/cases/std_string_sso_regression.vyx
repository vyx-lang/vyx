use std.string;

fn main() -> i32 {
    var inline_value = String.from("small");
    inline_value.append(" value");
    if (!inline_value.isSmall() || inline_value.length() != 11 || inline_value.raw() != "small value") { return 1; }
    inline_value.destroy();

    var value = String.withCapacity(96);
    value.append("tiny");
    value.shrinkToFit();
    if (!value.isSmall() || value.length() != 4 || value.raw() != "tiny") { return 1; }
    value.destroy();

    // Capacity-sufficient push must stay on the inline representation, and
    // the first byte past SSO must grow without losing the existing bytes.
    var pushed = String.empty();
    for (i in 0..23) { pushed.push(97); }
    if (!pushed.isSmall() || pushed.length() != 23) { return 2; }
    pushed.push(98);
    if (!pushed.isHeap() || pushed.length() != 24 || pushed.raw() != "aaaaaaaaaaaaaaaaaaaaaaab") { return 3; }
    pushed.destroy();

    // Exercise the no-grow path with an exact self alias before another
    // capacity-sufficient push.
    var reserved = String.withCapacity(96);
    reserved.append("abc");
    reserved.append(reserved.raw());
    reserved.push(33);
    if (!reserved.isHeap() || reserved.length() != 7 || reserved.raw() != "abcabc!") { return 4; }
    reserved.destroy();

    print("std_string_sso_regression OK");
    return 0;
}
