use std.string;

fn main() -> i32 {
    let s = "hello world hello";
    let r = s.replace("hello", "bye");
    print("replace result: ${r}");
    
    let s2 = "aaa";
    let r2 = s2.replace("a", "bb");
    print("replace2 result: ${r2}");
    
    let s3 = "no match here";
    let r3 = s3.replace("xyz", "abc");
    print("replace3 result: ${r3}");
    
    print("str_replace test done");
    return 0;
}
