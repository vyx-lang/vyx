use std.ref;

class Inner {
    public value: i32

    public static fn new(v: i32) -> Inner {
        return Inner { value: v };
    }

    public fn get_value() -> i32 {
        return self.value;
    }
}

class Outer {
    public data: Ref<Inner>

    public static fn new(v: i32) -> Outer {
        return Outer { data: Ref::<Inner>.new(Inner.new(v)) };
    }

    public fn get_inner_value() -> i32 {
        return self.data.get_value();
    }
}

fn main() -> i32 {
    let o = Outer.new(42);
    let v = o.get_inner_value();
    if (v != 42) { return 1 as i32; }
    return 0 as i32;
}
