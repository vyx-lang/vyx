use std.ref;

class Inner {
    public val: i32

    public static fn new(v: i32) -> Inner {
        return Inner { val: v };
    }

    public fn is_equal(other: Inner) -> bool {
        return self.val == other.val;
    }
}

class Outer {
    public r: Ref<Inner>

    public static fn new() -> Outer {
        return Outer { r: Ref::<Inner>.new(Inner.new(5)) };
    }

    public fn test() -> bool {
        return self.r.deref().is_equal(self.r.deref());
    }
}

fn main() -> i32 {
    let o = Outer.new();
    if (o.test() == false) { return 1 as i32; }
    return 0 as i32;
}
