use std.collections;

error Event {
    Hit(i32),
    Miss(string),
}

fn main() -> i32 {
    let events = Vec::<Event>.new();
    events.push(Event.Hit(42));
    let e = events.get(0);
    match (e) {
        case Hit(n) => {
            print(n);
            return 0;
        }
        case Miss(s) => {
            return 1;
        }
    }
    return -1;
}
