use std.ref;

class Num {
    public val: i32

    public static fn new(v: i32) -> Num {
        return Num { val: v };
    }

    public fn equals(other: Num) -> bool {
        return self.val == other.val;
    }

    public fn add(other: Num) -> Num {
        return Num { val: self.val + other.val };
    }

    public fn get_val() -> i32 {
        return self.val;
    }
}

fn main() -> i32 {
    let a = Ref::<Num>.new(Num.new(10));
    let b = Ref::<Num>.new(Num.new(10));
    let eq = a.deref().equals(b.deref());
    if (eq) {
        print("equal: true");
    } else {
        print("equal: false");
    }

    let c = Ref::<Num>.new(Num.new(5));
    let v = c.deref().get_val();
    print("${v}");

    return 0;
}
