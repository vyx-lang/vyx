use std.ref;

enum Expr {
    Literal(i32),
    Add(Box<Expr>, Box<Expr>),
}

struct Node {
    expr: Box<Expr>
    next: Option<Box<Expr>>
}

fn eval(e: Box<Expr>) -> i32 {
    match (e) {
        case Literal(v) => { return v; }
        default => { return 0; }
    }
}

fn process_node(n: Node) -> i32 {
    let base = eval(n.expr);
    match (n.next) {
        case Some(e) => { return base + eval(e); }
        case None => { return base; }
    }
}

fn main() -> i32 {
    let n = Node { expr: Box::<Expr>.new(Expr.Literal(10)), next: Some(Box::<Expr>.new(Expr.Literal(20))) };
    let result = process_node(n);
    print("${result}");
    return 0;
}
