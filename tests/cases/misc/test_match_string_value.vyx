use std.string;

fn check(name: string, cond: bool) {
    if (cond) { print("PASS: ${name}"); }
    else { print("FAIL: ${name}"); }
}

fn main() -> i32 {
    let source = "xxalpha";
    let part = source.substring(2, source.len);
    var r1: i32 = 0;
    match (part) {
        case "alpha" => { r1 = 1; }
        case "xxalpha" => { r1 = 2; }
        default => { r1 = -1; }
    }

    let prefix = "be";
    let joined = prefix + "ta";
    var r2: i32 = 0;
    match (joined) {
        case "alpha" => { r2 = 10; }
        case "beta" => { r2 = 20; }
        default => { r2 = -10; }
    }

    check("match_string_value", r1 == 1 && r2 == 20);
    return 0;
}
