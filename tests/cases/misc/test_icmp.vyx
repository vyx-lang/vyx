use std.ref;

class Point {
    public x: i32
    public y: i32

    public static fn new(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }
}

fn main() -> i32 {
    let a = Ref::<Point>.new(Point.new(1, 2));
    let b = Ref::<Point>.new(Point.new(3, 4));
    let c = a;
    if (a == c) {
        print("same ref: true");
    }
    if (a == b) {
        print("diff ref: true");
    } else {
        print("diff ref: false");
    }
    return 0;
}
