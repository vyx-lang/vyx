module test.box_deref;

use std.ref;
use std.collections;

public struct Info {
    name: string
    value: i32
}

public enum Item {
    Data(Info),
    Empty,
}

fn test_vec_box_get() {
    var items = Vec::<Item>.new();
    let info1 = Info { name: "first", value: 10 };
    items.push(Item.Data(info1));
    items.push(Item.Empty);

    var i: i64 = 0;
    while (i < items.len) {
        let item = items.get(i);
        match (item) {
            case Data(d) => {
                print("name: ${d.name}, value: ${d.value}");
            }
            case Empty => {
                print("empty");
            }
        }
        i = i + 1;
    }
}

fn main() {
    test_vec_box_get();
}
