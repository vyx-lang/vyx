use std.collections;
use std.ref;

class Num {
    public val: i32

    public static fn new(v: i32) -> Num {
        return Num { val: v };
    }
}

fn main() -> i32 {
    var items = Vec::<Ref<Num>>.new();
    items.push(Ref::<Num>.new(Num.new(1)));
    items.push(Ref::<Num>.new(Num.new(2)));
    items.push(Ref::<Num>.new(Num.new(3)));
    print("${items.len}");
    return 0;
}
