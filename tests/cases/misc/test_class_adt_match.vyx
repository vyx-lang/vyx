// Minimal repro: ADT match binding inside a class method
use std.collections;

error Sig {
    Hit(i32),
    Miss(string),
}

class Handler {
    public count: i32

    public static fn new() -> Handler {
        return Handler { count: 0 };
    }

    public fn process(e: Sig) -> i32 {
        match (e) {
            case Hit(n) => { return n; }
            case Miss(s) => { return 0; }
        }
        return -1;
    }

    public fn process_from_vec(events: Vec<Sig>) -> i32 {
        var total: i32 = 0;
        var i: i64 = 0;
        while (i < 10) {
            let e = events.get(i);
            match (e) {
                case Hit(n) => { total = total + n; }
                case Miss(s) => { }
            }
            i = i + 1;
        }
        return total;
    }
}

fn main() -> i32 {
    let h = Handler.new();
    let r1 = h.process(Sig.Hit(42));
    let r2 = h.process(Sig.Miss("bad"));
    if (r1 == 42 && r2 == 0) {
        print("PASS");
        return 0;
    }
    print("FAIL");
    return 1;
}
