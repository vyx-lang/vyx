use std.ref;

enum Expr {
    Literal(i32),
    Add(Box<Expr>, Box<Expr>),
}

fn eval(e: Expr) -> i32 {
    match (e) {
        case Literal(v) => { return v; }
        case Add(l, r) => { return eval(l.deref()) + eval(r.deref()); }
        default => { return 0; }
    }
}

fn main() -> i32 {
    let e = Box::<Expr>.new(Expr.Literal(42));
    let result = eval(e.deref());
    print("${result}");
    return 0;
}
