use std.ref;

class Inner {
    public val: i32

    public static fn new(v: i32) -> Inner {
        return Inner { val: v };
    }

    public fn is_equal(other: Inner) -> bool {
        return self.val == other.val;
    }
}

class Num {
    public inner: Ref<Inner>

    public static fn new(v: i32) -> Num {
        return Num { inner: Ref::<Inner>.new(Inner.new(v)) };
    }

    public fn test_ref_method() -> bool {
        let a = self.inner;
        let b = self.inner;
        return a.deref().is_equal(b.deref());
    }
}

fn main() -> i32 {
    let n = Num.new(42);
    let result = n.test_ref_method();
    if (result == false) { return 1 as i32; }
    return 0 as i32;
}
