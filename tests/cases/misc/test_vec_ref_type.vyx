use std.ref;
use std.collections;
use std.string;

class Item {
    public name: string

    public static fn new(n: string) -> Item {
        return Item { name: n };
    }

    public fn get_name() -> string {
        return self.name;
    }
}

fn process_items(items: Vec<Ref<Item>>) -> string {
    var result = "";
    for (i in 0..items.len) {
        let item = items.get(i);
        result = result + item.get_name();
    }
    return result;
}

fn main() -> i32 {
    var items = Vec::<Ref<Item>>.new();
    items.push(Ref::<Item>.new(Item.new("hello")));
    items.push(Ref::<Item>.new(Item.new(" world")));
    let result = process_items(items);
    if (result != "hello world") { return 1 as i32; }
    return 0 as i32;
}
