use std.math;

fn near(a: f64, b: f64, eps: f64) -> bool {
    return abs_f64(a - b) <= eps;
}

fn main() -> i32 {
    if (!near(sin(0.0), 0.0, 0.000001)) { return 1; }
    if (!near(cos(0.0), 1.0, 0.000001)) { return 2; }
    if (!near(tan(0.0), 0.0, 0.000001)) { return 3; }
    if (!near(asin(0.0), 0.0, 0.000001)) { return 4; }
    if (!near(acos(0.0), pi() / 2.0, 0.000001)) { return 5; }
    if (!near(atan(1.0), pi() / 4.0, 0.000001)) { return 6; }
    if (!near(atan2(0.0, 1.0), 0.0, 0.000001)) { return 7; }
    if (!near(sqrt(81.0), 9.0, 0.000001)) { return 8; }
    if (!near(cbrt(27.0), 3.0, 0.000001)) { return 9; }
    if (!near(pow(2.0, 10.0), 1024.0, 0.000001)) { return 10; }
    if (!near(log(e()), 1.0, 0.000001)) { return 11; }
    if (!near(log2(8.0), 3.0, 0.000001)) { return 12; }
    if (!near(log10(1000.0), 3.0, 0.000001)) { return 13; }
    if (!near(floor(3.8), 3.0, 0.000001)) { return 14; }
    if (!near(ceil(3.2), 4.0, 0.000001)) { return 15; }
    if (!near(round(3.6), 4.0, 0.000001)) { return 16; }
    if (!near(trunc(3.8), 3.0, 0.000001)) { return 17; }
    return 0;
}
