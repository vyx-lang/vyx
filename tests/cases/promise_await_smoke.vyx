use std.vio;

var g_promise: Promise<i64>;

fn worker() {
    vio_sleep(10);
    g_promise.resolve(42);
}

fn main() -> i32 {
    let p = Promise::<i64>.new();
    g_promise = p.clone();

    let rc = vio_run(worker as i64);
    if (rc != 0) {
        return 1;
    }

    let v = p.await_value();
    if (v != 42) {
        return 2;
    }
    if (!p.is_done()) {
        return 3;
    }
    if (p.is_failed()) {
        return 4;
    }
    if (p.error_code() != 0) {
        return 5;
    }

    let t = Task::<i64>.ready(7);
    if (t.await_value() != 7) {
        return 6;
    }

    return 0;
}
