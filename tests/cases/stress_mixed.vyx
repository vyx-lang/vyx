use std.core;

error IOErr { ReadFail, WriteFail }

fn compute(x: i32) -> Result<i32, IOErr> {
    if (x < 0) { fail IOErr.ReadFail; }
    return x * x;
}

fn main() -> i32 {
    let msg = "test_value";
    let capture_fn = |n: i32| -> string { return msg; };

    var i = 0;
    while (i < 200) {
        let s = capture_fn(i);
        let val = compute(i)?;
        i = i + 1;
    }

    print(capture_fn(0));
    print(i);

    let final_val = compute(15)?;
    print(final_val);

    let a = 10;
    let b = 20;
    let c = 30;
    let sum_fn = |x: i32| -> i32 { return a + b + c + x; };
    print(sum_fn(40));

    return 0;
}
