use std.vio;

var coroutine_steps: i32 = 0;

@[async]
fn delayed_add(left: i32, right: i32) -> i32 {
    await Task::<i32>.sleep(1);
    return left + right;
}

@[async]
fn chained_value() -> i32 {
    let first = await delayed_add(20, 20);
    let ready = await Task::<i32>.ready(2);
    return first + ready;
}

fn coroutine_worker(ctx: rawptr) -> i32 {
    coroutine_steps = 1;
    yield WaitForNextTick();
    coroutine_steps = coroutine_steps + 1;
    return 0;
}

fn main() -> i32 {
    vio_start();

    let value = await chained_value();
    if (value != 42) { vio_stop(); return 1; }

    let promise = Promise::<i32>.failed(7001);
    if (!promise.is_done() || !promise.is_failed() || promise.error_code() != 7001) {
        vio_stop(); return 2;
    }

    let handle = StartCoroutineHandle(coroutine_worker as i64);
    if (!handle.is_valid()) { vio_stop(); return 3; }
    StopCoroutineHandle(handle);
    vio_stop();
    return coroutine_steps - 2;
}
