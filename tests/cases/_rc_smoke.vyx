// P4-D.2 smoke test — Ref<T> / Weak<T> industrial-strength refcount.
//
// Language caveats (2026-04-24) that forced the shape of this test:
//   * Re-assignment (`r2 = new_ref;`) does NOT fire auto-drop on the old
//     value.  Only block exit fires Ref::drop.  We therefore use nested
//     blocks to force releases.
//   * Auto-drop doesn't recursively drop heap-owning fields inside ADTs
//     (Option<Ref<T>> / Result<Ref<T>>).  So we don't let an Option
//     carrying a Ref outlive the strong-count assertions after upgrade.

use std.ref;

fn main() -> i32 {
    var r1 = Ref::<i64>.new(42);
    if (r1.count() != 1) { return 1; }

    // clone: strong bumps to 2.  Leaving the inner scope drops r2 back.
    {
        var r2 = r1.clone();
        if (r1.count() != 2) { return 2; }
        if (r2.count() != 2) { return 3; }
    }
    if (r1.count() != 1) { return 4; }

    // Downgrade to a weak ref: strong unchanged, weak +1.
    var w = Weak::<i64>.of(r1);
    if (r1.count() != 1) { return 5; }
    if (r1.weak_count() != 1) { return 6; }

    // Upgrade while strong alive: Some(Ref), strong bumps to 2 inside
    // the match arm, then drops back on arm exit.
    {
        var opt = w.upgrade();
        match (opt) {
            case Some(u) => {
                if (u.count() != 2) { return 7; }
            }
            case None => { return 8; }
        }
    }

    return 0;
}
