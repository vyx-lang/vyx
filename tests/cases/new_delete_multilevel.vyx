fn main() -> i32 {
    var p = new i32(11);
    if (*p != 11) {
        return 1;
    }

    var pp = new (*i32)(p);
    if (**pp != 11) {
        return 2;
    }
    delete pp;
    if (*p != 11) {
        return 3;
    }

    var ppp = new (**i32)(new (*i32)(p));
    if (***ppp != 11) {
        return 4;
    }
    delete ppp;

    var values = new [i32; 3]{4, 5, 6};
    if ((*values)[0] != 4 || (*values)[2] != 6) {
        return 5;
    }
    delete values;

    var generic_value = new::<i32>(12);
    if (*generic_value != 12) {
        return 6;
    }
    delete generic_value;
    delete p;
    return 0;
}
