extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
}

fn unicode_char_fold_guard() -> i32 {
    // U+007A + U+007A + U+007A = U+016E (366). The old shared pass
    // truncated that intermediate to 8 bits (110, or 'n').
    let above_byte: char = 'z' + 'z' + 'z';
    let low_byte_alias: char = 'n';
    if (above_byte == low_byte_alias) { return 1; }
    return 0;
}

fn main() -> i32 {
    let mixed_sum: u16 = 1u8 + 256u16;
    if (mixed_sum != 257u16) { return 1; }

    let mixed_equal: bool = 1i32 == 2i64;
    if (mixed_equal) { return 2; }

    let folded: i32 = (2i32 + 3i32) * 4i32;
    if (folded != 20i32) { return 3; }

    var selected: i32 = 0;
    if (true && true) {
        selected = 41;
    } else {
        selected = 99;
    }
    if (selected != 41) { return 4; }

    var escaped: bool = true;
    let replacement: bool = false;
    unsafe { memcpy(to_rawptr(&escaped), to_rawptr(&replacement), 1); }
    if (escaped) { return 5; }

    var source_before_write: bool = true;
    let copied_before_write: bool = source_before_write;
    source_before_write = false;
    if (copied_before_write) {
    } else {
        return 6;
    }

    var captured_source: bool = true;
    let clear_capture = [&captured_source]() -> i32 => {
        captured_source = false;
        return 0;
    };
    clear_capture();
    if (captured_source) { return 8; }

    let wrap_i8: i8 = 127i8 + 1i8;
    if (wrap_i8 >= 0i8) { return 9; }
    let wrap_i16: i16 = 32767i16 + 1i16;
    if (wrap_i16 >= 0i16) { return 10; }
    let wrap_i32: i32 = 2147483647i32 + 1i32;
    if (wrap_i32 >= 0i32) { return 11; }
    let wrap_i64: i64 = 9223372036854775807i64 + 1i64;
    if (wrap_i64 >= 0i64) { return 12; }

    let wrap_u8: u8 = 255u8 + 1u8;
    if (wrap_u8 != 0u8) { return 13; }
    let wrap_u16: u16 = 65535u16 + 1u16;
    if (wrap_u16 != 0u16) { return 14; }
    let wrap_u32: u32 = 4294967295u32 + 1u32;
    if (wrap_u32 != 0u32) { return 15; }
    let wrap_u64: u64 = (~0u64) + 1u64;
    if (wrap_u64 != 0u64) { return 16; }

    var overwritten: i32 = 1;
    overwritten = 2;
    overwritten = 3;
    if (overwritten != 3i32) { return 17; }

    // Keep the >255 char probe reachable without depending on the currently
    // inconsistent backend char ABI at runtime.
    unicode_char_fold_guard();

    print("mir_pass_constant_fold OK");
    return 0;
}
