use std.string;

fn main() -> i32 {
    let upper = "Abc".toUpper();
    if (upper != "ABC" || upper.owned != 4) { return 1; }
    str_drop(upper);

    let lower = "AbC".toLower();
    if (lower != "abc" || lower.owned != 4) { return 2; }
    str_drop(lower);

    let empty = "".toUpper();
    if (empty != "" || empty.owned != 4) { return 3; }
    str_drop(empty);

    var index: i64 = 0;
    var total: i64 = 0;
    while (index < 1024) {
        let raw = "drop-${index}-AbC";
        let upper_loop = raw.toUpper();
        let lower_loop = upper_loop.toLower();
        if (lower_loop.startsWith("drop-") && upper_loop.endsWith("ABC")) {
            total = total + raw.len + upper_loop.len + lower_loop.len;
        }
        index = index + 1;
    }
    if (total <= 0) { return 4; }

    let real_value: f64 = 3.5;
    let interpolated = "real=${real_value}";
    if (interpolated != "real=3.5" || interpolated.owned != 4) { return 5; }
    str_drop(interpolated);

    let nested = "runtime=${int_to_string(2468)}";
    if (nested != "runtime=2468" || nested.owned != 4) { return 6; }
    str_drop(nested);

    var text = "";
    var i: i64 = 0;
    while (i < 4096) {
        text = text + "x";
        i = i + 1;
    }
    if (text.len != 4096) { return 7; }
    str_drop(text);
    return 0;
}
