use std.serde.toml;

fn parsed_library_array() -> string {
    let source = "#libs = [\"vyx_rt\"]#";
    let line = source.substring(1, source.len - 1);
    return toml_value(line);
}

fn main() -> i32 {
    let libraries = parsed_library_array();
    var churn = "";
    var i: i32 = 0;
    while (i < 512) {
        churn = churn + "manifest-field-churn";
        i = i + 1;
    }
    let rows = toml_array_to_lines(libraries);
    if (libraries != "[\"vyx_rt\"]") { return 11; }
    if (rows != "vyx_rt\n") { return 12; }
    print("toml_string_ownership OK");
    return 0;
}
