module mir_inferred_local_types;

extern "C" {
    fn malloc(size: i64) -> rawptr;
}

// Mirrors the allocation-size path used by Vec<T>. The unannotated locals
// must receive a closed HIR type before MIR storage is created.
class GenericBuffer<T> {
    public data: rawptr;
    public capacity: i64;
    public elem_size: i64;

    public static fn with_capacity(capacity: i64) -> GenericBuffer<T> {
        let elem_size = sizeof::<T>();
        let bytes = capacity * elem_size;
        let alloc_bytes = if (bytes > 0) { bytes } else { 1 };
        let data = malloc(alloc_bytes);
        return GenericBuffer::<T> {
            data: data,
            capacity: capacity,
            elem_size: elem_size
        };
    }
}

fn main() -> i32 {
    let buffer = GenericBuffer::<u8>.with_capacity(16);
    if (buffer.data == null) { return 1; }
    return 0;
}
