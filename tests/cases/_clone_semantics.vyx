// Clone and scope cleanup across primitive, nested and shared containers.
//
// Verifies both clone contracts from std/clone.vyx:
//   * Contract A — heap-owning containers do a DEEP copy (Vec).
//   * Contract B — Ref<T>.clone() increments the shared cell's refcount.

use std.collections;
use std.ref;

fn main() -> i32 {
    // ── Contract A: Vec<i64>.clone() is a deep copy ────────────────
    var v1 = Vec::<i64>.new();
    v1.push(1);
    v1.push(2);
    v1.push(3);
    var v2 = v1.clone();
    v2.push(99);
    if (v1.len != 3) { return 1; }           // v1 unaffected
    if (v2.len != 4) { return 2; }           // v2 has the new element
    if (v1.get(0) != 1) { return 3; }
    if (v2.get(3) != 99) { return 4; }

    // Nested-container deep-copy: Vec<Vec<i64>>.clone() recurses via
    // inner.clone(). Mutating the inner of the clone must not affect
    // the inner of the original.
    var outer1 = Vec::<Vec<i64>>.new();
    var inner = Vec::<i64>.new();
    inner.push(7);
    inner.push(8);
    outer1.push(inner);
    var outer2 = outer1.clone();
    var inner2 = outer2.get(0);
    inner2.push(9);
    if (outer1.get(0).len != 2) { return 5; }  // original inner unchanged
    if (inner2.len != 3) { return 6; }         // clone inner extended

    // ── Contract B: Ref<T>.clone() is a refcount bump ───────────────
    var shared = Ref::<i64>.new(100);
    if (shared.count() != 1) { return 7; }
    var shared2 = shared.clone();
    if (shared.count() != 2) { return 7; }
    if (shared.deref() != 100) { return 8; }
    shared.set(250);
    if (shared2.deref() != 250) { return 9; }

    return 0;
}
