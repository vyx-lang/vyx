fn main() -> i32 {
    let values: [i32; 5] = [10, 20, 30, 40, 50];
    var untouched = new i32(1);
    var aggregate = new [i32; 5]();

    *aggregate = values;
    if ((*aggregate)[0] != 10 || (*aggregate)[4] != 50) {
        return 1;
    }

    var indirect = new (*i32)(untouched);
    if (**indirect != 1) {
        return 2;
    }
    return 0;
}
