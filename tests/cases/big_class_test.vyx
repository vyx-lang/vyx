struct SmallStruct {
    x: i32
    y: i32
}

struct MediumStruct {
    a: i64
    b: i64
    c: i64
    d: f64
    name: string
}

struct BigStruct {
    f1: i64
    f2: i64
    f3: i64
    f4: i64
    f5: i64
    f6: i64
    f7: i64
    f8: i64
    f9: i64
    f10: i64
    d1: f64
    d2: f64
    d3: f64
    name: string
    label: string
    flag1: bool
    count: i32
}

class BigClass {
    public id: i64
    public name: string
    public value: f64
    public count: i32
    public data1: i64
    public data2: i64
    public data3: i64
    public data4: i64
    public data5: i64
    public tag: string
    public score: f64
    public level: i32
    public active: bool
    public extra1: i64
    public extra2: i64
    public extra3: i64
    public extra4: i64
    public extra5: i64

    public static fn new(id: i64, name: string) -> BigClass {
        return BigClass {
            id: id,
            name: name,
            value: 0.0,
            count: 0,
            data1: 0,
            data2: 0,
            data3: 0,
            data4: 0,
            data5: 0,
            tag: "",
            score: 0.0,
            level: 0,
            active: true,
            extra1: 0,
            extra2: 0,
            extra3: 0,
            extra4: 0,
            extra5: 0
        };
    }

    public fn set_data(d1: i64, d2: i64, d3: i64, d4: i64, d5: i64) {
        self.data1 = d1;
        self.data2 = d2;
        self.data3 = d3;
        self.data4 = d4;
        self.data5 = d5;
    }

    public fn total() -> i64 {
        return self.data1 + self.data2 + self.data3 + self.data4 + self.data5;
    }

    public fn describe() -> string {
        return self.name;
    }
}

fn test_small() -> i32 {
    var s: SmallStruct;
    s.x = 10;
    s.y = 20;
    if (s.x == 10 && s.y == 20) {
        print("SmallStruct: PASS\n");
    } else {
        print("SmallStruct: FAIL\n");
        return 1;
    }
    return 0;
}

fn test_medium() -> i32 {
    var m: MediumStruct;
    m.a = 100;
    m.b = 200;
    m.c = 300;
    m.d = 3.14;
    m.name = "medium";
    if (m.a == 100 && m.b == 200 && m.c == 300) {
        print("MediumStruct: PASS\n");
    } else {
        print("MediumStruct: FAIL\n");
        return 1;
    }
    return 0;
}

fn test_big_struct() -> i32 {
    var b: BigStruct;
    b.f1 = 1;
    b.f2 = 2;
    b.f3 = 3;
    b.f4 = 4;
    b.f5 = 5;
    b.f6 = 6;
    b.f7 = 7;
    b.f8 = 8;
    b.f9 = 9;
    b.f10 = 10;
    b.d1 = 1.1;
    b.d2 = 2.2;
    b.d3 = 3.3;
    b.name = "big";
    b.label = "test";
    b.flag1 = true;
    b.count = 42;

    let sum = b.f1 + b.f2 + b.f3 + b.f4 + b.f5 + b.f6 + b.f7 + b.f8 + b.f9 + b.f10;
    if (sum == 55) {
        print("BigStruct: PASS (sum=55)\n");
    } else {
        print("BigStruct: FAIL sum=");
        print(sum);
        print("\n");
        return 1;
    }
    return 0;
}

fn test_big_class() -> i32 {
    let obj = BigClass.new(1, "test_obj");
    if (obj.id != 1) {
        print("BigClass id: FAIL\n");
        return 1;
    }
    obj.set_data(10, 20, 30, 40, 50);
    let t = obj.total();
    if (t == 150) {
        print("BigClass: PASS (total=150)\n");
    } else {
        print("BigClass: FAIL total=");
        print(t);
        print("\n");
        return 1;
    }
    return 0;
}

fn main() -> i32 {
    print("=== Big Struct/Class Tests ===\n");
    test_small();
    test_medium();
    test_big_struct();
    test_big_class();
    print("=== Done ===\n");
    return 0;
}
