extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
}

fn chain_copy(input: i32) -> i32 {
    let first: i32 = input;
    let second: i32 = first;
    let third: i32 = second;
    return third;
}

fn source_written_after_copy(input: i32) -> i32 {
    var source: i32 = input;
    let snapshot: i32 = source;
    source = source + 1;
    return snapshot;
}

fn escaped_source_copy(input: i32) -> i32 {
    var source: i32 = input;
    let snapshot: i32 = source;
    let replacement: i32 = input + 7;
    unsafe { memcpy(to_rawptr(&source), to_rawptr(&replacement), 4); }
    return snapshot;
}

fn captured_source_copy(input: i32) -> i32 {
    var source: i32 = input;
    let snapshot: i32 = source;
    let observe = [&source]() -> i32 => { return source; };
    if (observe() != input) { return -1; }
    return snapshot;
}

fn identity(value: i32) -> i32 {
    return value;
}

fn cross_block_copy(input: i32, flag: bool) -> i32 {
    // Keep both predecessor blocks materialized. The calls do not receive an
    // address of either local, so the copy fact must survive their join.
    let source: i32 = identity(input);
    let copied: i32 = source;
    if (flag) {
        identity(input);
    } else {
        identity(input);
    }
    return copied;
}

fn copy_into_call(input: i32) -> i32 {
    let source: i32 = input;
    let copied: i32 = source;
    return identity(copied);
}

fn main() -> i32 {
    let input: i32 = argCount();
    if (chain_copy(input) != input) { return 1; }
    if (source_written_after_copy(input) != input) { return 2; }
    if (escaped_source_copy(input) != input) { return 3; }
    if (captured_source_copy(input) != input) { return 4; }
    if (cross_block_copy(input, true) != input) { return 5; }
    if (cross_block_copy(input, false) != input) { return 6; }
    if (copy_into_call(input) != input) { return 7; }
    print("mir_copy_propagation OK");
    return 0;
}
