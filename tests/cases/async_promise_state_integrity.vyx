use std.vio;

fn main() -> i32 {
    let failed = Task::<i32>.failed(42);
    if (!failed.is_done()) { return 1; }
    if (!failed.is_failed()) { return 2; }
    if (failed.error_code() != 42) { return 3; }

    let state = failed.state;
    vio_promise_state_retain(state);
    if (vio_promise_state_done(state) != 1) { return 4; }
    if (vio_promise_state_failed(state) != 1) { return 5; }
    if (vio_promise_state_error(state) != 42) { return 6; }

    let lock = vio_promise_state_lock_handle(state);
    if (lock == null) { return 7; }
    vio_lock_lock(lock);
    let done = vio_promise_state_done(state);
    let is_failed = vio_promise_state_failed(state);
    let code = vio_promise_state_error(state);
    vio_lock_unlock(lock);

    if (done != 1) { return 8; }
    if (is_failed != 1) { return 9; }
    if (code != 42) { return 10; }

    vio_promise_state_release(state);
    print("promise state integrity ok\n");
    return 0;
}
