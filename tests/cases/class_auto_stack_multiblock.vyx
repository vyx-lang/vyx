// Automatic (stack) storage for ordinary class values must extend across
// control flow, not just straight-line code.  A default `class` is a value
// type with the same ABI as `struct` (C++ value semantics): it lives in
// automatic storage, is returned by value, and its methods receive a pointer
// to wherever the object lives.  None of these use the class-pointer heap ABI.
//
// The companion IR check (tests/checks/memory/class_auto_stack_multiblock.ps1)
// asserts the value functions below never call vyx_class_alloc_abi/malloc while
// the explicit `new` function still does, at both O0 and O2 and across JIT/AOT.
class StackPoint {
    public x: i64;
    public y: i64;
    public fn sum() -> i64 { return self.x + self.y; }
}

// Initialized once in the entry block, read through scalar fields in both arms
// of an if/else.  Automatic storage.
@[noinline]
fn stack_if_else(seed: i64, pick_x: bool) -> i64 {
    let p = StackPoint { x: seed + 1, y: seed * 3 - 2 };
    if (pick_x) {
        return p.x * 2;
    } else {
        return p.y + 5;
    }
}

// Read through scalar fields from several match arms.  Automatic storage.
@[noinline]
fn stack_match(seed: i64, sel: i64) -> i64 {
    let p = StackPoint { x: seed + 10, y: seed - 4 };
    match (sel) {
        case 0 => { return p.x; }
        case 1 => { return p.y; }
        default => { return p.x + p.y; }
    }
}

// Built once before a loop that only reads scalar fields.  Automatic storage.
@[noinline]
fn stack_loop(seed: i64, iters: i64) -> i64 {
    let p = StackPoint { x: seed, y: seed + 1 };
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < iters) {
        total = total + p.x + p.y;
        i = i + 1;
    }
    return total;
}

// Identity return: a default class is returned by value (copy/sret/NRVO), the
// same as a struct.  It must NOT be heap-allocated and returned as a pointer.
@[noinline]
fn value_return(seed: i64) -> StackPoint {
    let p = StackPoint { x: seed, y: seed + 7 };
    return p;
}

// Whole-object method receiver on a local value: `self` is a pointer to the
// stack object, so calling a method must not force a heap allocation.
@[noinline]
fn value_method(seed: i64) -> i64 {
    let p = StackPoint { x: seed, y: seed * 2 };
    return p.sum();
}

// Explicit `new` is the only heap path: it has an owning pointer lifetime that
// `delete` releases.  This is the positive heap control.
@[noinline]
fn heap_new(seed: i64) -> i64 {
    let p = new StackPoint { x: seed, y: seed + 7 };
    let r = p.sum();
    delete p;
    return r;
}

fn main() -> i32 {
    if (stack_if_else(4, true) != 10) { return 1; }
    if (stack_if_else(4, false) != 15) { return 2; }
    if (stack_match(4, 0) != 14) { return 3; }
    if (stack_match(4, 1) != 0) { return 4; }
    if (stack_match(4, 9) != 14) { return 5; }
    if (stack_loop(3, 4) != 28) { return 6; }
    if (value_return(5).sum() != 17) { return 7; }
    if (value_method(6) != 18) { return 8; }
    if (heap_new(5) != 17) { return 9; }
    print("class_auto_stack_multiblock OK");
    return 0;
}
