use std.collections;
use std.ref;

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(10);
    values.push(32);
    if (values.count() != 2 || values.get(0) != 10) { return 1; }
    values.set(1, 33);
    if (values.pop() != 33) { return 2; }
    values.destroy();

    var scores = Dict::<string, i32>.new();
    scores.put("alice", 42);
    if (!scores.contains("alice") || scores.get("alice") != 42) { return 3; }
    scores.destroy();

    var seen = Set::<i32>.new();
    seen.add(7);
    seen.add(7);
    if (!seen.contains(7)) { return 4; }
    seen.destroy();

    let a = Ref::<i32>.new(10);
    let b = a.clone();
    if (a.deref() != 10 || b.deref() != 10 || a.count() != 2) { return 5; }
    let unique = Box::<i32>.new(7);
    if (unique.deref() != 7) { return 6; }
    return 0;
}
