extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(value: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
    fn vyx_string_len(value: rawptr) -> i64;
    fn vyx_forget_string_len(value: rawptr);
    fn vyx_string_char_at(value: rawptr, index: i32) -> i32;
}

fn main() -> i32 {
    let buffer = malloc(8);
    if (buffer == null) { return 10; }

    let first_text = "a";
    memcpy(buffer, first_text.ptr, 2);
    let first_len = vyx_string_len(buffer);
    let first_char = vyx_string_char_at(buffer, 0);

    let second_text = "zb";
    memcpy(buffer, second_text.ptr, 3);
    vyx_forget_string_len(buffer);
    let second_len = vyx_string_len(buffer);
    let second_char = vyx_string_char_at(buffer, 0);

    free(buffer);
    if (first_len != 1) { return 11; }
    if (second_len != 2) { return 12; }
    if (first_char != 97) { return 13; }
    if (second_char != 122) { return 14; }
    print("codegen_runtime_memory_attrs OK");
    return 0;
}
