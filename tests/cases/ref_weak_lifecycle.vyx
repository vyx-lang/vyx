use std.ref;

fn main() -> i32 {
    var owner = Ref::<i64>.new(42);
    var weak = owner.downgrade();
    if (owner.count() != 1 || owner.weak_count() != 1) { return 1; }

    owner.drop();
    if (weak.strong_count() != 0) { return 2; }
    match (weak.upgrade()) {
        case Some(_) => { return 3; }
        case None => {}
    }
    weak.drop();
    return 0;
}
