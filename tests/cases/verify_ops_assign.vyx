module verify_ops_assign;

use std.ops;
use std.string;

fn generic_add_assign<T>(base: T, rhs: T) -> T where T: AddAssign {
    var out = base;
    out = out.operator_add_assign(rhs);
    return out;
}

fn main() -> i32 {
    var s = "vyx";
    s += "-";
    s += "std";
    if (s != "vyx-std") { return 1; }

    let direct = s.operator_add_assign("-ops");
    if (direct != "vyx-std-ops") { return 2; }
    if (s != "vyx-std") { return 3; }

    let gen_s = generic_add_assign::<string>("fat", "-std");
    if (gen_s != "fat-std") { return 4; }

    let gen_i = generic_add_assign::<i32>(40, 2);
    if (gen_i != 42) { return 5; }

    return 0;
}
