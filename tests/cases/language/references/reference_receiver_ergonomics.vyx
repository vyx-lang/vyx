module reference_receiver_ergonomics;
use std.collections;

fn mutate(v: &mut Vec<i32>) -> i32 {
    v[0] = v[0] + 1;
    v.push(9);
    return v[0] + v.len;
}

fn inspect(v: &Vec<i32>) -> i32 {
    return v[0] + v.len;
}

class Pair {
    public value: i32;
}

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(40);
    let borrowed: &mut Vec<i32> = &mut values;
    let got = mutate(borrowed);
    if (got != 43) { return 1; }
    if (values[0] != 41 || values[1] != 9) { return 2; }
    let readonly: &Vec<i32> = &values;
    if (inspect(readonly) != 43) { return 3; }

    let ptr = new Pair { value: 7 };
    let via_arrow = ptr->value;
    delete ptr;
    if (via_arrow != 7) { return 4; }
    print("reference receiver ergonomics OK");
    return 0;
}
