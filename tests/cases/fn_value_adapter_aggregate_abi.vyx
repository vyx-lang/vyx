// A function used as a value is entered through a synthetic "value adapter".
// The adapter is reached as a closure fat pointer, which carries the *logical*
// parameter types and returns the logical result, but it forwards to a target
// whose machine signature may differ:
//
//   * a return larger than one machine word comes back through a hidden
//     `sret` pointer, so the callee takes one extra leading parameter and
//     returns void;
//   * a parameter too large to pass directly is passed as a pointer.
//
// The adapter used to forward its own incoming arguments verbatim, so the
// forwarded call had the wrong arity (and wrong argument types) whenever
// either shape applied, and LLVM refused the call:
//   I0100: cannot emit function-value adapter return for <fn>
//
// Coverage is deliberately symmetric — return side, parameter side, and both
// at once — because a fix that handles only one side is easy to write and
// still leaves the other broken.  Every case also *calls through* the value
// and checks the answer, so an adapter that merely emits keeps honest.
//
// Passing a function requires a destination slot: only when some target type
// is `fn(...)` does the adapter exist at all, hence the indirection below.

class Big {
    public a: i64
    public b: i64
    public c: i64
}

class Small {
    public a: i64
}

// --- return side: >8 bytes goes through sret ---
fn big_result(x: i64) -> Big {
    return Big { a: x, b: x + 1, c: x + 2 };
}

fn thru_big_result(cb: fn(i64)->Big) -> Big {
    return cb(4);
}

// --- parameter side: the result still fits in a register ---
fn big_params(x: Big, y: Big) -> i64 {
    return x.a + x.b + x.c + y.a + y.b + y.c;
}

fn thru_big_params(cb: fn(Big,Big)->i64) -> i64 {
    return cb(Big { a: 1, b: 2, c: 3 }, Big { a: 10, b: 20, c: 30 });
}

// --- both sides at once ---
fn big_both(x: Big) -> Big {
    return Big { a: x.c, b: x.b, c: x.a };
}

fn thru_big_both(cb: fn(Big)->Big) -> Big {
    return cb(Big { a: 7, b: 8, c: 9 });
}

// --- baseline: everything already stayed in registers before the fix ---
fn small_scalar(x: i64) -> i64 {
    return x * 3;
}

fn thru_small_scalar(cb: fn(i64)->i64) -> i64 {
    return cb(5);
}

fn small_record(x: i64) -> Small {
    return Small { a: x + 1 };
}

fn thru_small_record(cb: fn(i64)->Small) -> Small {
    return cb(41);
}

fn main() -> i32 {
    let r1 = thru_big_result(big_result);
    if (r1.a != 4 || r1.b != 5 || r1.c != 6) { return 1; }

    if (thru_big_params(big_params) != 66) { return 2; }

    let r3 = thru_big_both(big_both);
    if (r3.a != 9 || r3.b != 8 || r3.c != 7) { return 3; }

    if (thru_small_scalar(small_scalar) != 15) { return 4; }

    let r5 = thru_small_record(small_record);
    if (r5.a != 42) { return 5; }
    return 0;
}
