use std.ref;

struct Payload {
    left: i64;
    right: i64;
}

@[noinline]
fn nonescaping_box_sum(seed: i64) -> i64 {
    let owner = Box::<Payload>.new(Payload { left: seed, right: seed * 7 + 3 });
    let value = owner.deref();
    return value.left + value.right;
}

@[noinline]
fn returned_box(seed: i64) -> Box<Payload> {
    return Box::<Payload>.new(Payload { left: seed, right: seed * 11 + 5 });
}

fn main() -> i32 {
    if (nonescaping_box_sum(4) != 35) { return 1; }

    let escaped = returned_box(3);
    let value = escaped.deref();
    if (value.left != 3 || value.right != 38) { return 2; }
    return 0;
}
