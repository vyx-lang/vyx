use std.vio;

var g_coroutine_seen: i32 = 0;

@[async]
fn async_add(a: i32, b: i32) -> i32 {
    vio_sleep(1);
    return a + b;
}

fn coroutine_worker(ctx: rawptr) -> i32 {
    g_coroutine_seen = 77;
    return 0;
}

fn main() -> i32 {
    let async_task = async_add(20, 22);
    let value = await async_task;
    print("async auto value: ");
    print(value);
    print("\n");
    if (value != 42) { return 1; }

    let direct = await async_add(7, 8);
    print("direct await value: ");
    print(direct);
    print("\n");
    if (direct != 15) { return 2; }

    let handle = StartCoruntine(coroutine_worker as i64);
    if (!handle.is_valid()) { return 3; }
    StopCoruntine(handle);
    if (g_coroutine_seen != 77) { return 4; }
    print("coroutine handle ok\n");
    return 0;
}
