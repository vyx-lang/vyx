// P4-D follow-up #1 verification: reassigning a heap-owning local
// must drop the old value before storing the new one.
//
// We allocate r1, downgrade it to weak w1 (so the rc header survives
// post-drop), then rebind r1 to a fresh Ref. With limit #1 fixed,
// w1.strong_count() flips to 0 right after the rebind because the
// old r1 cell got dropped. Without the fix, it would stay at 1
// (leak — drop never called on the old binding).

use std.ref;

fn main() -> i32 {
    var r1 = Ref::<i64>.new(10);
    var w1 = Weak::<i64>.of(r1);
    if (w1.strong_count() != 1) { return 1; }

    // Rebind. Old r1 cell must be dropped here.
    r1 = Ref::<i64>.new(20);
    if (w1.strong_count() != 0) { return 2; }
    if (r1.count() != 1) { return 3; }

    return 0;
}
