class Animal {
    public name: string
    public legs: i32

    public static fn new(name: string, legs: i32) -> Animal {
        return Animal { name: name, legs: legs };
    }
}

class Dog : Animal {
    public breed: string

    public static fn new(name: string, breed: string) -> Dog {
        return Dog { name: name, legs: 4, breed: breed };
    }
}

class Cat : Animal {
    public indoor: bool

    public static fn new(name: string, indoor: bool) -> Cat {
        return Cat { name: name, legs: 4, indoor: indoor };
    }
}

fn main() -> i32 {
    let dog = Dog.new("Rex", "Labrador");
    let cat = Cat.new("Whiskers", true);
    if (dog.name != "Rex" || dog.legs != 4 || dog.breed != "Labrador") { return 1; }
    if (cat.name != "Whiskers" || cat.legs != 4 || !cat.indoor) { return 1; }
    return 0;
}
