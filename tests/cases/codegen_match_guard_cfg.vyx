use std.ref;

var subject_calls: i32 = 0;
var guard_effects: i32 = 0;
var pattern_effects: i32 = 0;
var mutable_subject: i32 = 7;
var match_rvalue_drops: i32 = 0;

class MatchProbe {
    public value: i32;

    public fn drop() {
        match_rvalue_drops = match_rvalue_drops + 1;
    }
}

fn make_probe(value: i32) -> MatchProbe {
    return MatchProbe { value: value };
}

fn match_probe_return() -> i32 {
    let held = make_probe(99);
    return held.value;
}

fn make_subject() -> i32 {
    subject_calls = subject_calls + 1;
    return 42;
}

fn guard(value: bool, effect: i32) -> bool {
    guard_effects = guard_effects + effect;
    return value;
}

fn mutate_subject() -> bool {
    mutable_subject = 9;
    return false;
}

fn pattern(value: bool, effect: i32) -> bool {
    pattern_effects = pattern_effects + effect;
    return value;
}

fn main() -> i32 {
    var selected: i32 = 0;
    let n = make_subject();
    if (n == 42 && guard(false, 1)) { selected = 1; }
    else if (n == 42 && (false && guard(true, 100))) { selected = 2; }
    else if (n == 42 && (true || guard(false, 1000))) { selected = n; }
    else { selected = -1; }

    if (subject_calls != 1) { return 1; }
    if (guard_effects != 1) { return 2; }
    if (selected != 42) { return 3; }

    let bound = 7;
    if (bound == 8 && guard(true, 10000)) { selected = 8; }
    else if (bound == 7 && guard(true, 10)) { selected = bound; }
    else { selected = -2; }
    if (guard_effects != 11) { return 4; }
    if (selected != 7) { return 5; }

    let subj = mutable_subject;
    if (subj == 7 && mutate_subject()) { selected = 70; }
    else if (subj == 7) { selected = 71; }
    else { selected = -3; }
    if (mutable_subject != 9) { return 6; }
    if (selected != 71) { return 7; }

    match (5) {
        default => { selected = -4; }
        case 5 => { selected = 50; }
        case 6 => { selected = 60; }
    }
    if (selected != 50) { return 8; }

    if (true && pattern(false, 1)) { selected = 80; }
    else if (false || pattern(true, 10)) { selected = 81; }
    else if (false && pattern(true, 100)) { selected = 82; }
    else { selected = -5; }
    if (pattern_effects != 11) {
        print("pattern_effects=${pattern_effects} selected=${selected}");
        return 9;
    }
    if (selected != 81) { return 10; }

    var shared = Ref::<i64>.new(42);
    if (shared.count() != 1) { return 11; }
    let held_ref = shared.clone();
    if (held_ref.count() != 2) { return 12; }
    if (shared.count() != 2) { return 13; }
    if (held_ref.deref() != 42) { return 14; }

    let held_probe = make_probe(77);
    if (held_probe.value != 77) { return 15; }
    if (match_rvalue_drops != 0) { return 16; }
    if (match_probe_return() != 99) { return 17; }

    print("codegen_match_guard_cfg OK");
    return 0;
}
