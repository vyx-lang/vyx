// A non-escaping ordinary class literal must use automatic storage.  Keep the
// function noinline so the LLVM regression can inspect its own allocation
// decisions at both O0 and O2 rather than relying on caller-side inlining.
class AutoStackPair {
    public left: i64;
    public right: i64;
}

@[noinline]
fn class_auto_stack_local(seed: i64) -> i64 {
    let pair = AutoStackPair {
        left: seed + 1,
        right: seed * 9 - 2,
    };

    // Read the scalar fields through the ordinary class value.  Neither the
    // aggregate nor either field reference escapes this activation.
    let left = pair.left;
    let right = pair.right;
    return left * 3 + right;
}

fn main() -> i32 {
    if (class_auto_stack_local(4) != 49) { return 1; }
    if (class_auto_stack_local(-3) != -35) { return 2; }
    print("class_auto_stack_local OK");
    return 0;
}
