struct Player {
    name: string;
    health: i32;
}

class Counter {
    public value: i32;
    public fn increment() { self.value = self.value + 1; }
    public fn reset() { self.value = 0; }
}

class Meter {
    public value: i32;
    public Meter(start: i32) { self.value = start; }
}

fn add(a: i32, b: i32) -> i32 { return a + b; }

fn main() -> i32 {
    let age = 25;
    var score = 0;
    score = score + 10;
    score++;
    if (age != 25 || score != 11) { return 1; }
    let mood = age > 20 ? "adult" : "child";
    if (mood != "adult") { return 6; }

    var total: i64 = 0;
    for (i in 0..5) { total = total + i; }
    if (total != 10 || add(3, 4) != 7) { return 2; }

    var break_continue_total: i64 = 0;
    for (i in 0..100) {
        if (i >= 5) { break; }
        if (i == 3) { continue; }
        break_continue_total += i;
    }
    if (break_continue_total != 7) { return 7; }

    var labeled = 0;
    'outer: while (labeled < 10) {
        while (true) {
            break 'outer;
        }
        labeled = labeled + 1;
    }
    if (labeled != 0) { return 8; }

    let hero = Player { name: "hero", health: 100 };
    if (hero.name != "hero" || hero.health != 100) { return 3; }
    let counter = Counter { value: 0 };
    counter.increment();
    counter.increment();
    if (counter.value != 2) { return 4; }
    counter.reset();
    if (counter.value != 0) { return 5; }
    let meter = Meter(7);
    if (meter.value != 7) { return 9; }
    defer { print("tutorial_beginner_core cleanup\n"); }
    return 0;
}
