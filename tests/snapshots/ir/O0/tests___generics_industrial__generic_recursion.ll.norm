
%__String = type { ptr, i64, i64, i64 }

@_vyx_argc = internal global i32 0
@_vyx_argv = internal global ptr null
@.str = private unnamed_addr constant [33 x i8] c"generic_recursion r1=%d r2=%lld\0A\00", align 1

declare ptr @malloc(i64)

declare void @free(ptr)

declare ptr @memset(ptr, i32, i64)

declare ptr @memcpy(ptr, ptr, i64)

declare i32 @memcmp(ptr, ptr, i64)

declare i64 @strlen(ptr)

declare i32 @strcmp(ptr, ptr)

; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i32 @"count_down<i32>"(i32 %n, i32 %zero, i32 %one) {
entry:
  %one3 = alloca i32, align 4
  %zero2 = alloca i32, align 4
  %n1 = alloca i32, align 4
  store i32 %n, ptr %n1, align 4
  store i32 %zero, ptr %zero2, align 4
  store i32 %one, ptr %one3, align 4
  %n4 = load i32, ptr %n1, align 4
  %zero5 = load i32, ptr %zero2, align 4
  %eq = icmp eq i32 %n4, %zero5
  %cmp.bool = zext i1 %eq to i8
  %ifcond = icmp ne i8 %cmp.bool, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %entry
  %zero6 = load i32, ptr %zero2, align 4
  ret i32 %zero6

ifmerge:                                          ; preds = %entry
  %one7 = load i32, ptr %one3, align 4
  %n8 = load i32, ptr %n1, align 4
  %one9 = load i32, ptr %one3, align 4
  %sub = sub i32 %n8, %one9
  %zero10 = load i32, ptr %zero2, align 4
  %one11 = load i32, ptr %one3, align 4
  %call = call i32 @"count_down<i32>"(i32 %sub, i32 %zero10, i32 %one11)
  %add = add i32 %one7, %call
  ret i32 %add
}

define i64 @"count_down<i64>"(i64 %n, i64 %zero, i64 %one) {
entry:
  %one3 = alloca i64, align 8
  %zero2 = alloca i64, align 8
  %n1 = alloca i64, align 8
  store i64 %n, ptr %n1, align 4
  store i64 %zero, ptr %zero2, align 4
  store i64 %one, ptr %one3, align 4
  %n4 = load i64, ptr %n1, align 4
  %zero5 = load i64, ptr %zero2, align 4
  %eq = icmp eq i64 %n4, %zero5
  %cmp.bool = zext i1 %eq to i8
  %ifcond = icmp ne i8 %cmp.bool, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %entry
  %zero6 = load i64, ptr %zero2, align 4
  ret i64 %zero6

ifmerge:                                          ; preds = %entry
  %one7 = load i64, ptr %one3, align 4
  %n8 = load i64, ptr %n1, align 4
  %one9 = load i64, ptr %one3, align 4
  %sub = sub i64 %n8, %one9
  %zero10 = load i64, ptr %zero2, align 4
  %one11 = load i64, ptr %one3, align 4
  %call = call i64 @"count_down<i64>"(i64 %sub, i64 %zero10, i64 %one11)
  %add = add i64 %one7, %call
  ret i64 %add
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result = alloca i8, align 1
  %r2 = alloca i64, align 8
  %r1 = alloca i32, align 4
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %call = call i32 @"count_down<i32>"(i32 5, i32 0, i32 1)
  store i32 %call, ptr %r1, align 4
  %call1 = call i64 @"count_down<i64>"(i64 10, i64 0, i64 1)
  store i64 %call1, ptr %r2, align 4
  %r12 = load i32, ptr %r1, align 4
  %r23 = load i64, ptr %r2, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i32 %r12, i64 %r23)
  %0 = call i32 @fflush(ptr null)
  %r14 = load i32, ptr %r1, align 4
  %eq = icmp eq i32 %r14, 5
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %r25 = load i64, ptr %r2, align 4
  %eq6 = icmp eq i64 %r25, 10
  %cmp.bool7 = zext i1 %eq6 to i8
  %sc.r = icmp ne i8 %cmp.bool7, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %ifcond = icmp ne i8 %sc.val, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done
  ret i32 0

ifmerge:                                          ; preds = %sc.done
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
