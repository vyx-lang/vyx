declare i32 @strcmp(ptr, ptr)

; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i32 @id_i32(i32 %x) {
entry:
  %x1 = alloca i32, align 4
  store i32 %x, ptr %x1, align 4
  %x2 = load i32, ptr %x1, align 4
  ret i32 %x2
}

define i64 @id_i64(i64 %x) {
entry:
  %x1 = alloca i64, align 8
  store i64 %x, ptr %x1, align 4
  %x2 = load i64, ptr %x1, align 4
  ret i64 %x2
}

define i32 @apply_i32(ptr %f, i32 %v) {
entry:
  %v2 = alloca i32, align 4
  %f1 = alloca ptr, align 8
  store ptr %f, ptr %f1, align 8
  store i32 %v, ptr %v2, align 4
  %f.heap = load ptr, ptr %f1, align 8
  %f.fnptr.addr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %f.heap, i32 0, i32 0
  %f.envptr.addr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %f.heap, i32 0, i32 1
  %f.fnptr = load ptr, ptr %f.fnptr.addr, align 8
  %f.envptr = load ptr, ptr %f.envptr.addr, align 8
  %v3 = load i32, ptr %v2, align 4
  %f.fat.call = tail call i32 %f.fnptr(ptr %f.envptr, i32 %v3)
  ret i32 %f.fat.call
}

define i64 @apply_i64(ptr %f, i64 %v) {
entry:
  %v2 = alloca i64, align 8
  %f1 = alloca ptr, align 8
  store ptr %f, ptr %f1, align 8
  store i64 %v, ptr %v2, align 4
  %f.heap = load ptr, ptr %f1, align 8
  %f.fnptr.addr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %f.heap, i32 0, i32 0
  %f.envptr.addr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %f.heap, i32 0, i32 1
  %f.fnptr = load ptr, ptr %f.fnptr.addr, align 8
  %f.envptr = load ptr, ptr %f.envptr.addr, align 8
  %v3 = load i64, ptr %v2, align 4
  %f.fat.call = tail call i64 %f.fnptr(ptr %f.envptr, i64 %v3)
  ret i64 %f.fat.call
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result = alloca i8, align 1
  %r2 = alloca i64, align 8
  %r1 = alloca i32, align 4
  %f2 = alloca ptr, align 8
  %f1 = alloca ptr, align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %fn.fat.alloc = call ptr @malloc(i64 16)
  %fn.fat.fnptr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %fn.fat.alloc, i32 0, i32 0
  store ptr @__fn_fatptr_trampoline_id_i32, ptr %fn.fat.fnptr, align 8
  %fn.fat.envptr = getelementptr inbounds nuw %__closure_fat_ptr, ptr %fn.fat.alloc, i32 0, i32 1
  store ptr null, ptr %fn.fat.envptr, align 8
  store ptr %fn.fat.alloc, ptr %f1, align 8
  %fn.fat.alloc1 = call ptr @malloc(i64 16)
  %fn.fat.fnptr2 = getelementptr inbounds nuw %__closure_fat_ptr, ptr %fn.fat.alloc1, i32 0, i32 0
  store ptr @__fn_fatptr_trampoline_id_i64, ptr %fn.fat.fnptr2, align 8
  %fn.fat.envptr3 = getelementptr inbounds nuw %__closure_fat_ptr, ptr %fn.fat.alloc1, i32 0, i32 1
  store ptr null, ptr %fn.fat.envptr3, align 8
  store ptr %fn.fat.alloc1, ptr %f2, align 8
  %f14 = load ptr, ptr %f1, align 8
  %call = call i32 @apply_i32(ptr %f14, i32 7)
  store i32 %call, ptr %r1, align 4
  %f25 = load ptr, ptr %f2, align 8
  %call6 = call i64 @apply_i64(ptr %f25, i64 700)
  store i64 %call6, ptr %r2, align 4
  %r17 = load i32, ptr %r1, align 4
  %r28 = load i64, ptr %r2, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i32 %r17, i64 %r28)
  %0 = call i32 @fflush(ptr null)
  %r19 = load i32, ptr %r1, align 4
  %eq = icmp eq i32 %r19, 7
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %r210 = load i64, ptr %r2, align 4
  %eq11 = icmp eq i64 %r210, 700
  %cmp.bool12 = zext i1 %eq11 to i8
  %sc.r = icmp ne i8 %cmp.bool12, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %ifcond = icmp ne i8 %sc.val, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done
  ret i32 0

ifmerge:                                          ; preds = %sc.done
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

define internal i32 @__fn_fatptr_trampoline_id_i32(ptr %0, i32 %1) {
entry:
  %2 = call i32 @id_i32(i32 %1)
  ret i32 %2
}

define internal i64 @__fn_fatptr_trampoline_id_i64(ptr %0, i64 %1) {
entry:
  %2 = call i64 @id_i64(i64 %1)
  ret i64 %2
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
