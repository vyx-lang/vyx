define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result13 = alloca i8, align 1
  %sc.result = alloca i8, align 1
  %l = alloca i32, align 4
  %s = alloca i32, align 4
  %h = alloca i32, align 4
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %call = call i64 @"head<i64,i64,i64>"(i64 11, i64 22, i64 33)
  %trunc = trunc i64 %call to i32
  store i32 %trunc, ptr %h, align 4
  %call1 = call i64 @"second<i64,i64,i64>"(i64 11, i64 22, i64 33)
  %trunc2 = trunc i64 %call1 to i32
  store i32 %trunc2, ptr %s, align 4
  %call3 = call i64 @"first_via_local<i64,i64,i64>"(i64 11, i64 22, i64 33)
  %trunc4 = trunc i64 %call3 to i32
  store i32 %trunc4, ptr %l, align 4
  %h5 = load i32, ptr %h, align 4
  %s6 = load i32, ptr %s, align 4
  %l7 = load i32, ptr %l, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i32 %h5, i32 %s6, i32 %l7)
  %0 = call i32 @fflush(ptr null)
  %h8 = load i32, ptr %h, align 4
  %eq = icmp eq i32 %h8, 11
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %s9 = load i32, ptr %s, align 4
  %eq10 = icmp eq i32 %s9, 22
  %cmp.bool11 = zext i1 %eq10 to i8
  %sc.r = icmp ne i8 %cmp.bool11, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %sc.l12 = icmp ne i8 %sc.val, 0
  store i8 0, ptr %sc.result13, align 1
  br i1 %sc.l12, label %and.rhs14, label %sc.done15

and.rhs14:                                        ; preds = %sc.done
  %l16 = load i32, ptr %l, align 4
  %eq17 = icmp eq i32 %l16, 11
  %cmp.bool18 = zext i1 %eq17 to i8
  %sc.r19 = icmp ne i8 %cmp.bool18, 0
  %2 = zext i1 %sc.r19 to i8
  store i8 %2, ptr %sc.result13, align 1
  br label %sc.done15

sc.done15:                                        ; preds = %and.rhs14, %sc.done
  %sc.val20 = load i8, ptr %sc.result13, align 1
  %ifcond = icmp ne i8 %sc.val20, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done15
  ret i32 0

ifmerge:                                          ; preds = %sc.done15
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
