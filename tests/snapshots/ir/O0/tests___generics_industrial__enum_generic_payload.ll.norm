
%"Either<i32,string>" = type { i32, [32 x i8] }
%__String = type { ptr, i64, i64, i64 }

@_vyx_argc = internal global i32 0
@_vyx_argv = internal global ptr null
@.str = private unnamed_addr constant [6 x i8] c"hello\00", align 1
@.str.1 = private unnamed_addr constant [34 x i8] c"enum_generic_payload av=%d bv=%d\0A\00", align 1

declare ptr @malloc(i64)

declare void @free(ptr)

declare ptr @memset(ptr, i32, i64)

declare ptr @memcpy(ptr, ptr, i64)

declare i32 @memcmp(ptr, ptr, i64)

declare i64 @strlen(ptr)

declare i32 @strcmp(ptr, ptr)

; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i32 @"pick_left<i32,string>"(%"Either<i32,string>" %e, i32 %fallback) {
entry:
  %_ = alloca %__String, align 8
  %v = alloca i32, align 4
  %match.adt = alloca %"Either<i32,string>", align 8
  %fallback2 = alloca i32, align 4
  %e1 = alloca %"Either<i32,string>", align 8
  store %"Either<i32,string>" %e, ptr %e1, align 4
  store i32 %fallback, ptr %fallback2, align 4
  %e3 = load %"Either<i32,string>", ptr %e1, align 4
  store %"Either<i32,string>" %e3, ptr %match.adt, align 4
  %adt.tag.ptr = getelementptr inbounds nuw %"Either<i32,string>", ptr %match.adt, i32 0, i32 0
  %adt.tag = load i32, ptr %adt.tag.ptr, align 4
  %adt.data.ptr = getelementptr inbounds nuw %"Either<i32,string>", ptr %match.adt, i32 0, i32 1
  switch i32 %adt.tag, label %match.end [
    i32 0, label %match.adt.Left
    i32 1, label %match.adt.Right
  ]

match.end:                                        ; preds = %entry
  ret i32 0

match.adt.Left:                                   ; preds = %entry
  %adt.bind.ptr = getelementptr i8, ptr %adt.data.ptr, i64 0
  %adt.field = load i32, ptr %adt.bind.ptr, align 4
  store i32 %adt.field, ptr %v, align 4
  %v4 = load i32, ptr %v, align 4
  ret i32 %v4

match.adt.Right:                                  ; preds = %entry
  %adt.bind.ptr5 = getelementptr i8, ptr %adt.data.ptr, i64 0
  %adt.field6 = load %__String, ptr %adt.bind.ptr5, align 8
  store %__String %adt.field6, ptr %_, align 8
  %fallback7 = load i32, ptr %fallback2, align 4
  ret i32 %fallback7
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result = alloca i8, align 1
  %bv = alloca i32, align 4
  %av = alloca i32, align 4
  %b = alloca %"Either<i32,string>", align 8
  %str.tmp = alloca %__String, align 8
  %adt.tmp1 = alloca %"Either<i32,string>", align 8
  %a = alloca %"Either<i32,string>", align 8
  %adt.tmp = alloca %"Either<i32,string>", align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %adt.tag = getelementptr inbounds nuw %"Either<i32,string>", ptr %adt.tmp, i32 0, i32 0
  store i32 0, ptr %adt.tag, align 4
  %adt.data = getelementptr inbounds nuw %"Either<i32,string>", ptr %adt.tmp, i32 0, i32 1
  %adt.field = getelementptr i8, ptr %adt.data, i64 0
  store i32 42, ptr %adt.field, align 4
  %adt.val = load %"Either<i32,string>", ptr %adt.tmp, align 4
  store %"Either<i32,string>" %adt.val, ptr %a, align 4
  %adt.tag2 = getelementptr inbounds nuw %"Either<i32,string>", ptr %adt.tmp1, i32 0, i32 0
  store i32 1, ptr %adt.tag2, align 4
  %adt.data3 = getelementptr inbounds nuw %"Either<i32,string>", ptr %adt.tmp1, i32 0, i32 1
  %0 = call ptr @memset(ptr %str.tmp, i32 0, i64 32)
  %str.ptr = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 0
  store ptr @.str, ptr %str.ptr, align 8
  %str.len = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 1
  store i64 5, ptr %str.len, align 4
  %str.cap = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 2
  store i64 0, ptr %str.cap, align 4
  %str.owned = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 3
  store i64 0, ptr %str.owned, align 4
  %str.val = load %__String, ptr %str.tmp, align 8
  %adt.field4 = getelementptr i8, ptr %adt.data3, i64 0
  store %__String %str.val, ptr %adt.field4, align 8
  %adt.val5 = load %"Either<i32,string>", ptr %adt.tmp1, align 4
  store %"Either<i32,string>" %adt.val5, ptr %b, align 4
  %a6 = load %"Either<i32,string>", ptr %a, align 4
  %call = call i32 @"pick_left<i32,string>"(%"Either<i32,string>" %a6, i32 -1)
  store i32 %call, ptr %av, align 4
  %b7 = load %"Either<i32,string>", ptr %b, align 4
  %call8 = call i32 @"pick_left<i32,string>"(%"Either<i32,string>" %b7, i32 -1)
  store i32 %call8, ptr %bv, align 4
  %av9 = load i32, ptr %av, align 4
  %bv10 = load i32, ptr %bv, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %av9, i32 %bv10)
  %1 = call i32 @fflush(ptr null)
  %av11 = load i32, ptr %av, align 4
  %eq = icmp eq i32 %av11, 42
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %bv12 = load i32, ptr %bv, align 4
  %eq13 = icmp eq i32 %bv12, -1
  %cmp.bool14 = zext i1 %eq13 to i8
  %sc.r = icmp ne i8 %cmp.bool14, 0
  %2 = zext i1 %sc.r to i8
  store i8 %2, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %ifcond = icmp ne i8 %sc.val, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done
  ret i32 0

ifmerge:                                          ; preds = %sc.done
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
