@.str.1 = private unnamed_addr constant [32 x i8] c"variadic_print s_i=%lld s_f=%f\0A\00", align 1
@.str.2 = private unnamed_addr constant [48 x i8] c"variadic_print[%.*s] count=%d first=%d last=%d\0A\00", align 1

