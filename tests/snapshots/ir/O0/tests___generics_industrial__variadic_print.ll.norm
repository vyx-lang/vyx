; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i64 @"sum_all<i64>"(i64 %args_0, i64 %args_1, i64 %args_2, i64 %args_3, i64 %args_4) {
entry:
  %i = alloca i64, align 8
  %s = alloca i64, align 8
  %__pack_args = alloca [5 x i64], align 8
  %arr.tmp = alloca [5 x i64], align 8
  %args_45 = alloca i64, align 8
  %args_34 = alloca i64, align 8
  %args_23 = alloca i64, align 8
  %args_12 = alloca i64, align 8
  %args_01 = alloca i64, align 8
  store i64 %args_0, ptr %args_01, align 4
  store i64 %args_1, ptr %args_12, align 4
  store i64 %args_2, ptr %args_23, align 4
  store i64 %args_3, ptr %args_34, align 4
  store i64 %args_4, ptr %args_45, align 4
  %args_06 = load i64, ptr %args_01, align 4
  %arr.elem = getelementptr [5 x i64], ptr %arr.tmp, i32 0, i32 0
  store i64 %args_06, ptr %arr.elem, align 4
  %args_17 = load i64, ptr %args_12, align 4
  %arr.elem8 = getelementptr [5 x i64], ptr %arr.tmp, i32 0, i32 1
  store i64 %args_17, ptr %arr.elem8, align 4
  %args_29 = load i64, ptr %args_23, align 4
  %arr.elem10 = getelementptr [5 x i64], ptr %arr.tmp, i32 0, i32 2
  store i64 %args_29, ptr %arr.elem10, align 4
  %args_311 = load i64, ptr %args_34, align 4
  %arr.elem12 = getelementptr [5 x i64], ptr %arr.tmp, i32 0, i32 3
  store i64 %args_311, ptr %arr.elem12, align 4
  %args_413 = load i64, ptr %args_45, align 4
  %arr.elem14 = getelementptr [5 x i64], ptr %arr.tmp, i32 0, i32 4
  store i64 %args_413, ptr %arr.elem14, align 4
  %arr.val = load [5 x i64], ptr %arr.tmp, align 4
  store [5 x i64] %arr.val, ptr %__pack_args, align 4
  %args_015 = load i64, ptr %args_01, align 4
  store i64 %args_015, ptr %s, align 4
  store i64 1, ptr %i, align 4
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %i16 = load i64, ptr %i, align 4
  %lt = icmp slt i64 %i16, 5
  %cmp.bool = zext i1 %lt to i8
  %whilecond = icmp ne i8 %cmp.bool, 0
  br i1 %whilecond, label %while.body, label %while.exit

while.body:                                       ; preds = %while.cond
  %s17 = load i64, ptr %s, align 4
  %i18 = load i64, ptr %i, align 4
  %arr.idx = getelementptr [5 x i64], ptr %__pack_args, i32 0, i64 %i18
  %arr.elem.val = load i64, ptr %arr.idx, align 4
  %add = add i64 %s17, %arr.elem.val
  store i64 %add, ptr %s, align 4
  %i19 = load i64, ptr %i, align 4
  %add20 = add i64 %i19, 1
  store i64 %add20, ptr %i, align 4
  br label %while.cond

while.exit:                                       ; preds = %while.cond
  %s21 = load i64, ptr %s, align 4
  ret i64 %s21
}

define double @"sum_all<f64>"(double %args_0, double %args_1, double %args_2) {
entry:
  %i = alloca i64, align 8
  %s = alloca double, align 8
  %__pack_args = alloca [3 x double], align 8
  %arr.tmp = alloca [3 x double], align 8
  %args_23 = alloca double, align 8
  %args_12 = alloca double, align 8
  %args_01 = alloca double, align 8
  store double %args_0, ptr %args_01, align 8
  store double %args_1, ptr %args_12, align 8
  store double %args_2, ptr %args_23, align 8
  %args_04 = load double, ptr %args_01, align 8
  %arr.elem = getelementptr [3 x double], ptr %arr.tmp, i32 0, i32 0
  store double %args_04, ptr %arr.elem, align 8
  %args_15 = load double, ptr %args_12, align 8
  %arr.elem6 = getelementptr [3 x double], ptr %arr.tmp, i32 0, i32 1
  store double %args_15, ptr %arr.elem6, align 8
  %args_27 = load double, ptr %args_23, align 8
  %arr.elem8 = getelementptr [3 x double], ptr %arr.tmp, i32 0, i32 2
  store double %args_27, ptr %arr.elem8, align 8
  %arr.val = load [3 x double], ptr %arr.tmp, align 8
  store [3 x double] %arr.val, ptr %__pack_args, align 8
  %args_09 = load double, ptr %args_01, align 8
  store double %args_09, ptr %s, align 8
  store i64 1, ptr %i, align 4
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %i10 = load i64, ptr %i, align 4
  %lt = icmp slt i64 %i10, 3
  %cmp.bool = zext i1 %lt to i8
  %whilecond = icmp ne i8 %cmp.bool, 0
  br i1 %whilecond, label %while.body, label %while.exit

while.body:                                       ; preds = %while.cond
  %s11 = load double, ptr %s, align 8
  %i12 = load i64, ptr %i, align 4
  %arr.idx = getelementptr [3 x double], ptr %__pack_args, i32 0, i64 %i12
  %arr.elem.val = load double, ptr %arr.idx, align 8
  %fadd = fadd double %s11, %arr.elem.val
  store double %fadd, ptr %s, align 8
  %i13 = load i64, ptr %i, align 4
  %add = add i64 %i13, 1
  store i64 %add, ptr %i, align 4
  br label %while.cond

while.exit:                                       ; preds = %while.cond
  %s14 = load double, ptr %s, align 8
  ret double %s14
}

define void @"print_many<i32>"(%__String %label, i32 %args_0, i32 %args_1, i32 %args_2, i32 %args_3) {
entry:
  %pi.str = alloca %__String, align 8
  %__pack_args = alloca [4 x i32], align 4
  %arr.tmp = alloca [4 x i32], align 4
  %args_35 = alloca i32, align 4
  %args_24 = alloca i32, align 4
  %args_13 = alloca i32, align 4
  %args_02 = alloca i32, align 4
  %label1 = alloca %__String, align 8
  store %__String %label, ptr %label1, align 8
  store i32 %args_0, ptr %args_02, align 4
  store i32 %args_1, ptr %args_13, align 4
  store i32 %args_2, ptr %args_24, align 4
  store i32 %args_3, ptr %args_35, align 4
  %args_06 = load i32, ptr %args_02, align 4
  %arr.elem = getelementptr [4 x i32], ptr %arr.tmp, i32 0, i32 0
  store i32 %args_06, ptr %arr.elem, align 4
  %args_17 = load i32, ptr %args_13, align 4
  %arr.elem8 = getelementptr [4 x i32], ptr %arr.tmp, i32 0, i32 1
  store i32 %args_17, ptr %arr.elem8, align 4
  %args_29 = load i32, ptr %args_24, align 4
  %arr.elem10 = getelementptr [4 x i32], ptr %arr.tmp, i32 0, i32 2
  store i32 %args_29, ptr %arr.elem10, align 4
  %args_311 = load i32, ptr %args_35, align 4
  %arr.elem12 = getelementptr [4 x i32], ptr %arr.tmp, i32 0, i32 3
  store i32 %args_311, ptr %arr.elem12, align 4
  %arr.val = load [4 x i32], ptr %arr.tmp, align 4
  store [4 x i32] %arr.val, ptr %__pack_args, align 4
  %label13 = load %__String, ptr %label1, align 8
  store %__String %label13, ptr %pi.str, align 8
  %0 = getelementptr inbounds nuw %__String, ptr %pi.str, i32 0, i32 1
  %1 = load i64, ptr %0, align 4
  %2 = trunc i64 %1 to i32
  %3 = getelementptr inbounds nuw %__String, ptr %pi.str, i32 0, i32 0
  %4 = load ptr, ptr %3, align 8
  %args_014 = load i32, ptr %args_02, align 4
  %arr.idx = getelementptr [4 x i32], ptr %__pack_args, i32 0, i32 3
  %arr.elem.val = load i32, ptr %arr.idx, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str.2, i32 %2, ptr %4, i32 4, i32 %args_014, i32 %arr.elem.val)
  %5 = call i32 @fflush(ptr null)
  ret void
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %str.tmp = alloca %__String, align 8
  %s_f = alloca double, align 8
  %s_i = alloca i64, align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %call = call i64 @"sum_all<i64>"(i64 1, i64 2, i64 3, i64 4, i64 5)
  store i64 %call, ptr %s_i, align 4
  %call1 = call double @"sum_all<f64>"(double 1.500000e+00, double 2.500000e+00, double 3.000000e+00)
  store double %call1, ptr %s_f, align 8
  %0 = call ptr @memset(ptr %str.tmp, i32 0, i64 32)
  %str.ptr = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 0
  store ptr @.str, ptr %str.ptr, align 8
  %str.len = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 1
  store i64 4, ptr %str.len, align 4
  %str.cap = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 2
  store i64 0, ptr %str.cap, align 4
  %str.owned = getelementptr inbounds nuw %__String, ptr %str.tmp, i32 0, i32 3
  store i64 0, ptr %str.owned, align 4
  %str.val = load %__String, ptr %str.tmp, align 8
  call void @"print_many<i32>"(%__String %str.val, i32 10, i32 20, i32 30, i32 40)
  %s_i2 = load i64, ptr %s_i, align 4
  %s_f3 = load double, ptr %s_f, align 8
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %s_i2, double %s_f3)
  %1 = call i32 @fflush(ptr null)
  %s_i4 = load i64, ptr %s_i, align 4
  %eq = icmp eq i64 %s_i4, 15
  %cmp.bool = zext i1 %eq to i8
  %ifcond = icmp ne i8 %cmp.bool, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %entry
  ret i32 0

ifmerge:                                          ; preds = %entry
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
