define i32 @"sum_arr<i32,?>#6"([6 x i32] %a, i32 %zero) {
entry:
  %i = alloca i64, align 8
  %s = alloca i32, align 4
  %zero2 = alloca i32, align 4
  %a1 = alloca [6 x i32], align 4
  store [6 x i32] %a, ptr %a1, align 4
  store i32 %zero, ptr %zero2, align 4
  %zero3 = load i32, ptr %zero2, align 4
  store i32 %zero3, ptr %s, align 4
  store i64 0, ptr %i, align 4
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %i4 = load i64, ptr %i, align 4
  %lt = icmp slt i64 %i4, 6
  %cmp.bool = zext i1 %lt to i8
  %whilecond = icmp ne i8 %cmp.bool, 0
  br i1 %whilecond, label %while.body, label %while.exit

while.body:                                       ; preds = %while.cond
  %s5 = load i32, ptr %s, align 4
  %i6 = load i64, ptr %i, align 4
  %arr.idx = getelementptr [6 x i32], ptr %a1, i32 0, i64 %i6
  %arr.elem.val = load i32, ptr %arr.idx, align 4
  %add = add i32 %s5, %arr.elem.val
  store i32 %add, ptr %s, align 4
  %i7 = load i64, ptr %i, align 4
  %add8 = add i64 %i7, 1
  store i64 %add8, ptr %i, align 4
  br label %while.cond

while.exit:                                       ; preds = %while.cond
  %s9 = load i32, ptr %s, align 4
  ret i32 %s9
}

define i64 @"sum_arr<i64,?>#4"([4 x i64] %a, i64 %zero) {
entry:
  %i = alloca i64, align 8
  %s = alloca i64, align 8
  %zero2 = alloca i64, align 8
  %a1 = alloca [4 x i64], align 8
