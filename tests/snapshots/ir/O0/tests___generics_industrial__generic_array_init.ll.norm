define [6 x i32] @"fill_with<i32,?>#6"(i32 %v) {
entry:
  %a = alloca [6 x i32], align 4
  %arr.tmp = alloca [6 x i32], align 4
  %v1 = alloca i32, align 4
  store i32 %v, ptr %v1, align 4
  %v2 = load i32, ptr %v1, align 4
  %arr.elem = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 0
  store i32 %v2, ptr %arr.elem, align 4
  %arr.elem3 = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 1
  store i32 %v2, ptr %arr.elem3, align 4
  %arr.elem4 = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 2
  store i32 %v2, ptr %arr.elem4, align 4
  %arr.elem5 = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 3
  store i32 %v2, ptr %arr.elem5, align 4
  %arr.elem6 = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 4
  store i32 %v2, ptr %arr.elem6, align 4
  %arr.elem7 = getelementptr [6 x i32], ptr %arr.tmp, i32 0, i32 5
  store i32 %v2, ptr %arr.elem7, align 4
  %arr.val = load [6 x i32], ptr %arr.tmp, align 4
  store [6 x i32] %arr.val, ptr %a, align 4
  %a8 = load [6 x i32], ptr %a, align 4
  ret [6 x i32] %a8
}

