
%__String = type { ptr, i64, i64, i64 }

@_vyx_argc = internal global i32 0
@_vyx_argv = internal global ptr null
@.str = private unnamed_addr constant [61 x i8] c"sizeof_dispatch i8=%lld i32=%lld i64=%lld str=%lld big=%lld\0A\00", align 1

declare ptr @malloc(i64)

declare void @free(ptr)

declare ptr @memset(ptr, i32, i64)

declare ptr @memcpy(ptr, ptr, i64)

declare i32 @memcmp(ptr, ptr, i64)

declare i64 @strlen(ptr)

declare i32 @strcmp(ptr, ptr)

; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i64 @"pack_size<i8>"() {
entry:
  ret i64 1
}

define i64 @"pack_size<i32>"() {
entry:
  ret i64 4
}

define i64 @"pack_size<i64>"() {
entry:
  ret i64 8
}

define i64 @"pack_size<string>"() {
entry:
  ret i64 32
}

define i64 @"pack_size<Big>"() {
entry:
  ret i64 24
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result32 = alloca i8, align 1
  %sc.result24 = alloca i8, align 1
  %sc.result15 = alloca i8, align 1
  %sc.result = alloca i8, align 1
  %s_big = alloca i64, align 8
  %s_str = alloca i64, align 8
  %s_i64 = alloca i64, align 8
  %s_i32 = alloca i64, align 8
  %s_i8 = alloca i64, align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %call = call i64 @"pack_size<i8>"()
  store i64 %call, ptr %s_i8, align 4
  %call1 = call i64 @"pack_size<i32>"()
  store i64 %call1, ptr %s_i32, align 4
  %call2 = call i64 @"pack_size<i64>"()
  store i64 %call2, ptr %s_i64, align 4
  %call3 = call i64 @"pack_size<string>"()
  store i64 %call3, ptr %s_str, align 4
  %call4 = call i64 @"pack_size<Big>"()
  store i64 %call4, ptr %s_big, align 4
  %s_i85 = load i64, ptr %s_i8, align 4
  %s_i326 = load i64, ptr %s_i32, align 4
  %s_i647 = load i64, ptr %s_i64, align 4
  %s_str8 = load i64, ptr %s_str, align 4
  %s_big9 = load i64, ptr %s_big, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i64 %s_i85, i64 %s_i326, i64 %s_i647, i64 %s_str8, i64 %s_big9)
  %0 = call i32 @fflush(ptr null)
  %s_i810 = load i64, ptr %s_i8, align 4
  %eq = icmp eq i64 %s_i810, 1
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %s_i3211 = load i64, ptr %s_i32, align 4
  %eq12 = icmp eq i64 %s_i3211, 4
  %cmp.bool13 = zext i1 %eq12 to i8
  %sc.r = icmp ne i8 %cmp.bool13, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %sc.l14 = icmp ne i8 %sc.val, 0
  store i8 0, ptr %sc.result15, align 1
  br i1 %sc.l14, label %and.rhs16, label %sc.done17

and.rhs16:                                        ; preds = %sc.done
  %s_i6418 = load i64, ptr %s_i64, align 4
  %eq19 = icmp eq i64 %s_i6418, 8
  %cmp.bool20 = zext i1 %eq19 to i8
  %sc.r21 = icmp ne i8 %cmp.bool20, 0
  %2 = zext i1 %sc.r21 to i8
  store i8 %2, ptr %sc.result15, align 1
  br label %sc.done17

sc.done17:                                        ; preds = %and.rhs16, %sc.done
  %sc.val22 = load i8, ptr %sc.result15, align 1
  %sc.l23 = icmp ne i8 %sc.val22, 0
  store i8 0, ptr %sc.result24, align 1
  br i1 %sc.l23, label %and.rhs25, label %sc.done26

and.rhs25:                                        ; preds = %sc.done17
  %s_str27 = load i64, ptr %s_str, align 4
  %ge = icmp sge i64 %s_str27, 16
  %cmp.bool28 = zext i1 %ge to i8
  %sc.r29 = icmp ne i8 %cmp.bool28, 0
  %3 = zext i1 %sc.r29 to i8
  store i8 %3, ptr %sc.result24, align 1
  br label %sc.done26

sc.done26:                                        ; preds = %and.rhs25, %sc.done17
  %sc.val30 = load i8, ptr %sc.result24, align 1
  %sc.l31 = icmp ne i8 %sc.val30, 0
  store i8 0, ptr %sc.result32, align 1
  br i1 %sc.l31, label %and.rhs33, label %sc.done34

and.rhs33:                                        ; preds = %sc.done26
  %s_big35 = load i64, ptr %s_big, align 4
  %ge36 = icmp sge i64 %s_big35, 24
  %cmp.bool37 = zext i1 %ge36 to i8
  %sc.r38 = icmp ne i8 %cmp.bool37, 0
  %4 = zext i1 %sc.r38 to i8
  store i8 %4, ptr %sc.result32, align 1
  br label %sc.done34

sc.done34:                                        ; preds = %and.rhs33, %sc.done26
  %sc.val39 = load i8, ptr %sc.result32, align 1
  %ifcond = icmp ne i8 %sc.val39, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done34
  ret i32 0

ifmerge:                                          ; preds = %sc.done34
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
