
%__String = type { ptr, i64, i64, i64 }

@_vyx_argc = internal global i32 0
@_vyx_argv = internal global ptr null
@.str = private unnamed_addr constant [33 x i8] c"generic_concept_check i=%d f=%f\0A\00", align 1

declare ptr @malloc(i64)

declare void @free(ptr)

declare ptr @memset(ptr, i32, i64)

declare ptr @memcpy(ptr, ptr, i64)

declare i32 @memcmp(ptr, ptr, i64)

declare i64 @strlen(ptr)

declare i32 @strcmp(ptr, ptr)

; Function Attrs: noreturn
declare void @exit(i32) #0

declare i32 @printf(ptr, ...)

declare i32 @snprintf(ptr, i64, ptr, ...)

define i32 @"pair_sum<i32>"(i32 %a, i32 %b) {
entry:
  %b2 = alloca i32, align 4
  %a1 = alloca i32, align 4
  store i32 %a, ptr %a1, align 4
  store i32 %b, ptr %b2, align 4
  %a3 = load i32, ptr %a1, align 4
  %b4 = load i32, ptr %b2, align 4
  %add = add i32 %a3, %b4
  ret i32 %add
}

define i32 @"triple_sum<i32>"(i32 %a, i32 %b, i32 %c) {
entry:
  %c3 = alloca i32, align 4
  %b2 = alloca i32, align 4
  %a1 = alloca i32, align 4
  store i32 %a, ptr %a1, align 4
  store i32 %b, ptr %b2, align 4
  store i32 %c, ptr %c3, align 4
  %a4 = load i32, ptr %a1, align 4
  %b5 = load i32, ptr %b2, align 4
  %call = call i32 @"pair_sum<i32>"(i32 %a4, i32 %b5)
  %c6 = load i32, ptr %c3, align 4
  %call7 = tail call i32 @"pair_sum<i32>"(i32 %call, i32 %c6)
  ret i32 %call7
}

define double @"pair_sum<f64>"(double %a, double %b) {
entry:
  %b2 = alloca double, align 8
  %a1 = alloca double, align 8
  store double %a, ptr %a1, align 8
  store double %b, ptr %b2, align 8
  %a3 = load double, ptr %a1, align 8
  %b4 = load double, ptr %b2, align 8
  %fadd = fadd double %a3, %b4
  ret double %fadd
}

define double @"triple_sum<f64>"(double %a, double %b, double %c) {
entry:
  %c3 = alloca double, align 8
  %b2 = alloca double, align 8
  %a1 = alloca double, align 8
  store double %a, ptr %a1, align 8
  store double %b, ptr %b2, align 8
  store double %c, ptr %c3, align 8
  %a4 = load double, ptr %a1, align 8
  %b5 = load double, ptr %b2, align 8
  %call = call double @"pair_sum<f64>"(double %a4, double %b5)
  %c6 = load double, ptr %c3, align 8
  %call7 = tail call double @"pair_sum<f64>"(double %call, double %c6)
  ret double %call7
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result8 = alloca i8, align 1
  %sc.result = alloca i8, align 1
  %f = alloca double, align 8
  %i = alloca i32, align 4
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %call = call i32 @"triple_sum<i32>"(i32 10, i32 20, i32 30)
  store i32 %call, ptr %i, align 4
  %call1 = call double @"triple_sum<f64>"(double 1.500000e+00, double 2.500000e+00, double 4.000000e+00)
  store double %call1, ptr %f, align 8
  %i2 = load i32, ptr %i, align 4
  %f3 = load double, ptr %f, align 8
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i32 %i2, double %f3)
  %0 = call i32 @fflush(ptr null)
  %i4 = load i32, ptr %i, align 4
  %eq = icmp eq i32 %i4, 60
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %f5 = load double, ptr %f, align 8
  %fgt = fcmp ogt double %f5, 7.900000e+00
  %cmp.bool6 = zext i1 %fgt to i8
  %sc.r = icmp ne i8 %cmp.bool6, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %sc.l7 = icmp ne i8 %sc.val, 0
  store i8 0, ptr %sc.result8, align 1
  br i1 %sc.l7, label %and.rhs9, label %sc.done10

and.rhs9:                                         ; preds = %sc.done
  %f11 = load double, ptr %f, align 8
  %flt = fcmp olt double %f11, 8.100000e+00
  %cmp.bool12 = zext i1 %flt to i8
  %sc.r13 = icmp ne i8 %cmp.bool12, 0
  %2 = zext i1 %sc.r13 to i8
  store i8 %2, ptr %sc.result8, align 1
  br label %sc.done10

sc.done10:                                        ; preds = %and.rhs9, %sc.done
  %sc.val14 = load i8, ptr %sc.result8, align 1
  %ifcond = icmp ne i8 %sc.val14, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done10
  ret i32 0

ifmerge:                                          ; preds = %sc.done10
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

attributes #0 = { noreturn }
