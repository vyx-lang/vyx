  %self.buf5 = getelementptr inbounds nuw %"Array<i32,8>", ptr %self.ptr4, i32 0, i32 0
  %i6 = load i64, ptr %i, align 4
  %arr.idx7 = getelementptr [8 x i32], ptr %self.buf5, i32 0, i64 %i6
  %arr.elem.val8 = load i32, ptr %arr.idx7, align 4
  %add = add i32 %s3, %arr.elem.val8
  store i32 %add, ptr %s, align 4
  %i9 = load i64, ptr %i, align 4
  %add10 = add i64 %i9, 1
  store i64 %add10, ptr %i, align 4
  br label %while.cond

while.exit:                                       ; preds = %while.cond
  %s11 = load i32, ptr %s, align 4
  ret i32 %s11
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result = alloca i8, align 1
  %s = alloca i32, align 4
  %a = alloca %"Array<i32,8>", align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %static.call = call %"Array<i32,8>" @"Array<i32,8>.zeroed"()
  store %"Array<i32,8>" %static.call, ptr %a, align 4
  call void @"Array<i32,8>.fill"(ptr %a, i32 7)
  %method.result = call i32 @"Array<i32,8>.sum"(ptr %a)
  store i32 %method.result, ptr %s, align 4
  %vec.len.ptr = getelementptr inbounds nuw %"Array<i32,8>", ptr %a, i32 0, i32 1
  %vec.len = load i64, ptr %vec.len.ptr, align 4
  %s1 = load i32, ptr %s, align 4
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i64 %vec.len, i32 %s1)
  %0 = call i32 @fflush(ptr null)
  %s2 = load i32, ptr %s, align 4
  %eq = icmp eq i32 %s2, 56
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %vec.len.ptr3 = getelementptr inbounds nuw %"Array<i32,8>", ptr %a, i32 0, i32 1
  %vec.len4 = load i64, ptr %vec.len.ptr3, align 4
  %eq5 = icmp eq i64 %vec.len4, 8
  %cmp.bool6 = zext i1 %eq5 to i8
  %sc.r = icmp ne i8 %cmp.bool6, 0
  %1 = zext i1 %sc.r to i8
  store i8 %1, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %ifcond = icmp ne i8 %sc.val, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done
  ret i32 0

ifmerge:                                          ; preds = %sc.done
