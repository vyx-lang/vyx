  %0 = call ptr @memset(ptr %struct.tmp, i32 0, i64 40)
  %arr.elem = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 0
  store i32 0, ptr %arr.elem, align 4
  %arr.elem1 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 1
  store i32 0, ptr %arr.elem1, align 4
  %arr.elem2 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 2
  store i32 0, ptr %arr.elem2, align 4
  %arr.elem3 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 3
  store i32 0, ptr %arr.elem3, align 4
  %arr.elem4 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 4
  store i32 0, ptr %arr.elem4, align 4
  %arr.elem5 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 5
  store i32 0, ptr %arr.elem5, align 4
  %arr.elem6 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 6
  store i32 0, ptr %arr.elem6, align 4
  %arr.elem7 = getelementptr [8 x i32], ptr %arr.tmp, i32 0, i32 7
  store i32 0, ptr %arr.elem7, align 4
  %arr.val = load [8 x i32], ptr %arr.tmp, align 4
  %buf = getelementptr inbounds nuw %"Array<i32,8>", ptr %struct.tmp, i32 0, i32 0
  store [8 x i32] %arr.val, ptr %buf, align 4
  %len = getelementptr inbounds nuw %"Array<i32,8>", ptr %struct.tmp, i32 0, i32 1
  store i64 8, ptr %len, align 4
  %struct.val = load %"Array<i32,8>", ptr %struct.tmp, align 4
  ret %"Array<i32,8>" %struct.val
}

define void @"Array<i32,8>.fill"(ptr %self, i32 %v) {
entry:
  %i = alloca i64, align 8
  %v2 = alloca i32, align 4
  %self1 = alloca ptr, align 8
  store ptr %self, ptr %self1, align 8
  store i32 %v, ptr %v2, align 4
  store i64 0, ptr %i, align 4
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %i3 = load i64, ptr %i, align 4
  %lt = icmp slt i64 %i3, 8
  %cmp.bool = zext i1 %lt to i8
  %whilecond = icmp ne i8 %cmp.bool, 0
  br i1 %whilecond, label %while.body, label %while.exit

while.body:                                       ; preds = %while.cond
  %v4 = load i32, ptr %v2, align 4
  %self.ptr = load ptr, ptr %self1, align 8
  %self.buf = getelementptr inbounds nuw %"Array<i32,8>", ptr %self.ptr, i32 0, i32 0
  %i5 = load i64, ptr %i, align 4
  %arr.idx.store = getelementptr [8 x i32], ptr %self.buf, i32 0, i64 %i5
  store volatile i32 %v4, ptr %arr.idx.store, align 4
  %i6 = load i64, ptr %i, align 4
  %add = add i64 %i6, 1
  store i64 %add, ptr %i, align 4
  br label %while.cond

while.exit:                                       ; preds = %while.cond
  ret void
}

define i32 @"Array<i32,8>.sum"(ptr %self) {
entry:
  %i = alloca i64, align 8
  %s = alloca i32, align 4
  %self1 = alloca ptr, align 8
  store ptr %self, ptr %self1, align 8
  %self.ptr = load ptr, ptr %self1, align 8
  %self.buf = getelementptr inbounds nuw %"Array<i32,8>", ptr %self.ptr, i32 0, i32 0
  %arr.idx = getelementptr [8 x i32], ptr %self.buf, i32 0, i32 0
  %arr.elem.val = load i32, ptr %arr.idx, align 4
  store i32 %arr.elem.val, ptr %s, align 4
