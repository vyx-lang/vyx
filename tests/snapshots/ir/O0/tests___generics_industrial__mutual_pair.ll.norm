  %first.val = load i32, ptr %first2, align 4
  %second3 = getelementptr inbounds nuw %"Pair<string,i32>", ptr %struct.tmp, i32 0, i32 1
  store i32 %first.val, ptr %second3, align 4
  %struct.val = load %"Pair<string,i32>", ptr %struct.tmp, align 8
  ret %"Pair<string,i32>" %struct.val
}

