declare i64 @Sized.ratio(ptr, i64)

define i64 @"Bag.ratio<Bag>"(ptr %self, %Bag %other) {
entry:
  %b = alloca i64, align 8
  %a = alloca i64, align 8
  %other2 = alloca %Bag, align 8
  %self1 = alloca ptr, align 8
  store ptr %self, ptr %self1, align 8
  store %Bag %other, ptr %other2, align 4
  %self.ptr = load ptr, ptr %self1, align 8
  %self.call = call i64 @Bag.size(ptr %self.ptr)
  store i64 %self.call, ptr %a, align 4
  %method.result = call i64 @Bag.size(ptr %other2)
  store i64 %method.result, ptr %b, align 4
  %b3 = load i64, ptr %b, align 4
  %eq = icmp eq i64 %b3, 0
  %cmp.bool = zext i1 %eq to i8
  %ifcond = icmp ne i8 %cmp.bool, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %entry
  ret i64 0

ifmerge:                                          ; preds = %entry
  %a4 = load i64, ptr %a, align 4
  %mul = mul i64 %a4, 100
  %b5 = load i64, ptr %b, align 4
  %div.zero = icmp eq i64 %b5, 0
  %div.neg1 = icmp eq i64 %b5, -1
  %div.min = icmp eq i64 %mul, -9223372036854775808
  %div.ov = and i1 %div.neg1, %div.min
  %div.trap = or i1 %div.zero, %div.ov
  br i1 %div.trap, label %div.panic, label %div.ok

div.panic:                                        ; preds = %ifmerge
  call void @__vyx_panic(ptr @.str.1)
  unreachable

div.ok:                                           ; preds = %ifmerge
  %sdiv = sdiv i64 %mul, %b5
  ret i64 %sdiv
}

define %Bag @Bag.of(i64 %n) {
entry:
  %struct.tmp = alloca %Bag, align 8
  %n1 = alloca i64, align 8
  store i64 %n, ptr %n1, align 4
  %0 = call ptr @memset(ptr %struct.tmp, i32 0, i64 8)
  %n2 = load i64, ptr %n1, align 4
  %n3 = getelementptr inbounds nuw %Bag, ptr %struct.tmp, i32 0, i32 0
  store i64 %n2, ptr %n3, align 4
  %struct.val = load %Bag, ptr %struct.tmp, align 4
  ret %Bag %struct.val
}

define i64 @Bag.size(ptr %self) {
entry:
  %self1 = alloca ptr, align 8
  store ptr %self, ptr %self1, align 8
  %self.ptr = load ptr, ptr %self1, align 8
  %self.n = getelementptr inbounds nuw %Bag, ptr %self.ptr, i32 0, i32 0
  %n.val = load i64, ptr %self.n, align 4
  ret i64 %n.val
}

define i8 @Bag.is_empty(ptr %self) {
entry:
  %self1 = alloca ptr, align 8
  store ptr %self, ptr %self1, align 8
  %self.ptr = load ptr, ptr %self1, align 8
  %self.call = call i64 @Bag.size(ptr %self.ptr)
  %eq = icmp eq i64 %self.call, 0
  %cmp.bool = zext i1 %eq to i8
  ret i8 %cmp.bool
}

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %sc.result = alloca i8, align 1
  %e = alloca i8, align 1
  %chain.tmp = alloca %Bag, align 8
  %r = alloca i64, align 8
  %b2 = alloca %Bag, align 8
  %b1 = alloca %Bag, align 8
  call void @_vyx_set_args_internal(i32 %argc, ptr %argv)
  %static.call = call %Bag @Bag.of(i64 10)
  store %Bag %static.call, ptr %b1, align 4
  %static.call1 = call %Bag @Bag.of(i64 4)
  store %Bag %static.call1, ptr %b2, align 4
  %b22 = load %Bag, ptr %b2, align 4
  %method.result = call i64 @"Bag.ratio<Bag>"(ptr %b1, %Bag %b22)
  store i64 %method.result, ptr %r, align 4
  %static.call3 = call %Bag @Bag.of(i64 0)
  store %Bag %static.call3, ptr %chain.tmp, align 4
  %chain.call = call i8 @Bag.is_empty(ptr %chain.tmp)
  store i8 %chain.call, ptr %e, align 1
  %r4 = load i64, ptr %r, align 4
  %e5 = load i8, ptr %e, align 1
  %0 = sext i8 %e5 to i32
  %print.interp = call i32 (ptr, ...) @printf(ptr @.str, i64 %r4, i32 %0)
  %1 = call i32 @fflush(ptr null)
  %r6 = load i64, ptr %r, align 4
  %eq = icmp eq i64 %r6, 250
  %cmp.bool = zext i1 %eq to i8
  %sc.l = icmp ne i8 %cmp.bool, 0
  store i8 0, ptr %sc.result, align 1
  br i1 %sc.l, label %and.rhs, label %sc.done

and.rhs:                                          ; preds = %entry
  %e7 = load i8, ptr %e, align 1
  %sc.r = icmp ne i8 %e7, 0
  %2 = zext i1 %sc.r to i8
  store i8 %2, ptr %sc.result, align 1
  br label %sc.done

sc.done:                                          ; preds = %and.rhs, %entry
  %sc.val = load i8, ptr %sc.result, align 1
  %ifcond = icmp ne i8 %sc.val, 0
  br i1 %ifcond, label %then, label %ifmerge

then:                                             ; preds = %sc.done
  ret i32 0

ifmerge:                                          ; preds = %sc.done
  ret i32 1
}

define void @_vyx_set_args_internal(i32 %0, ptr %1) {
entry:
  store i32 %0, ptr @_vyx_argc, align 4
  store ptr %1, ptr @_vyx_argv, align 8
  ret void
}

define i32 @_vyx_get_argc_internal() {
entry:
  %argc = load i32, ptr @_vyx_argc, align 4
  ret i32 %argc
}

define %__String @_vyx_get_arg_internal(i32 %0) {
entry:
  %arg.str = alloca %__String, align 8
  %argv = load ptr, ptr @_vyx_argv, align 8
  %idx64 = sext i32 %0 to i64
  %arg.ptr = getelementptr ptr, ptr %argv, i64 %idx64
  %arg.cstr = load ptr, ptr %arg.ptr, align 8
  %arg.len = call i64 @strlen(ptr %arg.cstr)
  %1 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 0
  store ptr %arg.cstr, ptr %1, align 8
  %2 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 1
  store i64 %arg.len, ptr %2, align 4
  %3 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 2
  %4 = add i64 %arg.len, 1
  store i64 %4, ptr %3, align 4
  %5 = getelementptr inbounds nuw %__String, ptr %arg.str, i32 0, i32 3
  store i64 0, ptr %5, align 4
  %arg.result = load %__String, ptr %arg.str, align 8
  ret %__String %arg.result
}

declare i32 @fflush(ptr)

; Function Attrs: noreturn
define internal void @__vyx_panic(ptr %0) #0 {
entry:
  %1 = call i32 (ptr, ...) @printf(ptr %0)
  %2 = call i32 (ptr, ...) @printf(ptr @.str.2)
  %bt.buf = alloca ptr, i32 32, align 8
  %bt.n = call i16 @RtlCaptureStackBackTrace(i32 1, i32 32, ptr %bt.buf, ptr null)
  %bt.n32 = zext i16 %bt.n to i32
  %bt.idx = alloca i32, align 4
  store i32 0, ptr %bt.idx, align 4
  br label %bt.loop

bt.loop:                                          ; preds = %bt.body, %entry
  %bt.i = load i32, ptr %bt.idx, align 4
  %bt.cmp = icmp slt i32 %bt.i, %bt.n32
  br i1 %bt.cmp, label %bt.body, label %bt.end

bt.body:                                          ; preds = %bt.loop
  %bt.frame.ptr = getelementptr ptr, ptr %bt.buf, i32 %bt.i
  %bt.frame = load ptr, ptr %bt.frame.ptr, align 8
  %bt.addr = ptrtoint ptr %bt.frame to i64
  %3 = call i32 (ptr, ...) @printf(ptr @.str.3, i32 %bt.i, i64 %bt.addr)
  %4 = add i32 %bt.i, 1
  store i32 %4, ptr %bt.idx, align 4
  br label %bt.loop

bt.end:                                           ; preds = %bt.loop
  call void @exit(i32 1)
  unreachable
}

declare i16 @RtlCaptureStackBackTrace(i32, i32, ptr, ptr)

attributes #0 = { noreturn }
