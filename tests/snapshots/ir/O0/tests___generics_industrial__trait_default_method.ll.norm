
%Bag = type { i64 }
%__String = type { ptr, i64, i64, i64 }

@_vyx_argc = internal global i32 0
@_vyx_argv = internal global ptr null
@.str = private unnamed_addr constant [42 x i8] c"trait_default_method ratio=%lld empty=%d\0A\00", align 1
@.str.1 = private unnamed_addr constant [59 x i8] c"PANIC: integer division by zero or overflow (INT_MIN / -1)\00", align 1
@.str.2 = private unnamed_addr constant [15 x i8] c"\0A  backtrace:\0A\00", align 1
@.str.3 = private unnamed_addr constant [17 x i8] c"    [%d] 0x%llx\0A\00", align 1

declare ptr @malloc(i64)

declare void @free(ptr)

