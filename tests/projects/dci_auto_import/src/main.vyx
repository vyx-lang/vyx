use native.session;

fn main() -> i32 {
    var session = NativeSession();
    var i: i32 = 0;
    while (i < 1000) { session.add(1); i = i + 1; }
    if (session.read() != 2011) { return 1; }
    session.add(3, 4);
    if (session.read() != 2023) { return 2; }
    print("dci automatic import OK: native defaults, constructor, overload and destructor");
    return 0;
}
