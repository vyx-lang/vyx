module tests.std_meta_package;

use std.collections;
use std.serde.json;

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(7);
    values.push(9);
    if (values.len != 2 || values.get(1) != 9) { return 1; }

    match (Json.parse("{\"ok\":true}")) {
        case Ok(root) => {
            match (root.get_bool("ok")) {
                case Ok(ok) => { if (!ok) { return 2; } }
                case Err(_) => { return 3; }
            }
        }
        case Err(_) => { return 4; }
    }
    print("std umbrella package ok");
    return 0;
}
