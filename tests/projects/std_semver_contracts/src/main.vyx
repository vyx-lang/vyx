module tests.std_semver_contracts;
use std.core;
use std.collections;
use std.string;
use std.fs;
use std.semver;
use std.hash;
use tests.release_catalog;

fn roundtrip(text: string) {
    match (SemVer.try_parse(text)) {
        Ok(version) => {
            assert(version.toString() == text, "SemVer round trip");
            assert(version.try_validate().is_ok(), "parsed SemVer validates");
        }
        Err(failure) => { panic("valid version rejected: ", text, " at ", failure.offset); }
    }
}

fn rejected(text: string, kind: SemVerErrorKind, offset: i64) {
    match (SemVer.try_parse(text)) {
        Ok(_) => { panic("invalid version accepted: ", text); }
        Err(failure) => {
            assert(failure.kind == kind && failure.offset == offset, "located SemVer error");
            assert(failure.message.len > 0, "SemVer error message");
        }
    }
}

fn ordered(a: string, b: string) {
    let left = SemVer.parse(a);
    let right = SemVer.parse(b);
    assert(left.compareTo(right) == -1 && right.compareTo(left) == 1, "SemVer precedence");
    assert(left.lessThan(right) && right.greaterThan(left), "borrowed comparisons");
    assert(left.toString() == a && right.toString() == b, "comparison retains both values");
}

fn parsing() {
    roundtrip("0.0.0"); roundtrip("2147483647.2147483647.2147483647");
    roundtrip("1.2.3-alpha.1+001.sha-123"); roundtrip("1.2.3--.0a+--.000");
    roundtrip("1.2.3-9999999999999999999999999999999999999999999999999999999999");
    rejected("", SemVerErrorKind.InvalidCore, 0);
    rejected("v1.2.3", SemVerErrorKind.InvalidCore, 0);
    rejected("1.2", SemVerErrorKind.InvalidCore, 3);
    rejected("1x.2.3", SemVerErrorKind.InvalidCore, 1);
    rejected("1.2.3.4", SemVerErrorKind.InvalidCore, 5);
    rejected("01.2.3", SemVerErrorKind.LeadingZero, 0);
    rejected("1.02.3", SemVerErrorKind.LeadingZero, 2);
    rejected("1.2.03", SemVerErrorKind.LeadingZero, 4);
    rejected("2147483648.0.0", SemVerErrorKind.Overflow, 9);
    rejected("1.2.3-", SemVerErrorKind.InvalidIdentifier, 6);
    rejected("1.2.3+", SemVerErrorKind.InvalidIdentifier, 6);
    rejected("1.2.3-a..b", SemVerErrorKind.InvalidIdentifier, 8);
    rejected("1.2.3-a.", SemVerErrorKind.InvalidIdentifier, 8);
    rejected("1.2.3-01", SemVerErrorKind.LeadingZero, 6);
    rejected("1.2.3+a++b", SemVerErrorKind.InvalidIdentifier, 7);
    rejected("1.2.3-a_b", SemVerErrorKind.InvalidIdentifier, 7);
    rejected("1.2.3-a\0b", SemVerErrorKind.InvalidIdentifier, 7);
    rejected("1.2.3-中", SemVerErrorKind.InvalidIdentifier, 6);
    rejected(" 1.2.3", SemVerErrorKind.InvalidCore, 0);
    rejected("1.2.3 ", SemVerErrorKind.InvalidCore, 5);
    assert(parse_int("2147483647") == 2147483647, "checked legacy decimal helper");
}

fn precedence() {
    ordered("1.0.0-alpha", "1.0.0-alpha.1");
    ordered("1.0.0-alpha.1", "1.0.0-alpha.beta");
    ordered("1.0.0-alpha.beta", "1.0.0-beta");
    ordered("1.0.0-beta", "1.0.0-beta.2");
    ordered("1.0.0-beta.2", "1.0.0-beta.11");
    ordered("1.0.0-beta.11", "1.0.0-rc.1");
    ordered("1.0.0-rc.1", "1.0.0");
    ordered("1.0.0-9", "1.0.0-10"); ordered("1.0.0-999", "1.0.0-a");
    ordered("1.0.0-A", "1.0.0-a"); ordered("1.0.0-aa", "1.0.0-b");
    ordered("0.2147483647.0", "2147483647.0.0");
    ordered("1.0.0-99999999999999999999999999", "1.0.0-100000000000000000000000000");
    let left = SemVer.parse("1.2.3+linux");
    let right = SemVer.parse("1.2.3+windows");
    assert(left.equals(right) && left == right && left.hash() == right.hash(), "metadata ignored consistently");
    assert(left.toString() != right.toString(), "metadata retained for serialization");
}

fn escaped_version() -> SemVer {
    var builder = StringBuilder.create();
    builder.append("1.2.3-identifier-that-requires-owned-storage+another-long-owned-identifier");
    let text = builder.intoString();
    return SemVer.parse(text.as_str());
}

fn ownership_and_containers() {
    var original = escaped_version();
    let independent = original.clone();
    original.prerelease = "changed".clone();
    original.build = "replaced".clone();
    assert(independent.toString() == "1.2.3-identifier-that-requires-owned-storage+another-long-owned-identifier", "owned parsed identifiers and deep clone");
    var versions = Vec::<SemVer>.new();
    versions.push(SemVer.parse("1.0.0")); versions.push(SemVer.parse("1.0.0-beta.11"));
    versions.push(SemVer.parse("1.0.0-alpha")); versions.push(SemVer.parse("1.0.0-beta.2"));
    versions.sort();
    assert(versions.get_ref(0).toString() == "1.0.0-alpha", "version sorting");
    assert(versions.get_ref(1).toString() == "1.0.0-beta.2", "numeric identifier sorting");
    assert(versions.get_ref(3).toString() == "1.0.0", "release sorts last");
    let copied = versions.clone();
    versions.clear();
    assert(copied.len == 4 && copied.get_ref(2).toString() == "1.0.0-beta.11", "container clone is independent");
    var index = Dict::<SemVer, string>.new();
    index.put(SemVer.parse("1.2.3+linux"), "first".clone());
    index.put(SemVer.parse("1.2.3+windows"), "second".clone());
    assert(index.len == 1 && index.get(SemVer.parse("1.2.3")) == "second", "hash key equality matches precedence");
}

fn increments_and_validation() {
    let version = SemVer.parse("1.2.3-rc.1+sha");
    assert(version.bumpMajor().toString() == "2.0.0", "major bump resets remaining fields");
    assert(version.bumpMinor().toString() == "1.3.0", "minor bump resets remaining fields");
    assert(version.bumpPatch().toString() == "1.2.4", "patch bump removes identifiers");
    let max = SemVer.parse("2147483647.2147483647.2147483647");
    assert(max.try_bump_major().is_err() && max.try_bump_minor().is_err() && max.try_bump_patch().is_err(), "checked increment overflow");
    assert(SemVer.try_create(-1, 0, 0).is_err(), "negative constructor rejected");
    var invalid = SemVer.create(1, 2, 3);
    invalid.prerelease = "01";
    assert(invalid.try_validate().is_err() && invalid.try_compare(version).is_err(), "public fields revalidated");
    invalid.prerelease = "valid";
    invalid.build = "bad+id";
    match (invalid.try_validate()) {
        Ok(_) => { panic("invalid public metadata accepted"); }
        Err(failure) => { assert(failure.offset == -1, "value error has no source offset"); }
    }
}

fn catalog_consumer() {
    let file = File.try_open("catalog.txt", FileOptions { read: true, write: false, create: false, truncate: false, binary: true }).unwrap();
    let catalog = file.try_read_all_text().unwrap();
    assert(catalog.len > 0, "real catalog input");
    match (select_release(catalog, false)) {
        Ok(selection) => { assert(selection.unwrap() == "1.2.0+linux", "stable selection and deterministic tie"); }
        Err(_) => { panic("stable release missing"); }
    }
    match (select_release(catalog, true)) {
        Ok(selection) => { assert(selection.unwrap() == "2.0.0-rc.1", "opt-in prerelease selection"); }
        Err(_) => { panic("prerelease missing"); }
    }
    match (select_release("1.0.0\nnot-a-version\n2.0.0", false)) {
        Err(_) => {} Ok(_) => { panic("catalog silently ignored invalid record"); }
    }
    match (select_release("1.0.0-alpha", false)) {
        Ok(selection) => { assert(selection.is_none(), "empty stable selection invented a version"); }
        Err(_) => { panic("valid catalog failed"); }
    }
}

fn main() -> i32 {
    parsing(); precedence(); ownership_and_containers(); increments_and_validation(); catalog_consumer();
    print("std semver contracts ok");
    return 0;
}
