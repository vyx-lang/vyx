module tests.release_catalog;
use std.core;
use std.collections;
use std.string;
use std.semver;

/// Resolve a line-delimited release catalog. Reject malformed records rather
/// than silently choosing an older version. Equal precedence keeps the first.
public fn select_release(catalog: string, allow_prerelease: bool) -> Result<Option<string>, SemVerError> {
    var best = SemVer.create(0, 0, 0);
    var found = false;
    let lines = catalog.split("\n");
    for (line in lines) {
        let text = line.trim();
        if (text.len == 0) { continue; }
        match (SemVer.try_parse(text)) {
            Err(failure) => { return Err(failure); }
            Ok(candidate) => {
                if (!allow_prerelease && candidate.isPrerelease()) { continue; }
                if (!found || candidate.greaterThan(best)) {
                    best = candidate;
                    found = true;
                }
            }
        }
    }
    if (!found) { return Ok(None); }
    return Ok(Some(best.toString()));
}
