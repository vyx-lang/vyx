@[dci_import("../dci/open_generic.cpp.dcib")]
extern "dci" {
    struct Vec2 {
        public x: f64;
        public y: f64;

        public fn norm1() const -> f64;
    };

    struct Pair2<A, B> {
        public first: A;
        public second: B;

        public fn get_first() const -> A;
        public fn swapped() const -> Pair2<B, A>;
    };

    fn vyx_vec2_make(x: f64, y: f64) -> Vec2;
    fn vyx_vec2_x(v: Vec2) -> f64;
    fn vyx_vec2_y(v: Vec2) -> f64;

    fn twice<T>(v: T) -> T;
    fn max_of<T>(a: T, b: T) -> T;
    fn identity<T>(v: T) -> T;
    fn swap<T, U>(a: T, b: U) -> Pair2<U, T>;
}

// 消费方自己声明的记录，生产端从没见过它 —— 契约里没有它的布局，实例
// `Pair2<i32,TestS>` 也不在 `--export-instance` 名单里。`@[repr(C)]` 是这里的
// 关键：它让记录的布局就是 C 布局（不再带 Vyx class 的 8 字节对齐下限），
// 于是消费方能**推导**出实例的字段偏移，生产端再把同一个数字**实测**回来
// （生成的 shim 里带 size/align/offset 断言，对不上即编译失败）。
//
// 两份 target（rust / cpp）在这一点上是**逐字相同的同一套断言**，只是生产端
// 不同：两边的 C 聚合规则必须一致（8 字节聚合给单个整数寄存器，更宽的按引用）。
@[repr(C)]
struct TestS {
    width: u32;
    height: u32;
}

// 记录里嵌一个 DCI 导入的记录（Vec2 由 descriptor 实测）。16 字节 > 8，
// 所以它按引用过边界；`TestS` 是 8 字节，仍走单个整数寄存器。
@[repr(C)]
struct TestF {
    v: Vec2;
}

impl TestS{
    fn func(&self){
        print("hi");
    }
}

fn main() -> i32 {
    if (twice(21) != 42) { return 1; }
    if (twice(1.5) != 3.0) { return 2; }
    if (max_of(3, 9) != 9) { return 3; }

    let v = vyx_vec2_make(3.0, 4.0);
    if (vyx_vec2_x(v) != 3.0 || vyx_vec2_y(v) != 4.0) { return 4; }

    let r = identity(v);
    if (r.x != 3.0 || r.y != 4.0) { return 5; }

    // 非泛型 record 的成员函数（泛型 record 实例方法旁边的对照）：同一条调用点，
    // 两个生产端各按自己产物的 ABI 命名 —— cpp 是 MSVC 成员符号
    // `?norm1@Vec2@@QEBANXZ`，rust 是稳定链接名 `vyx_vec2_norm1`。
    if (v.norm1() != 7.0) { return 6; }

    let sw = swap(21, 1.5);
    if (sw.first != 1.5 || sw.second != 21) { return 7; }

    if (sw.get_first() != 1.5) { return 8; }

    let rv = sw.swapped();
    if (rv.first != 21) { return 9; }
    if (rv.second != 1.5) { return 10; }

    let half: f32 = 1.5;
    let n32: i32 = 7;
    let n64: i64 = 9;
    let big: u64 = 3;
    let small: u32 = 4;
    let letter: char = 'a';

    let sf = swap(half, 2.5);
    if (sf.first != 2.5 || sf.second != half) { return 11; }
    if (sf.get_first() != 2.5) { return 12; }

    let sn = swap(n32, n64);
    if (sn.first != n64 || sn.second != n32) { return 13; }
    if (sn.get_first() != n64) { return 14; }

    let su = swap(big, small);
    if (su.first != small || su.second != big) { return 15; }
    if (su.get_first() != small) { return 16; }

    let sc = swap(letter, n64);
    if (sc.first != n64 || sc.second != letter) { return 17; }
    if (sc.get_first() != n64) { return 18; }

    let sv = swap(v, n32);
    if (sv.first != n32) { return 19; }
    if (vyx_vec2_x(sv.second) != 3.0 || vyx_vec2_y(sv.second) != 4.0) { return 20; }
    if (sv.get_first() != n32) { return 21; }

    let structT: TestS = TestS{width: 1, height: 1};
    let structF: TestF = TestF{v: v};

    let st = identity(structT);
    if (st.width != 1 || st.height != 1) { return 22; }

    let ss = swap(structT, n32);
    if (ss.first != n32) { return 23; }
    if (ss.second.width != 1 || ss.second.height != 1) { return 24; }
    ss.second.func();
    let sff = swap(structF, n32);
    if (sff.first != n32) { return 25; }
    if (sff.second.v.x != 3.0 || sff.second.v.y != 4.0) { return 26; }

    print("dci_opengeneric OK");
    return 0;
}
