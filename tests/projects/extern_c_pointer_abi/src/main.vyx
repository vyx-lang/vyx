extern "C" {
    fn vyx_sum_i64(values: *i64, count: i32) -> i64;
    fn vyx_identity_i64(value: *i64) -> *i64;
    fn vyx_add_mut_i64(value: &mut i64, delta: i64) -> i64;
    fn vyx_read_ref_i64(value: &i64) -> i64;
}

fn main() -> i32 {
    var values: [i64; 5] = [1, 2, 3, 4, 5];
    {
        var p: *i64 = null;
        p = &mut values;

        if (vyx_sum_i64(p, 5) != 15) { return 1; }

        var same = vyx_identity_i64(p);
        if (*same != 1) { return 2; }
    }

    {
        var second = &mut values[1];
        if (vyx_add_mut_i64(second, 40) != 42) { return 3; }
    }
    if (values[1] != 42) { return 4; }

    {
        var third = &values[2];
        if (vyx_read_ref_i64(third) != 3) { return 5; }
    }
    return 0;
}
