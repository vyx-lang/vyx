@[cuda_kernel]
public fn scale_kernel(dst: *f64, src: *f64, k: f64, n: i32) {
    let tid: i32 = thread_idx_x();
    let stride: i32 = block_dim_x();
    var i: i32 = tid;
    while (i < n) {
        unsafe { dst[i] = src[i] * k; }
        i = i + stride;
    }
}
extern "C" {
    @[link_name("llvm.nvvm.read.ptx.sreg.tid.x")]
    fn thread_idx_x() -> i32;
    @[link_name("llvm.nvvm.read.ptx.sreg.ntid.x")]
    fn block_dim_x() -> i32;
}
