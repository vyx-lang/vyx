use std.fs;
use std.string;
use std.time;

fn print_result(label: string, elapsed_ms: i64, bytes: i64) {
    let mib_per_second = if (elapsed_ms > 0) { (bytes * 1000 / 1024 / 1024) / elapsed_ms } else { 0 };
    print(label + ": " + elapsed_ms.toString() + " ms, " + mib_per_second.toString() + " MiB/s");
}

fn main() -> i32 {
    let path = "target/std_binary_io_bench.bin";
    let text_path = "target/std_file_text_probe.txt";
    let text_writer = File.open(text_path, FileOptions { read: false, write: true, create: true, truncate: true, binary: false });
    if (!text_writer.is_open() || text_writer.write_text("File text API OK") != 0 || text_writer.close() != 0) { return 8; }
    let text_reader = File.open(text_path, FileOptions { read: true, write: false, create: false, truncate: false, binary: false });
    let text_restored = text_reader.read_all_text();
    text_reader.close();
    if (text_restored != "File text API OK") { return 9; }
    deleteFile(text_path);

    let binary_text_path = "target/std_file_binary_text_probe.bin";
    let binary_text_writer = File.open(binary_text_path, FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
    if (!binary_text_writer.is_open() || binary_text_writer.write_text("binary stream text payload") != 0 || binary_text_writer.close() != 0) { return 10; }
    let binary_text_reader = File.open(binary_text_path, FileOptions { read: true, write: false, create: false, truncate: false, binary: true });
    let binary_text_bytes = binary_text_reader.read_all_bytes();
    binary_text_reader.close();
    if (binary_text_bytes.len != 26 || binary_text_bytes.get(0) != 98 as u8 || binary_text_bytes.get(25) != 100 as u8) { return 11; }
    deleteFile(binary_text_path);

    let nul_path = "target/std_binary_io_nul.bin";
    var nul_payload = Vec::<u8>.new();
    nul_payload.push(65 as u8);
    nul_payload.push(0 as u8);
    nul_payload.push(66 as u8);
    let nul_writer = File.open(nul_path, FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
    if (!nul_writer.is_open() || nul_writer.write_all(nul_payload) != 0 || nul_writer.close() != 0) { return 4; }
    let nul_reader = File.open(nul_path, FileOptions { read: true, write: false, create: false, truncate: false, binary: true });
    let nul_restored = nul_reader.read_all_bytes();
    nul_reader.close();
    if (nul_restored.len != 3 || nul_restored.get(0) != 65 as u8 || nul_restored.get(1) != 0 as u8 || nul_restored.get(2) != 66 as u8) { return 5; }
    print("std.fs binary NUL probe: OK");
    deleteFile(nul_path);

    let pattern = "VYX-DCI-BINARY-IO-0123456789ABCDEF";
    let payload = str_repeat(pattern, 1997288);
    let expected_bytes = payload.len as i64;
    if (expected_bytes < 64 * 1024 * 1024) { return 1; }

    var round: i32 = 0;
    while (round < 3) {
        let write_start = clock_ms();
        let writer = File.open(path, FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
        if (!writer.is_open() || writer.write_text(payload) != 0 || writer.close() != 0) { return 2; }
        let write_elapsed = clock_ms() - write_start;

        let read_start = clock_ms();
        let reader = File.open(path, FileOptions { read: true, write: false, create: false, truncate: false, binary: true });
        let restored = reader.read_all_bytes();
        reader.close();
        let read_elapsed = clock_ms() - read_start;
        if (restored.len != expected_bytes) { return 3; }

        print_result("std.fs File binary write round " + round.toString(), write_elapsed, expected_bytes);
        print_result("std.fs File binary read round " + round.toString(), read_elapsed, expected_bytes);

        let binary_write_start = clock_ms();
        let binary_writer = File.open("target/std_binary_io_bench_copy.bin", FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
        if (!binary_writer.is_open() || binary_writer.write_all(restored) != 0 || binary_writer.close() != 0) { return 7; }
        let binary_write_elapsed = clock_ms() - binary_write_start;
        print_result("std.fs File write_all round " + round.toString(), binary_write_elapsed, expected_bytes);
        round = round + 1;
    }
    deleteFile(path);
    deleteFile("target/std_binary_io_bench_copy.bin");
    print("std_binary_io_bench OK");
    return 0;
}
