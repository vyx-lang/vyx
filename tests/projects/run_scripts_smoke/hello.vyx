// PROJECT-BUILD-ONLY: run through `vyx run run_scripts_smoke:hello`.
use std.fs;

fn main() -> i32 {
    if (argCount() >= 5) {
        if (getArg(1) == "--kind" && getArg(2) == "scripted" && getArg(3) == "--name" && getArg(4) == "Zyn") {
            if (writeFile("run_args_trace.txt", "run-script-args-ok\n") != 0) {
                print("run script args write failed");
                return 1;
            }
            print("run-script-args-ok");
            return 0;
        }
    }
    if (argCount() >= 3) {
        if (getArg(1) == "--kind" && getArg(2) == "direct") {
            if (writeFile("run_direct_args_trace.txt", "run-direct-args-ok\n") != 0) {
                print("run direct args write failed");
                return 1;
            }
            print("run-direct-args-ok");
            return 0;
        }
    }
    if (writeFile("run_trace.txt", "run-script-ok\n") != 0) {
        print("run script write failed");
        return 1;
    }
    print("run-script-ok");
    return 0;
}
