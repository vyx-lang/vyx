module fixed_array_vyi_dep;

use std.collections;

public class Item {
    public label: string;
    public values: Vec<i32>;

    public static fn create(label: string, value: i32) -> Item {
        var values = Vec::<i32>.new();
        values.push(value);
        return Item { label: label, values: values };
    }

    public fn clone() -> Item {
        var values = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < (self.values.len as i32)) {
            values.push(self.values.get(i as i64));
            i = i + 1;
        }
        return Item { label: self.label, values: values };
    }

    public fn value() -> i32 {
        return self.values.get(0);
    }

    public fn destroy() {
        self.values.destroy();
    }
}

public class ItemRow {
    public children: Vec<Item>;

    public static fn create() -> ItemRow {
        return ItemRow { children: Vec::<Item>.new() };
    }

    public fn children4(items: [Item; 4]) -> ItemRow {
        self.children.push(items[0].clone());
        self.children.push(items[1].clone());
        self.children.push(items[2].clone());
        self.children.push(items[3].clone());
        return self;
    }

    public fn count() -> i32 {
        return self.children.len as i32;
    }

    public fn total() -> i32 {
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            out = out + self.children.get(i as i64).value();
            i = i + 1;
        }
        return out;
    }

    public fn destroy() {
        var i: i32 = 0;
        while (i < (self.children.len as i32)) {
            var child = self.children.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.children.destroy();
    }
}
