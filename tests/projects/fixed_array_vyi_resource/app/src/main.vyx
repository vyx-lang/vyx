module fixed_array_vyi_app;

// PROJECT-BUILD-ONLY: requires fixed_array_vyi_dep package build and generated .vyi interface.

use fixed_array_vyi_dep;

fn main() -> i32 {
    let a = Item.create("a", 1);
    let b = Item.create("b", 2);
    let c = Item.create("c", 3);
    let d = Item.create("d", 4);
    var row = ItemRow.create().children4([a, b, c, d]);

    if (row.count() != 4) {
        row.destroy();
        a.destroy();
        b.destroy();
        c.destroy();
        d.destroy();
        return 1;
    }
    if (row.total() != 10) {
        row.destroy();
        a.destroy();
        b.destroy();
        c.destroy();
        d.destroy();
        return 2;
    }

    row.destroy();
    a.destroy();
    b.destroy();
    c.destroy();
    d.destroy();
    return 0;
}
