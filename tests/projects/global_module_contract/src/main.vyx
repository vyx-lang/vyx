// PROJECT-BUILD-ONLY: requires separate modules and generated .vyi interfaces.
module global_contract.app;

use global_contract.reader;
use global_contract.writer;
use global_contract.peer_reader;

fn main() -> i32 {
    let reader_result = reader_initial();
    if (reader_result != 0) { return reader_result; }
    let writer_result = writer_initial();
    if (writer_result != 0) { return writer_result; }
    let peer_result = peer_initial();
    if (peer_result != 0) { return peer_result; }
    if (writer_update() != 59) { return 20; }
    let observed = reader_after_writer();
    if (observed != 0) { return observed; }
    if (reader_update() != 73) { return 23; }
    if (writer_read() != 73) { return 24; }
    if (peer_initial() != 0) { return 33; }
    if (peer_update() != 13) { return 34; }
    if (writer_read() != 73) { return 35; }
    print("global module contract OK");
    return 0;
}
