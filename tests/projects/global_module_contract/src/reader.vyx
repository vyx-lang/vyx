module global_contract.reader;

use global_contract.storage;

// Change local item ids relative to both the producer and the other consumer.
var reader_first: i32 = 101;

public fn reader_initial() -> i32 {
    if (counter != 41) { return 11; }
    if (message != "producer string") { return 12; }
    return 0;
}

public fn reader_after_writer() -> i32 {
    if (counter != 59) { return 21; }
    if (message != "producer string") { return 22; }
    return 0;
}

public fn reader_update() -> i32 {
    counter = 73;
    return counter;
}
