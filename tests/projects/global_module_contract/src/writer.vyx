module global_contract.writer;

use global_contract.storage;

public fn writer_initial() -> i32 {
    if (counter != 41) { return 13; }
    if (message != "producer string") { return 14; }
    return 0;
}

public fn writer_update() -> i32 {
    counter = 59;
    return counter;
}

public fn writer_read() -> i32 { return counter; }
