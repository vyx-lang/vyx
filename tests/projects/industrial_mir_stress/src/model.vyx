module industrial.model;

public interface Ident {
    fn id() -> string;
    fn score() -> i32;
}

public interface Weighted : Ident {
    fn weight() -> f32;
}

public class BaseRecord : Ident {
    public key: string;
    public base: i32;

    public static fn create(key: string, base: i32) -> BaseRecord {
        return BaseRecord { key: key, base: base };
    }

    public fn id() -> string {
        return self.key;
    }

    public fn score() -> i32 {
        return self.base;
    }
}

public class WeightedRecord : BaseRecord {
    public bonus: i32;
    public w: f32;

    public static fn create(key: string, base: i32, bonus: i32, w: f32) -> WeightedRecord {
        return WeightedRecord { key: key, base: base, bonus: bonus, w: w };
    }

    public fn score() -> i32 {
        return self.base + self.bonus;
    }

    public fn weight() -> f32 {
        return self.w;
    }

    public fn setBonus(value: i32) {
        self.bonus = value;
    }
}

public fn ident_tag(item: dyn Ident) -> string {
    return item.id() + ":" + item.score().toString();
}

public fn weighted_tag(item: dyn Weighted) -> string {
    return item.id() + ":" + item.score().toString() + ":" + item.weight().toString();
}

public fn generic_score<T>(item: T) -> i32 where T: Ident {
    return item.score();
}
