module industrial.pipeline;

use std.collections;
use industrial.model;

public class Stage {
    public name: string;
    public factor: i32;

    public static fn create(name: string, factor: i32) -> Stage {
        return Stage { name: name, factor: factor };
    }

    public fn apply(input: i32) -> i32 {
        return input + self.factor;
    }
}

public class Pipeline {
    public stages: Vec<Stage>;
    public totals: Dict<string, i32>;

    public static fn create() -> Pipeline {
        return Pipeline {
            stages: Vec::<Stage>.new(),
            totals: Dict::<string, i32>.new()
        };
    }

    public fn add(stage: Stage) {
        self.stages.push(stage);
    }

    public fn patchFirst(stage: Stage) {
        self.stages[0] = stage;
    }

    public fn run(seed: i32) -> i32 {
        var total = seed;
        for (stage in self.stages) {
            total = stage.apply(total);
            self.totals.put(stage.name, total);
        }
        return total;
    }

    public fn totalFor(name: string) -> i32 {
        return self.totals.get(name);
    }
}

public fn build_records() -> Vec<WeightedRecord> {
    var out = Vec::<WeightedRecord>.new();
    out.push(WeightedRecord.create("alpha", 10, 1, 0.08));
    out.push(WeightedRecord.create("beta", 20, 2, 0.12));
    out.push(WeightedRecord.create("gamma", 30, 3, 0.16));
    out[1].setBonus(12);
    return out;
}

public fn score_records(records: Vec<WeightedRecord>) -> i32 {
    var total = 0;
    for (record in records) {
        total = total + generic_score::<WeightedRecord>(record);
    }
    return total;
}
