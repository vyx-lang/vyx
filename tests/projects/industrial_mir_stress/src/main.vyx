module industrial.app;

use std.collections;
use std.vio;
use industrial.model;
use industrial.pipeline;
use industrial.async_ops;

fn check_records() -> i32 {
    let base = BaseRecord.create("base", 7);
    let weighted = WeightedRecord.create("weighted", 10, 5, 0.08);
    if (ident_tag(base) != "base:7") { return 1; }
    if (ident_tag(weighted) != "weighted:15") { return 2; }
    if (weighted_tag(weighted) != "weighted:15:0.08") { return 3; }
    if (weighted.weight() != 0.08) { return 4; }
    if (generic_score::<WeightedRecord>(weighted) != 15) { return 5; }

    var records = build_records();
    if (records.len != 3) { return 6; }
    if (records[0].score() != 11) { return 7; }
    if (records[1].score() != 32) { return 8; }
    if (records[2].weight() != 0.16) { return 9; }
    if (score_records(records) != 76) { return 10; }
    return 0;
}

fn check_pipeline() -> i32 {
    var pipe = Pipeline.create();
    pipe.add(Stage.create("load", 3));
    pipe.add(Stage.create("transform", 5));
    pipe.add(Stage.create("store", 7));
    pipe.patchFirst(Stage.create("load", 4));
    let total = pipe.run(10);
    if (total != 26) { return 20; }
    if (pipe.totalFor("load") != 14) { return 21; }
    if (pipe.totalFor("transform") != 19) { return 22; }
    if (pipe.totalFor("store") != 26) { return 23; }
    return 0;
}

fn check_nested_containers() -> i32 {
    var rows = Vec::<Dict<string, i32>>.new();
    var i = 0;
    while (i < 4) {
        var row = Dict::<string, i32>.new();
        row.put("id", i);
        row.put("value", i * i + 1);
        rows.push(row);
        i = i + 1;
    }
    var sum = 0;
    for (row in rows) {
        sum = sum + row.get("value");
    }
    if (sum != 18) { return 30; }
    return 0;
}

fn main() -> i32 {
    let r1 = check_records();
    if (r1 != 0) { return r1; }
    let r2 = check_pipeline();
    if (r2 != 0) { return r2; }
    let r3 = check_nested_containers();
    if (r3 != 0) { return r3; }

    vio_start();
    let async_value = await async_accumulate(40, 2);
    vio_stop();
    if (async_value != 42) { return 40; }

    print("industrial_mir_stress OK");
    return 0;
}
