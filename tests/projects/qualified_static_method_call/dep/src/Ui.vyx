module QRoot.ui.Ui;

public class Bounds {
    public x: f32;
    public y: f32;
    public w: f32;
    public h: f32;

    public static fn create(x: f32, y: f32, w: f32, h: f32) -> Bounds {
        return Bounds { x: x, y: y, w: w, h: h };
    }
}

public class Theme {
    public state_alpha: f32;
    public disabled_alpha: f32;

    public static fn light() -> Theme {
        return Theme { state_alpha: 0.08, disabled_alpha: 0.38 };
    }
}

public class UiNode {
    public node_id: string;
    public text: string;
    public bounds: Bounds;
    public theme: Theme;
    public flags: i32;

    public static fn filledButton(node_id: string, text: string, bounds: Bounds, theme: Theme) -> UiNode {
        return UiNode {
            node_id: node_id,
            text: text,
            bounds: bounds,
            theme: theme,
            flags: 7
        };
    }

    public fn score() -> i32 {
        if (self.node_id == "theme.filled" && self.text == "Filled" && self.flags == 7) {
            return 10;
        }
        return 1;
    }
}
