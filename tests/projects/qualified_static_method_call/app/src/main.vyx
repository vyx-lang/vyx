module qualified_static_method_call_app;

// PROJECT-BUILD-ONLY: requires QRoot dependency package build and generated .vyi interface.
use QRoot;

fn main() -> i32 {
    let bounds = QRoot.ui.Ui.Bounds.create(1.0 as f32, 2.0 as f32, 3.0 as f32, 4.0 as f32);
    let theme = QRoot.ui.Ui.Theme.light();
    let node = QRoot.ui.Ui.UiNode.filledButton("theme.filled", "Filled", bounds, theme);

    if (node.score() != 10) { return 1; }
    if (node.bounds.w != 3.0 as f32) { return 2; }
    if (node.theme.disabled_alpha != 0.38 as f32) { return 3; }
    return 0;
}
