module tests.client_request;
use std.core;
use std.collections;
use std.url;

/// Application request preparation: choose the search endpoint, preserve
/// repeated query keys, and omit the URL fragment from the outgoing request.
public fn prepare_search(base: string, parameters: &Vec<QueryPair>) -> Result<string, UrlError> {
    match (Url.try_parse(base)) {
        Err(failure) => { return Err(failure); }
        Ok(endpoint) => {
            endpoint.path = "/search";
            endpoint.query = query_encode_pairs(parameters);
            endpoint.has_query = true;
            endpoint.fragment = "";
            endpoint.has_fragment = false;
            return endpoint.try_to_string();
        }
    }
}
