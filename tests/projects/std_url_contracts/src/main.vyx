module tests.std_url_contracts;
use std.core;
use std.string;
use std.collections;
use std.fs;
use std.url;
use tests.client_request;

fn roundtrip(text: string) {
    match (Url.try_parse(text)) {
        Ok(value) => { assert(value.toString() == text, "URL structural round trip"); }
        Err(failure) => { panic("valid URL rejected at ", failure.offset, ": ", text); }
    }
}
fn rejected(text: string, kind: UrlErrorKind, offset: i64) {
    match (Url.try_parse(text)) {
        Ok(_) => { panic("invalid URL accepted: ", text); }
        Err(failure) => { assert(failure.kind == kind && failure.offset == offset && failure.message.len > 0, "located URL error"); }
    }
}
fn bad_escape(text: string, offset: i64) {
    match (try_url_decode(text)) {
        Ok(_) => { panic("bad escape accepted"); }
        Err(failure) => { assert(failure.kind == UrlErrorKind.InvalidEscape && failure.offset == offset, "located escape error"); }
    }
}

fn codecs() {
    assert(url_encode("AZaz09-._~") == "AZaz09-._~", "URL unreserved alphabet");
    assert(url_encode(" +*/?&=\0") == "%20%2B%2A%2F%3F%26%3D%00", "URL reserved bytes");
    assert(url_decode("a+b%2Bc%20d") == "a+b+c d", "URL decoding preserves literal plus");
    assert(form_encode(" +*~") == "+%2B*%7E", "form alphabet differs from URL alphabet");
    assert(form_decode("a+b%2Bc%20d") == "a b+c d", "form decoding maps plus to space once");
    assert(url_decode("%252F") == "%2F", "decode exactly once");
    bad_escape("%", 0); bad_escape("%0", 0); bad_escape("%GG", 0); bad_escape("a%2x", 1);
    assert(try_form_decode("%2").is_err(), "form also rejects incomplete escape");
    var builder = StringBuilder.create();
    var i: i32 = 0;
    while (i < 256) { builder.appendChar(i); i += 1; }
    let owned = builder.intoString();
    let encoded = url_encode(owned.as_str());
    let decoded = url_decode(encoded);
    let form_decoded = form_decode(form_encode(owned.as_str()));
    assert(decoded.len == 256 && form_decoded.len == 256, "all-byte decoded lengths");
    i = 0;
    while (i < 256) {
        assert(decoded.charAt(i) == i && form_decoded.charAt(i) == i, "all 256 bytes round trip");
        i += 1;
    }
}

fn urls() {
    roundtrip("http://example.org"); roundtrip("http://example.org?"); roundtrip("http://example.org#");
    roundtrip("HTTP://Example.org/?#"); roundtrip("https://@example.org");
    roundtrip("https://user:p%40ss@example.org:00443/a%2Fb?q=+%20#frag");
    roundtrip("ws://127.0.0.1:0/"); roundtrip("wss://[::]:65535/a?x#");
    roundtrip("http://[2001:db8::1]:80/"); roundtrip("http://[::ffff:192.0.2.128]/");
    roundtrip("http://[1:2:3:4:5:6:7:8]/"); roundtrip("http://[1:2:3:4:5:6:192.0.2.1]/");
    let address = Url.parse("https://u:p@[2001:db8::1]:443/a?x=1#z");
    assert(address.host == "2001:db8::1" && address.port == "443" && address.path == "/a", "IPv6 host is not a port");
    assert(address.userinfo == "u:p" && address.query == "x=1" && address.fragment == "z", "URL components");
    rejected("/relative", UrlErrorKind.InvalidScheme, 0);
    rejected("1http://x", UrlErrorKind.InvalidScheme, 0);
    rejected("ftp://x", UrlErrorKind.UnsupportedScheme, 0);
    rejected("http:x", UrlErrorKind.InvalidAuthority, 5);
    rejected("http://", UrlErrorKind.InvalidHost, 7);
    rejected("http://:80", UrlErrorKind.InvalidHost, 7);
    rejected("http://x:", UrlErrorKind.InvalidPort, 9);
    rejected("http://x:65536", UrlErrorKind.InvalidPort, 13);
    rejected("http://x:bad", UrlErrorKind.InvalidPort, 9);
    rejected("http://x/a b", UrlErrorKind.InvalidCharacter, 10);
    rejected("http://x/%Q0", UrlErrorKind.InvalidCharacter, 9);
    rejected("http://x/a\0b", UrlErrorKind.InvalidCharacter, 10);
    rejected("http://u@v@x", UrlErrorKind.InvalidAuthority, 10);
    rejected("http://[:::]/", UrlErrorKind.InvalidHost, 7);
    rejected("http://[1:2:3:4:5:6:7:8::]/", UrlErrorKind.InvalidHost, 7);
    rejected("http://[::ffff:192.0.2.256]/", UrlErrorKind.InvalidHost, 7);
    rejected("http://[::1]junk/", UrlErrorKind.InvalidAuthority, 12);
    rejected("http://256.1.2.3/", UrlErrorKind.InvalidHost, 7);
    rejected("http://127.01.2.3/", UrlErrorKind.InvalidHost, 7);
    rejected("http://[fe80::1%25eth0]/", UrlErrorKind.InvalidHost, 7);
    rejected("http://x/#a#b", UrlErrorKind.InvalidCharacter, 11);
}

fn queries() {
    var pairs = try_query_decode("a=1&a=2&empty=&=x&bare&&").unwrap();
    assert(pairs.len == 5, "query preserves duplicates and ignores empty separators");
    assert(pairs.get_ref(0).key == "a" && pairs.get_ref(1).value == "2", "ordered duplicate keys");
    assert(pairs.get_ref(2).value == "" && pairs.get_ref(3).key == "", "empty key and value");
    assert(query_encode_pairs(&pairs) == "a=1&a=2&empty=&=x&bare=", "query serialization");
    let copied = pairs.clone(); pairs.clear();
    assert(copied.len == 5 && copied.get_ref(4).key == "bare", "query result owns independent strings");
    let form = try_form_query_decode("literal=%2B&space=+&nul=%00&eq=a=b").unwrap();
    assert(form.get_ref(0).value == "+" && form.get_ref(1).value == " ", "form query decoding");
    assert(form.get_ref(2).value.len == 1 && form.get_ref(2).value.charAt(0) == 0, "NUL value");
    assert(form.get_ref(3).value == "a=b", "split only the first equals delimiter");
    assert(form_query_encode(&form) == "literal=%2B&space=+&nul=%00&eq=a%3Db", "form query encoding");
    let literal = try_query_decode("x=+").unwrap();
    assert(literal.get_ref(0).value == "+", "percent query preserves plus");
    match (try_query_decode("a=ok&b=%")) {
        Err(failure) => { assert(failure.offset == 7, "query error uses full input offset"); }
        Ok(_) => { panic("invalid query escape accepted"); }
    }
    assert(try_query_decode("").unwrap().len == 0, "empty query has no pairs");
    var dictionary = Dict::<string, string>.new();
    dictionary.put("z".clone(), "+".clone()); dictionary.put("a".clone(), " ".clone());
    assert(query_encode(dictionary) == "a=%20&z=%2B" && dictionary.len == 2, "dictionary encoding borrows and sorts keys");
    assert(dictionary.get("a") == " " && dictionary.get("z") == "+", "dictionary values survive encoding");
}

fn scoped_url() -> Url {
    let text = String.from("https://example.org/a-long-owned-path?long-owned-query=value#long-owned-fragment");
    return Url.parse(text.as_str());
}
fn ownership_and_mutation() {
    let independent = scoped_url();
    var modified = independent.clone();
    modified.host = "other.example".clone();
    assert(independent.host == "example.org" && modified.host == "other.example", "URL Clone owns its fields");
    modified.query = "x#not-a-query";
    assert(modified.try_to_string().is_err(), "query cannot inject a fragment");
    modified.query = "valid"; modified.has_query = false;
    match (modified.try_to_string()) {
        Err(failure) => { assert(failure.kind == UrlErrorKind.InvalidState && failure.offset == -1, "invalid edited delimiter flags"); }
        Ok(_) => { panic("inconsistent URL fields accepted"); }
    }
}

fn request_consumer() {
    var parameters = Vec::<QueryPair>.new();
    parameters.push(QueryPair { key: "tag", value: "a+b" });
    parameters.push(QueryPair { key: "tag", value: "中文 空格" });
    let endpoint = prepare_search("http://[::1]:8080/old?old=1#local", &parameters).unwrap();
    assert(endpoint == "http://[::1]:8080/search?tag=a%2Bb&tag=%E4%B8%AD%E6%96%87%20%E7%A9%BA%E6%A0%BC", "application URL preparation");
    let parsed = Url.parse(endpoint);
    let target = parsed.path + "?" + parsed.query;
    assert(writeFile(".cache/request-target.txt", target) == 0 && readFile(".cache/request-target.txt") == target, "request target storage");
    let received = try_query_decode(parsed.query).unwrap();
    assert(received.len == 2 && received.get_ref(0).value == "a+b" && received.get_ref(1).value == "中文 空格", "query consumer round trip");
    assert(prepare_search("invalid", &parameters).is_err(), "application propagates URL errors");
}

fn main() -> i32 {
    codecs(); urls(); queries(); ownership_and_mutation(); request_consumer();
    print("std url contracts ok");
    return 0;
}
