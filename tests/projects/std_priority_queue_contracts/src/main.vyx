module tests.std_priority_queue_contracts;
use std.core;
use std.collections;
use std.hash;
use std.clone;
use std.string;

var created: i64 = 0;
var dropped: i64 = 0;
var comparisons: i64 = 0;
class Entry {
    public key: i64;
    public text: String;
    fn drop(&mut self) { dropped += 1; self.text.drop(); }
}
fn entry(key: i64) -> Entry {
    created += 1;
    return Entry { key: key, text: String.from("heap entry owning a non-inline String allocation") };
}
impl Clone for Entry { fn clone(&self) -> Entry { return entry(self.key); } }
impl Ord for Entry {
    @[borrow_args]
    fn compare(&self, other: Entry) -> i32 {
        comparisons += 1;
        assert(self.text.size() > 23 && other.text.size() > 23, "comparison borrows live resources");
        if (self.key < other.key) { return -1; }
        if (self.key > other.key) { return 1; }
        return 0;
    }
}

fn owning_contracts() {
    var heap = PriorityQueue::<Entry>.with_capacity(4);
    var i: i64 = 0;
    while (i < 1024) { heap.push(entry((i * 37) % 1024)); i += 1; }
    assert(dropped == 0, "push, growth and comparison never duplicate owners");
    assert(comparisons < 20000, "push has logarithmic comparison cost");
    { match (heap.peek()) { Some(value) => { assert(value.key == 0, "peek minimum"); } None => { panic("missing root"); } } }
    assert(dropped == 1, "peek returns one independent clone");
    {
        var copy = heap.clone();
        assert(copy.len == 1024, "clone copies all slots");
        copy.as_max_heap();
        match (copy.pop()) { Some(value) => { assert(value.key == 1023, "nonempty max-heap rebuild"); } None => { panic("missing copied root"); } }
        copy.clear();
        assert(copy.len == 0 && copy.capacity() >= 1024, "clear retains storage");
        copy.push(entry(2000));
        copy.destroy(); copy.destroy();
    }
    assert(dropped == 1026, "clone/pop/clear/reuse each destroy exactly once");
    heap.as_max_heap().as_min_heap();
    i = 0;
    while (i < 1024) {
        match (heap.pop()) { Some(value) => { assert(value.key == i, "priority order after two rebuilds"); } None => { panic("heap ended early"); } }
        i += 1;
    }
    assert(heap.isEmpty(), "drained heap is empty");
    match (heap.pop()) { None => {} Some(_) => { panic("empty pop yielded an element"); } }
    heap.destroy(); heap.destroy();
    assert(dropped == created, "all owning heap entries destroyed exactly once");
}

fn scalar_contracts() {
    var maximum = PriorityQueue::<u64>.new_max();
    maximum.push(18446744073709551615 as u64); maximum.push(1 as u64); maximum.push(9223372036854775808 as u64);
    match (maximum.pop()) { Some(value) => { assert(value == 18446744073709551615 as u64, "unsigned maximum"); } None => { panic("missing maximum"); } }
    maximum.as_min_heap();
    match (maximum.pop()) { Some(value) => { assert(value == 1 as u64, "unsigned minimum after rebuild"); } None => { panic("missing minimum"); } }
    var floating = PriorityQueue::<f64>.new();
    floating.push(2.5); floating.push(-7.25); floating.push(0.0);
    match (floating.pop()) { Some(value) => { assert(value == -7.25, "floating point order"); } None => { panic("missing float"); } }
    var text = PriorityQueue::<string>.new();
    text.push("b".clone()); text.push("a\0z".clone()); text.push("a\0b".clone());
    match (text.pop()) { Some(value) => { assert(value == "a\0b", "binary string order"); } None => { panic("missing text"); } }
    text.clear();
}

// Order-dependent methods do not impose Clone on a move-only element.
class Ticket {
    public key: i64;
    fn drop(&mut self) { dropped += 1; }
}
impl Ord for Ticket {
    @[borrow_args]
    fn compare(&self, other: Ticket) -> i32 {
        if (self.key < other.key) { return -1; }
        if (self.key > other.key) { return 1; }
        return 0;
    }
}
fn move_only_contract() {
    let before = dropped;
    {
        var heap = PriorityQueue::<Ticket>.new();
        heap.push(Ticket { key: 3 }); heap.push(Ticket { key: 1 }); heap.push(Ticket { key: 2 });
        match (heap.pop()) { Some(value) => { assert(value.key == 1, "move-only pop"); } None => { panic("missing ticket"); } }
        heap.clear();
    }
    assert(dropped == before + 3, "move-only heap cleanup");
}

@[align(64)]
class Aligned { public key: i64; }
impl Ord for Aligned {
    @[borrow_args]
    fn compare(&self, other: Aligned) -> i32 {
        if (self.key < other.key) { return -1; }
        if (self.key > other.key) { return 1; }
        return 0;
    }
}
fn aligned_contract() {
    var heap = PriorityQueue::<Aligned>.with_capacity(4);
    var i: i64 = 0;
    while (i < 100) {
        heap.push(Aligned { key: 100 - i });
        assert((heap.data as usize) % 64 == 0, "over-aligned heap storage, including growth");
        i += 1;
    }
    match (heap.pop()) { Some(value) => { assert(value.key == 1, "over-aligned heap root"); } None => { panic("missing aligned value"); } }
}
fn main() -> i32 {
    owning_contracts(); scalar_contracts(); move_only_contract(); aligned_contract();
    print("std priority queue contracts ok");
    return 0;
}
