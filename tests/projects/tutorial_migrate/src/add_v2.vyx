@[version("2.0.0")]
@[variant("_1")]
module Add;

@[migrate(fromVer="1.0.0")]
public fn add(a: i32, b: i32) -> i32 {
    return (a + b) * 10;
}

public class Point {
    @[migrate(fromVer="1.0.0", fromField="n")]
    public m: i32;

    @[migrate(fromVer="1.0.0")]
    public added: i32;

    @[migrate(fromVer="1.0.0")]
    public Point() {
        self.m = 1;
    }

    @[migrate(fromVer="1.0.0")]
    public fn twice(self) -> i32 {
        return self.m * 20;
    }
}
