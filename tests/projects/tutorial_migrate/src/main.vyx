use Add;

fn main() -> i32 {
    if (add(1, 2) != 30) { return 1; }
    if (add@1.0.0["_1"](1, 2) != 3) { return 2; }
    let t = Point();
    if (t.m != 1) { return 3; }
    if (t.n != 1) { return 4; }
    if (t.added != 0) { return 5; }
    if (t.twice() != 20) { return 6; }
    if (t.twice@1.0.0["_1"]() != 2) { return 7; }
    return 0;
}
