use std.fs;
use std.string;
use fixture.values;

extern "C" { fn native_answer() -> i32; }

fn main() -> i32 {
    if (readFile("postbuild.txt") != "ready") { return 91; }
    if (native_answer() != expected_answer()) { return 92; }
    if (isDir(".cache/.vyx_build.lock")) { return 93; }
    writeFile("program-ran.txt", "yes");
    print("PROJECT_BUILD_RUN_OK");
    var i: i32 = 1;
    while (i < argCount()) {
        let arg = getArg(i);
        print("ARG:" + i.toString() + ":" + arg.len.toString() + ":" + arg);
        i = i + 1;
    }
    if (argCount() > 1 && getArg(1) == "exit7") { return 7; }
    return 0;
}
