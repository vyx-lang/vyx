module tests.std_json_package;

use std.serde.json;

fn main() -> i32 {
    var root: Json;
    match (Json.parse("{\"name\":\"Vyx\",\"enabled\":true,\"items\":[1,2],\"none\":null}")) {
        case Ok(value) => { root = value; }
        case Err(err) => {
            print("parse failed at ${err.offset}");
            return 1;
        }
    }

    match (root.get_string("name")) {
        case Ok(name) => { if (name != "Vyx") { print("unexpected name: " + name); return 2; } }
        case Err(_) => { return 3; }
    }
    match (root.get_bool("enabled")) {
        case Ok(enabled) => { if (!enabled) { return 4; } }
        case Err(_) => { return 5; }
    }

    let missing = root.get("missing");
    match (missing) {
        case Err(err) => { if (err.code != json_error_missing()) { return 6; } }
        case Ok(_) => { return 7; }
    }
    let wrong_type = root.get_number("name");
    match (wrong_type) {
        case Err(err) => { if (err.code != json_error_type()) { return 8; } }
        case Ok(_) => { return 9; }
    }

    var items: Json;
    match (root.get("items")) {
        case Ok(value) => { items = value; }
        case Err(_) => { return 10; }
    }
    if (!items.push_number(3.0).is_ok()) { return 11; }
    if (!root.put("items", items).is_ok()) { return 12; }

    var third: Json;
    match (root.get("items")) {
        case Ok(value) => {
            match (value.at(2)) {
                case Ok(item) => { third = item; }
                case Err(_) => { return 13; }
            }
        }
        case Err(_) => { return 14; }
    }
    match (third.as_number()) {
        case Ok(number) => { if (number != 3.0) { return 15; } }
        case Err(_) => { return 16; }
    }

    let snapshot = root.clone();
    if (!root.put_string("name", "changed").is_ok()) { return 17; }
    match (snapshot.get_string("name")) {
        case Ok(name) => { if (name != "Vyx") { return 18; } }
        case Err(_) => { return 19; }
    }

    match (root.to_string()) {
        case Ok(text) => {
            if (!text.contains("\"changed\"") || !text.contains("[1,2,3]")) {
                print("unexpected JSON: " + text);
                return 20;
            }
        }
        case Err(_) => { return 21; }
    }

    match (Json.parse("{broken")) {
        case Err(err) => {
            if (err.code != json_error_parse() || err.offset < 0) { return 22; }
        }
        case Ok(_) => { return 23; }
    }

    print("std.json package ok");
    return 0;
}
