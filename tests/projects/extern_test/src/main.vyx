use app.helpers;
use std.time;

fn main() -> i32 {
    // Test 1: call function from helpers module
    let t = get_time();
    print("time: ${t}");
    
    // Test 2: can we call the standard time helper directly?
    let t2 = current_timestamp();
    print("direct time: ${t2}");
    
    // Test 3: can we use strlen directly?
    let s = "hello";
    let len = strlen(s.ptr);
    print("strlen: ${len}");
    
    print("all passed!");
    return 0;
}
