module mir2cpp.class_arg_state;

class StateBox {
    public value: i32;
}

fn set_box_value(box: StateBox, value: i32) {
    box.value = value;
}

fn update_through_wrapper(prefix: i32, box: StateBox, value: i32) {
    set_box_value(box, prefix + value);
}

fn read_temporary_between_scalars(prefix: i32, box: StateBox, suffix: i32) -> i32 {
    return prefix + box.value + suffix;
}

fn signed_add(lhs: i64, rhs: i64) -> i64 { return lhs + rhs; }
fn signed_mul(lhs: i64, rhs: i64) -> i64 { return lhs * rhs; }
fn signed_neg(value: i64) -> i64 { return -value; }
fn signed_shl(lhs: i64, rhs: i64) -> i64 { return lhs << rhs; }
fn signed_lshr(lhs: i64, rhs: i64) -> i64 { return lhs >> rhs; }

fn type_name_predicate(value: i32) -> bool { return value == 42; }
fn sizeof_predicate(value: i32) -> bool { return value == 42; }
fn reflect_name_predicate(value: i32) -> bool { return value == 42; }
fn reflect_method_value_predicate(value: i32) -> bool { return value == 42; }

fn string_len_beats_negative(value: string) -> bool {
    var best_len: i32 = -1;
    return value.len > best_len;
}

fn main() -> i32 {
    var box = StateBox { value: 1 };
    update_through_wrapper(2, box, 40);
    if (box.value != 42) { return 1; }

    let temporary_value = read_temporary_between_scalars(5, StateBox { value: 30 }, 7);
    if (temporary_value != 42) { return 2; }

    let max_i64: i64 = 9223372036854775807;
    let min_i64 = signed_shl(1, 63);
    if (min_i64 >= 0) { return 3; }
    if (signed_add(max_i64, 1) != min_i64) { return 4; }
    if (signed_neg(min_i64) != min_i64) { return 5; }
    if (signed_mul(min_i64, 3) != min_i64) { return 6; }
    if (signed_lshr(-1, 1) != max_i64) { return 7; }
    if (!type_name_predicate(42)) { return 8; }
    if (type_name_predicate(41)) { return 9; }
    if (!sizeof_predicate(42)) { return 10; }
    if (sizeof_predicate(41)) { return 11; }
    if (!reflect_name_predicate(42)) { return 12; }
    if (reflect_name_predicate(41)) { return 13; }
    if (!reflect_method_value_predicate(42)) { return 14; }
    if (reflect_method_value_predicate(41)) { return 15; }
    if (!string_len_beats_negative("")) { return 16; }
    if (!string_len_beats_negative("bootstrap.ast")) { return 17; }

    print("mir2cpp_class_arg_state OK");
    return 0;
}
