@[dci_import("../contracts/OpaqueBox.dcib")]
extern "dci" {
    class dci_opaque.OpaqueBox {
        OpaqueBox(seed: i32);
        ~OpaqueBox();
    };
}

fn forward_box(value: dci_opaque.OpaqueBox) -> dci_opaque.OpaqueBox {
    return value;
}

fn main() -> i32 {
    var box = dci_opaque.OpaqueBox(1);
    box = forward_box(dci_opaque.OpaqueBox(2));
    return 0;
}
