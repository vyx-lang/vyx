@[dci_import("../contracts/OpaqueBox.dcib")]
extern "dci" {
    fn dci_opaque_free_mix(lhs: i32, rhs: i32) -> i32;
    fn dci_opaque_live_count() -> i32;
    fn dci_opaque_destroyed_count() -> i32;
    fn dci_opaque_invalid_destroy_count() -> i32;

    class dci_opaque.OpaqueBox {
        OpaqueBox(seed: i32);
        ~OpaqueBox();
        public fn valid() const -> bool;
        public fn value() const -> i32;
        public fn add(delta: i32) -> i32;
    };
}

fn exercise_box(seed: i32) -> i32 {
    var box = dci_opaque.OpaqueBox(seed);
    if (!box.valid()) { return 1; }
    if (box.value() != seed) { return 2; }
    if (box.add(5) != seed + 5) { return 3; }
    if (!box.valid()) { return 4; }
    return 0;
}

fn early_return_box(seed: i32) -> i32 {
    var box = dci_opaque.OpaqueBox(seed);
    if (box.valid()) {
        return box.value();
    }
    return -1;
}

fn reassign_box(first: i32, second: i32) -> i32 {
    var box = dci_opaque.OpaqueBox(first);
    if (!box.valid() || box.value() != first) { return 1; }
    box = dci_opaque.OpaqueBox(second);
    if (!box.valid() || box.value() != second) { return 2; }
    return 0;
}

fn main() -> i32 {
    let live0 = dci_opaque_live_count();
    let destroyed0 = dci_opaque_destroyed_count();
    let invalid0 = dci_opaque_invalid_destroy_count();

    if (dci_opaque_free_mix(3, 4) != 97) { return 10; }
    let result = exercise_box(40);
    if (result != 0) { return 20 + result; }

    if (dci_opaque_live_count() != live0) { return 30; }
    if (dci_opaque_destroyed_count() != destroyed0 + 1) { return 31; }
    if (dci_opaque_invalid_destroy_count() != invalid0) { return 32; }

    let early_destroyed0 = dci_opaque_destroyed_count();
    if (early_return_box(77) != 77) { return 40; }
    if (dci_opaque_live_count() != live0) { return 41; }
    if (dci_opaque_destroyed_count() != early_destroyed0 + 1) { return 42; }
    if (dci_opaque_invalid_destroy_count() != invalid0) { return 43; }

    let reassign_destroyed0 = dci_opaque_destroyed_count();
    if (reassign_box(90, 120) != 0) { return 50; }
    if (dci_opaque_live_count() != live0) { return 51; }
    if (dci_opaque_destroyed_count() != reassign_destroyed0 + 2) { return 52; }
    if (dci_opaque_invalid_destroy_count() != invalid0) { return 53; }

    print("mir2cpp_dci_direct_opaque OK");
    return 0;
}
