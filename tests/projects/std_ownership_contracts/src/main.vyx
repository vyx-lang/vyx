module tests.std_ownership_contracts;
use std.core;
use std.string;
var drops: i64 = 0;
class Payload {
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn payload() -> Payload { return Payload { text: String.from("wildcard owns a heap-backed String resource") }; }
fn failure() -> Result<i64, Payload> { return Err(payload()); }
enum Packet {
    Pair(Payload, Payload),
    Empty,
    fn observe(&self) { match (self) { Pair(_, _) => {} Empty => {} } }
}
fn early_return() -> i32 {
    match (failure()) { Err(_) => { return 7; } Ok(_) => { return 0; } }
}
fn main() -> i32 {
    match (failure()) { Err(_) => {} Ok(_) => { panic("unexpected success"); } }
    assert(drops == 1, "wildcard statement cleanup");
    let value = match failure() { Err(_) => 3, Ok(_) => 0 };
    assert(value == 3 && drops == 2, "wildcard expression cleanup");
    match (failure()) {
        Err(_) if false => { panic("failed guard executed"); }
        Err(_) => {}
        Ok(_) => { panic("unexpected success"); }
    }
    assert(drops == 3, "guarded wildcard cleanup");
    assert(early_return() == 7 && drops == 4, "wildcard early-return cleanup");
    let packet = Packet.Pair(payload(), payload());
    packet.observe();
    assert(drops == 4, "borrowed wildcard must retain source");
    match (packet) { Pair(_, _) => {} Empty => { panic("missing pair"); } }
    assert(drops == 6, "two discarded payloads need independent cleanup");
    print("std ownership contracts ok");
    return 0;
}
