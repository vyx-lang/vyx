use std.fs;

@[platform("windows")]
extern "C" {
    fn Sleep(ms: i32);
}

@[platform("linux")]
extern "C" {
    fn usleep(usec: i32) -> i32;
}

@[platform("macos")]
extern "C" {
    fn usleep(usec: i32) -> i32;
}

@[platform("windows")]
fn hold_sleep_ms(ms: i32) { Sleep(ms); }

@[platform("linux")]
fn hold_sleep_ms(ms: i32) { usleep(ms * 1000); }

@[platform("macos")]
fn hold_sleep_ms(ms: i32) { usleep(ms * 1000); }

fn main() -> i32 {
    if (appendFile("lock_trace.txt", "begin\n") != 0) { return 1; }
    var waited: i32 = 0;
    while (!fileExists("release_hook") && waited < 30000) {
        hold_sleep_ms(20);
        waited = waited + 20;
    }
    if (!fileExists("release_hook")) { return 3; }
    if (appendFile("lock_trace.txt", "end\n") != 0) { return 2; }
    return 0;
}
