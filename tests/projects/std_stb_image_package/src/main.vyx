module tests.std_stb_image_package;

use std.image;

fn main() -> i32 {
    var src = Image.create(2, 2, 3);
    if (!src.valid || src.width != 2 || src.height != 2 || src.channels != 3) { return 1; }

    let png = "target/stb_stub_probe.png";
    if (!src.savePng(png)) { src.free(); return 2; }

    var loaded = Image.load(png);
    if (!loaded.valid || loaded.width != 2 || loaded.height != 2) {
        src.free();
        loaded.free();
        return 3;
    }

    var scaled = loaded.resize(4, 4);
    if (!scaled.valid || scaled.width != 4 || scaled.height != 4 || scaled.channels != 3) {
        src.free();
        loaded.free();
        scaled.free();
        return 4;
    }

    src.free();
    loaded.free();
    scaled.free();
    print("std.image package ok");
    return 0;
}
