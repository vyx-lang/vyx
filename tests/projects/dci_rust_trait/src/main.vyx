// A *consumer-declared* C-layout record.  The producer never names it in the
// trait declaration; only the layout has to agree, and both sides measure it
// independently (Vyx from the C rule, Rust from `#[repr(C)]`).  12 bytes /
// align 4: measured on the contract side as an *indirect* parameter and *sret*
// return under the Win64 C rules -- the two aggregate-passing paths that are
// not plain registers, which is exactly what makes this a stricter test than
// closing the same trait over `i32`/`i64`/`char`.
@[repr(C)]
struct VyxBox {
    lo: i32;
    mid: i32;
    hi: i32;
}

@[dci_import("../native/native.dcib")]
extern "dci" {
    class native.Sink {
        virtual fn consume(x: i32) -> i32;
    };

    // The same trait family, but produced by a *generic* producer trait.
    //
    // The Vyx side declares the trait ONCE, open, exactly like the open generic
    // functions below and like `struct Pair2<A, B>` in `dci_opengeneric`: the
    // type argument is closed by whoever names an instance, not by whoever
    // writes the import.  `VyxHostG : native.SinkG<i32>` closes it at one type;
    // `VyxHostTG<T> : native.SinkG<T>` closes it once per materialization --
    // `VyxHostTG<i64>` and `VyxHostTG<char>` each need their own reverse
    // override, and each gets exactly one.
    //
    // The open spelling is not the whole story, and pretending otherwise would
    // be a weaker test: the producer physically has one vtable *per instance*
    // (Rust monomorphizes), so a Vyx class can only inherit an instance the
    // producer actually exported (`--export-instance`).  Closing on something
    // absent from the contract fails in codegen with
    // `no dispatch-table base offset ... (owner=native.SinkG::<u8>)`.
    //
    // `i64` (8-byte) and `char` (4-byte Unicode scalar, `char32_t` when
    // lowered) deliberately sit on different register widths than `i32`:
    // reusing the `i32` slot would still pass a test written against `i32`.
    class native.SinkG<T> {
        virtual fn consume(x: T) -> T;
    };

    class native.NativePair {
        public fn flag_of() -> u8;
    };

    class native.NativeDriver {
    };

    fn native_pair_heap() -> *native.NativePair;
    fn native_pair_free(p: *native.NativePair);
    fn native_dispatch(sink: rawptr, x: i32) -> i32;
    fn native_dispatch_generic(sink: rawptr, x: i32) -> i32;
    fn native_dispatch_generic_i64(sink: rawptr, x: i64) -> i64;
    fn native_dispatch_generic_char(sink: rawptr, x: char) -> char;
    fn native_dispatch_generic_box(sink: rawptr, b: VyxBox) -> VyxBox;
    fn native_driver_new(bias: i32) -> *native.NativeDriver;
    fn native_driver_dispatch(drv: *native.NativeDriver, sink: rawptr, x: i32) -> i32;
    fn native_driver_free(p: *native.NativeDriver);
}

class VyxHost : native.Sink {
    VyxHost() {
        let init_marker = 0;
    }

    override fn consume(x: i32) -> i32 {
        return x + 7000;
    }
};

class VyxHostG : native.SinkG<i32> {
    VyxHostG() {
        let init_marker = 0;
    }

    override fn consume(x: i32) -> i32 {
        return x + 9000;
    }
};

// A *generic* Vyx class inheriting the producer's generic trait.  The class
// parameters are what makes the base a per-instance decision: at declaration
// level `VyxHostTG<T>` has no base at all -- only the closed instance
// `VyxHostTG<i32>` has one (`native.SinkG<i32>`), and only that instance owns
// a closed override the foreign stub can dispatch into.  The class body is
// therefore emitted once per materialized instance, as a struct *with* its
// methods, exactly like a non-generic stub class.
class VyxHostTG<T> : native.SinkG<T> {
    VyxHostTG() {
        let init_marker = 0;
    }

    override fn consume(x: T) -> T {
        return x;
    }
};

trait HostView {
    fn host_flag() -> u8;
}

impl HostView for native.NativePair {
    fn host_flag() -> u8 {
        return (self as *native.NativePair).flag_of();
    }
}

fn main() -> i32 {
    {
        var sink = VyxHost();
        if ((sink as *native.Sink).consume(1) != 7001) { return 1; }
        if (native_dispatch(sink as rawptr, 2) != 7032) { return 2; }

        let driver = native_driver_new(30);
        if (native_driver_dispatch(driver, sink as rawptr, 2) != 7032) { return 3; }
        native_driver_free(driver);
    }

    {
        // Reverse override of a *generic* trait instance: the direct virtual
        // call and the cross-boundary dispatch must both reach the override.
        var sink_g = VyxHostG();
        if ((sink_g as *native.SinkG<i32>).consume(1) != 9001) { return 6; }
        if (native_dispatch_generic(sink_g as rawptr, 2) != 9032) { return 7; }
    }

    {
        // The same reverse override, but on a class whose own parameter *is*
        // the base's argument (`VyxHostTG<T> : native.SinkG<T>`).  The base --
        // and the override -- only exist once `T` is closed, so this exercises
        // the per-instance materialization rather than a declaration-level
        // stub class.
        var sink_tg = VyxHostTG::<i32>();
        if ((sink_tg as *native.SinkG<i32>).consume(7) != 7) { return 8; }
        if (native_dispatch_generic(sink_tg as rawptr, 7) != 37) { return 9; }
    }

    {
        // The same generic class closed at a *different* argument.  Nothing
        // about `i64` is special-cased: if the per-instance materialization
        // silently reused the `i32` instantiation, the cross-boundary dispatch
        // would walk the wrong vtable and either return garbage or crash.
        var sink_i64 = VyxHostTG::<i64>();
        let wide: i64 = 70000000000;
        if ((sink_i64 as *native.SinkG<i64>).consume(wide) != wide) { return 10; }
        if (native_dispatch_generic_i64(sink_i64 as rawptr, wide) != wide + 30) { return 11; }
    }

    {
        // `char`: 4 bytes on both sides, but a distinct mangling and a distinct
        // vtable.  'A' is 0x41, so the biased dispatch must land on 0x5F '_'.
        var sink_ch = VyxHostTG::<char>();
        let letter: char = 'A';
        if ((sink_ch as *native.SinkG<char>).consume(letter) != 'A') { return 12; }
        if (native_dispatch_generic_char(sink_ch as rawptr, letter) != '_') { return 13; }
    }

    {
        // The generic trait closed over a *consumer-declared* record.  The
        // base instance is `native.SinkG<VyxBox>`: the round trip proves the
        // two sides agreed on the bytes (a wrong offset shows up as one field
        // reading another, not as a type error), and the biased dispatch
        // proves the call landed on *this* instance's override through the
        // C aggregate ABI (indirect in, sret out) rather than a register
        // shape that happens to work for scalars.
        var sink_box = VyxHostTG::<VyxBox>();
        let b = VyxBox{ lo: 7, mid: 80, hi: 9000 };
        let echoed = (sink_box as *native.SinkG<VyxBox>).consume(b);
        if (echoed.lo != 7 || echoed.mid != 80 || echoed.hi != 9000) { return 14; }
        let biased = native_dispatch_generic_box(sink_box as rawptr, b);
        if (biased.lo != 7 || biased.mid != 80 || biased.hi != 9030) { return 15; }
    }

    {
        let pair = native_pair_heap();
        if (pair.flag_of() != 9) { return 4; }
        if (pair.host_flag() != 9) { return 5; }
        native_pair_free(pair);
    }

    print("dci_rust_trait OK");
    return 0;
}
