use std.core;
use std.uuid;
extern "C" { fn uuid_test_mode(mode: i32); }
fn fails(mode: i32) {
    uuid_test_mode(mode);
    match (Uuid.try_new_v4()) {
        Ok(_) => { panic("failed entropy provider produced a UUID"); }
        Err(failure) => { assert(failure == UuidError.EntropyUnavailable, "entropy failure is explicit"); }
    }
}
@[platform("windows")]
fn platform_checks(value: Uuid) {
    assert(value.toString() == "00010203-0001-4203-8001-020300010203", "OS entropy bytes are used");
}
@[platform("posix")]
fn platform_checks(value: Uuid) {
    assert(value.toString() == "11111111-1111-4111-9111-111111111111", "short reads accumulate");
    uuid_test_mode(3);
    assert(Uuid.try_new_v4().unwrap().toString() == "11111111-1111-4111-9111-111111111111", "EINTR retries");
    fails(4); fails(5);
}
fn main() -> i32 {
    fails(0); fails(1);
    uuid_test_mode(2);
    let value = Uuid.try_new_v4().unwrap();
    assert(value.version() == 4 && value.variant_bits() == 2, "successful entropy version bits");
    platform_checks(value);
    print("std uuid entropy failures ok");
    return 0;
}
