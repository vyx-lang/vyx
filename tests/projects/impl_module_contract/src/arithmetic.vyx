module module_contract.counter;

impl Counter {
    public fn bump(self, delta: i32) {
        self.value = self.value + delta;
    }

    fn hidden(self) -> i32 {
        var private_counter = PrivateCounter { value: self.value };
        return private_counter.amplify();
    }
}

impl PrivateCounter {
    public fn amplify(self) -> i32 {
        return self.value * 7;
    }
}

@[vis(world)]
impl module_contract.counter.PrivateCounter {
    public fn exposed(self) -> i32 {
        return self.value;
    }
}
