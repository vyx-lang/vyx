use std.ref;

fn main() -> i32 {
    var bytes: [u8; 4];
    var data: *u8 = bytes;
    data[0] = 86 as u8;
    data[1] = 89 as u8;
    data[2] = 88 as u8;
    data[3] = 1 as u8;
    if (data[0] != 86 as u8 || data[3] != 1 as u8) { return 1; }

    var owner = Ref::<i64>.new(42);
    var weak = Weak::<i64>.of(owner);
    if (owner.count() != 1) { return 2; }
    {
        var upgraded = weak.upgrade();
        match (upgraded) {
            case Some(value) => {
                if (value.count() != 2) { return 3; }
            }
            case None => { return 4; }
        }
    }

    print("sdk-runtime-contract");
    return 0;
}
