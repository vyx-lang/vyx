module tests.std_ordered_contracts;
use std.core;
use std.collections;
use std.hash;
use std.string;
use std.clone;

var keys_created: i64 = 0;
var keys_dropped: i64 = 0;
var values_created: i64 = 0;
var values_dropped: i64 = 0;
// Deliberately no Clone: search, insertion and removal must only borrow keys.
class Key {
    public number: i64;
    public text: String;
    fn drop(&mut self) { keys_dropped += 1; self.text.drop(); }
}
fn key(number: i64) -> Key {
    keys_created += 1;
    return Key { number: number, text: String.from("owning ordered key exceeds inline string capacity") };
}
impl Ord for Key {
    @[borrow_args]
    fn compare(&self, other: Key) -> i32 {
        assert(self.text.size() > 23 && other.text.size() > 23, "compare borrows live keys");
        if (self.number < other.number) { return -1; }
        if (self.number > other.number) { return 1; }
        return 0;
    }
}
impl Eq for Key {
    @[borrow_args]
    fn operator_eq(&self, other: Key) -> bool { return self.number == other.number; }
}
class Value {
    public number: i64;
    public text: String;
    fn drop(&mut self) { values_dropped += 1; self.text.drop(); }
}
fn value(number: i64) -> Value {
    values_created += 1;
    return Value { number: number, text: String.from("owning ordered value exceeds inline string capacity") };
}
impl Clone for Value { fn clone(&self) -> Value { return value(self.number); } }

fn map_contracts() {
    var map = BTreeMap::<Key, Value>.with_capacity(4);
    var i: i64 = 0;
    while (i < 128) { map.put(key((i * 37) % 128), value((i * 37) % 128)); i += 1; }
    assert(map.size() == 128 && keys_dropped == 0 && values_dropped == 0, "insert transfers without cloning keys");
    let query = key(37);
    assert(map.contains(query) && map.contains_key(query), "repeated borrowed lookup");
    assert(query.text.size() > 23, "lookup preserves query ownership");
    { match (map.get(query)) { Some(copy) => { assert(copy.number == 37 && copy.text.size() > 23, "get returns owned clone"); } None => { panic("missing key"); } } }
    assert(values_dropped == 1, "only returned clone has died");
    map.put(key(37), value(1037));
    assert(keys_dropped == 1 && values_dropped == 2, "replacement releases redundant key and old value");
    let pointer = map.get_ptr(query);
    assert((*pointer).number == 1037, "borrowed pointer sees replacement");
    assert(map.remove(query) && !map.remove(query), "remove borrows query on hit and miss");
    assert(query.number == 37 && query.text.size() > 23, "removal retains caller query");
    assert(keys_dropped == 2 && values_dropped == 3, "removal destroys stored owners");
    i = 0;
    while (i < map.size()) {
        let stored = map.keys.get_ptr(i);
        let expected = if (i < 37) { i } else { i + 1 };
        assert((*stored).number == expected, "keys remain in sorted order");
        i += 1;
    }
    map.clear();
    map.put(key(1000), value(1000));
    map.destroy(); map.destroy();
}

fn set_contracts() {
    var set = BTreeSet::<Key>.new();
    assert(set.insert(key(3)) && set.add(key(1)) && set.insert(key(2)), "ordered set insertion");
    assert(!set.insert(key(2)), "duplicate set value is consumed and released");
    let query = key(2);
    assert(set.contains(query) && set.contains(query), "set membership borrows move-only query");
    assert(set.remove(query) && !set.remove(query), "set removal borrows move-only query");
    assert(query.text.size() > 23 && set.size() == 2, "query remains live");
    set.clear(); set.add(key(9)); set.destroy(); set.destroy();
}

fn clone_contracts() {
    var map = BTreeMap::<string, Value>.new();
    map.put("a\0z".clone(), value(2)); map.put("a\0b".clone(), value(1));
    { match (map.first_key()) { Some(first) => { assert(first == "a\0b", "binary smallest key"); } None => { panic("empty map"); } } }
    { match (map.last_key()) { Some(last) => { assert(last == "a\0z", "binary largest key"); } None => { panic("empty map"); } } }
    { var copy = map.clone(); assert(copy.remove("a\0z") && map.contains("a\0z"), "map clone owns independent storage"); }
    var set = BTreeSet::<string>.new(); set.add("b".clone()); set.add("a".clone());
    { let copy = set.clone(); assert(copy.size() == 2, "set clone"); }
    { match (set.min()) { Some(first) => { assert(first == "a", "set minimum"); } None => { panic("empty set"); } } }
    { match (set.max()) { Some(last) => { assert(last == "b", "set maximum"); } None => { panic("empty set"); } } }
}

fn main() -> i32 {
    map_contracts(); set_contracts(); clone_contracts();
    assert(keys_created == keys_dropped, "all ordered keys drop exactly once");
    assert(values_created == values_dropped, "all ordered values drop exactly once");
    print("std ordered contracts ok");
    return 0;
}
