module tests.std_text_contracts;
use std.string;
use std.hash;
fn main() -> i32 {
    let left = "a\0b";
    let right = "a\0c";
    assert(!str_equals(left, right), "bytes after NUL affect equality");
    assert(str_compare(left, right) < 0, "bytes after NUL affect ordering");
    assert(!str_starts_with(left, right), "NUL prefix comparison");
    assert(!str_ends_with(left, right), "NUL suffix comparison");
    assert(str_index_of(left, "\0b") == 1, "search across NUL");
    assert(str_contains(left, "b"), "search after NUL");
    let replaced = str_replace(left, "\0b", "!");
    assert(replaced == "a!", "binary replacement");
    str_drop(replaced);
    let storage = String.from("abcdef");
    let view = str_substring(storage.as_str(), 0, 3);
    assert(str_index_of(view, "def") == -1, "search must respect view length");
    assert(!str_contains(view, "cd"), "search must not cross view end");
    assert(str_index_of(view, "bc") == 1, "search within view");
    assert(str_equals(view, "abc"), "unterminated view equality");
    assert(str_index_of("", "") == 0, "empty substring");
    assert(str_starts_with("", "") && str_ends_with("", ""), "empty affixes");
    print("std text contracts ok");
    return 0;
}
