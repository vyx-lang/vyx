module tests.std_owned_collections;
use std.collections;
use std.core;
use std.clone;
use std.string;
use std.hash;
var created: i64 = 0;
var dropped: i64 = 0;
class Item {
    public id: i64;
    public text: String;
    fn drop(&mut self) { dropped += 1; self.text.drop(); }
}
fn item(id: i64) -> Item {
    created += 1;
    return Item { id: id, text: String.from("owned collection value exceeding inline String capacity") };
}
impl Clone for Item { fn clone(&self) -> Item { return item(self.id); } }
impl Eq for Item {
    @[borrow_args]
    fn operator_eq(&self, other: Item) -> bool { return self.id == other.id; }
}

fn set_contracts() {
    var values = Set::<Item>.new();
    var i: i64 = 0;
    while (i < 40) { values.add(item(i)); i += 1; }
    values.add(item(7));
    assert(values.len == 40, "Set duplicate insertion");
    {
        let needle = item(7);
        assert(values.contains(needle), "Set owning membership");
        values.remove(needle);
        assert(!values.contains(needle), "Set owning removal");
    }
    { let copy = values.clone(); assert(copy.len == 39, "Set owning clone"); }
    values.clear();
    values.add(item(100));
    values.destroy();
    values.destroy();
}

fn deque_contracts() {
    var values = Deque::<Item>.new();
    var i: i64 = 0;
    while (i < 64) { values.push_back(item(i)); i += 1; }
    i = 0;
    while (i < 20) { let value = values.pop_front(); assert(value.id == i, "std_owned_collections/main.vyx:24"); i += 1; }
    i = 64;
    while (i < 100) { values.push_back(item(i)); i += 1; }
    values.push_front(item(-1));
    { let copy = values.peek_front(); assert(copy.id == -1, "std_owned_collections/main.vyx:28"); }
    { let copy = values.peek_back(); assert(copy.id == 99, "std_owned_collections/main.vyx:29"); }
    { let copy = values.get(1); assert(copy.id == 20, "std_owned_collections/main.vyx:30"); }
    { let copy = values.clone(); assert(copy.len == 81, "std_owned_collections/main.vyx:31"); }
    values.set(1, item(1020));
    assert((*values.get_ptr(1)).text.size() > 23, "std_owned_collections/main.vyx:33");
    var iter = values.iter();
    var count: i64 = 0;
    while (iter.has_next()) {
        match (iter.next()) { Some(value) => { assert(value.text.size() > 23, "std_owned_collections/main.vyx:37"); count += 1; } None => { panic("iterator ended early"); } }
    }
    assert(count == 81, "std_owned_collections/main.vyx:39");
    values.clear();
    values.push_back(item(200));
    { let moved = values.pop_back(); assert(moved.id == 200, "std_owned_collections/main.vyx:42"); }
    values.destroy();
    values.destroy();
}
fn list_contracts() {
    var values = List::<Item>.new();
    var i: i64 = 0;
    while (i < 35) { values.push_back(item(i)); i += 1; }
    values.push_front(item(-1));
    { let copy = values.front(); assert(copy.id == -1, "std_owned_collections/main.vyx:51"); }
    { let copy = values.back(); assert(copy.id == 34, "std_owned_collections/main.vyx:52"); }
    { let copy = values.get(2); assert(copy.id == 1, "std_owned_collections/main.vyx:53"); }
    { let copy = values.clone(); assert(copy.len == 36, "std_owned_collections/main.vyx:54"); }
    values.set(2, item(1001));
    { let moved = values.pop_front(); assert(moved.id == -1, "std_owned_collections/main.vyx:56"); }
    { let moved = values.pop_back(); assert(moved.id == 34, "std_owned_collections/main.vyx:57"); }
    var iter = values.iter();
    var count: i64 = 0;
    while (iter.has_next()) {
        match (iter.next()) { Some(value) => { assert(value.text.size() > 23, "std_owned_collections/main.vyx:61"); count += 1; } None => { panic("iterator ended early"); } }
    }
    assert(count == 34, "std_owned_collections/main.vyx:63");
    values.clear();
    values.push_front(item(300));
    values.destroy();
    values.destroy();
}
fn slice_contracts() {
    var values = Vec::<Item>.new();
    values.push(item(1)); values.push(item(2));
    let view = Slice::<Item>.from_vec(values);
    { let copy = view.get(0); assert(copy.id == 1, "std_owned_collections/main.vyx:73"); }
    { match (view.at(1)) { Some(copy) => { assert(copy.id == 2, "std_owned_collections/main.vyx:74"); } None => { panic("slice missing"); } } }
    assert((*values.get_ptr(0)).text.size() > 23, "std_owned_collections/main.vyx:75");
    assert(view.sub_slice(100, 200).len == 0, "std_owned_collections/main.vyx:76");
    assert(view.sub_slice(-1, 1).len == 1, "std_owned_collections/main.vyx:77");
    let binary = "A\0B";
    let text_view = StringView.from_string(binary);
    let copy = text_view.to_string();
    assert(copy.size() == 3 && copy.byteAt(2) == 66, "std_owned_collections/main.vyx:81");
    assert(text_view.sub_view(100, 200).len == 0, "std_owned_collections/main.vyx:82");
}
fn main() -> i32 {
    deque_contracts(); assert(created == dropped, "std_owned_collections/main.vyx:85");
    list_contracts(); assert(created == dropped, "std_owned_collections/main.vyx:86");
    slice_contracts(); assert(created == dropped, "std_owned_collections/main.vyx:87");
    set_contracts(); assert(created == dropped, "Set resource balance");
    print("std owning collections contracts ok");
    return 0;
}
