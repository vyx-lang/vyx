@[dci_import("../contracts/A.dcib")]
extern "cpp" {
    fn make_poly_derived() -> *PolyBase;
    fn destroy_poly_base(value: *PolyBase);

    class PolyBase {
        virtual ~PolyBase();
        virtual fn add(value: i32) -> i32;
        virtual fn add(value: f64) -> i32;
        virtual fn mul(value: i32) -> i32;
    };
}

fn main() -> i32 {
    let value = make_poly_derived();
    if (value == null) { return 1; }
    if (value.add(5) != 105) { return 2; }
    if (value.add(2.5) != 502) { return 3; }
    if (value.mul(3) != 60) { return 4; }
    destroy_poly_base(value);
    print("dci_virtual_dispatch OK");
    return 0;
}
