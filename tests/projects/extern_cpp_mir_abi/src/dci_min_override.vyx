@[cpp_include("A.hpp")]
extern "cpp" {
    fn make_poly_derived() -> *PolyBase;
    fn destroy_poly_base(p: *PolyBase);
    fn call_poly_add(p: *PolyBase, x: i32) -> i32;

    class PolyBase {
        PolyBase();
        virtual fn add(x: i32) -> i32;
        virtual fn mul(x: i32) -> i32;
    };

    class PolyDerived : PolyBase {
        PolyDerived();
        override final fn add(x: i32) -> i32;
        override final fn mul(x: i32) -> i32;
    };
}

fn main() -> i32 {
    let p = make_poly_derived();
    let r = call_poly_add(p, 5);
    destroy_poly_base(p);
    if (r != 105) {
        return 1;
    }
    return 0;
}
