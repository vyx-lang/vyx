@[dci_import("../contracts/A.dcib")]
@[cpp_include("A.hpp")]
extern "cpp" {
    fn call_abstract(p: *AbstractOp, x: i32) -> i32;

    class AbstractOp {
        AbstractOp();
        virtual ~AbstractOp();
        virtual fn eval(x: i32) -> i32;
    };
}

class TemporaryVyxOp : AbstractOp {
    TemporaryVyxOp() {
        let init_marker = 0;
    }

    override fn eval(x: i32) -> i32 {
        return x + 1000;
    }
};

fn main() -> i32 {
    TemporaryVyxOp();
    return 0;
}
