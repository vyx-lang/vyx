    };

    class dci_ns.NsDerived : dci_ns.NsBox {
        NsDerived(x: i32);
        override ~NsDerived();
        override fn virt(x: i32) -> i32;
    };
}

class B:A{
    B(){
        self.data=9999;
    }
    B(label: string){
        self.data=1234;
    }
};

class VyxPoly : PolyBase {
    VyxPoly() {
        let init_marker = 0;
    }

    override fn add(x: i32) -> i32 {
        return x + 700;
    }

    override fn add(x: f64) -> i32 {
        return (x as i32) + 800;
    }

    override fn mul(x: i32) -> i32 {
        return x * 70;
    }
};

class VyxOp : AbstractOp {
    VyxOp() {
        let init_marker = 0;
    }

    override fn eval(x: i32) -> i32 {
        return x + 900;
    }
};

fn dce_dci_call_and_drop_must_survive() -> i32 {
    let destroyed_before = destroyed_a_count();
    {
        var probe = A(1);
        probe.func();
        if (probe.add(0) != 101) { return 1; }
    }
    if (destroyed_a_count() <= destroyed_before) { return 2; }
    return 0;
}

fn select_dci_call_must_stay_branch(flag: bool) -> i32 {
    var probe = A(0);
    let selected: i32 = if (flag) {
        probe.add(1);
    } else {
        probe.add(2);
    };
    return selected;
}

