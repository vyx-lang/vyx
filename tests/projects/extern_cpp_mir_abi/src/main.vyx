        public static fn bump(x: f64) -> i32;
        public static fn read_ptr(p: *A) -> i32;
        public fn func(self, param: i32) {
            self.data = param;
            self.func();
        }
    };

    class NativeDerived : A {
        NativeDerived();
        NativeDerived(x: i32);
        override ~NativeDerived();
        public fn add(x: i32) -> i32;
        public fn add(x: f64) -> i32;
    };

    class LeftPad {
        LeftPad();
        virtual ~LeftPad();
        public pad: i32;
