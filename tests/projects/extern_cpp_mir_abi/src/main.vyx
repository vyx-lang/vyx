    b.func();
    if (b.add(0) != 102) { return 4; }
    var c=B();
    if (c.data != 9999) { return 5; }
    var c2=B("typed constructor");
    if (c2.data != 1234) { return 12; }

    let destroyed_single_scope0 = destroyed_a_count();
    {
        var scoped_a = A(77);
        if (scoped_a.add(1) != 78) { return 28; }
    }
    if (destroyed_a_count() <= destroyed_single_scope0) { return 29; }

    var nd = NativeDerived(30);
    if (nd.add(2) != 1032) { return 6; }
    if (nd.add(2.5) != 3032) { return 17; }
    nd.func();
    if (nd.add(0) != 1130) { return 18; }

    var rd = RightDerived(60);
    if (rd.data != 60) { return 31; }
    rd.func();
    if (rd.data != 160) { return 32; }
    if (rd.add(5) != 165) { return 33; }
    if (rd.own() != 860) { return 34; }
