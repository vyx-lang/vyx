    };

    class PolyBase {
        PolyBase();
        virtual ~PolyBase();
        virtual fn add(x: i32) -> i32;
        virtual fn add(x: f64) -> i32;
        virtual fn mul(x: i32) -> i32;
    };

    class PolyDerived : PolyBase {
        PolyDerived();
        override ~PolyDerived();
