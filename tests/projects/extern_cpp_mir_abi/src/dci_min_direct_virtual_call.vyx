@[cpp_include("A.hpp")]
extern "cpp" {
    class PolyBase {
        PolyBase();
        virtual fn add(x: i32) -> i32;
    };

    class PolyDerived : PolyBase {
        PolyDerived();
        override final fn add(x: i32) -> i32;
    };
}

fn main() -> i32 {
    var d = PolyDerived();
    if (d.add(5) != 105) {
        return 1;
    }
    return 0;
}
