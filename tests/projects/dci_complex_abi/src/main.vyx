@[dci_import("../contracts/Complex.dcib")]
extern "dci" {
    class abi_complex.RegisterPair {
        public first: i32;
        public second: i32;
    };

    fn complex_make_register_pair(first: i32, second: i32) -> abi_complex.RegisterPair;
    fn complex_offset_register_pair(value: abi_complex.RegisterPair, delta: i32) -> abi_complex.RegisterPair;
    fn complex_register_pair_score(value: abi_complex.RegisterPair) -> i32;

    class abi_complex.LeftBase {
        LeftBase();
        LeftBase(x: i32);
        virtual ~LeftBase();
        public l: i32;
        virtual fn left_virtual(x: i32) -> i32;
        public fn left_plain(x: i32) const -> i32;
    };

    class abi_complex.RightBase {
        RightBase();
        RightBase(x: i32);
        virtual ~RightBase();
        public r: i32;
        virtual fn right_virtual(x: i32) -> i32;
        public fn right_plain(x: i32) const -> i32;
    };

    class abi_complex.Multi : abi_complex.LeftBase, abi_complex.RightBase {
        Multi(x: i32);
        override ~Multi();
        public own: i32;
        override final fn left_virtual(x: i32) -> i32;
        override final fn right_virtual(x: i32) -> i32;
        public fn own_value() const -> i32;
        public static fn destroyed_count() -> i32;
    };

    class abi_complex.BigState {
        BigState();
        BigState(seed: i32);
        ~BigState();
        public a: i64;
        public b: i64;
        public c: i64;
        public d: i64;
        public fn sum() const -> i64;
        public fn mutate(delta: i32);
        public static fn destroyed_count() -> i32;
    };

    class abi_complex.VecBox {
        VecBox();
        VecBox(seed: i32);
        ~VecBox();
        public fn size() const -> i32;
        public fn at(index: i32) const -> i32;
        public fn push(value: i32);
        public static fn destroyed_count() -> i32;
    };

    class abi_complex.AbstractSink {
        AbstractSink();
        virtual ~AbstractSink();
        virtual fn consume(x: i32) -> i32;
        public static fn destroyed_count() -> i32;
    };

    class abi_complex.NativeDriver {
        NativeDriver(bias: i32);
        ~NativeDriver();
        public bias: i32;
        public fn dispatch(sink: *abi_complex.AbstractSink, x: i32) const -> i32;
    };
}

class VyxSink : abi_complex.AbstractSink {
    VyxSink() {
        let init_marker = 0;
    }

    override fn consume(x: i32) -> i32 {
        return x + 7000;
    }
};

fn main() -> i32 {
    // No user-authored C ABI bridge is involved: DCI supplies layouts, base
    // offsets, mangled symbols, vtable slots, destructors, and callback stubs.
    let destroyed_multi0 = abi_complex.Multi.destroyed_count();
    {
        var m = abi_complex.Multi(5);
        if (m.r != 25) { return 1; }
        if (m.own != 35) { return 2; }

        if ((m as *abi_complex.LeftBase).left_plain(1) != 16) { return 3; }
        if ((m as *abi_complex.RightBase).right_plain(1) != 26) { return 4; }
        if ((m as *abi_complex.LeftBase).left_virtual(2) != 1052) { return 5; }
        if ((m as *abi_complex.RightBase).right_virtual(3) != 2063) { return 6; }
        if (m.own_value() != 75) { return 7; }
        if ((m as *abi_complex.LeftBase).left_virtual(4) != 1054) { return 8; }
        if ((m as *abi_complex.RightBase).right_virtual(5) != 2065) { return 9; }
    }
    if (abi_complex.Multi.destroyed_count() != destroyed_multi0 + 1) { return 10; }

    let destroyed_big0 = abi_complex.BigState.destroyed_count();
    {
        var big = abi_complex.BigState(10);
        if (big.a != 10) { return 11; }
        if (big.d != 13) { return 12; }
        if (big.sum() != 46) { return 13; }

        big.mutate(5);
        if (big.sum() != 66) { return 14; }
        big.mutate(2);
        if ((big as *abi_complex.BigState).sum() != 74) { return 15; }
    }
    if (abi_complex.BigState.destroyed_count() != destroyed_big0 + 1) { return 16; }

    let destroyed_vecbox0 = abi_complex.VecBox.destroyed_count();
    {
        // VecBox contains std::vector<int>; DCI still constructs, calls, and
        // destroys it by value without exposing an opaque C handle.
        var vb = abi_complex.VecBox(3);
        if (vb.size() != 2) { return 17; }
        if (vb.at(0) != 3) { return 18; }
        if (vb.at(1) != 4) { return 19; }

        vb.push(8);
        if ((vb as *abi_complex.VecBox).size() != 3) { return 20; }
        if ((vb as *abi_complex.VecBox).at(2) != 8) { return 21; }
    }
    if (abi_complex.VecBox.destroyed_count() != destroyed_vecbox0 + 1) { return 22; }

    let destroyed_sink0 = abi_complex.AbstractSink.destroyed_count();
    {
        // The compiler creates the concrete C++ stub and callback thunk.
        var sink = VyxSink();
        if ((sink as *abi_complex.AbstractSink).consume(1) != 7001) { return 23; }

        // NativeDriver is ordinary C++ code calling the Vyx override through
        // AbstractSink's vtable; no user-authored callback table is needed.
        var driver = abi_complex.NativeDriver(30);
        if (driver.bias != 30) { return 24; }
        if (driver.dispatch(sink as *abi_complex.AbstractSink, 2) != 7032) { return 25; }
    }
    if (abi_complex.AbstractSink.destroyed_count() != destroyed_sink0 + 1) { return 26; }

    // The 8-byte C++ record crosses DCI in registers in both directions.
    let pair = complex_make_register_pair(12, 34);
    if (pair.first != 12) { return 27; }
    if (pair.second != 34) { return 28; }
    if (complex_register_pair_score(pair) != 1234) { return 29; }

    let shifted = complex_offset_register_pair(pair, 5);
    if (shifted.first != 17) { return 30; }
    if (shifted.second != 29) { return 31; }
    if (complex_register_pair_score(shifted) != 1729) { return 32; }

    print("dci_complex_abi OK");
    return 0;
}
