@[dci_import("../contracts/DciStress.dcib")]
@[cpp_include("DciStress.hpp")]
extern "cpp" {
    type dci_stress.Color = i32;

    fn color_value(c: dci_stress.Color) -> i32;
    fn make_color(v: i32) -> dci_stress.Color;
    fn read_const_i32_ref(x: &i32) -> i32;
    fn add_i32_ref(x: &mut i32, delta: i32);
    fn refbox_ref_sum(box: &dci_stress.RefBox, other: &dci_stress.RefBox) -> i32;
    fn template_box_sum(box: &dci_stress.IntTemplateBox, extra: i32) -> i32;
    fn template_box_mutate(box: *dci_stress.IntTemplateBox, delta: i32) -> i32;
    fn template_box_alias_sum(box: &dci_stress.IntTemplateBoxAlias, extra: i32) -> i32;
    fn tagged_box_sum(box: &dci_stress.TaggedIntBox, extra: i32) -> i32;
    fn tagged_box_alias_sum(box: &dci_stress.TaggedIntBoxAlias, extra: i32) -> i32;
    fn poly_calc_base(box: *dci_stress.IntTemplatePolyBase, x: i32) -> i32;
    fn poly_calc_derived(box: *dci_stress.IntTemplatePoly, x: i32) -> i32;
    fn int_vector_new() -> *dci_stress.IntVector;
    fn int_vector_delete(v: *dci_stress.IntVector);
    fn int_vector_push(v: *dci_stress.IntVector, value: i32);
    fn int_vector_get(v: *dci_stress.IntVector, index: i32) -> i32;
    fn int_vector_size(v: *dci_stress.IntVector) -> i32;
    fn call_root_value(p: *dci_stress.VRoot, x: i32) -> i32;
    fn call_left_root(p: *dci_stress.VLeft, x: i32) -> i32;
    fn call_right_root(p: *dci_stress.VRight, x: i32) -> i32;
    fn bitpack_sum_ptr(p: *dci_stress.BitPack) -> i32;

    class dci_stress.RefBox {
        RefBox();
        RefBox(x: i32);
        ~RefBox();
        public value: i32;
        public fn read_ref(x: &i32) const -> i32;
        public fn add_ref(x: &mut i32, delta: i32) const;
        public fn self_ref_sum(other: &dci_stress.RefBox) const -> i32;
        public fn assign_value(x: i32) -> &mut dci_stress.RefBox;
    };

    class dci_stress.IntTemplateBox {
        IntTemplateBox();
        IntTemplateBox(x: i32);
        ~IntTemplateBox();
        public value: i32;
        public fn get() const -> i32;
        public fn set(x: i32);
        public fn add_assign(x: i32) -> &mut dci_stress.IntTemplateBox;
    };

    class dci_stress.IntTemplateBoxAlias {
        IntTemplateBoxAlias();
        IntTemplateBoxAlias(x: i32);
        ~IntTemplateBoxAlias();
        public value: i32;
        public fn get() const -> i32;
        public fn set(x: i32);
        public fn add_assign(x: i32) -> &mut dci_stress.IntTemplateBoxAlias;
    };

    class dci_stress.TaggedIntBox {
        TaggedIntBox();
        TaggedIntBox(value: i32, tag: i32);
        ~TaggedIntBox();
        public value: i32;
        public tag: i32;
        public fn get() const -> i32;
        public fn tag_value() const -> i32;
        public fn mix(extra: i32) const -> i32;
        public fn set_pair(value: i32, tag: i32) -> &mut dci_stress.TaggedIntBox;
    };

    class dci_stress.TaggedIntBoxAlias {
        TaggedIntBoxAlias();
        TaggedIntBoxAlias(value: i32, tag: i32);
        ~TaggedIntBoxAlias();
        public value: i32;
        public tag: i32;
        public fn get() const -> i32;
        public fn tag_value() const -> i32;
        public fn mix(extra: i32) const -> i32;
        public fn set_pair(value: i32, tag: i32) -> &mut dci_stress.TaggedIntBoxAlias;
    };

    class dci_stress.IntTemplatePolyBase {
        IntTemplatePolyBase();
        IntTemplatePolyBase(base: i32);
        virtual ~IntTemplatePolyBase();
        public base: i32;
        virtual fn calc(x: i32) -> i32;
    };

    class dci_stress.IntTemplatePoly : dci_stress.IntTemplatePolyBase {
        IntTemplatePoly();
        IntTemplatePoly(base: i32);
        override ~IntTemplatePoly();
        public extra: i32;
        override final fn calc(x: i32) -> i32;
        public fn total() const -> i32;
    };

    class dci_stress.IntVector {
    };

    class dci_stress.OpBox {
        OpBox();
        OpBox(seed: i32);
        ~OpBox();
        public fn operator[](index: i32) const -> i32;
        public fn operator+(rhs: i32) const -> i32;
        public fn operator==(rhs: &dci_stress.OpBox) const -> i32;
        public fn sum() const -> i32;
        public fn set(index: i32, value: i32);
    };

    struct dci_stress.BitPack {
        BitPack();
        BitPack(seed: i32);
        public a: u32;
        public b: u32;
        public c: u32;
        public tail: i32;
        public fn sum() const -> i32;
        public fn set(na: u32, nb: u32, nc: u32, ntail: i32);
    };

    class dci_stress.VRoot {
        VRoot();
        VRoot(x: i32);
        virtual ~VRoot();
        public root: i32;
        virtual fn value(x: i32) -> i32;
    };

    class dci_stress.VLeft : dci_stress.VRoot {
        VLeft();
        VLeft(x: i32);
        override ~VLeft();
        public left: i32;
        public fn left_only() const -> i32;
    };

    class dci_stress.VRight : dci_stress.VRoot {
        VRight();
        VRight(x: i32);
        override ~VRight();
        public right: i32;
        public fn right_only() const -> i32;
    };

    class dci_stress.VDiamond : dci_stress.VLeft, dci_stress.VRight {
        VDiamond();
        VDiamond(x: i32);
        override ~VDiamond();
        public own: i32;
        override final fn value(x: i32) -> i32;
        virtual fn total() const -> i32;
    };
}

fn main() -> i32 {
    var c = make_color(2);
    if (color_value(c) != 20) { return 1; }

    var x = 5;
    if (read_const_i32_ref(&x) != 105) { return 2; }
    add_i32_ref(&mut x, 7);
    if (x != 212) { return 3; }

    var rb = dci_stress.RefBox(10);
    var rb2 = dci_stress.RefBox(20);
    if (rb.value != 10) { return 4; }
    if (rb.read_ref(&x) != 222) { return 5; }
    rb.add_ref(&mut x, 3);
    if (x != 225) { return 6; }
    if (rb.self_ref_sum(&rb2) != 30) { return 7; }
    if (refbox_ref_sum(&rb, &rb2) != 330) { return 8; }
    rb.assign_value(44);
    if (rb.value != 44) { return 9; }

    var tb = dci_stress.IntTemplateBox(7);
    if (tb.value != 7) { return 27; }
    if (tb.get() != 7) { return 28; }
    tb.set(11);
    if (tb.get() != 11) { return 29; }
    tb.add_assign(5);
    if (tb.value != 16) { return 30; }
    if (template_box_sum(&tb, 4) != 120) { return 31; }
    if (template_box_mutate(tb as *dci_stress.IntTemplateBox, 3) != 219) { return 32; }

    var tba = dci_stress.IntTemplateBoxAlias(12);
    if (tba.value != 12) { return 33; }
    if (tba.get() != 12) { return 34; }
    tba.add_assign(5);
    if (template_box_alias_sum(&tba, 8) != 325) { return 35; }

    var tagged = dci_stress.TaggedIntBox(4, 9);
    if (tagged.value != 4) { return 36; }
    if (tagged.tag != 9) { return 37; }
    if (tagged.get() != 4) { return 38; }
    if (tagged.tag_value() != 9) { return 39; }
    if (tagged.mix(3) != 16) { return 40; }
    tagged.set_pair(6, 10);
    if (tagged_box_sum(&tagged, 2) != 518) { return 41; }

    var tagged_alias = dci_stress.TaggedIntBoxAlias(8, 5);
    if (tagged_alias.mix(7) != 20) { return 42; }
    if (tagged_box_alias_sum(&tagged_alias, 7) != 720) { return 43; }

    var poly_base = dci_stress.IntTemplatePolyBase(5);
    if (poly_base.base != 5) { return 44; }
    if (poly_base.calc(2) != 107) { return 45; }
    if (poly_calc_base(poly_base as *dci_stress.IntTemplatePolyBase, 3) != 108) { return 46; }

    var poly = dci_stress.IntTemplatePoly(10);
    if (poly.base != 10) { return 47; }
    if (poly.extra != 15) { return 48; }
    if (poly.total() != 25) { return 49; }
    if (poly.calc(3) != 1028) { return 50; }
    if (poly_calc_derived(poly as *dci_stress.IntTemplatePoly, 4) != 1029) { return 51; }
    if (poly_calc_base(poly as *dci_stress.IntTemplatePolyBase, 5) != 1030) { return 52; }

    var vec = int_vector_new();
    int_vector_push(vec, 5);
    int_vector_push(vec, 7);
    if (int_vector_size(vec) != 2) { return 53; }
    if (int_vector_get(vec, 0) != 5) { return 54; }
    if (int_vector_get(vec, 1) != 7) { return 55; }
    int_vector_delete(vec);

    var op = dci_stress.OpBox(3);
    if (op[0] != 3) { return 10; }
    if (op[3] != 6) { return 11; }
    if ((op + 10) != 28) { return 12; }
    op.set(1, 20);
    if (op.sum() != 34) { return 13; }
    var op2 = dci_stress.OpBox(3);
    if ((op == &op2) != 0) { return 14; }

    var bits = dci_stress.BitPack(5);
    if (bits.sum() != 26) { return 15; }
    if (bits.a != 5) { return 56; }
    if (bits.b != 6) { return 57; }
    if (bits.c != 7) { return 58; }
    if (bits.tail != 8) { return 59; }

    bits.a = 2;
    bits.b = 29;
    bits.c = 61;
    bits.tail = 12;
    if (bitpack_sum_ptr(bits as *dci_stress.BitPack) != 104) { return 60; }

    bits.set(7, 31, 63, 9);
    if (bits.sum() != 110) { return 16; }
    if (bitpack_sum_ptr(bits as *dci_stress.BitPack) != 110) { return 17; }
    if (bits.a != 7) { return 61; }
    if (bits.b != 31) { return 62; }
    if (bits.c != 63) { return 63; }
    if (bits.tail != 9) { return 64; }

    var vd = dci_stress.VDiamond(10);
    if (vd.root != 10) { return 18; }
    if (vd.left != 30) { return 19; }
    if (vd.right != 50) { return 20; }
    if (vd.own != 40) { return 21; }
    if (vd.total() != 130) { return 22; }
    if (vd.value(1) != 1131) { return 23; }
    if (call_root_value(vd as *dci_stress.VRoot, 2) != 1132) { return 24; }
    if (call_left_root(vd as *dci_stress.VLeft, 3) != 1133) { return 25; }
    if (call_right_root(vd as *dci_stress.VRight, 4) != 1134) { return 26; }

    let left_view = vd as *dci_stress.VLeft;
    let root_via_left = left_view as *dci_stress.VRoot;
    if (call_root_value(root_via_left, 5) != 1135) { return 65; }

    let right_view = vd as *dci_stress.VRight;
    let root_via_right = right_view as *dci_stress.VRoot;
    if (call_root_value(root_via_right, 6) != 1136) { return 66; }

    print("dci_abi_stress OK");
    return 0;
}
