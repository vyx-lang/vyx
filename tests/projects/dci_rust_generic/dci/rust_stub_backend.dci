{
  "$schema": "../../../../tools/dci/schema/dci-1.0.schema.json",
  "dci": "1.0",
  "kind": "abi",
  "profile": {
    "id": "native-object-v1",
    "version": "1.0",
    "level": "L1",
    "consumer_modes": ["direct", "stub"],
    "features": ["functions", "external_stub_backend"]
  },
  "source": {
    "language": "rust",
    "compiler": { "name": "rustc", "version": "1.92.0" },
    "adapter": { "name": "dci-rust-stub-fixture", "version": "1.0" },
    "inputs": ["normalized descriptor only"]
  },
  "target": {
    "triple": "x86_64-pc-windows-msvc",
    "architecture": "x86_64",
    "pointer_width": 64,
    "endianness": "little",
    "object_format": "coff",
    "environment": "msvc",
    "abi_family": "msvc"
  },
  "control_flow": {
    "default_boundary": "no_unwind",
    "propagation": { "mode": "forbidden" },
    "failure_channels": ["return_value"]
  },
  "exports": {
    "aliases": [],
    "layouts": [],
    "symbols": [
      {
        "name": "dci_rust_stub_add",
        "semantic_id": "fixture.external_stub.add_900",
        "link_name": "dci_rust_stub_add",
        "kind": "function",
        "calling_convention": "system",
        "linkage": "external",
        "visibility": "public",
        "params": [
          {
            "name": "value",
            "type": {
              "name": "i32",
              "kind": "primitive",
              "nullable": false,
              "reference": "value"
            },
            "location": "abi",
            "ownership": "copy"
          }
        ],
        "return": {
          "type": {
            "name": "i32",
            "kind": "primitive",
            "nullable": false,
            "reference": "value"
          },
          "location": "abi",
          "ownership": "copy"
        },
        "abi": {
          "calling_convention": "system",
          "variadic": false,
          "parameters": [
            { "index": 0, "passing": "direct", "size": 4 }
          ],
          "return": { "passing": "direct", "size": 4 }
        },
        "control_flow": {
          "default_boundary": "no_unwind",
          "propagation": { "mode": "forbidden" }
        }
      }
    ],
    "calling_conventions": [
      {
        "name": "system",
        "this_pointer": null,
        "description": "Target system calling convention"
      }
    ],
    "dispatch_tables": [],
    "runtime_type_operations": []
  }
}
