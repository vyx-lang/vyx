extern "dci" {
    struct dci_rust.Flags {
        public storage: u32;
        public priority: u32;
        public enabled: u32;
    };

    struct dci_rust.BitfieldProbe {
        public prefix: u32;
        public signed_msb: i32;
    };

    fn dci_rust_flags_make(priority: u32, enabled: i32) -> dci_rust.Flags;
    fn dci_rust_bitfield_probe_make(value: i32) -> dci_rust.BitfieldProbe;
}

fn main() -> i32 {
    var flags = dci_rust_flags_make(5, 1);
    if (flags.priority != 5) { return 1; }
    if (flags.enabled != 1) { return 2; }

    flags.priority = 2;
    if (flags.storage != 10) { return 3; }
    flags.enabled = 0;
    if (flags.storage != 2) { return 4; }

    var probe = dci_rust_bitfield_probe_make(-3);
    if (probe.prefix != 305419896) { return 5; }
    if (probe.signed_msb != -3) { return 6; }
    probe.signed_msb = -2;
    if (probe.signed_msb != -2) { return 7; }

    print("dci_bitfield_contracts OK");
    return 0;
}
