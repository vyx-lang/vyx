extern "dci" {
    struct dci_rust.Packet {
        public total: i64;
        public tag: i64;
    };

    struct dci_rust.Flags {
        public storage: u32;
    };

    struct dci_rust.AlignedPair {
        public low: u64;
        public high: u64;
    };

    struct dci_rust.BitfieldProbe {
        public prefix: u32;
        public signed_msb: i32;
    };

    class dci_rust.RuntimeBase {
        public kind: i32;
        public value: i32;
    };

    class dci_rust.RuntimeDerived : dci_rust.RuntimeBase {
        public prefix: i64;
        public extra: i32;
    };

    fn dci_rust_packet_create(seed: i64) -> dci_rust.Packet;
    fn dci_rust_packet_copy(value: *dci_rust.Packet) -> dci_rust.Packet;
    fn dci_rust_packet_move(value: *dci_rust.Packet) -> dci_rust.Packet;
    fn dci_rust_packet_destroy(value: *dci_rust.Packet);
    fn dci_rust_packet_fold(value: *dci_rust.Packet) -> i64;

    fn dci_rust_creates() -> i32;
    fn dci_rust_copies() -> i32;
    fn dci_rust_moves() -> i32;
    fn dci_rust_destroy_calls() -> i32;
    fn dci_rust_destroys() -> i32;

    fn dci_rust_flags_make(priority: u32, enabled: i32) -> dci_rust.Flags;
    fn dci_rust_flags_priority(value: dci_rust.Flags) -> u32;
    fn dci_rust_flags_enabled(value: dci_rust.Flags) -> i32;
    fn dci_rust_mixed_params(flags: dci_rust.Flags,
                             packet: *dci_rust.Packet,
                             bias: i64) -> i64;

    fn dci_rust_aligned_make(low: u64, high: u64) -> dci_rust.AlignedPair;
    fn dci_rust_aligned_fold(value: dci_rust.AlignedPair) -> u64;
    fn dci_rust_aligned_byval_fold(value: dci_rust.AlignedPair) -> u64;
    fn dci_rust_bitfield_probe_make(value: i32) -> dci_rust.BitfieldProbe;

    fn dci_rust_packet_type_id() -> u64;
    fn dci_rust_packet_is_type(type_id: u64) -> i32;

    fn dci_rust_runtime_make(kind: i32, value: i32) -> *dci_rust.RuntimeBase;
    fn dci_rust_runtime_inspect(value: *dci_rust.RuntimeDerived) -> i64;
}

fn main() -> i32 {
    if (dci_rust_creates() != 0) { return 1; }
    if (dci_rust_copies() != 0) { return 2; }
    if (dci_rust_moves() != 0) { return 3; }
    if (dci_rust_destroys() != 0) { return 4; }
    if (dci_rust_destroy_calls() != 0) { return 5; }

    {
        var original = dci_rust_packet_create(7);
        if (original.total != 7 || original.tag != 1007) { return 6; }
        if (dci_rust_packet_fold(&original) != 1014) { return 7; }

        var copied = dci_rust_packet_copy(&original);
        if (dci_rust_packet_fold(&copied) != 1014) { return 8; }

        // Descriptor move semantics turn this bare initialization into move(*original).
        var moved = original;
        if (original.total != 0 || original.tag != 0) { return 9; }
        if (dci_rust_packet_fold(&moved) != 1014) { return 10; }

        let flags = dci_rust_flags_make(5, 1);
        if (flags.storage != 13) { return 11; }
        if (dci_rust_flags_priority(flags) != 5) { return 12; }
        if (dci_rust_flags_enabled(flags) != 1) { return 13; }
        if (dci_rust_mixed_params(flags, &copied, 6) != 1033) { return 14; }

        let aligned = dci_rust_aligned_make(12, 34);
        if (aligned.low != 12 || aligned.high != 34) { return 15; }
        if (dci_rust_aligned_fold(aligned) != 154) { return 16; }
        if (dci_rust_aligned_byval_fold(aligned) != 238) { return 17; }

        let packet_type = dci_rust_packet_type_id();
        if (dci_rust_packet_is_type(packet_type) != 1) { return 18; }
        if (dci_rust_packet_is_type(packet_type + 1) != 0) { return 19; }

        if (dci_rust_creates() != 1) { return 20; }
        if (dci_rust_copies() != 1) { return 21; }
        if (dci_rust_moves() != 1) { return 22; }
        if (dci_rust_destroy_calls() != 0 || dci_rust_destroys() != 0) { return 23; }
    }

    // The moved-from source remains destructible. All three Packet locals are
    // dropped exactly once; only copied and moved still contain live values.
    if (dci_rust_destroy_calls() != 3) { return 24; }
    if (dci_rust_destroys() != 2) { return 25; }

    let runtime_base = dci_rust_runtime_make(1, 23);
    let runtime_derived = runtime_base as *dci_rust.RuntimeDerived;
    if (runtime_derived == null) { return 26; }
    if (dci_rust_runtime_inspect(runtime_derived) != 5723) { return 27; }
    if ((runtime_derived as *dci_rust.RuntimeBase) != runtime_base) { return 28; }

    let plain_base = dci_rust_runtime_make(0, 41);
    if ((plain_base as *dci_rust.RuntimeDerived) != null) { return 29; }

    let null_base = dci_rust_runtime_make(-1, 0);
    if ((null_base as *dci_rust.RuntimeDerived) != null) { return 30; }

    print("dci_rust_generic OK");
    return 0;
}
