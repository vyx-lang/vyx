extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
}

extern "dci" {
    class contract_alpha.Base {
    };

    class contract_alpha.Derived : contract_alpha.Base {
    };

    class contract_beta.Base {
    };

    class contract_beta.Derived : contract_beta.Base {
    };

    class contract_table.Base {
    };

    class contract_table.Derived : contract_table.Base {
    };

    fn contract_hidden_probe(value: i32) -> i32;
}

fn alpha_upcast(value: *contract_alpha.Derived) -> *contract_alpha.Base {
    return value as *contract_alpha.Base;
}

fn beta_upcast(value: *contract_beta.Derived) -> *contract_beta.Base {
    return value as *contract_beta.Base;
}

fn table_upcast(value: *contract_table.Derived) -> *contract_table.Base {
    return value as *contract_table.Base;
}

fn main() -> i32 {
    if (alpha_upcast(null) != null) { return 1; }
    if (beta_upcast(null) != null) { return 2; }
    if (table_upcast(null) != null) { return 3; }

    let storage = malloc(128);
    if (storage == null) { return 4; }
    let alpha = storage as *contract_alpha.Derived;
    let beta = storage as *contract_beta.Derived;
    if ((alpha_upcast(alpha) as rawptr) != storage + 8) { return 5; }
    if ((beta_upcast(beta) as rawptr) != storage + 24) { return 6; }

    var table = malloc(16);
    let object = malloc(64);
    if (table == null || object == null) { return 7; }
    unsafe { memcpy(object, to_rawptr(&table), 8); }
    ptr_write_i32(table + 4, 40);
    let table_derived = object as *contract_table.Derived;
    if ((table_upcast(table_derived) as rawptr) != object + 40) { return 8; }

    free(object);
    free(table);
    free(storage);
    print("dci_direct_contracts OK");
    return 0;
}
