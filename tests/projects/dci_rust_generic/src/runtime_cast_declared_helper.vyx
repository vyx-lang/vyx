extern "dci" {
    class dci_rust.RuntimeBase {
        public kind: i32;
        public value: i32;
    };

    class dci_rust.RuntimeDerived : dci_rust.RuntimeBase {
        public prefix: i64;
        public extra: i32;
    };

    fn dci_rust_runtime_make(kind: i32, value: i32) -> *dci_rust.RuntimeBase;
    fn dci_rust_runtime_checked_downcast(value: *dci_rust.RuntimeBase) -> *dci_rust.RuntimeDerived;
}

fn main() -> i32 {
    let base = dci_rust_runtime_make(1, 9);
    let derived = base as *dci_rust.RuntimeDerived;
    if (derived == null) { return 1; }
    return 0;
}
