@[version("2.0.0")]
@[variant("_1")]

module Add;

@[migrate(fromVer = "1.0.0", desc = "use new add", fromSig = fn add(i32, i32) -> i32)]
public fn add(a: i32, b: i32) -> i32 {
    return (a + b) * 10;
}

public class Test {
    public n: i32;

    public Test() {
        self.n = 1;
    }

    public fn add(self, a: i32, b: i32) -> i32 {
        return (a + b) * 10;
    }

    /// Retired in 2.0.0. Written without a body on purpose: `@[discard]` is a
    /// removal notice, not a definition. Nothing here calls it, so the build
    /// must succeed — a tombstone swept into the reachable closure along with
    /// the rest of the class must never be asked for a function body.
    @[discard(fromVer = "1.0.0", desc = "")]
    public fn add4(self, a: i32, b: i32) -> i32;
}
