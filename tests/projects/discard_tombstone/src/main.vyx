@[version("1.0.0")]
@[variant("release")]
module discard_tombstone;

use Add;
use std.reflect;

fn main() -> i32 {
    let t = Test();
    print(t.add(1, 2));
    print(add(1, 2));
    // The historical spelling still resolves, straight to the v1.0.0 body.
    print(add@1.0.0["_1"](1, 2));
    return 0;
}
