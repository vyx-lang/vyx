@[version("1.0.0")]
@[variant("_1")]

module Add;

public fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

public class Test {
    public n: i32;

    public Test() {
        self.n = 1;
    }

    public fn add(self, a: i32, b: i32) -> i32 {
        return a + b;
    }

    /// The last version that still *implements* add4. v2.0.0 discards it,
    /// so this body is what `add4@1.0.0["_1"](...)` resolves back to.
    public fn add4(self, a: i32, b: i32) -> i32 {
        return a + b;
    }
}
