module fixture.stats;

use std.collections;
use std.string;

public fn sum_i32(values: &Vec<i32>) -> i64 {
    var total: i64 = 0;
    for (value in values) { total += value; }
    return total;
}

public fn sum_i64(values: &Vec<i64>) -> i64 {
    var total: i64 = 0;
    for (value in values) { total += value; }
    return total;
}

public fn sum_f64(values: &Vec<f64>) -> f64 {
    var total: f64 = 0.0;
    for (value in values) { total += value; }
    return total;
}

public fn sum_then_append(values: &mut Vec<i32>) -> i64 {
    var total: i64 = 0;
    for (value in values) { total += value; }
    values.push(7);
    return total;
}

public fn borrowed_text_length(text: &String) -> i64 {
    return text.length();
}

public fn view_length(text: str) -> i64 {
    return text.len;
}

public fn consume_text(text: String) -> i64 {
    let length = text.length();
    text.destroy();
    return length;
}

public fn return_text(text: String) -> String {
    return text;
}
