use std.collections;
use std.string;
use fixture.stats;

type OwnedText = String;
type TextView = str;

fn main() -> i32 {
    var values = Vec::<i32>.new();
    if (sum_i32(&values) != 0) { return 1; }
    for (i in 0..1024) { values.push(i as i32); }
    for (pass in 0..32) {
        if (sum_i32(&values) != 523776) { return 2; }
    }
    if (values.count() != 1024 || values.get(1023) != 1023) { return 3; }
    if (sum_then_append(&mut values) != 523776 || values.count() != 1025) { return 4; }
    var direct: i64 = 0;
    for (value in &values) { direct += value; }
    if (direct != 523783) { return 5; }
    var owned: i64 = 0;
    for (value in values) { owned += value; }
    if (owned != direct || values.count() != 1025) { return 6; }

    var wide = Vec::<i64>.new();
    wide.push(4294967296);
    wide.push(11);
    if (sum_i64(&wide) != 4294967307) { return 7; }
    var fractions = Vec::<f64>.new();
    fractions.push(0.5);
    fractions.push(1.25);
    if (sum_f64(&fractions) != 1.75) { return 8; }

    // Repeat both inline and heap buffers to expose duplicated destruction.
    for (pass in 0..2048) {
        let inline_text = String.from("small");
        let moved_inline = inline_text;
        if (moved_inline.length() != 5) { return 9; }
        var text = String.from("a fairly long string to escape the small buffer");
        let duplicate = text.clone();
        if (borrowed_text_length(&text) != 47 || duplicate.length() != 47) { return 10; }
        let moved = text;
        text = String.from("reinitialized");
        if (text.length() != 13 || moved.length() != 47) { return 11; }
        let returned = return_text(duplicate);
        if (consume_text(returned) != 47) { return 12; }
    }
    let original: str = "copyable view";
    let alias = original;
    let compatibility: string = original;
    if (original.len != 13 || alias.len != 13 || compatibility.len != 13) { return 13; }
    let view: TextView = "copyable view";
    let buffer: OwnedText = view;
    let moved_buffer = buffer;
    if (view.len != 13 || moved_buffer.length() != 13) { return 14; }
    let borrowed_view: str = moved_buffer;
    var assigned_view: str = "";
    assigned_view = moved_buffer;
    if (borrowed_view.len != 13 || assigned_view.len != 13 || view_length(moved_buffer) != 13) { return 15; }
    if (moved_buffer.length() != 13) { return 16; }
    print("BORROWED_VEC_STRING_OK");
    return 0;
}
