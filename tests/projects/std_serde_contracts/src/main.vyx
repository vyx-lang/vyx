module tests.std_serde_contracts;
use std.serde.csv;
use std.core;
use std.collections;
fn main() -> i32 {
    let rows = csv_parse("a,\"b\r\nc\",\"d\"\"e\"\r\n\r\nx,,\r\n");
    assert(rows.len == 3, "CSV row count");
    let first = rows.get(0);
    assert(first.len == 3 && first.get(1) == "b\r\nc" && first.get(2) == "d\"e", "CSV quoted fields");
    let blank = rows.get(1);
    assert(blank.len == 1 && blank.get(0) == "", "CSV blank record");
    let last = rows.get(2);
    assert(last.len == 3 && last.get(1) == "" && last.get(2) == "", "CSV trailing fields");
    assert(csv_parse("").len == 0, "CSV empty input");
    assert(csv_split_line("").len == 1, "CSV empty record");
    let raw = "comma, quote\" CR\r LF\n zero\0 tail";
    let encoded = csv_row2(raw, "");
    let decoded = csv_split_line(encoded);
    assert(decoded.len == 2 && decoded.get(0) == raw, "CSV binary round trip");
    match (csv_try_parse("\"unfinished")) {
        Err(failure) => { assert(failure.offset == 11, "CSV error offset"); }
        Ok(_) => { panic("unterminated CSV accepted"); }
    }
    match (csv_try_parse("\"x\"suffix")) { Err(_) => {} Ok(_) => { panic("CSV quote suffix accepted"); } }
    match (csv_try_parse("a\"b")) { Err(_) => {} Ok(_) => { panic("CSV bare quote accepted"); } }
    print("std serde contracts ok");
    return 0;
}
