module alias.exact.App.MD3;

use BaseWidget = alias.exact.App.BaseWidget;
use baseValue = alias.exact.App.baseValue;

public class Md3A {
    public static fn value() -> i32 {
        return baseValue() + 1;
    }

    public static fn widgetValue() -> i32 {
        return BaseWidget.value();
    }
}
