@[dci_import("../contracts/Complex.dcib")]
@[dci_import("../contracts/native.dcib")]
@[dci_import("../contracts/zig.dcib")]

extern "dci" {
    class abi_complex.AbstractSink {
        AbstractSink();
        virtual ~AbstractSink();
        virtual fn consume(x: i32) -> i32;
        public static fn destroyed_count() -> i32;
    };

    class abi_complex.NativeDriver {
        NativeDriver(bias: i32);
        ~NativeDriver();
        public bias: i32;
        public fn dispatch(sink: *abi_complex.AbstractSink, x: i32) const -> i32;
    };

    class abi_complex.RegisterPair {
        public first: i32;
        public second: i32;
    };

    fn complex_make_register_pair(first: i32, second: i32) -> abi_complex.RegisterPair;
    fn complex_register_pair_score(value: abi_complex.RegisterPair) -> i32;
}

extern "dci" {
    class native.Sink {
        virtual fn consume(x: i32) -> i32;
    };

    class native.NativePair {
        public fn flag_of() -> u8;
    };

    class native.NativeDriver {
    };

    fn native_pair_heap() -> *native.NativePair;
    fn native_pair_free(p: *native.NativePair);
    fn native_dispatch(sink: rawptr, x: i32) -> i32;
    fn native_driver_new(bias: i32) -> *native.NativeDriver;
    fn native_driver_dispatch(drv: *native.NativeDriver, sink: rawptr, x: i32) -> i32;
    fn native_driver_free(p: *native.NativeDriver);
}

extern "dci" {
    class zig_abi.Pair {
        public left: i32;
        public right: i32;
    };

    class zig_abi.Native {
        public flag: u8;
        public wide: u64;
    };

    fn pair_make(left: i32, right: i32) -> zig_abi.Pair;
    fn pair_sum(value: zig_abi.Pair) -> i32;
    fn c_mul(a: i32, b: i32) -> i32;
    fn native_heap() -> *zig_abi.Native;
    fn native_free(p: *zig_abi.Native);
    fn native_flag(value: *zig_abi.Native) -> u8;
}

class VyxSink : abi_complex.AbstractSink {
    VyxSink() {
        let init_marker = 0;
    }

    override fn consume(x: i32) -> i32 {
        return x + 7000;
    }
};

class VyxHost : native.Sink {
    VyxHost() {
        let init_marker = 0;
    }

    override fn consume(x: i32) -> i32 {
        return x + 7000;
    }
};

trait HostView {
    fn host_flag() -> u8;
}

impl HostView for native.NativePair {
    fn host_flag() -> u8 {
        return (self as *native.NativePair).flag_of();
    }
}

fn main() -> i32 {
    unsafe{
    let destroyed_sink0 = abi_complex.AbstractSink.destroyed_count();
    {
        var sink = VyxSink();
        if ((sink as *abi_complex.AbstractSink).consume(1) != 7001) { return 1; }
        var driver = abi_complex.NativeDriver(30);
        if (driver.bias != 30) { return 2; }
        if (driver.dispatch(sink as *abi_complex.AbstractSink, 2) != 7032) { return 3; }
    }
    if (abi_complex.AbstractSink.destroyed_count() != destroyed_sink0 + 1) { return 4; }

    let pair = complex_make_register_pair(12, 34);
    if (pair.first != 12) { return 5; }
    if (pair.second != 34) { return 6; }
    if (complex_register_pair_score(pair) != 1234) { return 7; }

    {
        var sink = VyxHost();
        if ((sink as *native.Sink).consume(1) != 7001) { return 8; }
        if (native_dispatch(sink as rawptr, 2) != 7032) { return 9; }

        let driver = native_driver_new(30);
        if (native_driver_dispatch(driver, sink as rawptr, 2) != 7032) { return 10; }
        native_driver_free(driver);
    }

    {
        let rust_pair = native_pair_heap();
        if (rust_pair.flag_of() != 9) { return 11; }
        if (rust_pair.host_flag() != 9) { return 12; }
        native_pair_free(rust_pair);
    }

    {
        let zig_pair = pair_make(12, 34);
        if (zig_pair.left != 12) { return 13; }
        if (zig_pair.right != 34) { return 14; }
        if (pair_sum(zig_pair) != 46) { return 15; }
        if (c_mul(6, 7) != 42) { return 16; }

        let zig_native = native_heap();
        if (zig_native.flag != 9) { return 17; }
        if (zig_native.wide != 1) { return 18; }
        if (native_flag(zig_native) != 9) { return 19; }
        native_free(zig_native);
    }

    print("dci_multilang OK");
    return 0;
    }
}
