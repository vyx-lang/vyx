module tests.std_network_protocols;

use std.network.curl;
use std.network.httpclient;
use std.network.grpc;
use std.network.websockets;

extern "C" { fn getenv(name: rawptr) -> rawptr; }

fn env(name: string) -> string {
    let value = getenv(name.c_str());
    if (value == null) { return ""; }
    return from_cstr(value);
}

fn http_checks(url: string) -> bool {
    var client = HttpClient.create();
    client.setTimeout(3);
    let get_response = client.get(url + "/hello");
    if (!get_response.ok || get_response.statusCode != 200 || get_response.body != "hello from HTTP") {
        print("HTTP GET failed"); return false;
    }
    let post_response = client.postJson(url + "/echo", "A\0B");
    if (!post_response.ok || post_response.statusCode != 200 || post_response.body != "A\0B") {
        print("HTTP binary POST failed"); return false;
    }
    let empty = client.postJson(url + "/empty", "");
    if (!empty.ok || empty.statusCode != 200 || empty.body != "POST") {
        print("HTTP empty POST failed"); return false;
    }
    let missing = client.get(url + "/missing");
    if (missing.statusCode != 404) { print("HTTP 404 failed"); return false; }
    if (http_post(url + "/echo", "A\0B") != "A\0B"
        || http_post_json(url + "/echo", "A\0B") != "A\0B") {
        print("curl binary POST failed"); return false;
    }
    print("HTTP GET / binary POST / empty POST / 404 ok");
    return true;
}

fn grpc_checks(url: string, malformed_url: string) -> bool {
    var channel = GrpcChannel.connect(url);
    if (!channel.isConnected()) { print("gRPC connect: " + channel.lastError()); return false; }
    let reply = channel.unaryCall("/vyx.Echo/Echo", "A\0B");
    if (!reply.ok || reply.status != GrpcStatus.OK || reply.data != "A\0B") {
        print("gRPC echo: " + reply.message + " status=" + reply.status.toString()); return false;
    }
    let reply2 = channel.unaryCall("/vyx.Echo/Echo", "second request");
    if (!reply2.ok || reply2.data != "second request") { print("gRPC repeated call failed"); return false; }
    let empty = channel.unaryCall("/vyx.Echo/Echo", "");
    if (!empty.ok || empty.data.len != 0) { print("gRPC empty response failed"); return false; }
    let denied = channel.unaryCall("/vyx.Echo/Denied", "");
    if (denied.ok || denied.status != GrpcStatus.PERMISSION_DENIED || denied.message != "denied by server") {
        print("gRPC server status failed: " + denied.message); return false;
    }
    let invalid = channel.unaryCall("missing-leading-slash", "");
    if (invalid.ok || invalid.status != 3) { print("gRPC invalid path failed"); return false; }
    channel.setTimeout(1);
    let deadline = channel.unaryCall("/vyx.Echo/Slow", "");
    if (deadline.ok || deadline.status != 4) { print("gRPC deadline failed"); return false; }
    channel.close(); channel.close();
    let closed = channel.unaryCall("/vyx.Echo/Echo", "");
    if (closed.ok || closed.status != 14) { print("gRPC closed call failed"); return false; }
    var raw = GrpcChannel.connect(malformed_url);
    if (!raw.isConnected()) { print("raw HTTP/2 connect failed: " + raw.lastError()); return false; }
    let no_status = raw.unaryCall("/vyx.Echo/NoStatus", "x");
    if (no_status.ok || no_status.status != 2) { print("missing grpc-status accepted"); return false; }
    let bad_frame = raw.unaryCall("/vyx.Echo/BadFrame", "x");
    if (bad_frame.ok || bad_frame.status != 13) { print("bad gRPC frame accepted"); return false; }
    let compressed = raw.unaryCall("/vyx.Echo/Compressed", "x");
    if (compressed.ok || compressed.status != 12) { print("compressed gRPC frame accepted"); return false; }
    let bad_type = raw.unaryCall("/vyx.Echo/BadType", "x");
    if (bad_type.ok || bad_type.status != 13) { print("bad gRPC content type accepted"); return false; }
    raw.close();
    var absent = GrpcChannel.connect(env("NETWORK_ABSENT"));
    if (absent.isConnected()) { print("unavailable gRPC endpoint accepted"); return false; }
    print("gRPC HTTP/2 binary / repeat / empty / trailers / deadline / malformed / close ok");
    return true;
}

fn ws_checks(url: string, raw_url: string, tls_url: string) -> bool {
    var ws = WebSocket.connect(url + "/echo?test=1");
    if (!ws.isOpen()) { print("WebSocket connect: " + ws.lastError()); return false; }
    if (!ws.send("hello from Vyx") || ws.recv() != "hello from Vyx") { print("WebSocket echo failed"); return false; }
    if (!ws.send("A\0B") || ws.recv() != "A\0B") { print("WebSocket NUL failed"); return false; }
    var large = "";
    var i: i32 = 0;
    while (i < 66000) { large = large + "x"; i = i + 1; }
    if (!ws.send(large) || ws.recv() != large) { print("WebSocket extended frame failed"); return false; }
    if (!ws.ping() || !ws.send("after ping") || ws.recv() != "after ping") { print("WebSocket ping failed"); return false; }
    ws.close(); ws.close();
    if (ws.isOpen() || ws.send("closed")) { print("WebSocket close failed"); return false; }
    var fragmented = WebSocket.connect(url + "/fragmented");
    if (!fragmented.isOpen() || fragmented.recv() != "fragmented text") { print("WebSocket fragments failed"); return false; }
    fragmented.close();
    var peer_close = WebSocket.connect(url + "/close");
    if (!peer_close.isOpen()) { print("WebSocket close peer connect failed"); return false; }
    peer_close.recv();
    if (peer_close.isOpen()) { print("WebSocket peer close failed"); return false; }
    var wrong_accept = WebSocket.connect(raw_url + "/wrong-accept");
    if (wrong_accept.isOpen()) { print("WebSocket incorrect accept accepted"); return false; }
    var masked = WebSocket.connect(raw_url + "/masked");
    if (!masked.isOpen()) { print("masked peer connect failed"); return false; }
    masked.recv();
    if (masked.isOpen() || masked.lastError().len == 0) { print("masked server frame accepted"); return false; }
    var huge = WebSocket.connect(raw_url + "/huge");
    if (!huge.isOpen()) { print("huge peer connect failed"); return false; }
    huge.recv();
    if (huge.isOpen() || huge.lastError().len == 0) { print("oversized server frame accepted"); return false; }
    var bad_utf8 = WebSocket.connect(raw_url + "/bad-utf8");
    if (!bad_utf8.isOpen()) { print("UTF-8 peer connect failed"); return false; }
    bad_utf8.recv();
    if (bad_utf8.isOpen()) { print("invalid UTF-8 accepted"); return false; }
    var bad_close = WebSocket.connect(raw_url + "/bad-close");
    if (!bad_close.isOpen()) { print("close status peer connect failed"); return false; }
    bad_close.recv();
    if (bad_close.isOpen() || bad_close.lastError().len == 0) { print("reserved close status accepted"); return false; }
    var untrusted = WebSocket.connect(tls_url + "/echo");
    if (untrusted.isOpen() || untrusted.lastError().len == 0) { print("untrusted TLS certificate accepted"); return false; }
    var trusted = WebSocket.connect(tls_url + "/echo", env("NETWORK_CA"));
    if (!trusted.isOpen()) { print("trusted WSS failed: " + trusted.lastError()); return false; }
    if (!trusted.send("verified TLS") || trusted.recv() != "verified TLS") { print("WSS echo failed"); return false; }
    trusted.close();
    print("WebSocket echo / NUL / large / ping / fragments / close / malformed / TLS rejection ok");
    return true;
}

fn main() -> i32 {
    if (!http_checks(env("NETWORK_HTTP"))) { return 1; }
    if (!grpc_checks(env("NETWORK_GRPC"), env("NETWORK_H2"))) { return 2; }
    if (!ws_checks(env("NETWORK_WS"), env("NETWORK_RAW_WS"), env("NETWORK_TLS_WS"))) { return 3; }
    http_cleanup();
    print("network protocols ok");
    return 0;
}
