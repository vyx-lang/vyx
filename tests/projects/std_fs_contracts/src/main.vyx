module tests.std_fs_contracts;
use std.fs;
use std.core;
use std.collections;
fn options() -> FileOptions {
    return FileOptions { read: true, write: false, create: false, truncate: false, binary: true };
}
fn main() -> i32 {
    let path = ".cache/fs-contract.bin";
    let content = "A\0B\r\nend";
    assert(writeFile(path, content) == 0, "std_fs_contracts/main.vyx:11");
    assert(readFile(path).len == 8, "std_fs_contracts/main.vyx:12");
    match (File.try_open(path, options())) {
        Ok(file) => {
            match (file.try_read_all_bytes()) {
                Ok(bytes) => { assert(bytes.len == 8 && bytes.get(1) == 0 as u8 && bytes.get(7) == 100 as u8, "std_fs_contracts/main.vyx:16"); }
                Err(_) => { panic("binary read failed"); }
            }
            match (file.try_read_all_text()) {
                Ok(text) => { assert(text.len == 8 && text.charAt(2) == 66, "std_fs_contracts/main.vyx:20"); }
                Err(_) => { panic("text read failed"); }
            }
            assert(file.close() == 0 && file.close() == 0, "std_fs_contracts/main.vyx:23");
            match (file.try_read_all_bytes()) { Err(_) => {} Ok(_) => { panic("closed file read succeeded"); } }
        }
        Err(_) => { panic("file open failed"); }
    }
    assert(appendFile(path, "!") == 0, "std_fs_contracts/main.vyx:28");
    assert(fileSize(path) == 9, "std_fs_contracts/main.vyx:29");
    assert(copyFile(path, ".cache/fs-copy.bin") == 0, "std_fs_contracts/main.vyx:30");
    assert(readFile(".cache/fs-copy.bin").len == 9, "std_fs_contracts/main.vyx:31");
    assert(writeFile(".cache/fs-empty.bin", "") == 0, "std_fs_contracts/main.vyx:32");
    match (File.try_open(".cache/fs-empty.bin", options())) {
        Ok(file) => { match (file.try_read_all_bytes()) { Ok(bytes) => { assert(bytes.len == 0, "std_fs_contracts/main.vyx:34"); } Err(_) => { panic("empty file is not an error"); } } }
        Err(_) => { panic("empty open failed"); }
    }
    match (File.try_open(".cache/does-not-exist", options())) { Err(_) => {} Ok(_) => { panic("missing open succeeded"); } }
    assert(writeFile(".cache/truncated\0suffix", "x") != 0, "std_fs_contracts/main.vyx:38");
    assert(!fileExists(".cache/truncated"), "std_fs_contracts/main.vyx:39");
    // Spaces and shell metacharacters must be literal path bytes.
    assert(makeDir(".cache/directory & literal") == 0, "std_fs_contracts/main.vyx:41");
    assert(isDir(".cache/directory & literal"), "std_fs_contracts/main.vyx:42");
    assert(removeDir(".cache/directory & literal") == 0, "std_fs_contracts/main.vyx:43");
    assert(makeDir(".cache/中文 & directory") == 0, "UTF-8 directory");
    assert(writeFile(".cache/中文 & directory/文件.bin", content) == 0, "UTF-8 write");
    assert(fileSize(".cache/中文 & directory/文件.bin") == 8, "UTF-8 size");
    assert(readFile(".cache/中文 & directory/文件.bin").len == 8, "UTF-8 read");
    assert(renameFile(".cache/中文 & directory/文件.bin", ".cache/中文 & directory/改名.bin") == 0, "UTF-8 rename");
    assert(deleteFile(".cache/中文 & directory/改名.bin") == 0, "UTF-8 delete");
    assert(removeDir(".cache/中文 & directory") == 0, "UTF-8 remove directory");
    assert(deleteFile(path) == 0, "std_fs_contracts/main.vyx:44");
    assert(deleteFile(".cache/fs-copy.bin") == 0, "std_fs_contracts/main.vyx:45");
    assert(deleteFile(".cache/fs-empty.bin") == 0, "std_fs_contracts/main.vyx:46");
    print("std.fs contracts ok");
    return 0;
}
