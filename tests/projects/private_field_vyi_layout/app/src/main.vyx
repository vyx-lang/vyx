module private_field_vyi_app;

// PROJECT-BUILD-ONLY: requires private_field_vyi_dep package build and generated .vyi interface.

use std.collections;
use private_field_vyi_dep;

fn main() -> i32 {
    let a = LayoutView.create(1, 10);
    let b = LayoutView.create(2, 20);
    let c = LayoutView.create(3, 30);

    var kids = Vec::<LayoutView>.new();
    kids.push(a);
    kids.push(b);
    kids.push(c);

    var row = LayoutView.row().children(kids);
    if (row.kind != 100) { row.destroy(); kids.destroy(); return 1; }
    if (row.tail != 9001) { row.destroy(); kids.destroy(); return 2; }
    if (row.childCount() != 3) { row.destroy(); kids.destroy(); return 3; }
    if (row.childAt(1).kind != 2) { row.destroy(); kids.destroy(); return 4; }
    if (row.childAt(2).tail != 30) { row.destroy(); kids.destroy(); return 5; }
    if (row.checksum() != 9167) { row.destroy(); kids.destroy(); return 6; }

    row.destroy();
    kids.destroy();
    return 0;
}
