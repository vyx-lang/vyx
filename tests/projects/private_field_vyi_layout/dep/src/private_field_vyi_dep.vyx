module private_field_vyi_dep;

use std.collections;

public class LayoutView {
    public kind: i32;
    private child_nodes: Vec<LayoutView>;
    public tail: i32;

    public static fn create(kind: i32, tail: i32) -> LayoutView {
        return LayoutView {
            kind: kind,
            child_nodes: Vec::<LayoutView>.new(),
            tail: tail
        };
    }

    public static fn row() -> LayoutView {
        return LayoutView.create(100, 9001);
    }

    @[borrow_args]
    public fn children(items: Vec<LayoutView>) -> LayoutView {
        var i: i32 = 0;
        while (i < (items.len as i32)) {
            self.child_nodes.push(items.get(i as i64).clone());
            i = i + 1;
        }
        return self;
    }

    public fn childCount() -> i32 {
        return self.child_nodes.len as i32;
    }

    public fn childAt(index: i32) -> LayoutView {
        return self.child_nodes.get(index as i64).clone();
    }

    public fn checksum() -> i32 {
        var out: i32 = self.kind + self.tail;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            out = out + child.kind + child.tail;
            i = i + 1;
        }
        return out;
    }

    public fn clone() -> LayoutView {
        var out = LayoutView.create(self.kind, self.tail);
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            out.child_nodes.push(self.child_nodes.get(i as i64).clone());
            i = i + 1;
        }
        return out;
    }

    public fn destroy() {
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            var child = self.child_nodes.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.child_nodes.destroy();
    }
}
