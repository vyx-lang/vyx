module tests.std_system_contracts;
use std.time;
use std.path;
extern "C" {
    fn system_reference_nanos() -> i64;
    fn system_reference_timestamp() -> i64;
    fn system_monotonic_id() -> i32;
}
@[platform("windows")]
fn platform_paths() {
    assert(is_absolute("C:relative") == 0, "drive relative");
    assert(is_absolute("C:") == 0, "drive only");
    assert(is_absolute("C:/") == 1, "drive absolute");
    assert(is_absolute("z:\\dir") == 1, "backslash drive absolute");
    assert(is_absolute("/dir") == 0 && is_rooted("/dir") == 1, "current drive root");
    assert(is_absolute("\\dir") == 0 && is_rooted("\\dir") == 1, "backslash root");
    assert(is_rooted("C:dir") == 1, "drive rooted");
    assert(is_absolute("\\\\server\\share") == 1, "UNC root");
    assert(is_absolute("//server/share/dir") == 1, "UNC forward separators");
    assert(is_absolute("\\\\server") == 0 && is_absolute("\\\\server\\") == 0, "incomplete UNC");
    assert(is_absolute("\\\\?\\C:\\dir") == 1, "extended drive");
    assert(is_absolute("\\\\?\\C:dir") == 0, "extended drive relative");
    assert(is_absolute("\\\\?\\UNC\\server\\share") == 1, "extended UNC");
    assert(is_absolute("\\\\?\\UNC\\server") == 0, "extended UNC missing share");
    assert(is_absolute("\\\\?\\UNC") == 0, "extended UNC missing server");
    assert(is_absolute("\\\\.\\PhysicalDrive0") == 1, "device namespace");
    assert(is_absolute("1:/dir") == 0, "invalid drive letter");
    assert(path_separator() == 92, "Windows separator");
}
@[platform("posix")]
fn platform_paths() {
    assert(is_absolute("/dir") == 1 && is_rooted("/dir") == 1, "POSIX root");
    assert(is_absolute("C:/dir") == 0 && is_absolute("C:relative") == 0, "drive syntax is relative on POSIX");
    assert(is_absolute("\\dir") == 0, "backslash is ordinary POSIX character");
    assert(is_absolute("//server/share") == 1, "POSIX leading slash");
    assert(path_separator() == 47, "POSIX separator");
    assert(CLOCK_MONOTONIC == system_monotonic_id(), "native clock identifier");
}
fn main() -> i32 {
    platform_paths();
    assert(is_absolute("") == 0 && is_absolute("relative/path") == 0, "relative paths");
    let before = system_reference_timestamp();
    let stamp = current_timestamp();
    let after = system_reference_timestamp();
    assert(stamp >= before && stamp <= after, "UTC timestamp");
    let reference = system_reference_nanos();
    let start = monotonic_nanos();
    let inner_start = system_reference_nanos();
    sleep_ms(60);
    let inner_elapsed = system_reference_nanos() - inner_start;
    let elapsed = monotonic_nanos() - start;
    let reference_elapsed = system_reference_nanos() - reference;
    // Allow Windows timer granularity; nested clock samples tolerate preemption.
    assert(inner_elapsed >= 30000000, "real sleep duration");
    assert(elapsed + 1000000 >= inner_elapsed && elapsed <= reference_elapsed + 1000000, "independent steady clock bounds");
    let first = clock_ms();
    for (i in 0..100) { assert(clock_ms() >= first, "monotonic ordering"); }
    assert(try_sleep_ms(-1).is_err(), "negative checked duration");
    assert(try_sleep_ms(0).is_ok(), "zero checked duration");
    sleep_ms(-1);
    sleep_busy(0);
    print("std system contracts ok");
    return 0;
}
