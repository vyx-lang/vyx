module tests.client_config;
use std.core;
use std.string;
use std.serde.ini;

public class ClientConfig { public endpoint: String; public port: i32; public enabled: bool; }

public fn load_client(text: string) -> Result<ClientConfig, string> {
    match (IniDocument.try_parse(text)) {
        Err(failure) => { return Err(failure.message.clone()); }
        Ok(document) => {
            var endpoint = String.empty();
            var port: i32 = 8080;
            var enabled = false;
            match (document.get("server", "endpoint")) {
                Some(value) => { endpoint = value; }
                None => { return Err("missing server.endpoint"); }
            }
            match (document.try_get_i32("server", "port")) {
                Ok(value) => { port = value.unwrap_or(8080); }
                Err(failure) => { return Err(failure.message.clone()); }
            }
            if (port < 1 || port > 65535) { return Err("server.port is outside 1..65535"); }
            match (document.try_get_bool("server", "enabled")) {
                Ok(value) => { enabled = value.unwrap_or(false); }
                Err(failure) => { return Err(failure.message.clone()); }
            }
            return Ok(ClientConfig { endpoint: endpoint, port: port, enabled: enabled });
        }
    }
}
