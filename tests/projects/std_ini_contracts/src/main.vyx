module tests.std_ini_contracts;
use std.core;
use std.string;
use std.fs;
use std.serde.ini;
use tests.client_config;

fn rejected(text: string, kind: IniErrorKind, offset: i64, line: i64, column: i64) {
    match (IniDocument.try_parse(text)) {
        Ok(_) => { panic("invalid INI accepted"); }
        Err(failure) => {
            assert(failure.kind == kind && failure.offset == offset && failure.line == line && failure.column == column, "located INI syntax error");
            assert(failure.message.len > 0, "INI syntax error message");
        }
    }
}

fn syntax() {
    let document = IniDocument.parse("root=first\r\n # comment\r\n [ server ] ; section comment\r\n port = -42 \t\r\n empty=\r\n url=https://x/a?q=1;tag=#literal\r\n quoted=\"keep \\\"quotes\\\"\"\r\n literal=100% %(raw)s\r\n");
    assert(document.len() == 6, "INI indexed entry count");
    assert(document.get("", "root").unwrap() == "first", "root key");
    assert(document.get("server", "port").unwrap() == "-42", "CRLF, spaces and tabs");
    assert(document.try_get_i32("server", "port").unwrap().unwrap() == -42, "signed decimal");
    assert(document.get("server", "empty").unwrap() == "" && document.get("server", "missing").is_none(), "present empty differs from absent");
    assert(document.get("server", "url").unwrap() == "https://x/a?q=1;tag=#literal", "value delimiters and comments remain literal");
    assert(document.get("server", "literal").unwrap() == "100% %(raw)s", "no interpolation");
    let bare_cr = IniDocument.parse("[s]\rx=one\ry=two");
    assert(bare_cr.get("s", "y").unwrap() == "two", "bare CR newlines");
    var bom_bytes = StringBuilder.create();
    bom_bytes.appendChar(239); bom_bytes.appendChar(187); bom_bytes.appendChar(191);
    bom_bytes.append("[s]\nx=ok");
    let bom_text = bom_bytes.intoString();
    let bom = IniDocument.parse(bom_text.as_str());
    assert(bom.get("s", "x").unwrap() == "ok", "UTF-8 BOM");
    assert(IniDocument.parse("").len() == 0, "empty document");
    assert(ini_find("[s]\r\nx=ok\r\n", "s", "x") == "ok", "legacy CRLF lookup");
    assert(ini_find_int("[s]\nx=-42", "s", "x") == -42, "legacy signed lookup");
    assert(ini_find("", "s", "missing") == "" && ini_find_int("", "s", "missing") == 0 && !ini_find_bool("", "s", "missing"), "legacy missing defaults only");
    rejected("[s", IniErrorKind.InvalidSyntax, 0, 1, 1);
    rejected("[]", IniErrorKind.InvalidName, 1, 1, 2);
    rejected("[a[b]", IniErrorKind.InvalidName, 2, 1, 3);
    rejected("[s] junk", IniErrorKind.InvalidSyntax, 4, 1, 5);
    rejected("[s]\nx=1\nx=2", IniErrorKind.DuplicateKey, 8, 3, 1);
    rejected("[s]\nx=1\n[s]", IniErrorKind.DuplicateSection, 8, 3, 1);
    rejected("=value", IniErrorKind.InvalidName, 0, 1, 1);
    rejected("[s]\nkey=value\n continuation", IniErrorKind.InvalidSyntax, 15, 3, 2);
    rejected(";bad\0comment", IniErrorKind.InvalidSyntax, 4, 1, 5);
    rejected("[s]\r\nx=ok\r\nbad", IniErrorKind.InvalidSyntax, 11, 3, 1);
}

fn integer_error(text: string, kind: IniErrorKind, offset: i64, column: i64) {
    let document = IniDocument.parse(text);
    match (document.try_get_i64("s", "n")) {
        Ok(_) => { panic("invalid integer accepted"); }
        Err(failure) => { assert(failure.kind == kind && failure.offset == offset && failure.line == 2 && failure.column == column, "located INI integer error"); }
    }
}
fn typed_values() {
    let numbers = IniDocument.parse("[s]\nmin=-9223372036854775808\nmax=9223372036854775807\nmin32=-2147483648\nmax32=+2147483647\nleading=00042\nnegative_zero=-0\n");
    assert(numbers.try_get_i64("s", "min").unwrap().unwrap() == -9223372036854775807 - 1, "minimum i64");
    assert(numbers.try_get_i64("s", "max").unwrap().unwrap() == 9223372036854775807, "maximum i64");
    assert(numbers.try_get_i32("s", "min32").unwrap().unwrap() == (-2147483647 - 1), "minimum i32");
    assert(numbers.try_get_i32("s", "max32").unwrap().unwrap() == 2147483647, "maximum i32");
    assert(numbers.try_get_i32("s", "leading").unwrap().unwrap() == 42 && numbers.try_get_i64("s", "negative_zero").unwrap().unwrap() == 0, "leading zeros and negative zero");
    assert(numbers.try_get_i64("s", "missing").unwrap().is_none(), "missing typed value");
    assert(numbers.try_get_i32("s", "max").is_err(), "checked narrowing to i32");
    integer_error("[s]\nn=12oops34", IniErrorKind.InvalidInteger, 8, 5);
    integer_error("[s]\nn=", IniErrorKind.InvalidInteger, 6, 3);
    integer_error("[s]\nn=+", IniErrorKind.InvalidInteger, 7, 4);
    integer_error("[s]\nn=9223372036854775808", IniErrorKind.Overflow, 24, 21);
    integer_error("[s]\nn=-9223372036854775809", IniErrorKind.Overflow, 25, 22);
    let booleans = IniDocument.parse("[s]\na=TrUe\nb=YES\nc=on\nd=1\ne=FALSE\nf=No\ng=OFF\nh=0\nbad=maybe\nempty=\n");
    assert(booleans.try_get_bool("s", "a").unwrap().unwrap() && booleans.try_get_bool("s", "b").unwrap().unwrap(), "boolean text alternatives");
    assert(booleans.try_get_bool("s", "c").unwrap().unwrap() && booleans.try_get_bool("s", "d").unwrap().unwrap(), "boolean numeric/on alternatives");
    assert(!booleans.try_get_bool("s", "e").unwrap().unwrap() && !booleans.try_get_bool("s", "f").unwrap().unwrap(), "false alternatives");
    assert(!booleans.try_get_bool("s", "g").unwrap().unwrap() && !booleans.try_get_bool("s", "h").unwrap().unwrap(), "off/zero alternatives");
    assert(booleans.try_get_bool("s", "bad").is_err() && booleans.try_get_bool("s", "empty").is_err(), "invalid boolean is not false");
    assert(booleans.try_get_bool("s", "missing").unwrap().is_none(), "absent boolean is not false");
}

fn scoped_document() -> IniDocument {
    let text = String.from("[long.section]\nlong.key=long value that must own its storage after input destruction\n");
    return IniDocument.parse(text.as_str());
}
fn read_borrowed(document: &IniDocument) -> String { return document.get("long.section", "long.key").unwrap(); }
fn escaped_value() -> String {
    let document = scoped_document();
    return read_borrowed(&document);
}
fn ownership_and_index() {
    let value = escaped_value();
    assert(value == "long value that must own its storage after input destruction", "lookup survives document destruction");
    let copied = scoped_document().clone();
    assert(read_borrowed(&copied) == value.as_str(), "deep-cloned document index and values");
    let namespaces = IniDocument.parse("a.b=root\n[a]\nb=one\nb.c=two\n[a.b]\nc=three\n[A]\nb=four\n");
    assert(namespaces.get("", "a.b").unwrap() == "root" && namespaces.get("a", "b").unwrap() == "one", "root/section key separation");
    assert(namespaces.get("a", "b.c").unwrap() == "two" && namespaces.get("a.b", "c").unwrap() == "three", "dotted namespace keys are unambiguous");
    assert(namespaces.get("A", "b").unwrap() == "four", "case-sensitive section names");
    match (namespaces.try_get("a\0b", "c")) {
        Err(failure) => { assert(failure.kind == IniErrorKind.InvalidName && failure.offset == -1 && failure.line == 0, "invalid lookup name has no source location"); }
        Ok(_) => { panic("lookup NUL accepted"); }
    }
}

fn file_consumer() {
    let file = File.try_open("config.ini", FileOptions { read: true, write: false, create: false, truncate: false, binary: true }).unwrap();
    let text = file.try_read_all_text().unwrap();
    let settings = load_client(text).unwrap();
    assert(settings.endpoint == "https://example.org/api?q=1;tag=#raw" && settings.port == 8443 && settings.enabled, "real configuration consumer");
    let defaults = load_client("[server]\nendpoint=http://localhost").unwrap();
    assert(defaults.port == 8080 && !defaults.enabled, "application explicitly chooses defaults");
    assert(load_client("[server]\nport=9000").is_err(), "required application field");
    assert(load_client("[server]\nendpoint=x\nport=12oops34").is_err(), "application propagates typed errors");
    assert(load_client("[server]\nendpoint=x\nport=70000").is_err(), "application validates its domain");
}

fn main() -> i32 {
    syntax(); typed_values(); ownership_and_index(); file_consumer();
    print("std ini contracts ok");
    return 0;
}
