module vyi_alias_sizeof_layout_app;

// PROJECT-BUILD-ONLY: consumes ImportedRecord through the dependency's generated .vyi.
use ShellAlias = vyi_alias_sizeof_layout_shell.LayoutShellMarker;
use RecordAlias = vyi_alias_sizeof_layout_dep.ImportedRecord;
use EmptyAlias = vyi_alias_sizeof_layout_dep.EmptyRecord;
use LayoutFacade = vyi_alias_sizeof_layout_facade.LayoutFacade;
use IgnoredFnAlias = vyi_alias_sizeof_layout_dep.layout_probe;
use IgnoredFnAliasAgain = vyi_alias_sizeof_layout_dep.layout_probe;
use IgnoredConstAlias = vyi_alias_sizeof_layout_dep.LAYOUT_PROBE_VALUE;

fn main() -> i32 {
    // Load a same-name empty shell first; layout lookup must still replace it
    // with the precise dependency declaration below.
    if (field_count::<ShellAlias>() != 0) { return 1; }
    if (field_count::<LayoutFacade>() != 1) { return 2; }
    if (sizeof::<RecordAlias>() != 24) { return 3; }
    if (alignof::<RecordAlias>() != 8) { return 4; }
    if (field_count::<EmptyAlias>() != 0) { return 5; }
    if (field_count::<EmptyAlias>() != 0) { return 6; }
    if (field_count::<RecordAlias>() != 6) { return 7; }
    print("vyi_alias_sizeof_layout OK");
    return 0;
}
