module tests.std_scalar_contracts;
use std.core;
use std.bits;
use std.encoding;
use std.random;
use std.string;
use std.time;

@[export_name("std_contract_unsigned_to_float")]
fn unsigned_to_float(value: u64) -> f64 { return value as f64; }
@[export_name("std_contract_float_to_unsigned")]
fn float_to_unsigned(value: f64) -> u64 { return value as u64; }

fn conversion_contracts() {
    assert(unsigned_to_float(9223372036854775808 as u64) == 9223372036854775808.0, "u64 to f64 sign");
    assert(float_to_unsigned(9223372036854775808.0) == 9223372036854775808 as u64, "f64 to u64 sign");
    let high: u32 = 4294967295;
    assert((high as f64) == 4294967295.0, "u32 to f64 sign");
    let floating: f64 = 4294967295.0;
    assert((floating as u32) == high, "f64 to u32 sign");
    let single: f32 = 2147483648.0;
    assert((single as u32) == 2147483648 as u32, "f32 to u32 sign");
    assert((-7 as f64) == -7.0, "signed integer to float");
}

fn bits_contracts() {
    assert(popcount(0) == 0 && popcount(-1) == 32, "std_scalar_contracts/main.vyx:9");
    assert(clz(0) == 32 && ctz(0) == 32, "std_scalar_contracts/main.vyx:10");
    assert(clz(1) == 31 && ctz(8) == 3, "std_scalar_contracts/main.vyx:11");
    assert(rotate_left(-123, 0) == -123, "std_scalar_contracts/main.vyx:12");
    assert(rotate_left(-123, 32) == -123, "std_scalar_contracts/main.vyx:13");
    assert(rotate_right(-123, 0) == -123, "std_scalar_contracts/main.vyx:14");
    assert(rotate_right(-123, 32) == -123, "std_scalar_contracts/main.vyx:15");
    assert(rotate_right(1, 1) == (2147483648 as i64) as i32, "std_scalar_contracts/main.vyx:16");
    assert(rotate_left((2147483648 as i64) as i32, 1) == 1, "std_scalar_contracts/main.vyx:17");
    assert(hex_int(-1) == "ffffffff", "std_scalar_contracts/main.vyx:18");
    assert(hex_i64(-1) == "ffffffffffffffff", "std_scalar_contracts/main.vyx:19");
}

fn encoding_contracts() {
    assert(base64_encode("f") == "Zg==", "std_scalar_contracts/main.vyx:23");
    assert(base64_encode("fo") == "Zm8=", "std_scalar_contracts/main.vyx:24");
    assert(base64_encode("foo") == "Zm9v", "std_scalar_contracts/main.vyx:25");
    assert(base64_decode("Zm9vYmFy") == "foobar", "std_scalar_contracts/main.vyx:26");
    let bytes = hex_decode("000102ff");
    assert(bytes.len == 4 && bytes.charAt(3) == 255, "std_scalar_contracts/main.vyx:28");
    assert(base64_encode(bytes) == "AAEC/w==", "std_scalar_contracts/main.vyx:29");
    assert(hex_encode(base64_decode("AAEC/w==")) == "000102ff", "std_scalar_contracts/main.vyx:30");
    match (try_base64_decode("Zg=")) { Err(_) => {} Ok(_) => { panic("short Base64 accepted"); } }
    match (try_base64_decode("Zh==")) { Err(_) => {} Ok(_) => { panic("noncanonical pad bits accepted"); } }
    match (try_base64_decode("Zg==AAAA")) { Err(_) => {} Ok(_) => { panic("interior padding accepted"); } }
    match (try_base64_decode("!!!!")) { Err(_) => {} Ok(_) => { panic("invalid alphabet accepted"); } }
    match (try_hex_decode("f")) { Err(_) => {} Ok(_) => { panic("odd hex accepted"); } }
    match (try_hex_decode("xx")) { Err(_) => {} Ok(_) => { panic("invalid hex accepted"); } }
    var source = StringBuilder.create();
    var i: i32 = 0;
    while (i < 256) { source.appendChar(i); i += 1; }
    let all_bytes = source.intoString();
    let encoded = base64_encode(all_bytes.as_str());
    let decoded = base64_decode(encoded);
    assert(decoded.len == 256, "std_scalar_contracts/main.vyx:43");
    i = 0;
    while (i < 256) { assert(decoded.charAt(i) == i, "std_scalar_contracts/main.vyx:45"); i += 1; }
}

fn random_contracts() {
    let first_ticks = cpu_clock_ticks();
    let next_ticks = cpu_clock_ticks();
    assert(first_ticks >= 0 && next_ticks >= first_ticks, "CPU clock native ABI");
    assert(current_timestamp() > 0, "64-bit native timestamp");
    var automatic = Rng.auto();
    let sample = automatic.nextFloat();
    assert(sample >= 0.0 && sample < 1.0, "automatic RNG clock source");
    var rng = Rng.create(42);
    assert(((rng.nextU32() as u32) as u64) == 1085446021 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 176895750 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 789123591 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 1684778745 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 4229066268 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 1793278615 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 1312053665 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 893493426 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 688485709 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 3268710659 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 2869179059 as u64, "PCG reference vector");
    assert(((rng.nextU32() as u32) as u64) == 3985700761 as u64, "PCG reference vector");
    var i: i32 = 0;
    while (i < 4000) {
        let value = rng.nextFloat();
        assert(value >= 0.0 && value < 1.0, "std_scalar_contracts/main.vyx:65");
        let narrow = rng.range(-3, 5);
        assert(narrow >= -3 && narrow <= 5, "std_scalar_contracts/main.vyx:67");
        let wide = rng.rangeI64(-9223372036854775807 - 1, 9223372036854775807);
        let high = rng.rangeI64(9223372036854775700, 9223372036854775807);
        assert(high >= 9223372036854775700, "std_scalar_contracts/main.vyx:70");
        i += 1;
    }
}
fn main() -> i32 {
    conversion_contracts();
    bits_contracts();
    encoding_contracts();
    random_contracts();
    print("std scalar contracts ok");
    return 0;
}
