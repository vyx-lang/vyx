@[platform("__never__")] {
    fn never_block_value() -> i32 {
        return missing_symbol_from_inactive_platform_block;
    }
}

@[platform("windows")]
fn platform_value() -> i32 {
    return 1;
}

@[platform("linux")]
fn platform_value() -> i32 {
    return 2;
}

@[platform("android")]
fn platform_value() -> i32 {
    return 3;
}

@[platform("macos")]
fn platform_value() -> i32 {
    return 4;
}

@[platform("windows")]
fn posix_value() -> i32 {
    return 0;
}

@[platform("posix")]
fn posix_value() -> i32 {
    return 10;
}

fn main() -> i32 {
    return platform_value() - platform_value() + posix_value() - posix_value();
}
