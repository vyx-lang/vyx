module tests.std_openssl_package;

use std.security.openssl;

fn main() -> i32 {
    let digest = sha256("");
    if (digest != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
        print("unexpected sha256: " + digest);
        return 1;
    }
    print("std.security.openssl package ok");
    return 0;
}
