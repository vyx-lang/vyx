module tests.std_security_package;
use std.security.openssl;
use std.core;
use std.string;
fn main() -> i32 {
    assert(sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 known answer");
    assert(sha512("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "sha512 known answer");
    assert(sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 known answer");
    assert(md5("") == "d41d8cd98f00b204e9800998ecf8427e", "md5 known answer");
    assert(sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 known answer");
    assert(sha512("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512 known answer");
    assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 known answer");
    assert(md5("abc") == "900150983cd24fb0d6963f7d28e17f72", "md5 known answer");
    assert(sha256("A\0B") == "76fe3925c7167317f2df68454339f5ec3650e4062178b4f2be219b105a507907", "sha256 known answer");
    assert(sha512("A\0B") == "d0fa96648050c91087e326ba67566483f889507afb7d2389692026b162af6d659e377a215133736916967431e6ba6e70c3a9ab9a633d2607203224a17db62853", "sha512 known answer");
    assert(sha1("A\0B") == "83ba6f0e923331f201f370a1abea380d046ab3b3", "sha1 known answer");
    assert(md5("A\0B") == "4c75dbc403c8732c7b620f27a0c9548e", "md5 known answer");
    assert(sha256("Vyx语言") == "02d9fbbab3abed966d1b0ef35b3aca4c34ff6bb19c6144fcb4b5e06b9832a200", "sha256 known answer");
    assert(sha512("Vyx语言") == "983e0820c9a4dcfb1024374f4828f64fabe3246d4a247ae551b33a3c1b45776175de9a1e0d95c6a37fc1e0a7db9abf29d8b28379adb528234ebc0348ce4e3796", "sha512 known answer");
    assert(sha1("Vyx语言") == "34280e9a749db2cc113ad17a6961cf21e1e2145b", "sha1 known answer");
    assert(md5("Vyx语言") == "64c727f4f374d9c10921b8e948759fdb", "md5 known answer");
    assert(hmac_sha256("key\0x", "A\0B") == "891bc5819c8693acc187459245e2681e71f1b31e7e0b4fa83da3a9d63daf8ef7", "binary HMAC known answer");
    match (try_sha256("abc")) { Ok(value) => { assert(value.size() == 64, "owned digest result"); } Err(_) => { panic("SHA256 failed"); } }
    match (try_random_bytes(-1)) { Err(failure) => { assert(failure.code == crypto_error_invalid_input(), "negative random count"); } Ok(_) => { panic("negative random count accepted"); } }
    match (try_random_bytes(257)) { Err(failure) => { assert(failure.code == crypto_error_invalid_input(), "large random count"); } Ok(_) => { panic("large random count accepted"); } }
    match (try_random_bytes(0)) { Ok(value) => { assert(value.size() == 0, "empty random success"); } Err(_) => { panic("zero random count failed"); } }
    let random = random_bytes(32); assert(random.len == 64, "random hex length");
    let second = random_bytes(32); assert(second.len == 64, "second random hex length");
    match (try_random_int()) { Ok(_) => {} Err(_) => { panic("random integer failed"); } }
    print("std.security.openssl package ok");
    return 0;
}
