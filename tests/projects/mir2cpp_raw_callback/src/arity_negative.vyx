// NEGATIVE: the legacy integer callback adapter accepts at most one context argument.
fn bad_callback(first: rawptr, second: rawptr) -> i32 {
    if (first == second) { return 0; }
    return 1;
}

fn main() -> i32 {
    let callback = bad_callback as i64;
    if (callback == 0) { return 1; }
    return 0;
}
