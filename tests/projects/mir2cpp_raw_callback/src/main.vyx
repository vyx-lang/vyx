use std.vio;

var zero_arg_seen: i32 = 0;

fn zero_arg_callback() -> i32 {
    zero_arg_seen = 1;
    return 0;
}

fn context_callback(ctx: rawptr) -> i32 {
    ptr_write_i32(ctx, 42);
    return 0;
}

fn window_callback(hwnd: rawptr, msg: u32, wparam: u64, lparam: i64) -> rawptr {
    if (msg == 0 && wparam == 0 && lparam == 0) { return hwnd; }
    return null;
}

fn main() -> i32 {
    if ((window_callback as rawptr) == null) { return 1; }

    let zero_ptr = zero_arg_callback as rawptr;
    let zero_callback = zero_arg_callback as i64;
    if (zero_ptr == null || (zero_ptr as i64) == zero_callback) { return 4; }

    let zero_rc = vio_run_wait_ctx(zero_callback, null, 1000);
    if (zero_rc != 0 || zero_arg_seen != 1) { return 2; }

    var value: i32 = 0;
    let context_rc = vio_run_wait_ctx(context_callback as i64, to_rawptr(&value), 1000);
    if (context_rc != 0 || value != 42) { return 3; }

    print("mir2cpp_raw_callback OK");
    return 0;
}
