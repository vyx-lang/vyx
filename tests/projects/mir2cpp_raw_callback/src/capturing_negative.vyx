// NEGATIVE: a capturing closure has a hidden environment and cannot expose a raw address.
fn main() -> i32 {
    let captured: i32 = 7;
    let callback_ptr = (|ctx: rawptr| -> i32 {
        if (ctx == null) { return captured; }
        return 0;
    }) as rawptr;
    if (callback_ptr == null) { return 1; }
    return 0;
}
