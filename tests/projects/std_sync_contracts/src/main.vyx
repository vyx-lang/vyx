module tests.std_sync_contracts;

use std.channel;
use std.core;
use std.string;
use std.collections;
use std.threading;

var drops: i64 = 0;
class Payload {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn payload(id: i64) -> Payload {
    return Payload { id: id, text: String.from("channel payload larger than inline storage") };
}

fn scalar_contracts() {
    var small = Channel::<u8>.withCapacity(1);
    assert(small.send(231 as u8), "std_sync_contracts/main.vyx:21");
    assert(!small.send(17 as u8), "std_sync_contracts/main.vyx:22");
    match (small.recv()) { Some(v) => { assert(v == 231 as u8, "std_sync_contracts/main.vyx:23"); } None => { panic("missing u8"); } }
    match (small.try_recv()) {
        Err(e) => { match (e) { Empty => {} default => { panic("wrong empty state"); } } }
        Ok(_) => { panic("empty queue returned value"); }
    }
    small.close();
    assert(small.is_closed(), "std_sync_contracts/main.vyx:29");
    assert(!small.send(7 as u8), "std_sync_contracts/main.vyx:30");
    match (small.try_recv()) {
        Err(e) => { match (e) { Closed => {} default => { panic("wrong closed state"); } } }
        Ok(_) => { panic("closed empty queue returned value"); }
    }
    var wide = Channel::<i64>.withCapacity(3);
    var i: i64 = 0;
    while (i < 100) {
        assert(wide.send(4294967296 + i), "std_sync_contracts/main.vyx:38");
        match (wide.recv()) { Some(v) => { assert(v == 4294967296 + i, "std_sync_contracts/main.vyx:39"); } None => { panic("missing wide value"); } }
        i += 1;
    }
    wide.destroy();
    wide.destroy();
}

fn owning_contracts() {
    let before = drops;
    {
        var queue = Channel::<Payload>.withCapacity(1);
        assert(queue.send(payload(1)), "std_sync_contracts/main.vyx:50");
        {
            match (queue.try_send(payload(2))) {
                Err(rejected) => {
                    assert(!rejected.closed && rejected.get_ref().id == 2, "std_sync_contracts/main.vyx:54");
                    assert(rejected.get_ref().text.as_str() == "channel payload larger than inline storage", "std_sync_contracts/main.vyx:55");
                }
                Ok(_) => { panic("full channel accepted value"); }
            }
        }
        assert(drops == before + 1, "rejected send payload drop count");
        {
            match (queue.recv()) {
                Some(value) => { assert(value.id == 1, "std_sync_contracts/main.vyx:63"); assert(value.text.size() > 23, "std_sync_contracts/main.vyx:63"); }
                None => { panic("owning value missing"); }
            }
        }
        assert(drops == before + 2, "received payload drop count");
        assert(queue.send(payload(3)), "std_sync_contracts/main.vyx:68");
        queue.close();
        assert(!queue.send(payload(4)), "std_sync_contracts/main.vyx:70");
        assert(drops == before + 3, "closed send payload drop count");
        // The unread value belongs to the queue and must be destroyed once.
    }
    assert(drops == before + 4, "unread payload drop count");
    {
        var queue = Channel::<Payload>.withCapacity(1);
        queue.close();
        match (queue.try_send(payload(5))) {
            Err(rejected) => {
                assert(rejected.closed, "recover closed send");
                let recovered = rejected.into_inner();
                assert(recovered.id == 5, "recovered payload identity");
                assert(drops == before + 4, "recovery transfers ownership");
            }
            Ok(_) => { panic("closed channel accepted recovered value"); }
        }
    }
    assert(drops == before + 5, "recovered payload drops once");
    var text = Channel::<String>.withCapacity(2);
    assert(text.send(String.from("a full heap-backed String crosses the channel")), "std_sync_contracts/main.vyx:76");
    text.close();
    match (text.recv()) {
        Some(value) => { assert(value.as_str() == "a full heap-backed String crosses the channel", "std_sync_contracts/main.vyx:79"); }
        None => { panic("String missing after close"); }
    }
}

fn legacy_contracts() {
    var queue = channel_with_capacity(1);
    let handle = to_rawptr(&queue);
    assert(channel_is_empty(handle), "legacy queue starts empty");
    assert(channel_send(handle, 4294967297), "legacy send");
    assert(channel_is_full(handle) && channel_len(handle) == 1, "legacy queue full");
    assert(!channel_send(handle, 9), "legacy full send rejected");
    assert(channel_recv(handle) == 4294967297, "legacy wide receive");
    assert(channel_recv(handle) == 0, "legacy empty sentinel");
    channel_free(handle);
    channel_free(handle);
}

struct Producer {
    public queue: rawptr;
    public first: i64;
}

@[no_mangle]
fn channel_producer(context: rawptr) -> i64 {
    unsafe {
        let work = context as *Producer;
        let queue = (*work).queue as *Channel<i64>;
        var i: i64 = 0;
        while (i < 1000) {
            if ((*queue).send((*work).first + i)) { i += 1; }
            else { thread_yield(); }
        }
    }
    return 0;
}

fn parallel_contracts() {
    var queue = Channel::<i64>.withCapacity(7);
    var a = Producer { queue: to_rawptr(&queue), first: 0 };
    var b = Producer { queue: to_rawptr(&queue), first: 1000 };
    var c = Producer { queue: to_rawptr(&queue), first: 2000 };
    let ha = thread_spawn(channel_producer as rawptr, to_rawptr(&a));
    let hb = thread_spawn(channel_producer as rawptr, to_rawptr(&b));
    let hc = thread_spawn(channel_producer as rawptr, to_rawptr(&c));
    assert(ha != null && hb != null && hc != null, "std_sync_contracts/main.vyx:111");
    var seen = Vec::<i32>.zeroed(3000);
    var count: i64 = 0;
    while (count < 3000) {
        match (queue.recv()) {
            Some(value) => {
                assert(value >= 0 && value < 3000, "std_sync_contracts/main.vyx:117");
                assert(seen.get(value) == 0, "std_sync_contracts/main.vyx:118");
                seen.set(value, 1);
                count += 1;
            }
            None => { thread_yield(); }
        }
    }
    assert(thread_join_result(ha) == 0, "std_sync_contracts/main.vyx:125");
    assert(thread_join_result(hb) == 0, "std_sync_contracts/main.vyx:126");
    assert(thread_join_result(hc) == 0, "std_sync_contracts/main.vyx:127");
    assert(queue.isEmpty(), "std_sync_contracts/main.vyx:128");
}

fn main() -> i32 {
    scalar_contracts();
    owning_contracts();
    legacy_contracts();
    parallel_contracts();
    print("std.sync contracts ok");
    return 0;
}
