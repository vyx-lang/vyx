module tests.std_miniz_package;

use std.miniz;

fn main() -> i32 {
    let source = "miniz package: alpha beta gamma alpha beta gamma";
    var compressed: CompressedData;
    match (Compressor.compress_level(source, 9)) {
        case Ok(value) => { compressed = value; }
        case Err(err) => { print("compress failed: ${err.code} ${err.message}"); return 1; }
    }
    if (!compressed.valid() || compressed.len() <= 0 || compressed.original_len() != source.len) { return 2; }

    match (compressed.decompress_to_string(source.len - 1)) {
        case Err(err) => {
            if (err.code != miniz_error_output_too_small()) { return 3; }
        }
        case Ok(_) => { return 4; }
    }
    match (compressed.decompress_to_string(source.len)) {
        case Ok(text) => { if (text != source) { return 5; } }
        case Err(err) => { print("decompress failed: ${err.code} ${err.message}"); return 6; }
    }

    let copy = compressed.clone();
    compressed.destroy();
    compressed.destroy();
    match (copy.decompress_to_string(source.len)) {
        case Ok(text) => { if (text != source) { return 7; } }
        case Err(_) => { return 8; }
    }

    if (Compressor.crc32("123456789") != 3421780262) { return 9; }
    if (Compressor.adler32("123456789") != 152961502) { return 10; }
    if (Compressor.version().len == 0) { return 11; }
    match (Compressor.compress_level(source, 10)) {
        case Err(err) => { if (err.code != miniz_error_invalid_argument()) { return 12; } }
        case Ok(_) => { return 13; }
    }

    match (Compressor.compress("")) {
        case Ok(empty) => {
            if (empty.original_len() != 0) { return 14; }
            match (empty.decompress_to_string(0)) {
                case Ok(text) => { if (text != "") { return 15; } }
                case Err(_) => { return 16; }
            }
        }
        case Err(_) => { return 17; }
    }

    print("std.miniz package ok");
    return 0;
}
