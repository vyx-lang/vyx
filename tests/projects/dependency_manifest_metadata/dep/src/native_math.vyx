module tests.dependency_manifest_metadata.native_math;

extern "C" {
    fn dependency_native_scale_add(value: i32, bias: i32) -> i32;
    fn dependency_core_bias() -> i32;
}

public fn native_scale_add(value: i32, bias: i32) -> i32 {
    return dependency_native_scale_add(value, bias) + dependency_core_bias();
}
