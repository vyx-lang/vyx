module tests.dependency_manifest_metadata;

use tests.dependency_manifest_metadata.native_math;

fn main() -> i32 {
    let value = native_scale_add(9, 4);
    if (value != 85) {
        print("dependency metadata mismatch: ${value}");
        return 1;
    }
    print("dependency metadata ok: ${value}");
    return 0;
}
