module tests.std_time_faults;
use std.time;
extern "C" {
    fn time_fault_mode(mode: i32);
    fn time_fault_calls() -> i32;
    fn time_fault_milliseconds() -> u64;
}
@[platform("posix")]
fn platform_failures() {
    time_fault_mode(3);
    assert(try_monotonic_nanos().is_err(), "nanosecond overflow");
    time_fault_mode(7);
    assert(monotonic_nanos() == 9223372036854775807, "maximum valid nanoseconds");
    time_fault_mode(5);
    assert(try_sleep_ms(2000).is_ok() && time_fault_calls() == 2, "EINTR resumes remaining interval");
    assert(time_fault_milliseconds() == 1025 as u64, "retry uses remaining duration");
    time_fault_mode(6);
    assert(try_sleep_ms(20).is_err() && time_fault_calls() == 1, "permanent error must not retry");
}
@[platform("windows")]
fn platform_failures() {
    time_fault_mode(9);
    assert(try_monotonic_nanos().is_err(), "counter failure");
    time_fault_mode(0);
    assert(try_sleep_ms(4294967295).is_ok(), "chunked DWORD sleep");
    assert(time_fault_calls() == 2 && time_fault_milliseconds() == 4294967295 as u64, "no truncation or INFINITE sleep");
}
fn main() -> i32 {
    time_fault_mode(0);
    assert(monotonic_nanos() == 10123456789, "nanosecond scaling");
    time_fault_mode(1);
    assert(try_monotonic_nanos().is_err(), "no CPU clock substitution");
    time_fault_mode(2);
    assert(try_monotonic_nanos().is_err(), "invalid native clock value");
    time_fault_mode(4);
    assert(monotonic_nanos() == 999999999, "large frequency remainder scales without overflow");
    time_fault_mode(0);
    assert(try_sleep_ms(-1).is_err() && time_fault_calls() == 0, "negative checked sleep");
    assert(try_sleep_ms(0).is_ok() && time_fault_calls() == 0, "zero sleep");
    platform_failures();
    print("std time failure contracts ok");
    return 0;
}
