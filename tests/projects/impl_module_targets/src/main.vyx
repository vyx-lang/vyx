use impl_models.left;
use impl_models.right;
use impl_views.left;
use impl_views.right;
use impl_views.right_short;
use impl_models.state;
use impl_views.state;

fn main() -> i32 {
    let left = impl_models.left.Record { value: 42 };
    let right = impl_models.right.Record { prefix: 999, value: 17 };
    if (left.observe_left() != 42) { return 1; }
    if (right.observe_right() != 1017 || right.prefix != 999) { return 2; }
    if (left.read() != 42 || right.read() != 1017) { return 3; }
    if (right.observe_right_short() != 1027) { return 4; }
    let ready = Mode.Ready;
    let busy = Mode.Busy;
    if (ready.code() != 7 || busy.code() != 9) { return 5; }
    print("impl_module_targets: OK");
    return 0;
}
