class layout_alpha.Base {
    value: i32;
}

class layout_beta.Base {
    value: i64;
}

fn main() -> i32 {
    let alpha_size = sizeof::<layout_alpha.Base>();
    let beta_size = sizeof::<layout_beta.Base>();
    if (alpha_size == 0 || beta_size == 0) { return 1; }
    return alignof::<Base>() as i32;
}
