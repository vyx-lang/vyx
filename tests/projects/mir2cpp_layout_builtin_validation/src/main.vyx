extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, size: u64) -> rawptr;
}

class FourByteClass {
    public value: i32;
}

class EmptyClass {
}

class InnerClass {
    public value: i32;
}

class NestedClass {
    public inner: InnerClass;
    public tail: u8;
}

class ReprInner {
    public v0: i64;
    public v1: i64;
    public v2: i64;
    public v3: i64;
    public v4: i64;
    public v5: i64;
    public v6: i64;
    public v7: i64;
}

class ReprOuter {
    public inner: ReprInner;
    public tail: i64;
}

enum PayloadEnum {
    Empty,
    Small(i32),
    Wide(i64, u8),
}

fn main() -> i32 {
    if (sizeof::<i32>() != 4) { return 1; }
    if (alignof::<i32>() != 4) { return 2; }
    if (alignof::<FourByteClass>() != 8) { return 3; }
    if (alignof::<EmptyClass>() != 8) { return 4; }
    if (sizeof::<FourByteClass>() != 4) { return 5; }
    if (sizeof::<NestedClass>() != 16) { return 6; }
    if (sizeof::<string>() != 32) { return 7; }
    if (sizeof::<fn(i32) -> i32>() != 8) { return 8; }
    if (sizeof::<PayloadEnum>() != 24) { return 9; }
    if (alignof::<PayloadEnum>() != 8) { return 10; }

    var source = ReprOuter {
        inner: ReprInner {
            v0: 1,
            v1: 2,
            v2: 3,
            v3: 4,
            v4: 5,
            v5: 6,
            v6: 7,
            v7: 8
        },
        tail: 99
    };
    let repr_bytes = repr_sizeof::<ReprOuter>();
    if (repr_bytes < sizeof::<ReprOuter>()) { return 11; }
    let storage = malloc(repr_bytes as u64);
    if (storage == null) { return 12; }
    var copied: ReprOuter;
    unsafe {
        memcpy(storage, to_rawptr(&source), repr_bytes as u64);
        memcpy(to_rawptr(&copied), storage, repr_bytes as u64);
    }
    free(storage);
    if (copied.inner.v7 != 8) { return 13; }
    if (copied.tail != 99) { return 14; }
    return 0;
}
