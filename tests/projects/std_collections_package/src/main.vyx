module tests.std_collections_package;

use std.collections;
use std.core;
use std.ref;
use std.string;
use std.clone;
use std.defaults;

var drops: i64 = 0;
class OwnedEntry {
    public id: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn entry(id: i64) -> OwnedEntry {
    return OwnedEntry { id: id, text: String.from("owned project payload longer than inline storage") };
}
impl Default for OwnedEntry {
    static fn default_value() -> OwnedEntry { return entry(-1); }
}
impl Clone for OwnedEntry {
    fn clone(&self) -> OwnedEntry {
        return OwnedEntry { id: self.id, text: self.text.clone() };
    }
}

fn verify_owned_dictionary() -> i32 {
    let before = drops;
    {
        var values = Dict::<i64, OwnedEntry>.new();
        var i: i64 = 0;
        while (i < 80) { values.put(i, entry(i)); i += 1; }
        if (drops != before || values.len != 80) { return 20; }
        values.put(5, entry(105));
        if (drops != before + 1) { return 21; }
        {
            let copy = values.get(5);
            if (copy.id != 105 || copy.text.as_str() != "owned project payload longer than inline storage") { return 22; }
        }
        if (drops != before + 2) { return 23; }
        {
            let found = values.try_get(5);
            match (found) {
                Some(copy) => { if (copy.id != 105) { return 24; } }
                None => { return 25; }
            }
        }
        if (drops != before + 3) { return 26; }
        {
            let copies = values.values_vec();
            if (copies.len != 80) { return 27; }
        }
        if (drops != before + 83 || !values.remove(5)) { return 28; }
        if (drops != before + 84) { return 29; }
        values.clear();
        if (drops != before + 163 || values.len != 0) { return 30; }
        let slot = values.get_ptr(90);
        if ((*slot).text.as_str() != "owned project payload longer than inline storage") { return 31; }
    }
    if (drops != before + 164) { return 32; }
    return 0;
}

fn verify_owned_map_wrappers() -> i32 {
    let before = drops;
    {
        var values = HashMap::<i64, OwnedEntry>.new();
        values.put(1, entry(901));
        { let copy = values.get(1); if (copy.id != 901) { return 40; } }
        { let copies = values.values(); if (copies.get_ref(0).id != 901) { return 41; } }
        match (values.try_get(1)) {
            Some(copy) => { if (copy.id != 901) { return 42; } }
            None => { return 43; }
        }
    }
    if (drops != before + 4) { return 44; }
    {
        var values = StringMap::<OwnedEntry>.new();
        values.put("entry", entry(902));
        { let copy = values.get("entry"); if (copy.id != 902) { return 45; } }
    }
    if (drops != before + 6) { return 46; }
    return 0;
}

fn verify_owned_linear_containers() -> i32 {
    let before = drops;
    {
        var values = Stack::<OwnedEntry>.new();
        var i: i64 = 0;
        while (i < 64) { values.push(entry(i)); i += 1; }
        if (drops != before) { return 50; }
        { let item = values.pop(); if (item.id != 63) { return 51; } }
        values.set(0, entry(100));
        { let copy = values.peek(); if (copy.id != 62) { return 52; } }
        { let copy = values.clone(); if ((*copy.get_ptr(0)).id != 100) { return 53; } }
        if (drops != before + 66 || (*values.get_ptr(0)).text.as_str() != "owned project payload longer than inline storage") { return 54; }
        values.clear();
        if (drops != before + 129) { return 55; }
        values.push(entry(200));
    }
    if (drops != before + 130) { return 56; }
    let queue_before = drops;
    {
        var values = Queue::<OwnedEntry>.new();
        var i: i64 = 0;
        while (i < 64) { values.enqueue(entry(i)); i += 1; }
        i = 0;
        while (i < 20) {
            let item = values.dequeue();
            if (item.id != i) { return 57; }
            i += 1;
        }
        i = 64;
        while (i < 96) { values.enqueue(entry(i)); i += 1; }
        if (values.len() != 76 || drops != queue_before + 20) { return 58; }
        { let copy = values.peek(); if (copy.id != 20) { return 59; } }
        { let copy = values.get(75); if (copy.id != 95) { return 60; } }
        values.set(0, entry(100));
        { let copy = values.clone(); if ((*copy.get_ptr(0)).id != 100) { return 61; } }
        if (drops != queue_before + 99 || (*values.get_ptr(0)).text.as_str() != "owned project payload longer than inline storage") { return 62; }
        values.clear();
        if (drops != queue_before + 175) { return 63; }
        values.enqueue(entry(200));
    }
    if (drops != queue_before + 176) { return 64; }
    {
        let items = [entry(300), entry(301)];
        let pointer = to_rawptr(&items) as *OwnedEntry;
        { let values = Vec::<OwnedEntry>.from_array(pointer, 2); if (values.get_ref(1).id != 301) { return 65; } }
        { let values = Stack::<OwnedEntry>.from_array(pointer, 2); if ((*values.get_ptr(1)).id != 301) { return 66; } }
        { let values = Queue::<OwnedEntry>.from_array(pointer, 2); if ((*values.get_ptr(1)).id != 301) { return 67; } }
        if (items[0].text.as_str() != "owned project payload longer than inline storage") { return 68; }
    }
    if (drops != before + 314) { return 69; }
    return 0;
}

fn verify_owned_storage() -> i32 {
    {
        var items = Vec::<OwnedEntry>.new();
        var i: i64 = 0;
        while (i < 64) { items.push(entry(i)); i += 1; }
        if (drops != 0) { return 3; }
        items.insert(1, entry(100));
        items.set(0, entry(200));
        if (drops != 1) { return 4; }
        {
            let last = items.pop();
            if (last.id != 63 || last.text.as_str() != "owned project payload longer than inline storage") { return 5; }
        }
        if (drops != 2) { return 6; }
        var owner = Box::<Vec<OwnedEntry>>.new(items);
        if (owner.deref().len != 64) { return 7; }
        owner.deref_mut().push(entry(300));
    }
    if (drops != 67) { return 8; }
    {
        let shared = Ref::<OwnedEntry>.new(entry(500));
        {
            let other = shared.clone();
            if (other.deref().id != 500) { return 9; }
        }
        if (drops != 67 || shared.deref().text.as_str() != "owned project payload longer than inline storage") { return 10; }
    }
    if (drops != 68) { return 11; }
    return 0;
}

fn main() -> i32 {
    var values = Vec::<i32>.new();
    values.push(10);
    values.push(20);
    values.push(30);
    if (values.len != 3) { return 1; }
    if (values.get(0) != 10 || values.get(2) != 30) { return 2; }
    let ownership = verify_owned_storage();
    if (ownership != 0) { return ownership; }
    let dictionary = verify_owned_dictionary();
    if (dictionary != 0) { return dictionary; }
    let wrappers = verify_owned_map_wrappers();
    if (wrappers != 0) { return wrappers; }
    let linear = verify_owned_linear_containers();
    if (linear != 0) { return linear; }
    print("std.collections package ok");
    return 0;
}
