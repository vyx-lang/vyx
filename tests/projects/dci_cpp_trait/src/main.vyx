// C++ producer, open-generic inheritance, end to end.
//
// The consumer imports the producer trait OPEN (`class SinkG<T>`), closes it
// only by inheriting, and every instance below is materialized by the build's
// internal fixed point (compile -> sidecar requests -> dci_close_instances ->
// re-lower).  The contract carries no closed instance.
//
// Every call below is a direct virtual call on a Vyx-created stub object: the
// stub's vptr is the C++ template instance's real vtable with the override
// slots pointed at Vyx thunks, so each `consume` re-enters Vyx through C++
// linkage (the producer-driven direction is covered by dci-qt-counter).
@[repr(C)]
struct VyxBox {
    lo: i32;
    mid: i32;
    hi: i32;
}

@[dci_import("../contracts/sink.dcib")]
extern "dci" {
    // Imported producer records are declared `struct` (value semantics);
    // `class` would make them opaque DCI objects.  Values of an imported
    // record can only be produced/moved by DCI calls (the MIR verifier
    // requires a DCI call result constructed directly into final storage),
    // so construction goes through the producer's extern "C" helpers.
    struct Sample {
        public lo: u32;
        public hi: u32;
    };

    fn sample_make(lo: u32, hi: u32) -> Sample;
    fn sample_pass(s: Sample) -> Sample;

    class SinkG<T> {
        virtual fn consume(x: T) -> T;
    };
}

var g_calls: i32 = 0;

fn double_value(v: i32) -> i32 {
    g_calls = g_calls + 1;
    return v * 2;
}

// Row ①: a *closed* generic instance inherited by a concrete stub class.
class VyxHostI32 : SinkG<i32> {
    VyxHostI32() {
    }

    override fn consume(x: i32) -> i32 {
        return double_value(x);
    }
}

// Row ②: a *generic* Vyx stub class; each materialization gets its own
// closed instance and its own override thunk.
class VyxHostTG<T> : SinkG<T> {
    VyxHostTG() {
    }

    override fn consume(x: T) -> T {
        g_calls = g_calls + 1;
        return x;
    }
}

// Row ③: the consumer's own @[repr(C)] record as the generic argument.  Both
// sides measure the layout independently; 12 bytes = indirect + sret.
class VyxHostBox : SinkG<VyxBox> {
    VyxHostBox() {
    }

    override fn consume(b: VyxBox) -> VyxBox {
        g_calls = g_calls + 1;
        // Field reads on a DCI override's record parameter are not lowered
        // (sema types `b.lo` as rawptr), so the override proves the round
        // trip with a fresh literal instead; the caller checks every field
        // of what comes back through the sret path.
        return VyxBox { lo: 40, mid: 41, hi: 42 };
    }
}

// Row ④: a *producer-owned* record as the type argument of the inherited
// generic base.
class VyxHostSample : SinkG<Sample> {
    VyxHostSample() {
    }

    override fn consume(s: Sample) -> Sample {
        g_calls = g_calls + 1;
        // A DCI call result constructed directly into the return storage --
        // the only move shape the MIR verifier accepts for an imported record.
        return sample_pass(s);
    }
};

fn main() -> i32 {
    // ① direct virtual call through the C++ template instance's vtable
    var host = VyxHostI32();
    let sink = host as *SinkG<i32>;
    let r1 = (*sink).consume(21);
    if (r1 != 42) { return 1; }

    // ② generic stub class, closed at i64
    var host_i64 = VyxHostTG::<i64>();
    let sink_i64 = host_i64 as *SinkG<i64>;
    if ((*sink_i64).consume(55) != 55) { return 2; }

    // ③ consumer-owned repr(C) record
    var host_box = VyxHostTG::<VyxBox>();
    let sink_box = host_box as *SinkG<VyxBox>;
    let b = VyxBox { lo: 1, mid: 2, hi: 3 };
    let echoed = (*sink_box).consume(b);
    if (echoed.lo != 1 || echoed.mid != 2 || echoed.hi != 3) { return 3; }
    var hb = VyxHostBox();
    let biased = hb.consume(b);
    if (biased.lo != 40 || biased.mid != 41 || biased.hi != 42) { return 4; }

    // ④ producer record as the inherited base's type argument.  The generic
    // stub class is not closed at Sample (a generic body cannot name
    // Sample-specific helpers); the concrete class covers the row with both
    // the direct virtual call and the method call.
    var hs = VyxHostSample();
    let s = sample_make(9, 8);
    if (s.lo != 9 || s.hi != 8) { return 5; }
    let sink_sample = hs as *SinkG<Sample>;
    let echoed_s = (*sink_sample).consume(s);
    if (echoed_s.lo != 9 || echoed_s.hi != 8) { return 6; }

    if (g_calls < 5) { return 7; }
    print("dci_cpp_trait OK");
    return 0;
}
