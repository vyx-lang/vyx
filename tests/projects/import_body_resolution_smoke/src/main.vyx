// PROJECT-BUILD-ONLY: requires dep_a/dep_b package builds and generated .vyi interfaces.
module import_body_resolution_smoke;

use dep_a;
use dep_b;

public class Holder {
    private thing: Thing;

    public static fn create() -> Result<Holder, i32> {
        var thing: Thing;
        match (Thing.create()) {
            case Ok(v) => { thing = v; }
            case Err(_) => { return Err(1); }
        }
        return Ok(Holder { thing: thing });
    }

    public fn destroy() {
        self.thing.destroy();
    }
}

fn main() -> i32 {
    var holder: Holder;
    match (Holder.create()) {
        case Ok(v) => { holder = v; }
        case Err(code) => { return code; }
    }
    holder.destroy();
    return 0;
}
