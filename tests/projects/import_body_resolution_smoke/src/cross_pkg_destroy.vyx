// PROJECT-BUILD-ONLY: requires dep_a package and generated dep_a.vyi.
module import_body_resolution_smoke.cross_pkg_destroy;

use dep_a;

/// Verifies that imported type methods resolve in a secondary compilation unit.
public fn verify_thing_destroy_chain() -> i32 {
    var thing: Thing;
    match (Thing.create()) {
        case Ok(v) => { thing = v; }
        case Err(code) => { return code; }
    }
    thing.destroy();
    return 0;
}
