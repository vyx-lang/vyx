module tests.std_testing_contracts;

use std.testing;
use std.testing.mock;
use std.collections;
use std.core;

fn main() -> i32 {
    expect_true(true, "bool expectation");
    expect_false(false, "bool expectation");
    expect_true(7, "legacy integer expectation");
    expect_false(0, "legacy integer expectation");
    expect_equal(42, 42);
    var calls = Vec::<string>.new();
    calls.push("read"); calls.push("write"); calls.push("read");
    assert(mock_was_called(calls, "read"), "mock membership");
    assert(!mock_was_called(calls, "missing"), "mock missing call");
    assert(mock_call_count(calls, "read") == 2, "mock count");
    mock_assert_count(calls, "write", 1);
    var expected = Vec::<string>.new();
    expected.push("read"); expected.push("write");
    assert(mock_verify(calls, expected), "mock verification");
    assert(calls.len == 3 && calls.get(2) == "read", "queries preserve the log");
    assert(expected.len == 2, "verification preserves expectations");
    calls.push("finish");
    assert(mock_call_count(calls, "finish") == 1, "log remains mutable");
    print("std testing contracts ok");
    return 0;
}
