module editor.pricing;

use editor.catalog;
use calculate = editor.catalog.price;
use Record = editor.catalog.Item;

public fn invoice(record: Record) -> i32 {
    let price: i32 = 3;
    let surcharge: i32 = 1;
    {
        let price: i32 = 40;
        if (price != 40) { return -1; }
    }
    // price, calculate, Item and value in prose are not references.
    let caption = "price calculate Item value";
    return calculate(record.value) + price + surcharge;
}

public fn typed(record: editor.catalog.Item) -> editor.catalog.Item {
    return editor.catalog.identity::<editor.catalog.Item>(record);
}

public fn scale_invoice(value: i32) -> i32 {
    return editor.catalog.scale(value) + editor.catalog.scale(value, 3);
}

public fn alias_shadow(calculate: i32) -> i32 { return calculate + 1; }

// An unused body still participates in references and rename.
public fn preview(value: i32) -> string {
    let captured: i32 = 5;
    let adjust = [captured](extra: i32) => extra + captured;
    return f"预览 🧩 ${calculate(value) + adjust(1)}";
}
