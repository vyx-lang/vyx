module editor.catalog;

public class Item {
    public value: i32;
    public fn amount(self) -> i32 { return self.value; }
}

public enum Status { Ready, Pending }
public type Product = Item;
public const base_fee: i32 = 2;
public var requests: i32 = 0;

public fn price(value: i32) -> i32 {
    return value + base_fee;
}

public fn identity<T>(value: T) -> T { return value; }

public fn scale(value: i32) -> i32 { return value * 2; }
public fn scale(value: i32, factor: i32) -> i32 { return value * factor; }

public class Slot<T> {
    public value: T;
    public fn read(self) -> T { return self.value; }
}
