module editor.application;

use editor.catalog;
use editor.pricing;
use editor.shared;
use AuditRecord = editor.audit.Item;

fn main() -> i32 {
    let item = editor.catalog.Item { value: 5 };
    let audit = AuditRecord { value: 7 };
    if (editor.pricing.invoice(item) != 11) { return 1; }
    if (item.amount() != 5) { return 2; }
    if (audit.amount() != 107) { return 3; }
    if (editor.shared.delivery(2) != 4) { return 4; }
    if (editor.catalog.price(3) != 5) { return 5; }
    if (editor.pricing.scale_invoice(3) != 15) { return 6; }
    if (editor.pricing.alias_shadow(4) != 5) { return 8; }
    let slot = editor.catalog.Slot<i32> { value: 9 };
    if (slot.read() != 9) { return 9; }
    editor.catalog.requests = editor.catalog.requests + 1;
    if (editor.catalog.requests != 1) { return 7; }
    let status = editor.catalog.Status.Ready;
    let ready = editor.catalog.Status.Ready;
    return 0;
}
