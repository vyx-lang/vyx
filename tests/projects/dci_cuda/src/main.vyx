@[dci_import("../contracts/CudaOps.dcib")]

extern "dci" {
    // The provider is nvcc-compiled CUDA (native/cuda_ops.cu).  DCI sees only
    // the C++ class it was declared as in native/cuda_ops.hpp: no CUDA header,
    // no device type and no kernel launch crosses this boundary.
    class CudaVector {
        CudaVector(count: i32);
        ~CudaVector();
        public fn count() const -> i32;
        public fn fill_and_sum(base: f64) -> f64;
        public fn scale_and_sum(factor: f64) -> f64;
    };

    fn cuda_ops_device_count() -> i32;
    fn cuda_ops_last_error() -> i32;
}

fn main() -> i32 {
    let devices = cuda_ops_device_count();
    if (devices <= 0) {
        print("dci_cuda: FAILED (no CUDA device visible to the runtime)");
        return 1;
    }

    // sum(i for i in [0, 1024)) = 1023 * 1024 / 2
    let expected_filled = 523776.0;
    let expected_scaled = 1309440.0;

    {
        var vector = CudaVector(1024);
        if (vector.count() != 1024) { return 2; }

        // fill_kernel: data[i] = base + i, then sum_kernel on the device.
        let filled = vector.fill_and_sum(0.0);
        if (filled != expected_filled) { return 3; }

        // scale_kernel: data[i] *= factor, then reduced again on the device.
        let scaled = vector.scale_and_sum(2.5);
        if (scaled != expected_scaled) { return 4; }
    }

    {
        var vector = CudaVector(4);
        if (vector.count() != 4) { return 5; }
        // 4 * 1.5 + (0 + 1 + 2 + 3)
        if (vector.fill_and_sum(1.5) != 12.0) { return 6; }
    }

    if (cuda_ops_last_error() != 0) { return 7; }

    print("dci_cuda OK");
    return 0;
}
