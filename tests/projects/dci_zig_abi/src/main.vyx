@[dci_import("../contracts/native.dcib")]

extern "dci" {
    class native.Pair {
        public left: i32;
        public right: i32;
    };

    class native.Native {
        public flag: u8;
        public wide: u64;
    };

    fn pair_make(left: i32, right: i32) -> native.Pair;
    fn pair_sum(value: native.Pair) -> i32;
    fn c_mul(a: i32, b: i32) -> i32;
    fn native_heap() -> *native.Native;
    fn native_free(p: *native.Native);
    fn native_flag(value: *native.Native) -> u8;
}

fn main() -> i32 {
    let pair = pair_make(12, 34);
    if (pair.left != 12) { return 1; }
    if (pair.right != 34) { return 2; }
    if (pair_sum(pair) != 46) { return 3; }
    if (c_mul(6, 7) != 42) { return 4; }

    let native = native_heap();
    if (native.flag != 9) { return 5; }
    if (native.wide != 1) { return 6; }
    if (native_flag(native) != 9) { return 7; }
    native_free(native);

    print("dci_zig_abi OK");
    return 0;
}
