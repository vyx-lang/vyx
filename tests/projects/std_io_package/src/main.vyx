module tests.std_io_package;

// `std.vio` imports `std.ffi`; this project guards the complete transitive
// source-package closure rather than only the lightweight `std.io` facade.
use std.vio;
use std.string;

var drops: i32 = 0;
class Response {
    public body: String;
    public fn drop(&mut self) { drops += 1; self.body.drop(); }
}

@[async]
fn response() -> Response {
    await Task::<i32>.yield_now();
    return Response { body: String.from("completed request") };
}

fn main() -> i32 {
    {
        let pending = response();
        let value = await pending;
        if (value.body.as_str() != "completed request" || drops != 0) { return 1; }
    }
    if (drops != 1) { return 2; }
    {
        let unread = Promise::<Response>.ready(Response { body: String.from("discarded request") });
        let alias = unread.clone();
    }
    if (drops != 2) { return 3; }
    {
        let pending = Task::<str>.ready(str_dup("completed text"));
        let text = await (&pending);
        if (text != "completed text") { return 4; }
    }
    print("std.io package closure ok");
    return 0;
}
