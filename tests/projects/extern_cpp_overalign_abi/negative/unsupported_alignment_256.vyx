// MUST BE REJECTED, with the capability-boundary diagnostic (E3300), not the
// generic codegen failure (I0100).
//
// 256 bytes is the first alignment with no anchor: integers stop at i128 and
// the widest vector the target gives a matching ABI alignment to is
// `<16 x i64>` (128 bytes).  The descriptor is truthful, the input is
// well-formed, so this is a limit of the backend and the help text must say so
// rather than telling the user to file a compiler bug.
@[dci_import("../contracts/Overalign.dcib")]
extern "dci" {
    struct Over256 {
        public x: [u64; 32];
    };
}

@[repr(C)]
struct Holder256 {
    public tag: i32;
    public body: Over256;
}

fn main() -> i32 {
    var h: Holder256;
    return 0;
}
