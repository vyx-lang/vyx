// MUST COMPILE.  This surface is supported for alignas(64) as of the
// vector-anchor change; run.ps1 asserts it builds.  A regression here is
// a capability loss, not a relaxed gate.
use std.ref;

@[dci_import("../contracts/Overalign.dcib")]
extern "dci" {
    struct Over64 {
        public x: [u64; 8];
    };
}

fn main() -> i32 {
    let b = Box::<Over64>.new(Over64 { x: [1, 2, 3, 4, 5, 6, 7, 8] });
    return 0;
}
