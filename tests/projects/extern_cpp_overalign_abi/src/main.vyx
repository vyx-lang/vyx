// PROJECT-BUILD-ONLY: needs native/Overalign.cpp; the contract
// `contracts/Overalign.dcib` is derived from native/Overalign.hpp by the
// adapter in run.ps1 (no hand-written .dci text).
//
// All seven over-aligned ABI surfaces, end to end:
//
//   1  by value             oa64_make() -> Over64, then oa64_byval
//   2  pointer / reference  oa64_heap_new / byref / byref_mut / ptr_align
//   3  field embedding      producer side: oa64_nested_make / nested_read
//                           consumer side: Holder.body, whose address must be
//                           64-byte aligned because the record's alignment is
//                           64 and the field offset is rounded up to it
//   4  constructor          oa64_ctor_make -> OverCtor, then oa64_ctor_sum
//   5  return               the same oa64_make / nested_make / ctor_make
//   6  heap allocation      producer: oa64_heap_new; consumer: Box::<Big>
//   7  generic argument     Box::<Big> instantiates a generic over an
//                           explicitly 64-byte-aligned record
//
// `oa64_ptr_align` is the independent judge: it returns `pointer % 64`, and it
// lives in the producer, which never sees how Vyx allocated the object.

use std.ref;

@[dci_import("../contracts/Overalign.dcib")]
extern "dci" {
    struct Over16 {
        public x: [u64; 2];
    };

    struct Over64 {
        public x: [u64; 8];
    };

    struct Nested {
        public tag: i32;
        public body: Over64;
    };

    struct OverCtor {
        public x: [u64; 8];
    };

    // surface 2: pointer / reference.  The descriptor says `reference:
    // pointer`, so the consumer spells the parameter `*Over64` (a `&Over64`
    // borrow spelling does not match a pointer-referenced parameter).
    fn oa64_heap_new() -> *Over64;
    fn oa64_byref(p: *Over64) -> u64;
    fn oa64_byref_mut(p: *Over64) -> u64;
    fn oa64_ptr_align(p: *Over64) -> u64;
    fn oa64_heap_free(p: *Over64);

    // surfaces 1 (by value), 3 (producer-side embedding), 4 (constructor) and
    // 5 (return).
    fn oa64_make() -> Over64;
    fn oa64_byval(v: Over64) -> u64;
    fn oa64_nested_make() -> Nested;
    fn oa64_nested_read(n: *Nested) -> u64;
    fn oa64_ctor_make() -> OverCtor;
    fn oa64_ctor_sum(c: *OverCtor) -> u64;

    // The alignas(16) control, which must keep working.
    fn oa16_make() -> Over16;
    fn oa16_byval(v: Over16) -> u64;

    // Facts the producer measured, so the consumer can assert them.
    fn oa64_alignof() -> u64;
    fn oa64_sizeof() -> u64;
}

// surface 3, consumer side: a Vyx record embedding the over-aligned foreign
// record.  `body` must land on a 64-byte boundary, which only happens if the
// descriptor's alignment reaches the field-offset walk.
@[repr(C)]
struct Holder {
    public tag: i32;
    public body: Over64;
}

// surfaces 6 / 7, consumer side: a Vyx-side 64-byte-aligned class, boxed.  Its
// allocation goes through `vyx_aligned_alloc_abi(sizeof, alignof)`, so this
// fails unless `alignof` of an explicitly aligned record is honest.
@[align(64)]
class Big {
    public a: i64;
    public b: i64;
    public c: i64;
    public d: i64;
    public e: i64;
    public f: i64;
    public g: i64;
    public h: i64;
}

fn main() -> i32 {
    // The descriptor's numbers, and Vyx's own view of them.
    if (oa64_alignof() != 64) { return 1; }
    if (oa64_sizeof() != 64) { return 2; }
    if (alignof::<Over64>() != 64) { return 3; }
    if (sizeof::<Over64>() != 64) { return 4; }

    // surfaces 1 + 5: by value across the boundary, both directions.
    // x[i] = i + 1, folded as acc = acc * 31 + x[i].
    let made = oa64_make();
    if (oa64_byval(made) != 29377357956) { return 5; }

    // surface 3, producer side: tag = 7, body.x[i] = i + 100.
    let nested = oa64_nested_make();
    if (oa64_nested_read(&nested) != 114) { return 6; }

    // surface 4: the producer's constructor ran; x[i] = 5 + i.
    let ctor = oa64_ctor_make();
    if (oa64_ctor_sum(&ctor) != 68) { return 7; }

    // surfaces 2 + 6: an object the producer allocated with 64-byte alignment.
    let p = oa64_heap_new();
    if (p == null) { return 8; }
    if (oa64_ptr_align(p) != 0) { return 9; }
    if (oa64_byref(p) != 36) { return 10; }
    if (oa64_byref_mut(p) != 2) { return 11; }
    if (oa64_byref(p) != 44) { return 12; }
    oa64_heap_free(p);

    // The alignas(16) control.
    let v16 = oa16_make();
    if (oa16_byval(v16) != 11022) { return 13; }

    // surface 3, consumer side: the embedded field must be 64-byte aligned.
    var h: Holder;
    h.tag = 3;
    let hp = to_rawptr(&h.body) as *Over64;
    if (oa64_ptr_align(hp) != 0) { return 14; }

    // surfaces 6 + 7: Vyx allocates a 64-byte-aligned object, and the producer
    // confirms the address.
    let b = Box::<Big>.new(Big { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 });
    let bp = b.data as *Over64;
    if (oa64_ptr_align(bp) != 0) { return 15; }

    print("extern_cpp_overalign_abi OK");
    return 0;
}
