// The control: `alignas(16)` is representable -- the descriptor's `alignment`
// of 16 maps onto the i128 anchor -- so by value, return, field embedding and
// generic argument must all keep compiling.  run.ps1 asserts this probe builds
// cleanly, which is what makes the alignas(64) rejections a *limit* rather than
// a blanket refusal to handle over-aligned records.
use std.ref;

@[dci_import("../contracts/Overalign.dcib")]
extern "dci" {
    struct Over16 {
        public x: [u64; 2];
    };

    fn oa16_make() -> Over16;
    fn oa16_byval(v: Over16) -> u64;
}

@[repr(C)]
struct Holder16 {
    public tag: i32;
    public body: Over16;
}

class Wrap<T> {
    public v: T;
}

fn main() -> i32 {
    let a = oa16_make();
    if (oa16_byval(a) != 11022) { return 1; }
    var h: Holder16;
    var w: Wrap<Over16>;
    return 0;
}
