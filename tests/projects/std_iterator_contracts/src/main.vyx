module tests.std_iterator_contracts;
use std.core;
use std.collections;
use std.clone;
use std.hash;
use std.string;

var created: i64 = 0;
var dropped: i64 = 0;
var visited: i64 = 0;
class Item {
    public value: i64;
    public text: String;
    fn drop(&mut self) { dropped += 1; self.text.drop(); }
}
fn item(value: i64) -> Item {
    created += 1;
    return Item { value: value, text: String.from("iterator payload with independent owned string storage") };
}
impl Clone for Item { fn clone(&self) -> Item { return item(self.value); } }
impl Ord for Item {
    @[borrow_args]
    fn compare(&self, other: Item) -> i32 {
        if (self.value < other.value) { return -1; }
        if (self.value > other.value) { return 1; }
        return 0;
    }
}
fn double(value: Item) -> Item { return item(value.value * 2); }
fn odd(value: Item) -> bool { return value.value % 2 != 0; }
fn visit(value: Item) { visited += value.value; assert(value.text.size() > 23, "visitor owns a live copy"); }
fn take_value(value: Item) -> i64 { return value.value; }
fn borrow_value(value: &Item) -> i64 { return value.value; }
fn forward_value(value: Item) -> Item { return value; }

fn callback_contracts() {
    let before = dropped;
    {
        let callback: fn(Item) -> i64 = take_value;
        let value = item(42);
        assert(callback(value) == 42, "indirect call value");
        assert(dropped == before + 1, "indirect callee destroys transferred parameter");
        assert(callback(item(19)) == 19, "indirect temporary argument");
    }
    assert(dropped == before + 2, "indirect arguments do not drop twice");
    {
        let callback: fn(&Item) -> i64 = borrow_value;
        let value = item(7);
        assert(callback(&value) == 7 && value.value == 7, "reference callback preserves owner");
        assert(dropped == before + 2, "borrow callback does not destroy argument");
    }
    {
        let callback: fn(Item) -> Item = forward_value;
        let value = item(81);
        let returned = callback(value);
        assert(returned.value == 81 && returned.text.size() > 23, "callback returns moved owner");
        assert(dropped == before + 3, "returned callback parameter remains live");
    }
    assert(dropped == before + 4, "forwarded parameter destroyed once: ${dropped}, baseline ${before}");
}

fn make_owned_iterator() -> Iterator<Item> {
    var values = Vec::<Item>.new();
    values.push(item(3)); values.push(item(1)); values.push(item(2));
    var cursor = values.iter();
    let result = cursor.map::<Item>(double);
    assert(!cursor.has_next(), "map exhausts input cursor");
    return result;
}

fn adapter_contracts() {
    var values = Vec::<Item>.new();
    values.push(item(3)); values.push(item(1)); values.push(item(2));
    {
        var cursor = values.iter();
        var mapped = cursor.map::<Item>(double);
        let output = mapped.collect();
        assert(output.len == 3 && output.get_ref(0).value == 6 && output.get_ref(1).value == 2, "map and collect values");
        assert(!mapped.has_next(), "collect exhausts cursor");
        mapped.reset();
        match (mapped.next()) { Some(value) => { assert(value.value == 6, "owned iterator reset"); } None => { panic("reset lost data"); } }
    }
    {
        var cursor = values.iter();
        var selected = cursor.filter(odd);
        assert(selected.len == 2, "filter count");
        let output = selected.collect();
        assert(output.get_ref(0).value == 3 && output.get_ref(1).value == 1, "filter values");
    }
    {
        var cursor = values.iter();
        var first = cursor.take(1);
        assert(cursor.count() == 2, "take advances only requested count");
        let output = first.collect();
        assert(output.len == 1 && output.get_ref(0).value == 3, "take independent copy");
    }
    {
        var cursor = values.iter();
        var rest = cursor.skip(1);
        let output = rest.collect();
        assert(output.len == 2 && output.get_ref(0).value == 1, "skip values");
        assert(!cursor.has_next(), "skip exhausts source cursor");
    }
    {
        var cursor = values.iter();
        var none = cursor.take(-5);
        assert(none.count() == 0 && cursor.has_next(), "negative take is empty");
        var skipped = cursor.skip(9223372036854775807);
        assert(skipped.count() == 0 && !cursor.has_next(), "skip clamps without overflow");
    }
    {
        var cursor = values.iter();
        match (cursor.min()) { Some(value) => { assert(value.value == 1, "custom Ord min"); } None => { panic("min missing"); } }
        cursor.reset();
        match (cursor.max()) { Some(value) => { assert(value.value == 3, "custom Ord max"); } None => { panic("max missing"); } }
        cursor.reset(); cursor.for_each(visit);
        assert(visited == 6, "for_each values");
    }
    assert(values.get_ref(0).text.size() > 23 && values.len == 3, "adapters preserve source storage");
}

fn main() -> i32 {
    callback_contracts();
    adapter_contracts();
    assert(created == dropped, "all borrowed adapter clones and owned buffers destroyed");
    {
        var escaped = make_owned_iterator();
        match (escaped.next()) { Some(value) => { assert(value.value == 6, "adapter outlives original Vec"); } None => { panic("owned adapter empty"); } }
        // Unread adapter slots are still owned and must be destroyed.
    }
    assert(created == dropped, "owned iterator destroys unread payloads");
    print("std iterator contracts ok");
    return 0;
}
