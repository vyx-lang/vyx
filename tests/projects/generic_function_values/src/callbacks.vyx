module callback.library;

public fn identity<T>(value: T) -> T { return value; }
public fn step<T>(value: T) -> T { return value + 1; }
public fn identity_factory<T>() -> fn(T) -> T { return identity::<T>; }

// The importing caller also declares measure. This body must bind to this
// module's declaration after template artifacts have cleared AST pointers.
public fn measure(value: i64) -> i64 { return value + 5; }
public fn local_factory() -> fn(i64) -> i64 { return measure; }
