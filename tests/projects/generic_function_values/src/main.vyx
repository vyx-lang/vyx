module callback.application;

use std.core;
use std.collections;
use callback.library.identity as renamed;
use callback.library.identity_factory as make_identity;
use callback.library.step as increment;
use callback.library;

fn measure(value: i64) -> i64 { return value + 1000; }

fn main() -> i32 {
    let direct = renamed::<i64>;
    let returned = make_identity::<i64>();
    if (direct(4294967299) != 4294967299 || returned(4294967301) != 4294967301) { return 1; }
    var numbers = Vec::<i64>.new();
    numbers.push(10);
    numbers.push(20);
    let mapped = numbers.iter().map::<i64>(increment::<i64>);
    if (mapped.next().unwrap() != 11 || mapped.next().unwrap() != 21) { return 2; }
    let scoped = local_factory();
    if (scoped(37) != 42) { return 3; }
    print("generic function values ok");
    return 0;
}
