use visible_to_friend_package = visibility_semantics.api.visible_to_friend_package;
use visible_to_super_module = visibility_semantics.api.visible_to_super_module;
use public_world = visibility_semantics.api.public_world;

fn main() -> i32 {
    if (attr_world() != 11) { return 1; }
    if (composed_world() != 13) { return 2; }
    if (visible_to_parent_module() != 17) { return 3; }
    if (visible_to_friend_package() != 19) { return 4; }
    if (visible_to_super_module() != 23) { return 5; }
    if (public_world() != 86) { return 6; }
    return 0;
}
