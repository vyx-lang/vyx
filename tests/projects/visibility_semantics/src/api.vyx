module visibility_semantics.api;

fn same_unit_helper() -> i32 {
    return 3;
}

@[vis(world)]
fn attr_world() -> i32 {
    return 11;
}

public @[vis(world - in(visibility_semantics.blocked))]
fn composed_world() -> i32 {
    return 13;
}

public @[vis(in(visibility_semantics))]
fn visible_to_parent_module() -> i32 {
    return 17;
}

public @[vis(friend(visibility_semantics))]
fn visible_to_friend_package() -> i32 {
    return 19;
}

public @[vis(super)]
fn visible_to_super_module() -> i32 {
    return 23;
}

public fn public_world() -> i32 {
    return same_unit_helper()
        + attr_world()
        + composed_world()
        + visible_to_parent_module()
        + visible_to_friend_package()
        + visible_to_super_module();
}

public @[vis(mod)]
fn module_only() -> i32 {
    return 99;
}

public @[vis(none)]
fn hidden_none() -> i32 {
    return 100;
}
