module std_contracts.generic_library;
use std.core;
use std.collections;

public trait Reader<Element> { fn next() -> Option<Element>; }
public fn read_value<Value, Source>(source: Source) -> Option<Value> where Source: Reader<Value> {
    let result = source.next();
    return result;
}

class Cursor : Reader<i64> {
    public value: i64;
    public fn next() -> Option<i64> { return Some(self.value); }
}
fn add(a: i64, b: i64) -> i64 { return a + b; }

public fn exercise_generic_library() -> i64 {
    let cursor = Cursor { value: 4294967303 };
    var result: i64 = 0;
    match (read_value::<i64, Cursor>(cursor)) { Some(v) => { result = v; } None => { panic("reader missing"); } }
    var values = Vec::<i64>.new();
    values.push(1); values.push(2); values.push(3);
    let sum = fold::<i64, Iterator<i64>, i64>(values.iter(), 0, add);
    assert(sum == 6, "std_generic_contracts/library.vyx:24");
    return result;
}
