module tests.pattern_config;
use std.core;
use std.string;
use std.regex;
use std.uuid;
use std.serde.toml;

public class RouterConfig {
    public id: Uuid; public route: Regex; public port: i64;
    public fn drop() { self.route.destroy(); }
}
public fn load_router(text: string) -> Result<RouterConfig, String> {
    var doc: Toml;
    match (Toml.parse(text)) { Ok(value) => { doc = value; } Err(e) => { return Err(e.message); } }
    var server: Toml;
    match (doc.require("server")) { Ok(value) => { server = value; } Err(e) => { return Err(e.message); } }
    var id_text = String.empty();
    match (server.require("id")) {
        Ok(value) => { match (value.as_string()) { Ok(text) => { id_text = text; } Err(e) => { return Err(e.message); } } }
        Err(e) => { return Err(e.message); }
    }
    var id = Uuid.nil();
    match (Uuid.try_parse(id_text.as_str())) { Ok(value) => { id = value; } Err(_) => { return Err(String.from("invalid server.id")); } }
    var pattern = String.empty();
    match (server.require("route")) {
        Ok(value) => { match (value.as_string()) { Ok(text) => { pattern = text; } Err(e) => { return Err(e.message); } } }
        Err(e) => { return Err(e.message); }
    }
    var route: Regex;
    match (Regex.compile(pattern.as_str())) { Ok(value) => { route = value; } Err(e) => { return Err(e.message); } }
    var port: i64 = 0;
    match (server.require("port")) {
        Ok(value) => { match (value.as_i64()) { Ok(number) => { port = number; } Err(e) => { return Err(e.message); } } }
        Err(e) => { return Err(e.message); }
    }
    if (port < 1 || port > 65535) { return Err(String.from("server.port outside 1..65535")); }
    return Ok(RouterConfig { id: id, route: route, port: port });
}
