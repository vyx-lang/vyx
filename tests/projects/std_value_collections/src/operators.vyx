module tests.std_value_collections;
use std.hash;

class LazyCell<T> {
    public value: T;
    @[lazy]
    @[borrow_args]
    public fn operator_eq(&self, other: LazyCell<T>) -> bool where T: Eq {
        return self.value == other.value;
    }
}

fn lazy_operator_contract() {
    let a = LazyCell::<i64> { value: 1 };
    let b = LazyCell::<i64> { value: 1 };
    let c = LazyCell::<i64> { value: 2 };
    assert(a == b, "lazy generic equality materializes without a member call");
    assert(a != c, "lazy generic inequality uses equality");
    let number = OperatorChoice::<i64> { value: 1 };
    assert(number + (1 as i64) == 11, "integer operator overload");
    assert(number + (1.0 as f64) == 22, "floating operator overload");
    let generic = GenericOperator::<i64> { value: 1 };
    assert(generic + (1 as i32) == 4, "operator method template i32");
    assert(generic + (1 as i64) == 8, "operator method template i64");
    assert(generic + (1 as i32) == 4, "operator cache preserves earlier specialization");
}

class OperatorChoice<T> {
    public value: T;
    @[lazy]
    fn operator+(&self, rhs: i64) -> i64 { return 11; }
    @[lazy]
    fn operator+(&self, rhs: f64) -> i64 { return 22; }
}
class GenericOperator<T> {
    public value: T;
    @[lazy]
    fn operator+<U>(&self, rhs: U) -> i64 { return sizeof::<U>(); }
}
