module tests.std_value_collections;
use std.core;
use std.collections;
use std.hash;
use std.string;

var drops: i64 = 0;
var comparisons: i64 = 0;
class Record {
    public key: i64;
    public text: String;
    fn drop(&mut self) { drops += 1; self.text.drop(); }
}
fn record(key: i64) -> Record {
    return Record { key: key, text: String.from("record payload exceeds inline String capacity") };
}
impl Eq for Record {
    @[borrow_args]
    fn operator_eq(&self, other: Record) -> bool { return self.key == other.key; }
}
impl Hashable for Record { fn hash(&self) -> i64 { return hash_i64(self.key); } }
impl Ord for Record {
    @[borrow_args]
    fn compare(&self, other: Record) -> i32 {
        comparisons += 1;
        if (self.key < other.key) { return -1; }
        if (self.key > other.key) { return 1; }
        return 0;
    }
}

fn text_values() {
    var left = Vec::<string>.new();
    left.push("b".clone()); left.push("a\0z".clone()); left.push("a\0b".clone());
    var right = Vec::<string>.new();
    right.push("b".clone()); right.push("a\0z".clone()); right.push("a\0b".clone());
    assert(left == right, "Vec equality follows string contents");
    assert(left.hash() == right.hash(), "equal Vec values hash equally");
    assert(left.contains("a\0z"), "string membership uses contents");
    assert(left.indexOf("a\0b") == 2, "string index uses contents");
    assert(!left.contains("a\0c"), "membership compares bytes after NUL");
    left.sort();
    assert(left.get_ref(0) == "a\0b" && left.get_ref(1) == "a\0z" && left.get_ref(2) == "b", "string sort order");
    left.swap(0, 2);
    assert(left.get_ref(0) == "b", "owning swap");
}

fn numeric_values() {
    var signed = Vec::<i32>.new();
    signed.push(256); signed.push(-1); signed.push(1); signed.push(-500);
    signed.sort();
    assert(signed.get(0) == -500 && signed.get(1) == -1 && signed.get(2) == 1 && signed.get(3) == 256, "signed i32 ordering");
    assert(signed.sum() == -244, "signed numeric sum");
    var unsigned = Vec::<u64>.new();
    unsigned.push(18446744073709551615 as u64); unsigned.push(1 as u64); unsigned.push(9223372036854775808 as u64);
    unsigned.sort();
    assert(unsigned.get(0) == 1 && unsigned.get(1) == 9223372036854775808 as u64 && unsigned.get(2) == 18446744073709551615 as u64, "unsigned u64 ordering");
    var floating = Vec::<f64>.new();
    floating.push(2.5); floating.push(-4.0); floating.push(0.0); floating.push(1.25);
    floating.sort();
    assert(floating.get(0) == -4.0 && floating.get(3) == 2.5, "floating numeric order");
    assert(floating.sum() == -1, "compatibility sum converts values, not bit patterns");
    var zero = Vec::<f64>.new(); zero.push(0.0);
    var negative_zero = Vec::<f64>.new(); negative_zero.push(-0.0);
    assert(zero == negative_zero && zero.hash() == negative_zero.hash(), "signed zeros have equal values and hashes");
}

fn owning_values() {
    let before = drops;
    {
        var values = Vec::<Record>.new();
        var same = Vec::<Record>.new();
        values.push(record(2)); values.push(record(1));
        same.push(record(2)); same.push(record(1));
        assert(values == same && values.hash() == same.hash(), "custom equality/hash ignores independent storage");
        {
            let needle = record(1);
            assert(values.contains(needle) && values.indexOf(needle) == 1, "owning lookup borrows both arguments");
            assert(needle.text.size() > 23, "lookup preserves needle");
        }
        assert(drops == before + 1, "only lookup needle dropped");
        values.sort();
        assert(values.get_ref(0).key == 1 && values.get_ref(1).key == 2, "custom Ord sorting");
        assert(values.get_ref(0).text.size() > 23 && drops == before + 1, "sorting transfers storage without extra drops");
    }
    assert(drops == before + 5, "sorted owning values each drop once");
    {
        var values = Vec::<Record>.new();
        var i: i64 = 0;
        while (i < 4096) { values.push(record(i)); i += 1; }
        comparisons = 0;
        values.sort();
        assert(comparisons < 150000, "sorted input has bounded n log n comparison cost");
        i = 0;
        while (i < 4096) { assert(values.get_ref(i).key == i, "sorted record order"); i += 1; }
    }
    assert(drops == before + 4101, "large sorting destroys all records");
}

fn main() -> i32 {
    lazy_operator_contract(); text_values(); numeric_values(); owning_values();
    print("std value collections ok");
    return 0;
}
