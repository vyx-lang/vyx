module tests.mixed_c_cpp_vyx;

// PROJECT-BUILD-ONLY: requires native_helpers.c + native_helpers_cpp.cpp
// via Vyx.toml (exercises include_paths / cflags / cxxflags fields).

extern "C" {
    fn mixed_c_helper(x: i32) -> i32;
    fn mixed_cpp_helper(x: i32) -> i32;
}

fn main() -> i32 {
    // mixed_c_helper(10) should return 10 + MIXED_C_FLAG (=42) = 52
    let from_c = mixed_c_helper(10);
    if (from_c != 52) {
        print("FAIL: mixed_c_helper(10) = ${from_c}, expected 52");
        return 1;
    }

    // mixed_cpp_helper(10) should return 10 + MIXED_CXX_FLAG (=84) = 94
    let from_cpp = mixed_cpp_helper(10);
    if (from_cpp != 94) {
        print("FAIL: mixed_cpp_helper(10) = ${from_cpp}, expected 94");
        return 2;
    }

    print("OK c=${from_c} cpp=${from_cpp}");
    return 0;
}
