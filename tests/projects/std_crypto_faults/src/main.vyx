module tests.std_crypto_faults;
use std.security.openssl;
use std.core;
extern "C" {
    fn crypto_probe_mode(value: i32);
    fn crypto_probe_frees() -> i32;
}
fn digest_failure(mode: i32, expected_code: i32, expected_frees: i32) {
    crypto_probe_mode(mode);
    match (try_sha256("abc")) {
        Ok(_) => { panic("digest failure was accepted"); }
        Err(failure) => {
            assert(failure.code == expected_code, "digest failure kind");
            if (expected_code == crypto_error_backend()) {
                assert(failure.native_code == 4660 as u64, "native error retained");
            }
        }
    }
    assert(crypto_probe_frees() == expected_frees, "digest context freed exactly once");
}
fn main() -> i32 {
    digest_failure(0, crypto_error_allocation(), 0);
    digest_failure(1, crypto_error_backend(), 1);
    digest_failure(2, crypto_error_backend(), 1);
    digest_failure(3, crypto_error_backend(), 1);
    digest_failure(4, crypto_error_backend(), 1);
    crypto_probe_mode(5);
    match (try_hmac_sha256("key", "data")) { Err(_) => {} Ok(_) => { panic("HMAC failure was accepted"); } }
    crypto_probe_mode(6);
    match (try_random_bytes(32)) { Err(_) => {} Ok(_) => { panic("RAND failure exposed output bytes"); } }
    match (try_random_int()) { Err(_) => {} Ok(_) => { panic("RAND failure exposed an integer"); } }
    match (try_random_bytes(0)) { Ok(value) => { assert(value.size() == 0, "zero length needs no entropy call"); } Err(_) => { panic("zero length failed"); } }
    print("std crypto failure contracts ok");
    return 0;
}
