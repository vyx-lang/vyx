module BlockScopeRoot;

public var counter: i32 = 5;
public const LIMIT: i32 = 7;

module BlockLeft {
    use Selected = BlockRight;
    public var counter: i32 = 17;
    public const LIMIT: i32 = 19;

    public fn left_read() -> i32 { return counter + LIMIT; }
    public fn left_alias_read() -> i32 { return Selected::LIMIT; }
    public fn left_update(value: i32) -> i32 {
        counter = value;
        return counter + LIMIT;
    }

    module Nested {
        public var counter: i32 = 23;
        public const LIMIT: i32 = 29;

        public fn nested_read() -> i32 { return counter + LIMIT; }
        public fn nested_update(value: i32) -> i32 {
            counter = value;
            return counter + LIMIT;
        }
    }

    // The closing nested block restores BlockLeft's own bindings.
    public var left_snapshot: i32 = LIMIT;
    public fn left_after_nested() -> i32 { return counter + LIMIT; }
}

module BlockRight {
    use Selected = BlockLeft;
    public var counter: i32 = 31;
    public const LIMIT: i32 = 37;

    public fn right_read() -> i32 { return counter + LIMIT; }
    public fn right_alias_read() -> i32 { return Selected::LIMIT; }
    public fn right_update(value: i32) -> i32 {
        counter = value;
        return counter + LIMIT;
    }

    module ExplicitScope;
    public var counter: i32 = 41;
    public const LIMIT: i32 = 43;
    public fn explicit_read() -> i32 { return counter + LIMIT; }
    public fn explicit_update(value: i32) -> i32 {
        counter = value;
        return counter + LIMIT;
    }
}

// Reopening a logical module sees its existing storage, without redeclaring it.
module BlockLeft {
    public fn left_reopened() -> i32 { return counter + LIMIT; }
}

// Both the block and its inner semicolon scope have ended here.
public var root_snapshot: i32 = LIMIT;
public fn root_read() -> i32 { return counter + LIMIT; }
public fn root_update(value: i32) -> i32 {
    counter = value;
    return counter + LIMIT;
}
