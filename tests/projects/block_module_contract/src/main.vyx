// PROJECT-BUILD-ONLY: the gate also compiles this through an isolated .vyi.
module BlockScopeApp;
use BlockScopeRoot;

fn main() -> i32 {
    if (BlockScopeRoot::counter != 5 || BlockScopeRoot::LIMIT != 7) { return 1; }
    if (BlockLeft::counter != 17 || BlockLeft::LIMIT != 19) { return 2; }
    if (BlockLeft::Nested::counter != 23 || BlockLeft::Nested::LIMIT != 29) { return 3; }
    if (BlockRight::counter != 31 || BlockRight::LIMIT != 37) { return 4; }
    if (BlockRight::ExplicitScope::counter != 41 || BlockRight::ExplicitScope::LIMIT != 43) { return 5; }
    if (BlockScopeRoot::root_read() != 12) { return 6; }
    if (BlockLeft::left_read() != 36) { return 7; }
    if (BlockLeft::Nested::nested_read() != 52) { return 8; }
    if (BlockRight::right_read() != 68) { return 9; }
    if (BlockRight::ExplicitScope::explicit_read() != 84) { return 10; }

    // Qualified stores must update the storage seen by own-module bare reads.
    BlockScopeRoot::counter = 53;
    BlockLeft::counter = 59;
    BlockLeft::Nested::counter = 61;
    BlockRight::counter = 67;
    BlockRight::ExplicitScope::counter = 71;
    if (BlockScopeRoot::root_read() != 60) { return 11; }
    if (BlockLeft::left_read() != 78) { return 12; }
    if (BlockLeft::left_after_nested() != 78) { return 13; }
    if (BlockLeft::left_reopened() != 78) { return 14; }
    if (BlockLeft::Nested::nested_read() != 90) { return 15; }
    if (BlockRight::right_read() != 104) { return 16; }
    if (BlockRight::ExplicitScope::explicit_read() != 114) { return 17; }

    // Bare stores inside each module must remain independent of every peer.
    if (BlockScopeRoot::root_update(73) != 80) { return 18; }
    if (BlockLeft::left_update(79) != 98) { return 19; }
    if (BlockLeft::Nested::nested_update(83) != 112) { return 20; }
    if (BlockRight::right_update(89) != 126) { return 21; }
    if (BlockRight::ExplicitScope::explicit_update(97) != 140) { return 22; }
    if (BlockScopeRoot::counter != 73 || BlockScopeRoot::LIMIT != 7) { return 23; }
    if (BlockLeft::counter != 79 || BlockLeft::LIMIT != 19) { return 24; }
    if (BlockLeft::Nested::counter != 83 || BlockLeft::Nested::LIMIT != 29) { return 25; }
    if (BlockRight::counter != 89 || BlockRight::LIMIT != 37) { return 26; }
    if (BlockRight::ExplicitScope::counter != 97 || BlockRight::ExplicitScope::LIMIT != 43) { return 27; }
    if (BlockLeft::left_after_nested() != 98 || BlockLeft::left_reopened() != 98) { return 28; }
    if (BlockScopeRoot::root_snapshot != 7 || BlockLeft::left_snapshot != 19) { return 29; }
    if (BlockLeft::left_alias_read() != 37 || BlockRight::right_alias_read() != 19) { return 30; }
    print("block module contract OK");
    return 0;
}
