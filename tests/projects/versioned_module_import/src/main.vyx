use Add;

fn main() -> i32 {
    if (add(1, 2) != 30) { return 1; }

    let t = Test();
    if (t.m != 1) { return 2; }
    // `n` is a compatibility spelling for the same storage slot as `m`.
    if (t.n != 1) { return 11; }
    if (t.added != 0) { return 12; }
    if (t.add(1, 2) != 3) { return 3; }
    if (t.add(1, 2, 3) != 6) { return 4; }
    if (t.add2(1, 2) != 30) { return 5; }
    if (t.add2@1.0.0["_1"](1, 2) != 3) { return 6; }
    if (t.add2@2.0.0(1, 2) != 30) { return 7; }
    if (t.add3(1, 2) != 3) { return 8; }
    if (t.add4@1.0.0["_1"](1, 2) != 3) { return 9; }
    if (t.both_fields() != 2) { return 10; }
    return 0;
}
