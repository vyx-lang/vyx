@[version("2.0.0")]
@[variant("_1")]
module Add;

@[migrate(fromVer="1.0.0", desc="use new add", fromSig=fn add(i32,i32)->i32)]
public fn add(a: i32, b: i32) -> i32 {
    return (a + b) * 10;
}

public class Test {
    @[migrate(fromVer="1.0.0", fromField="n")]
    public m: i64;

    // A field-level migrate without fromField is an explicit addition. It
    // must not consume a historical slot merely because a source version is
    // named.
    @[migrate(fromVer="1.0.0")]
    public added: i32;

    @[migrate(fromVer="1.0.0")]
    public Test() {
        self.m = self.add3(1, self.n);
    }

    @[migrate(fromVer="1.0.0", fromSig=fn (i32,i32)->i32)]
    public fn add(self, a: i32, b: i32, c: i32) -> i32 {
        return a + b + c;
    }

    @[migrate(fromVer="1.0.0", fromSig=fn add2(i32,i32)->i32)]
    public fn add2(self, a: i32, b: i32) -> i32 {
        return (a + b) * 10;
    }

    @[discard(fromVer="1.0.0", desc="removed")]
    public fn add4(self, a: i32, b: i32) -> i32;

    public fn both_fields(self) -> i64 {
        return self.m + (self.n as i64);
    }
}
