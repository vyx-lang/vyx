@[version("1.0.0")]
@[variant("_1")]
module Add;

public fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

public class Test {
    public n: i32;

    public Test() {
        self.n = 1;
    }

    public fn add(self, a: i32, b: i32) -> i32 {
        return a + b;
    }

    public fn add2(self, a: i32, b: i32) -> i32 {
        return a + b;
    }

    public fn add3(self, a: i32, b: i32) -> i32 {
        return a + b;
    }

    public fn add4(self, a: i32, b: i32) -> i32 {
        return a + b;
    }
}
