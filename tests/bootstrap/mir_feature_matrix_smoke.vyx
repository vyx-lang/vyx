use std.ffi;
use std.fmt;
use std.hash;
use std.algorithm;
use std.defaults;
use std.num;
use std.reflect;
use std.vio;

type Getter = fn() -> i32;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memmove(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
    fn strlen(s: rawptr) -> i64;
}

class SymOps {
    public value: i32;

    public fn operator+(self, other: SymOps) -> SymOps { return SymOps { value: self.value + other.value }; }
    public fn operator-(self, other: SymOps) -> SymOps { return SymOps { value: self.value - other.value }; }
    public fn operator*(self, other: SymOps) -> SymOps { return SymOps { value: self.value * other.value }; }
    public fn operator/(self, other: SymOps) -> SymOps { return SymOps { value: self.value / other.value }; }
    public fn operator%(self, other: SymOps) -> SymOps { return SymOps { value: self.value % other.value }; }
    public fn operator&(self, other: SymOps) -> SymOps { return SymOps { value: self.value & other.value }; }
    public fn operator|(self, other: SymOps) -> SymOps { return SymOps { value: self.value | other.value }; }
    public fn operator^(self, other: SymOps) -> SymOps { return SymOps { value: self.value ^ other.value }; }
    public fn operator<<(self, other: SymOps) -> SymOps { return SymOps { value: self.value << other.value }; }
    public fn operator>>(self, other: SymOps) -> SymOps { return SymOps { value: self.value >> other.value }; }
    public fn operator<(self, other: SymOps) -> bool { return self.value < other.value; }
    public fn operator>(self, other: SymOps) -> bool { return self.value > other.value; }
    public fn operator<=(self, other: SymOps) -> bool { return self.value <= other.value; }
    public fn operator>=(self, other: SymOps) -> bool { return self.value >= other.value; }
    public fn operator==(self, other: SymOps) -> bool { return self.value == other.value; }
    public fn operator!=(self, other: SymOps) -> bool { return self.value != other.value; }
    public fn operator[](self, idx: i32) -> i32 { return self.value + idx; }
    public fn operator+=(self, other: SymOps) -> SymOps {
        self.value = self.value + other.value;
        return self;
    }
}

class LegacyOps {
    public value: i32;

    public fn operator_add(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value + other.value }; }
    public fn operator_sub(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value - other.value }; }
    public fn operator_mul(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value * other.value }; }
    public fn operator_div(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value / other.value }; }
    public fn operator_mod(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value % other.value }; }
    public fn operator_band(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value & other.value }; }
    public fn operator_bor(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value | other.value }; }
    public fn operator_bxor(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value ^ other.value }; }
    public fn operator_shl(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value << other.value }; }
    public fn operator_shr(self, other: LegacyOps) -> LegacyOps { return LegacyOps { value: self.value >> other.value }; }
    public fn operator_lt(self, other: LegacyOps) -> bool { return self.value < other.value; }
    public fn operator_gt(self, other: LegacyOps) -> bool { return self.value > other.value; }
    public fn operator_le(self, other: LegacyOps) -> bool { return self.value <= other.value; }
    public fn operator_ge(self, other: LegacyOps) -> bool { return self.value >= other.value; }
    public fn operator_eq(self, other: LegacyOps) -> bool { return self.value == other.value; }
    public fn operator_ne(self, other: LegacyOps) -> bool { return self.value != other.value; }
    public fn operator_index(self, idx: i32) -> i32 { return self.value + idx; }
    public fn operator_add_assign(self, other: LegacyOps) -> LegacyOps {
        self.value = self.value + other.value;
        return self;
    }
}

@[reflect]
public class ReflectBox {
    public value: i32;

    public fn get(self) -> i32 {
        return self.value;
    }
}

fn defaulted<T>() -> T where T: Default {
    return T::default_value();
}

fn zero_of<T>() -> T where T: Zero {
    return T::zero();
}

fn one_of<T>() -> T where T: One {
    return T::one();
}

fn add_one<T>(value: T) -> T where T: Num {
    return value + T::one();
}

async fn async_answer() -> i32 {
    return 42;
}

fn test_memory() -> i32 {
    let p = malloc(32);
    if (p == null) { return 101; }
    memset(p, 0, 32);
    ptr_write_i32(p, 1234567);
    if (ptr_read_i32(p) != 1234567) { free(p); return 102; }
    ptr_write_i64(ptr_offset(p, 8), 1234567890123 as i64);
    if (ptr_read_i64(ptr_offset(p, 8)) != 1234567890123 as i64) { free(p); return 103; }
    let q = malloc(32);
    if (q == null) { free(p); return 104; }
    memcpy(q, p, 32);
    if (memcmp(p, q, 16) != 0) { free(q); free(p); return 105; }
    free(q);
    free(p);

    let m = malloc(16);
    if (m == null) { return 106; }
    memcpy(m, "abcdef".c_str(), 7);
    memmove(m + 2, m, 3);
    let moved = from_cstr_len(m, 6);
    if (moved != "ababcf") { free(m); return 107; }
    var r = realloc(m, 32);
    if (r == null) { free(m); return 108; }
    if (from_cstr_len(r, 6) != "ababcf") { free(r); return 109; }
    free(r);

    let s = "hello";
    if (strlen(s.c_str()) != 5) { return 110; }
    if (from_cstr(s.c_str()) != "hello") { return 111; }
    if (from_cstr_len(s.c_str(), 3) != "hel") { return 112; }
    if (from_cstr_view_len(s.c_str() + 1, 3) != "ell") { return 113; }
    let raw = malloc(6);
    if (raw == null) { return 114; }
    memcpy(raw, "owned".c_str(), 6);
    let owned = from_raw_string_parts(raw, 5, 6, 1);
    if (owned != "owned") { return 115; }
    return 0;
}

fn test_std_helpers() -> i32 {
    if (i64_to_string(-42 as i64) != "-42") { return 201; }
    if (i32_to_string(17) != "17") { return 202; }
    if (f64_to_string(3.5) != "3.5") { return 203; }
    if (char_to_string(65 as char) != "A") { return 204; }
    if (hash_i32(123) == 0) { return 205; }
    if (hash_i64(123 as i64) == 0) { return 206; }
    if (fnv1a("abc") != hash_string("abc")) { return 207; }
    if (fnv1a_32("abc") == 0) { return 208; }
    if (fnv1a_bytes("abc".c_str(), 3) != hash_bytes("abc".c_str(), 3)) { return 209; }
    let parts = str_split("a,b,c", ",");
    if (parts.size() != 3) { return 210; }
    if (parts.get(0) != "a" || parts.get(1) != "b" || parts.get(2) != "c") { return 211; }
    return 0;
}

fn test_defaults() -> i32 {
    if (defaulted::<i32>() != 0) { return 301; }
    if (defaulted::<i64>() != 0 as i64) { return 302; }
    if (defaulted::<bool>() != false) { return 303; }
    if (defaulted::<string>() != "") { return 304; }
    if (zero_of::<i32>() != 0) { return 305; }
    if (one_of::<i32>() != 1) { return 306; }
    if (add_one::<i32>(41) != 42) { return 307; }
    return 0;
}

fn test_operators() -> i32 {
    let a = SymOps { value: 10 };
    let b = SymOps { value: 3 };
    if ((a + b).value != 13) { return 401; }
    if ((a - b).value != 7) { return 402; }
    if ((a * b).value != 30) { return 403; }
    if ((a / b).value != 3) { return 404; }
    if ((a % b).value != 1) { return 405; }
    if ((a & b).value != 2) { return 406; }
    if ((a | b).value != 11) { return 407; }
    if ((a ^ b).value != 9) { return 408; }
    if ((a << b).value != 80) { return 409; }
    if ((a >> b).value != 1) { return 410; }
    if (!(b < a)) { return 411; }
    if (!(a > b)) { return 412; }
    if (!(b <= a)) { return 413; }
    if (!(a >= b)) { return 414; }
    if (!(a == SymOps { value: 10 })) { return 415; }
    if (!(a != b)) { return 416; }
    if (a[5] != 15) { return 417; }
    var c = SymOps { value: 2 };
    c += SymOps { value: 5 };
    if (c.value != 7) { return 418; }

    let la = LegacyOps { value: 10 };
    let lb = LegacyOps { value: 3 };
    if ((la + lb).value != 13) { return 451; }
    if ((la - lb).value != 7) { return 452; }
    if ((la * lb).value != 30) { return 453; }
    if ((la / lb).value != 3) { return 454; }
    if ((la % lb).value != 1) { return 455; }
    if ((la & lb).value != 2) { return 456; }
    if ((la | lb).value != 11) { return 457; }
    if ((la ^ lb).value != 9) { return 458; }
    if ((la << lb).value != 80) { return 459; }
    if ((la >> lb).value != 1) { return 460; }
    if (!(lb < la)) { return 461; }
    if (!(la > lb)) { return 462; }
    if (!(lb <= la)) { return 463; }
    if (!(la >= lb)) { return 464; }
    if (!(la == LegacyOps { value: 10 })) { return 465; }
    if (!(la != lb)) { return 466; }
    if (la[5] != 15) { return 467; }
    var lc = LegacyOps { value: 2 };
    lc += LegacyOps { value: 5 };
    if (lc.value != 7) { return 468; }
    return 0;
}

fn test_reflection() -> i32 {
    let rn = reflect_name::<ReflectBox>();
    if (!rn.contains("ReflectBox")) { return 501; }
    let manifest = reflect_manifest();
    if (!manifest.contains("ReflectBox")) { return 502; }
    let ty = Type.of::<ReflectBox>();
    if (!ty.valid) { return 503; }
    let f = ty.getField("value");
    if (!f.valid || f.type_name != "i32") { return 504; }
    var box = ReflectBox { value: 9 };
    var inst = Instance.from::<ReflectBox>(box);
    if (!inst.valid) { return 505; }
    let prop = inst.getProperty("value");
    if (!prop.valid) { return 506; }
    if (prop.view::<i32>() != 9) { return 507; }
    prop.write::<i32>(11);
    let viewed = inst.view::<ReflectBox>();
    if (viewed.value != 11) { return 508; }
    let method = inst.getMethod("get");
    if (!method.valid) { return 509; }
    if (method.asRaw() == null) { return 510; }
    let getter = method.as::<Getter>();
    if (getter() != 11) { return 511; }
    inst.destroy();
    return 0;
}

fn test_async() -> i32 {
    let t = Task::<i32>.ready(17);
    let v = await t;
    if (v != 17) { return 601; }
    let t2 = async_answer();
    let v2 = await t2;
    if (v2 != 42) { return 602; }
    return 0;
}

fn main() -> i32 {
    var rc = test_memory();
    if (rc != 0) { return rc; }
    rc = test_std_helpers();
    if (rc != 0) { return rc; }
    rc = test_defaults();
    if (rc != 0) { return rc; }
    rc = test_operators();
    if (rc != 0) { return rc; }
    rc = test_reflection();
    if (rc != 0) { return rc; }
    rc = test_async();
    if (rc != 0) { return rc; }
    return 0;
}
