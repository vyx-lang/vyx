module tests.receiver_modes_smoke;

var g_owned_drop_count: i32 = 0;

class ReceiverProbe {
    public value: i32;

    public fn compat(self) -> i32 {
        self.value = self.value + 1;
        return self.value;
    }

    public fn shared(&self) -> i32 {
        return self.value;
    }

    public fn mutate(&mut self) -> i32 {
        self.value = self.value + 2;
        return self.value;
    }

    public fn consume(own self) -> i32 {
        return self.value;
    }

    public fn consume_mut(mut self) -> i32 {
        self.value = self.value + 1;
        return self.value;
    }
}

class OwnedReceiverProbe {
    public value: i32;

    public fn consume(own self) -> i32 {
        return self.value;
    }

    public fn drop(self) {
        g_owned_drop_count = g_owned_drop_count + 1;
    }
}

fn main() -> i32 {
    var probe = ReceiverProbe { value: 1 };
    if (probe.shared() != 1) { return 1; }
    if (probe.mutate() != 3) { return 2; }
    if (probe.compat() != 4) { return 3; }
    if (probe.consume() != 4) { return 4; }
    var probe2 = ReceiverProbe { value: 1 };
    if (probe2.consume_mut() != 2) { return 7; }
    let owned = OwnedReceiverProbe { value: 9 };
    if (owned.consume() != 9) { return 5; }
    if (g_owned_drop_count != 1) { return 6; }
    return 0;
}
