enum SmokeSignal {
    Low,
    High,
    Z,
    X,

    public fn to_i32(self) -> i32 {
        match (self) {
            case 0 => { return 0; }
            case 1 => { return 1; }
            case 2 => { return 2; }
            default => { return 3; }
        }
    }
}

class MetaBox {
    public x: i32;
    public y: i64;

    public fn inc(self) -> i32 {
        return self.x + 1;
    }
}

fn main() -> i32 {
    let sz = sizeof::<MetaBox>();
    let al = alignof::<MetaBox>();
    let tn = type_name::<MetaBox>();
    let ti = typeinfo(123);
    let fc = field_count::<MetaBox>();
    let fn0 = field_name::<MetaBox>(0);
    let ft1 = field_type::<MetaBox>(1);
    let p = alloc(8 as u64);
    let q = transmute(p);
    let sample = "alpha beta";
    let data = sample.data;
    let cnt = sample.count;
    let cloned = sample.clone();
    let pos = sample.find("beta");
    let same = sample.equals(cloned);
    let sub = sample.substr(0, 5);
    let ch = sample.charCodeAt(0);
    let rep = "ab".repeat(3);
    let has = sample.contains("ha");
    let sw = sample.startsWith("alpha");
    let ew = sample.endsWith("beta");
    let empty = "".isEmpty();
    let trimmed = "  hi  ".trim();
    let upper = "Az".toUpper();
    let lower = "Az".toLower();
    let repl = "a-b-a".replace("-", "+");
    let fmt = format("%d:%s:%c", 7, "ok", 33);
    let hv = hash(123);
    let cmp_i = compare(2, 5);
    let cmp_s = compare("a", "b");
    let zero_box = MetaBox.new();
    let sig = SmokeSignal::Z();
    let sig_i = sig.to_i32();
    let its = int_to_string(42);
    let bts = bool_to_string(true);
    var seen_fields = 0;
    foreach (idx in MetaBox.fields) {
        seen_fields = seen_fields + 1;
    }
    var seen_methods = 0;
    foreach (idx in MetaBox.methods) {
        seen_methods = seen_methods + 1;
    }
    dealloc(q);
    assert(sz > 0);
    assert_eq(fc, 2);
    print(tn);
    print(ti);
    print(fn0);
    print(ft1);
    if (al <= 0) { return 1; }
    if (data == null) { return 2; }
    if (cnt != 10) { return 3; }
    if (pos != 6) { return 4; }
    if (!same) { return 5; }
    if (sub != "alpha") { return 6; }
    if (ch != 97) { return 7; }
    if (rep != "ababab") { return 8; }
    if (!has) { return 9; }
    if (!sw) { return 10; }
    if (!ew) { return 11; }
    if (!empty) { return 12; }
    if (trimmed != "hi") { return 13; }
    if (upper != "AZ") { return 14; }
    if (lower != "az") { return 15; }
    if (repl != "a+b+a") { return 16; }
    if (fmt != "7:ok:!") { return 17; }
    if (hv == 0) { return 18; }
    if (cmp_i >= 0) { return 19; }
    if (cmp_s >= 0) { return 20; }
    if (zero_box.x != 0 || zero_box.y != 0) { return 21; }
    if (sig_i != 2) { return 22; }
    if (its != "42") { return 23; }
    if (bts != "true") { return 24; }
    if (seen_fields != 2) { return 25; }
    if (seen_methods <= 0) { return 26; }
    return 0;
}
