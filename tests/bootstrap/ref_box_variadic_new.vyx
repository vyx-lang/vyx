use std.ref;

var factory_calls: i32 = 0;
var box_payload_drops: i32 = 0;
var ref_payload_drops: i32 = 0;

class Pair {
    public left: i32;
    public right: i32;

    public Pair(left: i32, right: i32) {
        self.left = left;
        self.right = right;
    }
}

class FactoryShadow {
    public value: i32;

    public FactoryShadow(value: i32) {
        self.value = value;
    }

    public static fn new(value: i32) -> FactoryShadow {
        factory_calls = factory_calls + 1;
        return FactoryShadow { value: value + 1000 };
    }
}

class Overloaded {
    public value: i64;

    public Overloaded(value: i32) {
        self.value = value as i64;
    }

    public Overloaded(left: i64, right: i64) {
        self.value = left * 100 + right;
    }
}

class BoxPayload {
    public value: i32;

    public BoxPayload(value: i32) {
        if (value != 31) { panic("Box constructor forwarding failed"); }
        self.value = value;
    }

    public fn drop() {
        box_payload_drops = box_payload_drops + 1;
    }
}

class RefPayload {
    public value: i32;

    public RefPayload(value: i32) {
        if (value != 47) { panic("Ref constructor forwarding failed"); }
        self.value = value;
    }

    public fn drop() {
        ref_payload_drops = ref_payload_drops + 1;
    }
}

fn main() -> i32 {
    var zero_box = Box::<i32>.new();
    if (zero_box.get() != 0) { return 1; }
    zero_box.set(7);
    if (zero_box.get() != 7) { return 2; }

    let bool_box = Box::<bool>.new(true);
    if (!bool_box.get()) { return 10; }

    var zero_ref = Ref::<i64>.new();
    if (zero_ref.get() != 0) { return 3; }
    zero_ref.set(11);
    if (zero_ref.get() != 11) { return 4; }

    let pair_box = Box::<Pair>.new(2, 3);
    let box_pair_value = pair_box.get();
    if (box_pair_value.left != 2 || box_pair_value.right != 3) { return 5; }

    let pair_ref = Ref::<Pair>.new(5, 8);
    let ref_pair_value = pair_ref.get();
    if (ref_pair_value.left != 5 || ref_pair_value.right != 8) { return 6; }

    let shadow = Box::<FactoryShadow>.new(13);
    let shadow_value = shadow.get();
    if (shadow_value.value != 13 || factory_calls != 0) { return 7; }

    let overloaded_one = Box::<Overloaded>.new(17);
    if (overloaded_one.get().value != 17) { return 11; }
    let overloaded_two = Ref::<Overloaded>.new(19 as i64, 23 as i64);
    if (overloaded_two.get().value != 1923) { return 12; }

    var nested_default = Box::<Box<i32>>.new();
    nested_default.drop();

    var boxed_owner = Box::<BoxPayload>.new(31);
    boxed_owner.drop();
    boxed_owner.drop();
    if (box_payload_drops != 1) { return 8; }

    var ref_owner = Ref::<RefPayload>.new(47);
    ref_owner.drop();
    ref_owner.drop();
    if (ref_payload_drops != 1) { return 9; }

    return 0;
}
