use std.string;

// Covers the registered stdlib String class flowing into primitive string ABI.
fn builder_text() -> string {
    var builder = StringBuilder.create();
    builder.append("ok");
    return builder.intoString();
}

fn builder_long_text() -> string {
    var builder = StringBuilder.create();
    builder.append("this string takes the heap path");
    return builder.intoString();
}

fn main() -> i32 {
    var builder = StringBuilder.create();
    builder.append("x");
    let assigned: string = builder.intoString();
    if (assigned != "x") { return 1; }
    if (builder_text() != "ok") { return 2; }
    let source = String.from("this string takes the heap path");
    let copied: string = source;
    if (copied != "this string takes the heap path") { return 3; }
    if (builder_long_text() != "this string takes the heap path") { return 4; }
    str_drop(assigned);
    str_drop(copied);
    return 0;
}
