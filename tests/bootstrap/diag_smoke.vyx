module tests.diag_smoke;

// Trigger 1 — E2100 duplicate symbol: two same-name fns at the same scope yield
// "duplicate function dup_fn".
fn dup_fn() -> i32 { return 0; }
fn dup_fn() -> i32 { return 1; }

// Trigger 2 — E1000 type mismatch: a `let` with an explicit annotation that
// disagrees with the initializer's resolved type fires `error_mismatch`.
//
// Trigger 3 — E2000 unresolved name: calling a function whose name is unknown to
// Sema produces "undefined function 'undefined_smoke_target'".
//
// Trigger 4 — E1200 control flow: `break` outside of a loop fires
// "break/continue outside of loop".
fn main() -> i32 {
    let bad: i32 = "string-not-i32";
    undefined_smoke_target();
    break;
    return 0;
}
