class LegacyBox {
    public value: i32;

    public fn operator_index(self, idx: i32) -> i32 {
        return self.value + idx;
    }

    public fn operator_le(self, other: LegacyBox) -> bool {
        return self.value <= other.value;
    }

    public fn operator_add(self, other: LegacyBox) -> LegacyBox {
        return LegacyBox { value: self.value + other.value };
    }
}

fn main() -> i32 {
    let a = LegacyBox { value: 4 };
    let b = LegacyBox { value: 9 };
    let c = a + b;
    if (a[3] != 7) { return 1; }
    if (!(a <= b)) { return 2; }
    if (c.value != 13) { return 3; }
    return 0;
}
