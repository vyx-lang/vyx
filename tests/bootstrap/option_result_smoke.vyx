use std.option;
use std.result;

fn main() -> i32 {
    let some = Some(7);
    let none: Option<i32> = None;
    if (!some.isSome()) { return 1; }
    if (!some.is_some()) { return 2; }
    if (!none.isNone()) { return 3; }
    if (!none.is_none()) { return 4; }
    if (some.unwrap() != 7) { return 5; }
    if (none.unwrap_or(9) != 9) { return 6; }
    if (none.unwrapOr(11) != 11) { return 7; }

    let ok: Result<i32, i32> = Ok(12);
    let err: Result<i32, i32> = Err(5);
    if (!ok.is_ok()) { return 8; }
    if (!ok.isOk()) { return 9; }
    if (!err.is_err()) { return 10; }
    if (!err.isErr()) { return 11; }
    if (ok.unwrap() != 12) { return 12; }
    if (err.unwrap_or(13) != 13) { return 13; }
    if (err.unwrapOr(14) != 14) { return 14; }
    if (err.unwrap_err() != 5) { return 15; }
    return 0;
}
