fn log_info<...T>(...args: T) {
    var out = "[INFO] ";
    foreach (item in args) {
        out += "${item} ";
    }
    print(out);
}

fn log_error<...T>(...args: T) {
    var out = "[ERROR] ";
    foreach (item in args) {
        out += "${item} ";
    }
    print(out);
}

fn log_debug<...T>(...args: T) {
    var out = "[DEBUG] ";
    foreach (item in args) {
        out += "${item} ";
    }
    print(out);
}

fn sum<...T>(...args: T) -> f64 {
    var result = 0.0;
    foreach (item in args) {
        result += item as f64;
    }
    return result;
}

fn concat<...T>(...args: T) -> String {
    var result = "";
    foreach (item in args) {
        result += "${item}";
    }
    return result;
}

fn max<...T>(...args: T) -> f64 {
    if (args.length == 0) {
        return 0.0;
    }
    var result = args[0] as f64;
    foreach (item in args) {
        var val = item as f64;
        if (val > result) {
            result = val;
        }
    }
    return result;
}

fn main() -> i32 {
    log_info("data is: ", 3, " but ", 3.0, "not", "3", "is", true);
    log_info();
    var s1 = sum(1, 2, 3, 4, 5);
    log_info("Sum of 1-5:", s1);
    var s2 = sum(1.5, 2.5, 3.5);
    log_info("Sum of floats:", s2);
    var s3 = sum();
    log_info("Sum of nothing:", s3);
    var c1 = concat("Hello", " ", "World", "!", 2024);
    log_info("Concatenated:", c1);
    var m1 = max(1, 5, 3, 9, 2);
    log_info("Max of integers:", m1);
    var m2 = max(1.1, 3.3, 2.2, 5.5);
    log_info("Max of floats:", m2);
    var m3 = max();
    log_info("Max of nothing:", m3);
    let same = m2 as f64;
    if (s1 != 15.0) { return 1; }
    if (s2 != 7.5) { return 2; }
    if (s3 != 0.0) { return 3; }
    if (c1 != "Hello World!2024") { return 4; }
    if (m1 != 9.0) { return 5; }
    if (m2 != 5.5) { return 6; }
    if (m3 != 0.0) { return 7; }
    if (same != 5.5) { return 8; }
    return 0;
}
