use std.vio;

async fn delayed_add(a: i32, b: i32) -> i32 {
    sleep(150);
    return a + b;
}

async fn sleep_only() {
    sleep(80);
}

class AsyncBox {
    public value: i32;

    @[async]
    public fn add_later(self, delta: i32) -> i32 {
        sleep(150);
        return self.value + delta;
    }
}

fn main() -> i32 {
    let start = vio_now();
    let t = delayed_add(20, 22);
    let unit_task = sleep_only();
    let box = AsyncBox { value: 40 };
    let t2 = box.add_later(2);
    let elapsed = vio_now() - start;
    if (elapsed > 100) {
        return 1;
    }
    let value = await t;
    if (value != 42) {
        return 2;
    }
    let value2 = await t2;
    if (value2 != 42) {
        return 3;
    }
    await unit_task;
    return 0;
}
