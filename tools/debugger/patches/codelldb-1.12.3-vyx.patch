diff --git a/src/codelldb/src/debug_session/internal_stdio.rs b/src/codelldb/src/debug_session/internal_stdio.rs
new file mode 100644
--- /dev/null
+++ b/src/codelldb/src/debug_session/internal_stdio.rs
@@ -0,0 +1,82 @@
+//! Windows internal console uses named pipes, never the DAP transport handles.
+use super::*;
+use tokio::net::windows::named_pipe::ServerOptions;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static PIPE_ID: AtomicU64 = AtomicU64::new(1);
+
+// The Windows LLDB launcher may inherit the process handles rather than its
+// file actions. Scope those handles around launch; the DAP stream has already
+// captured separate handles and cannot be redirected by this guard.
+pub(super) struct LaunchStdio { handles: Vec<(u32, winapi::shared::ntdef::HANDLE)>, files: Vec<std::fs::File> }
+impl LaunchStdio {
+    pub(super) fn open(paths: &[Option<String>]) -> Result<Self, Error> {
+        use std::os::windows::io::AsRawHandle;
+        use winapi::um::{processenv::{GetStdHandle, SetStdHandle}, handleapi::SetHandleInformation,
+            winbase::{STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE, HANDLE_FLAG_INHERIT}};
+        let mut guard = Self { handles: vec![], files: vec![] };
+        for (fd, kind) in [STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE].into_iter().enumerate() {
+            if let Some(path) = &paths[fd] {
+                let file = std::fs::OpenOptions::new().read(fd == 0).write(fd != 0).open(path)?;
+                unsafe {
+                    let handle = file.as_raw_handle();
+                    if SetHandleInformation(handle, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT) == 0 {
+                        return Err(std::io::Error::last_os_error().into());
+                    }
+                    guard.handles.push((kind, GetStdHandle(kind)));
+                    if SetStdHandle(kind, handle) == 0 { return Err(std::io::Error::last_os_error().into()); }
+                }
+                guard.files.push(file);
+            }
+        }
+        Ok(guard)
+    }
+}
+impl Drop for LaunchStdio {
+    fn drop(&mut self) {
+        for (kind, handle) in &self.handles { unsafe { winapi::um::processenv::SetStdHandle(*kind, *handle); } }
+    }
+}
+
+impl DebugSession {
+    pub(super) fn internal_output_pipe(&mut self, category: &'static str) -> Result<String, Error> {
+        let name = format!(r"\\.\pipe\vyx-dap-{}-{}", std::process::id(), PIPE_ID.fetch_add(1, Ordering::Relaxed));
+        let mut pipe = ServerOptions::new().access_inbound(true).access_outbound(false)
+            .first_pipe_instance(true).create(&name)?;
+        let dap = self.dap_session.clone();
+        let task = tokio::spawn(async move {
+            if let Err(error) = pipe.connect().await { log::error!("output pipe connect: {error}"); return; }
+            log::debug!("output pipe connected {category}");
+            let mut buffer = [0u8; 16384];
+            let mut pending = Vec::with_capacity(16388);
+            loop {
+                let count = match pipe.read(&mut buffer).await { Ok(n) => n, Err(error) => {
+                    log::debug!("output pipe read {category}: {error}"); 0
+                }};
+                if count == 0 { break; }
+                pending.extend_from_slice(&buffer[..count]);
+                // Keep only an incomplete trailing UTF-8 codepoint between reads.
+                let complete = match std::str::from_utf8(&pending) {
+                    Ok(_) => pending.len(),
+                    Err(e) if e.error_len().is_none() => e.valid_up_to(),
+                    Err(_) => pending.len(),
+                };
+                if complete > 0 {
+                    let output = String::from_utf8_lossy(&pending[..complete]).into_owned();
+                    if dap.send_event(EventBody::output(OutputEventBody {
+                        category: Some(category.into()), output, ..Default::default()
+                    })).await.is_err() { return; }
+                    pending.drain(..complete);
+                }
+            }
+            if !pending.is_empty() {
+                let _ = dap.send_event(EventBody::output(OutputEventBody {
+                    category: Some(category.into()), output: String::from_utf8_lossy(&pending).into_owned(),
+                    ..Default::default()
+                })).await;
+            }
+        });
+        self.internal_output_tasks.push(task);
+        Ok(name)
+    }
+}
