// Host-language binding for the 14-entity ABI fixture.
// This is the programmer-written DCI glue: names and signatures.
// The Adapter-generated .dcib is the ABI contract, not glue.
@[dci_import("abi_fixtures.dcib")]
extern "dci" {
    class abi.Point {
        public x: i32;
        public y: i32;
    };

    class abi.Rect {
        public origin: abi.Point;
        public w: i32;
        public h: i32;
    };

    class abi.Vec2 {
        public x: f64;
        public y: f64;
    };

    class abi.Span {
        public data: *u8;
        public len: u64;
    };

    class abi.Quad {
        public a: i64;
        public b: i64;
        public c: i64;
        public d: i64;
    };

    class abi.PackedHeader {
        public tag: u8;
        public length: u32;
    };

    class abi.Buffer {
        Buffer(n: u64);
        ~Buffer();
        public fn size() const -> u64;
        public fn fill(value: u8);
        public fn checksum() const -> u64;
    };

    class abi.Shape {
        virtual ~Shape();
        virtual fn area() const -> f64;
        virtual fn sides() const -> i32;
    };

    class abi.Circle : abi.Shape {
        Circle(radius: f64);
    };

    fn point_sum(p: abi.Point) -> i32;
    fn point_translate(p: abi.Point, dx: i32, dy: i32) -> abi.Point;
    fn rect_area(r: abi.Rect) -> i32;
    fn vec2_dot(a: abi.Vec2, b: abi.Vec2) -> f64;
    fn span_checksum(s: abi.Span) -> u64;
    fn quad_sum(q: abi.Quad) -> i64;
    fn quad_scale(q: abi.Quad, k: i64) -> abi.Quad;
    fn color_next(c: u8) -> u8;
    fn status_step(s: i32) -> i32;
    fn packed_total(items: *abi.PackedHeader, count: u64) -> u32;
    fn checked_divide(a: i32, b: i32) -> i32;
}
