@[dci_import("../contracts/abi_fixtures.dcib")]
@[cpp_include("abi_fixtures.hpp")]
extern "dci" {
    class abi.Point {
        public x: i32;
        public y: i32;
    };

    class abi.Buffer {
        Buffer(n: u64);
        ~Buffer();
        public fn size() const -> u64;
        public fn fill(value: u8);
        public fn checksum() const -> u64;
    };

    class abi.Shape {
        virtual ~Shape();
        virtual fn area() const -> f64;
        virtual fn sides() const -> i32;
    };

    fn point_sum(p: abi.Point) -> i32;
}

extern "C" {
    fn bench_now_ns() -> u64;
    fn bench_iters() -> u64;
    fn bench_warmup() -> u64;
    fn bench_report(path: rawptr, kernel: rawptr, iters: u64, ns: u64, sink: u64);
    fn bench_circle_new(r: f64) -> rawptr;
    fn bench_shape_delete(p: rawptr);
}

fn report(kernel: string, iters: u64, ns: u64, sink: u64) {
    bench_report("dci".c_str() as rawptr, kernel.c_str() as rawptr, iters, ns, sink);
}

fn main() -> i32 {
    let iters = bench_iters() as i64;
    let warmup = bench_warmup() as i64;
    let iters_u = iters as u64;

    var p: abi.Point;
    p.x = 3;
    p.y = 4;
    var w: i64 = 0;
    while (w < warmup) {
        let _ps = point_sum(p);
        w = w + 1;
    }
    var sink: u64 = 0;
    var t0 = bench_now_ns();
    var i: i64 = 0;
    while (i < iters) {
        sink = sink + (point_sum(p) as u32) as u64;
        i = i + 1;
    }
    report("point_sum", iters_u, bench_now_ns() - t0, sink);

    var buf = abi.Buffer(1u64);
    w = 0;
    while (w < warmup) {
        buf.fill(0xAB);
        w = w + 1;
    }
    sink = 0;
    t0 = bench_now_ns();
    i = 0;
    while (i < iters) {
        buf.fill(0xAB);
        sink = sink + 1;
        i = i + 1;
    }
    report("buffer_fill", iters_u, bench_now_ns() - t0, sink);

    buf.fill(0xAB);
    w = 0;
    while (w < warmup) {
        let _cs = buf.checksum();
        w = w + 1;
    }
    sink = 0;
    t0 = bench_now_ns();
    i = 0;
    while (i < iters) {
        sink = sink ^ buf.checksum();
        i = i + 1;
    }
    report("buffer_checksum", iters_u, bench_now_ns() - t0, sink);

    w = 0;
    while (w < warmup) {
        let _sz = buf.size();
        w = w + 1;
    }
    sink = 0;
    t0 = bench_now_ns();
    i = 0;
    while (i < iters) {
        sink = sink + (buf.size() as u64);
        i = i + 1;
    }
    report("buffer_size", iters_u, bench_now_ns() - t0, sink);

    unsafe {
        let shape = bench_circle_new(2.0) as *abi.Shape;
        w = 0;
        while (w < warmup) {
            let _a = shape.area();
            w = w + 1;
        }
        sink = 0;
        t0 = bench_now_ns();
        i = 0;
        while (i < iters) {
            sink = sink + ((shape.area() * 1000.0) as i64) as u64;
            i = i + 1;
        }
        report("shape_area", iters_u, bench_now_ns() - t0, sink);

        w = 0;
        while (w < warmup) {
            let _s = shape.sides();
            w = w + 1;
        }
        sink = 0;
        t0 = bench_now_ns();
        i = 0;
        while (i < iters) {
            sink = sink + (shape.sides() as u32) as u64;
            i = i + 1;
        }
        report("shape_sides", iters_u, bench_now_ns() - t0, sink);
        bench_shape_delete(shape as rawptr);
    }
    return 0;
}
