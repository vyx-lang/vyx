{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vyxlang.org/dci/schema/dci-1.0.schema.json",
  "title": "Declarative Code Interface 1.0 ABI document",
  "description": "Language-neutral native ABI contract consumed by DCI implementations. .dci and .abi.json are filename aliases for this JSON representation.",
  "type": "object",
  "required": ["dci", "kind", "source", "exports"],
  "properties": {
    "$schema": { "type": "string" },
    "dci": { "type": "string", "pattern": "^1(?:\\.[0-9]+)*$" },
    "kind": { "enum": ["abi"] },
    "profile": { "$ref": "#/$defs/profile" },
    "source": { "$ref": "#/$defs/source" },
    "target": { "$ref": "#/$defs/target" },
    "control_flow": { "$ref": "#/$defs/controlFlow" },
    "obligations": { "$ref": "#/$defs/obligations" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "exports": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" },
          "default": []
        },
        "layouts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layout" },
          "default": []
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" },
          "default": []
        },
        "calling_conventions": {
          "type": "array",
          "items": { "$ref": "#/$defs/callingConvention" },
          "default": []
        },
        "vtables": {
          "type": "array",
          "items": { "$ref": "#/$defs/dispatchTable" },
          "default": []
        },
        "dispatch_tables": {
          "description": "Language-neutral spelling for dispatch metadata. The vtables property remains a compatible alias.",
          "type": "array",
          "items": { "$ref": "#/$defs/dispatchTable" },
          "default": []
        },
        "runtime_type_operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeTypeOperations" },
          "default": []
        },
        "stub_requests": {
          "description": "Language-neutral Stub requests the Consumer normalized from requires_stub operations. A pluggable backend turns each request into an ABI-native wrapper compiled by the producer toolchain.",
          "type": "array",
          "items": { "$ref": "#/$defs/stubRequest" },
          "default": []
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "required": ["id", "version", "level", "consumer_modes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "enum": ["L0", "L1", "L2", "L3"] },
        "conformance": {
          "description": "Whether level is a complete cumulative conformance claim or only the highest capability category present.",
          "enum": ["full", "feature_subset"]
        },
        "consumer_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["direct", "stub"] }
        },
        "lifecycle_binding": {
          "description": "Selects normalized automatic insertion or lifecycle owned by existing host declarations.",
          "enum": ["automatic", "declaration"]
        },
        "obligation_mode": {
          "description": "Require the cross-module lifecycle/exception fact graph at consume time.",
          "enum": ["optional", "required"]
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": true
    },
    "producerIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "vendor": {
              "description": "Stable compiler family identity (gcc/clang/msvc). Descriptive only; consumers must not require it to equal the local compiler.",
              "type": "string"
            },
            "version": {
              "description": "Compiler version snapshot annotation. This is descriptive provenance and must NOT be used as a consume-time equality check.",
              "type": "string"
            },
            "build": { "type": "string" },
            "target_triplet": {
              "description": "Descriptive target triple the facts were generated for, e.g. x86_64-linux-gnu.",
              "type": "string"
            },
            "flags": {
              "description": "Layout-affecting compiler flags used at generation (descriptive provenance).",
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "compiler": { "$ref": "#/$defs/producerIdentity" },
        "adapter": { "$ref": "#/$defs/producerIdentity" },
        "headers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preparation_inputs": {
          "description": "Optional build-preparation provenance, independent of disposable caches. A known change to recorded producer headers/configuration requires regeneration. Plain offline contracts may omit this; their version freshness remains provider-managed. Compiler version annotations are not compatibility checks.",
          "type": "object",
          "required": ["version", "headers", "files", "target", "std", "flags", "boundary", "exports"],
          "properties": {
            "version": { "const": 1 },
            "headers": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
            "target": { "type": "string" },
            "std": { "type": "string" },
            "flags": { "type": "array", "items": { "type": "string" } },
            "boundary": { "enum": ["no_unwind", "shared_abi"] },
            "exports": {
              "type": "object",
              "required": ["all", "types", "functions", "qt_connections"],
              "properties": {
                "all": { "type": "boolean" },
                "types": { "type": "array", "items": { "type": "string" } },
                "functions": { "type": "array", "items": { "type": "string" } },
                "qt_connections": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "target": {
          "description": "Legacy location for target metadata. New producers should also emit the root target property.",
          "$ref": "#/$defs/target"
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "triple": { "type": "string" },
        "architecture": { "type": "string" },
        "pointer_width": { "enum": [16, 32, 64, 128] },
        "endianness": { "enum": ["little", "big"] },
        "object_format": { "type": "string" },
        "environment": { "type": "string" },
        "abi": { "type": "string" },
        "abi_family": { "type": "string" },
        "data_layout": { "type": "string" }
      },
      "additionalProperties": true
    },
    "controlFlow": {
      "type": "object",
      "required": ["default_boundary"],
      "properties": {
        "default_boundary": {
          "enum": ["no_unwind", "abort", "translated", "shared_abi"]
        },
        "propagation": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["forbidden", "abort", "translated", "shared_abi"] },
            "abi": { "$ref": "#/$defs/nonEmptyString" },
            "translator_symbol": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": true
        },
        "failure_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["return_value", "out_parameter", "thread_local", "callback", "abort"] }
        }
      },
      "additionalProperties": true
    },
    "obligations": {
      "type": "object",
      "required": ["version", "lifecycle", "exceptions", "edges"],
      "properties": {
        "version": { "const": "1" },
        "lifecycle": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycleObligation" }
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exceptionObligation" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/obligationEdge" }
        }
      },
      "additionalProperties": false
    },
    "lifecycleObligation": {
      "type": "object",
      "required": ["subject", "ownership", "on_unwind", "required_operations"],
      "properties": {
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "ownership": { "$ref": "#/$defs/nonEmptyString" },
        "allocator_domain": { "type": "string" },
        "on_unwind": { "enum": ["release", "retain", "forbid"] },
        "required_operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "symbol"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "symbol": { "$ref": "#/$defs/nonEmptyString" },
              "when": { "enum": ["normal", "unwind", "normal-and-unwind"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "exceptionObligation": {
      "type": "object",
      "required": ["subject", "boundary", "cleanup"],
      "properties": {
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "boundary": { "enum": ["no_unwind", "abort", "translated", "shared_abi"] },
        "abi": { "type": "string" },
        "translator_symbol": { "type": "string" },
        "cleanup": { "enum": ["unwind", "translate", "terminate", "none"] },
        "must_preserve_identity": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "obligationEdge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/nonEmptyString" },
        "to": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["cleanup-before-propagate", "propagates", "owns", "requires"] }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["object", "static_library", "shared_library", "import_library", "stub_source", "metadata"] },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "type": "string" },
        "link_mode": { "enum": ["required", "optional", "runtime"] }
      },
      "additionalProperties": true
    },
    "typeRef": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "enum": ["primitive", "enum", "record", "class", "interface", "opaque", "function", "vector"]
        },
        "nullable": { "type": "boolean" },
        "reference": {
          "description": "Value/reference category, independent of source-language spelling.",
          "type": "string"
        },
        "pointee_const": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 0 },
        "alignment": { "type": "integer", "minimum": 1 },
        "source_type": { "type": "string" },
        "cpp_type": {
          "description": "Deprecated adapter annotation retained for compatibility; consumers must not require it.",
          "type": "string"
        },
        "enum_name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "required": ["name", "target"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "operationRef": {
      "type": "object",
      "properties": {
        "symbol": { "$ref": "#/$defs/nonEmptyString" },
        "dispatch_table": { "type": "string" },
        "slot": { "type": "integer", "minimum": 0 },
        "intrinsic": {
          "description": "Profile-independent operation implemented by the Consumer from normalized DCI data.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "availability": { "enum": ["required", "optional", "unavailable", "trivial", "intrinsic"] },
        "no_unwind": { "type": "boolean" },
        "requires_stub": { "type": "boolean" },
        "source_type": { "$ref": "#/$defs/nonEmptyString" },
        "target_type": { "$ref": "#/$defs/nonEmptyString" },
        "failure": { "$ref": "#/$defs/nonEmptyString" },
        "null_behavior": { "$ref": "#/$defs/nonEmptyString" }
      },
      "anyOf": [
        { "required": ["symbol"] },
        { "required": ["dispatch_table", "slot"] },
        { "required": ["intrinsic"] },
        { "required": ["availability"] }
      ],
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": ["ownership_model", "copy_semantics", "move_semantics", "destruction"],
      "properties": {
        "ownership_model": {
          "enum": ["value", "unique", "shared", "borrowed", "external", "manual", "linear"]
        },
        "copy_semantics": {
          "enum": ["forbidden", "trivial", "operation", "retain", "shared"]
        },
        "move_semantics": {
          "enum": ["forbidden", "trivial", "operation", "relocate"]
        },
        "destruction": {
          "enum": ["none", "trivial", "operation", "release", "external"]
        },
        "moved_from_state": {
          "enum": ["valid", "destructible_only", "zeroed", "unspecified"]
        },
        "allocator_domain": { "type": "string" },
        "operations": {
          "type": "object",
          "properties": {
            "create": { "$ref": "#/$defs/operationRef" },
            "default_construct": { "$ref": "#/$defs/operationRef" },
            "copy": { "$ref": "#/$defs/operationRef" },
            "move": { "$ref": "#/$defs/operationRef" },
            "destroy": { "$ref": "#/$defs/operationRef" },
            "retain": { "$ref": "#/$defs/operationRef" },
            "release": { "$ref": "#/$defs/operationRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/operationRef" }
        }
      },
      "additionalProperties": true
    },
    "bitfield": {
      "type": "object",
      "required": [
        "storage_offset",
        "storage_size",
        "bit_offset",
        "bit_width",
        "signed",
        "bit_order",
        "read",
        "write"
      ],
      "properties": {
        "storage_offset": { "type": "integer", "minimum": 0 },
        "storage_size": { "type": "integer", "minimum": 1 },
        "bit_offset": { "type": "integer", "minimum": 0 },
        "bit_width": { "type": "integer", "minimum": 1 },
        "signed": { "type": "boolean" },
        "bit_order": { "enum": ["lsb0", "msb0", "target"] },
        "read": { "enum": ["direct", "operation", "unavailable"] },
        "write": { "enum": ["direct", "operation", "unavailable"] },
        "read_operation": { "$ref": "#/$defs/operationRef" },
        "write_operation": { "$ref": "#/$defs/operationRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "read": { "const": "operation" } },
            "required": ["read"]
          },
          "then": { "required": ["read_operation"] }
        },
        {
          "if": {
            "properties": { "write": { "const": "operation" } },
            "required": ["write"]
          },
          "then": { "required": ["write_operation"] }
        }
      ],
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["name", "offset", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "offset": { "type": "integer", "minimum": 0 },
        "type": { "$ref": "#/$defs/typeRef" },
        "visibility": { "type": "string" },
        "is_readonly": { "type": "boolean" },
        "bitfield": { "$ref": "#/$defs/bitfield" },
        "source_type": { "type": "string" },
        "cpp_type": {
          "description": "Deprecated adapter annotation retained for compatibility.",
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "baseAdjustment": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["constant", "table", "operation"] },
        "offset": { "type": "integer" },
        "table_offset": {
          "description": "Deprecated compatibility alias for table_entry_offset.",
          "type": "integer"
        },
        "table_pointer_offset": { "type": "integer" },
        "table_entry_offset": { "type": "integer" },
        "table_entry_size": { "type": "integer", "minimum": 1 },
        "table_entry_signed": { "type": "boolean" },
        "displacement_base_offset": { "type": "integer" },
        "result": { "$ref": "#/$defs/nonEmptyString" },
        "null_preserving": { "type": "boolean" },
        "fallback_complete_object_offset": {
          "description": "Descriptive complete-object fact; it is not sufficient to execute a dynamic table adjustment.",
          "type": "integer"
        },
        "operation": { "$ref": "#/$defs/operationRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "constant" } },
            "required": ["kind"]
          },
          "then": { "required": ["offset"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "operation" } },
            "required": ["kind"]
          },
          "then": { "required": ["operation"] }
        }
      ],
      "additionalProperties": true
    },
    "base": {
      "type": "object",
      "required": ["type_name"],
      "properties": {
        "type_name": { "$ref": "#/$defs/nonEmptyString" },
        "offset": { "type": "integer" },
        "visibility": { "type": "string" },
        "is_virtual": { "type": "boolean" },
        "adjustment": { "$ref": "#/$defs/baseAdjustment" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "is_virtual": { "const": true } },
            "required": ["is_virtual"]
          },
          "then": { "required": ["adjustment"] }
        }
      ],
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["type_name", "size", "alignment", "fields"],
      "properties": {
        "type_name": { "$ref": "#/$defs/nonEmptyString" },
        "size": { "type": "integer", "minimum": 0 },
        "alignment": { "type": "integer", "minimum": 1 },
        "representation": { "enum": ["native", "stable", "transparent", "opaque"] },
        "has_vtable": { "type": "boolean" },
        "is_pod": { "type": "boolean" },
        "is_trivially_destructible": { "type": "boolean" },
        "bases": {
          "type": "array",
          "items": { "$ref": "#/$defs/base" },
          "default": []
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      },
      "additionalProperties": true
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "description": "Portable strict DCI documents must also declare ownership; omission remains schema-compatible only for legacy non-strict descriptors.",
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/typeRef" },
        "location": { "type": "string" },
        "ownership": { "enum": ["borrow", "borrow_mut", "copy", "move", "share", "out"] },
        "default": {
          "description": "Producer declaration's call-site default. It does not alter the native ABI signature or create an overload.",
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "value", "source"],
              "properties": {
                "kind": { "const": "constant" },
                "value": { "type": ["integer", "boolean", "null"] },
                "source": { "enum": ["clang_ast", "producer_constant_evaluation"] }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "reason"],
              "properties": {
                "kind": { "const": "producer_expression" },
                "reason": { "type": "string" },
                "cpp_constant_expression": { "type": "string" },
                "enum_type": { "type": "string" },
                "enum_member": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "returnValue": {
      "description": "Non-void returns in portable strict DCI documents must declare ownership.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "$ref": "#/$defs/typeRef" },
            "location": { "type": "string" },
            "ownership": { "enum": ["borrow", "copy", "move", "share", "owned"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "abiValueLowering": {
      "type": "object",
      "required": ["passing"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "passing": {
          "enum": ["ignore", "direct", "indirect", "byval", "sret", "inalloca", "split", "coerce"]
        },
        "coerce_to": { "$ref": "#/$defs/typeRef" },
        "alignment": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "registers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "register_offsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passing": { "enum": ["indirect", "byval", "sret"] }
            },
            "required": ["passing"]
          },
          "then": { "required": ["size", "alignment"] }
        },
        {
          "if": {
            "properties": { "passing": { "const": "coerce" } },
            "required": ["passing"]
          },
          "then": {
            "anyOf": [
              { "required": ["coerce_to", "size"] },
              { "required": ["registers", "size"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "passing": { "const": "split" } },
            "required": ["passing"]
          },
          "then": { "required": ["registers", "register_offsets", "size"] }
        }
      ],
      "additionalProperties": true
    },
    "abiLowering": {
      "type": "object",
      "required": ["calling_convention", "parameters", "return"],
      "properties": {
        "calling_convention": { "$ref": "#/$defs/nonEmptyString" },
        "variadic": { "type": "boolean" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/abiValueLowering" }
        },
        "return": { "$ref": "#/$defs/abiValueLowering" },
        "hidden_parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/abiValueLowering" }
        }
      },
      "additionalProperties": true
    },
    "symbol": {
      "type": "object",
      "required": ["name", "kind", "params", "return"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "semantic_id": { "type": "string" },
        "owner": { "type": "string" },
        "member_name": { "type": "string" },
        "link_name": { "type": "string" },
        "mangled": {
          "description": "Legacy spelling for link_name, retained for existing adapters.",
          "type": "string"
        },
        "kind": { "type": "string" },
        "calling_convention": { "type": "string" },
        "linkage": { "type": "string" },
        "visibility": { "type": "string" },
        "is_static": { "type": "boolean" },
        "is_virtual": { "type": "boolean" },
        "is_override": { "type": "boolean" },
        "is_final": { "type": "boolean" },
        "is_const": { "type": "boolean" },
        "this_adjust": { "type": "integer" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "return": { "$ref": "#/$defs/returnValue" },
        "abi": { "$ref": "#/$defs/abiLowering" },
        "control_flow": { "$ref": "#/$defs/controlFlow" }
      },
      "anyOf": [
        { "required": ["link_name"] },
        { "required": ["mangled"] },
        { "properties": { "kind": { "enum": ["intrinsic", "dispatch_only"] } } }
      ],
      "additionalProperties": true
    },
    "callingConvention": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "this_pointer": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "abi_family": { "type": "string" },
        "callee_cleanup": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "dispatchEntry": {
      "type": "object",
      "required": ["index", "offset", "kind"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer" },
        "address_point_relative_offset": { "type": "integer" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "owner": { "type": "string" },
        "member_name": { "type": "string" },
        "link_name": { "type": "string" },
        "mangled": { "type": "string" },
        "this_adjust": { "type": "integer" },
        "return_adjust": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "dispatchTable": {
      "type": "object",
      "required": ["class_name", "entries"],
      "properties": {
        "id": { "type": "string" },
        "class_name": { "$ref": "#/$defs/nonEmptyString" },
        "base_class": { "type": "string" },
        "vtable_symbol": { "type": "string" },
        "address_point_offset": { "type": "integer" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/dispatchEntry" }
        }
      },
      "additionalProperties": true
    },
    "stubRequest": {
      "type": "object",
      "required": ["id", "kind", "wrapper"],
      "description": "A normalized, source-language-neutral request describing the ABI surface a Stub must expose. It carries only ABI facts (input/output ABI, required operations, control-flow boundary, capabilities), never producer source-language semantics.",
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["operation_wrapper", "cast_wrapper", "reverse_override"] },
        "reason": { "type": "string" },
        "target": { "type": "string" },
        "input": {
          "type": "object",
          "properties": { "abi": { "type": "string" } },
          "additionalProperties": true
        },
        "output": {
          "type": "object",
          "properties": { "abi": { "type": "string" } },
          "additionalProperties": true
        },
        "operation": {
          "description": "The normalized operation the wrapper must expose. It is looser than operationRef because the concrete wrapper symbol is produced by the backend.",
          "type": "object",
          "additionalProperties": true
        },
        "operations": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "synthesis": {
          "description": "forward_direct: Core Consumer emits a forwarding wrapper. reverse_override: same in-Consumer forwarding used when the foreign side calls into a host-exported target. translate_unwind: a backend-compiled catch translator; Consumer must not emit LLVM EH. The translator link_name must already be an exported Direct symbol.",
          "type": "object",
          "required": ["strategy"],
          "properties": {
            "strategy": { "enum": ["forward_direct", "translate_unwind", "reverse_override"] },
            "target": {
              "description": "Symbol reference of the exported Direct target the wrapper forwards to; defaults to the request-level target.",
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "control_flow": { "$ref": "#/$defs/controlFlow" },
        "wrapper": {
          "type": "object",
          "required": ["link_name"],
          "properties": {
            "link_name": { "$ref": "#/$defs/nonEmptyString" },
            "calling_convention": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtimeTypeOperations": {
      "type": "object",
      "required": ["type_name", "operations"],
      "properties": {
        "type_name": { "$ref": "#/$defs/nonEmptyString" },
        "type_id": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["query_type", "is_instance", "cast", "downcast", "upcast", "type_name"] }
        },
        "operations": {
          "type": "object",
          "properties": {
            "query_type": { "$ref": "#/$defs/operationRef" },
            "is_instance": { "$ref": "#/$defs/operationRef" },
            "cast": { "$ref": "#/$defs/operationRef" },
            "downcast": { "$ref": "#/$defs/operationRef" },
            "upcast": { "$ref": "#/$defs/operationRef" },
            "type_name": { "$ref": "#/$defs/operationRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/operationRef" }
        }
      },
      "additionalProperties": true
    }
  }
}
