module std.event;

/// Vyx Standard Library — Delegate and Event (function pointer collections)
/// Delegate: single function pointer (rawptr)
/// Event: collection of function pointers, fire all on invoke

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

struct Delegate {
    fn_ptr: rawptr;
}

public fn delegate_new(fn_ptr: rawptr) -> Delegate {
    return Delegate { fn_ptr: fn_ptr };
}

public fn delegate_invoke(d: rawptr, arg: i64) -> i64 {
    unsafe {
        var fp: rawptr = null;
        memcpy(to_rawptr(&fp), d, 8);
        if (fp == null) { return 0; }
        return 0;
    }
}

struct Event {
    handlers: rawptr;
    count: i64;
    cap: i64;
}

public fn event_new() -> Event {
    let cap: i64 = 8;
    unsafe {
        let h = malloc(cap * 8);
        memset(h, 0, cap * 8);
        return Event { handlers: h, count: 0, cap: cap };
    }
}

public fn event_add(ev: rawptr, handler: rawptr) {
    unsafe {
        var handlers: rawptr = null;
        var count: i64 = 0;
        var cap: i64 = 0;
        memcpy(to_rawptr(&handlers), ev, 8);
        memcpy(to_rawptr(&count), ev + 8, 8);
        memcpy(to_rawptr(&cap), ev + 16, 8);
        if (count >= cap) {
            let new_cap = cap * 2;
            let new_h = realloc(handlers, new_cap * 8);
            memcpy(ev, to_rawptr(&new_h), 8);
            memcpy(ev + 16, to_rawptr(&new_cap), 8);
            handlers = new_h;
        }
        memcpy(handlers + count * 8, to_rawptr(&handler), 8);
        count = count + 1;
        memcpy(ev + 8, to_rawptr(&count), 8);
    }
}

public fn event_remove(ev: rawptr, handler: rawptr) {
    unsafe {
        var handlers: rawptr = null;
        var count: i64 = 0;
        memcpy(to_rawptr(&handlers), ev, 8);
        memcpy(to_rawptr(&count), ev + 8, 8);
        var i: i64 = 0;
        while (i < count) {
            var h: rawptr = null;
            memcpy(to_rawptr(&h), handlers + i * 8, 8);
            if (h == handler) {
                let last_idx = count - 1;
                if (i < last_idx) {
                    memcpy(handlers + i * 8, handlers + last_idx * 8, 8);
                }
                count = count - 1;
                memcpy(ev + 8, to_rawptr(&count), 8);
                return;
            }
            i = i + 1;
        }
    }
}

public fn event_count(ev: rawptr) -> i64 {
    unsafe {
        var count: i64 = 0;
        memcpy(to_rawptr(&count), ev + 8, 8);
        return count;
    }
}

public fn event_clear(ev: rawptr) {
    unsafe {
        let zero: i64 = 0;
        memcpy(ev + 8, to_rawptr(&zero), 8);
    }
}

public fn event_free(ev: rawptr) {
    unsafe {
        var handlers: rawptr = null;
        memcpy(to_rawptr(&handlers), ev, 8);
        if (handlers != null) { free(handlers); }
        memset(ev, 0, 24);
    }
}
