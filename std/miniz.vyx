module std.miniz;

/// miniz — Compression & Decompression for Vyx (zlib-compatible)
/// Usage: import std::miniz;
///
/// Example:
///   let buf = Compressor.compress("Hello World! " * 100);
///   print(buf.size);  // much smaller than original
///   let text = Compressor.decompressToString(buf, 1400);
///   buf.free();
///
///   let checksum = Compressor.crc32("Hello");
///   print(checksum);
///
/// Requires: miniz (single-file C library)
///   Compile with sources = "vendor/miniz.c" in Vyx.toml

extern "C" {
    fn mz_compress2(dest: rawptr, dest_len: rawptr, source: rawptr, source_len: i64, level: i32) -> i32;
    fn mz_compressBound(source_len: i64) -> i64;
    fn mz_uncompress(dest: rawptr, dest_len: rawptr, source: rawptr, source_len: i64) -> i32;
    fn mz_crc32(crc: i64, ptr: rawptr, buf_len: i64) -> i64;
    fn mz_adler32(adler: i64, ptr: rawptr, buf_len: i64) -> i64;
    fn mz_version() -> rawptr;
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
}

class Buffer {
    data: i64
    size: i32
    valid: bool

    fn free() {
        if (self.data != 0) {
            unsafe { free(self.data as rawptr); }
            self.data = 0;
            self.size = 0;
            self.valid = false;
        }
    }
}

class Compressor {
    static fn version() -> string {
        return from_cstr(mz_version());
    }

    static fn compress(text: string) -> Buffer {
        return Compressor.compressLevel(text, 6);
    }

    static fn compressLevel(text: string, level: i32) -> Buffer {
        var bound = mz_compressBound(text.len as i64);
        var out_len: i64 = bound;
        unsafe {
            let buf = malloc(bound);
            if (buf == null) {
                return Buffer { data: 0, size: 0, valid: false };
            }
            let rc = mz_compress2(buf, &out_len, text.c_str(), text.len as i64, level);
            if (rc != 0) {
                free(buf);
                return Buffer { data: 0, size: 0, valid: false };
            }
            return Buffer { data: buf as i64, size: out_len as i32, valid: true };
        }
    }

    static fn decompressToString(buf: Buffer, max_size: i32) -> string {
        if (!buf.valid) { return ""; }
        var out_len: i64 = max_size as i64;
        unsafe {
            let out = malloc(out_len + 1);
            if (out == null) { return ""; }
            let rc = mz_uncompress(out, &out_len, buf.data as rawptr, buf.size as i64);
            if (rc != 0) {
                free(out);
                return "";
            }
            let byte_ptr = out as rawptr;
            byte_ptr[out_len as i32] = 0;
            let result = from_cstr(out);
            free(out);
            return result;
        }
    }

    static fn crc32(text: string) -> i64 {
        return mz_crc32(0, text.c_str(), text.len as i64);
    }

    static fn adler32(text: string) -> i64 {
        return mz_adler32(1, text.c_str(), text.len as i64);
    }
}
