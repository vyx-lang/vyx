module std.defaults;

/// Vyx Standard Library — Default
///
/// Mirrors Rust's `std::default::Default`: a trait whose implementation
/// produces a "zero-like" value for a type (0 for integers, 0.0 for
/// floats, false for bool, '\0' for char, "" for string).
///
/// Naming notes (2026-04-23):
///
///   * The module is `std.defaults` (plural) because `default` is a
///     reserved keyword in Vyx — the module-path parser rejects
///     `use std.default;` with "expected module path segment, got
///     'default'".  The *file* is still `std/default.vyx`, matching
///     Rust's `default.rs` layout; only the module-path segment had to
///     be pluralised.
///   * The method is `default_value()` rather than `default()` for the
///     same keyword-collision reason — the parser rejects `fn default`
///     outright, so we pick a non-colliding method name.  The trait
///     name `Default` itself is fine (type-name slot, not a keyword
///     context).
///
/// Dispatch convention (Phase 8, 2026-04-24): `T::default_value()` now
/// routes through the Phase 8 static-trait rewrite path in Sema. At
/// template instantiation time `T::default_value()` — where T has a
/// `Default` bound — gets rewritten to `<Concrete>::default_value()`,
/// which CodeGen dispatches through the normal `<TypeName>.method`
/// mangling (same as `i32.hash` / `MyClass.new`).
///
/// Usage:
///
///   fn zero<T>() -> T where T: Default {
///       return T::default_value();     // dispatches statically
///   }
///
///   fn main() -> i32 {
///       let a: i32 = zero::<i32>();    // a = 0
///       return a;
///   }
///
/// Naming note (2026-04-23): method is `default_value()` rather than
/// `default()` because `default` is a reserved keyword (parser rejects
/// `fn default` in the method slot).  Module is `std.defaults` (plural)
/// for the same reason.
///
/// Compare to Rust:
///
///   Rust:  let x: i32 = Default::default();       // or  i32::default()
///   Vyx:   let x: i32 = zero::<i32>();
///

// ============================================================
// Trait
// ============================================================

/// Produces a default-constructed value for the implementing type.
/// Convention: zero / empty / logically-blank.  Implementors that can
/// fail (e.g. types requiring a resource) should NOT implement Default;
/// use a fallible `try_new()` instead.
///
/// `static fn` marks this as a true static method — no implicit `self`
/// parameter — so `T::default_value()` can be called from generic bodies
/// without a tag receiver.  Sema mirrors the `static` flag onto matching
/// `impl Default for X` methods even when the user omits the keyword;
/// being explicit (`static fn default_value`) is recommended for clarity.
trait Default {
    static fn default_value() -> Self;
}

// ============================================================
// Primitive impls.  Same dispatch plumbing as Hashable/Display/Clone:
// each block registers the method in `primitiveMethodImpls_[(typeName,
// "default_value")]` and records nominal satisfaction of `Default` in
// `primitiveTraitSatisfied_`.  Phase 8: `T::default_value()` callers
// dispatch through here via the static-trait rewrite in Sema —
// `<PrimitiveName>.default_value` is a true `() -> T` function.
// ============================================================

impl Default for i32    { static fn default_value() -> i32    { return 0 as i32; } }
impl Default for i64    { static fn default_value() -> i64    { return 0 as i64; } }
impl Default for f32    { static fn default_value() -> f32    { return 0.0 as f32; } }
impl Default for f64    { static fn default_value() -> f64    { return 0.0; } }
impl Default for bool   { static fn default_value() -> bool   { return false; } }
// char: Unicode codepoint (stored as 32-bit).  Vyx has no `'\0'`
// character literal that survives lexer → sema cleanly; cast the
// integer zero instead.  Mirrors Rust's `char::default() == '\0'`.
impl Default for char   { static fn default_value() -> char   { return 0 as char; } }
impl Default for string { static fn default_value() -> string { return ""; } }
