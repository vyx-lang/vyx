module std.sqlite;

/// Vyx SQLite3 Database Driver
/// High-level API that hides all raw pointers.
///
/// Usage:
///   let db = Database.open("test.db");
///   db.exec("CREATE TABLE users (id INTEGER, name TEXT)");
///   db.exec("INSERT INTO users VALUES (1, 'Alice')");
///
///   let query = db.query("SELECT id, name FROM users");
///   while (query.next()) {
///       let id = query.getInt(0);
///       let name = query.getText(1);
///       print("${id}: ${name}");
///   }
///   query.close();
///   db.close();
///
/// Requires: SQLite3 library

extern "C" {
    fn sqlite3_open(filename: rawptr, ppDb: rawptr) -> i32;
    fn sqlite3_close(db: rawptr) -> i32;
    fn sqlite3_exec(db: rawptr, sql: rawptr, callback: rawptr, arg: rawptr, errmsg: rawptr) -> i32;
    fn sqlite3_errmsg(db: rawptr) -> rawptr;
    fn sqlite3_prepare_v2(db: rawptr, sql: rawptr, nByte: i32, ppStmt: rawptr, pzTail: rawptr) -> i32;
    fn sqlite3_step(stmt: rawptr) -> i32;
    fn sqlite3_finalize(stmt: rawptr) -> i32;
    fn sqlite3_column_int(stmt: rawptr, col: i32) -> i32;
    fn sqlite3_column_text(stmt: rawptr, col: i32) -> rawptr;
    fn sqlite3_column_double(stmt: rawptr, col: i32) -> f64;
    fn sqlite3_column_count(stmt: rawptr) -> i32;
    fn sqlite3_bind_int(stmt: rawptr, idx: i32, value: i32) -> i32;
    fn sqlite3_bind_text(stmt: rawptr, idx: i32, value: rawptr, n: i32, destructor: rawptr) -> i32;
    fn sqlite3_bind_double(stmt: rawptr, idx: i32, value: f64) -> i32;
    fn sqlite3_reset(stmt: rawptr) -> i32;
}

/// Query result cursor
class Query {
    private handle: rawptr

    /// Move to next row. Returns false when no more rows.
    public fn next() -> bool {
        return sqlite3_step(self.handle) == 100;
    }

    /// Get integer value at column index.
    public fn getInt(col: i32) -> i32 {
        return sqlite3_column_int(self.handle, col);
    }

    /// Get text value at column index.
    public fn getText(col: i32) -> string {
        let ptr = sqlite3_column_text(self.handle, col);
        if (ptr == null) { return ""; }
        return from_cstr(ptr);
    }

    /// Get float value at column index.
    public fn getDouble(col: i32) -> f64 {
        return sqlite3_column_double(self.handle, col);
    }

    /// Get number of columns.
    public fn columnCount() -> i32 {
        return sqlite3_column_count(self.handle);
    }

    /// Bind integer parameter (1-indexed).
    public fn bindInt(idx: i32, value: i32) {
        sqlite3_bind_int(self.handle, idx, value);
    }

    /// Bind text parameter (1-indexed).
    public fn bindText(idx: i32, value: string) {
        sqlite3_bind_text(self.handle, idx, value.c_str() as rawptr, -1, null);
    }

    /// Bind float parameter (1-indexed).
    public fn bindDouble(idx: i32, value: f64) {
        sqlite3_bind_double(self.handle, idx, value);
    }

    /// Reset for re-execution.
    public fn reset() {
        sqlite3_reset(self.handle);
    }

    /// Free the query.
    public fn close() {
        sqlite3_finalize(self.handle);
    }
}

/// Database connection
class Database {
    private handle: rawptr

    /// Open a database file. Returns a Database instance.
    public static fn open(path: string) -> Database {
        var db: rawptr = null;
        sqlite3_open(path.c_str() as rawptr, &mut db as rawptr);
        return Database { handle: db };
    }

    /// Execute SQL with no return value.
    public fn exec(sql: string) -> bool {
        let result = sqlite3_exec(self.handle, sql.c_str() as rawptr, null, null, null);
        return result == 0;
    }

    /// Prepare a SQL query for execution.
    public fn query(sql: string) -> Query {
        var stmt: rawptr = null;
        sqlite3_prepare_v2(self.handle, sql.c_str() as rawptr, -1, &mut stmt as rawptr, null);
        return Query { handle: stmt };
    }

    /// Get last error message.
    public fn error() -> string {
        let ptr = sqlite3_errmsg(self.handle);
        return from_cstr(ptr);
    }

    /// Close the database connection.
    public fn close() {
        sqlite3_close(self.handle);
    }
}
