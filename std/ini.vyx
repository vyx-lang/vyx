module std.ini;

/// INI — Simple INI Key Lookup for Vyx
/// Usage: import std::ini;
///
/// Example:
///   let text = "[server]\nhost=localhost\nport=8080";
///   print(ini_find(text, "server", "host"));   // "localhost"
///   print(ini_find_int(text, "server", "port")); // 8080

public fn ini_find(text: string, section: string, key: string) -> string {
    let target = "[" + section + "]";
    var in_section = false;
    var line_start = 0;
    var i = 0;
    while (i <= text.len) {
        let is_end = i == text.len;
        let is_newline = !is_end && text.charAt(i) == 10;

        if (is_newline || is_end) {
            if (i > line_start) {
                let line = text.substring(line_start, i);
                if (line == target) {
                    in_section = true;
                } elif (line.len > 0 && line.charAt(0) == 91) {
                    in_section = false;
                } elif (in_section) {
                    let eq = line.indexOf("=");
                    if (eq >= 0) {
                        let k = line.substring(0, eq);
                        if (k == key) {
                            return line.substring(eq + 1, line.len);
                        }
                    }
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

public fn ini_find_int(text: string, section: string, key: string) -> i32 {
    let v = ini_find(text, section, key);
    if (v.len == 0) { return 0; }
    var result = 0;
    var i = 0;
    while (i < v.len) {
        let ch = v.charAt(i);
        if (ch >= 48 && ch <= 57) { result = result * 10 + (ch - 48); }
        i = i + 1;
    }
    return result;
}

public fn ini_find_bool(text: string, section: string, key: string) -> bool {
    let v = ini_find(text, section, key);
    return v == "true" || v == "1" || v == "yes";
}
