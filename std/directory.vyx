module std.fs.directory;

/// std/directory.vyx — Directory operations (C#-style OOP API)
///
/// Usage:
///   use std.fs.directory;
///   if (Directory.exists("src")) {
///       let entries = Directory.list("src");
///       // entries is newline-separated string of names
///   }
///   Directory.create("output/logs");

extern "C" {
    fn system(cmd: rawptr) -> i32;
    fn fopen(filename: rawptr, mode: rawptr) -> rawptr;
    fn fclose(fp: rawptr) -> i32;
    fn fseek(fp: rawptr, offset: i64, whence: i32) -> i32;
    fn ftell(fp: rawptr) -> i64;
    fn fread(buf: rawptr, size: i64, count: i64, fp: rawptr) -> i64;
    fn calloc(count: i64, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn remove(filename: rawptr) -> i32;
}

fn _dir_read_file(path: string) -> string {
    let mode = "rb";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return ""; }
    fseek(fp, 0, 2);
    let size = ftell(fp);
    fseek(fp, 0, 0);
    if (size <= 0) { fclose(fp); return ""; }
    let buf = calloc(size + 1, 1);
    if (buf == null) { fclose(fp); return ""; }
    fread(buf, 1, size, fp);
    fclose(fp);
    let result = from_cstr(buf);
    free(buf);
    return result;
}

fn _dir_write_file(path: string, content: string) {
    let mode = "wb";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return; }
    fclose(fp);
}

fn _dir_file_exists(path: string) -> bool {
    let mode = "r";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return false; }
    fclose(fp);
    return true;
}

fn _dir_is_dir(path: string) -> bool {
    // On Windows, `if exist "path\*"` only succeeds for directories.
    let tmp = ".vyx_isdir_tmp.txt";
    let cmd = "if exist \"${path}\\*\" (echo 1 > \"${tmp}\") else (echo 0 > \"${tmp}\")";
    system(cmd.c_str());
    let result = _dir_read_file(tmp);
    _dir_delete_file(tmp);
    if (result.len > 0 && result.charAt(0) == 49) { return true; }
    return false;
}

fn _dir_delete_file(path: string) -> i32 {
    return remove(path.c_str());
}

// ── Directory class ─────────────────────────────────────────────────

/// Static utility class for directory operations.
/// Mirrors C#'s System.IO.Directory.
public class Directory {

    /// Check if a directory exists at the given path.
    public static fn exists(path: string) -> bool {
        return _dir_is_dir(path);
    }

    /// Create a directory. Returns 0 on success.
    public static fn create(path: string) -> i32 {
        if (_dir_is_dir(path)) { return 0; }
        let cmd = "mkdir \"${path}\"";
        return system(cmd.c_str());
    }

    /// Create a directory and all parent directories. Returns 0 on success.
    public static fn createAll(path: string) -> i32 {
        if (path.len == 0) { return 0; }
        if (_dir_is_dir(path)) { return 0; }
        let cmd = "mkdir \"${path}\" 2>NUL";
        return system(cmd.c_str());
    }

    /// Remove an empty directory. Returns 0 on success.
    public static fn remove(path: string) -> i32 {
        let cmd = "rmdir \"${path}\"";
        return system(cmd.c_str());
    }

    /// Remove a directory and all its contents recursively.
    /// WARNING: destructive operation.
    public static fn removeAll(path: string) -> i32 {
        if (!_dir_is_dir(path)) { return -1; }
        let cmd = "rmdir /S /Q \"${path}\" 2>NUL";
        return system(cmd.c_str());
    }

    /// List entries (files and subdirectories) in a directory.
    /// Returns a newline-separated string of names.
    public static fn list(path: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /B \"${path}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// List entries matching a pattern (e.g. "*.vyx").
    public static fn listPattern(path: string, pattern: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /B \"${path}\\${pattern}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// List only subdirectories in a directory.
    public static fn listDirs(path: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /B /AD \"${path}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// List only files (no subdirectories) in a directory.
    public static fn listFiles(path: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /B /A-D \"${path}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// Recursively list all files under a directory (full paths).
    public static fn listRecursive(path: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /S /B /A-D \"${path}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// Recursively list files matching a pattern (full paths).
    public static fn listRecursivePattern(path: string, pattern: string) -> string {
        let tmp = ".vyx_dir_list_tmp.txt";
        let cmd = "dir /S /B /A-D \"${path}\\${pattern}\" > \"${tmp}\" 2>NUL";
        system(cmd.c_str());
        let raw = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        return raw;
    }

    /// Get the current working directory.
    public static fn current() -> string {
        let tmp = ".vyx_cwd_tmp.txt";
        let cmd = "cd > \"${tmp}\"";
        system(cmd.c_str());
        var result = _dir_read_file(tmp);
        _dir_delete_file(tmp);
        while (result.len > 0) {
            let last = result.charAt(result.len - 1);
            if (last == 10 || last == 13) {
                result = result.substring(0, result.len - 1);
            } else {
                break;
            }
        }
        return result;
    }
}
