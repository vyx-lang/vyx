module std.sync;

/// Vyx Standard Library — Sync Primitives (cross-platform mutex + atomic)
///
/// atomic<i64> is implemented as a mutex-guarded i64 — correct for
/// multi-threaded use even though not lock-free. Use the raw atomic_* API
/// for portability; the mutex overhead is negligible for testing purposes.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

@[platform("windows")]
extern "C" {
    fn InitializeCriticalSection(cs: rawptr);
    fn EnterCriticalSection(cs: rawptr);
    fn LeaveCriticalSection(cs: rawptr);
    fn DeleteCriticalSection(cs: rawptr);
}

@[platform("linux")]
extern "C" {
    fn pthread_mutex_init(mutex: rawptr, attr: rawptr) -> i32;
    fn pthread_mutex_lock(mutex: rawptr) -> i32;
    fn pthread_mutex_unlock(mutex: rawptr) -> i32;
    fn pthread_mutex_destroy(mutex: rawptr) -> i32;
}

@[platform("macos")]
extern "C" {
    fn pthread_mutex_init(mutex: rawptr, attr: rawptr) -> i32;
    fn pthread_mutex_lock(mutex: rawptr) -> i32;
    fn pthread_mutex_unlock(mutex: rawptr) -> i32;
    fn pthread_mutex_destroy(mutex: rawptr) -> i32;
}

@[platform("windows")]
public fn sync_mutex_bytes() -> i64 { return 40; }

@[platform("linux")]
public fn sync_mutex_bytes() -> i64 { return 64; }

@[platform("macos")]
public fn sync_mutex_bytes() -> i64 { return 64; }

@[platform("windows")]
public fn sync_atomic_value_offset() -> i64 { return 40; }

@[platform("linux")]
public fn sync_atomic_value_offset() -> i64 { return 64; }

@[platform("macos")]
public fn sync_atomic_value_offset() -> i64 { return 64; }

public fn sync_atomic_bytes() -> i64 {
    return sync_atomic_value_offset() + 8;
}

/// Allocate and initialise a new mutex. Returns an opaque handle (rawptr).
@[platform("windows")]
public fn mutex_new() -> rawptr {
    let p = malloc(sync_mutex_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_mutex_bytes());
    InitializeCriticalSection(p);
    return p;
}

@[platform("linux")]
public fn mutex_new() -> rawptr {
    let p = malloc(sync_mutex_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_mutex_bytes());
    if (pthread_mutex_init(p, null) != 0) {
        free(p);
        return null;
    }
    return p;
}

@[platform("macos")]
public fn mutex_new() -> rawptr {
    let p = malloc(sync_mutex_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_mutex_bytes());
    if (pthread_mutex_init(p, null) != 0) {
        free(p);
        return null;
    }
    return p;
}

/// Acquire (lock) the mutex.
@[platform("windows")]
public fn mutex_lock(m: rawptr) {
    if (m == null) { return; }
    EnterCriticalSection(m);
}

@[platform("linux")]
public fn mutex_lock(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_lock(m) != 0) {
        panic("mutex lock failed");
    }
}

@[platform("macos")]
public fn mutex_lock(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_lock(m) != 0) {
        panic("mutex lock failed");
    }
}

/// Release (unlock) the mutex.
@[platform("windows")]
public fn mutex_unlock(m: rawptr) {
    if (m == null) { return; }
    LeaveCriticalSection(m);
}

@[platform("linux")]
public fn mutex_unlock(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_unlock(m) != 0) {
        panic("mutex unlock failed");
    }
}

@[platform("macos")]
public fn mutex_unlock(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_unlock(m) != 0) {
        panic("mutex unlock failed");
    }
}

/// Destroy and free a mutex.
@[platform("windows")]
public fn mutex_destroy(m: rawptr) {
    if (m == null) { return; }
    DeleteCriticalSection(m);
    free(m);
}

@[platform("linux")]
public fn mutex_destroy(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_destroy(m) != 0) {
        panic("mutex destroy failed");
    }
    free(m);
}

@[platform("macos")]
public fn mutex_destroy(m: rawptr) {
    if (m == null) { return; }
    if (pthread_mutex_destroy(m) != 0) {
        panic("mutex destroy failed");
    }
    free(m);
}

// ── Atomic<i64> ───────────────────────────────────────────────────────────────
// Layout (heap): [mutex bytes] [i64 value (8 bytes)].

/// Allocate a new atomic i64 initialised to `init`.
@[platform("windows")]
public fn atomic_new(init: i64) -> rawptr {
    let p = malloc(sync_atomic_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_atomic_bytes());
    InitializeCriticalSection(p);
    var v = init;
    memcpy(p + sync_atomic_value_offset(), to_rawptr(&v), 8);
    return p;
}

@[platform("linux")]
public fn atomic_new(init: i64) -> rawptr {
    let p = malloc(sync_atomic_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_atomic_bytes());
    if (pthread_mutex_init(p, null) != 0) {
        free(p);
        return null;
    }
    var v = init;
    memcpy(p + sync_atomic_value_offset(), to_rawptr(&v), 8);
    return p;
}

@[platform("macos")]
public fn atomic_new(init: i64) -> rawptr {
    let p = malloc(sync_atomic_bytes());
    if (p == null) { return null; }
    memset(p, 0, sync_atomic_bytes());
    if (pthread_mutex_init(p, null) != 0) {
        free(p);
        return null;
    }
    var v = init;
    memcpy(p + sync_atomic_value_offset(), to_rawptr(&v), 8);
    return p;
}

/// Load the current value.
public fn atomic_load(a: rawptr) -> i64 {
    if (a == null) { return 0; }
    mutex_lock(a);
    var v: i64 = 0;
    memcpy(to_rawptr(&v), a + sync_atomic_value_offset(), 8);
    mutex_unlock(a);
    return v;
}

/// Store a new value.
public fn atomic_store(a: rawptr, val: i64) {
    if (a == null) { return; }
    mutex_lock(a);
    var v = val;
    memcpy(a + sync_atomic_value_offset(), to_rawptr(&v), 8);
    mutex_unlock(a);
}

/// Add `delta` and return the new value.
public fn atomic_add(a: rawptr, delta: i64) -> i64 {
    if (a == null) { return 0; }
    mutex_lock(a);
    var v: i64 = 0;
    memcpy(to_rawptr(&v), a + sync_atomic_value_offset(), 8);
    v = v + delta;
    memcpy(a + sync_atomic_value_offset(), to_rawptr(&v), 8);
    mutex_unlock(a);
    return v;
}

/// Increment by 1 and return the new value.
public fn atomic_inc(a: rawptr) -> i64 {
    return atomic_add(a, 1);
}

/// Decrement by 1 and return the new value.
public fn atomic_dec(a: rawptr) -> i64 {
    return atomic_add(a, -1);
}

/// Compare-and-swap: if *a == expected, set *a = desired.
/// Returns old value.
public fn atomic_cas(a: rawptr, expected: i64, desired: i64) -> i64 {
    if (a == null) { return 0; }
    mutex_lock(a);
    var old: i64 = 0;
    memcpy(to_rawptr(&old), a + sync_atomic_value_offset(), 8);
    if (old == expected) {
        var d = desired;
        memcpy(a + sync_atomic_value_offset(), to_rawptr(&d), 8);
    }
    mutex_unlock(a);
    return old;
}

/// Free an atomic value.
public fn atomic_destroy(a: rawptr) {
    if (a == null) { return; }
    mutex_destroy(a);
    free(a);
}

// ── Mutex<T> wrapper class ────────────────────────────────────────────────────
//
// Typed mutex-guarded value. Usage:
//
//   let m = Mutex::<i64>.new(0);
//   m.lock();
//   m.set(m.get() + 1);
//   m.unlock();
//
//   // Or scoped:
//   m.with_mut(|v| v + 1);   // closure form when closures w/ ref captures are stable
//
// Not copy-safe — each Mutex owns one heap-allocated CRITICAL_SECTION.
// Call destroy() before the value goes out of scope.

class Mutex<T> {
    public handle: rawptr;   // opaque mutex handle from mutex_new()
    public value: T;          // the guarded value

    public static fn new(init: T) -> Mutex<T> {
        return Mutex { handle: mutex_new(), value: init };
    }

    public fn lock()   { mutex_lock(self.handle); }
    public fn unlock() { mutex_unlock(self.handle); }

    /// Read the guarded value. Caller must hold the lock.
    public fn get() -> T { return self.value; }

    /// Write the guarded value. Caller must hold the lock.
    public fn set(v: T) { self.value = v; }

    /// Convenience: lock, mutate via a closure, unlock. The closure
    /// receives the current value and returns the new value.
    public fn update(f: fn(T) -> T) {
        self.lock();
        self.value = f(self.value);
        self.unlock();
    }

    public fn destroy() {
        if (self.handle != null) {
            mutex_destroy(self.handle);
            self.handle = null;
        }
    }

    /// SSS Drop — idempotent via `self.handle == null` sentinel.
    public fn drop() { self.destroy(); }
}

/// Convenience one-shot: `Mutex::<i64>.once_with(0, |v| v + 1)`.
///
/// Constructs a fresh Mutex, applies the closure, reads out the final
/// value, destroys the mutex, and returns the result. Useful when the
/// guarded value is only consulted at a single site (e.g. worker thread
/// counting summaries).
public fn mutex_run_with<T>(init: T, f: fn(T) -> T) -> T {
    let m = Mutex::<T>.new(init);
    m.update(f);
    let out = m.get();
    m.destroy();
    return out;
}
