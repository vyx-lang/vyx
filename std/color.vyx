module std.color;

/// Color — Terminal ANSI Color Codes for Vyx
/// Usage: import std::color;
///
/// Example:
///   print(red("Error: ") + "something failed");
///   print(bold(green("OK")) + " all tests passed");
///   print(bg_blue(white("Header")));

fn esc(code: string) -> string {
    return format("%c[%sm", 27, code);
}

public fn reset() -> string      { return esc("0"); }

public fn bold(s: string) -> string      { return esc("1") + s + esc("0"); }
public fn dim(s: string) -> string       { return esc("2") + s + esc("0"); }
public fn italic(s: string) -> string    { return esc("3") + s + esc("0"); }
public fn underline(s: string) -> string { return esc("4") + s + esc("0"); }

public fn black(s: string) -> string   { return esc("30") + s + esc("0"); }
public fn red(s: string) -> string     { return esc("31") + s + esc("0"); }
public fn green(s: string) -> string   { return esc("32") + s + esc("0"); }
public fn yellow(s: string) -> string  { return esc("33") + s + esc("0"); }
public fn blue(s: string) -> string    { return esc("34") + s + esc("0"); }
public fn magenta(s: string) -> string { return esc("35") + s + esc("0"); }
public fn cyan(s: string) -> string    { return esc("36") + s + esc("0"); }
public fn white(s: string) -> string   { return esc("37") + s + esc("0"); }

public fn bg_black(s: string) -> string   { return esc("40") + s + esc("0"); }
public fn bg_red(s: string) -> string     { return esc("41") + s + esc("0"); }
public fn bg_green(s: string) -> string   { return esc("42") + s + esc("0"); }
public fn bg_yellow(s: string) -> string  { return esc("43") + s + esc("0"); }
public fn bg_blue(s: string) -> string    { return esc("44") + s + esc("0"); }
public fn bg_magenta(s: string) -> string { return esc("45") + s + esc("0"); }
public fn bg_cyan(s: string) -> string    { return esc("46") + s + esc("0"); }
public fn bg_white(s: string) -> string   { return esc("47") + s + esc("0"); }

public fn rgb(s: string, r: i32, g: i32, b: i32) -> string {
    return format("%c[38;2;%d;%d;%dm", 27, r, g, b) + s + esc("0");
}

public fn bg_rgb(s: string, r: i32, g: i32, b: i32) -> string {
    return format("%c[48;2;%d;%d;%dm", 27, r, g, b) + s + esc("0");
}
