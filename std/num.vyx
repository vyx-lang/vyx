module std.num;

/// Vyx Standard Library — Numeric identity traits
///
/// Mirrors Rust's `num_traits` crate (`Zero` / `One` / `Num`) — three
/// markers that let generic numeric algorithms spell out "I need an
/// additive identity", "I need a multiplicative identity", or "I need
/// a full number-shaped thing" as explicit trait bounds rather than
/// relying on leaky monomorphisation.
///
/// Dispatch convention (Phase 8c, 2026-04-24): `T::zero()` / `T::one()`
/// from inside a generic body route through the Sema static-trait
/// rewrite path — at monomorphisation time they become
/// `<Concrete>::zero()` / `<Concrete>::one()` which CodeGen dispatches
/// through the normal `<TypeName>.method` mangling.  See `std/default.vyx`
/// for the canonical precedent (same plumbing, different trait slot).
///
/// Trait-composition note (2026-04-23): `trait Num : Add + Sub + ... {}`
/// is now real Vyx syntax (see `parseInterfaceDecl`).  A `where T: Num`
/// clause therefore implicitly carries the full supertrait bundle —
/// users no longer need to spell out component bounds redundantly.
/// The component impls (`impl Add for i32 { ... }` etc. in std/ops.vyx,
/// `impl Zero for i32 { ... }` below) remain the source of truth for
/// method dispatch; the supertrait chain is just a notational
/// convenience that Sema walks at trait-bound verification time.

use std.ops;    // brings Add / Sub / Mul / Div / Mod / Neg into scope so
                // `trait Num : Add + Sub + Mul + Div + Zero + One {}`
                // below can name them as supertraits without a second `use`.

// ============================================================
// Zero / One traits — additive / multiplicative identity
// ============================================================

/// Additive identity: the unique value such that `x + T::zero() == x`
/// for every `x: T`.  For integers this is `0`; for floats `0.0`; for
/// string it would be `""` (we don't define it there — string is not a
/// "number" in any useful algebraic sense).
///
/// `static fn` marks this as a true static method — no implicit `self`
/// parameter — so `T::zero()` can be called from generic bodies without
/// a tag receiver.  Sema mirrors the `static` flag onto matching
/// `impl Zero for X` methods even when the user omits the keyword.
trait Zero {
    static fn zero() -> Self;
}

/// Multiplicative identity: the unique value such that `x * T::one() == x`
/// for every `x: T`.  For integers this is `1`; for floats `1.0`.
trait One {
    static fn one() -> Self;
}

// ============================================================
// Num umbrella marker
// ============================================================

/// Umbrella "number-shaped" trait.  The supertrait bundle
/// `Add + Sub + Mul + Div + Zero + One` is transitively required of any
/// `T: Num`, so callers can write `where T: Num` instead of
/// enumerating every component bound — Sema walks the supertrait graph
/// during trait-bound verification and checks each requirement against
/// the concrete binding.  `impl Num for i32 {}` etc. below remain
/// marker impls: primitives satisfy every supertrait individually via
/// `std/ops.vyx` + the Zero/One blocks, so the Num impl records
/// nominal membership only.
trait Num : Add + Sub + Mul + Div + Zero + One {}

// ============================================================
// Primitive impls — Zero / One for the full signed + unsigned + float
// family.  Each block registers the method in
// `primitiveMethodImpls_[(typeName, "zero"/"one")]` and records nominal
// satisfaction of the trait in `primitiveTraitSatisfied_`.  Generic
// bodies with `where T: Zero` that call `T::zero()` dispatch through
// `<PrimitiveName>.zero` via the Phase 8 static-trait rewrite.
// ============================================================

// ---- Zero ----
impl Zero for i32 { static fn zero() -> i32 { return 0 as i32; } }
impl Zero for i64 { static fn zero() -> i64 { return 0 as i64; } }
impl Zero for f32 { static fn zero() -> f32 { return 0.0 as f32; } }
impl Zero for f64 { static fn zero() -> f64 { return 0.0; } }
impl Zero for u32 { static fn zero() -> u32 { return 0 as u32; } }
impl Zero for u64 { static fn zero() -> u64 { return 0 as u64; } }

// ---- One ----
impl One for i32 { static fn one() -> i32 { return 1 as i32; } }
impl One for i64 { static fn one() -> i64 { return 1 as i64; } }
impl One for f32 { static fn one() -> f32 { return 1.0 as f32; } }
impl One for f64 { static fn one() -> f64 { return 1.0; } }
impl One for u32 { static fn one() -> u32 { return 1 as u32; } }
impl One for u64 { static fn one() -> u64 { return 1 as u64; } }

// ============================================================
// Num marker — empty impl blocks record nominal satisfaction without
// demanding any methods (the marker has no body).  Primitives already
// satisfy Add / Sub / Mul / Div via std/ops.vyx and Zero / One via the
// blocks above, so each `impl Num for <primitive> {}` just "rubber-
// stamps" the number-shaped contract for trait-bound checking.
// ============================================================

impl Num for i32 {}
impl Num for i64 {}
impl Num for f32 {}
impl Num for f64 {}
impl Num for u32 {}
impl Num for u64 {}
