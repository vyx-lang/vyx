module std.fs.file;

use std.string;
use std.collections;

/// std/file.vyx — File handle with RAII semantics
///
/// Usage:
///   use std.fs.file;
///   let f = File.open("data.txt", "r");
///   let content = f.readAll();
///   f.close();

extern "C" {
    fn fopen(filename: rawptr, mode: rawptr) -> rawptr;
    fn fclose(fp: rawptr) -> i32;
    fn fread(buf: rawptr, size: i64, count: i64, fp: rawptr) -> i64;
    fn fwrite(buf: rawptr, size: i64, count: i64, fp: rawptr) -> i64;
    fn fgetc(fp: rawptr) -> i32;
    fn fputc(c: i32, fp: rawptr) -> i32;
    fn feof(fp: rawptr) -> i32;
    fn fseek(fp: rawptr, offset: i64, whence: i32) -> i32;
    fn ftell(fp: rawptr) -> i64;
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

// Note: fflush is a compiler-reserved builtin name. We avoid declaring it
// here to prevent .1 suffix dedup issues. File.flush() uses fwrite(0) + fclose/reopen
// pattern or is a no-op (OS flushes on close).

let SEEK_SET: i32 = 0;
let SEEK_CUR: i32 = 1;
let SEEK_END: i32 = 2;

// ── File ────────────────────────────────────────────────────────────

/// Open-time behavior for File. Set binary=true for byte-exact protocol data.
public struct FileOptions {
    public read: bool;
    public write: bool;
    public create: bool;
    public truncate: bool;
    public binary: bool;
}

public class File {
    public fp: rawptr;
    private readable: bool;
    private writable: bool;

    /// Open a text or binary stream with explicit access semantics.
    public static fn open(path: string, options: FileOptions) -> File {
        if (!options.read && !options.write) {
            return File { fp: null, readable: false, writable: false };
        }
        var fp: rawptr = null;
        if (options.read && options.write) {
            if (options.truncate) {
                if (options.binary) { fp = fopen(path.c_str(), "w+b".c_str()); }
                else { fp = fopen(path.c_str(), "w+".c_str()); }
            } else {
                if (options.binary) { fp = fopen(path.c_str(), "r+b".c_str()); }
                else { fp = fopen(path.c_str(), "r+".c_str()); }
            }
        } else if (options.write) {
            if (options.truncate) {
                if (options.binary) { fp = fopen(path.c_str(), "wb".c_str()); }
                else { fp = fopen(path.c_str(), "w".c_str()); }
            } else if (options.create) {
                if (options.binary) { fp = fopen(path.c_str(), "ab".c_str()); }
                else { fp = fopen(path.c_str(), "a".c_str()); }
            } else {
                if (options.binary) { fp = fopen(path.c_str(), "r+b".c_str()); }
                else { fp = fopen(path.c_str(), "r+".c_str()); }
            }
        } else {
            if (options.binary) { fp = fopen(path.c_str(), "rb".c_str()); }
            else { fp = fopen(path.c_str(), "r".c_str()); }
        }
        if (fp == null && options.create && options.read && options.write && !options.truncate) {
            if (options.binary) { fp = fopen(path.c_str(), "w+b".c_str()); }
            else { fp = fopen(path.c_str(), "w+".c_str()); }
        }
        return File { fp: fp, readable: options.read, writable: options.write };
    }

    /// Compatibility escape hatch for callers that own a native fopen mode.
    public static fn open_mode(path: string, mode: string) -> File {
        let fp = fopen(path.c_str(), mode.c_str());
        return File { fp: fp, readable: true, writable: true };
    }

    /// Shorthand: open for reading (text mode).
    public static fn read(path: string) -> File {
        return File.open(path, FileOptions { read: true, write: false, create: false, truncate: false, binary: false });
    }

    /// Shorthand: open for reading (binary mode).
    public static fn readBinary(path: string) -> File {
        return File.open(path, FileOptions { read: true, write: false, create: false, truncate: false, binary: true });
    }

    /// Shorthand: create/truncate for writing (text mode).
    public static fn create(path: string) -> File {
        return File.open(path, FileOptions { read: false, write: true, create: true, truncate: true, binary: false });
    }

    /// Shorthand: create/truncate for writing (binary mode).
    public static fn createBinary(path: string) -> File {
        return File.open(path, FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
    }

    /// Shorthand: open for appending.
    public static fn append(path: string) -> File {
        return File.open(path, FileOptions { read: false, write: true, create: true, truncate: false, binary: false });
    }

    public fn isOpen() -> bool {
        return self.fp != null;
    }

    public fn is_open() -> bool { return self.isOpen(); }

    /// Close the file handle. Idempotent.
    public fn close() -> i32 {
        if (self.fp == null) { return 0; }
        let result = fclose(self.fp);
        self.fp = null;
        self.readable = false;
        self.writable = false;
        return result;
    }

    /// RAII drop — auto-close on scope exit.
    public fn drop() {
        self.close();
    }

    /// Read the entire file into a string. Seeks to beginning first.
    public fn readAll() -> string {
        if (self.fp == null) { return ""; }
        fseek(self.fp, 0, SEEK_END);
        let size = ftell(self.fp);
        fseek(self.fp, 0, SEEK_SET);
        if (size <= 0) { return ""; }
        let buf = malloc(size + 1);
        if (buf == null) { return ""; }
        let read_n = fread(buf, 1, size, self.fp);
        memset(buf + read_n, 0, 1);
        let s = from_cstr(buf);
        free(buf);
        return s;
    }

    /// Read the whole stream from offset zero without text decoding.
    public fn read_all_bytes() -> Vec<u8> {
        let empty = Vec::<u8>.new();
        if (self.fp == null || !self.readable) { return empty; }
        if (fseek(self.fp, 0, SEEK_END) != 0) { return empty; }
        let size = ftell(self.fp);
        if (size < 0 || fseek(self.fp, 0, SEEK_SET) != 0 || size == 0) { return empty; }
        var bytes = Vec::<u8>.with_capacity(size);
        if (bytes.data == null) { return empty; }
        let read = fread(bytes.data, 1, size, self.fp);
        if (read != size) { bytes.destroy(); return empty; }
        bytes.len = size;
        return bytes;
    }

    /// Read the whole stream as text. Binary callers must use read_all_bytes.
    public fn read_all_text() -> string {
        if (self.fp == null || !self.readable) { return ""; }
        return self.readAll();
    }

    /// Read up to `n` bytes into a string.
    public fn readN(n: i64) -> string {
        if (self.fp == null || n <= 0) { return ""; }
        let buf = malloc(n + 1);
        if (buf == null) { return ""; }
        let read_n = fread(buf, 1, n, self.fp);
        memset(buf + read_n, 0, 1);
        let s = from_cstr(buf);
        free(buf);
        return s;
    }

    /// Read one line (up to '\n' or EOF). Returns the line WITHOUT
    /// trailing newline. Returns "" at EOF.
    public fn readLine() -> string {
        if (self.fp == null) { return ""; }
        var cap: i64 = 128;
        var len: i64 = 0;
        var buf = malloc(cap + 1);
        if (buf == null) { return ""; }
        while (true) {
            let c = fgetc(self.fp);
            if (c < 0) { break; }  // EOF
            let ch = c & 255;
            if (ch == 10) { break; }  // '\n'
            if (len + 1 >= cap) {
                cap = cap * 2;
                buf = realloc(buf, cap + 1);
                if (buf == null) { return ""; }
            }
            var byte_val: i32 = ch as i32;
            memcpy(buf + len, to_rawptr(&byte_val), 1);
            len = len + 1;
        }
        memset(buf + len, 0, 1);
        if (len == 0 && feof(self.fp) != 0) {
            free(buf);
            return "";
        }
        let s = from_cstr_len(buf, len);
        free(buf);
        return s;
    }

    /// Check if at end of file.
    public fn eof() -> bool {
        if (self.fp == null) { return true; }
        return feof(self.fp) != 0;
    }

    /// Write a string to the file.
    public fn writeStr(s: string) -> i64 {
        if (self.fp == null) { return -1; }
        return fwrite(s.c_str(), 1, s.len as i64, self.fp);
    }

    /// Write raw bytes to the file.
    public fn writeBytes(buf: rawptr, n: i64) -> i64 {
        if (self.fp == null) { return -1; }
        return fwrite(buf, 1, n, self.fp);
    }

    /// Write every byte from a Vec at the current stream position.
    public fn write_all(content: Vec<u8>) -> i32 {
        if (self.fp == null || !self.writable) { return -1; }
        if (content.len == 0) { return 0; }
        if (content.data == null) { return -1; }
        let written = fwrite(content.data, 1, content.len, self.fp);
        if (written != content.len) { return -1; }
        return 0;
    }

    /// Write text through either a text or binary stream without changing
    /// its bytes. The stream mode controls newline translation only.
    public fn write_text(content: string) -> i32 {
        if (self.fp == null || !self.writable) { return -1; }
        if (content.len == 0) { return 0; }
        let written = fwrite(content.c_str(), 1, content.len as i64, self.fp);
        if (written != content.len as i64) { return -1; }
        return 0;
    }

    /// Write a string followed by a newline.
    public fn writeLine(s: string) -> i64 {
        let n1 = self.writeStr(s);
        if (n1 < 0) { return n1; }
        fputc(10, self.fp);
        return n1 + 1;
    }

    /// Flush buffered output to the OS.
    /// Uses fseek(fp, 0, SEEK_CUR) which is a standard way to sync the
    /// file position and flush pending writes without needing fflush
    /// (which collides with a compiler-reserved builtin name).
    public fn flush() {
        if (self.fp != null) {
            fseek(self.fp, 0, SEEK_CUR);
        }
    }

    /// Seek to position. whence: 0=SET, 1=CUR, 2=END
    public fn seek(offset: i64, whence: i32) -> i32 {
        if (self.fp == null) { return -1; }
        return fseek(self.fp, offset, whence);
    }

    /// Current position in the file.
    public fn tell() -> i64 {
        if (self.fp == null) { return -1; }
        return ftell(self.fp);
    }

    /// File size (seeks to end then restores position).
    public fn size() -> i64 {
        if (self.fp == null) { return -1; }
        let cur = ftell(self.fp);
        fseek(self.fp, 0, SEEK_END);
        let sz = ftell(self.fp);
        fseek(self.fp, cur, SEEK_SET);
        return sz;
    }
}

// ── BufferedReader ──────────────────────────────────────────────────

/// Line-by-line reader. Holds a File internally.
///
/// Usage:
///   let reader = BufferedReader.open("data.csv");
///   while (reader.hasNext()) {
///       let line = reader.nextLine();
///       // process line...
///   }
///   reader.close();

public class BufferedReader {
    public file: File;
    public done: bool;
    public next_buf: string;

    /// Open a file for line-by-line reading.
    public static fn open(path: string) -> BufferedReader {
        let f = File.read(path);
        var br = BufferedReader { file: f, done: false, next_buf: "" };
        br._advance();
        return br;
    }

    /// Create a reader from an already-open File.
    public static fn fromFile(f: File) -> BufferedReader {
        var br = BufferedReader { file: f, done: false, next_buf: "" };
        br._advance();
        return br;
    }

    fn _advance() {
        if (!self.file.isOpen() || self.file.eof()) {
            self.done = true;
            self.next_buf = "";
            return;
        }
        let line = self.file.readLine();
        if (line.len == 0 && self.file.eof()) {
            self.done = true;
            self.next_buf = "";
        } else {
            self.next_buf = line;
        }
    }

    /// Returns true if there's another line to read.
    public fn hasNext() -> bool {
        return !self.done;
    }

    /// Returns the next line and advances the reader.
    public fn nextLine() -> string {
        if (self.done) { return ""; }
        let result = self.next_buf;
        self._advance();
        return result;
    }

    /// Close the underlying file.
    public fn close() {
        self.file.close();
        self.done = true;
    }

    public fn drop() {
        self.close();
    }
}

// ── BufferedWriter ─────────────────────────────────────────────────

/// Buffered writer that flushes on close or when buffer is full.
///
/// Usage:
///   let w = BufferedWriter.create("output.log");
///   w.write("line 1\n");
///   w.write("line 2\n");
///   w.close();  // flushes remaining buffer

public class BufferedWriter {
    public file: File;
    public buf: rawptr;
    public len: i64;
    public cap: i64;

    public static fn create(path: string) -> BufferedWriter {
        let f = File.create(path);
        let c: i64 = 8192;
        let b = malloc(c);
        return BufferedWriter { file: f, buf: b, len: 0, cap: c };
    }

    public static fn fromFile(f: File) -> BufferedWriter {
        let c: i64 = 8192;
        let b = malloc(c);
        return BufferedWriter { file: f, buf: b, len: 0, cap: c };
    }

    /// Write a string to the buffer. Flushes automatically when full.
    public fn write(s: string) -> i64 {
        if (!self.file.isOpen()) { return -1; }
        let slen = s.len as i64;
        if (self.len + slen > self.cap) {
            self.flush();
        }
        if (slen > self.cap) {
            // Larger than buffer — write directly
            return self.file.writeStr(s);
        }
        memcpy(self.buf + self.len, s.c_str(), slen);
        self.len = self.len + slen;
        return slen;
    }

    /// Write a line (string + newline).
    public fn writeLine(s: string) -> i64 {
        let n = self.write(s);
        self.write("\n");
        return n + 1;
    }

    /// Flush the internal buffer to disk.
    public fn flush() {
        if (self.len > 0 && self.file.isOpen()) {
            self.file.writeBytes(self.buf, self.len);
            self.len = 0;
        }
        self.file.flush();
    }

    /// Close: flush remaining buffer, close file, free buffer.
    public fn close() {
        self.flush();
        self.file.close();
        if (self.buf != null) {
            free(self.buf);
            self.buf = null;
        }
    }

    public fn drop() {
        self.close();
    }
}
