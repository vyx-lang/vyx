module std.collections;

/// Vyx Standard Library — Stack (LIFO) and Queue (FIFO)
/// Provides both generic class API and legacy function API for compatibility.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

// ---------- Generic class API ----------
class Stack<T> : Iterable {
    public data: rawptr;
    public len: i64;
    public cap: i64;
    public elem_size: i64;
    public gen: i64;

    public static fn new() -> Stack<T> {
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return Stack { data: d, len: 0, cap: c, elem_size: es, gen: 0 };
    }

    fn ensure_capacity(min_cap: i64) {
        if (self.cap >= min_cap) { return; }
        var nc = self.cap;
        if (nc <= 0) { nc = 16; }
        while (nc < min_cap) { nc = nc * 2; }
        self.data = realloc(self.data, nc * self.elem_size);
        self.cap = nc;
    }

    public fn push(val: T) {
        self.ensure_capacity(self.len + 1);
        let slot = self.data + self.len * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn pop() -> T {
        if (self.len <= 0) { panic("Stack.pop from empty stack"); }
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        let slot = self.data + self.len * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, sizeof::<T>());
        return out;
    }

    public fn peek() -> T {
        if (self.len <= 0) { panic("Stack.peek on empty stack"); }
        let slot = self.data + (self.len - 1) * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, sizeof::<T>());
        return out;
    }

    public fn get(idx: i64) -> T {
        if (idx < 0 || idx >= self.len) { panic("Stack.get out of bounds"); }
        let slot = self.data + idx * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    public fn get_ptr(idx: i64) -> *T {
        if (idx < 0 || idx >= self.len) { panic("Stack.get_ptr out of bounds"); }
        return (self.data + idx * self.elem_size) as *T;
    }

    public fn operator[](idx: i64) -> *T {
        return self.get_ptr(idx);
    }

    public fn set(idx: i64, val: T) {
        if (idx < 0 || idx >= self.len) { panic("Stack.set out of bounds"); }
        memcpy(self.data + idx * self.elem_size, to_rawptr(&val), self.elem_size);
    }

    public fn isEmpty() -> bool { return self.len == 0; }
    public fn clear() { self.len = 0; self.gen = self.gen + 1; }

    /// Iterate bottom → top (oldest-pushed first). For top-down order,
    /// pop in a loop. Same invalidation contract as Vec.
    public fn iter() -> Iterator<T> {
        return Iterator {
            data: self.data, len: self.len, pos: 0,
            source_gen: to_rawptr(&self.gen),
            gen_snapshot: self.gen
        };
    }

    public fn destroy() {
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }

    /// SSS Drop — idempotent via `self.data == null` sentinel.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Preserves bottom→top order — a clone of [a, b, c] (c on top)
    /// still pops c, b, a. Non-Clone element types remain legal as
    /// long as the user never calls `clone()` on their Stack (same
    /// opt-in policy as `Vec.clone`).
    ///
    /// Tagged `@[lazy]` so Mono only instantiates this when a call site
    /// actually invokes `.clone()`, keeping `Stack<T>` first-class for
    /// non-Clone element types (closures, raw FFI handles, ...).
    @[lazy]
    public fn clone() -> Stack<T> {
        var out = Stack::<T>.new();
        out.ensure_capacity(self.len);
        let es = sizeof::<T>();
        var i: i64 = 0;
        while (i < self.len) {
            var e: T = 0;
            memcpy(to_rawptr(&e), self.data + i * es, es);
            out.push(e.clone());
            i = i + 1;
        }
        return out;
    }
}

class Queue<T> : Iterable {
    public data: rawptr;
    public cap: i64;
    public head: i64;
    public tail: i64;
    public elem_size: i64;

    public static fn new() -> Queue<T> {
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return Queue { data: d, cap: c, head: 0, tail: 0, elem_size: es };
    }

    fn _len() -> i64 {
        if (self.tail >= self.head) { return self.tail - self.head; }
        return self.cap - self.head + self.tail;
    }

    public fn enqueue(val: T) {
        let next_tail = (self.tail + 1) % self.cap;
        if (next_tail == self.head) {
            let old_len = self._len();
            let nc = self.cap * 2;
            let nd = malloc(nc * self.elem_size);
            if (nd != null) { memset(nd, 0, nc * self.elem_size); }
            var i: i64 = 0;
            var src_idx = self.head;
            while (i < old_len) {
                memcpy(nd + i * self.elem_size, self.data + src_idx * self.elem_size, self.elem_size);
                src_idx = (src_idx + 1) % self.cap;
                i = i + 1;
            }
            free(self.data);
            self.data = nd;
            self.head = 0;
            self.tail = old_len;
            self.cap = nc;
        }
        memcpy(self.data + self.tail * self.elem_size, to_rawptr(&val), self.elem_size);
        self.tail = (self.tail + 1) % self.cap;
    }

    public fn dequeue() -> T {
        if (self.head == self.tail) { panic("Queue.dequeue from empty queue"); }
        var out: T = 0;
        memcpy(to_rawptr(&out), self.data + self.head * self.elem_size, sizeof::<T>());
        self.head = (self.head + 1) % self.cap;
        return out;
    }

    public fn peek() -> T {
        if (self.head == self.tail) { panic("Queue.peek on empty queue"); }
        var out: T = 0;
        memcpy(to_rawptr(&out), self.data + self.head * self.elem_size, sizeof::<T>());
        return out;
    }

    public fn get(idx: i64) -> T {
        if (idx < 0 || idx >= self._len()) { panic("Queue.get out of bounds"); }
        let phys = (self.head + idx) % self.cap;
        var out: T = 0;
        memcpy(to_rawptr(&out), self.data + phys * self.elem_size, self.elem_size);
        return out;
    }

    public fn get_ptr(idx: i64) -> *T {
        if (idx < 0 || idx >= self._len()) { panic("Queue.get_ptr out of bounds"); }
        let phys = (self.head + idx) % self.cap;
        return (self.data + phys * self.elem_size) as *T;
    }

    public fn operator[](idx: i64) -> *T {
        return self.get_ptr(idx);
    }

    public fn set(idx: i64, val: T) {
        if (idx < 0 || idx >= self._len()) { panic("Queue.set out of bounds"); }
        let phys = (self.head + idx) % self.cap;
        memcpy(self.data + phys * self.elem_size, to_rawptr(&val), self.elem_size);
    }

    public fn len() -> i64 { return self._len(); }
    public fn isEmpty() -> bool { return self.head == self.tail; }

    public fn clear() {
        self.head = 0;
        self.tail = 0;
    }

    public fn destroy() {
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.cap = 0;
        self.head = 0;
        self.tail = 0;
    }

    /// SSS Drop — idempotent via `self.data == null` sentinel.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Iterates logical head→tail, enqueues cloned elements into a
    /// fresh Queue so dequeue order is preserved. Requires
    /// `T: Clone` at call time. Tagged `@[lazy]` so non-cloneable
    /// element types remain usable.
    @[lazy]
    public fn clone() -> Queue<T> {
        var out = Queue::<T>.new();
        let es = self.elem_size;
        var idx = self.head;
        while (idx != self.tail) {
            var e: T = 0;
            memcpy(to_rawptr(&e), self.data + idx * es, es);
            out.enqueue(e.clone());
            idx = (idx + 1) % self.cap;
        }
        return out;
    }
}

// ---------- Legacy function API ----------
// The internal `__vec_*` helpers used by the legacy stack/queue APIs live in
// `set.vyx` (same `std.collections` module). Duplicating them here would
// violate the one-definition rule; we rely on them being visible across all
// files within the `std.collections` module.

// Stack header: items vec ptr (8)
public fn stack_new() -> rawptr {
    let s = malloc(8);
    let v = __vec_new();
    memcpy(s, to_rawptr(&v), 8);
    return s;
}
fn stack_items(s: rawptr) -> rawptr { var v: rawptr = null; memcpy(to_rawptr(&v), s, 8); return v; }
public fn stack_push(s: rawptr, val: i64) { __vec_push(stack_items(s), val); }
public fn stack_pop(s: rawptr) -> i64 { return __vec_pop(stack_items(s)); }
public fn stack_peek(s: rawptr) -> i64 { return __vec_last(stack_items(s)); }
public fn stack_len(s: rawptr) -> i64 { return __vec_len(stack_items(s)); }
public fn stack_is_empty(s: rawptr) -> bool { return stack_len(s) == 0; }
public fn stack_clear(s: rawptr) { __vec_clear(stack_items(s)); }
public fn stack_free(s: rawptr) { __vec_free(stack_items(s)); free(s); }

// Queue header: items vec ptr (8) + head (8)
public fn queue_new() -> rawptr {
    let q = malloc(16);
    let v = __vec_new();
    let z: i64 = 0;
    memcpy(q, to_rawptr(&v), 8);
    memcpy(q + 8, to_rawptr(&z), 8);
    return q;
}
fn queue_items(q: rawptr) -> rawptr { var v: rawptr = null; memcpy(to_rawptr(&v), q, 8); return v; }
fn queue_head(q: rawptr) -> i64 { var h: i64 = 0; memcpy(to_rawptr(&h), q + 8, 8); return h; }
fn queue_set_head(q: rawptr, h: i64) { memcpy(q + 8, to_rawptr(&h), 8); }
public fn queue_enqueue(q: rawptr, val: i64) { __vec_push(queue_items(q), val); }
public fn queue_dequeue(q: rawptr) -> i64 {
    let h = queue_head(q);
    let out = __vec_get(queue_items(q), h);
    queue_set_head(q, h + 1);
    return out;
}
public fn queue_peek(q: rawptr) -> i64 { return __vec_get(queue_items(q), queue_head(q)); }
public fn queue_len(q: rawptr) -> i64 { return __vec_len(queue_items(q)) - queue_head(q); }
public fn queue_is_empty(q: rawptr) -> bool { return queue_len(q) == 0; }
public fn queue_clear(q: rawptr) { __vec_clear(queue_items(q)); let z: i64 = 0; queue_set_head(q, z); }
public fn queue_free(q: rawptr) { __vec_free(queue_items(q)); free(q); }
