module std.collections;

use std.core;

/// Vyx Standard Library — PriorityQueue<T>
///
/// Binary-heap priority queue. Layout mirrors `Stack<T>` / `Queue<T>`: the
/// backing storage is a raw byte buffer sized by `sizeof::<T>()`, so the class
/// fields play nicely with the current generic-class codegen.
///
/// * Default is a **min-heap** (smallest element first).
/// * Use `.as_max_heap()` right after `new()` / `with_capacity()` to switch to
///   a max-heap while the queue is still empty.
///
/// Ordering relies on `T` supporting `<` / `>` (primitives: i8/i16/i32/i64,
/// f32/f64, and anything that compares as an integer). For structs or strings
/// pre-map to a scalar key before pushing.
///
///
/// Usage:
///     use std.core;
///     use std.collections;
///
///     var pq = PriorityQueue::<i64>.new();
///     pq.push(3); pq.push(1); pq.push(4); pq.push(1); pq.push(5);
///     match (pq.pop()) {
///         case Some(v) => { print("smallest = ${v}"); }
///         case None    => { print("empty"); }
///     }

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

// ---------- Generic class API ----------

class PriorityQueue<T> {
    public data: rawptr;
    public len: i64;
    public cap: i64;
    public elem_size: i64;
    public is_max: bool;
    public gen: i64;

    /// Creates an empty min-heap.
    public static fn new() -> PriorityQueue<T> {
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return PriorityQueue { data: d, len: 0, cap: c, elem_size: es, is_max: false, gen: 0 };
    }

    /// Creates a min-heap with reserved capacity.
    public static fn with_capacity(cap: i64) -> PriorityQueue<T> {
        let es = sizeof::<T>();
        var c = cap;
        if (c < 4) { c = 4; }
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return PriorityQueue { data: d, len: 0, cap: c, elem_size: es, is_max: false, gen: 0 };
    }

    /// Switches the heap to max-heap behaviour in place. Safe only on an empty
    /// heap (no re-heapification is performed here).
    public fn as_max_heap() -> PriorityQueue<T> {
        self.is_max = true;
        return self;
    }

    /// Mirror of `as_max_heap()`; no-op on a freshly constructed queue.
    public fn as_min_heap() -> PriorityQueue<T> {
        self.is_max = false;
        return self;
    }

    public fn isEmpty() -> bool { return self.len == 0; }
    public fn capacity() -> i64 { return self.cap; }
    public fn clear() { self.len = 0; self.gen = self.gen + 1; }

    public fn destroy() {
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }

    /// SSS Drop — idempotent via `self.data == null` sentinel.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Allocates a fresh backing buffer and clones every heap slot
    /// preserving the internal heap-array layout so the two PQs
    /// pop in the same priority order. Preserves `is_max` / `gen`
    /// bookkeeping on the clone's own counters. Requires `T: Clone`
    /// at call time. Tagged `@[lazy]` so non-Clone T remains valid.
    @[lazy]
    public fn clone() -> PriorityQueue<T> {
        var out = PriorityQueue::<T>.with_capacity(self.len);
        out.is_max = self.is_max;
        let es = self.elem_size;
        var i: i64 = 0;
        while (i < self.len) {
            var e: T = 0;
            memcpy(to_rawptr(&e), self.data + i * es, es);
            let ec = e.clone();
            memcpy(out.data + i * es, to_rawptr(&ec), es);
            i = i + 1;
        }
        out.len = self.len;
        return out;
    }

    fn ensure_capacity(min_cap: i64) {
        if (self.cap >= min_cap) { return; }
        var nc = self.cap;
        if (nc <= 0) { nc = 16; }
        while (nc < min_cap) { nc = nc * 2; }
        self.data = realloc(self.data, nc * self.elem_size);
        self.cap = nc;
    }

    fn _get(idx: i64) -> T {
        let slot = self.data + idx * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    fn _set(idx: i64, val: T) {
        let slot = self.data + idx * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
    }

    fn _swap(i: i64, j: i64) {
        let es = self.elem_size;
        var ai: T = 0;
        var bi: T = 0;
        memcpy(to_rawptr(&ai), self.data + i * es, es);
        memcpy(to_rawptr(&bi), self.data + j * es, es);
        memcpy(self.data + i * es, to_rawptr(&bi), es);
        memcpy(self.data + j * es, to_rawptr(&ai), es);
    }

    /// Returns true when `a` should sit **above** `b` in the heap.
    fn _heap_less(a: T, b: T) -> bool {
        if (self.is_max) { return a > b; }
        return a < b;
    }

    fn _sift_up(start: i64) {
        var idx = start;
        while (idx > 0) {
            let parent = (idx - 1) / 2;
            let iv: T = self._get(idx);
            let pv: T = self._get(parent);
            if (self._heap_less(iv, pv)) {
                self._swap(idx, parent);
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(start: i64) {
        var idx = start;
        let n = self.len;
        while (true) {
            let left = 2 * idx + 1;
            let right = 2 * idx + 2;
            var best = idx;
            if (left < n) {
                let lv: T = self._get(left);
                let bv: T = self._get(best);
                if (self._heap_less(lv, bv)) { best = left; }
            }
            if (right < n) {
                let rv: T = self._get(right);
                let bv2: T = self._get(best);
                if (self._heap_less(rv, bv2)) { best = right; }
            }
            if (best == idx) { return; }
            self._swap(idx, best);
            idx = best;
        }
    }

    public fn push(val: T) {
        self.ensure_capacity(self.len + 1);
        self._set(self.len, val);
        self.len = self.len + 1;
        self._sift_up(self.len - 1);
        self.gen = self.gen + 1;
    }

    public fn peek() -> Option<T> {
        if (self.len == 0) { return None; }
        return Some(self._get(0));
    }

    public fn pop() -> Option<T> {
        let n = self.len;
        if (n == 0) { return None; }
        let top: T = self._get(0);
        if (n == 1) {
            self.len = 0;
            self.gen = self.gen + 1;
            return Some(top);
        }
        let last: T = self._get(n - 1);
        self.len = n - 1;
        self._set(0, last);
        self._sift_down(0);
        self.gen = self.gen + 1;
        return Some(top);
    }

    /// Iterate the heap's internal storage. **Order is unspecified** —
    /// the binary-heap layout is NOT sorted; iteration yields items in
    /// the heap-array order. To drain in priority order, call `.pop()`
    /// in a loop instead. Same invalidation contract as Vec.
    public fn iter() -> Iterator<T> {
        return Iterator {
            data: self.data, len: self.len, pos: 0,
            source_gen: to_rawptr(&self.gen),
            gen_snapshot: self.gen
        };
    }
}

