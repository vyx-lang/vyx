module std.fs;

use std.string;

/// std/fs.vyx — File System Module
/// High-level file I/O built on C stdio
///
/// `use std.fs` imports this module plus all submodules:
///   std.fs.file (File, BufferedReader, BufferedWriter)
///   std.fs.path (Path class)
///   std.fs.directory (Directory class)
///
/// This works via hierarchical module import — no re-export needed.

extern "C" {
    fn fopen(filename: rawptr, mode: rawptr) -> rawptr;
    fn fclose(fp: rawptr) -> i32;
    fn fread(buf: rawptr, size: i64, count: i64, fp: rawptr) -> i64;
    fn fwrite(buf: rawptr, size: i64, count: i64, fp: rawptr) -> i64;
    fn fgetc(fp: rawptr) -> i32;
    fn fputc(c: i32, fp: rawptr) -> i32;
    fn feof(fp: rawptr) -> i32;
    fn fseek(fp: rawptr, offset: i64, whence: i32) -> i32;
    fn ftell(fp: rawptr) -> i64;
    fn remove(filename: rawptr) -> i32;
    fn rename(oldname: rawptr, newname: rawptr) -> i32;
    fn calloc(count: i64, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
}

@[platform("windows")]
extern "C" {
    fn FindFirstFileA(pattern: rawptr, data: rawptr) -> rawptr;
    fn FindNextFileA(handle: rawptr, data: rawptr) -> i32;
    fn FindClose(handle: rawptr) -> i32;
}

@[platform("posix")]
extern "C" {
    fn opendir(name: rawptr) -> rawptr;
    fn readdir(dirp: rawptr) -> rawptr;
    fn closedir(dirp: rawptr) -> i32;
}

error FSError { FileNotFound, PermissionDenied, IOError }

/// Read entire file into a string. Returns empty string on failure.
public fn readFile(path: string) -> string {
    let mode = "rb";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return ""; }
    fseek(fp, 0, 2);
    let size = ftell(fp);
    fseek(fp, 0, 0);
    if (size <= 0) { fclose(fp); return ""; }
    let buf = calloc(size + 1, 1);
    if (buf == null) { fclose(fp); return ""; }
    fread(buf, 1, size, fp);
    fclose(fp);
    let result = from_cstr(buf);
    return result;
}

/// Write string content to a file. Returns 0 on success.
public fn writeFile(path: string, content: string) -> i32 {
    let mode = "wb";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return -1; }
    let written = fwrite(content.c_str(), 1, content.len as i64, fp);
    fclose(fp);
    if (written != content.len as i64) { return -1; }
    return 0;
}

/// Append string content to a file. Returns 0 on success.
public fn appendFile(path: string, content: string) -> i32 {
    if (path.len == 0) { return -1; }
    let mode = "ab";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return -1; }
    fwrite(content.c_str(), 1, content.len as i64, fp);
    fclose(fp);
    return 0;
}

/// Check if a file exists
public fn fileExists(path: string) -> bool {
    let mode = "r";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return false; }
    fclose(fp);
    return true;
}

/// Delete a file
public fn deleteFile(path: string) -> i32 {
    return remove(path.c_str());
}

/// Rename/move a file
public fn renameFile(oldpath: string, newpath: string) -> i32 {
    return rename(oldpath.c_str(), newpath.c_str());
}

/// Get file size in bytes. Returns -1 on failure.
public fn fileSize(path: string) -> i64 {
    let mode = "rb";
    let fp = fopen(path.c_str(), mode.c_str());
    if (fp == null) { return -1; }
    fseek(fp, 0, 2);
    let size = ftell(fp);
    fclose(fp);
    return size;
}

fn fs_join_path(dir: string, name: string) -> string {
    if (dir.len == 0) { return name; }
    let last = dir.charAt(dir.len - 1);
    if (last == 47 || last == 92) { return str_concat(dir, name); }
    return str_concat(str_concat(dir, "/"), name);
}

fn fs_has_extension(name: string, extension: string) -> bool {
    if (extension.len == 0) { return true; }
    if (extension.charAt(0) == 46) { return str_ends_with(name, extension); }
    return str_ends_with(name, str_concat(".", extension));
}

/// Copy a file. Returns 0 on success.
public fn copyFile(src: string, dst: string) -> i32 {
    let in_mode = "rb";
    let out_mode = "wb";
    let input = fopen(src.c_str(), in_mode.c_str());
    if (input == null) { return -1; }

    let output = fopen(dst.c_str(), out_mode.c_str());
    if (output == null) { fclose(input); return -1; }

    let buffer_size: i64 = 65536;
    let buffer = calloc(buffer_size, 1);
    if (buffer == null) { fclose(output); fclose(input); return -1; }

    while (true) {
        let read = fread(buffer, 1, buffer_size, input);
        if (read < 0) { free(buffer); fclose(output); fclose(input); return -1; }
        if (read == 0) { break; }
        let written = fwrite(buffer, 1, read, output);
        if (written != read) { free(buffer); fclose(output); fclose(input); return -1; }
    }

    free(buffer);
    fclose(output);
    fclose(input);
    return 0;
}

@[platform("windows")]
fn fs_win_find_data_name(data: rawptr) -> string {
    return from_cstr(data + 44);
}

@[platform("windows")]
public fn copyFilesWithExtension(src_dir: string, dst_dir: string, extension: string) -> i32 {
    let pattern = fs_join_path(src_dir, "*");
    let data = calloc(592, 1);
    if (data == null) { return -1; }
    let handle = FindFirstFileA(pattern.c_str(), data);
    if (handle == null || handle as i64 == -1) { free(data); return -1; }

    var copied: i32 = 0;
    var keep_going = true;
    while (keep_going) {
        let name = fs_win_find_data_name(data);
        if (name != "." && name != ".." && fs_has_extension(name, extension)) {
            let src = fs_join_path(src_dir, name);
            let dst = fs_join_path(dst_dir, name);
            if (copyFile(src, dst) != 0) { FindClose(handle); free(data); return -1; }
            copied = copied + 1;
        }
        keep_going = FindNextFileA(handle, data) != 0;
    }

    FindClose(handle);
    free(data);
    return copied;
}

@[platform("posix")]
fn fs_posix_dirent_name(entry: rawptr) -> string {
    return from_cstr(entry + 19);
}

@[platform("posix")]
public fn copyFilesWithExtension(src_dir: string, dst_dir: string, extension: string) -> i32 {
    let dir = opendir(src_dir.c_str());
    if (dir == null) { return -1; }

    var copied: i32 = 0;
    var entry = readdir(dir);
    while (entry != null) {
        let name = fs_posix_dirent_name(entry);
        if (name != "." && name != ".." && fs_has_extension(name, extension)) {
            let src = fs_join_path(src_dir, name);
            let dst = fs_join_path(dst_dir, name);
            if (copyFile(src, dst) != 0) { closedir(dir); return -1; }
            copied = copied + 1;
        }
        entry = readdir(dir);
    }

    closedir(dir);
    return copied;
}

// --- Directory operations (via system() for portability) ---

extern "C" {
    fn system(cmd: rawptr) -> i32;
}

/// Create a directory. Returns 0 on success.
public fn makeDir(path: string) -> i32 {
    if (isDir(path)) { return 0; }
    let cmd = "mkdir \"" + path + "\"";
    return system(cmd.c_str());
}

/// Remove an empty directory. Returns 0 on success.
public fn removeDir(path: string) -> i32 {
    let cmd = "rmdir \"" + path + "\"";
    return system(cmd.c_str());
}

/// Check if path is a directory (via fopen heuristic).
public fn isDir(path: string) -> bool {
    let test = path + "/.";
    let mode = "r";
    let fp = fopen(test.c_str(), mode.c_str());
    if (fp != null) { fclose(fp); return true; }
    return false;
}

/// Check if path is a regular file.
public fn isFile(path: string) -> bool {
    return fileExists(path) && !isDir(path);
}

// ── Path Utilities ───────────────────────────────────────

public fn path_separator() -> i32 {
    return 92;
}

public fn is_absolute(path: string) -> bool {
    if (path.len >= 2 && path.charAt(1) == 58) { return true; }
    if (path.len >= 1) {
        let ch = path.charAt(0);
        if (ch == 47 || ch == 92) { return true; }
    }
    return false;
}

// ── Path Utilities (continued) ───────────────────────────────────

/// Join two path segments with a forward slash separator.
public fn path_join(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    if (b.len == 0) { return a; }
    let last = a.charAt(a.len - 1);
    if (last == 47 || last == 92) { return "${a}${b}"; }
    return "${a}/${b}";
}

/// Get the file name from a path (everything after last separator).
public fn path_filename(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return path; }
    return path.substring(last + 1, path.len);
}

/// Get the directory part of a path (everything before last separator).
public fn path_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return "."; }
    if (last == 0) { return path.substring(0, 1); }
    return path.substring(0, last);
}

/// Get the file extension (including the dot). Returns "" if none.
public fn path_extension(path: string) -> string {
    let name = path_filename(path);
    var dot: i32 = -1;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { dot = i; }
        i = i + 1;
    }
    if (dot <= 0) { return ""; }
    return name.substring(dot, name.len);
}

/// Get the stem (filename without extension).
public fn path_stem(path: string) -> string {
    let name = path_filename(path);
    var dot: i32 = -1;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { dot = i; }
        i = i + 1;
    }
    if (dot <= 0) { return name; }
    return name.substring(0, dot);
}

/// Normalize path separators to forward slash.
/// Note: uses charAt + substring loop; the result is built incrementally
/// and returned via f-string to work around bootstrap string-return ABI.
public fn path_normalize(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return "${out}";
}

// ── Path class (C#-style OOP API) ───────────────────────────────

/// Immutable path object. Provides a fluent, object-oriented API for
/// path manipulation, inspired by C#'s System.IO.Path / .NET FileInfo.
///
/// Usage:
///   let p = Path.new("src/include/mixed_helpers.h");
///   print(p.filename());    // "mixed_helpers.h"
///   print(p.extension());   // ".h"
///   print(p.stem());        // "mixed_helpers"
///   print(p.parent().str());// "src/include"
///   let joined = p.parent().join("other.h");
///   print(joined.str());    // "src/include/other.h"

public class Path {
    public value: string;

    /// Create a Path from a string.
    public static fn new(s: string) -> Path {
        return Path { value: s };
    }

    /// Create a Path from two segments joined together.
    public static fn combine(a: string, b: string) -> Path {
        return Path { value: path_join(a, b) };
    }

    /// The raw string representation.
    public fn str() -> string { return self.value; }
    public fn toString() -> string { return self.value; }
    public fn len() -> i64 { return self.value.len as i64; }

    /// The file name (last component after separator).
    /// "src/foo/bar.txt" → "bar.txt"
    public fn filename() -> string {
        return path_filename(self.value);
    }

    /// The file extension including the dot.
    /// "bar.txt" → ".txt", "Makefile" → ""
    public fn extension() -> string {
        return path_extension(self.value);
    }

    /// The stem (filename without extension).
    /// "bar.txt" → "bar"
    public fn stem() -> string {
        return path_stem(self.value);
    }

    /// The parent directory.
    /// "src/foo/bar.txt" → Path("src/foo")
    public fn parent() -> Path {
        return Path { value: path_dirname(self.value) };
    }

    /// Join a child segment, returning a new Path.
    /// Path("src").join("main.vyx") → Path("src/main.vyx")
    public fn join(child: string) -> Path {
        return Path { value: path_join(self.value, child) };
    }

    /// Join with another Path.
    public fn joinPath(other: Path) -> Path {
        return Path { value: path_join(self.value, other.value) };
    }

    /// Whether this is an absolute path.
    public fn isAbsolute() -> bool {
        return is_absolute(self.value);
    }

    /// Whether this is a relative path.
    public fn isRelative() -> bool {
        return !is_absolute(self.value);
    }

    /// Normalize separators to forward slash.
    public fn normalize() -> Path {
        return Path { value: path_normalize(self.value) };
    }

    /// Change the extension. Pass "" to remove it.
    /// Path("foo.txt").withExtension(".md") → Path("foo.md")
    public fn withExtension(ext: string) -> Path {
        let dir = path_dirname(self.value);
        let s = path_stem(self.value);
        let new_name = "${s}${ext}";
        if (dir == ".") {
            return Path { value: new_name };
        }
        return Path { value: path_join(dir, new_name) };
    }

    /// Change the filename, keeping the directory.
    /// Path("src/foo.txt").withFilename("bar.rs") → Path("src/bar.rs")
    public fn withFilename(name: string) -> Path {
        let dir = path_dirname(self.value);
        if (dir == ".") {
            return Path { value: name };
        }
        return Path { value: path_join(dir, name) };
    }

    /// Whether the path has an extension.
    public fn hasExtension() -> bool {
        return path_extension(self.value).len > 0;
    }

    // ── File system queries (delegates to free functions) ────────

    /// Whether a file exists at this path.
    public fn exists() -> bool {
        return fileExists(self.value);
    }

    /// Whether this path points to a directory.
    public fn isDir() -> bool {
        return isDir(self.value);
    }

    /// Whether this path points to a regular file.
    public fn isFile() -> bool {
        return isFile(self.value);
    }

    /// File size in bytes. Returns -1 if not found.
    public fn fileSize() -> i64 {
        return fileSize(self.value);
    }

    /// Read the entire file at this path into a string.
    public fn readFile() -> string {
        return readFile(self.value);
    }

    /// Write content to the file at this path.
    public fn writeFile(content: string) -> i32 {
        return writeFile(self.value, content);
    }

    /// Delete the file at this path.
    public fn deleteFile() -> i32 {
        return deleteFile(self.value);
    }

    /// Get the absolute version of this path.
    public fn toAbsolute() -> Path {
        return Path { value: absolutePath(self.value) };
    }

    /// Equality.
    public fn operator_eq(other: Path) -> bool {
        return self.value == other.value;
    }
}

// ── Directory Listing ────────────────────────────────────────────

/// List files in a directory. Returns a newline-separated string of paths.
/// Uses `dir /B` on Windows. Returns "" on failure.
public fn listDir(path: string) -> string {
    let tmp = ".vyx_listdir_tmp.txt";
    let cmd = "dir /B \"" + path + "\" > \"" + tmp + "\" 2>NUL";
    system(cmd.c_str());
    let raw = readFile(tmp);
    deleteFile(tmp);
    return raw;
}

/// List files in a directory matching a pattern (e.g. "*.vyx").
/// Returns newline-separated paths.
public fn listDirPattern(path: string, pattern: string) -> string {
    let tmp = ".vyx_listdir_tmp.txt";
    let cmd = "dir /B \"" + path + "\\" + pattern + "\" > \"" + tmp + "\" 2>NUL";
    system(cmd.c_str());
    let raw = readFile(tmp);
    deleteFile(tmp);
    return raw;
}

/// Recursively list all files under a directory.
/// Returns newline-separated full paths.
public fn listDirRecursive(path: string) -> string {
    let tmp = ".vyx_listdir_tmp.txt";
    let cmd = "dir /S /B /A-D \"" + path + "\" > \"" + tmp + "\" 2>NUL";
    system(cmd.c_str());
    let raw = readFile(tmp);
    deleteFile(tmp);
    return raw;
}

/// Recursively list files matching a pattern.
public fn listDirRecursivePattern(path: string, pattern: string) -> string {
    let tmp = ".vyx_listdir_tmp.txt";
    let cmd = "dir /S /B /A-D \"" + path + "\\" + pattern + "\" > \"" + tmp + "\" 2>NUL";
    system(cmd.c_str());
    let raw = readFile(tmp);
    deleteFile(tmp);
    return raw;
}

/// Create directories recursively (like mkdir -p).
public fn makeDirAll(path: string) -> i32 {
    if (path.len == 0) { return 0; }
    if (isDir(path)) { return 0; }
    let cmd = "mkdir \"" + path + "\" 2>NUL";
    return system(cmd.c_str());
}

/// Remove a directory and all its contents recursively.
/// WARNING: destructive operation.
public fn removeDirAll(path: string) -> i32 {
    if (!isDir(path)) { return -1; }
    let cmd = "rmdir /S /Q \"" + path + "\" 2>NUL";
    return system(cmd.c_str());
}

/// Get the current working directory.
public fn cwd() -> string {
    let tmp = ".vyx_cwd_tmp.txt";
    let cmd = "cd > \"" + tmp + "\"";
    system(cmd.c_str());
    var result = readFile(tmp);
    deleteFile(tmp);
    // Trim trailing \r\n
    while (result.len > 0) {
        let last = result.charAt(result.len - 1);
        if (last == 10 || last == 13) {
            result = result.substring(0, result.len - 1);
        } else {
            break;
        }
    }
    return result;
}

/// Get the absolute path of a relative path.
public fn absolutePath(path: string) -> string {
    if (is_absolute(path)) { return path; }
    return path_join(cwd(), path);
}
