module std.testing;

use std.collections;

// Vyx Standard Library: Testing Module
// Test helpers and assertion functions

public fn expect_true(condition: i32, msg: string) {
    assert(condition);
}

public fn expect_false(condition: i32, msg: string) {
    assert(condition == 0);
}

public fn expect_equal(actual: i32, expected: i32) {
    assert_eq(actual, expected);
}

public fn test_pass(name: string) {
    print("  PASS: ${name}");
}

public fn test_fail(name: string) {
    print("  FAIL: ${name}");
}

public fn test_suite_start(name: string) {
    print("=== Test Suite: ${name} ===");
}

public fn test_suite_end(passed: i32, total: i32) {
    print("Results: ${passed}/${total} passed");
}
