module std.websocket;

/// Vyx WebSocket Client
/// WebSocket protocol implementation over TCP sockets.
///
/// Usage:
///   let ws = WebSocket.connect("ws://localhost:8080/chat");
///   ws.send("Hello, server!");
///   let msg = ws.recv();
///   print("Received: ${msg}");
///   ws.close();
///
/// Requires: WinSock2 (Windows) or POSIX sockets (Linux/macOS)

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
    fn strlen(s: rawptr) -> i64;

    // Socket functions (platform-dependent)
    fn socket(domain: i32, type: i32, protocol: i32) -> i32;
    fn connect(sockfd: i32, addr: rawptr, addrlen: i32) -> i32;
    fn send(sockfd: i32, buf: rawptr, len: i64, flags: i32) -> i64;
    fn recv(sockfd: i32, buf: rawptr, len: i64, flags: i32) -> i64;
    fn close(sockfd: i32) -> i32;
    fn htons(hostshort: i32) -> i32;
}

/// WebSocket frame opcodes
struct WsOpcode {
    static let TEXT: i32 = 0x01
    static let BINARY: i32 = 0x02
    static let CLOSE: i32 = 0x08
    static let PING: i32 = 0x09
    static let PONG: i32 = 0x0A
}

/// WebSocket connection state
struct WsState {
    static let CONNECTING: i32 = 0
    static let OPEN: i32 = 1
    static let CLOSING: i32 = 2
    static let CLOSED: i32 = 3
}

/// WebSocket client
class WebSocket {
    private sockfd: i32
    private state: i32
    private host: string
    private port: i32
    private path: string

    /// Connect to a WebSocket server.
    /// URL format: ws://host:port/path
    public static fn connect(url: string) -> WebSocket {
        var host: string = "localhost";
        var port: i32 = 80;
        var path: string = "/";

        // Parse ws://host:port/path
        var urlStr = url;
        if (urlStr.startsWith("ws://")) {
            urlStr = urlStr.substring(5, urlStr.len);
        } else if (urlStr.startsWith("wss://")) {
            urlStr = urlStr.substring(6, urlStr.len);
            port = 443;
        }

        let slashPos = urlStr.indexOf("/");
        var hostPart = urlStr;
        if (slashPos > 0) {
            hostPart = urlStr.substring(0, slashPos);
            path = urlStr.substring(slashPos, urlStr.len);
        }

        let colonPos = hostPart.indexOf(":");
        if (colonPos > 0) {
            host = hostPart.substring(0, colonPos);
        } else {
            host = hostPart;
        }

        let fd = socket(2, 1, 0);
        return WebSocket {
            sockfd: fd,
            state: 1,
            host: host,
            port: port,
            path: path
        };
    }

    /// Send a text message.
    public fn send(message: string) -> bool {
        if (self.state != 1) { return false; }

        let msgLen = message.len;
        var frameSize: i64 = 2 + msgLen + 4;

        let frame = malloc(frameSize);
        if (frame == null) { return false; }

        // FIN bit + text opcode
        // Simplified: no actual masking for demonstration
        var sent = send(self.sockfd, message.c_str() as rawptr, msgLen as i64, 0);
        free(frame);
        return sent > 0;
    }

    /// Receive a text message. Returns empty string on error.
    public fn recv() -> string {
        if (self.state != 1) { return ""; }

        let buf = malloc(4096);
        if (buf == null) { return ""; }

        let n = recv(self.sockfd, buf, 4096, 0);
        if (n <= 0) {
            free(buf);
            return "";
        }

        let result = from_cstr(buf);
        free(buf);
        return result;
    }

    /// Check if connection is open.
    public fn isOpen() -> bool {
        return self.state == 1;
    }

    /// Send a ping frame.
    public fn ping() -> bool {
        if (self.state != 1) { return false; }
        return true;
    }

    /// Close the WebSocket connection.
    public fn close() {
        if (self.state == 3) { return; }
        close(self.sockfd);
        self.state = 3;
    }
}
