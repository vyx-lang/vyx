module std.ffi;

use std.collections;

/// FFI (Foreign Function Interface) Utilities
/// Helpers for C/C++ interop: type conversion, string arrays, etc.
///
/// Usage: import std::ffi;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strlen(s: rawptr) -> u64;
}

// ── C String Helpers ──────────────────────────────────────

public fn c_string(s: string) -> rawptr {
    return s.c_str();
}

public fn from_c_string(ptr: rawptr) -> string {
    if (ptr == null) { return ""; }
    return from_cstr(ptr);
}

// ── Memory Helpers ────────────────────────────────────────

public fn alloc(size: i32) -> rawptr {
    return malloc(size as u64);
}

public fn alloc_zero(size: i32) -> rawptr {
    let ptr = malloc(size as u64);
    if (ptr != null) {
        memset(ptr, 0, size as u64);
    }
    return ptr;
}

public fn dealloc(ptr: rawptr) {
    if (ptr != null) { free(ptr); }
}

public fn copy_bytes(dst: rawptr, src: rawptr, count: i32) {
    memcpy(dst, src, count as u64);
}

public fn zero_bytes(ptr: rawptr, count: i32) {
    memset(ptr, 0, count as u64);
}

// ── Pointer Arithmetic ───────────────────────────────────

public fn ptr_offset(ptr: rawptr, offset: i32) -> rawptr {
    return (ptr as i64 + offset as i64) as rawptr;
}

public fn ptr_read_i32(ptr: rawptr) -> i32 {
    var result: i32 = 0;
    memcpy(to_rawptr(&result), ptr, 4);
    return result;
}

public fn ptr_read_i64(ptr: rawptr) -> i64 {
    var result: i64 = 0;
    memcpy(to_rawptr(&result), ptr, 8);
    return result;
}

public fn ptr_read_f32(ptr: rawptr) -> f64 {
    var result: f32 = 0.0;
    memcpy(to_rawptr(&result), ptr, 4);
    return result as f64;
}

public fn ptr_read_f64(ptr: rawptr) -> f64 {
    var result: f64 = 0.0;
    memcpy(to_rawptr(&result), ptr, 8);
    return result;
}

public fn ptr_write_i32(ptr: rawptr, value: i32) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 4);
}

public fn ptr_write_i64(ptr: rawptr, value: i64) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 8);
}

// ── String Array (char**) ─────────────────────────────────

public fn make_c_string_array(strings: Vec<string>) -> rawptr {
    let count = strings.len;
    let arr = malloc((count + 1) as u64 * 8);
    for (i in 0..count) {
        let s = strings.get(i as i32);
        let cstr = s.c_str();
        var slot = ptr_offset(arr, (i * 8) as i32);
        memcpy(slot, to_rawptr(&cstr), 8);
    }
    // null-terminate the array
    var null_val: rawptr = null;
    memcpy(ptr_offset(arr, (count * 8) as i32), to_rawptr(&null_val), 8);
    return arr;
}

public fn free_c_string_array(arr: rawptr) {
    if (arr != null) { free(arr); }
}

// ── Size Constants ────────────────────────────────────────

public fn sizeof_i8() -> i32 { return 1; }
public fn sizeof_i16() -> i32 { return 2; }
public fn sizeof_i32() -> i32 { return 4; }
public fn sizeof_i64() -> i32 { return 8; }
public fn sizeof_f32() -> i32 { return 4; }
public fn sizeof_f64() -> i32 { return 8; }
public fn sizeof_ptr() -> i32 { return 8; }
