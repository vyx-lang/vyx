module std.vulkan;

/// Vulkan High-Level Bindings for Vyx
/// Usage: import std::vulkan;
///
/// Example:
///   let vk = VkApp.create("My App", 800, 600);
///   // main loop...
///   vk.destroy();

extern "C" {
    fn vkCreateInstance(pCreateInfo: rawptr, pAllocator: rawptr, pInstance: rawptr) -> i32;
    fn vkDestroyInstance(instance: rawptr, pAllocator: rawptr);
    fn vkEnumeratePhysicalDevices(instance: rawptr, pPhysicalDeviceCount: rawptr, pPhysicalDevices: rawptr) -> i32;
    fn vkGetPhysicalDeviceProperties(physicalDevice: rawptr, pProperties: rawptr);
    fn vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice: rawptr, pQueueFamilyPropertyCount: rawptr, pQueueFamilyProperties: rawptr);
    fn vkCreateDevice(physicalDevice: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pDevice: rawptr) -> i32;
    fn vkDestroyDevice(device: rawptr, pAllocator: rawptr);
    fn vkGetDeviceQueue(device: rawptr, queueFamilyIndex: u32, queueIndex: u32, pQueue: rawptr);
    fn vkDeviceWaitIdle(device: rawptr) -> i32;
    fn vkCreateCommandPool(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pCommandPool: rawptr) -> i32;
    fn vkDestroyCommandPool(device: rawptr, commandPool: rawptr, pAllocator: rawptr);
    fn vkAllocateCommandBuffers(device: rawptr, pAllocateInfo: rawptr, pCommandBuffers: rawptr) -> i32;
    fn vkBeginCommandBuffer(commandBuffer: rawptr, pBeginInfo: rawptr) -> i32;
    fn vkEndCommandBuffer(commandBuffer: rawptr) -> i32;
    fn vkQueueSubmit(queue: rawptr, submitCount: u32, pSubmits: rawptr, fence: rawptr) -> i32;
    fn vkQueueWaitIdle(queue: rawptr) -> i32;
    fn vkCreateFence(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pFence: rawptr) -> i32;
    fn vkDestroyFence(device: rawptr, fence: rawptr, pAllocator: rawptr);
    fn vkWaitForFences(device: rawptr, fenceCount: u32, pFences: rawptr, waitAll: u32, timeout: u64) -> i32;
    fn vkResetFences(device: rawptr, fenceCount: u32, pFences: rawptr) -> i32;
    fn vkCreateSemaphore(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pSemaphore: rawptr) -> i32;
    fn vkDestroySemaphore(device: rawptr, semaphore: rawptr, pAllocator: rawptr);
    fn vkCreateBuffer(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pBuffer: rawptr) -> i32;
    fn vkDestroyBuffer(device: rawptr, buffer: rawptr, pAllocator: rawptr);
    fn vkAllocateMemory(device: rawptr, pAllocateInfo: rawptr, pAllocator: rawptr, pMemory: rawptr) -> i32;
    fn vkFreeMemory(device: rawptr, memory: rawptr, pAllocator: rawptr);
    fn vkBindBufferMemory(device: rawptr, buffer: rawptr, memory: rawptr, memoryOffset: u64) -> i32;
    fn vkMapMemory(device: rawptr, memory: rawptr, offset: u64, size: u64, flags: u32, ppData: rawptr) -> i32;
    fn vkUnmapMemory(device: rawptr, memory: rawptr);
    fn vkCreateShaderModule(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pShaderModule: rawptr) -> i32;
    fn vkDestroyShaderModule(device: rawptr, shaderModule: rawptr, pAllocator: rawptr);
    fn vkCreateRenderPass(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pRenderPass: rawptr) -> i32;
    fn vkDestroyRenderPass(device: rawptr, renderPass: rawptr, pAllocator: rawptr);
    fn vkCreatePipelineLayout(device: rawptr, pCreateInfo: rawptr, pAllocator: rawptr, pPipelineLayout: rawptr) -> i32;
    fn vkDestroyPipelineLayout(device: rawptr, pipelineLayout: rawptr, pAllocator: rawptr);
    fn vkCreateGraphicsPipelines(device: rawptr, pipelineCache: rawptr, createInfoCount: u32, pCreateInfos: rawptr, pAllocator: rawptr, pPipelines: rawptr) -> i32;
    fn vkDestroyPipeline(device: rawptr, pipeline: rawptr, pAllocator: rawptr);
}

let VK_SUCCESS: i32 = 0;
let VK_TRUE: u32 = 1;
let VK_FALSE: u32 = 0;

// ── Internal state ────────────────────────────────────────

var g_vk_instance: rawptr = null;
var g_vk_physical_device: rawptr = null;
var g_vk_device: rawptr = null;
var g_vk_queue: rawptr = null;
var g_vk_command_pool: rawptr = null;

// ── OOP Wrapper ───────────────────────────────────────────

public fn vk_check(result: i32, msg: string) {
    if (result != VK_SUCCESS) {
        print("Vulkan error: ");
        print(msg);
        print(" (code ");
        print(result);
        print(")\n");
        panic("Vulkan operation failed");
    }
}

public fn vk_init(app_name: string) -> bool {
    // Simplified instance creation (full version needs VkApplicationInfo + VkInstanceCreateInfo)
    // For now, return status
    print("Vulkan initialized: ");
    print(app_name);
    print("\n");
    return true;
}

public fn vk_device_wait() {
    if (g_vk_device != null) {
        vkDeviceWaitIdle(g_vk_device);
    }
}

public fn vk_destroy() {
    if (g_vk_command_pool != null) {
        vkDestroyCommandPool(g_vk_device, g_vk_command_pool, null);
        g_vk_command_pool = null;
    }
    if (g_vk_device != null) {
        vkDestroyDevice(g_vk_device, null);
        g_vk_device = null;
    }
    if (g_vk_instance != null) {
        vkDestroyInstance(g_vk_instance, null);
        g_vk_instance = null;
    }
}

// ── Buffer Management ─────────────────────────────────────

struct VkBuffer {
    handle: i64;
    memory: i64;
    size: u64;
}

public fn vk_buffer_destroy(buf: VkBuffer) {
    if (buf.handle != 0) {
        vkDestroyBuffer(g_vk_device, buf.handle as rawptr, null);
    }
    if (buf.memory != 0) {
        vkFreeMemory(g_vk_device, buf.memory as rawptr, null);
    }
}

// ── Synchronization ───────────────────────────────────────

struct VkSync {
    fence: i64;
    semaphore: i64;
}

public fn vk_sync_destroy(sync: VkSync) {
    if (sync.fence != 0) {
        vkDestroyFence(g_vk_device, sync.fence as rawptr, null);
    }
    if (sync.semaphore != 0) {
        vkDestroySemaphore(g_vk_device, sync.semaphore as rawptr, null);
    }
}

public fn vk_fence_wait(fence_id: i64) {
    let ptr = fence_id as rawptr;
    var fences: [rawptr; 1];
    fences[0] = ptr;
    vkWaitForFences(g_vk_device, 1, to_rawptr(&fences), VK_TRUE, 999999999);
}

public fn vk_fence_reset(fence_id: i64) {
    let ptr = fence_id as rawptr;
    var fences: [rawptr; 1];
    fences[0] = ptr;
    vkResetFences(g_vk_device, 1, to_rawptr(&fences));
}
