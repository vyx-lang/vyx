module std.io;

/// std/io.vyx — I/O utilities for Vyx
/// Higher-level I/O wrappers using compiler builtins.

extern "C" {
    fn getchar() -> i32;
    fn putchar(c: i32) -> i32;
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

public fn println(msg: string) {
    print(msg);
}

/// BUG-LV-20 fix — `input()` reads one line from stdin (terminator: '\n'
/// or EOF) and returns it WITHOUT the trailing newline.  Implementation
/// uses the standard C `getchar()` so the only runtime dependency is
/// libc — no custom runtime helper is required (in contrast to the
/// historical `vyx_io_input` symbol that triggered link errors).
///
/// An optional prompt string is written byte-by-byte to stdout via
/// `putchar` first, then flushed via `fflush(NULL)` (which flushes all
/// open output streams on POSIX/Windows).  Pass `""` for no prompt.
///
/// Returns the empty string on EOF / read error so callers can handle it
/// without an Option<string> dependency.
public fn input(prompt: string) -> string {
    if (prompt.len > 0) {
        let p_bytes = prompt.c_str();
        var pi: i64 = 0;
        while (pi < prompt.len) {
            var ch: i32 = 0;
            memcpy(to_rawptr(&ch), p_bytes + pi, 1);
            putchar(ch & 255);
            pi = pi + 1;
        }
        // Note: stdout is typically line-buffered on console; explicit flush
        // removed to avoid extern symbol conflicts with std/file.vyx.
    }
    var cap: i64 = 64;
    var len: i64 = 0;
    var buf = malloc(cap + 1);
    if (buf == null) { return ""; }
    while (true) {
        let c = getchar();
        if (c < 0 || (c & 255) == 10) { break; }
        if (len + 1 >= cap) {
            cap = cap * 2;
            buf = realloc(buf, cap + 1);
            if (buf == null) { return ""; }
        }
        var byteVal: i32 = c & 255;
        memcpy(buf + len, to_rawptr(&byteVal), 1);
        len = len + 1;
    }
    var zero: i32 = 0;
    memcpy(buf + len, to_rawptr(&zero), 1);
    let s = from_cstr(buf);
    free(buf);
    return s;
}

public fn readLine() -> string {
    return input("");
}
