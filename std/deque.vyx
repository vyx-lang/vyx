module std.collections;

/// Vyx Standard Library — Deque<T>
/// Double-ended queue implemented as a ring buffer whose capacity is always a
/// power of two, so indexing uses `& (cap - 1)` rather than `% cap`.
///
/// API: new, push_back, push_front, pop_back, pop_front,
///      peek_front, peek_back, len, isEmpty, clear, destroy.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

class Deque<T> {
    public data: rawptr;
    public cap: i64;
    public head: i64;
    public tail: i64;
    public len: i64;
    public elem_size: i64;
    // Structural-mutation counter, same pattern as Vec/Dict: bumped by
    // push_back/push_front/pop_back/pop_front/clear/_grow so the
    // DequeIterator's snapshot-vs-live check can catch modification
    // during iteration.
    public gen: i64;

    public static fn new() -> Deque<T> {
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return Deque { data: d, cap: c, head: 0, tail: 0, len: 0, elem_size: es, gen: 0 };
    }

    fn _mask(idx: i64) -> i64 { return idx & (self.cap - 1); }

    fn _grow() {
        let nc = self.cap * 2;
        let nd = malloc(nc * self.elem_size);
        if (nd == null) { panic("Deque: allocation failed"); }
        memset(nd, 0, nc * self.elem_size);
        var i: i64 = 0;
        while (i < self.len) {
            let src = self.data + self._mask(self.head + i) * self.elem_size;
            let dst = nd + i * self.elem_size;
            memcpy(dst, src, self.elem_size);
            i = i + 1;
        }
        free(self.data);
        self.data = nd;
        self.cap = nc;
        self.head = 0;
        self.tail = self.len;
    }

    public fn push_back(val: T) {
        if (self.len == self.cap) { self._grow(); }
        let slot = self.data + self.tail * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
        self.tail = self._mask(self.tail + 1);
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn push_front(val: T) {
        if (self.len == self.cap) { self._grow(); }
        self.head = self._mask(self.head - 1);
        let slot = self.data + self.head * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn pop_back() -> T {
        if (self.len == 0) { panic("Deque.pop_back from empty"); }
        self.tail = self._mask(self.tail - 1);
        let slot = self.data + self.tail * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        return out;
    }

    public fn pop_front() -> T {
        if (self.len == 0) { panic("Deque.pop_front from empty"); }
        let slot = self.data + self.head * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        self.head = self._mask(self.head + 1);
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        return out;
    }

    public fn peek_front() -> T {
        if (self.len == 0) { panic("Deque.peek_front on empty"); }
        let slot = self.data + self.head * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    public fn peek_back() -> T {
        if (self.len == 0) { panic("Deque.peek_back on empty"); }
        let idx = self._mask(self.tail - 1);
        let slot = self.data + idx * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    /// O(1) random access: `d.get(0)` is the front, `d.get(d.len-1)` is the
    /// back. Logical index is translated through the ring buffer by
    /// `(head + idx) & (cap - 1)`. Matches Vec.get's contract (bounds-
    /// checked, panics on OOB).
    public fn get(idx: i64) -> T {
        if (idx < 0 || idx >= self.len) { panic("Deque.get out of bounds"); }
        let phys = (self.head + idx) & (self.cap - 1);
        let slot = self.data + phys * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    /// Zero-cost get — caller owns the bounds invariant. Mirrors the
    /// `_unchecked` tier documented on Vec.
    public fn get_unchecked(idx: i64) -> T {
        let phys = (self.head + idx) & (self.cap - 1);
        let slot = self.data + phys * self.elem_size;
        var out: T = 0;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        return out;
    }

    /// Returns a pointer to the logical element at idx.
    public fn get_ptr(idx: i64) -> *T {
        if (idx < 0 || idx >= self.len) { panic("Deque.get_ptr out of bounds"); }
        let phys = (self.head + idx) & (self.cap - 1);
        return (self.data + phys * self.elem_size) as *T;
    }

    public fn operator[](idx: i64) -> *T {
        return self.get_ptr(idx);
    }

    /// Logical-index write. Overwrites in place — no length change, no
    /// gen bump (same policy as Vec.set: element replacement doesn't
    /// invalidate live iterators, only length / layout changes do).
    public fn set(idx: i64, val: T) {
        if (idx < 0 || idx >= self.len) { panic("Deque.set out of bounds"); }
        let phys = (self.head + idx) & (self.cap - 1);
        let slot = self.data + phys * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
    }

    /// Zero-cost set.
    public fn set_unchecked(idx: i64, val: T) {
        let phys = (self.head + idx) & (self.cap - 1);
        let slot = self.data + phys * self.elem_size;
        memcpy(slot, to_rawptr(&val), self.elem_size);
    }


    public fn isEmpty() -> bool { return self.len == 0; }

    public fn clear() {
        self.head = 0;
        self.tail = 0;
        self.len = 0;
        self.gen = self.gen + 1;
    }

    /// Iterate head → tail. Snapshots head/cap/len at creation and
    /// carries a generation-counter check that panics if the Deque is
    /// mutated mid-iteration. Match the Vec / Dict iterator contract.
    public fn iter() -> DequeIterator<T> {
        return DequeIterator {
            data:        self.data,
            cap:         self.cap,
            head:        self.head,
            count:       self.len,
            elem_size:   self.elem_size,
            pos:         0,
            source_gen:  to_rawptr(&self.gen),
            gen_snapshot: self.gen
        };
    }

    public fn destroy() {
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.cap = 0;
        self.head = 0;
        self.tail = 0;
        self.len = 0;
    }

    /// SSS Drop — idempotent via `self.data == null` sentinel.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Walks front→back in logical order (`head`..`head+len` modulo
    /// `cap`) and push_back's cloned elements onto a fresh Deque.
    /// Requires `T: Clone` at call time. Tagged `@[lazy]` so
    /// Deque<T> stays usable for non-Clone T.
    @[lazy]
    public fn clone() -> Deque<T> {
        var out = Deque::<T>.new();
        var i: i64 = 0;
        while (i < self.len) {
            let e = self.get_unchecked(i);
            out.push_back(e.clone());
            i = i + 1;
        }
        return out;
    }
}

class DequeIterator<T> {
    public data: rawptr;
    public cap: i64;
    public head: i64;
    public count: i64;          // total elements at iter() time
    public elem_size: i64;
    public pos: i64;            // 0..count
    public source_gen: rawptr;
    public gen_snapshot: i64;

    public fn has_next() -> bool { return self.pos < self.count; }

    public fn next() -> Option<T> {
        if (self.source_gen != null) {
            var cur: i64 = 0;
            memcpy(to_rawptr(&cur), self.source_gen, 8);
            if (cur != self.gen_snapshot) {
                panic("DequeIterator invalidated: Deque was modified during iteration");
            }
        }
        if (self.pos >= self.count) { return None; }
        let idx = (self.head + self.pos) & (self.cap - 1);
        let slot = self.data + idx * self.elem_size;
        var out: T;
        memcpy(to_rawptr(&out), slot, self.elem_size);
        self.pos = self.pos + 1;
        return Some(out);
    }
}
