module std.time;

/// Portable time surface (POSIX + Windows). Authority copy:
/// `bootstrap_compiler/std_packages/std/src/time.vyx`.
/// Seed `bootstrap_compiler/std/time.vyx` is kept identical so
/// `--src=file` `use std.time` resolves the same module.
///
/// Windows uses QueryPerformanceCounter for the monotonic clock and
/// `Sleep`/`time` for the sleep/timestamp surfaces; POSIX keeps
/// `clock_gettime`/`gettimeofday`/`nanosleep`. Platform selection uses the
/// same `@[platform(...)]` pruning idiom as `std.sync`.
///
/// Public API is i64/void only. Struct-by-value helpers (Duration as a
/// return type) wait on the class-by-value ABI rule (WP-P0a).

extern "C" {
    fn time(t: rawptr) -> i64;
    fn clock() -> i64;
}

@[platform("windows")]
extern "C" {
    fn QueryPerformanceCounter(counter: rawptr) -> i32;
    fn QueryPerformanceFrequency(frequency: rawptr) -> i32;
    fn Sleep(milliseconds: i32);
}

@[platform("linux")]
extern "C" {
    fn clock_gettime(clk_id: i32, tp: rawptr) -> i32;
    fn gettimeofday(tv: rawptr, tz: rawptr) -> i32;
    fn nanosleep(req: rawptr, rem: rawptr) -> i32;
}

@[platform("macos")]
extern "C" {
    fn clock_gettime(clk_id: i32, tp: rawptr) -> i32;
    fn gettimeofday(tv: rawptr, tz: rawptr) -> i32;
    fn nanosleep(req: rawptr, rem: rawptr) -> i32;
}

struct Timespec {
    tv_sec: i64;
    tv_nsec: i64;
}

struct Timeval {
    tv_sec: i64;
    tv_usec: i64;
}

public let NS_PER_SEC: i64 = 1000000000;
public let NS_PER_MS: i64 = 1000000;
public let MS_PER_SEC: i64 = 1000;
public let CLOCK_REALTIME: i32 = 0;
public let CLOCK_MONOTONIC: i32 = 1;

@[platform("windows")]
public fn monotonic_nanos() -> i64 {
    var counter: i64 = 0;
    var frequency: i64 = 0;
    if (QueryPerformanceFrequency(to_rawptr(&frequency)) == 0 || frequency == 0) {
        // QPC unavailable (pre-XP or wine edge): fall back to clock().
        return clock() * NS_PER_MS;
    }
    QueryPerformanceCounter(to_rawptr(&counter));
    // Avoid overflow: counter is ticks since boot and can exceed i64 when
    // scaled by NS_PER_SEC (overflows after ~15 min uptime at 10 MHz).
    // Split into whole seconds + remainder before scaling.
    let secs = counter / frequency;
    let rem = counter % frequency;
    return secs * NS_PER_SEC + rem * NS_PER_SEC / frequency;
}

@[platform("linux")]
public fn monotonic_nanos() -> i64 {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 };
    if (clock_gettime(CLOCK_MONOTONIC, to_rawptr(&ts)) != 0) {
        return clock() * NS_PER_MS;
    }
    return ts.tv_sec * NS_PER_SEC + ts.tv_nsec;
}

@[platform("macos")]
public fn monotonic_nanos() -> i64 {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 };
    if (clock_gettime(CLOCK_MONOTONIC, to_rawptr(&ts)) != 0) {
        return clock() * NS_PER_MS;
    }
    return ts.tv_sec * NS_PER_SEC + ts.tv_nsec;
}

@[platform("windows")]
public fn current_timestamp() -> i64 {
    // Second-resolution UTC timestamp; msvcrt `time` is always available.
    return time(null);
}

@[platform("linux")]
public fn current_timestamp() -> i64 {
    var tv = Timeval { tv_sec: 0, tv_usec: 0 };
    if (gettimeofday(to_rawptr(&tv), null) != 0) {
        return time(null);
    }
    return tv.tv_sec;
}

@[platform("macos")]
public fn current_timestamp() -> i64 {
    var tv = Timeval { tv_sec: 0, tv_usec: 0 };
    if (gettimeofday(to_rawptr(&tv), null) != 0) {
        return time(null);
    }
    return tv.tv_sec;
}

public fn clock_ms() -> i64 {
    return monotonic_nanos() / NS_PER_MS;
}

public fn elapsed_seconds(start: i64, end_val: i64) -> i64 {
    return end_val - start;
}

@[platform("windows")]
public fn sleep_ms(ms: i64) {
    if (ms <= 0) { return; }
    var chunks = ms / 4294967;
    var rem = ms % 4294967;
    // Sleep takes DWORD (u32) milliseconds; chunk large sleeps.
    while (chunks > 0) {
        Sleep(4294967);
        chunks = chunks - 1;
    }
    if (rem > 0) {
        Sleep(rem as i32);
    }
}

@[platform("linux")]
public fn sleep_ms(ms: i64) {
    if (ms <= 0) { return; }
    var req = Timespec {
        tv_sec: ms / MS_PER_SEC,
        tv_nsec: (ms % MS_PER_SEC) * NS_PER_MS
    };
    nanosleep(to_rawptr(&req), null);
}

@[platform("macos")]
public fn sleep_ms(ms: i64) {
    if (ms <= 0) { return; }
    var req = Timespec {
        tv_sec: ms / MS_PER_SEC,
        tv_nsec: (ms % MS_PER_SEC) * NS_PER_MS
    };
    nanosleep(to_rawptr(&req), null);
}

public fn sleep_busy(ms: i64) {
    let start = monotonic_nanos();
    let target = ms * NS_PER_MS;
    while (monotonic_nanos() - start < target) {}
}
