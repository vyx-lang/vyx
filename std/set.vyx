module std.collections;

use std.hash;

/// Vyx Standard Library — Set
/// Provides both generic class API and legacy function API for compatibility.
///
/// Membership is content equality via the `Eq` bound (`operator_eq`),
/// mirroring Dict's key contract — so `Set<string>` deduplicates by
/// string contents, not by pointer/header bytes. Primitive impls come
/// from std/hash.vyx; user types must supply `: Eq`.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

// ---------- Generic class API ----------
@[lang_item("set")]
class Set<T> : Iterable where T: Eq {
    public data: rawptr;
    public len: i64;
    public cap: i64;
    public elem_size: i64;
    public gen: i64;

    public static fn new() -> Set<T> {
        // Slot stride == sizeof::<T>() so storage, membership compare and
        // Iterator<T>.next() (which advances by sizeof::<T>()) all agree.
        // The previous fixed 8-byte stride corrupted memory for T wider
        // than 8 bytes and mis-read elements for T narrower than 8.
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d != null) { memset(d, 0, c * es); }
        return Set { data: d, len: 0, cap: c, elem_size: es, gen: 0 };
    }

    fn ensure_capacity(min_cap: i64) {
        if (self.cap >= min_cap) { return; }
        var nc = self.cap;
        if (nc <= 0) { nc = 16; }
        while (nc < min_cap) { nc = nc * 2; }
        self.data = realloc(self.data, nc * self.elem_size);
        self.cap = nc;
    }

    public fn add(val: T) {
        if (self.contains(val)) { return; }
        self.ensure_capacity(self.len + 1);
        let es = sizeof::<T>();
        let slot = self.data + self.len * es;
        memcpy(slot, to_rawptr(&val), es);
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    /// Loads the stored element bytes into a fresh T and trait-dispatches
    /// `operator_eq` (same pattern as Dict._key_eq) so equality follows
    /// the element type's content semantics — e.g. string compares its
    /// characters, not its (ptr,len,cap) header bytes.
    public fn contains(val: T) -> bool {
        let es = sizeof::<T>();
        var i: i64 = 0;
        while (i < self.len) {
            var stored: T;
            memcpy(to_rawptr(&stored), self.data + i * es, es);
            if (stored.operator_eq(val)) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn remove(val: T) {
        let es = sizeof::<T>();
        var i: i64 = 0;
        while (i < self.len) {
            var stored: T;
            memcpy(to_rawptr(&stored), self.data + i * es, es);
            if (stored.operator_eq(val)) {
                self.len = self.len - 1;
                if (i < self.len) {
                    memcpy(self.data + i * es, self.data + self.len * es, es);
                }
                self.gen = self.gen + 1;
                return;
            }
            i = i + 1;
        }
    }

    public fn isEmpty() -> bool { return self.len == 0; }
    public fn clear() { self.len = 0; self.gen = self.gen + 1; }

    /// Iterate members in insertion order (the linear-probe storage
    /// order; stable as long as you don't call remove/clear). Same
    /// invalidation-check contract as Vec.
    public fn iter() -> Iterator<T> {
        return Iterator {
            data: self.data, len: self.len, pos: 0,
            source_gen: to_rawptr(&self.gen),
            gen_snapshot: self.gen
        };
    }

    public fn destroy() {
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }

    /// SSS Drop — idempotent via `self.data == null` sentinel.
    public fn drop() { self.destroy(); }

    /// Deep-copy the Set.  Walks each member in insertion order and
    /// re-adds its clone to a fresh Set.  Linear-probe storage means
    /// this is O(n^2) worst-case on collisions — prefer `HashSet<T>`
    /// for hot paths.  Requires `T: Clone` at call time.
    ///
    /// Implementation note: slot stride equals `sizeof::<T>()` (see
    /// `Set.new`), so `stride == ts` below; both are kept for clarity.
    ///
    /// Tagged `@[lazy]` so Set<T> remains valid for non-Clone T.
    ///
    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    @[lazy]
    public fn clone() -> Set<T> {
        var out = Set::<T>.new();
        let stride = self.elem_size;
        let ts = sizeof::<T>();
        var i: i64 = 0;
        while (i < self.len) {
            var e: T = 0;
            memcpy(to_rawptr(&e), self.data + i * stride, ts);
            out.add(e.clone());
            i = i + 1;
        }
        return out;
    }
}

// ---------- Legacy function API ----------
// ---- internal tiny vec helpers (i64) ----
public fn __vec_new() -> rawptr {
    let v = malloc(24);
    let c: i64 = 16;
    let d = malloc(c * 8);
    if (d != null) { memset(d, 0, c * 8); }
    let z: i64 = 0;
    memcpy(v, to_rawptr(&d), 8);
    memcpy(v + 8, to_rawptr(&z), 8);
    memcpy(v + 16, to_rawptr(&c), 8);
    return v;
}
public fn __vec_data(v: rawptr) -> rawptr { var d: rawptr = null; memcpy(to_rawptr(&d), v, 8); return d; }
public fn __vec_len(v: rawptr) -> i64 { var l: i64 = 0; memcpy(to_rawptr(&l), v + 8, 8); return l; }
public fn __vec_cap(v: rawptr) -> i64 { var c: i64 = 0; memcpy(to_rawptr(&c), v + 16, 8); return c; }
public fn __vec_set_len(v: rawptr, l: i64) { memcpy(v + 8, to_rawptr(&l), 8); }
public fn __vec_set_cap(v: rawptr, c: i64) { memcpy(v + 16, to_rawptr(&c), 8); }
public fn __vec_set_data(v: rawptr, d: rawptr) { memcpy(v, to_rawptr(&d), 8); }
public fn __vec_ensure(v: rawptr, min_cap: i64) {
    let c = __vec_cap(v);
    if (c >= min_cap) { return; }
    var nc = c;
    while (nc < min_cap) { nc = nc * 2; }
    let nd = realloc(__vec_data(v), nc * 8);
    __vec_set_data(v, nd);
    __vec_set_cap(v, nc);
}
public fn __vec_push(v: rawptr, x: i64) {
    let l = __vec_len(v);
    __vec_ensure(v, l + 1);
    let slot = __vec_data(v) + l * 8;
    memcpy(slot, to_rawptr(&x), 8);
    __vec_set_len(v, l + 1);
}
public fn __vec_get(v: rawptr, i: i64) -> i64 {
    let slot = __vec_data(v) + i * 8;
    var out: i64 = 0;
    memcpy(to_rawptr(&out), slot, 8);
    return out;
}
public fn __vec_set(v: rawptr, i: i64, x: i64) {
    let slot = __vec_data(v) + i * 8;
    memcpy(slot, to_rawptr(&x), 8);
}
public fn __vec_pop(v: rawptr) -> i64 {
    let l = __vec_len(v) - 1;
    __vec_set_len(v, l);
    return __vec_get(v, l);
}
public fn __vec_last(v: rawptr) -> i64 { return __vec_get(v, __vec_len(v) - 1); }
public fn __vec_clear(v: rawptr) { let z: i64 = 0; __vec_set_len(v, z); }
public fn __vec_free(v: rawptr) { let d = __vec_data(v); if (d != null) { free(d); } free(v); }

// Set header: items vec ptr (8)
public fn set_new() -> rawptr {
    let s = malloc(8);
    let v = __vec_new();
    memcpy(s, to_rawptr(&v), 8);
    return s;
}
fn set_items(s: rawptr) -> rawptr { var v: rawptr = null; memcpy(to_rawptr(&v), s, 8); return v; }

public fn set_add(s: rawptr, val: i64) {
    if (!set_contains(s, val)) {
        __vec_push(set_items(s), val);
    }
}

public fn set_contains(s: rawptr, val: i64) -> bool {
    let v = set_items(s);
    var i: i64 = 0;
    let l = __vec_len(v);
    while (i < l) {
        if (__vec_get(v, i) == val) { return true; }
        i = i + 1;
    }
    return false;
}

public fn set_remove(s: rawptr, val: i64) {
    let v = set_items(s);
    var i: i64 = 0;
    let l = __vec_len(v);
    while (i < l) {
        if (__vec_get(v, i) == val) {
            let last = __vec_pop(v);
            let nl = __vec_len(v);
            if (i < nl) { __vec_set(v, i, last); }
            return;
        }
        i = i + 1;
    }
}

public fn set_len(s: rawptr) -> i64 { return __vec_len(set_items(s)); }
public fn set_is_empty(s: rawptr) -> bool { return set_len(s) == 0; }
public fn set_clear(s: rawptr) { __vec_clear(set_items(s)); }
public fn set_free(s: rawptr) { __vec_free(set_items(s)); free(s); }
