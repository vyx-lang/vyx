module std.threading;

/// Vyx Standard Library — Threading (cross-platform)
///
/// Thread function signature (Vyx): fn(rawptr) -> i64
/// On Windows we use CreateThread; on POSIX we use pthread_create.
///
/// Usage:
///   let h = thread_spawn(my_fn_ptr, param_ptr);
///   thread_join(h);
///   thread_detach(h);

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

@[platform("windows")]
extern "C" {
    fn CreateThread(attrs: rawptr, stack: u64, fn_ptr: rawptr, param: rawptr, flags: u32, tid: rawptr) -> rawptr;
    fn WaitForSingleObject(handle: rawptr, ms: u32) -> u32;
    fn CloseHandle(handle: rawptr) -> i32;
    fn GetCurrentThreadId() -> u32;
    fn Sleep(ms: u32);
}

@[platform("linux")]
extern "C" {
    fn pthread_create(thread: rawptr, attr: rawptr, start: rawptr, arg: rawptr) -> i32;
    fn pthread_join(thread: i64, retval: rawptr) -> i32;
    fn pthread_detach(thread: i64) -> i32;
    fn pthread_self() -> i64;
    fn usleep(usec: i32) -> i32;
}

@[platform("macos")]
extern "C" {
    fn pthread_create(thread: rawptr, attr: rawptr, start: rawptr, arg: rawptr) -> i32;
    fn pthread_join(thread: i64, retval: rawptr) -> i32;
    fn pthread_detach(thread: i64) -> i32;
    fn pthread_self() -> i64;
    fn usleep(usec: i32) -> i32;
}

let THREAD_WAIT_INFINITE: u32 = 4294967295;   // 0xFFFFFFFF
let THREAD_HANDLE_BYTES: i64 = 16;

/// Spawn a new OS thread running `fn_ptr(param)`.
@[platform("windows")]
public fn thread_spawn(fn_ptr: rawptr, param: rawptr) -> rawptr {
    return CreateThread(null, 0, fn_ptr, param, 0, null);
}

@[platform("linux")]
public fn thread_spawn(fn_ptr: rawptr, param: rawptr) -> rawptr {
    let h = malloc(THREAD_HANDLE_BYTES);
    if (h == null) { return null; }
    memset(h, 0, THREAD_HANDLE_BYTES);
    if (pthread_create(h, null, fn_ptr, param) != 0) {
        free(h);
        return null;
    }
    return h;
}

@[platform("macos")]
public fn thread_spawn(fn_ptr: rawptr, param: rawptr) -> rawptr {
    let h = malloc(THREAD_HANDLE_BYTES);
    if (h == null) { return null; }
    memset(h, 0, THREAD_HANDLE_BYTES);
    if (pthread_create(h, null, fn_ptr, param) != 0) {
        free(h);
        return null;
    }
    return h;
}

/// Block until the thread finishes, then close its handle.
@[platform("windows")]
public fn thread_join(handle: rawptr) {
    if (handle == null) { return; }
    WaitForSingleObject(handle, THREAD_WAIT_INFINITE);
    CloseHandle(handle);
}

@[platform("linux")]
public fn thread_join(handle: rawptr) {
    if (handle == null) { return; }
    var tid: i64 = 0;
    memcpy(to_rawptr(&tid), handle, 8);
    pthread_join(tid, null);
    free(handle);
}

@[platform("macos")]
public fn thread_join(handle: rawptr) {
    if (handle == null) { return; }
    var tid: i64 = 0;
    memcpy(to_rawptr(&tid), handle, 8);
    pthread_join(tid, null);
    free(handle);
}

/// Close the handle without waiting (fire-and-forget).
@[platform("windows")]
public fn thread_detach(handle: rawptr) {
    if (handle == null) { return; }
    CloseHandle(handle);
}

@[platform("linux")]
public fn thread_detach(handle: rawptr) {
    if (handle == null) { return; }
    var tid: i64 = 0;
    memcpy(to_rawptr(&tid), handle, 8);
    pthread_detach(tid);
    free(handle);
}

@[platform("macos")]
public fn thread_detach(handle: rawptr) {
    if (handle == null) { return; }
    var tid: i64 = 0;
    memcpy(to_rawptr(&tid), handle, 8);
    pthread_detach(tid);
    free(handle);
}

/// Join N threads whose handles are stored as a contiguous array of rawptrs.
/// `handles` points to `count` consecutive rawptr values.
public fn thread_join_all(handles: rawptr, count: i64) {
    var i: i64 = 0;
    while (i < count) {
        var h: rawptr = null;
        unsafe { memcpy(to_rawptr(&h), handles + i * 8, 8); }
        thread_join(h);
        i = i + 1;
    }
}

/// Return the calling thread's OS ID.
@[platform("windows")]
public fn thread_id() -> i64 {
    return GetCurrentThreadId() as i64;
}

@[platform("linux")]
public fn thread_id() -> i64 {
    return pthread_self();
}

@[platform("macos")]
public fn thread_id() -> i64 {
    return pthread_self();
}

/// Sleep the calling thread for `ms` milliseconds.
@[platform("windows")]
public fn thread_sleep_ms(ms: i64) {
    Sleep(ms as u32);
}

@[platform("linux")]
public fn thread_sleep_ms(ms: i64) {
    usleep((ms * 1000) as i32);
}

@[platform("macos")]
public fn thread_sleep_ms(ms: i64) {
    usleep((ms * 1000) as i32);
}
