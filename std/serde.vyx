module std.serde;

use std.collections;

/// std/serde.vyx — Serialization/Deserialization framework
///
/// Provides traits for converting between Vyx types and common formats.

public trait Serialize {
    fn serialize() -> string;
}

// `Deserialize` trait elided — `Self` as a return type is not yet
// representable in Vyx traits. Use an explicit concrete-type `from_json`
// method on each class instead.

public trait SerializeTo {
    fn serialize_json() -> string;
    fn serialize_toml() -> string;
}

public class JsonSerializer {
    fn encode_string(s: string) -> string {
        var result = "\"";
        for (i in 0..s.len) {
            let c = s[i..i + 1];
            if (c == "\"") { result = result + "\\\""; }
            else if (c == "\\") { result = result + "\\\\"; }
            else if (c == "\n") { result = result + "\\n"; }
            else if (c == "\t") { result = result + "\\t"; }
            else if (c == "\r") { result = result + "\\r"; }
            else { result = result + c; }
        }
        result = result + "\"";
        return result;
    }

    fn encode_int(v: i64) -> string {
        return v.toString();
    }

    fn encode_float(v: f64) -> string {
        return v.toString();
    }

    fn encode_bool(v: bool) -> string {
        if (v) { return "true"; }
        return "false";
    }

    fn encode_null() -> string {
        return "null";
    }

    fn encode_array(items: Vec<string>) -> string {
        var result = "[";
        for (i in 0..items.len) {
            if (i > 0) { result += ","; }
            result += items.get(i);
        }
        result += "]";
        return result;
    }

    fn encode_object(keys: Vec<string>, values: Vec<string>) -> string {
        var result = "{";
        for (i in 0..keys.len) {
            if (i > 0) { result += ","; }
            result += "\"" + keys.get(i) + "\":" + values.get(i);
        }
        result += "}";
        return result;
    }
}

public class JsonDeserializer {
    input: string
    pos: i64

    public static fn init(data: string) -> JsonDeserializer {
        return JsonDeserializer { input: data, pos: 0 };
    }

    fn skip_whitespace() {
        while (self.pos < self.input.len) {
            let c = self.input[self.pos..self.pos + 1];
            if (c != " " && c != "\n" && c != "\t" && c != "\r") { return; }
            self.pos = self.pos + 1;
        }
    }

    fn read_string() -> string {
        self.skip_whitespace();
        self.pos = self.pos + 1;
        var result = "";
        while (self.pos < self.input.len) {
            let c = self.input[self.pos..self.pos + 1];
            if (c == "\"") { self.pos = self.pos + 1; return result; }
            if (c == "\\" && self.pos + 1 < self.input.len) {
                let next = self.input[self.pos + 1..self.pos + 2];
                if (next == "\"") { result += "\""; self.pos = self.pos + 2; }
                else if (next == "\\") { result += "\\"; self.pos = self.pos + 2; }
                else if (next == "n") { result += "\n"; self.pos = self.pos + 2; }
                else if (next == "t") { result += "\t"; self.pos = self.pos + 2; }
                else if (next == "r") { result += "\r"; self.pos = self.pos + 2; }
                else { result += c; self.pos = self.pos + 1; }
            } else {
                result += c;
                self.pos = self.pos + 1;
            }
        }
        return result;
    }

    fn read_number() -> i64 {
        self.skip_whitespace();
        var result = 0;
        var sign = 1;
        if (self.input[self.pos..self.pos + 1] == "-") {
            sign = -1;
            self.pos = self.pos + 1;
        }
        while (self.pos < self.input.len) {
            let c = self.input[self.pos..self.pos + 1];
            if (c < "0" || c > "9") { return result * sign; }
            result = result * 10 + (c.indexOf("0"));
            self.pos = self.pos + 1;
        }
        return result * sign;
    }
}

/// @[derive(Serialize)] generates serialize() for structs
/// @[derive(Deserialize)] generates deserialize() for structs
