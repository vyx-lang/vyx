module std.concurrent;

use std.core;
use std.sync;

/// std/concurrent.vyx — thread-safe container wrappers
///
/// Minimal-surface concurrent versions of Vec and Dict that guard
/// every access with an internal CRITICAL_SECTION (via std.sync.Mutex).
/// These are coarse — every op acquires the same lock — but they close
/// the race-condition gap and give you a correct starting point.
///
/// Performance hint: one lock per container is fine for workloads where
/// threads don't contend heavily. For hot paths, shard or upgrade to
/// rwlocks once those primitives exist in std.sync.
///
/// Construction:
///   let cv = ConcurrentVec::<i64>.new();
///   let cd = ConcurrentDict::<string, i64>.new();
///
/// Destruction: call `.destroy()` once after all worker threads have
/// joined. Do NOT destroy while another thread might still touch it.


// ── ConcurrentVec<T> ──────────────────────────────────────────────────────────

class ConcurrentVec<T> {
    public inner: Vec<T>;
    public lock_h: rawptr;   // CRITICAL_SECTION from mutex_new()

    public static fn new() -> ConcurrentVec<T> {
        return ConcurrentVec {
            inner:  Vec::<T>.new(),
            lock_h: mutex_new()
        };
    }

    public static fn with_capacity(cap: i64) -> ConcurrentVec<T> {
        return ConcurrentVec {
            inner:  Vec::<T>.with_capacity(cap),
            lock_h: mutex_new()
        };
    }

    public fn push(val: T) {
        mutex_lock(self.lock_h);
        self.inner.push(val);
        mutex_unlock(self.lock_h);
    }

    public fn pop() -> T {
        mutex_lock(self.lock_h);
        let v = self.inner.pop();
        mutex_unlock(self.lock_h);
        return v;
    }

    public fn get(idx: i64) -> T {
        mutex_lock(self.lock_h);
        let v = self.inner.get(idx);
        mutex_unlock(self.lock_h);
        return v;
    }

    public fn operator[](idx: i64) -> T {
        return self.get(idx);
    }

    public fn set(idx: i64, val: T) {
        mutex_lock(self.lock_h);
        self.inner.set(idx, val);
        mutex_unlock(self.lock_h);
    }

    public fn len() -> i64 {
        mutex_lock(self.lock_h);
        let n = self.inner.len;
        mutex_unlock(self.lock_h);
        return n;
    }

    public fn isEmpty() -> bool {
        return self.len() == 0;
    }

    public fn clear() {
        mutex_lock(self.lock_h);
        self.inner.clear();
        mutex_unlock(self.lock_h);
    }

    public fn contains(val: T) -> bool {
        mutex_lock(self.lock_h);
        let r = self.inner.contains(val);
        mutex_unlock(self.lock_h);
        return r;
    }

    public fn destroy() {
        if (self.lock_h == null) { return; }
        mutex_lock(self.lock_h);
        self.inner.destroy();
        mutex_unlock(self.lock_h);
        mutex_destroy(self.lock_h);
        self.lock_h = null;
    }

    /// SSS Drop — idempotent via `self.lock_h == null` sentinel.
    public fn drop() { self.destroy(); }
}


// ── ConcurrentDict<K, V> ──────────────────────────────────────────────────────

class ConcurrentDict<K, V> {
    public inner: Dict<K, V>;
    public lock_h: rawptr;

    public static fn new() -> ConcurrentDict<K, V> {
        return ConcurrentDict {
            inner:  Dict::<K, V>.new(),
            lock_h: mutex_new()
        };
    }

    public static fn with_capacity(cap: i64) -> ConcurrentDict<K, V> {
        return ConcurrentDict {
            inner:  Dict::<K, V>.with_capacity(cap),
            lock_h: mutex_new()
        };
    }

    public fn put(key: K, val: V) {
        mutex_lock(self.lock_h);
        self.inner.put(key, val);
        mutex_unlock(self.lock_h);
    }

    public fn get(key: K) -> V {
        mutex_lock(self.lock_h);
        let v = self.inner.get(key);
        mutex_unlock(self.lock_h);
        return v;
    }

    public fn operator[](key: K) -> V {
        return self.get(key);
    }

    public fn try_get(key: K) -> Option<V> {
        mutex_lock(self.lock_h);
        let o = self.inner.try_get(key);
        mutex_unlock(self.lock_h);
        return o;
    }

    public fn contains(key: K) -> bool {
        mutex_lock(self.lock_h);
        let r = self.inner.contains(key);
        mutex_unlock(self.lock_h);
        return r;
    }

    public fn remove(key: K) -> bool {
        mutex_lock(self.lock_h);
        let r = self.inner.remove(key);
        mutex_unlock(self.lock_h);
        return r;
    }

    public fn len() -> i64 {
        mutex_lock(self.lock_h);
        let n = self.inner.len;
        mutex_unlock(self.lock_h);
        return n;
    }

    public fn isEmpty() -> bool {
        return self.len() == 0;
    }

    public fn clear() {
        mutex_lock(self.lock_h);
        self.inner.clear();
        mutex_unlock(self.lock_h);
    }

    public fn destroy() {
        if (self.lock_h == null) { return; }
        mutex_lock(self.lock_h);
        self.inner.destroy();
        mutex_unlock(self.lock_h);
        mutex_destroy(self.lock_h);
        self.lock_h = null;
    }

    /// SSS Drop — idempotent via `self.lock_h == null` sentinel.
    public fn drop() { self.destroy(); }
}
