module std.collections;

use std.core;
use std.hash;

/// Vyx Standard Library — Ordered associative containers.
///
/// Implementation note (MVP, 2026-04-23):
/// This file does NOT contain a real B-Tree. The name "BTreeMap/BTreeSet"
/// follows the Rust stdlib convention for the ordered-map type, but the
/// backing store is a pair of sorted `Vec`s. Operations:
///
///   * `get` / `contains` — O(log n) binary search.
///   * `put` / `remove`   — O(log n) search + O(n) shift (Vec.insert / remove).
///   * `first_key` / `last_key` / `min` / `max` — O(1).
///   * Iteration — O(n), in sorted order (a free bonus over HashMap).
///
/// This is deliberate. A self-balancing BST (AVL / red-black) would give
/// O(log n) across the board but roughly triples the code. For the sizes
/// Vyx users hit in practice (< ~10k entries) sorted-vec wins on cache
/// friendliness and code simplicity. Treat this class as a placeholder
/// API — a future version may swap the internals to a real B-Tree
/// without changing the public surface.
///
/// Trait bounds:
///   * `K: Ord` — keys compared via `k1.compare(k2)` (-1/0/1) to keep
///                the sorted invariant and drive binary search.
///   * `K: Eq`  — membership tests match by value, not by pointer.
///
/// Usage:
///   use std.collections;
///
///   var m = BTreeMap::<i32, string>.new();
///   m.put(3, "three"); m.put(1, "one"); m.put(2, "two");
///   match (m.first_key()) { case Some(k) => { /* k == 1 */ } case None => {} }
///   match (m.get(2))      { case Some(v) => { /* v == "two" */ } case None => {} }

// ============================================================
// BTreeMap<K, V>
// ============================================================

class BTreeMap<K, V> where K: Ord + Eq {
    public keys: Vec<K>;
    public vals: Vec<V>;

    public static fn new() -> BTreeMap<K, V> {
        return BTreeMap { keys: Vec::<K>.new(), vals: Vec::<V>.new() };
    }

    public static fn with_capacity(min_cap: i64) -> BTreeMap<K, V> {
        return BTreeMap {
            keys: Vec::<K>.with_capacity(min_cap),
            vals: Vec::<V>.with_capacity(min_cap)
        };
    }

    /// Returns the index where `key` is (or would be inserted) to keep
    /// the vector sorted. Caller disambiguates hit vs miss via `_eq_at`.
    fn _bsearch(key: K) -> i64 {
        var lo: i64 = 0;
        var hi: i64 = self.keys.size();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            let k = self.keys.get(mid);
            let cmp = k.compare(key);
            if (cmp == 0) { return mid; }
            if (cmp < 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    /// True when slot `idx` is in-range and holds a key equal to `key`
    /// under the `Eq` bound. Ord.compare=0 already implies equality
    /// for primitives, but user types may define compare and Eq
    /// independently; checking Eq keeps the contract clean.
    fn _eq_at(idx: i64, key: K) -> bool {
        if (idx < 0) { return false; }
        if (idx >= self.keys.size()) { return false; }
        let k = self.keys.get(idx);
        return k.operator_eq(key);
    }

    public fn put(key: K, value: V) {
        let idx = self._bsearch(key);
        if (self._eq_at(idx, key)) {
            // Key present — overwrite value, keys unchanged.
            self.vals.set(idx, value);
            return;
        }
        self.keys.insert(idx, key);
        self.vals.insert(idx, value);
    }

    public fn get(key: K) -> Option<V> {
        let idx = self._bsearch(key);
        if (self._eq_at(idx, key)) {
            return Some(self.vals.get(idx));
        }
        return None;
    }

    public fn get_ptr(key: K) -> *V {
        let idx = self._bsearch(key);
        if (!self._eq_at(idx, key)) { panic("BTreeMap.get_ptr missing key"); }
        return self.vals.get_ptr(idx);
    }

    public fn operator[](key: K) -> *V {
        let idx = self._bsearch(key);
        if (self._eq_at(idx, key)) {
            return self.vals.get_ptr(idx);
        }
        var zero: V = 0;
        self.keys.insert(idx, key);
        self.vals.insert(idx, zero);
        return self.vals.get_ptr(idx);
    }

    public fn contains(key: K) -> bool {
        let idx = self._bsearch(key);
        return self._eq_at(idx, key);
    }

    public fn contains_key(key: K) -> bool { return self.contains(key); }

    /// Returns true when an entry was removed, false when `key` was absent.
    public fn remove(key: K) -> bool {
        let idx = self._bsearch(key);
        if (!self._eq_at(idx, key)) { return false; }
        self.keys.removeAt(idx);
        self.vals.removeAt(idx);
        return true;
    }

    public fn size() -> i64 { return self.keys.size(); }
    public fn len() -> i64  { return self.keys.size(); }
    public fn isEmpty() -> bool { return self.keys.size() == 0; }

    public fn clear() { self.keys.clear(); self.vals.clear(); }

    public fn destroy() { self.keys.destroy(); self.vals.destroy(); }
    /// SSS Drop — both Vec fields are idempotent.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Delegates to the two wrapped Vecs' `clone()` so both the key
    /// and value backing storage are freshly allocated. Requires
    /// `K: Clone` AND `V: Clone` at call time. Tagged `@[lazy]` so
    /// non-Clone key/value types keep BTreeMap<K, V> usable as long
    /// as `.clone()` is never called.
    @[lazy]
    public fn clone() -> BTreeMap<K, V> {
        return BTreeMap { keys: self.keys.clone(), vals: self.vals.clone() };
    }

    /// Smallest key (first in sorted order). O(1).
    public fn first_key() -> Option<K> {
        if (self.keys.size() == 0) { return None; }
        return Some(self.keys.get(0));
    }

    /// Largest key (last in sorted order). O(1).
    public fn last_key() -> Option<K> {
        let n = self.keys.size();
        if (n == 0) { return None; }
        return Some(self.keys.get(n - 1));
    }

    /// Iterate keys in sorted order. Same invalidation contract as Vec.iter.
    public fn keys_iter() -> Iterator<K> { return self.keys.iter(); }

    /// Iterate values in key-sorted order.
    public fn values_iter() -> Iterator<V> { return self.vals.iter(); }
}

// ============================================================
// BTreeSet<T>
// ============================================================

class BTreeSet<T> where T: Ord + Eq {
    public items: Vec<T>;

    public static fn new() -> BTreeSet<T> {
        return BTreeSet { items: Vec::<T>.new() };
    }

    public static fn with_capacity(min_cap: i64) -> BTreeSet<T> {
        return BTreeSet { items: Vec::<T>.with_capacity(min_cap) };
    }

    fn _bsearch(value: T) -> i64 {
        var lo: i64 = 0;
        var hi: i64 = self.items.size();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            let k = self.items.get(mid);
            let cmp = k.compare(value);
            if (cmp == 0) { return mid; }
            if (cmp < 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    fn _eq_at(idx: i64, value: T) -> bool {
        if (idx < 0) { return false; }
        if (idx >= self.items.size()) { return false; }
        let k = self.items.get(idx);
        return k.operator_eq(value);
    }

    /// Returns true when a new element was inserted, false when already present.
    public fn insert(value: T) -> bool {
        let idx = self._bsearch(value);
        if (self._eq_at(idx, value)) { return false; }
        self.items.insert(idx, value);
        return true;
    }

    /// Alias matching Set<T>.add / HashSet<T>.add.
    public fn add(value: T) -> bool { return self.insert(value); }

    public fn contains(value: T) -> bool {
        let idx = self._bsearch(value);
        return self._eq_at(idx, value);
    }

    public fn remove(value: T) -> bool {
        let idx = self._bsearch(value);
        if (!self._eq_at(idx, value)) { return false; }
        self.items.removeAt(idx);
        return true;
    }

    public fn size() -> i64 { return self.items.size(); }
    public fn len() -> i64  { return self.items.size(); }
    public fn isEmpty() -> bool { return self.items.size() == 0; }

    public fn clear() { self.items.clear(); }
    public fn destroy() { self.items.destroy(); }
    /// SSS Drop — Vec is idempotent.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Delegates to the wrapped Vec's `clone()` so the backing
    /// storage is freshly allocated. Requires `T: Clone` at call
    /// time. Tagged `@[lazy]`.
    @[lazy]
    public fn clone() -> BTreeSet<T> {
        return BTreeSet { items: self.items.clone() };
    }

    /// Smallest value. O(1).
    public fn min() -> Option<T> {
        if (self.items.size() == 0) { return None; }
        return Some(self.items.get(0));
    }

    /// Largest value. O(1).
    public fn max() -> Option<T> {
        let n = self.items.size();
        if (n == 0) { return None; }
        return Some(self.items.get(n - 1));
    }

    /// Iterate in sorted order. Same invalidation contract as Vec.iter.
    public fn iter() -> Iterator<T> { return self.items.iter(); }
}
