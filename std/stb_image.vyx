module std.image;

/// STB Image — Safe OOP Image Binding for Vyx
/// Usage: import std::stb_image;
///
/// Example:
///   let img = Image.load("photo.png");
///   if (img.valid) {
///       print(img.width);
///       print(img.height);
///       img.savePng("copy.png");
///       img.free();
///   }
///
/// Requires: stb_image.h + stb_image_write.h compiled as C
///   Compile with sources = "vendor/stb_impl.c" in Vyx.toml

extern "C" {
    fn stbi_load(filename: rawptr, x: rawptr, y: rawptr, channels_in_file: rawptr, desired_channels: i32) -> rawptr;
    fn stbi_load_from_memory(buffer: rawptr, len: i32, x: rawptr, y: rawptr, channels_in_file: rawptr, desired_channels: i32) -> rawptr;
    fn stbi_image_free(retval_from_stbi_load: rawptr);
    fn stbi_failure_reason() -> rawptr;
    fn stbi_info(filename: rawptr, x: rawptr, y: rawptr, comp: rawptr) -> i32;
    fn stbi_set_flip_vertically_on_load(flag_true_if_should_flip: i32);
    fn stbi_is_hdr(filename: rawptr) -> i32;
    fn stbi_loadf(filename: rawptr, x: rawptr, y: rawptr, channels_in_file: rawptr, desired_channels: i32) -> rawptr;
    fn stbi_write_png(filename: rawptr, w: i32, h: i32, comp: i32, data: rawptr, stride_in_bytes: i32) -> i32;
    fn stbi_write_bmp(filename: rawptr, w: i32, h: i32, comp: i32, data: rawptr) -> i32;
    fn stbi_write_jpg(filename: rawptr, w: i32, h: i32, comp: i32, data: rawptr, quality: i32) -> i32;
    fn stbi_write_tga(filename: rawptr, w: i32, h: i32, comp: i32, data: rawptr) -> i32;
}

// ── Image Class ─────────────────────────────────────────────

class Image {
    width: i32
    height: i32
    channels: i32
    data_ptr: i64
    valid: bool

    static fn load(path: string) -> Image {
        var w: i32 = 0;
        var h: i32 = 0;
        var ch: i32 = 0;
        let data = stbi_load(path.c_str(), to_rawptr(&w), to_rawptr(&h), to_rawptr(&ch), 0);
        if (data == null) {
            return Image { width: 0, height: 0, channels: 0, data_ptr: 0, valid: false };
        }
        return Image { width: w, height: h, channels: ch, data_ptr: data as i64, valid: true };
    }

    static fn loadRgba(path: string) -> Image {
        var w: i32 = 0;
        var h: i32 = 0;
        var ch: i32 = 0;
        let data = stbi_load(path.c_str(), to_rawptr(&w), to_rawptr(&h), to_rawptr(&ch), 4);
        if (data == null) {
            return Image { width: 0, height: 0, channels: 4, data_ptr: 0, valid: false };
        }
        return Image { width: w, height: h, channels: 4, data_ptr: data as i64, valid: true };
    }

    static fn loadRgb(path: string) -> Image {
        var w: i32 = 0;
        var h: i32 = 0;
        var ch: i32 = 0;
        let data = stbi_load(path.c_str(), to_rawptr(&w), to_rawptr(&h), to_rawptr(&ch), 3);
        if (data == null) {
            return Image { width: 0, height: 0, channels: 3, data_ptr: 0, valid: false };
        }
        return Image { width: w, height: h, channels: 3, data_ptr: data as i64, valid: true };
    }

    static fn loadGray(path: string) -> Image {
        var w: i32 = 0;
        var h: i32 = 0;
        var ch: i32 = 0;
        let data = stbi_load(path.c_str(), to_rawptr(&w), to_rawptr(&h), to_rawptr(&ch), 1);
        if (data == null) {
            return Image { width: 0, height: 0, channels: 1, data_ptr: 0, valid: false };
        }
        return Image { width: w, height: h, channels: 1, data_ptr: data as i64, valid: true };
    }

    static fn info(path: string) -> Image {
        var w: i32 = 0;
        var h: i32 = 0;
        var ch: i32 = 0;
        let ok = stbi_info(path.c_str(), to_rawptr(&w), to_rawptr(&h), to_rawptr(&ch));
        return Image { width: w, height: h, channels: ch, data_ptr: 0, valid: ok != 0 };
    }

    static fn isHdr(path: string) -> bool {
        return stbi_is_hdr(path.c_str()) != 0;
    }

    static fn flipVertical(flip: bool) {
        stbi_set_flip_vertically_on_load(flip ? 1 : 0);
    }

    static fn lastError() -> string {
        let reason = stbi_failure_reason();
        if (reason == null) { return ""; }
        return from_cstr(reason);
    }

    // ── Instance Methods ─────────────────────────────────

    fn free() {
        if (self.data_ptr != 0) {
            stbi_image_free(self.data_ptr as rawptr);
            self.data_ptr = 0;
            self.valid = false;
        }
    }

    fn pixelCount() -> i32 {
        return self.width * self.height;
    }

    fn dataSize() -> i32 {
        return self.width * self.height * self.channels;
    }

    fn stride() -> i32 {
        return self.width * self.channels;
    }

    // ── Saving ───────────────────────────────────────────

    fn savePng(path: string) -> bool {
        return stbi_write_png(path.c_str(), self.width, self.height,
            self.channels, self.data_ptr as rawptr, self.stride()) != 0;
    }

    fn saveBmp(path: string) -> bool {
        return stbi_write_bmp(path.c_str(), self.width, self.height,
            self.channels, self.data_ptr as rawptr) != 0;
    }

    fn saveJpg(path: string, quality: i32) -> bool {
        return stbi_write_jpg(path.c_str(), self.width, self.height,
            self.channels, self.data_ptr as rawptr, quality) != 0;
    }

    fn saveTga(path: string) -> bool {
        return stbi_write_tga(path.c_str(), self.width, self.height,
            self.channels, self.data_ptr as rawptr) != 0;
    }
}
