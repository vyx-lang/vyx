module std.url;

use std.collections;

/// URL — URL Encoding/Decoding & Parsing for Vyx
/// Usage: import std::url;
///
/// Example:
///   let encoded = url_encode("hello world&foo=bar");
///   print(encoded);  // "hello%20world%26foo%3Dbar"
///   let decoded = url_decode(encoded);
///   print(decoded);  // "hello world&foo=bar"
///
///   let u = Url.parse("https://example.com:8080/path?q=1#frag");
///   print(u.scheme);  // "https"
///   print(u.host);    // "example.com"

fn is_unreserved(ch: i32) -> bool {
    if (ch >= 65 && ch <= 90)  { return true; }
    if (ch >= 97 && ch <= 122) { return true; }
    if (ch >= 48 && ch <= 57)  { return true; }
    if (ch == 45 || ch == 95 || ch == 46 || ch == 126) { return true; }
    return false;
}

fn hex_ch(v: i32) -> string {
    let table = "0123456789ABCDEF";
    return table.substring(v & 15, (v & 15) + 1);
}

fn from_hex_ch(c: i32) -> i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return -1;
}

public fn url_encode(input: string) -> string {
    var result = "";
    var i = 0;
    while (i < input.len) {
        let ch = input.charAt(i);
        if (is_unreserved(ch)) {
            result = result + format("%c", ch);
        } elif (ch == 32) {
            result = result + "%20";
        } else {
            result = result + "%" + hex_ch((ch >> 4) & 15) + hex_ch(ch & 15);
        }
        i = i + 1;
    }
    return result;
}

public fn url_decode(input: string) -> string {
    var result = "";
    var i = 0;
    while (i < input.len) {
        let ch = input.charAt(i);
        if (ch == 37 && i + 2 < input.len) {
            let hi = from_hex_ch(input.charAt(i + 1));
            let lo = from_hex_ch(input.charAt(i + 2));
            if (hi >= 0 && lo >= 0) {
                result = result + format("%c", (hi << 4) | lo);
                i = i + 3;
                continue;
            }
        } elif (ch == 43) {
            result = result + " ";
            i = i + 1;
            continue;
        }
        result = result + format("%c", ch);
        i = i + 1;
    }
    return result;
}

class Url {
    scheme: string
    host: string
    port: string
    path: string
    query: string
    fragment: string

    static fn parse(raw: string) -> Url {
        var s = raw;
        var scheme = "";
        var host = "";
        var port = "";
        var path = "";
        var query = "";
        var fragment = "";

        let frag_idx = s.indexOf("#");
        if (frag_idx >= 0) {
            fragment = s.substring(frag_idx + 1, s.len);
            s = s.substring(0, frag_idx);
        }

        let q_idx = s.indexOf("?");
        if (q_idx >= 0) {
            query = s.substring(q_idx + 1, s.len);
            s = s.substring(0, q_idx);
        }

        let scheme_idx = s.indexOf("://");
        if (scheme_idx >= 0) {
            scheme = s.substring(0, scheme_idx);
            s = s.substring(scheme_idx + 3, s.len);
        }

        let path_idx = s.indexOf("/");
        if (path_idx >= 0) {
            path = s.substring(path_idx, s.len);
            s = s.substring(0, path_idx);
        } else {
            path = "/";
        }

        let port_idx = s.indexOf(":");
        if (port_idx >= 0) {
            port = s.substring(port_idx + 1, s.len);
            host = s.substring(0, port_idx);
        } else {
            host = s;
        }

        return Url { scheme: scheme, host: host, port: port, path: path, query: query, fragment: fragment };
    }

    fn toString() -> string {
        var result = "";
        if (self.scheme.len > 0) { result = result + self.scheme + "://"; }
        result = result + self.host;
        if (self.port.len > 0) { result = result + ":" + self.port; }
        result = result + self.path;
        if (self.query.len > 0) { result = result + "?" + self.query; }
        if (self.fragment.len > 0) { result = result + "#" + self.fragment; }
        return result;
    }
}

public fn query_encode(params: Dict<string, string>) -> string {
    var result = "";
    let keys = params.keys();
    var i = 0;
    while (i < keys.len) {
        if (i > 0) { result = result + "&"; }
        let k = keys.get(i);
        result = result + url_encode(k) + "=" + url_encode(params.get(k));
        i = i + 1;
    }
    return result;
}
