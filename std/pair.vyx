module std.collections;

/// Vyx Standard Library — Pair<A, B>
///
/// A heterogeneous two-element tuple. Equivalent to Tuple2 from std/tuple.vyx.
/// Fields `first` / `second` are public so users can match the shape of
/// struct-style literals (`Pair { first: x, second: y }`) and read them
/// directly. `new` and `make` are convenience constructors with identical
/// behaviour and exist to match both Rust-style (`Pair::new(a, b)`) and
/// C++-style (`make_pair(a, b)`) expectations.
///
/// `eq` performs byte-wise equality on the two slots, accommodating both
/// trivially-copyable primitives (i32/i64/f64/bool/…) and compound types up
/// to `sizeof::<A>()` / `sizeof::<B>()`. For primitive payloads this matches
/// value equality; for types whose memory layout encodes pointer identity
/// (e.g. `string`) equality is pointer-bit equality — callers who need
/// structural compare should open-code it on the fields.
///
/// `clone` copies the full struct by value, matching Rust's `Clone` for
/// `Copy` types.
///
/// `fmt` produces `"Pair(<first>, <second>)"` using Vyx string interpolation;
/// it is intended for debugging only. It only compiles for payloads that
/// interpolate into `string` (primitives, `string`).

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
}

public class Pair<A, B> {
    public first: A;
    public second: B;

    public static fn new(a: A, b: B) -> Pair<A, B> {
        return Pair { first: a, second: b };
    }

    public static fn make(a: A, b: B) -> Pair<A, B> {
        return Pair { first: a, second: b };
    }

    public fn eq(other: Pair<A, B>) -> bool {
        let sa = sizeof::<A>();
        let sb = sizeof::<B>();
        var sa_self: i64 = 0;
        var sa_other: i64 = 0;
        if (sa <= 8) {
            memcpy(to_rawptr(&sa_self), to_rawptr(&self.first), sa);
            memcpy(to_rawptr(&sa_other), to_rawptr(&other.first), sa);
            if (sa_self != sa_other) { return false; }
        } else {
            if (memcmp(to_rawptr(&self.first), to_rawptr(&other.first), sa) != 0) { return false; }
        }
        var sb_self: i64 = 0;
        var sb_other: i64 = 0;
        if (sb <= 8) {
            memcpy(to_rawptr(&sb_self), to_rawptr(&self.second), sb);
            memcpy(to_rawptr(&sb_other), to_rawptr(&other.second), sb);
            return sb_self == sb_other;
        }
        return memcmp(to_rawptr(&self.second), to_rawptr(&other.second), sb) == 0;
    }

    /// Memberwise (shallow) copy of the two fields. See std/clone.vyx.
    ///
    /// Limitation: this is NOT a recursive deep clone. If `A` or `B`
    /// is a heap-owning container (Vec, Dict, Ref, ...), the cloned
    /// Pair's field shares the same backing pointer as the original.
    /// For fully independent copies of a `Pair<Vec<i32>, i32>`, do:
    ///
    ///   let p2 = Pair { first: p1.first.clone(), second: p1.second };
    ///
    /// This matches the historical contract of Pair.clone (since
    /// before P4) and is documented here in P4-D.3 so downstream
    /// code doesn't mistakenly assume Pair.clone follows the
    /// Vec/Dict deep-copy convention.
    public fn clone() -> Pair<A, B> {
        return Pair { first: self.first, second: self.second };
    }

    public fn fmt() -> string {
        return "Pair(${self.first}, ${self.second})";
    }
}
