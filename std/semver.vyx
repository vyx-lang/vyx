module std.semver;

/// SemVer — Semantic Versioning for Vyx
/// Usage: import std::semver;
///
/// Example:
///   let v = SemVer.parse("1.2.3-beta+build42");
///   print(v.major);       // 1
///   print(v.minor);       // 2
///   print(v.patch);       // 3
///   print(v.prerelease);  // "beta"
///   print(v.toString());  // "1.2.3-beta+build42"
///   print(v.satisfies(">=1.0.0"));  // true

public fn parse_int(s: string) -> i32 {
    var result = 0;
    var i = 0;
    while (i < s.len) {
        let ch = s.charAt(i);
        if (ch >= 48 && ch <= 57) {
            result = result * 10 + (ch - 48);
        }
        i = i + 1;
    }
    return result;
}

class SemVer {
    major: i32
    minor: i32
    patch: i32
    prerelease: string
    build: string

    static fn create(major: i32, minor: i32, patch: i32) -> SemVer {
        return SemVer { major: major, minor: minor, patch: patch, prerelease: "", build: "" };
    }

    static fn parse(version: string) -> SemVer {
        var s = version;
        if (s.startsWith("v") || s.startsWith("V")) {
            s = s.substring(1, s.len);
        }

        var prerelease = "";
        var build_meta = "";

        let plus_idx = s.indexOf("+");
        if (plus_idx >= 0) {
            build_meta = s.substring(plus_idx + 1, s.len);
            s = s.substring(0, plus_idx);
        }

        let dash_idx = s.indexOf("-");
        if (dash_idx >= 0) {
            prerelease = s.substring(dash_idx + 1, s.len);
            s = s.substring(0, dash_idx);
        }

        // Manually parse `MAJOR.MINOR.PATCH` without calling .split() —
        // current Sema stumbles on `parts.get(i)` where parts is the
        // returned Vec<string>, producing an "undefined function ''"
        // error. Inlining the tokenizer avoids the ambiguity.
        var major: i32 = 0;
        var minor: i32 = 0;
        var patch: i32 = 0;
        var cur = "";
        var seg: i32 = 0;
        var j = 0;
        while (j < s.len) {
            let ch = s.charAt(j);
            if (ch == 46) {  // '.'
                if (seg == 0) { major = parse_int(cur); }
                else if (seg == 1) { minor = parse_int(cur); }
                cur = "";
                seg = seg + 1;
            } else {
                cur = cur + s.substring(j, j + 1);
            }
            j = j + 1;
        }
        if (seg == 0) { major = parse_int(cur); }
        else if (seg == 1) { minor = parse_int(cur); }
        else { patch = parse_int(cur); }

        return SemVer { major: major, minor: minor, patch: patch, prerelease: prerelease, build: build_meta };
    }

    fn toString() -> string {
        var s = format("%d.%d.%d", self.major, self.minor, self.patch);
        if (self.prerelease.len > 0) { s = s + "-" + self.prerelease; }
        if (self.build.len > 0) { s = s + "+" + self.build; }
        return s;
    }

    fn compareTo(other: SemVer) -> i32 {
        if (self.major != other.major) { return self.major - other.major; }
        if (self.minor != other.minor) { return self.minor - other.minor; }
        if (self.patch != other.patch) { return self.patch - other.patch; }
        if (self.prerelease.len == 0 && other.prerelease.len > 0) { return 1; }
        if (self.prerelease.len > 0 && other.prerelease.len == 0) { return -1; }
        return 0;
    }

    fn greaterThan(other: SemVer) -> bool { return self.compareTo(other) > 0; }
    fn lessThan(other: SemVer) -> bool    { return self.compareTo(other) < 0; }
    fn equals(other: SemVer) -> bool      { return self.compareTo(other) == 0; }

    fn isPrerelease() -> bool {
        return self.prerelease.len > 0;
    }

    fn bumpMajor() -> SemVer {
        return SemVer.create(self.major + 1, 0, 0);
    }

    fn bumpMinor() -> SemVer {
        return SemVer.create(self.major, self.minor + 1, 0);
    }

    fn bumpPatch() -> SemVer {
        return SemVer.create(self.major, self.minor, self.patch + 1);
    }
}
