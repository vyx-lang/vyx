module std.collections;

/// Vyx Standard Library — BitSet
/// A fixed-length bit vector stored compactly as 64-bit words.
/// Each backing `i64` holds 64 consecutive bits.
///
/// Example:
///   var b = BitSet.new(128);
///   b.set(0); b.set(63); b.set(64); b.set(127);
///   let has_63 = b.test(63);       // true
///   let total  = b.count();        // 4
///   b.clear(0);
///   b.toggle(0);
///   var c = BitSet.new(128);
///   c.set(100);
///   b.bit_or(c);                   // b |= c
///   b.destroy();
///   c.destroy();

/// 64 bits per backing word. Kept as a helper for readability.
fn __bits_per_word() -> i64 { return 64; }

/// SWAR popcount over a 64-bit word.
fn __popcount64(w: i64) -> i64 {
    var v = w;
    let m1: i64  = 6148914691236517205;   // 0x5555555555555555
    let m2: i64  = 3689348814741910323;   // 0x3333333333333333
    let m4: i64  = 1085102592571150095;   // 0x0F0F0F0F0F0F0F0F
    let h01: i64 = 72340172838076673;     // 0x0101010101010101
    v = v - ((v >> 1) & m1);
    v = (v & m2) + ((v >> 2) & m2);
    v = (v + (v >> 4)) & m4;
    return (v * h01) >> 56;
}

public class BitSet {
    public data: Vec<i64>;
    public nbits: i64;

    /// Create a bitset of `nbits` zero-initialised bits.
    public static fn new(nbits: i64) -> BitSet {
        var n = nbits;
        if (n < 0) { n = 0; }
        let words = (n + 63) / 64;
        var d = Vec::<i64>.new();
        var i: i64 = 0;
        while (i < words) {
            d.push(0);
            i = i + 1;
        }
        return BitSet { data: d, nbits: n };
    }

    /// Alias of `new` provided for API symmetry with Vec / HashMap.
    public static fn with_capacity(nbits: i64) -> BitSet {
        return BitSet.new(nbits);
    }

    /// Number of addressable bits.
    public fn len() -> i64 { return self.nbits; }

    /// Number of 64-bit backing words.
    public fn word_count() -> i64 { return self.data.len; }

    fn _word_index(idx: i64) -> i64 { return idx >> 6; }

    fn _bit_mask(idx: i64) -> i64 {
        let one: i64 = 1;
        return one << (idx & 63);
    }

    fn _check(idx: i64) {
        if (idx < 0 || idx >= self.nbits) {
            panic("BitSet: index out of range");
        }
    }

    /// Set bit `idx` to 1.
    public fn set(idx: i64) {
        self._check(idx);
        let w = self._word_index(idx);
        let m = self._bit_mask(idx);
        self.data.set(w, self.data.get(w) | m);
    }

    /// Clear bit `idx` to 0.
    public fn clear(idx: i64) {
        self._check(idx);
        let w = self._word_index(idx);
        let m = self._bit_mask(idx);
        self.data.set(w, self.data.get(w) & (~m));
    }

    /// Flip bit `idx`.
    public fn toggle(idx: i64) {
        self._check(idx);
        let w = self._word_index(idx);
        let m = self._bit_mask(idx);
        self.data.set(w, self.data.get(w) ^ m);
    }

    /// Return whether bit `idx` is set.
    public fn test(idx: i64) -> bool {
        self._check(idx);
        let w = self._word_index(idx);
        let m = self._bit_mask(idx);
        return (self.data.get(w) & m) != 0;
    }

    public fn operator[](idx: i64) -> bool {
        return self.test(idx);
    }

    /// Total number of bits that are set across the whole vector.
    public fn count() -> i64 {
        var total: i64 = 0;
        var i: i64 = 0;
        let nw = self.data.len;
        let tail_bits = self.nbits & 63;
        let neg_one: i64 = 0 - 1;
        while (i < nw) {
            var w = self.data.get(i);
            // Mask off unused high bits on the final partial word. Otherwise
            // set_all() / bit_or() / bit_xor() might leave garbage bits above
            // `nbits` that would incorrectly inflate the count.
            if (tail_bits != 0 && i == nw - 1) {
                let mask = ~(neg_one << tail_bits);
                w = w & mask;
            }
            total = total + __popcount64(w);
            i = i + 1;
        }
        return total;
    }

    public fn any()  -> bool { return self.count() > 0; }
    public fn all()  -> bool { return self.count() == self.nbits; }
    public fn none() -> bool { return self.count() == 0; }

    /// Clear every bit.
    public fn clear_all() {
        var i: i64 = 0;
        while (i < self.data.len) {
            self.data.set(i, 0);
            i = i + 1;
        }
    }

    /// Set every bit within `nbits` (higher word bits may overflow but are
    /// masked out by `count` / `all`).
    public fn set_all() {
        let neg_one: i64 = 0 - 1;
        var i: i64 = 0;
        while (i < self.data.len) {
            self.data.set(i, neg_one);
            i = i + 1;
        }
    }

    /// In-place bitwise OR: self |= other. Both sets must have equal `nbits`.
    public fn bit_or(other: BitSet) {
        if (self.nbits != other.nbits) {
            panic("BitSet.bit_or: size mismatch");
        }
        var i: i64 = 0;
        while (i < self.data.len) {
            self.data.set(i, self.data.get(i) | other.data.get(i));
            i = i + 1;
        }
    }

    /// In-place bitwise AND: self &= other. Both sets must have equal `nbits`.
    public fn bit_and(other: BitSet) {
        if (self.nbits != other.nbits) {
            panic("BitSet.bit_and: size mismatch");
        }
        var i: i64 = 0;
        while (i < self.data.len) {
            self.data.set(i, self.data.get(i) & other.data.get(i));
            i = i + 1;
        }
    }

    /// In-place bitwise XOR: self ^= other. Both sets must have equal `nbits`.
    public fn bit_xor(other: BitSet) {
        if (self.nbits != other.nbits) {
            panic("BitSet.bit_xor: size mismatch");
        }
        var i: i64 = 0;
        while (i < self.data.len) {
            self.data.set(i, self.data.get(i) ^ other.data.get(i));
            i = i + 1;
        }
    }

    public fn isEmpty() -> bool { return self.none(); }

    /// Release the backing Vec. Safe to call multiple times.
    public fn destroy() {
        self.data.destroy();
        self.nbits = 0;
    }

    /// SSS Drop — delegates to destroy(); Vec's own drop is idempotent.
    public fn drop() { self.destroy(); }
}
