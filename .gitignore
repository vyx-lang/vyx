# Generated caches at any depth (files and directories)
*[Cc][Aa][Cc][Hh][Ee]*

# Everything whose name starts with a dot, at any depth — files and directories.
# Covers per-user IDE/tool state (.idea, .vscode, .cursor, .claude, .agents,
# .worktrees, .cache), editor session files (.orbit, .choccy), OS metadata
# (.DS_Store) and any other dotfile.
.*
# Exception: the two dotfiles git itself has to keep adding and updating.
# Both are tracked today, but this negation is what still lets a *new* nested
# fixture .gitignore (tests/projects/*, samples/projects/*, benchmarks/*) be
# picked up by a plain `git add` instead of silently vanishing.
!.gitignore
!.dockerignore

# Runtime and build logs
*.log
*.log.*

# LLVM IR / dumps (snapshots keep *.ll.norm, not raw *.ll)
*.ll
*.bc
*.dump
*.dmp
*.syms.txt

# IDE / editor
.idea/
.vscode/
.cursor/
.claude/
*.swp
*~

# Startup debugger / UI-acceptance scratch files (lldb command batches, traces,
# one-off launchers) produced while diagnosing Zyn crashes and verifying GUIs.
samples/projects/zyn_counter_app/_lldb_*.txt
samples/projects/zyn_counter_app/session_trace.txt
samples/projects/zyn_counter_app/host_stages.txt
samples/projects/zyn_counter_app/exitcode.txt
samples/projects/zyn_counter_app/launch_keep*.cmd

# Build directories
cmake-build-*/
build/
build_vyxcg/
build_yolo_vyxcg/
out/
benchmarks/out*/
**/target/
**/zig-out/

# DCI benchmark results are committed (raw JSON/CSV); only the transient cargo
# work tree under it is ignored.
!tools/dci/bench/out/
tools/dci/bench/out/work/
tools/dci/bench/out/windows/work/
tools/dci/bench/out/windows/callbench_work/

