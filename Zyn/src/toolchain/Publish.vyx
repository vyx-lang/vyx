module Zyn.Toolchain.Publish;

use std.collections;

public fn publishHostUnknown() -> i32 { return 0; }
public fn publishHostWindows() -> i32 { return 1; }
public fn publishHostLinux() -> i32 { return 2; }
public fn publishHostMacOS() -> i32 { return 3; }

public fn publishPlatformWindows() -> i32 { return 1; }
public fn publishPlatformAndroid() -> i32 { return 2; }
public fn publishPlatformLinux() -> i32 { return 3; }
public fn publishPlatformMacOS() -> i32 { return 4; }
public fn publishPlatformIOS() -> i32 { return 5; }

public fn publishPackageDirectory() -> i32 { return 0; }
public fn publishPackageZip() -> i32 { return 1; }
public fn publishPackageApk() -> i32 { return 2; }
public fn publishPackageAab() -> i32 { return 3; }
public fn publishPackageAppBundle() -> i32 { return 4; }
public fn publishPackageIpa() -> i32 { return 5; }

@[platform("windows")]
public fn publishCurrentHost() -> i32 { return publishHostWindows(); }

@[platform("linux")]
public fn publishCurrentHost() -> i32 { return publishHostLinux(); }

@[platform("macos")]
public fn publishCurrentHost() -> i32 { return publishHostMacOS(); }

@[platform("android")]
public fn publishCurrentHost() -> i32 { return publishHostUnknown(); }

public fn publishHostName(host: i32) -> string {
    if (host == publishHostWindows()) { return "windows"; }
    if (host == publishHostLinux()) { return "linux"; }
    if (host == publishHostMacOS()) { return "macos"; }
    return "unknown";
}

public fn publishPlatformName(platform: i32) -> string {
    if (platform == publishPlatformWindows()) { return "windows"; }
    if (platform == publishPlatformAndroid()) { return "android"; }
    if (platform == publishPlatformLinux()) { return "linux"; }
    if (platform == publishPlatformMacOS()) { return "macos"; }
    if (platform == publishPlatformIOS()) { return "ios"; }
    return "unknown";
}

public fn publishPackageName(kind: i32) -> string {
    if (kind == publishPackageZip()) { return "zip"; }
    if (kind == publishPackageApk()) { return "apk"; }
    if (kind == publishPackageAab()) { return "aab"; }
    if (kind == publishPackageAppBundle()) { return "app"; }
    if (kind == publishPackageIpa()) { return "ipa"; }
    return "directory";
}

public fn publishHostCanBuildPlatform(host: i32, platform: i32) -> bool {
    if (host == publishHostWindows()) {
        return platform == publishPlatformWindows() || platform == publishPlatformAndroid();
    }
    if (host == publishHostLinux()) {
        return platform == publishPlatformLinux() || platform == publishPlatformAndroid();
    }
    if (host == publishHostMacOS()) {
        return platform == publishPlatformMacOS() || platform == publishPlatformIOS();
    }
    return false;
}

public class PublishError {
    public code: i32;
    public message: string;

    public static fn create(code: i32, message: string) -> PublishError {
        return PublishError { code: code, message: message };
    }
}

public class PublishApp {
    public name: string;
    public version: string;
    public identifier: string;
    public entry: string;

    public static fn create(name: string, identifier: string) -> PublishApp {
        return PublishApp {
            name: name,
            version: "0.1.0",
            identifier: identifier,
            entry: "src/main.vyx"
        };
    }

    public fn setVersion(mut self, version: string) -> PublishApp {
        self.version = version;
        return self;
    }

    public fn setEntry(mut self, entry: string) -> PublishApp {
        self.entry = entry;
        return self;
    }

    public fn clone(&self) -> PublishApp {
        return PublishApp {
            name: self.name,
            version: self.version,
            identifier: self.identifier,
            entry: self.entry
        };
    }
}

public class PublishTarget {
    public name: string;
    public platform: i32;
    public arch: string;
    public package_kind: i32;
    public enabled: bool;
    public dist_dir: string;
    public artifact_name: string;
    public toolchain_hint: string;

    public static fn create(name: string, platform: i32, arch: string, package_kind: i32) -> PublishTarget {
        return PublishTarget {
            name: name,
            platform: platform,
            arch: arch,
            package_kind: package_kind,
            enabled: true,
            dist_dir: "dist",
            artifact_name: "",
            toolchain_hint: ""
        };
    }

    public static fn windowsX64() -> PublishTarget {
        return PublishTarget.create("windows-x64", publishPlatformWindows(), "x64", publishPackageZip())
            .setToolchainHint("native Windows linker plus ZIP staging");
    }

    public static fn androidArm64() -> PublishTarget {
        return PublishTarget.create("android-arm64", publishPlatformAndroid(), "arm64", publishPackageApk())
            .setToolchainHint("NativeActivity Android Gradle project plus ANDROID_HOME or ANDROID_SDK_ROOT and target/android-arm64/lib*.so");
    }

    public static fn linuxX64() -> PublishTarget {
        return PublishTarget.create("linux-x64", publishPlatformLinux(), "x64", publishPackageDirectory())
            .setToolchainHint("native Linux linker plus directory staging");
    }

    public static fn macOSUniversal() -> PublishTarget {
        return PublishTarget.create("macos-universal", publishPlatformMacOS(), "universal", publishPackageAppBundle())
            .setToolchainHint("macOS app bundle staging");
    }

    public static fn iosArm64() -> PublishTarget {
        return PublishTarget.create("ios-arm64", publishPlatformIOS(), "arm64", publishPackageIpa())
            .setToolchainHint("Xcode archive/export on macOS");
    }

    public fn disabled(mut self) -> PublishTarget {
        self.enabled = false;
        return self;
    }

    public fn setDistDir(mut self, dir: string) -> PublishTarget {
        self.dist_dir = dir;
        return self;
    }

    public fn setArtifactName(mut self, name: string) -> PublishTarget {
        self.artifact_name = name;
        return self;
    }

    public fn setToolchainHint(mut self, hint: string) -> PublishTarget {
        self.toolchain_hint = hint;
        return self;
    }

    public fn isMobile(&self) -> bool {
        return self.platform == publishPlatformAndroid() || self.platform == publishPlatformIOS();
    }

    public fn platformName(&self) -> string {
        return publishPlatformName(self.platform);
    }

    public fn packageName(&self) -> string {
        return publishPackageName(self.package_kind);
    }

    public fn clone(&self) -> PublishTarget {
        return PublishTarget {
            name: self.name,
            platform: self.platform,
            arch: self.arch,
            package_kind: self.package_kind,
            enabled: self.enabled,
            dist_dir: self.dist_dir,
            artifact_name: self.artifact_name,
            toolchain_hint: self.toolchain_hint
        };
    }
}

public class PublishPlan {
    public host: i32;
    public app: PublishApp;
    private targets: Vec<PublishTarget>;

    public static fn create(host: i32, app: PublishApp) -> PublishPlan {
        return PublishPlan {
            host: host,
            app: app.clone(),
            targets: Vec::<PublishTarget>.new()
        };
    }

    public fn addTarget(mut self, target: PublishTarget) -> PublishPlan {
        self.targets.push(target.clone());
        return self;
    }

    public fn targetCount(&self) -> i32 {
        return self.targets.len as i32;
    }

    public fn targetAt(&self, index: i32) -> PublishTarget {
        return self.targets.get(index as i64);
    }

    public fn summary(&self) -> string {
        var out = "host=" + publishHostName(self.host) + " app=" + self.app.name + " version=" + self.app.version + "\n";
        var i: i32 = 0;
        while (i < (self.targets.len as i32)) {
            let target = self.targets.get(i as i64);
            out = out + target.name + " platform=" + target.platformName() + " arch=" + target.arch + " package=" + target.packageName() + " toolchain=" + target.toolchain_hint + "\n";
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.targets.destroy();
    }
}

public class PublishManifest {
    public app: PublishApp;
    private targets: Vec<PublishTarget>;

    public static fn create(app: PublishApp) -> PublishManifest {
        return PublishManifest {
            app: app.clone(),
            targets: Vec::<PublishTarget>.new()
        };
    }

    public static fn hostDefaults(app: PublishApp) -> PublishManifest {
        return PublishManifest.create(app).addHostDefaultTargets(publishCurrentHost());
    }

    public fn addTarget(mut self, target: PublishTarget) -> PublishManifest {
        self.targets.push(target.clone());
        return self;
    }

    public fn addHostDefaultTargets(mut self, host: i32) -> PublishManifest {
        if (host == publishHostWindows()) {
            self = self.addTarget(PublishTarget.windowsX64());
            self = self.addTarget(PublishTarget.androidArm64());
        } else if (host == publishHostLinux()) {
            self = self.addTarget(PublishTarget.linuxX64());
            self = self.addTarget(PublishTarget.androidArm64());
        } else if (host == publishHostMacOS()) {
            self = self.addTarget(PublishTarget.macOSUniversal());
            self = self.addTarget(PublishTarget.iosArm64());
        }
        return self;
    }

    public fn targetCount(&self) -> i32 {
        return self.targets.len as i32;
    }

    public fn targetAt(&self, index: i32) -> PublishTarget {
        return self.targets.get(index as i64);
    }

    public fn validateForHost(&self, host: i32) -> Result<PublishPlan, PublishError> {
        if (host == publishHostUnknown()) {
            return Err(PublishError.create(1, "unknown publish host"));
        }
        var plan = PublishPlan.create(host, self.app);
        var i: i32 = 0;
        while (i < (self.targets.len as i32)) {
            let target = self.targets.get(i as i64);
            if (target.enabled) {
                if (!publishHostCanBuildPlatform(host, target.platform)) {
                    plan.destroy();
                    return Err(PublishError.create(2, "host " + publishHostName(host) + " cannot publish target " + target.name));
                }
                plan = plan.addTarget(target);
            }
            i = i + 1;
        }
        if (plan.targetCount() == 0) {
            plan.destroy();
            return Err(PublishError.create(3, "publish manifest has no enabled targets"));
        }
        return Ok(plan);
    }

    public fn destroy(&mut self) {
        self.targets.destroy();
    }
}
