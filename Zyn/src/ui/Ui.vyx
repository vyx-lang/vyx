    public fn clone(&self) -> UiTheme {
        return UiTheme {
            background: self.background.clone(),
            panel: self.panel.clone(),
            text: self.text.clone(),
            muted_text: self.muted_text.clone(),
            accent: self.accent.clone(),
            border: self.border.clone(),
            surface: self.surface.clone(),
            surface_variant: self.surface_variant.clone(),
            primary: self.primary.clone(),
            on_primary: self.on_primary.clone(),
            primary_container: self.primary_container.clone(),
            on_primary_container: self.on_primary_container.clone(),
            secondary: self.secondary.clone(),
            on_secondary: self.on_secondary.clone(),
            secondary_container: self.secondary_container.clone(),
            on_secondary_container: self.on_secondary_container.clone(),
            error_color: self.error_color.clone(),
            on_error_color: self.on_error_color.clone(),
            outline: self.outline.clone(),
            outline_variant: self.outline_variant.clone(),
            shape_small: self.shape_small,
            shape_medium: self.shape_medium,
            shape_large: self.shape_large,
            shape_full: self.shape_full,
            spacing_xs: self.spacing_xs,
            spacing_sm: self.spacing_sm,
            spacing_md: self.spacing_md,
            spacing_lg: self.spacing_lg,
            typography_label: self.typography_label,
            typography_body: self.typography_body,
            typography_title: self.typography_title,
            control_height: self.control_height,
            state_hover_alpha: self.state_hover_alpha,
            state_focus_alpha: self.state_focus_alpha,
            state_pressed_alpha: self.state_pressed_alpha,
            state_dragged_alpha: self.state_dragged_alpha,
            disabled_container_alpha: self.disabled_container_alpha,
            disabled_content_alpha: self.disabled_content_alpha,
            elevation_overlay_alpha: self.elevation_overlay_alpha
        };
    }

    public fn dup(&self) -> UiTheme {
        return self.clone();
    }

    public fn stateLayer(&self, color: Color, alpha: f32) -> Color {
        let c = colorUnpack(color);
        return Color.rgba(c.r, c.g, c.b, alpha);
    }

    public fn hoverOverlay(&self, color: Color) -> Color {
        return self.stateLayer(color, self.state_hover_alpha);
    }

    public fn focusOverlay(&self, color: Color) -> Color {
        return self.stateLayer(color, self.state_focus_alpha);
    }

    public fn pressedOverlay(&self, color: Color) -> Color {
        return self.stateLayer(color, self.state_pressed_alpha);
    }

    public fn draggedOverlay(&self, color: Color) -> Color {
        return self.stateLayer(color, self.state_dragged_alpha);
    }

    public fn disabledContainer(&self) -> Color {
        return self.stateLayer(self.text, self.disabled_container_alpha);
    }

    public fn disabledContent(&self) -> Color {
        return self.stateLayer(self.text, self.disabled_content_alpha);
    }

    public fn elevationOverlay(&self) -> Color {
        return self.stateLayer(self.primary, self.elevation_overlay_alpha);
    }

    public fn withDensity(&self, scale: f32) -> UiTheme {
        var out = self.clone();
        out.spacing_xs = out.spacing_xs * scale;
        out.spacing_sm = out.spacing_sm * scale;
        out.spacing_md = out.spacing_md * scale;
        out.spacing_lg = out.spacing_lg * scale;
        out.control_height = out.control_height * scale;
        return out;
    }
}

public class UiLayoutSpec {
    public bounds: Rectangle;
    public direction: i32;
    public padding: f32;
    public gap: f32;
    public cursor: f32;

    public static fn vertical(bounds: Rectangle, padding: f32, gap: f32) -> UiLayoutSpec {
        return UiLayoutSpec {
            bounds: bounds.clone(),
            direction: uiLayoutVertical(),
            padding: padding,
            gap: gap,
            cursor: padding
        };
    }

    public static fn horizontal(bounds: Rectangle, padding: f32, gap: f32) -> UiLayoutSpec {
        return UiLayoutSpec {
            bounds: bounds.clone(),
            direction: uiLayoutHorizontal(),
            padding: padding,
            gap: gap,
            cursor: padding
        };
    }

    public fn next(&mut self, width: f32, height: f32) -> Rectangle {
        var rect: Rectangle;
        if (self.direction == uiLayoutHorizontal()) {
            rect = Rectangle.xywh(self.bounds.x + self.cursor, self.bounds.y + self.padding, width, height);
            self.cursor = self.cursor + width + self.gap;
        } else {
            rect = Rectangle.xywh(self.bounds.x + self.padding, self.bounds.y + self.cursor, width, height);
            self.cursor = self.cursor + height + self.gap;
        }
        return rect;
    }

    public fn remaining(&self) -> Rectangle {
        if (self.direction == uiLayoutHorizontal()) {
            return Rectangle.xywh(self.bounds.x + self.cursor, self.bounds.y + self.padding, self.bounds.width - self.cursor - self.padding, self.bounds.height - (self.padding * 2.0));
        }
        return Rectangle.xywh(self.bounds.x + self.padding, self.bounds.y + self.cursor, self.bounds.width - (self.padding * 2.0), self.bounds.height - self.cursor - self.padding);
    }
}

// A CustomView owns the data needed for 2D drawing. The UI tree takes a deep
// copy so a rebuilt View cannot invalidate a frame in progress.
public interface CustomView {
    fn paint(&self, scene: SceneBuilder, bounds: Rectangle) -> SceneBuilder;
    fn dup(&self) -> Box<dyn CustomView>;
}

public class UiNode {
    public kind: i32;
    public id: string;
    public parent: i32;
    public bounds: Rectangle;
    public color: Color;
    public text_color: Color;
    public text: string;
    public placeholder: string;
    public composition_text: string;
    public composition_start: i32;
    public composition_length: i32;
    public visible: bool;
    public enabled: bool;
    public checked: bool;
    public padding: f32;
    public gap: f32;
    public stroke_width: f32;
    public stroke_color: Color;
    public corner_radius: f32;
    public elevation: f32;
    public text_align: i32;
    public overlay_color: Color;
    public caret_visible: bool;
    public caret_color: Color;
    public value: f32;
    public min_value: f32;
    public max_value: f32;
    public custom_view_index: i32;
    public render_slot_id: i32;
    public custom_interactive: bool;

    public static fn create(kind: i32, id: string) -> UiNode {
        return UiNode {
            kind: kind,
            id: id,
            parent: -1,
            bounds: Rectangle { x: 0.0, y: 0.0, width: 0.0, height: 0.0 },
            color: Color.rgba(0.12, 0.14, 0.18, 1.0),
            text_color: Color.rgba(0.94, 0.96, 1.0, 1.0),
            text: "",
            placeholder: "",
            composition_text: "",
            composition_start: 0,
            composition_length: 0,
            visible: true,
            enabled: true,
            checked: false,
            padding: 8.0,
            gap: 8.0,
            stroke_width: 0.0,
            stroke_color: Color.rgba(0.0, 0.0, 0.0, 0.0),
            corner_radius: 0.0,
            elevation: 0.0,
            text_align: uiTextAlignLeft(),
            overlay_color: Color.rgba(0.0, 0.0, 0.0, 0.0),
            caret_visible: false,
            caret_color: Color.rgba(0.0, 0.0, 0.0, 0.0),
            value: 0.0,
            min_value: 0.0,
            max_value: 100.0,
            custom_view_index: -1,
            render_slot_id: -1,
            custom_interactive: false
        };
    }

    public static fn root(width: f32, height: f32) -> UiNode {
        var node = UiNode.create(uiNodeRoot(), "root");
        node = node.withBounds(0.0, 0.0, width, height);
        node = node.withColor(Color.rgba(0.0, 0.0, 0.0, 0.0));
        return node;
    }

    public static fn panel(id: string, bounds: Rectangle, color: Color) -> UiNode {
        var node = UiNode.create(uiNodePanel(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withColor(color);
        return node;
    }

    public static fn scrollPanel(id: string, bounds: Rectangle, color: Color) -> UiNode {
        var node = UiNode.panel(id, bounds, color);
        node.kind = uiNodeScroll();
        return node;
    }

    public static fn text(id: string, text: string, bounds: Rectangle, color: Color) -> UiNode {
        var node = UiNode.create(uiNodeText(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withTextColor(color);
        return node;
    }

    public static fn button(id: string, text: string, bounds: Rectangle, color: Color) -> UiNode {
        var node = UiNode.create(uiNodeButton(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withColor(color);
        return node;
    }

    @[borrow_args]
    public static fn filledButton(id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.button(id, text, bounds, theme.primary);
        node = node.withTextColor(theme.on_primary);
        node = node.withCornerRadius(theme.shape_full);
        node = node.withOverlay(theme.hoverOverlay(theme.on_primary));
        return node;
    }

    @[borrow_args]
    public static fn tonalButton(id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.button(id, text, bounds, theme.secondary_container);
        node = node.withTextColor(theme.on_secondary_container);
        node = node.withCornerRadius(theme.shape_full);
        node = node.withOverlay(theme.hoverOverlay(theme.on_secondary_container));
        return node;
    }

    @[borrow_args]
    public static fn outlinedButton(id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.button(id, text, bounds, Color.rgba(0.0, 0.0, 0.0, 0.0));
        node = node.withTextColor(theme.primary);
        node = node.withCornerRadius(theme.shape_full);
        node = node.withStroke(1.0, theme.outline);
        node = node.withOverlay(theme.hoverOverlay(theme.primary));
        return node;
    }

    @[borrow_args]
    public fn themedDisabled(mut self, theme: UiTheme) -> UiNode {
        self.enabled = false;
        self.color = theme.disabledContainer();
        self.text_color = theme.disabledContent();
        self.overlay_color = Color.rgba(0.0, 0.0, 0.0, 0.0);
        return self;
    }

    public static fn spacer(id: string, bounds: Rectangle) -> UiNode {
        var node = UiNode.create(uiNodeSpacer(), id);
        return node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
    }

    public static fn custom(id: string, bounds: Rectangle, interactive: bool) -> UiNode {
        var node = UiNode.create(uiNodeCustom(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node.custom_interactive = interactive;
        return node;
    }

    public static fn customRender(id: string, bounds: Rectangle, slot_id: i32, interactive: bool) -> UiNode {
        var node = UiNode.create(uiNodeRender(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node.render_slot_id = slot_id;
        node.custom_interactive = interactive;
        return node;
    }

    @[borrow_args]
    public static fn textInput(id: string, text: string, placeholder: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.create(uiNodeTextInput(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withPlaceholder(placeholder);
        node = node.withColor(theme.surface);
        node = node.withTextColor(theme.text);
        if (text.len == 0) { node = node.withTextColor(theme.muted_text); }
        node = node.withStroke(1.0, theme.outline);
        node = node.withCornerRadius(theme.shape_small);
        node = node.withPadding(theme.spacing_md);
        node = node.withOverlay(theme.focusOverlay(theme.primary));
        return node;
    }

    @[borrow_args]
    public static fn toggle(id: string, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.create(uiNodeToggle(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        if (checked) {
            node = node.withColor(theme.primary_container);
            node = node.withTextColor(theme.on_primary_container);
            node = node.withOverlay(theme.pressedOverlay(theme.on_primary_container));
        } else {
            node = node.withColor(theme.surface_variant);
            node = node.withTextColor(theme.text);
            node = node.withStroke(1.0, theme.outline);
            node = node.withOverlay(theme.hoverOverlay(theme.text));
        }
        node = node.withCornerRadius(theme.shape_full);
        node.checked = checked;
        return node;
    }

    @[borrow_args]
    public static fn slider(id: string, text: string, value: f32, min_value: f32, max_value: f32, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.create(uiNodeSlider(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withColor(theme.surface_variant);
        node = node.withTextColor(theme.primary);
        node = node.withStroke(1.0, theme.outline_variant);
        node = node.withCornerRadius(theme.shape_full);
        node = node.withOverlay(theme.draggedOverlay(theme.primary));
        node.value = value;
        node.min_value = min_value;
        node.max_value = max_value;
        return node;
    }

    @[borrow_args]
    public static fn checkbox(id: string, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.create(uiNodeCheckbox(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withColor(theme.surface);
        node = node.withTextColor(theme.text);
        node = node.withStroke(1.0, theme.outline);
        node = node.withCornerRadius(theme.shape_small);
        node = node.withPadding(32.0);
        node.checked = checked;
        if (checked) {
            node = node.withColor(theme.primary);
            node = node.withTextColor(theme.text);
            node = node.withOverlay(theme.pressedOverlay(theme.text));
        } else {
            node = node.withOverlay(theme.hoverOverlay(theme.text));
        }
        return node;
    }

    @[borrow_args]
    public static fn progress(id: string, text: string, value: f32, min_value: f32, max_value: f32, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.create(uiNodeProgress(), id);
        node = node.withBounds(bounds.x, bounds.y, bounds.width, bounds.height);
        node = node.withText(text);
        node = node.withColor(theme.surface_variant);
        node = node.withTextColor(theme.primary);
        node = node.withStroke(1.0, theme.outline_variant);
        node = node.withCornerRadius(theme.shape_full);
        node = node.withOverlay(theme.elevationOverlay());
        node.value = value;
        node.min_value = min_value;
        node.max_value = max_value;
        return node;
    }

    public fn clone(&self) -> UiNode {
        return UiNode {
            kind: self.kind,
            id: self.id,
            parent: self.parent,
            bounds: self.bounds.clone(),
            color: self.color.clone(),
            text_color: self.text_color.clone(),
            text: self.text,
            placeholder: self.placeholder,
            composition_text: self.composition_text,
            composition_start: self.composition_start,
            composition_length: self.composition_length,
            visible: self.visible,
            enabled: self.enabled,
            checked: self.checked,
            padding: self.padding,
            gap: self.gap,
            stroke_width: self.stroke_width,
            stroke_color: self.stroke_color.clone(),
            corner_radius: self.corner_radius,
            elevation: self.elevation,
            text_align: self.text_align,
            overlay_color: self.overlay_color.clone(),
            caret_visible: self.caret_visible,
            caret_color: self.caret_color.clone(),
            value: self.value,
            min_value: self.min_value,
            max_value: self.max_value,
            custom_view_index: self.custom_view_index,
            render_slot_id: self.render_slot_id,
            custom_interactive: self.custom_interactive
        };
    }

    public fn withParent(mut self, parent: i32) -> UiNode {
        self.parent = parent;
        return self;
    }

    public fn withBounds(mut self, x: f32, y: f32, width: f32, height: f32) -> UiNode {
        self.bounds.x = x;
        self.bounds.y = y;
        self.bounds.width = width;
        self.bounds.height = height;
        return self;
    }

    public fn withColor(mut self, color: Color) -> UiNode {
        let p = to_rawptr(&color);
        self.color.r = typesLoadF32(p);
        self.color.g = typesLoadF32(p + 4);
        self.color.b = typesLoadF32(p + 8);
        self.color.a = typesLoadF32(p + 12);
        return self;
    }

    public fn withTextColor(mut self, color: Color) -> UiNode {
        let p = to_rawptr(&color);
        self.text_color.r = typesLoadF32(p);
        self.text_color.g = typesLoadF32(p + 4);
        self.text_color.b = typesLoadF32(p + 8);
        self.text_color.a = typesLoadF32(p + 12);
        return self;
    }

    public fn withText(mut self, text: string) -> UiNode {
        self.text = text;
        return self;
    }

    public fn withPlaceholder(mut self, placeholder: string) -> UiNode {
        self.placeholder = placeholder;
        return self;
    }

    public fn withComposition(mut self, text: string) -> UiNode {
        self.composition_text = text;
        self.composition_start = uiTextUtf8CharCount(text);
        self.composition_length = 0;
        return self;
    }

    public fn withCompositionRange(mut self, text: string, start: i32, length: i32) -> UiNode {
        self.composition_text = text;
        self.composition_start = start;
        self.composition_length = length;
        return self;
    }

    public fn withPadding(mut self, padding: f32) -> UiNode {
        self.padding = padding;
        return self;
    }

    public fn withStroke(mut self, width: f32, color: Color) -> UiNode {
        self.stroke_width = width;
        self.stroke_color = color.clone();
        return self;
    }

    public fn withCornerRadius(mut self, radius: f32) -> UiNode {
        self.corner_radius = radius;
        return self;
    }

    public fn withElevation(mut self, value: f32) -> UiNode {
        self.elevation = value;
        return self;
    }

    public fn withTextAlign(mut self, align: i32) -> UiNode {
        self.text_align = align;
        return self;
    }

    public fn withOverlay(mut self, color: Color) -> UiNode {
        self.overlay_color = color.clone();
        return self;
    }

    public fn withCaret(mut self, visible: bool, color: Color) -> UiNode {
        self.caret_visible = visible;
        self.caret_color = color.clone();
        return self;
    }

    public fn disabled(mut self) -> UiNode {
        self.enabled = false;
        return self;
    }

    public fn hidden(mut self) -> UiNode {
        self.visible = false;
        return self;
    }

    public fn contains(&self, point: Point) -> bool {
        return self.visible && self.bounds.contains(point);
    }

    public fn isInteractive(&self) -> bool {
        return self.visible && self.enabled && (self.kind == uiNodeButton() || self.kind == uiNodeToggle() || self.kind == uiNodeTextInput() || self.kind == uiNodeSlider() || self.kind == uiNodeCheckbox() || ((self.kind == uiNodeCustom() || self.kind == uiNodeRender()) && self.custom_interactive));
    }
}

public class UiTree {
    private nodes: Vec<UiNode>;
    private custom_views: Vec<Box<dyn CustomView>>;

    public static fn create(width: f32, height: f32) -> UiTree {
        var nodes = Vec::<UiNode>.new();
        nodes.push(UiNode.root(width, height));
        return UiTree { nodes: nodes, custom_views: Vec::<Box<dyn CustomView>>.new() };
    }

    public fn add(mut self, parent: i32, node: UiNode) -> UiTree {
        self.nodes.push(node.withParent(parent));
        return self;
    }

    public fn addCustom(mut self, parent: i32, node: UiNode, custom_view: Box<dyn CustomView>) -> UiTree {
        var custom = node;
        custom.custom_view_index = self.custom_views.len as i32;
        self.custom_views.push(custom_view);
        return self.add(parent, custom);
    }

    public fn addRoot(mut self, node: UiNode) -> UiTree {
        return self.add(0, node);
    }

    @[borrow_args]
    public fn addPanel(mut self, parent: i32, id: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var node = UiNode.panel(id, bounds, theme.panel);
        node = node.withStroke(1.0, theme.border);
        return self.add(parent, node);
    }

    @[borrow_args]
    public fn addSurface(mut self, parent: i32, id: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var node = UiNode.panel(id, bounds, theme.surface);
        node = node.withStroke(1.0, theme.outline_variant);
        node = node.withCornerRadius(theme.shape_large);
        return self.add(parent, node);
    }

    @[borrow_args]
    public fn addText(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.text(id, text, bounds, theme.text));
    }

    @[borrow_args]
    public fn addTitle(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var node = UiNode.text(id, text, bounds, theme.text);
        node = node.withPadding(theme.spacing_xs);
        return self.add(parent, node);
    }

    @[borrow_args]
    public fn addMutedText(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.text(id, text, bounds, theme.muted_text));
    }

    @[borrow_args]
    public fn addButton(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var node = UiNode.button(id, text, bounds, theme.accent);
        node = node.withStroke(1.0, theme.border);
        return self.add(parent, node);
    }

    @[borrow_args]
    public fn addFilledButton(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.filledButton(id, text, bounds, theme));
    }

    @[borrow_args]
    public fn addTonalButton(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.tonalButton(id, text, bounds, theme));
    }

    @[borrow_args]
    public fn addOutlinedButton(mut self, parent: i32, id: string, text: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.outlinedButton(id, text, bounds, theme));
    }

    @[borrow_args]
    public fn addToggle(mut self, parent: i32, id: string, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.toggle(id, text, checked, bounds, theme));
    }

    @[borrow_args]
    public fn addTextInput(mut self, parent: i32, id: string, text: string, placeholder: string, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.textInput(id, text, placeholder, bounds, theme));
    }

    @[borrow_args]
    public fn addSlider(mut self, parent: i32, id: string, text: string, value: f32, min_value: f32, max_value: f32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.slider(id, text, value, min_value, max_value, bounds, theme));
    }

    @[borrow_args]
    public fn addCheckbox(mut self, parent: i32, id: string, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.checkbox(id, text, checked, bounds, theme));
    }

    @[borrow_args]
    public fn addProgress(mut self, parent: i32, id: string, text: string, value: f32, min_value: f32, max_value: f32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        return self.add(parent, UiNode.progress(id, text, value, min_value, max_value, bounds, theme));
    }

    public fn nodeCount(&self) -> i32 {
        return self.nodes.len as i32;
    }

    public fn nodeAt(&self, index: i32) -> UiNode {
        return self.nodes.get(index as i64);
    }

    public fn find(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.nodes.len as i32)) {
            if (self.nodes.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn hitTest(&self, point: Point) -> i32 {
        var i = (self.nodes.len as i32) - 1;
        while (i >= 0) {
            let node = self.nodes.get(i as i64);
            if (node.isInteractive() && node.contains(point)) {
                var inside_scroll = true;
                var ancestor_index = node.parent;
                while (ancestor_index >= 0 && ancestor_index < i) {
                    let ancestor = self.nodes.get(ancestor_index as i64);
                    if (ancestor.kind == uiNodeScroll() && !ancestor.contains(point)) {
                        inside_scroll = false;
                        break;
                    }
                    ancestor_index = ancestor.parent;
                }
                if (inside_scroll) { return i; }
            }
            i = i - 1;
        }
        return -1;
    }

    public fn clipToScrollAncestors(&self, scene: SceneBuilder, node: UiNode) -> SceneBuilder {
        var out = scene;
        var ancestor_index = node.parent;
        while (ancestor_index >= 0 && ancestor_index < self.nodeCount()) {
            let ancestor = self.nodes.get(ancestor_index as i64);
            if (ancestor.kind == uiNodeScroll()) { out = out.clipRect(ancestor.bounds); }
            ancestor_index = ancestor.parent;
        }
        return out;
    }

    public fn nodePathFromIndex(&self, index: i32) -> string {
        if (index < 0 || index >= self.nodeCount()) { return ""; }
        var out: string = "";
        var current = index;
        while (current > 0 && current < self.nodeCount()) {
            let node = self.nodes.get(current as i64);
            if (node.id.len > 0) {
                if (out.len == 0) {
                    out = node.id;
                } else {
                    out = out + ">" + node.id;
                }
            }
            current = node.parent;
        }
        return out;
    }

    public fn hitPath(&self, point: Point) -> string {
        return self.nodePathFromIndex(self.hitTest(point));
    }

    public fn render(&self, scene: SceneBuilder) -> SceneBuilder {
        var out = scene;
        var i: i32 = 0;
        while (i < (self.nodes.len as i32)) {
            let node = self.nodes.get(i as i64);
            if (node.visible) {
                if (node.kind == uiNodeCustom()) {
                    let custom_view_index = node.custom_view_index;
                    if (custom_view_index >= 0 && custom_view_index < (self.custom_views.len as i32)) {
                        // Normal drawing is clipped to the laid-out rectangle;
                        // Custom views must leave the caller's save/clip stack intact.
                        out = self.clipToScrollAncestors(out.save(), node).clipRect(node.bounds);
                        let custom_view = self.custom_views.get(custom_view_index as i64).deref();
                        out = custom_view.paint(out, node.bounds);
                        out = out.restore();
                    }
                } else if (node.kind == uiNodeRender()) {
                    out = self.clipToScrollAncestors(out.save(), node).clipRect(node.bounds);
                    out = out.drawExternal(node.bounds, node.render_slot_id);
                    out = out.restore();
                } else if (node.kind == uiNodeSlider()) {
                    let zero = 0.0 as f32;
                    let one = 1.0 as f32;
                    let half = 0.5 as f32;
                    let track_height = 6.0 as f32;
                    let track_radius = 3.0 as f32;
                    let bx = node.bounds.x;
                    let by = node.bounds.y;
                    let bw = node.bounds.width;
                    let bh = node.bounds.height;
                    var span: f32 = node.max_value - node.min_value;
                    if (span <= zero) { span = one; }
                    var ratio: f32 = (node.value - node.min_value) / span;
                    if (ratio < zero) { ratio = zero; }
                    if (ratio > one) { ratio = one; }
                    let track_y: f32 = by + (bh * half) - track_radius;
                    let fill_width: f32 = bw * ratio;
                    let track = Rectangle.xywh(bx, track_y, bw, track_height);
                    let fill = Rectangle.xywh(bx, track_y, fill_width, track_height);
                    var track_path = Path.roundedRect(track, track_radius, 3);
                    out = out.drawPath(&track_path, Paint.fill(node.color));
                    if (ratio > zero) {
                        var fill_path = Path.roundedRect(fill, track_radius, 3);
                        out = out.drawPath(&fill_path, Paint.fill(node.text_color));
                        fill_path.destroy();
                    }
                    if (node.stroke_width > zero) {
                        out = out.drawPath(&track_path, Paint.stroke(node.stroke_color, node.stroke_width));
                    }
                    track_path.destroy();
                } else if (node.kind == uiNodeCheckbox()) {
                    let box_size = 18.0 as f32;
                    let box_x = node.bounds.x + node.padding - 24.0;
                    let box_y = node.bounds.y + ((node.bounds.height - box_size) * 0.5);
                    let box_rect = Rectangle.xywh(box_x, box_y, box_size, box_size);
                    var box_path = Path.roundedRect(box_rect, 3.0, 3);
                    if (node.checked) {
                        out = out.drawPath(&box_path, Paint.fill(node.color));
                        if (node.stroke_width > 0.0) {
                            out = out.drawPath(&box_path, Paint.stroke(node.stroke_color, node.stroke_width));
                        }
                        let tick_a = Point.xy(box_x + 4.0, box_y + 9.0);
                        let tick_b = Point.xy(box_x + 8.0, box_y + 13.0);
                        let tick_c = Point.xy(box_x + 14.0, box_y + 5.0);
                        out = out.drawLine(tick_a, tick_b, Paint.strokeRound(node.text_color, 2.0));
                        out = out.drawLine(tick_b, tick_c, Paint.strokeRound(node.text_color, 2.0));
                    } else {
                        if (node.color.a > 0.0) {
                            out = out.drawPath(&box_path, Paint.fill(node.color));
                        }
                        if (node.stroke_width > 0.0) {
                            out = out.drawPath(&box_path, Paint.stroke(node.stroke_color, node.stroke_width));
                        }
                    }
                    box_path.destroy();
                } else if (node.kind == uiNodeProgress()) {
                    let zero = 0.0 as f32;
                    let one = 1.0 as f32;
                    let half = 0.5 as f32;
                    let track_height = 6.0 as f32;
                    let track_radius = 3.0 as f32;
                    let bx = node.bounds.x;
                    let by = node.bounds.y;
                    let bw = node.bounds.width;
                    let bh = node.bounds.height;
                    var span: f32 = node.max_value - node.min_value;
                    if (span <= zero) { span = one; }
                    var ratio: f32 = (node.value - node.min_value) / span;
                    if (ratio < zero) { ratio = zero; }
                    if (ratio > one) { ratio = one; }
                    let track_y: f32 = by + (bh * half) - track_radius;
                    let fill_width: f32 = bw * ratio;
                    let track = Rectangle.xywh(bx, track_y, bw, track_height);
                    let fill = Rectangle.xywh(bx, track_y, fill_width, track_height);
                    var track_path = Path.roundedRect(track, track_radius, 3);
                    out = out.drawPath(&track_path, Paint.fill(node.color));
                    if (ratio > zero) {
                        var fill_path = Path.roundedRect(fill, track_radius, 3);
                        out = out.drawPath(&fill_path, Paint.fill(node.text_color));
                        fill_path.destroy();
                    }
                    if (node.stroke_width > zero) {
                        out = out.drawPath(&track_path, Paint.stroke(node.stroke_color, node.stroke_width));
                    }
                    track_path.destroy();
                } else if (node.kind == uiNodeRoot() || node.kind == uiNodePanel() || node.kind == uiNodeScroll() || node.kind == uiNodeButton() || node.kind == uiNodeToggle() || node.kind == uiNodeTextInput()) {
                    let cp = to_rawptr(&node.color);
                    let ca = typesLoadF32(cp + 12);
                    let bp = to_rawptr(&node.bounds);
                    var br: Rectangle;
                    br.x = typesLoadF32(bp);
                    br.y = typesLoadF32(bp + 4);
                    br.width = typesLoadF32(bp + 8);
                    br.height = typesLoadF32(bp + 12);
                    var fill_c: Color;
                    fill_c.r = typesLoadF32(cp);
                    fill_c.g = typesLoadF32(cp + 4);
                    fill_c.b = typesLoadF32(cp + 8);
                    fill_c.a = ca;
                    let sp = to_rawptr(&node.stroke_color);
                    var stroke_c: Color;
                    stroke_c.r = typesLoadF32(sp);
                    stroke_c.g = typesLoadF32(sp + 4);
                    stroke_c.b = typesLoadF32(sp + 8);
                    stroke_c.a = typesLoadF32(sp + 12);
                    if (node.elevation > 0.0) {
                        var shadow_alpha = 0.08 + (node.elevation * 0.02);
                        if (shadow_alpha > 0.24) { shadow_alpha = 0.24; }
                        let shadow_color = Color.rgba(0.0, 0.0, 0.0, shadow_alpha);
                        let shadow_blur = (node.elevation * 1.5) + 1.0;
                        let shadow_offset = node.elevation * 0.5;
                        if (node.corner_radius > 0.0) {
                            var shadow_path = Path.roundedRect(br, node.corner_radius, 4);
                            out = out.drawShadowPath(&shadow_path, 0.0, shadow_offset, shadow_blur, shadow_color);
                            shadow_path.destroy();
                        } else {
                            out = out.drawShadowRect(br, 0.0, shadow_offset, shadow_blur, shadow_color);
                        }
                    }
                    if (node.corner_radius > 0.0) {
                        var box_path = Path.roundedRect(br, node.corner_radius, 4);
                        if (ca > 0.0) {
                            out = out.drawPath(&box_path, Paint.fill(fill_c));
                        }
                        if (node.stroke_width > 0.0) {
                            out = out.drawPath(&box_path, Paint.stroke(stroke_c, node.stroke_width));
                        }
                        box_path.destroy();
                    } else {
                        if (ca > 0.0) {
                            out = out.drawRect(br, Paint.fill(fill_c));
                        }
                        if (node.stroke_width > 0.0) {
                            out = out.drawRect(br, Paint.stroke(stroke_c, node.stroke_width));
                        }
                    }
                    let op = to_rawptr(&node.overlay_color);
                    let oa = typesLoadF32(op + 12);
                    if (oa > 0.0) {
                        var overlay_c: Color;
                        overlay_c.r = typesLoadF32(op);
                        overlay_c.g = typesLoadF32(op + 4);
                        overlay_c.b = typesLoadF32(op + 8);
                        overlay_c.a = oa;
                        if (node.corner_radius > 0.0) {
                            var overlay_path = Path.roundedRect(br, node.corner_radius, 4);
                            out = out.drawPath(&overlay_path, Paint.fill(overlay_c));
                            overlay_path.destroy();
                        } else {
                            out = out.drawRect(br, Paint.fill(overlay_c));
                        }
                    }
                }
            }
            i = i + 1;
        }
        return out;
    }

    public fn renderText(&self, scene: SceneBuilder, font: &FontFace, cache: &mut GlyphCache) -> Result<SceneBuilder, Error> {
        var out = scene;
        var i: i32 = 0;
        while (i < (self.nodes.len as i32)) {
            let node = self.nodes.get(i as i64);
            if (node.visible && (node.text.len > 0 || node.placeholder.len > 0 || node.composition_text.len > 0 || node.caret_visible)) {
                let is_text_input = node.kind == uiNodeTextInput();
                let has_composition = is_text_input && node.composition_text.len > 0;
                var display = node.text;
                if (has_composition) { display = display + node.composition_text; }
                if (display.len == 0 && !has_composition) { display = node.placeholder; }
                var x = node.bounds.x + node.padding;
                var y = node.bounds.y + node.padding + (18.0 as f32);
                var advance: f32 = 0.0;
                var caret_advance: f32 = 0.0;
                var composition_start_advance: f32 = 0.0;
                var needs_align = node.text_align != uiTextAlignLeft();
                if (node.kind == uiNodeButton() || node.kind == uiNodeToggle()) { needs_align = true; }
                if ((needs_align || is_text_input) && display.len > 0) {
                    match (font.shape(display)) {
                        case Ok(layout) => {
                            advance = layout.advance_x as f32;
                            layout.destroy();
                        }
                        case Err(_) => {}
                    }
                }
                if (is_text_input) {
                    var caret_text = node.text;
                    if (has_composition) { caret_text = caret_text + uiTextPrefixForUtf8Chars(node.composition_text, node.composition_start); }
                    if (caret_text.len > 0) {
                        match (font.shape(caret_text)) {
                            case Ok(caret_layout) => {
                                caret_advance = caret_layout.advance_x as f32;
                                caret_layout.destroy();
                            }
                            case Err(_) => {}
                        }
                    }
                    if (has_composition && node.text.len > 0) {
                        match (font.shape(node.text)) {
                            case Ok(prefix_layout) => {
                                composition_start_advance = prefix_layout.advance_x as f32;
                                prefix_layout.destroy();
                            }
                            case Err(_) => {}
                        }
                    }
                }
                if (node.kind == uiNodeButton() || node.kind == uiNodeToggle()) {
                    y = node.bounds.y + (node.bounds.height * 0.5) + (7.0 as f32);
                    if (advance > 0.0) {
                        x = node.bounds.x + ((node.bounds.width - advance) * 0.5);
                        if (x < node.bounds.x + node.padding) { x = node.bounds.x + node.padding; }
                    }
                } else if (node.kind == uiNodeTextInput() || node.kind == uiNodeCheckbox()) {
                    y = node.bounds.y + (node.bounds.height * 0.5) + (7.0 as f32);
                } else if (node.text_align == uiTextAlignCenter() && advance > 0.0) {
                    x = node.bounds.x + ((node.bounds.width - advance) * 0.5);
                    y = node.bounds.y + (node.bounds.height * 0.5) + (7.0 as f32);
                } else if (node.text_align == uiTextAlignRight() && advance > 0.0) {
                    x = node.bounds.x + node.bounds.width - node.padding - advance;
                }
                if (display.len > 0) {
                    match (out.drawText(font, cache, display, x, y, Paint.fill(node.text_color))) {
                        case Ok(v) => { out = v; }
                        case Err(e) => { return Err(e); }
                    }
                }
                if (is_text_input && has_composition) {
                    let underline_y = y + 3.0;
                    var underline_x0 = x + composition_start_advance;
                    var underline_x1 = x + advance;
                    let max_x = node.bounds.x + node.bounds.width - node.padding;
                    if (underline_x0 > max_x) { underline_x0 = max_x; }
                    if (underline_x1 > max_x) { underline_x1 = max_x; }
                    if (underline_x1 > underline_x0) {
                        out = out.drawLine(Point.xy(underline_x0, underline_y), Point.xy(underline_x1, underline_y), Paint.strokeRound(node.caret_color, 1.5));
                    }
                }
                if (is_text_input && node.caret_visible) {
                    var caret_x = x + caret_advance;
                    let min_caret_x = node.bounds.x + node.padding;
                    let max_caret_x = node.bounds.x + node.bounds.width - node.padding;
                    if (caret_x < min_caret_x) { caret_x = min_caret_x; }
                    if (caret_x > max_caret_x) { caret_x = max_caret_x; }
                    let caret_top = node.bounds.y + 9.0;
                    let caret_bottom = node.bounds.y + node.bounds.height - 9.0;
                    out = out.drawLine(Point.xy(caret_x, caret_top), Point.xy(caret_x, caret_bottom), Paint.strokeRound(node.caret_color, 2.0));
                }
            }
            i = i + 1;
        }
        return Ok(out);
    }

    public fn destroy(&mut self) {
        var custom_view_i: i32 = 0;
        while (custom_view_i < (self.custom_views.len as i32)) {
            self.custom_views.get(custom_view_i as i64).drop();
            custom_view_i = custom_view_i + 1;
        }
        self.custom_views.destroy();
        self.nodes.destroy();
    }
}
