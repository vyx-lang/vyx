public fn uiNodeRoot() -> i32 { return 0; }
public fn uiNodePanel() -> i32 { return 1; }
public fn uiNodeText() -> i32 { return 2; }
public fn uiNodeButton() -> i32 { return 3; }
public fn uiNodeSpacer() -> i32 { return 4; }
public fn uiNodeToggle() -> i32 { return 5; }
public fn uiNodeTextInput() -> i32 { return 6; }
public fn uiNodeSlider() -> i32 { return 7; }
public fn uiNodeCheckbox() -> i32 { return 8; }
public fn uiNodeProgress() -> i32 { return 9; }
public fn uiNodeCustom() -> i32 { return 10; }
public fn uiNodeRender() -> i32 { return 11; }
public fn uiNodeScroll() -> i32 { return 12; }
public fn uiLayoutVertical() -> i32 { return 0; }
public fn uiLayoutHorizontal() -> i32 { return 1; }
public fn uiTextAlignLeft() -> i32 { return 1; }
public fn uiTextAlignCenter() -> i32 { return 2; }
public fn uiTextAlignRight() -> i32 { return 3; }

public fn uiTextNextUtf8Boundary(text: string, index: i64) -> i64 {
    if (index >= text.len) { return text.len; }
    let c = text.charAt(index as i32);
    var step: i64 = 1;
    if (c >= 240) {
        step = 4;
    } else if (c >= 224) {
        step = 3;
    } else if (c >= 192) {
        step = 2;
    }
    let next = index + step;
    if (next > text.len) { return text.len; }
    return next;
}

public fn uiTextByteIndexForUtf8Chars(text: string, char_count: i32) -> i64 {
    if (char_count < 0) { return text.len; }
    var index: i64 = 0;
    var chars: i32 = 0;
    while (index < text.len && chars < char_count) {
        index = uiTextNextUtf8Boundary(text, index);
        chars = chars + 1;
    }
    return index;
}

public fn uiTextUtf8CharCount(text: string) -> i32 {
    var index: i64 = 0;
    var chars: i32 = 0;
    while (index < text.len) {
        index = uiTextNextUtf8Boundary(text, index);
        chars = chars + 1;
    }
    return chars;
}

public fn uiTextPrefixForUtf8Chars(text: string, char_count: i32) -> string {
    let end_index = uiTextByteIndexForUtf8Chars(text, char_count);
    return text.substring(0, end_index);
}

