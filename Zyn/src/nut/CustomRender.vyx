module Zyn.Nut.CustomRender;

use Device = std.cacao.Device;
use CommandEncoder = std.cacao.CommandEncoder;
use ShaderCompiler = std.cacao.ShaderCompiler;
use Texture = std.cacao.Texture;
use Error = Zyn.Nut.Types.Error;

// The renderer owns the command encoder and output texture. Implementations
// may record Cacao commands and keep their own resources, but must not submit,
// present, reset or destroy any of the borrowed frame objects.
public interface CustomRenderHandler {
    fn render(&mut self, device: &Device, compiler: &ShaderCompiler, encoder: &mut CommandEncoder,
              output: &Texture, width: u32, height: u32) -> Result<i32, Error>;
    fn release(&mut self);
}
