    public fn commandCount(&self) -> i32 {
        return self.command_count;
    }

    public fn drawCommandCount(&self) -> i32 {
        return self.draw_command_count;
    }

    public fn estimatedVertexCount(&self) -> i32 {
        return self.vertex_estimate;
    }

    public fn isEmpty(&self) -> bool {
        return self.command_count == 0;
    }

    public fn hasClear(&self) -> bool {
        return self.has_clear_command;
    }

    public fn clearColor(&self) -> Color {
        return self.clear_color;
    }

    public fn commandAt(&self, index: i32) -> RenderCommand {
        var out: RenderCommand;
        memcpy(to_rawptr(&out), self.commands.data + ((index as i64) * sizeof::<RenderCommand>()), sizeof::<RenderCommand>() as i64);
        return out;
    }

    public fn clipPathPoint(&self, offset: i32, point_index: i32) -> Point {
        let command = self.commandAt(offset + point_index);
        return Point.xy(command.line.x0, command.line.y0);
    }

    public fn clipPathTransformedBounds(&self, offset: i32, count: i32, transform: Transform2D) -> Rectangle {
        if (count <= 0) { return Rectangle.xywh(0.0, 0.0, 0.0, 0.0); }
        let first = transform.transformPoint(self.clipPathPoint(offset, 0));
        var x0 = first.x;
        var y0 = first.y;
        var x1 = first.x;
        var y1 = first.y;
        var i: i32 = 1;
        while (i < count) {
            let point = transform.transformPoint(self.clipPathPoint(offset, i));
            if (point.x < x0) { x0 = point.x; }
            if (point.y < y0) { y0 = point.y; }
            if (point.x > x1) { x1 = point.x; }
            if (point.y > y1) { y1 = point.y; }
            i = i + 1;
        }
        return Rectangle.xywh(x0, y0, x1 - x0, y1 - y0);
    }

    public fn clipPathContains(&self, offset: i32, count: i32, transform: Transform2D, point: Point) -> bool {
        var ptx: f32 = 0.0;
        var pty: f32 = 0.0;
        let pbase = to_rawptr(&point);
        memcpy(to_rawptr(&ptx), pbase, sizeof::<f32>() as i64);
        memcpy(to_rawptr(&pty), pbase + 4, sizeof::<f32>() as i64);
        if (count < 3) { return false; }
        if (!self.clipPathTransformedBounds(offset, count, transform).contains(Point.xy(ptx, pty))) { return false; }
        var inside = false;
        var j = count - 1;
        var i: i32 = 0;
        while (i < count) {
            let pi = renderGraphUnpackPoint(transform.transformPoint(self.clipPathPoint(offset, i)));
            let pj = renderGraphUnpackPoint(transform.transformPoint(self.clipPathPoint(offset, j)));
            if (renderGraphPointOnSegment(Point.xy(ptx, pty), pj, pi)) { return true; }
            var piy: f32 = 0.0;
            var pjy: f32 = 0.0;
            var pix: f32 = 0.0;
            var pjx: f32 = 0.0;
            let ibase = to_rawptr(&pi);
            let jbase = to_rawptr(&pj);
            memcpy(to_rawptr(&pix), ibase, sizeof::<f32>() as i64);
            memcpy(to_rawptr(&piy), ibase + 4, sizeof::<f32>() as i64);
            memcpy(to_rawptr(&pjx), jbase, sizeof::<f32>() as i64);
            memcpy(to_rawptr(&pjy), jbase + 4, sizeof::<f32>() as i64);
            if ((piy > pty) != (pjy > pty)) {
                let dy = pjy - piy;
                var x: f32 = pix;
                if (dy != (0.0 as f32)) {
                    x = ((pjx - pix) * (pty - piy) / dy) + pix;
                }
                if (ptx < x) { inside = !inside; }
            }
            j = i;
            i = i + 1;
        }
        return inside;
    }

    public fn clipBalance(&self) -> i32 {
        var depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 6) || (rgLoadI32(to_rawptr(&command)) == 16)) {
                depth = depth + 1;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 7)) {
                if (depth == 0) { return -1; }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return depth;
    }

    public fn transformBalance(&self) -> i32 {
        var depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 11)) {
                depth = depth + 1;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 12)) {
                if (depth == 0) { return -1; }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return depth;
    }

    public fn layerBalance(&self) -> i32 {
        var depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 14)) {
                depth = depth + 1;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 15)) {
                if (depth == 0) { return -1; }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return depth;
    }

    public fn isBalanced(&self) -> bool {
        return self.clipBalance() == 0 && self.transformBalance() == 0 && self.layerBalance() == 0;
    }

    public fn maxClipDepth(&self) -> i32 {
        var depth: i32 = 0;
        var max_depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 6) || (rgLoadI32(to_rawptr(&command)) == 16)) {
                depth = depth + 1;
                if (depth > max_depth) { max_depth = depth; }
            }
            if ((rgLoadI32(to_rawptr(&command)) == 7) && depth > 0) {
                depth = depth - 1;
            }
            i = i + 1;
        }
        return max_depth;
    }

    public fn maxClipPathDepth(&self) -> i32 {
        var depth: i32 = 0;
        var max_depth: i32 = 0;
        var clip_kinds = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 6)) {
                clip_kinds.push(0);
            }
            if ((rgLoadI32(to_rawptr(&command)) == 16)) {
                clip_kinds.push(1);
                depth = depth + 1;
                if (depth > max_depth) { max_depth = depth; }
            }
            if ((rgLoadI32(to_rawptr(&command)) == 7)) {
                if (!clip_kinds.isEmpty()) {
                    let kind = clip_kinds.pop();
                    if (kind == 1 && depth > 0) {
                        depth = depth - 1;
                    }
                } else {
                    depth = 0;
                }
            }
            i = i + 1;
        }
        clip_kinds.destroy();
        return max_depth;
    }

    public fn maxTransformDepth(&self) -> i32 {
        var depth: i32 = 0;
        var max_depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 11)) {
                depth = depth + 1;
                if (depth > max_depth) { max_depth = depth; }
            }
            if ((rgLoadI32(to_rawptr(&command)) == 12) && depth > 0) {
                depth = depth - 1;
            }
            i = i + 1;
        }
        return max_depth;
    }

    public fn maxLayerDepth(&self) -> i32 {
        var depth: i32 = 0;
        var max_depth: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 14)) {
                depth = depth + 1;
                if (depth > max_depth) { max_depth = depth; }
            }
            if ((rgLoadI32(to_rawptr(&command)) == 15) && depth > 0) {
                depth = depth - 1;
            }
            i = i + 1;
        }
        return max_depth;
    }

    public fn clipRectCommandCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 6)) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn clipPathCommandCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 16)) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn validate(&self) -> Result<i32, Error> {
        var clip_depth: i32 = 0;
        var transform_depth: i32 = 0;
        var layer_depth: i32 = 0;
        var pending_clip_path_points: i32 = 0;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            var ck: i32 = 0;
            command.writeKindValue(to_rawptr(&ck));
            if (ck == 17) {
                if (pending_clip_path_points <= 0) {
                    return Err(Error.create(176, "RenderGraph clip path command stream is malformed"));
                }
                pending_clip_path_points = pending_clip_path_points - 1;
                i = i + 1;
                continue;
            }
            if (pending_clip_path_points > 0) {
                return Err(Error.create(176, "RenderGraph clip path command stream is malformed"));
            }
            if (ck == 6 || ck == 16) {
                if (ck == 16) {
                    var stroke: f32 = 0.0;
                    var rect_x: f32 = 0.0;
                    command.writeStrokeWidth(to_rawptr(&stroke));
                    command.writeRectX(to_rawptr(&rect_x));
                    let path_offset = stroke as i32;
                    let path_count = rect_x as i32;
                    if (path_count < 3 || path_offset != (i + 1) || (path_offset + path_count) > self.command_count) {
                        return Err(Error.create(176, "RenderGraph clip path command stream is malformed"));
                    }
                    var path_i: i32 = 0;
                    while (path_i < path_count) {
                        let path_command = self.commandAt(path_offset + path_i);
                        var pk: i32 = 0;
                        path_command.writeKindValue(to_rawptr(&pk));
                        if (pk != 17) {
                            return Err(Error.create(176, "RenderGraph clip path command stream is malformed"));
                        }
                        path_i = path_i + 1;
                    }
                    pending_clip_path_points = path_count;
                }
                clip_depth = clip_depth + 1;
            }
            if (ck == 7) {
                if (clip_depth == 0) { return Err(Error.create(170, "RenderGraph clip stack underflow")); }
                clip_depth = clip_depth - 1;
            }
            if (ck == 11) {
                transform_depth = transform_depth + 1;
            }
            if (ck == 12) {
                if (transform_depth == 0) { return Err(Error.create(171, "RenderGraph transform stack underflow")); }
                transform_depth = transform_depth - 1;
            }
            if (ck == 14) {
                layer_depth = layer_depth + 1;
            }
            if (ck == 15) {
                if (layer_depth == 0) { return Err(Error.create(172, "RenderGraph layer stack underflow")); }
                layer_depth = layer_depth - 1;
            }
            if (ck == 18) {
                var stroke: f32 = 0.0;
                command.writeStrokeWidth(to_rawptr(&stroke));
                if ((stroke as i32) < 0) {
                    return Err(Error.create(177, "RenderGraph pipeline id must be non-negative"));
                }
            }
            if (ck == 19 && command.external_slot < 0) {
                return Err(Error.create(178, "RenderGraph external view slot id must be non-negative"));
            }
            i = i + 1;
        }
        if (clip_depth != 0) { return Err(Error.create(173, "RenderGraph clip stack has unclosed entries")); }
        if (transform_depth != 0) { return Err(Error.create(174, "RenderGraph transform stack has unclosed entries")); }
        if (layer_depth != 0) { return Err(Error.create(175, "RenderGraph layer stack has unclosed entries")); }
        return Ok(0);
    }

    public fn hasDrawBounds(&self) -> bool {
        return self.draw_command_count > 0;
    }

    public fn drawBounds(&self) -> Rectangle {
        var out = Rectangle.xywh(0.0, 0.0, 0.0, 0.0);
        var has_bounds = false;
        var transform_stack = Vec::<Transform2D>.new();
        var clip_stack = Vec::<RenderGraphClipState>.new();
        var layer_stack = Vec::<f32>.new();
        var current_transform = Transform2D.identity();
        var current_clip = RenderGraphClipState.none();
        var current_alpha = 1.0 as f32;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 11)) {
                transform_stack.push(copyTransform(current_transform));
                current_transform = current_transform.multiply(command.transform);
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 12)) {
                if (!transform_stack.isEmpty()) {
                    current_transform = transform_stack.pop();
                } else {
                    current_transform = Transform2D.identity();
                }
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 6)) {
                clip_stack.push(renderGraphClipClone(to_rawptr(&current_clip)));
                current_clip = renderGraphClipIntersectRect(current_clip, renderGraphTransformRect(command.rect, current_transform));
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 16)) {
                clip_stack.push(renderGraphClipClone(to_rawptr(&current_clip)));
                let clip_path_offset = command.stroke_width as i32;
                let clip_path_count = command.rect.x as i32;
                current_clip = renderGraphClipIntersectPath(current_clip, clip_path_offset, clip_path_count, self.clipPathTransformedBounds(clip_path_offset, clip_path_count, current_transform), current_transform);
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 7)) {
                if (!clip_stack.isEmpty()) {
                    current_clip = clip_stack.pop();
                } else {
                    current_clip = RenderGraphClipState.none();
                }
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 14)) {
                layer_stack.push(current_alpha);
                current_alpha = current_alpha * command.color.a;
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 15)) {
                if (!layer_stack.isEmpty()) {
                    current_alpha = layer_stack.pop();
                } else {
                    current_alpha = 1.0 as f32;
                }
                i = i + 1;
                continue;
            }

            var command_bounds = Rectangle.xywh(0.0, 0.0, 0.0, 0.0);
            var command_has_bounds = false;
            if (current_alpha > (0.0 as f32) && ((rgLoadI32(to_rawptr(&command)) == 2) || (rgLoadI32(to_rawptr(&command)) == 10) || (rgLoadI32(to_rawptr(&command)) == 19))) {
                command_bounds = renderGraphTransformRect(command.rect, current_transform);
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 5)) {
                command_bounds = renderGraphTransformRect(command.rect.inflate(command.stroke_width / (2.0 as f32), command.stroke_width / (2.0 as f32)), current_transform);
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 3)) {
                command_bounds = renderGraphTransformRect(Rectangle.xywh(command.circle.x - command.circle.radius, command.circle.y - command.circle.radius, command.circle.radius * (2.0 as f32), command.circle.radius * (2.0 as f32)), current_transform);
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 8)) {
                command_bounds = renderGraphTriangleBounds(command.triangle, current_transform);
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 9)) {
                command_bounds = renderGraphQuadBounds(command.quad.transform(current_transform));
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 13)) {
                command_bounds = renderGraphTransformRect(command.sprite.dest, current_transform);
                command_has_bounds = true;
            }
            if (current_alpha > (0.0 as f32) && (rgLoadI32(to_rawptr(&command)) == 4)) {
                command_bounds = renderGraphLineBounds(command.line, current_transform);
                command_has_bounds = true;
            }
            if (command_has_bounds) {
                if (current_clip.has_clip) {
                    command_bounds = command_bounds.intersect(renderGraphClipAsRect(renderGraphClipClone(to_rawptr(&current_clip))));
                    if (!command_bounds.isDrawable()) {
                        command_has_bounds = false;
                    }
                }
            }
            if (command_has_bounds) {
                if (has_bounds) {
                    out = out.union(command_bounds);
                } else {
                    out = command_bounds;
                    has_bounds = true;
                }
            }
            i = i + 1;
        }
        layer_stack.destroy();
        clip_stack.destroy();
        transform_stack.destroy();
        return out;
    }

    public fn hitTest(&self, point: Point) -> i32 {
        if (!self.isBalanced()) { return -1 as i32; }
        var hit_index: i32 = -1 as i32;
        var transform_stack = Vec::<Transform2D>.new();
        var clip_stack = Vec::<RenderGraphClipState>.new();
        var clip_path_stack = Vec::<RenderGraphClipPathState>.new();
        var clip_path_depth_stack = Vec::<i32>.new();
        var layer_stack = Vec::<f32>.new();
        var current_transform = Transform2D.identity();
        var current_clip = RenderGraphClipState.none();
        var current_alpha = 1.0 as f32;
        var i: i32 = 0;
        while (i < self.command_count) {
            let command = self.commandAt(i);
            if ((rgLoadI32(to_rawptr(&command)) == 11)) {
                transform_stack.push(copyTransform(current_transform));
                current_transform = current_transform.multiply(command.transform);
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 12)) {
                if (!transform_stack.isEmpty()) {
                    current_transform = transform_stack.pop();
                } else {
                    current_transform = Transform2D.identity();
                }
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 6)) {
                clip_stack.push(renderGraphClipClone(to_rawptr(&current_clip)));
                clip_path_depth_stack.push(clip_path_stack.len as i32);
                current_clip = renderGraphClipIntersectRect(current_clip, renderGraphTransformRect(command.rect, current_transform));
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 16)) {
                clip_stack.push(renderGraphClipClone(to_rawptr(&current_clip)));
                clip_path_depth_stack.push(clip_path_stack.len as i32);
                let clip_path_offset = command.stroke_width as i32;
                let clip_path_count = command.rect.x as i32;
                current_clip = renderGraphClipIntersectPath(current_clip, clip_path_offset, clip_path_count, self.clipPathTransformedBounds(clip_path_offset, clip_path_count, current_transform), current_transform);
                clip_path_stack.push(RenderGraphClipPathState.create(clip_path_offset, clip_path_count, current_transform));
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 7)) {
                if (!clip_stack.isEmpty()) {
                    current_clip = clip_stack.pop();
                } else {
                    current_clip = RenderGraphClipState.none();
                }
                if (!clip_path_depth_stack.isEmpty()) {
                    let saved_path_depth = clip_path_depth_stack.pop();
                    while ((clip_path_stack.len as i32) > saved_path_depth) {
                        clip_path_stack.pop();
                    }
                } else {
                    clip_path_stack.clear();
                }
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 14)) {
                layer_stack.push(current_alpha);
                current_alpha = current_alpha * command.color.a;
                i = i + 1;
                continue;
            }
            if ((rgLoadI32(to_rawptr(&command)) == 15)) {
                if (!layer_stack.isEmpty()) {
                    current_alpha = layer_stack.pop();
                } else {
                    current_alpha = 1.0 as f32;
                }
                i = i + 1;
                continue;
            }
            if (current_alpha > (0.0 as f32) && renderGraphClipContains(to_rawptr(&current_clip), point)) {
                var inside_all_clip_paths = true;
                var clip_path_i: i32 = 0;
                while (clip_path_i < (clip_path_stack.len as i32) && inside_all_clip_paths) {
                    let clip_path = clip_path_stack.get(clip_path_i as i64);
                    if (!self.clipPathContains(clip_path.offset, clip_path.count, clip_path.transform, point)) {
                        inside_all_clip_paths = false;
                    }
                    clip_path_i = clip_path_i + 1;
                }
                if (!inside_all_clip_paths) {
                    i = i + 1;
                    continue;
                }
                var inverse: Transform2D;
                match (current_transform.inverse()) {
                    case Ok(v) => { inverse = v; }
                    case Err(_) => {
                        i = i + 1;
                        continue;
                    }
                }
                let local_point = inverse.transformPoint(point);
                if (renderGraphCommandHit(command, local_point)) {
                    hit_index = i;
                }
            }
            i = i + 1;
        }
        layer_stack.destroy();
        clip_path_depth_stack.destroy();
        clip_path_stack.destroy();
        clip_stack.destroy();
        transform_stack.destroy();
        return hit_index;
    }

    public fn containsPoint(&self, point: Point) -> bool {
        return self.hitTest(point) >= (0 as i32);
    }

    public fn clone(&self) -> RenderGraph {
        var out = RenderGraph.create();
        var i: i32 = 0;
        while (i < self.command_count) {
            out = out.submit(self.commandAt(i));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.commands.destroy();
        self.command_count = 0;
        self.draw_command_count = 0;
        self.vertex_estimate = 0;
        self.has_clear_command = false;
    }
}
