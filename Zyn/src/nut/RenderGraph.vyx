    public fn usePipelineConstants4f(mut self, pipeline_id: i32, x: f32, y: f32, z: f32, w: f32) -> RenderGraph {
        return self.submit(RenderCommand.usePipelineConstants4f(pipeline_id, x, y, z, w));
