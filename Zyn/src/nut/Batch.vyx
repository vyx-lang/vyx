module Zyn.Nut.Batch;

use Zyn.Nut.Types;
use Sprite = Zyn.Nut.Atlas.Sprite;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn sqrt(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

fn pi() -> f64 {
    return 3.14159265358979323846;
}

public class SolidVertex {
    public x: f32;
    public y: f32;
    public r: f32;
    public g: f32;
    public b: f32;
    public a: f32;

    public static fn create(x: f32, y: f32, color: Color) -> SolidVertex {
        return SolidVertex { x: x, y: y, r: color.r, g: color.g, b: color.b, a: color.a };
    }
}

public class SolidBatch {
    public data: rawptr;
    public capacity: i32;
    public vertex_count: i32;
    public rect_count: i32;
    private overflowed: bool;

    public static fn create(vertex_capacity: i32) -> SolidBatch {
        var cap = vertex_capacity;
        if (cap < 6) { cap = 6; }
        return SolidBatch {
            data: malloc((cap as i64) * sizeof::<SolidVertex>()),
            capacity: cap,
            vertex_count: 0,
            rect_count: 0,
            overflowed: false
        };
    }

    private fn pushVertex(&mut self, vertex: SolidVertex) -> bool {
        if (self.data == null) { self.overflowed = true; return false; }
        if (self.vertex_count >= self.capacity) { self.overflowed = true; return false; }
        memcpy(self.data + ((self.vertex_count as i64) * sizeof::<SolidVertex>()), to_rawptr(&vertex), sizeof::<SolidVertex>());
        self.vertex_count = self.vertex_count + 1;
        return true;
    }

    private fn reserveVertices(&mut self, count: i32) -> bool {
        if (self.data == null) { self.overflowed = true; return false; }
        if ((self.vertex_count + count) > self.capacity) { self.overflowed = true; return false; }
        return true;
    }

    private fn toClipX(&self, x: f32, framebuffer_width: f32) -> f32 {
        return ((x / framebuffer_width) * (2.0 as f32)) - (1.0 as f32);
    }

    private fn toClipY(&self, y: f32, framebuffer_height: f32) -> f32 {
        return ((y / framebuffer_height) * (2.0 as f32)) - (1.0 as f32);
    }

    public fn addTriangle(&mut self, a: Point, b: Point, c: Point, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!self.reserveVertices(3)) { return; }
        self.pushVertex(SolidVertex.create(self.toClipX(a.x, framebuffer_width), self.toClipY(a.y, framebuffer_height), color));
        self.pushVertex(SolidVertex.create(self.toClipX(b.x, framebuffer_width), self.toClipY(b.y, framebuffer_height), color));
        self.pushVertex(SolidVertex.create(self.toClipX(c.x, framebuffer_width), self.toClipY(c.y, framebuffer_height), color));
    }

    public fn addTriangleGradient(&mut self, a: Point,
                                  b: Point,
                                  c: Point,
                                  ca: Color,
                                  cb: Color,
                                  cc: Color,
                                  framebuffer_width: f32,
                                  framebuffer_height: f32) {
        if (!self.reserveVertices(3)) { return; }
        self.pushVertex(SolidVertex.create(self.toClipX(a.x, framebuffer_width), self.toClipY(a.y, framebuffer_height), ca));
        self.pushVertex(SolidVertex.create(self.toClipX(b.x, framebuffer_width), self.toClipY(b.y, framebuffer_height), cb));
        self.pushVertex(SolidVertex.create(self.toClipX(c.x, framebuffer_width), self.toClipY(c.y, framebuffer_height), cc));
    }

    public fn addQuad(&mut self, quad: Quad, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!quad.isDrawable()) { return; }
        if (!self.reserveVertices(6)) { return; }
        self.addTriangle(quad.p0, quad.p1, quad.p2, color, framebuffer_width, framebuffer_height);
        self.addTriangle(quad.p2, quad.p3, quad.p0, color, framebuffer_width, framebuffer_height);
        self.rect_count = self.rect_count + 1;
    }

    public fn addQuadGradient(&mut self, quad: Quad,
                              c0: Color,
                              c1: Color,
                              c2: Color,
                              c3: Color,
                              framebuffer_width: f32,
                              framebuffer_height: f32) {
        if (!quad.isDrawable()) { return; }
        if (!self.reserveVertices(6)) { return; }
        self.addTriangleGradient(quad.p0, quad.p1, quad.p2, c0, c1, c2, framebuffer_width, framebuffer_height);
        self.addTriangleGradient(quad.p2, quad.p3, quad.p0, c2, c3, c0, framebuffer_width, framebuffer_height);
        self.rect_count = self.rect_count + 1;
    }

    public fn addRect(&mut self, rect: Rectangle, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!rect.isDrawable()) { return; }
        if (!self.reserveVertices(6)) { return; }
        let right = rect.right();
        let bottom = rect.bottom();
        let x0 = self.toClipX(rect.x, framebuffer_width);
        let y0 = self.toClipY(rect.y, framebuffer_height);
        let x1 = self.toClipX(right, framebuffer_width);
        let y1 = self.toClipY(bottom, framebuffer_height);

        self.pushVertex(SolidVertex { x: x0, y: y0, r: color.r, g: color.g, b: color.b, a: color.a });
        self.pushVertex(SolidVertex { x: x0, y: y1, r: color.r, g: color.g, b: color.b, a: color.a });
        self.pushVertex(SolidVertex { x: x1, y: y0, r: color.r, g: color.g, b: color.b, a: color.a });
        self.pushVertex(SolidVertex { x: x1, y: y0, r: color.r, g: color.g, b: color.b, a: color.a });
        self.pushVertex(SolidVertex { x: x0, y: y1, r: color.r, g: color.g, b: color.b, a: color.a });
        self.pushVertex(SolidVertex { x: x1, y: y1, r: color.r, g: color.g, b: color.b, a: color.a });
        self.rect_count = self.rect_count + 1;
    }

    public fn addGradientRect(&mut self, rect: Rectangle, gradient: LinearGradient, framebuffer_width: f32, framebuffer_height: f32) {
        if (!rect.isDrawable()) { return; }
        if (gradient.vertical) {
            self.addQuadGradient(Quad.fromRect(rect), gradient.start, gradient.start, gradient.end, gradient.end, framebuffer_width, framebuffer_height);
        } else {
            self.addQuadGradient(Quad.fromRect(rect), gradient.start, gradient.end, gradient.end, gradient.start, framebuffer_width, framebuffer_height);
        }
    }

    public fn addCircle(&mut self, circle: Circle, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!circle.isDrawable()) { return; }
        let segments = 32;
        if (!self.reserveVertices(segments * 3)) { return; }
        let step = (pi() * 2.0) / (segments as f64);
        var i: i32 = 0;
        while (i < segments) {
            let a0 = (i as f64) * step;
            let a1 = ((i + 1) as f64) * step;
            let center = Point.xy(circle.x, circle.y);
            let p0 = Point.xy(circle.x + ((cos(a0) as f32) * circle.radius), circle.y + ((sin(a0) as f32) * circle.radius));
            let p1 = Point.xy(circle.x + ((cos(a1) as f32) * circle.radius), circle.y + ((sin(a1) as f32) * circle.radius));
            self.addTriangle(center, p0, p1, color, framebuffer_width, framebuffer_height);
            i = i + 1;
        }
    }

    public fn addLine(&mut self, line: Line, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!line.isDrawable()) { return; }
        if (!self.reserveVertices(6)) { return; }
        let dx = line.x1 - line.x0;
        let dy = line.y1 - line.y0;
        let len = sqrt(((dx as f64) * (dx as f64)) + ((dy as f64) * (dy as f64))) as f32;
        if (len <= 0.0) { return; }
        let half = line.width / (2.0 as f32);
        let nx = ((0.0 as f32) - dy) / len;
        let ny = dx / len;
        let ox = nx * half;
        let oy = ny * half;
        let a = Point.xy(line.x0 + ox, line.y0 + oy);
        let b = Point.xy(line.x0 - ox, line.y0 - oy);
        let c = Point.xy(line.x1 + ox, line.y1 + oy);
        let d = Point.xy(line.x1 - ox, line.y1 - oy);
        self.addTriangle(a, b, c, color, framebuffer_width, framebuffer_height);
        self.addTriangle(c, b, d, color, framebuffer_width, framebuffer_height);
    }

    public fn addStrokeRect(&mut self, rect: Rectangle, width: f32, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!rect.isDrawable() || width <= 0.0) { return; }
        if (!self.reserveVertices(24)) { return; }
        let x0 = rect.x;
        let y0 = rect.y;
        let x1 = rect.right();
        let y1 = rect.bottom();
        self.addLine(Line.xy(x0, y0, x1, y0, width), color, framebuffer_width, framebuffer_height);
        self.addLine(Line.xy(x1, y0, x1, y1, width), color, framebuffer_width, framebuffer_height);
        self.addLine(Line.xy(x1, y1, x0, y1, width), color, framebuffer_width, framebuffer_height);
        self.addLine(Line.xy(x0, y1, x0, y0, width), color, framebuffer_width, framebuffer_height);
    }

    public fn vertexCount(&self) -> i32 {
        return self.vertex_count;
    }

    public fn vertexData(&self) -> rawptr {
        return self.data;
    }

    public fn vertexOffset(&self, index: i32) -> rawptr {
        return self.data + ((index as i64) * sizeof::<SolidVertex>());
    }

    public fn vertexAt(&self, index: i32) -> SolidVertex {
        var out = SolidVertex { x: 0.0, y: 0.0, r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
        if (self.data == null || index < 0 || index >= self.vertex_count) { return out; }
        memcpy(to_rawptr(&out), self.vertexOffset(index), sizeof::<SolidVertex>());
        return out;
    }

    public fn isEmpty(&self) -> bool {
        return self.vertex_count == 0;
    }

    public fn hasOverflowed(&self) -> bool {
        return self.overflowed;
    }

    public fn destroy(&mut self) {
        if (self.data != null) {
            free(self.data);
        }
        self.data = null;
        self.capacity = 0;
        self.vertex_count = 0;
        self.rect_count = 0;
        self.overflowed = false;
    }
}

public class TexturedVertex {
    public x: f32;
    public y: f32;
    public u: f32;
    public v: f32;
    public layer: f32;
    public r: f32;
    public g: f32;
    public b: f32;
    public a: f32;

    public static fn create(x: f32, y: f32, u: f32, v: f32, layer: f32, color: Color) -> TexturedVertex {
        return TexturedVertex { x: x, y: y, u: u, v: v, layer: layer, r: color.r, g: color.g, b: color.b, a: color.a };
    }
}

public class TexturedBatch {
    public data: rawptr;
    public capacity: i32;
    public vertex_count: i32;
    private overflowed: bool;

    public static fn create(vertex_capacity: i32) -> TexturedBatch {
        var cap = vertex_capacity;
        if (cap < 6) { cap = 6; }
        return TexturedBatch {
            data: malloc((cap as i64) * sizeof::<TexturedVertex>()),
            capacity: cap,
            vertex_count: 0,
            overflowed: false
        };
    }

    private fn pushVertex(&mut self, vertex: TexturedVertex) -> bool {
        if (self.data == null) { self.overflowed = true; return false; }
        if (self.vertex_count >= self.capacity) { self.overflowed = true; return false; }
        memcpy(self.data + ((self.vertex_count as i64) * sizeof::<TexturedVertex>()), to_rawptr(&vertex), sizeof::<TexturedVertex>());
        self.vertex_count = self.vertex_count + 1;
        return true;
    }

    private fn reserveVertices(&mut self, count: i32) -> bool {
        if (self.data == null) { self.overflowed = true; return false; }
        if ((self.vertex_count + count) > self.capacity) { self.overflowed = true; return false; }
        return true;
    }

    private fn toClipX(&self, x: f32, framebuffer_width: f32) -> f32 {
        return ((x / framebuffer_width) * (2.0 as f32)) - (1.0 as f32);
    }

    private fn toClipY(&self, y: f32, framebuffer_height: f32) -> f32 {
        return ((y / framebuffer_height) * (2.0 as f32)) - (1.0 as f32);
    }

    public fn addSprite(&mut self, sprite: Sprite, quad: Quad, framebuffer_width: f32, framebuffer_height: f32) {
        if (!sprite.isDrawable() || !quad.isDrawable()) { return; }
        if (!self.reserveVertices(6)) { return; }
        let u0 = sprite.region.u0();
        let v0 = sprite.region.v0();
        let u1 = sprite.region.u1();
        let v1 = sprite.region.v1();
        let layer = sprite.region.atlas_id as f32;
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p0.x, framebuffer_width), self.toClipY(quad.p0.y, framebuffer_height), u1, v0, layer, sprite.tint));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p1.x, framebuffer_width), self.toClipY(quad.p1.y, framebuffer_height), u0, v0, layer, sprite.tint));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p2.x, framebuffer_width), self.toClipY(quad.p2.y, framebuffer_height), u0, v1, layer, sprite.tint));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p2.x, framebuffer_width), self.toClipY(quad.p2.y, framebuffer_height), u0, v1, layer, sprite.tint));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p3.x, framebuffer_width), self.toClipY(quad.p3.y, framebuffer_height), u1, v1, layer, sprite.tint));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p0.x, framebuffer_width), self.toClipY(quad.p0.y, framebuffer_height), u1, v0, layer, sprite.tint));
    }

    public fn addExternal(&mut self, quad: Quad, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!quad.isDrawable() || !self.reserveVertices(6)) { return; }
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p0.x, framebuffer_width), self.toClipY(quad.p0.y, framebuffer_height), 0.0, 0.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p1.x, framebuffer_width), self.toClipY(quad.p1.y, framebuffer_height), 1.0, 0.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p2.x, framebuffer_width), self.toClipY(quad.p2.y, framebuffer_height), 1.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p2.x, framebuffer_width), self.toClipY(quad.p2.y, framebuffer_height), 1.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p3.x, framebuffer_width), self.toClipY(quad.p3.y, framebuffer_height), 0.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(quad.p0.x, framebuffer_width), self.toClipY(quad.p0.y, framebuffer_height), 0.0, 0.0, 0.0, color));
    }

    public fn addTriangleTextured(&mut self, a: Point,
                                  b: Point,
                                  c: Point,
                                  au: f32,
                                  av: f32,
                                  bu: f32,
                                  bv: f32,
                                  cu: f32,
                                  cv: f32,
                                  layer: f32,
                                  color: Color,
                                  framebuffer_width: f32,
                                  framebuffer_height: f32) {
        if (!self.reserveVertices(3)) { return; }
        self.pushVertex(TexturedVertex.create(self.toClipX(a.x, framebuffer_width), self.toClipY(a.y, framebuffer_height), au, av, layer, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(b.x, framebuffer_width), self.toClipY(b.y, framebuffer_height), bu, bv, layer, color));
        self.pushVertex(TexturedVertex.create(self.toClipX(c.x, framebuffer_width), self.toClipY(c.y, framebuffer_height), cu, cv, layer, color));
    }

    public fn addLayerComposite(&mut self, color: Color, framebuffer_width: f32, framebuffer_height: f32) {
        if (!self.reserveVertices(6)) { return; }
        let x0 = self.toClipX(0.0, framebuffer_width);
        let y0 = self.toClipY(0.0, framebuffer_height);
        let x1 = self.toClipX(framebuffer_width, framebuffer_width);
        let y1 = self.toClipY(framebuffer_height, framebuffer_height);
        self.pushVertex(TexturedVertex.create(x0, y0, 0.0, 0.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(x1, y0, 1.0, 0.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(x1, y1, 1.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(x1, y1, 1.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(x0, y1, 0.0, 1.0, 0.0, color));
        self.pushVertex(TexturedVertex.create(x0, y0, 0.0, 0.0, 0.0, color));
    }

    public fn vertexCount(&self) -> i32 {
        return self.vertex_count;
    }

    public fn vertexData(&self) -> rawptr {
        return self.data;
    }

    public fn vertexOffset(&self, index: i32) -> rawptr {
        return self.data + ((index as i64) * sizeof::<TexturedVertex>());
    }

    public fn vertexAt(&self, index: i32) -> TexturedVertex {
        var out = TexturedVertex { x: 0.0, y: 0.0, u: 0.0, v: 0.0, layer: 0.0, r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
        if (self.data == null || index < 0 || index >= self.vertex_count) { return out; }
        memcpy(to_rawptr(&out), self.vertexOffset(index), sizeof::<TexturedVertex>());
        return out;
    }

    public fn isEmpty(&self) -> bool {
        return self.vertex_count == 0;
    }

    public fn hasOverflowed(&self) -> bool {
        return self.overflowed;
    }

    public fn destroy(&mut self) {
        if (self.data != null) {
            free(self.data);
        }
        self.data = null;
        self.capacity = 0;
        self.vertex_count = 0;
        self.overflowed = false;
    }
}
