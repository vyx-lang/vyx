module Zyn.Nut.Image;

use Error = Zyn.Nut.Types.Error;

extern "C" {
    fn stbi_load(filename: rawptr, x: rawptr, y: rawptr, channels_in_file: rawptr, desired_channels: i32) -> rawptr;
    fn stbi_image_free(retval_from_stbi_load: rawptr);
    fn stbi_failure_reason() -> rawptr;
    fn stbi_info(filename: rawptr, x: rawptr, y: rawptr, comp: rawptr) -> i32;
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

public class ImageInfo {
    public width: i32;
    public height: i32;
    public channels: i32;
    public bit_depth: i32;
    public color_type: i32;

    public static fn create(width: i32, height: i32, channels: i32, bit_depth: i32, color_type: i32) -> ImageInfo {
        return ImageInfo { width: width, height: height, channels: channels, bit_depth: bit_depth, color_type: color_type };
    }

    public fn isRgba8(&self) -> bool {
        return self.bit_depth == 8 && self.channels == 4;
    }
}

public class DecodedImage {
    public width: i32;
    public height: i32;
    public channels: i32;
    public source_channels: i32;
    public data: rawptr;

    public static fn create(width: i32, height: i32, channels: i32, source_channels: i32, data: rawptr) -> DecodedImage {
        return DecodedImage { width: width, height: height, channels: channels, source_channels: source_channels, data: data };
    }

    public fn isValid(&self) -> bool {
        return self.data != null && self.width > 0 && self.height > 0 && self.channels > 0;
    }

    public fn pixelCount(&self) -> i32 {
        return self.width * self.height;
    }

    public fn stride(&self) -> i32 {
        return self.width * self.channels;
    }

    public fn byteSize(&self) -> i32 {
        return self.width * self.height * self.channels;
    }

    public fn pixelOffset(&self, x: i32, y: i32) -> i64 {
        return (((y * self.width) + x) * self.channels) as i64;
    }

    public fn pixelAtRgba(&self, x: i32, y: i32) -> u32 {
        var out: u32 = 0 as u32;
        if (!self.isValid() || self.channels != 4 || x < 0 || y < 0 || x >= self.width || y >= self.height) { return out; }
        memcpy(to_rawptr(&out), self.data + self.pixelOffset(x, y), sizeof::<u32>());
        return out;
    }

    public fn destroy(&mut self) {
        if (self.data != null) {
            stbi_image_free(self.data);
        }
        self.data = null;
        self.width = 0;
        self.height = 0;
        self.channels = 0;
        self.source_channels = 0;
    }
}

fn stbLastError() -> string {
    let reason = stbi_failure_reason();
    if (reason == null) { return ""; }
    return from_cstr(reason);
}

fn colorTypeFromChannels(channels: i32) -> i32 {
    if (channels == 1) { return 0; }
    if (channels == 2) { return 4; }
    if (channels == 3) { return 2; }
    if (channels == 4) { return 6; }
    return -1;
}

public class Image {
    public static fn readPngInfo(path: string) -> Result<ImageInfo, Error> {
        var width: i32 = 0;
        var height: i32 = 0;
        var channels: i32 = 0;
        let ok = stbi_info(path.c_str(), to_rawptr(&width), to_rawptr(&height), to_rawptr(&channels));
        if (ok == 0) {
            return Err(Error.create(1, "stb image info failed: " + stbLastError()));
        }
        if (width <= 0 || height <= 0 || channels <= 0) {
            return Err(Error.create(2, "stb image info returned invalid dimensions: " + path));
        }
        return Ok(ImageInfo.create(width, height, channels, 8, colorTypeFromChannels(channels)));
    }

    public static fn loadRgba(path: string) -> Result<DecodedImage, Error> {
        var width: i32 = 0;
        var height: i32 = 0;
        var source_channels: i32 = 0;
        let data = stbi_load(path.c_str(), to_rawptr(&width), to_rawptr(&height), to_rawptr(&source_channels), 4);
        if (data == null) {
            return Err(Error.create(3, "stb image load failed: " + stbLastError()));
        }
        if (width <= 0 || height <= 0) {
            stbi_image_free(data);
            return Err(Error.create(4, "stb image load returned invalid dimensions: " + path));
        }
        return Ok(DecodedImage.create(width, height, 4, source_channels, data));
    }
}
