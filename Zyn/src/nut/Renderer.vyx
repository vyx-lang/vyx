                    clip_path_depth_stack.push(active_clip_paths.len as i32);
                    let clip_path_offset = command.stroke_width as i32;
                    let clip_path_count = command.rect.x as i32;
                    let clip_rect = graph.clipPathTransformedBounds(clip_path_offset, clip_path_count, current_transform);
                    active_clip_paths.push(ClipPathState.create(clip_path_offset, clip_path_count, current_transform));
                    if (current_clip.has_clip) {
                        current_clip = current_clip.intersectRect(clip_rect);
                    } else {
                        current_clip = ClipState.fromRect(clip_rect);
                    }
                    current_clip.clip_path_depth = active_clip_paths.len as i32;
                } else {
                    if (!clip_stack.isEmpty()) {
                        current_clip = clip_stack.pop();
                    } else {
                        current_clip = ClipState.none();
                    }
                    if (!clip_path_depth_stack.isEmpty()) {
                        let saved_clip_path_depth = clip_path_depth_stack.pop();
                        while ((active_clip_paths.len as i32) > saved_clip_path_depth) {
