fn rendererPi() -> f64 {
    return 3.14159265358979323846;
}

fn nutJoinPath(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    if (b.len == 0) { return a; }
    let last = a.charAt(a.len - 1);
    if (last == 47 || last == 92) { return a + b; }
    return a + "/" + b;
}

fn nutResolveShaderPath(path: string) -> Result<string, Error> {
    if (fileExists(path)) { return Ok(path); }
    let base_path = AppPaths.basePath();
    let from_base = nutJoinPath(base_path, path);
    if (fileExists(from_base)) { return Ok(from_base); }
    return Err(Error.create(11, "shader not found: " + path));
}

public fn rendererBackendInvalid() -> u32 {
    return 9999 as u32;
}

public fn rendererBackendKnown(backend: u32) -> bool {
    return backend == backend_auto()
        || backend == backend_vulkan()
        || backend == backend_d3d12()
        || backend == backend_d3d11()
        || backend == backend_metal()
        || backend == backend_opengl()
        || backend == backend_opengles()
        || backend == backend_webgpu();
}

public fn rendererBackendFromName(name: string) -> u32 {
    let n = name.trim().toLower();
    if (n.len == 0 || n == "auto" || n == "default") { return backend_auto(); }
    if (n == "vulkan" || n == "vk") { return backend_vulkan(); }
    if (n == "d3d12" || n == "dx12" || n == "directx12") { return backend_d3d12(); }
    if (n == "d3d11" || n == "dx11" || n == "directx11") { return backend_d3d11(); }
    if (n == "metal" || n == "mtl") { return backend_metal(); }
    if (n == "opengl" || n == "gl") { return backend_opengl(); }
    if (n == "opengles" || n == "gles") { return backend_opengles(); }
    if (n == "webgpu" || n == "wgpu") { return backend_webgpu(); }
    return rendererBackendInvalid();
}

public fn rendererBackendName(backend: u32) -> string {
    if (backend == backend_auto()) { return "auto"; }
    if (backend == backend_vulkan()) { return "vulkan"; }
    if (backend == backend_d3d12()) { return "d3d12"; }
    if (backend == backend_d3d11()) { return "d3d11"; }
    if (backend == backend_metal()) { return "metal"; }
    if (backend == backend_opengl()) { return "opengl"; }
    if (backend == backend_opengles()) { return "opengles"; }
    if (backend == backend_webgpu()) { return "webgpu"; }
    return "unknown";
}

public fn rendererBackendIsExplicit(backend: u32) -> bool {
    return rendererBackendKnown(backend) && backend != backend_auto();
}

public fn rendererBackendMatchesRequest(requested: u32, actual: u32) -> bool {
    if (!rendererBackendKnown(requested)) { return false; }
    if (!rendererBackendKnown(actual) || actual == backend_auto()) { return false; }
    if (requested == backend_auto()) { return true; }
    return requested == actual;
}

public fn rendererBackendFallbackActive(requested: u32, actual: u32) -> bool {
    if (!rendererBackendIsExplicit(requested)) { return false; }
    if (!rendererBackendKnown(actual) || actual == backend_auto()) { return false; }
    return requested != actual;
}

public fn rendererBackendFeatureSwapchainColor() -> u32 { return 1 as u32; }
public fn rendererBackendFeatureSampledTextureArray() -> u32 { return 2 as u32; }
public fn rendererBackendFeatureDynamicRendering() -> u32 { return 4 as u32; }
public fn rendererBackendFeatureDepthStencilClipMask() -> u32 { return 8 as u32; }
public fn rendererBackendFeatureCustomPipelines() -> u32 { return 16 as u32; }
public fn rendererBackendFeatureLayerTargets() -> u32 { return 32 as u32; }

public fn rendererFrameErrorKindNone() -> i32 { return 0; }
public fn rendererFrameErrorKindSwapchainOutOfDate() -> i32 { return 1; }
public fn rendererFrameErrorKindDeviceLost() -> i32 { return 2; }
public fn rendererFrameErrorKindSubmitFailed() -> i32 { return 3; }
public fn rendererFrameErrorKindPresentFailed() -> i32 { return 4; }
public fn rendererFrameErrorKindWaitIdleFailed() -> i32 { return 5; }
public fn rendererFrameErrorKindFramebufferInvalid() -> i32 { return 6; }
public fn rendererFrameErrorKindOther() -> i32 { return 99; }

public fn rendererRecoveryActionNone() -> i32 { return 0; }
public fn rendererRecoveryActionResizeSwapchain() -> i32 { return 1; }
public fn rendererRecoveryActionPurgeTransientResources() -> i32 { return 2; }
public fn rendererRecoveryActionRetryFrame() -> i32 { return 3; }
public fn rendererRecoveryActionDeviceRecreateRecommended() -> i32 { return 4; }
public fn rendererRecoveryActionFailed() -> i32 { return 5; }

public fn rendererRecoveryActionName(action: i32) -> string {
    if (action == rendererRecoveryActionNone()) { return "none"; }
    if (action == rendererRecoveryActionResizeSwapchain()) { return "resize-swapchain"; }
    if (action == rendererRecoveryActionPurgeTransientResources()) { return "purge-transient-resources"; }
    if (action == rendererRecoveryActionRetryFrame()) { return "retry-frame"; }
    if (action == rendererRecoveryActionDeviceRecreateRecommended()) { return "device-recreate-recommended"; }
    if (action == rendererRecoveryActionFailed()) { return "failed"; }
    return "unknown";
}

public fn rendererFrameErrorKindFromCode(code: i32) -> i32 {
    if (code == 0) { return rendererFrameErrorKindNone(); }
    if (code == 22 || code == 24) { return rendererFrameErrorKindSwapchainOutOfDate(); }
    if (code == 166) { return rendererFrameErrorKindDeviceLost(); }
    if (code == 37) { return rendererFrameErrorKindSubmitFailed(); }
    if (code == 38) { return rendererFrameErrorKindPresentFailed(); }
    if (code == 39) { return rendererFrameErrorKindWaitIdleFailed(); }
    if (code == 40) { return rendererFrameErrorKindFramebufferInvalid(); }
    return rendererFrameErrorKindOther();
}

public fn rendererFrameErrorKindName(kind: i32) -> string {
    if (kind == rendererFrameErrorKindNone()) { return "none"; }
    if (kind == rendererFrameErrorKindSwapchainOutOfDate()) { return "swapchain-out-of-date"; }
    if (kind == rendererFrameErrorKindDeviceLost()) { return "device-lost"; }
    if (kind == rendererFrameErrorKindSubmitFailed()) { return "submit-failed"; }
    if (kind == rendererFrameErrorKindPresentFailed()) { return "present-failed"; }
    if (kind == rendererFrameErrorKindWaitIdleFailed()) { return "wait-idle-failed"; }
    if (kind == rendererFrameErrorKindFramebufferInvalid()) { return "framebuffer-invalid"; }
    return "other";
}

public fn rendererCustomPipelineMaterialSolid() -> i32 { return 0; }
public fn rendererCustomPipelineMaterialTextured() -> i32 { return 1; }
public fn rendererCustomPipelineVertexLayoutSolid() -> i32 { return 0; }
public fn rendererCustomPipelineVertexLayoutTextured() -> i32 { return 1; }
public fn rendererCustomPipelineVertexLayoutNone() -> i32 { return 2; }

public fn rendererCustomPipelineVertexLayoutName(kind: i32) -> string {
    if (kind == rendererCustomPipelineVertexLayoutSolid()) { return "solid"; }
    if (kind == rendererCustomPipelineVertexLayoutTextured()) { return "textured"; }
    if (kind == rendererCustomPipelineVertexLayoutNone()) { return "none"; }
    return "unknown";
}

public fn rendererCustomPipelineVertexLayoutKnown(kind: i32) -> bool {
    return kind == rendererCustomPipelineVertexLayoutSolid()
        || kind == rendererCustomPipelineVertexLayoutTextured()
        || kind == rendererCustomPipelineVertexLayoutNone();
}

public fn rendererCustomPipelineDefaultVertexLayoutForMaterial(material_kind: i32) -> i32 {
    if (material_kind == rendererCustomPipelineMaterialTextured()) {
        return rendererCustomPipelineVertexLayoutTextured();
    }
    return rendererCustomPipelineVertexLayoutSolid();
}

public fn rendererBackendRequiredFeatureMask() -> u32 {
    return rendererBackendFeatureSwapchainColor()
        | rendererBackendFeatureSampledTextureArray()
        | rendererBackendFeatureDynamicRendering()
        | rendererBackendFeatureDepthStencilClipMask()
        | rendererBackendFeatureCustomPipelines()
        | rendererBackendFeatureLayerTargets();
}

public fn rendererBackendFeatureKnown(feature: u32) -> bool {
    return feature == rendererBackendFeatureSwapchainColor()
        || feature == rendererBackendFeatureSampledTextureArray()
        || feature == rendererBackendFeatureDynamicRendering()
        || feature == rendererBackendFeatureDepthStencilClipMask()
        || feature == rendererBackendFeatureCustomPipelines()
        || feature == rendererBackendFeatureLayerTargets();
}

public fn rendererBackendFeatureName(feature: u32) -> string {
    if (feature == rendererBackendFeatureSwapchainColor()) { return "swapchain-color"; }
    if (feature == rendererBackendFeatureSampledTextureArray()) { return "sampled-texture-array"; }
    if (feature == rendererBackendFeatureDynamicRendering()) { return "dynamic-rendering"; }
    if (feature == rendererBackendFeatureDepthStencilClipMask()) { return "depth-stencil-clip-mask"; }
    if (feature == rendererBackendFeatureCustomPipelines()) { return "custom-pipelines"; }
    if (feature == rendererBackendFeatureLayerTargets()) { return "layer-targets"; }
    return "unknown";
}

public fn rendererBackendSupportedFeatureMask(backend: u32) -> u32 {
    if (!rendererBackendIsExplicit(backend)) { return 0 as u32; }
    return rendererBackendRequiredFeatureMask();
}

public fn rendererBackendHasFeature(backend: u32, feature: u32) -> bool {
    if (!rendererBackendFeatureKnown(feature)) { return false; }
    return (rendererBackendSupportedFeatureMask(backend) & feature) != 0 as u32;
}

public fn rendererBackendMissingRequiredFeatureMask(backend: u32) -> u32 {
    var missing: u32 = 0 as u32;
    let mask = rendererBackendSupportedFeatureMask(backend);
    let swapchain = rendererBackendFeatureSwapchainColor();
    let sampled_array = rendererBackendFeatureSampledTextureArray();
    let dynamic_rendering = rendererBackendFeatureDynamicRendering();
    let clip_mask = rendererBackendFeatureDepthStencilClipMask();
    let custom_pipelines = rendererBackendFeatureCustomPipelines();
    let layer_targets = rendererBackendFeatureLayerTargets();
    if ((mask & swapchain) == 0 as u32) { missing = missing | swapchain; }
    if ((mask & sampled_array) == 0 as u32) { missing = missing | sampled_array; }
    if ((mask & dynamic_rendering) == 0 as u32) { missing = missing | dynamic_rendering; }
    if ((mask & clip_mask) == 0 as u32) { missing = missing | clip_mask; }
    if ((mask & custom_pipelines) == 0 as u32) { missing = missing | custom_pipelines; }
    if ((mask & layer_targets) == 0 as u32) { missing = missing | layer_targets; }
    return missing;
}

public fn rendererBackendSatisfiesRequiredFeatures(backend: u32) -> bool {
    return rendererBackendIsExplicit(backend) && rendererBackendMissingRequiredFeatureMask(backend) == 0 as u32;
}

public fn rendererAdapterFeatureCount() -> i32 {
    return 27;
}

public fn rendererAdapterFeatureKnown(feature: u32) -> bool {
    return feature < (rendererAdapterFeatureCount() as u32);
}

public fn rendererAdapterFeatureBit(feature: u32) -> u32 {
    if (!rendererAdapterFeatureKnown(feature)) { return 0 as u32; }
    return (1 as u32) << feature;
}

public class RendererBackendProfile {
    public backend: u32;
    public name: string;
    public known: bool;
    public is_explicit: bool;
    public feature_mask: u32;
    public required_mask: u32;
    public missing_required_mask: u32;

    public static fn create(backend: u32) -> RendererBackendProfile {
        return RendererBackendProfile {
            backend: backend,
            name: rendererBackendName(backend),
            known: rendererBackendKnown(backend),
            is_explicit: rendererBackendIsExplicit(backend),
            feature_mask: rendererBackendSupportedFeatureMask(backend),
            required_mask: rendererBackendRequiredFeatureMask(),
            missing_required_mask: rendererBackendMissingRequiredFeatureMask(backend)
        };
    }

    public fn hasFeature(&self, feature: u32) -> bool {
        if (!rendererBackendFeatureKnown(feature)) { return false; }
        return (self.feature_mask & feature) != 0 as u32;
    }

    public fn satisfiesRequiredFeatures(&self) -> bool {
        return self.is_explicit && self.missing_required_mask == 0 as u32;
    }
}

fn rendererResolveBackend(desc_backend: u32) -> Result<u32, Error> {
    if (!rendererBackendKnown(desc_backend)) {
        return Err(Error.create(153, "unknown Cacao backend id"));
    }
    if (desc_backend != backend_auto()) {
        return Ok(desc_backend);
    }
    let raw = getenv("CACAO_BACKEND".c_str());
    if (raw == null) {
        return Ok(backend_auto());
    }
    let value = from_cstr(raw).trim();
    if (value.len == 0) {
        return Ok(backend_auto());
    }
    let parsed = rendererBackendFromName(value);
    if (!rendererBackendKnown(parsed)) {
        return Err(Error.create(153, "unknown Cacao backend: " + value));
    }
    return Ok(parsed);
}

class ClipState {
    public has_clip: bool;
    public x: f32;
    public y: f32;
    public width: f32;
    public height: f32;
    public clip_path_depth: i32;

    public static fn none() -> ClipState {
        return ClipState { has_clip: false, x: 0.0, y: 0.0, width: 0.0, height: 0.0, clip_path_depth: 0 };
    }

    public static fn fromRect(rect: Rectangle) -> ClipState {
        return ClipState { has_clip: true, x: rect.x, y: rect.y, width: rect.width, height: rect.height, clip_path_depth: 0 };
    }

    public fn clone(&self) -> ClipState {
        return ClipState { has_clip: self.has_clip, x: self.x, y: self.y, width: self.width, height: self.height, clip_path_depth: self.clip_path_depth };
    }

    public fn right(&self) -> f32 {
        return self.x + self.width;
    }

    public fn bottom(&self) -> f32 {
        return self.y + self.height;
    }

    public fn isDrawable(&self) -> bool {
        return self.width > 0.0 && self.height > 0.0;
    }

    public fn intersectRect(&self, rect: Rectangle) -> ClipState {
        var x0 = self.x;
        if (rect.x > x0) { x0 = rect.x; }
        var y0 = self.y;
        if (rect.y > y0) { y0 = rect.y; }
        var x1 = self.right();
        if (rect.right() < x1) { x1 = rect.right(); }
        var y1 = self.bottom();
        if (rect.bottom() < y1) { y1 = rect.bottom(); }
        return ClipState { has_clip: true, x: x0, y: y0, width: x1 - x0, height: y1 - y0, clip_path_depth: self.clip_path_depth };
    }
}

class ClipPathState {
    public active: bool;
    public offset: i32;
    public count: i32;
    public transform: Transform2D;

    public static fn none() -> ClipPathState {
        return ClipPathState { active: false, offset: 0, count: 0, transform: Transform2D.identity() };
    }

    public static fn create(offset: i32, count: i32, transform: Transform2D) -> ClipPathState {
        return ClipPathState { active: true, offset: offset, count: count, transform: transform.clone() };
    }

    public fn clone(&self) -> ClipPathState {
        return ClipPathState { active: self.active, offset: self.offset, count: self.count, transform: self.transform.clone() };
    }
}

