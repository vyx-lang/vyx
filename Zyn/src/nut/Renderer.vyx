                } else {
                    batch.addQuadGradient(quad, colorWithLayerAlpha(command.gradient.start, current_alpha), colorWithLayerAlpha(command.gradient.end, current_alpha), colorWithLayerAlpha(command.gradient.end, current_alpha), colorWithLayerAlpha(command.gradient.start, current_alpha), fw, fh);
