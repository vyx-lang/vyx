                    if (previous_vertices > 0) { segments.push(BatchSegment.createWithPipelineConstants(segment_start, previous_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip)); }
                    segment_open = false;
                    current_segment_material = -1;
                }
                let render_quad = transformRect(command.rect, current_transform);
                let dx_width = (render_quad.p1.x - render_quad.p0.x) as f64;
                let dy_width = (render_quad.p1.y - render_quad.p0.y) as f64;
                let dx_height = (render_quad.p3.x - render_quad.p0.x) as f64;
                let dy_height = (render_quad.p3.y - render_quad.p0.y) as f64;
                var target_width = (sqrt(dx_width * dx_width + dy_width * dy_width) + 0.5) as u32;
                var target_height = (sqrt(dx_height * dx_height + dy_height * dy_height) + 0.5) as u32;
                if (target_width == 0 as u32) { target_width = 1 as u32; }
                if (target_height == 0 as u32) { target_height = 1 as u32; }
                self.requestCustomRender(command.external_slot, target_width, target_height);
