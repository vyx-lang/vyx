    private last_frame_execution_plan_driven_resource_bind_count: i32;
    private resize_request_count: i32;
    private resize_count: i32;
    private resize_noop_count: i32;
    private resize_failed_count: i32;
    private swapchain_generation: i32;
    private frame_recovery_count: i32;
    private frame_recovery_attempt_count: i32;
    private frame_recovery_consecutive_failure_count: i32;
    private frame_recovery_successful_frame_count: i32;
    private frame_recovery_max_consecutive_failure_count: i32;
    private forced_frame_error_code: i32;
    private forced_frame_error_count: i32;
    private last_frame_error_code: i32;
    private last_frame_error_kind: i32;
    private last_frame_recovered: bool;
    private last_recovery_error_code: i32;
    private last_recovery_error_kind: i32;
    private last_recovery_attempted: bool;
    private last_recovery_resize_succeeded: bool;
    private last_recovery_retry_succeeded: bool;
    private last_recovery_resize_was_noop: bool;
    private last_recovery_resize_error_code: i32;
    private last_recovery_retry_error_code: i32;
    private last_recovery_retry_error_kind: i32;
    private last_recovery_purged_transient_count: i32;
    private last_recovery_purged_transient_bytes: u64;
    private last_recovery_swapchain_generation_before: i32;
    private last_recovery_swapchain_generation_after: i32;
    private last_recovery_action: i32;
    private last_recovery_device_recreate_recommended: bool;
    private last_recovery_retry_attempt_count: i32;
    private last_recovery_full_reset_required: bool;
    private device_generation: i32;
    private device_recreate_attempt_count: i32;
    private device_recreate_success_count: i32;
    private device_recreate_failure_count: i32;
    private last_device_recreate_error_code: i32;
    private last_device_recreate_invalidated_descriptor_count: i32;
    private last_device_recreate_cleared_pipeline_count: i32;
    private last_device_recreate_purged_transient_count: i32;
    private last_device_recreate_purged_transient_bytes: u64;
    private last_device_recreate_swapchain_generation_before: i32;
    private last_device_recreate_swapchain_generation_after: i32;
    private transient_resource_peak_count: i32;
    private transient_resource_peak_bytes: u64;
    private transient_resource_retained_frame_count: i32;
    private transient_resource_consecutive_retained_frame_count: i32;
    private transient_resource_max_consecutive_retained_frame_count: i32;
    private transient_resource_purge_count: i32;
    private last_frame_transient_resource_count: i32;
    private last_frame_transient_resource_bytes: u64;
    private last_frame_transient_resource_reused_count: i32;
    private last_purged_transient_resource_count: i32;
    private last_purged_transient_resource_bytes: u64;
    private last_resize_error_code: i32;
    private last_resize_requested_width: u32;
    private last_resize_requested_height: u32;
    private last_resize_previous_width: u32;
    private last_resize_previous_height: u32;
    private last_resize_purged_layer_targets: i32;
    private last_resize_purged_clip_stencil: bool;
    private last_resize_purged_transient_count: i32;
    private last_resize_purged_transient_bytes: u64;
    private last_resize_changed_framebuffer: bool;
    private forced_transient_resource_error_kind: i32;
    private forced_transient_resource_error_count: i32;
    private last_transient_resource_error_kind: i32;
    private transient_resource_partial_failure_count: i32;
    private transient_resource_partial_cleanup_count: i32;
    private transient_resource_partial_cleanup_bytes: u64;
    private last_transient_resource_error_created_handle_count: i32;
    private last_transient_resource_error_cleanup_count: i32;
    private last_transient_resource_error_cleanup_bytes: u64;
    private requested_backend: u32;
    private actual_backend: u32;
    private adapter_name: string;
    private adapter_device_id: u32;
    private adapter_vendor_id: u32;
    private adapter_type_value: u32;
    private adapter_dedicated_video_memory: u64;
    private adapter_feature_mask: u32;
    private adapter_feature_query_count: i32;
    private adapter_feature_supported_count: i32;
    private adapter_feature_query_failed_count: i32;
    private width: u32;
    private height: u32;
    private clear_color: Color;
    private owns: bool;

    public static fn create(window: Window, desc: RendererDesc) -> Result<Renderer, Error> {
        let native = window.nativeHandle();
        if (!native.isValid()) { return Err(Error.create(1, "Zyn window has no supported native surface handle")); }

        var requested_backend: u32 = backend_auto();
        match (rendererResolveBackend(desc.backend)) {
            case Ok(v) => { requested_backend = v; }
            case Err(e) => { return Err(e); }
        }

        var instance: Instance;
        match (Instance.create(InstanceDesc.create(requested_backend, desc.app_name, 1).addFeature(instance_feature_surface()))) {
            case Ok(v) => { instance = v; }
            case Err(e) => { return Err(Error.create(2, e.message)); }
        }

        var actual_backend: u32 = requested_backend;
        match (instance.backendType()) {
            case Ok(v) => { actual_backend = v; }
            case Err(e) => { instance.destroy(); return Err(Error.create(154, e.message)); }
        }

        var adapter: Adapter;
        match (instance.firstAdapter()) {
            case Ok(v) => { adapter = v; }
            case Err(e) => { instance.destroy(); return Err(Error.create(3, e.message)); }
        }

        var adapter_name = "";
        var adapter_device_id: u32 = 0 as u32;
        var adapter_vendor_id: u32 = 0 as u32;
        var adapter_type_value: u32 = 0 as u32;
        var adapter_dedicated_video_memory: u64 = 0 as u64;
        match (adapter.properties()) {
            case Ok(props) => {
                adapter_name = props.name;
                adapter_device_id = props.device_id;
                adapter_vendor_id = props.vendor_id;
                adapter_type_value = props.adapter_type;
                adapter_dedicated_video_memory = props.dedicated_video_memory;
            }
            case Err(_) => {}
        }
        var adapter_feature_mask: u32 = 0 as u32;
        var adapter_feature_query_count: i32 = 0;
        var adapter_feature_supported_count: i32 = 0;
        var adapter_feature_query_failed_count: i32 = 0;
        var adapter_feature: u32 = 0 as u32;
        while (adapter_feature < (rendererAdapterFeatureCount() as u32)) {
            adapter_feature_query_count = adapter_feature_query_count + 1;
            match (adapter.isFeatureSupported(adapter_feature)) {
                case Ok(supported) => {
                    if (supported) {
                        adapter_feature_mask = adapter_feature_mask | rendererAdapterFeatureBit(adapter_feature);
                        adapter_feature_supported_count = adapter_feature_supported_count + 1;
                    }
                }
                case Err(_) => {
                    adapter_feature_query_failed_count = adapter_feature_query_failed_count + 1;
                }
            }
            adapter_feature = adapter_feature + 1 as u32;
        }

        var surface: Surface;
        let cacao_window = rendererNativeWindowHandle(native);
        match (instance.createNativeSurface(cacao_window)) {
            case Ok(v) => { surface = v; }
            case Err(e) => { adapter.destroy(); instance.destroy(); return Err(Error.create(4, e.message)); }
        }

        var device: Device;
        match (adapter.createDevice(DeviceDesc.forSurface(&surface))) {
            case Ok(v) => { device = v; }
            case Err(e) => { surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(5, e.message)); }
        }

        var queue: DeviceQueue;
        match (device.getQueue(queue_graphics(), 0)) {
            case Ok(v) => { queue = v; }
            case Err(e) => { device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(6, e.message)); }
        }

        var caps: SurfaceCapabilities;
        match (surface.capabilities(&adapter)) {
            case Ok(v) => { caps = v; }
            case Err(e) => { queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(7, e.message)); }
        }

        var image_count = caps.min_image_count + 1;
        if (caps.max_image_count != 0 as u32 && image_count > caps.max_image_count) { image_count = caps.max_image_count; }
        var swap_desc = SwapchainDesc.create(caps.current_extent.width, caps.current_extent.height, format_rgba8_unorm(), swapchain_usage_color_attachment()).setPresentMode(present_mode_fifo()).setMinImageCount(image_count);
        var swapchain: Swapchain;
        match (device.createSwapchain(&surface, swap_desc)) {
            case Ok(v) => { swapchain = v; }
            case Err(e) => { queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(8, e.message)); }
        }

        var sync: Synchronization;
        match (device.createSynchronization(1)) {
            case Ok(v) => { sync = v; }
            case Err(e) => { swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(9, e.message)); }
        }

        var command: CommandEncoder;
        match (device.createCommandEncoder(command_buffer_primary())) {
            case Ok(v) => { command = v; }
            case Err(e) => { sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(10, e.message)); }
        }

        var shader_path: string;
        match (nutResolveShaderPath(desc.shader_path)) {
            case Ok(v) => { shader_path = v; }
            case Err(e) => { command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(e); }
        }

        var compiler: ShaderCompiler;
        match (instance.createShaderCompiler()) {
            case Ok(v) => { compiler = v; }
            case Err(e) => { command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(13, e.message)); }
        }
        match (compiler.setCacheDirectory(desc.shader_cache_dir)) {
            case Ok(_) => {}
            case Err(e) => { compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(14, e.message)); }
        }

        var vertex_shader: ShaderModule;
        match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "SolidVS", stage: shader_stage_vertex(), profile: "" })) {
            case Ok(v) => { vertex_shader = v; }
            case Err(e) => { compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(15, e.message)); }
        }

        var fragment_shader: ShaderModule;
        match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "SolidPS", stage: shader_stage_fragment(), profile: "" })) {
            case Ok(v) => { fragment_shader = v; }
            case Err(e) => { vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(16, e.message)); }
        }

        var textured_vertex_shader: ShaderModule;
        match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "TexturedVS", stage: shader_stage_vertex(), profile: "" })) {
            case Ok(v) => { textured_vertex_shader = v; }
            case Err(e) => { fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(45, e.message)); }
        }

        var textured_fragment_shader: ShaderModule;
        match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "TexturedPS", stage: shader_stage_fragment(), profile: "" })) {
            case Ok(v) => { textured_fragment_shader = v; }
            case Err(e) => { textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(46, e.message)); }
        }

        var sprite_texture_desc = SpriteTextureDesc.defaultWhite();
        if (desc.sprite_atlas_pixels != null) {
            match (SpriteTextureDesc.fromRgbaPixels(desc.sprite_atlas_width, desc.sprite_atlas_height, desc.sprite_atlas_pixels)) {
                case Ok(v) => {
                    sprite_texture_desc.destroy();
                    sprite_texture_desc = v;
                }
                case Err(e) => {
                    sprite_texture_desc.destroy();
                    textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy();
                    return Err(e);
                }
            }
        } else if (desc.sprite_atlas_path.len > 0) {
            match (Image.loadRgba(desc.sprite_atlas_path)) {
                case Ok(decoded_atlas) => {
                    match (SpriteTextureDesc.fromDecoded(decoded_atlas)) {
                        case Ok(v) => {
                            sprite_texture_desc.destroy();
                            sprite_texture_desc = v;
                        }
                        case Err(e) => {
                            decoded_atlas.destroy();
                            textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy();
                            return Err(e);
                        }
                    }
                    decoded_atlas.destroy();
                }
                case Err(e) => { textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(e); }
            }
        }
        if (sprite_texture_desc.upload_data == null || sprite_texture_desc.upload_bytes == 0 as u64) {
            sprite_texture_desc.destroy();
            textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy();
            return Err(Error.create(84, "sprite atlas upload data is empty"));
        }
        var sprite_texture_upload: Buffer;
        match (device.createBuffer(BufferDesc.create(sprite_texture_desc.upload_bytes, buffer_usage_transfer_src(), memory_cpu_to_gpu(), "SpriteTextureUpload"))) {
            case Ok(v) => { sprite_texture_upload = v; }
            case Err(e) => { sprite_texture_desc.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(47, e.message)); }
        }
        match (sprite_texture_upload.writeRaw(sprite_texture_desc.upload_data, sprite_texture_desc.upload_bytes, 0 as u64)) { case Ok(_) => {} case Err(e) => { sprite_texture_desc.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(76, e.message)); } }
        match (sprite_texture_upload.flush(0 as u64, sprite_texture_desc.upload_bytes)) { case Ok(_) => {} case Err(e) => { sprite_texture_desc.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(80, e.message)); } }
        let sprite_texture_width_value = sprite_texture_desc.width;
        let sprite_texture_height_value = sprite_texture_desc.height;
        let sprite_texture_layers_value = sprite_texture_desc.layers;
        let sprite_texture_row_pixels_value = sprite_texture_desc.row_pixels;
        let sprite_texture_upload_bytes_value = sprite_texture_desc.upload_bytes;
        sprite_texture_desc.destroy();

        var sprite_texture: Texture;
        match (device.createTexture(TextureDesc.create2DArray(sprite_texture_width_value, sprite_texture_height_value, sprite_texture_layers_value, format_rgba8_unorm(), texture_usage_sampled() | texture_usage_transfer_dst(), "SpriteTexture").setInitialState(resource_undefined()))) {
            case Ok(v) => { sprite_texture = v; }
            case Err(e) => { sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(48, e.message)); }
        }

        match (command.reset()) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(49, e.message)); } }
        match (command.begin(true, false)) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(50, e.message)); } }
        match (command.transitionImage(&sprite_texture, image_transition_undefined_to_transfer_dst())) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(51, e.message)); } }
        var sprite_regions = Vec::<BufferImageCopy>.new();
        var init_layer: u32 = 0 as u32;
        let init_layer_bytes = (sprite_texture_row_pixels_value as u64) * 4 as u64 * (sprite_texture_height_value as u64);
        while (init_layer < sprite_texture_layers_value) {
            sprite_regions.push(BufferImageCopy { buffer_offset: init_layer_bytes * (init_layer as u64), buffer_row_length: sprite_texture_row_pixels_value, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: init_layer, layer_count: 1 as u32, image_offset_x: 0, image_offset_y: 0, image_offset_z: 0, image_extent_width: sprite_texture_width_value, image_extent_height: sprite_texture_height_value, image_extent_depth: 1 as u32 });
            init_layer = init_layer + 1 as u32;
        }
        match (command.copyBufferToImage(&sprite_texture_upload, &sprite_texture, resource_copy_dest(), sprite_regions)) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(52, e.message)); } }
        match (command.transitionImage(&sprite_texture, image_transition_transfer_dst_to_shader_read())) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(53, e.message)); } }
        match (command.end()) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(54, e.message)); } }
        match (queue.submitSimple(&command)) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(55, e.message)); } }
        match (queue.waitIdle()) { case Ok(_) => {} case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(56, e.message)); } }

        var sprite_texture_view: TextureView;
        match (sprite_texture.createView(TextureViewDesc.create(texture_type_2d_array(), format_rgba8_unorm(), image_aspect_color(), "SpriteTextureView").setArrayRange(0 as u32, sprite_texture_layers_value))) {
            case Ok(v) => { sprite_texture_view = v; }
            case Err(e) => { sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(57, e.message)); }
        }

        var sprite_sampler: Sampler;
        match (device.createSampler(SamplerDesc.nearestClamp("SpriteSampler"))) {
            case Ok(v) => { sprite_sampler = v; }
            case Err(e) => { sprite_texture_view.destroy(); sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(58, e.message)); }
        }

        var sprite_set_layout_desc = DescriptorSetLayoutDesc.empty();
        sprite_set_layout_desc = sprite_set_layout_desc.addBinding(0 as u32, descriptor_sampled_image(), 1 as u32, shader_stage_fragment());
        sprite_set_layout_desc = sprite_set_layout_desc.addBinding(1 as u32, descriptor_sampler(), 1 as u32, shader_stage_fragment());
        var sprite_set_layout: DescriptorSetLayout;
        match (device.createDescriptorSetLayout(sprite_set_layout_desc)) {
            case Ok(v) => { sprite_set_layout = v; }
            case Err(e) => { sprite_sampler.destroy(); sprite_texture_view.destroy(); sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(59, e.message)); }
        }
        var sprite_pool_desc = DescriptorPoolDesc.create(256 as u32);
        sprite_pool_desc = sprite_pool_desc.addSize(descriptor_sampled_image(), 256 as u32);
        sprite_pool_desc = sprite_pool_desc.addSize(descriptor_sampler(), 256 as u32);
        var sprite_descriptor_pool: DescriptorPool;
        match (device.createDescriptorPool(sprite_pool_desc)) {
            case Ok(v) => { sprite_descriptor_pool = v; }
            case Err(e) => { sprite_set_layout.destroy(); sprite_sampler.destroy(); sprite_texture_view.destroy(); sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(60, e.message)); }
        }
        var sprite_descriptor_set: DescriptorSet;
        match (sprite_descriptor_pool.allocate(&sprite_set_layout)) {
            case Ok(v) => { sprite_descriptor_set = v; }
            case Err(e) => { sprite_descriptor_pool.destroy(); sprite_set_layout.destroy(); sprite_sampler.destroy(); sprite_texture_view.destroy(); sprite_texture.destroy(); sprite_texture_upload.destroy(); textured_fragment_shader.destroy(); textured_vertex_shader.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); command.destroy(); sync.destroy(); swapchain.destroy(); queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return Err(Error.create(61, e.message)); }
        }
