class BatchSegment {
    public first_vertex: i32;
    public vertex_count: i32;
    public material: i32;
    public target: i32;
    public pipeline_id: i32;
    public push_constants: Color;
    public clip: ClipState;
    public external_slot: i32;

    public static fn create(first_vertex: i32, vertex_count: i32, material: i32, target: i32, clip: ClipState) -> BatchSegment {
        return BatchSegment.createWithPipeline(first_vertex, vertex_count, material, target, 0, clip);
    }

    public static fn createWithPipeline(first_vertex: i32, vertex_count: i32, material: i32, target: i32, pipeline_id: i32, clip: ClipState) -> BatchSegment {
        return BatchSegment.createWithPipelineConstants(first_vertex, vertex_count, material, target, pipeline_id, Color.rgba(0.0, 0.0, 0.0, 0.0), clip);
    }

    public static fn createWithPipelineConstants(first_vertex: i32, vertex_count: i32, material: i32, target: i32, pipeline_id: i32, push_constants: Color, clip: ClipState) -> BatchSegment {
        return BatchSegment { first_vertex: first_vertex, vertex_count: vertex_count, material: material, target: target, pipeline_id: pipeline_id, push_constants: push_constants.clone(), clip: clip.clone(), external_slot: -1 };
    }

    public static fn createExternal(first_vertex: i32, target: i32, slot_id: i32, clip: ClipState) -> BatchSegment {
        return BatchSegment { first_vertex: first_vertex, vertex_count: 6, material: -2, target: target, pipeline_id: 0, push_constants: Color.rgba(0.0, 0.0, 0.0, 0.0), clip: clip.clone(), external_slot: slot_id };
    }
}

class CustomRenderSlot {
    public id: i32;
    public handler: Box<dyn CustomRenderHandler>;
    public texture: Texture;
    public view: TextureView;
    public descriptor: DescriptorSet;
    public width: u32;
    public height: u32;
    public requested_width: u32;
    public requested_height: u32;
    public shader_read_ready: bool;
    public active_frame: bool;

    public static fn create(id: i32, handler: Box<dyn CustomRenderHandler>) -> CustomRenderSlot {
        return CustomRenderSlot { id: id, handler: handler, texture: Texture.empty(), view: TextureView.empty(), descriptor: DescriptorSet.empty(), width: 0 as u32, height: 0 as u32, requested_width: 0 as u32, requested_height: 0 as u32, shader_read_ready: false, active_frame: false };
    }
}

class CustomPipelineSlot {
    public id: i32;
    public pipeline: GraphicsPipeline;
    public clip_pipeline: GraphicsPipeline;
    public layout: PipelineLayout;
    public clip_layout: PipelineLayout;
    public material_kind: i32;
    public vertex_layout_kind: i32;
    public use_sprite_descriptors: bool;
    public custom_vertex_binding_count: i32;
    public custom_vertex_attribute_count: i32;
    public custom_descriptor_set_layout_count: i32;
    public custom_descriptor_set_layouts: Vec<DescriptorSetLayout>;
    public custom_vertex_bindings: Vec<VertexInputBinding>;
    public custom_vertex_attributes: Vec<VertexInputAttribute>;
    public static_descriptor_sets: Vec<DescriptorSet>;
    public owned_dynamic_descriptor_sets: Vec<DescriptorSet>;
    public dynamic_descriptor_set_custom_indices: Vec<i32>;
    public dynamic_descriptor_sets: Vec<DescriptorSet>;
    public dynamic_descriptor_pool_generations: Vec<i32>;
    public dynamic_descriptor_update_generations: Vec<i32>;
    public dynamic_descriptor_last_update_frames: Vec<i32>;
    public push_constant_stage_flags: u32;
    public push_constant_size: u32;
    public has_clip_pipeline: bool;
    public owns_layout: bool;
    public owns_clip_layout: bool;
    public registered_device_generation: i32;

    public static fn create(id: i32, pipeline: GraphicsPipeline, layout: PipelineLayout, material_kind: i32, device_generation: i32) -> CustomPipelineSlot {
        let pipeline_clone = pipeline.clone();
        let layout_clone = layout.clone();
        return CustomPipelineSlot {
            id: id,
            pipeline: pipeline,
            clip_pipeline: pipeline_clone,
            layout: layout,
            clip_layout: layout_clone,
            material_kind: material_kind,
            vertex_layout_kind: rendererCustomPipelineDefaultVertexLayoutForMaterial(material_kind),
            use_sprite_descriptors: material_kind == rendererCustomPipelineMaterialTextured(),
            custom_vertex_binding_count: 0,
            custom_vertex_attribute_count: 0,
            custom_descriptor_set_layout_count: 0,
            custom_descriptor_set_layouts: Vec::<DescriptorSetLayout>.new(),
            custom_vertex_bindings: Vec::<VertexInputBinding>.new(),
            custom_vertex_attributes: Vec::<VertexInputAttribute>.new(),
            static_descriptor_sets: Vec::<DescriptorSet>.new(),
            owned_dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_set_custom_indices: Vec::<i32>.new(),
            dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_pool_generations: Vec::<i32>.new(),
            dynamic_descriptor_update_generations: Vec::<i32>.new(),
            dynamic_descriptor_last_update_frames: Vec::<i32>.new(),
            push_constant_stage_flags: 0 as u32,
            push_constant_size: 0 as u32,
            has_clip_pipeline: false,
            owns_layout: false,
            owns_clip_layout: false,
            registered_device_generation: device_generation
        };
    }

    public static fn createWithClip(id: i32, pipeline: GraphicsPipeline, clip_pipeline: GraphicsPipeline, layout: PipelineLayout, clip_layout: PipelineLayout, material_kind: i32, device_generation: i32) -> CustomPipelineSlot {
        return CustomPipelineSlot {
            id: id,
            pipeline: pipeline,
            clip_pipeline: clip_pipeline,
            layout: layout,
            clip_layout: clip_layout,
            material_kind: material_kind,
            vertex_layout_kind: rendererCustomPipelineDefaultVertexLayoutForMaterial(material_kind),
            use_sprite_descriptors: material_kind == rendererCustomPipelineMaterialTextured(),
            custom_vertex_binding_count: 0,
            custom_vertex_attribute_count: 0,
            custom_descriptor_set_layout_count: 0,
            custom_descriptor_set_layouts: Vec::<DescriptorSetLayout>.new(),
            custom_vertex_bindings: Vec::<VertexInputBinding>.new(),
            custom_vertex_attributes: Vec::<VertexInputAttribute>.new(),
            static_descriptor_sets: Vec::<DescriptorSet>.new(),
            owned_dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_set_custom_indices: Vec::<i32>.new(),
            dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_pool_generations: Vec::<i32>.new(),
            dynamic_descriptor_update_generations: Vec::<i32>.new(),
            dynamic_descriptor_last_update_frames: Vec::<i32>.new(),
            push_constant_stage_flags: 0 as u32,
            push_constant_size: 0 as u32,
            has_clip_pipeline: true,
            owns_layout: false,
            owns_clip_layout: false,
            registered_device_generation: device_generation
        };
    }

    public static fn createOwned(id: i32, pipeline: GraphicsPipeline, layout: PipelineLayout, material_kind: i32, vertex_layout_kind: i32, use_sprite_descriptors: bool, custom_vertex_bindings: Vec<VertexInputBinding>, custom_vertex_attributes: Vec<VertexInputAttribute>, custom_descriptor_set_layout_count: i32, custom_descriptor_set_layouts: Vec<DescriptorSetLayout>, static_descriptor_sets: Vec<DescriptorSet>, push_constant_stage_flags: u32, push_constant_size: u32, device_generation: i32) -> CustomPipelineSlot {
        let pipeline_clone = pipeline.clone();
        let layout_clone = layout.clone();
        return CustomPipelineSlot {
            id: id,
            pipeline: pipeline,
            clip_pipeline: pipeline_clone,
            layout: layout,
            clip_layout: layout_clone,
            material_kind: material_kind,
            vertex_layout_kind: vertex_layout_kind,
            use_sprite_descriptors: use_sprite_descriptors,
            custom_vertex_binding_count: custom_vertex_bindings.len as i32,
            custom_vertex_attribute_count: custom_vertex_attributes.len as i32,
            custom_descriptor_set_layout_count: custom_descriptor_set_layout_count,
            custom_descriptor_set_layouts: custom_descriptor_set_layouts,
            custom_vertex_bindings: custom_vertex_bindings,
            custom_vertex_attributes: custom_vertex_attributes,
            static_descriptor_sets: static_descriptor_sets,
            owned_dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_set_custom_indices: Vec::<i32>.new(),
            dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_pool_generations: Vec::<i32>.new(),
            dynamic_descriptor_update_generations: Vec::<i32>.new(),
            dynamic_descriptor_last_update_frames: Vec::<i32>.new(),
            push_constant_stage_flags: push_constant_stage_flags,
            push_constant_size: push_constant_size,
            has_clip_pipeline: false,
            owns_layout: true,
            owns_clip_layout: false,
            registered_device_generation: device_generation
        };
    }

    public static fn createOwnedWithClip(id: i32, pipeline: GraphicsPipeline, clip_pipeline: GraphicsPipeline, layout: PipelineLayout, clip_layout: PipelineLayout, material_kind: i32, vertex_layout_kind: i32, use_sprite_descriptors: bool, custom_vertex_bindings: Vec<VertexInputBinding>, custom_vertex_attributes: Vec<VertexInputAttribute>, custom_descriptor_set_layout_count: i32, custom_descriptor_set_layouts: Vec<DescriptorSetLayout>, static_descriptor_sets: Vec<DescriptorSet>, push_constant_stage_flags: u32, push_constant_size: u32, device_generation: i32) -> CustomPipelineSlot {
        return CustomPipelineSlot {
            id: id,
            pipeline: pipeline,
            clip_pipeline: clip_pipeline,
            layout: layout,
            clip_layout: clip_layout,
            material_kind: material_kind,
            vertex_layout_kind: vertex_layout_kind,
            use_sprite_descriptors: use_sprite_descriptors,
            custom_vertex_binding_count: custom_vertex_bindings.len as i32,
            custom_vertex_attribute_count: custom_vertex_attributes.len as i32,
            custom_descriptor_set_layout_count: custom_descriptor_set_layout_count,
            custom_descriptor_set_layouts: custom_descriptor_set_layouts,
            custom_vertex_bindings: custom_vertex_bindings,
            custom_vertex_attributes: custom_vertex_attributes,
            static_descriptor_sets: static_descriptor_sets,
            owned_dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_set_custom_indices: Vec::<i32>.new(),
            dynamic_descriptor_sets: Vec::<DescriptorSet>.new(),
            dynamic_descriptor_pool_generations: Vec::<i32>.new(),
            dynamic_descriptor_update_generations: Vec::<i32>.new(),
            dynamic_descriptor_last_update_frames: Vec::<i32>.new(),
            push_constant_stage_flags: push_constant_stage_flags,
            push_constant_size: push_constant_size,
            has_clip_pipeline: true,
            owns_layout: true,
            owns_clip_layout: true,
            registered_device_generation: device_generation
        };
    }
}

class BuiltCustomPipeline {
    public pipeline: GraphicsPipeline;
    public layout: PipelineLayout;

    public static fn create(pipeline: GraphicsPipeline, layout: PipelineLayout) -> BuiltCustomPipeline {
        return BuiltCustomPipeline { pipeline: pipeline, layout: layout };
    }

    public fn destroy(&mut self) {
        self.pipeline.destroy();
        self.layout.destroy();
    }
}

public class CustomPipelineBindingPlan {
    public pipeline_id: i32;
    public material_kind: i32;
    public vertex_layout_kind: i32;
    public vertex_binding_count: i32;
    public vertex_attribute_count: i32;
    public total_vertex_stride: u32;
    public descriptor_set_count: i32;
    public sprite_descriptor_set_count: i32;
    public static_descriptor_set_count: i32;
    public dynamic_descriptor_set_count: i32;
    public bound_dynamic_descriptor_set_count: i32;
    public missing_dynamic_descriptor_set_count: i32;
    public push_constant_stage_flags: u32;
    public push_constant_size: u32;
    public owns_layout: bool;
    public has_clip_variant: bool;

    public static fn invalid() -> CustomPipelineBindingPlan {
        return CustomPipelineBindingPlan {
            pipeline_id: -1,
            material_kind: -1,
            vertex_layout_kind: -1,
            vertex_binding_count: 0,
            vertex_attribute_count: 0,
            total_vertex_stride: 0 as u32,
            descriptor_set_count: 0,
            sprite_descriptor_set_count: 0,
            static_descriptor_set_count: 0,
            dynamic_descriptor_set_count: 0,
            bound_dynamic_descriptor_set_count: 0,
            missing_dynamic_descriptor_set_count: 0,
            push_constant_stage_flags: 0 as u32,
            push_constant_size: 0 as u32,
            owns_layout: false,
            has_clip_variant: false
        };
    }

    public fn isValid(&self) -> bool {
        return self.pipeline_id > 0;
    }

    public fn usesDescriptors(&self) -> bool {
        return self.descriptor_set_count > 0;
    }

    public fn usesDynamicDescriptors(&self) -> bool {
        return self.dynamic_descriptor_set_count > 0;
    }

    public fn dynamicDescriptorsComplete(&self) -> bool {
        return self.missing_dynamic_descriptor_set_count == 0;
    }

    public fn usesPushConstants(&self) -> bool {
        return self.push_constant_size > 0 as u32;
    }
}

public class CustomPipelineDesc {
    public shader_path: string;
    public vertex_entry: string;
    public fragment_entry: string;
    public material_kind: i32;
    public vertex_layout_kind: i32;
    public use_sprite_descriptors: bool;
    public push_constant_stage_flags: u32;
    public push_constant_size: u32;
    public blend_enabled: bool;
    public depth_test_enabled: bool;
    public depth_write_enabled: bool;
    public depth_compare_op: u32;
    public cull_mode: u32;
    public topology: u32;
    public line_width: f32;
    public custom_vertex_bindings: Vec<VertexInputBinding>;
    public custom_vertex_attributes: Vec<VertexInputAttribute>;
    public custom_set_layouts: Vec<DescriptorSetLayout>;
    public static_descriptor_sets: Vec<DescriptorSet>;

    public static fn solid(shader_path: string, vertex_entry: string, fragment_entry: string) -> CustomPipelineDesc {
        return CustomPipelineDesc.create(shader_path, vertex_entry, fragment_entry, rendererCustomPipelineMaterialSolid());
    }

    public static fn textured(shader_path: string, vertex_entry: string, fragment_entry: string) -> CustomPipelineDesc {
        var desc = CustomPipelineDesc.create(shader_path, vertex_entry, fragment_entry, rendererCustomPipelineMaterialTextured());
        desc.use_sprite_descriptors = true;
        return desc;
    }

    public static fn create(shader_path: string, vertex_entry: string, fragment_entry: string, material_kind: i32) -> CustomPipelineDesc {
        return CustomPipelineDesc {
            shader_path: shader_path,
            vertex_entry: vertex_entry,
            fragment_entry: fragment_entry,
            material_kind: material_kind,
            vertex_layout_kind: rendererCustomPipelineDefaultVertexLayoutForMaterial(material_kind),
            use_sprite_descriptors: material_kind == rendererCustomPipelineMaterialTextured(),
            push_constant_stage_flags: 0 as u32,
            push_constant_size: 0 as u32,
            blend_enabled: true,
            depth_test_enabled: false,
            depth_write_enabled: false,
            depth_compare_op: compare_less_or_equal(),
            cull_mode: cull_none(),
            topology: topology_triangle_list(),
            line_width: 1.0,
            custom_vertex_bindings: Vec::<VertexInputBinding>.new(),
            custom_vertex_attributes: Vec::<VertexInputAttribute>.new(),
            custom_set_layouts: Vec::<DescriptorSetLayout>.new(),
            static_descriptor_sets: Vec::<DescriptorSet>.new()
        };
    }

    public fn setPushConstants(mut self, stage_flags: u32, size: u32) -> CustomPipelineDesc {
        self.push_constant_stage_flags = stage_flags;
        self.push_constant_size = size;
        return self;
    }

    public fn clearPushConstants(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_none(), 0 as u32);
    }

    public fn setVertexPushConstantsBytes(mut self, size: u32) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_vertex(), size);
    }

    public fn setFragmentPushConstantsBytes(mut self, size: u32) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_fragment(), size);
    }

    public fn setGraphicsPushConstantsBytes(mut self, size: u32) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_all_graphics(), size);
    }

    public fn useVertexPushConstants1f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_vertex(), sizeof::<PipelinePushConstants1f>() as u32);
    }

    public fn useVertexPushConstants2f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_vertex(), sizeof::<PipelinePushConstants2f>() as u32);
    }

    public fn useVertexPushConstants3f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_vertex(), sizeof::<PipelinePushConstants3f>() as u32);
    }

    public fn useVertexPushConstants4f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_vertex(), 16 as u32);
    }

    public fn useFragmentPushConstants4f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_fragment(), 16 as u32);
    }

    public fn useGraphicsPushConstants4f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_all_graphics(), 16 as u32);
    }

    public fn useGraphicsPushConstants1f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_all_graphics(), sizeof::<PipelinePushConstants1f>() as u32);
    }

    public fn useGraphicsPushConstants2f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_all_graphics(), sizeof::<PipelinePushConstants2f>() as u32);
    }

    public fn useGraphicsPushConstants3f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_all_graphics(), sizeof::<PipelinePushConstants3f>() as u32);
    }

    public fn useFragmentPushConstants1f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_fragment(), sizeof::<PipelinePushConstants1f>() as u32);
    }

    public fn useFragmentPushConstants2f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_fragment(), sizeof::<PipelinePushConstants2f>() as u32);
    }

    public fn useFragmentPushConstants3f(mut self) -> CustomPipelineDesc {
        return self.setPushConstants(shader_stage_fragment(), sizeof::<PipelinePushConstants3f>() as u32);
    }

    public fn setSpriteDescriptors(mut self, enabled: bool) -> CustomPipelineDesc {
        self.use_sprite_descriptors = enabled;
        return self;
    }

    public fn setVertexLayout(mut self, kind: i32) -> CustomPipelineDesc {
        self.vertex_layout_kind = kind;
        return self;
    }

    public fn setNoVertexInput(mut self) -> CustomPipelineDesc {
        self.vertex_layout_kind = rendererCustomPipelineVertexLayoutNone();
        return self;
    }

    public fn addVertexBinding(mut self, binding: u32, stride: u32) -> CustomPipelineDesc {
        return self.addVertexBindingWithRate(binding, stride, vertex_input_rate_vertex());
    }

    public fn addInstanceVertexBinding(mut self, binding: u32, stride: u32) -> CustomPipelineDesc {
        return self.addVertexBindingWithRate(binding, stride, vertex_input_rate_instance());
    }

    public fn addVertexBindingWithRate(mut self, binding: u32, stride: u32, input_rate: u32) -> CustomPipelineDesc {
        self.custom_vertex_bindings.push(VertexInputBinding.create(binding, stride, input_rate));
        return self;
    }

    public fn addVertexAttribute(mut self, location: u32, binding: u32, format: u32, offset: u32, semantic_name: string, semantic_index: u32) -> CustomPipelineDesc {
        self.custom_vertex_attributes.push(VertexInputAttribute.create(location, binding, format, offset, semantic_name, semantic_index));
        return self;
    }

    public fn clearVertexInput(mut self) -> CustomPipelineDesc {
        self.custom_vertex_bindings.destroy();
        self.custom_vertex_attributes.destroy();
        self.custom_vertex_bindings = Vec::<VertexInputBinding>.new();
        self.custom_vertex_attributes = Vec::<VertexInputAttribute>.new();
        return self;
    }

    public fn useSolidVertexInput(mut self) -> CustomPipelineDesc {
        self = self.clearVertexInput();
        self.vertex_layout_kind = rendererCustomPipelineVertexLayoutSolid();
        self.custom_vertex_bindings.push(VertexInputBinding.create(0 as u32, sizeof::<SolidVertex>() as u32, vertex_input_rate_vertex()));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(0 as u32, 0 as u32, format_rg32_float(), 0 as u32, "POSITION", 0 as u32));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(1 as u32, 0 as u32, format_rgba32_float(), 8 as u32, "COLOR", 0 as u32));
        return self;
    }

    public fn useTexturedVertexInput(mut self) -> CustomPipelineDesc {
        self = self.clearVertexInput();
        self.vertex_layout_kind = rendererCustomPipelineVertexLayoutTextured();
        self.custom_vertex_bindings.push(VertexInputBinding.create(0 as u32, sizeof::<TexturedVertex>() as u32, vertex_input_rate_vertex()));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(0 as u32, 0 as u32, format_rg32_float(), 0 as u32, "POSITION", 0 as u32));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(1 as u32, 0 as u32, format_rg32_float(), 8 as u32, "TEXCOORD", 0 as u32));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(2 as u32, 0 as u32, format_r32_float(), 16 as u32, "TEXCOORD", 1 as u32));
        self.custom_vertex_attributes.push(VertexInputAttribute.create(3 as u32, 0 as u32, format_rgba32_float(), 20 as u32, "COLOR", 0 as u32));
        return self;
    }

    public fn addDescriptorSetLayout(mut self, layout: DescriptorSetLayout) -> CustomPipelineDesc {
        self.custom_set_layouts.push(layout.clone());
        return self;
    }

    public fn addStaticDescriptorSet(mut self, set: DescriptorSet) -> CustomPipelineDesc {
        self.static_descriptor_sets.push(set.clone());
        return self;
    }

    public fn setBlendEnabled(mut self, enabled: bool) -> CustomPipelineDesc {
        self.blend_enabled = enabled;
        return self;
    }

    public fn useAlphaBlend(mut self) -> CustomPipelineDesc {
        self.blend_enabled = true;
        return self;
    }

    public fn useOpaqueBlend(mut self) -> CustomPipelineDesc {
        self.blend_enabled = false;
        return self;
    }

    public fn setDepthTest(mut self, test_enabled: bool, write_enabled: bool, compare_op: u32) -> CustomPipelineDesc {
        self.depth_test_enabled = test_enabled;
        self.depth_write_enabled = write_enabled;
        self.depth_compare_op = compare_op;
        return self;
    }

    public fn disableDepthTest(mut self) -> CustomPipelineDesc {
        return self.setDepthTest(false, false, compare_less_or_equal());
    }

    public fn useDepthRead(mut self, compare_op: u32) -> CustomPipelineDesc {
        return self.setDepthTest(true, false, compare_op);
    }

    public fn useDepthWrite(mut self, compare_op: u32) -> CustomPipelineDesc {
        return self.setDepthTest(true, true, compare_op);
    }

    public fn setCullMode(mut self, mode: u32) -> CustomPipelineDesc {
        self.cull_mode = mode;
        return self;
    }

    public fn setTopology(mut self, topology: u32) -> CustomPipelineDesc {
        self.topology = topology;
        return self;
    }

    public fn useTriangleList(mut self) -> CustomPipelineDesc {
        return self.setTopology(topology_triangle_list());
    }

    public fn useTriangleStrip(mut self) -> CustomPipelineDesc {
        return self.setTopology(topology_triangle_strip());
    }

    public fn useLineList(mut self) -> CustomPipelineDesc {
        return self.setTopology(topology_line_list());
    }

    public fn setLineWidth(mut self, width: f32) -> CustomPipelineDesc {
        self.line_width = width;
        return self;
    }

    public fn customVertexBindingCount(&self) -> i32 {
        return self.custom_vertex_bindings.len as i32;
    }

    public fn customVertexAttributeCount(&self) -> i32 {
        return self.custom_vertex_attributes.len as i32;
    }

    public fn descriptorSetLayoutCount(&self) -> i32 {
        return self.custom_set_layouts.len as i32;
    }

    public fn staticDescriptorSetCount(&self) -> i32 {
        return self.static_descriptor_sets.len as i32;
    }

    public fn vertexBindingIndex(&self, binding: u32) -> i32 {
        var i: i32 = 0;
        while (i < (self.custom_vertex_bindings.len as i32)) {
            if (self.custom_vertex_bindings.get(i as i64).binding == binding) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn vertexBindingStrideAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return self.custom_vertex_bindings.get(index as i64).stride;
    }

    public fn vertexBindingNumberAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return self.custom_vertex_bindings.get(index as i64).binding;
    }

    public fn vertexBindingInputRateAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return self.custom_vertex_bindings.get(index as i64).input_rate;
    }

    public fn vertexAttributeBindingAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return self.custom_vertex_attributes.get(index as i64).binding;
    }

    public fn vertexAttributeLocationAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return self.custom_vertex_attributes.get(index as i64).location;
    }

    public fn vertexAttributeFormatAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return self.custom_vertex_attributes.get(index as i64).format;
    }

    public fn vertexAttributeOffsetAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return self.custom_vertex_attributes.get(index as i64).offset;
    }

    public fn vertexAttributeSemanticNameAt(&self, index: i32) -> string {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return ""; }
        return self.custom_vertex_attributes.get(index as i64).semantic_name;
    }

    public fn vertexAttributeSemanticIndexAt(&self, index: i32) -> u32 {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return self.custom_vertex_attributes.get(index as i64).semantic_index;
    }

    public fn usesCustomVertexInput(&self) -> bool {
        return self.custom_vertex_bindings.len > 0 || self.custom_vertex_attributes.len > 0;
    }

    public fn hasNoVertexInput(&self) -> bool {
        return self.vertex_layout_kind == rendererCustomPipelineVertexLayoutNone();
    }

    public fn totalVertexBindingStride(&self) -> u32 {
        var total: u32 = 0 as u32;
        var i: i32 = 0;
        while (i < (self.custom_vertex_bindings.len as i32)) {
            total = total + self.custom_vertex_bindings.get(i as i64).stride;
            i = i + 1;
        }
        return total;
    }

    public fn customDescriptorSetBaseIndex(&self) -> i32 {
        if (self.use_sprite_descriptors) { return 1; }
        return 0;
    }

    public fn customDescriptorSetIndexAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= (self.custom_set_layouts.len as i32)) { return -1; }
        return self.customDescriptorSetBaseIndex() + index;
    }

    public fn staticDescriptorFirstSet(&self) -> i32 {
        if (self.static_descriptor_sets.len <= 0) { return -1; }
        return self.customDescriptorSetBaseIndex();
    }

    public fn staticDescriptorLastSet(&self) -> i32 {
        let first = self.staticDescriptorFirstSet();
        if (first < 0) { return -1; }
        return first + (self.static_descriptor_sets.len as i32) - 1;
    }

    public fn duplicateVertexBindingCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < (self.custom_vertex_bindings.len as i32)) {
            let binding = self.custom_vertex_bindings.get(i as i64).binding;
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                if (self.custom_vertex_bindings.get(j as i64).binding == binding) { seen = true; }
                j = j + 1;
            }
            if (seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn duplicateVertexAttributeLocationCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < (self.custom_vertex_attributes.len as i32)) {
            let location = self.custom_vertex_attributes.get(i as i64).location;
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                if (self.custom_vertex_attributes.get(j as i64).location == location) { seen = true; }
                j = j + 1;
            }
            if (seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn missingVertexAttributeBindingCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < (self.custom_vertex_attributes.len as i32)) {
            if (self.vertexBindingIndex(self.custom_vertex_attributes.get(i as i64).binding) < 0) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn vertexBindingMatchesAt(&self, index: i32, other: &CustomPipelineDesc) -> bool {
        if (index < 0 || index >= (self.custom_vertex_bindings.len as i32) || index >= (other.custom_vertex_bindings.len as i32)) { return false; }
        let left = self.custom_vertex_bindings.get(index as i64);
        let right = other.custom_vertex_bindings.get(index as i64);
        return left.binding == right.binding && left.stride == right.stride && left.input_rate == right.input_rate;
    }

    @[borrow_args]
    public fn vertexAttributeMatchesAt(&self, index: i32, other: &CustomPipelineDesc) -> bool {
        if (index < 0 || index >= (self.custom_vertex_attributes.len as i32) || index >= (other.custom_vertex_attributes.len as i32)) { return false; }
        let left = self.custom_vertex_attributes.get(index as i64);
        let right = other.custom_vertex_attributes.get(index as i64);
        return left.location == right.location
            && left.binding == right.binding
            && left.format == right.format
            && left.offset == right.offset
            && left.semantic_name == right.semantic_name
            && left.semantic_index == right.semantic_index;
    }

    public fn vertexInputMatches(&self, other: &CustomPipelineDesc) -> bool {
        if (self.custom_vertex_bindings.len != other.custom_vertex_bindings.len) { return false; }
        if (self.custom_vertex_attributes.len != other.custom_vertex_attributes.len) { return false; }
        var i: i32 = 0;
        while (i < (self.custom_vertex_bindings.len as i32)) {
            if (!self.vertexBindingMatchesAt(i, other)) { return false; }
            i = i + 1;
        }
        i = 0;
        while (i < (self.custom_vertex_attributes.len as i32)) {
            if (!self.vertexAttributeMatchesAt(i, other)) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn pushConstantFloatCount(&self) -> i32 {
        if (self.push_constant_size == (sizeof::<PipelinePushConstants1f>() as u32)) { return 1; }
        if (self.push_constant_size == (sizeof::<PipelinePushConstants2f>() as u32)) { return 2; }
        if (self.push_constant_size == (sizeof::<PipelinePushConstants3f>() as u32)) { return 3; }
        if (self.push_constant_size == (sizeof::<PipelinePushConstants4f>() as u32)) { return 4; }
        return 0;
    }

    public fn supportsRenderGraphConstants(&self) -> bool {
        return self.push_constant_size == 0 as u32 || self.pushConstantFloatCount() > 0;
    }

    public fn isClipCompatibleWith(&self, other: &CustomPipelineDesc) -> bool {
        return self.material_kind == other.material_kind
            && self.vertex_layout_kind == other.vertex_layout_kind
            && self.use_sprite_descriptors == other.use_sprite_descriptors
            && self.vertexInputMatches(other)
            && self.custom_set_layouts.len == other.custom_set_layouts.len
            && self.static_descriptor_sets.len == other.static_descriptor_sets.len
            && self.push_constant_stage_flags == other.push_constant_stage_flags
            && self.push_constant_size == other.push_constant_size
            && self.blend_enabled == other.blend_enabled
            && self.depth_test_enabled == other.depth_test_enabled
            && self.depth_write_enabled == other.depth_write_enabled
            && self.depth_compare_op == other.depth_compare_op
            && self.cull_mode == other.cull_mode
            && self.topology == other.topology
            && self.line_width == other.line_width;
    }

    public fn validate(&self) -> Result<i32, Error> {
        if (self.vertex_entry.len == 0 || self.fragment_entry.len == 0) {
            return Err(Error.create(157, "custom shader entry point is empty"));
        }
        if (self.material_kind != rendererCustomPipelineMaterialSolid() && self.material_kind != rendererCustomPipelineMaterialTextured()) {
            return Err(Error.create(162, "custom pipeline material kind is invalid"));
        }
        if (!rendererCustomPipelineVertexLayoutKnown(self.vertex_layout_kind)) {
            return Err(Error.create(167, "custom pipeline vertex layout kind is invalid"));
        }
        if (self.material_kind == rendererCustomPipelineMaterialTextured() && !self.use_sprite_descriptors) {
            return Err(Error.create(163, "textured custom pipeline must use sprite descriptors"));
        }
        if ((self.custom_vertex_bindings.len > 0 && self.custom_vertex_attributes.len == 0)
            || (self.custom_vertex_bindings.len == 0 && self.custom_vertex_attributes.len > 0)) {
            return Err(Error.create(169, "custom pipeline vertex input requires both bindings and attributes"));
        }
        if (self.vertex_layout_kind == rendererCustomPipelineVertexLayoutNone() && (self.custom_vertex_bindings.len > 0 || self.custom_vertex_attributes.len > 0)) {
            return Err(Error.create(188, "custom pipeline no-vertex-input layout cannot declare vertex input"));
        }
        var binding_i: i32 = 0;
        while (binding_i < (self.custom_vertex_bindings.len as i32)) {
            let binding = self.custom_vertex_bindings.get(binding_i as i64);
            if (binding.stride == 0 as u32) {
                return Err(Error.create(191, "custom pipeline vertex binding stride must be non-zero"));
            }
            if (binding.input_rate != vertex_input_rate_vertex() && binding.input_rate != vertex_input_rate_instance()) {
                return Err(Error.create(192, "custom pipeline vertex binding input rate is invalid"));
            }
            binding_i = binding_i + 1;
        }
        if (self.duplicateVertexBindingCount() > 0) {
            return Err(Error.create(188, "custom pipeline vertex bindings must be unique"));
        }
        if (self.missingVertexAttributeBindingCount() > 0) {
            return Err(Error.create(189, "custom pipeline vertex attribute references a missing binding"));
        }
        if (self.duplicateVertexAttributeLocationCount() > 0) {
            return Err(Error.create(190, "custom pipeline vertex attribute locations must be unique"));
        }
        if (self.static_descriptor_sets.len > self.custom_set_layouts.len) {
            return Err(Error.create(168, "custom pipeline static descriptor set has no matching layout"));
        }
        if (self.push_constant_size > 0 as u32 && self.push_constant_stage_flags == 0 as u32) {
            return Err(Error.create(178, "custom pipeline push constant stage flags are empty"));
        }
        if (!self.supportsRenderGraphConstants()) {
            return Err(Error.create(184, "custom pipeline push constant size must be 1-4 f32 values for RenderGraph constants"));
        }
        if (self.line_width <= 0.0) {
            return Err(Error.create(185, "custom pipeline line width must be positive"));
        }
        return Ok(0);
    }
}

class SpriteTextureRow {
    public p0: u32;
    public p1: u32;
    public p2: u32;
    public p3: u32;

    public static fn create(p0: u32, p1: u32, p2: u32, p3: u32) -> SpriteTextureRow {
        return SpriteTextureRow { p0: p0, p1: p1, p2: p2, p3: p3 };
    }
}

class SpriteTextureDesc {
    public width: u32;
    public height: u32;
    public layers: u32;
    public row_pixels: u32;
    public upload_bytes: u64;
    public upload_data: rawptr;
    public owns_upload_data: bool;

    public static fn create(width: u32, height: u32, layers: u32, row_pixels: u32, upload_bytes: u64, upload_data: rawptr, owns_upload_data: bool) -> SpriteTextureDesc {
        return SpriteTextureDesc { width: width, height: height, layers: layers, row_pixels: row_pixels, upload_bytes: upload_bytes, upload_data: upload_data, owns_upload_data: owns_upload_data };
    }

    public static fn defaultWhite() -> SpriteTextureDesc {
        var pixel: rawptr = malloc(256);
        if (pixel != null) {
            memset(pixel, 0, 256);
            let white = 0xffffffff as u32;
            memcpy(pixel, to_rawptr(&white), sizeof::<u32>());
        }
        return SpriteTextureDesc.create(1 as u32, 1 as u32, 1 as u32, 64 as u32, 256 as u64, pixel, true);
    }

    public static fn fromDecoded(image: DecodedImage) -> Result<SpriteTextureDesc, Error> {
        if (!image.isValid() || image.channels != 4) {
            return Err(Error.create(82, "sprite atlas image is not RGBA"));
        }
        return SpriteTextureDesc.fromRgbaPixels(image.width, image.height, image.data);
    }

    public static fn fromRgbaPixels(width: i32, height: i32, pixels: rawptr) -> Result<SpriteTextureDesc, Error> {
        if (width <= 0 || height <= 0 || pixels == null) {
            return Err(Error.create(82, "sprite atlas pixels are invalid"));
        }
        let row_bytes = (width as i64) * 4;
        let aligned_row_bytes = ((row_bytes + 255) / 256) * 256;
        let upload_bytes_i64 = aligned_row_bytes * (height as i64);
        let upload_data = malloc(upload_bytes_i64);
        if (upload_data == null) {
            return Err(Error.create(83, "sprite atlas upload allocation failed"));
        }
        memset(upload_data, 0, upload_bytes_i64);
        var y: i32 = 0;
        while (y < height) {
            let src_offset = (y as i64) * row_bytes;
            let dst_offset = (y as i64) * aligned_row_bytes;
            memcpy(upload_data + dst_offset, pixels + src_offset, row_bytes);
            y = y + 1;
        }
        return Ok(SpriteTextureDesc.create(width as u32, height as u32, 1 as u32, (aligned_row_bytes / 4) as u32, upload_bytes_i64 as u64, upload_data, true));
    }

    public static fn fromAtlasSet(atlas_set: AtlasSet) -> Result<SpriteTextureDesc, Error> {
        let page_count = atlas_set.pageCount();
        if (page_count <= 0) {
            return Err(Error.create(110, "sprite atlas set has no pages"));
        }
        let first = atlas_set.pageAt(0);
        if (!first.hasPixels()) {
            return Err(Error.create(111, "sprite atlas set page has no pixels"));
        }
        let width = first.width;
        let height = first.height;
        let row_bytes = (width as i64) * 4;
        let aligned_row_bytes = ((row_bytes + 255) / 256) * 256;
        let layer_bytes = aligned_row_bytes * (height as i64);
        let upload_bytes_i64 = layer_bytes * (page_count as i64);
        let upload_data = malloc(upload_bytes_i64);
        if (upload_data == null) {
            return Err(Error.create(112, "sprite atlas set upload allocation failed"));
        }
        memset(upload_data, 0, upload_bytes_i64);
        var page_i: i32 = 0;
        while (page_i < page_count) {
            let page = atlas_set.pageAt(page_i);
            if (!page.hasPixels() || page.width != width || page.height != height) {
                free(upload_data);
                return Err(Error.create(113, "sprite atlas set pages must be same-size RGBA atlases"));
            }
            var row: i32 = 0;
            while (row < height) {
                let src_offset = (row as i64) * row_bytes;
                let dst_offset = ((page_i as i64) * layer_bytes) + ((row as i64) * aligned_row_bytes);
                memcpy(upload_data + dst_offset, page.pixels + src_offset, row_bytes);
                row = row + 1;
            }
            page_i = page_i + 1;
        }
        return Ok(SpriteTextureDesc.create(width as u32, height as u32, page_count as u32, (aligned_row_bytes / 4) as u32, upload_bytes_i64 as u64, upload_data, true));
    }

    public static fn fromRgbaRegion(atlas_width: i32, atlas_height: i32, pixels: rawptr, x: i32, y: i32, width: i32, height: i32) -> Result<SpriteTextureDesc, Error> {
        if (atlas_width <= 0 || atlas_height <= 0 || pixels == null || width <= 0 || height <= 0) {
            return Err(Error.create(82, "sprite atlas region pixels are invalid"));
        }
        if (x < 0 || y < 0 || (x + width) > atlas_width || (y + height) > atlas_height) {
            return Err(Error.create(82, "sprite atlas update region is out of bounds"));
        }
        let row_bytes = (width as i64) * 4;
        let aligned_row_bytes = ((row_bytes + 255) / 256) * 256;
        let upload_bytes_i64 = aligned_row_bytes * (height as i64);
        let upload_data = malloc(upload_bytes_i64);
        if (upload_data == null) {
            return Err(Error.create(83, "sprite atlas region upload allocation failed"));
        }
        memset(upload_data, 0, upload_bytes_i64);
        var row: i32 = 0;
        while (row < height) {
            let src_offset = ((((y + row) * atlas_width) + x) as i64) * 4;
            let dst_offset = (row as i64) * aligned_row_bytes;
            memcpy(upload_data + dst_offset, pixels + src_offset, row_bytes);
            row = row + 1;
        }
        return Ok(SpriteTextureDesc.create(width as u32, height as u32, 1 as u32, (aligned_row_bytes / 4) as u32, upload_bytes_i64 as u64, upload_data, true));
    }

    public fn destroy(&mut self) {
        if (self.owns_upload_data && self.upload_data != null) {
            free(self.upload_data);
        }
        self.upload_data = null;
    }
}

fn transformRect(rect: Rectangle, transform: Transform2D) -> Quad {
    return Quad.fromRect(rect).transform(transform);
}

fn quadBounds(quad: Quad) -> Rectangle {
    var x0 = quad.p0.x;
    var y0 = quad.p0.y;
    var x1 = quad.p0.x;
    var y1 = quad.p0.y;
    if (quad.p1.x < x0) { x0 = quad.p1.x; }
    if (quad.p2.x < x0) { x0 = quad.p2.x; }
    if (quad.p3.x < x0) { x0 = quad.p3.x; }
    if (quad.p1.y < y0) { y0 = quad.p1.y; }
    if (quad.p2.y < y0) { y0 = quad.p2.y; }
    if (quad.p3.y < y0) { y0 = quad.p3.y; }
    if (quad.p1.x > x1) { x1 = quad.p1.x; }
    if (quad.p2.x > x1) { x1 = quad.p2.x; }
    if (quad.p3.x > x1) { x1 = quad.p3.x; }
    if (quad.p1.y > y1) { y1 = quad.p1.y; }
    if (quad.p2.y > y1) { y1 = quad.p2.y; }
    if (quad.p3.y > y1) { y1 = quad.p3.y; }
    return Rectangle.xywh(x0, y0, x1 - x0, y1 - y0);
}

fn transformTriangle(triangle: Triangle, transform: Transform2D) -> Triangle {
    return Triangle.create(transform.transformPoint(triangle.a),
                           transform.transformPoint(triangle.b),
                           transform.transformPoint(triangle.c));
}

fn transformLine(line: Line, transform: Transform2D) -> Line {
    let a = transform.transformPoint(Point.xy(line.x0, line.y0));
    let b = transform.transformPoint(Point.xy(line.x1, line.y1));
    return Line.create(a, b, line.width);
}

fn lineToQuad(line: Line) -> Quad {
    let dx = line.x1 - line.x0;
    let dy = line.y1 - line.y0;
    let len = sqrt(((dx as f64) * (dx as f64)) + ((dy as f64) * (dy as f64))) as f32;
    if (len <= (0.0 as f32)) {
        return Quad.fromRect(Rectangle.xywh(line.x0, line.y0, 0.0, 0.0));
    }
    let half = line.width / (2.0 as f32);
    let nx = ((0.0 as f32) - dy) / len;
    let ny = dx / len;
    let ox = nx * half;
    let oy = ny * half;
    return Quad.create(Point.xy(line.x0 + ox, line.y0 + oy),
                       Point.xy(line.x0 - ox, line.y0 - oy),
                       Point.xy(line.x1 - ox, line.y1 - oy),
                       Point.xy(line.x1 + ox, line.y1 + oy));
}

fn transformCircleToQuad(circle: Circle, transform: Transform2D) -> Quad {
    return Quad.create(
        transform.transformPoint(Point.xy(circle.x - circle.radius, circle.y - circle.radius)),
        transform.transformPoint(Point.xy(circle.x + circle.radius, circle.y - circle.radius)),
        transform.transformPoint(Point.xy(circle.x + circle.radius, circle.y + circle.radius)),
        transform.transformPoint(Point.xy(circle.x - circle.radius, circle.y + circle.radius))
    );
}

fn transformSprite(sprite: Sprite, transform: Transform2D) -> Quad {
    return sprite.quad().transform(transform);
}

fn colorWithLayerAlpha(color: Color, alpha: f32) -> Color {
    return color.withAlphaMultiplier(alpha);
}

fn colorLerp(a: Color, b: Color, t: f32) -> Color {
    var u = t;
    if (u < (0.0 as f32)) { u = 0.0 as f32; }
    if (u > (1.0 as f32)) { u = 1.0 as f32; }
    return Color.rgba(a.r + ((b.r - a.r) * u),
                      a.g + ((b.g - a.g) * u),
                      a.b + ((b.b - a.b) * u),
                      a.a + ((b.a - a.a) * u));
}

fn spriteWithLayerAlpha(sprite: Sprite, alpha: f32) -> Sprite {
    return Sprite.create(sprite.region, sprite.dest, sprite.tint.withAlphaMultiplier(alpha));
}

fn straightAlphaBlendState() -> ColorBlendAttachmentState {
    return ColorBlendAttachmentState {
        blend_enable: true,
        src_color_blend_factor: blend_src_alpha(),
        dst_color_blend_factor: blend_one_minus_src_alpha(),
        color_blend_op: blend_add(),
        src_alpha_blend_factor: blend_one(),
        dst_alpha_blend_factor: blend_one_minus_src_alpha(),
        alpha_blend_op: blend_add(),
        color_write_mask: color_write_all()
    };
}

fn noColorWriteBlendState() -> ColorBlendAttachmentState {
    return ColorBlendAttachmentState {
        blend_enable: false,
        src_color_blend_factor: blend_one(),
        dst_color_blend_factor: blend_zero(),
        color_blend_op: blend_add(),
        src_alpha_blend_factor: blend_one(),
        dst_alpha_blend_factor: blend_zero(),
        alpha_blend_op: blend_add(),
        color_write_mask: 0 as u32
    };
}

public class RendererDesc {
    public app_name: string;
    public backend: u32;
    public width: u32;
    public height: u32;
    public clear_color: Color;
    public shader_path: string;
    public shader_cache_dir: string;
    public sprite_atlas_path: string;
    public sprite_atlas_width: i32;
    public sprite_atlas_height: i32;
    public sprite_atlas_pixels: rawptr;

    public static fn create(app_name: string, width: u32, height: u32) -> RendererDesc {
        return RendererDesc {
            app_name: app_name,
            backend: backend_auto(),
            width: width,
            height: height,
            clear_color: Color.rgba(0.08, 0.12, 0.18, 1.0),
            shader_path: "nut/solid.slang",
            shader_cache_dir: "shader_cache_zyn_nut",
            sprite_atlas_path: "",
            sprite_atlas_width: 0,
            sprite_atlas_height: 0,
            sprite_atlas_pixels: null
        };
    }

    public fn setBackend(mut self, backend: u32) -> RendererDesc {
        self.backend = backend;
        return self;
    }

    public fn setBackendName(mut self, name: string) -> RendererDesc {
        self.backend = rendererBackendFromName(name);
        return self;
    }

    public fn setClearColor(mut self, color: Color) -> RendererDesc {
        self.clear_color = color;
        return self;
    }

    public fn setShaderPath(mut self, path: string) -> RendererDesc {
        self.shader_path = path;
        return self;
    }

    public fn setShaderCacheDirectory(mut self, path: string) -> RendererDesc {
        self.shader_cache_dir = path;
        return self;
    }

    public fn setSpriteAtlasPath(mut self, path: string) -> RendererDesc {
        self.sprite_atlas_path = path;
        self.sprite_atlas_width = 0;
        self.sprite_atlas_height = 0;
        self.sprite_atlas_pixels = null;
        return self;
    }

    public fn setSpriteAtlasPixels(mut self, width: i32, height: i32, pixels: rawptr) -> RendererDesc {
        self.sprite_atlas_path = "";
        self.sprite_atlas_width = width;
        self.sprite_atlas_height = height;
        self.sprite_atlas_pixels = pixels;
        return self;
    }

}

fn rendererNativeWindowHandle(native: PlatformWindowHandle) -> NativeWindowHandle {
    var handle = NativeWindowHandle.empty();
    handle.hwnd = native.hwnd;
    handle.hinstance = native.hinstance;
    handle.metal_layer = native.metal_layer;
    handle.wayland_display = native.wayland_display;
    handle.wayland_surface = native.wayland_surface;
    handle.x11_display = native.x11_display;
    handle.x11_window = native.x11_window;
    handle.android_native_window = native.android_native_window;
    return handle;
}

