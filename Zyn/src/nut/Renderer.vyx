                        var previous_vertices: i32 = 0;
                        if (current_segment_material == 0) { previous_vertices = batch.vertexCount() - segment_start; }
                        else { previous_vertices = textured_batch.vertexCount() - segment_start; }
                        if (previous_vertices > 0) { segments.push(BatchSegment.createWithPipelineConstants(segment_start, previous_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip)); }
                    }
                    segment_open = true;
                    current_segment_material = 0;
                    current_segment_target = current_layer_depth;
                    current_segment_pipeline_id = current_solid_pipeline_id;
                    segment_start = batch.vertexCount();
