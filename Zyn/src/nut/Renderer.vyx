                let q = transformRect(command.rect, current_transform);
                let stroke_color = colorWithLayerAlpha(command.color, current_alpha);
                if (active_clip_paths.len > 0) {
                    var stroke_rect_added: i32 = 0;
                    stroke_rect_added = stroke_rect_added + self.addActiveClipPathsClippedQuad(&mut batch, lineToQuad(Line.create(q.p0, q.p1, command.stroke_width)), stroke_color, graph, active_clip_paths, fw, fh);
                    stroke_rect_added = stroke_rect_added + self.addActiveClipPathsClippedQuad(&mut batch, lineToQuad(Line.create(q.p1, q.p2, command.stroke_width)), stroke_color, graph, active_clip_paths, fw, fh);
                    stroke_rect_added = stroke_rect_added + self.addActiveClipPathsClippedQuad(&mut batch, lineToQuad(Line.create(q.p2, q.p3, command.stroke_width)), stroke_color, graph, active_clip_paths, fw, fh);
                    stroke_rect_added = stroke_rect_added + self.addActiveClipPathsClippedQuad(&mut batch, lineToQuad(Line.create(q.p3, q.p0, command.stroke_width)), stroke_color, graph, active_clip_paths, fw, fh);
                    if (stroke_rect_added > 0) { cpu_clip_path_count = cpu_clip_path_count + (active_clip_paths.len as i32); }
                } else {
                    batch.addLine(Line.create(q.p0, q.p1, command.stroke_width), stroke_color, fw, fh);
                    batch.addLine(Line.create(q.p1, q.p2, command.stroke_width), stroke_color, fw, fh);
                    batch.addLine(Line.create(q.p2, q.p3, command.stroke_width), stroke_color, fw, fh);
                    batch.addLine(Line.create(q.p3, q.p0, command.stroke_width), stroke_color, fw, fh);
                }
            }
            build_i = build_i + 1;
        }
        if (segment_open) {
            var final_segment_vertices: i32 = 0;
            if (current_segment_material == 0) {
                final_segment_vertices = batch.vertexCount() - segment_start;
            } else {
                final_segment_vertices = textured_batch.vertexCount() - segment_start;
            }
            if (final_segment_vertices > 0) {
                segments.push(BatchSegment.createWithPipelineConstants(segment_start, final_segment_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip));
            }
        }
        clip_stack.destroy();
        clip_path_depth_stack.destroy();
        active_clip_paths.destroy();
        transform_stack.destroy();
        layer_stack.destroy();
        layer_opacity_stack.destroy();
        match (self.prepareCustomRenderTargets()) {
            case Ok(_) => {}
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); return Err(e); }
        }
        if (batch.hasOverflowed()) {
            segments.destroy();
            textured_batch.destroy();
            batch.destroy();
            return Err(Error.create(43, "solid batch capacity was exceeded"));
        }
        if (textured_batch.hasOverflowed()) {
            segments.destroy();
            textured_batch.destroy();
            batch.destroy();
            return Err(Error.create(69, "textured batch capacity was exceeded"));
        }
        var clip_mask_batch = SolidBatch.create(6);
        if (self.last_frame_clip_path_count > 0) {
            clip_mask_batch.destroy();
            clip_mask_batch = self.buildClipMaskBatch(graph, fw, fh);
            if (clip_mask_batch.hasOverflowed()) {
                segments.destroy();
                clip_mask_batch.destroy();
                textured_batch.destroy();
                batch.destroy();
                return Err(Error.create(151, "clip mask batch capacity was exceeded"));
            }
        } else {
            self.last_frame_clip_mask_vertices = 0;
            self.last_frame_clip_mask_uploaded_bytes = 0 as u64;
        }
        var frame_vertex_handle: rawptr = null;
        match (self.uploadSolidBatch(batch)) {
            case Ok(v) => { frame_vertex_handle = v; }
            case Err(e) => { segments.destroy(); clip_mask_batch.destroy(); textured_batch.destroy(); batch.destroy(); return Err(e); }
        }
        var frame_textured_vertex_handle: rawptr = null;
        match (self.uploadTexturedBatch(textured_batch)) {
            case Ok(v) => { frame_textured_vertex_handle = v; }
            case Err(e) => { segments.destroy(); clip_mask_batch.destroy(); textured_batch.destroy(); batch.destroy(); return Err(e); }
        }
        var clip_mask_vertex_handle: rawptr = null;
        match (self.uploadClipMaskBatch(clip_mask_batch)) {
            case Ok(v) => { clip_mask_vertex_handle = v; }
            case Err(e) => { segments.destroy(); clip_mask_batch.destroy(); textured_batch.destroy(); batch.destroy(); return Err(e); }
        }
        let clip_mask_vertex_count = clip_mask_batch.vertexCount();
        clip_mask_batch.destroy();

        let frame_index = 0 as u32;
        match (self.sync.waitForFrame(frame_index)) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); return Err(Error.create(21, e.message)); } }
        var image_index: u32 = 0 as u32;
        match (self.swapchain.acquireNextImage(&self.sync, frame_index)) {
            case Ok(v) => { image_index = v; }
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); return Err(Error.create(22, e.message)); }
        }
        match (self.sync.resetFrameFence(frame_index)) {
            case Ok(_) => {}
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); return Err(Error.create(23, e.message)); }
        }

        var back_buffer: Texture;
        match (self.swapchain.backBuffer(image_index)) {
            case Ok(v) => { back_buffer = v; }
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); return Err(Error.create(24, e.message)); }
        }

        match (self.command.reset()) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(Error.create(25, e.message)); } }
        match (self.command.begin(true, false)) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(Error.create(26, e.message)); } }
        match (self.recordCustomRenderTargets()) {
            case Ok(_) => {}
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(e); }
        }
        if (self.last_frame_clip_path_count > 0) {
            if (!self.clip_stencil_ready) {
                match (self.command.transitionImage(&self.clip_stencil_texture, image_transition_undefined_to_depth_attachment())) {
                    case Ok(_) => { self.clip_stencil_ready = true; }
                    case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(Error.create(139, e.message)); }
                }
            }
        }
        match (self.clearLayerTargetsForFrameCompiled(graph, segments, frame_vertex_handle, frame_textured_vertex_handle, clip_mask_vertex_handle, clip_mask_vertex_count)) {
            case Ok(_) => {}
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(e); }
        }
        match (self.command.transitionImage(&back_buffer, image_transition_undefined_to_color_attachment())) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); back_buffer.destroy(); return Err(Error.create(27, e.message)); } }
        let area = Rect2D.create(0, 0, self.width, self.height);
        var info = RenderingInfo.create(area);
        info = info.addColorAttachment(RenderingAttachmentInfo.color(&back_buffer, self.clear_color.r, self.clear_color.g, self.clear_color.b, self.clear_color.a));
        if (self.last_frame_clip_path_count > 0) {
            info = info.setDepthAttachment(RenderingAttachmentInfo.stencil(&self.clip_stencil_texture, 0 as u32));
            info = info.setStencilAttachment(RenderingAttachmentInfo.stencil(&self.clip_stencil_texture, 0 as u32));
        }
        match (self.command.beginRendering(&info)) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(28, e.message)); } }
        if (self.last_frame_clip_path_count > 0) {
            match (self.drawClipMask(clip_mask_vertex_handle, clip_mask_vertex_count)) {
                case Ok(_) => {}
                case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(e); }
            }
        }
        match (self.drawSegments(segments, frame_vertex_handle, frame_textured_vertex_handle, self.sprite_descriptor_set.clone(), 0, true)) {
            case Ok(_) => {}
            case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(e); }
        }
        match (self.command.endRendering()) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(34, e.message)); } }
        match (self.command.transitionImage(&back_buffer, image_transition_color_attachment_to_present())) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(35, e.message)); } }
        match (self.command.end()) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(36, e.message)); } }
        match (self.queue.submit(&self.command, &self.sync, frame_index)) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(37, e.message)); } }
        match (self.swapchain.present(&self.queue, &self.sync, frame_index)) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(38, e.message)); } }
        match (self.queue.waitIdle()) { case Ok(_) => {} case Err(e) => { segments.destroy(); textured_batch.destroy(); batch.destroy(); info.color_attachments.destroy(); back_buffer.destroy(); return Err(Error.create(39, e.message)); } }
        self.last_frame_vertices = batch.vertexCount() + textured_batch.vertexCount();
        self.last_frame_textured_vertices = textured_batch.vertexCount();
        self.last_frame_draw_commands = graph.drawCommandCount();
        self.last_frame_segments = segments.len as i32;
        self.last_frame_uploaded_bytes = self.last_frame_solid_uploaded_bytes + self.last_frame_textured_uploaded_bytes;
        if (cpu_clip_path_count > 0) {
            self.last_frame_clip_path_bounds_fallback_count = self.last_frame_clip_path_bounds_fallback_count - cpu_clip_path_count;
            if (self.last_frame_clip_path_bounds_fallback_count < 0) { self.last_frame_clip_path_bounds_fallback_count = 0; }
        }
        segments.destroy();
        textured_batch.destroy();
        batch.destroy();
        info.color_attachments.destroy();
        back_buffer.destroy();
        self.custom_descriptor_frame_generation = self.custom_descriptor_frame_generation + 1;
        return Ok(0);
    }

    public fn renderCanvas(&mut self, canvas: Canvas) -> Result<i32, Error> {
        var graph = canvas.build();
        let result = self.renderGraph(graph);
        graph.destroy();
        return result;
    }

    private fn isRecoverableFrameError(&self, code: i32) -> bool {
        return code == 22 || code == 24 || code == 37 || code == 38 || code == 39 || code == 166;
    }

    public fn recreateDeviceResources(&mut self, window: Window) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        self.device_recreate_attempt_count = self.device_recreate_attempt_count + 1;
        self.last_device_recreate_error_code = 0;
        self.last_device_recreate_invalidated_descriptor_count = 0;
        self.last_device_recreate_cleared_pipeline_count = 0;
        self.last_device_recreate_purged_transient_count = 0;
        self.last_device_recreate_purged_transient_bytes = 0 as u64;
        self.last_device_recreate_swapchain_generation_before = self.swapchain_generation;
        self.last_device_recreate_swapchain_generation_after = self.swapchain_generation;
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                self.last_device_recreate_error_code = 156;
                self.device_recreate_failure_count = self.device_recreate_failure_count + 1;
                return Err(Error.create(156, e.message));
            }
        }
        self.destroyCustomRenderResources();
        var handler_i: i64 = 0;
        while (handler_i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(handler_i);
            var handler = slot[0].handler.deref();
            handler.release();
            handler_i = handler_i + 1;
        }
        self.custom_render_descriptor_pool.destroy();
        self.custom_render_descriptor_pool = DescriptorPool.empty();
        match (self.purgeTransientResources()) {
            case Ok(v) => {
                self.last_device_recreate_purged_transient_count = v;
                self.last_device_recreate_purged_transient_bytes = self.last_purged_transient_resource_bytes;
            }
            case Err(e) => {
                self.last_device_recreate_error_code = e.codeValue();
                self.device_recreate_failure_count = self.device_recreate_failure_count + 1;
                return Err(e);
            }
        }
        self.last_device_recreate_invalidated_descriptor_count = self.invalidateAllCustomPipelineDynamicDescriptors();
        if (self.custom_descriptor_pool.isValid()) {
            self.custom_descriptor_pool.destroy();
            self.custom_descriptor_pool_capacity = 0;
            self.custom_descriptor_pool_allocated_count = 0;
            self.custom_descriptor_pool_generation = self.custom_descriptor_pool_generation + 1;
            self.custom_descriptor_pool_recreate_count = self.custom_descriptor_pool_recreate_count + 1;
        }
        self.last_device_recreate_cleared_pipeline_count = self.custom_pipelines.len as i32;
        if (self.last_device_recreate_cleared_pipeline_count > 0) {
            self.clearCustomPipelines();
        }
        match (self.resizeToWindow(window)) {
            case Ok(_) => {}
            case Err(e) => {
                self.last_device_recreate_error_code = e.codeValue();
                self.last_device_recreate_swapchain_generation_after = self.swapchain_generation;
                self.device_recreate_failure_count = self.device_recreate_failure_count + 1;
                return Err(e);
            }
        }
        self.device_generation = self.device_generation + 1;
        self.device_recreate_success_count = self.device_recreate_success_count + 1;
        self.last_device_recreate_swapchain_generation_after = self.swapchain_generation;
        return Ok(0);
    }

    @[borrow_args]
    public fn renderGraphToWindow(&mut self, window: Window, graph: RenderGraph) -> Result<i32, Error> {
        self.last_frame_error_code = 0;
        self.last_frame_error_kind = rendererFrameErrorKindNone();
        self.last_frame_recovered = false;
        self.last_recovery_error_code = 0;
        self.last_recovery_error_kind = rendererFrameErrorKindNone();
        self.last_recovery_attempted = false;
        self.last_recovery_resize_succeeded = false;
        self.last_recovery_retry_succeeded = false;
        self.last_recovery_resize_was_noop = false;
        self.last_recovery_resize_error_code = 0;
        self.last_recovery_retry_error_code = 0;
        self.last_recovery_retry_error_kind = rendererFrameErrorKindNone();
        self.last_recovery_purged_transient_count = 0;
        self.last_recovery_purged_transient_bytes = 0 as u64;
        self.last_recovery_swapchain_generation_before = self.swapchain_generation;
        self.last_recovery_swapchain_generation_after = self.swapchain_generation;
        self.last_recovery_action = rendererRecoveryActionNone();
        self.last_recovery_device_recreate_recommended = false;
        self.last_recovery_retry_attempt_count = 0;
        self.last_recovery_full_reset_required = false;
        match (self.syncToWindow(window)) {
            case Ok(_) => {}
            case Err(e) => {
                self.last_frame_error_code = e.codeValue();
                self.last_frame_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                return Err(e);
            }
        }
        match (self.renderGraph(graph)) {
            case Ok(v) => {
                self.last_frame_error_code = 0;
                self.last_frame_error_kind = rendererFrameErrorKindNone();
                self.frame_recovery_successful_frame_count = self.frame_recovery_successful_frame_count + 1;
                self.frame_recovery_consecutive_failure_count = 0;
                return Ok(v);
            }
            case Err(e) => {
                if (!self.isRecoverableFrameError(e.codeValue())) {
                    self.last_frame_error_code = e.codeValue();
                    self.last_frame_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                    self.last_recovery_action = rendererRecoveryActionFailed();
                    self.frame_recovery_consecutive_failure_count = self.frame_recovery_consecutive_failure_count + 1;
                    if (self.frame_recovery_consecutive_failure_count > self.frame_recovery_max_consecutive_failure_count) {
                        self.frame_recovery_max_consecutive_failure_count = self.frame_recovery_consecutive_failure_count;
                    }
                    return Err(e);
                }
                self.last_recovery_error_code = e.codeValue();
                self.last_recovery_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                self.last_recovery_attempted = true;
                self.last_recovery_action = rendererRecoveryActionResizeSwapchain();
                self.last_recovery_device_recreate_recommended = self.last_recovery_error_kind == rendererFrameErrorKindDeviceLost();
                self.frame_recovery_attempt_count = self.frame_recovery_attempt_count + 1;
                let recovery_resize_count_before = self.resize_count;
                let recovery_noop_count_before = self.resize_noop_count;
                self.last_recovery_swapchain_generation_before = self.swapchain_generation;
                if (self.last_recovery_device_recreate_recommended) {
                    self.last_recovery_action = rendererRecoveryActionDeviceRecreateRecommended();
                    match (self.recreateDeviceResources(window)) {
                        case Ok(_) => {}
                        case Err(recovery_recreate_error) => {
                            self.last_recovery_resize_error_code = recovery_recreate_error.codeValue();
                            self.last_recovery_swapchain_generation_after = self.swapchain_generation;
                            self.last_frame_error_code = e.codeValue();
                            self.last_frame_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                            self.last_recovery_action = rendererRecoveryActionFailed();
                            self.last_recovery_full_reset_required = true;
                            self.frame_recovery_consecutive_failure_count = self.frame_recovery_consecutive_failure_count + 1;
                            if (self.frame_recovery_consecutive_failure_count > self.frame_recovery_max_consecutive_failure_count) {
                                self.frame_recovery_max_consecutive_failure_count = self.frame_recovery_consecutive_failure_count;
                            }
                            return Err(e);
                        }
                    }
                    self.last_recovery_purged_transient_count = self.last_device_recreate_purged_transient_count;
                    self.last_recovery_purged_transient_bytes = self.last_device_recreate_purged_transient_bytes;
                } else {
                    match (self.resizeToWindow(window)) {
                        case Ok(_) => {}
                        case Err(recovery_resize_error) => {
                            self.last_recovery_resize_error_code = recovery_resize_error.codeValue();
                            self.last_recovery_swapchain_generation_after = self.swapchain_generation;
                            self.last_frame_error_code = e.codeValue();
                            self.last_frame_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                            self.last_recovery_action = rendererRecoveryActionFailed();
                            self.last_recovery_full_reset_required = self.last_recovery_device_recreate_recommended;
                            self.frame_recovery_consecutive_failure_count = self.frame_recovery_consecutive_failure_count + 1;
                            if (self.frame_recovery_consecutive_failure_count > self.frame_recovery_max_consecutive_failure_count) {
                                self.frame_recovery_max_consecutive_failure_count = self.frame_recovery_consecutive_failure_count;
                            }
                            return Err(e);
                        }
                    }
                    self.last_recovery_purged_transient_count = self.last_resize_purged_transient_count;
                    self.last_recovery_purged_transient_bytes = self.last_resize_purged_transient_bytes;
                }
                self.last_recovery_resize_succeeded = true;
                self.last_recovery_resize_was_noop = self.resize_noop_count > recovery_noop_count_before && self.resize_count == recovery_resize_count_before;
                self.last_recovery_swapchain_generation_after = self.swapchain_generation;
                if (self.last_recovery_error_kind == rendererFrameErrorKindDeviceLost() && self.transientResourceCount() > 0) {
                    self.last_recovery_action = rendererRecoveryActionPurgeTransientResources();
                    match (self.purgeTransientResources()) {
                        case Ok(_) => {
                            self.last_recovery_purged_transient_count = self.last_recovery_purged_transient_count + self.last_purged_transient_resource_count;
                            self.last_recovery_purged_transient_bytes = self.last_recovery_purged_transient_bytes + self.last_purged_transient_resource_bytes;
                        }
                        case Err(purge_error) => {
                            self.last_recovery_resize_error_code = purge_error.codeValue();
                            self.last_frame_error_code = e.codeValue();
                            self.last_frame_error_kind = rendererFrameErrorKindFromCode(e.codeValue());
                            self.last_recovery_action = rendererRecoveryActionFailed();
                            self.last_recovery_full_reset_required = true;
                            self.frame_recovery_consecutive_failure_count = self.frame_recovery_consecutive_failure_count + 1;
                            if (self.frame_recovery_consecutive_failure_count > self.frame_recovery_max_consecutive_failure_count) {
                                self.frame_recovery_max_consecutive_failure_count = self.frame_recovery_consecutive_failure_count;
                            }
                            return Err(e);
                        }
                    }
                }
                self.last_recovery_action = rendererRecoveryActionRetryFrame();
                self.last_recovery_retry_attempt_count = self.last_recovery_retry_attempt_count + 1;
                match (self.renderGraph(graph)) {
                    case Ok(v) => {
                        self.frame_recovery_count = self.frame_recovery_count + 1;
                        self.frame_recovery_successful_frame_count = self.frame_recovery_successful_frame_count + 1;
                        self.frame_recovery_consecutive_failure_count = 0;
                        self.last_frame_recovered = true;
                        self.last_recovery_retry_succeeded = true;
                        self.last_frame_error_code = 0;
                        self.last_frame_error_kind = rendererFrameErrorKindNone();
                        return Ok(v);
                    }
                    case Err(retry_error) => {
                        self.last_frame_error_code = retry_error.codeValue();
                        self.last_frame_error_kind = rendererFrameErrorKindFromCode(retry_error.codeValue());
                        self.last_recovery_retry_error_code = retry_error.codeValue();
                        self.last_recovery_retry_error_kind = rendererFrameErrorKindFromCode(retry_error.codeValue());
                        self.last_recovery_action = rendererRecoveryActionFailed();
                        self.last_recovery_full_reset_required = self.last_recovery_device_recreate_recommended || self.last_recovery_retry_error_kind == rendererFrameErrorKindDeviceLost();
                        self.frame_recovery_consecutive_failure_count = self.frame_recovery_consecutive_failure_count + 1;
                        if (self.frame_recovery_consecutive_failure_count > self.frame_recovery_max_consecutive_failure_count) {
                            self.frame_recovery_max_consecutive_failure_count = self.frame_recovery_consecutive_failure_count;
                        }
                        return Err(retry_error);
                    }
                }
            }
        }
    }

    public fn renderCanvasToWindow(&mut self, window: Window, canvas: Canvas) -> Result<i32, Error> {
        var graph = canvas.build();
        let result = self.renderGraphToWindow(window, graph);
        graph.destroy();
        return result;
    }

    public fn framebufferWidth(&self) -> u32 {
        return self.width;
    }

    public fn framebufferHeight(&self) -> u32 {
        return self.height;
    }

    public fn cachedVertexCapacity(&self) -> i32 {
        return self.frame_vertex_capacity;
    }

    public fn cachedTexturedVertexCapacity(&self) -> i32 {
        return self.frame_textured_vertex_capacity;
    }

    public fn cachedClipMaskVertexCapacity(&self) -> i32 {
        return self.clip_mask_vertex_capacity;
    }

    public fn frameVertexReallocCount(&self) -> i32 {
        return self.frame_vertex_realloc_count;
    }

    public fn frameTexturedVertexReallocCount(&self) -> i32 {
        return self.frame_textured_vertex_realloc_count;
    }

    public fn clipMaskVertexReallocCount(&self) -> i32 {
        return self.clip_mask_vertex_realloc_count;
    }

    public fn spriteTextureWidth(&self) -> u32 {
        return self.sprite_texture_width;
    }

    public fn spriteTextureHeight(&self) -> u32 {
        return self.sprite_texture_height;
