                if (!segment_open || current_segment_material != 0 || current_segment_target != current_layer_depth || current_segment_pipeline_id != current_solid_pipeline_id) {
                    if (segment_open) {
                        var previous_vertices: i32 = 0;
                        if (current_segment_material == 0) { previous_vertices = batch.vertexCount() - segment_start; }
                        else { previous_vertices = textured_batch.vertexCount() - segment_start; }
                        if (previous_vertices > 0) { segments.push(BatchSegment.createWithPipelineConstants(segment_start, previous_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip)); }
                    }
                    segment_open = true;
                    current_segment_material = 0;
                    current_segment_target = current_layer_depth;
                    current_segment_pipeline_id = current_solid_pipeline_id;
                    segment_start = batch.vertexCount();
                }
                let rect_quad = transformRect(command.rect, current_transform);
                if (active_clip_paths.len > 0) {
                    let added = self.addActiveClipPathsClippedQuad(&mut batch, rect_quad, colorWithLayerAlpha(command.color, current_alpha), graph, active_clip_paths, fw, fh);
                    if (added > 0) { cpu_clip_path_count = cpu_clip_path_count + (active_clip_paths.len as i32); }
                } else {
                    batch.addQuad(rect_quad, colorWithLayerAlpha(command.color, current_alpha), fw, fh);
                }
            }
            if (command.kind.equals(RenderCommandKind.fillCircle())) {
                if (!segment_open || current_segment_material != 0 || current_segment_target != current_layer_depth || current_segment_pipeline_id != current_solid_pipeline_id) {
                    if (segment_open) {
                        var previous_vertices: i32 = 0;
                        if (current_segment_material == 0) { previous_vertices = batch.vertexCount() - segment_start; }
                        else { previous_vertices = textured_batch.vertexCount() - segment_start; }
                        if (previous_vertices > 0) { segments.push(BatchSegment.createWithPipelineConstants(segment_start, previous_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip)); }
                    }
                    segment_open = true;
                    current_segment_material = 0;
                    current_segment_target = current_layer_depth;
                    current_segment_pipeline_id = current_solid_pipeline_id;
                    segment_start = batch.vertexCount();
                }
                if (active_clip_paths.len > 0) {
                    let added = self.addActiveClipPathsClippedCircle(&mut batch, command.circle, colorWithLayerAlpha(command.color, current_alpha), current_transform, graph, active_clip_paths, fw, fh);
                    if (added > 0) { cpu_clip_path_count = cpu_clip_path_count + (active_clip_paths.len as i32); }
                } else if (current_transform.a == 1.0 && current_transform.b == 0.0 && current_transform.c == 0.0 && current_transform.d == 1.0) {
                    let moved_circle = Circle.xy(command.circle.x + current_transform.tx, command.circle.y + current_transform.ty, command.circle.radius);
                    batch.addCircle(moved_circle, colorWithLayerAlpha(command.color, current_alpha), fw, fh);
                } else {
                    batch.addQuad(transformCircleToQuad(command.circle, current_transform), colorWithLayerAlpha(command.color, current_alpha), fw, fh);
                }
            }
            if (command.kind.equals(RenderCommandKind.fillTriangle())) {
                if (!segment_open || current_segment_material != 0 || current_segment_target != current_layer_depth || current_segment_pipeline_id != current_solid_pipeline_id) {
                    if (segment_open) {
                        var previous_vertices: i32 = 0;
                        if (current_segment_material == 0) { previous_vertices = batch.vertexCount() - segment_start; }
                        else { previous_vertices = textured_batch.vertexCount() - segment_start; }
                        if (previous_vertices > 0) { segments.push(BatchSegment.createWithPipelineConstants(segment_start, previous_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip)); }
                    }
                    segment_open = true;
                    current_segment_material = 0;
                    current_segment_target = current_layer_depth;
                    current_segment_pipeline_id = current_solid_pipeline_id;
                    segment_start = batch.vertexCount();
                }
                let tri = transformTriangle(command.triangle, current_transform);
                if (active_clip_paths.len > 0) {
