        self.custom_pipelines.push(CustomPipelineSlot.createWithClip(pipeline_id, pipeline.clone(), clip_pipeline.clone(), self.pipeline_layout.clone(), self.pipeline_layout.clone(), rendererCustomPipelineMaterialSolid(), self.device_generation));
        self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
