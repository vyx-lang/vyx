    public fn customPipelineCount(&self) -> i32 {
        return self.custom_pipelines.len as i32;
    }

    public fn customPipelineGeneration(&self) -> i32 {
        return self.custom_pipeline_generation;
    }

    public fn customPipelineBindCount(&self) -> i32 {
        return self.custom_pipeline_bind_count;
    }

    public fn customPipelineClipBindCount(&self) -> i32 {
        return self.custom_pipeline_clip_bind_count;
    }

    public fn customPipelineMissingCount(&self) -> i32 {
        return self.custom_pipeline_missing_count;
    }

    public fn customPipelineClipMissingCount(&self) -> i32 {
        return self.custom_pipeline_clip_missing_count;
    }

    public fn customPipelineRegisterCount(&self) -> i32 {
        return self.custom_pipeline_register_count;
    }

    public fn customPipelineReplaceCount(&self) -> i32 {
        return self.custom_pipeline_replace_count;
    }

    public fn customPipelineUnregisterCount(&self) -> i32 {
        return self.custom_pipeline_unregister_count;
    }

    public fn customPipelineClipUnregisterCount(&self) -> i32 {
        return self.custom_pipeline_clip_unregister_count;
    }

    public fn customPipelineClearCount(&self) -> i32 {
        return self.custom_pipeline_clear_count;
    }

    public fn lastCustomPipelineId(&self) -> i32 {
        return self.last_custom_pipeline_id;
    }

    public fn lastCustomPipelineErrorCode(&self) -> i32 {
        return self.last_custom_pipeline_error_code;
    }

    public fn lastCustomPipelineMissingId(&self) -> i32 {
        return self.last_custom_pipeline_missing_id;
    }

    public fn lastCustomPipelineRegisteredId(&self) -> i32 {
        return self.last_custom_pipeline_registered_id;
    }

    public fn lastCustomPipelineUnregisteredId(&self) -> i32 {
        return self.last_custom_pipeline_unregistered_id;
    }

    public fn customPipelineIdAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.customPipelineCount()) { return -1; }
        return self.custom_pipelines.get(index as i64).id;
    }

    public fn hasCustomPipeline(&self, pipeline_id: i32) -> bool {
        return self.customPipelineIndex(pipeline_id) >= 0;
    }

    public fn hasCustomPipelineClipVariant(&self, pipeline_id: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        return self.custom_pipelines.get(idx as i64).has_clip_pipeline;
    }

    public fn unregisterCustomPipelineClipVariant(&mut self, pipeline_id: i32) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        var slot = self.custom_pipelines.get(idx as i64);
        if (!slot.has_clip_pipeline) { return Ok(0); }
        slot.clip_pipeline.destroy();
        slot.clip_pipeline = slot.pipeline.clone();
        if (slot.owns_clip_layout) { slot.clip_layout.destroy(); }
        slot.clip_layout = slot.layout.clone();
        slot.has_clip_pipeline = false;
        slot.owns_clip_layout = false;
        self.custom_pipelines.set(idx as i64, slot);
        self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
        self.custom_pipeline_clip_unregister_count = self.custom_pipeline_clip_unregister_count + 1;
        self.last_custom_pipeline_unregistered_id = pipeline_id;
        return Ok(0);
    }

    public fn unregisterCustomPipeline(&mut self, pipeline_id: i32) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        var slot = self.custom_pipelines.removeAt(idx as i64);
        self.destroyCustomPipelineSlot(slot);
        self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
        self.custom_pipeline_unregister_count = self.custom_pipeline_unregister_count + 1;
        self.last_custom_pipeline_unregistered_id = pipeline_id;
        return Ok(0);
    }

    public fn clearCustomPipelines(&mut self) -> i32 {
        let removed = self.custom_pipelines.len as i32;
        var i: i64 = 0;
        while (i < self.custom_pipelines.len) {
            var slot = self.custom_pipelines.get(i);
            self.destroyCustomPipelineSlot(slot);
            i = i + 1;
        }
        self.custom_pipelines.clear();
        if (removed > 0) {
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_clear_count = self.custom_pipeline_clear_count + 1;
            self.last_custom_pipeline_unregistered_id = -1;
        }
        return 0;
    }

    public fn registerDefaultSolidPipelineAs(&mut self, pipeline_id: i32) -> Result<i32, Error> {
        return self.registerCustomPipelineWithClip(pipeline_id, self.solid_pipeline.clone(), self.solid_clip_pipeline.clone());
    }

    public fn registerDefaultTexturedPipelineAs(&mut self, pipeline_id: i32) -> Result<i32, Error> {
        return self.registerCustomTexturedPipelineWithClip(pipeline_id, self.textured_pipeline.clone(), self.textured_clip_pipeline.clone());
    }

    private fn createSolidShaderPipeline(&self, shader_path: string, vertex_entry: string, fragment_entry: string, clipped: bool) -> Result<GraphicsPipeline, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        if (vertex_entry.len == 0 || fragment_entry.len == 0) {
            return Err(Error.create(157, "custom shader entry point is empty"));
        }
        var resolved_shader_path: string;
        match (nutResolveShaderPath(shader_path)) {
            case Ok(v) => { resolved_shader_path = v; }
            case Err(e) => { return Err(e); }
        }
        var vertex_shader: ShaderModule;
        match (self.compiler.compileOrLoad(&self.device, ShaderDesc { source_path: resolved_shader_path, entry_point: vertex_entry, stage: shader_stage_vertex(), profile: "" })) {
            case Ok(v) => { vertex_shader = v; }
            case Err(e) => { return Err(Error.create(158, e.message)); }
        }
        var fragment_shader: ShaderModule;
        match (self.compiler.compileOrLoad(&self.device, ShaderDesc { source_path: resolved_shader_path, entry_point: fragment_entry, stage: shader_stage_fragment(), profile: "" })) {
            case Ok(v) => { fragment_shader = v; }
            case Err(e) => {
                vertex_shader.destroy();
                return Err(Error.create(159, e.message));
            }
        }
        var swap_format: u32;
        match (self.swapchain.format()) {
            case Ok(v) => { swap_format = v; }
            case Err(e) => {
                fragment_shader.destroy();
                vertex_shader.destroy();
                return Err(Error.create(160, e.message));
            }
        }
        var pipeline_desc = GraphicsPipelineDesc.create(&self.pipeline_layout);
        pipeline_desc = pipeline_desc.addShader(&vertex_shader);
        pipeline_desc = pipeline_desc.addShader(&fragment_shader);
        pipeline_desc = pipeline_desc.addVertexBinding(0, sizeof::<SolidVertex>() as u32);
        pipeline_desc = pipeline_desc.addVertexAttribute(0, 0, format_rg32_float(), 0, "POSITION", 0);
        pipeline_desc = pipeline_desc.addVertexAttribute(1, 0, format_rgba32_float(), 8, "COLOR", 0);
        pipeline_desc = pipeline_desc.setCullMode(cull_none());
        pipeline_desc.color_blend_attachments.push(straightAlphaBlendState());
        pipeline_desc = pipeline_desc.addColorFormat(swap_format);
        if (clipped) {
            pipeline_desc = pipeline_desc.setStencilEqual(1 as u32);
            pipeline_desc = pipeline_desc.setDepthStencilFormat(format_d24_unorm_s8_uint());
        }
        var pipeline: GraphicsPipeline;
        match (self.device.createGraphicsPipeline(pipeline_desc)) {
            case Ok(v) => { pipeline = v; }
            case Err(e) => {
                fragment_shader.destroy();
                vertex_shader.destroy();
                return Err(Error.create(161, e.message));
            }
        }
        fragment_shader.destroy();
        vertex_shader.destroy();
        return Ok(pipeline);
    }

    private fn createCustomShaderPipeline(&self, desc: &CustomPipelineDesc, clipped: bool) -> Result<BuiltCustomPipeline, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        match (desc.validate()) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        var resolved_shader_path: string;
        match (nutResolveShaderPath(desc.shader_path)) {
            case Ok(v) => { resolved_shader_path = v; }
            case Err(e) => { return Err(e); }
        }
        var vertex_shader: ShaderModule;
        match (self.compiler.compileOrLoad(&self.device, ShaderDesc { source_path: resolved_shader_path, entry_point: desc.vertex_entry, stage: shader_stage_vertex(), profile: "" })) {
            case Ok(v) => { vertex_shader = v; }
            case Err(e) => { return Err(Error.create(158, e.message)); }
        }
        var fragment_shader: ShaderModule;
        match (self.compiler.compileOrLoad(&self.device, ShaderDesc { source_path: resolved_shader_path, entry_point: desc.fragment_entry, stage: shader_stage_fragment(), profile: "" })) {
            case Ok(v) => { fragment_shader = v; }
            case Err(e) => {
                vertex_shader.destroy();
                return Err(Error.create(159, e.message));
            }
        }
        var layout_desc = PipelineLayoutDesc.empty();
        if (desc.use_sprite_descriptors) {
            layout_desc = layout_desc.addSetLayout(&self.sprite_set_layout);
        }
        var custom_set_i: i64 = 0;
        while (custom_set_i < desc.custom_set_layouts.len) {
            layout_desc = layout_desc.addSetLayout(desc.custom_set_layouts.get(custom_set_i).clone());
            custom_set_i = custom_set_i + 1;
        }
        if (desc.push_constant_size > 0 as u32) {
            layout_desc = layout_desc.addPushConstants(desc.push_constant_stage_flags, 0 as u32, desc.push_constant_size);
        }
        var custom_layout: PipelineLayout;
        match (self.device.createPipelineLayout(layout_desc)) {
            case Ok(v) => { custom_layout = v; }
            case Err(e) => {
                fragment_shader.destroy();
                vertex_shader.destroy();
                return Err(Error.create(164, e.message));
            }
        }
        var swap_format: u32;
        match (self.swapchain.format()) {
            case Ok(v) => { swap_format = v; }
            case Err(e) => {
                custom_layout.destroy();
                fragment_shader.destroy();
                vertex_shader.destroy();
                return Err(Error.create(160, e.message));
            }
        }
        var pipeline_desc = GraphicsPipelineDesc.create(&custom_layout);
        pipeline_desc = pipeline_desc.addShader(&vertex_shader);
        pipeline_desc = pipeline_desc.addShader(&fragment_shader);
        if (desc.custom_vertex_bindings.len > 0 || desc.custom_vertex_attributes.len > 0) {
            var binding_i: i64 = 0;
            while (binding_i < desc.custom_vertex_bindings.len) {
                let binding = desc.custom_vertex_bindings.get(binding_i);
                pipeline_desc.vertex_bindings.push(binding);
                binding_i = binding_i + 1;
            }
            var attr_i: i64 = 0;
            while (attr_i < desc.custom_vertex_attributes.len) {
                let attr = desc.custom_vertex_attributes.get(attr_i);
                pipeline_desc.vertex_attributes.push(attr);
                attr_i = attr_i + 1;
            }
        } else if (desc.vertex_layout_kind == rendererCustomPipelineVertexLayoutTextured()) {
            pipeline_desc = pipeline_desc.addVertexBinding(0, sizeof::<TexturedVertex>() as u32);
            pipeline_desc = pipeline_desc.addVertexAttribute(0, 0, format_rg32_float(), 0, "POSITION", 0);
            pipeline_desc = pipeline_desc.addVertexAttribute(1, 0, format_rg32_float(), 8, "TEXCOORD", 0);
            pipeline_desc = pipeline_desc.addVertexAttribute(2, 0, format_r32_float(), 16, "TEXCOORD", 1);
            pipeline_desc = pipeline_desc.addVertexAttribute(3, 0, format_rgba32_float(), 20, "COLOR", 0);
        } else if (desc.vertex_layout_kind == rendererCustomPipelineVertexLayoutSolid()) {
            pipeline_desc = pipeline_desc.addVertexBinding(0, sizeof::<SolidVertex>() as u32);
            pipeline_desc = pipeline_desc.addVertexAttribute(0, 0, format_rg32_float(), 0, "POSITION", 0);
            pipeline_desc = pipeline_desc.addVertexAttribute(1, 0, format_rgba32_float(), 8, "COLOR", 0);
        }
        pipeline_desc = pipeline_desc.setTopology(desc.topology);
        pipeline_desc = pipeline_desc.setCullMode(desc.cull_mode);
        pipeline_desc = pipeline_desc.setLineWidth(desc.line_width);
        pipeline_desc = pipeline_desc.setDepthTest(desc.depth_test_enabled, desc.depth_write_enabled);
        pipeline_desc = pipeline_desc.setDepthCompare(desc.depth_compare_op);
        if (desc.blend_enabled) {
            pipeline_desc.color_blend_attachments.push(straightAlphaBlendState());
        } else {
            pipeline_desc = pipeline_desc.addColorAttachmentDefault();
        }
        pipeline_desc = pipeline_desc.addColorFormat(swap_format);
        if (clipped) {
            pipeline_desc = pipeline_desc.setStencilEqual(1 as u32);
            pipeline_desc = pipeline_desc.setDepthStencilFormat(format_d24_unorm_s8_uint());
        }
        var pipeline: GraphicsPipeline;
        match (self.device.createGraphicsPipeline(pipeline_desc)) {
            case Ok(v) => { pipeline = v; }
            case Err(e) => {
                custom_layout.destroy();
                fragment_shader.destroy();
                vertex_shader.destroy();
                return Err(Error.create(161, e.message));
            }
        }
        fragment_shader.destroy();
        vertex_shader.destroy();
        return Ok(BuiltCustomPipeline.create(pipeline, custom_layout));
    }

    private fn installBuiltCustomPipeline(&mut self, pipeline_id: i32, mut built: BuiltCustomPipeline, desc: &CustomPipelineDesc) -> Result<i32, Error> {
        if (pipeline_id <= 0) { built.destroy(); return Err(Error.create(137, "custom pipeline id must be positive")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx >= 0) {
            var old_slot = self.custom_pipelines.removeAt(idx as i64);
            self.destroyCustomPipelineSlot(old_slot);
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_replace_count = self.custom_pipeline_replace_count + 1;
        } else {
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_register_count = self.custom_pipeline_register_count + 1;
        }
        var static_sets = Vec::<DescriptorSet>.new();
        var static_i: i64 = 0;
        while (static_i < desc.static_descriptor_sets.len) {
            static_sets.push(desc.static_descriptor_sets.get(static_i).clone());
            static_i = static_i + 1;
        }
        let vertex_bindings = self.cloneCustomPipelineVertexBindings(desc);
        let vertex_attributes = self.cloneCustomPipelineVertexAttributes(desc);
        let descriptor_layouts = self.cloneCustomPipelineDescriptorSetLayouts(desc);
        self.custom_pipelines.push(CustomPipelineSlot.createOwned(pipeline_id, built.pipeline, built.layout, desc.material_kind, desc.vertex_layout_kind, desc.use_sprite_descriptors, vertex_bindings, vertex_attributes, desc.custom_set_layouts.len as i32, descriptor_layouts, static_sets, desc.push_constant_stage_flags, desc.push_constant_size, self.device_generation));
        self.last_custom_pipeline_registered_id = pipeline_id;
        return Ok(0);
    }

    private fn installBuiltCustomPipelineWithClip(&mut self, pipeline_id: i32, mut built: BuiltCustomPipeline, mut clip_built: BuiltCustomPipeline, desc: &CustomPipelineDesc) -> Result<i32, Error> {
        if (pipeline_id <= 0) { built.destroy(); clip_built.destroy(); return Err(Error.create(137, "custom pipeline id must be positive")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx >= 0) {
            var old_slot = self.custom_pipelines.removeAt(idx as i64);
            self.destroyCustomPipelineSlot(old_slot);
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_replace_count = self.custom_pipeline_replace_count + 1;
        } else {
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_register_count = self.custom_pipeline_register_count + 1;
        }
        var static_sets = Vec::<DescriptorSet>.new();
        var static_i: i64 = 0;
        while (static_i < desc.static_descriptor_sets.len) {
            static_sets.push(desc.static_descriptor_sets.get(static_i).clone());
            static_i = static_i + 1;
        }
        let vertex_bindings = self.cloneCustomPipelineVertexBindings(desc);
        let vertex_attributes = self.cloneCustomPipelineVertexAttributes(desc);
        let descriptor_layouts = self.cloneCustomPipelineDescriptorSetLayouts(desc);
        self.custom_pipelines.push(CustomPipelineSlot.createOwnedWithClip(pipeline_id, built.pipeline, clip_built.pipeline, built.layout, clip_built.layout, desc.material_kind, desc.vertex_layout_kind, desc.use_sprite_descriptors, vertex_bindings, vertex_attributes, desc.custom_set_layouts.len as i32, descriptor_layouts, static_sets, desc.push_constant_stage_flags, desc.push_constant_size, self.device_generation));
        self.last_custom_pipeline_registered_id = pipeline_id;
        return Ok(0);
    }

    public fn registerShaderPipelineAs(&mut self, pipeline_id: i32, desc: CustomPipelineDesc) -> Result<i32, Error> {
        var built: BuiltCustomPipeline;
        match (self.createCustomShaderPipeline(&desc, false)) {
            case Ok(v) => { built = v; }
            case Err(e) => { return Err(e); }
        }
        return self.installBuiltCustomPipeline(pipeline_id, built, &desc);
    }

    public fn registerShaderPipelineWithClipAs(&mut self, pipeline_id: i32, desc: CustomPipelineDesc, clip_desc: CustomPipelineDesc) -> Result<i32, Error> {
        if (!desc.isClipCompatibleWith(&clip_desc)) {
            return Err(Error.create(186, "custom pipeline clip variant layout is incompatible"));
        }
        var built: BuiltCustomPipeline;
        match (self.createCustomShaderPipeline(&desc, false)) {
            case Ok(v) => { built = v; }
            case Err(e) => { return Err(e); }
        }
        var clip_built: BuiltCustomPipeline;
        match (self.createCustomShaderPipeline(&clip_desc, true)) {
            case Ok(v) => { clip_built = v; }
            case Err(e) => {
                built.destroy();
                return Err(e);
            }
        }
        return self.installBuiltCustomPipelineWithClip(pipeline_id, built, clip_built, &desc);
    }

    private fn installOwnedCustomPipeline(&mut self, pipeline_id: i32, pipeline: GraphicsPipeline) -> Result<i32, Error> {
        if (pipeline_id <= 0) { return Err(Error.create(137, "custom pipeline id must be positive")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx >= 0) {
            var old_slot = self.custom_pipelines.removeAt(idx as i64);
            self.destroyCustomPipelineSlot(old_slot);
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_replace_count = self.custom_pipeline_replace_count + 1;
            self.last_custom_pipeline_registered_id = pipeline_id;
        } else {
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_register_count = self.custom_pipeline_register_count + 1;
            self.last_custom_pipeline_registered_id = pipeline_id;
        }
        self.custom_pipelines.push(CustomPipelineSlot.create(pipeline_id, pipeline, self.pipeline_layout.clone(), rendererCustomPipelineMaterialSolid(), self.device_generation));
        return Ok(0);
    }

    private fn installOwnedCustomPipelineWithClip(&mut self, pipeline_id: i32, pipeline: GraphicsPipeline, clip_pipeline: GraphicsPipeline) -> Result<i32, Error> {
        if (pipeline_id <= 0) { return Err(Error.create(137, "custom pipeline id must be positive")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx >= 0) {
            var old_slot = self.custom_pipelines.removeAt(idx as i64);
            self.destroyCustomPipelineSlot(old_slot);
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_replace_count = self.custom_pipeline_replace_count + 1;
            self.last_custom_pipeline_registered_id = pipeline_id;
        } else {
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_register_count = self.custom_pipeline_register_count + 1;
            self.last_custom_pipeline_registered_id = pipeline_id;
        }
        self.custom_pipelines.push(CustomPipelineSlot.createWithClip(pipeline_id, pipeline, clip_pipeline, self.pipeline_layout.clone(), self.pipeline_layout.clone(), rendererCustomPipelineMaterialSolid(), self.device_generation));
        return Ok(0);
    }

    public fn registerSolidShaderPipelineAs(&mut self, pipeline_id: i32, shader_path: string, vertex_entry: string, fragment_entry: string) -> Result<i32, Error> {
        if (pipeline_id <= 0) { return Err(Error.create(137, "custom pipeline id must be positive")); }
        var pipeline: GraphicsPipeline;
        match (self.createSolidShaderPipeline(shader_path, vertex_entry, fragment_entry, false)) {
            case Ok(v) => { pipeline = v; }
            case Err(e) => { return Err(e); }
        }
        return self.installOwnedCustomPipeline(pipeline_id, pipeline);
    }

    public fn registerSolidShaderPipelineWithClipAs(&mut self, pipeline_id: i32, shader_path: string, vertex_entry: string, fragment_entry: string, clip_vertex_entry: string, clip_fragment_entry: string) -> Result<i32, Error> {
        if (pipeline_id <= 0) { return Err(Error.create(137, "custom pipeline id must be positive")); }
        var pipeline: GraphicsPipeline;
        match (self.createSolidShaderPipeline(shader_path, vertex_entry, fragment_entry, false)) {
            case Ok(v) => { pipeline = v; }
            case Err(e) => { return Err(e); }
        }
        var clip_pipeline: GraphicsPipeline;
        match (self.createSolidShaderPipeline(shader_path, clip_vertex_entry, clip_fragment_entry, true)) {
            case Ok(v) => { clip_pipeline = v; }
            case Err(e) => {
                pipeline.destroy();
                return Err(e);
            }
        }
        return self.installOwnedCustomPipelineWithClip(pipeline_id, pipeline, clip_pipeline);
    }

    public fn registerTexturedShaderPipelineAs(&mut self, pipeline_id: i32, shader_path: string, vertex_entry: string, fragment_entry: string) -> Result<i32, Error> {
        return self.registerShaderPipelineAs(pipeline_id, CustomPipelineDesc.textured(shader_path, vertex_entry, fragment_entry));
    }

    public fn registerTexturedShaderPipelineWithClipAs(&mut self, pipeline_id: i32, shader_path: string, vertex_entry: string, fragment_entry: string, clip_vertex_entry: string, clip_fragment_entry: string) -> Result<i32, Error> {
        return self.registerShaderPipelineWithClipAs(pipeline_id, CustomPipelineDesc.textured(shader_path, vertex_entry, fragment_entry), CustomPipelineDesc.textured(shader_path, clip_vertex_entry, clip_fragment_entry));
    }

    private fn clipPathSignedArea(&self, graph: RenderGraph, state: ClipPathState) -> f32 {
        var area: f32 = 0.0;
        var i: i32 = 0;
        while (i < state.count) {
            let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, i));
            var next_i = i + 1;
            if (next_i >= state.count) { next_i = 0; }
            let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
            area = area + ((a.x * b.y) - (b.x * a.y));
            i = i + 1;
        }
        return area;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addClipPathMask(&self, batch: &mut SolidBatch, graph: RenderGraph, state: ClipPathState, fw: f32, fh: f32) -> i32 {
        if (!state.active || state.count < 3) { return 0; }
        let color = Color.rgba(0.0, 0.0, 0.0, 0.0);
        let origin = state.transform.transformPoint(graph.clipPathPoint(state.offset, 0));
        var added: i32 = 0;
        var tri_i: i32 = 1;
        while ((tri_i + 1) < state.count) {
            let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, tri_i));
            let c = state.transform.transformPoint(graph.clipPathPoint(state.offset, tri_i + 1));
            batch.addTriangle(origin, b, c, color, fw, fh);
            added = added + 3;
            tri_i = tri_i + 1;
        }
        return added;
    }

    @[borrow_args]
    private fn buildClipMaskBatch(&self, graph: RenderGraph, fw: f32, fh: f32) -> SolidBatch {
        let capacity = (self.last_frame_clip_path_count * 256) + 6;
        var mask_batch = SolidBatch.create(capacity);
        var transform_stack = Vec::<Transform2D>.new();
        var current_transform = Transform2D.identity();
        var i: i32 = 0;
        while (i < graph.commandCount()) {
            let command = graph.commandAt(i);
            if (command.kind.equals(RenderCommandKind.pushTransform())) {
                transform_stack.push(current_transform.clone());
                current_transform = current_transform.multiply(command.transform);
            }
            if (command.kind.equals(RenderCommandKind.popTransform())) {
                if (!transform_stack.isEmpty()) {
                    current_transform = transform_stack.pop();
                } else {
                    current_transform = Transform2D.identity();
                }
            }
            if (command.kind.equals(RenderCommandKind.pushClipPath())) {
                let clip_path_offset = command.stroke_width as i32;
                let clip_path_count = command.rect.x as i32;
                self.addClipPathMask(&mut mask_batch, graph, ClipPathState.create(clip_path_offset, clip_path_count, current_transform), fw, fh);
            }
            i = i + 1;
        }
        transform_stack.destroy();
        return mask_batch;
    }

    private fn clipPathPointInsideEdge(&self, p: Point, a: Point, b: Point, orientation: f32) -> bool {
        let cross = ((b.x - a.x) * (p.y - a.y)) - ((b.y - a.y) * (p.x - a.x));
        if (orientation >= (0.0 as f32)) { return cross >= (0.0 as f32); }
        return cross <= (0.0 as f32);
    }

    private fn clipPathLineIntersection(&self, p0: Point, p1: Point, a: Point, b: Point) -> Point {
        let x1 = p0.x;
        let y1 = p0.y;
        let x2 = p1.x;
        let y2 = p1.y;
        let x3 = a.x;
        let y3 = a.y;
        let x4 = b.x;
        let y4 = b.y;
        let denom = ((x1 - x2) * (y3 - y4)) - ((y1 - y2) * (x3 - x4));
        if (denom == (0.0 as f32)) { return p1.clone(); }
        let det1 = (x1 * y2) - (y1 * x2);
        let det2 = (x3 * y4) - (y3 * x4);
        return Point.xy(((det1 * (x3 - x4)) - ((x1 - x2) * det2)) / denom,
                        ((det1 * (y3 - y4)) - ((y1 - y2) * det2)) / denom);
    }

    @[borrow_args]
    private fn clipPolygonAgainstEdge(&self, input: Vec<Point>, a: Point, b: Point, orientation: f32) -> Vec<Point> {
        var output = Vec::<Point>.new();
        if (input.len <= 0) { return output; }
        var prev = input.get(input.len - 1);
        var prev_inside = self.clipPathPointInsideEdge(prev, a, b, orientation);
        var i: i64 = 0;
        while (i < input.len) {
            let cur = input.get(i);
            let cur_inside = self.clipPathPointInsideEdge(cur, a, b, orientation);
            if (cur_inside) {
                if (!prev_inside) {
                    output.push(self.clipPathLineIntersection(prev, cur, a, b));
                }
                output.push(cur.clone());
            } else if (prev_inside) {
                output.push(self.clipPathLineIntersection(prev, cur, a, b));
            }
            prev = cur;
            prev_inside = cur_inside;
            i = i + 1;
        }
        return output;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addClipPathClippedQuad(&self, batch: &mut SolidBatch, quad: Quad, color: Color, graph: RenderGraph, state: ClipPathState, fw: f32, fh: f32) -> i32 {
        if (!state.active || state.count < 3) { return 0; }
        var polygon = Vec::<Point>.new();
        polygon.push(quad.p0.clone());
        polygon.push(quad.p1.clone());
        polygon.push(quad.p2.clone());
        polygon.push(quad.p3.clone());
        let orientation = self.clipPathSignedArea(graph, state);
        var edge_i: i32 = 0;
        while (edge_i < state.count && polygon.len > 0) {
            let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, edge_i));
            var next_i = edge_i + 1;
            if (next_i >= state.count) { next_i = 0; }
            let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
            let next_polygon = self.clipPolygonAgainstEdge(polygon, a, b, orientation);
            polygon.destroy();
            polygon = next_polygon;
            edge_i = edge_i + 1;
        }
        var added: i32 = 0;
        if (polygon.len >= 3) {
            let origin = polygon.get(0);
            var tri_i: i64 = 1;
            while ((tri_i + 1) < polygon.len) {
                batch.addTriangle(origin, polygon.get(tri_i), polygon.get(tri_i + 1), color, fw, fh);
                added = added + 3;
                tri_i = tri_i + 1;
            }
        }
        polygon.destroy();
        return added;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addClipPathClippedTriangle(&self, batch: &mut SolidBatch, triangle: Triangle, color: Color, graph: RenderGraph, state: ClipPathState, fw: f32, fh: f32) -> i32 {
        if (!state.active || state.count < 3) { return 0; }
        var polygon = Vec::<Point>.new();
        polygon.push(triangle.a.clone());
        polygon.push(triangle.b.clone());
        polygon.push(triangle.c.clone());
        let orientation = self.clipPathSignedArea(graph, state);
        var edge_i: i32 = 0;
        while (edge_i < state.count && polygon.len > 0) {
            let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, edge_i));
            var next_i = edge_i + 1;
            if (next_i >= state.count) { next_i = 0; }
            let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
            let next_polygon = self.clipPolygonAgainstEdge(polygon, a, b, orientation);
            polygon.destroy();
            polygon = next_polygon;
            edge_i = edge_i + 1;
        }
        var added: i32 = 0;
        if (polygon.len >= 3) {
            let origin = polygon.get(0);
            var tri_i: i64 = 1;
            while ((tri_i + 1) < polygon.len) {
                batch.addTriangle(origin, polygon.get(tri_i), polygon.get(tri_i + 1), color, fw, fh);
                added = added + 3;
                tri_i = tri_i + 1;
            }
        }
        polygon.destroy();
        return added;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addClipPathsClippedPolygon(&self, batch: &mut SolidBatch, input_points: Vec<Point>, color: Color, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        if (states.len <= 0 || input_points.len < 3) { return 0; }
        var polygon = Vec::<Point>.new();
        var copy_i: i64 = 0;
        while (copy_i < input_points.len) {
            polygon.push(input_points.get(copy_i).clone());
            copy_i = copy_i + 1;
        }
        var state_i: i64 = 0;
        while (state_i < states.len && polygon.len > 0) {
            let state = states.get(state_i);
            if (state.active && state.count >= 3) {
                let orientation = self.clipPathSignedArea(graph, state);
                var edge_i: i32 = 0;
                while (edge_i < state.count && polygon.len > 0) {
                    let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, edge_i));
                    var next_i = edge_i + 1;
                    if (next_i >= state.count) { next_i = 0; }
                    let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
                    let next_polygon = self.clipPolygonAgainstEdge(polygon, a, b, orientation);
                    polygon.destroy();
                    polygon = next_polygon;
                    edge_i = edge_i + 1;
                }
            }
            state_i = state_i + 1;
        }
        var added: i32 = 0;
        if (polygon.len >= 3) {
            let origin = polygon.get(0);
            var tri_i: i64 = 1;
            while ((tri_i + 1) < polygon.len) {
                batch.addTriangle(origin, polygon.get(tri_i), polygon.get(tri_i + 1), color, fw, fh);
                added = added + 3;
                tri_i = tri_i + 1;
            }
        }
        polygon.destroy();
        return added;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addActiveClipPathsClippedQuad(&self, batch: &mut SolidBatch, quad: Quad, color: Color, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        var points = Vec::<Point>.new();
        points.push(quad.p0.clone());
        points.push(quad.p1.clone());
        points.push(quad.p2.clone());
        points.push(quad.p3.clone());
        let added = self.addClipPathsClippedPolygon(batch, points, color, graph, states, fw, fh);
        points.destroy();
        return added;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addActiveClipPathsClippedTriangle(&self, batch: &mut SolidBatch, triangle: Triangle, color: Color, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        var points = Vec::<Point>.new();
        points.push(triangle.a.clone());
        points.push(triangle.b.clone());
        points.push(triangle.c.clone());
        let added = self.addClipPathsClippedPolygon(batch, points, color, graph, states, fw, fh);
        points.destroy();
        return added;
    }

    @[borrow_args]
    @[borrow_args]
    private fn addActiveClipPathsClippedCircle(&self, batch: &mut SolidBatch, circle: Circle, color: Color, transform: Transform2D, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        if (!circle.isDrawable()) { return 0; }
        let segments = 32;
        let step = (rendererPi() * 2.0) / (segments as f64);
        let center = transform.transformPoint(Point.xy(circle.x, circle.y));
        var added: i32 = 0;
        var i: i32 = 0;
        while (i < segments) {
            let a0 = (i as f64) * step;
            let a1 = ((i + 1) as f64) * step;
            let p0 = transform.transformPoint(Point.xy(circle.x + ((cos(a0) as f32) * circle.radius), circle.y + ((sin(a0) as f32) * circle.radius)));
            let p1 = transform.transformPoint(Point.xy(circle.x + ((cos(a1) as f32) * circle.radius), circle.y + ((sin(a1) as f32) * circle.radius)));
            added = added + self.addActiveClipPathsClippedTriangle(batch, Triangle.create(center, p0, p1), color, graph, states, fw, fh);
            i = i + 1;
        }
        return added;
    }

    private fn gradientColorAtWorldPoint(&self, point: Point, rect: Rectangle, gradient: LinearGradient, inverse: Transform2D, alpha: f32) -> Color {
        let local = inverse.transformPoint(point);
        var t: f32 = 0.0 as f32;
        if (gradient.vertical) {
            if (rect.height != (0.0 as f32)) { t = (local.y - rect.y) / rect.height; }
        } else {
            if (rect.width != (0.0 as f32)) { t = (local.x - rect.x) / rect.width; }
        }
        return colorWithLayerAlpha(colorLerp(gradient.start, gradient.end, t), alpha);
    }

    @[borrow_args]
    @[borrow_args]
    private fn addActiveClipPathsClippedGradientQuad(&self, batch: &mut SolidBatch, quad: Quad, rect: Rectangle, gradient: LinearGradient, inverse: Transform2D, alpha: f32, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        if (states.len <= 0) { return 0; }
        var polygon = Vec::<Point>.new();
        polygon.push(quad.p0.clone());
        polygon.push(quad.p1.clone());
        polygon.push(quad.p2.clone());
        polygon.push(quad.p3.clone());
        var state_i: i64 = 0;
        while (state_i < states.len && polygon.len > 0) {
            let state = states.get(state_i);
            if (state.active && state.count >= 3) {
                let orientation = self.clipPathSignedArea(graph, state);
                var edge_i: i32 = 0;
                while (edge_i < state.count && polygon.len > 0) {
                    let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, edge_i));
                    var next_i = edge_i + 1;
                    if (next_i >= state.count) { next_i = 0; }
                    let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
                    let next_polygon = self.clipPolygonAgainstEdge(polygon, a, b, orientation);
                    polygon.destroy();
                    polygon = next_polygon;
                    edge_i = edge_i + 1;
                }
            }
            state_i = state_i + 1;
        }
        var added: i32 = 0;
        if (polygon.len >= 3) {
            let origin = polygon.get(0);
            let origin_color = self.gradientColorAtWorldPoint(origin, rect, gradient, inverse, alpha);
            var tri_i: i64 = 1;
            while ((tri_i + 1) < polygon.len) {
                let p1 = polygon.get(tri_i);
                let p2 = polygon.get(tri_i + 1);
                batch.addTriangleGradient(origin,
                                          p1,
                                          p2,
                                          origin_color,
                                          self.gradientColorAtWorldPoint(p1, rect, gradient, inverse, alpha),
                                          self.gradientColorAtWorldPoint(p2, rect, gradient, inverse, alpha),
                                          fw,
                                          fh);
                added = added + 3;
                tri_i = tri_i + 1;
            }
        }
        polygon.destroy();
        return added;
    }

    private fn spriteUAtWorldPoint(&self, point: Point, sprite: Sprite, inverse: Transform2D) -> f32 {
        let local = inverse.transformPoint(point);
        var t: f32 = 0.0 as f32;
        if (sprite.dest.width != (0.0 as f32)) { t = (local.x - sprite.dest.x) / sprite.dest.width; }
        if (t < (0.0 as f32)) { t = 0.0 as f32; }
        if (t > (1.0 as f32)) { t = 1.0 as f32; }
        return sprite.region.u0() + ((sprite.region.u1() - sprite.region.u0()) * t);
    }

    private fn spriteVAtWorldPoint(&self, point: Point, sprite: Sprite, inverse: Transform2D) -> f32 {
        let local = inverse.transformPoint(point);
        var t: f32 = 0.0 as f32;
        if (sprite.dest.height != (0.0 as f32)) { t = (local.y - sprite.dest.y) / sprite.dest.height; }
        if (t < (0.0 as f32)) { t = 0.0 as f32; }
        if (t > (1.0 as f32)) { t = 1.0 as f32; }
        return sprite.region.v0() + ((sprite.region.v1() - sprite.region.v0()) * t);
    }

    @[borrow_args]
    @[borrow_args]
    private fn addActiveClipPathsClippedSprite(&self, batch: &mut TexturedBatch, sprite: Sprite, quad: Quad, inverse: Transform2D, alpha: f32, graph: RenderGraph, states: Vec<ClipPathState>, fw: f32, fh: f32) -> i32 {
        if (states.len <= 0) { return 0; }
        var polygon = Vec::<Point>.new();
        polygon.push(quad.p0.clone());
        polygon.push(quad.p1.clone());
        polygon.push(quad.p2.clone());
        polygon.push(quad.p3.clone());
        var state_i: i64 = 0;
        while (state_i < states.len && polygon.len > 0) {
            let state = states.get(state_i);
            if (state.active && state.count >= 3) {
                let orientation = self.clipPathSignedArea(graph, state);
                var edge_i: i32 = 0;
                while (edge_i < state.count && polygon.len > 0) {
                    let a = state.transform.transformPoint(graph.clipPathPoint(state.offset, edge_i));
                    var next_i = edge_i + 1;
                    if (next_i >= state.count) { next_i = 0; }
                    let b = state.transform.transformPoint(graph.clipPathPoint(state.offset, next_i));
                    let next_polygon = self.clipPolygonAgainstEdge(polygon, a, b, orientation);
                    polygon.destroy();
                    polygon = next_polygon;
                    edge_i = edge_i + 1;
                }
            }
            state_i = state_i + 1;
        }
        var added: i32 = 0;
        if (polygon.len >= 3) {
            let origin = polygon.get(0);
            let tint = sprite.tint.withAlphaMultiplier(alpha);
            let layer = sprite.region.atlas_id as f32;
            var tri_i: i64 = 1;
            while ((tri_i + 1) < polygon.len) {
                let p1 = polygon.get(tri_i);
                let p2 = polygon.get(tri_i + 1);
                batch.addTriangleTextured(origin,
                                          p1,
                                          p2,
                                          self.spriteUAtWorldPoint(origin, sprite, inverse),
                                          self.spriteVAtWorldPoint(origin, sprite, inverse),
                                          self.spriteUAtWorldPoint(p1, sprite, inverse),
                                          self.spriteVAtWorldPoint(p1, sprite, inverse),
                                          self.spriteUAtWorldPoint(p2, sprite, inverse),
                                          self.spriteVAtWorldPoint(p2, sprite, inverse),
                                          layer,
                                          tint,
                                          fw,
                                          fh);
                added = added + 3;
                tri_i = tri_i + 1;
            }
        }
        polygon.destroy();
        return added;
    }

    @[borrow_args]
    private fn drawClipMask(&mut self, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        if (mask_vertex_handle == null || mask_vertex_count <= 0) { return Ok(0); }
        match (self.command.setViewport(0.0, 0.0, self.width as f32, self.height as f32, 0.0, 1.0)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(146, e.message)); }
        }
        match (self.command.setScissor(Rect2D.create(0, 0, self.width, self.height))) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(147, e.message)); }
        }
        match (self.command.bindGraphicsPipeline(&self.clip_mask_pipeline)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(148, e.message)); }
        }
        match (self.command.bindVertexBufferRaw(0, mask_vertex_handle, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(149, e.message)); }
        }
        match (self.command.draw(mask_vertex_count as u32, 1 as u32, 0 as u32, 0 as u32)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(150, e.message)); }
        }
        return Ok(0);
    }

    @[borrow_args]
    private fn drawSegments(segments: Vec<BatchSegment>,
                            frame_vertex_handle: rawptr,
                            frame_textured_vertex_handle: rawptr,
                            textured_descriptor_set: DescriptorSet,
                            draw_target: i32,
                            include_layer_composites: bool) -> Result<i32, Error> {
        if (segments.len <= 0) { return Ok(0); }
        match (self.command.setViewport(0.0, 0.0, self.width as f32, self.height as f32, 0.0, 1.0)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(29, e.message)); }
        }
        var bound_material: i32 = -1;
        var bound_pipeline_id: i32 = -1;
        var bound_clip_path_depth: i32 = -1;
        var segment_i: i64 = 0;
        while (segment_i < segments.len) {
            let segment = segments.get(segment_i);
            if (segment.target != draw_target) {
                segment_i = segment_i + 1;
                continue;
            }
            if (!include_layer_composites && segment.material > 1) {
                segment_i = segment_i + 1;
                continue;
            }
            if (segment.material == 0 && (bound_material != 0 || bound_pipeline_id != segment.pipeline_id || bound_clip_path_depth != segment.clip.clip_path_depth)) {
                if (segment.pipeline_id == 0) {
                    var solid_pipeline_to_bind = self.solid_pipeline.clone();
                    if (segment.clip.clip_path_depth > 0) {
                        solid_pipeline_to_bind = self.solid_clip_pipeline.clone();
                    }
                    match (self.command.bindGraphicsPipeline(solid_pipeline_to_bind)) {
                        case Ok(_) => {}
                        case Err(e) => { return Err(Error.create(31, e.message)); }
                    }
                } else {
                    var custom_pipeline: GraphicsPipeline;
                    match (self.customPipelineFor(segment.pipeline_id, segment.clip.clip_path_depth > 0)) {
                        case Ok(v) => { custom_pipeline = v; }
                        case Err(e) => { return Err(e); }
                    }
                    match (self.command.bindGraphicsPipeline(&custom_pipeline)) {
                        case Ok(_) => {}
                        case Err(e) => { return Err(Error.create(31, e.message)); }
                    }
                    if (self.customPipelineUsesSpriteDescriptors(segment.pipeline_id)) {
                        var descriptor_sets = Vec::<DescriptorSet>.new();
                        descriptor_sets.push(textured_descriptor_set.clone());
                        match (self.command.bindDescriptorSets(&custom_pipeline, 0 as u32, descriptor_sets)) {
                            case Ok(_) => {}
                            case Err(e) => { return Err(Error.create(73, e.message)); }
                        }
                    }
                    match (self.bindCustomStaticDescriptorSets(segment.pipeline_id, custom_pipeline)) {
                        case Ok(_) => {}
                        case Err(e) => { return Err(e); }
                    }
                }
                match (self.command.bindVertexBufferRaw(0, frame_vertex_handle, 0 as u64)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(32, e.message)); }
                }
                bound_material = 0;
                bound_pipeline_id = segment.pipeline_id;
                bound_clip_path_depth = segment.clip.clip_path_depth;
            }
            if (segment.material == 1 && (bound_material != 1 || bound_pipeline_id != segment.pipeline_id || bound_clip_path_depth != segment.clip.clip_path_depth)) {
                var textured_pipeline_to_bind = self.textured_pipeline.clone();
                if (segment.clip.clip_path_depth > 0) {
                    textured_pipeline_to_bind = self.textured_clip_pipeline.clone();
                }
                if (segment.pipeline_id != 0) {
                    match (self.customPipelineFor(segment.pipeline_id, segment.clip.clip_path_depth > 0)) {
                        case Ok(v) => { textured_pipeline_to_bind = v; }
                        case Err(e) => { return Err(e); }
                    }
                }
                match (self.command.bindGraphicsPipeline(&textured_pipeline_to_bind)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(72, e.message)); }
                }
                var descriptor_sets = Vec::<DescriptorSet>.new();
                descriptor_sets.push(textured_descriptor_set.clone());
                match (self.command.bindDescriptorSets(&textured_pipeline_to_bind, 0 as u32, descriptor_sets)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(73, e.message)); }
                }
                if (segment.pipeline_id != 0) {
                    match (self.bindCustomStaticDescriptorSets(segment.pipeline_id, textured_pipeline_to_bind)) {
                        case Ok(_) => {}
                        case Err(e) => { return Err(e); }
                    }
                }
                match (self.command.bindVertexBufferRaw(0, frame_textured_vertex_handle, 0 as u64)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(74, e.message)); }
                }
                bound_material = 1;
                bound_pipeline_id = segment.pipeline_id;
                bound_clip_path_depth = segment.clip.clip_path_depth;
            }
            if (segment.material == -2) {
                let slot_index = self.customRenderSlotIndex(segment.external_slot);
                if (slot_index < 0) { return Err(Error.create(174, "CustomRenderView slot is not registered")); }
                var slot = self.custom_render_slots.get_ptr(slot_index as i64);
                var pipeline_to_bind = self.textured_pipeline.clone();
                if (segment.clip.clip_path_depth > 0) { pipeline_to_bind = self.textured_clip_pipeline.clone(); }
                match (self.command.bindGraphicsPipeline(&pipeline_to_bind)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(175, e.message)); }
                }
                var descriptor_sets = Vec::<DescriptorSet>.new();
                descriptor_sets.push(slot[0].descriptor.clone());
                match (self.command.bindDescriptorSets(&pipeline_to_bind, 0 as u32, descriptor_sets)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(176, e.message)); }
                }
                match (self.command.bindVertexBufferRaw(0, frame_textured_vertex_handle, 0 as u64)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(177, e.message)); }
                }
                bound_material = -2;
                bound_pipeline_id = 0;
                bound_clip_path_depth = segment.clip.clip_path_depth;
            }
            if (segment.material >= 2 && bound_material != segment.material) {
                match (self.command.bindGraphicsPipeline(&self.textured_pipeline)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(72, e.message)); }
                }
                let layer_index = segment.material - 2;
                if (layer_index < 0 || layer_index >= self.layer_target_cache_count) {
                    return Err(Error.create(136, "Nut layer composite target is missing"));
                }
                var layer_descriptor_sets = Vec::<DescriptorSet>.new();
                layer_descriptor_sets.push(self.layer_target_descriptor_sets.get(layer_index as i64).clone());
                match (self.command.bindDescriptorSets(&self.textured_pipeline, 0 as u32, layer_descriptor_sets)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(73, e.message)); }
                }
                match (self.command.bindVertexBufferRaw(0, frame_textured_vertex_handle, 0 as u64)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(Error.create(74, e.message)); }
                }
                bound_material = segment.material;
                bound_pipeline_id = 0;
                bound_clip_path_depth = segment.clip.clip_path_depth;
            }
            match (self.command.setScissor(self.clipToScissor(segment.clip))) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(30, e.message)); }
            }
            if (segment.pipeline_id != 0 && segment.material <= 1) {
                match (self.pushCustomPipelineConstants(segment.pipeline_id, segment.clip.clip_path_depth > 0, segment.push_constants)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(e); }
                }
            }
            match (self.command.draw(segment.vertex_count as u32, 1 as u32, segment.first_vertex as u32, 0 as u32)) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(33, e.message)); }
            }
            segment_i = segment_i + 1;
        }
        return Ok(0);
    }

    @[borrow_args]
    private fn clearLayerTarget(&mut self, target_index: i32, segments: Vec<BatchSegment>, frame_vertex_handle: rawptr, frame_textured_vertex_handle: rawptr, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        if (target_index < 0 || target_index >= self.layer_target_cache_count) { return Ok(0); }
        let texture = self.layer_target_textures.get(target_index as i64);
        let ready = self.layer_target_shader_read_ready.get(target_index as i64);
        if (ready) {
            match (self.command.transitionImage(&texture, image_transition_shader_read_to_color_attachment())) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(126, e.message)); }
            }
        } else {
            match (self.command.transitionImage(&texture, image_transition_undefined_to_color_attachment())) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(126, e.message)); }
            }
        }
        let area = Rect2D.create(0, 0, self.width, self.height);
        var info = RenderingInfo.create(area);
        info = info.addColorAttachment(RenderingAttachmentInfo.color(&texture, 0.0, 0.0, 0.0, 0.0));
        if (self.last_frame_clip_path_count > 0) {
            info = info.setDepthAttachment(RenderingAttachmentInfo.stencil(&self.clip_stencil_texture, 0 as u32));
            info = info.setStencilAttachment(RenderingAttachmentInfo.stencil(&self.clip_stencil_texture, 0 as u32));
        }
        match (self.command.beginRendering(&info)) {
            case Ok(_) => {}
            case Err(e) => { info.color_attachments.destroy(); return Err(Error.create(127, e.message)); }
        }
        if (self.last_frame_clip_path_count > 0) {
            match (self.drawClipMask(mask_vertex_handle, mask_vertex_count)) {
                case Ok(_) => {}
                case Err(e) => { info.color_attachments.destroy(); return Err(e); }
            }
        }
        match (self.drawSegments(segments, frame_vertex_handle, frame_textured_vertex_handle, self.sprite_descriptor_set.clone(), target_index + 1, false)) {
            case Ok(_) => {}
            case Err(e) => { info.color_attachments.destroy(); return Err(e); }
        }
        match (self.command.endRendering()) {
            case Ok(_) => {}
            case Err(e) => { info.color_attachments.destroy(); return Err(Error.create(128, e.message)); }
        }
        info.color_attachments.destroy();
        match (self.command.transitionImage(&texture, image_transition_color_attachment_to_shader_read())) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(129, e.message)); }
        }
        self.layer_target_shader_read_ready.set(target_index as i64, true);
        self.last_frame_layer_pass_count = self.last_frame_layer_pass_count + 1;
        return Ok(0);
    }

    @[borrow_args]
    private fn clearLayerTarget0(&mut self, segments: Vec<BatchSegment>, frame_vertex_handle: rawptr, frame_textured_vertex_handle: rawptr, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        return self.clearLayerTarget(0, segments, frame_vertex_handle, frame_textured_vertex_handle, mask_vertex_handle, mask_vertex_count);
    }

    @[borrow_args]
    private fn clearLayerTarget1(&mut self, segments: Vec<BatchSegment>, frame_vertex_handle: rawptr, frame_textured_vertex_handle: rawptr, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        return self.clearLayerTarget(1, segments, frame_vertex_handle, frame_textured_vertex_handle, mask_vertex_handle, mask_vertex_count);
    }

    @[borrow_args]
    private fn clearLayerTargetsForFrame(&mut self, segments: Vec<BatchSegment>, frame_vertex_handle: rawptr, frame_textured_vertex_handle: rawptr, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        self.last_frame_layer_pass_count = 0;
        var target_i = self.last_frame_layer_target_count - 1;
        while (target_i >= 0) {
            match (self.clearLayerTarget(target_i, segments, frame_vertex_handle, frame_textured_vertex_handle, mask_vertex_handle, mask_vertex_count)) {
                case Ok(_) => {}
                case Err(e) => { return Err(e); }
            }
            target_i = target_i - 1;
        }
        return Ok(0);
    }

    @[borrow_args]
    private fn clearLayerTargetsForFrameCompiled(&mut self, graph: RenderGraph, segments: Vec<BatchSegment>, frame_vertex_handle: rawptr, frame_textured_vertex_handle: rawptr, mask_vertex_handle: rawptr, mask_vertex_count: i32) -> Result<i32, Error> {
        self.last_frame_layer_pass_count = 0;
        self.last_frame_execution_plan_consumed = false;
        self.last_frame_execution_plan_driven_pass_count = 0;
        self.last_frame_execution_plan_driven_layer_pass_count = 0;
        self.last_frame_execution_plan_driven_main_pass_count = 0;
        self.last_frame_execution_plan_driven_resource_bind_count = 0;
        var plan: RenderPlan;
        match (self.buildLastFrameRenderPlan(graph)) {
            case Ok(v) => { plan = v; }
            case Err(e) => { return Err(e); }
        }
        var execution = RenderExecutionPlan.build(plan);
        if (!execution.isValidFor(plan)) {
            execution.destroy();
            plan.destroy();
            self.last_frame_execution_plan_error_code = 187;
            return Err(Error.create(187, "RenderExecutionPlan is invalid for RenderPlan"));
        }
        self.last_frame_execution_plan_consumed = true;
        self.last_frame_execution_plan_compiled_binding_count = execution.compiledBindingCount();
        var order_i = execution.scheduledPassCount() - 1;
        while (order_i >= 0) {
            let pass_index = execution.scheduledPassAt(order_i);
            let pass = plan.passAt(pass_index);
            self.last_frame_execution_plan_driven_pass_count = self.last_frame_execution_plan_driven_pass_count + 1;
            self.last_frame_execution_plan_driven_resource_bind_count = self.last_frame_execution_plan_driven_resource_bind_count + execution.scheduledPassBindingCount(order_i);
            if (pass.kind.equals(RenderPassKind.layer())) {
                self.last_frame_execution_plan_driven_layer_pass_count = self.last_frame_execution_plan_driven_layer_pass_count + 1;
                match (self.clearLayerTarget(pass.target_id, segments, frame_vertex_handle, frame_textured_vertex_handle, mask_vertex_handle, mask_vertex_count)) {
                    case Ok(_) => {}
                    case Err(e) => {
                        execution.destroy();
                        plan.destroy();
                        return Err(e);
                    }
                }
            }
            if (pass.kind.equals(RenderPassKind.color())) {
                self.last_frame_execution_plan_driven_main_pass_count = self.last_frame_execution_plan_driven_main_pass_count + 1;
            }
            order_i = order_i - 1;
        }
        execution.destroy();
        plan.destroy();
        return Ok(0);
    }

    @[borrow_args]
    public fn renderGraph(&mut self, graph: RenderGraph) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(20, "Renderer is destroyed")); }
        self.resetLastFrameExecutionPlanMetrics();
        match (graph.validate()) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        if (graph.hasClear()) {
            self.clear_color = graph.clearColor();
        }
        if (self.forced_frame_error_code > 0) {
            let forced_code = self.forced_frame_error_code;
            self.forced_frame_error_code = 0;
            self.forced_frame_error_count = self.forced_frame_error_count + 1;
            self.last_frame_error_code = forced_code;
            self.last_frame_error_kind = rendererFrameErrorKindFromCode(forced_code);
            return Err(Error.create(forced_code, "forced Nut frame error"));
        }
        var unsupported_i: i32 = 0;
        var validation_pipeline_id: i32 = 0;
        var validation_clip_path_depth: i32 = 0;
        while (unsupported_i < graph.commandCount()) {
            let unsupported_command = graph.commandAt(unsupported_i);
            if (unsupported_command.kind.equals(RenderCommandKind.externalView()) && self.customRenderSlotIndex(unsupported_command.external_slot) < 0) {
                return Err(Error.create(174, "CustomRenderView slot is not registered"));
            }
            if (unsupported_command.kind.equals(RenderCommandKind.usePipeline()) && (unsupported_command.stroke_width as i32) != 0) {
                if (self.customPipelineIndex(unsupported_command.stroke_width as i32) < 0) {
                    self.custom_pipeline_missing_count = self.custom_pipeline_missing_count + 1;
                    self.last_custom_pipeline_error_code = 84;
                    self.last_custom_pipeline_missing_id = unsupported_command.stroke_width as i32;
                    return Err(Error.create(84, "GPU CustomPipeline is not registered"));
                }
            }
            if (unsupported_command.kind.equals(RenderCommandKind.usePipeline())) {
                validation_pipeline_id = unsupported_command.stroke_width as i32;
            }
            if (unsupported_command.kind.equals(RenderCommandKind.pushClipPath())) {
                validation_clip_path_depth = validation_clip_path_depth + 1;
            }
            if (unsupported_command.kind.equals(RenderCommandKind.popClip())) {
                validation_clip_path_depth = validation_clip_path_depth - 1;
                if (validation_clip_path_depth < 0) { validation_clip_path_depth = 0; }
            }
            let validation_is_draw = unsupported_command.kind.equals(RenderCommandKind.fillRect())
                || unsupported_command.kind.equals(RenderCommandKind.fillCircle())
                || unsupported_command.kind.equals(RenderCommandKind.fillTriangle())
                || unsupported_command.kind.equals(RenderCommandKind.fillQuad())
                || unsupported_command.kind.equals(RenderCommandKind.fillGradientRect())
                || unsupported_command.kind.equals(RenderCommandKind.drawSprite())
                || unsupported_command.kind.equals(RenderCommandKind.strokeLine())
                || unsupported_command.kind.equals(RenderCommandKind.strokeRect());
            var validation_draw_material: i32 = 0;
            if (unsupported_command.kind.equals(RenderCommandKind.drawSprite())) {
                validation_draw_material = rendererCustomPipelineMaterialTextured();
            }
            let validation_pipeline_material = self.customPipelineMaterialKind(validation_pipeline_id);
            if (validation_is_draw && validation_pipeline_id != 0 && validation_pipeline_material == validation_draw_material && validation_clip_path_depth > 0) {
                if (!self.hasCustomPipelineClipVariant(validation_pipeline_id)) {
                    self.custom_pipeline_clip_missing_count = self.custom_pipeline_clip_missing_count + 1;
                    self.last_custom_pipeline_error_code = 152;
                    self.last_custom_pipeline_missing_id = validation_pipeline_id;
                    return Err(Error.create(152, "GPU CustomPipeline clip variant is not registered"));
                }
            }
            unsupported_i = unsupported_i + 1;
        }
        if (self.width == 0 as u32 || self.height == 0 as u32) {
            return Err(Error.create(40, "Renderer framebuffer size is zero"));
        }
        match (self.updateLastFrameExecutionPlan(graph)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        match (self.updateLayerTargetDemand(graph)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        self.resetCustomRenderRequests();
        let clip_expansion_vertices = (self.last_frame_clip_path_count * 256) + (graph.commandCount() * 32);
        var batch = SolidBatch.create(graph.estimatedVertexCount() + clip_expansion_vertices);
        var textured_batch = TexturedBatch.create(graph.estimatedVertexCount() + (self.last_frame_layer_composite_capacity_count * 6) + clip_expansion_vertices);
        var segments = Vec::<BatchSegment>.new();
        var clip_stack = Vec::<ClipState>.new();
        var active_clip_paths = Vec::<ClipPathState>.new();
        var clip_path_depth_stack = Vec::<i32>.new();
        var transform_stack = Vec::<Transform2D>.new();
        var layer_stack = Vec::<f32>.new();
        var layer_opacity_stack = Vec::<f32>.new();
        var current_clip = ClipState.none();
        var current_transform = Transform2D.identity();
        var current_alpha: f32 = 1.0 as f32;
        var cpu_clip_path_count: i32 = 0;
        var segment_open = false;
        var current_segment_material: i32 = -1;
        var current_segment_target: i32 = 0;
        var current_segment_pipeline_id: i32 = 0;
        var current_pipeline_id: i32 = 0;
        var current_push_constants = Color.rgba(0.0, 0.0, 0.0, 0.0);
        var current_solid_pipeline_id: i32 = 0;
        var current_textured_pipeline_id: i32 = 0;
        var current_layer_depth: i32 = 0;
        var segment_start: i32 = 0;
        self.last_frame_layer_composite_count = 0;
        let fw = self.width as f32;
        let fh = self.height as f32;
        var build_i: i32 = 0;
        while (build_i < graph.commandCount()) {
            let command = graph.commandAt(build_i);
            if (command.kind.equals(RenderCommandKind.pushTransform())) {
                transform_stack.push(current_transform.clone());
                current_transform = current_transform.multiply(command.transform);
                build_i = build_i + 1;
                continue;
            }
            if (command.kind.equals(RenderCommandKind.popTransform())) {
                if (!transform_stack.isEmpty()) {
                    current_transform = transform_stack.pop();
                } else {
                    current_transform = Transform2D.identity();
                }
                build_i = build_i + 1;
                continue;
            }
            if (command.kind.equals(RenderCommandKind.pushLayer())) {
                if (segment_open) {
                    var layer_push_vertices: i32 = 0;
                    if (current_segment_material == 0) {
                        layer_push_vertices = batch.vertexCount() - segment_start;
                    } else {
                        layer_push_vertices = textured_batch.vertexCount() - segment_start;
                    }
                    if (layer_push_vertices > 0) {
                        segments.push(BatchSegment.createWithPipelineConstants(segment_start, layer_push_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip));
                    }
                    segment_open = false;
                    current_segment_material = -1;
                }
                layer_stack.push(current_alpha);
                layer_opacity_stack.push(command.color.a);
                current_alpha = 1.0 as f32;
                current_layer_depth = current_layer_depth + 1;
                build_i = build_i + 1;
                continue;
            }
            if (command.kind.equals(RenderCommandKind.popLayer())) {
                if (segment_open) {
                    var layer_pop_vertices: i32 = 0;
                    if (current_segment_material == 0) {
                        layer_pop_vertices = batch.vertexCount() - segment_start;
                    } else {
                        layer_pop_vertices = textured_batch.vertexCount() - segment_start;
                    }
                    if (layer_pop_vertices > 0) {
                        segments.push(BatchSegment.createWithPipelineConstants(segment_start, layer_pop_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip));
                    }
                    segment_open = false;
                    current_segment_material = -1;
                }
                var closed_layer_depth = current_layer_depth;
                if (!layer_stack.isEmpty()) {
                    current_alpha = layer_stack.pop();
                } else {
                    current_alpha = 1.0 as f32;
                }
                var layer_opacity: f32 = 1.0 as f32;
                if (!layer_opacity_stack.isEmpty()) {
                    layer_opacity = layer_opacity_stack.pop();
                }
                current_layer_depth = current_layer_depth - 1;
                if (current_layer_depth < 0) { current_layer_depth = 0; }
                if (closed_layer_depth > 0) {
                    let layer_composite_start = textured_batch.vertexCount();
                    textured_batch.addLayerComposite(Color.rgba(1.0, 1.0, 1.0, layer_opacity * current_alpha), fw, fh);
                    let layer_composite_vertices = textured_batch.vertexCount() - layer_composite_start;
                    if (layer_composite_vertices > 0) {
                        let layer_composite_material = 2 + (closed_layer_depth - 1);
                        segments.push(BatchSegment.create(layer_composite_start, layer_composite_vertices, layer_composite_material, current_layer_depth, ClipState.none()));
                        self.last_frame_layer_composite_count = self.last_frame_layer_composite_count + 1;
                    }
                }
                build_i = build_i + 1;
                continue;
            }
            if (command.kind.equals(RenderCommandKind.usePipeline())) {
                if (segment_open) {
                    var pipeline_segment_vertices: i32 = 0;
                    if (current_segment_material == 0) {
                        pipeline_segment_vertices = batch.vertexCount() - segment_start;
                    } else {
                        pipeline_segment_vertices = textured_batch.vertexCount() - segment_start;
                    }
                    if (pipeline_segment_vertices > 0) {
                        segments.push(BatchSegment.createWithPipelineConstants(segment_start, pipeline_segment_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip));
                    }
                    segment_open = false;
                    current_segment_material = -1;
                }
                current_pipeline_id = command.stroke_width as i32;
                current_push_constants = command.color.clone();
                if (current_pipeline_id == 0) {
                    current_solid_pipeline_id = 0;
                    current_textured_pipeline_id = 0;
                } else if (self.customPipelineMaterialKind(current_pipeline_id) == rendererCustomPipelineMaterialTextured()) {
                    current_textured_pipeline_id = current_pipeline_id;
                } else {
                    current_solid_pipeline_id = current_pipeline_id;
                }
                build_i = build_i + 1;
                continue;
            }
            if (command.kind.equals(RenderCommandKind.pushClipRect()) || command.kind.equals(RenderCommandKind.pushClipPath()) || command.kind.equals(RenderCommandKind.popClip())) {
