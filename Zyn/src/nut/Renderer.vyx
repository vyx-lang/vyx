    public fn renderFrame(&mut self) -> Result<i32, Error> {
        var graph = RenderGraph.create().clear(self.clear_color);
        let result = self.renderGraph(graph);
        graph.destroy();
        return result;
    }

    public fn forceNextFrameError(&mut self, code: i32) -> Result<i32, Error> {
        if (code <= 0) {
            return Err(Error.create(155, "forced frame error code must be positive"));
        }
        self.forced_frame_error_code = code;
        return Ok(0);
    }

    public fn forceNextSwapchainOutOfDate(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(22);
    }

    public fn forceNextAcquireOutOfDate(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(22);
    }

    public fn forceNextBackBufferOutOfDate(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(24);
    }

    public fn forceNextPresentOutOfDate(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(38);
    }

    public fn forceNextSubmitFailed(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(37);
    }

    public fn forceNextWaitIdleFailed(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(39);
    }

    public fn forceNextDeviceLost(&mut self) -> Result<i32, Error> {
        return self.forceNextFrameError(166);
    }

    private fn forceNextTransientResourceError(&mut self, kind: i32) -> Result<i32, Error> {
        if (kind < 1 || kind > 4) {
            return Err(Error.create(180, "forced transient resource error kind is invalid"));
        }
        self.forced_transient_resource_error_kind = kind;
        return Ok(0);
    }

    public fn forceNextLayerTargetTextureCreateFailure(&mut self) -> Result<i32, Error> {
        return self.forceNextTransientResourceError(1);
    }

    public fn forceNextLayerTargetViewCreateFailure(&mut self) -> Result<i32, Error> {
        return self.forceNextTransientResourceError(2);
    }

    public fn forceNextLayerTargetDescriptorCreateFailure(&mut self) -> Result<i32, Error> {
        return self.forceNextTransientResourceError(3);
    }

    public fn forceNextClipStencilCreateFailure(&mut self) -> Result<i32, Error> {
        return self.forceNextTransientResourceError(4);
    }

    private fn consumeForcedTransientResourceError(&mut self, kind: i32, message: string) -> Result<i32, Error> {
        if (self.forced_transient_resource_error_kind != kind) { return Ok(0); }
        self.forced_transient_resource_error_kind = 0;
        self.forced_transient_resource_error_count = self.forced_transient_resource_error_count + 1;
        self.last_transient_resource_error_kind = kind;
        return Err(Error.create(179 + kind, message));
    }

    private fn recordTransientPartialFailure(&mut self, kind: i32, created_handles: i32, cleanup_count: i32, cleanup_bytes: u64) {
        self.last_transient_resource_error_kind = kind;
        self.last_transient_resource_error_created_handle_count = created_handles;
        self.last_transient_resource_error_cleanup_count = cleanup_count;
        self.last_transient_resource_error_cleanup_bytes = cleanup_bytes;
        self.transient_resource_partial_failure_count = self.transient_resource_partial_failure_count + 1;
        self.transient_resource_partial_cleanup_count = self.transient_resource_partial_cleanup_count + cleanup_count;
        self.transient_resource_partial_cleanup_bytes = self.transient_resource_partial_cleanup_bytes + cleanup_bytes;
    }

    public fn resize(&mut self, width: u32, height: u32) -> Result<i32, Error> {
        self.resize_request_count = self.resize_request_count + 1;
        self.last_resize_error_code = 0;
        self.last_resize_requested_width = width;
        self.last_resize_requested_height = height;
        self.last_resize_previous_width = self.width;
        self.last_resize_previous_height = self.height;
        self.last_resize_purged_layer_targets = 0;
        self.last_resize_purged_clip_stencil = false;
        self.last_resize_purged_transient_count = 0;
        self.last_resize_purged_transient_bytes = 0 as u64;
        self.last_resize_changed_framebuffer = false;
        self.last_purged_transient_resource_count = 0;
        self.last_purged_transient_resource_bytes = 0 as u64;
        if (!self.owns) {
            self.resize_failed_count = self.resize_failed_count + 1;
            self.last_resize_error_code = 100;
            return Err(Error.create(100, "Renderer is destroyed"));
        }
        if (width == 0 as u32 || height == 0 as u32) {
            self.resize_failed_count = self.resize_failed_count + 1;
            self.last_resize_error_code = 101;
            return Err(Error.create(101, "Renderer resize dimensions are zero"));
        }
        if (width == self.width && height == self.height) {
            self.resize_noop_count = self.resize_noop_count + 1;
            return Ok(0);
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                self.resize_failed_count = self.resize_failed_count + 1;
                self.last_resize_error_code = 102;
                return Err(Error.create(102, e.message));
            }
        }
        if (self.layer_target_cache_count > 0) {
            self.last_resize_purged_layer_targets = self.layer_target_cache_count;
            self.last_resize_purged_transient_count = self.last_resize_purged_transient_count + self.layer_target_cache_count;
            self.last_resize_purged_transient_bytes = self.last_resize_purged_transient_bytes + self.layerTargetCacheBytes();
            self.layer_target_purge_count = self.layer_target_purge_count + 1;
        }
        if (self.clip_stencil_texture.isValid()) {
            self.last_resize_purged_clip_stencil = true;
            self.last_resize_purged_transient_count = self.last_resize_purged_transient_count + 1;
            self.last_resize_purged_transient_bytes = self.last_resize_purged_transient_bytes + self.clipStencilTargetBytes();
            self.clip_stencil_purge_count = self.clip_stencil_purge_count + 1;
        }
        if (self.last_resize_purged_transient_count > 0) {
            self.last_purged_transient_resource_count = self.last_resize_purged_transient_count;
            self.last_purged_transient_resource_bytes = self.last_resize_purged_transient_bytes;
            self.transient_resource_purge_count = self.transient_resource_purge_count + 1;
        }
        self.destroyLayerTargets();
        self.destroyClipStencilTarget();
        var caps: SurfaceCapabilities;
        match (self.surface.capabilities(&self.adapter)) {
            case Ok(v) => { caps = v; }
            case Err(e) => {
                self.resize_failed_count = self.resize_failed_count + 1;
                self.last_resize_error_code = 103;
                return Err(Error.create(103, e.message));
            }
        }
        var image_count = caps.min_image_count + 1;
        if (caps.max_image_count != 0 as u32 && image_count > caps.max_image_count) { image_count = caps.max_image_count; }
        var swap_desc = SwapchainDesc.create(width, height, format_rgba8_unorm(), swapchain_usage_color_attachment()).setPresentMode(present_mode_fifo()).setMinImageCount(image_count);
        var next_swapchain: Swapchain;
        self.swapchain.destroy();
        match (self.device.createSwapchain(&self.surface, swap_desc)) {
            case Ok(v) => { next_swapchain = v; }
            case Err(e) => {
                self.resize_failed_count = self.resize_failed_count + 1;
                self.last_resize_error_code = 104;
                return Err(Error.create(104, e.message));
            }
        }
        self.swapchain = next_swapchain;
        self.width = width;
        self.height = height;
        self.resize_count = self.resize_count + 1;
        self.swapchain_generation = self.swapchain_generation + 1;
        self.last_resize_changed_framebuffer = true;
        return Ok(0);
    }

    // Replacing an Android Surface does not necessarily change its dimensions.
    // Device and pipeline resources survive a Vulkan/D3D surface replacement;
    // an EGL surface owns its context and requires a complete Renderer rebuild.
    public fn recreateSurface(&mut self, window: Window) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(220, "Renderer is destroyed")); }
        if (self.actual_backend == backend_opengl() || self.actual_backend == backend_opengles()) {
            return Err(Error.create(221, "OpenGL surface replacement requires a complete Renderer rebuild"));
        }
        let native = window.nativeHandle();
        if (!native.isValid()) { return Err(Error.create(222, "Window has no live native surface")); }
        var size: Size2D;
        match (window.pixelSize()) {
            case Ok(value) => { size = value; }
            case Err(surface_error) => { return Err(Error.create(223, surface_error.message)); }
        }
        if (size.width <= 0 || size.height <= 0) { return Err(Error.create(224, "Window pixel size is zero")); }
        var format: u32;
        match (self.swapchain.format()) {
            case Ok(value) => { format = value; }
            case Err(surface_error) => { return Err(Error.create(225, surface_error.message)); }
        }
        var next_surface: Surface;
        match (self.instance.createNativeSurface(rendererNativeWindowHandle(native))) {
            case Ok(value) => { next_surface = value; }
            case Err(surface_error) => { return Err(Error.create(226, surface_error.message)); }
        }
        var caps: SurfaceCapabilities;
        match (next_surface.capabilities(&self.adapter)) {
            case Ok(value) => { caps = value; }
            case Err(surface_error) => { next_surface.destroy(); return Err(Error.create(227, surface_error.message)); }
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(surface_error) => { next_surface.destroy(); return Err(Error.create(228, surface_error.message)); }
        }
        self.destroyLayerTargets();
        self.destroyClipStencilTarget();
        // DXGI also requires releasing the old swapchain before creating a new
        // one for the same HWND. Failed creation stays an explicit error.
        self.swapchain.destroy();
        self.surface.destroy();
        self.surface = next_surface;
        var image_count = caps.min_image_count + 1;
        if (caps.max_image_count != 0 as u32 && image_count > caps.max_image_count) { image_count = caps.max_image_count; }
        let desc = SwapchainDesc.create(size.width as u32, size.height as u32, format, swapchain_usage_color_attachment()).setPresentMode(present_mode_fifo()).setMinImageCount(image_count);
        var next_swapchain: Swapchain;
        match (self.device.createSwapchain(&self.surface, desc)) {
            case Ok(value) => { next_swapchain = value; }
            case Err(surface_error) => { return Err(Error.create(229, surface_error.message)); }
        }
        match (next_swapchain.format()) {
            case Ok(value) => {
                if (value != format) {
                    next_swapchain.destroy();
                    return Err(Error.create(230, "Surface format changed; recreate the Renderer and its pipelines"));
                }
            }
            case Err(surface_error) => { next_swapchain.destroy(); return Err(Error.create(231, surface_error.message)); }
        }
        self.swapchain = next_swapchain;
        self.android_native_window = native.android_native_window;
        self.width = size.width as u32;
        self.height = size.height as u32;
        self.swapchain_generation = self.swapchain_generation + 1;
        return Ok(0);
    }

    public fn resizeToWindow(&mut self, window: Window) -> Result<i32, Error> {
        if (self.android_native_window != 0 as u64) { return self.recreateSurface(window); }
        var size: Size2D;
        match (window.pixelSize()) {
            case Ok(v) => { size = v; }
            case Err(e) => { return Err(Error.create(105, e.message)); }
        }
        if (size.width <= 0 || size.height <= 0) {
            return Err(Error.create(106, "Window pixel size is zero"));
        }
        return self.resize(size.width as u32, size.height as u32);
    }

    public fn syncToWindow(&mut self, window: Window) -> Result<i32, Error> {
        if (self.android_native_window != 0 as u64) {
            let native = window.nativeHandle();
            if (native.android_native_window != self.android_native_window) { return self.recreateSurface(window); }
        }
        var size: Size2D;
        match (window.pixelSize()) {
            case Ok(v) => { size = v; }
            case Err(e) => { return Err(Error.create(108, e.message)); }
        }
        if (size.width <= 0 || size.height <= 0) {
            return Err(Error.create(109, "Window pixel size is zero"));
        }
        if (self.width != size.width as u32 || self.height != size.height as u32) {
            return self.resize(size.width as u32, size.height as u32);
        }
        return Ok(0);
    }

    private fn ensureSpriteTextureUploadCapacity(&mut self, required_bytes: u64) -> Result<i32, Error> {
        if (required_bytes <= self.sprite_texture_upload_capacity) { return Ok(0); }
        var next_upload: Buffer;
        match (self.device.createBuffer(BufferDesc.create(required_bytes, buffer_usage_transfer_src(), memory_cpu_to_gpu(), "SpriteTextureUpload"))) {
            case Ok(v) => { next_upload = v; }
            case Err(e) => { return Err(Error.create(98, e.message)); }
        }
        // The queue may still be consuming the previous upload buffer from an
        // in-flight frame. Freeing it first tears the Cacao heap (0xC0000374
        // raised inside cacao_buffer_release); the race is invisible under a
        // debugger because stopping on every release hides it. Drain the queue
        // before the old buffer goes away.
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                next_upload.destroy();
                return Err(Error.create(86, e.message));
            }
        }
        self.sprite_texture_upload.destroy();
        self.sprite_texture_upload = next_upload;
        self.sprite_texture_upload_capacity = required_bytes;
        self.sprite_texture_upload_realloc_count = self.sprite_texture_upload_realloc_count + 1;
        return Ok(0);
    }

    public fn updateSpriteAtlasPixels(&mut self, width: i32, height: i32, pixels: rawptr) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        var texture_desc: SpriteTextureDesc;
        match (SpriteTextureDesc.fromRgbaPixels(width, height, pixels)) {
            case Ok(v) => { texture_desc = v; }
            case Err(e) => { return Err(e); }
        }
        let resize_texture = texture_desc.width != self.sprite_texture_width || texture_desc.height != self.sprite_texture_height || texture_desc.layers != self.sprite_texture_layers;
        match (self.ensureSpriteTextureUploadCapacity(texture_desc.upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(e);
            }
        }
        match (self.sprite_texture_upload.writeRaw(texture_desc.upload_data, texture_desc.upload_bytes, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(88, e.message));
            }
        }
        match (self.sprite_texture_upload.flush(0 as u64, texture_desc.upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(89, e.message));
            }
        }

        if (resize_texture) {
            let new_width = texture_desc.width;
            let new_height = texture_desc.height;
            let new_layers = texture_desc.layers;
            let new_row_pixels = texture_desc.row_pixels;
            let new_upload_bytes = texture_desc.upload_bytes;
            var new_texture: Texture;
            match (self.device.createTexture(TextureDesc.create2DArray(new_width, new_height, new_layers, format_rgba8_unorm(), texture_usage_sampled() | texture_usage_transfer_dst(), "SpriteTexture").setInitialState(resource_undefined()))) {
                case Ok(v) => { new_texture = v; }
                case Err(e) => {
                    texture_desc.destroy();
                    return Err(Error.create(99, e.message));
                }
            }

            match (self.command.reset()) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(90, e.message));
                }
            }
            match (self.command.begin(true, false)) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(91, e.message));
                }
            }
            match (self.command.transitionImage(&new_texture, image_transition_undefined_to_transfer_dst())) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(92, e.message));
                }
            }
            var new_regions = Vec::<BufferImageCopy>.new();
            var new_layer: u32 = 0 as u32;
            let new_layer_bytes = (new_row_pixels as u64) * (4 as u64) * (new_height as u64);
            while (new_layer < new_layers) {
                new_regions.push(BufferImageCopy { buffer_offset: new_layer_bytes * (new_layer as u64), buffer_row_length: new_row_pixels, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: new_layer, layer_count: 1 as u32, image_offset_x: 0, image_offset_y: 0, image_offset_z: 0, image_extent_width: new_width, image_extent_height: new_height, image_extent_depth: 1 as u32 });
                new_layer = new_layer + 1 as u32;
            }
            match (self.command.copyBufferToImage(&self.sprite_texture_upload, &new_texture, resource_copy_dest(), new_regions)) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(93, e.message));
                }
            }
            match (self.command.transitionImage(&new_texture, image_transition_transfer_dst_to_shader_read())) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(94, e.message));
                }
            }
            match (self.command.end()) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(95, e.message));
                }
            }
            match (self.queue.submitSimple(&self.command)) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(96, e.message));
                }
            }
            match (self.queue.waitIdle()) {
                case Ok(_) => {}
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(97, e.message));
                }
            }
            var new_view: TextureView;
            match (new_texture.createView(TextureViewDesc.create(texture_type_2d_array(), format_rgba8_unorm(), image_aspect_color(), "SpriteTextureView").setArrayRange(0 as u32, new_layers))) {
                case Ok(v) => { new_view = v; }
                case Err(e) => {
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(57, e.message));
                }
            }
            match (self.sprite_descriptor_set.writeTexture(0 as u32, &new_view, &self.sprite_sampler, resource_shader_read(), descriptor_sampled_image())) {
                case Ok(_) => {}
                case Err(e) => {
                    new_view.destroy();
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(62, e.message));
                }
            }
            match (self.sprite_descriptor_set.update()) {
                case Ok(_) => {}
                case Err(e) => {
                    new_view.destroy();
                    new_texture.destroy();
                    texture_desc.destroy();
                    return Err(Error.create(63, e.message));
                }
            }
            self.sprite_texture_view.destroy();
            self.sprite_texture.destroy();
            self.sprite_texture = new_texture;
            self.sprite_texture_view = new_view;
            self.sprite_texture_width = new_width;
            self.sprite_texture_height = new_height;
            self.sprite_texture_layers = new_layers;
            self.sprite_texture_upload_bytes = new_upload_bytes;
            self.sprite_texture_update_kind = 1;
            self.sprite_texture_update_page_count = new_layers as i32;
            texture_desc.destroy();
            return Ok(0);
        }

        match (self.command.reset()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(90, e.message));
            }
        }
        match (self.command.begin(true, false)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(91, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_shader_read_to_transfer_dst())) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(92, e.message));
            }
        }
        var sprite_regions = Vec::<BufferImageCopy>.new();
        var full_layer: u32 = 0 as u32;
        let full_layer_bytes = (texture_desc.row_pixels as u64) * (4 as u64) * (texture_desc.height as u64);
        while (full_layer < texture_desc.layers) {
            sprite_regions.push(BufferImageCopy { buffer_offset: full_layer_bytes * (full_layer as u64), buffer_row_length: texture_desc.row_pixels, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: full_layer, layer_count: 1 as u32, image_offset_x: 0, image_offset_y: 0, image_offset_z: 0, image_extent_width: texture_desc.width, image_extent_height: texture_desc.height, image_extent_depth: 1 as u32 });
            full_layer = full_layer + 1 as u32;
        }
        match (self.command.copyBufferToImage(&self.sprite_texture_upload, &self.sprite_texture, resource_copy_dest(), sprite_regions)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(93, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_transfer_dst_to_shader_read())) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(94, e.message));
            }
        }
        match (self.command.end()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(95, e.message));
            }
        }
        match (self.queue.submitSimple(&self.command)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(96, e.message));
            }
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(97, e.message));
            }
        }
        self.sprite_texture_upload_bytes = texture_desc.upload_bytes;
        self.sprite_texture_update_kind = 1;
        self.sprite_texture_update_page_count = texture_desc.layers as i32;
        texture_desc.destroy();
        return Ok(0);
    }

    public fn updateSpriteAtlasRegion(&mut self, x: i32, y: i32, width: i32, height: i32, atlas_width: i32, atlas_height: i32, pixels: rawptr) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        if (atlas_width as u32 != self.sprite_texture_width || atlas_height as u32 != self.sprite_texture_height) {
            return Err(Error.create(86, "sprite atlas update dimensions must match existing texture"));
        }
        var texture_desc: SpriteTextureDesc;
        match (SpriteTextureDesc.fromRgbaRegion(atlas_width, atlas_height, pixels, x, y, width, height)) {
            case Ok(v) => { texture_desc = v; }
            case Err(e) => { return Err(e); }
        }
        if (texture_desc.upload_bytes > self.sprite_texture_upload_capacity) {
            texture_desc.destroy();
            return Err(Error.create(87, "sprite atlas upload buffer is too small"));
        }
        match (self.sprite_texture_upload.writeRaw(texture_desc.upload_data, texture_desc.upload_bytes, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(88, e.message));
            }
        }
        match (self.sprite_texture_upload.flush(0 as u64, texture_desc.upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(89, e.message));
            }
        }

        match (self.command.reset()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(90, e.message));
            }
        }
        match (self.command.begin(true, false)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(91, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_shader_read_to_transfer_dst())) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(92, e.message));
            }
        }
        var sprite_regions = Vec::<BufferImageCopy>.new();
        sprite_regions.push(BufferImageCopy { buffer_offset: 0 as u64, buffer_row_length: texture_desc.row_pixels, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: 0 as u32, layer_count: 1 as u32, image_offset_x: x, image_offset_y: y, image_offset_z: 0, image_extent_width: texture_desc.width, image_extent_height: texture_desc.height, image_extent_depth: 1 as u32 });
        match (self.command.copyBufferToImage(&self.sprite_texture_upload, &self.sprite_texture, resource_copy_dest(), sprite_regions)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(93, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_transfer_dst_to_shader_read())) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(94, e.message));
            }
        }
        match (self.command.end()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(95, e.message));
            }
        }
        match (self.queue.submitSimple(&self.command)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(96, e.message));
            }
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(97, e.message));
            }
        }
        self.sprite_texture_upload_bytes = texture_desc.upload_bytes;
        self.sprite_texture_update_kind = 2;
        self.sprite_texture_update_page_count = 1;
        texture_desc.destroy();
        return Ok(0);
    }

    public fn updateSpriteAtlas(&mut self, atlas: Atlas) -> Result<i32, Error> {
        if (!atlas.hasPixels()) {
            return Err(Error.create(107, "sprite atlas has no pixels"));
        }
        if (atlas.width as u32 != self.sprite_texture_width || atlas.height as u32 != self.sprite_texture_height) {
            return self.updateSpriteAtlasPixels(atlas.width, atlas.height, atlas.pixels);
        }
        if (!atlas.hasDirtyPixels()) {
            self.sprite_texture_upload_bytes = 0 as u64;
            self.sprite_texture_update_kind = 0;
            self.sprite_texture_update_page_count = 0;
            return Ok(0);
        }
        return self.updateSpriteAtlasRegion(atlas.dirty_x, atlas.dirty_y, atlas.dirty_width, atlas.dirty_height, atlas.width, atlas.height, atlas.pixels);
    }

    private fn updateSpriteAtlasSetDirty(&mut self, atlas_set: AtlasSet) -> Result<i32, Error> {
        if (atlas_set.pageCount() as u32 != self.sprite_texture_layers) {
            return Err(Error.create(115, "sprite atlas set layer count must match existing texture"));
        }
        if (atlas_set.pageCount() <= 0) { return Err(Error.create(110, "sprite atlas set has no pages")); }
        var total_upload_bytes: u64 = 0 as u64;
        var dirty_pages: i32 = 0;
        var scan: i32 = 0;
        while (scan < atlas_set.pageCount()) {
            let page = atlas_set.pageAt(scan);
            if (!page.hasPixels()) { return Err(Error.create(111, "sprite atlas set page has no pixels")); }
            if (page.width as u32 != self.sprite_texture_width || page.height as u32 != self.sprite_texture_height) {
                return Err(Error.create(116, "sprite atlas set page dimensions must match existing texture"));
            }
            if (page.hasDirtyPixels()) {
                let row_bytes = (page.dirty_width as u64) * (4 as u64);
                let aligned_row_bytes = ((row_bytes + 255 as u64) / (256 as u64)) * (256 as u64);
                total_upload_bytes = total_upload_bytes + (aligned_row_bytes * (page.dirty_height as u64));
                dirty_pages = dirty_pages + 1;
            }
            scan = scan + 1;
        }
        if (dirty_pages == 0) {
            self.sprite_texture_upload_bytes = 0 as u64;
            self.sprite_texture_update_kind = 0;
            self.sprite_texture_update_page_count = 0;
            return Ok(0);
        }
        match (self.ensureSpriteTextureUploadCapacity(total_upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        var regions = Vec::<BufferImageCopy>.new();
        var offset: u64 = 0 as u64;
        var page_i: i32 = 0;
        while (page_i < atlas_set.pageCount()) {
            let page = atlas_set.pageAt(page_i);
            if (page.hasDirtyPixels()) {
                var texture_desc: SpriteTextureDesc;
                match (SpriteTextureDesc.fromRgbaRegion(page.width, page.height, page.pixels, page.dirty_x, page.dirty_y, page.dirty_width, page.dirty_height)) {
                    case Ok(v) => { texture_desc = v; }
                    case Err(e) => {
                        regions.destroy();
                        return Err(e);
                    }
                }
                match (self.sprite_texture_upload.writeRaw(texture_desc.upload_data, texture_desc.upload_bytes, offset)) {
                    case Ok(_) => {}
                    case Err(e) => {
                        texture_desc.destroy();
                        regions.destroy();
                        return Err(Error.create(88, e.message));
                    }
                }
                regions.push(BufferImageCopy { buffer_offset: offset, buffer_row_length: texture_desc.row_pixels, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: page_i as u32, layer_count: 1 as u32, image_offset_x: page.dirty_x, image_offset_y: page.dirty_y, image_offset_z: 0, image_extent_width: texture_desc.width, image_extent_height: texture_desc.height, image_extent_depth: 1 as u32 });
                offset = offset + texture_desc.upload_bytes;
                texture_desc.destroy();
            }
            page_i = page_i + 1;
        }
        match (self.sprite_texture_upload.flush(0 as u64, total_upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                regions.destroy();
                return Err(Error.create(89, e.message));
            }
        }

        match (self.command.reset()) {
            case Ok(_) => {}
            case Err(e) => {
                regions.destroy();
                return Err(Error.create(90, e.message));
            }
        }
        match (self.command.begin(true, false)) {
            case Ok(_) => {}
            case Err(e) => {
                regions.destroy();
                return Err(Error.create(91, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_shader_read_to_transfer_dst())) {
            case Ok(_) => {}
            case Err(e) => {
                regions.destroy();
                return Err(Error.create(92, e.message));
            }
        }
        match (self.command.copyBufferToImage(&self.sprite_texture_upload, &self.sprite_texture, resource_copy_dest(), regions)) {
            case Ok(_) => {}
            case Err(e) => {
                return Err(Error.create(93, e.message));
            }
        }
        match (self.command.transitionImage(&self.sprite_texture, image_transition_transfer_dst_to_shader_read())) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(94, e.message)); }
        }
        match (self.command.end()) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(95, e.message)); }
        }
        match (self.queue.submitSimple(&self.command)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(96, e.message)); }
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(97, e.message)); }
        }
        self.sprite_texture_upload_bytes = total_upload_bytes;
        self.sprite_texture_update_kind = 4;
        self.sprite_texture_update_page_count = dirty_pages;
        return Ok(0);
    }

    public fn updateSpriteAtlasSet(&mut self, atlas_set: AtlasSet) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        if (atlas_set.pageCount() > 0) {
            let first_page = atlas_set.pageAt(0);
            if (first_page.hasPixels() && first_page.width as u32 == self.sprite_texture_width && first_page.height as u32 == self.sprite_texture_height && atlas_set.pageCount() as u32 == self.sprite_texture_layers) {
                return self.updateSpriteAtlasSetDirty(atlas_set);
            }
        }
        var texture_desc: SpriteTextureDesc;
        match (SpriteTextureDesc.fromAtlasSet(atlas_set)) {
            case Ok(v) => { texture_desc = v; }
            case Err(e) => { return Err(e); }
        }
        match (self.ensureSpriteTextureUploadCapacity(texture_desc.upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(e);
            }
        }
        match (self.sprite_texture_upload.writeRaw(texture_desc.upload_data, texture_desc.upload_bytes, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(88, e.message));
            }
        }
        match (self.sprite_texture_upload.flush(0 as u64, texture_desc.upload_bytes)) {
            case Ok(_) => {}
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(89, e.message));
            }
        }

        var new_texture: Texture;
        match (self.device.createTexture(TextureDesc.create2DArray(texture_desc.width, texture_desc.height, texture_desc.layers, format_rgba8_unorm(), texture_usage_sampled() | texture_usage_transfer_dst(), "SpriteTextureSet").setInitialState(resource_undefined()))) {
            case Ok(v) => { new_texture = v; }
            case Err(e) => {
                texture_desc.destroy();
                return Err(Error.create(114, e.message));
            }
        }

        match (self.command.reset()) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(90, e.message));
            }
        }
        match (self.command.begin(true, false)) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(91, e.message));
            }
        }
        match (self.command.transitionImage(&new_texture, image_transition_undefined_to_transfer_dst())) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(92, e.message));
            }
        }
        var set_regions = Vec::<BufferImageCopy>.new();
        var layer: u32 = 0 as u32;
        let layer_bytes = (texture_desc.row_pixels as u64) * (4 as u64) * (texture_desc.height as u64);
        while (layer < texture_desc.layers) {
            set_regions.push(BufferImageCopy { buffer_offset: layer_bytes * (layer as u64), buffer_row_length: texture_desc.row_pixels, buffer_image_height: 0 as u32, aspect_mask: image_aspect_color(), mip_level: 0 as u32, base_array_layer: layer, layer_count: 1 as u32, image_offset_x: 0, image_offset_y: 0, image_offset_z: 0, image_extent_width: texture_desc.width, image_extent_height: texture_desc.height, image_extent_depth: 1 as u32 });
            layer = layer + 1 as u32;
        }
        match (self.command.copyBufferToImage(&self.sprite_texture_upload, &new_texture, resource_copy_dest(), set_regions)) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(93, e.message));
            }
        }
        match (self.command.transitionImage(&new_texture, image_transition_transfer_dst_to_shader_read())) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(94, e.message));
            }
        }
        match (self.command.end()) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(95, e.message));
            }
        }
        match (self.queue.submitSimple(&self.command)) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(96, e.message));
            }
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(97, e.message));
            }
        }
        var new_view: TextureView;
        match (new_texture.createView(TextureViewDesc.create(texture_type_2d_array(), format_rgba8_unorm(), image_aspect_color(), "SpriteTextureSetView").setArrayRange(0 as u32, texture_desc.layers))) {
            case Ok(v) => { new_view = v; }
            case Err(e) => {
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(57, e.message));
            }
        }
        match (self.sprite_descriptor_set.writeTexture(0 as u32, &new_view, &self.sprite_sampler, resource_shader_read(), descriptor_sampled_image())) {
            case Ok(_) => {}
            case Err(e) => {
                new_view.destroy();
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(62, e.message));
            }
        }
        match (self.sprite_descriptor_set.update()) {
            case Ok(_) => {}
            case Err(e) => {
                new_view.destroy();
                new_texture.destroy();
                texture_desc.destroy();
                return Err(Error.create(63, e.message));
            }
        }
        self.sprite_texture_view.destroy();
        self.sprite_texture.destroy();
        self.sprite_texture = new_texture;
        self.sprite_texture_view = new_view;
        self.sprite_texture_width = texture_desc.width;
        self.sprite_texture_height = texture_desc.height;
        self.sprite_texture_layers = texture_desc.layers;
        self.sprite_texture_upload_bytes = texture_desc.upload_bytes;
        self.sprite_texture_update_kind = 3;
        self.sprite_texture_update_page_count = texture_desc.layers as i32;
        texture_desc.destroy();
        return Ok(0);
    }

    private fn ensureFrameVertexCapacity(&mut self, required_vertices: i32) -> Result<i32, Error> {
        var required = required_vertices;
        if (required < 6) { required = 6; }
        if (self.frame_vertex_capacity >= required) { return Ok(0); }

        var next_capacity = self.frame_vertex_capacity;
        if (next_capacity < 6) { next_capacity = 6; }
        while (next_capacity < required) {
            next_capacity = next_capacity * 2;
        }

        let buffer_size = (next_capacity as u64) * (sizeof::<SolidVertex>() as u64);
        var next_buffer: Buffer;
        match (self.device.createBuffer(BufferDesc.create(buffer_size, buffer_usage_vertex(), memory_cpu_to_gpu(), "FrameSolidVertexBuffer"))) {
            case Ok(v) => { next_buffer = v; }
            case Err(e) => { return Err(Error.create(12, e.message)); }
        }

        self.frame_vertex_buffer.destroy();
        self.frame_vertex_buffer = next_buffer;
        self.frame_vertex_capacity = next_capacity;
        self.frame_vertex_realloc_count = self.frame_vertex_realloc_count + 1;
        return Ok(0);
    }

    private fn uploadSolidBatch(&mut self, batch: SolidBatch) -> Result<rawptr, Error> {
        self.last_frame_solid_uploaded_bytes = 0 as u64;
        if (batch.isEmpty()) { return Ok(null); }
        match (self.ensureFrameVertexCapacity(batch.vertexCount())) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        let frame_vertex_handle = self.frame_vertex_buffer.nativeHandle();
        let byte_count = (batch.vertexCount() as u64) * (sizeof::<SolidVertex>() as u64);
        match (bufferWriteRawHandle(frame_vertex_handle, batch.vertexData(), byte_count, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(41, e.message)); }
        }
        match (bufferFlushRawHandle(frame_vertex_handle, 0 as u64, byte_count)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(42, e.message)); }
        }
        self.last_frame_solid_uploaded_bytes = byte_count;
        return Ok(frame_vertex_handle);
    }

    private fn ensureClipMaskVertexCapacity(&mut self, required_vertices: i32) -> Result<i32, Error> {
        var required = required_vertices;
        if (required < 6) { required = 6; }
        if (self.clip_mask_vertex_capacity >= required) { return Ok(0); }

        var next_capacity = self.clip_mask_vertex_capacity;
        if (next_capacity < 6) { next_capacity = 6; }
        while (next_capacity < required) {
            next_capacity = next_capacity * 2;
        }

        let buffer_size = (next_capacity as u64) * (sizeof::<SolidVertex>() as u64);
        var next_buffer: Buffer;
        match (self.device.createBuffer(BufferDesc.create(buffer_size, buffer_usage_vertex(), memory_cpu_to_gpu(), "ClipMaskVertexBuffer"))) {
            case Ok(v) => { next_buffer = v; }
            case Err(e) => { return Err(Error.create(143, e.message)); }
        }

        self.clip_mask_vertex_buffer.destroy();
        self.clip_mask_vertex_buffer = next_buffer;
        self.clip_mask_vertex_capacity = next_capacity;
        self.clip_mask_vertex_realloc_count = self.clip_mask_vertex_realloc_count + 1;
        return Ok(0);
    }

    private fn uploadClipMaskBatch(&mut self, batch: SolidBatch) -> Result<rawptr, Error> {
        self.last_frame_clip_mask_vertices = batch.vertexCount();
        self.last_frame_clip_mask_uploaded_bytes = 0 as u64;
        if (batch.isEmpty()) { return Ok(null); }
        match (self.ensureClipMaskVertexCapacity(batch.vertexCount())) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        let mask_vertex_handle = self.clip_mask_vertex_buffer.nativeHandle();
        let byte_count = (batch.vertexCount() as u64) * (sizeof::<SolidVertex>() as u64);
        match (bufferWriteRawHandle(mask_vertex_handle, batch.vertexData(), byte_count, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(144, e.message)); }
        }
        match (bufferFlushRawHandle(mask_vertex_handle, 0 as u64, byte_count)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(145, e.message)); }
        }
        self.last_frame_clip_mask_uploaded_bytes = byte_count;
        return Ok(mask_vertex_handle);
    }

    private fn ensureFrameTexturedVertexCapacity(&mut self, required_vertices: i32) -> Result<i32, Error> {
        var required = required_vertices;
        if (required < 6) { required = 6; }
        if (self.frame_textured_vertex_capacity >= required) { return Ok(0); }

        var next_capacity = self.frame_textured_vertex_capacity;
        if (next_capacity < 6) { next_capacity = 6; }
        while (next_capacity < required) {
            next_capacity = next_capacity * 2;
        }

        let buffer_size = (next_capacity as u64) * (sizeof::<TexturedVertex>() as u64);
        var next_buffer: Buffer;
        match (self.device.createBuffer(BufferDesc.create(buffer_size, buffer_usage_vertex(), memory_cpu_to_gpu(), "FrameTexturedVertexBuffer"))) {
            case Ok(v) => { next_buffer = v; }
            case Err(e) => { return Err(Error.create(66, e.message)); }
        }

        self.frame_textured_vertex_buffer.destroy();
        self.frame_textured_vertex_buffer = next_buffer;
        self.frame_textured_vertex_capacity = next_capacity;
        self.frame_textured_vertex_realloc_count = self.frame_textured_vertex_realloc_count + 1;
        return Ok(0);
    }

    private fn uploadTexturedBatch(&mut self, batch: TexturedBatch) -> Result<rawptr, Error> {
        self.last_frame_textured_uploaded_bytes = 0 as u64;
        if (batch.isEmpty()) { return Ok(null); }
        match (self.ensureFrameTexturedVertexCapacity(batch.vertexCount())) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        let frame_vertex_handle = self.frame_textured_vertex_buffer.nativeHandle();
        let byte_count = (batch.vertexCount() as u64) * (sizeof::<TexturedVertex>() as u64);
        match (bufferWriteRawHandle(frame_vertex_handle, batch.vertexData(), byte_count, 0 as u64)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(67, e.message)); }
        }
        match (bufferFlushRawHandle(frame_vertex_handle, 0 as u64, byte_count)) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(68, e.message)); }
        }
        self.last_frame_textured_uploaded_bytes = byte_count;
        return Ok(frame_vertex_handle);
    }

    private fn clipToScissor(&self, clip: ClipState) -> Rect2D {
        if (!clip.has_clip) { return Rect2D.create(0, 0, self.width, self.height); }
        var x0 = clip.x as i32;
        var y0 = clip.y as i32;
        var x1 = clip.right() as i32;
        var y1 = clip.bottom() as i32;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x0 > (self.width as i32)) { x0 = self.width as i32; }
        if (y0 > (self.height as i32)) { y0 = self.height as i32; }
        if (x1 < x0) { x1 = x0; }
        if (y1 < y0) { y1 = y0; }
        if (x1 > (self.width as i32)) { x1 = self.width as i32; }
        if (y1 > (self.height as i32)) { y1 = self.height as i32; }
        // GL and D3D11 map Nut's increasing Y to a bottom-origin scissor.
        // Vulkan, D3D12, Metal and WebGPU use a top-origin scissor instead.
        if (self.actual_backend == backend_d3d11() || self.actual_backend == backend_opengl() || self.actual_backend == backend_opengles()) {
            return Rect2D.create(x0, (self.height as i32) - y1, (x1 - x0) as u32, (y1 - y0) as u32);
        }
        return Rect2D.create(x0, y0, (x1 - x0) as u32, (y1 - y0) as u32);
    }

    private fn customRenderSlotIndex(&self, id: i32) -> i32 {
        var i: i64 = 0;
        while (i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(i);
            if (slot[0].id == id) { return i as i32; }
            i = i + 1;
        }
        return -1;
    }

    public fn registerCustomRender(&mut self, id: i32, handler: Box<dyn CustomRenderHandler>) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(160, "Renderer is destroyed")); }
        if (id < 0) { return Err(Error.create(161, "CustomRenderView slot id must be non-negative")); }
        if (self.customRenderSlotIndex(id) >= 0) { return Err(Error.create(162, "CustomRenderView slot id is already registered")); }
        if (self.custom_render_slots.len >= 256) { return Err(Error.create(163, "CustomRenderView slot limit exceeded")); }
        self.custom_render_slots.push(CustomRenderSlot.create(id, handler));
        return Ok(id);
    }

    public fn unregisterCustomRender(&mut self, id: i32) -> Result<i32, Error> {
        let index = self.customRenderSlotIndex(id);
        if (index < 0) { return Err(Error.create(174, "CustomRenderView slot is not registered")); }
        match (self.queue.waitIdle()) { case Ok(_) => {} case Err(e) => { return Err(Error.create(178, e.message)); } }
        var slot = self.custom_render_slots.removeAt(index as i64);
        slot.descriptor.destroy();
        slot.view.destroy();
        slot.texture.destroy();
        var handler = slot.handler.deref();
        handler.release();
        slot.handler.drop();
        return Ok(id);
    }

    private fn destroyCustomRenderResources(&mut self) {
        var i: i64 = 0;
        while (i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(i);
            slot[0].descriptor.destroy();
            slot[0].view.destroy();
            slot[0].texture.destroy();
            slot[0].descriptor = DescriptorSet.empty();
            slot[0].view = TextureView.empty();
            slot[0].texture = Texture.empty();
            slot[0].width = 0 as u32;
            slot[0].height = 0 as u32;
            slot[0].shader_read_ready = false;
            i = i + 1;
        }
    }

    private fn resetCustomRenderRequests(&mut self) {
        var i: i64 = 0;
        while (i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(i);
            slot[0].active_frame = false;
            slot[0].requested_width = 0 as u32;
            slot[0].requested_height = 0 as u32;
            i = i + 1;
        }
    }

    private fn requestCustomRender(&mut self, id: i32, width: u32, height: u32) {
        let index = self.customRenderSlotIndex(id);
        if (index < 0) { return; }
        var slot = self.custom_render_slots.get_ptr(index as i64);
        slot[0].active_frame = true;
        if (width > slot[0].requested_width) { slot[0].requested_width = width; }
        if (height > slot[0].requested_height) { slot[0].requested_height = height; }
    }

    private fn ensureCustomRenderDescriptorPool(&mut self) -> Result<i32, Error> {
        if (self.custom_render_descriptor_pool.isValid()) { return Ok(0); }
        var desc = DescriptorPoolDesc.create(256 as u32);
        desc = desc.addSize(descriptor_sampled_image(), 256 as u32);
        desc = desc.addSize(descriptor_sampler(), 256 as u32);
        match (self.device.createDescriptorPool(desc)) {
            case Ok(pool) => { self.custom_render_descriptor_pool = pool; return Ok(0); }
            case Err(e) => { return Err(Error.create(164, e.message)); }
        }
    }

    private fn ensureCustomRenderTarget(&mut self, index: i64) -> Result<i32, Error> {
        var slot = self.custom_render_slots.get_ptr(index);
        let width = slot[0].requested_width;
        let height = slot[0].requested_height;
        if (width == 0 as u32 || height == 0 as u32) { return Err(Error.create(165, "CustomRenderView has an empty render target")); }
        if (slot[0].texture.isValid() && slot[0].width == width && slot[0].height == height) { return Ok(0); }
        slot[0].descriptor.destroy();
        slot[0].view.destroy();
        slot[0].texture.destroy();
        slot[0].descriptor = DescriptorSet.empty();
        slot[0].view = TextureView.empty();
        slot[0].texture = Texture.empty();
        slot[0].shader_read_ready = false;
        match (self.ensureCustomRenderDescriptorPool()) { case Ok(_) => {} case Err(e) => { return Err(e); } }
        let usage = texture_usage_color_attachment() | texture_usage_sampled();
        var texture: Texture;
        match (self.device.createTexture(TextureDesc.create2DArray(width, height, 1 as u32, format_rgba8_unorm(), usage, "ZynCustomRenderView").setInitialState(resource_undefined()))) {
            case Ok(v) => { texture = v; }
            case Err(e) => { return Err(Error.create(166, e.message)); }
        }
        var view: TextureView;
        match (texture.createView(TextureViewDesc.create(texture_type_2d_array(), format_rgba8_unorm(), image_aspect_color(), "ZynCustomRenderView").setArrayRange(0 as u32, 1 as u32))) {
            case Ok(v) => { view = v; }
            case Err(e) => { texture.destroy(); return Err(Error.create(167, e.message)); }
        }
        var descriptor: DescriptorSet;
        match (self.custom_render_descriptor_pool.allocate(&self.sprite_set_layout)) {
            case Ok(v) => { descriptor = v; }
            case Err(e) => { view.destroy(); texture.destroy(); return Err(Error.create(168, e.message)); }
        }
        match (descriptor.writeTexture(0 as u32, &view, &self.sprite_sampler, resource_shader_read(), descriptor_sampled_image())) {
            case Ok(_) => {}
            case Err(e) => { descriptor.destroy(); view.destroy(); texture.destroy(); return Err(Error.create(169, e.message)); }
        }
        match (descriptor.writeSampler(1 as u32, &self.sprite_sampler)) {
            case Ok(_) => {}
            case Err(e) => { descriptor.destroy(); view.destroy(); texture.destroy(); return Err(Error.create(170, e.message)); }
        }
        match (descriptor.update()) {
            case Ok(_) => {}
            case Err(e) => { descriptor.destroy(); view.destroy(); texture.destroy(); return Err(Error.create(171, e.message)); }
        }
        slot[0].texture = texture;
        slot[0].view = view;
        slot[0].descriptor = descriptor;
        slot[0].width = width;
        slot[0].height = height;
        return Ok(0);
    }

    private fn prepareCustomRenderTargets(&mut self) -> Result<i32, Error> {
        var i: i64 = 0;
        while (i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(i);
            if (slot[0].active_frame) {
                match (self.ensureCustomRenderTarget(i)) { case Ok(_) => {} case Err(e) => { return Err(e); } }
            }
            i = i + 1;
        }
        return Ok(0);
    }

    private fn recordCustomRenderTargets(&mut self) -> Result<i32, Error> {
        var i: i64 = 0;
        while (i < self.custom_render_slots.len) {
            var slot = self.custom_render_slots.get_ptr(i);
            if (slot[0].active_frame) {
                if (slot[0].shader_read_ready) {
                    match (self.command.transitionImage(&slot[0].texture, image_transition_shader_read_to_color_attachment())) {
                        case Ok(_) => {} case Err(e) => { return Err(Error.create(172, e.message)); }
                    }
                } else {
                    match (self.command.transitionImage(&slot[0].texture, image_transition_undefined_to_color_attachment())) {
                        case Ok(_) => {} case Err(e) => { return Err(Error.create(172, e.message)); }
                    }
                }
                var handler = slot[0].handler.deref();
                match (handler.render(&self.device, &self.compiler, &mut self.command, &slot[0].texture, slot[0].width, slot[0].height)) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(e); }
                }
                match (self.command.transitionImage(&slot[0].texture, image_transition_color_attachment_to_shader_read())) {
                    case Ok(_) => { slot[0].shader_read_ready = true; }
                    case Err(e) => { return Err(Error.create(173, e.message)); }
                }
            }
            i = i + 1;
        }
        return Ok(0);
    }

    private fn destroyLayerTargets(&mut self) {
        var dyn_i: i64 = 0;
        while (dyn_i < self.layer_target_descriptor_sets.len) {
            var set = self.layer_target_descriptor_sets.get(dyn_i);
            set.destroy();
            dyn_i = dyn_i + 1;
        }
        dyn_i = 0;
        while (dyn_i < self.layer_target_views.len) {
            var view = self.layer_target_views.get(dyn_i);
            view.destroy();
            dyn_i = dyn_i + 1;
        }
        dyn_i = 0;
        while (dyn_i < self.layer_target_textures.len) {
            var texture = self.layer_target_textures.get(dyn_i);
            texture.destroy();
            dyn_i = dyn_i + 1;
        }
        self.layer_target_descriptor_sets.clear();
        self.layer_target_views.clear();
        self.layer_target_textures.clear();
        self.layer_target_shader_read_ready.clear();
        self.layer_target_cache_count = 0;
        self.layer_target_width = 0 as u32;
        self.layer_target_height = 0 as u32;
    }

    private fn destroyClipStencilTarget(&mut self) {
        self.clip_stencil_texture.destroy();
        self.clip_stencil_texture = Texture.empty();
        self.clip_stencil_width = 0 as u32;
        self.clip_stencil_height = 0 as u32;
        self.clip_stencil_ready = false;
    }

    private fn ensureClipStencilTarget(&mut self, required: bool) -> Result<i32, Error> {
        self.last_frame_clip_stencil_target_count = 0;
        self.last_frame_clip_stencil_target_bytes = 0 as u64;
        if (!required) { return Ok(0); }
        self.last_frame_clip_stencil_target_count = 1;
        self.last_frame_clip_stencil_target_bytes = (self.width as u64) * (self.height as u64) * (4 as u64);
        if (self.clip_stencil_texture.isValid() && self.clip_stencil_width == self.width && self.clip_stencil_height == self.height) {
            return Ok(0);
        }
        self.destroyClipStencilTarget();
        match (self.consumeForcedTransientResourceError(4, "forced clip stencil target creation failure")) {
            case Ok(_) => {}
            case Err(e) => {
                self.recordTransientPartialFailure(4, 0, 0, 0 as u64);
                return Err(e);
            }
        }
        let usage = texture_usage_depth_stencil_attachment();
        match (self.device.createTexture(TextureDesc.create2D(self.width, self.height, format_d24_unorm_s8_uint(), usage, "NutClipStencilTarget").setInitialState(resource_undefined()))) {
            case Ok(v) => {
                self.clip_stencil_texture = v;
                self.clip_stencil_width = self.width;
                self.clip_stencil_height = self.height;
                self.clip_stencil_ready = false;
                return Ok(0);
            }
            case Err(e) => {
                self.recordTransientPartialFailure(4, 0, 0, 0 as u64);
                return Err(Error.create(138, e.message));
            }
        }
    }

    public fn trimLayerTargetCache(&mut self, max_count: i32) -> Result<i32, Error> {
        if (max_count < 0) {
            return Err(Error.create(136, "layer target cache trim count is negative"));
        }
        var removed: i32 = 0;
        while (self.layer_target_cache_count > max_count) {
            let idx = (self.layer_target_cache_count - 1) as i64;
            var set = self.layer_target_descriptor_sets.removeAt(idx);
            set.destroy();
            var view = self.layer_target_views.removeAt(idx);
            view.destroy();
            var texture = self.layer_target_textures.removeAt(idx);
            texture.destroy();
            self.layer_target_shader_read_ready.removeAt(idx);
            self.layer_target_cache_count = self.layer_target_cache_count - 1;
            removed = removed + 1;
        }
        self.layer_target_trimmed_count = self.layer_target_trimmed_count + removed;
        if (self.layer_target_cache_count == 0) {
            self.layer_target_width = 0 as u32;
            self.layer_target_height = 0 as u32;
        }
        return Ok(removed);
    }

    public fn purgeTransientResources(&mut self) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(156, e.message)); }
        }
        self.last_purged_transient_resource_count = 0;
        self.last_purged_transient_resource_bytes = 0 as u64;
        let purged_layers = self.layer_target_cache_count;
        let purged_clip = self.clip_stencil_texture.isValid();
        self.last_purged_transient_resource_bytes = self.transientResourceBytes();
        if (purged_layers > 0) {
            self.layer_target_purge_count = self.layer_target_purge_count + 1;
        }
        if (purged_clip) {
            self.clip_stencil_purge_count = self.clip_stencil_purge_count + 1;
        }
        self.destroyLayerTargets();
        self.destroyClipStencilTarget();
        var removed = purged_layers;
        if (purged_clip) { removed = removed + 1; }
        self.last_purged_transient_resource_count = removed;
        if (removed > 0) {
            self.transient_resource_purge_count = self.transient_resource_purge_count + 1;
        }
        return Ok(removed);
    }

    private fn createLayerTarget(&mut self, name: string) -> Result<Texture, Error> {
        match (self.consumeForcedTransientResourceError(1, "forced layer target texture creation failure")) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        let usage = texture_usage_color_attachment() | texture_usage_sampled();
        match (self.device.createTexture(TextureDesc.create2DArray(self.width, self.height, 1 as u32, format_rgba8_unorm(), usage, name).setInitialState(resource_undefined()))) {
            case Ok(v) => { return Ok(v); }
            case Err(e) => { return Err(Error.create(120, e.message)); }
        }
    }

    private fn createLayerTargetView(&mut self, texture: Texture, name: string) -> Result<TextureView, Error> {
        match (self.consumeForcedTransientResourceError(2, "forced layer target view creation failure")) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        match (texture.createView(TextureViewDesc.create(texture_type_2d_array(), format_rgba8_unorm(), image_aspect_color(), name).setArrayRange(0 as u32, 1 as u32))) {
            case Ok(v) => { return Ok(v); }
            case Err(e) => { return Err(Error.create(121, e.message)); }
        }
    }

    private fn createLayerTargetDescriptor(&mut self, view: TextureView) -> Result<DescriptorSet, Error> {
        match (self.consumeForcedTransientResourceError(3, "forced layer target descriptor creation failure")) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        var set: DescriptorSet;
        match (self.sprite_descriptor_pool.allocate(&self.sprite_set_layout)) {
            case Ok(v) => { set = v; }
            case Err(e) => { return Err(Error.create(122, e.message)); }
        }
        match (set.writeTexture(0 as u32, &view, &self.sprite_sampler, resource_shader_read(), descriptor_sampled_image())) {
            case Ok(_) => {}
            case Err(e) => { set.destroy(); return Err(Error.create(123, e.message)); }
        }
        match (set.writeSampler(1 as u32, &self.sprite_sampler)) {
            case Ok(_) => {}
            case Err(e) => { set.destroy(); return Err(Error.create(124, e.message)); }
        }
        match (set.update()) {
            case Ok(_) => {}
            case Err(e) => { set.destroy(); return Err(Error.create(125, e.message)); }
        }
        return Ok(set);
    }

    private fn ensureLayerTargetCache(&mut self, required_targets: i32) -> Result<i32, Error> {
        var wanted = required_targets;
        if (wanted < 0) { wanted = 0; }
        if (wanted > 255) { return Err(Error.create(135, "GPU layer nesting exceeds Nut descriptor pool capacity")); }
        if (wanted == 0) { return Ok(0); }
        let cache_size_matches = self.layer_target_width == self.width && self.layer_target_height == self.height;
        if (cache_size_matches) {
            var reused = self.layer_target_cache_count;
            if (reused > wanted) { reused = wanted; }
            if (reused > 0) {
                self.last_frame_layer_target_reused_count = reused;
                self.layer_target_reuse_count = self.layer_target_reuse_count + reused;
            }
            if (self.layer_target_cache_count >= wanted) {
                return Ok(0);
            }
        } else if (self.layer_target_cache_count > 0) {
            self.last_frame_layer_target_recreated_count = self.layer_target_cache_count;
            self.layer_target_recreate_count = self.layer_target_recreate_count + self.layer_target_cache_count;
            self.destroyLayerTargets();
        }
        var target_i: i32 = self.layer_target_cache_count;
        while (target_i < wanted) {
            let target_name = "LayerColorTarget" + target_i.toString();
            let view_name = "LayerColorTargetView" + target_i.toString();
            let existing_cleanup_count = self.layer_target_cache_count;
            let existing_cleanup_bytes = self.layerTargetCacheBytes();
            let one_target_bytes = (self.width as u64) * (self.height as u64) * (4 as u64);
            var target: Texture;
            match (self.createLayerTarget(target_name)) {
                case Ok(v) => { target = v; }
                case Err(e) => {
                    self.recordTransientPartialFailure(1, 0, existing_cleanup_count, existing_cleanup_bytes);
                    self.destroyLayerTargets();
                    return Err(e);
                }
            }
            var view: TextureView;
            match (self.createLayerTargetView(target.clone(), view_name)) {
                case Ok(v) => { view = v; }
                case Err(e) => {
                    target.destroy();
                    self.recordTransientPartialFailure(2, 1, existing_cleanup_count + 1, existing_cleanup_bytes + one_target_bytes);
                    self.destroyLayerTargets();
                    return Err(e);
                }
            }
            var set: DescriptorSet;
            match (self.createLayerTargetDescriptor(view.clone())) {
                case Ok(v) => { set = v; }
                case Err(e) => {
                    view.destroy();
                    target.destroy();
                    self.recordTransientPartialFailure(3, 2, existing_cleanup_count + 2, existing_cleanup_bytes + one_target_bytes);
                    self.destroyLayerTargets();
                    return Err(e);
                }
            }
            self.layer_target_textures.push(target);
            self.layer_target_views.push(view);
            self.layer_target_descriptor_sets.push(set);
            self.layer_target_shader_read_ready.push(false);
            self.layer_target_cache_count = self.layer_target_cache_count + 1;
            self.last_frame_layer_target_allocated_count = self.last_frame_layer_target_allocated_count + 1;
            self.layer_target_allocation_count = self.layer_target_allocation_count + 1;
            target_i = target_i + 1;
        }
        self.layer_target_width = self.width;
        self.layer_target_height = self.height;
        if (self.layer_target_cache_count > self.layer_target_peak_count) {
            self.layer_target_peak_count = self.layer_target_cache_count;
            self.layer_target_peak_bytes = (self.layer_target_peak_count as u64) * (self.width as u64) * (self.height as u64) * (4 as u64);
        }
        return Ok(0);
    }

    private fn resetLastFrameExecutionPlanMetrics(&mut self) {
        self.last_frame_execution_plan_valid = false;
        self.last_frame_execution_plan_error_code = 0;
        self.last_frame_execution_plan_pass_count = 0;
        self.last_frame_execution_plan_schedule_level_count = 0;
        self.last_frame_execution_plan_max_schedule_width = 0;
        self.last_frame_execution_plan_physical_resource_count = 0;
        self.last_frame_execution_plan_physical_resource_bytes = 0 as u64;
        self.last_frame_execution_plan_merge_run_count = 0;
        self.last_frame_execution_plan_reuse_opportunity_count = 0;
        self.last_frame_execution_plan_reuse_opportunity_bytes = 0 as u64;
        self.last_frame_execution_plan_consumed = false;
        self.last_frame_execution_plan_compiled_binding_count = 0;
        self.last_frame_execution_plan_driven_pass_count = 0;
        self.last_frame_execution_plan_driven_layer_pass_count = 0;
        self.last_frame_execution_plan_driven_main_pass_count = 0;
        self.last_frame_execution_plan_driven_resource_bind_count = 0;
    }

    private fn framePlanCommandMaterialValue(&self, kind: RenderCommandKind) -> i32 {
        if (kind.equals(RenderCommandKind.drawSprite()) || kind.equals(RenderCommandKind.externalView())) { return 2; }
        if (kind.equals(RenderCommandKind.fillRect())) { return 1; }
        if (kind.equals(RenderCommandKind.fillCircle())) { return 1; }
        if (kind.equals(RenderCommandKind.fillTriangle())) { return 1; }
        if (kind.equals(RenderCommandKind.fillQuad())) { return 1; }
        if (kind.equals(RenderCommandKind.fillGradientRect())) { return 1; }
        if (kind.equals(RenderCommandKind.strokeLine())) { return 1; }
        if (kind.equals(RenderCommandKind.strokeRect())) { return 1; }
        return 0;
    }

    private fn framePlanCommandVertexEstimate(&self, kind: RenderCommandKind) -> i32 {
        if (kind.equals(RenderCommandKind.drawSprite()) || kind.equals(RenderCommandKind.externalView())) { return 6; }
        if (kind.equals(RenderCommandKind.fillRect())) { return 6; }
        if (kind.equals(RenderCommandKind.fillCircle())) { return 96; }
        if (kind.equals(RenderCommandKind.fillTriangle())) { return 3; }
        if (kind.equals(RenderCommandKind.fillQuad())) { return 6; }
        if (kind.equals(RenderCommandKind.fillGradientRect())) { return 6; }
        if (kind.equals(RenderCommandKind.strokeLine())) { return 6; }
        if (kind.equals(RenderCommandKind.strokeRect())) { return 24; }
        return 0;
    }

    private fn framePlanCommandHasCpuClipPathCoverage(&self, kind: RenderCommandKind) -> bool {
        return self.framePlanCommandMaterialValue(kind) != 0;
    }

    @[borrow_args]
    private fn framePlanMatchingLayerPop(&self, graph: RenderGraph, push_index: i32) -> i32 {
        var depth: i32 = 0;
        var i: i32 = push_index;
        while (i < graph.commandCount()) {
            let command = graph.commandAt(i);
            if (command.kind.equals(RenderCommandKind.pushLayer())) {
                depth = depth + 1;
            }
            if (command.kind.equals(RenderCommandKind.popLayer())) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    @[borrow_args]
    private fn framePlanRangeDrawCount(&self, graph: RenderGraph, first: i32, count: i32) -> i32 {
        var out: i32 = 0;
        var i: i32 = first;
        let end: i32 = first + count;
        while (i < end && i < graph.commandCount()) {
            if (self.framePlanCommandMaterialValue(graph.commandAt(i).kind) != 0) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    private fn framePlanRangeSegmentCount(&self, graph: RenderGraph, first: i32, count: i32) -> i32 {
        var out: i32 = 0;
        var current_material: i32 = 0;
        var current_texture_page: i32 = -1;
        var open_segment = false;
        var i: i32 = first;
        let end: i32 = first + count;
        while (i < end && i < graph.commandCount()) {
            let command = graph.commandAt(i);
            if (command.kind.equals(RenderCommandKind.pushClipRect()) || command.kind.equals(RenderCommandKind.pushClipPath()) || command.kind.equals(RenderCommandKind.popClip())) {
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
            }
            if (command.kind.equals(RenderCommandKind.usePipeline())) {
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
            }
            if (command.kind.equals(RenderCommandKind.pushLayer()) || command.kind.equals(RenderCommandKind.popLayer())) {
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
            }
            let material = self.framePlanCommandMaterialValue(command.kind);
            if (command.kind.equals(RenderCommandKind.externalView())) {
                out = out + 1;
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
                i = i + 1;
                continue;
            }
            if (material != 0) {
                var texture_page = -1;
                if (command.kind.equals(RenderCommandKind.drawSprite())) {
                    texture_page = command.sprite.region.atlas_id;
                }
                if (!open_segment || material != current_material || (material == 2 && texture_page != current_texture_page)) {
                    out = out + 1;
                    current_material = material;
                    current_texture_page = texture_page;
                    open_segment = true;
                }
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    private fn buildLastFrameRenderPlan(&self, graph: RenderGraph) -> Result<RenderPlan, Error> {
        match (graph.validate()) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        var out = RenderPlan.empty();
        out.command_count = graph.commandCount();
        out.draw_count = graph.drawCommandCount();
        out.has_clear = graph.hasClear();
        var external_slots = Vec::<i32>.new();
        var external_i: i32 = 0;
        while (external_i < graph.commandCount()) {
            let external_command = graph.commandAt(external_i);
            if (external_command.kind.equals(RenderCommandKind.externalView())) {
                var seen = false;
                var scan: i64 = 0;
                while (scan < external_slots.len) {
                    if (external_slots.get(scan) == external_command.external_slot) { seen = true; }
                    scan = scan + 1;
                }
                if (!seen) {
                    external_slots.push(external_command.external_slot);
                    out.addPassForTarget(RenderPassKind.external(), external_i, 1, 1, 1, external_command.external_slot, false);
                }
            }
            external_i = external_i + 1;
        }

        var current_material: i32 = 0;
        var current_texture_page: i32 = -1;
        var texture_pages = Vec::<i32>.new();
        var pipeline_ids = Vec::<i32>.new();
        var clip_path_depth_stack = Vec::<i32>.new();
        var open_segment = false;
        var layer_depth: i32 = 0;
        var clip_path_depth: i32 = 0;
        var current_segment_target: i32 = 0;
        var i: i32 = 0;
        while (i < graph.commandCount()) {
            let command = graph.commandAt(i);
            if (command.kind.equals(RenderCommandKind.pushTransform()) || command.kind.equals(RenderCommandKind.popTransform())) {
                out.transform_change_count = out.transform_change_count + 1;
            }
            if (command.kind.equals(RenderCommandKind.pushClipRect()) || command.kind.equals(RenderCommandKind.pushClipPath()) || command.kind.equals(RenderCommandKind.popClip())) {
                out.clip_change_count = out.clip_change_count + 1;
                if (command.kind.equals(RenderCommandKind.pushClipRect())) {
                    clip_path_depth_stack.push(clip_path_depth);
                }
                if (command.kind.equals(RenderCommandKind.pushClipPath())) {
                    clip_path_depth_stack.push(clip_path_depth);
                    out.clip_path_count = out.clip_path_count + 1;
                    out.clip_path_bounds_fallback_count = out.clip_path_bounds_fallback_count + 1;
                    clip_path_depth = clip_path_depth + 1;
                }
                if (command.kind.equals(RenderCommandKind.popClip())) {
                    if (!clip_path_depth_stack.isEmpty()) {
                        clip_path_depth = clip_path_depth_stack.pop();
                    } else {
                        clip_path_depth = 0;
                    }
                }
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                }
            }
            if (command.kind.equals(RenderCommandKind.usePipeline())) {
                out.pipeline_change_count = out.pipeline_change_count + 1;
                let pipeline_id = command.stroke_width as i32;
                out.last_pipeline_id = pipeline_id;
                if (pipeline_id == 0) {
                    out.default_pipeline_change_count = out.default_pipeline_change_count + 1;
                } else {
                    out.custom_pipeline_change_count = out.custom_pipeline_change_count + 1;
                }
                var has_pipeline_id = false;
                var pipeline_scan: i32 = 0;
                while (pipeline_scan < (pipeline_ids.len as i32)) {
                    if (pipeline_ids.get(pipeline_scan as i64) == pipeline_id) {
                        has_pipeline_id = true;
                    }
                    pipeline_scan = pipeline_scan + 1;
                }
                if (!has_pipeline_id) {
                    pipeline_ids.push(pipeline_id);
                }
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                }
            }
            if (command.kind.equals(RenderCommandKind.pushLayer()) || command.kind.equals(RenderCommandKind.popLayer())) {
                out.layer_change_count = out.layer_change_count + 1;
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                    current_texture_page = -1;
                }
                if (command.kind.equals(RenderCommandKind.pushLayer())) {
                    out.layer_pass_count = out.layer_pass_count + 1;
                    layer_depth = layer_depth + 1;
                    current_segment_target = layer_depth;
                    if (layer_depth > out.max_layer_depth) {
                        out.max_layer_depth = layer_depth;
                    }
                    let layer_end = self.framePlanMatchingLayerPop(graph, i);
                    if (layer_end > i) {
                        let layer_first = i + 1;
                        let layer_count = layer_end - layer_first;
                        out.addPassForTarget(RenderPassKind.layer(), layer_first, layer_count, self.framePlanRangeDrawCount(graph, layer_first, layer_count), self.framePlanRangeSegmentCount(graph, layer_first, layer_count), layer_depth - 1, false);
                    }
                } else {
                    out.addPassForTarget(RenderPassKind.composite(), i, 1, 1, 1, layer_depth - 1, false);
                    layer_depth = layer_depth - 1;
                    if (layer_depth < 0) {
                        layer_depth = 0;
                    }
                    current_segment_target = layer_depth;
                    out.segment_count = out.segment_count + 1;
                    out.textured_segment_count = out.textured_segment_count + 1;
                    out.estimated_textured_vertices = out.estimated_textured_vertices + 6;
                    open_segment = false;
                    current_material = 0;
                    current_texture_page = -1;
                }
            }

            let material = self.framePlanCommandMaterialValue(command.kind);
            if (material != 0) {
                if (clip_path_depth > 0 && self.framePlanCommandHasCpuClipPathCoverage(command.kind) && out.clip_path_cpu_coverage_count < out.clip_path_count) {
                    var cover_count = clip_path_depth;
                    let remaining_cover = out.clip_path_count - out.clip_path_cpu_coverage_count;
                    if (cover_count > remaining_cover) { cover_count = remaining_cover; }
                    out.clip_path_cpu_coverage_count = out.clip_path_cpu_coverage_count + cover_count;
                    if (out.clip_path_bounds_fallback_count >= cover_count) {
                        out.clip_path_bounds_fallback_count = out.clip_path_bounds_fallback_count - cover_count;
                    } else {
                        out.clip_path_bounds_fallback_count = 0;
                    }
                }
                var texture_page = -1;
                if (command.kind.equals(RenderCommandKind.drawSprite())) {
                    texture_page = command.sprite.region.atlas_id;
                    var has_texture_page = false;
                    var texture_page_scan: i32 = 0;
                    while (texture_page_scan < (texture_pages.len as i32)) {
                        if (texture_pages.get(texture_page_scan as i64) == texture_page) {
                            has_texture_page = true;
                        }
                        texture_page_scan = texture_page_scan + 1;
                    }
                    if (!has_texture_page) {
                        texture_pages.push(texture_page);
                    }
                }
                if (command.kind.equals(RenderCommandKind.externalView()) || !open_segment || material != current_material || current_segment_target != layer_depth || (material == 2 && texture_page != current_texture_page)) {
                    out.segment_count = out.segment_count + 1;
                    current_material = material;
                    current_texture_page = texture_page;
                    current_segment_target = layer_depth;
                    open_segment = true;
                    if (material == 2) {
                        out.textured_segment_count = out.textured_segment_count + 1;
                    } else {
                        out.solid_segment_count = out.solid_segment_count + 1;
                    }
                }
                let vertices = self.framePlanCommandVertexEstimate(command.kind);
                if (material == 2) {
                    out.textured_draw_count = out.textured_draw_count + 1;
                    out.estimated_textured_vertices = out.estimated_textured_vertices + vertices;
                } else {
                    out.solid_draw_count = out.solid_draw_count + 1;
                    out.estimated_solid_vertices = out.estimated_solid_vertices + vertices;
                }
                if (command.kind.equals(RenderCommandKind.externalView())) { open_segment = false; }
            }
            i = i + 1;
        }
        out.texture_page_count = texture_pages.len as i32;
        out.unique_pipeline_count = pipeline_ids.len as i32;
        out.clip_expansion_vertex_reserve = (out.clip_path_count * 256) + (out.command_count * 32);
        if (out.clip_path_count > 0) {
            out.clip_mask_vertex_capacity_estimate = (out.clip_path_count * 256) + 6;
            if (graph.hasDrawBounds()) {
                let clip_bounds = graph.drawBounds();
                var clip_width = clip_bounds.width as i64;
                var clip_height = clip_bounds.height as i64;
                if (clip_width < 1) { clip_width = 1; }
                if (clip_height < 1) { clip_height = 1; }
                out.clip_stencil_target_bytes_estimate = (clip_width as u64) * (clip_height as u64) * (4 as u64);
            }
        }
        out.layer_composite_vertex_reserve = out.layer_pass_count * 6;
        let graph_vertex_estimate = out.estimatedVertexCount() - out.layer_composite_vertex_reserve;
        out.solid_vertex_capacity_estimate = graph_vertex_estimate + out.clip_expansion_vertex_reserve;
        out.textured_vertex_capacity_estimate = graph_vertex_estimate + out.layer_composite_vertex_reserve + out.clip_expansion_vertex_reserve;

        if (out.command_count > 0 || out.has_clear) {
            out.addPassForTarget(RenderPassKind.color(), 0, out.command_count, out.draw_count, out.segment_count, -1, out.has_clear);
            out.addResourceForPageLifetime(RenderResourceKind.swapchainColor(), 0 as u64, 0, out.passCount() - 1, out.passCount() - 1);
        }
        if (out.estimated_solid_vertices > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.solidVertexBuffer(), (out.solid_vertex_capacity_estimate as u64) * (sizeof::<SolidVertex>() as u64), 0, 0, out.passCount() - 1);
        }
        if (out.estimated_textured_vertices > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.texturedVertexBuffer(), (out.textured_vertex_capacity_estimate as u64) * (sizeof::<TexturedVertex>() as u64), 0, 0, out.passCount() - 1);
            var texture_i: i32 = 0;
            while (texture_i < (texture_pages.len as i32)) {
                out.addResourceForPageLifetime(RenderResourceKind.spriteTexture(), 0 as u64, texture_pages.get(texture_i as i64), 0, out.passCount() - 1);
                texture_i = texture_i + 1;
            }
        }
        var external_resource_i: i32 = 0;
        while (external_resource_i < (external_slots.len as i32)) {
            out.addResourceForPageLifetime(RenderResourceKind.externalColorTarget(), 0 as u64, external_slots.get(external_resource_i as i64), external_resource_i, out.passCount() - 1);
            external_resource_i = external_resource_i + 1;
        }
        if (out.clip_path_count > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.clipMaskVertexBuffer(), (out.clip_mask_vertex_capacity_estimate as u64) * (sizeof::<SolidVertex>() as u64), 0, 0, out.passCount() - 1);
            out.addResourceForPageLifetime(RenderResourceKind.clipStencilTarget(), out.clip_stencil_target_bytes_estimate, 0, 0, out.passCount() - 1);
        }
        var layer_target_bytes: u64 = 0 as u64;
        if (out.max_layer_depth > 0 && graph.hasDrawBounds()) {
            let layer_bounds = graph.drawBounds();
            var layer_width = layer_bounds.width as i64;
            var layer_height = layer_bounds.height as i64;
            if (layer_width < 1) { layer_width = 1; }
            if (layer_height < 1) { layer_height = 1; }
            layer_target_bytes = (layer_width as u64) * (layer_height as u64) * (4 as u64);
        }
        var layer_resource_i: i32 = 0;
        while (layer_resource_i < out.max_layer_depth) {
            var first_layer_pass = -1;
            var last_layer_pass = -1;
            var pass_i: i32 = 0;
            while (pass_i < out.passCount()) {
                let pass = out.passAt(pass_i);
                if ((pass.kind.equals(RenderPassKind.layer()) || pass.kind.equals(RenderPassKind.composite())) && pass.target_id == layer_resource_i) {
                    if (first_layer_pass < 0) { first_layer_pass = pass_i; }
                    last_layer_pass = pass_i;
                }
                pass_i = pass_i + 1;
            }
            out.addResourceForPageLifetime(RenderResourceKind.layerColorTarget(), layer_target_bytes, layer_resource_i, first_layer_pass, last_layer_pass);
            layer_resource_i = layer_resource_i + 1;
        }
        var dependency_resource_i: i32 = 0;
        while (dependency_resource_i < out.resourceCount()) {
            let resource = out.resourceAt(dependency_resource_i);
            if (resource.first_pass >= 0 && resource.last_pass > resource.first_pass) {
                out.addDependency(resource.first_pass, resource.last_pass, dependency_resource_i);
            }
            dependency_resource_i = dependency_resource_i + 1;
        }
        texture_pages.destroy();
        external_slots.destroy();
        pipeline_ids.destroy();
        clip_path_depth_stack.destroy();
        return Ok(out);
    }

    @[borrow_args]
    private fn updateLastFrameExecutionPlan(&mut self, graph: RenderGraph) -> Result<i32, Error> {
        self.resetLastFrameExecutionPlanMetrics();
        var plan: RenderPlan;
        match (self.buildLastFrameRenderPlan(graph)) {
            case Ok(v) => { plan = v; }
            case Err(e) => {
                self.last_frame_execution_plan_error_code = e.codeValue();
                return Err(e);
            }
        }
        var execution = RenderExecutionPlan.build(plan);
        let is_valid = execution.isValidFor(plan);
        self.last_frame_execution_plan_valid = is_valid;
        self.last_frame_execution_plan_pass_count = plan.passCount();
        self.last_frame_execution_plan_schedule_level_count = plan.scheduleLevelCount();
        self.last_frame_execution_plan_max_schedule_width = plan.maxScheduleWidth();
        self.last_frame_execution_plan_physical_resource_count = execution.physicalResourceCountForPlan(plan);
        self.last_frame_execution_plan_physical_resource_bytes = execution.physicalResourceEstimatedBytesForPlan(plan);
        self.last_frame_execution_plan_merge_run_count = execution.mergeRunCount();
        self.last_frame_execution_plan_reuse_opportunity_count = plan.resourceReuseOpportunityCount();
        self.last_frame_execution_plan_reuse_opportunity_bytes = plan.resourceReuseOpportunityBytes();
        self.last_frame_execution_plan_compiled_binding_count = execution.compiledBindingCount();
        execution.destroy();
        plan.destroy();
        if (!is_valid) {
            self.last_frame_execution_plan_error_code = 187;
            return Err(Error.create(187, "RenderExecutionPlan is invalid for RenderPlan"));
        }
        return Ok(0);
    }

    private fn updateLayerTargetDemand(&mut self, graph: RenderGraph) -> Result<i32, Error> {
        let previous_transient_count = self.transientResourceCount();
        let previous_transient_bytes = self.transientResourceBytes();
        self.last_frame_layer_target_count = 0;
        self.last_frame_layer_target_bytes = 0 as u64;
        self.last_frame_layer_target_allocated_count = 0;
        self.last_frame_layer_target_reused_count = 0;
        self.last_frame_layer_target_recreated_count = 0;
        self.last_frame_transient_resource_count = 0;
        self.last_frame_transient_resource_bytes = 0 as u64;
        self.last_frame_transient_resource_reused_count = 0;
        self.last_frame_main_draw_count = 0;
        self.last_frame_layer_draw_count = 0;
        self.last_frame_layer_composite_capacity_count = 0;
        self.last_frame_clip_path_count = 0;
        self.last_frame_clip_path_bounds_fallback_count = 0;
        self.last_frame_clip_stencil_target_count = 0;
        self.last_frame_clip_stencil_target_bytes = 0 as u64;
        self.last_frame_pipeline_switch_count = 0;
        self.last_frame_custom_pipeline_switch_count = 0;
        self.last_frame_last_pipeline_id = 0;
        self.last_frame_push_constant_count = 0;
        self.last_frame_push_constant_bytes = 0 as u64;
        self.last_frame_push_constant_pipeline_id = 0;
        self.last_frame_layer_cache_count = self.layer_target_cache_count;
        self.last_frame_layer_cache_bytes = (self.layer_target_cache_count as u64) * (self.width as u64) * (self.height as u64) * (4 as u64);
        var depth: i32 = 0;
        var max_depth: i32 = 0;
        var i: i32 = 0;
        while (i < graph.commandCount()) {
            let command = graph.commandAt(i);
            if (command.kind.equals(RenderCommandKind.pushLayer())) {
                depth = depth + 1;
                if (depth > max_depth) {
                    max_depth = depth;
                }
            }
            if (command.kind.equals(RenderCommandKind.popLayer())) {
                if (depth > 0) {
                    self.last_frame_layer_composite_capacity_count = self.last_frame_layer_composite_capacity_count + 1;
                }
                depth = depth - 1;
                if (depth < 0) {
                    depth = 0;
                }
            }
            if (command.kind.equals(RenderCommandKind.pushClipPath())) {
                self.last_frame_clip_path_count = self.last_frame_clip_path_count + 1;
                self.last_frame_clip_path_bounds_fallback_count = self.last_frame_clip_path_bounds_fallback_count + 1;
            }
            if (command.kind.equals(RenderCommandKind.usePipeline())) {
                let pipeline_id = command.stroke_width as i32;
                self.last_frame_pipeline_switch_count = self.last_frame_pipeline_switch_count + 1;
                self.last_frame_last_pipeline_id = pipeline_id;
                if (pipeline_id != 0) {
                    self.last_frame_custom_pipeline_switch_count = self.last_frame_custom_pipeline_switch_count + 1;
                }
            }
            let is_draw = command.kind.equals(RenderCommandKind.fillRect())
                || command.kind.equals(RenderCommandKind.fillCircle())
                || command.kind.equals(RenderCommandKind.fillTriangle())
                || command.kind.equals(RenderCommandKind.fillQuad())
                || command.kind.equals(RenderCommandKind.fillGradientRect())
                || command.kind.equals(RenderCommandKind.drawSprite())
                || command.kind.equals(RenderCommandKind.externalView())
                || command.kind.equals(RenderCommandKind.strokeLine())
                || command.kind.equals(RenderCommandKind.strokeRect());
            if (is_draw) {
                if (depth > 0) {
                    self.last_frame_layer_draw_count = self.last_frame_layer_draw_count + 1;
                } else {
                    self.last_frame_main_draw_count = self.last_frame_main_draw_count + 1;
                }
            }
            i = i + 1;
        }
        self.last_frame_layer_target_count = max_depth;
        if (max_depth > 0 && graph.hasDrawBounds()) {
            let layer_bounds = graph.drawBounds();
            var layer_width = layer_bounds.width as i64;
            var layer_height = layer_bounds.height as i64;
            if (layer_width < 1) { layer_width = 1; }
            if (layer_height < 1) { layer_height = 1; }
            self.last_frame_layer_target_bytes = ((layer_width as u64) * (layer_height as u64) * (4 as u64)) * (max_depth as u64);
        }
        match (self.ensureLayerTargetCache(max_depth)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        match (self.ensureClipStencilTarget(self.last_frame_clip_path_count > 0)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        self.last_frame_layer_cache_count = self.layer_target_cache_count;
        self.last_frame_layer_cache_bytes = (self.layer_target_cache_count as u64) * (self.width as u64) * (self.height as u64) * (4 as u64);
        self.last_frame_transient_resource_count = self.transientResourceCount();
        self.last_frame_transient_resource_bytes = self.transientResourceBytes();
        var reused_transient_count = previous_transient_count;
        if (reused_transient_count > self.last_frame_transient_resource_count) {
            reused_transient_count = self.last_frame_transient_resource_count;
        }
        if (previous_transient_bytes == 0 as u64 || self.last_frame_transient_resource_bytes == 0 as u64) {
            reused_transient_count = 0;
        }
        self.last_frame_transient_resource_reused_count = reused_transient_count;
        if (reused_transient_count > 0) {
            self.transient_resource_retained_frame_count = self.transient_resource_retained_frame_count + 1;
        }
        if (self.last_frame_transient_resource_count > 0) {
            self.transient_resource_consecutive_retained_frame_count = self.transient_resource_consecutive_retained_frame_count + 1;
            if (self.transient_resource_consecutive_retained_frame_count > self.transient_resource_max_consecutive_retained_frame_count) {
                self.transient_resource_max_consecutive_retained_frame_count = self.transient_resource_consecutive_retained_frame_count;
            }
        } else {
            self.transient_resource_consecutive_retained_frame_count = 0;
        }
        if (self.last_frame_transient_resource_count > self.transient_resource_peak_count) {
            self.transient_resource_peak_count = self.last_frame_transient_resource_count;
        }
        if (self.last_frame_transient_resource_bytes > self.transient_resource_peak_bytes) {
            self.transient_resource_peak_bytes = self.last_frame_transient_resource_bytes;
        }
        return Ok(0);
    }

    private fn customPipelineIndex(&self, pipeline_id: i32) -> i32 {
        var i: i32 = 0;
        while (i < (self.custom_pipelines.len as i32)) {
            if (self.custom_pipelines.get(i as i64).id == pipeline_id) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    private fn destroyCustomPipelineSlot(&self, slot: CustomPipelineSlot) {
        var owned_slot = slot;
        owned_slot.pipeline.destroy();
        if (owned_slot.has_clip_pipeline) { owned_slot.clip_pipeline.destroy(); }
        if (owned_slot.owns_layout) { owned_slot.layout.destroy(); }
        if (owned_slot.owns_clip_layout) { owned_slot.clip_layout.destroy(); }
        var dyn_i: i64 = 0;
        while (dyn_i < owned_slot.dynamic_descriptor_sets.len) {
            var set = owned_slot.dynamic_descriptor_sets.get(dyn_i);
            set.destroy();
            dyn_i = dyn_i + 1;
        }
        dyn_i = 0;
        while (dyn_i < owned_slot.owned_dynamic_descriptor_sets.len) {
            var owned_set = owned_slot.owned_dynamic_descriptor_sets.get(dyn_i);
            owned_set.destroy();
            dyn_i = dyn_i + 1;
        }
        owned_slot.custom_descriptor_set_layouts.destroy();
        owned_slot.custom_vertex_bindings.destroy();
        owned_slot.custom_vertex_attributes.destroy();
        owned_slot.static_descriptor_sets.destroy();
        owned_slot.owned_dynamic_descriptor_sets.destroy();
        owned_slot.dynamic_descriptor_set_custom_indices.destroy();
        owned_slot.dynamic_descriptor_sets.destroy();
        owned_slot.dynamic_descriptor_pool_generations.destroy();
        owned_slot.dynamic_descriptor_update_generations.destroy();
        owned_slot.dynamic_descriptor_last_update_frames.destroy();
    }

    @[borrow_args]
    private fn cloneCustomPipelineVertexBindings(&self, desc: &CustomPipelineDesc) -> Vec<VertexInputBinding> {
        var out = Vec::<VertexInputBinding>.new();
        var i: i64 = 0;
        while (i < desc.custom_vertex_bindings.len) {
            let binding = desc.custom_vertex_bindings.get(i);
            out.push(VertexInputBinding.create(binding.binding, binding.stride, binding.input_rate));
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    private fn cloneCustomPipelineVertexAttributes(&self, desc: &CustomPipelineDesc) -> Vec<VertexInputAttribute> {
        var out = Vec::<VertexInputAttribute>.new();
        var i: i64 = 0;
        while (i < desc.custom_vertex_attributes.len) {
            let attr = desc.custom_vertex_attributes.get(i);
            out.push(VertexInputAttribute.create(attr.location, attr.binding, attr.format, attr.offset, attr.semantic_name, attr.semantic_index));
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    private fn cloneCustomPipelineDescriptorSetLayouts(&self, desc: &CustomPipelineDesc) -> Vec<DescriptorSetLayout> {
        var out = Vec::<DescriptorSetLayout>.new();
        var i: i64 = 0;
        while (i < desc.custom_set_layouts.len) {
            out.push(desc.custom_set_layouts.get(i).clone());
            i = i + 1;
        }
        return out;
    }

    public fn customPipelineMaterialKind(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return -1; }
        return self.custom_pipelines.get(idx as i64).material_kind;
    }

    public fn customPipelineVertexLayoutKind(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return -1; }
        return self.custom_pipelines.get(idx as i64).vertex_layout_kind;
    }

    public fn customPipelineVertexLayoutName(&self, pipeline_id: i32) -> string {
        return rendererCustomPipelineVertexLayoutName(self.customPipelineVertexLayoutKind(pipeline_id));
    }

    public fn customPipelineUsesSpriteDescriptors(&self, pipeline_id: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        return self.custom_pipelines.get(idx as i64).use_sprite_descriptors;
    }

    public fn customPipelineCustomVertexBindingCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        return self.custom_pipelines.get(idx as i64).custom_vertex_binding_count;
    }

    public fn customPipelineCustomVertexAttributeCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        return self.custom_pipelines.get(idx as i64).custom_vertex_attribute_count;
    }

    public fn customPipelineUsesCustomVertexInput(&self, pipeline_id: i32) -> bool {
        return self.customPipelineCustomVertexBindingCount(pipeline_id) > 0
            || self.customPipelineCustomVertexAttributeCount(pipeline_id) > 0;
    }

    public fn customPipelineHasNoVertexInput(&self, pipeline_id: i32) -> bool {
        return self.customPipelineVertexLayoutKind(pipeline_id) == rendererCustomPipelineVertexLayoutNone();
    }

    public fn customPipelineVertexBindingNumberAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_bindings.get(index as i64).binding;
    }

    public fn customPipelineVertexBindingStrideAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_bindings.get(index as i64).stride;
    }

    public fn customPipelineVertexBindingInputRateAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_bindings.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_bindings.get(index as i64).input_rate;
    }

    public fn customPipelineVertexInputTotalStride(&self, pipeline_id: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        var total: u32 = 0 as u32;
        var i: i32 = 0;
        while (i < (slot.custom_vertex_bindings.len as i32)) {
            total = total + slot.custom_vertex_bindings.get(i as i64).stride;
            i = i + 1;
        }
        return total;
    }

    public fn customPipelineVertexAttributeLocationAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_attributes.get(index as i64).location;
    }

    public fn customPipelineVertexAttributeBindingAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_attributes.get(index as i64).binding;
    }

    public fn customPipelineVertexAttributeFormatAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_attributes.get(index as i64).format;
    }

    public fn customPipelineVertexAttributeOffsetAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_attributes.get(index as i64).offset;
    }

    public fn customPipelineVertexAttributeSemanticNameAt(&self, pipeline_id: i32, index: i32) -> string {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return ""; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return ""; }
        return slot.custom_vertex_attributes.get(index as i64).semantic_name;
    }

    public fn customPipelineVertexAttributeSemanticIndexAt(&self, pipeline_id: i32, index: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (index < 0 || index >= (slot.custom_vertex_attributes.len as i32)) { return 0 as u32; }
        return slot.custom_vertex_attributes.get(index as i64).semantic_index;
    }

    public fn customPipelineDescriptorSetLayoutCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        return self.custom_pipelines.get(idx as i64).custom_descriptor_set_layout_count;
    }

    public fn customPipelineStaticDescriptorSetCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        return self.custom_pipelines.get(idx as i64).static_descriptor_sets.len as i32;
    }

    public fn customPipelineTotalDescriptorSetLayoutCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        let slot = self.custom_pipelines.get(idx as i64);
        var count = slot.custom_descriptor_set_layout_count;
        if (slot.use_sprite_descriptors) { count = count + 1; }
        return count;
    }

    public fn customPipelineHasStaticDescriptorSets(&self, pipeline_id: i32) -> bool {
        return self.customPipelineStaticDescriptorSetCount(pipeline_id) > 0;
    }

    public fn customPipelineStaticDescriptorFirstSet(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return -1; }
        let slot = self.custom_pipelines.get(idx as i64);
        if (slot.static_descriptor_sets.len <= 0) { return -1; }
        if (slot.use_sprite_descriptors) { return 1; }
        return 0;
    }

    public fn customPipelineStaticDescriptorLastSet(&self, pipeline_id: i32) -> i32 {
        let first = self.customPipelineStaticDescriptorFirstSet(pipeline_id);
        if (first < 0) { return -1; }
        return first + self.customPipelineStaticDescriptorSetCount(pipeline_id) - 1;
    }

    public fn customPipelineUserBindGroupCount(&self, pipeline_id: i32) -> i32 {
        return self.customPipelineDescriptorSetLayoutCount(pipeline_id);
    }

    public fn customPipelineDescriptorSetIsSprite(&self, pipeline_id: i32, set_index: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0 || set_index < 0) { return false; }
        let slot = self.custom_pipelines.get(idx as i64);
        return slot.use_sprite_descriptors && set_index == 0;
    }

    public fn customPipelineDescriptorSetCustomIndex(&self, pipeline_id: i32, set_index: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0 || set_index < 0) { return -1; }
        let slot = self.custom_pipelines.get(idx as i64);
        var first_custom = 0;
        if (slot.use_sprite_descriptors) { first_custom = 1; }
        let custom_index = set_index - first_custom;
        if (custom_index < 0 || custom_index >= slot.custom_descriptor_set_layout_count) { return -1; }
        return custom_index;
    }

    public fn customPipelineDescriptorSetIsStatic(&self, pipeline_id: i32, set_index: i32) -> bool {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        if (custom_index < 0) { return false; }
        return custom_index < self.customPipelineStaticDescriptorSetCount(pipeline_id);
    }

    public fn customPipelineDescriptorSetIsDynamic(&self, pipeline_id: i32, set_index: i32) -> bool {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        if (custom_index < 0) { return false; }
        return custom_index >= self.customPipelineStaticDescriptorSetCount(pipeline_id);
    }

    public fn customPipelineDynamicDescriptorSetCount(&self, pipeline_id: i32) -> i32 {
        let total = self.customPipelineDescriptorSetLayoutCount(pipeline_id);
        let static_count = self.customPipelineStaticDescriptorSetCount(pipeline_id);
        if (total <= static_count) { return 0; }
        return total - static_count;
    }

    public fn customPipelineDynamicDescriptorFirstSet(&self, pipeline_id: i32) -> i32 {
        if (self.customPipelineDynamicDescriptorSetCount(pipeline_id) <= 0) { return -1; }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return -1; }
        let slot = self.custom_pipelines.get(idx as i64);
        var first = slot.static_descriptor_sets.len as i32;
        if (slot.use_sprite_descriptors) { first = first + 1; }
        return first;
    }

    public fn customPipelineDynamicDescriptorLastSet(&self, pipeline_id: i32) -> i32 {
        let first = self.customPipelineDynamicDescriptorFirstSet(pipeline_id);
        if (first < 0) { return -1; }
        return first + self.customPipelineDynamicDescriptorSetCount(pipeline_id) - 1;
    }

    public fn customPipelineBoundDynamicDescriptorSetCount(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0; }
        return self.custom_pipelines.get(idx as i64).dynamic_descriptor_sets.len as i32;
    }

    public fn customPipelineMissingDynamicDescriptorSetCount(&self, pipeline_id: i32) -> i32 {
        let expected = self.customPipelineDynamicDescriptorSetCount(pipeline_id);
        let bound = self.customPipelineBoundDynamicDescriptorSetCount(pipeline_id);
        if (expected <= bound) { return 0; }
        return expected - bound;
    }

    public fn customPipelineDynamicDescriptorSetIsBound(&self, pipeline_id: i32, set_index: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        if (custom_index < self.customPipelineStaticDescriptorSetCount(pipeline_id)) { return false; }
        let slot = self.custom_pipelines.get(idx as i64);
        var i: i64 = 0;
        while (i < slot.dynamic_descriptor_set_custom_indices.len) {
            if (slot.dynamic_descriptor_set_custom_indices.get(i) == custom_index) { return true; }
            i = i + 1;
        }
        return false;
    }

    private fn customPipelineDynamicDescriptorEntryIndex(&self, pipeline_id: i32, custom_index: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0 || custom_index < 0) { return -1; }
        let slot = self.custom_pipelines.get(idx as i64);
        var i: i32 = 0;
        while (i < (slot.dynamic_descriptor_set_custom_indices.len as i32)) {
            if (slot.dynamic_descriptor_set_custom_indices.get(i as i64) == custom_index) { return i; }
            i = i + 1;
        }
        return -1;
    }

    private fn clearCustomPipelineDynamicDescriptorsAt(&mut self, slot_index: i32) -> i32 {
        if (slot_index < 0 || slot_index >= (self.custom_pipelines.len as i32)) { return 0; }
        var slot = self.custom_pipelines.get(slot_index as i64);
        let cleared = slot.dynamic_descriptor_sets.len as i32;
        var i: i64 = 0;
        while (i < slot.dynamic_descriptor_sets.len) {
            var set = slot.dynamic_descriptor_sets.get(i);
            set.destroy();
            i = i + 1;
        }
        i = 0;
        while (i < slot.owned_dynamic_descriptor_sets.len) {
            var owned_set = slot.owned_dynamic_descriptor_sets.get(i);
            owned_set.destroy();
            i = i + 1;
        }
        slot.owned_dynamic_descriptor_sets.destroy();
        slot.dynamic_descriptor_set_custom_indices.destroy();
        slot.dynamic_descriptor_sets.destroy();
        slot.dynamic_descriptor_pool_generations.destroy();
        slot.dynamic_descriptor_update_generations.destroy();
        slot.dynamic_descriptor_last_update_frames.destroy();
        slot.owned_dynamic_descriptor_sets = Vec::<DescriptorSet>.new();
        slot.dynamic_descriptor_set_custom_indices = Vec::<i32>.new();
        slot.dynamic_descriptor_sets = Vec::<DescriptorSet>.new();
        slot.dynamic_descriptor_pool_generations = Vec::<i32>.new();
        slot.dynamic_descriptor_update_generations = Vec::<i32>.new();
        slot.dynamic_descriptor_last_update_frames = Vec::<i32>.new();
        self.custom_pipelines.set(slot_index as i64, slot);
        if (cleared > 0) {
            self.custom_dynamic_descriptor_cleared_count = self.custom_dynamic_descriptor_cleared_count + cleared;
            self.custom_dynamic_descriptor_invalidation_count = self.custom_dynamic_descriptor_invalidation_count + 1;
        }
        return cleared;
    }

    private fn invalidateAllCustomPipelineDynamicDescriptors(&mut self) -> i32 {
        var invalidated: i32 = 0;
        var i: i32 = 0;
        while (i < (self.custom_pipelines.len as i32)) {
            invalidated = invalidated + self.clearCustomPipelineDynamicDescriptorsAt(i);
            i = i + 1;
        }
        self.last_custom_dynamic_descriptor_invalidated_count = invalidated;
        return invalidated;
    }

    private fn ensureCustomDescriptorPool(&mut self, required_sets: i32) -> Result<i32, Error> {
        if (required_sets <= 0) { return Ok(0); }
        if (self.custom_descriptor_pool.isValid() && self.custom_descriptor_pool_allocated_count + required_sets <= self.custom_descriptor_pool_capacity) {
            return Ok(0);
        }
        match (self.queue.waitIdle()) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(195, e.message)); }
        }
        let invalidated = self.invalidateAllCustomPipelineDynamicDescriptors();
        if (self.custom_descriptor_pool.isValid()) {
            self.custom_descriptor_pool.destroy();
            self.custom_descriptor_pool_recreate_count = self.custom_descriptor_pool_recreate_count + 1;
        }
        var capacity = self.custom_descriptor_pool_capacity * 2;
        if (capacity < 64) { capacity = 64; }
        while (capacity < required_sets) {
            capacity = capacity * 2;
        }
        var desc = DescriptorPoolDesc.create(capacity as u32);
        let descriptor_capacity = (capacity * 4) as u32;
        desc = desc.addSize(descriptor_sampler(), descriptor_capacity);
        desc = desc.addSize(descriptor_combined_image_sampler(), descriptor_capacity);
        desc = desc.addSize(descriptor_sampled_image(), descriptor_capacity);
        desc = desc.addSize(descriptor_storage_image(), descriptor_capacity);
        desc = desc.addSize(descriptor_uniform_buffer(), descriptor_capacity);
        desc = desc.addSize(descriptor_storage_buffer(), descriptor_capacity);
        desc = desc.addSize(descriptor_uniform_buffer_dynamic(), descriptor_capacity);
        desc = desc.addSize(descriptor_storage_buffer_dynamic(), descriptor_capacity);
        desc = desc.addSize(descriptor_input_attachment(), descriptor_capacity);
        desc = desc.addSize(descriptor_acceleration_structure(), descriptor_capacity);
        var pool: DescriptorPool;
        match (self.device.createDescriptorPool(desc)) {
            case Ok(v) => { pool = v; }
            case Err(e) => {
                self.last_custom_dynamic_descriptor_invalidated_count = invalidated;
                return Err(Error.create(196, e.message));
            }
        }
        self.custom_descriptor_pool = pool;
        self.custom_descriptor_pool_capacity = capacity;
        self.custom_descriptor_pool_allocated_count = 0;
        self.custom_descriptor_pool_generation = self.custom_descriptor_pool_generation + 1;
        self.last_custom_dynamic_descriptor_invalidated_count = invalidated;
        return Ok(0);
    }

    private fn installCustomPipelineDynamicDescriptorSet(&mut self, pipeline_id: i32, set_index: i32, set: DescriptorSet, pool_generation: i32) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        if (!self.customPipelineDescriptorSetIsDynamic(pipeline_id, set_index)) {
            return Err(Error.create(193, "custom pipeline descriptor set is not a dynamic user bind group"));
        }
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        var slot = self.custom_pipelines.get(idx as i64);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry >= 0) {
            var old_set = slot.dynamic_descriptor_sets.get(entry as i64);
            old_set.destroy();
            slot.dynamic_descriptor_sets.set(entry as i64, set.clone());
            slot.dynamic_descriptor_pool_generations.set(entry as i64, pool_generation);
            self.custom_dynamic_descriptor_binding_generation = self.custom_dynamic_descriptor_binding_generation + 1;
            self.custom_dynamic_descriptor_update_generation = self.custom_dynamic_descriptor_update_generation + 1;
            slot.dynamic_descriptor_update_generations.set(entry as i64, self.custom_dynamic_descriptor_update_generation);
            slot.dynamic_descriptor_last_update_frames.set(entry as i64, self.custom_descriptor_frame_generation);
        } else {
            slot.dynamic_descriptor_set_custom_indices.push(custom_index);
            slot.dynamic_descriptor_sets.push(set.clone());
            slot.dynamic_descriptor_pool_generations.push(pool_generation);
            self.custom_dynamic_descriptor_binding_generation = self.custom_dynamic_descriptor_binding_generation + 1;
            self.custom_dynamic_descriptor_update_generation = self.custom_dynamic_descriptor_update_generation + 1;
            slot.dynamic_descriptor_update_generations.push(self.custom_dynamic_descriptor_update_generation);
            slot.dynamic_descriptor_last_update_frames.push(self.custom_descriptor_frame_generation);
        }
        self.custom_pipelines.set(idx as i64, slot);
        return Ok(0);
    }

    public fn setCustomPipelineDynamicDescriptorSet(&mut self, pipeline_id: i32, set_index: i32, set: DescriptorSet) -> Result<i32, Error> {
        return self.installCustomPipelineDynamicDescriptorSet(pipeline_id, set_index, set.clone(), -1);
    }

    public fn allocateCustomPipelineDynamicDescriptorSet(&mut self, pipeline_id: i32, set_index: i32) -> Result<DescriptorSet, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        if (!self.customPipelineDescriptorSetIsDynamic(pipeline_id, set_index)) {
            return Err(Error.create(193, "custom pipeline descriptor set is not a dynamic user bind group"));
        }
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        var slot = self.custom_pipelines.get(idx as i64);
        if (custom_index < 0 || custom_index >= (slot.custom_descriptor_set_layouts.len as i32)) {
            return Err(Error.create(197, "custom pipeline descriptor set layout is missing"));
        }
        match (self.ensureCustomDescriptorPool(1)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        slot = self.custom_pipelines.get(idx as i64);
        var set: DescriptorSet;
        match (self.custom_descriptor_pool.allocate(slot.custom_descriptor_set_layouts.get(custom_index as i64).clone())) {
            case Ok(v) => { set = v; }
            case Err(e) => { return Err(Error.create(198, e.message)); }
        }
        self.custom_descriptor_pool_allocated_count = self.custom_descriptor_pool_allocated_count + 1;
        let out = set.clone();
        slot = self.custom_pipelines.get(idx as i64);
        slot.owned_dynamic_descriptor_sets.push(set);
        self.custom_pipelines.set(idx as i64, slot);
        match (self.installCustomPipelineDynamicDescriptorSet(pipeline_id, set_index, out.clone(), self.custom_descriptor_pool_generation)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        return Ok(out);
    }

    public fn markCustomPipelineDynamicDescriptorSetUpdated(&mut self, pipeline_id: i32, set_index: i32) -> Result<i32, Error> {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry < 0) { return Err(Error.create(194, "custom pipeline dynamic descriptor set is not bound")); }
        let idx = self.customPipelineIndex(pipeline_id);
        var slot = self.custom_pipelines.get(idx as i64);
        self.custom_dynamic_descriptor_update_generation = self.custom_dynamic_descriptor_update_generation + 1;
        slot.dynamic_descriptor_update_generations.set(entry as i64, self.custom_dynamic_descriptor_update_generation);
        slot.dynamic_descriptor_last_update_frames.set(entry as i64, self.custom_descriptor_frame_generation);
        self.custom_pipelines.set(idx as i64, slot);
        return Ok(self.custom_dynamic_descriptor_update_generation);
    }

    public fn clearCustomPipelineDynamicDescriptorSets(&mut self, pipeline_id: i32) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        return Ok(self.clearCustomPipelineDynamicDescriptorsAt(idx));
    }

    public fn customPipelineBindingPlan(&self, pipeline_id: i32) -> CustomPipelineBindingPlan {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return CustomPipelineBindingPlan.invalid(); }
        let slot = self.custom_pipelines.get(idx as i64);
        var sprite_count = 0;
        if (slot.use_sprite_descriptors) { sprite_count = 1; }
        return CustomPipelineBindingPlan {
            pipeline_id: pipeline_id,
            material_kind: slot.material_kind,
            vertex_layout_kind: slot.vertex_layout_kind,
            vertex_binding_count: slot.custom_vertex_binding_count,
            vertex_attribute_count: slot.custom_vertex_attribute_count,
            total_vertex_stride: self.customPipelineVertexInputTotalStride(pipeline_id),
            descriptor_set_count: self.customPipelineTotalDescriptorSetLayoutCount(pipeline_id),
            sprite_descriptor_set_count: sprite_count,
            static_descriptor_set_count: self.customPipelineStaticDescriptorSetCount(pipeline_id),
            dynamic_descriptor_set_count: self.customPipelineDynamicDescriptorSetCount(pipeline_id),
            bound_dynamic_descriptor_set_count: self.customPipelineBoundDynamicDescriptorSetCount(pipeline_id),
            missing_dynamic_descriptor_set_count: self.customPipelineMissingDynamicDescriptorSetCount(pipeline_id),
            push_constant_stage_flags: slot.push_constant_stage_flags,
            push_constant_size: slot.push_constant_size,
            owns_layout: slot.owns_layout,
            has_clip_variant: slot.has_clip_pipeline
        };
    }

    public fn customDescriptorPoolCapacity(&self) -> i32 {
        return self.custom_descriptor_pool_capacity;
    }

    public fn customDescriptorPoolAllocatedCount(&self) -> i32 {
        return self.custom_descriptor_pool_allocated_count;
    }

    public fn customDescriptorPoolGeneration(&self) -> i32 {
        return self.custom_descriptor_pool_generation;
    }

    public fn customDescriptorPoolRecreateCount(&self) -> i32 {
        return self.custom_descriptor_pool_recreate_count;
    }

    public fn customDynamicDescriptorBindingGeneration(&self) -> i32 {
        return self.custom_dynamic_descriptor_binding_generation;
    }

    public fn customDynamicDescriptorUpdateGeneration(&self) -> i32 {
        return self.custom_dynamic_descriptor_update_generation;
    }

    public fn customDynamicDescriptorInvalidationCount(&self) -> i32 {
        return self.custom_dynamic_descriptor_invalidation_count;
    }

    public fn customDynamicDescriptorClearedCount(&self) -> i32 {
        return self.custom_dynamic_descriptor_cleared_count;
    }

    public fn lastCustomDynamicDescriptorInvalidatedCount(&self) -> i32 {
        return self.last_custom_dynamic_descriptor_invalidated_count;
    }

    public fn customDescriptorFrameGeneration(&self) -> i32 {
        return self.custom_descriptor_frame_generation;
    }

    public fn customPipelineDynamicDescriptorPoolGeneration(&self, pipeline_id: i32, set_index: i32) -> i32 {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry < 0) { return -1; }
        let idx = self.customPipelineIndex(pipeline_id);
        return self.custom_pipelines.get(idx as i64).dynamic_descriptor_pool_generations.get(entry as i64);
    }

    public fn customPipelineDynamicDescriptorUpdateGeneration(&self, pipeline_id: i32, set_index: i32) -> i32 {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry < 0) { return -1; }
        let idx = self.customPipelineIndex(pipeline_id);
        return self.custom_pipelines.get(idx as i64).dynamic_descriptor_update_generations.get(entry as i64);
    }

    public fn customPipelineDynamicDescriptorLastUpdateFrame(&self, pipeline_id: i32, set_index: i32) -> i32 {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry < 0) { return -1; }
        let idx = self.customPipelineIndex(pipeline_id);
        return self.custom_pipelines.get(idx as i64).dynamic_descriptor_last_update_frames.get(entry as i64);
    }

    public fn customPipelineDynamicDescriptorSetIsStale(&self, pipeline_id: i32, set_index: i32) -> bool {
        let pool_generation = self.customPipelineDynamicDescriptorPoolGeneration(pipeline_id, set_index);
        return pool_generation >= 0 && pool_generation != self.custom_descriptor_pool_generation;
    }

    public fn customPipelineRegisteredDeviceGeneration(&self, pipeline_id: i32) -> i32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return -1; }
        return self.custom_pipelines.get(idx as i64).registered_device_generation;
    }

    public fn createCustomDescriptorSetLayout(&self, desc: DescriptorSetLayoutDesc) -> Result<DescriptorSetLayout, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        match (self.device.createDescriptorSetLayout(desc)) {
            case Ok(v) => { return Ok(v); }
            case Err(e) => { return Err(Error.create(199, e.message)); }
        }
    }

    public fn createEmptyCustomDescriptorSetLayout(&self) -> Result<DescriptorSetLayout, Error> {
        return self.createCustomDescriptorSetLayout(DescriptorSetLayoutDesc.empty());
    }

    public fn updateCustomPipelineDynamicDescriptorSet(&mut self, pipeline_id: i32, set_index: i32) -> Result<i32, Error> {
        let custom_index = self.customPipelineDescriptorSetCustomIndex(pipeline_id, set_index);
        let entry = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, custom_index);
        if (entry < 0) { return Err(Error.create(194, "custom pipeline dynamic descriptor set is not bound")); }
        let idx = self.customPipelineIndex(pipeline_id);
        var slot = self.custom_pipelines.get(idx as i64);
        var set = slot.dynamic_descriptor_sets.get(entry as i64);
        match (set.update()) {
            case Ok(_) => {}
            case Err(e) => { return Err(Error.create(200, e.message)); }
        }
        return self.markCustomPipelineDynamicDescriptorSetUpdated(pipeline_id, set_index);
    }

    public fn customPipelineOwnsLayout(&self, pipeline_id: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        return self.custom_pipelines.get(idx as i64).owns_layout;
    }

    public fn customPipelineOwnsClipLayout(&self, pipeline_id: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        return self.custom_pipelines.get(idx as i64).owns_clip_layout;
    }

    public fn customPipelineOwnsAnyLayout(&self, pipeline_id: i32) -> bool {
        return self.customPipelineOwnsLayout(pipeline_id) || self.customPipelineOwnsClipLayout(pipeline_id);
    }

    public fn customPipelinePushConstantSize(&self, pipeline_id: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        return self.custom_pipelines.get(idx as i64).push_constant_size;
    }

    public fn customPipelinePushConstantStageFlags(&self, pipeline_id: i32) -> u32 {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return 0 as u32; }
        return self.custom_pipelines.get(idx as i64).push_constant_stage_flags;
    }

    public fn customPipelinePushConstantFloatCount(&self, pipeline_id: i32) -> i32 {
        let size = self.customPipelinePushConstantSize(pipeline_id);
        if (size == (sizeof::<PipelinePushConstants1f>() as u32)) { return 1; }
        if (size == (sizeof::<PipelinePushConstants2f>() as u32)) { return 2; }
        if (size == (sizeof::<PipelinePushConstants3f>() as u32)) { return 3; }
        if (size == (sizeof::<PipelinePushConstants4f>() as u32)) { return 4; }
        return 0;
    }

    public fn customPipelineSupportsRenderGraphConstants(&self, pipeline_id: i32) -> bool {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return false; }
        return self.customPipelinePushConstantSize(pipeline_id) == 0 as u32 || self.customPipelinePushConstantFloatCount(pipeline_id) > 0;
    }

    public fn customPipelinePushConstantStageIncludesVertex(&self, pipeline_id: i32) -> bool {
        return (self.customPipelinePushConstantStageFlags(pipeline_id) & shader_stage_vertex()) != 0 as u32;
    }

    public fn customPipelinePushConstantStageIncludesFragment(&self, pipeline_id: i32) -> bool {
        return (self.customPipelinePushConstantStageFlags(pipeline_id) & shader_stage_fragment()) != 0 as u32;
    }

    private fn customPipelineFor(&mut self, pipeline_id: i32, clipped: bool) -> Result<GraphicsPipeline, Error> {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) {
            self.custom_pipeline_missing_count = self.custom_pipeline_missing_count + 1;
            self.last_custom_pipeline_error_code = 84;
            self.last_custom_pipeline_missing_id = pipeline_id;
            return Err(Error.create(84, "GPU CustomPipeline is not registered"));
        }
        let slot = self.custom_pipelines.get(idx as i64);
        if (clipped) {
            if (!slot.has_clip_pipeline) {
                self.custom_pipeline_clip_missing_count = self.custom_pipeline_clip_missing_count + 1;
                self.last_custom_pipeline_error_code = 152;
                self.last_custom_pipeline_missing_id = pipeline_id;
                return Err(Error.create(152, "GPU CustomPipeline clip variant is not registered"));
            }
            self.custom_pipeline_clip_bind_count = self.custom_pipeline_clip_bind_count + 1;
            self.custom_pipeline_bind_count = self.custom_pipeline_bind_count + 1;
            self.last_custom_pipeline_id = pipeline_id;
            self.last_custom_pipeline_error_code = 0;
            return Ok(slot.clip_pipeline.clone());
        }
        self.custom_pipeline_bind_count = self.custom_pipeline_bind_count + 1;
        self.last_custom_pipeline_id = pipeline_id;
        self.last_custom_pipeline_error_code = 0;
        return Ok(slot.pipeline.clone());
    }

    private fn bindCustomStaticDescriptorSets(&mut self, pipeline_id: i32, pipeline: GraphicsPipeline) -> Result<i32, Error> {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        let slot = self.custom_pipelines.get(idx as i64);
        var first_set: u32 = 0 as u32;
        if (slot.use_sprite_descriptors) { first_set = 1 as u32; }
        if (slot.static_descriptor_sets.len > 0) {
            var sets = Vec::<DescriptorSet>.new();
            var i: i64 = 0;
            while (i < slot.static_descriptor_sets.len) {
                sets.push(slot.static_descriptor_sets.get(i).clone());
                i = i + 1;
            }
            match (self.command.bindDescriptorSets(&pipeline, first_set, sets)) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(73, e.message)); }
            }
        }
        let static_count = slot.static_descriptor_sets.len as i32;
        var expected_custom_index = static_count;
        while (expected_custom_index < slot.custom_descriptor_set_layout_count) {
            let entry_index = self.customPipelineDynamicDescriptorEntryIndex(pipeline_id, expected_custom_index);
            if (entry_index < 0) {
                return Err(Error.create(194, "custom pipeline dynamic descriptor set is not bound"));
            }
            let pool_generation = slot.dynamic_descriptor_pool_generations.get(entry_index as i64);
            if (pool_generation >= 0 && pool_generation != self.custom_descriptor_pool_generation) {
                return Err(Error.create(195, "custom pipeline dynamic descriptor set was invalidated"));
            }
            expected_custom_index = expected_custom_index + 1;
        }
        var dynamic_i: i64 = 0;
        while (dynamic_i < slot.dynamic_descriptor_sets.len) {
            var dynamic_sets = Vec::<DescriptorSet>.new();
            dynamic_sets.push(slot.dynamic_descriptor_sets.get(dynamic_i).clone());
            let custom_index = slot.dynamic_descriptor_set_custom_indices.get(dynamic_i);
            match (self.command.bindDescriptorSets(&pipeline, (first_set as i32 + custom_index) as u32, dynamic_sets)) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(73, e.message)); }
            }
            dynamic_i = dynamic_i + 1;
        }
        return Ok(0);
    }

    private fn pushCustomPipelineConstants(&mut self, pipeline_id: i32, clipped: bool, constants: Color) -> Result<i32, Error> {
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx < 0) { return Err(Error.create(84, "GPU CustomPipeline is not registered")); }
        let slot = self.custom_pipelines.get(idx as i64);
        if (slot.push_constant_size == 0 as u32) { return Ok(0); }
        if (slot.push_constant_stage_flags == 0 as u32) {
            return Err(Error.create(178, "custom pipeline push constant stage flags are empty"));
        }
        var pipeline = slot.pipeline.clone();
        if (clipped && slot.has_clip_pipeline) {
            pipeline = slot.clip_pipeline.clone();
        }
        if (slot.push_constant_size == (sizeof::<PipelinePushConstants1f>() as u32)) {
            match (self.command.pushConstants(&pipeline, slot.push_constant_stage_flags, 0 as u32, PipelinePushConstants1f.create(constants.r))) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(179, e.message)); }
            }
        } else if (slot.push_constant_size == (sizeof::<PipelinePushConstants2f>() as u32)) {
            match (self.command.pushConstants(&pipeline, slot.push_constant_stage_flags, 0 as u32, PipelinePushConstants2f.create(constants.r, constants.g))) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(179, e.message)); }
            }
        } else if (slot.push_constant_size == (sizeof::<PipelinePushConstants3f>() as u32)) {
            match (self.command.pushConstants(&pipeline, slot.push_constant_stage_flags, 0 as u32, PipelinePushConstants3f.create(constants.r, constants.g, constants.b))) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(179, e.message)); }
            }
        } else if (slot.push_constant_size == (sizeof::<PipelinePushConstants4f>() as u32)) {
            match (self.command.pushConstants(&pipeline, slot.push_constant_stage_flags, 0 as u32, PipelinePushConstants4f.create(constants.r, constants.g, constants.b, constants.a))) {
                case Ok(_) => {}
                case Err(e) => { return Err(Error.create(179, e.message)); }
            }
        } else {
            return Err(Error.create(179, "custom pipeline push constant size is not supported by RenderGraph constants"));
        }
        self.last_frame_push_constant_count = self.last_frame_push_constant_count + 1;
        self.last_frame_push_constant_bytes = self.last_frame_push_constant_bytes + (slot.push_constant_size as u64);
        self.last_frame_push_constant_pipeline_id = pipeline_id;
        return Ok(0);
    }

    public fn registerCustomPipeline(&mut self, pipeline_id: i32, pipeline: GraphicsPipeline) -> Result<i32, Error> {
        if (!self.owns) { return Err(Error.create(85, "Renderer is destroyed")); }
        if (pipeline_id <= 0) { return Err(Error.create(137, "custom pipeline id must be positive")); }
        let idx = self.customPipelineIndex(pipeline_id);
        if (idx >= 0) {
            var old_slot = self.custom_pipelines.get(idx as i64);
            self.destroyCustomPipelineSlot(old_slot);
            self.custom_pipelines.set(idx as i64, CustomPipelineSlot.create(pipeline_id, pipeline.clone(), self.pipeline_layout.clone(), rendererCustomPipelineMaterialSolid(), self.device_generation));
            self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
            self.custom_pipeline_replace_count = self.custom_pipeline_replace_count + 1;
            self.last_custom_pipeline_registered_id = pipeline_id;
            return Ok(0);
        }
        self.custom_pipelines.push(CustomPipelineSlot.create(pipeline_id, pipeline.clone(), self.pipeline_layout.clone(), rendererCustomPipelineMaterialSolid(), self.device_generation));
        self.custom_pipeline_generation = self.custom_pipeline_generation + 1;
        self.custom_pipeline_register_count = self.custom_pipeline_register_count + 1;
        self.last_custom_pipeline_registered_id = pipeline_id;
        return Ok(0);
    }

