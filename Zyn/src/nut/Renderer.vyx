    public fn destroy(&mut self) {
        if (self.owns) {
            self.destroyCustomRenderResources();
            var custom_i: i64 = 0;
            while (custom_i < self.custom_render_slots.len) {
                var slot = self.custom_render_slots.get_ptr(custom_i);
                var handler = slot[0].handler.deref();
                handler.release();
                slot[0].handler.drop();
                custom_i = custom_i + 1;
            }
            self.custom_render_slots.destroy();
            self.custom_render_descriptor_pool.destroy();
            self.destroyClipStencilTarget();
            self.destroyLayerTargets();
            self.clearCustomPipelines();
            self.custom_pipelines.destroy();
            self.custom_descriptor_pool.destroy();
            self.clip_mask_vertex_buffer.destroy();
            self.frame_textured_vertex_buffer.destroy();
            self.frame_vertex_buffer.destroy();
            self.textured_clip_pipeline.destroy();
            self.solid_clip_pipeline.destroy();
            self.clip_mask_pipeline.destroy();
            self.textured_pipeline.destroy();
            self.solid_pipeline.destroy();
            self.textured_pipeline_layout.destroy();
            self.pipeline_layout.destroy();
            self.sprite_descriptor_set.destroy();
            self.sprite_descriptor_pool.destroy();
            self.sprite_set_layout.destroy();
            self.sprite_sampler.destroy();
            self.sprite_texture_view.destroy();
            self.sprite_texture.destroy();
            self.sprite_texture_upload.destroy();
            self.textured_fragment_shader.destroy();
            self.textured_vertex_shader.destroy();
            self.fragment_shader.destroy();
            self.vertex_shader.destroy();
            self.compiler.destroy();
            self.command.destroy();
            self.sync.destroy();
            self.swapchain.destroy();
            self.queue.destroy();
            self.device.destroy();
            self.surface.destroy();
            self.adapter.destroy();
            self.instance.destroy();
        }
        self.frame_vertex_capacity = 0;
        self.frame_textured_vertex_capacity = 0;
        self.clip_mask_vertex_capacity = 0;
        self.frame_vertex_realloc_count = 0;
        self.frame_textured_vertex_realloc_count = 0;
        self.clip_mask_vertex_realloc_count = 0;
        self.sprite_texture_width = 0 as u32;
        self.sprite_texture_height = 0 as u32;
        self.sprite_texture_layers = 0 as u32;
        self.layer_target_purge_count = 0;
        self.layer_target_trimmed_count = 0;
        self.layer_target_peak_count = 0;
        self.layer_target_peak_bytes = 0 as u64;
        self.layer_target_allocation_count = 0;
        self.layer_target_reuse_count = 0;
        self.layer_target_recreate_count = 0;
        self.clip_stencil_purge_count = 0;
        self.sprite_texture_upload_bytes = 0 as u64;
        self.sprite_texture_upload_capacity = 0 as u64;
        self.sprite_texture_upload_realloc_count = 0;
        self.sprite_texture_update_kind = 0;
        self.sprite_texture_update_page_count = 0;
        self.last_frame_vertices = 0;
        self.last_frame_textured_vertices = 0;
        self.last_frame_draw_commands = 0;
        self.last_frame_segments = 0;
        self.last_frame_uploaded_bytes = 0 as u64;
        self.last_frame_solid_uploaded_bytes = 0 as u64;
        self.last_frame_textured_uploaded_bytes = 0 as u64;
        self.last_frame_layer_target_count = 0;
        self.last_frame_layer_target_bytes = 0 as u64;
        self.last_frame_layer_cache_count = 0;
        self.last_frame_layer_cache_bytes = 0 as u64;
        self.last_frame_layer_target_allocated_count = 0;
        self.last_frame_layer_target_reused_count = 0;
        self.last_frame_layer_target_recreated_count = 0;
        self.last_frame_layer_pass_count = 0;
        self.last_frame_layer_composite_count = 0;
        self.last_frame_layer_composite_capacity_count = 0;
        self.last_frame_main_draw_count = 0;
        self.last_frame_layer_draw_count = 0;
        self.last_frame_clip_path_count = 0;
        self.last_frame_clip_path_bounds_fallback_count = 0;
        self.last_frame_clip_stencil_target_count = 0;
        self.last_frame_clip_stencil_target_bytes = 0 as u64;
        self.last_frame_clip_mask_vertices = 0;
        self.last_frame_clip_mask_uploaded_bytes = 0 as u64;
        self.last_frame_pipeline_switch_count = 0;
        self.last_frame_custom_pipeline_switch_count = 0;
        self.last_frame_last_pipeline_id = 0;
        self.last_frame_push_constant_count = 0;
        self.last_frame_push_constant_bytes = 0 as u64;
        self.last_frame_push_constant_pipeline_id = 0;
        self.last_frame_execution_plan_valid = false;
