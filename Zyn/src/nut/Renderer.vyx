                    if (current_segment_material == 0) {
                        segment_vertices = batch.vertexCount() - segment_start;
                    } else {
                        segment_vertices = textured_batch.vertexCount() - segment_start;
                    }
                    if (segment_vertices > 0) {
                        segments.push(BatchSegment.createWithPipelineConstants(segment_start, segment_vertices, current_segment_material, current_segment_target, current_segment_pipeline_id, current_push_constants, current_clip));
                    }
                    segment_open = false;
                    current_segment_material = -1;
                }
                if (command.kind.equals(RenderCommandKind.pushClipRect())) {
                    clip_stack.push(current_clip.clone());
                    clip_path_depth_stack.push(active_clip_paths.len as i32);
                    let clip_rect = quadBounds(transformRect(command.rect, current_transform));
                    if (current_clip.has_clip) {
                        current_clip = current_clip.intersectRect(clip_rect);
                    } else {
                        current_clip = ClipState.fromRect(clip_rect);
                    }
