module Zyn.Nut.Scene;

use Zyn.Nut.Types;
use Canvas = Zyn.Nut.Canvas.Canvas;
use RenderGraph = Zyn.Nut.RenderGraph.RenderGraph;
use Path = Zyn.Nut.Path.Path;
use Sprite = Zyn.Nut.Atlas.Sprite;
use FontFace = Zyn.Nut.Text.FontFace;
use FontStack = Zyn.Nut.Text.FontStack;
use GlyphCache = Zyn.Nut.Text.GlyphCache;
use TextBlock = Zyn.Nut.Text.TextBlock;
use TextLayout = Zyn.Nut.Text.TextLayout;
use TextLayoutOptions = Zyn.Nut.Text.TextLayoutOptions;
use std.collections;

public fn paintStyleFill() -> i32 { return 0; }
public fn paintStyleStroke() -> i32 { return 1; }

fn sceneStateSave() -> i32 { return 0; }
fn sceneStateTransform() -> i32 { return 1; }
fn sceneStateClip() -> i32 { return 2; }
fn sceneStateLayer() -> i32 { return 3; }

public class Paint {
    public color: Color;
    public style: i32;
    public stroke_width: f32;
    public round_stroke: bool;
    public dashed_stroke: bool;
    public dash: f32;
    public gap: f32;
    public phase: f32;
    public has_gradient: bool;
    public gradient: LinearGradient;

    @[borrow_args]
    public static fn fill(color: Color) -> Paint {
        return Paint {
            color: color.clone(),
            style: paintStyleFill(),
            stroke_width: 1.0 as f32,
            round_stroke: false,
            dashed_stroke: false,
            dash: 0.0 as f32,
            gap: 0.0 as f32,
            phase: 0.0 as f32,
            has_gradient: false,
            gradient: LinearGradient.horizontal(color.clone(), color.clone())
        };
    }

    public static fn stroke(color: Color, width: f32) -> Paint {
        return Paint.fill(color).asStroke(width);
    }

    public static fn strokeRound(color: Color, width: f32) -> Paint {
        return Paint.stroke(color, width).round();
    }

    public static fn dashedStroke(color: Color, width: f32, dash: f32, gap: f32, phase: f32) -> Paint {
        return Paint.stroke(color, width).dashed(dash, gap, phase);
    }

    public static fn fillGradient(gradient: LinearGradient) -> Paint {
        return Paint {
            color: gradient.start.clone(),
            style: paintStyleFill(),
            stroke_width: 1.0 as f32,
            round_stroke: false,
            dashed_stroke: false,
            dash: 0.0 as f32,
            gap: 0.0 as f32,
            phase: 0.0 as f32,
            has_gradient: true,
            gradient: gradient.clone()
        };
    }

    public fn clone(&self) -> Paint {
        return Paint {
            color: self.color.clone(),
            style: self.style,
            stroke_width: self.stroke_width,
            round_stroke: self.round_stroke,
            dashed_stroke: self.dashed_stroke,
            dash: self.dash,
            gap: self.gap,
            phase: self.phase,
            has_gradient: self.has_gradient,
            gradient: self.gradient.clone()
        };
    }

    public fn withColor(mut self, color: Color) -> Paint {
        self.color = color.clone();
        return self;
    }

    public fn withAlpha(mut self, alpha: f32) -> Paint {
        self.color = self.color.withAlphaMultiplier(alpha);
        self.gradient = LinearGradient.create(self.gradient.start.withAlphaMultiplier(alpha), self.gradient.end.withAlphaMultiplier(alpha), self.gradient.vertical);
        return self;
    }

    public fn asFill(mut self) -> Paint {
        self.style = paintStyleFill();
        return self;
    }

    public fn asStroke(mut self, width: f32) -> Paint {
        self.style = paintStyleStroke();
        self.stroke_width = width;
        return self;
    }

    public fn round(mut self) -> Paint {
        self.round_stroke = true;
        return self;
    }

    public fn dashed(mut self, dash: f32, gap: f32, phase: f32) -> Paint {
        self.dashed_stroke = true;
        self.dash = dash;
        self.gap = gap;
        self.phase = phase;
        return self;
    }

    public fn isFill(&self) -> bool {
        return self.style == paintStyleFill();
    }

    public fn isStroke(&self) -> bool {
        return self.style == paintStyleStroke();
    }
}

public class PathBuilder {
    private path: Path;
    private closed: bool;

    public static fn create() -> PathBuilder {
        return PathBuilder { path: Path.create(), closed: false };
    }

    public static fn rect(rect: Rectangle) -> PathBuilder {
        return PathBuilder { path: Path.rect(rect), closed: true };
    }

    public static fn roundedRect(rect: Rectangle, radius: f32, segments_per_corner: i32) -> PathBuilder {
        return PathBuilder { path: Path.roundedRect(rect, radius, segments_per_corner), closed: true };
    }

    public static fn circle(center: Point, radius: f32, segments: i32) -> PathBuilder {
        return PathBuilder { path: Path.circle(center, radius, segments), closed: true };
    }

    public fn moveTo(mut self, point: Point) -> PathBuilder {
        self.path = self.path.moveTo(point);
        self.closed = false;
        return self;
    }

    public fn lineTo(mut self, point: Point) -> PathBuilder {
        self.path = self.path.lineTo(point);
        return self;
    }

    public fn quadraticTo(mut self, control: Point, end: Point, segments: i32) -> PathBuilder {
        self.path = self.path.quadraticTo(control, end, segments);
        return self;
    }

    public fn cubicTo(mut self, control0: Point, control1: Point, end: Point, segments: i32) -> PathBuilder {
        self.path = self.path.cubicTo(control0, control1, end, segments);
        return self;
    }

    public fn close(mut self) -> PathBuilder {
        self.closed = true;
        return self;
    }

    public fn pointCount(&self) -> i32 {
        return self.path.pointCount();
    }

    public fn build(&self) -> Path {
        var out = self.path.clone();
        if (self.closed) { out = out.close(); }
        return out;
    }

    public fn destroy(&mut self) {
        self.path.destroy();
        self.closed = false;
    }
}

public class SceneBuilder {
    private canvas: Canvas;
    private state_stack: Vec<i32>;

    public static fn create() -> SceneBuilder {
        return SceneBuilder { canvas: Canvas.create(), state_stack: Vec::<i32>.new() };
    }

    public fn clear(mut self, color: Color) -> SceneBuilder {
        self.canvas = self.canvas.clear(color);
        return self;
    }

    public fn save(mut self) -> SceneBuilder {
        self.state_stack.push(sceneStateSave());
        return self;
    }

    public fn transform(mut self, transform: Transform2D) -> SceneBuilder {
        self.canvas = self.canvas.pushTransform(transform);
        self.state_stack.push(sceneStateTransform());
        return self;
    }

    public fn translate(mut self, x: f32, y: f32) -> SceneBuilder {
        return self.transform(Transform2D.translation(x, y));
    }

    public fn scale(mut self, x: f32, y: f32) -> SceneBuilder {
        return self.transform(Transform2D.scale(x, y));
    }

    public fn rotate(mut self, radians: f32) -> SceneBuilder {
        return self.transform(Transform2D.rotation(radians));
    }

    public fn clipRect(mut self, rect: Rectangle) -> SceneBuilder {
        self.canvas = self.canvas.pushClipRect(rect);
        self.state_stack.push(sceneStateClip());
        return self;
    }

    public fn clipPath(mut self, path: &Path) -> SceneBuilder {
        self.canvas = self.canvas.pushClipPath(path);
        self.state_stack.push(sceneStateClip());
        return self;
    }

    public fn layer(mut self, alpha: f32) -> SceneBuilder {
        self.canvas = self.canvas.pushLayer(alpha);
        self.state_stack.push(sceneStateLayer());
        return self;
    }

    public fn restore(mut self) -> SceneBuilder {
        var restored = false;
        while (!self.state_stack.isEmpty() && !restored) {
            let kind = self.state_stack.pop();
            if (kind == sceneStateSave()) {
                restored = true;
            } else if (kind == sceneStateTransform()) {
                self.canvas = self.canvas.popTransform();
            } else if (kind == sceneStateClip()) {
                self.canvas = self.canvas.popClip();
            } else if (kind == sceneStateLayer()) {
                self.canvas = self.canvas.popLayer();
            }
        }
        return self;
    }

    public fn restoreAll(mut self) -> SceneBuilder {
        while (!self.state_stack.isEmpty()) {
            let kind = self.state_stack.pop();
            if (kind == sceneStateTransform()) {
                self.canvas = self.canvas.popTransform();
            } else if (kind == sceneStateClip()) {
                self.canvas = self.canvas.popClip();
            } else if (kind == sceneStateLayer()) {
                self.canvas = self.canvas.popLayer();
            }
        }
        return self;
    }

    @[borrow_args]
    public fn drawRect(mut self, rect: Rectangle, paint: Paint) -> SceneBuilder {
        if (paint.isStroke()) {
            self.canvas = self.canvas.strokeRect(rect, paint.stroke_width, paint.color);
        } else if (paint.has_gradient) {
            self.canvas = self.canvas.fillGradientRect(rect, paint.gradient);
        } else {
            self.canvas = self.canvas.fillRect(rect, paint.color);
        }
        return self;
    }

    // Draw a soft drop shadow before a surface.  Keeping this on SceneBuilder
    // makes elevation composable: a View can opt in without reaching through
    // the UI layer into Canvas or the backend renderer.
    public fn drawShadowRect(mut self, rect: Rectangle, offset_x: f32, offset_y: f32, blur: f32, color: Color) -> SceneBuilder {
        self.canvas = self.canvas.drawShadowRect(rect, offset_x, offset_y, blur, color);
        return self;
    }

    public fn drawShadowPath(mut self, path: &Path, offset_x: f32, offset_y: f32, spread: f32, color: Color) -> SceneBuilder {
        self.canvas = self.canvas.drawShadowPath(path, offset_x, offset_y, spread, color);
        return self;
    }

    public fn drawCircle(mut self, circle: Circle, paint: Paint) -> SceneBuilder {
        if (paint.isStroke()) {
            var path = Path.circle(Point.xy(circle.x, circle.y), circle.radius, 32);
            self = self.drawPath(&path, paint);
            path.destroy();
        } else {
            self.canvas = self.canvas.fillCircle(circle, paint.color);
        }
        return self;
    }

    private fn pathSignedArea(&self, path: &Path) -> f32 {
        var area: f64 = 0.0;
        var i: i32 = 0;
        while (i < path.pointCount()) {
            let a = path.pointAt(i);
            var next = i + 1;
            if (next >= path.pointCount()) { next = 0; }
            let b = path.pointAt(next);
            area = area + (((a.x as f64) * (b.y as f64)) - ((b.x as f64) * (a.y as f64)));
            i = i + 1;
        }
        return (area / 2.0) as f32;
    }

    private fn pathCross(&self, a: Point, b: Point, c: Point) -> f32 {
        return ((b.x - a.x) * (c.y - a.y)) - ((b.y - a.y) * (c.x - a.x));
    }

    private fn pointInTriangle(&self, point: Point, a: Point, b: Point, c: Point, ccw: bool) -> bool {
        let ab = self.pathCross(a, b, point);
        let bc = self.pathCross(b, c, point);
        let ca = self.pathCross(c, a, point);
        if (ccw) {
            return ab > (0.0 as f32) && bc > (0.0 as f32) && ca > (0.0 as f32);
        }
        return ab < (0.0 as f32) && bc < (0.0 as f32) && ca < (0.0 as f32);
    }

    private fn fillPath(mut self, path: &Path, color: Color) -> SceneBuilder {
        if (!path.isFillable()) { return self; }
        let area = self.pathSignedArea(path);
        if (area == (0.0 as f32)) { return self; }
        let ccw = area > (0.0 as f32);
        var indices = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < path.pointCount()) {
            indices.push(i);
            i = i + 1;
        }

        var guard: i32 = 0;
        let guard_limit = path.pointCount() * path.pointCount();
        while ((indices.len as i32) > 3 && guard < guard_limit) {
            var ear_index: i32 = -1;
            var j: i32 = 0;
            while (j < (indices.len as i32) && ear_index < 0) {
                let count = indices.len as i32;
                var prev_index = j - 1;
                if (prev_index < 0) { prev_index = count - 1; }
                var next_index = j + 1;
                if (next_index >= count) { next_index = 0; }

                let prev = indices.get(prev_index as i64);
                let current = indices.get(j as i64);
                let next = indices.get(next_index as i64);
                let a = path.pointAt(prev);
                let b = path.pointAt(current);
                let c = path.pointAt(next);
                let turn = self.pathCross(a, b, c);
                var convex = false;
                if (ccw) {
                    convex = turn > (0.0 as f32);
                } else {
                    convex = turn < (0.0 as f32);
                }

                if (convex) {
                    var contains_point = false;
                    var k: i32 = 0;
                    while (k < count && !contains_point) {
                        let candidate = indices.get(k as i64);
                        if (candidate != prev && candidate != current && candidate != next) {
                            if (self.pointInTriangle(path.pointAt(candidate), a, b, c, ccw)) {
                                contains_point = true;
                            }
                        }
                        k = k + 1;
                    }
                    if (!contains_point) {
                        ear_index = j;
                    }
                }
                j = j + 1;
            }
            if (ear_index < 0) {
                indices.destroy();
                return self;
            }

            let count = indices.len as i32;
            var prev_index = ear_index - 1;
            if (prev_index < 0) { prev_index = count - 1; }
            var next_index = ear_index + 1;
            if (next_index >= count) { next_index = 0; }
            self.canvas = self.canvas.fillTriangle(Triangle.create(
                path.pointAt(indices.get(prev_index as i64)).clone(),
                path.pointAt(indices.get(ear_index as i64)).clone(),
                path.pointAt(indices.get(next_index as i64)).clone()
            ), color);
            indices.removeAt(ear_index as i64);
            guard = guard + 1;
        }

        if ((indices.len as i32) == 3) {
            self.canvas = self.canvas.fillTriangle(Triangle.create(
                path.pointAt(indices.get(0)).clone(),
                path.pointAt(indices.get(1)).clone(),
                path.pointAt(indices.get(2)).clone()
            ), color);
        }
        indices.destroy();
        return self;
    }

    public fn drawPath(mut self, path: &Path, paint: Paint) -> SceneBuilder {
        if (paint.isStroke()) {
            if (paint.dashed_stroke) {
                self.canvas = self.canvas.strokePathDashed(path, paint.stroke_width, paint.color, paint.dash, paint.gap, paint.phase);
            } else if (paint.round_stroke) {
                self.canvas = self.canvas.strokePathRound(path, paint.stroke_width, paint.color);
            } else {
                self.canvas = self.canvas.strokePath(path, paint.stroke_width, paint.color);
            }
        } else {
            self = self.fillPath(path, paint.color);
        }
        return self;
    }

    public fn drawLine(mut self, from: Point, to: Point, paint: Paint) -> SceneBuilder {
        var width = paint.stroke_width;
        if (width <= (0.0 as f32)) { width = 1.0 as f32; }
        if (paint.dashed_stroke) {
            self.canvas = self.canvas.drawLineDashed(from, to, width, paint.color, paint.dash, paint.gap, paint.phase);
        } else if (paint.round_stroke) {
            self.canvas = self.canvas.drawLineRound(from, to, width, paint.color);
        } else {
            self.canvas = self.canvas.drawLine(from, to, width, paint.color);
        }
        return self;
    }

    public fn drawSprite(mut self, sprite: Sprite) -> SceneBuilder {
        self.canvas = self.canvas.drawSprite(sprite);
        return self;
    }

    public fn drawExternal(mut self, rect: Rectangle, slot_id: i32) -> SceneBuilder {
        self.canvas = self.canvas.drawExternal(rect, slot_id);
        return self;
    }

    public fn drawText(mut self, font: &FontFace, cache: &mut GlyphCache, text: string, x: f32, baseline_y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawText(font, cache, text, x, baseline_y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn drawTextWithStack(mut self, fonts: &FontStack, cache: &mut GlyphCache, text: string, x: f32, baseline_y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawTextWithStack(fonts, cache, text, x, baseline_y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn drawTextLayout(mut self, cache: &GlyphCache, layout: &TextLayout, x: f32, baseline_y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawTextLayout(cache, layout, x, baseline_y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn drawTextBlock(mut self, cache: &GlyphCache, block: &TextBlock, x: f32, y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawTextBlock(cache, block, x, y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn drawTextBox(mut self, font: &FontFace, cache: &mut GlyphCache, text: string, options: TextLayoutOptions, x: f32, y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawTextBox(font, cache, text, options, x, y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn drawTextBoxWithStack(mut self, fonts: &FontStack, cache: &mut GlyphCache, text: string, options: TextLayoutOptions, x: f32, y: f32, paint: Paint) -> Result<SceneBuilder, Error> {
        var canvas: Canvas;
        match (self.canvas.drawTextBoxWithStack(fonts, cache, text, options, x, y, paint.color)) {
            case Ok(v) => { canvas = v; }
            case Err(e) => { return Err(e); }
        }
        self.canvas = canvas;
        return Ok(self);
    }

    public fn usePipeline(mut self, pipeline_id: i32) -> SceneBuilder {
        self.canvas = self.canvas.usePipeline(pipeline_id);
        return self;
    }

    public fn usePipelineConstants4f(mut self, pipeline_id: i32, x: f32, y: f32, z: f32, w: f32) -> SceneBuilder {
        self.canvas = self.canvas.usePipelineConstants4f(pipeline_id, x, y, z, w);
        return self;
    }

    public fn stateDepth(&self) -> i32 {
        return self.state_stack.len as i32;
    }

    public fn commandCount(&self) -> i32 {
        return self.canvas.commandCount();
    }

    public fn drawCommandCount(&self) -> i32 {
        return self.canvas.drawCommandCount();
    }

    public fn buildGraph(&self) -> RenderGraph {
        return self.canvas.build();
    }

    public fn reset(mut self) -> SceneBuilder {
        self.canvas = self.canvas.reset();
        self.state_stack.destroy();
        self.state_stack = Vec::<i32>.new();
        return self;
    }

    public fn destroy(&mut self) {
        self.canvas.destroy();
        self.state_stack.destroy();
    }
}
