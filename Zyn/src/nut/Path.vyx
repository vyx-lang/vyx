module Zyn.Nut.Path;

use Zyn.Nut.Types;
use std.collections;

extern "C" {
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn sqrt(x: f64) -> f64;
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn pathLoadF32(src: rawptr) -> f32 {
    var out: f32 = 0.0;
    memcpy(to_rawptr(&out), src, sizeof::<f32>() as i64);
    return out;
}

fn pathPointXY(p: Point) -> Point {
    var x: f32 = 0.0;
    var y: f32 = 0.0;
    let base = to_rawptr(&p);
    memcpy(to_rawptr(&x), base, sizeof::<f32>() as i64);
    memcpy(to_rawptr(&y), base + 4, sizeof::<f32>() as i64);
    return Point.xy(x, y);
}

fn pathQuadraticToOwned(p: Path, control: Point, end: Point, segments: i32) -> Path {
    let closed = p.closed;
    var pts = p.points;
    let n = pts.len;
    if (n <= 0) {
        var empty = Path { points: pts, closed: false };
        return empty.moveTo(end);
    }
    var start: Point;
    memcpy(to_rawptr(&start), pts.data + ((n - (1 as i64)) * sizeof::<Point>()), sizeof::<Point>() as i64);
    start = pathPointXY(start);
    let ctl = pathPointXY(control);
    let ep = pathPointXY(end);
    var count = segments;
    if (count < 1) { count = 1; }
    var i: i32 = 1;
    while (i <= count) {
        let t = (i as f32) / (count as f32);
        let mt = (1.0 as f32) - t;
        let x = (mt * mt * start.x) + ((2.0 as f32) * mt * t * ctl.x) + (t * t * ep.x);
        let y = (mt * mt * start.y) + ((2.0 as f32) * mt * t * ctl.y) + (t * t * ep.y);
        pts.push(Point.xy(x, y));
        i = i + 1;
    }
    return Path { points: pts, closed: closed };
}

fn pathCubicToOwned(p: Path, control0: Point, control1: Point, end: Point, segments: i32) -> Path {
    let closed = p.closed;
    var pts = p.points;
    let n = pts.len;
    if (n <= 0) {
        var empty = Path { points: pts, closed: false };
        return empty.moveTo(end);
    }
    var start: Point;
    memcpy(to_rawptr(&start), pts.data + ((n - (1 as i64)) * sizeof::<Point>()), sizeof::<Point>() as i64);
    start = pathPointXY(start);
    let c0 = pathPointXY(control0);
    let c1 = pathPointXY(control1);
    let ep = pathPointXY(end);
    var count = segments;
    if (count < 1) { count = 1; }
    var i: i32 = 1;
    while (i <= count) {
        let t = (i as f32) / (count as f32);
        let mt = (1.0 as f32) - t;
        let x = (mt * mt * mt * start.x)
            + ((3.0 as f32) * mt * mt * t * c0.x)
            + ((3.0 as f32) * mt * t * t * c1.x)
            + (t * t * t * ep.x);
        let y = (mt * mt * mt * start.y)
            + ((3.0 as f32) * mt * mt * t * c0.y)
            + ((3.0 as f32) * mt * t * t * c1.y)
            + (t * t * t * ep.y);
        pts.push(Point.xy(x, y));
        i = i + 1;
    }
    return Path { points: pts, closed: closed };
}

fn pathPi() -> f64 {
    return 3.14159265358979323846;
}

public class Path {
    public points: Vec<Point>;
    public closed: bool;

    public static fn create() -> Path {
        return Path { points: Vec::<Point>.new(), closed: false };
    }

    @[borrow_args]
    public static fn polygon(points: Vec<Point>) -> Path {
        var out = Path.create();
        var i: i32 = 0;
        while (i < (points.len as i32)) {
            let point = points.get(i as i64);
            if (i == 0) {
                out = out.moveTo(point);
            } else {
                out = out.lineTo(point);
            }
            i = i + 1;
        }
        return out.close();
    }

    public static fn rect(rect: Rectangle) -> Path {
        return Path.create()
            .moveTo(Point.xy(rect.x, rect.y))
            .lineTo(Point.xy(rect.right(), rect.y))
            .lineTo(Point.xy(rect.right(), rect.bottom()))
            .lineTo(Point.xy(rect.x, rect.bottom()))
            .close();
    }

    public static fn circle(center: Point, radius: f32, segments: i32) -> Path {
        var out = Path.create();
        if (radius <= (0.0 as f32)) { return out; }
        var count = segments;
        if (count < 8) { count = 8; }
        let step = (pathPi() * 2.0) / (count as f64);
        var i: i32 = 0;
        while (i < count) {
            let angle = (i as f64) * step;
            let point = Point.xy(
                center.x + ((cos(angle) as f32) * radius),
                center.y + ((sin(angle) as f32) * radius)
            );
            if (i == 0) {
                out = out.moveTo(point);
            } else {
                out = out.lineTo(point);
            }
            i = i + 1;
        }
        return out.close();
    }

    public static fn roundedRect(rect: Rectangle, radius: f32, segments_per_corner: i32) -> Path {
        var out = Path.create();
        if (!rect.isDrawable()) { return out; }
        var r = radius;
        if (r < (0.0 as f32)) { r = 0.0 as f32; }
        let half_width = rect.width / (2.0 as f32);
        let half_height = rect.height / (2.0 as f32);
        if (r > half_width) { r = half_width; }
        if (r > half_height) { r = half_height; }
        if (r <= (0.0 as f32)) { return Path.rect(rect); }

        var steps = segments_per_corner;
        if (steps < 2) { steps = 2; }
        let x0 = rect.x;
        let y0 = rect.y;
        let x1 = rect.right();
        let y1 = rect.bottom();
        let c0 = Point.xy(x1 - r, y0 + r);
        let c1 = Point.xy(x1 - r, y1 - r);
        let c2 = Point.xy(x0 + r, y1 - r);
        let c3 = Point.xy(x0 + r, y0 + r);
        out = out.moveTo(Point.xy(x0 + r, y0));
        out = out.lineTo(Point.xy(x1 - r, y0));
        out = out.arcPoints(c0, r, -90.0, 0.0, steps);
        out = out.lineTo(Point.xy(x1, y1 - r));
        out = out.arcPoints(c1, r, 0.0, 90.0, steps);
        out = out.lineTo(Point.xy(x0 + r, y1));
        out = out.arcPoints(c2, r, 90.0, 180.0, steps);
        out = out.lineTo(Point.xy(x0, y0 + r));
        out = out.arcPoints(c3, r, 180.0, 270.0, steps);
        return out.close();
    }

    public fn moveTo(mut self, point: Point) -> Path {
        self.points.destroy();
        self.points = Vec::<Point>.new();
        self.points.push(point);
        self.closed = false;
        return self;
    }

    public fn lineTo(mut self, point: Point) -> Path {
        self.points.push(point);
        return self;
    }

    public fn close(mut self) -> Path {
        self.closed = true;
        return self;
    }

    public fn lastPoint(&self) -> Point {
        let n = self.points.len;
        if (n <= 0) { return Point.xy(0.0, 0.0); }
        var out: Point;
        memcpy(to_rawptr(&out), self.points.data + ((n - (1 as i64)) * sizeof::<Point>()), sizeof::<Point>() as i64);
        return pathPointXY(out);
    }

    public fn quadraticTo(mut self, control: Point, end: Point, segments: i32) -> Path {
        return pathQuadraticToOwned(self, control, end, segments);
    }

    public fn cubicTo(mut self, control0: Point, control1: Point, end: Point, segments: i32) -> Path {
        return pathCubicToOwned(self, control0, control1, end, segments);
    }

    public fn arcPoints(mut self, center: Point, radius: f32, start_degrees: f32, end_degrees: f32, segments: i32) -> Path {
        var count = segments;
        if (count < 1) { count = 1; }
        let start = (start_degrees as f64) * pathPi() / 180.0;
        let end = (end_degrees as f64) * pathPi() / 180.0;
        let step = (end - start) / (count as f64);
        var i: i32 = 1;
        while (i <= count) {
            let angle = start + ((i as f64) * step);
            self.points.push(Point.xy(
                center.x + ((cos(angle) as f32) * radius),
                center.y + ((sin(angle) as f32) * radius)
            ));
            i = i + 1;
        }
        return self;
    }

    public fn pointCount(&self) -> i32 {
        var n: i64 = 0;
        memcpy(to_rawptr(&n), to_rawptr(self) + 8, 8);
        return n as i32;
    }

    public fn isClosed(&self) -> bool {
        return self.closed;
    }

    public fn pointAt(&self, index: i32) -> Point {
        return self.points.get(index as i64);
    }

    public fn isFillable(&self) -> bool {
        return self.closed && self.pointCount() >= 3;
    }

    public fn isStrokeable(&self) -> bool {
        return self.pointCount() >= 2;
    }

    public fn estimatedFillVertices(&self) -> i32 {
        if (!self.isFillable()) { return 0; }
        return (self.pointCount() - 2) * 3;
    }

    public fn estimatedStrokeVertices(&self) -> i32 {
        if (!self.isStrokeable()) { return 0; }
        var segments = self.pointCount() - 1;
        if (self.closed) { segments = segments + 1; }
        return segments * 6;
    }

    private fn segmentLength(&self, a: Point, b: Point) -> f32 {
        let dx = b.x - a.x;
        let dy = b.y - a.y;
        return sqrt(((dx as f64) * (dx as f64)) + ((dy as f64) * (dy as f64))) as f32;
    }

    private fn pointDistance(&self, a: Point, b: Point) -> f32 {
        return self.segmentLength(a, b);
    }

    private fn cross(&self, a: Point, b: Point, c: Point) -> f32 {
        return ((b.x - a.x) * (c.y - a.y)) - ((b.y - a.y) * (c.x - a.x));
    }

    private fn isCollinear(&self, a: Point, b: Point, c: Point, epsilon: f32) -> bool {
        var limit: f32 = epsilon;
        if (limit < (0.0 as f32)) { limit = (0.0 as f32) - limit; }
        let value = self.cross(a, b, c);
        if (value < (0.0 as f32)) { return ((0.0 as f32) - value) <= limit; }
        return value <= limit;
    }

    public fn signedArea(&self) -> f32 {
        if (!self.isFillable()) { return 0.0 as f32; }
        var area: f32 = 0.0 as f32;
        var i: i32 = 0;
        while (i < self.pointCount()) {
            let a = self.pointAt(i);
            var next = i + 1;
            if (next >= self.pointCount()) { next = 0; }
            let b = self.pointAt(next);
            let term: f32 = (a.x * b.y) - (b.x * a.y);
            area = area + term;
            i = i + 1;
        }
        return area / (2.0 as f32);
    }

    public fn area(&self) -> f32 {
        let value = self.signedArea();
        if (value < (0.0 as f32)) { return (0.0 as f32) - value; }
        return value;
    }

    public fn winding(&self) -> i32 {
        let value = self.signedArea();
        if (value > (0.0 as f32)) { return 1; }
        if (value < (0.0 as f32)) { return -1; }
        return 0;
    }

    public fn length(&self) -> f32 {
        if (!self.isStrokeable()) { return 0.0 as f32; }
        var out: f32 = 0.0 as f32;
        var i: i32 = 0;
        while (i + 1 < self.pointCount()) {
            out = out + self.segmentLength(self.pointAt(i), self.pointAt(i + 1));
            i = i + 1;
        }
        if (self.closed) {
            out = out + self.segmentLength(self.pointAt(self.pointCount() - 1), self.pointAt(0));
        }
        return out;
    }

    public fn pointAtDistance(&self, distance: f32) -> Point {
        if (self.pointCount() == 0) { return Point.xy(0.0, 0.0); }
        if (self.pointCount() == 1) { return self.pointAt(0); }
        var target: f32 = distance;
        if (target <= (0.0 as f32)) { return self.pointAt(0); }
        let total = self.length();
        if (target >= total) {
            if (self.closed) { return self.pointAt(0); }
            return self.pointAt(self.pointCount() - 1);
        }
        var consumed: f32 = 0.0 as f32;
        var i: i32 = 0;
        while (i + 1 < self.pointCount()) {
            let a = self.pointAt(i);
            let b = self.pointAt(i + 1);
            let segment = self.segmentLength(a, b);
            if ((consumed + segment) >= target && segment > (0.0 as f32)) {
                let t: f32 = (target - consumed) / segment;
                return Point.xy(a.x + ((b.x - a.x) * t), a.y + ((b.y - a.y) * t));
            }
            consumed = consumed + segment;
            i = i + 1;
        }
        if (self.closed) {
            let a = self.pointAt(self.pointCount() - 1);
            let b = self.pointAt(0);
            let segment = self.segmentLength(a, b);
            if (segment > (0.0 as f32)) {
                let t: f32 = (target - consumed) / segment;
                return Point.xy(a.x + ((b.x - a.x) * t), a.y + ((b.y - a.y) * t));
            }
        }
        return self.pointAt(self.pointCount() - 1);
    }

    private fn pointOnSegment(&self, point: Point, a: Point, b: Point) -> bool {
        let pa = pathPointXY(point);
        let aa = pathPointXY(a);
        let bb = pathPointXY(b);
        var pax: f32 = 0.0;
        var pay: f32 = 0.0;
        var aax: f32 = 0.0;
        var aay: f32 = 0.0;
        var bbx: f32 = 0.0;
        var bby: f32 = 0.0;
        memcpy(to_rawptr(&pax), to_rawptr(&pa), 4);
        memcpy(to_rawptr(&pay), to_rawptr(&pa) + 4, 4);
        memcpy(to_rawptr(&aax), to_rawptr(&aa), 4);
        memcpy(to_rawptr(&aay), to_rawptr(&aa) + 4, 4);
        memcpy(to_rawptr(&bbx), to_rawptr(&bb), 4);
        memcpy(to_rawptr(&bby), to_rawptr(&bb) + 4, 4);
        let cross = ((bbx - aax) * (pay - aay)) - ((bby - aay) * (pax - aax));
        if (cross != (0.0 as f32)) { return false; }
        var min_x = aax;
        if (bbx < min_x) { min_x = bbx; }
        var max_x = aax;
        if (bbx > max_x) { max_x = bbx; }
        var min_y = aay;
        if (bby < min_y) { min_y = bby; }
        var max_y = aay;
        if (bby > max_y) { max_y = bby; }
        return pax >= min_x && pax <= max_x && pay >= min_y && pay <= max_y;
    }

    public fn containsPoint(&self, point: Point) -> bool {
        if (!self.isFillable()) { return false; }
        if (!self.bounds().contains(point)) { return false; }
        var inside = false;
        var j = self.pointCount() - 1;
        var i: i32 = 0;
        let pp = pathPointXY(point);
        var ptx: f32 = 0.0;
        var pty: f32 = 0.0;
        memcpy(to_rawptr(&ptx), to_rawptr(&pp), 4);
        memcpy(to_rawptr(&pty), to_rawptr(&pp) + 4, 4);
        while (i < self.pointCount()) {
            let pi = pathPointXY(self.pointAt(i));
            let pj = pathPointXY(self.pointAt(j));
            var pix: f32 = 0.0;
            var piy: f32 = 0.0;
            var pjx: f32 = 0.0;
            var pjy: f32 = 0.0;
            memcpy(to_rawptr(&pix), to_rawptr(&pi), 4);
            memcpy(to_rawptr(&piy), to_rawptr(&pi) + 4, 4);
            memcpy(to_rawptr(&pjx), to_rawptr(&pj), 4);
            memcpy(to_rawptr(&pjy), to_rawptr(&pj) + 4, 4);
            if (self.pointOnSegment(point, pj, pi)) { return true; }
            if ((piy > pty) != (pjy > pty)) {
                let hit_x: f32 = ((pjx - pix) * (pty - piy) / (pjy - piy)) + pix;
                if (ptx < hit_x) { inside = !inside; }
            }
            j = i;
            i = i + 1;
        }
        return inside;
    }

    public fn bounds(&self) -> Rectangle {
        if (self.pointCount() == 0) { return Rectangle.xywh(0.0, 0.0, 0.0, 0.0); }
        var min_x = self.pointAt(0).x;
        var min_y = self.pointAt(0).y;
        var max_x = min_x;
        var max_y = min_y;
        var i: i32 = 1;
        while (i < self.pointCount()) {
            let point = self.pointAt(i);
            if (point.x < min_x) { min_x = point.x; }
            if (point.y < min_y) { min_y = point.y; }
            if (point.x > max_x) { max_x = point.x; }
            if (point.y > max_y) { max_y = point.y; }
            i = i + 1;
        }
        return Rectangle.xywh(min_x, min_y, max_x - min_x, max_y - min_y);
    }

    public fn transform(&self, transform: Transform2D) -> Path {
        var out = Path.create();
        var i: i32 = 0;
        while (i < self.pointCount()) {
            let point = transform.transformPoint(self.pointAt(i));
            if (i == 0) {
                out = out.moveTo(point);
            } else {
                out = out.lineTo(point);
            }
            i = i + 1;
        }
        if (self.closed) { out = out.close(); }
        return out;
    }

    public fn reversed(&self) -> Path {
        var out = Path.create();
        var i: i32 = self.pointCount() - 1;
        while (i >= 0) {
            if (i == self.pointCount() - 1) {
                out = out.moveTo(self.pointAt(i));
            } else {
                out = out.lineTo(self.pointAt(i));
            }
            i = i - 1;
        }
        if (self.closed) { out = out.close(); }
        return out;
    }

    public fn simplified(&self, epsilon: f32) -> Path {
        var out = Path.create();
        var threshold: f32 = epsilon;
        if (threshold < (0.0 as f32)) { threshold = (0.0 as f32) - threshold; }
        if (self.pointCount() == 0) { return out; }

        var i: i32 = 0;
        while (i < self.pointCount()) {
            let point = self.pointAt(i);
            if (out.pointCount() == 0 || self.pointDistance(out.lastPoint(), point) > threshold) {
                if (out.pointCount() == 0) {
                    out = out.moveTo(point);
                } else {
                    out = out.lineTo(point);
                }
            }
            i = i + 1;
        }

        if (self.closed && out.pointCount() > 1 && self.pointDistance(out.pointAt(0), out.pointAt(out.pointCount() - 1)) <= threshold) {
            var trimmed = Path.create();
            var trim_i: i32 = 0;
            while (trim_i + 1 < out.pointCount()) {
                if (trim_i == 0) {
                    trimmed = trimmed.moveTo(out.pointAt(trim_i));
                } else {
                    trimmed = trimmed.lineTo(out.pointAt(trim_i));
                }
                trim_i = trim_i + 1;
            }
            out.destroy();
            out = trimmed;
        }

        var changed = true;
        while (changed && out.pointCount() >= 3) {
            changed = false;
            var compact = Path.create();
            var j: i32 = 0;
            while (j < out.pointCount()) {
                var prev_index = j - 1;
                if (prev_index < 0) { prev_index = out.pointCount() - 1; }
                var next_index = j + 1;
                if (next_index >= out.pointCount()) { next_index = 0; }
                var keep = true;
                if (self.closed || (j > 0 && j + 1 < out.pointCount())) {
                    if (self.isCollinear(out.pointAt(prev_index), out.pointAt(j), out.pointAt(next_index), threshold)) {
                        keep = false;
                        changed = true;
                    }
                }
                if (keep) {
                    if (compact.pointCount() == 0) {
                        compact = compact.moveTo(out.pointAt(j));
                    } else {
                        compact = compact.lineTo(out.pointAt(j));
                    }
                }
                j = j + 1;
            }
            out.destroy();
            out = compact;
        }
        if (self.closed && out.pointCount() >= 3) { out = out.close(); }
        return out;
    }

    public fn clone(&self) -> Path {
        var out = Path.create();
        var i: i32 = 0;
        while (i < self.pointCount()) {
            out.points.push(self.pointAt(i).clone());
            i = i + 1;
        }
        out.closed = self.closed;
        return out;
    }

    public fn destroy(&mut self) {
        self.points.destroy();
        self.closed = false;
    }
}
