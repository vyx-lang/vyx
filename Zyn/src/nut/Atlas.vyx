module Zyn.Nut.Atlas;

use Zyn.Nut.Types;
use DecodedImage = Zyn.Nut.Image.DecodedImage;
use std.collections;
use std.string;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

public class AtlasRegion {
    public name: string;
    public atlas_id: i32;
    public x: i32;
    public y: i32;
    public width: i32;
    public height: i32;
    public atlas_width: i32;
    public atlas_height: i32;
    public valid: bool;

    public static fn invalid() -> AtlasRegion {
        return AtlasRegion { name: "", atlas_id: -1, x: 0, y: 0, width: 0, height: 0, atlas_width: 0, atlas_height: 0, valid: false };
    }

    public static fn create(name: string, x: i32, y: i32, width: i32, height: i32, atlas_width: i32, atlas_height: i32) -> AtlasRegion {
        return AtlasRegion.createOnAtlas(name, 0, x, y, width, height, atlas_width, atlas_height);
    }

    public static fn createOnAtlas(name: string, atlas_id: i32, x: i32, y: i32, width: i32, height: i32, atlas_width: i32, atlas_height: i32) -> AtlasRegion {
        return AtlasRegion { name: name, atlas_id: atlas_id, x: x, y: y, width: width, height: height, atlas_width: atlas_width, atlas_height: atlas_height, valid: true };
    }

    public fn isValid(&self) -> bool {
        return self.valid && self.atlas_id >= 0 && self.width > 0 && self.height > 0 && self.atlas_width > 0 && self.atlas_height > 0;
    }

    public fn originX(&self) -> i32 { return self.x; }
    public fn originY(&self) -> i32 { return self.y; }

    public fn u0(&self) -> f32 { return (self.x as f32) / (self.atlas_width as f32); }
    public fn v0(&self) -> f32 { return (self.y as f32) / (self.atlas_height as f32); }
    public fn u1(&self) -> f32 { return ((self.x + self.width) as f32) / (self.atlas_width as f32); }
    public fn v1(&self) -> f32 { return ((self.y + self.height) as f32) / (self.atlas_height as f32); }

    public fn rect(&self) -> Rectangle {
        return Rectangle.xywh(self.x as f32, self.y as f32, self.width as f32, self.height as f32);
    }

    public fn clone(&self) -> AtlasRegion {
        var out: AtlasRegion;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<AtlasRegion>() as i64);
        return out;
    }
}

public class Sprite {
    public region: AtlasRegion;
    public dest: Rectangle;
    public tint: Color;

    public static fn create(region: AtlasRegion, dest: Rectangle, tint: Color) -> Sprite {
        return Sprite { region: region, dest: dest, tint: tint };
    }

    public static fn at(region: AtlasRegion, x: f32, y: f32, tint: Color) -> Sprite {
        return Sprite.create(region, Rectangle.xywh(x, y, region.width as f32, region.height as f32), tint);
    }

    public fn isDrawable(&self) -> bool {
        return self.region.isValid() && self.dest.isDrawable() && self.tint.a > 0.0;
    }

    public fn quad(&self) -> Quad {
        return Quad.fromRect(self.dest);
    }

    public fn clone(&self) -> Sprite {
        var out: Sprite;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<Sprite>() as i64);
        return out;
    }
}

public class SpriteBatch {
    public sprites: Vec<Sprite>;

    public static fn create() -> SpriteBatch {
        return SpriteBatch { sprites: Vec::<Sprite>.new() };
    }

    public fn add(mut self, sprite: Sprite) -> SpriteBatch {
        if (sprite.isDrawable()) {
            self.sprites.push(sprite.clone());
        }
        return self;
    }

    public fn addAt(mut self, region: AtlasRegion, x: f32, y: f32, tint: Color) -> SpriteBatch {
        return self.add(Sprite.at(region, x, y, tint));
    }

    public fn spriteCount(&self) -> i32 {
        return self.sprites.len as i32;
    }

    public fn spriteAt(&self, index: i32) -> Sprite {
        return self.sprites.get(index as i64);
    }

    public fn isEmpty(&self) -> bool {
        return self.spriteCount() == 0;
    }

    public fn clear(mut self) -> SpriteBatch {
        self.sprites.destroy();
        self.sprites = Vec::<Sprite>.new();
        return self;
    }

    public fn destroy(&mut self) {
        self.sprites.destroy();
    }
}

public class Atlas {
    public atlas_id: i32;
    public width: i32;
    public height: i32;
    public padding: i32;
    public cursor_x: i32;
    public cursor_y: i32;
    public row_height: i32;
    public used_area: i32;
    public overflowed: bool;
    public regions: Vec<AtlasRegion>;
    public pixels: rawptr;
    public pixel_bytes: i64;
    public dirty_x: i32;
    public dirty_y: i32;
    public dirty_width: i32;
    public dirty_height: i32;

    public static fn create(width: i32, height: i32, padding: i32) -> Atlas {
        var p = padding;
        if (p < 0) { p = 0; }
        var bytes: i64 = 0;
        var pixel_data: rawptr = null;
        if (width > 0 && height > 0) {
            bytes = (width as i64) * (height as i64) * 4;
            pixel_data = malloc(bytes);
            if (pixel_data != null) { memset(pixel_data, 0, bytes); }
        }
        return Atlas {
            atlas_id: 0,
            width: width,
            height: height,
            padding: p,
            cursor_x: p,
            cursor_y: p,
            row_height: 0,
            used_area: 0,
            overflowed: pixel_data == null,
            regions: Vec::<AtlasRegion>.new(),
            pixels: pixel_data,
            pixel_bytes: bytes,
            dirty_x: 0,
            dirty_y: 0,
            dirty_width: 0,
            dirty_height: 0
        };
    }

    public fn setAtlasId(mut self, id: i32) -> Atlas {
        self.atlas_id = id;
        var i: i32 = 0;
        while (i < self.regionCount()) {
            var region = self.regions.get(i as i64);
            region.atlas_id = id;
            self.regions.set(i as i64, region);
            i = i + 1;
        }
        return self;
    }

    private fn canAddWithAtlasSize(&self, width: i32, height: i32, atlas_width: i32, atlas_height: i32) -> bool {
        if (width <= 0 || height <= 0 || atlas_width <= 0 || atlas_height <= 0) {
            return false;
        }
        let padded_width = width + (self.padding * 2);
        let padded_height = height + (self.padding * 2);
        if (padded_width > atlas_width || padded_height > atlas_height) {
            return false;
        }
        var next_cursor_x = self.cursor_x;
        var next_cursor_y = self.cursor_y;
        var next_row_height = self.row_height;
        if ((next_cursor_x + padded_width) > atlas_width) {
            next_cursor_x = self.padding;
            next_cursor_y = next_cursor_y + next_row_height;
            next_row_height = 0;
        }
        return (next_cursor_y + padded_height) <= atlas_height;
    }

    public fn add(&mut self, name: string, width: i32, height: i32) -> AtlasRegion {
        if (width <= 0 || height <= 0 || self.width <= 0 || self.height <= 0 || !self.hasPixels()) {
            self.overflowed = true;
            return AtlasRegion.invalid();
        }
        let padded_width = width + (self.padding * 2);
        let padded_height = height + (self.padding * 2);
        if (padded_width > self.width || padded_height > self.height) {
            self.overflowed = true;
            return AtlasRegion.invalid();
        }
        var next_cursor_x = self.cursor_x;
        var next_cursor_y = self.cursor_y;
        var next_row_height = self.row_height;
        if ((next_cursor_x + padded_width) > self.width) {
            next_cursor_x = self.padding;
            next_cursor_y = next_cursor_y + next_row_height;
            next_row_height = 0;
        }
        if ((next_cursor_y + padded_height) > self.height) {
            self.overflowed = true;
            return AtlasRegion.invalid();
        }

        let out = AtlasRegion.createOnAtlas(name, self.atlas_id, next_cursor_x + self.padding, next_cursor_y + self.padding, width, height, self.width, self.height);
        self.regions.push(out.clone());
        self.cursor_x = next_cursor_x + padded_width;
        self.cursor_y = next_cursor_y;
        if (padded_height > next_row_height) { next_row_height = padded_height; }
        self.row_height = next_row_height;
        self.used_area = self.used_area + (width * height);
        return out;
    }

    public fn resize(&mut self, new_width: i32, new_height: i32) -> Result<i32, Error> {
        if (new_width < self.width || new_height < self.height || new_width <= 0 || new_height <= 0) {
            return Err(Error.create(124, "atlas resize dimensions are invalid"));
        }
        if (new_width == self.width && new_height == self.height && self.hasPixels()) {
            return Ok(0);
        }
        let new_bytes = (new_width as i64) * (new_height as i64) * 4;
        let new_pixels = malloc(new_bytes);
        if (new_pixels == null) {
            return Err(Error.create(125, "atlas resize allocation failed"));
        }
        memset(new_pixels, 0, new_bytes);
        if (self.hasPixels()) {
            let old_row_bytes = (self.width as i64) * 4;
            let new_row_bytes = (new_width as i64) * 4;
            var y: i32 = 0;
            while (y < self.height) {
                memcpy(new_pixels + ((y as i64) * new_row_bytes), self.pixels + ((y as i64) * old_row_bytes), old_row_bytes);
                y = y + 1;
            }
            free(self.pixels);
        }
        self.pixels = new_pixels;
        self.width = new_width;
        self.height = new_height;
        self.pixel_bytes = new_bytes;
        var i: i32 = 0;
        while (i < self.regionCount()) {
            var region = self.regions.get(i as i64);
            region.atlas_id = self.atlas_id;
            region.atlas_width = new_width;
            region.atlas_height = new_height;
            self.regions.set(i as i64, region);
            i = i + 1;
        }
        self.overflowed = false;
        self.markDirtyRect(0, 0, new_width, new_height);
        return Ok(1);
    }

    public fn ensureCanAdd(&mut self, width: i32, height: i32) -> Result<i32, Error> {
        if (width <= 0 || height <= 0) {
            return Err(Error.create(126, "atlas allocation dimensions are invalid"));
        }
        if (self.canAddWithAtlasSize(width, height, self.width, self.height) && self.hasPixels()) {
            return Ok(0);
        }
        var next_width = self.width;
        var next_height = self.height;
        if (next_width < 1) { next_width = 1; }
        if (next_height < 1) { next_height = 1; }
        var guard: i32 = 0;
        while (!self.canAddWithAtlasSize(width, height, next_width, next_height) && guard < 32) {
            let padded_width = width + (self.padding * 2);
            let padded_height = height + (self.padding * 2);
            if (next_width < padded_width) {
                next_width = next_width * 2;
            } else if (next_height < padded_height) {
                next_height = next_height * 2;
            } else if (next_width <= next_height) {
                next_width = next_width * 2;
            } else {
                next_height = next_height * 2;
            }
            guard = guard + 1;
        }
        if (!self.canAddWithAtlasSize(width, height, next_width, next_height)) {
            return Err(Error.create(127, "atlas could not grow enough for allocation"));
        }
        return self.resize(next_width, next_height);
    }

    public fn regionCount(&self) -> i32 {
        return self.regions.len as i32;
    }

    public fn regionAt(&self, index: i32) -> AtlasRegion {
        if (index < 0 || index >= self.regionCount()) { return AtlasRegion.invalid(); }
        return self.regions.get(index as i64);
    }

    public fn find(&self, name: string) -> AtlasRegion {
        var i: i32 = 0;
        while (i < self.regionCount()) {
            let region = self.regionAt(i);
            if (region.name == name) { return region; }
            i = i + 1;
        }
        return AtlasRegion.invalid();
    }

    public fn hasOverflowed(&self) -> bool {
        return self.overflowed;
    }

    public fn hasPixels(&self) -> bool {
        return self.pixels != null && self.pixel_bytes == ((self.width as i64) * (self.height as i64) * 4);
    }

    public fn byteSize(&self) -> i64 {
        return self.pixel_bytes;
    }

    public fn pixelOffset(&self, x: i32, y: i32) -> i64 {
        return (((y * self.width) + x) as i64) * 4;
    }

    public fn containsPixel(&self, x: i32, y: i32) -> bool {
        return x >= 0 && y >= 0 && x < self.width && y < self.height && self.hasPixels();
    }

    public fn hasDirtyPixels(&self) -> bool {
        return self.dirty_width > 0 && self.dirty_height > 0;
    }

    public fn dirtyRight(&self) -> i32 {
        return self.dirty_x + self.dirty_width;
    }

    public fn dirtyBottom(&self) -> i32 {
        return self.dirty_y + self.dirty_height;
    }

    public fn markDirtyRect(&mut self, x: i32, y: i32, width: i32, height: i32) {
        if (width <= 0 || height <= 0) { return; }
        var x0 = x;
        var y0 = y;
        var x1 = x + width;
        var y1 = y + height;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > self.width) { x1 = self.width; }
        if (y1 > self.height) { y1 = self.height; }
        if (x1 <= x0 || y1 <= y0) { return; }
        if (!self.hasDirtyPixels()) {
            self.dirty_x = x0;
            self.dirty_y = y0;
            self.dirty_width = x1 - x0;
            self.dirty_height = y1 - y0;
            return;
        }
        if (x0 > self.dirty_x) { x0 = self.dirty_x; }
        if (y0 > self.dirty_y) { y0 = self.dirty_y; }
        if (x1 < self.dirtyRight()) { x1 = self.dirtyRight(); }
        if (y1 < self.dirtyBottom()) { y1 = self.dirtyBottom(); }
        self.dirty_x = x0;
        self.dirty_y = y0;
        self.dirty_width = x1 - x0;
        self.dirty_height = y1 - y0;
    }

    public fn clearDirty(mut self) -> Atlas {
        self.dirty_x = 0;
        self.dirty_y = 0;
        self.dirty_width = 0;
        self.dirty_height = 0;
        return self;
    }

    private fn writePixelUnchecked(&self, x: i32, y: i32, rgba: u32) {
        memcpy(self.pixels + self.pixelOffset(x, y), to_rawptr(&rgba), sizeof::<u32>());
    }

    public fn setPixel(&mut self, x: i32, y: i32, rgba: u32) -> bool {
        if (!self.containsPixel(x, y)) { return false; }
        self.writePixelUnchecked(x, y, rgba);
        self.markDirtyRect(x, y, 1, 1);
        return true;
    }

    public fn pixelAt(&self, x: i32, y: i32) -> u32 {
        var out: u32 = 0 as u32;
        if (!self.containsPixel(x, y)) { return out; }
        memcpy(to_rawptr(&out), self.pixels + self.pixelOffset(x, y), sizeof::<u32>());
        return out;
    }

    public fn clearPixels(mut self, rgba: u32) -> Atlas {
        if (!self.hasPixels()) { return self; }
        var y: i32 = 0;
        while (y < self.height) {
            var x: i32 = 0;
            while (x < self.width) {
                self.writePixelUnchecked(x, y, rgba);
                x = x + 1;
            }
            y = y + 1;
        }
        self.markDirtyRect(0, 0, self.width, self.height);
        return self;
    }

    public fn fillRegion(mut self, region: AtlasRegion, rgba: u32) -> Atlas {
        if (!region.isValid() || !self.hasPixels()) { return self; }
        var y: i32 = 0;
        while (y < region.height) {
            var x: i32 = 0;
            while (x < region.width) {
                self.writePixelUnchecked(region.originX() + x, region.originY() + y, rgba);
                x = x + 1;
            }
            y = y + 1;
        }
        self.markDirtyRect(region.x, region.y, region.width, region.height);
        return self;
    }

    public fn blitRgba(&mut self, region: AtlasRegion, source: rawptr, source_width: i32, source_height: i32) -> bool {
        if (!region.isValid() || !self.hasPixels() || source == null) { return false; }
        if (source_width != region.width || source_height != region.height) { return false; }
        var y: i32 = 0;
        let row_bytes = (region.width as i64) * 4;
        while (y < region.height) {
            let src_offset = (y as i64) * row_bytes;
            let dst_offset = self.pixelOffset(region.originX(), region.originY() + y);
            memcpy(self.pixels + dst_offset, source + src_offset, row_bytes);
            y = y + 1;
        }
        self.markDirtyRect(region.x, region.y, region.width, region.height);
        return true;
    }

    public fn blitRgbaRect(&mut self, region: AtlasRegion, source: rawptr, source_width: i32, source_height: i32, source_x: i32, source_y: i32) -> bool {
        if (!region.isValid() || !self.hasPixels() || source == null) { return false; }
        if (source_width <= 0 || source_height <= 0) { return false; }
        if (source_x < 0 || source_y < 0) { return false; }
        if ((source_x + region.width) > source_width || (source_y + region.height) > source_height) { return false; }
        var y: i32 = 0;
        let row_bytes = (region.width as i64) * 4;
        let source_row_bytes = (source_width as i64) * 4;
        while (y < region.height) {
            let src_offset = (((source_y + y) as i64) * source_row_bytes) + ((source_x as i64) * 4);
            let dst_offset = self.pixelOffset(region.originX(), region.originY() + y);
            memcpy(self.pixels + dst_offset, source + src_offset, row_bytes);
            y = y + 1;
        }
        self.markDirtyRect(region.x, region.y, region.width, region.height);
        return true;
    }

    public fn addRgba(&mut self, name: string, source: rawptr, source_width: i32, source_height: i32) -> Result<AtlasRegion, Error> {
        if (source == null || source_width <= 0 || source_height <= 0) {
            return Err(Error.create(120, "atlas source pixels are invalid"));
        }
        match (self.ensureCanAdd(source_width, source_height)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        let region = self.add(name, source_width, source_height);
        if (!region.isValid()) {
            return Err(Error.create(121, "atlas allocation failed: " + name));
        }
        if (!self.blitRgba(region, source, source_width, source_height)) {
            return Err(Error.create(122, "atlas RGBA blit failed: " + name));
        }
        return Ok(region);
    }

    public fn addImage(&mut self, name: string, image: DecodedImage) -> Result<AtlasRegion, Error> {
        if (!image.isValid() || image.channels != 4) {
            return Err(Error.create(123, "atlas image must be decoded RGBA"));
        }
        var w: i32 = 0;
        var h: i32 = 0;
        memcpy(to_rawptr(&w), to_rawptr(&image.width), sizeof::<i32>() as i64);
        memcpy(to_rawptr(&h), to_rawptr(&image.height), sizeof::<i32>() as i64);
        return self.addRgba(name, image.data, w, h);
    }

    public fn utilization(&self) -> f32 {
        if (self.width <= 0 || self.height <= 0) { return 0.0 as f32; }
        return (self.used_area as f32) / ((self.width * self.height) as f32);
    }

    public fn destroy(&mut self) {
        if (self.pixels != null) {
            free(self.pixels);
        }
        self.pixels = null;
        self.pixel_bytes = 0;
        self.dirty_x = 0;
        self.dirty_y = 0;
        self.dirty_width = 0;
        self.dirty_height = 0;
        self.regions.destroy();
        self.width = 0;
        self.height = 0;
        self.atlas_id = 0;
        self.padding = 0;
        self.cursor_x = 0;
        self.cursor_y = 0;
        self.row_height = 0;
        self.used_area = 0;
        self.overflowed = false;
    }
}

public class AtlasSet {
    public pages: Vec<Atlas>;
    public page_width: i32;
    public page_height: i32;
    public padding: i32;

    public static fn create(page_width: i32, page_height: i32, padding: i32) -> AtlasSet {
        var p = padding;
        if (p < 0) { p = 0; }
        return AtlasSet { pages: Vec::<Atlas>.new(), page_width: page_width, page_height: page_height, padding: p };
    }

    private fn addPage(&mut self) -> Result<i32, Error> {
        if (self.page_width <= 0 || self.page_height <= 0) {
            return Err(Error.create(128, "atlas set page dimensions are invalid"));
        }
        var page = Atlas.create(self.page_width, self.page_height, self.padding);
        if (!page.hasPixels()) {
            page.destroy();
            return Err(Error.create(129, "atlas set page allocation failed"));
        }
        let id = self.pages.len as i32;
        page = page.setAtlasId(id);
        self.pages.push(page);
        return Ok(id);
    }

    public fn pageCount(&self) -> i32 {
        return self.pages.len as i32;
    }

    public fn pageAt(&self, index: i32) -> Atlas {
        return self.pages.get(index as i64);
    }

    private fn canFitPage(&self, width: i32, height: i32) -> bool {
        if (width <= 0 || height <= 0 || self.page_width <= 0 || self.page_height <= 0) { return false; }
        return (width + (self.padding * 2)) <= self.page_width && (height + (self.padding * 2)) <= self.page_height;
    }

    public fn add(&mut self, name: string, width: i32, height: i32) -> Result<AtlasRegion, Error> {
        if (!self.canFitPage(width, height)) {
            return Err(Error.create(130, "atlas set region does not fit a page"));
        }
        var i: i32 = 0;
        while (i < self.pageCount()) {
            var page = self.pages.get(i as i64);
            let region = page.add(name, width, height);
            self.pages.set(i as i64, page);
            if (region.isValid()) { return Ok(region); }
            i = i + 1;
        }
        var new_page_id: i32 = 0;
        match (self.addPage()) {
            case Ok(v) => { new_page_id = v; }
            case Err(e) => { return Err(e); }
        }
        var new_page = self.pages.get(new_page_id as i64);
        let new_region = new_page.add(name, width, height);
        self.pages.set(new_page_id as i64, new_page);
        if (!new_region.isValid()) {
            return Err(Error.create(131, "atlas set allocation failed after adding page"));
        }
        return Ok(new_region);
    }

    public fn addRgba(&mut self, name: string, source: rawptr, source_width: i32, source_height: i32) -> Result<AtlasRegion, Error> {
        if (source == null || source_width <= 0 || source_height <= 0) {
            return Err(Error.create(132, "atlas set source pixels are invalid"));
        }
        var region: AtlasRegion;
        match (self.add(name, source_width, source_height)) {
            case Ok(v) => { region = v; }
            case Err(e) => { return Err(e); }
        }
        var page = self.pages.get(region.atlas_id as i64);
        let blit_ok = page.blitRgba(region, source, source_width, source_height);
        self.pages.set(region.atlas_id as i64, page);
        if (!blit_ok) {
            return Err(Error.create(133, "atlas set RGBA blit failed: " + name));
        }
        return Ok(region);
    }

    public fn addImage(&mut self, name: string, image: DecodedImage) -> Result<AtlasRegion, Error> {
        if (!image.isValid() || image.channels != 4) {
            return Err(Error.create(134, "atlas set image must be decoded RGBA"));
        }
        var w: i32 = 0;
        var h: i32 = 0;
        memcpy(to_rawptr(&w), to_rawptr(&image.width), sizeof::<i32>() as i64);
        memcpy(to_rawptr(&h), to_rawptr(&image.height), sizeof::<i32>() as i64);
        return self.addRgba(name, image.data, w, h);
    }

    public fn fillRegion(&mut self, region: AtlasRegion, rgba: u32) -> Result<AtlasSet, Error> {
        if (!region.isValid() || region.atlas_id < 0 || region.atlas_id >= self.pageCount()) {
            return Err(Error.create(135, "atlas set fill region is invalid"));
        }
        var page = self.pages.get(region.atlas_id as i64);
        page = page.fillRegion(region, rgba);
        self.pages.set(region.atlas_id as i64, page);
        return Ok(self);
    }

    public fn find(&self, name: string) -> AtlasRegion {
        var i: i32 = 0;
        while (i < self.pageCount()) {
            let page = self.pages.get(i as i64);
            let region = page.find(name);
            if (region.isValid()) { return region; }
            i = i + 1;
        }
        return AtlasRegion.invalid();
    }

    public fn totalRegionCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.pageCount()) {
            let page = self.pages.get(i as i64);
            count = count + page.regionCount();
            i = i + 1;
        }
        return count;
    }

    public fn byteSize(&self) -> i64 {
        var bytes: i64 = 0;
        var i: i32 = 0;
        while (i < self.pageCount()) {
            let page = self.pages.get(i as i64);
            bytes = bytes + page.byteSize();
            i = i + 1;
        }
        return bytes;
    }

    public fn utilization(&self) -> f32 {
        var used: i32 = 0;
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.pageCount()) {
            let page = self.pages.get(i as i64);
            used = used + page.used_area;
            total = total + (page.width * page.height);
            i = i + 1;
        }
        if (total <= 0) { return 0.0 as f32; }
        return (used as f32) / (total as f32);
    }

    public fn clearDirty(mut self) -> AtlasSet {
        var i: i32 = 0;
        while (i < self.pageCount()) {
            var page = self.pages.get(i as i64);
            page = page.clearDirty();
            self.pages.set(i as i64, page);
            i = i + 1;
        }
        return self;
    }

    public fn destroy(&mut self) {
        var i: i32 = 0;
        while (i < self.pageCount()) {
            var page = self.pages.get(i as i64);
            page.destroy();
            self.pages.set(i as i64, page);
            i = i + 1;
        }
        self.pages.destroy();
        self.page_width = 0;
        self.page_height = 0;
        self.padding = 0;
    }
}
