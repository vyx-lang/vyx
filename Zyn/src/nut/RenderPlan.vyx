module Zyn.Nut.RenderPlan;
// ownership-migration

use Error = Zyn.Nut.Types.Error;
use RenderGraph = Zyn.Nut.RenderGraph.RenderGraph;
use RenderCommandKind = Zyn.Nut.RenderGraph.RenderCommandKind;
use SolidVertex = Zyn.Nut.Batch.SolidVertex;
use TexturedVertex = Zyn.Nut.Batch.TexturedVertex;
use std.collections;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn planLoadI32(src: rawptr) -> i32 {
    var v: i32 = 0;
    memcpy(to_rawptr(&v), src, 4);
    return v;
}

fn kindEqI32(a: rawptr, b: rawptr) -> bool {
    var av: i32 = 0;
    var bv: i32 = 0;
    memcpy(to_rawptr(&av), a, sizeof::<i32>() as i64);
    memcpy(to_rawptr(&bv), b, sizeof::<i32>() as i64);
    return av == bv;
}

public class RenderMaterialKind {
    public value: i32;

    public static fn none() -> RenderMaterialKind { return RenderMaterialKind { value: 0 }; }
    public static fn solid() -> RenderMaterialKind { return RenderMaterialKind { value: 1 }; }
    public static fn textured() -> RenderMaterialKind { return RenderMaterialKind { value: 2 }; }

    public fn equals(&self, other: RenderMaterialKind) -> bool {
        return self.value == other.value;
    }

    public fn clone(&self) -> RenderMaterialKind {
        var out: RenderMaterialKind;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderMaterialKind>() as i64);
        return out;
    }

    public fn writeValue(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(self), sizeof::<i32>() as i64);
    }
}

public class RenderResourceKind {
    public value: i32;

    public static fn swapchainColor() -> RenderResourceKind { return RenderResourceKind { value: 1 }; }
    public static fn solidVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 2 }; }
    public static fn texturedVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 3 }; }
    public static fn spriteTexture() -> RenderResourceKind { return RenderResourceKind { value: 4 }; }
    public static fn layerColorTarget() -> RenderResourceKind { return RenderResourceKind { value: 5 }; }
    public static fn clipMaskVertexBuffer() -> RenderResourceKind { return RenderResourceKind { value: 6 }; }
    public static fn clipStencilTarget() -> RenderResourceKind { return RenderResourceKind { value: 7 }; }
    public static fn externalColorTarget() -> RenderResourceKind { return RenderResourceKind { value: 8 }; }
    public static fn fromValue(value: i32) -> RenderResourceKind { return RenderResourceKind { value: value }; }

    public fn equals(&self, other: RenderResourceKind) -> bool {
        return self.value == other.value;
    }

    public fn clone(&self) -> RenderResourceKind {
        var out: RenderResourceKind;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderResourceKind>() as i64);
        return out;
    }
}

public class RenderResource {
    public kind: RenderResourceKind;
    public estimated_bytes: u64;
    public page_id: i32;
    public first_pass: i32;
    public last_pass: i32;

    public static fn create(kind: RenderResourceKind, estimated_bytes: u64) -> RenderResource {
        return RenderResource.createForPage(kind, estimated_bytes, 0);
    }

    public static fn createForPage(kind: RenderResourceKind, estimated_bytes: u64, page_id: i32) -> RenderResource {
        return RenderResource.createForPageLifetime(kind, estimated_bytes, page_id, -1, -1);
    }

    public static fn createForPageLifetime(kind: RenderResourceKind, estimated_bytes: u64, page_id: i32, first_pass: i32, last_pass: i32) -> RenderResource {
        return RenderResource { kind: kind, estimated_bytes: estimated_bytes, page_id: page_id, first_pass: first_pass, last_pass: last_pass };
    }

    public fn clone(&self) -> RenderResource {
        var out: RenderResource;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderResource>() as i64);
        return out;
    }

    public fn writeEstimatedBytes(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(&self.estimated_bytes), sizeof::<u64>() as i64);
    }

    public fn writeFirstPass(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(&self.first_pass), sizeof::<i32>() as i64);
    }

    public fn writeLastPass(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(&self.last_pass), sizeof::<i32>() as i64);
    }

    public fn writeKindValue(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(self), sizeof::<i32>() as i64);
    }
}

public class RenderPassKind {
    public value: i32;

    public static fn color() -> RenderPassKind { return RenderPassKind { value: 1 }; }
    public static fn layer() -> RenderPassKind { return RenderPassKind { value: 2 }; }
    public static fn composite() -> RenderPassKind { return RenderPassKind { value: 3 }; }
    public static fn external() -> RenderPassKind { return RenderPassKind { value: 4 }; }

    public fn equals(&self, other: RenderPassKind) -> bool {
        return self.value == other.value;
    }

    public fn clone(&self) -> RenderPassKind {
        var out: RenderPassKind;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderPassKind>() as i64);
        return out;
    }

    public fn writeValue(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(self), sizeof::<i32>() as i64);
    }
}

public class RenderPass {
    public kind: RenderPassKind;
    public first_command: i32;
    public command_count: i32;
    public draw_count: i32;
    public segment_count: i32;
    public target_id: i32;
    public clear: bool;

    public static fn create(kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, clear: bool) -> RenderPass {
        return RenderPass.createForTarget(kind, first_command, command_count, draw_count, segment_count, -1, clear);
    }

    public static fn createForTarget(kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, target_id: i32, clear: bool) -> RenderPass {
        return RenderPass { kind: kind, first_command: first_command, command_count: command_count, draw_count: draw_count, segment_count: segment_count, target_id: target_id, clear: clear };
    }

    public fn clone(&self) -> RenderPass {
        var out: RenderPass;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderPass>() as i64);
        return out;
    }

    public fn writeKindValue(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(self), sizeof::<i32>() as i64);
    }

    public fn writeTargetId(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(&self.target_id), sizeof::<i32>() as i64);
    }

    public fn writeDrawCount(&self, dst: rawptr) {
        memcpy(dst, to_rawptr(&self.draw_count), sizeof::<i32>() as i64);
    }
}

public class RenderPassDependency {
    public from_pass: i32;
    public to_pass: i32;
    public resource_index: i32;

    public static fn create(from_pass: i32, to_pass: i32, resource_index: i32) -> RenderPassDependency {
        return RenderPassDependency { from_pass: from_pass, to_pass: to_pass, resource_index: resource_index };
    }

    public fn clone(&self) -> RenderPassDependency {
        var out: RenderPassDependency;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<RenderPassDependency>() as i64);
        return out;
    }
}

public class RenderPlan {
    public passes: Vec<RenderPass>;
    public resources: Vec<RenderResource>;
    public dependencies: Vec<RenderPassDependency>;
    public command_count: i32;
    public draw_count: i32;
    public solid_draw_count: i32;
    public textured_draw_count: i32;
    public segment_count: i32;
    public solid_segment_count: i32;
    public textured_segment_count: i32;
    public texture_page_count: i32;
    public clip_change_count: i32;
    public clip_path_count: i32;
    public clip_path_cpu_coverage_count: i32;
    public clip_path_bounds_fallback_count: i32;
    public transform_change_count: i32;
    public pipeline_change_count: i32;
    public default_pipeline_change_count: i32;
    public custom_pipeline_change_count: i32;
    public unique_pipeline_count: i32;
    public last_pipeline_id: i32;
    public layer_change_count: i32;
    public layer_pass_count: i32;
    public max_layer_depth: i32;
    public estimated_solid_vertices: i32;
    public estimated_textured_vertices: i32;
    public clip_expansion_vertex_reserve: i32;
    public clip_mask_vertex_capacity_estimate: i32;
    public clip_stencil_target_bytes_estimate: u64;
    public layer_composite_vertex_reserve: i32;
    public solid_vertex_capacity_estimate: i32;
    public textured_vertex_capacity_estimate: i32;
    public has_clear: bool;

    public static fn empty() -> RenderPlan {
        return RenderPlan {
            passes: Vec::<RenderPass>.new(),
            resources: Vec::<RenderResource>.new(),
            dependencies: Vec::<RenderPassDependency>.new(),
            command_count: 0,
            draw_count: 0,
            solid_draw_count: 0,
            textured_draw_count: 0,
            segment_count: 0,
            solid_segment_count: 0,
            textured_segment_count: 0,
            texture_page_count: 0,
            clip_change_count: 0,
            clip_path_count: 0,
            clip_path_cpu_coverage_count: 0,
            clip_path_bounds_fallback_count: 0,
            transform_change_count: 0,
            pipeline_change_count: 0,
            default_pipeline_change_count: 0,
            custom_pipeline_change_count: 0,
            unique_pipeline_count: 0,
            last_pipeline_id: -1,
            layer_change_count: 0,
            layer_pass_count: 0,
            max_layer_depth: 0,
            estimated_solid_vertices: 0,
            estimated_textured_vertices: 0,
            clip_expansion_vertex_reserve: 0,
            clip_mask_vertex_capacity_estimate: 0,
            clip_stencil_target_bytes_estimate: 0 as u64,
            layer_composite_vertex_reserve: 0,
            solid_vertex_capacity_estimate: 0,
            textured_vertex_capacity_estimate: 0,
            has_clear: false
        };
    }

    public fn addResource(&mut self, kind: RenderResourceKind, bytes: u64) {
        self.resources.push(RenderResource.create(kind, bytes));
    }

    public fn addPassForTarget(&mut self, kind: RenderPassKind, first_command: i32, command_count: i32, draw_count: i32, segment_count: i32, target_id: i32, clear: bool) {
        self.passes.push(RenderPass.createForTarget(kind, first_command, command_count, draw_count, segment_count, target_id, clear));
    }

    public fn addResourceForPage(&mut self, kind: RenderResourceKind, bytes: u64, page_id: i32) {
        self.resources.push(RenderResource.createForPage(kind, bytes, page_id));
    }

    public fn addResourceForPageLifetime(&mut self, kind: RenderResourceKind, bytes: u64, page_id: i32, first_pass: i32, last_pass: i32) {
        self.resources.push(RenderResource.createForPageLifetime(kind, bytes, page_id, first_pass, last_pass));
    }

    public fn addDependency(&mut self, from_pass: i32, to_pass: i32, resource_index: i32) {
        self.dependencies.push(RenderPassDependency.create(from_pass, to_pass, resource_index));
    }

    public static fn commandMaterialValue(kv: i32) -> i32 {
        if (kv == 13 || kv == 19) { return 2; }
        if (kv == 2) { return 1; }
        if (kv == 3) { return 1; }
        if (kv == 8) { return 1; }
        if (kv == 9) { return 1; }
        if (kv == 10) { return 1; }
        if (kv == 4) { return 1; }
        if (kv == 5) { return 1; }
        return 0;
    }

    public static fn commandMaterial(kv: i32) -> RenderMaterialKind {
        if (kv == 13 || kv == 19) { return RenderMaterialKind.textured(); }
        if (kv == 2) { return RenderMaterialKind.solid(); }
        if (kv == 3) { return RenderMaterialKind.solid(); }
        if (kv == 8) { return RenderMaterialKind.solid(); }
        if (kv == 9) { return RenderMaterialKind.solid(); }
        if (kv == 10) { return RenderMaterialKind.solid(); }
        if (kv == 4) { return RenderMaterialKind.solid(); }
        if (kv == 5) { return RenderMaterialKind.solid(); }
        return RenderMaterialKind.none();
    }

    public static fn commandVertexEstimate(kv: i32) -> i32 {
        if (kv == 13 || kv == 19) { return 6; }
        if (kv == 2) { return 6; }
        if (kv == 3) { return 96; }
        if (kv == 8) { return 3; }
        if (kv == 9) { return 6; }
        if (kv == 10) { return 6; }
        if (kv == 4) { return 6; }
        if (kv == 5) { return 24; }
        return 0;
    }

    public static fn commandHasCpuClipPathCoverage(kv: i32) -> bool {
        if (kv == 2) { return true; }
        if (kv == 3) { return true; }
        if (kv == 8) { return true; }
        if (kv == 9) { return true; }
        if (kv == 10) { return true; }
        if (kv == 13) { return true; }
        if (kv == 19) { return true; }
        if (kv == 4) { return true; }
        if (kv == 5) { return true; }
        return false;
    }

    @[borrow_args]
    public static fn matchingLayerPop(graph: RenderGraph, push_index: i32) -> i32 {
        var depth: i32 = 0;
        var i: i32 = push_index;
        while (i < graph.command_count) {
            let command = graph.commandAt(i);
            var ck: i32 = 0;
            memcpy(to_rawptr(&ck), to_rawptr(&command), 4);
            if (ck == 14) {
                depth = depth + 1;
            }
            if (ck == 15) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    @[borrow_args]
    public static fn rangeDrawCount(graph: RenderGraph, first: i32, count: i32) -> i32 {
        var out: i32 = 0;
        var i: i32 = first;
        let end: i32 = first + count;
        while (i < end && i < graph.command_count) {
            let command = graph.commandAt(i);
            var ck: i32 = 0;
            memcpy(to_rawptr(&ck), to_rawptr(&command), 4);
            let mv = RenderPlan.commandMaterialValue(ck);
            if (mv != 0) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public static fn rangeSegmentCount(graph: RenderGraph, first: i32, count: i32) -> i32 {
        var out: i32 = 0;
        var current_material: i32 = 0;
        var current_texture_page: i32 = -1;
        var open_segment = false;
        var i: i32 = first;
        let end: i32 = first + count;
        while (i < end && i < graph.command_count) {
            let command = graph.commandAt(i);
            var ck: i32 = 0;
            memcpy(to_rawptr(&ck), to_rawptr(&command), 4);
            if (ck == 6 || ck == 16 || ck == 7) {
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
            }
            if (ck == 18 || ck == 14 || ck == 15) {
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
            }
            let material = RenderPlan.commandMaterialValue(ck);
            if (ck == 19) {
                out = out + 1;
                open_segment = false;
                current_material = 0;
                current_texture_page = -1;
                i = i + 1;
                continue;
            }
            if (material != 0) {
                var texture_page: i32 = -1;
                if (material == 2) {
                    texture_page = command.sprite.region.atlas_id;
                }
                if (!open_segment || material != current_material || (material == 2 && texture_page != current_texture_page)) {
                    out = out + 1;
                    current_material = material;
                    current_texture_page = texture_page;
                    open_segment = true;
                }
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    @[borrow_args]
    public static fn build(graph: RenderGraph) -> Result<RenderPlan, Error> {
        match (graph.validate()) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        var out = RenderPlan.empty();
        out.command_count = graph.commandCount();
        out.draw_count = graph.drawCommandCount();
        out.has_clear = graph.hasClear();
        var external_slots = Vec::<i32>.new();
        var external_i: i32 = 0;
        while (external_i < graph.commandCount()) {
            let external_command = graph.commandAt(external_i);
            if (external_command.kind.equals(RenderCommandKind.externalView())) {
                var seen = false;
                var scan: i64 = 0;
                while (scan < external_slots.len) {
                    if (external_slots.get(scan) == external_command.external_slot) { seen = true; }
                    scan = scan + 1;
                }
                if (!seen) {
                    external_slots.push(external_command.external_slot);
                    out.addPassForTarget(RenderPassKind.external(), external_i, 1, 1, 1, external_command.external_slot, false);
                }
            }
            external_i = external_i + 1;
        }

        var current_material: i32 = 0;
        var current_texture_page: i32 = -1;
        var texture_pages = Vec::<i32>.new();
        var pipeline_ids = Vec::<i32>.new();
        var clip_path_depth_stack = Vec::<i32>.new();
        var open_segment = false;
        var layer_depth: i32 = 0;
        var clip_path_depth: i32 = 0;
        var current_segment_target: i32 = 0;
        var i: i32 = 0;
        while (i < graph.commandCount()) {
            let command = graph.commandAt(i);
            let ck = planLoadI32(to_rawptr(&command));
            if (ck == 11 || ck == 12) {
                out.transform_change_count = out.transform_change_count + 1;
            }
            if (ck == 6 || ck == 16 || ck == 7) {
                out.clip_change_count = out.clip_change_count + 1;
                if (ck == 6) {
                    clip_path_depth_stack.push(clip_path_depth);
                }
                if (ck == 16) {
                    clip_path_depth_stack.push(clip_path_depth);
                    out.clip_path_count = out.clip_path_count + 1;
                    out.clip_path_bounds_fallback_count = out.clip_path_bounds_fallback_count + 1;
                    clip_path_depth = clip_path_depth + 1;
                }
                if (ck == 7) {
                    if (!clip_path_depth_stack.isEmpty()) {
                        clip_path_depth = clip_path_depth_stack.pop();
                    } else {
                        clip_path_depth = 0;
                    }
                }
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                }
            }
            if (ck == 18) {
                out.pipeline_change_count = out.pipeline_change_count + 1;
                let pipeline_id = command.stroke_width as i32;
                out.last_pipeline_id = pipeline_id;
                if (pipeline_id == 0) {
                    out.default_pipeline_change_count = out.default_pipeline_change_count + 1;
                } else {
                    out.custom_pipeline_change_count = out.custom_pipeline_change_count + 1;
                }
                var has_pipeline_id = false;
                var pipeline_scan: i32 = 0;
                while (pipeline_scan < (pipeline_ids.len as i32)) {
                    if (pipeline_ids.get(pipeline_scan as i64) == pipeline_id) {
                        has_pipeline_id = true;
                    }
                    pipeline_scan = pipeline_scan + 1;
                }
                if (!has_pipeline_id) {
                    pipeline_ids.push(pipeline_id);
                }
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                }
            }
            if (ck == 14 || ck == 15) {
                out.layer_change_count = out.layer_change_count + 1;
                if (open_segment) {
                    open_segment = false;
                    current_material = 0;
                    current_texture_page = -1;
                }
                if (ck == 14) {
                    out.layer_pass_count = out.layer_pass_count + 1;
                    layer_depth = layer_depth + 1;
                    current_segment_target = layer_depth;
                    if (layer_depth > out.max_layer_depth) {
                        out.max_layer_depth = layer_depth;
                    }
                    let layer_end = RenderPlan.matchingLayerPop(graph, i);
                    if (layer_end > i) {
                        let layer_first = i + 1;
                        let layer_count = layer_end - layer_first;
                        out.addPassForTarget(RenderPassKind.layer(), layer_first, layer_count,
                            RenderPlan.rangeDrawCount(graph, layer_first, layer_count),
                            RenderPlan.rangeSegmentCount(graph, layer_first, layer_count), layer_depth - 1, false);
                    }
                } else {
                    out.addPassForTarget(RenderPassKind.composite(), i, 1, 1, 1, layer_depth - 1, false);
                    layer_depth = layer_depth - 1;
                    if (layer_depth < 0) {
                        layer_depth = 0;
                    }
                    current_segment_target = layer_depth;
                    out.segment_count = out.segment_count + 1;
                    out.textured_segment_count = out.textured_segment_count + 1;
                    out.estimated_textured_vertices = out.estimated_textured_vertices + 6;
                    open_segment = false;
                    current_material = 0;
                    current_texture_page = -1;
                }
            }

            let material = RenderPlan.commandMaterialValue(ck);
            if (material != 0) {
                if (clip_path_depth > 0 && RenderPlan.commandHasCpuClipPathCoverage(ck) && out.clip_path_cpu_coverage_count < out.clip_path_count) {
                    var cover_count = clip_path_depth;
                    let remaining_cover = out.clip_path_count - out.clip_path_cpu_coverage_count;
                    if (cover_count > remaining_cover) { cover_count = remaining_cover; }
                    out.clip_path_cpu_coverage_count = out.clip_path_cpu_coverage_count + cover_count;
                    if (out.clip_path_bounds_fallback_count >= cover_count) {
                        out.clip_path_bounds_fallback_count = out.clip_path_bounds_fallback_count - cover_count;
                    } else {
                        out.clip_path_bounds_fallback_count = 0;
                    }
                }
                var texture_page: i32 = -1;
                if (ck == 13) {
                    texture_page = command.sprite.region.atlas_id;
                    var has_texture_page = false;
                    var texture_page_scan: i32 = 0;
                    while (texture_page_scan < (texture_pages.len as i32)) {
                        if (texture_pages.get(texture_page_scan as i64) == texture_page) {
                            has_texture_page = true;
                        }
                        texture_page_scan = texture_page_scan + 1;
                    }
                    if (!has_texture_page) {
                        texture_pages.push(texture_page);
                    }
                }
                if (ck == 19 || !open_segment || material != current_material || current_segment_target != layer_depth || (material == 2 && texture_page != current_texture_page)) {
                    out.segment_count = out.segment_count + 1;
                    current_material = material;
                    current_texture_page = texture_page;
                    current_segment_target = layer_depth;
                    open_segment = true;
                    if (material == 2) {
                        out.textured_segment_count = out.textured_segment_count + 1;
                    } else {
                        out.solid_segment_count = out.solid_segment_count + 1;
                    }
                }
                let vertices = RenderPlan.commandVertexEstimate(ck);
                if (material == 2) {
                    out.textured_draw_count = out.textured_draw_count + 1;
                    out.estimated_textured_vertices = out.estimated_textured_vertices + vertices;
                } else {
                    out.solid_draw_count = out.solid_draw_count + 1;
                    out.estimated_solid_vertices = out.estimated_solid_vertices + vertices;
                }
                if (ck == 19) { open_segment = false; }
            }
            i = i + 1;
        }
        out.texture_page_count = texture_pages.len as i32;
        out.unique_pipeline_count = pipeline_ids.len as i32;
        out.clip_expansion_vertex_reserve = (out.clip_path_count * 256) + (out.command_count * 32);
        if (out.clip_path_count > 0) {
            out.clip_mask_vertex_capacity_estimate = (out.clip_path_count * 256) + 6;
            if (graph.hasDrawBounds()) {
                let clip_bounds = graph.drawBounds();
                var clip_width = clip_bounds.width as i64;
                var clip_height = clip_bounds.height as i64;
                if (clip_width < 1) { clip_width = 1; }
                if (clip_height < 1) { clip_height = 1; }
                out.clip_stencil_target_bytes_estimate = (clip_width as u64) * (clip_height as u64) * (4 as u64);
            }
        }
        out.layer_composite_vertex_reserve = out.layer_pass_count * 6;
        let graph_vertex_estimate = out.estimatedVertexCount() - out.layer_composite_vertex_reserve;
        out.solid_vertex_capacity_estimate = graph_vertex_estimate + out.clip_expansion_vertex_reserve;
        out.textured_vertex_capacity_estimate = graph_vertex_estimate + out.layer_composite_vertex_reserve + out.clip_expansion_vertex_reserve;

        if (out.command_count > 0 || out.has_clear) {
            out.addPassForTarget(RenderPassKind.color(), 0, out.command_count, out.draw_count, out.segment_count, -1, out.has_clear);
            out.addResourceForPageLifetime(RenderResourceKind.swapchainColor(), 0 as u64, 0, out.passCount() - 1, out.passCount() - 1);
        }
        if (out.estimated_solid_vertices > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.solidVertexBuffer(), (out.solid_vertex_capacity_estimate as u64) * (sizeof::<SolidVertex>() as u64), 0, 0, out.passCount() - 1);
        }
        if (out.estimated_textured_vertices > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.texturedVertexBuffer(), (out.textured_vertex_capacity_estimate as u64) * (sizeof::<TexturedVertex>() as u64), 0, 0, out.passCount() - 1);
            var texture_i: i32 = 0;
            while (texture_i < (texture_pages.len as i32)) {
                out.addResourceForPageLifetime(RenderResourceKind.spriteTexture(), 0 as u64, texture_pages.get(texture_i as i64), 0, out.passCount() - 1);
                texture_i = texture_i + 1;
            }
        }
        var external_resource_i: i32 = 0;
        while (external_resource_i < (external_slots.len as i32)) {
            out.addResourceForPageLifetime(RenderResourceKind.externalColorTarget(), 0 as u64, external_slots.get(external_resource_i as i64), external_resource_i, out.passCount() - 1);
            external_resource_i = external_resource_i + 1;
        }
        if (out.clip_path_count > 0) {
            out.addResourceForPageLifetime(RenderResourceKind.clipMaskVertexBuffer(), (out.clip_mask_vertex_capacity_estimate as u64) * (sizeof::<SolidVertex>() as u64), 0, 0, out.passCount() - 1);
            out.addResourceForPageLifetime(RenderResourceKind.clipStencilTarget(), out.clip_stencil_target_bytes_estimate, 0, 0, out.passCount() - 1);
        }
        var layer_target_bytes: u64 = 0 as u64;
        if (out.max_layer_depth > 0 && graph.hasDrawBounds()) {
            let layer_bounds = graph.drawBounds();
            var layer_width = layer_bounds.width as i64;
            var layer_height = layer_bounds.height as i64;
            if (layer_width < 1) { layer_width = 1; }
            if (layer_height < 1) { layer_height = 1; }
            layer_target_bytes = (layer_width as u64) * (layer_height as u64) * (4 as u64);
        }
        var layer_resource_i: i32 = 0;
        while (layer_resource_i < out.max_layer_depth) {
            var first_layer_pass = -1;
            var last_layer_pass = -1;
            var pass_i: i32 = 0;
            while (pass_i < out.passCount()) {
                let pass = out.passAt(pass_i);
                if ((pass.kind.equals(RenderPassKind.layer()) || pass.kind.equals(RenderPassKind.composite())) && pass.target_id == layer_resource_i) {
                    if (first_layer_pass < 0) { first_layer_pass = pass_i; }
                    last_layer_pass = pass_i;
                }
                pass_i = pass_i + 1;
            }
            out.addResourceForPageLifetime(RenderResourceKind.layerColorTarget(), layer_target_bytes, layer_resource_i, first_layer_pass, last_layer_pass);
            layer_resource_i = layer_resource_i + 1;
        }
        var dependency_resource_i: i32 = 0;
        while (dependency_resource_i < out.resourceCount()) {
            let resource = out.resourceAt(dependency_resource_i);
            if (resource.first_pass >= 0 && resource.last_pass > resource.first_pass) {
                out.addDependency(resource.first_pass, resource.last_pass, dependency_resource_i);
            }
            dependency_resource_i = dependency_resource_i + 1;
        }
        texture_pages.destroy();
        external_slots.destroy();
        pipeline_ids.destroy();
        clip_path_depth_stack.destroy();
        return Ok(out);
    }

    public fn passCount(&self) -> i32 {
        return self.passes.len as i32;
    }

    public fn resourceCount(&self) -> i32 {
        return self.resources.len as i32;
    }

    public fn dependencyCount(&self) -> i32 {
        return self.dependencies.len as i32;
    }

    public fn passAt(&self, index: i32) -> RenderPass {
        var out: RenderPass;
        memcpy(to_rawptr(&out), self.passes.data + ((index as i64) * sizeof::<RenderPass>()), sizeof::<RenderPass>() as i64);
        return out;
    }

    public fn resourceAt(&self, index: i32) -> RenderResource {
        var out: RenderResource;
        memcpy(to_rawptr(&out), self.resources.data + ((index as i64) * sizeof::<RenderResource>()), sizeof::<RenderResource>() as i64);
        return out;
    }

    public fn dependencyAt(&self, index: i32) -> RenderPassDependency {
        return self.dependencies.get(index as i64);
    }

    public fn dependencyFromPass(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).from_pass;
    }

    public fn dependencyToPass(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).to_pass;
    }

    public fn dependencyResourceIndex(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return -1; }
        return self.dependencies.get(index as i64).resource_index;
    }

    public fn passSegmentCount(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        let pass = self.passes.get(index as i64);
        return pass.segment_count;
    }

    public fn passFirstCommand(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        let pass = self.passes.get(index as i64);
        return pass.first_command;
    }

    public fn passCommandCount(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 8);
    }

    public fn passDrawCount(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 12);
    }

    public fn passClears(&self, index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let pass = self.passes.get(index as i64);
        var flag: i32 = 0;
        memcpy(to_rawptr(&flag), to_rawptr(&pass.clear), 1);
        if (flag != 0) { return true; }
        return false;
    }

    public fn passIsColor(&self, index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 1) { return true; }
        return false;
    }

    public fn passIsLayer(&self, index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 2) { return true; }
        return false;
    }

    public fn passIsComposite(&self, index: i32) -> bool {
        if (index < 0 || index >= self.passes.len as i32) { return false; }
        let kv = planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()));
        if (kv == 3) { return true; }
        return false;
    }

    public fn passTargetId(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.passes.len as i32) { return -1; }
        return planLoadI32(self.passes.data + ((index as i64) * sizeof::<RenderPass>()) + 20);
    }

    public fn resourceIsKind(&self, index: i32, kind: RenderResourceKind) -> bool {
        if (index < 0 || index >= self.resources.len as i32) { return false; }
        let av = planLoadI32(self.resources.data + ((index as i64) * sizeof::<RenderResource>()));
        let bv = planLoadI32(to_rawptr(&kind));
        if (av == bv) {
            return true;
        }
        return false;
    }

    public fn resourceEstimatedBytes(&self, index: i32) -> u64 {
        if (index < 0 || index >= self.resources.len as i32) { return 0 as u64; }
        let resource = self.resources.get(index as i64);
        var bytes: u64 = 0 as u64;
        resource.writeEstimatedBytes(to_rawptr(&bytes));
        return bytes;
    }

    public fn resourceCountByKind(&self, kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var av: i32 = 0;
            var bv: i32 = 0;
            memcpy(to_rawptr(&av), to_rawptr(&resource), sizeof::<i32>() as i64);
            memcpy(to_rawptr(&bv), to_rawptr(&kind), sizeof::<i32>() as i64);
            if (av == bv) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn resourceEstimatedBytesByKind(&self, kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var av: i32 = 0;
            var bv: i32 = 0;
            memcpy(to_rawptr(&av), to_rawptr(&resource), sizeof::<i32>() as i64);
            memcpy(to_rawptr(&bv), to_rawptr(&kind), sizeof::<i32>() as i64);
            if (av == bv) {
                bytes = bytes + resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn totalResourceEstimatedBytes(&self) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            bytes = bytes + resource.estimated_bytes;
            i = i + 1;
        }
        return bytes;
    }

    public fn activeResourceEstimatedBytesAtPass(&self, pass_index: i32) -> u64 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.first_pass <= pass_index && resource.last_pass >= pass_index) {
                bytes = bytes + resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn activeResourceCountAtPass(&self, pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.first_pass <= pass_index && resource.last_pass >= pass_index) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn resourceActiveAtPass(&self, resource_index: i32, pass_index: i32) -> bool {
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return false; }
        let resource = self.resources.get(resource_index as i64);
        return resource.first_pass <= pass_index && resource.last_pass >= pass_index;
    }

    public fn peakResourceEstimatedBytes(&self) -> u64 {
        var peak: u64 = 0 as u64;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let bytes = self.activeResourceEstimatedBytesAtPass(pass_i);
            if (bytes > peak) { peak = bytes; }
            pass_i = pass_i + 1;
        }
        return peak;
    }

    public fn peakResourceCount(&self) -> i32 {
        var peak: i32 = 0;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let count = self.activeResourceCountAtPass(pass_i);
            if (count > peak) { peak = count; }
            pass_i = pass_i + 1;
        }
        return peak;
    }

    public fn peakResourcePass(&self) -> i32 {
        if (self.passes.len as i32 == 0) { return -1; }
        var peak: u64 = 0 as u64;
        var peak_pass: i32 = 0;
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            let bytes = self.activeResourceEstimatedBytesAtPass(pass_i);
            if (pass_i == 0 || bytes > peak) {
                peak = bytes;
                peak_pass = pass_i;
            }
            pass_i = pass_i + 1;
        }
        return peak_pass;
    }

    public fn resourcePageId(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.page_id;
    }

    public fn resourceFirstPass(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.first_pass;
    }

    public fn resourceLastPass(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.resources.len as i32) { return -1; }
        let resource = self.resources.get(index as i64);
        return resource.last_pass;
    }

    public fn resourceLifetimeSpan(&self, index: i32) -> i32 {
        if (!self.resourceLifetimeValid(index)) { return 0; }
        let resource = self.resources.get(index as i64);
        var first: i32 = 0;
        var last: i32 = 0;
        resource.writeFirstPass(to_rawptr(&first));
        resource.writeLastPass(to_rawptr(&last));
        return last - first + 1;
    }

    public fn maxResourceLifetimeSpan(&self) -> i32 {
        var max_span: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let span = self.resourceLifetimeSpan(i);
            if (span > max_span) { max_span = span; }
            i = i + 1;
        }
        return max_span;
    }

    public fn totalResourceLifetimeSpan(&self) -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            total = total + self.resourceLifetimeSpan(i);
            i = i + 1;
        }
        return total;
    }

    public fn estimatedVertexCount(&self) -> i32 {
        return self.estimated_solid_vertices + self.estimated_textured_vertices;
    }

    public fn reservedVertexCount(&self) -> i32 {
        return self.clip_expansion_vertex_reserve + self.layer_composite_vertex_reserve;
    }

    public fn solidVertexCapacityEstimate(&self) -> i32 {
        return self.solid_vertex_capacity_estimate;
    }

    public fn uniquePipelineCount(&self) -> i32 {
        return self.unique_pipeline_count;
    }

    public fn defaultPipelineChangeCount(&self) -> i32 {
        return self.default_pipeline_change_count;
    }

    public fn customPipelineChangeCount(&self) -> i32 {
        return self.custom_pipeline_change_count;
    }

    public fn lastPipelineId(&self) -> i32 {
        return self.last_pipeline_id;
    }

    public fn texturedVertexCapacityEstimate(&self) -> i32 {
        return self.textured_vertex_capacity_estimate;
    }

    public fn requiresLayerTargets(&self) -> bool {
        return self.max_layer_depth > 0;
    }

    public fn requiresClipStencil(&self) -> bool {
        return self.clip_path_count > 0;
    }

    public fn resourceLifetimeValid(&self, index: i32) -> bool {
        if (index < 0 || index >= self.resourceCount()) { return false; }
        let resource = self.resourceAt(index);
        if (resource.first_pass < 0 || resource.last_pass < 0) { return false; }
        if (resource.first_pass > resource.last_pass) { return false; }
        if (resource.last_pass >= self.passCount()) { return false; }
        return true;
    }

    public fn lifetimesValid(&self) -> bool {
        var i: i32 = 0;
        while (i < self.resourceCount()) {
            if (!self.resourceLifetimeValid(i)) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn dependencyValid(&self, index: i32) -> bool {
        if (index < 0 || index >= self.dependencyCount()) { return false; }
        let dependency = self.dependencyAt(index);
        if (dependency.resource_index < 0 || dependency.resource_index >= self.resourceCount()) { return false; }
        if (dependency.from_pass < 0 || dependency.to_pass < 0) { return false; }
        if (dependency.from_pass >= self.passCount() || dependency.to_pass >= self.passCount()) { return false; }
        if (dependency.from_pass > dependency.to_pass) { return false; }
        let resource = self.resourceAt(dependency.resource_index);
        if (dependency.from_pass != resource.first_pass || dependency.to_pass != resource.last_pass) { return false; }
        return true;
    }

    public fn dependenciesValid(&self) -> bool {
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            if (!self.dependencyValid(i)) { return false; }
            i = i + 1;
        }
        if (!self.dependenciesCoverLifetimes()) { return false; }
        return true;
    }

    public fn dependencyCoversResource(&self, resource_index: i32) -> bool {
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        let resource = self.resources.get(resource_index as i64);
        if (resource.first_pass == resource.last_pass) { return true; }
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.resource_index == resource_index
                && dependency.from_pass == resource.first_pass
                && dependency.to_pass == resource.last_pass) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn expectedDependencyCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            if (self.resourceLifetimeValid(i)) {
                let resource = self.resources.get(i as i64);
                if (resource.first_pass < resource.last_pass) {
                    count = count + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn dependencyCoverageCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            if (self.resourceLifetimeValid(i)) {
                let resource = self.resources.get(i as i64);
                if (resource.first_pass < resource.last_pass && self.dependencyCoversResource(i)) {
                    count = count + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn dependenciesCoverLifetimes(&self) -> bool {
        let expected = self.expectedDependencyCount();
        if (self.dependencyCoverageCount() != expected) { return false; }
        if (self.dependencies.len as i32 != expected) { return false; }
        return true;
    }

    public fn passDependencyInCount(&self, pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.to_pass == pass_index) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passDependencyOutCount(&self, pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.from_pass == pass_index) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passHasDependency(&self, from_pass: i32, to_pass: i32) -> bool {
        if (from_pass < 0 || from_pass >= self.passes.len as i32) { return false; }
        if (to_pass < 0 || to_pass >= self.passes.len as i32) { return false; }
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            if (dependency.from_pass == from_pass && dependency.to_pass == to_pass) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn dependencySpan(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.dependencies.len as i32) { return 0; }
        let dependency = self.dependencies.get(index as i64);
        return dependency.to_pass - dependency.from_pass;
    }

    public fn maxDependencySpan(&self) -> i32 {
        var max_span: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let span = self.dependencySpan(i);
            if (span > max_span) { max_span = span; }
            i = i + 1;
        }
        return max_span;
    }

    public fn totalDependencySpan(&self) -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            total = total + self.dependencySpan(i);
            i = i + 1;
        }
        return total;
    }

    public fn uniquePassDependencyPairCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                let previous = self.dependencies.get(j as i64);
                if (previous.from_pass == dependency.from_pass && previous.to_pass == dependency.to_pass) {
                    seen = true;
                }
                j = j + 1;
            }
            if (!seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn duplicatePassDependencyPairCount(&self) -> i32 {
        let unique_count = self.uniquePassDependencyPairCount();
        if (self.dependencies.len as i32 <= unique_count) { return 0; }
        return self.dependencies.len as i32 - unique_count;
    }

    public fn passDependencyPairDensityPermille(&self) -> i32 {
        let possible_pairs = (self.passes.len as i32 * (self.passes.len as i32 - 1)) / 2;
        if (possible_pairs <= 0) { return 0; }
        return ((self.uniquePassDependencyPairCount() as i64) * 1000 / (possible_pairs as i64)) as i32;
    }

    public fn passScheduleLevel(&self, pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passCount()) { return -1; }
        var level: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencyCount()) {
            let dependency = self.dependencyAt(i);
            if (dependency.to_pass == pass_index && dependency.from_pass != pass_index) {
                let from_level = self.passScheduleLevel(dependency.from_pass);
                if (from_level >= 0 && (from_level + 1) > level) {
                    level = from_level + 1;
                }
            }
            i = i + 1;
        }
        return level;
    }

    public fn scheduleLevelCount(&self) -> i32 {
        if (self.passes.len as i32 <= 0) { return 0; }
        var max_level: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            let level = self.passScheduleLevel(i);
            if (level > max_level) { max_level = level; }
            i = i + 1;
        }
        return max_level + 1;
    }

    public fn passCountAtScheduleLevel(&self, level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn scheduledPassAt(&self, level: i32, slot: i32) -> i32 {
        if (level < 0 || slot < 0) { return -1; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) {
                if (count == slot) { return i; }
                count = count + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn scheduledPassSlot(&self, pass_index: i32) -> i32 {
        if (pass_index < 0 || pass_index >= self.passes.len as i32) { return -1; }
        let level = self.passScheduleLevel(pass_index);
        if (level < 0) { return -1; }
        var slot: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passScheduleLevel(i) == level) {
                if (i == pass_index) { return slot; }
                slot = slot + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn resourceIntersectsScheduleLevel(&self, resource_index: i32, level: i32) -> bool {
        if (level < 0) { return false; }
        if (!self.resourceLifetimeValid(resource_index)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < self.passes.len as i32) {
            if (self.passScheduleLevel(pass_i) == level && self.resourceActiveAtPass(resource_index, pass_i)) {
                return true;
            }
            pass_i = pass_i + 1;
        }
        return false;
    }

    public fn scheduleLevelActiveResourceCount(&self, level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var resource_i: i32 = 0;
        while (resource_i < self.resources.len as i32) {
            if (self.resourceIntersectsScheduleLevel(resource_i, level)) {
                count = count + 1;
            }
            resource_i = resource_i + 1;
        }
        return count;
    }

    public fn scheduleLevelActiveResourceEstimatedBytes(&self, level: i32) -> u64 {
        if (level < 0) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var resource_i: i32 = 0;
        while (resource_i < self.resources.len as i32) {
            if (self.resourceIntersectsScheduleLevel(resource_i, level)) {
                bytes = bytes + self.resources.get(resource_i as i64).estimated_bytes;
            }
            resource_i = resource_i + 1;
        }
        return bytes;
    }

    public fn maxScheduleLevelActiveResourceCount(&self) -> i32 {
        var peak: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let count = self.scheduleLevelActiveResourceCount(level);
            if (count > peak) { peak = count; }
            level = level + 1;
        }
        return peak;
    }

    public fn maxScheduleLevelActiveResourceEstimatedBytes(&self) -> u64 {
        var peak: u64 = 0 as u64;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let bytes = self.scheduleLevelActiveResourceEstimatedBytes(level);
            if (bytes > peak) { peak = bytes; }
            level = level + 1;
        }
        return peak;
    }

    public fn scheduleLevelDependencyInCount(&self, level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (to_level == level && from_level != to_level) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn scheduleLevelDependencyOutCount(&self, level: i32) -> i32 {
        if (level < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (from_level == level && from_level != to_level) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn scheduleOrderValid(&self) -> bool {
        var i: i32 = 0;
        while (i < self.dependencies.len as i32) {
            let dependency = self.dependencies.get(i as i64);
            let from_level = self.passScheduleLevel(dependency.from_pass);
            let to_level = self.passScheduleLevel(dependency.to_pass);
            if (from_level < 0 || to_level < 0) { return false; }
            if (dependency.from_pass != dependency.to_pass && from_level >= to_level) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn maxScheduleWidth(&self) -> i32 {
        var max_width: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            let width = self.passCountAtScheduleLevel(level);
            if (width > max_width) { max_width = width; }
            level = level + 1;
        }
        return max_width;
    }

    public fn scheduleSlotCount(&self) -> i32 {
        return self.scheduleLevelCount() * self.maxScheduleWidth();
    }

    public fn scheduleSlackPassCount(&self) -> i32 {
        let slots = self.scheduleSlotCount();
        if (slots <= self.passes.len as i32) { return 0; }
        return slots - self.passes.len as i32;
    }

    public fn serialScheduleLevelCount(&self) -> i32 {
        var count: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            if (self.passCountAtScheduleLevel(level) == 1) { count = count + 1; }
            level = level + 1;
        }
        return count;
    }

    public fn parallelScheduleLevelCount(&self) -> i32 {
        var count: i32 = 0;
        var level: i32 = 0;
        let levels = self.scheduleLevelCount();
        while (level < levels) {
            if (self.passCountAtScheduleLevel(level) > 1) { count = count + 1; }
            level = level + 1;
        }
        return count;
    }

    public fn scheduleUtilizationPermille(&self) -> i32 {
        let slots = self.scheduleSlotCount();
        if (slots <= 0) { return 0; }
        return ((self.passes.len as i32 as i64) * 1000 / (slots as i64)) as i32;
    }

    public fn criticalPathPassCount(&self) -> i32 {
        return self.scheduleLevelCount();
    }

    public fn physicalResourceCountByKind(&self, kind: RenderResourceKind) -> i32 {
        var pages = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.kind.equals(kind)) {
                var seen = false;
                var page_i: i32 = 0;
                while (page_i < (pages.len as i32)) {
                    if (pages.get(page_i as i64) == resource.page_id) {
                        seen = true;
                    }
                    page_i = page_i + 1;
                }
                if (!seen) {
                    pages.push(resource.page_id);
                }
            }
            i = i + 1;
        }
        let count = pages.len as i32;
        pages.destroy();
        return count;
    }

    public fn physicalResourceCount(&self) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            count = count + self.physicalResourceCountByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn physicalResourceEstimatedBytesByKind(&self, kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            if (resource.kind.equals(kind)) {
                var seen_page = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen = self.resources.get(seen_i as i64);
                    if (seen.kind.equals(kind) && seen.page_id == resource.page_id) {
                        seen_page = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen_page) {
                    var page_bytes = resource.estimated_bytes;
                    var scan_i: i32 = i + 1;
                    while (scan_i < self.resources.len as i32) {
                        let scan = self.resources.get(scan_i as i64);
                        if (scan.kind.equals(kind) && scan.page_id == resource.page_id && scan.estimated_bytes > page_bytes) {
                            page_bytes = scan.estimated_bytes;
                        }
                        scan_i = scan_i + 1;
                    }
                    bytes = bytes + page_bytes;
                }
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn physicalResourceEstimatedBytes(&self) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let resource = self.resources.get(i as i64);
            var seen_page = false;
            var seen_i: i32 = 0;
            while (seen_i < i) {
                let seen = self.resources.get(seen_i as i64);
                if (seen.kind.equals(resource.kind) && seen.page_id == resource.page_id) {
                    seen_page = true;
                }
                seen_i = seen_i + 1;
            }
            if (!seen_page) {
                var page_bytes = resource.estimated_bytes;
                var scan_i: i32 = i + 1;
                while (scan_i < self.resources.len as i32) {
                    let scan = self.resources.get(scan_i as i64);
                    if (scan.kind.equals(resource.kind) && scan.page_id == resource.page_id && scan.estimated_bytes > page_bytes) {
                        page_bytes = scan.estimated_bytes;
                    }
                    scan_i = scan_i + 1;
                }
                bytes = bytes + page_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    public fn minimumPhysicalResourceCount(&self) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            count = count + self.minimumPhysicalResourceCountByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn minimumPhysicalResourceEstimatedBytes(&self) -> u64 {
        var bytes: u64 = 0 as u64;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            bytes = bytes + self.minimumPhysicalResourceEstimatedBytesByKind(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return bytes;
    }

    public fn minimumPhysicalResourceCountByKind(&self, kind: RenderResourceKind) -> i32 {
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(0);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) == 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                }
                assigned.set(best_index as i64, 1);
            }
        }
        let count = page_last_pass.len as i32;
        page_last_pass.destroy();
        assigned.destroy();
        return count;
    }

    public fn minimumPhysicalResourceEstimatedBytesByKind(&self, kind: RenderResourceKind) -> u64 {
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(0);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var page_bytes = Vec::<u64>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) == 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        if (resource.estimated_bytes > page_bytes.get(page_i as i64)) {
                            page_bytes.set(page_i as i64, resource.estimated_bytes);
                        }
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                    page_bytes.push(resource.estimated_bytes);
                }
                assigned.set(best_index as i64, 1);
            }
        }
        var bytes: u64 = 0 as u64;
        i = 0;
        while (i < (page_bytes.len as i32)) {
            bytes = bytes + page_bytes.get(i as i64);
            i = i + 1;
        }
        page_bytes.destroy();
        page_last_pass.destroy();
        assigned.destroy();
        return bytes;
    }

    public fn resourceReuseOpportunityCountByKind(&self, kind: RenderResourceKind) -> i32 {
        let physical = self.physicalResourceCountByKind(kind);
        let minimum = self.minimumPhysicalResourceCountByKind(kind);
        if (physical <= minimum) { return 0; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityCount(&self) -> i32 {
        let physical = self.physicalResourceCount();
        let minimum = self.minimumPhysicalResourceCount();
        if (physical <= minimum) { return 0; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityBytesByKind(&self, kind: RenderResourceKind) -> u64 {
        let physical = self.physicalResourceEstimatedBytesByKind(kind);
        let minimum = self.minimumPhysicalResourceEstimatedBytesByKind(kind);
        if (physical <= minimum) { return 0 as u64; }
        return physical - minimum;
    }

    public fn resourceReuseOpportunityBytes(&self) -> u64 {
        let physical = self.physicalResourceEstimatedBytes();
        let minimum = self.minimumPhysicalResourceEstimatedBytes();
        if (physical <= minimum) { return 0 as u64; }
        return physical - minimum;
    }

    public fn layerTargetPhysicalCount(&self) -> i32 {
        return self.physicalResourceCountByKind(RenderResourceKind.layerColorTarget());
    }

    public fn layerTargetReuseCount(&self) -> i32 {
        let physical = self.layerTargetPhysicalCount();
        if (self.layer_pass_count <= physical) { return 0; }
        return self.layer_pass_count - physical;
    }

    public fn resourceLifetimesOverlap(&self, a: i32, b: i32) -> bool {
        if (!self.resourceLifetimeValid(a) || !self.resourceLifetimeValid(b)) { return false; }
        let left = self.resources.get(a as i64);
        let right = self.resources.get(b as i64);
        if (left.last_pass < right.first_pass) { return false; }
        if (right.last_pass < left.first_pass) { return false; }
        return true;
    }

    public fn resourceCanAlias(&self, a: i32, b: i32) -> bool {
        if (a == b) { return false; }
        if (!self.resourceLifetimeValid(a) || !self.resourceLifetimeValid(b)) { return false; }
        let left = self.resources.get(a as i64);
        let right = self.resources.get(b as i64);
        if (!left.kind.equals(right.kind)) { return false; }
        return !self.resourceLifetimesOverlap(a, b);
    }

    public fn plannedPhysicalResourcePage(&self, resource_index: i32) -> i32 {
        if (!self.resourceLifetimeValid(resource_index)) { return -1; }
        let target = self.resources.get(resource_index as i64);
        var assigned = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            assigned.push(-1);
            i = i + 1;
        }
        var page_last_pass = Vec::<i32>.new();
        var done = false;
        while (!done) {
            var best_index: i32 = -1;
            var best_first: i32 = 0;
            i = 0;
            while (i < self.resources.len as i32) {
                if (assigned.get(i as i64) < 0 && self.resourceLifetimeValid(i)) {
                    let resource = self.resources.get(i as i64);
                    if (resource.kind.equals(target.kind) && (best_index < 0 || resource.first_pass < best_first)) {
                        best_index = i;
                        best_first = resource.first_pass;
                    }
                }
                i = i + 1;
            }
            if (best_index < 0) {
                done = true;
            } else {
                let resource = self.resources.get(best_index as i64);
                var placed = false;
                var page_i: i32 = 0;
                while (page_i < (page_last_pass.len as i32)) {
                    if (!placed && page_last_pass.get(page_i as i64) < resource.first_pass) {
                        page_last_pass.set(page_i as i64, resource.last_pass);
                        assigned.set(best_index as i64, page_i);
                        placed = true;
                    }
                    page_i = page_i + 1;
                }
                if (!placed) {
                    page_last_pass.push(resource.last_pass);
                    assigned.set(best_index as i64, (page_last_pass.len as i32) - 1);
                }
                if (best_index == resource_index) {
                    let page = assigned.get(best_index as i64);
                    page_last_pass.destroy();
                    assigned.destroy();
                    return page;
                }
            }
        }
        page_last_pass.destroy();
        assigned.destroy();
        return -1;
    }

    public fn resourcesSharePlannedPhysicalPage(&self, a: i32, b: i32) -> bool {
        if (!self.resourceCanAlias(a, b)) { return false; }
        return self.plannedPhysicalResourcePage(a) == self.plannedPhysicalResourcePage(b);
    }

    public fn aliasableResourcePairCount(&self, kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.resources.len as i32) {
            let left = self.resources.get(i as i64);
            if (left.kind.equals(kind)) {
                var j: i32 = i + 1;
                while (j < self.resources.len as i32) {
                    let right = self.resources.get(j as i64);
                    if (right.kind.equals(kind) && self.resourceCanAlias(i, j)) {
                        count = count + 1;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn totalAliasableResourcePairCount(&self) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            count = count + self.aliasableResourcePairCount(RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    public fn passCanMerge(&self, a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.passes.len as i32 || b >= self.passes.len as i32) { return false; }
        if (a == b) { return false; }
        let left = self.passAt(a);
        let right = self.passAt(b);
        if (!left.kind.equals(right.kind)) { return false; }
        if (left.target_id != right.target_id) { return false; }
        if (left.clear || right.clear) { return false; }
        if (self.passHasDependency(a, b) || self.passHasDependency(b, a)) { return false; }
        if (left.first_command + left.command_count == right.first_command) { return true; }
        if (right.first_command + right.command_count == left.first_command) { return true; }
        return false;
    }

    public fn mergeCandidatePairCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            var j: i32 = i + 1;
            while (j < self.passes.len as i32) {
                if (self.passCanMerge(i, j)) { count = count + 1; }
                j = j + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn adjacentMergeCandidateCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while ((i + 1) < self.passes.len as i32) {
            if (self.passCanMerge(i, i + 1)) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn passCanMergeWithPrevious(&self, pass_index: i32) -> bool {
        if (pass_index <= 0 || pass_index >= self.passes.len as i32) { return false; }
        return self.passCanMerge(pass_index - 1, pass_index);
    }

    public fn passCanMergeWithNext(&self, pass_index: i32) -> bool {
        if (pass_index < 0 || (pass_index + 1) >= self.passes.len as i32) { return false; }
        return self.passCanMerge(pass_index, pass_index + 1);
    }

    public fn adjacentMergeablePassCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithPrevious(i) || self.passCanMergeWithNext(i)) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn mergeRunCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                count = count + 1;
                while (self.passCanMergeWithNext(i)) {
                    i = i + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    public fn longestMergeRunLength(&self) -> i32 {
        var best: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                var len: i32 = 1;
                while (self.passCanMergeWithNext(i)) {
                    len = len + 1;
                    i = i + 1;
                }
                if (len > best) { best = len; }
            }
            i = i + 1;
        }
        return best;
    }

    public fn mergeCompressionOpportunityCount(&self) -> i32 {
        var total: i32 = 0;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            if (self.passCanMergeWithNext(i)) {
                var len: i32 = 1;
                while (self.passCanMergeWithNext(i)) {
                    len = len + 1;
                    i = i + 1;
                }
                total = total + len - 1;
            }
            i = i + 1;
        }
        return total;
    }

    public fn passOrderValid(&self) -> bool {
        if (self.passes.len as i32 <= 0) { return true; }
        var seen_color = false;
        var i: i32 = 0;
        while (i < self.passes.len as i32) {
            let pass = self.passAt(i);
            if (pass.kind.equals(RenderPassKind.color())) {
                if (i != self.passes.len as i32 - 1) { return false; }
                seen_color = true;
            } else {
                if (seen_color) { return false; }
            }
            if (pass.kind.equals(RenderPassKind.composite())) {
                var has_prior_layer = false;
                var prior_i: i32 = 0;
                while (prior_i < i) {
                    let prior = self.passAt(prior_i);
                    if (prior.kind.equals(RenderPassKind.layer()) && prior.target_id == pass.target_id) {
                        has_prior_layer = true;
                    }
                    prior_i = prior_i + 1;
                }
                if (!has_prior_layer) { return false; }
            }
            i = i + 1;
        }
        var dep_i: i32 = 0;
        while (dep_i < self.dependencies.len as i32) {
            let dependency = self.dependencyAt(dep_i);
            if (dependency.from_pass > dependency.to_pass) { return false; }
            dep_i = dep_i + 1;
        }
        return true;
    }

    public fn destroy(&mut self) {
        self.passes.destroy();
        self.resources.destroy();
        self.dependencies.destroy();
        self.command_count = 0;
        self.draw_count = 0;
        self.solid_draw_count = 0;
        self.textured_draw_count = 0;
        self.segment_count = 0;
        self.solid_segment_count = 0;
        self.textured_segment_count = 0;
        self.texture_page_count = 0;
        self.clip_change_count = 0;
        self.clip_path_count = 0;
        self.clip_path_cpu_coverage_count = 0;
        self.clip_path_bounds_fallback_count = 0;
        self.transform_change_count = 0;
        self.pipeline_change_count = 0;
        self.default_pipeline_change_count = 0;
        self.custom_pipeline_change_count = 0;
        self.unique_pipeline_count = 0;
        self.last_pipeline_id = -1;
        self.layer_change_count = 0;
        self.layer_pass_count = 0;
        self.max_layer_depth = 0;
        self.estimated_solid_vertices = 0;
        self.estimated_textured_vertices = 0;
        self.clip_expansion_vertex_reserve = 0;
        self.clip_mask_vertex_capacity_estimate = 0;
        self.clip_stencil_target_bytes_estimate = 0 as u64;
        self.layer_composite_vertex_reserve = 0;
        self.solid_vertex_capacity_estimate = 0;
        self.textured_vertex_capacity_estimate = 0;
        self.has_clear = false;
    }
}

public class RenderExecutionPlan {
    public scheduled_passes: Vec<i32>;
    public scheduled_levels: Vec<i32>;
    public scheduled_slots: Vec<i32>;
    public resource_physical_pages: Vec<i32>;
    public merge_run_first_passes: Vec<i32>;
    public merge_run_lengths: Vec<i32>;
    public pass_binding_first_indices: Vec<i32>;
    public pass_binding_counts: Vec<i32>;
    public pass_merge_run_indices: Vec<i32>;
    public binding_pass_indices: Vec<i32>;
    public binding_logical_resources: Vec<i32>;
    public binding_physical_pages: Vec<i32>;
    public binding_estimated_bytes: Vec<u64>;

    public static fn empty() -> RenderExecutionPlan {
        return RenderExecutionPlan {
            scheduled_passes: Vec::<i32>.new(),
            scheduled_levels: Vec::<i32>.new(),
            scheduled_slots: Vec::<i32>.new(),
            resource_physical_pages: Vec::<i32>.new(),
            merge_run_first_passes: Vec::<i32>.new(),
            merge_run_lengths: Vec::<i32>.new(),
            pass_binding_first_indices: Vec::<i32>.new(),
            pass_binding_counts: Vec::<i32>.new(),
            pass_merge_run_indices: Vec::<i32>.new(),
            binding_pass_indices: Vec::<i32>.new(),
            binding_logical_resources: Vec::<i32>.new(),
            binding_physical_pages: Vec::<i32>.new(),
            binding_estimated_bytes: Vec::<u64>.new()
        };
    }

    @[borrow_args]
    public static fn build(plan: RenderPlan) -> RenderExecutionPlan {
        var out = RenderExecutionPlan.empty();
        var level: i32 = 0;
        let level_count = plan.scheduleLevelCount();
        while (level < level_count) {
            var slot: i32 = 0;
            let pass_count = plan.passCountAtScheduleLevel(level);
            while (slot < pass_count) {
                let pass_index = plan.scheduledPassAt(level, slot);
                if (pass_index >= 0) {
                    out.scheduled_passes.push(pass_index);
                    out.scheduled_levels.push(level);
                    out.scheduled_slots.push(slot);
                }
                slot = slot + 1;
            }
            level = level + 1;
        }

        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            out.resource_physical_pages.push(plan.plannedPhysicalResourcePage(resource_i));
            resource_i = resource_i + 1;
        }

        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            if (plan.passCanMergeWithNext(pass_i)) {
                let first_pass = pass_i;
                var run_length: i32 = 1;
                while (plan.passCanMergeWithNext(pass_i)) {
                    run_length = run_length + 1;
                    pass_i = pass_i + 1;
                }
                out.merge_run_first_passes.push(first_pass);
                out.merge_run_lengths.push(run_length);
            }
            pass_i = pass_i + 1;
        }

        var scheduled_i: i32 = 0;
        while (scheduled_i < out.scheduledPassCount()) {
            let pass_index = out.scheduledPassAt(scheduled_i);
            out.pass_binding_first_indices.push(out.binding_logical_resources.len as i32);
            var binding_count: i32 = 0;
            resource_i = 0;
            while (resource_i < plan.resources.len as i32) {
                if (plan.resourceActiveAtPass(resource_i, pass_index)) {
                    out.binding_pass_indices.push(pass_index);
                    out.binding_logical_resources.push(resource_i);
                    out.binding_physical_pages.push(out.logicalResourcePhysicalPage(resource_i));
                    out.binding_estimated_bytes.push(plan.resourceEstimatedBytes(resource_i));
                    binding_count = binding_count + 1;
                }
                resource_i = resource_i + 1;
            }
            out.pass_binding_counts.push(binding_count);
            out.pass_merge_run_indices.push(out.mergeRunIndexForPass(pass_index));
            scheduled_i = scheduled_i + 1;
        }
        return out;
    }

    public fn scheduledPassCount(&self) -> i32 {
        return self.scheduled_passes.len as i32;
    }

    public fn scheduledPassAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_passes.get(index as i64);
    }

    public fn scheduledPassLevelAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_levels.get(index as i64);
    }

    public fn scheduledPassSlotAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.scheduledPassCount()) { return -1; }
        return self.scheduled_slots.get(index as i64);
    }

    public fn scheduledOrderIndex(&self, pass_index: i32) -> i32 {
        var i: i32 = 0;
        while (i < self.scheduledPassCount()) {
            if (self.scheduled_passes.get(i as i64) == pass_index) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn logicalResourceCount(&self) -> i32 {
        return self.resource_physical_pages.len as i32;
    }

    public fn logicalResourcePhysicalPage(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.logicalResourceCount()) { return -1; }
        return self.resource_physical_pages.get(index as i64);
    }

    public fn logicalResourcesSharePhysicalPage(&self, a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.logicalResourceCount() || b >= self.logicalResourceCount()) { return false; }
        if (a == b) { return false; }
        let left = self.logicalResourcePhysicalPage(a);
        let right = self.logicalResourcePhysicalPage(b);
        return left >= 0 && left == right;
    }

    @[borrow_args]
    public fn logicalResourcesSharePhysicalPageForPlan(&self, plan: RenderPlan, a: i32, b: i32) -> bool {
        if (a < 0 || b < 0 || a >= self.logicalResourceCount() || b >= self.logicalResourceCount()) { return false; }
        if (a >= plan.resources.len as i32 || b >= plan.resources.len as i32) { return false; }
        if (!plan.resourceAt(a).kind.equals(plan.resourceAt(b).kind)) { return false; }
        return self.logicalResourcesSharePhysicalPage(a, b);
    }

    @[borrow_args]
    public fn physicalResourceCountForPlan(&self, plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            count = count + self.physicalResourceCountByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalResourceCountByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind) -> i32 {
        var pages = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind)) {
                let physical_page = self.logicalResourcePhysicalPage(i);
                var seen = false;
                var page_i: i32 = 0;
                while (page_i < (pages.len as i32)) {
                    if (pages.get(page_i as i64) == physical_page) { seen = true; }
                    page_i = page_i + 1;
                }
                if (!seen && physical_page >= 0) { pages.push(physical_page); }
            }
            i = i + 1;
        }
        let count = pages.len as i32;
        pages.destroy();
        return count;
    }

    @[borrow_args]
    public fn physicalResourceEstimatedBytesForPlan(&self, plan: RenderPlan) -> u64 {
        var bytes: u64 = 0 as u64;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            bytes = bytes + self.physicalResourceEstimatedBytesByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn physicalResourceEstimatedBytesByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind) -> u64 {
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind)) {
                let physical_page = self.logicalResourcePhysicalPage(i);
                var seen = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen_resource = plan.resourceAt(seen_i);
                    if (seen_resource.kind.equals(kind) && self.logicalResourcePhysicalPage(seen_i) == physical_page) {
                        seen = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen && physical_page >= 0) {
                    var page_bytes = resource.estimated_bytes;
                    var scan_i = i + 1;
                    while (scan_i < plan.resources.len as i32 && scan_i < self.logicalResourceCount()) {
                        let scan = plan.resourceAt(scan_i);
                        if (scan.kind.equals(kind) && self.logicalResourcePhysicalPage(scan_i) == physical_page && scan.estimated_bytes > page_bytes) {
                            page_bytes = scan.estimated_bytes;
                        }
                        scan_i = scan_i + 1;
                    }
                    bytes = bytes + page_bytes;
                }
            }
            i = i + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn physicalPageLogicalResourceCountByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalPageFirstPassByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return -1; }
        var first: i32 = -1;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && plan.resourceLifetimeValid(i)) {
                if (first < 0 || resource.first_pass < first) {
                    first = resource.first_pass;
                }
            }
            i = i + 1;
        }
        return first;
    }

    @[borrow_args]
    public fn physicalPageLastPassByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> i32 {
        if (physical_page < 0) { return -1; }
        var last: i32 = -1;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && plan.resourceLifetimeValid(i)) {
                if (resource.last_pass > last) {
                    last = resource.last_pass;
                }
            }
            i = i + 1;
        }
        return last;
    }

    @[borrow_args]
    public fn physicalPageEstimatedBytesByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> u64 {
        if (physical_page < 0) { return 0 as u64; }
        var bytes: u64 = 0 as u64;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            if (resource.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page && resource.estimated_bytes > bytes) {
                bytes = resource.estimated_bytes;
            }
            i = i + 1;
        }
        return bytes;
    }

    @[borrow_args]
    public fn resourceAliasSetSizeForPlan(&self, plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return 0; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageLogicalResourceCountByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetFirstPassForPlan(&self, plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return -1; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageFirstPassByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetLastPassForPlan(&self, plan: RenderPlan, resource_index: i32) -> i32 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return -1; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageLastPassByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn resourceAliasSetEstimatedBytesForPlan(&self, plan: RenderPlan, resource_index: i32) -> u64 {
        if (resource_index < 0 || resource_index >= plan.resources.len as i32 || resource_index >= self.logicalResourceCount()) { return 0 as u64; }
        let resource = plan.resourceAt(resource_index);
        return self.physicalPageEstimatedBytesByKindForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_index));
    }

    @[borrow_args]
    public fn logicalResourceIsAliasedForPlan(&self, plan: RenderPlan, resource_index: i32) -> bool {
        return self.resourceAliasSetSizeForPlan(plan, resource_index) > 1;
    }

    @[borrow_args]
    public fn aliasedLogicalResourceCountForPlan(&self, plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            if (self.logicalResourceIsAliasedForPlan(plan, i)) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn aliasGroupCountByKindForPlan(&self, plan: RenderPlan, kind: RenderResourceKind) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let resource = plan.resourceAt(i);
            let physical_page = self.logicalResourcePhysicalPage(i);
            if (resource.kind.equals(kind) && physical_page >= 0 && self.physicalPageLogicalResourceCountByKindForPlan(plan, kind, physical_page) > 1) {
                var seen = false;
                var seen_i: i32 = 0;
                while (seen_i < i) {
                    let seen_resource = plan.resourceAt(seen_i);
                    if (seen_resource.kind.equals(kind) && self.logicalResourcePhysicalPage(seen_i) == physical_page) {
                        seen = true;
                    }
                    seen_i = seen_i + 1;
                }
                if (!seen) { count = count + 1; }
            }
            i = i + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn aliasGroupCountForPlan(&self, plan: RenderPlan) -> i32 {
        var count: i32 = 0;
        var kind_value: i32 = 1;
        while (kind_value <= 8) {
            count = count + self.aliasGroupCountByKindForPlan(plan, RenderResourceKind.fromValue(kind_value));
            kind_value = kind_value + 1;
        }
        return count;
    }

    @[borrow_args]
    public fn physicalResourceSavingsBytesForPlan(&self, plan: RenderPlan) -> u64 {
        let logical = plan.totalResourceEstimatedBytes();
        let physical = self.physicalResourceEstimatedBytesForPlan(plan);
        if (logical <= physical) { return 0 as u64; }
        return logical - physical;
    }

    @[borrow_args]
    public fn physicalResourceSavingsPermilleForPlan(&self, plan: RenderPlan) -> i32 {
        let logical = plan.totalResourceEstimatedBytes();
        if (logical == 0 as u64) { return 0; }
        return ((self.physicalResourceSavingsBytesForPlan(plan) * (1000 as u64)) / logical) as i32;
    }

    public fn mergeRunCount(&self) -> i32 {
        return self.merge_run_first_passes.len as i32;
    }

    public fn mergeRunFirstPass(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.mergeRunCount()) { return -1; }
        return self.merge_run_first_passes.get(index as i64);
    }

    public fn mergeRunLength(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.mergeRunCount()) { return 0; }
        return self.merge_run_lengths.get(index as i64);
    }

    public fn mergeRunLastPass(&self, index: i32) -> i32 {
        let first = self.mergeRunFirstPass(index);
        let length = self.mergeRunLength(index);
        if (first < 0 || length <= 0) { return -1; }
        return first + length - 1;
    }

    public fn mergeRunIndexForPass(&self, pass_index: i32) -> i32 {
        if (pass_index < 0) { return -1; }
        var i: i32 = 0;
        while (i < self.mergeRunCount()) {
            if (pass_index >= self.mergeRunFirstPass(i) && pass_index <= self.mergeRunLastPass(i)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn compiledBindingCount(&self) -> i32 {
        return self.binding_logical_resources.len as i32;
    }

    public fn scheduledPassBindingFirstIndex(&self, order_index: i32) -> i32 {
        if (order_index < 0 || order_index >= self.scheduledPassCount()) { return -1; }
        return self.pass_binding_first_indices.get(order_index as i64);
    }

    public fn scheduledPassBindingCount(&self, order_index: i32) -> i32 {
        if (order_index < 0 || order_index >= self.scheduledPassCount()) { return 0; }
        return self.pass_binding_counts.get(order_index as i64);
    }

    public fn passBindingCount(&self, pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return 0; }
        return self.scheduledPassBindingCount(order_index);
    }

    public fn passBindingFirstIndex(&self, pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return -1; }
        return self.scheduledPassBindingFirstIndex(order_index);
    }

    public fn passMergeRunIndex(&self, pass_index: i32) -> i32 {
        let order_index = self.scheduledOrderIndex(pass_index);
        if (order_index < 0) { return -1; }
        return self.pass_merge_run_indices.get(order_index as i64);
    }

    public fn bindingPassIndex(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_pass_indices.get(index as i64);
    }

    public fn bindingLogicalResource(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_logical_resources.get(index as i64);
    }

    public fn bindingPhysicalPage(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.compiledBindingCount()) { return -1; }
        return self.binding_physical_pages.get(index as i64);
    }

    public fn bindingEstimatedBytes(&self, index: i32) -> u64 {
        if (index < 0 || index >= self.compiledBindingCount()) { return 0 as u64; }
        return self.binding_estimated_bytes.get(index as i64);
    }

    public fn passBindingLogicalResourceAt(&self, pass_index: i32, slot: i32) -> i32 {
        if (slot < 0) { return -1; }
        let first = self.passBindingFirstIndex(pass_index);
        if (first < 0 || slot >= self.passBindingCount(pass_index)) { return -1; }
        return self.bindingLogicalResource(first + slot);
    }

    public fn passBindingPhysicalPageAt(&self, pass_index: i32, slot: i32) -> i32 {
        if (slot < 0) { return -1; }
        let first = self.passBindingFirstIndex(pass_index);
        if (first < 0 || slot >= self.passBindingCount(pass_index)) { return -1; }
        return self.bindingPhysicalPage(first + slot);
    }

    @[borrow_args]
    public fn compiledBindingsValidForPlan(&self, plan: RenderPlan) -> bool {
        if (self.scheduledPassCount() != self.pass_binding_first_indices.len as i32) { return false; }
        if (self.scheduledPassCount() != self.pass_binding_counts.len as i32) { return false; }
        if (self.scheduledPassCount() != self.pass_merge_run_indices.len as i32) { return false; }
        if (self.binding_pass_indices.len != self.binding_logical_resources.len) { return false; }
        if (self.binding_pass_indices.len != self.binding_physical_pages.len) { return false; }
        if (self.binding_pass_indices.len != self.binding_estimated_bytes.len) { return false; }
        var order_i: i32 = 0;
        while (order_i < self.scheduledPassCount()) {
            let pass_index = self.scheduledPassAt(order_i);
            let first = self.scheduledPassBindingFirstIndex(order_i);
            let count = self.scheduledPassBindingCount(order_i);
            if (first < 0 || count < 0 || first + count > self.compiledBindingCount()) { return false; }
            if (count != plan.activeResourceCountAtPass(pass_index)) { return false; }
            var slot: i32 = 0;
            while (slot < count) {
                let binding_index = first + slot;
                let resource_index = self.bindingLogicalResource(binding_index);
                if (self.bindingPassIndex(binding_index) != pass_index) { return false; }
                if (resource_index < 0 || resource_index >= plan.resources.len as i32) { return false; }
                if (!plan.resourceActiveAtPass(resource_index, pass_index)) { return false; }
                if (self.bindingPhysicalPage(binding_index) != self.logicalResourcePhysicalPage(resource_index)) { return false; }
                if (self.bindingEstimatedBytes(binding_index) != plan.resourceEstimatedBytes(resource_index)) { return false; }
                slot = slot + 1;
            }
            order_i = order_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn physicalPageHasLifetimeConflictForPlan(&self, plan: RenderPlan, kind: RenderResourceKind, physical_page: i32) -> bool {
        if (physical_page < 0) { return true; }
        var i: i32 = 0;
        while (i < plan.resources.len as i32 && i < self.logicalResourceCount()) {
            let left = plan.resourceAt(i);
            if (left.kind.equals(kind) && self.logicalResourcePhysicalPage(i) == physical_page) {
                var j: i32 = i + 1;
                while (j < plan.resources.len as i32 && j < self.logicalResourceCount()) {
                    let right = plan.resourceAt(j);
                    if (right.kind.equals(kind) && self.logicalResourcePhysicalPage(j) == physical_page && plan.resourceLifetimesOverlap(i, j)) {
                        return true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    @[borrow_args]
    public fn allocatorValidForPlan(&self, plan: RenderPlan) -> bool {
        if (self.logicalResourceCount() != plan.resources.len as i32) { return false; }
        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            if (!plan.resourceLifetimeValid(resource_i)) { return false; }
            if (self.logicalResourcePhysicalPage(resource_i) < 0) { return false; }
            let resource = plan.resourceAt(resource_i);
            if (self.physicalPageHasLifetimeConflictForPlan(plan, resource.kind, self.logicalResourcePhysicalPage(resource_i))) {
                return false;
            }
            resource_i = resource_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn passCompilerValidForPlan(&self, plan: RenderPlan) -> bool {
        if (!self.compiledBindingsValidForPlan(plan)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            if (self.scheduledOrderIndex(pass_i) < 0) { return false; }
            if (self.passMergeRunIndex(pass_i) != self.mergeRunIndexForPass(pass_i)) { return false; }
            pass_i = pass_i + 1;
        }
        return true;
    }

    @[borrow_args]
    public fn isValidFor(&self, plan: RenderPlan) -> bool {
        if (self.scheduledPassCount() != plan.passes.len as i32) { return false; }
        if (self.logicalResourceCount() != plan.resources.len as i32) { return false; }
        if (self.mergeRunCount() != plan.mergeRunCount()) { return false; }
        if (!self.allocatorValidForPlan(plan)) { return false; }
        if (!self.passCompilerValidForPlan(plan)) { return false; }
        var pass_i: i32 = 0;
        while (pass_i < plan.passes.len as i32) {
            let order_index = self.scheduledOrderIndex(pass_i);
            if (order_index < 0) { return false; }
            if (self.scheduledPassLevelAt(order_index) != plan.passScheduleLevel(pass_i)) { return false; }
            if (self.scheduledPassSlotAt(order_index) != plan.scheduledPassSlot(pass_i)) { return false; }
            pass_i = pass_i + 1;
        }
        var resource_i: i32 = 0;
        while (resource_i < plan.resources.len as i32) {
            if (self.logicalResourcePhysicalPage(resource_i) != plan.plannedPhysicalResourcePage(resource_i)) { return false; }
            resource_i = resource_i + 1;
        }
        var run_i: i32 = 0;
        while (run_i < self.mergeRunCount()) {
            if (self.mergeRunLength(run_i) <= 1) { return false; }
            if (!plan.passCanMergeWithNext(self.mergeRunFirstPass(run_i))) { return false; }
            run_i = run_i + 1;
        }
        return true;
    }

    public fn destroy(&mut self) {
        self.scheduled_passes.destroy();
        self.scheduled_levels.destroy();
        self.scheduled_slots.destroy();
        self.resource_physical_pages.destroy();
        self.merge_run_first_passes.destroy();
        self.merge_run_lengths.destroy();
        self.pass_binding_first_indices.destroy();
        self.pass_binding_counts.destroy();
        self.pass_merge_run_indices.destroy();
        self.binding_pass_indices.destroy();
        self.binding_logical_resources.destroy();
        self.binding_physical_pages.destroy();
        self.binding_estimated_bytes.destroy();
    }
}
