module Zyn.Nut.Canvas;

use Zyn.Nut.Types;
use Zyn.Nut.RenderGraph;
use Path = Zyn.Nut.Path.Path;
use Atlas = Zyn.Nut.Atlas.Atlas;
use AtlasRegion = Zyn.Nut.Atlas.AtlasRegion;
use Sprite = Zyn.Nut.Atlas.Sprite;
use SpriteBatch = Zyn.Nut.Atlas.SpriteBatch;
use FontFace = Zyn.Nut.Text.FontFace;
use FontStack = Zyn.Nut.Text.FontStack;
use GlyphCache = Zyn.Nut.Text.GlyphCache;
use TextLayout = Zyn.Nut.Text.TextLayout;
use TextBlock = Zyn.Nut.Text.TextBlock;
use TextLayoutOptions = Zyn.Nut.Text.TextLayoutOptions;
use std.collections;

extern "C" {
    fn sqrt(x: f64) -> f64;
}

public class Canvas {
    private graph: RenderGraph;

    public static fn create() -> Canvas {
        return Canvas { graph: RenderGraph.create() };
    }

    public fn clear(mut self, color: Color) -> Canvas {
        self.graph = self.graph.clear(color);
        return self;
    }

    public fn drawRect(mut self, rect: Rectangle, color: Color) -> Canvas {
        self.graph = self.graph.fillRect(rect, color);
        return self;
    }

    @[borrow_args]
    public fn fillRect(mut self, rect: Rectangle, color: Color) -> Canvas {
        return self.drawRect(rect, color);
    }

    public fn strokeRect(mut self, rect: Rectangle, width: f32, color: Color) -> Canvas {
        self.graph = self.graph.strokeRect(rect, width, color);
        return self;
    }

    public fn pushClipRect(mut self, rect: Rectangle) -> Canvas {
        self.graph = self.graph.pushClipRect(rect);
        return self;
    }

    // Takes `&Path`: `Path` owns its point buffer, and passing it by value would
    // copy the ownership flag and give the caller a double free.
    public fn pushClipPath(mut self, path: &Path) -> Canvas {
        self.graph = self.graph.pushClipPath(path);
        return self;
    }

    public fn popClip(mut self) -> Canvas {
        self.graph = self.graph.popClip();
        return self;
    }

    public fn fillCircle(mut self, circle: Circle, color: Color) -> Canvas {
        self.graph = self.graph.fillCircle(circle, color);
        return self;
    }

    public fn drawCircle(mut self, center: Point, radius: f32, color: Color) -> Canvas {
        return self.fillCircle(Circle.create(center, radius), color);
    }

    public fn fillTriangle(mut self, triangle: Triangle, color: Color) -> Canvas {
        self.graph = self.graph.fillTriangle(triangle, color);
        return self;
    }

    public fn fillQuad(mut self, quad: Quad, color: Color) -> Canvas {
        self.graph = self.graph.fillQuad(quad, color);
        return self;
    }

    public fn fillGradientRect(mut self, rect: Rectangle, gradient: LinearGradient) -> Canvas {
        self.graph = self.graph.fillGradientRect(rect, gradient);
        return self;
    }

    private fn transparentColor(&self, color: Color) -> Color {
        return Color.rgba(color.r, color.g, color.b, 0.0 as f32);
    }

    public fn drawShadowRect(mut self, rect: Rectangle, offset_x: f32, offset_y: f32, blur: f32, color: Color) -> Canvas {
        if (!rect.isDrawable() || color.a <= (0.0 as f32)) { return self; }
        let shadow = Rectangle.xywh(rect.x + offset_x, rect.y + offset_y, rect.width, rect.height);
        if (blur <= (0.0 as f32)) {
            self.graph = self.graph.fillRect(shadow, color);
            return self;
        }
        let transparent = self.transparentColor(color);
        let corner = color.withAlphaMultiplier(0.25 as f32);
        self.graph = self.graph.fillRect(shadow, color);
        self.graph = self.graph.fillGradientRect(Rectangle.xywh(shadow.x, shadow.y - blur, shadow.width, blur), LinearGradient.vertical(transparent, color));
        self.graph = self.graph.fillGradientRect(Rectangle.xywh(shadow.x, shadow.bottom(), shadow.width, blur), LinearGradient.vertical(color, transparent));
        self.graph = self.graph.fillGradientRect(Rectangle.xywh(shadow.x - blur, shadow.y, blur, shadow.height), LinearGradient.horizontal(transparent, color));
        self.graph = self.graph.fillGradientRect(Rectangle.xywh(shadow.right(), shadow.y, blur, shadow.height), LinearGradient.horizontal(color, transparent));
        self.graph = self.graph.fillRect(Rectangle.xywh(shadow.x - blur, shadow.y - blur, blur, blur), corner);
        self.graph = self.graph.fillRect(Rectangle.xywh(shadow.right(), shadow.y - blur, blur, blur), corner);
        self.graph = self.graph.fillRect(Rectangle.xywh(shadow.x - blur, shadow.bottom(), blur, blur), corner);
        self.graph = self.graph.fillRect(Rectangle.xywh(shadow.right(), shadow.bottom(), blur, blur), corner);
        return self;
    }

    public fn drawShadowPath(mut self, path: &Path, offset_x: f32, offset_y: f32, spread: f32, color: Color) -> Canvas {
        if (!path.isFillable() || color.a <= (0.0 as f32)) { return self; }
        var shadow_path = path.transform(Transform2D.translation(offset_x, offset_y));
        self = self.fillPath(&shadow_path, color);
        if (spread > (0.0 as f32)) {
            self = self.strokePath(&shadow_path, spread * (2.0 as f32), color);
        }
        shadow_path.destroy();
        return self;
    }

    public fn drawSprite(mut self, sprite: Sprite) -> Canvas {
        self.graph = self.graph.drawSprite(sprite);
        return self;
    }

    public fn drawExternal(mut self, rect: Rectangle, slot_id: i32) -> Canvas {
        self.graph = self.graph.drawExternal(rect, slot_id);
        return self;
    }

    public fn drawAtlasRegion(mut self, region: AtlasRegion, dest: Rectangle, tint: Color) -> Canvas {
        if (region.isValid() && dest.isDrawable()) {
            self.graph = self.graph.drawSprite(Sprite.create(region, dest, tint));
        }
        return self;
    }

    public fn drawAtlas(mut self, atlas: &Atlas, name: string, dest: Rectangle, tint: Color) -> Result<Canvas, Error> {
        let region = atlas.find(name);
        if (!region.isValid()) {
            return Err(Error.create(82, "atlas region not found: " + name));
        }
        return Ok(self.drawAtlasRegion(region, dest, tint));
    }

    public fn drawSpriteBatch(mut self, batch: &SpriteBatch) -> Canvas {
        var i: i32 = 0;
        while (i < batch.spriteCount()) {
            self.graph = self.graph.drawSprite(batch.spriteAt(i));
            i = i + 1;
        }
        return self;
    }

    public fn drawTriangle(mut self, a: Point, b: Point, c: Point, color: Color) -> Canvas {
        return self.fillTriangle(Triangle.create(a, b, c), color);
    }

    public fn pushTransform(mut self, transform: Transform2D) -> Canvas {
        self.graph = self.graph.pushTransform(transform);
        return self;
    }

    public fn popTransform(mut self) -> Canvas {
        self.graph = self.graph.popTransform();
        return self;
    }

    public fn pushLayer(mut self, alpha: f32) -> Canvas {
        self.graph = self.graph.pushLayer(alpha);
        return self;
    }

    public fn popLayer(mut self) -> Canvas {
        self.graph = self.graph.popLayer();
        return self;
    }

    public fn usePipeline(mut self, pipeline_id: i32) -> Canvas {
        self.graph = self.graph.usePipeline(pipeline_id);
        return self;
    }

    public fn usePipelineConstants4f(mut self, pipeline_id: i32, x: f32, y: f32, z: f32, w: f32) -> Canvas {
        self.graph = self.graph.usePipelineConstants4f(pipeline_id, x, y, z, w);
        return self;
    }

    public fn usePipelineConstants1f(mut self, pipeline_id: i32, x: f32) -> Canvas {
        self.graph = self.graph.usePipelineConstants1f(pipeline_id, x);
        return self;
    }

    public fn usePipelineConstants2f(mut self, pipeline_id: i32, x: f32, y: f32) -> Canvas {
        self.graph = self.graph.usePipelineConstants2f(pipeline_id, x, y);
        return self;
    }

    public fn usePipelineConstants3f(mut self, pipeline_id: i32, x: f32, y: f32, z: f32) -> Canvas {
        self.graph = self.graph.usePipelineConstants3f(pipeline_id, x, y, z);
        return self;
    }

    public fn drawLine(mut self, from: Point, to: Point, width: f32, color: Color) -> Canvas {
        self.graph = self.graph.strokeLine(Line.create(from, to, width), color);
        return self;
    }

    public fn drawLineRound(mut self, from: Point, to: Point, width: f32, color: Color) -> Canvas {
        if (width <= (0.0 as f32) || color.a <= (0.0 as f32)) { return self; }
        let radius = width / (2.0 as f32);
        self.graph = self.graph.strokeLine(Line.create(from, to, width), color);
        self.graph = self.graph.fillCircle(Circle.create(from, radius), color);
        self.graph = self.graph.fillCircle(Circle.create(to, radius), color);
        return self;
    }

    private fn normalizeDashPhase(&self, phase: f32, pattern: f32) -> f32 {
        if (pattern <= (0.0 as f32)) { return 0.0 as f32; }
        let pattern64 = pattern as f64;
        var out: f64 = phase as f64;
        while (out < 0.0) {
            out = out + pattern64;
        }
        while (out >= pattern64) {
            out = out - pattern64;
        }
        return out as f32;
    }

    public fn strokePathDashed(mut self, path: &Path, width: f32, color: Color, dash: f32, gap: f32, phase: f32) -> Canvas {
        if (!path.isStrokeable() || width <= (0.0 as f32) || color.a <= (0.0 as f32) || dash <= (0.0 as f32)) { return self; }
        var actual_gap = gap;
        if (actual_gap < (0.0 as f32)) { actual_gap = 0.0 as f32; }
        let pattern = dash + actual_gap;
        if (pattern <= (0.0 as f32)) { return self; }
        var consumed: f64 = 0.0;
        var i: i32 = 0;
        while (i + 1 < path.pointCount()) {
            let a = path.pointAt(i);
            let b = path.pointAt(i + 1);
            self = self.drawLineDashed(a, b, width, color, dash, actual_gap, ((phase as f64) + consumed) as f32);
            let dx = b.x - a.x;
            let dy = b.y - a.y;
            consumed = consumed + sqrt(((dx as f64) * (dx as f64)) + ((dy as f64) * (dy as f64)));
            i = i + 1;
        }
        if (path.isClosed() && path.pointCount() > 2) {
            let a = path.pointAt(path.pointCount() - 1);
            let b = path.pointAt(0);
            self = self.drawLineDashed(a, b, width, color, dash, actual_gap, ((phase as f64) + consumed) as f32);
        }
        return self;
    }

    public fn drawLineDashed(mut self, from: Point, to: Point, width: f32, color: Color, dash: f32, gap: f32, phase: f32) -> Canvas {
        if (width <= (0.0 as f32) || color.a <= (0.0 as f32) || dash <= (0.0 as f32)) { return self; }
        let dx = to.x - from.x;
        let dy = to.y - from.y;
        let total = sqrt(((dx as f64) * (dx as f64)) + ((dy as f64) * (dy as f64))) as f32;
        if (total <= (0.0 as f32)) { return self; }
        var actual_gap = gap;
        if (actual_gap < (0.0 as f32)) { actual_gap = 0.0 as f32; }
        let pattern = dash + actual_gap;
        if (pattern <= (0.0 as f32)) { return self; }
        let total64 = total as f64;
        var cursor: f64 = 0.0 - (self.normalizeDashPhase(phase, pattern) as f64);
        while (cursor < total64) {
            var dash_start: f64 = cursor;
            if (dash_start < 0.0) { dash_start = 0.0; }
            var dash_end: f64 = cursor + (dash as f64);
            if (dash_end > total64) { dash_end = total64; }
            if (dash_end > dash_start) {
                let start_t = (dash_start / total64) as f32;
                let end_t = (dash_end / total64) as f32;
                let start = Point.xy(from.x + (dx * start_t), from.y + (dy * start_t));
                let end = Point.xy(from.x + (dx * end_t), from.y + (dy * end_t));
                self.graph = self.graph.strokeLine(Line.create(start, end, width), color);
            }
            cursor = cursor + (pattern as f64);
        }
        return self;
    }

    private fn textDrawX(&self, line_advance: i32, shaped_x: i32, offset_x: i32, bearing_x: i32, glyph_width: i32) -> f32 {
        return (shaped_x + offset_x + bearing_x) as f32;
    }

    public fn drawTextLayout(mut self, cache: &GlyphCache, layout: &TextLayout, x: f32, baseline_y: f32, tint: Color) -> Result<Canvas, Error> {
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let shaped = layout.glyphAt(i);
            let cached = cache.findGlyph(shaped.font_id, shaped.glyph_index);
            if (!cached.cached) {
                return Err(Error.create(80, "glyph is not cached for text layout"));
            }
            if (!cached.region.isValid()) {
                i = i + 1;
                continue;
            }
            let draw_x = x + self.textDrawX(layout.advance_x, shaped.x, shaped.offset_x, cached.bearing_x, cached.region.width);
            let draw_y = baseline_y + (shaped.y as f32) + (shaped.offset_y as f32) - (cached.bearing_y as f32);
            self.graph = self.graph.drawSprite(Sprite.create(cached.region, Rectangle.xywh(draw_x, draw_y, cached.region.width as f32, cached.region.height as f32), tint));
            i = i + 1;
        }
        return Ok(self);
    }

    public fn drawText(mut self, font: &FontFace, cache: &mut GlyphCache, text: string, x: f32, baseline_y: f32, tint: Color) -> Result<Canvas, Error> {
        var layout: TextLayout;
        match (cache.cacheText(font, text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        var out: Canvas;
        match (self.drawTextLayout(cache, &layout, x, baseline_y, tint)) {
            case Ok(v) => { out = v; }
            case Err(e) => {
                layout.destroy();
                return Err(e);
            }
        }
        layout.destroy();
        return Ok(out);
    }

    public fn drawTextWithStack(mut self, fonts: &FontStack, cache: &mut GlyphCache, text: string, x: f32, baseline_y: f32, tint: Color) -> Result<Canvas, Error> {
        var layout: TextLayout;
        match (cache.cacheTextWithStack(fonts, text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        var out: Canvas;
        match (self.drawTextLayout(cache, &layout, x, baseline_y, tint)) {
            case Ok(v) => { out = v; }
            case Err(e) => {
                layout.destroy();
                return Err(e);
            }
        }
        layout.destroy();
        return Ok(out);
    }

    public fn drawTextBlock(mut self, cache: &GlyphCache, block: &TextBlock, x: f32, y: f32, tint: Color) -> Result<Canvas, Error> {
        var line_index: i32 = 0;
        while (line_index < block.lineCount()) {
            let line = block.lineAt(line_index);
            let line_offset_x = block.lineOffsetX(line);
            var line_glyph: i32 = 0;
            while (line_glyph < line.glyph_count) {
                let glyph_index = line.first_glyph + line_glyph;
                let shaped = block.glyphAt(glyph_index);
                let cached = cache.findGlyph(shaped.font_id, shaped.glyph_index);
                if (!cached.cached) {
                    return Err(Error.create(81, "glyph is not cached for text block"));
                }
                if (!cached.region.isValid()) {
                    line_glyph = line_glyph + 1;
                    continue;
                }
                let draw_x = x + (line_offset_x as f32) + self.textDrawX(line.advance_x, shaped.x, shaped.offset_x, cached.bearing_x, cached.region.width);
                let draw_y = y + (shaped.y as f32) + (shaped.offset_y as f32) - (cached.bearing_y as f32);
                self.graph = self.graph.drawSprite(Sprite.create(cached.region, Rectangle.xywh(draw_x, draw_y, cached.region.width as f32, cached.region.height as f32), tint));
                line_glyph = line_glyph + 1;
            }
            line_index = line_index + 1;
        }
        return Ok(self);
    }

    public fn drawTextBox(mut self, font: &FontFace, cache: &mut GlyphCache, text: string, options: TextLayoutOptions, x: f32, y: f32, tint: Color) -> Result<Canvas, Error> {
        var block: TextBlock;
        match (cache.cacheTextBlock(font, text, options)) {
            case Ok(v) => { block = v; }
            case Err(e) => { return Err(e); }
        }
        var out: Canvas;
        match (self.drawTextBlock(cache, &block, x, y, tint)) {
            case Ok(v) => { out = v; }
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        block.destroy();
        return Ok(out);
    }

    public fn drawTextBoxWithStack(mut self, fonts: &FontStack, cache: &mut GlyphCache, text: string, options: TextLayoutOptions, x: f32, y: f32, tint: Color) -> Result<Canvas, Error> {
        var block: TextBlock;
        match (cache.cacheTextBlockWithStack(fonts, text, options)) {
            case Ok(v) => { block = v; }
            case Err(e) => { return Err(e); }
        }
        var out: Canvas;
        match (self.drawTextBlock(cache, &block, x, y, tint)) {
            case Ok(v) => { out = v; }
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        block.destroy();
        return Ok(out);
    }

    private fn pathSignedArea(&self, path: &Path) -> f32 {
        var area: f64 = 0.0;
        var i: i32 = 0;
        while (i < path.pointCount()) {
            let a = path.pointAt(i);
            var next = i + 1;
            if (next >= path.pointCount()) { next = 0; }
            let b = path.pointAt(next);
            let term = ((a.x as f64) * (b.y as f64)) - ((b.x as f64) * (a.y as f64));
            area = area + term;
            i = i + 1;
        }
        return (area / 2.0) as f32;
    }

    private fn pathCross(&self, a: Point, b: Point, c: Point) -> f32 {
        return ((b.x - a.x) * (c.y - a.y)) - ((b.y - a.y) * (c.x - a.x));
    }

    private fn pointInTriangle(&self, point: Point, a: Point, b: Point, c: Point, ccw: bool) -> bool {
        let ab = self.pathCross(a, b, point);
        let bc = self.pathCross(b, c, point);
        let ca = self.pathCross(c, a, point);
        if (ccw) {
            return ab > (0.0 as f32) && bc > (0.0 as f32) && ca > (0.0 as f32);
        }
        return ab < (0.0 as f32) && bc < (0.0 as f32) && ca < (0.0 as f32);
    }

    public fn fillPath(mut self, path: &Path, color: Color) -> Canvas {
        if (!path.isFillable()) { return self; }
        let area = self.pathSignedArea(path);
        if (area == (0.0 as f32)) { return self; }
        let ccw = area > (0.0 as f32);
        var indices = Vec::<i32>.new();
        var i: i32 = 0;
        while (i < path.pointCount()) {
            indices.push(i);
            i = i + 1;
        }

        var guard: i32 = 0;
        let guard_limit = path.pointCount() * path.pointCount();
        while ((indices.len as i32) > 3 && guard < guard_limit) {
            var ear_index: i32 = -1;
            var j: i32 = 0;
            while (j < (indices.len as i32) && ear_index < 0) {
                let count = indices.len as i32;
                var prev_index = j - 1;
                if (prev_index < 0) { prev_index = count - 1; }
                var next_index = j + 1;
                if (next_index >= count) { next_index = 0; }

                let prev = indices.get(prev_index as i64);
                let current = indices.get(j as i64);
                let next = indices.get(next_index as i64);
                let a = path.pointAt(prev);
                let b = path.pointAt(current);
                let c = path.pointAt(next);
                let turn = self.pathCross(a, b, c);
                var convex = false;
                if (ccw) {
                    convex = turn > (0.0 as f32);
                } else {
                    convex = turn < (0.0 as f32);
                }

                if (convex) {
                    var contains_point = false;
                    var k: i32 = 0;
                    while (k < count && !contains_point) {
                        let candidate = indices.get(k as i64);
                        if (candidate != prev && candidate != current && candidate != next) {
                            if (self.pointInTriangle(path.pointAt(candidate), a, b, c, ccw)) {
                                contains_point = true;
                            }
                        }
                        k = k + 1;
                    }
                    if (!contains_point) {
                        ear_index = j;
                    }
                }
                j = j + 1;
            }
            if (ear_index < 0) {
                indices.destroy();
                return self;
            }

            let count = indices.len as i32;
            var prev_index = ear_index - 1;
            if (prev_index < 0) { prev_index = count - 1; }
            var next_index = ear_index + 1;
            if (next_index >= count) { next_index = 0; }
            self.graph = self.graph.fillTriangle(Triangle.create(
                path.pointAt(indices.get(prev_index as i64)).clone(),
                path.pointAt(indices.get(ear_index as i64)).clone(),
                path.pointAt(indices.get(next_index as i64)).clone()
            ), color);
            indices.removeAt(ear_index as i64);
            guard = guard + 1;
        }

        if ((indices.len as i32) == 3) {
            self.graph = self.graph.fillTriangle(Triangle.create(
                path.pointAt(indices.get(0)).clone(),
                path.pointAt(indices.get(1)).clone(),
                path.pointAt(indices.get(2)).clone()
            ), color);
        }
        indices.destroy();
        return self;
    }

    public fn strokePath(mut self, path: &Path, width: f32, color: Color) -> Canvas {
        if (!path.isStrokeable() || width <= 0.0) { return self; }
        var i: i32 = 0;
        while (i + 1 < path.pointCount()) {
            self.graph = self.graph.strokeLine(Line.create(path.pointAt(i), path.pointAt(i + 1), width), color);
            i = i + 1;
        }
        if (path.isClosed()) {
            self.graph = self.graph.strokeLine(Line.create(path.pointAt(path.pointCount() - 1), path.pointAt(0), width), color);
        }
        return self;
    }

    public fn strokePathRound(mut self, path: &Path, width: f32, color: Color) -> Canvas {
        if (!path.isStrokeable() || width <= (0.0 as f32) || color.a <= (0.0 as f32)) { return self; }
        self = self.strokePath(path, width, color);
        let radius = width / (2.0 as f32);
        var i: i32 = 0;
        while (i < path.pointCount()) {
            var draw_join = path.isClosed();
            if (!draw_join && i == 0) { draw_join = true; }
            if (!draw_join && i + 1 == path.pointCount()) { draw_join = true; }
            if (!draw_join) {
                let prev = path.pointAt(i - 1);
                let next = path.pointAt(i + 1);
                if (prev.x != next.x || prev.y != next.y) { draw_join = true; }
            }
            if (draw_join) {
                self.graph = self.graph.fillCircle(Circle.create(path.pointAt(i), radius), color);
            }
            i = i + 1;
        }
        return self;
    }

    public fn reset(mut self) -> Canvas {
        self.graph.destroy();
        self.graph = RenderGraph.create();
        return self;
    }

    public fn commandCount(&self) -> i32 {
        return self.graph.commandCount();
    }

    public fn drawCommandCount(&self) -> i32 {
        return self.graph.drawCommandCount();
    }

    public fn build(&self) -> RenderGraph {
        return self.graph.clone();
    }

    public fn destroy(&mut self) {
        self.graph.destroy();
    }
}
