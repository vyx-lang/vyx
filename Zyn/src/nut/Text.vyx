extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn FT_Init_FreeType(alibrary: rawptr) -> i32;
    fn FT_Done_FreeType(library: rawptr) -> i32;
    fn FT_Library_Version(library: rawptr, amajor: rawptr, aminor: rawptr, apatch: rawptr);

    fn hb_version(major: rawptr, minor: rawptr, micro: rawptr);
    fn hb_version_atleast(major: i32, minor: i32, micro: i32) -> i32;
    fn hb_buffer_create() -> rawptr;
    fn hb_buffer_destroy(buffer: rawptr);

    fn zyn_text_font_open(path: rawptr, pixel_size: i32, out_info: rawptr) -> rawptr;
    fn zyn_text_font_close(handle: rawptr);
    fn zyn_text_shape_count(handle: rawptr, text: rawptr, len: i32) -> i32;
    fn zyn_text_shape(handle: rawptr, text: rawptr, len: i32, out_glyphs: rawptr, max_glyphs: i32) -> i32;
    fn zyn_text_glyph_index(handle: rawptr, codepoint: u32) -> u32;
    fn zyn_text_load_glyph(handle: rawptr, codepoint: u32, out_glyph: rawptr) -> i32;
    fn zyn_text_load_glyph_index(handle: rawptr, glyph_index: u32, out_glyph: rawptr) -> i32;
    fn zyn_text_glyph_free(glyph: rawptr);
    fn zyn_text_icu_major_version() -> i32;
    fn zyn_text_boundary_analyze_utf8(text: rawptr,
                                      len: i32,
                                      byte_boundaries: rawptr,
                                      grapheme_codepoint_counts: rawptr,
                                      grapheme_directions: rawptr,
                                      max_boundaries: i32,
                                      max_graphemes: i32,
                                      out_boundary_count: rawptr,
                                      out_codepoint_count: rawptr,
                                      out_combining_sequence_count: rawptr,
                                      out_joiner_sequence_count: rawptr,
                                      out_emoji_sequence_count: rawptr,
                                      out_rtl_grapheme_count: rawptr,
                                      out_ltr_grapheme_count: rawptr,
                                      out_rtl_run_count: rawptr,
                                      out_ltr_run_count: rawptr,
                                      out_direction_run_count: rawptr,
                                      out_max_grapheme_codepoints: rawptr,
                                      out_max_grapheme_bytes: rawptr) -> i32;
    fn zyn_text_bidi_analyze_utf8(text: rawptr,
                                  len: i32,
                                  byte_boundaries: rawptr,
                                  boundary_count: i32,
                                  visual_to_logical: rawptr,
                                  logical_to_visual: rawptr,
                                  run_first: rawptr,
                                  run_lengths: rawptr,
                                  run_directions: rawptr,
                                  visual_run_to_logical: rawptr,
                                  logical_run_to_visual: rawptr,
                                  max_runs: i32,
                                  out_run_count: rawptr,
                                  out_paragraph_direction: rawptr) -> i32;
}

public class TextBackendInfo {
    public freetype_major: i32;
    public freetype_minor: i32;
    public freetype_patch: i32;
    public harfbuzz_major: i32;
    public harfbuzz_minor: i32;
    public harfbuzz_micro: i32;
    public icu_major: i32;

    public static fn create(ft_major: i32, ft_minor: i32, ft_patch: i32, hb_major: i32, hb_minor: i32, hb_micro: i32, icu_major: i32) -> TextBackendInfo {
        return TextBackendInfo {
            freetype_major: ft_major,
            freetype_minor: ft_minor,
            freetype_patch: ft_patch,
            harfbuzz_major: hb_major,
            harfbuzz_minor: hb_minor,
            harfbuzz_micro: hb_micro,
            icu_major: icu_major
        };
    }

    public fn isValid(&self) -> bool {
        return self.freetype_major > 0 && self.harfbuzz_major > 0 && self.icu_major > 0;
    }
}

public class TextBackend {
    public static fn probe() -> Result<TextBackendInfo, Error> {
        var library: rawptr = null;
        let ft_init = FT_Init_FreeType(to_rawptr(&library));
        if (ft_init != 0 || library == null) {
            return Err(Error.create(1, "FT_Init_FreeType failed"));
        }

        var ft_major: i32 = 0;
        var ft_minor: i32 = 0;
        var ft_patch: i32 = 0;
        FT_Library_Version(library, to_rawptr(&ft_major), to_rawptr(&ft_minor), to_rawptr(&ft_patch));
        let ft_done = FT_Done_FreeType(library);
        if (ft_done != 0) {
            return Err(Error.create(2, "FT_Done_FreeType failed"));
        }
        if (ft_major <= 0) {
            return Err(Error.create(3, "FreeType reported an invalid version"));
        }

        var hb_major: i32 = 0;
        var hb_minor: i32 = 0;
        var hb_micro: i32 = 0;
        hb_version(to_rawptr(&hb_major), to_rawptr(&hb_minor), to_rawptr(&hb_micro));
        if (hb_major <= 0 || hb_version_atleast(1, 0, 0) == 0) {
            return Err(Error.create(4, "HarfBuzz reported an invalid version"));
        }

        let buffer = hb_buffer_create();
        if (buffer == null) {
            return Err(Error.create(5, "hb_buffer_create failed"));
        }
        hb_buffer_destroy(buffer);

        let icu_major = zyn_text_icu_major_version();
        if (icu_major <= 0) {
            return Err(Error.create(6, "ICU reported an invalid version"));
        }

        return Ok(TextBackendInfo.create(ft_major, ft_minor, ft_patch, hb_major, hb_minor, hb_micro, icu_major));
    }
}

@[repr(C)]
struct NativeFontInfo {
    ascender: i32;
    descender: i32;
    height: i32;
    max_advance: i32;
    glyph_count: i32;
}

fn nativeFontInfoEmpty() -> NativeFontInfo {
    return NativeFontInfo { ascender: 0, descender: 0, height: 0, max_advance: 0, glyph_count: 0 };
}

public class FontMetrics {
    public ascender: i32;
    public descender: i32;
    public height: i32;
    public max_advance: i32;
    public glyph_count: i32;

    public static fn create(info: NativeFontInfo) -> FontMetrics {
        return FontMetrics {
            ascender: info.ascender,
            descender: info.descender,
            height: info.height,
            max_advance: info.max_advance,
            glyph_count: info.glyph_count
        };
    }

    public fn isValid(&self) -> bool {
        return self.height > 0 && self.glyph_count > 0;
    }
}

@[repr(C)]
struct NativeGlyphBitmap {
    width: i32;
    height: i32;
    bearing_x: i32;
    bearing_y: i32;
    advance_x: i32;
    advance_y: i32;
    pitch: i32;
    pixels: rawptr;
}

fn nativeGlyphBitmapEmpty() -> NativeGlyphBitmap {
    return NativeGlyphBitmap {
        width: 0, height: 0, bearing_x: 0, bearing_y: 0,
        advance_x: 0, advance_y: 0, pitch: 0, pixels: null
    };
}

public class GlyphBitmap {
    public codepoint: u32;
    public width: i32;
    public height: i32;
    public bearing_x: i32;
    public bearing_y: i32;
    public advance_x: i32;
    public advance_y: i32;
    public pitch: i32;
    public pixels: rawptr;

    public static fn fromNative(codepoint: u32, native: NativeGlyphBitmap) -> GlyphBitmap {
        return GlyphBitmap {
            codepoint: codepoint,
            width: native.width,
            height: native.height,
            bearing_x: native.bearing_x,
            bearing_y: native.bearing_y,
            advance_x: native.advance_x,
            advance_y: native.advance_y,
            pitch: native.pitch,
            pixels: native.pixels
        };
    }

    public fn isValid(&self) -> bool {
        return self.width >= 0 && self.height >= 0 && self.advance_x > 0;
    }

    public fn hasPixels(&self) -> bool {
        return self.pixels != null && self.width > 0 && self.height > 0;
    }

    public fn alphaAt(&self, x: i32, y: i32) -> u8 {
        var out: u8 = 0 as u8;
        if (!self.hasPixels() || x < 0 || y < 0 || x >= self.width || y >= self.height) { return out; }
        var p = self.pitch;
        if (p < 0) { p = 0 - p; }
        memcpy(to_rawptr(&out), self.pixels + (((y * p) + x) as i64), 1);
        return out;
    }

    public fn destroy(&mut self) {
        var native = NativeGlyphBitmap {
            width: self.width,
            height: self.height,
            bearing_x: self.bearing_x,
            bearing_y: self.bearing_y,
            advance_x: self.advance_x,
            advance_y: self.advance_y,
            pitch: self.pitch,
            pixels: self.pixels
        };
        zyn_text_glyph_free(to_rawptr(&native));
        self.width = 0;
        self.height = 0;
        self.bearing_x = 0;
        self.bearing_y = 0;
        self.advance_x = 0;
        self.advance_y = 0;
        self.pitch = 0;
        self.pixels = null;
    }
}

@[repr(C)]
struct NativeShapedGlyph {
    glyph_index: u32;
    cluster: u32;
    advance_x: i32;
    advance_y: i32;
    offset_x: i32;
    offset_y: i32;
}

fn nativeShapedGlyphEmpty() -> NativeShapedGlyph {
    return NativeShapedGlyph {
        glyph_index: 0 as u32,
        cluster: 0 as u32,
        advance_x: 0,
        advance_y: 0,
        offset_x: 0,
        offset_y: 0
    };
}

@[repr(C)]
public class ShapedGlyph {
    public font_id: u32;
    public glyph_index: u32;
    public cluster_id: u32;
    public x: i32;
    public y: i32;
    public advance_x: i32;
    public advance_y: i32;
    public offset_x: i32;
    public offset_y: i32;

    public fn clone(&self) -> ShapedGlyph {
        var out: ShapedGlyph;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<ShapedGlyph>() as i64);
        return out;
    }
}

fn loadI32(src: rawptr) -> i32 {
    var out: i32 = 0;
    memcpy(to_rawptr(&out), src, sizeof::<i32>() as i64);
    return out;
}

fn shapedGlyphCreate(font_id: u32, glyph_index: u32, cluster_id: u32, x: i32, y: i32, advance_x: i32, advance_y: i32, offset_x: i32, offset_y: i32) -> ShapedGlyph {
    return ShapedGlyph {
        font_id: font_id,
        glyph_index: glyph_index,
        cluster_id: cluster_id,
        x: x,
        y: y,
        advance_x: advance_x,
        advance_y: advance_y,
        offset_x: offset_x,
        offset_y: offset_y
    };
}

public class TextLayout {
    public glyphs: Vec<ShapedGlyph>;
    public advance_x: i32;
    public advance_y: i32;

    public static fn create() -> TextLayout {
        return TextLayout { glyphs: Vec::<ShapedGlyph>.new(), advance_x: 0, advance_y: 0 };
    }

    public fn pushGlyph(mut self, glyph: ShapedGlyph) -> TextLayout {
        self.glyphs.push(glyph);
        return self;
    }

    public fn glyphCount(&self) -> i32 {
        return self.glyphs.len as i32;
    }

    public fn glyphAt(&self, index: i32) -> ShapedGlyph {
        return self.glyphs.get(index as i64);
    }

    public fn isEmpty(&self) -> bool {
        return self.glyphCount() == 0;
    }

    public fn glyphCountForFont(&self, font_id: u32) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).font_id == font_id) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn containsFont(&self, font_id: u32) -> bool {
        return self.glyphCountForFont(font_id) > 0;
    }

    public fn uniqueFontCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let font_id = self.glyphAt(i).font_id;
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                if (self.glyphAt(j).font_id == font_id) { seen = true; }
                j = j + 1;
            }
            if (!seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn fontSwitchCount(&self) -> i32 {
        if (self.glyphCount() <= 1) { return 0; }
        var count: i32 = 0;
        var last_font = self.glyphAt(0).font_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let font_id = self.glyphAt(i).font_id;
            if (font_id != last_font) {
                count = count + 1;
                last_font = font_id;
            }
            i = i + 1;
        }
        return count;
    }

    public fn clustersAreNondecreasing(&self) -> bool {
        if (self.glyphCount() <= 1) { return true; }
        var last_cluster = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster < last_cluster) { return false; }
            last_cluster = cluster;
            i = i + 1;
        }
        return true;
    }

    public fn clustersAreNonincreasing(&self) -> bool {
        if (self.glyphCount() <= 1) { return true; }
        var last_cluster = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster > last_cluster) { return false; }
            last_cluster = cluster;
            i = i + 1;
        }
        return true;
    }

    public fn clustersAreMonotonic(&self) -> bool {
        return self.clustersAreNondecreasing() || self.clustersAreNonincreasing();
    }

    public fn clusterDirection(&self) -> i32 {
        if (self.glyphCount() <= 1) { return 0; }
        var saw_increase = false;
        var saw_decrease = false;
        var last_cluster = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster > last_cluster) { saw_increase = true; }
            if (cluster < last_cluster) { saw_decrease = true; }
            last_cluster = cluster;
            i = i + 1;
        }
        if (saw_increase && !saw_decrease) { return 1; }
        if (saw_decrease && !saw_increase) { return -1; }
        if (!saw_increase && !saw_decrease) { return 0; }
        return 2;
    }

    public fn hasClusterReordering(&self) -> bool {
        return self.clusterDirection() < 0 || self.clusterDirection() == 2;
    }

    public fn minCluster(&self) -> u32 {
        if (self.glyphCount() <= 0) { return 0 as u32; }
        var out = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster < out) { out = cluster; }
            i = i + 1;
        }
        return out;
    }

    public fn maxCluster(&self) -> u32 {
        if (self.glyphCount() <= 0) { return 0 as u32; }
        var out = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster > out) { out = cluster; }
            i = i + 1;
        }
        return out;
    }

    public fn uniqueClusterCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                if (self.glyphAt(j).cluster_id == cluster) { seen = true; }
                j = j + 1;
            }
            if (!seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn glyphCountForCluster(&self, cluster: u32) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).cluster_id == cluster) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn firstGlyphIndexForCluster(&self, cluster: u32) -> i32 {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).cluster_id == cluster) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn lastGlyphIndexForCluster(&self, cluster: u32) -> i32 {
        var out: i32 = -1;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).cluster_id == cluster) { out = i; }
            i = i + 1;
        }
        return out;
    }

    public fn clustersHaveContiguousRuns(&self) -> bool {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            let first = self.firstGlyphIndexForCluster(cluster);
            let last = self.lastGlyphIndexForCluster(cluster);
            var j = first;
            while (j <= last) {
                if (self.glyphAt(j).cluster_id != cluster) { return false; }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }

    public fn clusterRunCount(&self) -> i32 {
        if (self.glyphCount() <= 0) { return 0; }
        var count: i32 = 1;
        var last_cluster = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster != last_cluster) {
                count = count + 1;
                last_cluster = cluster;
            }
            i = i + 1;
        }
        return count;
    }

    public fn maxClusterRunLength(&self) -> i32 {
        if (self.glyphCount() <= 0) { return 0; }
        var best: i32 = 1;
        var current: i32 = 1;
        var last_cluster = self.glyphAt(0).cluster_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (cluster == last_cluster) {
                current = current + 1;
            } else {
                if (current > best) { best = current; }
                current = 1;
                last_cluster = cluster;
            }
            i = i + 1;
        }
        if (current > best) { best = current; }
        return best;
    }

    public fn clusterStartX(&self, cluster: u32) -> i32 {
        var found = false;
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let glyph = self.glyphAt(i);
            if (glyph.cluster_id == cluster) {
                if (!found || glyph.x < out) {
                    out = glyph.x;
                }
                found = true;
            }
            i = i + 1;
        }
        if (!found) { return self.advance_x; }
        return out;
    }

    public fn clusterEndX(&self, cluster: u32) -> i32 {
        var found = false;
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let glyph = self.glyphAt(i);
            if (glyph.cluster_id == cluster) {
                let x1 = glyph.x + glyph.advance_x;
                if (!found || x1 > out) {
                    out = x1;
                }
                found = true;
            }
            i = i + 1;
        }
        if (!found) { return self.advance_x; }
        return out;
    }

    public fn clusterAdvanceWidth(&self, cluster: u32) -> i32 {
        let start = self.clusterStartX(cluster);
        let end_index = self.clusterEndX(cluster);
        if (end_index < start) { return 0; }
        return end_index - start;
    }

    public fn caretXForCluster(&self, cluster: u32, trailing: bool) -> i32 {
        if (self.clusterDirection() < 0) {
            if (trailing) { return self.clusterStartX(cluster); }
            return self.clusterEndX(cluster);
        }
        if (trailing) { return self.clusterEndX(cluster); }
        return self.clusterStartX(cluster);
    }

    public fn nearestClusterForX(&self, x: i32) -> u32 {
        if (self.glyphCount() <= 0) { return 0 as u32; }
        var best_cluster = self.glyphAt(0).cluster_id;
        var best_distance: i32 = 2147483647;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let cluster = self.glyphAt(i).cluster_id;
            if (self.firstGlyphIndexForCluster(cluster) == i) {
                let start = self.clusterStartX(cluster);
                let end_index = self.clusterEndX(cluster);
                var center = (start + end_index) / 2;
                var distance = center - x;
                if (distance < 0) { distance = 0 - distance; }
                if (distance < best_distance) {
                    best_distance = distance;
                    best_cluster = cluster;
                }
            }
            i = i + 1;
        }
        return best_cluster;
    }

    public fn nearestCaretX(&self, x: i32) -> i32 {
        if (self.glyphCount() <= 0) { return 0; }
        let cluster = self.nearestClusterForX(x);
        let start = self.clusterStartX(cluster);
        let end_index = self.clusterEndX(cluster);
        let mid = (start + end_index) / 2;
        if (x <= mid) { return start; }
        return end_index;
    }

    public fn destroy(&mut self) {
        self.glyphs.destroy();
        self.advance_x = 0;
        self.advance_y = 0;
    }
}

public class TextAlign {
    public value: i32;

    public static fn left() -> TextAlign { return TextAlign { value: 0 }; }
    public static fn center() -> TextAlign { return TextAlign { value: 1 }; }
    public static fn right() -> TextAlign { return TextAlign { value: 2 }; }

    public fn isCenter(&self) -> bool { return self.value == 1; }
    public fn isRight(&self) -> bool { return self.value == 2; }

    public fn clone(&self) -> TextAlign {
        return TextAlign { value: self.value };
    }
}

public class TextLayoutOptions {
    public max_width: i32;
    public line_height: i32;
    public wrap: bool;
    public align: TextAlign;

    public static fn singleLine() -> TextLayoutOptions {
        return TextLayoutOptions { max_width: 0, line_height: 0, wrap: false, align: TextAlign.left() };
    }

    public static fn wrapWidth(max_width: i32) -> TextLayoutOptions {
        return TextLayoutOptions { max_width: max_width, line_height: 0, wrap: true, align: TextAlign.left() };
    }

    public fn setMaxWidth(mut self, max_width: i32) -> TextLayoutOptions {
        self.max_width = max_width;
        self.wrap = max_width > 0;
        return self;
    }

    public fn setLineHeight(mut self, line_height: i32) -> TextLayoutOptions {
        self.line_height = line_height;
        return self;
    }

    public fn disableWrap(mut self) -> TextLayoutOptions {
        self.wrap = false;
        self.max_width = 0;
        return self;
    }

    public fn setAlign(mut self, align: TextAlign) -> TextLayoutOptions {
        self.align = align.clone();
        return self;
    }

    public fn alignLeft(mut self) -> TextLayoutOptions {
        return self.setAlign(TextAlign.left());
    }

    public fn alignCenter(mut self) -> TextLayoutOptions {
        return self.setAlign(TextAlign.center());
    }

    public fn alignRight(mut self) -> TextLayoutOptions {
        return self.setAlign(TextAlign.right());
    }

    public fn resolvedLineHeight(&self, metrics: FontMetrics) -> i32 {
        if (self.line_height > 0) { return self.line_height; }
        return metrics.height;
    }
}

public class TextLine {
    public first_glyph: i32;
    public glyph_count: i32;
    public baseline_y: i32;
    public advance_x: i32;

    public static fn create(first_glyph: i32, glyph_count: i32, baseline_y: i32, advance_x: i32) -> TextLine {
        return TextLine { first_glyph: first_glyph, glyph_count: glyph_count, baseline_y: baseline_y, advance_x: advance_x };
    }

    public fn clone(&self) -> TextLine {
        return TextLine.create(self.first_glyph, self.glyph_count, self.baseline_y, self.advance_x);
    }
}

public class TextBlock {
    public glyphs: Vec<ShapedGlyph>;
    public lines: Vec<TextLine>;
    public width: i32;
    public height: i32;
    public line_height: i32;
    public ascender: i32;
    public descender: i32;
    public align: TextAlign;
    public target_width: i32;

    public static fn create(line_height: i32, ascender: i32, descender: i32, align: TextAlign, target_width: i32) -> TextBlock {
        return TextBlock {
            glyphs: Vec::<ShapedGlyph>.new(),
            lines: Vec::<TextLine>.new(),
            width: 0,
            height: 0,
            line_height: line_height,
            ascender: ascender,
            descender: descender,
            align: align.clone(),
            target_width: target_width
        };
    }

    public fn lineCount(&self) -> i32 {
        return self.lines.len as i32;
    }

    public fn glyphCount(&self) -> i32 {
        return self.glyphs.len as i32;
    }

    public fn lineAt(&self, index: i32) -> TextLine {
        return self.lines.get(index as i64);
    }

    public fn glyphAt(&self, index: i32) -> ShapedGlyph {
        return self.glyphs.get(index as i64);
    }

    public fn pushLine(&mut self, layout: &TextLayout, baseline_y: i32) {
        let first = self.glyphCount();
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let g = layout.glyphAt(i);
        self.glyphs.push(shapedGlyphCreate(g.font_id, g.glyph_index, g.cluster_id, g.x, g.y + baseline_y, g.advance_x, g.advance_y, g.offset_x, g.offset_y));
            i = i + 1;
        }
        self.lines.push(TextLine.create(first, layout.glyphCount(), baseline_y, layout.advance_x));
        if (layout.advance_x > self.width) { self.width = layout.advance_x; }
        self.height = self.lineCount() * self.line_height;
    }

    public fn bounds(&self) -> Rectangle {
        return Rectangle.xywh(0.0, 0.0, self.width as f32, self.height as f32);
    }

    public fn lineOffsetX(&self, line: TextLine) -> i32 {
        var target = self.target_width;
        if (target <= 0) { target = self.width; }
        var extra = target - line.advance_x;
        if (extra < 0) { extra = 0; }
        if (self.align.isRight()) { return extra; }
        if (self.align.isCenter()) { return extra / 2; }
        return 0;
    }

    public fn isEmpty(&self) -> bool {
        return self.lineCount() == 0 && self.glyphCount() == 0;
    }

    public fn glyphCountForFont(&self, font_id: u32) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            if (self.glyphAt(i).font_id == font_id) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn containsFont(&self, font_id: u32) -> bool {
        return self.glyphCountForFont(font_id) > 0;
    }

    public fn uniqueFontCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let font_id = self.glyphAt(i).font_id;
            var seen = false;
            var j: i32 = 0;
            while (j < i) {
                if (self.glyphAt(j).font_id == font_id) { seen = true; }
                j = j + 1;
            }
            if (!seen) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn fontSwitchCount(&self) -> i32 {
        if (self.glyphCount() <= 1) { return 0; }
        var count: i32 = 0;
        var last_font = self.glyphAt(0).font_id;
        var i: i32 = 1;
        while (i < self.glyphCount()) {
            let font_id = self.glyphAt(i).font_id;
            if (font_id != last_font) {
                count = count + 1;
                last_font = font_id;
            }
            i = i + 1;
        }
        return count;
    }

    public fn destroy(&mut self) {
        self.glyphs.destroy();
        self.lines.destroy();
        self.width = 0;
        self.height = 0;
        self.line_height = 0;
        self.ascender = 0;
        self.descender = 0;
        self.target_width = 0;
    }
}

fn textIsNewlineByte(c: i32) -> bool {
    return c == 10 || c == 13;
}

fn textIsBreakSpace(c: i32) -> bool {
    return c == 32 || c == 9;
}

fn textNextUtf8Boundary(text: string, index: i64) -> i64 {
    if (index >= text.len) { return text.len; }
    let c = text.charAt(index as i32);
    var step: i64 = 1;
    if (c >= 240) {
        step = 4;
    } else if (c >= 224) {
        step = 3;
    } else if (c >= 192) {
        step = 2;
    }
    let next = index + step;
    if (next > text.len) { return text.len; }
    return next;
}

fn textCodepointAt(text: string, index: i64) -> u32 {
    if (index < 0 || index >= text.len) { return 0 as u32; }
    let c0 = text.charAt(index as i32);
    if (c0 < 128) { return c0 as u32; }
    if (c0 >= 192 && c0 < 224 && (index + 1) < text.len) {
        let c1 = text.charAt((index + 1) as i32);
        if (c1 >= 128 && c1 < 192) {
            return ((((c0 - 192) as u32) << 6) | ((c1 - 128) as u32));
        }
    }
    if (c0 >= 224 && c0 < 240 && (index + 2) < text.len) {
        let c1 = text.charAt((index + 1) as i32);
        let c2 = text.charAt((index + 2) as i32);
        if (c1 >= 128 && c1 < 192 && c2 >= 128 && c2 < 192) {
            return ((((c0 - 224) as u32) << 12) | (((c1 - 128) as u32) << 6) | ((c2 - 128) as u32));
        }
    }
    if (c0 >= 240 && c0 < 248 && (index + 3) < text.len) {
        let c1 = text.charAt((index + 1) as i32);
        let c2 = text.charAt((index + 2) as i32);
        let c3 = text.charAt((index + 3) as i32);
        if (c1 >= 128 && c1 < 192 && c2 >= 128 && c2 < 192 && c3 >= 128 && c3 < 192) {
            return ((((c0 - 240) as u32) << 18) | (((c1 - 128) as u32) << 12) | (((c2 - 128) as u32) << 6) | ((c3 - 128) as u32));
        }
    }
    return 0xfffd as u32;
}

fn textCodepointIsCombiningMark(codepoint: u32) -> bool {
    if (codepoint >= 0x0300 as u32 && codepoint <= 0x036f as u32) { return true; }
    if (codepoint >= 0x1ab0 as u32 && codepoint <= 0x1aff as u32) { return true; }
    if (codepoint >= 0x1dc0 as u32 && codepoint <= 0x1dff as u32) { return true; }
    if (codepoint >= 0x20d0 as u32 && codepoint <= 0x20ff as u32) { return true; }
    if (codepoint >= 0xfe20 as u32 && codepoint <= 0xfe2f as u32) { return true; }
    if (codepoint >= 0x0591 as u32 && codepoint <= 0x05bd as u32) { return true; }
    if (codepoint == 0x05bf as u32) { return true; }
    if (codepoint >= 0x05c1 as u32 && codepoint <= 0x05c2 as u32) { return true; }
    if (codepoint >= 0x05c4 as u32 && codepoint <= 0x05c5 as u32) { return true; }
    if (codepoint == 0x05c7 as u32) { return true; }
    if (codepoint >= 0x0610 as u32 && codepoint <= 0x061a as u32) { return true; }
    if (codepoint >= 0x064b as u32 && codepoint <= 0x065f as u32) { return true; }
    if (codepoint == 0x0670 as u32) { return true; }
    if (codepoint >= 0x06d6 as u32 && codepoint <= 0x06dc as u32) { return true; }
    if (codepoint >= 0x06df as u32 && codepoint <= 0x06e4 as u32) { return true; }
    if (codepoint >= 0x06e7 as u32 && codepoint <= 0x06e8 as u32) { return true; }
    if (codepoint >= 0x06ea as u32 && codepoint <= 0x06ed as u32) { return true; }
    return false;
}

fn textCodepointIsIndicMark(codepoint: u32) -> bool {
    if (codepoint >= 0x0900 as u32 && codepoint <= 0x0903 as u32) { return true; }
    if (codepoint == 0x093a as u32 || codepoint == 0x093c as u32) { return true; }
    if (codepoint >= 0x093e as u32 && codepoint <= 0x094c as u32) { return true; }
    if (codepoint == 0x094d as u32) { return true; }
    if (codepoint >= 0x0951 as u32 && codepoint <= 0x0957 as u32) { return true; }
    if (codepoint >= 0x0962 as u32 && codepoint <= 0x0963 as u32) { return true; }
    if (codepoint >= 0x0981 as u32 && codepoint <= 0x0983 as u32) { return true; }
    if (codepoint >= 0x09be as u32 && codepoint <= 0x09cc as u32) { return true; }
    if (codepoint == 0x09bc as u32 || codepoint == 0x09cd as u32) { return true; }
    if (codepoint >= 0x0a01 as u32 && codepoint <= 0x0a03 as u32) { return true; }
    if (codepoint >= 0x0a3e as u32 && codepoint <= 0x0a4c as u32) { return true; }
    if (codepoint == 0x0a3c as u32 || codepoint == 0x0a4d as u32) { return true; }
    if (codepoint >= 0x0b01 as u32 && codepoint <= 0x0b03 as u32) { return true; }
    if (codepoint >= 0x0b3e as u32 && codepoint <= 0x0b4c as u32) { return true; }
    if (codepoint == 0x0b3c as u32 || codepoint == 0x0b4d as u32) { return true; }
    return false;
}

fn textCodepointIsRtl(codepoint: u32) -> bool {
    if (codepoint >= 0x0590 as u32 && codepoint <= 0x08ff as u32) { return true; }
    if (codepoint >= 0xfb1d as u32 && codepoint <= 0xfdff as u32) { return true; }
    if (codepoint >= 0xfe70 as u32 && codepoint <= 0xfeff as u32) { return true; }
    return false;
}

fn textCodepointIsArabic(codepoint: u32) -> bool {
    if (codepoint >= 0x0600 as u32 && codepoint <= 0x06ff as u32) { return true; }
    if (codepoint >= 0x0750 as u32 && codepoint <= 0x077f as u32) { return true; }
    if (codepoint >= 0x08a0 as u32 && codepoint <= 0x08ff as u32) { return true; }
    if (codepoint >= 0xfb50 as u32 && codepoint <= 0xfdff as u32) { return true; }
    if (codepoint >= 0xfe70 as u32 && codepoint <= 0xfeff as u32) { return true; }
    return false;
}

fn textCodepointIsIndic(codepoint: u32) -> bool {
    if (codepoint >= 0x0900 as u32 && codepoint <= 0x097f as u32) { return true; }
    if (codepoint >= 0x0980 as u32 && codepoint <= 0x09ff as u32) { return true; }
    if (codepoint >= 0x0a00 as u32 && codepoint <= 0x0a7f as u32) { return true; }
    if (codepoint >= 0x0b00 as u32 && codepoint <= 0x0b7f as u32) { return true; }
    return false;
}

fn textCodepointIsEmoji(codepoint: u32) -> bool {
    if (codepoint >= 0x1f000 as u32 && codepoint <= 0x1faff as u32) { return true; }
    if (codepoint >= 0x2600 as u32 && codepoint <= 0x27bf as u32) { return true; }
    return false;
}

fn textCodepointIsJoiner(codepoint: u32) -> bool {
    return codepoint == 0x200c as u32 || codepoint == 0x200d as u32;
}

fn textCodepointScriptClass(codepoint: u32) -> i32 {
    if (textCodepointIsArabic(codepoint)) { return 1; }
    if (codepoint >= 0x0590 as u32 && codepoint <= 0x05ff as u32) { return 2; }
    if (textCodepointIsIndic(codepoint)) { return 3; }
    if (codepoint >= 0x4e00 as u32 && codepoint <= 0x9fff as u32) { return 4; }
    if (textCodepointIsEmoji(codepoint)) { return 5; }
    if ((codepoint >= 0x0041 as u32 && codepoint <= 0x005a as u32) || (codepoint >= 0x0061 as u32 && codepoint <= 0x007a as u32)) { return 6; }
    return 0;
}

fn textCodepointIsVariationSelector(codepoint: u32) -> bool {
    if (codepoint >= 0xfe00 as u32 && codepoint <= 0xfe0f as u32) { return true; }
    if (codepoint >= 0xe0100 as u32 && codepoint <= 0xe01ef as u32) { return true; }
    return false;
}

fn textCodepointExtendsPreviousGlyph(codepoint: u32) -> bool {
    if (textCodepointIsCombiningMark(codepoint)) { return true; }
    if (textCodepointIsIndicMark(codepoint)) { return true; }
    if (textCodepointIsVariationSelector(codepoint)) { return true; }
    if (textCodepointIsJoiner(codepoint)) { return true; }
    if (codepoint >= 0x1f3fb as u32 && codepoint <= 0x1f3ff as u32) { return true; }
    return false;
}

public class TextBoundaryMap {
    public boundaries: Vec<i64>;
    public grapheme_codepoint_counts: Vec<i32>;
    public grapheme_directions: Vec<i32>;
    public byte_count: i64;
    public codepoint_count: i32;
    public grapheme_count: i32;
    public caret_stop_count: i32;
    public combining_sequence_count: i32;
    public joiner_sequence_count: i32;
    public emoji_sequence_count: i32;
    public rtl_grapheme_count: i32;
    public ltr_grapheme_count: i32;
    public rtl_run_count: i32;
    public ltr_run_count: i32;
    public direction_run_count: i32;
    public last_direction: i32;
    public max_grapheme_codepoints: i32;
    public max_grapheme_bytes: i64;
    public native_boundaries: bool;
    public native_boundary_error: i32;

    public static fn create() -> TextBoundaryMap {
        var out = TextBoundaryMap {
            boundaries: Vec::<i64>.new(),
            grapheme_codepoint_counts: Vec::<i32>.new(),
            grapheme_directions: Vec::<i32>.new(),
            byte_count: 0,
            codepoint_count: 0,
            grapheme_count: 0,
            caret_stop_count: 1,
            combining_sequence_count: 0,
            joiner_sequence_count: 0,
            emoji_sequence_count: 0,
            rtl_grapheme_count: 0,
            ltr_grapheme_count: 0,
            rtl_run_count: 0,
            ltr_run_count: 0,
            direction_run_count: 0,
            last_direction: 0,
            max_grapheme_codepoints: 0,
            max_grapheme_bytes: 0,
            native_boundaries: false,
            native_boundary_error: 0
        };
        out.boundaries.push(0);
        return out;
    }

    public fn recordGrapheme(mut self, start: i64, end_index: i64, codepoints: i32, has_extension: bool, has_joiner: bool, has_emoji: bool, has_rtl: bool) -> TextBoundaryMap {
        if (codepoints <= 0) { return self; }
        self.boundaries.push(end_index);
        self.grapheme_codepoint_counts.push(codepoints);
        self.grapheme_count = self.grapheme_count + 1;
        self.caret_stop_count = self.boundaries.len as i32;
        if (codepoints > self.max_grapheme_codepoints) {
            self.max_grapheme_codepoints = codepoints;
        }
        let byte_len = end_index - start;
        if (byte_len > self.max_grapheme_bytes) {
            self.max_grapheme_bytes = byte_len;
        }
        if (has_extension && codepoints > 1) {
            self.combining_sequence_count = self.combining_sequence_count + 1;
        }
        if (has_joiner) {
            self.joiner_sequence_count = self.joiner_sequence_count + 1;
        }
        if (has_emoji && (has_joiner || has_extension || codepoints > 1)) {
            self.emoji_sequence_count = self.emoji_sequence_count + 1;
        }
        var direction = 1;
        if (has_rtl) {
            direction = -1;
            self.rtl_grapheme_count = self.rtl_grapheme_count + 1;
        } else {
            self.ltr_grapheme_count = self.ltr_grapheme_count + 1;
        }
        self.grapheme_directions.push(direction);
        if (self.last_direction == 0 || self.last_direction != direction) {
            self.direction_run_count = self.direction_run_count + 1;
            if (direction < 0) {
                self.rtl_run_count = self.rtl_run_count + 1;
            } else {
                self.ltr_run_count = self.ltr_run_count + 1;
            }
        }
        self.last_direction = direction;
        return self;
    }

    public static fn analyze(text: string) -> TextBoundaryMap {
        var out = TextBoundaryMap.create();
        out.byte_count = text.len;
        if (text.len == 0) { return out; }

        var native_rc: i32 = 0;
        let max_boundaries = (text.len as i32) + 1;
        let max_graphemes = text.len as i32;
        while ((out.boundaries.len as i32) < max_boundaries) {
            out.boundaries.push(0);
        }
        while ((out.grapheme_codepoint_counts.len as i32) < max_graphemes) {
            out.grapheme_codepoint_counts.push(0);
            out.grapheme_directions.push(0);
        }
        var native_boundary_count: i32 = 0;
        var native_codepoint_count: i32 = 0;
        var native_combining_sequence_count: i32 = 0;
        var native_joiner_sequence_count: i32 = 0;
        var native_emoji_sequence_count: i32 = 0;
        var native_rtl_grapheme_count: i32 = 0;
        var native_ltr_grapheme_count: i32 = 0;
        var native_rtl_run_count: i32 = 0;
        var native_ltr_run_count: i32 = 0;
        var native_direction_run_count: i32 = 0;
        var native_max_grapheme_codepoints: i32 = 0;
        var native_max_grapheme_bytes: i64 = 0;
        native_rc = zyn_text_boundary_analyze_utf8(text.c_str(),
                                                   text.len as i32,
                                                   out.boundaries.data,
                                                   out.grapheme_codepoint_counts.data,
                                                   out.grapheme_directions.data,
                                                   max_boundaries,
                                                   max_graphemes,
                                                   to_rawptr(&native_boundary_count),
                                                   to_rawptr(&native_codepoint_count),
                                                   to_rawptr(&native_combining_sequence_count),
                                                   to_rawptr(&native_joiner_sequence_count),
                                                   to_rawptr(&native_emoji_sequence_count),
                                                   to_rawptr(&native_rtl_grapheme_count),
                                                   to_rawptr(&native_ltr_grapheme_count),
                                                   to_rawptr(&native_rtl_run_count),
                                                   to_rawptr(&native_ltr_run_count),
                                                   to_rawptr(&native_direction_run_count),
                                                   to_rawptr(&native_max_grapheme_codepoints),
                                                   to_rawptr(&native_max_grapheme_bytes));
        if (native_rc == 0 && native_boundary_count > 0) {
            let native_grapheme_count = native_boundary_count - 1;
            while ((out.boundaries.len as i32) > native_boundary_count) {
                out.boundaries.pop();
            }
            while ((out.grapheme_codepoint_counts.len as i32) > native_grapheme_count) {
                out.grapheme_codepoint_counts.pop();
                out.grapheme_directions.pop();
            }
            out.codepoint_count = native_codepoint_count;
            out.grapheme_count = native_grapheme_count;
            out.caret_stop_count = native_boundary_count;
            out.combining_sequence_count = native_combining_sequence_count;
            out.joiner_sequence_count = native_joiner_sequence_count;
            out.emoji_sequence_count = native_emoji_sequence_count;
            out.rtl_grapheme_count = native_rtl_grapheme_count;
            out.ltr_grapheme_count = native_ltr_grapheme_count;
            out.rtl_run_count = native_rtl_run_count;
            out.ltr_run_count = native_ltr_run_count;
            out.direction_run_count = native_direction_run_count;
            if (native_grapheme_count > 0) {
                out.last_direction = out.grapheme_directions.get((native_grapheme_count - 1) as i64);
            }
            out.max_grapheme_codepoints = native_max_grapheme_codepoints;
            out.max_grapheme_bytes = native_max_grapheme_bytes;
            out.native_boundaries = true;
            out.native_boundary_error = 0;
            return out;
        }

        out.destroy();
        out = TextBoundaryMap.create();
        out.byte_count = text.len;
        out.native_boundaries = false;
        out.native_boundary_error = native_rc;

        var scan: i64 = 0;
        var grapheme_start: i64 = 0;
        var grapheme_codepoints: i32 = 0;
        var grapheme_has_extension = false;
        var grapheme_has_joiner = false;
        var grapheme_has_emoji = false;
        var grapheme_has_rtl = false;
        var previous_was_joiner = false;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            let next = textNextUtf8Boundary(text, scan);
            let extends_previous = textCodepointExtendsPreviousGlyph(codepoint);
            let starts_new = scan > 0 && !extends_previous && !previous_was_joiner;
            if (starts_new) {
                out = out.recordGrapheme(grapheme_start, scan, grapheme_codepoints, grapheme_has_extension, grapheme_has_joiner, grapheme_has_emoji, grapheme_has_rtl);
                grapheme_start = scan;
                grapheme_codepoints = 0;
                grapheme_has_extension = false;
                grapheme_has_joiner = false;
                grapheme_has_emoji = false;
                grapheme_has_rtl = false;
            }
            grapheme_codepoints = grapheme_codepoints + 1;
            out.codepoint_count = out.codepoint_count + 1;
            if (extends_previous) { grapheme_has_extension = true; }
            if (textCodepointIsJoiner(codepoint)) { grapheme_has_joiner = true; }
            if (textCodepointIsEmoji(codepoint)) { grapheme_has_emoji = true; }
            if (textCodepointIsRtl(codepoint)) { grapheme_has_rtl = true; }
            previous_was_joiner = textCodepointIsJoiner(codepoint);
            scan = next;
        }
        out = out.recordGrapheme(grapheme_start, text.len, grapheme_codepoints, grapheme_has_extension, grapheme_has_joiner, grapheme_has_emoji, grapheme_has_rtl);
        return out;
    }

    public fn boundaryCount(&self) -> i32 {
        return self.boundaries.len as i32;
    }

    public fn caretStopCount(&self) -> i32 {
        return self.caret_stop_count;
    }

    public fn byteIndexForCaret(&self, index: i32) -> i64 {
        if (index <= 0) { return 0; }
        if (index >= self.boundaryCount()) { return self.byte_count; }
        return self.boundaries.get(index as i64);
    }

    public fn graphemeStart(&self, index: i32) -> i64 {
        if (index < 0) { return 0; }
        if (index >= self.grapheme_count) { return self.byte_count; }
        return self.byteIndexForCaret(index);
    }

    public fn graphemeEnd(&self, index: i32) -> i64 {
        if (index < 0) { return 0; }
        if (index >= self.grapheme_count) { return self.byte_count; }
        return self.byteIndexForCaret(index + 1);
    }

    public fn graphemeByteLength(&self, index: i32) -> i64 {
        if (index < 0 || index >= self.grapheme_count) { return 0; }
        return self.graphemeEnd(index) - self.graphemeStart(index);
    }

    public fn graphemeCodepointCountAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= (self.grapheme_codepoint_counts.len as i32)) { return 0; }
        return self.grapheme_codepoint_counts.get(index as i64);
    }

    public fn graphemeDirectionAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= (self.grapheme_directions.len as i32)) { return 0; }
        return self.grapheme_directions.get(index as i64);
    }

    public fn graphemeIsRtl(&self, index: i32) -> bool {
        return self.graphemeDirectionAt(index) < 0;
    }

    public fn isCaretBoundary(&self, byte_index: i64) -> bool {
        var i: i32 = 0;
        while (i < self.boundaryCount()) {
            if (self.boundaries.get(i as i64) == byte_index) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn caretIndexForByte(&self, byte_index: i64) -> i32 {
        if (byte_index <= 0) { return 0; }
        if (byte_index >= self.byte_count) { return self.boundaryCount() - 1; }
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < self.boundaryCount()) {
            if (self.boundaries.get(i as i64) <= byte_index) {
                out = i;
            }
            i = i + 1;
        }
        return out;
    }

    public fn nextCaretIndexAfterByte(&self, byte_index: i64) -> i32 {
        var i: i32 = 0;
        while (i < self.boundaryCount()) {
            if (self.boundaries.get(i as i64) > byte_index) { return i; }
            i = i + 1;
        }
        return self.boundaryCount() - 1;
    }

    public fn previousCaretIndexBeforeByte(&self, byte_index: i64) -> i32 {
        if (byte_index <= 0) { return 0; }
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < self.boundaryCount()) {
            if (self.boundaries.get(i as i64) < byte_index) {
                out = i;
            }
            i = i + 1;
        }
        return out;
    }

    public fn hasComplexGraphemes(&self) -> bool {
        return self.combining_sequence_count > 0 || self.joiner_sequence_count > 0 || self.emoji_sequence_count > 0;
    }

    public fn hasMixedDirection(&self) -> bool {
        return self.rtl_grapheme_count > 0 && self.ltr_grapheme_count > 0;
    }

    public fn usesNativeBoundaries(&self) -> bool {
        return self.native_boundaries;
    }

    public fn nativeBoundaryErrorCode(&self) -> i32 {
        return self.native_boundary_error;
    }

    public fn destroy(&mut self) {
        self.boundaries.destroy();
        self.grapheme_codepoint_counts.destroy();
        self.grapheme_directions.destroy();
        self.byte_count = 0;
        self.codepoint_count = 0;
        self.grapheme_count = 0;
        self.caret_stop_count = 0;
        self.combining_sequence_count = 0;
        self.joiner_sequence_count = 0;
        self.emoji_sequence_count = 0;
        self.rtl_grapheme_count = 0;
        self.ltr_grapheme_count = 0;
        self.rtl_run_count = 0;
        self.ltr_run_count = 0;
        self.direction_run_count = 0;
        self.last_direction = 0;
        self.max_grapheme_codepoints = 0;
        self.max_grapheme_bytes = 0;
        self.native_boundaries = false;
        self.native_boundary_error = 0;
    }
}

public class TextVisualMap {
    public visual_to_logical_graphemes: Vec<i32>;
    public logical_to_visual_graphemes: Vec<i32>;
    public run_first_graphemes: Vec<i32>;
    public run_lengths: Vec<i32>;
    public run_directions: Vec<i32>;
    public visual_run_to_logical_runs: Vec<i32>;
    public logical_run_to_visual_runs: Vec<i32>;
    public grapheme_count: i32;
    public visual_caret_count: i32;
    public rtl_run_count: i32;
    public ltr_run_count: i32;
    public mixed_direction: bool;
    public paragraph_direction: i32;
    public native_bidi: bool;
    public native_bidi_error: i32;

    public static fn empty() -> TextVisualMap {
        return TextVisualMap {
            visual_to_logical_graphemes: Vec::<i32>.new(),
            logical_to_visual_graphemes: Vec::<i32>.new(),
            run_first_graphemes: Vec::<i32>.new(),
            run_lengths: Vec::<i32>.new(),
            run_directions: Vec::<i32>.new(),
            visual_run_to_logical_runs: Vec::<i32>.new(),
            logical_run_to_visual_runs: Vec::<i32>.new(),
            grapheme_count: 0,
            visual_caret_count: 1,
            rtl_run_count: 0,
            ltr_run_count: 0,
            mixed_direction: false,
            paragraph_direction: 1,
            native_bidi: false,
            native_bidi_error: 0
        };
    }

    public static fn analyze(text: string) -> TextVisualMap {
        var boundaries = TextBoundaryMap.analyze(text);
        var out = TextVisualMap.fromTextAndBoundaryMap(text, &boundaries);
        boundaries.destroy();
        return out;
    }

    public static fn fromTextAndBoundaryMap(text: string, boundaries: &TextBoundaryMap) -> TextVisualMap {
        if (boundaries.grapheme_count <= 0) {
            return TextVisualMap.fromBoundaryMap(boundaries);
        }
        var out = TextVisualMap.empty();
        out.grapheme_count = boundaries.grapheme_count;
        out.visual_caret_count = out.grapheme_count + 1;
        var i: i32 = 0;
        while (i < out.grapheme_count) {
            out.visual_to_logical_graphemes.push(-1);
            out.logical_to_visual_graphemes.push(-1);
            i = i + 1;
        }

        var run_first = Vec::<i32>.new();
        var run_lengths = Vec::<i32>.new();
        var run_directions = Vec::<i32>.new();
        var visual_run_to_logical = Vec::<i32>.new();
        var logical_run_to_visual = Vec::<i32>.new();
        i = 0;
        while (i < out.grapheme_count) {
            run_first.push(0);
            run_lengths.push(0);
            run_directions.push(0);
            visual_run_to_logical.push(-1);
            logical_run_to_visual.push(-1);
            i = i + 1;
        }

        var run_count: i32 = 0;
        var paragraph_direction: i32 = 1;
        let rc = zyn_text_bidi_analyze_utf8(text.c_str(),
                                            text.len as i32,
                                            boundaries.boundaries.data,
                                            boundaries.boundaryCount(),
                                            out.visual_to_logical_graphemes.data,
                                            out.logical_to_visual_graphemes.data,
                                            run_first.data,
                                            run_lengths.data,
                                            run_directions.data,
                                            visual_run_to_logical.data,
                                            logical_run_to_visual.data,
                                            out.grapheme_count,
                                            to_rawptr(&run_count),
                                            to_rawptr(&paragraph_direction));
        if (rc == 0 && run_count >= 0 && run_count <= out.grapheme_count) {
            out.paragraph_direction = paragraph_direction;
            if (out.paragraph_direction == 0) { out.paragraph_direction = 1; }
            out.native_bidi = true;
            out.native_bidi_error = 0;
            i = 0;
            while (i < run_count) {
                let dir = run_directions.get(i as i64);
                out.run_first_graphemes.push(run_first.get(i as i64));
                out.run_lengths.push(run_lengths.get(i as i64));
                out.run_directions.push(dir);
                out.logical_run_to_visual_runs.push(logical_run_to_visual.get(i as i64));
                if (dir < 0) {
                    out.rtl_run_count = out.rtl_run_count + 1;
                } else {
                    out.ltr_run_count = out.ltr_run_count + 1;
                }
                i = i + 1;
            }
            i = 0;
            while (i < run_count) {
                out.visual_run_to_logical_runs.push(visual_run_to_logical.get(i as i64));
                i = i + 1;
            }
            out.mixed_direction = out.rtl_run_count > 0 && out.ltr_run_count > 0;
            run_first.destroy();
            run_lengths.destroy();
            run_directions.destroy();
            visual_run_to_logical.destroy();
            logical_run_to_visual.destroy();
            return out;
        }

        out.destroy();
        run_first.destroy();
        run_lengths.destroy();
        run_directions.destroy();
        visual_run_to_logical.destroy();
        logical_run_to_visual.destroy();
        var fallback = TextVisualMap.fromBoundaryMap(boundaries);
        fallback.native_bidi = false;
        fallback.native_bidi_error = rc;
        return fallback;
    }

    public static fn fromBoundaryMap(boundaries: &TextBoundaryMap) -> TextVisualMap {
        var out = TextVisualMap.empty();
        out.grapheme_count = boundaries.grapheme_count;
        out.visual_caret_count = out.grapheme_count + 1;
        out.rtl_run_count = boundaries.rtl_run_count;
        out.ltr_run_count = boundaries.ltr_run_count;
        out.mixed_direction = boundaries.hasMixedDirection();
        if (out.grapheme_count > 0) {
            out.paragraph_direction = boundaries.graphemeDirectionAt(0);
            if (out.paragraph_direction == 0) { out.paragraph_direction = 1; }
        }
        var i: i32 = 0;
        while (i < out.grapheme_count) {
            out.logical_to_visual_graphemes.push(-1);
            i = i + 1;
        }
        i = 0;
        while (i < out.grapheme_count) {
            let direction = boundaries.graphemeDirectionAt(i);
            let run_start = i;
            var run_len: i32 = 1;
            i = i + 1;
            while (i < out.grapheme_count && boundaries.graphemeDirectionAt(i) == direction) {
                run_len = run_len + 1;
                i = i + 1;
            }
            out.run_first_graphemes.push(run_start);
            out.run_lengths.push(run_len);
            out.run_directions.push(direction);
        }
        i = 0;
        while (i < out.runCount()) {
            out.logical_run_to_visual_runs.push(-1);
            i = i + 1;
        }
        var visual_run: i32 = 0;
        if (out.paragraph_direction < 0) {
            var rtl_run_i = out.runCount() - 1;
            while (rtl_run_i >= 0) {
                out.appendVisualRun(rtl_run_i, visual_run);
                visual_run = visual_run + 1;
                rtl_run_i = rtl_run_i - 1;
            }
        } else {
            var ltr_run_i: i32 = 0;
            while (ltr_run_i < out.runCount()) {
                out.appendVisualRun(ltr_run_i, visual_run);
                visual_run = visual_run + 1;
                ltr_run_i = ltr_run_i + 1;
            }
        }
        return out;
    }

    public fn appendVisualRun(&mut self, logical_run: i32, visual_run: i32) {
        if (logical_run < 0 || logical_run >= self.runCount()) { return; }
        self.visual_run_to_logical_runs.push(logical_run);
        self.logical_run_to_visual_runs.set(logical_run as i64, visual_run);
        let run_start = self.runFirstGrapheme(logical_run);
        let run_len = self.runLength(logical_run);
        let direction = self.runDirection(logical_run);
        if (direction < 0) {
            var rtl_i = run_start + run_len - 1;
            while (rtl_i >= run_start) {
                let visual_index = self.visual_to_logical_graphemes.len as i32;
                self.visual_to_logical_graphemes.push(rtl_i);
                self.logical_to_visual_graphemes.set(rtl_i as i64, visual_index);
                rtl_i = rtl_i - 1;
            }
        } else {
            var ltr_i = run_start;
            while (ltr_i < run_start + run_len) {
                let visual_index = self.visual_to_logical_graphemes.len as i32;
                self.visual_to_logical_graphemes.push(ltr_i);
                self.logical_to_visual_graphemes.set(ltr_i as i64, visual_index);
                ltr_i = ltr_i + 1;
            }
        }
    }

    public fn runCount(&self) -> i32 {
        return self.run_first_graphemes.len as i32;
    }

    public fn visualGraphemeCount(&self) -> i32 {
        return self.visual_to_logical_graphemes.len as i32;
    }

    public fn visualCaretCount(&self) -> i32 {
        return self.visual_caret_count;
    }

    public fn paragraphDirection(&self) -> i32 {
        return self.paragraph_direction;
    }

    public fn paragraphIsRtl(&self) -> bool {
        return self.paragraph_direction < 0;
    }

    public fn visualRunCount(&self) -> i32 {
        return self.visual_run_to_logical_runs.len as i32;
    }

    public fn runFirstGrapheme(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.runCount()) { return -1; }
        return self.run_first_graphemes.get(index as i64);
    }

    public fn runLength(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.runCount()) { return 0; }
        return self.run_lengths.get(index as i64);
    }

    public fn runDirection(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.runCount()) { return 0; }
        return self.run_directions.get(index as i64);
    }

    public fn visualRunToLogicalRun(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.visualRunCount()) { return -1; }
        return self.visual_run_to_logical_runs.get(index as i64);
    }

    public fn logicalRunToVisualRun(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.runCount()) { return -1; }
        return self.logical_run_to_visual_runs.get(index as i64);
    }

    public fn visualToLogicalGrapheme(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.visualGraphemeCount()) { return -1; }
        return self.visual_to_logical_graphemes.get(index as i64);
    }

    public fn logicalToVisualGrapheme(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.grapheme_count) { return -1; }
        return self.logical_to_visual_graphemes.get(index as i64);
    }

    public fn visualCaretForLogicalCaret(&self, caret_index: i32) -> i32 {
        if (self.grapheme_count <= 0) { return 0; }
        if (caret_index <= 0) {
            let dir = self.directionForLogicalGrapheme(0);
            let visual = self.logicalToVisualGrapheme(0);
            if (dir < 0) { return visual + 1; }
            return visual;
        }
        if (caret_index >= self.grapheme_count) {
            let last = self.grapheme_count - 1;
            let dir = self.directionForLogicalGrapheme(last);
            let visual = self.logicalToVisualGrapheme(last);
            if (dir < 0) { return visual; }
            return visual + 1;
        }
        let dir = self.directionForLogicalGrapheme(caret_index);
        let visual = self.logicalToVisualGrapheme(caret_index);
        if (dir < 0) { return visual + 1; }
        return visual;
    }

    public fn logicalCaretForVisualCaret(&self, visual_caret: i32) -> i32 {
        if (self.grapheme_count <= 0) { return 0; }
        var best_logical: i32 = 0;
        var best_distance: i32 = 2147483647;
        var logical: i32 = 0;
        while (logical <= self.grapheme_count) {
            var distance = self.visualCaretForLogicalCaret(logical) - visual_caret;
            if (distance < 0) { distance = 0 - distance; }
            if (distance < best_distance) {
                best_distance = distance;
                best_logical = logical;
            }
            logical = logical + 1;
        }
        return best_logical;
    }

    public fn directionForLogicalGrapheme(&self, index: i32) -> i32 {
        var run_i: i32 = 0;
        while (run_i < self.runCount()) {
            let first = self.runFirstGrapheme(run_i);
            let len = self.runLength(run_i);
            if (index >= first && index < first + len) {
                return self.runDirection(run_i);
            }
            run_i = run_i + 1;
        }
        return 0;
    }

    public fn usesNativeBidi(&self) -> bool {
        return self.native_bidi;
    }

    public fn nativeBidiErrorCode(&self) -> i32 {
        return self.native_bidi_error;
    }

    public fn destroy(&mut self) {
        self.visual_to_logical_graphemes.destroy();
        self.logical_to_visual_graphemes.destroy();
        self.run_first_graphemes.destroy();
        self.run_lengths.destroy();
        self.run_directions.destroy();
        self.visual_run_to_logical_runs.destroy();
        self.logical_run_to_visual_runs.destroy();
        self.grapheme_count = 0;
        self.visual_caret_count = 0;
        self.rtl_run_count = 0;
        self.ltr_run_count = 0;
        self.mixed_direction = false;
        self.paragraph_direction = 0;
        self.native_bidi = false;
        self.native_bidi_error = 0;
    }
}

public class FontFace {
    public handle: rawptr;
    public metrics: FontMetrics;
    public pixel_size: i32;
    public font_id: u32;

    public static fn open(path: string, pixel_size: i32) -> Result<FontFace, Error> {
        return FontFace.openWithId(path, pixel_size, 0 as u32);
    }

    public static fn openWithId(path: string, pixel_size: i32, font_id: u32) -> Result<FontFace, Error> {
        if (pixel_size <= 0) { return Err(Error.create(10, "font pixel size must be positive")); }
        var info = nativeFontInfoEmpty();
        let handle = zyn_text_font_open(path.c_str(), pixel_size, to_rawptr(&info));
        if (handle == null) {
            return Err(Error.create(11, "font open failed: " + path));
        }
        let metrics = FontMetrics.create(info);
        if (!metrics.isValid()) {
            zyn_text_font_close(handle);
            return Err(Error.create(12, "font metrics are invalid: " + path));
        }
        return Ok(FontFace { handle: handle, metrics: metrics, pixel_size: pixel_size, font_id: font_id });
    }

    public fn isOpen(&self) -> bool {
        return self.handle != null && self.metrics.isValid();
    }

    public fn shapeCount(&self, text: string) -> Result<i32, Error> {
        if (!self.isOpen()) { return Err(Error.create(13, "font is closed")); }
        let count = zyn_text_shape_count(self.handle, text.c_str(), text.len as i32);
        if (count < 0) { return Err(Error.create(14, "HarfBuzz shaping failed")); }
        return Ok(count);
    }

    public fn shape(&self, text: string) -> Result<TextLayout, Error> {
        if (!self.isOpen()) { return Err(Error.create(13, "font is closed")); }
        var count: i32 = 0;
        match (self.shapeCount(text)) {
            case Ok(v) => { count = v; }
            case Err(e) => { return Err(e); }
        }
        var layout = TextLayout.create();
        if (count == 0) { return Ok(layout); }
        let bytes = (count as i64) * sizeof::<NativeShapedGlyph>();
        let buffer = malloc(bytes);
        if (buffer == null) {
            return Err(Error.create(18, "text shape allocation failed"));
        }
        let shaped_count = zyn_text_shape(self.handle, text.c_str(), text.len as i32, buffer, count);
        if (shaped_count != count) {
            free(buffer);
            layout.destroy();
            return Err(Error.create(19, "HarfBuzz shape output count mismatch"));
        }
        var pen_x: i32 = 0;
        var pen_y: i32 = 0;
        var i: i32 = 0;
        while (i < count) {
            var native = nativeShapedGlyphEmpty();
            memcpy(to_rawptr(&native), buffer + ((i as i64) * sizeof::<NativeShapedGlyph>()), sizeof::<NativeShapedGlyph>());
            layout = layout.pushGlyph(shapedGlyphCreate(self.font_id, native.glyph_index, native.cluster, pen_x, pen_y, native.advance_x, native.advance_y, native.offset_x, native.offset_y));
            pen_x = pen_x + native.advance_x;
            pen_y = pen_y + native.advance_y;
            i = i + 1;
        }
        layout.advance_x = pen_x;
        layout.advance_y = pen_y;
        free(buffer);
        return Ok(layout);
    }

    public fn glyphIndex(&self, codepoint: u32) -> Result<u32, Error> {
        if (!self.isOpen()) { return Err(Error.create(13, "font is closed")); }
        return Ok(zyn_text_glyph_index(self.handle, codepoint));
    }

    public fn hasCodepoint(&self, codepoint: u32) -> bool {
        if (!self.isOpen()) { return false; }
        return zyn_text_glyph_index(self.handle, codepoint) != 0 as u32;
    }

    private fn measureLineAdvance(&self, text: string) -> Result<i32, Error> {
        var layout: TextLayout;
        match (self.shape(text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        let advance = layout.advance_x;
        layout.destroy();
        return Ok(advance);
    }

    private fn appendLineToBlock(&self, block: &mut TextBlock, line_text: string) -> Result<i32, Error> {
        var layout: TextLayout;
        match (self.shape(line_text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        let baseline_y = self.metrics.ascender + (block.lineCount() * block.line_height);
        block.pushLine(&layout, baseline_y);
        layout.destroy();
        return Ok(0);
    }

    private fn appendParagraphToBlock(&self, block: &mut TextBlock, text: string, start: i64, end_index: i64, options: TextLayoutOptions) -> Result<i32, Error> {
        if (start >= end_index) {
            return self.appendLineToBlock(block, "");
        }
        if (!options.wrap || options.max_width <= 0) {
            return self.appendLineToBlock(block, text.substring(start, end_index));
        }

        var line_start = start;
        var line_end = start;
        var last_break: i64 = -1;
        var i = start;
        while (i < end_index) {
            let c = text.charAt(i as i32);
            let next = textNextUtf8Boundary(text, i);
            if (textIsBreakSpace(c)) {
                last_break = next;
            }

            var candidate_advance: i32 = 0;
            match (self.measureLineAdvance(text.substring(line_start, next))) {
                case Ok(v) => { candidate_advance = v; }
                case Err(e) => { return Err(e); }
            }

            if (candidate_advance > options.max_width && line_end > line_start) {
                var break_end = line_end;
                if (last_break > line_start && last_break < next) {
                    break_end = last_break;
                }
                match (self.appendLineToBlock(block, text.substring(line_start, break_end))) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(e); }
                }
                line_start = break_end;
                while (line_start < end_index && textIsBreakSpace(text.charAt(line_start as i32))) {
                    line_start = textNextUtf8Boundary(text, line_start);
                }
                i = line_start;
                line_end = line_start;
                last_break = -1;
                continue;
            }

            line_end = next;
            i = next;
        }

        if (line_start < end_index) {
            match (self.appendLineToBlock(block, text.substring(line_start, end_index))) {
                case Ok(_) => {}
                case Err(e) => { return Err(e); }
            }
        } else {
            match (self.appendLineToBlock(block, "")) {
                case Ok(_) => {}
                case Err(e) => { return Err(e); }
            }
        }
        return Ok(0);
    }

    public fn layoutText(&self, text: string, options: TextLayoutOptions) -> Result<TextBlock, Error> {
        if (!self.isOpen()) { return Err(Error.create(13, "font is closed")); }
        let line_height = options.resolvedLineHeight(self.metrics);
        if (line_height <= 0) { return Err(Error.create(20, "text line height must be positive")); }
        var target_width = 0;
        if (options.max_width > 0) { target_width = options.max_width; }
        var block = TextBlock.create(line_height, self.metrics.ascender, self.metrics.descender, options.align, target_width);

        if (text.len == 0) {
            match (self.appendLineToBlock(&mut block, "")) {
                case Ok(_) => {}
                case Err(e) => {
                    block.destroy();
                    return Err(e);
                }
            }
            return Ok(block);
        }

        var paragraph_start: i64 = 0;
        var scan: i64 = 0;
        while (scan < text.len) {
            let c = text.charAt(scan as i32);
            if (textIsNewlineByte(c)) {
                match (self.appendParagraphToBlock(&mut block, text, paragraph_start, scan, options)) {
                    case Ok(_) => {}
                    case Err(e) => {
                        block.destroy();
                        return Err(e);
                    }
                }
                if (c == 13 && (scan + 1) < text.len && text.charAt((scan + 1) as i32) == 10) {
                    scan = scan + 2;
                } else {
                    scan = textNextUtf8Boundary(text, scan);
                }
                paragraph_start = scan;
                continue;
            }
            scan = textNextUtf8Boundary(text, scan);
        }

        match (self.appendParagraphToBlock(&mut block, text, paragraph_start, text.len, options)) {
            case Ok(_) => {}
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        return Ok(block);
    }

    public fn loadGlyph(&self, codepoint: u32) -> Result<GlyphBitmap, Error> {
        if (!self.isOpen()) { return Err(Error.create(15, "font is closed")); }
        var native = nativeGlyphBitmapEmpty();
        let rc = zyn_text_load_glyph(self.handle, codepoint, to_rawptr(&native));
        if (rc != 0) {
            return Err(Error.create(16, "FreeType glyph load failed"));
        }
        return Ok(GlyphBitmap.fromNative(codepoint, native));
    }

    public fn loadGlyphIndex(&self, glyph_index: u32) -> Result<GlyphBitmap, Error> {
        if (!self.isOpen()) { return Err(Error.create(15, "font is closed")); }
        var native = nativeGlyphBitmapEmpty();
        let rc = zyn_text_load_glyph_index(self.handle, glyph_index, to_rawptr(&native));
        if (rc != 0) {
            return Err(Error.create(16, "FreeType glyph index load failed"));
        }
        return Ok(GlyphBitmap.fromNative(glyph_index, native));
    }

    public fn close(&mut self) {
        if (self.handle != null) {
            zyn_text_font_close(self.handle);
        }
        self.handle = null;
        self.pixel_size = 0;
        self.font_id = 0 as u32;
    }
}

public class FontStackDiagnostics {
    public codepoint_count: i32;
    public missing_codepoint_count: i32;
    public fallback_codepoint_count: i32;
    public primary_codepoint_count: i32;
    public first_missing_codepoint: u32;
    public first_fallback_codepoint: u32;
    public missing_run_count: i32;
    public font_run_count: i32;
    public fallback_run_count: i32;
    public font_switch_count: i32;
    public extension_codepoint_count: i32;
    public leading_extension_count: i32;
    public combining_mark_count: i32;
    public variation_selector_count: i32;
    public joiner_codepoint_count: i32;
    public rtl_codepoint_count: i32;
    public arabic_codepoint_count: i32;
    public indic_codepoint_count: i32;
    public emoji_codepoint_count: i32;
    public script_run_count: i32;
    public max_script_run_length: i32;
    public complex_cluster_hint_count: i32;
    public max_font_run_length: i32;
    public max_fallback_run_length: i32;
    public max_missing_run_length: i32;

    public static fn empty() -> FontStackDiagnostics {
        return FontStackDiagnostics {
            codepoint_count: 0,
            missing_codepoint_count: 0,
            fallback_codepoint_count: 0,
            primary_codepoint_count: 0,
            first_missing_codepoint: 0 as u32,
            first_fallback_codepoint: 0 as u32,
            missing_run_count: 0,
            font_run_count: 0,
            fallback_run_count: 0,
            font_switch_count: 0,
            extension_codepoint_count: 0,
            leading_extension_count: 0,
            combining_mark_count: 0,
            variation_selector_count: 0,
            joiner_codepoint_count: 0,
            rtl_codepoint_count: 0,
            arabic_codepoint_count: 0,
            indic_codepoint_count: 0,
            emoji_codepoint_count: 0,
            script_run_count: 0,
            max_script_run_length: 0,
            complex_cluster_hint_count: 0,
            max_font_run_length: 0,
            max_fallback_run_length: 0,
            max_missing_run_length: 0
        };
    }

    public fn canShape(&self) -> bool {
        return self.missing_codepoint_count == 0;
    }

    public fn usesFallback(&self) -> bool {
        return self.fallback_codepoint_count > 0;
    }

    public fn hasExtensions(&self) -> bool {
        return self.extension_codepoint_count > 0;
    }

    public fn hasRtl(&self) -> bool {
        return self.rtl_codepoint_count > 0;
    }

    public fn hasArabic(&self) -> bool {
        return self.arabic_codepoint_count > 0;
    }

    public fn hasIndic(&self) -> bool {
        return self.indic_codepoint_count > 0;
    }

    public fn hasEmoji(&self) -> bool {
        return self.emoji_codepoint_count > 0;
    }

    public fn hasComplexClusterHints(&self) -> bool {
        return self.complex_cluster_hint_count > 0;
    }
}

public class FontStackRun {
    public font_index: i32;
    public byte_start: i64;
    public byte_end: i64;
    public codepoint_count: i32;
    public script_class: i32;
    public rtl_codepoint_count: i32;
    public emoji_codepoint_count: i32;
    public extension_codepoint_count: i32;

    public static fn empty() -> FontStackRun {
        return FontStackRun {
            font_index: -1,
            byte_start: -1,
            byte_end: -1,
            codepoint_count: 0,
            script_class: 0,
            rtl_codepoint_count: 0,
            emoji_codepoint_count: 0,
            extension_codepoint_count: 0
        };
    }

    public static fn create(font_index: i32, byte_start: i64, byte_end: i64, codepoint_count: i32, script_class: i32, rtl_count: i32, emoji_count: i32, extension_count: i32) -> FontStackRun {
        return FontStackRun {
            font_index: font_index,
            byte_start: byte_start,
            byte_end: byte_end,
            codepoint_count: codepoint_count,
            script_class: script_class,
            rtl_codepoint_count: rtl_count,
            emoji_codepoint_count: emoji_count,
            extension_codepoint_count: extension_count
        };
    }

    public fn isValid(&self) -> bool {
        return self.font_index >= 0 && self.byte_start >= 0 && self.byte_end >= self.byte_start;
    }

    public fn isFallback(&self) -> bool {
        return self.font_index > 0;
    }

    public fn isRtl(&self) -> bool {
        return self.rtl_codepoint_count > 0;
    }

    public fn hasEmoji(&self) -> bool {
        return self.emoji_codepoint_count > 0;
    }

    public fn hasExtensions(&self) -> bool {
        return self.extension_codepoint_count > 0;
    }
}

public class FontStack {
    private fonts: Vec<FontFace>;

    public static fn create() -> FontStack {
        return FontStack { fonts: Vec::<FontFace>.new() };
    }

    public static fn open(primary_path: string, pixel_size: i32) -> Result<FontStack, Error> {
        var stack = FontStack.create();
        return stack.addPath(primary_path, pixel_size);
    }

    public fn addPath(mut self, path: string, pixel_size: i32) -> Result<FontStack, Error> {
        let id = self.fontCount() as u32;
        var font: FontFace;
        match (FontFace.openWithId(path, pixel_size, id)) {
            case Ok(v) => { font = v; }
            case Err(e) => { return Err(e); }
        }
        self.fonts.push(font);
        return Ok(self);
    }

    public fn fontCount(&self) -> i32 {
        return self.fonts.len as i32;
    }

    public fn isOpen(&self) -> bool {
        return self.fontCount() > 0;
    }

    public fn primaryMetrics(&self) -> FontMetrics {
        if (self.fontCount() <= 0) {
            return FontMetrics { ascender: 0, descender: 0, height: 0, max_advance: 0, glyph_count: 0 };
        }
        return self.fonts.get(0).metrics;
    }

    public fn fontAt(&self, index: i32) -> FontFace {
        return self.fonts.get(index as i64);
    }

    public fn fontById(&self, font_id: u32) -> Option<FontFace> {
        var i: i32 = 0;
        while (i < self.fontCount()) {
            let font = self.fontAt(i);
            if (font.font_id == font_id) { return Some(font); }
            i = i + 1;
        }
        return None;
    }

    public fn chooseFontIndex(&self, codepoint: u32) -> i32 {
        if (self.fontCount() <= 0) { return -1; }
        if (codepoint == 0 as u32 || codepoint == 10 as u32 || codepoint == 13 as u32 || codepoint == 32 as u32 || codepoint == 9 as u32) {
            return 0;
        }
        if (textCodepointExtendsPreviousGlyph(codepoint)) { return 0; }
        var i: i32 = 0;
        while (i < self.fontCount()) {
            if (self.fontAt(i).hasCodepoint(codepoint)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn missingCodepointCount(&self, text: string) -> i32 {
        if (!self.isOpen()) { return text.len as i32; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index < 0) {
                count = count + 1;
            } else {
                current_font = font_index;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn firstMissingCodepoint(&self, text: string) -> u32 {
        if (!self.isOpen()) { return 0 as u32; }
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index < 0) { return codepoint; }
            current_font = font_index;
            scan = textNextUtf8Boundary(text, scan);
        }
        return 0 as u32;
    }

    public fn fallbackCodepointCount(&self, text: string) -> i32 {
        if (!self.isOpen()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index > 0) { count = count + 1; }
            if (font_index >= 0) { current_font = font_index; }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn firstFallbackCodepoint(&self, text: string) -> u32 {
        if (!self.isOpen()) { return 0 as u32; }
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index > 0) { return codepoint; }
            if (font_index >= 0) { current_font = font_index; } else { current_font = -1; }
            scan = textNextUtf8Boundary(text, scan);
        }
        return 0 as u32;
    }

    public fn fallbackRunCount(&self, text: string) -> i32 {
        if (!self.isOpen()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index < 0) {
                current_font = -1;
            } else {
                if (font_index != current_font && font_index > 0) { count = count + 1; }
                current_font = font_index;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn fontSwitchCount(&self, text: string) -> i32 {
        if (!self.isOpen()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                font_index = current_font;
            }
            if (font_index < 0) {
                current_font = -1;
            } else {
                if (current_font >= 0 && font_index != current_font) { count = count + 1; }
                current_font = font_index;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn fontCodepointCount(&self, font_index: i32, text: string) -> i32 {
        if (!self.isOpen() || font_index < 0 || font_index >= self.fontCount()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var chosen_font = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                chosen_font = current_font;
            }
            if (chosen_font == font_index) { count = count + 1; }
            if (chosen_font >= 0) { current_font = chosen_font; } else { current_font = -1; }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn fontRunCount(&self, text: string) -> i32 {
        if (!self.isOpen()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var chosen_font = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                chosen_font = current_font;
            }
            if (chosen_font < 0) {
                current_font = -1;
            } else {
                if (chosen_font != current_font) { count = count + 1; }
                current_font = chosen_font;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn fontRunCountForIndex(&self, font_index: i32, text: string) -> i32 {
        if (!self.isOpen() || font_index < 0 || font_index >= self.fontCount()) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            var chosen_font = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && textCodepointExtendsPreviousGlyph(codepoint)) {
                chosen_font = current_font;
            }
            if (chosen_font < 0) {
                current_font = -1;
            } else {
                if (chosen_font != current_font && chosen_font == font_index) { count = count + 1; }
                current_font = chosen_font;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn shapingRunCount(&self, text: string) -> i32 {
        if (!self.isOpen() || text.len == 0) { return 0; }
        var count: i32 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        var current_script: i32 = 0;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            let extends_previous = textCodepointExtendsPreviousGlyph(codepoint);
            let script_class = textCodepointScriptClass(codepoint);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && extends_previous) {
                font_index = current_font;
            }
            if (font_index < 0) {
                current_font = -1;
                current_script = 0;
            } else if (current_font < 0) {
                count = count + 1;
                current_font = font_index;
                current_script = script_class;
            } else if (font_index != current_font || (!extends_previous && script_class > 0 && current_script > 0 && script_class != current_script)) {
                count = count + 1;
                current_font = font_index;
                current_script = script_class;
            } else if (script_class > 0) {
                current_script = script_class;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return count;
    }

    public fn shapingRunAt(&self, text: string, run_index: i32) -> FontStackRun {
        if (!self.isOpen() || text.len == 0 || run_index < 0) { return FontStackRun.empty(); }
        var scan: i64 = 0;
        var current_font: i32 = -1;
        var current_script: i32 = 0;
        var run_start: i64 = 0;
        var run_end: i64 = 0;
        var run_codepoints: i32 = 0;
        var run_rtl: i32 = 0;
        var run_emoji: i32 = 0;
        var run_extensions: i32 = 0;
        var count: i32 = 0;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            let next = textNextUtf8Boundary(text, scan);
            let extends_previous = textCodepointExtendsPreviousGlyph(codepoint);
            let script_class = textCodepointScriptClass(codepoint);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && extends_previous) {
                font_index = current_font;
            }
            if (font_index < 0) {
                if (current_font >= 0) {
                    if (count == run_index) {
                        return FontStackRun.create(current_font, run_start, run_end, run_codepoints, current_script, run_rtl, run_emoji, run_extensions);
                    }
                    count = count + 1;
                }
                current_font = -1;
                current_script = 0;
                run_codepoints = 0;
                run_rtl = 0;
                run_emoji = 0;
                run_extensions = 0;
            } else {
                let breaks_run = current_font >= 0
                    && (font_index != current_font || (!extends_previous && script_class > 0 && current_script > 0 && script_class != current_script));
                if (breaks_run) {
                    if (count == run_index) {
                        return FontStackRun.create(current_font, run_start, run_end, run_codepoints, current_script, run_rtl, run_emoji, run_extensions);
                    }
                    count = count + 1;
                    current_font = font_index;
                    current_script = script_class;
                    run_start = scan;
                    run_codepoints = 0;
                    run_rtl = 0;
                    run_emoji = 0;
                    run_extensions = 0;
                } else if (current_font < 0) {
                    current_font = font_index;
                    current_script = script_class;
                    run_start = scan;
                    run_codepoints = 0;
                    run_rtl = 0;
                    run_emoji = 0;
                    run_extensions = 0;
                } else if (script_class > 0) {
                    current_script = script_class;
                }
                run_end = next;
                run_codepoints = run_codepoints + 1;
                if (textCodepointIsRtl(codepoint)) { run_rtl = run_rtl + 1; }
                if (textCodepointIsEmoji(codepoint)) { run_emoji = run_emoji + 1; }
                if (extends_previous) { run_extensions = run_extensions + 1; }
            }
            scan = next;
        }
        if (current_font >= 0 && count == run_index) {
            return FontStackRun.create(current_font, run_start, run_end, run_codepoints, current_script, run_rtl, run_emoji, run_extensions);
        }
        return FontStackRun.empty();
    }

    public fn diagnostics(&self, text: string) -> FontStackDiagnostics {
        var out = FontStackDiagnostics.empty();
        if (!self.isOpen()) {
            out.missing_codepoint_count = text.len as i32;
            return out;
        }
        var scan: i64 = 0;
        var current_font: i32 = -1;
        var current_run_length: i32 = 0;
        var current_fallback_run_length: i32 = 0;
        var current_missing_run_length: i32 = 0;
        var current_script: i32 = 0;
        var current_script_run_length: i32 = 0;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            let extends_previous = textCodepointExtendsPreviousGlyph(codepoint);
            let is_combining_mark = textCodepointIsCombiningMark(codepoint) || textCodepointIsIndicMark(codepoint);
            let is_variation_selector = textCodepointIsVariationSelector(codepoint);
            let is_joiner = textCodepointIsJoiner(codepoint);
            let is_rtl = textCodepointIsRtl(codepoint);
            let is_arabic = textCodepointIsArabic(codepoint);
            let is_indic = textCodepointIsIndic(codepoint);
            let is_emoji = textCodepointIsEmoji(codepoint);
            let script_class = textCodepointScriptClass(codepoint);
            out.codepoint_count = out.codepoint_count + 1;
            if (extends_previous) {
                out.extension_codepoint_count = out.extension_codepoint_count + 1;
                if (out.codepoint_count == 1) {
                    out.leading_extension_count = out.leading_extension_count + 1;
                }
            }
            if (is_combining_mark) { out.combining_mark_count = out.combining_mark_count + 1; }
            if (is_variation_selector) { out.variation_selector_count = out.variation_selector_count + 1; }
            if (is_joiner) { out.joiner_codepoint_count = out.joiner_codepoint_count + 1; }
            if (is_rtl) { out.rtl_codepoint_count = out.rtl_codepoint_count + 1; }
            if (is_arabic) { out.arabic_codepoint_count = out.arabic_codepoint_count + 1; }
            if (is_indic) { out.indic_codepoint_count = out.indic_codepoint_count + 1; }
            if (is_emoji) { out.emoji_codepoint_count = out.emoji_codepoint_count + 1; }
            if (extends_previous || is_rtl || is_indic || is_emoji) {
                out.complex_cluster_hint_count = out.complex_cluster_hint_count + 1;
            }
            if (script_class > 0) {
                if (script_class != current_script) {
                    out.script_run_count = out.script_run_count + 1;
                    current_script = script_class;
                    current_script_run_length = 0;
                }
                current_script_run_length = current_script_run_length + 1;
                if (current_script_run_length > out.max_script_run_length) {
                    out.max_script_run_length = current_script_run_length;
                }
            } else if (extends_previous && current_script > 0) {
                current_script_run_length = current_script_run_length + 1;
                if (current_script_run_length > out.max_script_run_length) {
                    out.max_script_run_length = current_script_run_length;
                }
            }
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && extends_previous) {
                font_index = current_font;
            }
            if (font_index < 0) {
                out.missing_codepoint_count = out.missing_codepoint_count + 1;
                if (out.first_missing_codepoint == 0 as u32) { out.first_missing_codepoint = codepoint; }
                if (current_missing_run_length == 0) {
                    out.missing_run_count = out.missing_run_count + 1;
                }
                current_missing_run_length = current_missing_run_length + 1;
                if (current_missing_run_length > out.max_missing_run_length) {
                    out.max_missing_run_length = current_missing_run_length;
                }
                current_font = -1;
                current_run_length = 0;
                current_fallback_run_length = 0;
            } else {
                current_missing_run_length = 0;
                if (current_font >= 0 && font_index != current_font) {
                    out.font_switch_count = out.font_switch_count + 1;
                }
                if (font_index != current_font) {
                    out.font_run_count = out.font_run_count + 1;
                    current_run_length = 0;
                    current_fallback_run_length = 0;
                    if (font_index > 0) {
                        out.fallback_run_count = out.fallback_run_count + 1;
                    }
                }
                current_run_length = current_run_length + 1;
                if (current_run_length > out.max_font_run_length) {
                    out.max_font_run_length = current_run_length;
                }
                if (font_index > 0) {
                    out.fallback_codepoint_count = out.fallback_codepoint_count + 1;
                    if (out.first_fallback_codepoint == 0 as u32) { out.first_fallback_codepoint = codepoint; }
                    current_fallback_run_length = current_fallback_run_length + 1;
                    if (current_fallback_run_length > out.max_fallback_run_length) {
                        out.max_fallback_run_length = current_fallback_run_length;
                    }
                } else {
                    out.primary_codepoint_count = out.primary_codepoint_count + 1;
                    current_fallback_run_length = 0;
                }
                current_font = font_index;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        return out;
    }

    public fn canShape(&self, text: string) -> bool {
        return self.isOpen() && self.missingCodepointCount(text) == 0;
    }

    private fn appendRun(&self, layout: TextLayout, font: FontFace, text: string, cluster_offset: i64) -> Result<TextLayout, Error> {
        var run: TextLayout;
        match (font.shape(text)) {
            case Ok(v) => { run = v; }
            case Err(e) => { return Err(e); }
        }
        var out = layout;
        var i: i32 = 0;
        while (i < run.glyphCount()) {
            let g = run.glyphAt(i);
            out = out.pushGlyph(shapedGlyphCreate(g.font_id, g.glyph_index, g.cluster_id + (cluster_offset as u32), out.advance_x + g.x, out.advance_y + g.y, g.advance_x, g.advance_y, g.offset_x, g.offset_y));
            i = i + 1;
        }
        out.advance_x = out.advance_x + run.advance_x;
        out.advance_y = out.advance_y + run.advance_y;
        run.destroy();
        return Ok(out);
    }

    public fn shape(&self, text: string) -> Result<TextLayout, Error> {
        if (!self.isOpen()) { return Err(Error.create(30, "font stack is empty")); }
        var layout = TextLayout.create();
        if (text.len == 0) { return Ok(layout); }
        var run_start: i64 = 0;
        var scan: i64 = 0;
        var current_font: i32 = -1;
        var current_script: i32 = 0;
        while (scan < text.len) {
            let codepoint = textCodepointAt(text, scan);
            let extends_previous = textCodepointExtendsPreviousGlyph(codepoint);
            let script_class = textCodepointScriptClass(codepoint);
            var font_index = self.chooseFontIndex(codepoint);
            if (current_font >= 0 && extends_previous) {
                font_index = current_font;
            }
            if (font_index < 0) {
                layout.destroy();
                return Err(Error.create(31, "font stack has no face for a codepoint"));
            }
            if (current_font < 0) {
                current_font = font_index;
                current_script = script_class;
                run_start = scan;
            } else if (font_index != current_font || (!extends_previous && script_class > 0 && current_script > 0 && script_class != current_script)) {
                match (self.appendRun(layout, self.fontAt(current_font), text.substring(run_start, scan), run_start)) {
                    case Ok(v) => { layout = v; }
                    case Err(e) => {
                        layout.destroy();
                        return Err(e);
                    }
                }
                current_font = font_index;
                current_script = script_class;
                run_start = scan;
            } else if (script_class > 0) {
                current_script = script_class;
            }
            scan = textNextUtf8Boundary(text, scan);
        }
        if (current_font >= 0) {
            match (self.appendRun(layout, self.fontAt(current_font), text.substring(run_start, text.len), run_start)) {
                case Ok(v) => { layout = v; }
                case Err(e) => {
                    layout.destroy();
                    return Err(e);
                }
            }
        }
        return Ok(layout);
    }

    private fn measureLineAdvance(&self, text: string) -> Result<i32, Error> {
        var layout: TextLayout;
        match (self.shape(text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        let advance = layout.advance_x;
        layout.destroy();
        return Ok(advance);
    }

    private fn appendLineToBlock(&self, block: &mut TextBlock, line_text: string) -> Result<i32, Error> {
        var layout: TextLayout;
        match (self.shape(line_text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        let baseline_y = self.primaryMetrics().ascender + (block.lineCount() * block.line_height);
        block.pushLine(&layout, baseline_y);
        layout.destroy();
        return Ok(0);
    }

    private fn appendParagraphToBlock(&self, block: &mut TextBlock, text: string, start: i64, end_index: i64, options: TextLayoutOptions) -> Result<i32, Error> {
        if (start >= end_index) {
            return self.appendLineToBlock(block, "");
        }
        if (!options.wrap || options.max_width <= 0) {
            return self.appendLineToBlock(block, text.substring(start, end_index));
        }

        var line_start = start;
        var line_end = start;
        var last_break: i64 = -1;
        var i = start;
        while (i < end_index) {
            let c = text.charAt(i as i32);
            let next = textNextUtf8Boundary(text, i);
            if (textIsBreakSpace(c)) {
                last_break = next;
            }

            var candidate_advance: i32 = 0;
            match (self.measureLineAdvance(text.substring(line_start, next))) {
                case Ok(v) => { candidate_advance = v; }
                case Err(e) => { return Err(e); }
            }

            if (candidate_advance > options.max_width && line_end > line_start) {
                var break_end = line_end;
                if (last_break > line_start && last_break < next) {
                    break_end = last_break;
                }
                match (self.appendLineToBlock(block, text.substring(line_start, break_end))) {
                    case Ok(_) => {}
                    case Err(e) => { return Err(e); }
                }
                line_start = break_end;
                while (line_start < end_index && textIsBreakSpace(text.charAt(line_start as i32))) {
                    line_start = textNextUtf8Boundary(text, line_start);
                }
                i = line_start;
                line_end = line_start;
                last_break = -1;
                continue;
            }

            line_end = next;
            i = next;
        }

        if (line_start < end_index) {
            match (self.appendLineToBlock(block, text.substring(line_start, end_index))) {
                case Ok(_) => {}
                case Err(e) => { return Err(e); }
            }
        } else {
            match (self.appendLineToBlock(block, "")) {
                case Ok(_) => {}
                case Err(e) => { return Err(e); }
            }
        }
        return Ok(0);
    }

    public fn layoutText(&self, text: string, options: TextLayoutOptions) -> Result<TextBlock, Error> {
        if (!self.isOpen()) { return Err(Error.create(30, "font stack is empty")); }
        let metrics = self.primaryMetrics();
        let line_height = options.resolvedLineHeight(metrics);
        if (line_height <= 0) { return Err(Error.create(32, "text line height must be positive")); }
        var target_width = 0;
        if (options.max_width > 0) { target_width = options.max_width; }
        var block = TextBlock.create(line_height, metrics.ascender, metrics.descender, options.align, target_width);

        if (text.len == 0) {
            match (self.appendLineToBlock(&mut block, "")) {
                case Ok(_) => {}
                case Err(e) => {
                    block.destroy();
                    return Err(e);
                }
            }
            return Ok(block);
        }

        var paragraph_start: i64 = 0;
        var scan: i64 = 0;
        while (scan < text.len) {
            let c = text.charAt(scan as i32);
            if (textIsNewlineByte(c)) {
                match (self.appendParagraphToBlock(&mut block, text, paragraph_start, scan, options)) {
                    case Ok(_) => {}
                    case Err(e) => {
                        block.destroy();
                        return Err(e);
                    }
                }
                if (c == 13 && (scan + 1) < text.len && text.charAt((scan + 1) as i32) == 10) {
                    scan = scan + 2;
                } else {
                    scan = textNextUtf8Boundary(text, scan);
                }
                paragraph_start = scan;
                continue;
            }
            scan = textNextUtf8Boundary(text, scan);
        }

        match (self.appendParagraphToBlock(&mut block, text, paragraph_start, text.len, options)) {
            case Ok(_) => {}
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        return Ok(block);
    }

    public fn close(&mut self) {
        var i: i32 = 0;
        while (i < self.fontCount()) {
            var font = self.fontAt(i);
            font.close();
            self.fonts.set(i as i64, font);
            i = i + 1;
        }
    }

    public fn destroy(&mut self) {
        self.close();
        self.fonts.destroy();
    }
}

public class CachedGlyph {
    public font_id: u32;
    public codepoint: u32;
    public glyph_index: u32;
    public region: AtlasRegion;
    public advance_x: i32;
    public bearing_x: i32;
    public bearing_y: i32;
    public cached: bool;

    public static fn create(font_id: u32, codepoint: u32, region: AtlasRegion, glyph: GlyphBitmap) -> CachedGlyph {
        return CachedGlyph {
            font_id: font_id,
            codepoint: codepoint,
            glyph_index: codepoint,
            region: region.clone(),
            advance_x: glyph.advance_x,
            bearing_x: glyph.bearing_x,
            bearing_y: glyph.bearing_y,
            cached: true
        };
    }

    public static fn createIndexed(font_id: u32, glyph_index: u32, region: AtlasRegion, glyph: GlyphBitmap) -> CachedGlyph {
        return CachedGlyph {
            font_id: font_id,
            codepoint: glyph_index,
            glyph_index: glyph_index,
            region: region.clone(),
            advance_x: glyph.advance_x,
            bearing_x: glyph.bearing_x,
            bearing_y: glyph.bearing_y,
            cached: true
        };
    }

    public fn clone(&self) -> CachedGlyph {
        return CachedGlyph {
            font_id: self.font_id,
            codepoint: self.codepoint,
            glyph_index: self.glyph_index,
            region: self.region.clone(),
            advance_x: self.advance_x,
            bearing_x: self.bearing_x,
            bearing_y: self.bearing_y,
            cached: self.cached
        };
    }
}

public class GlyphCache {
    public atlas: Atlas;
    private glyphs: Vec<CachedGlyph>;
    public color: Color;
    private generation: i32;
    private resize_invalidation_count: i32;
    private request_count: i32;
    private hit_count: i32;
    private miss_count: i32;
    private atlas_growth_count: i32;
    private generation_request_count: i32;
    private generation_hit_count: i32;
    private generation_miss_count: i32;
    private generation_atlas_growth_count: i32;
    private last_invalidated_glyph_count: i32;
    private last_invalidated_drawable_glyph_count: i32;
    private last_invalidated_atlas_bytes: u64;
    private total_invalidated_glyph_count: i32;
    private total_invalidated_drawable_glyph_count: i32;
    private total_invalidated_atlas_bytes: u64;

    public static fn create(width: i32, height: i32, padding: i32, color: Color) -> GlyphCache {
        return GlyphCache { atlas: Atlas.create(width, height, padding), glyphs: Vec::<CachedGlyph>.new(), color: color, generation: 0, resize_invalidation_count: 0, request_count: 0, hit_count: 0, miss_count: 0, atlas_growth_count: 0, generation_request_count: 0, generation_hit_count: 0, generation_miss_count: 0, generation_atlas_growth_count: 0, last_invalidated_glyph_count: 0, last_invalidated_drawable_glyph_count: 0, last_invalidated_atlas_bytes: 0 as u64, total_invalidated_glyph_count: 0, total_invalidated_drawable_glyph_count: 0, total_invalidated_atlas_bytes: 0 as u64 };
    }

    public fn glyphCount(&self) -> i32 {
        return self.glyphs.len as i32;
    }

    public fn cacheGeneration(&self) -> i32 {
        return self.generation;
    }

    public fn resizeInvalidationCount(&self) -> i32 {
        return self.resize_invalidation_count;
    }

    public fn cacheRequestCount(&self) -> i32 {
        return self.request_count;
    }

    public fn cacheHitCount(&self) -> i32 {
        return self.hit_count;
    }

    public fn cacheMissCount(&self) -> i32 {
        return self.miss_count;
    }

    public fn atlasGrowthCount(&self) -> i32 {
        return self.atlas_growth_count;
    }

    public fn cacheHitRatePermille(&self) -> i32 {
        if (self.request_count <= 0) { return 0; }
        return (((self.hit_count as i64) * 1000) / (self.request_count as i64)) as i32;
    }

    public fn generationCacheRequestCount(&self) -> i32 {
        return self.generation_request_count;
    }

    public fn generationCacheHitCount(&self) -> i32 {
        return self.generation_hit_count;
    }

    public fn generationCacheMissCount(&self) -> i32 {
        return self.generation_miss_count;
    }

    public fn generationAtlasGrowthCount(&self) -> i32 {
        return self.generation_atlas_growth_count;
    }

    public fn cacheInvalidationCount(&self) -> i32 {
        return self.generation;
    }

    public fn lastInvalidatedGlyphCount(&self) -> i32 {
        return self.last_invalidated_glyph_count;
    }

    public fn lastInvalidatedDrawableGlyphCount(&self) -> i32 {
        return self.last_invalidated_drawable_glyph_count;
    }

    public fn lastInvalidatedAtlasBytes(&self) -> u64 {
        return self.last_invalidated_atlas_bytes;
    }

    public fn totalInvalidatedGlyphCount(&self) -> i32 {
        return self.total_invalidated_glyph_count;
    }

    public fn totalInvalidatedDrawableGlyphCount(&self) -> i32 {
        return self.total_invalidated_drawable_glyph_count;
    }

    public fn totalInvalidatedAtlasBytes(&self) -> u64 {
        return self.total_invalidated_atlas_bytes;
    }

    public fn generationCacheHitRatePermille(&self) -> i32 {
        if (self.generation_request_count <= 0) { return 0; }
        return (((self.generation_hit_count as i64) * 1000) / (self.generation_request_count as i64)) as i32;
    }

    public fn atlasUtilizationPermille(&self) -> i32 {
        if (self.atlas.width <= 0 || self.atlas.height <= 0) { return 0; }
        return (((self.atlas.used_area as i64) * 1000) / ((self.atlas.width * self.atlas.height) as i64)) as i32;
    }

    public fn shouldInvalidateForAtlasPressure(&self, max_utilization_permille: i32) -> bool {
        if (max_utilization_permille <= 0) { return false; }
        if (max_utilization_permille > 1000) { return false; }
        return self.atlasUtilizationPermille() >= max_utilization_permille;
    }

    public fn invalidateOnAtlasPressure(mut self, max_utilization_permille: i32) -> Result<GlyphCache, Error> {
        if (max_utilization_permille <= 0 || max_utilization_permille > 1000) {
            return Err(Error.create(35, "glyph cache atlas pressure threshold is invalid"));
        }
        if (!self.shouldInvalidateForAtlasPressure(max_utilization_permille)) {
            return Ok(self);
        }
        return Ok(self.invalidate());
    }

    private fn resetGenerationMetrics(&mut self) {
        self.generation_request_count = 0;
        self.generation_hit_count = 0;
        self.generation_miss_count = 0;
        self.generation_atlas_growth_count = 0;
    }

    private fn drawableGlyphCountInCache(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let glyph = self.glyphs.get(i as i64);
            if (glyph.cached && glyph.region.isValid()) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    private fn recordInvalidationStats(&mut self) {
        self.last_invalidated_glyph_count = self.glyphCount();
        self.last_invalidated_drawable_glyph_count = self.drawableGlyphCountInCache();
        self.last_invalidated_atlas_bytes = (self.atlas.width as u64) * (self.atlas.height as u64) * (4 as u64);
        self.total_invalidated_glyph_count = self.total_invalidated_glyph_count + self.last_invalidated_glyph_count;
        self.total_invalidated_drawable_glyph_count = self.total_invalidated_drawable_glyph_count + self.last_invalidated_drawable_glyph_count;
        self.total_invalidated_atlas_bytes = self.total_invalidated_atlas_bytes + self.last_invalidated_atlas_bytes;
    }

    public fn invalidate(mut self) -> GlyphCache {
        let width = self.atlas.width;
        let height = self.atlas.height;
        let padding = self.atlas.padding;
        self.recordInvalidationStats();
        self.glyphs.destroy();
        self.glyphs = Vec::<CachedGlyph>.new();
        self.atlas.destroy();
        self.atlas = Atlas.create(width, height, padding);
        self.generation = self.generation + 1;
        self.resetGenerationMetrics();
        return self;
    }

    public fn invalidateToSize(mut self, width: i32, height: i32) -> Result<GlyphCache, Error> {
        if (width <= 0 || height <= 0) {
            return Err(Error.create(34, "glyph cache dimensions are invalid"));
        }
        let padding = self.atlas.padding;
        self.recordInvalidationStats();
        self.glyphs.destroy();
        self.glyphs = Vec::<CachedGlyph>.new();
        self.atlas.destroy();
        self.atlas = Atlas.create(width, height, padding);
        self.generation = self.generation + 1;
        self.resize_invalidation_count = self.resize_invalidation_count + 1;
        self.resetGenerationMetrics();
        return Ok(self);
    }

    public fn invalidateOnSizeChange(mut self, width: i32, height: i32) -> Result<GlyphCache, Error> {
        if (width <= 0 || height <= 0) {
            return Err(Error.create(34, "glyph cache dimensions are invalid"));
        }
        if (self.atlas.width == width && self.atlas.height == height) {
            return Ok(self);
        }
        return self.invalidateToSize(width, height);
    }

    public fn find(&self, codepoint: u32) -> CachedGlyph {
        return self.findForFont(0 as u32, codepoint);
    }

    public fn findForFont(&self, font_id: u32, codepoint: u32) -> CachedGlyph {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let glyph = self.glyphs.get(i as i64);
            if (glyph.font_id == font_id && glyph.codepoint == codepoint) { return glyph; }
            i = i + 1;
        }
        return CachedGlyph { font_id: 0 as u32, codepoint: 0 as u32, glyph_index: 0 as u32, region: AtlasRegion.invalid(), advance_x: 0, bearing_x: 0, bearing_y: 0, cached: false };
    }

    public fn hasGlyph(&self, codepoint: u32) -> bool {
        let glyph = self.find(codepoint);
        return glyph.region.isValid();
    }

    public fn findGlyphIndex(&self, glyph_index: u32) -> CachedGlyph {
        return self.findGlyph(0 as u32, glyph_index);
    }

    public fn findGlyph(&self, font_id: u32, glyph_index: u32) -> CachedGlyph {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            let glyph = self.glyphs.get(i as i64);
            if (glyph.font_id == font_id && glyph.glyph_index == glyph_index) { return glyph; }
            i = i + 1;
        }
        return CachedGlyph { font_id: 0 as u32, codepoint: 0 as u32, glyph_index: 0 as u32, region: AtlasRegion.invalid(), advance_x: 0, bearing_x: 0, bearing_y: 0, cached: false };
    }

    public fn hasGlyphIndex(&self, glyph_index: u32) -> bool {
        let glyph = self.findGlyphIndex(glyph_index);
        return glyph.region.isValid();
    }

    public fn hasGlyphForFont(&self, font_id: u32, glyph_index: u32) -> bool {
        let glyph = self.findGlyph(font_id, glyph_index);
        return glyph.region.isValid();
    }

    private fn colorWithAlpha(&self, alpha: u8) -> u32 {
        let a = alpha as u32;
        let r = ((self.color.r * 255.0) as u32) & 255 as u32;
        let g = ((self.color.g * 255.0) as u32) & 255 as u32;
        let b = ((self.color.b * 255.0) as u32) & 255 as u32;
        return (a << 24) | (b << 16) | (g << 8) | r;
    }

    private fn refreshGlyphAtlasSize(&mut self) {
        var i: i32 = 0;
        while (i < self.glyphCount()) {
            var glyph = self.glyphs.get(i as i64);
            if (glyph.region.isValid()) {
                glyph.region.atlas_width = self.atlas.width;
                glyph.region.atlas_height = self.atlas.height;
                self.glyphs.set(i as i64, glyph);
            }
            i = i + 1;
        }
    }

    private fn ensureAtlasForGlyph(&mut self, width: i32, height: i32) -> Result<i32, Error> {
        let before_width = self.atlas.width;
        let before_height = self.atlas.height;
        match (self.atlas.ensureCanAdd(width, height)) {
            case Ok(_) => {}
            case Err(e) => { return Err(e); }
        }
        if (self.atlas.width != before_width || self.atlas.height != before_height) {
            self.refreshGlyphAtlasSize();
            self.atlas_growth_count = self.atlas_growth_count + 1;
            self.generation_atlas_growth_count = self.generation_atlas_growth_count + 1;
        }
        return Ok(0);
    }

    public fn cacheGlyph(&mut self, font: &FontFace, codepoint: u32) -> Result<CachedGlyph, Error> {
        self.request_count = self.request_count + 1;
        self.generation_request_count = self.generation_request_count + 1;
        let existing = self.findForFont(font.font_id, codepoint);
        if (existing.cached) {
            self.hit_count = self.hit_count + 1;
            self.generation_hit_count = self.generation_hit_count + 1;
            return Ok(existing);
        }
        self.miss_count = self.miss_count + 1;
        self.generation_miss_count = self.generation_miss_count + 1;
        var bitmap: GlyphBitmap;
        match (font.loadGlyph(codepoint)) {
            case Ok(v) => { bitmap = v; }
            case Err(e) => { return Err(e); }
        }
        var region = AtlasRegion.invalid();
        if (bitmap.width > 0 && bitmap.height > 0) {
            let glyph_w: i32 = loadI32(to_rawptr(&bitmap.width));
            let glyph_h: i32 = loadI32(to_rawptr(&bitmap.height));
            match (self.ensureAtlasForGlyph(glyph_w, glyph_h)) {
                case Ok(_) => {}
                case Err(e) => {
                    bitmap.destroy();
                    return Err(e);
                }
            }
            region = self.atlas.add("glyph", glyph_w, glyph_h);
            if (!region.isValid()) {
                bitmap.destroy();
                return Err(Error.create(17, "glyph atlas is full"));
            }
            var y: i32 = 0;
            while (y < glyph_h) {
                var x: i32 = 0;
                while (x < glyph_w) {
                    let flipped_x: i32 = (glyph_w - 1) - x;
                    let alpha = bitmap.alphaAt(flipped_x, y);
                    let rx = loadI32(to_rawptr(&region.x));
                    let ry = loadI32(to_rawptr(&region.y));
                    self.atlas.setPixel(rx + x, ry + y, self.colorWithAlpha(alpha));
                    x = x + 1;
                }
                y = y + 1;
            }
            self.atlas.markDirtyRect(region.x, region.y, region.width, region.height);
        }
        let cached = CachedGlyph.create(font.font_id, codepoint, region, bitmap);
        self.glyphs.push(cached);
        bitmap.destroy();
        return Ok(cached);
    }

    public fn cacheGlyphIndex(&mut self, font: &FontFace, glyph_index: u32) -> Result<CachedGlyph, Error> {
        self.request_count = self.request_count + 1;
        self.generation_request_count = self.generation_request_count + 1;
        let existing = self.findGlyph(font.font_id, glyph_index);
        if (existing.cached) {
            self.hit_count = self.hit_count + 1;
            self.generation_hit_count = self.generation_hit_count + 1;
            return Ok(existing);
        }
        self.miss_count = self.miss_count + 1;
        self.generation_miss_count = self.generation_miss_count + 1;
        var bitmap: GlyphBitmap;
        match (font.loadGlyphIndex(glyph_index)) {
            case Ok(v) => { bitmap = v; }
            case Err(e) => { return Err(e); }
        }
        var region = AtlasRegion.invalid();
        if (bitmap.width > 0 && bitmap.height > 0) {
            let glyph_w: i32 = loadI32(to_rawptr(&bitmap.width));
            let glyph_h: i32 = loadI32(to_rawptr(&bitmap.height));
            match (self.ensureAtlasForGlyph(glyph_w, glyph_h)) {
                case Ok(_) => {}
                case Err(e) => {
                    bitmap.destroy();
                    return Err(e);
                }
            }
            region = self.atlas.add("glyph", glyph_w, glyph_h);
            if (!region.isValid()) {
                bitmap.destroy();
                return Err(Error.create(17, "glyph atlas is full"));
            }
            var y: i32 = 0;
            while (y < glyph_h) {
                var x: i32 = 0;
                while (x < glyph_w) {
                    let flipped_x: i32 = (glyph_w - 1) - x;
                    let alpha = bitmap.alphaAt(flipped_x, y);
                    let rx = loadI32(to_rawptr(&region.x));
                    let ry = loadI32(to_rawptr(&region.y));
                    self.atlas.setPixel(rx + x, ry + y, self.colorWithAlpha(alpha));
                    x = x + 1;
                }
                y = y + 1;
            }
            self.atlas.markDirtyRect(region.x, region.y, region.width, region.height);
        }
        let cached = CachedGlyph.createIndexed(font.font_id, glyph_index, region, bitmap);
        self.glyphs.push(cached);
        bitmap.destroy();
        return Ok(cached);
    }

    public fn cacheLayout(&mut self, font: &FontFace, layout: &TextLayout) -> Result<i32, Error> {
        var cached_count: i32 = 0;
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let shaped = layout.glyphAt(i);
            match (self.cacheGlyphIndex(font, shaped.glyph_index)) {
                case Ok(_) => { cached_count = cached_count + 1; }
                case Err(e) => { return Err(e); }
            }
            i = i + 1;
        }
        return Ok(cached_count);
    }

    public fn cacheLayoutWithStack(&mut self, fonts: &FontStack, layout: &TextLayout) -> Result<i32, Error> {
        var cached_count: i32 = 0;
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let shaped = layout.glyphAt(i);
            var font: FontFace;
            match (fonts.fontById(shaped.font_id)) {
                case Some(v) => { font = v; }
                case None => { return Err(Error.create(33, "font stack is missing a shaped glyph face")); }
            }
            match (self.cacheGlyphIndex(&font, shaped.glyph_index)) {
                case Ok(_) => { cached_count = cached_count + 1; }
                case Err(e) => { return Err(e); }
            }
            i = i + 1;
        }
        return Ok(cached_count);
    }

    public fn cacheBlock(&mut self, font: &FontFace, block: &TextBlock) -> Result<i32, Error> {
        var cached_count: i32 = 0;
        var i: i32 = 0;
        while (i < block.glyphCount()) {
            let shaped = block.glyphAt(i);
            match (self.cacheGlyphIndex(font, shaped.glyph_index)) {
                case Ok(_) => { cached_count = cached_count + 1; }
                case Err(e) => { return Err(e); }
            }
            i = i + 1;
        }
        return Ok(cached_count);
    }

    public fn cacheBlockWithStack(&mut self, fonts: &FontStack, block: &TextBlock) -> Result<i32, Error> {
        var cached_count: i32 = 0;
        var i: i32 = 0;
        while (i < block.glyphCount()) {
            let shaped = block.glyphAt(i);
            var font: FontFace;
            match (fonts.fontById(shaped.font_id)) {
                case Some(v) => { font = v; }
                case None => { return Err(Error.create(33, "font stack is missing a shaped glyph face")); }
            }
            match (self.cacheGlyphIndex(&font, shaped.glyph_index)) {
                case Ok(_) => { cached_count = cached_count + 1; }
                case Err(e) => { return Err(e); }
            }
            i = i + 1;
        }
        return Ok(cached_count);
    }

    public fn cachedDrawableGlyphsForLayout(&self, layout: &TextLayout) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let shaped = layout.glyphAt(i);
            let cached = self.findGlyph(shaped.font_id, shaped.glyph_index);
            if (cached.cached && cached.region.isValid()) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    public fn cachedDrawableGlyphsForBlock(&self, block: &TextBlock) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < block.glyphCount()) {
            let shaped = block.glyphAt(i);
            let cached = self.findGlyph(shaped.font_id, shaped.glyph_index);
            if (cached.cached && cached.region.isValid()) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    private fn glyphX(&self, line_advance: i32, shaped_x: i32, offset_x: i32, bearing_x: i32, glyph_width: i32) -> f32 {
        return (shaped_x + offset_x + bearing_x) as f32;
    }

    public fn layoutVisualBounds(&self, layout: &TextLayout, x: f32, baseline_y: f32) -> Rectangle {
        var out = Rectangle.xywh(0.0, 0.0, 0.0, 0.0);
        var has_bounds = false;
        var i: i32 = 0;
        while (i < layout.glyphCount()) {
            let shaped = layout.glyphAt(i);
            let cached = self.findGlyph(shaped.font_id, shaped.glyph_index);
            if (cached.cached && cached.region.isValid()) {
                let gx = x + self.glyphX(
                    loadI32(to_rawptr(&layout.advance_x)),
                    loadI32(to_rawptr(&shaped.x)),
                    loadI32(to_rawptr(&shaped.offset_x)),
                    loadI32(to_rawptr(&cached.bearing_x)),
                    loadI32(to_rawptr(&cached.region.width)));
                let gy = baseline_y + (shaped.y as f32) + (shaped.offset_y as f32) - (cached.bearing_y as f32);
                let rect = Rectangle.xywh(gx, gy, cached.region.width as f32, cached.region.height as f32);
                if (has_bounds) {
                    out = out.union(rect);
                } else {
                    out = rect;
                    has_bounds = true;
                }
            }
            i = i + 1;
        }
        return out;
    }

    public fn blockVisualBounds(&self, block: &TextBlock, x: f32, y: f32) -> Rectangle {
        var out = Rectangle.xywh(0.0, 0.0, 0.0, 0.0);
        var has_bounds = false;
        var line_index: i32 = 0;
        while (line_index < block.lineCount()) {
            let line = block.lineAt(line_index);
            let line_offset_x = block.lineOffsetX(line);
            var glyph_index: i32 = 0;
            while (glyph_index < line.glyph_count) {
                let shaped = block.glyphAt(line.first_glyph + glyph_index);
                let cached = self.findGlyph(shaped.font_id, shaped.glyph_index);
                if (cached.cached && cached.region.isValid()) {
                    let gx = x + (line_offset_x as f32) + self.glyphX(
                        loadI32(to_rawptr(&line.advance_x)),
                        loadI32(to_rawptr(&shaped.x)),
                        loadI32(to_rawptr(&shaped.offset_x)),
                        loadI32(to_rawptr(&cached.bearing_x)),
                        loadI32(to_rawptr(&cached.region.width)));
                    let gy = y + (shaped.y as f32) + (shaped.offset_y as f32) - (cached.bearing_y as f32);
                    let rect = Rectangle.xywh(gx, gy, cached.region.width as f32, cached.region.height as f32);
                    if (has_bounds) {
                        out = out.union(rect);
                    } else {
                        out = rect;
                        has_bounds = true;
                    }
                }
                glyph_index = glyph_index + 1;
            }
            line_index = line_index + 1;
        }
        return out;
    }

    public fn cacheText(&mut self, font: &FontFace, text: string) -> Result<TextLayout, Error> {
        var layout: TextLayout;
        match (font.shape(text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        match (self.cacheLayout(font, &layout)) {
            case Ok(_) => {}
            case Err(e) => {
                layout.destroy();
                return Err(e);
            }
        }
        return Ok(layout);
    }

    public fn cacheTextWithStack(&mut self, fonts: &FontStack, text: string) -> Result<TextLayout, Error> {
        var layout: TextLayout;
        match (fonts.shape(text)) {
            case Ok(v) => { layout = v; }
            case Err(e) => { return Err(e); }
        }
        match (self.cacheLayoutWithStack(fonts, &layout)) {
            case Ok(_) => {}
            case Err(e) => {
                layout.destroy();
                return Err(e);
            }
        }
        return Ok(layout);
    }

    public fn cacheTextBlock(&mut self, font: &FontFace, text: string, options: TextLayoutOptions) -> Result<TextBlock, Error> {
        var block: TextBlock;
        match (font.layoutText(text, options)) {
            case Ok(v) => { block = v; }
            case Err(e) => { return Err(e); }
        }
        match (self.cacheBlock(font, &block)) {
            case Ok(_) => {}
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        return Ok(block);
    }

    public fn cacheTextBlockWithStack(&mut self, fonts: &FontStack, text: string, options: TextLayoutOptions) -> Result<TextBlock, Error> {
        var block: TextBlock;
        match (fonts.layoutText(text, options)) {
            case Ok(v) => { block = v; }
            case Err(e) => { return Err(e); }
        }
        match (self.cacheBlockWithStack(fonts, &block)) {
            case Ok(_) => {}
            case Err(e) => {
                block.destroy();
                return Err(e);
            }
        }
        return Ok(block);
    }

    public fn destroy(&mut self) {
        self.glyphs.destroy();
        self.atlas.destroy();
    }
}
