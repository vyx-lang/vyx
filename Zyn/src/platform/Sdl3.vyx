public fn sdl_get_display_count() -> i32 {
    var count: i32 = 0;
    let displays = SDL_GetDisplays(to_rawptr(&count));
    if (displays != null) { SDL_free(displays); }
    return count;
}
public fn sdl_get_display_id_at(index: i32) -> u32 {
    var count: i32 = 0;
    let displays = SDL_GetDisplays(to_rawptr(&count));
    if (displays == null || index < 0 || index >= count) {
        if (displays != null) { SDL_free(displays); }
        return 0 as u32;
    }
    var out: u32 = 0 as u32;
    memcpy(to_rawptr(&out), displays + (index as i64 * 4), 4);
    SDL_free(displays);
    return out;
}
