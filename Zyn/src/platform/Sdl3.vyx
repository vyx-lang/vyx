public class SdlRect {
    public x: i32;
    public y: i32;
    public w: i32;
    public h: i32;

    public static fn create(x: i32, y: i32, w: i32, h: i32) -> SdlRect {
        return SdlRect { x: x, y: y, w: w, h: h };
    }
}

public class SdlEventBuffer {
    private data: rawptr;

    public static fn create() -> SdlEventBuffer {
        return SdlEventBuffer { data: calloc(128, 1) };
    }

    public fn valid(&self) -> bool {
        return self.data != null;
    }

    public fn ptr(&self) -> rawptr {
        return self.data;
    }

    public fn destroy(&mut self) {
        if (self.data != null) {
            free(self.data);
            self.data = null;
        }
    }
}

public class SdlPathInfo {
    public data: rawptr;

    public static fn create() -> SdlPathInfo {
        let mem = malloc(40);
        if (mem != null) { memset(mem, 0, 40); }
        return SdlPathInfo { data: mem };
    }

    public fn valid(&self) -> bool {
        return self.data != null;
    }

    public fn ptr(&self) -> rawptr {
        return self.data;
    }

    public fn pathType(&self) -> i32 {
        if (self.data == null) { return 0; }
        return read_i32(self.data, 0);
    }

    public fn destroy(&mut self) {
        if (self.data != null) {
            free(self.data);
            self.data = null;
        }
    }
}

public fn read_u8(ptr: rawptr, offset: i32) -> u8 {
    var out: u8 = 0 as u8;
    memcpy(to_rawptr(&out), ptr + offset as i64, 1);
    return out;
}

public fn read_u32(ptr: rawptr, offset: i32) -> u32 {
    var out: u32 = 0 as u32;
    memcpy(to_rawptr(&out), ptr + offset as i64, 4);
    return out;
}

public fn read_i16(ptr: rawptr, offset: i32) -> i16 {
    var out: i16 = 0 as i16;
    memcpy(to_rawptr(&out), ptr + offset as i64, 2);
    return out;
}

public fn read_i32(ptr: rawptr, offset: i32) -> i32 {
    var out: i32 = 0;
    memcpy(to_rawptr(&out), ptr + offset as i64, 4);
    return out;
}

public fn read_u64(ptr: rawptr, offset: i32) -> u64 {
    var out: u64 = 0 as u64;
    memcpy(to_rawptr(&out), ptr + offset as i64, 8);
    return out;
}

public fn read_f32(ptr: rawptr, offset: i32) -> f32 {
    var out: f32 = 0.0;
    memcpy(to_rawptr(&out), ptr + offset as i64, 4);
    return out;
}

