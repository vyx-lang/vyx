public fn sdl_performance_frequency() -> u64 { return SDL_GetPerformanceFrequency(); }
public fn sdl_delay(ms: u32) { SDL_Delay(ms); }

public fn sdl_base_path() -> string {
    let path = SDL_GetBasePath();
    if (path == null) { return ""; }
    return from_cstr(path);
}
public fn sdl_pref_path(org: string, app: string) -> string {
    let path = SDL_GetPrefPath(org.c_str(), app.c_str());
    if (path == null) { return ""; }
    return from_cstr(path);
}
public fn sdl_path_type(path: string) -> i32 {
    var info = SdlPathInfo.create();
    if (!info.valid()) { return 0; }
    if (!SDL_GetPathInfo(path.c_str(), info.ptr())) {
        info.destroy();
        return 0;
    }
    let ty = info.pathType();
    info.destroy();
    return ty;
}
public fn sdl_create_directory(path: string) -> bool {
    if (path.len == 0) { return false; }
    return SDL_CreateDirectory(path.c_str());
}
public fn sdl_open_url(url: string) -> bool { return SDL_OpenURL(url.c_str()); }
public fn sdl_show_simple_message_box(flags: u32, title: string, message: string, window: rawptr) -> bool {
    return SDL_ShowSimpleMessageBox(flags, title.c_str(), message.c_str(), window);
}

public fn sdl_get_gamepad_count() -> i32 {
    var count: i32 = 0;
    let devices = SDL_GetGamepads(to_rawptr(&count));
    if (devices != null) { SDL_free(devices); }
    return count;
}

public fn sdl_get_gamepad_id_at(index: i32) -> u32 {
    var count: i32 = 0;
    let devices = SDL_GetGamepads(to_rawptr(&count));
    if (devices == null || index < 0 || index >= count) {
        if (devices != null) { SDL_free(devices); }
        return 0 as u32;
    }
    var out: u32 = 0 as u32;
    memcpy(to_rawptr(&out), devices + (index as i64 * 4), 4);
    SDL_free(devices);
    return out;
}

public fn sdl_open_gamepad(instance_id: u32) -> rawptr { return SDL_OpenGamepad(instance_id); }
public fn sdl_close_gamepad(gamepad: rawptr) { SDL_CloseGamepad(gamepad); }
public fn sdl_gamepad_connected(gamepad: rawptr) -> bool { return SDL_GamepadConnected(gamepad); }
public fn sdl_get_gamepad_name(gamepad: rawptr) -> string {
    let name = SDL_GetGamepadName(gamepad);
    if (name == null) { return ""; }
    return from_cstr(name);
}
public fn sdl_get_gamepad_name_for_id(instance_id: u32) -> string {
    let name = SDL_GetGamepadNameForID(instance_id);
    if (name == null) { return ""; }
    return from_cstr(name);
}
public fn sdl_get_gamepad_type_for_id(instance_id: u32) -> i32 { return SDL_GetGamepadTypeForID(instance_id); }
public fn sdl_get_gamepad_axis(gamepad: rawptr, axis: i32) -> i16 { return SDL_GetGamepadAxis(gamepad, axis); }
public fn sdl_get_gamepad_button(gamepad: rawptr, button: i32) -> bool { return SDL_GetGamepadButton(gamepad, button); }
public fn sdl_update_gamepads() { SDL_UpdateGamepads(); }

public fn sdl_get_touch_count() -> i32 {
    var count: i32 = 0;
    let devices = SDL_GetTouchDevices(to_rawptr(&count));
    if (devices != null) { SDL_free(devices); }
    return count;
}

public fn sdl_get_touch_id_at(index: i32) -> u64 {
    var count: i32 = 0;
    let devices = SDL_GetTouchDevices(to_rawptr(&count));
    if (devices == null || index < 0 || index >= count) {
        if (devices != null) { SDL_free(devices); }
        return 0 as u64;
    }
    var out: u64 = 0 as u64;
    memcpy(to_rawptr(&out), devices + (index as i64 * 8), 8);
    SDL_free(devices);
    return out;
}

public fn sdl_get_touch_device_name(touch_id: u64) -> string {
    let name = SDL_GetTouchDeviceName(touch_id);
    if (name == null) { return ""; }
    return from_cstr(name);
}
public fn sdl_get_touch_device_type(touch_id: u64) -> i32 { return SDL_GetTouchDeviceType(touch_id); }
