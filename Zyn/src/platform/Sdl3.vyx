public fn init_video_events() -> u32 { return 0x00000020 as u32 | 0x00004000 as u32; }
public fn init_video() -> u32 { return 0x00000020 as u32; }
public fn init_events() -> u32 { return 0x00004000 as u32; }
public fn init_gamepad() -> u32 { return 0x00002000 as u32; }
public fn init_video_events_gamepad() -> u32 { return init_video_events() | init_gamepad(); }

public fn window_hidden() -> u64 { return 0x0000000000000008 as u64; }
public fn window_resizable() -> u64 { return 0x0000000000000020 as u64; }
public fn window_high_pixel_density() -> u64 { return 0x0000000000002000 as u64; }
public fn window_vulkan() -> u64 { return 0x0000000010000000 as u64; }

