module Zyn.Platform.Window;

use Zyn.Platform.Sdl3;
use Zyn.Platform.Platform;

public class Size2D {
    public width: i32;
    public height: i32;

    public static fn create(width: i32, height: i32) -> Size2D {
        return Size2D { width: width, height: height };
    }
}

public class Point2D {
    public x: i32;
    public y: i32;

    public static fn create(x: i32, y: i32) -> Point2D {
        return Point2D { x: x, y: y };
    }
}

public class Rect {
    public x: i32;
    public y: i32;
    public width: i32;
    public height: i32;

    public static fn create(x: i32, y: i32, width: i32, height: i32) -> Rect {
        return Rect { x: x, y: y, width: width, height: height };
    }
}

public class WindowFlags {
    public bits: u64;

    public static fn none() -> WindowFlags { return WindowFlags { bits: 0 as u64 }; }
    public static fn hidden() -> WindowFlags { return WindowFlags { bits: window_hidden() }; }
    public static fn resizable() -> WindowFlags { return WindowFlags { bits: window_resizable() }; }
    public static fn highPixelDensity() -> WindowFlags { return WindowFlags { bits: window_high_pixel_density() }; }
    public static fn vulkan() -> WindowFlags { return WindowFlags { bits: window_vulkan() }; }

    public fn or(&self, other: WindowFlags) -> WindowFlags {
        return WindowFlags { bits: self.bits | other.bits };
    }

    public fn has(&self, flag: WindowFlags) -> bool {
        return (self.bits & flag.bits) != 0 as u64;
    }
}

public class WindowDesc {
    public title: string;
    public width: i32;
    public height: i32;
    public flags: WindowFlags;

    public static fn create(title: string, width: i32, height: i32) -> WindowDesc {
        return WindowDesc { title: title, width: width, height: height, flags: WindowFlags.none() };
    }

    public fn setFlags(mut self, flags: WindowFlags) -> WindowDesc {
        self.flags = flags;
        return self;
    }

    public fn hidden(mut self) -> WindowDesc {
        self.flags = self.flags.or(WindowFlags.hidden());
        return self;
    }

    public fn resizable(mut self) -> WindowDesc {
        self.flags = self.flags.or(WindowFlags.resizable());
        return self;
    }

    public fn highPixelDensity(mut self) -> WindowDesc {
        self.flags = self.flags.or(WindowFlags.highPixelDensity());
        return self;
    }

    public fn vulkan(mut self) -> WindowDesc {
        self.flags = self.flags.or(WindowFlags.vulkan());
        return self;
    }
}

public class PlatformWindowHandle {
    public hwnd: u64;
    public hinstance: u64;
    public metal_layer: u64;
    public wayland_display: u64;
    public wayland_surface: u64;
    public x11_display: u64;
    public x11_window: u64;
    public android_native_window: u64;

    public static fn empty() -> PlatformWindowHandle {
        return PlatformWindowHandle { hwnd: 0, hinstance: 0, metal_layer: 0, wayland_display: 0, wayland_surface: 0, x11_display: 0, x11_window: 0, android_native_window: 0 };
    }

    public static fn win32(hwnd: u64, hinstance: u64) -> PlatformWindowHandle {
        var handle = PlatformWindowHandle.empty();
        handle.hwnd = hwnd;
        handle.hinstance = hinstance;
        return handle;
    }

    public static fn android(native_window: u64) -> PlatformWindowHandle {
        var handle = PlatformWindowHandle.empty();
        handle.android_native_window = native_window;
        return handle;
    }

    public static fn wayland(display: u64, surface: u64) -> PlatformWindowHandle {
        var handle = PlatformWindowHandle.empty();
        handle.wayland_display = display;
        handle.wayland_surface = surface;
        return handle;
    }

    public static fn x11(display: u64, window: u64) -> PlatformWindowHandle {
        var handle = PlatformWindowHandle.empty();
        handle.x11_display = display;
        handle.x11_window = window;
        return handle;
    }

    public static fn metal(layer: u64) -> PlatformWindowHandle {
        var handle = PlatformWindowHandle.empty();
        handle.metal_layer = layer;
        return handle;
    }

    public fn isValid(&self) -> bool {
        return (self.hwnd != 0 as u64 && self.hinstance != 0 as u64)
            || self.android_native_window != 0 as u64
            || self.metal_layer != 0 as u64
            || (self.wayland_display != 0 as u64 && self.wayland_surface != 0 as u64)
            || (self.x11_display != 0 as u64 && self.x11_window != 0 as u64);
    }
}

public class Display {
    public id: u32;

    public static fn primary() -> Display {
        return Display { id: sdl_get_primary_display() };
    }

    public static fn fromId(id: u32) -> Display {
        return Display { id: id };
    }

    public static fn count() -> i32 {
        return sdl_get_display_count();
    }

    public static fn at(index: i32) -> Option<Display> {
        let id = sdl_get_display_id_at(index);
        if (id == 0 as u32) { return None; }
        return Some(Display.fromId(id));
    }

    public fn bounds(&self) -> Result<Rect, PlatformError> {
        var rect = SdlRect { x: 0, y: 0, w: 0, h: 0 };
        if (sdl_get_display_bounds(self.id, to_rawptr(&rect))) {
            return Ok(Rect { x: rect.x, y: rect.y, width: rect.w, height: rect.h });
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn usableBounds(&self) -> Result<Rect, PlatformError> {
        var rect = SdlRect { x: 0, y: 0, w: 0, h: 0 };
        if (sdl_get_display_usable_bounds(self.id, to_rawptr(&rect))) {
            return Ok(Rect { x: rect.x, y: rect.y, width: rect.w, height: rect.h });
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn contentScale(&self) -> f32 {
        return sdl_get_display_content_scale(self.id);
    }
}

public class Window {
    private handle: rawptr;
    private owns: bool;
    private metal_view: rawptr;

    public static fn create(desc: WindowDesc) -> Result<Window, PlatformError> {
        let handle = sdl_create_window(desc.title, desc.width, desc.height, desc.flags.bits);
        if (handle == null) { return Err(PlatformError.create(sdl_last_error())); }
        var metal_view: rawptr = null;
        let platform = sdl_platform_name();
        if (platform == "macOS" || platform == "iOS" || platform == "tvOS") {
            metal_view = sdl_metal_create_view(handle);
            if (metal_view == null) {
                let message = sdl_last_error().clone();
                sdl_destroy_window(handle);
                return Err(PlatformError.create(message));
            }
        }
        return Ok(Window { handle: handle, owns: true, metal_view: metal_view });
    }

    public fn isValid(&self) -> bool {
        return self.handle != null;
    }

    public fn destroy(&mut self) {
        if (self.handle != null && self.owns) {
            if (self.metal_view != null) {
                sdl_metal_destroy_view(self.metal_view);
                self.metal_view = null;
            }
            sdl_destroy_window(self.handle);
            self.handle = null;
            self.owns = false;
        }
    }

    public fn show(&self) -> Result<i32, PlatformError> {
        if (sdl_show_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn hide(&self) -> Result<i32, PlatformError> {
        if (sdl_hide_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setTitle(&self, title: string) -> Result<i32, PlatformError> {
        if (sdl_set_window_title(self.handle, title)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setSize(&self, width: i32, height: i32) -> Result<i32, PlatformError> {
        if (sdl_set_window_size(self.handle, width, height)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn size(&self) -> Result<Size2D, PlatformError> {
        var w: i32 = 0;
        var h: i32 = 0;
        if (sdl_get_window_size(self.handle, to_rawptr(&w), to_rawptr(&h))) {
            return Ok(Size2D.create(w, h));
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn pixelSize(&self) -> Result<Size2D, PlatformError> {
        var w: i32 = 0;
        var h: i32 = 0;
        if (sdl_get_window_size_pixels(self.handle, to_rawptr(&w), to_rawptr(&h))) {
            return Ok(Size2D.create(w, h));
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn position(&self) -> Result<Point2D, PlatformError> {
        var x: i32 = 0;
        var y: i32 = 0;
        if (sdl_get_window_position(self.handle, to_rawptr(&x), to_rawptr(&y))) {
            return Ok(Point2D.create(x, y));
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setPosition(&self, x: i32, y: i32) -> Result<i32, PlatformError> {
        if (sdl_set_window_position(self.handle, x, y)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setFullscreen(&self, fullscreen: bool) -> Result<i32, PlatformError> {
        if (sdl_set_window_fullscreen(self.handle, fullscreen)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn maximize(&self) -> Result<i32, PlatformError> {
        if (sdl_maximize_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn minimize(&self) -> Result<i32, PlatformError> {
        if (sdl_minimize_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn restore(&self) -> Result<i32, PlatformError> {
        if (sdl_restore_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn raise(&self) -> Result<i32, PlatformError> {
        if (sdl_raise_window(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setMinimumSize(&self, width: i32, height: i32) -> Result<i32, PlatformError> {
        if (sdl_set_window_minimum_size(self.handle, width, height)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setMaximumSize(&self, width: i32, height: i32) -> Result<i32, PlatformError> {
        if (sdl_set_window_maximum_size(self.handle, width, height)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn displayScale(&self) -> f32 {
        return sdl_get_window_display_scale(self.handle);
    }

    public fn displayId(&self) -> u32 {
        return sdl_get_display_for_window(self.handle);
    }

    public fn safeArea(&self) -> Result<Rect, PlatformError> {
        var rect = SdlRect { x: 0, y: 0, w: 0, h: 0 };
        if (sdl_get_window_safe_area(self.handle, to_rawptr(&rect))) {
            return Ok(Rect { x: rect.x, y: rect.y, width: rect.w, height: rect.h });
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn flags(&self) -> WindowFlags {
        return WindowFlags { bits: sdl_get_window_flags(self.handle) };
    }

    public fn id(&self) -> u32 {
        return sdl_get_window_id(self.handle);
    }

    public fn startTextInput(&self) -> Result<i32, PlatformError> {
        if (sdl_start_text_input(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn stopTextInput(&self) -> Result<i32, PlatformError> {
        if (sdl_stop_text_input(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn textInputActive(&self) -> bool {
        return sdl_text_input_active(self.handle);
    }

    public fn clearComposition(&self) -> Result<i32, PlatformError> {
        if (sdl_clear_composition(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn setTextInputArea(&self, rect: Rect, cursor: i32) -> Result<i32, PlatformError> {
        let sdl_rect = SdlRect { x: rect.x, y: rect.y, w: rect.width, h: rect.height };
        if (sdl_set_text_input_area(self.handle, sdl_rect, cursor)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn textInputArea(&self) -> Result<Rect, PlatformError> {
        var rect = SdlRect { x: 0, y: 0, w: 0, h: 0 };
        var cursor: i32 = 0;
        if (sdl_get_text_input_area(self.handle, to_rawptr(&rect), to_rawptr(&cursor))) {
            return Ok(Rect { x: rect.x, y: rect.y, width: rect.w, height: rect.h });
        }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn nativeHandle(&self) -> PlatformWindowHandle {
        if (self.handle == null) { return PlatformWindowHandle.empty(); }
        if (self.metal_view != null) {
            return PlatformWindowHandle.metal(sdl_metal_get_layer(self.metal_view) as u64);
        }
        let hwnd = sdl_window_win32_hwnd(self.handle);
        let hinstance = sdl_window_win32_hinstance(self.handle);
        if (hwnd != null && hinstance != null) {
            return PlatformWindowHandle.win32(hwnd as u64, hinstance as u64);
        }
        let android_window = sdl_window_android_native_window(self.handle);
        if (android_window != null) { return PlatformWindowHandle.android(android_window as u64); }
        let wayland_display = sdl_window_wayland_display(self.handle);
        let wayland_surface = sdl_window_wayland_surface(self.handle);
        if (wayland_display != null && wayland_surface != null) {
            return PlatformWindowHandle.wayland(wayland_display as u64, wayland_surface as u64);
        }
        let x11_display = sdl_window_x11_display(self.handle);
        let x11_window = sdl_window_x11_window(self.handle);
        if (x11_display != null && x11_window != 0 as u64) {
            return PlatformWindowHandle.x11(x11_display as u64, x11_window);
        }
        return PlatformWindowHandle.empty();
    }

    public fn setRelativeMouseMode(&self, enabled: bool) -> Result<i32, PlatformError> {
        if (sdl_set_relative_mouse_mode(self.handle, enabled)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn relativeMouseMode(&self) -> bool {
        return sdl_get_relative_mouse_mode(self.handle);
    }
}
