module Zyn.Platform.Event;

use Zyn.Platform.Sdl3;

public class EventKind {
    public value: u32;

    public static fn unknown() -> EventKind { return EventKind { value: 0 as u32 }; }
    public static fn quit() -> EventKind { return EventKind { value: event_quit() }; }
    public static fn lifecycle() -> EventKind { return EventKind { value: 2 as u32 }; }
    public static fn display() -> EventKind { return EventKind { value: 3 as u32 }; }
    public static fn window() -> EventKind { return EventKind { value: 1 as u32 }; }
    public static fn keyDown() -> EventKind { return EventKind { value: event_key_down() }; }
    public static fn keyUp() -> EventKind { return EventKind { value: event_key_up() }; }
    public static fn textInput() -> EventKind { return EventKind { value: event_text_input() }; }
    public static fn textEditing() -> EventKind { return EventKind { value: event_text_editing() }; }
    public static fn textEditingCandidates() -> EventKind { return EventKind { value: event_text_editing_candidates() }; }
    public static fn mouseMotion() -> EventKind { return EventKind { value: event_mouse_motion() }; }
    public static fn mouseButtonDown() -> EventKind { return EventKind { value: event_mouse_button_down() }; }
    public static fn mouseButtonUp() -> EventKind { return EventKind { value: event_mouse_button_up() }; }
    public static fn mouseWheel() -> EventKind { return EventKind { value: event_mouse_wheel() }; }
    public static fn gamepad() -> EventKind { return EventKind { value: event_gamepad_axis_motion() }; }
    public static fn gamepadAxisMotion() -> EventKind { return EventKind { value: event_gamepad_axis_motion() }; }
    public static fn gamepadButtonDown() -> EventKind { return EventKind { value: event_gamepad_button_down() }; }
    public static fn gamepadButtonUp() -> EventKind { return EventKind { value: event_gamepad_button_up() }; }
    public static fn gamepadAdded() -> EventKind { return EventKind { value: event_gamepad_added() }; }
    public static fn gamepadRemoved() -> EventKind { return EventKind { value: event_gamepad_removed() }; }
    public static fn touch() -> EventKind { return EventKind { value: event_finger_down() }; }
    public static fn fingerDown() -> EventKind { return EventKind { value: event_finger_down() }; }
    public static fn fingerUp() -> EventKind { return EventKind { value: event_finger_up() }; }
    public static fn fingerMotion() -> EventKind { return EventKind { value: event_finger_motion() }; }
    public static fn fingerCanceled() -> EventKind { return EventKind { value: event_finger_canceled() }; }
    public static fn clipboard() -> EventKind { return EventKind { value: event_clipboard_update() }; }
    public static fn dropEvent() -> EventKind { return EventKind { value: event_drop_begin() }; }
    public static fn renderDevice() -> EventKind { return EventKind { value: event_render_targets_reset() }; }
}

public class LifecycleEventKind {
    public static fn terminating() -> u32 { return event_terminating(); }
    public static fn lowMemory() -> u32 { return event_low_memory(); }
    public static fn willEnterBackground() -> u32 { return event_will_enter_background(); }
    public static fn didEnterBackground() -> u32 { return event_did_enter_background(); }
    public static fn willEnterForeground() -> u32 { return event_will_enter_foreground(); }
    public static fn didEnterForeground() -> u32 { return event_did_enter_foreground(); }
    public static fn localeChanged() -> u32 { return event_locale_changed(); }
    public static fn systemThemeChanged() -> u32 { return event_system_theme_changed(); }
}

public class DisplayEventKind {
    public static fn orientation() -> u32 { return event_display_orientation(); }
    public static fn added() -> u32 { return event_display_added(); }
    public static fn removed() -> u32 { return event_display_removed(); }
    public static fn moved() -> u32 { return event_display_moved(); }
    public static fn desktopModeChanged() -> u32 { return event_display_desktop_mode_changed(); }
    public static fn currentModeChanged() -> u32 { return event_display_current_mode_changed(); }
    public static fn contentScaleChanged() -> u32 { return event_display_content_scale_changed(); }
    public static fn usableBoundsChanged() -> u32 { return event_display_usable_bounds_changed(); }
}

public class DropEventKind {
    public static fn file() -> u32 { return event_drop_file(); }
    public static fn text() -> u32 { return event_drop_text(); }
    public static fn begin() -> u32 { return event_drop_begin(); }
    public static fn complete() -> u32 { return event_drop_complete(); }
    public static fn position() -> u32 { return event_drop_position(); }
}

public class RenderDeviceEventKind {
    public static fn targetsReset() -> u32 { return event_render_targets_reset(); }
    public static fn deviceReset() -> u32 { return event_render_device_reset(); }
    public static fn deviceLost() -> u32 { return event_render_device_lost(); }
}

public class Event {
    public kind: EventKind;
    public raw_type: u32;
    public timestamp: u64;
    public window_id: u32;
    public data1: i32;
    public data2: i32;
    public key: i32;
    public scancode: i32;
    public modifiers: u32;
    public repeated: bool;
    public text: string;
    public editing_text: string;
    public editing_start: i32;
    public editing_length: i32;
    public candidate_count: i32;
    public selected_candidate: i32;
    public candidate_horizontal: bool;
    public mouse_button: i32;
    public mouse_buttons: u32;
    public x: f32;
    public y: f32;
    public xrel: f32;
    public yrel: f32;
    public gamepad_id: u32;
    public gamepad_axis: i32;
    public gamepad_axis_value: i32;
    public gamepad_button: i32;
    public gamepad_button_down: bool;
    public gamepad_touchpad: i32;
    public gamepad_finger: i32;
    public touch_id: u64;
    public finger_id: u64;
    public dx: f32;
    public dy: f32;
    public pressure: f32;
    public display_id: u32;
    public drop_source: string;
    public drop_data: string;
    public clipboard_owned: bool;
    public mime_type_count: i32;

    public static fn empty() -> Event {
        return Event {
            kind: EventKind.unknown(), raw_type: 0 as u32, timestamp: 0 as u64, window_id: 0 as u32,
            data1: 0, data2: 0, key: 0, scancode: 0, modifiers: 0 as u32, repeated: false,
            text: "", editing_text: "", editing_start: 0, editing_length: 0, candidate_count: 0, selected_candidate: -1, candidate_horizontal: false,
            mouse_button: 0, mouse_buttons: 0 as u32, x: 0.0, y: 0.0, xrel: 0.0, yrel: 0.0,
            gamepad_id: 0 as u32, gamepad_axis: 0, gamepad_axis_value: 0, gamepad_button: 0,
            gamepad_button_down: false, gamepad_touchpad: 0, gamepad_finger: 0,
            touch_id: 0 as u64, finger_id: 0 as u64, dx: 0.0, dy: 0.0, pressure: 0.0,
            display_id: 0 as u32, drop_source: "", drop_data: "", clipboard_owned: false, mime_type_count: 0
        };
    }

    public fn isQuit(&self) -> bool { return self.raw_type == event_quit(); }
    public fn isLifecycle(&self) -> bool { return self.raw_type >= event_terminating() && self.raw_type <= event_system_theme_changed(); }
    public fn isDisplay(&self) -> bool { return self.raw_type >= event_display_orientation() && self.raw_type <= event_display_usable_bounds_changed(); }
    public fn isWindowCloseRequested(&self) -> bool { return self.raw_type == event_window_close_requested(); }
    public fn isWindowResized(&self) -> bool { return self.raw_type == event_window_resized(); }
    public fn isKeyDown(&self) -> bool { return self.raw_type == event_key_down(); }
    public fn isKeyUp(&self) -> bool { return self.raw_type == event_key_up(); }
    public fn isTextEditing(&self) -> bool { return self.raw_type == event_text_editing(); }
    public fn isTextEditingCandidates(&self) -> bool { return self.raw_type == event_text_editing_candidates(); }
    public fn isTextInput(&self) -> bool { return self.raw_type == event_text_input(); }
    public fn isMouseMotion(&self) -> bool { return self.raw_type == event_mouse_motion(); }
    public fn isMouseButtonDown(&self) -> bool { return self.raw_type == event_mouse_button_down(); }
    public fn isMouseButtonUp(&self) -> bool { return self.raw_type == event_mouse_button_up(); }
    public fn isMouseWheel(&self) -> bool { return self.raw_type == event_mouse_wheel(); }
    public fn isGamepad(&self) -> bool { return self.raw_type >= event_gamepad_axis_motion() && self.raw_type <= event_gamepad_steam_handle_updated(); }
    public fn isTouch(&self) -> bool { return self.raw_type >= event_finger_down() && self.raw_type <= event_finger_canceled(); }
    public fn isFingerDown(&self) -> bool { return self.raw_type == event_finger_down(); }
    public fn isFingerMotion(&self) -> bool { return self.raw_type == event_finger_motion(); }
    public fn isFingerUp(&self) -> bool { return self.raw_type == event_finger_up(); }
    public fn isFingerCanceled(&self) -> bool { return self.raw_type == event_finger_canceled(); }
    public fn isClipboard(&self) -> bool { return self.raw_type == event_clipboard_update(); }
    public fn isDrop(&self) -> bool { return self.raw_type >= event_drop_file() && self.raw_type <= event_drop_position(); }
    public fn isRenderDevice(&self) -> bool { return self.raw_type >= event_render_targets_reset() && self.raw_type <= event_render_device_lost(); }
    public fn isBackgroundTransition(&self) -> bool { return self.raw_type == event_will_enter_background() || self.raw_type == event_did_enter_background(); }
    public fn isForegroundTransition(&self) -> bool { return self.raw_type == event_will_enter_foreground() || self.raw_type == event_did_enter_foreground(); }
}

fn decode_event(buf: SdlEventBuffer) -> Event {
    let ptr = buf.ptr();
    var ev = Event.empty();
    let t = read_u32(ptr, 0);
    ev.raw_type = t;
    ev.timestamp = read_u64(ptr, 8);

    if (t == event_quit()) {
        ev.kind = EventKind.quit();
        return ev;
    }

    if (t >= event_terminating() && t <= event_system_theme_changed()) {
        ev.kind = EventKind.lifecycle();
        return ev;
    }

    if (t >= event_display_orientation() && t <= event_display_usable_bounds_changed()) {
        ev.kind = EventKind.display();
        ev.display_id = read_u32(ptr, 16);
        ev.data1 = read_i32(ptr, 20);
        ev.data2 = read_i32(ptr, 24);
        return ev;
    }

    if (t >= event_window_shown() && t <= 0x216 as u32) {
        ev.kind = EventKind.window();
        ev.window_id = read_u32(ptr, 16);
        ev.data1 = read_i32(ptr, 20);
        ev.data2 = read_i32(ptr, 24);
        return ev;
    }

    if (t == event_key_down() || t == event_key_up()) {
        if (t == event_key_down()) { ev.kind = EventKind.keyDown(); } else { ev.kind = EventKind.keyUp(); }
        ev.window_id = read_u32(ptr, 16);
        ev.scancode = read_i32(ptr, 24);
        ev.key = read_i32(ptr, 28);
        ev.modifiers = read_u32(ptr, 32);
        ev.repeated = read_u8(ptr, 39) != 0 as u8;
        return ev;
    }

    if (t == event_text_input()) {
        ev.kind = EventKind.textInput();
        ev.window_id = read_u32(ptr, 16);
        let text_ptr_value = read_u64(ptr, 24);
        if (text_ptr_value != 0 as u64) { ev.text = from_cstr(text_ptr_value as rawptr); }
        return ev;
    }

    if (t == event_text_editing()) {
        ev.kind = EventKind.textEditing();
        ev.window_id = read_u32(ptr, 16);
        let text_ptr_value = read_u64(ptr, 24);
        if (text_ptr_value != 0 as u64) { ev.editing_text = from_cstr(text_ptr_value as rawptr); }
        ev.editing_start = read_i32(ptr, 32);
        ev.editing_length = read_i32(ptr, 36);
        return ev;
    }

    if (t == event_text_editing_candidates()) {
        ev.kind = EventKind.textEditingCandidates();
        ev.window_id = read_u32(ptr, 16);
        ev.candidate_count = read_i32(ptr, 32);
        ev.selected_candidate = read_i32(ptr, 36);
        ev.candidate_horizontal = read_u8(ptr, 40) != 0 as u8;
        return ev;
    }

    if (t == event_mouse_motion()) {
        ev.kind = EventKind.mouseMotion();
        ev.window_id = read_u32(ptr, 16);
        ev.mouse_buttons = read_u32(ptr, 24);
        ev.x = read_f32(ptr, 28);
        ev.y = read_f32(ptr, 32);
        ev.xrel = read_f32(ptr, 36);
        ev.yrel = read_f32(ptr, 40);
        return ev;
    }

    if (t == event_mouse_button_down() || t == event_mouse_button_up()) {
        if (t == event_mouse_button_down()) { ev.kind = EventKind.mouseButtonDown(); } else { ev.kind = EventKind.mouseButtonUp(); }
        ev.window_id = read_u32(ptr, 16);
        ev.mouse_button = read_u8(ptr, 24) as i32;
        ev.x = read_f32(ptr, 28);
        ev.y = read_f32(ptr, 32);
        return ev;
    }

    if (t == event_mouse_wheel()) {
        ev.kind = EventKind.mouseWheel();
        ev.window_id = read_u32(ptr, 16);
        ev.x = read_f32(ptr, 24);
        ev.y = read_f32(ptr, 28);
        ev.data1 = read_i32(ptr, 44);
        ev.data2 = read_i32(ptr, 48);
        return ev;
    }

    if (t == event_gamepad_axis_motion()) {
        ev.kind = EventKind.gamepad();
        ev.gamepad_id = read_u32(ptr, 16);
        ev.gamepad_axis = read_u8(ptr, 20) as i32;
        ev.gamepad_axis_value = read_i16(ptr, 24) as i32;
        return ev;
    }

    if (t == event_gamepad_button_down() || t == event_gamepad_button_up()) {
        ev.kind = EventKind.gamepad();
        ev.gamepad_id = read_u32(ptr, 16);
        ev.gamepad_button = read_u8(ptr, 20) as i32;
        ev.gamepad_button_down = read_u8(ptr, 21) != 0 as u8;
        return ev;
    }

    if (t == event_gamepad_added()
        || t == event_gamepad_removed()
        || t == event_gamepad_remapped()
        || t == event_gamepad_update_complete()
        || t == event_gamepad_steam_handle_updated()) {
        ev.kind = EventKind.gamepad();
        ev.gamepad_id = read_u32(ptr, 16);
        return ev;
    }

    if (t == event_gamepad_touchpad_down()
        || t == event_gamepad_touchpad_motion()
        || t == event_gamepad_touchpad_up()) {
        ev.kind = EventKind.gamepad();
        ev.gamepad_id = read_u32(ptr, 16);
        ev.gamepad_touchpad = read_i32(ptr, 20);
        ev.gamepad_finger = read_i32(ptr, 24);
        ev.x = read_f32(ptr, 28);
        ev.y = read_f32(ptr, 32);
        ev.pressure = read_f32(ptr, 36);
        return ev;
    }

    if (t == event_gamepad_sensor_update()) {
        ev.kind = EventKind.gamepad();
        ev.gamepad_id = read_u32(ptr, 16);
        ev.data1 = read_i32(ptr, 20);
        return ev;
    }

    if (t >= event_finger_down() && t <= event_finger_canceled()) {
        ev.kind = EventKind.touch();
        ev.touch_id = read_u64(ptr, 16);
        ev.finger_id = read_u64(ptr, 24);
        ev.x = read_f32(ptr, 32);
        ev.y = read_f32(ptr, 36);
        ev.dx = read_f32(ptr, 40);
        ev.dy = read_f32(ptr, 44);
        ev.pressure = read_f32(ptr, 48);
        ev.window_id = read_u32(ptr, 52);
        return ev;
    }

    if (t == event_clipboard_update()) {
        ev.kind = EventKind.clipboard();
        ev.clipboard_owned = read_u8(ptr, 16) != 0 as u8;
        ev.mime_type_count = read_i32(ptr, 20);
        return ev;
    }

    if (t >= event_drop_file() && t <= event_drop_position()) {
        ev.kind = EventKind.dropEvent();
        ev.window_id = read_u32(ptr, 16);
        ev.x = read_f32(ptr, 20);
        ev.y = read_f32(ptr, 24);
        let source_ptr_value = read_u64(ptr, 32);
        if (source_ptr_value != 0 as u64) { ev.drop_source = from_cstr(source_ptr_value as rawptr); }
        let data_ptr_value = read_u64(ptr, 40);
        if (data_ptr_value != 0 as u64) { ev.drop_data = from_cstr(data_ptr_value as rawptr); }
        return ev;
    }

    if (t >= event_render_targets_reset() && t <= event_render_device_lost()) {
        ev.kind = EventKind.renderDevice();
        return ev;
    }

    return ev;
}

public class EventLoop {
    public static fn pump() {
        sdl_pump_events();
    }

    public static fn poll() -> Option<Event> {
        var buf = SdlEventBuffer.create();
        if (!buf.valid()) { return None; }
        if (!sdl_poll_event(buf.ptr())) {
            buf.destroy();
            return None;
        }
        let ev = decode_event(buf);
        buf.destroy();
        return Some(ev);
    }

    public static fn wait() -> Option<Event> {
        var buf = SdlEventBuffer.create();
        if (!buf.valid()) { return None; }
        if (!sdl_wait_event(buf.ptr())) {
            buf.destroy();
            return None;
        }
        let ev = decode_event(buf);
        buf.destroy();
        return Some(ev);
    }

    public static fn waitTimeout(timeout_ms: i32) -> Option<Event> {
        var buf = SdlEventBuffer.create();
        if (!buf.valid()) { return None; }
        if (!sdl_wait_event_timeout(buf.ptr(), timeout_ms)) {
            buf.destroy();
            return None;
        }
        let ev = decode_event(buf);
        buf.destroy();
        return Some(ev);
    }
}
