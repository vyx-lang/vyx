module Zyn.Platform.Clipboard;

use Zyn.Platform.Sdl3;
use Zyn.Platform.Platform;

public class Clipboard {
    public static fn hasText() -> bool {
        return sdl_has_clipboard_text();
    }

    public static fn getText() -> string {
        return sdl_get_clipboard_text();
    }

    public static fn setText(text: string) -> Result<i32, PlatformError> {
        if (sdl_set_clipboard_text(text)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }
}
