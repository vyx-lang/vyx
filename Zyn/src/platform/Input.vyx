module Zyn.Platform.Input;

use Zyn.Platform.Sdl3;
use Zyn.Platform.Platform;

public class MouseState {
    public x: f32;
    public y: f32;
    public buttons: u32;

    public static fn create(x: f32, y: f32, buttons: u32) -> MouseState {
        return MouseState { x: x, y: y, buttons: buttons };
    }

    public fn hasButton(&self, mask: u32) -> bool {
        return (self.buttons & mask) != 0 as u32;
    }
}

public class MouseButton {
    public static fn left() -> u32 { return 1 as u32; }
    public static fn middle() -> u32 { return 2 as u32; }
    public static fn right() -> u32 { return 3 as u32; }
    public static fn x1() -> u32 { return 4 as u32; }
    public static fn x2() -> u32 { return 5 as u32; }
    public static fn mask(button: u32) -> u32 { return 1 as u32 << (button - 1 as u32); }
}

public class KeyModifier {
    public static fn none() -> u32 { return 0 as u32; }
    public static fn leftShift() -> u32 { return 0x0001 as u32; }
    public static fn rightShift() -> u32 { return 0x0002 as u32; }
    public static fn leftCtrl() -> u32 { return 0x0040 as u32; }
    public static fn rightCtrl() -> u32 { return 0x0080 as u32; }
    public static fn leftAlt() -> u32 { return 0x0100 as u32; }
    public static fn rightAlt() -> u32 { return 0x0200 as u32; }
    public static fn leftGui() -> u32 { return 0x0400 as u32; }
    public static fn rightGui() -> u32 { return 0x0800 as u32; }
    public static fn shift() -> u32 { return KeyModifier.leftShift() | KeyModifier.rightShift(); }
    public static fn ctrl() -> u32 { return KeyModifier.leftCtrl() | KeyModifier.rightCtrl(); }
    public static fn alt() -> u32 { return KeyModifier.leftAlt() | KeyModifier.rightAlt(); }
    public static fn gui() -> u32 { return KeyModifier.leftGui() | KeyModifier.rightGui(); }
}

// SDL3 keycodes. Printable ASCII keys keep their ASCII value; every other key
// is `SDLK_SCANCODE_MASK (1 << 30) | scancode`, which is exactly what
// `Event.key` carries out of the platform decoder.
public class KeyCode {
    private static fn scan(code: i32) -> i32 { return (1 << 30) + code; }

    public static fn unknown() -> i32 { return 0; }
    public static fn backspace() -> i32 { return 8; }
    public static fn tab() -> i32 { return 9; }
    public static fn enter() -> i32 { return 13; }
    public static fn escape() -> i32 { return 27; }
    public static fn space() -> i32 { return 32; }
    public static fn delete() -> i32 { return 127; }

    public static fn left() -> i32 { return KeyCode.scan(80); }
    public static fn right() -> i32 { return KeyCode.scan(79); }
    public static fn up() -> i32 { return KeyCode.scan(82); }
    public static fn down() -> i32 { return KeyCode.scan(81); }
    public static fn home() -> i32 { return KeyCode.scan(74); }
    public static fn end() -> i32 { return KeyCode.scan(77); }
    public static fn pageUp() -> i32 { return KeyCode.scan(75); }
    public static fn pageDown() -> i32 { return KeyCode.scan(78); }

    public static fn isArrow(key: i32) -> bool {
        return key == KeyCode.left() || key == KeyCode.right()
            || key == KeyCode.up() || key == KeyCode.down();
    }

    public static fn isActivate(key: i32) -> bool {
        return key == KeyCode.enter() || key == KeyCode.space();
    }
}

public class KeyboardState {
    public modifiers: u32;

    public static fn current() -> KeyboardState {
        return KeyboardState { modifiers: sdl_get_mod_state() };
    }

    public fn hasModifier(&self, mask: u32) -> bool {
        return (self.modifiers & mask) != 0 as u32;
    }

    public fn isScancodeDown(&self, scancode: i32) -> bool {
        return sdl_key_state(scancode);
    }
}

public class SystemCursorKind {
    public static fn defaultCursor() -> i32 { return 0; }
    public static fn arrow() -> i32 { return 0; }
    public static fn text() -> i32 { return 1; }
    public static fn wait() -> i32 { return 2; }
    public static fn crosshair() -> i32 { return 3; }
    public static fn progress() -> i32 { return 4; }
    public static fn nwseResize() -> i32 { return 5; }
    public static fn neswResize() -> i32 { return 6; }
    public static fn ewResize() -> i32 { return 7; }
    public static fn nsResize() -> i32 { return 8; }
    public static fn move() -> i32 { return 9; }
    public static fn notAllowed() -> i32 { return 10; }
    public static fn pointer() -> i32 { return 11; }
}

public class SystemCursor {
    public static fn arrow() -> i32 { return SystemCursorKind.arrow(); }
    public static fn text() -> i32 { return SystemCursorKind.text(); }
    public static fn wait() -> i32 { return SystemCursorKind.wait(); }
    public static fn crosshair() -> i32 { return SystemCursorKind.crosshair(); }
    public static fn progress() -> i32 { return SystemCursorKind.progress(); }
    public static fn ewResize() -> i32 { return SystemCursorKind.ewResize(); }
    public static fn nsResize() -> i32 { return SystemCursorKind.nsResize(); }
    public static fn move() -> i32 { return SystemCursorKind.move(); }
    public static fn notAllowed() -> i32 { return SystemCursorKind.notAllowed(); }
    public static fn pointer() -> i32 { return SystemCursorKind.pointer(); }
}

public class Cursor {
    private handle: rawptr;
    private owns: bool;

    public static fn fromSystem(id: i32) -> Result<Cursor, PlatformError> {
        let handle = sdl_create_system_cursor(id);
        if (handle == null) { return Err(PlatformError.create(sdl_last_error())); }
        return Ok(Cursor { handle: handle, owns: true });
    }

    public static fn current() -> Cursor {
        return Cursor { handle: sdl_get_cursor(), owns: false };
    }

    public fn isValid(&self) -> bool {
        return self.handle != null;
    }

    public fn set(&self) -> Result<i32, PlatformError> {
        if (self.handle == null) { return Err(PlatformError.create("cursor is destroyed")); }
        if (sdl_set_cursor(self.handle)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public fn destroy(&mut self) {
        if (self.handle != null && self.owns) {
            sdl_destroy_cursor(self.handle);
            self.handle = null;
            self.owns = false;
        }
    }
}

public class GamepadButton {
    public static fn south() -> i32 { return 0; }
    public static fn east() -> i32 { return 1; }
    public static fn west() -> i32 { return 2; }
    public static fn north() -> i32 { return 3; }
    public static fn back() -> i32 { return 4; }
    public static fn guide() -> i32 { return 5; }
    public static fn start() -> i32 { return 6; }
    public static fn leftStick() -> i32 { return 7; }
    public static fn rightStick() -> i32 { return 8; }
    public static fn leftShoulder() -> i32 { return 9; }
    public static fn rightShoulder() -> i32 { return 10; }
    public static fn dpadUp() -> i32 { return 11; }
    public static fn dpadDown() -> i32 { return 12; }
    public static fn dpadLeft() -> i32 { return 13; }
    public static fn dpadRight() -> i32 { return 14; }
}

public class GamepadAxis {
    public static fn leftX() -> i32 { return 0; }
    public static fn leftY() -> i32 { return 1; }
    public static fn rightX() -> i32 { return 2; }
    public static fn rightY() -> i32 { return 3; }
    public static fn leftTrigger() -> i32 { return 4; }
    public static fn rightTrigger() -> i32 { return 5; }
}

public class GamepadInfo {
    public id: u32;
    public name: string;
    public type_id: i32;

    public static fn create(id: u32, name: string, type_id: i32) -> GamepadInfo {
        return GamepadInfo { id: id, name: name, type_id: type_id };
    }
}

public class Gamepad {
    private handle: rawptr;
    private id_value: u32;
    private owns: bool;

    public static fn init() -> Result<i32, PlatformError> {
        if (sdl_init(init_gamepad())) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public static fn count() -> i32 {
        return sdl_get_gamepad_count();
    }

    public static fn update() {
        sdl_update_gamepads();
    }

    public static fn idAt(index: i32) -> u32 {
        return sdl_get_gamepad_id_at(index);
    }

    public static fn infoAt(index: i32) -> Option<GamepadInfo> {
        let id = Gamepad.idAt(index);
        if (id == 0 as u32) { return None; }
        return Some(GamepadInfo.create(id, sdl_get_gamepad_name_for_id(id), sdl_get_gamepad_type_for_id(id)));
    }

    public static fn open(id: u32) -> Result<Gamepad, PlatformError> {
        let handle = sdl_open_gamepad(id);
        if (handle == null) { return Err(PlatformError.create(sdl_last_error())); }
        return Ok(Gamepad { handle: handle, id_value: id, owns: true });
    }

    public fn isValid(&self) -> bool {
        return self.handle != null;
    }

    public fn id(&self) -> u32 {
        return self.id_value;
    }

    public fn connected(&self) -> bool {
        if (self.handle == null) { return false; }
        return sdl_gamepad_connected(self.handle);
    }

    public fn name(&self) -> string {
        if (self.handle == null) { return ""; }
        return sdl_get_gamepad_name(self.handle);
    }

    public fn axis(&self, axis: i32) -> i16 {
        if (self.handle == null) { return 0 as i16; }
        return sdl_get_gamepad_axis(self.handle, axis);
    }

    public fn button(&self, button: i32) -> bool {
        if (self.handle == null) { return false; }
        return sdl_get_gamepad_button(self.handle, button);
    }

    public fn close(&mut self) {
        if (self.handle != null && self.owns) {
            sdl_close_gamepad(self.handle);
            self.handle = null;
            self.owns = false;
        }
    }
}

public class TouchDeviceInfo {
    public id: u64;
    public name: string;
    public type_id: i32;

    public static fn create(id: u64, name: string, type_id: i32) -> TouchDeviceInfo {
        return TouchDeviceInfo { id: id, name: name, type_id: type_id };
    }
}

public class Touch {
    public static fn count() -> i32 {
        return sdl_get_touch_count();
    }

    public static fn idAt(index: i32) -> u64 {
        return sdl_get_touch_id_at(index);
    }

    public static fn infoAt(index: i32) -> Option<TouchDeviceInfo> {
        let id = Touch.idAt(index);
        if (id == 0 as u64) { return None; }
        return Some(TouchDeviceInfo.create(id, sdl_get_touch_device_name(id), sdl_get_touch_device_type(id)));
    }
}

public class InputState {
    public static fn keyboard() -> KeyboardState {
        return KeyboardState.current();
    }

    public static fn keyName(key: i32) -> string {
        return sdl_get_key_name(key);
    }

    public static fn isScancodeDown(scancode: i32) -> bool {
        return sdl_key_state(scancode);
    }

    public static fn mouse() -> MouseState {
        var x: f32 = 0.0;
        var y: f32 = 0.0;
        let buttons = sdl_get_mouse_state(to_rawptr(&x), to_rawptr(&y));
        return MouseState.create(x, y, buttons);
    }

    public static fn globalMouse() -> MouseState {
        var x: f32 = 0.0;
        var y: f32 = 0.0;
        let buttons = sdl_get_global_mouse_state(to_rawptr(&x), to_rawptr(&y));
        return MouseState.create(x, y, buttons);
    }

    public static fn relativeMouse() -> MouseState {
        var x: f32 = 0.0;
        var y: f32 = 0.0;
        let buttons = sdl_get_relative_mouse_state(to_rawptr(&x), to_rawptr(&y));
        return MouseState.create(x, y, buttons);
    }

    public static fn captureMouse(enabled: bool) -> bool {
        return sdl_capture_mouse(enabled);
    }

    public static fn showCursor() -> bool {
        return sdl_show_cursor();
    }

    public static fn hideCursor() -> bool {
        return sdl_hide_cursor();
    }

    public static fn cursorVisible() -> bool {
        return sdl_cursor_visible();
    }
}
