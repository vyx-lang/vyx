module Zyn.Platform.Platform;

use Zyn.Platform.Sdl3;
use std.fs;

public class PlatformError {
    public message: string;

    public static fn create(message: string) -> PlatformError {
        return PlatformError { message: message };
    }
}

// The permission must also be declared in the application's AndroidManifest.
// Requests are asynchronous: pending=-1, denied=0, granted=1.
public class AndroidPermission {
    public static fn request(name: string) -> Result<i32, PlatformError> {
        let id = sdl_android_permission_request(name);
        if (id > 0) { return Ok(id); }
        return Err(PlatformError.create("Android permission request failed: " + sdl_last_error()));
    }

    public static fn status(request_id: i32) -> i32 { return sdl_android_permission_status(request_id); }
    public static fn release(request_id: i32) -> bool { return sdl_android_permission_release(request_id); }
}

public class PlatformInit {
    public static fn video() -> u32 { return init_video(); }
    public static fn events() -> u32 { return init_events(); }
    public static fn gamepad() -> u32 { return init_gamepad(); }
    public static fn videoEvents() -> u32 { return init_video_events(); }
    public static fn app() -> u32 { return init_video_events_gamepad(); }
}

public class FileSystem {
    public static fn readText(path: string) -> Result<string, PlatformError> {
        if (!fileExists(path)) { return Err(PlatformError.create("file not found: " + path)); }
        return Ok(readFile(path));
    }

    public static fn writeText(path: string, content: string) -> Result<i32, PlatformError> {
        if (writeFile(path, content) == 0) { return Ok(0); }
        return Err(PlatformError.create("failed to write file: " + path));
    }

    public static fn appendText(path: string, content: string) -> Result<i32, PlatformError> {
        if (appendFile(path, content) == 0) { return Ok(0); }
        return Err(PlatformError.create("failed to append file: " + path));
    }

    public static fn exists(path: string) -> bool {
        return sdl_path_type(path) != 0;
    }

    public static fn isFile(path: string) -> bool {
        return sdl_path_type(path) == 1;
    }

    public static fn isDir(path: string) -> bool {
        return sdl_path_type(path) == 2;
    }

    public static fn size(path: string) -> Result<i64, PlatformError> {
        let n = fileSize(path);
        if (n >= 0) { return Ok(n); }
        return Err(PlatformError.create("failed to stat file: " + path));
    }

    public static fn rename(old_path: string, new_path: string) -> Result<i32, PlatformError> {
        if (renameFile(old_path, new_path) == 0) { return Ok(0); }
        return Err(PlatformError.create("failed to rename file: " + old_path));
    }

    public static fn remove(path: string) -> Result<i32, PlatformError> {
        if (deleteFile(path) == 0) { return Ok(0); }
        return Err(PlatformError.create("failed to delete file: " + path));
    }

    public static fn joinPath(a: string, b: string) -> string {
        if (a.len == 0) { return b; }
        if (b.len == 0) { return a; }
        let last = a.charAt(a.len - 1);
        if (last == 47 || last == 92) { return a + b; }
        return a + "/" + b;
    }

    public static fn normalizePath(path: string) -> string {
        var out: string = "";
        var i: i32 = 0;
        while (i < path.len) {
            let c = path.charAt(i);
            if (c == 92) {
                out = out + "/";
            } else {
                out = out + path.substring(i, i + 1);
            }
            i = i + 1;
        }
        return out;
    }
}

public class AppPaths {
    public static fn basePath() -> string {
        return sdl_base_path();
    }

    public static fn prefPath(org: string, app: string) -> string {
        let path = sdl_pref_path(org, app);
        if (path.len > 0) {
            var dir = path;
            let last = dir.charAt(dir.len - 1);
            if (last == 47 || last == 92) {
                dir = dir.substring(0, dir.len - 1);
            }
            if (sdl_path_type(dir) != 2) {
                sdl_create_directory(dir);
            }
        }
        return path;
    }
}

public class MessageBoxFlags {
    public static fn errorBox() -> u32 { return 0x00000010 as u32; }
    public static fn warning() -> u32 { return 0x00000020 as u32; }
    public static fn information() -> u32 { return 0x00000040 as u32; }
}

public class SystemTheme {
    public static fn unknown() -> i32 { return 0; }
    public static fn light() -> i32 { return 1; }
    public static fn dark() -> i32 { return 2; }
}

public class PlatformInfo {
    public name: string;
    public cpu_count: i32;
    public ram_mb: i32;
    public page_size: i32;
    public system_theme: i32;

    public static fn current() -> PlatformInfo {
        return PlatformInfo {
            name: sdl_platform_name(),
            cpu_count: sdl_cpu_count(),
            ram_mb: sdl_system_ram_mb(),
            page_size: sdl_system_page_size(),
            system_theme: sdl_get_system_theme()
        };
    }

    public fn isWindows(&self) -> bool {
        return self.name == "Windows";
    }

    public fn isLinux(&self) -> bool {
        return self.name == "Linux";
    }

    public fn isMacOS(&self) -> bool {
        return self.name == "macOS";
    }
}

public class OS {
    public static fn openUrl(url: string) -> Result<i32, PlatformError> {
        if (sdl_open_url(url)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public static fn showMessageBox(title: string, message: string, flags: u32) -> Result<i32, PlatformError> {
        if (sdl_show_simple_message_box(flags, title, message, null)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }
}

public class Platform {
    public static fn prepareBeforeInit() {
        sdl_set_hint("SDL_IME_IMPLEMENTED_UI", "none");
        // Zyn handles normalized touch separately; SDL's synthetic events
        // would dispatch the same tap twice through the mouse path.
        sdl_set_hint("SDL_TOUCH_MOUSE_EVENTS", "0");
        sdl_set_hint("SDL_MOUSE_TOUCH_EVENTS", "0");
    }

    public static fn setMetadata(appname: string, appversion: string, appidentifier: string) -> Result<i32, PlatformError> {
        if (sdl_set_app_metadata(appname, appversion, appidentifier)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public static fn init() -> Result<i32, PlatformError> {
        Platform.prepareBeforeInit();
        if (sdl_init(init_video_events())) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public static fn initWithFlags(flags: u32) -> Result<i32, PlatformError> {
        Platform.prepareBeforeInit();
        if (sdl_init(flags)) { return Ok(0); }
        return Err(PlatformError.create(sdl_last_error()));
    }

    public static fn quit() {
        sdl_quit();
    }

    public static fn lastError() -> string {
        return sdl_last_error();
    }

    public static fn clearError() {
        sdl_clear_error();
    }
}
