module Zyn.Platform.Clock;

use Zyn.Platform.Sdl3;

public class Clock {
    public static fn ticks() -> u64 {
        return sdl_ticks();
    }

    public static fn ticksNS() -> u64 {
        return sdl_ticks_ns();
    }

    public static fn performanceCounter() -> u64 {
        return sdl_performance_counter();
    }

    public static fn performanceFrequency() -> u64 {
        return sdl_performance_frequency();
    }

    public static fn delay(ms: u32) {
        sdl_delay(ms);
    }
}

public class FrameClock {
    private last_ticks_ns: u64;
    private delta_ns_value: u64;
    private frame_index_value: u64;

    public static fn start() -> FrameClock {
        return FrameClock {
            last_ticks_ns: Clock.ticksNS(),
            delta_ns_value: 0 as u64,
            frame_index_value: 0 as u64
        };
    }

    public fn tick(mut self) -> FrameClock {
        let now = Clock.ticksNS();
        if (now >= self.last_ticks_ns) {
            self.delta_ns_value = now - self.last_ticks_ns;
        } else {
            self.delta_ns_value = 0 as u64;
        }
        self.last_ticks_ns = now;
        self.frame_index_value = self.frame_index_value + 1 as u64;
        return self;
    }

    public fn deltaNS(&self) -> u64 {
        return self.delta_ns_value;
    }

    public fn deltaSeconds(&self) -> f64 {
        return (self.delta_ns_value as f64) / 1000000000.0;
    }

    public fn frameIndex(&self) -> u64 {
        return self.frame_index_value;
    }
}

public class FrameScheduler {
    private clock: FrameClock;
    private target_frame_ns: u64;

    public static fn create(target_fps: i32) -> FrameScheduler {
        var fps = target_fps;
        if (fps <= 0) { fps = 60; }
        return FrameScheduler {
            clock: FrameClock.start(),
            target_frame_ns: (1000000000 as u64) / (fps as u64)
        };
    }

    public fn beginFrame(mut self) -> FrameScheduler {
        self.clock = self.clock.tick();
        return self;
    }

    public fn sleepUntilNextFrame(mut self) -> FrameScheduler {
        let elapsed = self.clock.deltaNS();
        if (elapsed < self.target_frame_ns) {
            let remain = self.target_frame_ns - elapsed;
            let ms = (remain / 1000000 as u64) as u32;
            if (ms > 0 as u32) { Clock.delay(ms); }
        }
        return self;
    }

    public fn frameIndex(&self) -> u64 {
        return self.clock.frameIndex();
    }

    public fn deltaNS(&self) -> u64 {
        return self.clock.deltaNS();
    }
}
