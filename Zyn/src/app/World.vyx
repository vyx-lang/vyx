    public fn textInputActionNameForViewId(&self, view_id: string) -> string {
        if (view_id.len == 0) { return ""; }
        let explicit_action = self.stringResource("text_input_action:" + view_id, "");
        if (explicit_action.len > 0) { return explicit_action; }
        return self.actionNameForViewId(view_id);
    }

