    public fn registerCommand(mut self, command: AppCommand) -> AppWorld {
        self.registerCommandMut(command);
        return self;
    }

    public fn registerCommandMut(&mut self, command: AppCommand) {
        var i: i32 = 0;
        while (i < (self.commands.len as i32)) {
            let current = self.commands.get(i as i64);
            if (current.action_name == command.action_name) {
                self.commands.set(i as i64, command);
                return;
            }
            i = i + 1;
        }
        self.commands.push(command);
    }

    public fn registerIntDeltaCommand(mut self, action_name: string, target_resource: string, int_delta: i32) -> AppWorld {
        return self.registerCommand(AppCommand.intDelta(action_name, target_resource, int_delta));
    }

    public fn registerBoolToggleCommand(mut self, action_name: string, target_resource: string) -> AppWorld {
        return self.registerCommand(AppCommand.boolToggle(action_name, target_resource));
    }

    public fn registerStringSetCommand(mut self, action_name: string, target_resource: string) -> AppWorld {
        return self.registerCommand(AppCommand.stringSet(action_name, target_resource));
    }

    public fn registerIntSetCommand(mut self, action_name: string, target_resource: string) -> AppWorld {
        return self.registerCommand(AppCommand.intSet(action_name, target_resource));
    }

    public fn registerFloatSetCommand(mut self, action_name: string, target_resource: string) -> AppWorld {
        return self.registerCommand(AppCommand.floatSet(action_name, target_resource));
    }

    public fn registerBoolSetCommand(mut self, action_name: string, target_resource: string) -> AppWorld {
        return self.registerCommand(AppCommand.boolSet(action_name, target_resource));
    }

    public fn registerBehavior(mut self, action_name: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppWorld {
        return self.registerBehaviorWithMode(action_name, false, handler);
    }

    public fn registerBehaviorPrefix(mut self, action_prefix: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppWorld {
        return self.registerBehaviorWithMode(action_prefix, true, handler);
    }

    public fn registerCommandHandler(mut self, handler: Box<dyn AppCommandHandler>) -> AppWorld {
        self.command_handlers.push(handler);
        return self;
    }

    private fn registerBehaviorWithMode(mut self, action_name: string, prefix: bool, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppWorld {
        if (action_name.len == 0) { return self; }
        var i: i32 = 0;
        while (i < (self.behaviors.len as i32)) {
            let current = self.behaviors.get(i as i64);
            if (current.action_name == action_name && current.prefix == prefix) {
                self.behaviors.set(i as i64, AppBehavior.create(action_name, prefix, handler));
                return self;
            }
            i = i + 1;
        }
        self.behaviors.push(AppBehavior.create(action_name, prefix, handler));
        return self;
    }

    public fn behaviorIndexForAction(&self, action_name: string) -> i32 {
        var prefix_index: i32 = -1;
        var prefix_length: i64 = -1;
        var i: i32 = 0;
        while (i < (self.behaviors.len as i32)) {
            let behavior = self.behaviors.get(i as i64);
            if (!behavior.prefix && behavior.action_name == action_name) { return i; }
            if (behavior.prefix && action_name.startsWith(behavior.action_name) && behavior.action_name.len > prefix_length) {
                prefix_index = i;
                prefix_length = behavior.action_name.len;
            }
            i = i + 1;
        }
        return prefix_index;
    }

    public fn commandCount(&self) -> i32 {
        return self.commands.len as i32;
    }

    public fn commandAt(&self, index: i32) -> AppCommand {
        if (index < 0 || index >= self.commandCount()) { return AppCommand.intDelta("", "", 0); }
        return self.commands.get(index as i64);
    }

    public fn commandIndexForAction(&self, action_name: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.commands.len as i32)) {
            let command = self.commands.get(i as i64);
            if (command.action_name == action_name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn applyCommandForAction(mut self, action: AppAction) -> AppWorld {
        var handler_i = (self.command_handlers.len as i32) - 1;
        while (handler_i >= 0) {
            let command = self.command_handlers.get(handler_i as i64).deref();
            if (command.matches(action)) { return command.execute(action, self); }
            handler_i = handler_i - 1;
        }
        let behavior_index = self.behaviorIndexForAction(action.name);
        if (behavior_index >= 0) {
            let handler = self.behaviors.get(behavior_index as i64).handler;
            return handler(action, self);
        }
        self.applyBuiltInCommandForActionMut(action);
        return self;
    }

    private fn applyBuiltInCommandForActionMut(&mut self, action: AppAction) {
        let index = self.commandIndexForAction(action.name);
        if (index < 0) { return; }
        let command = self.commands.get(index as i64);
        if (command.target_resource.len == 0) { return; }
        let kind = worldLoadI32(to_rawptr(&command));
        if (kind == 3) {
            self.setStringResourceMut(command.target_resource, action.payload);
            return;
        }
        if (kind == 4) {
            let next = app_parse_i32_or(action.payload, self.intResource(command.target_resource, 0));
            self.setIntResourceMut(command.target_resource, next);
            self.setStringResourceMut(command.target_resource, format("%d", next as i64));
            return;
        }
        if (kind == 5) {
            let next = app_parse_f32_or(action.payload, self.floatResource(command.target_resource, f32Zero()));
            self.setFloatResourceMut(command.target_resource, next);
            self.setStringResourceMut(command.target_resource, app_format_f32(next));
            return;
        }
        if (kind == 6) {
            let next = app_parse_bool_or(action.payload, self.boolResource(command.target_resource, false));
            self.setBoolResourceMut(command.target_resource, next);
            self.setStringResourceMut(command.target_resource, app_format_bool(next));
            return;
        }
        if (kind == 2) {
            self.setBoolResourceMut(command.target_resource, !self.boolResource(command.target_resource, false));
            return;
        }
        if (kind == 1) {
            self.incrementIntResourceMut(command.target_resource, command.int_delta);
        }
    }

    public fn applyNextCommand(mut self) -> AppWorld {
        match (self.drainNextAction()) {
            case Some(action) => { return self.applyCommandForAction(action); }
            case None => { }
        }
        return self;
    }

    public fn applyAllCommands(mut self) -> AppWorld {
        while (self.pendingActionCount() > 0) {
            self = self.applyNextCommand();
        }
        return self;
    }

    public fn focus(&self) -> FocusState {
        return self.focus_state.dup();
    }

    public fn focusCount(&self) -> i32 {
        return self.focus_state.order.len as i32;
    }

    public fn focusedId(&self) -> string {
        return self.focus_state.current_id;
    }

    public fn focusAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.focusCount()) { return ""; }
        return self.focus_state.order.get(index as i64);
    }

    public fn focusIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < self.focusCount()) {
            if (self.focus_state.order.get(i as i64) == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn registerFocusable(mut self, id: string) -> AppWorld {
        if (id.len == 0) { return self; }
        if (self.focusIndex(id) >= 0) { return self; }
        self.focus_state.order.push(id);
        return self;
    }

    public fn requestFocus(&mut self, id: string) -> bool {
        if (self.focusIndex(id) < 0) { return false; }
        self.focus_state.current_id = id;
        return true;
    }

    public fn clearFocus(mut self) -> AppWorld {
        self.focus_state.current_id = "";
        return self;
    }

    public fn focusNext(mut self) -> AppWorld {
        let count = self.focusCount();
        if (count <= 0) { return self; }
        let index = self.focusIndex(self.focus_state.current_id);
        if (index < 0 || index + 1 >= count) {
            self.focus_state.current_id = self.focus_state.order.get(0);
            return self;
        }
        self.focus_state.current_id = self.focus_state.order.get((index + 1) as i64);
        return self;
    }

    public fn focusPrevious(mut self) -> AppWorld {
        let count = self.focusCount();
        if (count <= 0) { return self; }
        let index = self.focusIndex(self.focus_state.current_id);
        if (index <= 0) {
            self.focus_state.current_id = self.focus_state.order.get((count - 1) as i64);
            return self;
        }
        self.focus_state.current_id = self.focus_state.order.get((index - 1) as i64);
        return self;
    }

    public fn registerAccessibility(mut self, node: AccessibilityNode) -> AppWorld {
        if (node.id.len == 0) { return self; }
        var i: i32 = 0;
        while (i < (self.accessibility_nodes.len as i32)) {
            let current = self.accessibility_nodes.get(i as i64);
            if (current.id == node.id) {
                // Only a real change bumps the revision, so a platform bridge is
                // not told to re-publish an identical tree every frame.
                if (current.descriptor() != node.descriptor()) {
                    self.accessibility_nodes.set(i as i64, node.dup());
                    self.accessibility_revision = self.accessibility_revision + 1 as u64;
                    self.accessibility_dirty = true;
                }
                return self;
            }
            i = i + 1;
        }
        self.accessibility_nodes.push(node.dup());
        self.accessibility_revision = self.accessibility_revision + 1 as u64;
        self.accessibility_dirty = true;
        return self;
    }

    public fn accessibilityCount(&self) -> i32 {
        return self.accessibility_nodes.len as i32;
    }

    public fn accessibilityRevision(&self) -> u64 {
        return self.accessibility_revision;
    }

    public fn accessibilityDirty(&self) -> bool {
        return self.accessibility_dirty;
    }

    public fn clearAccessibilityDirty(mut self) -> AppWorld {
        self.accessibility_dirty = false;
        return self;
    }

    public fn accessibilityIndexOf(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < self.accessibilityCount()) {
            if (self.accessibility_nodes.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // Focus is derived at read time, so a node does not have to be re-registered
    // just because the caret moved somewhere else.
    public fn accessibilityNodeForId(&self, id: string) -> AccessibilityNode {
        let index = self.accessibilityIndexOf(id);
        if (index < 0) { return AccessibilityNode.empty(); }
        return self.accessibility_nodes.get(index as i64).dup().withFocus(self.focus_state.current_id == id);
    }

    public fn accessibilityFocusedNode(&self) -> AccessibilityNode {
        let id = self.focus_state.current_id;
        if (id.len == 0) { return AccessibilityNode.empty(); }
        return self.accessibilityNodeForId(id);
    }

    // One line per node. This is the assertion surface for headless tests and
    // the payload the developer inspector renders.
    public fn accessibilitySnapshotText(&self) -> string {
        var out = "";
        var i: i32 = 0;
        while (i < self.accessibilityCount()) {
            let id = self.accessibility_nodes.get(i as i64).id;
            out = out + self.accessibilityNodeForId(id).descriptor() + "\n";
            i = i + 1;
        }
        return out;
    }

    // Hands the neutral model to whichever bridge is installed. Returns the
    // number of nodes the bridge accepted.
    public fn publishAccessibilityTo(&self, bridge: dyn AppAccessibilityBridge) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < self.accessibilityCount()) {
            let id = self.accessibility_nodes.get(i as i64).id;
            if (bridge.publish(self.accessibilityNodeForId(id)) == 0) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    // ------------------------------------------------------------------
    // Keyboard routing (ZC-01)
    // ------------------------------------------------------------------

    public fn keyActionNameForViewId(&self, view_id: string) -> string {
        if (view_id.len == 0) { return ""; }
        return self.stringResource("key_action:" + view_id, "");
    }

    public fn registerKeyAction(mut self, view_id: string, action_name: string) -> AppWorld {
        if (view_id.len == 0 || action_name.len == 0) { return self; }
        return self.setStringResource("key_action:" + view_id, action_name);
    }

    public fn keyShortcutCount(&self) -> i32 {
        return self.key_shortcuts.len as i32;
    }

    public fn keyShortcutAt(&self, index: i32) -> AppKeyShortcut {
        if (index < 0 || index >= self.keyShortcutCount()) {
            return AppKeyShortcut.create(0, 0 as u32, "");
        }
        return self.key_shortcuts.get(index as i64).dup();
    }

    public fn registerKeyShortcut(mut self, shortcut: AppKeyShortcut) -> AppWorld {
        if (shortcut.action_name.len == 0) { return self; }
        var i: i32 = 0;
        while (i < self.keyShortcutCount()) {
            let current = self.key_shortcuts.get(i as i64);
            if (current.key == shortcut.key && current.modifiers == shortcut.modifiers) {
                self.key_shortcuts.set(i as i64, shortcut.dup());
                return self;
            }
            i = i + 1;
        }
        self.key_shortcuts.push(shortcut.dup());
        return self;
    }

    // Window-level bindings win over the focused node so an application can
    // always reserve a chord. Returns true when the key was consumed.
    public fn dispatchKeyShortcut(mut self, event: AppInteractionEvent) -> bool {
        var i: i32 = 0;
        while (i < self.keyShortcutCount()) {
            let shortcut = self.key_shortcuts.get(i as i64);
            if (shortcut.matches(event.key, event.modifiers, event.repeated)) {
                self = self.dispatch(AppAction.create(shortcut.action_name).fromSource(event.target_id).atFrame(event.frame_index));
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public static fn isFocusableUiKind(kind: i32) -> bool {
        return kind == uiNodeButton()
            || kind == uiNodeToggle()
            || kind == uiNodeTextInput()
            || kind == uiNodeSlider()
            || kind == uiNodeCheckbox();
    }

    // The focus order is re-derived from the live UI tree instead of being
    // accumulated forever. Nodes that no longer exist (a deleted row, an
    // unmounted dialog) therefore drop out, and Tab can never land on a dead
    // entry. The current focus survives as long as it is still in the tree.
    public fn beginFocusOrder(mut self) -> AppWorld {
        self.focus_state.order.clear();
        return self;
    }

    public fn appendFocusOrder(mut self, id: string) -> AppWorld {
        if (id.len == 0) { return self; }
        // A modal layer hides everything that is not part of it, so Tab can
        // never reach a control behind the dialog.
        let modal = self.topModalLayerId();
        if (modal.len > 0 && self.layerOfViewId(id) != modal) { return self; }
        self.focus_state.order.push(id);
        return self;
    }

    public fn endFocusOrder(mut self) -> AppWorld {
        if (self.focus_state.current_id.len > 0 && self.focusIndex(self.focus_state.current_id) < 0) {
            self.focus_state.current_id = "";
        }
        return self;
    }

    // Rules applied only when neither an application shortcut nor any node on
    // the event route consumed the key. At most one rule fires per key event,
    // which is what stops a single Tab press from advancing focus twice.
    public fn applyDefaultKeyNavigation(mut self, event: AppInteractionEvent) -> AppWorld {
        if (event.repeated) { return self; }
        if (event.key == KeyCode.escape()) {
            // Esc dismisses the topmost layer first; only when nothing is open
            // does it drop focus.
            if (self.topLayerDismissible()) {
                return self.closeLayer(self.topLayerId());
            }
            return self.clearFocus();
        }
        if (event.key == KeyCode.tab()) {
            if (appKeyModifiersSatisfy(appKeyModShift(), event.modifiers)) {
                return self.focusPrevious();
            }
            return self.focusNext();
        }
        let focused = self.focus_state.current_id;
        if (focused.len == 0) { return self; }
        // Scroll keys act on the innermost container around the focused node.
        if (event.key == KeyCode.pageUp() || event.key == KeyCode.pageDown()
            || event.key == KeyCode.home() || event.key == KeyCode.end()) {
            return self.applyKeyboardScroll(event);
        }
        if (KeyCode.isActivate(event.key)) {
            // A text field owns Enter/Space itself; activating it from here
            // would fire the action on every keystroke.
            if (self.isTextInputViewId(focused)) { return self; }
            return self.dispatchViewAction(focused);
        }
        if (KeyCode.isArrow(event.key)) {
            if (event.key == KeyCode.left() || event.key == KeyCode.up()) {
                return self.focusPrevious();
            }
            return self.focusNext();
        }
        return self;
    }

    // ------------------------------------------------------------------
    // Overlay layers (ZC-02)
    // ------------------------------------------------------------------

    public fn layerCount(&self) -> i32 {
        return self.layers.len as i32;
    }

    public fn layerAt(&self, index: i32) -> AppLayer {
        if (index < 0 || index >= self.layerCount()) { return AppLayer.create("", appLayerDialog()); }
        return self.layers.get(index as i64).dup();
    }

    public fn layerIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < self.layerCount()) {
            if (self.layers.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn topLayerId(&self) -> string {
        if (self.layerCount() == 0) { return ""; }
        return self.layers.get((self.layerCount() - 1) as i64).id;
    }

    public fn topLayer(&self) -> AppLayer {
        if (self.layerCount() == 0) { return AppLayer.create("", appLayerDialog()); }
        return self.layers.get((self.layerCount() - 1) as i64).dup();
    }

    public fn topLayerDismissible(&self) -> bool {
        if (self.layerCount() == 0) { return false; }
        return self.layers.get((self.layerCount() - 1) as i64).dismiss_on_escape;
    }

    // Id of the topmost modal layer, or "" when nothing is trapping focus.
    public fn topModalLayerId(&self) -> string {
        var i: i32 = self.layerCount() - 1;
        while (i >= 0) {
            let layer = self.layers.get(i as i64);
            if (layer.modal) { return layer.id; }
            i = i - 1;
        }
        return "";
    }

    public fn setViewLayer(mut self, view_id: string, layer_id: string) -> AppWorld {
        if (view_id.len == 0 || layer_id.len == 0) { return self; }
        return self.setStringResource("layer_of:" + view_id, layer_id);
    }

    public fn layerOfViewId(&self, view_id: string) -> string {
        if (view_id.len == 0) { return ""; }
        return self.stringResource("layer_of:" + view_id, "");
    }

    // Opening a layer captures the current focus so that closing it restores
    // the user's place instead of dropping them at the top of the page.
    public fn openLayer(mut self, layer: AppLayer) -> AppWorld {
        if (layer.id.len == 0) { return self; }
        var entry = layer.dup();
        let index = self.layerIndex(layer.id);
        if (index >= 0) {
            let existing = self.layers.get(index as i64);
            entry.restore_focus_id = existing.restore_focus_id;
            self.layers.set(index as i64, entry);
            return self;
        }
        entry.restore_focus_id = self.focus_state.current_id;
        self.layers.push(entry);
        return self;
    }

    public fn closeLayer(mut self, id: string) -> AppWorld {
        let index = self.layerIndex(id);
        if (index < 0) { return self; }
        let closing = self.layers.get(index as i64);
        self.layers.remove(index as i64);
        if (self.topModalLayerId().len == 0
            && closing.restore_focus_id.len > 0
            && self.focusIndex(closing.restore_focus_id) >= 0) {
            self.focus_state.current_id = closing.restore_focus_id;
        }
        return self;
    }

    public fn clearLayers(mut self) -> AppWorld {
        self.layers.clear();
        return self;
    }

    // ------------------------------------------------------------------
    // Scroll containers (ZC-03)
    // ------------------------------------------------------------------

    public fn registerScrollContainer(mut self, view_id: string) -> AppWorld {
        if (view_id.len == 0) { return self; }
        var i: i32 = 0;
        while (i < self.scrollContainerCount()) {
            if (self.scroll_containers.get(i as i64) == view_id) { return self; }
            i = i + 1;
        }
        self.scroll_containers.push(view_id);
        return self;
    }

    public fn scrollContainerCount(&self) -> i32 {
        return self.scroll_containers.len as i32;
    }

    public fn scrollContainerAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.scrollContainerCount()) { return ""; }
        return self.scroll_containers.get(index as i64);
    }

    public fn scrollOffsetResourceForViewId(&self, view_id: string) -> string {
        if (view_id.len == 0) { return ""; }
        return self.stringResource("scroll_offset:" + view_id, "");
    }

    public fn scrollExtentForViewId(&self, view_id: string) -> f32 {
        if (view_id.len == 0) { return f32Zero(); }
        return self.floatResource("scroll_extent:" + view_id, f32Zero());
    }

    // Written every frame from the laid-out node, so clamping always uses the
    // real viewport instead of a number the caller had to guess.
    public fn scrollViewportForViewId(&self, view_id: string) -> f32 {
        if (view_id.len == 0) { return f32Zero(); }
        return self.floatResource("scroll_viewport:" + view_id, f32Zero());
    }

    public fn scrollMaxOffsetForViewId(&self, view_id: string) -> f32 {
        var max_offset = self.scrollExtentForViewId(view_id) - self.scrollViewportForViewId(view_id);
        if (max_offset < f32Zero()) { max_offset = f32Zero(); }
        return max_offset;
    }

    public fn scrollOffsetForViewId(&self, view_id: string) -> f32 {
        let resource = self.scrollOffsetResourceForViewId(view_id);
        if (resource.len == 0) { return f32Zero(); }
        return self.floatResource(resource, f32Zero());
    }

    public fn setScrollOffsetForViewId(mut self, view_id: string, offset: f32) -> AppWorld {
        let resource = self.scrollOffsetResourceForViewId(view_id);
        if (resource.len == 0) { return self; }
        var clamped = offset;
        let max_offset = self.scrollMaxOffsetForViewId(view_id);
        if (clamped < f32Zero()) { clamped = f32Zero(); }
        if (clamped > max_offset) { clamped = max_offset; }
        return self.setFloatResource(resource, clamped);
    }

    // True when this container still has room to move in the requested
    // direction -- which is what decides whether an outer container also moves.
    public fn scrollContainerAccepts(&self, view_id: string, dy: f32) -> bool {
        if (self.scrollOffsetResourceForViewId(view_id).len == 0) { return false; }
        let offset = self.scrollOffsetForViewId(view_id);
        if (dy < f32Zero() && offset > f32Zero()) { return true; }
        if (dy > f32Zero() && offset < self.scrollMaxOffsetForViewId(view_id)) { return true; }
        return false;
    }

    // The innermost container on the route that can still move takes the delta;
    // a container already at its edge passes the event outward, which is nested
    // scrolling. Returns true when something consumed it.
    // Returns the world: a `mut self -> bool` method would silently discard the
    // offset it just wrote, because the mutated value is not what comes back.
    public fn applyScroll(mut self, event: AppInteractionEvent, dy: f32) -> AppWorld {
        var i: i32 = self.interactionRouteCount(event.route) - 1;
        while (i >= 0) {
            let id = self.interactionRouteAt(event.route, i);
            if (self.scrollContainerAccepts(id, dy)) {
                self = self.setScrollOffsetForViewId(id, self.scrollOffsetForViewId(id) + dy);
                self = self.setFloatResource("scroll_velocity:" + id, dy * 2.0);
                return self;
            }
            i = i - 1;
        }
        return self;
    }

    // Id of the innermost scroll container on the route, or "".
    public fn scrollContainerForRoute(&self, route: string) -> string {
        var i: i32 = self.interactionRouteCount(route) - 1;
        while (i >= 0) {
            let id = self.interactionRouteAt(route, i);
            if (self.scrollOffsetResourceForViewId(id).len > 0) { return id; }
            i = i - 1;
        }
        return "";
    }

    // PageUp/PageDown move by a viewport, Home/End jump to an edge. Only the
    // innermost container around the focused node responds, so one key press
    // never scrolls two nested lists at once.
    public fn applyKeyboardScroll(mut self, event: AppInteractionEvent) -> AppWorld {
        let target = self.scrollContainerForRoute(event.route);
        if (target.len == 0) { return self; }
        if (event.key == KeyCode.home()) {
            return self.setScrollOffsetForViewId(target, f32Zero());
        }
        if (event.key == KeyCode.end()) {
            return self.setScrollOffsetForViewId(target, self.scrollMaxOffsetForViewId(target));
        }
        var step = f32Zero();
        if (event.key == KeyCode.pageUp()) { step = -400.0; }
        if (event.key == KeyCode.pageDown()) { step = 400.0; }
        if (step == f32Zero()) { return self; }
        return self.setScrollOffsetForViewId(target, self.scrollOffsetForViewId(target) + step);
    }

    // ------------------------------------------------------------------
    // Change set (ZC-04)
    // ------------------------------------------------------------------

    // Every resource write lands here, so a component can ask "was anything in
    // my namespace touched?" instead of rebuilding on every unrelated change.
    private fn markResourceDirtyMut(&mut self, id: string) {
        if (id.len == 0) { return; }
        var i: i32 = 0;
        while (i < (self.dirty_resources.len as i32)) {
            if (self.dirty_resources.get(i as i64) == id) { return; }
            i = i + 1;
        }
        self.dirty_resources.push(id);
    }

    public fn dirtyResourceCount(&self) -> i32 {
        return self.dirty_resources.len as i32;
    }

    public fn dirtyResourceAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.dirtyResourceCount()) { return ""; }
        return self.dirty_resources.get(index as i64);
    }

    public fn hasDirtyResource(&self, id: string) -> bool {
        var i: i32 = 0;
        while (i < self.dirtyResourceCount()) {
            if (self.dirty_resources.get(i as i64) == id) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn hasDirtyResourceWithPrefix(&self, prefix: string) -> bool {
        if (prefix.len == 0) { return false; }
        var i: i32 = 0;
        while (i < self.dirtyResourceCount()) {
            if (self.dirty_resources.get(i as i64).startsWith(prefix)) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn clearDirtyResources(mut self) -> AppWorld {
        self.dirty_resources.clear();
        return self;
    }

    // Prefixes whose changes require this component to rebuild. Defaults to the
    // component's own namespace, so `tasks.*` state does not rebuild a sidebar.
    public fn addComponentWatchPrefix(mut self, component_id: string, prefix: string) -> AppWorld {
        if (component_id.len == 0 || prefix.len == 0) { return self; }
        return self.appendStringListResource("watch:" + component_id, prefix);
    }

    public fn componentWatchPrefixes(&self, component_id: string) -> Vec<string> {
        var out = Vec::<string>.new();
        if (component_id.len == 0) { return out; }
        let key = "watch:" + component_id;
        let count = self.stringListResourceCount(key);
        if (count > 0) {
            var i: i32 = 0;
            while (i < count) {
                out.push(self.stringListResourceAt(key, i));
                i = i + 1;
            }
            return out;
        }
        out.push(component_id + ".");
        return out;
    }

    // True when the pending change set touches this component's namespace. A
    // component that never declares a watch prefix keeps the old behaviour of
    // rebuilding on any change.
    public fn componentNeedsRebuild(&self, component_id: string) -> bool {
        let key = "watch:" + component_id;
        let count = self.stringListResourceCount(key);
        if (count > 0) {
            var i: i32 = 0;
            while (i < count) {
                if (self.hasDirtyResourceWithPrefix(self.stringListResourceAt(key, i))) { return true; }
                i = i + 1;
            }
            return false;
        }
        if (component_id.len == 0) { return true; }
        return self.hasDirtyResourceWithPrefix(component_id + ".");
    }

    // ------------------------------------------------------------------
    // Effect boundary (ZC-06)
    // ------------------------------------------------------------------

    public fn effectClock(&self) -> u64 {
        return self.effect_clock;
    }

    public fn tickEffectClock(mut self) -> AppWorld {
        self.effect_clock = self.effect_clock + 1 as u64;
        return self;
    }

    public fn setEffectInFlightLimit(mut self, limit: i32) -> AppWorld {
        if (limit < 1) { limit = 1; }
        self.effect_in_flight_limit = limit;
        return self;
    }

    public fn effectInFlightLimit(&self) -> i32 {
        return self.effect_in_flight_limit;
    }

    public fn effectInFlightCount(&self) -> i32 {
        return self.effect_requests.len as i32;
    }

    public fn effectCompletionCount(&self) -> i32 {
        return self.effect_completions.len as i32;
    }

    public fn effectResultCount(&self) -> i32 {
        return self.effect_results.len as i32;
    }

    public fn effectDroppedCount(&self) -> i32 {
        return self.effect_dropped_count;
    }

    public fn unhandledEffectErrorCount(&self) -> i32 {
        return self.unhandled_effect_errors;
    }

    public fn lastEffectRequestId(&self) -> u64 {
        if (self.next_effect_id <= 1 as u64) { return 0 as u64; }
        return self.next_effect_id - 1 as u64;
    }

    public fn effectRequestIndex(&self, id: u64) -> i32 {
        var i: i32 = 0;
        while (i < self.effectInFlightCount()) {
            if (self.effect_requests.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn effectRequestAt(&self, index: i32) -> AppEffectRequest {
        if (index < 0 || index >= self.effectInFlightCount()) {
            return AppEffectRequest.create(0 as u64, 0, "", "", "", 0 as u64);
        }
        return self.effect_requests.get(index as i64).dup();
    }

    public fn effectResultAt(&self, index: i32) -> AppEffectResult {
        if (index < 0 || index >= self.effectResultCount()) {
            return AppEffectResult.create(0 as u64, 0, "", "", appEffectPending(), "", "");
        }
        return self.effect_results.get(index as i64).dup();
    }

    // Rate limits the in-flight set: a request beyond the limit is refused and
    // counted instead of being queued forever. Read the new id back with
    // `lastEffectRequestId()`.
    public fn requestEffect(mut self, kind: i32, owner_id: string, tag: string, payload: string, timeout_frames: u64) -> AppWorld {
        if (tag.len == 0) { return self; }
        if (self.effectInFlightCount() >= self.effect_in_flight_limit) {
            self.effect_dropped_count = self.effect_dropped_count + 1;
            return self;
        }
        let id = self.next_effect_id;
        self.next_effect_id = self.next_effect_id + 1 as u64;
        let deadline = self.effect_clock + timeout_frames;
        self.effect_requests.push(AppEffectRequest.create(id, kind, owner_id, tag, payload, deadline));
        return self;
    }

    public fn cancelEffect(mut self, id: u64) -> AppWorld {
        let index = self.effectRequestIndex(id);
        if (index < 0) { return self; }
        let request = self.effect_requests.get(index as i64);
        self.effect_requests.remove(index as i64);
        return self.pushEffectCompletion(AppEffectResult.create(id, request.kind, request.owner_id, request.tag, appEffectCancelled(), "", ""));
    }

    // Cancels everything a component started. Called on unmount, and available
    // directly for a page change that keeps the component alive.
    public fn cancelEffectsOwnedBy(mut self, owner_id: string) -> AppWorld {
        var i: i32 = self.effectInFlightCount() - 1;
        while (i >= 0) {
            let request = self.effect_requests.get(i as i64);
            if (request.owner_id == owner_id) {
                self = self.cancelEffect(request.id);
            }
            i = i - 1;
        }
        return self;
    }

    // Called by the host or an adapter when the outside work finished. The
    // result is only queued here; it becomes an action in
    // `commitEffectCompletions`, which runs on the UI scheduler.
    public fn completeEffect(mut self, id: u64, ok: bool, payload: string, error_message: string) -> AppWorld {
        let index = self.effectRequestIndex(id);
        if (index < 0) {
            self.effect_dropped_count = self.effect_dropped_count + 1;
            return self;
        }
        let request = self.effect_requests.get(index as i64);
        self.effect_requests.remove(index as i64);
        var status = appEffectFailed();
        if (ok) { status = appEffectDone(); }
        return self.pushEffectCompletion(AppEffectResult.create(id, request.kind, request.owner_id, request.tag, status, payload, error_message));
    }

    // Bounded queue: a slow consumer drops results rather than growing without
    // limit, and the drop is counted rather than being silent.
    private fn pushEffectCompletion(mut self, result: AppEffectResult) -> AppWorld {
        if ((self.effect_completions.len as i32) >= self.effect_completion_limit) {
            self.effect_dropped_count = self.effect_dropped_count + 1;
            return self;
        }
        self.effect_completions.push(result);
        return self;
    }

    // Requests past their deadline fail with an explicit error instead of
    // hanging forever. A zero deadline means "no timeout".
    public fn expireEffects(mut self) -> AppWorld {
        var i: i32 = self.effectInFlightCount() - 1;
        while (i >= 0) {
            let request = self.effect_requests.get(i as i64);
            if (request.deadline_clock > 0 as u64 && self.effect_clock > request.deadline_clock) {
                self.effect_requests.remove(i as i64);
                self = self.pushEffectCompletion(AppEffectResult.create(request.id, request.kind, request.owner_id, request.tag, appEffectExpired(), "", "effect timed out"));
            }
            i = i - 1;
        }
        return self;
    }

    private fn isEffectOwnerLive(&self, owner_id: string) -> bool {
        if (owner_id.len == 0) { return true; }
        return self.componentIndex(owner_id) >= 0;
    }

    // The UI scheduler's commit step: results for components that no longer
    // exist are dropped, failures are recorded instead of being swallowed, and
    // every accepted result turns into an ordinary action so the application
    // handles it like any other event.
    public fn commitEffectCompletions(mut self) -> AppWorld {
        var i: i32 = 0;
        while (i < (self.effect_completions.len as i32)) {
            let result = self.effect_completions.get(i as i64);
            if (self.isEffectOwnerLive(result.owner_id)) {
                self.effect_results.push(result.dup());
                if (result.isFailure()) {
                    self.unhandled_effect_errors = self.unhandled_effect_errors + 1;
                    self = self.setStringResource("effect.error", result.error_message);
                }
                self = self.dispatch(AppAction.create("effect." + result.tag).fromSource(result.owner_id).withPayload(result.payload));
            } else {
                self.effect_dropped_count = self.effect_dropped_count + 1;
            }
            i = i + 1;
        }
        self.effect_completions.clear();
        return self;
    }

    public fn accessibilityIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.accessibility_nodes.len as i32)) {
            if (self.accessibility_nodes.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn accessibilityAt(&self, index: i32) -> AccessibilityNode {
        if (index < 0 || index >= self.accessibilityCount()) { return AccessibilityNode.empty(); }
        return self.accessibility_nodes.get(index as i64).dup();
    }

    public fn accessibilityFor(&self, id: string) -> AccessibilityNode {
        let index = self.accessibilityIndex(id);
        if (index < 0) { return AccessibilityNode.empty(); }
        return self.accessibility_nodes.get(index as i64).dup();
    }

    public fn pendingActionCount(&self) -> i32 {
        return self.actions.len as i32;
    }

    public fn totalActionCount(&self) -> i32 {
        return self.total_actions;
    }

    public fn actionAt(&self, index: i32) -> AppAction {
        if (index < 0 || index >= self.pendingActionCount()) { return AppAction.create(""); }
        return self.actions.get(index as i64);
    }

    public fn drainNextAction(&mut self) -> Option<AppAction> {
        if (self.actions.len <= 0) { return None; }
        return Some(self.actions.remove(0));
    }

    public fn clearActions(mut self) -> AppWorld {
        self.actions.clear();
        return self;
    }

    public fn dup(&self) -> AppWorld {
        var out = AppWorld.create();
        out.next_entity_id = self.next_entity_id;

        var entity_i: i32 = 0;
        while (entity_i < (self.entities.len as i32)) {
            out.entities.push(self.entities.get(entity_i as i64));
            entity_i = entity_i + 1;
        }

        var string_i: i32 = 0;
        while (string_i < (self.string_resources.len as i32)) {
            out.string_resources.push(self.string_resources.get(string_i as i64).dup());
            string_i = string_i + 1;
        }

        var int_i: i32 = 0;
        while (int_i < (self.int_resources.len as i32)) {
            out.int_resources.push(self.int_resources.get(int_i as i64).dup());
            int_i = int_i + 1;
        }

        var float_i: i32 = 0;
        while (float_i < (self.float_resources.len as i32)) {
            out.float_resources.push(self.float_resources.get(float_i as i64).dup());
            float_i = float_i + 1;
        }

        var bool_i: i32 = 0;
        while (bool_i < (self.bool_resources.len as i32)) {
            out.bool_resources.push(self.bool_resources.get(bool_i as i64).dup());
            bool_i = bool_i + 1;
        }

        var string_list_i: i32 = 0;
        while (string_list_i < (self.string_list_resources.len as i32)) {
            out.string_list_resources.push(self.string_list_resources.get(string_list_i as i64).dup());
            string_list_i = string_list_i + 1;
        }

        var bool_list_i: i32 = 0;
        while (bool_list_i < (self.bool_list_resources.len as i32)) {
            out.bool_list_resources.push(self.bool_list_resources.get(bool_list_i as i64).dup());
            bool_list_i = bool_list_i + 1;
        }

        var interaction_i: i32 = 0;
        while (interaction_i < (self.interaction_events.len as i32)) {
            out.interaction_events.push(self.interaction_events.get(interaction_i as i64).dup());
            interaction_i = interaction_i + 1;
        }

        var action_i: i32 = 0;
        while (action_i < (self.actions.len as i32)) {
            out.actions.push(self.actions.get(action_i as i64).dup());
            action_i = action_i + 1;
        }

        var command_i: i32 = 0;
        while (command_i < (self.commands.len as i32)) {
            out.commands.push(self.commands.get(command_i as i64).dup());
            command_i = command_i + 1;
        }

        var behavior_i: i32 = 0;
        while (behavior_i < (self.behaviors.len as i32)) {
            out.behaviors.push(self.behaviors.get(behavior_i as i64).dup());
            behavior_i = behavior_i + 1;
        }

        var handler_i: i32 = 0;
        while (handler_i < (self.command_handlers.len as i32)) {
            out.command_handlers.push(self.command_handlers.get(handler_i as i64).deref().dup());
            handler_i = handler_i + 1;
        }

        var component_i: i32 = 0;
        while (component_i < (self.component_records.len as i32)) {
            out.component_records.push(self.component_records.get(component_i as i64).dup());
            component_i = component_i + 1;
        }

        out.focus_state.destroy();
        out.focus_state = self.focus_state.dup();

        var access_i: i32 = 0;
        while (access_i < (self.accessibility_nodes.len as i32)) {
            out.accessibility_nodes.push(self.accessibility_nodes.get(access_i as i64).dup());
            access_i = access_i + 1;
        }

        var shortcut_i: i32 = 0;
        while (shortcut_i < (self.key_shortcuts.len as i32)) {
            out.key_shortcuts.push(self.key_shortcuts.get(shortcut_i as i64).dup());
            shortcut_i = shortcut_i + 1;
        }

        var layer_i: i32 = 0;
        while (layer_i < (self.layers.len as i32)) {
            out.layers.push(self.layers.get(layer_i as i64).dup());
            layer_i = layer_i + 1;
        }

        var container_i: i32 = 0;
        while (container_i < (self.scroll_containers.len as i32)) {
            out.scroll_containers.push(self.scroll_containers.get(container_i as i64));
            container_i = container_i + 1;
        }

        var dirty_i: i32 = 0;
        while (dirty_i < (self.dirty_resources.len as i32)) {
            out.dirty_resources.push(self.dirty_resources.get(dirty_i as i64));
            dirty_i = dirty_i + 1;
        }

        out.accessibility_revision = self.accessibility_revision;
        out.accessibility_dirty = self.accessibility_dirty;

        var req_i: i32 = 0;
        while (req_i < (self.effect_requests.len as i32)) {
            out.effect_requests.push(self.effect_requests.get(req_i as i64).dup());
            req_i = req_i + 1;
        }
        var res_i: i32 = 0;
        while (res_i < (self.effect_results.len as i32)) {
            out.effect_results.push(self.effect_results.get(res_i as i64).dup());
            res_i = res_i + 1;
        }
        var comp_i: i32 = 0;
        while (comp_i < (self.effect_completions.len as i32)) {
            out.effect_completions.push(self.effect_completions.get(comp_i as i64).dup());
            comp_i = comp_i + 1;
        }
        out.next_effect_id = self.next_effect_id;
        out.effect_clock = self.effect_clock;
        out.effect_in_flight_limit = self.effect_in_flight_limit;
        out.effect_completion_limit = self.effect_completion_limit;
        out.effect_dropped_count = self.effect_dropped_count;
        out.unhandled_effect_errors = self.unhandled_effect_errors;

        out.total_actions = self.total_actions;
        out.total_interaction_events = self.total_interaction_events;
        out.total_component_mounts = self.total_component_mounts;
        out.total_component_updates = self.total_component_updates;
        out.total_component_unmounts = self.total_component_unmounts;
        out.state_revision = self.state_revision;
        return out;
    }

    public fn destroy(&mut self) {
        self.entities.destroy();
        self.string_resources.destroy();
        self.int_resources.destroy();
        self.float_resources.destroy();
        self.bool_resources.destroy();
        var string_list_i: i32 = 0;
        while (string_list_i < (self.string_list_resources.len as i32)) {
            var list = self.string_list_resources.get(string_list_i as i64);
            list.destroy();
            string_list_i = string_list_i + 1;
        }
        self.string_list_resources.destroy();
        var bool_list_i: i32 = 0;
        while (bool_list_i < (self.bool_list_resources.len as i32)) {
            var bool_list = self.bool_list_resources.get(bool_list_i as i64);
            bool_list.destroy();
            bool_list_i = bool_list_i + 1;
        }
        self.bool_list_resources.destroy();
        self.interaction_events.destroy();
        self.actions.destroy();
        self.commands.destroy();
        self.behaviors.destroy();
        var handler_i: i32 = 0;
        while (handler_i < (self.command_handlers.len as i32)) {
            self.command_handlers.get(handler_i as i64).drop();
            handler_i = handler_i + 1;
        }
        self.command_handlers.destroy();
        self.component_records.destroy();
        self.focus_state.destroy();
        self.accessibility_nodes.destroy();
        self.key_shortcuts.destroy();
        self.layers.destroy();
        self.scroll_containers.destroy();
        self.dirty_resources.destroy();
        self.effect_requests.destroy();
        self.effect_results.destroy();
        self.effect_completions.destroy();
    }
}
