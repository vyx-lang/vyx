module Zyn.App;

use std.collections;
use std.convert;
use std.string;
use std.encoding;
use formatF32 = Zyn.Nut.Types.formatF32;
use f32Zero = Zyn.Nut.Types.f32Zero;
use typesLoadF32 = Zyn.Nut.Types.typesLoadF32;
use typesLoadI32 = Zyn.Nut.Types.typesLoadI32;
use KeyCode = Zyn.Platform.Input.KeyCode;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

fn worldLoadF32(src: rawptr) -> f32 {
    return typesLoadF32(src);
}

fn worldLoadI32(src: rawptr) -> i32 {
    return typesLoadI32(src);
}

fn worldTimelineResource(id: string) -> bool {
    return !id.startsWith("ui.")
        && !id.startsWith("action:")
        && !id.startsWith("text_input:")
        && !id.startsWith("text_input_action:")
        && !id.startsWith("text_input_resource:")
        && !id.startsWith("text_input_composition:")
        && !id.startsWith("text_input_composition_start:")
        && !id.startsWith("text_input_composition_length:")
        && !id.startsWith("hover_action:")
        && !id.startsWith("hover_enter_action:")
        && !id.startsWith("hover_exit_action:")
        && !id.startsWith("pointer_down_action:")
        && !id.startsWith("pointer_up_action:")
        && !id.startsWith("pointer_move_action:")
        && !id.startsWith("pointer_scroll_action:")
        && !id.startsWith("pointer_drag_action:")
        && !id.startsWith("capture_action:")
        && !id.startsWith("bubble_action:");
}

@[repr(C)]
public struct InteractionPos {
    public x: f32;
    public y: f32;
    public dx: f32;
    public dy: f32;
}

public class Entity {
    public id: u64;
    public generation: u32;

    public static fn invalid() -> Entity {
        return Entity { id: 0 as u64, generation: 0 as u32 };
    }

    public static fn create(id: u64, generation: u32) -> Entity {
        return Entity { id: id, generation: generation };
    }

    public fn isValid(&self) -> bool {
        return self.id != 0 as u64;
    }

    public fn equals(&self, other: Entity) -> bool {
        return self.id == other.id && self.generation == other.generation;
    }
}

public class AppStringResource {
    public id: string;
    public value: string;

    public static fn create(id: string, value: string) -> AppStringResource {
        return AppStringResource { id: id, value: value };
    }

    public fn dup(&self) -> AppStringResource {
        return AppStringResource { id: self.id, value: self.value };
    }
}

public class AppIntResource {
    public value: i32;
    public id: string;

    public static fn create(id: string, value: i32) -> AppIntResource {
        return AppIntResource { value: value, id: id };
    }

    public fn dup(&self) -> AppIntResource {
        var out: AppIntResource;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<AppIntResource>() as i64);
        return out;
    }
}

@[borrow_args]
fn appIntValue(res: AppIntResource) -> i32 {
    return worldLoadI32(to_rawptr(&res));
}

public class AppFloatResource {
    public value: f32;
    public id: string;

    public static fn create(id: string, value: f32) -> AppFloatResource {
        return AppFloatResource { value: value, id: id };
    }

    public fn dup(&self) -> AppFloatResource {
        var out: AppFloatResource;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<AppFloatResource>() as i64);
        return out;
    }
}

@[borrow_args]
fn appFloatValue(res: AppFloatResource) -> f32 {
    return worldLoadF32(to_rawptr(&res));
}

public fn app_parse_i32_or(text: string, fallback: i32) -> i32 {
    if (text.len == 0) { return fallback; }
    var sign: i32 = 1;
    var i: i32 = 0;
    if (text.charAt(0) == 45) {
        sign = -1;
        i = 1;
    }
    var out: i32 = 0;
    var any: bool = false;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) {
            if (!any) { return fallback; }
            return out * sign;
        }
        out = (out * 10) + (c - 48);
        any = true;
        i = i + 1;
    }
    if (!any) { return fallback; }
    return out * sign;
}

public fn app_parse_f32_or(text: string, fallback: f32) -> f32 {
    match (f32_from_str(text)) {
        case Ok(v) => { return v; }
        case Err(_) => { return fallback; }
    }
}

public fn app_format_f32(value: f32) -> string {
    return formatF32(value);
}

public fn app_parse_bool_or(text: string, fallback: bool) -> bool {
    match (bool_from_str(text)) {
        case Ok(v) => { return v; }
        case Err(_) => { return fallback; }
    }
}

public fn app_format_bool(value: bool) -> string {
    if (value) { return "true"; }
    return "false";
}

public class AppBoolResource {
    public id: string;
    public value: bool;

    public static fn create(id: string, value: bool) -> AppBoolResource {
        return AppBoolResource { id: id, value: value };
    }

    public fn dup(&self) -> AppBoolResource {
        return AppBoolResource { id: self.id, value: self.value };
    }
}

public class AppStringListResource {
    public id: string;
    public values: Vec<string>;

    public static fn create(id: string) -> AppStringListResource {
        return AppStringListResource {
            id: id,
            values: Vec::<string>.new()
        };
    }

    public fn dup(&self) -> AppStringListResource {
        var out = AppStringListResource.create(self.id);
        var i: i32 = 0;
        while (i < (self.values.len as i32)) {
            out.values.push(self.values.get(i as i64));
            i = i + 1;
        }
        return out;
    }

    public fn count(&self) -> i32 {
        return self.values.len as i32;
    }

    public fn at(&self, index: i32) -> string {
        if (index < 0 || index >= self.count()) { return ""; }
        return self.values.get(index as i64);
    }

    public fn push(mut self, value: string) -> AppStringListResource {
        self.values.push(value);
        return self;
    }

    public fn removeAt(&mut self, index: i32) -> bool {
        if (index < 0 || index >= self.count()) { return false; }
        self.values.removeAt(index as i64);
        return true;
    }

    public fn destroy(&mut self) {
        self.values.destroy();
    }
}

public class AppBoolListResource {
    public id: string;
    public values: Vec<bool>;

    public static fn create(id: string) -> AppBoolListResource {
        return AppBoolListResource {
            id: id,
            values: Vec::<bool>.new()
        };
    }

    public fn dup(&self) -> AppBoolListResource {
        var out = AppBoolListResource.create(self.id);
        var i: i32 = 0;
        while (i < (self.values.len as i32)) {
            out.values.push(self.values.get(i as i64));
            i = i + 1;
        }
        return out;
    }

    public fn count(&self) -> i32 {
        return self.values.len as i32;
    }

    public fn at(&self, index: i32) -> bool {
        if (index < 0 || index >= self.count()) { return false; }
        return self.values.get(index as i64);
    }

    public fn push(mut self, value: bool) -> AppBoolListResource {
        self.values.push(value);
        return self;
    }

    public fn setAt(&mut self, index: i32, value: bool) -> bool {
        if (index < 0 || index >= self.count()) { return false; }
        self.values.set(index as i64, value);
        return true;
    }

    public fn ensureCount(mut self, count: i32, value: bool) -> AppBoolListResource {
        while ((self.values.len as i32) < count) {
            self.values.push(value);
        }
        return self;
    }

    public fn removeAt(&mut self, index: i32) -> bool {
        if (index < 0 || index >= self.count()) { return false; }
        self.values.removeAt(index as i64);
        return true;
    }

    public fn destroy(&mut self) {
        self.values.destroy();
    }
}

public class AppAction {
    public name: string;
    public source: string;
    public payload: string;
    public frame_index: u64;

    public static fn create(name: string) -> AppAction {
        return AppAction {
            name: name,
            source: "",
            payload: "",
            frame_index: 0 as u64
        };
    }

    public fn fromSource(mut self, source: string) -> AppAction {
        self.source = source;
        return self;
    }

    public fn withPayload(mut self, payload: string) -> AppAction {
        self.payload = payload;
        return self;
    }

    public fn atFrame(mut self, frame_index: u64) -> AppAction {
        self.frame_index = frame_index;
        return self;
    }

    public fn toEvent(&self) -> AppEvent {
        return AppEvent.action(self.name);
    }

    public fn dup(&self) -> AppAction {
        return AppAction {
            name: self.name,
            source: self.source,
            payload: self.payload,
            frame_index: self.frame_index
        };
    }
}

public class AppBehavior {
    public action_name: string;
    public prefix: bool;
    public handler: fn(AppAction, AppWorld) -> AppWorld;

    public static fn create(action_name: string, prefix: bool, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppBehavior {
        return AppBehavior { action_name: action_name, prefix: prefix, handler: handler };
    }

    public fn dup(&self) -> AppBehavior {
        return AppBehavior.create(self.action_name, self.prefix, self.handler);
    }
}

// Implement this interface for commands with application-owned configuration.
// dup() must return an independent object because AppWorld is copied for scenes
// and the runtime.
public interface AppCommandHandler {
    fn matches(&self, action: AppAction) -> bool;
    fn execute(&self, action: AppAction, world: AppWorld) -> AppWorld;
    fn dup(&self) -> Box<dyn AppCommandHandler>;
}

public class AppCommand {
    public command_kind: i32;
    public action_name: string;
    public target_resource: string;
    public int_delta: i32;

    public static fn intDelta(action_name: string, target_resource: string, int_delta: i32) -> AppCommand {
        return AppCommand {
            command_kind: 1,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: int_delta
        };
    }

    public static fn boolToggle(action_name: string, target_resource: string) -> AppCommand {
        return AppCommand {
            command_kind: 2,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: 0
        };
    }

    public static fn stringSet(action_name: string, target_resource: string) -> AppCommand {
        return AppCommand {
            command_kind: 3,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: 0
        };
    }

    public static fn intSet(action_name: string, target_resource: string) -> AppCommand {
        return AppCommand {
            command_kind: 4,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: 0
        };
    }

    public static fn floatSet(action_name: string, target_resource: string) -> AppCommand {
        return AppCommand {
            command_kind: 5,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: 0
        };
    }

    public static fn boolSet(action_name: string, target_resource: string) -> AppCommand {
        return AppCommand {
            command_kind: 6,
            action_name: action_name,
            target_resource: target_resource,
            int_delta: 0
        };
    }

    public fn appliesTo(&self, action: AppAction) -> bool {
        if (self.action_name.len == 0) { return false; }
        return self.action_name == action.name;
    }

    public fn dup(&self) -> AppCommand {
        return AppCommand {
            command_kind: self.command_kind,
            action_name: self.action_name,
            target_resource: self.target_resource,
            int_delta: self.int_delta
        };
    }
}

public class AppInteractionEvent {
    public pos: InteractionPos;
    public kind: i32;
    public target_id: string;
    public action_name: string;
    public payload: string;
    public route: string;
    public priority: i32;
    public frame_index: u64;
    public consumed: bool;
    public key: i32;
    public modifiers: u32;
    public repeated: bool;

    public static fn create(kind: i32, target_id: string, action_name: string, payload: string, x: f32, y: f32, dx: f32, dy: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent {
            pos: InteractionPos { x: x, y: y, dx: dx, dy: dy },
            kind: kind,
            target_id: target_id,
            action_name: action_name,
            payload: payload,
            route: target_id,
            priority: 0,
            frame_index: frame_index,
            consumed: false,
            key: 0,
            modifiers: 0 as u32,
            repeated: false
        };
    }

    public static fn pointerMoved(target_id: string, action_name: string, x: f32, y: f32, dx: f32, dy: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionPointerMoved(), target_id, action_name, "", x, y, dx, dy, frame_index);
    }

    public static fn pointerDown(target_id: string, action_name: string, x: f32, y: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionPointerDown(), target_id, action_name, "", x, y, f32Zero(), f32Zero(), frame_index);
    }

    public static fn pointerUp(target_id: string, action_name: string, x: f32, y: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionPointerUp(), target_id, action_name, "", x, y, f32Zero(), f32Zero(), frame_index);
    }

    public static fn pointerScrolled(target_id: string, action_name: string, x: f32, y: f32, dx: f32, dy: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionPointerScrolled(), target_id, action_name, "", x, y, dx, dy, frame_index);
    }

    public static fn pointerDragged(target_id: string, action_name: string, payload: string, x: f32, y: f32, dx: f32, dy: f32, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionPointerDragged(), target_id, action_name, payload, x, y, dx, dy, frame_index);
    }

    public static fn textInput(target_id: string, action_name: string, payload: string, frame_index: u64) -> AppInteractionEvent {
        return AppInteractionEvent.create(appInteractionTextInput(), target_id, action_name, payload, f32Zero(), f32Zero(), f32Zero(), f32Zero(), frame_index);
    }

    // Keyboard events ride the exact same capture/target/bubble route as
    // pointer events: only the payload differs, so a node cannot be activated
    // twice by two parallel dispatchers.
    public static fn keyDown(target_id: string, action_name: string, route: string, key: i32, modifiers: u32, repeated: bool, frame_index: u64) -> AppInteractionEvent {
        var event = AppInteractionEvent.create(appInteractionKeyDown(), target_id, action_name, "", f32Zero(), f32Zero(), f32Zero(), f32Zero(), frame_index);
        event.route = route;
        event.key = key;
        event.modifiers = modifiers;
        event.repeated = repeated;
        return event;
    }

    public static fn keyUp(target_id: string, action_name: string, route: string, key: i32, modifiers: u32, frame_index: u64) -> AppInteractionEvent {
        var event = AppInteractionEvent.create(appInteractionKeyUp(), target_id, action_name, "", f32Zero(), f32Zero(), f32Zero(), f32Zero(), frame_index);
        event.route = route;
        event.key = key;
        event.modifiers = modifiers;
        return event;
    }

    public fn markConsumed(mut self) -> AppInteractionEvent {
        self.consumed = true;
        return self;
    }

    public fn withRoute(mut self, route: string) -> AppInteractionEvent {
        self.route = route;
        return self;
    }

    public fn withPriority(mut self, priority: i32) -> AppInteractionEvent {
        self.priority = priority;
        return self;
    }

    public fn dup(&self) -> AppInteractionEvent {
        var out: AppInteractionEvent;
        memcpy(to_rawptr(&out), to_rawptr(self), sizeof::<AppInteractionEvent>() as i64);
        return out;
    }
}

@[borrow_args]
public fn interactionPosOf(event: AppInteractionEvent) -> InteractionPos {
    var out: InteractionPos;
    memcpy(to_rawptr(&out), to_rawptr(&event), 16);
    return out;
}

public class FocusState {
    public current_id: string;
    public order: Vec<string>;

    public static fn create() -> FocusState {
        return FocusState {
            current_id: "",
            order: Vec::<string>.new()
        };
    }

    public fn dup(&self) -> FocusState {
        var out = FocusState.create();
        out.current_id = self.current_id;
        var i: i32 = 0;
        while (i < (self.order.len as i32)) {
            out.order.push(self.order.get(i as i64));
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.order.destroy();
    }
}

// A window-level key binding. Shortcuts are consulted before the focused node's
// own key action so that an application can always reserve a chord, while a
// plain key (Tab/Enter/Space/arrows) falls through to the focus rules.
public class AppKeyShortcut {
    public key: i32;
    public modifiers: u32;
    public action_name: string;
    public repeatable: bool;

    public static fn create(key: i32, modifiers: u32, action_name: string) -> AppKeyShortcut {
        return AppKeyShortcut { key: key, modifiers: modifiers, action_name: action_name, repeatable: false };
    }

    public fn allowRepeat(mut self) -> AppKeyShortcut {
        self.repeatable = true;
        return self;
    }

    public fn matches(&self, key: i32, modifiers: u32, repeated: bool) -> bool {
        if (self.key != key) { return false; }
        if (repeated && !self.repeatable) { return false; }
        return appKeyModifiersSatisfy(self.modifiers, modifiers);
    }

    public fn dup(&self) -> AppKeyShortcut {
        return AppKeyShortcut {
            key: self.key,
            modifiers: self.modifiers,
            action_name: self.action_name,
            repeatable: self.repeatable
        };
    }
}

// An overlay layer owns focus while it is on top. It remembers which node had
// focus before it opened, so dismissing it restores the user's place instead of
// dropping them at the top of the page. A modal layer also hides the rest of
// the tree from Tab and from the pointer.
public class AppLayer {
    public id: string;
    public kind: i32;
    public modal: bool;
    public dismiss_on_escape: bool;
    public restore_focus_id: string;

    public static fn create(id: string, kind: i32) -> AppLayer {
        return AppLayer {
            id: id,
            kind: kind,
            modal: kind != appLayerTooltip(),
            dismiss_on_escape: true,
            restore_focus_id: ""
        };
    }

    public static fn dialog(id: string) -> AppLayer {
        return AppLayer.create(id, appLayerDialog());
    }

    public static fn popover(id: string) -> AppLayer {
        return AppLayer.create(id, appLayerPopover());
    }

    public fn nonModal(mut self) -> AppLayer {
        self.modal = false;
        return self;
    }

    public fn persistent(mut self) -> AppLayer {
        self.dismiss_on_escape = false;
        return self;
    }

    public fn dup(&self) -> AppLayer {
        return AppLayer {
            id: self.id,
            kind: self.kind,
            modal: self.modal,
            dismiss_on_escape: self.dismiss_on_escape,
            restore_focus_id: self.restore_focus_id
        };
    }
}

// Platform-neutral description of one interactive node. The runtime never
// talks to a platform accessibility API directly: it keeps this model and hands
// it to a bridge, so the same tree drives Windows UI Automation, a test
// snapshot, or the developer inspector.
public class AccessibilityNode {
    public id: string;
    public role: string;
    public label: string;
    public hint: string;
    public state: string;
    public value: string;
    public actions: string;
    public parent_id: string;
    public level: i32;
    public focused: bool;

    public static fn create(id: string, role: string, label: string, hint: string) -> AccessibilityNode {
        return AccessibilityNode {
            id: id,
            role: role,
            label: label,
            hint: hint,
            state: "",
            value: "",
            actions: "",
            parent_id: "",
            level: 0,
            focused: false
        };
    }

    public static fn empty() -> AccessibilityNode {
        return AccessibilityNode.create("", "", "", "");
    }

    public fn isEmpty(&self) -> bool {
        return self.id.len == 0;
    }

    public fn withState(mut self, state: string) -> AccessibilityNode {
        self.state = state;
        return self;
    }

    public fn withValue(mut self, value: string) -> AccessibilityNode {
        self.value = value;
        return self;
    }

    public fn withActions(mut self, actions: string) -> AccessibilityNode {
        self.actions = actions;
        return self;
    }

    public fn withParent(mut self, parent_id: string) -> AccessibilityNode {
        self.parent_id = parent_id;
        return self;
    }

    public fn withLevel(mut self, level: i32) -> AccessibilityNode {
        self.level = level;
        return self;
    }

    public fn withFocus(mut self, focused: bool) -> AccessibilityNode {
        self.focused = focused;
        return self;
    }

    public fn hasState(&self, state: string) -> bool {
        if (state.len == 0) { return false; }
        return self.state == state;
    }

    public fn hasAction(&self, action_name: string) -> bool {
        if (action_name.len == 0 || self.actions.len == 0) { return false; }
        return self.actions == action_name || self.actions.startsWith(action_name + ",")
            || self.actions.endsWith("," + action_name)
            || self.actions.contains("," + action_name + ",");
    }

    public fn isInteractive(&self) -> bool {
        return self.role == "button" || self.role == "textbox" || self.role == "switch"
            || self.role == "slider" || self.role == "checkbox";
    }

    // One line per node, which is what a headless test asserts on and what the
    // developer inspector shows.
    public fn descriptor(&self) -> string {
        var out = self.role + " " + self.id;
        if (self.label.len > 0) { out = out + " \"" + self.label + "\""; }
        if (self.state.len > 0) { out = out + " state=" + self.state; }
        if (self.value.len > 0) { out = out + " value=" + self.value; }
        if (self.actions.len > 0) { out = out + " actions=" + self.actions; }
        if (self.parent_id.len > 0) { out = out + " parent=" + self.parent_id; }
        if (self.level != 0) { out = out + " level=" + format("%d", self.level as i64); }
        if (self.focused) { out = out + " focused"; }
        return out;
    }

    public fn dup(&self) -> AccessibilityNode {
        return AccessibilityNode {
            id: self.id,
            role: self.role,
            label: self.label,
            hint: self.hint,
            state: self.state,
            value: self.value,
            actions: self.actions,
            parent_id: self.parent_id,
            level: self.level,
            focused: self.focused
        };
    }
}

// A unit of outside work. Requests are created on the UI scheduler and carry
// the component that owns them, so a page change can cancel everything it
// started instead of leaking results into a dead component.
public class AppEffectRequest {
    public id: u64;
    public kind: i32;
    public owner_id: string;
    public tag: string;
    public payload: string;
    public deadline_clock: u64;
    public cancelled: bool;

    public static fn create(id: u64, kind: i32, owner_id: string, tag: string, payload: string, deadline_clock: u64) -> AppEffectRequest {
        return AppEffectRequest {
            id: id,
            kind: kind,
            owner_id: owner_id,
            tag: tag,
            payload: payload,
            deadline_clock: deadline_clock,
            cancelled: false
        };
    }

    public fn dup(&self) -> AppEffectRequest {
        return AppEffectRequest {
            id: self.id,
            kind: self.kind,
            owner_id: self.owner_id,
            tag: self.tag,
            payload: self.payload,
            deadline_clock: self.deadline_clock,
            cancelled: self.cancelled
        };
    }
}

public class AppEffectResult {
    public request_id: u64;
    public kind: i32;
    public owner_id: string;
    public tag: string;
    public status: i32;
    public payload: string;
    public error_message: string;

    public static fn create(request_id: u64, kind: i32, owner_id: string, tag: string, status: i32, payload: string, error_message: string) -> AppEffectResult {
        return AppEffectResult {
            request_id: request_id,
            kind: kind,
            owner_id: owner_id,
            tag: tag,
            status: status,
            payload: payload,
            error_message: error_message
        };
    }

    public fn isFailure(&self) -> bool {
        return self.status == appEffectFailed() || self.status == appEffectExpired();
    }

    public fn dup(&self) -> AppEffectResult {
        return AppEffectResult {
            request_id: self.request_id,
            kind: self.kind,
            owner_id: self.owner_id,
            tag: self.tag,
            status: self.status,
            payload: self.payload,
            error_message: self.error_message
        };
    }
}

// Implemented by the platform layer (Windows UI Automation, a test snapshot, or
// the developer inspector). Zyn only ever publishes the neutral model above.
public interface AppAccessibilityBridge {
    fn publish(&self, node: AccessibilityNode) -> i32;
    fn clear(&self) -> i32;
}

public class AppComponentRecord {
    public id: string;
    public generation: u32;
    public update_count: i32;

    public static fn create(id: string, generation: u32) -> AppComponentRecord {
        return AppComponentRecord {
            id: id,
            generation: generation,
            update_count: 0
        };
    }

    public fn updated(mut self) -> AppComponentRecord {
        self.update_count = self.update_count + 1;
        return self;
    }

    public fn dup(&self) -> AppComponentRecord {
        return AppComponentRecord {
            id: self.id,
            generation: self.generation,
            update_count: self.update_count
        };
    }
}

public class AppWorld {
    private next_entity_id: u64;
    private entities: Vec<Entity>;
    private string_resources: Vec<AppStringResource>;
    private int_resources: Vec<AppIntResource>;
    private float_resources: Vec<AppFloatResource>;
    private bool_resources: Vec<AppBoolResource>;
    private string_list_resources: Vec<AppStringListResource>;
    private bool_list_resources: Vec<AppBoolListResource>;
    private interaction_events: Vec<AppInteractionEvent>;
    private actions: Vec<AppAction>;
    private commands: Vec<AppCommand>;
    private behaviors: Vec<AppBehavior>;
    private command_handlers: Vec<Box<dyn AppCommandHandler>>;
    private component_records: Vec<AppComponentRecord>;
    private focus_state: FocusState;
    private accessibility_nodes: Vec<AccessibilityNode>;
    private key_shortcuts: Vec<AppKeyShortcut>;
    private layers: Vec<AppLayer>;
    private scroll_containers: Vec<string>;
    private dirty_resources: Vec<string>;
    private accessibility_revision: u64;
    private accessibility_dirty: bool;
    private effect_requests: Vec<AppEffectRequest>;
    private effect_results: Vec<AppEffectResult>;
    private effect_completions: Vec<AppEffectResult>;
    private next_effect_id: u64;
    private effect_clock: u64;
    private effect_in_flight_limit: i32;
    private effect_completion_limit: i32;
    private effect_dropped_count: i32;
    private unhandled_effect_errors: i32;
    private total_actions: i32;
    private total_interaction_events: i32;
    private total_component_mounts: i32;
    private total_component_updates: i32;
    private total_component_unmounts: i32;
    private state_revision: u64;

    public static fn create() -> AppWorld {
        return AppWorld {
            next_entity_id: 1 as u64,
            entities: Vec::<Entity>.new(),
            string_resources: Vec::<AppStringResource>.new(),
            int_resources: Vec::<AppIntResource>.new(),
            float_resources: Vec::<AppFloatResource>.new(),
            bool_resources: Vec::<AppBoolResource>.new(),
            string_list_resources: Vec::<AppStringListResource>.new(),
            bool_list_resources: Vec::<AppBoolListResource>.new(),
            interaction_events: Vec::<AppInteractionEvent>.new(),
            actions: Vec::<AppAction>.new(),
            commands: Vec::<AppCommand>.new(),
            behaviors: Vec::<AppBehavior>.new(),
            command_handlers: Vec::<Box<dyn AppCommandHandler>>.new(),
            component_records: Vec::<AppComponentRecord>.new(),
            focus_state: FocusState.create(),
            accessibility_nodes: Vec::<AccessibilityNode>.new(),
            key_shortcuts: Vec::<AppKeyShortcut>.new(),
            layers: Vec::<AppLayer>.new(),
            scroll_containers: Vec::<string>.new(),
            dirty_resources: Vec::<string>.new(),
            accessibility_revision: 0 as u64,
            accessibility_dirty: false,
            effect_requests: Vec::<AppEffectRequest>.new(),
            effect_results: Vec::<AppEffectResult>.new(),
            effect_completions: Vec::<AppEffectResult>.new(),
            next_effect_id: 1 as u64,
            effect_clock: 0 as u64,
            effect_in_flight_limit: 64,
            effect_completion_limit: 64,
            effect_dropped_count: 0,
            unhandled_effect_errors: 0,
            total_actions: 0,
            total_interaction_events: 0,
            total_component_mounts: 0,
            total_component_updates: 0,
            total_component_unmounts: 0,
            state_revision: 0 as u64
        };
    }

    public fn stateRevision(&self) -> u64 {
        return self.state_revision;
    }

    public fn stateChangedSince(&self, revision: u64) -> bool {
        return self.state_revision != revision;
    }

    public fn markStateChanged(mut self) -> AppWorld {
        self.state_revision = self.state_revision + 1 as u64;
        return self;
    }

    public fn spawn(&mut self) -> Entity {
        let entity = Entity.create(self.next_entity_id, 1 as u32);
        self.next_entity_id = self.next_entity_id + 1 as u64;
        self.entities.push(entity);
        return entity;
    }

    public fn entityCount(&self) -> i32 {
        return self.entities.len as i32;
    }

    public fn entityAt(&self, index: i32) -> Entity {
        if (index < 0 || index >= self.entityCount()) { return Entity.invalid(); }
        return self.entities.get(index as i64);
    }

    public fn hasEntity(&self, entity: Entity) -> bool {
        var i: i32 = 0;
        while (i < self.entityCount()) {
            if (self.entities.get(i as i64).equals(entity)) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn despawn(&mut self, entity: Entity) -> bool {
        var i: i32 = 0;
        while (i < self.entityCount()) {
            if (self.entities.get(i as i64).equals(entity)) {
                self.entities.remove(i as i64);
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn componentStateKey(&self, component_id: string, key: string) -> string {
        return "component:" + component_id + ":" + key;
    }

    public fn setComponentStringState(mut self, component_id: string, key: string, value: string) -> AppWorld {
        return self.setStringResource(self.componentStateKey(component_id, key), value);
    }

    public fn componentStringState(&self, component_id: string, key: string, fallback: string) -> string {
        return self.stringResource(self.componentStateKey(component_id, key), fallback);
    }

    public fn setComponentIntState(mut self, component_id: string, key: string, value: i32) -> AppWorld {
        return self.setIntResource(self.componentStateKey(component_id, key), value);
    }

    public fn componentIntState(&self, component_id: string, key: string, fallback: i32) -> i32 {
        return self.intResource(self.componentStateKey(component_id, key), fallback);
    }

    public fn setComponentFloatState(mut self, component_id: string, key: string, value: f32) -> AppWorld {
        return self.setFloatResource(self.componentStateKey(component_id, key), value);
    }

    public fn componentFloatState(&self, component_id: string, key: string, fallback: f32) -> f32 {
        return self.floatResource(self.componentStateKey(component_id, key), fallback);
    }

    public fn setComponentBoolState(mut self, component_id: string, key: string, value: bool) -> AppWorld {
        return self.setBoolResource(self.componentStateKey(component_id, key), value);
    }

    public fn componentBoolState(&self, component_id: string, key: string, fallback: bool) -> bool {
        return self.boolResource(self.componentStateKey(component_id, key), fallback);
    }

    public fn componentCount(&self) -> i32 {
        return self.component_records.len as i32;
    }

    public fn totalComponentMounts(&self) -> i32 {
        return self.total_component_mounts;
    }

    public fn totalComponentUpdates(&self) -> i32 {
        return self.total_component_updates;
    }

    public fn totalComponentUnmounts(&self) -> i32 {
        return self.total_component_unmounts;
    }

    public fn componentIndex(&self, id: string) -> i32 {
        if (id.len == 0) { return -1; }
        var i: i32 = 0;
        while (i < self.componentCount()) {
            if (self.component_records.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn hasComponent(&self, id: string) -> bool {
        return self.componentIndex(id) >= 0;
    }

    public fn componentAt(&self, index: i32) -> AppComponentRecord {
        if (index < 0 || index >= self.componentCount()) {
            return AppComponentRecord.create("", 0 as u32);
        }
        return self.component_records.get(index as i64).dup();
    }

    public fn componentRecord(&self, id: string) -> AppComponentRecord {
        let index = self.componentIndex(id);
        if (index < 0) { return AppComponentRecord.create("", 0 as u32); }
        return self.component_records.get(index as i64).dup();
    }

    public fn mountComponent(mut self, id: string) -> AppWorld {
        if (id.len == 0 || self.componentIndex(id) >= 0) { return self; }
        self.total_component_mounts = self.total_component_mounts + 1;
        self.component_records.push(AppComponentRecord.create(id, self.total_component_mounts as u32));
        return self;
    }

    public fn updateComponent(mut self, id: string) -> AppWorld {
        let index = self.componentIndex(id);
        if (index < 0) { return self; }
        var record = self.component_records.get(index as i64);
        record = record.updated();
        self.component_records.set(index as i64, record);
        self.total_component_updates = self.total_component_updates + 1;
        return self;
    }

    public fn unmountComponent(mut self, id: string) -> AppWorld {
        let index = self.componentIndex(id);
        if (index < 0) { return self; }
        self.component_records.remove(index as i64);
        self.total_component_unmounts = self.total_component_unmounts + 1;
        // Leaving a page must not leave its work running: anything it started is
        // cancelled here, and any late result is dropped on commit.
        return self.cancelEffectsOwnedBy(id);
    }

    @[borrow_args]
    public fn componentIdListHas(&self, ids: Vec<string>, id: string) -> bool {
        var i: i32 = 0;
        while (i < (ids.len as i32)) {
            if (ids.get(i as i64) == id) { return true; }
            i = i + 1;
        }
        return false;
    }

    @[borrow_args]
    public fn componentIdListHasBefore(&self, ids: Vec<string>, id: string, limit: i32) -> bool {
        var i: i32 = 0;
        while (i < limit && i < (ids.len as i32)) {
            if (ids.get(i as i64) == id) { return true; }
            i = i + 1;
        }
        return false;
    }

    @[borrow_args]
    public fn reconcileKeyedComponents(mut self, ids: Vec<string>) -> AppWorld {
        var i: i32 = self.componentCount() - 1;
        while (i >= 0) {
            let record = self.component_records.get(i as i64);
            if (!self.componentIdListHas(ids, record.id)) {
                self = self.unmountComponent(record.id);
            }
            i = i - 1;
        }

        var source_i: i32 = 0;
        var target_i: i32 = 0;
        while (source_i < (ids.len as i32)) {
            let id = ids.get(source_i as i64);
            if (id.len > 0 && !self.componentIdListHasBefore(ids, id, source_i)) {
                let index = self.componentIndex(id);
                if (index >= 0) {
                    var existing = self.component_records.get(index as i64);
                    existing = existing.updated();
                    self.total_component_updates = self.total_component_updates + 1;
                    if (index == target_i) {
                        self.component_records.set(index as i64, existing);
                    } else {
                        self.component_records.remove(index as i64);
                        self.component_records.insert(target_i as i64, existing);
                    }
                } else {
                    self.total_component_mounts = self.total_component_mounts + 1;
                    self.component_records.insert(target_i as i64, AppComponentRecord.create(id, self.total_component_mounts as u32));
                }
                target_i = target_i + 1;
            }
            source_i = source_i + 1;
        }
        while (self.componentCount() > target_i) {
            self.component_records.remove((self.componentCount() - 1) as i64);
            self.total_component_unmounts = self.total_component_unmounts + 1;
        }
        return self;
    }

    @[borrow_args]
    public fn reconcileComponents(mut self, ids: Vec<string>) -> AppWorld {
        return self.reconcileKeyedComponents(ids);
    }

    public fn setStringResource(mut self, id: string, value: string) -> AppWorld {
        self.setStringResourceMut(id, value);
        return self;
    }

    public fn setStringResourceMut(&mut self, id: string, value: string) {
        var i: i32 = 0;
        while (i < (self.string_resources.len as i32)) {
            let current = self.string_resources.get(i as i64);
            if (current.id == id) {
                if (current.value == value) { return; }
                self.string_resources.set(i as i64, AppStringResource.create(id, value));
                self.markResourceDirtyMut(id);
                self.state_revision = self.state_revision + 1 as u64;
                return;
            }
            i = i + 1;
        }
        self.string_resources.push(AppStringResource.create(id, value));
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn hasStringResource(&self, id: string) -> bool {
        return self.stringResourceIndex(id) >= 0;
    }

    public fn stringResource(&self, id: string, fallback: string) -> string {
        let index = self.stringResourceIndex(id);
        if (index < 0) { return fallback; }
        return self.string_resources.get(index as i64).value;
    }

    public fn stringResourceCount(&self) -> i32 {
        return self.string_resources.len as i32;
    }

    public fn stringResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.stringResourceCount()) { return ""; }
        return self.string_resources.get(index as i64).id;
    }

    public fn stringResourceValueAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.stringResourceCount()) { return ""; }
        return self.string_resources.get(index as i64).value;
    }

    public fn stringResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.string_resources.len as i32)) {
            if (self.string_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn setIntResource(mut self, id: string, value: i32) -> AppWorld {
        self.setIntResourceMut(id, value);
        return self;
    }

    // Clock-driven resources are readable by bound views, but do not force a
    // structural component rebuild on every frame.
    public fn setTransientIntResource(mut self, id: string, value: i32) -> AppWorld {
        let revision = self.state_revision;
        self.setIntResourceMut(id, value);
        self.state_revision = revision;
        return self;
    }

    public fn setIntResourceMut(&mut self, id: string, value: i32) {
        var i: i32 = 0;
        while (i < (self.int_resources.len as i32)) {
            let current = self.int_resources.get(i as i64);
            if (current.id == id) {
                if (appIntValue(current) == value) { return; }
                self.int_resources.set(i as i64, AppIntResource.create(id, value));
                self.markResourceDirtyMut(id);
                self.state_revision = self.state_revision + 1 as u64;
                return;
            }
            i = i + 1;
        }
        self.int_resources.push(AppIntResource.create(id, value));
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn intResource(&self, id: string, fallback: i32) -> i32 {
        let index = self.intResourceIndex(id);
        if (index < 0) { return fallback; }
        return appIntValue(self.int_resources.get(index as i64));
    }

    public fn intResourceCount(&self) -> i32 {
        return self.int_resources.len as i32;
    }

    public fn intResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.intResourceCount()) { return ""; }
        return self.int_resources.get(index as i64).id;
    }

    public fn intResourceValueAt(&self, index: i32) -> i32 {
        if (index < 0 || index >= self.intResourceCount()) { return 0; }
        return appIntValue(self.int_resources.get(index as i64));
    }

    public fn intResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.int_resources.len as i32)) {
            if (self.int_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn incrementIntResource(mut self, id: string, delta: i32) -> AppWorld {
        self.incrementIntResourceMut(id, delta);
        return self;
    }

    public fn incrementIntResourceMut(&mut self, id: string, delta: i32) {
        let next = self.intResource(id, 0) + delta;
        self.setIntResourceMut(id, next);
        self.setStringResourceMut(id, format("%d", next as i64));
    }

    public fn setFloatResource(mut self, id: string, value: f32) -> AppWorld {
        self.setFloatResourceMut(id, value);
        return self;
    }

    public fn setFloatResourceMut(&mut self, id: string, value: f32) {
        var i: i32 = 0;
        while (i < (self.float_resources.len as i32)) {
            let current = self.float_resources.get(i as i64);
            if (current.id == id) {
                if (appFloatValue(current) == value) { return; }
                self.float_resources.set(i as i64, AppFloatResource.create(id, value));
                self.markResourceDirtyMut(id);
                self.state_revision = self.state_revision + 1 as u64;
                return;
            }
            i = i + 1;
        }
        self.float_resources.push(AppFloatResource.create(id, value));
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn floatResource(&self, id: string, fallback: f32) -> f32 {
        let index = self.floatResourceIndex(id);
        if (index < 0) { return fallback; }
        return appFloatValue(self.float_resources.get(index as i64));
    }

    public fn floatResourceCount(&self) -> i32 {
        return self.float_resources.len as i32;
    }

    public fn floatResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.floatResourceCount()) { return ""; }
        return self.float_resources.get(index as i64).id;
    }

    public fn floatResourceValueAt(&self, index: i32) -> f32 {
        if (index < 0 || index >= self.floatResourceCount()) { return f32Zero(); }
        return appFloatValue(self.float_resources.get(index as i64));
    }

    public fn floatResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.float_resources.len as i32)) {
            if (self.float_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn setBoolResource(mut self, id: string, value: bool) -> AppWorld {
        self.setBoolResourceMut(id, value);
        return self;
    }

    public fn setBoolResourceMut(&mut self, id: string, value: bool) {
        var i: i32 = 0;
        while (i < (self.bool_resources.len as i32)) {
            let current = self.bool_resources.get(i as i64);
            if (current.id == id) {
                if (current.value == value) { return; }
                self.bool_resources.set(i as i64, AppBoolResource.create(id, value));
                self.markResourceDirtyMut(id);
                self.state_revision = self.state_revision + 1 as u64;
                return;
            }
            i = i + 1;
        }
        self.bool_resources.push(AppBoolResource.create(id, value));
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn boolResource(&self, id: string, fallback: bool) -> bool {
        let index = self.boolResourceIndex(id);
        if (index < 0) { return fallback; }
        return self.bool_resources.get(index as i64).value;
    }

    public fn boolResourceCount(&self) -> i32 {
        return self.bool_resources.len as i32;
    }

    public fn boolResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.boolResourceCount()) { return ""; }
        return self.bool_resources.get(index as i64).id;
    }

    public fn boolResourceValueAt(&self, index: i32) -> bool {
        if (index < 0 || index >= self.boolResourceCount()) { return false; }
        return self.bool_resources.get(index as i64).value;
    }

    public fn boolResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.bool_resources.len as i32)) {
            if (self.bool_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn toggleBoolResource(mut self, id: string) -> AppWorld {
        self.setBoolResourceMut(id, !self.boolResource(id, false));
        return self;
    }

    public fn setStringListResource(mut self, id: string, values: Vec<string>) -> AppWorld {
        self.setStringListResourceMut(id, values);
        return self;
    }

    public fn setStringListResourceMut(&mut self, id: string, values: Vec<string>) {
        var next = AppStringListResource.create(id);
        var value_i: i32 = 0;
        while (value_i < (values.len as i32)) {
            next.values.push(values.get(value_i as i64));
            value_i = value_i + 1;
        }
        var replace_at: i32 = -1;
        var i: i32 = 0;
        while (i < (self.string_list_resources.len as i32) && replace_at < 0) {
            let current = self.string_list_resources.get(i as i64);
            if (current.id == id) {
                replace_at = i;
            }
            i = i + 1;
        }
        if (replace_at >= 0) {
            var old = self.string_list_resources.get(replace_at as i64);
            old.destroy();
            self.string_list_resources.set(replace_at as i64, next);
        } else {
            self.string_list_resources.push(next);
        }
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn ensureStringListResource(mut self, id: string) -> AppWorld {
        self.ensureStringListResourceMut(id);
        return self;
    }

    public fn ensureStringListResourceMut(&mut self, id: string) {
        if (self.stringListResourceIndex(id) >= 0) { return; }
        self.string_list_resources.push(AppStringListResource.create(id));
        self.markResourceDirtyMut(id);
        self.state_revision = self.state_revision + 1 as u64;
    }

    public fn stringListResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.string_list_resources.len as i32)) {
            if (self.string_list_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn stringListResourceTypeCount(&self) -> i32 {
        return self.string_list_resources.len as i32;
    }

    public fn stringListResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.stringListResourceTypeCount()) { return ""; }
        return self.string_list_resources.get(index as i64).id;
    }

    public fn stringListResourceCount(&self, id: string) -> i32 {
        let index = self.stringListResourceIndex(id);
        if (index < 0) { return 0; }
        return self.string_list_resources.get(index as i64).count();
    }

    public fn stringListResourceAt(&self, id: string, index: i32) -> string {
        let list_index = self.stringListResourceIndex(id);
        if (list_index < 0) { return ""; }
        return self.string_list_resources.get(list_index as i64).at(index);
    }

    public fn appendStringListResource(mut self, id: string, value: string) -> AppWorld {
        self = self.ensureStringListResource(id);
        let index = self.stringListResourceIndex(id);
        if (index < 0) { return self; }
        var list = self.string_list_resources.get(index as i64);
        list = list.push(value);
        self.string_list_resources.set(index as i64, list);
        self.markResourceDirtyMut(id);
        return self.markStateChanged();
    }

    public fn removeStringListResourceAt(mut self, id: string, index: i32) -> AppWorld {
        let list_index = self.stringListResourceIndex(id);
        if (list_index < 0) { return self; }
        var list = self.string_list_resources.get(list_index as i64);
        if (list.removeAt(index)) {
            self.string_list_resources.set(list_index as i64, list);
            self.markResourceDirtyMut(id);
            self = self.markStateChanged();
        }
        return self;
    }

    public fn ensureBoolListResource(mut self, id: string) -> AppWorld {
        if (self.boolListResourceIndex(id) >= 0) { return self; }
        self.bool_list_resources.push(AppBoolListResource.create(id));
        self.markResourceDirtyMut(id);
        return self.markStateChanged();
    }

    @[borrow_args]
    public fn setBoolListResource(mut self, id: string, values: Vec<bool>) -> AppWorld {
        var next = AppBoolListResource.create(id);
        var i: i32 = 0;
        while (i < (values.len as i32)) {
            next.values.push(values.get(i as i64));
            i = i + 1;
        }
        let index = self.boolListResourceIndex(id);
        if (index >= 0) {
            var old = self.bool_list_resources.get(index as i64);
            old.destroy();
            self.bool_list_resources.set(index as i64, next);
        } else {
            self.bool_list_resources.push(next);
        }
        self.markResourceDirtyMut(id);
        return self.markStateChanged();
    }

    public fn boolListResourceIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.bool_list_resources.len as i32)) {
            if (self.bool_list_resources.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn boolListResourceTypeCount(&self) -> i32 {
        return self.bool_list_resources.len as i32;
    }

    public fn boolListResourceIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.boolListResourceTypeCount()) { return ""; }
        return self.bool_list_resources.get(index as i64).id;
    }

    public fn totalResourceCount(&self) -> i32 {
        var out = self.stringResourceCount();
        out = out + self.intResourceCount();
        out = out + self.floatResourceCount();
        out = out + self.boolResourceCount();
        out = out + self.stringListResourceTypeCount();
        out = out + self.boolListResourceTypeCount();
        return out;
    }

    // Canonical, line-oriented resource snapshot. Hex fields keep IDs and
    // user text unambiguous even when they contain newlines or separators.
    public fn snapshotResources(&self) -> string {
        var out = "";
        var i: i32 = 0;
        while (i < self.stringResourceCount()) {
            let id = self.stringResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "S|" + hex_encode(id) + "|" + hex_encode(self.stringResourceValueAt(i)) + "\n";
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.intResourceCount()) {
            let id = self.intResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "I|" + hex_encode(id) + "|" + format("%d", self.intResourceValueAt(i) as i64) + "\n";
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.floatResourceCount()) {
            let id = self.floatResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "F|" + hex_encode(id) + "|" + app_format_f32(self.floatResourceValueAt(i)) + "\n";
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.boolResourceCount()) {
            let id = self.boolResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "B|" + hex_encode(id) + "|" + app_format_bool(self.boolResourceValueAt(i)) + "\n";
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.stringListResourceTypeCount()) {
            let id = self.stringListResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "L|" + hex_encode(id) + "|" + format("%d", self.stringListResourceCount(id) as i64) + "\n";
                var j: i32 = 0;
                while (j < self.stringListResourceCount(id)) {
                    out = out + "l|" + hex_encode(self.stringListResourceAt(id, j)) + "\n";
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.boolListResourceTypeCount()) {
            let id = self.boolListResourceIdAt(i);
            if (worldTimelineResource(id)) {
                out = out + "T|" + hex_encode(id) + "|" + format("%d", self.boolListResourceCount(id) as i64) + "\n";
                var j: i32 = 0;
                while (j < self.boolListResourceCount(id)) {
                    out = out + "t|" + app_format_bool(self.boolListResourceAt(id, j)) + "\n";
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return out;
    }

    // Restore changes caused by an input event before replaying its command.
    // Commands are still executed and checked against the recorded after-state.
    public fn restoreSnapshotResources(mut self, snapshot: string) -> Result<AppWorld, AppError> {
        let lines = snapshot.split("\n");
        var i: i32 = 0;
        while (i < (lines.len as i32)) {
            let line = lines.get(i as i64);
            if (line.len == 0 && i == (lines.len as i32) - 1) { break; }
            let fields = line.split("|");
            if (fields.len < 2) { return Err(AppError.create(92, "invalid resource snapshot")); }
            let kind = fields.get(0);
            if (kind == "S" || kind == "I" || kind == "F" || kind == "B") {
                if (fields.len != 3) { return Err(AppError.create(92, "invalid scalar snapshot")); }
                let id = hex_decode(fields.get(1));
                let value = fields.get(2);
                if (!worldTimelineResource(id)) { return Err(AppError.create(92, "reserved resource in timeline")); }
                if (kind == "S") { self = self.setStringResource(id, hex_decode(value)); }
                if (kind == "I") {
                    let number = app_parse_i32_or(value, 0);
                    if (value != format("%d", number as i64)) { return Err(AppError.create(92, "invalid integer snapshot")); }
                    self = self.setIntResource(id, number);
                }
                if (kind == "F") {
                    match (f32_from_str(value)) {
                        case Ok(number) => { self = self.setFloatResource(id, number); }
                        case Err(_) => { return Err(AppError.create(92, "invalid float snapshot")); }
                    }
                }
                if (kind == "B") {
                    if (value != "true" && value != "false") { return Err(AppError.create(92, "invalid boolean snapshot")); }
                    self = self.setBoolResource(id, value == "true");
                }
            } else if (kind == "L" || kind == "T") {
                if (fields.len != 3) { return Err(AppError.create(92, "invalid list snapshot")); }
                let id = hex_decode(fields.get(1));
                let count = app_parse_i32_or(fields.get(2), -1);
                if (!worldTimelineResource(id) || count < 0 || fields.get(2) != format("%d", count as i64)
                    || i + count >= (lines.len as i32)) { return Err(AppError.create(92, "invalid list length")); }
                var strings = Vec::<string>.new();
                var bools = Vec::<bool>.new();
                var j: i32 = 0;
                while (j < count) {
                    i = i + 1;
                    let item = lines.get(i as i64).split("|");
                    if (item.len != 2) { return Err(AppError.create(92, "invalid list item")); }
                    if (kind == "L" && item.get(0) == "l") {
                        strings.push(hex_decode(item.get(1)));
                    } else if (kind == "T" && item.get(0) == "t" && (item.get(1) == "true" || item.get(1) == "false")) {
                        bools.push(item.get(1) == "true");
                    } else { return Err(AppError.create(92, "invalid list item type")); }
                    j = j + 1;
                }
                if (kind == "L") {
                    self = self.setStringListResource(id, strings);
                } else {
                    self = self.setBoolListResource(id, bools);
                }
                strings.destroy();
                bools.destroy();
            } else { return Err(AppError.create(92, "unknown resource snapshot record")); }
            i = i + 1;
        }
        if (self.snapshotResources() != snapshot) { return Err(AppError.create(92, "resource snapshot does not match app state")); }
        return Ok(self);
    }

    public fn boolListResourceCount(&self, id: string) -> i32 {
        let index = self.boolListResourceIndex(id);
        if (index < 0) { return 0; }
        return self.bool_list_resources.get(index as i64).count();
    }

    public fn boolListResourceAt(&self, id: string, index: i32) -> bool {
        let list_index = self.boolListResourceIndex(id);
        if (list_index < 0) { return false; }
        return self.bool_list_resources.get(list_index as i64).at(index);
    }

    public fn setBoolListResourceAt(mut self, id: string, index: i32, value: bool) -> AppWorld {
        if (index < 0) { return self; }
        let before_count = self.boolListResourceCount(id);
        let before_value = self.boolListResourceAt(id, index);
        self = self.ensureBoolListResource(id);
        let list_index = self.boolListResourceIndex(id);
        if (list_index < 0) { return self; }
        var list = self.bool_list_resources.get(list_index as i64);
        list = list.ensureCount(index + 1, false);
        let after_count = list.count();
        if (after_count == before_count && before_value == value) { return self; }
        list.setAt(index, value);
        self.bool_list_resources.set(list_index as i64, list);
        self.markResourceDirtyMut(id);
        return self.markStateChanged();
    }

    public fn toggleBoolListResourceAt(mut self, id: string, index: i32) -> AppWorld {
        if (index < 0) { return self; }
        return self.setBoolListResourceAt(id, index, !self.boolListResourceAt(id, index));
    }

    public fn appendBoolListResource(mut self, id: string, value: bool) -> AppWorld {
        self = self.ensureBoolListResource(id);
        let index = self.boolListResourceIndex(id);
        if (index < 0) { return self; }
        var list = self.bool_list_resources.get(index as i64);
        list = list.push(value);
        self.bool_list_resources.set(index as i64, list);
        self.markResourceDirtyMut(id);
        return self.markStateChanged();
    }

    public fn removeBoolListResourceAt(mut self, id: string, index: i32) -> AppWorld {
        let list_index = self.boolListResourceIndex(id);
        if (list_index < 0) { return self; }
        var list = self.bool_list_resources.get(list_index as i64);
        if (list.removeAt(index)) {
            self.bool_list_resources.set(list_index as i64, list);
            self.markResourceDirtyMut(id);
            self = self.markStateChanged();
        }
        return self;
    }

    public fn dispatch(mut self, action: AppAction) -> AppWorld {
        self.dispatchMut(action);
        return self;
    }

    public fn dispatchMut(&mut self, action: AppAction) {
        self.actions.push(action);
        self.total_actions = self.total_actions + 1;
    }

