    public fn emitInteractionEvent(mut self, event: AppInteractionEvent) -> AppWorld {
        let incoming = event.dup();
        var inserted: bool = false;
        var i: i32 = 0;
        while (i < self.interactionEventCount()) {
            let current = self.interaction_events.get(i as i64);
            if (!inserted && incoming.priority > current.priority) {
                self.interaction_events.insert(i as i64, incoming.dup());
                inserted = true;
            }
            i = i + 1;
        }
        if (!inserted) {
            self.interaction_events.push(incoming);
        }
        self.total_interaction_events = self.total_interaction_events + 1;
        return self;
    }

    public fn interactionEventCount(&self) -> i32 {
        return self.interaction_events.len as i32;
    }

    public fn totalInteractionEventCount(&self) -> i32 {
        return self.total_interaction_events;
    }

    public fn interactionEventAt(&self, index: i32) -> AppInteractionEvent {
        if (index < 0 || index >= self.interactionEventCount()) {
            return AppInteractionEvent.create(0, "", "", "", f32Zero(), f32Zero(), f32Zero(), f32Zero(), 0 as u64);
        }
        return self.interaction_events.get(index as i64).dup();
    }

    public fn setInteractionEventAt(mut self, index: i32, event: AppInteractionEvent) -> AppWorld {
        if (index < 0 || index >= self.interactionEventCount()) { return self; }
        self.interaction_events.set(index as i64, event.dup());
        return self;
    }

    public fn clearInteractionEvents(mut self) -> AppWorld {
        self.interaction_events.clear();
        return self;
    }

    public fn dispatchInteractionAction(mut self, event: AppInteractionEvent) -> AppWorld {
        if (event.action_name.len == 0) { return self; }
        return self.dispatch(AppAction.create(event.action_name).fromSource(event.target_id).withPayload(event.payload).atFrame(event.frame_index));
    }

    public fn dispatchInteractionActionByName(mut self, event: AppInteractionEvent, action_name: string) -> AppWorld {
        if (action_name.len == 0) { return self; }
        return self.dispatch(AppAction.create(action_name).fromSource(event.target_id).withPayload(event.payload).atFrame(event.frame_index));
    }

    public fn dispatchInteractionActionByNameFrom(mut self, event: AppInteractionEvent, action_name: string, source_id: string) -> AppWorld {
        if (action_name.len == 0) { return self; }
        return self.dispatch(AppAction.create(action_name).fromSource(source_id).withPayload(event.payload).atFrame(event.frame_index));
    }

    public fn interactionRouteCount(&self, route: string) -> i32 {
        if (route.len == 0) { return 0; }
        var count: i32 = 1;
        var i: i32 = 0;
        while (i < route.len) {
            if (route.charAt(i) == 62) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn interactionRouteAt(&self, route: string, index: i32) -> string {
        if (index < 0 || route.len == 0) { return ""; }
        var current: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= route.len) {
            if (i == route.len || route.charAt(i) == 62) {
                if (current == index) {
                    return str_substr(route, start as i64, (i - start) as i64);
                }
                current = current + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    public fn dispatchInteractionCaptureChain(mut self, event: AppInteractionEvent) -> AppWorld {
        var out = self;
        var i = out.interactionRouteCount(event.route) - 1;
        while (i >= 0) {
            let id = out.interactionRouteAt(event.route, i);
            let action_name = out.captureActionNameForViewId(id);
            if (action_name.len > 0) {
                out = out.dispatchInteractionActionByNameFrom(event, action_name, id);
            }
            i = i - 1;
        }
        return out;
    }

    public fn dispatchInteractionBubbleChain(mut self, event: AppInteractionEvent) -> AppWorld {
        var out = self;
        var i: i32 = 0;
        while (i < out.interactionRouteCount(event.route)) {
            let id = out.interactionRouteAt(event.route, i);
            let action_name = out.bubbleActionNameForViewId(id);
            if (action_name.len > 0) {
                out = out.dispatchInteractionActionByNameFrom(event, action_name, id);
            }
            i = i + 1;
        }
        return out;
    }

    public fn runInteractionSystems(mut self) -> AppWorld {
        return InteractionSystem.create().run(self);
    }

