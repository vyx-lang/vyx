        out.height_value = f32FromMilli(40000);
        return out;
    }

    public static fn textField(placeholder: string) -> View {
        var out = View.create(appViewTextField());
        out.placeholder_value = placeholder;
        out.accessibility_role = "textbox";
        out.accessibility_label = placeholder;
        out.height_value = f32FromMilli(48000);
        out.min_width_value = f32FromMilli(160000);
        return out;
    }

    public static fn slider(value: string) -> View {
        var out = View.create(appViewSlider());
        out.text_value = value;
        out.accessibility_role = "slider";
        out.accessibility_label = value;
        out.height_value = f32FromMilli(40000);
        return out;
    }

    public static fn checkbox(value: string) -> View {
        var out = View.create(appViewCheckbox());
        out.text_value = value;
