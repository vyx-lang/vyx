    public static fn list(resource_id: string) -> View {
        var out = View.create(appViewList());
        out.list_resource_id = resource_id;
        out.checked_list_resource_id = resource_id + ":checked";
        out.accessibility_role = "list";
        out.height_value = f32FromMilli(160000);
        out.item_height_value = f32FromMilli(40000);
        return out;
