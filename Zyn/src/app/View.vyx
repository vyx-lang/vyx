    public static fn top(top: View, content: View) -> View {
        return Column.create()
            .gap(f32Zero())
            .child(top)
            .child(content.expanded());
    }

    public static fn bottom(content: View, bottom: View) -> View {
        return Column.create()
            .gap(f32Zero())
            .child(content.expanded())
            .child(bottom);
    }

    public static fn leading(leading: View, content: View) -> View {
        return Row.create()
            .gap(f32Zero())
            .child(leading)
            .child(content.expanded());
    }

    public static fn trailing(content: View, trailing: View) -> View {
        return Row.create()
            .gap(f32Zero())
            .child(content.expanded())
            .child(trailing);
    }
}

