    public static fn grid() -> View {
        var out = View.create(appViewGrid());
        out.padding_value = f32Zero();
        out.gap_value = f32FromMilli(8000);
        out.min_item_width_value = f32FromMilli(160000);
        out.item_height_value = f32FromMilli(96000);
        return out;
    }

    public static fn wrap() -> View {
        var out = View.create(appViewWrap());
        out.padding_value = f32Zero();
        out.gap_value = f32FromMilli(8000);
        out.item_width_value = f32FromMilli(120000);
        out.item_height_value = f32FromMilli(40000);
        return out;
    }

    public fn id(mut self, value: string) -> View {
        self.id_value = value;
        return self;
    }

    public fn label(mut self, value: string) -> View {
        self.text_value = value;
        self.text_resource_id = "";
        return self;
    }

    public fn bindText(mut self, resource_id: string) -> View {
        self.text_resource_id = resource_id;
        return self;
    }

    public fn placeholder(mut self, value: string) -> View {
        self.placeholder_value = value;
        return self;
    }

    public fn bindChecked(mut self, resource_id: string) -> View {
        self.bool_resource_id = resource_id;
        return self;
    }

    public fn bindInt(mut self, resource_id: string) -> View {
        self.int_resource_id = resource_id;
        self.float_resource_id = "";
        return self;
    }

    public fn bindFloat(mut self, resource_id: string) -> View {
        self.float_resource_id = resource_id;
        self.int_resource_id = "";
        return self;
    }

    public fn bindList(mut self, resource_id: string) -> View {
        self.list_resource_id = resource_id;
        return self;
    }

    public fn bindCheckedList(mut self, resource_id: string) -> View {
        self.checked_list_resource_id = resource_id;
        return self;
    }

    public fn itemActionPrefix(mut self, prefix: string) -> View {
        self.item_action_prefix = prefix;
        return self;
    }

    // Keys that identify each list item independently of its position, so a
    // checked row keeps its state when rows are inserted or removed.
    public fn keyResource(mut self, resource_id: string) -> View {
        self.list_key_resource = resource_id;
        return self;
    }

    public fn checked(mut self, value: bool) -> View {
        self.checked_value = value;
        self.bool_resource_id = "";
        return self;
    }

    public fn value(mut self, value: f32) -> View {
        self.numeric_value = value;
        self.int_resource_id = "";
        self.float_resource_id = "";
        return self;
    }

    public fn range(mut self, min_value: f32, max_value: f32) -> View {
        self.min_value = min_value;
        self.max_value = max_value;
        return self;
    }

    public fn action(mut self, name: string) -> View {
        self.action_name = name;
        return self;
