    public fn onPointerMove(mut self, name: string) -> View {
        return self.pointerMoveAction(name);
    }

    public fn pointerScrollAction(mut self, name: string) -> View {
        self.pointer_scroll_action_name = name;
        return self;
    }

    public fn onPointerScroll(mut self, name: string) -> View {
        return self.pointerScrollAction(name);
    }

    public fn pointerDragAction(mut self, name: string) -> View {
        self.pointer_drag_action_name = name;
        return self;
    }

    public fn onPointerDrag(mut self, name: string) -> View {
        return self.pointerDragAction(name);
    }

    public fn captureAction(mut self, name: string) -> View {
        self.capture_action_name = name;
        return self;
    }

    public fn onCapture(mut self, name: string) -> View {
        return self.captureAction(name);
    }

    public fn bubbleAction(mut self, name: string) -> View {
        self.bubble_action_name = name;
        return self;
    }

    // Handles a key press while this view holds focus, on top of the default
    // Tab / Enter / Space / arrow rules. Returning an action marks the key as
    // consumed, so the focus rules will not also run for the same press.
    public fn keyAction(mut self, name: string) -> View {
        self.key_action_name = name;
        return self;
    }

    public fn onKey(mut self, name: string) -> View {
        return self.keyAction(name);
    }

    // Marks this subtree as belonging to an overlay layer. While that layer is
    // the topmost modal one it owns focus and the rest of the tree is inert.
    public fn layer(mut self, layer_id: string) -> View {
        self.layer_id_value = layer_id;
        return self;
    }

    // Makes this container scrollable. The offset lives in `resource_id` (a
    // float resource) rather than in the view, so the position survives a
    // rebuild instead of snapping back to the top. `extent` is the full content
    // size used to clamp the offset; the viewport size is measured from the
    // laid-out node each frame.
    public fn scrollOffset(mut self, resource_id: string, extent: f32) -> View {
        self.scroll_offset_resource = resource_id;
        self.scroll_extent_value = extent;
        return self;
    }

    public fn onBubble(mut self, name: string) -> View {
        return self.bubbleAction(name);
    }

    public fn pressAction(mut self, name: string) -> View {
        self.pointer_down_action_name = name;
        return self;
    }

    public fn onPress(mut self, name: string) -> View {
        return self.pressAction(name);
    }

    public fn filled(mut self) -> View {
        self.button_style = appButtonStyleFilled();
        return self;
    }

    public fn tonal(mut self) -> View {
        self.button_style = appButtonStyleTonal();
        return self;
    }

    public fn outlined(mut self) -> View {
        self.button_style = appButtonStyleOutlined();
        return self;
    }

    public fn body(mut self) -> View {
        self.text_style = appTextStyleBody();
        return self;
    }

    public fn title(mut self) -> View {
        self.text_style = appTextStyleTitle();
        self.height_value = f32FromMilli(36000);
        return self;
    }

    public fn muted(mut self) -> View {
        self.text_style = appTextStyleMuted();
        return self;
    }

    public fn background(mut self, color: Color) -> View {
        self.has_background_color = true;
        self.background_role = appColorRoleNone();
        self.background_color = color.dup();
        return self;
    }

    public fn foreground(mut self, color: Color) -> View {
        self.has_text_color = true;
        self.text_color_role = appColorRoleNone();
        self.text_color = color.dup();
        return self;
    }

    public fn stroke(mut self, width: f32, color: Color) -> View {
        self.stroke_width_value = width;
        self.has_stroke_color = true;
        self.stroke_color_role = appColorRoleNone();
        self.stroke_color = color.dup();
        return self;
    }

    public fn noStroke(mut self) -> View {
        self.stroke_width_value = f32Zero();
        self.has_stroke_color = false;
        self.stroke_color_role = appColorRoleNone();
        return self;
    }

    public fn backgroundRole(mut self, role: i32) -> View {
        self.background_role = role;
        self.has_background_color = false;
        return self;
    }

    public fn foregroundRole(mut self, role: i32) -> View {
        self.text_color_role = role;
        self.has_text_color = false;
        return self;
    }

    public fn strokeRole(mut self, width: f32, role: i32) -> View {
        self.stroke_width_value = width;
        self.stroke_color_role = role;
        self.has_stroke_color = false;
        return self;
    }

    public fn cornerRadius(mut self, value: f32) -> View {
        self.corner_radius_value = value;
        return self;
    }

    // Adds a renderer-backed drop shadow to surfaces and cards.  The value is
    // expressed in logical pixels and scales with the rest of the view tree.
    public fn elevation(mut self, value: f32) -> View {
        self.elevation_value = value;
        return self;
    }

    public fn alignStart(mut self) -> View {
        self.cross_align_value = appAlignStart();
        return self;
    }

    public fn alignCenter(mut self) -> View {
        self.cross_align_value = appAlignCenter();
        return self;
    }

    public fn alignEnd(mut self) -> View {
        self.cross_align_value = appAlignEnd();
        return self;
    }

    public fn alignStretch(mut self) -> View {
        self.cross_align_value = appAlignStretch();
        return self;
    }

    public fn mainStart(mut self) -> View {
        self.main_align_value = appAlignStart();
        return self;
    }

    public fn mainCenter(mut self) -> View {
        self.main_align_value = appAlignCenter();
        return self;
    }

    public fn mainEnd(mut self) -> View {
        self.main_align_value = appAlignEnd();
        return self;
    }

    public fn textLeft(mut self) -> View {
        self.text_align_value = appTextAlignLeft();
        return self;
    }

    public fn textCenter(mut self) -> View {
        self.text_align_value = appTextAlignCenter();
        return self;
    }

    public fn textRight(mut self) -> View {
        self.text_align_value = appTextAlignRight();
        return self;
    }

    public fn anchorFill(mut self) -> View {
        self.anchor_value = appAnchorFill();
        return self;
    }

    public fn anchorTopFill(mut self) -> View {
        self.anchor_value = appAnchorTopFill();
        return self;
    }

    public fn anchorStartFill(mut self) -> View {
        self.anchor_value = appAnchorStartFill();
        return self;
    }

    public fn anchorEndFill(mut self) -> View {
        self.anchor_value = appAnchorEndFill();
        return self;
    }

    public fn anchorBottomFill(mut self) -> View {
        self.anchor_value = appAnchorBottomFill();
        return self;
    }

    public fn anchorCenter(mut self) -> View {
        self.anchor_value = appAnchorCenter();
        return self;
    }

    public fn anchorTopStart(mut self, margin: f32) -> View {
        self.anchor_value = appAnchorTopStart();
        self.margin_value = margin;
        return self;
    }

    public fn anchorTopEnd(mut self, margin: f32) -> View {
        self.anchor_value = appAnchorTopEnd();
        self.margin_value = margin;
        return self;
    }

    public fn anchorBottomStart(mut self, margin: f32) -> View {
        self.anchor_value = appAnchorBottomStart();
        self.margin_value = margin;
        return self;
    }

    public fn anchorBottomEnd(mut self, margin: f32) -> View {
        self.anchor_value = appAnchorBottomEnd();
        self.margin_value = margin;
        return self;
    }

    public fn anchorBottomRight(mut self, margin: f32) -> View {
        self.anchor_value = appAnchorBottomRight();
        self.margin_value = margin;
        return self;
    }

    public fn visible(mut self, value: bool) -> View {
        self.visible_value = value;
        return self;
    }

    public fn hidden(mut self) -> View {
        self.visible_value = false;
        return self;
    }

    public fn enabled(mut self, value: bool) -> View {
        self.enabled_value = value;
        return self;
    }

    public fn disabled(mut self) -> View {
        self.enabled_value = false;
        return self;
    }

    public fn role(mut self, value: string) -> View {
        self.accessibility_role = value;
        return self;
    }

    public fn accessibilityLabel(mut self, value: string) -> View {
        self.accessibility_label = value;
        return self;
    }

    public fn accessibilityHint(mut self, value: string) -> View {
        self.accessibility_hint = value;
        return self;
    }

    public fn accessibility(mut self, role: string, label: string, hint: string) -> View {
        self.accessibility_role = role;
        self.accessibility_label = label;
        self.accessibility_hint = hint;
        return self;
    }

    public fn width(mut self, value: f32) -> View {
        self.width_value = value;
        return self;
    }

    public fn height(mut self, value: f32) -> View {
        self.height_value = value;
        return self;
    }

    public fn size(mut self, width: f32, height: f32) -> View {
        self.width_value = width;
        self.height_value = height;
        return self;
    }

    public fn minWidth(mut self, value: f32) -> View {
        self.min_width_value = value;
        return self;
    }

    public fn maxWidth(mut self, value: f32) -> View {
        self.max_width_value = value;
        return self;
    }

    public fn minHeight(mut self, value: f32) -> View {
        self.min_height_value = value;
        return self;
    }

    public fn maxHeight(mut self, value: f32) -> View {
        self.max_height_value = value;
        return self;
    }

    public fn columns(mut self, value: i32) -> View {
        if (value < 1) {
            self.columns_value = 1;
        } else {
            self.columns_value = value;
        }
        return self;
    }

    public fn autoColumns(mut self, min_item_width: f32) -> View {
        self.columns_value = 0;
        if (min_item_width <= f32Zero()) {
            self.min_item_width_value = f32One();
        } else {
            self.min_item_width_value = min_item_width;
        }
        return self;
    }

    public fn itemWidth(mut self, value: f32) -> View {
        if (value < f32Zero()) {
            self.item_width_value = f32Zero();
        } else {
            self.item_width_value = value;
        }
        return self;
    }

    public fn itemHeight(mut self, value: f32) -> View {
        if (value < f32Zero()) {
            self.item_height_value = f32Zero();
        } else {
            self.item_height_value = value;
        }
        return self;
    }

    public fn itemSize(mut self, width: f32, height: f32) -> View {
        if (width < f32Zero()) {
            self.item_width_value = f32Zero();
        } else {
            self.item_width_value = width;
        }
        if (height < f32Zero()) {
            self.item_height_value = f32Zero();
        } else {
            self.item_height_value = height;
        }
        return self;
    }

    public fn constraints(mut self, min_width: f32, max_width: f32, min_height: f32, max_height: f32) -> View {
        self.min_width_value = min_width;
        self.max_width_value = max_width;
        self.min_height_value = min_height;
        self.max_height_value = max_height;
        return self;
    }

    public fn flex(mut self, value: f32) -> View {
        if (value < f32Zero()) {
            self.flex_value = f32Zero();
        } else {
            self.flex_value = value;
        }
        return self;
    }

    public fn expanded(mut self) -> View {
        return self.flex(f32One());
    }

    public fn autoHeight(mut self) -> View {
        self.auto_height_value = true;
        self.fill_height_value = false;
        self.height_value = f32Zero();
        return self;
    }

    public fn fillHeight(mut self) -> View {
        self.auto_height_value = false;
        self.fill_height_value = true;
        return self;
    }

    public fn padding(mut self, value: f32) -> View {
        self.padding_value = value;
        self.has_padding_value = true;
        return self;
    }

    public fn gap(mut self, value: f32) -> View {
        self.gap_value = value;
        self.has_gap_value = true;
        return self;
    }

    public fn scrollY(mut self, value: f32) -> View {
        self.scroll_y_value = value;
        return self;
    }

    public fn child(mut self, value: View) -> View {
        self.child_nodes.push(value.dup());
        return self;
    }

    // Conditional composition removes the child from layout, hit testing and
    // accessibility together. Application code can build an ordinary View
    // without branching around a chain of container calls.
    public fn childIf(mut self, condition: bool, value: View) -> View {
        if (condition) { self.child_nodes.push(value.dup()); }
        return self;
    }

    @[borrow_args]
    public fn children(mut self, items: Vec<View>) -> View {
        var i: i32 = 0;
        while (i < (items.len as i32)) {
            self.child_nodes.push(items.get(i as i64).dup());
            i = i + 1;
        }
        return self;
    }

    public fn childCount(&self) -> i32 {
        return self.child_nodes.len as i32;
    }

    public fn childAt(&self, index: i32) -> View {
        if (index < 0 || index >= self.childCount()) { return View.spacer(); }
        return self.child_nodes.get(index as i64).dup();
    }

    public fn hasAction(&self) -> bool {
        return self.visible_value && self.enabled_value && self.action_name.len > 0 && self.id_value.len > 0;
    }

    public fn isFocusable(&self) -> bool {
        return self.visible_value && self.enabled_value
            && self.id_value.len > 0
            && (self.kind == appViewButton()
                || self.kind == appViewToggle()
                || self.kind == appViewTextField()
                || self.kind == appViewSlider()
                || self.kind == appViewCheckbox()
                || ((self.kind == appViewCustom() || self.kind == appViewRender()) && (self.action_name.len > 0 || self.key_action_name.len > 0)));
    }

    public fn hasCustomInteraction(&self) -> bool {
        return self.action_name.len > 0
            || self.hover_action_name.len > 0
            || self.hover_enter_action_name.len > 0
            || self.hover_exit_action_name.len > 0
            || self.pointer_down_action_name.len > 0
            || self.pointer_up_action_name.len > 0
            || self.pointer_move_action_name.len > 0
            || self.pointer_scroll_action_name.len > 0
            || self.pointer_drag_action_name.len > 0
            || self.capture_action_name.len > 0
            || self.bubble_action_name.len > 0
            || self.key_action_name.len > 0;
    }

    public fn dup(&self) -> View {
        var copied = View.create(self.kind);
        copied.id_value = self.id_value;
        copied.text_value = self.text_value;
        copied.text_resource_id = self.text_resource_id;
        copied.placeholder_value = self.placeholder_value;
        copied.action_name = self.action_name;
        copied.text_input_action_name = self.text_input_action_name;
        copied.hover_action_name = self.hover_action_name;
        copied.hover_enter_action_name = self.hover_enter_action_name;
        copied.hover_exit_action_name = self.hover_exit_action_name;
        copied.pointer_down_action_name = self.pointer_down_action_name;
        copied.pointer_up_action_name = self.pointer_up_action_name;
        copied.pointer_move_action_name = self.pointer_move_action_name;
        copied.pointer_scroll_action_name = self.pointer_scroll_action_name;
        copied.pointer_drag_action_name = self.pointer_drag_action_name;
        copied.capture_action_name = self.capture_action_name;
        copied.bubble_action_name = self.bubble_action_name;
        copied.key_action_name = self.key_action_name;
        copied.layer_id_value = self.layer_id_value;
        copied.scroll_offset_resource = self.scroll_offset_resource;
        copied.scroll_extent_value = self.scroll_extent_value;
        copied.bool_resource_id = self.bool_resource_id;
        copied.int_resource_id = self.int_resource_id;
        copied.float_resource_id = self.float_resource_id;
        copied.list_resource_id = self.list_resource_id;
        copied.checked_list_resource_id = self.checked_list_resource_id;
        copied.item_action_prefix = self.item_action_prefix;
        copied.list_key_resource = self.list_key_resource;
        copied.checked_value = self.checked_value;
        copied.numeric_value = self.numeric_value;
        copied.min_value = self.min_value;
        copied.max_value = self.max_value;
        copied.button_style = self.button_style;
        copied.text_style = self.text_style;
        copied.background_role = self.background_role;
        copied.text_color_role = self.text_color_role;
        copied.stroke_color_role = self.stroke_color_role;
        copied.has_background_color = self.has_background_color;
        copied.background_color = self.background_color.dup();
        copied.has_text_color = self.has_text_color;
        copied.text_color = self.text_color.dup();
        copied.has_stroke_color = self.has_stroke_color;
        copied.stroke_color = self.stroke_color.dup();
        copied.stroke_width_value = self.stroke_width_value;
        copied.corner_radius_value = self.corner_radius_value;
        copied.elevation_value = self.elevation_value;
        copied.main_align_value = self.main_align_value;
        copied.cross_align_value = self.cross_align_value;
        copied.anchor_value = self.anchor_value;
        copied.margin_value = self.margin_value;
        copied.text_align_value = self.text_align_value;
        copied.visible_value = self.visible_value;
        copied.enabled_value = self.enabled_value;
        copied.accessibility_role = self.accessibility_role;
        copied.accessibility_label = self.accessibility_label;
        copied.accessibility_hint = self.accessibility_hint;
        copied.width_value = self.width_value;
        copied.height_value = self.height_value;
        copied.min_width_value = self.min_width_value;
        copied.max_width_value = self.max_width_value;
        copied.min_height_value = self.min_height_value;
        copied.max_height_value = self.max_height_value;
        copied.flex_value = self.flex_value;
        copied.auto_height_value = self.auto_height_value;
        copied.fill_height_value = self.fill_height_value;
        copied.padding_value = self.padding_value;
        copied.gap_value = self.gap_value;
        copied.has_padding_value = self.has_padding_value;
        copied.has_gap_value = self.has_gap_value;
        copied.scroll_y_value = self.scroll_y_value;
        copied.columns_value = self.columns_value;
        copied.min_item_width_value = self.min_item_width_value;
        copied.item_width_value = self.item_width_value;
        copied.item_height_value = self.item_height_value;
        copied.render_slot_id = self.render_slot_id;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            copied.child_nodes.push(self.child_nodes.get(i as i64).dup());
            i = i + 1;
        }
        i = 0;
        while (i < (self.custom_views.len as i32)) {
            copied.custom_views.push(self.custom_views.get(i as i64).deref().dup());
            i = i + 1;
        }
        return copied;
    }

    public fn materialize(&self, world: AppWorld) -> View {
        var copied = View.create(self.kind);
        copied.id_value = self.id_value;
        copied.text_value = self.text_value;
        copied.text_resource_id = self.text_resource_id;
        copied.placeholder_value = self.placeholder_value;
        if (self.text_resource_id.len > 0) {
            copied.text_value = world.stringResource(self.text_resource_id, self.text_value);
        }
        copied.action_name = self.action_name;
        copied.text_input_action_name = self.text_input_action_name;
        copied.hover_action_name = self.hover_action_name;
        copied.hover_enter_action_name = self.hover_enter_action_name;
        copied.hover_exit_action_name = self.hover_exit_action_name;
        copied.pointer_down_action_name = self.pointer_down_action_name;
        copied.pointer_up_action_name = self.pointer_up_action_name;
        copied.pointer_move_action_name = self.pointer_move_action_name;
        copied.pointer_scroll_action_name = self.pointer_scroll_action_name;
        copied.pointer_drag_action_name = self.pointer_drag_action_name;
        copied.capture_action_name = self.capture_action_name;
        copied.bubble_action_name = self.bubble_action_name;
        copied.key_action_name = self.key_action_name;
        copied.layer_id_value = self.layer_id_value;
        copied.scroll_offset_resource = self.scroll_offset_resource;
        copied.scroll_extent_value = self.scroll_extent_value;
        copied.bool_resource_id = self.bool_resource_id;
        copied.int_resource_id = self.int_resource_id;
        copied.float_resource_id = self.float_resource_id;
        copied.list_resource_id = self.list_resource_id;
        copied.checked_list_resource_id = self.checked_list_resource_id;
        copied.item_action_prefix = self.item_action_prefix;
        copied.list_key_resource = self.list_key_resource;
        copied.checked_value = self.checked_value;
        copied.numeric_value = self.numeric_value;
        copied.min_value = self.min_value;
        copied.max_value = self.max_value;
        copied.button_style = self.button_style;
        copied.text_style = self.text_style;
        copied.background_role = self.background_role;
        copied.text_color_role = self.text_color_role;
        copied.stroke_color_role = self.stroke_color_role;
        copied.has_background_color = self.has_background_color;
        copied.background_color = self.background_color.dup();
        copied.has_text_color = self.has_text_color;
        copied.text_color = self.text_color.dup();
        copied.has_stroke_color = self.has_stroke_color;
        copied.stroke_color = self.stroke_color.dup();
        copied.stroke_width_value = self.stroke_width_value;
        copied.corner_radius_value = self.corner_radius_value;
        copied.elevation_value = self.elevation_value;
        copied.main_align_value = self.main_align_value;
        copied.cross_align_value = self.cross_align_value;
        copied.anchor_value = self.anchor_value;
        copied.margin_value = self.margin_value;
        copied.text_align_value = self.text_align_value;
        copied.visible_value = self.visible_value;
        copied.enabled_value = self.enabled_value;
        if (self.bool_resource_id.len > 0) {
            copied.checked_value = world.boolResource(self.bool_resource_id, self.checked_value);
        }
        if (self.float_resource_id.len > 0) {
            copied.numeric_value = world.floatResource(self.float_resource_id, self.numeric_value);
        } else if (self.int_resource_id.len > 0) {
            copied.numeric_value = f32FromInt(world.intResource(self.int_resource_id, self.numeric_value as i32));
        }
        copied.accessibility_role = self.accessibility_role;
        copied.accessibility_label = self.accessibility_label;
        copied.accessibility_hint = self.accessibility_hint;
        copied.width_value = self.width_value;
        copied.height_value = self.height_value;
        copied.min_width_value = self.min_width_value;
        copied.max_width_value = self.max_width_value;
        copied.min_height_value = self.min_height_value;
        copied.max_height_value = self.max_height_value;
        copied.flex_value = self.flex_value;
        copied.auto_height_value = self.auto_height_value;
        copied.fill_height_value = self.fill_height_value;
        copied.padding_value = self.padding_value;
        copied.gap_value = self.gap_value;
        copied.has_padding_value = self.has_padding_value;
        copied.has_gap_value = self.has_gap_value;
        copied.scroll_y_value = self.scroll_y_value;
        copied.columns_value = self.columns_value;
        copied.min_item_width_value = self.min_item_width_value;
        copied.item_width_value = self.item_width_value;
        copied.item_height_value = self.item_height_value;
        copied.render_slot_id = self.render_slot_id;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            copied.child_nodes.push(self.child_nodes.get(i as i64).materialize(world));
            i = i + 1;
        }
        i = 0;
        while (i < (self.custom_views.len as i32)) {
            copied.custom_views.push(self.custom_views.get(i as i64).deref().dup());
            i = i + 1;
        }
        return copied;
    }

    public fn bindActions(&self, world: AppWorld) -> AppWorld {
        return self.bindActionsInLayer(world, "", "");
    }

    // `inherited_layer` carries the enclosing overlay layer down the tree, so a
    // dialog marks its whole subtree without every child repeating `.layer()`.
    // `parent_id` does the same for the accessibility hierarchy.
    public fn bindActionsInLayer(&self, world: AppWorld, inherited_layer: string, parent_id: string) -> AppWorld {
        var effective_layer = inherited_layer;
        if (self.layer_id_value.len > 0) { effective_layer = self.layer_id_value; }
        var out = world;
        if (!self.visible_value) { return out; }
        if (self.hasAction()) {
            out = out.setStringResource("action:" + self.id_value, self.action_name);
        }
        if (self.visible_value && self.enabled_value && self.kind == appViewTextField() && self.id_value.len > 0 && self.text_input_action_name.len > 0) {
            out = out.setStringResource("text_input_action:" + self.id_value, self.text_input_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.hover_action_name.len > 0) {
            out = out.setStringResource("hover_action:" + self.id_value, self.hover_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.hover_enter_action_name.len > 0) {
            out = out.setStringResource("hover_enter_action:" + self.id_value, self.hover_enter_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.hover_exit_action_name.len > 0) {
            out = out.setStringResource("hover_exit_action:" + self.id_value, self.hover_exit_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.pointer_down_action_name.len > 0) {
            out = out.setStringResource("pointer_down_action:" + self.id_value, self.pointer_down_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.pointer_up_action_name.len > 0) {
            out = out.setStringResource("pointer_up_action:" + self.id_value, self.pointer_up_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.pointer_move_action_name.len > 0) {
            out = out.setStringResource("pointer_move_action:" + self.id_value, self.pointer_move_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.pointer_scroll_action_name.len > 0) {
            out = out.setStringResource("pointer_scroll_action:" + self.id_value, self.pointer_scroll_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.pointer_drag_action_name.len > 0) {
            out = out.setStringResource("pointer_drag_action:" + self.id_value, self.pointer_drag_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.capture_action_name.len > 0) {
            out = out.setStringResource("capture_action:" + self.id_value, self.capture_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.bubble_action_name.len > 0) {
            out = out.setStringResource("bubble_action:" + self.id_value, self.bubble_action_name);
        }
        if (self.visible_value && self.enabled_value && self.id_value.len > 0 && self.key_action_name.len > 0) {
            out = out.setStringResource("key_action:" + self.id_value, self.key_action_name);
        }
        if (self.isFocusable()) {
            out = out.registerFocusable(self.id_value);
        }
        if (self.visible_value && self.enabled_value && self.kind == appViewTextField() && self.id_value.len > 0) {
            out = out.setStringResource("text_input:" + self.id_value, "1");
            if (self.text_resource_id.len > 0) {
                out = out.setStringResource("text_input_resource:" + self.id_value, self.text_resource_id);
            }
        }
        if (self.id_value.len > 0 && self.accessibility_role.len > 0) {
            // A complete node: name, role, state, value, actions and hierarchy.
            // The platform bridge only ever sees this model.
            var node = AccessibilityNode.create(self.id_value, self.accessibility_role, self.accessibilityLabelForNode(), self.accessibility_hint);
            node = node.withParent(parent_id);
            node = node.withValue(self.accessibilityValueForNode(out));
            node = node.withState(self.accessibilityStateForNode(out));
            node = node.withActions(self.accessibilityActionsForNode());
            out = out.registerAccessibility(node);
        }
        if (self.kind == appViewList() && self.id_value.len > 0 && self.list_resource_id.len > 0) {
            var item_i: i32 = 0;
            let item_count = out.stringListResourceCount(self.list_resource_id);
            while (item_i < item_count) {
                // A stable key keeps a row's identity across insert and remove.
                // Without keys the index is used, which is all a static list needs.
                var suffix = format("%d", item_i as i64);
                if (self.list_key_resource.len > 0 && item_i < out.stringListResourceCount(self.list_key_resource)) {
                    let key = out.stringListResourceAt(self.list_key_resource, item_i);
                    if (key.len > 0) { suffix = key; }
                }
                let item_id = self.id_value + "." + suffix;
                if (self.item_action_prefix.len > 0) {
                    out = out.setStringResource("action:" + item_id, self.item_action_prefix + suffix);
                }
                out = out.registerFocusable(item_id);
                var item_node = AccessibilityNode.create(item_id, "checkbox", out.stringListResourceAt(self.list_resource_id, item_i), self.accessibility_hint);
                item_node = item_node.withParent(self.id_value);
                item_node = item_node.withLevel(1);
                if (self.checked_list_resource_id.len > 0) {
                    if (out.boolListResourceAt(self.checked_list_resource_id, item_i)) {
                        item_node = item_node.withState("checked");
                    } else {
                        item_node = item_node.withState("unchecked");
                    }
                }
                if (self.item_action_prefix.len > 0) {
                    item_node = item_node.withActions(self.item_action_prefix + suffix);
                }
                out = out.registerAccessibility(item_node);
                item_i = item_i + 1;
            }
        }
        if (self.id_value.len > 0 && effective_layer.len > 0) {
            out = out.setViewLayer(self.id_value, effective_layer);
        }
        if (self.id_value.len > 0 && self.scroll_offset_resource.len > 0) {
            out = out.setStringResource("scroll_offset:" + self.id_value, self.scroll_offset_resource);
            out = out.setFloatResource("scroll_extent:" + self.id_value, self.scroll_extent_value);
            out = out.registerScrollContainer(self.id_value);
        }
        var child_parent = parent_id;
        if (self.id_value.len > 0) { child_parent = self.id_value; }
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            out = self.child_nodes.get(i as i64).bindActionsInLayer(out, effective_layer, child_parent);
            i = i + 1;
        }
        return out;
    }

    public fn accessibilityLabelForNode(&self) -> string {
        if (self.accessibility_label.len > 0) { return self.accessibility_label; }
        return self.text_value;
    }

    // What a screen reader announces as the current value.
    private fn accessibilityValueForNode(&self, world: AppWorld) -> string {
        if (self.text_resource_id.len > 0) {
            return world.stringResource(self.text_resource_id, self.text_value);
        }
        if (self.kind == appViewSlider()) { return app_format_f32(self.numeric_value); }
        return self.text_value;
    }

    private fn accessibilityStateForNode(&self, world: AppWorld) -> string {
        if (!self.enabled_value) { return "disabled"; }
        if (self.kind == appViewCheckbox() || self.kind == appViewToggle()) {
            var checked = self.checked_value;
            if (self.bool_resource_id.len > 0) {
                checked = world.boolResource(self.bool_resource_id, self.checked_value);
            }
            if (checked) { return "checked"; }
            return "unchecked";
        }
        return "";
    }

    private fn accessibilityActionsForNode(&self) -> string {
        if (self.action_name.len > 0) { return self.action_name; }
        return "";
    }

    @[borrow_args]
    public fn toUiTree(mut self, width: f32, height: f32, theme: UiTheme) -> UiTree {
        var tree = UiTree.create(width, height);
        var bounds: Rectangle;
        bounds.x = f32Zero();
        bounds.y = f32Zero();
        bounds.width = width;
        bounds.height = height;
        return self.appendChildrenTo(tree, 0, bounds, theme);
    }

    @[borrow_args]
    public fn toUiTreeWithWorld(mut self, width: f32, height: f32, theme: UiTheme, world: AppWorld) -> UiTree {
        var tree = UiTree.create(width, height);
        var bounds: Rectangle;
        bounds.x = f32Zero();
        bounds.y = f32Zero();
        bounds.width = width;
        bounds.height = height;
        return self.appendChildrenToWithWorld(tree, 0, bounds, theme, world);
    }

    public fn uiTextAlignValue(&self) -> i32 {
        if (self.text_align_value == appTextAlignCenter()) { return uiTextAlignCenter(); }
        if (self.text_align_value == appTextAlignRight()) { return uiTextAlignRight(); }
        return uiTextAlignLeft();
    }

    public fn applyNodeStyle(mut self, node: UiNode, theme: UiTheme) -> UiNode {
        var out = node;
        if (self.background_role != appColorRoleNone()) { out = out.withColor(appColorRoleValue(self.background_role, theme)); }
        if (self.has_background_color) { out = out.withColor(self.background_color); }
        if (self.text_color_role != appColorRoleNone()) { out = out.withTextColor(appColorRoleValue(self.text_color_role, theme)); }
        if (self.has_text_color) { out = out.withTextColor(self.text_color); }
        if (self.stroke_width_value >= f32Zero()) {
            if (self.stroke_color_role != appColorRoleNone()) {
                out = out.withStroke(self.stroke_width_value, appColorRoleValue(self.stroke_color_role, theme));
            } else if (self.has_stroke_color) {
                out = out.withStroke(self.stroke_width_value, self.stroke_color);
            } else {
                out = out.withStroke(self.stroke_width_value, colorTransparent());
            }
        }
        if (self.corner_radius_value >= f32Zero()) { out = out.withCornerRadius(self.corner_radius_value); }
        if (self.elevation_value > f32Zero()) { out = out.withElevation(self.elevation_value); }
        out = out.withTextAlign(self.uiTextAlignValue());
        return out;
    }

    @[borrow_args]
    public fn panelNode(mut self, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.panel(self.nodeId("panel"), bounds, theme.surface)
            .withStroke(f32One(), theme.outline_variant)
            .withCornerRadius(theme.shape_large);
        return self.applyNodeStyle(node, theme);
    }

    @[borrow_args]
    public fn boxNode(mut self, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.panel(self.nodeId("box"), bounds, colorTransparent());
        return self.applyNodeStyle(node, theme);
    }

    @[borrow_args]
    public fn dividerNode(mut self, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var color = theme.outline_variant;
        if (self.background_role != appColorRoleNone()) { color = appColorRoleValue(self.background_role, theme); }
        if (self.has_background_color) { color = self.background_color; }
        var node = UiNode.panel(self.nodeId("divider"), bounds, color);
        node = node.withStroke(f32Zero(), colorTransparent());
        return self.applyNodeStyle(node, theme);
    }

    @[borrow_args]
    public fn appendChildrenTo(&mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        if (!self.visible_value) { return tree; }
        if (self.kind == appViewColumn() || self.kind == appViewRow()) {
            return self.appendContainerChildren(tree, parent, bounds, theme, self.kind == appViewRow());
        }
        if (self.kind == appViewBox()) {
            return self.appendBoxChildren(tree, parent, bounds, theme);
        }
        if (self.kind == appViewGrid()) {
            return self.appendGridChildren(tree, parent, bounds, theme);
        }
        if (self.kind == appViewWrap()) {
            return self.appendWrapChildren(tree, parent, bounds, theme);
        }
        if (self.kind == appViewStack()) {
            return self.appendStackChildren(tree, parent, bounds, theme);
        }
        if (self.kind == appViewScroll()) {
            return self.appendScrollChildren(tree, parent, bounds, theme);
        }
        if (self.kind == appViewList()) {
            return tree;
        }
        if (self.kind == appViewPanel()) {
            var out = tree;
            let index = out.nodeCount();
            out = out.add(parent, self.panelNode(bounds, theme));
            // appendContainerChildren owns the inset. Passing an already
            // inset rectangle here applied Panel.padding twice.
            return self.appendContainerChildren(out, index, bounds, theme, false);
        }
        return self.appendLeafTo(tree, parent, bounds, theme);
    }

    @[borrow_args]
    public fn appendChildrenToWithWorld(&mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        if (!self.visible_value) { return tree; }
        if (self.kind == appViewColumn() || self.kind == appViewRow()) {
            return self.appendContainerChildrenWithWorld(tree, parent, bounds, theme, self.kind == appViewRow(), world);
        }
        if (self.kind == appViewBox()) {
            return self.appendBoxChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewGrid()) {
            return self.appendGridChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewWrap()) {
            return self.appendWrapChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewStack()) {
            return self.appendStackChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewScroll()) {
            return self.appendScrollChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewList()) {
            return self.appendListChildrenWithWorld(tree, parent, bounds, theme, world);
        }
        if (self.kind == appViewPanel()) {
            var out = tree;
            let index = out.nodeCount();
            out = out.add(parent, self.panelNode(bounds, theme));
            return self.appendContainerChildrenWithWorld(out, index, bounds, theme, false, world);
        }
        return self.appendLeafToWithWorld(tree, parent, bounds, theme, world);
    }

    @[borrow_args]
    public fn childLayoutHeight(&self, child: View, bounds: Rectangle, theme: UiTheme, cursor: f32, pad: f32) -> f32 {
        let available_width = child.widthOr(bounds.width - (pad * f32FromMilli(2000)));
        // The same measurement path supplies the original leaf defaults and
        // recursively measures containers. Explicit heights remain authoritative.
        var child_height = child.measureIntrinsicHeight(available_width, theme);
        if (child.height_value <= f32Zero() && child.fill_height_value) {
            // Filling is explicit.  It is kept separate from intrinsic sizing
            // so a composite can be nested without stealing the remaining
            // extent from its siblings.
            child_height = bounds.height - cursor - pad;
        }
        return child.clampHeight(child_height);
    }

    public fn clampWidth(&self, value: f32) -> f32 {
        var out = value;
        if (self.min_width_value > f32Zero() && out < self.min_width_value) { out = self.min_width_value; }
        if (self.max_width_value > f32Zero() && out > self.max_width_value) { out = self.max_width_value; }
        if (out < f32Zero()) { out = f32Zero(); }
        return out;
    }

    public fn clampHeight(&self, value: f32) -> f32 {
        var out = value;
        if (self.min_height_value > f32Zero() && out < self.min_height_value) { out = self.min_height_value; }
        if (self.max_height_value > f32Zero() && out > self.max_height_value) { out = self.max_height_value; }
        if (out < f32Zero()) { out = f32Zero(); }
        return out;
    }

    public fn containerVisibleChildCount(&self) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            if (self.child_nodes.get(i as i64).visible_value) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn containerGapTotal(&self, gap: f32) -> f32 {
        let count = self.containerVisibleChildCount();
        if (count <= 1) { return f32Zero(); }
        return gap * f32FromInt(count - 1);
    }

    @[borrow_args]
    public fn childBaseMainSize(&self, child: View, bounds: Rectangle, theme: UiTheme, horizontal: bool, cursor: f32, pad: f32) -> f32 {
        if (horizontal) {
            return child.clampWidth(child.widthOr(theme.control_height));
        }
        return child.clampHeight(self.childLayoutHeight(child, bounds, theme, cursor, pad));
    }

    @[borrow_args]
    public fn childCrossSize(&self, child: View, horizontal: bool, available_cross: f32) -> f32 {
        if (horizontal) {
            var child_height = child.heightOr(available_cross);
            if (self.cross_align_value == appAlignStretch()) { child_height = available_cross; }
            return child.clampHeight(child_height);
        }
        var child_width = child.widthOr(available_cross);
        if (self.cross_align_value == appAlignStretch()) { child_width = available_cross; }
        return child.clampWidth(child_width);
    }

    public fn containerFlexSum(&self) -> f32 {
        var total: f32 = f32Zero();
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value && child.flex_value > f32Zero()) {
                total = total + child.flex_value;
            }
            i = i + 1;
        }
        return total;
    }

    @[borrow_args]
    public fn containerFixedMainSize(&self, bounds: Rectangle, theme: UiTheme, horizontal: bool, pad: f32, gap: f32) -> f32 {
        var total: f32 = f32Zero();
        var cursor: f32 = pad;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value && child.flex_value <= f32Zero()) {
                let size = self.childBaseMainSize(child, bounds, theme, horizontal, cursor, pad);
                total = total + size;
                cursor = cursor + size + gap;
            }
            i = i + 1;
        }
        return total;
    }

    public fn containerFlexRemaining(&self, available_main: f32, fixed_main: f32, gap_total: f32) -> f32 {
        var remaining = available_main - fixed_main - gap_total;
        if (remaining < f32Zero()) { remaining = f32Zero(); }
        return remaining;
    }

    @[borrow_args]
    public fn childMainSize(&self, child: View, bounds: Rectangle, theme: UiTheme, horizontal: bool, cursor: f32, pad: f32, flex_remaining: f32, flex_sum: f32) -> f32 {
        var out = self.childBaseMainSize(child, bounds, theme, horizontal, cursor, pad);
        if (child.flex_value > f32Zero() && flex_sum > f32Zero()) {
            out = f32Zero();
            if (flex_remaining > f32Zero()) {
                out = flex_remaining * (child.flex_value / flex_sum);
            }
        }
        if (horizontal) { return child.clampWidth(out); }
        return child.clampHeight(out);
    }

    @[borrow_args]
    public fn containerChildrenMainSize(&self, bounds: Rectangle, theme: UiTheme, horizontal: bool, pad: f32, gap: f32) -> f32 {
        var total: f32 = f32Zero();
        var available_main = bounds.height - (pad * f32FromMilli(2000));
        if (horizontal) { available_main = bounds.width - (pad * f32FromMilli(2000)); }
        let fixed_main = self.containerFixedMainSize(bounds, theme, horizontal, pad, gap);
        let gap_total = self.containerGapTotal(gap);
        let flex_sum = self.containerFlexSum();
        let flex_remaining = self.containerFlexRemaining(available_main, fixed_main, gap_total);
        var cursor: f32 = pad;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_main = self.childMainSize(child, bounds, theme, horizontal, cursor, pad, flex_remaining, flex_sum);
                total = total + child_main;
                cursor = cursor + child_main + gap;
            }
            i = i + 1;
        }
        return total + gap_total;
    }

    public fn containerStartCursor(&self, available: f32, total: f32, pad: f32) -> f32 {
        var cursor: f32 = pad;
        var extra: f32 = available - total;
        if (extra < f32Zero()) { extra = f32Zero(); }
        if (self.main_align_value == appAlignCenter()) {
            cursor = pad + (extra * f32FromMilli(500));
        } else if (self.main_align_value == appAlignEnd()) {
            cursor = pad + extra;
        }
        return cursor;
    }

    public fn alignedCrossStart(&self, base: f32, available: f32, size: f32, pad: f32) -> f32 {
        var pos = base + pad;
        var extra = available - size;
        if (extra < f32Zero()) { extra = f32Zero(); }
        if (self.cross_align_value == appAlignCenter()) {
            pos = base + pad + (extra * f32FromMilli(500));
        } else if (self.cross_align_value == appAlignEnd()) {
            pos = base + pad + extra;
        }
        return pos;
    }

    @[borrow_args]
    public fn appendContainerChildren(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, horizontal: bool) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var available_main = bounds.height - (pad * f32FromMilli(2000));
        if (horizontal) { available_main = bounds.width - (pad * f32FromMilli(2000)); }
        var available_cross = bounds.width - (pad * f32FromMilli(2000));
        if (horizontal) { available_cross = bounds.height - (pad * f32FromMilli(2000)); }
        let fixed_main = self.containerFixedMainSize(bounds, theme, horizontal, pad, gap);
        let gap_total = self.containerGapTotal(gap);
        let flex_sum = self.containerFlexSum();
        let flex_remaining = self.containerFlexRemaining(available_main, fixed_main, gap_total);
        let total_main = self.containerChildrenMainSize(bounds, theme, horizontal, pad, gap);
        var cursor: f32 = self.containerStartCursor(available_main, total_main, pad);
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_main = self.childMainSize(child, bounds, theme, horizontal, cursor, pad, flex_remaining, flex_sum);
                var child_width: f32;
                var child_height: f32;
                var child_bounds: Rectangle;
                if (horizontal) {
                    child_width = child_main;
                    child_height = self.childCrossSize(child, horizontal, available_cross);
                    child_bounds = Rectangle.xywh(bounds.x + cursor, self.alignedCrossStart(bounds.y, available_cross, child_height, pad), child_width, child_height);
                    cursor = cursor + child_width + gap;
                } else {
                    child_width = self.childCrossSize(child, horizontal, available_cross);
                    child_height = child_main;
                    child_bounds = Rectangle.xywh(self.alignedCrossStart(bounds.x, available_cross, child_width, pad), bounds.y + cursor, child_width, child_height);
                    cursor = cursor + child_height + gap;
                }
                out = child.appendChildrenTo(out, parent, child_bounds, theme);
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendContainerChildrenWithWorld(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, horizontal: bool, world: AppWorld) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var available_main = bounds.height - (pad * f32FromMilli(2000));
        if (horizontal) { available_main = bounds.width - (pad * f32FromMilli(2000)); }
        var available_cross = bounds.width - (pad * f32FromMilli(2000));
        if (horizontal) { available_cross = bounds.height - (pad * f32FromMilli(2000)); }
        let fixed_main = self.containerFixedMainSize(bounds, theme, horizontal, pad, gap);
        let gap_total = self.containerGapTotal(gap);
        let flex_sum = self.containerFlexSum();
        let flex_remaining = self.containerFlexRemaining(available_main, fixed_main, gap_total);
        let total_main = self.containerChildrenMainSize(bounds, theme, horizontal, pad, gap);
        var cursor: f32 = self.containerStartCursor(available_main, total_main, pad);
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_main = self.childMainSize(child, bounds, theme, horizontal, cursor, pad, flex_remaining, flex_sum);
                var child_width: f32;
                var child_height: f32;
                var child_bounds: Rectangle;
                if (horizontal) {
                    child_width = child_main;
                    child_height = self.childCrossSize(child, horizontal, available_cross);
                    child_bounds = Rectangle.xywh(bounds.x + cursor, self.alignedCrossStart(bounds.y, available_cross, child_height, pad), child_width, child_height);
                    cursor = cursor + child_width + gap;
                } else {
                    child_width = self.childCrossSize(child, horizontal, available_cross);
                    child_height = child_main;
                    child_bounds = Rectangle.xywh(self.alignedCrossStart(bounds.x, available_cross, child_width, pad), bounds.y + cursor, child_width, child_height);
                    cursor = cursor + child_height + gap;
                }
                out = child.appendChildrenToWithWorld(out, parent, child_bounds, theme, world);
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendBoxChildren(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var out = tree;
        let index = out.nodeCount();
        out = out.add(parent, self.boxNode(bounds, theme));
        let pad = self.paddingOr(f32Zero());
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                out = child.appendChildrenTo(out, index, self.stackChildBounds(child, inner), theme);
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendBoxChildrenWithWorld(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let index = out.nodeCount();
        out = out.add(parent, self.boxNode(bounds, theme));
        let pad = self.paddingOr(f32Zero());
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                out = child.appendChildrenToWithWorld(out, index, self.stackChildBounds(child, inner), theme, world);
            }
            i = i + 1;
        }
        return out;
    }

    public fn gridVisibleCount(&self) -> i32 {
        return self.containerVisibleChildCount();
    }

    public fn gridColumnsForWidth(&self, available_width: f32, gap: f32) -> i32 {
        if (self.columns_value > 0) { return self.columns_value; }
        var min_width = self.min_item_width_value;
        if (min_width <= f32Zero()) { min_width = f32FromMilli(160000); }
        var cols = ((available_width + gap) / (min_width + gap)) as i32;
        if (cols < 1) { cols = 1; }
        let visible = self.gridVisibleCount();
        if (visible > 0 && cols > visible) { cols = visible; }
        return cols;
    }

    public fn gridItemWidth(&self, available_width: f32, columns: i32, gap: f32) -> f32 {
        if (columns <= 1) { return available_width; }
        var out = (available_width - (gap * f32FromInt(columns - 1))) / f32FromInt(columns);
        if (out < f32Zero()) { out = f32Zero(); }
        return out;
    }

    public fn gridItemHeightFor(&self, child: View, cell_height: f32) -> f32 {
        if (child.height_value > f32Zero()) { return child.clampHeight(child.height_value); }
        return child.clampHeight(cell_height);
    }

    public fn gridItemWidthFor(&self, child: View, cell_width: f32) -> f32 {
        if (child.width_value > f32Zero()) { return child.clampWidth(child.width_value); }
        return child.clampWidth(cell_width);
    }

    public fn gridCellBounds(&self, inner: Rectangle, column: i32, row: i32, columns: i32, gap: f32, cell_width: f32, cell_height: f32, child: View) -> Rectangle {
        let cell_x = inner.x + ((f32FromInt(column)) * (cell_width + gap));
        let cell_y = inner.y + ((f32FromInt(row)) * (cell_height + gap));
        let child_width = self.gridItemWidthFor(child, cell_width);
        let child_height = self.gridItemHeightFor(child, cell_height);
        var child_x = cell_x;
        var child_y = cell_y;
        if (self.cross_align_value == appAlignCenter()) {
            child_x = cell_x + ((cell_width - child_width) * f32FromMilli(500));
        } else if (self.cross_align_value == appAlignEnd()) {
            child_x = cell_x + (cell_width - child_width);
        }
        if (self.main_align_value == appAlignCenter()) {
            child_y = cell_y + ((cell_height - child_height) * f32FromMilli(500));
        } else if (self.main_align_value == appAlignEnd()) {
            child_y = cell_y + (cell_height - child_height);
        }
        return Rectangle.xywh(child_x, child_y, child_width, child_height);
    }

    public fn measureGridHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var inner_width = available_width - (pad * f32FromMilli(2000));
        if (inner_width < f32Zero()) { inner_width = f32Zero(); }
        let visible = self.gridVisibleCount();
        if (visible <= 0) { return self.clampHeight(pad * f32FromMilli(2000)); }
        let columns = self.gridColumnsForWidth(inner_width, gap);
        var rows = visible / columns;
        if ((visible % columns) != 0) { rows = rows + 1; }
        var cell_height = self.item_height_value;
        if (cell_height <= f32Zero()) { cell_height = theme.control_height; }
        var total = pad * f32FromMilli(2000) + ((f32FromInt(rows)) * cell_height);
        if (rows > 1) { total = total + (f32FromInt(rows - 1) * gap); }
        return self.clampHeight(total);
    }

    @[borrow_args]
    public fn appendGridChildren(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        let columns = self.gridColumnsForWidth(inner.width, gap);
        let cell_width = self.gridItemWidth(inner.width, columns, gap);
        var cell_height = self.item_height_value;
        if (cell_height <= f32Zero()) { cell_height = theme.control_height; }
        var visible_i: i32 = 0;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let column = visible_i % columns;
                let row = visible_i / columns;
                let child_bounds = self.gridCellBounds(inner, column, row, columns, gap, cell_width, cell_height, child);
                out = child.appendChildrenTo(out, parent, child_bounds, theme);
                visible_i = visible_i + 1;
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendGridChildrenWithWorld(mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        let columns = self.gridColumnsForWidth(inner.width, gap);
        let cell_width = self.gridItemWidth(inner.width, columns, gap);
        var cell_height = self.item_height_value;
        if (cell_height <= f32Zero()) { cell_height = theme.control_height; }
        var visible_i: i32 = 0;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let column = visible_i % columns;
                let row = visible_i / columns;
                let child_bounds = self.gridCellBounds(inner, column, row, columns, gap, cell_width, cell_height, child);
                out = child.appendChildrenToWithWorld(out, parent, child_bounds, theme, world);
                visible_i = visible_i + 1;
            }
            i = i + 1;
        }
        return out;
    }

    public fn wrapItemWidthFor(&self, child: View, fallback: f32) -> f32 {
        if (child.width_value > f32Zero()) { return child.clampWidth(child.width_value); }
        return child.clampWidth(fallback);
    }

    public fn wrapItemHeightFor(&self, child: View, fallback: f32) -> f32 {
        if (child.height_value > f32Zero()) { return child.clampHeight(child.height_value); }
        return child.clampHeight(fallback);
    }

    public fn measureWrapHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var inner_width = available_width - (pad * f32FromMilli(2000));
        if (inner_width < f32Zero()) { inner_width = f32Zero(); }
        var fallback_width = self.item_width_value;
        if (fallback_width <= f32Zero()) { fallback_width = theme.control_height * f32FromMilli(3000); }
        var fallback_height = self.item_height_value;
        if (fallback_height <= f32Zero()) { fallback_height = theme.control_height; }
        var x: f32 = f32Zero();
        var y: f32 = f32Zero();
        var row_height: f32 = f32Zero();
        var has_visible = false;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_width = self.wrapItemWidthFor(child, fallback_width);
                let child_height = self.wrapItemHeightFor(child, fallback_height);
                if (x > f32Zero() && x + child_width > inner_width) {
                    x = f32Zero();
                    y = y + row_height + gap;
                    row_height = f32Zero();
                }
                x = x + child_width + gap;
                if (child_height > row_height) { row_height = child_height; }
                has_visible = true;
            }
            i = i + 1;
        }
        if (!has_visible) { return self.clampHeight(pad * f32FromMilli(2000)); }
        return self.clampHeight((pad * f32FromMilli(2000)) + y + row_height);
    }

    public fn measureContainerHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var inner_width = available_width - (pad * f32FromMilli(2000));
        if (inner_width < f32Zero()) { inner_width = f32Zero(); }
        var total: f32 = pad * f32FromMilli(2000);
        var visible_count: i32 = 0;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                if (visible_count > 0) { total = total + gap; }
                // inner_width already excludes this container's padding. A
                // measurement has no remaining height to fill; stretch/flex
                // are applied later using the actual assigned bounds.
                let child_height = child.measureIntrinsicHeight(child.widthOr(inner_width), theme);
                total = total + child_height;
                visible_count = visible_count + 1;
            }
            i = i + 1;
        }
        return self.clampHeight(total);
    }

    public fn measureBoxHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        let pad = self.paddingOr(f32Zero());
        var inner_width = available_width - (pad * f32FromMilli(2000));
        if (inner_width < f32Zero()) { inner_width = f32Zero(); }
        var max_height: f32 = f32Zero();
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_height = child.measureIntrinsicHeight(child.widthOr(inner_width), theme);
                if (child_height > max_height) { max_height = child_height; }
            }
            i = i + 1;
        }
        return self.clampHeight((pad * f32FromMilli(2000)) + max_height);
    }

    public fn measureRowHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        var inner_width = available_width - (pad * f32FromMilli(2000));
        if (inner_width < f32Zero()) { inner_width = f32Zero(); }
        let bounds = Rectangle.xywh(f32Zero(), f32Zero(), available_width, f32Zero());
        let fixed_main = self.containerFixedMainSize(bounds, theme, true, pad, gap);
        let gap_total = self.containerGapTotal(gap);
        let flex_sum = self.containerFlexSum();
        let flex_remaining = self.containerFlexRemaining(inner_width, fixed_main, gap_total);
        var max_height: f32 = f32Zero();
        var i: i32 = 0;
        while (i < self.childCount()) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_width = self.childMainSize(child, bounds, theme, true, f32Zero(), pad, flex_remaining, flex_sum);
                let child_height = child.measureIntrinsicHeight(child_width, theme);
                if (child_height > max_height) { max_height = child_height; }
            }
            i = i + 1;
        }
        return self.clampHeight((pad * f32FromMilli(2000)) + max_height);
    }

    public fn measureIntrinsicHeight(&self, available_width: f32, theme: UiTheme) -> f32 {
        if (self.height_value > f32Zero()) { return self.clampHeight(self.height_value); }
        if (self.kind == appViewGrid()) { return self.measureGridHeight(available_width, theme); }
        if (self.kind == appViewWrap()) { return self.measureWrapHeight(available_width, theme); }
        if (self.kind == appViewBox() || self.kind == appViewStack()) { return self.measureBoxHeight(available_width, theme); }
        if (self.kind == appViewColumn() || self.kind == appViewPanel() || self.kind == appViewScroll()) { return self.measureContainerHeight(available_width, theme); }
        if (self.kind == appViewRow()) { return self.measureRowHeight(available_width, theme); }
        if (self.kind == appViewText()) { return self.clampHeight(theme.typography_body + theme.spacing_md); }
        if (self.kind == appViewTextField()) { return self.clampHeight(theme.control_height + theme.spacing_sm); }
        if (self.kind == appViewDivider()) { return self.clampHeight(f32One()); }
        return self.clampHeight(theme.control_height);
    }

    @[borrow_args]
    public fn appendWrapChildren(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var fallback_width = self.item_width_value;
        if (fallback_width <= f32Zero()) { fallback_width = theme.control_height * f32FromMilli(3000); }
        var fallback_height = self.item_height_value;
        if (fallback_height <= f32Zero()) { fallback_height = theme.control_height; }
        var x = inner.x;
        var y = inner.y;
        var row_height: f32 = f32Zero();
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_width = self.wrapItemWidthFor(child, fallback_width);
                let child_height = self.wrapItemHeightFor(child, fallback_height);
                if (x > inner.x && x + child_width > inner.x + inner.width) {
                    x = inner.x;
                    y = y + row_height + gap;
                    row_height = f32Zero();
                }
                out = child.appendChildrenTo(out, parent, Rectangle.xywh(x, y, child_width, child_height), theme);
                x = x + child_width + gap;
                if (child_height > row_height) { row_height = child_height; }
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendWrapChildrenWithWorld(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var fallback_width = self.item_width_value;
        if (fallback_width <= f32Zero()) { fallback_width = theme.control_height * f32FromMilli(3000); }
        var fallback_height = self.item_height_value;
        if (fallback_height <= f32Zero()) { fallback_height = theme.control_height; }
        var x = inner.x;
        var y = inner.y;
        var row_height: f32 = f32Zero();
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            if (child.visible_value) {
                let child_width = self.wrapItemWidthFor(child, fallback_width);
                let child_height = self.wrapItemHeightFor(child, fallback_height);
                if (x > inner.x && x + child_width > inner.x + inner.width) {
                    x = inner.x;
                    y = y + row_height + gap;
                    row_height = f32Zero();
                }
                out = child.appendChildrenToWithWorld(out, parent, Rectangle.xywh(x, y, child_width, child_height), theme, world);
                x = x + child_width + gap;
                if (child_height > row_height) { row_height = child_height; }
            }
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn stackChildBounds(&self, child: View, inner: Rectangle) -> Rectangle {
        var child_width = child.widthOr(inner.width);
        var child_height = child.heightOr(inner.height);
        var child_x = inner.x;
        var child_y = inner.y;
        if (child.anchor_value == appAnchorFill()) {
            child_width = inner.width;
            child_height = inner.height;
        } else if (child.anchor_value == appAnchorTopFill()) {
            child_width = inner.width;
            child_height = child.heightOr(inner.height);
        } else if (child.anchor_value == appAnchorStartFill()) {
            child_width = child.widthOr(inner.width);
            child_height = inner.height;
        } else if (child.anchor_value == appAnchorEndFill()) {
            child_width = child.widthOr(inner.width);
            child_height = inner.height;
            child_x = inner.x + inner.width - child_width;
        } else if (child.anchor_value == appAnchorBottomFill()) {
            child_width = inner.width;
            child_height = child.heightOr(inner.height);
            child_y = inner.y + inner.height - child_height;
        } else if (child.anchor_value == appAnchorCenter()) {
            child_x = inner.x + ((inner.width - child_width) * f32FromMilli(500));
            child_y = inner.y + ((inner.height - child_height) * f32FromMilli(500));
        } else if (child.anchor_value == appAnchorTopStart()) {
            child_x = inner.x + child.margin_value;
            child_y = inner.y + child.margin_value;
        } else if (child.anchor_value == appAnchorTopEnd()) {
            child_x = inner.x + inner.width - child_width - child.margin_value;
            child_y = inner.y + child.margin_value;
        } else if (child.anchor_value == appAnchorBottomStart()) {
            child_x = inner.x + child.margin_value;
            child_y = inner.y + inner.height - child_height - child.margin_value;
        } else if (child.anchor_value == appAnchorBottomEnd()) {
            child_x = inner.x + inner.width - child_width - child.margin_value;
            child_y = inner.y + inner.height - child_height - child.margin_value;
        } else if (child.anchor_value == appAnchorBottomRight()) {
            child_x = inner.x + inner.width - child_width - child.margin_value;
            child_y = inner.y + inner.height - child_height - child.margin_value;
        }
        return Rectangle.xywh(child_x, child_y, child_width, child_height);
    }

    @[borrow_args]
    public fn appendStackChildren(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            let child_bounds = self.stackChildBounds(child, inner);
            out = child.appendChildrenTo(out, parent, child_bounds, theme);
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendStackChildrenWithWorld(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let pad = self.paddingOr(f32Zero());
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            let child_bounds = self.stackChildBounds(child, inner);
            out = child.appendChildrenToWithWorld(out, parent, child_bounds, theme, world);
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendScrollChildren(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        var out = tree;
        let index = out.nodeCount();
        out = out.add(parent, UiNode.scrollPanel(self.nodeId("scroll"), bounds, theme.surface)
            .withStroke(f32One(), theme.outline_variant)
            .withCornerRadius(theme.shape_medium));
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var cursor: f32 = pad - self.scroll_y_value;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            let child_height = self.childLayoutHeight(child, inner, theme, cursor, pad);
            let child_bounds = Rectangle.xywh(inner.x, bounds.y + cursor, child.widthOr(inner.width), child_height);
            if (child_bounds.y + child_bounds.height >= inner.y && child_bounds.y <= inner.y + inner.height) {
                out = child.appendChildrenTo(out, index, child_bounds, theme);
            }
            cursor = cursor + child_height + gap;
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendScrollChildrenWithWorld(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let index = out.nodeCount();
        out = out.add(parent, UiNode.scrollPanel(self.nodeId("scroll"), bounds, theme.surface)
            .withStroke(f32One(), theme.outline_variant)
            .withCornerRadius(theme.shape_medium));
        let pad = self.paddingOr(f32Zero());
        let gap = self.gapOr(theme.spacing_sm);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        var cursor: f32 = pad - self.scroll_y_value;
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            let child = self.child_nodes.get(i as i64);
            let child_height = self.childLayoutHeight(child, inner, theme, cursor, pad);
            let child_bounds = Rectangle.xywh(inner.x, bounds.y + cursor, child.widthOr(inner.width), child_height);
            if (child_bounds.y + child_bounds.height >= inner.y && child_bounds.y <= inner.y + inner.height) {
                out = child.appendChildrenToWithWorld(out, index, child_bounds, theme, world);
            }
            cursor = cursor + child_height + gap;
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendListChildrenWithWorld(&self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        var out = tree;
        let index = out.nodeCount();
        out = out.add(parent, UiNode.panel(self.nodeId("list"), bounds, theme.surface)
            .withStroke(f32One(), theme.outline_variant)
            .withCornerRadius(theme.shape_medium));
        let pad = self.paddingOr(theme.spacing_sm);
        let gap = self.gapOr(theme.spacing_xs);
        let inner = Rectangle.xywh(bounds.x + pad, bounds.y + pad, bounds.width - (pad * f32FromMilli(2000)), bounds.height - (pad * f32FromMilli(2000)));
        let item_height = self.item_height_value;
        let stride = item_height + gap;
        let total = world.stringListResourceCount(self.list_resource_id);
        // A resource-backed offset is the single source of truth for scrolling:
        // the wheel, touch drag and keyboard all write it, and rendering reads
        // it here, which is what keeps the view from snapping back to the top.
        var scroll_offset = self.scroll_y_value;
        if (self.scroll_offset_resource.len > 0) {
            scroll_offset = world.floatResource(self.scroll_offset_resource, self.scroll_y_value);
        }
        var first: i32 = 0;
        if (stride > f32Zero() && scroll_offset > f32Zero()) {
            first = (scroll_offset / stride) as i32;
            if (first > 0) { first = first - 1; }
        }
        if (first < 0) { first = 0; }
        if (first > total) { first = total; }
        var visible_count: i32 = total;
        if (stride > f32Zero()) {
            visible_count = (inner.height / stride) as i32 + 4;
        }
        if (visible_count < 1) { visible_count = 1; }
        var last = first + visible_count;
        if (last > total) { last = total; }
        var cursor: f32 = (f32FromInt(first) * stride) - scroll_offset;
        var i: i32 = first;
        while (i < last) {
            let item_bounds = Rectangle.xywh(inner.x, inner.y + cursor, inner.width, item_height);
            if (item_bounds.y + item_bounds.height >= inner.y && item_bounds.y <= inner.y + inner.height) {
                // Keep the retained node id identical to bindActionsInLayer:
                // keyed lists must survive inserts/reorders without moving a
                // focused row's action onto a different item.
                var suffix = format("%d", i as i64);
                if (self.list_key_resource.len > 0 && i < world.stringListResourceCount(self.list_key_resource)) {
                    let key = world.stringListResourceAt(self.list_key_resource, i);
                    if (key.len > 0) { suffix = key; }
                }
                let item_id = self.nodeId("list") + "." + suffix;
                let checked = world.boolListResourceAt(self.checked_list_resource_id, i);
                out = out.add(index, UiNode.checkbox(item_id, world.stringListResourceAt(self.list_resource_id, i), checked, item_bounds, theme));
            }
            cursor = cursor + item_height + gap;
            i = i + 1;
        }
        return out;
    }

    @[borrow_args]
    public fn appendLeafTo(&mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme) -> UiTree {
        if (self.kind == appViewCustom()) {
            return self.appendCustomTo(tree, parent, bounds);
        }
        if (self.kind == appViewRender()) {
            return tree.add(parent, UiNode.customRender(self.nodeId("render"), bounds, self.render_slot_id, self.hasCustomInteraction()));
        }
        if (self.kind == appViewText()) {
            return tree.add(parent, self.textNode(self.text_value, bounds, theme));
        }
        if (self.kind == appViewButton()) {
            return tree.add(parent, self.buttonNode(self.text_value, bounds, theme));
        }
        if (self.kind == appViewToggle()) {
            return tree.add(parent, self.toggleNode(self.text_value, self.checked_value, bounds, theme));
        }
        if (self.kind == appViewTextField()) {
            return tree.add(parent, self.textInputNode(self.text_value, bounds, theme));
        }
        if (self.kind == appViewSlider()) {
            return tree.add(parent, self.sliderNode(self.text_value, self.numeric_value, bounds, theme));
        }
        if (self.kind == appViewCheckbox()) {
            return tree.add(parent, self.checkboxNode(self.text_value, self.checked_value, bounds, theme));
        }
        if (self.kind == appViewProgress()) {
            return tree.add(parent, self.progressNode(self.text_value, self.numeric_value, bounds, theme));
        }
        if (self.kind == appViewDivider()) {
            return tree.add(parent, self.dividerNode(bounds, theme));
        }
        if (self.kind == appViewSpacer()) {
            return tree.add(parent, UiNode.spacer(self.nodeId("spacer"), bounds));
        }
        return tree;
    }

    @[borrow_args]
    public fn appendLeafToWithWorld(&mut self, tree: UiTree, parent: i32, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiTree {
        if (self.kind == appViewCustom()) {
            return self.appendCustomTo(tree, parent, bounds);
        }
        if (self.kind == appViewRender()) {
            return tree.add(parent, UiNode.customRender(self.nodeId("render"), bounds, self.render_slot_id, self.hasCustomInteraction()));
        }
        var text = self.text_value;
        if (self.text_resource_id.len > 0) {
            text = world.stringResource(self.text_resource_id, self.text_value);
        }
        if (self.kind == appViewText()) {
            return tree.add(parent, self.textNode(text, bounds, theme));
        }
        if (self.kind == appViewButton()) {
            return tree.add(parent, self.buttonNodeWithWorld(text, bounds, theme, world));
        }
        if (self.kind == appViewToggle()) {
            var checked = self.checked_value;
            if (self.bool_resource_id.len > 0) {
                checked = world.boolResource(self.bool_resource_id, self.checked_value);
            }
            return tree.add(parent, self.toggleNode(text, checked, bounds, theme));
        }
        if (self.kind == appViewTextField()) {
            return tree.add(parent, self.textInputNodeWithWorld(text, bounds, theme, world));
        }
        if (self.kind == appViewSlider()) {
            var value = self.numeric_value;
            if (self.float_resource_id.len > 0) {
                value = world.floatResource(self.float_resource_id, self.numeric_value);
            } else if (self.int_resource_id.len > 0) {
                value = f32FromInt(world.intResource(self.int_resource_id, self.numeric_value as i32));
            }
            return tree.add(parent, self.sliderNode(text, value, bounds, theme));
        }
        if (self.kind == appViewCheckbox()) {
            var checked = self.checked_value;
            if (self.bool_resource_id.len > 0) {
                checked = world.boolResource(self.bool_resource_id, self.checked_value);
            }
            return tree.add(parent, self.checkboxNode(text, checked, bounds, theme));
        }
        if (self.kind == appViewProgress()) {
            var value = self.numeric_value;
            if (self.float_resource_id.len > 0) {
                value = world.floatResource(self.float_resource_id, self.numeric_value);
            } else if (self.int_resource_id.len > 0) {
                value = f32FromInt(world.intResource(self.int_resource_id, self.numeric_value as i32));
            }
            return tree.add(parent, self.progressNode(text, value, bounds, theme));
        }
        if (self.kind == appViewDivider()) {
            return tree.add(parent, self.dividerNode(bounds, theme));
        }
        if (self.kind == appViewSpacer()) {
            return tree.add(parent, UiNode.spacer(self.nodeId("spacer"), bounds));
        }
        return tree;
    }

    @[borrow_args]
    public fn appendCustomTo(&self, tree: UiTree, parent: i32, bounds: Rectangle) -> UiTree {
        let node = UiNode.custom(self.nodeId("custom"), bounds, self.hasCustomInteraction());
        if (self.custom_views.len == 0) { return tree.add(parent, node); }
        return tree.addCustom(parent, node, self.custom_views.get(0 as i64).deref().dup());
    }

    @[borrow_args]
    public fn textNode(&mut self, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node: UiNode;
        if (self.text_style == appTextStyleMuted()) {
            node = UiNode.text(self.nodeId("text"), text, bounds, theme.muted_text);
        } else {
            node = UiNode.text(self.nodeId("text"), text, bounds, theme.text);
        }
        if (self.text_style == appTextStyleTitle()) {
            node = node.withPadding(theme.spacing_xs);
        }
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn buttonNode(&mut self, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node: UiNode;
        if (self.button_style == appButtonStyleOutlined()) {
            node = UiNode.outlinedButton(self.nodeId("button"), text, bounds, theme);
        } else if (self.button_style == appButtonStyleTonal()) {
            node = UiNode.tonalButton(self.nodeId("button"), text, bounds, theme);
        } else {
            node = UiNode.filledButton(self.nodeId("button"), text, bounds, theme);
        }
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn buttonNodeWithWorld(mut self, text: string, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiNode {
        var node = self.buttonNode(text, bounds, theme);
        let id = self.nodeId("button");
        let pressed = world.stringResource("ui.pressed", "");
        let hovered = world.stringResource("ui.hovered", "");
        if (pressed == id) {
            node = node.withOverlay(colorRgbaMilli(0, 0, 0, 160));
        } else if (hovered == id) {
            node = node.withOverlay(colorRgbaMilli(1000, 1000, 1000, 160));
        }
        return node;
    }

    @[borrow_args]
    public fn toggleNode(mut self, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.toggle(self.nodeId("toggle"), text, checked, bounds, theme);
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn textInputNode(mut self, text: string, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.textInput(self.nodeId("textfield"), text, self.placeholder_value, bounds, theme);
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn textInputNodeWithWorld(mut self, text: string, bounds: Rectangle, theme: UiTheme, world: AppWorld) -> UiNode {
        var node = self.textInputNode(text, bounds, theme);
        let id = self.nodeId("textfield");
        if (world.focusedId() == id) {
            let composition = world.textInputCompositionForViewId(id);
            if (composition.len > 0) {
                node = node.withCompositionRange(composition, world.textInputCompositionStartForViewId(id), world.textInputCompositionLengthForViewId(id)).withTextColor(theme.text);
            }
            let blink = world.intResource("ui.caret.blink.phase.ms", 0);
            node = node.withStroke(f32FromMilli(2000), theme.primary);
            node = node.withOverlay(theme.focusOverlay(theme.primary));
            node = node.withCaret(blink < 500, theme.primary);
        } else if (world.stringResource("ui.hovered", "") == id) {
            node = node.withOverlay(theme.hoverOverlay(theme.primary));
        } else {
            node = node.withOverlay(colorTransparent());
        }
        return node;
    }

    @[borrow_args]
    public fn sliderNode(mut self, text: string, value: f32, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.slider(self.nodeId("slider"), text, value, self.min_value, self.max_value, bounds, theme);
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn checkboxNode(mut self, text: string, checked: bool, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.checkbox(self.nodeId("checkbox"), text, checked, bounds, theme);
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    @[borrow_args]
    public fn progressNode(mut self, text: string, value: f32, bounds: Rectangle, theme: UiTheme) -> UiNode {
        var node = UiNode.progress(self.nodeId("progress"), text, value, self.min_value, self.max_value, bounds, theme);
        node = self.applyNodeStyle(node, theme);
        if (!self.enabled_value) { node = node.themedDisabled(theme); }
        return node;
    }

    public fn nodeId(&self, fallback: string) -> string {
        if (self.id_value.len > 0) { return self.id_value; }
        return fallback;
    }

    public fn widthOr(&self, fallback: f32) -> f32 {
        var out = fallback;
        if (self.width_value > f32Zero()) { out = self.width_value; }
        return self.clampWidth(out);
    }

    public fn heightOr(&self, fallback: f32) -> f32 {
        var out = fallback;
        if (self.height_value > f32Zero()) { out = self.height_value; }
        return self.clampHeight(out);
    }

    public fn paddingOr(&self, fallback: f32) -> f32 {
        if (self.has_padding_value || self.padding_value > f32Zero()) { return self.padding_value; }
        return fallback;
    }

    public fn gapOr(&self, fallback: f32) -> f32 {
        if (self.has_gap_value || self.gap_value > f32Zero()) { return self.gap_value; }
        return fallback;
    }

    public fn destroy(&mut self) {
        var custom_view_i: i32 = 0;
        while (custom_view_i < (self.custom_views.len as i32)) {
            self.custom_views.get(custom_view_i as i64).drop();
            custom_view_i = custom_view_i + 1;
        }
        self.custom_views.destroy();
        var i: i32 = 0;
        while (i < (self.child_nodes.len as i32)) {
            var child = self.child_nodes.get(i as i64);
            child.destroy();
            i = i + 1;
        }
        self.child_nodes.destroy();
    }
}

public class Text {
    public static fn create(value: string) -> View {
        return View.text(value);
    }

    public static fn bound(resource_id: string, fallback: string) -> View {
        return View.text(fallback).bindText(resource_id);
    }

    public static fn title(value: string) -> View {
        return View.text(value).title();
    }

    public static fn body(value: string) -> View {
        return View.text(value).body();
    }

    public static fn muted(value: string) -> View {
        return View.text(value).muted();
    }

    public static fn titleBound(resource_id: string, fallback: string) -> View {
        return View.text(fallback).title().bindText(resource_id);
    }

    public static fn bodyBound(resource_id: string, fallback: string) -> View {
        return View.text(fallback).body().bindText(resource_id);
    }

    public static fn mutedBound(resource_id: string, fallback: string) -> View {
        return View.text(fallback).muted().bindText(resource_id);
    }
}

