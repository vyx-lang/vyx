    public static fn panel() -> View {
        var out = View.create(appViewPanel());
        out.padding_value = f32FromMilli(12000);
        out.gap_value = f32FromMilli(8000);
        return out;
    }

    public static fn stack() -> View {
        var out = View.create(appViewStack());
        out.padding_value = f32Zero();
        out.gap_value = f32Zero();
        return out;
