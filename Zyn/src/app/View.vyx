public class IconButton {
    public static fn filled(id: string, icon: string, action_name: string) -> View {
        return Button.filledAction(id, icon, action_name)
            .size(f32FromMilli(40000), f32FromMilli(40000))
            .textCenter()
            .accessibilityLabel(icon);
    }

    public static fn tonal(id: string, icon: string, action_name: string) -> View {
        return Button.tonalAction(id, icon, action_name)
            .size(f32FromMilli(40000), f32FromMilli(40000))
            .textCenter()
            .accessibilityLabel(icon);
    }

    public static fn outlined(id: string, icon: string, action_name: string) -> View {
        return Button.outlinedAction(id, icon, action_name)
            .size(f32FromMilli(40000), f32FromMilli(40000))
            .textCenter()
            .accessibilityLabel(icon);
    }
}
