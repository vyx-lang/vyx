use uiTextAlignCenter = Zyn.UI.uiTextAlignCenter;
use uiTextAlignRight = Zyn.UI.uiTextAlignRight;
use std.collections;

public fn appColorRoleNone() -> i32 { return 0; }
public fn appColorRoleBackground() -> i32 { return 1; }
public fn appColorRoleSurface() -> i32 { return 2; }
public fn appColorRoleSurfaceVariant() -> i32 { return 3; }
public fn appColorRoleText() -> i32 { return 4; }
public fn appColorRoleMutedText() -> i32 { return 5; }
public fn appColorRolePrimary() -> i32 { return 6; }
public fn appColorRoleOnPrimary() -> i32 { return 7; }
public fn appColorRolePrimaryContainer() -> i32 { return 8; }
public fn appColorRoleOnPrimaryContainer() -> i32 { return 9; }
public fn appColorRoleSecondary() -> i32 { return 10; }
public fn appColorRoleOnSecondary() -> i32 { return 11; }
public fn appColorRoleSecondaryContainer() -> i32 { return 12; }
public fn appColorRoleOnSecondaryContainer() -> i32 { return 13; }
public fn appColorRoleError() -> i32 { return 14; }
public fn appColorRoleOnError() -> i32 { return 15; }
public fn appColorRoleOutline() -> i32 { return 16; }
public fn appColorRoleOutlineVariant() -> i32 { return 17; }

public fn appColorRoleValue(role: i32, theme: UiTheme) -> Color {
    if (role == appColorRoleBackground()) { return theme.background; }
    if (role == appColorRoleSurface()) { return theme.surface; }
    if (role == appColorRoleSurfaceVariant()) { return theme.surface_variant; }
    if (role == appColorRoleText()) { return theme.text; }
    if (role == appColorRoleMutedText()) { return theme.muted_text; }
    if (role == appColorRolePrimary()) { return theme.primary; }
    if (role == appColorRoleOnPrimary()) { return theme.on_primary; }
    if (role == appColorRolePrimaryContainer()) { return theme.primary_container; }
    if (role == appColorRoleOnPrimaryContainer()) { return theme.on_primary_container; }
    if (role == appColorRoleSecondary()) { return theme.secondary; }
    if (role == appColorRoleOnSecondary()) { return theme.on_secondary; }
    if (role == appColorRoleSecondaryContainer()) { return theme.secondary_container; }
    if (role == appColorRoleOnSecondaryContainer()) { return theme.on_secondary_container; }
    if (role == appColorRoleError()) { return theme.error_color; }
    if (role == appColorRoleOnError()) { return theme.on_error_color; }
    if (role == appColorRoleOutline()) { return theme.outline; }
    if (role == appColorRoleOutlineVariant()) { return theme.outline_variant; }
    return colorTransparent();
}

public class View {
    public kind: i32;
    public id_value: string;
    public text_value: string;
    public text_resource_id: string;
    public placeholder_value: string;
    public action_name: string;
    public text_input_action_name: string;
    public hover_action_name: string;
    public hover_enter_action_name: string;
    public hover_exit_action_name: string;
    public pointer_down_action_name: string;
    public pointer_up_action_name: string;
    public pointer_move_action_name: string;
    public pointer_scroll_action_name: string;
    public pointer_drag_action_name: string;
    public capture_action_name: string;
    public bubble_action_name: string;
    public key_action_name: string;
    public layer_id_value: string;
    public scroll_offset_resource: string;
    public scroll_extent_value: f32;
    public bool_resource_id: string;
    public int_resource_id: string;
    public float_resource_id: string;
    public list_resource_id: string;
    public checked_list_resource_id: string;
    public item_action_prefix: string;
    public list_key_resource: string;
    public checked_value: bool;
    public numeric_value: f32;
    public min_value: f32;
    public max_value: f32;
    public button_style: i32;
    public text_style: i32;
    public background_role: i32;
    public text_color_role: i32;
    public stroke_color_role: i32;
    public has_background_color: bool;
    public background_color: Color;
    public has_text_color: bool;
    public text_color: Color;
    public has_stroke_color: bool;
    public stroke_color: Color;
    public stroke_width_value: f32;
    public corner_radius_value: f32;
    public elevation_value: f32;
    public main_align_value: i32;
    public cross_align_value: i32;
    public anchor_value: i32;
    public margin_value: f32;
    public text_align_value: i32;
    public visible_value: bool;
    public enabled_value: bool;
    public accessibility_role: string;
    public accessibility_label: string;
    public accessibility_hint: string;
    public width_value: f32;
    public height_value: f32;
    public min_width_value: f32;
    public max_width_value: f32;
    public min_height_value: f32;
    public max_height_value: f32;
    public flex_value: f32;
    public auto_height_value: bool;
    // Explicit opt-in for a container that consumes the remaining parent
    // extent.  A container with neither this nor an explicit height measures
    // its children, which keeps composite controls composable by default.
    public fill_height_value: bool;
    public padding_value: f32;
    public gap_value: f32;
    public has_padding_value: bool;
    public has_gap_value: bool;
    public scroll_y_value: f32;
    public columns_value: i32;
    public min_item_width_value: f32;
    public item_width_value: f32;
    public item_height_value: f32;
    private child_nodes: Vec<View>;
    private custom_views: Vec<Box<dyn CustomView>>;
    public render_slot_id: i32;

    public static fn create(kind: i32) -> View {
        return View {
            kind: kind,
            id_value: "",
            text_value: "",
            text_resource_id: "",
            placeholder_value: "",
            action_name: "",
            text_input_action_name: "",
            hover_action_name: "",
            hover_enter_action_name: "",
            hover_exit_action_name: "",
            pointer_down_action_name: "",
            pointer_up_action_name: "",
            pointer_move_action_name: "",
            pointer_scroll_action_name: "",
            pointer_drag_action_name: "",
            capture_action_name: "",
            bubble_action_name: "",
            key_action_name: "",
            layer_id_value: "",
            scroll_offset_resource: "",
            scroll_extent_value: f32Zero(),
            bool_resource_id: "",
            int_resource_id: "",
            float_resource_id: "",
            list_resource_id: "",
            checked_list_resource_id: "",
            item_action_prefix: "",
            list_key_resource: "",
            checked_value: false,
            numeric_value: f32Zero(),
            min_value: f32Zero(),
            max_value: f32FromMilli(100000),
            button_style: appButtonStyleFilled(),
            text_style: appTextStyleBody(),
            background_role: appColorRoleNone(),
            text_color_role: appColorRoleNone(),
            stroke_color_role: appColorRoleNone(),
            has_background_color: false,
            background_color: colorTransparent(),
            has_text_color: false,
            text_color: colorBlack(),
            has_stroke_color: false,
            stroke_color: colorTransparent(),
            stroke_width_value: f32FromMilli(-1000),
            corner_radius_value: f32FromMilli(-1000),
            elevation_value: f32Zero(),
            main_align_value: appAlignStart(),
            cross_align_value: appAlignStretch(),
            anchor_value: appAnchorFlow(),
            margin_value: f32Zero(),
            text_align_value: appTextAlignLeft(),
            visible_value: true,
            enabled_value: true,
            accessibility_role: "",
            accessibility_label: "",
            accessibility_hint: "",
            width_value: f32Zero(),
            height_value: f32Zero(),
            min_width_value: f32Zero(),
            max_width_value: f32Zero(),
            min_height_value: f32Zero(),
            max_height_value: f32Zero(),
            flex_value: f32Zero(),
            auto_height_value: false,
            fill_height_value: false,
            padding_value: f32Zero(),
            gap_value: f32Zero(),
            has_padding_value: false,
            has_gap_value: false,
            scroll_y_value: f32Zero(),
            columns_value: 0,
            min_item_width_value: f32Zero(),
            item_width_value: f32Zero(),
            item_height_value: f32FromMilli(40000),
            child_nodes: Vec::<View>.new(),
            custom_views: Vec::<Box<dyn CustomView>>.new(),
            render_slot_id: -1
        };
    }

    public static fn column() -> View {
        var out = View.create(appViewColumn());
        out.padding_value = f32Zero();
        out.gap_value = f32Zero();
        return out;
    }

    public static fn row() -> View {
        var out = View.create(appViewRow());
        out.padding_value = f32Zero();
        out.gap_value = f32Zero();
        return out;
    }

    public static fn text(value: string) -> View {
        var out = View.create(appViewText());
        out.text_value = value;
        out.accessibility_role = "text";
        out.accessibility_label = value;
        out.text_style = appTextStyleBody();
        out.height_value = f32FromMilli(28000);
        return out;
    }

    public static fn button(value: string) -> View {
        var out = View.create(appViewButton());
        out.text_value = value;
        out.accessibility_role = "button";
        out.accessibility_label = value;
        out.button_style = appButtonStyleFilled();
        out.height_value = f32FromMilli(40000);
        return out;
    }

    public static fn toggle(value: string) -> View {
        var out = View.create(appViewToggle());
        out.text_value = value;
