        return View.customRender(id, slot_id);
    }
}

public class Toolbar {
    public static fn title(id: string, title: string) -> View {
        return Row.create()
            .id(id)
            .height(f32FromMilli(56000))
            .gap(f32FromMilli(12000))
            .alignCenter()
            .child(Text.title(title).id(id + ".title").expanded());
    }

    @[borrow_args]
    public static fn actions(id: string, title: string, actions: Vec<View>) -> View {
        return Row.create()
            .id(id)
            .height(f32FromMilli(56000))
            .gap(f32FromMilli(12000))
            .alignCenter()
            .child(Text.title(title).id(id + ".title").expanded())
            .child(Row.create()
                .id(id + ".actions")
                .height(f32FromMilli(40000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .children(actions));
    }

    @[borrow_args]
    public static fn leadingActions(id: string, leading: View, title: string, actions: Vec<View>) -> View {
        return Row.create()
            .id(id)
            .height(f32FromMilli(56000))
            .gap(f32FromMilli(12000))
            .alignCenter()
            .child(leading)
            .child(Text.title(title).id(id + ".title").expanded())
            .child(Row.create()
                .id(id + ".actions")
                .height(f32FromMilli(40000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .children(actions));
    }
}

public class Split {
    public static fn horizontal(leading: View, trailing: View) -> View {
        return Row.create()
            .gap(f32Zero())
            .child(leading)
            .child(trailing.expanded());
    }

    public static fn horizontalWeighted(leading: View, leading_weight: f32, trailing: View, trailing_weight: f32) -> View {
        return Row.create()
            .gap(f32Zero())
            .child(leading.flex(leading_weight))
            .child(trailing.flex(trailing_weight));
    }

    public static fn vertical(top: View, bottom: View) -> View {
        return Column.create()
            .gap(f32Zero())
            .child(top)
            .child(bottom.expanded());
    }

    public static fn verticalWeighted(top: View, top_weight: f32, bottom: View, bottom_weight: f32) -> View {
        return Column.create()
            .gap(f32Zero())
            .child(top.flex(top_weight))
            .child(bottom.flex(bottom_weight));
    }
}

public class Dock {
    public static fn fill(content: View) -> View {
        return Stack.create().child(content.anchorFill());
