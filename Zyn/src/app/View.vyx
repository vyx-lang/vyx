// App-level entry point for application-owned 2D drawing. The CustomView
// value is created by Component.view(world); actions use the usual View
// bindings, so recorded interactions remain ordinary AppActions.
public class CanvasView {
    public static fn create(id: string, custom_view: Box<dyn CustomView>) -> View {
        return View.custom(id, custom_view);
    }
}

