    public static fn scroll() -> View {
        var out = View.create(appViewScroll());
        out.padding_value = f32Zero();
        out.gap_value = f32FromMilli(8000);
        return out;
    }

    public static fn spacer() -> View {
        var out = View.create(appViewSpacer());
        out.height_value = f32FromMilli(8000);
