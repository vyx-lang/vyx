module Zyn.App;

use std.collections;
use Color = Zyn.Nut.Types.Color;
use UiTheme = Zyn.UI.UiTheme;

// ---------------------------------------------------------------------------
// ZC-11 adaptive interface
//
// The point of this module is that "responsive" is a *measurement*, not a pile
// of magic numbers scattered through the views. One `AppViewport` is computed
// per frame from the window size, the pixel scale and the platform safe area;
// every adaptive decision then reads that snapshot. A view that switches from a
// row to a column does not ask "is the window narrow?" - it asks the viewport,
// and the same question has the same answer everywhere.
//
// Two constraints from the roadmap shape the API:
//
//   * text scaling and locale switching must not truncate primary actions.
//     `AppTextScale` scales the typography tokens (never the layout width), and
//     `AppActionBar` keeps the primary actions pinned while secondary ones fold
//     into an overflow menu - so growing the font costs the *secondary* row, not
//     the buttons the user actually needs.
//
//   * safe areas are insets, not padding. `View.padding` is uniform, so an
//     exact per-edge inset is composed from spacers in `AppSafeArea.apply`,
//     which keeps the layout correct on a notched or gesture-bar display.
//
// Nothing here adds a new `appView*` kind: every helper composes the primitives
// the renderer already knows (Column / Row / Spacer / Stack), which is what
// keeps the adaptive layer from forking the layout engine.
// ---------------------------------------------------------------------------

// Width classes. Compact is a phone, medium a small tablet or a narrow desktop
// window, expanded a full desktop window. The names are the standard ones so a
// reader coming from another toolkit is not surprised.
public fn appSizeClassCompact() -> i32 { return 0; }
public fn appSizeClassMedium() -> i32 { return 1; }
public fn appSizeClassExpanded() -> i32 { return 2; }

// Height classes. Regular is the normal case; compact is the landscape phone
// where vertical chrome has to give way.
public fn appHeightClassCompact() -> i32 { return 0; }
public fn appHeightClassRegular() -> i32 { return 1; }

public fn appOrientationPortrait() -> i32 { return 0; }
public fn appOrientationLandscape() -> i32 { return 1; }

public fn appDensityCompact() -> i32 { return 0; }
public fn appDensityRegular() -> i32 { return 1; }
public fn appDensityComfortable() -> i32 { return 2; }

// Navigation presentation for the current size class: a bottom bar on compact,
// a rail on medium, a full drawer on expanded.
public fn appNavModeBar() -> i32 { return 0; }
public fn appNavModeRail() -> i32 { return 1; }
public fn appNavModeDrawer() -> i32 { return 2; }

// Motion preference. Reduced keeps state changes but removes the travel;
// none drops the animation entirely. Both are read from the same place so a
// transition never has to guess.
public fn appMotionFull() -> i32 { return 0; }
public fn appMotionReduced() -> i32 { return 1; }
public fn appMotionNone() -> i32 { return 2; }

// ---------------------------------------------------------------------------
// Insets
// ---------------------------------------------------------------------------

public class AppInsets {
    public top: f32;
    public right: f32;
    public bottom: f32;
    public left: f32;

    public static fn zero() -> AppInsets {
        return AppInsets { top: 0.0, right: 0.0, bottom: 0.0, left: 0.0 };
    }

    public static fn all(value: f32) -> AppInsets {
        return AppInsets { top: value, right: value, bottom: value, left: value };
    }

    public static fn xy(horizontal: f32, vertical: f32) -> AppInsets {
        return AppInsets { top: vertical, right: horizontal, bottom: vertical, left: horizontal };
    }

    public static fn trbl(top: f32, right: f32, bottom: f32, left: f32) -> AppInsets {
        return AppInsets { top: top, right: right, bottom: bottom, left: left };
    }

    public fn horizontal(&self) -> f32 {
        return self.left + self.right;
    }

    public fn vertical(&self) -> f32 {
        return self.top + self.bottom;
    }

    public fn isZero(&self) -> bool {
        return self.top == 0.0 && self.right == 0.0 && self.bottom == 0.0 && self.left == 0.0;
    }

    public fn clone(&self) -> AppInsets {
        return AppInsets { top: self.top, right: self.right, bottom: self.bottom, left: self.left };
    }

    public fn dup(&self) -> AppInsets {
        return self.clone();
    }
}

// ---------------------------------------------------------------------------
// Breakpoints
// ---------------------------------------------------------------------------

public class AppBreakpoints {
    public compact_max: f32;
    public expanded_min: f32;
    public regular_height_min: f32;

    public static fn standard() -> AppBreakpoints {
        return AppBreakpoints {
            compact_max: 600.0,
            expanded_min: 840.0,
            regular_height_min: 480.0
        };
    }

    public static fn of(compact_max: f32, expanded_min: f32, regular_height_min: f32) -> AppBreakpoints {
        return AppBreakpoints {
            compact_max: compact_max,
            expanded_min: expanded_min,
            regular_height_min: regular_height_min
        };
    }

    public fn sizeClassFor(&self, width: f32) -> i32 {
        if (width < self.compact_max) { return appSizeClassCompact(); }
        if (width >= self.expanded_min) { return appSizeClassExpanded(); }
        return appSizeClassMedium();
    }

    public fn heightClassFor(&self, height: f32) -> i32 {
        if (height < self.regular_height_min) { return appHeightClassCompact(); }
        return appHeightClassRegular();
    }

    public fn isCompact(&self, width: f32) -> bool {
        return self.sizeClassFor(width) == appSizeClassCompact();
    }

    public fn clone(&self) -> AppBreakpoints {
        return AppBreakpoints {
            compact_max: self.compact_max,
            expanded_min: self.expanded_min,
            regular_height_min: self.regular_height_min
        };
    }

    public fn dup(&self) -> AppBreakpoints {
        return self.clone();
    }
}

// ---------------------------------------------------------------------------
// Viewport
// ---------------------------------------------------------------------------

public class AppViewport {
    public width: f32;
    public height: f32;
    public scale: f32;
    public orientation: i32;
    public size_class: i32;
    public height_class: i32;
    public insets: AppInsets;

    public static fn of(width: f32, height: f32, scale: f32, insets: AppInsets) -> AppViewport {
        let breakpoints = AppBreakpoints.standard();
        var orientation = appOrientationPortrait();
        if (width > height) { orientation = appOrientationLandscape(); }
        var safe_scale = scale;
        if (safe_scale <= 0.0) { safe_scale = 1.0; }
        return AppViewport {
            width: width,
            height: height,
            scale: safe_scale,
            orientation: orientation,
            size_class: breakpoints.sizeClassFor(width),
            height_class: breakpoints.heightClassFor(height),
            insets: insets.dup()
        };
    }

    public static fn create(width: f32, height: f32) -> AppViewport {
        return AppViewport.of(width, height, 1.0, AppInsets.zero());
    }

    public fn contentWidth(&self) -> f32 {
        var out = self.width - self.insets.horizontal();
        if (out < 0.0) { out = 0.0; }
        return out;
    }

    public fn contentHeight(&self) -> f32 {
        var out = self.height - self.insets.vertical();
        if (out < 0.0) { out = 0.0; }
        return out;
    }

    public fn isCompact(&self) -> bool { return self.size_class == appSizeClassCompact(); }
    public fn isMedium(&self) -> bool { return self.size_class == appSizeClassMedium(); }
    public fn isExpanded(&self) -> bool { return self.size_class == appSizeClassExpanded(); }
    public fn isLandscape(&self) -> bool { return self.orientation == appOrientationLandscape(); }
    public fn isShort(&self) -> bool { return self.height_class == appHeightClassCompact(); }

    // The pixel scale drives density, but density is a *decision*, not a
    // measurement: a 2x display on a large window wants comfortable spacing, a
    // 2x display on a phone wants compact spacing.
    public fn density(&self) -> i32 {
        if (self.isExpanded() && self.scale >= 1.5) { return appDensityComfortable(); }
        if (self.isCompact() || self.isShort()) { return appDensityCompact(); }
        return appDensityRegular();
    }

    public fn navMode(&self) -> i32 {
        if (self.isCompact()) { return appNavModeBar(); }
        if (self.isMedium()) { return appNavModeRail(); }
        return appNavModeDrawer();
    }

    public fn clone(&self) -> AppViewport {
        return AppViewport {
            width: self.width,
            height: self.height,
            scale: self.scale,
            orientation: self.orientation,
            size_class: self.size_class,
            height_class: self.height_class,
            insets: self.insets.dup()
        };
    }

    public fn dup(&self) -> AppViewport {
        return self.clone();
    }
}

// A viewport is published into resources once per frame so that a pure
// `Component.view(world)` can read it without being handed a second argument.
public class AppViewportStore {
    public static fn widthKey(owner: string) -> string { return "viewport:" + owner + ":width"; }
    public static fn heightKey(owner: string) -> string { return "viewport:" + owner + ":height"; }
    public static fn scaleKey(owner: string) -> string { return "viewport:" + owner + ":scale"; }
    public static fn orientationKey(owner: string) -> string { return "viewport:" + owner + ":orientation"; }
    public static fn sizeClassKey(owner: string) -> string { return "viewport:" + owner + ":size_class"; }
    public static fn heightClassKey(owner: string) -> string { return "viewport:" + owner + ":height_class"; }
    public static fn insetTopKey(owner: string) -> string { return "viewport:" + owner + ":inset_top"; }
    public static fn insetRightKey(owner: string) -> string { return "viewport:" + owner + ":inset_right"; }
    public static fn insetBottomKey(owner: string) -> string { return "viewport:" + owner + ":inset_bottom"; }
    public static fn insetLeftKey(owner: string) -> string { return "viewport:" + owner + ":inset_left"; }

    public static fn publish(world: AppWorld, owner: string, viewport: AppViewport) -> AppWorld {
        if (owner.len == 0) { return world; }
        var out = world.setFloatResource(AppViewportStore.widthKey(owner), viewport.width);
        out = out.setFloatResource(AppViewportStore.heightKey(owner), viewport.height);
        out = out.setFloatResource(AppViewportStore.scaleKey(owner), viewport.scale);
        out = out.setIntResource(AppViewportStore.orientationKey(owner), viewport.orientation);
        out = out.setIntResource(AppViewportStore.sizeClassKey(owner), viewport.size_class);
        out = out.setIntResource(AppViewportStore.heightClassKey(owner), viewport.height_class);
        out = out.setFloatResource(AppViewportStore.insetTopKey(owner), viewport.insets.top);
        out = out.setFloatResource(AppViewportStore.insetRightKey(owner), viewport.insets.right);
        out = out.setFloatResource(AppViewportStore.insetBottomKey(owner), viewport.insets.bottom);
        out = out.setFloatResource(AppViewportStore.insetLeftKey(owner), viewport.insets.left);
        return out;
    }

    public static fn read(world: AppWorld, owner: string) -> AppViewport {
        let width = world.floatResource(AppViewportStore.widthKey(owner), 0.0);
        let height = world.floatResource(AppViewportStore.heightKey(owner), 0.0);
        let scale = world.floatResource(AppViewportStore.scaleKey(owner), 1.0);
        let insets = AppInsets.trbl(
            world.floatResource(AppViewportStore.insetTopKey(owner), 0.0),
            world.floatResource(AppViewportStore.insetRightKey(owner), 0.0),
            world.floatResource(AppViewportStore.insetBottomKey(owner), 0.0),
            world.floatResource(AppViewportStore.insetLeftKey(owner), 0.0)
        );
        var out = AppViewport.of(width, height, scale, insets);
        // of() recomputes the classes from the size, but a caller may have
        // published a class that came from the real window rather than from the
        // logical size - keep the published value when it is present.
        let published_class = world.intResource(AppViewportStore.sizeClassKey(owner), -1);
        if (published_class >= 0) { out.size_class = published_class; }
        let published_height_class = world.intResource(AppViewportStore.heightClassKey(owner), -1);
        if (published_height_class >= 0) { out.height_class = published_height_class; }
        return out;
    }
}

// ---------------------------------------------------------------------------
// Responsive selection
// ---------------------------------------------------------------------------

// Typed because Vyx has no generic value return: four small functions beat one
// function with an `any` that every call site has to unwrap.
public class AppResponsive {
    public static fn pickI32(viewport: AppViewport, compact: i32, medium: i32, expanded: i32) -> i32 {
        if (viewport.size_class == appSizeClassCompact()) { return compact; }
        if (viewport.size_class == appSizeClassMedium()) { return medium; }
        return expanded;
    }

    public static fn pickF32(viewport: AppViewport, compact: f32, medium: f32, expanded: f32) -> f32 {
        if (viewport.size_class == appSizeClassCompact()) { return compact; }
        if (viewport.size_class == appSizeClassMedium()) { return medium; }
        return expanded;
    }

    public static fn pickString(viewport: AppViewport, compact: string, medium: string, expanded: string) -> string {
        if (viewport.size_class == appSizeClassCompact()) { return compact; }
        if (viewport.size_class == appSizeClassMedium()) { return medium; }
        return expanded;
    }

    public static fn pickBool(viewport: AppViewport, compact: bool, medium: bool, expanded: bool) -> bool {
        if (viewport.size_class == appSizeClassCompact()) { return compact; }
        if (viewport.size_class == appSizeClassMedium()) { return medium; }
        return expanded;
    }

    // The single question the layout helpers ask. Kept as a function rather
    // than inlined so that changing the rule is a one-line change.
    public static fn isStacked(viewport: AppViewport) -> bool {
        return viewport.size_class == appSizeClassCompact();
    }
}

// ---------------------------------------------------------------------------
// Text scaling
// ---------------------------------------------------------------------------

// Accessibility text size. Scaling the *typography* tokens and the control
// height (so a taller line is still hit-testable) is the part that must work;
// scaling the window is the part that must not happen, because that is what
// makes a large-font layout overflow.
public class AppTextScale {
    public static fn factorKey(owner: string) -> string { return "textscale:" + owner; }

    public static fn clampFactor(factor: f32) -> f32 {
        var out = factor;
        if (out < 0.85) { out = 0.85; }
        if (out > 2.0) { out = 2.0; }
        return out;
    }

    public static fn setFactor(world: AppWorld, owner: string, factor: f32) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setFloatResource(AppTextScale.factorKey(owner), AppTextScale.clampFactor(factor));
    }

    public static fn factor(world: AppWorld, owner: string) -> f32 {
        return AppTextScale.clampFactor(world.floatResource(AppTextScale.factorKey(owner), 1.0));
    }

    public static fn applyToTheme(theme: UiTheme, factor: f32) -> UiTheme {
        let scale = AppTextScale.clampFactor(factor);
        if (scale == 1.0) { return theme; }
        var out = theme.clone();
        out.typography_label = out.typography_label * scale;
        out.typography_body = out.typography_body * scale;
        out.typography_title = out.typography_title * scale;
        // A taller font needs a taller hit target or the control starts to clip
        // its own label; the growth is deliberately gentler than the font.
        out.control_height = out.control_height * (1.0 + (scale - 1.0) * 0.6);
        return out;
    }

    public static fn themeFor(world: AppWorld, owner: string, base: UiTheme) -> UiTheme {
        return AppTextScale.applyToTheme(base, AppTextScale.factor(world, owner));
    }
}

// ---------------------------------------------------------------------------
// Safe areas
// ---------------------------------------------------------------------------

public class AppSafeArea {
    public static fn topKey(owner: string) -> string { return "safearea:" + owner + ":top"; }
    public static fn rightKey(owner: string) -> string { return "safearea:" + owner + ":right"; }
    public static fn bottomKey(owner: string) -> string { return "safearea:" + owner + ":bottom"; }
    public static fn leftKey(owner: string) -> string { return "safearea:" + owner + ":left"; }

    public static fn publish(world: AppWorld, owner: string, insets: AppInsets) -> AppWorld {
        if (owner.len == 0) { return world; }
        var out = world.setFloatResource(AppSafeArea.topKey(owner), insets.top);
        out = out.setFloatResource(AppSafeArea.rightKey(owner), insets.right);
        out = out.setFloatResource(AppSafeArea.bottomKey(owner), insets.bottom);
        out = out.setFloatResource(AppSafeArea.leftKey(owner), insets.left);
        return out;
    }

    public static fn read(world: AppWorld, owner: string) -> AppInsets {
        return AppInsets.trbl(
            world.floatResource(AppSafeArea.topKey(owner), 0.0),
            world.floatResource(AppSafeArea.rightKey(owner), 0.0),
            world.floatResource(AppSafeArea.bottomKey(owner), 0.0),
            world.floatResource(AppSafeArea.leftKey(owner), 0.0)
        );
    }

    // Exact per-edge inset. `View.padding` is uniform, so each edge is realised
    // with a spacer on the correct side of a zero-gap Column / Row. Nesting four
    // uniform paddings would have added every edge four times; this adds each
    // one once.
    public static fn apply(content: View, insets: AppInsets) -> View {
        if (insets.isZero()) { return content; }
        var inner = content;
        if (insets.top > 0.0) {
            inner = Column.create()
                .gap(0.0)
                .child(Spacer.vertical(insets.top))
                .child(inner);
        }
        if (insets.bottom > 0.0) {
            inner = Column.create()
                .gap(0.0)
                .child(inner)
                .child(Spacer.vertical(insets.bottom));
        }
        if (insets.left > 0.0) {
            inner = Row.create()
                .gap(0.0)
                .child(Spacer.horizontal(insets.left))
                .child(inner.expanded());
        }
        if (insets.right > 0.0) {
            inner = Row.create()
                .gap(0.0)
                .child(inner.expanded())
                .child(Spacer.horizontal(insets.right));
        }
        return inner;
    }

    public static fn applyFrom(world: AppWorld, owner: string, content: View) -> View {
        return AppSafeArea.apply(content, AppSafeArea.read(world, owner));
    }
}

// ---------------------------------------------------------------------------
// Resizable split
// ---------------------------------------------------------------------------

// A split is one number: the leading pane's share. Keeping it in a resource
// means the divider survives a rebuild, and clamping it in one place means a
// window resize can never squeeze a pane below its minimum.
public class AppSplitView {
    public static fn ratioKey(owner: string) -> string { return "split:" + owner + ":ratio"; }
    public static fn minLeadingKey(owner: string) -> string { return "split:" + owner + ":min_leading"; }
    public static fn minTrailingKey(owner: string) -> string { return "split:" + owner + ":min_trailing"; }

    public static fn declare(world: AppWorld, owner: string, ratio: f32, min_leading: f32, min_trailing: f32) -> AppWorld {
        if (owner.len == 0) { return world; }
        var out = world.setFloatResource(AppSplitView.ratioKey(owner), AppSplitView.clampRatio(ratio, 0.0, min_leading, min_trailing));
        out = out.setFloatResource(AppSplitView.minLeadingKey(owner), min_leading);
        out = out.setFloatResource(AppSplitView.minTrailingKey(owner), min_trailing);
        return out;
    }

    public static fn ratio(world: AppWorld, owner: string) -> f32 {
        return world.floatResource(AppSplitView.ratioKey(owner), 0.32);
    }

    public static fn minLeading(world: AppWorld, owner: string) -> f32 {
        return world.floatResource(AppSplitView.minLeadingKey(owner), 180.0);
    }

    public static fn minTrailing(world: AppWorld, owner: string) -> f32 {
        return world.floatResource(AppSplitView.minTrailingKey(owner), 320.0);
    }

    // `total` is the usable extent along the split axis. A ratio that would put
    // either pane under its minimum is pulled back to the nearest legal value;
    // when the two minimums cannot both be met the leading pane keeps its own
    // minimum and the trailing pane absorbs the shortfall.
    public static fn clampRatio(ratio: f32, total: f32, min_leading: f32, min_trailing: f32) -> f32 {
        if (total <= 0.0) { return ratio; }
        var lo = min_leading / total;
        var hi = 1.0 - (min_trailing / total);
        if (hi < lo) { hi = lo; }
        if (lo < 0.0) { lo = 0.0; }
        if (hi > 1.0) { hi = 1.0; }
        var out = ratio;
        if (out < lo) { out = lo; }
        if (out > hi) { out = hi; }
        return out;
    }

    public static fn setRatio(world: AppWorld, owner: string, total: f32, ratio: f32) -> AppWorld {
        if (owner.len == 0) { return world; }
        let clamped = AppSplitView.clampRatio(
            ratio,
            total,
            AppSplitView.minLeading(world, owner),
            AppSplitView.minTrailing(world, owner)
        );
        return world.setFloatResource(AppSplitView.ratioKey(owner), clamped);
    }

    public static fn leadingExtent(world: AppWorld, owner: string, total: f32) -> f32 {
        let ratio = AppSplitView.clampRatio(
            AppSplitView.ratio(world, owner),
            total,
            AppSplitView.minLeading(world, owner),
            AppSplitView.minTrailing(world, owner)
        );
        return total * ratio;
    }

    public static fn trailingExtent(world: AppWorld, owner: string, total: f32) -> f32 {
        return total - AppSplitView.leadingExtent(world, owner, total);
    }

    // Drag handling rides the existing pointer-dragged event rather than a
    // private gesture recogniser: the divider is just a node whose capture
    // action is named, and the frame's dx moves the ratio.
    public static fn applyDrag(world: AppWorld, owner: string, total: f32, dx: f32) -> AppWorld {
        if (owner.len == 0 || total <= 0.0) { return world; }
        let delta = dx / total;
        return AppSplitView.setRatio(world, owner, total, AppSplitView.ratio(world, owner) + delta);
    }

    public static fn applyDragEvent(world: AppWorld, owner: string, total: f32, event: AppInteractionEvent) -> AppWorld {
        return AppSplitView.applyDrag(world, owner, total, event.pos.dx);
    }

    // `horizontal` describes the panes, not the line: two side-by-side panes
    // are separated by a vertical divider.
    public static fn divider(id: string, action_name: string, horizontal: bool) -> View {
        if (horizontal) {
            return View.verticalDivider().id(id).captureAction(action_name);
        }
        return View.divider().id(id).captureAction(action_name);
    }

    public static fn create(world: AppWorld, owner: string, leading: View, trailing: View, horizontal: bool) -> View {
        let total = world.floatResource(AppViewportStore.widthKey(owner), 0.0);
        var extent = total;
        if (!horizontal) { extent = world.floatResource(AppViewportStore.heightKey(owner), 0.0); }
        let leading_extent = AppSplitView.leadingExtent(world, owner, extent);
        let divider = AppSplitView.divider(owner + ".divider", "split.drag." + owner, horizontal);
        if (horizontal) {
            return Row.create()
                .gap(0.0)
                .child(leading.width(leading_extent))
                .child(divider)
                .child(trailing.expanded());
        }
        return Column.create()
            .gap(0.0)
            .child(leading.height(leading_extent))
            .child(divider)
            .child(trailing.expanded());
    }

    // Below a threshold a split is not usable, so it collapses to a single pane
    // and the caller decides which one. This is the rule the roadmap asks for:
    // narrow screens get the content, not a squeezed two-pane layout.
    public static fn isCollapsed(world: AppWorld, owner: string, threshold: f32) -> bool {
        return world.floatResource(AppViewportStore.widthKey(owner), 0.0) < threshold;
    }
}

// ---------------------------------------------------------------------------
// Adaptive navigation
// ---------------------------------------------------------------------------

// Tabs are stored as three parallel resource lists (label / action / icon) plus
// a selected index. Not a `Vec` field, for the same reason as everywhere else
// in the App layer: a shallow copy would share the buffer.
public class AppAdaptiveNav {
    public static fn labelListKey(owner: string) -> string { return "nav:" + owner + ":labels"; }
    public static fn actionListKey(owner: string) -> string { return "nav:" + owner + ":actions"; }
    public static fn indexKey(owner: string) -> string { return "nav:" + owner + ":index"; }

    public static fn clear(world: AppWorld, owner: string) -> AppWorld {
        var out = AppRowStore.clearList(world, AppAdaptiveNav.labelListKey(owner));
        out = AppRowStore.clearList(out, AppAdaptiveNav.actionListKey(owner));
        out = out.setIntResource(AppAdaptiveNav.indexKey(owner), 0);
        return out;
    }

    public static fn addTab(world: AppWorld, owner: string, label: string, action_name: string) -> AppWorld {
        var out = world.appendStringListResource(AppAdaptiveNav.labelListKey(owner), label);
        out = out.appendStringListResource(AppAdaptiveNav.actionListKey(owner), action_name);
        return out;
    }

    public static fn count(world: AppWorld, owner: string) -> i32 {
        return world.stringListResourceCount(AppAdaptiveNav.labelListKey(owner));
    }

    public static fn setIndex(world: AppWorld, owner: string, index: i32) -> AppWorld {
        var out = index;
        if (out < 0) { out = 0; }
        if (out >= AppAdaptiveNav.count(world, owner)) { out = AppAdaptiveNav.count(world, owner) - 1; }
        if (out < 0) { out = 0; }
        return world.setIntResource(AppAdaptiveNav.indexKey(owner), out);
    }

    public static fn index(world: AppWorld, owner: string) -> i32 {
        return world.intResource(AppAdaptiveNav.indexKey(owner), 0);
    }

    // One tab strip, three presentations. The presentation is a function of the
    // viewport, so the same call site works on a phone and on a desktop.
    public static fn create(world: AppWorld, owner: string) -> View {
        let viewport = AppViewportStore.read(world, owner);
        let mode = viewport.navMode();
        if (mode == appNavModeBar()) { return AppAdaptiveNav.bar(world, owner); }
        if (mode == appNavModeRail()) { return AppAdaptiveNav.rail(world, owner); }
        return AppAdaptiveNav.drawer(world, owner);
    }

    public static fn bar(world: AppWorld, owner: string) -> View {
        let selected = AppAdaptiveNav.index(world, owner);
        let count = AppAdaptiveNav.count(world, owner);
        var out = Row.create().id(owner + ".bar").height(56.0).gap(4.0).alignCenter().layer(owner + ".layer");
        var i: i32 = 0;
        while (i < count) {
            let label = world.stringListResourceAt(AppAdaptiveNav.labelListKey(owner), i);
            let action_name = world.stringListResourceAt(AppAdaptiveNav.actionListKey(owner), i);
            var tab = Button.tonalAction(owner + ".tab." + format("%d", i as i64), label, action_name).expanded();
            if (i == selected) { tab = Button.filledAction(owner + ".tab." + format("%d", i as i64), label, action_name).expanded(); }
            out = out.child(tab);
            i = i + 1;
        }
        return out;
    }

    public static fn rail(world: AppWorld, owner: string) -> View {
        let selected = AppAdaptiveNav.index(world, owner);
        let count = AppAdaptiveNav.count(world, owner);
        var out = Column.create().id(owner + ".rail").width(88.0).gap(6.0).padding(8.0).layer(owner + ".layer");
        var i: i32 = 0;
        while (i < count) {
            let label = world.stringListResourceAt(AppAdaptiveNav.labelListKey(owner), i);
            let action_name = world.stringListResourceAt(AppAdaptiveNav.actionListKey(owner), i);
            var tab = Button.tonalAction(owner + ".rail.tab." + format("%d", i as i64), label, action_name).width(72.0);
            if (i == selected) { tab = Button.filledAction(owner + ".rail.tab." + format("%d", i as i64), label, action_name).width(72.0); }
            out = out.child(tab);
            i = i + 1;
        }
        return out;
    }

    public static fn drawer(world: AppWorld, owner: string) -> View {
        let selected = AppAdaptiveNav.index(world, owner);
        let count = AppAdaptiveNav.count(world, owner);
        var out = Column.create().id(owner + ".drawer").width(232.0).gap(4.0).padding(12.0).layer(owner + ".layer");
        var i: i32 = 0;
        while (i < count) {
            let label = world.stringListResourceAt(AppAdaptiveNav.labelListKey(owner), i);
            let action_name = world.stringListResourceAt(AppAdaptiveNav.actionListKey(owner), i);
            var tab = Button.tonalAction(owner + ".drawer.tab." + format("%d", i as i64), label, action_name).expanded();
            if (i == selected) { tab = Button.filledAction(owner + ".drawer.tab." + format("%d", i as i64), label, action_name).expanded(); }
            out = out.child(tab);
            i = i + 1;
        }
        return out;
    }

    // The shell puts the navigation beside the content on wide screens and
    // above it on narrow ones, which is the whole of the layout difference.
    public static fn shell(world: AppWorld, owner: string, content: View) -> View {
        let viewport = AppViewportStore.read(world, owner);
        let nav = AppAdaptiveNav.create(world, owner);
        if (viewport.isCompact()) {
            return Column.create().id(owner + ".shell").gap(0.0).child(content.expanded()).child(nav);
        }
        return Row.create().id(owner + ".shell").gap(0.0).child(nav).child(content.expanded());
    }
}

// ---------------------------------------------------------------------------
// Adaptive flow and action bar
// ---------------------------------------------------------------------------

public class AppAdaptive {
    // Column on compact, row on medium / expanded. This is the single most
    // common adaptive decision, so it gets a name.
    @[borrow_args]
    public static fn flow(world: AppWorld, owner: string, id: string, children: Vec<View>) -> View {
        let viewport = AppViewportStore.read(world, owner);
        if (AppResponsive.isStacked(viewport)) {
            return Column.create().id(id).gap(12.0).children(children);
        }
        return Row.create().id(id).gap(12.0).children(children);
    }

    // Two children that are side by side when there is room and stacked when
    // there is not, with the secondary child collapsing first.
    public static fn primarySecondary(world: AppWorld, owner: string, id: string, primary: View, secondary: View) -> View {
        let viewport = AppViewportStore.read(world, owner);
        if (AppResponsive.isStacked(viewport)) {
            return Column.create().id(id).gap(12.0).child(primary.expanded()).child(secondary);
        }
        return Row.create().id(id).gap(12.0).child(primary.expanded()).child(secondary);
    }

    public static fn columnsFor(world: AppWorld, owner: string, compact: i32, medium: i32, expanded: i32) -> i32 {
        return AppResponsive.pickI32(AppViewportStore.read(world, owner), compact, medium, expanded);
    }
}

// The roadmap's hard requirement: after text scaling and a locale switch the
// *primary* actions must still be on screen. So the action bar pins them, and
// the secondary actions fold into a single overflow button whose menu is an
// overlay layer. Growing the font therefore costs the overflow menu, not the
// primary buttons.
public class AppActionBar {
    public static fn primaryListKey(owner: string) -> string { return "actions:" + owner + ":primary"; }
    public static fn primaryActionKey(owner: string) -> string { return "actions:" + owner + ":primary_action"; }
    public static fn secondaryListKey(owner: string) -> string { return "actions:" + owner + ":secondary"; }
    public static fn secondaryActionKey(owner: string) -> string { return "actions:" + owner + ":secondary_action"; }
    public static fn overflowOpenKey(owner: string) -> string { return "actions:" + owner + ":overflow_open"; }

    public static fn declarePrimary(world: AppWorld, owner: string, label: string, action_name: string) -> AppWorld {
        var out = AppRowStore.clearList(world, AppActionBar.primaryListKey(owner));
        out = out.appendStringListResource(AppActionBar.primaryListKey(owner), label);
        out = out.appendStringListResource(AppActionBar.primaryActionKey(owner), action_name);
        return out;
    }

    public static fn addPrimary(world: AppWorld, owner: string, label: string, action_name: string) -> AppWorld {
        var out = world.appendStringListResource(AppActionBar.primaryListKey(owner), label);
        out = out.appendStringListResource(AppActionBar.primaryActionKey(owner), action_name);
        return out;
    }

    public static fn addSecondary(world: AppWorld, owner: string, label: string, action_name: string) -> AppWorld {
        var out = world.appendStringListResource(AppActionBar.secondaryListKey(owner), label);
        out = out.appendStringListResource(AppActionBar.secondaryActionKey(owner), action_name);
        return out;
    }

    public static fn toggleOverflow(world: AppWorld, owner: string) -> AppWorld {
        return world.setBoolResource(AppActionBar.overflowOpenKey(owner), !world.boolResource(AppActionBar.overflowOpenKey(owner), false));
    }

    public static fn overflowOpen(world: AppWorld, owner: string) -> bool {
        return world.boolResource(AppActionBar.overflowOpenKey(owner), false);
    }

    public static fn create(world: AppWorld, owner: string) -> View {
        let viewport = AppViewportStore.read(world, owner);
        let primary_count = world.stringListResourceCount(AppActionBar.primaryListKey(owner));
        let secondary_count = world.stringListResourceCount(AppActionBar.secondaryListKey(owner));
        // On a narrow or short viewport the secondary actions go behind the
        // overflow button unconditionally; on a wide one they stay inline while
        // there is room, which is what "does not truncate" means in practice.
        let fold_secondary = AppResponsive.isStacked(viewport) || viewport.isShort();
        var out = Row.create().id(owner + ".actions").height(52.0).gap(8.0).alignCenter();
        var i: i32 = 0;
        while (i < primary_count) {
            let label = world.stringListResourceAt(AppActionBar.primaryListKey(owner), i);
            let action_name = world.stringListResourceAt(AppActionBar.primaryActionKey(owner), i);
            out = out.child(Button.filledAction(owner + ".primary." + format("%d", i as i64), label, action_name));
            i = i + 1;
        }
        if (!fold_secondary) {
            var j: i32 = 0;
            while (j < secondary_count) {
                let label = world.stringListResourceAt(AppActionBar.secondaryListKey(owner), j);
                let action_name = world.stringListResourceAt(AppActionBar.secondaryActionKey(owner), j);
                out = out.child(Button.tonalAction(owner + ".secondary." + format("%d", j as i64), label, action_name));
                j = j + 1;
            }
        } else if (secondary_count > 0) {
            out = out.child(Button.outlinedAction(owner + ".overflow", "More", "actions.overflow." + owner));
        }
        return out;
    }

    // The overflow menu itself, rendered into its own overlay layer so it is
    // never clipped by the bar that opened it.
    public static fn overflowMenu(world: AppWorld, owner: string) -> View {
        let secondary_count = world.stringListResourceCount(AppActionBar.secondaryListKey(owner));
        var out = Column.create()
            .id(owner + ".overflow_menu")
            .layer(owner + ".overflow_layer")
            .width(200.0)
            .gap(4.0)
            .padding(8.0)
            .background(Color.rgba(0.16, 0.16, 0.18, 0.96))
            .cornerRadius(10.0);
        var i: i32 = 0;
        while (i < secondary_count) {
            let label = world.stringListResourceAt(AppActionBar.secondaryListKey(owner), i);
            let action_name = world.stringListResourceAt(AppActionBar.secondaryActionKey(owner), i);
            out = out.child(Button.tonalAction(owner + ".overflow.item." + format("%d", i as i64), label, action_name).expanded());
            i = i + 1;
        }
        return out;
    }
}

// ---------------------------------------------------------------------------
// Motion
// ---------------------------------------------------------------------------

// Motion is a preference, not a constant: the same transition asks for its
// duration in milliseconds and gets zero when the user has asked for less.
public class AppMotion {
    public static fn preferenceKey(owner: string) -> string { return "motion:" + owner; }

    public static fn setPreference(world: AppWorld, owner: string, preference: i32) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setIntResource(AppMotion.preferenceKey(owner), preference);
    }

    public static fn preference(world: AppWorld, owner: string) -> i32 {
        return world.intResource(AppMotion.preferenceKey(owner), appMotionFull());
    }

    public static fn duration(world: AppWorld, owner: string, base_ms: f32) -> f32 {
        let preference = AppMotion.preference(world, owner);
        if (preference == appMotionNone()) { return 0.0; }
        if (preference == appMotionReduced()) { return base_ms * 0.25; }
        return base_ms;
    }

    public static fn isAnimated(world: AppWorld, owner: string) -> bool {
        return AppMotion.preference(world, owner) != appMotionNone();
    }
}
