module Zyn.App;

use std.collections;

public fn navigationEventEnter() -> i32 { return 1; }
public fn navigationEventLeave() -> i32 { return 2; }
public fn navigationEventAppear() -> i32 { return 3; }
public fn navigationEventDisappear() -> i32 { return 4; }
public fn navigationEventPresent() -> i32 { return 5; }
public fn navigationEventDismiss() -> i32 { return 6; }
public fn navigationEventRoute() -> i32 { return 7; }
public fn navigationEventTab() -> i32 { return 8; }

public class PresentationMode {
    public value: i32;

    public static fn page() -> PresentationMode {
        return PresentationMode { value: 1 };
    }

    public static fn sheet() -> PresentationMode {
        return PresentationMode { value: 2 };
    }

    public static fn dialog() -> PresentationMode {
        return PresentationMode { value: 3 };
    }

    public static fn panel() -> PresentationMode {
        return PresentationMode { value: 4 };
    }

    public static fn window() -> PresentationMode {
        return PresentationMode { value: 5 };
    }

    public fn equals(&self, other: PresentationMode) -> bool {
        return self.value == other.value;
    }
}

public class SceneRecord {
    public id: string;
    public title: string;
    public presentation: PresentationMode;

    public static fn create(id: string, title: string) -> SceneRecord {
        return SceneRecord {
            id: id,
            title: title,
            presentation: PresentationMode.page()
        };
    }

    public static fn presented(id: string, title: string, presentation: PresentationMode) -> SceneRecord {
        return SceneRecord {
            id: id,
            title: title,
            presentation: presentation
        };
    }

    public static fn empty() -> SceneRecord {
        return SceneRecord.create("", "");
    }

    public fn isEmpty(&self) -> bool {
        return self.id.len == 0;
    }

    public fn dup(&self) -> SceneRecord {
        return SceneRecord {
            id: self.id,
            title: self.title,
            presentation: PresentationMode { value: self.presentation.value }
        };
    }
}

public class AppRoute {
    public path: string;
    public scene_id: string;

    public static fn create(path: string, scene_id: string) -> AppRoute {
        return AppRoute {
            path: path,
            scene_id: scene_id
        };
    }

    public static fn empty() -> AppRoute {
        return AppRoute.create("", "");
    }

    public fn isEmpty(&self) -> bool {
        return self.path.len == 0 || self.scene_id.len == 0;
    }

    public fn dup(&self) -> AppRoute {
        return AppRoute.create(self.path, self.scene_id);
    }
}

public class NavigationEvent {
    public kind: i32;
    public scene_id: string;
    public related_id: string;
    public route_path: string;
    public presentation: PresentationMode;

    public static fn create(kind: i32, scene_id: string, related_id: string, route_path: string, presentation: PresentationMode) -> NavigationEvent {
        return NavigationEvent {
            kind: kind,
            scene_id: scene_id,
            related_id: related_id,
            route_path: route_path,
            presentation: PresentationMode { value: presentation.value }
        };
    }

    public static fn empty() -> NavigationEvent {
        return NavigationEvent.create(0, "", "", "", PresentationMode.page());
    }

    public fn isKind(&self, kind: i32) -> bool {
        return self.kind == kind;
    }

    public fn dup(&self) -> NavigationEvent {
        return NavigationEvent.create(self.kind, self.scene_id, self.related_id, self.route_path, self.presentation);
    }
}

public class Navigator {
    private stack: Vec<SceneRecord>;
    private presented_stack: Vec<SceneRecord>;
    private tabs: Vec<SceneRecord>;
    private selected_tab_index: i32;
    private route_path_value: string;
    private lifecycle_events: Vec<NavigationEvent>;

    public static fn create() -> Navigator {
        return Navigator {
            stack: Vec::<SceneRecord>.new(),
            presented_stack: Vec::<SceneRecord>.new(),
            tabs: Vec::<SceneRecord>.new(),
            selected_tab_index: -1,
            route_path_value: "",
            lifecycle_events: Vec::<NavigationEvent>.new()
        };
    }

    public fn record(mut self, kind: i32, scene: SceneRecord, related_id: string) -> Navigator {
        self.lifecycle_events.push(NavigationEvent.create(kind, scene.id, related_id, self.route_path_value, scene.presentation));
        return self;
    }

    public fn recordRoute(mut self, path: string, scene: SceneRecord) -> Navigator {
        self.lifecycle_events.push(NavigationEvent.create(navigationEventRoute(), scene.id, "", path, scene.presentation));
        return self;
    }

    public fn push(mut self, scene: SceneRecord) -> Navigator {
        let previous = self.current();
        if (!previous.isEmpty()) {
            self = self.record(navigationEventDisappear(), previous, scene.id);
        }
        self.stack.push(scene.dup());
        self = self.record(navigationEventEnter(), scene, previous.id);
        self = self.record(navigationEventAppear(), scene, previous.id);
        return self;
    }

    public fn pushScene(mut self, id: string, title: string) -> Navigator {
        return self.push(SceneRecord.create(id, title));
    }

    public fn replace(mut self, scene: SceneRecord) -> Navigator {
        if (self.stack.len > 0) {
            let previous = self.current();
            if (!previous.isEmpty()) {
                self = self.record(navigationEventDisappear(), previous, scene.id);
                self = self.record(navigationEventLeave(), previous, scene.id);
            }
            self.stack.set(self.stack.len - 1, scene.dup());
            self = self.record(navigationEventEnter(), scene, previous.id);
            self = self.record(navigationEventAppear(), scene, previous.id);
            return self;
        }
        return self.push(scene);
    }

    public fn replaceScene(mut self, id: string, title: string) -> Navigator {
        return self.replace(SceneRecord.create(id, title));
    }

    public fn canPop(&self) -> bool {
        return self.stack.len > 1;
    }

    public fn pop(&mut self) -> bool {
        if (!self.canPop()) { return false; }
        let leaving = self.current();
        let previous = self.stack.get(self.stack.len - 2).dup();
        self = self.record(navigationEventDisappear(), leaving, previous.id);
        self = self.record(navigationEventLeave(), leaving, previous.id);
        self.stack.remove(self.stack.len - 1);
        self = self.record(navigationEventAppear(), previous, leaving.id);
        return true;
    }

    public fn present(mut self, scene: SceneRecord, presentation: PresentationMode) -> Navigator {
        let presented = SceneRecord.presented(scene.id, scene.title, presentation);
        self.presented_stack.push(presented.dup());
        self = self.record(navigationEventPresent(), presented, self.current().id);
        self = self.record(navigationEventEnter(), presented, self.current().id);
        self = self.record(navigationEventAppear(), presented, self.current().id);
        return self;
    }

    public fn presentScene(mut self, id: string, title: string, presentation: PresentationMode) -> Navigator {
        return self.present(SceneRecord.create(id, title), presentation);
    }

    public fn dismiss(&mut self) -> bool {
        if (self.presented_stack.len <= 0) { return false; }
        let leaving = self.presentedCurrent();
        self = self.record(navigationEventDisappear(), leaving, self.current().id);
        self = self.record(navigationEventDismiss(), leaving, self.current().id);
        self = self.record(navigationEventLeave(), leaving, self.current().id);
        self.presented_stack.remove(self.presented_stack.len - 1);
        return true;
    }

    public fn routePath(&self) -> string {
        return self.route_path_value;
    }

    public fn setRoute(mut self, path: string) -> Navigator {
        self.route_path_value = path;
        self = self.recordRoute(path, self.current());
        return self;
    }

    public fn navigate(&mut self, path: string, scene: SceneRecord) -> Navigator {
        self.route_path_value = path;
        self = self.recordRoute(path, scene);
        return self.push(scene);
    }

    public fn navigateScene(mut self, path: string, id: string, title: string) -> Navigator {
        return self.navigate(path, SceneRecord.create(id, title));
    }

    public fn replaceRoute(&mut self, path: string, scene: SceneRecord) -> Navigator {
        self.route_path_value = path;
        self = self.recordRoute(path, scene);
        return self.replace(scene);
    }

    public fn replaceRouteScene(mut self, path: string, id: string, title: string) -> Navigator {
        return self.replaceRoute(path, SceneRecord.create(id, title));
    }

    public fn tabIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.tabs.len as i32)) {
            if (self.tabs.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn addTab(mut self, scene: SceneRecord) -> Navigator {
        let existing = self.tabIndex(scene.id);
        if (existing >= 0) {
            self.tabs.set(existing as i64, scene.dup());
            return self;
        }
        self.tabs.push(scene.dup());
        if (self.selected_tab_index < 0) {
            self.selected_tab_index = 0;
            self = self.record(navigationEventEnter(), scene, "");
            self = self.record(navigationEventAppear(), scene, "");
        }
        return self;
    }

    public fn addTabScene(mut self, id: string, title: string) -> Navigator {
        return self.addTab(SceneRecord.create(id, title));
    }

    public fn selectTabIndex(&mut self, index: i32) -> bool {
        if (index < 0 || index >= (self.tabs.len as i32)) { return false; }
        if (self.selected_tab_index == index) { return true; }
        let previous = self.selectedTab();
        let next = self.tabs.get(index as i64).dup();
        if (!previous.isEmpty()) {
            self = self.record(navigationEventDisappear(), previous, next.id);
        }
        self.selected_tab_index = index;
        self = self.record(navigationEventTab(), next, previous.id);
        self = self.record(navigationEventAppear(), next, previous.id);
        return true;
    }

    public fn selectTab(&mut self, id: string) -> bool {
        return self.selectTabIndex(self.tabIndex(id));
    }

    public fn tabCount(&self) -> i32 {
        return self.tabs.len as i32;
    }

    public fn tabAt(&self, index: i32) -> SceneRecord {
        if (index < 0 || index >= self.tabCount()) { return SceneRecord.empty(); }
        return self.tabs.get(index as i64).dup();
    }

    public fn selectedTabIndex(&self) -> i32 {
        return self.selected_tab_index;
    }

    public fn selectedTab(&self) -> SceneRecord {
        if (self.selected_tab_index < 0 || self.selected_tab_index >= (self.tabs.len as i32)) { return SceneRecord.empty(); }
        return self.tabs.get(self.selected_tab_index as i64).dup();
    }

    public fn eventCount(&self) -> i32 {
        return self.lifecycle_events.len as i32;
    }

    public fn eventAt(&self, index: i32) -> NavigationEvent {
        if (index < 0 || index >= self.eventCount()) { return NavigationEvent.empty(); }
        return self.lifecycle_events.get(index as i64).dup();
    }

    public fn lastEvent(&self) -> NavigationEvent {
        return self.eventAt(self.eventCount() - 1);
    }

    public fn clearEvents(mut self) -> Navigator {
        self.lifecycle_events.clear();
        return self;
    }

    public fn depth(&self) -> i32 {
        return self.stack.len as i32;
    }

    public fn presentedDepth(&self) -> i32 {
        return self.presented_stack.len as i32;
    }

    public fn current(&self) -> SceneRecord {
        if (self.stack.len <= 0) { return SceneRecord.empty(); }
        return self.stack.get(self.stack.len - 1).dup();
    }

    public fn presentedCurrent(&self) -> SceneRecord {
        if (self.presented_stack.len <= 0) { return SceneRecord.empty(); }
        return self.presented_stack.get(self.presented_stack.len - 1).dup();
    }

    public fn reset(mut self) -> Navigator {
        let previous = self.current();
        if (!previous.isEmpty()) {
            self = self.record(navigationEventDisappear(), previous, "");
            self = self.record(navigationEventLeave(), previous, "");
        }
        self.stack.clear();
        self.presented_stack.clear();
        self.route_path_value = "";
        return self;
    }

    public fn dup(&self) -> Navigator {
        var out = Navigator.create();
        var i: i32 = 0;
        while (i < (self.stack.len as i32)) {
            out.stack.push(self.stack.get(i as i64).dup());
            i = i + 1;
        }
        i = 0;
        while (i < (self.presented_stack.len as i32)) {
            out.presented_stack.push(self.presented_stack.get(i as i64).dup());
            i = i + 1;
        }
        i = 0;
        while (i < (self.tabs.len as i32)) {
            out.tabs.push(self.tabs.get(i as i64).dup());
            i = i + 1;
        }
        i = 0;
        while (i < (self.lifecycle_events.len as i32)) {
            out.lifecycle_events.push(self.lifecycle_events.get(i as i64).dup());
            i = i + 1;
        }
        out.selected_tab_index = self.selected_tab_index;
        out.route_path_value = self.route_path_value;
        return out;
    }

    public fn destroy(&mut self) {
        self.stack.destroy();
        self.presented_stack.destroy();
        self.tabs.destroy();
        self.lifecycle_events.destroy();
    }
}
