module Zyn.App;

use std.collections;
use Color = Zyn.Nut.Types.Color;

// ---------------------------------------------------------------------------
// ZC-12 localization
//
// A locale is a tag, a direction and a set of formatting rules. The tag is
// parsed once (`zh-Hans-CN` -> language `zh`, script `Hans`, region `CN`) so
// that lookup can walk a real fallback chain instead of guessing at string
// prefixes; the direction drives `AppDirection`; the formatting rules are the
// part applications always get wrong when they do it by hand - thousands
// separators, decimal commas, the date order, and above all plurals, which are
// not "singular or plural" in most languages.
//
// The message catalogue is resource backed, keyed by locale and key, because a
// nested `Vec` field would be shared by every shallow copy of the class - the
// same reason every other collection in the App layer lives in resources.
// ---------------------------------------------------------------------------

// CLDR plural categories.
public fn appPluralZero() -> i32 { return 0; }
public fn appPluralOne() -> i32 { return 1; }
public fn appPluralTwo() -> i32 { return 2; }
public fn appPluralFew() -> i32 { return 3; }
public fn appPluralMany() -> i32 { return 4; }
public fn appPluralOther() -> i32 { return 5; }

public fn appDateOrderYmd() -> i32 { return 0; }
public fn appDateOrderDmy() -> i32 { return 1; }
public fn appDateOrderMdy() -> i32 { return 2; }

public fn appRelativeNow() -> i32 { return 0; }
public fn appRelativeMinutes() -> i32 { return 1; }
public fn appRelativeHours() -> i32 { return 2; }
public fn appRelativeYesterday() -> i32 { return 3; }
public fn appRelativeDays() -> i32 { return 4; }

// ---------------------------------------------------------------------------
// Locale tag
// ---------------------------------------------------------------------------

public class AppLocale {
    public language: string;
    public script: string;
    public region: string;

    public static fn of(language: string, script: string, region: string) -> AppLocale {
        return AppLocale { language: language, script: script, region: region };
    }

    // Parses `lang[-Script][-REGION]`, tolerating `_` as a separator and the
    // common `lang-REGION` short form. An unrecognisable tag yields an empty
    // locale, which `isValid` reports rather than silently pretending to be
    // English.
    public static fn parse(tag: string) -> AppLocale {
        var language = "";
        var script = "";
        var region = "";
        var part: i32 = 0;
        var current = "";
        var i: i32 = 0;
        while (i <= (tag.len as i32)) {
            var at_end = i == (tag.len as i32);
            var code: i32 = 0;
            if (!at_end) { code = tag.charAt(i as i64); }
            if (at_end || code == 45 || code == 95) {
                if (part == 0) { language = current; }
                else if (part == 1) {
                    if (AppLocale.looksLikeScript(current)) { script = AppLocale.capitalize(current); }
                    else { region = AppLocale.upperAscii(current); }
                } else if (part == 2) { region = AppLocale.upperAscii(current); }
                part = part + 1;
                current = "";
            } else {
                current = current + AppLocale.lowerAscii(code);
            }
            i = i + 1;
        }
        return AppLocale.of(language, script, region);
    }

    public fn isValid(&self) -> bool {
        return self.language.len == 2 || self.language.len == 3;
    }

    // Canonical form: language-Script-REGION with the region upper-cased, which
    // is the spelling the catalogue keys use.
    public fn toText(&self) -> string {
        var out = self.language;
        if (self.script.len > 0) { out = out + "-" + self.script; }
        if (self.region.len > 0) { out = out + "-" + AppLocale.upperAscii(self.region); }
        return out;
    }

    // language-REGION, skipping the script: the second step of the chain.
    public fn languageRegion(&self) -> string {
        if (self.region.len == 0) { return self.language; }
        return self.language + "-" + AppLocale.upperAscii(self.region);
    }

    public fn clone(&self) -> AppLocale {
        return AppLocale { language: self.language, script: self.script, region: self.region };
    }

    public fn dup(&self) -> AppLocale {
        return self.clone();
    }

    public static fn looksLikeScript(part: string) -> bool {
        if (part.len != 4) { return false; }
        let first = part.charAt(0);
        if (first < 97 || first > 122) { return false; }
        return true;
    }

    public static fn lowerAscii(code: i32) -> string {
        if (code >= 65 && code <= 90) { return AppLocale.codeToString(code + 32); }
        return AppLocale.codeToString(code);
    }

    public static fn upperAscii(text: string) -> string {
        var out = "";
        var i: i32 = 0;
        while (i < (text.len as i32)) {
            let code = text.charAt(i as i64);
            if (code >= 97 && code <= 122) { out = out + AppLocale.codeToString(code - 32); }
            else { out = out + AppLocale.codeToString(code); }
            i = i + 1;
        }
        return out;
    }

    public static fn codeToString(code: i32) -> string {
        // The language subset is ASCII; a one-byte string is built by index so
        // that no Unicode escape is needed. The table starts at code 32 (space),
        // so the offset is 32.
        if (code < 32 || code > 126) { return "?"; }
        return AppLocale.asciiTable().substring((code - 32) as i64, (code - 31) as i64);
    }

    public static fn capitalize(text: string) -> string {
        if (text.len == 0) { return text; }
        let first = text.charAt(0);
        var head = text.substring(0, 1);
        if (first >= 97 && first <= 122) { head = AppLocale.codeToString(first - 32); }
        return head + text.substring(1, text.len as i64);
    }

    public static fn asciiTable() -> string {
        return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    }

    // RTL languages. Deliberately a list rather than a range check: script
    // ranges are the wrong tool for "does this locale read right to left".
    public static fn isRtlLocale(tag: string) -> bool {
        let locale = AppLocale.parse(tag);
        let language = locale.language;
        if (language == "ar" || language == "he" || language == "fa") { return true; }
        if (language == "ur" || language == "yi" || language == "ps") { return true; }
        if (language == "sd" || language == "ug" || language == "dv") { return true; }
        if (language == "ku" || language == "ckb") { return true; }
        return false;
    }

    // The fallback chain, written into a resource list so a caller can walk it
    // without allocating a `Vec` on every lookup.
    public static fn chainKey(owner: string) -> string { return "locale:" + owner + ":chain"; }

    public static fn publishChain(world: AppWorld, owner: string, tag: string, default_tag: string) -> AppWorld {
        var out = AppRowStore.clearList(world, AppLocale.chainKey(owner));
        let locale = AppLocale.parse(tag);
        if (locale.isValid()) {
            if (locale.script.len > 0 && locale.region.len > 0) {
                out = out.appendStringListResource(AppLocale.chainKey(owner), locale.toText());
            }
            if (locale.region.len > 0) {
                out = out.appendStringListResource(AppLocale.chainKey(owner), locale.languageRegion());
            }
            if (locale.script.len > 0) {
                out = out.appendStringListResource(AppLocale.chainKey(owner), locale.language + "-" + locale.script);
            }
            out = out.appendStringListResource(AppLocale.chainKey(owner), locale.language);
        }
        if (default_tag.len > 0) {
            out = out.appendStringListResource(AppLocale.chainKey(owner), default_tag);
        }
        return out;
    }

    public static fn chainCount(world: AppWorld, owner: string) -> i32 {
        return world.stringListResourceCount(AppLocale.chainKey(owner));
    }

    public static fn chainAt(world: AppWorld, owner: string, index: i32) -> string {
        return world.stringListResourceAt(AppLocale.chainKey(owner), index);
    }
}

// ---------------------------------------------------------------------------
// Locale manager
// ---------------------------------------------------------------------------

public class AppLocaleManager {
    public static fn localeKey(owner: string) -> string { return "locale:" + owner + ":tag"; }
    public static fn revisionKey(owner: string) -> string { return "locale:" + owner + ":revision"; }

    // Switching locale bumps a revision and republishes the chain, so a
    // component that memoises on the revision rebuilds exactly once.
    public static fn setLocale(world: AppWorld, owner: string, tag: string, default_tag: string) -> AppWorld {
        if (owner.len == 0) { return world; }
        var out = world.setStringResource(AppLocaleManager.localeKey(owner), tag);
        out = AppLocale.publishChain(out, owner, tag, default_tag);
        out = out.incrementIntResource(AppLocaleManager.revisionKey(owner), 1);
        out = AppDirection.fromLocale(out, owner, tag);
        return out;
    }

    public static fn locale(world: AppWorld, owner: string) -> string {
        return world.stringResource(AppLocaleManager.localeKey(owner), "");
    }

    public static fn revision(world: AppWorld, owner: string) -> i32 {
        return world.intResource(AppLocaleManager.revisionKey(owner), 0);
    }

    public static fn isRtl(world: AppWorld, owner: string) -> bool {
        return AppDirection.isRtl(world, owner);
    }

    // The number formatting rules of the active locale, resolved once.
    public static fn decimalSeparator(world: AppWorld, owner: string) -> string {
        return AppNumberFormat.decimalSeparatorFor(AppLocaleManager.locale(world, owner));
    }

    public static fn groupSeparator(world: AppWorld, owner: string) -> string {
        return AppNumberFormat.groupSeparatorFor(AppLocaleManager.locale(world, owner));
    }
}

// ---------------------------------------------------------------------------
// Message catalogue
// ---------------------------------------------------------------------------

public class AppCatalog {
    public static fn messageKey(locale: string, key: string) -> string {
        return "msg:" + locale + ":" + key;
    }

    public static fn setMessage(world: AppWorld, locale: string, key: string, text: string) -> AppWorld {
        if (locale.len == 0 || key.len == 0) { return world; }
        return world.setStringResource(AppCatalog.messageKey(locale, key), text);
    }

    public static fn hasMessage(world: AppWorld, locale: string, key: string) -> bool {
        if (world.stringResource(AppCatalog.messageKey(locale, key), "").len > 0) { return true; }
        return false;
    }

    public static fn messageAt(world: AppWorld, locale: string, key: string) -> string {
        return world.stringResource(AppCatalog.messageKey(locale, key), "");
    }

    // Walk the published fallback chain and return the first translation. The
    // fallback is the last resort and is what makes an untranslated string show
    // up as the developer's own language rather than as a raw key.
    public static fn lookup(world: AppWorld, owner: string, key: string, fallback: string) -> string {
        let count = AppLocale.chainCount(world, owner);
        var i: i32 = 0;
        while (i < count) {
            let locale = AppLocale.chainAt(world, owner, i);
            let found = AppCatalog.messageAt(world, locale, key);
            if (found.len > 0) { return found; }
            i = i + 1;
        }
        return fallback;
    }

    // The same lookup, but for a specific plural category, falling back from
    // `key.one` to `key.other` so a translator only has to supply what differs.
    public static fn lookupPlural(world: AppWorld, owner: string, key: string, category: i32, fallback: string) -> string {
        let suffix = AppPlural.suffix(category);
        let specific = AppCatalog.lookup(world, owner, key + "." + suffix, "");
        if (specific.len > 0) { return specific; }
        let other = AppCatalog.lookup(world, owner, key + ".other", "");
        if (other.len > 0) { return other; }
        return fallback;
    }
}

// ---------------------------------------------------------------------------
// Plurals
// ---------------------------------------------------------------------------

// The rules below are the CLDR integer rules for the languages the framework is
// most likely to ship in. They are intentionally a table, not a formula: a
// formula that is "almost right" is how a Russian UI ends up saying "5 товар".
public class AppPlural {
    public static fn suffix(category: i32) -> string {
        if (category == appPluralZero()) { return "zero"; }
        if (category == appPluralOne()) { return "one"; }
        if (category == appPluralTwo()) { return "two"; }
        if (category == appPluralFew()) { return "few"; }
        if (category == appPluralMany()) { return "many"; }
        return "other";
    }

    public static fn categoryFor(locale: string, count: i64) -> i32 {
        let language = AppLocale.parse(locale).language;
        // Languages with no plural distinction at all.
        if (language == "zh" || language == "ja" || language == "ko") { return appPluralOther(); }
        if (language == "th" || language == "vi" || language == "id") { return appPluralOther(); }
        if (language == "tr" || language == "hu" || language == "fa") { return appPluralOther(); }
        // English-like: one for exactly 1.
        if (language == "en" || language == "de" || language == "es" || language == "it") {
            if (count == 1) { return appPluralOne(); }
            return appPluralOther();
        }
        if (language == "nl" || language == "sv" || language == "da" || language == "nb") {
            if (count == 1) { return appPluralOne(); }
            return appPluralOther();
        }
        // French and Portuguese treat zero as singular.
        if (language == "fr" || language == "pt") {
            if (count == 0 || count == 1) { return appPluralOne(); }
            return appPluralOther();
        }
        // Slavic: one / few / many.
        if (language == "ru" || language == "uk" || language == "be") {
            let mod10 = count % 10;
            let mod100 = count % 100;
            if (mod10 == 1 && mod100 != 11) { return appPluralOne(); }
            if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) { return appPluralFew(); }
            if (mod10 == 0 || (mod10 >= 5 && mod10 <= 9) || (mod100 >= 11 && mod100 <= 14)) { return appPluralMany(); }
            return appPluralOther();
        }
        if (language == "pl") {
            let mod10 = count % 10;
            let mod100 = count % 100;
            if (count == 1) { return appPluralOne(); }
            if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) { return appPluralFew(); }
            return appPluralMany();
        }
        if (language == "cs" || language == "sk") {
            if (count == 1) { return appPluralOne(); }
            if (count >= 2 && count <= 4) { return appPluralFew(); }
            return appPluralOther();
        }
        // Arabic: zero / one / two / few / many.
        if (language == "ar") {
            if (count == 0) { return appPluralZero(); }
            if (count == 1) { return appPluralOne(); }
            if (count == 2) { return appPluralTwo(); }
            let mod100 = count % 100;
            if (mod100 >= 3 && mod100 <= 10) { return appPluralFew(); }
            if (mod100 >= 11 && mod100 <= 99) { return appPluralMany(); }
            return appPluralOther();
        }
        if (language == "he") {
            if (count == 1) { return appPluralOne(); }
            if (count == 2) { return appPluralTwo(); }
            return appPluralOther();
        }
        if (language == "lt") {
            let mod10 = count % 10;
            let mod100 = count % 100;
            if (mod10 == 1 && (mod100 < 11 || mod100 > 19)) { return appPluralOne(); }
            if (mod10 >= 2 && mod10 <= 9 && (mod100 < 11 || mod100 > 19)) { return appPluralFew(); }
            return appPluralOther();
        }
        if (count == 1) { return appPluralOne(); }
        return appPluralOther();
    }

    public static fn select(locale: string, count: i64, one: string, other: string) -> string {
        if (AppPlural.categoryFor(locale, count) == appPluralOne()) { return one; }
        return other;
    }
}

// ---------------------------------------------------------------------------
// Message arguments
// ---------------------------------------------------------------------------

// Fixed arity, because Vyx has no variadic call: four positional arguments and
// a count cover every message the framework itself needs, and a message that
// wants more is a message that should be two messages.
public class AppMessageArgs {
    public a0: string;
    public a1: string;
    public a2: string;
    public a3: string;
    public count: i64;
    public has_count: bool;

    public static fn empty() -> AppMessageArgs {
        return AppMessageArgs { a0: "", a1: "", a2: "", a3: "", count: 0, has_count: false };
    }

    public static fn of1(a0: string) -> AppMessageArgs {
        return AppMessageArgs { a0: a0, a1: "", a2: "", a3: "", count: 0, has_count: false };
    }

    public static fn of2(a0: string, a1: string) -> AppMessageArgs {
        return AppMessageArgs { a0: a0, a1: a1, a2: "", a3: "", count: 0, has_count: false };
    }

    public static fn of3(a0: string, a1: string, a2: string) -> AppMessageArgs {
        return AppMessageArgs { a0: a0, a1: a1, a2: a2, a3: "", count: 0, has_count: false };
    }

    public static fn of4(a0: string, a1: string, a2: string, a3: string) -> AppMessageArgs {
        return AppMessageArgs { a0: a0, a1: a1, a2: a2, a3: a3, count: 0, has_count: false };
    }

    public fn withCount(mut self, value: i64) -> AppMessageArgs {
        self.count = value;
        self.has_count = true;
        return self;
    }

    public fn arg(&self, index: i32) -> string {
        if (index == 0) { return self.a0; }
        if (index == 1) { return self.a1; }
        if (index == 2) { return self.a2; }
        if (index == 3) { return self.a3; }
        return "";
    }

    public fn clone(&self) -> AppMessageArgs {
        return AppMessageArgs {
            a0: self.a0, a1: self.a1, a2: self.a2, a3: self.a3,
            count: self.count, has_count: self.has_count
        };
    }

    public fn dup(&self) -> AppMessageArgs {
        return self.clone();
    }
}

public class AppMessages {
    // `{0}`..`{3}` are positional, `{count}` is the plural count. A `{{` is a
    // literal brace. An unknown placeholder is left verbatim so that a typo is
    // visible in the UI instead of silently disappearing.
    public static fn format(template: string, args: AppMessageArgs) -> string {
        var out = "";
        var i: i32 = 0;
        let len = template.len as i32;
        while (i < len) {
            let code = template.charAt(i as i64);
            if (code != 123) {
                out = out + template.substring(i as i64, (i + 1) as i64);
                i = i + 1;
            } else {
                let close = AppMessages.findBrace(template, i + 1);
                if (close < 0) {
                    out = out + template.substring(i as i64, (i + 1) as i64);
                    i = i + 1;
                } else {
                    let inner = template.substring((i + 1) as i64, close as i64);
                    out = out + AppMessages.resolvePlaceholder(inner, args);
                    i = close + 1;
                }
            }
        }
        return out;
    }

    public static fn findBrace(text: string, from: i32) -> i32 {
        var i = from;
        while (i < (text.len as i32)) {
            if (text.charAt(i as i64) == 125) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public static fn resolvePlaceholder(name: string, args: AppMessageArgs) -> string {
        if (name == "count") {
            return format("%d", args.count);
        }
        if (name.len == 1) {
            let code = name.charAt(0);
            if (code >= 48 && code <= 51) { return args.arg(code - 48); }
        }
        return "{" + name + "}";
    }

    // The one call a screen normally makes: look the message up through the
    // fallback chain, pick the plural form, then substitute.
    public static fn get(world: AppWorld, owner: string, key: string, args: AppMessageArgs, fallback: string) -> string {
        if (args.has_count) {
            let locale = AppLocaleManager.locale(world, owner);
            let category = AppPlural.categoryFor(locale, args.count);
            let text = AppCatalog.lookupPlural(world, owner, key, category, fallback);
            return AppMessages.format(text, args);
        }
        let text = AppCatalog.lookup(world, owner, key, fallback);
        return AppMessages.format(text, args);
    }

    public static fn getPlural(world: AppWorld, owner: string, key: string, count: i64, args: AppMessageArgs, fallback: string) -> string {
        var with_count = args.withCount(count);
        return AppMessages.get(world, owner, key, with_count, fallback);
    }
}

// ---------------------------------------------------------------------------
// Number and currency formatting
// ---------------------------------------------------------------------------

public class AppNumberFormat {
    public static fn decimalSeparatorFor(locale: string) -> string {
        let language = AppLocale.parse(locale).language;
        if (language == "de" || language == "fr" || language == "es") { return ","; }
        if (language == "it" || language == "pt" || language == "ru") { return ","; }
        if (language == "nl" || language == "tr" || language == "pl") { return ","; }
        if (language == "cs" || language == "sk" || language == "uk") { return ","; }
        return ".";
    }

    public static fn groupSeparatorFor(locale: string) -> string {
        let language = AppLocale.parse(locale).language;
        if (language == "de" || language == "es" || language == "it") { return "."; }
        if (language == "pt" || language == "ru" || language == "nl") { return "."; }
        if (language == "tr" || language == "pl" || language == "cs") { return "."; }
        if (language == "fr" || language == "sk" || language == "uk") { return " "; }
        return ",";
    }

    public static fn groupSizeFor(locale: string) -> i32 {
        let language = AppLocale.parse(locale).language;
        // Indian grouping is 3 then 2: 12,34,567.
        if (language == "hi" || language == "bn" || language == "ta") { return 3; }
        return 3;
    }

    // Groups the digits of an already sign-stripped integer string.
    public static fn groupDigits(digits: string, separator: string, size: i32) -> string {
        if (size <= 0) { return digits; }
        let len = digits.len as i32;
        if (len <= size) { return digits; }
        var out = "";
        var i: i32 = 0;
        while (i < len) {
            let remaining = len - i;
            if (i > 0 && remaining % size == 0) { out = out + separator; }
            out = out + digits.substring(i as i64, (i + 1) as i64);
            i = i + 1;
        }
        return out;
    }

    public static fn formatInt(value: i64, locale: string) -> string {
        var negative = false;
        var magnitude = value;
        if (magnitude < 0) { negative = true; magnitude = 0 - magnitude; }
        let digits = format("%d", magnitude);
        var out = AppNumberFormat.groupDigits(digits, AppNumberFormat.groupSeparatorFor(locale), AppNumberFormat.groupSizeFor(locale));
        if (negative) { out = "-" + out; }
        return out;
    }

    // `decimals` is clamped: negative is treated as zero, and more than six
    // digits of a 32-bit float is noise rather than information.
    public static fn formatFloat(value: f32, decimals: i32, locale: string) -> string {
        var places = decimals;
        if (places < 0) { places = 0; }
        if (places > 6) { places = 6; }
        var negative = false;
        var magnitude = value;
        if (magnitude < 0.0) { negative = true; magnitude = 0.0 - magnitude; }
        var scaled = magnitude;
        var i: i32 = 0;
        while (i < places) { scaled = scaled * 10.0; i = i + 1; }
        var rounded = scaled as i64;
        // Round half away from zero, which is what a user expects from a price.
        let fraction = scaled - (rounded as f32);
        if (fraction >= 0.5) { rounded = rounded + 1; }
        var scale_unit: i64 = 1;
        var j: i32 = 0;
        while (j < places) { scale_unit = scale_unit * 10; j = j + 1; }
        let whole = rounded / scale_unit;
        let frac = rounded % scale_unit;
        var out = AppNumberFormat.groupDigits(format("%d", whole), AppNumberFormat.groupSeparatorFor(locale), AppNumberFormat.groupSizeFor(locale));
        if (places > 0) {
            out = out + AppNumberFormat.decimalSeparatorFor(locale) + AppNumberFormat.padLeft(format("%d", frac), places);
        }
        if (negative) { out = "-" + out; }
        return out;
    }

    public static fn padLeft(text: string, width: i32) -> string {
        var out = text;
        while ((out.len as i32) < width) { out = "0" + out; }
        return out;
    }

    public static fn formatPercent(fraction: f32, decimals: i32, locale: string) -> string {
        return AppNumberFormat.formatFloat(fraction * 100.0, decimals, locale) + "%";
    }
}

public class AppCurrency {
    // `minor_units` is the amount in the currency's smallest unit, so a price
    // never round-trips through a float on its way to the screen.
    public static fn format(minor_units: i64, decimals: i32, symbol: string, locale: string) -> string {
        var places = decimals;
        if (places < 0) { places = 0; }
        if (places > 4) { places = 4; }
        var unit: i64 = 1;
        var i: i32 = 0;
        while (i < places) { unit = unit * 10; i = i + 1; }
        let whole = minor_units / unit;
        let frac = minor_units % unit;
        let negative = whole < 0 || frac < 0;
        var magnitude = whole;
        if (magnitude < 0) { magnitude = 0 - magnitude; }
        var out = AppNumberFormat.groupDigits(format("%d", magnitude), AppNumberFormat.groupSeparatorFor(locale), AppNumberFormat.groupSizeFor(locale));
        if (places > 0) {
            var frac_magnitude = frac;
            if (frac_magnitude < 0) { frac_magnitude = 0 - frac_magnitude; }
            out = out + AppNumberFormat.decimalSeparatorFor(locale) + AppNumberFormat.padLeft(format("%d", frac_magnitude), places);
        }
        if (negative) { out = "-" + out; }
        // A symbol before the amount is the majority convention; the currency
        // code is used when no symbol was supplied.
        if (symbol.len > 0) { return symbol + out; }
        return out;
    }
}

// ---------------------------------------------------------------------------
// Dates and times
// ---------------------------------------------------------------------------

public class AppDateFormat {
    public static fn orderFor(locale: string) -> i32 {
        let parsed = AppLocale.parse(locale);
        let language = parsed.language;
        let region = parsed.region;
        if (language == "zh" || language == "ja" || language == "ko") { return appDateOrderYmd(); }
        if (language == "sv" || language == "hu" || language == "lt") { return appDateOrderYmd(); }
        if (region == "US" || region == "PH" || region == "FM") { return appDateOrderMdy(); }
        return appDateOrderDmy();
    }

    public static fn separatorFor(locale: string) -> string {
        let language = AppLocale.parse(locale).language;
        if (language == "de" || language == "ru" || language == "uk") { return "."; }
        if (language == "zh" || language == "ja" || language == "ko") { return "-"; }
        if (language == "hu") { return "."; }
        return "/";
    }

    // Takes the canonical `YYYY-MM-DD` and renders it in the locale's order.
    // Anything that is not three numeric parts is returned untouched, which
    // keeps a partially typed date from being mangled under the caret.
    public static fn format(iso: string, locale: string) -> string {
        var y = "";
        var m = "";
        var d = "";
        var part: i32 = 0;
        var current = "";
        var i: i32 = 0;
        while (i <= (iso.len as i32)) {
            var at_end = i == (iso.len as i32);
            var code: i32 = 0;
            if (!at_end) { code = iso.charAt(i as i64); }
            if (at_end || code == 45 || code == 47) {
                if (part == 0) { y = current; }
                else if (part == 1) { m = current; }
                else if (part == 2) { d = current; }
                part = part + 1;
                current = "";
            } else {
                current = current + iso.substring(i as i64, (i + 1) as i64);
            }
            i = i + 1;
        }
        if (y.len == 0 || m.len == 0 || d.len == 0) { return iso; }
        let sep = AppDateFormat.separatorFor(locale);
        let order = AppDateFormat.orderFor(locale);
        if (order == appDateOrderMdy()) { return m + sep + d + sep + y; }
        if (order == appDateOrderDmy()) { return d + sep + m + sep + y; }
        return y + sep + m + sep + d;
    }

    public static fn monthName(month: i32, locale: string) -> string {
        let language = AppLocale.parse(locale).language;
        // Only the English names are built in; everything else falls back to the
        // numeric month, and a real application supplies the rest through the
        // catalogue under `date.month.<n>`.
        if (language != "en") { return format("%d", month as i64); }
        if (month == 1) { return "January"; }
        if (month == 2) { return "February"; }
        if (month == 3) { return "March"; }
        if (month == 4) { return "April"; }
        if (month == 5) { return "May"; }
        if (month == 6) { return "June"; }
        if (month == 7) { return "July"; }
        if (month == 8) { return "August"; }
        if (month == 9) { return "September"; }
        if (month == 10) { return "October"; }
        if (month == 11) { return "November"; }
        if (month == 12) { return "December"; }
        return format("%d", month as i64);
    }

    // 24-hour clock everywhere except the US and a handful of others, which is
    // the rule that makes `13:05` correct in most of the world and `1:05 PM`
    // correct where it belongs.
    public static fn uses12Hour(locale: string) -> bool {
        let parsed = AppLocale.parse(locale);
        if (parsed.region == "US" || parsed.region == "CA" || parsed.region == "AU") { return true; }
        if (parsed.region == "PH" || parsed.region == "IN") { return true; }
        return false;
    }

    public static fn formatTime(hour: i32, minute: i32, locale: string) -> string {
        var h = hour;
        var suffix = "";
        if (AppDateFormat.uses12Hour(locale)) {
            suffix = " AM";
            if (h >= 12) { suffix = " PM"; }
            if (h == 0) { h = 12; }
            if (h > 12) { h = h - 12; }
        }
        return AppNumberFormat.padLeft(format("%d", h as i64), 2) + ":" + AppNumberFormat.padLeft(format("%d", minute as i64), 2) + suffix;
    }
}

// Relative time, driven by the ZC-06 effect clock so that "3 minutes ago" ticks
// without the caller owning a timer.
public class AppRelativeTime {
    public static fn bucketFor(delta_seconds: i64) -> i32 {
        if (delta_seconds < 45) { return appRelativeNow(); }
        if (delta_seconds < 3600) { return appRelativeMinutes(); }
        if (delta_seconds < 86400) { return appRelativeHours(); }
        if (delta_seconds < 172800) { return appRelativeYesterday(); }
        return appRelativeDays();
    }

    public static fn unitCount(delta_seconds: i64) -> i64 {
        let bucket = AppRelativeTime.bucketFor(delta_seconds);
        if (bucket == appRelativeMinutes()) { return delta_seconds / 60; }
        if (bucket == appRelativeHours()) { return delta_seconds / 3600; }
        if (bucket == appRelativeDays()) { return delta_seconds / 86400; }
        return 0;
    }

    // The key a catalogue is expected to define; the English text is the
    // fallback so an untranslated locale still reads correctly.
    public static fn keyFor(bucket: i32) -> string {
        if (bucket == appRelativeNow()) { return "time.now"; }
        if (bucket == appRelativeMinutes()) { return "time.minutes"; }
        if (bucket == appRelativeHours()) { return "time.hours"; }
        if (bucket == appRelativeYesterday()) { return "time.yesterday"; }
        return "time.days";
    }

    public static fn fallbackFor(bucket: i32) -> string {
        if (bucket == appRelativeNow()) { return "just now"; }
        if (bucket == appRelativeMinutes()) { return "{count} minutes ago"; }
        if (bucket == appRelativeHours()) { return "{count} hours ago"; }
        if (bucket == appRelativeYesterday()) { return "yesterday"; }
        return "{count} days ago";
    }

    public static fn format(world: AppWorld, owner: string, delta_seconds: i64) -> string {
        let bucket = AppRelativeTime.bucketFor(delta_seconds);
        let count = AppRelativeTime.unitCount(delta_seconds);
        let args = AppMessageArgs.empty().withCount(count);
        return AppMessages.get(world, owner, AppRelativeTime.keyFor(bucket), args, AppRelativeTime.fallbackFor(bucket));
    }

    // A clock value (`effectClock`) is in frames; this converts to seconds with
    // the frame rate the host is actually running at.
    public static fn secondsBetween(from_frame: u64, to_frame: u64, fps: f32) -> i64 {
        if (to_frame <= from_frame) { return 0; }
        var rate = fps;
        if (rate <= 0.0) { rate = 60.0; }
        let frames = (to_frame - from_frame) as f32;
        return (frames / rate) as i64;
    }
}
