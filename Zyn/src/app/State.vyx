module Zyn.App;

public class AppStateSnapshot {
    public revision: u64;

    public static fn create(revision: u64) -> AppStateSnapshot {
        return AppStateSnapshot { revision: revision };
    }

    public static fn capture(world: AppWorld) -> AppStateSnapshot {
        return AppStateSnapshot.create(world.stateRevision());
    }

    public fn changed(&self, world: AppWorld) -> bool {
        return world.stateChangedSince(self.revision);
    }
}

public class StringBinding {
    public id: string;
    public fallback: string;

    public static fn create(id: string, fallback: string) -> StringBinding {
        return StringBinding { id: id, fallback: fallback };
    }

    public fn get(&self, world: AppWorld) -> string {
        return world.stringResource(self.id, self.fallback);
    }

    public fn exists(&self, world: AppWorld) -> bool {
        return world.hasStringResource(self.id);
    }

    public fn set(&self, world: AppWorld, value: string) -> AppWorld {
        return world.setStringResource(self.id, value);
    }

    public fn registerSet(&self, world: AppWorld, action_name: string) -> AppWorld {
        return world.registerStringSetCommand(action_name, self.id);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindText(self.id);
    }
}

public class IntBinding {
    public id: string;
    public fallback: i32;

    public static fn create(id: string, fallback: i32) -> IntBinding {
        return IntBinding { id: id, fallback: fallback };
    }

    public fn get(&self, world: AppWorld) -> i32 {
        return world.intResource(self.id, self.fallback);
    }

    public fn exists(&self, world: AppWorld) -> bool {
        return world.intResourceIndex(self.id) >= 0;
    }

    public fn set(&self, world: AppWorld, value: i32) -> AppWorld {
        var out = world.setIntResource(self.id, value);
        return out.setStringResource(self.id, format("%d", value as i64));
    }

    public fn add(&self, world: AppWorld, delta: i32) -> AppWorld {
        return self.set(world, self.get(world) + delta);
    }

    public fn registerSet(&self, world: AppWorld, action_name: string) -> AppWorld {
        return world.registerIntSetCommand(action_name, self.id);
    }

    public fn registerDelta(&self, world: AppWorld, action_name: string, delta: i32) -> AppWorld {
        return world.registerIntDeltaCommand(action_name, self.id, delta);
    }

    public fn registerIncrement(&self, world: AppWorld, action_name: string) -> AppWorld {
        return self.registerDelta(world, action_name, 1);
    }

    public fn registerDecrement(&self, world: AppWorld, action_name: string) -> AppWorld {
        return self.registerDelta(world, action_name, -1);
    }

    public fn registerStepPair(&self, world: AppWorld, increment_action: string, decrement_action: string) -> AppWorld {
        var out = self.registerIncrement(world, increment_action);
        return self.registerDecrement(out, decrement_action);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindText(self.id);
    }

    public fn titleView(&self, view_id: string) -> View {
        return Text.titleBound(self.id, format("%d", self.fallback as i64)).id(view_id);
    }

    public fn bodyView(&self, view_id: string) -> View {
        return Text.bodyBound(self.id, format("%d", self.fallback as i64)).id(view_id);
    }
}

public class FloatBinding {
    public id: string;
    public fallback: f32;

    public static fn create(id: string, fallback: f32) -> FloatBinding {
        return FloatBinding { id: id, fallback: fallback };
    }

    public fn get(&self, world: AppWorld) -> f32 {
        return world.floatResource(self.id, self.fallback);
    }

    public fn exists(&self, world: AppWorld) -> bool {
        return world.floatResourceIndex(self.id) >= 0;
    }

    public fn set(&self, world: AppWorld, value: f32) -> AppWorld {
        var out = world.setFloatResource(self.id, value);
        return out.setStringResource(self.id, app_format_f32(value));
    }

    public fn registerSet(&self, world: AppWorld, action_name: string) -> AppWorld {
        return world.registerFloatSetCommand(action_name, self.id);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindText(self.id);
    }
}

public class BoolBinding {
    public id: string;
    public fallback: bool;

    public static fn create(id: string, fallback: bool) -> BoolBinding {
        return BoolBinding { id: id, fallback: fallback };
    }

    public fn get(&self, world: AppWorld) -> bool {
        return world.boolResource(self.id, self.fallback);
    }

    public fn exists(&self, world: AppWorld) -> bool {
        return world.boolResourceIndex(self.id) >= 0;
    }

    public fn set(&self, world: AppWorld, value: bool) -> AppWorld {
        var out = world.setBoolResource(self.id, value);
        return out.setStringResource(self.id, app_format_bool(value));
    }

    public fn toggle(&self, world: AppWorld) -> AppWorld {
        return self.set(world, !self.get(world));
    }

    public fn registerSet(&self, world: AppWorld, action_name: string) -> AppWorld {
        return world.registerBoolSetCommand(action_name, self.id);
    }

    public fn registerToggle(&self, world: AppWorld, action_name: string) -> AppWorld {
        return world.registerBoolToggleCommand(action_name, self.id);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindChecked(self.id);
    }
}

public class StringListBinding {
    public id: string;

    public static fn create(id: string) -> StringListBinding {
        return StringListBinding { id: id };
    }

    public fn checkedId(&self) -> string {
        return self.id + ":checked";
    }

    public fn count(&self, world: AppWorld) -> i32 {
        return world.stringListResourceCount(self.id);
    }

    public fn at(&self, world: AppWorld, index: i32) -> string {
        return world.stringListResourceAt(self.id, index);
    }

    public fn append(&self, world: AppWorld, value: string) -> AppWorld {
        return world.appendStringListResource(self.id, value);
    }

    public fn removeAt(&self, world: AppWorld, index: i32) -> AppWorld {
        return world.removeStringListResourceAt(self.id, index);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindList(self.id);
    }
}

public class BoolListBinding {
    public id: string;

    public static fn create(id: string) -> BoolListBinding {
        return BoolListBinding { id: id };
    }

    public static fn forStringList(items: StringListBinding) -> BoolListBinding {
        return BoolListBinding.create(items.checkedId());
    }

    public fn count(&self, world: AppWorld) -> i32 {
        return world.boolListResourceCount(self.id);
    }

    public fn at(&self, world: AppWorld, index: i32) -> bool {
        return world.boolListResourceAt(self.id, index);
    }

    public fn append(&self, world: AppWorld, value: bool) -> AppWorld {
        return world.appendBoolListResource(self.id, value);
    }

    public fn setAt(&self, world: AppWorld, index: i32, value: bool) -> AppWorld {
        return world.setBoolListResourceAt(self.id, index, value);
    }

    public fn toggleAt(&self, world: AppWorld, index: i32) -> AppWorld {
        return world.toggleBoolListResourceAt(self.id, index);
    }

    public fn removeAt(&self, world: AppWorld, index: i32) -> AppWorld {
        return world.removeBoolListResourceAt(self.id, index);
    }

    public fn bind(&self, view: View) -> View {
        return view.bindCheckedList(self.id);
    }
}

public class ComponentStateScope {
    public component_id: string;

    public static fn create(component_id: string) -> ComponentStateScope {
        return ComponentStateScope { component_id: component_id };
    }

    public fn string(&self, name: string, fallback: string) -> StringBinding {
        return StringBinding.create("component:" + self.component_id + ":" + name, fallback);
    }

    public fn int(&self, name: string, fallback: i32) -> IntBinding {
        return IntBinding.create("component:" + self.component_id + ":" + name, fallback);
    }

    public fn float(&self, name: string, fallback: f32) -> FloatBinding {
        return FloatBinding.create("component:" + self.component_id + ":" + name, fallback);
    }

    public fn flag(&self, name: string, fallback: bool) -> BoolBinding {
        return BoolBinding.create("component:" + self.component_id + ":" + name, fallback);
    }
}
