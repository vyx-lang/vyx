module Zyn.App;

use std.collections;
use Color = Zyn.Nut.Types.Color;
use UiTheme = Zyn.UI.UiTheme;

// ---------------------------------------------------------------------------
// ZC-12 design system
//
// The framework already had `UiTheme` - a flat bag of colours and metrics - and
// `appColorRole*` - the semantic names a view uses instead of a raw colour. What
// was missing is the layer between them: the part that decides *which* theme is
// active, that can derive a high-contrast variant instead of shipping a fourth
// hand-written palette, that answers "what is the spacing token `md`" without a
// view hard-coding 12.0, and that keeps the direction and the font fallback in
// one place.
//
// Two rules keep this honest:
//
//   * the token vocabulary is closed. `AppDesignTokens` knows a fixed set of
//     semantic names; a view that asks for an unknown name gets the fallback
//     rather than a silently invented value.
//
//   * MD3 is a theme, not a dependency. `UiTheme.md3Light()` is reachable from
//     here, but nothing in the behaviour modules requires it - a plain light
//     theme and an MD3 theme differ only in the palette they hand to
//     `resolve`.
// ---------------------------------------------------------------------------

public fn appThemeLight() -> i32 { return 0; }
public fn appThemeDark() -> i32 { return 1; }
public fn appThemeHighContrast() -> i32 { return 2; }
// Follow the system setting; the concrete mode is supplied by the platform.
public fn appThemeSystem() -> i32 { return 3; }

public fn appDirectionLtr() -> i32 { return 0; }
public fn appDirectionRtl() -> i32 { return 1; }

public fn appFontLatin() -> i32 { return 0; }
public fn appFontCjk() -> i32 { return 1; }
public fn appFontEmoji() -> i32 { return 2; }
public fn appFontSymbol() -> i32 { return 3; }

// ---------------------------------------------------------------------------
// Direction
// ---------------------------------------------------------------------------

// Direction is a property of the *content*, not of the window: an RTL locale
// flips the whole layout, and the two helpers below are how a view asks which
// end is "start" without branching on the locale itself.
public class AppDirection {
    public static fn key(owner: string) -> string { return "direction:" + owner; }

    public static fn set(world: AppWorld, owner: string, direction: i32) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setIntResource(AppDirection.key(owner), direction);
    }

    public static fn get(world: AppWorld, owner: string) -> i32 {
        return world.intResource(AppDirection.key(owner), appDirectionLtr());
    }

    public static fn isRtl(world: AppWorld, owner: string) -> bool {
        return AppDirection.get(world, owner) == appDirectionRtl();
    }

    public static fn fromLocale(world: AppWorld, owner: string, locale: string) -> AppWorld {
        if (AppLocale.isRtlLocale(locale)) { return AppDirection.set(world, owner, appDirectionRtl()); }
        return AppDirection.set(world, owner, appDirectionLtr());
    }

    // "Start" is the leading edge: left in LTR, right in RTL.
    public static fn startPad(world: AppWorld, owner: string, leading: f32, trailing: f32) -> f32 {
        if (AppDirection.isRtl(world, owner)) { return trailing; }
        return leading;
    }

    public static fn endPad(world: AppWorld, owner: string, leading: f32, trailing: f32) -> f32 {
        if (AppDirection.isRtl(world, owner)) { return leading; }
        return trailing;
    }

    // Mirror a horizontal offset for a positioned element.
    public static fn mirrorX(world: AppWorld, owner: string, x: f32, width: f32) -> f32 {
        if (!AppDirection.isRtl(world, owner)) { return x; }
        return width - x;
    }
}

// ---------------------------------------------------------------------------
// Theme registry
// ---------------------------------------------------------------------------

// `UiTheme` is a class, so it cannot live in a resource - only the *mode* can.
// `resolve` therefore rebuilds the theme from the mode each time it is asked,
// which is cheap (a few dozen assignments) and keeps a single source of truth.
public class AppThemeRegistry {
    public static fn modeKey(owner: string) -> string { return "theme:" + owner + ":mode"; }

    public static fn setMode(world: AppWorld, owner: string, mode: i32) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setIntResource(AppThemeRegistry.modeKey(owner), mode);
    }

    public static fn mode(world: AppWorld, owner: string) -> i32 {
        return world.intResource(AppThemeRegistry.modeKey(owner), appThemeSystem());
    }

    // The mode a caller actually gets, once `system` has been resolved against
    // the platform's current preference.
    public static fn effectiveMode(world: AppWorld, owner: string) -> i32 {
        let mode = AppThemeRegistry.mode(world, owner);
        if (mode == appThemeSystem()) {
            let system = world.intResource(AppThemeRegistry.systemModeKey(owner), appThemeLight());
            if (system == appThemeDark()) { return appThemeDark(); }
            if (system == appThemeHighContrast()) { return appThemeHighContrast(); }
            return appThemeLight();
        }
        return mode;
    }

    public static fn systemModeKey(owner: string) -> string { return "theme:" + owner + ":system_mode"; }

    public static fn setSystemMode(world: AppWorld, owner: string, mode: i32) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setIntResource(AppThemeRegistry.systemModeKey(owner), mode);
    }

    public static fn resolve(world: AppWorld, owner: string) -> UiTheme {
        let mode = AppThemeRegistry.effectiveMode(world, owner);
        if (mode == appThemeDark()) { return UiTheme.dark(); }
        if (mode == appThemeHighContrast()) {
            return AppThemeRegistry.highContrast(AppThemeRegistry.contrastBase(world, owner));
        }
        return AppThemeRegistry.lightBase(world, owner);
    }

    // Whether the light theme is the plain one or the MD3 one is a single
    // choice, held here so that "we are on MD3" is not repeated at every call
    // site.
    public static fn md3Key(owner: string) -> string { return "theme:" + owner + ":md3"; }

    public static fn setMd3(world: AppWorld, owner: string, enabled: bool) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.setBoolResource(AppThemeRegistry.md3Key(owner), enabled);
    }

    public static fn usesMd3(world: AppWorld, owner: string) -> bool {
        return world.boolResource(AppThemeRegistry.md3Key(owner), false);
    }

    public static fn lightBase(world: AppWorld, owner: string) -> UiTheme {
        if (AppThemeRegistry.usesMd3(world, owner)) { return UiTheme.md3Light(); }
        return UiTheme.light();
    }

    public static fn contrastBase(world: AppWorld, owner: string) -> UiTheme {
        if (AppThemeRegistry.usesMd3(world, owner)) { return UiTheme.md3Dark(); }
        return UiTheme.dark();
    }

    // A high-contrast theme is *derived*, not authored: take the base, push the
    // text and the outline to full opacity, remove every translucent state
    // layer (a 0.08 hover tint is invisible to the user who needs this theme),
    // and thicken the shape so a focus ring reads at a glance.
    public static fn highContrast(base: UiTheme) -> UiTheme {
        var out = base.clone();
        out.text = Color.rgba(1.0, 1.0, 1.0, 1.0);
        out.muted_text = Color.rgba(0.92, 0.92, 0.94, 1.0);
        out.background = Color.rgba(0.0, 0.0, 0.0, 1.0);
        out.surface = Color.rgba(0.0, 0.0, 0.0, 1.0);
        out.surface_variant = Color.rgba(0.10, 0.10, 0.12, 1.0);
        out.panel = Color.rgba(0.06, 0.06, 0.08, 1.0);
        out.border = Color.rgba(1.0, 1.0, 1.0, 1.0);
        out.outline = Color.rgba(1.0, 1.0, 1.0, 1.0);
        out.outline_variant = Color.rgba(0.85, 0.85, 0.88, 1.0);
        out.primary = Color.rgba(1.0, 0.86, 0.30, 1.0);
        out.on_primary = Color.rgba(0.0, 0.0, 0.0, 1.0);
        out.accent = Color.rgba(1.0, 0.86, 0.30, 1.0);
        out.error_color = Color.rgba(1.0, 0.45, 0.42, 1.0);
        out.on_error_color = Color.rgba(0.0, 0.0, 0.0, 1.0);
        // A hover tint that cannot be seen is worse than no tint: make the
        // states opaque enough to matter, and drop the decorative elevation.
        out.state_hover_alpha = 0.28;
        out.state_focus_alpha = 0.40;
        out.state_pressed_alpha = 0.40;
        out.state_dragged_alpha = 0.48;
        out.disabled_container_alpha = 0.30;
        out.disabled_content_alpha = 0.70;
        out.elevation_overlay_alpha = 0.0;
        out.shape_small = out.shape_small + 2.0;
        out.shape_medium = out.shape_medium + 2.0;
        out.shape_large = out.shape_large + 2.0;
        return out;
    }
}

// ---------------------------------------------------------------------------
// Tokens
// ---------------------------------------------------------------------------

// A closed vocabulary. The point of a token is that it is *named*, so the name
// set is small and deliberate: everything a component needs to look like a
// component, and nothing that only one screen would want.
public class AppDesignTokens {
    // Colour tokens map to `UiTheme` fields. They intentionally overlap with
    // `appColorRole*`; the difference is that a role is what a *view* carries
    // and a token is what *code* resolves by name.
    public static fn colorFor(name: string, theme: UiTheme) -> Color {
        if (name == "background") { return theme.background; }
        if (name == "surface") { return theme.surface; }
        if (name == "surface-variant") { return theme.surface_variant; }
        if (name == "panel") { return theme.panel; }
        if (name == "text") { return theme.text; }
        if (name == "text-muted") { return theme.muted_text; }
        if (name == "primary") { return theme.primary; }
        if (name == "on-primary") { return theme.on_primary; }
        if (name == "primary-container") { return theme.primary_container; }
        if (name == "on-primary-container") { return theme.on_primary_container; }
        if (name == "secondary") { return theme.secondary; }
        if (name == "on-secondary") { return theme.on_secondary; }
        if (name == "secondary-container") { return theme.secondary_container; }
        if (name == "on-secondary-container") { return theme.on_secondary_container; }
        if (name == "danger") { return theme.error_color; }
        if (name == "on-danger") { return theme.on_error_color; }
        if (name == "outline") { return theme.outline; }
        if (name == "outline-variant") { return theme.outline_variant; }
        if (name == "accent") { return theme.accent; }
        return theme.text;
    }

    public static fn hasColor(name: string) -> bool {
        if (name == "background" || name == "surface" || name == "surface-variant") { return true; }
        if (name == "panel" || name == "text" || name == "text-muted") { return true; }
        if (name == "primary" || name == "on-primary" || name == "primary-container") { return true; }
        if (name == "on-primary-container" || name == "secondary" || name == "on-secondary") { return true; }
        if (name == "secondary-container" || name == "on-secondary-container") { return true; }
        if (name == "danger" || name == "on-danger" || name == "outline") { return true; }
        if (name == "outline-variant" || name == "accent") { return true; }
        return false;
    }

    public static fn spacingFor(name: string, theme: UiTheme) -> f32 {
        if (name == "xs") { return theme.spacing_xs; }
        if (name == "sm") { return theme.spacing_sm; }
        if (name == "md") { return theme.spacing_md; }
        if (name == "lg") { return theme.spacing_lg; }
        return theme.spacing_md;
    }

    public static fn radiusFor(name: string, theme: UiTheme) -> f32 {
        if (name == "none") { return 0.0; }
        if (name == "sm") { return theme.shape_small; }
        if (name == "md") { return theme.shape_medium; }
        if (name == "lg") { return theme.shape_large; }
        if (name == "full") { return theme.shape_full; }
        return theme.shape_medium;
    }

    public static fn fontSizeFor(name: string, theme: UiTheme) -> f32 {
        if (name == "label") { return theme.typography_label; }
        if (name == "body") { return theme.typography_body; }
        if (name == "title") { return theme.typography_title; }
        return theme.typography_body;
    }

    public static fn controlHeight(theme: UiTheme) -> f32 {
        return theme.control_height;
    }

    // Named states, so a component does not reach into the alpha fields itself.
    public static fn stateOverlay(name: string, theme: UiTheme, base: Color) -> Color {
        if (name == "hover") { return theme.hoverOverlay(base); }
        if (name == "focus") { return theme.focusOverlay(base); }
        if (name == "pressed") { return theme.pressedOverlay(base); }
        if (name == "dragged") { return theme.draggedOverlay(base); }
        if (name == "disabled") { return theme.disabledContainer(); }
        return base;
    }

    // Density scales the metrics, never the type. A compact desktop and a
    // comfortable one have the same font size and different breathing room,
    // which is what keeps a scaled layout readable.
    public static fn themeForDensity(theme: UiTheme, density: i32) -> UiTheme {
        if (density == appDensityCompact()) { return theme.withDensity(0.85); }
        if (density == appDensityComfortable()) { return theme.withDensity(1.15); }
        return theme;
    }
}

// ---------------------------------------------------------------------------
// Fonts
// ---------------------------------------------------------------------------

// The framework cannot ship a font binary, but it can decide *which* family a
// run of text should be measured with. `AppFontStack` is that decision: a list
// of families in preference order, plus a script classifier so a CJK run falls
// through to the CJK family instead of rendering tofu.
public class AppFontStack {
    public static fn familyListKey(owner: string, script: i32) -> string {
        return "font:" + owner + ":" + format("%d", script as i64);
    }

    public static fn setFamily(world: AppWorld, owner: string, script: i32, family: string) -> AppWorld {
        if (owner.len == 0) { return world; }
        var out = AppRowStore.clearList(world, AppFontStack.familyListKey(owner, script));
        return out.appendStringListResource(AppFontStack.familyListKey(owner, script), family);
    }

    public static fn addFallback(world: AppWorld, owner: string, script: i32, family: string) -> AppWorld {
        if (owner.len == 0) { return world; }
        return world.appendStringListResource(AppFontStack.familyListKey(owner, script), family);
    }

    public static fn familyCount(world: AppWorld, owner: string, script: i32) -> i32 {
        return world.stringListResourceCount(AppFontStack.familyListKey(owner, script));
    }

    public static fn familyAt(world: AppWorld, owner: string, script: i32, index: i32) -> string {
        return world.stringListResourceAt(AppFontStack.familyListKey(owner, script), index);
    }

    // Script classification by code point range. It is deliberately coarse:
    // the goal is "do not render CJK in a Latin-only face", not full Unicode
    // script property support.
    public static fn scriptFor(codepoint: i32) -> i32 {
        if (codepoint >= 0x1F300 && codepoint <= 0x1FAFF) { return appFontEmoji(); }
        if (codepoint >= 0x2600 && codepoint <= 0x27BF) { return appFontEmoji(); }
        if (codepoint >= 0xFE00 && codepoint <= 0xFE0F) { return appFontEmoji(); }
        // CJK unified ideographs, extensions, kana, hangul, CJK punctuation.
        if (codepoint >= 0x4E00 && codepoint <= 0x9FFF) { return appFontCjk(); }
        if (codepoint >= 0x3400 && codepoint <= 0x4DBF) { return appFontCjk(); }
        if (codepoint >= 0xF900 && codepoint <= 0xFAFF) { return appFontCjk(); }
        if (codepoint >= 0x3040 && codepoint <= 0x30FF) { return appFontCjk(); }
        if (codepoint >= 0xAC00 && codepoint <= 0xD7AF) { return appFontCjk(); }
        if (codepoint >= 0x3000 && codepoint <= 0x303F) { return appFontCjk(); }
        if (codepoint >= 0x20000 && codepoint <= 0x2FA1F) { return appFontCjk(); }
        if (codepoint >= 0x2190 && codepoint <= 0x21FF) { return appFontSymbol(); }
        if (codepoint >= 0x2200 && codepoint <= 0x22FF) { return appFontSymbol(); }
        if (codepoint >= 0x25A0 && codepoint <= 0x25FF) { return appFontSymbol(); }
        return appFontLatin();
    }

    // The script of the first character that is not whitespace decides the run.
    // A single face per run is what the renderer can actually honour today.
    public static fn scriptForText(text: string) -> i32 {
        var i: i32 = 0;
        while (i < (text.len as i32)) {
            let code = text.charAt(i as i64);
            if (code != 32 && code != 9 && code != 10 && code != 13) {
                return AppFontStack.scriptFor(code);
            }
            i = i + 1;
        }
        return appFontLatin();
    }

    // The family to measure `text` with: the first family registered for the
    // run's script, then the Latin stack as the universal fallback.
    public static fn resolveFor(world: AppWorld, owner: string, text: string) -> string {
        let script = AppFontStack.scriptForText(text);
        if (AppFontStack.familyCount(world, owner, script) > 0) {
            return AppFontStack.familyAt(world, owner, script, 0);
        }
        if (AppFontStack.familyCount(world, owner, appFontLatin()) > 0) {
            return AppFontStack.familyAt(world, owner, appFontLatin(), 0);
        }
        return "";
    }

    public static fn fallbacksFor(world: AppWorld, owner: string, text: string) -> i32 {
        let script = AppFontStack.scriptForText(text);
        return AppFontStack.familyCount(world, owner, script);
    }
}
