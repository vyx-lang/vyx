module Zyn.App;

use std.collections;
use Color = Zyn.Nut.Types.Color;

// These controls compose existing View primitives. Their actions remain owned
// by application code and are resolved through AppWorld's command registry.
public class FormField {
    public static fn text(id: string, label: string, placeholder: string, value_resource: string, change_action: string, error_resource: string) -> View {
        return Column.create().id(id).gap(6.0)
            .child(Text.body(label).id(id + ".label").height(24.0))
            .child(TextField.bound(id + ".input", placeholder, value_resource, change_action).height(44.0))
            .child(Text.mutedBound(error_resource, "").id(id + ".error").height(20.0)
                .foreground(Color.rgba(0.70, 0.08, 0.12, 1.0)));
    }
}

public class SearchBar {
    public static fn create(id: string, placeholder: string, value_resource: string, change_action: string, clear_action: string) -> View {
        return Row.create().id(id).gap(8.0).height(48.0)
            .child(TextField.bound(id + ".query", placeholder, value_resource, change_action).expanded().height(44.0))
            .child(Button.tonalAction(id + ".clear", "Clear", clear_action).size(72.0, 44.0));
    }
}

public class Disclosure {
    public static fn create(id: string, title: string, expanded_resource: string, toggle_action: string, world: AppWorld, content: View) -> View {
        var out = Column.create().id(id).gap(6.0)
            .child(Button.tonalAction(id + ".toggle", title, toggle_action).height(42.0));
        if (world.boolResource(expanded_resource, false)) {
            out = out.child(content);
        }
        return out;
    }
}

public class EmptyState {
    public static fn create(id: string, title: string, description: string, action_label: string, action_name: string) -> View {
        return Column.create().id(id).gap(10.0).alignCenter()
            .child(Text.title(title).id(id + ".title").height(42.0))
            .child(Text.body(description).id(id + ".description").height(32.0))
            .child(Button.filledAction(id + ".action", action_label, action_name).height(44.0));
    }
}

public class ChoiceGroup {
    @[borrow_args]
    public static fn create(id: string, labels: Vec<string>, actions: Vec<string>, selected: i32) -> View {
        var out = Row.create().id(id).gap(8.0);
        var i: i32 = 0;
        while (i < (labels.len as i32) && i < (actions.len as i32)) {
            var choice = Button.tonalAction(id + "." + format("%d", i as i64), labels.get(i as i64), actions.get(i as i64));
            if (i == selected) {
                choice = Button.filledAction(id + "." + format("%d", i as i64), labels.get(i as i64), actions.get(i as i64));
            }
            out = out.child(choice.height(42.0));
            i = i + 1;
        }
        return out;
    }
}

public class DataGrid {
    // cells is row-major and may be shorter than the final row.
    @[borrow_args]
    public static fn create(id: string, headers: Vec<string>, cells: Vec<string>) -> View {
        var out = Column.create().id(id).gap(4.0);
        let columns = headers.len as i32;
        if (columns <= 0) { return out; }
        var heading = Row.create().id(id + ".head").gap(12.0);
        var column: i32 = 0;
        while (column < columns) {
            heading = heading.child(Text.body(headers.get(column as i64)).id(id + ".head." + format("%d", column as i64)).expanded().height(32.0));
            column = column + 1;
        }
        out = out.child(heading);
        var row_index: i32 = 0;
        var cell_index: i32 = 0;
        while (cell_index < (cells.len as i32)) {
            var row = Row.create().id(id + ".row." + format("%d", row_index as i64)).gap(12.0);
            column = 0;
            while (column < columns) {
                var value = "";
                if (cell_index < (cells.len as i32)) { value = cells.get(cell_index as i64); }
                row = row.child(Text.body(value).id(id + ".cell." + format("%d", cell_index as i64)).expanded().height(30.0));
                cell_index = cell_index + 1;
                column = column + 1;
            }
            out = out.child(row);
            row_index = row_index + 1;
        }
        return out;
    }
}
