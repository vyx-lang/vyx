module Zyn.App;

use Event = Zyn.Platform.Event.Event;
use Window = Zyn.Platform.Window.Window;
use Rect = Zyn.Platform.Window.Rect;
use WindowFlags = Zyn.Platform.Window.WindowFlags;
use Clock = Zyn.Platform.Clock.Clock;
use Point = Zyn.Nut.Types.Point;
use Color = Zyn.Nut.Types.Color;
use colorTransparent = Zyn.Nut.Types.colorTransparent;
use colorBlack = Zyn.Nut.Types.colorBlack;
use colorWhite = Zyn.Nut.Types.colorWhite;
use colorRgbaMilli = Zyn.Nut.Types.colorRgbaMilli;
use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use Renderer = Zyn.Nut.Renderer.Renderer;
use FontFace = Zyn.Nut.Text.FontFace;
use GlyphCache = Zyn.Nut.Text.GlyphCache;
use SceneBuilder = Zyn.Nut.Scene.SceneBuilder;
use UiTree = Zyn.UI.UiTree;
use UiNode = Zyn.UI.UiNode;
use uiTextPrefixForUtf8Chars = Zyn.UI.uiTextPrefixForUtf8Chars;

public class AppSession {
    private runtime: AppRuntime;
    private font: FontFace;
    private glyph_cache: GlyphCache;
    private rendered_frames: i32;
    private last_node_count: i32;
    private last_draw_commands: i32;
    private last_processed_actions: i32;
    private last_text_input_id: string;
    private last_text_input_x: i32;
    private last_text_input_y: i32;
    private last_text_input_w: i32;
    private last_text_input_h: i32;
    private last_text_input_cursor: i32;
    private last_component_revision: u64;
    private playback: AppTimeline;
    private playback_active: bool;
    private playback_index: i32;

    public static fn create(runtime: AppRuntime, spec: AppSpec) -> Result<AppSession, AppError> {
        if (spec.renderer.font_path.len == 0) {
            return Err(AppError.create(40, "App renderer font path is required for text rendering"));
        }
        if (spec.renderer.font_size <= 0) {
            return Err(AppError.create(41, "App renderer font size must be positive"));
        }
        if (spec.renderer.glyph_atlas_width <= 0 || spec.renderer.glyph_atlas_height <= 0 || spec.renderer.glyph_atlas_padding < 0) {
            return Err(AppError.create(42, "App glyph atlas dimensions are invalid"));
        }

        var font: FontFace;
        match (FontFace.open(spec.renderer.font_path, spec.renderer.font_size)) {
            case Ok(v) => { font = v; }
            case Err(e) => { return Err(AppError.create(43, e.message)); }
        }

        let cache = GlyphCache.create(
            spec.renderer.glyph_atlas_width,
            spec.renderer.glyph_atlas_height,
            spec.renderer.glyph_atlas_padding,
            colorWhite()
        );

        return Ok(AppSession {
            runtime: runtime.dup(),
            font: font,
            glyph_cache: cache,
            rendered_frames: 0,
            last_node_count: 0,
            last_draw_commands: 0,
            last_processed_actions: 0,
            last_text_input_id: "",
            last_text_input_x: -1,
            last_text_input_y: -1,
            last_text_input_w: -1,
            last_text_input_h: -1,
            last_text_input_cursor: -1,
            last_component_revision: runtime.stateRevision(),
            playback: AppTimeline.empty(),
            playback_active: false,
            playback_index: 0
        });
    }

    public fn handlePlatformEvent(mut self, event: Event) -> AppSession {
        if (event.isWindowResized() && event.data1 > 0 && event.data2 > 0) {
            self.runtime = self.runtime.resize(f32FromInt(event.data1), f32FromInt(event.data2));
        }
        if (event.isMouseButtonDown()) {
            let point = self.runtime.mapInputPoint(Point.xy(event.x, event.y));
            self.runtime = self.runtime.queuePointerDown(point);
            self.runtime = self.runtime.runInteractionSystems();
        }
        if (event.isMouseButtonUp()) {
            let point = self.runtime.mapInputPoint(Point.xy(event.x, event.y));
            self.runtime = self.runtime.queuePointerUp(point);
            self.runtime = self.runtime.runInteractionSystems();
        }
        if (event.isMouseMotion()) {
            let point = self.runtime.mapInputPoint(Point.xy(event.x, event.y));
            let dx = self.runtime.inputDeltaX(event.xrel);
            let dy = self.runtime.inputDeltaY(event.yrel);
            self.runtime = self.runtime.queuePointerMoved(point, dx, dy);
            if (event.mouse_buttons != 0 as u32) {
                self.runtime = self.runtime.queuePointerDragged(point, dx, dy);
            }
            self.runtime = self.runtime.runInteractionSystems();
        }
        if (event.isMouseWheel()) {
            let point = Point.xy(self.runtime.floatResource("ui.pointer.x", f32Zero()), self.runtime.floatResource("ui.pointer.y", f32Zero()));
            self.runtime = self.runtime.queuePointerScrolled(point, event.x, event.y);
            self.runtime = self.runtime.runInteractionSystems();
        }
        // SDL touch coordinates and deltas are normalized to the window. Map
        // them into the same display-independent units used by hit testing.
        if (event.isTouch()) {
            let point = self.runtime.mapNormalizedTouchPoint(event.x, event.y);
            if (event.isFingerDown()) {
                self.runtime = self.runtime.queuePointerDown(point);
            } else if (event.isFingerMotion()) {
                let dx = self.runtime.touchDeltaX(event.dx);
                let dy = self.runtime.touchDeltaY(event.dy);
                self.runtime = self.runtime.queuePointerMoved(point, dx, dy);
                if (self.runtime.boolResource("ui.pointer.down", false)) {
                    self.runtime = self.runtime.queuePointerDragged(point, dx, dy);
                }
            } else if (event.isFingerUp() || event.isFingerCanceled()) {
                self.runtime = self.runtime.queuePointerUp(point);
            }
            self.runtime = self.runtime.runInteractionSystems();
        }
        if (event.isTextEditing() && self.runtime.focusedIsTextInput()) {
            let id = self.runtime.focusedId();
            if (id.len > 0 && event.editing_text.len == 0) {
                self.runtime = self.runtime.clearTextInputComposition(id);
            }
        }
        // Every key press goes through the shared keyboard route. A focused
        // text field keeps Backspace/Delete for editing; Esc and Tab are left
        // to the route so focus rules stay uniform everywhere.
        if (event.isKeyDown()) {
            var consumed_by_text: bool = false;
            if (self.runtime.focusedIsTextInput() && (event.key == 8 || event.key == 127)) {
                self.runtime = self.runtime.backspaceFocusedTextInput();
                consumed_by_text = true;
            }
            if (!consumed_by_text) {
                self.runtime = self.runtime.queueKeyDown(event.key, event.modifiers, event.repeated);
                self.runtime = self.runtime.runInteractionSystems();
            }
        }
        if (event.isKeyUp()) {
            self.runtime = self.runtime.queueKeyUp(event.key, event.modifiers);
            self.runtime = self.runtime.runInteractionSystems();
        }
        if (event.isTextInput() && self.runtime.focusedId().len > 0) {
            self.runtime = self.runtime.clearTextInputComposition(self.runtime.focusedId());
            self.runtime = self.runtime.queueTextInput(self.runtime.focusedId(), event.text);
            self.runtime = self.runtime.runInteractionSystems();
        }
        return self;
    }

    public fn eventNeedsTextInputSync(&self, event: Event) -> bool {
        return event.isWindowResized()
            || event.isMouseButtonDown()
            || event.isMouseButtonUp()
            || event.isTouch()
            || event.isKeyDown()
            || event.isKeyUp()
            || event.isTextEditing()
            || event.isTextEditingCandidates()
            || event.isTextInput();
    }

    private fn textInputCursorOffset(&self, node: UiNode) -> i32 {
        var caret_text = node.text;
        if (node.composition_text.len > 0) {
            caret_text = caret_text + uiTextPrefixForUtf8Chars(node.composition_text, node.composition_start);
        }

        var cursor_ui = node.padding;
        if (caret_text.len > 0) {
            match (self.font.shape(caret_text)) {
                case Ok(layout) => {
                    cursor_ui = cursor_ui + (f32FromInt(layout.advance_x));
                    layout.destroy();
                }
                case Err(_) => {}
            }
        }

        let min_cursor = node.padding;
        var max_cursor = node.bounds.width - node.padding;
        if (max_cursor < min_cursor) { max_cursor = min_cursor; }
        if (cursor_ui < min_cursor) { cursor_ui = min_cursor; }
        if (cursor_ui > max_cursor) { cursor_ui = max_cursor; }
        return self.runtime.uiLengthXToWindow(cursor_ui);
    }

    public fn handleWindowEvent(&mut self, window: Window, event: Event) -> Result<AppSession, AppError> {
        self = self.handlePlatformEvent(event);
        if (self.eventNeedsTextInputSync(event)) {
            return self.syncTextInput(window);
        }
        return Ok(self);
    }

    public fn updateComponent(mut self, component: dyn Component, event: AppEvent) -> AppSession {
        self.runtime = self.runtime.updateComponent(component, event);
        return self;
    }

    @[borrow_args]
    public fn syncTextInputWithTree(&mut self, window: Window, tree: UiTree) -> Result<AppSession, AppError> {
        var wants_text_input = self.runtime.focusedIsTextInput() && !window.flags().has(WindowFlags.hidden());
        if (wants_text_input) {
            let focused_id = self.runtime.focusedId();
            let focused_index = tree.find(focused_id);
            if (focused_index >= 0) {
                let focused_node = tree.nodeAt(focused_index);
                if (focused_node.bounds.width > f32Zero() && focused_node.bounds.height > f32Zero()) {
                    let area = Rect.create(
                        self.runtime.uiXToWindow(focused_node.bounds.x),
                        self.runtime.uiYToWindow(focused_node.bounds.y),
                        self.runtime.uiLengthXToWindow(focused_node.bounds.width),
                        self.runtime.uiLengthYToWindow(focused_node.bounds.height)
                    );
                    let cursor = self.textInputCursorOffset(focused_node);
                    let text_input_inactive = !window.textInputActive();
                    let area_changed = text_input_inactive
                        || self.last_text_input_id != focused_id
                        || self.last_text_input_x != area.x
                        || self.last_text_input_y != area.y
                        || self.last_text_input_w != area.width
                        || self.last_text_input_h != area.height
                        || self.last_text_input_cursor != cursor;
                    if (text_input_inactive) {
                        match (window.startTextInput()) {
                            case Ok(_) => {}
                            case Err(e4) => {
                                return Err(AppError.create(47, e4.message));
                            }
                        }
                    }
                    if (area_changed) {
                        match (window.setTextInputArea(area, cursor)) {
                            case Ok(_) => {}
                            case Err(e5) => {
                                return Err(AppError.create(48, e5.message));
                            }
                        }
                        self.last_text_input_id = focused_id;
                        self.last_text_input_x = area.x;
                        self.last_text_input_y = area.y;
                        self.last_text_input_w = area.width;
                        self.last_text_input_h = area.height;
                        self.last_text_input_cursor = cursor;
                    }
                } else {
                    wants_text_input = false;
                }
            } else {
                wants_text_input = false;
            }
        }
        if (!wants_text_input && (self.last_text_input_id.len > 0 || window.textInputActive())) {
            match (window.stopTextInput()) {
                case Ok(_) => {}
                case Err(e6) => {
                    return Err(AppError.create(49, e6.message));
                }
            }
            self.last_text_input_id = "";
            self.last_text_input_x = -1;
            self.last_text_input_y = -1;
            self.last_text_input_w = -1;
            self.last_text_input_h = -1;
            self.last_text_input_cursor = -1;
        }
        return Ok(self);
    }

    public fn syncTextInput(&mut self, window: Window) -> Result<AppSession, AppError> {
        var tree = self.runtime.toUiTree();
        match (self.syncTextInputWithTree(window, tree)) {
            case Ok(v) => {
                tree.destroy();
                return Ok(v);
            }
            case Err(e) => {
                tree.destroy();
                return Err(e);
            }
        }
    }

    // `renderer` must be borrowed, never taken by value: a `class` parameter
    // in Vyx is a raw bitwise copy, so a by-value Renderer would duplicate
    // every Cacao handle it owns (owns=true twice). The copy's
    // `destroy()`/realloc would then release resources the caller still
    // holds, producing use-after-free + double free (heap corruption).
    public fn render(&mut self, window: Window, renderer: &mut Renderer) -> Result<AppSession, AppError> {
        return self.renderWithComponent(window, renderer, ZynComponent.create(""));
    }

    public fn renderWithComponent(&mut self, window: Window, renderer: &mut Renderer, component: dyn Component) -> Result<AppSession, AppError> {
        var logical_width: f32 = f32Zero();
        var logical_height: f32 = f32Zero();
        var pixel_width: f32 = f32Zero();
        var pixel_height: f32 = f32Zero();
        match (window.size()) {
            case Ok(size) => {
                logical_width = f32FromInt(size.width);
                logical_height = f32FromInt(size.height);
            }
            case Err(_) => {}
        }
        match (window.pixelSize()) {
            case Ok(pixel_size) => {
                pixel_width = f32FromInt(pixel_size.width);
                pixel_height = f32FromInt(pixel_size.height);
            }
            case Err(_) => {}
        }
        if (logical_width > f32Zero() && logical_height > f32Zero()) {
            self.runtime = self.runtime.syncViewportFromDisplay(logical_width, logical_height, pixel_width, pixel_height, window.displayScale());
        }
        if (self.playback_active) {
            var advancing: bool = true;
            while (advancing && self.playback_index < self.playback.count()) {
                let step = self.playback.stepAt(self.playback_index);
                if (step.execution_frame > self.runtime.frameIndex()) {
                    advancing = false;
                } else {
                    match (self.runtime.applyTimelineStep(step)) {
                        case Ok(_) => {}
                        case Err(e) => { return Err(e); }
                    }
                    self.playback_index = self.playback_index + 1;
                }
            }
        }
        if (self.playback_active) {
            self.runtime = self.runtime.playbackFrameAtMillis(self.runtime.frameIndex() * (16 as u64));
        } else {
            self.runtime = self.runtime.frameAtMillis(Clock.ticks());
        }
        // Scroll inertia advances once per frame, before the tree is rebuilt.
        self.runtime = self.runtime.runScrollInertia();
        if (component.id().len > 0 && self.runtime.stateRevision() != self.last_component_revision) {
            // Rebuild only when the pending change set touches this component's
            // namespace; unrelated state changes must not rebuild the page.
            let needs_rebuild = self.runtime.componentNeedsRebuild(component.id());
            if (needs_rebuild) {
                var world = self.runtime.worldSnapshot();
                var content = component.view(world);
                var root = AppSurface.stage(component.id() + ".root", content);
                self.runtime = self.runtime.replaceRoot(root);
                root.destroy();
                content.destroy();
                world.destroy();
            }
            self.last_component_revision = self.runtime.stateRevision();
            self.runtime = self.runtime.clearDirtyResources();
        }
        var tree = self.runtime.toUiTree();
        // Focus order is re-derived from the tree each frame, so nodes removed
        // by a rebuild stop being reachable by Tab on the very next frame.
        self.runtime = self.runtime.syncFocusOrderFromTree(tree);
        match (self.syncTextInputWithTree(window, tree)) {
            case Ok(v7) => { self = v7; }
            case Err(e7) => {
                tree.destroy();
                return Err(e7);
            }
        }
        var scene = SceneBuilder.create().clear(self.runtime.themeBackground());
        scene = scene.scale(self.runtime.renderScale(), self.runtime.renderScale());
        scene = tree.render(scene);
        match (tree.renderText(scene, &self.font, &mut self.glyph_cache)) {
            case Ok(v) => { scene = v; }
            case Err(e) => {
                scene.destroy();
                tree.destroy();
                return Err(AppError.create(44, e.message));
            }
        }
        scene = scene.restoreAll();
        match (renderer.updateSpriteAtlas(self.glyph_cache.atlas)) {
            case Ok(_) => {}
            case Err(e2) => {
                scene.destroy();
                tree.destroy();
                return Err(AppError.create(45, e2.message));
            }
        }
        let graph = scene.buildGraph();
        match (renderer.renderGraphToWindow(window, graph)) {
            case Ok(_) => {}
            case Err(e3) => {
                graph.destroy();
                scene.destroy();
                tree.destroy();
                return Err(AppError.create(46, e3.message));
            }
        }
        self.rendered_frames = self.rendered_frames + 1;
        self.last_node_count = tree.nodeCount();
        self.last_draw_commands = graph.drawCommandCount();
        self.last_processed_actions = self.runtime.processedActionCount();
        graph.destroy();
        scene.destroy();
        tree.destroy();
        return Ok(self);
    }

    public fn runtimeFrameIndex(&self) -> u64 {
        return self.runtime.frameIndex();
    }

    public fn renderedFrameCount(&self) -> i32 {
        return self.rendered_frames;
    }

    public fn lastNodeCount(&self) -> i32 {
        return self.last_node_count;
    }

    public fn lastDrawCommandCount(&self) -> i32 {
        return self.last_draw_commands;
    }

    public fn processedActionCount(&self) -> i32 {
        return self.last_processed_actions;
    }

    // Publishes the platform-neutral semantic tree to whichever bridge the host
    // installed. Called by the host after a frame, and directly by tests.
    public fn publishAccessibility(&self, bridge: dyn AppAccessibilityBridge) -> i32 {
        return self.runtime.publishAccessibilityTo(bridge);
    }

    public fn accessibilitySnapshotText(&self) -> string {
        return self.runtime.accessibilitySnapshotText();
    }

    public fn accessibilityFocusedNode(&self) -> AccessibilityNode {
        return self.runtime.accessibilityFocusedNode();
    }

    public fn exportTimeline(&self, path: string) -> Result<bool, AppError> {
        return self.runtime.exportTimeline(path);
    }

    @[borrow_args]
    public fn startPlayback(&mut self, timeline: AppTimeline) -> Result<bool, AppError> {
        if (self.runtime.applicationState() != timeline.initial_state) {
            return Err(AppError.create(89, "initial state differs from timeline"));
        }
        self.playback.destroy();
        self.playback = timeline.dup();
        self.playback_active = true;
        self.playback_index = 0;
        return Ok(true);
    }

    @[borrow_args]
    public fn resetPlayback(&mut self, runtime: AppRuntime) -> Result<bool, AppError> {
        self.runtime.destroy();
        self.runtime = runtime.dup();
        self.last_component_revision = self.runtime.stateRevision();
        self.playback_index = 0;
        self.last_text_input_id = "";
        self.last_text_input_x = -1;
        self.last_text_input_y = -1;
        self.last_text_input_w = -1;
        self.last_text_input_h = -1;
        self.last_text_input_cursor = -1;
        if (self.runtime.applicationState() != self.playback.initial_state) {
            return Err(AppError.create(89, "initial state differs from timeline"));
        }
        return Ok(true);
    }

    public fn playbackFinished(&self) -> bool {
        var frame_count = self.playback.total_frames;
        if (frame_count <= 0) { frame_count = 1; }
        return self.playback_active && self.playback_index >= self.playback.count()
            && self.runtime.frameIndex() >= frame_count as u64;
    }

    public fn intResource(&self, id: string, value: i32) -> i32 {
        return self.runtime.intResource(id, value);
    }

    public fn stringResource(&self, id: string, value: string) -> string {
        return self.runtime.stringResource(id, value);
    }

    public fn boolResource(&self, id: string, value: bool) -> bool {
        return self.runtime.boolResource(id, value);
    }

    public fn destroy(&mut self) {
        self.runtime.destroy();
        self.playback.destroy();
        self.glyph_cache.destroy();
        self.font.close();
    }
}
