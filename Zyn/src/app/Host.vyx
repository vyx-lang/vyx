module Zyn.App;

use f32FromInt = Zyn.Nut.Types.f32FromInt;
use Platform = Zyn.Platform.Platform.Platform;
use Window = Zyn.Platform.Window.Window;
use EventLoop = Zyn.Platform.Event.EventLoop;
use LifecycleEventKind = Zyn.Platform.Event.LifecycleEventKind;
use FrameScheduler = Zyn.Platform.Clock.FrameScheduler;
use Clock = Zyn.Platform.Clock.Clock;
use Renderer = Zyn.Nut.Renderer.Renderer;
use RendererDesc = Zyn.Nut.Renderer.RendererDesc;
use UiTheme = Zyn.UI.UiTheme;

public class AppHost {
    public static fn sceneToAppScene(scene: dyn Scene) -> AppScene {
        let root = scene.view();
        var out = AppScene.create(scene.id(), scene.title(), root);
        out = scene.configure(out);
        root.destroy();
        return out;
    }

    public static fn runApplicationWithOptions(app: dyn Application, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        let identity = app.identity();
        var spec = AppSpec.create(identity.name, identity.identifier, 420, 720)
            .setIdentity(identity);
        spec = app.configure(spec);
        app.start(AppContext.create(spec));
        var scene = app.rootScene();
        let runtime = AppRuntime.create(scene.root, scene.world, spec.theme, f32FromInt(spec.window.width), f32FromInt(spec.window.height));
        scene.destroy();
        let lifecycle_scene = SceneBase.create("zyn.app.lifecycle", "App Lifecycle");
        match (AppHost.runLifecycleRuntimeWithOptions(app, lifecycle_scene, false, spec, runtime, options)) {
            case Ok(report) => {
                app.stop();
                return Ok(report);
            }
            case Err(e) => {
                app.stop();
                return Err(e);
            }
        }
    }

    public static fn runSceneApplicationWithOptions(app: dyn Application, scene: dyn Scene, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        let identity = app.identity();
        var spec = AppSpec.create(identity.name, identity.identifier, 420, 720)
            .setIdentity(identity);
        spec = app.configure(spec);
        let app_ctx = AppContext.create(spec);
        app.start(app_ctx);
        scene.enter(SceneContext.create(AppContext.create(spec), spec.window.width, spec.window.height));
        var app_scene = AppHost.sceneToAppScene(scene);
        let runtime = AppRuntime.create(app_scene.root, app_scene.world, spec.theme, f32FromInt(spec.window.width), f32FromInt(spec.window.height));
        app_scene.destroy();
        match (AppHost.runLifecycleRuntimeWithOptions(app, scene, true, spec, runtime, options)) {
            case Ok(report) => {
                scene.leave();
                app.stop();
                return Ok(report);
            }
            case Err(e) => {
                scene.leave();
                app.stop();
                return Err(e);
            }
        }
    }

    public static fn runApplicationForFrames(app: dyn Application, frames: i32) -> Result<AppRunReport, AppError> {
        return AppHost.runApplicationWithOptions(app, AppRunOptions.frames(frames));
    }

    public static fn runSceneApplicationForFrames(app: dyn Application, scene: dyn Scene, frames: i32) -> Result<AppRunReport, AppError> {
        return AppHost.runSceneApplicationWithOptions(app, scene, AppRunOptions.frames(frames));
    }

    public static fn runForFrames(spec: AppSpec, frames: i32) -> Result<AppRunReport, AppError> {
        return AppHost.runWithOptions(spec, AppRunOptions.frames(frames));
    }

    public static fn runRootForFrames(spec: AppSpec, root: View, world: AppWorld, frames: i32) -> Result<AppRunReport, AppError> {
        return AppHost.runRootWithOptions(spec, root, world, AppRunOptions.frames(frames));
    }

    public static fn runRootWithOptions(spec: AppSpec, root: View, world: AppWorld, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        let runtime = AppRuntime.create(root, world, spec.theme, f32FromInt(spec.window.width), f32FromInt(spec.window.height));
        return AppHost.runRuntimeWithOptions(spec, runtime, options);
    }

    public static fn runLifecycleRuntimeWithOptions(app: dyn Application, scene: dyn Scene, dispatch_scene_updates: bool, spec: AppSpec, runtime: AppRuntime, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        if (options.timeline_error.len > 0) { return Err(AppError.create(91, options.timeline_error)); }
        if (options.reply_path.len > 0 && !options.reply_headless) {
            return AppHost.runRuntimeWithComponent(spec, runtime, options, ZynComponent.create(""));
        }
        if (options.reply_path.len > 0 && options.reply_headless) {
            match (AppTimeline.load(options.reply_path)) {
                case Ok(timeline) => {
                    let result = runtime.replyTimeline(timeline, options.repetitions);
                    var owned_timeline = timeline;
                    owned_timeline.destroy();
                    match (result) {
                        case Ok(actions) => { return Ok(AppRunReport.create(0, options.repetitions, 0, false).withRenderStats(0, 0, 0, actions)); }
                        case Err(e) => { return Err(e); }
                    }
                }
                case Err(e) => { return Err(e); }
            }
        }
        var prepared = runtime.dup();
        if (options.recording_path.len > 0) { prepared = prepared.startRecording(); }
        match (Platform.setMetadata(spec.identity.name, spec.identity.version, spec.identity.identifier)) {
            case Ok(_) => {}
            case Err(e) => { prepared.destroy(); return Err(AppError.create(1, e.message)); }
        }

        match (Platform.initWithFlags(spec.init_flags)) {
            case Ok(_) => {}
            case Err(e2) => { prepared.destroy(); return Err(AppError.create(2, e2.message)); }
        }

        var window: Window;
        match (Window.create(spec.windowDesc())) {
            case Ok(v) => { window = v; }
            case Err(e3) => {
                Platform.quit();
                prepared.destroy();
                return Err(AppError.create(3, e3.message));
            }
        }

        if (options.show_window) {
            match (window.show()) {
                case Ok(_) => {}
                case Err(e4) => {
                    window.destroy();
                    Platform.quit();
                    prepared.destroy();
                    return Err(AppError.create(4, e4.message));
                }
            }
        }

        let renderer_desc = RendererDesc.create(spec.identity.name, spec.renderer.width, spec.renderer.height)
            .setBackendName(spec.renderer.backend_name)
            .setClearColor(spec.renderer.clear_color)
            .setShaderPath(spec.renderer.shader_path)
            .setShaderCacheDirectory(spec.renderer.shader_cache_dir)
            .setSpriteAtlasPath(spec.renderer.sprite_atlas_path);
        var renderer: Renderer;
        match (Renderer.create(window, renderer_desc)) {
            case Ok(v2) => { renderer = v2; }
            case Err(e5) => {
                window.destroy();
                Platform.quit();
                prepared.destroy();
                return Err(AppError.create(5, e5.message));
            }
        }

        let setup_status = spec.renderer_setup(&mut renderer);
        if (setup_status != 0) {
            renderer.destroy();
            window.destroy();
            Platform.quit();
            prepared.destroy();
            return Err(AppError.create(setup_status, "renderer setup failed"));
        }

        var session: AppSession;
        match (AppSession.create(prepared, spec)) {
            case Ok(v3) => { session = v3; }
            case Err(e6) => {
                renderer.destroy();
                window.destroy();
                Platform.quit();
                prepared.destroy();
                return Err(e6);
            }
        }
        prepared.destroy();

        var scheduler = FrameScheduler.create(spec.target_fps);
        var frames_done: i32 = 0;
        var events_seen: i32 = 0;
        var quit_requested: bool = false;
        var running: bool = true;
        var suspended: bool = false;
        while (running) {
            if (options.max_frames > 0 && frames_done >= options.max_frames) {
                running = false;
            } else {
                EventLoop.pump();
                if (options.poll_events) {
                    var polling: bool = true;
                    while (polling) {
                        match (EventLoop.poll()) {
                            case Some(ev) => {
                                events_seen = events_seen + 1;
                                if (ev.isBackgroundTransition()) { suspended = true; }
                                if (ev.raw_type == LifecycleEventKind.didEnterForeground()) { suspended = false; }
                                let app_event = AppEvent.platform(ev);
                                app.update(app_event);
                                if (dispatch_scene_updates) {
                                    scene.update(app_event);
                                }
                                if (options.close_on_quit && app_event.isQuit()) {
                                    quit_requested = true;
                                    polling = false;
                                    running = false;
                                } else {
                                    match (session.handleWindowEvent(window, ev)) {
                                        case Ok(v8) => { session = v8; }
                                        case Err(e8) => {
                                            session.destroy();
                                            renderer.destroy();
                                            window.destroy();
                                            Platform.quit();
                                            return Err(e8);
                                        }
                                    }
                                }
                            }
                            case None => { polling = false; }
                        }
                    }
                }

                if (running && suspended) { Clock.delay(16 as u32); }
                if (running && !suspended) {
                    scheduler = scheduler.beginFrame();
                    let frame_event = AppEvent.frame(scheduler.frameIndex(), scheduler.deltaNS());
                    app.update(frame_event);
                    if (dispatch_scene_updates) {
                        scene.update(frame_event);
                    }
                    match (session.render(window, &mut renderer)) {
                        case Ok(v4) => { session = v4; }
                        case Err(e7) => {
                            session.destroy();
                            renderer.destroy();
                            window.destroy();
                            Platform.quit();
                            return Err(e7);
                        }
                    }
                    frames_done = frames_done + 1;
                    scheduler = scheduler.sleepUntilNextFrame();
                }
            }
        }

        let rendered_frames = session.renderedFrameCount();
        let node_count = session.lastNodeCount();
        let draw_commands = session.lastDrawCommandCount();
        let processed_actions = session.processedActionCount();
        if (options.recording_path.len > 0) {
            match (session.exportTimeline(options.recording_path)) {
                case Ok(_) => {}
                case Err(export_error) => {
                    session.destroy(); renderer.destroy(); window.destroy(); Platform.quit();
                    return Err(export_error);
                }
            }
        }
        session.destroy();
        renderer.destroy();
        window.destroy();
        Platform.quit();
        return Ok(AppRunReport.create(0, frames_done, events_seen, quit_requested).withRenderStats(rendered_frames, node_count, draw_commands, processed_actions));
    }

    public static fn runRuntimeWithOptions(spec: AppSpec, runtime: AppRuntime, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        return AppHost.runRuntimeWithComponent(spec, runtime, options, ZynComponent.create(""));
    }

    public static fn runComponentWithOptions(spec: AppSpec, root: View, world: AppWorld, options: AppRunOptions, component: dyn Component) -> Result<AppRunReport, AppError> {
        let runtime = AppRuntime.create(root, world, spec.theme, f32FromInt(spec.window.width), f32FromInt(spec.window.height));
        return AppHost.runRuntimeWithComponent(spec, runtime, options, component);
    }

    public static fn runRuntimeWithComponent(spec: AppSpec, runtime: AppRuntime, options: AppRunOptions, component: dyn Component) -> Result<AppRunReport, AppError> {
        if (options.timeline_error.len > 0) { return Err(AppError.create(91, options.timeline_error)); }
        var visual_reply: bool = false;
        var playback = AppTimeline.empty();
        if (options.reply_path.len > 0 && options.reply_headless) {
            match (AppTimeline.load(options.reply_path)) {
                case Ok(timeline) => {
                    let result = runtime.replyTimeline(timeline, options.repetitions);
                    var owned_timeline = timeline;
                    owned_timeline.destroy();
                    match (result) {
                        case Ok(actions) => { return Ok(AppRunReport.create(0, options.repetitions, 0, false).withRenderStats(0, 0, 0, actions)); }
                        case Err(e) => { return Err(e); }
                    }
                }
                case Err(e) => { return Err(e); }
            }
        }
        if (options.reply_path.len > 0) {
            match (AppTimeline.load(options.reply_path)) {
                case Ok(timeline) => {
                    playback = timeline;
                    visual_reply = true;
                }
                case Err(e) => { return Err(e); }
            }
        }
        var prepared = runtime.dup();
        if (options.recording_path.len > 0 && !visual_reply) { prepared = prepared.startRecording(); }
        match (Platform.setMetadata(spec.identity.name, spec.identity.version, spec.identity.identifier)) {
            case Ok(_) => {}
            case Err(e) => { prepared.destroy(); playback.destroy(); return Err(AppError.create(1, e.message)); }
        }

        match (Platform.initWithFlags(spec.init_flags)) {
            case Ok(_) => {}
            case Err(e2) => { prepared.destroy(); playback.destroy(); return Err(AppError.create(2, e2.message)); }
        }

        var window: Window;
        match (Window.create(spec.windowDesc())) {
            case Ok(v) => { window = v; }
            case Err(e3) => {
                Platform.quit();
                prepared.destroy();
                playback.destroy();
                return Err(AppError.create(3, e3.message));
            }
        }

        if (options.show_window || visual_reply) {
            match (window.show()) {
                case Ok(_) => {}
                case Err(e4) => {
                    window.destroy();
                    Platform.quit();
                    prepared.destroy();
                    playback.destroy();
                    return Err(AppError.create(4, e4.message));
                }
            }
        }

        let renderer_desc = RendererDesc.create(spec.identity.name, spec.renderer.width, spec.renderer.height)
            .setBackendName(spec.renderer.backend_name)
            .setClearColor(spec.renderer.clear_color)
            .setShaderPath(spec.renderer.shader_path)
            .setShaderCacheDirectory(spec.renderer.shader_cache_dir)
            .setSpriteAtlasPath(spec.renderer.sprite_atlas_path);
        var renderer: Renderer;
        match (Renderer.create(window, renderer_desc)) {
            case Ok(v2) => { renderer = v2; }
            case Err(e5) => {
                window.destroy();
                Platform.quit();
                prepared.destroy();
                playback.destroy();
                return Err(AppError.create(5, e5.message));
            }
        }

        let setup_status = spec.renderer_setup(&mut renderer);
        if (setup_status != 0) {
            renderer.destroy();
            window.destroy();
            Platform.quit();
            prepared.destroy();
            playback.destroy();
            return Err(AppError.create(setup_status, "renderer setup failed"));
        }

        var session: AppSession;
        match (AppSession.create(prepared, spec)) {
            case Ok(v3) => { session = v3; }
            case Err(e6) => {
                renderer.destroy();
                window.destroy();
                Platform.quit();
                prepared.destroy();
                playback.destroy();
                return Err(e6);
            }
        }
        prepared.destroy();

        if (visual_reply) {
            match (session.startPlayback(playback)) {
                case Ok(_) => {}
                case Err(e) => {
                    session.destroy(); renderer.destroy(); window.destroy(); Platform.quit();
                    playback.destroy();
                    return Err(e);
                }
            }
        }

        var scheduler = FrameScheduler.create(spec.target_fps);
        var frames_done: i32 = 0;
        var events_seen: i32 = 0;
        var quit_requested: bool = false;
        var running: bool = true;
        var repetitions_done: i32 = 0;
        var suspended: bool = false;
        while (running) {
            if (!visual_reply && options.max_frames > 0 && frames_done >= options.max_frames) {
                running = false;
            } else {
                EventLoop.pump();
                if (options.poll_events) {
                    var polling: bool = true;
                    while (polling) {
                        match (EventLoop.poll()) {
                            case Some(ev) => {
                                events_seen = events_seen + 1;
                                if (ev.isBackgroundTransition()) { suspended = true; }
                                if (ev.raw_type == LifecycleEventKind.didEnterForeground()) { suspended = false; }
                                let app_event = AppEvent.platform(ev);
                                if (options.close_on_quit && app_event.isQuit()) {
                                    quit_requested = true;
                                    polling = false;
                                    running = false;
                                } else {
                                    if (!visual_reply || ev.isWindowResized()) {
                                        match (session.handleWindowEvent(window, ev)) {
                                            case Ok(v8) => { session = v8; }
                                            case Err(e8) => {
                                                session.destroy();
                                                renderer.destroy();
                                                window.destroy();
                                                Platform.quit();
                                                playback.destroy();
                                                return Err(e8);
                                            }
                                        }
                                        if (!visual_reply) {
                                            session = session.updateComponent(component, app_event);
                                        }
                                    }
                                }
                            }
                            case None => { polling = false; }
                        }
                    }
                }

                if (running && suspended) { Clock.delay(16 as u32); }
                if (running && !suspended) {
                    scheduler = scheduler.beginFrame();
                    if (!visual_reply) {
                        session = session.updateComponent(component, AppEvent.frame(scheduler.frameIndex(), scheduler.deltaNS()));
                    }
                    match (session.renderWithComponent(window, &mut renderer, component)) {
                        case Ok(v4) => { session = v4; }
                        case Err(e7) => {
                            session.destroy();
                            renderer.destroy();
                            window.destroy();
                            Platform.quit();
                            playback.destroy();
                            return Err(e7);
                        }
                    }
                    frames_done = frames_done + 1;
                    if (visual_reply && session.playbackFinished()) {
                        repetitions_done = repetitions_done + 1;
                        if (repetitions_done >= options.repetitions) {
                            running = false;
                        } else {
                            match (session.resetPlayback(runtime)) {
                                case Ok(_) => {}
                                case Err(e9) => {
                                    session.destroy(); renderer.destroy(); window.destroy(); Platform.quit();
                                    playback.destroy();
                                    return Err(e9);
                                }
                            }
                        }
                    }
                    scheduler = scheduler.sleepUntilNextFrame();
                }
            }
        }

        let rendered_frames = session.renderedFrameCount();
        let node_count = session.lastNodeCount();
        let draw_commands = session.lastDrawCommandCount();
        var processed_actions = session.processedActionCount();
        if (visual_reply && repetitions_done < options.repetitions) {
            session.destroy(); renderer.destroy(); window.destroy(); Platform.quit(); playback.destroy();
            return Err(AppError.create(93, "visual reply interrupted before all repetitions completed"));
        }
        if (visual_reply) { processed_actions = playback.count() * repetitions_done; }
        if (options.recording_path.len > 0 && !visual_reply) {
            match (session.exportTimeline(options.recording_path)) {
                case Ok(_) => {}
                case Err(export_error) => {
                    session.destroy();
                    renderer.destroy();
                    window.destroy();
                    Platform.quit();
                    playback.destroy();
                    return Err(export_error);
                }
            }
        }
        session.destroy();
        playback.destroy();
        renderer.destroy();
        window.destroy();
        Platform.quit();
        return Ok(AppRunReport.create(0, frames_done, events_seen, quit_requested).withRenderStats(rendered_frames, node_count, draw_commands, processed_actions));
    }

    public static fn runWithOptions(spec: AppSpec, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        match (Platform.setMetadata(spec.identity.name, spec.identity.version, spec.identity.identifier)) {
            case Ok(_) => {}
            case Err(e) => { return Err(AppError.create(1, e.message)); }
        }

        match (Platform.initWithFlags(spec.init_flags)) {
            case Ok(_) => {}
            case Err(e2) => { return Err(AppError.create(2, e2.message)); }
        }

        var window: Window;
        match (Window.create(spec.windowDesc())) {
            case Ok(v) => { window = v; }
            case Err(e3) => {
                Platform.quit();
                return Err(AppError.create(3, e3.message));
            }
        }

        if (options.show_window) {
            match (window.show()) {
                case Ok(_) => {}
                case Err(e4) => {
                    window.destroy();
                    Platform.quit();
                    return Err(AppError.create(4, e4.message));
                }
            }
        }

        var scheduler = FrameScheduler.create(spec.target_fps);
        var frames_done: i32 = 0;
        var events_seen: i32 = 0;
        var quit_requested: bool = false;
        var running: bool = true;
        while (running) {
            if (options.max_frames > 0 && frames_done >= options.max_frames) {
                running = false;
            } else {
                EventLoop.pump();
                if (options.poll_events) {
                    var polling: bool = true;
                    while (polling) {
                        match (EventLoop.poll()) {
                            case Some(ev) => {
                                events_seen = events_seen + 1;
                                let app_event = AppEvent.platform(ev);
                                if (options.close_on_quit && app_event.isQuit()) {
                                    quit_requested = true;
                                    polling = false;
                                    running = false;
                                }
                            }
                            case None => { polling = false; }
                        }
                    }
                }

                if (running) {
                    scheduler = scheduler.beginFrame();
                    let frame_event = AppEvent.frame(scheduler.frameIndex(), scheduler.deltaNS());
                    if (frame_event.isFrame()) {
                        frames_done = frames_done + 1;
                    }
                    scheduler = scheduler.sleepUntilNextFrame();
                }
            }
        }

        window.destroy();
        Platform.quit();
        return Ok(AppRunReport.create(0, frames_done, events_seen, quit_requested));
    }
}
