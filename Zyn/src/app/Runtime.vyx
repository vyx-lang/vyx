    }

    public fn layerCount(&self) -> i32 {
        return self.world_state.layerCount();
    }

    public fn layerAt(&self, index: i32) -> AppLayer {
        return self.world_state.layerAt(index);
    }

    public fn topLayerId(&self) -> string {
        return self.world_state.topLayerId();
    }

    public fn topModalLayerId(&self) -> string {
        return self.world_state.topModalLayerId();
    }

    public fn componentNeedsRebuild(&self, component_id: string) -> bool {
        return self.world_state.componentNeedsRebuild(component_id);
    }

    public fn clearDirtyResources(mut self) -> AppRuntime {
        self.world_state = self.world_state.clearDirtyResources();
        return self;
    }

    // Replaces the default `<component_id>.` watch namespace with an explicit
    // one, so a component can subscribe to just the keys it renders.
    public fn addComponentWatchPrefix(mut self, component_id: string, prefix: string) -> AppRuntime {
        self.world_state = self.world_state.addComponentWatchPrefix(component_id, prefix);
        return self;
    }

