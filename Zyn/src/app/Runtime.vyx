    public fn snapshot(&self) -> AppFrameSnapshot {
        var tree = self.toUiTree();
        let count = tree.nodeCount();
        tree.destroy();
        return AppFrameSnapshot.create(
            self.frame_index,
            count,
            self.world_state.pendingActionCount(),
            self.world_state.totalActionCount(),
            self.processed_actions,
            self.world_state.focusedId(),
            self.last_hit_id
        );
    }

    public fn hitTest(&self, point: Point) -> AppHitResult {
        var tree = self.toUiTree();
        let index = tree.hitTest(point);
        if (index < 0) {
            tree.destroy();
            return AppHitResult.miss();
        }
        let node = tree.nodeAt(index);
        // A modal layer swallows hits outside itself, so a click on the scrim
        // cannot reach a control that sits behind the dialog.
        let modal = self.world_state.topModalLayerId();
        if (modal.len > 0 && self.world_state.layerOfViewId(node.id) != modal) {
            tree.destroy();
            return AppHitResult.miss();
        }
        let action = self.world_state.actionNameForViewId(node.id);
        let route = tree.nodePathFromIndex(index);
        tree.destroy();
        return AppHitResult.createWithNode(index, node.id, action, route, node.kind, node.bounds);
    }

    public fn handleTap(mut self, point: Point) -> AppRuntime {
        self = self.queuePointerDown(point);
        self = self.queuePointerUp(point);
        return self.runInteractionSystems();
    }

    public fn dispatchViewAction(mut self, id: string) -> AppRuntime {
        self.last_hit_id = id;
        self.world_state = self.world_state.dispatchViewAction(id);
        return self;
    }

    public fn dispatchViewActionWithPayload(mut self, id: string, payload: string) -> AppRuntime {
        self.last_hit_id = id;
        self.world_state = self.world_state.dispatchViewActionWithPayload(id, payload);
        return self;
    }

    public fn handleTextInput(mut self, id: string, text: string) -> AppRuntime {
        self = self.queueTextInput(id, text);
        return self.runInteractionSystems();
    }

    public fn handleValueInput(mut self, id: string, value: f32) -> AppRuntime {
        return self.handleTextInput(id, app_format_f32(value));
    }

    public fn handleCheckedInput(mut self, id: string, checked: bool) -> AppRuntime {
        return self.handleTextInput(id, app_format_bool(checked));
    }

    public fn handleSliderDrag(mut self, point: Point) -> AppRuntime {
        self = self.queuePointerDragged(point, f32Zero(), f32Zero());
        return self.runInteractionSystems();
    }

    public fn handleSliderDragXY(mut self, x: f32, y: f32) -> AppRuntime {
        return self.handleSliderDrag(Point.xy(x, y));
    }

    public fn applyNextCommand(mut self) -> AppRuntime {
        match (self.world_state.drainNextAction()) {
            case Some(action) => {
                var state_before = "";
                if (self.recording) { state_before = self.world_state.snapshotResources(); }
                self.world_state = self.world_state.applyCommandForAction(action.dup());
                self.processed_actions = self.processed_actions + 1;
                if (self.recording) {
                    self.timeline = self.timeline.record(self.frame_index, action, state_before, self.world_state);
                    if (self.timeline.total_frames <= self.frame_index as i32) {
                        self.timeline.total_frames = (self.frame_index + 1 as u64) as i32;
                    }
                }
            }
            case None => {}
        }
        return self;
    }

    public fn applyAllCommands(mut self) -> AppRuntime {
        while (self.world_state.pendingActionCount() > 0) { self = self.applyNextCommand(); }
        return self;
    }

    public fn startRecording(mut self) -> AppRuntime {
        self.timeline.destroy();
        self.timeline = AppTimeline.start(self.world_state);
        self.recording = true;
        self.recording_started = true;
        return self;
    }

    public fn stopRecording(mut self) -> AppRuntime {
        self.recording = false;
        return self;
    }

    public fn recordedTimeline(&self) -> AppTimeline { return self.timeline.dup(); }

    public fn exportTimeline(&self, path: string) -> Result<bool, AppError> {
        if (!self.recording_started) { return Err(AppError.create(87, "recording was not started")); }
        return self.timeline.exportTo(path);
    }

    // Each repetition starts from an independently cloned configured runtime.
    // No SDL, renderer, wall clock, or external IO is used by this loop.
    @[borrow_args]
    public fn replyTimeline(&self, timeline: AppTimeline, repetitions: i32) -> Result<i32, AppError> {
        if (repetitions <= 0) { return Err(AppError.create(88, "repetitions must be positive")); }
        var run: i32 = 0;
        while (run < repetitions) {
            var current = self.dup();
            if (current.world_state.snapshotResources() != timeline.initial_state) {
                current.destroy();
                return Err(AppError.create(89, "initial state differs from timeline"));
            }
            var step_i: i32 = 0;
            while (step_i < timeline.count()) {
                let step = timeline.stepAt(step_i);
                current.frame_index = step.execution_frame;
                current.world_state = current.world_state.setTransientIntResource("ui.frame.index", step.execution_frame as i32);
                match (current.applyTimelineStep(step)) {
                    case Ok(_) => {}
                    case Err(e) => {
                        current.destroy();
                        return Err(AppError.create(e.code, e.message + " at repetition " + format("%d", (run + 1) as i64)));
                    }
                }
                step_i = step_i + 1;
            }
            current.destroy();
            run = run + 1;
        }
        return Ok(timeline.count() * repetitions);
    }

    public fn applyTimelineStep(&mut self, step: AppTimelineStep) -> Result<bool, AppError> {
        match (self.world_state.restoreSnapshotResources(step.state_before)) {
            case Ok(restored) => { self.world_state = restored; }
            case Err(e) => { return Err(e); }
        }
        if (self.world_state.pendingActionCount() > 0) {
            let queued = self.world_state.actionAt(0);
            if (queued.name != step.action.name || queued.source != step.action.source
                || queued.payload != step.action.payload || queued.frame_index != step.action.frame_index) {
                return Err(AppError.create(90, "reply command queue differs at action " + format("%d", step.sequence as i64)));
            }
            match (self.world_state.drainNextAction()) {
                case Some(_) => {}
                case None => { return Err(AppError.create(90, "reply command queue changed")); }
            }
        }
        self.world_state = self.world_state.applyCommandForAction(step.action.dup());
        self.processed_actions = self.processed_actions + 1;
        if (self.world_state.snapshotResources() != step.state_after) {
            return Err(AppError.create(90, "reply state mismatch at action " + format("%d", step.sequence as i64)));
        }
        return Ok(true);
    }

    public fn frame(mut self) -> AppRuntime {
        let synthetic_ms = self.frame_index * (16 as u64);
        return self.frameAtMillis(synthetic_ms);
    }

    public fn frameAtMillis(mut self, now_ms: u64) -> AppRuntime {
        self.world_state = self.world_state.runInteractionSystems();
        self = self.applyAllCommands();
        self.world_state = self.root.bindActions(self.world_state);
        self.world_state = self.world_state.clearInteractionEvents();
        return self.advanceFrameClock(now_ms);
    }

    // Playback executes only actions present in the timeline. Advancing the
    // visual frame must not consume commands emitted by an earlier action.
    public fn playbackFrameAtMillis(mut self, now_ms: u64) -> AppRuntime {
        self.world_state = self.root.bindActions(self.world_state);
        self.world_state = self.world_state.clearInteractionEvents();
        return self.advanceFrameClock(now_ms);
    }

    private fn advanceFrameClock(mut self, now_ms: u64) -> AppRuntime {
        self.frame_index = self.frame_index + 1 as u64;
        self.world_state = self.world_state.setTransientIntResource("ui.frame.index", self.frame_index as i32);
        self.world_state = self.world_state.setTransientIntResource("ui.caret.blink.phase.ms", (now_ms % (1000 as u64)) as i32);
        if (self.recording && self.timeline.total_frames < self.frame_index as i32) {
            self.timeline.total_frames = self.frame_index as i32;
        }
        return self;
    }

    public fn focusNext(mut self) -> AppRuntime {
        self.world_state = self.world_state.focusNext();
        return self;
    }

    public fn focusPrevious(mut self) -> AppRuntime {
        self.world_state = self.world_state.focusPrevious();
        return self;
    }

    public fn requestFocus(&self, id: string) -> bool {
        return self.world_state.requestFocus(id);
    }

    public fn clearFocus(mut self) -> AppRuntime {
        self.world_state = self.world_state.clearFocus();
        return self;
    }

    public fn focusedId(&self) -> string {
        return self.world_state.focusedId();
    }

    public fn focusedIsTextInput(&self) -> bool {
        return self.world_state.isTextInputViewId(self.world_state.focusedId());
    }

    public fn focusedTextInputResourceId(&self) -> string {
        return self.world_state.textInputResourceForViewId(self.world_state.focusedId());
    }

    public fn replaceFocusedTextInput(mut self, value: string) -> AppRuntime {
        let id = self.world_state.focusedId();
        if (!self.world_state.isTextInputViewId(id)) { return self; }
        let resource_id = self.world_state.textInputResourceForViewId(id);
        if (resource_id.len == 0) { return self; }
        self.world_state = self.world_state.setStringResource(resource_id, value);
        self.world_state = self.world_state.setStringResource("text_input_composition:" + id, "");
        self.world_state = self.world_state.setIntResource("text_input_composition_start:" + id, 0);
        self.world_state = self.world_state.setIntResource("text_input_composition_length:" + id, 0);
        self.world_state = self.world_state.dispatchTextInputActionWithPayload(id, value);
        return self;
    }

    public fn backspaceFocusedTextInput(mut self) -> AppRuntime {
        let resource_id = self.focusedTextInputResourceId();
        if (resource_id.len == 0) { return self; }
        let value = self.world_state.stringResource(resource_id, "");
        if (value.len == 0) { return self; }
        var cut: i32 = value.len - 1;
        while (cut > 0) {
            let c = value.charAt(cut);
            if (c < 128 || c >= 192) { break; }
            cut = cut - 1;
        }
        return self.replaceFocusedTextInput(value.substring(0, cut));
    }

    public fn pendingActionCount(&self) -> i32 {
        return self.world_state.pendingActionCount();
    }

    public fn totalActionCount(&self) -> i32 {
        return self.world_state.totalActionCount();
    }

    public fn frameIndex(&self) -> u64 {
        return self.frame_index;
    }

    public fn processedActionCount(&self) -> i32 {
        return self.processed_actions;
    }

    public fn stateRevision(&self) -> u64 {
        return self.world_state.stateRevision();
    }

    public fn worldSnapshot(&self) -> AppWorld { return self.world_state.dup(); }

    public fn updateComponent(mut self, component: dyn Component, event: AppEvent) -> AppRuntime {
        self.world_state = component.update(event, self.world_state);
        return self;
    }

    public fn applicationState(&self) -> string { return self.world_state.snapshotResources(); }

    public fn resourceCount(&self) -> i32 {
        return self.world_state.totalResourceCount();
    }

    public fn componentCount(&self) -> i32 {
        return self.world_state.componentCount();
    }


    public fn lastHitId(&self) -> string {
        return self.last_hit_id;
    }

    public fn dup(&self) -> AppRuntime {
        let cloned_world = self.world_state.dup();
        return AppRuntime {
            root: self.root.dup(),
            world_state: cloned_world,
            theme: self.theme.dup(),
            viewport_width: self.viewport_width,
            viewport_height: self.viewport_height,
            render_scale: self.render_scale,
            input_scale_x: self.input_scale_x,
            input_scale_y: self.input_scale_y,
            frame_index: self.frame_index,
            processed_actions: self.processed_actions,
            last_hit_id: self.last_hit_id,
            recording: self.recording,
            recording_started: self.recording_started,
            timeline: self.timeline.dup()
        };
    }

    public fn destroy(&mut self) {
        self.root.destroy();
        self.world_state.destroy();
        self.timeline.destroy();
    }
}
