module Zyn.App;

use Point = Zyn.Nut.Types.Point;
use Rectangle = Zyn.Nut.Types.Rectangle;
use pointUnpack = Zyn.Nut.Types.pointUnpack;
use Color = Zyn.Nut.Types.Color;
use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use UiTheme = Zyn.UI.UiTheme;
use UiTree = Zyn.UI.UiTree;
use uiNodeSlider = Zyn.UI.uiNodeSlider;
use uiNodeCustom = Zyn.UI.uiNodeCustom;
use uiNodeRender = Zyn.UI.uiNodeRender;
use AppInteractionEvent = Zyn.App.AppInteractionEvent;

// Local coordinates are serialized into the normal action payload. This keeps
// pointer-driven canvas commands deterministic under recording and reply.
public fn appCanvasPointerPayload(bounds: Rectangle, x: f32, y: f32, dx: f32, dy: f32) -> string {
    return app_format_f32(x - bounds.x) + "|" + app_format_f32(y - bounds.y)
        + "|" + app_format_f32(dx) + "|" + app_format_f32(dy);
}

public class CanvasPointer {
    public x: f32;
    public y: f32;
    public dx: f32;
    public dy: f32;
    public valid: bool;

    public static fn fromPayload(payload: string) -> CanvasPointer {
        var parts = payload.split("|");
        var pointer = CanvasPointer { x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, valid: false };
        if (parts.len == 4) {
            pointer.valid = true;
            match (f32_from_str(parts.get(0 as i64))) {
                case Ok(value) => { pointer.x = value; }
                case Err(_) => { pointer.valid = false; }
            }
            match (f32_from_str(parts.get(1 as i64))) {
                case Ok(value) => { pointer.y = value; }
                case Err(_) => { pointer.valid = false; }
            }
            match (f32_from_str(parts.get(2 as i64))) {
                case Ok(value) => { pointer.dx = value; }
                case Err(_) => { pointer.valid = false; }
            }
            match (f32_from_str(parts.get(3 as i64))) {
                case Ok(value) => { pointer.dy = value; }
                case Err(_) => { pointer.valid = false; }
            }
        }
        parts.destroy();
        return pointer;
    }

    public static fn fromAction(action: AppAction) -> CanvasPointer {
        return CanvasPointer.fromPayload(action.payload);
    }
}

public class AppHitResult {
    public hit: bool;
    public index: i32;
    public id: string;
    public action_name: string;
    public route: string;
    public kind: i32;
    public bounds: Rectangle;

    public static fn miss() -> AppHitResult {
        return AppHitResult {
            hit: false,
            index: -1,
            id: "",
            action_name: "",
            route: "",
            kind: -1,
            bounds: Rectangle.xywh(0.0, 0.0, 0.0, 0.0)
        };
    }

    public static fn create(index: i32, id: string, action_name: string, route: string) -> AppHitResult {
        return AppHitResult.createWithNode(index, id, action_name, route, -1, Rectangle.xywh(0.0, 0.0, 0.0, 0.0));
    }

    public static fn createWithNode(index: i32, id: string, action_name: string, route: string, kind: i32, bounds: Rectangle) -> AppHitResult {
        return AppHitResult {
            hit: true,
            index: index,
            id: id,
            action_name: action_name,
            route: route,
            kind: kind,
            bounds: bounds
        };
    }
}

public class AppFrameSnapshot {
    public frame_index: u64;
    public node_count: i32;
    public pending_actions: i32;
    public total_actions: i32;
    public processed_actions: i32;
    public focused_id: string;
    public last_hit_id: string;

    public static fn create(frame_index: u64, node_count: i32, pending_actions: i32, total_actions: i32, processed_actions: i32, focused_id: string, last_hit_id: string) -> AppFrameSnapshot {
        return AppFrameSnapshot {
            frame_index: frame_index,
            node_count: node_count,
            pending_actions: pending_actions,
            total_actions: total_actions,
            processed_actions: processed_actions,
            focused_id: focused_id,
            last_hit_id: last_hit_id
        };
    }

    public fn hasView(&self) -> bool {
        return self.node_count > 0;
    }
}

public class AppRuntime {
    private root: View;
    private world_state: AppWorld;
    private theme: UiTheme;
    private viewport_width: f32;
    private viewport_height: f32;
    private render_scale: f32;
    private input_scale_x: f32;
    private input_scale_y: f32;
    private frame_index: u64;
    private processed_actions: i32;
    private last_hit_id: string;
    private recording: bool;
    private recording_started: bool;
    private timeline: AppTimeline;

    public static fn create(root: View, world: AppWorld, theme: UiTheme, width: f32, height: f32) -> AppRuntime {
        let copied_root = root.dup();
        var bound_world = copied_root.bindActions(world.dup());
        return AppRuntime {
            root: copied_root,
            world_state: bound_world,
            theme: theme.dup(),
            viewport_width: width,
            viewport_height: height,
            render_scale: f32One(),
            input_scale_x: f32One(),
            input_scale_y: f32One(),
            frame_index: 0 as u64,
            processed_actions: 0,
            last_hit_id: "",
            recording: false,
            recording_started: false,
            timeline: AppTimeline.empty()
        };
    }

    public static fn fromRoot(root: View, width: f32, height: f32) -> AppRuntime {
        return AppRuntime.create(root, AppWorld.create(), UiTheme.md3(), width, height);
    }

    public fn resize(mut self, width: f32, height: f32) -> AppRuntime {
        self.viewport_width = width;
        self.viewport_height = height;
        return self;
    }

    public fn setInputScale(mut self, scale_x: f32, scale_y: f32) -> AppRuntime {
        self.input_scale_x = scale_x;
        self.input_scale_y = scale_y;
        return self;
    }

    public fn syncViewportFromSizes(self, logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32) -> AppRuntime {
        return self.syncViewportFromDisplay(logical_width, logical_height, pixel_width, pixel_height, f32One());
    }

    // Layout uses display-independent units; only the render graph uses physical pixels.
    public fn syncViewportFromDisplay(mut self, logical_width: f32, logical_height: f32, pixel_width: f32, pixel_height: f32, display_scale: f32) -> AppRuntime {
        self.render_scale = f32One();
        if (display_scale > f32Zero()) { self.render_scale = display_scale; }
        if (pixel_width > f32Zero() && pixel_height > f32Zero()) {
            self.viewport_width = pixel_width / self.render_scale;
            self.viewport_height = pixel_height / self.render_scale;
        } else {
            self.viewport_width = logical_width;
            self.viewport_height = logical_height;
            self.render_scale = f32One();
        }
        if (logical_width > f32Zero() && logical_height > f32Zero() && pixel_width > f32Zero() && pixel_height > f32Zero()) {
            self.input_scale_x = self.viewport_width / logical_width;
            self.input_scale_y = self.viewport_height / logical_height;
        } else {
            self.input_scale_x = f32One();
            self.input_scale_y = f32One();
        }
        return self;
    }

    public fn renderScale(&self) -> f32 { return self.render_scale; }

    public fn viewportWidth(&self) -> f32 { return self.viewport_width; }

    public fn viewportHeight(&self) -> f32 { return self.viewport_height; }

    public fn mapNormalizedTouchPoint(&self, x: f32, y: f32) -> Point {
        return Point.xy(x * self.viewport_width, y * self.viewport_height);
    }

    public fn touchDeltaX(&self, dx: f32) -> f32 { return dx * self.viewport_width; }

    public fn touchDeltaY(&self, dy: f32) -> f32 { return dy * self.viewport_height; }

    public fn inputDeltaX(&self, dx: f32) -> f32 { return dx * self.input_scale_x; }

    public fn inputDeltaY(&self, dy: f32) -> f32 { return dy * self.input_scale_y; }

    public fn mapInputPoint(&self, point: Point) -> Point {
        let xy = pointUnpack(point);
        return Point.xy(xy.x * self.input_scale_x, xy.y * self.input_scale_y);
    }

    public fn uiXToWindow(&self, value: f32) -> i32 {
        if (self.input_scale_x > f32Zero()) { return ((value / self.input_scale_x) + f32FromMilli(500)) as i32; }
        return (value + f32FromMilli(500)) as i32;
    }

    public fn uiYToWindow(&self, value: f32) -> i32 {
        if (self.input_scale_y > f32Zero()) { return ((value / self.input_scale_y) + f32FromMilli(500)) as i32; }
        return (value + f32FromMilli(500)) as i32;
    }

    public fn uiLengthXToWindow(&self, value: f32) -> i32 {
        if (self.input_scale_x > f32Zero()) { return ((value / self.input_scale_x) + f32FromMilli(500)) as i32; }
        return (value + f32FromMilli(500)) as i32;
    }

    public fn uiLengthYToWindow(&self, value: f32) -> i32 {
        if (self.input_scale_y > f32Zero()) { return ((value / self.input_scale_y) + f32FromMilli(500)) as i32; }
        return (value + f32FromMilli(500)) as i32;
    }

    public fn setTheme(mut self, theme: UiTheme) -> AppRuntime {
        self.theme = theme.dup();
        return self;
    }

    public fn replaceRoot(mut self, root: View) -> AppRuntime {
        self.root.destroy();
        self.root = root.dup();
        self.world_state = self.root.bindActions(self.world_state);
        return self;
    }

    public fn bindRootActions(mut self) -> AppRuntime {
        self.world_state = self.root.bindActions(self.world_state);
        return self;
    }

    public fn setStringResource(mut self, id: string, value: string) -> AppRuntime {
        self.world_state = self.world_state.setStringResource(id, value);
        return self;
    }

    public fn setTextInputComposition(mut self, id: string, composition: string, start: i32, length: i32) -> AppRuntime {
        self.world_state = self.world_state.setStringResource("text_input_composition:" + id, composition);
        self.world_state = self.world_state.setIntResource("text_input_composition_start:" + id, start);
        self.world_state = self.world_state.setIntResource("text_input_composition_length:" + id, length);
        return self;
    }

    public fn clearTextInputComposition(mut self, id: string) -> AppRuntime {
        return self.setTextInputComposition(id, "", 0, 0);
    }

    public fn setIntResource(mut self, id: string, value: i32) -> AppRuntime {
        self.world_state = self.world_state.setIntResource(id, value);
        return self;
    }

    public fn setFloatResource(mut self, id: string, value: f32) -> AppRuntime {
        self.world_state = self.world_state.setFloatResource(id, value);
        return self;
    }

    public fn setBoolResource(mut self, id: string, value: bool) -> AppRuntime {
        self.world_state = self.world_state.setBoolResource(id, value);
        return self;
    }

    public fn appendStringListResource(mut self, id: string, value: string) -> AppRuntime {
        self.world_state = self.world_state.appendStringListResource(id, value);
        self.world_state = self.root.bindActions(self.world_state);
        return self;
    }

    public fn appendBoolListResource(mut self, id: string, value: bool) -> AppRuntime {
        self.world_state = self.world_state.appendBoolListResource(id, value);
        self.world_state = self.root.bindActions(self.world_state);
        return self;
    }

    public fn stringListResourceCount(&self, id: string) -> i32 {
        return self.world_state.stringListResourceCount(id);
    }

    public fn stringListResourceAt(&self, id: string, index: i32) -> string {
        return self.world_state.stringListResourceAt(id, index);
    }

    public fn boolListResourceAt(&self, id: string, index: i32) -> bool {
        return self.world_state.boolListResourceAt(id, index);
    }

    public fn stringResource(&self, id: string, fallback: string) -> string {
        return self.world_state.stringResource(id, fallback);
    }

    public fn intResource(&self, id: string, fallback: i32) -> i32 {
        return self.world_state.intResource(id, fallback);
    }

    public fn floatResource(&self, id: string, fallback: f32) -> f32 {
        return self.world_state.floatResource(id, fallback);
    }

    public fn boolResource(&self, id: string, fallback: bool) -> bool {
        return self.world_state.boolResource(id, fallback);
    }

    public fn registerIntDeltaCommand(mut self, action_name: string, target_resource: string, delta: i32) -> AppRuntime {
        self.world_state = self.world_state.registerIntDeltaCommand(action_name, target_resource, delta);
        return self;
    }

    public fn registerBoolToggleCommand(mut self, action_name: string, target_resource: string) -> AppRuntime {
        self.world_state = self.world_state.registerBoolToggleCommand(action_name, target_resource);
        return self;
    }

    public fn registerStringSetCommand(mut self, action_name: string, target_resource: string) -> AppRuntime {
        self.world_state = self.world_state.registerStringSetCommand(action_name, target_resource);
        return self;
    }

    public fn registerIntSetCommand(mut self, action_name: string, target_resource: string) -> AppRuntime {
        self.world_state = self.world_state.registerIntSetCommand(action_name, target_resource);
        return self;
    }

    public fn registerFloatSetCommand(mut self, action_name: string, target_resource: string) -> AppRuntime {
        self.world_state = self.world_state.registerFloatSetCommand(action_name, target_resource);
        return self;
    }

    public fn registerBoolSetCommand(mut self, action_name: string, target_resource: string) -> AppRuntime {
        self.world_state = self.world_state.registerBoolSetCommand(action_name, target_resource);
        return self;
    }

    public fn registerBehavior(mut self, action_name: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppRuntime {
        self.world_state = self.world_state.registerBehavior(action_name, handler);
        return self;
    }

    public fn registerBehaviorPrefix(mut self, action_prefix: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppRuntime {
        self.world_state = self.world_state.registerBehaviorPrefix(action_prefix, handler);
        return self;
    }

    public fn registerCommandHandler(mut self, handler: Box<dyn AppCommandHandler>) -> AppRuntime {
        self.world_state = self.world_state.registerCommandHandler(handler);
        return self;
    }

    public fn toUiTree(&self) -> UiTree {
        return self.root.toUiTreeWithWorld(self.viewport_width, self.viewport_height, self.theme, self.world_state);
    }

    public fn queueInteractionEvent(mut self, event: AppInteractionEvent) -> AppRuntime {
        self.world_state = self.world_state.emitInteractionEvent(event);
        return self;
    }

    public fn runInteractionSystems(mut self) -> AppRuntime {
        self.world_state = self.world_state.runInteractionSystems();
        return self;
    }

    public fn queuePointerMoved(mut self, point: Point, dx: f32, dy: f32) -> AppRuntime {
        let xy = pointUnpack(point);
        let hit = self.hitTest(point);
        self.last_hit_id = hit.id;
        let action = self.world_state.pointerMovedActionNameForViewId(hit.id);
        var event = AppInteractionEvent.pointerMoved(hit.id, action, xy.x, xy.y, dx, dy, self.frame_index);
        if (hit.kind == uiNodeCustom() || hit.kind == uiNodeRender()) { event.payload = appCanvasPointerPayload(hit.bounds, xy.x, xy.y, dx, dy); }
        return self.queueInteractionEvent(event.withRoute(hit.route));
    }

    public fn queuePointerDown(mut self, point: Point) -> AppRuntime {
        let xy = pointUnpack(point);
        let hit = self.hitTest(point);
        self.last_hit_id = hit.id;
        let action = self.world_state.pointerDownActionNameForViewId(hit.id);
        var event = AppInteractionEvent.pointerDown(hit.id, action, xy.x, xy.y, self.frame_index);
        if (hit.kind == uiNodeCustom() || hit.kind == uiNodeRender()) { event.payload = appCanvasPointerPayload(hit.bounds, xy.x, xy.y, f32Zero(), f32Zero()); }
        return self.queueInteractionEvent(event.withRoute(hit.route));
    }

    public fn queuePointerUp(mut self, point: Point) -> AppRuntime {
        let xy = pointUnpack(point);
        let hit = self.hitTest(point);
        self.last_hit_id = hit.id;
        let action = self.world_state.pointerUpActionNameForViewId(hit.id);
        var event = AppInteractionEvent.pointerUp(hit.id, action, xy.x, xy.y, self.frame_index);
        if (hit.kind == uiNodeCustom() || hit.kind == uiNodeRender()) { event.payload = appCanvasPointerPayload(hit.bounds, xy.x, xy.y, f32Zero(), f32Zero()); }
        return self.queueInteractionEvent(event.withRoute(hit.route));
    }

    public fn queuePointerScrolled(mut self, point: Point, dx: f32, dy: f32) -> AppRuntime {
        let xy = pointUnpack(point);
        let hit = self.hitTest(point);
        self.last_hit_id = hit.id;
        let action = self.world_state.pointerScrolledActionNameForViewId(hit.id);
        var event = AppInteractionEvent.pointerScrolled(hit.id, action, xy.x, xy.y, dx, dy, self.frame_index);
        if (hit.kind == uiNodeCustom() || hit.kind == uiNodeRender()) { event.payload = appCanvasPointerPayload(hit.bounds, xy.x, xy.y, dx, dy); }
        return self.queueInteractionEvent(event.withRoute(hit.route));
    }

    public fn queuePointerDragged(mut self, point: Point, dx: f32, dy: f32) -> AppRuntime {
        var tree = self.toUiTree();
        let index = tree.hitTest(point);
        if (index < 0) {
            tree.destroy();
            return self;
        }
        let node = tree.nodeAt(index);
        let modal = self.world_state.topModalLayerId();
        if (modal.len > 0 && self.world_state.layerOfViewId(node.id) != modal) {
            tree.destroy();
            return self;
        }
        if (node.kind == uiNodeCustom() || node.kind == uiNodeRender()) {
            let xy = pointUnpack(point);
            var action = self.world_state.pointerDraggedActionNameForViewId(node.id);
            if (action.len == 0) { action = self.world_state.actionNameForViewId(node.id); }
            let payload = appCanvasPointerPayload(node.bounds, xy.x, xy.y, dx, dy);
            let route = tree.nodePathFromIndex(index);
            let id = node.id;
            tree.destroy();
            self.last_hit_id = id;
            return self.queueInteractionEvent(AppInteractionEvent.pointerDragged(id, action, payload, xy.x, xy.y, dx, dy, self.frame_index).withRoute(route));
        }
        if (node.kind != uiNodeSlider()) {
            tree.destroy();
            return self;
        }
        var ratio: f32 = f32Zero();
        let xy = pointUnpack(point);
        if (node.bounds.width > f32Zero()) {
            ratio = (xy.x - node.bounds.x) / node.bounds.width;
        }
        if (ratio < f32Zero()) { ratio = f32Zero(); }
        if (ratio > f32One()) { ratio = f32One(); }
        let value = node.min_value + ((node.max_value - node.min_value) * ratio);
        let payload = app_format_f32(value);
        let id = node.id;
        var action = self.world_state.pointerDraggedActionNameForViewId(id);
        if (action.len == 0) {
            action = self.world_state.actionNameForViewId(id);
        }
        let route = tree.nodePathFromIndex(index);
        tree.destroy();
        self.last_hit_id = id;
        return self.queueInteractionEvent(AppInteractionEvent.pointerDragged(id, action, payload, xy.x, xy.y, dx, dy, self.frame_index).withRoute(route));
    }

    public fn queueTextInput(&mut self, id: string, text: string) -> AppRuntime {
        self.last_hit_id = id;
        self.world_state.requestFocus(id);
        return self.queueInteractionEvent(AppInteractionEvent.textInput(id, self.world_state.textInputActionNameForViewId(id), text, self.frame_index));
    }

    // Keyboard events are normalized into the same interaction stream as the
    // pointer: the route comes from the focused node's path in the UI tree, so
    // capture/target/bubble behave identically and a key is never handled by
    // two different dispatchers.
    public fn queueKeyDown(mut self, key: i32, modifiers: u32, repeated: bool) -> AppRuntime {
        let focused = self.world_state.focusedId();
        var route = focused;
        if (focused.len > 0) {
            var tree = self.toUiTree();
            let index = tree.find(focused);
            if (index >= 0) { route = tree.nodePathFromIndex(index); }
            tree.destroy();
        }
        let action = self.world_state.keyActionNameForViewId(focused);
        return self.queueInteractionEvent(AppInteractionEvent.keyDown(focused, action, route, key, modifiers, repeated, self.frame_index));
    }

    public fn queueKeyUp(mut self, key: i32, modifiers: u32) -> AppRuntime {
        let focused = self.world_state.focusedId();
        var route = focused;
        if (focused.len > 0) {
            var tree = self.toUiTree();
            let index = tree.find(focused);
            if (index >= 0) { route = tree.nodePathFromIndex(index); }
            tree.destroy();
        }
        let action = self.world_state.keyActionNameForViewId(focused);
        return self.queueInteractionEvent(AppInteractionEvent.keyUp(focused, action, route, key, modifiers, self.frame_index));
    }

    public fn registerKeyShortcut(mut self, key: i32, modifiers: u32, action_name: string) -> AppRuntime {
        self.world_state = self.world_state.registerKeyShortcut(AppKeyShortcut.create(key, modifiers, action_name));
        return self;
    }

    public fn keyShortcutCount(&self) -> i32 {
        return self.world_state.keyShortcutCount();
    }

    @[borrow_args]
    public fn syncFocusOrderFromTree(mut self, tree: UiTree) -> AppRuntime {
        self.world_state = self.world_state.beginFocusOrder();
        var i: i32 = 0;
        while (i < tree.nodeCount()) {
            let node = tree.nodeAt(i);
            if (node.id.len > 0) {
                if (AppWorld.isFocusableUiKind(node.kind)) {
                    self.world_state = self.world_state.appendFocusOrder(node.id);
                }
                // Scroll viewports come from the laid-out node, so clamping uses
                // the measured height instead of a guessed constant.
                if (self.world_state.scrollOffsetResourceForViewId(node.id).len > 0) {
                    self.world_state = self.world_state.setFloatResource("scroll_viewport:" + node.id, node.bounds.height);
                }
            }
            i = i + 1;
        }
        self.world_state = self.world_state.endFocusOrder();
        return self;
    }

    // A short glide after a wheel or drag. The velocity lives in a world
    // resource, so it decays across frames without any thread-local state and
    // stops the moment the container hits an edge.
    public fn runScrollInertia(mut self) -> AppRuntime {
        var i: i32 = 0;
        while (i < self.world_state.scrollContainerCount()) {
            let id = self.world_state.scrollContainerAt(i);
            let velocity_key = "scroll_velocity:" + id;
            var velocity = self.world_state.floatResource(velocity_key, 0.0);
            if (velocity != 0.0) {
                let target = self.world_state.scrollOffsetForViewId(id) + (velocity * 0.016);
                self.world_state = self.world_state.setScrollOffsetForViewId(id, target);
                if (self.world_state.scrollOffsetForViewId(id) != target) {
                    velocity = 0.0;
                } else {
                    velocity = velocity * 0.85;
                    if (velocity > -1.0 && velocity < 1.0) { velocity = 0.0; }
                }
                self.world_state = self.world_state.setFloatResource(velocity_key, velocity);
            }
            i = i + 1;
        }
        return self;
    }

    public fn focusCount(&self) -> i32 {
        return self.world_state.focusCount();
    }

    public fn focusAt(&self, index: i32) -> string {
        return self.world_state.focusAt(index);
    }

    public fn openLayer(mut self, layer: AppLayer) -> AppRuntime {
        self.world_state = self.world_state.openLayer(layer);
        return self;
    }

    public fn closeLayer(mut self, id: string) -> AppRuntime {
        self.world_state = self.world_state.closeLayer(id);
