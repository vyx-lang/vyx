module Zyn.App;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use std.collections;
use UiTheme = Zyn.UI.UiTheme;

public class AppScene {
    public id: string;
    public title: string;
    public root: View;
    public world: AppWorld;
    public presentation: PresentationMode;

    public static fn create(id: string, title: string, root: View) -> AppScene {
        return AppScene {
            id: id,
            title: title,
            root: root.dup(),
            world: AppWorld.create(),
            presentation: PresentationMode.page()
        };
    }

    public static fn withWorld(id: string, title: string, root: View, world: AppWorld) -> AppScene {
        return AppScene {
            id: id,
            title: title,
            root: root.dup(),
            world: world.dup(),
            presentation: PresentationMode.page()
        };
    }

    public static fn empty() -> AppScene {
        return AppScene.create("", "", View.spacer());
    }

    public fn isEmpty(&self) -> bool {
        return self.id.len == 0;
    }

    public fn setPresentation(&self, mode: PresentationMode) -> AppScene {
        var out = AppScene.withWorld(self.id, self.title, self.root, self.world);
        out.presentation = mode;
        return out;
    }

    public fn copyWith(&self, root: View, world: AppWorld) -> AppScene {
        var out = AppScene.withWorld(self.id, self.title, root, world);
        out.presentation = PresentationMode { value: self.presentation.value };
        return out;
    }

    public fn setRoot(&self, root: View) -> AppScene {
        var world = self.world.dup();
        world = root.bindActions(world);
        return self.copyWith(root, world);
    }

    public fn setWorld(&self, world: AppWorld) -> AppScene {
        var bound = self.root.bindActions(world.dup());
        return self.copyWith(self.root, bound);
    }

    public fn bindActions(&self) -> AppScene {
        var world = self.root.bindActions(self.world.dup());
        return self.copyWith(self.root, world);
    }

    public fn setStringResource(&self, id: string, value: string) -> AppScene {
        var world = self.world.dup();
        world = world.setStringResource(id, value);
        return self.copyWith(self.root, world);
    }

    public fn setIntResource(&self, id: string, value: i32) -> AppScene {
        var world = self.world.dup();
        world = world.setIntResource(id, value);
        return self.copyWith(self.root, world);
    }

    public fn setFloatResource(&self, id: string, value: f32) -> AppScene {
        var world = self.world.dup();
        world = world.setFloatResource(id, value);
        return self.copyWith(self.root, world);
    }

    public fn setBoolResource(&self, id: string, value: bool) -> AppScene {
        var world = self.world.dup();
        world = world.setBoolResource(id, value);
        return self.copyWith(self.root, world);
    }

    public fn appendStringListResource(&self, id: string, value: string) -> AppScene {
        var world = self.world.dup();
        world = world.appendStringListResource(id, value);
        world = self.root.bindActions(world);
        return self.copyWith(self.root, world);
    }

    public fn appendBoolListResource(&self, id: string, value: bool) -> AppScene {
        var world = self.world.dup();
        world = world.appendBoolListResource(id, value);
        world = self.root.bindActions(world);
        return self.copyWith(self.root, world);
    }

    public fn registerIntDeltaCommand(&self, action_name: string, target_resource: string, delta: i32) -> AppScene {
        var world = self.world.dup();
        world = world.registerIntDeltaCommand(action_name, target_resource, delta);
        return self.copyWith(self.root, world);
    }

    public fn registerBoolToggleCommand(&self, action_name: string, target_resource: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerBoolToggleCommand(action_name, target_resource);
        return self.copyWith(self.root, world);
    }

    public fn registerStringSetCommand(&self, action_name: string, target_resource: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerStringSetCommand(action_name, target_resource);
        return self.copyWith(self.root, world);
    }

    public fn registerIntSetCommand(&self, action_name: string, target_resource: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerIntSetCommand(action_name, target_resource);
        return self.copyWith(self.root, world);
    }

    public fn registerFloatSetCommand(&self, action_name: string, target_resource: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerFloatSetCommand(action_name, target_resource);
        return self.copyWith(self.root, world);
    }

    public fn registerBoolSetCommand(&self, action_name: string, target_resource: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerBoolSetCommand(action_name, target_resource);
        return self.copyWith(self.root, world);
    }

    public fn registerBehavior(&self, action_name: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppScene {
        var world = self.world.dup();
        world = world.registerBehavior(action_name, handler);
        return self.copyWith(self.root, world);
    }

    public fn registerBehaviorPrefix(&self, action_prefix: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppScene {
        var world = self.world.dup();
        world = world.registerBehaviorPrefix(action_prefix, handler);
        return self.copyWith(self.root, world);
    }

    // Reserves a chord for the whole window. Shortcuts are matched before the
    // focused node, so an application can always keep e.g. Ctrl+S even while a
    // text field has focus.
    public fn registerKeyShortcut(&self, key: i32, modifiers: u32, action_name: string) -> AppScene {
        var world = self.world.dup();
        world = world.registerKeyShortcut(AppKeyShortcut.create(key, modifiers, action_name));
        return self.copyWith(self.root, world);
    }

    public fn focusedId(&self) -> string {
        return self.world.focusedId();
    }

    public fn focusCount(&self) -> i32 {
        return self.world.focusCount();
    }

    public fn focusAt(&self, index: i32) -> string {
        return self.world.focusAt(index);
    }

    // Opens an overlay layer. While the topmost layer is modal it owns focus
    // and the rest of the tree stops being reachable.
    public fn openLayer(&self, layer: AppLayer) -> AppScene {
        var world = self.world.dup();
        world = world.openLayer(layer);
        return self.copyWith(self.root, world);
    }

    public fn closeLayer(&self, id: string) -> AppScene {
        var world = self.world.dup();
        world = world.closeLayer(id);
        return self.copyWith(self.root, world);
    }

    public fn layerCount(&self) -> i32 {
        return self.world.layerCount();
    }

    public fn topLayerId(&self) -> string {
        return self.world.topLayerId();
    }

    public fn topModalLayerId(&self) -> string {
        return self.world.topModalLayerId();
    }

    public fn layerAt(&self, index: i32) -> AppLayer {
        return self.world.layerAt(index);
    }

    public fn accessibilityCount(&self) -> i32 {
        return self.world.accessibilityCount();
    }

    public fn accessibilityRevision(&self) -> u64 {
        return self.world.accessibilityRevision();
    }

    public fn accessibilitySnapshotText(&self) -> string {
        return self.world.accessibilitySnapshotText();
    }

    public fn accessibilityFocusedNode(&self) -> AccessibilityNode {
        return self.world.accessibilityFocusedNode();
    }

    // Requests outside work. The request is rate limited and owned by a
    // component, and its result is only ever committed by the UI scheduler.
    public fn requestEffect(&self, kind: i32, owner_id: string, tag: string, payload: string, timeout_frames: u64) -> AppScene {
        var world = self.world.dup();
        world = world.requestEffect(kind, owner_id, tag, payload, timeout_frames);
        return self.copyWith(self.root, world);
    }

    public fn effectInFlightCount(&self) -> i32 {
        return self.world.effectInFlightCount();
    }

    public fn effectResultCount(&self) -> i32 {
        return self.world.effectResultCount();
    }

    public fn unhandledEffectErrorCount(&self) -> i32 {
        return self.world.unhandledEffectErrorCount();
    }

    public fn registerCommandHandler(&self, handler: Box<dyn AppCommandHandler>) -> AppScene {
        var world = self.world.dup();
        world = world.registerCommandHandler(handler);
        return self.copyWith(self.root, world);
    }

    public fn dispatchViewAction(&self, id: string) -> AppScene {
        var world = self.root.bindActions(self.world.dup());
        world = world.dispatchViewAction(id);
        return self.copyWith(self.root, world);
    }

    public fn dispatchViewActionWithPayload(&self, id: string, payload: string) -> AppScene {
        var world = self.root.bindActions(self.world.dup());
        world = world.dispatchViewActionWithPayload(id, payload);
        return self.copyWith(self.root, world);
    }

    public fn applyAllCommands(&self) -> AppScene {
        var world = self.world.dup();
        world = world.applyAllCommands();
        world = self.root.bindActions(world);
        return self.copyWith(self.root, world);
    }

    public fn stringResource(&self, id: string, fallback: string) -> string {
        return self.world.stringResource(id, fallback);
    }

    public fn intResource(&self, id: string, fallback: i32) -> i32 {
        return self.world.intResource(id, fallback);
    }

    public fn floatResource(&self, id: string, fallback: f32) -> f32 {
        return self.world.floatResource(id, fallback);
    }

    public fn boolResource(&self, id: string, fallback: bool) -> bool {
        return self.world.boolResource(id, fallback);
    }

    public fn stringListResourceCount(&self, id: string) -> i32 {
        return self.world.stringListResourceCount(id);
    }

    public fn stringListResourceAt(&self, id: string, index: i32) -> string {
        return self.world.stringListResourceAt(id, index);
    }

    public fn boolListResourceAt(&self, id: string, index: i32) -> bool {
        return self.world.boolListResourceAt(id, index);
    }

    public fn toRuntime(&self, width: f32, height: f32) -> AppRuntime {
        return AppRuntime.create(self.root, self.world, UiTheme.md3(), width, height);
    }

    public fn dup(&self) -> AppScene {
        return AppScene {
            id: self.id,
            title: self.title,
            root: self.root.dup(),
            world: self.world.dup(),
            presentation: PresentationMode { value: self.presentation.value }
        };
    }

    public fn destroy(&mut self) {
        self.root.destroy();
        self.world.destroy();
    }
}

public interface Scene {
    fn id(&self) -> string;
    fn title(&self) -> string;
    fn view(&self) -> View;
    fn configure(&self, scene: AppScene) -> AppScene;
    fn enter(&mut self, ctx: SceneContext);
    fn update(&mut self, event: AppEvent);
    fn leave(&mut self);
}

public interface Application {
    fn identity(&self) -> AppIdentity;
    fn configure(&self, app: AppSpec) -> AppSpec;
    fn rootScene(&self) -> AppScene;
    fn start(&mut self, ctx: AppContext);
    fn update(&mut self, event: AppEvent);
    fn stop(&mut self);
}

public class SceneBase : Scene {
    public scene_id: string;
    public scene_title: string;
    public enter_count: i32;
    public update_count: i32;
    public leave_count: i32;
    public last_frame_index: u64;

    public static fn create(scene_id: string, scene_title: string) -> SceneBase {
        return SceneBase {
            scene_id: scene_id,
            scene_title: scene_title,
            enter_count: 0,
            update_count: 0,
            leave_count: 0,
            last_frame_index: 0 as u64
        };
    }

    public fn id(&self) -> string {
        return self.scene_id;
    }

    public fn title(&self) -> string {
        return self.scene_title;
    }

    public fn view(&self) -> View {
        return View.spacer().id(self.scene_id + ".empty");
    }

    public fn configure(&self, scene: AppScene) -> AppScene {
        return scene;
    }

    public fn enter(&mut self, ctx: SceneContext) {
        self.enter_count = self.enter_count + 1;
    }

    public fn update(&mut self, event: AppEvent) {
        self.update_count = self.update_count + 1;
        if (event.isFrame()) {
            self.last_frame_index = event.frame_index;
        }
    }

    public fn leave(&mut self) {
        self.leave_count = self.leave_count + 1;
    }
}

public class ApplicationBase : Application {
    public app_name: string;
    public app_identifier: string;
    public app_version: string;
    public app_organization: string;
    public start_count: i32;
    public update_count: i32;
    public stop_count: i32;
    public last_frame_index: u64;

    public static fn create(app_name: string, app_identifier: string) -> ApplicationBase {
        return ApplicationBase {
            app_name: app_name,
            app_identifier: app_identifier,
            app_version: "0.1.0",
            app_organization: "local",
            start_count: 0,
            update_count: 0,
            stop_count: 0,
            last_frame_index: 0 as u64
        };
    }

    public fn setVersion(mut self, version: string) -> ApplicationBase {
        self.app_version = version;
        return self;
    }

    public fn setOrganization(mut self, organization: string) -> ApplicationBase {
        self.app_organization = organization;
        return self;
    }

    public fn identity(&self) -> AppIdentity {
        return AppIdentity.create(self.app_name, self.app_identifier)
            .setVersion(self.app_version)
            .setOrganization(self.app_organization);
    }

    public fn configure(&self, app: AppSpec) -> AppSpec {
        return app;
    }

    public fn rootScene(&self) -> AppScene {
        let root = View.spacer().id("zyn.app.empty");
        let scene = AppScene.create("main", self.app_name, root);
        root.destroy();
        return scene;
    }

    public fn start(&mut self, ctx: AppContext) {
        self.start_count = self.start_count + 1;
    }

    public fn update(&mut self, event: AppEvent) {
        self.update_count = self.update_count + 1;
        if (event.isFrame()) {
            self.last_frame_index = event.frame_index;
        }
    }

    public fn stop(&mut self) {
        self.stop_count = self.stop_count + 1;
    }

    public fn options(&self) -> AppRunOptions {
        return AppRunOptions.frames(1);
    }

    public fn runWithOptions(&self, options: AppRunOptions) -> i32 {
        match (AppHost.runApplicationWithOptions(self, options)) {
            case Ok(report) => {
                if (!report.ok()) { return 30; }
                return 0;
            }
            case Err(e) => {
                print(e.message);
                return 40 + e.code;
            }
        }
    }

    public fn runForFrames(&self, frames: i32) -> i32 {
        return self.runWithOptions(AppRunOptions.frames(frames));
    }

    public fn run(&self) -> i32 {
        return self.runWithOptions(self.options());
    }
}

public class AppGraph {
    public spec: AppSpec;
    private scenes: Vec<AppScene>;
    private routes: Vec<AppRoute>;
    private navigator: Navigator;

    public static fn create(spec: AppSpec) -> AppGraph {
        return AppGraph {
            spec: spec.dup(),
            scenes: Vec::<AppScene>.new(),
            routes: Vec::<AppRoute>.new(),
            navigator: Navigator.create()
        };
    }

    public fn scene(mut self, scene: AppScene) -> AppGraph {
        let copied = scene.dup();
        self.scenes.push(copied);
        if (self.navigator.depth() == 0) {
            self.navigator = self.navigator.pushScene(copied.id, copied.title);
        }
        return self;
    }

    public fn sceneCount(&self) -> i32 {
        return self.scenes.len as i32;
    }

    public fn sceneAt(&self, index: i32) -> AppScene {
        if (index < 0 || index >= self.sceneCount()) { return AppScene.empty(); }
        return self.scenes.get(index as i64).dup();
    }

    public fn sceneIndex(&self, id: string) -> i32 {
        var i: i32 = 0;
        while (i < (self.scenes.len as i32)) {
            if (self.scenes.get(i as i64).id == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn hasScene(&self, id: string) -> bool {
        return self.sceneIndex(id) >= 0;
    }

    public fn route(mut self, path: string, scene_id: string) -> AppGraph {
        if (path.len == 0 || scene_id.len == 0) { return self; }
        if (self.sceneIndex(scene_id) < 0) { return self; }
        let index = self.routeIndex(path);
        let next = AppRoute.create(path, scene_id);
        if (index >= 0) {
            self.routes.set(index as i64, next);
            return self;
        }
        self.routes.push(next);
        return self;
    }

    public fn routeCount(&self) -> i32 {
        return self.routes.len as i32;
    }

    public fn routeIndex(&self, path: string) -> i32 {
        if (path.len == 0) { return -1; }
        var i: i32 = 0;
        while (i < (self.routes.len as i32)) {
            if (self.routes.get(i as i64).path == path) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn routeAt(&self, index: i32) -> AppRoute {
        if (index < 0 || index >= self.routeCount()) { return AppRoute.empty(); }
        return self.routes.get(index as i64).dup();
    }

    public fn sceneIdForRoute(&self, path: string) -> string {
        let index = self.routeIndex(path);
        if (index < 0) { return ""; }
        return self.routes.get(index as i64).scene_id;
    }

    public fn hasRoute(&self, path: string) -> bool {
        return self.routeIndex(path) >= 0;
    }

    public fn currentSceneIndex(&self) -> i32 {
        let current = self.navigator.current();
        if (!current.isEmpty()) {
            let index = self.sceneIndex(current.id);
            if (index >= 0) { return index; }
        }
        if (self.sceneCount() > 0) { return 0; }
        return -1;
    }

    public fn currentScene(&self) -> AppScene {
        let index = self.currentSceneIndex();
        if (index < 0) { return AppScene.empty(); }
        return self.scenes.get(index as i64).dup();
    }

    public fn currentSceneId(&self) -> string {
        let index = self.currentSceneIndex();
        if (index < 0) { return ""; }
        return self.scenes.get(index as i64).id;
    }

    public fn currentSceneTitle(&self) -> string {
        let index = self.currentSceneIndex();
        if (index < 0) { return ""; }
        return self.scenes.get(index as i64).title;
    }

    public fn initialScene(mut self, id: string) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.reset();
        self.navigator = self.navigator.pushScene(scene.id, scene.title);
        return self;
    }

    public fn pushScene(mut self, id: string) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.pushScene(scene.id, scene.title);
        return self;
    }

    public fn replaceScene(mut self, id: string) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.replaceScene(scene.id, scene.title);
        return self;
    }

    public fn navigate(mut self, path: string, id: string) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.navigateScene(path, scene.id, scene.title);
        return self;
    }

    public fn replaceRoute(mut self, path: string, id: string) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.replaceRouteScene(path, scene.id, scene.title);
        return self;
    }

    public fn initialRoute(mut self, path: string) -> AppGraph {
        let id = self.sceneIdForRoute(path);
        if (id.len == 0) { return self; }
        self = self.initialScene(id);
        self.navigator = self.navigator.setRoute(path);
        return self;
    }

    public fn navigateRoute(mut self, path: string) -> AppGraph {
        let id = self.sceneIdForRoute(path);
        if (id.len == 0) { return self; }
        return self.navigate(path, id);
    }

    public fn replaceRoutePath(mut self, path: string) -> AppGraph {
        let id = self.sceneIdForRoute(path);
        if (id.len == 0) { return self; }
        return self.replaceRoute(path, id);
    }

    public fn presentScene(mut self, id: string, mode: PresentationMode) -> AppGraph {
        let index = self.sceneIndex(id);
        if (index < 0) { return self; }
        let scene = self.scenes.get(index as i64);
        self.navigator = self.navigator.presentScene(scene.id, scene.title, mode);
        return self;
    }

    public fn popScene(mut self) -> AppGraph {
        self.navigator.pop();
        return self;
    }

    public fn dismissScene(mut self) -> AppGraph {
        self.navigator.dismiss();
        return self;
    }

    public fn navigationDepth(&self) -> i32 {
        return self.navigator.depth();
    }

    public fn canPopScene(&self) -> bool {
        return self.navigator.canPop();
    }

    public fn presentedDepth(&self) -> i32 {
        return self.navigator.presentedDepth();
    }

    public fn routePath(&self) -> string {
        return self.navigator.routePath();
    }

    public fn navigationEventCount(&self) -> i32 {
        return self.navigator.eventCount();
    }

    public fn navigationEventAt(&self, index: i32) -> NavigationEvent {
        return self.navigator.eventAt(index);
    }

    public fn mutateCurrentScene(mut self, scene: AppScene) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var old = self.scenes.get(index as i64);
        old.destroy();
        self.scenes.set(index as i64, scene.dup());
        return self;
    }

    public fn setStringResource(mut self, id: string, value: string) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.setStringResource(id, value);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn setIntResource(mut self, id: string, value: i32) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.setIntResource(id, value);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn setFloatResource(mut self, id: string, value: f32) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.setFloatResource(id, value);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn setBoolResource(mut self, id: string, value: bool) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.setBoolResource(id, value);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerIntDeltaCommand(mut self, action_name: string, target_resource: string, delta: i32) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerIntDeltaCommand(action_name, target_resource, delta);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerBoolToggleCommand(mut self, action_name: string, target_resource: string) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerBoolToggleCommand(action_name, target_resource);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerStringSetCommand(mut self, action_name: string, target_resource: string) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerStringSetCommand(action_name, target_resource);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerBehavior(mut self, action_name: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerBehavior(action_name, handler);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerBehaviorPrefix(mut self, action_prefix: string, handler: fn(AppAction, AppWorld) -> AppWorld) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerBehaviorPrefix(action_prefix, handler);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn registerCommandHandler(mut self, handler: Box<dyn AppCommandHandler>) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.registerCommandHandler(handler);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn dispatchViewAction(mut self, id: string) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.dispatchViewAction(id);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn dispatchViewActionWithPayload(mut self, id: string, payload: string) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.dispatchViewActionWithPayload(id, payload);
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn applyAllCommands(mut self) -> AppGraph {
        let index = self.currentSceneIndex();
        if (index < 0) { return self; }
        var scene = self.scenes.get(index as i64);
        scene = scene.applyAllCommands();
        self.scenes.set(index as i64, scene);
        return self;
    }

    public fn stringResource(&self, id: string, fallback: string) -> string {
        let index = self.currentSceneIndex();
        if (index < 0) { return fallback; }
        return self.scenes.get(index as i64).stringResource(id, fallback);
    }

    public fn intResource(&self, id: string, fallback: i32) -> i32 {
        let index = self.currentSceneIndex();
        if (index < 0) { return fallback; }
        return self.scenes.get(index as i64).intResource(id, fallback);
    }

    public fn floatResource(&self, id: string, fallback: f32) -> f32 {
        let index = self.currentSceneIndex();
        if (index < 0) { return fallback; }
        return self.scenes.get(index as i64).floatResource(id, fallback);
    }

    public fn boolResource(&self, id: string, fallback: bool) -> bool {
        let index = self.currentSceneIndex();
        if (index < 0) { return fallback; }
        return self.scenes.get(index as i64).boolResource(id, fallback);
    }

    public fn stringListResourceCount(&self, id: string) -> i32 {
        let index = self.currentSceneIndex();
        if (index < 0) { return 0; }
        return self.scenes.get(index as i64).stringListResourceCount(id);
    }

    public fn stringListResourceAt(&self, id: string, item_index: i32) -> string {
        let index = self.currentSceneIndex();
        if (index < 0) { return ""; }
        return self.scenes.get(index as i64).stringListResourceAt(id, item_index);
    }

    public fn boolListResourceAt(&self, id: string, item_index: i32) -> bool {
        let index = self.currentSceneIndex();
        if (index < 0) { return false; }
        return self.scenes.get(index as i64).boolListResourceAt(id, item_index);
    }

    public fn runtime(&self) -> Result<AppRuntime, AppError> {
        let index = self.currentSceneIndex();
        if (index < 0) {
            return Err(AppError.create(60, "AppGraph has no scene to run"));
        }
        let scene = self.scenes.get(index as i64);
        return Ok(AppRuntime.create(scene.root, scene.world, self.spec.theme, f32FromInt(self.spec.window.width), f32FromInt(self.spec.window.height)));
    }

    public fn runWithOptions(&self, options: AppRunOptions) -> Result<AppRunReport, AppError> {
        match (self.runtime()) {
            case Ok(runtime) => {
                return AppHost.runRuntimeWithOptions(self.spec, runtime, options);
            }
            case Err(e) => { return Err(e); }
        }
    }

    public fn runForFrames(&self, frames: i32) -> Result<AppRunReport, AppError> {
        return self.runWithOptions(AppRunOptions.frames(frames));
    }

    public fn destroy(&mut self) {
        var i: i32 = 0;
        while (i < (self.scenes.len as i32)) {
            var scene = self.scenes.get(i as i64);
            scene.destroy();
            i = i + 1;
        }
        self.scenes.destroy();
        self.routes.destroy();
        self.navigator.destroy();
    }
}
