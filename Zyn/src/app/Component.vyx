module Zyn.App;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use std.collections;

public class ComponentContext {
    public scene_id: string;
    public component_id: string;
    public frame_index: u64;

    public static fn create(scene_id: string, component_id: string) -> ComponentContext {
        return ComponentContext {
            scene_id: scene_id,
            component_id: component_id,
            frame_index: 0 as u64
        };
    }

    public fn atFrame(mut self, frame_index: u64) -> ComponentContext {
        self.frame_index = frame_index;
        return self;
    }

    public fn resource(&self, id: string) -> string {
        if (self.component_id.len == 0) { return id; }
        return self.component_id + "." + id;
    }

    public fn action(&self, id: string) -> string {
        if (self.component_id.len == 0) { return id; }
        return self.component_id + "." + id;
    }
}

public interface Component {
    fn id(&self) -> string;
    fn configure(&self, world: AppWorld) -> AppWorld;
    fn update(&mut self, event: AppEvent, world: AppWorld) -> AppWorld;
    fn view(&self, world: AppWorld) -> View;
}

fn zynComponentRootColumn() -> i32 { return 0; }
fn zynComponentRootRow() -> i32 { return 1; }
fn zynComponentRootStack() -> i32 { return 2; }

public class ZynComponent : Component {
    public component_id: string;

    public static fn create(id: string) -> ZynComponent {
        return ZynComponent { component_id: id };
    }

    public fn id(&self) -> string {
        return self.component_id;
    }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        return world;
    }

    public fn update(&self, event: AppEvent, world: AppWorld) -> AppWorld {
        return world;
    }

    public fn view(&self, world: AppWorld) -> View {
        return View.spacer().id(self.component_id + ".empty");
    }

    public fn context(&self, scene_id: string) -> ComponentContext {
        return ComponentContext.create(scene_id, self.component_id);
    }
}

public class StatelessComponent : ZynComponent {
    public static fn create(id: string) -> StatelessComponent {
        return StatelessComponent { component_id: id };
    }
}

public class StatefulComponent : ZynComponent {
    public state_id: string;

    public static fn create(id: string, state_id: string) -> StatefulComponent {
        return StatefulComponent {
            component_id: id,
            state_id: state_id
        };
    }

    public fn stateResource(&self, name: string) -> string {
        if (self.state_id.len == 0) { return self.component_id + "." + name; }
        return self.state_id + "." + name;
    }
}

public class ViewComponent : Component {
    public component_id: string;
    private root_view: View;

    public static fn create(id: string, root: View) -> ViewComponent {
        return ViewComponent {
            component_id: id,
            root_view: root.dup()
        };
    }

    public fn id(&self) -> string {
        return self.component_id;
    }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        return world;
    }

    public fn update(&self, event: AppEvent, world: AppWorld) -> AppWorld {
        return world;
    }

    public fn view(&self, world: AppWorld) -> View {
        return self.root_view.dup();
    }

    public fn destroy(&mut self) {
        self.root_view.destroy();
    }
}

public class ComponentHost {
    public scene_id: string;
    private component_ids: Vec<string>;
    private component_views: Vec<View>;
    private world_state: AppWorld;

    public static fn create(scene_id: string, world: AppWorld) -> ComponentHost {
        return ComponentHost {
            scene_id: scene_id,
            component_ids: Vec::<string>.new(),
            component_views: Vec::<View>.new(),
            world_state: world.dup()
        };
    }

    public static fn empty(scene_id: string) -> ComponentHost {
        var world = AppWorld.create();
        let host = ComponentHost.create(scene_id, world);
        world.destroy();
        return host;
    }

    public fn componentCount(&self) -> i32 {
        return self.component_ids.len as i32;
    }

    public fn componentIndex(&self, id: string) -> i32 {
        if (id.len == 0) { return -1; }
        var i: i32 = 0;
        while (i < self.componentCount()) {
            if (self.component_ids.get(i as i64) == id) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public fn componentIdAt(&self, index: i32) -> string {
        if (index < 0 || index >= self.componentCount()) { return ""; }
        return self.component_ids.get(index as i64);
    }

    public fn viewAt(&self, index: i32) -> View {
        if (index < 0 || index >= self.componentCount()) { return View.spacer(); }
        return self.component_views.get(index as i64).dup();
    }

    public fn stateRevision(&self) -> u64 {
        return self.world_state.stateRevision();
    }

    public fn changedSince(&self, snapshot: AppStateSnapshot) -> bool {
        return snapshot.changed(self.world_state);
    }

    public fn mountView(mut self, component_id: string, view: View) -> ComponentHost {
        if (component_id.len == 0) { return self; }
        let index = self.componentIndex(component_id);
        if (index >= 0) {
            var old = self.component_views.get(index as i64);
            old.destroy();
            self.component_views.set(index as i64, view.dup());
            self.world_state = view.bindActions(self.world_state);
            return self;
        }
        self.component_ids.push(component_id);
        self.component_views.push(view.dup());
        self.world_state = view.bindActions(self.world_state);
        return self;
    }

    public fn mount(mut self, component: dyn Component) -> ComponentHost {
        let component_id = component.id();
        if (component_id.len == 0) { return self; }
        self.world_state = component.configure(self.world_state);
        let view = component.view(self.world_state);
        self = self.mountView(component_id, view);
        view.destroy();
        return self;
    }

    @[borrow_args]
    public fn mountAll(mut self, components: Vec<dyn Component>) -> ComponentHost {
        var i: i32 = 0;
        while (i < (components.len as i32)) {
            self = self.mount(components.get(i as i64));
            i = i + 1;
        }
        return self;
    }

    public fn rebuild(mut self, component: dyn Component) -> ComponentHost {
        let component_id = component.id();
        if (component_id.len == 0) { return self; }
        let view = component.view(self.world_state);
        self = self.mountView(component_id, view);
        view.destroy();
        return self;
    }

    public fn update(mut self, component: dyn Component, event: AppEvent) -> ComponentHost {
        let component_id = component.id();
        if (component_id.len == 0) { return self; }
        if (self.componentIndex(component_id) < 0) {
            return self.mount(component);
        }
        let before = AppStateSnapshot.capture(self.world_state);
        self.world_state = component.update(event, self.world_state);
        if (before.changed(self.world_state)) {
            self.world_state = self.world_state.updateComponent(component_id);
            return self.rebuild(component);
        }
        return self;
    }

    public fn finish(mut self) -> ComponentHost {
        self.world_state = self.world_state.reconcileComponents(self.component_ids);
        var i: i32 = 0;
        while (i < (self.component_views.len as i32)) {
            self.world_state = self.component_views.get(i as i64).bindActions(self.world_state);
            i = i + 1;
        }
        return self;
    }

    public fn appWorld(&self) -> AppWorld {
        return self.world_state.dup();
    }

    public fn column(&self) -> View {
        return Column.create()
            .id(self.scene_id + ".components")
            .children(self.component_views);
    }

    public fn row(&self) -> View {
        return Row.create()
            .id(self.scene_id + ".components")
            .children(self.component_views);
    }

    public fn stack(&self) -> View {
        return Stack.create()
            .id(self.scene_id + ".components")
            .children(self.component_views);
    }

    public fn destroy(&mut self) {
        var i: i32 = 0;
        while (i < (self.component_views.len as i32)) {
            var view = self.component_views.get(i as i64);
            view.destroy();
            i = i + 1;
        }
        self.component_views.destroy();
        self.component_ids.destroy();
        self.world_state.destroy();
    }
}

public class Components : Component {
    public scene_id: string;
    private layout_kind: i32;
    private gap_value: f32;
    private items: Vec<dyn Component>;

    public static fn create(scene_id: string, layout_kind: i32) -> Components {
        return Components {
            scene_id: scene_id,
            layout_kind: layout_kind,
            gap_value: f32FromMilli(24000),
            items: Vec::<dyn Component>.new()
        };
    }

    public static fn column(scene_id: string) -> Components {
        return Components.create(scene_id, zynComponentRootColumn());
    }

    public static fn row(scene_id: string) -> Components {
        return Components.create(scene_id, zynComponentRootRow());
    }

    public static fn stack(scene_id: string) -> Components {
        return Components.create(scene_id, zynComponentRootStack());
    }

    public fn id(&self) -> string {
        return self.scene_id;
    }

    public fn scene(mut self, id: string) -> Components {
        self.scene_id = id;
        return self;
    }

    public fn gap(mut self, value: f32) -> Components {
        if (value < f32Zero()) { self.gap_value = f32Zero(); } else { self.gap_value = value; }
        return self;
    }

    public fn child(mut self, component: dyn Component) -> Components {
        self.items.push(component);
        return self;
    }

    public fn view(mut self, id: string, root: View) -> Components {
        self.items.push(ViewComponent.create(id, root));
        return self;
    }

    @[borrow_args]
    public fn children(mut self, components: Vec<dyn Component>) -> Components {
        var i: i32 = 0;
        while (i < (components.len as i32)) {
            self.items.push(components.get(i as i64));
            i = i + 1;
        }
        return self;
    }

    public fn count(&self) -> i32 {
        return self.items.len as i32;
    }

    public fn mountInto(&self, host: ComponentHost) -> ComponentHost {
        return host.mountAll(self.items);
    }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < self.count()) {
            out = self.items.get(i as i64).configure(out);
            i = i + 1;
        }
        return out;
    }

    public fn update(&mut self, event: AppEvent, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < self.count()) {
            out = self.items.get(i as i64).update(event, out);
            i = i + 1;
        }
        return out;
    }

    public fn view(&self, world: AppWorld) -> View {
        if (self.count() == 0) { return View.spacer().id(self.scene_id + ".empty").anchorCenter(); }
        if (self.count() == 1) { return self.items.get(0).view(world); }
        var out = Column.create().id(self.scene_id + ".components")
            .gap(self.gap_value).alignCenter().mainCenter().anchorCenter();
        if (self.layout_kind == zynComponentRootRow()) {
            out = Row.create().id(self.scene_id + ".components")
                .gap(self.gap_value).alignCenter().mainCenter().anchorCenter();
        }
        if (self.layout_kind == zynComponentRootStack()) {
            out = Stack.create().id(self.scene_id + ".components").anchorCenter();
        }
        var i: i32 = 0;
        while (i < self.count()) {
            out = out.child(self.items.get(i as i64).view(world));
            i = i + 1;
        }
        return out;
    }

    public fn viewFrom(&self, host: ComponentHost) -> View {
        if (self.layout_kind == zynComponentRootRow()) {
            return host.row()
                .gap(self.gap_value)
                .alignCenter()
                .mainCenter()
                .anchorCenter();
        }
        if (self.layout_kind == zynComponentRootStack()) {
            return host.stack().anchorCenter();
        }
        return host.column()
            .gap(self.gap_value)
            .alignCenter()
            .mainCenter()
            .anchorCenter();
    }

    public fn destroy(&mut self) {
        self.items.destroy();
    }
}
