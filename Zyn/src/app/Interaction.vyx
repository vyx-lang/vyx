module Zyn.App;

use std.collections;

public fn appSystemInteraction() -> i32 { return 1; }
public fn appSystemApplyCommands() -> i32 { return 2; }
public fn appSystemClearInteractions() -> i32 { return 3; }
public fn appSystemFrameCounter() -> i32 { return 4; }
public fn appSystemEffectDispatch() -> i32 { return 5; }

public interface AppSystem {
    fn run(&self, world: AppWorld) -> AppWorld;
}

public class AppSystemStep {
    public name: string;
    public kind: i32;
    public enabled_value: bool;
    public resource_id: string;

    public static fn create(name: string, kind: i32) -> AppSystemStep {
        return AppSystemStep {
            name: name,
            kind: kind,
            enabled_value: true,
            resource_id: ""
        };
    }

    public static fn interaction() -> AppSystemStep {
        return AppSystemStep.create("interaction", appSystemInteraction());
    }

    public static fn applyCommands() -> AppSystemStep {
        return AppSystemStep.create("apply_commands", appSystemApplyCommands());
    }

    public static fn clearInteractions() -> AppSystemStep {
        return AppSystemStep.create("clear_interactions", appSystemClearInteractions());
    }

    public static fn frameCounter(resource_id: string) -> AppSystemStep {
        var step = AppSystemStep.create("frame_counter", appSystemFrameCounter());
        step.resource_id = resource_id;
        return step;
    }

    public static fn effectDispatch() -> AppSystemStep {
        return AppSystemStep.create("effect_dispatch", appSystemEffectDispatch());
    }

    public fn enabled(mut self, value: bool) -> AppSystemStep {
        self.enabled_value = value;
        return self;
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        if (!self.enabled_value) { return world; }
        if (self.kind == appSystemInteraction()) {
            return InteractionSystem.create().run(world);
        }
        if (self.kind == appSystemApplyCommands()) {
            return ApplyCommandsSystem.create().run(world);
        }
        if (self.kind == appSystemClearInteractions()) {
            return ClearInteractionEventsSystem.create().run(world);
        }
        if (self.kind == appSystemFrameCounter()) {
            return FrameCounterSystem.create(self.resource_id).run(world);
        }
        if (self.kind == appSystemEffectDispatch()) {
            return EffectDispatchSystem.create().run(world);
        }
        return world;
    }

    public fn dup(&self) -> AppSystemStep {
        return AppSystemStep {
            name: self.name,
            kind: self.kind,
            enabled_value: self.enabled_value,
            resource_id: self.resource_id
        };
    }
}

public class AppSystemSchedule {
    public name: string;
    private steps: Vec<AppSystemStep>;

    public static fn create(name: string) -> AppSystemSchedule {
        return AppSystemSchedule {
            name: name,
            steps: Vec::<AppSystemStep>.new()
        };
    }

    public static fn frame() -> AppSystemSchedule {
        return AppSystemSchedule.create("frame")
            .interaction()
            .applyCommands()
            .clearInteractions();
    }

    public fn add(mut self, step: AppSystemStep) -> AppSystemSchedule {
        self.steps.push(step.dup());
        return self;
    }

    public fn interaction(mut self) -> AppSystemSchedule {
        return self.add(AppSystemStep.interaction());
    }

    public fn applyCommands(mut self) -> AppSystemSchedule {
        return self.add(AppSystemStep.applyCommands());
    }

    public fn clearInteractions(mut self) -> AppSystemSchedule {
        return self.add(AppSystemStep.clearInteractions());
    }

    public fn frameCounter(mut self, resource_id: string) -> AppSystemSchedule {
        return self.add(AppSystemStep.frameCounter(resource_id));
    }

    public fn effectDispatch(mut self) -> AppSystemSchedule {
        return self.add(AppSystemStep.effectDispatch());
    }

    public fn stepCount(&self) -> i32 {
        return self.steps.len as i32;
    }

    public fn stepAt(&self, index: i32) -> AppSystemStep {
        if (index < 0 || index >= self.stepCount()) { return AppSystemStep.create("", 0); }
        return self.steps.get(index as i64).dup();
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < self.stepCount()) {
            out = self.steps.get(i as i64).run(out);
            i = i + 1;
        }
        return out;
    }

    public fn destroy(&mut self) {
        self.steps.destroy();
    }
}

public class InteractionSystem : AppSystem {
    public static fn create() -> InteractionSystem {
        return InteractionSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        // Async results and input events are both event sources, and effects are
        // committed first so a completed result is visible to the same frame's
        // focus routing.
        out = EffectDispatchSystem.create().run(out);
        out = PointerMoveSystem.create().run(out);
        out = PointerDownSystem.create().run(out);
        out = PointerUpSystem.create().run(out);
        out = PointerScrollSystem.create().run(out);
        out = PointerDragSystem.create().run(out);
        out = KeyDownSystem.create().run(out);
        out = KeyUpSystem.create().run(out);
        out = TextInputSystem.create().run(out);
        return out;
    }
}

public class ApplyCommandsSystem : AppSystem {
    public static fn create() -> ApplyCommandsSystem {
        return ApplyCommandsSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        return world.applyAllCommands();
    }
}

public class ClearInteractionEventsSystem : AppSystem {
    public static fn create() -> ClearInteractionEventsSystem {
        return ClearInteractionEventsSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        return world.clearInteractionEvents();
    }
}

public class FrameCounterSystem : AppSystem {
    public resource_id: string;

    public static fn create(resource_id: string) -> FrameCounterSystem {
        return FrameCounterSystem { resource_id: resource_id };
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        if (self.resource_id.len == 0) { return world; }
        return world.incrementIntResource(self.resource_id, 1);
    }
}

public class PointerMoveSystem : AppSystem {
    public static fn create() -> PointerMoveSystem {
        return PointerMoveSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionPointerMoved()) {
                let previous_hovered = out.stringResource("ui.hovered", "");
                out = out.setFloatResource("ui.pointer.x", interactionPosOf(event).x);
                out = out.setFloatResource("ui.pointer.y", interactionPosOf(event).y);
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                if (previous_hovered != event.target_id) {
                    out = out.setStringResource("ui.hovered.previous", previous_hovered);
                    out = out.setStringResource("ui.hovered", event.target_id);
                    let exit_action = out.hoverExitActionNameForViewId(previous_hovered);
                    if (exit_action.len > 0) {
                        out = out.dispatchInteractionActionByNameFrom(event, exit_action, previous_hovered);
                    }
                    let enter_action = out.hoverEnterActionNameForViewId(event.target_id);
                    if (enter_action.len > 0) {
                        out = out.dispatchInteractionActionByName(event, enter_action);
                    }
                }
                let hover_action = out.hoverActionNameForViewId(event.target_id);
                if (hover_action.len > 0) {
                    out = out.dispatchInteractionActionByName(event, hover_action);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class PointerDownSystem : AppSystem {
    public static fn create() -> PointerDownSystem {
        return PointerDownSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionPointerDown()) {
                out = out.setFloatResource("ui.pointer.x", interactionPosOf(event).x);
                out = out.setFloatResource("ui.pointer.y", interactionPosOf(event).y);
                out = out.setBoolResource("ui.pointer.down", true);
                out = out.setStringResource("ui.pressed", event.target_id);
                if (event.target_id.len > 0) {
                    if (!out.requestFocus(event.target_id)) {
                        out = out.clearFocus();
                    }
                } else {
                    out = out.clearFocus();
                }
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class PointerUpSystem : AppSystem {
    public static fn create() -> PointerUpSystem {
        return PointerUpSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionPointerUp()) {
                out = out.setFloatResource("ui.pointer.x", interactionPosOf(event).x);
                out = out.setFloatResource("ui.pointer.y", interactionPosOf(event).y);
                out = out.setBoolResource("ui.pointer.down", false);
                let pressed_id = out.stringResource("ui.pressed", "");
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                if (pressed_id.len > 0 && pressed_id == event.target_id && !out.isTextInputViewId(event.target_id)) {
                    let click_action = out.actionNameForViewId(event.target_id);
                    if (click_action.len > 0) {
                        out = out.dispatchInteractionActionByName(event, click_action);
                    }
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setStringResource("ui.pressed", "");
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class PointerScrollSystem : AppSystem {
    public static fn create() -> PointerScrollSystem {
        return PointerScrollSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionPointerScrolled()) {
                let pos = interactionPosOf(event);
                out = out.setFloatResource("ui.scroll.dx", pos.dx);
                out = out.setFloatResource("ui.scroll.dy", pos.dy);
                // Wheel input closes the loop on the container's own offset, so
                // the next rebuild renders where the user left it.
                if (pos.dy != 0.0) {
                    out = out.applyScroll(event, pos.dy);
                }
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class PointerDragSystem : AppSystem {
    public static fn create() -> PointerDragSystem {
        return PointerDragSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionPointerDragged()) {
                // Dragging inside a scroll container moves its offset, which is
                // how touch scrolling works: the finger drags the content.
                let drag_pos = interactionPosOf(event);
                if (drag_pos.dy != 0.0) {
                    out = out.applyScroll(event, -drag_pos.dy);
                }
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class KeyDownSystem : AppSystem {
    public static fn create() -> KeyDownSystem {
        return KeyDownSystem {};
    }

    // Keyboard rides the same three phases as every pointer event: window
    // shortcuts, then capture -> target -> bubble on the focused node's route,
    // then the focus rules as a fallback. Capture/bubble handlers are
    // notifications and do not swallow the key; only a window shortcut or a
    // node's own key action claims it. That is what stops one Tab press from
    // both notifying handlers and advancing focus twice.
    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionKeyDown()) {
                let shortcut_handled = out.dispatchKeyShortcut(event);
                var node_handled: bool = false;
                if (!shortcut_handled) {
                    out = out.dispatchInteractionCaptureChain(event);
                    let key_action = out.keyActionNameForViewId(event.target_id);
                    if (key_action.len > 0) {
                        out = out.dispatchInteractionActionByName(event, key_action);
                        node_handled = true;
                    } else if (event.action_name.len > 0) {
                        out = out.dispatchInteractionAction(event);
                        node_handled = true;
                    }
                    out = out.dispatchInteractionBubbleChain(event);
                }
                if (!shortcut_handled && !node_handled) {
                    out = out.applyDefaultKeyNavigation(event);
                }
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class KeyUpSystem : AppSystem {
    public static fn create() -> KeyUpSystem {
        return KeyUpSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionKeyUp()) {
                out = out.dispatchInteractionCaptureChain(event);
                let key_action = out.keyActionNameForViewId(event.target_id);
                if (key_action.len > 0) {
                    out = out.dispatchInteractionActionByName(event, key_action);
                } else if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class TextInputSystem : AppSystem {
    public static fn create() -> TextInputSystem {
        return TextInputSystem {};
    }

    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world;
        var i: i32 = 0;
        while (i < out.interactionEventCount()) {
            var event = out.interactionEventAt(i);
            if (!event.consumed && event.kind == appInteractionTextInput()) {
                if (out.isTextInputViewId(event.target_id)) {
                    let target_resource = out.textInputResourceForViewId(event.target_id);
                    if (target_resource.len > 0 && event.payload.len > 0) {
                        event.payload = out.stringResource(target_resource, "") + event.payload;
                        out = out.setStringResource(target_resource, event.payload);
                    }
                }
                out = out.dispatchInteractionCaptureChain(event);
                if (event.action_name.len > 0) {
                    out = out.dispatchInteractionAction(event);
                }
                out = out.dispatchInteractionBubbleChain(event);
                out = out.setInteractionEventAt(i, event.markConsumed());
            }
            i = i + 1;
        }
        return out;
    }
}

public class EffectDispatchSystem : AppSystem {
    public static fn create() -> EffectDispatchSystem {
        return EffectDispatchSystem {};
    }

    // Runs on the UI scheduler: advance the effect clock, fail anything past
    // its deadline, then commit finished results as ordinary actions. Nothing
    // else is allowed to apply an effect result.
    public fn run(&self, world: AppWorld) -> AppWorld {
        var out = world.tickEffectClock();
        out = out.expireEffects();
        return out.commitEffectCompletions();
    }
}
