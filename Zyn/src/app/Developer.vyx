module Zyn.App;

use Color = Zyn.Nut.Types.Color;
use colorTransparent = Zyn.Nut.Types.colorTransparent;
use colorBlack = Zyn.Nut.Types.colorBlack;
use colorWhite = Zyn.Nut.Types.colorWhite;
use colorRgbaMilli = Zyn.Nut.Types.colorRgbaMilli;
use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use UiTheme = Zyn.UI.UiTheme;
use std.args;
use std.collections;
use std.fs;
use std.serde.toml;

fn appProfilePathPart(text: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {
            out = out + text.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { return "app"; }
    return out;
}

public fn appIdentifierFromName(name: string) -> string {
    return "dev.vyx.zyn." + appProfilePathPart(name).toLower();
}

fn appTomlGet(content: string, want_section: string, want_key: string) -> string {
    var section = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key == want_key) { return toml_value(line); }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn appTomlString(content: string, section: string, key: string, fallback: string) -> string {
    let value = appTomlGet(content, section, key).trim();
    if (value.len == 0) { return fallback; }
    return value;
}

fn appTomlInt(content: string, section: string, key: string, fallback: i32) -> i32 {
    let value = appTomlGet(content, section, key).trim();
    if (value.len == 0) { return fallback; }
    return app_parse_i32_or(value, fallback);
}

fn appManifestContent() -> string {
    if (fileExists("Zyn.runtime.toml")) { return readFile("Zyn.runtime.toml"); }
    if (!fileExists("Vyx.toml")) { return ""; }
    return readFile("Vyx.toml");
}

fn appArgumentValue(name: string) -> string {
    var i: i32 = 1;
    while (i + 1 < argCount()) {
        if (getArg(i) == name) {
            let value = getArg(i + 1);
            if (value.startsWith("--")) { return ""; }
            return value;
        }
        i = i + 1;
    }
    return "";
}

fn appScopedId(scope: string, name: string) -> string {
    if (scope.len == 0) { return name; }
    if (name.len == 0) { return scope; }
    return scope + "." + name;
}

public fn appDefaultFontPath() -> string {
    // Android system images and OEMs ship different font sets. Only return a
    // path that exists; applications can still select their bundled font.
    let android_cjk = "/system/fonts/NotoSansCJK-Regular.ttc";
    if (fileExists(android_cjk)) { return android_cjk; }
    let android_roboto = "/system/fonts/Roboto-Regular.ttf";
    if (fileExists(android_roboto)) { return android_roboto; }
    let android_roboto_static = "/system/fonts/RobotoStatic-Regular.ttf";
    if (fileExists(android_roboto_static)) { return android_roboto_static; }
    let android_roboto_variable = "/system/fonts/Roboto[wght].ttf";
    if (fileExists(android_roboto_variable)) { return android_roboto_variable; }
    let android_noto = "/system/fonts/NotoSans-Regular.ttf";
    if (fileExists(android_noto)) { return android_noto; }
    let win_zh = "C:/Windows/Fonts/msyh.ttc";
    if (fileExists(win_zh)) { return win_zh; }
    let win_ui = "C:/Windows/Fonts/segoeui.ttf";
    if (fileExists(win_ui)) { return win_ui; }
    let linux_dejavu = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    if (fileExists(linux_dejavu)) { return linux_dejavu; }
    let linux_noto = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc";
    if (fileExists(linux_noto)) { return linux_noto; }
    let mac_sf = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf";
    if (fileExists(mac_sf)) { return mac_sf; }
    return "";
}

public fn appDefaultShaderPath() -> string {
    return "nut/solid.slang";
}

public fn appDefaultWindowWidth() -> i32 {
    return 1280;
}

public fn appDefaultWindowHeight() -> i32 {
    return 720;
}

fn appProfileShaderExists(path: string) -> bool {
    if (fileExists(path)) { return true; }
    if (fileExists("target/" + path)) { return true; }
    return false;
}

public class AppProfile {
    public name: string;
    public identifier: string;
    public version: string;
    public organization: string;
    public width: i32;
    public height: i32;
    public visible_value: bool;
    public hidden_frame_count: i32;
    public target_fps: i32;
    public shader_path: string;
    public shader_cache_dir: string;
    public font_path: string;
    public font_size: i32;
    public glyph_atlas_width: i32;
    public glyph_atlas_height: i32;
    public glyph_atlas_padding: i32;
    public clear_color: Color;
    public theme: UiTheme;
    public min_node_count: i32;
    public min_draw_command_count: i32;
    public expected_hidden_processed_actions: i32;
    public recording_path: string;
    public reply_path: string;
    public reply_repetitions: i32;
    public reply_headless: bool;

    public static fn desktop(name: string, identifier: string, width: i32, height: i32) -> AppProfile {
        return AppProfile {
            name: name,
            identifier: identifier,
            version: "1.0.0",
            organization: "vyx",
            width: width,
            height: height,
            visible_value: true,
            hidden_frame_count: 1,
            target_fps: 240,
            shader_path: appDefaultShaderPath(),
            shader_cache_dir: "target/shader_cache_" + appProfilePathPart(identifier),
            font_path: appDefaultFontPath(),
            font_size: 22,
            glyph_atlas_width: 1024,
            glyph_atlas_height: 512,
            glyph_atlas_padding: 1,
            clear_color: colorRgbaMilli(980, 990, 980, 1000),
            theme: UiTheme.md3(),
            min_node_count: 0,
            min_draw_command_count: 0,
            expected_hidden_processed_actions: -1,
            recording_path: "",
            reply_path: "",
            reply_repetitions: 1,
            reply_headless: false
        };
    }

    public static fn named(name: string, width: i32, height: i32) -> AppProfile {
        return AppProfile.desktop(name, appIdentifierFromName(name), width, height);
    }

    public static fn named(name: string) -> AppProfile {
        return AppProfile.named(name, appDefaultWindowWidth(), appDefaultWindowHeight());
    }

    public static fn fromManifest() -> AppProfile {
        let manifest = appManifestContent();
        let width = appTomlInt(manifest.clone(), "zyn.app", "width", appDefaultWindowWidth());
        let height = appTomlInt(manifest.clone(), "zyn.app", "height", appDefaultWindowHeight());
        return AppProfile.fromManifest(width, height);
    }

    public static fn fromManifest(width: i32, height: i32) -> AppProfile {
        let manifest = appManifestContent();
        let package_name = appTomlString(manifest.clone(), "package", "name", "app");
        let package_version = appTomlString(manifest.clone(), "package", "version", "1.0.0");
        let app_name = appTomlString(manifest.clone(), "zyn.app", "name", package_name);
        let app_id = appTomlString(manifest.clone(), "zyn.app", "id", appIdentifierFromName(app_name));
        let app_version = appTomlString(manifest.clone(), "zyn.app", "version", package_version);
        let app_org = appTomlString(manifest.clone(), "zyn.app", "organization", "vyx");
        return AppProfile.desktop(app_name, app_id, width, height)
            .setVersion(app_version)
            .setOrganization(app_org);
    }

    public fn dup(&self) -> AppProfile {
        return AppProfile {
            name: self.name,
            identifier: self.identifier,
            version: self.version,
            organization: self.organization,
            width: self.width,
            height: self.height,
            visible_value: self.visible_value,
            hidden_frame_count: self.hidden_frame_count,
            target_fps: self.target_fps,
            shader_path: self.shader_path,
            shader_cache_dir: self.shader_cache_dir,
            font_path: self.font_path,
            font_size: self.font_size,
            glyph_atlas_width: self.glyph_atlas_width,
            glyph_atlas_height: self.glyph_atlas_height,
            glyph_atlas_padding: self.glyph_atlas_padding,
            clear_color: self.clear_color.dup(),
            theme: self.theme.dup(),
            min_node_count: self.min_node_count,
            min_draw_command_count: self.min_draw_command_count,
            expected_hidden_processed_actions: self.expected_hidden_processed_actions,
            recording_path: self.recording_path,
            reply_path: self.reply_path,
            reply_repetitions: self.reply_repetitions,
            reply_headless: self.reply_headless
        };
    }

    public fn setVersion(mut self, version: string) -> AppProfile {
        self.version = version;
        return self;
    }

    public fn setOrganization(mut self, organization: string) -> AppProfile {
        self.organization = organization;
        return self;
    }

    public fn visible(mut self, value: bool) -> AppProfile {
        self.visible_value = value;
        return self;
    }

    public fn visibleUntilClose(mut self) -> AppProfile {
        self.visible_value = true;
        self.hidden_frame_count = 0;
        return self;
    }

    public fn hiddenFrames(mut self, frames: i32) -> AppProfile {
        self.visible_value = false;
        self.hidden_frame_count = frames;
        if (self.hidden_frame_count <= 0) { self.hidden_frame_count = 1; }
        return self;
    }

    public fn setShaderPath(mut self, path: string) -> AppProfile {
        self.shader_path = path;
        return self;
    }

    public fn setShaderCacheDirectory(mut self, path: string) -> AppProfile {
        self.shader_cache_dir = path;
        return self;
    }

    public fn setFontPath(mut self, path: string) -> AppProfile {
        self.font_path = path;
        return self;
    }

    public fn setFontSize(mut self, size: i32) -> AppProfile {
        self.font_size = size;
        return self;
    }

    public fn setGlyphAtlas(mut self, width: i32, height: i32, padding: i32) -> AppProfile {
        self.glyph_atlas_width = width;
        self.glyph_atlas_height = height;
        self.glyph_atlas_padding = padding;
        return self;
    }

    public fn setClearColor(mut self, color: Color) -> AppProfile {
        self.clear_color = color.dup();
        return self;
    }

    public fn setWindowSize(mut self, width: i32, height: i32) -> AppProfile {
        if (width > 0) { self.width = width; }
        if (height > 0) { self.height = height; }
        return self;
    }

    public fn setTheme(mut self, theme: UiTheme) -> AppProfile {
        self.theme = theme.dup();
        return self;
    }

    public fn useMd3Light(mut self) -> AppProfile {
        return self.setTheme(UiTheme.md3Light());
    }

    public fn useMd3Dark(mut self) -> AppProfile {
        return self.setTheme(UiTheme.md3Dark());
    }

    public fn setTargetFps(mut self, target_fps: i32) -> AppProfile {
        self.target_fps = target_fps;
        return self;
    }

    public fn recordTo(mut self, path: string) -> AppProfile {
        self.recording_path = path;
        return self;
    }

    public fn automaticRecording(mut self) -> AppProfile {
        self.recording_path = "timeline.zyns";
        return self;
    }

    public fn withoutRecording(mut self) -> AppProfile {
        self.recording_path = "";
        return self;
    }

    public fn replyFrom(mut self, path: string, repetitions: i32) -> AppProfile {
        self.reply_path = path;
        self.reply_repetitions = repetitions;
        return self;
    }

    public fn headlessReply(mut self) -> AppProfile {
        self.reply_headless = true;
        return self;
    }

    public fn expectRender(mut self, min_nodes: i32, min_draw_commands: i32) -> AppProfile {
        self.min_node_count = min_nodes;
        self.min_draw_command_count = min_draw_commands;
        return self;
    }

    public fn expectHiddenProcessedActions(mut self, count: i32) -> AppProfile {
        self.expected_hidden_processed_actions = count;
        return self;
    }

    public fn identity(&self) -> AppIdentity {
        return AppIdentity.create(self.name, self.identifier)
            .setVersion(self.version)
            .setOrganization(self.organization);
    }

    public fn windowSpec(&self) -> AppWindowSpec {
        var window = AppWindowSpec.create(self.name, self.width, self.height);
        if (!self.visible_value) { window = window.hidden(); }
        return window;
    }

    public fn rendererSpec(&self) -> AppRendererSpec {
        return AppRendererSpec.create(self.width as u32, self.height as u32)
            .setClearColor(self.clear_color)
            .setShaderPath(self.shader_path)
            .setShaderCacheDirectory(self.shader_cache_dir)
            .setFontPath(self.font_path)
            .setFontSize(self.font_size)
            .setGlyphAtlas(self.glyph_atlas_width, self.glyph_atlas_height, self.glyph_atlas_padding);
    }

    public fn toSpec(&self) -> AppSpec {
        return AppSpec.create(self.name, self.identifier, self.width, self.height)
            .setIdentity(self.identity())
            .setWindow(self.windowSpec())
            .setRenderer(self.rendererSpec())
            .setTheme(self.theme)
            .setTargetFps(self.target_fps);
    }

    public fn options(&self) -> AppRunOptions {
        var options = AppRunOptions.frames(self.hidden_frame_count);
        if (self.visible_value) { options = AppRunOptions.visibleUntilClose(); }
        options = options.recordTo(self.recording_path).replyFrom(self.reply_path, self.reply_repetitions);
        options.reply_headless = self.reply_headless;
        let output = appArgumentValue("-o");
        if (options.recording_path.len > 0 && output.len > 0) { options = options.recordTo(output); }
        if (has_flag("--recording")) {
            if (output.len > 0) { options = options.recordTo(output); }
            else if (options.recording_path.len == 0) { options = options.recordTo("timeline.zyns"); }
        }
        if (has_flag("--no-recording")) { options = options.recordTo(""); }
        let reply = appArgumentValue("--reply");
        if (reply.len > 0) { options.reply_path = reply; }
        if (has_flag("--headless")) { options.reply_headless = true; }
        let repeated = appArgumentValue("--repeated");
        if (repeated.len > 0) { options.repetitions = app_parse_i32_or(repeated, -1); }
        if (has_flag("--repeated") && repeated.len == 0) { options.timeline_error = "--repeated requires a count"; }
        if (repeated.len > 0 && repeated != format("%d", options.repetitions as i64)) { options.timeline_error = "invalid --repeated count"; }
        if (has_flag("--reply") && options.reply_path.len == 0) {
            options.timeline_error = "--reply requires a .zyns path";
        }
        if (options.repetitions <= 0) { options.timeline_error = "--repeated must be a positive integer"; }
        return options;
    }

    public fn assetError(&self) -> string {
        if (self.font_path.len == 0) { return "Zyn app font path is empty"; }
        if (!fileExists(self.font_path)) { return "Zyn app font not found: " + self.font_path; }
        if (self.shader_path.len == 0) { return "Zyn app shader path is empty"; }
        if (!appProfileShaderExists(self.shader_path)) { return "Zyn app shader not found: " + self.shader_path; }
        return "";
    }

    public fn validateReport(&self, report: AppRunReport) -> i32 {
        if (!report.ok()) { return 30; }
        if (!self.visible_value && self.hidden_frame_count > 0 && report.frames != self.hidden_frame_count) { return 31; }
        if (!self.visible_value && self.hidden_frame_count > 0 && report.rendered_frames != self.hidden_frame_count) { return 36; }
        if (self.visible_value && (report.frames <= 0 || report.rendered_frames <= 0)) { return 34; }
        if (self.min_node_count > 0 && report.node_count < self.min_node_count) { return 32; }
        if (self.min_draw_command_count > 0 && report.draw_commands < self.min_draw_command_count) { return 33; }
        if (!self.visible_value && self.expected_hidden_processed_actions >= 0 && report.processed_actions != self.expected_hidden_processed_actions) { return 35; }
        return 0;
    }
}

public class ProfileApplication : ApplicationBase {
    public profile: AppProfile;

    public static fn create(profile: AppProfile) -> ProfileApplication {
        let copied = profile.dup();
        return ProfileApplication {
            app_name: copied.name,
            app_identifier: copied.identifier,
            app_version: copied.version,
            app_organization: copied.organization,
            start_count: 0,
            update_count: 0,
            stop_count: 0,
            last_frame_index: 0 as u64,
            profile: copied
        };
    }

    public fn identity(&self) -> AppIdentity {
        return self.profile.identity();
    }

    public fn configure(&self, app: AppSpec) -> AppSpec {
        return self.profile.toSpec();
    }

    public fn options(&self) -> AppRunOptions {
        return self.profile.options();
    }
}

public class AppDebugReport {
    public node_count: i32;
    public resource_count: i32;
    public component_count: i32;
    public accessibility_count: i32;
    public pending_actions: i32;
    public total_actions: i32;
    public processed_actions: i32;
    public state_revision: u64;
    public focused_id: string;
    public last_hit_id: string;

    public static fn create() -> AppDebugReport {
        return AppDebugReport {
            node_count: 0,
            resource_count: 0,
            component_count: 0,
            accessibility_count: 0,
            pending_actions: 0,
            total_actions: 0,
            processed_actions: 0,
            state_revision: 0 as u64,
            focused_id: "",
            last_hit_id: ""
        };
    }

    public fn ok(&self) -> bool {
        return self.node_count > 0;
    }

    public fn idle(&self) -> bool {
        return self.pending_actions == 0;
    }

    public fn summary(&self) -> string {
        return "nodes=" + self.node_count.toString()
            + " resources=" + self.resource_count.toString()
            + " components=" + self.component_count.toString()
            + " accessibility=" + self.accessibility_count.toString()
            + " pending=" + self.pending_actions.toString()
            + " total=" + self.total_actions.toString()
            + " processed=" + self.processed_actions.toString()
            + " revision=" + format("%d", self.state_revision as i64)
            + " focus=" + self.focused_id
            + " hit=" + self.last_hit_id;
    }
}

public class AppInspector {
    public static fn world(world: AppWorld) -> AppDebugReport {
        var out = AppDebugReport.create();
        out.resource_count = world.totalResourceCount();
        out.component_count = world.componentCount();
        out.accessibility_count = world.accessibilityCount();
        out.pending_actions = world.pendingActionCount();
        out.total_actions = world.totalActionCount();
        out.state_revision = world.stateRevision();
        out.focused_id = world.focusedId();
        return out;
    }

    public static fn scene(scene: AppScene, width: f32, height: f32) -> AppDebugReport {
        var runtime = scene.toRuntime(width, height);
        let out = AppInspector.runtime(runtime);
        runtime.destroy();
        return out;
    }

    public static fn runtime(runtime: AppRuntime) -> AppDebugReport {
        let snapshot = runtime.snapshot();
        var out = AppDebugReport.create();
        out.node_count = snapshot.node_count;
        out.resource_count = runtime.resourceCount();
        out.component_count = runtime.componentCount();
        out.accessibility_count = runtime.accessibilityCount();
        out.pending_actions = snapshot.pending_actions;
        out.total_actions = snapshot.total_actions;
        out.processed_actions = snapshot.processed_actions;
        out.state_revision = runtime.stateRevision();
        out.focused_id = snapshot.focused_id;
        out.last_hit_id = snapshot.last_hit_id;
        return out;
    }

    public static fn runtimeHasNode(runtime: AppRuntime, id: string) -> bool {
        var tree = runtime.toUiTree();
        let found = tree.find(id) >= 0;
        tree.destroy();
        return found;
    }

    public static fn worldResourceSummary(world: AppWorld) -> string {
        var out = "strings=" + world.stringResourceCount().toString()
            + " ints=" + world.intResourceCount().toString()
            + " floats=" + world.floatResourceCount().toString()
            + " bools=" + world.boolResourceCount().toString()
            + " stringLists=" + world.stringListResourceTypeCount().toString()
            + " boolLists=" + world.boolListResourceTypeCount().toString();
        if (world.stringResourceCount() > 0) {
            out = out + " firstString=" + world.stringResourceIdAt(0) + ":" + world.stringResourceValueAt(0);
        }
        if (world.intResourceCount() > 0) {
            out = out + " firstInt=" + world.intResourceIdAt(0) + ":" + world.intResourceValueAt(0).toString();
        }
        return out;
    }
}

public class AppRunner {
    public static fn profileFromArgs(name: string, identifier: string, width: i32, height: i32) -> AppProfile {
        var profile = AppProfile.desktop(name, identifier, width, height);
        if (has_flag("--visible") || (has_flag("--recording") && !has_flag("--no-recording"))) { return profile.visibleUntilClose(); }
        return profile.hiddenFrames(2);
    }

    public static fn profileFromArgs(name: string, identifier: string) -> AppProfile {
        return AppRunner.profileFromArgs(name, identifier, appDefaultWindowWidth(), appDefaultWindowHeight());
    }

    public static fn namedProfileFromArgs(name: string, width: i32, height: i32) -> AppProfile {
        var profile = AppProfile.named(name, width, height);
        if (has_flag("--visible") || (has_flag("--recording") && !has_flag("--no-recording"))) { return profile.visibleUntilClose(); }
        return profile.hiddenFrames(2);
    }

    public static fn namedProfileFromArgs(name: string) -> AppProfile {
        return AppRunner.namedProfileFromArgs(name, appDefaultWindowWidth(), appDefaultWindowHeight());
    }

    public static fn manifestProfileFromArgs(width: i32, height: i32) -> AppProfile {
        var profile = AppProfile.fromManifest(width, height);
        if (has_flag("--visible") || (has_flag("--recording") && !has_flag("--no-recording"))) { return profile.visibleUntilClose(); }
        return profile.hiddenFrames(2);
    }

    public static fn manifestProfileFromArgs() -> AppProfile {
        var profile = AppProfile.fromManifest();
        if (has_flag("--visible")) { return profile.visibleUntilClose(); }
        return profile.hiddenFrames(2);
    }

    public static fn runScene(profile: AppProfile, scene: dyn Scene) -> i32 {
        let options = profile.options();
        let assets = profile.assetError();
        if (assets.len > 0 && !(options.reply_path.len > 0 && options.reply_headless)) {
            print(assets);
            return 70;
        }
        let app = ProfileApplication.create(profile);
        match (AppHost.runSceneApplicationWithOptions(app, scene, options)) {
            case Ok(report) => {
                var code: i32 = 0;
                if (options.reply_path.len == 0) { code = profile.validateReport(report); }
                if (code != 0) {
                    print("Zyn app validation failed: " + format("%d", code as i64));
                }
                return code;
            }
            case Err(e) => {
                print(e.message);
                return 40 + e.code;
            }
        }
    }

    public static fn runSceneFromArgs(name: string, identifier: string, width: i32, height: i32, scene: dyn Scene) -> i32 {
        return AppRunner.runScene(AppRunner.profileFromArgs(name, identifier, width, height), scene);
    }

    @[borrow_args]
    public static fn sceneFromComponent(scene_id: string, title: string, component: dyn Component) -> AppScene {
        var host = ComponentHost.empty(scene_id);
        host = host.mount(component).finish();
        var world = host.appWorld();
        let content = host.viewAt(0);
        let root = AppSurface.stage(scene_id + ".root", content);
        var scene = AppScene.create(scene_id, title, root).setWorld(world);
        root.destroy();
        content.destroy();
        world.destroy();
        host.destroy();
        return scene;
    }

    @[borrow_args]
    public static fn sceneFromComponentRoot(title: string, components: Components) -> AppScene {
        let scene_id = components.id();
        var host = ComponentHost.empty(scene_id);
        host = components.mountInto(host).finish();
        var world = host.appWorld();
        var content = components.viewFrom(host);
        if (host.componentCount() == 0) {
            content.destroy();
            content = View.spacer().id(scene_id + ".empty").anchorCenter();
        } else if (host.componentCount() == 1) {
            content.destroy();
            content = host.viewAt(0);
        }
        let root = AppSurface.stage(scene_id + ".root", content);
        var scene = AppScene.create(scene_id, title, root).setWorld(world);
        root.destroy();
        content.destroy();
        world.destroy();
        host.destroy();
        return scene;
    }

    @[borrow_args]
    public static fn sceneFromComponents(scene_id: string, title: string, components: Vec<dyn Component>) -> AppScene {
        var root = Components.column(scene_id).children(components);
        var scene = AppRunner.sceneFromComponentRoot(title, root);
        root.destroy();
        return scene;
    }

    public static fn runComponent(profile: AppProfile, component: dyn Component) -> i32 {
        let options = profile.options();
        let assets = profile.assetError();
        if (assets.len > 0 && !(options.reply_path.len > 0 && options.reply_headless)) {
            print(assets);
            return 70;
        }
        var scene = AppRunner.sceneFromComponent(component.id(), profile.name, component);
        match (AppHost.runComponentWithOptions(profile.toSpec(), scene.root, scene.world, options, component)) {
            case Ok(report) => {
                var code: i32 = 0;
                if (options.reply_path.len == 0) { code = profile.validateReport(report); }
                scene.destroy();
                if (code != 0) {
                    print("Zyn app validation failed: " + format("%d", code as i64));
                }
                return code;
            }
            case Err(e) => {
                scene.destroy();
                print(e.message);
                return 40 + e.code;
            }
        }
    }

    @[borrow_args]
    public static fn runComponents(profile: AppProfile, scene_id: string, components: Vec<dyn Component>) -> i32 {
        var root = Components.column(scene_id).children(components);
        let code = AppRunner.runComponentRoot(profile, root);
        root.destroy();
        return code;
    }

    @[borrow_args]
    public static fn runComponentRoot(profile: AppProfile, components: Components) -> i32 {
        let options = profile.options();
        let assets = profile.assetError();
        if (assets.len > 0 && !(options.reply_path.len > 0 && options.reply_headless)) {
            print(assets);
            return 70;
        }
        var scene = AppRunner.sceneFromComponentRoot(profile.name, components);
        match (AppHost.runComponentWithOptions(profile.toSpec(), scene.root, scene.world, options, components)) {
            case Ok(report) => {
                var code: i32 = 0;
                if (options.reply_path.len == 0) { code = profile.validateReport(report); }
                scene.destroy();
                if (code != 0) {
                    print("Zyn app validation failed: " + format("%d", code as i64));
                }
                return code;
            }
            case Err(e) => {
                scene.destroy();
                print(e.message);
                return 40 + e.code;
            }
        }
    }

    public static fn runComponentFromArgs(name: string, identifier: string, width: i32, height: i32, component: dyn Component) -> i32 {
        return AppRunner.runComponent(AppRunner.profileFromArgs(name, identifier, width, height), component);
    }

    @[borrow_args]
    public static fn runComponentsFromArgs(name: string, identifier: string, width: i32, height: i32, scene_id: string, components: Vec<dyn Component>) -> i32 {
        return AppRunner.runComponents(AppRunner.profileFromArgs(name, identifier, width, height), scene_id, components);
    }

    public static fn runView(profile: AppProfile, root_id: string, root: View) -> i32 {
        let options = profile.options();
        let assets = profile.assetError();
        if (assets.len > 0 && !(options.reply_path.len > 0 && options.reply_headless)) {
            print(assets);
            return 70;
        }
        var world = AppWorld.create();
        world = root.bindActions(world);
        match (AppHost.runRootWithOptions(profile.toSpec(), root, world, options)) {
            case Ok(report) => {
                var code: i32 = 0;
                if (options.reply_path.len == 0) { code = profile.validateReport(report); }
                world.destroy();
                if (code != 0) {
                    print("Zyn app validation failed: " + format("%d", code as i64));
                }
                return code;
            }
            case Err(e) => {
                world.destroy();
                print(e.message);
                return 40 + e.code;
            }
        }
    }
}

public class App {
    public profile: AppProfile;

    public static fn desktop(name: string, identifier: string, width: i32, height: i32) -> App {
        return App { profile: AppProfile.desktop(name, identifier, width, height) };
    }

    public static fn desktop(name: string, identifier: string) -> App {
        return App { profile: AppProfile.desktop(name, identifier, appDefaultWindowWidth(), appDefaultWindowHeight()) };
    }

    public static fn named(name: string, width: i32, height: i32) -> App {
        return App { profile: AppProfile.named(name, width, height) };
    }

    public static fn named(name: string) -> App {
        return App { profile: AppProfile.named(name) };
    }

    public static fn fromArgs(name: string, identifier: string, width: i32, height: i32) -> App {
        return App { profile: AppRunner.profileFromArgs(name, identifier, width, height) };
    }

    public static fn fromArgs(name: string, identifier: string) -> App {
        return App { profile: AppRunner.profileFromArgs(name, identifier) };
    }

    public static fn namedFromArgs(name: string, width: i32, height: i32) -> App {
        return App { profile: AppRunner.namedProfileFromArgs(name, width, height) };
    }

    public static fn namedFromArgs(name: string) -> App {
        return App { profile: AppRunner.namedProfileFromArgs(name) };
    }

    public static fn manifestFromArgs(width: i32, height: i32) -> App {
        return App { profile: AppRunner.manifestProfileFromArgs(width, height) };
    }

    public static fn manifestFromArgs() -> App {
        return App { profile: AppRunner.manifestProfileFromArgs() };
    }

    public fn visibleUntilClose(mut self) -> App {
        self.profile = self.profile.visibleUntilClose();
        return self;
    }

    public fn hiddenFrames(mut self, frames: i32) -> App {
        self.profile = self.profile.hiddenFrames(frames);
        return self;
    }

    public fn targetFps(mut self, target_fps: i32) -> App {
        self.profile = self.profile.setTargetFps(target_fps);
        return self;
    }

    public fn clearColor(mut self, color: Color) -> App {
        self.profile = self.profile.setClearColor(color);
        return self;
    }

    public fn windowSize(mut self, width: i32, height: i32) -> App {
        self.profile = self.profile.setWindowSize(width, height);
        return self;
    }

    public fn theme(mut self, theme: UiTheme) -> App {
        self.profile = self.profile.setTheme(theme);
        return self;
    }

    public fn md3Light(mut self) -> App {
        self.profile = self.profile.useMd3Light();
        return self;
    }

    public fn md3Dark(mut self) -> App {
        self.profile = self.profile.useMd3Dark();
        return self;
    }

    public fn expectRender(mut self, min_nodes: i32, min_draw_commands: i32) -> App {
        self.profile = self.profile.expectRender(min_nodes, min_draw_commands);
        return self;
    }

    public fn recordTo(mut self, path: string) -> App {
        self.profile = self.profile.recordTo(path);
        return self;
    }

    public fn automaticRecording(mut self) -> App {
        self.profile = self.profile.automaticRecording();
        return self;
    }

    public fn withoutRecording(mut self) -> App {
        self.profile = self.profile.withoutRecording();
        return self;
    }

    public fn replyFrom(mut self, path: string, repetitions: i32) -> App {
        self.profile = self.profile.replyFrom(path, repetitions);
        return self;
    }

    public fn headlessReply(mut self) -> App {
        self.profile = self.profile.headlessReply();
        return self;
    }

    public fn runScene(&self, scene: dyn Scene) -> i32 {
        return AppRunner.runScene(self.profile, scene);
    }

    public fn runComponent(&self, component: dyn Component) -> i32 {
        return AppRunner.runComponent(self.profile, component);
    }

    public fn run(&self, component: dyn Component) -> i32 {
        return self.runComponent(component);
    }

    @[borrow_args]
    public fn runComponentRoot(&self, components: Components) -> i32 {
        return AppRunner.runComponentRoot(self.profile, components);
    }

    @[borrow_args]
    public fn run(&self, components: Components) -> i32 {
        return self.runComponentRoot(components);
    }

    @[borrow_args]
    public fn runComponents(&self, scene_id: string, components: Vec<dyn Component>) -> i32 {
        return AppRunner.runComponents(self.profile, scene_id, components);
    }

    @[borrow_args]
    public fn run(&self, components: Vec<dyn Component>) -> i32 {
        return self.runComponents("home", components);
    }

    public fn runView(&self, root_id: string, root: View) -> i32 {
        return AppRunner.runView(self.profile, root_id, root);
    }
}

public class AppSurface {
    public static fn fill(id: string, color: Color) -> View {
        return Panel.create()
            .id(id)
            .anchorFill()
            .background(color)
            .noStroke()
            .cornerRadius(f32Zero());
    }

    public static fn topAccent(id: string, color: Color, height: f32) -> View {
        return Panel.create()
            .id(id)
            .anchorTopFill()
            .height(height)
            .background(color)
            .noStroke()
            .cornerRadius(f32Zero());
    }

    public static fn card(id: string, width: f32, height: f32) -> View {
        return Panel.create()
            .id(id)
            .anchorCenter()
            .size(width, height)
            .padding(f32FromMilli(28000))
            .gap(f32FromMilli(16000))
            .background(colorRgbaMilli(1000, 1000, 990, 1000))
            .stroke(f32One(), colorRgbaMilli(740, 800, 770, 1000))
            .cornerRadius(f32FromMilli(8000));
    }

    public static fn page(root_id: string, background: View, accent: View, content: View) -> View {
        return Stack.create()
            .id(root_id)
            .child(background)
            .child(accent)
            .child(content);
    }

    public static fn stage(root_id: string, content: View) -> View {
        return AppSurface.page(
            root_id,
            AppSurface.fill(root_id + ".background", colorRgbaMilli(940, 970, 960, 1000)),
            AppSurface.topAccent(root_id + ".accent", colorRgbaMilli(100, 580, 520, 1000), f32FromMilli(10000)),
            content
        );
    }
}

public class StepperControl {
    public static fn actions(id: string, decrement_id: string, increment_id: string, decrement_action: string, increment_action: string) -> View {
        let decrement = Button.tonalAction(decrement_id, "-", decrement_action)
            .size(f32FromMilli(72000), f32FromMilli(48000))
            .accessibility("button", "Decrement", "Subtracts one");
        let increment = Button.filledAction(increment_id, "+", increment_action)
            .size(f32FromMilli(72000), f32FromMilli(48000))
            .accessibility("button", "Increment", "Adds one");
        var items = Vec::<View>.new();
        items.push(decrement);
        items.push(increment);
        return Row.create()
            .id(id)
            .width(f32FromMilli(168000))
            .height(f32FromMilli(48000))
            .gap(f32FromMilli(24000))
            .alignCenter()
            .mainCenter()
            .children(items);
    }
}

public class IntStepper {
    public scope: string;
    public value: IntBinding;
    public increment_action: string;
    public decrement_action: string;
    public panel_id: string;
    public title_text: string;
    public subtitle_text: string;
    public note_text: string;
    public card_width: f32;
    public card_height: f32;

    public static fn create(scope: string, resource: string, fallback: i32) -> IntStepper {
        return IntStepper {
            scope: scope,
            value: IntBinding.create(appScopedId(scope, resource), fallback),
            increment_action: appScopedId(scope, "increment"),
            decrement_action: appScopedId(scope, "decrement"),
            panel_id: appScopedId(scope, "panel"),
            title_text: "Counter",
            subtitle_text: "Adjust the value.",
            note_text: "",
            card_width: f32FromMilli(352000),
            card_height: f32FromMilli(320000)
        };
    }

    public static fn withActions(resource_id: string, fallback: i32, increment_action: string, decrement_action: string) -> IntStepper {
        return IntStepper {
            scope: resource_id,
            value: IntBinding.create(resource_id, fallback),
            increment_action: increment_action,
            decrement_action: decrement_action,
            panel_id: appScopedId(resource_id, "panel"),
            title_text: "Counter",
            subtitle_text: "Adjust the value.",
            note_text: "",
            card_width: f32FromMilli(352000),
            card_height: f32FromMilli(320000)
        };
    }

    public fn id(&self) -> string {
        return self.scope;
    }

    public fn panel(mut self, id: string) -> IntStepper {
        self.panel_id = id;
        return self;
    }

    public fn titled(mut self, title: string, subtitle: string, note: string) -> IntStepper {
        self.title_text = title;
        self.subtitle_text = subtitle;
        self.note_text = note;
        return self;
    }

    public fn cardSize(mut self, width: f32, height: f32) -> IntStepper {
        self.card_width = width;
        self.card_height = height;
        return self;
    }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        var out = world;
        if (!self.value.exists(out)) {
            out = self.value.set(out, self.value.fallback);
        }
        return self.value.registerStepPair(out, self.increment_action, self.decrement_action);
    }

    public fn update(&self, event: AppEvent, world: AppWorld) -> AppWorld {
        return world;
    }

    public fn configureScene(&self, scene: AppScene) -> AppScene {
        var world = scene.world.dup();
        world = self.configure(world);
        var out = scene.setWorld(world);
        world.destroy();
        return out;
    }

    public fn titleView(&self, id: string) -> View {
        return self.value.titleView(id);
    }

    public fn bodyView(&self, id: string) -> View {
        return self.value.bodyView(id);
    }

    public fn controls(&self, id: string) -> View {
        return StepperControl.actions(id, id + ".decrement", id + ".increment", self.decrement_action, self.increment_action);
    }

    public fn contentColumn(&self, title: string, subtitle: string, note: string) -> View {
        let title_view = Text.title(title)
            .id(appScopedId(self.scope, "title"))
            .height(f32FromMilli(38000))
            .textCenter();
        let subtitle_view = Text.body(subtitle)
            .id(appScopedId(self.scope, "subtitle"))
            .height(f32FromMilli(30000))
            .textCenter();
        let value_view = self.titleView(appScopedId(self.scope, "value.view"))
            .width(f32FromMilli(160000))
            .height(f32FromMilli(68000))
            .textCenter()
            .foreground(colorRgbaMilli(50, 200, 180, 1000))
            .accessibilityLabel("Counter value");
        let controls_view = self.controls(appScopedId(self.scope, "controls"));
        let note_view = Text.body(note)
            .id(appScopedId(self.scope, "note"))
            .width(f32FromMilli(288000))
            .height(f32FromMilli(30000))
            .textCenter();
        var items = Vec::<View>.new();
        items.push(title_view);
        items.push(subtitle_view);
        items.push(value_view);
        items.push(controls_view);
        items.push(note_view);
        return Column.create()
            .gap(f32FromMilli(16000))
            .alignCenter()
            .children(items);
    }

    public fn card(mut self, id: string, title: string, subtitle: string, note: string, width: f32, height: f32) -> View {
        return AppSurface.card(id, width, height)
            .child(self.contentColumn(title, subtitle, note));
    }

    public fn view(mut self, world: AppWorld) -> View {
        return self.card(
            self.panel_id,
            self.title_text,
            self.subtitle_text,
            self.note_text,
            self.card_width,
            self.card_height
        );
    }
}
