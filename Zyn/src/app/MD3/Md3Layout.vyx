module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use std.collections;
use Column = Zyn.App.Column;
use Divider = Zyn.App.Divider;
use Flow = Zyn.App.Flow;
use Grid = Zyn.App.Grid;
use Panel = Zyn.App.Panel;
use Row = Zyn.App.Row;
use Scroll = Zyn.App.Scroll;
use Stack = Zyn.App.Stack;
use View = Zyn.App.View;
use Wrap = Zyn.App.Wrap;
use appColorRoleBackground = Zyn.App.appColorRoleBackground;
use appColorRoleOutlineVariant = Zyn.App.appColorRoleOutlineVariant;
use appColorRoleSurface = Zyn.App.appColorRoleSurface;
use appColorRoleSurfaceVariant = Zyn.App.appColorRoleSurfaceVariant;

public class Md3ListItem {
    public static fn oneLine(id: string, headline: string) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(56000))
            .padding(f32FromMilli(16000))
            .backgroundRole(appColorRoleSurface())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(Md3Text.body(id + ".headline", headline).expanded());
    }

    public static fn twoLine(id: string, headline: string, supporting: string) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(72000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(2000))
            .backgroundRole(appColorRoleSurface())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(Column.create()
                .id(id + ".text")
                .gap(f32FromMilli(2000))
                .child(Md3Text.body(id + ".headline", headline))
                .child(Md3Text.supporting(id + ".supporting", supporting)));
    }

    public static fn trailing(id: string, headline: string, supporting: string, trailing: View) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(72000))
            .padding(f32FromMilli(16000))
            .backgroundRole(appColorRoleSurface())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(Row.create()
                .id(id + ".row")
                .gap(f32FromMilli(12000))
                .alignCenter()
                .child(Column.create()
                    .id(id + ".text")
                    .gap(f32FromMilli(2000))
                    .expanded()
                    .child(Md3Text.body(id + ".headline", headline))
                    .child(Md3Text.supporting(id + ".supporting", supporting)))
                .child(trailing));
    }
}

public class Md3TopAppBar {
    public static fn small(id: string, title: string) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(64000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(8000))
            .backgroundRole(appColorRoleSurface())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(Row.create()
                .id(id + ".row")
                .height(f32FromMilli(48000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .child(Md3Text.title(id + ".title", title).expanded()));
    }

    @[borrow_args]
    public static fn smallWithActions(id: string, title: string, actions: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(64000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(8000))
            .backgroundRole(appColorRoleSurface())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(Row.create()
                .id(id + ".row")
                .height(f32FromMilli(48000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .child(Md3Text.title(id + ".title", title).expanded())
                .child(Row.create()
                    .id(id + ".actions")
                    .height(f32FromMilli(40000))
                    .gap(f32FromMilli(8000))
                    .alignCenter()
                    .children(actions)));
    }
}

public class Md3Scaffold {
    public static fn body(root_id: string, content: View) -> View {
        return Stack.create()
            .id(root_id)
            .child(Md3Surface.background(root_id + ".background"))
            .child(content.anchorFill());
    }

    public static fn withTopBar(root_id: string, top_bar: View, content: View) -> View {
        return Stack.create()
            .id(root_id)
            .child(Md3Surface.background(root_id + ".background"))
            .child(Column.create()
                .id(root_id + ".layout")
                .anchorFill()
                .child(top_bar)
                .child(content.expanded()));
    }
}

public class Md3Content {
    public static fn padded(id: string, content: View) -> View {
        return Panel.create()
            .id(id)
            .padding(f32FromMilli(24000))
            .gap(f32FromMilli(16000))
            .backgroundRole(appColorRoleBackground())
            .noStroke()
            .cornerRadius(f32Zero())
            .child(content.anchorFill());
    }

    public static fn scroll(id: string, content: View) -> View {
        return Scroll.create()
            .id(id)
            .padding(f32FromMilli(24000))
            .gap(f32FromMilli(16000))
            .backgroundRole(appColorRoleBackground())
            .child(content);
    }

    public static fn centered(id: string, content: View, max_width: f32) -> View {
        return Stack.create()
            .id(id)
            .child(content.maxWidth(max_width).anchorCenter());
    }

    public static fn page(id: string, content: View) -> View {
        return Md3Scaffold.body(id, Md3Content.padded(id + ".content", content));
    }
}

public class Md3Section {
    public static fn create(id: string, title: string, content: View) -> View {
        return Column.create()
            .id(id)
            .gap(f32FromMilli(12000))
            .child(Md3Text.title(id + ".title", title))
            .child(content);
    }

    public static fn supporting(id: string, title: string, supporting: string, content: View) -> View {
        return Column.create()
            .id(id)
            .gap(f32FromMilli(8000))
            .child(Md3Text.title(id + ".title", title))
            .child(Md3Text.supporting(id + ".supporting", supporting))
            .child(content);
    }

    public static fn card(id: string, title: string, content: View) -> View {
        return Md3Surface.card(id)
            .child(Md3Text.title(id + ".title", title))
            .child(content);
    }

    public static fn filledCard(id: string, title: string, content: View) -> View {
        return Md3Surface.filledCard(id)
            .child(Md3Text.title(id + ".title", title))
            .child(content);
    }
}

public class Md3Pane {
    public static fn surface(id: string, content: View) -> View {
        return Panel.create()
            .id(id)
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(12000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32FromMilli(12000))
            .child(content);
    }

    public static fn side(id: string, width: f32, content: View) -> View {
        return Md3Pane.surface(id, content)
            .width(width)
            .anchorStartFill();
    }

    public static fn bottom(id: string, height: f32, content: View) -> View {
        return Md3Pane.surface(id, content)
            .height(height)
            .anchorBottomFill();
    }
}

public class Md3Split {
    public static fn horizontal(id: string, leading: View, trailing: View, leading_width: f32) -> View {
        return Row.create()
            .id(id)
            .gap(f32FromMilli(24000))
            .child(leading.width(leading_width))
            .child(trailing.expanded());
    }

    public static fn vertical(id: string, top: View, bottom: View, top_height: f32) -> View {
        return Column.create()
            .id(id)
            .gap(f32FromMilli(24000))
            .child(top.height(top_height))
            .child(bottom.expanded());
    }

    public static fn weighted(id: string, leading: View, leading_weight: f32, trailing: View, trailing_weight: f32) -> View {
        return Row.create()
            .id(id)
            .gap(f32FromMilli(24000))
            .child(leading.flex(leading_weight))
            .child(trailing.flex(trailing_weight));
    }
}

public class Md3Grid {
    @[borrow_args]
    public static fn fixed(id: string, columns: i32, item_height: f32, items: Vec<View>) -> View {
        return Grid.fixed(columns, item_height)
            .id(id)
            .gap(f32FromMilli(16000))
            .children(items);
    }

    @[borrow_args]
    public static fn adaptive(id: string, min_item_width: f32, item_height: f32, items: Vec<View>) -> View {
        return Grid.adaptive(min_item_width)
            .id(id)
            .itemHeight(item_height)
            .gap(f32FromMilli(16000))
            .children(items);
    }

    @[borrow_args]
    public static fn cards(id: string, min_card_width: f32, card_height: f32, cards: Vec<View>) -> View {
        return Grid.adaptive(min_card_width)
            .id(id)
            .itemHeight(card_height)
            .gap(f32FromMilli(16000))
            .children(cards);
    }
}

public class Md3Flow {
    @[borrow_args]
    public static fn chips(id: string, items: Vec<View>) -> View {
        return Wrap.items(f32FromMilli(96000), f32FromMilli(32000))
            .id(id)
            .gap(f32FromMilli(8000))
            .children(items);
    }

    @[borrow_args]
    public static fn buttons(id: string, items: Vec<View>) -> View {
        return Flow.wrap(f32FromMilli(120000), f32FromMilli(40000))
            .id(id)
            .gap(f32FromMilli(8000))
            .children(items);
    }
}

public class Md3List {
    @[borrow_args]
    public static fn vertical(id: string, items: Vec<View>) -> View {
        return Column.create()
            .id(id)
            .gap(f32Zero())
            .children(items);
    }

    @[borrow_args]
    public static fn grouped(id: string, title: string, items: Vec<View>) -> View {
        return Md3Surface.card(id)
            .child(Md3Text.title(id + ".title", title))
            .child(Column.create()
                .id(id + ".items")
                .gap(f32Zero())
                .children(items));
    }

    @[borrow_args]
    public static fn divided(id: string, items: Vec<View>) -> View {
        var out = Column.create().id(id).gap(f32Zero());
        var i: i32 = 0;
        while (i < (items.len as i32)) {
            if (i > 0) {
                out = out.child(Divider.horizontal().id(id + ".divider." + format("%d", i as i64)));
            }
            out = out.child(items.get(i as i64));
            i = i + 1;
        }
        return out;
    }
}

public class Md3EmptyState {
    public static fn create(id: string, title: string, supporting: string, action: View) -> View {
        return Panel.create()
            .id(id)
            .padding(f32FromMilli(24000))
            .gap(f32FromMilli(12000))
            .backgroundRole(appColorRoleSurfaceVariant())
            .noStroke()
            .cornerRadius(f32FromMilli(16000))
            .child(Md3Text.title(id + ".title", title).textCenter())
            .child(Md3Text.supporting(id + ".supporting", supporting).textCenter())
            .child(Row.create()
                .id(id + ".actions")
                .height(f32FromMilli(44000))
                .mainCenter()
                .alignCenter()
                .child(action));
    }
}
