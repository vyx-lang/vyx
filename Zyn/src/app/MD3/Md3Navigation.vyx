module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use std.collections;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use Panel = Zyn.App.Panel;
use Row = Zyn.App.Row;
use Toggle = Zyn.App.Toggle;
use View = Zyn.App.View;
use appColorRoleOutlineVariant = Zyn.App.appColorRoleOutlineVariant;
use appColorRoleSurface = Zyn.App.appColorRoleSurface;

public class Md3NavigationItem {
    public static fn create(id: string, label: string, action_name: string, selected: bool) -> View {
        var out: View;
        if (selected) {
            out = Button.tonalAction(id, label, action_name);
        } else {
            out = Button.outlinedAction(id, label, action_name).noStroke();
        }
        return out
            .height(f32FromMilli(48000))
            .minWidth(f32FromMilli(80000))
            .role("tab")
            .accessibilityLabel(label);
    }

    public static fn bound(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Toggle.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(48000))
            .minWidth(f32FromMilli(80000))
            .role("tab")
            .accessibilityLabel(label);
    }
}

public class Md3NavigationBar {
    @[borrow_args]
    public static fn create(id: string, items: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(80000))
            .padding(f32FromMilli(12000))
            .gap(f32FromMilli(8000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32Zero())
            .child(Row.create()
                .id(id + ".items")
                .height(f32FromMilli(56000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .children(items));
    }
}

public class Md3NavigationRail {
    @[borrow_args]
    public static fn create(id: string, items: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .width(f32FromMilli(96000))
            .padding(f32FromMilli(12000))
            .gap(f32FromMilli(8000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32Zero())
            .child(Column.create()
                .id(id + ".items")
                .gap(f32FromMilli(8000))
                .alignCenter()
                .children(items));
    }
}

public class Md3Tabs {
    @[borrow_args]
    public static fn primary(id: string, items: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(56000))
            .padding(f32FromMilli(8000))
            .gap(f32FromMilli(8000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32Zero())
            .child(Row.create()
                .id(id + ".items")
                .height(f32FromMilli(40000))
                .gap(f32FromMilli(8000))
                .alignCenter()
                .children(items));
    }
}
