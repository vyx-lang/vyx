module Zyn.App.MD3;

use UiTheme = Zyn.UI.UiTheme;

public class Md3Theme {
    public static fn light() -> UiTheme {
        let theme = UiTheme.md3Light();
        return theme.dup();
    }

    public static fn dark() -> UiTheme {
        let theme = UiTheme.md3Dark();
        return theme.dup();
    }

    public static fn standard() -> UiTheme {
        let theme = UiTheme.md3();
        return theme.dup();
    }

    public static fn dense(theme: UiTheme, scale: f32) -> UiTheme {
        var out = theme.dup();
        out.spacing_xs = out.spacing_xs * scale;
        out.spacing_sm = out.spacing_sm * scale;
        out.spacing_md = out.spacing_md * scale;
        out.spacing_lg = out.spacing_lg * scale;
        out.control_height = out.control_height * scale;
        return out;
    }
}
