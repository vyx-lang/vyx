module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use Button = Zyn.App.Button;
use Checkbox = Zyn.App.Checkbox;
use Progress = Zyn.App.Progress;
use Slider = Zyn.App.Slider;
use TextField = Zyn.App.TextField;
use Toggle = Zyn.App.Toggle;
use View = Zyn.App.View;
use appColorRoleOutline = Zyn.App.appColorRoleOutline;
use appColorRoleSurface = Zyn.App.appColorRoleSurface;
use appColorRoleText = Zyn.App.appColorRoleText;

public class Md3Button {
    public static fn filled(id: string, label: string, action_name: string) -> View {
        return Button.filledAction(id, label, action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(64000))
            .accessibilityLabel(label);
    }

    public static fn tonal(id: string, label: string, action_name: string) -> View {
        return Button.tonalAction(id, label, action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(64000))
            .accessibilityLabel(label);
    }

    public static fn outlined(id: string, label: string, action_name: string) -> View {
        return Button.outlinedAction(id, label, action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(64000))
            .accessibilityLabel(label);
    }

    public static fn text(id: string, label: string, action_name: string) -> View {
        return Button.outlinedAction(id, label, action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(64000))
            .noStroke()
            .accessibilityLabel(label);
    }
}

public class Md3Field {
    public static fn textInput(id: string, placeholder: string, resource_id: string, action_name: string) -> View {
        return TextField.bound(id, placeholder, resource_id, action_name)
            .action(action_name)
            .height(f32FromMilli(56000))
            .minWidth(f32FromMilli(220000))
            .backgroundRole(appColorRoleSurface())
            .foregroundRole(appColorRoleText())
            .strokeRole(f32One(), appColorRoleOutline())
            .cornerRadius(f32FromMilli(8000))
            .accessibilityLabel(placeholder);
    }
}

public class Md3Selection {
    public static fn checkbox(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Checkbox.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(120000))
            .accessibilityLabel(label);
    }

    public static fn switchControl(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Toggle.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(120000))
            .accessibilityLabel(label);
    }

    public static fn slider(id: string, label: string, resource_id: string, action_name: string, min_value: f32, max_value: f32) -> View {
        return Slider.create(label)
            .id(id)
            .bindFloat(resource_id)
            .action(action_name)
            .range(min_value, max_value)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(180000))
            .accessibilityLabel(label);
    }

    public static fn progress(id: string, label: string, resource_id: string, min_value: f32, max_value: f32) -> View {
        return Progress.create(label)
            .id(id)
            .bindFloat(resource_id)
            .range(min_value, max_value)
            .height(f32FromMilli(32000))
            .minWidth(f32FromMilli(180000))
            .accessibilityLabel(label);
    }
}
