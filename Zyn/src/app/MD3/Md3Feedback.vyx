module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use std.collections;
use Button = Zyn.App.Button;
use Panel = Zyn.App.Panel;
use Row = Zyn.App.Row;
use Toggle = Zyn.App.Toggle;
use View = Zyn.App.View;
use appColorRoleSurfaceVariant = Zyn.App.appColorRoleSurfaceVariant;
use appColorRoleText = Zyn.App.appColorRoleText;

public class Md3Chip {
    public static fn assist(id: string, label: string, action_name: string) -> View {
        return Button.outlinedAction(id, label, action_name)
            .height(f32FromMilli(32000))
            .minWidth(f32FromMilli(64000))
            .cornerRadius(f32FromMilli(8000))
            .accessibility("button", label, "");
    }

    public static fn filter(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Toggle.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(32000))
            .minWidth(f32FromMilli(64000))
            .cornerRadius(f32FromMilli(8000))
            .role("checkbox")
            .accessibilityLabel(label);
    }
}

public class Md3Fab {
    public static fn small(id: string, label: string, action_name: string) -> View {
        return Button.filledAction(id, label, action_name)
            .size(f32FromMilli(40000), f32FromMilli(40000))
            .cornerRadius(f32FromMilli(12000))
            .accessibilityLabel(label);
    }

    public static fn regular(id: string, label: string, action_name: string) -> View {
        return Button.filledAction(id, label, action_name)
            .size(f32FromMilli(56000), f32FromMilli(56000))
            .cornerRadius(f32FromMilli(16000))
            .accessibilityLabel(label);
    }

    public static fn extended(id: string, label: string, action_name: string) -> View {
        return Button.filledAction(id, label, action_name)
            .height(f32FromMilli(56000))
            .minWidth(f32FromMilli(96000))
            .cornerRadius(f32FromMilli(16000))
            .accessibilityLabel(label);
    }
}

public class Md3Snackbar {
    public static fn message(id: string, text: string) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(56000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(12000))
            .backgroundRole(appColorRoleSurfaceVariant())
            .noStroke()
            .cornerRadius(f32FromMilli(8000))
            .child(Md3Text.body(id + ".message", text).foregroundRole(appColorRoleText()));
    }

    public static fn action(id: string, text: string, action_label: string, action_name: string) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(56000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(12000))
            .backgroundRole(appColorRoleSurfaceVariant())
            .noStroke()
            .cornerRadius(f32FromMilli(8000))
            .child(Row.create()
                .id(id + ".row")
                .gap(f32FromMilli(12000))
                .alignCenter()
                .child(Md3Text.body(id + ".message", text).expanded())
                .child(Md3Button.text(id + ".action", action_label, action_name)));
    }
}

public class Md3Dialog {
    @[borrow_args]
    public static fn basic(id: string, title: string, text: string, actions: Vec<View>) -> View {
        return Md3Surface.card(id)
            .anchorCenter()
            .size(f32FromMilli(320000), f32FromMilli(220000))
            .child(Md3Text.title(id + ".title", title))
            .child(Md3Text.body(id + ".body", text).height(f32FromMilli(72000)))
            .child(Row.create()
                .id(id + ".actions")
                .height(f32FromMilli(44000))
                .gap(f32FromMilli(8000))
                .mainEnd()
                .alignCenter()
                .children(actions));
    }

    // A real modal rather than a Stack child: the returned subtree is tagged as
    // belonging to `layer_id`, so while that layer is the topmost modal one Tab
    // stays inside the dialog and everything behind it becomes inert. Pair it
    // with `world.openLayer(AppLayer.dialog(layer_id))` and Esc will dismiss it
    // and restore the focus that was active before it opened.
    @[borrow_args]
    public static fn modal(id: string, layer_id: string, title: string, text: string, actions: Vec<View>) -> View {
        return Md3Dialog.basic(id, title, text, actions).layer(layer_id);
    }
}
