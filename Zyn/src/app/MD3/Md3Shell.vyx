module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use std.collections;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use Panel = Zyn.App.Panel;
use Row = Zyn.App.Row;
use Stack = Zyn.App.Stack;
use Toggle = Zyn.App.Toggle;
use View = Zyn.App.View;
use appColorRoleOutline = Zyn.App.appColorRoleOutline;
use appColorRoleOutlineVariant = Zyn.App.appColorRoleOutlineVariant;
use appColorRoleSurface = Zyn.App.appColorRoleSurface;
use appColorRoleSurfaceVariant = Zyn.App.appColorRoleSurfaceVariant;

public class Md3MenuItem {
    public static fn action(id: string, label: string, action_name: string) -> View {
        return Button.outlinedAction(id, label, action_name)
            .height(f32FromMilli(48000))
            .minWidth(f32FromMilli(160000))
            .noStroke()
            .textLeft()
            .role("menuitem")
            .accessibilityLabel(label);
    }

    public static fn checked(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Toggle.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(48000))
            .minWidth(f32FromMilli(160000))
            .textLeft()
            .role("menuitemcheckbox")
            .accessibilityLabel(label);
    }
}

public class Md3Menu {
    @[borrow_args]
    public static fn create(id: string, items: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .width(f32FromMilli(240000))
            .padding(f32FromMilli(8000))
            .gap(f32FromMilli(4000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32FromMilli(4000))
            .child(Column.create()
                .id(id + ".items")
                .gap(f32FromMilli(4000))
                .children(items));
    }
}

public class Md3Drawer {
    @[borrow_args]
    public static fn modal(id: string, title: string, items: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .width(f32FromMilli(320000))
            .padding(f32FromMilli(16000))
            .gap(f32FromMilli(12000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32Zero())
            .child(Column.create()
                .id(id + ".content")
                .gap(f32FromMilli(12000))
                .child(Md3Text.title(id + ".title", title))
                .child(Column.create()
                    .id(id + ".items")
                    .gap(f32FromMilli(4000))
                    .children(items)));
    }
}

public class Md3BottomSheet {
    public static fn modal(id: string, title: string, content: View, width: f32, height: f32) -> View {
        return Panel.create()
            .id(id)
            .anchorBottomRight(f32Zero())
            .size(width, height)
            .padding(f32FromMilli(24000))
            .gap(f32FromMilli(16000))
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutlineVariant())
            .cornerRadius(f32FromMilli(16000))
            .child(Md3Text.title(id + ".title", title))
            .child(content.expanded());
    }
}

public class Md3SearchBar {
    public static fn bound(id: string, placeholder: string, resource_id: string, action_name: string) -> View {
        return Panel.create()
            .id(id + ".surface")
            .height(f32FromMilli(64000))
            .padding(f32FromMilli(4000))
            .backgroundRole(appColorRoleSurfaceVariant())
            .noStroke()
            .cornerRadius(f32FromMilli(28000))
            .child(Md3Field.textInput(id, placeholder, resource_id, action_name)
                .height(f32FromMilli(56000))
                .backgroundRole(appColorRoleSurfaceVariant())
                .noStroke()
                .cornerRadius(f32FromMilli(28000)));
    }
}

public class Md3SegmentedButton {
    public static fn segment(id: string, label: string, resource_id: string, action_name: string) -> View {
        return Toggle.create(label)
            .id(id)
            .bindChecked(resource_id)
            .action(action_name)
            .height(f32FromMilli(40000))
            .minWidth(f32FromMilli(88000))
            .cornerRadius(f32Zero())
            .role("radio")
            .accessibilityLabel(label);
    }

    @[borrow_args]
    public static fn group(id: string, segments: Vec<View>) -> View {
        return Panel.create()
            .id(id)
            .height(f32FromMilli(48000))
            .padding(f32FromMilli(4000))
            .gap(f32Zero())
            .backgroundRole(appColorRoleSurface())
            .strokeRole(f32One(), appColorRoleOutline())
            .cornerRadius(f32FromMilli(20000))
            .child(Row.create()
                .id(id + ".segments")
                .height(f32FromMilli(40000))
                .gap(f32Zero())
                .alignCenter()
                .children(segments));
    }
}

public class Md3AppShell {
    public static fn withTopBarAndFab(root_id: string, top_bar: View, content: View, fab: View) -> View {
        return Stack.create()
            .id(root_id)
            .child(Md3Surface.background(root_id + ".background"))
            .child(Column.create()
                .id(root_id + ".layout")
                .anchorFill()
                .child(top_bar)
                .child(content.expanded()))
            .child(fab.anchorBottomRight(f32FromMilli(24000)));
    }

    public static fn withDrawer(root_id: string, drawer: View, content: View) -> View {
        return Stack.create()
            .id(root_id)
            .child(Md3Surface.background(root_id + ".background"))
            .child(Row.create()
                .id(root_id + ".layout")
                .anchorFill()
                .gap(f32Zero())
                .child(drawer)
                .child(content.expanded()));
    }
}
