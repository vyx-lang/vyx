module Zyn.App.MD3;

use f32Zero = Zyn.Nut.Types.f32Zero;
use f32One = Zyn.Nut.Types.f32One;
use f32FromMilli = Zyn.Nut.Types.f32FromMilli;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use Text = Zyn.App.Text;
use View = Zyn.App.View;
use appColorRoleMutedText = Zyn.App.appColorRoleMutedText;
use appColorRoleText = Zyn.App.appColorRoleText;

public class Md3Text {
    public static fn headline(id: string, value: string) -> View {
        return Text.title(value)
            .id(id)
            .height(f32FromMilli(48000))
            .foregroundRole(appColorRoleText())
            .accessibilityLabel(value);
    }

    public static fn title(id: string, value: string) -> View {
        return Text.title(value)
            .id(id)
            .height(f32FromMilli(36000))
            .foregroundRole(appColorRoleText())
            .accessibilityLabel(value);
    }

    public static fn body(id: string, value: string) -> View {
        return Text.body(value)
            .id(id)
            .height(f32FromMilli(28000))
            .foregroundRole(appColorRoleText())
            .accessibilityLabel(value);
    }

    public static fn supporting(id: string, value: string) -> View {
        return Text.muted(value)
            .id(id)
            .height(f32FromMilli(24000))
            .foregroundRole(appColorRoleMutedText())
            .accessibilityLabel(value);
    }

    public static fn label(id: string, value: string) -> View {
        return Text.body(value)
            .id(id)
            .height(f32FromMilli(22000))
            .foregroundRole(appColorRoleMutedText())
            .accessibilityLabel(value);
    }

    public static fn titleBound(id: string, resource_id: string, default_text: string) -> View {
        return Text.titleBound(resource_id, default_text)
            .id(id)
            .height(f32FromMilli(36000))
            .foregroundRole(appColorRoleText());
    }

    public static fn bodyBound(id: string, resource_id: string, default_text: string) -> View {
        return Text.bodyBound(resource_id, default_text)
            .id(id)
            .height(f32FromMilli(28000))
            .foregroundRole(appColorRoleText());
    }
}
