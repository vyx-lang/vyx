use UiTheme = Zyn.UI.UiTheme;
use Renderer = Zyn.Nut.Renderer.Renderer;
fn appDefaultRendererSetup(renderer: &mut Renderer) -> i32 {
    return 0;
}

public fn appViewColumn() -> i32 { return 1; }
public fn appViewRow() -> i32 { return 2; }
public fn appViewText() -> i32 { return 3; }
public fn appViewButton() -> i32 { return 4; }
public fn appViewPanel() -> i32 { return 5; }
public fn appViewSpacer() -> i32 { return 6; }
public fn appViewToggle() -> i32 { return 7; }
public fn appViewTextField() -> i32 { return 8; }
public fn appViewStack() -> i32 { return 9; }
public fn appViewScroll() -> i32 { return 10; }
public fn appViewSlider() -> i32 { return 11; }
public fn appViewCheckbox() -> i32 { return 12; }
public fn appViewProgress() -> i32 { return 13; }
public fn appViewList() -> i32 { return 14; }
public fn appViewBox() -> i32 { return 15; }
public fn appViewDivider() -> i32 { return 16; }
public fn appViewGrid() -> i32 { return 17; }
public fn appViewWrap() -> i32 { return 18; }
public fn appViewCustom() -> i32 { return 19; }
public fn appViewRender() -> i32 { return 20; }

public fn appButtonStyleFilled() -> i32 { return 1; }
public fn appButtonStyleTonal() -> i32 { return 2; }
public fn appButtonStyleOutlined() -> i32 { return 3; }

public fn appTextStyleBody() -> i32 { return 1; }
public fn appTextStyleTitle() -> i32 { return 2; }
public fn appTextStyleMuted() -> i32 { return 3; }

public fn appAlignStart() -> i32 { return 1; }
public fn appAlignCenter() -> i32 { return 2; }
public fn appAlignEnd() -> i32 { return 3; }
public fn appAlignStretch() -> i32 { return 4; }

public fn appAnchorFlow() -> i32 { return 0; }
public fn appAnchorFill() -> i32 { return 1; }
public fn appAnchorTopFill() -> i32 { return 2; }
public fn appAnchorCenter() -> i32 { return 3; }
public fn appAnchorBottomRight() -> i32 { return 4; }
public fn appAnchorTopStart() -> i32 { return 5; }
public fn appAnchorTopEnd() -> i32 { return 6; }
public fn appAnchorBottomStart() -> i32 { return 7; }
public fn appAnchorBottomEnd() -> i32 { return 8; }
public fn appAnchorStartFill() -> i32 { return 9; }
public fn appAnchorEndFill() -> i32 { return 10; }
public fn appAnchorBottomFill() -> i32 { return 11; }

public fn appTextAlignLeft() -> i32 { return 1; }
public fn appTextAlignCenter() -> i32 { return 2; }
public fn appTextAlignRight() -> i32 { return 3; }

