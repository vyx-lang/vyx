public fn appInteractionPointerDown() -> i32 { return 2; }
public fn appInteractionPointerUp() -> i32 { return 3; }
public fn appInteractionPointerScrolled() -> i32 { return 4; }
public fn appInteractionPointerDragged() -> i32 { return 5; }
public fn appInteractionTextInput() -> i32 { return 6; }
public fn appInteractionKeyDown() -> i32 { return 7; }
public fn appInteractionKeyUp() -> i32 { return 8; }

// Overlay layers. A modal layer owns focus while it is on top: Tab cycles
// inside it, pointer events outside it are dropped, and Esc dismisses it.
public fn appLayerDialog() -> i32 { return 1; }
public fn appLayerPopover() -> i32 { return 2; }
public fn appLayerTooltip() -> i32 { return 3; }

// Effects are the only way to reach the outside world. They are requested on
// the UI scheduler, completed elsewhere, and committed back on the UI
// scheduler -- never by spawning a Vyx thread.
public fn appEffectFile() -> i32 { return 1; }
public fn appEffectNetwork() -> i32 { return 2; }
public fn appEffectDatabase() -> i32 { return 3; }
public fn appEffectTimer() -> i32 { return 4; }

public fn appEffectPending() -> i32 { return 0; }
public fn appEffectDone() -> i32 { return 1; }
public fn appEffectFailed() -> i32 { return 2; }
public fn appEffectCancelled() -> i32 { return 3; }
public fn appEffectExpired() -> i32 { return 4; }

// Modifier *classes* (SDL3 KMOD masks, matching Zyn.Platform.Input.KeyModifier).
// A rule that requires a class is satisfied by either the left or the right
// physical key, so callers never have to spell out both halves.
public fn appKeyModShift() -> u32 { return 0x0003 as u32; }
public fn appKeyModCtrl() -> u32 { return 0x00C0 as u32; }
public fn appKeyModAlt() -> u32 { return 0x0300 as u32; }
public fn appKeyModGui() -> u32 { return 0x0C00 as u32; }

public fn appKeyModifiersSatisfy(required: u32, actual: u32) -> bool {
    if ((required & appKeyModShift()) != 0 as u32 && (actual & appKeyModShift()) == 0 as u32) { return false; }
    if ((required & appKeyModCtrl()) != 0 as u32 && (actual & appKeyModCtrl()) == 0 as u32) { return false; }
    if ((required & appKeyModAlt()) != 0 as u32 && (actual & appKeyModAlt()) == 0 as u32) { return false; }
    if ((required & appKeyModGui()) != 0 as u32 && (actual & appKeyModGui()) == 0 as u32) { return false; }
    return true;
}

public class AppError {
    public code: i32;
    public message: string;

    public static fn create(code: i32, message: string) -> AppError {
        return AppError { code: code, message: message };
    }

}

public class AppEvent {
    public kind: i32;
    public action_name: string;
    public platform_event: Event;
    public frame_index: u64;
    public delta_ns: u64;

    public static fn frame(frame_index: u64, delta_ns: u64) -> AppEvent {
        return AppEvent {
            kind: 1,
            action_name: "",
            platform_event: Event.empty(),
            frame_index: frame_index,
            delta_ns: delta_ns
        };
    }

    public static fn platform(event: Event) -> AppEvent {
        return AppEvent {
            kind: 2,
            action_name: "",
            platform_event: event,
            frame_index: 0 as u64,
            delta_ns: 0 as u64
        };
    }

    public static fn action(name: string) -> AppEvent {
        return AppEvent {
            kind: 3,
            action_name: name,
            platform_event: Event.empty(),
            frame_index: 0 as u64,
            delta_ns: 0 as u64
        };
    }

    public fn isFrame(&self) -> bool {
        return self.kind == 1;
    }

    public fn isPlatform(&self) -> bool {
        return self.kind == 2;
    }

    public fn isAction(&self, name: string) -> bool {
        return self.kind == 3 && self.action_name == name;
    }

    public fn isQuit(&self) -> bool {
        return self.isPlatform()
            && (self.platform_event.isQuit() || self.platform_event.isWindowCloseRequested());
    }
}

public class AppContext {
    public spec: AppSpec;
    public base_path: string;
    public pref_path: string;

    public static fn create(spec: AppSpec) -> AppContext {
        return AppContext {
            spec: spec.dup(),
            base_path: AppPaths.basePath(),
            pref_path: AppPaths.prefPath(spec.identity.organization, spec.identity.name)
        };
    }
}

public class SceneContext {
    public app: AppContext;
    public window_width: i32;
    public window_height: i32;

    public static fn create(app: AppContext, window_width: i32, window_height: i32) -> SceneContext {
        return SceneContext {
            app: app,
            window_width: window_width,
            window_height: window_height
        };
    }
}

public class AppIdentity {
    public name: string;
    public version: string;
    public identifier: string;
    public organization: string;

    public static fn create(name: string, identifier: string) -> AppIdentity {
        return AppIdentity {
            name: name,
            version: "0.1.0",
            identifier: identifier,
            organization: "local"
        };
    }

    public fn setVersion(mut self, version: string) -> AppIdentity {
        self.version = version;
        return self;
    }

    public fn setOrganization(mut self, organization: string) -> AppIdentity {
        self.organization = organization;
        return self;
    }

    public fn dup(&self) -> AppIdentity {
        return AppIdentity {
            name: self.name,
            version: self.version,
            identifier: self.identifier,
            organization: self.organization
        };
    }
}

public class AppWindowSpec {
    public title: string;
    public width: i32;
    public height: i32;
    public visible: bool;
    public resizable: bool;
    public high_pixel_density: bool;

    public static fn create(title: string, width: i32, height: i32) -> AppWindowSpec {
        return AppWindowSpec {
            title: title,
            width: width,
            height: height,
            visible: true,
            resizable: true,
            high_pixel_density: true
        };
    }

    public fn hidden(mut self) -> AppWindowSpec {
        self.visible = false;
        return self;
    }

    public fn fixedSize(mut self) -> AppWindowSpec {
        self.resizable = false;
        return self;
    }

    public fn setHighPixelDensity(mut self, enabled: bool) -> AppWindowSpec {
        self.high_pixel_density = enabled;
        return self;
    }

    public fn toDesc(&self) -> WindowDesc {
        var desc = WindowDesc.create(self.title, self.width, self.height);
        if (!self.visible) { desc = desc.hidden(); }
        if (self.resizable) { desc = desc.resizable(); }
        if (self.high_pixel_density) { desc = desc.highPixelDensity(); }
        return desc;
    }

    public fn dup(&self) -> AppWindowSpec {
        return AppWindowSpec {
            title: self.title,
            width: self.width,
            height: self.height,
            visible: self.visible,
            resizable: self.resizable,
            high_pixel_density: self.high_pixel_density
        };
    }
}

public class AppRendererSpec {
    public width: u32;
    public height: u32;
    public backend_name: string;
    public clear_color: Color;
    public shader_path: string;
    public shader_cache_dir: string;
    public sprite_atlas_path: string;
    public font_path: string;
    public font_size: i32;
    public glyph_atlas_width: i32;
    public glyph_atlas_height: i32;
    public glyph_atlas_padding: i32;

    public static fn create(width: u32, height: u32) -> AppRendererSpec {
        return AppRendererSpec {
            width: width,
            height: height,
            backend_name: "auto",
            clear_color: colorRgbaMilli(80, 120, 180, 1000),
            shader_path: "nut/solid.slang",
            shader_cache_dir: "shader_cache_zyn_nut",
            sprite_atlas_path: "",
            font_path: "",
            font_size: 18,
            glyph_atlas_width: 1024,
            glyph_atlas_height: 512,
            glyph_atlas_padding: 1
        };
    }

    public fn setBackendName(mut self, name: string) -> AppRendererSpec {
        self.backend_name = name;
        return self;
    }

    public fn setClearColor(mut self, color: Color) -> AppRendererSpec {
        self.clear_color = color.dup();
        return self;
    }

    public fn setShaderPath(mut self, path: string) -> AppRendererSpec {
        self.shader_path = path;
        return self;
    }

    public fn setShaderCacheDirectory(mut self, path: string) -> AppRendererSpec {
        self.shader_cache_dir = path;
        return self;
    }

    public fn setSpriteAtlasPath(mut self, path: string) -> AppRendererSpec {
        self.sprite_atlas_path = path;
        return self;
    }

    public fn setFontPath(mut self, path: string) -> AppRendererSpec {
        self.font_path = path;
        return self;
    }

    public fn setFontSize(mut self, size: i32) -> AppRendererSpec {
        self.font_size = size;
        return self;
    }

    public fn setGlyphAtlas(mut self, width: i32, height: i32, padding: i32) -> AppRendererSpec {
        self.glyph_atlas_width = width;
        self.glyph_atlas_height = height;
        self.glyph_atlas_padding = padding;
        return self;
    }

    public fn dup(&self) -> AppRendererSpec {
        return AppRendererSpec {
            width: self.width,
            height: self.height,
            backend_name: self.backend_name,
            clear_color: self.clear_color.dup(),
            shader_path: self.shader_path,
            shader_cache_dir: self.shader_cache_dir,
            sprite_atlas_path: self.sprite_atlas_path,
            font_path: self.font_path,
            font_size: self.font_size,
            glyph_atlas_width: self.glyph_atlas_width,
            glyph_atlas_height: self.glyph_atlas_height,
            glyph_atlas_padding: self.glyph_atlas_padding
        };
    }
}

public class AppSpec {
    public identity: AppIdentity;
    public window: AppWindowSpec;
    public renderer: AppRendererSpec;
    public theme: UiTheme;
    public target_fps: i32;
    public init_flags: u32;
    public renderer_setup: fn(&mut Renderer) -> i32;

    public static fn create(name: string, identifier: string, width: i32, height: i32) -> AppSpec {
        return AppSpec {
            identity: AppIdentity.create(name, identifier),
            window: AppWindowSpec.create(name, width, height),
            renderer: AppRendererSpec.create(width as u32, height as u32),
            theme: UiTheme.md3(),
            target_fps: 60,
            init_flags: PlatformInit.app(),
            renderer_setup: appDefaultRendererSetup
        };
    }

    public fn setIdentity(mut self, identity: AppIdentity) -> AppSpec {
        self.identity = identity.dup();
        return self;
    }

    public fn setWindow(mut self, window: AppWindowSpec) -> AppSpec {
        self.window = window.dup();
        return self;
    }

    public fn setRenderer(mut self, renderer: AppRendererSpec) -> AppSpec {
        self.renderer = renderer.dup();
        return self;
    }

    public fn setTheme(mut self, theme: UiTheme) -> AppSpec {
        self.theme = theme.dup();
        return self;
    }

    public fn setTargetFps(mut self, target_fps: i32) -> AppSpec {
        self.target_fps = target_fps;
        return self;
    }

    public fn setInitFlags(mut self, flags: u32) -> AppSpec {
        self.init_flags = flags;
        return self;
    }

    public fn setRendererSetup(mut self, setup: fn(&mut Renderer) -> i32) -> AppSpec {
        self.renderer_setup = setup;
        return self;
    }

    public fn windowDesc(&self) -> WindowDesc {
        return self.window.toDesc();
    }

    public fn dup(&self) -> AppSpec {
        return AppSpec {
            identity: self.identity.dup(),
            window: self.window.dup(),
            renderer: self.renderer.dup(),
            theme: self.theme.dup(),
            target_fps: self.target_fps,
            init_flags: self.init_flags,
            renderer_setup: self.renderer_setup
        };
    }
}

public class AppRunOptions {
    public max_frames: i32;
    public poll_events: bool;
    public show_window: bool;
    public close_on_quit: bool;
    public recording_path: string;
    public reply_path: string;
    public reply_headless: bool;
    public repetitions: i32;
    public timeline_error: string;

    public static fn frames(max_frames: i32) -> AppRunOptions {
        return AppRunOptions {
            max_frames: max_frames,
            poll_events: true,
            show_window: false,
            close_on_quit: true,
            recording_path: "",
            reply_path: "",
            reply_headless: false,
            repetitions: 1,
            timeline_error: ""
        };
    }

    public static fn once() -> AppRunOptions {
        return AppRunOptions.frames(1);
    }

    public static fn visibleUntilClose() -> AppRunOptions {
        return AppRunOptions.frames(0).visible();
    }

    public fn visible(mut self) -> AppRunOptions {
        self.show_window = true;
        return self;
    }

    public fn withoutEventPolling(mut self) -> AppRunOptions {
        self.poll_events = false;
        return self;
    }

    public fn keepRunningAfterQuit(mut self) -> AppRunOptions {
        self.close_on_quit = false;
        return self;
    }

    public fn recordTo(mut self, path: string) -> AppRunOptions {
        self.recording_path = path;
        return self;
    }

    public fn replyFrom(mut self, path: string, repetitions: i32) -> AppRunOptions {
        self.reply_path = path;
        self.repetitions = repetitions;
        return self;
    }
}

public class AppRunReport {
    public exit_code: i32;
    public frames: i32;
    public events: i32;
    public quit_requested: bool;
    public rendered_frames: i32;
    public node_count: i32;
    public draw_commands: i32;
    public processed_actions: i32;

    public static fn create(exit_code: i32, frames: i32, events: i32, quit_requested: bool) -> AppRunReport {
        return AppRunReport {
            exit_code: exit_code,
            frames: frames,
            events: events,
            quit_requested: quit_requested,
            rendered_frames: 0,
            node_count: 0,
            draw_commands: 0,
            processed_actions: 0
        };
    }

    public fn ok(&self) -> bool {
        return self.exit_code == 0;
    }

    public fn withRenderStats(mut self, rendered_frames: i32, node_count: i32, draw_commands: i32, processed_actions: i32) -> AppRunReport {
        self.rendered_frames = rendered_frames;
        self.node_count = node_count;
        self.draw_commands = draw_commands;
        self.processed_actions = processed_actions;
        return self;
    }
}
