module Zyn.App;

use std.collections;
use std.encoding;

// ---------------------------------------------------------------------------
// ZC-18 platform adaptation matrix
//
// A capability is not "supported" because a header declares the symbol for it.
// It is `verified` only when something on the actual platform has run it. The
// roadmap is explicit about the consequence: a platform that has not been
// device-verified must not be marked releasable, and everything unverified
// stays `experimental`.
//
// So this module is a *table plus a gate*, and the two are deliberately kept
// apart:
//
//   * the table records, per (platform, capability), a status and an evidence
//     string. The default table below is the conservative starting point -
//     Windows is verified because it is the host the whole suite runs on;
//     everything else starts experimental or unknown until someone records
//     real evidence through `markVerified`.
//
//   * the gate answers one question - "may this platform ship?" - from the
//     table, and never from a hard-coded list of platform names. Adding a
//     platform or re-verifying a capability changes the gate automatically.
//
// Statuses are stored in resources so a test can flip one without editing the
// table, which is what makes "the gate refuses an unverified platform" testable
// on a machine that only has Windows.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Vocabulary
// ---------------------------------------------------------------------------

public fn appPlatformWindows() -> i32 { return 1; }
public fn appPlatformAndroid() -> i32 { return 2; }
public fn appPlatformLinux() -> i32 { return 3; }
public fn appPlatformMacOS() -> i32 { return 4; }
public fn appPlatformIOS() -> i32 { return 5; }

public fn appPlatformCount() -> i32 { return 5; }

public fn appPlatformName(platform: i32) -> string {
    if (platform == appPlatformWindows()) { return "windows"; }
    if (platform == appPlatformAndroid()) { return "android"; }
    if (platform == appPlatformLinux()) { return "linux"; }
    if (platform == appPlatformMacOS()) { return "macos"; }
    if (platform == appPlatformIOS()) { return "ios"; }
    return "unknown";
}

public fn appPlatformOf(name: string) -> i32 {
    if (name == "windows") { return appPlatformWindows(); }
    if (name == "android") { return appPlatformAndroid(); }
    if (name == "linux") { return appPlatformLinux(); }
    if (name == "macos") { return appPlatformMacOS(); }
    if (name == "ios") { return appPlatformIOS(); }
    return 0;
}

public fn appPlatformAt(index: i32) -> i32 {
    if (index < 0 || index >= appPlatformCount()) { return 0; }
    return index + 1;
}

// `verified` is the only status that lets a required capability through the
// gate. `unsupported` is a deliberate, documented absence - different from
// `unknown`, which means nobody has looked yet.
public fn appCapabilityVerified() -> i32 { return 1; }
public fn appCapabilityExperimental() -> i32 { return 2; }
public fn appCapabilityUnsupported() -> i32 { return 3; }
public fn appCapabilityUnknown() -> i32 { return 4; }

public fn appCapabilityStatusName(status: i32) -> string {
    if (status == appCapabilityVerified()) { return "verified"; }
    if (status == appCapabilityExperimental()) { return "experimental"; }
    if (status == appCapabilityUnsupported()) { return "unsupported"; }
    if (status == appCapabilityUnknown()) { return "unknown"; }
    return "unknown";
}

public fn appCapabilityStatusOf(name: string) -> i32 {
    if (name == "verified") { return appCapabilityVerified(); }
    if (name == "experimental") { return appCapabilityExperimental(); }
    if (name == "unsupported") { return appCapabilityUnsupported(); }
    return appCapabilityUnknown();
}

public fn appCapWindowHandle() -> i32 { return 1; }
public fn appCapIme() -> i32 { return 2; }
public fn appCapClipboard() -> i32 { return 3; }
public fn appCapFilePicker() -> i32 { return 4; }
public fn appCapTouch() -> i32 { return 5; }
public fn appCapAccessibility() -> i32 { return 6; }
public fn appCapDpiScale() -> i32 { return 7; }
public fn appCapSafeArea() -> i32 { return 8; }
public fn appCapLifecycle() -> i32 { return 9; }
public fn appCapCacao() -> i32 { return 10; }

public fn appCapabilityCount() -> i32 { return 10; }

public fn appCapabilityName(capability: i32) -> string {
    if (capability == appCapWindowHandle()) { return "window_handle"; }
    if (capability == appCapIme()) { return "ime"; }
    if (capability == appCapClipboard()) { return "clipboard"; }
    if (capability == appCapFilePicker()) { return "file_picker"; }
    if (capability == appCapTouch()) { return "touch"; }
    if (capability == appCapAccessibility()) { return "accessibility"; }
    if (capability == appCapDpiScale()) { return "dpi_scale"; }
    if (capability == appCapSafeArea()) { return "safe_area"; }
    if (capability == appCapLifecycle()) { return "lifecycle"; }
    if (capability == appCapCacao()) { return "cacao"; }
    return "unknown";
}

public fn appCapabilityAt(index: i32) -> i32 {
    if (index < 0 || index >= appCapabilityCount()) { return 0; }
    return index + 1;
}

// The capabilities that gate shipping. Without a window handle there is no
// window; without DPI and safe-area information the layout is wrong on the
// device it was measured on; without lifecycle the app cannot be backgrounded
// without losing state; without the Cacao backend there is nothing to draw
// through. IME, clipboard, touch, accessibility and the file picker are
// *features*: a platform can ship without them, but the matrix must still say
// which of those it has, because the application UI has to degrade honestly.
public fn appCapabilityRequired(capability: i32) -> bool {
    if (capability == appCapWindowHandle()) { return true; }
    if (capability == appCapDpiScale()) { return true; }
    if (capability == appCapSafeArea()) { return true; }
    if (capability == appCapLifecycle()) { return true; }
    if (capability == appCapCacao()) { return true; }
    return false;
}

// The platform entry point that backs each capability. Naming it here is what
// keeps the table from drifting into wishful thinking: a row with no backing
// symbol cannot honestly be `verified`.
public fn appCapabilityBacking(capability: i32) -> string {
    if (capability == appCapWindowHandle()) { return "Zyn.Platform.Window.Window"; }
    if (capability == appCapIme()) { return "sdl_start_text_input / sdl_set_text_input_area"; }
    if (capability == appCapClipboard()) { return "Zyn.Platform.Clipboard"; }
    if (capability == appCapFilePicker()) { return ""; }
    if (capability == appCapTouch()) { return "sdl_get_touch_count / sdl_get_touch_device_type"; }
    if (capability == appCapAccessibility()) { return "AppAccessibilityBridge"; }
    if (capability == appCapDpiScale()) { return "sdl_get_window_display_scale"; }
    if (capability == appCapSafeArea()) { return "Window.safeArea / sdl_get_window_safe_area"; }
    if (capability == appCapLifecycle()) { return "event_will_enter_background / event_did_enter_foreground"; }
    if (capability == appCapCacao()) { return "Zyn.Nut.Renderer"; }
    return "";
}

// ---------------------------------------------------------------------------
// One cell of the matrix
// ---------------------------------------------------------------------------

public class AppCapabilityEntry {
    public platform: i32;
    public capability: i32;
    public status: i32;
    public evidence: string;

    public static fn create(platform: i32, capability: i32, status: i32, evidence: string) -> AppCapabilityEntry {
        return AppCapabilityEntry {
            platform: platform, capability: capability, status: status, evidence: evidence
        };
    }

    public fn dup(&self) -> AppCapabilityEntry {
        return AppCapabilityEntry.create(self.platform, self.capability, self.status, self.evidence);
    }

    public fn isVerified(&self) -> bool { return self.status == appCapabilityVerified(); }
    public fn isRequired(&self) -> bool { return appCapabilityRequired(self.capability); }
    public fn isBlocking(&self) -> bool { return self.isRequired() && !self.isVerified(); }

    public fn summary(&self) -> string {
        var out = appPlatformName(self.platform) + "." + appCapabilityName(self.capability)
            + " = " + appCapabilityStatusName(self.status);
        if (self.evidence.len > 0) { out = out + " (" + self.evidence + ")"; }
        return out;
    }

    // `E|platform|capability|status|evidence`
    public fn serialize(&self) -> string {
        return "E|" + format("%d", self.platform as i64)
            + "|" + format("%d", self.capability as i64)
            + "|" + format("%d", self.status as i64)
            + "|" + hex_encode(self.evidence);
    }

    public static fn parse(text: string) -> AppCapabilityEntry {
        if (AppDiagText.fieldAt(text, 124, 0) != "E" || AppDiagText.fieldCount(text, 124) != 5) {
            return AppCapabilityEntry.create(0, 0, appCapabilityUnknown(), "");
        }
        return AppCapabilityEntry.create(
            app_parse_i32_or(AppDiagText.fieldAt(text, 124, 1), 0),
            app_parse_i32_or(AppDiagText.fieldAt(text, 124, 2), 0),
            app_parse_i32_or(AppDiagText.fieldAt(text, 124, 3), appCapabilityUnknown()),
            hex_decode(AppDiagText.fieldAt(text, 124, 4)));
    }
}

// ---------------------------------------------------------------------------
// The matrix
// ---------------------------------------------------------------------------

public class AppPlatformMatrix {
    public static fn cellKey(platform: i32, capability: i32) -> string {
        return "cap:" + appPlatformName(platform) + ":" + appCapabilityName(capability);
    }

    // The conservative default table. `evidence` describes the code path that
    // backs the claim; a capability with no backing symbol starts
    // `unsupported`, and a platform nobody has run on starts `experimental` or
    // `unknown`. Nothing here is upgraded by optimism - only by `markVerified`.
    public static fn defaultStatus(platform: i32, capability: i32) -> i32 {
        // No platform has a file picker: there is no backing symbol, so every
        // platform says `unsupported` rather than pretending.
        if (capability == appCapFilePicker()) { return appCapabilityUnsupported(); }

        if (platform == appPlatformWindows()) {
            // The host platform: the whole suite runs here, so the window, the
            // scale query, the safe area and the lifecycle events are exercised
            // by every test run.
            if (capability == appCapWindowHandle()) { return appCapabilityVerified(); }
            if (capability == appCapIme()) { return appCapabilityVerified(); }
            if (capability == appCapClipboard()) { return appCapabilityVerified(); }
            if (capability == appCapDpiScale()) { return appCapabilityVerified(); }
            if (capability == appCapSafeArea()) { return appCapabilityVerified(); }
            if (capability == appCapLifecycle()) { return appCapabilityVerified(); }
            if (capability == appCapCacao()) { return appCapabilityVerified(); }
            // The accessibility bridge exists, but the Windows UI Automation
            // provider behind it is not wired, so this is not verified.
            if (capability == appCapAccessibility()) { return appCapabilityExperimental(); }
            // Desktop touch hardware is not part of the verified configuration.
            if (capability == appCapTouch()) { return appCapabilityUnsupported(); }
            return appCapabilityUnknown();
        }

        if (platform == appPlatformAndroid()) {
            // SDL3 supplies the window, the scale and the safe area on Android;
            // the touch APIs exist and are the platform's primary input. The
            // lifecycle and the Cacao backend still need a device session
            // recorded before they may be called verified.
            if (capability == appCapWindowHandle()) { return appCapabilityVerified(); }
            if (capability == appCapDpiScale()) { return appCapabilityVerified(); }
            if (capability == appCapSafeArea()) { return appCapabilityVerified(); }
            if (capability == appCapTouch()) { return appCapabilityVerified(); }
            if (capability == appCapIme()) { return appCapabilityExperimental(); }
            if (capability == appCapClipboard()) { return appCapabilityExperimental(); }
            if (capability == appCapAccessibility()) { return appCapabilityExperimental(); }
            if (capability == appCapLifecycle()) { return appCapabilityExperimental(); }
            if (capability == appCapCacao()) { return appCapabilityExperimental(); }
            return appCapabilityUnknown();
        }

        if (platform == appPlatformLinux() || platform == appPlatformMacOS()) {
            // The roadmap defers these: a window handle exists, but each needs
            // its own acceptance pass before anything is verified.
            if (capability == appCapWindowHandle()) { return appCapabilityExperimental(); }
            if (capability == appCapDpiScale()) { return appCapabilityExperimental(); }
            if (capability == appCapSafeArea()) { return appCapabilityExperimental(); }
            if (capability == appCapLifecycle()) { return appCapabilityExperimental(); }
            if (capability == appCapCacao()) { return appCapabilityExperimental(); }
            if (capability == appCapIme()) { return appCapabilityExperimental(); }
            if (capability == appCapClipboard()) { return appCapabilityExperimental(); }
            if (capability == appCapTouch()) { return appCapabilityUnsupported(); }
            if (platform == appPlatformMacOS()) {
                if (capability == appCapAccessibility()) { return appCapabilityExperimental(); }
            }
            return appCapabilityUnknown();
        }

        // iOS has not been device-verified at all, so nothing may be claimed.
        return appCapabilityUnknown();
    }

    public static fn defaultEvidence(platform: i32, capability: i32) -> string {
        if (platform == appPlatformWindows()) {
            return "host platform; exercised by the in-tree suite";
        }
        if (platform == appPlatformAndroid()) {
            if (capability == appCapTouch()) { return "SDL3 touch device enumeration"; }
            return "device evidence not recorded in-tree";
        }
        if (platform == appPlatformLinux() || platform == appPlatformMacOS()) {
            return "window handle present; acceptance pass pending";
        }
        return "not device-verified";
    }

    public static fn entry(platform: i32, capability: i32) -> AppCapabilityEntry {
        return AppCapabilityEntry.create(
            platform, capability,
            AppPlatformMatrix.defaultStatus(platform, capability),
            AppPlatformMatrix.defaultEvidence(platform, capability));
    }

    // Overrides live in resources, so a test can promote or demote one cell
    // without touching the table, and a developer build can record evidence at
    // runtime. The resource holds the serialised entry.
    public static fn statusOf(world: AppWorld, platform: i32, capability: i32) -> i32 {
        let stored = world.stringResource(AppPlatformMatrix.cellKey(platform, capability), "");
        if (stored.len == 0) {
            return AppPlatformMatrix.defaultStatus(platform, capability);
        }
        return AppCapabilityEntry.parse(stored).status;
    }

    public static fn entryOf(world: AppWorld, platform: i32, capability: i32) -> AppCapabilityEntry {
        let stored = world.stringResource(AppPlatformMatrix.cellKey(platform, capability), "");
        if (stored.len == 0) { return AppPlatformMatrix.entry(platform, capability); }
        return AppCapabilityEntry.parse(stored);
    }

    public static fn mark(world: AppWorld, platform: i32, capability: i32, status: i32, evidence: string) -> AppWorld {
        let entry = AppCapabilityEntry.create(platform, capability, status, evidence);
        return world.setStringResource(AppPlatformMatrix.cellKey(platform, capability), entry.serialize());
    }

    // Recording evidence is the only way a cell becomes verified, and it
    // refuses to do so without an evidence string: "verified" with no evidence
    // is exactly the claim the roadmap forbids.
    public static fn markVerified(world: AppWorld, platform: i32, capability: i32, evidence: string) -> Result<AppWorld, AppError> {
        if (evidence.len == 0) {
            return Err(AppError.create(appDiagCodeUnhandled(), "verified needs evidence: "
                + appPlatformName(platform) + "." + appCapabilityName(capability)));
        }
        return Ok(AppPlatformMatrix.mark(world, platform, capability, appCapabilityVerified(), evidence));
    }

    public static fn clearOverride(world: AppWorld, platform: i32, capability: i32) -> AppWorld {
        return world.setStringResource(AppPlatformMatrix.cellKey(platform, capability), "");
    }

    public static fn verifiedCount(world: AppWorld, platform: i32) -> i32 {
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < appCapabilityCount()) {
            let capability = appCapabilityAt(i);
            if (AppPlatformMatrix.statusOf(world, platform, capability) == appCapabilityVerified()) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    // The rows that block shipping: required and not verified.
    public static fn blockers(world: AppWorld, platform: i32) -> i32 {
        var out: i32 = 0;
        var i: i32 = 0;
        while (i < appCapabilityCount()) {
            let capability = appCapabilityAt(i);
            if (!appCapabilityRequired(capability)) {
                i = i + 1;
                continue;
            }
            if (AppPlatformMatrix.statusOf(world, platform, capability) != appCapabilityVerified()) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    public static fn isPublishable(world: AppWorld, platform: i32) -> bool {
        if (platform == 0) { return false; }
        return AppPlatformMatrix.blockers(world, platform) == 0;
    }

    // The gate returns the reason, not just a bool, because "not publishable"
    // with no explanation is what leads to someone disabling the gate.
    public static fn releaseGate(world: AppWorld, platform: i32) -> Result<bool, AppError> {
        if (platform == 0) {
            return Err(AppError.create(appDiagCodeUnhandled(), "unknown platform"));
        }
        let blocking = AppPlatformMatrix.blockers(world, platform);
        if (blocking == 0) { return Ok(true); }
        return Err(AppError.create(appDiagCodeUnhandled(),
            appPlatformName(platform) + " is not releasable: "
                + blocking.toString() + " required capability(ies) unverified - "
                + AppPlatformMatrix.blockerSummary(world, platform)));
    }

    public static fn blockerSummary(world: AppWorld, platform: i32) -> string {
        var out: string = "";
        var i: i32 = 0;
        while (i < appCapabilityCount()) {
            let capability = appCapabilityAt(i);
            if (appCapabilityRequired(capability)
                && AppPlatformMatrix.statusOf(world, platform, capability) != appCapabilityVerified()) {
                if (out.len > 0) { out = out + ", "; }
                out = out + appCapabilityName(capability)
                    + "(" + appCapabilityStatusName(AppPlatformMatrix.statusOf(world, platform, capability)) + ")";
            }
            i = i + 1;
        }
        return out;
    }

    public static fn platformReport(world: AppWorld, platform: i32) -> string {
        var out = appPlatformName(platform) + ": "
            + AppPlatformMatrix.verifiedCount(world, platform).toString()
            + "/" + appCapabilityCount().toString() + " verified"
            + ", publishable=" + appDiagBoolText(AppPlatformMatrix.isPublishable(world, platform)) + "\n";
        var i: i32 = 0;
        while (i < appCapabilityCount()) {
            let capability = appCapabilityAt(i);
            let entry = AppPlatformMatrix.entryOf(world, platform, capability);
            var mark = "  ";
            if (entry.isBlocking()) { mark = "! "; }
            out = out + mark + entry.summary() + "\n";
            i = i + 1;
        }
        return out;
    }

    public static fn report(world: AppWorld) -> string {
        var out: string = "";
        var i: i32 = 0;
        while (i < appPlatformCount()) {
            out = out + AppPlatformMatrix.platformReport(world, appPlatformAt(i)) + "\n";
            i = i + 1;
        }
        return out;
    }

    // The rows an application should read before offering a feature, so the UI
    // degrades instead of pretending. `Result` rather than a bool: a feature
    // that is unavailable needs to say *why* to be worth showing.
    public static fn featureGate(world: AppWorld, platform: i32, capability: i32) -> Result<bool, AppError> {
        let status = AppPlatformMatrix.statusOf(world, platform, capability);
        if (status == appCapabilityVerified()) { return Ok(true); }
        if (status == appCapabilityUnsupported()) {
            return Err(AppError.create(appDiagCodeUnhandled(),
                appCapabilityName(capability) + " is not supported on " + appPlatformName(platform)));
        }
        if (status == appCapabilityExperimental()) {
            return Err(AppError.create(appDiagCodeUnhandled(),
                appCapabilityName(capability) + " is experimental on " + appPlatformName(platform)));
        }
        return Err(AppError.create(appDiagCodeUnhandled(),
            appCapabilityName(capability) + " has not been verified on " + appPlatformName(platform)));
    }
}
