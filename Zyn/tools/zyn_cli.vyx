use std.fs;
use std.serde.toml;

extern "C" {
    fn system(cmd: rawptr) -> i32;
    fn getenv(name: rawptr) -> rawptr;
    @[link_name("fopen")]
    fn zyn_file_open(path: rawptr, mode: rawptr) -> rawptr;
    @[link_name("fwrite")]
    fn zyn_file_write(data: rawptr, size: i64, count: i64, stream: rawptr) -> i64;
    @[link_name("fclose")]
    fn zyn_file_close(stream: rawptr) -> i32;
}

@[platform("windows")]
extern "C" {
    fn _mkdir(path: rawptr) -> i32;
}

@[platform("linux")]
extern "C" {
    fn mkdir(path: rawptr, mode: i32) -> i32;
}

@[platform("macos")]
extern "C" {
    fn mkdir(path: rawptr, mode: i32) -> i32;
}

@[platform("android")]
extern "C" {
    fn mkdir(path: rawptr, mode: i32) -> i32;
}

@[platform("windows")]
fn zyn_create_directory(path: string) -> i32 { return _mkdir(path.c_str()); }

@[platform("linux")]
fn zyn_create_directory(path: string) -> i32 { return mkdir(path.c_str(), 493); }

@[platform("macos")]
fn zyn_create_directory(path: string) -> i32 { return mkdir(path.c_str(), 493); }

@[platform("android")]
fn zyn_create_directory(path: string) -> i32 { return mkdir(path.c_str(), 493); }

@[platform("windows")]
fn zyn_is_windows() -> bool { return true; }

@[platform("linux")]
fn zyn_is_windows() -> bool { return false; }

@[platform("android")]
fn zyn_is_windows() -> bool { return false; }

@[platform("macos")]
fn zyn_is_windows() -> bool { return false; }

@[platform("windows")]
fn zyn_host_platform() -> string { return "windows"; }

@[platform("linux")]
fn zyn_host_platform() -> string { return "linux"; }

@[platform("android")]
fn zyn_host_platform() -> string { return "android"; }

@[platform("macos")]
fn zyn_host_platform() -> string { return "macos"; }

@[platform("windows")]
fn zyn_shared_ext() -> string { return ".dll"; }

@[platform("linux")]
fn zyn_shared_ext() -> string { return ".so"; }

@[platform("android")]
fn zyn_shared_ext() -> string { return ".so"; }

@[platform("macos")]
fn zyn_shared_ext() -> string { return ".dylib"; }

@[platform("windows")]
fn zyn_exe_ext() -> string { return ".exe"; }

@[platform("linux")]
fn zyn_exe_ext() -> string { return ""; }

@[platform("android")]
fn zyn_exe_ext() -> string { return ""; }

@[platform("macos")]
fn zyn_exe_ext() -> string { return ""; }

fn zyn_env(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn zyn_join(a: string, b: string) -> string {
    if (a.len == 0 || a == ".") { return b; }
    let last = a.charAt(a.len - 1);
    if (last == 47 || last == 92) { return a + b; }
    return a + "/" + b;
}

fn zyn_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return "."; }
    return path.substring(0, last);
}

fn zyn_sdk_root_is_valid(path: string) -> bool {
    if (path.len == 0) { return false; }
    return fileExists(zyn_join(path, "tools/zyn_cli.vyx"));
}

fn zyn_sdk_root_from_argv0() -> string {
    if (argCount() == 0) { return ""; }
    let exe_dir = zyn_dirname(getArg(0));
    if (zyn_sdk_root_is_valid(exe_dir.clone())) { return exe_dir; }
    let parent = zyn_dirname(exe_dir.clone());
    if (zyn_sdk_root_is_valid(parent.clone())) { return parent; }
    let grandparent = zyn_dirname(parent.clone());
    if (zyn_sdk_root_is_valid(grandparent.clone())) { return grandparent; }
    return "";
}

fn zyn_compiler_exe_name() -> string {
    if (zyn_is_windows()) { return "vyxc.exe"; }
    return "vyxc";
}

fn zyn_host_path(path: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (zyn_is_windows() && c == 47) {
            out = out + "\\";
        } else if (!zyn_is_windows() && c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn zyn_quote_arg(arg: string) -> string {
    var needs_quote = arg.len == 0;
    var scan: i32 = 0;
    while (scan < arg.len) {
        let c0 = arg.charAt(scan);
        if (c0 == 32 || c0 == 9 || c0 == 34) { needs_quote = true; }
        scan = scan + 1;
    }
    if (!needs_quote) { return arg; }
    var out = "\"";
    var i: i32 = 0;
    while (i < arg.len) {
        let c = arg.charAt(i);
        if (c == 34) {
            out = out + "\\\"";
        } else {
            out = out + arg.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn zyn_env_assignment(name: string, value: string) -> string {
    if (value.len == 0) { return ""; }
    if (zyn_is_windows()) {
        return "set \"" + name + "=" + zyn_host_path(value) + "\" && ";
    }
    return name + "=" + zyn_quote_arg(zyn_host_path(value)) + " ";
}

fn zyn_sdk_command(manifest: string, cmd: string) -> string {
    return zyn_env_assignment("ZYN_SDK_ROOT", zyn_sdk_root_for_manifest(manifest)) + cmd;
}

fn zyn_tool_arg(path: string) -> string {
    return zyn_quote_arg(zyn_host_path(path));
}

fn zyn_args_from(start: i32) -> string {
    var out = "";
    let argc = argCount();
    var i = start;
    while (i < argc) {
        out = out + " " + zyn_quote_arg(getArg(i));
        i = i + 1;
    }
    return out;
}

fn zyn_args_until_separator(start: i32) -> string {
    var out = "";
    let argc = argCount();
    var i = start;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { return out; }
        out = out + " " + zyn_quote_arg(a);
        i = i + 1;
    }
    return out;
}

fn zyn_args_after_separator(start: i32) -> string {
    let argc = argCount();
    var i = start;
    while (i < argc) {
        if (getArg(i) == "--") { return zyn_args_from(i + 1); }
        i = i + 1;
    }
    return "";
}

fn zyn_arg_value_from(start: i32, name: string, fallback: string) -> string {
    let argc = argCount();
    var i: i32 = start;
    let eq_prefix = name + "=";
    while (i < argc) {
        let a = getArg(i);
        if (a == name && i + 1 < argc) { return getArg(i + 1); }
        if (a.startsWith(eq_prefix)) { return a.substring(eq_prefix.len, a.len); }
        i = i + 1;
    }
    return fallback;
}

fn zyn_flag_from(start: i32, name: string) -> bool {
    let argc = argCount();
    var i: i32 = start;
    while (i < argc) {
        if (getArg(i) == name) { return true; }
        i = i + 1;
    }
    return false;
}

fn zyn_first_plain_arg(start: i32) -> string {
    return zyn_plain_arg_at(start, 0);
}

fn zyn_plain_arg_at(start: i32, index: i32) -> string {
    let argc = argCount();
    var i: i32 = start;
    var found: i32 = 0;
    while (i < argc) {
        let a = getArg(i);
        if (a.startsWith("--")) {
            if ((a == "--name" || a == "--id" || a == "--package") && i + 1 < argc) {
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else {
            if (found == index) { return a; }
            found = found + 1;
            i = i + 1;
        }
    }
    return "";
}

fn zyn_line_count(rows: string) -> i64 {
    var count: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn zyn_line_at(rows: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) {
                if (idx == want) { return rows.substring(start, i); }
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn zyn_trim_quotes(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len >= 2) {
        if (trimmed.startsWith("\"") && trimmed.endsWith("\"")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
        if (trimmed.startsWith("'") && trimmed.endsWith("'")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
    }
    return trimmed;
}

fn zyn_toml_get(content: string, want_section: string, want_key: string) -> string {
    var section = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key == want_key) { return toml_value(line); }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn zyn_toml_string(content: string, section: string, key: string, default_value: string) -> string {
    let value = zyn_toml_get(content, section, key).trim();
    if (value.len == 0) { return default_value; }
    return zyn_trim_quotes(value);
}

fn zyn_toml_array_lines(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len == 0) { return ""; }
    if (!trimmed.startsWith("[")) { return zyn_trim_quotes(trimmed) + "\n"; }
    var raw = trimmed;
    if (raw.endsWith("]")) {
        raw = raw.substring(1, raw.len - 1);
    }
    var out = "";
    var item = "";
    var in_quote = false;
    var i: i32 = 0;
    while (i < raw.len) {
        let c = raw.charAt(i);
        if (c == 34) {
            in_quote = !in_quote;
            item = item + raw.substring(i, i + 1);
        } else if (!in_quote && c == 44) {
            let v = zyn_trim_quotes(item);
            if (v.len > 0) { out = out + v + "\n"; }
            item = "";
        } else {
            item = item + raw.substring(i, i + 1);
        }
        i = i + 1;
    }
    let tail = zyn_trim_quotes(item);
    if (tail.len > 0) { out = out + tail + "\n"; }
    return out;
}

fn zyn_arg_target_lines() -> string {
    let argc = argCount();
    var out = "";
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--target" && i + 1 < argc) {
            out = out + getArg(i + 1) + "\n";
            i = i + 2;
        } else if (a.startsWith("--target=")) {
            out = out + a.substring(9, a.len) + "\n";
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn zyn_target_platform(target: string) -> string {
    if (target.startsWith("windows")) { return "windows"; }
    if (target.startsWith("android")) { return "android"; }
    if (target.startsWith("linux")) { return "linux"; }
    if (target.startsWith("macos")) { return "macos"; }
    if (target.startsWith("ios")) { return "ios"; }
    return zyn_host_platform();
}

fn zyn_host_default_targets() -> string {
    let host = zyn_host_platform();
    if (host == "windows") { return "windows-x64\nandroid-arm64\n"; }
    if (host == "linux") { return "linux-x64\nandroid-arm64\n"; }
    if (host == "macos") { return "macos-universal\nios-arm64\n"; }
    return "";
}

fn zyn_publish_target_lines(manifest: string) -> string {
    var targets = zyn_arg_target_lines();
    if (targets.len == 0) {
        targets = zyn_toml_array_lines(zyn_toml_get(manifest, "zyn.publish", "targets"));
    }
    if (targets.len == 0) {
        targets = zyn_host_default_targets();
    }
    return targets;
}

fn zyn_has_zyn_dependency(content: string) -> bool {
    return zyn_toml_get(content, "dependencies", "Zyn").trim().len > 0;
}

fn zyn_dependency_path(content: string) -> string {
    return zyn_toml_string(content, "dependencies", "Zyn", "");
}

fn zyn_has_app_manifest(content: string) -> bool {
    if (zyn_toml_get(content, "zyn.app", "name").trim().len > 0) { return true; }
    if (zyn_toml_get(content, "zyn.app", "id").trim().len > 0) { return true; }
    if (zyn_toml_get(content, "zyn.app", "entry").trim().len > 0) { return true; }
    return false;
}

fn zyn_sdk_root_for_manifest(manifest: string) -> string {
    let env_root = zyn_env("ZYN_SDK_ROOT");
    if (env_root.len > 0) { return env_root; }
    let argv_root = zyn_sdk_root_from_argv0();
    if (argv_root.len > 0) { return argv_root; }
    let dep_root = zyn_dependency_path(manifest);
    if (dep_root.len > 0) { return dep_root; }
    return ".";
}

fn zyn_compiler_for_manifest(manifest: string) -> string {
    let compiler = zyn_env("VYX_COMPILER");
    if (compiler.len > 0) { return compiler; }
    let compiler2 = zyn_env("ZYN_VYXC");
    if (compiler2.len > 0) { return compiler2; }

    let sdk_root = zyn_sdk_root_for_manifest(manifest.clone());
    let exe = zyn_compiler_exe_name();
    let bin_compiler = zyn_join(zyn_join(sdk_root.clone(), "bin"), exe.clone());
    if (fileExists(bin_compiler.clone())) { return bin_compiler; }
    let toolchain_compiler = zyn_join(zyn_join(sdk_root.clone(), "toolchain"), exe.clone());
    if (fileExists(toolchain_compiler.clone())) { return toolchain_compiler; }
    let out_compiler = zyn_join(zyn_join(sdk_root.clone(), "out"), exe.clone());
    if (fileExists(out_compiler.clone())) { return out_compiler; }
    let repo_compiler = zyn_join(zyn_join(zyn_dirname(sdk_root), "bootstrap_compiler/out"), exe.clone());
    if (fileExists(repo_compiler.clone())) { return repo_compiler; }
    return exe;
}

fn zyn_manifest() -> string {
    let path = "Vyx.toml";
    if (!fileExists(path)) { return ""; }
    return readFile(path);
}

fn zyn_package_name(manifest: string) -> string {
    return zyn_toml_string(manifest, "package", "name", "app");
}

fn zyn_output_dir(manifest: string, package_name: string) -> string {
    let target_section = "target." + package_name;
    let target_dir = zyn_toml_string(manifest.clone(), target_section, "output_dir", "");
    if (target_dir.len > 0) { return target_dir; }
    return zyn_toml_string(manifest, "build", "output_dir", "target");
}

fn zyn_output_path(manifest: string) -> string {
    let package_name = zyn_package_name(manifest.clone());
    let out_dir = zyn_output_dir(manifest, package_name.clone());
    return zyn_join(out_dir, package_name + zyn_exe_ext());
}

fn zyn_basename(path: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { start = i + 1; }
        i = i + 1;
    }
    if (start >= path.len) { return ""; }
    return path.substring(start, path.len);
}

fn zyn_identifier_part(text: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            out = out + text.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { return "zyn_app"; }
    let first = out.charAt(0);
    if (first >= 48 && first <= 57) { return "app_" + out; }
    return out;
}

fn zyn_dirname_for_create(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return ""; }
    return path.substring(0, last);
}

fn zyn_toml_escape(value: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < value.len) {
        let c = value.charAt(i);
        if (c == 92) {
            out = out + "\\\\";
        } else if (c == 34) {
            out = out + "\\\"";
        } else if (c == 10) {
            out = out + "\\n";
        } else if (c == 13) {
            out = out + "\\r";
        } else {
            out = out + value.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn zyn_ensure_parent_dirs(path: string) -> i32 {
    let parent = zyn_dirname_for_create(path);
    if (parent.len == 0 || parent == ".") { return 0; }
    if (isDir(parent)) { return 0; }
    if (zyn_ensure_parent_dirs(parent.clone()) != 0) { return 1; }
    return zyn_ensure_dir(parent);
}

fn zyn_init_manifest(package_name: string, app_name: string, app_id: string) -> string {
    return "[package]\n"
        + "name = \"" + zyn_toml_escape(package_name) + "\"\n"
        + "version = \"0.1.0\"\n"
        + "entry = \"src/main.vyx\"\n"
        + "\n"
        + "[build]\n"
        + "cache_dir = \".cache\"\n"
        + "output_dir = \"target\"\n"
        + "threads = 0\n"
        + "sources_android = [\"$" + "{ZYN_SDK_ROOT}/src/android/zyn_sdl_main.c\"]\n"
        + "include_paths_android = [\"$" + "{ZYN_SDK_ROOT}/vendor/SDL3/include\"]\n"
        + "lib_paths_android = [\"$" + "{ZYN_SDK_ROOT}/vendor/SDL3/lib/android/$" + "{ZYN_ANDROID_ABI}\"]\n"
        + "libs_android = [\"SDL3\", \"log\", \"android\"]\n"
        + "\n"
        + "[zyn.app]\n"
        + "name = \"" + zyn_toml_escape(app_name) + "\"\n"
        + "id = \"" + zyn_toml_escape(app_id) + "\"\n"
        + "version = \"0.1.0\"\n"
        + "entry = \"src/main.vyx\"\n"
        + "\n[zyn.publish.android]\n"
        + "project = \"android\"\n"
        + "compile_sdk = 35\n"
        + "min_sdk = 29\n"
        + "target_sdk = 35\n";
}

fn zyn_init_main(app_name: string) -> string {
    return "use AppSurface = Zyn.App.AppSurface;\n"
        + "use Column = Zyn.App.Column;\n"
        + "use Text = Zyn.App.Text;\n"
        + "use App = Zyn.App.App;\n"
        + "\n"
        + "fn main() -> i32 {\n"
        + "    return App.manifestFromArgs()\n"
        + "        .runView(\"home\", AppSurface.stage(\"home.root\",\n"
        + "            AppSurface.card(\"home.panel\", 320.0, 220.0)\n"
        + "                .child(Column.create()\n"
        + "                    .gap(14.0)\n"
        + "                    .alignCenter()\n"
        + "                    .child(Text.title(\"" + zyn_toml_escape(app_name) + "\")\n"
        + "                        .id(\"home.title\")\n"
        + "                        .height(44.0)\n"
        + "                        .textCenter())\n"
        + "                    .child(Text.body(\"Built with Zyn.\")\n"
        + "                        .id(\"home.body\")\n"
        + "                        .height(32.0)\n"
        + "                        .textCenter()))));\n"
        + "}\n";
}

fn zyn_init_project(root: string, package_name: string, app_name: string, app_id: string, force: bool) -> i32 {
    if (force) {
        print("zyn: --force is not supported for project creation; choose a directory without conflicting project files");
        return 62;
    }
    // Check every destination before creating directories or writing a file.
    // Existing unrelated files are retained; existing project files are never replaced.
    let src_dir = zyn_join(root.clone(), "src");
    let manifest_path = zyn_join(root.clone(), "Vyx.toml");
    let main_path = zyn_join(src_dir.clone(), "main.vyx");
    if (fileExists(manifest_path.clone()) || isDir(manifest_path.clone())
        || fileExists(main_path.clone()) || isDir(main_path.clone())) {
        print("zyn: project files already exist in " + root + "; nothing was written");
        return 63;
    }
    if (root.len > 0 && root != "." && zyn_ensure_parent_dirs(root.clone()) != 0) {
        print("zyn: failed to create project directory: " + root);
        return 60;
    }
    if (zyn_ensure_dir(root.clone()) != 0) { return 60; }
    if (zyn_ensure_dir(src_dir.clone()) != 0) {
        print("zyn: failed to create source directory: " + src_dir);
        return 61;
    }
    if (zyn_write_new_file(manifest_path.clone(), zyn_init_manifest(package_name, app_name, app_id)) != 0) {
        print("zyn: failed to write " + manifest_path);
        return 64;
    }
    if (zyn_write_new_file(main_path.clone(), zyn_init_main(app_name)) != 0) {
        print("zyn: failed to write " + main_path);
        return 65;
    }
    print("zyn: created " + manifest_path);
    print("zyn: created " + main_path);
    return 0;
}

fn zyn_write_new_file(path: string, content: string) -> i32 {
    // C11 exclusive creation also closes the preflight/create race.
    let stream = zyn_file_open(path.c_str(), "wbx".c_str());
    if (stream == null) { return 1; }
    let written = zyn_file_write(content.c_str(), 1, content.len as i64, stream);
    let closed = zyn_file_close(stream);
    if (written != content.len as i64 || closed != 0) { return 1; }
    return 0;
}

fn zyn_init_current() -> i32 {
    var package_name = zyn_arg_value_from(2, "--package", "");
    if (package_name.len == 0) { package_name = zyn_first_plain_arg(2); }
    if (package_name.len == 0) { package_name = "zyn_app"; }
    package_name = zyn_identifier_part(package_name);
    let app_name = zyn_arg_value_from(2, "--name", package_name);
    let app_id = zyn_arg_value_from(2, "--id", "dev.vyx.zyn." + package_name.toLower());
    return zyn_init_project(".", package_name, app_name, app_id, zyn_flag_from(2, "--force"));
}

fn zyn_new_project() -> i32 {
    let project_name = zyn_plain_arg_at(2, 0);
    if (project_name.len == 0 || zyn_plain_arg_at(2, 2).len > 0) {
        print("zyn: usage: zyn new <name> [directory] [--name <display name>] [--id <application id>]");
        return 66;
    }
    var project_dir = zyn_plain_arg_at(2, 1);
    if (project_dir.len == 0) { project_dir = project_name; }
    var package_name = zyn_arg_value_from(2, "--package", zyn_basename(project_name));
    package_name = zyn_identifier_part(package_name);
    let app_name = zyn_arg_value_from(2, "--name", package_name);
    let app_id = zyn_arg_value_from(2, "--id", "dev.vyx.zyn." + package_name.toLower());
    return zyn_init_project(project_dir, package_name, app_name, app_id, zyn_flag_from(2, "--force"));
}

fn zyn_ensure_dir(path: string) -> i32 {
    if (path.len == 0 || path == ".") { return 0; }
    if (isDir(path)) { return 0; }
    if (zyn_create_directory(path.clone()) != 0 && !isDir(path)) { return 1; }
    return 0;
}

fn zyn_stage_runtime_assets(manifest: string) -> i32 {
    if (!zyn_has_zyn_dependency(manifest.clone()) && !zyn_has_app_manifest(manifest.clone())) {
        return 0;
    }

    let package_name = zyn_package_name(manifest.clone());
    let out_dir = zyn_output_dir(manifest.clone(), package_name);
    let sdk_root = zyn_sdk_root_for_manifest(manifest.clone());
    let sdk_out = zyn_join(sdk_root, "out");
    if (!isDir(sdk_out)) {
        print("zyn: missing SDK runtime output: " + sdk_out);
        return 20;
    }
    if (zyn_ensure_dir(out_dir.clone()) != 0) {
        print("zyn: failed to create output directory: " + out_dir);
        return 21;
    }
    if (copyFilesWithExtension(sdk_out.clone(), out_dir.clone(), zyn_shared_ext()) < 0) {
        print("zyn: failed to stage runtime libraries from " + sdk_out);
        return 22;
    }

    let shader_src = zyn_join(sdk_out.clone(), "nut/solid.slang");
    if (fileExists(shader_src)) {
        let nut_dir = zyn_join(out_dir.clone(), "nut");
        if (zyn_ensure_dir(nut_dir.clone()) != 0) {
            print("zyn: failed to create shader directory: " + nut_dir);
            return 23;
        }
        if (copyFile(shader_src, zyn_join(nut_dir, "solid.slang")) != 0) {
            print("zyn: failed to stage Nut shader");
            return 24;
        }
    }

    return 0;
}

fn zyn_run_system(cmd: string) -> i32 {
    return system(cmd.c_str());
}

fn zyn_build(manifest: string, build_args: string) -> i32 {
    let compiler = zyn_compiler_for_manifest(manifest);
    let cmd = zyn_sdk_command(manifest.clone(), zyn_tool_arg(compiler) + " build" + build_args);
    print("zyn: build");
    return zyn_run_system(cmd);
}

fn zyn_cli_android_triplet() -> string {
    let triple = zyn_arg_value_from(2, "--triplet", "");
    if (triple.contains("android")) { return triple; }
    let target = zyn_arg_value_from(2, "--target", "");
    if (target == "android-arm64") { return "aarch64-linux-android29"; }
    if (target == "android-x64") { return "x86_64-linux-android29"; }
    return "";
}

fn zyn_cli_build(manifest: string) -> i32 {
    let triple = zyn_cli_android_triplet();
    if (triple.len == 0) { return zyn_build(manifest, zyn_args_from(2)); }
    var abi = "";
    if (triple.startsWith("aarch64-")) { abi = "arm64-v8a"; }
    if (triple.startsWith("x86_64-")) { abi = "x86_64"; }
    if (abi.len == 0) { print("zyn: Android SDK supports arm64-v8a and x86_64"); return 26; }
    var args = "";
    var index: i32 = 2;
    while (index < argCount()) {
        let value = getArg(index);
        if (value == "--target" && index + 1 < argCount()
            && (getArg(index + 1) == "android-arm64" || getArg(index + 1) == "android-x64")) {
            args = args + " --triplet " + zyn_quote_arg(triple);
            index = index + 2;
        } else if (value == "--target=android-arm64" || value == "--target=android-x64") {
            args = args + " --triplet " + zyn_quote_arg(triple);
            index = index + 1;
        } else {
            args = args + " " + zyn_quote_arg(value);
            index = index + 1;
        }
    }
    let compiler = zyn_compiler_for_manifest(manifest.clone());
    return zyn_run_system(zyn_sdk_command(manifest,
        zyn_env_assignment("ZYN_ANDROID_ABI", abi) + zyn_tool_arg(compiler) + " build" + args));
}

fn zyn_build_android(manifest: string, target: string) -> i32 {
    var abi = "";
    var triple = "";
    if (target == "android-arm64") { abi = "arm64-v8a"; triple = "aarch64-linux-android29"; }
    if (target == "android-x64") { abi = "x86_64"; triple = "x86_64-linux-android29"; }
    if (abi.len == 0) {
        print("zyn: supported Android targets are android-arm64 and android-x64");
        return 26;
    }
    var jobs_arg = "";
    let jobs = zyn_arg_value_from(2, "--jobs", "");
    if (jobs.len > 0) { jobs_arg = " -j" + zyn_quote_arg(jobs); }
    let compiler = zyn_compiler_for_manifest(manifest.clone());
    let cmd = zyn_sdk_command(manifest,
        zyn_env_assignment("ZYN_ANDROID_ABI", abi)
        + zyn_tool_arg(compiler) + " build --triplet " + zyn_quote_arg(triple) + jobs_arg);
    return zyn_run_system(cmd);
}

fn zyn_build_publish_targets(manifest: string) -> i32 {
    let targets = zyn_publish_target_lines(manifest.clone());
    if (targets.len == 0) { return zyn_build(manifest, ""); }

    let host = zyn_host_platform();
    var built_host = false;
    var i: i64 = 0;
    let count = zyn_line_count(targets.clone());
    while (i < count) {
        let target = zyn_line_at(targets.clone(), i).trim();
        if (target.len > 0) {
            let platform = zyn_target_platform(target.clone());
            if (platform == host) {
                if (!built_host) {
                    let rc_host = zyn_build(manifest.clone(), "");
                    if (rc_host != 0) { return rc_host; }
                    built_host = true;
                }
            } else if (platform == "android") {
                let rc_android = zyn_build_android(manifest.clone(), target);
                if (rc_android != 0) { return rc_android; }
            } else {
                let rc_target = zyn_build(manifest.clone(), " --target " + zyn_quote_arg(target));
                if (rc_target != 0) { return rc_target; }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn zyn_run_publish(manifest: string, args: string) -> i32 {
    let compiler = zyn_compiler_for_manifest(manifest.clone());
    let script = zyn_join(zyn_sdk_root_for_manifest(manifest), "tools/zyn_publish.vyx");
    let cmd = zyn_sdk_command(manifest.clone(), zyn_tool_arg(compiler) + " --src=file " + zyn_tool_arg(script) + " --run=aot --" + args);
    return zyn_run_system(cmd);
}

fn zyn_run_app(manifest: string, app_args: string) -> i32 {
    let exe_path = zyn_output_path(manifest);
    if (!fileExists(exe_path)) {
        print("zyn: built executable not found: " + exe_path);
        return 30;
    }
    let exe_dir = zyn_dirname(exe_path.clone());
    var cmd = zyn_tool_arg(exe_path) + app_args;
    if (!zyn_is_windows()) {
        cmd = "LD_LIBRARY_PATH=" + zyn_quote_arg(exe_dir + ":$LD_LIBRARY_PATH") + " " + cmd;
    }
    print("zyn: run " + exe_path);
    return zyn_run_system(cmd);
}

fn zyn_print_usage() {
    print("zyn");
    print("  build [compiler args]        Build current Zyn app and stage SDK runtime assets");
    print("  run [compiler args] -- [args] Build, stage, then run the app");
    print("  stage                        Stage SDK runtime assets into the current app target");
    print("  publish [args]               Build, stage, then run zyn publish");
    print("  plan [args]                  Write publish plans");
    print("  doctor [args]                Check publish toolchains");
    print("  init [package] [options]     Create a Zyn app in the current directory");
    print("  new <name> [dir] [options]   Create a Zyn app; use '.' for the current directory");
    print("  init-android [args]          Create or refresh the Android project");
}

fn main() -> i32 {
    let argc = argCount();
    if (argc < 2 || getArg(1) == "help" || getArg(1) == "--help" || getArg(1) == "-h") {
        zyn_print_usage();
        return 0;
    }

    let mode = getArg(1);
    if (mode == "init") {
        return zyn_init_current();
    }
    if (mode == "new") {
        return zyn_new_project();
    }

    let manifest = zyn_manifest();
    if (manifest.len == 0) {
        print("zyn: Vyx.toml not found in current directory");
        return 2;
    }

    if (mode == "build") {
        let build_rc = zyn_cli_build(manifest.clone());
        if (build_rc != 0) { return build_rc; }
        if (zyn_cli_android_triplet().len > 0) { return 0; }
        return zyn_stage_runtime_assets(manifest);
    }
    if (mode == "stage") {
        return zyn_stage_runtime_assets(manifest);
    }
    if (mode == "run") {
        if (zyn_cli_android_triplet().len > 0) {
            print("zyn: use publish --target android-arm64 (or android-x64) --debug, then install the APK with adb");
            return 26;
        }
        let build_rc2 = zyn_build(manifest.clone(), zyn_args_until_separator(2));
        if (build_rc2 != 0) { return build_rc2; }
        let stage_rc = zyn_stage_runtime_assets(manifest.clone());
        if (stage_rc != 0) { return stage_rc; }
        return zyn_run_app(manifest, zyn_args_after_separator(2));
    }
    if (mode == "publish") {
        let build_rc3 = zyn_build_publish_targets(manifest.clone());
        if (build_rc3 != 0) { return build_rc3; }
        // Android libraries/assets are staged per ABI by the publisher. Do not
        // copy host DLLs into a project that only requested Android targets.
        if (zyn_publish_target_lines(manifest.clone()).contains(zyn_host_platform())) {
            let stage_rc2 = zyn_stage_runtime_assets(manifest.clone());
            if (stage_rc2 != 0) { return stage_rc2; }
        }
        return zyn_run_publish(manifest, zyn_args_from(2));
    }
    if (mode == "plan") {
        return zyn_run_publish(manifest, " --plan" + zyn_args_from(2));
    }
    if (mode == "doctor") {
        return zyn_run_publish(manifest, " --doctor" + zyn_args_from(2));
    }
    if (mode == "init-android") {
        return zyn_run_publish(manifest, " --init-android" + zyn_args_from(2));
    }

    print("zyn: unknown command: " + mode);
    zyn_print_usage();
    return 3;
}
