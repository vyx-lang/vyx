use std.fs;
use std.serde.toml;

extern "C" {
    fn system(cmd: rawptr) -> i32;
    fn getenv(name: rawptr) -> rawptr;
}

@[platform("windows")]
fn publish_host() -> string { return "windows"; }

@[platform("linux")]
fn publish_host() -> string { return "linux"; }

@[platform("macos")]
fn publish_host() -> string { return "macos"; }

fn publish_line_count(rows: string) -> i64 {
    var count: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn publish_line_at(rows: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) {
                if (idx == want) { return rows.substring(start, i); }
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn publish_arg_has(name: string) -> bool {
    let count = argCount();
    var i: i32 = 1;
    while (i < count) {
        let a = getArg(i);
        if (a == name || a.startsWith(name + "=")) { return true; }
        i = i + 1;
    }
    return false;
}

fn publish_arg_value(name: string, fallback: string) -> string {
    let count = argCount();
    var i: i32 = 1;
    while (i < count) {
        let a = getArg(i);
        if (a == name && i + 1 < count) { return getArg(i + 1); }
        if (a.startsWith(name + "=")) { return a.substring(name.len + 1, a.len); }
        i = i + 1;
    }
    return fallback;
}

fn publish_arg_target_lines() -> string {
    let count = argCount();
    var out = "";
    var i: i32 = 1;
    while (i < count) {
        let a = getArg(i);
        if (a == "--target" && i + 1 < count) {
            out = out + getArg(i + 1) + "\n";
            i = i + 2;
        } else if (a.startsWith("--target=")) {
            out = out + a.substring(9, a.len) + "\n";
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn publish_mode() -> string {
    if (publish_arg_has("--help")) { return "help"; }
    if (publish_arg_has("--init-android")) { return "init-android"; }
    if (publish_arg_has("--doctor")) { return "doctor"; }
    if (publish_arg_has("--plan")) { return "plan"; }
    return "publish";
}

fn publish_print_usage() {
    print("zyn publish");
    print("  --init-android     Create the SDLActivity Gradle project described by [zyn.publish.android].project");
    print("  --language <name>  Android Activity language: java (default) or kotlin");
    print("  --debug            Package a debug APK; release requires a configured signing key");
    print("  --plan             Write publish-plan.txt for selected targets without building packages");
    print("  --doctor           Check selected target toolchains and return non-zero on missing requirements");
    print("  --target <name>    Select a target, repeatable; defaults to [zyn.publish].targets or host defaults");
    print("  --dist <dir>       Override [zyn.publish].dist");
    print("  [zyn.publish.android].native_name names the SDL_main library without requiring lib/.so spelling");
    print("  [zyn.publish.android].native_lib overrides the expected built Android .so path");
}

fn publish_trim_quotes(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len >= 2) {
        if (trimmed.startsWith("\"") && trimmed.endsWith("\"")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
        if (trimmed.startsWith("'") && trimmed.endsWith("'")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
    }
    return trimmed;
}

fn publish_toml_get(content: string, want_section: string, want_key: string) -> string {
    var section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key == want_key) {
                        return toml_value(line);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn publish_toml_string(content: string, section: string, key: string, fallback: string) -> string {
    let value = publish_toml_get(content, section, key).trim();
    if (value.len == 0) { return fallback; }
    return publish_trim_quotes(value);
}

fn publish_toml_array_lines(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len == 0) { return ""; }
    if (!trimmed.startsWith("[")) { return publish_trim_quotes(trimmed) + "\n"; }
    var raw = trimmed;
    if (raw.endsWith("]")) {
        raw = raw.substring(1, raw.len - 1);
    }
    var out = "";
    var item = "";
    var in_quote = false;
    var i: i32 = 0;
    while (i < raw.len) {
        let c = raw.charAt(i);
        if (c == 34) {
            in_quote = !in_quote;
            item = item + raw.substring(i, i + 1);
        } else if (!in_quote && c == 44) {
            let v = publish_trim_quotes(item);
            if (v.len > 0) { out = out + v + "\n"; }
            item = "";
        } else {
            item = item + raw.substring(i, i + 1);
        }
        i = i + 1;
    }
    let tail = publish_trim_quotes(item);
    if (tail.len > 0) { out = out + tail + "\n"; }
    return out;
}

fn publish_target_platform(target: string) -> string {
    if (target.startsWith("windows")) { return "windows"; }
    if (target.startsWith("android")) { return "android"; }
    if (target.startsWith("linux")) { return "linux"; }
    if (target.startsWith("macos")) { return "macos"; }
    if (target.startsWith("ios")) { return "ios"; }
    return "unknown";
}

fn publish_target_package(target: string) -> string {
    if (target.startsWith("windows")) { return "zip"; }
    if (target.startsWith("android")) { return "apk"; }
    if (target.startsWith("macos")) { return "app"; }
    if (target.startsWith("ios")) { return "ipa"; }
    return "directory";
}

fn publish_target_arch(target: string) -> string {
    if (target.endsWith("-arm64")) { return "arm64"; }
    if (target.endsWith("-x64")) { return "x64"; }
    if (target.endsWith("-universal")) { return "universal"; }
    return "default";
}

fn publish_host_default_targets(host: string) -> string {
    if (host == "windows") { return "windows-x64\nandroid-arm64\n"; }
    if (host == "linux") { return "linux-x64\nandroid-arm64\n"; }
    if (host == "macos") { return "macos-universal\nios-arm64\n"; }
    return "";
}

fn publish_host_can_target(host: string, platform: string) -> bool {
    if (host == "windows") { return platform == "windows" || platform == "android"; }
    if (host == "linux") { return platform == "linux" || platform == "android"; }
    if (host == "macos") { return platform == "macos" || platform == "ios"; }
    return false;
}

fn publish_env_present(name: string) -> bool {
    let raw = getenv(name.c_str());
    if (raw == null) { return false; }
    return from_cstr(raw).len > 0;
}

fn publish_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn publish_path_exists(path: string) -> bool {
    return fileExists(path) || isDir(path);
}

fn publish_slash_path(path: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn publish_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return "."; }
    return path.substring(0, last);
}

fn publish_ps_single_quote(text: string) -> string {
    var out = "'";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 39) {
            out = out + "''";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "'";
}

fn publish_sh_single_quote(text: string) -> string {
    var out = "'";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 39) {
            out = out + "'\\''";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "'";
}

fn publish_android_library_meta_name(native_name: string) -> string {
    var out = native_name;
    if (out.startsWith("lib")) { out = out.substring(3, out.len); }
    if (out.endsWith(".so")) { out = out.substring(0, out.len - 3); }
    if (out.len == 0) { return "zyn_app"; }
    return out;
}

fn publish_android_project_exists(project_dir: string, native_name: string) -> bool {
    if (project_dir.len == 0) { return false; }
    if (!fileExists(publish_join(project_dir, "settings.gradle.kts"))) { return false; }
    if (!fileExists(publish_join(project_dir, "app/build.gradle.kts"))) { return false; }
    let manifest_path = publish_join(project_dir, "app/src/main/AndroidManifest.xml");
    if (!fileExists(manifest_path)) { return false; }
    let manifest = readFile(manifest_path);
    if (!manifest.contains("org.vyx.zyn.MainActivity")) { return false; }
    let activity = publish_join(project_dir, "app/src/main/java/org/vyx/zyn/ZynActivity.java");
    if (!fileExists(activity)) { return false; }
    if (!readFile(activity).contains("\"" + publish_android_library_meta_name(native_name) + "\"")) { return false; }
    if (!fileExists(publish_join(project_dir, "app/src/main/java/org/libsdl/app/SDLActivity.java"))) { return false; }
    return true;
}

fn publish_android_abi(target: string) -> string {
    if (target.endsWith("-arm64") || target == "android") { return "arm64-v8a"; }
    if (target.endsWith("-x64")) { return "x86_64"; }
    if (target.endsWith("-armv7")) { return "armeabi-v7a"; }
    return "arm64-v8a";
}

fn publish_android_native_name(configured: string, package_name: string) -> string {
    if (configured.len > 0) { return configured; }
    var out = "";
    var i: i32 = 0;
    while (i < package_name.len) {
        let c = package_name.charAt(i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            out = out + package_name.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { return "zyn_app"; }
    return out;
}

fn publish_android_expected_so(native_name: string) -> string {
    if (native_name.endsWith(".so")) {
        if (native_name.startsWith("lib")) { return native_name; }
        return "lib" + native_name;
    }
    if (native_name.startsWith("lib")) { return native_name + ".so"; }
    return "lib" + native_name + ".so";
}

fn publish_android_native_lib_path(configured: string, out_dir: string, target: string, native_name: string) -> string {
    if (configured.len > 0) { return configured; }
    let abi = publish_android_abi(target);
    let actual_out_dir = out_dir.replace("$" + "{ZYN_ANDROID_ABI}", abi)
                                .replace("$" + "ZYN_ANDROID_ABI", abi);
    return publish_join(actual_out_dir, publish_android_expected_so(native_name));
}

// Only values consumed by AppProfile cross the Android package boundary.
// Build targets, local paths and signing settings remain in the source manifest.
fn publish_runtime_toml_entry(content: string, section: string, key: string) -> string {
    var current_section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            let line = content.substring(start, i).trim();
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    current_section = toml_section_name(line.clone());
                } else if (current_section == section && toml_key(line.clone()) == key) {
                    let equal = line.indexOf("=");
                    if (equal > 0) {
                        let raw = line.substring(equal + 1, line.len).trim();
                        if (raw.len > 0) { return key + " = " + raw + "\n"; }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn publish_runtime_toml(content: string) -> string {
    return "[package]\n"
        + publish_runtime_toml_entry(content.clone(), "package", "name")
        + publish_runtime_toml_entry(content.clone(), "package", "version")
        + "\n[zyn.app]\n"
        + publish_runtime_toml_entry(content.clone(), "zyn.app", "name")
        + publish_runtime_toml_entry(content.clone(), "zyn.app", "id")
        + publish_runtime_toml_entry(content.clone(), "zyn.app", "version")
        + publish_runtime_toml_entry(content.clone(), "zyn.app", "organization")
        + publish_runtime_toml_entry(content.clone(), "zyn.app", "width")
        + publish_runtime_toml_entry(content, "zyn.app", "height");
}

fn publish_join(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    let last = a.charAt(a.len - 1);
    if (last == 47 || last == 92) { return a + b; }
    return a + "/" + b;
}

fn publish_android_triple_for_abi(native_abi: string) -> string {
    if (native_abi == "arm64-v8a") { return "aarch64-linux-android"; }
    if (native_abi == "armeabi-v7a") { return "arm-linux-androideabi"; }
    if (native_abi == "x86") { return "i686-linux-android"; }
    if (native_abi == "x86_64") { return "x86_64-linux-android"; }
    return native_abi;
}

fn publish_android_sdk_root() -> string {
    let home = publish_env_value("ANDROID_HOME");
    if (home.len > 0 && isDir(home)) { return home; }
    let root = publish_env_value("ANDROID_SDK_ROOT");
    if (root.len > 0 && isDir(root)) { return root; }
    if (publish_host() == "windows") {
        let local = publish_env_value("LOCALAPPDATA");
        if (local.len > 0) {
            let candidate = publish_join(publish_join(local, "Android"), "Sdk");
            if (isDir(candidate)) { return candidate; }
        }
        let user = publish_env_value("USERPROFILE");
        if (user.len > 0) {
            let candidate2 = publish_join(publish_join(publish_join(user, "AppData"), "Local"), "Android/Sdk");
            if (isDir(candidate2)) { return candidate2; }
        }
    } else if (publish_host() == "macos") {
        let home2 = publish_env_value("HOME");
        if (home2.len > 0) {
            let candidate3 = publish_join(home2, "Library/Android/sdk");
            if (isDir(candidate3)) { return candidate3; }
        }
    } else {
        let home3 = publish_env_value("HOME");
        if (home3.len > 0) {
            let candidate4 = publish_join(home3, "Android/Sdk");
            if (isDir(candidate4)) { return candidate4; }
        }
    }
    return "";
}

fn publish_android_has_sdk() -> bool {
    return publish_android_sdk_root().len > 0;
}

fn publish_android_ndk_root_like(path: string) -> bool {
    if (path.len == 0 || !isDir(path)) { return false; }
    return isDir(publish_join(path, "toolchains/llvm/prebuilt"));
}

fn publish_android_ndk_scan_root(sdk_root: string) -> string {
    let ndk_home = publish_env_value("ANDROID_NDK_HOME");
    if (publish_android_ndk_root_like(ndk_home)) { return ndk_home; }
    let ndk_root = publish_env_value("ANDROID_NDK_ROOT");
    if (publish_android_ndk_root_like(ndk_root)) { return ndk_root; }
    let ndk_home2 = publish_env_value("NDK_HOME");
    if (publish_android_ndk_root_like(ndk_home2)) { return ndk_home2; }
    let bundle = publish_join(sdk_root, "ndk-bundle");
    if (publish_android_ndk_root_like(bundle)) { return bundle; }
    let ndk_dir = publish_join(sdk_root, "ndk");
    if (isDir(ndk_dir)) { return ndk_dir; }
    return "";
}

fn publish_write_android_local_properties(project_dir: string, sdk_root: string) -> i32 {
    if (sdk_root.len == 0) { return 0; }
    let path = publish_join(project_dir, "local.properties");
    return writeFile(path, "sdk.dir=" + publish_slash_path(sdk_root) + "\n");
}

fn publish_stage_android_cxx_runtime(native_abi: string, jni_dir: string) -> i32 {
    let sdk_root = publish_android_sdk_root();
    if (sdk_root.len == 0) { return 1; }
    let ndk_root = publish_android_ndk_scan_root(sdk_root);
    if (ndk_root.len == 0) { return 2; }
    let dst = publish_join(jni_dir, "libc++_shared.so");
    let triple = publish_android_triple_for_abi(native_abi);
    var cmd = "";
    if (publish_host() == "windows") {
        cmd = "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ErrorActionPreference='Stop'; $src=Get-ChildItem -LiteralPath "
            + publish_ps_single_quote(ndk_root)
            + " -Recurse -Filter 'libc++_shared.so' | Where-Object { $_.FullName -like '*" + native_abi
            + "*' -or $_.FullName -like '*" + triple
            + "*' } | Sort-Object FullName -Descending | Select-Object -First 1; if ($null -eq $src) { exit 1 }; Copy-Item -LiteralPath $src.FullName -Destination "
            + publish_ps_single_quote(dst)
            + " -Force\"";
    } else {
        cmd = "src=$(find " + publish_sh_single_quote(ndk_root)
            + " -name libc++_shared.so | grep -E "
            + publish_sh_single_quote(native_abi + "|" + triple)
            + " | sort | tail -n 1); if [ -z \"$src\" ]; then exit 1; fi; cp \"$src\" "
            + publish_sh_single_quote(dst);
    }
    let rc = system(cmd.c_str());
    if (rc == 0 && fileExists(dst)) { return 0; }
    return 3;
}

fn publish_ensure_dir(path: string) -> i32 {
    if (path.len == 0) { return 0; }
    if (isDir(path)) { return 0; }
    var cmd = "mkdir -p \"" + path + "\"";
    if (publish_host() == "windows") {
        cmd = "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (-not (Test-Path -LiteralPath '" + path + "' -PathType Container)) { New-Item -ItemType Directory -Path '" + path + "' | Out-Null }\"";
    }
    let rc = system(cmd.c_str());
    if (rc == 0 || isDir(path)) { return 0; }
    return rc;
}

fn publish_copy_tree(src: string, dst: string) -> i32 {
    if (!isDir(src)) { return 0; }
    if (publish_ensure_dir(dst.clone()) != 0) { return 1; }
    var cmd = "cp -R " + publish_sh_single_quote(publish_join(src.clone(), "."))
        + " " + publish_sh_single_quote(dst);
    if (publish_host() == "windows") {
        cmd = "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ErrorActionPreference='Stop'; $src="
            + publish_ps_single_quote(src)
            + "; $dst="
            + publish_ps_single_quote(dst)
            + "; if (Test-Path -LiteralPath $src -PathType Container) { if (-not (Test-Path -LiteralPath $dst -PathType Container)) { New-Item -ItemType Directory -Force -Path $dst | Out-Null }; Copy-Item -Path (Join-Path $src '*') -Destination $dst -Recurse -Force }\"";
    }
    return system(cmd.c_str());
}

fn publish_copy_runtime_assets(out_dir: string, payload_dir: string) -> i32 {
    let nut_src = publish_join(out_dir, "nut");
    if (isDir(nut_src)) {
        if (publish_copy_tree(nut_src, publish_join(payload_dir, "nut")) != 0) { return 47; }
    }
    if (publish_copy_tree("assets", publish_join(payload_dir, "assets")) != 0) { return 47; }
    return 0;
}

fn publish_copy_native_payload(target: string, out_dir: string, dist_dir: string, app_name: string) -> i32 {
    let platform = publish_target_platform(target);
    if (platform == "windows") {
        let exe = publish_join(out_dir, app_name + ".exe");
        if (!fileExists(exe)) { return 44; }
        if (copyFile(exe, publish_join(dist_dir, app_name + ".exe")) != 0) { return 41; }
        copyFilesWithExtension(out_dir, dist_dir, ".dll");
        if (publish_copy_runtime_assets(out_dir, dist_dir) != 0) { return 47; }
    } else if (platform == "linux") {
        let exe2 = publish_join(out_dir, app_name);
        if (!fileExists(exe2)) { return 45; }
        if (copyFile(exe2, publish_join(dist_dir, app_name)) != 0) { return 42; }
        copyFilesWithExtension(out_dir, dist_dir, ".so");
        if (publish_copy_runtime_assets(out_dir, dist_dir) != 0) { return 47; }
    } else if (platform == "macos") {
        let exe3 = publish_join(out_dir, app_name);
        if (!fileExists(exe3)) { return 46; }
        if (copyFile(exe3, publish_join(dist_dir, app_name)) != 0) { return 43; }
        copyFilesWithExtension(out_dir, dist_dir, ".dylib");
        if (publish_copy_runtime_assets(out_dir, dist_dir) != 0) { return 47; }
    }
    return 0;
}

fn publish_native_error_message(rc: i32, out_dir: string, app_name: string) -> string {
    if (rc == 41 || rc == 42 || rc == 43) { return "failed to copy native payload from " + out_dir; }
    if (rc == 44) { return "missing native executable: " + publish_join(out_dir, app_name + ".exe"); }
    if (rc == 45 || rc == 46) { return "missing native executable: " + publish_join(out_dir, app_name); }
    if (rc == 47) { return "failed to copy runtime assets from " + out_dir; }
    return "native payload failed with code " + rc.toString();
}

fn publish_stage_android_project(project_dir: string, dist_dir: string, app_name: string, target: string, native_lib: string, native_abi: string, native_name: string, source_manifest: string) -> i32 {
    let plan_path = publish_join(dist_dir, "android-project.txt");
    if (!publish_android_project_exists(project_dir, native_name)) {
        writeFile(plan_path, "android_project=" + project_dir + "\nstatus=missing-or-stale\nnative_name=" + publish_android_library_meta_name(native_name) + "\nnext=create or refresh the SDLActivity Gradle project with zyn publish --init-android\n");
        return 81;
    }
    if (!fileExists(native_lib)) {
        writeFile(plan_path, "android_project=" + project_dir + "\nstatus=missing-native-library\ntarget=" + target + "\nnative_lib=" + native_lib + "\nnext=build a Zyn Android shared library and set [zyn.publish.android].native_lib if it is not at the default path\n");
        return 83;
    }
    let jni_dir = publish_join(project_dir, "app/src/main/jniLibs/" + native_abi);
    if (publish_ensure_dir(jni_dir) != 0) { return 84; }
    let old_icu = "libicudata.so\nlibicuuc.so\nlibicui18n.so\n";
    var old_icu_index: i64 = 0;
    while (old_icu_index < publish_line_count(old_icu)) {
        let old_path = publish_join(jni_dir, publish_line_at(old_icu, old_icu_index));
        if (fileExists(old_path) && deleteFile(old_path) != 0) { return 87; }
        old_icu_index = old_icu_index + 1;
    }
    let native_dir = publish_dirname(native_lib);
    if (copyFilesWithExtension(native_dir, jni_dir, ".so") < 0) { return 87; }
    let staged_so = publish_join(jni_dir, publish_android_expected_so(native_name));
    if (copyFile(native_lib, staged_so) != 0) { return 85; }
    let zyn_sdk = publish_env_value("ZYN_SDK_ROOT");
    let zyn_runtime = publish_join(zyn_sdk, "out/android/" + native_abi);
    if (!fileExists(publish_join(zyn_runtime, "libZyn.so"))) {
        print("zyn publish: missing Android Zyn SDK: " + zyn_runtime);
        return 90;
    }
    if (copyFilesWithExtension(zyn_runtime, jni_dir, ".so") < 1) { return 87; }
    let vendors = "SDL3\nCacao\nFreeType\nHarfBuzz\nICU\n";
    var vendor_index: i64 = 0;
    while (vendor_index < publish_line_count(vendors)) {
        let vendor = publish_line_at(vendors, vendor_index);
        let source = publish_join(zyn_sdk, "vendor/" + vendor + "/lib/android/" + native_abi);
        if (!isDir(source) || copyFilesWithExtension(source, jni_dir, ".so") < 1) {
            print("zyn publish: missing Android SDK dependency: " + source);
            return 91;
        }
        vendor_index = vendor_index + 1;
    }
    let assets = publish_join(project_dir, "app/src/main/assets");
    if (publish_ensure_dir(publish_join(assets, "nut")) != 0) { return 92; }
    // Upgrade already generated Android projects without replacing any custom
    // Activity or Gradle edits the application may have added.
    let activity_path = publish_join(project_dir, "app/src/main/java/org/vyx/zyn/ZynActivity.java");
    let gradle_path = publish_join(project_dir, "app/build.gradle.kts");
    if (!fileExists(activity_path) || !fileExists(gradle_path)) { return 92; }
    let activity_text = readFile(activity_path).replace("installAsset(\"Vyx.toml\")", "installAsset(\"Zyn.runtime.toml\")");
    let gradle_text = readFile(gradle_path).replace("\"Vyx.toml\"", "\"Zyn.runtime.toml\"");
    if (!activity_text.contains("installAsset(\"Zyn.runtime.toml\")")
        || !gradle_text.contains("\"Zyn.runtime.toml\"")) { return 92; }
    if (isDir("assets") && !activity_text.contains("installProjectAssets();")) {
        print("zyn publish: Android Activity must install project assets; update ZynActivity.java from the current Zyn template");
        return 92;
    }
    if (writeFile(activity_path, activity_text) != 0 || writeFile(gradle_path, gradle_text) != 0) { return 92; }
    let old_manifest = publish_join(assets, "Vyx.toml");
    if (fileExists(old_manifest) && deleteFile(old_manifest) != 0) { return 92; }
    if (writeFile(publish_join(assets, "Zyn.runtime.toml"), publish_runtime_toml(source_manifest)) != 0
        || copyFile(publish_join(zyn_sdk, "src/nut/shaders/solid.slang"), publish_join(assets, "nut/solid.slang")) != 0) {
        return 92;
    }
    if (publish_copy_tree("assets", publish_join(assets, "zyn/assets")) != 0) { return 92; }
    let sdk_root = publish_android_sdk_root();
    if (sdk_root.len == 0) {
        writeFile(plan_path, "android_project=" + project_dir + "\nstatus=missing-android-sdk\nnext=set ANDROID_HOME or ANDROID_SDK_ROOT\n");
        return 86;
    }
    if (publish_write_android_local_properties(project_dir, sdk_root) != 0) { return 89; }
    let cxx_rc = publish_stage_android_cxx_runtime(native_abi, jni_dir);
    if (cxx_rc != 0) {
        writeFile(plan_path, "android_project=" + project_dir + "\nstatus=missing-android-cxx-runtime\nnative_abi=" + native_abi + "\nnext=install Android NDK or set ANDROID_NDK_HOME/ANDROID_NDK_ROOT\n");
        return 88;
    }
    let gradlew_bat = publish_join(project_dir, "gradlew.bat");
    let gradlew_sh = publish_join(project_dir, "gradlew");
    var gradle = "";
    if (fileExists(gradlew_bat)) { gradle = ".\\gradlew.bat"; }
    else if (fileExists(gradlew_sh)) { gradle = "./gradlew"; }
    if (gradle.len == 0) {
        writeFile(plan_path, "android_project=" + project_dir + "\nstatus=no-gradle-wrapper\nnext=add Gradle wrapper\n");
        return 82;
    }
    var variant = "Release";
    var apk_variant = "release";
    if (publish_arg_has("--debug")) { variant = "Debug"; apk_variant = "debug"; }
    let cmd = "cd \"" + project_dir + "\" && " + gradle + " assemble" + variant;
    let rc = system(cmd.c_str());
    if (rc != 0) { return 51; }
    let apk = publish_join(project_dir, "app/build/outputs/apk/" + apk_variant + "/app-" + apk_variant + ".apk");
    if (!fileExists(apk)) {
        let unsigned_apk = publish_join(project_dir, "app/build/outputs/apk/release/app-release-unsigned.apk");
        if (fileExists(unsigned_apk)) {
            writeFile(plan_path, "android_project=" + project_dir + "\nstatus=unsigned-release\nnext=configure release signing or regenerate the Android project\n");
            return 53;
        }
        return 52;
    }
    return copyFile(apk, publish_join(dist_dir, app_name + "-" + target + ".apk"));
}

fn publish_android_error_message(rc: i32, project_dir: string, native_lib: string) -> string {
    if (rc == 81) { return "missing or stale SDLActivity Android Gradle project: " + project_dir; }
    if (rc == 82) { return "Android project has no Gradle wrapper: " + project_dir; }
    if (rc == 83) { return "missing Android native runtime library: " + native_lib; }
    if (rc == 90) { return "Android Zyn SDK has not been built for the requested ABI"; }
    if (rc == 91) { return "Android SDK dependencies are missing; run tools/android-deps/Build.ps1"; }
    if (rc == 92) { return "failed to stage application manifest or Nut shader assets"; }
    if (rc == 84) { return "failed to create Android jniLibs directory"; }
    if (rc == 85) { return "failed to stage Android native runtime library"; }
    if (rc == 86) { return "missing Android SDK environment: set ANDROID_HOME or ANDROID_SDK_ROOT"; }
    if (rc == 87) { return "failed to stage Android native dependency libraries"; }
    if (rc == 88) { return "missing Android libc++ shared runtime for staged native libraries"; }
    if (rc == 89) { return "failed to write Android local.properties"; }
    if (rc == 51) { return "Gradle assembleRelease failed"; }
    if (rc == 52) { return "Gradle completed without app-release.apk"; }
    if (rc == 53) { return "Gradle produced an unsigned release APK; configure signing or regenerate the Android project"; }
    return "Android publish failed with code " + rc.toString();
}

fn publish_stage_macos_bundle(out_dir: string, dist_dir: string, app_name: string, bundle_id: string) -> i32 {
    let app_dir = publish_join(dist_dir, app_name + ".app");
    let contents = publish_join(app_dir, "Contents");
    let macos = publish_join(contents, "MacOS");
    let frameworks = publish_join(contents, "Frameworks");
    publish_ensure_dir(app_dir);
    publish_ensure_dir(contents);
    publish_ensure_dir(macos);
    publish_ensure_dir(frameworks);
    let exe = publish_join(out_dir, app_name);
    if (fileExists(exe)) {
        if (copyFile(exe, publish_join(macos, app_name)) != 0) { return 61; }
    }
    copyFilesWithExtension(out_dir, frameworks, ".dylib");
    if (publish_copy_runtime_assets(out_dir, macos) != 0) { return 62; }
    let plist = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
        + "<plist version=\"1.0\"><dict>\n"
        + "<key>CFBundleIdentifier</key><string>" + bundle_id + "</string>\n"
        + "<key>CFBundleName</key><string>" + app_name + "</string>\n"
        + "<key>CFBundleExecutable</key><string>" + app_name + "</string>\n"
        + "</dict></plist>\n";
    return writeFile(publish_join(contents, "Info.plist"), plist);
}

fn publish_stage_ios_project(project_dir: string, dist_dir: string, app_name: string) -> i32 {
    let plan_path = publish_join(dist_dir, "ios-project.txt");
    if (!isDir(project_dir)) {
        writeFile(plan_path, "ios_project=" + project_dir + "\nstatus=missing\nnext=create Xcode iOS project or set [zyn.publish.ios].project\n");
        return 91;
    }
    let scheme = app_name;
    let archive = publish_join(dist_dir, app_name + ".xcarchive");
    let cmd = "xcodebuild -project \"" + project_dir + "\" -scheme \"" + scheme + "\" -configuration Release -sdk iphoneos archive -archivePath \"" + archive + "\"";
    let rc = system(cmd.c_str());
    if (rc != 0) { return 92; }
    return 0;
}

fn publish_ios_error_message(rc: i32, project_dir: string) -> string {
    if (rc == 91) { return "missing Xcode iOS project: " + project_dir; }
    if (rc == 92) { return "xcodebuild archive failed"; }
    return "iOS publish failed with code " + rc.toString();
}

fn publish_make_archive(target: string, dist_root: string, dist_dir: string, app_name: string) -> i32 {
    let platform = publish_target_platform(target);
    if (platform == "windows") {
        let archive = publish_join(dist_root, app_name + "-" + target + ".zip");
        let cmd = "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Compress-Archive -Path '" + dist_dir + "/*' -DestinationPath '" + archive + "' -Force\"";
        return system(cmd.c_str());
    }
    return 0;
}

fn publish_target_ready(target: string) -> bool {
    let platform = publish_target_platform(target);
    if (platform == "android") {
        return publish_android_has_sdk();
    }
    if (platform == "ios") {
        return publish_host() == "macos";
    }
    return true;
}

fn publish_doctor_target(host: string, target: string, out_dir: string, app_name: string, android_project: string, ios_project: string, android_native_lib: string, android_native_name: string) -> i32 {
    let platform = publish_target_platform(target);
    if (!publish_host_can_target(host, platform)) { return 20; }
    if (platform == "android") {
        if (!publish_android_project_exists(android_project, android_native_name)) { return 32; }
        if (!fileExists(publish_join(android_project, "gradlew.bat")) && !fileExists(publish_join(android_project, "gradlew"))) { return 33; }
        if (!fileExists(android_native_lib)) { return 34; }
        if (!publish_android_has_sdk()) { return 31; }
        return 0;
    }
    if (platform == "ios") {
        if (host != "macos") { return 41; }
        if (!isDir(ios_project)) { return 42; }
        return 0;
    }
    if (platform == "windows") {
        if (!fileExists(publish_join(out_dir, app_name + ".exe"))) { return 51; }
        return 0;
    }
    if (platform == "linux" || platform == "macos") {
        if (!fileExists(publish_join(out_dir, app_name))) { return 52; }
        return 0;
    }
    return 99;
}

fn publish_doctor_message(rc: i32, target: string, out_dir: string, app_name: string, android_project: string, ios_project: string, android_native_lib: string) -> string {
    if (rc == 0) { return "ready"; }
    if (rc == 20) { return "host cannot publish target " + target; }
    if (rc == 31) { return "missing Android SDK environment: set ANDROID_HOME or ANDROID_SDK_ROOT"; }
    if (rc == 32) { return "missing or stale SDLActivity Android Gradle project: " + android_project; }
    if (rc == 33) { return "Android project has no Gradle wrapper: " + android_project; }
    if (rc == 34) { return "missing Android native runtime library: " + android_native_lib; }
    if (rc == 41) { return "iOS publishing requires macOS"; }
    if (rc == 42) { return "missing Xcode iOS project: " + ios_project; }
    if (rc == 51) { return "missing native executable: " + publish_join(out_dir, app_name + ".exe"); }
    if (rc == 52) { return "missing native executable: " + publish_join(out_dir, app_name); }
    return "unknown target platform for " + target;
}

fn publish_manifest_for_target(app_name: string, version: string, bundle_id: string, entry: string, host: string, target: string, android_native_lib: string, android_native_abi: string, android_native_name: string) -> string {
    var out = "app=" + app_name + "\n"
        + "version=" + version + "\n"
        + "id=" + bundle_id + "\n"
        + "entry=" + entry + "\n"
        + "host=" + host + "\n"
        + "target=" + target + "\n"
        + "platform=" + publish_target_platform(target) + "\n"
        + "arch=" + publish_target_arch(target) + "\n"
        + "package=" + publish_target_package(target) + "\n";
    if (publish_target_platform(target) == "android") {
        out = out
            + "android_native_abi=" + android_native_abi + "\n"
            + "android_native_name=" + publish_android_library_meta_name(android_native_name) + "\n"
            + "android_native_lib=" + android_native_lib + "\n";
    }
    return out;
}

fn publish_write_doctor_status(target_dir: string, target: string, status: string) -> i32 {
    return writeFile(publish_join(target_dir, "publish-doctor.txt"), "target=" + target + "\nstatus=" + status + "\n");
}

fn publish_xml_escape(text: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 38) { out = out + "&amp;"; }
        else if (c == 60) { out = out + "&lt;"; }
        else if (c == 62) { out = out + "&gt;"; }
        else if (c == 34) { out = out + "&quot;"; }
        else { out = out + text.substring(i, i + 1); }
        i = i + 1;
    }
    return out;
}

fn publish_java_string_escape(text: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 92) { out = out + "\\\\"; }
        else if (c == 34) { out = out + "\\\""; }
        else if (c == 10) { out = out + "\\n"; }
        else if (c == 13) { out = out + "\\r"; }
        else if (c == 9) { out = out + "\\t"; }
        else { out = out + text.substring(i, i + 1); }
        i = i + 1;
    }
    return out;
}

fn publish_package_path(package_name: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < package_name.len) {
        let c = package_name.charAt(i);
        if (c == 46) { out = out + "/"; }
        else { out = out + package_name.substring(i, i + 1); }
        i = i + 1;
    }
    return out;
}

fn publish_android_settings(app_name: string) -> string {
    return "pluginManagement {\n"
        + "    repositories {\n"
        + "        google()\n"
        + "        mavenCentral()\n"
        + "        gradlePluginPortal()\n"
        + "    }\n"
        + "}\n"
        + "dependencyResolutionManagement { repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS); repositories { google(); mavenCentral() } }\n"
        + "rootProject.name = \"" + app_name + " Android\"\n"
        + "include(\":app\")\n";
}

fn publish_android_root_build() -> string {
    return "plugins {\n"
        + "    id(\"com.android.application\") version \"8.7.3\" apply false\n"
        + "    id(\"org.jetbrains.kotlin.android\") version \"2.1.0\" apply false\n"
        + "}\n";
}

fn publish_android_gradle_version() -> string {
    return "8.10.2";
}

fn publish_android_gradle_distribution_url() -> string {
    let version = publish_android_gradle_version();
    return "https://services.gradle.org/distributions/gradle-" + version + "-bin.zip";
}

fn publish_android_gradle_wrapper_bat() -> string {
    return publish_android_template("gradlew.bat");
}

fn publish_android_gradle_wrapper_sh() -> string {
    return publish_android_template("gradlew");
}

fn publish_android_wrapper_properties() -> string {
    return "distributionBase=GRADLE_USER_HOME\ndistributionPath=wrapper/dists\n"
        + "distributionUrl=" + publish_android_gradle_distribution_url() + "\n"
        + "distributionSha256Sum=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26\n"
        + "networkTimeout=10000\nvalidateDistributionUrl=true\n"
        + "zipStoreBase=GRADLE_USER_HOME\nzipStorePath=wrapper/dists\n";
}

fn publish_android_app_build(app_id: string, compile_sdk: string, min_sdk: string, target_sdk: string, version_name: string) -> string {
    let language = publish_arg_value("--language", "java");
    var text = publish_android_template("app.gradle.kts");
    text = text.replace("@@APP_ID@@", app_id).replace("@@COMPILE_SDK@@", compile_sdk)
        .replace("@@MIN_SDK@@", min_sdk).replace("@@TARGET_SDK@@", target_sdk)
        .replace("@@VERSION@@", publish_java_string_escape(version_name));
    if (language == "kotlin") {
        return text.replace("@@KOTLIN_PLUGIN@@", "id(\"org.jetbrains.kotlin.android\")")
            .replace("@@KOTLIN_OPTIONS@@", "kotlinOptions { jvmTarget = \"17\" }");
    }
    return text.replace("@@KOTLIN_PLUGIN@@", "").replace("@@KOTLIN_OPTIONS@@", "");
}

fn publish_android_template(name: string) -> string {
    let path = publish_join(publish_env_value("ZYN_SDK_ROOT"), "templates/android/" + name);
    if (!fileExists(path)) { return ""; }
    return readFile(path);
}

fn publish_android_manifest(native_name: string) -> string {
    return publish_android_template("AndroidManifest.xml");
}

fn publish_android_strings(app_name: string) -> string {
    return "<resources>\n"
        + "    <string name=\"app_name\">" + publish_xml_escape(app_name) + "</string>\n"
        + "</resources>\n";
}

fn publish_android_styles() -> string {
    return "<resources>\n"
        + "    <style name=\"ZynTheme\" parent=\"android:style/Theme.Material.Light.NoActionBar\">\n"
        + "        <item name=\"android:windowNoTitle\">true</item>\n"
        + "        <item name=\"android:windowActionBar\">false</item>\n"
        + "    </style>\n"
        + "</resources>\n";
}

fn publish_init_android_project(project_dir: string, app_name: string, app_id: string, app_version: string, compile_sdk: string, min_sdk: string, target_sdk: string, native_name: string) -> i32 {
    if (project_dir.len == 0 || app_id.len == 0) { return 101; }
    if (publish_android_project_exists(project_dir.clone(), native_name.clone())) { return 0; }
    if (publish_path_exists(publish_join(project_dir, "settings.gradle.kts"))
        || publish_path_exists(publish_join(project_dir, "app"))
        || publish_path_exists(publish_join(project_dir, "build.gradle.kts"))
        || publish_path_exists(publish_join(project_dir, "gradle.properties"))
        || publish_path_exists(publish_join(project_dir, "gradlew"))
        || publish_path_exists(publish_join(project_dir, "gradlew.bat"))
        || publish_path_exists(publish_join(project_dir, "gradle"))) {
        print("zyn publish: Android project already contains files; refusing to replace them: " + project_dir);
        return 124;
    }
    let language = publish_arg_value("--language", "java");
    if (language != "java" && language != "kotlin") { return 125; }
    let activity = publish_android_template("ZynActivity.java").replace("@@NATIVE@@", publish_android_library_meta_name(native_name));
    var activity_file = "MainActivity.java";
    if (language == "kotlin") { activity_file = "MainActivity.kt"; }
    let main_activity = publish_android_template(activity_file);
    let app_build = publish_android_app_build(app_id, compile_sdk, min_sdk, target_sdk, app_version)
        .replace("@@NATIVE@@", publish_android_library_meta_name(native_name));
    if (activity.len == 0 || main_activity.len == 0 || app_build.len == 0 || publish_android_manifest(native_name).len == 0) { return 126; }
    let sdl_java = publish_join(publish_env_value("ZYN_SDK_ROOT"), "vendor/SDL3/android/java/org/libsdl/app");
    if (!fileExists(publish_join(sdl_java, "SDLActivity.java"))) { return 127; }
    let app_dir = publish_join(project_dir, "app");
    let main_dir = publish_join(app_dir, "src/main");
    let jni_dir = publish_join(main_dir, "jniLibs");
    let values_dir = publish_join(main_dir, "res/values");
    let wrapper_dir = publish_join(project_dir, "gradle/wrapper");
    if (publish_ensure_dir(project_dir) != 0) { return 102; }
    if (publish_ensure_dir(app_dir) != 0) { return 103; }
    if (publish_ensure_dir(main_dir) != 0) { return 104; }
    if (publish_ensure_dir(jni_dir) != 0) { return 105; }
    if (publish_ensure_dir(values_dir) != 0) { return 106; }
    if (publish_ensure_dir(wrapper_dir) != 0) { return 107; }
    if (writeFile(publish_join(project_dir, "settings.gradle.kts"), publish_android_settings(app_name)) != 0) { return 111; }
    if (writeFile(publish_join(project_dir, "build.gradle.kts"), publish_android_root_build()) != 0) { return 112; }
    if (writeFile(publish_join(project_dir, "gradle.properties"), "android.useAndroidX=false\norg.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8\norg.gradle.workers.max=2\norg.gradle.daemon=false\n") != 0) { return 113; }
    let sdk_root = publish_android_sdk_root();
    if (sdk_root.len > 0 && publish_write_android_local_properties(project_dir, sdk_root) != 0) { return 123; }
    if (writeFile(publish_join(app_dir, "build.gradle.kts"), app_build) != 0) { return 114; }
    if (writeFile(publish_join(main_dir, "AndroidManifest.xml"), publish_android_manifest(native_name)) != 0) { return 115; }
    let java_dir = publish_join(main_dir, "java/org/vyx/zyn");
    let sdl_java_dir = publish_join(main_dir, "java/org/libsdl/app");
    if (publish_ensure_dir(java_dir) != 0 || publish_ensure_dir(sdl_java_dir) != 0) { return 116; }
    if (writeFile(publish_join(java_dir, "ZynActivity.java"), activity) != 0) { return 116; }
    if (writeFile(publish_join(java_dir, activity_file), main_activity) != 0) { return 116; }
    if (copyFilesWithExtension(sdl_java, sdl_java_dir, ".java") < 1) { return 116; }
    if (writeFile(publish_join(values_dir, "strings.xml"), publish_android_strings(app_name)) != 0) { return 117; }
    if (writeFile(publish_join(values_dir, "styles.xml"), publish_android_styles()) != 0) { return 118; }
    if (writeFile(publish_join(project_dir, "gradlew.bat"), publish_android_gradle_wrapper_bat()) != 0) { return 119; }
    if (writeFile(publish_join(project_dir, "gradlew"), publish_android_gradle_wrapper_sh()) != 0) { return 120; }
    if (writeFile(publish_join(wrapper_dir, "gradle-wrapper.properties"), publish_android_wrapper_properties()) != 0) { return 121; }
    if (copyFile(publish_join(publish_env_value("ZYN_SDK_ROOT"), "templates/android/gradle-wrapper.jar"),
                 publish_join(wrapper_dir, "gradle-wrapper.jar")) != 0) { return 121; }
    if (publish_host() != "windows") {
        let chmod_rc = system(("chmod +x \"" + publish_join(project_dir, "gradlew") + "\"").c_str());
        if (chmod_rc != 0) { return 122; }
    }
    return 0;
}

fn publish_android_init_error_message(rc: i32, project_dir: string) -> string {
    if (rc == 101) { return "invalid Android project configuration"; }
    if (rc >= 102 && rc <= 107) { return "failed to create Android project directory under " + project_dir; }
    if (rc == 116) { return "failed to remove generated legacy Android activity under " + project_dir; }
    if (rc >= 111 && rc <= 121) { return "failed to write Android project file under " + project_dir; }
    if (rc == 122) { return "failed to mark Android Gradle launcher executable under " + project_dir; }
    if (rc == 123) { return "failed to write Android local.properties under " + project_dir; }
    if (rc == 124) { return "existing Android project was retained; migrate it explicitly or choose an empty project directory"; }
    if (rc == 125) { return "--language must be java or kotlin"; }
    if (rc == 126) { return "SDK Android templates are missing"; }
    if (rc == 127) { return "SDL3 Android Java sources are missing; prepare the SDK Android dependencies first"; }
    return "Android project init failed with code " + rc.toString();
}

fn publish_prepare_android_project(project_dir: string, app_name: string, app_id: string, app_version: string, compile_sdk: string, min_sdk: string, target_sdk: string, native_name: string) -> i32 {
    if (publish_android_project_exists(project_dir.clone(), native_name.clone())) { return 0; }
    return publish_init_android_project(project_dir, app_name, app_id, app_version, compile_sdk, min_sdk, target_sdk, native_name);
}

fn main() -> i32 {
    let mode = publish_mode();
    if (mode == "help") {
        publish_print_usage();
        return 0;
    }

    let manifest_path = "Vyx.toml";
    if (!fileExists(manifest_path)) {
        print("zyn publish: Vyx.toml not found");
        return 2;
    }
    let manifest = readFile(manifest_path);
    let host = publish_host();
    let package_name = publish_toml_string(manifest.clone(), "package", "name", "app");
    let package_version = publish_toml_string(manifest.clone(), "package", "version", "0.1.0");
    let package_entry = publish_toml_string(manifest.clone(), "package", "entry", "src/main.vyx");
    let app_name = publish_toml_string(manifest.clone(), "zyn.app", "name", package_name);
    let app_version = publish_toml_string(manifest.clone(), "zyn.app", "version", package_version);
    let app_id = publish_toml_string(manifest.clone(), "zyn.app", "id", "local." + package_name);
    let app_entry = publish_toml_string(manifest.clone(), "zyn.app", "entry", package_entry);
    let out_dir = publish_toml_string(manifest.clone(), "build", "output_dir", "target");
    let android_out_dir = publish_toml_string(manifest.clone(), "build", "output_dir_android", out_dir);
    let dist_root = publish_arg_value("--dist", publish_toml_string(manifest.clone(), "zyn.publish", "dist", "dist"));
    let android_project = publish_toml_string(manifest.clone(), "zyn.publish.android", "project", "android");
    let android_compile_sdk = publish_toml_string(manifest.clone(), "zyn.publish.android", "compile_sdk", "35");
    let android_min_sdk = publish_toml_string(manifest.clone(), "zyn.publish.android", "min_sdk", "29");
    let android_target_sdk = publish_toml_string(manifest.clone(), "zyn.publish.android", "target_sdk", android_compile_sdk);
    let android_configured_native_name = publish_toml_string(manifest.clone(), "zyn.publish.android", "native_name", "");
    let android_configured_native_lib = publish_toml_string(manifest.clone(), "zyn.publish.android", "native_lib", "");
    let android_native_name = publish_android_native_name(android_configured_native_name, package_name);
    let ios_project = publish_toml_string(manifest.clone(), "zyn.publish.ios", "project", "ios");

    if (mode == "init-android") {
        let init_rc = publish_init_android_project(android_project, app_name, app_id, app_version, android_compile_sdk, android_min_sdk, android_target_sdk, android_native_name);
        if (init_rc != 0) {
            print("zyn publish: " + publish_android_init_error_message(init_rc, android_project));
            return 20;
        }
        print("zyn publish: android project ready at " + android_project);
        return 0;
    }

    var targets = publish_arg_target_lines();
    if (targets.len == 0) {
        targets = publish_toml_array_lines(publish_toml_get(manifest.clone(), "zyn.publish", "targets"));
    }
    if (targets.len == 0) {
        targets = publish_host_default_targets(host);
    }
    if (targets.len == 0) {
        print("zyn publish: no default targets for host " + host);
        return 3;
    }

    print("zyn publish: mode=" + mode + " host=" + host + " app=" + app_name + " version=" + app_version);
    var failures: i32 = 0;
    var i: i64 = 0;
    let count = publish_line_count(targets.clone());
    while (i < count) {
        let target = publish_line_at(targets.clone(), i).trim();
        if (target.len > 0) {
            let platform = publish_target_platform(target);
            let android_native_abi = publish_android_abi(target);
            let android_native_lib = publish_android_native_lib_path(android_configured_native_lib, android_out_dir, target, android_native_name);
            if (!publish_host_can_target(host, platform)) {
                print("  x " + target + " blocked: " + host + " cannot publish " + platform);
                failures = failures + 1;
            } else {
                let target_dir = publish_join(dist_root, target);
                let root_dir_rc = publish_ensure_dir(dist_root);
                let target_dir_rc = publish_ensure_dir(target_dir);
                if (root_dir_rc != 0 || target_dir_rc != 0) {
                    print("  x " + target + " failed while creating dist directory " + target_dir);
                    failures = failures + 1;
                } else {
                    let plan = publish_manifest_for_target(app_name, app_version, app_id, app_entry, host, target, android_native_lib, android_native_abi, android_native_name);
                    if (writeFile(publish_join(target_dir, "publish-plan.txt"), plan) != 0) {
                        print("  x " + target + " failed while writing publish-plan.txt");
                        failures = failures + 1;
                    } else if (mode == "plan") {
                        let doctor_rc = publish_doctor_target(host, target, out_dir, package_name, android_project, ios_project, android_native_lib, android_native_name);
                        let doctor_msg = publish_doctor_message(doctor_rc, target, out_dir, package_name, android_project, ios_project, android_native_lib);
                        if (publish_write_doctor_status(target_dir, target, doctor_msg) != 0) {
                            print("  x " + target + " failed while writing publish-doctor.txt");
                            failures = failures + 1;
                        } else {
                            print("  plan " + target + " -> " + target_dir);
                        }
                    } else if (mode == "doctor") {
                        let doctor_rc2 = publish_doctor_target(host, target, out_dir, package_name, android_project, ios_project, android_native_lib, android_native_name);
                        let doctor_msg2 = publish_doctor_message(doctor_rc2, target, out_dir, package_name, android_project, ios_project, android_native_lib);
                        if (publish_write_doctor_status(target_dir, target, doctor_msg2) != 0) {
                            print("  x " + target + " failed while writing publish-doctor.txt");
                            failures = failures + 1;
                        } else if (doctor_rc2 != 0) {
                            print("  x " + target + " " + doctor_msg2);
                            failures = failures + 1;
                        } else {
                            print("  ok " + target + " " + doctor_msg2);
                        }
                    } else {
                        let copy_rc = publish_copy_native_payload(target, out_dir, target_dir, package_name);
                        if (copy_rc != 0) {
                            print("  x " + target + " " + publish_native_error_message(copy_rc, out_dir, package_name));
                            failures = failures + 1;
                        } else if (platform == "android") {
                            let prepare_rc = publish_prepare_android_project(android_project.clone(), app_name.clone(), app_id.clone(), app_version.clone(), android_compile_sdk.clone(), android_min_sdk.clone(), android_target_sdk.clone(), android_native_name.clone());
                            if (prepare_rc != 0) {
                                print("  x " + target + " " + publish_android_init_error_message(prepare_rc, android_project));
                                failures = failures + 1;
                            } else {
                                let android_rc = publish_stage_android_project(android_project, target_dir, package_name, target, android_native_lib, android_native_abi, android_native_name, manifest.clone());
                                if (android_rc != 0) {
                                    print("  x " + target + " " + publish_android_error_message(android_rc, android_project, android_native_lib));
                                    failures = failures + 1;
                                } else {
                                    print("  ok " + target + " -> " + target_dir);
                                }
                            }
                        } else if (platform == "macos") {
                            if (publish_stage_macos_bundle(out_dir, target_dir, package_name, app_id) != 0) {
                                print("  x " + target + " failed while staging macOS app bundle");
                                failures = failures + 1;
                            } else {
                                print("  ok " + target + " -> " + target_dir);
                            }
                        } else if (platform == "ios") {
                            let ios_rc = publish_stage_ios_project(ios_project, target_dir, package_name);
                            if (ios_rc != 0) {
                                print("  x " + target + " " + publish_ios_error_message(ios_rc, ios_project));
                                failures = failures + 1;
                            } else {
                                print("  ok " + target + " -> " + target_dir);
                            }
                        } else if (!publish_target_ready(target)) {
                            print("  x " + target + " target is not ready");
                            failures = failures + 1;
                        } else if (publish_make_archive(target, dist_root, target_dir, package_name) != 0) {
                            print("  x " + target + " failed while packaging " + publish_target_package(target));
                            failures = failures + 1;
                        } else {
                            print("  ok " + target + " -> " + target_dir);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    if (failures > 0) {
        print("zyn publish: failed targets=" + failures.toString());
        return 10;
    }
    return 0;
}
