use std.fs;

extern "C" {
    fn system(cmd: rawptr) -> i32;
}

fn ensure_dir(path: string) -> i32 {
    let cmd = "mkdir \"" + path + "\" 2>NUL";
    system(cmd.c_str());
    return 0;
}

fn main() -> i32 {
    if (copyFilesWithExtension("vendor/SDL3/lib/x64", "out", ".dll") < 0) { return 1; }
    if (copyFilesWithExtension("vendor/Cacao/bin/x64", "out", ".dll") < 0) { return 2; }
    if (copyFilesWithExtension("vendor/FreeType/bin/x64", "out", ".dll") < 0) { return 5; }
    if (copyFilesWithExtension("vendor/HarfBuzz/bin/x64", "out", ".dll") < 0) { return 6; }
    if (copyFilesWithExtension("vendor/ICU/bin/x64", "out", ".dll") < 0) { return 7; }
    if (ensure_dir("out/nut") != 0) { return 3; }
    if (copyFile("src/nut/shaders/solid.slang", "out/nut/solid.slang") != 0) { return 4; }
    return 0;
}
