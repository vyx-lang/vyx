use App = Zyn.App.App;
use AppAction = Zyn.App.AppAction;
use AppEvent = Zyn.App.AppEvent;
use AppWorld = Zyn.App.AppWorld;
use AppSurface = Zyn.App.AppSurface;
use AndroidPermission = Zyn.Platform.Platform.AndroidPermission;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use StatefulComponent = Zyn.App.StatefulComponent;
use Text = Zyn.App.Text;
use View = Zyn.App.View;
use std.fs;

fn requestCamera(action: AppAction, world: AppWorld) -> AppWorld {
    match (AndroidPermission.request("android.permission.CAMERA")) {
        case Ok(id) => {
            writeFile("permission_request.txt", id.toString());
            return world.setIntResource("probe.state.permission_id", id);
        }
        case Err(err) => {
            writeFile("permission_error.txt", err.message);
            return world;
        }
    }
}

fn checkCamera(action: AppAction, world: AppWorld) -> AppWorld {
    let id = world.intResource("probe.state.permission_id", 0);
    let state = AndroidPermission.status(id);
    writeFile("permission_state.txt", state.toString());
    if (state >= 0) { AndroidPermission.release(id); }
    return world.setIntResource("probe.state.permission_state", state);
}

fn recordTap(action: AppAction, world: AppWorld) -> AppWorld {
    let count = world.intResource("probe.state.taps", 0) + 1;
    writeFile("touch_count.txt", count.toString());
    return world.setIntResource("probe.state.taps", count);
}

class InteractionProbe : StatefulComponent {
    public static fn create() -> InteractionProbe {
        return InteractionProbe { component_id: "probe", state_id: "probe.state" };
    }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        return world.setIntResource(self.stateResource("taps"), 0)
            .setIntResource(self.stateResource("permission_id"), 0)
            .setIntResource(self.stateResource("permission_state"), -2)
            .setIntResource(self.stateResource("frames"), 0)
            .setIntResource(self.stateResource("touch_events"), 0)
            .registerBehavior("probe.request_camera", requestCamera)
            .registerBehavior("probe.check_camera", checkCamera)
            .registerBehavior("probe.tap", recordTap);
    }

    public fn update(&mut self, event: AppEvent, world: AppWorld) -> AppWorld {
        if (event.isFrame() && world.intResource(self.stateResource("frames"), 0) == 0) {
            writeFile("stateful_frame_seen.txt", "1");
            return world.setIntResource(self.stateResource("frames"), 1);
        }
        if (event.isPlatform() && event.platform_event.isFingerUp()) {
            let count = world.intResource(self.stateResource("touch_events"), 0) + 1;
            writeFile("stateful_touch_events.txt", count.toString());
            return world.setIntResource(self.stateResource("touch_events"), count);
        }
        return world;
    }

    public fn view(&self, world: AppWorld) -> View {
        return AppSurface.stage("probe.surface", Column.create().id("probe.controls")
            .padding(24.0).gap(16.0)
            .child(Text.title("Stateful interaction probe").height(48.0))
            .child(Button.filledAction("probe.camera", "Request camera", "probe.request_camera").height(56.0))
            .child(Button.filledAction("probe.check", "Check permission", "probe.check_camera").height(56.0))
            .child(Button.filledAction("probe.touch", "Tap counter", "probe.tap").height(56.0))
            .child(Text.body("Touches: " + world.intResource(self.stateResource("taps"), 0).toString()).height(40.0)));
    }
}

fn main() -> i32 {
    return App.manifestFromArgs().run(InteractionProbe.create());
}
