#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SDK_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SDK_ROOT/.." && pwd)

find_zyn_vyxc() {
    if [ "${ZYN_VYXC:-}" != "" ] && [ -f "$ZYN_VYXC" ]; then
        printf '%s\n' "$ZYN_VYXC"
        return 0
    fi
    for candidate in \
        "$SCRIPT_DIR/vyxc" \
        "$SCRIPT_DIR/vyxc.exe" \
        "$SCRIPT_DIR/cache/vyxc" \
        "$SCRIPT_DIR/cache/vyxc.exe" \
        "$SDK_ROOT/toolchain/vyxc" \
        "$SDK_ROOT/toolchain/vyxc.exe" \
        "$SDK_ROOT/out/vyxc" \
        "$SDK_ROOT/out/vyxc.exe" \
        "$REPO_ROOT/bootstrap_compiler/out/vyxc" \
        "$REPO_ROOT/bootstrap_compiler/out/vyxc.exe"
    do
        if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

COMPILER=$(find_zyn_vyxc) || {
    echo "zyn: could not find an SDK-local vyxc. Place vyxc under Zyn/bin, Zyn/toolchain, or build the repo-local self-host compiler output." >&2
    exit 1
}

if [ "${LLVM_ROOT:-}" = "" ] && [ -d "$REPO_ROOT/clang" ]; then
    export LLVM_ROOT="$REPO_ROOT/clang"
fi

export ZYN_SDK_ROOT="$SDK_ROOT"
export VYX_COMPILER="$COMPILER"

CLI="$SDK_ROOT/tools/zyn_cli.vyx"
if [ ! -f "$CLI" ]; then
    echo "zyn: missing CLI source: $CLI" >&2
    exit 2
fi

exec "$COMPILER" --src=file "$CLI" --run=aot -- "$@"
