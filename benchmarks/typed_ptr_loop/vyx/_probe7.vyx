module t;

struct Node {
    value: i64
    next: *mut Node
}

fn main() -> i32 {
    var n3 = Node { value: 3, next: null };
    var n2 = Node { value: 2, next: &mut n3 };
    var n1 = Node { value: 1, next: &mut n2 };
    var current: *mut Node = &mut n1;
    var count: i64 = 0;
    while (current != null) {
        (*current).value += 1;
        current = (*current).next;
        count += 1;
    }
    println("list ok: " + int_to_string(count));
    return 0;
}
