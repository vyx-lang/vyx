module t;
use std.time;

fn main() -> i32 {
    let ts = current_timestamp();
    println("timestamp=" + int_to_string(ts));
    let mono = monotonic_nanos();
    println("mono>0: " + int_to_string((mono > 0) as i64));
    let ms = clock_ms();
    println("clock_ms>0: " + int_to_string((ms > 0) as i64));
    sleep_ms(5);
    println("sleep_ms ok");
    return 0;
}
