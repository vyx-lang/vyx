module hello;
use std.time;

fn test_pointer(N: i64) -> i64 {
    unsafe{
        var value: i64 = 0;
        var volatile p1 = &mut value;
        let start = monotonic_nanos();
        for (var i = 0; i < N; i++) {
            *p1 += 1;
        }
        let end = monotonic_nanos();
        return end - start;
    }
}

fn test_direct(N: i64) -> i64 {
    let volatile value: i64 = 0;
    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        value += 1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn main() -> i32 {
    test_pointer(1000000);
    test_direct(1000000);
    let t1 = test_pointer(100000000);
    println("pointer ns=" + int_to_string(t1));
    let t2 = test_direct(100000000);
    println("direct  ns=" + int_to_string(t2));
    return 0;
}
