module t;

fn main() -> i32 {
    var arr: [i64; 4];
    arr[0] = 100; arr[1] = 200; arr[2] = 300; arr[3] = 400;
    let base: *i64 = &arr[0];

    let p1: *i64 = base.offset(1);
    println("offset(1): " + int_to_string(*p1));
    let p2: *i64 = base.add(2);
    println("add(2): " + int_to_string(*p2));
    let p3: *i64 = p2.sub(1);
    println("sub(1): " + int_to_string(*p3));

    let b1: *i64 = base.byte_offset(8);
    println("byte_offset(8): " + int_to_string(*b1));
    let b2: *i64 = base.byte_add(16);
    println("byte_add(16): " + int_to_string(*b2));
    let b3: *i64 = b2.byte_sub(8);
    println("byte_sub(8): " + int_to_string(*b3));

    let d: i64 = p2.offset_from(base);
    println("offset_from: " + int_to_string(d));
    let bd: i64 = b2.byte_offset_from(base);
    println("byte_offset_from: " + int_to_string(bd));
    return 0;
}
