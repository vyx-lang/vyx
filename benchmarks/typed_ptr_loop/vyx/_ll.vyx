module t;

class Node {
    public value: i64;
    public next: *Node;

    public static fn new(v: i64, n: *Node) -> Node {
        return Node { value: v, next: n };
    }
}

fn main() -> i32 {
    var n3 = Node.new(3, null as *Node);
    var n2 = Node.new(2, n3);
    var n1 = Node.new(1, n2);
    unsafe {
        var current: &mut Node = &mut n1;
        while (current != null) {
            current.value += 1;
            current = current.next;
        }
    }
    println("list ok: " + int_to_string(n1.value) + "," + int_to_string(n2.value) + "," + int_to_string(n3.value));
    return 0;
}
