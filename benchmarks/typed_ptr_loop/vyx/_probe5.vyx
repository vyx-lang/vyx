module t;
extern "C" {
    fn GetLocalTime(lpSystemTime: rawptr);
}
struct SysTime {
    wYear: u16;
    wMonth: u16;
    wDayOfWeek: u16;
    wDay: u16;
}
fn main() -> i32 {
    var st = SysTime{wYear:0,wMonth:0,wDayOfWeek:0,wDay:0};
    GetLocalTime(&st);
    println("year=" + int_to_string(st.wYear as i64));
    return 0;
}
