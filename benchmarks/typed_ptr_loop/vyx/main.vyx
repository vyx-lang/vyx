module typed_ptr_bench;

extern "C" { fn clock() -> i64; }

fn bench_safe(rounds: i64) -> i64 {
    var value = new i64();
    var ptr: *i64 = value;
    let start = clock();
    var i: i64 = 0;
    while (i < rounds) {
        *ptr = *ptr + 1;
        i = i + 1;
    }
    let end = clock();
    if (*ptr != rounds) { return -1; }
    delete value;
    return end - start;
}

fn bench_unsafe(rounds: i64) -> i64 {
    var value = new i64();
    var ptr: *i64 = value;
    let start = clock();
    unsafe {
        var i: i64 = 0;
        while (i < rounds) {
            *ptr = *ptr + 1;
            i = i + 1;
        }
    }
    let end = clock();
    if (*ptr != rounds) { return -1; }
    delete value;
    return end - start;
}

fn main() -> i32 {
    bench_safe(1000000);
    bench_unsafe(1000000);
    let ms1 = bench_safe(100000000);
    print("safe   pointer loop rounds=100000000 ms=" + int_to_string(ms1));
    let ms2 = bench_unsafe(100000000);
    print("unsafe pointer loop rounds=100000000 ms=" + int_to_string(ms2));
    if (ms1 < 0 || ms2 < 0) { return 1; }
    return 0;
}
