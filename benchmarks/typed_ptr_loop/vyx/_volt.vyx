module t;
use std.time;

fn bench_direct(n: i64) -> i64 {
    let volatile value: i64 = 0;
    let start = monotonic_nanos();
    var i: i64 = 0;
    while (i < n) {
        value += 1;
        i += 1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn main() -> i32 {
    println("t=" + int_to_string(bench_direct(10000000)));
    return 0;
}
