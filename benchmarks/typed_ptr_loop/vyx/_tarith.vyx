module t;
use std.time;

fn t_arith(N: i64) -> i64 {
    var volatile values: [i64; 100];
    for (var i = 0; i < 100; i++) { values[i] = 0; }
    let p: *i64 = &values[0];
    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        for (var j = 0; j < 100; j++) {
            var ptr = p + j as i64;
            *ptr += j as i64;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}

fn main() -> i32 {
    t_arith(10);
    println("ptr arith OK");
    return 0;
}
