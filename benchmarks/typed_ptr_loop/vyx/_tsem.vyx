module t;

fn main() -> i32 {
    var a: i64 = 10;
    var b: i64 = 20;
    let p1: *i64 = &mut a;
    let p2: *i64 = &mut b;
    // 比较
    if (p1 == p2) { println("eq wrong"); }
    if (p1 != p2) { println("neq OK"); }
    if (p1 == null) { println("null wrong"); }
    if (p1 != null) { println("nonnull OK"); }
    // 元素偏移
    var arr: [i64; 4];
    arr[0] = 100; arr[1] = 200; arr[2] = 300; arr[3] = 400;
    let base: *i64 = &arr[0];
    let q1 = base + 1;
    let q3 = base + 3;
    println("arr[1] via ptr: " + int_to_string(*q1));
    println("arr[3] via ptr: " + int_to_string(*q3));
    // 指针差
    let d = q3 - base;
    println("diff elems: " + int_to_string(d));
    // 反向
    let q_back = q3 - 2;
    println("back to arr[1]: " + int_to_string(*q_back));
    return 0;
}
