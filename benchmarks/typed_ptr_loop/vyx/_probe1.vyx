module t;
extern "C" {
    fn localtime_r(timer: rawptr, result: rawptr) -> rawptr;
    fn gmtime_r(timer: rawptr, result: rawptr) -> rawptr;
    fn strftime(s: rawptr, max: u64, format: rawptr, tm: rawptr) -> u64;
}
fn main() -> i32 {
    let buf: [u8; 32];
    strftime(&buf[0], 32, null, null);
    return 0;
}
