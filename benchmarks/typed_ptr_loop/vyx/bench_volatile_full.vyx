module hello;
use std.time;

// 对标 C++ volatile 基准（10 个测试）的 Vyx 等价实现。
// C++ 中 `volatile int*** p3 = &p2; p2 = &p1; p1 = &value;`
// 在 Vyx 中对应：p3 = &mut p1 的地址链。

struct Node {
    value: i64
    next: &mut Node
}

fn test_volatile_multi_pointer(N: i64) -> i64 {
    var volatile value: i64 = 0;
    var p1 = &mut value;        // &mut i64
    var p2 = &mut p1;           // &mut &mut i64
    var p3 = &mut p2;           // &mut &mut &mut i64

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        ***p3 += 1;
        **p2 += ***p3;
        *p1 += **p2;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_pointer_array(N: i64) -> i64 {
    var volatile values: [i64; 10];
    var ptrs: [*i64; 10];
    for (var i = 0; i < 10; i++) {
        values[i] = 0;
        ptrs[i] = &values[i];
    }

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        for (var j = 0; j < 10; j++) {
            *ptrs[j] += j as i64;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_direct_array(N: i64) -> i64 {
    var volatile values: [i64; 10];
    for (var i = 0; i < 10; i++) {
        values[i] = 0;
    }

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        for (var j = 0; j < 10; j++) {
            values[j] += j as i64;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_pointer_arithmetic(N: i64) -> i64 {
    var volatile values: [i64; 100];
    for (var i = 0; i < 100; i++) {
        values[i] = 0;
    }
    let p = &mut values[0];

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        for (var j = 0; j < 100; j++) {
            var ptr: &mut i64 = p + j as i64;
            *ptr += j as i64;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_direct_arithmetic(N: i64) -> i64 {
    var volatile values: [i64; 100];
    for (var i = 0; i < 100; i++) {
        values[i] = 0;
    }

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        for (var j = 0; j < 100; j++) {
            values[j] += j as i64;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_pointer_swap(N: i64) -> i64 {
    var volatile a: i64 = 1;
    var volatile b: i64 = 2;
    var p1 = &mut a;
    var p2 = &mut b;

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        let temp = p1;
        p1 = p2;
        p2 = temp;
        *p1 += *p2;
        *p2 -= *p1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_linked_list(N: i64) -> i64 {
    var node3 = Node { value: 3, next: null };
    var node2 = Node { value: 2, next: &mut node3 };
    var node1 = Node { value: 1, next: &mut node2 };
    var current: &mut Node = &mut node1;

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        while (current != null) {
            current.value += 1;
            current = current.next;
        }
        current = &mut node1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_heap_pointer(N: i64) -> i64 {
    // 堆分配 i64（volatile 限定符只支持局部变量声明；此处指针指向堆值）
    let p1 = new i64(0);

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        *p1 += 1;
    }
    let end = monotonic_nanos();

    let result = end - start;
    delete p1;
    return result;
}

fn test_volatile_stack_pointer(N: i64) -> i64 {
    let volatile value: i64 = 0;
    var p1 = &mut value;

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        *p1 += 1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn test_volatile_direct(N: i64) -> i64 {
    let volatile value: i64 = 0;

    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        value += 1;
    }
    let end = monotonic_nanos();
    return end - start;
}

fn run_benchmark(name: string, func: fn(i64) -> i64, N: i64, iterations: i64) {
    println("[enter] ${name}");
    let total: i64 = 0;
    let min_time: i64 = 999999999999;
    let max_time: i64 = 0;

    // 预热
    func(1000);

    // 正式测试
    for (var i = 0; i < iterations; i++) {
        let t = func(N);
        total += t;
        if (t < min_time) { min_time = t; }
        if (t > max_time) { max_time = t; }
    }

    let avg = total / iterations;

    println("\n${name}:");
    println("  平均: ${avg / 1000} us (${avg / 1000000} ms)");
    println("  最小: ${min_time / 1000} us");
    println("  最大: ${max_time / 1000} us");
    println("  每次迭代: ${avg / N} ns");
}

fn main() -> i32 {
    let N: i64 = 10000000;
    let iterations: i64 = 10;

    println("========== volatile 指针性能对比 ==========");
    println("循环次数: ${N}");
    println("测试次数: ${iterations}");

    run_benchmark("volatile 多级指针", test_volatile_multi_pointer, N, iterations);
    run_benchmark("volatile 指针数组", test_volatile_pointer_array, N, iterations);
    run_benchmark("volatile 直接数组", test_volatile_direct_array, N, iterations);
    run_benchmark("volatile 指针算术", test_volatile_pointer_arithmetic, N, iterations);
    run_benchmark("volatile 直接算术", test_volatile_direct_arithmetic, N, iterations);
    run_benchmark("volatile 指针交换", test_volatile_pointer_swap, N, iterations);
    run_benchmark("volatile 链表访问", test_volatile_linked_list, N, iterations);
    run_benchmark("volatile 堆指针", test_volatile_heap_pointer, N, iterations);
    run_benchmark("volatile 栈指针", test_volatile_stack_pointer, N, iterations);
    run_benchmark("volatile 直接变量", test_volatile_direct, N, iterations);

    println("\n========== 测试完成 ==========");
    return 0;
}
