module t;
use std.time;

fn main() -> i32 {
    let ns = now_nanos();
    println("now_nanos=" + int_to_string(ns));
    let secs = now_seconds();
    println("now_seconds=" + int_to_string(secs));
    let ts1 = current_timestamp();
    let ok = if (ts1 == secs) { 1 } else { 0 };
    println("wall clock consistent: " + int_to_string(ok));
    return 0;
}
