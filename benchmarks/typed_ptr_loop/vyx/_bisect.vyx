module t;
use std.time;
class Node {
    public value: i64;
    public next: *Node;
}
fn t7(N: i64) -> i64 {
    var node3 = Node.make(3, null);
    var node2 = Node.make(2, &node3);
    var node1 = Node.make(1, &node2);
    var head: *Node = &node1;
    let start = monotonic_nanos();
    for (var i = 0; i < N; i++) {
        var current = head;
        while (current != null) {
            current.value += 1;
            current = current.next;
        }
    }
    let end = monotonic_nanos();
    return end - start;
}
fn main() -> i32 { t7(10); return 0; }
