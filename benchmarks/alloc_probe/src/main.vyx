extern "C" { fn GetTickCount64() -> u64; }
fn now_ms() -> i64 { return GetTickCount64() as i64; }
const N: i64 = 2000000;
fn report(name: str, ms: i64) {
    var s = String.withCapacity(64);
    s.append(name);
    s.appendI64(ms);
    s.append(" ms");
    print(s.raw());
    s.destroy();
}
fn bench_upper() -> i64 {
    let base: str = "the quick brown fox jumps over the lazy dog 0123456789!abcdefgh";
    var sink: i64 = 0;
    let t0 = now_ms();
    var i: i64 = 0;
    while (i < N) {
        let up = base.toUpper();
        sink = sink + up.length();
        up.destroy();
        i = i + 1;
    }
    if (sink == 1) { print("impossible"); }
    return now_ms() - t0;
}
fn main() -> i32 {
    report("toUpper x2e6 : ", bench_upper());
    return 0;
}