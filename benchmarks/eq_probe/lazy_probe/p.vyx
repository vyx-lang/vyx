use std.core;
use std.collections;

class Box2<T> {
    private data: rawptr;
    private cap: i64;
    private len: i64;

    public static fn new() -> Box2<T> {
        return Box2::<T> { data: null, cap: 0, len: 0 };
    }

    public fn push(val: T) {
        let nc = if (self.cap == 0) { 4 } else { self.cap * 2 };
        let nd = realloc(self.data, nc * sizeof::<T>());
        self.data = nd;
        self.cap = nc;
        let slot = self.data + self.len * sizeof::<T>();
        memcpy(slot, to_rawptr(&val), sizeof::<T>());
        self.len = self.len + 1;
    }

    @[lazy]
    public fn get_clone(idx: i64) -> T {
        let slot = self.data + idx * sizeof::<T>();
        var out: T;
        memcpy(to_rawptr(&out), slot, sizeof::<T>());
        return out.clone();
    }

    public fn get(idx: i64) -> T {
        let slot = self.data + idx * sizeof::<T>();
        var out: T;
        memcpy(to_rawptr(&out), slot, sizeof::<T>());
        return out;
    }

    public fn size() -> i64 { return self.len; }
}

fn main() -> i32 {
    var vi = Box2::<i32>.new();
    vi.push(41);
    print("i=${vi.get_clone(0)}");

    var vs = Box2::<string>.new();
    vs.push("hello");
    let s = vs.get_clone(0);
    print("s=${s}");
    if (s == "hello" && vi.get_clone(0) == 41) { print("PASS"); return 0; }
    print("FAIL");
    return 1;
}