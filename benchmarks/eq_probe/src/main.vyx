use std.core;
use std.collections;

fn to_str(x: i32) -> string { return "n${x}"; }

fn map_to_str(v: Vec<i32>) -> Vec<string> {
    var out = Vec::<string>.new();
    var i: i64 = 0;
    while (i < v.size()) {
        out.push(to_str(v.get(i)));
        i = i + 1;
    }
    return out;
}

fn make_123() -> Vec<i32> {
    var v = Vec::<i32>.new();
    v.push(1); v.push(2); v.push(3);
    return v;
}

fn main() -> i32 {
    var r = map_to_str(make_123());
    print("g0=${r.get(0)}");
    if (r.size() == 3 && r.get(0) == "n1" && r.get(2) == "n3") { print("PASS"); return 0; }
    print("FAIL");
    return 1;
}