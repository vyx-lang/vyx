module memory_unique_bench;

use std.ref;

struct Payload {
    left: i64;
    right: i64;
    stamp: i64;
    guard: i64;
}

fn main() -> i32 {
    let prime: i64 = 1000000007;
    var checksum: i64 = 23;
    for (i in 0..5000000) {
        let owner = Box::<Payload>.new(Payload {
            left: i,
            right: (i * 7 + 3) % prime,
            stamp: i * 13 + 5,
            guard: i % 113,
        });
        var value = owner.deref();
        value.left = (value.left + value.stamp + 19) % prime;
        value.right = (value.right * 3 + value.left) % prime;
        owner.set(value);
        let observed = owner.deref();
        if (observed.guard != i % 113 || observed.left != (i + i * 13 + 5 + 19) % prime) {
            return 1;
        }
        checksum = (checksum * 131 + observed.left * 3 + observed.right * 5
            + observed.stamp * 7 + observed.guard) % prime;
    }
    if (checksum != 838378122) { return 1; }
    print("memory_unique total=${checksum}");
    return 0;
}
