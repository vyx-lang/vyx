module vec_heavy;

use std.collections;
use std.algorithm;
use std.hash;

/// 大规模 Vec 排序 + 多趟扫描
/// n = 500_000 元素，sort + 3 趟 reduce
public fn vec_sort_reduce(n: i64) -> i64 {
    var v = Vec::<i64>.with_capacity(n);
    var i: i64 = 0;
    while (i < n) {
        // xorshift-like 伪随机，保证分布均匀
        let x = ((i * 6364136223846793005 + 1442695040888963407) ^ (i * 2654435761)) % 1000000007;
        v.push_unchecked(x);
        i = i + 1;
    }
    if (v.size() != n) { panic("vec_sort_reduce: size invariant failed"); }

    // 用 algorithm 模块的迭代版 sort（中位数枢轴，O(log n) 栈深）
    sort::<i64>(v);
    if (!is_sorted(v)) { panic("vec_sort_reduce: sort order violation"); }

    // 趟1：前缀和 mod p
    var sum1: i64 = 0;
    i = 0;
    while (i < v.len) {
        sum1 = (sum1 + v.get_unchecked(i) * ((i % 17) + 1)) % 1000000007;
        i = i + 1;
    }

    // 趟2：二分查找 10000 次
    var hits: i64 = 0;
    i = 0;
    while (i < 10000) {
        let needle = (i * 99991) % 1000000007;
        let pos = binary_search::<i64>(v, needle);
        if (pos >= 0) { hits = hits + 1; }
        i = i + 1;
    }

    // 趟3：相邻差分累加
    var diff_sum: i64 = 0;
    i = 1;
    while (i < v.len) {
        diff_sum = (diff_sum + v.get_unchecked(i) - v.get_unchecked(i - 1)) % 1000000007;
        i = i + 1;
    }

    v.destroy();
    return (sum1 + hits * 1000 + diff_sum) % 1000000007;
}

/// 大规模 Vec 多路归并模拟：4 路各 200_000 元素，归并后验证有序
public fn vec_merge_sorted(n: i64) -> i64 {
    let part = n / 4;

    var a = Vec::<i64>.with_capacity(part);
    var b = Vec::<i64>.with_capacity(part);
    var c = Vec::<i64>.with_capacity(part);
    var d = Vec::<i64>.with_capacity(part);

    var i: i64 = 0;
    while (i < part) {
        a.push_unchecked((i * 4 + 0) % 1000003);
        b.push_unchecked((i * 4 + 1) % 1000003);
        c.push_unchecked((i * 4 + 2) % 1000003);
        d.push_unchecked((i * 4 + 3) % 1000003);
        i = i + 1;
    }
    if (a.size() != part || b.size() != part || c.size() != part || d.size() != part) {
        panic("vec_merge_sorted: partition size invariant failed");
    }
    sort::<i64>(a);
    sort::<i64>(b);
    sort::<i64>(c);
    sort::<i64>(d);

    // 两两归并 a+b -> ab, c+d -> cd, ab+cd -> result
    var ab = Vec::<i64>.with_capacity(part * 2);
    var ia: i64 = 0;
    var ib: i64 = 0;
    while (ia < a.len && ib < b.len) {
        if (a.get_unchecked(ia) <= b.get_unchecked(ib)) {
            ab.push_unchecked(a.get_unchecked(ia)); ia = ia + 1;
        } else {
            ab.push_unchecked(b.get_unchecked(ib)); ib = ib + 1;
        }
    }
    while (ia < a.len) { ab.push_unchecked(a.get_unchecked(ia)); ia = ia + 1; }
    while (ib < b.len) { ab.push_unchecked(b.get_unchecked(ib)); ib = ib + 1; }

    var cd = Vec::<i64>.with_capacity(part * 2);
    var ic: i64 = 0;
    var id: i64 = 0;
    while (ic < c.len && id < d.len) {
        if (c.get_unchecked(ic) <= d.get_unchecked(id)) {
            cd.push_unchecked(c.get_unchecked(ic)); ic = ic + 1;
        } else {
            cd.push_unchecked(d.get_unchecked(id)); id = id + 1;
        }
    }
    while (ic < c.len) { cd.push_unchecked(c.get_unchecked(ic)); ic = ic + 1; }
    while (id < d.len) { cd.push_unchecked(d.get_unchecked(id)); id = id + 1; }

    var result = Vec::<i64>.with_capacity(n);
    var iab: i64 = 0;
    var icd: i64 = 0;
    while (iab < ab.len && icd < cd.len) {
        if (ab.get_unchecked(iab) <= cd.get_unchecked(icd)) {
            result.push_unchecked(ab.get_unchecked(iab)); iab = iab + 1;
        } else {
            result.push_unchecked(cd.get_unchecked(icd)); icd = icd + 1;
        }
    }
    while (iab < ab.len) { result.push_unchecked(ab.get_unchecked(iab)); iab = iab + 1; }
    while (icd < cd.len) { result.push_unchecked(cd.get_unchecked(icd)); icd = icd + 1; }
    if (result.size() != n) { panic("vec_merge_sorted: result size invariant failed"); }

    // 验证有序 + 计算 checksum
    var checksum: i64 = 0;
    var ordered: i64 = 1;
    i = 1;
    while (i < result.len) {
        if (result.get_unchecked(i) < result.get_unchecked(i - 1)) { ordered = 0; }
        checksum = (checksum + result.get_unchecked(i) * ((i % 13) + 1)) % 1000000007;
        i = i + 1;
    }

    a.destroy(); b.destroy(); c.destroy(); d.destroy();
    ab.destroy(); cd.destroy(); result.destroy();
    return checksum + ordered;
}
