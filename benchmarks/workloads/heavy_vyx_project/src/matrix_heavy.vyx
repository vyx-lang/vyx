module matrix_heavy;

use std.collections;

/// 大规模整数矩阵乘法 (mod p)
/// A[n×n] × B[n×n] → C[n×n]，n=256，约 1600 万次乘加
public fn matrix_mul(n: i64) -> i64 {
    let size = n * n;
    var a = Vec::<i64>.with_capacity(size);
    var b = Vec::<i64>.with_capacity(size);
    var c = Vec::<i64>.with_capacity(size);

    // 初始化 A, B
    var i: i64 = 0;
    while (i < size) {
        a.push_unchecked((i * 48271 + 17) % 1009);
        b.push_unchecked((i * 69621 + 31) % 1013);
        c.push_unchecked(0);
        i = i + 1;
    }
    if (a.size() != size || b.size() != size || c.size() != size) {
        panic("matrix_mul: matrix size invariant failed");
    }

    // C = A × B mod 1_000_000_007
    var row: i64 = 0;
    while (row < n) {
        var col: i64 = 0;
        while (col < n) {
            var acc: i64 = 0;
            var k: i64 = 0;
            while (k < n) {
                acc = (acc + a.get_unchecked(row * n + k) * b.get_unchecked(k * n + col)) % 1000000007;
                k = k + 1;
            }
            c.set_unchecked(row * n + col, acc);
            col = col + 1;
        }
        row = row + 1;
    }

    // checksum：对角线 + 反对角线
    var checksum: i64 = 0;
    i = 0;
    while (i < n) {
        checksum = (checksum + c.get_unchecked(i * n + i)) % 1000000007;
        checksum = (checksum + c.get_unchecked(i * n + (n - 1 - i))) % 1000000007;
        i = i + 1;
    }

    a.destroy(); b.destroy(); c.destroy();
    return checksum;
}

/// 矩阵快速幂：M^k mod p，M 为 4×4，k=1_000_000
public fn matrix_pow(k: i64) -> i64 {
    let n: i64 = 4;
    let size = n * n;
    let p: i64 = 1000000007;

    // 初始矩阵 M
    var base: [i64; 16];
    base[0] = 1; base[1] = 1; base[2] = 0; base[3] = 0;
    base[4] = 1; base[5] = 0; base[6] = 1; base[7] = 0;
    base[8] = 0; base[9] = 1; base[10] = 0; base[11] = 1;
    base[12] = 0; base[13] = 0; base[14] = 1; base[15] = 1;

    // 单位矩阵 result
    var result: [i64; 16];
    var i: i64 = 0;
    while (i < size) {
        let row = i / n;
        let col = i % n;
        if (row == col) { result[i] = 1; }
        else { result[i] = 0; }
        i = i + 1;
    }

    var tmp: [i64; 16];
    i = 0;
    while (i < size) { tmp[i] = 0; i = i + 1; }

    var exp = k;
    while (exp > 0) {
        if ((exp & 1) == 1) {
            // result = result × base
            var r: i64 = 0;
            while (r < n) {
                var c: i64 = 0;
                while (c < n) {
                    var acc: i64 = 0;
                    var kk: i64 = 0;
                    while (kk < n) {
                        acc = (acc + result[r * n + kk] * base[kk * n + c]) % p;
                        kk = kk + 1;
                    }
                    tmp[r * n + c] = acc;
                    c = c + 1;
                }
                r = r + 1;
            }
            // swap result <-> tmp
            var j: i64 = 0;
            while (j < size) {
                let tv = tmp[j];
                let rv = result[j];
                result[j] = tv;
                tmp[j] = rv;
                j = j + 1;
            }
        }
        // base = base × base
        var r: i64 = 0;
        while (r < n) {
            var c: i64 = 0;
            while (c < n) {
                var acc: i64 = 0;
                var kk: i64 = 0;
                while (kk < n) {
                    acc = (acc + base[r * n + kk] * base[kk * n + c]) % p;
                    kk = kk + 1;
                }
                tmp[r * n + c] = acc;
                c = c + 1;
            }
            r = r + 1;
        }
        var j: i64 = 0;
        while (j < size) {
            let tv = tmp[j];
            let bv = base[j];
            base[j] = tv;
            tmp[j] = bv;
            j = j + 1;
        }
        exp = exp >> 1;
    }

    var checksum: i64 = 0;
    i = 0;
    while (i < size) {
        checksum = (checksum + result[i] * ((i % 5) + 1)) % p;
        i = i + 1;
    }

    return checksum;
}
