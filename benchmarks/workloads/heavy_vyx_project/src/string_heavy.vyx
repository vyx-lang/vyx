module string_heavy;

use std.string;
use std.collections;
use std.algorithm;

/// 大规模字符串构建：100_000 次 append，总长度约 1MB
public fn string_build_large(n: i64) -> i64 {
    var sb = StringBuilder.withCapacity(n * 16);
    var i: i64 = 0;
    while (i < n) {
        sb.append("entry-");
        sb.appendInt(i);
        sb.append(":");
        sb.appendInt((i * 48271 + 17) % 999983);
        sb.append(";");
        i = i + 1;
    }
    let s = sb.intoString();
    let result = s.len;
    return result;
}

/// 大规模字符串扫描：对 build_large 的输出做字符频率统计
public fn string_scan_large(n: i64) -> i64 {
    var sb = StringBuilder.withCapacity(n * 16);
    var i: i64 = 0;
    while (i < n) {
        sb.append("entry-");
        sb.appendInt(i);
        sb.append(":");
        sb.appendInt((i * 48271 + 17) % 999983);
        sb.append(";");
        i = i + 1;
    }
    let s = sb.intoString();

    // 字符频率统计（256 桶）
    var freq = Vec::<i64>.with_capacity(256);
    var j: i64 = 0;
    while (j < 256) { freq.push_unchecked(0); j = j + 1; }

    j = 0;
    while (j < s.len) {
        let c = str_byte_at_unchecked(s, j);
        freq.set_unchecked(c, freq.get_unchecked(c) + 1);
        j = j + 1;
    }

    // checksum
    var checksum: i64 = 0;
    j = 0;
    while (j < 256) {
        checksum = (checksum + freq.get_unchecked(j) * ((j % 17) + 1)) % 1000000007;
        j = j + 1;
    }

    freq.destroy();
    return checksum;
}

/// 大规模字符串 Vec：存储 50_000 个字符串，排序后验证
public fn string_vec_sort(n: i64) -> i64 {
    var v = Vec::<string>.with_capacity(n);
    var i: i64 = 0;
    while (i < n) {
        var sb = StringBuilder.create();
        // 用 padding 让字符串长度均匀分布，增加比较开销
        let val = (i * 6364136223846793005 + 1442695040888963407) % 999983;
        sb.append("str_");
        sb.appendInt(val);
        sb.append("_");
        sb.appendInt(i);
        // `string` is a borrowed str view. Keep an independent owned copy in
        // the Vec so later StringBuilder instances cannot invalidate it.
        let built = sb.intoString();
        let text = built.raw().clone();
        v.push_unchecked(text);
        i = i + 1;
    }

    // 用 algorithm 模块的迭代版 sort（对 string 走 str_compare 路径）
    sort::<string>(v);

    // 验证有序 + checksum（取每个字符串长度）
    var checksum: i64 = 0;
    var ordered: i64 = 1;
    i = 1;
    while (i < v.len) {
        let a = v.get_unchecked(i - 1);
        let b = v.get_unchecked(i);
        if (str_compare(a, b) > 0) { ordered = 0; }
        checksum = (checksum + b.len * ((i % 13) + 1)) % 1000000007;
        i = i + 1;
    }

    i = 0;
    while (i < v.len) {
        str_drop(v.get_unchecked(i));
        i = i + 1;
    }
    v.destroy();
    return checksum + ordered;
}
