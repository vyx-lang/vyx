module heavy_bench;

import vec_heavy;
import hashmap_heavy;
import matrix_heavy;
import string_heavy;

fn main() -> i32 {
    // Vec 大规模排序 + 扫描：500_000 元素
    let vec_sort   = vec_sort_reduce(500000);
    // Vec 4路归并：800_000 元素（4×200_000）
    let vec_merge  = vec_merge_sorted(800000);
    // HashMap i64 key：200_000 插入 + 400_000 查询 + 200_000 更新
    let hmap_int   = hashmap_int_stress(200000);
    // HashMap string key：80_000 插入 + 查询
    let hmap_str   = hashmap_string_stress(80000);
    // 矩阵乘法 256×256
    let mat_mul    = matrix_mul(256);
    // 矩阵快速幂 4×4，k=1_000_000
    let mat_pow    = matrix_pow(1000000);
    // 字符串大规模构建：100_000 条目
    let str_build  = string_build_large(100000);
    // 字符串大规模扫描：50_000 条目
    let str_scan   = string_scan_large(50000);
    // 字符串 Vec 排序：50_000 字符串
    let str_sort   = string_vec_sort(50000);

    if (vec_sort != 777956373 || vec_merge != 991584335
        || hmap_int != 55567056 || hmap_str != 602159565
        || mat_mul != 456654910 || mat_pow != 364827586
        || str_build != 1877777 || str_scan != 8359923
        || str_sort != 5657112) { return 1; }

    print("runtime vec_sort=${vec_sort} vec_merge=${vec_merge} hmap_int=${hmap_int} hmap_str=${hmap_str} mat_mul=${mat_mul} mat_pow=${mat_pow} str_build=${str_build} str_scan=${str_scan} str_sort=${str_sort}");
    return 0;
}
