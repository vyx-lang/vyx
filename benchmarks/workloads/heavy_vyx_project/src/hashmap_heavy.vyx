module hashmap_heavy;

use std.collections;
use std.string;

/// HashMap 大规模插入 + 查询 + 更新
/// n = 200_000 key，每个 key 查询 3 次，更新 1 次
public fn hashmap_int_stress(n: i64) -> i64 {
    var m = HashMap::<i64, i64>.with_capacity(n * 2);

    // 插入阶段
    var i: i64 = 0;
    while (i < n) {
        let key = (i * 2654435761) ^ (i >> 16);
        let val = (i * 6364136223846793005 + 1) % 1000000007;
        m.put(key, val);
        i = i + 1;
    }
    if (m.size() != n) { panic("hashmap_int_stress: size invariant failed"); }

    // 查询阶段：命中 + 未命中各半
    var hits: i64 = 0;
    var checksum: i64 = 0;
    i = 0;
    while (i < n * 2) {
        let key = (i * 2654435761) ^ (i >> 16);
        match (m.try_get(key)) {
            case Some(v) => {
                hits = hits + 1;
                checksum = (checksum + v) % 1000000007;
            }
            case None => {}
        }
        i = i + 1;
    }
    if (hits != n) { panic("hashmap_int_stress: lookup hit invariant failed"); }

    // 更新阶段：对所有已有 key 累加
    i = 0;
    while (i < n) {
        let key = (i * 2654435761) ^ (i >> 16);
        match (m.try_get(key)) {
            case Some(v) => {
                m.put(key, (v + i) % 1000000007);
            }
            case None => {}
        }
        i = i + 1;
    }

    // 最终 checksum
    var final_sum: i64 = 0;
    i = 0;
    while (i < n) {
        let key = (i * 2654435761) ^ (i >> 16);
        match (m.try_get(key)) {
            case Some(v) => {
                final_sum = (final_sum + v * ((i % 7) + 1)) % 1000000007;
            }
            case None => {}
        }
        i = i + 1;
    }

    m.destroy();
    return (hits * 1000 + checksum + final_sum) % 1000000007;
}

/// HashMap<string, i64>：字符串 key 大规模操作
/// n = 80_000 key
public fn hashmap_string_stress(n: i64) -> i64 {
    var m = HashMap::<string, i64>.with_capacity(n * 2);

    // 插入
    var i: i64 = 0;
    while (i < n) {
        var sb = StringBuilder.create();
        sb.append("key_");
        sb.appendInt(i);
        sb.append("_");
        sb.appendInt((i * 48271) % 99991);
        let built = sb.intoString();
        let key = built.raw().clone();
        m.put(key, i * 3 + 7);
        i = i + 1;
    }
    if (m.size() != n) { panic("hashmap_string_stress: size invariant failed"); }

    // 查询
    var checksum: i64 = 0;
    i = 0;
    while (i < n) {
        var sb = StringBuilder.create();
        sb.append("key_");
        sb.appendInt(i);
        sb.append("_");
        sb.appendInt((i * 48271) % 99991);
        let built = sb.intoString();
        let key = built.raw();
        match (m.try_get(key)) {
            case Some(v) => {
                checksum = (checksum + v * ((i % 11) + 1)) % 1000000007;
            }
            case None => {}
        }
        i = i + 1;
    }

    // Dict stores key bytes, so release the owned cloned str buffers before
    // freeing the table itself. This keeps teardown work comparable to C++.
    var stored_keys = m.keys();
    i = 0;
    while (i < stored_keys.size()) {
        str_drop(stored_keys.get_unchecked(i));
        i = i + 1;
    }
    stored_keys.destroy();
    m.destroy();
    return checksum;
}
