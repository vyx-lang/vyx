module type_abstraction_bench;

trait Stepper {
    fn step(self, x: i64) -> i64;
}

struct AddStepper { delta: i64; }
struct MixStepper { factor: i64; }

impl Stepper for AddStepper {
    fn step(self, x: i64) -> i64 { return x + self.delta; }
}

impl Stepper for MixStepper {
    fn step(self, x: i64) -> i64 { return x * self.factor + 17; }
}

fn generic_step<T>(stepper: T, x: i64) -> i64 where T: Stepper {
    return stepper.step(x);
}

@[noinline]
fn dynamic_step(stepper: dyn Stepper, x: i64) -> i64 {
    return stepper.step(x);
}

fn generic_static(n: i64) -> i64 {
    let stepper = AddStepper { delta: 7 };
    let prime: i64 = 1000000007;
    var checksum: i64 = 41;
    for (i in 0..n) {
        let value = generic_step(stepper, i);
        if (value != i + 7) { return -1; }
        checksum = (checksum * 131 + value * 3 + i) % prime;
    }
    return checksum;
}

fn concrete_trait(n: i64) -> i64 {
    let stepper = MixStepper { factor: 3 };
    let prime: i64 = 1000000007;
    var checksum: i64 = 43;
    for (i in 0..n) {
        let value = stepper.step(i);
        if (value != i * 3 + 17) { return -1; }
        checksum = (checksum * 131 + value * 5 + i * 2) % prime;
    }
    return checksum;
}

fn dynamic_trait(n: i64) -> i64 {
    let add = AddStepper { delta: 7 };
    let mix = MixStepper { factor: 3 };
    // Materialize both trait objects once. This loop measures dispatch, not
    // repeated concrete-to-dyn allocation.
    let add_dyn = add as dyn Stepper;
    let mix_dyn = mix as dyn Stepper;
    let prime: i64 = 1000000007;
    var checksum: i64 = 47;
    for (i in 0..n) {
        let use_add = ((i + checksum) % 3) == 0;
        let selected = if (use_add) { add_dyn } else { mix_dyn };
        let value = dynamic_step(selected, i);
        if (use_add) {
            if (value != i + 7) { return -1; }
        } else {
            if (value != i * 3 + 17) { return -1; }
        }
        checksum = (checksum * 131 + value * 7 + i * 3) % prime;
    }
    return checksum;
}

fn main() -> i32 {
    let generic = generic_static(30000000);
    let concrete = concrete_trait(30000000);
    let dynamic = dynamic_trait(40000000);
    if (generic != 198010502 || concrete != 635720229 || dynamic != 902501151) { return 1; }
    print("runtime generic=${generic} concrete=${concrete} dynamic=${dynamic}");
    return 0;
}
