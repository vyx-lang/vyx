module bench_generics;

import generic_work;

fn main() -> i32 {
    let minmax = generic_minmax_pipeline();
    // 100,000,000 loop iterations across the two generic batch paths.
    let batch = generic_batch(60000000);
    let nested = generic_nested_batch(40000000);
    if (minmax != 1097579249 || batch != 932200007 || nested != 926400007) { return 1; }
    print("runtime minmax=${minmax} batch=${batch} nested=${nested}");
    return 0;
}
