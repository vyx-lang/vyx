module generic_work;

use std.hash;

// This is a value aggregate, matching the C++ benchmark's `struct Pair<T>`.
// Keep reference/heap identity benchmarks in memory_model instead of folding
// allocator cost into the generic-instantiation comparison.
struct Pair<T> {
    public left: T;
    public right: T;
}

fn make_pair<T>(left: T, right: T) -> Pair<T> {
    return Pair<T> { left: left, right: right };
}

fn min_value<T>(a: T, b: T) -> T where T: Ord {
    if (a.compare(b) < 0) { return a; }
    return b;
}

fn max_value<T>(a: T, b: T) -> T where T: Ord {
    if (a.compare(b) > 0) { return a; }
    return b;
}

fn fold_i64(n: i64) -> i64 {
    var low: i64 = 1000000;
    var high: i64 = -1000000;
    var checksum: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        let x = (i * 48271 + 13) % 200003 - 100001;
        low = min_value::<i64>(low, x);
        high = max_value::<i64>(high, x);
        checksum = (checksum + (high - low) + x) % 1000000007;
        i = i + 1;
    }
    return checksum + low + high;
}

fn fold_i32(n: i32) -> i32 {
    var low: i32 = 1000000;
    var high: i32 = -1000000;
    var checksum: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        let x = (i * 7919 + 23) % 100003 - 50001;
        low = min_value::<i32>(low, x);
        high = max_value::<i32>(high, x);
        checksum = (checksum + (high - low) + x) % 1000000007;
        i = i + 1;
    }
    return checksum + low + high;
}

public fn generic_minmax_pipeline() -> i64 {
    return fold_i64(16000) + fold_i32(9000) as i64;
}

fn pair_sum(p: Pair<i64>) -> i64 {
    return p.left + p.right;
}

public fn generic_batch(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        let p = make_pair::<i64>(i, i * 2 + 1);
        acc = (acc + pair_sum(p)) % 1000000007;
        i = i + 1;
    }
    return acc;
}

fn nested_pair_sum(p: Pair<Pair<i64>>) -> i64 {
    return p.left.left + p.left.right + p.right.left + p.right.right;
}

public fn generic_nested_batch(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        let left = make_pair::<i64>(i, i + 1);
        let right = make_pair::<i64>(i * 2, i * 2 + 1);
        let outer = make_pair::<Pair<i64>>(left, right);
        acc = (acc + nested_pair_sum(outer)) % 1000000007;
        i = i + 1;
    }
    return acc;
}
