module bench_strings;

import string_work;

fn main() -> i32 {
    if (string_ops(1) != 12
        || ascii_token_scan(1) != 934
        || string_transform(1) != 4) {
        return 1;
    }

    let ops = string_ops(80000);
    // These fixed-size strings drive more than 100M bytes through the
    // scanner and transformation paths without retaining an unbounded set
    // of allocations.
    let scan = ascii_token_scan(5000000);
    let transform = string_transform(3000000);
    if (ops != 708886 || scan != 344751141 || transform != 28888890) {
        return 1;
    }
    print("runtime string_ops=${ops} scan=${scan} transform=${transform}");
    return 0;
}
