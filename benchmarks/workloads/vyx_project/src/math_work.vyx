module math_work;

public fn mix_round(seed: i64, rounds: i64) -> i64 {
    var x: i64 = seed;
    for (i in 0..rounds) {
        x = (x * 1103515245 + 12345) % 2147483647;
        x = (x ^ (x / 7)) % 2147483647;
        x = (x + i * 31) % 2147483647;
    }
    return x;
}

public fn math_batch(n: i64) -> i64 {
    var total: i64 = 0;
    for (i in 0..n) {
        total = total + mix_round(i + 11, 24);
    }
    return total;
}

fn gcd(mut_a: i64, mut_b: i64) -> i64 {
    var a: i64 = mut_a;
    var b: i64 = mut_b;
    while (b != 0) {
        let r = a % b;
        a = b;
        b = r;
    }
    return a;
}

public fn gcd_batch(n: i64) -> i64 {
    var total: i64 = 0;
    for (i in 1..=n) {
        let a = (i * 48271 + 17) % 1000003 + 1;
        let b = (i * 69621 + 31) % 1000033 + 1;
        total = (total + gcd(a, b) * ((i % 13) + 1)) % 1000000007;
    }
    return total;
}

public fn poly_batch(n: i64) -> i64 {
    var acc: i64 = 19;
    for (i in 0..n) {
        let x = (i * 48271 + 12345) % 100003;
        let y = (x * x + 3 * x + 7) % 1000003;
        acc = (acc * 131 + y * ((i % 17) + 1)) % 1000000007;
    }
    return acc;
}
