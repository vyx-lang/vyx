module generic_work;

class Pair<T> {
    public left: T;
    public right: T;
}

public fn make_pair<T>(left: T, right: T) -> Pair<T> {
    return Pair<T> { left: left, right: right };
}

public fn pair_sum(p: Pair<i64>) -> i64 {
    return p.left + p.right;
}

public fn generic_batch(n: i64) -> i64 {
    var total: i64 = 0;
    for (i in 0..n) {
        let p = make_pair::<i64>(i, i * 3);
        total = total + pair_sum(p);
    }
    return total;
}

public fn nested_pair_sum(p: Pair<Pair<i64>>) -> i64 {
    return p.left.left + p.left.right + p.right.left + p.right.right;
}

public fn generic_nested_batch(n: i64) -> i64 {
    var total: i64 = 0;
    for (i in 0..n) {
        let left = make_pair::<i64>(i, i * 2 + 1);
        let right = make_pair::<i64>(i * 3 + 2, i * 5 + 3);
        let nested = make_pair::<Pair<i64>>(left, right);
        total = (total + nested_pair_sum(nested) * ((i % 7) + 1)) % 1000000007;
    }
    return total;
}
