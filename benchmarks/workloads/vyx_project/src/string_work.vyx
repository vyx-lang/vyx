module string_work;

use std.string;

public fn string_batch(n: i64) -> i64 {
    var s = String.withCapacity(4097);
    s.append("bench");
    for (i in 0..n) {
        s.append("-");
        s.append(i.toString());
        if (s.length() > 4096) {
            s = s.substring(0, 128);
        }
    }
    return s.length();
}

public fn label_value(prefix: string, value: i64) -> string {
    return prefix + ":" + value.toString();
}

public fn string_scan_batch(n: i64) -> i64 {
    var total: i64 = 0;
    var digits: i64 = 0;
    var alpha: i64 = 0;
    var s = String.withCapacity(32);
    for (i in 0..n) {
        s.clear();
        s.append("key-");
        s.append(i.toString());
        s.append("-value-");
        s.append(((i * 37) % 1009).toString());
        for (c in s) {
            if (c >= '0' && c <= '9') {
                digits = digits + 1;
                total = (total + (c as i64 - '0' as i64) * 3) % 1000000007;
            } else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                alpha = alpha + 1;
                total = (total + c as i64) % 1000000007;
            } else {
                total = (total + 17) % 1000000007;
            }
        }
    }
    return (total + digits * 31 + alpha * 17) % 1000000007;
}
