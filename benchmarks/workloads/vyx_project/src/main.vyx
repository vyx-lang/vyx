module main;

use math_work;
use string_work;
use generic_work;

fn main() -> i32 {
    if (math_batch(0) != 0
        || string_batch(0) != 5
        || generic_batch(0) != 0
        || gcd_batch(0) != 0
        || poly_batch(0) != 19
        || string_scan_batch(0) != 0
        || generic_nested_batch(0) != 0) {
        return 2;
    }

    let a = math_batch(16000);
    let b = string_batch(6000);
    let c = generic_batch(40000);
    let d = gcd_batch(12000);
    let e = poly_batch(18000);
    let f = string_scan_batch(5000);
    let g = generic_nested_batch(24000);
    if (a != 16268912790390 || b != 1103 || c != 3199920000
        || d != 506485 || e != 145647344 || f != 6753813
        || g != 671519924) {
        return 1;
    }
    let extra = (d + e + f + g) % 1000000007;
    let label = label_value("score", a + b + c + extra);
    if (label.len == 0) { return 1; }
    print("runtime math=${a} string=${b} generic=${c} gcd=${d} poly=${e} scan=${f} nested=${g} label=${label}");
    return 0;
}
