module collections_work;

use std.core;
use std.collections;
use std.algorithm;

public fn vec_generic(n: i64) -> i64 {
    var v = Vec::<i64>.with_capacity(n);
    var i: i64 = 0;
    while (i < n) {
        v.push_unchecked((i * 17 + 3) % 100000);
        i = i + 1;
    }
    if (v.size() != n) { panic("vec_generic: size invariant failed"); }
    var sum: i64 = 0;
    i = 0;
    for (x in v) {
        sum = (sum + x * ((i % 11) + 1)) % 1000000007;
        i = i + 1;
    }
    return sum + v.size();
}

public fn vec_sort_search(n: i64, probes: i64) -> i64 {
    var v = Vec::<i64>.with_capacity(n);
    var i: i64 = 0;
    while (i < n) {
        v.push_unchecked((i * 48271 + 17) % 100003);
        i = i + 1;
    }
    if (v.size() != n) { panic("vec_sort_search: size invariant failed"); }

    sort(v);

    if (!is_sorted(v)) { panic("vec_sort_search: sort order violation"); }

    var hits: i64 = 0;
    var checksum: i64 = 0;
    i = 0;
    while (i < probes) {
        let needle = (i * 97) % 100003;
        let pos = binary_search::<i64>(v, needle);
        if (pos >= 0) {
            hits = hits + 1;
            checksum = (checksum + v.get_unchecked(pos)) % 1000000007;
        }
        i = i + 1;
    }

    return v.size() + v.get_unchecked(0) + v.get_unchecked(v.size() - 1) + hits + checksum;
}
