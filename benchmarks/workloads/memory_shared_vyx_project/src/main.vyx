module memory_shared_bench;

use std.ref;

struct Payload {
    left: i64;
    right: i64;
    stamp: i64;
}

fn main() -> i32 {
    let prime: i64 = 1000000007;
    var checksum: i64 = 31;
    for (i in 0..5000000) {
        let owner = Ref::<Payload>.new(Payload {
            left: i,
            right: (i * 11 + 5) % prime,
            stamp: i * 17 + 9,
        });
        if (owner.count() != 1) { return 1; }
        {
            let first = owner.clone();
            if (owner.count() != 2) { return 2; }
            {
                let second = first.clone();
                if (owner.count() != 3) { return 3; }
                let value = second.deref();
                checksum = (checksum * 131 + value.left * 3 + value.right * 5
                    + value.stamp * 7 + owner.count()) % prime;
            }
            if (owner.count() != 2) { return 4; }
            let value = first.deref();
            checksum = (checksum * 131 + value.left * 11 + value.right * 13
                + value.stamp * 17 + owner.count()) % prime;
        }
        if (owner.count() != 1) { return 5; }
    }
    if (checksum != 399739965) { return 6; }
    print("memory_shared total=${checksum}");
    return 0;
}
