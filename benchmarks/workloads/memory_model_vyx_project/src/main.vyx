module memory_model_bench;

use std.ref;

struct ValuePayload {
    left: i64;
    right: i64;
    stamp: i64;
    guard: i64;
}

struct OwnerPayload {
    left: i64;
    right: i64;
    stamp: i64;
    guard: i64;
}

struct SharedPayload {
    left: i64;
    right: i64;
    stamp: i64;
}

fn value_semantics(n: i64) -> i64 {
    let prime: i64 = 1000000007;
    var checksum: i64 = 17;
    var state: i64 = 29;
    for (i in 0..n) {
        let source = ValuePayload {
            left: i,
            right: (i * 3 + 1) % prime,
            stamp: state,
            guard: i % 97,
        };
        var copied = source;
        copied.left = (copied.left + copied.stamp + 11) % prime;
        copied.right = (copied.right * 5 + copied.left + 7) % prime;
        if (source.left != i || source.guard != i % 97) { return -1; }
        state = (state * 33 + copied.right + source.stamp) % prime;
        checksum = (checksum * 131 + source.left * 3 + source.right * 5
            + copied.left * 7 + copied.right * 11 + copied.guard) % prime;
    }
    return checksum;
}

fn unique_heap(n: i64) -> i64 {
    let prime: i64 = 1000000007;
    var checksum: i64 = 23;
    for (i in 0..n) {
        let owner = Box::<OwnerPayload>.new(OwnerPayload {
            left: i,
            right: (i * 7 + 3) % prime,
            stamp: i * 13 + 5,
            guard: i % 113,
        });
        var value = owner.deref();
        value.left = (value.left + value.stamp + 19) % prime;
        value.right = (value.right * 3 + value.left) % prime;
        owner.set(value);
        let observed = owner.deref();
        if (observed.guard != i % 113
            || observed.left != (i + i * 13 + 5 + 19) % prime) { return -1; }
        checksum = (checksum * 131 + observed.left * 3 + observed.right * 5
            + observed.stamp * 7 + observed.guard) % prime;
    }
    return checksum;
}

fn shared_refcount(n: i64) -> i64 {
    let prime: i64 = 1000000007;
    var checksum: i64 = 31;
    for (i in 0..n) {
        let owner = Ref::<SharedPayload>.new(SharedPayload {
            left: i,
            right: (i * 11 + 5) % prime,
            stamp: i * 17 + 9,
        });
        if (owner.count() != 1) { return -1; }
        {
            let first = owner.clone();
            if (owner.count() != 2) { return -1; }
            {
                let second = first.clone();
                if (owner.count() != 3) { return -1; }
                let value = second.deref();
                checksum = (checksum * 131 + value.left * 3 + value.right * 5
                    + value.stamp * 7 + owner.count()) % prime;
            }
            if (owner.count() != 2) { return -1; }
            let value = first.deref();
            checksum = (checksum * 131 + value.left * 11 + value.right * 13
                + value.stamp * 17 + owner.count()) % prime;
        }
        if (owner.count() != 1) { return -1; }
    }
    return checksum;
}

fn main() -> i32 {
    let value = value_semantics(100000000);
    let unique = unique_heap(5000000);
    let shared = shared_refcount(5000000);
    if (value != 682325596 || unique != 838378122 || shared != 399739965) { return 1; }
    print("runtime value=${value} unique=${unique} shared=${shared}");
    return 0;
}
