module ida_reverse_comparison;

fn hex_nibble(ch: i32) -> i32 {
    if (ch >= 48 && ch <= 57) { return ch - 48; }
    if (ch >= 97 && ch <= 102) { return ch - 97 + 10; }
    if (ch >= 65 && ch <= 70) { return ch - 65 + 10; }
    return -1;
}

@[noinline]
fn parse_hex(input: string, output: *u8) -> bool {
    if (input.len != 64) { return false; }
    var i: i32 = 0;
    while (i < 32) {
        let high = hex_nibble(input.charAt((i * 2) as i64));
        let low = hex_nibble(input.charAt((i * 2 + 1) as i64));
        if (high < 0 || low < 0) { return false; }
        output[i] = ((high << 4) | low) as u8;
        i = i + 1;
    }
    return true;
}

fn rotate_left(value: u64, amount: u64) -> u64 {
    return (value << amount) | (value >> ((64 as u64) - amount));
}

@[noinline]
fn arx_mix(data: *u8, count: i32, seed: u64) -> u64 {
    var state: u64 = seed ^ (7046029254386353131 as u64);
    var i: i32 = 0;
    while (i < count) {
        let byte = data[i] as u64;
        let keyed = byte + (((i + 1) as u64) * (257 as u64));
        state = state ^ (keyed * (6364136223846793005 as u64));
        let amount = (((i * 7 + 13) % 63 + 1) as u64);
        state = rotate_left(state, amount);
        state = state * (3202034522624059733 as u64)
              + (1442695040888963407 as u64);
        i = i + 1;
    }
    return state ^ rotate_left(state, 17 as u64);
}

@[noinline]
fn state_walk(data: *u8, count: i32, seed: u64) -> u64 {
    var state: u64 = seed ^ (3935559000370003845 as u64);
    var score: u64 = 2691343689449507681 as u64;
    var i: i32 = 0;
    while (i < count) {
        let byte = data[i] as u64;
        let selector = (state ^ byte ^ (i as u64)) & (3 as u64);
        if (selector == (0 as u64)) {
            state = rotate_left(
                state + byte + (1442695040888963407 as u64),
                5 as u64);
        } elif (selector == (1 as u64)) {
            state = rotate_left(
                state ^ (byte * (7046029254386353131 as u64)),
                11 as u64) + (3202034522624059733 as u64);
        } elif (selector == (2 as u64)) {
            state = (state * (6364136223846793005 as u64))
                  ^ rotate_left(
                        byte + (3935559000370003845 as u64),
                        17 as u64);
        } else {
            state = rotate_left(
                state + (byte << (((i & 7) + 1) as u64)),
                23 as u64) ^ (4768777513237032717 as u64);
        }
        score = rotate_left(
            score ^ state ^ (byte * ((i + 1) as u64)),
            9 as u64);
        score = score * (2405875930906139467 as u64)
              + (7046029254386353131 as u64);
        i = i + 1;
    }
    return score ^ rotate_left(state, 29 as u64);
}

fn read_u64_le(data: *u8, offset: i32) -> u64 {
    var word: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < 8) {
        word = word | ((data[offset + i] as u64) << ((i * 8) as u64));
        i = i + 1;
    }
    return word;
}

@[noinline]
fn verify_token(data: *u8) -> u64 {
    let left = arx_mix(
        data,
        32,
        1442695040888963407 as u64);
    let right = state_walk(
        data,
        32,
        left ^ (4768777513237032717 as u64));
    var fold: u64 = 2691343689449507681 as u64;
    var block: i32 = 0;
    while (block < 4) {
        let word = read_u64_le(data, block * 8);
        fold = fold ^ rotate_left(
            word + left,
            (block * 11 + 3) as u64);
        fold = fold * (6364136223846793005 as u64)
             + (3202034522624059733 as u64);
        block = block + 1;
    }
    return rotate_left(fold ^ right, 27 as u64)
         + (left ^ (3935559000370003845 as u64));
}

fn main() -> i32 {
    if (argCount() != 2) {
        print("INVALID");
        return 2;
    }

    var bytes: [u8; 32];
    var data: *u8 = bytes;
    if (!parse_hex(getArg(1), data)) {
        print("INVALID");
        return 2;
    }

    let digest = verify_token(data);
    if (digest == (6317825462749680818 as u64)) {
        print("ACCEPT ${digest}");
        return 0;
    }
    print("REJECT ${digest}");
    return 1;
}
