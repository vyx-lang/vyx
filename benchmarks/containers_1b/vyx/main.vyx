module containers_bench_vyx;

use std.collections;
use std.string;

extern "C" { fn clock() -> i64; }

class BenchRng {
    private state: i64;
    static fn from_seed(seed: i64) -> BenchRng {
        var s = seed % 2147483648;
        if (s <= 0) { s = 1; }
        return BenchRng { state: s };
    }
    fn next() -> i64 {
        self.state = (self.state * 1103515245 + 12345) % 2147483648;
        if (self.state < 0) { self.state = 0 - self.state; }
        return self.state;
    }
}

fn option_i64(name: string, fallback: i64) -> i64 {
    let prefix = name + "=";
    var i: i32 = 1;
    while (i < argCount()) {
        let arg = getArg(i);
        if (arg.startsWith(prefix)) { return str_to_int(arg.substring(prefix.len, arg.len)) as i64; }
        i = i + 1;
    }
    return fallback;
}

fn option_case() -> string {
    var i: i32 = 1;
    while (i < argCount()) { let arg = getArg(i); if (arg.startsWith("--case=")) { return arg.substring(7, arg.len); } i = i + 1; }
    return "all";
}
fn option_profile() -> string {
    var i: i32 = 1;
    while (i < argCount()) { let arg = getArg(i); if (arg.startsWith("--profile=")) { return arg.substring(10, arg.len); } i = i + 1; }
    return "matched-o2";
}
fn option_hash_policy() -> string {
    var i: i32 = 1;
    while (i < argCount()) { let arg = getArg(i); if (arg.startsWith("--hash-policy=")) { return arg.substring(14, arg.len); } i = i + 1; }
    return "deterministic-splitmix64";
}
fn has_flag(flag: string) -> bool {
    var i: i32 = 1;
    while (i < argCount()) { if (getArg(i) == flag) { return true; } i = i + 1; }
    return false;
}
fn ticks_to_ns(ticks: i64, rate: i64) -> i64 {
    if (ticks <= 0 || rate <= 0) { return 0; }
    return (ticks * 1000000000) / rate;
}
fn emit(case_name: string, workload: i64, live_set: i64, string_bytes: i64, seed: i64,
        reserve: bool, profile: string, hash_policy: string, clock_rate: i64,
        setup_ticks: i64, op_ticks: i64, final_size: i64, checksum: i64) {
    var reserve_i: i64 = 0; if (reserve) { reserve_i = 1; }
    let total_ticks = setup_ticks + op_ticks;
    var ops_per_sec: i64 = 0; if (op_ticks > 0) { ops_per_sec = (workload * clock_rate) / op_ticks; }
    print("language=vyx bench=" + case_name + " workload=" + int_to_string(workload)
        + " live_set=" + int_to_string(live_set) + " string_bytes=" + int_to_string(string_bytes)
        + " seed=" + int_to_string(seed) + " reserve=" + int_to_string(reserve_i)
        + " profile=" + profile + " api_mode=safe hash_policy=" + hash_policy
        + " timing_mode=c_clock_cpu clock_rate=" + int_to_string(clock_rate)
        + " setup_ticks=" + int_to_string(setup_ticks) + " op_ticks=" + int_to_string(op_ticks)
        + " total_ticks=" + int_to_string(total_ticks) + " setup_ns=" + int_to_string(ticks_to_ns(setup_ticks, clock_rate))
        + " op_ns=" + int_to_string(ticks_to_ns(op_ticks, clock_rate)) + " total_ns=" + int_to_string(ticks_to_ns(total_ticks, clock_rate))
        + " op_ops_per_sec=" + int_to_string(ops_per_sec) + " final_size=" + int_to_string(final_size)
        + " checksum=" + int_to_string(checksum) + " peak_rss_bytes=na\n");
}

fn bench_vec(w: i64, live: i64, sb: i64, seed: i64, reserve: bool, profile: string, hash: string, rate: i64) {
    let t0 = clock(); var values = Vec::<i64>::new(); if (reserve) { values.reserve(live); }
    var rng = BenchRng.from_seed(seed); var initial = live; if (initial > w) { initial = w; } if (initial < 1) { initial = 1; }
    var i: i64 = 0; while (i < initial) { values.push(rng.next()); i = i + 1; }
    let setup = clock() - t0; var sum: i64 = 0; let op0 = clock(); var op: i64 = 0;
    while (op < w) { let a = rng.next() % 100; let idx = rng.next(); let x = rng.next();
        if (a < 35 && values.length() < live) { values.push(x); }
        elif (a < 55 && values.length() > 1) { sum = (sum + values.pop()) % 1000000007; }
        elif (a < 80 && !values.isEmpty()) { let j = idx % values.length(); sum = (sum + values.get(j) + j) % 1000000007; }
        elif (!values.isEmpty()) { let j = idx % values.length(); values.set(j, x); sum = (sum ^ x) % 1000000007; }
        op = op + 1;
    }
    if (!values.isEmpty()) { sum = (sum + values.get(0) + values.get(values.length() - 1)) % 1000000007; }
    emit("vec", w, live, sb, seed, reserve, profile, hash, rate, setup, clock() - op0, values.length(), sum);
}

fn bench_dict(w: i64, live: i64, sb: i64, seed: i64, reserve: bool, profile: string, hash: string, rate: i64) {
    let t0 = clock(); var values = Dict::<i64, i64>::new(); if (reserve) { values = Dict::<i64, i64>::with_capacity(live); }
    var rng = BenchRng.from_seed(seed); var key_space = live; if (key_space < 1) { key_space = 1; }
    var initial = live; if (initial > w) { initial = w; } if (initial < 1) { initial = 1; }
    var i: i64 = 0; while (i < initial) { values.put(rng.next() % key_space, rng.next()); i = i + 1; }
    let setup = clock() - t0; var sum: i64 = 0; let op0 = clock(); var op: i64 = 0;
    while (op < w) { let a = rng.next() % 100; let key = rng.next() % key_space; let x = rng.next();
        if (a < 45) { values.put(key, x); }
        elif (a < 75) { let found = values.try_get(key); if (found.isSome()) { sum = (sum + found.unwrap()) % 1000000007; } }
        elif (a < 92) { if (values.remove(key)) { sum = (sum + 1) % 1000000007; } }
        else { if (values.contains(key)) { sum = (sum ^ 1) % 1000000007; } }
        op = op + 1;
    }
    emit("dict", w, live, sb, seed, reserve, profile, hash, rate, setup, clock() - op0, values.length(), sum);
}

fn bench_string(w: i64, live: i64, sb: i64, seed: i64, reserve: bool, profile: string, hash: string, rate: i64) {
    let t0 = clock(); var value = String.empty(); if (reserve) { value.reserve(sb); }
    var rng = BenchRng.from_seed(seed); var initial = sb / 2; if (initial > w) { initial = w; } if (initial < 1) { initial = 1; }
    var i: i64 = 0; while (i < initial) { value.push((32 + rng.next() % 95) as i32); i = i + 1; }
    let setup = clock() - t0; var sum: i64 = 0; let op0 = clock(); var op: i64 = 0;
    while (op < w) { let a = rng.next() % 100; let idx = rng.next(); let x = rng.next();
        if (a < 60) { if (value.length() < sb) { value.push((32 + x % 95) as i32); } else { value.clear(); } }
        elif (a < 85 && !value.isEmpty()) { let j = idx % value.length(); sum = (sum + value.byteAt(j) + j) % 1000000007; }
        else { value.clear(); }
        op = op + 1;
    }
    if (!value.isEmpty()) { sum = (sum + value.byteAt(0) + value.byteAt(value.length() - 1)) % 1000000007; }
    emit("string", w, live, sb, seed, reserve, profile, hash, rate, setup, clock() - op0, value.length(), sum);
}

fn main() -> i32 {
    let w = option_i64("--workload", 1000000000); let live = option_i64("--live-set", 1000000);
    let sb = option_i64("--string-bytes", 1048576); let seed = option_i64("--seed", 1592594996);
    let reserve = !has_flag("--no-reserve"); let profile = option_profile(); let hash = option_hash_policy(); let rate = option_i64("--clock-rate", 1000); let selected = option_case();
    if (selected == "all" || selected == "vec") { bench_vec(w, live, sb, seed, reserve, profile, hash, rate); }
    if (selected == "all" || selected == "dict") { bench_dict(w, live, sb, seed, reserve, profile, hash, rate); }
    if (selected == "all" || selected == "string") { bench_string(w, live, sb, seed, reserve, profile, hash, rate); }
    return 0;
}
