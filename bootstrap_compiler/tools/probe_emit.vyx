/// Emit probe: full bootstrap pipeline through **`vyx_codegen`** (LLVM FFI).
/// Depends on `vyx_codegen.dll` — use only to isolate bootstrap codegen.

module bootstrap.probe_emit;

use std.fs;
use bootstrap.lexer;
use bootstrap.parser;
use bootstrap.ast;
use bootstrap.sema;
use bootstrap.codegen;

fn die(msg: string) -> i32 {
    print(msg);
    return 1;
}

fn main() -> i32 {
    let argc = argCount();
    if (argc < 3) {
        print("usage: probe_emit <input.vyx> <out.ll>");
        return 2;
    }
    let path = getArg(1);
    let out_ll = getArg(2);
    let src = readFile(path);
    if (src.len == 0) {
        return die("[probe_emit] read failed or empty: " + path);
    }
    let lx = lex_source(src);
    if (lx == null) { return die("[probe_emit] lex null"); }
    if (lex_error_count(lx) > 0) { lexer_dispose(lx); return die("[probe_emit] lex errors"); }
    let unit = parse_unit(lx);
    if (unit == null) { lexer_dispose(lx); return die("[probe_emit] parse null"); }
    lexer_dispose(lx);

    let sema_st = analyze_unit(unit);
    if (sema_st == null) { return die("[probe_emit] sema null"); }
    let s_errs = check_program(sema_st, unit);
    sema_dispose(sema_st);
    if (s_errs > 0) {
        print("[probe_emit] sema_errors=" + s_errs.toString());
        return 1;
    }

    let cg = emit_unit(unit, "probe_mod");
    if (cg == null) { return die("[probe_emit] emit_unit null"); }
    let rc = emit_to_file(cg, out_ll);
    codegen_dispose(cg);
    if (rc != 0) {
        print("[probe_emit] emit_to_file rc=" + rc.toString());
        return 1;
    }
    print("[probe_emit] OK path=" + path + " -> " + out_ll);
    return 0;
}
