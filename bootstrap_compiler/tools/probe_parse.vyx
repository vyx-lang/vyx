/// Parse-only probe (lex → parse). No sema, no codegen, **no vyx_codegen**.

module bootstrap.probe_parse;

use std.fs;
use bootstrap.lexer;
use bootstrap.parser;
use bootstrap.ast;

fn die(msg: string) -> i32 {
    print(msg);
    return 1;
}

fn expr_kind_text(k: i32) -> string {
    if (k == ex_CALL()) { return "call"; }
    if (k == ex_MEMBER()) { return "member"; }
    if (k == ex_IDENT()) { return "ident"; }
    if (k == ex_INT_LIT()) { return "int"; }
    if (k == ex_CLOSURE()) { return "closure"; }
    return "kind#" + k.toString();
}

fn call_arg_count(head: rawptr) -> i32 {
    var count: i32 = 0;
    var cur = head;
    while (cur != null) {
        count = count + 1;
        cur = stmt_get_next(cur);
    }
    return count;
}

fn dump_expr(e: rawptr, depth: i32) {
    if (e == null) { return; }
    let k = expr_get_kind(e);
    if (k == ex_CALL()) {
        let callee = expr_get_lhs(e);
        var callee_kind: i32 = 0;
        var callee_name: string = "";
        if (callee != null) {
            callee_kind = expr_get_kind(callee);
            callee_name = expr_get_name(callee);
        }
        print("[probe_parse] CALL depth=" + depth.toString()
              + " argc=" + call_arg_count(expr_get_args(e)).toString()
              + " callee=" + expr_kind_text(callee_kind)
              + " name=" + callee_name);
        dump_expr(callee, depth + 1);
        var arg = expr_get_args(e);
        while (arg != null) {
            let value = stmt_get_init(arg);
            if (value != null && expr_get_kind(value) == ex_INT_LIT()) {
                print("[probe_parse] ARG depth=" + depth.toString()
                      + " int=" + expr_get_int_val(value).toString());
            }
            dump_expr(value, depth + 1);
            arg = stmt_get_next(arg);
        }
        return;
    }
    if (k == ex_MEMBER() || k == ex_UNARY() || k == ex_ADDR_OF()
        || k == ex_DEREF() || k == ex_CAST() || k == ex_COMPTIME()
        || k == ex_AWAIT()) {
        dump_expr(expr_get_lhs(e), depth + 1);
        return;
    }
    if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
        dump_expr(expr_get_lhs(e), depth + 1);
        dump_expr(expr_get_rhs(e), depth + 1);
        return;
    }
    if (k == ex_TERNARY()) {
        dump_expr(expr_get_lhs(e), depth + 1);
        dump_expr(expr_get_rhs(e), depth + 1);
        dump_expr(expr_get_args(e), depth + 1);
        return;
    }
    if (k == ex_CLOSURE()) {
        dump_stmt_chain(expr_get_lhs(e), depth + 1);
        return;
    }
    if (k == ex_STRUCT_INIT() || k == ex_ARRAY_LIT() || k == ex_TUPLE_LIT()
        || k == ex_FSTRING() || k == ex_INLINE_ASM()) {
        var cell = expr_get_args(e);
        while (cell != null) {
            dump_expr(stmt_get_init(cell), depth + 1);
            cell = stmt_get_next(cell);
        }
    }
}

fn dump_stmt_chain(head: rawptr, depth: i32) {
    var cur = head;
    while (cur != null) {
        dump_expr(stmt_get_init(cur), depth);
        dump_expr(stmt_get_cond(cur), depth);
        dump_stmt_chain(stmt_get_then_blk(cur), depth + 1);
        dump_stmt_chain(stmt_get_else_blk(cur), depth + 1);
        dump_stmt_chain(stmt_get_body(cur), depth + 1);
        cur = stmt_get_next(cur);
    }
}

fn dump_decl_chain(head: rawptr) {
    var cur = head;
    while (cur != null) {
        dump_stmt_chain(decl_get_body(cur), 0);
        dump_decl_chain(decl_get_members(cur));
        cur = decl_get_next(cur);
    }
}

fn main() -> i32 {
    let argc = argCount();
    if (argc < 2) {
        print("usage: probe_parse <input.vyx>");
        return 2;
    }
    let path = getArg(1);
    let src = readFile(path);
    if (src.len == 0) {
        return die("[probe_parse] read failed or empty: " + path);
    }
    let lx = lex_source(src);
    if (lx == null) {
        return die("[probe_parse] lex_source null");
    }
    if (lex_error_count(lx) > 0) {
        lexer_dispose(lx);
        return die("[probe_parse] lexer errors");
    }
    let unit = parse_unit(lx);
    if (unit == null) {
        lexer_dispose(lx);
        return die("[probe_parse] parse_unit null");
    }
    let nd = unit_get_decl_count(unit);
    print("[probe_parse] OK path=" + path + " top_decls=" + nd.toString());
    dump_decl_chain(unit_get_decls(unit));
    lexer_dispose(lx);
    return 0;
}
