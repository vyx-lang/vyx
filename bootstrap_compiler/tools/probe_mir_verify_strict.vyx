/// Strict MIR verifier probe: hand-builds a tiny MirUnit (no mir_builder,
/// no llvm_mir_lower) and checks that
///   1. the default verifier still reports 0 errors on it, and
///   2. the strict verifier reports exactly the planted closure violations:
///      one unreachable block, one call arity mismatch, one field-place
///      base type mismatch.
///
/// NOTE: known-blocked on the host (C++) vyxc: it miscompiles the
/// free-function-over-class-method pattern in this reduced import closure
/// (mir_unit_add_* return garbage ids). Build this probe with a
/// self-hosted bootstrap vyxc instead.

module bootstrap.probe_mir_verify_strict;

use std.clone;
use std.fs;
use std.string;
use bootstrap.ast;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_verify;
use bootstrap.policy;

fn main() -> i32 {
    let types = HirTypeTable.create();
    let t_void = types.intern(ty_VOID(), "void", hir_id_invalid(), hir_id_invalid());
    let t_i64 = types.intern(ty_I64(), "i64", hir_id_invalid(), hir_id_invalid());
    let t_box = types.intern(ty_CLASS(), "ProbeBox", hir_id_invalid(), hir_id_invalid());
    let m = MirUnit.create(types);

    // callee: fn probe_callee(x: i64) -> i64 { return 1; }
    let callee = m.add_function( 1, 1, "probe_callee", t_i64);
    let param = m.add_local( callee, 1, "x", t_i64, 1);
    let param_place = m.add_place( callee, mir_place_local(), t_i64, param,
                                         mir_id_invalid(), mir_id_invalid(), mir_id_invalid(),
                                         mir_id_invalid(), "x");
    m.set_local_place( param, param_place);
    let cb = m.add_block( callee, mir_id_invalid());
    let cret = m.add_value( callee, mir_value_const_int(), t_i64,
                                  mir_id_invalid(), mir_target_none(), mir_id_invalid(),
                                  mir_id_invalid(), 0, 0, 1, "", "1");
    m.set_block_terminator( cb, mir_term_return(), cret,
                                  mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), 0);

    // ProbeBox layout: one i64 field `a` at index 0
    m.add_field_layout( 1, 10, t_box, t_i64, 0, "a");

    // probe_main: void fn with planted violations
    let f = m.add_function( 2, 2, "probe_main", t_void);
    let entry = m.add_block( f, mir_id_invalid());
    let orphan = m.add_block( f, mir_id_invalid());

    // arity violation: probe_callee expects 1 arg, call carries 0
    let callee_ref = m.add_value( f, mir_value_target_ref(), t_i64,
                                        mir_id_invalid(), mir_target_function(), callee,
                                        mir_id_invalid(), 0, 0, 0, "probe_callee", "");
    let call = m.add_value( f, mir_value_call(), t_i64,
                                  mir_id_invalid(), mir_target_function(), callee,
                                  mir_id_invalid(), 0, 0, 0, "probe_callee", "");
    m.set_value_lhs( call, callee_ref);
    m.add_instr( f, entry, mir_instr_eval(), t_i64,
                       mir_id_invalid(), call, mir_id_invalid(), mir_id_invalid(),
                       mir_target_function(), callee,
                       mir_id_invalid(), mir_id_invalid(), 0, 0, "probe_callee");

    // good field place: base typed ProbeBox + field `a` -> no strict error
    let box_local = m.add_local( f, 2, "box", t_box, 0);
    let box_place = m.add_place( f, mir_place_local(), t_box, box_local,
                                       mir_id_invalid(), mir_id_invalid(), mir_id_invalid(),
                                       mir_id_invalid(), "box");
    m.set_local_place( box_local, box_place);
    m.add_place( f, mir_place_field(), t_i64, mir_id_invalid(),
                       box_place, 1, mir_id_invalid(), mir_id_invalid(), "a");

    // bad field place: base typed i64 but field `a` is owned by ProbeBox
    let bad_local = m.add_local( f, 3, "notabox", t_i64, 0);
    let bad_place = m.add_place( f, mir_place_local(), t_i64, bad_local,
                                       mir_id_invalid(), mir_id_invalid(), mir_id_invalid(),
                                       mir_id_invalid(), "notabox");
    m.set_local_place( bad_local, bad_place);
    m.add_place( f, mir_place_field(), t_i64, mir_id_invalid(),
                       bad_place, 1, mir_id_invalid(), mir_id_invalid(), "a");

    m.set_block_terminator( entry, mir_term_return(), mir_id_invalid(),
                                  mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), 0);
    m.set_block_terminator( orphan, mir_term_return(), mir_id_invalid(),
                                  mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), 0);

    print("[probe] default verifier pass");
    let base_errors = mir_verify_unit(m);
    print("[probe] base_errors=" + policy_i64_to_string(base_errors as i64));

    print("[probe] strict verifier pass");
    let strict_errors = mir_verify_unit_strict(m);
    print("[probe] strict_errors=" + policy_i64_to_string(strict_errors as i64));

    if (base_errors != 0) {
        print("[probe] FAIL: default verifier must stay green on this unit");
        return 1;
    }
    if (strict_errors != 3) {
        print("[probe] FAIL: expected exactly 3 strict errors (unreachable block, call arity, field base type)");
        return 2;
    }
    print("[probe] probe_mir_verify_strict OK");
    return 0;
}
