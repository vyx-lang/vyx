/// Lex-only probe — no parser/sema/codegen, **no vyx_codegen link**.
/// Isolate lexer regressions without LLVM DLL path noise.

module bootstrap.probe_lex;

use std.clone;
use std.fs;
use bootstrap.lexer;

fn die(msg: string) -> i32 {
    print(msg);
    return 1;
}

fn main() -> i32 {
    let argc = argCount();
    if (argc < 2) {
        print("usage: probe_lex [--dump-tokens] <input.vyx>");
        return 2;
    }
    var dump: bool = false;
    var path: string = "";
    if (argc >= 3 && getArg(1) == "--dump-tokens") {
        dump = true;
        path = getArg(2);
    } else {
        path = getArg(1);
    }
    let src = readFile(path.clone());
    if (src.len == 0) {
        return die("[probe_lex] read failed or empty: " + path);
    }
    let h = lex_source(src);
    if (h == null) {
        return die("[probe_lex] lex_source returned null");
    }
    if (dump) {
        dump_tokens_host_lines(h, path.clone());
    }
    let tok = lex_token_count(h);
    let err = lex_error_count(h);
    if (!dump) {
        print("[probe_lex] OK path=" + path + " tokens=" + tok.toString()
              + " lex_errors=" + err.toString());
    }
    lexer_dispose(h);
    if (err > 0) { return 1; }
    return 0;
}
