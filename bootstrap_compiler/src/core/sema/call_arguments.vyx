module bootstrap.sema;

use bootstrap.ast;
use bootstrap.diag;

// Binding is independent of expression evaluation. Keep the source argument
// chain intact; MIR evaluates it once before arranging the ABI arguments.
public fn sema_call_has_named_args(args: rawptr) -> bool {
    var arg = args;
    while (arg != null) {
        if (stmt_get_name(arg).len > 0) { return true; }
        arg = stmt_get_next(arg);
    }
    return false;
}

public fn sema_call_named_arg(args: rawptr, name: string) -> rawptr {
    var arg = args;
    while (arg != null) {
        if (stmt_get_name(arg) == name) { return arg; }
        arg = stmt_get_next(arg);
    }
    return null;
}

public fn sema_call_arg_for_param(args: rawptr, params: rawptr, wanted: rawptr) -> rawptr {
    if (wanted == null) { return null; }
    let named = sema_call_named_arg(args, decl_get_name(wanted));
    if (named != null) { return named; }
    var index: i32 = 0;
    var param = params;
    while (param != null && param != wanted) {
        if (sema_call_named_arg(args, decl_get_name(param)) == null) { index += 1; }
        param = decl_get_next(param);
    }
    if (param == null) { return null; }
    var arg = args;
    while (arg != null) {
        if (stmt_get_name(arg).len == 0) {
            if (index == 0) { return arg; }
            index -= 1;
        }
        arg = stmt_get_next(arg);
    }
    return null;
}

@[vis(world)]
impl Sema {
    public fn call_named_param_head(self, call: rawptr, params: rawptr) -> rawptr {
        var head = params;
        if (head != null && decl_get_name(head) == "self") { head = decl_get_next(head); }
        if (self.pipe_call_context == call && self.pipe_prefix_expr != null && head != null) {
            head = decl_get_next(head);
        }
        return head;
    }

    public fn call_named_arg_expr(self, call: rawptr, params: rawptr, param: rawptr) -> rawptr {
        var first = params;
        if (first != null && decl_get_name(first) == "self") { first = decl_get_next(first); }
        if (self.pipe_call_context == call && self.pipe_prefix_expr != null && first == param) {
            return self.pipe_prefix_expr;
        }
        let cell = sema_call_arg_for_param(expr_get_args(call), self.call_named_param_head(call, params), param);
        if (cell == null) { return null; }
        return stmt_get_init(cell);
    }

    public fn call_named_binding_valid(self, call: rawptr, params: rawptr, diagnose: bool) -> bool {
        let args = expr_get_args(call);
        let head = self.call_named_param_head(call, params);
        var arg = args;
        var positional_count: i32 = 0;
        while (arg != null) {
            let name = stmt_get_name(arg);
            if (name.len == 0) { positional_count += 1; }
            else {
                var param = head;
                while (param != null && decl_get_name(param) != name) { param = decl_get_next(param); }
                if (param == null) {
                    if (diagnose) {
                        self.report_error_coded(diag_code_sema_undefined(), expr_loc_ptr(stmt_get_init(arg)),
                            "unknown argument name '" + name + "'");
                    }
                    return false;
                }
                if (sema_call_named_arg(args, name) != arg) {
                    if (diagnose) {
                        self.report_error_coded(diag_code_sema_undefined(), expr_loc_ptr(stmt_get_init(arg)),
                            "duplicate argument name '" + name + "'");
                    }
                    return false;
                }
                if (sema_param_ends_typed_arity(param)) {
                    if (diagnose) {
                        self.report_error_coded(diag_code_sema_undefined(), expr_loc_ptr(stmt_get_init(arg)),
                            "variadic argument '" + name + "' cannot be supplied by name");
                    }
                    return false;
                }
            }
            arg = stmt_get_next(arg);
        }
        var remaining = positional_count;
        var param = head;
        while (param != null) {
            if (sema_param_ends_typed_arity(param)) { return true; }
            if (sema_call_named_arg(args, decl_get_name(param)) == null) {
                if (remaining > 0) { remaining -= 1; }
                elif (decl_get_body(param) == null) {
                    if (diagnose) {
                        self.report_error_coded(diag_code_sema_undefined(), expr_loc_ptr(call),
                            "missing argument '" + decl_get_name(param) + "'");
                    }
                    return false;
                }
            }
            param = decl_get_next(param);
        }
        if (remaining > 0) {
            if (diagnose) {
                self.report_error_coded(diag_code_sema_undefined(), expr_loc_ptr(call), "too many positional arguments");
            }
            return false;
        }
        return true;
    }
}
