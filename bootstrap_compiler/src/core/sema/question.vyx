module bootstrap.sema;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.policy;

@[vis(world)]
impl Sema {
    public fn check_question_return_protocol(self, ep: rawptr, input_type: rawptr, return_type: rawptr) -> bool {
        let input = self.resolve_type_alias_ref(input_type);
        let output = self.resolve_type_alias_ref(return_type);
        var input_role = "";
        var output_role = "";
        if (input != null && tref_get_kind(input) == ty_CLASS()) {
            let owner = self.class_decl_for_type_base(generic_call_base(tref_get_name(input)));
            if (owner != null) { input_role = sema_extract_lang_item_slot(decl_get_meta(owner)); }
        }
        if (output != null && tref_get_kind(output) == ty_CLASS()) {
            let owner = self.class_decl_for_type_base(generic_call_base(tref_get_name(output)));
            if (owner != null) { output_role = sema_extract_lang_item_slot(decl_get_meta(owner)); }
        }
        if ((input_role != "result" && input_role != "option")
            || (output != null && input_role != output_role)
            || (output == null && !self.cur_question_return_inference)) {
            self.report_error_help(diag_code_sema_type_mismatch(), expr_loc_ptr(ep),
                "question operator requires matching Result or Option input and function return types",
                "handle the error or absence explicitly, or return the same propagation protocol");
            return false;
        }
        if (output == null) {
            let node = vyx_frontend_alloc(16);
            if (node == null) {
                self.report_error_coded(diag_code_sema_generic(), expr_loc_ptr(ep),
                    "cannot record inferred question return check");
                return false;
            }
            ast_write_rawptr(node, ep);
            ast_write_rawptr(ptr_offset(node, 8), self.cur_question_return_checks);
            self.cur_question_return_checks = node;
        }
        return true;
    }

    public fn question_payload_type(self, ep: rawptr, input_type: rawptr, return_type: rawptr) -> rawptr {
        if (!self.check_question_return_protocol(ep, input_type, return_type)) { return null; }
        let input = self.resolve_type_alias_ref(input_type);
        let payload_name = generic_arg_at(policy_generic_call_args(tref_get_name(input)), 0);
        if (payload_name.len == 0) {
            self.report_error_coded(diag_code_sema_generic(), expr_loc_ptr(ep),
                "question operator requires a declared payload type");
            return null;
        }
        return sema_type_name_to_ref(payload_name);
    }

    public fn finish_inferred_question_checks(self, return_type: rawptr) {
        var node = self.cur_question_return_checks;
        self.cur_question_return_checks = null;
        self.cur_question_return_inference = false;
        while (node != null) {
            let ep = ast_read_rawptr(node);
            let next = ast_read_rawptr(ptr_offset(node, 8));
            self.check_question_return_protocol(ep, expr_get_ty(expr_get_lhs(ep)), return_type);
            vyx_frontend_free(node);
            node = next;
        }
    }
}
