module bootstrap.trait_solver;

use bootstrap.fact_base;
use bootstrap.canon;

/// TraitSolver — primitive, nominal, and blanket satisfaction.
///
/// Result codes:
///   * `trait_solver_result_SAT`           — exact (type, trait) fact, or a
///                                           blanket with an empty where-clause.
///   * `trait_solver_result_UNSAT`         — no fact and no matching blanket.
///   * `trait_solver_result_NEEDS_BLANKET` — a blanket matched; caller must
///                                           prove the where-clause recursively.

public fn trait_solver_result_SAT()           -> i32 { return 1; }
public fn trait_solver_result_UNSAT()         -> i32 { return 2; }
public fn trait_solver_result_NEEDS_BLANKET() -> i32 { return 3; }

fn ts_payload_where(payload: string) -> string {
    var i: i64 = 0;
    while (i < payload.len) {
        if (payload.charAt(i as i32) == 30) {
            return str_substring(payload, i + 1, payload.len);
        }
        i = i + 1;
    }
    return payload;
}

fn ts_payload_generics(payload: string) -> string {
    var i: i64 = 0;
    while (i < payload.len) {
        if (payload.charAt(i as i32) == 30) {
            return str_substring(payload, 0, i);
        }
        i = i + 1;
    }
    return payload;
}

public fn trait_solver_solve_prim(fb: rawptr,
                                  prim_name: string,
                                  trait_name: string) -> i32 {
    return trait_solver_solve_type(fb, prim_name, trait_name);
}

/// Unified solver: exact FactBase hit, then blanket scan.
public fn trait_solver_solve_type(fb: rawptr,
                                  type_mangled: string,
                                  trait_name: string) -> i32 {
    if (fb == null) { return trait_solver_result_UNSAT(); }
    if (type_mangled.len == 0 || trait_name.len == 0) {
        return trait_solver_result_UNSAT();
    }
    fact_base_bump_prim_queries(fb);
    if (fact_base_prim_satisfies(fb, type_mangled, trait_name)) {
        return trait_solver_result_SAT();
    }
    let payload = fact_base_first_blanket_payload(fb, type_mangled, trait_name);
    if (payload.len == 0) {
        return trait_solver_result_UNSAT();
    }
    let where_clause = ts_payload_where(payload);
    if (where_clause.len == 0) {
        return trait_solver_result_SAT();
    }
    return trait_solver_result_NEEDS_BLANKET();
}

public fn trait_solver_blanket_generics(fb: rawptr,
                                        type_mangled: string,
                                        trait_name: string) -> string {
    let payload = fact_base_first_blanket_payload(fb, type_mangled, trait_name);
    if (payload.len == 0) { return ""; }
    return ts_payload_generics(payload);
}

public fn trait_solver_blanket_where(fb: rawptr,
                                     type_mangled: string,
                                     trait_name: string) -> string {
    let payload = fact_base_first_blanket_payload(fb, type_mangled, trait_name);
    if (payload.len == 0) { return ""; }
    return ts_payload_where(payload);
}

public fn trait_solver_prim_satisfies(fb: rawptr,
                                      prim_name: string,
                                      trait_name: string) -> bool {
    return trait_solver_solve_type(fb, prim_name, trait_name)
        == trait_solver_result_SAT();
}
