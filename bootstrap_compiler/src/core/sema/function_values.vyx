module bootstrap.sema;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.policy;

// A function value has no call arguments from which to infer an overload.
// Select only within the already resolved declaration's defining module.
@[vis(world)]
impl Sema {
    public fn function_value_decl(self, resolved: rawptr, args: string, source: rawptr) -> rawptr {
        if (resolved == null) { return null; }
        let name = generic_call_base(decl_get_name(resolved));
        let scope = self.decl_source_module(resolved, null);
        let arity = generic_arg_count(args);
        var selected: rawptr = null;
        var specialization: rawptr = null;
        var generic_seen = false;
        var ambiguous = false;
        var ambiguous_spec = false;
        var entry = self.funcs_buf;
        while (entry != null) {
            let declaration = sym_get_decl(entry);
            if (declaration != null
                && (decl_get_kind(declaration) == de_FN() || decl_get_kind(declaration) == de_EXTERN_FN())
                && generic_call_base(decl_get_name(declaration)) == name
                && self.decl_source_module(declaration, null) == scope) {
                let parameters = decl_get_generic_params(declaration);
                let count = generic_param_count(parameters);
                if (count > 0) { generic_seen = true; }
                if (count == arity) {
                    if (self.sema_meta_is_full_concrete_spec(parameters)) {
                        if (self.sema_canonical_builtin_type_args(sema_generic_params_prefix(parameters))
                            == self.sema_canonical_builtin_type_args(args)) {
                            if (specialization != null && specialization != declaration) { ambiguous_spec = true; }
                            specialization = declaration;
                        }
                    } else {
                        if (selected != null && selected != declaration) { ambiguous = true; }
                        selected = declaration;
                    }
                }
            }
            entry = sym_get_next(entry);
        }
        if (specialization != null && !ambiguous_spec) { return specialization; }
        if (specialization == null && selected != null && !ambiguous) { return selected; }
        var message = "ambiguous function value; select a declaration with a unique signature";
        if (specialization == null && selected == null) {
            message = "function value has no declaration matching its type arguments";
            if (arity == 0 && generic_seen) { message = "generic function value requires explicit type arguments"; }
        }
        self.report_error_coded(diag_code_sema_no_overload(), expr_loc_ptr(source), message);
        return null;
    }
}
