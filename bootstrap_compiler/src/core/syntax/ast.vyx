// ════════════════════════════════════════════════════════════════════
//   12. Unit
// ════════════════════════════════════════════════════════════════════

public fn unit_alloc() -> rawptr {
    let p = ast_alloc_zero(ast_unit_node_size());
    return p;
}

public fn unit_get_decls(p: rawptr) -> rawptr { return ast_ptr_at(p, 0); }
public fn unit_get_decl_count(p: rawptr) -> i32 { return ast_i32_at(p, 8); }
public fn unit_set_decls(p: rawptr, v: rawptr) {
    var rec = ast_unit_unpack(p);
    rec.decls = v;
    ast_unit_pack(p, rec);
}
public fn unit_set_decl_count(p: rawptr, n: i32) {
    var rec = ast_unit_unpack(p);
    rec.decl_count = n;
    ast_unit_pack(p, rec);
}

// ════════════════════════════════════════════════════════════════════
//   13. Module init / dispose hooks
// ════════════════════════════════════════════════════════════════════

public fn ast_init() -> i32 { return 0; }
public fn ast_dispose() -> i32 { return 0; }
