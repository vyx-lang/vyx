module bootstrap.ast;

use std.string;

/// AST surface — Token / TypeRef / Expr / Stmt / Decl / Unit.
///
/// Nodes live in packed heap blobs; the public handle remains `rawptr`
/// because parser/sema/HIR live outside this work package. The class
/// types below document that packed layout. `ast_*_pack` / `ast_*_unpack`
/// are the typed write path used by alloc and setters. Getters still
/// return scalars from the blob — they must not return a class value,
/// because seed-lowered class-by-value copies heap-allocate on every
/// call and OOM the hir_builder self-host compile.
/// Remaining heap growth in this file is arena space for packed blobs, not
/// a per-node byte-accessor bypass. New node writes go through `ast_*_pack`.
/// `ast_read_*` / `ast_write_*` stay as the shared raw-memory helpers
/// used by HIR/MIR tables.
///
/// Layouts (LE, packed; offsets in bytes):
///   TypeRef (24 B)
///     0..3   kind         : i32
///     4..7   _pad         : i32
///     8..15  name_ptr     : rawptr
///     16..23 name_len     : i64
///
///   Expr core (112 B before SourceLoc)
///     0..3   kind         : i32
///     4..7   op           : i32
///     8..15  int_val      : i64
///     16..23 str_val_ptr  : rawptr
///     24..31 str_val_len  : i64
///     32..39 name_ptr     : rawptr
///     40..47 name_len     : i64
///     48..55 lhs          : rawptr  (Expr*)
///     56..63 rhs          : rawptr  (Expr*)  / call-arg next via rhs slot
///     64..71 args         : rawptr  (Expr*)
///     72..79 ty           : rawptr  (TypeRef*)
///     80..87 captures     : rawptr  (Stmt* capture cells / Expr* aux)
///     88..91 sem_kind     : i32     (Sema-resolved target category)
///     92..95 sem_flags    : i32     (Sema lowering flags)
///     96..103 sem_target  : rawptr  (resolved Decl*/Sym* when available)
///     104..111 sem_owner  : rawptr  (owner Decl* for fields/methods/variants)
///
///   Stmt core (96 B before SourceLoc)
///     0..3   kind         : i32
///     4..7   _pad         : i32
///     8..15  name_ptr     : rawptr
///     16..23 name_len     : i64
///     24..31 ty           : rawptr  (TypeRef*)
///     32..39 init         : rawptr  (Expr* or first-stmt for ST_BLOCK
///                                      / first-arg-cell for call args)
///     40..47 cond         : rawptr  (Expr*)
///     48..55 then_blk     : rawptr  (Stmt*)
///     56..63 else_blk     : rawptr  (Stmt*)
///     64..71 body         : rawptr  (Stmt*)
///     72..79 next         : rawptr  (Stmt*)
///     80..83 sem_kind     : i32     (Sema-resolved local/target category)
///     84..87 sem_flags    : i32
///     88..95 sem_target   : rawptr  (builder-only source fact)
///
///   Decl core (136 B before SourceLoc)
///     0..3   kind         : i32
///     4..7   is_public    : i32
///     8..11  is_static    : i32
///     12..15 generic_flags: i32 (cached markers from generic_ptr)
///     16..23 name_ptr     : rawptr
///     24..31 name_len     : i64
///     32..39 ty           : rawptr  (TypeRef*)
///     40..47 params       : rawptr  (Decl* chain — DE_FIELD)
///     48..55 body         : rawptr  (Stmt*)
///     56..63 members      : rawptr  (Decl* chain)
///     64..71 next         : rawptr  (Decl*)
///     72..79 generic_ptr  : rawptr  (comma-separated generic parameter names)
///     80..87 generic_len  : i64
///     88..95 meta_ptr     : rawptr  (visibility / attrs / markers)
///     96..103 meta_len    : i64
///     104..111 doc_ptr    : rawptr  (cooked `///` doc comment)
///     112..119 doc_len    : i64
///     120..123 sem_kind   : i32     (Sema-resolved decl-local category)
///     124..127 sem_flags  : i32
///     128..135 sem_target : rawptr  (builder-only source fact)
///
///   Unit (16 B)
///     0..7   decls        : rawptr  (Decl* chain)
///     8..11  decl_count   : i32
///     12..15 _pad         : i32
///
/// The Token node is unchanged from the lexer's existing 32 B slot and
/// keeps its public class shell (no caller invokes `Token.create()`).

extern "C" {
    fn vyx_frontend_alloc(size: u64) -> rawptr;
    fn vyx_frontend_free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn vyx_note_string_len(s: rawptr, len: i64);
    fn vyx_forget_string_len(s: rawptr);
    fn vyx_rt_ast_dup_profile(bytes: i64);
    fn vyx_rt_ast_node_alloc_profile(bytes: i64);
    fn from_cstr_borrowed_cstr_len(s: rawptr, len: i64) -> string;
}

public fn ptr_offset(ptr: rawptr, offset: i32) -> rawptr {
    return ptr + offset;
}

public fn ptr_write_i32(ptr: rawptr, value: i32) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 4);
}

public fn ptr_read_i32(ptr: rawptr) -> i32 {
    var v: i32 = 0;
    memcpy(to_rawptr(&v), ptr, 4);
    return v;
}

public fn ptr_write_i64(ptr: rawptr, value: i64) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 8);
}

public fn ptr_read_i64(ptr: rawptr) -> i64 {
    var v: i64 = 0;
    memcpy(to_rawptr(&v), ptr, 8);
    return v;
}

