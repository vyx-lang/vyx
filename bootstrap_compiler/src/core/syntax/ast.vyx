    public loc_end_col: i32
}

class AstDecl {
    public kind: i32
    public is_public: i32
    public is_static: i32
    public generic_flags: i32
    public name_ptr: rawptr
    public name_len: i64
    public ty: rawptr
    public params: rawptr
    public body: rawptr
