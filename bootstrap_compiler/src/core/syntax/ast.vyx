/// Declarative MOSP Effect block.  Its canonical field text is stored in the
/// declaration's generic-parameter payload with the `|effect` marker; this
/// keeps the packed Decl ABI unchanged while allowing later semantic passes
/// to consume the source declaration as data rather than a function.
public fn de_EFFECT() -> i32 {
    return 13;
}

// ════════════════════════════════════════════════════════════════════
//   6. Token  —  one tagged token in the lexer's stream
//
//   The lexer writes 48 B raw byte slots for tokens; the public Token
//   class shell is kept for ABI continuity but is never instantiated
//   today (all callers go through `lex_token_at` + `token_kind/lexeme`
//   in `bootstrap.lexer`).
// ════════════════════════════════════════════════════════════════════

public class Token {
    public kind: i32
    public lexeme: string
    public line: i32
    public col: i32

    public static fn create(kind: i32, lexeme: string, line: i32, col: i32) -> Token {
        return Token { kind: kind, lexeme: lexeme, line: line, col: col };
    }
}

fn ast_tref_node_size() -> i32 { return 40; }
fn ast_expr_node_size() -> i32 { return 128; }
fn ast_stmt_node_size() -> i32 { return 112; }
fn ast_decl_node_size() -> i32 { return 152; }
fn ast_unit_node_size() -> i32 { return 16; }

class AstTypeRef {
    public kind: i32
    public _pad: i32
    public a: rawptr
    public b: i64
    public loc_line: i32
    public loc_col: i32
    public loc_end_line: i32
    public loc_end_col: i32
}

class AstExpr {
    public kind: i32
    public op: i32
    public int_val: i64
    public str_val_ptr: rawptr
    public str_val_len: i64
    public name_ptr: rawptr
    public name_len: i64
    public lhs: rawptr
    public rhs: rawptr
    public args: rawptr
    public ty: rawptr
    public captures: rawptr
    public sem_kind: i32
    public sem_flags: i32
    public sem_target: rawptr
    public sem_owner: rawptr
    public loc_line: i32
    public loc_col: i32
    public loc_end_line: i32
    public loc_end_col: i32
}

class AstStmt {
    public kind: i32
    public _pad: i32
    public name_ptr: rawptr
    public name_len: i64
    public ty: rawptr
    public init: rawptr
    public cond: rawptr
    public then_blk: rawptr
    public else_blk: rawptr
    public body: rawptr
    public next: rawptr
    public sem_kind: i32
    public sem_flags: i32
