/// `IDENT { f1: e1, f2: e2 }` — struct/class instance literal.
///
/// Layout reuses the standard Expr slots:
///   * name  → class name (the leading IDENT).
///   * args  → head of a singly-linked field-cell chain. Each cell is
///             a `Stmt(ST_EXPR)` with `name` = field name, `init` =
///             field-value Expr, and `next` linking to the next cell.
///             That mirrors `parse_call_args` so codegen can walk both
///             argument lists and field initializers with the same
///             helper (`expr_get_args` → cell list, `stmt_get_init`
///             on each cell yields the value Expr).
public fn ex_STRUCT_INIT() -> i32 {
    return 13;
}
public fn ex_MATCH_EXPR() -> i32 {
    return 14;
}
public fn ex_CLOSURE() -> i32 {
    return 15;
}
public fn ex_COMPTIME() -> i32 {
    return 16;
}
public fn ex_ARRAY_LIT() -> i32 {
    return 17;
}
public fn ex_TUPLE_LIT() -> i32 {
    return 18;
}
/// `cond ? a : b` ternary expression.
///
/// Layout:
///   * lhs   → cond (Expr*)
///   * rhs   → then-branch (Expr*)
///   * args  → else-branch (Expr*)
///
/// `args` deliberately stores a single Expr* (not a stmt-cell chain) so codegen
/// can read all three operands with the same lhs/rhs/args triplet pattern used
/// by other binary-ish expressions.
public fn ex_TERNARY() -> i32 {
    return 19;
}
/// `'a'` char literal.
///
/// Layout:
///   * int_val → decoded codepoint (i32 widened to i64)
///   * str_val → original lexeme including surrounding quotes (`'a'`, `'\\n'`),
///               kept for diagnostics / pretty-printing
public fn ex_CHAR_LIT() -> i32 {
    return 20;
}
/// `f"hello {expr} world"` interpolated string literal.
///
/// Layout:
///   * str_val → the raw text inside the quotes (post-strip, no quotes)
///   * args    → head of a singly-linked segment chain. Each cell is a
///               `Stmt(ST_EXPR)` whose:
///                 - `name`  = `"lit"` for a literal segment, `"expr"` for an
///                             interpolated segment (parser-level marker so
///                             codegen / sema can choose between direct emit
///                             and `.toString()` lowering).
///                 - `init`  = the segment's payload Expr — `ex_STR_LIT` for a
///                             literal segment, the parsed expression for an
///                             interpolated segment.
///                 - `next`  = link to the next segment.
///
/// MCP-2 (lexer) protocol: parser is agnostic about whether the lexer produced
/// `IDENT("f") + STRING(raw)` (current path) or a single `tk_FSTRING_RAW` (the
/// fall-back lexer plan). Either way the parser entry is `parse_fstring_inner`
/// taking the original quoted lexeme.
public fn ex_FSTRING() -> i32 {
    return 21;
}
/// `expr as Type` cast.
///
/// Layout:
///   * lhs → inner Expr being cast
///   * ty  → target TypeRef (parser stamps this; sema only echoes it back
///           via `expr_set_ty` after recursing on `lhs`)
///
/// Bootstrap sema does not fully validate cast legality here — codegen picks the LLVM
/// op (sext/zext/trunc/bitcast/inttoptr/ptrtoint) based on `lhs.ty` and
/// `target.ty` kinds.
public fn ex_CAST() -> i32 {
    return 22;
}
/// `*expr` raw / typed pointer dereference (loads the pointee).
///
/// Layout:
///   * lhs → ptr-typed Expr being dereferenced
///   * ty  → element type, computed by sema. If `lhs.ty` is a typed
///           pointer / reference whose element TypeRef is reachable,
///           use it; otherwise fall back to `ty_I32` so codegen still
///           gets a concrete type to emit `load`.
public fn ex_DEREF() -> i32 {
    return 23;
}
/// `fail Error.Variant(payload?)` / `fail Error.Variant.with(msg)`.
///
/// Layout:
///   * name    -> error type name
///   * str_val -> variant name
///   * lhs     -> payload or debug-message expression
///   * op      -> 1 for payload form, 0 for `.with(...)`/no message
public fn ex_FAIL() -> i32 {
    return 24;
}
/// `await expr`. Sema unwraps `Task`/`Promise` payload types; HIR/MIR lower
/// to `await_value()`, which parks on the `vyx_runtime` fiber scheduler.
public fn ex_AWAIT() -> i32 {
    return 25;
}
/// Inline LLVM asm expression: `asm("template", "constraints", operands...)`.
///
/// Layout:
///   * str_val -> template
///   * name    -> comma-joined constraint string
///   * args    -> operand Expr chain
public fn ex_INLINE_ASM() -> i32 {
    return 26;
}
/// `if (cond) { ... } elif (...) { ... } else { ... }` expression.
///
/// Layout:
///   * lhs  -> cond Expr
///   * rhs  -> then branch Stmt block
///   * args -> else branch Stmt block or nested ex_IF_EXPR for elif
public fn ex_IF_EXPR() -> i32 {
    return 27;
}
/// Explicit heap allocation: `new T(...)`, `new T{...}` or
/// `new::<T>(...)`.
///
/// Layout:
///   * captures -> the allocated payload type `T`
///   * ty      -> allocation result type, filled by Sema
///   * lhs     -> optional allocator expression
///   * rhs     -> optional aggregate initializer (`ex_STRUCT_INIT` /
///                `ex_ARRAY_LIT`)
///   * args    -> constructor / scalar initializer argument cells
///   * name    -> canonical payload type text
///   * op bits -> NEW_EXPR_* flags declared below
public fn ex_NEW() -> i32 {
    return 28;
}
/// Explicit one-level deallocation: `delete ptr` or
/// `delete::<T>(allocator) ptr`.
///
/// `lhs` is the pointer expression, `rhs` is the optional allocator,
/// `captures` is the optional explicit payload type and `name` carries its
/// canonical text.  Delete never recursively follows the pointee.
public fn ex_DELETE() -> i32 {
    return 29;
}

public fn new_expr_has_paren_init() -> i32 { return 1; }
public fn new_expr_has_brace_init() -> i32 { return 2; }
public fn new_expr_generic_form() -> i32 { return 4; }
public fn new_expr_has_allocator() -> i32 { return 8; }
public fn new_expr_empty_init() -> i32 { return 16; }

/// Contextual unary ownership transfer: `own expr`.
/// Kept outside the lexer token range so the bootstrap lexer can continue to
/// treat `own` as an identifier everywhere except unary-expression position.
public fn unary_op_own() -> i32 { return 1001; }

