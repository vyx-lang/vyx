/// Function type — corresponds to host `VyxTypeKind::Function`.
/// TypeRef layout for ty_FN:
///   offset 8  = params tuple TypeRef
///   offset 16 = return TypeRef
public fn ty_FN() -> i32 {
    return 23;
}
/// Range value — host `VyxTypeKind::Range`, represented as `{ i64, i64 }`.
public fn ty_RANGE() -> i32 {
    return 24;
