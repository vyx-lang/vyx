fn ast_string_contains_marker(s: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (s.len < needle.len) { return false; }
    var i: i32 = 0;
    while (i + needle.len <= s.len) {
        var j: i32 = 0;
        var ok: bool = true;
        while (j < needle.len && ok) {
            if (s.charAt(i + j) != needle.charAt(j)) { ok = false; }
            j = j + 1;
        }
        if (ok) { return true; }
        i = i + 1;
    }
    return false;
}

fn decl_compute_generic_flags(s: string) -> i32 {
    var flags: i32 = 0;
    if (ast_string_contains_marker(s, "|kind:error")) { flags = flags | 1; }
    if (ast_string_contains_marker(s, "|kind:interface")) { flags = flags | 2; }
    if (ast_string_contains_marker(s, "|kind:struct")) { flags = flags | 4; }
    if (ast_string_contains_marker(s, "|kind:assoc_const")) { flags = flags | 8; }
    if (ast_string_contains_marker(s, "|kind:assoc_type")) { flags = flags | 16; }
    if (ast_string_contains_marker(s, "|variadic")) { flags = flags | 32; }
    if (ast_string_contains_marker(s, "|impl:")) { flags = flags | 64; }
    if (ast_string_contains_marker(s, "|payload")) { flags = flags | 128; }
    return flags;
}

fn decl_compute_name_flags(s: string) -> i32 {
    if (s == "extern_C_block") { return 256; }
    if (s == "extern_cpp_block" || s == "extern_dci_block") { return 512; }
    return 0;
}

// ════════════════════════════════════════════════════════════════════
//   11. Decl
// ════════════════════════════════════════════════════════════════════

public fn decl_alloc(kind: i32, name: string) -> rawptr {
    let p = ast_alloc_zero(ast_decl_node_size());
    if (p == null) { return null; }
    var rec = ast_decl_unpack(p);
    rec.kind = kind;
    rec.name_ptr = ast_replace_cstr(rec.name_ptr, name);
    rec.name_len = name.len;
    rec.generic_flags = decl_compute_name_flags(name);
    rec.loc_line = ast_current_line();
    rec.loc_col = ast_current_col();
    rec.loc_end_line = rec.loc_line;
    rec.loc_end_col = rec.loc_col;
    ast_decl_pack(p, rec);
    return p;
}

public fn decl_get_kind(p: rawptr) -> i32 { return ast_i32_at(p, 0); }
public fn decl_get_is_public(p: rawptr) -> bool { return ast_i32_at(p, 4) != 0; }
public fn decl_get_is_static(p: rawptr) -> bool { return ast_i32_at(p, 8) != 0; }
public fn decl_get_generic_flags(p: rawptr) -> i32 { return ast_i32_at(p, 12); }
public fn decl_get_name(p: rawptr) -> string { return ast_cstr_at(p, 16, 24); }
public fn decl_get_ty(p: rawptr) -> rawptr { return ast_ptr_at(p, 32); }
public fn decl_get_params(p: rawptr) -> rawptr { return ast_ptr_at(p, 40); }
public fn decl_get_body(p: rawptr) -> rawptr { return ast_ptr_at(p, 48); }
public fn decl_get_members(p: rawptr) -> rawptr { return ast_ptr_at(p, 56); }
public fn decl_get_next(p: rawptr) -> rawptr { return ast_ptr_at(p, 64); }
public fn decl_get_generic_params(p: rawptr) -> string { return ast_cstr_at(p, 72, 80); }
public fn decl_get_meta(p: rawptr) -> string { return ast_cstr_at(p, 88, 96); }
// The parser records the declaration's lexical module independently of the
// import root or template artifact that transports it. Return a borrowed view
// into the AST metadata, just as the other declaration string accessors do.
public fn decl_has_source_module(p: rawptr) -> bool {
    if (p == null) { return false; }
    return decl_get_meta(p).indexOf("|decl-module:") >= 0;
}
public fn decl_get_source_module(p: rawptr) -> string {
    if (p == null) { return ""; }
    let meta = decl_get_meta(p);
    let marker = "|decl-module:";
    let at = meta.indexOf(marker);
    if (at < 0) { return ""; }
    let start = at + marker.len;
    var end = start;
    while (end < meta.len && meta.charAt(end as i32) != 124) { end = end + 1; }
    if (end <= start) { return ""; }
    return from_cstr_view_len(ptr_offset(meta.c_str(), start), end - start);
}
public fn decl_get_doc(p: rawptr) -> string { return ast_cstr_at(p, 104, 112); }
public fn decl_get_semantic_kind(p: rawptr) -> i32 {
    if (p == null) { return expr_sem_NONE(); }
    return ast_i32_at(p, 120);
}
public fn decl_get_semantic_flags(p: rawptr) -> i32 { return ast_i32_at(p, 124); }
public fn decl_get_semantic_target(p: rawptr) -> rawptr { return ast_ptr_at(p, 128); }

public fn decl_set_is_public(p: rawptr, v: bool) {
    var rec = ast_decl_unpack(p);
    rec.is_public = 0;
    if (v) { rec.is_public = 1; }
    ast_decl_pack(p, rec);
}
public fn decl_set_is_static(p: rawptr, v: bool) {
    var rec = ast_decl_unpack(p);
    rec.is_static = 0;
    if (v) { rec.is_static = 1; }
    ast_decl_pack(p, rec);
}
public fn decl_set_name(p: rawptr, s: string) {
    var rec = ast_decl_unpack(p);
    rec.name_ptr = ast_replace_cstr(rec.name_ptr, s);
    rec.name_len = s.len;
    rec.generic_flags = decl_compute_name_flags(s) | decl_compute_generic_flags(decl_get_generic_params(p));
    ast_decl_pack(p, rec);
}
public fn decl_set_ty(p: rawptr, v: rawptr) {
    var rec = ast_decl_unpack(p);
    rec.ty = v;
    ast_decl_pack(p, rec);
}
public fn decl_set_params(p: rawptr, v: rawptr) {
    var rec = ast_decl_unpack(p);
    rec.params = v;
    ast_decl_pack(p, rec);
}
public fn decl_set_body(p: rawptr, v: rawptr) {
    var rec = ast_decl_unpack(p);
    rec.body = v;
    ast_decl_pack(p, rec);
}
public fn decl_set_members(p: rawptr, v: rawptr) {
    var rec = ast_decl_unpack(p);
    rec.members = v;
    ast_decl_pack(p, rec);
}
public fn decl_set_next(p: rawptr, v: rawptr) {
    var rec = ast_decl_unpack(p);
    rec.next = v;
    ast_decl_pack(p, rec);
}
public fn decl_set_generic_params(p: rawptr, s: string) {
    var rec = ast_decl_unpack(p);
    rec.generic_ptr = ast_replace_cstr(rec.generic_ptr, s);
    rec.generic_len = s.len;
    rec.generic_flags = decl_compute_name_flags(decl_get_name(p)) | decl_compute_generic_flags(s);
    ast_decl_pack(p, rec);
}
public fn decl_set_meta(p: rawptr, s: string) {
    var rec = ast_decl_unpack(p);
    rec.meta_ptr = ast_replace_cstr(rec.meta_ptr, s);
    rec.meta_len = s.len;
    ast_decl_pack(p, rec);
}
public fn decl_set_doc(p: rawptr, s: string) {
    var rec = ast_decl_unpack(p);
    rec.doc_ptr = ast_replace_cstr(rec.doc_ptr, s);
    rec.doc_len = s.len;
    ast_decl_pack(p, rec);
}
public fn decl_set_semantic(p: rawptr, kind: i32, target: rawptr, flags: i32) {
    var rec = ast_decl_unpack(p);
    rec.sem_kind = kind;
    rec.sem_flags = flags;
    rec.sem_target = target;
    ast_decl_pack(p, rec);
}
public fn decl_clear_semantic(p: rawptr) {
    decl_set_semantic(p, expr_sem_NONE(), null, 0);
}

// ════════════════════════════════════════════════════════════════════
//   11.b SourceLoc accessors per node kind.
//
//   Each *_loc_ptr returns a non-owning pointer to the 16 B inline
//   loc record so diag emitters can pass it to `diag_emit_at` without
//   copying. The line/col scalar accessors are handy for sema-level
//   string formatting that already has the node handy.
// ════════════════════════════════════════════════════════════════════

public fn tref_loc_ptr(p: rawptr)       -> rawptr { return ast_node_loc_ptr(p, AST_TREF_LOC_OFFSET); }
public fn tref_loc_line(p: rawptr)      -> i32    { return ast_node_loc_line(p, AST_TREF_LOC_OFFSET); }
public fn tref_loc_col(p: rawptr)       -> i32    { return ast_node_loc_col(p, AST_TREF_LOC_OFFSET); }
public fn tref_loc_end_line(p: rawptr)  -> i32    { return ast_node_loc_end_line(p, AST_TREF_LOC_OFFSET); }
public fn tref_loc_end_col(p: rawptr)   -> i32    { return ast_node_loc_end_col(p, AST_TREF_LOC_OFFSET); }
public fn tref_set_loc(p: rawptr, l: i32, c: i32, el: i32, ec: i32) {
    var rec = ast_tref_unpack(p);
    rec.loc_line = l;
    rec.loc_col = c;
    rec.loc_end_line = el;
    rec.loc_end_col = ec;
    ast_tref_pack(p, rec);
}

public fn expr_loc_ptr(p: rawptr)       -> rawptr { return ast_node_loc_ptr(p, AST_EXPR_LOC_OFFSET); }
public fn expr_loc_line(p: rawptr)      -> i32    { return ast_node_loc_line(p, AST_EXPR_LOC_OFFSET); }
public fn expr_loc_col(p: rawptr)       -> i32    { return ast_node_loc_col(p, AST_EXPR_LOC_OFFSET); }
public fn expr_loc_end_line(p: rawptr)  -> i32    { return ast_node_loc_end_line(p, AST_EXPR_LOC_OFFSET); }
public fn expr_loc_end_col(p: rawptr)   -> i32    { return ast_node_loc_end_col(p, AST_EXPR_LOC_OFFSET); }
public fn expr_set_loc(p: rawptr, l: i32, c: i32, el: i32, ec: i32) {
    var rec = ast_expr_unpack(p);
    rec.loc_line = l;
    rec.loc_col = c;
    rec.loc_end_line = el;
    rec.loc_end_col = ec;
    ast_expr_pack(p, rec);
}

public fn stmt_loc_ptr(p: rawptr)       -> rawptr { return ast_node_loc_ptr(p, AST_STMT_LOC_OFFSET); }
public fn stmt_loc_line(p: rawptr)      -> i32    { return ast_node_loc_line(p, AST_STMT_LOC_OFFSET); }
public fn stmt_loc_col(p: rawptr)       -> i32    { return ast_node_loc_col(p, AST_STMT_LOC_OFFSET); }
public fn stmt_loc_end_line(p: rawptr)  -> i32    { return ast_node_loc_end_line(p, AST_STMT_LOC_OFFSET); }
public fn stmt_loc_end_col(p: rawptr)   -> i32    { return ast_node_loc_end_col(p, AST_STMT_LOC_OFFSET); }
public fn stmt_set_loc(p: rawptr, l: i32, c: i32, el: i32, ec: i32) {
    var rec = ast_stmt_unpack(p);
    rec.loc_line = l;
    rec.loc_col = c;
    rec.loc_end_line = el;
    rec.loc_end_col = ec;
    ast_stmt_pack(p, rec);
}

public fn decl_loc_ptr(p: rawptr)       -> rawptr { return ast_node_loc_ptr(p, AST_DECL_LOC_OFFSET); }
public fn decl_loc_line(p: rawptr)      -> i32    { return ast_node_loc_line(p, AST_DECL_LOC_OFFSET); }
public fn decl_loc_col(p: rawptr)       -> i32    { return ast_node_loc_col(p, AST_DECL_LOC_OFFSET); }
public fn decl_loc_end_line(p: rawptr)  -> i32    { return ast_node_loc_end_line(p, AST_DECL_LOC_OFFSET); }
public fn decl_loc_end_col(p: rawptr)   -> i32    { return ast_node_loc_end_col(p, AST_DECL_LOC_OFFSET); }
public fn decl_set_loc(p: rawptr, l: i32, c: i32, el: i32, ec: i32) {
    var rec = ast_decl_unpack(p);
    rec.loc_line = l;
    rec.loc_col = c;
    rec.loc_end_line = el;
    rec.loc_end_col = ec;
    ast_decl_pack(p, rec);
