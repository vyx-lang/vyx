// ════════════════════════════════════════════════════════════════════

public fn expr_sem_NONE() -> i32 { return 0; }
public fn expr_sem_LOCAL() -> i32 { return 1; }
public fn expr_sem_CONST() -> i32 { return 2; }
public fn expr_sem_GLOBAL() -> i32 { return 3; }
public fn expr_sem_DIRECT_FN() -> i32 { return 4; }
public fn expr_sem_METHOD() -> i32 { return 5; }
public fn expr_sem_FIELD() -> i32 { return 6; }
public fn expr_sem_VARIANT() -> i32 { return 7; }
public fn expr_sem_CLASS() -> i32 { return 8; }
public fn expr_sem_BUILTIN() -> i32 { return 9; }
public fn expr_sem_INDIRECT_FN() -> i32 { return 10; }

// Stmt semantic-flags bit reserved by the parser: the statement is an
// `unsafe { ... }` block.  Sema never writes semantic fields on block
// statements, so this bit survives to HIR building.
public fn stmt_flag_unsafe_block() -> i32 { return 1; }

// Stmt semantic-flags bit reserved by the parser: the let/var statement
// carries the `volatile` qualifier (`let volatile x = ...;`).  Sema
// preserves this bit when it writes the LOCAL semantic kind, so it survives
// into HIR local flags without touching the TypeRef layout.
public fn stmt_flag_volatile_local() -> i32 { return 2; }

// `unsafe let` / `unsafe var`: the binding is parsed outside an unsafe
// block but still opts out of the ownership oracle for that statement.
public fn stmt_flag_unsafe_local() -> i32 { return 4; }

// Member spelling retained in the expression operator slot.  `.` remains
// zero for backwards compatibility; `->` is an explicit typed-pointer
// spelling and is consumed by the same member-resolution/lowering path.  The
// distinction is intentionally lightweight so old AST/HIR records keep their
// layout and reference receivers can continue using `.` transparently.
public fn expr_member_access_dot() -> i32 { return 0; }
public fn expr_member_access_arrow() -> i32 { return 1; }

public fn expr_alloc(kind: i32) -> rawptr {
    let p = ast_alloc_zero(ast_expr_node_size());
    if (p == null) { return null; }
    var rec = ast_expr_unpack(p);
    rec.kind = kind;
    rec.loc_line = ast_current_line();
    rec.loc_col = ast_current_col();
    rec.loc_end_line = rec.loc_line;
    rec.loc_end_col = rec.loc_col;
    ast_expr_pack(p, rec);
    return p;
}

