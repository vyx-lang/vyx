/// Convenience alias for `'a'` style literals — same numeric kind as
/// `tk_CHAR()` (=3, host `CharLiteral`). Token slot pad (offset 12..15)
/// carries the decoded i32 codepoint value when this kind is set.
public fn tk_CHAR_LIT() -> i32 {
    return 3;
}

/// Fstring raw token — emitted when a `"..."` literal contains `${...}`
/// interpolation. Payload (lexeme) keeps the raw inner body INCLUDING the
/// `${...}` segments so a later parser pass can split it. Numeric kind
/// 137 sits beyond host Token.h's last `Invalid=136` and is bootstrap-private.
public fn tk_FSTRING_RAW() -> i32 {
    return 137;
}
/// Contextual top-level `effect` declaration.  The bootstrap lexer keeps
/// `effect` as an identifier so existing expression code can continue to use
/// that spelling; the parser promotes it only in declaration position.  This
/// private ordinal is reserved for token-stream fixtures and diagnostics.
public fn tk_KEYWORD_EFFECT() -> i32 {
    return 139;
}

