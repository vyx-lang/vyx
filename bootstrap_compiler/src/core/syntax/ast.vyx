public fn expr_get_int_val(p: rawptr) -> i64 { return ast_i64_at(p, 8); }
public fn expr_get_str_val(p: rawptr) -> string { return ast_cstr_at(p, 16, 24); }
public fn expr_get_name(p: rawptr) -> string { return ast_cstr_at(p, 32, 40); }
public fn expr_get_lhs(p: rawptr) -> rawptr { return ast_ptr_at(p, 48); }
public fn expr_get_rhs(p: rawptr) -> rawptr { return ast_ptr_at(p, 56); }
public fn expr_get_args(p: rawptr) -> rawptr { return ast_ptr_at(p, 64); }
public fn expr_get_ty(p: rawptr) -> rawptr { return ast_ptr_at(p, 72); }
public fn expr_get_captures(p: rawptr) -> rawptr { return ast_ptr_at(p, 80); }
public fn expr_get_semantic_kind(p: rawptr) -> i32 { return ast_i32_at(p, 88); }
public fn expr_get_semantic_flags(p: rawptr) -> i32 { return ast_i32_at(p, 92); }
public fn expr_get_semantic_target(p: rawptr) -> rawptr { return ast_ptr_at(p, 96); }
public fn expr_get_semantic_owner(p: rawptr) -> rawptr { return ast_ptr_at(p, 104); }

