fn ast_bits_i64(p: rawptr) -> i64 {
    var n: i64 = 0;
    var q = p;
    memcpy(to_rawptr(&n), to_rawptr(&q), 8);
    return n;
}

fn ast_bits_ptr(n: i64) -> rawptr {
    var p: rawptr = null;
    var v = n;
    memcpy(to_rawptr(&p), to_rawptr(&v), 8);
    return p;
}

fn ast_i32_at(p: rawptr, off: i32) -> i32 {
    if (p == null) { return 0; }
    return ast_read_i32(ptr_offset(p, off));
}
fn ast_put_i32(p: rawptr, off: i32, v: i32) {
    if (p == null) { return; }
    ast_write_i32(ptr_offset(p, off), v);
}
fn ast_i64_at(p: rawptr, off: i32) -> i64 {
    if (p == null) { return 0; }
    return ast_read_i64(ptr_offset(p, off));
}
fn ast_put_i64(p: rawptr, off: i32, v: i64) {
    if (p == null) { return; }
    ast_write_i64(ptr_offset(p, off), v);
}
fn ast_ptr_at(p: rawptr, off: i32) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, off));
}
fn ast_put_ptr(p: rawptr, off: i32, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, off), v);
}
fn ast_cstr_at(p: rawptr, ptr_off: i32, len_off: i32) -> string {
    if (p == null) { return ""; }
    let buf = ast_ptr_at(p, ptr_off);
    let n = ast_i64_at(p, len_off);
    // TypeRef overlays name_ptr/name_len with payload pointers for ARRAY/PTR/FN.
    // A pointer-sized "length" would make from_cstr_* request terabytes and abort.
    if (buf == null || n <= 0 || n > 1048576) { return ""; }
    return from_cstr_view_len(buf, n);
}
fn ast_put_cstr(p: rawptr, ptr_off: i32, len_off: i32, s: string) {
    if (p == null) { return; }
    ast_put_ptr(p, ptr_off, ast_replace_cstr(ast_ptr_at(p, ptr_off), s));
    ast_put_i64(p, len_off, s.len);
}

fn ast_tref_pack(dst: rawptr, rec: AstTypeRef) {
    if (dst == null) { return; }
    ast_put_i32(dst, 0, rec.kind);
    ast_put_i32(dst, 4, rec._pad);
    ast_put_ptr(dst, 8, rec.a);
    ast_put_i64(dst, 16, rec.b);
    ast_put_i32(dst, 24, rec.loc_line);
    ast_put_i32(dst, 28, rec.loc_col);
    ast_put_i32(dst, 32, rec.loc_end_line);
    ast_put_i32(dst, 36, rec.loc_end_col);
}

fn ast_tref_unpack(src: rawptr) -> AstTypeRef {
    if (src == null) {
        return AstTypeRef {
            kind: 0, _pad: 0, a: null, b: 0,
            loc_line: 0, loc_col: 0, loc_end_line: 0, loc_end_col: 0
        };
    }
    return AstTypeRef {
        kind: ast_i32_at(src, 0),
        _pad: ast_i32_at(src, 4),
        a: ast_ptr_at(src, 8),
        b: ast_i64_at(src, 16),
        loc_line: ast_i32_at(src, 24),
        loc_col: ast_i32_at(src, 28),
        loc_end_line: ast_i32_at(src, 32),
        loc_end_col: ast_i32_at(src, 36)
    };
}

fn ast_expr_pack(dst: rawptr, rec: AstExpr) {
    if (dst == null) { return; }
    ast_put_i32(dst, 0, rec.kind);
    ast_put_i32(dst, 4, rec.op);
    ast_put_i64(dst, 8, rec.int_val);
    ast_put_ptr(dst, 16, rec.str_val_ptr);
    ast_put_i64(dst, 24, rec.str_val_len);
    ast_put_ptr(dst, 32, rec.name_ptr);
    ast_put_i64(dst, 40, rec.name_len);
    ast_put_ptr(dst, 48, rec.lhs);
    ast_put_ptr(dst, 56, rec.rhs);
    ast_put_ptr(dst, 64, rec.args);
    ast_put_ptr(dst, 72, rec.ty);
    ast_put_ptr(dst, 80, rec.captures);
    ast_put_i32(dst, 88, rec.sem_kind);
    ast_put_i32(dst, 92, rec.sem_flags);
    ast_put_ptr(dst, 96, rec.sem_target);
    ast_put_ptr(dst, 104, rec.sem_owner);
    ast_put_i32(dst, 112, rec.loc_line);
    ast_put_i32(dst, 116, rec.loc_col);
    ast_put_i32(dst, 120, rec.loc_end_line);
    ast_put_i32(dst, 124, rec.loc_end_col);
}

fn ast_expr_unpack(src: rawptr) -> AstExpr {
    if (src == null) {
        return AstExpr {
            kind: 0, op: 0, int_val: 0, str_val_ptr: null, str_val_len: 0,
            name_ptr: null, name_len: 0, lhs: null, rhs: null, args: null,
            ty: null, captures: null, sem_kind: 0, sem_flags: 0,
            sem_target: null, sem_owner: null,
            loc_line: 0, loc_col: 0, loc_end_line: 0, loc_end_col: 0
        };
    }
    return AstExpr {
        kind: ast_i32_at(src, 0),
        op: ast_i32_at(src, 4),
        int_val: ast_i64_at(src, 8),
        str_val_ptr: ast_ptr_at(src, 16),
        str_val_len: ast_i64_at(src, 24),
        name_ptr: ast_ptr_at(src, 32),
        name_len: ast_i64_at(src, 40),
        lhs: ast_ptr_at(src, 48),
        rhs: ast_ptr_at(src, 56),
        args: ast_ptr_at(src, 64),
        ty: ast_ptr_at(src, 72),
        captures: ast_ptr_at(src, 80),
        sem_kind: ast_i32_at(src, 88),
        sem_flags: ast_i32_at(src, 92),
        sem_target: ast_ptr_at(src, 96),
        sem_owner: ast_ptr_at(src, 104),
        loc_line: ast_i32_at(src, 112),
        loc_col: ast_i32_at(src, 116),
        loc_end_line: ast_i32_at(src, 120),
        loc_end_col: ast_i32_at(src, 124)
    };
}

fn ast_stmt_pack(dst: rawptr, rec: AstStmt) {
    if (dst == null) { return; }
    ast_put_i32(dst, 0, rec.kind);
    ast_put_i32(dst, 4, rec._pad);
    ast_put_ptr(dst, 8, rec.name_ptr);
    ast_put_i64(dst, 16, rec.name_len);
    ast_put_ptr(dst, 24, rec.ty);
    ast_put_ptr(dst, 32, rec.init);
    ast_put_ptr(dst, 40, rec.cond);
    ast_put_ptr(dst, 48, rec.then_blk);
    ast_put_ptr(dst, 56, rec.else_blk);
    ast_put_ptr(dst, 64, rec.body);
    ast_put_ptr(dst, 72, rec.next);
    ast_put_i32(dst, 80, rec.sem_kind);
    ast_put_i32(dst, 84, rec.sem_flags);
    ast_put_ptr(dst, 88, rec.sem_target);
    ast_put_i32(dst, 96, rec.loc_line);
    ast_put_i32(dst, 100, rec.loc_col);
    ast_put_i32(dst, 104, rec.loc_end_line);
    ast_put_i32(dst, 108, rec.loc_end_col);
}

fn ast_stmt_unpack(src: rawptr) -> AstStmt {
    if (src == null) {
        return AstStmt {
            kind: 0, _pad: 0, name_ptr: null, name_len: 0, ty: null,
            init: null, cond: null, then_blk: null, else_blk: null,
            body: null, next: null, sem_kind: 0, sem_flags: 0, sem_target: null,
            loc_line: 0, loc_col: 0, loc_end_line: 0, loc_end_col: 0
        };
    }
    return AstStmt {
        kind: ast_i32_at(src, 0),
        _pad: ast_i32_at(src, 4),
        name_ptr: ast_ptr_at(src, 8),
        name_len: ast_i64_at(src, 16),
        ty: ast_ptr_at(src, 24),
        init: ast_ptr_at(src, 32),
        cond: ast_ptr_at(src, 40),
        then_blk: ast_ptr_at(src, 48),
        else_blk: ast_ptr_at(src, 56),
        body: ast_ptr_at(src, 64),
        next: ast_ptr_at(src, 72),
        sem_kind: ast_i32_at(src, 80),
        sem_flags: ast_i32_at(src, 84),
        sem_target: ast_ptr_at(src, 88),
        loc_line: ast_i32_at(src, 96),
        loc_col: ast_i32_at(src, 100),
        loc_end_line: ast_i32_at(src, 104),
        loc_end_col: ast_i32_at(src, 108)
    };
}

fn ast_decl_pack(dst: rawptr, rec: AstDecl) {
    if (dst == null) { return; }
    ast_put_i32(dst, 0, rec.kind);
    ast_put_i32(dst, 4, rec.is_public);
    ast_put_i32(dst, 8, rec.is_static);
    ast_put_i32(dst, 12, rec.generic_flags);
    ast_put_ptr(dst, 16, rec.name_ptr);
    ast_put_i64(dst, 24, rec.name_len);
    ast_put_ptr(dst, 32, rec.ty);
    ast_put_ptr(dst, 40, rec.params);
    ast_put_ptr(dst, 48, rec.body);
    ast_put_ptr(dst, 56, rec.members);
    ast_put_ptr(dst, 64, rec.next);
    ast_put_ptr(dst, 72, rec.generic_ptr);
    ast_put_i64(dst, 80, rec.generic_len);
    ast_put_ptr(dst, 88, rec.meta_ptr);
    ast_put_i64(dst, 96, rec.meta_len);
    ast_put_ptr(dst, 104, rec.doc_ptr);
    ast_put_i64(dst, 112, rec.doc_len);
    ast_put_i32(dst, 120, rec.sem_kind);
    ast_put_i32(dst, 124, rec.sem_flags);
    ast_put_ptr(dst, 128, rec.sem_target);
    ast_put_i32(dst, 136, rec.loc_line);
    ast_put_i32(dst, 140, rec.loc_col);
    ast_put_i32(dst, 144, rec.loc_end_line);
    ast_put_i32(dst, 148, rec.loc_end_col);
}

fn ast_decl_unpack(src: rawptr) -> AstDecl {
    if (src == null) {
        return AstDecl {
            kind: 0, is_public: 0, is_static: 0, generic_flags: 0,
            name_ptr: null, name_len: 0, ty: null, params: null, body: null,
            members: null, next: null, generic_ptr: null, generic_len: 0,
            meta_ptr: null, meta_len: 0, doc_ptr: null, doc_len: 0,
            sem_kind: 0, sem_flags: 0, sem_target: null,
            loc_line: 0, loc_col: 0, loc_end_line: 0, loc_end_col: 0
        };
    }
    return AstDecl {
        kind: ast_i32_at(src, 0),
        is_public: ast_i32_at(src, 4),
        is_static: ast_i32_at(src, 8),
        generic_flags: ast_i32_at(src, 12),
        name_ptr: ast_ptr_at(src, 16),
        name_len: ast_i64_at(src, 24),
        ty: ast_ptr_at(src, 32),
        params: ast_ptr_at(src, 40),
        body: ast_ptr_at(src, 48),
        members: ast_ptr_at(src, 56),
        next: ast_ptr_at(src, 64),
        generic_ptr: ast_ptr_at(src, 72),
        generic_len: ast_i64_at(src, 80),
        meta_ptr: ast_ptr_at(src, 88),
        meta_len: ast_i64_at(src, 96),
        doc_ptr: ast_ptr_at(src, 104),
        doc_len: ast_i64_at(src, 112),
        sem_kind: ast_i32_at(src, 120),
        sem_flags: ast_i32_at(src, 124),
        sem_target: ast_ptr_at(src, 128),
        loc_line: ast_i32_at(src, 136),
        loc_col: ast_i32_at(src, 140),
        loc_end_line: ast_i32_at(src, 144),
        loc_end_col: ast_i32_at(src, 148)
    };
}

fn ast_unit_pack(dst: rawptr, rec: AstUnit) {
    if (dst == null) { return; }
    ast_put_ptr(dst, 0, rec.decls);
    ast_put_i32(dst, 8, rec.decl_count);
    ast_put_i32(dst, 12, rec._pad);
}

fn ast_unit_unpack(src: rawptr) -> AstUnit {
    if (src == null) {
        return AstUnit { decls: null, decl_count: 0, _pad: 0 };
    }
    return AstUnit {
        decls: ast_ptr_at(src, 0),
        decl_count: ast_i32_at(src, 8),
        _pad: ast_i32_at(src, 12)
    };
}

// ════════════════════════════════════════════════════════════════════
//   7. Low-level slot helpers — pure rawptr ops, no class state.
// ════════════════════════════════════════════════════════════════════

public fn ast_alloc_zero(size: i32) -> rawptr {
    let p = vyx_frontend_alloc(size as u64);
    if (p == null) { return null; }
    vyx_rt_ast_node_alloc_profile(size as i64);
    memset(p, 0, size as u64);
    return p;
}

// ── 7.b SourceLoc embedding ────────────────────────────────────────
//
// Every TypeRef / Expr / Stmt / Decl node carries a 16 B SourceLoc tail
// at the end of its byte layout:
//
//     offset 0..3   : line       (i32, 1-based; 0 = unstamped)
//     offset 4..7   : col        (i32, 1-based; 0 = unstamped)
//     offset 8..11  : end_line   (i32, 1-based; 0 = open-ended)
//     offset 12..15 : end_col    (i32, 1-based; 0 = open-ended)
//
// The file path component is shared per translation unit and travels
// via `bootstrap.diag::diag_set_current_file`; baking a per-node
// `(ptr,len)` pair would bloat every node by another 16 B without
// adding signal for the single-input boot_a driver.
//
// To avoid plumbing line/col through 100+ parser callsites we keep
// four module-globals that the parser updates inside `advance()` /
// `Parser.create()`. Every *_alloc helper picks up the current values
// at allocation time, matching the WU1 spec rule "stamp loc 取当前
// token 的 line/col".
//
// `LOC_FIELD_SIZE` = 16; per-node tail offset constants live below
// their respective allocators so the layout stays self-documenting.

let AST_LOC_FIELD_SIZE: i32 = 16;
let AST_TREF_LOC_OFFSET: i32 = 24;
let AST_EXPR_LOC_OFFSET: i32 = 112;
let AST_STMT_LOC_OFFSET: i32 = 96;
let AST_DECL_LOC_OFFSET: i32 = 136;

var g_ast_loc_line: i32 = 0;
var g_ast_loc_col: i32 = 0;
var g_ast_loc_end_line: i32 = 0;
var g_ast_loc_end_col: i32 = 0;

public fn ast_set_current_loc(line: i32, col: i32) {
    g_ast_loc_line = line;
    g_ast_loc_col = col;
    g_ast_loc_end_line = line;
    g_ast_loc_end_col = col;
}

public fn ast_set_current_loc_full(line: i32, col: i32, end_line: i32, end_col: i32) {
    g_ast_loc_line = line;
    g_ast_loc_col = col;
    g_ast_loc_end_line = end_line;
    g_ast_loc_end_col = end_col;
}

public fn ast_clear_current_loc() {
    g_ast_loc_line = 0;
    g_ast_loc_col = 0;
    g_ast_loc_end_line = 0;
    g_ast_loc_end_col = 0;
}

public fn ast_current_line() -> i32 { return g_ast_loc_line; }
public fn ast_current_col()  -> i32 { return g_ast_loc_col; }

fn ast_stamp_loc(node: rawptr, off: i32) {
    if (node == null) { return; }
    // Root-chunk codegen may place this private helper in a different object
    // from the mutable location state.  Reading the private globals directly
    // then turns them into per-partition zero-initialized state.  The public
    // accessors are emitted with the state owner and give every partition the
    // same parser cursor location.
    let line = ast_current_line();
    let col = ast_current_col();
    ast_write_i32(ptr_offset(node, off),       line);
    ast_write_i32(ptr_offset(node, off + 4),   col);
    ast_write_i32(ptr_offset(node, off + 8),   line);
    ast_write_i32(ptr_offset(node, off + 12),  col);
}

fn ast_node_loc_ptr(node: rawptr, off: i32) -> rawptr {
    if (node == null) { return null; }
    return ptr_offset(node, off);
}

fn ast_node_loc_line(node: rawptr, off: i32) -> i32 {
    if (node == null) { return 0; }
    return ast_read_i32(ptr_offset(node, off));
}

fn ast_node_loc_col(node: rawptr, off: i32) -> i32 {
    if (node == null) { return 0; }
    return ast_read_i32(ptr_offset(node, off + 4));
}

fn ast_node_loc_end_line(node: rawptr, off: i32) -> i32 {
    if (node == null) { return 0; }
    return ast_read_i32(ptr_offset(node, off + 8));
}

fn ast_node_loc_end_col(node: rawptr, off: i32) -> i32 {
    if (node == null) { return 0; }
    return ast_read_i32(ptr_offset(node, off + 12));
}

fn ast_node_set_loc(node: rawptr, off: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
    if (node == null) { return; }
    ast_write_i32(ptr_offset(node, off),       line);
    ast_write_i32(ptr_offset(node, off + 4),   col);
    ast_write_i32(ptr_offset(node, off + 8),   end_line);
    ast_write_i32(ptr_offset(node, off + 12),  end_col);
}

public fn ast_dup_c_string(s: string) -> rawptr {
    let n: i64 = s.len;
    let buf = vyx_frontend_alloc((n + 1) as u64);
    if (buf == null) { return null; }
    vyx_rt_ast_dup_profile(n + 1);
    if (n > 0) {
        memcpy(buf, s.c_str(), n as u64);
    }
    var nul: i32 = 0;
    memcpy(ptr_offset(buf, n as i32), to_rawptr(&nul), 1);
    return buf;
}

fn ast_replace_cstr(old: rawptr, s: string) -> rawptr {
    let buf = ast_dup_c_string(s);
    if (old != null) {
        vyx_forget_string_len(old);
        vyx_frontend_free(old);
    }
    return buf;
}

public fn ast_write_rawptr(addr: rawptr, value: rawptr) {
    var v: rawptr = value;
    memcpy(addr, to_rawptr(&v), 8);
}

public fn ast_read_rawptr(addr: rawptr) -> rawptr {
    var v: rawptr = null;
    memcpy(to_rawptr(&v), addr, 8);
    return v;
}

public fn ast_write_i32(addr: rawptr, value: i32) {
    var v = value;
    memcpy(addr, to_rawptr(&v), 4);
}

public fn ast_read_i32(addr: rawptr) -> i32 {
    var v: i32 = 0;
    memcpy(to_rawptr(&v), addr, 4);
    return v;
}

public fn ast_write_i64(addr: rawptr, value: i64) {
    var v = value;
    memcpy(addr, to_rawptr(&v), 8);
}

public fn ast_read_i64(addr: rawptr) -> i64 {
    var v: i64 = 0;
    memcpy(to_rawptr(&v), addr, 8);
    return v;
}

public fn ast_borrow_c_string(buf: rawptr, len: i64) -> string {
    if (buf == null || len <= 0) { return ""; }
    return from_cstr_borrowed_cstr_len(buf, len);
}

// ════════════════════════════════════════════════════════════════════
//   8. TypeRef
// ════════════════════════════════════════════════════════════════════

fn ast_tref_new(kind: i32) -> rawptr {
    let p = ast_alloc_zero(ast_tref_node_size());
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.kind = kind;
    rec.loc_line = ast_current_line();
    rec.loc_col = ast_current_col();
    rec.loc_end_line = rec.loc_line;
    rec.loc_end_col = rec.loc_col;
    ast_tref_pack(p, rec);
    return p;
}

public fn tref_alloc(kind: i32, name: string) -> rawptr {
    let p = ast_tref_new(kind);
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = ast_replace_cstr(rec.a, name);
    rec.b = name.len;
    ast_tref_pack(p, rec);
    return p;
}

public fn tref_get_kind(p: rawptr) -> i32 {
    return ast_i32_at(p, 0);
}

public fn tref_get_name(p: rawptr) -> string {
    if (p == null) { return ""; }
    let k = tref_get_kind(p);
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()
        || k == ty_ARRAY() || k == ty_TUPLE()
        || k == ty_FN() || k == ty_CFN()) {
        return "";
    }
    return ast_cstr_at(p, 8, 16);
}

public fn tref_set_kind(p: rawptr, k: i32) {
    var rec = ast_tref_unpack(p);
    rec.kind = k;
    ast_tref_pack(p, rec);
}

public fn tref_set_name(p: rawptr, name: string) {
    var rec = ast_tref_unpack(p);
    rec.a = ast_replace_cstr(rec.a, name);
    rec.b = name.len;
    ast_tref_pack(p, rec);
}

public fn tref_alloc_array_expr(elem_ty: rawptr, size_expr: rawptr) -> rawptr {
    let p = ast_tref_new(ty_ARRAY());
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = elem_ty;
    rec.b = ast_bits_i64(size_expr);
    ast_tref_pack(p, rec);
    return p;
}

public fn tref_alloc_array(elem_ty: rawptr, size: i64) -> rawptr {
    let size_expr = expr_alloc(ex_INT_LIT());
    if (size_expr != null) {
        expr_set_int_val(size_expr, size);
    }
    return tref_alloc_array_expr(elem_ty, size_expr);
}

public fn tref_array_elem(p: rawptr) -> rawptr {
    return ast_ptr_at(p, 8);
}
public fn tref_array_size_expr(p: rawptr) -> rawptr {
    return ast_bits_ptr(ast_i64_at(p, 16));
}
public fn tref_array_size(p: rawptr) -> i64 {
    if (p == null) { return 0; }
    let e = tref_array_size_expr(p);
    if (e == null) { return 0; }
    if (expr_get_kind(e) == ex_INT_LIT()) { return expr_get_int_val(e); }
    return 0;
}

public fn tref_alloc_tuple(elems: rawptr, count: i64) -> rawptr {
    let p = ast_tref_new(ty_TUPLE());
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = elems;
    rec.b = count;
    ast_tref_pack(p, rec);
    return p;
}
public fn tref_tuple_elems(p: rawptr) -> rawptr {
    return ast_ptr_at(p, 8);
}
public fn tref_tuple_count(p: rawptr) -> i64 {
    return ast_i64_at(p, 16);
}
public fn tref_tuple_elem_at(p: rawptr, i: i64) -> rawptr {
    let base = ast_ptr_at(p, 8);
    if (base == null) { return null; }
    return ast_read_rawptr(ptr_offset(base, (i * 8) as i32));
}

public fn tref_alloc_fn(params_tuple: rawptr, ret_ty: rawptr) -> rawptr {
    let p = ast_tref_new(ty_FN());
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = params_tuple;
    rec.b = ast_bits_i64(ret_ty);
    ast_tref_pack(p, rec);
    return p;
}
public fn tref_alloc_c_fn(params_tuple: rawptr, ret_ty: rawptr) -> rawptr {
    let p = ast_tref_new(ty_CFN());
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = params_tuple;
    rec.b = ast_bits_i64(ret_ty);
    ast_tref_pack(p, rec);
    return p;
}
public fn tref_fn_params(p: rawptr) -> rawptr {
    return ast_ptr_at(p, 8);
}
public fn tref_fn_ret(p: rawptr) -> rawptr {
    return ast_bits_ptr(ast_i64_at(p, 16));
}
public fn tref_fn_param_count(p: rawptr) -> i64 {
    return tref_tuple_count(tref_fn_params(p));
}
public fn tref_fn_param_at(p: rawptr, i: i64) -> rawptr {
    return tref_tuple_elem_at(tref_fn_params(p), i);
}

public fn tref_alloc_ptr_like(kind: i32, elem_ty: rawptr) -> rawptr {
    let p = ast_tref_new(kind);
    if (p == null) { return null; }
    var rec = ast_tref_unpack(p);
    rec.a = elem_ty;
    ast_tref_pack(p, rec);
    return p;
}
public fn tref_pointee(p: rawptr) -> rawptr {
    return ast_ptr_at(p, 8);
}

