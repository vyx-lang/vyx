/// `unsafe fn(...)` C ABI function type — same layout as `ty_FN` but
/// distinguished so codegen / sema can reason about ABI-level differences
/// (e.g. variadic C calls, calling-convention attributes).
public fn ty_CFN() -> i32 {
    return 25;
}

