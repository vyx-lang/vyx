module bootstrap.lexer;

use std.string;
use std.collections;
use bootstrap.ast;
use bootstrap.diag;

// Byte ranges into the caller's original source. Unlike cooked token lexemes,
// these include string prefixes, multiline delimiters and label apostrophes.
// Negative kinds represent trivia: -1 is a line comment, -2 a block comment.
public class SourceToken {
    public kind: i32;
    public start: i32;
    public end: i32;
}

public class SourceTokens {
    public items: Vec<SourceToken>;
    public handle: rawptr;
    public ok: bool;
}

// Only inspect gaps already consumed by the compiler lexer. String contents
// cannot occur here, so comment-looking text inside literals is never split.
fn source_tokens_comments(result: &mut SourceTokens, src: string, begin: i32, end: i32) {
    var pos = begin;
    while (pos < end) {
        if (src.charAt(pos) == 47 && src.charAt(pos + 1) == 47) {
            let start = pos;
            pos = pos + 2;
            while (pos < end && src.charAt(pos) != 10) { pos = pos + 1; }
            var text_end = pos;
            if (text_end > start && src.charAt(text_end - 1) == 13) { text_end = text_end - 1; }
            result.items.push(SourceToken { kind: -1, start: start, end: text_end });
        } elif (src.charAt(pos) == 47 && src.charAt(pos + 1) == 42) {
            let start = pos;
            pos = pos + 2;
            var depth: i32 = 1;
            while (pos < end && depth > 0) {
                if (src.charAt(pos) == 47 && src.charAt(pos + 1) == 42) {
                    depth = depth + 1;
                    pos = pos + 2;
                } elif (src.charAt(pos) == 42 && src.charAt(pos + 1) == 47) {
                    depth = depth - 1;
                    pos = pos + 2;
                } else { pos = pos + 1; }
            }
            result.items.push(SourceToken { kind: -2, start: start, end: pos });
        } else { pos = pos + 1; }
    }
}

// Retain the ordinary parser token stream as well as the lossless source
// spans. The caller owns items and handle: destroy items and lexer_dispose
// handle before releasing its frontend service arena.
public fn lex_source_spans(src: string) -> SourceTokens {
    var result = SourceTokens {
        items: Vec::<SourceToken>.with_capacity(128),
        handle: null,
        ok: false
    };
    if (src.len > 2147482623) {
        diag_emit(diag_sev_ERROR(), diag_code_internal(), 1, 1,
                  "source exceeds the lexer's byte offset limit");
        return result;
    }
    let lx = Lexer.create(src);
    var iterations: i64 = 0;
    while (true) {
        let gap_start = lx.pos;
        lx.skip_whitespace_and_comments();
        source_tokens_comments(&mut result, src, gap_start, lx.pos);
        lx.token_start = lx.pos;
        lx.token_start_line = lx.line;
        lx.token_start_col = lx.col;
        if (lx.at_end()) {
            lx.pending_doc = "";
            lx.push_token(tk_EOF(), "", lx.line, lx.col);
            break;
        }
        let start = lx.pos;
        let count = lx.token_count;
        lx.scan_token_push();
        lx.flush_pending_doc_to_last();
        if (lx.pos <= start || lx.token_count != count + 1) {
            lx.report_error_at(diag_code_internal(), lx.line, lx.col,
                               "lossless lexer did not produce exactly one source token");
            break;
        }
        result.items.push(SourceToken {
            kind: tok_kind(slot_at(lx.tokens_buf, count)), start: start, end: lx.pos
        });
        iterations = iterations + 1;
        if (iterations > src.len + 1) {
            lx.report_error_at(diag_code_internal(), lx.line, lx.col,
                               "lossless lexer iteration limit exceeded");
            break;
        }
    }
    let handle = vyx_frontend_alloc(lex_result_bytes() as u64);
    if (handle == null) {
        vyx_frontend_free(lx.tokens_buf);
        return result;
    }
    memset(handle, 0, lex_result_bytes() as u64);
    lr_set_token_count(handle, lx.token_count);
    lr_set_error_count(handle, lx.error_count);
    lr_set_tokens_buf(handle, lx.tokens_buf);
    result.handle = handle;
    result.ok = lx.error_count == 0;
    return result;
}
