module bootstrap.build_resources;

// All quantities are bytes. Unknown telemetry is -1 and earns no credit.
// Estimates govern admission, not a hard process memory limit. Physical
// headroom and commit headroom are separate constraints, not interchangeable
// measurements. Credits are bounded by the corresponding live reservation.
public fn build_resource_credit(observed_bytes: i64, reservation_bytes: i64) -> i64 {
    if (observed_bytes <= 0 || reservation_bytes <= 0) { return 0; }
    if (observed_bytes < reservation_bytes) { return observed_bytes; }
    return reservation_bytes;
}

public fn build_resource_headroom(available_bytes: i64,
                                  credit_bytes: i64,
                                  reserve_bytes: i64) -> i64 {
    if (available_bytes < 0) { return -1; }
    var free_bytes = available_bytes - reserve_bytes;
    if (free_bytes < 0) { free_bytes = 0; }
    if (credit_bytes > 0) { free_bytes = free_bytes + credit_bytes; }
    return free_bytes;
}

public fn build_resource_limit(physical_headroom: i64,
                               commit_headroom: i64,
                               configured_limit: i64) -> i64 {
    var limit = physical_headroom;
    if (commit_headroom >= 0 && (limit < 0 || commit_headroom < limit)) {
        limit = commit_headroom;
    }
    if (configured_limit > 0 && (limit < 0 || configured_limit < limit)) {
        limit = configured_limit;
    }
    return limit;
}

public fn build_resource_fits(active_bytes: i64, request_bytes: i64, limit_bytes: i64) -> bool {
    if (limit_bytes < 0 || active_bytes < 0 || request_bytes <= 0) { return false; }
    if (active_bytes > limit_bytes) { return false; }
    return request_bytes <= limit_bytes - active_bytes;
}

// Versioned cold prior, not a guarantee or a per-file exception table.
// The initial model covers process startup plus primary source material.
// Imported headers/interfaces and generic expansion can exceed it; measured
// history supersedes it and live telemetry raises an active reservation.
public fn build_resource_cold_estimate(input_bytes: i64, codegen: bool) -> i64 {
    var size = input_bytes;
    if (size < 0) { size = 0; }
    var scale: i64 = 128;
    var base: i64 = 268435456;
    if (codegen) { scale = 4096; base = 536870912; }
    if (size > (9223372036854775807 - base) / scale) { return 9223372036854775807; }
    return base + size * scale;
}

public fn build_resource_measured_estimate(resident: i64, private_bytes: i64) -> i64 {
    var observed = resident;
    if (private_bytes > observed) { observed = private_bytes; }
    if (observed <= 0) { return 0; }
    // Keep 25 percent headroom for measured runs; this is an admission prior,
    // not evidence that future executions cannot grow beyond the sample.
    let extra = observed / 4;
    if (observed > 9223372036854775807 - extra) { return 9223372036854775807; }
    return observed + extra;
}
