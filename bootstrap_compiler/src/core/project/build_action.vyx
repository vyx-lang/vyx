module bootstrap.build_action;

// A task is parsed once at the planner boundary. The executor keeps numeric
// IDs and state, never newline-serialized mutable process records. Primitive
// strings below refer to the build arena; that arena must outlive this batch.
public class BuildAction {
    public step: string;
    public source: string;
    public output: string;
    public command: string;
    public log_path: string;
    public state: i32;
    public is_vyx: bool;
    public priority: i64;
    public memory_bytes: i64;
    public cost_key: string;
    public process_id: i64;
    public started_ms: i64;
    public elapsed_ms: i64;
    public peak_resident_bytes: i64;
    public peak_private_bytes: i64;
    public cpu_time_us: i64;
    public exit_code: i32;
}

public fn build_action_ready() -> i32 { return 0; }
public fn build_action_running() -> i32 { return 1; }
public fn build_action_succeeded() -> i32 { return 2; }
public fn build_action_failed() -> i32 { return 3; }
public fn build_action_cancelled() -> i32 { return 4; }
