module bootstrap.build_system;

use std.fs;
use std.string;

extern "C" { fn vyx_bootstrap_sha256_bytes(data: rawptr, len: i64) -> rawptr; }

// Harnesses use the ordinary target planner, dependency resolver, hooks and
// linker. Only the selected target's process entry and output are replaced.
var g_build_harness_owner: string = "";
var g_build_harness_file: string = "";
var g_build_harness_target: string = "";

public fn build_harness_context(requested: string) -> string {
    let manifest = readFile("Vyx.toml");
    let package = build_toml_get(manifest.clone(), "package", "name");
    let sections = build_target_sections(manifest.clone(), package.clone());
    if (!build_validate_manifest_templates(manifest.clone(), sections.clone())) { return "|ERR|"; }
    let name = build_select_artifact_target(manifest.clone(), sections.clone(), package.clone(), requested);
    if (name == "|ERR|") { return name; }
    let section = "target." + name;
    if (!build_rows_has_exact(sections, section.clone())) {
        print("error: harness: manifest target not found: " + name);
        return "|ERR|";
    }
    let kind = build_toml_get_platform_value(manifest.clone(), section.clone(), "type");
    if (kind == "prebuilt" || kind == "binary") {
        print("error: harness: a binary package has no source tests: " + name);
        return "|ERR|";
    }
    var entry = build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "entry"));
    if (entry.len == 0) { entry = build_toml_get(manifest.clone(), "package", "entry"); }
    var sources = toml_array_to_lines(build_expand_env(
        build_toml_get_platform_array(manifest.clone(), section.clone(), "sources")));
    if (entry.len > 0) {
        sources = build_append_unique_line(sources, entry.clone());
        var auto = build_toml_get_platform_value(manifest.clone(), section.clone(), "auto_sources");
        if (auto.len == 0) { auto = build_toml_get_platform_value(manifest.clone(), "build", "auto_sources"); }
        if (build_bool_enabled(auto)) {
            let excludes = toml_array_to_lines(build_expand_env(
                build_toml_get_platform_array(manifest.clone(), section.clone(), "auto_source_excludes")));
            sources = build_append_source_lines_unique(sources,
                build_filter_source_excludes(build_auto_vyx_sources(entry.clone()), excludes));
        }
        sources = build_append_source_lines_unique(sources, build_auto_vyx_import_sources(entry));
    }
    // Preserve native inputs too: the runner discovers only Vyx files, but
    // must not let a report overwrite any configured source input.
    return name + "\n" + sources;
}

fn build_harness_active(target: string) -> bool {
    return g_build_harness_file.len > 0 && target == g_build_harness_target;
}

fn build_harness_identity() -> string {
    return from_cstr(vyx_bootstrap_sha256_bytes(g_build_harness_file.c_str(), g_build_harness_file.len as i64));
}

fn build_harness_group(sources: string, target: string) -> bool {
    if (!build_harness_active(target)) { return false; }
    var i: i64 = 0;
    while (i < build_line_count(sources)) {
        if (build_same_abs_path(build_line_at(sources, i), g_build_harness_owner.clone())) { return true; }
        i = i + 1;
    }
    return false;
}

public fn build_harness_publish(path: string, payload: string) -> i32 {
    if (isDir(path.clone())) { return 1; }
    build_ensure_parent(path.clone());
    return build_publish_text_file(path, payload);
}
