module bootstrap.dap_main;

/// SDK debug entry point. CodeLLDB owns asynchronous execution, target
/// lifetime, lazy variables and debug information. No CLI text parsing or
/// duplicate frame/variable cache lives in this process.
use std.string;

extern "C" {
    fn vyx_dap_run_adapter(executable: rawptr) -> i32;
}

fn main() -> i32 {
    var i: i32 = 1;
    while (i < argCount()) {
        let a = getArg(i);
        if (a == "-h" || a == "--help" || a == "help") {
            print("vyxc-dap — Vyx SDK debugger (CodeLLDB / LLDB)");
            print("Usage: vyxc-dap [--stdio]");
            print("Uses bundled debugger/adapter/codelldb or VYX_DAP_ADAPTER.");
            return 0;
        }
        if (a != "--stdio") { return 2; }
        i = i + 1;
    }
    return vyx_dap_run_adapter(getArg(0).c_str());
}
