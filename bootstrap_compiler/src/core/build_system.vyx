fn build_is_windows() -> bool { return vyx_bootstrap_platform() == 1; }
fn build_is_linux() -> bool { return vyx_bootstrap_platform() == 2; }
fn build_is_android() -> bool { return vyx_bootstrap_platform() == 3; }
fn build_is_apple() -> bool { return vyx_bootstrap_platform() == 4; }

fn build_path_sep() -> string {
    if (build_is_windows()) { return "\\"; }
    return "/";
}

fn build_is_ident_char(c: i32) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c == 95) { return true; }
    return false;
}

fn build_default_llvm_root() -> string {
    let exe_dir = build_exe_dir();
    let direct = build_join_path(exe_dir.clone(), "clang");
    if (isDir(direct.clone())) { return direct; }
    let parent = build_dirname(exe_dir.clone());
    let from_parent = build_join_path(parent.clone(), "clang");
    if (isDir(from_parent.clone())) { return from_parent; }
    let grand = build_dirname(parent.clone());
    let from_grand = build_join_path(grand.clone(), "clang");
    if (isDir(from_grand.clone())) { return from_grand; }
    let relative = "../clang";
    if (isDir(relative)) { return relative; }
    return "";
}

fn build_env_fallback(name: string) -> string {
    if (name == "LLVM_ROOT") { return build_default_llvm_root(); }
    if (name == "LLVM_BIN") {
        let root = build_default_llvm_root();
        if (root.len > 0) { return build_join_path(root, "bin"); }
    }
    return "";
}

fn build_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return build_env_fallback(name); }
    let value = from_cstr(raw);
    if (value.len > 0) {
        let c0 = value.charAt(0);
        if (c0 == 36 || c0 == 37) { return build_env_fallback(name); }
    }
    if (value.len == 0) { return build_env_fallback(name); }
    return value;
}

fn build_expand_env_spec(spec: string) -> string {
    var name = spec;
    var default_val = "";
    var has_default = false;
    var i: i32 = 0;
    while (i + 1 < spec.len) {
        if (spec.charAt(i) == 58 && spec.charAt(i + 1) == 45) {
            name = spec.substring(0, i);
            default_val = spec.substring(i + 2, spec.len);
            has_default = true;
            break;
        }
        i = i + 1;
    }
    let val = build_env_value(name.trim());
    if (val.len > 0) { return val; }
    if (has_default) { return build_expand_env(default_val); }
    return "";
}

fn build_expand_env(text: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 36 && i + 1 < text.len) {
            if (text.charAt(i + 1) == 123) {
                var j: i32 = i + 2;
                var depth: i32 = 1;
                while (j < text.len && depth > 0) {
                    if (text.charAt(j) == 36 && j + 1 < text.len && text.charAt(j + 1) == 123) {
                        depth = depth + 1;
                        j = j + 2;
                        continue;
                    }
                    if (text.charAt(j) == 125) {
                        depth = depth - 1;
                        if (depth == 0) { break; }
                    }
                    j = j + 1;
                }
                if (j < text.len && depth == 0) {
                    out = out + build_expand_env_spec(text.substring(i + 2, j));
                    i = j + 1;
                    continue;
                }
            } else if (build_is_ident_char(text.charAt(i + 1))) {
                var j2: i32 = i + 1;
                while (j2 < text.len && build_is_ident_char(text.charAt(j2))) { j2 = j2 + 1; }
                out = out + build_expand_env_spec(text.substring(i + 1, j2));
                i = j2;
                continue;
            }
        } else if (build_is_windows() && c == 37) {
            var j3: i32 = i + 1;
            while (j3 < text.len && text.charAt(j3) != 37) { j3 = j3 + 1; }
            if (j3 < text.len) {
                out = out + build_expand_env_spec(text.substring(i + 1, j3));
                i = j3 + 1;
                continue;
            }
        }
        out = out + text.substring(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn build_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    return vyx_string_contains(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

fn build_requested_target() -> string {
    return policy_cli_requested_target();
}

fn build_target_platform_name(target: string) -> string {
    return policy_target_platform_name(target);
}

fn build_host_platform_name() -> string {
    if (build_is_windows()) { return "windows"; }
    if (build_is_android()) { return "android"; }
    if (build_is_linux()) { return "linux"; }
    if (build_is_apple()) { return "macos"; }
    return "";
}

fn build_effective_platform_name() -> string {
    let target = build_requested_target();
    if (target.len > 0) {
        return build_target_platform_name(target);
    }
    return build_host_platform_name();
}

fn build_effective_is_windows() -> bool { return build_effective_platform_name() == "windows"; }
fn build_effective_is_linux() -> bool { return build_effective_platform_name() == "linux"; }
fn build_effective_is_android() -> bool { return build_effective_platform_name() == "android"; }
fn build_effective_is_apple() -> bool { return build_effective_platform_name() == "macos"; }

fn build_parse_int(s: string) -> i32 {
    var i: i32 = 0;
    var sign: i32 = 1;
    var out: i32 = 0;
    let t = s.trim();
    if (t.len == 0) { return 0; }
    if (t.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (t.charAt(0) == 43) {
        i = 1;
    }
    while (i < t.len) {
        let c = t.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

fn build_parse_i64(s: string) -> i64 {
    var i: i32 = 0;
    var sign: i64 = 1;
    var out: i64 = 0;
    let t = s.trim();
    if (t.len == 0) { return 0; }
    if (t.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (t.charAt(0) == 43) {
        i = 1;
    }
    while (i < t.len) {
        let c = t.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

fn build_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return "."; }
    if (last == 0) { return path.substring(0, 1); }
    return path.substring(0, last);
}

fn build_join_path(dir: string, rel: string) -> string {
    if (dir.len == 0 || dir == ".") { return rel; }
    if (dir.endsWith("/") || dir.endsWith("\\")) { return dir + rel; }
    return dir + build_path_sep() + rel;
}

fn build_host_path(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (build_is_windows() && c == 47) {
            out = out + "\\";
        } else if (!build_is_windows() && c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn build_file_mtime(path: string) -> i64 {
    if (path.len == 0) { return -1; }
    let host_path = build_host_path(path);
    return vyx_bootstrap_file_mtime(host_path.c_str());
}

fn build_norm_path(path: string) -> string {
    var out = build_host_path(path);
    while (out.startsWith(".\\")) {
        out = out.substring(2, out.len);
    }
    while (out.startsWith("./")) {
        out = out.substring(2, out.len);
    }
    return out;
}

fn build_ascii_lower(text: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c >= 65 && c <= 90) {
            out = out + text.substring(i, i + 1).toLower();
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn build_same_abs_path(a: string, b: string) -> bool {
    let aa = build_abs_norm_path(a);
    let bb = build_abs_norm_path(b);
    if (build_is_windows()) {
        return build_ascii_lower(aa) == build_ascii_lower(bb);
    }
    return aa == bb;
}

fn build_path_compare_key(path: string) -> string {
    var key = build_norm_path(path);
    if (build_is_windows()) {
        key = build_ascii_lower(key);
    }
    return key;
}

fn build_same_path_loose(a: string, b: string) -> bool {
    let aa = build_path_compare_key(a);
    let bb = build_path_compare_key(b);
    if (aa == bb) { return true; }
    if (build_same_abs_path(a.clone(), b.clone())) { return true; }
    if (aa.endsWith(build_path_sep() + bb)) { return true; }
    if (bb.endsWith(build_path_sep() + aa)) { return true; }
    if (build_is_windows()) {
        if (aa.endsWith("\\" + bb) || aa.endsWith("/" + bb)) { return true; }
        if (bb.endsWith("\\" + aa) || bb.endsWith("/" + aa)) { return true; }
    }
    return false;
}

fn build_alias_targets_running_exe(alias_path: string, self_exe: string) -> bool {
    if (build_same_abs_path(alias_path.clone(), self_exe.clone())) { return true; }
    if (build_is_windows()) {
        return build_ascii_lower(build_path_basename(alias_path))
            == build_ascii_lower(build_path_basename(self_exe));
    }
    return false;
}

fn build_is_abs_path(path: string) -> bool {
    let p = build_host_path(path);
    if (p.len >= 2 && p.charAt(1) == 58) { return true; }
    if (p.len >= 1 && (p.charAt(0) == 47 || p.charAt(0) == 92)) { return true; }
    return false;
}

fn build_abs_norm_path(path: string) -> string {
    let abs = vyx_bootstrap_abs_path(build_host_path(path).c_str());
    if (abs == null) { return build_host_path(path); }
    return from_cstr(abs);
}

fn build_quote(path: string) -> string {
    return "\"" + build_host_path(build_expand_env(path)) + "\"";
}

fn build_quote_arg(arg: string) -> string {
    var out = "\"";
    var i: i32 = 0;
    while (i < arg.len) {
        let c = arg.charAt(i);
        if (c == 34) {
            out = out + "\\\"";
        } else {
            out = out + arg.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn build_make_dir(path: string) -> i32 {
    if (path.len == 0 || path == ".") { return 0; }
    return vyx_bootstrap_mkdir_p(build_host_path(path).c_str());
}

fn build_ensure_parent(path: string) {
    let dir = build_dirname(path);
    if (dir.len > 0 && dir != ".") {
        build_make_dir(dir);
    }
}

fn build_path_stem(path: string) -> string {
    var start: i32 = 0;
    var dot: i32 = path.len as i32;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) {
            start = i + 1;
            dot = path.len as i32;
        } else if (c == 46) {
            dot = i;
        }
        i = i + 1;
    }
    if (dot < start) { dot = path.len as i32; }
    return path.substring(start, dot);
}

fn build_path_basename(path: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    return path.substring(start, path.len);
}

fn build_safe_obj_name(src: string, suffix: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < src.len) {
        let c = src.charAt(i);
        let is_digit = c >= 48 && c <= 57;
        let is_upper = c >= 65 && c <= 90;
        let is_lower = c >= 97 && c <= 122;
        if (is_digit || is_upper || is_lower) {
            out = out + src.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { out = build_path_stem(src); }
    return out + suffix;
}

fn build_toml_get(content: string, want_section: string, want_key: string) -> string {
    var section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key == want_key) {
                        var value = toml_value(line);
                        // Multi-line array support: when the value opens with
                        // `[` but doesn't close, keep folding subsequent lines
                        // (stripping comments/whitespace) until we see the
                        // matching `]`. Quoted strings are honored so a `]`
                        // inside a string doesn't terminate the array.
                        let trimmed_value = value.trim();
                        if (trimmed_value.startsWith("[") && !trimmed_value.endsWith("]")) {
                            var bracket: i32 = 0;
                            var in_quote: bool = false;
                            var vi: i32 = 0;
                            while (vi < trimmed_value.len) {
                                let vc = trimmed_value.charAt(vi);
                                if (vc == 34) { in_quote = !in_quote; }
                                else if (!in_quote) {
                                    if (vc == 91) { bracket = bracket + 1; }
                                    else if (vc == 93) { bracket = bracket - 1; }
                                }
                                vi = vi + 1;
                            }
                            var j: i32 = i + 1;
                            var line_start: i32 = j;
                            value = trimmed_value;
                            while (j <= content.len && bracket > 0) {
                                if (j == content.len || content.charAt(j) == 10) {
                                    var nl = content.substring(line_start, j).trim();
                                    if (nl.endsWith("\r")) {
                                        nl = nl.substring(0, nl.len - 1).trim();
                                    }
                                    if (!toml_is_comment(nl.clone()) && nl.len > 0) {
                                        value = value + " " + nl;
                                        var ni: i32 = 0;
                                        while (ni < nl.len) {
                                            let nc = nl.charAt(ni);
                                            if (nc == 34) { in_quote = !in_quote; }
                                            else if (!in_quote) {
                                                if (nc == 91) { bracket = bracket + 1; }
                                                else if (nc == 93) { bracket = bracket - 1; }
                                            }
                                            ni = ni + 1;
                                        }
                                    }
                                    line_start = j + 1;
                                }
                                j = j + 1;
                            }
                        }
                        return value;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_manifest_is_zyn_app(content: string) -> bool {
    if (build_toml_get(content.clone(), "zyn.app", "name").trim().len > 0) { return true; }
    if (build_toml_get(content.clone(), "zyn.app", "id").trim().len > 0) { return true; }
    if (build_toml_get(content, "zyn.app", "entry").trim().len > 0) { return true; }
    return false;
}

fn build_zyn_sdk_root_is_valid(path: string) -> bool {
    if (path.len == 0) { return false; }
    if (!fileExists(build_join_path(path.clone(), "Vyx.toml"))) { return false; }
    return fileExists(build_join_path(path, "src/Zyn.vyx"));
}

fn build_zyn_sdk_root() -> string {
    let root = build_env_value("ZYN_SDK_ROOT");
    if (build_zyn_sdk_root_is_valid(root.clone())) { return root; }
    let home = build_env_value("ZYN_HOME");
    if (build_zyn_sdk_root_is_valid(home.clone())) { return home; }
    return "";
}

fn build_dependency_lines_has(deps: string, name: string) -> bool {
    var i: i64 = 0;
    let count = build_line_count(deps.clone());
    while (i < count) {
        let line = build_line_at(deps.clone(), i);
        if (build_field(line, 0) == name) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_zyn_app_android_output_dir(base: string) -> string {
    let target = build_requested_target().trim();
    if (target.len > 0) { return build_join_path(base, target); }
    return build_join_path(base, "android");
}

fn build_platform_suffix() -> string {
    if (build_effective_is_windows()) { return "_windows"; }
    if (build_effective_is_android()) { return "_android"; }
    if (build_effective_is_linux()) { return "_linux"; }
    if (build_effective_is_apple()) { return "_apple"; }
    return "";
}

fn build_merge_toml_arrays(base: string, extra: string) -> string {
    let a = base.trim();
    let b = extra.trim();
    if (a.len == 0) { return b; }
    if (b.len == 0) { return a; }
    if (!a.endsWith("]") || !b.startsWith("[")) { return a; }
    let left = a.substring(0, a.len - 1).trim();
    let right = b.substring(1, b.len - 1).trim();
    if (right.len == 0) { return a; }
    if (left == "[") { return "[" + right + "]"; }
    return left + ", " + right + "]";
}

fn build_toml_get_platform_array_raw(content: string, want_section: string, want_key: string) -> string {
    let base = build_toml_get(content.clone(), want_section.clone(), want_key.clone());
    let suffix = build_platform_suffix();
    if (suffix.len == 0) { return base; }
    let extra = build_toml_get(content, want_section, want_key + suffix);
    return build_merge_toml_arrays(base, extra);
}

fn build_toml_get_platform_value_raw(content: string, want_section: string, want_key: string) -> string {
    let suffix = build_platform_suffix();
    if (suffix.len > 0) {
        let platform_value = build_toml_get(content.clone(), want_section.clone(), want_key + suffix);
        if (platform_value.len > 0) { return platform_value; }
    }
    return build_toml_get(content, want_section, want_key);
}

fn build_target_linkage_name(kind: string) -> string {
    let normalized = kind.trim().toLower();
    if (normalized == "static" || normalized == "staticlib") { return "static"; }
    if (normalized == "shared" || normalized == "dylib" || normalized == "library") {
        return "shared";
    }
    return "";
}

fn build_triplet_merge_key(content: string,
                           section: string,
                           key: string,
                           suffix: string,
                           current: string) -> string {
    if (suffix.len == 0) { return current; }
    return build_merge_toml_arrays(
        current,
        build_toml_get(content, section, key + suffix));
}

/// Arrays used by the linker are cumulative from general to specific:
///
///   libs
///   libs_windows
///   libs_windows_x64
///   libs_windows_x64_msvc
///   libs_windows_x64_msvc_static
///
/// Every matching layer is appended. This keeps portable dependencies in the
/// base key while allowing a target to add only its platform-specific tail.
fn build_toml_get_triplet_link_array_raw(content: string,
                                         section: string,
                                         key: string,
                                         target_kind: string) -> string {
    var out = build_toml_get(content.clone(), section.clone(), key.clone());
    let triple = policy_effective_target_triple();
    let platform = policy_target_platform_name(triple.clone());
    let arch = policy_target_arch_name(triple.clone());
    let compiler = policy_target_compiler_name(triple);
    let linkage = build_target_linkage_name(target_kind);
    if (platform.len == 0) { return out; }

    // `_apple` was the original spelling. Preserve it as an additive legacy
    // layer while making `_macos` the canonical OS branch.
    let legacy = build_platform_suffix();
    if (legacy.len > 0 && legacy != "_" + platform) {
        out = build_triplet_merge_key(content.clone(), section.clone(), key.clone(), legacy, out);
    }
    let os_suffix = "_" + platform;
    out = build_triplet_merge_key(content.clone(), section.clone(), key.clone(), os_suffix.clone(), out);
    if (arch.len == 0) { return out; }
    let arch_suffix = os_suffix + "_" + arch;
    out = build_triplet_merge_key(content.clone(), section.clone(), key.clone(), arch_suffix.clone(), out);
    if (compiler.len == 0) { return out; }
    let compiler_suffix = arch_suffix + "_" + compiler;
    out = build_triplet_merge_key(content.clone(), section.clone(), key.clone(), compiler_suffix.clone(), out);
    if (linkage.len > 0) {
        out = build_triplet_merge_key(content,
                                      section,
                                      key,
                                      compiler_suffix + "_" + linkage,
                                      out);
    }
    return out;
}

fn build_manifest_section_exists(content: string, want_section: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (toml_is_section(line.clone()) && toml_section_name(line) == want_section) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn build_is_root_target_section(section: string) -> bool {
    if (!section.startsWith("target.") || section.len <= 7) { return false; }
    return !build_contains(section.substring(7, section.len), ".");
}

fn build_array_rows_contains(rows: string, want: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        if (build_line_at(rows.clone(), i) == want) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_array_rows_append_unique(rows: string, values: string) -> string {
    var out = rows;
    var i: i64 = 0;
    let n = build_line_count(values.clone());
    while (i < n) {
        let value = build_line_at(values.clone(), i);
        if (value.len > 0 && !build_array_rows_contains(out.clone(), value.clone())) {
            out = out + value + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn build_array_rows_remove(rows: string, removals: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let value = build_line_at(rows.clone(), i);
        if (!build_array_rows_contains(removals.clone(), value.clone())) {
            out = out + value + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn build_toml_quote_array_value(value: string) -> string {
    // The bootstrap TOML reader preserves backslashes literally rather than
    // decoding TOML escapes, so doubling a Windows separator here would alter
    // the effective path after a template merge.
    return "\"" + value.replace("\"", "\\\"") + "\"";
}

fn build_toml_array_from_rows(rows: string) -> string {
    var out = "[";
    var first = true;
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let value = build_line_at(rows.clone(), i);
        if (value.len > 0) {
            if (!first) { out = out + ", "; }
            out = out + build_toml_quote_array_value(value);
            first = false;
        }
        i = i + 1;
    }
    return out + "]";
}

fn build_merge_toml_arrays_unique(base: string, extra: string) -> string {
    if (base.trim().len == 0 && extra.trim().len == 0) { return ""; }
    var rows = build_array_rows_append_unique("", toml_array_to_lines(base));
    rows = build_array_rows_append_unique(rows, toml_array_to_lines(extra));
    return build_toml_array_from_rows(rows);
}

fn build_remove_toml_array(base: string, removals: string) -> string {
    if (base.trim().len == 0) { return ""; }
    let rows = build_array_rows_append_unique("", toml_array_to_lines(base));
    let remove_rows = build_array_rows_append_unique("", toml_array_to_lines(removals));
    return build_toml_array_from_rows(build_array_rows_remove(rows, remove_rows));
}

fn build_template_order_visit(manifest: string,
                              template_name: string,
                              visiting: string,
                              done: string) -> string {
    if (build_array_rows_contains(done.clone(), template_name.clone())) { return done; }
    if (build_array_rows_contains(visiting.clone(), template_name.clone())) {
        print(build_error_label() + ": target template inheritance cycle at '" + template_name + "'");
        return "|ERR|";
    }
    let section = "template." + template_name;
    if (!build_manifest_section_exists(manifest.clone(), section.clone())) {
        print(build_error_label() + ": target template not found: '" + template_name + "'");
        return "|ERR|";
    }
    var order = done;
    let next_visiting = visiting + template_name + "\n";
    let parents = toml_array_to_lines(
        build_toml_get_platform_array_raw(manifest.clone(), section.clone(), "extends"));
    var i: i64 = 0;
    let n = build_line_count(parents.clone());
    while (i < n) {
        let parent = build_line_at(parents.clone(), i).trim();
        if (parent.len > 0) {
            order = build_template_order_visit(manifest.clone(),
                                               parent,
                                               next_visiting.clone(),
                                               order);
            if (order == "|ERR|") { return order; }
        }
        i = i + 1;
    }
    if (!build_array_rows_contains(order.clone(), template_name.clone())) {
        order = order + template_name + "\n";
    }
    return order;
}

/// Return inherited template sections in effective order, followed by the
/// concrete target section. Multiple `extends` entries are applied left to
/// right; a shared ancestor is materialized once at its first position.
fn build_effective_target_layers(manifest: string, target_section: string) -> string {
    if (!build_is_root_target_section(target_section.clone())) { return target_section + "\n"; }
    var order: string = "";
    let templates = toml_array_to_lines(
        build_toml_get_platform_array_raw(manifest.clone(), target_section.clone(), "extends"));
    var i: i64 = 0;
    let n = build_line_count(templates.clone());
    while (i < n) {
        let template_name = build_line_at(templates.clone(), i).trim();
        if (template_name.len > 0) {
            order = build_template_order_visit(manifest.clone(), template_name, "", order);
            if (order == "|ERR|") { return order; }
        }
        i = i + 1;
    }
    var layers: string = "";
    i = 0;
    let count = build_line_count(order.clone());
    while (i < count) {
        layers = layers + "template." + build_line_at(order.clone(), i) + "\n";
        i = i + 1;
    }
    return layers + target_section + "\n";
}

fn build_target_inherits_build_key(key: string) -> bool {
    // Package-wide pre/post hooks are executed once by build_system_run and
    // must not be replayed as target hooks for every effective target.
    return !(key == "prebuild" || key == "pre"
             || key == "postbuild" || key == "post");
}

fn build_effective_target_platform_value(manifest: string,
                                         target_section: string,
                                         key: string) -> string {
    var out: string = "";
    if (build_target_inherits_build_key(key.clone())) {
        out = build_toml_get_platform_value_raw(manifest.clone(), "build", key.clone());
    }
    let layers = build_effective_target_layers(manifest.clone(), target_section);
    if (layers == "|ERR|") { return ""; }
    var i: i64 = 0;
    let n = build_line_count(layers.clone());
    while (i < n) {
        let value = build_toml_get_platform_value_raw(
            manifest.clone(), build_line_at(layers.clone(), i), key.clone());
        if (value.len > 0) { out = value; }
        i = i + 1;
    }
    return out;
}

fn build_effective_target_platform_array(manifest: string,
                                         target_section: string,
                                         key: string) -> string {
    var out: string = "";
    var removals: string = "";
    if (build_target_inherits_build_key(key.clone())) {
        out = build_toml_get_platform_array_raw(manifest.clone(), "build", key.clone());
        removals = build_toml_get_platform_array_raw(
            manifest.clone(), "build", key.clone() + "_remove");
    }
    let layers = build_effective_target_layers(manifest.clone(), target_section);
    if (layers == "|ERR|") { return ""; }
    var i: i64 = 0;
    let n = build_line_count(layers.clone());
    while (i < n) {
        let layer = build_line_at(layers.clone(), i);
        out = build_merge_toml_arrays_unique(
            out,
            build_toml_get_platform_array_raw(manifest.clone(), layer.clone(), key.clone()));
        removals = build_merge_toml_arrays_unique(
            removals,
            build_toml_get_platform_array_raw(manifest.clone(), layer, key.clone() + "_remove"));
        i = i + 1;
    }
    return build_remove_toml_array(out, removals);
}

fn build_effective_target_triplet_link_array(manifest: string,
                                             target_section: string,
                                             key: string,
                                             target_kind: string) -> string {
    var out = build_toml_get_triplet_link_array_raw(
        manifest.clone(), "build", key.clone(), target_kind.clone());
    out = build_merge_toml_arrays_unique(
        out,
        build_toml_get_triplet_link_array_raw(
            manifest.clone(), "build.link", key.clone(), target_kind.clone()));
    var removals = build_toml_get_triplet_link_array_raw(
        manifest.clone(), "build", key.clone() + "_remove", target_kind.clone());
    removals = build_merge_toml_arrays_unique(
        removals,
        build_toml_get_triplet_link_array_raw(
            manifest.clone(), "build.link", key.clone() + "_remove", target_kind.clone()));
    let layers = build_effective_target_layers(manifest.clone(), target_section);
    if (layers == "|ERR|") { return ""; }
    var i: i64 = 0;
    let n = build_line_count(layers.clone());
    while (i < n) {
        let layer = build_line_at(layers.clone(), i);
        out = build_merge_toml_arrays_unique(
            out,
            build_toml_get_triplet_link_array_raw(
                manifest.clone(), layer.clone(), key.clone(), target_kind.clone()));
        out = build_merge_toml_arrays_unique(
            out,
            build_toml_get_triplet_link_array_raw(
                manifest.clone(), layer.clone() + ".link", key.clone(), target_kind.clone()));
        removals = build_merge_toml_arrays_unique(
            removals,
            build_toml_get_triplet_link_array_raw(
                manifest.clone(), layer.clone(), key.clone() + "_remove", target_kind.clone()));
        removals = build_merge_toml_arrays_unique(
            removals,
            build_toml_get_triplet_link_array_raw(
                manifest.clone(), layer + ".link", key.clone() + "_remove", target_kind.clone()));
        i = i + 1;
    }
    return build_remove_toml_array(out, removals);
}

public fn build_toml_get_platform_array(content: string, want_section: string, want_key: string) -> string {
    if (build_is_root_target_section(want_section.clone())) {
        return build_effective_target_platform_array(content, want_section, want_key);
    }
    return build_toml_get_platform_array_raw(content, want_section, want_key);
}

public fn build_toml_get_platform_value(content: string, want_section: string, want_key: string) -> string {
    if (build_is_root_target_section(want_section.clone())) {
        return build_effective_target_platform_value(content, want_section, want_key);
    }
    return build_toml_get_platform_value_raw(content, want_section, want_key);
}

public fn build_toml_get_triplet_link_array(content: string,
                                            section: string,
                                            key: string,
                                            target_kind: string) -> string {
    if (build_is_root_target_section(section.clone())) {
        return build_effective_target_triplet_link_array(content, section, key, target_kind);
    }
    return build_toml_get_triplet_link_array_raw(content, section, key, target_kind);
}

fn build_toml_single_path_array(path: string) -> string {
    if (path.len == 0) { return ""; }
    return "[\"" + path.replace("\\", "/") + "\"]";
}

/// Auto-index the conventional per-triplet library tree. Search paths are
/// emitted from most-specific to most-general so a specialized archive wins
/// over a same-named fallback in `libs/`.
fn build_auto_triplet_lib_paths_from(root: string, target_kind: string) -> string {
    var out: string = "";
    let base_path = build_join_path(root, "libs");
    let triple = policy_effective_target_triple();
    let platform = policy_target_platform_name(triple.clone());
    let arch = policy_target_arch_name(triple.clone());
    let compiler = policy_target_compiler_name(triple);
    let linkage = build_target_linkage_name(target_kind);
    var os_path: string = "";
    var arch_path: string = "";
    var compiler_path: string = "";
    var linkage_path: string = "";
    if (platform.len > 0) {
        os_path = build_join_path(base_path.clone(), platform);
    }
    if (os_path.len > 0 && arch.len > 0) {
        arch_path = build_join_path(os_path.clone(), arch);
    }
    if (arch_path.len > 0 && compiler.len > 0) {
        compiler_path = build_join_path(arch_path.clone(), compiler);
    }
    if (compiler_path.len > 0 && linkage.len > 0) {
        linkage_path = build_join_path(compiler_path.clone(), linkage);
    }
    if (linkage_path.len > 0 && isDir(linkage_path.clone())) {
        out = build_merge_toml_arrays(out, build_toml_single_path_array(linkage_path));
    }
    if (compiler_path.len > 0 && isDir(compiler_path.clone())) {
        out = build_merge_toml_arrays(out, build_toml_single_path_array(compiler_path));
    }
    if (arch_path.len > 0 && isDir(arch_path.clone())) {
        out = build_merge_toml_arrays(out, build_toml_single_path_array(arch_path));
    }
    if (os_path.len > 0 && isDir(os_path.clone())) {
        out = build_merge_toml_arrays(out, build_toml_single_path_array(os_path));
    }
    if (isDir(base_path.clone())) {
        out = build_merge_toml_arrays(out, build_toml_single_path_array(base_path));
    }
    return out;
}

fn build_auto_triplet_lib_paths(target_kind: string) -> string {
    return build_auto_triplet_lib_paths_from(".", target_kind);
}

fn build_target_sections(content: string, default_name: string) -> string {
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (toml_is_section(line.clone())) {
                let section = toml_section_name(line);
                if (section.startsWith("target.")
                    && !build_contains(section.substring(7, section.len), ".")) {
                    out = out + section + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (out.len == 0) {
        return "target." + default_name + "\n";
    }
    return out;
}

fn build_target_name(section: string, default_name: string) -> string {
    if (section.startsWith("target.") && section.len > 7) {
        return section.substring(7, section.len);
    }
    return default_name;
}

fn build_line_count(rows: string) -> i64 {
    var count: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn build_line_at(rows: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) {
                if (idx == want) {
                    return rows.substring(start, i);
                }
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_field(line: string, want: i32) -> string {
    var idx: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= line.len) {
        if (i == line.len || line.charAt(i) == 9) {
            if (idx == want) { return line.substring(start, i); }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_append_unique_line(rows: string, value: string) -> string {
    if (value.len == 0) { return rows; }
    let key = build_norm_path(value);
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        if (build_norm_path(build_line_at(rows.clone(), i)) == key) { return rows; }
        i = i + 1;
    }
    return rows + value + "\n";
}

fn build_append_source_lines_unique(rows: string, values: string) -> string {
    var out = rows;
    var i: i64 = 0;
    let n = build_line_count(values);
    while (i < n) {
        out = build_append_unique_line(out.clone(), build_line_at(values.clone(), i));
        i = i + 1;
    }
    return out;
}

fn build_source_matches_exclude(src: string, excludes: string) -> bool {
    if (src.len == 0 || excludes.len == 0) { return false; }
    let key = build_ascii_lower(build_norm_path(src));
    var i: i64 = 0;
    let n = build_line_count(excludes.clone());
    while (i < n) {
        let raw = build_line_at(excludes.clone(), i).trim();
        if (raw.len > 0) {
            let pat = build_ascii_lower(build_norm_path(raw));
            if (key == pat || key.endsWith(build_path_sep() + pat)
                || key.endsWith("/" + pat) || key.endsWith("\\" + pat)) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

fn build_filter_source_excludes(rows: string, excludes: string) -> string {
    if (rows.len == 0 || excludes.len == 0) { return rows; }
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let src = build_line_at(rows.clone(), i);
        if (!build_source_matches_exclude(src.clone(), excludes.clone())) {
            out = build_append_unique_line(out.clone(), src);
        }
        i = i + 1;
    }
    return out;
}

fn build_trim_quotes(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len >= 2) {
        if (trimmed.startsWith("\"") && trimmed.endsWith("\"")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
        if (trimmed.startsWith("'") && trimmed.endsWith("'")) {
            return trimmed.substring(1, trimmed.len - 1);
        }
    }
    return trimmed;
}

fn build_toml_command_lines(value: string) -> string {
    let trimmed = value.trim();
    if (trimmed.len == 0) { return ""; }
    if (!trimmed.startsWith("[")) {
        return trimmed + "\n";
    }
    if (!trimmed.endsWith("]")) {
        return build_trim_quotes(trimmed) + "\n";
    }
    var raw = trimmed.substring(1, trimmed.len - 1);
    var out: string = "";
    var item: string = "";
    var in_quote: bool = false;
    var i: i32 = 0;
    while (i < raw.len) {
        let c = raw.charAt(i);
        if (c == 34) {
            in_quote = !in_quote;
            item = item + raw.substring(i, i + 1);
        } else if (!in_quote && c == 44) {
            let cmd = build_trim_quotes(item);
            if (cmd.len > 0) {
                out = out + cmd + "\n";
            }
            item = "";
        } else {
            item = item + raw.substring(i, i + 1);
        }
        i = i + 1;
    }
    let tail = build_trim_quotes(item);
    if (tail.len > 0) {
        out = out + tail + "\n";
    }
    return out;
}

fn build_manifest_hook_lines(manifest: string, section: string, primary: string, alias: string) -> string {
    var out = build_toml_command_lines(build_toml_get_platform_array(manifest.clone(), section.clone(), primary));
    if (alias.len > 0) {
        let extra = build_toml_command_lines(build_toml_get_platform_array(manifest, section, alias));
        out = out + extra;
    }
    return out;
}

fn build_manifest_script_lines(manifest: string, script: string) -> string {
    return build_toml_command_lines(build_toml_get_platform_array(manifest, "scripts", script));
}

fn build_command_head_split(command: string) -> string {
    var head = "";
    var tail = "";
    let trimmed = command.trim();
    if (trimmed.len == 0) { return "\t"; }
    if (trimmed.startsWith("\"")) {
        var i: i32 = 1;
        while (i < trimmed.len && trimmed.charAt(i) != 34) {
            i = i + 1;
        }
        if (i < trimmed.len) {
            head = trimmed.substring(1, i);
            tail = trimmed.substring(i + 1, trimmed.len).trim();
            return head + "\t" + tail;
        }
    }
    var j: i32 = 0;
    while (j < trimmed.len) {
        let c = trimmed.charAt(j);
        if (c == 32 || c == 9) { break; }
        j = j + 1;
    }
    head = trimmed.substring(0, j);
    if (j < trimmed.len) {
        tail = trimmed.substring(j, trimmed.len).trim();
    }
    return head + "\t" + tail;
}

fn build_hook_command_with_args(self_exe: string, command: string, extra_args: string) -> string {
    let expanded = build_expand_env(command.trim());
    if (expanded.len == 0) { return ""; }
    if (expanded.startsWith("vyx:")) {
        let body = expanded.substring(4, expanded.len).trim();
        if (body.len == 0) { return ""; }
        let split = build_command_head_split(body);
        let script = build_field(split.clone(), 0);
        let args = build_field(split, 1);
        if (script.len == 0) { return ""; }
        var cmd = build_tool_arg(self_exe) + " --run=aot --src=file " + build_quote(script);
        if (args.len > 0) {
            cmd = cmd + " -- " + args;
        } else if (extra_args.len > 0) {
            cmd = cmd + " --";
        }
        if (extra_args.len > 0) {
            cmd = cmd + " " + extra_args;
        }
        return cmd;
    }
    if (expanded.endsWith(".vyx")) {
        var cmd2 = build_tool_arg(self_exe) + " --run=aot --src=file " + build_quote(expanded);
        if (extra_args.len > 0) {
            cmd2 = cmd2 + " -- " + extra_args;
        }
        return cmd2;
    }
    return expanded;
}

fn build_hook_command(self_exe: string, command: string) -> string {
    return build_hook_command_with_args(self_exe, command, "");
}

fn build_run_hook_list(self_exe: string, cwd: string, scope: string, stage: string, hooks: string) -> i32 {
    let count = build_line_count(hooks.clone());
    var i: i64 = 0;
    while (i < count) {
        let raw = build_line_at(hooks.clone(), i).trim();
        if (raw.len > 0) {
            let cmd = build_hook_command(self_exe.clone(), raw);
            if (cmd.len > 0) {
                print("[hook] " + scope + "." + stage + ": " + raw);
                let rc = build_run_process(cmd, cwd, "", "");
                if (rc != 0) {
                    print("error: hook failed: " + scope + "." + stage + " (exit " + rc.toString() + ")");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn build_script_spec_split(spec: string) -> string {
    let trimmed = spec.trim();
    var i: i32 = 0;
    while (i < trimmed.len) {
        if (trimmed.charAt(i) == 58) {
            let pkg = trimmed.substring(0, i).trim();
            let name = trimmed.substring(i + 1, trimmed.len).trim();
            return pkg + "\t" + name;
        }
        i = i + 1;
    }
    return "\t" + trimmed;
}

fn build_run_script_extra_args() -> string {
    let argc = argCount();
    var out = "";
    var i: i32 = 3;
    while (i < argc) {
        let a = getArg(i);
        if (a != "--") {
            out = out + " " + build_quote_arg(a);
        }
        i = i + 1;
    }
    return out.trim();
}

fn build_run_script_list(self_exe: string, cwd: string, scope: string, script: string, commands: string, extra_args: string) -> i32 {
    let count = build_line_count(commands.clone());
    var i: i64 = 0;
    while (i < count) {
        let raw = build_line_at(commands.clone(), i).trim();
        if (raw.len > 0) {
            let base = build_hook_command_with_args(self_exe.clone(), raw, extra_args.clone());
            if (base.len > 0) {
                var cmd = base;
                print("[run] " + scope + ":" + script + ": " + raw);
                let rc = build_run_process(cmd, cwd, "", "");
                if (rc != 0) {
                    print("error: script failed: " + scope + ":" + script + " (exit " + rc.toString() + ")");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn build_source_kind(src: string) -> string {
    if (src.endsWith(".c")) { return "c"; }
    if (src.endsWith(".cpp") || src.endsWith(".cc") || src.endsWith(".cxx")) { return "cpp"; }
    return "vyx";
}

// Group construction asks for the same module name many times (including
// while planning each root chunk). Cache the source result by its observed
// mtime/size so a large module is parsed once per source revision rather than
// once per pair of candidate sources.
var g_build_module_name_cache: string = "";

fn build_module_name_cache_key(path: string) -> string {
    return "module_name\t" + path + "\t"
           + build_file_mtime(path.clone()).toString() + "\t"
           + fileSize(path.clone()).toString() + "\t";
}

fn build_module_name_cache_get(key: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= g_build_module_name_cache.len) {
        if (i == g_build_module_name_cache.len || g_build_module_name_cache.charAt(i) == 10) {
            let line = g_build_module_name_cache.substring(start, i);
            if (line.startsWith(key)) { return line.substring(key.len, line.len); }
            start = i + 1;
        }
        i = i + 1;
    }
    return "<MISS>";
}

fn build_module_name_from_file(path: string) -> string {
    if (path.len == 0 || !fileExists(path.clone())) { return ""; }
    let cache_key = build_module_name_cache_key(path.clone());
    let cached = build_module_name_cache_get(cache_key.clone());
    if (cached != "<MISS>") { return cached; }
    let content = readFile(path);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line_end: i32 = i;
            if (line_end > start && content.charAt(line_end - 1) == 13) {
                line_end = line_end - 1;
            }
            var p: i32 = start;
            while (p < line_end) {
                let c = content.charAt(p);
                if (c != 32 && c != 9) { break; }
                p = p + 1;
            }
            if (p < line_end) {
                if (p + 1 < line_end
                    && content.charAt(p) == 47
                    && content.charAt(p + 1) == 47) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                // Module headers may be prefixed by version/variant attributes.
                // They describe the same source module and must not terminate
                // registry discovery before the following `module` declaration.
                if (content.charAt(p) == 64) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (p + 6 < line_end
                    && content.charAt(p) == 109
                    && content.charAt(p + 1) == 111
                    && content.charAt(p + 2) == 100
                    && content.charAt(p + 3) == 117
                    && content.charAt(p + 4) == 108
                    && content.charAt(p + 5) == 101
                    && (content.charAt(p + 6) == 32 || content.charAt(p + 6) == 9)) {
                    var name_start: i32 = p + 7;
                    while (name_start < line_end) {
                        let nc = content.charAt(name_start);
                        if (nc != 32 && nc != 9) { break; }
                        name_start = name_start + 1;
                    }
                    var semi: i32 = name_start;
                    while (semi < line_end && content.charAt(semi) != 59) {
                        semi = semi + 1;
                    }
                    if (semi < line_end) {
                        var name_end: i32 = semi;
                        while (name_end > name_start) {
                            let tc = content.charAt(name_end - 1);
                            if (tc != 32 && tc != 9) { break; }
                            name_end = name_end - 1;
                        }
                        if (name_end > name_start) {
                            out = content.substring(name_start, name_end);
                        }
                    }
                    break;
                }
                break;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    str_drop(content);
    g_build_module_name_cache = g_build_module_name_cache + cache_key + out.clone() + "\n";
    return out;
}

// Modules with the same source name can represent distinct version/variant
// implementations.  Keep their object groups separate while retaining the
// base-name scanner for import-closure discovery.
var g_build_module_identity_cache: string = "";

fn build_module_identity_cache_key(path: string) -> string {
    return "module_identity\t" + path + "\t"
           + build_file_mtime(path.clone()).toString() + "\t"
           + fileSize(path.clone()).toString() + "\t";
}

fn build_module_identity_cache_get(key: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= g_build_module_identity_cache.len) {
        if (i == g_build_module_identity_cache.len || g_build_module_identity_cache.charAt(i) == 10) {
            let line = g_build_module_identity_cache.substring(start, i);
            if (line.startsWith(key)) { return line.substring(key.len, line.len); }
            start = i + 1;
        }
        i = i + 1;
    }
    return "<MISS>";
}

fn build_module_identity_from_file(path: string) -> string {
    if (path.len == 0 || !fileExists(path.clone())) { return ""; }
    let base = build_module_name_from_file(path.clone());
    if (base.len == 0) { return ""; }
    let cache_key = build_module_identity_cache_key(path.clone());
    let cached = build_module_identity_cache_get(cache_key.clone());
    if (cached != "<MISS>") { return cached; }

    let content = readFile(path);
    var leading_meta: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line_end: i32 = i;
            if (line_end > start && content.charAt(line_end - 1) == 13) {
                line_end = line_end - 1;
            }
            var p: i32 = start;
            while (p < line_end) {
                let c = content.charAt(p);
                if (c != 32 && c != 9) { break; }
                p = p + 1;
            }
            if (p < line_end) {
                if (p + 1 < line_end
                    && content.charAt(p) == 47
                    && content.charAt(p + 1) == 47) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (content.charAt(p) == 64) {
                    leading_meta = leading_meta + content.substring(p, line_end);
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                break;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    str_drop(content);
    let out = policy_module_identity_from_meta(base, leading_meta);
    g_build_module_identity_cache = g_build_module_identity_cache + cache_key + out.clone() + "\n";
    return out;
}

fn build_source_lines_have_versioned_module(sources: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let path = build_line_at(sources.clone(), i);
        if (path.endsWith(".vyx") && fileExists(path.clone())) {
            let base = build_module_name_from_file(path.clone());
            if (base.len > 0 && build_module_identity_from_file(path) != base) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

fn build_source_group_key(src: string) -> string {
    let kind = build_source_kind(src.clone());
    if (kind != "vyx") {
        return "file:" + build_norm_path(src);
    }
    let mod = build_module_identity_from_file(src.clone());
    if (mod.len == 0) {
        return "file:" + build_norm_path(src);
    }
    return "module:" + mod;
}

fn build_module_tail_path(mod: string, start: i32) -> string {
    var out: string = "";
    var i: i32 = start;
    while (i < mod.len) {
        if (mod.charAt(i) == 46) {
            out = out + "/";
        } else {
            out = out + mod.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn build_legacy_module_source_path(module_name: string) -> string {
    if (module_name.len == 0) { return ""; }
    var dot: i32 = 0;
    while (dot < module_name.len && module_name.charAt(dot) != 46) {
        dot = dot + 1;
    }
    if (dot < module_name.len) {
        return build_join_path("src", build_module_tail_path(module_name, dot + 1) + ".vyx");
    }
    return build_join_path("src", module_name + ".vyx");
}

fn build_group_key_seen(seen: string, key: string) -> bool {
    return build_contains("\n" + seen, "\n" + key + "\n");
}

fn build_sources_for_group(sources: string, key: string) -> string {
    var out: string = "";
    var start: i32 = 0;
    var pos: i32 = 0;
    // One pass over the source block. An indexed build_line_at loop restarted
    // at byte zero for every source and cloned the whole block on every row.
    while (pos <= sources.len) {
        if (pos == sources.len || sources.charAt(pos) == 10) {
            if (pos > start) {
                let src = build_expand_env(sources.substring(start, pos));
                if (build_source_group_key(src) == key) {
                    out = build_append_unique_line(out, src);
                }
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    return out;
}

fn build_compile_unit_count(sources: string) -> i64 {
    var seen: string = "";
    var out: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        let key = build_source_group_key(src);
        if (!build_group_key_seen(seen.clone(), key.clone())) {
            seen = seen + key + "\n";
            out = out + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_crate_cc_unit_count(sources: string) -> i64 {
    var out: i64 = 0;
    var has_vyx = false;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        let kind = build_source_kind(src.clone());
        if (kind == "vyx") {
            has_vyx = true;
        } else {
            out = out + 1;
        }
        i = i + 1;
    }
    if (has_vyx) { out = out + 1; }
    return out;
}

fn build_vyx_crate_entry(sources: string, entry: string) -> string {
    if (build_source_kind(entry.clone()) == "vyx") { return entry; }
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") { return src; }
        i = i + 1;
    }
    return entry;
}

fn build_compile_unit_count_with_root_split(sources: string, split_roots: bool, ambiguous_public_names: string) -> i64 {
    var seen: string = "";
    var out: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        let key = build_source_group_key(src.clone());
        if (!build_group_key_seen(seen.clone(), key.clone())) {
            seen = seen + key + "\n";
            if (split_roots && build_source_kind(src.clone()) == "vyx") {
                let group_sources = build_sources_for_group(sources, key.clone());
                let roots = build_partition_root_names_for_sources(group_sources.clone(),
                                                                   sources.clone(),
                                                                   ambiguous_public_names.clone());
                out = out + build_new_mir_root_chunk_count(src.clone(), roots.clone());
            } else {
                out = out + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn build_unit_sources_path(cache_dir: string, key: string) -> string {
    return build_join_path(cache_dir, build_safe_obj_name("unit_" + key, ".sources"));
}

fn build_vyx_sources_only(sources: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            out = build_append_unique_line(out.clone(), src);
        }
        i = i + 1;
    }
    return out;
}

/// The interface promise a producing compile makes about its own symbols.
///
/// A unity crate -- one compilation unit for the whole crate -- decorates
/// every member file except the crate entry with a `source=<module>`
/// discriminator segment; a single-file crate and every non-unity compile
/// export plain names.  `.vyi` emission runs as a separate one-file invocation
/// and cannot re-derive that shape, so the decorated set travels to it as a
/// file.  Consumers reproduce exactly these names, so an over-broad or
/// under-broad promise both end in `lld-link: undefined symbol`.
fn build_write_vyi_decorated_sources(cache_dir: string,
                                     target_name: string,
                                     sources: string,
                                     entry: string,
                                     unity: bool) -> string {
    if (!unity) { return ""; }
    let vyx_sources = build_vyx_sources_only(sources.clone());
    if (build_line_count(vyx_sources.clone()) <= 1) { return ""; }
    let crate_entry = build_vyx_crate_entry(sources.clone(), entry.clone());
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(vyx_sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(vyx_sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx"
            && !build_same_abs_path(src.clone(), crate_entry.clone())) {
            out = build_append_unique_line(out.clone(), src);
        }
        i = i + 1;
    }
    if (out.len == 0) { return ""; }
    let path = build_join_path(
        cache_dir.clone(),
        build_safe_obj_name("vyi_decorated_" + target_name.clone(), ".txt"));
    build_ensure_parent(path.clone());
    writeFile(path.clone(), out);
    return path;
}

fn build_group_stamp(group_sources: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_line_at(group_sources.clone(), i);
        out = out + "group_src=" + src + "="
              + build_file_content_stamp(src) + ";";
        i = i + 1;
    }
    return out;
}

fn build_has_path_sep(path: string) -> bool {
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_tool_arg(tool: string) -> string {
    let tool2 = build_expand_env(tool);
    if (build_has_path_sep(tool2)) { return build_quote(tool2); }
    return tool2;
}

fn build_cli_clang_target_arg() -> string {
    let triple = policy_cli_target_triple();
    if (triple.len == 0) { return ""; }
    return " -target " + build_quote(triple);
}

fn build_android_prebuilt_tag() -> string {
    if (build_is_windows()) { return "windows-x86_64"; }
    if (build_is_linux()) { return "linux-x86_64"; }
    if (build_is_apple()) {
        let ndk = build_android_ndk_root();
        if (ndk.len > 0 && isDir(build_join_path(build_join_path(build_join_path(ndk, "toolchains/llvm/prebuilt"), "darwin-arm64"), "bin"))) {
            return "darwin-arm64";
        }
        return "darwin-x86_64";
    }
    return "";
}

fn build_android_sysroot_path() -> string {
    if (!build_effective_is_android()) { return ""; }
    let ndk = build_android_ndk_root();
    let tag = build_android_prebuilt_tag();
    if (ndk.len == 0 || tag.len == 0) { return ""; }
    let sysroot = build_join_path(build_join_path(build_join_path(ndk, "toolchains/llvm/prebuilt"), tag), "sysroot");
    if (isDir(sysroot)) { return sysroot; }
    return "";
}

fn build_cli_compile_passthrough() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 2;
    var saw_sysroot: bool = false;
    while (i < argc) {
        let a = getArg(i);
        if ((a == "--target" || a == "-target" || a == "--triplet") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("-target=")
                   || a.startsWith("--triplet=")) {
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            saw_sysroot = true;
            out = out + " --sysroot " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            saw_sysroot = true;
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = out + " --target-cpu " + build_quote(getArg(i + 1).trim());
            i = i + 2;
        } else if (a.startsWith("--target-cpu=") || a.startsWith("--mcpu=")) {
            out = out + " " + a;
            i = i + 1;
        } else if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3"
                   || a == "-Os" || a == "-Oz" || a == "-g") {
            out = out + " " + a;
            i = i + 1;
        } else if (a == "--debug") {
            out = out + " -g";
            i = i + 1;
        } else if (a == "--coverage") {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "-j" || a == "--jobs") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("-j") && a.len > 2) {
            i = i + 1;
        } else if ((a == "-L" || a == "--lib-path" || a == "-l" || a == "--link")
                   && i + 1 < argc) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    out = out + build_cli_clang_target_arg();
    if (build_effective_is_android() && !saw_sysroot) {
        let sysroot = build_android_sysroot_path();
        if (sysroot.len > 0) {
            out = out + " --sysroot " + build_quote(sysroot);
        }
    }
    return out;
}

fn build_cli_link_passthrough() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 2;
    var saw_sysroot: bool = false;
    while (i < argc) {
        let a = getArg(i);
        if ((a == "--target" || a == "-target" || a == "--triplet") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("-target=")
                   || a.startsWith("--triplet=")) {
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            saw_sysroot = true;
            out = out + " --sysroot " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            saw_sysroot = true;
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = out + " --target-cpu " + build_quote(getArg(i + 1).trim());
            i = i + 2;
        } else if (a.startsWith("--target-cpu=") || a.startsWith("--mcpu=")) {
            out = out + " " + a;
            i = i + 1;
        } else if (a == "--debug") {
            out = out + " -g";
            i = i + 1;
        } else if (a == "-g" || a == "--coverage") {
            out = out + " " + a;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    out = out + build_cli_clang_target_arg();
    if (build_effective_is_android() && !saw_sysroot) {
        let sysroot = build_android_sysroot_path();
        if (sysroot.len > 0) {
            out = out + " --sysroot " + build_quote(sysroot);
        }
    }
    return out;
}

fn build_cli_recursive_build_passthrough() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if ((a == "--target" || a == "-target" || a == "--triplet") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("-target=")
                   || a.startsWith("--triplet=")) {
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            out = out + " --sysroot " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = out + " --target-cpu " + build_quote(getArg(i + 1).trim());
            i = i + 2;
        } else if (a.startsWith("--target-cpu=") || a.startsWith("--mcpu=")) {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "-j" || a == "--jobs") && i + 1 < argc) {
            out = out + " " + a + " " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("-j") && a.len > 2) {
            out = out + " -j " + build_quote(a.substring(2, a.len));
            i = i + 1;
        } else if ((a == "--mir-opt" || a == "--llvm-opt") && i + 1 < argc) {
            out = out + " " + a + " " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3"
                   || a == "-Os" || a == "-Oz" || a == "-g") {
            out = out + " " + a;
            i = i + 1;
        } else if (a == "--debug" || a == "--coverage") {
            out = out + " " + a;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    let triplet = policy_cli_requested_triplet();
    if (triplet.len > 0) {
        out = out + " --triplet " + build_quote(triplet);
    }
    return out;
}

/// `build` remains the manifest-oriented command when no source is selected.
/// An explicit canonical source selector instead requests the normal compiler
/// driver, so project output modes such as `--emit=ir` and `--emit=cpp` share
/// the same source discovery and output conventions as direct invocation.
fn build_cli_has_source_selector() -> bool {
    let argc = argCount();
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { return false; }
        if (a.startsWith("--src=")) { return true; }
        i = i + 1;
    }
    return false;
}

/// Reconstruct the canonical compiler arguments after the `build` token.
/// Quoting every argv element preserves paths and project flags without
/// accidentally interpreting them in the shell used by the process bridge.
fn build_cli_source_compile_forward_args() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 2;
    while (i < argc) {
        out = out + " " + build_quote_arg(getArg(i));
        i = i + 1;
    }
    return out;
}

fn build_cli_run_source_compile() -> i32 {
    let cmd = build_tool_arg(getArg(0)) + build_cli_source_compile_forward_args();
    print("[build] explicit source selector: forwarding to compiler driver");
    return build_run_process(cmd, "", "", "");
}

fn build_compile_command(kind: string,
                         self_exe: string,
                         src: string,
                         obj: string,
                         pass_args: string,
                         include_args: string,
                         cflags: string,
                         cxxflags: string,
                         cc: string,
                         cxx: string,
                         unit_sources: string,
                         project_unit_sources: bool,
                         interface_unit_sources: bool,
                         dci_abi_path: string) -> string {
    let toolchain_args = build_cli_compile_passthrough();
    let tmp_obj = build_task_tmp_output(obj.clone());
    if (kind == "c") {
        var c_tool = cc;
        if (c_tool.len == 0) { c_tool = build_tool_path("clang"); }
        return build_tool_arg(c_tool) + " -c " + build_quote(src) + " -o " + build_quote(tmp_obj)
               + " -O2 -std=c11" + toolchain_args + include_args + cflags;
    }
    if (kind == "cpp") {
        var cxx_tool = cxx;
        if (cxx_tool.len == 0) { cxx_tool = build_tool_path("clang++"); }
        return build_tool_arg(cxx_tool) + " -c " + build_quote(src) + " -o " + build_quote(tmp_obj)
               + " -O2 -std=c++17" + toolchain_args + include_args + cxxflags;
    }
    var unit_args: string = "";
    if (unit_sources.len > 0) {
        if (interface_unit_sources) {
            unit_args = " --interface-unit-sources " + build_quote(unit_sources);
        } else if (project_unit_sources) {
            unit_args = " --project-unit-sources " + build_quote(unit_sources);
        } else {
            unit_args = " --unit-sources " + build_quote(unit_sources);
        }
    }
    let dci_args = build_dci_cli_args(dci_abi_path);
    return build_tool_arg(self_exe) + " --emit=obj --src=file "
           + build_quote(src) + " -o " + build_quote(tmp_obj) + pass_args + unit_args + dci_args;
}

fn build_emit_dci_clang_cpp_stubs_command(self_exe: string,
                                          src: string,
                                          stub_cpp: string,
                                          pass_args: string,
                                          unit_sources: string,
                                          dci_abi_path: string) -> string {
    var unit_args: string = "";
    if (unit_sources.len > 0) {
        unit_args = " --unit-sources " + build_quote(unit_sources);
    }
    let dci_args = build_dci_cli_args(dci_abi_path);
    return build_tool_arg(self_exe) + " --emit=dci-stubs --src=file "
           + build_quote(src) + " -o " + build_quote(stub_cpp) + pass_args + unit_args + dci_args;
}

fn build_resolved_cxx_tool(cxx: string) -> string {
    var cxx_tool = build_expand_env(cxx).trim();
    if (cxx_tool.contains("\${") || (cxx_tool.startsWith("%") && cxx_tool.endsWith("%"))) {
        cxx_tool = "";
    }
    if (cxx_tool.len > 0 && build_has_path_sep(cxx_tool) && !fileExists(cxx_tool)) {
        cxx_tool = "";
    }
    if (cxx_tool.len > 0 && !build_has_path_sep(cxx_tool) && !fileExists(cxx_tool)) {
        // A bare tool name (`cxx = "clang++"`) cannot be spawned verbatim on
        // Windows: the runtime passes argv[0] as lpApplicationName, and
        // CreateProcessW does NOT search PATH for it (spawn rc=-1, pid=0).
        // Resolve the name exactly like the default toolchain does.
        let resolved = build_tool_path(cxx_tool);
        if (resolved.len > 0) { return resolved; }
    }
    if (cxx_tool.len == 0) { cxx_tool = build_tool_path("clang++"); }
    return cxx_tool;
}

fn build_compile_dci_clang_cpp_stub_command(stub_cpp: string,
                                            stub_obj: string,
                                            include_args: string,
                                            cxxflags_args: string,
                                            cxx: string) -> string {
    var cxx_tool = build_resolved_cxx_tool(cxx);
    if (cxx_tool.len == 0) { return ""; }
    return build_tool_arg(cxx_tool) + " -c " + build_quote(stub_cpp)
           + " -o " + build_quote(build_task_tmp_output(stub_obj.clone()))
           + " -O2 -std=c++17" + build_cli_compile_passthrough()
           + include_args + cxxflags_args;
}

fn build_compile_dci_rustc_stub_command(stub_rs: string, stub_obj: string) -> string {
    let python = build_dci_python();
    let cli = build_dci_cli_script();
    if (python.len == 0 || cli.len == 0) { return ""; }
    let script = build_join_path(build_dirname(cli.clone()), "dci_rustc_stub_compile.py");
    if (!fileExists(script.clone())) { return ""; }
    var rustc_tool = build_tool_path("rustc");
    if (rustc_tool.len == 0) { rustc_tool = "rustc"; }
    return build_tool_arg(python) + " " + build_quote(script)
           + " --stub " + build_quote(stub_rs)
           + " --output " + build_quote(build_task_tmp_output(stub_obj.clone()))
           + " --rustc " + build_quote(rustc_tool);
}

fn build_dci_clang_cpp_stub_source_has_defs(stub_cpp: string) -> bool {
    if (!fileExists(stub_cpp)) { return false; }
    return build_contains(readFile(stub_cpp.clone()), "__dci_stub_");
}

// ── external DCI stub backend: env first, Vyx.toml as the fallback ─────
//
// `VYX_DCI_STUB_BACKEND_*` is what the Active Adapter gate uses, because it
// can point a build at a backend that lives outside the project.  Requiring
// it made a plain `vyx build` unusable from a checkout, so the same settings
// can now be declared in `[build]` / `[target.<name>]` and are resolved
// relative to the project directory.  Env still wins when set: it is the
// explicit override, and a target that declares nothing keeps the old
// behaviour exactly.
var g_dci_ext_toml_tool: string = "";
var g_dci_ext_toml_tool_args: string = "";
var g_dci_ext_toml_dependencies: string = "";   // one absolute path per line
var g_dci_ext_toml_version: string = "";
var g_dci_ext_toml_capabilities: string = "";   // one capability per line
var g_dci_ext_toml_source_extension: string = "";

/// `key` from the target section, else from `[build]`.
fn build_dci_toml_setting(manifest: string, section: string, key: string) -> string {
    var value = build_toml_get_platform_value(manifest.clone(), section.clone(), key.clone()).trim();
    if (value.len == 0) {
        value = build_toml_get_platform_value(manifest, "build", key).trim();
    }
    return build_expand_env(value);
}

fn build_dci_toml_setting_array(manifest: string, section: string, key: string) -> string {
    var value = build_toml_get_platform_array(manifest.clone(), section.clone(), key.clone()).trim();
    if (value.len == 0) {
        value = build_toml_get_platform_array(manifest.clone(), "build", key.clone()).trim();
    }
    if (value.len == 0) {
        value = build_toml_get_platform_value(manifest, "build", key).trim();
    }
    return build_expand_env(value);
}

/// A token of the tool-argument string that names a file rather than a flag.
fn build_dci_arg_is_path(token: string) -> bool {
    if (token.len == 0) { return false; }
    if (token.charAt(0) == 45) { return false; }
    if (build_has_path_sep(token.clone())) { return true; }
    let lower = build_ascii_lower(token);
    return lower.endsWith(".py") || lower.endsWith(".rs") || lower.endsWith(".js")
           || lower.endsWith(".sh") || lower.endsWith(".exe");
}

/// Path-looking arguments are anchored to the project directory and quoted;
/// flags and bare words pass through untouched.  Without this a manifest
/// would only work from one cwd, and a path with a space in it would be
/// torn in half by the command line.
fn build_dci_resolve_tool_args(raw: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < raw.len) {
        while (i < raw.len && (raw.charAt(i) == 32 || raw.charAt(i) == 9)) { i = i + 1; }
        if (i >= raw.len) { break; }
        var token: string = "";
        var quoted: bool = false;
        if (raw.charAt(i) == 34) { quoted = true; i = i + 1; }
        while (i < raw.len) {
            let c = raw.charAt(i);
            if (!quoted && (c == 32 || c == 9)) { break; }
            if (quoted && c == 34) { i = i + 1; break; }
            token = token + raw.substring(i, i + 1);
            i = i + 1;
        }
        if (token.len > 0) {
            if (build_dci_arg_is_path(token.clone())) {
                token = build_quote_arg(build_abs_norm_path(token));
            }
            if (out.len > 0) { out = out + " "; }
            out = out + token;
        }
    }
    return out;
}

fn build_dci_resolve_path_list(raw: string) -> string {
    let rows = toml_array_to_lines(raw);
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        var entry = build_trim_quotes(build_line_at(rows.clone(), i)).trim();
        if (entry.len > 0) {
            entry = build_abs_norm_path(entry);
            if (out.len > 0) { out = out + "\n"; }
            out = out + entry;
        }
        i = i + 1;
    }
    return out;
}

fn build_dci_resolve_capability_list(raw: string) -> string {
    let rows = toml_array_to_lines(raw.replace(",", "\n"));
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let entry = build_trim_quotes(build_line_at(rows.clone(), i)).trim();
        if (entry.len > 0) {
            if (out.len > 0) { out = out + "\n"; }
            out = out + entry;
        }
        i = i + 1;
    }
    return out;
}

/// Called once per target, before anything asks for a setting: the values are
/// per-target, so a target that declares nothing must clear what the previous
/// one left behind.
fn build_dci_external_stub_backend_apply_manifest(manifest: string, section: string) {
    g_dci_ext_toml_tool = "";
    g_dci_ext_toml_tool_args = "";
    g_dci_ext_toml_dependencies = "";
    g_dci_ext_toml_version = "";
    g_dci_ext_toml_capabilities = "";
    g_dci_ext_toml_source_extension = "";
    var tool = build_dci_toml_setting(manifest.clone(), section.clone(),
                                      "dci_stub_backend_tool").trim();
    if (tool.len > 0) {
        // A bare tool name still goes through PATH resolution at command
        // build time; anything already a path is anchored now, so it never
        // gains a spurious `.exe` from `build_tool_path`.
        if (build_has_path_sep(tool.clone())) { tool = build_abs_norm_path(tool); }
        g_dci_ext_toml_tool = tool;
    }
    let args = build_dci_toml_setting(manifest.clone(), section.clone(),
                                      "dci_stub_backend_tool_args").trim();
    if (args.len > 0) { g_dci_ext_toml_tool_args = build_dci_resolve_tool_args(args); }
    let deps = build_dci_toml_setting_array(manifest.clone(), section.clone(),
                                            "dci_stub_backend_dependencies").trim();
    if (deps.len > 0) { g_dci_ext_toml_dependencies = build_dci_resolve_path_list(deps); }
    g_dci_ext_toml_version = build_dci_toml_setting(manifest.clone(), section.clone(),
                                                    "dci_stub_backend_version").trim();
    let caps = build_dci_toml_setting_array(manifest.clone(), section.clone(),
                                            "dci_stub_backend_capabilities").trim();
    if (caps.len > 0) { g_dci_ext_toml_capabilities = build_dci_resolve_capability_list(caps); }
    g_dci_ext_toml_source_extension = build_dci_toml_setting(manifest, section,
                                                             "dci_stub_backend_source_extension").trim();
}

fn build_dci_external_stub_backend_tool() -> string {
    var configured = build_env_value("VYX_DCI_STUB_BACKEND_TOOL").trim();
    if (configured.len == 0) { configured = g_dci_ext_toml_tool; }
    return configured;
}

fn build_dci_external_stub_backend_tool_args() -> string {
    var configured = build_env_value("VYX_DCI_STUB_BACKEND_TOOL_ARGS").trim();
    if (configured.len == 0) { configured = g_dci_ext_toml_tool_args; }
    return configured;
}

fn build_dci_external_stub_backend_dependencies() -> string {
    var configured = build_env_value("VYX_DCI_STUB_BACKEND_DEPENDENCIES").trim();
    if (configured.len > 0) {
        if (build_is_windows()) {
            configured = configured.replace(";", "\n");
        } else {
            configured = configured.replace(":", "\n");
        }
        return configured;
    }
    return g_dci_ext_toml_dependencies;
}

fn build_dci_external_stub_backend_version() -> string {
    var configured = build_env_value("VYX_DCI_STUB_BACKEND_VERSION").trim();
    if (configured.len == 0) { configured = g_dci_ext_toml_version; }
    return configured;
}

fn build_dci_external_stub_backend_dependencies_stamp() -> string {
    let dependencies = build_dci_external_stub_backend_dependencies();
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(dependencies.clone());
    while (i < n) {
        let configured_path = build_line_at(dependencies.clone(), i).trim();
        if (configured_path.len > 0) {
            let dependency_path = build_abs_norm_path(build_expand_env(configured_path));
            if (!fileExists(dependency_path.clone())) {
                print(build_error_label() + ": external DCI stub backend dependency not found: "
                      + dependency_path);
                return "|ERR|";
            }
            let dependency_content = readFile(dependency_path.clone());
            out = out + build_stamp_digest("backend_dependency_path", dependency_path);
            out = out + build_stamp_digest("backend_dependency_content", dependency_content);
        }
        i = i + 1;
    }
    return out;
}

fn build_dci_external_stub_backend_command_prefix() -> string {
    let configured_tool = build_dci_external_stub_backend_tool();
    if (configured_tool.len == 0) { return ""; }
    var resolved_tool = configured_tool;
    // A path is used as written -- `build_tool_path` would append `.exe` to a
    // script on Windows.  Only a bare tool name goes looking through
    // PATH / LLVM_ROOT.
    if (!build_has_path_sep(resolved_tool.clone())) {
        resolved_tool = build_tool_path(configured_tool);
    }
    if (resolved_tool.len == 0) { return ""; }
    var command = build_tool_arg(resolved_tool);
    let tool_args = build_dci_external_stub_backend_tool_args();
    if (tool_args.len > 0) { command = command + " " + tool_args; }
    return command;
}

fn build_dci_external_stub_backend_capabilities() -> string {
    var configured = build_env_value("VYX_DCI_STUB_BACKEND_CAPABILITIES").trim();
    if (configured.len == 0) { configured = g_dci_ext_toml_capabilities.replace("\n", ","); }
    if (configured.len == 0) { return "emit-source\ncompile-object"; }
    configured = configured.replace(",", "\n");
    return configured;
}

fn build_dci_external_stub_source_extension() -> string {
    var extension = build_env_value("VYX_DCI_STUB_SOURCE_EXTENSION").trim();
    if (extension.len == 0) { extension = g_dci_ext_toml_source_extension; }
    if (extension.len > 0 && !extension.startsWith(".")) { extension = "." + extension; }
    return extension;
}

fn build_dci_cli_args(paths: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    let n = dci_path_list_count(paths.clone());
    while (i < n) {
        let path = dci_path_list_at(paths.clone(), i);
        if (path.len > 0) {
            out = out + " --dci " + build_quote(path);
        }
        i = i + 1;
    }
    return out;
}

// ── Open-generic instance closure (DCI reverse overrides) ─────────────────
//
// A consumer class inheriting an *open* generic DCI base (`class X<T> :
// native.SinkG<T>`) cannot be lowered until the closed instance's vtable
// facts exist.  A lowering pass that misses them records
// `instance <type-text>` requests in the object's `.dci_open` sidecar and
// fails; the build system then asks the producer adapter to close exactly
// those instances into a supplement contract and re-lowers.  Nothing is
// hand-listed: the consumer discovers, the producer closes.

// The supplement contract the closure step writes for `target_name`.  It is
// deterministic per target so warm builds can add it to the descriptor list
// up front and hit their compile caches.
fn build_dci_supplement_path(cache_dir: string, target_name: string) -> string {
    return build_join_path(cache_dir.clone(),
                           "dci_closed_facts_" + target_name + ".dcib");
}

// True when the sidecar carries at least one *closable* request: an
// `instance` line naming a closed generic (contains `<`).  Non-generic
// traits are always already described by the producer contract.
fn build_dci_sidecar_has_generic_instances(sidecar: string) -> bool {
    if (!fileExists(sidecar.clone())) { return false; }
    let text = readFile(sidecar.clone());
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            let line = text.substring(start, i).trim();
            if (line.startsWith("instance\t") && line.contains("<")) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// Hand the sidecar's instance requests to the close-instances tool.  Returns
// 0 when new closed facts were written (worth a re-lower) and anything else
// when they were not: 3 means every request was already described (a real
// failure, not a missing instance), other codes are tool or producer errors.
fn build_dci_run_instance_closure(cache_dir: string,
                                  target_name: string,
                                  sidecar: string,
                                  contracts: string) -> i32 {
    let python = build_dci_python();
    let cli = build_dci_cli_script();
    if (python.len == 0 || cli.len == 0) { return 1; }
    let tool = build_join_path(build_dirname(cli.clone()), "dci_close_instances.py");
    if (!fileExists(tool.clone())) { return 1; }
    let supplement = build_dci_supplement_path(cache_dir.clone(), target_name.clone());
    var cmd = build_quote(python) + " " + build_quote(tool)
              + " --requests " + build_quote(sidecar)
              + " --out " + build_quote(supplement);
    let rustc_tool = build_tool_path("rustc");
    if (rustc_tool.len > 0) {
        cmd = cmd + " --rustc " + build_quote(rustc_tool);
    }
    var i: i32 = 0;
    let n = dci_path_list_count(contracts.clone());
    while (i < n) {
        let one = dci_path_list_at(contracts.clone(), i);
        if (one.len > 0) {
            cmd = cmd + " --contract " + build_quote(one);
        }
        i = i + 1;
    }
    let log = supplement + ".log";
    let rc = build_run_process(cmd, "", log.clone(), log.clone());
    if (rc == 0) {
        print(build_progress_label("dci", 1) + " closed open-generic instances for "
              + build_path_label(target_name.clone()) + " -> "
              + build_path_label(supplement.clone()));
    }
    return rc;
}

fn build_dci_descriptor_list_stamp(paths: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    let n = dci_path_list_count(paths.clone());
    while (i < n) {
        out = out + build_dci_descriptor_stamp(dci_path_list_at(paths.clone(), i));
        i = i + 1;
    }
    return out;
}

fn build_dci_paths_validate(target_name: string, paths: string) -> bool {
    var i: i32 = 0;
    let n = dci_path_list_count(paths.clone());
    while (i < n) {
        let path = dci_path_list_at(paths.clone(), i);
        if (!dci_path_is_dcib(path.clone())) {
            print(build_error_label() + ": target `" + target_name
                  + "` dci_file must use the .dcib binary contract format: " + path);
            return false;
        }
        if (!fileExists(path.clone())) {
            print(build_error_label() + ": configured DCI contract not found: " + path);
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn build_dci_rustc_native_libs() -> string {
    if (build_effective_is_windows()) {
        return "kernel32\nntdll\nuserenv\nws2_32\ndbghelp\n";
    }
    return "";
}

fn build_append_dci_rustc_native_libs(backend: string, stub_objects: string, libs: string) -> string {
    var need_rustc = false;
    let tokens = build_dci_stub_backend_tokens(backend.clone());
    var t: i64 = 0;
    let tn = build_line_count(tokens.clone());
    while (t < tn) {
        if (build_line_at(tokens.clone(), t).trim() == "rustc") { need_rustc = true; }
        t = t + 1;
    }
    if (!need_rustc) {
        var oi: i64 = 0;
        let on = build_line_count(stub_objects.clone());
        while (oi < on) {
            let obj = build_line_at(stub_objects.clone(), oi).trim().toLower();
            if (obj.endsWith(".lib") || obj.endsWith(".a")) { need_rustc = true; }
            oi = oi + 1;
        }
    }
    if (!need_rustc || stub_objects.len == 0) { return libs; }
    var out = libs;
    let native_libs = build_dci_rustc_native_libs();
    var i: i64 = 0;
    let n = build_line_count(native_libs.clone());
    while (i < n) {
        let lib_name = build_line_at(native_libs.clone(), i).trim();
        if (lib_name.len > 0) {
            out = build_append_toml_array_item(out.clone(), lib_name);
        }
        i = i + 1;
    }
    return out;
}

fn build_dci_stub_backend_is_known(backend: string) -> bool {
    return backend == "direct" || backend == "external" || backend == "clang-cpp"
        || backend == "rustc" || backend == "auto";
}

fn build_dci_stub_backend_tokens(configured: string) -> string {
    let value = configured.trim();
    if (value.len == 0) { return "direct\n"; }
    if (value == "auto") { return "clang-cpp\nrustc\n"; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= value.len) {
        if (i == value.len || value.charAt(i) == 44) {
            let token = value.substring(start, i).trim();
            if (token.len > 0) {
                if (!build_dci_stub_backend_is_known(token.clone()) || token == "auto") {
                    return "|ERR|";
                }
                if (out.len > 0) { out = out + "\n"; }
                out = out + token;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (out.len == 0) { return "direct\n"; }
    return out + "\n";
}

fn build_dci_stub_backend_capabilities(backend: string) -> string {
    if (backend == "direct") { return "direct-consumption"; }
    if (backend == "auto") {
        return build_dci_stub_backend_capabilities("clang-cpp");
    }
    if (backend == "clang-cpp") {
        return "emit-source\ncompile-object\nvirtual-dispatch\nsingle-inheritance\ndefault-construction";
    }
    if (backend == "rustc") {
        return "emit-source\ncompile-object\nvirtual-dispatch\nsingle-inheritance\ndefault-construction";
    }
    if (backend == "external") { return build_dci_external_stub_backend_capabilities(); }
    return "";
}

fn build_dci_stub_backend_capabilities_label(backend: string) -> string {
    if (backend == "direct") { return "direct-consumption"; }
    if (backend == "clang-cpp") {
        return "emit-source, compile-object, virtual-dispatch, single-inheritance, default-construction";
    }
    if (backend == "rustc") {
        return "emit-source, compile-object, virtual-dispatch, single-inheritance, default-construction";
    }
    if (backend == "external") {
        return build_dci_external_stub_backend_capabilities().replace("\n", ", ");
    }
    return "none";
}

fn build_dci_stub_backend_has_capability(backend: string, capability: string) -> bool {
    let wanted = capability.trim();
    if (wanted.len == 0) { return true; }
    let available = build_dci_stub_backend_capabilities(backend);
    var i: i64 = 0;
    let n = build_line_count(available.clone());
    while (i < n) {
        if (build_line_at(available.clone(), i).trim() == wanted) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_dci_stub_backend_unsupported_capability(backend: string, configured: string) -> string {
    let tokens = build_dci_stub_backend_tokens(backend.clone());
    if (tokens == "|ERR|") { return backend; }
    let rows = toml_array_to_lines(configured);
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let capability = build_line_at(rows.clone(), i).trim();
        if (capability.len > 0) {
            var ok = false;
            var t: i64 = 0;
            let tn = build_line_count(tokens.clone());
            while (t < tn) {
                let token = build_line_at(tokens.clone(), t).trim();
                if (token.len > 0 && build_dci_stub_backend_has_capability(token.clone(), capability.clone())) {
                    ok = true;
                }
                t = t + 1;
            }
            if (!ok) { return capability; }
        }
        i = i + 1;
    }
    return "";
}

fn build_dci_stub_backend_source_extension(backend: string) -> string {
    if (backend == "clang-cpp") { return ".cpp"; }
    if (backend == "rustc") { return ".rs"; }
    if (backend == "external") { return build_dci_external_stub_source_extension(); }
    return "";
}

fn build_dci_stub_backend_emit_command(backend: string,
                                       self_exe: string,
                                       src: string,
                                       stub_source: string,
                                       pass_args: string,
                                       unit_sources: string,
                                       dci_abi_path: string,
                                       open_requests_path: string) -> string {
    if (backend == "clang-cpp") {
        return build_emit_dci_clang_cpp_stubs_command(self_exe,
                                                       src,
                                                       stub_source,
                                                       pass_args,
                                                       unit_sources,
                                                       dci_abi_path);
    }
    if (backend == "rustc") {
        return build_emit_dci_clang_cpp_stubs_command(self_exe,
                                                       src,
                                                       stub_source,
                                                       pass_args,
                                                       unit_sources,
                                                       dci_abi_path);
    }
    if (backend == "external") {
        let prefix = build_dci_external_stub_backend_command_prefix();
        if (prefix.len == 0) { return ""; }
        var command = prefix + " emit"
                      + " --host-source " + build_quote(src)
                      + " --output " + build_quote(stub_source)
                      + " --compiler " + build_quote(self_exe);
        if (unit_sources.len > 0) {
            command = command + " --unit-sources " + build_quote(unit_sources);
        }
        if (dci_abi_path.len > 0) {
            command = command + " --descriptor " + build_quote(dci_abi_path);
        }
        if (open_requests_path.len > 0) {
            command = command + " --requests " + build_quote(open_requests_path);
        }
        if (pass_args.len > 0) {
            command = command + " --host-args " + build_quote(pass_args);
        }
        return command;
    }
    return "";
}

fn build_dci_stub_backend_compile_command(backend: string,
                                          stub_source: string,
                                          stub_obj: string,
                                          include_args: string,
                                          cxxflags_args: string,
                                          cxx: string) -> string {
    if (backend == "clang-cpp") {
        return build_compile_dci_clang_cpp_stub_command(stub_source,
                                                        stub_obj,
                                                        include_args,
                                                        cxxflags_args,
                                                        cxx);
    }
    if (backend == "rustc") {
        return build_compile_dci_rustc_stub_command(stub_source, stub_obj);
    }
    if (backend == "external") {
        let prefix = build_dci_external_stub_backend_command_prefix();
        if (prefix.len == 0) { return ""; }
        var command = prefix + " compile"
                      + " --source " + build_quote(stub_source)
                      + " --output " + build_quote(build_task_tmp_output(stub_obj.clone()));
        if (include_args.len > 0) {
            command = command + " --include-args " + build_quote(include_args);
        }
        if (cxxflags_args.len > 0) {
            command = command + " --compile-args " + build_quote(cxxflags_args);
        }
        return command;
    }
    return "";
}

fn build_dci_stub_backend_source_has_defs(backend: string, stub_source: string) -> bool {
    if (backend == "rustc") {
        if (!fileExists(stub_source)) { return false; }
        return build_contains(readFile(stub_source.clone()), "dci-rust-producer=");
    }
    if (backend == "clang-cpp") {
        return build_dci_clang_cpp_stub_source_has_defs(stub_source);
    }
    if (backend == "external") {
        return fileExists(stub_source) && readFile(stub_source.clone()).trim().len > 0;
    }
    return false;
}

fn build_dci_stub_backend_group_is_enabled(backend: string) -> bool {
    let tokens = build_dci_stub_backend_tokens(backend.clone());
    if (tokens == "|ERR|") { return false; }
    var i: i64 = 0;
    let n = build_line_count(tokens.clone());
    while (i < n) {
        let token = build_line_at(tokens.clone(), i).trim();
        if (token.len > 0 && token != "direct") { return true; }
        i = i + 1;
    }
    return false;
}

fn build_source_contains_code_token(text: string, token: string) -> bool {
    if (text.len == 0 || token.len == 0 || token.len > text.len) { return false; }
    var i: i32 = 0;
    var quote: i32 = 0;
    var escaped = false;
    var line_comment = false;
    var block_comment = false;
    while (i < text.len) {
        let c = text.charAt(i);
        var next: i32 = 0;
        if (i + 1 < text.len) { next = text.charAt(i + 1); }
        if (line_comment) {
            if (c == 10 || c == 13) { line_comment = false; }
            i = i + 1;
            continue;
        }
        if (block_comment) {
            if (c == 42 && next == 47) {
                block_comment = false;
                i = i + 2;
            } else {
                i = i + 1;
            }
            continue;
        }
        if (quote != 0) {
            if (escaped) {
                escaped = false;
            } else if (c == 92) {
                escaped = true;
            } else if (c == quote) {
                quote = 0;
            }
            i = i + 1;
            continue;
        }
        if (c == 47 && next == 47) {
            line_comment = true;
            i = i + 2;
            continue;
        }
        if (c == 47 && next == 42) {
            block_comment = true;
            i = i + 2;
            continue;
        }
        if (i + token.len <= text.len
            && text.substring(i, i + token.len) == token) {
            return true;
        }
        if (c == 34 || c == 39) { quote = c; }
        i = i + 1;
    }
    return false;
}

fn build_dci_group_may_need_stubs(group_sources: string) -> bool {
    var saw_cpp_extern = false;
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_line_at(group_sources.clone(), i);
        if (src.len > 0 && fileExists(src.clone())) {
            let text = readFile(src.clone());
            if (build_source_contains_code_token(text.clone(), "extern \"cpp\"")) { saw_cpp_extern = true; }
        }
        i = i + 1;
    }
    return saw_cpp_extern;
}

fn build_dci_group_has_dci_extern(group_sources: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(group_sources.clone(), i));
        if (src.len > 0 && fileExists(src.clone())) {
            let text = readFile(src.clone());
            if (build_source_contains_code_token(text.clone(), "extern \"cpp\"")
                || build_source_contains_code_token(text, "extern \"dci\"")) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// DCI descriptors are externally produced contract artifacts.  A project
// may consume several independent `.dcib` files; each keeps its own
// producer language and is never merged into a mixed document.
fn build_stable_string(text: string) -> string {
    if (text.len == 0) { return ""; }
    return from_cstr_len(text.c_str(), text.len);
}

fn build_manifest_dci_file(manifest: string, section: string) -> string {
    var path = build_expand_env(build_toml_get_platform_value(manifest.clone(),
                                                               section.clone(),
                                                               "dci_file")).trim();
    if (path.len > 0) { return build_stable_string(build_abs_norm_path(path)); }
    let configured = build_toml_get_platform_array(manifest, section, "dci_files");
    let rows = toml_array_to_lines(build_expand_env(configured));
    var selected: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let candidate = build_line_at(rows.clone(), i).trim();
        if (candidate.len > 0) {
            selected = dci_path_list_append(selected.clone(),
                                            build_stable_string(build_abs_norm_path(candidate)));
        }
        i = i + 1;
    }
    return selected;
}

fn build_manifest_dci_stub_backend(manifest: string, section: string) -> string {
    var backend = build_toml_get_platform_value(manifest.clone(),
                                                 section.clone(),
                                                 "dci_stub_backend").trim();
    if (backend.len == 0) {
        backend = build_toml_get_platform_value(manifest, "build", "dci_stub_backend").trim();
    }
    return backend;
}

fn build_manifest_dci_stub_capabilities(manifest: string, section: string) -> string {
    var configured = build_toml_get_platform_array(manifest.clone(),
                                                    section.clone(),
                                                    "dci_stub_capabilities");
    if (configured.trim().len == 0) {
        configured = build_toml_get_platform_array(manifest, "build", "dci_stub_capabilities");
    }
    return configured;
}
fn build_resolve_dci_import(raw: string, src: string) -> string {
    let value = raw.trim();
    if (value.len == 0) { return ""; }
    if (build_is_abs_path(value.clone())) {
        return build_stable_string(build_abs_norm_path(value));
    }
    return build_stable_string(build_abs_norm_path(build_join_path(build_dirname(src), value)));
}

public fn build_dci_import_for_group(group_sources: string) -> string {
    var selected: string = "";
    let import_marker = "@[" + "dci_import(";
    var source_index: i64 = 0;
    let source_count = build_line_count(group_sources.clone());
    while (source_index < source_count) {
        let src = build_expand_env(build_line_at(group_sources.clone(), source_index));
        if (fileExists(src.clone())) {
            let text = readFile(src.clone());
            var i: i32 = 0;
            while (i + import_marker.len <= text.len) {
                if (text.substring(i, i + import_marker.len) == import_marker) {
                    var quote_index: i32 = (i + import_marker.len) as i32;
                    while (quote_index < text.len && text.charAt(quote_index) != 34 && text.charAt(quote_index) != 39) {
                        quote_index = quote_index + 1;
                    }
                    if (quote_index < text.len) {
                        let quote = text.charAt(quote_index);
                        var end_index: i32 = quote_index + 1;
                        while (end_index < text.len && text.charAt(end_index) != quote) {
                            end_index = end_index + 1;
                        }
                        if (end_index < text.len) {
                            let imported = build_resolve_dci_import(text.substring(quote_index + 1, end_index), src.clone());
                            if (imported.len > 0) {
                                selected = dci_path_list_append(selected.clone(), imported);
                            }
                            i = end_index + 1;
                            continue;
                        }
                    }
                }
                i = i + 1;
            }
        }
        source_index = source_index + 1;
    }
    return selected;
}

fn build_emit_dci_stub_objects(self_exe: string,
                               sources: string,
                               target_name: string,
                               build_cache_dir: string,
                               pass_args: string,
                               configured_dci_abi_path: string,
                               backend: string,
                               include_args: string,
                               cxxflags_args: string,
                               cxx: string,
                               vyx_object_paths: string,
                               step_total: i64) -> string {
    build_trace("dci:enter target=" + target_name + " backend=" + backend
                + " sources_len=" + sources.len.toString());
    if (!build_dci_stub_backend_group_is_enabled(backend.clone())) {
        build_trace("dci:skip stub backend=direct target=" + target_name);
        return "";
    }
    // Open-generic DCI requests: every compiled Vyx object may carry a
    // `<obj>.dci_open` sidecar listing the instances its call sites closed.
    // The union (merged across builds so cached objects keep contributing)
    // becomes the requests file the external Active Adapter materializes.
    var dci_open_requests_path: string = "";
    var dci_open_requests_text: string = "";
    let dci_obj_line_count = build_line_count(vyx_object_paths.clone());
    var dci_obj_i: i64 = 0;
    while (dci_obj_i < dci_obj_line_count) {
        let one_obj = build_line_at(vyx_object_paths.clone(), dci_obj_i).trim();
        dci_obj_i = dci_obj_i + 1;
        if (one_obj.len == 0) { continue; }
        let sidecar = one_obj + ".dci_open";
        if (!fileExists(sidecar.clone())) { continue; }
        dci_open_requests_text = dci_open_requests_text + readFile(sidecar.clone());
    }
    if (dci_open_requests_text.trim().len > 0) {
        dci_open_requests_path = build_join_path(build_cache_dir.clone(),
                                                 "dci_open_requests.txt");
        build_ensure_parent(dci_open_requests_path.clone());
        var merged = "";
        if (fileExists(dci_open_requests_path.clone())) {
            merged = readFile(dci_open_requests_path.clone());
        }
        let new_line_count = build_line_count(dci_open_requests_text.clone());
        var new_line_i: i64 = 0;
        while (new_line_i < new_line_count) {
            let one_line = build_line_at(dci_open_requests_text.clone(), new_line_i).trim();
            new_line_i = new_line_i + 1;
            if (one_line.len == 0) { continue; }
            if (build_contains(merged.clone(), one_line.clone())) { continue; }
            merged = merged + one_line + "\n";
        }
        writeFile(dci_open_requests_path, merged);
        dci_open_requests_text = merged;
        build_trace("dci:open_requests bytes=" + dci_open_requests_text.len.toString());
    }
    let backend_tokens = build_dci_stub_backend_tokens(backend.clone());
    if (backend_tokens == "|ERR|") {
        print(build_error_label() + ": unsupported DCI stub backend `" + backend
              + "`; supported backends: direct, external, clang-cpp, rustc, auto");
        return "|ERR|";
    }
    var out_objects: string = "";
    var seen_groups: string = "";
    let source_count = build_line_count(sources.clone());
    build_trace("dci:source_count=" + source_count.toString());
    var i: i64 = 0;
    while (i < source_count) {
        let src_line = build_line_at(sources.clone(), i);
        let src = build_expand_env(src_line.clone());
        let kind = build_source_kind(src.clone());
        build_trace("dci:source i=" + i.toString() + " src=" + src + " kind=" + kind);
        if (kind != "vyx") {
            i = i + 1;
            continue;
        }
        let group_key = build_source_group_key(src.clone());
        if (build_group_key_seen(seen_groups.clone(), group_key.clone())) {
            i = i + 1;
            continue;
        }
        seen_groups = seen_groups + group_key.clone() + "\n";
        let group_sources = build_sources_for_group(sources, group_key.clone());
        build_trace("dci:group key=" + group_key + " group_len=" + group_sources.len.toString());
        var unit_sources_path: string = "";
        if (build_line_count(group_sources.clone()) > 1) {
            unit_sources_path = build_unit_sources_path(build_cache_dir.clone(), "dci_" + group_key.clone());
            build_ensure_parent(unit_sources_path.clone());
            writeFile(unit_sources_path.clone(), group_sources.clone());
        }
        var stub_dci_abi_path = configured_dci_abi_path.clone();
        var stub_dci_abi_stamp: string = "";
        if (stub_dci_abi_path.len > 0) {
            stub_dci_abi_stamp = build_dci_descriptor_list_stamp(stub_dci_abi_path.clone());
        }
        var token_i: i64 = 0;
        let token_n = build_line_count(backend_tokens.clone());
        while (token_i < token_n) {
            let backend_token = build_line_at(backend_tokens.clone(), token_i).trim();
            token_i = token_i + 1;
            if (backend_token.len == 0 || backend_token == "direct") { continue; }
            if (!build_dci_stub_backend_has_capability(backend_token.clone(), "emit-source")
                || !build_dci_stub_backend_has_capability(backend_token.clone(), "compile-object")) {
                print(build_error_label() + ": DCI stub backend `" + backend_token
                      + "` cannot emit and compile a native stub object");
                return "|ERR|";
            }
            let stub_source_extension = build_dci_stub_backend_source_extension(backend_token.clone());
            if (stub_source_extension.len == 0) {
                print(build_error_label() + ": DCI stub backend `" + backend_token
                      + "` does not declare a generated source format");
                return "|ERR|";
            }
            if (backend_token == "external"
                && stub_dci_abi_path.len == 0
                && dci_open_requests_path.len == 0) {
                print(build_error_label() + ": external DCI stub backend requires a configured .dcib descriptor or open-generic requests");
                return "|ERR|";
            }
            var obj_name_src = target_name.clone() + ":" + src.clone() + "#dci_stubs_" + backend_token;
            if (group_key.startsWith("module:")) {
                obj_name_src = target_name.clone() + ":" + group_key.clone() + "#dci_stubs_" + backend_token;
            }
            let stub_source = build_join_path(build_cache_dir.clone(),
                                              build_safe_obj_name(obj_name_src.clone(), stub_source_extension.clone()));
            var stub_object_extension = build_c_obj_ext();
            if (backend_token == "external") { stub_object_extension = build_obj_ext(); }
            if (backend_token == "rustc") { stub_object_extension = build_static_ext(); }
            let stub_obj = build_join_path(build_cache_dir.clone(),
                                           build_safe_obj_name(obj_name_src.clone(), stub_object_extension));
            build_ensure_parent(stub_source.clone());
            build_ensure_parent(stub_obj.clone());
            let emit_cmd = build_dci_stub_backend_emit_command(backend_token.clone(),
                                                               self_exe.clone(),
                                                               src.clone(),
                                                               stub_source.clone(),
                                                               pass_args.clone(),
                                                               unit_sources_path.clone(),
                                                               stub_dci_abi_path.clone(),
                                                               dci_open_requests_path.clone());
            let compile_cmd = build_dci_stub_backend_compile_command(backend_token.clone(),
                                                                     stub_source.clone(),
                                                                     stub_obj.clone(),
                                                                     include_args.clone(),
                                                                     cxxflags_args.clone(),
                                                                     cxx.clone());
            if (emit_cmd.len == 0 || compile_cmd.len == 0) {
                print(build_error_label() + ": DCI stub backend `" + backend_token
                      + "` did not provide its emit/compile commands");
                return "|ERR|";
            }
            var dci_record = "dci_stub=4;backend=" + backend_token + ";";
            dci_record = dci_record + build_compiler_stamp(self_exe.clone(), "");
            if (backend_token == "external") {
                let external_tool = build_dci_external_stub_backend_tool();
                if (external_tool.len > 0 && fileExists(external_tool.clone())) {
                    dci_record = dci_record + "backend_tool:" + build_file_stamp(external_tool.clone());
                }
                let external_dependencies_stamp = build_dci_external_stub_backend_dependencies_stamp();
                if (external_dependencies_stamp == "|ERR|") { return "|ERR|"; }
                dci_record = dci_record
                             + build_stamp_digest("backend_dependencies", external_dependencies_stamp);
                dci_record = dci_record
                             + build_stamp_digest("backend_version",
                                                  build_dci_external_stub_backend_version());
            }
            dci_record = dci_record + build_group_stamp(group_sources.clone());
            if (stub_dci_abi_path.len > 0) {
                dci_record = dci_record + "dci_abi:" + stub_dci_abi_stamp;
            } else {
                dci_record = dci_record + "dci_abi:none;";
            }
            if (dci_open_requests_path.len > 0) {
                dci_record = dci_record
                             + build_stamp_digest("dci_open_requests",
                                                  dci_open_requests_text.clone());
            }
            dci_record = dci_record + build_stamp_digest("emit_cmd", emit_cmd.clone());
            dci_record = dci_record + build_stamp_digest("compile_cmd", compile_cmd.clone());
            let dci_no_defs_marker = build_stamp_cache_path("dci_stub_no_defs",
                                                            obj_name_src.clone(),
                                                            dci_record.clone());
            let dci_defs_marker = build_stamp_cache_path("dci_stub_defs",
                                                         obj_name_src.clone(),
                                                         dci_record.clone());
            if (fileExists(dci_no_defs_marker.clone())) {
                continue;
            }
            if (fileExists(dci_defs_marker.clone()) && fileExists(stub_obj.clone())) {
                out_objects = out_objects + stub_obj.clone() + "\n";
                continue;
            }
            print(build_progress_label("dci", step_total) + " " + build_status_compile()
                  + " " + build_path_label(src.clone()) + " -> " + build_path_label(stub_source.clone()));
            deleteFile(stub_source.clone());
            deleteFile(stub_obj.clone());
            deleteFile(build_task_tmp_output(stub_obj.clone()));
            let emit_out = stub_source.clone() + ".out.log";
            let emit_err = stub_source.clone() + ".err.log";
            let emit_rc = build_run_process(emit_cmd.clone(), "", emit_out.clone(), emit_err.clone());
            if (emit_rc != 0) {
                print(build_error_label() + ": DCI stub emission failed: " + src
                      + " (exit " + emit_rc.toString() + ")");
                print("  see: " + emit_out + " / " + emit_err);
                return "|ERR|";
            }
            if (!build_dci_stub_backend_source_has_defs(backend_token.clone(), stub_source.clone())) {
                build_stamp_cache_write(dci_no_defs_marker.clone(), "dci_stub_v4", "ok");
                continue;
            }
            let task_line = "dci\t" + stub_source.clone() + "\t" + stub_obj.clone() + "\t" + compile_cmd.clone();
            if (build_execute_task(task_line, step_total) != 0) {
                return "|ERR|";
            }
            build_stamp_cache_write(dci_defs_marker.clone(), "dci_stub_v4", "ok");
            out_objects = out_objects + stub_obj.clone() + "\n";
        }
        i = i + 1;
    }
    return out_objects;
}

fn build_task_tmp_output(obj: string) -> string {
    return obj + ".tmp";
}

// A child compiler has exited before publication starts, but Windows can
// briefly retain a handle to its just-written output (or to the prior output
// through an indexer/AV).  Publication is still an all-or-nothing rename
// transaction: retry only the same filesystem operation and report failure
// if the handle does not clear.  Never retain a stale artifact as success.
fn build_finalize_delete_file(path: string) -> bool {
    if (!fileExists(path.clone())) { return true; }
    var attempt: i32 = 0;
    while (attempt < 12) {
        if (deleteFile(path.clone()) == 0 || !fileExists(path.clone())) {
            return true;
        }
        if (!build_is_windows()) { return false; }
        vyx_bootstrap_sleep_ms(25 * (attempt + 1));
        attempt = attempt + 1;
    }
    return false;
}

fn build_finalize_rename_file(from: string, to: string) -> bool {
    var attempt: i32 = 0;
    while (attempt < 12) {
        if (renameFile(from.clone(), to.clone()) == 0) { return true; }
        if (!build_is_windows()) { return false; }
        vyx_bootstrap_sleep_ms(25 * (attempt + 1));
        attempt = attempt + 1;
    }
    return false;
}

fn build_finalize_cgu_sidecars(obj: string) -> bool {
    let tmp = build_task_tmp_output(obj.clone());
    let tmp_list = tmp.clone() + ".cgu.list";
    if (!fileExists(tmp_list.clone())) {
        // No CGU split this run.  A previous run of the same crate may have
        // split, and its per-unit objects plus `<obj>.cgu.list` survive in the
        // cache.  `build_expand_cgu_object_lists` trusts that list when it
        // exists, so a later single-unit compile would link the stale
        // per-unit objects alongside the fresh primary one and every symbol
        // in both comes back as a duplicate.  Drop the stale family: the
        // list first (it is what the linker reads), then the siblings.
        build_finalize_delete_file(obj.clone() + ".cgu.list");
        var k: i32 = 1;
        while (k <= 64) {
            let p = obj.clone() + ".cgu." + policy_i64_to_string(k as i64);
            if (fileExists(p.clone())) { build_finalize_delete_file(p.clone()); }
            k = k + 1;
        }
        return true;
    }
    let listed = readFile(tmp_list.clone());
    var final_list: string = "";
    var i: i64 = 0;
    let n = build_line_count(listed.clone());
    while (i < n) {
        let src = build_line_at(listed.clone(), i);
        if (src.len == 0) {
            i = i + 1;
            continue;
        }
        var dst = obj.clone();
        let prefix = tmp.clone() + ".cgu.";
        if (src == tmp) {
            dst = obj.clone();
        } elif (src.startsWith(prefix)) {
            dst = obj.clone() + src.substring(tmp.len, src.len);
            if (fileExists(dst.clone()) && !build_finalize_delete_file(dst.clone())) {
                return false;
            }
            if (!fileExists(src.clone())) { return false; }
            if (!build_finalize_rename_file(src.clone(), dst.clone())) { return false; }
        } else {
            dst = src.clone();
        }
        if (final_list.len > 0) { final_list = final_list + "\n"; }
        final_list = final_list + dst;
        i = i + 1;
    }
    if (build_publish_text_file(obj.clone() + ".cgu.list", final_list + "\n") != 0) {
        return false;
    }
    build_finalize_delete_file(tmp_list);
    return true;
}

fn build_finalize_task_output(obj: string) -> bool {
    let tmp = build_task_tmp_output(obj.clone());
    if (!fileExists(tmp.clone())) {
        return false;
    }
    if (!build_finalize_cgu_sidecars(obj.clone())) {
        return false;
    }

    let old = obj.clone() + ".old";
    var had_old_output = false;
    if (!build_finalize_delete_file(old.clone())) { return false; }
    if (fileExists(obj.clone())) {
        if (build_finalize_rename_file(obj.clone(), old.clone())) {
            had_old_output = true;
        } else {
            return false;
        }
    }
    if (!build_finalize_rename_file(tmp.clone(), obj.clone())) {
        if (had_old_output) {
            if (!build_finalize_rename_file(old.clone(), obj.clone())) { return false; }
        }
        return false;
    }
    if (!fileExists(obj.clone())) {
        if (had_old_output) {
            if (!build_finalize_rename_file(old.clone(), obj.clone())) { return false; }
        }
        return false;
    }
    if (had_old_output) {
        if (!build_finalize_delete_file(old)) { return false; }
    }
    return true;
}

fn build_publish_text_file(path: string, payload: string) -> i32 {
    build_ensure_parent(path.clone());
    let tmp_path = path.clone() + ".publish.tmp";
    if (fileExists(tmp_path.clone()) && !build_finalize_delete_file(tmp_path.clone())) {
        return 1;
    }
    if (writeFile(tmp_path.clone(), payload.clone()) != 0
        || !fileExists(tmp_path.clone())
        || readFile(tmp_path.clone()) != payload) {
        if (fileExists(tmp_path.clone())) { deleteFile(tmp_path.clone()); }
        return 1;
    }

    let old_path = path.clone() + ".old";
    if (fileExists(old_path.clone()) && !build_finalize_delete_file(old_path.clone())) {
        build_finalize_delete_file(tmp_path);
        return 1;
    }
    var had_old = false;
    if (fileExists(path.clone())) {
        if (!build_finalize_rename_file(path.clone(), old_path.clone())) {
            build_finalize_delete_file(tmp_path);
            return 1;
        }
        had_old = true;
    }
    if (!build_finalize_rename_file(tmp_path.clone(), path.clone())) {
        if (had_old) {
            if (!build_finalize_rename_file(old_path.clone(), path.clone())) { return 1; }
        }
        if (fileExists(tmp_path.clone())) { build_finalize_delete_file(tmp_path); }
        return 1;
    }
    if (!fileExists(path.clone()) || readFile(path.clone()) != payload) {
        if (fileExists(path.clone())) { build_finalize_delete_file(path.clone()); }
        if (had_old) {
            if (!build_finalize_rename_file(old_path.clone(), path.clone())) { return 1; }
        }
        return 1;
    }
    if (had_old && !build_finalize_delete_file(old_path)) { return 1; }
    return 0;
}

fn build_string_range_equals(text: string, start: i32, end: i32, value: string) -> bool {
    if (start < 0 || end < start) { return false; }
    if ((end - start) != value.len) { return false; }
    var i: i32 = 0;
    while (i < value.len) {
        if (text.charAt(start + i) != value.charAt(i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn build_cache_has(cache: string, record: string, obj: string) -> bool {
    if (!fileExists(obj)) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= cache.len) {
        if (i == cache.len || cache.charAt(i) == 10) {
            var end = i;
            if (end > start && cache.charAt(end - 1) == 13) {
                end = end - 1;
            }
            if (build_string_range_equals(cache, start, end, record)) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn build_cache_has_scoped(cache: string, record: string, obj: string) -> bool {
    let mark = vyx_rt_string_arena_checkpoint();
    let hit = build_cache_has(cache, record, obj);
    vyx_rt_string_arena_release(mark);
    return hit;
}

fn build_cache_record_digest(record: string) -> string {
    return record.len.toString() + ":" + build_hash_text(record).toString();
}

fn build_cache_digest_index(cache: string) -> string {
    var out = StringBuilder.withCapacity(cache.len / 4 + 32);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= cache.len) {
        if (i == cache.len || cache.charAt(i) == 10) {
            var end = i;
            if (end > start && cache.charAt(end - 1) == 13) {
                end = end - 1;
            }
            if (end > start) {
                let line = cache.substring(start, end);
                out.append(build_cache_record_digest(line));
                out.append("\t");
                out.append(start.toString());
                out.append("\t");
                out.append(end.toString());
                out.append("\n");
            }
            start = i + 1;
        }
        i = i + 1;
    }
    // Primitive string must outlive the owned builder result, including SSO.
    var owned = out.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    return result;
}

fn build_cache_has_indexed(cache: string, cache_index: string, record: string, obj: string) -> bool {
    if (!fileExists(obj)) { return false; }
    // The digest only selects candidates. A short hash is not artifact identity:
    // equal-length records can collide, so verify the exact original bytes.
    let prefix = build_cache_record_digest(record) + "\t";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= cache_index.len) {
        if (i == cache_index.len || cache_index.charAt(i) == 10) {
            if (i - start >= prefix.len
                && build_string_range_equals(cache_index, start, start + prefix.len, prefix)) {
                let row = cache_index.substring(start, i);
                let lo = build_parse_i64(build_field(row, 1));
                let hi = build_parse_i64(build_field(row, 2));
                if (lo >= 0 && hi >= lo && hi <= cache.len as i64
                    && build_string_range_equals(cache, lo as i32, hi as i32, record)) {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn build_dep_tmp_path(root: string) -> string {
    let base = build_safe_obj_name(root, ".deps.tmp");
    return build_join_path(".cache", base);
}

fn build_dep_file_list(root: string) -> string {
    if (root.len == 0 || !isDir(root)) { return ""; }
    build_make_dir(".cache");
    let tmp = build_dep_tmp_path(root);
    let tmp_host = build_host_path(tmp.clone());
    writeFile(tmp_host.clone(), "");
    vyx_bootstrap_list_vyx_deps(build_host_path(root).c_str(), tmp_host.clone().c_str());
    let raw = readFile(tmp_host.clone());
    deleteFile(tmp_host);
    // The runtime inventory also contains package `.attr` files.  Keep this
    // historical source/VYI list free of schema files; source registry and
    // module grouping callers intentionally consume this function wholesale.
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= raw.len) {
        if (i == raw.len || raw.charAt(i) == 10) {
            let path = raw.substring(start, i).trim();
            if (path.len > 0 && !path.toLower().endsWith(".attr")) {
                out = out + path + "\n";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_attr_file_list(root: string) -> string {
    if (root.len == 0 || !isDir(root)) { return ""; }
    let manifest_path = build_join_path(root.clone(), "Vyx.toml");
    if (!fileExists(manifest_path.clone())) { return ""; }
    let manifest = readFile(manifest_path);
    var out = "";
    let explicit = toml_array_to_lines(build_toml_get_platform_array(
        manifest.clone(), "effect", "attr_files"));
    var ei: i64 = 0;
    let en = build_line_count(explicit.clone());
    while (ei < en) {
        let item = build_line_at(explicit.clone(), ei).trim();
        if (item.len > 0) {
            let path = if (build_is_abs_path(item.clone())) { item.clone() }
                else { build_join_path(root.clone(), item) };
            out = build_append_unique_line(out, build_abs_norm_path(path));
        }
        ei = ei + 1;
    }
    let auto_raw = build_toml_get_platform_value(manifest, "effect", "auto_discover");
    if (build_bool_disabled(auto_raw)) { return out; }
    build_make_dir(".cache");
    let tmp = build_dep_tmp_path(root) + ".attr";
    let tmp_host = build_host_path(tmp.clone());
    writeFile(tmp_host.clone(), "");
    vyx_bootstrap_list_vyx_deps(build_host_path(root).c_str(), tmp_host.clone().c_str());
    let raw = readFile(tmp_host.clone());
    deleteFile(tmp_host);
    let root_abs = build_abs_norm_path(root.clone());
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= raw.len) {
        if (i == raw.len || raw.charAt(i) == 10) {
            let path = raw.substring(start, i).trim();
            if (path.len > 0 && path.toLower().endsWith(".attr")) {
                let abs = build_abs_norm_path(path);
                if (build_dirname(abs.clone()) == root_abs) {
                    out = build_append_unique_line(out, abs);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_dep_stamp_dir(root: string) -> string {
    let files = build_dep_file_list(root);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.len > 0) {
                out = out + path + "=" + build_file_mtime(path).toString() + ";";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_bool_enabled(value: string) -> bool {
    let v = value.trim();
    return v == "true" || v == "1" || v == "yes" || v == "on";
}

fn build_bool_disabled(value: string) -> bool {
    let v = value.trim();
    return v == "false" || v == "0" || v == "no" || v == "off";
}

fn build_module_is_same_or_child(root: string, mod: string) -> bool {
    if (root.len == 0 || mod.len == 0) { return false; }
    if (mod == root) { return true; }
    return mod.len > root.len + 1
           && mod.startsWith(root)
           && mod.charAt(root.len) == 46;
}

fn build_auto_vyx_sources(entry: string) -> string {
    let root_mod = build_module_name_from_file(entry.clone());
    if (root_mod.len == 0) { return ""; }
    let root_dir = build_dirname(entry);
    let files = build_dep_file_list(root_dir);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.endsWith(".vyx") && fileExists(path.clone())) {
                let mod = build_module_name_from_file(path.clone());
                if (build_module_is_same_or_child(root_mod.clone(), mod)) {
                    out = build_append_unique_line(out.clone(), path);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_group_stamp_partition(group_sources: string, primary_src: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_line_at(group_sources.clone(), i);
        out = out + "group_src=" + src + ";";
        if (src != primary_src) {
            out = out + "group_src_content=" + build_file_content_stamp(src) + ";";
        }
        i = i + 1;
    }
    return out;
}





/// Return every registry source for an imported module.  Versioned module
/// definitions deliberately share the same module name, so selecting one
/// arbitrary file here loses historical declarations and migration bodies.


fn build_line_contains(lines: string, item: string) -> bool {
    if (item.len == 0) { return false; }
    return build_contains("\n" + lines + "\n", "\n" + item + "\n");
}

fn build_std_registry_sources() -> string {
    var root = build_env_value("VYX_STD_PACKAGES");
    if (!fileExists(build_join_path(root.clone(), "registry"))) {
        root = build_join_path(build_exe_dir(), "std_packages");
    }
    if (!fileExists(build_join_path(root.clone(), "registry"))) {
        root = build_join_path(build_dirname(build_exe_dir()), "std_packages");
    }
    if (!fileExists(build_join_path(root.clone(), "registry"))) {
        root = "std_packages";
    }
    let registry = build_join_path(root.clone(), "registry");
    if (!fileExists(registry.clone())) { return ""; }
    let entries = readFile(registry);
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(entries);
    while (i < n) {
        let rel = build_line_at(entries, i).trim();
        if (rel.len > 0 && !rel.startsWith("#") && !rel.startsWith("//")
            && rel.endsWith(".vyx")) {
            let path = build_join_path(root.clone(), rel);
            if (fileExists(path.clone())) {
                out = build_append_unique_line(out.clone(), path);
            }
        }
        i = i + 1;
    }
    return out;
}

fn build_source_registry_files(entry: string, include_std: bool,
                               std_sources_dir: string, std_excludes: string) -> string {
    let root_dir = build_dirname(entry);
    var out = build_dep_file_list(root_dir.clone());
    let parent = build_dirname(root_dir.clone());
    if (build_path_stem(parent.clone()) == "src") {
        out = build_append_source_lines_unique(out.clone(), build_dep_file_list(parent));
    }
    if (include_std) {
        if (std_sources_dir.len > 0 && isDir(std_sources_dir.clone())) {
            let std_files = build_dep_file_list(std_sources_dir);
            let excluded = toml_array_to_lines(std_excludes);
            var local_modules: string = "";
            var std_i: i64 = 0;
            let std_n = build_line_count(std_files.clone());
            while (std_i < std_n) {
                let path = build_line_at(std_files.clone(), std_i).trim();
                if (path.len > 0 && !build_line_contains(excluded.clone(),
                                                         build_path_stem(path.clone()))) {
                    out = build_append_unique_line(out.clone(), path);
                    local_modules = build_pipe_set_add(
                        local_modules, build_module_name_from_file(path));
                }
                std_i = std_i + 1;
            }
            // A local bootstrap std overlays whole modules, while modules it
            // does not provide (for example std.serde.toml) still come from
            // the package registry. Never put two implementations of one
            // module into the same object plan.
            let package_files = build_std_registry_sources();
            var package_i: i64 = 0;
            let package_n = build_line_count(package_files.clone());
            while (package_i < package_n) {
                let path = build_line_at(package_files.clone(), package_i).trim();
                if (path.len > 0 && !build_pipe_set_has(
                        local_modules, build_module_name_from_file(path.clone()))) {
                    out = build_append_unique_line(out.clone(), path);
                }
                package_i = package_i + 1;
            }
        } else {
            out = build_append_source_lines_unique(out.clone(), build_std_registry_sources());
        }
    }
    return out;
}

fn build_import_module_from_line(line_in: string) -> string {
    var line = line_in.trim();
    if (line.len == 0 || line.startsWith("//")) { return ""; }
    var rest: string = "";
    if (line.startsWith("import ")) {
        rest = line.substring(7, line.len).trim();
    } else if (line.startsWith("use ")) {
        rest = line.substring(4, line.len).trim();
    } else {
        return "";
    }
    let eq = rest.indexOf("=");
    if (eq >= 0) {
        rest = rest.substring(eq + 1, rest.len).trim();
    }
    var out: string = "";
    var i: i32 = 0;
    while (i < rest.len) {
        let c = rest.charAt(i);
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            || (c >= 48 && c <= 57) || c == 95 || c == 46) {
            out = out + rest.substring(i, i + 1);
        } else if (c == 58 && i + 1 < rest.len && rest.charAt(i + 1) == 58) {
            out = out + ".";
            i = i + 1;
        } else {
            break;
        }
        i = i + 1;
    }
    return out;
}

fn build_import_modules_for_source_mode(src: string, include_std: bool) -> string {
    if (src.len == 0 || !fileExists(src.clone())) { return ""; }
    let text = readFile(src);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var line = text.substring(start, i);
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1);
            }
            let mod = build_import_module_from_line(line);
            if (mod.len > 0 && (include_std || (mod != "std" && !mod.startsWith("std.")))) {
                out = build_pipe_set_add(out, mod);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_import_modules_for_source(src: string) -> string {
    return build_import_modules_for_source_mode(src, false);
}

/// Return the transitive local source closure rooted at `entry`.
fn build_auto_vyx_import_sources_mode(entry: string, include_std: bool,
                                      std_sources_dir: string, std_excludes: string) -> string {
    if (entry.len == 0 || !fileExists(entry)) { return ""; }
    let registry_files = build_source_registry_files(entry, include_std,
                                                     std_sources_dir, std_excludes);
    var index = build_make_source_index_mode(registry_files, include_std, true);
    if (index.source_id(entry) < 0) {
        // The entry can be spelled differently from a registry's path. Keep
        // the existing exact-path contract rather than merging by basename.
        index.add(entry, build_module_name_from_file(entry), build_source_group_key(entry), "");
    }
    let entry_id = index.source_id(entry);
    var visited = Vec::<i64>.with_capacity(index.rows.len);
    var queue = Vec::<i64>.with_capacity(index.rows.len);
    var n: i64 = 0;
    while (n < index.rows.len) { visited.push(0); n = n + 1; }
    visited.set(entry_id, 1);
    queue.push(entry_id);
    var out: string = "";
    var qi: i64 = 0;
    while (qi < queue.len) {
        let current = index.rows.get_ptr(queue.get(qi));
        // Registry entries describe available modules, not selected build inputs.
        // Read dependency edges only when a source becomes reachable. Each ID is
        // queued once, including version/variant peers, so this also reads each
        // reached source once without scanning bodies of unused SDK modules.
        let mods = build_import_modules_for_source_mode(current[0].path, include_std);
        var pos: i32 = 0;
        var start: i32 = 0;
        while (pos <= mods.len) {
            if (pos == mods.len || mods.charAt(pos) == 124) {
                let match_id = index.module_id(mods.substring(start, pos));
                if (match_id >= 0) {
                    let matched = index.rows.get_ptr(match_id);
                    let module_name = matched[0].module_name;
                    // Version/variant peers all participate in registry
                    // closure. Only partition lookup selects the first file.
                    var di: i64 = 0;
                    while (di < index.rows.len) {
                        let dep = index.rows.get_ptr(di);
                        if (dep[0].module_name == module_name && visited.get(di) == 0) {
                            visited.set(di, 1);
                            queue.push(di);
                            out = out + dep[0].path + "\n";
                        }
                        di = di + 1;
                    }
                }
                start = pos + 1;
            }
            pos = pos + 1;
        }
        qi = qi + 1;
    }
    queue.destroy();
    visited.destroy();
    index.destroy();
    return out;
}

public fn build_auto_vyx_import_sources(entry: string) -> string {
    return build_auto_vyx_import_sources_mode(entry, false, "", "");
}

/// Whole-item membership test on a `|`-separated set.
///
/// The old body evaluated `build_contains("|" + set + "|", "|" + value + "|")`,
/// which materialises the wrapped set on every probe.  Planning probes this
/// once per candidate root name and per generic call site, so on a target with
/// thousands of roots those copies were the bulk of the planner's transient
/// allocations (gigabytes on the Zyn target) even though the set never changes.
/// The item-wise scan below allocates nothing; a value that itself contains the
/// separator cannot be compared item-wise, so that case keeps the original
/// wrapped-substring semantics.

fn build_pipe_item_count(set: string) -> i64 {
    if (set.len == 0) { return 0; }
    var out: i64 = 1;
    var i: i32 = 0;
    while (i < set.len) {
        if (set.charAt(i) == 124) { out = out + 1; }
        i = i + 1;
    }
    return out;
}

fn build_pipe_item_at(set: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= set.len) {
        if (i == set.len || set.charAt(i) == 124) {
            if (idx == want) { return set.substring(start, i); }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_pipe_item_range(set: string, first: i64, count: i64) -> string {
    var out: string = "";
    var idx: i64 = 0;
    var taken: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= set.len && taken < count) {
        if (i == set.len || set.charAt(i) == 124) {
            if (idx >= first) {
                let item = set.substring(start, i);
                if (item.len > 0) {
                    out = build_pipe_set_add(out, item);
                    taken = taken + 1;
                }
            }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_new_mir_root_chunk_size(src: string, root_count: i64) -> i64 {
    if (root_count <= 1) { return 1; }
    // Several roots in one small module cost more to reparse in separate
    // processes than they save in backend time. Parallelize across modules.
    if (root_count <= 8) { return root_count; }
    let source_len = readFile(src.clone()).len;
    if (source_len >= 700000 && root_count > 64) { return 64; }
    if (source_len >= 350000 && root_count > 64) { return 64; }
    if (source_len >= 180000 && root_count > 96) { return 96; }
    // A many-file module is reparsed by every partition worker.  Keep enough
    // chunks to use the machine, but avoid paying that frontend cost 18-30
    // times for a large group such as Zyn.App.
    if (root_count > 1536) { return 192; }
    if (root_count > 768) { return 128; }
    if (root_count > 384) { return 96; }
    if (root_count > 192) { return 64; }
    if (source_len >= 100000 && root_count > 64) { return 32; }
    if (source_len >= 100000 && root_count > 16) { return 8; }
    // Small sources still parse the whole module for every chunk.  Keep
    // enough chunks for parallelism, but do not create one object per root.
    if (root_count > 32) { return 32; }
    if (root_count > 8) { return 8; }
    return 1;
}

fn build_should_root_partition_for_roots(src: string, roots: string) -> bool {
    let root_count = build_pipe_item_count(roots.clone());
    if (root_count <= 1) { return false; }
    let chunk = build_new_mir_root_chunk_size(src.clone(), root_count);
    return chunk > 0 && chunk < root_count;
}

fn build_new_mir_root_chunk_count(src: string, roots: string) -> i64 {
    let root_count = build_pipe_item_count(roots.clone());
    if (root_count <= 0) { return 1; }
    var chunk = build_new_mir_root_chunk_size(src.clone(), root_count);
    if (chunk <= 0) { chunk = 1; }
    var out: i64 = 0;
    var pos: i64 = 0;
    while (pos < root_count) {
        out = out + 1;
        pos = pos + chunk;
    }
    if (out <= 0) { return 1; }
    return out;
}

fn build_public_fn_name_from_line(line: string) -> string {
    var sig = line;
    if (sig.endsWith("\r")) {
        sig = sig.substring(0, sig.len - 1);
    }
    var start: i32 = 0;
    if (sig.startsWith("public fn ")) {
        start = 10;
    } else if (sig.startsWith("public static fn ")) {
        start = 17;
    } else {
        return "";
    }
    var i: i32 = start;
    while (i < sig.len) {
        let c = sig.charAt(i);
        if (c == 40 || c == 60 || c == 32 || c == 9) {
            if (i > start) { return sig.substring(start, i); }
            return "";
        }
        i = i + 1;
    }
    if (i > start) { return sig.substring(start, i); }
    return "";
}

fn build_text_starts_with_at(text: string, pos: i32, end: i32, prefix: string) -> bool {
    if (pos < 0 || end < pos || pos + (prefix.len as i32) > end) { return false; }
    var i: i32 = 0;
    while (i < (prefix.len as i32)) {
        if (text.charAt(pos + i) != prefix.charAt(i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn build_fn_name_from_text_range(text: string,
                                 start_in: i32,
                                 end_in: i32,
                                 trim_left: bool,
                                 include_private: bool,
                                 require_indent: bool) -> string {
    var start = start_in;
    var end = end_in;
    if (end > start && text.charAt(end - 1) == 13) {
        end = end - 1;
    }
    var had_indent = false;
    if (trim_left || require_indent) {
        while (start < end) {
            let c = text.charAt(start);
            if (c == 32 || c == 9) {
                had_indent = true;
                start = start + 1;
            } else {
                break;
            }
        }
    }
    if (require_indent && !had_indent) { return ""; }

    var explicit_public = false;
    var explicit_visibility_root = false;
    var prefix_progress = true;
    while (prefix_progress) {
        prefix_progress = false;
        while (start < end) {
            let c0 = text.charAt(start);
            if (c0 == 32 || c0 == 9) {
                start = start + 1;
            } else {
                break;
            }
        }
        if (build_text_starts_with_at(text, start, end, "public ")) {
            explicit_public = true;
            start = start + 7;
            prefix_progress = true;
        } else if (build_text_starts_with_at(text, start, end, "override ")) {
            explicit_visibility_root = true;
            start = start + 9;
            prefix_progress = true;
        } else if (build_text_starts_with_at(text, start, end, "virtual ")) {
            explicit_visibility_root = true;
            start = start + 8;
            prefix_progress = true;
        } else if (build_text_starts_with_at(text, start, end, "final ")) {
            explicit_visibility_root = true;
            start = start + 6;
            prefix_progress = true;
        } else if (build_text_starts_with_at(text, start, end, "@[")) {
            var attr_end = start + 2;
            while (attr_end < end && text.charAt(attr_end) != 93) {
                attr_end = attr_end + 1;
            }
            if (attr_end < end && text.charAt(attr_end) == 93) {
                let attr = text.substring(start, attr_end + 1);
                if (build_contains(attr.clone(), "vis(")
                    && !build_contains(attr.clone(), "vis(none")) {
                    explicit_visibility_root = true;
                }
                start = attr_end + 1;
                prefix_progress = true;
            }
        }
    }

    var name_start: i32 = -1;
    let allowed_external = include_private || explicit_public || explicit_visibility_root;
    if (allowed_external && build_text_starts_with_at(text, start, end, "fn ")) {
        name_start = start + 3;
    } else if (allowed_external && build_text_starts_with_at(text, start, end, "static fn ")) {
        name_start = start + 10;
    } else {
        return "";
    }

    var i: i32 = name_start;
    while (i < end) {
        let c = text.charAt(i);
        if (c == 40 || c == 60 || c == 32 || c == 9) {
            if (i > name_start) { return text.substring(name_start, i); }
            return "";
        }
        i = i + 1;
    }
    if (i > name_start) { return text.substring(name_start, i); }
    return "";
}

fn build_any_fn_name_from_line(line: string) -> string {
    var sig = line;
    if (sig.endsWith("\r")) {
        sig = sig.substring(0, sig.len - 1);
    }
    var start: i32 = 0;
    if (sig.startsWith("public fn ")) {
        start = 10;
    } else if (sig.startsWith("public static fn ")) {
        start = 17;
    } else if (sig.startsWith("fn ")) {
        start = 3;
    } else if (sig.startsWith("static fn ")) {
        start = 10;
    } else {
        return "";
    }
    var i: i32 = start;
    while (i < sig.len) {
        let c = sig.charAt(i);
        if (c == 40 || c == 60 || c == 32 || c == 9) {
            if (i > start) { return sig.substring(start, i); }
            return "";
        }
        i = i + 1;
    }
    if (i > start) { return sig.substring(start, i); }
    return "";
}

var g_build_public_fn_names_cache: string = "";
var g_build_public_fn_names_with_methods_cache: string = "";
var g_build_public_method_names_cache: string = "";
var g_build_source_has_function_cache: string = "";
var g_build_duplicate_root_name_cache: string = "";

fn build_source_scan_cache_key(src: string, tag: string) -> string {
    return tag + "\t" + src + "\t"
           + build_file_mtime(src.clone()).toString() + "\t"
           + fileSize(src.clone()).toString() + "\t";
}

fn build_source_scan_cache_get(cache: string, key: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= cache.len) {
        if (i == cache.len || cache.charAt(i) == 10) {
            var end = i;
            if (end > start && cache.charAt(end - 1) == 13) {
                end = end - 1;
            }
            if (end > start) {
                let line = cache.substring(start, end);
                if (line.startsWith(key)) {
                    return line.substring(key.len, line.len);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "<MISS>";
}

fn build_public_fn_names_for_source(src: string) -> string {
    if (src.len == 0 || !fileExists(src.clone())) { return ""; }
    let cache_key = build_source_scan_cache_key(src.clone(), "public_fn");
    let cached = build_source_scan_cache_get(g_build_public_fn_names_cache, cache_key.clone());
    if (cached != "<MISS>") { return cached; }
    let text = readFile(src);
    var out: string = "";
    var pending_public = false;
    var pending_visibility_root = false;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            let line = text.substring(start, i);
            var name = build_fn_name_from_text_range(text, start, i, false, false, false);
            if (name.len == 0 && (pending_public || pending_visibility_root)) {
                name = build_fn_name_from_text_range(text, start, i, true, true, false);
            }
            if (name.len > 0) {
                out = build_pipe_set_add(out, name);
                pending_public = false;
                pending_visibility_root = false;
            } else {
                let trimmed = line.trim();
                if (trimmed.len == 0 || trimmed.startsWith("//")) {
                    pending_public = false;
                    pending_visibility_root = false;
                } else if (trimmed.startsWith("public")
                           || trimmed.startsWith("@[")) {
                    if (trimmed.startsWith("public")) { pending_public = true; }
                    if (build_contains(trimmed.clone(), "vis(")
                        && !build_contains(trimmed.clone(), "vis(none")) {
                        pending_visibility_root = true;
                    }
                } else {
                    pending_public = false;
                    pending_visibility_root = false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_build_public_fn_names_cache = g_build_public_fn_names_cache + cache_key + out.clone() + "\n";
    return out;
}

fn build_public_fn_names_for_source_with_methods(src: string, include_methods: bool) -> string {
    if (!include_methods) { return build_public_fn_names_for_source(src); }
    if (src.len == 0 || !fileExists(src.clone())) { return ""; }
    let cache_key = build_source_scan_cache_key(src.clone(), "public_fn_methods");
    let cached = build_source_scan_cache_get(g_build_public_fn_names_with_methods_cache, cache_key.clone());
    if (cached != "<MISS>") { return cached; }
    let text = readFile(src);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            let name = build_fn_name_from_text_range(text, start, i, true, true, false);
            if (name.len > 0) {
                out = build_pipe_set_add(out, name);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_build_public_fn_names_with_methods_cache = g_build_public_fn_names_with_methods_cache + cache_key + out.clone() + "\n";
    return out;
}

fn build_public_method_names_for_source(src: string) -> string {
    if (src.len == 0 || !fileExists(src.clone())) { return ""; }
    let cache_key = build_source_scan_cache_key(src.clone(), "public_methods");
    let cached = build_source_scan_cache_get(g_build_public_method_names_cache, cache_key.clone());
    if (cached != "<MISS>") { return cached; }
    let text = readFile(src);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            let name = build_fn_name_from_text_range(text, start, i, true, false, true);
            if (name.len > 0) {
                out = build_pipe_set_add(out, name);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_build_public_method_names_cache = g_build_public_method_names_cache + cache_key + out.clone() + "\n";
    return out;
}

fn build_source_has_function_name(src: string, want: string) -> bool {
    if (src.len == 0 || want.len == 0 || !fileExists(src.clone())) { return false; }
    let cache_key = build_source_scan_cache_key(src.clone(), "has_fn:" + want);
    let cached = build_source_scan_cache_get(g_build_source_has_function_cache, cache_key.clone());
    if (cached == "1") { return true; }
    if (cached == "0") { return false; }
    let text = readFile(src);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            let name = build_fn_name_from_text_range(text, start, i, true, true, false);
            if (name == want) {
                g_build_source_has_function_cache = g_build_source_has_function_cache + cache_key + "1\n";
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_build_source_has_function_cache = g_build_source_has_function_cache + cache_key + "0\n";
    return false;
}

fn build_count_char_in_text_range(text: string, start: i32, end: i32, ch: i32) -> i32 {
    var out: i32 = 0;
    var i = start;
    while (i < end) {
        if (text.charAt(i) == ch) { out = out + 1; }
        i = i + 1;
    }
    return out;
}

fn build_class_name_from_text_range(text: string, start_in: i32, end_in: i32) -> string {
    var start = start_in;
    var end = end_in;
    if (end > start && text.charAt(end - 1) == 13) {
        end = end - 1;
    }
    while (start < end) {
        let c = text.charAt(start);
        if (c == 32 || c == 9) {
            start = start + 1;
        } else {
            break;
        }
    }
    while (true) {
        if (build_text_starts_with_at(text, start, end, "public ")) {
            start = start + 7;
        } else if (build_text_starts_with_at(text, start, end, "private ")) {
            start = start + 8;
        } else if (build_text_starts_with_at(text, start, end, "protected ")) {
            start = start + 10;
        } else if (build_text_starts_with_at(text, start, end, "export ")) {
            start = start + 7;
        } else {
            break;
        }
        while (start < end) {
            let c1 = text.charAt(start);
            if (c1 == 32 || c1 == 9) {
                start = start + 1;
            } else {
                break;
            }
        }
    }
    var name_start: i32 = -1;
    if (build_text_starts_with_at(text, start, end, "class ")) {
        name_start = start + 6;
    } else if (build_text_starts_with_at(text, start, end, "struct ")) {
        name_start = start + 7;
    } else {
        return "";
    }
    while (name_start < end) {
        let c2 = text.charAt(name_start);
        if (c2 == 32 || c2 == 9) {
            name_start = name_start + 1;
        } else {
            break;
        }
    }
    var i = name_start;
    while (i < end) {
        let c3 = text.charAt(i);
        if (c3 == 32 || c3 == 9 || c3 == 58 || c3 == 60 || c3 == 123) {
            if (i > name_start) { return text.substring(name_start, i); }
            return "";
        }
        i = i + 1;
    }
    if (i > name_start) { return text.substring(name_start, i); }
    return "";
}

fn build_source_has_duplicate_root_name(src: string, include_methods: bool) -> bool {
    if (src.len == 0 || !fileExists(src.clone())) { return false; }
    var tag = "dup_root:0";
    if (include_methods) { tag = "dup_root:1"; }
    let cache_key = build_source_scan_cache_key(src.clone(), tag);
    let cached = build_source_scan_cache_get(g_build_duplicate_root_name_cache, cache_key.clone());
    if (cached == "1") { return true; }
    if (cached == "0") { return false; }
    let text = readFile(src);
    var seen: string = "";
    var owner: string = "";
    var owner_depth: i32 = -1;
    var brace_depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            if (owner.len > 0 && owner_depth >= 0 && brace_depth < owner_depth) {
                owner = "";
                owner_depth = -1;
            }
            let class_name = build_class_name_from_text_range(text, start, i);
            if (class_name.len > 0) {
                let opens0 = build_count_char_in_text_range(text, start, i, 123);
                let closes0 = build_count_char_in_text_range(text, start, i, 125);
                if (opens0 > closes0) {
                    owner = class_name;
                    owner_depth = brace_depth + opens0 - closes0;
                }
            }
            let name = build_fn_name_from_text_range(text,
                                                     start,
                                                     i,
                                                     include_methods,
                                                     true,
                                                     false);
            if (name.len > 0) {
                var key = name.clone();
                if (owner.len > 0) {
                    key = owner.clone() + "::" + name;
                }
                if (build_pipe_set_has(seen, key.clone())) {
                    g_build_duplicate_root_name_cache = g_build_duplicate_root_name_cache + cache_key + "1\n";
                    return true;
                }
                seen = build_pipe_set_add(seen, key);
            }
            let opens = build_count_char_in_text_range(text, start, i, 123);
            let closes = build_count_char_in_text_range(text, start, i, 125);
            brace_depth = brace_depth + opens - closes;
            if (brace_depth < 0) { brace_depth = 0; }
            if (owner.len > 0 && owner_depth >= 0 && brace_depth < owner_depth) {
                owner = "";
                owner_depth = -1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_build_duplicate_root_name_cache = g_build_duplicate_root_name_cache + cache_key + "0\n";
    return false;
}

fn build_source_uses_method_root_partition(src: string) -> bool {
    if (build_source_has_duplicate_root_name(src.clone(), true)) {
        return false;
    }
    return src.endsWith("llvm_lower.vyx")
        || src.endsWith("hir_builder.vyx")
        || src.endsWith("mir_builder.vyx")
        || src.endsWith("codegen.vyx")
        || src.endsWith("main.vyx")
        || src.endsWith("sema.vyx")
        || src.endsWith("parser.vyx")
        || src.endsWith("llvm_lower.vyx\r")
        || src.endsWith("hir_builder.vyx\r")
        || src.endsWith("mir_builder.vyx\r")
        || src.endsWith("codegen.vyx\r")
        || src.endsWith("main.vyx\r")
        || src.endsWith("sema.vyx\r")
        || src.endsWith("parser.vyx\r")
        || src.endsWith("llvm_lower.vyx\n")
        || src.endsWith("hir_builder.vyx\n")
        || src.endsWith("mir_builder.vyx\n")
        || src.endsWith("codegen.vyx\n")
        || src.endsWith("main.vyx\n")
        || src.endsWith("sema.vyx\n")
        || src.endsWith("parser.vyx\n");
}

fn build_source_text_references_name(text: string, name: string) -> bool {
    if (name.len == 0) { return false; }
    if (build_contains(text, name + "(")) { return true; }
    if (build_contains(text, name + " (")) { return true; }
    if (build_contains(text, name + "<")) { return true; }
    return false;
}

fn build_matching_angle_end(text: string, open_idx: i32) -> i32 {
    if (open_idx < 0 || open_idx >= text.len || text.charAt(open_idx) != 60) {
        return -1;
    }
    // Generic arguments are short single expressions.  Without a horizon the
    // scan happily balances `<`/`>` across hundreds of source lines (e.g. an
    // identifier followed by `::<` that is really a `->`/comparison chain),
    // and the extracted "arguments" then embed whole function bodies in the
    // export-root command line.
    let horizon = open_idx + 512;
    var depth: i32 = 0;
    var i = open_idx;
    while (i < text.len && i < horizon) {
        let c = text.charAt(i);
        if (c == 60) {
            depth = depth + 1;
        } else if (c == 62) {
            depth = depth - 1;
            if (depth == 0) { return i; }
        }
        i = i + 1;
    }
    return -1;
}

fn build_identifier_boundary_before(text: string, idx: i32) -> bool {
    if (idx <= 0) { return true; }
    let c = text.charAt(idx - 1);
    let digit = c >= 48 && c <= 57;
    let upper = c >= 65 && c <= 90;
    let lower = c >= 97 && c <= 122;
    return !(digit || upper || lower || c == 95 || c == 46);
}

fn build_identifier_boundary_after(text: string, idx: i32) -> bool {
    if (idx >= text.len) { return true; }
    let c = text.charAt(idx);
    let digit = c >= 48 && c <= 57;
    let upper = c >= 65 && c <= 90;
    let lower = c >= 97 && c <= 122;
    return !(digit || upper || lower || c == 95);
}

fn build_generic_call_roots_for_name_in_text(text: string, name: string) -> string {
    if (text.len == 0 || name.len == 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    let nlen: i32 = name.len as i32;
    while (i + nlen + 3 <= (text.len as i32)) {
        var same = true;
        var j: i32 = 0;
        while (j < nlen && same) {
            if (text.charAt(i + j) != name.charAt(j)) { same = false; }
            j = j + 1;
        }
        if (same
            && build_identifier_boundary_before(text, i)
            && build_identifier_boundary_after(text, i + nlen)
            && i + nlen + 2 < (text.len as i32)
            && text.charAt(i + nlen) == 58
            && text.charAt(i + nlen + 1) == 58
            && text.charAt(i + nlen + 2) == 60) {
            let open_idx = i + nlen + 2;
            let close_idx = build_matching_angle_end(text, open_idx);
            if (close_idx > open_idx + 1) {
                let args = text.substring(open_idx + 1, close_idx).trim();
                if (args.len > 0) {
                    out = build_pipe_set_add(out, name + "::<" + args + ">");
                }
                i = close_idx + 1;
            } else {
                i = i + nlen;
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn build_generic_call_roots_for_names_in_text(text: string, names: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    if (text.len == 0 || names.len == 0) { return ""; }
    while (i + 2 < text.len) {
        if (build_is_ident_char(text.charAt(i))
            && build_identifier_boundary_before(text, i)) {
            let name_start = i;
            var name_end = i + 1;
            while (name_end < text.len && build_is_ident_char(text.charAt(name_end))) {
                name_end = name_end + 1;
            }
            if (name_end + 2 < text.len
                && text.charAt(name_end) == 58
                && text.charAt(name_end + 1) == 58
                && text.charAt(name_end + 2) == 60
                && build_identifier_boundary_after(text, name_end)) {
                let name = text.substring(name_start, name_end);
                if (build_pipe_set_has(names, name.clone())) {
                    let close_idx = build_matching_angle_end(text, name_end + 2);
                    if (close_idx > name_end + 3) {
                        let args = text.substring(name_end + 3, close_idx).trim();
                        if (args.len > 0) {
                            out = build_pipe_set_add(out, name + "::<" + args + ">");
                        }
                        i = close_idx + 1;
                    } else {
                        i = name_end;
                    }
                } else {
                    i = name_end;
                }
            } else {
                i = name_end;
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn build_generic_call_roots_for_public_names(public_names: string,
                                             method_names: string,
                                             sources: string) -> string {
    var roots: string = "";
    let names = build_pipe_set_merge(public_names, method_names.clone());
    if (names.len == 0) { return ""; }
    let sn = build_line_count(sources.clone());
    var si: i64 = 0;
    while (si < sn) {
        let other = build_expand_env(build_line_at(sources.clone(), si));
        if (build_source_kind(other.clone()) == "vyx" && fileExists(other.clone())) {
            roots = build_pipe_set_merge(roots,
                                         build_generic_call_roots_for_names_in_text(readFile(other), names.clone()));
        }
        si = si + 1;
    }
    return roots;
}

fn build_add_referenced_public_names(public_names: string, references: string, out: string) -> string {
    var next = out;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= public_names.len) {
        if (i == public_names.len || public_names.charAt(i) == 124) {
            let name = public_names.substring(start, i);
            if (!build_pipe_set_has(next, name.clone())
                && build_source_text_references_name(references, name.clone())) {
                next = build_pipe_set_add(next, name);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return next;
}

fn build_public_names_before_source(src: string, sources: string) -> string {
    var out: string = "";
    var si: i64 = 0;
    let sn = build_line_count(sources.clone());
    while (si < sn) {
        let other = build_expand_env(build_line_at(sources.clone(), si));
        if (other == src) { return out; }
        if (build_source_kind(other.clone()) == "vyx" && fileExists(other.clone())) {
            let names = build_public_fn_names_for_source(other);
            var start: i32 = 0;
            var i: i32 = 0;
            while (i <= names.len) {
                if (i == names.len || names.charAt(i) == 124) {
                    let name = names.substring(start, i);
                    if (name.len > 0) {
                        out = build_pipe_set_add(out, name);
                    }
                    start = i + 1;
                }
                i = i + 1;
            }
        }
        si = si + 1;
    }
    return out;
}

fn build_filter_prior_public_roots(roots: string, prior_public_names: string) -> string {
    if (prior_public_names.len == 0) { return roots; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= roots.len) {
        if (i == roots.len || roots.charAt(i) == 124) {
            let name = roots.substring(start, i);
            if (name.len > 0
                && !build_pipe_set_has(prior_public_names, name.clone())) {
                out = build_pipe_set_add(out, name);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_export_root_names_for_source(src: string, sources: string, prior_public_names: string) -> string {
    let include_methods = build_source_uses_method_root_partition(src.clone());
    if (include_methods) {
        return build_public_fn_names_for_source_with_methods(src.clone(), true);
    }
    let public_names = build_public_fn_names_for_source(src.clone());
    let method_names = build_public_method_names_for_source(src.clone());
    var out: string = "";
    if (build_source_has_function_name(src.clone(), "main")) {
        out = build_pipe_set_add(out, "main");
    }
    out = build_pipe_set_merge(out,
                               build_filter_prior_public_roots(public_names.clone(),
                                                               prior_public_names.clone()));
    out = build_pipe_set_merge(out,
                               build_generic_call_roots_for_public_names(public_names.clone(),
                                                                         method_names.clone(),
                                                                         sources.clone()));
    var method_i: i32 = 0;
    var method_start: i32 = 0;
    while (method_i <= method_names.len) {
        if (method_i == method_names.len || method_names.charAt(method_i) == 124) {
            let name = method_names.substring(method_start, method_i);
            if (name.len > 0) {
                out = build_pipe_set_add(out, name);
            }
            method_start = method_i + 1;
        }
        method_i = method_i + 1;
    }
    return out;
}

fn build_export_root_names_for_sources(group_sources: string,
                                       all_sources: string,
                                       prior_public_names: string) -> string {
    var out: string = "";
    var prior = prior_public_names.clone();
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(group_sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let roots = build_export_root_names_for_source(src.clone(),
                                                          all_sources.clone(),
                                                          prior.clone());
            out = build_pipe_set_merge(out, roots);
            prior = build_pipe_set_merge(prior,
                                         build_public_fn_names_for_source(src.clone()));
        }
        i = i + 1;
    }
    return out;
}

fn build_partition_root_names_for_source(src: string, sources: string, prior_public_names: string) -> string {
    var out = build_export_root_names_for_source(src.clone(),
                                                sources.clone(),
                                                prior_public_names.clone());
    out = build_pipe_set_merge(out,
                               build_public_fn_names_for_source_with_methods(src.clone(), true));
    return out;
}

fn build_partition_root_names_for_sources(group_sources: string,
                                          all_sources: string,
                                          prior_public_names: string) -> string {
    var out: string = "";
    var prior = prior_public_names.clone();
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(group_sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let roots = build_partition_root_names_for_source(src.clone(),
                                                             all_sources.clone(),
                                                             prior.clone());
            out = build_pipe_set_merge(out, roots);
            prior = build_pipe_set_merge(prior,
                                         build_public_fn_names_for_source(src.clone()));
        }
        i = i + 1;
    }
    return out;
}

fn build_root_names_file_path(cache_dir: string, obj_name_src: string, tag: string) -> string {
    return build_join_path(cache_dir, build_safe_obj_name("roots_" + obj_name_src + "_" + tag, ".txt"));
}

fn build_write_root_names_file(cache_dir: string, obj_name_src: string, tag: string, roots: string) -> string {
    let path = build_root_names_file_path(cache_dir, obj_name_src, tag);
    build_ensure_parent(path.clone());
    writeFile(path.clone(), roots);
    return path;
}

fn build_target_interface_root(output_dir: string, target_name: string) -> string {
    return build_join_path(build_join_path(output_dir, ".vyx_interfaces"), target_name);
}

fn build_vyi_path_for_module(root: string, module_name: string) -> string {
    return build_join_path(root, build_module_tail_path(module_name, 0) + ".vyi");
}

fn build_clean_vyi_dir(root: string) {
    if (root.len == 0 || !isDir(root)) { return; }
    let files = build_dep_file_list(root);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.endsWith(".vyi")) {
                deleteFile(path);
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

fn build_path_list_contains(paths: string, path: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= paths.len) {
        if (i == paths.len || paths.charAt(i) == 10) {
            var item = paths.substring(start, i).trim();
            if (item.endsWith("\r")) {
                item = item.substring(0, item.len - 1).trim();
            }
            if (item.len > 0 && build_same_path_loose(item.clone(), path.clone())) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn build_clean_stale_vyi_dir(root: string, valid_paths: string) {
    if (root.len == 0 || !isDir(root)) { return; }
    let files = build_dep_file_list(root);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.endsWith(".vyi") && !build_path_list_contains(valid_paths.clone(), path.clone())) {
                deleteFile(path);
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

fn build_vyi_interface_unit_count(sources: string) -> i64 {
    var out: i64 = 0;
    var seen_groups: string = "";
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let group_key = build_source_group_key(src.clone());
            if (!build_group_key_seen(seen_groups.clone(), group_key.clone())) {
                seen_groups = seen_groups + group_key.clone() + "\n";
                if (build_module_name_from_file(src).len > 0) {
                    out = out + 1;
                }
            }
        }
        i = i + 1;
    }
    return out;
}

fn build_vyi_file_interface_unit_count(sources: string) -> i64 {
    var out: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx"
            && build_module_name_from_file(src).len > 0) {
            out = out + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_vyi_cache_record(src: string,
                          vyi_path: string,
                          cmd: string,
                          self_exe: string,
                          output_path: string,
                          group_sources: string,
                          project_private: bool) -> string {
    var project_private_stamp = "0";
    if (project_private) { project_private_stamp = "1"; }
    let dep_stamp = "src=" + build_file_content_stamp(src.clone())
                    + ";" + build_compiler_stamp(self_exe, output_path)
                    + ";manifest=" + build_file_mtime("Vyx.toml").toString()
                    + ";";
    return "__vyi:" + src + "\t" + vyi_path + "\t"
           + dep_stamp
           + build_group_stamp(group_sources)
           + "vyi_project_private=" + project_private_stamp + ";\t"
           + cmd;
}

fn build_emit_target_vyi_files(self_exe: string,
                               sources: string,
                               source_index: &mut BuildSourceIndex,
                               interface_root: string,
                               cache_dir: string,
                               cache_text: string,
                               cache_index: string,
                               records_path: string,
                               output_path: string,
                               jobs: i32,
                               project_private: bool,
                               module_source_args: string,
                               step_start: i64,
                               step_total: i64) -> i32 {
    let arena_mark = vyx_rt_string_arena_checkpoint();
    build_make_dir(interface_root);
    let vyi_tasks_path = build_join_path(cache_dir.clone(), "tasks_target_vyi.tmp");
    writeFile(vyi_tasks_path.clone(), "");
    var valid_vyi_paths: string = "";
    var seen_groups: string = "";
    var miss_count: i64 = 0;
    var printed_header = false;
    var step: i64 = step_start + 1;
    var prof_clean_ms: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let source_id = source_index.source_id(src);
            if (source_id < 0) {
                build_log(build_error_label() + ": source absent from target snapshot: " + src);
                return 1;
            }
            let source = source_index.rows.get_ptr(source_id);
            let group_key = source[0].group_key;
            let group_sources = source_index.sources_for_group(group_key);
            let split_file = project_private && build_line_count(group_sources.clone()) > 1;
            var skip_group = false;
            if (!split_file) {
                if (build_group_key_seen(seen_groups.clone(), group_key.clone())) {
                    skip_group = true;
                } else {
                    seen_groups = seen_groups + group_key.clone() + "\n";
                }
            }
            if (!skip_group) {
                let module_name = build_module_name_from_file(src.clone());
                if (module_name.len > 0) {
                    var vyi_path = build_vyi_path_for_module(interface_root.clone(), module_name);
                    var record_sources = group_sources.clone();
                    var unit_sources_path: string = "";
                    if (split_file) {
                        vyi_path = build_file_vyi_path(interface_root.clone(), src.clone());
                        record_sources = src.clone() + "\n";
                    } else if (build_line_count(group_sources.clone()) > 1) {
                        unit_sources_path = build_unit_sources_path(cache_dir.clone(), "vyi_" + group_key.clone());
                        build_ensure_parent(unit_sources_path.clone());
                        writeFile(unit_sources_path.clone(), group_sources.clone());
                    }
                    build_ensure_parent(vyi_path.clone());
                    valid_vyi_paths = valid_vyi_paths + vyi_path.clone() + "\n";
                    let plan_mark = vyx_rt_string_arena_checkpoint();
                    var unit_args: string = "";
                    if (unit_sources_path.len > 0) {
                        unit_args = " --unit-sources " + build_quote(unit_sources_path);
                    }
                    var vyi_mode_args = " --emit=vyi --vyi-shallow";
                    if (project_private) {
                        vyi_mode_args = vyi_mode_args + " --vyi-project-private";
                    }
                    let vyi_tmp_path = build_task_tmp_output(vyi_path.clone());
                     let cmd = build_tool_arg(self_exe) + vyi_mode_args + " --src=file "
                               + build_quote(src) + " -o " + build_quote(vyi_tmp_path)
                               + unit_args + module_source_args;
                    let record = build_vyi_cache_record(src,
                                                        vyi_path.clone(),
                                                        cmd,
                                                        self_exe.clone(),
                                                        output_path.clone(),
                                                        record_sources,
                                                        project_private);
                    appendFile(records_path.clone(), record + "\n");
                    if (build_cache_has_indexed(cache_text, cache_index, record, vyi_path)) {
                        if (build_verbose_cache_enabled()) {
                            print(build_progress_label(step.toString(), step_total) + " " + build_status_cache()
                                  + " " + build_path_label(src) + " -> " + build_path_label(vyi_path));
                        }
                    } else {
                        miss_count = miss_count + 1;
                        if (!printed_header) {
                            print(build_color("90", "[vyi]") + " " + build_status_vyi()
                                  + " shallow interface(s) -> " + build_path_label(interface_root));
                            printed_header = true;
                        }
                        let task_line = step.toString() + "\t" + src + "\t" + vyi_path + "\t" + cmd
                                              + "\t" + build_task_source_bytes(record_sources).toString();
                        appendFile(vyi_tasks_path.clone(), task_line + "\n");
                    }
                    // Keep per-task allocations: rewinding the arena here can
                    // free memory that later reads still reference (observed as
                    // source text appearing inside later task lines).
                    step = step + 1;
                }
            }
        }
        i = i + 1;
    }
    if (miss_count > 0) {
        let vyi_tasks = readFile(vyi_tasks_path.clone());
        let task_rc = build_run_tasks(vyi_tasks, miss_count, jobs, step_total);
        if (task_rc != 0) {
            print(build_error_label() + ": target interface emit failed");
            deleteFile(vyi_tasks_path);
            vyx_rt_string_arena_release(arena_mark);
            vyx_rt_heap_trim();
            return 1;
        }
    }
    deleteFile(vyi_tasks_path);
    var clean_mark: i64 = 0;
    if (build_profile_enabled()) { clean_mark = vyx_bootstrap_now_ms(); }
    build_clean_stale_vyi_dir(interface_root.clone(), valid_vyi_paths);
    if (build_profile_enabled()) {
        prof_clean_ms = vyx_bootstrap_now_ms() - clean_mark;
        build_profile_log("vyi cleanup=" + prof_clean_ms.toString() + " ms");
    }
    vyx_rt_string_arena_release(arena_mark);
    vyx_rt_heap_trim();
    return 0;
}

fn build_cli_has_explicit_sysroot() -> bool {
    let argc = argCount();
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--sysroot" && i + 1 < argc) { return true; }
        if (a.startsWith("--sysroot=") && a.len > 10) { return true; }
        i = i + 1;
    }
    return false;
}

// These are per-source lists of peer interfaces, not interface compile jobs.
// Reuse the same target snapshot as object planning. A full group search for
// every file turned an unchanged N-file build into N scans of all sources.
fn build_write_peer_vyi_units(source_index: &mut BuildSourceIndex,
                              interface_root: string,
                              cache_dir: string) -> i32 {
    var i: i64 = 0;
    while (i < source_index.rows.len) {
        let source = source_index.rows.get_ptr(i);
        let src = source[0].path;
        if (build_source_kind(src) == "vyx") {
            let group_sources = source_index.sources_for_group(source[0].group_key);
            if (build_line_count(group_sources) > 1) {
                let peer_unit_path = build_peer_vyi_unit_path(cache_dir, src);
                build_ensure_parent(peer_unit_path);
                let peers = build_sibling_file_vyi_paths(interface_root, group_sources, src);
                if (writeFile(peer_unit_path, peers) != 0) {
                    print("error: failed to write peer interface unit '" + peer_unit_path + "'");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn build_file_stamp(path: string) -> string {
    let stable_path = path.clone();
    let stamp = vyx_bootstrap_file_stamp(build_host_path(stable_path.clone()).c_str());
    if (stamp == null) { return stable_path.clone() + "=missing;"; }
    return from_cstr(stamp);
}

fn build_file_content_stamp(path: string) -> string {
    if (path.len == 0) { return "=missing;"; }
    let content = vyx_bootstrap_file_content_stamp(build_host_path(path.clone()).c_str());
    if (content == null) { return path.clone() + "=missing;"; }
    return from_cstr(content);
}

// Content-addressed stamp for a DCI Descriptor. `.dcib` contracts are binary and
// may be regenerated in place with the same size and a restored mtime, so keying
// dependent compile units on stat metadata alone (build_file_stamp) can miss a
// real contract change. This folds the descriptor's absolute identity and its
// content digest into the compile-unit cache key so the incremental Descriptor
// cache invalidates on any input change (SPEC 16.5).
fn build_dci_descriptor_stamp(path: string) -> string {
    if (path.len == 0) { return ""; }
    let stable_path = path.clone();
    let content = vyx_bootstrap_file_content_stamp(build_host_path(stable_path.clone()).c_str());
    var digest: string = "";
    if (content != null) { digest = from_cstr(content); }
    var out: string = "dci_descriptor_path=" + build_abs_norm_path(stable_path.clone()) + ";";
    out = out + "dci_descriptor_content=" + digest;
    return out;
}

fn build_text_file_stamp(path: string, text: string) -> string {
    let stable_path = path.clone();
    let mt = build_file_mtime(stable_path.clone());
    if (mt < 0) { return stable_path.clone() + "=missing;"; }
    var out = stable_path.clone();
    out = out + "=mtime:";
    out = out + mt.toString();
    out = out + ",size:";
    out = out + text.len.toString();
    out = out + ";";
    return out;
}

fn build_dep_output_path(dep_path: string, path: string) -> string {
    if (build_is_abs_path(path)) { return path; }
    return build_join_path(dep_path, path);
}

fn build_dependency_vyi_stamp_one(dep_name: string,
                                  dep_path: string,
                                  target_name: string,
                                  target_output_dir: string) -> string {
    let dep_manifest_path = build_join_path(dep_path, "Vyx.toml");
    let dep_manifest = readFile(dep_manifest_path);
    if (dep_manifest.len == 0 && !fileExists(dep_manifest_path)) {
        return "dep_manifest_missing=" + dep_manifest_path + ";";
    }
    let dep_primary_vyi_path = build_dep_output_path(dep_path.clone(), build_vyi_output_path(target_name.clone(), target_output_dir.clone()));
    let dep_output_root = build_dep_output_path(dep_path.clone(), target_output_dir.clone());

    build_make_dir(".cache");
    // The stamp is consumed and removed synchronously, so the dependency key
    // is sufficient here. Including the absolute path made clean nested
    // worktrees exceed Win32's legacy path limit before the helper could open
    // its output file.
    let stamp_tmp = build_join_path(".cache", build_safe_obj_name("depstamp:" + dep_name.clone(), ".tmp"));
    let rc = vyx_bootstrap_write_vyi_stamp(target_name.c_str(),
                                           build_host_path(dep_manifest_path.clone()).c_str(),
                                           build_host_path(dep_primary_vyi_path.clone()).c_str(),
                                           build_host_path(dep_output_root.clone()).c_str(),
                                           build_host_path(stamp_tmp.clone()).c_str());
    if (rc != 0) {
        print(build_error_label() + ": failed to write dependency stamp for " + dep_name);
        return "|ERR|";
    }
    let out = readFile(stamp_tmp.clone());
    deleteFile(stamp_tmp);
    if (out.len == 0) {
        print(build_error_label() + ": empty dependency stamp for " + dep_name);
        return "|ERR|";
    }
    return out;
}

fn build_template_sections(content: string) -> string {
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (toml_is_section(line.clone())) {
                let section = toml_section_name(line);
                if (section.startsWith("template.")
                    && !build_contains(section.substring(9, section.len), ".")) {
                    out = build_append_unique_line(out, section.substring(9, section.len));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

public fn build_validate_manifest_templates(manifest: string, targets: string) -> bool {
    let templates = build_template_sections(manifest.clone());
    var i: i64 = 0;
    let n = build_line_count(templates.clone());
    while (i < n) {
        if (build_template_order_visit(manifest.clone(),
                                       build_line_at(templates.clone(), i),
                                       "",
                                       "") == "|ERR|") {
            return false;
        }
        i = i + 1;
    }
    i = 0;
    let target_count = build_line_count(targets.clone());
    while (i < target_count) {
        if (build_effective_target_layers(manifest.clone(),
                                          build_line_at(targets.clone(), i)) == "|ERR|") {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn build_dependency_source_stamp(dep_name: string,
                                 dep_path: string,
                                 source_paths_raw: string) -> string {
    let manifest_path = build_join_path(dep_path, "Vyx.toml");
    var out = "source_dep=" + dep_name + ";" + build_file_stamp(manifest_path) + ";";
    let sources = toml_array_to_lines(source_paths_raw);
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let source = build_line_at(sources.clone(), i);
        if (source.len > 0) { out = out + build_file_stamp(source) + ";"; }
        i = i + 1;
    }
    return out;
}

fn build_dependencies_vyi_stamp(deps: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(deps);
    while (i < n) {
        let line = build_line_at(deps.clone(), i);
        let dep_name = build_field(line.clone(), 0);
        let dep_path = build_expand_env(build_field(line, 1));
        let target_name = build_field(line.clone(), 2);
        let target_kind = build_field(line.clone(), 3);
        let target_output_dir = build_field(line, 4);
        let source_paths = build_field(line, 7);
        let dependency_usage = build_field(line, 8);
        if (dep_name.len > 0 && dep_path.len > 0
            && target_name.len > 0 && target_output_dir.len > 0
            && dependency_usage != "build") {
            if (build_profile_enabled()) {
                build_profile_log("deps-stamp item " + dep_name);
            }
            var dep_stamp: string = "";
            if (target_kind == "source") {
                dep_stamp = build_dependency_source_stamp(dep_name, dep_path, source_paths);
            } else {
                dep_stamp = build_dependency_vyi_stamp_one(dep_name,
                                                           dep_path,
                                                           target_name,
                                                           target_output_dir);
            }
            if (dep_stamp == "|ERR|") { return "|ERR|"; }
            out = out + dep_stamp;
        }
        i = i + 1;
    }
    return out;
}

fn build_compiler_stamp(self_exe: string, output_path: string) -> string {
    // Object-cache records are created before their target links, while this
    // path still names the compiler that launches the compile subcommands.
    // Do not inherit provenance lineage: artifact identity is the cache key.
    return "compiler_artifact=v4;" + build_compiler_artifact_stamp(self_exe)
        + build_effect_input_stamp();
}

// Explicit Effect contracts and package schemas are compiler inputs.  Include
// their content (not only mtime/path) and the requested validity scope in every
// Vyx object/interface cache key.  A warm build must never bypass a changed
// manifest or a newly invalid obligation merely because source files match.
fn build_effect_input_stamp() -> string {
    var out = "";
    let incoming = build_env_value("VYX_EFFECT_MANIFEST_IN");
    if (incoming.len > 0) {
        out = out + build_stamp_digest("effect_manifest_path", incoming.clone());
        out = out + build_stamp_digest("effect_manifest", build_file_content_stamp(incoming));
    }
    let schemas = build_env_value("VYX_EFFECT_SCHEMAS_IN");
    if (schemas.len > 0) {
        out = out + build_stamp_digest("effect_schemas_path", schemas.clone());
        out = out + build_stamp_digest("effect_schemas", build_file_content_stamp(schemas));
    }
    // Package-owned `.attr` files are discovered by each compiler process
    // from the nearest Vyx.toml.  Include their path and content in the build
    // key as well, so a warm build cannot reuse objects after a schema edit.
    let attr_rows = build_attr_file_list(".");
    var ai: i64 = 0;
    let an = build_line_count(attr_rows.clone());
    while (ai < an) {
        let attr = build_line_at(attr_rows.clone(), ai).trim();
        if (attr.toLower().endsWith(".attr")) {
            out = out + build_stamp_digest("effect_attr_path", attr.clone());
            out = out + build_stamp_digest("effect_attr", build_file_content_stamp(attr));
        }
        ai = ai + 1;
    }
    out = out + build_stamp_digest("effect_source", build_env_value("VYX_EFFECT_SOURCE_STAMP"));
    out = out + build_stamp_digest("effect_compiler", build_env_value("VYX_EFFECT_COMPILER_STAMP"));
    out = out + build_stamp_digest("effect_target", build_env_value("VYX_EFFECT_TARGET"));
    out = out + build_stamp_digest("effect_abi", build_env_value("VYX_EFFECT_ABI"));
    out = out + build_stamp_digest("effect_scope", build_env_value("VYX_EFFECT_SCOPE"));
    return out;
}

fn build_compiler_is_selfhost_executable(path: string) -> bool {
    let stem = build_ascii_lower(build_path_stem(path));
    return stem == "boot" || stem == "vyxc";
}

fn build_compiler_artifact_stamp(path: string) -> string {
    if (path.len == 0 || !fileExists(path.clone())) { return "missing"; }
    return build_file_stamp(build_abs_norm_path(path));
}

fn build_compiler_provenance_path(artifact: string) -> string {
    return artifact + ".vyx-provenance";
}

// The record retains the compiler artifact that produced an output executable
// for diagnosis and provenance.  Cache validity is always based on the active
// process artifact, never on an inherited lineage record.
fn build_compiler_provenance_generation(self_exe: string) -> string {
    if (!build_compiler_is_selfhost_executable(self_exe.clone())) { return ""; }
    let sidecar = build_compiler_provenance_path(self_exe.clone());
    if (!fileExists(sidecar.clone())) { return ""; }
    let row = build_line_at(readFile(sidecar), 0);
    if (build_field(row.clone(), 0) != "vyx-compiler-provenance-v1") { return ""; }
    let artifact = build_field(row.clone(), 1);
    let generation = build_field(row, 2);
    if (artifact.len == 0 || generation.len == 0) { return ""; }
    if (artifact != build_compiler_artifact_stamp(self_exe)) { return ""; }
    return generation;
}

fn build_write_compiler_provenance(artifact: string, generation: string) -> i32 {
    if (!build_compiler_is_selfhost_executable(artifact.clone())) { return 0; }
    let artifact_stamp = build_compiler_artifact_stamp(artifact.clone());
    if (artifact_stamp == "missing" || generation.len == 0) { return 1; }
    let row = "vyx-compiler-provenance-v1\t" + artifact_stamp + "\t" + generation + "\n";
    return build_publish_text_file(build_compiler_provenance_path(artifact), row);
}

fn build_dep_stamp(kind: string, src: string, self_exe: string, output_path: string) -> string {
    var out = "src=" + build_file_content_stamp(src)
              + ";" + build_compiler_stamp(self_exe, output_path)
              + ";manifest=" + build_file_mtime("Vyx.toml").toString()
              + ";";
    if (kind == "vyx") {
        let src_dir = build_dirname(src);
        if (src_dir != "std") {
            out = out + build_stamp_digest("std", build_dep_stamp_dir("std"));
        }
        out = out + build_stamp_digest("vyx_deps", build_dep_stamp_dir(".vyx_deps"));
    }
    return out;
}

fn build_dep_stamp_partition(kind: string, src: string, self_exe: string, output_path: string) -> string {
    var out = "partition=1;"
              + build_compiler_stamp(self_exe, output_path)
              + ";manifest=" + build_file_mtime("Vyx.toml").toString()
              + ";";
    if (kind == "vyx") {
        if (build_dirname(src) != "std") {
            out = out + build_stamp_digest("std", build_dep_stamp_dir("std"));
        }
        out = out + build_stamp_digest("vyx_deps", build_dep_stamp_dir(".vyx_deps"));
    }
    return out;
}

fn build_hash_text(text: string) -> i64 {
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < text.len) {
        h = ((h * 33) + (text.charAt(i) as i64)) % 2147483647;
        i = i + 1;
    }
    if (h < 0) { h = -h; }
    return h;
}

fn build_hash_step(hash: i64, c: i32) -> i64 {
    return ((hash * 33) + (c as i64)) % 2147483647;
}

fn build_hash_finish(hash: i64) -> i64 {
    if (hash < 0) { return -hash; }
    return hash;
}

fn build_hash_line_with_newline(hash: i64, line: string) -> i64 {
    var h = hash;
    var i: i32 = 0;
    while (i < line.len) {
        h = build_hash_step(h, line.charAt(i));
        i = i + 1;
    }
    return build_hash_step(h, 10);
}

fn build_stamp_digest(label: string, text: string) -> string {
    if (text.len == 0) { return ""; }
    return label + "_len=" + text.len.toString()
           + "," + label + "_hash=" + build_hash_text(text).toString() + ";";
}

fn build_stamp_cache_path(prefix: string, src: string, discriminator: string) -> string {
    build_make_dir(".cache");
    let key = src + ":" + discriminator.len.toString() + ":" + build_hash_text(discriminator).toString();
    return build_join_path(".cache", build_safe_obj_name(prefix + "_" + key, ".stamp"));
}

fn build_stamp_cache_read(path: string, header: string) -> string {
    if (!fileExists(path.clone())) { return ""; }
    let raw = readFile(path);
    let want = header + "\n";
    if (!raw.startsWith(want)) { return ""; }
    return raw.substring(want.len, raw.len);
}

fn build_stamp_cache_write(path: string, header: string, value: string) {
    build_ensure_parent(path.clone());
    writeFile(path, header + "\n" + value);
}

fn build_source_root_body_stamp(src: string, roots: string) -> string {
    if (src.len == 0 || !fileExists(src.clone())) { return "self=missing;"; }
    let cache_path = build_stamp_cache_path("root_body", src.clone(), roots.clone());
    let cache_header = "v=4;src_mtime=" + build_file_mtime(src.clone()).toString()
                       + ";src_size=" + fileSize(src.clone()).toString()
                       + ";roots_len=" + roots.len.toString()
                       + ";roots_hash=" + build_hash_text(roots.clone()).toString()
                       + ";";
    let cached = build_stamp_cache_read(cache_path.clone(), cache_header.clone());
    if (cached.len > 0) { return cached; }
    let text = readFile(src.clone());
    let full_stamp = "self_full_size=" + text.len.toString()
                     + ",self_full_hash=" + build_hash_text(text).toString() + ";";
    build_stamp_cache_write(cache_path, cache_header, full_stamp.clone());
    return full_stamp;
}

fn build_root_partition_stamp(roots: string, chunk_size: i64) -> string {
    return "root_chunk_size=" + chunk_size.toString()
           + ";root_names_len=" + roots.len.toString()
           + ";root_names_hash=" + build_hash_text(roots.clone()).toString()
           + ";";
}

fn build_source_interface_stamp(src: string) -> string {
    if (src.len == 0 || !fileExists(src.clone())) {
        return src + "=missing;";
    }
    let cache_path = build_stamp_cache_path("iface", src.clone(), "");
    let cache_header = "src_mtime=" + build_file_mtime(src.clone()).toString()
                       + ";src_size=" + fileSize(src.clone()).toString()
                       + ";";
    let cached = build_stamp_cache_read(cache_path.clone(), cache_header.clone());
    if (cached.len > 0) { return cached; }
    let text = readFile(src);
    var iface_size: i64 = 0;
    var iface_hash: i64 = 5381;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var line = text.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.startsWith("module ")
                || line.startsWith("public ")
                || line.startsWith("@[")
                || line.startsWith("use ")
                || line.startsWith("import ")) {
                iface_size = iface_size + line.len + 1;
                iface_hash = build_hash_line_with_newline(iface_hash, line);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let stamp = src + "=iface_size:" + iface_size.toString()
                + ",iface_hash:" + build_hash_finish(iface_hash).toString() + ";";
    build_stamp_cache_write(cache_path, cache_header, stamp.clone());
    return stamp;
}



fn build_make_source_index(sources: string) -> BuildSourceIndex {
    return build_make_source_index_mode(sources, false, false);
}

fn build_make_source_index_mode(sources: string, include_std: bool, registry: bool) -> BuildSourceIndex {
    var index = BuildSourceIndex.create(build_line_count(sources));
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= sources.len) {
        if (pos == sources.len || sources.charAt(pos) == 10) {
            if (pos > start) {
                var src = build_expand_env(sources.substring(start, pos));
                if (registry) { src = src.trim(); }
                var mod = "";
                var imports = "";
                if (build_source_kind(src) == "vyx" && fileExists(src)) {
                    mod = build_module_name_from_file(src);
                    if (!registry) {
                        imports = build_import_modules_for_source_mode(src, include_std);
                    }
                }
                index.add(src, mod, build_source_group_key(src), imports);
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    return index;
}

// Reuse breadth-first walk buffers across source roots. MIR partitioning
// invokes this once per source; allocating and destroying two O(N) vectors in
// every invocation made planning scale quadratically in allocator traffic on
// large import graphs even though the graph itself is immutable for a target.
class BuildPartitionWalkScratch {
    public visited: Vec<i64>;
    public queue: Vec<i64>;

    public static fn create(count: i64) -> BuildPartitionWalkScratch {
        var out = BuildPartitionWalkScratch {
            visited: Vec::<i64>.with_capacity(count),
            queue: Vec::<i64>.with_capacity(count)
        };
        var i: i64 = 0;
        while (i < count) { out.visited.push(0); i = i + 1; }
        return out;
    }

    public fn reset() {
        var i: i64 = 0;
        while (i < self.visited.len) { self.visited.set(i, 0); i = i + 1; }
        self.queue.clear();
    }

    public fn destroy() {
        self.visited.destroy();
        self.queue.destroy();
    }
}

fn build_partition_dependency_stamp(source_id: i64,
                                    index: &mut BuildSourceIndex,
                                    scratch: &mut BuildPartitionWalkScratch) -> string {
    scratch.reset();
    scratch.visited.set(source_id, 1);
    scratch.queue.push(source_id);
    var out: string = "";
    var qi: i64 = 0;
    while (qi < scratch.queue.len) {
        let row = index.rows.get_ptr(scratch.queue.get(qi));
        let mods = row[0].imports;
        var start: i32 = 0;
        var pos: i32 = 0;
        while (pos <= mods.len) {
            if (pos == mods.len || mods.charAt(pos) == 124) {
                let dep_id = index.module_id(mods.substring(start, pos));
                if (dep_id >= 0 && scratch.visited.get(dep_id) == 0) {
                    scratch.visited.set(dep_id, 1);
                    scratch.queue.push(dep_id);
                    var dep = index.rows.get_ptr(dep_id);
                    if (!dep[0].stamp_ready) {
                        dep[0].interface_stamp = build_source_interface_stamp(dep[0].path);
                        dep[0].stamp_ready = true;
                    }
                    // Discovery order matches the existing breadth-first stamp.
                    out = out + "dep_iface:" + dep[0].interface_stamp;
                }
                start = pos + 1;
            }
            pos = pos + 1;
        }
        qi = qi + 1;
    }
    scratch.queue.clear();
    return out;
}

fn build_cache_record(kind: string,
                      src: string,
                      obj: string,
                      cmd: string,
                      self_exe: string,
                      output_path: string,
                      group_sources: string,
                       dependency_stamp: string,
                       partition_deps: bool,
                       common_std_stamp: string,
                       common_vyx_deps_stamp: string) -> string {
    let src_stamp = build_file_content_stamp(src.clone());
    let compiler_stamp = build_compiler_stamp(self_exe.clone(), output_path.clone());
    let manifest_mtime = build_file_mtime("Vyx.toml");
    var dep_stamp = "src=" + src_stamp;
    dep_stamp = dep_stamp.clone() + ";";
    if (kind == "vyx") {
        dep_stamp = dep_stamp.clone() + compiler_stamp.clone();
        dep_stamp = dep_stamp.clone() + ";";
    }
    dep_stamp = dep_stamp.clone() + "manifest=";
    dep_stamp = dep_stamp.clone() + manifest_mtime.toString();
    dep_stamp = dep_stamp.clone() + ";";
    if (kind == "vyx") {
        let src_dir = build_dirname(src.clone());
        if (src_dir != "std") {
            dep_stamp = dep_stamp.clone() + build_stamp_digest("std", common_std_stamp.clone());
        }
        dep_stamp = dep_stamp.clone() + build_stamp_digest("vyx_deps", common_vyx_deps_stamp.clone());
    }
    if (partition_deps) {
        let part_compiler_stamp = build_compiler_stamp(self_exe.clone(), output_path.clone());
        let part_manifest_mtime = build_file_mtime("Vyx.toml");
        dep_stamp = "partition=1;";
        dep_stamp = dep_stamp.clone() + part_compiler_stamp.clone();
        dep_stamp = dep_stamp.clone() + ";manifest=";
        dep_stamp = dep_stamp.clone() + part_manifest_mtime.toString();
        dep_stamp = dep_stamp.clone() + ";";
        if (kind == "vyx") {
            if (build_dirname(src.clone()) != "std") {
                dep_stamp = dep_stamp.clone() + build_stamp_digest("std", common_std_stamp.clone());
            }
            dep_stamp = dep_stamp.clone() + build_stamp_digest("vyx_deps", common_vyx_deps_stamp.clone());
        }
    }
    var group_stamp = build_group_stamp(group_sources.clone());
    if (partition_deps) {
        group_stamp = build_group_stamp_partition(group_sources.clone(), src.clone());
    }
    var out = src.clone() + "\t";
    out = out.clone() + obj.clone();
    out = out.clone() + "\t";
    out = out.clone() + dep_stamp.clone();
    out = out.clone() + group_stamp.clone();
    out = out.clone() + dependency_stamp.clone();
    out = out.clone() + "\t";
    out = out.clone() + cmd.clone();
    return out;
}

fn build_cache_replace(cache: string, record: string) -> string {
    let src = build_field(record, 0);
    let obj = build_field(record, 1);
    var out = StringBuilder.withCapacity(cache.len + record.len + 2);
    var start: i32 = 0;
    var i: i32 = 0;
    var wrote: bool = false;
    while (i <= cache.len) {
        if (i == cache.len || cache.charAt(i) == 10) {
            let line = cache.substring(start, i);
            if (line.len > 0) {
                if (build_field(line, 0) == src && build_field(line, 1) == obj) {
                    if (!wrote) {
                        out.append(record);
                        out.append("\n");
                        wrote = true;
                    }
                } else {
                    out.append(line);
                    out.append("\n");
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (!wrote) {
        out.append(record);
        out.append("\n");
    }
    // Primitive string must outlive the owned builder result, including SSO.
    var owned = out.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    return result;
}

fn build_cache_replace_record_file(path: string, record: string) -> bool {
    return writeFile(path.clone(), build_cache_replace(readFile(path), record)) == 0;
}

fn build_cache_record_key(record: string) -> string {
    return build_field(record, 0) + "\t" + build_field(record, 1);
}

fn build_record_key_list_contains(keys: string, key: string) -> bool {
    return build_contains("\n" + keys, "\n" + key + "\n");
}

fn build_records_find_by_key(records: string, key: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= records.len) {
        if (i == records.len || records.charAt(i) == 10) {
            let line = records.substring(start, i);
            if (line.len > 0 && build_cache_record_key(line) == key) {
                return line;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_cache_replace_many(cache: string, records: string) -> string {
    // Inputs and lookup keys are borrowed. Copying the complete replacement
    // block once per old record multiplies retained memory by record count.
    var out = StringBuilder.withCapacity(cache.len + records.len + 2);
    var wrote_keys: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= cache.len) {
        if (i == cache.len || cache.charAt(i) == 10) {
            let line = cache.substring(start, i);
            if (line.len > 0) {
                let key = build_cache_record_key(line);
                let replacement = build_records_find_by_key(records, key);
                if (replacement.len > 0) {
                    if (!build_record_key_list_contains(wrote_keys, key)) {
                        out.append(replacement);
                        out.append("\n");
                        wrote_keys = wrote_keys + key + "\n";
                    }
                } else {
                    out.append(line);
                    out.append("\n");
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    var rstart: i32 = 0;
    var ri: i32 = 0;
    while (ri <= records.len) {
        if (ri == records.len || records.charAt(ri) == 10) {
            let record = records.substring(rstart, ri);
            if (record.len > 0) {
                let rkey = build_cache_record_key(record);
                if (!build_record_key_list_contains(wrote_keys, rkey)) {
                    out.append(record);
                    out.append("\n");
                    wrote_keys = wrote_keys + rkey + "\n";
                }
            }
            rstart = ri + 1;
        }
        ri = ri + 1;
    }
    // Primitive string must outlive the owned builder result, including SSO.
    var owned = out.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    return result;
}

fn build_color_enabled() -> bool {
    let mode = build_env_value("VYX_COLOR").trim();
    if (mode == "0" || mode == "false" || mode == "no" || mode == "off" || mode == "never") {
        return false;
    }
    if (mode == "1" || mode == "true" || mode == "yes" || mode == "on" || mode == "always") {
        return true;
    }
    if (build_env_value("NO_COLOR").len > 0) { return false; }
    return true;
}

fn build_ansi_escape() -> string {
    let p = malloc(2);
    if (p == null) { return ""; }
    memset(p, 27, 1);
    memset(p + 1, 0, 1);
    return from_raw_string_parts(p, 1, 2, 1);
}

fn build_color(code: string, text: string) -> string {
    if (!build_color_enabled()) { return text; }
    let esc = build_ansi_escape();
    if (esc.len == 0) { return text; }
    return esc + "[" + code + "m" + text + esc + "[0m";
}

fn build_progress_label(step: string, total: i64) -> string {
    return build_color("90", "[" + step + "/" + total.toString() + "]");
}

fn build_status_compile() -> string { return build_color("1;32", "compile"); }
fn build_status_cache() -> string { return build_color("1;33", "cache"); }
fn build_status_link() -> string { return build_color("1;35", "link"); }
fn build_status_vyi() -> string { return build_color("1;36", "vyi"); }
fn build_status_built() -> string { return build_color("1;32", "built"); }
fn build_error_label() -> string { return build_color("1;31", "error"); }
fn build_path_label(path: string) -> string { return build_color("36", path); }

fn build_log(msg: string) {
    print(msg);
}

fn build_trace(msg: string) {
    if (build_env_enabled("VYX_BUILD_TRACE")) {
        build_make_dir(".cache");
        appendFile(build_join_path(".cache", "build_trace.log"), msg + "\n");
    }
}

fn build_env_enabled(name: string) -> bool {
    let value = build_env_value(name).trim();
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE"
        || value == "no" || value == "NO" || value == "off" || value == "OFF") {
        return false;
    }
    return true;
}

fn build_profile_enabled() -> bool {
    return build_env_enabled("VYX_BUILD_PROFILE");
}

fn build_verbose_cache_enabled() -> bool {
    return build_env_enabled("VYX_BUILD_VERBOSE_CACHE");
}

fn build_profile_mark(label: string, start_ms: i64) -> i64 {
    if (!build_profile_enabled()) { return start_ms; }
    let now = vyx_bootstrap_now_ms();
    build_log("[build-prof] " + label + ": " + (now - start_ms).toString() + " ms");
    return now;
}

fn build_profile_log(msg: string) {
    if (build_profile_enabled()) {
        build_log("[build-prof] " + msg);
    }
}

fn build_mem_profile_enabled() -> bool {
    return build_env_enabled("VYX_BUILD_MEM_PROFILE");
}

fn build_mem_mb_text(bytes: i64) -> string {
    if (bytes <= 0) { return "0"; }
    return (bytes / (1024 * 1024)).toString();
}

fn build_mem_profile_log(label: string) {
    if (!build_mem_profile_enabled()) { return; }
    let text = "[build-mem] " + label
               + " str_active_mb=" + build_mem_mb_text(vyx_rt_string_arena_active_bytes())
               + " str_reserved_mb=" + build_mem_mb_text(vyx_rt_string_arena_reserved_bytes())
               + " heap_mb=" + build_mem_mb_text(vyx_rt_heap_used_bytes());
    // Mirror to the trace file: stdout is buffered and is lost when the
    // driver dies mid-build, so the profile has to land somewhere durable.
    build_trace(text);
    build_log(text);
}

fn build_heap_bucket_report(label: string) {
    if (build_env_enabled("VYX_BUILD_HEAP_BUCKETS")) {
        vyx_rt_heap_bucket_report(label.c_str());
    }
}

fn build_run_process(cmd: string, cwd: string, stdout_path: string, stderr_path: string) -> i32 {
    if (build_env_value("VYX_DEBUG_LINK").len > 0) {
        build_log("[boot-cmd] " + cmd);
    }
    let cmd2 = cmd.clone();
    let cwd2 = cwd.clone();
    let stdout2 = stdout_path.clone();
    let stderr2 = stderr_path.clone();
    let pid = vyx_bootstrap_process_spawn(cmd2.c_str(),
                                          cwd2.c_str(),
                                          stdout2.c_str(),
                                          stderr2.c_str(),
                                          "".c_str(),
                                          "".c_str());
    if (pid == 0) {
        build_log(build_error_label() + ": failed to spawn process");
        build_log("command: " + cmd);
        return -1;
    }
    let rc = vyx_bootstrap_process_wait(pid);
    vyx_bootstrap_process_close(pid);
    return rc;
}

// ── Live child-output forwarding ────────────────────────────────────
// A crate compiles as ONE unity object, so the compile task is a single
// long child process.  Its stdout is captured to `<obj>.compile.out.log`
// for the failure report, which used to leave the console silent from the
// `[build] crate ...` plan line until the object was ready.  The compiler
// flushes line by line, so polling the capture file lets the build echo
// progress (`[1/3] parse ...`) as it happens while still keeping the exact
// same recorded log for the failure path.
//
// Forwarding is best effort: an oversized log (only reachable with phase
// tracing enabled) stops streaming instead of paying repeated whole-file
// reads.
var g_build_stream_offset: i64 = 0;

fn build_forward_new_lines(log_path: string, offset: i64) -> i64 {
    if (log_path.len == 0) { return offset; }
    if (!fileExists(log_path.clone())) { return offset; }
    let size = fileSize(log_path.clone());
    if (size <= offset) { return offset; }
    if (size > 4194304) { return offset; }
    let text = readFile(log_path.clone());
    if (text.len <= offset as i32) { return offset; }
    var line_start = offset as i32;
    var i = offset as i32;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 10 || c == 13) {
            if (i > line_start) { print(text.substring(line_start, i)); }
            line_start = i + 1;
        }
        i = i + 1;
    }
    return line_start as i64;
}

fn build_run_process_streaming(cmd: string, out_log: string, err_log: string) -> i32 {
    let cmd2 = cmd.clone();
    let out2 = out_log.clone();
    let err2 = err_log.clone();
    let pid = vyx_bootstrap_process_spawn(cmd2.c_str(),
                                          "".c_str(),
                                          out2.c_str(),
                                          err2.c_str(),
                                          "".c_str(),
                                          "".c_str());
    if (pid == 0) {
        g_build_stream_offset = 0;
        return -1;
    }
    var offset: i64 = 0;
    while (vyx_bootstrap_process_is_running(pid) != 0) {
        offset = build_forward_new_lines(out_log.clone(), offset);
        vyx_bootstrap_sleep_ms(120);
    }
    offset = build_forward_new_lines(out_log.clone(), offset);
    g_build_stream_offset = offset;
    let rc = vyx_bootstrap_process_wait(pid);
    vyx_bootstrap_process_close(pid);
    return rc;
}

fn build_execute_task(task_line: string, step_total: i64) -> i32 {
    let step = build_field(task_line.clone(), 0);
    let src = build_field(task_line.clone(), 1);
    let obj = build_field(task_line.clone(), 2);
    let cmd = build_field(task_line, 3);
    if (build_env_value("VYX_DEBUG_LINK").len > 0) {
        build_log("[boot-cmd] " + cmd);
    }
    deleteFile(build_task_tmp_output(obj.clone()));
    let start_ms = vyx_bootstrap_now_ms();
    let err_log = obj.clone() + ".compile.err.log";
    let out_log = obj.clone() + ".compile.out.log";
    let rc = build_run_process_streaming(cmd, out_log.clone(), err_log.clone());
    let now = vyx_bootstrap_now_ms();
    let elapsed_ms = now - start_ms;
    if (build_profile_enabled()) {
        build_log("[build-prof] compile-job " + src + ": " + elapsed_ms.toString() + " ms");
    }
    if (rc != 0) {
        build_log(build_error_label() + ": compile failed: " + src + " (exit " + rc.toString() + ")");
        build_log("command: " + cmd);
        if (fileExists(err_log.clone())) {
            let err_text = readFile(err_log.clone());
            if (err_text.trim().len > 0) { build_log(err_text); }
        }
        // Whatever the stream loop already printed stays printed; only the
        // tail (a partial line, or output past the streaming guard) is left.
        if (fileExists(out_log.clone())) {
            let out_text = readFile(out_log.clone());
            if (out_text.len > g_build_stream_offset as i32) {
                let rest = out_text.substring(g_build_stream_offset as i32, out_text.len);
                if (rest.trim().len > 0) { build_log(rest); }
            }
        }
        return 1;
    }
    if (!build_finalize_task_output(obj.clone())) {
        build_log(build_error_label() + ": compile output finalize failed: " + obj);
        return 1;
    }
    build_log(build_progress_label(step, step_total) + " " + build_status_compile()
              + " " + build_path_label(src) + " -> " + build_path_label(obj));
    build_record_task_time(obj, elapsed_ms);
    return 0;
}

fn build_job_dir() -> string {
    return build_join_path(".cache", ".vyx_jobs");
}

fn build_job_path(job_dir: string, step: string, ext: string) -> string {
    return build_join_path(job_dir, "job_" + step + ext);
}

fn build_task_time_path() -> string {
    build_make_dir(".cache");
    return build_join_path(".cache", "build_task_times.tsv");
}

fn build_task_progress_message(step: string, step_total: i64, src: string, obj: string) -> string {
    return build_progress_label(step, step_total) + " " + build_status_compile()
           + " " + build_path_label(src) + " -> " + build_path_label(obj);
}

fn build_record_task_time(obj: string, elapsed_ms: i64) {
    if (obj.len == 0 || elapsed_ms <= 0) { return; }
    appendFile(build_task_time_path(), obj + "\t" + elapsed_ms.toString() + "\n");
}

fn build_task_source_bytes(sources: string) -> i64 {
    var total: i64 = 0;
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= sources.len) {
        if (pos == sources.len || sources.charAt(pos) == 10) {
            if (pos > start) {
                let size = fileSize(build_expand_env(sources.substring(start, pos)));
                if (size > 0 && total <= 9223372036854775807 - size) { total = total + size; }
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    return total;
}

fn build_action_memory_estimate(output: string, key: string, input_bytes: i64, codegen: bool) -> i64 {
    let path = output + ".vyx-cost";
    if (!build_env_enabled("VYX_BUILD_NO_COST_HISTORY") && fileExists(path)) {
        // Advisory history never validates object-cache correctness. A complete
        // command/tool/size key is required; hashes alone are not identity.
        let size = fileSize(path);
        if (size >= key.len && size <= key.len + 128) {
            let saved = readFile(path);
            if (saved.startsWith(key)) {
                let row = saved.substring(key.len, saved.len);
                let measured = build_resource_measured_estimate(
                    build_parse_i64(build_field(row, 0)), build_parse_i64(build_field(row, 1)));
                if (measured > 0) { return measured; }
            }
        }
    }
    return build_resource_cold_estimate(input_bytes, codegen);
}

fn build_record_action_cost(action: *BuildAction) {
    if (action[0].cost_key.len == 0 || build_env_enabled("VYX_BUILD_NO_COST_HISTORY")) { return; }
    if (build_resource_measured_estimate(action[0].peak_resident_bytes,
                                         action[0].peak_private_bytes) <= 0) { return; }
    let path = action[0].output + ".vyx-cost";
    let tmp = build_task_tmp_output(path);
    let row = action[0].cost_key + action[0].peak_resident_bytes.toString() + "\t"
              + action[0].peak_private_bytes.toString();
    if (writeFile(tmp, row) != 0 || !build_finalize_task_output(path)) {
        // Telemetry persistence is optional, unlike object publication.
        build_log("warning: could not publish action cost history: " + path);
    }
}

fn build_scheduler_log(message: string) {
    let row = "[build-sched] " + message;
    build_trace(row);
    if (build_profile_enabled()) { build_log(row); }
}

fn build_vyx_obj_slot_limit() -> i64 {
    let configured = build_parse_i64(build_env_value("VYX_BUILD_VYX_SLOTS"));
    if (configured > 0) { return configured; }
    var slots: i64 = vyx_bootstrap_hw_threads() as i64;
    if (slots < 1) { slots = 1; }
    return slots;
}

fn build_is_vyx_codegen_pair(src: string, obj: string) -> bool {
    let clean_src = src.trim();
    let clean_obj = obj.trim();
    if (clean_src.len < 4) { return false; }
    if (!clean_src.endsWith(".vyx")) { return false; }
    if (clean_obj.endsWith(".vyi")) { return false; }
    return true;
}

fn build_task_is_vyx_codegen(task_line: string) -> bool {
    return build_is_vyx_codegen_pair(build_field(task_line.clone(), 1),
                                     build_field(task_line.clone(), 2));
}

fn build_peer_vyi_interface_unit_count(sources: string) -> i64 {
    var out: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let group_key = build_source_group_key(src.clone());
            let group_sources = build_sources_for_group(sources, group_key);
            if (build_line_count(group_sources) > 1) { out = out + 1; }
        }
        i = i + 1;
    }
    return out;
}

fn build_source_lines_without(sources: string, omitted: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_line_at(sources.clone(), i);
        if (src.len > 0 && !build_same_path_loose(src.clone(), omitted.clone())) {
            out = build_append_unique_line(out.clone(), src);
        }
        i = i + 1;
    }
    return out;
}

fn build_peer_vyi_path(interface_root: string, src: string) -> string {
    let peer_root = build_join_path(interface_root, ".peers");
    return build_join_path(peer_root, build_safe_obj_name(src, ".vyi"));
}

fn build_file_vyi_path(interface_root: string, src: string) -> string {
    return build_join_path(build_join_path(interface_root, ".files"),
                           build_safe_obj_name(src, ".vyi"));
}

fn build_sibling_file_vyi_paths(interface_root: string, group_sources: string, src: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let peer = build_line_at(group_sources.clone(), i);
        if (peer.len > 0 && !build_same_path_loose(peer.clone(), src.clone())) {
            out = out + build_file_vyi_path(interface_root.clone(), peer) + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn build_sibling_file_vyi_stamp(interface_root: string, group_sources: string, src: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let peer = build_line_at(group_sources.clone(), i);
        if (peer.len > 0 && !build_same_path_loose(peer.clone(), src.clone())) {
            let vyi = build_file_vyi_path(interface_root.clone(), peer);
            out = out + "peer_vyi=" + vyi + "=" + build_file_content_stamp(vyi) + ";";
        }
        i = i + 1;
    }
    return out;
}

fn build_peer_vyi_sources_path(cache_dir: string, src: string) -> string {
    return build_join_path(cache_dir, build_safe_obj_name("peer_sources:" + src, ".sources"));
}

fn build_peer_vyi_unit_path(cache_dir: string, src: string) -> string {
    return build_join_path(cache_dir, build_safe_obj_name("peer_unit:" + src, ".sources"));
}

fn build_has_multi_source_vyx_group(sources: string) -> bool {
    var seen: string = "";
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let key = build_source_group_key(src);
            if (build_group_key_seen(seen.clone(), key.clone())) { return true; }
            seen = seen + key + "\n";
        }
        i = i + 1;
    }
    return false;
}

fn build_task_priority(task_line: string) -> i64 {
    let src = build_field(task_line, 1).trim();
    // Cold scheduling uses input size, never a compiler-source filename or
    // chunk ordinal. This is a cost estimate, not a semantic root rule.
    return fileSize(src);
}

fn build_apply_task_times(actions: &mut Vec<BuildAction>) {
    if (actions.len == 0 || !build_env_enabled("VYX_BUILD_USE_TASK_TIMES")) { return; }
    let path = build_task_time_path();
    if (!fileExists(path)) { return; }
    // One read and one sequential history scan per batch. Previously every
    // candidate re-read history, cloned the entire text for every row, and
    // searched each row from the start: a 209 KB history could copy 921 MB
    // just to look up one action. Hashes select slots; exact output bytes
    // decide identity, including collisions. Later valid rows supersede old.
    let capacity = actions.len * 2 + 1;
    var slots = Vec::<i64>.with_capacity(capacity);
    var index: i64 = 0;
    while (index < capacity) { slots.push(-1); index = index + 1; }
    index = 0;
    while (index < actions.len) {
        let a = actions.get_ptr(index);
        var slot = build_hash_text(a[0].output) % capacity;
        while (slots.get(slot) >= 0) { slot = (slot + 1) % capacity; }
        slots.set(slot, index);
        index = index + 1;
    }
    let history = readFile(path);
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= history.len) {
        if (pos == history.len || history.charAt(pos) == 10) {
            if (pos > start) {
                let row = history.substring(start, pos);
                let output = build_field(row, 0);
                let ms = build_parse_i64(build_field(row, 1).trim());
                if (ms > 0 && ms <= 9223372036854775) {
                    var slot = build_hash_text(output) % capacity;
                    var candidate = slots.get(slot);
                    while (candidate >= 0) {
                        var a = actions.get_ptr(candidate);
                        if (a[0].output == output) { a[0].priority = ms * 1000; break; }
                        slot = (slot + 1) % capacity;
                        candidate = slots.get(slot);
                    }
                }
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    slots.destroy();
}

// The planner currently supplies a batch whose dependency prerequisites have
// completed. Parse its transport rows exactly once. BuildAction state is the
// execution source of truth; log files are output, never completion signals.
fn build_parse_actions(tasks: string, task_count: i64) -> Vec<BuildAction> {
    var actions = Vec::<BuildAction>.with_capacity(task_count);
    let compiler_identity = build_compiler_stamp(getArg(0), "");
    var start: i32 = 0;
    var pos: i32 = 0;
    while (pos <= tasks.len) {
        if (pos == tasks.len || tasks.charAt(pos) == 10) {
            if (pos > start) {
                let row = tasks.substring(start, pos);
                var action: BuildAction;
                action.step = build_field(row, 0);
                action.source = build_field(row, 1);
                action.output = build_field(row, 2);
                action.command = build_field(row, 3);
                action.log_path = "";
                action.state = build_action_ready();
                action.is_vyx = build_task_is_vyx_codegen(row);
                action.priority = build_task_priority(row);
                var input_bytes = build_parse_i64(build_field(row, 4));
                if (input_bytes <= 0) { input_bytes = fileSize(action.source); }
                action.cost_key = "vyx-action-cost-v1\n" + compiler_identity + "\n"
                    + input_bytes.toString() + "\n" + action.command + "\n";
                action.memory_bytes = build_action_memory_estimate(action.output, action.cost_key,
                                                                   input_bytes, action.is_vyx);
                action.process_id = 0;
                action.started_ms = 0;
                action.elapsed_ms = 0;
                action.peak_resident_bytes = -1;
                action.peak_private_bytes = -1;
                action.cpu_time_us = -1;
                action.exit_code = -1;
                actions.push(action);
            }
            start = pos + 1;
        }
        pos = pos + 1;
    }
    return actions;
}

fn build_action_launch_order(actions: &mut Vec<BuildAction>) -> Vec<i64> {
    let count = actions.len;
    var order = Vec::<i64>.with_capacity(count);
    var scratch = Vec::<i64>.with_capacity(count);
    var i: i64 = 0;
    while (i < count) { order.push(i); scratch.push(0); i = i + 1; }
    if (!build_env_enabled("VYX_BUILD_NO_TASK_PRIORITIZE")) {
        build_apply_task_times(actions);
        var width: i64 = 1;
        while (width < count) {
            var first: i64 = 0;
            while (first < count) {
                var middle = first + width;
                if (middle > count) { middle = count; }
                var end = middle + width;
                if (end > count) { end = count; }
                var left = first;
                var right = middle;
                var dst = first;
                while (dst < end) {
                    var take_left = right >= end;
                    if (left < middle && right < end) {
                        let a = actions.get_ptr(order.get(left));
                        let b = actions.get_ptr(order.get(right));
                        take_left = a[0].priority >= b[0].priority;
                    }
                    if (take_left) { scratch.set(dst, order.get(left)); left = left + 1; }
                    else { scratch.set(dst, order.get(right)); right = right + 1; }
                    dst = dst + 1;
                }
                first = end;
            }
            let old = order;
            order = scratch;
            scratch = old;
            width = width * 2;
        }
    }
    scratch.destroy();
    return order;
}

fn build_start_action(action: *BuildAction, job_dir: string) -> bool {
    action[0].log_path = build_job_path(job_dir, action[0].step, ".log");
    deleteFile(action[0].log_path);
    deleteFile(build_task_tmp_output(action[0].output));
    if (build_env_value("VYX_DEBUG_LINK").len > 0) {
        build_log("[boot-cmd] " + action[0].command);
    }
    let empty = "";
    var env_name = "";
    var env_value = "";
    if (action[0].is_vyx) {
        // Each running process consumes one CPU token. Its LLVM emitter runs
        // on that same thread. This applies to -j1 as well as -j20; no nested
        // scheduler may independently claim the full machine here.
        env_name = "VYX_CGU_EMIT_THREADS";
        env_value = "0";
    }
    action[0].started_ms = vyx_bootstrap_now_ms();
    action[0].process_id = vyx_bootstrap_process_spawn(action[0].command.c_str(),
        empty.c_str(), action[0].log_path.c_str(), action[0].log_path.c_str(),
        env_name.c_str(), env_value.c_str());
    if (action[0].process_id <= 0) {
        action[0].state = build_action_failed();
        build_log(build_error_label() + ": failed to start compile job: " + action[0].source);
        return false;
    }
    action[0].state = build_action_running();
    return true;
}

fn build_complete_action(action: *BuildAction) -> bool {
    let id = action[0].process_id;
    action[0].elapsed_ms = vyx_bootstrap_now_ms() - action[0].started_ms;
    action[0].exit_code = vyx_bootstrap_process_exit_code(id);
    if (action[0].exit_code != 0 && vyx_bootstrap_process_cancel(id) != 0) {
        build_log(build_error_label() + ": failed to cancel failed compile job " + id.toString());
    }
    action[0].peak_resident_bytes = vyx_bootstrap_process_peak_resident_bytes(id);
    action[0].peak_private_bytes = vyx_bootstrap_process_tree_peak_private_bytes(id);
    action[0].cpu_time_us = vyx_bootstrap_process_tree_cpu_time_us(id);
    vyx_bootstrap_process_close(id);
    action[0].process_id = 0;
    build_scheduler_log("done step=" + action[0].step
        + " worker_id=" + id.toString() + " exit=" + action[0].exit_code.toString()
        + " wall_ms=" + action[0].elapsed_ms.toString()
        + " peak_resident_bytes=" + action[0].peak_resident_bytes.toString()
        + " tree_peak_private_bytes=" + action[0].peak_private_bytes.toString()
        + " tree_cpu_time_us=" + action[0].cpu_time_us.toString());
    if (build_profile_enabled()) {
        build_log("[build-prof] compile-job " + action[0].source + ": "
                  + action[0].elapsed_ms.toString() + " ms");
    }
    if (action[0].exit_code != 0) {
        action[0].state = build_action_failed();
        build_log(build_error_label() + ": compile failed: " + action[0].source
                  + " (exit " + action[0].exit_code.toString() + ")");
        let child_log = readFile(action[0].log_path);
        if (child_log.len > 0) { build_log(child_log); }
        return false;
    }
    if (!build_finalize_task_output(action[0].output)) {
        action[0].state = build_action_failed();
        build_log(build_error_label() + ": compile output finalize failed: " + action[0].output);
        return false;
    }
    build_record_action_cost(action);
    build_record_task_time(action[0].output, action[0].elapsed_ms);
    action[0].state = build_action_succeeded();
    return true;
}

fn build_cancel_actions(actions: &mut Vec<BuildAction>, active: &mut Vec<i64>) {
    var i: i64 = 0;
    while (i < active.len) {
        var action = actions.get_ptr(active.get(i));
        let id = action[0].process_id;
        if (id > 0) {
            if (vyx_bootstrap_process_cancel(id) != 0) {
                build_log(build_error_label() + ": failed to cancel compile job " + id.toString());
            }
            vyx_bootstrap_process_close(id);
            action[0].process_id = 0;
            action[0].state = build_action_cancelled();
        }
        i = i + 1;
    }
    active.clear();
}

fn build_run_action_batch(actions: &mut Vec<BuildAction>, jobs: i32, step_total: i64) -> i32 {
    if (actions.len == 0) { return 0; }
    let job_dir = build_job_dir();
    if (fileExists(job_dir) && !isDir(job_dir)) { deleteFile(job_dir); }
    build_make_dir(job_dir);
    // The operands must be i64 before multiplication: an i32 literal fold
    // wrapped 3 GiB to -1 GiB and silently over-admitted 4 GiB of workers.
    var reserve_bytes: i64 = (3 as i64) * (1073741824 as i64);
    let setting = build_env_value("VYX_BUILD_MEMORY_RESERVE_MB");
    if (setting.len > 0) {
        let mb = build_parse_i64(setting);
        if (mb <= 0 || mb > 1048576) {
            build_log(build_error_label() + ": VYX_BUILD_MEMORY_RESERVE_MB must be between 1 and 1048576");
            return 1;
        }
        reserve_bytes = mb * 1048576;
    }
    let manual_slots = build_parse_i64(build_env_value("VYX_BUILD_MEMORY_SLOTS"));
    if (manual_slots < 0 || manual_slots > 1048576) {
        build_log(build_error_label() + ": VYX_BUILD_MEMORY_SLOTS must be between 0 and 1048576");
        return 1;
    }
    let configured_bytes = manual_slots * 1073741824;
    let vyx_slots = build_vyx_obj_slot_limit();
    var limit = jobs as i64;
    if (limit < 1) { limit = 1; }
    if (limit > actions.len) { limit = actions.len; }
    var order = build_action_launch_order(actions);
    var active = Vec::<i64>.with_capacity(limit);
    var pending = actions.len;
    var flush_index: i64 = 0;
    var poll_count: i64 = 0;
    var result: i32 = 0;
    build_scheduler_log("start tasks=" + actions.len.toString() + " jobs=" + limit.toString()
        + " reserve_bytes=" + reserve_bytes.toString() + " child_emit_threads=0 representation=typed");
    while (pending > 0 || active.len > 0) {
        // Only live IDs are polled. Removing one uses swap-with-last; no
        // command strings, completion files or serialized active lists grow
        // in the polling loop. Ordered user progress uses in-memory state.
        var pos: i64 = 0;
        while (pos < active.len) {
            let a = actions.get_ptr(active.get(pos));
            let id = a[0].process_id;
            var still_running = vyx_bootstrap_process_is_running(id) != 0;
            // Successful launcher exit is not process-tree completion. Keep
            // tokens while descendants run; failed launchers cancel the tree
            // immediately in build_complete_action. -1 means direct-only on
            // a platform with no process-tree observation API.
            if (!still_running && vyx_bootstrap_process_exit_code(id) == 0) {
                still_running = vyx_bootstrap_process_tree_active_count(id) > 0;
            }
            if (still_running) {
                pos = pos + 1;
            } else {
                if (!build_complete_action(a)) { result = 1; break; }
                let last = active.pop();
                if (pos < active.len) { active.set(pos, last); }
            }
        }
        if (result != 0) { break; }
        while (flush_index < actions.len) {
            let a = actions.get_ptr(flush_index);
            if (a[0].state != build_action_succeeded()) { break; }
            build_log(build_task_progress_message(a[0].step, step_total, a[0].source, a[0].output));
            flush_index = flush_index + 1;
        }
        var reserved: i64 = 0;
        var physical_credit: i64 = 0;
        var commit_credit: i64 = 0;
        var active_vyx: i64 = 0;
        pos = 0;
        while (pos < active.len) {
            var a = actions.get_ptr(active.get(pos));
            let resident = vyx_bootstrap_process_resident_bytes(a[0].process_id);
            let private_bytes = vyx_bootstrap_process_tree_private_bytes(a[0].process_id);
            let observed = build_resource_measured_estimate(resident, private_bytes);
            if (observed > a[0].memory_bytes) { a[0].memory_bytes = observed; }
            reserved = reserved + a[0].memory_bytes;
            physical_credit = physical_credit + build_resource_credit(resident, a[0].memory_bytes);
            commit_credit = commit_credit + build_resource_credit(private_bytes, a[0].memory_bytes);
            if (a[0].is_vyx) { active_vyx = active_vyx + 1; }
            pos = pos + 1;
        }
        let physical_free = vyx_rt_system_available_physical_bytes();
        let commit_free = vyx_rt_system_available_commit_bytes();
        let memory_limit = build_resource_limit(
            build_resource_headroom(physical_free, physical_credit, reserve_bytes),
            build_resource_headroom(commit_free, commit_credit, reserve_bytes), configured_bytes);
        if (pending > 0 && active.len == 0 && memory_limit <= 0) {
            build_log(build_error_label() + ": insufficient or unknown build memory headroom"
                + " (physical=" + physical_free.toString() + ", commit=" + commit_free.toString() + ")");
            result = 1;
            break;
        }
        var launched = false;
        pos = 0;
        while (pos < order.len && active.len < limit) {
            let index = order.get(pos);
            let a = actions.get_ptr(index);
            pos = pos + 1;
            if (a[0].state != build_action_ready()) { continue; }
            if (a[0].is_vyx && active_vyx >= vyx_slots) { continue; }
            let fits = build_resource_fits(reserved, a[0].memory_bytes, memory_limit);
            // An estimate is not a hard cap. Preserve progress for a single
            // oversized task, report it explicitly, and never co-schedule it.
            if (!fits && active.len > 0) { continue; }
            if (!build_start_action(a, job_dir)) { result = 1; break; }
            active.push(index);
            pending = pending - 1;
            reserved = reserved + a[0].memory_bytes;
            if (a[0].is_vyx) { active_vyx = active_vyx + 1; }
            launched = true;
            build_scheduler_log("launch step=" + a[0].step + " active=" + active.len.toString()
                + " reserved_bytes=" + reserved.toString() + " admission_bytes=" + memory_limit.toString()
                + " physical_available_bytes=" + physical_free.toString()
                + " commit_available_bytes=" + commit_free.toString()
                + " exclusive_estimate=" + (!fits).toString());
        }
        if (result != 0) { break; }
        poll_count = poll_count + 1;
        if ((poll_count % 20) == 0) {
            var blocked = "running";
            if (pending > 0) {
                blocked = "memory";
                if (active.len >= limit) { blocked = "jobs"; }
                elif (active_vyx >= vyx_slots) { blocked = "vyx_slots"; }
            }
            build_scheduler_log("poll active=" + active.len.toString() + " pending=" + pending.toString()
                + " reserved_bytes=" + reserved.toString() + " admission_bytes=" + memory_limit.toString()
                + " blocked=" + blocked);
        }
        if (!launched && active.len > 0) { vyx_bootstrap_sleep_ms(50); }
    }
    if (result != 0) { build_cancel_actions(actions, &mut active); }
    active.destroy();
    order.destroy();
    vyx_rt_heap_trim();
    return result;
}


fn build_run_tasks(tasks: string, task_count: i64, jobs: i32, step_total: i64) -> i32 {
    build_trace("run-tasks enter count=" + task_count.toString()
                + " jobs=" + jobs.toString()
                + " t=" + vyx_bootstrap_now_ms().toString());
    var actions = build_parse_actions(tasks, task_count);
    if (actions.len != task_count) {
        build_log(build_error_label() + ": planner task count does not match action records");
        actions.destroy();
        return 1;
    }
    var i: i64 = 0;
    while (i < actions.len) {
        let a = actions.get_ptr(i);
        if (a[0].step.len == 0 || a[0].source.len == 0 || a[0].output.len == 0 || a[0].command.len == 0) {
            build_log(build_error_label() + ": incomplete build action at index " + i.toString());
            actions.destroy();
            return 1;
        }
        i = i + 1;
    }
    let result = build_run_action_batch(&mut actions, jobs, step_total);
    actions.destroy();
    return result;
}

fn build_opt_and_link_passthrough() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if ((a == "--target" || a == "-target" || a == "--triplet") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("-target=")
                   || a.startsWith("--triplet=")) {
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            out = out + " " + a + " " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = out + " --target-cpu " + build_quote(getArg(i + 1).trim());
            i = i + 2;
        } else if (a.startsWith("--target-cpu=") || a.startsWith("--mcpu=")) {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "--mir-opt" || a == "--llvm-opt") && i + 1 < argc) {
            out = out + " " + a + " " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3"
                   || a == "-Os" || a == "-Oz" || a == "-g"
                   || a == "--debug" || a == "--coverage") {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "-L" || a == "--lib-path" || a == "-l" || a == "--link")
                   && i + 1 < argc) {
            out = out + " " + a + " " + build_quote(getArg(i + 1));
            i = i + 2;
        } else if ((a.startsWith("-L") || a.startsWith("-l")) && a.len > 2) {
            out = out + " " + a;
            i = i + 1;
        } else if ((a == "-j" || a == "--jobs") && i + 1 < argc) {
            i = i + 2;
        } else if (a.startsWith("-j") && a.len > 2) {
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    let target_triple = policy_cli_target_triple();
    if (target_triple.len > 0) {
        out = out + " --target " + build_quote(target_triple);
    }
    return out;
}

fn build_cli_uses_new_mir_codegen() -> bool {
    return true;
}

fn build_cli_jobs(default_jobs: i32) -> i32 {
    var jobs = default_jobs;
    let argc = argCount();
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if ((a == "-j" || a == "--jobs") && i + 1 < argc) {
            jobs = build_parse_int(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("-j") && a.len > 2) {
            jobs = build_parse_int(a.substring(2, a.len));
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    if (jobs < 1) { jobs = 1; }
    return jobs;
}

fn build_manifest_cli_quoted(value: string, prefix: string) -> string {
    var out: string = "";
    let rows = toml_array_to_lines(value);
    var i: i64 = 0;
    let n = build_line_count(rows);
    while (i < n) {
        var item = build_expand_env(build_line_at(rows, i)).trim();
        if (item.len == 0 || item.contains("\${")) {
            i = i + 1;
            continue;
        }
        if (prefix == "-L" || prefix == "-I") {
            out = out + " " + prefix + " " + build_quote(item);
        } else if (prefix == "-l" && build_effective_is_windows()
                   && (item.endsWith(".lib") || item.endsWith(".LIB"))) {
            // A Windows import/archive filename is a library name, not a
            // positional compiler input.  Preserve its exact stem for lld-link.
            if (item.contains("/") || item.contains("\\")) {
                out = out + " -L " + build_quote(build_dirname(item.clone()));
            }
            out = out + " -l " + build_path_stem(item);
        } else if (prefix == "-l" && build_is_direct_link_input(item.clone())) {
            out = out + " " + build_quote(item);
        } else {
            if (prefix == "-l") {
                item = build_normalize_link_lib_name(item);
            }
            out = out + " " + prefix + " " + item;
        }
        i = i + 1;
    }
    return out;
}

fn build_is_direct_link_input(item: string) -> bool {
    if (item.len == 0) { return false; }
    if (item.contains("/") || item.contains("\\")) { return true; }
    return item.endsWith(".lib") || item.endsWith(".a")
        || item.endsWith(".so") || item.endsWith(".dylib");
}

fn build_normalize_link_lib_name(item: string) -> string {
    var name = item.trim();
    if (name.len == 0) { return name; }
    name = build_path_stem(name);
    if (!build_effective_is_windows()) {
        while (name.startsWith("lib") && name.len > 3) {
            name = name.substring(3, name.len);
        }
    }
    while (true) {
        if (name.endsWith(".dll")) {
            name = name.substring(0, name.len - 4);
            continue;
        }
        if (name.endsWith(".lib")) {
            name = name.substring(0, name.len - 4);
            continue;
        }
        if (name.endsWith(".a")) {
            name = name.substring(0, name.len - 2);
            continue;
        }
        if (name.endsWith(".so")) {
            name = name.substring(0, name.len - 3);
            continue;
        }
        if (name.endsWith(".dylib")) {
            name = name.substring(0, name.len - 6);
            continue;
        }
        break;
    }
    return name;
}

fn build_manifest_cli_passthrough(value: string) -> string {
    var out: string = "";
    let rows = toml_array_to_lines(value);
    var i: i64 = 0;
    let n = build_line_count(rows);
    while (i < n) {
        let item = build_line_at(rows, i);
        if (item.len > 0) {
            out = out + " " + item;
        }
        i = i + 1;
    }
    return out;
}

fn build_has_lib(value: string, lib: string) -> bool {
    let rows = toml_array_to_lines(value);
    var i: i64 = 0;
    let n = build_line_count(rows);
    while (i < n) {
        if (build_line_at(rows, i) == lib) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_has_shared_runtime_lib(value: string) -> bool {
    return build_has_lib(value.clone(), "vyx_compiler_backend")
        || build_has_lib(value.clone(), "vyx_rt")
        || build_has_lib(value, "vyx_run_rt");
}

fn build_append_toml_array_item(value: string, item: string) -> string {
    if (item.len == 0 || build_has_lib(value.clone(), item.clone())) { return value; }
    let trimmed = value.trim();
    if (trimmed.len == 0 || trimmed == "[]") {
        return "[\"" + item + "\"]";
    }
    if (trimmed.endsWith("]")) {
        let inner = trimmed.substring(0, trimmed.len - 1).trim();
        if (inner == "[") {
            return "[\"" + item + "\"]";
        }
        return inner + ", \"" + item + "\"]";
    }
    return value;
}

fn build_source_uses_std_module(path: string, module_name: string) -> bool {
    if (!fileExists(path.clone())) { return false; }
    let text = readFile(path.clone());
    if (build_contains(text.clone(), "use " + module_name)) { return true; }
    if (build_contains(text.clone(), "import " + module_name)) { return true; }
    if (build_contains(text.clone(), "use " + module_name.replace(".", "::"))) { return true; }
    if (build_contains(text.clone(), "import " + module_name.replace(".", "::"))) { return true; }
    return false;
}

fn build_sources_use_std_module(sources: string, module_name: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_line_at(sources.clone(), i);
        if (src.endsWith(".vyx") && build_source_uses_std_module(src.clone(), module_name.clone())) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn build_apply_std_auto_libs(libs: string, sources: string) -> string {
    var out = libs;
    if (build_sources_use_std_module(sources.clone(), "std.math")) {
        if (!build_effective_is_windows()) {
            out = build_append_toml_array_item(out.clone(), "m");
        }
    }
    if (build_sources_use_std_module(sources.clone(), "std.vio")) {
        if (build_effective_is_windows()) {
            out = build_append_toml_array_item(out.clone(), "ws2_32");
        } else if (build_effective_is_linux()) {
            out = build_append_toml_array_item(out.clone(), "pthread");
        }
    }
    if (build_sources_use_std_module(sources.clone(), "std.threading")
        || build_sources_use_std_module(sources.clone(), "std.sync")) {
        if (build_effective_is_windows()) {
            out = build_append_toml_array_item(out.clone(), "synchronization");
        } else if (build_effective_is_linux()) {
            out = build_append_toml_array_item(out.clone(), "pthread");
        }
    }
    if (build_sources_use_std_module(sources.clone(), "std.thread_pool")
        || build_sources_use_std_module(sources.clone(), "std.sync.thread_pool")) {
        if (build_effective_is_windows()) {
            out = build_append_toml_array_item(out.clone(), "tbb12");
        } else {
            out = build_append_toml_array_item(out.clone(), "pthread");
            out = build_append_toml_array_item(out.clone(), "tbb");
        }
    }
    return out;
}

fn build_path_has_cxx_ext(path: string) -> bool {
    return path.endsWith(".cpp") || path.endsWith(".cc") || path.endsWith(".cxx")
        || path.endsWith(".CPP") || path.endsWith(".CC") || path.endsWith(".CXX")
        || path.endsWith(".c++");
}

fn build_sources_have_cxx(sources: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(sources);
    while (i < n) {
        if (build_path_has_cxx_ext(build_line_at(sources, i))) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_libs_name_libcxx(libs: string) -> bool {
    return build_has_lib(libs.clone(), "c++_shared")
        || build_has_lib(libs.clone(), "c++_static")
        || build_has_lib(libs.clone(), "c++")
        || build_has_lib(libs, "stdc++");
}

/// Android clang++ always pulls libc++_shared. Vyx-only programs do not need it;
/// opt in with libs = ["c++_shared"] / ["c++_static"], C++ sources, DCI C++ stubs,
/// or VYX_ANDROID_LIBCXX=shared|static.
fn build_android_libcxx_opt_in(libs: string, sources: string, has_cxx_stubs: bool) -> string {
    if (!build_effective_is_android()) { return ""; }
    if (build_libs_name_libcxx(libs.clone())) { return ""; }
    let mode = build_env_value("VYX_ANDROID_LIBCXX").trim();
    if (mode == "none" || mode == "0" || mode == "off") { return ""; }
    if (mode == "static") { return "c++_static"; }
    if (mode == "shared" || mode == "1" || mode == "true") { return "c++_shared"; }
    if (has_cxx_stubs || build_sources_have_cxx(sources)) { return "c++_shared"; }
    return "";
}

fn build_has_named_runtime_lib(dir: string, name: string) -> bool {
    if (dir.len == 0) { return false; }
    if (build_effective_is_windows()) {
        let has_dll = fileExists(build_join_path(dir.clone(), name.clone() + ".dll"));
        let has_import_lib = fileExists(build_join_path(dir.clone(), name.clone() + ".lib"))
                             || fileExists(build_join_path(dir.clone(), "lib" + name.clone() + ".dll.a"));
        return has_dll && has_import_lib;
    }
    if (fileExists(build_join_path(dir.clone(), name.clone() + ".so"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), name.clone() + ".dylib"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), "lib" + name.clone() + ".so"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), "lib" + name.clone() + ".dylib"))) { return true; }
    return false;
}

fn build_has_named_static_runtime_lib(dir: string, name: string) -> bool {
    if (dir.len == 0) { return false; }
    if (build_effective_is_windows()) {
        return fileExists(build_join_path(dir.clone(), name.clone() + ".lib"));
    }
    if (fileExists(build_join_path(dir.clone(), "lib" + name.clone() + ".a"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), name.clone() + ".a"))) { return true; }
    return false;
}

fn build_has_runtime_lib(dir: string) -> bool {
    return build_has_named_static_runtime_lib(dir.clone(), "vyx_runtime")
        || build_has_named_static_runtime_lib(dir.clone(), "vyx_run_rt_static")
        || build_has_named_runtime_lib(dir.clone(), "vyx_run_rt")
        || build_has_named_runtime_lib(dir.clone(), "vyx_rt");
}

fn build_runtime_link_name(dir: string) -> string {
    if (build_has_named_static_runtime_lib(dir.clone(), "vyx_runtime")) { return "vyx_runtime"; }
    if (build_has_named_static_runtime_lib(dir.clone(), "vyx_run_rt_static")) { return "vyx_run_rt_static"; }
    if (build_has_named_runtime_lib(dir.clone(), "vyx_run_rt")) { return "vyx_run_rt"; }
    return "vyx_rt";
}

fn build_runtime_is_static(dir: string) -> bool {
    return build_has_named_static_runtime_lib(dir.clone(), build_runtime_link_name(dir));
}

fn build_exe_dir() -> string {
    if (argCount() > 0) {
        let arg0 = getArg(0);
        let direct = build_dirname(arg0.clone());
        if (direct != ".") { return direct; }
        let resolved = build_find_tool_on_path(arg0);
        if (resolved.len > 0) { return build_dirname(resolved); }
        return direct;
    }
    return ".";
}

// LLVM fills a missing vendor with "unknown", while its host triple commonly
// uses "pc". These two spellings select the same runtime only when every
// other triple component is identical. Keep all other vendor differences and
// every OS/environment difference on the cross-runtime path.
fn build_host_runtime_vendor_alias_key(triple: string) -> string {
    let arch_end = triple.indexOf("-");
    if (arch_end < 0) { return ""; }
    let after_arch = triple.substring(arch_end + 1, triple.len);
    let vendor_end = after_arch.indexOf("-");
    if (vendor_end < 0) { return ""; }
    let vendor = after_arch.substring(0, vendor_end);
    if (vendor != "pc" && vendor != "unknown") { return ""; }
    return triple.substring(0, arch_end) + after_arch.substring(vendor_end, after_arch.len);
}

fn build_cross_triplet_requested() -> bool {
    if (policy_cli_requested_triplet().len == 0) { return false; }
    let target = policy_cli_target_triple();
    let host = policy_host_target_triple();
    if (target.len == 0 || host.len == 0 || target == host) { return false; }
    let target_alias = build_host_runtime_vendor_alias_key(target);
    let host_alias = build_host_runtime_vendor_alias_key(host);
    return target_alias.len == 0 || host_alias.len == 0 || target_alias != host_alias;
}

fn build_runtime_triplet_relative_dir() -> string {
    var out = "runtimes";
    let triple = policy_effective_target_triple();
    let platform = policy_target_platform_name(triple.clone());
    let arch = policy_target_arch_name(triple.clone());
    let compiler = policy_target_compiler_name(triple.clone());
    if (platform.len == 0 || arch.len == 0) {
        return build_join_path(out, triple);
    }
    out = build_join_path(out, platform);
    out = build_join_path(out, arch);
    if (compiler.len > 0) { out = build_join_path(out, compiler); }
    return out;
}

fn build_runtime_triplet_output_dir(base: string) -> string {
    return build_join_path(base, build_runtime_triplet_relative_dir());
}

fn build_runtime_triplet_candidate(root: string, allow_direct: bool) -> string {
    if (root.len == 0) { return ""; }
    let nested = build_runtime_triplet_output_dir(root);
    if (build_has_runtime_lib(nested.clone())) { return nested; }
    if (allow_direct && build_has_runtime_lib(root.clone())) { return root; }
    return "";
}

fn build_std_package_candidate(root: string, package_name: string) -> string {
    if (root.len == 0 || package_name.len == 0) { return ""; }
    let path = build_join_path(root, package_name);
    if (fileExists(build_join_path(path.clone(), "Vyx.toml"))) { return path; }
    return "";
}

/// Resolve `std:<package>` without baking a source-tree path into consumer
/// manifests. Installed SDKs can set VYX_STD_PACKAGES; source and portable SDK
/// layouts are found relative to the active compiler executable.
fn build_looks_like_version(s: string) -> bool {
    if (s.len == 0) { return false; }
    if (s.contains("/") || s.contains("\\") || s.contains(":")) { return false; }
    var digits: i32 = 0;
    var i: i32 = 0;
    while (i < s.len) {
        let c = s.charAt(i);
        if (c >= 48 && c <= 57) { digits = digits + 1; }
        else if (c != 46) { return false; }
        i = i + 1;
    }
    return digits > 0;
}

fn build_resolve_registry_package(name: string, version: string) -> string {
    if (name.len == 0) { return ""; }
    var ver = version.trim();
    if (ver.len > 0) {
        let cached = build_join_path(build_join_path(build_join_path(".cache", "registry"), name), ver);
        if (fileExists(build_join_path(cached.clone(), "Vyx.toml"))) { return cached; }
    }
    var root = build_env_value("VYX_REGISTRY");
    if (root.len == 0) { root = ".vyx-registry"; }
    if (root.startsWith("file://")) { root = root.substring(7, root.len); }
    if (ver.len > 0) {
        let hit = build_join_path(build_join_path(build_join_path(root, "pkgs"), name), ver);
        if (fileExists(build_join_path(hit.clone(), "Vyx.toml"))) { return hit; }
    }
    return "";
}

fn build_resolve_dependency_path(configured_path: string) -> string {
    let path = build_expand_env(configured_path.trim());
    if (path.startsWith("registry:")) {
        let spec = path.substring(9, path.len);
        var name = spec;
        var ver: string = "";
        let at = spec.indexOf("@");
        if (at > 0) {
            name = spec.substring(0, at);
            ver = spec.substring(at + 1, spec.len);
        }
        return build_resolve_registry_package(name, ver);
    }
    if (!path.startsWith("std:")) { return path; }
    let package_name = path.substring(4, path.len).trim();
    if (package_name.len == 0 || package_name.contains("/") || package_name.contains("\\")) {
        return "";
    }
    var hit = build_std_package_candidate(build_env_value("VYX_STD_PACKAGES"), package_name.clone());
    if (hit.len > 0) { return hit; }
    let exe_dir = build_exe_dir();
    hit = build_std_package_candidate(build_join_path(exe_dir.clone(), "std_packages"), package_name.clone());
    if (hit.len > 0) { return hit; }
    let parent = build_dirname(exe_dir.clone());
    hit = build_std_package_candidate(build_join_path(parent.clone(), "std_packages"), package_name.clone());
    if (hit.len > 0) { return hit; }
    hit = build_std_package_candidate("bootstrap_compiler/std_packages", package_name);
    return hit;
}

fn build_runtime_dir() -> string {
    let exe_dir = build_exe_dir();
    if (build_cross_triplet_requested()) {
        var cross_hit = build_runtime_triplet_candidate(build_env_value("VYX_RUNTIME_ROOT"), true);
        if (cross_hit.len > 0) { return cross_hit; }
        cross_hit = build_runtime_triplet_candidate(exe_dir.clone(), false);
        if (cross_hit.len > 0) { return cross_hit; }
        let parent = build_dirname(exe_dir.clone());
        cross_hit = build_runtime_triplet_candidate(parent.clone(), false);
        if (cross_hit.len > 0) { return cross_hit; }
        cross_hit = build_runtime_triplet_candidate("bootstrap_compiler/out", false);
        if (cross_hit.len > 0) { return cross_hit; }
        cross_hit = build_runtime_triplet_candidate("../bootstrap_compiler/out", false);
        if (cross_hit.len > 0) { return cross_hit; }
        return "";
    }
    let configured = build_env_value("VYX_RUNTIME_ROOT");
    if (configured.len > 0) {
        if (build_has_runtime_lib(configured.clone())) { return configured; }
        let configured_lib = build_join_path(configured.clone(), "lib");
        if (build_has_runtime_lib(configured_lib.clone())) { return configured_lib; }
    }
    if (build_has_runtime_lib(exe_dir.clone())) { return exe_dir; }
    let local_lib = build_join_path(exe_dir.clone(), "lib");
    if (build_has_runtime_lib(local_lib.clone())) { return local_lib; }
    let local_rt = build_join_path(exe_dir.clone(), "vyx_rt");
    if (build_has_runtime_lib(local_rt.clone())) { return local_rt; }
    let parent = build_dirname(exe_dir.clone());
    let sdk_lib = build_join_path(parent.clone(), "lib");
    if (build_has_runtime_lib(sdk_lib.clone())) { return sdk_lib; }
    let p1 = build_join_path(parent.clone(), "build_yolo_vyxcg/vyx_rt");
    if (build_has_runtime_lib(p1.clone())) { return p1; }
    let p2 = build_join_path(parent.clone(), "build_vyxcg/vyx_rt");
    if (build_has_runtime_lib(p2.clone())) { return p2; }
    let p3 = build_join_path(parent.clone(), "build/vyx_rt");
    if (build_has_runtime_lib(p3.clone())) { return p3; }
    let c1 = "build_yolo_vyxcg/vyx_rt";
    if (build_has_runtime_lib(c1)) { return c1; }
    let c2 = "build_vyxcg/vyx_rt";
    if (build_has_runtime_lib(c2)) { return c2; }
    let c3 = "build/vyx_rt";
    if (build_has_runtime_lib(c3)) { return c3; }
    // Fallback: scan PATH for a directory containing vyx_rt.lib (or
    // its variants). This handles the case where boot.exe was invoked
    // through a bare basename and `argv[0]` doesn't carry the full path,
    // so `build_exe_dir()` returns just ".".
    let path_hit = build_runtime_dir_from_path();
    if (path_hit.len > 0) { return path_hit; }
    return "";
}

fn build_runtime_dir_from_path() -> string {
    var search = build_env_value("LD_LIBRARY_PATH");
    if (search.len == 0) {
        search = build_env_value("DYLD_LIBRARY_PATH");
    } else if (build_env_value("DYLD_LIBRARY_PATH").len > 0) {
        search = search + ":" + build_env_value("DYLD_LIBRARY_PATH");
    }
    let path_env = build_env_value("PATH");
    if (path_env.len > 0) {
        var sep = ":";
        if (build_is_windows()) { sep = ";"; }
        if (search.len > 0) { search = search + sep + path_env; }
        else { search = path_env; }
    }
    var start: i32 = 0;
    var i: i32 = 0;
    var sep_ch: i32 = 58;
    if (build_is_windows()) { sep_ch = 59; }
    while (i <= search.len) {
        if (i == search.len || search.charAt(i) == sep_ch) {
            var dir = search.substring(start, i).trim();
            if (dir.len > 0) {
                if (build_cross_triplet_requested()) {
                    let cross_hit = build_runtime_triplet_candidate(dir, false);
                    if (cross_hit.len > 0) { return cross_hit; }
                } else if (build_has_runtime_lib(dir.clone())) {
                    return dir;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_shared_ext() -> string {
    if (build_effective_is_windows()) { return ".dll"; }
    if (build_effective_is_apple()) { return ".dylib"; }
    return ".so";
}

fn build_static_ext() -> string {
    if (build_effective_is_windows()) { return ".lib"; }
    return ".a";
}

fn build_exe_ext() -> string {
    if (build_effective_is_windows()) { return ".exe"; }
    return "";
}

fn build_obj_ext() -> string {
    if (build_effective_is_windows()) { return ".obj"; }
    return ".o";
}

fn build_c_obj_ext() -> string {
    if (build_effective_is_windows()) { return "_c.obj"; }
    return "_c.o";
}

fn build_library_filename(name: string, ext: string) -> string {
    if (build_effective_is_windows()) { return name + ext; }
    if (name.startsWith("lib")) { return name + ext; }
    return "lib" + name + ext;
}

fn build_shared_library_filename(name: string) -> string {
    return build_library_filename(name, build_shared_ext());
}

fn build_copy_file(src: string, dst: string) -> i32 {
    return vyx_bootstrap_copy_file(src.c_str(), dst.c_str());
}

// Windows can retain a just-linked executable while the loader, antivirus,
// or indexer closes its image handle. Output aliases must still contain the
// exact primary artifact, so retry the same replacement rather than publish a
// stale alias or report success before it is usable. The bounded 15-second
// window covers observed image-handle teardown without masking a persistent
// filesystem error.
fn build_copy_file_retry(src: string, dst: string) -> i32 {
    var attempt: i32 = 0;
    while (attempt < 150) {
        if (build_copy_file(src.clone(), dst.clone()) == 0) { return 0; }
        if (!build_is_windows()) { return 1; }
        vyx_bootstrap_sleep_ms(100);
        attempt = attempt + 1;
    }
    return 1;
}

fn build_copy_runtime_library(output_path: string) {
    let rt = build_runtime_dir();
    if (rt.len == 0) { return; }
    let rt_name = build_runtime_link_name(rt.clone());
    let src = build_join_path(rt, build_shared_library_filename(rt_name.clone()));
    if (!fileExists(src)) { return; }
    let out_dir = build_dirname(output_path);
    let dst = build_join_path(out_dir, build_shared_library_filename(rt_name));
    build_copy_file(src, dst);
}

/// Copy the oneTBB companion runtime next to a freshly linked executable so
/// std.*.thread_pool consumers resolve `tbb12` / `libtbb12` at load time.
/// The import library lives beside the runtime archive in the SDK layout;
/// this mirrors it for the produced binary.
fn build_copy_tbb_runtime_library(output_path: string) {
    let rt = build_runtime_dir();
    if (rt.len == 0) { return; }
    let tbb_file = if (build_effective_is_windows()) { "tbb12.dll" }
                   else if (build_effective_is_linux()) { "libtbb.so.12" }
                   else { "" };
    if (tbb_file.len == 0) { return; }
    let tbb_src = build_join_path(rt, tbb_file.clone());
    if (!fileExists(tbb_src)) { return; }
    let out_dir = build_dirname(output_path);
    let tbb_dst = build_join_path(out_dir, tbb_file);
    build_copy_file(tbb_src, tbb_dst);
}

/// Copy each dependency's shared library into the consumer's output directory so
/// the resulting executable can find them at runtime.
fn build_copy_dep_shared_libs(deps: string, output_path: string) {
    let out_dir = build_dirname(output_path);
    let shared_ext = build_shared_ext();
    var i: i64 = 0;
    let n = build_line_count(deps);
    while (i < n) {
        let line = build_line_at(deps.clone(), i);
        let dname = build_field(line.clone(), 0);
        let dpath = build_field(line.clone(), 1);
        let target_name = build_field(line.clone(), 2);
        let target_output_dir = build_field(line.clone(), 4);
        let dependency_usage = build_field(line, 8);
        if (dname.len > 0 && dpath.len > 0
            && target_name.len > 0 && target_output_dir.len > 0
            && dependency_usage != "build") {
            let dep_out_dir = build_dep_output_path(build_expand_env(dpath.clone()),
                                                    build_expand_env(target_output_dir));
            let lib_name = build_shared_library_filename(target_name.clone());
            let lib_src = build_join_path(dep_out_dir.clone(), lib_name.clone());
            if (fileExists(lib_src.clone())) {
                let lib_dst = build_join_path(out_dir.clone(), lib_name);
                build_copy_file(lib_src, lib_dst);
            }
            let copy_rc = vyx_bootstrap_copy_files_with_ext(build_host_path(dep_out_dir).c_str(),
                                                            build_host_path(out_dir.clone()).c_str(),
                                                            shared_ext.c_str());
            if (copy_rc != 0) {
                print(build_error_label() + ": failed to copy dependency runtime libraries from " + dep_out_dir);
            }
            let asset_rc = vyx_bootstrap_copy_runtime_assets(build_host_path(dep_out_dir).c_str(),
                                                             build_host_path(out_dir.clone()).c_str());
            if (asset_rc != 0) {
                print(build_error_label() + ": failed to copy dependency runtime assets from " + dep_out_dir);
            }
            build_copy_probed_system_runtime(build_field(line.clone(), 5),
                                             build_field(line.clone(), 6),
                                             out_dir.clone(),
                                             shared_ext.clone());
        }
        i = i + 1;
    }
}

fn build_is_windows_sdk_lib(name: string) -> bool {
    if (name == "kernel32" || name == "user32" || name == "gdi32" || name == "comdlg32") { return true; }
    if (name == "ws2_32" || name == "crypt32" || name == "advapi32" || name == "shell32") { return true; }
    if (name == "ole32" || name == "oleaut32" || name == "uuid" || name == "ntdll") { return true; }
    if (name == "bcrypt" || name == "wldap32" || name == "normaliz" || name == "secur32") { return true; }
    if (name == "shlwapi" || name == "winhttp" || name == "wintrust" || name == "iphlpapi") { return true; }
    return false;
}

fn build_syslib_alias_stems(name: string) -> string {
    var out = name + "\n";
    if (name == "curl") { out = out + "libcurl\nlibcurl_imp\n"; }
    if (name == "libcurl") { out = out + "curl\nlibcurl_imp\n"; }
    if (name == "ssl") { out = out + "libssl\nlibssl-3-x64\nssleay32\n"; }
    if (name == "libssl") { out = out + "ssl\nlibssl-3-x64\nssleay32\n"; }
    if (name == "crypto") { out = out + "libcrypto\nlibcrypto-3-x64\nlibeay32\n"; }
    if (name == "libcrypto") { out = out + "crypto\nlibcrypto-3-x64\nlibeay32\n"; }
    return out;
}

fn build_syslib_is_probe_candidate(name: string) -> bool {
    return name == "curl" || name == "libcurl"
        || name == "ssl" || name == "libssl"
        || name == "crypto" || name == "libcrypto";
}

fn build_syslib_pkgconfig_name(name: string) -> string {
    if (name == "curl" || name == "libcurl") { return "libcurl"; }
    if (name == "ssl" || name == "libssl") { return "libssl"; }
    if (name == "crypto" || name == "libcrypto") { return "libcrypto"; }
    return name;
}

fn build_dir_has_link_stem(dir: string, stem: string) -> bool {
    if (dir.len == 0 || stem.len == 0) { return false; }
    if (build_effective_is_windows()) {
        if (fileExists(build_join_path(dir.clone(), stem.clone() + ".lib"))) { return true; }
        if (fileExists(build_join_path(dir.clone(), "lib" + stem.clone() + ".lib"))) { return true; }
        if (fileExists(build_join_path(dir.clone(), stem.clone() + ".dll.a"))) { return true; }
        if (fileExists(build_join_path(dir.clone(), "lib" + stem.clone() + ".dll.a"))) { return true; }
        return false;
    }
    if (fileExists(build_join_path(dir.clone(), "lib" + stem.clone() + ".so"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), "lib" + stem.clone() + ".a"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), "lib" + stem.clone() + ".dylib"))) { return true; }
    if (fileExists(build_join_path(dir.clone(), stem.clone() + ".so"))) { return true; }
    return false;
}

fn build_dir_has_named_lib(dir: string, name: string) -> bool {
    let stems = build_syslib_alias_stems(name);
    var i: i64 = 0;
    let n = build_line_count(stems.clone());
    while (i < n) {
        let stem = build_line_at(stems.clone(), i).trim();
        if (stem.len > 0 && build_dir_has_link_stem(dir.clone(), stem)) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_first_link_file_in_dir(dir: string, name: string) -> string {
    if (dir.len == 0) { return ""; }
    let stems = build_syslib_alias_stems(name);
    var i: i64 = 0;
    let n = build_line_count(stems.clone());
    while (i < n) {
        let stem = build_line_at(stems.clone(), i).trim();
        if (stem.len > 0) {
            if (build_effective_is_windows()) {
                let a = build_join_path(dir.clone(), stem.clone() + ".lib");
                if (fileExists(a.clone())) { return a; }
                let b = build_join_path(dir.clone(), "lib" + stem.clone() + ".lib");
                if (fileExists(b.clone())) { return b; }
                let c = build_join_path(dir.clone(), "lib" + stem.clone() + ".dll.a");
                if (fileExists(c.clone())) { return c; }
            } else {
                let so = build_join_path(dir.clone(), "lib" + stem.clone() + ".so");
                if (fileExists(so.clone())) { return so; }
                let dylib = build_join_path(dir.clone(), "lib" + stem.clone() + ".dylib");
                if (fileExists(dylib.clone())) { return dylib; }
                let archive = build_join_path(dir.clone(), "lib" + stem.clone() + ".a");
                if (fileExists(archive.clone())) { return archive; }
            }
        }
        i = i + 1;
    }
    return "";
}

fn build_probe_append_dir(acc: string, dir: string) -> string {
    if (dir.len == 0 || !fileExists(dir.clone())) { return acc; }
    return acc + dir + "\n";
}

fn build_syslib_env_libdir(name: string) -> string {
    if (name == "curl" || name == "libcurl") {
        let direct = build_env_value("VYX_CURL_LIB");
        if (direct.len > 0) {
            if ((direct.endsWith(".lib") || direct.endsWith(".a")
                 || direct.endsWith(".so") || direct.endsWith(".dylib"))
                && fileExists(direct.clone())) {
                return build_dirname(direct);
            }
            return direct;
        }
        var root = build_env_value("CURL_ROOT");
        if (root.len == 0) { root = build_env_value("VYX_CURL_ROOT"); }
        if (root.len > 0) { return build_join_path(root, "lib"); }
    }
    if (name == "ssl" || name == "libssl" || name == "crypto" || name == "libcrypto") {
        let direct = build_env_value("VYX_OPENSSL_LIB");
        if (direct.len > 0) {
            if ((direct.endsWith(".lib") || direct.endsWith(".a")
                 || direct.endsWith(".so") || direct.endsWith(".dylib"))
                && fileExists(direct.clone())) {
                return build_dirname(direct);
            }
            return direct;
        }
        var root = build_env_value("OPENSSL_ROOT");
        if (root.len == 0) { root = build_env_value("OPENSSL_DIR"); }
        if (root.len == 0) { root = build_env_value("VYX_OPENSSL_ROOT"); }
        if (root.len > 0) { return build_join_path(root, "lib"); }
    }
    return "";
}

fn build_pkgconfig_tool() -> string {
    var tool = build_find_tool_on_path("pkg-config");
    if (tool.len == 0) { tool = build_find_tool_on_path("pkg-config.exe"); }
    if (tool.len == 0) { tool = build_find_tool_on_path("pkgconf"); }
    if (tool.len == 0) { tool = build_find_tool_on_path("pkgconf.exe"); }
    if (tool.len == 0 && fileExists("/usr/bin/pkg-config")) { return "/usr/bin/pkg-config"; }
    return tool;
}

fn build_pkgconfig_libdir(pc_name: string) -> string {
    if (pc_name.len == 0) { return ""; }
    let tool = build_pkgconfig_tool();
    if (tool.len == 0) { return ""; }
    let out_path = build_join_path(".cache", ".vyx_pkgconfig_" + pc_name.replace("/", "_"));
    build_ensure_parent(out_path.clone());
    let cmd = build_quote_arg(tool) + " --variable=libdir " + build_quote_arg(pc_name);
    if (build_run_process(cmd, "", out_path.clone(), "") != 0) { return ""; }
    return readFile(out_path).trim();
}

fn build_vcpkg_roots() -> string {
    var out: string = "";
    out = build_probe_append_dir(out.clone(), build_env_value("VCPKG_ROOT"));
    out = build_probe_append_dir(out.clone(), build_env_value("VYX_VCPKG_ROOT"));
    let local = build_env_value("LOCALAPPDATA");
    if (local.len > 0) {
        out = build_probe_append_dir(out.clone(), build_join_path(local, "vcpkg"));
    }
    var home = build_env_value("USERPROFILE");
    if (home.len == 0) { home = build_env_value("HOME"); }
    if (home.len > 0) {
        out = build_probe_append_dir(out.clone(), build_join_path(home.clone(), "vcpkg"));
        out = build_probe_append_dir(out.clone(), build_join_path(home, "source/vcpkg"));
    }
    out = build_probe_append_dir(out.clone(), "C:/vcpkg");
    out = build_probe_append_dir(out.clone(), "D:/vcpkg");
    out = build_probe_append_dir(out.clone(), "E:/vcpkg");
    return out;
}

fn build_vcpkg_lib_dirs() -> string {
    var out: string = "";
    let roots = build_vcpkg_roots();
    let target = policy_effective_target_triple();
    let arch = policy_target_arch_name(target.clone());
    let platform = policy_target_platform_name(target.clone());
    let compiler = policy_target_compiler_name(target);
    var triples: string = "";
    if (platform == "windows" && compiler == "msvc") {
        triples = arch + "-windows\n" + arch + "-windows-static\n";
    } else if (platform == "windows" && compiler == "mingw") {
        triples = arch + "-mingw-dynamic\n" + arch + "-mingw-static\n";
    } else if (platform == "linux") {
        triples = arch + "-linux\n";
    } else if (platform == "macos") {
        triples = arch + "-osx\n";
    }
    var ri: i64 = 0;
    let rn = build_line_count(roots.clone());
    while (ri < rn) {
        let root = build_line_at(roots.clone(), ri).trim();
        if (root.len > 0) {
            var ti: i64 = 0;
            let tn = build_line_count(triples.clone());
            while (ti < tn) {
                let triple = build_line_at(triples.clone(), ti).trim();
                if (triple.len > 0) {
                    out = build_probe_append_dir(
                        out.clone(),
                        build_join_path(build_join_path(build_join_path(root.clone(), "installed"), triple), "lib"));
                }
                ti = ti + 1;
            }
        }
        ri = ri + 1;
    }
    return out;
}

fn build_posix_lib_dirs() -> string {
    var out: string = "";
    out = build_probe_append_dir(out.clone(), "/usr/lib");
    out = build_probe_append_dir(out.clone(), "/usr/lib64");
    out = build_probe_append_dir(out.clone(), "/usr/lib/x86_64-linux-gnu");
    out = build_probe_append_dir(out.clone(), "/usr/lib/aarch64-linux-gnu");
    out = build_probe_append_dir(out.clone(), "/usr/local/lib");
    out = build_probe_append_dir(out.clone(), "/opt/homebrew/lib");
    out = build_probe_append_dir(out.clone(), "/opt/homebrew/opt/curl/lib");
    out = build_probe_append_dir(out.clone(), "/opt/homebrew/opt/openssl/lib");
    out = build_probe_append_dir(out.clone(), "/opt/homebrew/opt/openssl@3/lib");
    out = build_probe_append_dir(out.clone(), "/usr/local/opt/curl/lib");
    out = build_probe_append_dir(out.clone(), "/usr/local/opt/openssl/lib");
    out = build_probe_append_dir(out.clone(), "/usr/local/opt/openssl@3/lib");
    return out;
}

fn build_windows_openssl_lib_dirs() -> string {
    var out: string = "";
    out = build_probe_append_dir(out.clone(), "C:/Program Files/OpenSSL-Win64/lib");
    out = build_probe_append_dir(out.clone(), "C:/Program Files/OpenSSL/lib");
    out = build_probe_append_dir(out.clone(), "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MD");
    out = build_probe_append_dir(out.clone(), "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MT");
    return out;
}

fn build_syslib_search_dirs(name: string) -> string {
    var out: string = "";
    if (!build_cross_triplet_requested()) {
        let env_dir = build_syslib_env_libdir(name.clone());
        if (env_dir.len > 0) { out = out + env_dir + "\n"; }
        let pc = build_pkgconfig_libdir(build_syslib_pkgconfig_name(name.clone()));
        if (pc.len > 0) { out = out + pc + "\n"; }
    }
    out = out + build_vcpkg_lib_dirs();
    if (build_cross_triplet_requested()) { return out; }
    if (build_effective_is_windows()) {
        if (name == "ssl" || name == "libssl" || name == "crypto" || name == "libcrypto") {
            out = out + build_windows_openssl_lib_dirs();
        }
    } else {
        out = out + build_posix_lib_dirs();
    }
    return out;
}

fn build_probe_one_system_lib_dir(name: string) -> string {
    if (!build_syslib_is_probe_candidate(name.clone())) { return ""; }
    let dirs = build_syslib_search_dirs(name.clone());
    var i: i64 = 0;
    let n = build_line_count(dirs.clone());
    while (i < n) {
        let dir = build_line_at(dirs.clone(), i).trim();
        if (dir.len > 0 && build_dir_has_named_lib(dir.clone(), name.clone())) {
            return dir;
        }
        i = i + 1;
    }
    return "";
}

fn build_probe_system_lib_paths(libs_toml: string, declared_paths_toml: string) -> string {
    var out: string = "";
    let names = toml_array_to_lines(libs_toml);
    var i: i64 = 0;
    let n = build_line_count(names.clone());
    while (i < n) {
        let name = build_line_at(names.clone(), i).trim();
        var declared_file: string = "";
        if (build_syslib_is_probe_candidate(name.clone())) {
            let declared_paths = toml_array_to_lines(declared_paths_toml.clone());
            var pi: i64 = 0;
            let pn = build_line_count(declared_paths.clone());
            while (pi < pn && declared_file.len == 0) {
                let path = build_line_at(declared_paths.clone(), pi).trim();
                declared_file = build_first_link_file_in_dir(path, name.clone());
                pi = pi + 1;
            }
        }
        let dir = if (declared_file.len > 0) { "" }
                  else { build_probe_one_system_lib_dir(name.clone()) };
        if (dir.len > 0) {
            out = build_append_toml_array_item(out.clone(), dir.replace("\\", "/"));
            if (build_env_value("VYX_DEBUG_LINK").len > 0) {
                build_log("[syslib] " + name + " -> " + dir);
            }
        }
        i = i + 1;
    }
    return out;
}

fn build_resolve_system_lib_names(libs_toml: string, lib_paths_toml: string) -> string {
    var out: string = "";
    let names = toml_array_to_lines(libs_toml);
    var i: i64 = 0;
    let n = build_line_count(names.clone());
    while (i < n) {
        let name = build_line_at(names.clone(), i).trim();
        if (name.len > 0) {
            var item = name.clone();
            if (build_effective_is_windows() && build_syslib_is_probe_candidate(name.clone())) {
                let paths = toml_array_to_lines(lib_paths_toml.clone());
                var pi: i64 = 0;
                let pn = build_line_count(paths.clone());
                while (pi < pn && item == name) {
                    let dir = build_line_at(paths.clone(), pi).trim();
                    let file = build_first_link_file_in_dir(dir, name.clone());
                    if (file.len > 0) { item = file.replace("\\", "/"); }
                    pi = pi + 1;
                }
            }
            out = build_append_toml_array_item(out.clone(), item);
        }
        i = i + 1;
    }
    if (out.len == 0) { return libs_toml; }
    return out;
}

fn build_copy_probed_system_runtime(paths_toml: string,
                                    libs_toml: string,
                                    out_dir: string,
                                    shared_ext: string) {
    var dirs: string = "";
    let paths = toml_array_to_lines(paths_toml);
    var i: i64 = 0;
    var n = build_line_count(paths.clone());
    while (i < n) {
        let dir = build_line_at(paths.clone(), i).trim();
        if (dir.len > 0) { dirs = dirs + dir + "\n"; }
        i = i + 1;
    }
    let libs = toml_array_to_lines(libs_toml);
    i = 0;
    n = build_line_count(libs.clone());
    while (i < n) {
        let lib = build_line_at(libs.clone(), i).trim();
        if (build_is_direct_link_input(lib.clone())) {
            dirs = dirs + build_dirname(lib) + "\n";
        }
        i = i + 1;
    }
    i = 0;
    n = build_line_count(dirs.clone());
    while (i < n) {
        let dir = build_line_at(dirs.clone(), i).trim();
        if (dir.len > 0 && fileExists(dir.clone())) {
            vyx_bootstrap_copy_files_with_ext(build_host_path(dir.clone()).c_str(),
                                              build_host_path(out_dir.clone()).c_str(),
                                              shared_ext.c_str());
            let parent = build_dirname(dir.clone());
            let bin = build_join_path(parent, "bin");
            if (fileExists(bin.clone())) {
                vyx_bootstrap_copy_files_with_ext(build_host_path(bin).c_str(),
                                                  build_host_path(out_dir.clone()).c_str(),
                                                  shared_ext.c_str());
            }
        }
        i = i + 1;
    }
}

fn build_find_tool_on_path(tool: string) -> string {
    let path_env = build_env_value("PATH");
    if (path_env.len == 0 || tool.len == 0) { return ""; }
    var sep: i32 = 58;
    if (build_is_windows()) { sep = 59; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= path_env.len) {
        if (i == path_env.len || path_env.charAt(i) == sep) {
            let dir = path_env.substring(start, i).trim();
            if (dir.len > 0) {
                let candidate = build_join_path(dir, tool);
                if (fileExists(candidate)) { return candidate; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn build_ps_single_quote(text: string) -> string {
    var out = "'";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 39) {
            out = out + "''";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "'";
}

fn build_sh_single_quote(text: string) -> string {
    var out = "'";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 39) {
            out = out + "'\\''";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "'";
}

fn build_android_ndk_root_like(path: string) -> bool {
    if (path.len == 0 || !isDir(path)) { return false; }
    return isDir(build_join_path(path, "toolchains/llvm/prebuilt"));
}

fn build_android_sdk_root() -> string {
    let home = build_env_value("ANDROID_HOME");
    if (home.len > 0 && isDir(home)) { return home; }
    let root = build_env_value("ANDROID_SDK_ROOT");
    if (root.len > 0 && isDir(root)) { return root; }
    if (build_is_windows()) {
        let local = build_env_value("LOCALAPPDATA");
        if (local.len > 0) {
            let candidate = build_join_path(build_join_path(local, "Android"), "Sdk");
            if (isDir(candidate)) { return candidate; }
        }
        let user = build_env_value("USERPROFILE");
        if (user.len > 0) {
            let candidate2 = build_join_path(build_join_path(build_join_path(user, "AppData"), "Local"), "Android/Sdk");
            if (isDir(candidate2)) { return candidate2; }
        }
    } else if (build_is_apple()) {
        let home2 = build_env_value("HOME");
        if (home2.len > 0) {
            let candidate3 = build_join_path(home2, "Library/Android/sdk");
            if (isDir(candidate3)) { return candidate3; }
        }
    } else {
        let home3 = build_env_value("HOME");
        if (home3.len > 0) {
            let candidate4 = build_join_path(home3, "Android/Sdk");
            if (isDir(candidate4)) { return candidate4; }
        }
    }
    return "";
}

fn build_latest_child_dir(parent: string) -> string {
    if (!isDir(parent)) { return ""; }
    build_make_dir(".cache");
    let tmp = build_join_path(".cache", "android_ndk_root.tmp");
    deleteFile(tmp.clone());
    let rc = vyx_bootstrap_list_dirs(build_host_path(parent).c_str(), build_host_path(tmp.clone()).c_str());
    if (rc != 0) {
        deleteFile(tmp.clone());
        return "";
    }
    let rows = readFile(tmp.clone());
    deleteFile(tmp);
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            var line = rows.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.len > 0) { out = line; }
            start = i + 1;
        }
        i = i + 1;
    }
    if (out.len > 0 && isDir(out)) { return out; }
    return "";
}

fn build_android_ndk_root() -> string {
    let ndk_home = build_env_value("ANDROID_NDK_HOME");
    if (build_android_ndk_root_like(ndk_home)) { return ndk_home; }
    let ndk_root = build_env_value("ANDROID_NDK_ROOT");
    if (build_android_ndk_root_like(ndk_root)) { return ndk_root; }
    let ndk_home2 = build_env_value("NDK_HOME");
    if (build_android_ndk_root_like(ndk_home2)) { return ndk_home2; }
    let sdk = build_android_sdk_root();
    if (sdk.len == 0) { return ""; }
    let bundle = build_join_path(sdk, "ndk-bundle");
    if (build_android_ndk_root_like(bundle)) { return bundle; }
    let child = build_latest_child_dir(build_join_path(sdk, "ndk"));
    if (build_android_ndk_root_like(child)) { return child; }
    return "";
}

fn build_android_tool_from_prebuilt(ndk: string, tag: string, tool: string) -> string {
    let bin = build_join_path(build_join_path(build_join_path(ndk, "toolchains/llvm/prebuilt"), tag), "bin");
    let with_exe = build_join_path(bin, tool + ".exe");
    if (fileExists(with_exe)) { return with_exe; }
    let plain = build_join_path(bin, tool);
    if (fileExists(plain)) { return plain; }
    return "";
}

fn build_android_tool_path(tool: string) -> string {
    let debug = build_env_value("VYX_DEBUG_LINK").len > 0;
    if (debug) {
        build_log("[android-tool] tool=" + tool + " target=" + build_requested_target() + " platform=" + build_effective_platform_name());
    }
    if (!build_effective_is_android()) { return ""; }
    if (!(tool == "clang" || tool == "clang++" || tool == "llvm-ar")) { return ""; }
    let ndk = build_android_ndk_root();
    if (debug) { build_log("[android-tool] ndk=" + ndk); }
    if (ndk.len == 0) { return ""; }
    if (build_is_windows()) {
        let win = build_android_tool_from_prebuilt(ndk, "windows-x86_64", tool);
        if (debug) { build_log("[android-tool] selected=" + win); }
        return win;
    }
    if (build_is_linux()) {
        let lin = build_android_tool_from_prebuilt(ndk, "linux-x86_64", tool);
        if (debug) { build_log("[android-tool] selected=" + lin); }
        return lin;
    }
    if (build_is_apple()) {
        let arm = build_android_tool_from_prebuilt(ndk, "darwin-arm64", tool);
        if (arm.len > 0) {
            if (debug) { build_log("[android-tool] selected=" + arm); }
            return arm;
        }
        let darwin = build_android_tool_from_prebuilt(ndk, "darwin-x86_64", tool);
        if (debug) { build_log("[android-tool] selected=" + darwin); }
        return darwin;
    }
    return "";
}

fn build_tool_path(tool: string) -> string {
    let android_tool = build_android_tool_path(tool);
    if (android_tool.len > 0) { return android_tool; }

    let llvm_bin_env = build_env_value("LLVM_BIN");
    if (llvm_bin_env.len > 0) {
        let b1 = build_join_path(llvm_bin_env, tool + ".exe");
        if (fileExists(b1)) { return b1; }
        let b2 = build_join_path(llvm_bin_env, tool);
        if (fileExists(b2)) { return b2; }
    }

    let llvm_root_env = build_env_value("LLVM_ROOT");
    if (llvm_root_env.len > 0) {
        let r1 = build_join_path(llvm_root_env, tool + ".exe");
        if (fileExists(r1)) { return r1; }
        let r2 = build_join_path(llvm_root_env, tool);
        if (fileExists(r2)) { return r2; }
        let rbin1 = build_join_path(build_join_path(llvm_root_env, "bin"), tool + ".exe");
        if (fileExists(rbin1)) { return rbin1; }
        let rbin2 = build_join_path(build_join_path(llvm_root_env, "bin"), tool);
        if (fileExists(rbin2)) { return rbin2; }
    }

    let exe_dir = build_exe_dir();
    let bin1 = build_join_path(exe_dir, "clang/bin");
    let p1 = build_join_path(bin1, tool + ".exe");
    if (fileExists(p1)) { return p1; }
    let p2 = build_join_path(bin1, tool);
    if (fileExists(p2)) { return p2; }
    let parent = build_dirname(exe_dir.clone());
    let bin2 = build_join_path(parent.clone(), "clang/bin");
    let p3 = build_join_path(bin2, tool + ".exe");
    if (fileExists(p3)) { return p3; }
    let p4 = build_join_path(bin2, tool);
    if (fileExists(p4)) { return p4; }
    let grand = build_dirname(parent.clone());
    let bin3 = build_join_path(grand.clone(), "clang/bin");
    let p5 = build_join_path(bin3, tool + ".exe");
    if (fileExists(p5)) { return p5; }
    let p6 = build_join_path(bin3, tool);
    if (fileExists(p6)) { return p6; }
    let bin4 = "../clang/bin";
    let p7 = build_join_path(bin4, tool + ".exe");
    if (fileExists(p7)) { return p7; }
    let p8 = build_join_path(bin4, tool);
    if (fileExists(p8)) { return p8; }
    let p9 = build_find_tool_on_path(tool + ".exe");
    if (p9.len > 0) { return p9; }
    let p10 = build_find_tool_on_path(tool);
    if (p10.len > 0) { return p10; }
    if (build_is_windows()) { return tool + ".exe"; }
    return tool;
}

fn build_output_path(target_name: string, kind: string, output_dir: string) -> string {
    var ext = build_exe_ext();
    if (kind == "shared" || kind == "dylib") { ext = build_shared_ext(); }
    if (kind == "static" || kind == "staticlib") { ext = build_static_ext(); }
    var out_name = target_name;
    if (!build_effective_is_windows() && (kind == "shared" || kind == "dylib" || kind == "static" || kind == "staticlib")) {
        if (!out_name.startsWith("lib")) {
            out_name = "lib" + out_name;
        }
    }
    if (output_dir.len > 0) {
        build_make_dir(output_dir.clone());
        return build_join_path(output_dir, out_name + ext);
    }
    return out_name + ext;
}

fn build_copy_output_aliases(output_path: string,
                             kind: string,
                             output_dir: string,
                             aliases_raw: string,
                             self_exe: string) -> i32 {
    let aliases = toml_array_to_lines(aliases_raw);
    let count = build_line_count(aliases.clone());
    var i: i64 = 0;
    while (i < count) {
        let alias = build_trim_quotes(build_line_at(aliases.clone(), i)).trim();
        if (alias.len > 0) {
            let alias_path = build_output_path(alias, kind, output_dir);
            if (build_norm_path(alias_path.clone()) != build_norm_path(output_path.clone())) {
                if (build_alias_targets_running_exe(alias_path.clone(), self_exe.clone())) {
                    print("  alias in use, skipped " + alias_path);
                    i = i + 1;
                    continue;
                }
                build_ensure_parent(alias_path.clone());
                if (build_copy_file_retry(output_path.clone(), alias_path.clone()) != 0) {
                    if (build_alias_targets_running_exe(alias_path.clone(), self_exe.clone())) {
                        print("  alias in use, skipped " + alias_path);
                        i = i + 1;
                        continue;
                    }
                    print("error: failed to copy output alias '" + alias_path + "'");
                    return 1;
                }
                print("  aliased " + alias_path);
            }
        }
        i = i + 1;
    }
    return 0;
}

fn build_write_compiler_provenance_aliases(output_path: string,
                                            kind: string,
                                            output_dir: string,
                                            aliases_raw: string,
                                            generation: string) -> i32 {
    if (build_write_compiler_provenance(output_path.clone(), generation.clone()) != 0) {
        return 1;
    }
    let aliases = toml_array_to_lines(aliases_raw);
    let count = build_line_count(aliases.clone());
    var i: i64 = 0;
    while (i < count) {
        let alias = build_trim_quotes(build_line_at(aliases.clone(), i)).trim();
        if (alias.len > 0) {
            let alias_path = build_output_path(alias, kind.clone(), output_dir.clone());
            if (build_norm_path(alias_path.clone()) != build_norm_path(output_path.clone())
                && fileExists(alias_path.clone())
                && build_write_compiler_provenance(alias_path, generation.clone()) != 0) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn build_vyi_output_path(target_name: string, output_dir: string) -> string {
    if (output_dir.len > 0) {
        return build_join_path(output_dir, target_name + ".vyi");
    }
    return target_name + ".vyi";
}

fn build_vyi_source_output_path(target_name: string,
                                output_dir: string,
                                entry: string,
                                src: string) -> string {
    if (build_norm_path(src.clone()) == build_norm_path(entry.clone())) {
        return build_vyi_output_path(target_name, output_dir);
    }
    let mod = build_module_name_from_file(src.clone());
    if (mod.len > 0) {
        let module_file = build_safe_obj_name(mod, ".vyi");
        if (output_dir.len > 0) {
            return build_join_path(output_dir, module_file);
        }
        return module_file;
    }
    let file_name = build_safe_obj_name(src, ".vyi");
    if (output_dir.len > 0) {
        return build_join_path(output_dir, file_name);
    }
    return file_name;
}

fn build_legacy_vyi_source_output_path(target_name: string,
                                       output_dir: string,
                                       entry: string,
                                       src: string) -> string {
    if (build_norm_path(src.clone()) == build_norm_path(entry.clone())) {
        return build_vyi_output_path(target_name, output_dir);
    }
    let file_name = build_safe_obj_name(src, ".vyi");
    if (output_dir.len > 0) {
        return build_join_path(output_dir, file_name);
    }
    return file_name;
}

fn build_cleanup_stale_vyi_for_module(output_dir: string,
                                      keep_path: string,
                                      module_name: string) {
    if (output_dir.len == 0 || module_name.len == 0) {
        return;
    }
    let files = build_dep_file_list(output_dir.clone());
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.len > 0
                && path.endsWith(".vyi")
                && build_norm_path(path.clone()) != build_norm_path(keep_path.clone())
                && build_module_name_from_file(path.clone()) == module_name) {
                deleteFile(path);
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

fn build_cleanup_legacy_group_vyi(target_name: string,
                                  output_dir: string,
                                  entry: string,
                                  group_sources: string,
                                  keep_path: string) {
    var i: i64 = 0;
    let n = build_line_count(group_sources.clone());
    while (i < n) {
        let src = build_line_at(group_sources.clone(), i);
        let stale = build_legacy_vyi_source_output_path(target_name.clone(),
                                                       output_dir.clone(),
                                                       entry.clone(),
                                                       src.clone());
        if (stale.len > 0 && build_norm_path(stale.clone()) != build_norm_path(keep_path.clone())) {
            deleteFile(stale);
        }
        i = i + 1;
    }
}

fn build_cleanup_legacy_file_vyi_for_module(output_dir: string,
                                            keep_path: string,
                                            target_name: string,
                                            entry: string,
                                            module_name: string) {
    if (output_dir.len == 0 || module_name.len == 0) {
        return;
    }
    let files = build_dep_file_list(output_dir.clone());
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            let stem = build_path_stem(path.clone());
            if (path.len > 0
                && path.endsWith(".vyi")
                && stem.startsWith("src_")
                && stem.endsWith("_vyx")
                && build_norm_path(path.clone()) != build_norm_path(keep_path.clone())
                && build_module_name_from_file(path.clone()) == module_name) {
                deleteFile(path);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let legacy_src = build_legacy_module_source_path(module_name.clone());
    if (legacy_src.len > 0) {
        let stale = build_legacy_vyi_source_output_path(target_name,
                                                       output_dir,
                                                       entry,
                                                       legacy_src);
        if (build_norm_path(stale.clone()) != build_norm_path(keep_path.clone())) {
            deleteFile(stale);
        }
    }
}

fn build_emit_library_vyi_files(self_exe: string,
                                target_name: string,
                                output_dir: string,
                                entry: string,
                                sources: string,
                                cache_dir: string,
                                jobs: i32,
                                compiler_args: string,
                                decorated_sources_path: string) -> i32 {
    let exe_arg = build_tool_arg(self_exe);
    var decorated_args: string = "";
    if (decorated_sources_path.len > 0) {
        decorated_args = " --vyi-decorated-sources " + build_quote(decorated_sources_path);
    }
    var seen_groups: string = "";
    var tasks: string = "";
    var step: i64 = 1;
    var i: i64 = 0;
    let n = build_line_count(sources);
    while (i < n) {
        let src = build_expand_env(build_line_at(sources.clone(), i));
        if (build_source_kind(src.clone()) == "vyx") {
            let group_key = build_source_group_key(src.clone());
            if (build_group_key_seen(seen_groups.clone(), group_key.clone())) {
                i = i + 1;
                continue;
            }
            seen_groups = seen_groups + group_key.clone() + "\n";
            let group_sources = build_sources_for_group(sources, group_key.clone());
            let vyi_path = build_vyi_source_output_path(target_name.clone(),
                                                       output_dir.clone(),
                                                       entry.clone(),
                                                       src.clone());
            build_ensure_parent(vyi_path.clone());
            let module_name = build_module_name_from_file(src.clone());
            build_cleanup_stale_vyi_for_module(output_dir.clone(),
                                               vyi_path.clone(),
                                               module_name);
            build_cleanup_legacy_group_vyi(target_name.clone(),
                                           output_dir.clone(),
                                           entry.clone(),
                                           group_sources.clone(),
                                           vyi_path.clone());
            build_cleanup_legacy_file_vyi_for_module(output_dir.clone(),
                                                     vyi_path.clone(),
                                                     target_name.clone(),
                                                     entry.clone(),
                                                     module_name);
            var unit_sources_path: string = "";
            if (build_line_count(group_sources.clone()) > 1) {
                unit_sources_path = build_unit_sources_path(cache_dir.clone(), group_key.clone());
                build_ensure_parent(unit_sources_path.clone());
                writeFile(unit_sources_path.clone(), group_sources.clone());
            }
            var unit_args: string = "";
            if (unit_sources_path.len > 0) {
                unit_args = " --unit-sources " + build_quote(unit_sources_path);
            }
            let vyi_tmp_path = build_task_tmp_output(vyi_path.clone());
            let vyi_cmd = exe_arg + " --emit=vyi --vyi-shallow --src=file "
                          + build_quote(src) + " -o " + build_quote(vyi_tmp_path)
                          + unit_args + compiler_args + decorated_args;
            tasks = tasks + step.toString() + "\t" + src + "\t" + vyi_path + "\t" + vyi_cmd + "\n";
            step = step + 1;
        }
        i = i + 1;
    }
    let task_count = build_line_count(tasks.clone());
    if (task_count <= 0) { return 0; }
    print(build_color("90", "[vyi]") + " " + build_status_vyi() + " "
          + task_count.toString() + " library interface(s) -> " + build_path_label(output_dir));
    // Interface emission is a normal independent compile fan-out.  Running
    // it through a single worker made library builds pay one full compiler
    // startup/import/sema pipeline per public module serially after linking.
    let rc = build_run_tasks(tasks.clone(), task_count, jobs, task_count);
    if (rc != 0) {
        print(build_error_label() + ": library interface emit failed");
    }
    return rc;
}

fn build_link_args(lib_paths: string,
                   libs: string,
                   need_runtime: bool,
                   target_name: string) -> string {
    var out = build_manifest_cli_quoted(lib_paths, "-L")
              + build_manifest_cli_quoted(libs, "-l");
    if (need_runtime && !build_has_lib(libs, "vyx_compiler_backend")
        && !build_has_lib(libs, "vyx_runtime")
        && !build_has_lib(libs, "vyx_rt")
        && !build_has_lib(libs, "vyx_run_rt")
        && !build_has_lib(libs, "vyx_run_rt_static")) {
        let rt = build_runtime_dir();
        if (rt.len > 0) {
            out = out + " -L " + build_quote(rt) + " -l " + build_runtime_link_name(rt.clone());
        } else {
            let triple = policy_effective_target_triple();
            let runtime_file = build_library_filename("vyx_runtime", build_static_ext());
            print(build_error_label() + ": target runtime not found for `" + triple
                  + "` while linking '" + target_name + "'");
            print("  stage " + runtime_file
                  + " beside vyxc, or declare its directory/library with lib_paths + libs");
            if (policy_cli_requested_triplet().len > 0) {
                print("  bootstrap runtime: vyxc build --target vyx_runtime --triplet " + triple);
            }
            return "|ERR|";
        }
    }
    if (need_runtime && build_effective_is_linux()) {
        // Auto-linked companions such as oneTBB (std.*.thread_pool) are
        // copied next to the binary by build_copy_tbb_runtime_library, so
        // executables always get an $ORIGIN runpath even with a static
        // application runtime.
        out = out + " -Wl,-rpath,$ORIGIN";
    }
    if (target_name == "vyx_compiler_backend" && build_effective_is_linux()) {
        out = out + " -Wl,-rpath,$ORIGIN:$ORIGIN/../lib";
    }
    if (target_name == "vyx_compiler_backend" && build_effective_is_apple()) {
        out = out + " -Wl,-rpath,@loader_path";
    }
    return out;
}

fn build_nm_tool_arg() -> string {
    let nm = build_tool_path("llvm-nm");
    // Don't quote a bare-name (PATH-resolved) tool — cmd.exe path lookup
    // doesn't work for quoted commands without an explicit path.
    var nm_arg: string = nm;
    var has_slash: bool = false;
    var ni: i32 = 0;
    while (ni < nm.len) {
        let c = nm.charAt(ni);
        if (c == 47 || c == 92) { has_slash = true; break; }
        ni = ni + 1;
    }
    if (has_slash) { nm_arg = build_quote(nm); }
    return nm_arg;
}

fn build_filter_export_symbols(raw: string) -> string {
    var out = "EXPORTS\r\n";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= raw.len) {
        if (i == raw.len || raw.charAt(i) == 10) {
            var line = raw.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.len > 0
                && (line.startsWith("__vyx")
                    || (!line.startsWith("_")
                        && !line.startsWith(".")
                        && !line.startsWith("$")
                        && !build_contains(line.clone(), "@")))) {
                out = out + "    " + line + "\r\n";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

/// Extract a `.def` file's content listing exported symbols by inspecting
/// the obj's defined external symbols via `llvm-nm`. Filters out symbols
/// starting with "_" (these include LLVM-generated `__real@*` constants
/// and similar artifacts that shouldn't be exported).
fn build_extract_exports(obj_path: string) -> string {
    if (!fileExists(obj_path)) {
        build_log(build_error_label() + ": export scan object is missing: " + obj_path);
        return "|ERR|";
    }
    build_make_dir(".cache");
    let tmp = build_join_path(".cache", build_safe_obj_name(".vyx_exports_" + obj_path, ".tmp"));
    let err_tmp = build_join_path(".cache", build_safe_obj_name(".vyx_exports_" + obj_path, ".err.tmp"));
    writeFile(tmp.clone(), "");
    writeFile(err_tmp.clone(), "");
    let cmd = build_nm_tool_arg() + " --extern-only --defined-only --format=just-symbols "
              + build_quote(obj_path);
    let rc = build_run_process(cmd, "", tmp.clone(), err_tmp.clone());
    if (rc != 0) {
        let err = readFile(err_tmp.clone());
        build_log(build_error_label() + ": export scan failed for " + obj_path
                  + " (llvm-nm exit " + rc.toString() + ")");
        if (err.len > 0 && build_env_value("VYX_DEBUG_LINK").len > 0) { build_log(err); }
        deleteFile(tmp);
        deleteFile(err_tmp);
        return "|ERR|";
    }
    let raw = readFile(tmp.clone());
    deleteFile(tmp);
    deleteFile(err_tmp);
    return build_filter_export_symbols(raw);
}

fn build_export_cache_dir(cache_dir: string) -> string {
    var dir = cache_dir;
    if (dir.len == 0) { dir = ".cache"; }
    dir = build_join_path(dir, "exports");
    build_make_dir(dir.clone());
    return dir;
}

fn build_export_cache_path(cache_dir: string, obj_path: string, index: i64) -> string {
    let dir = build_export_cache_dir(cache_dir);
    return build_join_path(dir, build_safe_obj_name(index.toString() + "_" + obj_path, ".exports"));
}

fn build_export_cache_key(obj_path: string) -> string {
    return "v2;mtime=" + build_file_mtime(obj_path).toString()
           + ";size=" + fileSize(obj_path).toString()
           + ";obj=" + build_abs_norm_path(obj_path);
}

fn build_export_cache_body_from_text(text: string, key: string) -> string {
    let nl = text.indexOf("\n");
    if (nl < 0) { return ""; }
    let first = text.substring(0, nl).trim();
    if (first != key) { return ""; }
    return text.substring(nl + 1, text.len);
}

fn build_export_cache_lookup(cache_path: string, key: string) -> string {
    if (!fileExists(cache_path)) { return ""; }
    let text = readFile(cache_path.clone());
    let footer = "\n#vyx-export-cache-complete\n";
    if (!text.endsWith(footer)) { return ""; }
    return build_export_cache_body_from_text(
        text.substring(0, text.len - footer.len), key);
}

fn build_export_cache_store(cache_path: string, key: string, chunk: string) -> i32 {
    let payload = key + "\n" + chunk + "\n#vyx-export-cache-complete\n";
    return build_publish_text_file(cache_path, payload);
}

fn build_export_scan_command(obj_path: string) -> string {
    return build_nm_tool_arg() + " --extern-only --defined-only --format=just-symbols "
           + build_quote(obj_path);
}

fn build_export_scan_task_line(index: i64,
                               obj_path: string,
                               cache_path: string,
                               tmp_path: string,
                               err_path: string) -> string {
    return index.toString() + "\t" + obj_path + "\t" + cache_path + "\t"
           + tmp_path + "\t" + err_path + "\t" + build_export_scan_command(obj_path);
}

fn build_finish_export_scan(obj_path: string,
                            cache_path: string,
                            tmp_path: string,
                             err_path: string,
                             rc: i32) -> i32 {
    if (rc != 0) {
        let err = readFile(err_path.clone());
        build_log(build_error_label() + ": export scan failed for " + obj_path
                  + " (llvm-nm exit " + rc.toString() + ")");
        if (err.len > 0 && build_env_value("VYX_DEBUG_LINK").len > 0) { build_log(err); }
        deleteFile(tmp_path);
        deleteFile(err_path);
        return rc;
    }
    let raw = readFile(tmp_path.clone());
    let chunk = build_filter_export_symbols(raw);
    if (build_export_cache_store(
            cache_path, build_export_cache_key(obj_path), chunk) != 0) {
        build_log(build_error_label() + ": cannot publish export cache for " + obj_path);
        deleteFile(tmp_path);
        deleteFile(err_path);
        return 1;
    }
    deleteFile(tmp_path);
    deleteFile(err_path);
    return 0;
}

fn build_execute_export_scan_task(task_line: string) -> i32 {
    let obj_path = build_field(task_line.clone(), 1);
    let cache_path = build_field(task_line.clone(), 2);
    let tmp_path = build_field(task_line.clone(), 3);
    let err_path = build_field(task_line.clone(), 4);
    let cmd = build_field(task_line, 5);
    deleteFile(tmp_path.clone());
    deleteFile(err_path.clone());
    let rc = build_run_process(cmd, "", tmp_path.clone(), err_path.clone());
    return build_finish_export_scan(obj_path, cache_path, tmp_path, err_path, rc);
}

fn build_start_export_scan_job(task_line: string) -> string {
    let index = build_field(task_line.clone(), 0);
    let obj_path = build_field(task_line.clone(), 1);
    let cache_path = build_field(task_line.clone(), 2);
    let tmp_path = build_field(task_line.clone(), 3);
    let err_path = build_field(task_line.clone(), 4);
    let cmd = build_field(task_line, 5);
    deleteFile(tmp_path.clone());
    deleteFile(err_path.clone());
    let empty = "";
    let pid = vyx_bootstrap_process_spawn(cmd.c_str(),
                                          empty.c_str(),
                                          tmp_path.c_str(),
                                          err_path.c_str(),
                                          empty.c_str(),
                                          empty.c_str());
    if (pid == 0) {
        build_log(build_error_label() + ": failed to start export scan: " + obj_path);
        return "";
    }
    return index + "\t" + pid.toString() + "\t" + obj_path + "\t"
           + cache_path + "\t" + tmp_path + "\t" + err_path + "\n";
}

fn build_poll_export_scan_jobs(active: string) -> string {
    var remaining: string = "";
    var i: i64 = 0;
    let n = build_line_count(active.clone());
    while (i < n) {
        let line = build_line_at(active.clone(), i);
        let pid = build_parse_i64(build_field(line.clone(), 1));
        if (vyx_bootstrap_process_is_running(pid) != 0) {
            remaining = remaining + line + "\n";
        } else {
            let obj_path = build_field(line.clone(), 2);
            let cache_path = build_field(line.clone(), 3);
            let tmp_path = build_field(line.clone(), 4);
            let err_path = build_field(line.clone(), 5);
            let rc = vyx_bootstrap_process_exit_code(pid);
            vyx_bootstrap_process_close(pid);
            let finish_rc = build_finish_export_scan(obj_path, cache_path, tmp_path, err_path, rc);
            if (finish_rc != 0) { remaining = remaining + "|ERR|\n"; }
        }
        i = i + 1;
    }
    return remaining;
}

fn build_run_export_scan_tasks_parallel(tasks: string, task_count: i64, jobs: i32) -> i32 {
    var worker_count: i64 = jobs as i64;
    if (worker_count < 1) { worker_count = 1; }
    if (worker_count > task_count) { worker_count = task_count; }
    var next: i64 = 0;
    var active: string = "";
    var errors: i32 = 0;
    while ((errors == 0 && next < task_count) || build_line_count(active.clone()) > 0) {
        while (errors == 0 && next < task_count && build_line_count(active.clone()) < worker_count) {
            let job = build_start_export_scan_job(build_line_at(tasks.clone(), next));
            if (job.len == 0) {
                errors = errors + 1;
            } else {
                active = active.clone() + job.clone();
            }
            next = next + 1;
        }
        vyx_bootstrap_sleep_ms(20);
        let polled = build_poll_export_scan_jobs(active.clone());
        if (build_contains("\n" + polled.clone(), "\n|ERR|\n")) {
            errors = errors + 1;
            active = polled.replace("|ERR|\n", "");
        } else {
            active = polled;
        }
    }
    if (errors > 0) { return 1; }
    return 0;
}

fn build_run_export_scan_tasks(tasks: string, task_count: i64, jobs: i32) -> i32 {
    if (task_count <= 0) { return 0; }
    var worker_count: i64 = jobs as i64;
    if (worker_count < 1) { worker_count = 1; }
    if (worker_count > task_count) { worker_count = task_count; }
    if (worker_count <= 1) {
        var i: i64 = 0;
        while (i < task_count) {
            let rc = build_execute_export_scan_task(build_line_at(tasks.clone(), i));
            if (rc != 0) { return rc; }
            i = i + 1;
        }
        return 0;
    }
    return build_run_export_scan_tasks_parallel(tasks, task_count, jobs);
}

fn build_generate_def_file(target_name: string,
                           output_path: string,
                           objects: string,
                           cache_dir: string,
                           jobs: i32) -> string {
    var profile_start: i64 = 0;
    var profile_mark: i64 = 0;
    if (build_profile_enabled()) {
        profile_start = vyx_bootstrap_now_ms();
        profile_mark = profile_start;
    }
    var tasks: string = "";
    var hits: i64 = 0;
    var misses: i64 = 0;
    var i: i64 = 0;
    let n = build_line_count(objects.clone());
    while (i < n) {
        let obj_path = build_line_at(objects.clone(), i);
        let cache_path = build_export_cache_path(cache_dir.clone(), obj_path.clone(), i);
        let key = build_export_cache_key(obj_path.clone());
        let cached = build_export_cache_lookup(cache_path.clone(), key);
        if (cached.len > 0) {
            hits = hits + 1;
        } else {
            let tmp_path = cache_path.clone() + ".tmp";
            let err_path = cache_path.clone() + ".err";
            tasks = tasks + build_export_scan_task_line(i, obj_path, cache_path, tmp_path, err_path) + "\n";
            misses = misses + 1;
        }
        i = i + 1;
    }
    if (build_profile_enabled()) {
        profile_mark = build_profile_mark("export-scan plan " + target_name
                                          + " objects=" + n.toString()
                                          + " hits=" + hits.toString()
                                          + " misses=" + misses.toString(),
                                          profile_mark);
    }
    let task_count = build_line_count(tasks.clone());
    let scan_rc = build_run_export_scan_tasks(tasks.clone(), task_count, jobs);
    if (scan_rc != 0) { return "|ERR|"; }
    if (build_profile_enabled()) {
        profile_mark = build_profile_mark("export-scan nm " + target_name
                                          + " tasks=" + task_count.toString(),
                                          profile_mark);
    }

    var combined_def: string = "EXPORTS\r\n";
    var export_lines: i64 = 0;
    var j: i64 = 0;
    while (j < n) {
        let obj_path2 = build_line_at(objects.clone(), j);
        let cache_path2 = build_export_cache_path(cache_dir.clone(), obj_path2.clone(), j);
        let key2 = build_export_cache_key(obj_path2.clone());
        var chunk = build_export_cache_lookup(cache_path2.clone(), key2);
        if (chunk.len == 0) {
            chunk = build_extract_exports(obj_path2.clone());
            if (chunk == "|ERR|") { return "|ERR|"; }
            if (chunk.len > 0) {
                if (build_export_cache_store(cache_path2, key2, chunk.clone()) != 0) {
                    build_log(build_error_label() + ": cannot publish export cache for " + obj_path2);
                    return "|ERR|";
                }
            }
        }
        if (chunk.len == 0) {
            build_log(build_error_label() + ": export scan produced no cache entry for " + obj_path2);
            return "|ERR|";
        }
        // Drop the leading "EXPORTS\r\n" of each chunk; keep the body.
        if (chunk.startsWith("EXPORTS\r\n")) {
            let body = chunk.substring(9, chunk.len);
            combined_def = combined_def + body;
            export_lines = export_lines + build_line_count(body);
        }
        j = j + 1;
    }
    var def_dir = cache_dir;
    if (def_dir.len == 0) { def_dir = ".cache"; }
    let def_path = build_join_path(def_dir, build_path_stem(output_path) + ".def");
    if (build_publish_text_file(def_path.clone(), combined_def.clone()) != 0) {
        build_log(build_error_label() + ": cannot publish export definition file: " + def_path);
        return "|ERR|";
    }
    if (build_profile_enabled()) {
        profile_mark = build_profile_mark("export-scan combine " + target_name
                                          + " exports=" + export_lines.toString(),
                                          profile_mark);
        build_profile_mark("export-scan total " + target_name, profile_start);
    }
    return def_path;
}

fn build_expand_cgu_object_lists(objects: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(objects.clone());
    while (i < n) {
        let obj = build_line_at(objects.clone(), i);
        let list_path = obj.clone() + ".cgu.list";
        if (fileExists(list_path.clone())) {
            let listed = readFile(list_path.clone());
            out = out + listed;
            if (listed.len > 0 && !listed.endsWith("\n")) { out = out + "\n"; }
        } else if (obj.len > 0) {
            out = out + obj + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn build_link_command(kind: string,
                      output_path: string,
                      objects: string,
                      lib_paths: string,
                      libs: string,
                      need_runtime: bool,
                      ar: string,
                      target_name: string,
                      cache_dir: string,
                      jobs: i32) -> string {
    var obj_args: string = "";
    var i: i64 = 0;
    let n = build_line_count(objects.clone());
    while (i < n) {
        let obj_line = build_line_at(objects.clone(), i);
        let quoted_obj = build_quote(obj_line.clone());
        obj_args = obj_args.clone() + " ";
        obj_args = obj_args.clone() + quoted_obj.clone();
        i = i + 1;
    }
    if (kind == "static" || kind == "staticlib") {
        var ar_tool = ar;
        if (ar_tool.len == 0) { ar_tool = build_tool_path("llvm-ar"); }
        let ar_tool_arg = build_tool_arg(ar_tool.clone());
        let quoted_output = build_quote(output_path.clone());
        var ar_cmd = ar_tool_arg.clone() + " rcs ";
        ar_cmd = ar_cmd.clone() + quoted_output.clone();
        ar_cmd = ar_cmd.clone() + obj_args.clone();
        return ar_cmd;
    }
    let cxx_linker = build_tool_path("clang++");
    var cmd = build_tool_arg(cxx_linker.clone());
    var def_flag: string = "";
    if (build_effective_is_windows()) {
        var link_threads = build_parse_int(build_env_value("VYX_LINK_THREADS"));
        if (link_threads <= 0) { link_threads = vyx_bootstrap_hw_threads(); }
        if (link_threads < 1) { link_threads = 1; }
        cmd = cmd.clone() + " -fuse-ld=lld -Wl,/timestamp:0";
        if (link_threads > 1) {
            let thread_arg = " -Wl,/threads:" + link_threads.toString();
            cmd = cmd.clone() + thread_arg.clone();
        }
    }
    if (build_effective_is_windows() && (kind == "executable" || kind == "exe")) {
        cmd = cmd.clone() + " -Wl,/subsystem:console -Wl,/stack:67108864";
    }
    if (kind == "shared" || kind == "dylib") {
        cmd = cmd.clone() + " -shared";
    }
    if (build_effective_is_linux() && (kind == "executable" || kind == "exe")) {
        cmd = cmd.clone() + " -no-pie";
    }
    if (build_effective_is_android()
        && (kind == "executable" || kind == "exe"
            || kind == "shared" || kind == "dylib")) {
        cmd = cmd.clone() + " -nostdlib++";
    }
    if (build_effective_is_windows() && (kind == "shared" || kind == "dylib")) {
        // Generate a .def file by scanning obj symbols. Without this lld-link
        // produces an empty import lib because there's no dllexport metadata.
        let def_path = build_generate_def_file(target_name.clone(), output_path.clone(), objects.clone(), cache_dir.clone(), jobs);
        if (def_path == "|ERR|") { return "|ERR|"; }
        def_flag = " -Wl,/def:" + build_quote(def_path);
        let implib_path = build_link_aux_output_path(kind.clone(), output_path.clone());
        let implib_arg = " -Wl,/implib:" + build_quote(implib_path.clone());
        cmd = cmd.clone() + implib_arg.clone();
    }
    let link_passthrough = build_cli_link_passthrough();
    let quoted_final_output = build_quote(output_path.clone());
    let lib_link_args = build_link_args(lib_paths.clone(),
                                        libs.clone(),
                                        need_runtime,
                                        target_name.clone());
    if (lib_link_args == "|ERR|") { return "|ERR|"; }
    var final_cmd = cmd.clone() + obj_args.clone();
    final_cmd = final_cmd.clone() + " ";
    final_cmd = final_cmd.clone() + link_passthrough.clone();
    final_cmd = final_cmd.clone() + " -O2 -o ";
    final_cmd = final_cmd.clone() + quoted_final_output.clone();
    final_cmd = final_cmd.clone() + def_flag.clone();
    final_cmd = final_cmd.clone() + lib_link_args.clone();
    return final_cmd;
}

/// Native linkers accept response files. Keep the full command in the cache
/// record, but execute a short `tool @file` command once the argument list
/// would approach Windows' process-command-line limit (or contains many objs).
fn build_link_response_command(command: string, objects: string,
                               cache_dir: string, target_name: string) -> string {
    if (command.len < 8192 && build_line_count(objects.clone()) < 64) {
        return command;
    }
    var split: i32 = 0;
    if (command.startsWith("\"")) {
        split = 1;
        while (split < command.len && command.charAt(split) != 34) {
            split = split + 1;
        }
        if (split >= command.len) { return "|ERR|"; }
        split = split + 1;
    } else {
        while (split < command.len && command.charAt(split) != 32
               && command.charAt(split) != 9) {
            split = split + 1;
        }
    }
    let tool = command.substring(0, split);
    var args = command.substring(split, command.len).trim();
    if (tool.len == 0 || args.len == 0) { return "|ERR|"; }
    // LLVM's response-file parser treats a backslash as an escape, including
    // in Windows object paths. Forward slashes are accepted by clang/lld and
    // preserve the original argument after response-file tokenization.
    if (build_is_windows()) { args = args.replace("\\", "/"); }
    let rsp_path = build_join_path(cache_dir.clone(),
                                   build_safe_obj_name("link_" + target_name, ".rsp"));
    build_ensure_parent(rsp_path.clone());
    if (writeFile(rsp_path.clone(), args + "\n") != 0) { return "|ERR|"; }
    return tool + " @" + build_quote(rsp_path);
}

fn build_library_interfaces_stale(target_name: string, output_dir: string,
                                  entry: string, sources: string,
                                  linked_output: string) -> bool {
    let linked_mtime = build_file_mtime(linked_output);
    var seen_groups: string = "";
    var i: i64 = 0;
    let n = build_line_count(sources.clone());
    while (i < n) {
        let src = build_line_at(sources.clone(), i).trim();
        if (build_source_kind(src.clone()) == "vyx") {
            let group = build_source_group_key(src.clone());
            if (!build_group_key_seen(seen_groups.clone(), group.clone())) {
                seen_groups = seen_groups + group + "\n";
                let vyi = build_vyi_source_output_path(target_name.clone(), output_dir.clone(),
                                                       entry.clone(), src.clone());
                if (!fileExists(vyi.clone()) || build_file_mtime(vyi) < linked_mtime) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

fn build_bin_u8_at(data: rawptr, size: i64, index: i64) -> i64 {
    if (data == null || index < 0 || index >= size) { return 0; }
    var byte: i32 = 0;
    memcpy(to_rawptr(&byte), data + index, 1);
    return (byte & 255) as i64;
}

fn build_bin_u16_at(data: rawptr, size: i64, index: i64) -> i64 {
    if (index < 0 || index + 1 >= size) { return 0; }
    return build_bin_u8_at(data, size, index) | (build_bin_u8_at(data, size, index + 1) << 8);
}

fn build_bin_u32_at(data: rawptr, size: i64, index: i64) -> i64 {
    if (index < 0 || index + 3 >= size) { return 0; }
    return build_bin_u8_at(data, size, index)
        | (build_bin_u8_at(data, size, index + 1) << 8)
        | (build_bin_u8_at(data, size, index + 2) << 16)
        | (build_bin_u8_at(data, size, index + 3) << 24);
}

fn build_bin_set_u32(data: rawptr, size: i64, index: i64, value: i64) {
    if (data == null || index < 0 || index + 3 >= size) { return; }
    var b0: i32 = (value & 255) as i32;
    var b1: i32 = ((value >> 8) & 255) as i32;
    var b2: i32 = ((value >> 16) & 255) as i32;
    var b3: i32 = ((value >> 24) & 255) as i32;
    memcpy(data + index, to_rawptr(&b0), 1);
    memcpy(data + index + 1, to_rawptr(&b1), 1);
    memcpy(data + index + 2, to_rawptr(&b2), 1);
    memcpy(data + index + 3, to_rawptr(&b3), 1);
}

fn build_pe_zero_cstr(data: rawptr, size: i64, off: i64) {
    if (off < 0 || off >= size) { return; }
    var end = off;
    while (end < size && build_bin_u8_at(data, size, end) != 0) {
        end = end + 1;
    }
    if (end > off) {
        memset(data + off, 0, end - off);
    }
}

fn build_pe_rva_to_off(data: rawptr, size: i64, sec_off: i64, nsec: i64, rva: i64) -> i64 {
    if (rva <= 0 || nsec <= 0) { return -1; }
    var i: i64 = 0;
    while (i < nsec) {
        let s = sec_off + i * 40;
        if (s + 39 >= size) { return -1; }
        let vsz = build_bin_u32_at(data, size, s + 8);
        let va = build_bin_u32_at(data, size, s + 12);
        let rawsz = build_bin_u32_at(data, size, s + 16);
        let raw = build_bin_u32_at(data, size, s + 20);
        var span = vsz;
        if (rawsz > span) { span = rawsz; }
        if (rva >= va && rva < va + span) {
            let off = raw + (rva - va);
            if (off >= 0 && off < size) { return off; }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}

fn build_pe_strip_export_names(path: string) -> i32 {
    let file = File.open(path, FileOptions { read: true, write: false, create: false, truncate: false, binary: true });
    if (!file.is_open()) { return 1; }
    var bytes = file.read_all_bytes();
    if (file.close() != 0) {
        bytes.destroy();
        return 1;
    }
    let size = bytes.len;
    let data = bytes.data;
    if (data == null || size < 64
        || build_bin_u8_at(data, size, 0) != 77
        || build_bin_u8_at(data, size, 1) != 90) {
        bytes.destroy();
        return 0;
    }
    let e_lfanew = build_bin_u32_at(data, size, 60);
    if (e_lfanew < 64 || e_lfanew + 24 >= size
        || build_bin_u8_at(data, size, e_lfanew) != 80
        || build_bin_u8_at(data, size, e_lfanew + 1) != 69
        || build_bin_u8_at(data, size, e_lfanew + 2) != 0
        || build_bin_u8_at(data, size, e_lfanew + 3) != 0) {
        bytes.destroy();
        return 0;
    }
    let coff = e_lfanew + 4;
    let nsec = build_bin_u16_at(data, size, coff + 2);
    let optsz = build_bin_u16_at(data, size, coff + 16);
    let opt = coff + 20;
    if (nsec <= 0 || nsec > 96 || optsz < 96 || opt + optsz > size) {
        bytes.destroy();
        return 0;
    }
    let magic = build_bin_u16_at(data, size, opt);
    var dd: i64 = 0;
    if (magic == 523) {
        dd = opt + 112;
    } else if (magic == 267) {
        dd = opt + 96;
    } else {
        bytes.destroy();
        return 0;
    }
    if (dd + 8 > size) {
        bytes.destroy();
        return 0;
    }
    let exp_rva = build_bin_u32_at(data, size, dd);
    let exp_sz = build_bin_u32_at(data, size, dd + 4);
    if (exp_rva == 0 || exp_sz == 0) {
        bytes.destroy();
        return 0;
    }
    let sec_off = opt + optsz;
    let exp_off = build_pe_rva_to_off(data, size, sec_off, nsec, exp_rva);
    if (exp_off >= 0 && exp_off + 40 <= size) {
        let nnames = build_bin_u32_at(data, size, exp_off + 24);
        let dll_rva = build_bin_u32_at(data, size, exp_off + 12);
        let names_rva = build_bin_u32_at(data, size, exp_off + 32);
        build_pe_zero_cstr(data, size, build_pe_rva_to_off(data, size, sec_off, nsec, dll_rva));
        let names_off = build_pe_rva_to_off(data, size, sec_off, nsec, names_rva);
        if (names_off >= 0 && nnames > 0 && nnames <= 65536) {
            var i: i64 = 0;
            while (i < nnames) {
                let nrva = build_bin_u32_at(data, size, names_off + i * 4);
                build_pe_zero_cstr(data, size, build_pe_rva_to_off(data, size, sec_off, nsec, nrva));
                i = i + 1;
            }
        }
        memset(data + exp_off, 0, 40);
    }
    build_bin_set_u32(data, size, dd, 0);
    build_bin_set_u32(data, size, dd + 4, 0);
    let out = File.open(path, FileOptions { read: false, write: true, create: true, truncate: true, binary: true });
    if (!out.is_open()) {
        bytes.destroy();
        return 1;
    }
    if (out.write_all(bytes) != 0) {
        out.close();
        return 1;
    }
    if (out.close() != 0) { return 1; }
    return 0;
}

fn build_kind_is_executable(kind: string) -> bool {
    return kind == "executable" || kind == "exe";
}

fn build_is_compiler_tool_target(name: string) -> bool {
    return name == "boot" || name == "vyxc" || name == "vyxc-lsp" || name == "vyxc-dap";
}

fn build_flags_request_release_strip(vyxflags: string, passthrough: string) -> bool {
    let flags = " " + vyxflags + " " + passthrough + " ";
    if (build_contains(flags, " -g")
        || build_contains(flags, "-g ")
        || build_contains(flags, "--debug")) {
        return false;
    }
    return build_contains(flags, "-O2")
        || build_contains(flags, "-O3")
        || build_contains(flags, "-Os")
        || build_contains(flags, "-Oz");
}

fn build_should_strip_executable(kind: string,
                                 target_name: string,
                                 vyxflags: string,
                                 passthrough: string,
                                 strip_setting: string) -> bool {
    if (!build_kind_is_executable(kind)) { return false; }
    if (build_is_compiler_tool_target(target_name)) { return false; }
    if (build_bool_disabled(strip_setting)) { return false; }
    if (build_bool_enabled(strip_setting)) { return true; }
    return build_flags_request_release_strip(vyxflags, passthrough);
}

fn build_llvm_strip_command(output_path: string) -> string {
    let strip = build_tool_path("llvm-strip");
    if (strip.len == 0) { return ""; }
    return build_tool_arg(strip) + " --strip-all " + build_quote(output_path);
}

public fn build_exe_strip_link_flags(cache_dir: string) -> string {
    if (build_effective_is_windows()) {
        return " -Wl,/OPT:REF -Wl,/OPT:ICF";
    }
    if (build_effective_is_apple()) {
        return " -Wl,-dead_strip";
    }
    if (build_effective_is_linux() || build_effective_is_android()) {
        var dir = cache_dir;
        if (dir.len == 0) { dir = "."; }
        build_make_dir(dir.clone());
        let ver = build_join_path(dir, "exe_strip.local.ver");
        if (writeFile(ver.clone(), "{\n  local:\n    *;\n};\n") != 0) {
            return "|ERR|";
        }
        return " -Wl,--gc-sections -Wl,-s -Wl,--version-script=" + build_quote(ver);
    }
    return "";
}

public fn build_strip_linked_executable(output_path: string) -> i32 {
    if (output_path.len == 0 || !fileExists(output_path.clone())) { return 1; }
    let host = build_host_path(output_path);
    if (build_pe_strip_export_names(host.clone()) != 0) { return 1; }
    let cmd = build_llvm_strip_command(host);
    if (cmd.len == 0) {
        print(build_error_label() + ": llvm-strip not found");
        return 1;
    }
    let rc = build_run_process(cmd, "", "", "");
    if (rc != 0) {
        print(build_error_label() + ": llvm-strip failed for " + output_path
              + " (exit " + rc.toString() + ")");
        return 1;
    }
    return 0;
}

fn build_link_aux_output_path(kind: string, output_path: string) -> string {
    if (build_effective_is_windows() && (kind == "shared" || kind == "dylib")) {
        return build_join_path(build_dirname(output_path.clone()),
                               build_path_stem(output_path) + ".lib");
    }
    return "";
}

fn build_cuda_manifest_value(manifest: string, section: string, key: string) -> string {
    let target_value = build_toml_get_platform_value(manifest.clone(), section.clone(), key.clone()).trim();
    if (target_value.len > 0) { return target_value; }
    return build_toml_get_platform_value(manifest.clone(), "cuda", key.clone()).trim();
}

fn build_cuda_manifest_array(manifest: string, section: string, key: string) -> string {
    let target_value = build_toml_get_platform_array(manifest.clone(), section.clone(), key.clone()).trim();
    if (target_value.len > 0 && target_value != "[]") { return target_value; }
    return build_toml_get_platform_array(manifest.clone(), "cuda", key.clone()).trim();
}

fn build_cuda_arch_is_valid(arch: string) -> bool {
    if (arch.len < 4 || !arch.startsWith("sm_")) { return false; }
    var i: i32 = 3;
    while (i < arch.len) {
        let c = arch.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return i > 3;
}

fn build_cuda_text_greater(lhs: string, rhs: string) -> bool {
    var i: i32 = 0;
    while (i < lhs.len && i < rhs.len) {
        let lc = lhs.charAt(i);
        let rc = rhs.charAt(i);
        if (lc != rc) { return lc > rc; }
        i = i + 1;
    }
    return lhs.len > rhs.len;
}

fn build_cuda_selected_arch(manifest: string, section: string) -> string {
    var arch = build_cuda_manifest_value(manifest.clone(), section.clone(), "cuda_arch");
    if (arch.len == 0) {
        arch = build_cuda_manifest_value(manifest.clone(), section.clone(), "arch");
    }
    if (arch.len == 0) { return "sm_120"; }
    if (!build_cuda_arch_is_valid(arch)) { return "|ERR|"; }
    return arch;
}

fn build_cuda_device_sources(manifest: string, section: string) -> string {
    var raw = build_cuda_manifest_array(manifest.clone(), section.clone(), "cuda_device_sources");
    if (raw.len == 0 || raw == "[]") {
        raw = build_cuda_manifest_array(manifest.clone(), section.clone(), "device_sources");
    }
    if (raw.len == 0 || raw == "[]") { return ""; }
    return toml_array_to_lines(build_expand_env(raw));
}

fn build_cuda_latest_toolkit_root() -> string {
    if (!build_effective_is_windows()) { return ""; }
    let parent = "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA";
    if (!isDir(parent)) { return ""; }
    build_make_dir(".cache");
    let tmp = build_join_path(".cache", "cuda_toolkit_dirs.tmp");
    deleteFile(tmp.clone());
    if (vyx_bootstrap_list_dirs(build_host_path(parent).c_str(),
                                build_host_path(tmp.clone()).c_str()) != 0) {
        deleteFile(tmp.clone());
        return "";
    }
    let rows = readFile(tmp.clone());
    deleteFile(tmp);
    var best = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            var line = rows.substring(start, i).trim();
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1).trim(); }
            if (line.len > 0) {
                let lib = build_join_path(build_join_path(line.clone(), "lib"), "x64\\cuda.lib");
                if (fileExists(lib.clone()) && build_cuda_text_greater(line.clone(), best.clone())) { best = line; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return best;
}

fn build_cuda_toolkit_root() -> string {
    let configured = build_env_value("VYX_CUDA_TOOLKIT_ROOT").trim();
    if (configured.len > 0 && isDir(configured.clone())) { return configured; }
    return build_cuda_latest_toolkit_root();
}

fn build_cuda_import_library(root: string) -> string {
    if (root.len == 0) { return ""; }
    if (build_effective_is_windows()) {
        let windows_lib = build_join_path(build_join_path(root.clone(), "lib"), "x64\\cuda.lib");
        if (fileExists(windows_lib.clone())) { return windows_lib; }
    }
    let stubs = build_join_path(build_join_path(root.clone(), "lib64"), "stubs");
    let so = build_join_path(stubs.clone(), "libcuda.so");
    if (fileExists(so.clone())) { return so; }
    return "";
}

fn build_cuda_type_token(raw: string) -> string {
    let text = raw.trim();
    if (text == "i8" || text == "u8" || text == "i16" || text == "u16"
        || text == "i32" || text == "u32" || text == "i64" || text == "u64"
        || text == "f32" || text == "f64" || text == "bool") {
        return text;
    }
    if (text.startsWith("*")) {
        let inner = build_cuda_type_token(text.substring(1, text.len));
        if (inner == "|ERR|") { return "|ERR|"; }
        return "ptr<" + inner + ">";
    }
    return "|ERR|";
}

fn build_cuda_type_size(token: string) -> i32 {
    if (token.startsWith("ptr<")) { return 16; }
    if (token == "i8" || token == "u8" || token == "bool") { return 1; }
    if (token == "i16" || token == "u16") { return 2; }
    if (token == "i32" || token == "u32" || token == "f32") { return 4; }
    if (token == "i64" || token == "u64" || token == "f64") { return 8; }
    return 0;
}

fn build_cuda_align_up(value: i32, align: i32) -> i32 {
    if (align <= 1) { return value; }
    let rem = value % align;
    if (rem == 0) { return value; }
    return value + (align - rem);
}

fn build_cuda_hex_digit(value: i32) -> string {
    let hex = "0123456789ABCDEF";
    if (value < 0 || value >= hex.len) { return "0"; }
    return hex.substring(value, value + 1);
}

fn build_cuda_c_escape(text: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 92) {
            out = out + "\\\\";
        } else if (c == 34) {
            out = out + "\\\"";
        } else if (c == 10) {
            out = out + "\\n";
        } else if (c == 13) {
            out = out + "\\r";
        } else if (c == 9) {
            out = out + "\\t";
        } else if (c >= 32 && c <= 126) {
            out = out + text.substring(i, i + 1);
        } else {
            out = out + "\\x" + build_cuda_hex_digit((c >> 4) & 15) + build_cuda_hex_digit(c & 15);
        }
        i = i + 1;
    }
    return out;
}

fn build_cuda_kernel_rows(src: string) -> string {
    if (!fileExists(src.clone())) { return "|ERR|"; }
    let text = readFile(src.clone());
    var out = "";
    var pending = false;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var line = text.substring(start, i);
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1); }
            let trimmed = line.trim();
            if (trimmed.startsWith("//")) {
                pending = false;
            } else if (build_contains(trimmed.clone(), "@[cuda_kernel]")) {
                pending = true;
            } else if (pending) {
                let name = build_any_fn_name_from_line(trimmed.clone());
                if (name.len > 0) {
                    let open = trimmed.indexOf("(");
                    let close = trimmed.indexOf(")");
                    if (open < 0 || close < open) { return "|ERR|"; }
                    let params = trimmed.substring(open + 1, close).trim();
                    var tokens = "";
                    var sizes = "";
                    var offsets = "";
                    var symbol = "__vyx_F_" + policy_mangle_part(name.clone()) + "_R_void_P";
                    var cursor: i32 = 0;
                    var count: i32 = 0;
                    if (params.len > 0) {
                        var pstart: i32 = 0;
                        var pi: i32 = 0;
                        while (pi <= params.len) {
                            if (pi == params.len || params.charAt(pi) == 44) {
                                let item = params.substring(pstart, pi).trim();
                                let colon = item.indexOf(":");
                                if (item.len == 0 || colon < 0) { return "|ERR|"; }
                                let token = build_cuda_type_token(item.substring(colon + 1, item.len));
                                let size = build_cuda_type_size(token);
                                if (token == "|ERR|" || size <= 0) { return "|ERR|"; }
                                cursor = build_cuda_align_up(cursor, size);
                                if (count > 0) {
                                    tokens = tokens + ",";
                                    sizes = sizes + ",";
                                    offsets = offsets + ",";
                                }
                                tokens = tokens + token;
                                symbol = symbol + "_" + policy_mangle_part(token.clone());
                                sizes = sizes + size.toString();
                                offsets = offsets + cursor.toString();
                                cursor = cursor + size;
                                count = count + 1;
                                pstart = pi + 1;
                            }
                            pi = pi + 1;
                        }
                    }
                    if (count == 0) { symbol = symbol + "_0"; }
                    out = out + name + "\t" + symbol + "\t" + count.toString()
                          + "\t" + cursor.toString() + "\t" + tokens + "\t"
                          + sizes + "\t" + offsets + "\n";
                    pending = false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_cuda_embed_source(ptx: string, kernels: string, arch: string) -> string {
    var out = "module vyx_cuda_embed;\n\n";
    out = out + "public fn vyx_cuda_arch() -> string { return \"" + arch + "\"; }\n";
    out = out + "public fn vyx_cuda_ptx() -> string { return \""
          + build_cuda_c_escape(ptx) + "\"; }\n";
    var i: i64 = 0;
    let n = build_line_count(kernels.clone());
    while (i < n) {
        let row = build_line_at(kernels.clone(), i);
        if (row.len > 0) {
            let name = build_field(row.clone(), 0);
            let symbol = build_field(row.clone(), 1);
            let count = build_field(row.clone(), 2);
            let bytes = build_field(row.clone(), 3);
            let types = build_field(row.clone(), 4);
            let sizes = build_field(row.clone(), 5);
            let offsets = build_field(row, 6);
            out = out + "public fn vyx_cuda_kernel_" + name + "_symbol() -> string { return \""
                  + symbol + "\"; }\n";
            out = out + "public fn vyx_cuda_kernel_" + name + "_count() -> i32 { return "
                  + count + "; }\n";
            out = out + "public fn vyx_cuda_kernel_" + name + "_bytes() -> i32 { return "
                  + bytes + "; }\n";
            out = out + "public fn vyx_cuda_kernel_" + name + "_types() -> string { return \""
                  + types + "\"; }\n";
            out = out + "public fn vyx_cuda_kernel_" + name + "_sizes() -> string { return \""
                  + sizes + "\"; }\n";
            out = out + "public fn vyx_cuda_kernel_" + name + "_offsets() -> string { return \""
                  + offsets + "\"; }\n";
        }
        i = i + 1;
    }
    return out;
}

fn build_cuda_prepare_device(manifest: string,
                             section: string,
                             target_name: string,
                             self_exe: string,
                             cache_dir: string,
                             cache_text: string,
                             cache_index: string,
                             records_path: string,
                             output_path: string,
                             opt_args: string) -> string {
    let sources = build_cuda_device_sources(manifest.clone(), section.clone());
    if (sources.len == 0) { return ""; }
    let arch = build_cuda_selected_arch(manifest.clone(), section.clone());
    if (arch == "|ERR|") {
        print(build_error_label() + ": invalid CUDA architecture in Vyx.toml; expected sm_<digits>");
        return "|ERR|";
    }
    let toolkit = build_cuda_toolkit_root();
    let cuda_lib = build_cuda_import_library(toolkit.clone());
    if (cuda_lib.len == 0) {
        print(build_error_label() + ": CUDA toolkit or cuda import library not found");
        print("  set VYX_CUDA_TOOLKIT_ROOT, or install a toolkit containing lib/x64/cuda.lib");
        return "|ERR|";
    }
    var stamp = "cuda_arch=" + arch + ";cuda_lib=" + build_file_content_stamp(cuda_lib.clone()) + ";";
    var kernels = "";
    var si: i64 = 0;
    let sn = build_line_count(sources.clone());
    while (si < sn) {
        let src = build_line_at(sources.clone(), si).trim();
        if (src.len > 0) {
            if (!fileExists(src.clone())) {
                print(build_error_label() + ": CUDA device source not found: " + src);
                return "|ERR|";
            }
            let rows = build_cuda_kernel_rows(src.clone());
            if (rows == "|ERR|") {
                print(build_error_label() + ": unsupported CUDA kernel signature in " + src);
                print("  supported scalar and pointer parameters must stay on one line");
                return "|ERR|";
            }
            if (rows.len == 0) {
                print(build_error_label() + ": CUDA device source has no @[cuda_kernel]: " + src);
                return "|ERR|";
            }
            kernels = kernels + rows;
            stamp = stamp + "device=" + src + "=" + build_file_content_stamp(src.clone()) + ";";
        }
        si = si + 1;
    }
    var root_names = "";
    var kernel_index: i64 = 0;
    let kernel_count = build_line_count(kernels.clone());
    while (kernel_index < kernel_count) {
        let name = build_field(build_line_at(kernels.clone(), kernel_index), 0);
        if (name.len > 0) {
            if (root_names.len > 0) { root_names = root_names + ","; }
            root_names = root_names + name;
        }
        kernel_index = kernel_index + 1;
    }
    let ptx_path = build_join_path(cache_dir.clone(),
                                   build_safe_obj_name("cuda_" + target_name.clone(), ".ptx"));
    let embed_path = build_join_path(cache_dir.clone(),
                                     build_safe_obj_name("cuda_" + target_name.clone(), "_embed.vyx"));
    let cmd = build_tool_arg(self_exe.clone()) + " --emit=obj --src=file "
              + build_quote(build_line_at(sources.clone(), 0))
              + " -o " + build_quote(build_task_tmp_output(ptx_path.clone()))
              + " --target=nvptx64-nvidia-cuda --target-cpu " + build_quote(arch)
              + " --export-root-names " + build_quote_arg(root_names)
              + opt_args;
    let record = build_cache_record("vyx",
                                    "cuda:" + target_name.clone(),
                                    ptx_path.clone(),
                                    cmd.clone(),
                                    self_exe.clone(),
                                    output_path.clone(),
                                    sources.clone(),
                                    stamp,
                                    false,
                                    "",
                                    "");
    appendFile(records_path.clone(), record + "\n");
    if (!build_cache_has_indexed(cache_text, cache_index, record, ptx_path)
        || !fileExists(embed_path.clone())) {
        print(build_progress_label("cuda", 1) + " " + build_status_compile()
              + " " + build_path_label(build_line_at(sources.clone(), 0))
              + " -> " + build_path_label(ptx_path.clone()));
        build_ensure_parent(ptx_path.clone());
        let log_out = ptx_path.clone() + ".compile.out.log";
        let log_err = ptx_path.clone() + ".compile.err.log";
        let rc = build_run_process(cmd.clone(), "", log_out.clone(), log_err.clone());
        if (rc != 0 || !build_finalize_task_output(ptx_path.clone())) {
            print(build_error_label() + ": CUDA device compilation failed (exit " + rc.toString() + ")");
            if (fileExists(log_err.clone())) { print(readFile(log_err.clone())); }
            if (fileExists(log_out.clone())) { print(readFile(log_out.clone())); }
            return "|ERR|";
        }
        let ptx = readFile(ptx_path.clone());
        var ptx_kernel_index: i64 = 0;
        while (ptx_kernel_index < kernel_count) {
            let row = build_line_at(kernels.clone(), ptx_kernel_index);
            if (row.len > 0) {
                let symbol = build_field(row, 1);
                if (!build_contains(ptx.clone(), ".visible .entry " + symbol + "(")) {
                    print(build_error_label() + ": generated PTX does not contain CUDA kernel entry `" + symbol + "`");
                    return "|ERR|";
                }
            }
            ptx_kernel_index = ptx_kernel_index + 1;
        }
        if (writeFile(embed_path.clone(), build_cuda_embed_source(ptx, kernels.clone(), arch)) != 0) {
            print(build_error_label() + ": cannot write embedded CUDA source: " + embed_path);
            return "|ERR|";
        }
    }
    return embed_path + "\n" + cuda_lib;
}

fn build_link_is_cached(cache: string,
                        record: string,
                        output_path: string,
                        aux_output_path: string,
                        objects: string) -> bool {
    if (!fileExists(output_path)) { return false; }
    if (fileSize(output_path) < 64) { return false; }
    if (aux_output_path.len > 0
        && (!fileExists(aux_output_path.clone()) || fileSize(aux_output_path) < 64)) {
        return false;
    }
    if (!build_contains("\n" + cache, "\n" + record + "\n")) { return false; }
    let out_mtime = build_file_mtime(output_path);
    if (out_mtime < 0) { return false; }
    var aux_mtime: i64 = out_mtime;
    if (aux_output_path.len > 0) {
        aux_mtime = build_file_mtime(aux_output_path);
        if (aux_mtime < 0) { return false; }
    }
    var i: i64 = 0;
    let n = build_line_count(objects);
    while (i < n) {
        let obj = build_line_at(objects, i);
        let mt = build_file_mtime(obj);
        if (mt < 0 || mt > out_mtime || mt > aux_mtime) { return false; }
        i = i + 1;
    }
    return true;
}

fn build_restore_link_output(output_path: string,
                             old_output: string,
                             had_old_output: bool) -> i32 {
    var errors: i32 = 0;
    if (fileExists(output_path.clone()) && deleteFile(output_path.clone()) != 0) {
        errors = errors + 1;
    }
    if (had_old_output && renameFile(old_output, output_path) != 0) {
        errors = errors + 1;
    }
    return errors;
}

fn build_restore_link_outputs(output_path: string,
                              old_output: string,
                              had_old_output: bool,
                              aux_output_path: string,
                              old_aux_output: string,
                              had_old_aux_output: bool) -> i32 {
    var errors = build_restore_link_output(output_path, old_output, had_old_output);
    if (aux_output_path.len > 0) {
        errors = errors + build_restore_link_output(aux_output_path,
                                                    old_aux_output,
                                                    had_old_aux_output);
    }
    return errors;
}

fn build_one_target(manifest: string,
                    cache_path: string,
                    cache_text: string,
                    pkg_name: string,
                    pkg_entry: string,
                    build_output_dir: string,
                    build_cache_dir: string,
                    section: string,
                    jobs: i32) -> string {
    var target_name = build_target_name(section.clone(), pkg_name.clone());
    let cache_index = build_cache_digest_index(cache_text.clone());
    var target_profile_total: i64 = 0;
    var target_profile_mark: i64 = 0;
    if (build_profile_enabled()) {
        target_profile_total = vyx_bootstrap_now_ms();
        target_profile_mark = target_profile_total;
        build_profile_log("target " + target_name + " start jobs=" + jobs.toString());
    }
    var target_kind = build_toml_get_platform_value(manifest.clone(), section.clone(), "type");
    var target_link_kind = target_kind.clone();
    if (target_link_kind.len == 0) {
        if (build_manifest_is_zyn_app(manifest.clone()) && build_effective_is_android()) {
            target_link_kind = "shared";
        } else {
            target_link_kind = "executable";
        }
    }
    var entry = build_toml_get_platform_value(manifest.clone(), section.clone(), "entry");
    var output_dir = build_toml_get_platform_value(manifest.clone(), section.clone(), "output_dir");
    if (output_dir.len == 0) {
        output_dir = build_toml_get_platform_value(manifest.clone(), section.clone(), "out_dir");
    }
    let output_aliases_raw = build_toml_get_platform_array(manifest.clone(), section.clone(), "output_aliases");
    let mir2cpp_entry = build_toml_get_platform_value(manifest.clone(), section.clone(), "mir2cpp_entry");
    let src_raw = build_toml_get_platform_array(manifest.clone(), section.clone(), "sources");
    let interface_src_raw = build_toml_get_platform_array(manifest.clone(), section.clone(), "interface_sources");
    let auto_excludes_raw = build_toml_get_platform_array(manifest.clone(), section.clone(), "auto_source_excludes");
    var libs = build_toml_get_triplet_link_array(manifest.clone(), section.clone(), "libs", target_link_kind.clone());
    var lib_paths = build_toml_get_triplet_link_array(manifest.clone(), section.clone(), "lib_paths", target_link_kind.clone());
    lib_paths = build_merge_toml_arrays(lib_paths, build_auto_triplet_lib_paths(target_link_kind));
    lib_paths = build_expand_env(lib_paths);
    let include_paths = build_toml_get_platform_array(manifest.clone(), section.clone(), "include_paths");
    var parallel_vyx_raw = build_toml_get_platform_value(manifest.clone(), section.clone(), "parallel_vyx");
    if (parallel_vyx_raw.len == 0) {
        parallel_vyx_raw = build_toml_get_platform_value(manifest.clone(), "build", "parallel_vyx");
    }
    // `parallel_vyx` controls scheduling of independent source/interface
    // units.  MIR root partitioning starts a fresh compiler process for every
    // root chunk and therefore has a separate, explicit opt-in switch.  Keep
    // the two policies independent so enabling ordinary build parallelism
    // cannot silently multiply front-end work for a large translation unit.
    var mir_partition_raw = build_toml_get_platform_value(manifest.clone(), section.clone(), "mir_partition");
    if (mir_partition_raw.len == 0) {
        mir_partition_raw = build_toml_get_platform_value(manifest.clone(), "build", "mir_partition");
    }
    var auto_sources_raw = build_toml_get_platform_value(manifest.clone(), section.clone(), "auto_sources");
    if (auto_sources_raw.len == 0) {
        auto_sources_raw = build_toml_get_platform_value(manifest.clone(), "build", "auto_sources");
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " manifest fields");
    }

    // Auto-inject lib_paths and libs from [dependencies]
    let raw_deps_for_target = build_collect_dependencies_for_target(manifest.clone(), section.clone());
    if (raw_deps_for_target == "|ERR|") { return "|ERR|"; }
    let deps_for_target = build_resolve_dependencies(raw_deps_for_target);
    if (deps_for_target == "|ERR|") { return "|ERR|"; }
    let dependency_vyi_stamp = build_dependencies_vyi_stamp(deps_for_target.clone());
    if (dependency_vyi_stamp == "|ERR|") { return "|ERR|"; }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " deps stamp");
    }
    var dependency_sources_raw: string = "";
    var di_t: i64 = 0;
    let dn_t = build_line_count(deps_for_target.clone());
    while (di_t < dn_t) {
        let dline = build_line_at(deps_for_target.clone(), di_t);
        let dname = build_field(dline.clone(), 0);
        let dpath = build_field(dline.clone(), 1);
        let target_name = build_field(dline.clone(), 2);
        let target_kind = build_field(dline.clone(), 3);
        let target_output_dir = build_field(dline.clone(), 4);
        let dep_public_paths = build_field(dline.clone(), 5);
        let dep_public_libs = build_field(dline.clone(), 6);
        let dep_sources = build_field(dline.clone(), 7);
        let dependency_usage = build_field(dline, 8);
        if (dname.len > 0 && dpath.len > 0
            && target_name.len > 0 && target_output_dir.len > 0
            && dependency_usage != "build") {
            if (target_kind == "source") {
                dependency_sources_raw = build_merge_toml_arrays(dependency_sources_raw, dep_sources);
            } else {
                let dep_out = build_dep_output_path(build_expand_env(dpath.clone()),
                                                    build_expand_env(target_output_dir));
                // Append to lib_paths array (TOML array form)
                if (lib_paths.len == 0) {
                    lib_paths = "[\"" + dep_out + "\"]";
                } else {
                    // Insert before closing bracket
                    let trimmed = lib_paths.trim();
                    if (trimmed.endsWith("]")) {
                        let inner = trimmed.substring(0, trimmed.len - 1).trim();
                        if (inner == "[") {
                            lib_paths = "[\"" + dep_out + "\"]";
                        } else {
                            lib_paths = inner + ", \"" + dep_out + "\"]";
                        }
                    }
                }
                if (libs.len == 0) {
                    libs = "[\"" + target_name + "\"]";
                } else {
                    let trimmed_l = libs.trim();
                    if (trimmed_l.endsWith("]")) {
                        let inner_l = trimmed_l.substring(0, trimmed_l.len - 1).trim();
                        if (inner_l == "[") {
                            libs = "[\"" + target_name + "\"]";
                        } else {
                            libs = inner_l + ", \"" + target_name + "\"]";
                        }
                    }
                }
            }
            lib_paths = build_merge_toml_arrays(lib_paths, dep_public_paths);
            libs = build_merge_toml_arrays(libs, dep_public_libs);
        }
        di_t = di_t + 1;
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " deps applied");
    }
    var entry2 = build_expand_env(entry.clone());
    var output_dir2 = build_expand_env(output_dir.clone());
    let src_raw2 = build_expand_env(src_raw);
    let interface_src_raw2 = build_expand_env(interface_src_raw);
    let auto_excludes = toml_array_to_lines(build_expand_env(auto_excludes_raw));
    let include_paths2 = build_expand_env(include_paths);
    var vyxflags_raw = build_toml_get_platform_array(manifest.clone(), section.clone(), "vyxflags");
    if (vyxflags_raw.len == 0) {
        vyxflags_raw = build_toml_get_platform_array(manifest.clone(), "build", "vyxflags");
    }
    vyxflags_raw = build_expand_env(vyxflags_raw);
    let cflags_raw = build_expand_env(build_toml_get_platform_array(manifest.clone(), section.clone(), "cflags"));
    let cxxflags_raw = build_expand_env(build_toml_get_platform_array(manifest.clone(), section.clone(), "cxxflags"));
    let configured_dci_file = build_manifest_dci_file(manifest.clone(), section.clone());
    let configured_dci_stub_backend = build_manifest_dci_stub_backend(manifest.clone(), section.clone());
    let configured_dci_stub_capabilities = build_manifest_dci_stub_capabilities(manifest.clone(), section.clone());
    let zyn_app_target = build_manifest_is_zyn_app(manifest.clone());
    var target_jobs = jobs;
    var parallel_vyx_enabled = build_bool_enabled(parallel_vyx_raw);
    var auto_sources_enabled = build_bool_enabled(auto_sources_raw);
    let mir_codegen_enabled = build_cli_uses_new_mir_codegen();
    // Root partitioning is deliberately opt-in.  An omitted setting means
    // one normal compilation per source/module, while projects that have
    // measured a benefit can request root-level parallelism explicitly.
    let mir_partition_enabled = mir_codegen_enabled && build_bool_enabled(mir_partition_raw);
    var mir_partition_mode_stamp = "mir_partition=0;";
    if (mir_partition_enabled) { mir_partition_mode_stamp = "mir_partition=1;"; }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " expanded config");
    }

    if (target_name.len == 0) { target_name = pkg_name.clone(); }
    if (target_kind.len == 0) {
        if (zyn_app_target && build_effective_is_android()) {
            target_kind = "shared";
        } else {
            target_kind = "executable";
        }
    }
    if (entry2.len == 0) { entry2 = pkg_entry; }
    if (output_dir2.len == 0) {
        output_dir2 = build_output_dir;
        if (zyn_app_target && build_effective_is_android()) {
            output_dir2 = build_zyn_app_android_output_dir(build_output_dir);
        }
    }
    if (build_cross_triplet_requested()
        && (target_name == "vyx_compiler_backend" || target_name == "vyx_runtime"
            || target_name == "vyx_rt" || target_name == "vyx_run_rt"
            || target_name == "vyx_run_rt_static")) {
        output_dir2 = build_runtime_triplet_output_dir(output_dir2);
    }
    if (entry2.len == 0 || !fileExists(entry2.clone())) {
        print(build_error_label() + ": entry file '" + entry2.clone() + "' not found");
        return "|ERR|";
    }
    if (target_kind == "source") {
        let declared_sources = toml_array_to_lines(src_raw2);
        var source_index: i64 = 0;
        let source_count = build_line_count(declared_sources.clone());
        while (source_index < source_count) {
            let source_path = build_line_at(declared_sources.clone(), source_index);
            if (source_path.len > 0 && !fileExists(source_path.clone())) {
                print(build_error_label() + ": source package file not found: " + source_path);
                return "|ERR|";
            }
            source_index = source_index + 1;
        }
        print("  source package " + target_name + " ("
              + (source_count + 1).toString() + " source file(s))");
        return cache_text;
    }
    if (configured_dci_file.len > 0 && !build_dci_paths_validate(target_name.clone(), configured_dci_file.clone())) {
        return "|ERR|";
    }
    // Per-target external-backend settings (Vyx.toml fallback for the
    // VYX_DCI_STUB_BACKEND_* env vars).  Applied for every target so a target
    // that declares nothing cannot inherit its predecessor's backend.
    build_dci_external_stub_backend_apply_manifest(manifest.clone(), section.clone());
    var dci_stub_backend = configured_dci_stub_backend.clone();
    if (dci_stub_backend.len == 0) {
        dci_stub_backend = "direct";
    }
    let dci_stub_backend_tokens = build_dci_stub_backend_tokens(dci_stub_backend.clone());
    if (dci_stub_backend_tokens == "|ERR|") {
        print(build_error_label() + ": target `" + target_name
              + "` configures unsupported DCI stub backend `" + dci_stub_backend
              + "`; supported backends: direct, external, clang-cpp, rustc, auto");
        return "|ERR|";
    }
    if (dci_stub_backend == "external"
        && build_dci_external_stub_backend_tool().len == 0) {
        print(build_error_label() + ": target `" + target_name
              + "` selects the external DCI stub backend but no tool is configured; "
              + "set VYX_DCI_STUB_BACKEND_TOOL, or `dci_stub_backend_tool` in [build] / [target."
              + target_name + "] of Vyx.toml");
        return "|ERR|";
    }
    let unsupported_dci_stub_capability = build_dci_stub_backend_unsupported_capability(
                                              dci_stub_backend.clone(),
                                              configured_dci_stub_capabilities.clone());
    if (unsupported_dci_stub_capability.len > 0) {
        print(build_error_label() + ": DCI stub backend `" + dci_stub_backend
              + "` does not support requested capability `" + unsupported_dci_stub_capability + "`");
        print("  supported capabilities: "
              + build_dci_stub_backend_capabilities_label(dci_stub_backend.clone()));
        return "|ERR|";
    }
    build_trace("target:" + target_name + ":dci-stub-backend=" + dci_stub_backend);
    let output_path = build_output_path(target_name.clone(), target_kind.clone(), output_dir2);
    let self_exe = getArg(0);
    // Linking this target can replace self_exe on disk.  Preserve the exact
    // predecessor identity now so the successor's provenance is not falsely
    // recorded as self-produced after the replacement.
    let compiler_generation = build_compiler_stamp(self_exe.clone(), output_path.clone());
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " output resolved");
    }

    let target_prebuild_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "prebuild", "pre");
    if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "prebuild", target_prebuild_hooks) != 0) {
        return "|ERR|";
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " prebuild hooks");
    }

    var sources = entry2 + "\n";
    let extra = toml_array_to_lines(src_raw2);
    let interface_extra = toml_array_to_lines(interface_src_raw2);
    var si: i64 = 0;
    let sn = build_line_count(extra.clone());
    while (si < sn) {
        sources = build_append_unique_line(sources.clone(), build_line_at(extra.clone(), si));
        si = si + 1;
    }
    var local_import_sources: string = "";
    var local_imports_are_versioned = false;
    let normal_vyx_executable = !(target_kind == "static" || target_kind == "staticlib"
                                  || target_kind == "shared" || target_kind == "library")
                                && build_source_kind(entry2.clone()) == "vyx";
    if (normal_vyx_executable) {
        local_import_sources = build_auto_vyx_import_sources_mode(
            entry2.clone(), parallel_vyx_enabled || mir_partition_enabled,
            build_toml_get_platform_value(manifest.clone(), section.clone(),
                                          "parallel_std_sources"),
            build_toml_get_platform_value(manifest.clone(), section.clone(),
                                          "parallel_std_excludes"));
        local_imports_are_versioned = build_source_lines_have_versioned_module(
            local_import_sources.clone());
    }
    // Parallel source scheduling needs the complete import closure in the
    // build graph.  Same-module files are then compiled as peer units through
    // their project-private interfaces instead of being folded into one unity
    // invocation or partitioned into repeated whole-front-end root jobs.
    let schedule_project_import_units = parallel_vyx_enabled || mir_partition_enabled;
    var project_import_units_stamp = "project_import_units=0;";
    if (schedule_project_import_units && !local_imports_are_versioned) {
        project_import_units_stamp = "project_import_units=1;";
    }
    if (auto_sources_enabled) {
        var auto_vyx_sources = build_auto_vyx_sources(entry2.clone());
        if (auto_excludes.len > 0) {
            auto_vyx_sources = build_filter_source_excludes(auto_vyx_sources.clone(), auto_excludes.clone());
        }
        sources = build_append_source_lines_unique(sources.clone(), auto_vyx_sources);
    } else if (schedule_project_import_units
               && normal_vyx_executable
               && !local_imports_are_versioned) {
        sources = build_append_source_lines_unique(sources.clone(), local_import_sources.clone());
    }
    // A versioned import closure must be parsed as imported project-local
    // siblings.  That preserves cross-version declaration merging and emits
    // all reachable implementation bodies in the entry object.
    var entry_project_import_sources: string = "";
    if (!auto_sources_enabled && normal_vyx_executable
        && (!schedule_project_import_units || local_imports_are_versioned)) {
        entry_project_import_sources = local_import_sources.clone();
        var pi: i64 = 0;
        let pn = build_line_count(entry_project_import_sources.clone());
        var filtered_project_imports: string = "";
        while (pi < pn) {
            let imported = build_line_at(entry_project_import_sources.clone(), pi);
            if (imported.len > 0 && !build_line_contains(sources.clone(), imported.clone())) {
                filtered_project_imports = build_append_unique_line(filtered_project_imports.clone(), imported);
            }
            pi = pi + 1;
        }
        entry_project_import_sources = filtered_project_imports;
    }
    let vyi_sources = build_append_source_lines_unique(sources.clone(), interface_extra.clone());
    libs = build_apply_std_auto_libs(libs.clone(), sources.clone());
    let probed_lib_paths = build_probe_system_lib_paths(libs.clone(), lib_paths.clone());
    lib_paths = build_merge_toml_arrays_unique(lib_paths, probed_lib_paths);
    libs = build_resolve_system_lib_names(libs, lib_paths.clone());
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " source list");
    }

    let target_precompile_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "precompile", "");
    if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "precompile", target_precompile_hooks) != 0) {
        return "|ERR|";
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " precompile hooks");
    }

    let source_count = build_line_count(sources.clone());
    let target_is_library = target_kind == "static" || target_kind == "staticlib"
                            || target_kind == "shared" || target_kind == "dylib"
                            || target_kind == "library";
    let target_needs_pic = (target_kind == "shared" || target_kind == "dylib"
                            || target_kind == "library")
                           && build_effective_platform_name() != "windows";
    let split_new_mir_roots = mir_partition_enabled;
    // rustc crate model: one compiler process per Vyx target.  C/C++ stay
    // per-file clang -c.  mir_partition remains the only opt-in that splits
    // a Vyx target across processes.
    //
    // `parallel_vyx` is honored by pre-unity build systems and would opt a
    // target out of the unity crate into one compile job per module.  The
    // per-source path measured 60s for this target's full self-build (vs
    // ~350s unity), but two hard blockers stand (2026-09-12):
    //   1. the module set must list its transitive std closure in `sources`
    //      so each std symbol is defined exactly once and every importer sees
    //      it through a shallow interface -- otherwise the link dies on
    //      duplicate std bodies;
    //   2. with std modules in the planner set, the per-source export-roots
    //      computation intermittently emits task commands whose inline
    //      `--export-root-names "..."` argument contains freed arena memory
    //      (observed: parser.vyx body text inside a std module's root list).
    //      The spawn then fails or the link breaks.  Fix the string-arena
    //      lifetime around build_export_root_names_for_source before
    //      re-enabling.
    let crate_compile_vyx = mir_codegen_enabled && !mir_partition_enabled &&
                            !parallel_vyx_enabled;
    // Partitioned projects use file-sized units and peer shallow interfaces.
    // Explicit environment settings retain the grouped path for diagnosis.
    let split_setting = build_env_value("VYX_BUILD_SPLIT_MODULE_UNITS");
    var split_module_units = mir_partition_enabled;
    if (split_setting.len > 0) { split_module_units = build_bool_enabled(split_setting); }
    let single_file_setting = build_env_value("VYX_BUILD_SINGLE_FILE_UNITS");
    var single_file_units = split_module_units;
    if (single_file_setting.len > 0) {
        single_file_units = split_module_units && build_bool_enabled(single_file_setting);
    }
    var compile_unit_count = build_compile_unit_count(sources.clone());
    if (crate_compile_vyx) {
        compile_unit_count = build_crate_cc_unit_count(sources.clone());
    }
    var interface_unit_count: i64 = 0;
    var peer_interface_unit_count: i64 = 0;
    if (!crate_compile_vyx && (parallel_vyx_enabled || split_module_units)) {
        if (split_module_units) {
            interface_unit_count = build_vyi_file_interface_unit_count(sources.clone());
        } else {
            interface_unit_count = build_vyi_interface_unit_count(sources.clone());
        }
    }
    var step_total = interface_unit_count + peer_interface_unit_count + compile_unit_count + 1;
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " counts");
    }
    let lib_path_args = build_manifest_cli_quoted(lib_paths.clone(), "-L");
    var pass_args = lib_path_args.clone();
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " lib path args");
    }
    let lib_args = build_manifest_cli_quoted(libs.clone(), "-l");
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " lib args built");
    }
    pass_args = pass_args.clone() + lib_args.clone();
    let module_source_rows = toml_array_to_lines(
        build_expand_env(dependency_sources_raw.clone()));
    var module_source_args: string = "";
    if (module_source_rows.len > 0) {
        let module_sources_path = build_join_path(
            build_cache_dir.clone(),
            build_safe_obj_name(target_name.clone(), ".module-sources"));
        build_ensure_parent(module_sources_path.clone());
        writeFile(module_sources_path.clone(), module_source_rows);
        module_source_args = " --module-sources-file " + build_quote(module_sources_path);
    }
    var module_registry_args = module_source_args.clone();
    if (module_source_args.len > 0
        || build_bool_enabled(build_toml_get(manifest.clone(), "build", "explicit_std"))) {
        module_registry_args = module_registry_args + " --no-implicit-std";
    }
    pass_args = pass_args.clone() + module_registry_args.clone();
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " lib args");
    }
    pass_args = pass_args.clone() + build_manifest_cli_passthrough(vyxflags_raw.clone());
    // build_start_job assigns scheduled codegen children their CPU budget.
    // Do not encode a second, independently multiplying pool in CLI arguments.
    if (target_needs_pic) {
        pass_args = pass_args.clone() + " -fPIC";
    }
    let passthrough_args = build_opt_and_link_passthrough();
    pass_args = pass_args.clone() + passthrough_args.clone();
    if (build_env_value("VYX_DEBUG_LINK").len > 0) {
        build_log("[build-args] target=" + target_name
                  + " lib_paths_len=" + lib_paths.len.toString()
                  + " libs_len=" + libs.len.toString()
                  + " lib_path_args_len=" + lib_path_args.len.toString()
                  + " lib_args_len=" + lib_args.len.toString()
                  + " pass_args_len=" + pass_args.len.toString());
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " passthrough args");
    }
    if (target_is_library && !mir_partition_enabled && !split_module_units) {
        pass_args = pass_args.clone() + " --export-all";
        if (build_profile_enabled()) {
            build_profile_log("target " + target_name + " export-all args");
        }
    } else if (split_new_mir_roots
               || (target_is_library && (mir_partition_enabled || split_module_units))) {
        if (build_profile_enabled()) {
            build_profile_log("target " + target_name + " root export args");
        }
    }
    let records_name = "records_" + target_name.clone() + ".tmp";
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " records name");
    }
    let records_path = build_join_path(build_cache_dir.clone(), records_name.clone());
    build_ensure_parent(records_path.clone());
    writeFile(records_path.clone(), "");

    // Device compilation must happen before the host crate is planned.
    // The generated embed module supplies symbols that host type checking
    // resolves, so producing it after the host object is too late.
    let cuda_opt_args = build_opt_and_link_passthrough();
    let cuda_prepared = build_cuda_prepare_device(manifest.clone(),
                                                  section.clone(),
                                                  target_name.clone(),
                                                  self_exe.clone(),
                                                  build_cache_dir.clone(),
                                                  cache_text.clone(),
                                                  cache_index.clone(),
                                                  records_path.clone(),
                                                  output_path.clone(),
                                                  cuda_opt_args.clone());
    if (cuda_prepared == "|ERR|") { return "|ERR|"; }
    var cuda_embed_src: string = "";
    var cuda_lib: string = "";
    if (cuda_prepared.len > 0) {
        cuda_embed_src = build_line_at(cuda_prepared.clone(), 0);
        cuda_lib = build_line_at(cuda_prepared.clone(), 1);
        if (cuda_embed_src.len > 0) {
            sources = build_append_source_lines_unique(sources.clone(), cuda_embed_src + "\n");
        }
    }

    let tasks_path = build_join_path(build_cache_dir.clone(), "tasks_" + target_name.clone() + ".tmp");
    writeFile(tasks_path.clone(), "");
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name + " records ready");
    }
    target_profile_mark = build_profile_mark("target " + target_name + " prepare", target_profile_mark);
    var source_index = build_make_source_index(sources);
    var partition_scratch = BuildPartitionWalkScratch.create(source_index.rows.len);
    target_profile_mark = build_profile_mark("target " + target_name + " source-index", target_profile_mark);
    var target_interface_root: string = "";
    if (!crate_compile_vyx && (parallel_vyx_enabled || split_module_units)) {
        target_interface_root = build_target_interface_root(output_dir2.clone(), target_name.clone());
        let vyi_dir_rc = build_emit_target_vyi_files(self_exe.clone(),
                                                    sources.clone(),
                                                    &mut source_index,
                                                    target_interface_root.clone(),
                                                    build_cache_dir.clone(),
                                                    cache_text.clone(),
                                                    cache_index.clone(),
                                                    records_path.clone(),
                                                    output_path.clone(),
                                                     target_jobs,
                                                     split_new_mir_roots || split_module_units,
                                                     module_registry_args.clone(),
                                                     0,
                                                    step_total);
        if (vyi_dir_rc != 0) { partition_scratch.destroy(); source_index.destroy(); return "|ERR|"; }
        if (!split_module_units) {
            let interface_root_arg = " --interface-root " + build_quote(target_interface_root.clone());
            pass_args = pass_args.clone() + interface_root_arg.clone();
        }
    }
    if (split_module_units) {
        let peer_vyi_rc = build_write_peer_vyi_units(&mut source_index,
                                                     target_interface_root,
                                                     build_cache_dir);
        if (peer_vyi_rc != 0) { partition_scratch.destroy(); source_index.destroy(); return "|ERR|"; }
    }
    target_profile_mark = build_profile_mark("target " + target_name + " interface-vyi", target_profile_mark);
    build_mem_profile_log("target " + target_name + " after interface-vyi");
    let include_args = build_manifest_cli_quoted(include_paths2.clone(), "-I");
    var cflags_args = build_manifest_cli_passthrough(cflags_raw.clone());
    var cxxflags_args = build_manifest_cli_passthrough(cxxflags_raw.clone());
    if (target_needs_pic) {
        cflags_args = cflags_args + " -fPIC";
        cxxflags_args = cxxflags_args + " -fPIC";
    }
    let vyx_source_list_for_stamps = build_vyx_sources_only(sources.clone());
    var common_std_stamp: string = "";
    var common_vyx_deps_stamp: string = "";
    if (build_line_count(vyx_source_list_for_stamps.clone()) > 0) {
        common_std_stamp = build_dep_stamp_dir("std");
        common_vyx_deps_stamp = build_dep_stamp_dir(".vyx_deps");
    }
    var tasks: string = "";
    var objects: string = "";
    var task_count: i64 = 0;
    let run_tasks_immediately = target_jobs <= 1;
    var step: i64 = interface_unit_count + peer_interface_unit_count + 1;

    var seen_groups: string = "";
    var crate_entry: string = "";
    if (crate_compile_vyx) {
        crate_entry = build_vyx_crate_entry(sources.clone(), entry2.clone());
    }
    var prior_public_names_for_planner: string = "";
    var target_dci_abi_path: string = "";
    var prof_plan_group_ms: i64 = 0;
    var prof_plan_unit_ms: i64 = 0;
    var prof_plan_dci_ms: i64 = 0;
    var prof_plan_root_probe_ms: i64 = 0;
    var prof_plan_partition_stamp_ms: i64 = 0;
    var prof_plan_root_io_ms: i64 = 0;
    var prof_plan_record_ms: i64 = 0;
    var prof_plan_cache_ms: i64 = 0;
    var prof_plan_prior_ms: i64 = 0;
    var prof_plan_partition_deps_ms: i64 = 0;
    var i: i64 = 0;
    while (i < source_count) {
        var prof_mark_plan: i64 = 0;
        if (build_profile_enabled()) {
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        let src_line = build_line_at(sources.clone(), i);
        let src = build_expand_env(src_line.clone());
        if (!fileExists(src)) {
            print(build_error_label() + ": source file '" + src + "' not found");
            partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
        }
        let kind = build_source_kind(src.clone());
        if (crate_compile_vyx && kind == "vyx"
            && !build_same_abs_path(src.clone(), crate_entry.clone())) {
            i = i + 1;
            continue;
        }
        let source_id = source_index.source_id(src);
        if (source_id < 0) {
            build_log(build_error_label() + ": source absent from target snapshot: " + src);
            partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
        }
        let indexed_source = source_index.rows.get_ptr(source_id);
        let module_group_key = indexed_source[0].group_key;
        let module_group_sources = source_index.sources_for_group(module_group_key);
        var group_key = module_group_key.clone();
        if (crate_compile_vyx && kind == "vyx") {
            group_key = "crate:" + target_name.clone();
        } else if (split_module_units && kind == "vyx") {
            group_key = "file:" + build_norm_path(src.clone());
        }
        if (build_group_key_seen(seen_groups.clone(), group_key.clone())) {
            i = i + 1;
            continue;
        }
        seen_groups = seen_groups + group_key.clone() + "\n";
        if (build_profile_enabled()) { prof_mark_plan = vyx_bootstrap_now_ms(); }
        var group_sources = module_group_sources.clone();
        if (crate_compile_vyx && kind == "vyx") {
            group_sources = build_vyx_sources_only(sources.clone());
            if (entry_project_import_sources.len > 0) {
                group_sources = build_append_source_lines_unique(
                    group_sources.clone(), entry_project_import_sources.clone());
            }
        } else if (split_module_units && kind == "vyx") {
            group_sources = src.clone() + "\n";
        }
        if (build_profile_enabled()) {
            prof_plan_group_ms = prof_plan_group_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        var suffix = build_obj_ext();
        if (kind == "c" || kind == "cpp") { suffix = build_c_obj_ext(); }
        var obj_name_src = src.clone();
        if (crate_compile_vyx && kind == "vyx") {
            obj_name_src = "crate:" + target_name.clone();
        } else if (group_key.startsWith("module:")) {
            obj_name_src = group_key.clone();
        }
        if (target_is_library) {
            obj_name_src = target_name.clone() + ":" + obj_name_src;
        }
        let obj = build_join_path(build_cache_dir.clone(), build_safe_obj_name(obj_name_src.clone(), suffix.clone()));
        build_ensure_parent(obj.clone());
        var unit_sources_path: string = "";
        let group_source_count = build_line_count(group_sources.clone());
        if (kind == "vyx" && group_source_count > 1) {
            unit_sources_path = build_unit_sources_path(build_cache_dir.clone(), group_key.clone());
            build_ensure_parent(unit_sources_path.clone());
            writeFile(unit_sources_path.clone(), group_sources.clone());
        }
        if (crate_compile_vyx && kind == "vyx") {
            build_log("[build] crate " + target_name
                      + " files=" + group_source_count.toString()
                      + " -> " + build_path_label(obj.clone()));
        }
        var compile_unit_sources_path = unit_sources_path.clone();
        var compile_uses_project_unit_sources = false;
        var compile_uses_interface_unit_sources = false;
        var compile_group_sources = group_sources.clone();
        if (crate_compile_vyx && kind == "vyx" && group_source_count > 1) {
            compile_uses_project_unit_sources = true;
        }
        if (split_module_units && kind == "vyx"
            && build_line_count(module_group_sources.clone()) > 1) {
            compile_unit_sources_path = build_peer_vyi_unit_path(build_cache_dir.clone(), src.clone());
            compile_uses_interface_unit_sources = true;
        }
        if (!crate_compile_vyx && kind == "vyx"
            && entry_project_import_sources.len > 0
            && build_same_abs_path(src.clone(), entry2.clone())) {
            compile_group_sources = build_append_source_lines_unique(
                compile_group_sources.clone(), entry_project_import_sources.clone());
            compile_unit_sources_path = build_unit_sources_path(
                build_cache_dir.clone(), "project:" + target_name + ":entry");
            build_ensure_parent(compile_unit_sources_path.clone());
            writeFile(compile_unit_sources_path.clone(), compile_group_sources.clone());
            compile_uses_project_unit_sources = true;
        }
        if (build_profile_enabled()) {
            prof_plan_unit_ms = prof_plan_unit_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        var group_dci_abi_path: string = "";
        var group_dci_abi_stamp: string = "";
        if (kind == "vyx" && build_dci_group_has_dci_extern(group_sources.clone())) {
            let imported_dci_file = build_dci_import_for_group(group_sources.clone());
            if (imported_dci_file.len > 0 && !build_dci_paths_validate(target_name.clone(), imported_dci_file.clone())) {
                partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
            }
            var group_paths = imported_dci_file.clone();
            var configured_i: i32 = 0;
            let configured_n = dci_path_list_count(configured_dci_file.clone());
            while (configured_i < configured_n) {
                group_paths = dci_path_list_append(
                    group_paths.clone(),
                    dci_path_list_at(configured_dci_file.clone(), configured_i));
                configured_i = configured_i + 1;
            }
            // A supplement contract from an earlier build's open-generic
            // instance closure joins the descriptor list from the start, so
            // warm builds lower with the closed facts and keep their caches.
            let existing_supplement = build_dci_supplement_path(build_cache_dir.clone(),
                                                                target_name.clone());
            if (fileExists(existing_supplement.clone())) {
                group_paths = dci_path_list_append(group_paths.clone(), existing_supplement.clone());
            }
            if (group_paths.len > 0) {
                group_dci_abi_path = group_paths;
            } else {
                print(build_error_label() + ": target `" + target_name
                      + "` declares extern DCI bindings but has no dci_import or dci_file; "
                      + "generate a .dcib contract externally and declare it explicitly");
                partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
            }
            if (group_dci_abi_path.len > 0) {
                build_trace("target:" + target_name + ":dci-stamp-before " + group_dci_abi_path.clone());
                group_dci_abi_stamp = build_dci_descriptor_list_stamp(group_dci_abi_path.clone());
                build_trace("target:" + target_name + ":dci-stamp-after len=" + group_dci_abi_stamp.len.toString());
                var path_i: i32 = 0;
                let path_n = dci_path_list_count(group_dci_abi_path.clone());
                while (path_i < path_n) {
                    target_dci_abi_path = dci_path_list_append(
                        target_dci_abi_path.clone(),
                        dci_path_list_at(group_dci_abi_path.clone(), path_i));
                    path_i = path_i + 1;
                }
            }
        }
        if (build_profile_enabled()) {
            prof_plan_dci_ms = prof_plan_dci_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        var should_root_partition = false;
        var partition_probe_roots: string = "";
        if (split_new_mir_roots) {
            if (kind == "vyx") {
                build_trace("target:" + target_name + ":root-partition-check-before " + src.clone());
                partition_probe_roots = build_partition_root_names_for_sources(group_sources.clone(),
                                                                               sources.clone(),
                                                                               "");
                should_root_partition = build_should_root_partition_for_roots(src.clone(),
                                                                              partition_probe_roots.clone());
                // A small file is already a useful codegen unit. Repeating
                // its frontend for several root chunks costs more than one
                // object emit; keep large files partitioned to bound memory.
                if (single_file_units && fileSize(src.clone()) <= 50000
                    && build_pipe_item_count(partition_probe_roots.clone()) <= 128) {
                    should_root_partition = false;
                }
                build_trace("target:" + target_name + ":root-partition-check-after " + should_root_partition.toString());
            }
        }
        if (build_profile_enabled()) {
            prof_plan_root_probe_ms = prof_plan_root_probe_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        if (should_root_partition) {
            build_trace("target:" + target_name + ":root-export-before " + src.clone());
            var export_root_names = partition_probe_roots.clone();
            if (export_root_names.len == 0) {
                export_root_names = build_partition_root_names_for_sources(group_sources.clone(),
                                                                           sources.clone(),
                                                                           "");
            }
            build_trace("target:" + target_name + ":root-export-after len=" + export_root_names.len.toString());
            build_trace("target:" + target_name + ":root-partition-stamp-before " + src.clone());
            let partition_stamp = build_partition_dependency_stamp(source_id, &mut source_index, &mut partition_scratch);
            build_trace("target:" + target_name + ":root-partition-stamp-after len=" + partition_stamp.len.toString());
            if (build_profile_enabled()) {
                prof_plan_partition_stamp_ms = prof_plan_partition_stamp_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
                prof_mark_plan = vyx_bootstrap_now_ms();
            }
            let use_method_root_partition = true;
            var export_root_names_file: string = "";
            if (export_root_names.len > 0) {
                build_trace("target:" + target_name + ":root-write-export-names-before");
                export_root_names_file = build_write_root_names_file(build_cache_dir.clone(),
                                                                     obj_name_src.clone(),
                                                                     "export",
                                                                     export_root_names.clone());
                build_trace("target:" + target_name + ":root-write-export-names-after " + export_root_names_file.clone());
            }
            if (build_profile_enabled()) {
                prof_plan_root_io_ms = prof_plan_root_io_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
                prof_mark_plan = vyx_bootstrap_now_ms();
            }
            var root_count = build_pipe_item_count(export_root_names.clone());
            var root_chunk_size = build_new_mir_root_chunk_size(src.clone(), root_count);
            build_trace("target:" + target_name + ":root-count=" + root_count.toString()
                        + " chunk=" + root_chunk_size.toString());
            if (root_chunk_size <= 0) { root_chunk_size = 1; }
            if (root_count <= 0) {
                root_count = 1;
                root_chunk_size = 1;
            }
            var root_i: i64 = 0;
            var root_chunk_i: i64 = 0;
            while (root_i < root_count) {
                var root_arg = "|";
                if (export_root_names.len > 0) {
                    root_arg = build_pipe_item_range(export_root_names.clone(), root_i, root_chunk_size);
                    if (root_arg.len == 0) { root_arg = "|"; }
                }
                var root_obj_name_src = obj_name_src.clone() + "#rootchunk#" + root_chunk_i.toString();
                if (root_arg == "|") {
                    root_obj_name_src = obj_name_src.clone() + "#root#__none";
                } else {
                    root_obj_name_src = root_obj_name_src + "#" + build_pipe_item_at(root_arg.clone(), 0);
                }
                let root_obj = build_join_path(build_cache_dir, build_safe_obj_name(root_obj_name_src, suffix));
                build_ensure_parent(root_obj);
                objects = objects + root_obj + "\n";
                let plan_mark = vyx_rt_string_arena_checkpoint();
                var root_pass_args = pass_args.clone()
                                     + " --export-top-level-roots";
                if (use_method_root_partition) {
                    root_pass_args = root_pass_args.clone()
                                     + " --export-method-roots";
                }
                let emit_root_names_file = build_write_root_names_file(build_cache_dir.clone(),
                                                                       root_obj_name_src.clone(),
                                                                       "emit",
                                                                       root_arg.clone());
                if (build_profile_enabled()) {
                    prof_plan_root_io_ms = prof_plan_root_io_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
                    prof_mark_plan = vyx_bootstrap_now_ms();
                }
                if (export_root_names_file.len > 0) {
                    let root_names_file_arg = " --export-root-names-file "
                                      + build_quote(export_root_names_file.clone())
                                      + " --emit-root-names-file "
                                      + build_quote(emit_root_names_file.clone());
                    root_pass_args = root_pass_args.clone()
                                     + root_names_file_arg.clone();
                } else {
                    let root_names_arg = " --emit-root-names-file "
                                      + build_quote(emit_root_names_file.clone());
                    root_pass_args = root_pass_args.clone()
                                     + root_names_arg.clone();
                }
                let root_cmd = build_compile_command(kind,
                                                     self_exe,
                                                     src,
                                                     root_obj,
                                                     root_pass_args,
                                                     include_args,
                                                     cflags_args,
                                                     cxxflags_args,
                                                     build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "cc")),
                                                     build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "cxx")),
                                                     compile_unit_sources_path.clone(),
                                                     compile_uses_project_unit_sources,
                                                     compile_uses_interface_unit_sources,
                                                     group_dci_abi_path.clone());
                let root_record = build_cache_record(kind,
                                                     src,
                                                     root_obj,
                                                     root_cmd,
                                                     self_exe.clone(),
                                                     output_path.clone(),
                                            compile_group_sources.clone(),
                                            dependency_vyi_stamp.clone()
                                            + group_dci_abi_stamp.clone()
                                            + mir_partition_mode_stamp.clone()
                                            + project_import_units_stamp.clone()
                                            + partition_stamp.clone()
                                            + build_root_partition_stamp(root_arg.clone(), root_chunk_size)
                                            + build_source_root_body_stamp(src.clone(), root_arg.clone()),
                                            true,
                                            common_std_stamp.clone(),
                                            common_vyx_deps_stamp.clone());
                appendFile(records_path.clone(), root_record + "\n");
                if (build_profile_enabled()) {
                    prof_plan_record_ms = prof_plan_record_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
                    prof_mark_plan = vyx_bootstrap_now_ms();
                }
                if (build_cache_has_indexed(cache_text, cache_index, root_record, root_obj)
                    && (group_dci_abi_path.len == 0
                        || fileExists(root_obj.clone() + ".dci_open"))) {
                    if (build_verbose_cache_enabled()) {
                        print(build_progress_label(step.toString(), step_total) + " " + build_status_cache()
                              + " " + build_path_label(src) + " -> " + build_path_label(root_obj));
                    }
                } else {
                    if (group_dci_abi_path.len > 0) {
                        // A sidecar belongs to this object generation.  Keep
                        // requests from a failed pass only across its closure
                        // retries, not across unrelated rebuilds.
                        deleteFile(root_obj.clone() + ".dci_open");
                    }
                    task_count = task_count + 1;
                    let task_line = step.toString() + "\t" + src + "\t" + root_obj + "\t" + root_cmd
                                          + "\t" + build_task_source_bytes(group_sources).toString();
                    if (run_tasks_immediately) {
                        let task_mark = vyx_rt_string_arena_checkpoint();
                        var task_rc = build_execute_task(task_line, step_total);
                        var final_root_cmd = root_cmd.clone();
                        // Open-generic DCI instance closure: a failed re-lower
                        // that left `instance` requests in its `.dci_open`
                        // sidecar is not fatal by itself.  Close the requested
                        // instances against the producer, join the supplement
                        // contract into the descriptor list, and retry.
                        var closure_round: i32 = 0;
                        while (task_rc != 0 && kind == "vyx"
                               && group_dci_abi_path.len > 0 && closure_round < 3) {
                            closure_round = closure_round + 1;
                            let sidecar_path = root_obj.clone() + ".dci_open";
                            if (!build_dci_sidecar_has_generic_instances(sidecar_path.clone())) { break; }
                            let closure_rc = build_dci_run_instance_closure(
                                build_cache_dir.clone(), target_name.clone(),
                                sidecar_path.clone(), group_dci_abi_path.clone());
                            if (closure_rc != 0) { break; }
                            let supplement_path = build_dci_supplement_path(
                                build_cache_dir.clone(), target_name.clone());
                            // The close-instances tool MERGES new facts into
                            // the supplement file, so once its path is on the
                            // descriptor list the retry just re-reads the
                            // updated file.  Appending it a second time put
                            // duplicate --dci descriptors on the command.
                            var retry_cmd = final_root_cmd.clone();
                            if (!dci_path_list_contains(group_dci_abi_path.clone(),
                                                        supplement_path.clone())) {
                                group_dci_abi_path = dci_path_list_append(
                                    group_dci_abi_path.clone(), supplement_path.clone());
                                target_dci_abi_path = dci_path_list_append(
                                    target_dci_abi_path.clone(), supplement_path.clone());
                                retry_cmd = retry_cmd
                                            + " --dci " + build_quote(supplement_path.clone());
                            }
                            final_root_cmd = retry_cmd.clone();
                            task_rc = build_execute_task(
                                step.toString() + "\t" + src + "\t" + root_obj + "\t" + retry_cmd,
                                step_total);
                        }
                        // per-task arena rewind removed: see the arena note in
                        // build_emit_target_vyi_files
                        vyx_rt_heap_trim();
                        if (task_rc != 0) {
                            partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
                        }
                        if (closure_round > 0) {
                            let final_root_record = build_cache_record(kind,
                                src, root_obj, final_root_cmd, self_exe.clone(),
                                output_path.clone(), compile_group_sources.clone(),
                                dependency_vyi_stamp.clone()
                                + build_dci_descriptor_list_stamp(group_dci_abi_path.clone())
                                + mir_partition_mode_stamp.clone()
                                + project_import_units_stamp.clone()
                                + partition_stamp.clone()
                                + build_root_partition_stamp(root_arg.clone(), root_chunk_size)
                                + build_source_root_body_stamp(src.clone(), root_arg.clone()),
                                true, common_std_stamp.clone(), common_vyx_deps_stamp.clone());
                            if (!build_cache_replace_record_file(records_path.clone(), final_root_record)) {
                                print(build_error_label() + ": cannot update DCI closure cache record for " + root_obj);
                                partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
                            }
                        }
                    } else {
                        appendFile(tasks_path.clone(), task_line + "\n");
                    }
                }
                if (build_profile_enabled()) {
                    prof_plan_cache_ms = prof_plan_cache_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
                    prof_mark_plan = vyx_bootstrap_now_ms();
                }
                // per-iteration arena rewind removed: see the arena note in
                // build_emit_target_vyi_files
                step = step + 1;
                root_i = root_i + root_chunk_size;
                root_chunk_i = root_chunk_i + 1;
            }
            if (kind == "vyx") {
                prior_public_names_for_planner = build_pipe_set_merge(prior_public_names_for_planner,
                                                                      build_public_fn_names_for_source(src.clone()));
            }
            if (build_profile_enabled()) {
                prof_plan_prior_ms = prof_plan_prior_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            }
            build_mem_profile_log("target " + target_name + " planned " + src);
            i = i + 1;
            continue;
        }
        objects = objects + obj + "\n";
        if (build_profile_enabled()) { prof_mark_plan = vyx_bootstrap_now_ms(); }
        let plan_mark2 = vyx_rt_string_arena_checkpoint();
        var compile_pass_args = pass_args.clone();
        var export_root_names_arg: string = "";
        var should_export_roots = false;
        if (kind == "vyx") {
            if (!target_is_library) {
                if (split_new_mir_roots) {
                    should_export_roots = !build_source_has_duplicate_root_name(src.clone(), true);
                } else if (!crate_compile_vyx && mir_codegen_enabled && source_count > 1) {
                    // A non-partitioned multi-source build still emits one
                    // native object per Vyx source/module.  Public functions
                    // and methods called from sibling objects are therefore
                    // object roots even though they do not need separate
                    // root-chunk compiler processes.
                    should_export_roots = true;
                }
            } else if (mir_partition_enabled || split_module_units) {
                should_export_roots = true;
            }
        }
        if (should_export_roots) {
            compile_pass_args = compile_pass_args.clone()
                                + " --export-top-level-roots --export-method-roots";
            var export_root_names = "";
            if (target_is_library) {
                export_root_names = build_export_root_names_for_sources(group_sources.clone(),
                                                                        sources.clone(),
                                                                        prior_public_names_for_planner.clone());
            } else if (split_module_units) {
                // One native object per source file: every public function
                // and method in this file is a link-visible root for the
                // other objects in the same module.
                export_root_names = build_public_fn_names_for_source_with_methods(src.clone(), true);
                if (build_source_has_function_name(src.clone(), "main")) {
                    export_root_names = build_pipe_set_add(export_root_names, "main");
                }
            } else {
                export_root_names = build_export_root_names_for_source(src.clone(),
                                                                       sources.clone(),
                                                                       prior_public_names_for_planner.clone());
            }
            if (split_module_units) {
                // A private top-level function may be called by a sibling
                // file in the same module. The shallow interface permits
                // that call, so the defining file must keep its body as an
                // object root even though it is not public API.
                export_root_names = build_pipe_set_merge(
                    export_root_names,
                    build_public_fn_names_for_source_with_methods(src.clone(), true));
            }
            if (!split_module_units && target_interface_root.len > 0
                && build_line_count(group_sources.clone()) == 1) {
                // The shallow interface is generated from the parsed AST. It
                // includes concrete trait impl methods whose source spelling
                // is private (`impl Hashable for i32 { fn hash... }`) but whose
                // symbols must be provided to sibling objects.
                let module_name = build_module_name_from_file(src.clone());
                let vyi = build_vyi_path_for_module(target_interface_root.clone(), module_name);
                if (fileExists(vyi.clone())) {
                    export_root_names = build_pipe_set_merge(
                        export_root_names,
                        build_public_method_names_for_source(vyi));
                }
            }
            export_root_names_arg = export_root_names;
            if (export_root_names_arg.len == 0) { export_root_names_arg = "|"; }
            // Roots diagnostics: a corrupted roots string (file text inside a
            // pipe-name list) poisons the task command. Dump suspicious ones.
            if (export_root_names_arg.len > 4096) {
                let dbg_path = build_join_path(build_cache_dir.clone(), "_roots_dump.txt");
                appendFile(dbg_path.clone(),
                           "src=" + src + " len=" + policy_i64_to_string(export_root_names_arg.len as i64)
                           + "\n" + export_root_names_arg + "\n<<<END>>>\n");
            }
            var compile_root_names_arg = " --export-root-names " + build_quote_arg(export_root_names_arg.clone());
            if (export_root_names_arg.len > 8000) {
                let names_file = build_write_root_names_file(build_cache_dir.clone(),
                                                               obj_name_src.clone(),
                                                               "compile",
                                                               export_root_names_arg.clone());
                compile_root_names_arg = " --export-root-names-file " + build_quote(names_file);
            }
            compile_pass_args = compile_pass_args.clone() + compile_root_names_arg.clone();
        }
        if (build_profile_enabled()) {
            prof_plan_root_probe_ms = prof_plan_root_probe_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        var object_dependency_stamp = dependency_vyi_stamp.clone();
        if (split_module_units && kind == "vyx") {
            if (build_line_count(module_group_sources.clone()) > 1) {
                object_dependency_stamp = object_dependency_stamp
                    + build_sibling_file_vyi_stamp(target_interface_root.clone(),
                                                   module_group_sources.clone(),
                                                   src.clone());
            } else {
                let module_name = build_module_name_from_file(src.clone());
                if (module_name.len > 0) {
                    let internal_vyi = build_vyi_path_for_module(target_interface_root.clone(), module_name);
                    object_dependency_stamp = object_dependency_stamp + build_file_content_stamp(internal_vyi);
                }
            }
        }
        var object_partition_deps = false;
        var should_partition_deps = false;
        if (kind == "vyx") {
            if (split_new_mir_roots || (target_is_library && mir_partition_enabled)) {
                should_partition_deps = should_export_roots;
            }
        }
        if (should_partition_deps) {
            object_dependency_stamp = object_dependency_stamp
                                      + build_partition_dependency_stamp(source_id, &mut source_index, &mut partition_scratch)
                                      + build_source_root_body_stamp(src.clone(), export_root_names_arg.clone());
            object_partition_deps = true;
        }
        if (build_profile_enabled()) {
            prof_plan_partition_deps_ms = prof_plan_partition_deps_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        let cmd = build_compile_command(kind,
                                        self_exe,
                                        src,
                                        obj,
                                        compile_pass_args,
                                        include_args,
                                        cflags_args,
                                        cxxflags_args,
                                        build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "cc")),
                                        build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "cxx")),
                                        compile_unit_sources_path,
                                        compile_uses_project_unit_sources,
                                        compile_uses_interface_unit_sources,
                                        group_dci_abi_path.clone());
        let record = build_cache_record(kind,
                                        src,
                                        obj,
                                        cmd,
                                        self_exe.clone(),
                                        output_path.clone(),
                                        compile_group_sources.clone(),
                                        object_dependency_stamp + group_dci_abi_stamp.clone()
                                        + mir_partition_mode_stamp.clone()
                                        + project_import_units_stamp.clone(),
                                        object_partition_deps,
                                        common_std_stamp.clone(),
                                        common_vyx_deps_stamp.clone());
        appendFile(records_path.clone(), record + "\n");
        if (build_profile_enabled()) {
            prof_plan_record_ms = prof_plan_record_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        if (build_cache_has_indexed(cache_text, cache_index, record, obj)
            && (group_dci_abi_path.len == 0
                || fileExists(obj.clone() + ".dci_open"))) {
            // Cached steps still own a slot in the `[n/N]` count, so they must
            // report it.  Staying silent made a warm build look like it jumped
            // from the plan line straight to the link with no sign that the
            // crate object step had run at all.
            print(build_progress_label(step.toString(), step_total) + " " + build_status_cache()
                  + " " + build_path_label(src) + " -> " + build_path_label(obj));
        } else {
            if (group_dci_abi_path.len > 0) {
                deleteFile(obj.clone() + ".dci_open");
            }
            task_count = task_count + 1;
            let task_line = step.toString() + "\t" + src + "\t" + obj + "\t" + cmd
                                  + "\t" + build_task_source_bytes(compile_group_sources).toString();
            if (run_tasks_immediately) {
                let task_mark = vyx_rt_string_arena_checkpoint();
                var task_rc = build_execute_task(task_line, step_total);
                var final_cmd = cmd.clone();
                // Open-generic DCI instance closure retry, same contract as
                // the root-partitioned site above: close the instances the
                // failed pass reported, then re-lower with the supplement.
                var closure_round: i32 = 0;
                while (task_rc != 0 && kind == "vyx"
                       && group_dci_abi_path.len > 0 && closure_round < 3) {
                    closure_round = closure_round + 1;
                    let sidecar_path = obj.clone() + ".dci_open";
                    if (!build_dci_sidecar_has_generic_instances(sidecar_path.clone())) { break; }
                    let closure_rc = build_dci_run_instance_closure(
                        build_cache_dir.clone(), target_name.clone(),
                        sidecar_path.clone(), group_dci_abi_path.clone());
                    if (closure_rc != 0) { break; }
                    let supplement_path = build_dci_supplement_path(
                        build_cache_dir.clone(), target_name.clone());
                    // Same merge-not-append contract as the root-partitioned
                    // site above: the tool accumulates facts into the one
                    // supplement file, so a path already on the descriptor
                    // list must not be added twice.
                    var retry_cmd = final_cmd.clone();
                    if (!dci_path_list_contains(group_dci_abi_path.clone(),
                                                supplement_path.clone())) {
                        group_dci_abi_path = dci_path_list_append(
                            group_dci_abi_path.clone(), supplement_path.clone());
                        target_dci_abi_path = dci_path_list_append(
                            target_dci_abi_path.clone(), supplement_path.clone());
                        retry_cmd = retry_cmd
                                    + " --dci " + build_quote(supplement_path.clone());
                    }
                    final_cmd = retry_cmd.clone();
                    task_rc = build_execute_task(
                        step.toString() + "\t" + src + "\t" + obj + "\t" + retry_cmd,
                        step_total);
                }
                // per-task arena rewind removed: see the arena note in
                // build_emit_target_vyi_files
                vyx_rt_heap_trim();
                if (task_rc != 0) {
                    partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
                }
                if (closure_round > 0) {
                    let final_record = build_cache_record(kind, src, obj, final_cmd,
                        self_exe.clone(), output_path.clone(), compile_group_sources.clone(),
                        object_dependency_stamp
                        + build_dci_descriptor_list_stamp(group_dci_abi_path.clone())
                        + mir_partition_mode_stamp.clone()
                        + project_import_units_stamp.clone(),
                        object_partition_deps, common_std_stamp.clone(),
                        common_vyx_deps_stamp.clone());
                    if (!build_cache_replace_record_file(records_path.clone(), final_record)) {
                        print(build_error_label() + ": cannot update DCI closure cache record for " + obj);
                        partition_scratch.destroy(); source_index.destroy(); return "|ERR|";
                    }
                }
            } else {
                appendFile(tasks_path.clone(), task_line + "\n");
            }
        }
        if (build_profile_enabled()) {
            prof_plan_cache_ms = prof_plan_cache_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
            prof_mark_plan = vyx_bootstrap_now_ms();
        }
        // per-iteration arena rewind removed: see the arena note in
        // build_emit_target_vyi_files
        if (kind == "vyx") {
            prior_public_names_for_planner = build_pipe_set_merge(prior_public_names_for_planner,
                                                                  build_public_fn_names_for_source(src.clone()));
        }
        if (build_profile_enabled()) {
            prof_plan_prior_ms = prof_plan_prior_ms + (vyx_bootstrap_now_ms() - prof_mark_plan);
        }
        build_mem_profile_log("target " + target_name + " planned " + src);
        step = step + 1;
        i = i + 1;
    }

    partition_scratch.destroy();
    source_index.destroy();

    if (step > step_total) {
        step_total = step;
    }

    if (!run_tasks_immediately && task_count > 0) {
        build_mem_profile_log("target " + target_name + " before read tasks count=" + task_count.toString());
        build_heap_bucket_report("target " + target_name + " before read tasks");
        let tasks_to_run = readFile(tasks_path.clone());
        build_mem_profile_log("target " + target_name + " before run tasks bytes=" + tasks_to_run.len.toString());
        let rc = build_run_tasks(tasks_to_run, task_count, target_jobs, step_total);
        build_mem_profile_log("target " + target_name + " after run tasks");
        if (rc != 0) { return "|ERR|"; }
    }
    if (build_profile_enabled()) {
        build_profile_log("target " + target_name
                          + " plan-detail group=" + prof_plan_group_ms.toString()
                          + " unit=" + prof_plan_unit_ms.toString()
                          + " dci=" + prof_plan_dci_ms.toString()
                          + " root_probe=" + prof_plan_root_probe_ms.toString()
                          + " partition_stamp=" + prof_plan_partition_stamp_ms.toString()
                          + " root_io=" + prof_plan_root_io_ms.toString()
                          + " record=" + prof_plan_record_ms.toString()
                          + " cache=" + prof_plan_cache_ms.toString()
                          + " partition_deps=" + prof_plan_partition_deps_ms.toString()
                          + " prior=" + prof_plan_prior_ms.toString());
    }
    target_profile_mark = build_profile_mark("target " + target_name
                                             + " compile tasks=" + task_count.toString(),
                                             target_profile_mark);

    build_trace("target:" + target_name + ":before-dci");
    let dci_file_for_stubs = build_stable_string(target_dci_abi_path.clone());
    let dci_stub_objects = build_emit_dci_stub_objects(self_exe.clone(),
                                                       sources.clone(),
                                                       target_name.clone(),
                                                       build_cache_dir.clone(),
                                                       pass_args.clone(),
                                                       dci_file_for_stubs.clone(),
                                                       dci_stub_backend.clone(),
                                                       include_args.clone(),
                                                       cxxflags_args.clone(),
                                                       build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "cxx")),
                                                       objects.clone(),
                                                       step_total);
    build_trace("target:" + target_name + ":after-dci len=" + dci_stub_objects.len.toString());
    if (dci_stub_objects == "|ERR|") { return "|ERR|"; }
    if (dci_stub_objects.len > 0) {
        build_trace("target:" + target_name + ":append-dci-objects begin objects_len=" + objects.len.toString());
        objects = objects.clone() + dci_stub_objects.clone();
        build_trace("target:" + target_name + ":append-dci-objects end objects_len=" + objects.len.toString());
    }
    build_trace("target:" + target_name + ":before-dci-profile");
    target_profile_mark = build_profile_mark("target " + target_name + " dci-stubs", target_profile_mark);
    build_trace("target:" + target_name + ":before-postcompile-hooks");

    let target_postcompile_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "postcompile", "");
    if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "postcompile", target_postcompile_hooks) != 0) {
        return "|ERR|";
    }
    build_trace("target:" + target_name + ":after-postcompile-hooks");
    target_profile_mark = build_profile_mark("target " + target_name + " postcompile-hooks", target_profile_mark);

    build_trace("target:" + target_name + ":before-read-records");
    let records = readFile(records_path.clone());
    build_trace("target:" + target_name + ":after-read-records len=" + records.len.toString());
    var new_cache = build_cache_replace_many(cache_text.clone(), records.clone());
    build_trace("target:" + target_name + ":after-cache-replace len=" + new_cache.len.toString());

    let need_runtime = !(target_name == "vyx_compiler_backend"
                         || target_name == "vyx_runtime"
                         || target_name == "vyx_rt"
                         || target_name == "vyx_run_rt"
                         || target_name == "vyx_run_rt_static");
    let ar_tool_for_target = build_expand_env(build_toml_get_platform_value(manifest.clone(), section.clone(), "ar"));
    build_trace("target:" + target_name + ":before-link-command objects_len=" + objects.len.toString());
    objects = build_expand_cgu_object_lists(objects.clone());
    if (cuda_lib.len > 0) {
        // Link the driver import library through its toolkit search directory.
        // A project may already declare "cuda"; adding its absolute path as a
        // second input would still leave the original -l cuda unresolved.
        lib_paths = build_append_toml_array_item(
            lib_paths.clone(), build_dirname(cuda_lib.clone()).replace("\\", "/"));
        if (!build_has_lib(libs.clone(), "cuda")) {
            libs = build_append_toml_array_item(libs.clone(), "cuda");
        }
    }
    build_trace("target:" + target_name + ":after-cgu-expand objects_len=" + objects.len.toString());
    if (build_effective_is_android()
        && (target_kind == "executable" || target_kind == "exe"
            || target_kind == "shared" || target_kind == "dylib")) {
        let cxxlib = build_android_libcxx_opt_in(libs.clone(),
                                                 sources.clone(),
                                                 dci_stub_objects.len > 0);
        if (cxxlib.len > 0) {
            libs = build_append_toml_array_item(libs.clone(), cxxlib);
        }
    }
    libs = build_append_dci_rustc_native_libs(dci_stub_backend.clone(),
                                              dci_stub_objects.clone(),
                                              libs.clone());
    var link_cmd = build_link_command(target_kind.clone(),
                                      output_path.clone(),
                                      objects.clone(),
                                      lib_paths.clone(),
                                      libs.clone(),
                                      need_runtime,
                                      ar_tool_for_target.clone(),
                                      target_name.clone(),
                                      build_cache_dir.clone(),
                                      target_jobs);
    if (link_cmd == "|ERR|") { return "|ERR|"; }
    var strip_setting = build_toml_get_platform_value(manifest.clone(), section.clone(), "strip").trim();
    if (strip_setting.len == 0) {
        strip_setting = build_toml_get(manifest.clone(), "build", "strip").trim();
    }
    let want_strip = build_should_strip_executable(target_kind.clone(),
                                                   target_name.clone(),
                                                   vyxflags_raw.clone(),
                                                   passthrough_args.clone(),
                                                   strip_setting);
    if (want_strip) {
        let strip_link_flags = build_exe_strip_link_flags(build_cache_dir.clone());
        if (strip_link_flags == "|ERR|") {
            print(build_error_label() + ": failed to write executable strip version script");
            return "|ERR|";
        }
        link_cmd = link_cmd.clone() + strip_link_flags;
    }
    build_trace("target:" + target_name + ":after-link-command len=" + link_cmd.len.toString());
    target_profile_mark = build_profile_mark("target " + target_name + " link-command", target_profile_mark);
    let link_manifest_mtime = build_file_mtime("Vyx.toml");
    var link_record = "__link:" + target_name.clone();
    link_record = link_record.clone() + "\t";
    link_record = link_record.clone() + output_path.clone();
    link_record = link_record.clone() + "\t";
    link_record = link_record.clone() + link_manifest_mtime.toString();
    link_record = link_record.clone() + "\t";
    link_record = link_record.clone() + link_cmd.clone();
    if (want_strip) {
        link_record = link_record.clone() + "\tstrip-exe";
    }
    let link_aux_output = build_link_aux_output_path(target_kind.clone(), output_path.clone());
    // Interface policy is the same for cold links and cache hits.  A cached
    // stub/emit_vyi=false target must not acquire a new public interface.
    let emit_vyi_setting = build_toml_get_platform_value(manifest.clone(), section.clone(), "emit_vyi").trim();
    var emit_vyi_enabled = !(emit_vyi_setting == "false"
                             || emit_vyi_setting == "0"
                             || emit_vyi_setting == "no"
                             || emit_vyi_setting == "off");
    if (emit_vyi_setting.len == 0 && zyn_app_target && build_effective_is_android()) {
        emit_vyi_enabled = false;
    }
    let emit_library_interface = target_is_library && emit_vyi_enabled
        && build_path_stem(entry2.clone()) != "vyx_rt_stub";
    if (build_link_is_cached(new_cache.clone(),
                             link_record.clone(),
                             output_path.clone(),
                             link_aux_output.clone(),
                             objects.clone())) {
        print(build_progress_label(step_total.toString(), step_total) + " " + build_status_cache()
              + " " + build_status_link() + " -> " + build_path_label(output_path));
        if (emit_library_interface && vyi_sources.len > 0
            && build_library_interfaces_stale(target_name.clone(), output_dir2.clone(),
                                              entry2.clone(), vyi_sources.clone(),
                                              output_path.clone())) {
            let vyi_rc = build_emit_library_vyi_files(
                self_exe.clone(), target_name.clone(), output_dir2.clone(), entry2.clone(),
                vyi_sources.clone(), build_cache_dir.clone(), target_jobs, pass_args.clone(),
                build_write_vyi_decorated_sources(build_cache_dir.clone(), target_name.clone(),
                                                  sources.clone(), entry2.clone(), crate_compile_vyx));
            if (vyi_rc != 0) { return "|ERR|"; }
        }
    } else {
        let target_prelink_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "prelink", "");
        if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "prelink", target_prelink_hooks) != 0) {
            return "|ERR|";
        }
        print(build_progress_label(step_total.toString(), step_total) + " " + build_status_link()
              + " " + target_name + " -> " + build_path_label(output_path));
        let run_link_cmd = build_link_response_command(link_cmd.clone(), objects.clone(),
                                                       build_cache_dir.clone(), target_name.clone());
        if (run_link_cmd == "|ERR|") {
            print(build_error_label() + ": failed to write link response file for '"
                  + target_name + "'");
            return "|ERR|";
        }
        build_ensure_parent(output_path);
        var old_output: string = "";
        var renamed_output: bool = false;
        var old_aux_output: string = "";
        var renamed_aux_output: bool = false;
        if (link_aux_output.len > 0 && fileExists(link_aux_output.clone())) {
            old_aux_output = link_aux_output.clone() + ".old";
            if (fileExists(old_aux_output.clone()) && deleteFile(old_aux_output.clone()) != 0) {
                print(build_error_label() + ": cannot remove stale link backup: " + old_aux_output);
                return "|ERR|";
            }
            if (renameFile(link_aux_output.clone(), old_aux_output.clone()) != 0) {
                print(build_error_label() + ": cannot preserve prior link output: " + link_aux_output);
                return "|ERR|";
            }
            renamed_aux_output = true;
        }
        if (fileExists(output_path.clone())) {
            old_output = output_path.clone() + ".old";
            if (fileExists(old_output.clone()) && deleteFile(old_output.clone()) != 0) {
                build_restore_link_output(link_aux_output.clone(),
                                          old_aux_output.clone(),
                                          renamed_aux_output);
                print(build_error_label() + ": cannot remove stale link backup: " + old_output);
                return "|ERR|";
            }
            if (renameFile(output_path.clone(), old_output.clone()) != 0) {
                build_restore_link_output(link_aux_output.clone(),
                                          old_aux_output.clone(),
                                          renamed_aux_output);
                print(build_error_label() + ": cannot preserve prior link output: " + output_path);
                return "|ERR|";
            }
            renamed_output = true;
        }
        if (vyx_bootstrap_profile_level() > 0) {
            build_log("[vyxc] link-cmd: " + link_cmd);
        }
        let link_rc = build_run_process(run_link_cmd, "", "", "");
        if (link_rc != 0) {
            if (build_restore_link_outputs(output_path.clone(),
                                           old_output.clone(),
                                           renamed_output,
                                           link_aux_output.clone(),
                                           old_aux_output.clone(),
                                           renamed_aux_output) != 0) {
                print(build_error_label() + ": failed to restore prior link output: " + output_path);
            }
            print(build_error_label() + ": link failed for '" + target_name + "' (exit " + link_rc.toString() + ")");
            return "|ERR|";
        }
        if (!fileExists(output_path.clone())
            || fileSize(output_path.clone()) < 64
            || (link_aux_output.len > 0
                && (!fileExists(link_aux_output.clone()) || fileSize(link_aux_output.clone()) < 64))) {
            if (build_restore_link_outputs(output_path.clone(),
                                           old_output.clone(),
                                           renamed_output,
                                           link_aux_output.clone(),
                                           old_aux_output.clone(),
                                           renamed_aux_output) != 0) {
                print(build_error_label() + ": failed to restore prior link output: " + output_path);
            }
            print(build_error_label() + ": linker reported success without a valid output: " + output_path);
            return "|ERR|";
        }
        if (want_strip) {
            if (build_strip_linked_executable(output_path.clone()) != 0) {
                if (build_restore_link_outputs(output_path.clone(),
                                               old_output.clone(),
                                               renamed_output,
                                               link_aux_output.clone(),
                                               old_aux_output.clone(),
                                               renamed_aux_output) != 0) {
                    print(build_error_label() + ": failed to restore prior link output: " + output_path);
                }
                print(build_error_label() + ": strip failed for '" + target_name + "'");
                return "|ERR|";
            }
        }
        target_profile_mark = build_profile_mark("target " + target_name + " linker", target_profile_mark);
        if (need_runtime && !(target_kind == "static" || target_kind == "staticlib")) {
            build_copy_runtime_library(output_path);
            build_copy_tbb_runtime_library(output_path);
            // Also copy all dep shared libs into the output dir
            build_copy_dep_shared_libs(deps_for_target.clone(), output_path.clone());
        }
        let target_postlink_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "postlink", "");
        if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "postlink", target_postlink_hooks) != 0) {
            if (build_restore_link_outputs(output_path.clone(),
                                           old_output.clone(),
                                           renamed_output,
                                           link_aux_output.clone(),
                                           old_aux_output.clone(),
                                           renamed_aux_output) != 0) {
                print(build_error_label() + ": failed to restore prior link output: " + output_path);
            }
            return "|ERR|";
        }
        // For library targets (shared or static), also emit a .vyi interface file
        // so importing projects can use the library by name.
        // Skip for stub-only targets that have no meaningful Vyx surface.
        if (emit_library_interface) {
            let vyi_rc = build_emit_library_vyi_files(
                self_exe.clone(),
                target_name.clone(),
                output_dir2.clone(),
                entry2.clone(),
                vyi_sources.clone(),
                build_cache_dir.clone(),
                target_jobs,
                pass_args.clone(),
                build_write_vyi_decorated_sources(build_cache_dir.clone(),
                                                  target_name.clone(),
                                                  sources.clone(),
                                                  entry2.clone(),
                                                  crate_compile_vyx));
            if (vyi_rc != 0) {
                if (build_restore_link_outputs(output_path.clone(),
                                               old_output.clone(),
                                               renamed_output,
                                               link_aux_output.clone(),
                                               old_aux_output.clone(),
                                               renamed_aux_output) != 0) {
                    print(build_error_label() + ": failed to restore prior link output: " + output_path);
                }
                return "|ERR|";
            }
        }
        if (renamed_output && deleteFile(old_output.clone()) != 0) {
            build_log("warning: retained in-use link backup: " + old_output);
        }
        if (renamed_aux_output && deleteFile(old_aux_output.clone()) != 0) {
            build_log("warning: retained in-use link backup: " + old_aux_output);
        }
        target_profile_mark = build_profile_mark("target " + target_name + " postlink", target_profile_mark);
    }
    if (build_copy_output_aliases(output_path.clone(),
                                  target_kind.clone(),
                                  output_dir2.clone(),
                                  output_aliases_raw.clone(),
                                  self_exe.clone()) != 0) {
        return "|ERR|";
    }
    if (build_write_compiler_provenance_aliases(output_path.clone(),
                                                target_kind.clone(),
                                                output_dir2.clone(),
                                                output_aliases_raw.clone(),
                                                compiler_generation) != 0) {
        print(build_error_label() + ": cannot publish compiler provenance for " + output_path);
        return "|ERR|";
    }
    let target_postbuild_hooks = build_manifest_hook_lines(manifest.clone(), section.clone(), "postbuild", "post");
    if (build_run_hook_list(self_exe.clone(), "", target_name.clone(), "postbuild", target_postbuild_hooks) != 0) {
        return "|ERR|";
    }
    new_cache = build_cache_replace(new_cache.clone(), link_record);
    if (build_publish_text_file(cache_path.clone(), new_cache.clone()) != 0) {
        print(build_error_label() + ": cannot publish build cache: " + cache_path);
        return "|ERR|";
    }
    build_profile_mark("target " + target_name + " total", target_profile_total);
    print("  " + build_status_built() + " " + build_path_label(output_path));
    return new_cache;
}

/// Parse one dependency table. Raw rows are:
/// alias, path, requested target, usage, origin. `origin=local` denotes a
/// target in the current manifest (`{ target = "..." }` with no path).
fn build_inline_table_string(value: string, want_key: string) -> string {
    var text = value.trim();
    if (text.startsWith("{")) { text = text.substring(1, text.len).trim(); }
    if (text.endsWith("}")) { text = text.substring(0, text.len - 1).trim(); }
    var start: i32 = 0;
    var i: i32 = 0;
    var in_quote: bool = false;
    while (i <= text.len) {
        if (i == text.len || (!in_quote && text.charAt(i) == 44)) {
            let item = text.substring(start, i).trim();
            if (toml_key(item.clone()) == want_key) {
                var out = toml_value(item).trim();
                if (out.startsWith("\"") && out.endsWith("\"") && out.len >= 2) {
                    out = out.substring(1, out.len - 1);
                }
                return out;
            }
            start = i + 1;
        } else if (text.charAt(i) == 34) {
            in_quote = !in_quote;
        }
        i = i + 1;
    }
    return "";
}

fn build_collect_dependencies_in_section(manifest: string, want_section: string) -> string {
    var out: string = "";
    var section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= manifest.len) {
        if (i == manifest.len || manifest.charAt(i) == 10) {
            var line = manifest.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key.len > 0) {
                        var value = toml_value(line);
                        // Handle either: name = "path" OR
                        // name = { path = "...", target = "...", usage = "..." }.
                        let v_trim = value.trim();
                        if (v_trim.startsWith("{")) {
                            let configured_path = build_inline_table_string(v_trim.clone(), "path");
                            let version_v = build_inline_table_string(v_trim.clone(), "version");
                            let target_v = build_inline_table_string(v_trim.clone(), "target");
                            var usage_v = build_inline_table_string(v_trim, "usage").trim().toLower();
                            if (usage_v.len == 0) { usage_v = "private"; }
                            if (!(usage_v == "private" || usage_v == "public" || usage_v == "build")) {
                                print(build_error_label() + ": dependency '" + key
                                      + "' has invalid usage '" + usage_v
                                      + "' (expected private, public, or build)");
                                return "|ERR|";
                            }
                            var path_v: string = "";
                            var origin: string = "external";
                            if (configured_path.len == 0 && version_v.len > 0) {
                                path_v = build_resolve_registry_package(key, version_v);
                                if (path_v.len == 0) {
                                    print(build_error_label() + ": registry package not found: "
                                          + key + " " + version_v);
                                    return "|ERR|";
                                }
                            } else if (configured_path.len == 0) {
                                if (target_v.len == 0) {
                                    print(build_error_label() + ": dependency '" + key
                                          + "' requires path, version, or target");
                                    return "|ERR|";
                                }
                                path_v = ".";
                                origin = "local";
                            } else {
                                path_v = build_resolve_dependency_path(configured_path.clone());
                            }
                            if (configured_path.startsWith("std:") && path_v.len == 0) {
                                print(build_error_label() + ": standard package not found: " + configured_path);
                                return "|ERR|";
                            }
                            if (path_v.len > 0) {
                                out = out + key + "\t" + path_v + "\t" + target_v
                                      + "\t" + usage_v + "\t" + origin + "\n";
                            }
                        } else {
                            // Simple form: name = "path"
                            var path_v = v_trim;
                            if (path_v.startsWith("\"") && path_v.endsWith("\"") && path_v.len >= 2) {
                                path_v = path_v.substring(1, path_v.len - 1);
                            }
                            let configured_path = path_v.clone();
                            if (build_looks_like_version(configured_path)) {
                                path_v = build_resolve_registry_package(key, configured_path);
                                if (path_v.len == 0) {
                                    print(build_error_label() + ": registry package not found: "
                                          + key + " " + configured_path);
                                    return "|ERR|";
                                }
                            } else {
                                path_v = build_resolve_dependency_path(path_v);
                            }
                            if (configured_path.startsWith("std:") && path_v.len == 0) {
                                print(build_error_label() + ": standard package not found: " + configured_path);
                                return "|ERR|";
                            }
                            out = out + key + "\t" + path_v + "\t\tprivate\texternal\n";
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn build_dependency_rows_without_alias(rows: string, alias: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let line = build_line_at(rows.clone(), i);
        if (build_field(line.clone(), 0) != alias) { out = out + line + "\n"; }
        i = i + 1;
    }
    return out;
}

fn build_collect_dependencies(manifest: string) -> string {
    var out = build_collect_dependencies_in_section(manifest.clone(), "dependencies");
    if (out == "|ERR|") { return out; }
    if (build_manifest_is_zyn_app(manifest.clone()) && !build_dependency_lines_has(out.clone(), "Zyn")) {
        let sdk_root = build_zyn_sdk_root();
        if (sdk_root.len > 0) {
            out = out + "Zyn\t" + sdk_root + "\t\tprivate\texternal\n";
        }
    }
    return out;
}

/// Merge package-global dependencies with the dependencies owned by one
/// manifest target. A local alias deliberately overrides the global alias,
/// which makes ownership deterministic in multi-target packages.
fn build_collect_dependencies_for_target(manifest: string, target_section: string) -> string {
    var out = build_collect_dependencies(manifest.clone());
    if (out == "|ERR|") { return out; }
    if (target_section.len == 0) { return out; }
    let layers = build_effective_target_layers(manifest.clone(), target_section.clone());
    if (layers == "|ERR|") { return layers; }
    var removals: string = "";
    var layer_index: i64 = 0;
    let layer_count = build_line_count(layers.clone());
    while (layer_index < layer_count) {
        let layer = build_line_at(layers.clone(), layer_index);
        let local = build_collect_dependencies_in_section(
            manifest.clone(), layer.clone() + ".dependencies");
        if (local == "|ERR|") { return local; }
        var i: i64 = 0;
        let n = build_line_count(local.clone());
        while (i < n) {
            let line = build_line_at(local.clone(), i);
            let alias = build_field(line.clone(), 0);
            if (alias.len > 0) {
                out = build_dependency_rows_without_alias(out, alias);
                out = out + line + "\n";
            }
            i = i + 1;
        }
        removals = build_array_rows_append_unique(
            removals,
            toml_array_to_lines(build_toml_get_platform_array_raw(
                manifest.clone(), layer, "dependencies_remove")));
        layer_index = layer_index + 1;
    }
    var remove_index: i64 = 0;
    let remove_count = build_line_count(removals.clone());
    while (remove_index < remove_count) {
        out = build_dependency_rows_without_alias(
            out,
            build_line_at(removals.clone(), remove_index));
        remove_index = remove_index + 1;
    }
    return out;
}

fn build_rows_has_exact(rows: string, want: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        if (build_line_at(rows.clone(), i) == want) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_target_order_visit(manifest: string,
                            all_sections: string,
                            section: string,
                            visiting: string,
                            done: string) -> string {
    if (build_rows_has_exact(done.clone(), section.clone())) { return done; }
    if (build_rows_has_exact(visiting.clone(), section.clone())) {
        print(build_error_label() + ": target dependency cycle at '" + build_target_name(section, "") + "'");
        return "|ERR|";
    }
    var order = done;
    let next_visiting = visiting + section + "\n";
    var deps = toml_array_to_lines(
        build_toml_get_platform_array(manifest.clone(), section.clone(), "depends_on"));
    let declared = build_collect_dependencies_for_target(manifest.clone(), section.clone());
    if (declared == "|ERR|") { return declared; }
    var declared_index: i64 = 0;
    let declared_count = build_line_count(declared.clone());
    while (declared_index < declared_count) {
        let row = build_line_at(declared.clone(), declared_index);
        let dep_target = build_field(row.clone(), 2);
        let dep_origin = build_field(row, 4);
        if (dep_origin == "local" && dep_target.len > 0) {
            deps = build_append_unique_line(deps, dep_target);
        }
        declared_index = declared_index + 1;
    }
    var i: i64 = 0;
    let n = build_line_count(deps.clone());
    while (i < n) {
        let dep_name = build_line_at(deps.clone(), i).trim();
        if (dep_name.len > 0) {
            let dep_section = "target." + dep_name;
            if (!build_rows_has_exact(all_sections.clone(), dep_section.clone())) {
                print(build_error_label() + ": target '" + build_target_name(section.clone(), "")
                      + "' depends on missing target '" + dep_name + "'");
                return "|ERR|";
            }
            order = build_target_order_visit(manifest.clone(),
                                             all_sections.clone(),
                                             dep_section,
                                             next_visiting.clone(),
                                             order);
            if (order == "|ERR|") { return order; }
        }
        i = i + 1;
    }
    if (!build_rows_has_exact(order.clone(), section.clone())) {
        order = order + section + "\n";
    }
    return order;
}

fn build_target_build_order(manifest: string,
                            all_sections: string,
                            requested_target: string) -> string {
    if (requested_target.len > 0) {
        let requested_section = "target." + requested_target;
        if (!build_rows_has_exact(all_sections.clone(), requested_section.clone())) {
            print(build_error_label() + ": manifest target not found: '" + requested_target + "'");
            print("  available targets: " + all_sections.replace("target.", "").replace("\n", ", ").trim());
            return "|ERR|";
        }
        return build_target_order_visit(manifest,
                                        all_sections,
                                        requested_section,
                                        "",
                                        "");
    }
    var order: string = "";
    var i: i64 = 0;
    let n = build_line_count(all_sections.clone());
    while (i < n) {
        order = build_target_order_visit(manifest.clone(),
                                         all_sections.clone(),
                                         build_line_at(all_sections.clone(), i),
                                         "",
                                         order);
        if (order == "|ERR|") { return order; }
        i = i + 1;
    }
    return order;
}

/// Resolve each dependency alias to the actual linkable target declared by
/// that dependency's manifest. The returned fields are:
/// alias, path, target name, target kind, effective output directory.
fn build_dependency_usage_rank(usage: string) -> i32 {
    if (usage == "public") { return 3; }
    if (usage == "private") { return 2; }
    if (usage == "build") { return 1; }
    return 0;
}

fn build_dependency_row_with_usage(line: string, usage: string) -> string {
    return build_field(line, 0) + "\t"
        + build_field(line, 1) + "\t"
        + build_field(line, 2) + "\t"
        + build_field(line, 3) + "\t"
        + build_field(line, 4) + "\t"
        + build_field(line, 5) + "\t"
        + build_field(line, 6) + "\t"
        + build_field(line, 7) + "\t"
        + usage + "\t"
        + build_field(line, 9);
}

fn build_dependency_result_merge(rows: string, line: string) -> string {
    if (line.len == 0) { return rows; }
    let target_name = build_field(line.clone(), 2);
    let dep_path = build_field(line.clone(), 1);
    let incoming_usage = build_field(line.clone(), 8);
    var out: string = "";
    var merged = false;
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let existing = build_line_at(rows.clone(), i);
        if (!merged
            && build_field(existing.clone(), 1) == dep_path
            && build_field(existing.clone(), 2) == target_name) {
            let existing_usage = build_field(existing.clone(), 8);
            if (build_dependency_usage_rank(incoming_usage)
                > build_dependency_usage_rank(existing_usage)) {
                out = out + build_dependency_row_with_usage(existing, incoming_usage) + "\n";
            } else {
                out = out + existing + "\n";
            }
            merged = true;
        } else {
            out = out + existing + "\n";
        }
        i = i + 1;
    }
    if (!merged) { out = out + line + "\n"; }
    return out;
}

fn build_dependency_result_has_target(rows: string, target_name: string, dep_path: string) -> bool {
    var i: i64 = 0;
    let n = build_line_count(rows.clone());
    while (i < n) {
        let line = build_line_at(rows.clone(), i);
        if (build_field(line.clone(), 1) == dep_path
            && build_field(line, 2) == target_name) { return true; }
        i = i + 1;
    }
    return false;
}

fn build_dependency_public_paths(raw: string, dep_path: string) -> string {
    let entries = toml_array_to_lines(raw.clone());
    var out: string = "[";
    var first = true;
    var i: i64 = 0;
    let n = build_line_count(entries.clone());
    while (i < n) {
        var value = build_line_at(entries.clone(), i).trim();
        if (value.len > 0) {
            if (value.startsWith("\"") && value.endsWith("\"") && value.len >= 2) {
                value = value.substring(1, value.len - 1);
            }
            if (!build_is_abs_path(value.clone())) {
                value = build_join_path(dep_path.clone(), value);
            }
            value = value.replace("\\", "/");
            if (!first) { out = out + ", "; }
            out = out + "\"" + value + "\"";
            first = false;
        }
        i = i + 1;
    }
    return out + "]";
}

fn build_dependency_source_paths(manifest: string,
                                 section: string,
                                 dep_path: string) -> string {
    let entry = build_toml_get_platform_value(manifest.clone(), section.clone(), "entry");
    var raw = build_toml_get_platform_array(manifest.clone(), section, "sources");
    if (entry.len > 0) {
        raw = build_merge_toml_arrays(build_toml_single_path_array(entry), raw);
    }
    return build_dependency_public_paths(build_expand_env(raw), dep_path);
}

fn build_resolve_dependencies_inner(deps: string,
                                    active: string,
                                    depth: i32) -> string {
    if (depth > 64) {
        print(build_error_label() + ": dependency graph exceeds 64 levels");
        return "|ERR|";
    }
    var out: string = "";
    var i: i64 = 0;
    let n = build_line_count(deps.clone());
    while (i < n) {
        let line = build_line_at(deps.clone(), i);
        let dep_name = build_field(line.clone(), 0);
        var dep_path = build_expand_env(build_field(line.clone(), 1));
        let requested_target = build_field(line.clone(), 2);
        var dependency_usage = build_field(line.clone(), 3);
        let dependency_origin = build_field(line.clone(), 4);
        if (dependency_usage.len == 0) { dependency_usage = "private"; }
        if (dep_name.len > 0 && dep_path.len > 0) {
            dep_path = build_abs_norm_path(dep_path.clone());
            let manifest_path = build_join_path(dep_path.clone(), "Vyx.toml");
            let manifest = readFile(manifest_path.clone());
            if (manifest.len == 0 && !fileExists(manifest_path.clone())) {
                print(build_error_label() + ": dependency manifest not found: " + manifest_path);
                return "|ERR|";
            }
            var pkg_name = build_toml_get(manifest.clone(), "package", "name");
            if (pkg_name.len == 0) { pkg_name = dep_name.clone(); }
            let sections = build_target_sections(manifest.clone(), pkg_name.clone());
            if (!build_validate_manifest_templates(manifest.clone(), sections.clone())) {
                return "|ERR|";
            }
            var section: string = "";
            if (requested_target.len > 0) {
                let requested_section = "target." + requested_target;
                if (!build_rows_has_exact(sections.clone(), requested_section.clone())) {
                    print(build_error_label() + ": dependency '" + dep_name
                          + "' has no target '" + requested_target + "'");
                    return "|ERR|";
                }
                section = requested_section;
            } else if (build_rows_has_exact(sections.clone(), "target." + dep_name)) {
                section = "target." + dep_name;
            } else if (build_rows_has_exact(sections.clone(), "target." + pkg_name)) {
                section = "target." + pkg_name;
            } else if (build_line_count(sections.clone()) == 1) {
                section = build_line_at(sections.clone(), 0);
            } else {
                print(build_error_label() + ": dependency '" + dep_name
                      + "' has multiple targets; select one with { path = \"...\", target = \"...\" }");
                return "|ERR|";
            }
            let target_name = build_target_name(section.clone(), pkg_name.clone());
            let dependency_key = dep_path.clone() + "#" + target_name.clone();
            if (build_contains("|" + active.clone() + "|", "|" + dependency_key.clone() + "|")) {
                print(build_error_label() + ": dependency cycle through " + dependency_key);
                return "|ERR|";
            }
            var target_kind = build_toml_get_platform_value(manifest.clone(), section.clone(), "type");
            if (target_kind.len == 0) { target_kind = "executable"; }
            if (target_kind == "executable" && dependency_usage != "build") {
                print(build_error_label() + ": executable dependency '" + dep_name
                      + "' target '" + target_name + "' requires usage=\"build\"");
                return "|ERR|";
            }
            if (!(target_kind == "shared" || target_kind == "dylib"
                  || target_kind == "static" || target_kind == "staticlib"
                  || target_kind == "source" || target_kind == "executable")) {
                print(build_error_label() + ": dependency '" + dep_name + "' target '"
                      + target_name + "' must be static, shared, source, or a build-only executable (type="
                      + target_kind + ")");
                return "|ERR|";
            }
            var output_dir = build_toml_get_platform_value(manifest.clone(), section.clone(), "output_dir");
            if (output_dir.len == 0) {
                output_dir = build_toml_get_platform_value(manifest.clone(), section.clone(), "out_dir");
            }
            if (output_dir.len == 0) {
                output_dir = build_toml_get_platform_value(manifest.clone(), "build", "output_dir");
            }
            if (output_dir.len == 0) {
                output_dir = build_toml_get_platform_value(manifest.clone(), "build", "out_dir");
            }
            if (output_dir.len == 0) { output_dir = "out"; }
            var public_lib_paths = build_toml_get_triplet_link_array(
                manifest.clone(), section.clone(), "public_lib_paths", target_kind.clone());
            var public_libs = build_toml_get_triplet_link_array(
                manifest.clone(), section.clone(), "public_libs", target_kind.clone());
            if (target_kind == "static" || target_kind == "staticlib") {
                if (public_lib_paths.len == 0) {
                    public_lib_paths = build_toml_get_triplet_link_array(
                        manifest.clone(), section.clone(), "lib_paths", target_kind.clone());
                }
                if (public_libs.len == 0) {
                    public_libs = build_toml_get_triplet_link_array(
                        manifest.clone(), section.clone(), "libs", target_kind.clone());
                }
                public_lib_paths = build_merge_toml_arrays(
                    public_lib_paths,
                    build_auto_triplet_lib_paths_from(
                        build_abs_norm_path(dep_path.clone()), target_kind.clone()));
            }
            public_lib_paths = build_dependency_public_paths(build_expand_env(public_lib_paths),
                                                             dep_path.clone());
            var source_paths: string = "";
            if (target_kind == "source") {
                source_paths = build_dependency_source_paths(manifest.clone(), section.clone(), dep_path.clone());
                let source_lines = toml_array_to_lines(source_paths.clone());
                let source_count = build_line_count(source_lines.clone());
                if (source_count <= 0) {
                    print(build_error_label() + ": source dependency '" + dep_name
                          + "' target '" + target_name + "' exposes no source files");
                    return "|ERR|";
                }
                var source_index: i64 = 0;
                while (source_index < source_count) {
                    let source_path = build_line_at(source_lines.clone(), source_index);
                    if (source_path.len == 0 || !fileExists(source_path.clone())) {
                        print(build_error_label() + ": source dependency '" + dep_name
                              + "' target '" + target_name
                              + "' references missing source: " + source_path);
                        return "|ERR|";
                    }
                    source_index = source_index + 1;
                }
            }
            let resolved_line = dep_name + "\t" + dep_path + "\t" + target_name
                    + "\t" + target_kind + "\t" + output_dir
                    + "\t" + public_lib_paths + "\t" + public_libs
                    + "\t" + source_paths + "\t" + dependency_usage
                    + "\t" + dependency_origin;
            out = build_dependency_result_merge(out, resolved_line);

            // Resolve the child's own dependencies into the same link closure.
            // Relative child paths are interpreted from the child package root,
            // then normalized before cycle detection and deduplication.
            let child_deps = build_collect_dependencies_for_target(manifest.clone(), section.clone());
            if (child_deps == "|ERR|") { return "|ERR|"; }
            var child_lines: string = "";
            var ci: i64 = 0;
            let cn = build_line_count(child_deps.clone());
            while (ci < cn) {
                let child_line = build_line_at(child_deps.clone(), ci);
                let child_name = build_field(child_line.clone(), 0);
                var child_path = build_field(child_line.clone(), 1);
                let child_target = build_field(child_line.clone(), 2);
                let child_usage = build_field(child_line.clone(), 3);
                let child_origin = build_field(child_line, 4);
                var effective_child_usage = child_usage.clone();
                if (dependency_usage == "build") {
                    effective_child_usage = "build";
                }
                // The build/link/source consumption closure follows both
                // private and public dependency edges. Build-only edges are
                // intentionally resolved by the dependency's own project
                // invocation and must not leak into this consumer's link set.
                if (effective_child_usage == "build") {
                    ci = ci + 1;
                    continue;
                }
                if (child_origin == "local") {
                    child_path = dep_path.clone();
                } else if (child_path.len > 0 && !build_is_abs_path(child_path.clone())) {
                    child_path = build_join_path(dep_path.clone(), child_path);
                }
                child_lines = child_lines + child_name + "\t" + child_path
                              + "\t" + child_target + "\t" + effective_child_usage
                              + "\t" + child_origin + "\n";
                ci = ci + 1;
            }
            if (child_lines.len > 0) {
                let nested = build_resolve_dependencies_inner(child_lines,
                                                               active.clone() + dependency_key + "|",
                                                               depth + 1);
                if (nested == "|ERR|") { return "|ERR|"; }
                var ni: i64 = 0;
                let nn = build_line_count(nested.clone());
                while (ni < nn) {
                    let nested_line = build_line_at(nested.clone(), ni);
                    out = build_dependency_result_merge(out, nested_line);
                    ni = ni + 1;
                }
            }
        }
        i = i + 1;
    }
    return out;
}

fn build_resolve_dependencies(deps: string) -> string {
    return build_resolve_dependencies_inner(deps, "", 0);
}

/// Build a dependency project (recursively invoke boot.exe build in its dir).
/// Returns 0 on success, non-zero on error.
fn build_project_lock_path(cache_dir: string) -> string {
    return build_join_path(cache_dir, ".vyx_build.lock");
}

fn build_project_lock_acquire(cache_dir: string, owner_name: string) -> string {
    if (build_make_dir(cache_dir.clone()) != 0) {
        print("error: failed to create build cache directory: " + cache_dir);
        return "";
    }

    let lock_path = build_project_lock_path(cache_dir.clone());
    let lock_host_path = build_host_path(lock_path.clone());
    let owner = "project=" + owner_name + "\ncompiler=" + getArg(0);
    var waited_ms: i64 = 0;
    var announced: bool = false;
    while (waited_ms < 600000) {
        let rc = vyx_bootstrap_build_lock_try_acquire(lock_host_path.c_str(), owner.c_str());
        if (rc == 0) {
            if (announced) {
                print("[build] acquired project lock for " + owner_name);
            }
            return lock_path;
        }
        if (rc != 1) {
            print("error: failed to acquire project build lock: " + lock_path);
            return "";
        }
        if (!announced) {
            print("[build] waiting for project lock: " + owner_name + " (" + lock_path + ")");
            announced = true;
        }
        vyx_bootstrap_sleep_ms(80);
        waited_ms = waited_ms + 80;
    }
    print("error: timed out waiting for project build lock: " + owner_name + " (" + lock_path + ")");
    return "";
}

fn build_project_lock_release(lock_path: string) -> i32 {
    if (lock_path.len == 0) { return 0; }
    return vyx_bootstrap_build_lock_release(build_host_path(lock_path).c_str());
}

fn build_project_lock_finish(lock_path: string, result: i32) -> i32 {
    let lock_rc = build_project_lock_release(lock_path.clone());
    if (lock_rc != 0) {
        print("error: failed to release project build lock: " + lock_path);
        return 1;
    }
    return result;
}

fn build_dependency(self_exe: string,
                    dep_path: string,
                    dep_name: string,
                    dep_target: string) -> i32 {
    print("[dep] building " + dep_name + " (" + dep_path + ")");
    if (build_abs_norm_path(dep_path.clone()) == build_abs_norm_path(".")) {
        print("error: project cannot depend on itself: " + dep_name + " (" + dep_path + ")");
        return 1;
    }
    let exe_arg = build_tool_arg(build_abs_norm_path(self_exe));
    let forward_args = build_cli_recursive_build_passthrough();
    var target_arg: string = "";
    if (dep_target.len > 0) {
        target_arg = " --target " + build_quote(dep_target);
    }
    let cmd = exe_arg + " build" + target_arg + forward_args;
    return build_run_process(cmd, dep_path, "", "");
}

/// For a list of dependencies, return the auto-injected lib_paths / libs to merge.
fn build_dep_lib_paths_libs(deps: string) -> string {
    // Returns "lib_paths_array\tlibs_array" (TOML array literal form)
    var paths: string = "[";
    var libs: string = "[";
    var first_path = true;
    var first_lib = true;
    var i: i64 = 0;
    let n = build_line_count(deps);
    while (i < n) {
        let line = build_line_at(deps, i);
        let dep_name = build_field(line.clone(), 0);
        let dep_path = build_field(line.clone(), 1);
        let target_name = build_field(line.clone(), 2);
        let target_output_dir = build_field(line.clone(), 4);
        let dependency_usage = build_field(line, 8);
        if (dep_name.len > 0 && dep_path.len > 0
            && target_name.len > 0 && target_output_dir.len > 0
            && dependency_usage != "build") {
            let out_dir = build_dep_output_path(dep_path.clone(), target_output_dir);
            if (!first_path) { paths = paths + ", "; }
            paths = paths + "\"" + out_dir + "\"";
            first_path = false;
            if (!first_lib) { libs = libs + ", "; }
            libs = libs + "\"" + target_name + "\"";
            first_lib = false;
        }
        i = i + 1;
    }
    paths = paths + "]";
    libs = libs + "]";
    return paths + "\t" + libs;
}

public fn build_system_run() -> i32 {
    let requested_triplet = policy_cli_requested_triplet();
    if (requested_triplet.len > 0) {
        let canonical_target = policy_target_canonical_triple(requested_triplet.clone());
        let target_error = policy_target_validation_error(canonical_target.clone());
        if (target_error.len > 0) {
            print("error: unsupported LLVM target triple `" + canonical_target + "`: " + target_error);
            return 1;
        }
    }
    // `build --src=project <dir> --emit=<kind>` is intentionally a thin
    // alias for the canonical project compiler invocation.  Keep the legacy
    // no-source form below as the manifest-wide, dependency-aware build.
    if (build_cli_has_source_selector()) {
        return build_cli_run_source_compile();
    }

    if (build_effective_is_android() && !build_cli_has_explicit_sysroot()
        && build_android_sysroot_path().len == 0) {
        print("error: Android triplet requires an NDK sysroot");
        print("  set ANDROID_NDK_ROOT/ANDROID_NDK_HOME, or pass --sysroot <ndk>/toolchains/llvm/prebuilt/<host>/sysroot");
        return 1;
    }

    let manifest_path = "Vyx.toml";
    let manifest = readFile(manifest_path);
    if (manifest.len == 0 && !fileExists(manifest_path)) {
        print("error: no Vyx.toml found in current directory");
        return 1;
    }

    var pkg_name = build_toml_get(manifest.clone(), "package", "name");
    let pkg_version = build_toml_get(manifest.clone(), "package", "version");
    let pkg_entry = build_toml_get(manifest.clone(), "package", "entry");
    var build_output_dir = build_toml_get_platform_value(manifest.clone(), "build", "output_dir");
    if (build_output_dir.len == 0) {
        build_output_dir = build_toml_get_platform_value(manifest.clone(), "build", "out_dir");
    }
    var build_cache_dir = build_toml_get_platform_value(manifest.clone(), "build", "cache_dir");
    var manifest_threads = build_parse_int(build_toml_get(manifest.clone(), "build", "threads"));
    if (pkg_name.len == 0) { pkg_name = "app"; }
    if (build_cache_dir.len == 0) { build_cache_dir = ".cache"; }
    build_cache_dir = build_expand_env(build_cache_dir);
    if (manifest_threads <= 0) { manifest_threads = vyx_bootstrap_hw_threads(); }
    let jobs = build_cli_jobs(manifest_threads);
    let requested_build_target = policy_cli_requested_build_target().trim();
    let all_sections = build_target_sections(manifest.clone(), pkg_name.clone());
    if (!build_validate_manifest_templates(manifest.clone(), all_sections.clone())) { return 1; }
    let sections = build_target_build_order(manifest.clone(),
                                            all_sections,
                                            requested_build_target.clone());
    if (sections == "|ERR|") { return 1; }

    var selection_label: string = "";
    if (requested_build_target.len > 0) {
        selection_label = selection_label + " target=" + requested_build_target;
    }
    if (requested_triplet.len > 0) {
        selection_label = selection_label + " triplet=" + policy_cli_target_triple();
    }
    print(build_color("1;32", "building") + " " + pkg_name.clone() + " v" + pkg_version
          + " (" + jobs.toString() + " thread(s))" + selection_label);
    let project_lock = build_project_lock_acquire(".cache", pkg_name.clone());
    if (project_lock.len == 0) { return 1; }
    if (build_make_dir(build_cache_dir.clone()) != 0) {
        print("error: failed to create build cache directory: " + build_cache_dir);
        return build_project_lock_finish(project_lock, 1);
    }

    let build_pre_hooks = build_manifest_hook_lines(manifest.clone(), "build", "prebuild", "pre");
    if (build_run_hook_list(getArg(0), "", pkg_name.clone(), "prebuild", build_pre_hooks) != 0) {
        return build_project_lock_finish(project_lock, 1);
    }

    let self_exe_for_deps = getArg(0);
    let cache_path = build_join_path(build_cache_dir.clone(), ".vyx_cache");
    var cache_text = readFile(cache_path);
    var built_dependencies: string = "";
    var i: i64 = 0;
    let n = build_line_count(sections);
    while (i < n) {
        let section = build_line_at(sections.clone(), i);
        let raw_deps = build_collect_dependencies_for_target(manifest.clone(), section.clone());
        if (raw_deps == "|ERR|") { return build_project_lock_finish(project_lock, 1); }
        let deps = build_resolve_dependencies(raw_deps);
        if (deps == "|ERR|") { return build_project_lock_finish(project_lock, 1); }
        var di: i64 = 0;
        let dn = build_line_count(deps.clone());
        while (di < dn) {
            let dep_line = build_line_at(deps.clone(), di);
            let dep_name = build_field(dep_line.clone(), 0);
            let dep_path = build_field(dep_line.clone(), 1);
            let dep_target = build_field(dep_line.clone(), 2);
            let dep_kind = build_field(dep_line.clone(), 3);
            let dep_origin = build_field(dep_line.clone(), 9);
            let dep_key = build_abs_norm_path(dep_path.clone()) + "\t" + dep_target;
            if (dep_kind != "source" && dep_name.len > 0 && dep_path.len > 0
                && dep_origin != "local"
                && !build_rows_has_exact(built_dependencies.clone(), dep_key.clone())) {
                let dep_rc = build_dependency(self_exe_for_deps.clone(),
                                              build_expand_env(dep_path),
                                              dep_name,
                                              dep_target);
                if (dep_rc != 0) {
                    print("error: failed to build dependency '" + dep_name
                          + "' target '" + dep_target + "' (exit " + dep_rc.toString() + ")");
                    return build_project_lock_finish(project_lock, 1);
                }
                built_dependencies = built_dependencies + dep_key + "\n";
            }
            di = di + 1;
        }
        cache_text = build_one_target(manifest.clone(),
                                      cache_path.clone(),
                                      cache_text.clone(),
                                      pkg_name.clone(),
                                      pkg_entry.clone(),
                                      build_output_dir.clone(),
                                      build_cache_dir.clone(),
                                      section,
                                      jobs);
        if (cache_text == "|ERR|") { return build_project_lock_finish(project_lock, 1); }
        i = i + 1;
    }
    let build_post_hooks = build_manifest_hook_lines(manifest.clone(), "build", "postbuild", "post");
    if (build_run_hook_list(getArg(0), "", pkg_name.clone(), "postbuild", build_post_hooks) != 0) {
        return build_project_lock_finish(project_lock, 1);
    }
    print("build complete!");
    return build_project_lock_finish(project_lock, 0);
}

public fn build_system_run_script() -> i32 {
    let manifest_path = "Vyx.toml";
    let manifest = readFile(manifest_path);
    if (manifest.len == 0 && !fileExists(manifest_path)) {
        print("error: no Vyx.toml found in current directory");
        return 1;
    }

    var pkg_name = build_toml_get(manifest.clone(), "package", "name");
    if (pkg_name.len == 0) { pkg_name = "app"; }

    let argc = argCount();
    if (argc < 3) {
        print("error: no script specified");
        print("usage: " + getArg(0) + " run <script|package:script>");
        return 1;
    }

    let spec = getArg(2).trim();
    let split = build_script_spec_split(spec);
    let pkg = build_field(split.clone(), 0);
    let script = build_field(split, 1);
    if (script.len == 0) {
        print("error: empty script name");
        return 1;
    }
    if (pkg.len > 0 && pkg != pkg_name) {
        print("error: script package '" + pkg + "' does not match current package '" + pkg_name + "'");
        return 1;
    }

    let script_lines = build_manifest_script_lines(manifest.clone(), script);
    if (script_lines.len == 0) {
        print("error: script not found: " + script);
        return 1;
    }

    print("running " + pkg_name + ":" + script);
    return build_run_script_list(getArg(0), "", pkg_name, script, script_lines, build_run_script_extra_args());
}

fn build_project_identifier(text: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90)
            || (c >= 97 && c <= 122) || c == 95) {
            out = out + text.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { return "app"; }
    let first = out.charAt(0);
    if (first >= 48 && first <= 57) { out = "app_" + out; }
    return out;
}

/// Create the canonical manifest project shape. Common source packages are
/// explicit global dependencies by default; `--bare` creates a dependency-free
/// manifest for compiler/runtime bring-up projects.
public fn build_system_new_project() -> i32 {
    if (argCount() < 3) {
        print("usage: " + getArg(0) + " new <directory> [--bare]");
        return 1;
    }
    let root = getArg(2).trim();
    if (root.len == 0 || root.startsWith("-")) {
        print("error: project directory is required");
        return 1;
    }
    let manifest_path = build_join_path(root.clone(), "Vyx.toml");
    if (fileExists(manifest_path.clone())) {
        print("error: project already contains Vyx.toml: " + manifest_path);
        return 1;
    }
    if (build_make_dir(build_join_path(root.clone(), "src")) != 0) {
        print("error: cannot create project directory: " + root);
        return 1;
    }
    var bare = false;
    var i: i32 = 3;
    while (i < argCount()) {
        if (getArg(i) == "--bare") { bare = true; }
        i = i + 1;
    }
    let name = build_project_identifier(build_path_stem(root.clone()));
    var deps: string = "";
    if (!bare) {
        deps = "\n[dependencies]\n"
             + "core = { path = \"std:core\", target = \"std_core\" }\n"
             + "collections = { path = \"std:collections\", target = \"std_collections\" }\n";
    }
    let manifest = "[package]\n"
                 + "name = \"" + name + "\"\n"
                 + "version = \"0.1.0\"\n"
                 + "entry = \"src/main.vyx\"\n\n"
                 + "[build]\n"
                 + "cache_dir = \".cache\"\n"
                 + "output_dir = \"target\"\n"
                 + "threads = 0\n"
                 + deps + "\n"
                 + "[target." + name + "]\n"
                 + "type = \"executable\"\n"
                 + "entry = \"src/main.vyx\"\n"
                 + "auto_sources = false\n";
    let main_source = "module " + name + ";\n\n"
                    + "fn main() -> i32 {\n"
                    + "    print(\"Hello, Vyx!\");\n"
                    + "    return 0;\n"
                    + "}\n";
    if (writeFile(manifest_path.clone(), manifest) != 0
        || writeFile(build_join_path(build_join_path(root.clone(), "src"), "main.vyx"), main_source) != 0) {
        print("error: cannot write project files under " + root);
        return 1;
    }
    print("created " + name + " at " + root);
    if (!bare) { print("  dependencies: std:core, std:collections"); }
    return 0;
}

fn build_dci_cli_script() -> string {
    let configured = build_env_value("VYX_DCI_TOOLS");
    if (configured.len > 0) {
        let direct = build_join_path(configured.clone(), "dci.py");
        if (fileExists(direct.clone())) { return direct; }
        if (fileExists(configured.clone()) && configured.endsWith(".py")) { return configured; }
    }
    var exe_dir = build_exe_dir();
    if (argCount() > 0) { exe_dir = build_dirname(build_abs_norm_path(getArg(0))); }
    let parent = build_dirname(exe_dir.clone());
    let grand = build_dirname(parent.clone());
    let candidates = build_join_path(exe_dir.clone(), "tools/dci/dci.py") + "\n"
                   + build_join_path(parent.clone(), "tools/dci/dci.py") + "\n"
                   + build_join_path(grand, "tools/dci/dci.py") + "\n"
                   + "tools/dci/dci.py\n";
    var i: i64 = 0;
    let n = build_line_count(candidates.clone());
    while (i < n) {
        let candidate = build_line_at(candidates.clone(), i);
        if (fileExists(candidate.clone())) { return candidate; }
        i = i + 1;
    }
    return "";
}

fn build_dci_python() -> string {
    let configured = build_env_value("VYX_PYTHON");
    if (configured.len > 0) { return configured; }
    var python_name = "python3";
    if (build_is_windows()) { python_name = "python.exe"; }
    var found = build_find_tool_on_path(python_name);
    if (found.len > 0) { return found; }
    found = build_find_tool_on_path("python");
    return found;
}

public fn build_system_run_dci() -> i32 {
    let script = build_dci_cli_script();
    if (script.len == 0) {
        print("error: DCI CLI not found; set VYX_DCI_TOOLS to the tools/dci directory");
        return 1;
    }
    let python = build_dci_python();
    if (python.len == 0) {
        print("error: Python 3 not found; set VYX_PYTHON to the interpreter path");
        return 1;
    }
    var args: string = "";
    var i: i32 = 2;
    while (i < argCount()) {
        args = args + " " + build_quote_arg(getArg(i));
        i = i + 1;
    }
    let cmd = build_tool_arg(python) + " " + build_quote(script) + args;
    return build_run_process(cmd, "", "", "");
}
