module bootstrap.pkg;

use std.fs;
use std.string;

/// Lab package manager: file:// registry, publish / install / search / lock.
///
/// Registry root (`VYX_REGISTRY`, else `./.vyx-registry`):
///   index.txt                 name<TAB>version<TAB>description
///   pkgs/<name>/<version>/    published tree (Vyx.toml + sources)

extern "C" {
    fn getenv(name: rawptr) -> rawptr;
    fn vyx_bootstrap_mkdir_p(path: rawptr) -> i32;
    fn vyx_bootstrap_copy_tree(src: rawptr, dst: rawptr) -> i32;
}

fn pkg_env(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

public fn pkg_registry_root() -> string {
    var root = pkg_env("VYX_REGISTRY");
    if (root.len == 0) { root = ".vyx-registry"; }
    if (root.startsWith("file://")) {
        root = root.substring(7, root.len);
    }
    return root;
}

fn pkg_join(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    if (b.len == 0) { return a; }
    let last = a.charAt(a.len - 1);
    if (last == 47 || last == 92) { return a + b; }
    return a + "/" + b;
}

fn pkg_toml_unquote(v: string) -> string {
    var s = v.trim();
    if (s.startsWith("\"") && s.endsWith("\"") && s.len >= 2) {
        return s.substring(1, s.len - 1);
    }
    return s;
}

fn pkg_toml_get(manifest: string, section: string, key: string) -> string {
    var cur: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= manifest.len) {
        if (i == manifest.len || manifest.charAt(i) == 10) {
            var line = manifest.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.len > 0 && !line.startsWith("#")) {
                if (line.startsWith("[") && line.endsWith("]")) {
                    cur = line.substring(1, line.len - 1);
                } else if (cur == section) {
                    let eq = line.indexOf("=");
                    if (eq > 0) {
                        let k = line.substring(0, eq).trim();
                        if (k == key) {
                            return pkg_toml_unquote(line.substring(eq + 1, line.len));
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn pkg_read_cwd_manifest() -> string {
    if (fileExists("Vyx.toml")) { return readFile("Vyx.toml"); }
    if (fileExists("vyx.toml")) { return readFile("vyx.toml"); }
    return "";
}

fn pkg_index_path(root: string) -> string {
    return pkg_join(root, "index.txt");
}

fn pkg_pkg_dir(root: string, name: string, version: string) -> string {
    return pkg_join(pkg_join(pkg_join(root, "pkgs"), name), version);
}

fn pkg_cache_dir(name: string, version: string) -> string {
    return pkg_join(pkg_join(pkg_join(".cache", "registry"), name), version);
}

fn pkg_looks_like_version(s: string) -> bool {
    if (s.len == 0) { return false; }
    if (s.contains("/") || s.contains("\\") || s.contains(":")) { return false; }
    var digits: i32 = 0;
    var i: i32 = 0;
    while (i < s.len) {
        let c = s.charAt(i);
        if (c >= 48 && c <= 57) { digits = digits + 1; }
        else if (c != 46) { return false; }
        i = i + 1;
    }
    return digits > 0;
}

fn pkg_index_upsert(root: string, name: string, version: string, desc: string) {
    let path = pkg_index_path(root);
    var out: string = "";
    if (fileExists(path)) {
        let old = readFile(path);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= old.len) {
            if (i == old.len || old.charAt(i) == 10) {
                var line = old.substring(start, i);
                if (line.endsWith("\r")) { line = line.substring(0, line.len - 1); }
                if (line.len > 0) {
                    let tab = line.indexOf("\t");
                    var keep = true;
                    if (tab > 0 && line.substring(0, tab) == name) {
                        let rest = line.substring(tab + 1, line.len);
                        let tab2 = rest.indexOf("\t");
                        var ver = rest;
                        if (tab2 >= 0) { ver = rest.substring(0, tab2); }
                        if (ver == version) { keep = false; }
                    }
                    if (keep) { out = out + line + "\n"; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }
    out = out + name + "\t" + version + "\t" + desc + "\n";
    writeFile(path, out);
}

fn pkg_index_find(root: string, name: string, version: string) -> string {
    let path = pkg_index_path(root);
    if (!fileExists(path)) { return ""; }
    let old = readFile(path);
    var start: i32 = 0;
    var i: i32 = 0;
    var best: string = "";
    while (i <= old.len) {
        if (i == old.len || old.charAt(i) == 10) {
            var line = old.substring(start, i);
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1); }
            if (line.len > 0) {
                let tab = line.indexOf("\t");
                if (tab > 0 && line.substring(0, tab) == name) {
                    let rest = line.substring(tab + 1, line.len);
                    let tab2 = rest.indexOf("\t");
                    var ver = rest;
                    if (tab2 >= 0) { ver = rest.substring(0, tab2); }
                    if (version.len == 0 || ver == version) { best = ver; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return best;
}

public fn pkg_resolve_version(name: string, version: string) -> string {
    if (name.len == 0) { return ""; }
    var ver = version;
    let cache = pkg_cache_dir(name, ver);
    if (ver.len > 0 && fileExists(pkg_join(cache, "Vyx.toml"))) { return cache; }
    let root = pkg_registry_root();
    if (ver.len == 0) { ver = pkg_index_find(root, name, ""); }
    if (ver.len == 0) { return ""; }
    let hit = pkg_pkg_dir(root, name, ver);
    if (fileExists(pkg_join(hit, "Vyx.toml"))) { return hit; }
    return "";
}

fn pkg_write_lock_line(name: string, version: string, path: string) {
    var body: string = "";
    if (fileExists("Vyx.lock")) { body = readFile("Vyx.lock"); }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= body.len) {
        if (i == body.len || body.charAt(i) == 10) {
            var line = body.substring(start, i);
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1); }
            if (line.len > 0) {
                let tab = line.indexOf("\t");
                if (!(tab > 0 && line.substring(0, tab) == name)) {
                    out = out + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    out = out + name + "\t" + version + "\t" + path + "\n";
    writeFile("Vyx.lock", out);
}

fn pkg_ensure_dep_toml(name: string, version: string, path: string) {
    var manifest = pkg_read_cwd_manifest();
    if (manifest.len == 0) {
        manifest = "[package]\nname = \"app\"\nversion = \"0.0.0\"\n\n[dependencies]\n";
    }
    let needle = name + " =";
    if (manifest.contains(needle)) { return; }
    if (!manifest.contains("[dependencies]")) {
        manifest = manifest + "\n[dependencies]\n";
    }
    manifest = manifest + name + " = { path = \"" + path + "\", version = \"" + version + "\" }\n";
    writeFile("Vyx.toml", manifest);
}

public fn pkg_cmd_publish() -> i32 {
    let manifest = pkg_read_cwd_manifest();
    if (manifest.len == 0) {
        print("vyx publish: no Vyx.toml in the current directory");
        return 1;
    }
    let name = pkg_toml_get(manifest, "package", "name");
    var version = pkg_toml_get(manifest, "package", "version");
    if (name.len == 0) {
        print("vyx publish: [package].name is required");
        return 1;
    }
    if (version.len == 0) { version = "0.0.0"; }
    let root = pkg_registry_root();
    vyx_bootstrap_mkdir_p(root.c_str());
    let dest = pkg_pkg_dir(root, name, version);
    vyx_bootstrap_mkdir_p(dest.c_str());
    if (vyx_bootstrap_copy_tree(".".c_str(), dest.c_str()) != 0) {
        print("vyx publish: failed to copy package tree into " + dest);
        return 1;
    }
    pkg_index_upsert(root, name, version, pkg_toml_get(manifest, "package", "description"));
    print("published " + name + " " + version + " -> " + dest);
    return 0;
}

public fn pkg_cmd_install(name: string, version: string) -> i32 {
    if (name.len == 0) {
        return pkg_cmd_install_manifest();
    }
    let src = pkg_resolve_version(name, version);
    if (src.len == 0) {
        print("vyx install: package not found in registry: " + name);
        return 1;
    }
    var ver = version;
    if (ver.len == 0) { ver = pkg_index_find(pkg_registry_root(), name, ""); }
    if (ver.len == 0) { ver = "0.0.0"; }
    let dest = pkg_cache_dir(name, ver);
    var copied: i32 = 0;
    if (src == dest || fileExists(pkg_join(dest, "Vyx.toml"))) {
        copied = 0;
    } else {
        vyx_bootstrap_mkdir_p(dest.c_str());
        copied = vyx_bootstrap_copy_tree(src.c_str(), dest.c_str());
    }
    if (copied != 0) {
        print("vyx install: failed to materialize " + name + " into " + dest);
        return 1;
    }
    pkg_write_lock_line(name, ver, dest);
    pkg_ensure_dep_toml(name, ver, dest);
    print("installed " + name + " " + ver + " -> " + dest);
    return 0;
}

fn pkg_cmd_install_manifest() -> i32 {
    let manifest = pkg_read_cwd_manifest();
    if (manifest.len == 0) {
        print("vyx install: no Vyx.toml and no package name given");
        return 1;
    }
    var rc: i32 = 0;
    var section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= manifest.len) {
        if (i == manifest.len || manifest.charAt(i) == 10) {
            var line = manifest.substring(start, i).trim();
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1).trim(); }
            if (line.len > 0 && !line.startsWith("#")) {
                if (line.startsWith("[") && line.endsWith("]")) {
                    section = line.substring(1, line.len - 1);
                } else if (section == "dependencies") {
                    let eq = line.indexOf("=");
                    if (eq > 0) {
                        let key = line.substring(0, eq).trim();
                        var value = line.substring(eq + 1, line.len).trim();
                        var ver: string = "";
                        if (value.startsWith("{")) {
                            let marker = "version";
                            let at = value.indexOf(marker);
                            if (at >= 0) {
                                var p = at + marker.len;
                                while (p < value.len && value.charAt(p) != 34) { p = p + 1; }
                                if (p < value.len && value.charAt(p) == 34) {
                                    p = p + 1;
                                    var end = p;
                                    while (end < value.len && value.charAt(end) != 34) { end = end + 1; }
                                    ver = value.substring(p, end);
                                }
                            }
                        } else {
                            ver = pkg_toml_unquote(value);
                            if (!pkg_looks_like_version(ver)) { ver = ""; }
                        }
                        if (ver.len > 0 || pkg_looks_like_version(pkg_toml_unquote(value))) {
                            if (pkg_cmd_install(key, ver) != 0) { rc = 1; }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return rc;
}

public fn pkg_cmd_search(query: string) -> i32 {
    let root = pkg_registry_root();
    let path = pkg_index_path(root);
    if (!fileExists(path)) {
        print("vyx search: empty registry at " + root);
        return 0;
    }
    let body = readFile(path);
    var start: i32 = 0;
    var i: i32 = 0;
    var hits: i32 = 0;
    while (i <= body.len) {
        if (i == body.len || body.charAt(i) == 10) {
            var line = body.substring(start, i);
            if (line.endsWith("\r")) { line = line.substring(0, line.len - 1); }
            if (line.len > 0 && (query.len == 0 || line.contains(query))) {
                print(line);
                hits = hits + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (hits == 0) { print("vyx search: no matches"); }
    return 0;
}

public fn pkg_cmd_lock() -> i32 {
    return pkg_cmd_install_manifest();
}

public fn pkg_dispatch() -> i32 {
    if (argCount() < 2) { return 1; }
    let cmd = getArg(1);
    if (cmd == "publish") { return pkg_cmd_publish(); }
    if (cmd == "search") {
        var q: string = "";
        if (argCount() >= 3) { q = getArg(2); }
        return pkg_cmd_search(q);
    }
    if (cmd == "lock") { return pkg_cmd_lock(); }
    if (cmd == "install") {
        var name: string = "";
        var ver: string = "";
        if (argCount() >= 3) {
            let spec = getArg(2);
            let at = spec.indexOf("@");
            if (at > 0) {
                name = spec.substring(0, at);
                ver = spec.substring(at + 1, spec.len);
            } else {
                name = spec;
            }
        }
        if (argCount() >= 4 && ver.len == 0) { ver = getArg(3); }
        return pkg_cmd_install(name, ver);
    }
    return 1;
}
