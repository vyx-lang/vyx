module bootstrap.dci_requests;

var g_dci_instances: string = "";

public fn dci_request_instance(instance_text: string) {
    if (instance_text.len == 0) { return; }
    let line = "instance\t" + instance_text + "\n";
    if (g_dci_instances.contains(line)) { return; }
    g_dci_instances = g_dci_instances + line;
}

public fn dci_request_list_init(owner: string, arguments: string) {
    dci_request_instance(owner);
    let line = "list-init\t" + owner + "\t" + arguments + "\n";
    if (!g_dci_instances.contains(line)) { g_dci_instances = g_dci_instances + line; }
}

public fn dci_requests_take() -> string {
    let out = g_dci_instances;
    g_dci_instances = "";
    return out;
}
