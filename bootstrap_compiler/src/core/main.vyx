/// Bootstrap compiler driver.
///
/// The entry point uses one explicit source selector and grouped mode options:
/// `--src=file <input.vyx>` or `--src=project <project-dir>`, with output
/// selected by `--emit=<kind>` (`ir`, `obj`, `exe`, `dll`, `lib`, `vyi`,
/// `cpp`, `dci-stubs`, `hir`, `mir`, `hir-verify`, `mir-verify`, `hir-facts`)
/// and execution selected by `--run=<aot|jit>`.
/// AOT executable emission is the default when no mode is supplied.
/// Standard-library declarations are loaded from `.vyx`
/// files through the import registry; they are not embedded in compiler code.

extern "C" {
    fn getenv(name: rawptr) -> rawptr;
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_platform() -> i32;
    fn vyx_bootstrap_llvm_version() -> rawptr;
    fn vyx_bootstrap_llvm_host_triple() -> rawptr;
    fn vyx_bootstrap_file_mtime(path: rawptr) -> i64;
    fn vyx_bootstrap_file_size(path: rawptr) -> i64;
    fn vyx_bootstrap_abs_path(path: rawptr) -> rawptr;
    fn vyx_bootstrap_toml_array_abs_paths(project_dir: rawptr,
                                          project_dir_len: i64,
                                          array_text: rawptr,
                                          array_text_len: i64) -> rawptr;
    fn vyx_bootstrap_process_spawn(command: rawptr,
                                   cwd: rawptr,
                                   stdout_path: rawptr,
                                   stderr_path: rawptr,
                                   env_name: rawptr,
                                   env_value: rawptr) -> i64;
    fn vyx_bootstrap_process_wait(id: i64) -> i32;
    fn vyx_bootstrap_process_close(id: i64);
    fn vyx_bootstrap_copy_file(src: rawptr, dst: rawptr) -> i32;
    fn vyx_bootstrap_copy_runtime_assets(src_dir: rawptr, dst_dir: rawptr) -> i32;
    fn vyx_bootstrap_mkdir_p(path: rawptr) -> i32;
    fn vyx_bootstrap_list_vyx_deps(root: rawptr, out_path: rawptr) -> i32;
    fn vyx_bootstrap_repl_run(self_exe: rawptr, compiler_args: rawptr) -> i32;
    fn strstr(haystack: rawptr, needle: rawptr) -> rawptr;
    fn vyx_string_contains(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
}

@[platform("windows")]
extern "C" {
    fn _getpid() -> i32;
    fn SetErrorMode(uMode: u32) -> u32;
}

@[platform("linux")]
extern "C" {
    fn getpid() -> i32;
}

@[platform("android")]
extern "C" {
    fn getpid() -> i32;
}

@[platform("macos")]
extern "C" {
    fn getpid() -> i32;
}

fn driver_is_windows() -> bool { return vyx_bootstrap_platform() == 1; }
fn driver_is_linux() -> bool { return vyx_bootstrap_platform() == 2; }
fn driver_is_android() -> bool { return vyx_bootstrap_platform() == 3; }
fn driver_is_apple() -> bool { return vyx_bootstrap_platform() == 4; }

fn vyx_compiler_version() -> string { return "1.0.0-alpha.1"; }
fn vyx_compiler_channel() -> string { return "ea"; }
fn vyx_compiler_package() -> string { return "boot"; }

fn driver_host_name() -> string {
    if (driver_is_windows()) { return "windows"; }
    if (driver_is_linux()) { return "linux"; }
    if (driver_is_android()) { return "android"; }
    if (driver_is_apple()) { return "macos"; }
    return "unknown";
}

fn driver_cstr_or_empty(p: rawptr) -> string {
    if (p == null) { return ""; }
    return from_cstr(p);
}

fn show_version() {
    let ver = vyx_compiler_version();
    let pkg = vyx_compiler_package();
    var exe = "";
    if (argCount() > 0) { exe = getArg(0); }
    print("vyxc " + ver + " (" + vyx_compiler_channel() + ")");
    print("release:     " + vyx_compiler_channel() + "  (early access)");
    print("package:     " + pkg + "  [bootstrap_compiler/Vyx.toml]");
    print("identity:    self-host compiler (target boot, output alias vyxc)");
    print("host:        " + driver_host_name());
    let llvm_ver = driver_cstr_or_empty(vyx_bootstrap_llvm_version());
    let llvm_triple = driver_cstr_or_empty(vyx_bootstrap_llvm_host_triple());
    if (llvm_ver.len > 0) {
        var llvm_line = "llvm:        " + llvm_ver;
        if (llvm_triple.len > 0) { llvm_line = llvm_line + " (" + llvm_triple + ")"; }
        print(llvm_line);
    }
    print("backend:    vyx_compiler_backend (shared)");
    print("runtime:     vyx_runtime (static)");
    if (exe.len > 0) {
        print("binary:      " + exe);
        let sz = vyx_bootstrap_file_size(exe.c_str());
        let mt = vyx_bootstrap_file_mtime(exe.c_str());
        if (sz >= 0) { print("binary-size: " + policy_i64_to_string(sz)); }
        if (mt >= 0) { print("binary-mtime: " + policy_i64_to_string(mt)); }
    }
    let llvm_root = getenv("LLVM_ROOT".c_str());
    if (llvm_root != null) {
        let root = from_cstr(llvm_root);
        if (root.len > 0) { print("LLVM_ROOT:   " + root); }
    }
}

fn driver_host_platform_name() -> string {
    if (driver_is_windows()) { return "windows"; }
    if (driver_is_linux()) { return "linux"; }
    if (driver_is_android()) { return "android"; }
    if (driver_is_apple()) { return "macos"; }
    return "";
}

fn driver_effective_platform_name() -> string {
    let target = policy_cli_target_triple();
    if (target.len > 0) { return policy_target_platform_name(target); }
    return driver_host_platform_name();
}

fn driver_target_is_windows() -> bool { return driver_effective_platform_name() == "windows"; }
fn driver_target_is_linux() -> bool { return driver_effective_platform_name() == "linux"; }
fn driver_target_is_android() -> bool { return driver_effective_platform_name() == "android"; }
fn driver_target_is_apple() -> bool { return driver_effective_platform_name() == "macos"; }

fn driver_android_libcxx_link_flags() -> string {
    if (!driver_target_is_android()) { return ""; }
    var out = " -nostdlib++";
    let mode = driver_env_value("VYX_ANDROID_LIBCXX").trim();
    if (mode == "static") {
        out = out + " -lc++_static -lc++abi";
    } else if (mode == "shared" || mode == "1" || mode == "true") {
        out = out + " -lc++_shared";
    }
    return out;
}

@[platform("windows")]
fn driver_disable_windows_error_boxes() {
    SetErrorMode(32771 as u32);
}

@[platform("linux")]
fn driver_disable_windows_error_boxes() {}

@[platform("android")]
fn driver_disable_windows_error_boxes() {}

@[platform("macos")]
fn driver_disable_windows_error_boxes() {}

@[platform("windows")]
fn driver_current_process_id() -> i64 { return _getpid() as i64; }

@[platform("linux")]
fn driver_current_process_id() -> i64 { return getpid() as i64; }

@[platform("android")]
fn driver_current_process_id() -> i64 { return getpid() as i64; }

@[platform("macos")]
fn driver_current_process_id() -> i64 { return getpid() as i64; }

fn driver_path_sep() -> string {
    if (driver_is_windows()) { return "\\"; }
    return "/";
}

fn driver_host_path(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (driver_is_windows() && c == 47) {
            out = out + "\\";
        } else if (!driver_is_windows() && c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn driver_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    let value = from_cstr(raw);
    if (value.len > 0) {
        let c0 = value.charAt(0);
        if (c0 == 36 || c0 == 37) { return ""; }
    }
    return value;
}

fn driver_env_enabled(name: string) -> bool {
    let value = driver_env_value(name);
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE") { return false; }
    return true;
}

fn driver_timing_profile_level() -> i32 {
    if (driver_env_enabled("VYX_DRIVER_PROFILE")) { return 1; }
    return vyx_bootstrap_profile_level();
}

fn driver_debug_import(msg: string) {
    if (driver_env_value("VYX_DEBUG_IMPORT").len > 0) {
        print("[import-debug] " + msg);
    }
}

fn driver_debug_project_config(msg: string) {
    if (driver_env_enabled("VYX_DEBUG_PROJECT_CONFIG")) {
        print("[project-config-debug] " + msg);
    }
}

fn driver_shared_ext() -> string {
    if (driver_target_is_windows()) { return ".dll"; }
    if (driver_target_is_apple()) { return ".dylib"; }
    return ".so";
}

fn driver_static_ext() -> string {
    if (driver_target_is_windows()) { return ".lib"; }
    return ".a";
}

fn driver_exe_ext() -> string {
    if (driver_target_is_windows()) { return ".exe"; }
    return "";
}

fn driver_obj_ext() -> string {
    if (driver_target_is_windows()) { return ".obj"; }
    return ".o";
}

fn driver_shared_library_filename(name: string) -> string {
    if (driver_target_is_windows()) { return name + driver_shared_ext(); }
    if (name.startsWith("lib")) { return name + driver_shared_ext(); }
    return "lib" + name + driver_shared_ext();
}

fn driver_static_library_filename(name: string) -> string {
    if (driver_target_is_windows()) { return name + driver_static_ext(); }
    if (name.startsWith("lib")) { return name + driver_static_ext(); }
    return "lib" + name + driver_static_ext();
}

var g_driver_append_tail: rawptr = null;
var g_driver_registry_tmp_counter: i32 = 0;

fn die(msg: string) -> i32 {
    diag_emit(diag_sev_FATAL(), diag_code_internal(), 0, 0, msg);
    return 1;
}

// Package-owned `.attr` files are user-authored source.  Keep malformed
// schemas out of the internal-invariant channel so editors and CI can classify
// them as input errors while retaining the fatal stop semantics.
fn die_schema(msg: string) -> i32 {
    // `diag_code_for_severity` intentionally maps every fatal diagnostic to
    // the internal channel.  A schema is user input, so emit an ordinary
    // syntax error and let the driver return non-zero after recording it.
    diag_emit(diag_sev_ERROR(), diag_code_syntax_unexpected(), 0, 0, msg);
    return 1;
}

fn show_usage() {
    let prog = getArg(0);
    print("Vyx Compiler " + vyx_compiler_version() + " (" + vyx_compiler_channel() + ")");
    print("Usage: " + prog + " --src=file <input.vyx> [options]");
    print("       " + prog + " --src=project <project-dir> [options]");
    print("       " + prog + " build [--target <name>] [--triplet <triple>]");
    print("       " + prog + " new <directory> [--bare]");
    print("       " + prog + " dci <adapter|validate|inspect|encode|decode|doctor> ...");
    print("       " + prog + " run <script|package:script>");
    print("       " + prog + " repl              Start LLVM JIT REPL");
    print("       " + prog + " install [pkg[@ver]]  Fetch a package from the file:// registry");
    print("       " + prog + " publish           Publish the current package into the registry");
    print("       " + prog + " search [query]    List packages in the file:// registry");
    print("       " + prog + " lock              Resolve versions and write Vyx.lock");
    print("       " + prog + " test [--filter <substr>] [path...]");
    print("       " + prog + " bench [--filter <substr>] [path...]");
    print("       " + prog + " fmt [--check] [path...]");
    print("       " + prog + " doc [--out <dir>] [path...]");
    print("       " + prog + " version           Print version and build identity");
    print("       " + prog + " help              Show this help");
    print("Options:");
    print("  -h, --help    Show this help");
    print("  --version     Print version and build identity");
    print("  --emit=<kind> ir, obj, exe, dll, lib, vyi, cpp, dci-stubs, hir, mir, hir-verify, mir-verify, hir-facts (default: exe)");
    print("                 aliases: --dump-hir2 --dump-mir2 --verify-hir2 --verify-mir2 --verify-hir-facts");
    print("  --src=<kind> <path>  Source kind: file or project");
    print("  --run=<kind>  Execute output: aot or jit (default: aot when run is requested)");
    print("  --target=<value>   Manifest target name for `build`; legacy target triple for direct compile");
    print("  --triplet=<triple> Canonical LLVM target triple for project/cross builds");
    print("  --sysroot=<path>   Target SDK/sysroot for cross compilation");
    print("  --target-cpu=<cpu> Backend CPU/architecture; NVPTX accepts `sm_120` or `120`");
    print("  --dci <file>  Consume a DCI ABI contract; repeat for independent C++/Rust contracts");
    print("  --vyi-shallow Emit .vyi from local parsed declarations only");
    print("  -o <file>     Output file name");
    print("  -j <N>        Number of parallel compilation threads");
    print("  --mir-opt <level>   Override MIR pass level (0, 1, 2, 3, s, z)");
    print("  --llvm-opt <level>  Override LLVM optimization level (0, 1, 2, 3, s, z)");
    print("  -Os           Optimize for code size");
    print("  -Oz           Aggressively optimize for code size");
    print("  --dump-tokens Print token stream (debug)");
    print("  -g, --debug   Emit debug information");
    print("  -O0 -O1 -O2 -O3  LLVM optimization level");
    print("  --stop-after-parse  Exit 0 after successful parse (no imports/sema/codegen)");
    print("  --stop-after-sema   Exit 0 after successful semantic analysis (no mono/codegen)");
    print("  --hir-complete-resolve  Run the HIR semantic resolver completion pass (default off)");
    print("  --mir-verify-strict Enable strict MIR closure checks with --emit=mir / --emit=mir-verify");
    print("  --coverage    Enable code coverage instrumentation");
    print("  -fPIC, -fpic  Emit position-independent object code");
    print("  -L <dir>      Add library search path");
    print("  -l <lib>      Link with library");
    print("  --lib-path <dir>  Add library search path (alias for -L)");
    print("  --link <lib>      Link with library (alias for -l)");
    print("  --link-obj <obj>  Link an additional object file");
    print("  --interface-root <dir>  Prefer generated .vyi interfaces from dir");
    print("  --module-source <file>  Add an explicit source-package module file");
    print("  --max-errors N    Stop after N distinct template failures (default 100)");
    print("  --keep-obj            Keep intermediate object files");
    print("  --export-all          Export all compiled symbols");
    print("  --export-top-level-roots  Export top-level callable roots");
    print("  --export-method-roots     Export method roots");
    print("  --no-implicit-std     Do not auto-import the implicit std prelude");
    print("  --vyi-project-private Restrict .vyi emission to the compiling package");
    print("  --dci-file <file>     Alias for --dci");
    print("  --unit-sources <file>  Unity compile source list (used by `build`)");
    print("  --project-unit-sources <file>  Project unity source list");
    print("  --interface-unit-sources <file>  Interface unity source list");
    print("  --vyi-decorated-sources <file>  Files whose symbols carry a source= discriminator");
