    print("  --export-root-names <names>   Comma-separated export root names");
    print("  --export-root-names-file <file>  Export root names from file");
    print("  --emit-root-names <names>    Comma-separated emit root names");
    print("  --emit-root-names-file <file>  Emit root names from file");
}

fn cli_wants_help() -> bool {
    if (argCount() < 2) { return false; }
    let a = getArg(1);
    return a == "help" || a == "-h" || a == "--help";
}

fn cli_wants_version() -> bool {
    let argc = argCount();
    if (argc < 2) { return false; }
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (i == 1 && a == "version") { return true; }
        if (a == "--version") { return true; }
        i = i + 1;
    }
    return false;
}

fn cli_emit_kind_is_valid(kind: string) -> bool {
    if (kind == "ir" || kind == "obj" || kind == "exe") { return true; }
    if (kind == "dll" || kind == "lib" || kind == "vyi") { return true; }
    if (kind == "cpp" || kind == "dci-stubs") { return true; }
    if (kind == "hir" || kind == "mir") { return true; }
    if (kind == "hir-verify" || kind == "mir-verify" || kind == "hir-facts") { return true; }
    return false;
}

fn cli_has_emit_kind(kind: string) -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a.startsWith("--emit=") && a.len > 7 && a.substring(7, a.len) == kind) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cli_has_src() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a.startsWith("--src=")) { return true; }
        i = i + 1;
    }
    return false;
}

fn cli_src_kind() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a.startsWith("--src=") && a.len > 6) { return a.substring(6, a.len); }
        i = i + 1;
    }
    return "file";
}

fn cli_src_path() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a.startsWith("--src=") && i + 1 < argc) { return getArg(i + 1); }
        i = i + 1;
    }
    return "";
}

fn parse_cli_args() -> i32 {
    let argc = argCount();
    if (argc < 2) {
        show_usage();
        return 1;
    }
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") {
            break;
        } else if (a.startsWith("--emit=")) {
            let kind = a.substring(7, a.len);
            if (kind.len == 0) {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "option `--emit=` requires a value");
                return 1;
            }
            if (!cli_emit_kind_is_valid(kind)) {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "unknown emit kind `" + kind + "`");
                return 1;
            }
            i = i + 1;
        } else if (a.startsWith("--src=")) {
            if (a.len <= 6 || i + 1 >= argc) {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "option `--src=<file|project>` requires a path");
                return 1;
            }
            let src_kind = a.substring(6, a.len);
            if (src_kind != "file" && src_kind != "project") {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "unknown source kind `" + src_kind + "`");
                return 1;
            }
            i = i + 2;
        } else if (a.startsWith("--run=")) {
            let kind = a.substring(6, a.len);
            if (kind != "aot" && kind != "jit") {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "unknown run kind `" + kind + "` (expected aot or jit)");
                return 1;
            }
            i = i + 1;
        } else if (cli_is_removed_ir_arg(a)) {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "IR option `" + a + "` belongs to the deleted legacy IR pipeline");
            return 1;
        } else if (cli_is_emit_alias(a)) {
            i = i + 1;
        } else if (cli_is_mode_arg(a)) {
            i = i + 1;
        } else if (cli_option_takes_value(a)) {
            if (i + 1 < argc) {
                if ((a == "--target" || a == "--triplet")
                    && getArg(i + 1).trim().len == 0) {
                    diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                              "target/triplet option requires a value");
                    return 1;
                }
                i = i + 2;
            } else {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "option `" + a + "` requires a value");
                return 1;
            }
        } else if (a == "--mir-opt" || a == "--llvm-opt") {
            if (i + 1 >= argc || cli_parse_opt_level_text(getArg(i + 1)) < 0) {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "optimization override must be one of 0, 1, 2, 3, s, z");
                return 1;
            }
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("--triplet=")) {
            var prefix_len: i32 = 9;
            if (a.startsWith("--triplet=")) { prefix_len = 10; }
            if (a.len <= prefix_len) {
                diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                          "target triple option requires a value");
                return 1;
            }
            i = i + 1;
        } else if (a.startsWith("--sysroot=")) {
            i = i + 1;
        } else if (a.startsWith("-L") && a.len > 2) {
            i = i + 1;
        } else if (a.startsWith("-l") && a.len > 2) {
            i = i + 1;
        } else if (!a.startsWith("-")) {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "source input must be supplied with `--src=file <path>` or `--src=project <path>`");
            return 1;
        } else {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "unknown option `" + a + "`");
            return 1;
        }
    }
    let requested_target = policy_cli_requested_target();
    if (cli_validate_target_cpu() != 0) { return 1; }
    if (requested_target.len > 0) {
        let canonical_target = policy_target_canonical_triple(requested_target.clone());
        let target_error = policy_target_validation_error(canonical_target.clone());
        if (target_error.len > 0) {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "unsupported LLVM target triple `" + canonical_target + "`: " + target_error);
            return 1;
        }
    }
    if (!cli_has_src()) {
        diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                  "source input requires `--src=file <path>` or `--src=project <path>`");
        return 1;
    }
    if (cli_src_kind() == "project") {
        if (cli_src_path().len == 0) {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "no project path specified");
            return 1;
        }
        return 0;
    }
    if (fetch_input_path().len == 0) {
        diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                  "no input file specified");
        return 1;
    }
    return 0;
}

fn cli_option_takes_value(a: string) -> bool {
    if (a == "-o") { return true; }
    if (a == "-L" || a == "--lib-path") { return true; }
    if (a == "-l" || a == "--link" || a == "--link-obj") { return true; }
    if (a == "-j" || a == "--target" || a == "--triplet" || a == "--sysroot") { return true; }
    if (a == "--target-cpu" || a == "--mcpu") { return true; }
    if (a == "--unit-sources") { return true; }
    if (a == "--project-unit-sources") { return true; }
    if (a == "--interface-unit-sources") { return true; }
    if (a == "--vyi-decorated-sources") { return true; }
    if (a == "--interface-root") { return true; }
    if (a == "--module-source") { return true; }
    if (a == "--module-sources-file") { return true; }
    if (a == "--export-root-names") { return true; }
    if (a == "--export-root-names-file") { return true; }
    if (a == "--emit-root-names") { return true; }
    if (a == "--emit-root-names-file") { return true; }
    if (a == "--dci" || a == "--dci-file") { return true; }
    if (a == "--max-errors" || a == "--mir-opt" || a == "--llvm-opt") { return true; }
    return false;
}

fn cli_is_removed_ir_arg(a: string) -> bool {
    if (a == "--emit-hir" || a == "--emit-mir" || a == "--emit-mir-cfg") { return true; }
    if (a == "--use-mir-codegen") { return true; }
    if (a == "--dump-hir" || a == "--dump-mir" || a == "--dump-mir-cfg") { return true; }
    if (a == "--dump-mir-cfg-metrics" || a == "--dump-mir-cfg-analysis"
        || a == "--dump-mir-cfg-dominators" || a == "--dump-mir-cfg-liveness") { return true; }
    if (a == "--verify-hir" || a == "--verify-mir" || a == "--verify-mir-cfg"
        || a == "--verify-mir-cfg-types" || a == "--verify-mir-cfg-dominators"
        || a == "--verify-mir-cfg-liveness" || a == "--verify-ir") { return true; }
    return false;
}

fn cli_is_emit_alias(a: string) -> bool {
    if (a == "--verify-hir-facts" || a == "--verify-hir2" || a == "--dump-hir2") { return true; }
    if (a == "--verify-mir2" || a == "--dump-mir2") { return true; }
    return false;
}

fn cli_is_mode_arg(a: string) -> bool {
    if (a.startsWith("--run=")) { return true; }
    if (a.startsWith("--emit=")) { return true; }
    if (cli_is_emit_alias(a)) { return true; }
    if (a == "--vyi-shallow") { return true; }
    if (a == "--vyi-project-private") { return true; }
    if (a == "--dump-tokens") { return true; }
    if (a == "--stop-after-parse") { return true; }
    if (a == "--hir-complete-resolve") { return true; }
    if (a == "--mir-verify-strict") { return true; }
    if (a == "--stop-after-sema" || a == "--keep-obj" || a == "--export-all"
        || a == "--export-top-level-roots" || a == "--export-method-roots") { return true; }
    if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3"
        || a == "-Os" || a == "-Oz") { return true; }
    if (a == "-g" || a == "--debug") { return true; }
    if (a == "--coverage") { return true; }
    if (a == "-fPIC" || a == "-fpic") { return true; }
    if (a == "--no-implicit-std") { return true; }
    if (a == "--version") { return true; }
    return false;
}

fn cli_no_implicit_std() -> bool {
    var i: i32 = 1;
    while (i < argCount()) {
        if (getArg(i) == "--no-implicit-std") { return true; }
