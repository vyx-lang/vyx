fn driver_project_emit_root_names(project_path: string) -> string {
    let project_dir = driver_resolve_abs_path(project_path);
    let manifest_path = driver_join_path(project_dir.clone(), "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    if (manifest.len == 0 && !fileExists(manifest_path)) { return ""; }
    var pkg_name = driver_toml_get(manifest.clone(), "package", "name");
    if (pkg_name.len == 0) { pkg_name = driver_path_stem(project_dir.clone()); }
    let section = driver_select_target_section(manifest.clone(), pkg_name, "");
    var roots = driver_toml_get_platform_value(manifest.clone(), section.clone(), "mir2cpp_entry");
    if (roots.len == 0) {
        roots = driver_toml_get_platform_value(manifest.clone(), section.clone(), "emit_root_names");
    }
    if (roots.len == 0) {
        roots = driver_toml_get_platform_value(manifest.clone(), "build", "mir2cpp_entry");
    }
    if (roots.len == 0) {
        roots = driver_toml_get_platform_value(manifest.clone(), "build", "emit_root_names");
    }
    return roots.trim();
}

// The implicit project root set (manifest `mir2cpp_entry` / `emit_root_names`,
// else `main`) is a MIR2CPP / interface-surface concept: those modes render a
// reachable-only surface for one entry point.
//
// Native object and executable emission must NOT use it.  `build` compiles the
// manifest target's whole source closure with no emit-root partition, so a
// native `--src=project` that partitions at `main` silently drops sibling
// bodies from the codegen unit.  The object is then still asked for their
// monomorphised instantiations and the emitter aborts (observed as an
// invalid-function / 0xC0000409 failure with far too few collected functions).
fn driver_project_implicit_roots_apply() -> bool {
    if (cli_src_kind() != "project") { return false; }
    if (cli_wants_export_all()) { return false; }
    if (cli_wants_emit_cpp()) { return true; }
    if (cli_wants_dump_mir2()) { return true; }
    if (cli_wants_verify_mir2()) { return true; }
    return cli_wants_emit_dci_stubs();
}

fn cli_effective_emit_root_names() -> string {
    if (cli_has_emit_root_names()) { return cli_emit_root_names(); }
    if (driver_project_implicit_roots_apply()) {
        let project_roots = driver_project_emit_root_names(cli_src_path());
        if (project_roots.len > 0) { return project_roots; }
        return "main";
    }
    return "";
}

fn cli_effective_emit_root_names_specified() -> bool {
    if (cli_has_emit_root_names()) { return true; }
    return driver_project_implicit_roots_apply();
}

fn cli_parse_positive_i32(text: string, fallback: i32) -> i32 {
    if (text.len == 0) { return fallback; }
    var out: i32 = 0;
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) { return fallback; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out;
}

fn cli_max_errors() -> i32 {
    var out: i32 = 100;
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "--max-errors" && i + 1 < argc) {
            out = cli_parse_positive_i32(getArg(i + 1), out);
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn cli_opt_level() -> i32 {
    let argc = argCount();
    var out: i32 = 2;
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "-O0") { out = 0; }
        if (a == "-O1") { out = 1; }
        if (a == "-O2") { out = 2; }
        if (a == "-O3") { out = 3; }
        if (a == "-Os") { out = 4; }
        if (a == "-Oz") { out = 5; }
        i = i + 1;
    }
    return out;
}

fn cli_wants_debug_info() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "-g" || a == "--debug") { return true; }
        i = i + 1;
    }
    return false;
}

fn cli_has_explicit_opt_flag() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" || a == "-Os" || a == "-Oz") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cli_opt_flag() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "-Os" || a == "-Oz") { return a; }
        i = i + 1;
    }
    let level = cli_opt_level();
    if (level <= 0) { return "-O0"; }
    if (level == 1) { return "-O1"; }
    if (level == 2) { return "-O2"; }
    return "-O3";
}

fn cli_parse_opt_level_text(text: string) -> i32 {
    if (text == "0") { return 0; }
    if (text == "1") { return 1; }
    if (text == "2") { return 2; }
    if (text == "3") { return 3; }
    if (text == "s" || text == "S") { return 4; }
    if (text == "z" || text == "Z") { return 5; }
    return -1;
}

fn cli_opt_override(name: string) -> i32 {
    let argc = argCount();
    var i: i32 = 1;
    var result: i32 = -1;
    while (i < argc) {
        let arg = getArg(i);
        if (arg == "--") { break; }
        if (arg == name && i + 1 < argc) {
            result = cli_parse_opt_level_text(getArg(i + 1));
            i = i + 2;
            continue;
        }
        i = i + 1;
    }
    return result;
}

fn cli_mir_opt_level(default_level: i32) -> i32 {
    let override_level = cli_opt_override("--mir-opt");
    if (override_level >= 0) { return override_level; }
    return default_level;
}

fn cli_llvm_opt_level(default_level: i32) -> i32 {
    let override_level = cli_opt_override("--llvm-opt");
    if (override_level >= 0) { return override_level; }
    return default_level;
}

fn cli_target_cpu() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = getArg(i + 1).trim();
            i = i + 2;
            continue;
        }
        if (a.startsWith("--target-cpu=")) {
            out = a.substring(13, a.len).trim();
        } else if (a.startsWith("--mcpu=")) {
            out = a.substring(7, a.len).trim();
        }
        i = i + 1;
    }
    return out;
}

fn cli_validate_target_cpu() -> i32 {
    let cpu = cli_target_cpu();
    if (cpu.len == 0) { return 0; }
    let triple = policy_cli_target_triple();
    if (!triple.contains("nvptx")) {
        diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                  "target CPU `" + cpu + "` is only supported for NVPTX targets");
        return 1;
    }
    return 0;
}


fn cli_link_name_is_runtime(link_name: string) -> bool {
    let file = driver_filename(link_name);
    if (file == "vyx_compiler_backend" || file == "vyx_runtime"
        || file == "vyx_rt" || file == "vyx_run_rt" || file == "vyx_run_rt_static") {
        return true;
    }
    if (file == "vyx_compiler_backend.dll" || file == "vyx_compiler_backend.lib"
        || file == "libvyx_compiler_backend.dll.a"
        || file == "vyx_runtime.lib"
        || file == "vyx_rt.dll" || file == "vyx_rt.lib"
        || file == "libvyx_rt.dll.a"
        || file == "vyx_run_rt.dll" || file == "vyx_run_rt.lib"
        || file == "libvyx_run_rt.dll.a"
        || file == "vyx_run_rt_static.lib") {
        return true;
    }
    if (file == "libvyx_runtime.a"
        || file == "libvyx_compiler_backend.dylib"
        || file == "libvyx_rt.a" || file == "libvyx_rt.dylib"
        || file == "libvyx_run_rt.a" || file == "libvyx_run_rt.dylib"
        || file == "libvyx_run_rt_static.a") {
        return true;
    }
    if (file == "libvyx_compiler_backend.so"
        || file.startsWith("libvyx_compiler_backend.so.")
        || file == "libvyx_rt.so" || file.startsWith("libvyx_rt.so.")
        || file == "libvyx_run_rt.so" || file.startsWith("libvyx_run_rt.so.")) {
        return true;
    }
    return false;
}

fn cli_link_name_is_shared_runtime(link_name: string) -> bool {
    let file = driver_filename(link_name);
    if (file == "vyx_compiler_backend" || file == "vyx_rt" || file == "vyx_run_rt") {
        return true;
    }
    if (file == "vyx_compiler_backend.dll" || file == "vyx_compiler_backend.lib"
        || file == "libvyx_compiler_backend.dll.a"
        || file == "vyx_rt.dll" || file == "vyx_rt.lib" || file == "libvyx_rt.dll.a"
        || file == "vyx_run_rt.dll" || file == "vyx_run_rt.lib"
        || file == "libvyx_run_rt.dll.a") {
        return true;
    }
    if (file == "libvyx_compiler_backend.so"
        || file.startsWith("libvyx_compiler_backend.so.")
        || file == "libvyx_compiler_backend.dylib"
        || file == "libvyx_rt.so" || file.startsWith("libvyx_rt.so.")
        || file == "libvyx_rt.dylib"
        || file == "libvyx_run_rt.so" || file.startsWith("libvyx_run_rt.so.")
        || file == "libvyx_run_rt.dylib") {
        return true;
    }
    return false;
}

fn cli_link_args(auto_link_args: string) -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 1;
    var has_runtime: bool = false;
    var has_shared_runtime: bool = false;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if ((a == "--target" || a == "--triplet") && i + 1 < argc) {
            out = out.clone() + " -target \""
                + policy_target_canonical_triple(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("--triplet=")) {
            var prefix_len: i32 = 9;
            if (a.startsWith("--triplet=")) { prefix_len = 10; }
            out = out.clone() + " -target \""
                + policy_target_canonical_triple(a.substring(prefix_len, a.len)) + "\"";
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            out = out.clone() + " --sysroot \"" + driver_host_path(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            out = out.clone() + " --sysroot \""
                + driver_host_path(a.substring(10, a.len)) + "\"";
            i = i + 1;
        } else if (a == "--debug") {
            out = out.clone() + " -g";
            i = i + 1;
        } else if (a == "-g" || a == "--coverage") {
            out = out.clone() + " " + a;
            i = i + 1;
        } else if ((a == "-L" || a == "--lib-path") && i + 1 < argc) {
            out = out.clone() + " -L \"" + driver_host_path(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if ((a == "-l" || a == "--link") && i + 1 < argc) {
            let link_name = getArg(i + 1);
            if (cli_link_name_is_runtime(link_name)) { has_runtime = true; }
            if (cli_link_name_is_shared_runtime(link_name)) { has_shared_runtime = true; }
            out = out.clone() + " -l " + getArg(i + 1);
            i = i + 2;
        } else if (a == "--link-obj" && i + 1 < argc) {
            out = out.clone() + " \"" + driver_host_path(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if (a.startsWith("-L") && a.len > 2) {
            out = out.clone() + " " + a;
            i = i + 1;
        } else if (a.startsWith("-l") && a.len > 2) {
            if (cli_link_name_is_runtime(a.substring(2, a.len))) { has_runtime = true; }
            if (cli_link_name_is_shared_runtime(a.substring(2, a.len))) {
                has_shared_runtime = true;
            }
            out = out.clone() + " " + a;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    let rt = driver_runtime_dir();
    if (cli_wants_jit_run() && !has_shared_runtime
        && policy_cli_requested_target().len == 0) {
        let jit_rt = driver_exe_dir();
        if (driver_has_named_runtime_lib(jit_rt.clone(), "vyx_compiler_backend")) {
            out = out.clone() + " -L \"" + driver_host_path(jit_rt)
                + "\" -l vyx_compiler_backend";
            has_runtime = true;
            has_shared_runtime = true;
        }
    }
    if (!cli_wants_jit_run() && !has_runtime
        && policy_cli_requested_target().len == 0 && rt.len > 0) {
        out = out.clone() + " -L \"" + driver_host_path(rt) + "\" -l " + driver_runtime_link_name(rt.clone());
    }
    if (driver_target_is_linux() && policy_cli_requested_target().len == 0
        && (has_shared_runtime
            || (!has_runtime && rt.len > 0 && !driver_runtime_is_static(rt.clone())))) {
        out = out.clone() + " -Wl,-rpath,$ORIGIN";
    }
    out = out.clone() + auto_link_args;
    return out;
}

fn cli_object_toolchain_args() -> string {
    let argc = argCount();
    var out: string = "";
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if ((a == "--target" || a == "-target" || a == "--triplet") && i + 1 < argc) {
            out = out.clone() + " -target \""
                + policy_target_canonical_triple(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if (a.startsWith("--target=") || a.startsWith("-target=")
                   || a.startsWith("--triplet=")) {
            var prefix_len: i32 = 9;
            if (a.startsWith("-target=")) { prefix_len = 8; }
            if (a.startsWith("--triplet=")) { prefix_len = 10; }
            out = out.clone() + " -target \""
                + policy_target_canonical_triple(a.substring(prefix_len, a.len)) + "\"";
            i = i + 1;
        } else if (a == "--sysroot" && i + 1 < argc) {
            out = out.clone() + " --sysroot \"" + driver_host_path(getArg(i + 1)) + "\"";
            i = i + 2;
        } else if (a.startsWith("--sysroot=")) {
            out = out.clone() + " " + a;
            i = i + 1;
        } else if ((a == "--target-cpu" || a == "--mcpu") && i + 1 < argc) {
            out = out.clone() + " --target-cpu \"" + getArg(i + 1).trim() + "\"";
            i = i + 2;
        } else if (a.startsWith("--target-cpu=") || a.startsWith("--mcpu=")) {
            out = out.clone() + " " + a;
            i = i + 1;
        }
    }
    return out;
}

fn cli_target_triple() -> string {
    return policy_cli_target_triple();
}

fn driver_append_link_flag_once(args: string, flag: string) -> string {
    if (flag.len == 0) { return args; }
    if (driver_string_contains(" " + args + " ", " " + flag + " ")) { return args; }
    return args + " " + flag;
}

fn driver_unit_has_module(unit: rawptr, module_name: string) -> bool {
    if (unit == null || module_name.len == 0) { return false; }
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()
            && decl_get_name(cur) == module_name) {
            return true;
        }
        cur = decl_get_next(cur);
    }
    return false;
}

fn driver_module_colon_path(module_name: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < module_name.len) {
        let c = module_name.charAt(i);
        if (c == 46) {
            out = out + "::";
        } else {
            out = out + module_name.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn driver_file_uses_std_module(path: string, module_name: string) -> bool {
    if (!fileExists(path.clone())) { return false; }
    let text = readFile(path.clone());
    if (driver_string_contains(text.clone(), "use " + module_name)) { return true; }
    if (driver_string_contains(text.clone(), "import " + module_name)) { return true; }
    let colon = driver_module_colon_path(module_name.clone());
    if (driver_string_contains(text.clone(), "use " + colon)) { return true; }
    if (driver_string_contains(text.clone(), "import " + colon)) { return true; }
    return false;
}

fn driver_extract_link_lib_from_meta(meta: string, out: string) -> string {
    if (meta.len == 0) { return out; }
    var i: i32 = 0;
    while (i + 10 <= meta.len) {
        if (meta.substring(i, i + 10) == "link(name=") {
            var prev_ok = true;
            if (i > 0) {
                let prev = meta.charAt(i - 1);
                if ((prev >= 65 && prev <= 90) || (prev >= 97 && prev <= 122) || prev == 95) {
                    prev_ok = false;
                }
            }
            if (prev_ok) {
                var start = i + 10;
                if (start < meta.len && meta.charAt(start) == 34) {
                    start = start + 1;
                    var end = start;
                    while (end < meta.len && meta.charAt(end) != 34) {
                        end = end + 1;
                    }
                    if (end > start) {
                        out = driver_append_link_flag_once(out, "-l" + meta.substring(start, end));
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

fn driver_scan_decl_link_attrs(d: rawptr, out: string) -> string {
    if (d == null) { return out; }
    out = driver_extract_link_lib_from_meta(decl_get_meta(d), out);
    var mem = decl_get_members(d);
    while (mem != null) {
        out = driver_scan_decl_link_attrs(mem, out);
        mem = decl_get_next(mem);
    }
    return out;
}

fn driver_std_auto_link_args(unit: rawptr, input_path: string) -> string {
    var out: string = "";
    let uses_math = driver_unit_has_module(unit, "std.math")
                    || driver_file_uses_std_module(input_path.clone(), "std.math");
    let uses_vio = driver_unit_has_module(unit, "std.vio")
                   || driver_file_uses_std_module(input_path.clone(), "std.vio");
    if (uses_math) {
        if (!driver_target_is_windows()) {
            out = driver_append_link_flag_once(out, "-lm");
        }
    }
    if (uses_vio) {
        if (driver_target_is_windows()) {
            out = driver_append_link_flag_once(out, "-l ws2_32");
        } else if (driver_target_is_linux()) {
            out = driver_append_link_flag_once(out, "-pthread");
        }
    }
    let uses_threading = driver_unit_has_module(unit, "std.threading")
                         || driver_file_uses_std_module(input_path.clone(), "std.threading")
                         || driver_unit_has_module(unit, "std.sync")
                         || driver_file_uses_std_module(input_path.clone(), "std.sync");
    if (uses_threading) {
        if (driver_target_is_windows()) {
            out = driver_append_link_flag_once(out, "-l synchronization");
        } else if (driver_target_is_linux()) {
            out = driver_append_link_flag_once(out, "-pthread");
        }
    }
    let uses_tbb = driver_unit_has_module(unit, "std.thread_pool")
                   || driver_file_uses_std_module(input_path.clone(), "std.thread_pool");
    if (uses_tbb) {
        if (driver_target_is_windows()) {
            out = driver_append_link_flag_once(out, "-l tbb12");
        } else {
            out = driver_append_link_flag_once(out, "-pthread");
            out = driver_append_link_flag_once(out, "-l tbb");
        }
    }
    if (unit != null) {
        var cur = unit_get_decls(unit);
        while (cur != null) {
            out = driver_scan_decl_link_attrs(cur, out);
            cur = decl_get_next(cur);
        }
    }
    return out;
}

fn cli_run_path_prefix() -> string {
    let argc = argCount();
    var out: string = "";
    var sep: string = ":";
    if (driver_is_windows()) { sep = ";"; }
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if ((a == "-L" || a == "--lib-path") && i + 1 < argc) {
            out = out + driver_host_path(getArg(i + 1)) + sep;
            i = i + 2;
        } else if (a.startsWith("-L") && a.len > 2) {
            out = out + driver_host_path(a.substring(2, a.len)) + sep;
            i = i + 1;
        } else if ((a == "-l" || a == "--link") && i + 1 < argc) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    let rt = driver_runtime_dir();
    if (rt.len > 0 && !driver_string_contains(out.clone(), rt + sep)) {
        out = out + driver_host_path(rt) + sep;
    }
    return out;
}

fn fetch_input_path() -> string {
    if (cli_src_kind() == "project") {
        return driver_project_entry_path(cli_src_path());
    }
    if (cli_src_kind() == "file") {
        let src_path = cli_src_path();
        if (src_path.len > 0) { return src_path; }
    }
    let argc = argCount();
    var input: string = "";
    var i: i32 = 1;
    while (i < argc) {
        let candidate = getArg(i);
        if (candidate == "--") {
            break;
        } else if (candidate.startsWith("--src=")) {
            i = i + 2;
        } else if (candidate.startsWith("--emit=")) {
            i = i + 1;
        } else if (cli_option_takes_value(candidate)) {
            i = i + 2;
        } else if (candidate.startsWith("-L") || candidate.startsWith("-l")) {
            i = i + 1;
        } else if (cli_is_mode_arg(candidate)) {
            i = i + 1;
        } else if (!candidate.startsWith("-")) {
            input = candidate;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return input;
}

fn fetch_output_path() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i + 1 < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "-o") {
            return getArg(i + 1);
        }
        i = i + 1;
    }
    let input_path = fetch_input_path();
    if (cli_src_kind() == "project") {
        let project_path = driver_resolve_abs_path(cli_src_path());
        let project_dir = driver_join_path(project_path, "target");
        driver_make_dir(project_dir.clone());
        let base = driver_project_target_name(project_path.clone());
        let project_mode = cli_emit_mode();
        if (project_mode == 0) { return driver_join_path(project_dir, base + ".ll"); }
        if (project_mode == 1) { return driver_join_path(project_dir, base + driver_obj_ext()); }
        if (project_mode == 3) {
            let cache_dir = driver_join_path(project_path, ".cache");
            let run_cache_dir = driver_join_path(cache_dir, "run");
            driver_make_dir(run_cache_dir.clone());
            let now_text = policy_i64_to_string(vyx_bootstrap_now_ms()).clone();
            let pid_text = policy_i64_to_string(driver_current_process_id()).clone();
            let stamp = now_text + "_" + pid_text;
            return driver_join_path(run_cache_dir, base + "_" + stamp + driver_exe_ext());
        }
        if (project_mode == 4) { return driver_join_path(project_dir, driver_shared_library_filename(base)); }
        if (project_mode == 5) { return driver_join_path(project_dir, driver_static_library_filename(base)); }
        if (project_mode == 6) { return driver_join_path(project_dir, base + ".vyi"); }
        if (project_mode == 7) { return ""; }
        if (project_mode == 9) { return driver_join_path(project_dir, base + "_dci_stubs.cpp"); }
        if (project_mode == 8) { return driver_join_path(project_dir, base + "_cpp"); }
        return driver_join_path(project_dir, base + driver_exe_ext());
    }
    let base = driver_path_stem(input_path);
    let input_dir = driver_dirname(input_path);
    let cache_dir = driver_join_path(input_dir.clone(), ".cache");
    let target_dir = driver_join_path(input_dir.clone(), "target");
    let mode = cli_emit_mode();
    if (mode == 0) {
        driver_make_dir(cache_dir.clone());
        return driver_join_path(cache_dir, base + ".ll");
    }
    if (mode == 1) {
        driver_make_dir(cache_dir.clone());
        return driver_join_path(cache_dir, base + driver_obj_ext());
    }
    if (mode == 3) {
        let run_cache_dir = driver_join_path(cache_dir.clone(), "run");
        driver_make_dir(run_cache_dir.clone());
        let now_text = policy_i64_to_string(vyx_bootstrap_now_ms()).clone();
        let pid_text = policy_i64_to_string(driver_current_process_id()).clone();
        let stamp = now_text + "_" + pid_text;
        return driver_join_path(run_cache_dir, base + "_" + stamp + driver_exe_ext());
    }
    if (mode == 4) {
        driver_make_dir(target_dir.clone());
        return driver_join_path(target_dir, driver_shared_library_filename(base));
    }
    if (mode == 5) {
        driver_make_dir(target_dir.clone());
        return driver_join_path(target_dir, driver_static_library_filename(base));
    }
    if (mode == 7) {
        return "";
    }
    if (mode == 8) {
        driver_make_dir(target_dir.clone());
        return driver_join_path(target_dir, base + "_cpp");
    }
    driver_make_dir(target_dir.clone());
    return driver_join_path(target_dir, base + driver_exe_ext());
}

fn report_phase(name: string, msg: string) {
    if (vyx_bootstrap_profile_level() > 0) {
        print("[vyxc] " + name + ": " + msg);
    }
}

@[borrow_args]
fn driver_run_process(cmd: string,
                      cwd: string,
                      stdout_path: string,
                      stderr_path: string,
                      env_name: string,
                      env_value: string) -> i32 {
    let cmd2 = cmd.clone();
    let cwd2 = cwd.clone();
    let stdout2 = stdout_path.clone();
    let stderr2 = stderr_path.clone();
    let env_name2 = env_name.clone();
    let env_value2 = env_value.clone();
    let pid = vyx_bootstrap_process_spawn(cmd2.c_str(),
                                          cwd2.c_str(),
                                          stdout2.c_str(),
                                          stderr2.c_str(),
                                          env_name2.c_str(),
                                          env_value2.c_str());
    if (pid == 0) {
        return -1;
    }
    let rc = vyx_bootstrap_process_wait(pid);
    vyx_bootstrap_process_close(pid);
    return rc;
}

fn driver_profile_mark(level: i32, label: string, start_ms: i64) -> i64 {
    if (level <= 0) { return start_ms; }
    let now = vyx_bootstrap_now_ms();
    print("[driver-prof] " + label + ": " + policy_i64_to_string(now - start_ms) + " ms");
    return now;
}

fn driver_string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    return vyx_string_contains(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

fn driver_registry_path_is_ignored_mode(path: string, allow_generated_vyi: bool) -> bool {
    if (path.toLower().endsWith(".attr")) { return true; }
    let is_vyi = path.endsWith(".vyi");
    if (is_vyi && !allow_generated_vyi) { return true; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= path.len) {
        if (i == path.len || path.charAt(i) == 47 || path.charAt(i) == 92) {
            let seg = path.substring(start, i);
            let is_file_segment = driver_string_contains(seg, ".");
            // Per-file interfaces are private to the library's own build.
            // A -L scan must consume the published, merged .vyi beside the
            // library instead of taking the first partial module it finds.
            if (seg == ".git" || seg == ".cache" || seg == ".vyx_interfaces") { return true; }
            if (seg == "target" || seg == "build") {
                if (!(allow_generated_vyi && is_vyi)) { return true; }
            }
            if (!is_file_segment && seg.startsWith("build_")) {
                if (!(allow_generated_vyi && is_vyi)) { return true; }
            }
            if (!is_file_segment && seg.startsWith("cmake-build")) {
                if (!(allow_generated_vyi && is_vyi)) { return true; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_registry_path_is_ignored(path: string) -> bool {
    return driver_registry_path_is_ignored_mode(path, false);
}

fn driver_registry_path_below_root(root: string, path: string) -> string {
    var root_path = driver_posix_path(root).trim();
    while (root_path.len > 1 && root_path.endsWith("/")) {
        root_path = root_path.substring(0, root_path.len - 1);
    }
    if (path == root_path) { return ""; }
    let root_prefix = root_path + "/";
    if (root_path.len > 0 && path.startsWith(root_prefix)) {
        return path.substring(root_prefix.len, path.len);
    }

    var root_abs = driver_posix_path(driver_resolve_abs_path(root)).trim();
    while (root_abs.len > 1 && root_abs.endsWith("/")) {
        root_abs = root_abs.substring(0, root_abs.len - 1);
    }
    if (path == root_abs) { return ""; }
    let abs_prefix = root_abs + "/";
    if (root_abs.len > 0 && path.startsWith(abs_prefix)) {
        return path.substring(abs_prefix.len, path.len);
    }
    return path;
}

fn driver_module_tail_path(mod: string, start: i32) -> string {
    var out: string = "";
    var i: i32 = start;
    while (i < mod.len) {
        if (mod.charAt(i) == 46) {
            out = out + "/";
        } else {
            out = out + mod.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn driver_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return "."; }
    if (last == 0) { return path.substring(0, 1); }
    return path.substring(0, last);
}

fn driver_filename(path: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { start = i + 1; }
        i = i + 1;
    }
    return path.substring(start, path.len);
}

fn driver_join_path(dir: string, rel: string) -> string {
    if (dir.len == 0 || dir == ".") { return rel; }
    if (dir.endsWith("/") || dir.endsWith("\\")) { return dir + rel; }
    return dir + driver_path_sep() + rel;
}

fn driver_make_dir(path: string) -> i32 {
    if (path.len == 0 || path == ".") { return 0; }
    return vyx_bootstrap_mkdir_p(driver_host_path(path).c_str());
}

fn driver_windows_path(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        if (path.charAt(i) == 47) {
            out = out + "\\";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

@[borrow_args]
fn driver_posix_path(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        if (path.charAt(i) == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

@[borrow_args]
fn driver_string_compare(a: string, b: string) -> i32 {
    var i: i32 = 0;
    let an = a.len;
    let bn = b.len;
    while (i < an && i < bn) {
        let ca = a.charAt(i);
        let cb = b.charAt(i);
        if (ca < cb) { return -1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (an < bn) { return -1; }
    if (an > bn) { return 1; }
    return 0;
}

@[borrow_args]
fn driver_insert_sorted_line(rows: string, value: string) -> string {
    if (value.len == 0) { return rows; }
    if (rows.len == 0) { return value + "\n"; }
    var out = "";
    var inserted = false;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            let line = rows.substring(start, i);
            if (line.len > 0) {
                let cmp = driver_string_compare(value, line);
                if (!inserted && cmp < 0) {
                    out = out + value + "\n";
                    inserted = true;
                }
                if (cmp != 0) {
                    out = out + line + "\n";
                } else {
                    inserted = true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (!inserted) { out = out + value + "\n"; }
    return out;
}

@[borrow_args]
fn driver_module_registry_tmp_path(root: string) -> string {
    let stem = driver_path_stem(root);
    g_driver_registry_tmp_counter = g_driver_registry_tmp_counter + 1;
    driver_make_dir(".cache");
    // policy_i64_to_string() uses reusable bootstrap string storage.  Keep
    // every component alive independently or consecutive conversions can
    // alias and collapse the PID portion, allowing parallel compiler
    // processes to overwrite each other's registry scan files.
    let pid_text = policy_i64_to_string(driver_current_process_id()).clone();
    let now_text = policy_i64_to_string(vyx_bootstrap_now_ms()).clone();
    let counter_text = policy_i64_to_string(g_driver_registry_tmp_counter as i64).clone();
    let stamp = pid_text + "_" + now_text + "_" + counter_text;
    if (stem.len == 0 || stem == ".") { return ".cache/.vyx_module_registry_" + stamp + ".tmp"; }
    return ".cache/.vyx_module_registry_" + stem + "_" + stamp + ".tmp";
}

@[borrow_args]
fn driver_string_contains_substr(s: string, sub: string) -> bool {
    if (sub.len == 0) { return true; }
    if (s.len < sub.len) { return false; }
    var i: i32 = 0;
    while (i + sub.len <= s.len) {
        var j: i32 = 0;
        var equal: bool = true;
        while (j < sub.len) {
            if (s.charAt(i + j) != sub.charAt(j)) { equal = false; break; }
            j = j + 1;
        }
        if (equal) { return true; }
        i = i + 1;
    }
    return false;
}

@[borrow_args]
fn driver_resolve_abs_path(path: string) -> string {
    let raw = vyx_bootstrap_abs_path(driver_host_path(path).c_str());
    if (raw == null) { return driver_host_path(path).clone(); }
    return from_cstr(raw).clone();
}

// ── Package Effect schema discovery ─────────────────────────────────────
// Attribute schemas are package inputs, just like Vyx.toml and source files.
// Keep discovery in the driver so every compiler invocation (including the
// per-unit processes started by `build`) sees the same deterministic set.
// Explicit VYX_EFFECT_SCHEMAS_IN remains supported for generated/legacy
// tables; when package `.attr` files exist they are merged with that table.

fn driver_effect_schema_bool(value: string, default_value: bool) -> bool {
    let t = value.trim().toLower();
    if (t.len == 0) { return default_value; }
    if (t == "0" || t == "false" || t == "off" || t == "no") { return false; }
    if (t == "1" || t == "true" || t == "on" || t == "yes") { return true; }
    return default_value;
}

fn driver_effect_project_root(input_path: string) -> string {
    var path = driver_resolve_abs_path(input_path);
    if (!isDir(path)) { path = driver_dirname(path); }
    var i: i32 = 0;
    while (i < 64 && path.len > 0) {
        if (fileExists(driver_join_path(path.clone(), "Vyx.toml"))) { return path; }
        let parent = driver_dirname(path.clone());
        if (parent == path || parent.len == 0) { break; }
        path = parent;
        i = i + 1;
    }
    return "";
}

fn driver_effect_attr_file_list(root: string, manifest: string) -> string {
    if (root.len == 0) { return ""; }
    var out = "";
    let explicit_raw = driver_toml_get_platform_array(manifest.clone(), "effect", "attr_files");
    if (explicit_raw.len > 0 && (!explicit_raw.trim().startsWith("[")
        || !explicit_raw.trim().endsWith("]"))) {
        return "|ERR|attr_files must be a TOML array in " + driver_join_path(root.clone(), "Vyx.toml");
    }
    let explicit = driver_toml_array_value_lines(explicit_raw);
    var i: i64 = 0;
    let explicit_count = driver_line_count(explicit.clone());
    while (i < explicit_count) {
        let item = driver_line_at(explicit.clone(), i).trim();
        if (item.len > 0) {
            let path = driver_project_abs_path(root.clone(), item);
            if (!path.toLower().endsWith(".attr")) {
                return "|ERR|non-attr-file:" + path;
            }
            if (!fileExists(path.clone())) {
                return "|ERR|missing:" + path;
            }
            out = driver_append_unique_line(out, driver_resolve_abs_path(path));
        }
        i = i + 1;
    }

    let auto_raw = driver_toml_get_platform_value(manifest.clone(), "effect", "auto_discover");
    if (auto_raw.len > 0 && auto_raw.trim() != "true" && auto_raw.trim() != "false") {
        return "|ERR|auto_discover must be a TOML boolean in " + driver_join_path(root.clone(), "Vyx.toml");
    }
    if (driver_effect_schema_bool(auto_raw, true)) {
        let tmp = driver_module_registry_tmp_path(root.clone()) + ".attr";
        let rc = vyx_bootstrap_list_vyx_deps(driver_host_path(root.clone()).c_str(),
                                             driver_host_path(tmp.clone()).c_str());
        if (rc != 0) {
            deleteFile(driver_host_path(tmp.clone()));
            return "|ERR|scan:" + root;
        }
        let rows = readFile(driver_host_path(tmp.clone()));
        deleteFile(driver_host_path(tmp));
        let root_key = driver_resolve_abs_path(root.clone());
        var start: i32 = 0;
        var p: i32 = 0;
        while (p <= rows.len) {
            if (p == rows.len || rows.charAt(p) == 10) {
                var path = rows.substring(start, p).trim();
                if (path.endsWith("\r")) { path = path.substring(0, path.len - 1).trim(); }
                if (path.toLower().endsWith(".attr") && fileExists(path.clone())) {
                    let abs = driver_resolve_abs_path(path.clone());
                    // Auto discovery is package-root only.  Nested schema
                    // directories are opt-in through attr_files, preventing
                    // generated/vendor trees from changing a build silently.
                    if (driver_dirname(abs.clone()) == root_key) {
                        out = driver_append_unique_line(out, abs);
                    }
                }
                start = p + 1;
            }
            p = p + 1;
        }
    }
    return out;
}

fn driver_effect_schema_merge(base: string, extra: string) -> string {
    if (base.len == 0) { return extra; }
    if (extra.len == 0) { return base; }
    if (!effect_attribute_schema_text_valid(base.clone())
        || !effect_attribute_schema_text_valid(extra.clone())) { return "|ERR|invalid-table"; }
    var out = base.clone();
    let base_count = effect_attribute_schema_row_count(base.clone());
    let extra_count = effect_attribute_schema_row_count(extra.clone());
    var i: i32 = 0;
    while (i < extra_count) {
        let row = effect_attribute_schema_row_at(extra.clone(), i);
        let attr = effect_attribute_schema_field(row.clone(), 1);
        var j: i32 = 0;
        while (j < base_count) {
            if (attr == effect_attribute_schema_field(effect_attribute_schema_row_at(base.clone(), j), 1)) {
                return "|ERR|duplicate:" + attr;
            }
            j = j + 1;
        }
        // Check rows appended earlier in this merge as well.
        j = 0;
        while (j < i) {
            if (attr == effect_attribute_schema_field(effect_attribute_schema_row_at(extra.clone(), j), 1)) {
                return "|ERR|duplicate:" + attr;
            }
            j = j + 1;
        }
        out = out + row + "\n";
        i = i + 1;
    }
    return out;
}

fn driver_effect_schema_text(input_path: string) -> string {
    let root = driver_effect_project_root(input_path.clone());
    var table = "";
    let explicit = driver_env_value("VYX_EFFECT_SCHEMAS_IN");
    if (explicit.len > 0) {
        if (!fileExists(explicit.clone())) { return "|ERR|missing-env:" + explicit; }
        table = readFile(explicit.clone());
        if (!effect_attribute_schema_text_valid(table.clone())) { return "|ERR|invalid-env"; }
    }
    if (root.len == 0) { return table; }
    let manifest_path = driver_join_path(root.clone(), "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    let paths = driver_effect_attr_file_list(root.clone(), manifest.clone());
    if (paths.startsWith("|ERR|")) { return paths; }
    var source = "";
    var i: i64 = 0;
    let n = driver_line_count(paths.clone());
    while (i < n) {
        let path = driver_line_at(paths.clone(), i).trim();
        if (path.len > 0) {
            source = source + "// source: " + path + "\n" + readFile(path) + "\n";
        }
        i = i + 1;
    }
    if (source.trim().len == 0) { return table; }
    let parsed = effect_attribute_source_schema_text(source);
    if (parsed.startsWith("|ERR|")) {
        return parsed + " (schema files: " + paths.trim().replace("\n", ", ") + ")";
    }
    return driver_effect_schema_merge(table, parsed);
}

@[borrow_args]
fn driver_module_file_list_mode(root: string,
                                allow_generated_vyi: bool,
                                report_scan_failure: bool) -> string {
    if (root.len == 0 || diag_error_count() > 0) { return ""; }
    let tmp = driver_module_registry_tmp_path(root);
    let tmp_host = driver_host_path(tmp.clone());
    driver_debug_import("file_list root=" + root + " tmp=" + tmp_host);
    let list_rc = vyx_bootstrap_list_vyx_deps(driver_host_path(root.clone()).c_str(),
                                              tmp_host.clone().c_str());
    if (list_rc != 0) {
        deleteFile(tmp_host);
        if (report_scan_failure) {
            diag_emit(diag_sev_ERROR(), diag_code_internal(), 0, 0,
                      "failed to scan module registry root `" + root + "`");
        } else {
            driver_debug_import("optional module registry root unavailable: " + root);
        }
        return "";
    }
    let raw = readFile(tmp_host.clone());
    deleteFile(tmp_host);
    driver_debug_import("file_list raw_len=" + policy_i64_to_string(raw.len as i64));
    var rows = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= raw.len) {
        if (i == raw.len || raw.charAt(i) == 10) {
            var line = raw.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.len > 0) {
                let posix = driver_posix_path(line);
                let filter_path = driver_registry_path_below_root(root.clone(), posix.clone());
                if (!driver_registry_path_is_ignored_mode(filter_path, allow_generated_vyi)) {
                    rows = driver_insert_sorted_line(rows, posix);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    driver_debug_import("file_list rows_len=" + policy_i64_to_string(rows.len as i64));
    return rows;
}

fn driver_module_file_list(root: string) -> string {
    return driver_module_file_list_mode(root, false, true);
}

fn driver_has_named_runtime_lib(dir: string, name: string) -> bool {
    if (dir.len == 0) { return false; }
    if (driver_is_windows()) {
        let has_dll = fileExists(driver_join_path(dir.clone(), name.clone() + ".dll"));
        let has_import_lib = fileExists(driver_join_path(dir.clone(), name.clone() + ".lib"))
                             || fileExists(driver_join_path(dir.clone(), "lib" + name.clone() + ".dll.a"));
        return has_dll && has_import_lib;
    }
    if (fileExists(driver_join_path(dir.clone(), name.clone() + ".so"))) { return true; }
    if (fileExists(driver_join_path(dir.clone(), name.clone() + ".dylib"))) { return true; }
    if (fileExists(driver_join_path(dir.clone(), "lib" + name.clone() + ".so"))) { return true; }
    if (fileExists(driver_join_path(dir.clone(), "lib" + name.clone() + ".dylib"))) { return true; }
    return false;
}

fn driver_has_named_static_runtime_lib(dir: string, name: string) -> bool {
    if (dir.len == 0) { return false; }
    return fileExists(driver_join_path(dir, driver_static_library_filename(name)));
}

fn driver_has_runtime_lib(dir: string) -> bool {
    return driver_has_named_static_runtime_lib(dir.clone(), "vyx_runtime")
        || driver_has_named_static_runtime_lib(dir.clone(), "vyx_run_rt_static")
        || driver_has_named_runtime_lib(dir.clone(), "vyx_run_rt")
        || driver_has_named_runtime_lib(dir.clone(), "vyx_rt");
}

fn driver_runtime_link_name(dir: string) -> string {
    if (driver_has_named_static_runtime_lib(dir.clone(), "vyx_runtime")) { return "vyx_runtime"; }
    if (driver_has_named_static_runtime_lib(dir.clone(), "vyx_run_rt_static")) { return "vyx_run_rt_static"; }
    if (driver_has_named_runtime_lib(dir.clone(), "vyx_run_rt")) { return "vyx_run_rt"; }
    return "vyx_rt";
}

fn driver_runtime_is_static(dir: string) -> bool {
    return driver_has_named_static_runtime_lib(dir.clone(), driver_runtime_link_name(dir));
}

fn driver_runtime_dir() -> string {
    let exe_dir = driver_exe_dir();
    let configured = driver_env_value("VYX_RUNTIME_ROOT");
    if (configured.len > 0) {
        if (driver_has_runtime_lib(configured.clone())) { return configured; }
        let configured_lib = driver_join_path(configured.clone(), "lib");
        if (driver_has_runtime_lib(configured_lib.clone())) { return configured_lib; }
    }
    if (driver_has_runtime_lib(exe_dir.clone())) { return exe_dir; }
    let local_lib = driver_join_path(exe_dir.clone(), "lib");
    if (driver_has_runtime_lib(local_lib.clone())) { return local_lib; }
    let local_rt = driver_join_path(exe_dir.clone(), "vyx_rt");
    if (driver_has_runtime_lib(local_rt.clone())) { return local_rt; }
    let parent = driver_dirname(exe_dir.clone());
    let sdk_lib = driver_join_path(parent.clone(), "lib");
    if (driver_has_runtime_lib(sdk_lib.clone())) { return sdk_lib; }
    let p1 = driver_join_path(parent.clone(), "build_yolo_vyxcg/vyx_rt");
    if (driver_has_runtime_lib(p1.clone())) { return p1; }
    let p2 = driver_join_path(parent.clone(), "build_vyxcg/vyx_rt");
    if (driver_has_runtime_lib(p2.clone())) { return p2; }
    let p3 = driver_join_path(parent.clone(), "build/vyx_rt");
    if (driver_has_runtime_lib(p3.clone())) { return p3; }
    let c1 = "build_yolo_vyxcg/vyx_rt";
    if (driver_has_runtime_lib(c1)) { return c1; }
    let c2 = "build_vyxcg/vyx_rt";
    if (driver_has_runtime_lib(c2)) { return c2; }
    let c3 = "build/vyx_rt";
    if (driver_has_runtime_lib(c3)) { return c3; }
    return "";
}

fn driver_copy_runtime_dll(output_path: string) {
    let rt = driver_runtime_dir();
    if (rt.len == 0 || driver_runtime_is_static(rt.clone())) { return; }
    let out_dir = driver_dirname(output_path);
    let name = driver_runtime_link_name(rt.clone());
    let src = driver_join_path(rt.clone(), driver_shared_library_filename(name.clone()));
    let dst = driver_join_path(out_dir, driver_shared_library_filename(name));
    if (fileExists(src.clone())) {
        vyx_bootstrap_copy_file(src.c_str(), dst.c_str());
    }
}

fn driver_path_stem(path: string) -> string {
    var start: i32 = 0;
    var dot: i32 = path.len as i32;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) {
            start = i + 1;
            dot = path.len as i32;
        } else if (c == 46) {
            dot = i;
        }
        i = i + 1;
    }
    if (dot < start) { dot = path.len as i32; }
    return path.substring(start, dot);
}

// Returns the final path component. Unlike driver_path_stem this keeps dot
// prefixes intact, so dot directories such as `.cache` compare correctly.
fn driver_path_last_segment(path: string) -> string {
    var end: i32 = path.len as i32;
    var trimming: bool = true;
    while (trimming && end > 0) {
        let c = path.charAt(end - 1);
        if (c == 47 || c == 92) { end = end - 1; } else { trimming = false; }
    }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < end) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { start = i + 1; }
        i = i + 1;
    }
    return path.substring(start, end);
}

fn driver_line_count(rows: string) -> i64 {
    var count: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn driver_line_at(rows: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (i > start) {
                if (idx == want) { return rows.substring(start, i).clone(); }
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn driver_append_unique_line(rows: string, value: string) -> string {
    let v = value.trim().clone();
    if (v.len == 0) { return rows; }
    var i: i64 = 0;
    let n = driver_line_count(rows.clone());
    while (i < n) {
        if (driver_line_at(rows.clone(), i).trim() == v) { return rows; }
        i = i + 1;
    }
    return rows + v + "\n";
}

fn driver_path_is_abs(path: string) -> bool {
    if (path.len == 0) { return false; }
    let c0 = path.charAt(0);
    if (c0 == 47 || c0 == 92) { return true; }
    if (path.len >= 3 && path.charAt(1) == 58) { return true; }
    return false;
}

@[borrow_args]
fn driver_project_abs_path(project_dir: string, path: string) -> string {
    let expanded = driver_expand_env(path);
    let p = expanded.trim();
    if (p.len == 0) { return ""; }
    if (driver_path_is_abs(p)) {
        let host_path = driver_host_path(p);
        return host_path.clone();
    }
    let joined = driver_join_path(project_dir, p);
    let host_path = driver_host_path(joined);
    return host_path.clone();
}

fn driver_env_ident_char(c: i32) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c == 95) { return true; }
    return false;
}

fn driver_expand_env(text: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 36 && i + 1 < text.len) {
            if (text.charAt(i + 1) == 123) {
                var j: i32 = i + 2;
                while (j < text.len && text.charAt(j) != 125) { j = j + 1; }
                if (j < text.len) {
                    let name = text.substring(i + 2, j);
                    let val = driver_env_value(name);
                    if (val.len > 0) {
                        out = out + val;
                        i = j + 1;
                        continue;
                    }
                }
            } else if (driver_env_ident_char(text.charAt(i + 1))) {
                var j2: i32 = i + 1;
                while (j2 < text.len && driver_env_ident_char(text.charAt(j2))) { j2 = j2 + 1; }
                let name2 = text.substring(i + 1, j2);
                let val2 = driver_env_value(name2);
                if (val2.len > 0) {
                    out = out + val2;
                    i = j2;
                    continue;
                }
            }
        } else if (c == 37) {
            var k: i32 = i + 1;
            while (k < text.len && text.charAt(k) != 37) { k = k + 1; }
            if (k < text.len) {
                let name3 = text.substring(i + 1, k);
                let val3 = driver_env_value(name3);
                if (val3.len > 0) {
                    out = out + val3;
                    i = k + 1;
                    continue;
                }
            }
        }
        out = out + text.substring(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn driver_merge_toml_arrays(base: string, extra: string) -> string {
    let a = base.trim();
    let b = extra.trim();
    if (a.len == 0) { return b; }
    if (b.len == 0) { return a; }
    if (!a.endsWith("]") || !b.startsWith("[")) { return a; }
    let left = a.substring(0, a.len - 1).trim();
    let right = b.substring(1, b.len - 1).trim();
    if (right.len == 0) { return a; }
    if (left == "[") { return "[" + right + "]"; }
    return left + ", " + right + "]";
}

fn driver_toml_get(content: string, want_section: string, want_key: string) -> string {
    var section: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (!toml_is_comment(line.clone())) {
                if (toml_is_section(line.clone())) {
                    section = toml_section_name(line.clone());
                } else if (section == want_section) {
                    let key = toml_key(line.clone());
                    if (key == want_key) {
                        var value = toml_value(line);
                        let trimmed_value = value.trim();
                        if (trimmed_value.startsWith("[") && !trimmed_value.endsWith("]")) {
                            var bracket: i32 = 0;
                            var in_quote: bool = false;
                            var vi: i32 = 0;
                            while (vi < trimmed_value.len) {
                                let vc = trimmed_value.charAt(vi);
                                if (vc == 34) { in_quote = !in_quote; }
                                else if (!in_quote) {
                                    if (vc == 91) { bracket = bracket + 1; }
                                    else if (vc == 93) { bracket = bracket - 1; }
                                }
                                vi = vi + 1;
                            }
                            var j: i32 = i + 1;
                            var line_start: i32 = j;
                            value = trimmed_value;
                            while (j <= content.len && bracket > 0) {
                                if (j == content.len || content.charAt(j) == 10) {
                                    var nl = content.substring(line_start, j).trim();
                                    if (nl.endsWith("\r")) {
                                        nl = nl.substring(0, nl.len - 1).trim();
                                    }
                                    if (!toml_is_comment(nl.clone()) && nl.len > 0) {
                                        value = value + " " + nl;
                                        var ni: i32 = 0;
                                        while (ni < nl.len) {
                                            let nc = nl.charAt(ni);
                                            if (nc == 34) { in_quote = !in_quote; }
                                            else if (!in_quote) {
                                                if (nc == 91) { bracket = bracket + 1; }
                                                else if (nc == 93) { bracket = bracket - 1; }
                                            }
                                            ni = ni + 1;
                                        }
                                    }
                                    line_start = j + 1;
                                }
                                j = j + 1;
                            }
                        }
                        return value;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn driver_platform_suffix() -> string {
    if (driver_target_is_windows()) { return "_windows"; }
    if (driver_target_is_android()) { return "_android"; }
    if (driver_target_is_linux()) { return "_linux"; }
    if (driver_target_is_apple()) { return "_apple"; }
    return "";
}

fn driver_is_root_target_section(section: string) -> bool {
    if (!section.startsWith("target.") || section.len <= 7) { return false; }
    return !driver_string_contains(section.substring(7, section.len), ".");
}

fn driver_toml_get_platform_array(content: string, section: string, key: string) -> string {
    if (driver_is_root_target_section(section.clone())) {
        return build_toml_get_platform_array(content, section, key);
    }
    let base = driver_toml_get(content.clone(), section.clone(), key.clone());
    let suffix = driver_platform_suffix();
    if (suffix.len == 0) { return base; }
    let extra = driver_toml_get(content, section, key + suffix);
    return driver_merge_toml_arrays(base, extra);
}

fn driver_toml_get_platform_value(content: string, section: string, key: string) -> string {
    if (driver_is_root_target_section(section.clone())) {
        return build_toml_get_platform_value(content, section, key);
    }
    let suffix = driver_platform_suffix();
    if (suffix.len > 0) {
        let platform_value = driver_toml_get(content.clone(), section.clone(), key + suffix);
        if (platform_value.len > 0) { return platform_value; }
    }
    return driver_toml_get(content, section, key);
}

fn driver_target_linkage_name(kind: string) -> string {
    let normalized = kind.trim().toLower();
    if (normalized == "static" || normalized == "staticlib") { return "static"; }
    if (normalized == "shared" || normalized == "dylib" || normalized == "library") {
        return "shared";
    }
    return "";
}

fn driver_triplet_merge_key(content: string,
                            section: string,
                            key: string,
                            suffix: string,
                            current: string) -> string {
    if (suffix.len == 0) { return current; }
    return driver_merge_toml_arrays(
        current,
        driver_toml_get(content, section, key + suffix));
}

fn driver_toml_get_triplet_link_array(content: string,
                                      section: string,
                                      key: string,
                                      target_kind: string) -> string {
    if (driver_is_root_target_section(section.clone())) {
        return build_toml_get_triplet_link_array(content, section, key, target_kind);
    }
    var out = driver_toml_get(content.clone(), section.clone(), key.clone());
    let triple = policy_effective_target_triple();
    let platform = policy_target_platform_name(triple.clone());
    let arch = policy_target_arch_name(triple.clone());
    let compiler = policy_target_compiler_name(triple);
    let linkage = driver_target_linkage_name(target_kind);
    if (platform.len == 0) { return out; }
    let legacy = driver_platform_suffix();
    if (legacy.len > 0 && legacy != "_" + platform) {
        out = driver_triplet_merge_key(content.clone(), section.clone(), key.clone(), legacy, out);
    }
    let os_suffix = "_" + platform;
    out = driver_triplet_merge_key(content.clone(), section.clone(), key.clone(), os_suffix.clone(), out);
    if (arch.len == 0) { return out; }
    let arch_suffix = os_suffix + "_" + arch;
    out = driver_triplet_merge_key(content.clone(), section.clone(), key.clone(), arch_suffix.clone(), out);
    if (compiler.len == 0) { return out; }
    let compiler_suffix = arch_suffix + "_" + compiler;
    out = driver_triplet_merge_key(content.clone(), section.clone(), key.clone(), compiler_suffix.clone(), out);
    if (linkage.len > 0) {
        out = driver_triplet_merge_key(content,
                                       section,
                                       key,
                                       compiler_suffix + "_" + linkage,
                                       out);
    }
    return out;
}

fn driver_toml_single_path_array(path: string) -> string {
    if (path.len == 0) { return ""; }
    return "[\"" + path.replace("\\", "/") + "\"]";
}

fn driver_auto_triplet_lib_paths(project_dir: string, target_kind: string) -> string {
    var out: string = "";
    let base_path = driver_join_path(project_dir, "libs");
    let triple = policy_effective_target_triple();
    let platform = policy_target_platform_name(triple.clone());
    let arch = policy_target_arch_name(triple.clone());
    let compiler = policy_target_compiler_name(triple);
    let linkage = driver_target_linkage_name(target_kind);
    var os_path: string = "";
    var arch_path: string = "";
    var compiler_path: string = "";
    var linkage_path: string = "";
    if (platform.len > 0) {
        os_path = driver_join_path(base_path.clone(), platform);
    }
    if (os_path.len > 0 && arch.len > 0) {
        arch_path = driver_join_path(os_path.clone(), arch);
    }
    if (arch_path.len > 0 && compiler.len > 0) {
        compiler_path = driver_join_path(arch_path.clone(), compiler);
    }
    if (compiler_path.len > 0 && linkage.len > 0) {
        linkage_path = driver_join_path(compiler_path.clone(), linkage);
    }
    if (linkage_path.len > 0 && isDir(linkage_path.clone())) {
        out = driver_merge_toml_arrays(out, driver_toml_single_path_array(linkage_path));
    }
    if (compiler_path.len > 0 && isDir(compiler_path.clone())) {
        out = driver_merge_toml_arrays(out, driver_toml_single_path_array(compiler_path));
    }
    if (arch_path.len > 0 && isDir(arch_path.clone())) {
        out = driver_merge_toml_arrays(out, driver_toml_single_path_array(arch_path));
    }
    if (os_path.len > 0 && isDir(os_path.clone())) {
        out = driver_merge_toml_arrays(out, driver_toml_single_path_array(os_path));
    }
    if (isDir(base_path.clone())) {
        out = driver_merge_toml_arrays(out, driver_toml_single_path_array(base_path));
    }
    return out;
}

fn driver_toml_section_exists(content: string, want_section: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (toml_is_section(line.clone()) && toml_section_name(line) == want_section) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_target_sections(content: string) -> string {
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (toml_is_section(line.clone())) {
                let section = toml_section_name(line);
                if (section.startsWith("target.")
                    && !driver_string_contains(section.substring(7, section.len), ".")) {
                    out = out + section + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_target_name_from_section(section: string, default_name: string) -> string {
    if (section.startsWith("target.") && section.len > 7) {
        return section.substring(7, section.len);
    }
    return default_name;
}

fn driver_select_target_section(manifest: string, pkg_name: string, requested: string) -> string {
    let sections = driver_target_sections(manifest.clone());
    if (requested.len > 0) {
        let want = "target." + requested;
        if (driver_toml_section_exists(manifest.clone(), want.clone())) { return want; }
        if (sections.len == 0 && requested == pkg_name) { return want; }
        return "";
    }
    let pkg_section = "target." + pkg_name;
    if (driver_toml_section_exists(manifest.clone(), pkg_section.clone())) { return pkg_section; }
    if (sections.len == 0) { return pkg_section; }
    return driver_line_at(sections, 0);
}

fn driver_validate_project_manifest_templates(project_path: string) -> bool {
    let project_dir = driver_resolve_abs_path(project_path);
    let manifest_path = driver_join_path(project_dir, "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    if (manifest.len == 0 && !fileExists(manifest_path)) { return true; }
    return build_validate_manifest_templates(manifest.clone(),
                                             driver_target_sections(manifest));
}

fn driver_bool_enabled(value: string) -> bool {
    let v = value.trim();
    return v == "true" || v == "1" || v == "yes" || v == "on";
}

fn driver_source_kind(src: string) -> string {
    if (src.endsWith(".c")) { return "c"; }
    if (src.endsWith(".cpp") || src.endsWith(".cc") || src.endsWith(".cxx")) { return "cpp"; }
    return "vyx";
}

fn driver_module_is_same_or_child(root: string, mod: string) -> bool {
    if (root.len == 0 || mod.len == 0) { return false; }
    if (mod == root) { return true; }
    return mod.len > root.len + 1
           && mod.startsWith(root)
           && mod.charAt(root.len) == 46;
}

fn driver_auto_vyx_sources(entry_abs: string) -> string {
    let root_mod = driver_module_name_from_file(entry_abs.clone());
    if (root_mod.len == 0) { return ""; }
    let root_dir = driver_dirname(entry_abs);
    let files = driver_module_file_list(root_dir);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            var path = files.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.endsWith(".vyx") && fileExists(path.clone())) {
                let mod = driver_module_name_from_file(path.clone());
                if (driver_module_is_same_or_child(root_mod.clone(), mod)) {
                    out = driver_append_unique_line(out.clone(), driver_resolve_abs_path(path));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_toml_array_value_lines(value: string) -> string {
    var out: string = "";
    let rows = toml_array_to_lines(driver_expand_env(value));
    var i: i64 = 0;
    let n = driver_line_count(rows.clone());
    while (i < n) {
        let item = driver_line_at(rows.clone(), i).trim().clone();
        if (item.len > 0) { out = out + item + "\n"; }
        i = i + 1;
    }
    return out;
}

fn driver_project_target_entry(project_dir: string,
                               manifest: string,
                               section: string,
                               pkg_entry: string) -> string {
    var entry = driver_toml_get_platform_value(manifest.clone(), section.clone(), "entry");
    if (entry.len == 0) { entry = pkg_entry; }
    if (entry.len == 0) { return ""; }
    return driver_project_abs_path(project_dir, entry);
}

fn driver_project_load_manifest_path(project_path: string) -> string {
    let project_dir = driver_resolve_abs_path(project_path);
    return driver_join_path(project_dir, "Vyx.toml");
}

fn driver_project_entry_path(project_path: string) -> string {
    let project_dir = driver_resolve_abs_path(project_path);
    let manifest_path = driver_join_path(project_dir.clone(), "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    if (manifest.len == 0 && !fileExists(manifest_path)) { return ""; }
    var pkg_name = driver_toml_get(manifest.clone(), "package", "name");
    if (pkg_name.len == 0) { pkg_name = driver_path_stem(project_dir.clone()); }
    let pkg_entry = driver_toml_get(manifest.clone(), "package", "entry");
    let section = driver_select_target_section(manifest.clone(), pkg_name, "");
    if (section.len == 0) { return ""; }
    return driver_project_target_entry(project_dir, manifest, section, pkg_entry);
}

/// Choose a stable default artifact name for explicit project compilation.
/// The current directory (`--src=project .`) has no useful path stem, so use
/// the manifest target name first and fall back to the resolved project folder.
fn driver_project_target_name(project_path: string) -> string {
    let project_dir = driver_resolve_abs_path(project_path);
    let manifest_path = driver_join_path(project_dir.clone(), "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    if (manifest.len > 0 || fileExists(manifest_path)) {
        var pkg_name = driver_toml_get(manifest.clone(), "package", "name");
        if (pkg_name.len == 0) { pkg_name = driver_path_stem(project_dir.clone()); }
        let section = driver_select_target_section(manifest, pkg_name.clone(), "");
        if (section.len > 0) {
            let target_name = driver_target_name_from_section(section, pkg_name);
            if (target_name.len > 0) { return target_name; }
        }
    }
    let fallback = driver_path_stem(project_dir);
    if (fallback.len > 0) { return fallback; }
    return "app";
}

fn driver_project_collect_sources(project_path: string, want_native: bool) -> string {
    let project_dir = driver_resolve_abs_path(project_path);
    let manifest_path = driver_join_path(project_dir.clone(), "Vyx.toml");
    let manifest = readFile(manifest_path.clone());
    if (manifest.len == 0 && !fileExists(manifest_path)) { return ""; }
    var pkg_name = driver_toml_get(manifest.clone(), "package", "name");
    if (pkg_name.len == 0) { pkg_name = driver_path_stem(project_dir.clone()); }
    let pkg_entry = driver_toml_get(manifest.clone(), "package", "entry");
    let section = driver_select_target_section(manifest.clone(), pkg_name, "");
    if (section.len == 0) { return ""; }
    let entry_abs = driver_project_target_entry(project_dir.clone(), manifest.clone(), section.clone(), pkg_entry);
    if (entry_abs.len == 0) { return ""; }

    var out: string = "";
    if (!want_native) { out = driver_append_unique_line(out.clone(), entry_abs.clone()); }
    let src_raw = driver_toml_get_platform_array(manifest.clone(), section.clone(), "sources");
    let extra = toml_array_to_lines(driver_expand_env(src_raw));
    var si: i64 = 0;
    let sn = driver_line_count(extra.clone());
    while (si < sn) {
        let raw_src = driver_line_at(extra.clone(), si).trim();
        if (raw_src.len > 0) {
            let src_abs = driver_project_abs_path(project_dir.clone(), raw_src);
            let kind = driver_source_kind(src_abs.clone());
            if (want_native) {
                if (kind != "vyx") { out = driver_append_unique_line(out.clone(), src_abs); }
            } else {
                if (kind == "vyx") { out = driver_append_unique_line(out.clone(), src_abs); }
            }
        }
        si = si + 1;
    }
    if (!want_native) {
        var auto_sources_raw = driver_toml_get_platform_value(manifest.clone(), section.clone(), "auto_sources");
        if (auto_sources_raw.len == 0) {
            auto_sources_raw = driver_toml_get_platform_value(manifest.clone(), "build", "auto_sources");
        }
        var auto_rows: string = "";
        if (driver_bool_enabled(auto_sources_raw) && !cli_wants_emit_cpp()) {
            // Explicit `auto_sources` mirrors the build system: every module in
            // the entry's directory whose module name is the entry module or a
            // child of it.
            auto_rows = driver_auto_vyx_sources(entry_abs);
        } else {
            // `build` always feeds the manifest target's local import closure
            // into the object (`local_import_sources` /
            // `entry_project_import_sources`), so project mode must consume the
            // same closure.  Without it the two front ends compile different
            // module sets: the crate object carries the sibling bodies while
            // `--src=project` only sees them as imports, which drops them out
            // of the codegen unit and then crashes while materializing their
            // dyn-vtable / generic bodies.
            auto_rows = build_auto_vyx_import_sources(entry_abs.clone());
        }
        if (auto_rows.len > 0) {
            var ai: i64 = 0;
            let an = driver_line_count(auto_rows.clone());
            while (ai < an) {
                out = driver_append_unique_line(out.clone(), driver_line_at(auto_rows.clone(), ai));
                ai = ai + 1;
            }
        }
    }
    return out;
}

fn driver_project_unit_sources_arg(project_path: string, output_path: string) -> string {
    // MIR2CPP emits a directory. Keep its established manifest path exactly
    // as-is; file-producing modes use the project cache instead.
    if (cli_wants_emit_cpp()) {
        let out_abs = driver_resolve_abs_path(output_path);
        driver_make_dir(out_abs.clone());
        let unit_sources_path = driver_join_path(out_abs, ".vyx_unit_sources");
        let project_sources = driver_project_collect_sources(project_path, false);
        writeFile(unit_sources_path.clone(), project_sources);
        return unit_sources_path;
    }
    let project_dir = driver_resolve_abs_path(project_path);
    let cache_dir = driver_join_path(project_dir, ".cache");
    driver_make_dir(cache_dir.clone());
    let unit_sources_path = driver_join_path(cache_dir, ".vyx_unit_sources");
    let project_sources = driver_project_collect_sources(project_path, false);
    writeFile(unit_sources_path.clone(), project_sources);
    return unit_sources_path;
}

fn driver_mir_cpp_bundle_native_sources(out_dir: string, rows: string) -> string {
    var bundled: string = "";
    var i: i64 = 0;
    let count = driver_line_count(rows.clone());
    while (i < count) {
        let src = driver_line_at(rows.clone(), i).trim();
        if (src.len > 0) {
            if (!fileExists(src.clone())) { return "|ERR|"; }
            let filename = driver_filename(src.clone());
            let rel = "native/src/" + i.toString() + "_" + filename;
            let dst = driver_join_path(out_dir.clone(), rel.clone());
            driver_make_dir(driver_dirname(dst.clone()));
            if (vyx_bootstrap_copy_file(driver_host_path(src).c_str(),
                                        driver_host_path(dst).c_str()) != 0) {
                return "|ERR|";
            }
            bundled = driver_append_unique_line(bundled, rel);
        }
        i = i + 1;
    }
    return bundled;
}

fn driver_mir_cpp_bundle_include_paths(out_dir: string, rows: string) -> string {
    var bundled: string = "";
    var i: i64 = 0;
    let count = driver_line_count(rows.clone());
    while (i < count) {
        let src = driver_line_at(rows.clone(), i).trim();
        if (src.len > 0) {
            if (!isDir(src.clone())) { return "|ERR|"; }
            let rel = "native/include/" + i.toString();
            let dst = driver_join_path(out_dir.clone(), rel.clone());
            if (vyx_bootstrap_copy_runtime_assets(driver_host_path(src).c_str(),
                                                   driver_host_path(dst).c_str()) != 0) {
                return "|ERR|";
            }
            bundled = driver_append_unique_line(bundled, rel);
        }
        i = i + 1;
    }
    return bundled;
}

fn driver_mir_cpp_portable_lib_paths(libs: string) -> string {
    var out = "$" + "{VYX_EXTERNAL_LIB_DIRS}\n";
    var i: i64 = 0;
    let count = driver_line_count(libs.clone());
    while (i < count) {
        let name = driver_line_at(libs.clone(), i).trim();
        if (name == "vyx_compiler_backend" || name == "vyx_rt") {
            out = "$" + "{VYX_RUNTIME_DIR}\n" + out;
            return out;
        }
        i = i + 1;
    }
    return out;
}

fn driver_cli_cpp_lib_paths() -> string {
    var out: string = "";
    var i: i32 = 1;
    while (i < argCount()) {
        let arg = getArg(i);
        if (arg == "--") { break; }
        if ((arg == "-L" || arg == "--lib-path") && i + 1 < argCount()) {
            out = driver_append_unique_line(out, driver_resolve_abs_path(getArg(i + 1)));
            i = i + 2;
        } else if (arg.startsWith("-L") && arg.len > 2) {
            out = driver_append_unique_line(out, driver_resolve_abs_path(arg.substring(2, arg.len)));
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn driver_cli_cpp_libs() -> string {
    var out: string = "";
    var i: i32 = 1;
    while (i < argCount()) {
        let arg = getArg(i);
        if (arg == "--") { break; }
        if ((arg == "-l" || arg == "--link") && i + 1 < argCount()) {
            out = driver_append_unique_line(out, getArg(i + 1));
            i = i + 2;
        } else if (arg.startsWith("-l") && arg.len > 2) {
            out = driver_append_unique_line(out, arg.substring(2, arg.len));
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn driver_cli_cpp_link_objects() -> string {
    var out: string = "";
    var i: i32 = 1;
    while (i < argCount()) {
        let arg = getArg(i);
        if (arg == "--") { break; }
        if (arg == "--link-obj" && i + 1 < argCount()) {
            out = driver_append_unique_line(out, driver_resolve_abs_path(getArg(i + 1)));
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn driver_file_configure_cpp_output(input_path: string, out_dir: string) -> i32 {
    let libs = driver_cli_cpp_libs();
    var lib_paths = driver_cli_cpp_lib_paths();
    if (policy_cli_requested_target().len > 0) {
        lib_paths = driver_mir_cpp_portable_lib_paths(libs.clone());
    }
    return mir_cpp_configure_cmake_project(driver_resolve_abs_path(out_dir),
                                           driver_path_stem(input_path),
                                           "executable",
                                           driver_cli_cpp_link_objects(),
                                           "",
                                           lib_paths,
                                           libs,
                                           "",
                                           "");
}

fn driver_project_configure_cpp_output(project_path: string, out_dir: string) -> i32 {
    driver_debug_project_config("enter project=" + project_path + " out=" + out_dir);
    let project_dir = driver_resolve_abs_path(project_path);
    driver_debug_project_config("project_dir=" + project_dir);
    let manifest_path = driver_join_path(project_dir.clone(), "Vyx.toml");
    driver_debug_project_config("manifest_path=" + manifest_path);
    let manifest = readFile(manifest_path.clone());
    if (manifest.len == 0 && !fileExists(manifest_path.clone())) {
        return die("no Vyx.toml found in project `" + project_dir + "`");
    }
    driver_debug_project_config("manifest_len=" + policy_i64_to_string(manifest.len as i64));
    var pkg_name = driver_toml_get(manifest.clone(), "package", "name");
    if (pkg_name.len == 0) { pkg_name = driver_path_stem(project_dir.clone()); }
    driver_debug_project_config("pkg_name=" + pkg_name);
    let section = driver_select_target_section(manifest.clone(), pkg_name.clone(), "");
    driver_debug_project_config("section=" + section);
    if (section.len == 0) {
        return die("no build target found in project `" + project_dir + "`");
    }
    var target_kind = driver_toml_get_platform_value(manifest.clone(), section.clone(), "type");
    if (target_kind.len == 0) { target_kind = "executable"; }
    driver_debug_project_config("target_kind=" + target_kind);
    let target_name = driver_target_name_from_section(section.clone(), pkg_name);
    driver_debug_project_config("target_name=" + target_name);
    var native_sources = driver_project_collect_sources(project_path, true);
    driver_debug_project_config("native_sources_len=" + policy_i64_to_string(native_sources.len as i64));
    let include_paths_raw = driver_toml_get_platform_array(manifest.clone(), section.clone(), "include_paths");
    driver_debug_project_config("include_paths_raw_len=" + policy_i64_to_string(include_paths_raw.len as i64));
    let include_paths_ptr = vyx_bootstrap_toml_array_abs_paths(project_dir.c_str(),
                                                               project_dir.len as i64,
                                                               include_paths_raw.c_str(),
                                                               include_paths_raw.len as i64);
    driver_debug_project_config("include_paths_bridge_returned");
    if (include_paths_ptr == null) { return die("failed to resolve project include paths"); }
    var include_paths = from_cstr(include_paths_ptr);
    driver_debug_project_config("include_paths_len=" + policy_i64_to_string(include_paths.len as i64));
    var lib_paths_raw = driver_toml_get_triplet_link_array(
        manifest.clone(), section.clone(), "lib_paths", target_kind.clone());
    lib_paths_raw = driver_merge_toml_arrays(
        lib_paths_raw, driver_auto_triplet_lib_paths(project_dir.clone(), target_kind.clone()));
    let lib_paths_ptr = vyx_bootstrap_toml_array_abs_paths(project_dir.c_str(),
                                                           project_dir.len as i64,
                                                           lib_paths_raw.c_str(),
                                                           lib_paths_raw.len as i64);
    if (lib_paths_ptr == null) { return die("failed to resolve project library paths"); }
    var lib_paths = from_cstr(lib_paths_ptr);
    driver_debug_project_config("lib_paths_len=" + policy_i64_to_string(lib_paths.len as i64));
    let libs_raw = driver_toml_get_triplet_link_array(
        manifest.clone(), section.clone(), "libs", target_kind.clone());
    let libs = driver_toml_array_value_lines(libs_raw);
    driver_debug_project_config("libs_len=" + policy_i64_to_string(libs.len as i64));
    let cflags_raw = driver_toml_get_platform_array(manifest.clone(), section.clone(), "cflags");
    let cflags = driver_toml_array_value_lines(cflags_raw);
    driver_debug_project_config("cflags_len=" + policy_i64_to_string(cflags.len as i64));
    let cxxflags_raw = driver_toml_get_platform_array(manifest.clone(), section.clone(), "cxxflags");
    let cxxflags = driver_toml_array_value_lines(cxxflags_raw);
    driver_debug_project_config("cxxflags_len=" + policy_i64_to_string(cxxflags.len as i64));
    driver_debug_project_config("configure begin");
    let out_abs = driver_resolve_abs_path(out_dir);
    if (policy_cli_requested_target().len > 0) {
        native_sources = driver_mir_cpp_bundle_native_sources(out_abs.clone(), native_sources);
        if (native_sources == "|ERR|") {
            return die("failed to bundle native sources for cross-target MIR2CPP export");
        }
        include_paths = driver_mir_cpp_bundle_include_paths(out_abs.clone(), include_paths);
        if (include_paths == "|ERR|") {
            return die("failed to bundle include paths for cross-target MIR2CPP export");
        }
        lib_paths = driver_mir_cpp_portable_lib_paths(libs.clone());
    }
    let project_std = driver_join_path(project_dir.clone(), "std");
    if (driver_std_root_present(project_std.clone())) {
        let bundled_std = driver_join_path(out_abs.clone(), "std");
        let project_std_host = driver_host_path(project_std);
        let bundled_std_host = driver_host_path(bundled_std);
        let copy_std_rc = vyx_bootstrap_copy_runtime_assets(project_std_host.c_str(),
                                                             bundled_std_host.c_str());
        if (copy_std_rc != 0) {
            return die("failed to bundle project standard library for MIR2CPP output");
        }
    }
    let configure_rc = mir_cpp_configure_cmake_project(out_abs,
                                                        target_name,
                                                        target_kind,
                                                        native_sources,
                                                        include_paths,
                                                        lib_paths,
                                                        libs,
                                                        cflags,
                                                        cxxflags);
    return configure_rc;
}

fn driver_module_rel_path(mod: string) -> string {
    return driver_module_tail_path(mod, 0) + ".vyx";
}

fn driver_module_parent_path(mod: string) -> string {
    var last_dot: i32 = -1;
    var i: i32 = 0;
    while (i < mod.len) {
        if (mod.charAt(i) == 46) { last_dot = i; }
        i = i + 1;
    }
    if (last_dot <= 0) { return ""; }
    return mod.substring(0, last_dot);
}

fn driver_exe_dir() -> string {
    if (argCount() > 0) {
        let arg0 = getArg(0);
        let direct = driver_dirname(arg0.clone());
        if (direct != ".") { return direct; }
        let resolved = driver_find_tool_on_path(arg0);
        if (resolved.len > 0) { return driver_dirname(resolved); }
        return direct;
    }
    return ".";
}

fn driver_module_to_file(mod: string, from_path: string) -> string {
    let rel = driver_module_rel_path(mod);
    let c1 = driver_join_path(driver_dirname(from_path), rel);
    if (fileExists(c1)) { return c1; }
    var dot: i32 = 0;
    while (dot < mod.len && mod.charAt(dot) != 46) {
        dot = dot + 1;
    }
    if (dot < mod.len) {
        let sibling_rel = driver_module_tail_path(mod, dot + 1) + ".vyx";
        let c2 = driver_join_path(driver_dirname(from_path), sibling_rel);
        if (fileExists(c2)) { return c2; }
    }
    if (fileExists(rel)) { return rel; }
    return "";
}

@[borrow_args]
fn driver_module_name_from_file(path: string) -> string {
    let content = readFile(path);
    if (content.len == 0) { return ""; }
    // Keep this scanner byte-level: the module registry is part of
    // bootstrap discovery and must not depend on higher-level string
    // predicates that are themselves imported through this registry.
    var leading_meta = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line_end: i32 = i;
            if (line_end > start && content.charAt(line_end - 1) == 13) {
                line_end = line_end - 1;
            }
            var p: i32 = start;
            while (p < line_end) {
                let c = content.charAt(p);
                if (c != 32 && c != 9) { break; }
                p = p + 1;
            }
            if (p < line_end) {
                if (p + 1 < line_end
                    && content.charAt(p) == 47
                    && content.charAt(p + 1) == 47) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (content.charAt(p) == 64) {
                    leading_meta = leading_meta + content.substring(p, line_end);
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (p + 6 < line_end
                    && content.charAt(p) == 109
                    && content.charAt(p + 1) == 111
                    && content.charAt(p + 2) == 100
                    && content.charAt(p + 3) == 117
                    && content.charAt(p + 4) == 108
                    && content.charAt(p + 5) == 101
                    && (content.charAt(p + 6) == 32 || content.charAt(p + 6) == 9)) {
                    var name_start: i32 = p + 7;
                    while (name_start < line_end) {
                        let nc = content.charAt(name_start);
                        if (nc != 32 && nc != 9) { break; }
                        name_start = name_start + 1;
                    }
                    var semi: i32 = name_start;
                    while (semi < line_end && content.charAt(semi) != 59) {
                        semi = semi + 1;
                    }
                    if (semi >= line_end) { return ""; }
                    var name_end: i32 = semi;
                    while (name_end > name_start) {
                        let tc = content.charAt(name_end - 1);
                        if (tc != 32 && tc != 9) { break; }
                        name_end = name_end - 1;
                    }
                    if (name_end <= name_start) { return ""; }
                    return policy_module_identity_from_meta(
                        content.substring(name_start, name_end),
                        leading_meta);
                }
                return "";
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn driver_ident_is_start(c: i32) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn driver_ident_is_part(c: i32) -> bool {
    return driver_ident_is_start(c) || (c >= 48 && c <= 57);
}

fn driver_strip_leading_attrs_and_modifiers(line_in: string) -> string {
    var line = line_in.trim();
    var changed = true;
    while (changed) {
        changed = false;
        if (line.len == 0) { return ""; }
        if (line.startsWith("@[")) {
            var depth: i32 = 0;
            var i: i32 = 0;
            while (i < line.len) {
                let c = line.charAt(i);
                if (c == 91) {
                    depth = depth + 1;
                } else if (c == 93) {
                    depth = depth - 1;
                    if (depth <= 0) {
                        i = i + 1;
                        break;
                    }
                }
                i = i + 1;
            }
            if (i >= line.len) { return ""; }
            line = line.substring(i, line.len).trim();
            changed = true;
            continue;
        }
        if (line.startsWith("public ")) {
            line = line.substring(7, line.len).trim();
            changed = true;
            continue;
        }
        if (line.startsWith("pub ")) {
            line = line.substring(4, line.len).trim();
            changed = true;
            continue;
        }
        if (line.startsWith("unsafe ")) {
            line = line.substring(7, line.len).trim();
            changed = true;
            continue;
        }
    }
    return line;
}

fn driver_symbol_after_keyword(line: string, offset: i32) -> string {
    var i: i32 = offset;
    while (i < line.len && line.charAt(i) == 32) {
        i = i + 1;
    }
    if (i >= line.len || !driver_ident_is_start(line.charAt(i))) { return ""; }
    let start = i;
    var expect_segment: bool = false;
    while (i < line.len) {
        let c = line.charAt(i);
        if (driver_ident_is_part(c)) {
            expect_segment = false;
            i = i + 1;
        } else if (c == 46 && !expect_segment && i + 1 < line.len && driver_ident_is_start(line.charAt(i + 1))) {
            expect_segment = true;
            i = i + 1;
        } else {
            break;
        }
    }
    if (expect_segment) { return line.substring(start, i - 1); }
    return line.substring(start, i);
}

fn driver_symbol_last_segment(sym: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < sym.len) {
        if (sym.charAt(i) == 46) {
            start = i + 1;
        }
        i = i + 1;
    }
    return sym.substring(start, sym.len);
}

fn driver_decl_symbol_from_line(line_in: string) -> string {
    var line = driver_strip_leading_attrs_and_modifiers(line_in);
    if (line.len == 0 || line.startsWith("//")) { return ""; }
    if (line.startsWith("class ")) { return driver_symbol_after_keyword(line, 6); }
    if (line.startsWith("trait ")) { return driver_symbol_after_keyword(line, 6); }
    if (line.startsWith("interface ")) { return driver_symbol_after_keyword(line, 10); }
    if (line.startsWith("enum ")) { return driver_symbol_after_keyword(line, 5); }
    if (line.startsWith("type ")) { return driver_symbol_after_keyword(line, 5); }
    if (line.startsWith("fn ")) { return driver_symbol_after_keyword(line, 3); }
    if (line.startsWith("const ")) { return driver_symbol_after_keyword(line, 6); }
    if (line.startsWith("var ")) { return driver_symbol_after_keyword(line, 4); }
    return "";
}

fn driver_variant_symbol_from_line(line_in: string) -> string {
    let line = driver_strip_leading_attrs_and_modifiers(line_in);
    if (line.len == 0 || line.startsWith("//") || line.startsWith("fn ")) { return ""; }
    if (!driver_ident_is_start(line.charAt(0))) { return ""; }
    return driver_symbol_after_keyword(line, 0);
}

fn driver_symbols_add(symbols: string, sym: string) -> string {
    if (sym.len == 0) { return symbols; }
    let marker = "|" + sym + "|";
    if (string_contains(symbols, marker)) { return symbols; }
    return symbols + sym + "|";
}

fn driver_module_symbols_from_file(path: string) -> string {
    let content = readFile(path);
    if (content.len == 0) { return ""; }
    var symbols = "|";
    var depth: i32 = 0;
    var enum_depth: i32 = -1;
    var extern_depth: i32 = -1;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i);
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1);
            }
            let trimmed = line.trim();
            var saw_enum_decl: bool = false;
            var saw_extern_decl: bool = false;
            if (depth == 0) {
                let sym = driver_decl_symbol_from_line(trimmed);
                if (sym.len > 0) {
                    symbols = driver_symbols_add(symbols, sym);
                    let short_sym = driver_symbol_last_segment(sym.clone());
                    if (short_sym.len > 0 && short_sym != sym) {
                        symbols = driver_symbols_add(symbols, short_sym);
                    }
                    if (trimmed.startsWith("enum ")
                        || trimmed.startsWith("public enum ")
                        || trimmed.startsWith("pub enum ")) {
                        saw_enum_decl = true;
                    }
                }
                if (trimmed.startsWith("extern ")) {
                    saw_extern_decl = true;
                }
            } else if (extern_depth >= 0 && depth == extern_depth) {
                let esym = driver_decl_symbol_from_line(trimmed);
                if (esym.len > 0) {
                    symbols = driver_symbols_add(symbols, esym);
                }
            } else if (enum_depth >= 0 && depth == enum_depth) {
                let vsym = driver_variant_symbol_from_line(trimmed);
                if (vsym.len > 0) {
                    symbols = driver_symbols_add(symbols, vsym);
                }
            }

            if (!trimmed.startsWith("//")) {
                var j: i32 = 0;
                var in_string: bool = false;
                var in_char: bool = false;
                var escaped: bool = false;
                while (j < line.len) {
                    let c = line.charAt(j);
                    if (escaped) {
                        escaped = false;
                        j = j + 1;
                        continue;
                    }
                    if ((in_string || in_char) && c == 92) {
                        escaped = true;
                        j = j + 1;
                        continue;
                    }
                    if (!in_char && c == 34) {
                        in_string = !in_string;
                        j = j + 1;
                        continue;
                    }
                    if (!in_string && c == 39) {
                        in_char = !in_char;
                        j = j + 1;
                        continue;
                    }
                    if (!in_string && !in_char
                        && c == 47 && j + 1 < line.len && line.charAt(j + 1) == 47) {
                        break;
                    }
                    if (!in_string && !in_char && c == 123) {
                        depth = depth + 1;
                        if (saw_enum_decl && enum_depth < 0) {
                            enum_depth = depth;
                        }
                        if (saw_extern_decl && extern_depth < 0) {
                            extern_depth = depth;
                        }
                    } else if (!in_string && !in_char && c == 125) {
                        depth = depth - 1;
                        if (depth < 0) { depth = 0; }
                        if (enum_depth >= 0 && depth < enum_depth) {
                            enum_depth = -1;
                        }
                        if (extern_depth >= 0 && depth < extern_depth) {
                            extern_depth = -1;
                        }
                    }
                    j = j + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return symbols;
}

fn driver_module_registry_from_mode(root: string,
                                    allow_generated_vyi: bool,
                                    report_scan_failure: bool) -> string {
    if (root.len == 0) { return ""; }
    let files = driver_module_file_list_mode(root, allow_generated_vyi, report_scan_failure);
    driver_debug_import("registry_from root=" + root + " files_len=" + policy_i64_to_string(files.len as i64));
    var out = "";
    var debug_seen: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= files.len) {
        if (i == files.len || files.charAt(i) == 10) {
            let path = files.substring(start, i);
            if (path.len > 0) {
                let mod = driver_module_name_from_file(path);
                if (driver_env_value("VYX_DEBUG_IMPORT").len > 0 && debug_seen < 8) {
                    driver_debug_import("registry_file path=" + path + " mod=" + mod);
                    debug_seen = debug_seen + 1;
                }
                if (mod.len > 0) {
                    let stem = driver_path_stem(path);
                    if (!driver_registry_has_module_stem(out.clone(), mod, stem)) {
                        let symbols = driver_module_symbols_from_file(path);
                        out = out + mod + "\t" + path + "\t" + symbols + "\n";
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_module_registry_from(root: string) -> string {
    return driver_module_registry_from_mode(root, false, true);
}

fn driver_registry_has_module_stem(registry: string, mod: string, stem: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            if (driver_line_module(line) == mod
                && driver_path_stem(driver_line_path(line)) == stem) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_path_is_vyi(path: string) -> bool {
    return path.endsWith(".vyi");
}

fn driver_registry_has_exact_vyi_module(registry: string, mod: string) -> bool {
    if (mod.len == 0) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            if (driver_line_module(line) == mod
                && driver_path_is_vyi(driver_line_path(line))) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_registry_append_from(acc: string, root: string) -> string {
    let rows = driver_module_registry_from_mode(root, false, true);
    var out = acc;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            let line = rows.substring(start, i);
            let lm = driver_line_module(line);
            let lp = driver_line_path(line);
            if (lm.len > 0 && lp.len > 0) {
                let stem = driver_path_stem(lp);
                if (!driver_path_is_vyi(lp.clone())
                    && driver_registry_has_exact_vyi_module(out.clone(), lm.clone())) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (driver_path_is_vyi(lp.clone())
                    && driver_registry_has_exact_vyi_module(out.clone(), lm.clone())) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (!driver_registry_has_module_stem(out.clone(), lm, stem)) {
                    out = out + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_registry_append_from_lib_mode(acc: string,
                                        root: string,
                                        report_scan_failure: bool) -> string {
    let rows = driver_module_registry_from_mode(root, true, report_scan_failure);
    var out = acc;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            let line = rows.substring(start, i);
            let lm = driver_line_module(line);
            let lp = driver_line_path(line);
            if (lm.len > 0 && lp.len > 0) {
                let stem = driver_path_stem(lp);
                if (!driver_path_is_vyi(lp.clone())
                    && driver_registry_has_exact_vyi_module(out.clone(), lm.clone())) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (driver_path_is_vyi(lp.clone())
                    && driver_registry_has_exact_vyi_module(out.clone(), lm.clone())) {
                    start = i + 1;
                    i = i + 1;
                    continue;
                }
                if (!driver_registry_has_module_stem(out.clone(), lm, stem)) {
                    out = out + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_registry_append_from_lib(acc: string, root: string) -> string {
    return driver_registry_append_from_lib_mode(acc, root, true);
}

fn driver_registry_append_from_optional_lib(acc: string, root: string) -> string {
    return driver_registry_append_from_lib_mode(acc, root, false);
}

fn driver_registry_append_interface_roots(acc: string) -> string {
    var out = acc;
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "--interface-root" && i + 1 < argc) {
            let root = getArg(i + 1);
            if (root.len > 0) {
                out = driver_registry_append_from_lib(out.clone(), root);
            }
            i = i + 2;
        } else if (cli_option_takes_value(a)) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn driver_nearest_src_ancestor(path: string) -> string {
    if (path.len == 0) { return ""; }
    var cur = driver_dirname(path);
    var guard: i32 = 0;
    while (cur.len > 0 && guard < 64) {
        if (driver_path_stem(cur.clone()) == "src") {
            return cur;
        }
        let parent = driver_dirname(cur.clone());
        if (parent == cur || parent.len == 0) { break; }
        cur = parent;
        guard = guard + 1;
    }
    return "";
}

fn driver_paths_same(a: string, b: string) -> bool {
    let ap = driver_posix_path(a);
    let bp = driver_posix_path(b);
    if (ap == bp) { return true; }
    let aa = driver_posix_path(driver_resolve_abs_path(a));
    let bb = driver_posix_path(driver_resolve_abs_path(b));
    return aa == bb;
}

fn driver_registry_without_path(registry: string, path: string) -> string {
    if (registry.len == 0 || path.len == 0) { return registry; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            if (line.len > 0) {
                let lp = driver_line_path(line);
                if (lp.len == 0 || !driver_paths_same(lp, path)) {
                    out = out + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_std_root_present(root: string) -> bool {
    if (root.len == 0) { return false; }
    if (fileExists(driver_join_path(root.clone(), "clone.vyx"))) { return true; }
    if (fileExists(driver_join_path(root.clone(), "fs.vyx"))) { return true; }
    if (fileExists(driver_join_path(root.clone(), "collections.vyx"))) { return true; }
    return false;
}

fn driver_find_module_lock(input_path: string) -> string {
    var dir = driver_dirname(input_path);
    var depth: i32 = 0;
    while (depth < 32) {
        let c1 = driver_join_path(dir.clone(), "Vyx.lock");
        if (fileExists(c1.clone())) { return c1; }
        let c2 = driver_join_path(dir.clone(), "vyx.lock");
        if (fileExists(c2.clone())) { return c2; }
        let c3 = driver_join_path(dir.clone(), "Vyx.lockfile");
        if (fileExists(c3.clone())) { return c3; }
        let c4 = driver_join_path(dir.clone(), "lockfile");
        if (fileExists(c4.clone())) { return c4; }
        let parent = driver_dirname(dir.clone());
        if (parent == dir) { break; }
        dir = parent;
        depth = depth + 1;
    }
    return "";
}

fn driver_registry_exact_module_line(registry: string, module_identity: string) -> string {
    if (registry.len == 0 || module_identity.len == 0) { return ""; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            if (driver_line_module(line) == module_identity) { return line; }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn driver_registry_append_lock_aliases(registry: string, input_path: string) -> string {
    let lock_path = driver_find_module_lock(input_path);
    if (lock_path.len == 0) { return registry; }
    let content = readFile(lock_path);
    if (content.len == 0) { return registry; }
    var out = registry;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= content.len) {
        if (i == content.len || content.charAt(i) == 10) {
            var line = content.substring(start, i).trim();
            if (line.len > 0 && !line.startsWith("#") && !line.startsWith("//")) {
                var colon: i32 = -1;
                var j: i32 = 0;
                while (j < line.len && colon < 0) {
                    if (line.charAt(j) == 58) { colon = j; }
                    j = j + 1;
                }
                if (colon > 0 && colon + 1 < line.len) {
                    let base = line.substring(0, colon).trim();
                    let selection = line.substring(colon + 1, line.len).trim();
                    let identity = base + "@" + selection;
                    let exact = driver_registry_exact_module_line(out.clone(), identity);
                    if (base.len > 0 && exact.len > 0) {
                        var tab: i32 = 0;
                        while (tab < exact.len && exact.charAt(tab) != 9) {
                            tab = tab + 1;
                        }
                        if (tab < exact.len) {
                            out = out + base + exact.substring(tab, exact.len) + "\n";
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_registry_append_module_source_path(acc: string, path: string) -> string {
    var out = acc;
    let source_path = path.trim();
    if (source_path.len > 0 && fileExists(source_path.clone())) {
        let mod = driver_module_name_from_file(source_path.clone());
        let stem = driver_path_stem(source_path.clone());
        if (mod.len > 0 && !driver_registry_has_module_stem(out.clone(), mod.clone(), stem)) {
            out = out + mod + "\t" + source_path + "\t"
                  + driver_module_symbols_from_file(source_path) + "\n";
        }
    }
    return out;
}

fn driver_registry_append_module_sources(acc: string) -> string {
    var out = acc;
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a == "--module-source" && i + 1 < argc) {
            out = driver_registry_append_module_source_path(out, getArg(i + 1));
            i = i + 2;
        } else if (a == "--module-sources-file" && i + 1 < argc) {
            let contents = readFile(getArg(i + 1));
            var line_index: i64 = 0;
            let line_count = driver_line_count(contents.clone());
            while (line_index < line_count) {
                out = driver_registry_append_module_source_path(
                    out,
                    driver_line_at(contents.clone(), line_index));
                line_index = line_index + 1;
            }
            i = i + 2;
        } else if (cli_option_takes_value(a)) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn driver_path_is_absolute(path: string) -> bool {
    if (path.len == 0) { return false; }
    let c0 = path.charAt(0);
    if (c0 == 47 || c0 == 92) { return true; }
    if (path.len >= 2 && path.charAt(1) == 58) { return true; }
    return false;
}

fn driver_join_rel_path(root: string, rel: string) -> string {
    let trimmed = rel.trim();
    if (trimmed.len == 0) { return root; }
    if (driver_path_is_absolute(trimmed.clone())) { return trimmed; }
    var out = root;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= trimmed.len) {
        if (i == trimmed.len || trimmed.charAt(i) == 47 || trimmed.charAt(i) == 92) {
            let part = trimmed.substring(start, i);
            if (part.len > 0 && part != ".") {
                out = driver_join_path(out.clone(), part);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn driver_std_packages_registry_at(root: string) -> string {
    if (root.len == 0) { return ""; }
    let path = driver_join_path(root, "registry");
    if (fileExists(path.clone())) { return path; }
    return "";
}

fn driver_find_std_packages_root() -> string {
    var hit = driver_env_value("VYX_STD_PACKAGES");
    if (driver_std_packages_registry_at(hit.clone()).len > 0) { return hit; }
    let exe_dir = driver_exe_dir();
    hit = driver_join_path(exe_dir.clone(), "std_packages");
    if (driver_std_packages_registry_at(hit.clone()).len > 0) { return hit; }
    hit = driver_join_path(driver_dirname(exe_dir.clone()), "std_packages");
    if (driver_std_packages_registry_at(hit.clone()).len > 0) { return hit; }
    hit = "bootstrap_compiler/std_packages";
    if (driver_std_packages_registry_at(hit.clone()).len > 0) { return hit; }
    hit = driver_join_path("..", "bootstrap_compiler/std_packages");
    if (driver_std_packages_registry_at(hit.clone()).len > 0) { return hit; }
    return "";
}

fn driver_registry_append_std_packages(acc: string, root: string) -> string {
    let registry_path = driver_std_packages_registry_at(root.clone());
    if (registry_path.len == 0) { return acc; }
    driver_debug_import("std_packages_registry=" + registry_path);
    let contents = readFile(registry_path);
    var out = acc;
    var loaded: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= contents.len) {
        if (i == contents.len || contents.charAt(i) == 10) {
            var line_end: i32 = i;
            if (line_end > start && contents.charAt(line_end - 1) == 13) {
                line_end = line_end - 1;
            }
            var line = contents.substring(start, line_end).trim();
            if (line.len > 0
                && !line.startsWith("#")
                && !line.startsWith("//")
                && line.endsWith(".vyx")) {
                let abs = driver_join_rel_path(root.clone(), line);
                if (fileExists(abs.clone())) {
                    driver_debug_import("std_packages_source=" + abs);
                    out = driver_registry_append_module_source_path(out, abs);
                    loaded = loaded + 1;
                } else {
                    driver_debug_import("std_packages_missing=" + abs);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    driver_debug_import("std_packages_loaded=" + policy_i64_to_string(loaded as i64));
    return out;
}

fn driver_module_registry(input_path: string) -> string {
    let input_dir = driver_dirname(input_path);
    let input_parent_dir = driver_dirname(input_dir.clone());
    let input_dir_is_cache = driver_path_last_segment(input_dir.clone()) == ".cache";
    let exe_dir = driver_exe_dir();
    driver_debug_import("input_path=" + input_path + " input_dir=" + input_dir + " exe_dir=" + exe_dir);
    // Explicit package interfaces and --module-sources come first. Implicit
    // std.* for --src=file is forwarded by std_packages/registry when present.
    var out = driver_registry_append_interface_roots("");
    out = driver_registry_append_module_sources(out);
    if (!cli_no_implicit_std()) {
        let packages_root = driver_find_std_packages_root();
        if (packages_root.len > 0) {
            driver_debug_import("std_packages_root=" + packages_root);
            out = driver_registry_append_std_packages(out.clone(), packages_root);
        } else {
            let exe_std = driver_join_path(exe_dir.clone(), "std");
            driver_debug_import("exe_std=" + exe_std);
            if (driver_std_root_present(exe_std.clone())) {
                driver_debug_import("exe_std present");
                out = driver_registry_append_from(out.clone(), exe_std);
            } else {
                let parent_std = driver_join_path(driver_dirname(exe_dir.clone()), "std");
                driver_debug_import("parent_std=" + parent_std);
                if (driver_std_root_present(parent_std.clone())) {
                    driver_debug_import("parent_std present");
                    out = driver_registry_append_from(out.clone(), parent_std);
                } else {
                    let repo_bootstrap_std = driver_join_path("bootstrap_compiler", "std");
                    driver_debug_import("repo_bootstrap_std=" + repo_bootstrap_std);
                    if (driver_std_root_present(repo_bootstrap_std.clone())) {
                        driver_debug_import("repo_bootstrap_std present");
                        out = driver_registry_append_from(out.clone(), repo_bootstrap_std);
                    } else {
                        let parent_bootstrap_std = driver_join_path("..", repo_bootstrap_std);
                        driver_debug_import("parent_bootstrap_std=" + parent_bootstrap_std);
                        if (driver_std_root_present(parent_bootstrap_std.clone())) {
                            driver_debug_import("parent_bootstrap_std present");
                            out = driver_registry_append_from(out.clone(), parent_bootstrap_std);
                        } else {
                            driver_debug_import("fallback std");
                            out = driver_registry_append_from(out.clone(), "std");
                        }
                    }
                }
            }
        }
    }
    let exe_src = driver_join_path(exe_dir.clone(), "src");
    driver_debug_import("exe_src=" + exe_src);
    out = driver_registry_append_from(out.clone(), exe_src);
    let input_std = driver_join_path(input_dir.clone(), "std");
    driver_debug_import("input_std=" + input_std);
    if (driver_std_root_present(input_std.clone())) {
        driver_debug_import("input_std present");
        out = driver_registry_append_from(out.clone(), input_std);
    }
    // Generated cache directories can contain thousands of historical probes,
    // copied source trees, and interfaces. They are not implicit import roots:
    // scanning one here makes registry construction grow quadratically. A
    // caller that deliberately needs cached modules can still use -L or an
    // explicit interface root.
    if (!input_dir_is_cache) {
        out = driver_registry_append_from(out.clone(), input_dir);
    }
    if (driver_path_stem(input_parent_dir.clone()) == "src") {
        out = driver_registry_append_from(out.clone(), input_parent_dir);
    }
    let nearest_src = driver_nearest_src_ancestor(input_path.clone());
    if (nearest_src.len > 0) {
        out = driver_registry_append_from(out.clone(), nearest_src);
    }
    out = driver_registry_append_from(out.clone(), ".vyx_deps");
    // Also scan -L paths from CLI args — this lets `use mathlib;` find
    // mathlib.vyi when `lib_paths = ["../mathlib/out"]` is set.
    let argc = argCount();
    var ai: i32 = 1;
    while (ai < argc) {
        let a = getArg(ai);
        if ((a == "-L" || a == "--lib-path") && ai + 1 < argc) {
            let lib_path = getArg(ai + 1);
            // The compiler/runtime directory also contains the compiler's own
            // generated bootstrap interfaces. The private compiler backend
            // supplies this host-only surface.
            // is a linker request, not an import of those internal modules.
            // User interface roots remain available through other -L paths or
            // the explicit --interface-root option.
            if (lib_path.len > 0 && !driver_paths_same(lib_path, exe_dir)) {
                out = driver_registry_append_from_optional_lib(out.clone(), lib_path);
            }
            ai = ai + 2;
        } else if (a.startsWith("-L") && a.len > 2) {
            let lib_path = a.substring(2, a.len);
            if (lib_path.len > 0 && !driver_paths_same(lib_path, exe_dir)) {
                out = driver_registry_append_from_optional_lib(out.clone(), lib_path);
            }
            ai = ai + 1;
        } else {
            ai = ai + 1;
        }
    }
    out = driver_registry_without_path(out.clone(), input_path);
    out = driver_registry_append_lock_aliases(out.clone(), input_path);
    driver_debug_import("registry_len=" + policy_i64_to_string(out.len as i64));
    return out;
}

fn driver_module_registry_slow(registry: string, from_path: string) -> string {
    var out = registry;
    let input_dir = driver_dirname(from_path);
    out = driver_registry_append_from(out.clone(), driver_dirname(input_dir));
    out = driver_registry_append_from(out.clone(), ".");
    return out;
}

fn driver_line_module(line: string) -> string {
    var i: i32 = 0;
    while (i < line.len) {
        if (line.charAt(i) == 9) {
            return line.substring(0, i);
        }
        i = i + 1;
    }
    return "";
}

fn driver_line_path(line: string) -> string {
    var i: i32 = 0;
    while (i < line.len) {
        if (line.charAt(i) == 9) {
            let start = i + 1;
            var j: i32 = start;
            while (j < line.len && line.charAt(j) != 9) {
                j = j + 1;
            }
            return line.substring(start, j);
        }
        i = i + 1;
    }
    return "";
}

fn driver_module_matches(requested: string, actual: string) -> bool {
    if (requested.len == 0 || actual.len == 0) { return false; }
    if (actual == requested) { return true; }
    // Hierarchical import: `use std.fs` also loads `std.fs.file`, `std.fs.path`, etc.
    if (actual.len > requested.len + 1
        && actual.startsWith(requested)
        && actual.charAt(requested.len) == 46) {
        return true;
    }
    return false;
}

fn driver_module_requires_registry(mod: string) -> bool {
    if (mod == "std") { return true; }
    if (mod.startsWith("std.")) { return true; }
    return false;
}

fn driver_registry_has_module(registry: string, mod: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            let lm = driver_line_module(line);
            if (driver_module_matches(mod, lm)) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_registry_has_exact_module(registry: string, mod: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            let lm = driver_line_module(line);
            if (driver_registry_exact_module(mod, lm)) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn driver_registry_exact_module(mod: string, actual: string) -> bool {
    if (mod.len == 0 || actual.len == 0) { return false; }
    return mod == actual;
}

fn driver_mark_imported_decl_chain_with_project_local(head: rawptr,
                                                       module_name: string,
                                                       project_local: bool) {
    var cur = head;
    while (cur != null) {
        let meta = decl_get_meta(cur);
        var new_meta = meta;
        if (!driver_string_contains(meta, "|imported")) {
            new_meta = new_meta + "|imported";
        }
        if (project_local && !driver_string_contains(new_meta, "|project-local")) {
            new_meta = new_meta + "|project-local";
        }
        if (module_name.len > 0 && !driver_string_contains(new_meta, "|from:")) {
            new_meta = new_meta + "|from:" + module_name;
        }
        if (new_meta != meta) {
            decl_set_meta(cur, new_meta);
        }
        let members = decl_get_members(cur);
        if (members != null) {
            driver_mark_imported_decl_chain_with_project_local(members,
                                                               module_name,
                                                               project_local);
        }
        cur = decl_get_next(cur);
    }
}

fn driver_mark_imported_unit_with_project_local(src: rawptr, module_name: string, project_local: bool) {
    if (src == null) { return; }
    driver_mark_imported_decl_chain_with_project_local(unit_get_decls(src),
                                                       module_name,
                                                       project_local);
}

fn driver_mark_imported_unit(src: rawptr, module_name: string) {
    driver_mark_imported_unit_with_project_local(src, module_name, false);
}

/// `.vyi` emission runs as its own `--src=file --emit=vyi` invocation, so it
/// cannot re-derive which declarations the producing compile decorated with a
/// `source=<module>` discriminator segment.  `build` does know — a unity crate
/// decorates every member file except its own crate entry, and a single-file
/// crate decorates nothing — and hands the file list over explicitly.
///
/// The promise in the interface must match the emitted symbols exactly.  It is
/// a link-time contract in both directions:
///   * stamping a decl the producer exported undecorated makes consumers
///     reference `__vyx_..._V_source_3D<module>...`, a name that never existed
///     (`lld-link: undefined symbol`);
///   * failing to stamp one the producer did decorate breaks the consumers of
///     a multi-file unity library the same way.
fn driver_vyi_decorated_sources_arg() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i + 1 < argc) {
        let a = getArg(i);
        if (a == "--vyi-decorated-sources") { return getArg(i + 1); }
        if (cli_option_takes_value(a)) { i = i + 2; } else { i = i + 1; }
    }
    return "";
}

/// True when the producing compile embedded a discriminator on `path`'s
/// declarations.
fn driver_vyi_decorated_contains(path: string) -> bool {
    if (path.len == 0) { return false; }
    let list_path = driver_vyi_decorated_sources_arg();
    if (list_path.len == 0) { return false; }
    let text = readFile(list_path);
    if (text.len == 0) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var line = text.substring(start, i).trim();
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1).trim();
            }
            if (line.len > 0 && driver_paths_same(line.clone(), path.clone())) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

/// Record the interface promise on a declaration chain: these symbols carry a
/// `source=<module>` discriminator because the producing compile decorated
/// them.  Deliberately a distinct marker rather than `|project-local`: the
/// interface compile must not perturb sema's unity/ODR view of the unit, only
/// the names its consumers will reference.
fn driver_mark_vyi_source_chain(head: rawptr) {
    var cur = head;
    while (cur != null) {
        let meta = decl_get_meta(cur);
        if (!driver_string_contains(meta, "|vyi-source|")) {
            decl_set_meta(cur, meta + "|vyi-source|");
        }
        let members = decl_get_members(cur);
        if (members != null) {
            driver_mark_vyi_source_chain(members);
        }
        cur = decl_get_next(cur);
    }
}

fn driver_mark_project_local_unit(src: rawptr, module_name: string) {
    driver_mark_imported_unit_with_project_local(src, module_name, true);
}

fn driver_mark_decl_source_path(d: rawptr, path: string) {
    if (d == null || path.len == 0) { return; }
    let meta = decl_get_meta(d);
    if (!driver_string_contains(meta, "|source-path:")) {
        decl_set_meta(d, meta + "|source-path:" + path + "|");
    }
    var mp = decl_get_members(d);
    while (mp != null) {
        driver_mark_decl_source_path(mp, path);
        mp = decl_get_next(mp);
    }
}

fn driver_mark_unit_source_path(src: rawptr, path: string) {
    if (src == null || path.len == 0) { return; }
    var cur = unit_get_decls(src);
    while (cur != null) {
        driver_mark_decl_source_path(cur, path);
        cur = decl_get_next(cur);
    }
}

fn driver_decl_chain_tail(head: rawptr) -> rawptr {
    var tail = head;
    while (tail != null && decl_get_next(tail) != null) {
        tail = decl_get_next(tail);
    }
    return tail;
}

/// Filter out `internal` declarations from an imported unit.
/// Internal decls are file-private and should not be visible to importers.
fn driver_filter_internal_decls(head: rawptr) -> rawptr {
    var new_head: rawptr = null;
    var new_tail: rawptr = null;
    var cur = head;
    while (cur != null) {
        let next = decl_get_next(cur);
        let meta = decl_get_meta(cur);
        if (driver_string_contains(meta, "|vis:internal")) {
            decl_set_next(cur, null);
            cur = next;
            continue;
        }
        decl_set_next(cur, null);
        if (new_head == null) {
            new_head = cur;
            new_tail = cur;
        } else {
            decl_set_next(new_tail, cur);
            new_tail = cur;
        }
        cur = next;
    }
    return new_head;
}

fn driver_append_unit(dst: rawptr, src: rawptr) -> i32 {
    if (dst == null || src == null) { return 0; }
    var head = unit_get_decls(src);
    if (head == null) { return 0; }
    let src_module = driver_unit_module_name(src);
    driver_mark_imported_unit(src, src_module);
    // Note: we do NOT filter internal decls here because public functions
    // may reference internal helpers. Visibility enforcement happens in sema
    // (access checks) rather than at the import level.
    let src_tail = driver_decl_chain_tail(head);
    var imported: i32 = 0;
    var c = head;
    while (c != null) {
        imported = imported + 1;
        c = decl_get_next(c);
    }
    let dst_head = unit_get_decls(dst);
    if (dst_head == null) {
        unit_set_decls(dst, head);
        g_driver_append_tail = src_tail;
    } else if (g_driver_append_tail != null) {
        decl_set_next(g_driver_append_tail, head);
        g_driver_append_tail = src_tail;
    } else {
        let tail = driver_decl_chain_tail(dst_head);
        decl_set_next(tail, head);
        g_driver_append_tail = src_tail;
    }
    unit_set_decl_count(dst, unit_get_decl_count(dst) + imported);
    return imported;
}

fn driver_append_local_unit(dst: rawptr, src: rawptr) -> i32 {
    if (dst == null || src == null) { return 0; }
    var head = unit_get_decls(src);
    if (head == null) { return 0; }
    let src_tail = driver_decl_chain_tail(head);
    var appended: i32 = 0;
    var c = head;
    while (c != null) {
        appended = appended + 1;
        c = decl_get_next(c);
    }
    let dst_head = unit_get_decls(dst);
    if (dst_head == null) {
        unit_set_decls(dst, head);
        g_driver_append_tail = src_tail;
    } else if (g_driver_append_tail != null) {
        decl_set_next(g_driver_append_tail, head);
        g_driver_append_tail = src_tail;
    } else {
        let tail = driver_decl_chain_tail(dst_head);
        decl_set_next(tail, head);
        g_driver_append_tail = src_tail;
    }
    unit_set_decl_count(dst, unit_get_decl_count(dst) + appended);
    return appended;
}

fn driver_parse_file(path: string) -> rawptr {
    if (path.len == 0) { return null; }
    let source = readFile(path);
    if (source.len == 0) { return null; }
    let lx_handle = lex_source(source);
    if (lx_handle == null) { return null; }
    if (lex_error_count(lx_handle) > 0) {
        lexer_dispose(lx_handle);
        return null;
    }
    let parsed = parse_unit(lx_handle);
    lexer_dispose(lx_handle);
    if (parsed != null) {
        parser_auto_qualify_std_modules(parsed);
        parser_auto_qualify_imported_module_types(parsed);
        driver_mark_unit_source_path(parsed, path);
    }
    return parsed;
}

fn driver_seen_module(seen: string, mod: string) -> bool {
    return driver_string_contains(seen, "|M:" + mod + "|");
}

fn driver_seen_file(seen: string, path: string) -> bool {
    return driver_string_contains(seen, "|F:" + path + "|");
}

fn driver_seen_module_stem(seen: string, mod: string, stem: string) -> bool {
    if (mod.len == 0 || stem.len == 0) { return false; }
    return driver_string_contains(seen, "|S:" + mod + "#" + stem + "|");
}

fn driver_seen_error(seen: string) -> bool {
    return driver_string_contains(seen, "|E:");
}

fn driver_seen_add_file(seen: string, path: string) -> string {
    if (path.len == 0 || driver_seen_file(seen.clone(), path.clone())) { return seen; }
    return seen + "|F:" + path + "|";
}

fn driver_seen_add_module(seen: string, mod: string) -> string {
    if (mod.len == 0 || driver_seen_module(seen.clone(), mod.clone())) { return seen; }
    return seen + "|M:" + mod + "|";
}

fn driver_seen_add_module_stem(seen: string, mod: string, stem: string) -> string {
    if (mod.len == 0 || stem.len == 0) { return seen; }
    if (driver_seen_module_stem(seen.clone(), mod.clone(), stem.clone())) { return seen; }
    return seen + "|S:" + mod + "#" + stem + "|";
}

fn driver_seen_add_unit_modules(seen: string, unit: rawptr) -> string {
    var out = seen;
    if (unit == null) { return out; }
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()) {
            out = driver_seen_add_module(out.clone(), decl_get_name(cur));
        }
        cur = decl_get_next(cur);
    }
    return out;
}

fn driver_initial_seen_for_unit(unit: rawptr, input_path: string) -> string {
    var seen = "";
    seen = driver_seen_add_file(seen, input_path.clone());
    let root_module = driver_unit_module_name(unit);
    seen = driver_seen_add_module(seen, root_module.clone());
    seen = driver_seen_add_module_stem(seen, root_module.clone(), driver_path_stem(input_path.clone()));
    seen = driver_seen_add_unit_modules(seen, unit);

    let list_path = driver_unit_sources_arg();
    if (list_path.len == 0) { return seen; }
    let text = readFile(list_path);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var path = text.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.len > 0) {
                seen = driver_seen_add_file(seen, path.clone());
                seen = driver_seen_add_module_stem(seen,
                                                   root_module.clone(),
                                                   driver_path_stem(path.clone()));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return seen;
}

fn driver_load_imports_for_unit(root: rawptr,
                                unit: rawptr,
                                seen: string,
                                registry: string,
                                from_path: string) -> string {
    var cur = unit_get_decls(unit);
    let original_tail = driver_decl_chain_tail(cur);
    var state = seen;
    while (cur != null) {
        if (decl_get_kind(cur) == de_USE()) {
            var import_mod = decl_get_name(cur);
            let alias_name = vyi_use_decl_alias_name(decl_get_meta(cur));
            if (alias_name.len > 0) {
                import_mod = driver_resolve_alias_import_module(import_mod,
                                                                registry,
                                                                from_path);
                state = driver_load_import_module_exact(root,
                                                        import_mod,
                                                        state.clone(),
                                                        registry,
                                                        from_path);
            } else {
                state = driver_load_import_module(root,
                                                  import_mod,
                                                  state.clone(),
                                                  registry,
                                                  from_path);
            }
        }
        if (cur == original_tail) { break; }
        cur = decl_get_next(cur);
    }
    return state.clone();
}

fn driver_resolve_alias_import_module(target: string,
                                      registry: string,
                                      from_path: string) -> string {
    var cur = target;
    while (cur.len > 0) {
        if (driver_registry_has_module(registry.clone(), cur.clone())
            || driver_module_to_file(cur.clone(), from_path.clone()).len > 0
            || driver_module_requires_registry(cur.clone())) {
            return cur;
        }
        cur = driver_module_parent_path(cur);
    }
    return target;
}

fn driver_unit_module_name(unit: rawptr) -> string {
    if (unit == null) { return ""; }
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()) {
            return decl_get_name(cur);
        }
        cur = decl_get_next(cur);
    }
    return "";
}

fn driver_module_is_project_local(root_module: string, module_name: string) -> bool {
    if (root_module.len == 0 || module_name.len == 0) { return true; }
    if (module_name == root_module) { return true; }
    return module_name.startsWith(root_module + ".");
}

fn driver_unit_sources_arg() -> string {
    if (cli_src_kind() == "project" && cli_wants_emit_cpp()) {
        return driver_project_unit_sources_arg(cli_src_path(), fetch_output_path());
    }
    if (cli_src_kind() == "project") {
        let project_path = cli_src_path();
        let output_path = fetch_output_path();
        let unit_sources_path = driver_project_unit_sources_arg(project_path, output_path);
        return unit_sources_path.clone();
    }
    let argc = argCount();
    var i: i32 = 1;
    while (i + 1 < argc) {
        let a = getArg(i);
        if (a == "--unit-sources" || a == "--project-unit-sources"
            || a == "--interface-unit-sources") {
            return getArg(i + 1);
        }
        if (cli_option_takes_value(a)) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return "";
}

fn driver_wants_project_unit_sources() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--project-unit-sources") { return true; }
        if (cli_option_takes_value(a)) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return false;
}

fn driver_wants_interface_unit_sources() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--interface-unit-sources") { return true; }
        if (cli_option_takes_value(a)) {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return false;
}

// ── Multi-file unit progress ────────────────────────────────────────
// The build system compiles a whole crate as one unity invocation, so the
// compiler process is the only place that knows which project file the unit
// is working on.  These `[i/N]` lines let the build stream real per-file
// progress instead of showing one opaque "crate" step.  A single-source
// compile prints nothing.
fn driver_unit_progress_emit(index: i32, total: i32, path: string) {
    print("[" + policy_i64_to_string(index as i64) + "/"
          + policy_i64_to_string(total as i64) + "] parse " + path);
}

/// Number of source files this compilation unit folds into one object:
/// the entry plus every sibling listed by `--unit-sources` /
/// `--project-unit-sources` / the manifest-derived `.vyx_unit_sources`.
fn driver_unit_source_total(input_path: string) -> i32 {
    let list_path = driver_unit_sources_arg();
    if (list_path.len == 0) { return 1; }
    let text = readFile(list_path);
    if (text.len == 0 && !fileExists(list_path)) { return 1; }
    var n: i32 = 1;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var path = text.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.len > 0 && !driver_paths_same(path.clone(), input_path.clone())) {
                n = n + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return n;
}

fn driver_load_local_unit_sources(unit: rawptr, input_path: string) -> i32 {
    if (unit == null) { return 0; }
    let list_path = driver_unit_sources_arg();
    if (list_path.len == 0) { return 0; }
    let text = readFile(list_path);
    if (text.len == 0 && !fileExists(list_path)) {
        report_phase("unit", "failed to read --unit-sources " + list_path);
        return 1;
    }
    let unit_total = driver_unit_source_total(input_path.clone());
    let root_module = driver_unit_module_name(unit);
    var loaded: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var path = text.substring(start, i).trim();
            if (path.endsWith("\r")) {
                path = path.substring(0, path.len - 1).trim();
            }
            if (path.len > 0 && !driver_paths_same(path.clone(), input_path.clone())) {
                let parsed = driver_parse_file(path.clone());
                if (parsed == null) {
                    report_phase("unit", "failed to parse " + path);
                    return 1;
                }
                let mod = driver_unit_module_name(parsed);
                let project_sources = cli_src_kind() == "project";
                let project_unit_sources = driver_wants_project_unit_sources();
                let interface_unit_sources = driver_wants_interface_unit_sources();
                let module_ok = project_sources
                    || project_unit_sources
                    || interface_unit_sources
                    || (!project_sources && (root_module.len == 0 || mod.len == 0 || mod == root_module));
                if (!module_ok) {
                    report_phase("unit", "module mismatch in " + path + ": " + mod
                                 + " (expected " + root_module + ")");
                    return 1;
                }
                var n: i32 = 0;
                var local_unit_module = driver_module_name_from_file(path.clone());
                if (local_unit_module.len == 0) { local_unit_module = mod.clone(); }
                if (interface_unit_sources) {
                    n = driver_append_unit(unit, parsed);
                } else if (project_sources || project_unit_sources) {
                    // Preserve full version/variant identity in imported metadata
                    // while materializing sibling bodies in the project object.
                    driver_mark_project_local_unit(parsed, local_unit_module);
                    n = driver_append_unit(unit, parsed);
                } else {
                    // Interface/unity mode keeps sibling bodies local (they are
                    // part of this module's exported surface, not imports), so
                    // the discriminator promise has to be recorded per sibling
                    // file rather than derived from `|project-local`.
                    if (driver_vyi_decorated_contains(path.clone())) {
                        driver_mark_vyi_source_chain(unit_get_decls(parsed));
                    }
                    n = driver_append_local_unit(unit, parsed);
                }
                loaded = loaded + 1;
                if (unit_total > 1) {
                    driver_unit_progress_emit(1 + loaded, unit_total, path);
                }
                report_phase("unit", path + " (" + policy_i64_to_string(n as i64) + " local decls)");
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (loaded > 0) {
        report_phase("unit", policy_i64_to_string(loaded as i64) + " sibling source(s)");
    }
    return 0;
}

fn driver_load_file(root: rawptr, path: string, seen: string, registry: string) -> string {
    if (path.len == 0) { return seen; }
    if (driver_seen_file(seen, path)) { return seen; }
    driver_debug_import("load_file " + path);
    let next_seen = seen + "|F:" + path + "|";
    let imported = driver_parse_file(path);
    if (imported == null) {
        report_phase("import", "failed to parse " + path);
        return next_seen + "|E:file:" + path + "|";
    }
    var after = next_seen;
    let own_module = driver_unit_module_name(imported);
    let own_stem = driver_path_stem(path);
    if (own_module.len > 0) {
        if (driver_seen_module_stem(seen.clone(), own_module.clone(), own_stem.clone())) {
            return next_seen;
        }
        after = after + "|S:" + own_module.clone() + "#" + own_stem.clone() + "|";
        if (driver_module_requires_registry(own_module)) {
            after = driver_load_registry_exact(root,
                                               own_module,
                                               after.clone(),
                                               registry);
        }
    }
    after = driver_load_imports_for_unit(root,
                                         imported,
                                         after.clone(),
                                         registry,
                                         path);
    if (cli_src_kind() == "project" && cli_wants_emit_cpp()) {
        driver_mark_project_local_unit(imported, own_module);
    }
    let n = driver_append_unit(root, imported);
    report_phase("import", path + " (" + policy_i64_to_string(n as i64) + " decls)");
    return after;
}

fn driver_load_registry_exact(root: rawptr,
                              mod: string,
                              seen: string,
                              registry: string) -> string {
    var state = seen;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            let lm = driver_line_module(line);
            if (driver_registry_exact_module(mod, lm)) {
                let path = driver_line_path(line);
                state = driver_load_file(root, path, state.clone(), registry);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return state.clone();
}

fn driver_load_registry_module(root: rawptr,
                               mod: string,
                               seen: string,
                               registry: string) -> string {
    var state = seen;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            let lm = driver_line_module(line);
            if (driver_module_matches(mod, lm)) {
                let path = driver_line_path(line);
                state = driver_load_file(root, path, state.clone(), registry);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return state.clone();
}

fn driver_load_registry_children(root: rawptr,
                                 mod: string,
                                 seen: string,
                                 registry: string) -> string {
    var state = seen;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= registry.len) {
        if (i == registry.len || registry.charAt(i) == 10) {
            let line = registry.substring(start, i);
            let lm = driver_line_module(line);
            if (lm.len > mod.len + 1 && lm.startsWith(mod) && lm.charAt(mod.len) == 46) {
                let path = driver_line_path(line);
                state = driver_load_file(root, path, state.clone(), registry);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return state.clone();
}

fn driver_load_import_module_exact(root: rawptr,
                                   mod: string,
                                   seen: string,
                                   registry: string,
                                   from_path: string) -> string {
    if (mod.len == 0) { return seen; }
    if (driver_seen_module(seen, mod)) { return seen; }

    var state = seen;
    var active_registry = registry;
    if (active_registry.len == 0) {
        active_registry = driver_module_registry(from_path);
    }
    if (driver_registry_has_exact_vyi_module(active_registry.clone(), mod.clone())) {
        let from_vyi = driver_load_registry_exact(root,
                                                  mod,
                                                  state.clone(),
                                                  active_registry.clone());
        if (from_vyi != state
            || driver_registry_has_exact_module(active_registry.clone(), mod)) {
            return from_vyi;
        }
    }

    let path = driver_module_to_file(mod, from_path);
    if (path.len > 0 && !driver_module_requires_registry(mod)) {
        let actual = driver_module_name_from_file(path);
        if (actual == mod) {
            let exact_state = driver_load_file(root, path, state, active_registry.clone());
            return driver_load_registry_exact(root,
                                              mod,
                                              exact_state.clone(),
                                              active_registry.clone());
        }
    }

    let from_registry = driver_load_registry_exact(root,
                                                   mod,
                                                   state.clone(),
                                                   active_registry.clone());
    if (from_registry != state
        || driver_registry_has_exact_module(active_registry.clone(), mod)) {
        return from_registry;
    }
    if (path.len > 0) {
        return driver_load_file(root, path, state, active_registry.clone());
    }

    let slow_registry = driver_module_registry_slow(active_registry.clone(), from_path);
    let from_slow = driver_load_registry_exact(root,
                                               mod,
                                               state.clone(),
                                               slow_registry.clone());
    if (from_slow != state
        || driver_registry_has_exact_module(slow_registry, mod)) {
        return from_slow;
    }
    report_phase("import", "unknown module " + mod);
    return state + "|E:module:" + mod + "|";
}

fn driver_load_import_module(root: rawptr,
                             mod: string,
                             seen: string,
                             registry: string,
                             from_path: string) -> string {
    if (mod.len == 0) { return seen; }
    if (driver_seen_module(seen, mod)) { return seen; }
    let next_seen = seen + "|M:" + mod + "|";

    var state = next_seen;
    var active_registry = registry;
    if (active_registry.len == 0) {
        active_registry = driver_module_registry(from_path);
    }

    if (driver_registry_has_exact_vyi_module(active_registry.clone(), mod.clone())) {
        let from_vyi = driver_load_registry_module(root,
                                                   mod,
                                                   state.clone(),
                                                   active_registry.clone());
        if (from_vyi != state) {
            return from_vyi;
        }
    }

    // Load the exact module file if it exists
    let path = driver_module_to_file(mod, from_path);
    var loaded_exact: bool = false;
    if (path.len > 0 && !driver_module_requires_registry(mod)) {
        let actual = driver_module_name_from_file(path);
        if (actual == mod) {
            state = driver_load_file(root, path, state.clone(), registry);
            loaded_exact = true;
        }
    }

    // Scan registry for child modules only after exact-file load. Re-loading
    // the exact file duplicates declarations and can corrupt later method lookup.
    if (loaded_exact) {
        let from_exact_siblings = driver_load_registry_exact(root, mod, state.clone(), active_registry.clone());
        let from_children = driver_load_registry_children(root, mod, from_exact_siblings.clone(), active_registry.clone());
        return from_children;
    }
    let from_registry = driver_load_registry_module(root, mod, state.clone(), active_registry.clone());
    if (from_registry != state) {
        return from_registry;
    }
    if (state != next_seen) {
        // We loaded the exact file above, that's enough
        return state;
    }
    if (driver_registry_has_module(active_registry.clone(), mod)) {
        return state;
    }
    if (path.len > 0) {
        return driver_load_file(root, path, state, active_registry.clone());
    }
    let slow_registry = driver_module_registry_slow(active_registry.clone(), from_path);
    let from_slow = driver_load_registry_module(root, mod, state, slow_registry.clone());
    if (from_slow != state || driver_registry_has_module(slow_registry, mod)) {
        return from_slow;
    }
    report_phase("import", "unknown module " + mod);
    return state + "|E:module:" + mod + "|";
}

fn driver_load_import_closure(unit: rawptr, input_path: string) -> i32 {
    if (unit == null) { return 0; }
    var count: i32 = 0;
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_USE()) {
            count = count + 1;
        }
        cur = decl_get_next(cur);
    }
    let registry = driver_module_registry(input_path.clone());
    let initial_seen = driver_initial_seen_for_unit(unit, input_path.clone());
    let seen = driver_load_imports_for_unit(unit, unit, initial_seen, registry, input_path);
    if (driver_seen_error(seen)) {
        return count;
    }
    return count;
}

fn driver_count_use_decls(unit: rawptr) -> i32 {
    if (unit == null) { return 0; }
    var count: i32 = 0;
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_USE()) {
            count = count + 1;
        }
        cur = decl_get_next(cur);
    }
    return count;
}

fn cli_wants_keep_obj() -> bool {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        if (getArg(i) == "--keep-obj") { return true; }
        i = i + 1;
    }
    return false;
}

fn driver_ensure_parent_dir(path: string) {
    let dir = driver_dirname(path);
    if (dir.len == 0 || dir == ".") { return; }
    driver_make_dir(dir);
}

fn driver_find_tool_on_path(tool: string) -> string {
    let path_env = driver_env_value("PATH");
    if (path_env.len == 0 || tool.len == 0) { return ""; }
    var sep: i32 = 58;
    if (driver_is_windows()) { sep = 59; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= path_env.len) {
        if (i == path_env.len || path_env.charAt(i) == sep) {
            let dir = path_env.substring(start, i).trim();
            if (dir.len > 0) {
                let candidate = driver_join_path(dir, tool);
                if (fileExists(candidate)) { return candidate; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn driver_tool_path(tool: string) -> string {
    let llvm_bin_env = driver_env_value("LLVM_BIN");
    if (llvm_bin_env.len > 0) {
        let b1 = driver_join_path(llvm_bin_env, tool + ".exe");
        if (fileExists(b1)) { return b1; }
        let b2 = driver_join_path(llvm_bin_env, tool);
        if (fileExists(b2)) { return b2; }
    }

    let llvm_root_env = driver_env_value("LLVM_ROOT");
    if (llvm_root_env.len > 0) {
        let r1 = driver_join_path(llvm_root_env, tool + ".exe");
        if (fileExists(r1)) { return r1; }
        let r2 = driver_join_path(llvm_root_env, tool);
        if (fileExists(r2)) { return r2; }
        let rbin1 = driver_join_path(driver_join_path(llvm_root_env, "bin"), tool + ".exe");
        if (fileExists(rbin1)) { return rbin1; }
        let rbin2 = driver_join_path(driver_join_path(llvm_root_env, "bin"), tool);
        if (fileExists(rbin2)) { return rbin2; }
    }

    let exe_dir = driver_exe_dir();
    let bin1 = driver_join_path(exe_dir, "clang/bin");
    let p1 = driver_join_path(bin1, tool + ".exe");
    if (fileExists(p1)) { return p1; }
    let p2 = driver_join_path(bin1, tool);
    if (fileExists(p2)) { return p2; }
    let parent = driver_dirname(exe_dir.clone());
    let bin2 = driver_join_path(parent.clone(), "clang/bin");
    let p3 = driver_join_path(bin2, tool + ".exe");
    if (fileExists(p3)) { return p3; }
    let p4 = driver_join_path(bin2, tool);
    if (fileExists(p4)) { return p4; }
    let grand = driver_dirname(parent.clone());
    let bin3 = driver_join_path(grand.clone(), "clang/bin");
    let p5 = driver_join_path(bin3, tool + ".exe");
    if (fileExists(p5)) { return p5; }
    let p6 = driver_join_path(bin3, tool);
    if (fileExists(p6)) { return p6; }
    let bin4 = "../clang/bin";
    let p7 = driver_join_path(bin4, tool + ".exe");
    if (fileExists(p7)) { return p7; }
    let p8 = driver_join_path(bin4, tool);
    if (fileExists(p8)) { return p8; }
    let p9 = driver_find_tool_on_path(tool + ".exe");
    if (p9.len > 0) { return p9; }
    let p10 = driver_find_tool_on_path(tool);
    if (p10.len > 0) { return p10; }
    if (driver_is_windows()) { return tool + ".exe"; }
    return tool;
}

fn driver_decl_symbol_name(d: rawptr) -> string {
    if (d == null) { return ""; }
    return decl_get_name(d);
}

fn driver_collect_dll_exports(unit: rawptr) -> string {
    if (!driver_target_is_windows()) { return ""; }
    // Walk top-level decls and collect linker `/EXPORT:` flags for every
    // locally-defined `public` function and method. This makes Vyx-style
    // visibility ("public") drive native DLL exports without needing
    // dllexport markers in the IR.
    if (unit == null) { return ""; }
    var out: string = "";
    var cur = unit_get_decls(unit);
    while (cur != null) {
        let dk = decl_get_kind(cur);
        let meta = decl_get_meta(cur);
        let is_imported = string_contains(meta, "|imported");
        if (!is_imported) {
            if (dk == de_FN()) {
                if (decl_get_is_public(cur) && decl_get_body(cur) != null) {
                    let dname = driver_decl_symbol_name(cur);
                    if (dname.len > 0 && dname != "main") {
                        out = out + " -Wl,/EXPORT:" + dname;
                    }
                }
            } else if (dk == de_CLASS()) {
                let class_name = decl_get_name(cur);
                var m = decl_get_members(cur);
                while (m != null) {
                    if (decl_get_kind(m) == de_METHOD()
                        && decl_get_is_public(m)
                        && decl_get_body(m) != null) {
                        let mname = decl_get_name(m);
                        out = out + " -Wl,/EXPORT:" + class_name + "_" + mname;
                    }
                    m = decl_get_next(m);
                }
            }
        }
        cur = decl_get_next(cur);
    }
    return out;
}

// ── Codegen-unit object family ──────────────────────────────────────
// A CGU-split compile writes one object per codegen unit beside the primary
// and records the set in `<obj>.cgu.list`.  `build` links that whole list
// (`build_finalize_cgu_sidecars` + the recorded object list); the driver has
// to do the same or every unit but the first is dropped and the link fails on
// symbols that live in them -- `main` and monomorphised method bodies.
fn driver_link_object_paths(obj_path: string) -> string {
    let list_path = obj_path.clone() + ".cgu.list";
    if (!fileExists(list_path.clone())) { return obj_path + "\n"; }
    let text = readFile(list_path);
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var one = text.substring(start, i).trim();
            if (one.endsWith("\r")) { one = one.substring(0, one.len - 1).trim(); }
            if (one.len > 0) { out = out + one + "\n"; }
            start = i + 1;
        }
        i = i + 1;
    }
    if (out.len == 0) { return obj_path + "\n"; }
    return out;
}

fn driver_object_args(obj_path: string) -> string {
    var args: string = "";
    let rows = driver_link_object_paths(obj_path);
    var i: i64 = 0;
    let n = driver_line_count(rows.clone());
    while (i < n) {
        let one = driver_line_at(rows.clone(), i).trim();
        if (one.len > 0) {
            args = args + " \"" + driver_host_path(one) + "\"";
        }
        i = i + 1;
    }
    return args;
}

fn driver_delete_object_family(obj_path: string) {
    let list_path = obj_path.clone() + ".cgu.list";
    if (fileExists(list_path.clone())) { deleteFile(list_path.clone()); }
    if (fileExists(obj_path.clone())) { deleteFile(obj_path.clone()); }
    var k: i32 = 1;
    while (k <= 64) {
        let p = obj_path.clone() + ".cgu." + policy_i64_to_string(k as i64);
        if (!fileExists(p.clone())) { break; }
        deleteFile(p);
        k = k + 1;
    }
}

fn link_to_exe(obj_path: string, exe_path: string, opt_flag: string, auto_link_args: string) -> i32 {
    let link_args = cli_link_args(auto_link_args);
    let clang = driver_tool_path("clang++");
    var cmd = clang;
    if (driver_target_is_linux()) {
        cmd = cmd.clone() + " -no-pie";
    }
    if (driver_target_is_android()) {
        cmd = cmd.clone() + driver_android_libcxx_link_flags();
    }
    if (driver_target_is_windows()) {
        cmd = cmd.clone() + " -Wl,/timestamp:0 -Wl,/subsystem:console -Wl,/stack:67108864";
    }
    var want_strip = (opt_flag == "-O2" || opt_flag == "-O3"
                      || opt_flag == "-Os" || opt_flag == "-Oz");
    if (want_strip) {
        driver_ensure_parent_dir(exe_path);
        var strip_dir = driver_dirname(exe_path);
        if (strip_dir.len == 0) { strip_dir = "."; }
        let strip_link_flags = build_exe_strip_link_flags(strip_dir);
        if (strip_link_flags == "|ERR|") {
            return die("failed to write executable strip version script");
        }
        cmd = cmd.clone() + strip_link_flags;
    }
    cmd = cmd.clone() + driver_object_args(obj_path)
              + " " + opt_flag
              + " -o \"" + driver_host_path(exe_path) + "\""
              + link_args;
    report_phase("link", cmd);
    let rc = driver_run_process(cmd, "", "", "", "", "");
    if (rc != 0) { return rc; }
    if (want_strip) {
        return build_strip_linked_executable(exe_path);
    }
    return rc;
}

fn compile_ir_to_obj(ir_path: string, obj_path: string, opt_flag: string) -> i32 {
    let clang = driver_tool_path("clang++");
    var cmd = clang
              + " -c \"" + driver_host_path(ir_path) + "\""
              + " " + opt_flag
              + cli_object_toolchain_args()
              + " -Wno-override-module"
              + " -o \"" + driver_host_path(obj_path) + "\"";
    report_phase("object", cmd);
    return driver_run_process(cmd, "", "", "", "", "");
}

fn link_to_dll(obj_path: string, dll_path: string, opt_flag: string, exports: string, auto_link_args: string) -> i32 {
    let link_args = cli_link_args(auto_link_args);
    let clang = driver_tool_path("clang++");
    var cmd = clang;
    if (driver_target_is_windows()) {
        cmd = cmd.clone() + " -Wl,/timestamp:0";
    }
    if (driver_target_is_android()) {
        cmd = cmd.clone() + driver_android_libcxx_link_flags();
    }
    cmd = cmd.clone() + " -shared" + driver_object_args(obj_path)
              + " " + opt_flag
              + " -o \"" + driver_host_path(dll_path) + "\""
              + exports
              + link_args;
    report_phase("link", cmd);
    return driver_run_process(cmd, "", "", "", "", "");
}

fn link_to_static_lib(obj_path: string, lib_path: string) -> i32 {
    let ar = driver_tool_path("llvm-ar");
    let cmd = ar + " rcs \"" + driver_host_path(lib_path) + "\"" + driver_object_args(obj_path);
    report_phase("archive", cmd);
    return driver_run_process(cmd, "", "", "", "", "");
}

fn run_output(exe_path: string) -> i32 {
    let cmd = "\"" + driver_host_path(exe_path) + "\"" + cli_runtime_args_for_process();
    report_phase("run", cmd);
    let stdout_path = exe_path + ".stdout";
    let stderr_path = exe_path + ".stderr";
    deleteFile(stdout_path);
    deleteFile(stderr_path);
    var rc: i32 = 0;
    if (driver_is_windows()) {
        let env_value = cli_run_path_prefix() + driver_env_value("PATH");
        rc = driver_run_process(cmd, "", stdout_path, stderr_path, "PATH", env_value);
    } else {
        var env_name = "LD_LIBRARY_PATH";
        if (driver_is_apple()) { env_name = "DYLD_LIBRARY_PATH"; }
        let env_value = cli_run_path_prefix() + driver_env_value(env_name);
        rc = driver_run_process(cmd, "", stdout_path, stderr_path, env_name, env_value);
    }
    let out_text = readFile(stdout_path);
    if (out_text.len > 0) { print(out_text); }
    let err_text = readFile(stderr_path);
    if (err_text.len > 0) { print(err_text); }
    deleteFile(stdout_path);
    deleteFile(stderr_path);
    return rc;
}

fn cli_quote_process_arg(arg: string) -> string {
    var out = "\"";
    var i: i32 = 0;
    while (i < arg.len) {
        let c = arg.charAt(i);
        if (c == 34) {
            out = out + "\\\"";
        } else {
            out = out + arg.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn cli_runtime_args_for_process() -> string {
    let argc = argCount();
    let sep = cli_runtime_separator_index();
    var out = "";
    var i = sep + 1;
    while (i < argc) {
        out = out + " " + cli_quote_process_arg(getArg(i));
        i = i + 1;
    }
    return out;
}

fn driver_repl_forward_args() -> string {
    let argc = argCount();
    var out = "";
    var i: i32 = 2;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if ((a == "-L" || a == "--lib-path"
             || a == "-l" || a == "--link"
             || a == "--link-obj"
             || a == "--target" || a == "--triplet" || a == "--sysroot"
             || a == "--max-errors" || a == "--unit-sources"
             || a == "--interface-root") && i + 1 < argc) {
            out = out + " " + cli_quote_process_arg(a)
                      + " " + cli_quote_process_arg(getArg(i + 1));
            i = i + 2;
        } else if (a.startsWith("-L") || a.startsWith("-l")
                   || a.startsWith("--target=") || a.startsWith("--triplet=")
                   || a.startsWith("--sysroot=")
                   || a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3"
                   || a == "-Os" || a == "-Oz"
                   || a == "-g" || a == "--debug" || a == "--coverage"
                   || a == "--vyi-shallow") {
            out = out + " " + cli_quote_process_arg(a);
            i = i + 1;
        } else {
            print("repl: ignoring unsupported compiler option '" + a + "'");
            i = i + 1;
        }
    }
    return out;
}

/// Format a single type ref as a Vyx-syntax string for .vyi output.
fn vyi_format_array_size(size_expr: rawptr) -> string {
    if (size_expr == null) { return ""; }
    let k = expr_get_kind(size_expr);
    if (k == ex_INT_LIT()) {
        return policy_i64_to_string(expr_get_int_val(size_expr));
    }
    if (k == ex_IDENT()) {
        return expr_get_name(size_expr);
    }
    if (k == ex_UNARY() && expr_get_op(size_expr) == tk_MINUS()) {
        return "-" + vyi_format_array_size(expr_get_lhs(size_expr));
    }
    return policy_i64_to_string(expr_get_int_val(size_expr));
}

fn vyi_format_tuple_type(ty: rawptr) -> string {
    let count = tref_tuple_count(ty);
    if (count == 0) { return "()"; }
    var out = "(";
    var i: i64 = 0;
    while (i < count) {
        if (i > 0) {
            out = out.clone() + ", ";
        }
        let elem_s = vyi_format_type(tref_tuple_elem_at(ty, i));
        out = out.clone() + elem_s.clone();
        i = i + 1;
    }
    if (count == 1) {
        out = out.clone() + ",";
    }
    return out.clone() + ")";
}

fn vyi_format_fn_type(ty: rawptr, unsafe_fn: bool) -> string {
    var out = "fn(";
    if (unsafe_fn) { out = "unsafe fn("; }
    let params = tref_fn_params(ty);
    let count = tref_tuple_count(params);
    var i: i64 = 0;
    while (i < count) {
        if (i > 0) {
            out = out.clone() + ", ";
        }
        let param_s = vyi_format_type(tref_tuple_elem_at(params, i));
        out = out.clone() + param_s.clone();
        i = i + 1;
    }
    let ret_s = vyi_format_type(tref_fn_ret(ty));
    out = out.clone() + ") -> ";
    out = out.clone() + ret_s.clone();
    return out;
}

// Shallow interfaces are compiled in a different source unit. Preserve the
// resolved identity of imported type aliases inside nested parameter types
// (notably `&mut Alias`), so callers and definitions mangle the same symbol.
var g_vyi_type_aliases: string = "";

fn vyi_resolve_imported_type_alias(name: string) -> string {
    let marker = "|" + name + "=";
    let pos = g_vyi_type_aliases.indexOf(marker);
    if (pos < 0) { return name; }
    let start = pos + marker.len;
    var end = start;
    while (end < g_vyi_type_aliases.len && g_vyi_type_aliases.charAt(end as i32) != 124) {
        end = end + 1;
    }
    if (end <= start) { return name; }
    return g_vyi_type_aliases.substring(start as i32, end as i32);
}

fn vyi_format_type(ty: rawptr) -> string {
    if (ty == null) { return "void"; }
    let k = tref_get_kind(ty);
    if (k == ty_VOID()) { return "void"; }
    if (k == ty_BOOL()) { return "bool"; }
    if (k == ty_I8()) { return "i8"; }
    if (k == ty_I16()) { return "i16"; }
    if (k == ty_I32()) { return "i32"; }
    if (k == ty_I64()) { return "i64"; }
    if (k == ty_U8()) { return "u8"; }
    if (k == ty_U16()) { return "u16"; }
    if (k == ty_U32()) { return "u32"; }
    if (k == ty_U64()) { return "u64"; }
    if (k == ty_F32()) { return "f32"; }
    if (k == ty_F64()) { return "f64"; }
    if (k == ty_CHAR()) { return "char"; }
    if (k == ty_STRING()) { return "string"; }
    if (k == ty_RAWPTR()) { return "rawptr"; }
    if (k == ty_PTR()) {
        let pointee_s = vyi_format_type(tref_pointee(ty));
        return "*" + pointee_s.clone();
    }
    if (k == ty_REF()) {
        let pointee_s = vyi_format_type(tref_pointee(ty));
        return "&" + pointee_s.clone();
    }
    if (k == ty_MUTREF()) {
        let pointee_s = vyi_format_type(tref_pointee(ty));
        return "&mut " + pointee_s.clone();
    }
    if (k == ty_ARRAY()) {
        let elem_s = vyi_format_type(tref_array_elem(ty));
        let size_s = vyi_format_array_size(tref_array_size_expr(ty));
        var out = "[" + elem_s.clone();
        if (size_s.len == 0) {
            out = out.clone() + "]";
            return out;
        }
        out = out.clone() + "; ";
        out = out.clone() + size_s.clone();
        out = out.clone() + "]";
        return out;
    }
    if (k == ty_TUPLE()) { return vyi_format_tuple_type(ty); }
    if (k == ty_FN()) { return vyi_format_fn_type(ty, false); }
    if (k == ty_CFN()) { return vyi_format_fn_type(ty, true); }
    if (k == ty_CLASS()) { return vyi_resolve_imported_type_alias(tref_get_name(ty)); }
    return "rawptr";
}

fn vyi_use_decl_alias_name(meta: string) -> string {
    if (meta.len == 0) { return ""; }
    if (meta.charAt(0) == 124) { return ""; }
    let marker = meta.indexOf("|");
    if (marker > 0) { return meta.substring(0, marker); }
    return meta;
}

fn vyi_emit_use(d: rawptr) -> string {
    if (d == null) { return ""; }
    let target = decl_get_name(d);
    if (target.len == 0 || string_starts_with(target, "__")) { return ""; }
    let alias = vyi_use_decl_alias_name(decl_get_meta(d));
    if (alias.len > 0) {
        var out = "use " + alias.clone();
        out = out.clone() + " = ";
        out = out.clone() + target.clone();
        out = out.clone() + ";\n";
        return out;
    }
    var out = "use " + target.clone();
    out = out.clone() + ";\n";
    return out;
}

/// Format function parameters for a .vyi signature.
fn vyi_format_params(params: rawptr) -> string {
    var out = "";
    var cur = params;
    var first = true;
    while (cur != null) {
        if (!first) {
            out = out.clone() + ", ";
        }
        let pname = decl_get_name(cur);
        if (pname == "self") {
            let markers = decl_get_generic_params(cur);
            var self_piece = "self";
            if (string_contains(markers, "|receiver:shared")) {
                self_piece = "&self";
            } elif (string_contains(markers, "|receiver:own_mut")) {
                self_piece = "mut self";
            } elif (string_contains(markers, "|receiver:mut")) {
                self_piece = "&mut self";
            } elif (string_contains(markers, "|receiver:own")) {
                self_piece = "own self";
            }
            out = out.clone() + self_piece.clone();
            first = false;
            cur = decl_get_next(cur);
            continue;
        }
        let pty = decl_get_ty(cur);
        let pty_s = vyi_format_type(pty);
        let param_piece = pname.clone() + ": " + pty_s.clone();
        out = out.clone() + param_piece.clone();
        first = false;
        cur = decl_get_next(cur);
    }
    return out;
}

fn driver_vis_is_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn driver_vis_trim(s: string) -> string {
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end && driver_vis_is_space(s.charAt(start))) {
        start = start + 1;
    }
    while (end > start && driver_vis_is_space(s.charAt(end - 1))) {
        end = end - 1;
    }
    if (start == 0 && end == (s.len as i32)) { return s; }
    return s.substring(start, end);
}

fn driver_vis_outer_parens(s: string) -> bool {
    let t = driver_vis_trim(s);
    if (t.len < 2) { return false; }
    if (t.charAt(0) != 40 || t.charAt((t.len - 1) as i32) != 41) { return false; }
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < t.len) {
        let c = t.charAt(i);
        if (c == 40) {
            depth = depth + 1;
        } elif (c == 41) {
            depth = depth - 1;
            if (depth == 0 && i != t.len - 1) { return false; }
        }
        if (depth < 0) { return false; }
        i = i + 1;
    }
    return depth == 0;
}

fn driver_vis_strip_outer_parens(s: string) -> string {
    var out = driver_vis_trim(s);
    var changed: bool = true;
    while (changed && driver_vis_outer_parens(out)) {
        changed = false;
        out = driver_vis_trim(out.substring(1, (out.len - 1) as i32));
        changed = true;
    }
    return out;
}

fn driver_vis_find_top_addsub(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && (c == 43 || c == 45)) { return i; }
        i = i - 1;
    }
    return -1;
}

fn driver_vis_find_top_and(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && c == 38) { return i; }
        i = i - 1;
    }
    return -1;
}

fn driver_vis_expr_exports_world(expr_raw: string) -> bool {
    let expr = driver_vis_strip_outer_parens(expr_raw);
    if (expr.len == 0) { return false; }
    let addsub = driver_vis_find_top_addsub(expr);
    if (addsub >= 0) {
        let lhs = driver_vis_expr_exports_world(expr.substring(0, addsub));
        let rhs = driver_vis_expr_exports_world(expr.substring(addsub + 1, expr.len));
        if (expr.charAt(addsub) == 43) { return lhs || rhs; }
        return lhs && !rhs;
    }
    let and_pos = driver_vis_find_top_and(expr);
    if (and_pos >= 0) {
        return driver_vis_expr_exports_world(expr.substring(0, and_pos))
            && driver_vis_expr_exports_world(expr.substring(and_pos + 1, expr.len));
    }
    return expr == "world" || expr == "public";
}

fn driver_decl_attr_value(d: rawptr, attr: string) -> string {
    if (d == null || attr.len == 0) { return ""; }
    let meta = decl_get_meta(d);
    if (!driver_string_contains(meta, "|attrs:")) { return ""; }
    var pat = "@[" + attr + "(";
    var pos = meta.indexOf(pat);
    if (pos < 0) {
        pat = "@" + attr + "(";
        pos = meta.indexOf(pat);
    }
    if (pos < 0) { return ""; }
    let start = (pos + pat.len) as i32;
    var i = start;
    var depth: i32 = 1;
    while (i < meta.len) {
        let ch = meta.charAt(i);
        if (ch == 40) {
            depth = depth + 1;
        } elif (ch == 41) {
            depth = depth - 1;
            if (depth == 0) {
                return meta.substring(start, i);
            }
        }
        i = i + 1;
    }
    return "";
}

fn driver_decl_visibility_expr(d: rawptr) -> string {
    if (d == null) { return "self"; }
    var expr = driver_decl_attr_value(d, "vis");
    if (expr.len == 0) { expr = driver_decl_attr_value(d, "visibility"); }
    if (expr.len > 0) { return driver_vis_trim(expr); }
    let meta = decl_get_meta(d);
    if (driver_string_contains(meta, "|vis:public")) { return "world"; }
    if (driver_string_contains(meta, "|vis:private")) { return "self"; }
    if (driver_string_contains(meta, "|vis:internal")) { return "package"; }
    if (driver_string_contains(meta, "|vis:protected")) { return "tree"; }
    if (decl_get_is_public(d)) { return "world"; }
    return "self";
}

fn driver_decl_exports_world(d: rawptr) -> bool {
    return driver_vis_expr_exports_world(driver_decl_visibility_expr(d));
}

fn vyi_decl_attr_prefix_mode(d: rawptr, indent: string, project_private: bool) -> string {
    if (d == null) { return ""; }
    let meta = decl_get_meta(d);
    var out = "";
    let vis = driver_decl_visibility_expr(d);
    if (!project_private && !driver_vis_expr_exports_world(vis)) {
        out = out + indent + "@[vis(" + vis + ")]\n";
    }
    if (driver_string_contains(meta, "borrow_args")) {
        out = out + indent + "@[borrow_args]\n";
    }
    let migrate_args = policy_meta_attribute_value(meta, "migrate");
    if (migrate_args.len > 0) {
        out = out + indent + "@[migrate(" + migrate_args + ")]\n";
    }
    let discard_args = policy_meta_attribute_value(meta, "discard");
    if (discard_args.len > 0) {
        out = out + indent + "@[discard(" + discard_args + ")]\n";
    }
    return out;
}

// Callable decls only: fields carry no symbols, so the source discriminator
// is meaningless (and unparsable) on struct/class field declarations.
fn vyi_source_attr_prefix(d: rawptr, indent: string) -> string {
    if (d == null || g_vyi_source_module.len == 0) { return ""; }
    // The attribute is a promise: the consuming compile will mangle imported
    // symbols with a `source=<module>` discriminator segment.  Only stamp it
    // for declarations the producing compile really decorated
    // (`--vyi-decorated-sources`, computed by `build` from the crate shape).
    // Everything else -- the crate entry, single-file crates, non-unity
    // compiles -- exports plain names, and stamping them made consumers demand
    // names the producing library never emitted
    // (undefined `__vyx_M_..._V_source_3D...` at link time).
    if (!driver_string_contains(decl_get_meta(d), "|vyi-source|")) { return ""; }
    return indent + "@[source(" + g_vyi_source_module + ")]\n";
}

fn vyi_decl_attr_prefix(d: rawptr, indent: string) -> string {
    return vyi_decl_attr_prefix_mode(d, indent, false);
}

fn vyi_impl_suffix(gp: string) -> string {
    let marker = "|impl:";
    let start0 = gp.indexOf(marker);
    if (start0 < 0) { return ""; }
    var start = start0 + marker.len;
    var end = start;
    while (end < gp.len && gp.charAt(end as i32) != 124) {
        end = end + 1;
    }
    var out = "";
    var part_start = start;
    var p = start;
    while (p <= end) {
        if (p == end || gp.charAt(p as i32) == 44) {
            let raw_part = gp.substring(part_start as i32, p as i32);
            if (raw_part.len > 0) {
                let part = driver_symbol_last_segment(raw_part);
                if (part.len > 0) {
                    if (out.len > 0) { out = out + ", "; }
                    out = out + part;
                }
            }
            part_start = p + 1;
        }
        p = p + 1;
    }
    if (out.len == 0) { return ""; }
    return " : " + out.clone();
}

/// Emit a function decl as a Vyx-syntax declaration line for .vyi.
fn vyi_generic_param_clause(gp: string) -> string {
    if (gp.len == 0 || string_starts_with(gp, "|")) { return ""; }
    var names = gp;
    let marker = gp.indexOf("|");
    if (marker >= 0) { names = gp.substring(0, marker); }
    if (names.len == 0) { return ""; }
    return "<" + names + ">";
}

fn vyi_where_clause(gp: string) -> string {
    let marker = "|where:";
    let start = gp.indexOf(marker);
    if (start < 0) { return ""; }
    var clause = gp.substring(start + marker.len, gp.len);
    let next_marker = clause.indexOf("|");
    if (next_marker >= 0) { clause = clause.substring(0, next_marker); }
    clause = clause.trim();
    if (clause.len == 0) { return ""; }
    return " where " + clause;
}

fn vyi_emit_function_mode(d: rawptr, project_private: bool) -> string {
    let name = decl_get_name(d);
    let params_s = vyi_format_params(decl_get_params(d));
    let ret_ty = vyi_format_type(decl_get_ty(d));
    let gp = decl_get_generic_params(d);
    let gp_str = vyi_generic_param_clause(gp);
    let attr_prefix = vyi_source_attr_prefix(d, "") + vyi_decl_attr_prefix_mode(d, "", project_private);
    var out = attr_prefix.clone() + "public fn ";
    out = out.clone() + name.clone();
    out = out.clone() + gp_str.clone();
    out = out.clone() + "(";
    out = out.clone() + params_s.clone();
    out = out.clone() + ") -> ";
    out = out.clone() + ret_ty.clone();
    out = out.clone() + vyi_where_clause(gp);
    out = out.clone() + ";\n";
    return out;
}

fn vyi_emit_function(d: rawptr) -> string {
    return vyi_emit_function_mode(d, false);
}

/// Emit a class/struct decl as a Vyx-syntax declaration block for .vyi.
fn vyi_emit_class_mode(d: rawptr, project_private: bool) -> string {
    var name = decl_get_name(d);
    let gp = decl_get_generic_params(d);
    var kind_word = "class";
    if (string_contains(gp, "|kind:struct")) { kind_word = "struct"; }
    else if (string_contains(gp, "|kind:interface")) { kind_word = "interface"; }
    else if (string_contains(gp, "|kind:concept")) { kind_word = "concept"; }
    if (kind_word == "interface") {
        name = driver_symbol_last_segment(name);
    }
    let gp_str = vyi_generic_param_clause(gp);
    let attr_prefix = vyi_decl_attr_prefix_mode(d, "", project_private);
    let impl_suffix = vyi_impl_suffix(gp);
    var out = attr_prefix.clone() + "public ";
    out = out.clone() + kind_word.clone();
    out = out.clone() + " ";
    out = out.clone() + name.clone();
    out = out.clone() + gp_str.clone();
    out = out.clone() + impl_suffix.clone();
    out = out.clone() + vyi_where_clause(gp);
    out = out.clone() + " {\n";

    // Emit members
    var m = decl_get_members(d);
    while (m != null) {
        let mk = decl_get_kind(m);
        let m_is_pub = driver_decl_exports_world(m);
        if (mk == de_FIELD()) {
            let field_attr = vyi_decl_attr_prefix_mode(m, "    ", project_private);
            let field_name = decl_get_name(m);
            let field_ty = vyi_format_type(decl_get_ty(m));
            out = out.clone() + field_attr.clone();
            out = out.clone() + "    public ";
            out = out.clone() + field_name.clone();
            out = out.clone() + ": ";
            out = out.clone() + field_ty.clone();
            out = out.clone() + ";\n";
        } else if (mk == de_METHOD() && (project_private || m_is_pub)) {
            let mname = decl_get_name(m);
            let mparams = vyi_format_params(decl_get_params(m));
            let mret = vyi_format_type(decl_get_ty(m));
            var static_str = "";
            if (decl_get_is_static(m)) { static_str = "static "; }
            let method_attr = vyi_source_attr_prefix(m, "    ") + vyi_decl_attr_prefix_mode(m, "    ", project_private);
            out = out.clone() + method_attr.clone();
            out = out.clone() + "    public ";
            out = out.clone() + static_str.clone();
            out = out.clone() + "fn ";
            out = out.clone() + mname.clone();
            out = out.clone() + vyi_generic_param_clause(decl_get_generic_params(m));
            out = out.clone() + "(";
            out = out.clone() + mparams.clone();
            out = out.clone() + ") -> ";
            out = out.clone() + mret.clone();
            out = out.clone() + vyi_where_clause(decl_get_generic_params(m));
            out = out.clone() + ";\n";
        }
        m = decl_get_next(m);
    }
    out = out.clone() + "}\n";
    return out;
}

fn vyi_emit_class(d: rawptr) -> string {
    return vyi_emit_class_mode(d, false);
}

/// Trait implementations are part of a module's public type facts. A shallow
/// interface that contains only the trait requirement leaves a consumer with
/// `Self` but no concrete implementation to bind it to.
fn vyi_emit_impl(d: rawptr) -> string {
    let gp = decl_get_generic_params(d);
    let suffix = vyi_impl_suffix(gp);
    var out = "impl" + vyi_generic_param_clause(gp) + " ";
    if (suffix.startsWith(" : ")) {
        out = out + suffix.substring(3, suffix.len) + " for ";
    }
    out = out + decl_get_name(d) + vyi_where_clause(gp) + " {\n";
    var m = decl_get_members(d);
    while (m != null) {
        if (decl_get_kind(m) == de_METHOD()) {
            var static_str = "";
            if (decl_get_is_static(m)) { static_str = "static "; }
            out = out + vyi_source_attr_prefix(m, "    ")
                  + "    public " + static_str + "fn " + decl_get_name(m)
                  + vyi_generic_param_clause(decl_get_generic_params(m))
                  + "(" + vyi_format_params(decl_get_params(m)) + ") -> "
                  + vyi_format_type(decl_get_ty(m))
                  + vyi_where_clause(decl_get_generic_params(m)) + ";\n";
        }
        m = decl_get_next(m);
    }
    return out + "}\n";
}

fn vyi_impl_exports_public_contract(unit: rawptr, d: rawptr) -> bool {
    let suffix = vyi_impl_suffix(decl_get_generic_params(d));
    if (!suffix.startsWith(" : ")) { return false; }
    let trait_name = suffix.substring(3, suffix.len);
    let target_name = decl_get_name(d);
    var trait_public = false;
    var target_public = policy_primitive_type_kind(target_name.clone()) != 0;
    var cur = unit_get_decls(unit);
    while (cur != null) {
        let kind = decl_get_kind(cur);
        let name = decl_get_name(cur);
        if (kind == de_CLASS() && name == trait_name
            && driver_decl_exports_world(cur)) {
            trait_public = true;
        }
        if ((kind == de_CLASS() || kind == de_ENUM())
            && name == target_name && driver_decl_exports_world(cur)) {
            target_public = true;
        }
        cur = decl_get_next(cur);
    }
    return trait_public && target_public;
}

/// Emit an enum decl with all variants for .vyi.
fn vyi_emit_enum(d: rawptr) -> string {
    let name = decl_get_name(d);
    var out = "public enum " + name.clone();
    out = out.clone() + " {\n";
    var m = decl_get_members(d);
    while (m != null) {
        if (decl_get_kind(m) == de_VARIANT()) {
            let variant_name = decl_get_name(m);
            out = out.clone() + "    ";
            out = out.clone() + variant_name.clone();
            out = out.clone() + ",\n";
        }
        m = decl_get_next(m);
    }
    out = out.clone() + "}\n";
    return out;
}

/// Emit a type alias for .vyi.
fn vyi_emit_type_alias(d: rawptr) -> string {
    let name = decl_get_name(d);
    let ty_s = vyi_format_type(decl_get_ty(d));
    var out = "public type " + name.clone();
    out = out.clone() + " = ";
    out = out.clone() + ty_s.clone();
    out = out.clone() + ";\n";
    return out;
}

/// Emit a const/global var for .vyi.
fn vyi_emit_const_or_var(d: rawptr) -> string {
    let name = decl_get_name(d);
    let ty_s = vyi_format_type(decl_get_ty(d));
    var kw = "let";
    if (decl_get_kind(d) == de_CONST()) { kw = "const"; }
    var out = "public " + kw.clone();
    out = out.clone() + " ";
    out = out.clone() + name.clone();
    out = out.clone() + ": ";
    out = out.clone() + ty_s.clone();
    out = out.clone() + ";\n";
    return out;
}

/// Emit a .vyi (Vyx interface) file for the given unit.
/// Walks all top-level decls and emits `module` + public function/class signatures.
// The module of the unit currently emitting its shallow `.vyi`.  Recorded on
// every emitted decl as `@[source(...)]` so consumers reproduce the symbol
// discriminator the producing binary embedded.
var g_vyi_source_module: string = "";

fn emit_vyi_file(unit: rawptr, output_path: string) -> i32 {
    if (unit == null) { return 1; }
    g_vyi_type_aliases = "";
    report_phase("vyi", "begin " + output_path);
    let project_private = cli_wants_vyi_project_private();
    writeFile(output_path, "// Auto-generated .vyi interface file. Do not edit.\n");
    report_phase("vyi", "header written");

    // Module declaration (skip if the unit has no module decl — still emit valid vyi)
    var cur = unit_get_decls(unit);
    var found_module = false;
    var module_scan_index: i32 = 0;
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()
            && !string_starts_with(decl_get_name(cur), "__")
            && !driver_string_contains(decl_get_meta(cur), "|imported")) {
            let module_line = "module " + decl_get_name(cur) + ";\n\n";
            appendFile(output_path, module_line);
            g_vyi_source_module = decl_get_name(cur);
            found_module = true;
            break;
        }
        cur = decl_get_next(cur);
        module_scan_index = module_scan_index + 1;
    }
    if (!found_module) {
        appendFile(output_path, "// (no module declaration in source)\n\n");
    }
    report_phase("vyi", "module emitted");

    cur = unit_get_decls(unit);
    var emitted_use = false;
    var use_count: i32 = 0;
    while (cur != null) {
        if (decl_get_kind(cur) == de_USE()
            && !driver_string_contains(decl_get_meta(cur), "|imported")) {
            let alias = vyi_use_decl_alias_name(decl_get_meta(cur));
            let target = decl_get_name(cur);
            if (alias.len > 0 && target.len > 0) {
                g_vyi_type_aliases = g_vyi_type_aliases + "|" + alias + "=" + target;
            }
            let use_line = vyi_emit_use(cur);
            if (use_line.len > 0) {
                appendFile(output_path, use_line);
                emitted_use = true;
                use_count = use_count + 1;
            }
        }
        cur = decl_get_next(cur);
    }
    if (emitted_use) {
        appendFile(output_path, "\n");
    }
    report_phase("vyi", "uses emitted " + policy_i64_to_string(use_count as i64));

    // Public declarations (functions, classes, enums, type aliases, constants, globals)
    cur = unit_get_decls(unit);
    var decl_index: i32 = 0;
    var emit_count: i32 = 0;
    while (cur != null) {
        let dk = decl_get_kind(cur);
        let meta = decl_get_meta(cur);
        let is_pub = driver_decl_exports_world(cur);
        // Skip imported decls
        if (driver_string_contains(meta, "|imported")) {
            cur = decl_get_next(cur);
            decl_index = decl_index + 1;
            continue;
        }
        let is_impl = dk == de_CLASS()
                      && driver_string_contains(decl_get_generic_params(cur), "|kind:impl");
        let export_impl = is_impl && vyi_impl_exports_public_contract(unit, cur);
        if (!project_private && !is_pub && !export_impl) {
            cur = decl_get_next(cur);
            decl_index = decl_index + 1;
            continue;
        }
        var chunk: string = "";
        if (dk == de_FN() || dk == de_EXTERN_FN()) {
            chunk = vyi_emit_function_mode(cur, project_private);
        } else if (dk == de_CLASS()) {
            if (is_impl) { chunk = vyi_emit_impl(cur); }
            else { chunk = vyi_emit_class_mode(cur, project_private); }
        } else if (dk == de_ENUM()) {
            chunk = vyi_emit_enum(cur);
        } else if (dk == de_TYPE_ALIAS()) {
            chunk = vyi_emit_type_alias(cur);
        } else if (dk == de_CONST() || dk == de_GLOBAL_VAR()) {
            chunk = vyi_emit_const_or_var(cur);
        }
        if (chunk.len > 0) {
            appendFile(output_path, chunk);
            emit_count = emit_count + 1;
        }
        cur = decl_get_next(cur);
        decl_index = decl_index + 1;
    }

    report_phase("vyi", "decls emitted " + policy_i64_to_string(emit_count as i64));
    let artifact_rc = template_artifact_append(unit, output_path);
    if (artifact_rc != 0) {
        report_phase("vyi", "template artifact failed: " + template_artifact_last_error());
        return artifact_rc;
    }
    return 0;
}

fn driver_repl() -> i32 {
    let args = driver_repl_forward_args();
    return vyx_bootstrap_repl_run(getArg(0).c_str(), args.c_str());
}

fn cli_reject_removed_compat_options() -> bool {
    let end = cli_runtime_separator_index();
    var i: i32 = 1;
    while (i < end) {
        let a = getArg(i);
        if (a == "--use-new-mir-codegen"
            || a == "--src" || a == "--emit" || a == "--run"
            || a == "--emit-ir" || a == "--emit-obj" || a == "--emit-exe"
            || a == "--emit-dll" || a == "--emit-lib" || a == "--emit-cpp"
            || a == "--emit-dci-stubs" || a == "--jit-run") {
            diag_emit(diag_sev_ERROR(), diag_code_cli_usage(), 0, 0,
                      "unknown option `" + a + "`");
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main() -> i32 {
    driver_disable_windows_error_boxes();
    if (cli_wants_version()) {
        show_version();
        return 0;
    }
    if (cli_wants_help()) {
        show_usage();
        return 0;
    }
    if (cli_reject_removed_compat_options()) { return 1; }
    if (argCount() >= 2 && getArg(1) == "build") {
        return build_system_run();
    }
    if (argCount() >= 2 && getArg(1) == "new") {
        return build_system_new_project();
    }
    if (argCount() >= 2 && getArg(1) == "dci") {
        return build_system_run_dci();
    }
    if (argCount() >= 2 && getArg(1) == "run") {
        return build_system_run_script();
    }
    if (argCount() >= 2 && getArg(1) == "repl") {
        return driver_repl();
    }
    if (argCount() >= 2 && (getArg(1) == "install"
        || getArg(1) == "publish"
        || getArg(1) == "search"
        || getArg(1) == "lock")) {
        return pkg_dispatch();
    }
    if (argCount() >= 2 && getArg(1) == "test") {
        return cli_tools_test_main();
    }
    if (argCount() >= 2 && getArg(1) == "bench") {
        return cli_tools_bench_main();
    }
    if (argCount() >= 2 && getArg(1) == "fmt") {
        return cli_tools_fmt_main();
    }
    if (argCount() >= 2 && getArg(1) == "doc") {
        return cli_tools_doc_main();
    }
    return driver_compile_cli_main();
}

fn driver_mir2cpp_entry() -> i32 {
    driver_disable_windows_error_boxes();
    if (cli_wants_version()) {
        show_version();
        return 0;
    }
    if (cli_wants_help()) {
        show_usage();
        return 0;
    }
    if (cli_reject_removed_compat_options()) { return 1; }
    if (!cli_wants_emit_cpp()) {
        return die("MIR2CPP exported compiler entry only supports `--emit=cpp`");
    }
    return driver_compile_cli_main();
}

fn driver_prepare_codegen_hir_builder(unit: rawptr,
                                      export_roots: bool,
                                      export_method_roots: bool,
                                      export_root_names: string,
                                      export_root_names_specified: bool,
                                      dci_abi_text: string,
                                      dci_abi_path: string,
                                      dci_abi_is_binary: bool) -> rawptr {
    let hbuilder = hir_build_codegen_builder_handle_with_export_roots(unit,
                                                                      export_roots,
                                                                      export_method_roots,
                                                                      export_root_names,
                                                                      export_root_names_specified);
    if (hbuilder == null) {
        diag_emit_codegen("failed to allocate HIR codegen builder");
        return null;
    }
    let prepare_errors = lower_pipeline_prepare_hir(hbuilder,
                                                    dci_abi_text,
                                                    dci_abi_path);
    if (prepare_errors > 0) {
        hir_codegen_builder_handle_release_codegen_state(hbuilder);
        hir_codegen_builder_handle_free(hbuilder);
        return null;
    }
    return hbuilder;
}

// Driver phase wall times, printed under VYX_MIR_TIMING=1.  The frontend
// phases below run before the streaming codegen phase measured by the
// [mir-timing] stream marks; together they partition the whole compile.
var g_driver_timing_on: i32 = -1;
var g_driver_timing_mark: i64 = 0;

fn driver_timing_enabled() -> bool {
    if (g_driver_timing_on < 0) {
        let raw = driver_env_value("VYX_MIR_TIMING").trim();
        if (raw.len > 0 && raw != "0" && raw != "false" && raw != "FALSE") {
            g_driver_timing_on = 1;
        } else {
            g_driver_timing_on = 0;
        }
    }
    return g_driver_timing_on == 1;
}

fn driver_timing_mark(label: string) {
    if (!driver_timing_enabled()) { return; }
    let now = vyx_bootstrap_now_ms();
    print("[driver-timing] " + label + ": " + (now - g_driver_timing_mark).toString() + " ms");
    g_driver_timing_mark = now;
}

// Open-generic DCI instances closed by this compile are recorded beside the
// object it produced.  The build system merges the per-object `.dci_open`
// Union `incoming`'s non-empty lines into `existing`, order-preserving and
// deduplicated by exact line.  Lines are tab-separated records
// (`open\t...`, `instance\t...`, `record\t...`, `layout\t...`), so the
// dedup key is the full newline-delimited line -- a naive substring
// containment would drop `open\tswap__i32` because it is a prefix of
// `open\tswap__i32_f64`.
fn driver_merge_dci_open_sidecar_text(existing: string, incoming: string) -> string {
    var hay = "\n" + existing.clone();
    if (!hay.endsWith("\n")) { hay = hay.clone() + "\n"; }
    var out = existing.clone();
    if (out.len > 0 && !out.endsWith("\n")) { out = out.clone() + "\n"; }
    var start: i32 = 0;
    while (start < incoming.len) {
        var end: i32 = start;
        while (end < incoming.len && incoming.charAt(end) != 10) { end = end + 1; }
        let line = incoming.substring(start, end).trim();
        start = end + 1;
        if (line.len == 0) { continue; }
        if (hay.contains("\n" + line + "\n")) { continue; }
        out = out.clone() + line + "\n";
        hay = hay.clone() + line + "\n";
    }
    return out;
}

// sidecars and hands the requests file to the external Active Adapter backend,
// which materializes each native entrypoint.  The build task convention stages
// some objects at `<obj>.tmp`, and the parent renames them afterwards, so the
// sidecar drops a trailing `.tmp` to land at the final object's name.
//
// The sidecar is written by every lowering of the object -- including the
// re-lowering that succeeds after the build closed the discovered instances.
// That final pass discovers nothing new, but it must not ERASE what an earlier
// closure round discovered: the `instance` lines are the object's standing
// record of the closed instances its call sites force.  The build's request
// union reads them after the last compile, and a later rebuild whose
// supplement was cleaned away re-closes from them.  So the write unions the
// fresh requests with the existing sidecar, line by line; fresh facts append,
// nothing is dropped.
fn driver_write_dci_open_sidecar(final_object_path: string) {
    let dci_open_requests = llvm_lower_take_dci_open_requests();
    // The sidecar is part of a DCI object's cache artifact even when this
    // compile discovered no requests.  Its absence must invalidate the
    // object rather than silently dropping previously closed instances.
    if (dci_open_requests.len == 0 && cli_dci_abi_paths().len == 0) { return; }
    var sidecar_base = final_object_path.clone();
    if (sidecar_base.endsWith(".tmp")) {
        sidecar_base = sidecar_base.substring(0, sidecar_base.len - 4);
    }
    let dci_open_sidecar = sidecar_base + ".dci_open";
    var merged = dci_open_requests.clone();
    if (fileExists(dci_open_sidecar.clone())) {
        merged = driver_merge_dci_open_sidecar_text(
            readFile(dci_open_sidecar.clone()), dci_open_requests.clone());
    }
    if (fileExists(dci_open_sidecar.clone())) { deleteFile(dci_open_sidecar.clone()); }
    writeFile(dci_open_sidecar, merged);
}

fn driver_compile_cli_main() -> i32 {
    driver_disable_windows_error_boxes();
    let profile_level = driver_timing_profile_level();
    var profile_total: i64 = 0;
    var profile_mark: i64 = 0;
    if (profile_level > 0) {
        profile_total = vyx_bootstrap_now_ms();
        profile_mark = profile_total;
    }
    if (driver_timing_enabled()) {
        g_driver_timing_mark = vyx_bootstrap_now_ms();
    }

    // ── 0. CLI ────────────────────────────────────────────────────
    if (cli_wants_version()) {
        show_version();
        return 0;
    }
    if (cli_wants_help()) {
        show_usage();
        return 0;
    }
    let cli_rc = parse_cli_args();
    if (cli_rc > 0) { return cli_rc; }
    if (cli_src_kind() == "project"
        && !driver_validate_project_manifest_templates(cli_src_path())) {
        return 1;
    }
    let input_path = fetch_input_path();
    let output_path = fetch_output_path();
    let want_run = cli_wants_run();
    let want_verify_hir_facts = cli_wants_verify_hir_facts();
    let want_verify_hir2 = cli_wants_verify_hir2();
    let want_dump_hir2 = cli_wants_dump_hir2();
    let want_hir_complete_resolve = cli_wants_hir_complete_resolve();
    let want_verify_mir2 = cli_wants_verify_mir2();
    let want_dump_mir2 = cli_wants_dump_mir2();
    let want_emit_cpp = cli_wants_emit_cpp();
    let want_emit_dci_stubs = cli_wants_emit_dci_stubs();
    var dci_abi_path = cli_dci_abi_paths();
    // Keep source-discovered contracts distinct from an explicit command-line
    // contract.  Discovery is performed before Sema so the DCI obligation
    // graph can join the live EffectPlan; authorization is still checked after
    // Sema and an unmarked source request cannot reach lowering.
    var dci_abi_from_effect_attr: bool = false;
    var dci_abi_text: string = "";
    var dci_abi_is_binary: bool = false;
    var opt_level = cli_opt_level();
    var opt_flag = cli_opt_flag();
    if (!cli_has_explicit_opt_flag()) {
        opt_level = 0;
        opt_flag = "-O0";
    }
    let mir_opt_level = cli_mir_opt_level(opt_level);
    let llvm_opt_level = cli_llvm_opt_level(opt_level);
    diag_set_error_limit(cli_max_errors());
    report_phase("config", "input=" + input_path);
    report_phase("config", "output=" + output_path);

    // ── 1. Read source ─────────────────────────────────────────────
    diag_set_current_file(input_path);
    let source = readFile(input_path);
    if (source.len == 0 && !fileExists(input_path)) {
        return die("failed to read source file `" + input_path + "`");
    }
    effect_plan_set_source_stamp(source.clone());
    let effect_schema_text = driver_effect_schema_text(input_path.clone());
    if (effect_schema_text.startsWith("|ERR|")) {
        return die_schema("Effect attribute schema rejected: " + effect_schema_text.substring(5, effect_schema_text.len));
    }
    if (effect_schema_text.len > 0
        && !effect_attribute_schema_text_valid(effect_schema_text.clone())) {
        return die_schema("Effect schema table rejected: malformed or unsupported schema");
    }
    effect_plan_set_schema_text(effect_schema_text.clone());
    if (effect_schema_text.len > 0) {
        report_phase("effect-schemas", "loaded package schemas");
    }
    if (dci_abi_path.len == 0) {
        dci_abi_path = build_dci_import_for_group(input_path.clone());
        dci_abi_from_effect_attr = dci_abi_path.len > 0;
    }
    effect_plan_set_dci_paths(dci_abi_path.clone());
    // An incoming Effect manifest is an explicit cross-module contract.  Do
    // not consume it without a caller-provided target/ABI/scope and source
    // stamps; otherwise stale metadata could silently authorize lowering.
    let effect_manifest_in = driver_env_value("VYX_EFFECT_MANIFEST_IN");
    if (effect_manifest_in.len > 0) {
        if (!fileExists(effect_manifest_in)) {
            return die("Effect manifest not found `" + effect_manifest_in + "`");
        }
        let manifest_text = readFile(effect_manifest_in);
        let expected_source = driver_env_value("VYX_EFFECT_SOURCE_STAMP");
        let expected_compiler = driver_env_value("VYX_EFFECT_COMPILER_STAMP");
        if (expected_source.len == 0 || expected_compiler.len == 0) {
            return die("VYX_EFFECT_SOURCE_STAMP and VYX_EFFECT_COMPILER_STAMP are required with VYX_EFFECT_MANIFEST_IN");
        }
        var expected_target = driver_env_value("VYX_EFFECT_TARGET");
        if (expected_target.len == 0) { expected_target = "vyx"; }
        var expected_abi = driver_env_value("VYX_EFFECT_ABI");
        if (expected_abi.len == 0) { expected_abi = "vyx.aot.v1"; }
        var expected_scope = driver_env_value("VYX_EFFECT_SCOPE");
        if (expected_scope.len == 0) { expected_scope = "unit"; }
        let manifest_status = effect_manifest_validate_text(
            manifest_text,
            expected_target,
            expected_abi,
            expected_scope,
            expected_source,
            expected_compiler);
        if (manifest_status != 0) {
            return die("Effect manifest rejected: " + effect_manifest_status_text(manifest_status));
        }
        // A package schema is a semantic input, not merely a local cache
        // path.  Compiler-produced manifests carry its content digest; when
        // present, require the consumer's validated schema table to match.
        // Older DCI-only bridge envelopes may omit this optional dependency
        // because they contain no package attribute handlers.
        let incoming_schema_stamp = effect_manifest_dependency_digest_text(
            manifest_text, "schema");
        if (incoming_schema_stamp.len > 0
            && incoming_schema_stamp != effect_plan_schema_stamp()) {
            return die("Effect manifest rejected: schema-stale");
        }
        effect_plan_set_incoming_manifest(manifest_text);
        report_phase("effect-manifest", "accepted " + effect_manifest_in);
    }
    // Plumb the current TU path into the diag engine so every
    // `Diag.emit_at` renders `<file>:<line>:<col>:` with the user-typed
    // input path. Mirrors `vyx::DiagnosticsEngine::setSource` + the
    // `SourceLocation.filename` pool, just split: file lives in diag,
    // source bytes are only needed for the future snippet renderer.
    diag_set_current_source(source);
    report_phase("read", policy_i64_to_string(source.len as i64) + " bytes");
    profile_mark = driver_profile_mark(profile_level, "read", profile_mark);

    // ── 2. Lex ────────────────────────────────────────────────────
    let lx_handle = lex_source(source);
    if (lx_handle == null) {
        return die("lexer failed to return a token stream");
    }
    let tok_count = lex_token_count(lx_handle);
    let err_count = lex_error_count(lx_handle);
    report_phase("lex", policy_i64_to_string(tok_count as i64) + " tokens, "
                 + policy_i64_to_string(err_count as i64) + " errors");
    if (cli_wants_dump_tokens()) {
        dump_tokens_host_lines(lx_handle, input_path);
    }
    if (err_count > 0) {
        lexer_dispose(lx_handle);
        return 1;
    }
    profile_mark = driver_profile_mark(profile_level, "lex", profile_mark);

    // ── 3. Parse ──────────────────────────────────────────────────
    let unit = parse_unit(lx_handle);
    lexer_dispose(lx_handle);
    if (unit == null) {
        if (diag_error_count() > 0) { return 1; }
        return die("parser failed to return a translation unit");
    }
    driver_mark_unit_source_path(unit, input_path);
    parser_auto_qualify_imported_module_types(unit);
    report_phase("parse", policy_i64_to_string(unit_get_decl_count(unit) as i64) + " top-level decls");
    let unit_source_total = driver_unit_source_total(input_path.clone());
    if (unit_source_total > 1) {
        driver_unit_progress_emit(1, unit_source_total, input_path.clone());
    }
    if (cli_wants_stop_after_parse()) {
        return 0;
    }
    profile_mark = driver_profile_mark(profile_level, "parse", profile_mark);
    // Mark the entry file's own declarations before any sibling is appended:
    // the unit still holds exactly this file's decls, so the promise stays
    // scoped to the file the producer either decorated or did not.
    if (driver_vyi_decorated_contains(input_path.clone())) {
        driver_mark_vyi_source_chain(unit_get_decls(unit));
    }
    if (driver_load_local_unit_sources(unit, input_path.clone()) != 0) {
        return die("failed to load local unit sources");
    }
    driver_timing_mark("frontend parse+load");
    if (cli_wants_vyi() && cli_wants_vyi_shallow()) {
        driver_ensure_parent_dir(output_path);
        let shallow_vyi_rc = emit_vyi_file(unit, output_path);
        if (shallow_vyi_rc != 0) {
            return die("shallow interface emission failed with exit code "
                       + policy_i64_to_string(shallow_vyi_rc as i64));
        }
        let shallow_vyi_size = fileSize(output_path);
        report_phase("emit", output_path + " (" + policy_i64_to_string(shallow_vyi_size) + " bytes, shallow)");
        driver_profile_mark(profile_level, "total", profile_total);
        report_phase("pipeline", "OK");
        return 0;
    }
    let registry = driver_module_registry(input_path.clone());
    if (diag_error_count() > 0) { return 1; }
    driver_timing_mark("frontend registry");
    if (profile_level > 0) {
        driver_make_dir(".cache");
        writeFile(".cache/module_registry.dump", registry.clone());
    }
    let pending_imports = driver_count_use_decls(unit);
    parser_auto_qualify_std_modules(unit);
    let auto_link_args = driver_std_auto_link_args(unit, input_path.clone());
    report_phase("imports", policy_i64_to_string(pending_imports as i64) + " pending use(s)");
    profile_mark = driver_profile_mark(profile_level, "imports", profile_mark);

    // ── 4. Sema ───────────────────────────────────────────────────
    var prepare_imported_hir_facts = !cli_wants_export_all();
    // Explicit projects already load their complete .vyx_unit_sources closure.
    // Re-preparing imported facts duplicates most of the self-host compiler
    // graph and makes monolithic LLVM IR export substantially slower.
    if ((cli_src_kind() == "project" || driver_wants_project_unit_sources())
        && !cli_wants_export_all()) {
        prepare_imported_hir_facts = false;
    }
    // A peer-interface unit is the same compilation boundary as an explicit
    // interface root: its imported declarations are contracts, not bodies to
    // eagerly type-check for every object partition.
    if ((cli_has_interface_root() || driver_wants_interface_unit_sources())
        && !cli_wants_export_all()) {
        prepare_imported_hir_facts = false;
    }
    if (cli_has_emit_root_names() && !cli_wants_export_all()) {
        prepare_imported_hir_facts = false;
    }
    var hir_fact_root_names = "";
    if (cli_has_emit_root_names()) {
        hir_fact_root_names = cli_emit_root_names();
    } else if (cli_has_export_root_names() && driver_wants_interface_unit_sources()) {
        // A peer-interface partition has an explicit object root set and its
        // sibling declarations are interface contracts.  Reuse the roots for
        // eager facts there; ordinary project-unit builds retain full local
        // semantic preparation so return inference remains available to
        // reachable non-exported helpers and foreign declarations.
        hir_fact_root_names = cli_export_root_names();
    }
    let sema_state = analyze_unit_with_registry_options_codegen_roots(unit,
                                                                      registry.clone(),
                                                                      true,
                                                                      true,
                                                                      prepare_imported_hir_facts,
                                                                      hir_fact_root_names);
    if (sema_state == null) {
        return die("semantic analysis failed to create analysis state");
    }
    profile_mark = driver_profile_mark(profile_level, "sema-prep", profile_mark);
    driver_timing_mark("frontend sema-prep");
    if (driver_timing_enabled()) {
        print("[sema-phase-sums] " + sema_phase_sums_text());
        sema_phase_sums_reset();
    }
    let s_errs = check_program(sema_state, unit);
    profile_mark = driver_profile_mark(profile_level, "sema-check", profile_mark);
    if (s_errs == 0) {
        let effect_manifest_out = driver_env_value("VYX_EFFECT_MANIFEST_OUT");
        if (effect_manifest_out.len > 0) {
            let manifest_text = effect_plan_last_manifest();
            if (manifest_text.len == 0) {
                sema_dispose(sema_state);
                return die("Effect manifest export requested but no sealed plan was published");
            }
            driver_ensure_parent_dir(effect_manifest_out);
            writeFile(effect_manifest_out, manifest_text);
            report_phase("effect-manifest", effect_manifest_out);
        }
        let dci_export_out = driver_env_value("VYX_DCI_EXPORT_OUT");
        if (dci_export_out.len > 0) {
            let export_text = effect_plan_last_dci_export();
            if (export_text.len == 0) {
                sema_dispose(sema_state);
                return die("DCI export sidecar requested but no sealed dci_export Effect was published");
            }
            driver_ensure_parent_dir(dci_export_out);
            writeFile(dci_export_out, export_text);
            report_phase("dci-export", dci_export_out);
        }
    }
    driver_timing_mark("frontend sema-check");
    sema_dispose(sema_state);
    if (s_errs > 0) {
        report_phase("sema",
                     policy_i64_to_string(s_errs as i64) + " errors"
                     + " (diag uniq=" + policy_i64_to_string(diag_unique_count() as i64)
                     + " dup=" + policy_i64_to_string(diag_dup_drops() as i64) + ")");
        return 1;
    }
    // The build scanner is only a path discovery aid.  Do not even resolve
    // or read a source-declared contract until Sema has accepted the
    // registered dci_import Effect and stamped the compiler-owned marker.
    if (dci_abi_path.len == 0) {
        dci_abi_path = build_dci_import_for_group(input_path.clone());
        dci_abi_from_effect_attr = dci_abi_path.len > 0;
    }
    if ((dci_abi_from_effect_attr || effect_unit_declares_dci_import(unit))
        && !effect_unit_has_authorized_dci(unit)) {
        // A project build may have forwarded a discovered source path as
        // `--dci` before this driver sees the unit.  The exact raw attribute
        // query keeps that path subject to the same compiler-owned marker
        // check while explicit descriptors for inline/direct contracts remain
        // compatible when no source request is present.
        return die("DCI contract path was discovered from source but no authorized dci_import Effect was sealed");
    }
    if (dci_abi_path.len > 0) {
        var dci_i: i32 = 0;
        let dci_n = dci_path_list_count(dci_abi_path.clone());
        var all_dcib = true;
        while (dci_i < dci_n) {
            let one = dci_path_list_at(dci_abi_path.clone(), dci_i);
            if (!fileExists(one.clone())) {
                return die("DCI ABI file not found `" + one + "`");
            }
            if (!dci_path_is_dcib(one.clone())) { all_dcib = false; }
            dci_i = dci_i + 1;
        }
        dci_abi_is_binary = all_dcib;
        if (dci_n == 1 && !dci_abi_is_binary) {
            dci_abi_text = readFile(dci_path_list_at(dci_abi_path.clone(), 0));
        }
    }
    report_phase("sema",
                 "0 errors"
                 + " (diag uniq=" + policy_i64_to_string(diag_unique_count() as i64)
                 + " warn=" + policy_i64_to_string(diag_warning_count() as i64)
                 + " dup=" + policy_i64_to_string(diag_dup_drops() as i64) + ")");
    if (want_verify_hir_facts || want_verify_hir2 || want_dump_hir2 || want_hir_complete_resolve
        || want_verify_mir2 || want_dump_mir2 || want_emit_cpp || want_emit_dci_stubs) {
        let hir_fact_errors = hir_verify_semantic_facts(unit);
        if (hir_fact_errors > 0) {
            report_phase("hir-facts",
                         policy_i64_to_string(hir_fact_errors as i64) + " errors");
            return 1;
        }
        report_phase("hir-facts", "OK");
        profile_mark = driver_profile_mark(profile_level, "hir-facts", profile_mark);
        if (want_verify_hir2 || want_dump_hir2 || want_hir_complete_resolve
            || want_verify_mir2 || want_dump_mir2 || want_emit_cpp || want_emit_dci_stubs) {
            var hir_export_roots = cli_wants_export_all();
            var hir_export_method_roots = cli_wants_export_all() || cli_wants_export_method_roots();
            var hir_export_root_names = cli_export_root_names();
            var hir_export_root_names_specified = cli_has_export_root_names();
            // Keep HIR construction identical to the LLVM entry path.  An
            // implicit project emit root (normally `main`) partitions MIR
            // output only; it must not be presented to HirUnitBuilder as an
            // HIR export-root request.  The latter intentionally treats
            // imported modules as declaration-only outside an explicit export
            // set, which is correct for interface/object partitions but would
            // make the self-host compiler's reachable implementation methods
            // disappear from MIR2CPP.  StreamBuilder below owns the effective
            // emit-root partition for both backends.
            let hbuilder = hir_build_codegen_builder_handle_with_export_roots(unit,
                                                                              hir_export_roots,
                                                                              hir_export_method_roots,
                                                                              hir_export_root_names,
                                                                              hir_export_root_names_specified);
            if (hbuilder == null) {
                diag_emit_codegen("HIR codegen builder allocation failed");
                return 1;
            }
            var hunit = hir_codegen_builder_handle_unit(hbuilder);
            profile_mark = driver_profile_mark(profile_level, "hir-build", profile_mark);
            driver_timing_mark("frontend hir-build");
            let resolve_left = hir_semantic_resolve_unit(hunit);
            hir_codegen_builder_handle_set_unit(hbuilder, hunit);
            profile_mark = driver_profile_mark(profile_level, "hir-resolve", profile_mark);
            driver_timing_mark("frontend hir-resolve");
            report_phase("hir-resolve",
                         policy_i64_to_string(resolve_left as i64) + " unresolved");
            if (resolve_left > 0) {
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                return 1;
            }
            var lifecycle_errors: i32 = 0;
            if (dci_path_list_count(dci_abi_path.clone()) > 0) {
                lifecycle_errors = hir_bind_dci_lifecycle_paths(hunit, dci_abi_path.clone());
            } else if (dci_abi_text.len > 0) {
                lifecycle_errors = hir_bind_dci_lifecycle_contract(hunit, dci_abi_text.clone());
            }
            hir_codegen_builder_handle_set_unit(hbuilder, hunit);
            profile_mark = driver_profile_mark(profile_level, "dci-lifecycle", profile_mark);
            report_phase("dci-lifecycle",
                         policy_i64_to_string(lifecycle_errors as i64) + " errors");
            if (lifecycle_errors > 0) {
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                return 1;
            }
            let ownership_errors = hir_ownership_resolve_unit(hunit);
            profile_mark = driver_profile_mark(profile_level, "hir-ownership", profile_mark);
            hir_codegen_builder_handle_set_unit(hbuilder, hunit);
            report_phase("hir-ownership",
                         policy_i64_to_string(ownership_errors as i64) + " errors");
            if (ownership_errors > 0) {
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                return 1;
            }
            let hir2_errors = hir_verify_unit(hunit);
            profile_mark = driver_profile_mark(profile_level, "hir2-verify", profile_mark);
            driver_timing_mark("frontend hir-finalize");
            hir_codegen_builder_handle_set_unit(hbuilder, hunit);
            if (hir2_errors > 0) {
                if (want_dump_hir2) {
                    hir_dump_unit(hunit);
                }
                report_phase("hir2",
                             policy_i64_to_string(hir2_errors as i64) + " errors");
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                return 1;
            }
            report_phase("hir2", "OK");
            if (want_dump_hir2) {
                hir_dump_unit(hunit);
            }
            // MIR2CPP deliberately consumes the same transient MIR stream as
            // LLVM.  Do this before the retained-MIR diagnostics path: once a
            // body has been rendered it is released, so running the old
            // whole-unit verifier/optimizer here would be both incorrect and
            // would recreate the multi-gigabyte eager MIR graph.
            if (want_emit_cpp) {
                hir_codegen_builder_handle_set_unit(hbuilder, hunit);
                var stream_builder = MirUnitBuilder.create_for_codegen(hbuilder);
                // Keep root partitioning precisely aligned with the LLVM
                // entry point.  An explicitly selected emit root therefore
                // has the same reachability and declaration-only surface in
                // --emit=cpp and in the native LLVM backend.
                stream_builder.partition_codegen_roots = cli_effective_emit_root_names_specified();
                stream_builder.emit_root_names = cli_effective_emit_root_names();
                stream_builder.emit_root_names_specified = cli_effective_emit_root_names_specified();
                if (dci_abi_text.len > 0 || dci_abi_path.len > 0) {
                    stream_builder.unit.set_dci_abi_source(
                                                dci_abi_text.clone(),
                                                dci_abi_path.clone(),
                                                dci_abi_is_binary);
                }
                let cpp_diag_before = diag_error_count();
                let cpp_rc = mir_cpp_emit_cmake_project_streaming_from_builder(
                    &mut stream_builder,
                    output_path,
                    driver_path_stem(input_path),
                    mir_opt_level,
                    cli_wants_mir_verify_strict());
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                if (cpp_rc != 0) {
                    if (diag_error_count() == cpp_diag_before) {
                        diag_emit_codegen_at(
                            mir_unit_diag_first_loc(&stream_builder.unit),
                            "streaming MIR2 C++ project emission failed with exit code "
                            + policy_i64_to_string(cpp_rc as i64));
                    }
                    return 1;
                }
                report_phase("mir2", "streamed OK");
                report_phase("mir-opt", opt_flag + " streamed OK");
                if (cli_src_kind() == "project") {
                    let project_cpp_rc = driver_project_configure_cpp_output(cli_src_path(), output_path);
                    if (project_cpp_rc != 0) { return project_cpp_rc; }
                } else {
                    let file_cpp_rc = driver_file_configure_cpp_output(input_path, output_path);
                    if (file_cpp_rc != 0) { return file_cpp_rc; }
                }
                report_phase("cpp", output_path);
                profile_mark = driver_profile_mark(profile_level, "emit_cpp", profile_mark);
                driver_profile_mark(profile_level, "total", profile_total);
                report_phase("pipeline", "OK");
                return 0;
            }
            if (want_dump_mir2 || want_emit_dci_stubs) {
                hir_codegen_builder_handle_set_unit(hbuilder, hunit);
                var munit = mir_build_from_hir_codegen_builder_handle_with_emit_roots_and_dci(hbuilder,
                                                                                              cli_effective_emit_root_names(),
                                                                                              cli_effective_emit_root_names_specified(),
                                                                                              dci_abi_text.clone());
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                if (dci_abi_path.len > 0) {
                    munit.set_dci_abi_source(
                                                dci_abi_text.clone(),
                                                dci_abi_path.clone(),
                                                dci_abi_is_binary);
                }
                let mir_verify_strict = cli_wants_mir_verify_strict();
                var mir2_errors: i32 = 0;
                if (mir_verify_strict) {
                    mir2_errors = mir_verify_unit_strict(munit);
                } else {
                    mir2_errors = mir_verify_unit(munit);
                }
                if (mir2_errors > 0) {
                    report_phase("mir2",
                                 policy_i64_to_string(mir2_errors as i64) + " errors");
                    return 1;
                }
                report_phase("mir2", "OK");
                var mir_opt_unit = munit;
                let mir_opt_errors = mir_run_unit_pass_pipeline(&mut mir_opt_unit,
                                                                 mir_opt_level,
                                                                 mir_verify_strict);
                munit = mir_opt_unit;
                if (mir_opt_errors > 0) {
                    report_phase("mir-opt",
                                 policy_i64_to_string(mir_opt_errors as i64) + " errors");
                    return 1;
                }
                var mir_post_errors: i32 = 0;
                if (mir_verify_strict) {
                    mir_post_errors = mir_verify_unit_strict(munit);
                } else {
                    mir_post_errors = mir_verify_unit(munit);
                }
                if (mir_post_errors > 0) {
                    report_phase("mir-opt-verify",
                                 policy_i64_to_string(mir_post_errors as i64) + " errors");
                    return 1;
                }
                report_phase("mir-opt", opt_flag + " OK");
                if (want_dump_mir2) {
                    mir_analysis_audit_local_storage_escape_facts(munit);
                    mir_dump_unit(munit);
                }
                if (want_emit_dci_stubs) {
                    driver_ensure_parent_dir(output_path);
                    let dci_stub_diag_before = diag_error_count();
                    let dci_stub_rc = mir_cpp_emit_dci_stub_source_file(munit, output_path);
                    if (dci_stub_rc != 0) {
                        if (diag_error_count() == dci_stub_diag_before) {
                            diag_emit_codegen_at(
                                mir_unit_diag_first_loc(&munit),
                                "DCI stub source emission failed with exit code "
                                + policy_i64_to_string(dci_stub_rc as i64));
                        }
                        return 1;
                    }
                    report_phase("dci-stubs", output_path);
                    profile_mark = driver_profile_mark(profile_level, "emit_dci_stubs", profile_mark);
                    driver_profile_mark(profile_level, "total", profile_total);
                    report_phase("pipeline", "OK");
                    return 0;
                }
            } else if (want_verify_mir2) {
                hir_codegen_builder_handle_set_unit(hbuilder, hunit);
                var stream_builder = MirUnitBuilder.create_for_codegen(hbuilder);
                stream_builder.partition_codegen_roots = cli_effective_emit_root_names_specified();
                stream_builder.emit_root_names = cli_effective_emit_root_names();
                stream_builder.emit_root_names_specified = cli_effective_emit_root_names_specified();
                if (dci_abi_text.len > 0 || dci_abi_path.len > 0) {
                    stream_builder.unit.set_dci_abi_source(
                                                dci_abi_text.clone(),
                                                dci_abi_path.clone(),
                                                dci_abi_is_binary);
                }
                let mir_verify_strict = cli_wants_mir_verify_strict();
                let stream_errors = stream_builder.stream_verify_reachable(mir_opt_level,
                                                                              mir_verify_strict);
                if (stream_errors > 0) {
                    report_phase("mir2",
                                 policy_i64_to_string(stream_errors as i64) + " errors");
                    stream_builder.release_build_state();
                    hir_codegen_builder_handle_release_codegen_state(hbuilder);
                    hir_codegen_builder_handle_free(hbuilder);
                    return 1;
                }
                var mir2_errors: i32 = 0;
                if (mir_verify_strict) {
                    mir2_errors = mir_verify_unit_strict(stream_builder.unit);
                } else {
                    mir2_errors = mir_verify_unit(stream_builder.unit);
                }
                stream_builder.release_build_state();
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
                if (mir2_errors > 0) {
                    report_phase("mir2",
                                 policy_i64_to_string(mir2_errors as i64) + " errors");
                    return 1;
                }
                report_phase("mir2", "streamed OK");
                report_phase("mir-opt", opt_flag + " streamed OK");
            } else {
                hir_codegen_builder_handle_release_codegen_state(hbuilder);
                hir_codegen_builder_handle_free(hbuilder);
            }
        }
        return 0;
    }
    if (cli_wants_stop_after_sema()) {
        return 0;
    }
    profile_mark = driver_profile_mark(profile_level, "sema", profile_mark);

    // ── 4.5. Emit .vyi interface file (if requested) ──────────────
    if (cli_wants_vyi()) {
        driver_ensure_parent_dir(output_path);
        let vyi_rc = emit_vyi_file(unit, output_path);
        if (vyi_rc != 0) {
            return die("interface emission failed with exit code "
                       + policy_i64_to_string(vyi_rc as i64));
        }
        let vyi_size = fileSize(output_path);
        report_phase("emit", output_path + " (" + policy_i64_to_string(vyi_size) + " bytes)");
        profile_mark = driver_profile_mark(profile_level, "emit_vyi", profile_mark);
        driver_profile_mark(profile_level, "total", profile_total);
        report_phase("pipeline", "OK");
        return 0;
    }

    // ── 5. Codegen ────────────────────────────────────────────────
    let hir_fact_errors2 = hir_verify_semantic_facts(unit);
    if (hir_fact_errors2 > 0) {
        report_phase("hir-facts",
                     policy_i64_to_string(hir_fact_errors2 as i64) + " errors");
        return 1;
    }
    report_phase("hir-facts", "OK");
    driver_timing_mark("frontend sema-facts");
    let export_roots = cli_wants_export_all()
                       || cli_wants_export_top_level_roots()
                       || cli_has_export_root_names();
    let export_method_roots = cli_wants_export_all() || cli_wants_export_method_roots();
    let hbuilder_for_codegen = driver_prepare_codegen_hir_builder(unit,
                                                                  export_roots,
                                                                  export_method_roots,
                                                                  cli_export_root_names(),
                                                                  cli_has_export_root_names(),
                                                                  dci_abi_text.clone(),
                                                                  dci_abi_path.clone(),
                                                                  dci_abi_is_binary);
    profile_mark = driver_profile_mark(profile_level, "hir_codegen_prepare", profile_mark);
    driver_timing_mark("frontend codegen-prep");
    if (hbuilder_for_codegen == null) {
        if (diag_error_count() > 0) { return 1; }
        diag_emit_codegen("code generation failed to prepare HIR");
        return 1;
    }
    // The CGU split writes its per-unit objects during codegen, long before the
    // driver reaches its own emit step, so the object path has to be published
    // here rather than at the emit call.  Otherwise `llvm_mir_cli_output_path()`
    // is empty for a driver-owned output (`--run`/`--emit` with no `-o`), every
    // unit but the last is discarded, and the link fails on `main` and on
    // monomorphised method bodies.
    //
    // Drop the object's CGU family first.  `driver_link_object_paths` links
    // whatever `<obj>.cgu.list` names, and that file -- along with the
    // `.cgu.N` siblings -- survives a failed build.  A later compile that
    // produces a different number of units then links the stale per-unit
    // objects alongside the fresh primary one and every symbol in both is
    // reported as duplicate (`defined at <obj>` / `defined at <obj>.cgu.N`).
    // Both candidate paths are cleared: which one the split writes to is only
    // known here, and a stale family under either name is equally fatal.
    driver_delete_object_family(output_path.clone());
    driver_delete_object_family(output_path.clone() + ".tmp.obj");
    if (cli_wants_obj()) {
        llvm_mir_publish_primary_object_path(output_path.clone());
    } else {
        llvm_mir_publish_primary_object_path(output_path.clone() + ".tmp.obj");
    }
    var cg = emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots_and_opt_level(hbuilder_for_codegen,
                                                                                        driver_path_stem(input_path),
                                                                                        export_roots,
                                                                                        cli_effective_emit_root_names(),
                                                                                        cli_effective_emit_root_names_specified(),
                                                                                        dci_abi_text.clone(),
                                                                                        dci_abi_path.clone(),
                                                                                        dci_abi_is_binary,
                                                                                        mir_opt_level,
                                                                                        cli_wants_mir_verify_strict());
    profile_mark = driver_profile_mark(profile_level, "mir_codegen_emit", profile_mark);
    hir_codegen_builder_handle_release_codegen_state(hbuilder_for_codegen);
    hir_codegen_builder_handle_free(hbuilder_for_codegen);
    profile_mark = driver_profile_mark(profile_level, "hir_codegen_release", profile_mark);
    profile_mark = driver_profile_mark(profile_level, "codegen", profile_mark);
    if (cg == null) {
        // Lowering failed.  Flush the requests sidecar *before* bailing out:
        // a pass run to discover the closed trait instances a Vyx class inherits
        // from fails right here (the contract does not carry their vtables
        // yet), and the discovery is worthless unless the requests survive it.
        driver_write_dci_open_sidecar(output_path.clone());
        if (diag_error_count() > 0) { return 1; }
        diag_emit_codegen("code generation failed to produce a module");
        return 1;
    }
    if (cli_wants_jit_run()) {
        let run_rc = jit_run_main(cg, llvm_opt_level, cli_link_args(auto_link_args.clone()));
        codegen_dispose(cg);
        profile_mark = driver_profile_mark(profile_level, "jit", profile_mark);
        driver_profile_mark(profile_level, "total", profile_total);
        return run_rc;
    }
    if (cli_wants_ir()) {
        driver_ensure_parent_dir(output_path);
        if (llvm_opt_level > 0) {
            let optimize_rc = optimize_unit(cg, llvm_opt_level);
            if (optimize_rc != 0) {
                codegen_dispose(cg);
                return 1;
            }
        }
        let rc = emit_to_file(cg, output_path);
        if (rc != 0) {
            codegen_dispose(cg);
            return 1;
        }
        let ll_size = fileSize(output_path);
        report_phase("emit", output_path + " (" + policy_i64_to_string(ll_size) + " bytes)");
        codegen_dispose(cg);
        profile_mark = driver_profile_mark(profile_level, "emit_ir", profile_mark);
        driver_profile_mark(profile_level, "total", profile_total);
        report_phase("pipeline", "OK");
        return 0;
    }
    if (cli_wants_obj()) {
        driver_ensure_parent_dir(output_path);
        let obj_rc = emit_object_to_file(cg, output_path, llvm_opt_level);
        codegen_dispose(cg);
        // Write the requests sidecar even when the object did not come out.
        // A pass run to *discover* the closed trait instances it inherits from
        // fails right here by design (the contract does not carry their vtables
        // yet), and the discovery is worthless unless the requests survive it.
        driver_write_dci_open_sidecar(output_path.clone());
        if (obj_rc != 0) {
            return 1;
        }
        let obj_size = fileSize(output_path);
        report_phase("object", output_path + " (" + policy_i64_to_string(obj_size) + " bytes)");
        profile_mark = driver_profile_mark(profile_level, "emit_obj", profile_mark);
        driver_profile_mark(profile_level, "total", profile_total);
        report_phase("pipeline", "OK");
        return 0;
    }

    driver_ensure_parent_dir(output_path);
    let obj_path = output_path + ".tmp.obj";
    let obj_rc2 = emit_object_to_file(cg, obj_path, llvm_opt_level);
    codegen_dispose(cg);
    // Same reasoning as the `--emit=obj` branch above: discovery must outlive
    // a failing lowering pass.
    driver_write_dci_open_sidecar(obj_path.clone());
    if (obj_rc2 != 0) {
        return 1;
    }
    report_phase("object", obj_path + " (" + policy_i64_to_string(fileSize(obj_path)) + " bytes)");
    profile_mark = driver_profile_mark(profile_level, "emit_obj", profile_mark);

    var link_rc: i32 = 0;
    if (cli_wants_lib()) {
        link_rc = link_to_static_lib(obj_path, output_path);
        if (link_rc != 0) {
            return die("archive step failed with exit code "
                       + policy_i64_to_string(link_rc as i64));
        }
        report_phase("archive", output_path + " (" + policy_i64_to_string(fileSize(output_path)) + " bytes)");
    } else if (cli_wants_dll()) {
        let exports = driver_collect_dll_exports(unit);
        link_rc = link_to_dll(obj_path, output_path, opt_flag, exports, auto_link_args.clone());
        if (link_rc != 0) {
            return die("shared library link failed with exit code "
                       + policy_i64_to_string(link_rc as i64));
        }
        driver_copy_runtime_dll(output_path);
        report_phase("link", output_path + " (" + policy_i64_to_string(fileSize(output_path)) + " bytes)");
    } else {
        link_rc = link_to_exe(obj_path, output_path, opt_flag, auto_link_args.clone());
        if (link_rc != 0) {
            return die("executable link failed with exit code "
                       + policy_i64_to_string(link_rc as i64));
        }
        driver_copy_runtime_dll(output_path);
        report_phase("link", output_path + " (" + policy_i64_to_string(fileSize(output_path)) + " bytes)");
    }
    profile_mark = driver_profile_mark(profile_level, "link", profile_mark);

    if (want_run) {
        let run_rc = run_output(output_path);
        if (!cli_wants_keep_obj()) {
            driver_delete_object_family(obj_path);
        }
        deleteFile(output_path);
        return run_rc;
    }

    if (!cli_wants_keep_obj()) {
        driver_delete_object_family(obj_path);
    }

    // ── 6. Cleanup ────────────────────────────────────────────────
    driver_profile_mark(profile_level, "total", profile_total);
    report_phase("pipeline", "OK");
    return 0;
}
