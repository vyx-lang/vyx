        if (getArg(i) == "--") { return i; }
        i = i + 1;
    }
    return argc;
}

fn cli_emit_mode() -> i32 {
    // Mirrors baseline main.cpp EmitMode:
    // 0 IR, 1 Object, 2 Executable, 3 Run, 4 DLL, 5 StaticLib,
    // 6 VYI interface, 7 in-process LLVM JIT run, 8 MIR2 C++ CMake project,
    // 9 DCI Clang Stub C++ source.
    var mode: i32 = 2;
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let a = getArg(i);
        if (a == "--") { break; }
        if (a.startsWith("--emit=") && a.len > 7) {
            let kind = a.substring(7, a.len);
            if (kind == "ir") { mode = 0; }
            if (kind == "obj") { mode = 1; }
            if (kind == "exe") { mode = 2; }
            if (kind == "dll") { mode = 4; }
            if (kind == "lib") { mode = 5; }
            if (kind == "vyi") { mode = 6; }
            if (kind == "cpp") { mode = 8; }
            if (kind == "dci-stubs") { mode = 9; }
            i = i + 1;
            continue;
        }
        if (a.startsWith("--run=") && a.len > 6) {
            let run_kind = a.substring(6, a.len);
            if (run_kind == "aot") { mode = 3; }
            if (run_kind == "jit") { mode = 7; }
        }
        i = i + 1;
    }
    return mode;
}

fn cli_wants_ir() -> bool {
    return cli_emit_mode() == 0;
}

fn cli_wants_run() -> bool {
    return cli_emit_mode() == 3;
}

fn cli_wants_exe() -> bool {
    return cli_emit_mode() == 2;
}

fn cli_wants_obj() -> bool {
    return cli_emit_mode() == 1;
}

fn cli_wants_vyi() -> bool {
