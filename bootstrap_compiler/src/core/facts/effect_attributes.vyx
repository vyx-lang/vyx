module bootstrap.effect_attributes;

use std.string;

// Package-owned Effect schemas are data.  This module parses a closed schema
// language and typed literal arguments; it does not evaluate Vyx, load a
// library, access the environment, or invoke a callback.
//
// MOSP-EFFECT-SCHEMAS\t1\n
// S\tpackage.attribute\tversion\ttargets\tparams\tconsequence\n
// params = key:type[:default] separated by semicolons.
// types use Vyx primitive domains. `int` is retained only for legacy tables.

fn ea_space(c: i32) -> bool { return c == 32 || c == 9; }

fn ea_same(a: string, b: string) -> bool {
    if (a.len != b.len) { return false; }
    var i: i32 = 0;
    while (i < a.len) {
        if (a.charAt(i) != b.charAt(i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn ea_identifier(value: string) -> bool {
    if (value.len == 0) { return false; }
    var i: i32 = 0;
    while (i < value.len) {
        let c = value.charAt(i);
        let letter = c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if (!letter && !(i > 0 && c >= 48 && c <= 57)) { return false; }
        i = i + 1;
    }
    return true;
}

fn ea_plain_count(text: string, sep: i32) -> i32 {
    var count: i32 = 1;
    var i: i32 = 0;
    while (i < text.len) {
        if (text.charAt(i) == sep) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn ea_plain_part(text: string, index: i32, sep: i32) -> string {
    if (index < 0) { return ""; }
    var current: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == sep) {
            if (current == index) { return text.substring(start, i); }
            current = current + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// Split only outside quoted literals and enum brackets.  Invalid balancing
// returns -1, so a malformed token cannot disappear as an empty argument.
fn ea_count(text: string, sep: i32) -> i32 {
    if (text.trim().len == 0) { return 0; }
    var count: i32 = 1;
    var quoted: bool = false;
    var escaped: bool = false;
    var bracket: i32 = 0;
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 10 || c == 13 || c == 0) { return -1; }
        if (quoted) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quoted = false; }
        } else {
            if (c == 34) { quoted = true; }
            elif (c == 91) { bracket = bracket + 1; if (bracket > 1) { return -1; } }
            elif (c == 93) { bracket = bracket - 1; if (bracket < 0) { return -1; } }
            elif (c == 40 || c == 41 || c == 123 || c == 125 || c == 39) { return -1; }
            elif (c == sep && bracket == 0) { count = count + 1; }
        }
        i = i + 1;
    }
    if (quoted || escaped || bracket != 0) { return -1; }
    return count;
}

fn ea_part(text: string, index: i32, sep: i32) -> string {
    if (index < 0 || ea_count(text, sep) < 0) { return ""; }
    var current: i32 = 0;
    var start: i32 = 0;
    var quoted: bool = false;
    var escaped: bool = false;
    var bracket: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len) {
            if (current == index) { return text.substring(start, i).trim(); }
            return "";
        }
        let c = text.charAt(i);
        if (quoted) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quoted = false; }
        } else {
            if (c == 34) { quoted = true; }
            elif (c == 91) { bracket = bracket + 1; }
            elif (c == 93) { bracket = bracket - 1; }
            elif (c == sep && bracket == 0) {
                if (current == index) { return text.substring(start, i).trim(); }
                current = current + 1;
                start = i + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

fn ea_qualified(value: string) -> bool {
    let count = ea_plain_count(value, 46);
    if (count < 2) { return false; }
    var i: i32 = 0;
    while (i < count) {
        if (!ea_identifier(ea_plain_part(value, i, 46))) { return false; }
        i = i + 1;
    }
    return true;
}

fn ea_string_valid(value: string) -> bool {
    if (value.len < 2 || value.charAt(0) != 34 || value.charAt(value.len - 1) != 34) { return false; }
    var i: i32 = 1;
    while (i < value.len - 1) {
        let c = value.charAt(i);
        if (c < 32 || c == 34) { return false; }
        if (c == 92) {
            i = i + 1;
            if (i >= value.len - 1) { return false; }
            let escaped = value.charAt(i);
            if (escaped != 34 && escaped != 92 && escaped != 110
                && escaped != 114 && escaped != 116) { return false; }
        }
        i = i + 1;
    }
    return true;
}

fn ea_integer_type(type_name: string) -> bool {
    return ea_same(type_name, "int") || ea_same(type_name, "i8")
        || ea_same(type_name, "i16") || ea_same(type_name, "i32")
        || ea_same(type_name, "i64") || ea_same(type_name, "u8")
        || ea_same(type_name, "u16") || ea_same(type_name, "u32")
        || ea_same(type_name, "u64");
}

fn ea_integer_limit(type_name: string, negative: bool) -> string {
    if (ea_same(type_name, "i8")) { return if (negative) { "128" } else { "127" }; }
    if (ea_same(type_name, "i16")) { return if (negative) { "32768" } else { "32767" }; }
    if (ea_same(type_name, "i32")) { return if (negative) { "2147483648" } else { "2147483647" }; }
    if (ea_same(type_name, "u8")) { return "255"; }
    if (ea_same(type_name, "u16")) { return "65535"; }
    if (ea_same(type_name, "u32")) { return "4294967295"; }
    if (ea_same(type_name, "u64")) { return "18446744073709551615"; }
    return if (negative) { "9223372036854775808" } else { "9223372036854775807" };
}

fn ea_int_normalize(type_name: string, value: string) -> string {
    if (value.len == 0) { return ""; }
    var i: i32 = 0;
    var negative: bool = false;
    if (value.charAt(0) == 45) { negative = true; i = 1; }
    if (negative && type_name.startsWith("u")) { return ""; }
    if (i >= value.len) { return ""; }
    let digit_start = i;
    while (i < value.len) {
        let c = value.charAt(i);
        if (c < 48 || c > 57) { return ""; }
        i = i + 1;
    }
    i = digit_start;
    while (i < value.len - 1 && value.charAt(i) == 48) { i = i + 1; }
    let digits = value.substring(i, value.len);
    // Compare decimal digits instead of overflowing a machine conversion.
    let limit = ea_integer_limit(type_name, negative);
    if (digits.len > limit.len || (digits.len == limit.len && str_compare(digits, limit) > 0)) { return ""; }
    if (ea_same(digits, "0")) { return "0"; }
    if (negative) { return "-" + digits; }
    return digits;
}

fn ea_float_normalize(type_name: string, value: string) -> string {
    if (value.len == 0) { return ""; }
    var i: i32 = 0;
    if (value.charAt(i) == 45) { i = i + 1; }
    var digits: i32 = 0;
    var nonzero: bool = false;
    while (i < value.len && value.charAt(i) >= 48 && value.charAt(i) <= 57) {
        if (value.charAt(i) != 48) { nonzero = true; }
        digits = digits + 1; i = i + 1;
    }
    if (digits == 0) { return ""; }
    if (i < value.len && value.charAt(i) == 46) {
        i = i + 1;
        var fractional: i32 = 0;
        while (i < value.len && value.charAt(i) >= 48 && value.charAt(i) <= 57) {
            if (value.charAt(i) != 48) { nonzero = true; }
            fractional = fractional + 1; i = i + 1;
        }
        if (fractional == 0) { return ""; }
    }
    if (i < value.len && (value.charAt(i) == 101 || value.charAt(i) == 69)) {
        i = i + 1;
        if (i < value.len && (value.charAt(i) == 43 || value.charAt(i) == 45)) { i = i + 1; }
        var exponential: i32 = 0;
        while (i < value.len && value.charAt(i) >= 48 && value.charAt(i) <= 57) {
            exponential = exponential + 1; i = i + 1;
        }
        if (exponential == 0) { return ""; }
    }
    if (i != value.len) { return ""; }
    let number = str_to_float(value);
    let limit = if (ea_same(type_name, "f32")) {
        str_to_float("3.4028234663852886e38")
    } else { str_to_float("1.7976931348623157e308") };
    if (number > limit || number < 0.0 - limit || (number == 0.0 && nonzero)) { return ""; }
    if (ea_same(type_name, "f32")) {
        let narrowed = number as f32;
        if ((narrowed as f64) == 0.0 && nonzero) { return ""; }
    }
    if (!nonzero) { return "0.0"; }
    return value.replace("E", "e");
}

fn ea_enum_type(type_name: string) -> bool {
    if (type_name.len < 7 || !type_name.startsWith("enum[")
        || type_name.charAt(type_name.len - 1) != 93) { return false; }
    let values = type_name.substring(5, type_name.len - 1);
    let count = ea_plain_count(values, 124);
    var i: i32 = 0;
    while (i < count) {
        let value = ea_plain_part(values, i, 124);
        if (!ea_identifier(value)) { return false; }
        var j: i32 = 0;
        while (j < i) {
            if (ea_same(value, ea_plain_part(values, j, 124))) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

fn ea_type_valid(type_name: string) -> bool {
    return ea_same(type_name, "bool") || ea_integer_type(type_name)
        || ea_same(type_name, "f32") || ea_same(type_name, "f64")
        || ea_same(type_name, "string") || ea_same(type_name, "str")
        || ea_enum_type(type_name);
}

fn ea_value_normalize(type_name: string, value: string) -> string {
    let literal = value.trim();
    if (ea_same(type_name, "bool")) {
        if (ea_same(literal, "true") || ea_same(literal, "false")) { return literal; }
        return "";
    }
    if (ea_integer_type(type_name)) { return ea_int_normalize(type_name, literal); }
    if (ea_same(type_name, "f32") || ea_same(type_name, "f64")) { return ea_float_normalize(type_name, literal); }
    if (ea_same(type_name, "string") || ea_same(type_name, "str")) {
        if (ea_string_valid(literal)) { return literal; }
        return "";
    }
    if (ea_enum_type(type_name)) {
        var member = literal;
        if (ea_string_valid(literal)) { member = literal.substring(1, literal.len - 1); }
        if (!ea_identifier(member)) { return ""; }
        let values = type_name.substring(5, type_name.len - 1);
        let count = ea_plain_count(values, 124);
        var i: i32 = 0;
        while (i < count) {
            if (ea_same(member, ea_plain_part(values, i, 124))) { return "\"" + member + "\""; }
            i = i + 1;
        }
    }
    return "";
}

fn ea_targets_valid(targets: string) -> bool {
    let count = ea_plain_count(targets, 124);
    var i: i32 = 0;
    while (i < count) {
        let target = ea_plain_part(targets, i, 124);
        if (!ea_same(target, "declaration") && !ea_same(target, "function")
            && !ea_same(target, "type") && !ea_same(target, "field")
            && !ea_same(target, "module") && !ea_same(target, "variant")
            && !ea_same(target, "variable") && !ea_same(target, "use")) { return false; }
        var j: i32 = 0;
        while (j < i) {
            if (ea_same(target, ea_plain_part(targets, j, 124))) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

fn ea_params_valid(params: string) -> bool {
    let count = ea_count(params, 59);
    if (count < 0) { return false; }
    var i: i32 = 0;
    while (i < count) {
        let param = ea_part(params, i, 59);
        let fields = ea_count(param, 58);
        if (fields < 2 || fields > 3) { return false; }
        let key = ea_part(param, 0, 58);
        let type_name = ea_part(param, 1, 58);
        if (!ea_identifier(key) || !ea_type_valid(type_name)) { return false; }
        var j: i32 = 0;
        while (j < i) {
            if (ea_same(key, ea_part(ea_part(params, j, 59), 0, 58))) { return false; }
            j = j + 1;
        }
        if (fields == 3 && ea_value_normalize(type_name, ea_part(param, 2, 58)).len == 0) { return false; }
        i = i + 1;
    }
    return true;
}

public fn effect_attribute_schema_header_valid(header: string) -> bool {
    return ea_same(header, "MOSP-EFFECT-SCHEMAS\t1");
}

public fn effect_attribute_schema_field_count(row: string) -> i32 { return ea_plain_count(row, 9); }
public fn effect_attribute_schema_field(row: string, index: i32) -> string { return ea_plain_part(row, index, 9); }

public fn effect_attribute_schema_row_valid(row: string) -> bool {
    if (row.indexOf("\n") >= 0 || row.indexOf("\r") >= 0
        || effect_attribute_schema_field_count(row) != 6 || !ea_same(effect_attribute_schema_field(row, 0), "S")) { return false; }
    if (!ea_qualified(effect_attribute_schema_field(row, 1))) { return false; }
    let version = effect_attribute_schema_field(row, 2);
    if (version.len == 0 || version.charAt(0) < 49 || version.charAt(0) > 57) { return false; }
    var i: i32 = 0;
    while (i < version.len) {
        let c = version.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    if (!ea_targets_valid(effect_attribute_schema_field(row, 3)) || !ea_params_valid(effect_attribute_schema_field(row, 4))) { return false; }
    let consequence = effect_attribute_schema_field(row, 5);
    return ea_same(consequence, "record") || ea_same(consequence, "retain") || ea_same(consequence, "reflect");
}

// Stable diagnostic category for schema tooling.  The validator remains
// boolean for hot registration paths; callers that need a user-facing reason
// can inspect this closed set without parsing implementation text.
public fn effect_attribute_schema_row_error(row: string) -> string {
    if (row.indexOf("\n") >= 0 || row.indexOf("\r") >= 0
        || effect_attribute_schema_field_count(row) != 6 || !ea_same(effect_attribute_schema_field(row, 0), "S")) { return "header-or-fields"; }
    if (!ea_qualified(effect_attribute_schema_field(row, 1))) { return "attribute"; }
    let version = effect_attribute_schema_field(row, 2);
    if (version.len == 0 || version.charAt(0) < 49 || version.charAt(0) > 57) { return "version"; }
    var i: i32 = 0;
    while (i < version.len) {
        let c = version.charAt(i);
        if (c < 48 || c > 57) { return "version"; }
        i = i + 1;
    }
    if (!ea_targets_valid(effect_attribute_schema_field(row, 3))) { return "targets"; }
    if (!ea_params_valid(effect_attribute_schema_field(row, 4))) { return "params"; }
    let consequence = effect_attribute_schema_field(row, 5);
    if (!ea_same(consequence, "record") && !ea_same(consequence, "retain") && !ea_same(consequence, "reflect")) { return "consequence"; }
    return "";
}

public fn effect_attribute_schema_row_count(text: string) -> i32 {
    if (text.len == 0 || text.charAt(text.len - 1) != 10) { return -1; }
    return ea_plain_count(text, 10) - 2;
}

public fn effect_attribute_schema_row_at(text: string, index: i32) -> string {
    if (index < 0) { return ""; }
    return ea_plain_part(text, index + 1, 10);
}

public fn effect_attribute_schema_text_valid(text: string) -> bool {
    if (text.len == 0 || text.charAt(text.len - 1) != 10 || text.indexOf("\r") >= 0) { return false; }
    if (!effect_attribute_schema_header_valid(ea_plain_part(text, 0, 10))) { return false; }
    let count = effect_attribute_schema_row_count(text);
    if (count < 0) { return false; }
    var i: i32 = 0;
    while (i < count) {
        let row = effect_attribute_schema_row_at(text, i);
        if (!effect_attribute_schema_row_valid(row)) { return false; }
        let attr = effect_attribute_schema_field(row, 1);
        var j: i32 = 0;
        while (j < i) {
            if (ea_same(attr, effect_attribute_schema_field(effect_attribute_schema_row_at(text, j), 1))) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

fn ea_param_index(params: string, wanted: string) -> i32 {
    let count = ea_count(params, 59);
    var i: i32 = 0;
    while (i < count) {
        if (ea_same(ea_part(ea_part(params, i, 59), 0, 58), wanted)) { return i; }
        i = i + 1;
    }
    return -1;
}

fn ea_arg_value(arguments: string, wanted: string) -> string {
    let count = ea_count(arguments, 44);
    var i: i32 = 0;
    while (i < count) {
        let token = ea_part(arguments, i, 44);
        if (ea_same(ea_part(token, 0, 61), wanted)) { return ea_part(token, 1, 61); }
        i = i + 1;
    }
    return "";
}

public fn effect_attribute_schema_args_error(row: string, arguments: string) -> string {
    if (!effect_attribute_schema_row_valid(row)) { return "invalid-schema"; }
    let params = effect_attribute_schema_field(row, 4);
    let count = ea_count(arguments, 44);
    if (count < 0) { return "malformed-arguments"; }
    var i: i32 = 0;
    while (i < count) {
        let token = ea_part(arguments, i, 44);
        if (ea_count(token, 61) != 2) { return "expected-named-argument"; }
        let key = ea_part(token, 0, 61);
        if (!ea_identifier(key)) { return "invalid-key"; }
        let index = ea_param_index(params, key);
        if (index < 0) { return "unknown-argument:" + key; }
        var j: i32 = 0;
        while (j < i) {
            if (ea_same(key, ea_part(ea_part(arguments, j, 44), 0, 61))) { return "duplicate-argument:" + key; }
            j = j + 1;
        }
        let type_name = ea_part(ea_part(params, index, 59), 1, 58);
        if (ea_value_normalize(type_name, ea_part(token, 1, 61)).len == 0) { return "invalid-value:" + key; }
        i = i + 1;
    }
    let param_count = ea_count(params, 59);
    i = 0;
    while (i < param_count) {
        let param = ea_part(params, i, 59);
        let key = ea_part(param, 0, 58);
        if (ea_arg_value(arguments, key).len == 0 && ea_count(param, 58) != 3) { return "missing-argument:" + key; }
        i = i + 1;
    }
    return "";
}

public fn effect_attribute_schema_args_valid(row: string, arguments: string) -> bool {
    return effect_attribute_schema_args_error(row, arguments).len == 0;
}

public fn effect_attribute_schema_args_normalize(row: string, arguments: string) -> string {
    if (!effect_attribute_schema_args_valid(row, arguments)) { return ""; }
    let params = effect_attribute_schema_field(row, 4);
    let count = ea_count(params, 59);
    var out = "";
    var i: i32 = 0;
    while (i < count) {
        let param = ea_part(params, i, 59);
        let key = ea_part(param, 0, 58);
        let type_name = ea_part(param, 1, 58);
        var value = ea_arg_value(arguments, key);
        if (value.len == 0) { value = ea_part(param, 2, 58); }
        if (i > 0) { out = out + ","; }
        out = out + key + "=" + ea_value_normalize(type_name, value);
        i = i + 1;
    }
    return out;
}

// ── Declarative .attr source format ─────────────────────────────────────
//
// `.attr` is intentionally a small declaration language rather than Vyx
// source.  It uses Vyx's scalar spellings for values, but its grammar is
// stable and data-only so a package can be inspected without executing code.
// The parser below lowers one or more `attribute` blocks into the canonical
// table consumed by EffectPlan.  Keeping this conversion here also means the
// legacy table transport and the package format share exactly the same value
// and range checks.

fn ea_src_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn ea_src_word_at(text: string, pos: i32, word: string) -> bool {
    if (pos < 0 || pos + word.len > text.len) { return false; }
    if (text.substring(pos, pos + word.len) != word) { return false; }
    if (pos > 0) {
        let before = text.charAt(pos - 1);
        if (before == 95 || (before >= 48 && before <= 57)
            || (before >= 65 && before <= 90) || (before >= 97 && before <= 122)) { return false; }
    }
    let end = pos + word.len;
    if (end < text.len) {
        let after = text.charAt(end);
        if (after == 95 || (after >= 48 && after <= 57)
            || (after >= 65 && after <= 90) || (after >= 97 && after <= 122)) { return false; }
    }
    return true;
}

fn ea_src_skip(text: string, pos: i32) -> i32 {
    var i = pos;
    while (i < text.len && ea_src_space(text.charAt(i))) { i = i + 1; }
    return i;
}

fn ea_src_strip_comments(text: string) -> string {
    var out = "";
    var quote = false;
    var escaped = false;
    var line_comment = false;
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (line_comment) {
            if (c == 10) { line_comment = false; out = out + "\n"; }
            i = i + 1;
            continue;
        }
        if (quote) {
            out = out + text.substring(i, i + 1);
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
            i = i + 1;
            continue;
        }
        if (c == 34) { quote = true; out = out + text.substring(i, i + 1); i = i + 1; continue; }
        if (c == 47 && i + 1 < text.len && text.charAt(i + 1) == 47) {
            line_comment = true; i = i + 2; continue;
        }
        out = out + text.substring(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn ea_src_matching(text: string, open_pos: i32, open: i32, close: i32) -> i32 {
    if (open_pos < 0 || open_pos >= text.len || text.charAt(open_pos) != open) { return -1; }
    var depth: i32 = 0;
    var quote = false;
    var escaped = false;
    var i = open_pos;
    while (i < text.len) {
        let c = text.charAt(i);
        if (quote) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
        } else {
            if (c == 34) { quote = true; }
            elif (c == open) { depth = depth + 1; }
            elif (c == close) {
                depth = depth - 1;
                if (depth == 0) { return i; }
                if (depth < 0) { return -1; }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn ea_src_count(text: string, sep: i32) -> i32 {
    if (text.trim().len == 0) { return 0; }
    var count: i32 = 1;
    var square: i32 = 0;
    var curly: i32 = 0;
    var paren: i32 = 0;
    var quote = false;
    var escaped = false;
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (quote) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
        } else {
            if (c == 34) { quote = true; }
            elif (c == 91) { square = square + 1; }
            elif (c == 93) { square = square - 1; }
            elif (c == 123) { curly = curly + 1; }
            elif (c == 125) { curly = curly - 1; }
            elif (c == 40) { paren = paren + 1; }
            elif (c == 41) { paren = paren - 1; }
            elif (c == sep && square == 0 && curly == 0 && paren == 0) { count = count + 1; }
        }
        i = i + 1;
    }
    if (quote || square != 0 || curly != 0 || paren != 0) { return -1; }
    return count;
}

fn ea_src_piece(text: string, index: i32, sep: i32) -> string {
    let count = ea_src_count(text, sep);
    if (count < 0 || index < 0 || index >= count) { return ""; }
    var current: i32 = 0;
    var start: i32 = 0;
    var square: i32 = 0;
    var curly: i32 = 0;
    var paren: i32 = 0;
    var quote = false;
    var escaped = false;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len) {
            if (current == index) { return text.substring(start, i).trim(); }
            return "";
        }
        let c = text.charAt(i);
        if (quote) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
        } else {
            if (c == 34) { quote = true; }
            elif (c == 91) { square = square + 1; }
            elif (c == 93) { square = square - 1; }
            elif (c == 123) { curly = curly + 1; }
            elif (c == 125) { curly = curly - 1; }
            elif (c == 40) { paren = paren + 1; }
            elif (c == 41) { paren = paren - 1; }
            elif (c == sep && square == 0 && curly == 0 && paren == 0) {
                if (current == index) { return text.substring(start, i).trim(); }
                current = current + 1;
                start = i + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

fn ea_src_top_char(text: string, wanted: i32) -> i32 {
    var square: i32 = 0;
    var curly: i32 = 0;
    var paren: i32 = 0;
    var quote = false;
    var escaped = false;
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (quote) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
        } else {
            if (c == 34) { quote = true; }
            elif (c == 91) { square = square + 1; }
            elif (c == 93) { square = square - 1; }
            elif (c == 123) { curly = curly + 1; }
            elif (c == 125) { curly = curly - 1; }
            elif (c == 40) { paren = paren + 1; }
            elif (c == 41) { paren = paren - 1; }
            elif (c == wanted && square == 0 && curly == 0 && paren == 0) { return i; }
        }
        i = i + 1;
    }
    return -1;
}

fn ea_src_key_pos(body: string, key: string) -> i32 {
    var depth: i32 = 0;
    var quote = false;
    var escaped = false;
    var i: i32 = 0;
    while (i < body.len) {
        let c = body.charAt(i);
        if (quote) {
            if (escaped) { escaped = false; }
            elif (c == 92) { escaped = true; }
            elif (c == 34) { quote = false; }
        } else {
            if (c == 34) { quote = true; }
            elif (c == 123) { depth = depth + 1; }
            elif (c == 125) { depth = depth - 1; }
            elif (depth == 0 && ea_src_word_at(body, i, key)) {
                let after = ea_src_skip(body, i + key.len);
                if (after < body.len && (body.charAt(after) == 58
                    || (key == "arguments" && body.charAt(after) == 123))) { return i; }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn ea_src_field(body: string, key: string) -> string {
    let p = ea_src_key_pos(body, key);
    if (p < 0) { return ""; }
    let after = ea_src_skip(body, p + key.len);
    if (after >= body.len || body.charAt(after) != 58) { return ""; }
    let start = ea_src_skip(body, after + 1);
    let tail = body.substring(start, body.len);
    let end = ea_src_top_char(tail, 59);
    if (end < 0) { return ""; }
    return tail.substring(0, end).trim();
}

fn ea_src_block(body: string, key: string) -> string {
    let p = ea_src_key_pos(body, key);
    if (p < 0) { return ""; }
    let open = ea_src_skip(body, p + key.len);
    if (open >= body.len || body.charAt(open) != 123) { return ""; }
    let close = ea_src_matching(body, open, 123, 125);
    if (close < 0) { return ""; }
    return body.substring(open + 1, close);
}

fn ea_src_top_fields_valid(body: string) -> bool {
    var seen = "|";
    var i: i32 = 0;
    while (i < body.len) {
        i = ea_src_skip(body, i);
        while (i < body.len && body.charAt(i) == 59) {
            i = ea_src_skip(body, i + 1);
        }
        if (i >= body.len) { break; }

        let key_start = i;
        while (i < body.len) {
            let c = body.charAt(i);
            if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 95 || c == 46) {
                i = i + 1;
            } else { break; }
        }
        if (i == key_start) { return false; }
        let key = body.substring(key_start, i);
        if (key != "version" && key != "targets" && key != "extends"
            && key != "consequence" && key != "arguments") { return false; }
        if (seen.indexOf("|" + key + "|") >= 0) { return false; }
        seen = seen + key + "|";

        if (key == "arguments") {
            i = ea_src_skip(body, i);
            if (i >= body.len || body.charAt(i) != 123) { return false; }
            let close = ea_src_matching(body, i, 123, 125);
            if (close < 0) { return false; }
            i = close + 1;
            continue;
        }

        i = ea_src_skip(body, i);
        if (i >= body.len || body.charAt(i) != 58) { return false; }
        i = i + 1;
        let value_start = ea_src_skip(body, i);
        var square: i32 = 0;
        var paren: i32 = 0;
        var quote = false;
        var escaped = false;
        while (i < body.len) {
            let c = body.charAt(i);
            if (quote) {
                if (escaped) { escaped = false; }
                elif (c == 92) { escaped = true; }
                elif (c == 34) { quote = false; }
            } else {
                if (c == 34) { quote = true; }
                elif (c == 91) { square = square + 1; }
                elif (c == 93) { square = square - 1; }
                elif (c == 40) { paren = paren + 1; }
                elif (c == 41) { paren = paren - 1; }
                elif (c == 59 && square == 0 && paren == 0) { break; }
            }
            i = i + 1;
        }
        if (quote || square != 0 || paren != 0 || i >= body.len) { return false; }
        if (body.substring(value_start, i).trim().len == 0) { return false; }
    }
    return seen.indexOf("|version|") >= 0 && seen.indexOf("|targets|") >= 0
        && seen.indexOf("|arguments|") >= 0 && seen.indexOf("|consequence|") >= 0;
}

fn ea_src_name_list(value: string, allow_empty: bool) -> string {
    let v = value.trim();
    if (v.len < 2 || v.charAt(0) != 91 || v.charAt(v.len - 1) != 93) { return "|ERR|list"; }
    let inner = v.substring(1, v.len - 1).trim();
    if (inner.len == 0) { return if (allow_empty) { "" } else { "|ERR|list" }; }
    let count = ea_src_count(inner, 44);
    if (count < 0) { return "|ERR|list"; }
    var out = "";
    var i: i32 = 0;
    while (i < count) {
        let item = ea_src_piece(inner, i, 44).trim();
        if (!ea_identifier(item)) { return "|ERR|name"; }
        if (i > 0) { out = out + "|"; }
        out = out + item;
        i = i + 1;
    }
    return out;
}

fn ea_src_qualified_list(value: string) -> string {
    let v = value.trim();
    if (v.len == 0) { return ""; }
    if (v.len < 2 || v.charAt(0) != 91 || v.charAt(v.len - 1) != 93) { return "|ERR|extends"; }
    let inner = v.substring(1, v.len - 1).trim();
    if (inner.len == 0) { return ""; }
    let count = ea_src_count(inner, 44);
    if (count < 0) { return "|ERR|extends"; }
    var out = "";
    var i: i32 = 0;
    while (i < count) {
        let item = ea_src_piece(inner, i, 44).trim();
        if (!ea_qualified(item)) { return "|ERR|extends"; }
        if (i > 0) { out = out + "|"; }
        out = out + item;
        i = i + 1;
    }
    return out;
}

fn ea_src_type(raw: string) -> string {
    let t = raw.trim();
    if (t.startsWith("enum(") && t.len > 6 && t.charAt(t.len - 1) == 41) {
        let inner = t.substring(5, t.len - 1).trim();
        let count = ea_src_count(inner, 44);
        if (count <= 0) { return ""; }
        var out = "enum[";
        var i: i32 = 0;
        while (i < count) {
            let item = ea_src_piece(inner, i, 44).trim();
            if (!ea_string_valid(item)) { return ""; }
            let member = item.substring(1, item.len - 1);
            if (!ea_identifier(member)) { return ""; }
            if (i > 0) { out = out + "|"; }
            out = out + member;
            i = i + 1;
        }
        return out + "]";
    }
    // `str` is Vyx's short spelling; canonical tables use string so the
    // transport remains stable across compiler versions.
    if (t == "str") { return "string"; }
    if (t == "int") { return ""; }
    if (!ea_type_valid(t)) { return ""; }
    return t;
}

fn ea_src_params(body: string) -> string {
    if (body.trim().len > 0 && !body.trim().endsWith(";")) { return "|ERR|param-terminator"; }
    let count = ea_src_count(body, 59);
    if (count < 0) { return "|ERR|params"; }
    var out = "";
    var i: i32 = 0;
    while (i < count) {
        let item = ea_src_piece(body, i, 59).trim();
        if (item.len == 0) { i = i + 1; continue; }
        let colon = ea_src_top_char(item, 58);
        if (colon < 1) { return "|ERR|param"; }
        let key = item.substring(0, colon).trim();
        if (!ea_identifier(key)) { return "|ERR|param"; }
        let rhs = item.substring(colon + 1, item.len).trim();
        let eq = ea_src_top_char(rhs, 61);
        var type_name = rhs;
        var default_value = "";
        var has_default = false;
        if (eq >= 0) {
            type_name = rhs.substring(0, eq).trim();
            default_value = rhs.substring(eq + 1, rhs.len).trim();
            has_default = true;
        }
        let canonical_type = ea_src_type(type_name);
        if (canonical_type.len == 0) { return "|ERR|type"; }
        var j: i32 = 0;
        let existing = ea_src_count(out, 59);
        while (j < existing) {
            if (ea_part(ea_src_piece(out, j, 59), 0, 58) == key) { return "|ERR|duplicate"; }
            j = j + 1;
        }
        var row = key + ":" + canonical_type;
        if (has_default) {
            let normalized = ea_value_normalize(canonical_type, default_value);
            if (normalized.len == 0) { return "|ERR|default"; }
            row = row + ":" + normalized;
        }
        if (out.len > 0) { out = out + ";"; }
        out = out + row;
        i = i + 1;
    }
    return out;
}

fn ea_src_raw_find(rows: string, wanted: string) -> string {
    let count = ea_plain_count(rows, 10);
    var i: i32 = 0;
    while (i < count) {
        let row = ea_plain_part(rows, i, 10);
        if (ea_plain_count(row, 9) >= 7 && ea_plain_part(row, 1, 9) == wanted) { return row; }
        i = i + 1;
    }
    return "";
}

fn ea_src_stack_has(stack: string, wanted: string) -> bool {
    let count = ea_plain_count(stack, 124);
    var i: i32 = 0;
    while (i < count) {
        if (ea_plain_part(stack, i, 124) == wanted) { return true; }
        i = i + 1;
    }
    return false;
}

fn ea_src_merge_params(base: string, extra: string) -> string {
    var out = base;
    let count = ea_src_count(extra, 59);
    if (count < 0) { return "|ERR|params"; }
    var i: i32 = 0;
    while (i < count) {
        let item = ea_src_piece(extra, i, 59);
        let key = ea_part(item, 0, 58);
        let have = ea_src_count(out, 59);
        var j: i32 = 0;
        while (j < have) {
            if (ea_part(ea_src_piece(out, j, 59), 0, 58) == key) { return "|ERR|duplicate"; }
            j = j + 1;
        }
        if (out.len > 0) { out = out + ";"; }
        out = out + item;
        i = i + 1;
    }
    return out;
}

fn ea_src_resolve_params(rows: string, name: string, stack: string, depth: i32) -> string {
    if (depth > 64) { return "|ERR|inheritance-depth"; }
    if (ea_src_stack_has(stack, name)) { return "|ERR|cycle"; }
    let row = ea_src_raw_find(rows, name);
    if (row.len == 0) { return "|ERR|unknown-extends"; }
    let next_stack = stack + "|" + name;
    var out = "";
    let parents = ea_plain_part(row, 4, 9);
    let parent_count = ea_plain_count(parents, 124);
    var i: i32 = 0;
    while (i < parent_count) {
        let parent = ea_plain_part(parents, i, 124);
        if (parent.len > 0) {
            let inherited = ea_src_resolve_params(rows, parent, next_stack, depth + 1);
            if (inherited.startsWith("|ERR|")) { return inherited; }
            let merged = ea_src_merge_params(out, inherited);
            if (merged.startsWith("|ERR|")) { return merged; }
            out = merged;
        }
        i = i + 1;
    }
    let local = ea_plain_part(row, 5, 9);
    let merged_local = ea_src_merge_params(out, local);
    if (merged_local.startsWith("|ERR|")) { return merged_local; }
    return merged_local;
}

public fn effect_attribute_source_schema_text(source: string) -> string {
    let text = ea_src_strip_comments(source);
    var rows = "";
    var cursor: i32 = 0;
    var found = false;
    while (cursor < text.len) {
        let at = ea_src_skip(text, cursor);
        if (at >= text.len) { break; }
        if (!ea_src_word_at(text, at, "attribute")) { return "|ERR|unexpected-source"; }
        found = true;
        let name_start = ea_src_skip(text, at + 9);
        var name_end = name_start;
        while (name_end < text.len) {
            let c = text.charAt(name_end);
            if (c == 123 || ea_src_space(c)) { break; }
            name_end = name_end + 1;
        }
        let name = text.substring(name_start, name_end).trim();
        if (!ea_qualified(name)) { return "|ERR|attribute"; }
        let open = ea_src_skip(text, name_end);
        if (open >= text.len || text.charAt(open) != 123) { return "|ERR|block-open:" + name; }
        let close = ea_src_matching(text, open, 123, 125);
        if (close < 0) { return "|ERR|block-close:" + name; }
        let body = text.substring(open + 1, close);
        if (!ea_src_top_fields_valid(body)) { return "|ERR|field:" + name; }
        let version = ea_src_field(body, "version");
        if (version.len == 0 || version.charAt(0) < 49 || version.charAt(0) > 57) { return "|ERR|version"; }
        var vi: i32 = 0;
        while (vi < version.len) {
            let vc = version.charAt(vi);
            if (vc < 48 || vc > 57) { return "|ERR|version"; }
            vi = vi + 1;
        }
        let targets = ea_src_name_list(ea_src_field(body, "targets"), false);
        if (targets.startsWith("|ERR|")) { return targets; }
        let extends = ea_src_qualified_list(ea_src_field(body, "extends"));
        if (extends.startsWith("|ERR|")) { return extends; }
        let consequence = ea_src_field(body, "consequence").trim();
        if (consequence != "record" && consequence != "retain" && consequence != "reflect") { return "|ERR|consequence"; }
        let local_params = ea_src_params(ea_src_block(body, "arguments"));
        if (local_params.startsWith("|ERR|")) { return local_params; }
        if (ea_src_raw_find(rows, name).len > 0) { return "|ERR|duplicate"; }
        rows = rows + "A\t" + name + "\t" + version + "\t" + targets + "\t" + extends
             + "\t" + local_params + "\t" + consequence + "\n";
        cursor = close + 1;
    }
    if (!found) { return ""; }
    var out = "MOSP-EFFECT-SCHEMAS\t1\n";
    let count = ea_plain_count(rows, 10);
    var i: i32 = 0;
    while (i < count) {
        let raw = ea_plain_part(rows, i, 10);
        if (raw.len == 0) { i = i + 1; continue; }
        let name = ea_plain_part(raw, 1, 9);
        let params = ea_src_resolve_params(rows, name, "", 0);
        if (params.startsWith("|ERR|")) { return params; }
        out = out + "S\t" + name + "\t" + ea_plain_part(raw, 2, 9)
            + "\t" + ea_plain_part(raw, 3, 9) + "\t" + params
            + "\t" + ea_plain_part(raw, 6, 9) + "\n";
        i = i + 1;
    }
    if (!effect_attribute_schema_text_valid(out)) { return "|ERR|canonical"; }
    return out;
}

public fn effect_attribute_source_error(source: string) -> string {
    let parsed = effect_attribute_source_schema_text(source);
    if (parsed.startsWith("|ERR|")) { return parsed.substring(5, parsed.len); }
    return "";
}
