module bootstrap.vyx_rt;

/// LLVM-C ABI surface for `vyx_codegen.dll`.
///
/// Wire-compatible subset of `vyx_codegen/include/vyx_codegen.h`.
/// The header is the ABI lock. This file currently declares the 83 low-level
/// LLVM-builder entries shared by bootstrap modules; `codegen.vyx` declares
/// additional runtime string/profile helpers and convenience wrappers used only
/// by codegen.
///
/// ## Conventions (from header)
///   * Strings cross the boundary as `(const char* ptr, uint64_t len)` — on
///     the Vyx side that is `(name: rawptr, name_len: u64)`. `len == 0`
///     means "use strlen on ptr" except where noted in the header.
///   * Arrays cross as `(const T* ptr, uint64_t count)` — on the Vyx side
///     that is `(items: rawptr, n: u64)`. The element type is opaque
///     (`const void* const*`), so the Vyx side only needs a `rawptr`.
///   * Handles (Module / Type / Value / Function / BasicBlock) cross as
///     opaque `rawptr`. NULL on error.
///   * Status codes are `i32`: 0 = success, non-zero = error
///     (use `vyx_rt_get_last_error` for the message).
///   * Bool crosses as `i32` (0 / 1).
///
/// ## Linkage / predicate constants
///   * `VYX_RT_LINK_EXTERNAL = 0`, `..._INTERNAL = 1`, `..._PRIVATE = 2`,
///     `..._LINKONCE_ODR = 3`, `..._WEAK_ODR = 4`.
///   * `VYX_RT_ICMP_EQ = 32`, `..._NE = 33`, `..._SLT = 38`, `..._SLE = 39`,
///     `..._SGT = 40`, `..._SGE = 41` (mirror `LLVMIntPredicate`).
///
/// The groups below intentionally track the implemented bootstrap ABI surface,
/// not the historical 55-entry bring-up survey.

extern "C" {
    // ---------- 1. Lifetime & module (8) ----------
    fn vyx_rt_init() -> i32;
    fn vyx_rt_shutdown();
    fn vyx_rt_module_new(name: rawptr,
                         name_len: u64,
                         triple: rawptr,
                         triple_len: u64) -> rawptr;
    fn vyx_rt_module_free(h: rawptr);
    fn vyx_rt_set_target(h: rawptr,
                         triple: rawptr,
                         len: u64) -> i32;
    /// LLVM relocation model: 0 = target default, 1 = static, 2 = PIC.
    /// Backend CPU/architecture. Empty restores the target default.
    fn vyx_rt_set_target_cpu(h: rawptr, cpu: rawptr, len: u64) -> i32;
    /// LLVM relocation model: 0 = target default, 1 = static, 2 = PIC.
    fn vyx_rt_set_relocation_model(h: rawptr, model: i32) -> i32;
    fn vyx_rt_set_data_layout(h: rawptr,
                              dl: rawptr,
                              len: u64) -> i32;
    /// LLVM DataLayout address-space-0 GEP index width, or 0 for an invalid module.
    fn vyx_rt_pointer_index_bits(h: rawptr) -> i32;

    // ---------- 2. Error reporting (1) ----------
    fn vyx_rt_get_last_error(h: rawptr,
                             buf: rawptr,
                             cap: u64) -> u64;

    // ---------- 3. Type construction (8) ----------
    fn vyx_rt_int_type(h: rawptr, bits: i32) -> rawptr;
    fn vyx_rt_ptr_ty(h: rawptr) -> rawptr;
    fn vyx_rt_void_ty(h: rawptr) -> rawptr;
    fn vyx_rt_fn_type(h: rawptr,
                      ret_ty: rawptr,
                      params: rawptr,
                      n_params: u64,
                      is_vararg: i32) -> rawptr;
    fn vyx_rt_array_ty(h: rawptr,
                       elem_ty: rawptr,
                       count: u64) -> rawptr;
    fn vyx_rt_struct_ty_named(h: rawptr,
                              name: rawptr,
                              name_len: u64) -> rawptr;
    fn vyx_rt_struct_ty_set_body(h: rawptr,
                                 st: rawptr,
                                 fields: rawptr,
                                 n: u64,
                                 packed: i32) -> i32;
    fn vyx_rt_get_struct_field_ty(h: rawptr,
                                  st: rawptr,
                                  idx: u64) -> rawptr;
    fn vyx_rt_struct_field_offset(h: rawptr,
                                  st: rawptr,
                                  idx: u64) -> i64;
    fn vyx_rt_type_alloc_size(h: rawptr, ty: rawptr) -> i64;

    // ---------- 4. Constants (5) ----------
    fn vyx_rt_const_int(h: rawptr,
                        ty: rawptr,
                        value: i64,
                        sign_extend: i32) -> rawptr;
    fn vyx_rt_const_str(h: rawptr,
                        s: rawptr,
                        len: u64,
                        null_terminated: i32) -> rawptr;
    fn vyx_rt_const_null(h: rawptr, ty: rawptr) -> rawptr;
    fn vyx_rt_const_ptr_null(h: rawptr, ptr_ty: rawptr) -> rawptr;
    fn vyx_rt_const_real(h: rawptr, ty: rawptr, value: f64) -> rawptr;

    // ---------- 5. Functions / globals (7) ----------
    fn vyx_rt_add_function(h: rawptr,
                           name: rawptr,
                           name_len: u64,
                           fty: rawptr) -> rawptr;
    fn vyx_rt_set_function_attr(h: rawptr,
                                fn_: rawptr,
                                attr: rawptr,
                                attr_len: u64,
                                value: rawptr,
                                value_len: u64) -> i32;
    fn vyx_rt_set_param_abi_attr(h: rawptr,
                                 fn_: rawptr,
                                 param_index: u64,
                                 attr: rawptr,
                                 attr_len: u64,
                                 pointee_type: rawptr,
                                 alignment: u64) -> i32;
    fn vyx_rt_set_return_attr(h: rawptr,
                              fn_: rawptr,
                              attr: rawptr,
                              attr_len: u64) -> i32;
    fn vyx_rt_set_linkage(h: rawptr,
                          fn_or_global: rawptr,
                          linkage_kind: i32);
    fn vyx_rt_get_param(h: rawptr,
                        fn_: rawptr,
                        idx: u64) -> rawptr;
    fn vyx_rt_set_param_name(h: rawptr,
                             param: rawptr,
                             name: rawptr,
                             len: u64);
    fn vyx_rt_add_global(h: rawptr,
                         ty: rawptr,
                         name: rawptr,
                         name_len: u64) -> rawptr;
    fn vyx_rt_set_initializer(h: rawptr, gv: rawptr, const_val: rawptr);
    fn vyx_rt_set_global_constant(h: rawptr, gv: rawptr, is_const: i32);

    // ---------- 6. Builder & basic blocks (5) ----------
    fn vyx_rt_builder_new(h: rawptr) -> i32;
    fn vyx_rt_append_block(h: rawptr,
                           fn_: rawptr,
                           name: rawptr,
                           name_len: u64) -> rawptr;
    fn vyx_rt_position_at_end(h: rawptr, bb: rawptr);
    fn vyx_rt_get_insert_block(h: rawptr) -> rawptr;
    fn vyx_rt_clear_insertion(h: rawptr);

    // ---------- 7. IR — arith / compare / control flow (15) ----------
    fn vyx_rt_build_add(h: rawptr,
                         lhs: rawptr,
                         rhs: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_atomicrmw_add(h: rawptr,
                                  ptr: rawptr,
                                  value: rawptr,
                                  name: rawptr,
                                  len: u64) -> rawptr;
    fn vyx_rt_build_atomic_load(h: rawptr,
                                ty: rawptr,
                                ptr: rawptr,
                                name: rawptr,
                                len: u64) -> rawptr;
    fn vyx_rt_build_atomic_cmpxchg(h: rawptr,
                                   ptr: rawptr,
                                   expected: rawptr,
                                   desired: rawptr,
                                   name: rawptr,
                                   len: u64) -> rawptr;
    fn vyx_rt_build_sub(h: rawptr,
                        lhs: rawptr,
                        rhs: rawptr,
                        name: rawptr,
                        len: u64) -> rawptr;
    fn vyx_rt_build_mul(h: rawptr,
                        lhs: rawptr,
                        rhs: rawptr,
                        name: rawptr,
                        len: u64) -> rawptr;
    fn vyx_rt_build_sdiv(h: rawptr,
                         lhs: rawptr,
                         rhs: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_srem(h: rawptr,
                         lhs: rawptr,
                         rhs: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_icmp(h: rawptr,
                         pred: i32,
                         lhs: rawptr,
                         rhs: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_br(h: rawptr, dest_bb: rawptr);
    fn vyx_rt_build_cond_br(h: rawptr,
                            cond: rawptr,
                            then_bb: rawptr,
                            else_bb: rawptr);
    fn vyx_rt_build_ret(h: rawptr, val: rawptr);
    fn vyx_rt_build_ret_void(h: rawptr);
    fn vyx_rt_build_alloca(h: rawptr,
                           ty: rawptr,
                           name: rawptr,
                           len: u64) -> rawptr;
    fn vyx_rt_build_load(h: rawptr,
                         ty: rawptr,
                         ptr: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_store(h: rawptr, val: rawptr, ptr: rawptr);
    fn vyx_rt_build_gep(h: rawptr,
                        ty: rawptr,
                        ptr: rawptr,
                        idxs: rawptr,
                        n: u64,
                        name: rawptr,
                        len: u64) -> rawptr;
    fn vyx_rt_build_call(h: rawptr,
                         fty: rawptr,
                         callee: rawptr,
                         args: rawptr,
                         n: u64,
                         name: rawptr,
                         len: u64) -> rawptr;

    // ---------- 8. IR — casts (6) ----------
    fn vyx_rt_build_sext(h: rawptr,
                         val: rawptr,
                         dst_ty: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_zext(h: rawptr,
                         val: rawptr,
                         dst_ty: rawptr,
                         name: rawptr,
                         len: u64) -> rawptr;
    fn vyx_rt_build_trunc(h: rawptr,
                          val: rawptr,
                          dst_ty: rawptr,
                          name: rawptr,
                          len: u64) -> rawptr;
    fn vyx_rt_build_bitcast(h: rawptr,
                            val: rawptr,
                            dst_ty: rawptr,
                            name: rawptr,
                            len: u64) -> rawptr;
    fn vyx_rt_build_ptr_to_int(h: rawptr,
                               val: rawptr,
                               dst_ty: rawptr,
                               name: rawptr,
                               len: u64) -> rawptr;
    fn vyx_rt_build_int_to_ptr(h: rawptr,
                               val: rawptr,
                               dst_ty: rawptr,
                               name: rawptr,
                               len: u64) -> rawptr;

    // ---------- 8c. Debug info (4) ----------
    fn vyx_rt_enable_debug(h: rawptr, filename: rawptr, len: u64) -> i32;
    fn vyx_rt_debug_set_function(h: rawptr,
                                 fn_handle: rawptr,
                                 name: rawptr,
                                 len: u64,
                                 line: i32) -> i32;
    fn vyx_rt_debug_location(h: rawptr, line: i32, col: i32);
    fn vyx_rt_debug_finalize(h: rawptr);

    // ---------- 9. Verify / output (3) ----------
    fn vyx_rt_verify(h: rawptr) -> i32;
    fn vyx_rt_print_to_file(h: rawptr, path: rawptr, len: u64) -> i32;
    fn vyx_rt_emit_object(h: rawptr,
                          path: rawptr,
                          len: u64,
                          opt_level: i32) -> i32;
    /// `file_type`: 0 = object, 1 = textual assembly. NVPTX assembly is PTX.
    fn vyx_rt_emit_codegen(h: rawptr,
                           path: rawptr,
                           len: u64,
                           opt_level: i32,
                           file_type: i32) -> i32;

    // ---------- 10. Bitwise / unsigned / shift (7) ----------
    fn vyx_rt_build_and(h: rawptr, lhs: rawptr, rhs: rawptr,
                        name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_or(h: rawptr, lhs: rawptr, rhs: rawptr,
                       name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_xor(h: rawptr, lhs: rawptr, rhs: rawptr,
                        name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_shl(h: rawptr, lhs: rawptr, rhs: rawptr,
                        name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_lshr(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_udiv(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_urem(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;

    // ---------- 11. Floating-point (8) ----------
    fn vyx_rt_float_type(h: rawptr, bits: i32) -> rawptr;
    fn vyx_rt_build_fadd(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_fsub(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_fmul(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_fdiv(h: rawptr, lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_fcmp(h: rawptr, pred: i32,
                         lhs: rawptr, rhs: rawptr,
                         name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_fp_to_si(h: rawptr, val: rawptr, dst_ty: rawptr,
                             name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_si_to_fp(h: rawptr, val: rawptr, dst_ty: rawptr,
                             name: rawptr, len: u64) -> rawptr;

    // ---------- 12. Aggregate value ops (2) ----------
    fn vyx_rt_build_extract_value(h: rawptr, agg_val: rawptr, idx: i32,
                                  name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_insert_value(h: rawptr, agg_val: rawptr, elt: rawptr,
                                 idx: i32, name: rawptr, len: u64) -> rawptr;

    // ---------- 13. Switch / PHI (4) ----------
    fn vyx_rt_build_switch(h: rawptr, val: rawptr, else_bb: rawptr) -> rawptr;
    fn vyx_rt_add_case(h: rawptr, switch_val: rawptr,
                       on_val: rawptr, dest_bb: rawptr);
    fn vyx_rt_build_phi(h: rawptr, ty: rawptr,
                        name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_add_incoming(h: rawptr, phi: rawptr, val: rawptr, bb: rawptr);

    // ---------- 14. Named struct constant (1) ----------
    fn vyx_rt_const_named_struct(h: rawptr, struct_ty: rawptr,
                                 vals: rawptr, n: u64) -> rawptr;

    // ---------- 15. Misc (2) ----------
    fn vyx_rt_set_alignment(h: rawptr, val: rawptr, bytes: i32);
    fn vyx_rt_build_unreachable(h: rawptr) -> rawptr;

    // ---------- 16. Type introspection (2) ----------
    fn vyx_rt_is_array_type(ty: rawptr) -> i32;
    fn vyx_rt_array_elem_type(arr_ty: rawptr) -> rawptr;
}
