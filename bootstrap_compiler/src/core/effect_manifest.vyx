module bootstrap.effect_manifest;

use std.string;

// Cross-module representation for MOSP's Effect dimension.
//
// The manifest is deliberately a small, deterministic text envelope.  It is
// an interface artifact, not an executable program: attributes and arguments
// remain data until a registered Effect handler consumes them.  Every field is
// escaped before crossing the module boundary, and validation is fail-closed
// when the producer/consumer version, target, ABI or handler scope differs.

public fn effect_manifest_version() -> i32 { return 1; }

// Validation results.  Zero means the manifest may be consumed.
public fn effect_manifest_fresh() -> i32 { return 0; }
public fn effect_manifest_stale_version() -> i32 { return 1; }
public fn effect_manifest_target_mismatch() -> i32 { return 2; }
public fn effect_manifest_abi_mismatch() -> i32 { return 3; }
public fn effect_manifest_scope_mismatch() -> i32 { return 4; }
public fn effect_manifest_source_stale() -> i32 { return 5; }
public fn effect_manifest_compiler_stale() -> i32 { return 6; }
public fn effect_manifest_malformed() -> i32 { return 7; }
public fn effect_manifest_rejected() -> i32 { return 8; }

// Target and handler scope names are strings in the wire format so adding a
// new target does not renumber an existing manifest.  These helpers are the
// canonical spellings used by the compiler.
public fn effect_manifest_target_vyx() -> string { return "vyx"; }
public fn effect_manifest_target_cpp() -> string { return "cpp"; }
public fn effect_manifest_target_rust() -> string { return "rust"; }
public fn effect_manifest_target_zig() -> string { return "zig"; }
public fn effect_manifest_target_dce() -> string { return "dce"; }
public fn effect_manifest_scope_unit() -> string { return "unit"; }
public fn effect_manifest_scope_module() -> string { return "module"; }
public fn effect_manifest_scope_package() -> string { return "package"; }
public fn effect_manifest_scope_workspace() -> string { return "workspace"; }

public class EffectManifestRecord {
    public subject: string;
    public attribute: string;
    public arguments: string;
    public phase: string;
    public scope: string;
    public target: string;
    public abi: string;
    public flags: i32;
    public dependency: string;
}

public class EffectManifestDependency {
    public key: string;
    public value: string;
    public digest: string;
}

public class EffectManifest {
    public version: i32;
    public target: string;
    public abi: string;
    public handler_scope: string;
    public unit: string;
    public source_stamp: string;
    public compiler_stamp: string;
    public records: string;
    public dependencies: string;
    public record_count: i32;
    public dependency_count: i32;
    public malformed_count: i32;
    public duplicate_count: i32;
    public conflict_count: i32;
    public stale_reason: i32;
    public sealed: bool;
    public fingerprint: i64;
    public dependency_fingerprint: i64;
    public cycle_count: i32;
    public cycle_diagnostics: string;

    public static fn create(target: string,
                            abi: string,
                            handler_scope: string,
                            unit: string,
                            source_stamp: string,
                            compiler_stamp: string) -> EffectManifest {
        return EffectManifest {
            version: effect_manifest_version(),
            target: target.trim(),
            abi: abi.trim(),
            handler_scope: handler_scope.trim(),
            unit: unit.trim(),
            source_stamp: source_stamp,
            compiler_stamp: compiler_stamp,
            records: "",
            dependencies: "",
            record_count: 0,
            dependency_count: 0,
            malformed_count: 0,
            duplicate_count: 0,
            conflict_count: 0,
            stale_reason: effect_manifest_fresh(),
            sealed: false,
            fingerprint: 0,
            dependency_fingerprint: 0,
            cycle_count: 0,
            cycle_diagnostics: ""
        };
    }

    // Add one normalized Effect row.  A row can only be inserted while the
    // producer is open and its target/ABI/scope must agree with the envelope.
    public fn add_record(self,
                         subject: string,
                         attribute: string,
                         arguments: string,
                         phase: string,
                         scope: string,
                         target: string,
                         abi: string,
                         flags: i32,
                         dependency: string) -> bool {
        if (self.sealed) { self.conflict_count = self.conflict_count + 1; return false; }
        let s = subject.trim();
        let a = attribute.trim();
        let p = phase.trim();
        let row_scope = scope.trim();
        let row_target = target.trim();
        let row_abi = abi.trim();
        if (s.len == 0 || a.len == 0 || p.len == 0 || row_scope.len == 0
            || row_target.len == 0 || row_abi.len == 0) {
            self.malformed_count = self.malformed_count + 1;
            return false;
        }
        if (!effect_manifest_valid_flags(flags)) {
            self.malformed_count = self.malformed_count + 1;
            return false;
        }
        if (row_target != self.target || row_abi != self.abi) {
            self.conflict_count = self.conflict_count + 1;
            return false;
        }
        if (!effect_manifest_row_scope_compatible(self.handler_scope, row_scope)) {
            self.conflict_count = self.conflict_count + 1;
            return false;
        }
        let row = "R\t" + effect_manifest_escape(s) + "\t"
            + effect_manifest_escape(a) + "\t"
            + effect_manifest_escape(arguments) + "\t"
            + effect_manifest_escape(p) + "\t"
            + effect_manifest_escape(row_scope) + "\t"
            + effect_manifest_escape(row_target) + "\t"
            + effect_manifest_escape(row_abi) + "\t"
            + flags.toString() + "\t"
            + effect_manifest_escape(dependency);
        if (effect_manifest_has_line(self.records, row)) {
            self.duplicate_count = self.duplicate_count + 1;
            return false;
        }
        // A fact identity is stable independently of its canonical value and
        // provenance.  Re-emitting the same identity with different arguments,
        // flags, or dependency metadata is a conflict, not a second fact.
        if (effect_manifest_record_identity_conflict(self.records, s, a, p,
                                                     row_scope, row_target, row_abi)) {
            self.conflict_count = self.conflict_count + 1;
            return false;
        }
        self.records = self.records + row + "\n";
        self.record_count = self.record_count + 1;
        self.fingerprint = effect_manifest_mix(self.fingerprint, effect_manifest_hash(row));
        return true;
    }

    // Dependencies are summaries, never source paths with implicit meaning.
    // The caller supplies a stable value (for example an interface digest).
    public fn add_dependency(self, key: string, value: string, digest: string) -> bool {
        if (self.sealed) { self.conflict_count = self.conflict_count + 1; return false; }
        let k = key.trim();
        if (k.len == 0) { self.malformed_count = self.malformed_count + 1; return false; }
        let row = "D\t" + effect_manifest_escape(k) + "\t"
            + effect_manifest_escape(value) + "\t"
            + effect_manifest_escape(digest);
        if (effect_manifest_has_line(self.dependencies, row)) {
            // An identical dependency is harmless.  A key with a different
            // value is a conflict and must not silently replace old metadata.
            let prefix = "D\t" + effect_manifest_escape(k) + "\t";
            if (effect_manifest_has_prefix_line(self.dependencies, prefix)
                && !effect_manifest_has_line(self.dependencies, row)) {
                self.conflict_count = self.conflict_count + 1;
                return false;
            }
            self.duplicate_count = self.duplicate_count + 1;
            return false;
        }
        let prefix = "D\t" + effect_manifest_escape(k) + "\t";
        if (effect_manifest_has_prefix_line(self.dependencies, prefix)) {
            self.conflict_count = self.conflict_count + 1;
            return false;
        }
        self.dependencies = self.dependencies + row + "\n";
        self.dependency_count = self.dependency_count + 1;
        self.dependency_fingerprint = effect_manifest_compute_dependency_fingerprint(self.dependencies);
        return true;
    }

    /// Add a typed dependency edge.  Edges use the existing D record channel
    /// so old envelope framing remains intact, while the `edge:` key prefix
    /// gives consumers an unambiguous graph namespace.  A prospective back
    /// edge is rejected with a deterministic DFS path before it reaches the
    /// sealed manifest.
    public fn add_edge(self, source: string, target: string,
                       kind: string, digest: string) -> bool {
        if (self.sealed) { self.conflict_count = self.conflict_count + 1; return false; }
        let from = source.trim();
        let to = target.trim();
        let edge_kind = kind.trim();
        if (from.len == 0 || to.len == 0 || edge_kind.len == 0) {
            self.malformed_count = self.malformed_count + 1;
            return false;
        }
        let key = "edge:" + from + "->" + to;
        let path = effect_manifest_edge_find_path(self.dependencies, to, from,
                                                  "|" + to + "|");
        if (path.len > 0) {
            self.cycle_count = self.cycle_count + 1;
            let message = "EFFECT-CYCLE: dependency cycle: " + path + " -> " + to;
            self.cycle_diagnostics = self.cycle_diagnostics + message + "\n";
            self.conflict_count = self.conflict_count + 1;
            self.stale_reason = effect_manifest_rejected();
            return false;
        }
        return self.add_dependency(key, edge_kind, digest);
    }

    // Freeze seals the producer side.  Serialization after this point cannot
    // change the rows or dependency summary, making cache keys repeatable.
    public fn seal(self) {
        self.sealed = true;
        self.fingerprint = self.compute_fingerprint();
        if (self.cycle_count > 0) { self.stale_reason = effect_manifest_rejected(); }
    }

    public fn compute_fingerprint(self) -> i64 {
        let header = "MOSP-EFFECT-MANIFEST\t" + self.version.toString() + "\t"
            + self.target + "\t" + self.abi + "\t" + self.handler_scope + "\t"
            + self.unit + "\t" + self.source_stamp + "\t" + self.compiler_stamp;
        // Rows are canonicalized before hashing.  Producers may discover facts
        // in different traversal orders, but identical semantic manifests must
        // receive identical cache keys and dependency summaries.
        let canonical_records = effect_manifest_sorted_lines(self.records);
        let canonical_dependencies = effect_manifest_sorted_lines(self.dependencies);
        let h = effect_manifest_hash(header + "\n" + canonical_records
                                     + canonical_dependencies);
        return effect_manifest_mix(h,
            effect_manifest_compute_dependency_fingerprint(self.dependencies));
    }

    public fn serialize(self) -> string {
        if (!self.sealed) { self.seal(); }
        let canonical_records = effect_manifest_sorted_lines(self.records);
        let canonical_dependencies = effect_manifest_sorted_lines(self.dependencies);
        return "H\t" + self.version.toString() + "\t"
            + effect_manifest_escape(self.target) + "\t"
            + effect_manifest_escape(self.abi) + "\t"
            + effect_manifest_escape(self.handler_scope) + "\t"
            + effect_manifest_escape(self.unit) + "\t"
            + effect_manifest_escape(self.source_stamp) + "\t"
            + effect_manifest_escape(self.compiler_stamp) + "\t"
            + self.fingerprint.toString() + "\n"
            + canonical_records + canonical_dependencies;
    }

    // Validate an incoming manifest against the current compilation context.
    // Each mismatch receives a distinct result so callers can invalidate only
    // the affected cache layer and produce a useful diagnostic.
    public fn validate(self,
                       expected_target: string,
                       expected_abi: string,
                       expected_scope: string,
                       expected_source_stamp: string,
                       expected_compiler_stamp: string) -> i32 {
        if (self.version != effect_manifest_version()) {
            self.stale_reason = effect_manifest_stale_version(); return self.stale_reason;
        }
        if (self.target != expected_target.trim()) {
            self.stale_reason = effect_manifest_target_mismatch(); return self.stale_reason;
        }
        if (self.abi != expected_abi.trim()) {
            self.stale_reason = effect_manifest_abi_mismatch(); return self.stale_reason;
        }
        if (!effect_manifest_scope_compatible(expected_scope.trim(), self.handler_scope)) {
            self.stale_reason = effect_manifest_scope_mismatch(); return self.stale_reason;
        }
        if (self.source_stamp != expected_source_stamp) {
            self.stale_reason = effect_manifest_source_stale(); return self.stale_reason;
        }
        if (self.compiler_stamp != expected_compiler_stamp) {
            self.stale_reason = effect_manifest_compiler_stale(); return self.stale_reason;
        }
        if (self.cycle_count > 0 || self.stale_reason == effect_manifest_rejected()) {
            self.stale_reason = effect_manifest_rejected(); return self.stale_reason;
        }
        if (self.malformed_count > 0 || self.duplicate_count > 0
            || self.conflict_count > 0) {
            self.stale_reason = effect_manifest_malformed(); return self.stale_reason;
        }
        if (self.compute_fingerprint() != self.fingerprint) {
            self.stale_reason = effect_manifest_malformed(); return self.stale_reason;
        }
        self.stale_reason = effect_manifest_fresh();
        return self.stale_reason;
    }

    public fn status(self) -> i32 { return self.stale_reason; }
    public fn cycle_count_value(self) -> i32 { return self.cycle_count; }
    public fn cycle_diagnostic(self, index: i32) -> string {
        return effect_manifest_line_at(self.cycle_diagnostics, index);
    }
    public fn dependency_summary(self) -> string {
        return self.dependency_count.toString() + ":" + self.dependency_fingerprint.toString();
    }
    public fn record_row(self, index: i32) -> string {
        return effect_manifest_line_at(self.records, index);
    }
    public fn dependency_row(self, index: i32) -> string {
        return effect_manifest_line_at(self.dependencies, index);
    }

    // Return the digest for one typed dependency.  Consumers use this for
    // input classes whose change must invalidate an otherwise fresh envelope
    // (for example a package-owned declarative Effect schema).
    public fn dependency_digest(self, key: string) -> string {
        let wanted = key.trim();
        var i: i32 = 0;
        while (i < self.dependency_count) {
            let row = self.dependency_row(i);
            if (effect_manifest_field_count(row) == 4
                && effect_manifest_decode_field(effect_manifest_field(row, 1)) == wanted) {
                return effect_manifest_decode_field(effect_manifest_field(row, 3));
            }
            i = i + 1;
        }
        return "";
    }
}

// Parse a serialized envelope.  Unknown row tags are rejected instead of
// being ignored; this prevents a newer producer from appearing valid to an
// older consumer that would otherwise silently drop new Effect facts.
public fn effect_manifest_deserialize(text: string) -> EffectManifest {
    let first = effect_manifest_line_at(text, 0);
    let fields = effect_manifest_field_count(first);
    if (fields != 9 || !first.startsWith("H\t")) {
        let bad = EffectManifest.create("", "", "", "", "", "");
        bad.malformed_count = 1;
        bad.stale_reason = effect_manifest_malformed();
        bad.sealed = true;
        return bad;
    }
    let version = effect_manifest_parse_i32(effect_manifest_field(first, 1));
    if (!effect_manifest_nonnegative_i32(effect_manifest_field(first, 1))
        || !effect_manifest_fields_encoded(first, 2, 7)
        || !effect_manifest_nonnegative_i64(effect_manifest_field(first, 8))) {
        let bad_encoding = EffectManifest.create("", "", "", "", "", "");
        bad_encoding.malformed_count = 1;
        bad_encoding.stale_reason = effect_manifest_malformed();
        bad_encoding.sealed = true;
        return bad_encoding;
    }
    let out = EffectManifest.create(effect_manifest_unescape(effect_manifest_field(first, 2)),
        effect_manifest_unescape(effect_manifest_field(first, 3)),
        effect_manifest_unescape(effect_manifest_field(first, 4)),
        effect_manifest_unescape(effect_manifest_field(first, 5)),
        effect_manifest_unescape(effect_manifest_field(first, 6)),
        effect_manifest_unescape(effect_manifest_field(first, 7)));
    out.version = version;
    // Rebuild row/dependency state from zero.  add_record/add_dependency mix
    // their row hashes into the mutable accumulator, while the wire header
    // carries the final envelope fingerprint (which also includes the
    // canonical header).  Keeping the header value in the accumulator during
    // parsing would count it a second time and make a valid manifest appear
    // stale after a round trip.
    let expected_fingerprint = effect_manifest_parse_i64(effect_manifest_field(first, 8));
    out.fingerprint = 0;
    var line_index: i32 = 1;
    let line_count = effect_manifest_line_count(text);
    while (line_index < line_count) {
        let line = effect_manifest_line_at(text, line_index);
        if (line.len == 0) {
            // Only the implicit position after a final newline is outside
            // line_count.  An empty line in the envelope is a real malformed
            // record; otherwise trailing garbage could be ignored.
            out.malformed_count = out.malformed_count + 1;
            line_index = line_index + 1;
            continue;
        }
        if (line.startsWith("R\t")) {
            if (effect_manifest_field_count(line) != 10) {
                out.malformed_count = out.malformed_count + 1;
            } else {
                if (!effect_manifest_fields_encoded(line, 1, 7)
                    || !effect_manifest_encoded_field_valid(effect_manifest_field(line, 9))
                    || !effect_manifest_valid_flags_text(effect_manifest_field(line, 8))) {
                    out.malformed_count = out.malformed_count + 1;
                    line_index = line_index + 1;
                    continue;
                }
                let ok = out.add_record(effect_manifest_unescape(effect_manifest_field(line, 1)),
                    effect_manifest_unescape(effect_manifest_field(line, 2)),
                    effect_manifest_unescape(effect_manifest_field(line, 3)),
                    effect_manifest_unescape(effect_manifest_field(line, 4)),
                    effect_manifest_unescape(effect_manifest_field(line, 5)),
                    effect_manifest_unescape(effect_manifest_field(line, 6)),
                    effect_manifest_unescape(effect_manifest_field(line, 7)),
                    effect_manifest_parse_i32(effect_manifest_field(line, 8)),
                    effect_manifest_unescape(effect_manifest_field(line, 9)));
                if (!ok) { out.malformed_count = out.malformed_count + 1; }
            }
        } else if (line.startsWith("D\t")) {
            if (effect_manifest_field_count(line) != 4) {
                out.malformed_count = out.malformed_count + 1;
            } else {
                if (!effect_manifest_fields_encoded(line, 1, 3)) {
                    out.malformed_count = out.malformed_count + 1;
                    line_index = line_index + 1;
                    continue;
                }
                let key = effect_manifest_unescape(effect_manifest_field(line, 1));
                let value = effect_manifest_unescape(effect_manifest_field(line, 2));
                let digest = effect_manifest_unescape(effect_manifest_field(line, 3));
                var ok = false;
                if (key.startsWith("edge:")) {
                    let edge_source = effect_manifest_edge_key_source(key);
                    let edge_target = effect_manifest_edge_key_target(key);
                    ok = out.add_edge(edge_source, edge_target, value, digest);
                } else {
                    ok = out.add_dependency(key, value, digest);
                }
                if (!ok) { out.malformed_count = out.malformed_count + 1; }
            }
        } else {
            out.malformed_count = out.malformed_count + 1;
        }
        line_index = line_index + 1;
    }
    // Keep the producer's sealed state: consumers cannot append to a parsed
    // artifact.  The parsed rows have already rebuilt their own hash state.
    out.fingerprint = expected_fingerprint;
    out.sealed = true;
    if (out.malformed_count > 0) { out.stale_reason = effect_manifest_malformed(); }
    return out;
}

public fn effect_manifest_status_name(status: i32) -> string {
    if (status == effect_manifest_fresh()) { return "fresh"; }
    if (status == effect_manifest_stale_version()) { return "stale-version"; }
    if (status == effect_manifest_target_mismatch()) { return "target-mismatch"; }
    if (status == effect_manifest_abi_mismatch()) { return "abi-mismatch"; }
    if (status == effect_manifest_scope_mismatch()) { return "scope-mismatch"; }
    if (status == effect_manifest_source_stale()) { return "source-stale"; }
    if (status == effect_manifest_compiler_stale()) { return "compiler-stale"; }
    if (status == effect_manifest_malformed()) { return "malformed"; }
    if (status == effect_manifest_rejected()) { return "rejected"; }
    return "unknown";
}

// Public wire helpers used by the compiler-owned consumer.  Manifest fields
// are percent escaped so tabs/newlines cannot alter row boundaries; callers
// must decode before turning a row back into a semantic fact.
public fn effect_manifest_decode_field(value: string) -> string {
    return effect_manifest_unescape(value);
}

public fn effect_manifest_dependency_digest_text(text: string, key: string) -> string {
    let manifest = effect_manifest_deserialize(text);
    return manifest.dependency_digest(key);
}

public fn effect_manifest_scope_compatible(expected: string, actual: string) -> bool {
    let e = expected.trim();
    let a = actual.trim();
    if (e == a) { return true; }
    // A workspace consumer may read package/module/unit facts.  Narrower
    // consumers must never read broader facts because their invalidation
    // boundary is insufficient.
    if (e == effect_manifest_scope_workspace()) {
        return a == effect_manifest_scope_package() || a == effect_manifest_scope_module()
            || a == effect_manifest_scope_unit();
    }
    if (e == effect_manifest_scope_package()) {
        return a == effect_manifest_scope_module() || a == effect_manifest_scope_unit();
    }
    if (e == effect_manifest_scope_module()) { return a == effect_manifest_scope_unit(); }
    return false;
}

// A manifest envelope is scoped to a compilation unit/module/package, while
// each row keeps the narrower declaration scope supplied by its handler
// schema.  Declaration-level rows are valid members of any broader envelope;
// a row may never widen the envelope's invalidation boundary.
fn effect_manifest_row_scope_compatible(envelope: string, row: string) -> bool {
    let e = envelope.trim();
    let r = row.trim();
    if (e == r) { return true; }
    if (r == "declaration" || r == "function" || r == "type" || r == "field"
        || r == "module" || r == "variant" || r == "expression") {
        return e == effect_manifest_scope_unit()
            || e == effect_manifest_scope_module()
            || e == effect_manifest_scope_package()
            || e == effect_manifest_scope_workspace();
    }
    return false;
}

fn effect_manifest_edge_key_source(key: string) -> string {
    if (!key.startsWith("edge:")) { return ""; }
    let body = key.substring(5, key.len);
    let arrow = body.indexOf("->");
    if (arrow < 0) { return ""; }
    return body.substring(0, arrow);
}

fn effect_manifest_edge_key_target(key: string) -> string {
    if (!key.startsWith("edge:")) { return ""; }
    let body = key.substring(5, key.len);
    let arrow = body.indexOf("->");
    if (arrow < 0 || arrow + 2 >= body.len) { return ""; }
    return body.substring(arrow + 2, body.len);
}

fn effect_manifest_edge_next_sorted(lines: string, source: string, path: string) -> string {
    if (source.len == 0) { return ""; }
    var best = "";
    var i: i32 = 0;
    while (true) {
        let row = effect_manifest_line_at(lines, i);
        if (row.len == 0) { break; }
        if (row.startsWith("D\t") && effect_manifest_field_count(row) == 4) {
            let key = effect_manifest_unescape(effect_manifest_field(row, 1));
            let edge_source = effect_manifest_edge_key_source(key);
            let edge_target = effect_manifest_edge_key_target(key);
            if (edge_source == source && edge_target.len > 0
                && path.indexOf("|" + edge_target + "|") < 0
                && (best.len == 0 || str_compare(edge_target, best) < 0)) {
                best = edge_target;
            }
        }
        i = i + 1;
    }
    return best;
}

fn effect_manifest_edge_find_path(lines: string, current: string,
                                  want: string, path: string) -> string {
    if (current == want) { return current; }
    var best = "";
    var i: i32 = 0;
    while (true) {
        let row = effect_manifest_line_at(lines, i);
        if (row.len == 0) { break; }
        if (row.startsWith("D\t") && effect_manifest_field_count(row) == 4) {
            let key = effect_manifest_unescape(effect_manifest_field(row, 1));
            let source = effect_manifest_edge_key_source(key);
            let target = effect_manifest_edge_key_target(key);
            if (source == current && target.len > 0
                && path.indexOf("|" + target + "|") < 0) {
                let tail = effect_manifest_edge_find_path(lines, target, want,
                                                           path + target + "|");
                if (tail.len > 0) {
                    let candidate = current + " -> " + tail;
                    if (best.len == 0 || str_compare(candidate, best) < 0) { best = candidate; }
                }
            }
        }
        i = i + 1;
    }
    return best;
}

fn effect_manifest_mix(a: i64, b: i64) -> i64 {
    let modulus: i64 = 2147483647;
    var x = (a + b + 97) % modulus;
    if (x < 0) { x = x + modulus; }
    return x;
}

fn effect_manifest_hash(text: string) -> i64 {
    let modulus: i64 = 2147483647;
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < text.len) {
        h = (h * 33 + (text.charAt(i) as i64)) % modulus;
        i = i + 1;
    }
    if (h < 0) { return h + modulus; }
    return h;
}

// Return the rows in byte-lexicographic order.  Manifest rows are kept as a
// newline-delimited string for the bootstrap compiler, so a small selection
// sort is clearer and less error-prone than relying on hash-table traversal
// order.  The input is expected to contain no empty records.
public fn effect_manifest_sorted_lines(lines: string) -> string {
    var remaining = lines;
    var out = "";
    while (remaining.len > 0) {
        let count = effect_manifest_line_count(remaining);
        var best = "";
        var best_index: i32 = -1;
        var i: i32 = 0;
        while (i < count) {
            let row = effect_manifest_line_at(remaining, i);
            if (row.len > 0 && (best_index < 0 || str_compare(row, best) < 0)) {
                best = row;
                best_index = i;
            }
            i = i + 1;
        }
        if (best_index < 0) { break; }
        out = out + best + "\n";
        var next = "";
        var j: i32 = 0;
        while (j < count) {
            if (j != best_index) {
                let row = effect_manifest_line_at(remaining, j);
                if (row.len > 0) { next = next + row + "\n"; }
            }
            j = j + 1;
        }
        remaining = next;
    }
    return out;
}

fn effect_manifest_compute_dependency_fingerprint(lines: string) -> i64 {
    let canonical = effect_manifest_sorted_lines(lines);
    var result: i64 = 0;
    var i: i32 = 0;
    let count = effect_manifest_line_count(canonical);
    while (i < count) {
        let row = effect_manifest_line_at(canonical, i);
        if (row.len > 0) { result = effect_manifest_mix(result, effect_manifest_hash(row)); }
        i = i + 1;
    }
    return result;
}

fn effect_manifest_record_identity_conflict(lines: string,
                                            subject: string,
                                            attribute: string,
                                            phase: string,
                                            scope: string,
                                            target: string,
                                            abi: string) -> bool {
    var i: i32 = 0;
    while (true) {
        let row = effect_manifest_line_at(lines, i);
        if (row.len == 0) { return false; }
        if (row.startsWith("R\t") && effect_manifest_field_count(row) == 10
            && effect_manifest_unescape(effect_manifest_field(row, 1)) == subject
            && effect_manifest_unescape(effect_manifest_field(row, 2)) == attribute
            && effect_manifest_unescape(effect_manifest_field(row, 4)) == phase
            && effect_manifest_unescape(effect_manifest_field(row, 5)) == scope
            && effect_manifest_unescape(effect_manifest_field(row, 6)) == target
            && effect_manifest_unescape(effect_manifest_field(row, 7)) == abi) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn effect_manifest_encoded_field_valid(value: string) -> bool {
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 37) {
            if (i + 2 >= value.len) { return false; }
            let a = value.charAt(i + 1);
            let b = value.charAt(i + 2);
            if (!((a == 50 && b == 53) || (a == 48 && b == 57)
                || (a == 48 && b == 65) || (a == 48 && b == 68))) {
                return false;
            }
            i = i + 3;
        } else {
            i = i + 1;
        }
    }
    return true;
}

fn effect_manifest_fields_encoded(line: string, first: i32, last: i32) -> bool {
    var i = first;
    while (i <= last) {
        if (!effect_manifest_encoded_field_valid(effect_manifest_field(line, i))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn effect_manifest_nonnegative_i32(text: string) -> bool {
    if (text.len == 0) { return false; }
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn effect_manifest_valid_flags(flags: i32) -> bool {
    // Record flags are a closed status enum, not an open-ended bitmask:
    // 0=plain, 1=registered, 2=opaque/unregistered, 4=rejected.  Composite
    // values would make the consumer interpretation ambiguous.
    return flags == 0 || flags == 1 || flags == 2 || flags == 4;
}

fn effect_manifest_valid_flags_text(text: string) -> bool {
    if (!effect_manifest_nonnegative_i32(text)) { return false; }
    return effect_manifest_valid_flags(effect_manifest_parse_i32(text));
}

fn effect_manifest_nonnegative_i64(text: string) -> bool {
    // The wire fingerprint is always emitted as a non-negative decimal hash.
    // Keep this separate from i32 validation so malformed envelopes cannot be
    // coerced to zero by the permissive parser.
    if (text.len == 0) { return false; }
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn effect_manifest_escape(value: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < value.len) {
        let c = value.charAt(i);
        if (c == 37) { out = out + "%25"; }
        elif (c == 9) { out = out + "%09"; }
        elif (c == 10) { out = out + "%0A"; }
        elif (c == 13) { out = out + "%0D"; }
        else { out = out + value.substring(i, i + 1); }
        i = i + 1;
    }
    return out;
}

/// Public wire-field encoder for Effect-owned sidecar artifacts.  Keep the
/// escaping implementation in one place so the regular Effect manifest and
/// the DCI export selector cannot disagree about tabs, newlines, or backslashes.
public fn effect_manifest_encode_field(value: string) -> string {
    return effect_manifest_escape(value);
}

fn effect_manifest_unescape(value: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 37 && i + 2 < value.len) {
            let a = value.charAt(i + 1);
            let b = value.charAt(i + 2);
            if (a == 50 && b == 53) { out = out + "%"; i = i + 3; continue; }
            if (a == 48 && b == 57) { out = out + "\t"; i = i + 3; continue; }
            if (a == 48 && b == 65) { out = out + "\n"; i = i + 3; continue; }
            if (a == 48 && b == 68) { out = out + "\r"; i = i + 3; continue; }
        }
        out = out + value.substring(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn effect_manifest_line_at(text: string, index: i32) -> string {
    if (index < 0) { return ""; }
    var start: i32 = 0;
    var row: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            if (row == index) { return text.substring(start, i); }
            row = row + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn effect_manifest_line_count(text: string) -> i32 {
    if (text.len == 0) { return 0; }
    var count: i32 = 0;
    var i: i32 = 0;
    while (i < text.len) {
        if (text.charAt(i) == 10) { count = count + 1; }
        i = i + 1;
    }
    if (text.charAt(text.len - 1) != 10) { count = count + 1; }
    return count;
}

fn effect_manifest_field_count(line: string) -> i32 {
    if (line.len == 0) { return 0; }
    var count: i32 = 1;
    var i: i32 = 0;
    while (i < line.len) {
        if (line.charAt(i) == 9) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn effect_manifest_field(line: string, index: i32) -> string {
    if (index < 0) { return ""; }
    var start: i32 = 0;
    var item: i32 = 0;
    var i: i32 = 0;
    while (i <= line.len) {
        if (i == line.len || line.charAt(i) == 9) {
            if (item == index) { return line.substring(start, i); }
            item = item + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn effect_manifest_has_line(lines: string, want: string) -> bool {
    var i: i32 = 0;
    while (true) {
        let row = effect_manifest_line_at(lines, i);
        if (row.len == 0) { return false; }
        if (row == want) { return true; }
        i = i + 1;
    }
    return false;
}

fn effect_manifest_has_prefix_line(lines: string, prefix: string) -> bool {
    var i: i32 = 0;
    while (true) {
        let row = effect_manifest_line_at(lines, i);
        if (row.len == 0) { return false; }
        if (row.startsWith(prefix)) { return true; }
        i = i + 1;
    }
    return false;
}

fn effect_manifest_parse_i32(text: string) -> i32 {
    var sign: i32 = 1;
    var i: i32 = 0;
    if (text.len > 0 && text.charAt(0) == 45) { sign = -1; i = 1; }
    var out: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) { return 0; }
        out = out * 10 + c - 48;
        i = i + 1;
    }
    return out * sign;
}

fn effect_manifest_parse_i64(text: string) -> i64 {
    var sign: i64 = 1;
    var i: i32 = 0;
    if (text.len > 0 && text.charAt(0) == 45) { sign = -1; i = 1; }
    var out: i64 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c < 48 || c > 57) { return 0; }
        let digit: i64 = (c - 48) as i64;
        out = (out * 10) + digit;
        i = i + 1;
    }
    return out * sign;
}
