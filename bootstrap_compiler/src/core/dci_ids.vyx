module bootstrap.dci_ids;

/// Process-wide DCI identity table. Names are stored already canonical.
/// Invalid id is 0. Allocation happens at contract parse (WP-J).

var g_dci_type_table: string = "\n";
var g_dci_layout_table: string = "\n";
var g_dci_symbol_table: string = "\n";
var g_dci_type_next: i32 = 1;
var g_dci_layout_next: i32 = 1;
var g_dci_symbol_next: i32 = 1;
var g_dci_declaration_noops: i32 = 0;

public fn dci_type_id_invalid() -> i32 { return 0; }
public fn dci_layout_id_invalid() -> i32 { return 0; }
public fn dci_symbol_id_invalid() -> i32 { return 0; }

public fn dci_ids_type_count() -> i32 { return g_dci_type_next - 1; }
public fn dci_ids_declaration_noop_count() -> i32 { return g_dci_declaration_noops; }

public fn dci_ids_note_declaration_noop() {
    g_dci_declaration_noops = g_dci_declaration_noops + 1;
}

fn dci_ids_parse_i32(text: string) -> i32 {
    if (text.len <= 0) { return 0; }
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (ch < 48 || ch > 57) { return 0; }
        n = n * 10 + (ch - 48);
        i = i + 1;
    }
    return n;
}

fn dci_ids_lookup_in(table: string, canon: string) -> i32 {
    if (canon.len == 0 || table.len <= 1) { return 0; }
    let needle = "\n" + canon + "\t";
    let pos = table.indexOf(needle);
    if (pos < 0) { return 0; }
    let start = pos + needle.len;
    var end = start;
    while (end < table.len && table.charAt(end) != 10) {
        end = end + 1;
    }
    return dci_ids_parse_i32(table.substring(start, end));
}

public fn dci_ids_lookup_type(canon: string) -> i32 {
    return dci_ids_lookup_in(g_dci_type_table, canon);
}

public fn dci_ids_lookup_layout(canon: string) -> i32 {
    return dci_ids_lookup_in(g_dci_layout_table, canon);
}

public fn dci_ids_lookup_symbol(canon: string) -> i32 {
    return dci_ids_lookup_in(g_dci_symbol_table, canon);
}

public fn dci_ids_intern_type(canon: string) -> i32 {
    if (canon.len == 0) { return dci_type_id_invalid(); }
    let existing = dci_ids_lookup_type(canon);
    if (existing > 0) { return existing; }
    let id = g_dci_type_next;
    g_dci_type_next = g_dci_type_next + 1;
    g_dci_type_table = g_dci_type_table + canon + "\t" + id.toString() + "\n";
    return id;
}

public fn dci_ids_intern_layout(canon: string) -> i32 {
    if (canon.len == 0) { return dci_layout_id_invalid(); }
    let existing = dci_ids_lookup_layout(canon);
    if (existing > 0) { return existing; }
    let id = g_dci_layout_next;
    g_dci_layout_next = g_dci_layout_next + 1;
    g_dci_layout_table = g_dci_layout_table + canon + "\t" + id.toString() + "\n";
    return id;
}

public fn dci_ids_intern_symbol(canon: string) -> i32 {
    if (canon.len == 0) { return dci_symbol_id_invalid(); }
    let existing = dci_ids_lookup_symbol(canon);
    if (existing > 0) { return existing; }
    let id = g_dci_symbol_next;
    g_dci_symbol_next = g_dci_symbol_next + 1;
    g_dci_symbol_table = g_dci_symbol_table + canon + "\t" + id.toString() + "\n";
    return id;
}

fn dci_ids_last_segment(name: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { start = i + 1; }
        i = i + 1;
    }
    if (start == 0) { return name; }
    return name.substring(start, name.len as i32);
}

fn dci_ids_table_name_at(table: string, want_idx: i32) -> string {
    var idx: i32 = 0;
    var i: i32 = 1;
    while (i < table.len) {
        var end = i;
        while (end < table.len && table.charAt(end) != 9) {
            end = end + 1;
        }
        if (end > i && end < table.len && table.charAt(end) == 9) {
            if (idx == want_idx) { return table.substring(i, end); }
            idx = idx + 1;
            while (end < table.len && table.charAt(end) != 10) {
                end = end + 1;
            }
            i = end + 1;
        } else {
            i = i + 1;
        }
    }
    return "";
}

/// Probe / dump: same last segment, different namespace stays distinct ids.
public fn dci_ids_report_last_segment_distinct() {
    var i: i32 = 0;
    while (i < 256) {
        let a = dci_ids_table_name_at(g_dci_type_table, i);
        if (a.len == 0) { return; }
        let aseg = dci_ids_last_segment(a);
        var j: i32 = i + 1;
        while (j < 256) {
            let b = dci_ids_table_name_at(g_dci_type_table, j);
            if (b.len == 0) { j = 256; }
            else {
                if (aseg.len > 0 && aseg == dci_ids_last_segment(b) && a != b) {
                    print("dci.ids last_segment_not_equal " + a + " " + b);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}
