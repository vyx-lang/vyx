module bootstrap.build_source_index;

use std.collections;

// Target-local, immutable source identities. Construct after source-generating
// hooks, retain through planning, and destroy before executing the object batch.
// Hashes select buckets; complete key bytes decide identity. A module prefix only
// matches at a dot boundary, and duplicate modules retain source-list order.
public class BuildSourceRecord {
    public path: string;
    public module_name: string;
    public group_key: string;
    public imports: string;
    public interface_stamp: string;
    public stamp_ready: bool;
}

public class BuildSourceGroup {
    public paths: string;
}

public class BuildSourceKey {
    public text: string;
    public value: i64;
}

// An index stores IDs, not copies of source records. Keys live in the target
// arena; growing the probe table leaves record IDs and key storage unchanged.
public class BuildSourceMap {
    public keys: Vec<BuildSourceKey>;
    public slots: Vec<i64>;

    public static fn create(capacity: i64) -> BuildSourceMap {
        var out = BuildSourceMap { keys: Vec::<BuildSourceKey>.with_capacity(capacity),
                                   slots: Vec::<i64>.with_capacity(capacity * 2 + 1) };
        var i: i64 = 0;
        while (i < capacity * 2 + 1) { out.slots.push(-1); i = i + 1; }
        return out;
    }

    public static fn hash(text: string) -> i64 {
        var code: u64 = 5381;
        var i: i32 = 0;
        while (i < text.len) { code = code * 33 + text.charAt(i) as u64; i = i + 1; }
        return (code & 9223372036854775807) as i64;
    }

    public fn get(key: string) -> i64 {
        var slot = BuildSourceMap.hash(key) % self.slots.len;
        var id = self.slots.get(slot);
        while (id >= 0) {
            let candidate = self.keys.get_ptr(id);
            if (candidate[0].text == key) { return candidate[0].value; }
            slot = (slot + 1) % self.slots.len;
            id = self.slots.get(slot);
        }
        return -1;
    }

    public fn contains(key: string) -> bool { return self.get(key) >= 0; }

    public fn put(key: string, value: i64) {
        if ((self.keys.len + 1) * 2 >= self.slots.len) {
            let count = self.slots.len * 2 + 1;
            var next = Vec::<i64>.with_capacity(count);
            var i: i64 = 0;
            while (i < count) { next.push(-1); i = i + 1; }
            i = 0;
            while (i < self.keys.len) {
                let item = self.keys.get_ptr(i);
                var slot = BuildSourceMap.hash(item[0].text) % count;
                while (next.get(slot) >= 0) { slot = (slot + 1) % count; }
                next.set(slot, i);
                i = i + 1;
            }
            self.slots.destroy();
            self.slots = next;
        }
        var slot = BuildSourceMap.hash(key) % self.slots.len;
        var id = self.slots.get(slot);
        while (id >= 0) {
            var candidate = self.keys.get_ptr(id);
            if (candidate[0].text == key) { candidate[0].value = value; return; }
            slot = (slot + 1) % self.slots.len;
            id = self.slots.get(slot);
        }
        self.slots.set(slot, self.keys.len);
        self.keys.push(BuildSourceKey { text: key, value: value });
    }

    public fn destroy() { self.keys.destroy(); self.slots.destroy(); }
}

public class BuildSourceIndex {
    public rows: Vec<BuildSourceRecord>;
    public paths: BuildSourceMap;
    public modules: BuildSourceMap;
    public group_ids: BuildSourceMap;
    public groups: Vec<BuildSourceGroup>;

    public static fn create(capacity: i64) -> BuildSourceIndex {
        return BuildSourceIndex {
            rows: Vec::<BuildSourceRecord>.with_capacity(capacity),
            paths: BuildSourceMap.create(capacity),
            modules: BuildSourceMap.create(capacity),
            group_ids: BuildSourceMap.create(capacity),
            groups: Vec::<BuildSourceGroup>.with_capacity(capacity)
        };
    }

    public fn add(path: string, module_name: string, group_key: string, imports: string) {
        if (self.paths.contains(path)) { return; }
        let id = self.rows.len;
        self.paths.put(path, id);
        if (module_name.len > 0 && !self.modules.contains(module_name)) {
            self.modules.put(module_name, id);
        }
        if (!self.group_ids.contains(group_key)) {
            self.group_ids.put(group_key, self.groups.len);
            self.groups.push(BuildSourceGroup { paths: "" });
        }
        var group = self.groups.get_ptr(self.group_ids.get(group_key));
        group[0].paths = group[0].paths + path + "\n";
        self.rows.push(BuildSourceRecord { path: path, module_name: module_name,
            group_key: group_key, imports: imports, interface_stamp: "", stamp_ready: false });
    }

    public fn source_id(path: string) -> i64 {
        if (!self.paths.contains(path)) { return -1; }
        return self.paths.get(path);
    }

    public fn module_id(name: string) -> i64 {
        if (name.len == 0) { return -1; }
        if (self.modules.contains(name)) { return self.modules.get(name); }
        var end: i32 = name.len as i32 - 1;
        while (end > 0) {
            // Empty final member (`Module.`) is not a legal prefix lookup.
            if (name.charAt(end) == 46 && end + 1 < name.len) {
                let prefix = name.substring(0, end);
                if (self.modules.contains(prefix)) { return self.modules.get(prefix); }
            }
            end = end - 1;
        }
        return -1;
    }

    public fn sources_for_group(key: string) -> string {
        if (!self.group_ids.contains(key)) { return ""; }
        let group = self.groups.get_ptr(self.group_ids.get(key));
        return group[0].paths;
    }

    public fn destroy() {
        self.rows.destroy();
        self.paths.destroy();
        self.modules.destroy();
        self.group_ids.destroy();
        self.groups.destroy();
    }
}
