module bootstrap.build_sets;

use std.clone;
use std.collections;
use std.string;

// Pipe-delimited planner sets keep their original order and spelling. These
// helpers borrow their inputs; only an actual result needs owned storage.
// Multi-token membership (value containing '|') retains the original wrapped
// substring contract, including leading/trailing empty tokens, without copying
// either full string to synthesize sentinels.
public fn build_pipe_set_has(set: string, value: string) -> bool {
    if (value.len == 0) { return false; }
    var start: i32 = 0;
    while (start <= set.len) {
        if (value.len <= set.len - start) {
            let end = start + value.len;
            if (end == set.len || set.charAt(end) == 124) {
                var same = true;
                var i: i32 = 0;
                while (i < value.len) {
                    if (set.charAt(start + i) != value.charAt(i)) { same = false; break; }
                    i = i + 1;
                }
                if (same) { return true; }
            }
        }
        while (start < set.len && set.charAt(start) != 124) { start = start + 1; }
        if (start == set.len) { break; }
        start = start + 1;
    }
    return false;
}

public fn build_pipe_set_add(set: string, value: string) -> string {
    let v = value.trim();
    if (v.len == 0 || build_pipe_set_has(set, v)) { return set; }
    if (set.len == 0) { return v; }
    var out = StringBuilder.withCapacity((set.len as i64) + (v.len as i64) + 2);
    out.append(set);
    out.append("|");
    out.append(v);
    var owned = out.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    out.destroy();
    return result;
}

fn build_set_token_bound(text: string) -> i64 {
    var count: i64 = 1;
    var i: i32 = 0;
    while (i < text.len) {
        if (text.charAt(i) == 124) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn build_set_span_hash(text: string, start: i32, end: i32) -> i64 {
    var hash: i64 = 5381;
    var i = start;
    while (i < end) {
        hash = (hash * 33 + (text.charAt(i) as i64)) % 2147483647;
        i = i + 1;
    }
    return hash;
}

// Each slot stores source (0 empty, 1 set, 2 items), start and end. Entries
// refer only to the two immutable input strings, never the growing builder.
// Hashes select a probe chain; every candidate compares exact token bytes.
fn build_set_insert(index: &mut Vec<i64>, set: string, items: string,
                    source: i64, start: i32, end: i32) -> bool {
    var text = set;
    if (source == 2) { text = items; }
    let slots = index.len / 3;
    var slot = build_set_span_hash(text, start, end) % slots;
    while (true) {
        let base = slot * 3;
        let stored_source = index.get(base);
        if (stored_source == 0) {
            index.set(base, source);
            index.set(base + 1, start as i64);
            index.set(base + 2, end as i64);
            return true;
        }
        let stored_start = index.get(base + 1) as i32;
        let stored_end = index.get(base + 2) as i32;
        if (stored_end - stored_start == end - start) {
            var stored_text = set;
            if (stored_source == 2) { stored_text = items; }
            var same = true;
            var i: i32 = 0;
            while (i < end - start) {
                if (stored_text.charAt(stored_start + i) != text.charAt(start + i)) {
                    same = false;
                    break;
                }
                i = i + 1;
            }
            if (same) { return false; }
        }
        slot = slot + 1;
        if (slot == slots) { slot = 0; }
    }
    return false;
}

public fn build_pipe_set_merge(set: string, items: string) -> string {
    if (items.len == 0) { return set; }
    // At most this many spans can be inserted, so a half-full table always
    // terminates probing. Capacity arithmetic is i64, independent of string's
    // i32 byte offsets. Allocation failure follows Vec's ordinary diagnostic.
    let bound = build_set_token_bound(set) + build_set_token_bound(items);
    var slots: i64 = 4;
    while (slots < bound * 2) { slots = slots * 2; }
    var index = Vec::<i64>.zeroed(slots * 3);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= set.len) {
        if (i == set.len || set.charAt(i) == 124) {
            if (i > start) { build_set_insert(&mut index, set, items, 1, start, i); }
            start = i + 1;
        }
        i = i + 1;
    }
    var out = StringBuilder.withCapacity((set.len as i64) + (items.len as i64) + 2);
    out.append(set);
    start = 0;
    i = 0;
    while (i <= items.len) {
        if (i == items.len || items.charAt(i) == 124) {
            if (i > start) {
                let token = items.substring(start, i);
                let value = token.trim();
                if (value.len > 0) {
                    // Use the standard trim contract, then locate that exact
                    // view in the input token. No duplicate trim/locale rule.
                    let first = start + token.indexOf(value);
                    let last = first + value.len;
                    if (build_set_insert(&mut index, set, items, 2, first, last)) {
                        if (out.length() > 0) { out.append("|"); }
                        out.append(value);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    index.destroy();
    var owned = out.intoString();
    let result = owned.raw().clone();
    owned.destroy();
    out.destroy();
    return result;
}
