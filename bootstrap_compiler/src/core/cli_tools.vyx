module bootstrap.cli_tools;

use std.fs;
use std.string;
use bootstrap.ast;
use bootstrap.lexer;

extern "C" {
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_bootstrap_platform() -> i32;
    fn vyx_bootstrap_process_spawn(command: rawptr,
                                   cwd: rawptr,
                                   stdout_path: rawptr,
                                   stderr_path: rawptr,
                                   env_name: rawptr,
                                   env_value: rawptr) -> i64;
    fn vyx_bootstrap_process_wait(id: i64) -> i32;
    fn vyx_bootstrap_process_close(id: i64);
    fn vyx_bootstrap_mkdir_p(path: rawptr) -> i32;
    fn vyx_bootstrap_list_vyx_deps(root: rawptr, out_path: rawptr) -> i32;
    fn vyx_string_contains(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
}

fn ct_is_windows() -> bool {
    return vyx_bootstrap_platform() == 1;
}

fn ct_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    return vyx_string_contains(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

fn ct_posix(path: string) -> string {
    return path.replace("\\", "/");
}

fn ct_join(dir: string, rel: string) -> string {
    if (dir.len == 0 || dir == ".") { return rel; }
    if (dir.endsWith("/") || dir.endsWith("\\")) { return dir + rel; }
    if (ct_is_windows()) { return dir + "\\" + rel; }
    return dir + "/" + rel;
}

fn ct_quote(arg: string) -> string {
    var out = "\"";
    var i: i32 = 0;
    while (i < arg.len) {
        if (arg.charAt(i) == 34) {
            out = out + "\\\"";
        } else {
            out = out + arg.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn ct_basename(path: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { start = i + 1; }
        i = i + 1;
    }
    return path.substring(start, path.len);
}

fn ct_stem(path: string) -> string {
    let base = ct_basename(path);
    var dot: i32 = base.len as i32;
    var i: i32 = 0;
    while (i < base.len) {
        if (base.charAt(i) == 46) { dot = i; }
        i = i + 1;
    }
    if (dot <= 0) { return base; }
    return base.substring(0, dot);
}

fn ct_safe_name(path: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if (ok) {
            out = out + path.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { return "item"; }
    return out;
}

fn ct_append_line(acc: string, line: string) -> string {
    let t = line.trim();
    if (t.len == 0) { return acc; }
    if (acc.len == 0) { return t; }
    return acc + "\n" + t;
}

fn ct_line_count(rows: string) -> i32 {
    if (rows.len == 0) { return 0; }
    var n: i32 = 1;
    var i: i32 = 0;
    while (i < rows.len) {
        if (rows.charAt(i) == 10) { n = n + 1; }
        i = i + 1;
    }
    if (rows.endsWith("\n")) { n = n - 1; }
    return n;
}

fn ct_line_at(rows: string, want: i32) -> string {
    var idx: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (idx == want) {
                var line = rows.substring(start, i);
                if (line.endsWith("\r")) {
                    line = line.substring(0, line.len - 1);
                }
                return line.trim();
            }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn ct_normalize_nl(text: string) -> string {
    return text.replace("\r\n", "\n").replace("\r", "\n");
}

fn ct_skip_path(path: string) -> bool {
    let p = "/" + ct_posix(path) + "/";
    if (ct_contains(p, "/.cache/")) { return true; }
    if (ct_contains(p, "/target/")) { return true; }
    if (ct_contains(p, "/.git/")) { return true; }
    if (ct_contains(p, "/out/")) { return true; }
    if (ct_contains(p, "/build/")) { return true; }
    if (ct_contains(p, "/snapshots/")) { return true; }
    return false;
}

fn ct_mkdir(path: string) -> i32 {
    if (path.len == 0 || path == ".") { return 0; }
    return vyx_bootstrap_mkdir_p(path.c_str());
}

fn ct_cache_dir() -> string {
    let dir = ".cache/vyxc-cli";
    ct_mkdir(".cache");
    ct_mkdir(dir);
    return dir;
}

fn ct_list_vyx(root: string) -> string {
    if (root.len == 0 || !isDir(root)) { return ""; }
    let tmp = ct_join(ct_cache_dir(), "deps.tmp");
    writeFile(tmp.clone(), "");
    vyx_bootstrap_list_vyx_deps(root.c_str(), tmp.clone().c_str());
    let raw = readFile(tmp);
    var out: string = "";
    var n = ct_line_count(raw.clone());
    var i: i32 = 0;
    while (i < n) {
        let path = ct_line_at(raw.clone(), i);
        if (path.len > 0 && path.endsWith(".vyx") && !ct_skip_path(path.clone())) {
            out = ct_append_line(out, path);
        }
        i = i + 1;
    }
    return out;
}

fn ct_self_exe() -> string {
    if (argCount() > 0) { return getArg(0); }
    return "vyxc";
}

fn ct_exe_suffix() -> string {
    if (ct_is_windows()) { return ".exe"; }
    return "";
}

fn ct_run_cmd(cmd: string, stdout_path: string, stderr_path: string) -> i32 {
    let pid = vyx_bootstrap_process_spawn(cmd.c_str(),
                                          "".c_str(),
                                          stdout_path.c_str(),
                                          stderr_path.c_str(),
                                          "".c_str(),
                                          "".c_str());
    if (pid == 0) { return -1; }
    let rc = vyx_bootstrap_process_wait(pid);
    vyx_bootstrap_process_close(pid);
    return rc;
}

fn ct_print_file(path: string) {
    let text = readFile(path);
    if (text.len == 0) { return; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text.charAt(i) == 10) {
            var line = text.substring(start, i);
            if (line.endsWith("\r")) {
                line = line.substring(0, line.len - 1);
            }
            print(line);
            start = i + 1;
        }
        i = i + 1;
    }
}

fn ct_wants_help() -> bool {
    var i: i32 = 2;
    while (i < argCount()) {
        let a = getArg(i);
        if (a == "-h" || a == "--help") { return true; }
        i = i + 1;
    }
    return false;
}

class CliToolArgs {
    public filter: string
    public out_dir: string
    public check: bool
    public paths: string
}

fn ct_parse_args() -> CliToolArgs {
    var args = CliToolArgs {
        filter: "",
        out_dir: "",
        check: false,
        paths: ""
    };
    var i: i32 = 2;
    while (i < argCount()) {
        let a = getArg(i);
        if (a == "-h" || a == "--help") {
        } elif (a == "--check") {
            args.check = true;
        } elif (a == "--filter" && i + 1 < argCount()) {
            i = i + 1;
            args.filter = getArg(i);
        } elif (a.startsWith("--filter=")) {
            args.filter = a.substring(9, a.len);
        } elif (a == "--out" && i + 1 < argCount()) {
            i = i + 1;
            args.out_dir = getArg(i);
        } elif (a.startsWith("--out=")) {
            args.out_dir = a.substring(6, a.len);
        } elif (a.startsWith("-")) {
            print("error: unknown option `" + a + "`");
        } else {
            args.paths = ct_append_line(args.paths, a);
        }
        i = i + 1;
    }
    return args;
}

fn ct_collect_paths(explicit: string, default_dir: string) -> string {
    var out: string = "";
    if (explicit.len > 0) {
        var n = ct_line_count(explicit.clone());
        var i: i32 = 0;
        while (i < n) {
            let p = ct_line_at(explicit.clone(), i);
            if (p.endsWith(".vyx") && fileExists(p.clone())) {
                out = ct_append_line(out, p);
            } elif (isDir(p.clone())) {
                out = ct_append_line(out, ct_list_vyx(p));
            } elif (fileExists(p.clone())) {
                out = ct_append_line(out, p);
            } else {
                print("error: path not found: " + p);
            }
            i = i + 1;
        }
        return out;
    }
    if (isDir(default_dir)) {
        return ct_list_vyx(default_dir);
    }
    return "";
}

fn ct_is_modifier(lex: string) -> bool {
    return lex == "public" || lex == "private" || lex == "internal"
        || lex == "protected" || lex == "static" || lex == "unsafe"
        || lex == "override" || lex == "async";
}

fn ct_attr_len(handle: rawptr, i: i32) -> i32 {
    let t0 = lex_token_at(handle, i);
    if (t0 == null || token_kind(t0) != tk_AT()) { return 0; }
    let t1 = lex_token_at(handle, i + 1);
    if (t1 == null) { return 0; }
    if (token_kind(t1) == tk_LBRACKET()) {
        var j: i32 = i + 2;
        var depth: i32 = 1;
        while (depth > 0) {
            let t = lex_token_at(handle, j);
            if (t == null) { return 0; }
            let k = token_kind(t);
            if (k == tk_LBRACKET()) { depth = depth + 1; }
            elif (k == tk_RBRACKET()) { depth = depth - 1; }
            elif (k == tk_EOF()) { return 0; }
            j = j + 1;
        }
        return j - i;
    }
    if (token_kind(t1) == tk_IDENT()) { return 2; }
    return 1;
}

fn ct_attr_is_kind(handle: rawptr, i: i32, want: string) -> bool {
    let n = ct_attr_len(handle, i);
    if (n <= 0) { return false; }
    var j: i32 = 0;
    while (j < n) {
        let t = lex_token_at(handle, i + j);
        if (t != null && token_lexeme(t) == want) { return true; }
        j = j + 1;
    }
    return false;
}

class FileFns {
    public has_main: bool
    public tests: string
    public benches: string
    public ok: bool
}

fn ct_scan_file_fns(src: string) -> FileFns {
    var out = FileFns { has_main: false, tests: "", benches: "", ok: false };
    let handle = lex_source(src);
    if (handle == null) { return out; }
    if (lex_error_count(handle) > 0) { return out; }
    out.ok = true;
    var depth: i32 = 0;
    var pending_test = false;
    var pending_bench = false;
    var i: i32 = 0;
    let n = lex_token_count(handle);
    while (i < n) {
        let tok = lex_token_at(handle, i);
        if (tok == null) { break; }
        let kind = token_kind(tok);
        if (kind == tk_EOF()) { break; }
        if (kind == tk_AT() && depth == 0) {
            if (ct_attr_is_kind(handle, i, "test")) { pending_test = true; }
            if (ct_attr_is_kind(handle, i, "bench")) { pending_bench = true; }
            let skip = ct_attr_len(handle, i);
            if (skip > 0) {
                i = i + skip;
                continue;
            }
        }
        if (kind == tk_LBRACE()) { depth = depth + 1; }
        if (kind == tk_RBRACE()) {
            depth = depth - 1;
            if (depth < 0) { depth = 0; }
            pending_test = false;
            pending_bench = false;
        }
        if (depth == 0 && kind == tk_KEYWORD_FN()) {
            var j = i + 1;
            while (j < n) {
                let t2 = lex_token_at(handle, j);
                if (t2 == null) { break; }
                if (ct_is_modifier(token_lexeme(t2))) {
                    j = j + 1;
                    continue;
                }
                break;
            }
            let name_tok = lex_token_at(handle, j);
            if (name_tok != null && token_kind(name_tok) == tk_IDENT()) {
                let name = token_lexeme(name_tok);
                if (name == "main") { out.has_main = true; }
                if (pending_test) { out.tests = ct_append_line(out.tests, name); }
                if (pending_bench) { out.benches = ct_append_line(out.benches, name); }
            }
            pending_test = false;
            pending_bench = false;
        }
        i = i + 1;
    }
    return out;
}

fn ct_filter_names(names: string, filter: string) -> string {
    if (filter.len == 0) { return names; }
    var out: string = "";
    var n = ct_line_count(names.clone());
    var i: i32 = 0;
    while (i < n) {
        let name = ct_line_at(names.clone(), i);
        if (ct_contains(name.clone(), filter.clone()) || ct_contains(filter.clone(), name.clone())) {
            out = ct_append_line(out, name);
        }
        i = i + 1;
    }
    return out;
}

fn ct_file_matches(path: string, names: string, filter: string) -> bool {
    if (filter.len == 0) { return true; }
    if (ct_contains(ct_posix(path), filter.clone())) { return true; }
    return ct_filter_names(names, filter).len > 0;
}

fn ct_write_harness(orig: string, names: string, kind: string) -> string {
    var body = orig;
    if (!body.endsWith("\n")) { body = body + "\n"; }
    body = body + "\nfn main() -> i32 {\n";
    body = body + "    var fails: i32 = 0;\n";
    var n = ct_line_count(names.clone());
    var i: i32 = 0;
    while (i < n) {
        let name = ct_line_at(names.clone(), i);
        body = body + "    print(\"" + kind + " " + name + " ...\");\n";
        body = body + "    if (" + name + "() != 0) {\n";
        body = body + "        print(\"FAILED\");\n";
        body = body + "        fails = fails + 1;\n";
        body = body + "    } else {\n";
        body = body + "        print(\"ok\");\n";
        body = body + "    }\n";
        i = i + 1;
    }
    body = body + "    if (fails == 0) {\n";
    body = body + "        print(\"" + kind + " result: ok\");\n";
    body = body + "    } else {\n";
    body = body + "        print(\"" + kind + " result: FAILED\");\n";
    body = body + "    }\n";
    body = body + "    return fails;\n";
    body = body + "}\n";
    let named = ct_join(ct_cache_dir(), ct_safe_name(kind + "_" + ct_line_at(names.clone(), 0)) + "_harness.vyx");
    writeFile(named.clone(), body);
    return named;
}

fn ct_compile_run(src: string, label: string, time_it: bool) -> i32 {
    let out_exe = ct_join(ct_cache_dir(), ct_safe_name(label) + ct_exe_suffix());
    let log = out_exe + ".log";
    let cmd = ct_quote(ct_self_exe())
            + " --src=file " + ct_quote(src)
            + " --emit=exe -o " + ct_quote(out_exe);
    let crc = ct_run_cmd(cmd, log.clone(), log.clone());
    if (crc != 0) {
        print("error: compile failed: " + src + " (exit " + crc.toString() + ")");
        ct_print_file(log);
        return 1;
    }
    let start = vyx_bootstrap_now_ms();
    let rrc = ct_run_cmd(ct_quote(out_exe), "", "");
    let elapsed = vyx_bootstrap_now_ms() - start;
    if (time_it) {
        print(label + ": " + elapsed.toString() + " ms");
    }
    if (rrc != 0) {
        print("error: " + label + " exited " + rrc.toString());
        return 1;
    }
    return 0;
}

fn ct_run_kind(kind: string, default_dir: string, attr_tests: bool) -> i32 {
    if (ct_wants_help()) {
        let prog = ct_self_exe();
        if (kind == "test") {
            print("Usage: " + prog + " test [--filter <substr>] [path...]");
            print("  Discover @[test] functions under tests/ (or given paths),");
            print("  compile each file with this compiler, and run the executable.");
        } else {
            print("Usage: " + prog + " bench [--filter <substr>] [path...]");
            print("  Discover @[bench] functions under benches/ (or given paths),");
            print("  compile, run, and print wall-clock milliseconds.");
        }
        return 0;
    }
    let args = ct_parse_args();
    let files = ct_collect_paths(args.paths, default_dir);
    var passed: i32 = 0;
    var failed: i32 = 0;
    var ran: i32 = 0;
    var fi: i32 = 0;
    let nfiles = ct_line_count(files.clone());
    while (fi < nfiles) {
        let path = ct_line_at(files.clone(), fi);
        fi = fi + 1;
        if (path.len == 0) { continue; }
        let src = readFile(path.clone());
        let scan = ct_scan_file_fns(src.clone());
        if (!scan.ok) {
            print("error: lex failed: " + path);
            failed = failed + 1;
            continue;
        }
        var names = scan.tests;
        if (!attr_tests) { names = scan.benches; }
        if (names.len == 0) { continue; }
        if (!ct_file_matches(path.clone(), names.clone(), args.filter.clone())) { continue; }
        if (args.filter.len > 0 && !ct_contains(ct_posix(path.clone()), args.filter.clone())) {
            names = ct_filter_names(names.clone(), args.filter.clone());
            if (names.len == 0) { continue; }
        }
        var compile_src = path;
        if (!scan.has_main) {
            compile_src = ct_write_harness(src, names, kind);
        }
        print(kind + " " + path);
        ran = ran + 1;
        let rc = ct_compile_run(compile_src, ct_posix(path.clone()), !attr_tests);
        if (rc == 0) {
            passed = passed + 1;
        } else {
            failed = failed + 1;
        }
    }
    if (ran == 0) {
        print("no " + kind + "s to run");
        return 0;
    }
    if (failed == 0) {
        print(kind + " result: ok. " + passed.toString() + " passed");
        return 0;
    }
    print(kind + " result: FAILED. " + passed.toString() + " passed; " + failed.toString() + " failed");
    return 1;
}

fn ct_tight_after(prev: string) -> bool {
    return prev == "(" || prev == "[" || prev == "." || prev == "@"
        || prev == "::" || prev == "<" || prev == "#";
}

fn ct_tight_before(cur: string) -> bool {
    return cur == ")" || cur == "]" || cur == "," || cur == ";"
        || cur == "." || cur == "::";
}

fn ct_open_paren_after_name(prev: string, cur: string) -> bool {
    if (cur != "(" && cur != "[" && cur != "<") { return false; }
    if (prev.len == 0) { return false; }
    let c = prev.charAt(0);
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c == 95) { return true; }
    if (c >= 48 && c <= 57) { return true; }
    return false;
}

fn ct_format_source(src: string) -> string {
    let handle = lex_source(src);
    if (handle == null) { return ""; }
    if (lex_error_count(handle) > 0) { return ""; }
    var out: string = "";
    var indent: i32 = 0;
    var prev: string = "";
    var at_line_start = true;
    var i: i32 = 0;
    let n = lex_token_count(handle);
    while (i < n) {
        let tok = lex_token_at(handle, i);
        i = i + 1;
        if (tok == null) { break; }
        if (token_kind(tok) == tk_EOF()) { break; }
        let lex = token_lexeme(tok);
        if (lex.len == 0) { continue; }
        let doc = token_doc_comment(tok);
        if (doc.len > 0) {
            if (!at_line_start) {
                out = out + "\n";
            }
            var ds: i32 = 0;
            var dstart: i32 = 0;
            while (ds <= doc.len) {
                if (ds == doc.len || doc.charAt(ds) == 10) {
                    var dline = doc.substring(dstart, ds);
                    if (dline.endsWith("\r")) {
                        dline = dline.substring(0, dline.len - 1);
                    }
                    var pad: i32 = 0;
                    while (pad < indent) {
                        out = out + "    ";
                        pad = pad + 1;
                    }
                    out = out + "/// " + dline + "\n";
                    dstart = ds + 1;
                }
                ds = ds + 1;
            }
            at_line_start = true;
            prev = "";
        }
        if (lex == "}" && indent > 0) { indent = indent - 1; }
        var nl = false;
        if (prev == ";" || prev == "{") { nl = true; }
        if (prev == "}" && lex != "else" && lex != "elif" && lex != "," && lex != ")" && lex != ";") {
            nl = true;
        }
        if (nl) {
            out = out + "\n";
            var pad2: i32 = 0;
            while (pad2 < indent) {
                out = out + "    ";
                pad2 = pad2 + 1;
            }
            at_line_start = true;
        } elif (!at_line_start && prev.len > 0) {
            var space = true;
            if (ct_tight_after(prev) || ct_tight_before(lex) || ct_open_paren_after_name(prev, lex)) {
                space = false;
            }
            if (prev == "->" || lex == "->") { space = true; }
            if (space) { out = out + " "; }
        }
        out = out + lex;
        at_line_start = false;
        prev = lex;
        if (lex == "{") { indent = indent + 1; }
    }
    if (out.len > 0 && !out.endsWith("\n")) { out = out + "\n"; }
    return out;
}

fn ct_format_one(path: string, check: bool) -> i32 {
    if (!fileExists(path.clone())) {
        print("error: path not found: " + path);
        return 1;
    }
    let orig = readFile(path.clone());
    let formatted = ct_format_source(orig.clone());
    if (formatted.len == 0 && orig.trim().len > 0) {
        print("error: fmt: lex failed: " + path);
        return 1;
    }
    let a = ct_normalize_nl(orig);
    let b = ct_normalize_nl(formatted);
    if (a == b) {
        if (!check) { print("ok " + path); }
        return 0;
    }
    if (check) {
        print("would reformat: " + path);
        return 1;
    }
    if (writeFile(path.clone(), formatted) != 0) {
        print("error: cannot write " + path);
        return 1;
    }
    print("reformatted " + path);
    return 0;
}

fn ct_doc_scan(src: string) -> string {
    let handle = lex_source(src);
    if (handle == null) { return ""; }
    if (lex_error_count(handle) > 0) { return ""; }
    var md: string = "";
    var depth: i32 = 0;
    var pending_doc: string = "";
    var i: i32 = 0;
    let n = lex_token_count(handle);
    while (i < n) {
        let tok = lex_token_at(handle, i);
        if (tok == null) { break; }
        let kind = token_kind(tok);
        if (kind == tk_EOF()) { break; }
        if (kind == tk_LBRACE()) { depth = depth + 1; }
        if (kind == tk_RBRACE()) {
            depth = depth - 1;
            if (depth < 0) { depth = 0; }
        }
        let doc = token_doc_comment(tok);
        if (doc.len > 0) { pending_doc = doc; }
        var decl_kind: string = "";
        if (kind == tk_KEYWORD_FN()) { decl_kind = "fn"; }
        elif (kind == tk_KEYWORD_CLASS()) { decl_kind = "class"; }
        elif (kind == tk_KEYWORD_STRUCT()) { decl_kind = "struct"; }
        elif (kind == tk_KEYWORD_INTERFACE()) { decl_kind = "interface"; }
        elif (kind == tk_KEYWORD_ENUM()) { decl_kind = "enum"; }
        if (decl_kind.len > 0 && depth == 0 && pending_doc.len > 0) {
            var j = i + 1;
            while (j < n) {
                let t2 = lex_token_at(handle, j);
                if (t2 == null) { break; }
                if (ct_is_modifier(token_lexeme(t2))) {
                    j = j + 1;
                    continue;
                }
                break;
            }
            let name_tok = lex_token_at(handle, j);
            var name = "";
            if (name_tok != null && token_kind(name_tok) == tk_IDENT()) {
                name = token_lexeme(name_tok);
            }
            if (name.len > 0) {
                md = md + "## `" + decl_kind + " " + name + "`\n\n";
                md = md + pending_doc + "\n\n";
                pending_doc = "";
            }
        }
        i = i + 1;
    }
    return md;
}

public fn cli_tools_test_main() -> i32 {
    return ct_run_kind("test", "tests", true);
}

public fn cli_tools_bench_main() -> i32 {
    return ct_run_kind("bench", "benches", false);
}

public fn cli_tools_fmt_main() -> i32 {
    if (ct_wants_help()) {
        print("Usage: " + ct_self_exe() + " fmt [--check] [path...]");
        print("  Token-reprint .vyx files. // and /* */ comments are dropped;");
        print("  /// doc comments are kept. Not a second language / rustfmt clone.");
        return 0;
    }
    let args = ct_parse_args();
    var files = ct_collect_paths(args.paths, "src");
    if (files.len == 0) {
        print("error: fmt: pass a path or run inside a package with src/");
        return 1;
    }
    var dirty: i32 = 0;
    var n = ct_line_count(files.clone());
    var i: i32 = 0;
    while (i < n) {
        let path = ct_line_at(files.clone(), i);
        if (ct_format_one(path, args.check) != 0) { dirty = dirty + 1; }
        i = i + 1;
    }
    if (args.check && dirty > 0) { return 1; }
    if (dirty > 0 && !args.check) { return 1; }
    return 0;
}

public fn cli_tools_doc_main() -> i32 {
    if (ct_wants_help()) {
        print("Usage: " + ct_self_exe() + " doc [--out <dir>] [path...]");
        print("  Emit markdown from /// comments attached to fn/class/struct/interface/enum.");
        return 0;
    }
    let args = ct_parse_args();
    var files = ct_collect_paths(args.paths, "src");
    if (files.len == 0) {
        print("error: doc: pass a path or run inside a package with src/");
        return 1;
    }
    if (args.out_dir.len > 0) { ct_mkdir(args.out_dir.clone()); }
    var n = ct_line_count(files.clone());
    var i: i32 = 0;
    var any: i32 = 0;
    while (i < n) {
        let path = ct_line_at(files.clone(), i);
        i = i + 1;
        let src = readFile(path.clone());
        let body = ct_doc_scan(src);
        if (body.len == 0) { continue; }
        any = any + 1;
        let md = "# " + ct_posix(path.clone()) + "\n\n" + body;
        if (args.out_dir.len > 0) {
            let dest = ct_join(args.out_dir.clone(), ct_safe_name(ct_posix(path.clone())) + ".md");
            if (writeFile(dest.clone(), md) != 0) {
                print("error: cannot write " + dest);
                return 1;
            }
            print("wrote " + dest);
        } else {
            print(md);
        }
    }
    if (any == 0) {
        print("no /// docs found");
        return 0;
    }
    return 0;
}
