module bootstrap.parser;

use std.clone;
use std.string;
use bootstrap.ast;
use bootstrap.diag;
use bootstrap.lexer;
use bootstrap.policy;

/// Recursive-descent parser for the current full self-host bootstrap surface.
/// Older notes used a min-subset label, but the self-host tree now tracks the
/// full-language bootstrap route; live coverage is documented in
/// `docs/设计文档_ZH.md` and `docs/TESTING_GUIDE.md`.
///
/// All AST nodes (Expr / Stmt / Decl / Unit / TypeRef) live as
/// `malloc`'d byte structs declared in `bootstrap.ast`; the parser only
/// ever sees them as opaque `rawptr` and routes every read/write
/// through the `<node>_get_<field>` / `<node>_set_<field>` accessors.
/// This avoids the host vyxc class-by-value bug that previously
/// invalidated AST chains the moment a parse helper returned (see
/// `docs/设计文档_ZH.md` class/object semantics).
///
/// `Parser` itself is still a Vyx class — it is created as a local
/// inside `parse_unit` and only ever consumed via `self.method(…)`,
/// which the host preserves correctly. The parser DOES NOT receive a
/// caller-allocated Unit; instead `parse_unit` builds the Unit in its
/// own scope from `self.decls_head` after `run()` returns.
///
/// Token-stream contract (from `bootstrap.lexer`):
///   * `lex_token_count(handle)` — total tokens (cached as `total`).
///   * `lex_token_at(handle, idx)` — slot rawptr, null past end.
///   * `token_kind / token_lexeme / token_line / token_col(slot)` —
///     pure read-only accessors. `token_kind(null)` returns `TK_EOF`,
///     so an off-the-end cursor naturally terminates parsing.
///
/// Coverage map (one row per locked syntax point):
///
///   Decls   — module path, use path, extern "C" { fn … }, class C { … },
///             [public] [static] fn name(ps) -> T { body }
///   Stmts   — let / var (typed or inferred), if-elif-else cascade,
///             while, break, continue, return [expr], block { … },
///             expression statement
///   Exprs   — int / string / bool / null / ident literals, parenthesized
///             group, &x address-of, ! / - unary, postfix call f(a,b),
///             member a.b, index a[i], assignment a = v, logical && / ||,
///             equality == / !=, relational < <= > >=, additive + -,
///             multiplicative * /
///
/// Argument lists / parameter lists / class-member lists / block-stmt
/// lists / top-level decl lists are encoded as singly-linked chains
/// using the existing `next` slots on `Stmt` and `Decl`. Call args
/// reuse the `Stmt` cell pattern (`init = arg expr`, chained via
/// `next`).
///
/// Public API surface (ABI-stable for `main.vyx`):
///   * parse_unit(lex_handle: rawptr) -> rawptr   — Unit-as-rawptr
///   * parser_error_count(state: rawptr) -> i32   — null-safe (returns 0)
///   * parser_dispose(state: rawptr) -> i32       — null-safe no-op

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: u64) -> i32;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strlen(s: rawptr) -> u64;
    fn vyx_string_contains(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
    fn vyx_string_starts_with(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
}

// ════════════════════════════════════════════════════════════════════
//   Pure helper — integer-literal lexeme to i64.
//
//   Lives outside the Parser class because it has no Parser state.
//   The bootstrap parser accepts decimal plus 0x/0o/0b integer forms here.
//   Underscore separators remain outside the current lexer surface.
// ════════════════════════════════════════════════════════════════════

public fn parse_int_literal(lex: string) -> i64 {
    let n: i64 = lex.len;
    if (n == 0) { return 0; }
    var i: i32 = 0;
    var neg: bool = false;
    if (lex.charAt(0) == 45) { neg = true; i = 1; }   // '-'
    // Handle 0x, 0o, 0b prefixes.
    if ((i as i64) + 2 <= n && lex.charAt(i) == 48) {
        let prefix = lex.charAt(i + 1);
        if (prefix == 120 || prefix == 88) {
            // 0x hex
            i = i + 2;
            var v: i64 = 0;
            while ((i as i64) < n) {
                let c = lex.charAt(i);
                if (c >= 48 && c <= 57) { v = v * 16 + (c - 48) as i64; }
                else if (c >= 97 && c <= 102) { v = v * 16 + (c - 87) as i64; }
                else if (c >= 65 && c <= 70) { v = v * 16 + (c - 55) as i64; }
                else { break; }
                i = i + 1;
            }
            if (neg) { v = 0 - v; }
            return v;
        }
        if (prefix == 111 || prefix == 79) {
            // 0o octal
            i = i + 2;
            var v: i64 = 0;
            while ((i as i64) < n) {
                let c = lex.charAt(i);
                if (c < 48 || c > 55) { break; }
                v = v * 8 + (c - 48) as i64;
                i = i + 1;
            }
            if (neg) { v = 0 - v; }
            return v;
        }
        if (prefix == 98 || prefix == 66) {
            // 0b binary
            i = i + 2;
            var v: i64 = 0;
            while ((i as i64) < n) {
                let c = lex.charAt(i);
                if (c != 48 && c != 49) { break; }
                v = v * 2 + (c - 48) as i64;
                i = i + 1;
            }
            if (neg) { v = 0 - v; }
            return v;
        }
    }
    var v: i64 = 0;
    while ((i as i64) < n) {
        let c = lex.charAt(i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48) as i64;
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return v;
}

// ════════════════════════════════════════════════════════════════════
//   Pure helper — char-literal lexeme to i64 codepoint.
//
//   Accepts the raw quoted lexeme as produced by the lexer
//   (e.g. `'a'`, `'\\n'`, `'\\\\'`). ASCII fast path only — multi-byte
//   UTF-8 char literals are outside the current bootstrap char-literal
//   surface; if the second
//   byte happens to be the leading byte of a UTF-8 sequence we still
//   return that byte's value, matching `LLVMConstInt(i32, …)` semantics
//   the host vyxc uses today.
// ════════════════════════════════════════════════════════════════════

fn parse_char_codepoint(lex: string) -> i64 {
    let n: i64 = lex.len;
    if (n < 2) { return 0; }
    var i: i32 = 0;
    if (lex.charAt(0) == 39) { i = 1; }   // strip leading single-quote if present
    if ((i as i64) >= n) { return 0; }
    let c = lex.charAt(i);
    if (c == 92) {                         // backslash escape
        if ((i as i64) + 1 >= n) { return 0; }
        let esc = lex.charAt(i + 1);
        if (esc == 110) { return 10; }     // \n
        if (esc == 116) { return 9; }      // \t
        if (esc == 114) { return 13; }     // \r
        if (esc == 48)  { return 0; }      // \0
        if (esc == 92)  { return 92; }     // \\
        if (esc == 39)  { return 39; }     // \'
        if (esc == 34)  { return 34; }     // \"
        if (esc == 97)  { return 7; }      // \a
        if (esc == 98)  { return 8; }      // \b
        if (esc == 102) { return 12; }     // \f
        if (esc == 118) { return 11; }     // \v
        return esc as i64;
    }
    return c as i64;
}

fn parser_string_contains(hay: string, needle: string) -> bool {
    return vyx_string_contains(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

    // ── Nested records ───────────────────────────────────────────────
    //
    //     struct FreqArray<T> {
    //         struct A<U> { pub a: U; }
    //         data: *T;
    //     }
    //
    // A nested record is *hoisted* to module scope under the dotted name
    // `FreqArray.A`.  Its parameter list is the parent's list followed by its
    // own, unless the two lists are identical — then the nested record simply
    // re-states the parent's parameters and adds none.
    //
    //     struct FreqArray<T> { struct A<T>   { … } }   FreqArray<i32>::A
    //     struct FreqArray<T> { struct A<U>   { … } }   FreqArray<i32>::A<f64>
    //     struct FreqArray<T> { struct A<T,V> { … } }   FreqArray<i32>::A<i32,f64>
    //     struct FreqArray<T> { struct A<K,V> { … } }   FreqArray<i32>::A<i64,f64>
    //
    // The use site always spells "arguments of the parent segment, then
    // arguments of the nested segment"; both the expression and the type path
    // parsers concatenate them in that order, which is why the declaration
    // side concatenates too (see `parser_merge_nested_generics`).
    //
    // Everything downstream already understands dotted record names and plain
    // multi-parameter generics, so no sema/mono/codegen change is needed.

    /// Effective parameter list of a nested record (see the block above).
    ///
    /// Either the nested record repeats the parent's parameter list verbatim
    /// (`struct A<T>` inside `struct FreqArray<T>`), in which case it *is* the
    /// parent's parameter — nothing is added and the use site needs no type
    /// arguments (`FreqArray<i32>::A`) — or its list is appended as written,
    /// even when a name repeats (`struct A<T,V>` inside `struct FreqArray<T>`
    /// yields `T,T,V`, so the use site must spell the whole list
    /// `FreqArray<i32>::A<i32,f64>`).  Names are deliberately *not* deduplicated
    /// by name after that: the use site merges its arguments by plain
    /// concatenation (parent segment's arguments, then the nested segment's),
    /// so a name-based declaration merge would leave the two sides disagreeing
    /// on the parameter count and silently bind the tail arguments to the
    /// wrong parameters.
    fn parser_merge_nested_generics(parent_generics: string, own_generics: string) -> string {
        if (own_generics.len == 0) { return parent_generics; }
        if (parent_generics.len == 0) { return own_generics; }
        if (own_generics == parent_generics) { return parent_generics; }
        return parent_generics + "," + own_generics;
    }

    /// Qualify a nested record name with its parent's name.
    fn parser_qualify_nested_name(parent_name: string, name: string) -> string {
        if (parent_name.len == 0) { return name; }
        if (name.len == 0) { return parent_name; }
        return parent_name + "." + name;
    }

    /// A constructor is written with the record's own source name; a hoisted
    /// nested record is stored under `Outer.Inner` while its body still says
    /// `Inner(…)`.
    fn parser_ctor_name_matches(candidate: string, owner_name: string) -> bool {
        if (candidate.len == 0 || owner_name.len == 0) { return false; }
        if (candidate == owner_name) { return true; }
        var i: i32 = (owner_name.len - 1) as i32;
        while (i >= 0) {
            if (owner_name.charAt(i) == 46) {
                return owner_name.substring(i + 1, owner_name.len as i32) == candidate;
            }
            i = i - 1;
        }
        return false;
    }

    /// Rewrite a path whose segments each may carry type arguments into the
    /// single flat spelling used for hoisted nested records:
    /// `FreqArray::<i32>.A::<f32>` -> `FreqArray.A::<i32,f32>`.
    /// Paths carrying no type arguments at all are returned untouched — those
    /// are ordinary member chains, not type paths.
    fn parser_canonical_type_path(name: string) -> string {
        if (name.len == 0) { return name; }
        var seen_args: bool = false;
        var i: i32 = 0;
        while (i < name.len as i32) {
            if (name.charAt(i) == 60) { seen_args = true; }
            i = i + 1;
        }
        if (!seen_args) { return name; }
        var flat: string = "";
        var all_args: string = "";
        var cur: string = "";
        var depth: i32 = 0;
        i = 0;
        var n: i32 = name.len as i32;
        while (i <= n) {
            var piece: string = "";
            if (i >= n) {
                piece = cur;
            } else {
                let ch = name.charAt(i);
                if (ch == 60) { depth = depth + 1; }
                if (ch == 62) { if (depth > 0) { depth = depth - 1; } }
                if (ch == 46 && depth == 0) {
                    piece = cur;
                    cur = "";
                } else {
                    cur = cur + str_view_range(name, i as i64, (i + 1) as i64);
                }
            }
            if (piece.len > 0) {
                let base = policy_generic_call_base(piece);
                let args = policy_generic_call_args(piece);
                if (flat.len > 0) { flat = flat + "."; }
                flat = flat + base;
                if (args.len > 0) {
                    if (all_args.len > 0) { all_args = all_args + ","; }
                    all_args = all_args + args;
                }
            }
            i = i + 1;
        }
        if (flat.len == 0 || all_args.len == 0) { return name; }
        return flat + "::<" + all_args + ">";
    }

    /// `struct` / `class` appearing *inside* another record body.  `is_pub`
    /// carries the visibility already consumed by the enclosing body loop.


fn parser_string_starts_with(s: string, prefix: string) -> bool {
    return vyx_string_starts_with(s.c_str(), s.len as u64, prefix.c_str(), prefix.len as u64) != 0;
}

fn parser_raw_string_has_interpolation(raw: string) -> bool {
    if (raw.len < 4) { return false; }
    var i: i64 = 0;
    while (i + 1 < raw.len) {
        if (raw.charAt(i as i32) == 92) { i = i + 2; continue; }
        if (raw.charAt(i as i32) == 36
            && raw.charAt((i + 1) as i32) == 123) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn parser_type_kind_from_primitive(prim: i32) -> i32 {
    if (prim == 1) { return ty_I8(); }
    if (prim == 2) { return ty_I16(); }
    if (prim == 3) { return ty_I32(); }
    if (prim == 4) { return ty_I64(); }
    if (prim == 5) { return ty_U8(); }
    if (prim == 6) { return ty_U16(); }
    if (prim == 7) { return ty_U32(); }
    if (prim == 8) { return ty_U64(); }
    if (prim == 9) { return ty_ISIZE(); }
    if (prim == 10) { return ty_USIZE(); }
    if (prim == 11) { return ty_BOOL(); }
    if (prim == 12) { return ty_CHAR(); }
    if (prim == 13) { return ty_STRING(); }
    if (prim == 14) { return ty_RAWPTR(); }
    if (prim == 15) { return ty_VOID(); }
    if (prim == 16) { return ty_F32(); }
    if (prim == 17) { return ty_F64(); }
    return ty_CLASS();
}

fn parser_impl_self_type(target_name: string) -> rawptr {
    let prim = policy_primitive_type_kind(target_name);
    let k = parser_type_kind_from_primitive(prim);
    if (k != ty_CLASS()) { return tref_alloc(k, ""); }
    return tref_alloc(ty_CLASS(), target_name.clone());
}

fn parser_self_receiver_marker(mode: string) -> string {
    return "|receiver:" + mode;
}

fn parser_mark_self_receiver(param: rawptr, mode: string) {
    if (param == null || decl_get_name(param) != "self") { return; }
    var markers = decl_get_generic_params(param);
    if (!parser_string_contains(markers, "|receiver:")) {
        markers = markers + parser_self_receiver_marker(mode);
        decl_set_generic_params(param, markers);
    }
}

fn parser_ensure_method_self_param(method_decl: rawptr, owner_name: string) {
    if (method_decl == null || owner_name.len == 0) { return; }
    if (decl_get_kind(method_decl) != de_METHOD() || decl_get_is_static(method_decl)) { return; }
    let first = decl_get_params(method_decl);
    if (first == null || decl_get_name(first) != "self") {
        let self_param = decl_alloc(de_FIELD(), "self");
        decl_set_ty(self_param, tref_alloc(ty_CLASS(), owner_name));
        parser_mark_self_receiver(self_param, "compat");
        decl_set_next(self_param, first);
        decl_set_params(method_decl, self_param);
        return;
    }
    parser_mark_self_receiver(first, "compat");
    let current_self_ty = decl_get_ty(first);
    if (current_self_ty == null || tref_get_kind(current_self_ty) == ty_RAWPTR()) {
        // Receiver mode is carried explicitly in the parameter markers. Keep
        // the semantic type as the owner itself so member lookup, generic
        // substitution and both MIR backends share one receiver ABI.
        // VYI `fn clone(self)` can arrive with a default rawptr slot.
        decl_set_ty(first, tref_alloc(ty_CLASS(), owner_name));
    }
}

fn parser_is_impl_target_token(kind: i32, lx: string) -> bool {
    if (kind == tk_IDENT() || kind == tk_KEYWORD_INTERFACE()) { return true; }
    return policy_primitive_type_kind(lx) != 0;
}

fn parser_mark_pack_fold(e: rawptr, suffix: string) -> bool {
    if (e == null || expr_get_kind(e) != ex_IDENT()) { return false; }
    let name = expr_get_name(e);
    if (!parser_string_contains(name, "...")) { return false; }
    if (parser_string_contains(name, "...+")
        || parser_string_contains(name, "...-")
        || parser_string_contains(name, "...*")
        || parser_string_contains(name, "...&&")
        || parser_string_contains(name, "...|")) {
        return true;
    }
    expr_set_name(e, name + suffix);
    return true;
}

fn parser_qual_hash(key: string, cap: i32) -> i32 {
    if (cap <= 0) { return 0; }
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < key.len) {
        h = ((h * 131) + (key.charAt(i) as i64) + 1) % (cap as i64);
        i = i + 1;
    }
    if (h < 0) { h = -h; }
    return h as i32;
}

fn parser_qual_create() -> rawptr {
    let cap: i32 = 1024;
    let map = malloc(16);
    if (map == null) { return null; }
    memset(map, 0, 16);
    let buckets = malloc((cap as u64) * 8);
    if (buckets == null) {
        free(map);
        return null;
    }
    memset(buckets, 0, (cap as u64) * 8);
    ast_write_rawptr(map, buckets);
    ast_write_i32(ptr_offset(map, 8), cap);
    ast_write_i32(ptr_offset(map, 12), 0);
    return map;
}

fn parser_qual_put(map: rawptr, key: string, val: string) -> rawptr {
    if (key.len == 0 || val.len == 0) { return map; }
    var out = map;
    if (out == null) { out = parser_qual_create(); }
    if (out == null) { return map; }
    let buckets = ast_read_rawptr(out);
    let cap = ast_read_i32(ptr_offset(out, 8));
    if (buckets == null || cap <= 0) { return out; }
    let slot = parser_qual_hash(key, cap);
    let slot_ptr = ptr_offset(buckets, (slot as i64) * 8);
    var cur = ast_read_rawptr(slot_ptr);
    while (cur != null) {
        let kp = ast_read_rawptr(cur);
        let kl = ast_read_i64(ptr_offset(cur, 8));
        if (kp != null && kl == key.len && memcmp(kp, key.c_str(), kl as u64) == 0) {
            let old_vp = ast_read_rawptr(ptr_offset(cur, 16));
            ast_write_rawptr(ptr_offset(cur, 16), ast_dup_c_string(val));
            if (old_vp != null) { free(old_vp); }
            return out;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = malloc(32);
    if (node == null) { return out; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(val));
    ast_write_rawptr(ptr_offset(node, 24), ast_read_rawptr(slot_ptr));
    ast_write_rawptr(slot_ptr, node);
    ast_write_i32(ptr_offset(out, 12), ast_read_i32(ptr_offset(out, 12)) + 1);
    return out;
}

fn parser_qual_dispose(map: rawptr) {
    if (map == null) { return; }
    let buckets = ast_read_rawptr(map);
    let cap = ast_read_i32(ptr_offset(map, 8));
    if (buckets != null && cap > 0) {
        var i: i32 = 0;
        while (i < cap) {
            var cur = ast_read_rawptr(ptr_offset(buckets, (i as i64) * 8));
            while (cur != null) {
                let next = ast_read_rawptr(ptr_offset(cur, 24));
                let kp = ast_read_rawptr(cur);
                let vp = ast_read_rawptr(ptr_offset(cur, 16));
                if (kp != null) { free(kp); }
                if (vp != null) { free(vp); }
                free(cur);
                cur = next;
            }
            i = i + 1;
        }
        free(buckets);
    }
    free(map);
}

fn parser_table_lookup(table: rawptr, name: string) -> string {
    if (table == null || name.len == 0) { return ""; }
    let buckets = ast_read_rawptr(table);
    let cap = ast_read_i32(ptr_offset(table, 8));
    if (buckets == null || cap <= 0) { return ""; }
    let slot = parser_qual_hash(name, cap);
    var cur = ast_read_rawptr(ptr_offset(buckets, (slot as i64) * 8));
    while (cur != null) {
        let kp = ast_read_rawptr(cur);
        let kl = ast_read_i64(ptr_offset(cur, 8));
        if (kp != null && kl == name.len && memcmp(kp, name.c_str(), kl as u64) == 0) {
            let vp = ast_read_rawptr(ptr_offset(cur, 16));
            if (vp == null) { return ""; }
            return from_cstr_view_len(vp, strlen(vp) as i64);
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return "";
}

fn parser_generic_base_end(name: string) -> i32 {
    var i: i32 = 0;
    while (i + 2 < name.len) {
        if (name.charAt(i) == 58
            && name.charAt(i + 1) == 58
            && name.charAt(i + 2) == 60) {
            return i;
        }
        i = i + 1;
    }
    return name.len as i32;
}

fn parser_rewrite_named_text(table: rawptr, name: string) -> string {
    let direct = parser_table_lookup(table, name);
    if (direct.len > 0) { return direct; }
    let base_end = parser_generic_base_end(name);
    if (base_end < name.len) {
        let base = str_view_range(name, 0, base_end);
        let mapped = parser_table_lookup(table, base);
        var out_base = base.clone();
        if (mapped.len > 0) {
            out_base = mapped.clone();
        }
        if (base_end + 3 <= name.len
            && name.charAt(base_end) == 58
            && name.charAt(base_end + 1) == 58
            && name.charAt(base_end + 2) == 60
            && name.charAt(name.len - 1) == 62) {
            let args = str_view_range(name, base_end + 3, name.len - 1);
            return out_base + "::<" + parser_rewrite_generic_args_text(table, args) + ">";
        }
        return out_base + str_view_range(name, base_end, name.len);
    }
    return name;
}

fn parser_rewrite_member_name_text(table: rawptr, name: string) -> string {
    let base_end = parser_generic_base_end(name);
    if (base_end >= name.len) { return name; }
    if (base_end + 3 <= name.len
        && name.charAt(base_end) == 58
        && name.charAt(base_end + 1) == 58
        && name.charAt(base_end + 2) == 60
        && name.charAt(name.len - 1) == 62) {
        let args = str_view_range(name, base_end + 3, name.len - 1);
        return str_view_range(name, 0, base_end)
             + "::<"
             + parser_rewrite_generic_args_text(table, args)
             + ">";
    }
    return name;
}

fn parser_rewrite_generic_args_text(table: rawptr, args: string) -> string {
    if (args.len == 0 || table == null) { return args; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    var angle_depth: i32 = 0;
    while (i <= args.len) {
        if (i == args.len || (args.charAt(i) == 44 && angle_depth == 0)) {
            let part = str_view_range(args, start, i);
            let rewritten = parser_rewrite_named_text(table, part);
            if (out.len > 0) { out = out + ","; }
            out = out + rewritten;
            start = i + 1;
        } else if (args.charAt(i) == 60) {
            angle_depth = angle_depth + 1;
        } else if (args.charAt(i) == 62) {
            angle_depth = angle_depth - 1;
            if (angle_depth < 0) { angle_depth = 0; }
        }
        i = i + 1;
    }
    return out;
}

fn parser_decl_chain_tail(head: rawptr) -> rawptr {
    var cur = head;
    var tail: rawptr = null;
    while (cur != null) {
        tail = cur;
        cur = decl_get_next(cur);
    }
    return tail;
}

fn parser_decl_chain_count(head: rawptr) -> i32 {
    var cur = head;
    var n: i32 = 0;
    while (cur != null) {
        n = n + 1;
        cur = decl_get_next(cur);
    }
    return n;
}

fn parser_decl_is_module_type_decl(d: rawptr) -> bool {
    if (d == null) { return false; }
    let k = decl_get_kind(d);
    if (k != de_CLASS() && k != de_ENUM() && k != de_TYPE_ALIAS()) {
        return false;
    }
    if (parser_string_contains(decl_get_meta(d), "|impl:")
        || parser_string_contains(decl_get_generic_params(d), "|kind:impl")) {
        return false;
    }
    let name = decl_get_name(d);
    if (name.len == 0) { return false; }
    return !parser_string_contains(name, ".");
}

fn parser_std_autoqual_reserved_short_name(name: string) -> bool {
    if (name == "Box" || name == "Ref" || name == "Scope" || name == "Weak") { return true; }
    if (name == "Vec" || name == "Dict" || name == "HashMap" || name == "HashSet" || name == "Set") { return true; }
    if (name == "List" || name == "Queue" || name == "Stack" || name == "Deque" || name == "Slice") { return true; }
    if (name == "Pair" || name == "Tuple3" || name == "Tuple4") { return true; }
    if (name == "Iterator" || name == "Iter" || name == "Iterable") { return true; }
    if (name == "Option" || name == "Result") { return true; }
    return false;
}

fn parser_rewrite_type_ref(ty: rawptr, table: rawptr) {
    if (ty == null || table == null) { return; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS() || k == ty_F32() || k == ty_F64()) {
        let old = tref_get_name(ty);
        let next = parser_rewrite_named_text(table, old);
        if (next != old) { tref_set_name(ty, next); }
    } else if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        parser_rewrite_type_ref(tref_pointee(ty), table);
    } else if (k == ty_ARRAY()) {
        parser_rewrite_type_ref(tref_array_elem(ty), table);
        parser_rewrite_expr(tref_array_size_expr(ty), table);
    } else if (k == ty_TUPLE()) {
        var i: i64 = 0;
        let n = tref_tuple_count(ty);
        while (i < n) {
            parser_rewrite_type_ref(tref_tuple_elem_at(ty, i), table);
            i = i + 1;
        }
    } else if (k == ty_FN() || k == ty_CFN()) {
        parser_rewrite_type_ref(tref_fn_params(ty), table);
        parser_rewrite_type_ref(tref_fn_ret(ty), table);
    }
}

fn parser_rewrite_expr_chain_cells(head: rawptr, table: rawptr) {
    var cur = head;
    while (cur != null) {
        parser_rewrite_expr(stmt_get_init(cur), table);
        cur = stmt_get_next(cur);
    }
}

fn parser_rewrite_param_chain(head: rawptr, table: rawptr) {
    var cur = head;
    while (cur != null) {
        parser_rewrite_type_ref(decl_get_ty(cur), table);
        cur = decl_get_next(cur);
    }
}

fn parser_rewrite_expr(e: rawptr, table: rawptr) {
    if (e == null || table == null) { return; }
    let k = expr_get_kind(e);
    if (k == ex_IDENT() || k == ex_STRUCT_INIT() || k == ex_FAIL()) {
        let old = expr_get_name(e);
        let next = parser_rewrite_named_text(table, old);
        if (next != old) { expr_set_name(e, next); }
    }
    if (k == ex_BIN() || k == ex_ASSIGN()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_expr(expr_get_rhs(e), table);
    } else if (k == ex_UNARY() || k == ex_ADDR_OF()
            || k == ex_DEREF() || k == ex_AWAIT()
            || k == ex_COMPTIME()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
    } else if (k == ex_CAST()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_type_ref(expr_get_ty(e), table);
    } else if (k == ex_CALL()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_expr_chain_cells(expr_get_args(e), table);
    } else if (k == ex_MEMBER()) {
        let old_member = expr_get_name(e);
        let next_member = parser_rewrite_member_name_text(table, old_member);
        if (next_member != old_member) { expr_set_name(e, next_member); }
        parser_rewrite_expr(expr_get_lhs(e), table);
    } else if (k == ex_INDEX()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_expr(expr_get_rhs(e), table);
    } else if (k == ex_STRUCT_INIT()) {
        parser_rewrite_expr_chain_cells(expr_get_args(e), table);
    } else if (k == ex_TERNARY()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_expr(expr_get_rhs(e), table);
        parser_rewrite_expr(expr_get_args(e), table);
    } else if (k == ex_IF_EXPR()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
        parser_rewrite_stmt_chain(expr_get_rhs(e), table);
        let else_part = expr_get_args(e);
        if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
            parser_rewrite_expr(else_part, table);
        } else {
            parser_rewrite_stmt_chain(else_part, table);
        }
    } else if (k == ex_FSTRING()
            || k == ex_ARRAY_LIT()
            || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
        parser_rewrite_expr_chain_cells(expr_get_args(e), table);
        if (k == ex_ARRAY_LIT()) {
            parser_rewrite_expr(expr_get_captures(e), table);
        }
    } else if (k == ex_CLOSURE()) {
        parser_rewrite_stmt_chain(expr_get_lhs(e), table);
        parser_rewrite_param_chain(expr_get_args(e), table);
        parser_rewrite_type_ref(expr_get_rhs(e), table);
        var cap = expr_get_captures(e);
        while (cap != null) {
            parser_rewrite_expr(stmt_get_init(cap), table);
            cap = stmt_get_next(cap);
        }
    } else if (k == ex_FAIL()) {
        parser_rewrite_expr(expr_get_lhs(e), table);
    }
}

fn parser_rewrite_stmt(s: rawptr, table: rawptr) {
    if (s == null || table == null) { return; }
    let k = stmt_get_kind(s);
    if (k == st_EXPR()) {
        parser_rewrite_expr(stmt_get_init(s), table);
    } else if (k == st_LET() || k == st_VAR()) {
        parser_rewrite_type_ref(stmt_get_ty(s), table);
        parser_rewrite_expr(stmt_get_init(s), table);
    } else if (k == st_IF()) {
        parser_rewrite_expr(stmt_get_cond(s), table);
        parser_rewrite_stmt_chain(stmt_get_then_blk(s), table);
        parser_rewrite_stmt_chain(stmt_get_else_blk(s), table);
    } else if (k == st_WHILE()) {
        parser_rewrite_expr(stmt_get_cond(s), table);
        parser_rewrite_stmt_chain(stmt_get_body(s), table);
    } else if (k == st_RETURN()) {
        parser_rewrite_expr(stmt_get_init(s), table);
    } else if (k == st_BLOCK()) {
        parser_rewrite_stmt_chain(stmt_get_body(s), table);
    } else if (k == st_FOR()) {
        parser_rewrite_stmt(stmt_get_init(s), table);
        parser_rewrite_expr(stmt_get_cond(s), table);
        parser_rewrite_stmt_chain(stmt_get_then_blk(s), table);
        parser_rewrite_stmt(stmt_get_body(s), table);
    } else if (k == st_FOREACH()) {
        parser_rewrite_expr(stmt_get_cond(s), table);
        parser_rewrite_stmt_chain(stmt_get_body(s), table);
    } else if (k == st_MATCH()) {
        parser_rewrite_expr(stmt_get_init(s), table);
        var arm = stmt_get_body(s);
        while (arm != null) {
            parser_rewrite_expr(stmt_get_init(arm), table);
            parser_rewrite_expr(stmt_get_cond(arm), table);
            parser_rewrite_stmt_chain(stmt_get_body(arm), table);
            arm = stmt_get_next(arm);
        }
    } else if (k == st_DEFER()) {
        parser_rewrite_stmt_chain(stmt_get_init(s), table);
    } else if (k == st_STATIC_ASSERT()) {
        parser_rewrite_expr(stmt_get_init(s), table);
    }
}

fn parser_rewrite_stmt_chain(head: rawptr, table: rawptr) {
    var cur = head;
    while (cur != null) {
        parser_rewrite_stmt(cur, table);
        cur = stmt_get_next(cur);
    }
}

fn parser_rewrite_decl(d: rawptr, table: rawptr) {
    if (d == null || table == null) { return; }
    if (parser_decl_is_module_type_decl(d)) {
        let old = decl_get_name(d);
        let next = parser_rewrite_named_text(table, old);
        if (next != old) { decl_set_name(d, next); }
    } else if (parser_string_contains(decl_get_generic_params(d), "|kind:impl")) {
        let old_impl = decl_get_name(d);
        let next_impl = parser_rewrite_named_text(table, old_impl);
        if (next_impl != old_impl) { decl_set_name(d, next_impl); }
    }
    parser_rewrite_type_ref(decl_get_ty(d), table);
    parser_rewrite_param_chain(decl_get_params(d), table);
    parser_rewrite_stmt_chain(decl_get_body(d), table);
    parser_rewrite_decl_chain(decl_get_members(d), table);
}

fn parser_rewrite_decl_chain(head: rawptr, table: rawptr) {
    var cur = head;
    while (cur != null) {
        parser_rewrite_decl(cur, table);
        cur = decl_get_next(cur);
    }
}

public fn parser_auto_qualify_std_modules(unit: rawptr) {
    if (unit == null) { return; }
    var table: rawptr = null;
    var current_module: string = "";
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()
            && !parser_string_contains(decl_get_name(cur), "__")) {
            current_module = decl_get_name(cur);
        } else if (parser_string_starts_with(current_module.clone(), "std.")
            && parser_decl_is_module_type_decl(cur)) {
            let shortn = decl_get_name(cur);
            if (!parser_std_autoqual_reserved_short_name(shortn)) {
                let qualified = intern_dot(current_module, shortn);
                table = parser_qual_put(table, shortn, qualified);
                decl_set_name(cur, qualified);
            }
        }
        cur = decl_get_next(cur);
    }
    if (table == null) { return; }
    cur = unit_get_decls(unit);
    while (cur != null) {
        parser_rewrite_decl(cur, table);
        cur = decl_get_next(cur);
    }
    parser_qual_dispose(table);
}

public fn parser_auto_qualify_imported_module_types(unit: rawptr) {
    if (unit == null) { return; }
    var table: rawptr = null;
    var current_module: string = "";
    var cur = unit_get_decls(unit);
    while (cur != null) {
        if (decl_get_kind(cur) == de_MODULE()
            && !parser_string_contains(decl_get_name(cur), "__")) {
            current_module = decl_get_name(cur);
        } else if (current_module.len > 0
            && !parser_string_starts_with(current_module.clone(), "std.")
            && parser_decl_is_module_type_decl(cur)) {
            let shortn = decl_get_name(cur);
            if (parser_string_contains(shortn, ".")) {
                cur = decl_get_next(cur);
                continue;
            }
            let qualified = intern_dot(current_module, shortn);
            table = parser_qual_put(table, shortn, qualified);
            decl_set_name(cur, qualified);
        }
        cur = decl_get_next(cur);
    }
    if (table == null) { return; }
    cur = unit_get_decls(unit);
    while (cur != null) {
        parser_rewrite_decl(cur, table);
        cur = decl_get_next(cur);
    }
    parser_qual_dispose(table);
}

// ════════════════════════════════════════════════════════════════════
//   Parser — instance-method-driven recursive descent.
//
//   Holds:
//     * lex_handle    : opaque LexResult rawptr from `lex_source`.
//     * total         : cached `lex_token_count(lex_handle)`.
//     * cur_idx / cur : 0-based cursor + cached current slot rawptr.
//     * error_count   : count of `parse error …` diagnostics emitted.
//     * decls_head /  : top-level decl chain accumulated by `run`.
//       decls_tail /    The public `parse_unit` writes these into a
//       decls_count     freshly-allocated Unit at its own scope so
//                       the AST nodes (which live in malloc'd byte
//                       memory) survive crossing function boundaries.
// ════════════════════════════════════════════════════════════════════

public class Parser {
    public lex_handle: rawptr
    public total: i32
    public cur_idx: i32
    public cur: rawptr
    public error_count: i32
    public decls_head: rawptr
    public decls_tail: rawptr
    public decls_count: i32
    public module_prefix: string
    // Set while parsing a `new` payload type: inside `new [ … ]` the
    // modern element-first spelling (`[T; n]`) wins over the legacy
    // size-first `[N; T]` for IDENT-led arrays, matching every other
    // `[i32; n]` site users actually write.
    public array_elem_first_ctx: bool
    // Set while parsing the target type of a cast (`expr as T`).  A cast
    // target is always a concrete type, so a following `<` is a *less-than*
    // operator rather than a generic argument list opener.  Without this,
    // `x as u64 < y` makes `parse_type` swallow `< y …` and either die at EOF
    // (`expected ')', got ``) or silently mis-parse `< y && z >` when a later
    // `>` happens to exist.  Cast targets never legitimately carry type
    // arguments, so this costs nothing.
    public cast_target_ctx: bool
    // Match expression scrutinees may use the Rust-style unparenthesized
    // spelling `match value { ... }`.  Suppress the ordinary `IDENT { ... }`
    // struct-literal postfix while parsing that scrutinee so the opening brace
    // remains the match arm delimiter.
    public suppress_struct_literal_ctx: bool

    public static fn create(lh: rawptr) -> Parser {
        let n = lex_token_count(lh);
        let first = lex_token_at(lh, 0);
        // Seed the ast-level current-loc globals so every AST node allocated
        // before the first `advance()` (which itself re-syncs) still carries
        // a meaningful line/col stamp. `bootstrap.ast::ast_set_current_loc`
        // updates the four `g_ast_loc_*` globals consumed by every alloc.
        if (first != null) {
            ast_set_current_loc(token_line(first), token_col(first));
        } else {
            ast_clear_current_loc();
        }
        return Parser {
            lex_handle: lh,
            total: n,
            cur_idx: 0,
            cur: first,
            error_count: 0,
            decls_head: null,
            decls_tail: null,
            decls_count: 0,
            module_prefix: "",
            array_elem_first_ctx: false,
            cast_target_ctx: false,
            suppress_struct_literal_ctx: false
        };
    }

    // ── Token-cursor primitives ─────────────────────────────────────

    public fn kind(self) -> i32 { return token_kind(self.cur); }
    public fn lex(self) -> string { return token_lexeme(self.cur); }
    public fn line(self) -> i32 { return token_line(self.cur); }
    public fn col(self) -> i32 { return token_col(self.cur); }
    public fn peek_kind(self) -> i32 {
        let next = lex_token_at(self.lex_handle, self.cur_idx + 1);
        if (next == null) { return tk_EOF(); }
        return token_kind(next);
    }

    public fn kind_at(self, idx: i32) -> i32 {
        let t = lex_token_at(self.lex_handle, idx);
        if (t == null) { return tk_EOF(); }
        return token_kind(t);
    }

    public fn lex_at(self, idx: i32) -> string {
        let t = lex_token_at(self.lex_handle, idx);
        if (t == null) { return ""; }
        return token_lexeme(t);
    }

    public fn bracket_starts_capture_closure(self) -> bool {
        if (self.kind() != tk_LBRACKET()) { return false; }
        var idx = self.cur_idx + 1;
        var depth: i32 = 1;
        while (idx < self.total && depth > 0) {
            let k = self.kind_at(idx);
            if (k == tk_LBRACKET()) { depth = depth + 1; }
            else if (k == tk_RBRACKET()) { depth = depth - 1; }
            idx = idx + 1;
        }
        if (depth != 0) { return false; }
        return self.kind_at(idx) == tk_LPAREN();
    }

    public fn at_end(self) -> bool {
        return self.kind() == tk_EOF();
    }

    public fn check(self, k: i32) -> bool {
        return self.kind() == k;
    }

    public fn advance(self) -> rawptr {
        let prev = self.cur;
        self.cur_idx = self.cur_idx + 1;
        self.cur = lex_token_at(self.lex_handle, self.cur_idx);
        // Keep the ast loc-stamp globals lined up with the cursor token.
        // Every `*_alloc` helper in `bootstrap.ast` picks these up at
        // allocation time, so as long as `advance()` is the only cursor
        // bump (with two rollback exceptions covered below), the WU1
        // contract "stamp loc 取当前 token 的 line/col" holds end-to-end.
        if (self.cur != null) {
            ast_set_current_loc(token_line(self.cur), token_col(self.cur));
        }
        return prev;
    }

    public fn accept(self, k: i32) -> bool {
        if (self.kind() == k) {
            self.advance();
            return true;
        }
        return false;
    }

    public fn report_error(self, what: string) {
        let ln = self.line();
        let cl = self.col();
        let lx = self.lex();
        var code = diag_code_syntax_unexpected();
        var msg = what + ", got `" + lx + "`";
        if (what.startsWith("expect ")) {
            code = diag_code_syntax_missing();
            msg = "expected " + str_view_range(what, 7, what.len as i32) + ", got `" + lx + "`";
        }
        diag_emit(diag_sev_ERROR(), code, ln, cl, msg);
        self.error_count = self.error_count + 1;
        if (what.startsWith("expect ")) {
            diag_emit(diag_sev_NOTE(),
                      code,
                      ln,
                      cl,
                      "help: insert " + str_view_range(what, 7, what.len as i32) + " before `" + lx + "`");
        } else {
            diag_emit(diag_sev_NOTE(),
                      code,
                      ln,
                      cl,
                      "help: remove `" + lx + "`, or replace it with the expected construct");
        }
    }

    public fn expect_kind(self, k: i32, what: string) -> bool {
        if (self.kind() == k) {
            self.advance();
            return true;
        }
        self.report_error("expect " + what);
        return false;
    }

    public fn synchronize(self) {
        while (self.kind() != tk_EOF()) {
            let k = self.kind();
            if (k == tk_SEMI())   { self.advance(); return; }
            // The enclosing parse loop owns its closing brace. Leaving it in
            // place prevents a malformed member from absorbing declarations
            // that follow the current class/module/extern body. Top-level
            // recovery still consumes a stray brace via ensure_progress().
            if (k == tk_RBRACE()) { return; }
            self.advance();
        }
    }

    /// Recover one malformed statement without consuming the enclosing
    /// block's closing brace. Statement parsers use this after a required
    /// prefix is missing so the remainder cannot be reinterpreted as a new
    /// statement.
    public fn synchronize_statement(self) {
        while (self.kind() != tk_SEMI()
            && self.kind() != tk_RBRACE()
            && self.kind() != tk_EOF()) {
            self.advance();
        }
        self.accept(tk_SEMI());
    }

    /// Belt-and-braces forward-progress guard for every parse loop:
    /// if the cursor index is unchanged from `before_idx` and we are
    /// not at EOF, force a single `advance()`. Without this, a sub-
    /// parser that fails *after* allocating an AST node (returning
    /// non-null) but *before* consuming any token would spin the
    /// enclosing loop forever, which is exactly the 9 MB error
    /// flood seen on the unsupported `Point { x: a, y: b }` literal.
    public fn ensure_progress(self, before_idx: i32) {
        if (self.cur_idx == before_idx && !self.at_end()) {
            self.advance();
        }
    }

    public fn skip_balanced(self, open_k: i32, close_k: i32) {
        if (!self.accept(open_k)) {
            return;
        }
        var depth: i32 = 1;
        while (depth > 0 && self.kind() != tk_EOF()) {
            if (self.kind() == open_k) {
                depth = depth + 1;
            } else if (self.kind() == close_k) {
                depth = depth - 1;
            }
            self.advance();
        }
    }

    public fn skip_angle_payload(self) {
        self.read_angle_payload_text();
    }

    public fn read_angle_payload_text(self) -> string {
        var out: string = "";
        if (!self.accept(tk_LT())) {
            return out;
        }
        var depth: i32 = 1;
        while (depth > 0 && self.kind() != tk_EOF()) {
            if (self.kind() == tk_LT()) {
                depth = depth + 1;
                if (depth > 1) { out = out + self.lex(); }
            } else if (self.kind() == tk_GT()) {
                depth = depth - 1;
                if (depth > 0) { out = out + self.lex(); }
            } else if (self.kind() == tk_RSHIFT()) {
                let before_shift = depth;
                if (before_shift > 1) { out = out + ">"; }
                if (before_shift > 2) { out = out + ">"; }
                depth = depth - 2;
            } else {
                out = out + self.lex();
            }
            self.advance();
        }
        return out;
    }

    /// In a cast target, `<` starts type arguments only when they close
    /// before the surrounding expression ends.  A following operand also
    /// rules out type arguments: `x as T < a > b` remains a comparison.
    public fn cast_target_has_type_args(self) -> bool {
        if (self.kind() != tk_LT()) { return false; }
        var depth: i32 = 1;
        var parens: i32 = 0;
        var brackets: i32 = 0;
        var i = self.cur_idx + 1;
        while (i < self.total) {
            let k = self.kind_at(i);
            if (k == tk_LPAREN()) {
                parens = parens + 1;
            } else if (k == tk_RPAREN()) {
                if (parens == 0) { return false; }
                parens = parens - 1;
            } else if (k == tk_LBRACKET()) {
                brackets = brackets + 1;
            } else if (k == tk_RBRACKET()) {
                if (brackets == 0) { return false; }
                brackets = brackets - 1;
            } else if (k == tk_LT()) {
                depth = depth + 1;
            } else if (k == tk_GT()) {
                depth = depth - 1;
            } else if (k == tk_RSHIFT()) {
                depth = depth - 2;
            } else if (parens == 0 && brackets == 0
                       && (k == tk_SEMI() || k == tk_RBRACE()
                           || k == tk_AND() || k == tk_OR()
                           || k == tk_EQ() || k == tk_EOF())) {
                return false;
            }
            if (depth < 0) { return false; }
            if (depth == 0) {
                let after = self.kind_at(i + 1);
                if ((after == tk_IDENT() && self.lex_at(i + 1) != "as")
                    || after == tk_INT() || after == tk_FLOAT()
                    || after == tk_CHAR() || after == tk_STRING()
                    || after == tk_LPAREN() || after == tk_LBRACKET()) {
                    return false;
                }
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn is_plain_generic_postfix(self) -> bool {
        if (self.kind() != tk_LT()) {
            return false;
        }
        var depth: i32 = 1;
        var i = self.cur_idx + 1;
        while (i < self.total) {
            let slot = lex_token_at(self.lex_handle, i);
            let k = token_kind(slot);
            if (k == tk_LT()) {
                depth = depth + 1;
            } else if (k == tk_GT()) {
                depth = depth - 1;
            } else if (k == tk_RSHIFT()) {
                depth = depth - 2;
            } else if (k == tk_SEMI() || k == tk_LBRACE()
                    || k == tk_RBRACE() || k == tk_RPAREN()
                    || k == tk_FATARROW() || k == tk_EQ()) {
                return false;
            }
            if (depth <= 0) {
                let after = token_kind(lex_token_at(self.lex_handle, i + 1));
                return after == tk_LBRACE() || after == tk_LPAREN()
                    || after == tk_COLONCOLON() || after == tk_DOT();
            }
            i = i + 1;
        }
        return false;
    }

    public fn bracket_payload_has_semi(self) -> bool {
        if (self.kind() != tk_LBRACKET()) {
            return false;
        }
        var depth: i32 = 1;
        var i = self.cur_idx + 1;
        while (i < self.total) {
            let slot = lex_token_at(self.lex_handle, i);
            let k = token_kind(slot);
            if (k == tk_LBRACKET()) {
                depth = depth + 1;
            } else if (k == tk_RBRACKET()) {
                depth = depth - 1;
                if (depth <= 0) {
                    return false;
                }
            } else if (k == tk_SEMI() && depth == 1) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fn current_doc(self) -> string {
        return token_doc_comment(self.cur);
    }

    public fn collect_balanced_text(self, open_k: i32, close_k: i32) -> string {
        if (!self.check(open_k)) { return ""; }
        var text: string = "";
        var depth: i32 = 0;
        while (!self.at_end()) {
            let k = self.kind();
            text = text + self.lex();
            if (k == open_k) {
                depth = depth + 1;
            } else if (k == close_k) {
                depth = depth - 1;
                self.advance();
                if (depth <= 0) { return text; }
                continue;
            }
            self.advance();
        }
        return text;
    }

    public fn collect_attribute(self) -> string {
        let doc = self.current_doc();
        if (!self.accept(tk_AT())) {
            return "";
        }
        var text: string = "@";
        if (doc.len > 0) {
            text = text + "doc(" + doc + ")";
        }
        if (self.check(tk_LBRACKET())) {
            if (doc.len > 0) {
                return text + "@" + self.collect_balanced_text(tk_LBRACKET(), tk_RBRACKET());
            }
            return text + self.collect_balanced_text(tk_LBRACKET(), tk_RBRACKET());
        }
        if (self.kind() == tk_IDENT()) {
            if (doc.len > 0) {
                text = text + "@";
            }
            text = text + self.lex();
            self.advance();
            if (self.check(tk_LPAREN())) {
                text = text + self.collect_balanced_text(tk_LPAREN(), tk_RPAREN());
            }
        }
        return text;
    }

    public fn skip_attribute(self) {
        self.collect_attribute();
    }

    public fn collect_leading_attributes(self) -> string {
        var attrs: string = "";
        while (self.kind() == tk_AT()) {
            let a = self.collect_attribute();
            if (a.len > 0) {
                if (attrs.len > 0) { attrs = intern_cat3(attrs, ",", a); }
                else { attrs = intern_cat2("", a); }
            }
        }
        return attrs;
    }

    public fn attach_decl_meta(self,
                               d: rawptr,
                               visibility: string,
                               attrs: string,
                               doc: string,
                               markers: string) -> rawptr {
        if (d == null) { return d; }
        var meta: string = "";
        if (visibility.len > 0) { meta = intern_cat2("|vis:", visibility); }
        if (attrs.len > 0) {
            let attr_meta = intern_cat2("|attrs:", attrs);
            if (meta.len > 0) {
                meta = intern_cat2(meta, attr_meta);
            } else {
                meta = attr_meta;
            }
        }
        if (markers.len > 0) {
            if (meta.len > 0) {
                meta = intern_cat2(meta, markers);
            } else {
                meta = intern_cat2("", markers);
            }
        }
        if (meta.len > 0) {
            let existing = decl_get_meta(d);
            if (existing.len > 0 && existing.charAt(0) != 124) {
                decl_set_meta(d, intern_cat2(existing, meta));
            } else {
                decl_set_meta(d, meta);
            }
        }
        if (doc.len > 0) { decl_set_doc(d, doc); }
        return d;
    }

    public fn append_meta_to_decl_chain(self,
                                        head: rawptr,
                                        attrs: string,
                                        markers: string) -> rawptr {
        var cur = head;
        while (cur != null) {
            var meta = decl_get_meta(cur);
            if (attrs.len > 0) {
                if (parser_string_contains(meta, "|attrs:")) {
                    meta = intern_cat3(meta, ",", attrs);
                } else {
                    meta = intern_cat3(meta, "|attrs:", attrs);
                }
            }
            if (markers.len > 0) {
                meta = intern_cat2(meta, markers);
            }
            if (meta.len > 0) { decl_set_meta(cur, meta); }
            cur = decl_get_next(cur);
        }
        return head;
    }

    public fn append_decl_meta_marker(self, d: rawptr, marker: string) -> rawptr {
        if (d == null || marker.len == 0) { return d; }
        decl_set_meta(d, decl_get_meta(d) + marker);
        return d;
    }

    public fn extern_abi_is_cpp(self, abi: string) -> bool {
        return abi == "cpp" || abi == "C++" || abi == "c++" || abi == "cplusplus";
    }

    public fn extern_abi_is_dci(self, abi: string) -> bool {
        return abi == "dci" || abi == "DCI" || abi == "Dci";
    }

    public fn extern_abi_uses_dci_surface(self, abi: string) -> bool {
        return self.extern_abi_is_dci(abi.clone()) || self.extern_abi_is_cpp(abi);
    }

    public fn extern_dci_decl_markers(self, abi: string) -> string {
        if (self.extern_abi_is_cpp(abi)) {
            return "|extern_abi:cpp|foreign_dci|foreign_cpp";
        }
        return "|extern_abi:dci|foreign_dci";
    }

    public fn mark_extern_dci_decl_tree(self, head: rawptr, abi: string) {
        let is_cpp = self.extern_abi_is_cpp(abi.clone());
        var cur = head;
        while (cur != null) {
            var meta = decl_get_meta(cur);
            var abi_marker = "|extern_abi:dci";
            if (is_cpp) { abi_marker = "|extern_abi:cpp"; }
            if (!parser_string_contains(meta, abi_marker)) {
                meta = meta + abi_marker;
            }
            if (!parser_string_contains(meta, "|foreign_dci")) {
                meta = meta + "|foreign_dci";
            }
            if (is_cpp && !parser_string_contains(meta, "|foreign_cpp")) {
                meta = meta + "|foreign_cpp";
            }
            if ((decl_get_kind(cur) == de_METHOD() || decl_get_kind(cur) == de_EXTERN_FN())
                && decl_get_body(cur) == null
                && !parser_string_contains(meta, "|foreign_dci_native")) {
                meta = meta + "|foreign_dci_native";
            }
            if (is_cpp
                && (decl_get_kind(cur) == de_METHOD() || decl_get_kind(cur) == de_EXTERN_FN())
                && decl_get_body(cur) == null
                && !parser_string_contains(meta, "|foreign_cpp_native")) {
                meta = meta + "|foreign_cpp_native";
            }
            if (decl_get_kind(cur) == de_METHOD()
                && parser_string_contains(decl_get_generic_params(cur), "|kind:constructor")
                && !parser_string_contains(meta, "|foreign_dci_ctor")) {
                meta = meta + "|foreign_dci_ctor";
            }
            if (is_cpp
                && decl_get_kind(cur) == de_METHOD()
                && parser_string_contains(decl_get_generic_params(cur), "|kind:constructor")
                && !parser_string_contains(meta, "|foreign_cpp_ctor")) {
                meta = meta + "|foreign_cpp_ctor";
            }
            if (decl_get_kind(cur) == de_METHOD()
                && parser_string_contains(decl_get_generic_params(cur), "|kind:destructor")
                && !parser_string_contains(meta, "|foreign_dci_dtor")) {
                meta = meta + "|foreign_dci_dtor";
            }
            if (is_cpp
                && decl_get_kind(cur) == de_METHOD()
                && parser_string_contains(decl_get_generic_params(cur), "|kind:destructor")
                && !parser_string_contains(meta, "|foreign_cpp_dtor")) {
                meta = meta + "|foreign_cpp_dtor";
            }
            decl_set_meta(cur, meta);
            if (decl_get_members(cur) != null) {
                self.mark_extern_dci_decl_tree(decl_get_members(cur), abi.clone());
            }
            cur = decl_get_next(cur);
        }
    }

    public fn mark_extern_cpp_decl_tree(self, head: rawptr) {
        self.mark_extern_dci_decl_tree(head, "cpp");
    }

    public fn owner_ctor_name_matches(self, owner_name: string) -> bool {
        if (self.kind() != tk_IDENT()) { return false; }
        let lx = self.lex();
        if (lx == owner_name) { return true; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i < owner_name.len) {
            if (owner_name.charAt(i) == 46) { start = i + 1; }
            i = i + 1;
        }
        return lx == str_view_range(owner_name, start, owner_name.len);
    }

    public fn parse_attributed_decl_block(self,
                                          attrs: string,
                                          markers: string) -> rawptr {
        if (!self.expect_kind(tk_LBRACE(), "'{' after attribute block")) {
            return null;
        }
        var head: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let inner = self.parse_decl();
            if (inner != null) {
                head = self.append_local_decl_chain(head, inner);
            } else {
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close attribute block");
        return self.append_meta_to_decl_chain(head, attrs, markers);
    }

    public fn append_decl_chain(self, head: rawptr) {
        if (head == null) { return; }
        let tail = parser_decl_chain_tail(head);
        let count = parser_decl_chain_count(head);
        if (self.decls_head == null) {
            self.decls_head = head;
            self.decls_tail = tail;
        } else {
            decl_set_next(self.decls_tail, head);
            self.decls_tail = tail;
        }
        self.decls_count = self.decls_count + count;
    }

    public fn append_local_decl_chain(self,
                                      head: rawptr,
                                      chain: rawptr) -> rawptr {
        if (chain == null) { return head; }
        if (head == null) { return chain; }
        let tail = parser_decl_chain_tail(head);
        decl_set_next(tail, chain);
        return head;
    }

    public fn module_full_name(self, name: string) -> string {
        if (self.module_prefix.len == 0) { return name; }
        if (name.len == 0) { return self.module_prefix; }
        return intern_dot(self.module_prefix, name);
    }

    public fn build_module_rewrite_table(self, head: rawptr, module_name: string) -> rawptr {
        var table: rawptr = null;
        var cur = head;
        while (cur != null) {
            if (parser_decl_is_module_type_decl(cur)) {
                let shortn = decl_get_name(cur);
                table = parser_qual_put(table, shortn, intern_dot(module_name, shortn));
            }
            cur = decl_get_next(cur);
        }
        return table;
    }

    public fn skip_until_body_or_semi(self) {
        while (self.kind() != tk_LBRACE()
            && self.kind() != tk_SEMI()
            && self.kind() != tk_EOF()) {
            if (self.kind() == tk_LPAREN()) {
                self.skip_balanced(tk_LPAREN(), tk_RPAREN());
            } else if (self.kind() == tk_LBRACKET()) {
                self.skip_balanced(tk_LBRACKET(), tk_RBRACKET());
            } else if (self.kind() == tk_LT()) {
                self.skip_angle_payload();
            } else {
                self.advance();
            }
        }
    }

    // ── Type reference ──────────────────────────────────────────────

    public fn type_expr_op_text(self, op: i32) -> string {
        if (op == tk_PLUS()) { return "+"; }
        if (op == tk_MINUS()) { return "-"; }
        if (op == tk_STAR()) { return "*"; }
        if (op == tk_SLASH()) { return "/"; }
        if (op == tk_PERCENT()) { return "%"; }
        if (op == tk_LSHIFT()) { return "<<"; }
        if (op == tk_RSHIFT()) { return ">>"; }
        if (op == tk_LT()) { return "<"; }
        if (op == tk_LE()) { return "<="; }
        if (op == tk_GT()) { return ">"; }
        if (op == tk_GE()) { return ">="; }
        if (op == tk_EQEQ()) { return "=="; }
        if (op == tk_NEQ()) { return "!="; }
        if (op == tk_AND()) { return "&&"; }
        if (op == tk_OR()) { return "||"; }
        if (op == tk_AMP()) { return "&"; }
        if (op == tk_PIPE()) { return "|"; }
        if (op == tk_CARET()) { return "^"; }
        return "?";
    }

    public fn expr_chain_text_for_type(self, head: rawptr) -> string {
        var out: string = "";
        var cell = head;
        while (cell != null) {
            if (out.len > 0) { out = out + ","; }
            out = out + self.expr_text_for_type(stmt_get_init(cell));
            cell = stmt_get_next(cell);
        }
        return out;
    }

    public fn expr_text_for_type(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        let k = expr_get_kind(e);
        if (k == ex_INT_LIT()) { return expr_get_int_val(e).toString(); }
        if (k == ex_IDENT()) { return expr_get_name(e); }
        if (k == ex_UNARY()) {
            return self.type_expr_op_text(expr_get_op(e))
                + self.expr_text_for_type(expr_get_lhs(e));
        }
        if (k == ex_BIN()) {
            return self.expr_text_for_type(expr_get_lhs(e))
                + self.type_expr_op_text(expr_get_op(e))
                + self.expr_text_for_type(expr_get_rhs(e));
        }
        if (k == ex_MEMBER()) {
            return self.expr_text_for_type(expr_get_lhs(e)) + "." + expr_get_name(e);
        }
        if (k == ex_INDEX()) {
            return self.expr_text_for_type(expr_get_lhs(e))
                + "["
                + self.expr_text_for_type(expr_get_rhs(e))
                + "]";
        }
        if (k == ex_CALL()) {
            return self.expr_text_for_type(expr_get_lhs(e))
                + "("
                + self.expr_chain_text_for_type(expr_get_args(e))
                + ")";
        }
        return "";
    }

    public fn type_ref_text(self, ty: rawptr) -> string {
        if (ty == null) { return "void"; }
        let k = tref_get_kind(ty);
        if (k == ty_I8()) { return "i8"; }
        if (k == ty_I16()) { return "i16"; }
        if (k == ty_I32()) { return "i32"; }
        if (k == ty_I64()) { return "i64"; }
        if (k == ty_U8()) { return "u8"; }
        if (k == ty_U16()) { return "u16"; }
        if (k == ty_U32()) { return "u32"; }
        if (k == ty_U64()) { return "u64"; }
        if (k == ty_ISIZE()) { return "isize"; }
        if (k == ty_USIZE()) { return "usize"; }
        if (k == ty_BOOL()) { return "bool"; }
        if (k == ty_CHAR()) { return "char"; }
        if (k == ty_STRING()) { return "str"; }
        if (k == ty_RAWPTR()) { return "rawptr"; }
        if (k == ty_VOID()) { return "void"; }
        if (k == ty_CLASS()) {
            let n = tref_get_name(ty);
            if (n.len > 0) { return n; }
            return "rawptr";
        }
        if (k == ty_PTR()) { return "*" + self.type_ref_text(tref_pointee(ty)); }
        if (k == ty_REF()) { return "&" + self.type_ref_text(tref_pointee(ty)); }
        if (k == ty_MUTREF()) { return "&mut " + self.type_ref_text(tref_pointee(ty)); }
        if (k == ty_ARRAY()) {
            var arr_text: string = "[";
            arr_text = arr_text + self.type_ref_text(tref_array_elem(ty));
            arr_text = arr_text + ";";
            var sz_text = self.expr_text_for_type(tref_array_size_expr(ty));
            if (sz_text.len == 0) { sz_text = tref_array_size(ty).toString(); }
            arr_text = arr_text + sz_text;
            arr_text = arr_text + "]";
            return arr_text;
        }
        if (k == ty_TUPLE()) {
            var out = "(";
            var i: i64 = 0;
            let count = tref_tuple_count(ty);
            while (i < count) {
                if (i > 0) { out = out + ","; }
                out = out + self.type_ref_text(tref_tuple_elem_at(ty, i));
                i = i + 1;
            }
            return out + ")";
        }
        if (k == ty_FN() || k == ty_CFN()) {
            var out2 = "fn(";
            if (k == ty_CFN()) { out2 = "unsafe fn("; }
            let params = tref_fn_params(ty);
            var j: i64 = 0;
            let n_params = tref_tuple_count(params);
            while (j < n_params) {
                if (j > 0) { out2 = out2 + ","; }
                out2 = out2 + self.type_ref_text(tref_tuple_elem_at(params, j));
                j = j + 1;
            }
            out2 = out2 + ")->";
            out2 = out2 + self.type_ref_text(tref_fn_ret(ty));
            return out2;
        }
        if (k == ty_RANGE()) { return "Range"; }
        return "rawptr";
    }

    public fn dyn_type_ref_text(self, ty: rawptr) -> string {
        let raw = self.type_ref_text(ty);
        if (raw.len == 0) { return "dyn"; }
        let base = policy_generic_call_base(raw.clone());
        let args = policy_generic_call_args(raw.clone());
        var short_base = base;
        var i: i32 = (base.len - 1) as i32;
        while (i >= 0) {
            if (base.charAt(i) == 46) {
                short_base = str_view_range(base, i + 1, base.len);
                i = -1;
            } else {
                i = i - 1;
            }
        }
        var out = "dyn" + short_base;
        if (args.len > 0) { out = out + "::<" + args + ">"; }
        return out;
    }

    public fn finish_type_suffix(self, ty: rawptr) -> rawptr {
        if (self.accept(tk_QUESTION())) {
            self.report_error("nullable type suffix requires the standard library option type");
        }
        return ty;
    }

    public fn parse_fn_type_param_type(self) -> rawptr {
        if (self.kind() == tk_IDENT() && self.kind_at(self.cur_idx + 1) == tk_COLON()) {
            self.advance();
            self.advance();
            return self.parse_type();
        }
        return self.parse_type();
    }

    public fn parse_fn_type_ref(self, is_unsafe_c: bool) -> rawptr {
        self.expect_kind(tk_KEYWORD_FN(), "'fn' in function type");
        return self.parse_fn_type_ref_after_kw(is_unsafe_c);
    }

    public fn parse_fn_type_ref_after_kw(self, is_unsafe_c: bool) -> rawptr {
        var params_tuple: rawptr = tref_alloc_tuple(null, 0);
        if (self.accept(tk_LPAREN())) {
            var count_fn: i64 = 0;
            var cap_fn: i64 = 4;
            var buf_fn: rawptr = null;
            if (self.kind() != tk_RPAREN()) {
                buf_fn = malloc((cap_fn * 8) as i32);
                while (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                    if (self.kind() == tk_ELLIPSIS()) {
                        self.advance();
                        break;
                    }
                    let pty = self.parse_fn_type_param_type();
                    if (count_fn >= cap_fn) {
                        let new_cap_fn = cap_fn * 2;
                        let new_buf_fn = malloc((new_cap_fn * 8) as i32);
                        var copy_i: i32 = 0;
                        while (copy_i < (cap_fn * 8) as i32) {
                            ast_write_rawptr(ptr_offset(new_buf_fn, copy_i),
                                             ast_read_rawptr(ptr_offset(buf_fn, copy_i)));
                            copy_i = copy_i + 8;
                        }
                        free(buf_fn);
                        buf_fn = new_buf_fn;
                        cap_fn = new_cap_fn;
                    }
                    ast_write_rawptr(ptr_offset(buf_fn, (count_fn * 8) as i32), pty);
                    count_fn = count_fn + 1;
                    if (!self.accept(tk_COMMA())) { break; }
                }
            }
            self.expect_kind(tk_RPAREN(), "')'");
            params_tuple = tref_alloc_tuple(buf_fn, count_fn);
        } else {
            self.report_error("expect '(' after fn in function type");
        }
        var ret_fn: rawptr = tref_alloc(ty_VOID(), "");
        if (self.accept(tk_ARROW())) {
            ret_fn = self.parse_type();
        }
        if (is_unsafe_c) {
            return self.finish_type_suffix(tref_alloc_c_fn(params_tuple, ret_fn));
        }
        return self.finish_type_suffix(tref_alloc_fn(params_tuple, ret_fn));
    }

    public fn parse_type(self) -> rawptr {
        let lx = self.lex();
        let tok = self.kind();
        if (tok == tk_IDENT() && lx == "own") {
            self.report_error("`own` is only valid as `own self`");
            self.advance();
            return self.parse_type();
        }
        if (tok == tk_KEYWORD_UNSAFE()) {
            self.advance();
            if (self.kind() != tk_KEYWORD_FN()) {
                self.report_error("expect fn after unsafe in function pointer type");
                return null;
            }
            return self.parse_fn_type_ref(true);
        }
        if (tok == tk_ELLIPSIS()) {
            self.advance();
            if (self.kind() == tk_IDENT() || self.kind() == tk_KEYWORD_FN()
                || self.kind() == tk_AMP() || self.kind() == tk_LBRACKET()) {
                self.parse_type();
            }
            return self.finish_type_suffix(tref_alloc(ty_RAWPTR(), "varargs"));
        }
        if (tok == tk_AMP()) {
            self.advance();
            if (self.kind() == tk_KEYWORD_MUT()) {
                self.advance();
                let mut_inner = self.parse_type();
                return self.finish_type_suffix(tref_alloc_ptr_like(ty_MUTREF(), mut_inner));
            }
            let ref_inner = self.parse_type();
            return self.finish_type_suffix(tref_alloc_ptr_like(ty_REF(), ref_inner));
        }
        if (tok == tk_STAR()) {
            self.advance();
            let ptr_inner = self.parse_type();
            return self.finish_type_suffix(tref_alloc_ptr_like(ty_PTR(), ptr_inner));
        }
        if (tok == tk_LBRACKET()) {
            self.advance(); // consume '['
            var size_first: bool = false;
            if (self.kind() == tk_INT()) {
                size_first = true;
            } else if (self.kind() == tk_IDENT()) {
                let nk = self.kind_at(self.cur_idx + 1);
                if (nk == tk_RBRACKET()) {
                    size_first = true;
                } else if (nk == tk_SEMI()) {
                    // `new` payloads always use the modern element-first
                    // spelling: `new [T; c * r]()` allocates T-elements
                    // with count `c * r`, never legacy `[size; type]`.
                    if (self.array_elem_first_ctx) {
                        size_first = false;
                    } else if (self.kind_at(self.cur_idx + 2) == tk_INT()) {
                        // `[Name; 16]` is a fixed array whose element is a named
                        // type.  `[N; T]` remains accepted for legacy size-first
                        // spelling when the token after `;` is a type token.
                        size_first = false;
                    } else {
                        size_first = true;
                    }
                }
            }
            var elem_ty: rawptr = null;
            var size_expr: rawptr = null;
            if (size_first) {
                size_expr = self.parse_expr();
                if (self.accept(tk_SEMI())) {
                    elem_ty = self.parse_type();
                    self.expect_kind(tk_RBRACKET(), "']'");
                } else {
                    self.expect_kind(tk_RBRACKET(), "']'");
                    elem_ty = self.parse_type();
                }
            } else {
                elem_ty = self.parse_type();
                if (self.accept(tk_SEMI())) {
                    size_expr = self.parse_expr();
                }
                self.expect_kind(tk_RBRACKET(), "']'");
            }
            return self.finish_type_suffix(tref_alloc_array_expr(elem_ty, size_expr));
        }
        if (tok == tk_LPAREN()) {
            self.advance(); // consume '('
            // Check for empty tuple ()
            if (self.accept(tk_RPAREN())) {
                return self.finish_type_suffix(tref_alloc_tuple(null, 0));
            }
            // Parse first type
            let first = self.parse_type();
            // If no comma, it's grouping parens — return the inner type
            if (!self.accept(tk_COMMA())) {
                self.expect_kind(tk_RPAREN(), "')'");
                return self.finish_type_suffix(first);
            }
            // It's a tuple: collect remaining elements
            var count: i64 = 1;
            var cap: i64 = 4;
            var buf = malloc((cap * 8) as i32);
            ast_write_rawptr(buf, first);
            while (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                let et = self.parse_type();
                if (count >= cap) {
                    let new_cap = cap * 2;
                    let new_buf = malloc((new_cap * 8) as i32);
                    let ci = (cap * 8) as i32;
                    var _cp: i32 = 0;
                    while (_cp < ci) {
                        ast_write_rawptr(ptr_offset(new_buf, _cp), ast_read_rawptr(ptr_offset(buf, _cp)));
                        _cp = _cp + 8;
                    }
                    free(buf);
                    buf = new_buf;
                    cap = new_cap;
                }
                ast_write_rawptr(ptr_offset(buf, (count * 8) as i32), et);
                count = count + 1;
                if (!self.accept(tk_COMMA())) { break; }
            }
            self.expect_kind(tk_RPAREN(), "')'");
            return self.finish_type_suffix(tref_alloc_tuple(buf, count));
        }
        if (tok == tk_KEYWORD_FN()) { return self.parse_fn_type_ref(false); }
        if (lx == "cfn") {
            self.advance();
            return self.parse_fn_type_ref_after_kw(true);
        }
        if (lx == "dyn") {
            self.advance();
            let inner = self.parse_type();
            if (inner != null) {
                return self.finish_type_suffix(tref_alloc(ty_CLASS(), self.dyn_type_ref_text(inner)));
            }
            return self.finish_type_suffix(tref_alloc(ty_CLASS(), "dyn"));
        }
        let prim_kind = policy_primitive_type_kind(lx);
        var prim_kw: bool = prim_kind != 0;
        if (tok != tk_IDENT() && !prim_kw) {
            self.report_error("expect type name");
            return null;
        }
        self.advance();
        var k: i32 = parser_type_kind_from_primitive(prim_kind);
        var full_name = lx;
        // A type path may carry type arguments per segment.  For a hoisted
        // nested record they all belong to the same flat record, so they
        // accumulate: `FreqArray<i32>::A<f32>` becomes the record
        // `FreqArray.A` instantiated as `<i32,f32>`.
        var seg_args: string = "";
        while (true) {
            if (self.kind() == tk_COLONCOLON() && self.kind_at(self.cur_idx + 1) == tk_LT()) {
                self.advance();
            }
            // Primitive cast targets cannot have arguments.  Nominal cast
            // targets can, provided the angle list closes as a type.
            if (self.kind() == tk_LT()
                && (!self.cast_target_ctx
                    || (!prim_kw && self.cast_target_has_type_args()))) {
                let piece = self.read_angle_payload_text();
                if (piece.len > 0) {
                    if (seg_args.len > 0) { seg_args = seg_args + ","; }
                    seg_args = seg_args + piece;
                }
            }
            if (self.kind() == tk_COLONCOLON() || self.kind() == tk_DOT()) {
                self.advance();
                if (self.kind() == tk_IDENT()) {
                    full_name = full_name + "." + self.lex();
                    self.advance();
                    continue;
                }
                self.report_error("expect type path segment");
                break;
            }
            break;
        }
        if (seg_args.len > 0) {
            let generic_name = full_name.clone() + "::<" + seg_args + ">";
            return self.finish_type_suffix(tref_alloc(k, generic_name));
        }
        let base_ty = tref_alloc(k, full_name.clone());
        if (self.check(tk_LBRACKET())) {
            self.advance();
            let index_expr = self.parse_expr();
            self.expect_kind(tk_RBRACKET(), "']'");
            let index_text = self.expr_text_for_type(index_expr);
            return self.finish_type_suffix(tref_alloc(ty_CLASS(),
                                                       full_name.clone()
                                                       + "["
                                                       + index_text
                                                       + "]"));
        }
        return self.finish_type_suffix(base_ty);
    }

    // ── Expression precedence chain (low → high) ────────────────────
    //
    //     parse_assign       =  +=  -=  *=  /=  %=  <<=  >>=  &=  |=  ^=
    //                          (right-assoc)
    //     parse_ternary      cond ? a : b   (right-assoc; below assign,
    //                                         above logical-or)
    //     parse_coalesce     ??             (right-assoc)
    //     parse_range        ..  ..=
    //     parse_pipe         |>
    //     parse_logic_or    ||
    //     parse_logic_and   &&
    //     parse_bit_or      |
    //     parse_bit_xor     ^
    //     parse_bit_and     &
    //     parse_equality    == !=
    //     parse_relation    <  <=  >  >=
    //     parse_shift       << >>
    //     parse_add          +  -
    //     parse_mul          *  /
    //     parse_cast         as T   (below unary, above * / % — `&n as *T`
    //                                is `(&n) as *T`, matching Rust)
    //     parse_unary       !x  -x  &x
    //     parse_call_member f(…)   o.x   a[i]   (postfix)
    //     parse_primary     literals / identifier / ( expr )

    public fn parse_expr(self) -> rawptr {
        return self.parse_assign();
    }

    public fn parse_assign(self) -> rawptr {
        let lhs = self.parse_ternary();
        let ak = self.kind();
        if (ak == tk_EQ()
            || ak == tk_PLUSEQ() || ak == tk_MINUSEQ()
            || ak == tk_STAREQ() || ak == tk_SLASHEQ() || ak == tk_PERCENTEQ()
            || ak == tk_LSHIFTEQ() || ak == tk_RSHIFTEQ()
            || ak == tk_AMPEQ() || ak == tk_PIPEEQ() || ak == tk_CARETEQ()) {
            self.advance();
            let rhs = self.parse_assign();
            let e = expr_alloc(ex_ASSIGN());
            expr_set_op(e, ak);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            return e;
        }
        return lhs;
    }

    /// Ternary `cond ? a : b`. Right-associative; both branches accept a
    /// full assignment-expression so `cond ? x = 1 : y = 2` is grouped as
    /// `cond ? (x = 1) : (y = 2)` exactly like C/C++.
    ///
    /// Storage in the resulting `ex_TERNARY` node:
    ///   lhs  = cond
    ///   rhs  = then-branch
    ///   args = else-branch (single Expr*, NOT a stmt-cell chain)
    public fn parse_ternary(self) -> rawptr {
        let cond = self.parse_coalesce();
        if (self.kind() == tk_QUESTION()) {
            self.advance();
            let then_e = self.parse_assign();
            self.expect_kind(tk_COLON(), "':' in ternary expression");
            let else_e = self.parse_assign();
            let e = expr_alloc(ex_TERNARY());
            expr_set_lhs(e, cond);
            expr_set_rhs(e, then_e);
            expr_set_args(e, else_e);
            return e;
        }
        return cond;
    }

    public fn parse_coalesce(self) -> rawptr {
        let lhs = self.parse_range();
        if (self.kind() == tk_QUESTIONQUESTION()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_coalesce();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            return e;
        }
        return lhs;
    }

    public fn parse_range(self) -> rawptr {
        var lhs = self.parse_pipe();
        if (self.kind() == tk_DOTDOT() || self.kind() == tk_DOTDOTEQ()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_pipe();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_pipe(self) -> rawptr {
        var lhs = self.parse_logic_or();
        while (self.kind() == tk_PIPEARROW()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_logic_or();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_logic_or(self) -> rawptr {
        var lhs = self.parse_logic_and();
        while (self.kind() == tk_OR()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_logic_and();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_logic_and(self) -> rawptr {
        var lhs = self.parse_bit_or();
        while (self.kind() == tk_AND()) {
            let op = self.kind();
            if (parser_mark_pack_fold(lhs, "...&&")) {
                self.advance();
                return lhs;
            }
            self.advance();
            let rhs = self.parse_bit_or();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_bit_or(self) -> rawptr {
        var lhs = self.parse_bit_xor();
        while (self.kind() == tk_PIPE()) {
            let op = self.kind();
            if (parser_mark_pack_fold(lhs, "...|")) {
                self.advance();
                return lhs;
            }
            self.advance();
            let rhs = self.parse_bit_xor();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_bit_xor(self) -> rawptr {
        var lhs = self.parse_bit_and();
        while (self.kind() == tk_CARET()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_bit_and();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_bit_and(self) -> rawptr {
        var lhs = self.parse_equality();
        while (self.kind() == tk_AMP()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_equality();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_equality(self) -> rawptr {
        var lhs = self.parse_relation();
        while (self.kind() == tk_EQEQ() || self.kind() == tk_NEQ()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_relation();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_relation(self) -> rawptr {
        var lhs = self.parse_shift();
        while (self.kind() == tk_LT() || self.kind() == tk_LE()
            || self.kind() == tk_GT() || self.kind() == tk_GE()
            || self.kind() == tk_MATCHOP()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_shift();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_shift(self) -> rawptr {
        var lhs = self.parse_add();
        while (self.kind() == tk_LSHIFT() || self.kind() == tk_RSHIFT()) {
            let op = self.kind();
            self.advance();
            let rhs = self.parse_add();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_add(self) -> rawptr {
        var lhs = self.parse_mul();
        while (self.kind() == tk_PLUS() || self.kind() == tk_MINUS()) {
            let op = self.kind();
            if (op == tk_PLUS()) {
                if (parser_mark_pack_fold(lhs, "...+")) {
                    self.advance();
                    return lhs;
                }
            }
            if (op == tk_MINUS()) {
                if (parser_mark_pack_fold(lhs, "...-")) {
                    self.advance();
                    return lhs;
                }
            }
            self.advance();
            let rhs = self.parse_mul();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_mul(self) -> rawptr {
        var lhs = self.parse_cast();
        while (self.kind() == tk_STAR() || self.kind() == tk_SLASH() || self.kind() == tk_PERCENT()) {
            let op = self.kind();
            if (op == tk_STAR()) {
                if (parser_mark_pack_fold(lhs, "...*")) {
                    self.advance();
                    return lhs;
                }
            }
            self.advance();
            let rhs = self.parse_cast();
            let e = expr_alloc(ex_BIN());
            expr_set_op(e, op);
            expr_set_lhs(e, lhs);
            expr_set_rhs(e, rhs);
            lhs = e;
        }
        return lhs;
    }

    fn parse_new_array_brace_init(self) -> rawptr {
        self.expect_kind(tk_LBRACE(), "'{' after allocated array type");
        let array_init = expr_alloc(ex_ARRAY_LIT());
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let value = self.parse_expr();
            let cell = stmt_alloc(st_EXPR());
            stmt_set_init(cell, value);
            if (head == null) {
                head = cell;
                tail = cell;
            } else {
                stmt_set_next(tail, cell);
                tail = cell;
            }
            if (!self.accept(tk_COMMA())) { break; }
        }
        self.expect_kind(tk_RBRACE(), "'}' after allocated array initializer");
        expr_set_args(array_init, head);
        return array_init;
    }

    fn parse_new_brace_init(self, allocated_ty: rawptr, allocated_name: string) -> rawptr {
        if (allocated_ty != null && tref_get_kind(allocated_ty) == ty_ARRAY()) {
            return self.parse_new_array_brace_init();
        }
        return self.parse_struct_init(allocated_name);
    }

    fn parse_new_expr(self) -> rawptr {
        self.advance(); // contextual `new`
        var flags: i32 = 0;
        var allocated_ty: rawptr = null;
        let saved_elem_first = self.array_elem_first_ctx;
        self.array_elem_first_ctx = true;
        if (self.accept(tk_COLONCOLON())) {
            flags = flags | new_expr_generic_form();
            self.expect_kind(tk_LT(), "'<' after new::");
            allocated_ty = self.parse_type();
            self.expect_kind(tk_GT(), "'>' after new::<T");
        } else {
            allocated_ty = self.parse_type();
        }
        self.array_elem_first_ctx = saved_elem_first;
        if (allocated_ty == null) {
            allocated_ty = tref_alloc(ty_RAWPTR(), "");
        }
        let allocated_name = self.type_ref_text(allocated_ty);
        let e = expr_alloc(ex_NEW());
        expr_set_captures(e, allocated_ty);
        expr_set_name(e, allocated_name);

        if (self.accept(tk_LPAREN())) {
            var first_args = self.parse_call_args();
            self.expect_kind(tk_RPAREN(), "')' after new initializer");
            flags = flags | new_expr_has_paren_init();
            if (first_args == null) { flags = flags | new_expr_empty_init(); }

            // Generic allocation accepts an optional allocator group:
            // `new::<T>(allocator)(args...)` / `new::<T>(allocator){...}`.
            // A single group remains the ordinary initializer.
            if ((flags & new_expr_generic_form()) != 0
                && first_args != null
                && stmt_get_next(first_args) == null
                && (self.kind() == tk_LPAREN() || self.kind() == tk_LBRACE())) {
                expr_set_lhs(e, stmt_get_init(first_args));
                flags = flags | new_expr_has_allocator();
                flags = flags & (0 - (new_expr_empty_init() + 1));
                if (self.accept(tk_LPAREN())) {
                    let init_args = self.parse_call_args();
                    self.expect_kind(tk_RPAREN(), "')' after allocated value initializer");
                    expr_set_args(e, init_args);
                    if (init_args == null) { flags = flags | new_expr_empty_init(); }
                } else {
                    expr_set_rhs(e, self.parse_new_brace_init(allocated_ty, allocated_name));
                    flags = flags | new_expr_has_brace_init();
                }
            } else {
                expr_set_args(e, first_args);
            }
        } else if (self.kind() == tk_LBRACE()) {
            expr_set_rhs(e, self.parse_new_brace_init(allocated_ty, allocated_name));
            flags = flags | new_expr_has_brace_init();
        } else {
            self.report_error("new requires '(...)' or '{...}' initializer");
        }
        expr_set_op(e, flags);
        return e;
    }

    fn parse_delete_expr(self) -> rawptr {
        self.advance(); // contextual `delete`
        let e = expr_alloc(ex_DELETE());
        if (self.accept(tk_COLONCOLON())) {
            self.expect_kind(tk_LT(), "'<' after delete::");
            let payload_ty = self.parse_type();
            self.expect_kind(tk_GT(), "'>' after delete::<T");
            expr_set_captures(e, payload_ty);
            expr_set_name(e, self.type_ref_text(payload_ty));
            if (self.accept(tk_LPAREN())) {
                let allocator_args = self.parse_call_args();
                self.expect_kind(tk_RPAREN(), "')' after delete allocator");
                if (allocator_args == null || stmt_get_next(allocator_args) != null) {
                    self.report_error("delete allocator group requires exactly one allocator");
                } else {
                    expr_set_rhs(e, stmt_get_init(allocator_args));
                }
            }
        }
        expr_set_lhs(e, self.parse_unary());
        return e;
    }

    /// `as` is a cast operator below unary and above multiplicative ops.
    /// `&n as *T` is therefore `(&n) as *T`, not `&(n as *T)`.
    public fn parse_cast(self) -> rawptr {
        var lhs = self.parse_unary();
        while (self.lex() == "as") {
            self.advance();
            // Restore rather than simply clear: `as` chains (`x as T as U`)
            // and any outer cast-target context must round-trip.
            let saved_cast_ctx = self.cast_target_ctx;
            self.cast_target_ctx = true;
            let target_ty = self.parse_type();
            self.cast_target_ctx = saved_cast_ctx;
            let e = expr_alloc(ex_CAST());
            expr_set_lhs(e, lhs);
            expr_set_ty(e, target_ty);
            lhs = e;
        }
        return lhs;
    }

    public fn parse_unary(self) -> rawptr {
        let k = self.kind();
        if (k == tk_IDENT() && self.lex() == "new") {
            return self.parse_new_expr();
        }
        if (k == tk_IDENT() && self.lex() == "delete") {
            return self.parse_delete_expr();
        }
        if (k == tk_IDENT() && self.lex() == "own") {
            self.report_error("`own` is only valid as `own self`");
            self.advance();
            return self.parse_unary();
        }
        if (k == tk_KEYWORD_AWAIT()) {
            self.advance();
            let operand = self.parse_unary();
            let e = expr_alloc(ex_AWAIT());
            expr_set_lhs(e, operand);
            return e;
        }
        if (k == tk_IDENT() && self.lex() == "try") {
            self.advance();
            let operand2 = self.parse_unary();
            let e2 = expr_alloc(ex_UNARY());
            expr_set_op(e2, tk_QUESTION());
            expr_set_lhs(e2, operand2);
            return e2;
        }
        if (k == tk_NOT() || k == tk_MINUS() || k == tk_TILDE()
            || k == tk_PLUSPLUS() || k == tk_MINUSMINUS()) {
            self.advance();
            let operand = self.parse_unary();
            let e = expr_alloc(ex_UNARY());
            expr_set_op(e, k);
            expr_set_lhs(e, operand);
            return e;
        }
        if (k == tk_AMP()) {
            self.advance();
            var is_mut = 0;
            if (self.kind() == tk_KEYWORD_MUT()) {
                is_mut = 1;
                self.advance();
            }
            let operand = self.parse_unary();
            let e = expr_alloc(ex_ADDR_OF());
            expr_set_op(e, is_mut);
            expr_set_lhs(e, operand);
            return e;
        }
        // Prefix `*expr` — typed/raw pointer dereference. Lives in
        // parse_unary (not parse_factor) because parse_factor's while-loop
        // only sees `*` as the multiplicative *infix* operator after a
        // valid lhs has been consumed; in *prefix* position the token can
        // only mean deref. Sema (ex_DEREF) already pulls the element
        // TypeRef off `lhs.ty`; codegen then lowers to `load <elem>, ptr`.
        if (k == tk_STAR()) {
            self.advance();
            let operand = self.parse_unary();
            let e = expr_alloc(ex_DEREF());
            expr_set_lhs(e, operand);
            return e;
        }
        if (k == tk_KEYWORD_COMPTIME()) {
            self.advance();
            let operand = self.parse_unary();
            let e = expr_alloc(ex_COMPTIME());
            expr_set_lhs(e, operand);
            return e;
        }
        return self.parse_call_member();
    }

    /// Flatten `ident` / `a.b.c` member chains into a type-path spelling.
    /// Returns "" when the prefix is not a pure name chain (call, index, …).
    public fn flatten_expr_path_name(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) { return expr_get_name(e); }
        if (k == ex_MEMBER()) {
            let lhs_name = self.flatten_expr_path_name(expr_get_lhs(e));
            if (lhs_name.len == 0) { return ""; }
            let member = expr_get_name(e);
            if (member.len == 0) { return ""; }
            return lhs_name + "." + member;
        }
        return "";
    }

    public fn parse_call_member(self) -> rawptr {
        var lhs = self.parse_primary();
        // Struct/class instance literal: `IDENT { f1: e1, f2: e2 }` or
        // `alias.Type { … }` / `module.Type { … }`.
        // Detected as a *prefix* of the postfix chain so subsequent
        // `.method()` / `[i]` postfixes still apply on the result.
        // Statement-level `{` blocks are routed through `parse_block` from
        // `parse_stmt`, so this lookahead does not collide with block syntax.
        if (!self.suppress_struct_literal_ctx && lhs != null && self.kind() == tk_LBRACE()) {
            let cls_name = self.flatten_expr_path_name(lhs);
            if (cls_name.len > 0) {
                let init = self.parse_struct_init(cls_name);
                if (init != null) { lhs = init; }
            }
        }
        var pending_turbofish: string = "";
        while (true) {
            let k = self.kind();
            if (k == tk_COLONCOLON()) {
                if (pending_turbofish.len > 0 && lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                    let base_name = expr_get_name(lhs).clone();
                    expr_set_name(lhs, base_name + "::<" + pending_turbofish + ">");
                    pending_turbofish = "";
                } else if (pending_turbofish.len > 0 && lhs != null && expr_get_kind(lhs) == ex_MEMBER()) {
                    let base_name2 = expr_get_name(lhs).clone();
                    expr_set_name(lhs, base_name2 + "::<" + pending_turbofish + ">");
                    pending_turbofish = "";
                }
                self.advance();
                if (self.accept(tk_LT())) {
                    var depth: i32 = 1;
                    var args_text: string = "";
                    while (depth > 0 && self.kind() != tk_EOF()) {
                        if (self.kind() == tk_LT()) {
                            depth = depth + 1;
                            if (depth > 1) {
                                args_text = args_text + self.lex();
                            }
                        } else if (self.kind() == tk_GT()) {
                            depth = depth - 1;
                            if (depth > 0) {
                                args_text = args_text + self.lex();
                            }
                        } else if (self.kind() == tk_RSHIFT()) {
                            let before_shift2 = depth;
                            if (before_shift2 > 1) { args_text = args_text + ">"; }
                            if (before_shift2 > 2) { args_text = args_text + ">"; }
                            depth = depth - 2;
                        } else {
                            args_text = args_text + self.lex();
                        }
                        self.advance();
                    }
                    pending_turbofish = args_text;
                } else if (self.kind() == tk_IDENT()) {
                    let name = self.lex();
                    self.advance();
                    let e = expr_alloc(ex_MEMBER());
                    expr_set_lhs(e, lhs);
                    expr_set_name(e, name);
                    lhs = e;
                }
            } else if (k == tk_LT()
                    && lhs != null
                    && (expr_get_kind(lhs) == ex_IDENT() || expr_get_kind(lhs) == ex_MEMBER())
                    && self.flatten_expr_path_name(lhs).len > 0
                    && self.is_plain_generic_postfix()) {
                // Type arguments on a (possibly qualified) type path, e.g.
                // `FreqArray<i32>::A<f32>(…)`.
                pending_turbofish = self.read_angle_payload_text();
            } else if (k == tk_AT()
                    && lhs != null
                    && (expr_get_kind(lhs) == ex_IDENT()
                        || expr_get_kind(lhs) == ex_MEMBER())) {
                let selector = self.parse_version_selector_suffix();
                if (selector.len > 0) {
                    expr_set_name(lhs, expr_get_name(lhs) + selector);
                }
            } else if (k == tk_LPAREN()) {
                // NOTE: `Outer<i32>::Inner<f32>(…)` (a hoisted nested record's
                // constructor written as a qualified path) is deliberately
                // *not* flattened here.  At parse time `w.map::<i64>(dbl)` --
                // a generic method on a value receiver -- has exactly the same
                // shape (two path segments + a turbofish), so any flattening
                // rule would be a coin flip: it turned the `w.map` receiver
                // into a module selector and sema reported
                // `undefined function 'w.map'`.  Resolution needs symbol
                // information, so it happens in sema instead
                // (`resolve_nested_record_ctor_call` consumes this very
                // `ex_MEMBER` + turbofish spelling and rewrites the callee
                // once it has confirmed the receiver is a *type* path).
                if (pending_turbofish.len > 0 && lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                    let base_name3 = expr_get_name(lhs).clone();
                    expr_set_name(lhs, base_name3 + "::<" + pending_turbofish + ">");
                    pending_turbofish = "";
                } else if (pending_turbofish.len > 0 && lhs != null && expr_get_kind(lhs) == ex_MEMBER()) {
                    let base_name4 = expr_get_name(lhs).clone();
                    expr_set_name(lhs, base_name4 + "::<" + pending_turbofish + ">");
                    pending_turbofish = "";
                }
                self.advance();
                let args = self.parse_call_args();
                self.expect_kind(tk_RPAREN(), "')'");
                let e = expr_alloc(ex_CALL());
                expr_set_lhs(e, lhs);
                expr_set_args(e, args);
                lhs = e;
            } else if (k == tk_DOT()) {
                if (pending_turbofish.len > 0 && lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                    let base_name5 = expr_get_name(lhs).clone();
                    expr_set_name(lhs, base_name5 + "::<" + pending_turbofish + ">");
                    pending_turbofish = "";
                }
                self.advance();
                if (self.kind() != tk_IDENT() && self.kind() != tk_INT() && self.lex() != "as") {
                    self.report_error("expect field name after '.'");
                    return lhs;
                }
                let name = self.lex();
                self.advance();
                let e = expr_alloc(ex_MEMBER());
                expr_set_lhs(e, lhs);
                expr_set_name(e, name);
                lhs = e;
            } else if (k == tk_ARROW()) {
                // Typed pointers use `->` as an explicit member-access
                // spelling.  Keep the resulting node as ex_MEMBER so sema,
                // HIR, MIR, and both lowerers share the exact same lookup and
                // receiver ABI as `.` on references.
                self.advance();
                if (self.kind() != tk_IDENT() && self.kind() != tk_INT() && self.lex() != "as") {
                    self.report_error("expect field name after '->'");
                    return lhs;
                }
                let name = self.lex();
                self.advance();
                let e = expr_alloc(ex_MEMBER());
                expr_set_lhs(e, lhs);
                expr_set_name(e, name);
                expr_set_op(e, expr_member_access_arrow());
                lhs = e;
            } else if (k == tk_LBRACKET()) {
                self.advance();
                let idx = self.parse_expr();
                self.expect_kind(tk_RBRACKET(), "']'");
                let e = expr_alloc(ex_INDEX());
                expr_set_lhs(e, lhs);
                expr_set_rhs(e, idx);
                lhs = e;
            } else if (!self.suppress_struct_literal_ctx && k == tk_LBRACE() && lhs != null) {
                var cls_name = self.flatten_expr_path_name(lhs);
                if (cls_name.len > 0) {
                    if (pending_turbofish.len > 0) {
                        cls_name = cls_name.clone() + "::<" + pending_turbofish + ">";
                        pending_turbofish = "";
                    }
                    // `Outer<i32>::Inner { … }` refers to a hoisted nested
                    // record: flatten the qualified path into its single
                    // dotted record name with all type arguments collected.
                    cls_name = parser_canonical_type_path(cls_name);
                    let init = self.parse_struct_init(cls_name);
                    if (init != null) { lhs = init; }
                } else {
                    return lhs;
                }
            } else if (k == tk_QUESTION()) {
                // Disambiguate postfix try-`?` from ternary `cond ? a : b`.
                // Postfix `?` only fires when the next token is a
                // statement / argument terminator; otherwise yield to
                // parse_ternary at the outer expression level.
                let next_idx = self.cur_idx + 1;
                let next_tok = lex_token_at(self.lex_handle, next_idx);
                let nk = token_kind(next_tok);
                if (nk == tk_SEMI() || nk == tk_COMMA()
                    || nk == tk_RPAREN() || nk == tk_RBRACE()
                    || nk == tk_RBRACKET() || nk == tk_EOF()) {
                    self.advance();
                    let e = expr_alloc(ex_UNARY());
                    expr_set_op(e, tk_QUESTION());
                    expr_set_lhs(e, lhs);
                    lhs = e;
                } else {
                    return lhs;
                }
            } else if (k == tk_ELLIPSIS()) {
                self.advance();
                var fold_suffix: string = "...";
                let fold_op = self.kind();
                if (fold_op == tk_PLUS() || fold_op == tk_MINUS()
                    || fold_op == tk_STAR() || fold_op == tk_AND()
                    || fold_op == tk_PIPE()) {
                    if (fold_op == tk_PLUS()) { fold_suffix = "...+"; }
                    if (fold_op == tk_MINUS()) { fold_suffix = "...-"; }
                    if (fold_op == tk_STAR()) { fold_suffix = "...*"; }
                    if (fold_op == tk_AND()) { fold_suffix = "...&&"; }
                    if (fold_op == tk_PIPE()) { fold_suffix = "...|"; }
                    self.advance();
                }
                if (lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                    expr_set_name(lhs, expr_get_name(lhs) + fold_suffix);
                }
            } else if (k == tk_PLUSPLUS() || k == tk_MINUSMINUS()) {
                let e = expr_alloc(ex_UNARY());
                expr_set_op(e, k);
                expr_set_lhs(e, lhs);
                lhs = e;
                self.advance();
            } else {
                return lhs;
            }
        }
        return lhs;
    }

    /// Parse `,`-separated arg list until (but not including) `)`. Each
    /// argument is wrapped in a `ST_EXPR` Stmt cell so the linked-list
    /// convention (head via `init`, tail via `next`) holds.
    public fn parse_call_args(self) -> rawptr {
        if (self.kind() == tk_RPAREN()) { return null; }
        var head: rawptr = null;
        var tail: rawptr = null;
        var first_name: string = "";
        var first_expr = self.parse_expr();
        if (self.accept(tk_COLON())) {
            if (first_expr != null && expr_get_kind(first_expr) == ex_IDENT()) {
                first_name = expr_get_name(first_expr);
            }
            first_expr = self.parse_expr();
        }
        let first_cell = stmt_alloc(st_EXPR());
        stmt_set_name(first_cell, first_name);
        stmt_set_init(first_cell, first_expr);
        head = first_cell;
        tail = first_cell;
        while (self.kind() == tk_COMMA()) {
            self.advance();
            var arg_name: string = "";
            var arg_expr = self.parse_expr();
            if (self.accept(tk_COLON())) {
                if (arg_expr != null && expr_get_kind(arg_expr) == ex_IDENT()) {
                    arg_name = expr_get_name(arg_expr);
                }
                arg_expr = self.parse_expr();
            }
            let cell = stmt_alloc(st_EXPR());
            stmt_set_name(cell, arg_name);
            stmt_set_init(cell, arg_expr);
            stmt_set_next(tail, cell);
            tail = cell;
        }
        return head;
    }

    /// `{ field: expr [, field: expr]* [,]? }` — struct/class literal
    /// payload, called from `parse_call_member` once an `IDENT {` prefix
    /// has been recognised. The leading `{` is still on the cursor when
    /// we enter; we consume it here.
    ///
    /// Each field becomes a `Stmt(ST_EXPR)` cell with `name = field`,
    /// `init = value Expr`, `next` linking to the next cell. The chain
    /// is hung off the Expr's `args` slot so codegen / sema can iterate
    /// with the same `expr_get_args` + `stmt_get_init` walk used for
    /// call argument lists.
    public fn parse_struct_init(self, cls_name: string) -> rawptr {
        self.advance();   // consume '{'
        let e = expr_alloc(ex_STRUCT_INIT());
        expr_set_name(e, cls_name);
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            var field_name: string = "";
            var val: rawptr = null;
            if (self.is_soft_name_token()) {
                let saved_idx = self.cur_idx;
                let candidate = self.parse_soft_name("field name in struct init");
                if (self.kind() == tk_COLON()) {
                    // Named field cell: `Vec { data: d, len: 0 }`.
                    self.advance();
                    field_name = candidate;
                    val = self.parse_expr();
                } else {
                    // Positional list-init cell (`Vec<i32>{1, 2, 3}`): the
                    // soft-name token was the value expression itself.
                    // Backtrack and re-parse it as an ordinary expression;
                    // the empty cell name marks it for the list-init path.
                    self.cur_idx = saved_idx;
                    val = self.parse_expr();
                }
            } else {
                // Positional list-init cell with a non-name first token.
                val = self.parse_expr();
            }
            if (val != null) {
                let cell = stmt_alloc(st_EXPR());
                stmt_set_name(cell, field_name);
                stmt_set_init(cell, val);
                if (head == null) { head = cell; tail = cell; }
                else {
                    stmt_set_next(tail, cell);
                    tail = cell;
                }
            }
            if (self.kind() == tk_COMMA()) { self.advance(); }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close struct init");
        expr_set_args(e, head);
        return e;
    }

    /// Parse the inner content of an f-string. `raw` is the lexeme with
    /// surrounding quotes — e.g. `"hello {name} world"`. Builds a single
    /// `ex_FSTRING` node whose `args` field holds a stmt-cell chain of
    /// alternating literal / interpolation segments.
    ///
    /// MCP-2 (lexer) handshake: parser is agnostic about whether the lexer
    /// emitted `IDENT("f") + STRING(raw)` (current path) or a single
    /// `tk_FSTRING_RAW`; both routes converge here with the original quoted
    /// lexeme. Sema / codegen consume the segment chain and decide whether
    /// each interpolation segment needs `.toString()` lowering.
    public fn parse_fstring_inner(self, raw: string, source_line: i32, source_col: i32) -> rawptr {
        // Split source spelling first. Decoding the entire token would erase
        // escaped quotes/backslashes that the embedded expression still needs.
        var s = raw;
        var quote_offset: i32 = 0;
        if (raw.len >= 2 && raw.charAt(0) == 34 && raw.charAt((raw.len - 1) as i32) == 34) {
            s = str_view_range(raw, 1, (raw.len - 1) as i32);
            quote_offset = 1;
        }

        let fs = expr_alloc(ex_FSTRING());
        expr_set_str_val(fs, s.clone());

        var head: rawptr = null;
        var tail: rawptr = null;

        var pos: i64 = 0;
        let slen = s.len;
        while (pos < slen) {
            var marker: i64 = -1;
            var j = pos;
            while (j + 1 < slen) {
                if (s.charAt(j as i32) == 92) { j = j + 2; continue; }
                if (s.charAt(j as i32) == 36
                    && s.charAt((j + 1) as i32) == 123) {
                    marker = j;
                    break;
                }
                j = j + 1;
            }

            var end_text = slen;
            if (marker >= 0) { end_text = marker; }
            if (end_text > pos) {
                let lit = str_view_range(s, pos as i32, end_text as i32);
                let lit_e = expr_alloc(ex_STR_LIT());
                expr_set_str_val(lit_e, string_token_to_cooked("\"" + lit + "\""));
                let cell = stmt_alloc(st_EXPR());
                stmt_set_name(cell, "lit");
                stmt_set_init(cell, lit_e);
                if (head == null) {
                    head = cell;
                    tail = cell;
                } else {
                    stmt_set_next(tail, cell);
                    tail = cell;
                }
            }
            if (marker < 0) { break; }

            let expr_start = marker + 2;
            let expr_end = lexer_interpolation_end(s, expr_start as i32, 0) as i64;
            if (expr_end < 0) {
                self.report_error("expect '}' to close string interpolation");
                break;
            }

            let expr_text = str_view_range(s, expr_start as i32, expr_end as i32);
            var expr_line = source_line;
            var expr_col = source_col + quote_offset;
            var loc_pos: i64 = 0;
            while (loc_pos < expr_start) {
                if (s.charAt(loc_pos as i32) == 10) {
                    expr_line = expr_line + 1;
                    expr_col = 1;
                } else { expr_col = expr_col + 1; }
                loc_pos = loc_pos + 1;
            }
            let inner_e = self.fstring_parse_expr_text(expr_text, expr_line, expr_col);
            if (inner_e != null) {
                let cell = stmt_alloc(st_EXPR());
                stmt_set_name(cell, "expr");
                stmt_set_init(cell, inner_e);
                if (head == null) {
                    head = cell;
                    tail = cell;
                } else {
                    stmt_set_next(tail, cell);
                    tail = cell;
                }
            }
            pos = expr_end + 1;
        }

        expr_set_args(fs, head);
        return fs;
    }

    /// Parse an expression segment inside an f-string using the normal
    /// lexer/parser path so interpolation accepts the same expression
    /// grammar as call arguments and let initializers.
    fn fstring_parse_expr_text(self, text: string, source_line: i32, source_col: i32) -> rawptr {
        if (text.len == 0) { self.report_error("expect interpolation expression"); return null; }
        let h = lex_source_at(text, source_line, source_col);
        if (h == null) { return null; }
        let p = Parser.create(h);
        let e = p.parse_expr();
        if (p.kind() != tk_EOF()) { p.report_error("unexpected token after interpolation expression"); }
        self.error_count = self.error_count + lex_error_count(h) + p.error_count;
        lexer_dispose(h);
        ast_set_current_loc(self.line(), self.col());
        return e;
    }

    /// Wrap an expression in a `.toString()` method call.
    fn make_to_string_call(self, receiver: rawptr) -> rawptr {
        let member = expr_alloc(ex_MEMBER());
        expr_set_lhs(member, receiver);
        expr_set_name(member, "toString");
        let call = expr_alloc(ex_CALL());
        expr_set_lhs(call, member);
        return call;
    }

    public fn parse_primary(self) -> rawptr {
        let k = self.kind();

        if (k == tk_KEYWORD_FN() && self.kind_at(self.cur_idx + 1) == tk_LPAREN()) {
            self.advance();
            self.expect_kind(tk_LPAREN(), "'('");
            var params_head_fn: rawptr = null;
            var params_tail_fn: rawptr = null;
            if (self.kind() != tk_RPAREN()) {
                var cont_fn: bool = true;
                while (cont_fn) {
                    let pname_fn = self.parse_soft_name("parameter name");
                    let pd_fn = decl_alloc(de_FIELD(), pname_fn);
                    if (self.accept(tk_COLON())) {
                        decl_set_ty(pd_fn, self.parse_type());
                    }
                    if (params_head_fn == null) {
                        params_head_fn = pd_fn;
                        params_tail_fn = pd_fn;
                    } else {
                        decl_set_next(params_tail_fn, pd_fn);
                        params_tail_fn = pd_fn;
                    }
                    if (!self.accept(tk_COMMA())) { cont_fn = false; }
                }
            }
            self.expect_kind(tk_RPAREN(), "')'");
            var ret_ty_fn: rawptr = null;
            if (self.accept(tk_ARROW())) {
                ret_ty_fn = self.parse_type();
            }
            var body_fn: rawptr = null;
            if (self.check(tk_LBRACE())) {
                body_fn = self.parse_block();
            } else {
                let rexpr_fn = self.parse_expr();
                let rs_fn = stmt_alloc(st_RETURN());
                stmt_set_init(rs_fn, rexpr_fn);
                body_fn = rs_fn;
            }
            let e_fn = expr_alloc(ex_CLOSURE());
            expr_set_lhs(e_fn, body_fn);
            expr_set_args(e_fn, params_head_fn);
            expr_set_str_val(e_fn, "fn");
            if (ret_ty_fn != null) {
                expr_set_rhs(e_fn, ret_ty_fn);
            }
            return e_fn;
        }

        if (k == tk_INT()) {
            let lx = self.lex();
            self.advance();
            let e = expr_alloc(ex_INT_LIT());
            expr_set_int_val(e, parse_int_literal(lx));
            expr_set_str_val(e, lx);
            return e;
        }

        if (k == tk_FLOAT()) {
            let lx = self.lex();
            self.advance();
            let e = expr_alloc(ex_INT_LIT());
            expr_set_int_val(e, 0);
            expr_set_str_val(e, lx);
            return e;
        }

        if (k == tk_CHAR()) {
            let lx = self.lex();
            self.advance();
            let e = expr_alloc(ex_CHAR_LIT());
            expr_set_int_val(e, parse_char_codepoint(lx));
            expr_set_str_val(e, lx);
            return e;
        }

        if (k == tk_FSTRING_RAW()) {
            let raw = self.lex();
            let source_line = self.line();
            let source_col = self.col();
            self.advance();
            return self.parse_fstring_inner(raw, source_line, source_col);
        }

        if (k == tk_STRING()) {
            let lx = self.lex();
            let source_line = self.line();
            let source_col = self.col();
            self.advance();
            if (parser_raw_string_has_interpolation(lx)) {
                return self.parse_fstring_inner(lx, source_line, source_col);
            }
            let e = expr_alloc(ex_STR_LIT());
            expr_set_str_val(e, string_token_to_cooked(lx));
            return e;
        }

        if (k == tk_BOOL()) {
            let lx = self.lex();
            self.advance();
            let e = expr_alloc(ex_BOOL_LIT());
            if (lx == "true") { expr_set_int_val(e, 1); } else { expr_set_int_val(e, 0); }
            expr_set_str_val(e, lx);
            return e;
        }

        if (k == tk_NULL()) {
            self.advance();
            let e = expr_alloc(ex_NULL_LIT());
            return e;
        }

        if (k == tk_KEYWORD_MATCH()) {
            return self.parse_match_expr();
        }

        if (k == tk_KEYWORD_IF()) {
            return self.parse_if_expr();
        }

        if (k == tk_PIPE() || k == tk_OR()) {
            let zero_arg_closure = (k == tk_OR());
            self.advance();
            // Parse closure params: |name: type, name: type|
            var params_head: rawptr = null;
            var params_tail: rawptr = null;
            if (!zero_arg_closure && self.kind() != tk_PIPE()) {
                var cont: bool = true;
                while (cont) {
                    let pname = self.lex();
                    self.advance();
                    let pd = decl_alloc(de_FIELD(), pname);
                    if (self.accept(tk_COLON())) {
                        decl_set_ty(pd, self.parse_type());
                    }
                    if (params_head == null) {
                        params_head = pd;
                        params_tail = pd;
                    } else {
                        decl_set_next(params_tail, pd);
                        params_tail = pd;
                    }
                    if (!self.accept(tk_COMMA())) { cont = false; }
                }
            }
            if (!zero_arg_closure) {
                self.expect_kind(tk_PIPE(), "'|' after closure params");
            }
            // Parse optional return type
            var ret_ty: rawptr = null;
            if (self.accept(tk_ARROW())) {
                ret_ty = self.parse_type();
            }
            // Parse body
            var body: rawptr = null;
            if (self.check(tk_LBRACE())) {
                body = self.parse_block();
            } else {
                // Single expression body — wrap in a return stmt
                let rexpr = self.parse_expr();
                let rs = stmt_alloc(st_RETURN());
                stmt_set_init(rs, rexpr);
                body = rs;
            }
            let e = expr_alloc(ex_CLOSURE());
            expr_set_lhs(e, body);
            expr_set_args(e, params_head);
            if (ret_ty != null) {
                expr_set_rhs(e, ret_ty);
            }
            return e;
        }

        if (k == tk_LBRACKET() && self.bracket_starts_capture_closure()) {
            self.advance();
            var cap_head: rawptr = null;
            var cap_tail: rawptr = null;
            if (self.kind() != tk_RBRACKET()) {
                var cap_cont: bool = true;
                while (cap_cont) {
                    var by_ref: bool = false;
                    if (self.accept(tk_AMP())) { by_ref = true; }
                    let cap_name = self.parse_soft_name("capture name");
                    let cap_cell = stmt_alloc(st_EXPR());
                    stmt_set_name(cap_cell, cap_name);
                    if (by_ref) {
                        let mark = expr_alloc(ex_BOOL_LIT());
                        expr_set_int_val(mark, 1);
                        stmt_set_cond(cap_cell, mark);
                    }
                    if (!by_ref && self.accept(tk_EQ())) {
                        stmt_set_init(cap_cell, self.parse_expr());
                    }
                    if (cap_head == null) {
                        cap_head = cap_cell;
                        cap_tail = cap_cell;
                    } else {
                        stmt_set_next(cap_tail, cap_cell);
                        cap_tail = cap_cell;
                    }
                    if (!self.accept(tk_COMMA())) { cap_cont = false; }
                }
            }
            self.expect_kind(tk_RBRACKET(), "']'");
            self.expect_kind(tk_LPAREN(), "'(' after closure captures");
            var params_head2: rawptr = null;
            var params_tail2: rawptr = null;
            if (self.kind() != tk_RPAREN()) {
                var cont2: bool = true;
                while (cont2) {
                    let pname2 = self.parse_soft_name("parameter name");
                    let pd2 = decl_alloc(de_FIELD(), pname2);
                    if (self.accept(tk_COLON())) {
                        decl_set_ty(pd2, self.parse_type());
                    }
                    if (params_head2 == null) {
                        params_head2 = pd2;
                        params_tail2 = pd2;
                    } else {
                        decl_set_next(params_tail2, pd2);
                        params_tail2 = pd2;
                    }
                    if (!self.accept(tk_COMMA())) { cont2 = false; }
                }
            }
            self.expect_kind(tk_RPAREN(), "')' after closure params");
            var ret_ty2: rawptr = null;
            if (self.accept(tk_ARROW())) {
                ret_ty2 = self.parse_type();
            }
            self.expect_kind(tk_FATARROW(), "'=>' after closure params");
            var body2: rawptr = null;
            if (self.check(tk_LBRACE())) {
                body2 = self.parse_block();
            } else {
                let rexpr2 = self.parse_expr();
                let rs2 = stmt_alloc(st_RETURN());
                stmt_set_init(rs2, rexpr2);
                body2 = rs2;
            }
            let e2 = expr_alloc(ex_CLOSURE());
            expr_set_lhs(e2, body2);
            expr_set_args(e2, params_head2);
            expr_set_captures(e2, cap_head);
            if (ret_ty2 != null) {
                expr_set_rhs(e2, ret_ty2);
            }
            return e2;
        }

        if (k == tk_LBRACKET()) {
            self.advance(); // consume '['
            let e = expr_alloc(ex_ARRAY_LIT());
            var head: rawptr = null;
            var tail: rawptr = null;
            if (self.kind() != tk_RBRACKET()) {
                let first = self.parse_expr();
                let cell = stmt_alloc(st_EXPR());
                stmt_set_init(cell, first);
                head = cell;
                tail = cell;
                if (self.accept(tk_SEMI())) {
                    expr_set_captures(e, self.parse_expr());
                } else {
                    while (self.accept(tk_COMMA())) {
                        if (self.kind() == tk_RBRACKET()) { break; }
                        let elem = self.parse_expr();
                        let c = stmt_alloc(st_EXPR());
                        stmt_set_init(c, elem);
                        stmt_set_next(tail, c);
                        tail = c;
                    }
                }
            }
            self.expect_kind(tk_RBRACKET(), "']'");
            expr_set_args(e, head);
            return e;
        }

        if (k == tk_KEYWORD_ASM()) {
            self.advance();
            self.expect_kind(tk_LPAREN(), "'(' after asm");
            var template_text: string = "";
            if (self.kind() == tk_STRING()) {
                template_text = string_token_to_cooked(self.lex());
                self.advance();
            } else {
                self.report_error("expect asm template string");
            }
            var constraints: string = "";
            var head_asm: rawptr = null;
            var tail_asm: rawptr = null;
            while (self.accept(tk_COMMA())) {
                if (self.kind() == tk_STRING()) {
                    let cstr = string_token_to_cooked(self.lex());
                    if (constraints.len > 0) { constraints = constraints + ","; }
                    constraints = constraints + cstr;
                    self.advance();
                } else {
                    let operand = self.parse_expr();
                    let cell = stmt_alloc(st_EXPR());
                    stmt_set_init(cell, operand);
                    if (head_asm == null) {
                        head_asm = cell;
                        tail_asm = cell;
                    } else {
                        stmt_set_next(tail_asm, cell);
                        tail_asm = cell;
                    }
                }
            }
            self.expect_kind(tk_RPAREN(), "')' after asm");
            let e = expr_alloc(ex_INLINE_ASM());
            expr_set_str_val(e, template_text);
            expr_set_name(e, constraints);
            expr_set_args(e, head_asm);
            return e;
        }

        if (k == tk_KEYWORD_FAIL() || self.lex() == "fail") {
            self.advance();
            var type_name: string = "";
            var variant_name: string = "";
            var payload: rawptr = null;
            var is_payload: i32 = 0;
            if (self.kind() == tk_IDENT()) {
                type_name = self.lex();
                self.advance();
            } else {
                self.report_error("expect error type after 'fail'");
            }
            if (self.accept(tk_DOT())) {
                if (self.kind() == tk_IDENT()) {
                    variant_name = self.lex();
                    self.advance();
                } else {
                    self.report_error("expect error variant after '.'");
                }
                if (self.accept(tk_DOT())) {
                    if (self.kind() == tk_IDENT() && self.lex() == "with") {
                        self.advance();
                        self.expect_kind(tk_LPAREN(), "'(' after with");
                        if (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                            payload = self.parse_expr();
                        }
                        self.expect_kind(tk_RPAREN(), "')' after fail message");
                    } else {
                        self.report_error("expect 'with' after fail variant '.'");
                    }
                } else if (self.accept(tk_LPAREN())) {
                    if (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                        payload = self.parse_expr();
                    }
                    self.expect_kind(tk_RPAREN(), "')' after fail payload");
                    is_payload = 1;
                }
            }
            let e = expr_alloc(ex_FAIL());
            expr_set_name(e, type_name);
            expr_set_str_val(e, variant_name);
            expr_set_lhs(e, payload);
            expr_set_op(e, is_payload);
            return e;
        }

        if (k == tk_IDENT() || k == tk_KEYWORD_SELF()) {
            let lx = self.lex();
            self.advance();
            if (lx == "sizeof") {
                if (self.accept(tk_ELLIPSIS())) {
                    if (self.check(tk_LPAREN())) {
                        self.skip_balanced(tk_LPAREN(), tk_RPAREN());
                    }
                    let se = expr_alloc(ex_INT_LIT());
                    expr_set_int_val(se, 1);
                    expr_set_str_val(se, "1");
                    return se;
                }
            }
            let e = expr_alloc(ex_IDENT());
            expr_set_name(e, lx);
            return e;
        }

        if (k == tk_LPAREN()) {
            self.advance(); // consume '('
            // Empty tuple ()
            if (self.accept(tk_RPAREN())) {
                return expr_alloc(ex_TUPLE_LIT());
            }
            let first = self.parse_expr();
            // If no comma, it's grouping parens
            if (!self.accept(tk_COMMA())) {
                self.expect_kind(tk_RPAREN(), "')'");
                return first;
            }
            // Tuple literal: (e1, e2, ...)
            let tup = expr_alloc(ex_TUPLE_LIT());
            // Build arg chain: first element
            let cell0 = stmt_alloc(st_EXPR());
            stmt_set_init(cell0, first);
            var tail = cell0;
            while (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                let ei = self.parse_expr();
                let cell = stmt_alloc(st_EXPR());
                stmt_set_init(cell, ei);
                stmt_set_next(tail, cell);
                tail = cell;
                if (!self.accept(tk_COMMA())) { break; }
            }
            self.expect_kind(tk_RPAREN(), "')'");
            expr_set_args(tup, cell0);
            return tup;
        }

        self.report_error("expect primary expression");
        let e = expr_alloc(ex_NULL_LIT());
        return e;
    }

    // ── Statement parsing ───────────────────────────────────────────

    public fn parse_stmt(self) -> rawptr {
        let k = self.kind();
        // Labeled statement: IDENT ':' stmt  (lookahead: IDENT then COLON)
        if (k == tk_IDENT() && self.peek_kind() == tk_COLON()) {
            let label = self.lex();
            self.advance(); // consume IDENT
            self.advance(); // consume ':'
            let inner = self.parse_stmt();
            stmt_set_name(inner, label);
            return inner;
        }
        if (k == tk_KEYWORD_LET())      { return self.parse_let(); }
        if (k == tk_KEYWORD_VAR())      { return self.parse_var(); }
        if (k == tk_KEYWORD_IF())       { return self.parse_if(); }
        if (k == tk_KEYWORD_WHILE())    { return self.parse_while(); }
        if (k == tk_KEYWORD_FOR() || k == tk_KEYWORD_FOREACH()) { return self.parse_for_like(); }
        if (k == tk_KEYWORD_MATCH())    { return self.parse_match_stmt(); }
        if (k == tk_KEYWORD_CASE() || k == tk_KEYWORD_DEFAULT()) { return self.parse_match_arm_stmt(); }
        if (k == tk_KEYWORD_DEFER())    { return self.parse_defer_stmt(); }
        if (k == tk_KEYWORD_UNSAFE())   { return self.parse_unsafe_stmt(); }
        if (k == tk_KEYWORD_STATIC_ASSERT()) { return self.parse_static_assert_stmt(); }
        if (k == tk_KEYWORD_BREAK())    { return self.parse_break(); }
        if (k == tk_KEYWORD_CONTINUE()) { return self.parse_continue(); }
        if (k == tk_KEYWORD_YIELD())    { return self.parse_yield_stmt(); }
        if (k == tk_KEYWORD_RETURN())   { return self.parse_return(); }
        if (k == tk_LBRACE())           { return self.parse_block(); }
        return self.parse_expr_stmt();
    }

    /// `let NAME [: TYPE] = EXPR;` / `let mut NAME` (same as `var`).
    public fn parse_let(self) -> rawptr {
        self.advance();   // consume 'let'
        var kind = st_LET();
        if (self.kind() == tk_KEYWORD_MUT()) {
            self.advance();
            kind = st_VAR();
        }
        let s = stmt_alloc(kind);
        // `volatile` qualifier: `let volatile NAME [: TYPE] = EXPR;`
        // Recorded on the stmt semantic-flags channel so it survives into
        // HIR/MIR local flags without touching the TypeRef layout.
        if (self.kind() == tk_KEYWORD_VOLATILE()) {
            self.advance();
            stmt_set_semantic(s, expr_sem_NONE(), null, stmt_flag_volatile_local());
        }
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect identifier after 'let'");
            self.synchronize_statement();
            return s;
        }
        stmt_set_name(s, self.lex());
        self.advance();
        if (self.accept(tk_COLON())) { stmt_set_ty(s, self.parse_type()); }
        if (self.accept(tk_EQ())) {
            stmt_set_init(s, self.parse_expr());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    /// `var NAME [: TYPE] = EXPR;`
    public fn parse_var(self) -> rawptr {
        self.advance();   // consume 'var'
        let s = stmt_alloc(st_VAR());
        // `volatile` qualifier: `var volatile NAME [: TYPE] = EXPR;`
        if (self.kind() == tk_KEYWORD_VOLATILE()) {
            self.advance();
            stmt_set_semantic(s, expr_sem_NONE(), null, stmt_flag_volatile_local());
        }
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect identifier after 'var'");
            self.synchronize_statement();
            return s;
        }
        stmt_set_name(s, self.lex());
        self.advance();
        if (self.accept(tk_COLON())) { stmt_set_ty(s, self.parse_type()); }
        if (self.accept(tk_EQ())) {
            stmt_set_init(s, self.parse_expr());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    /// `if (cond) { … } [elif (cond) { … }]* [else { … }]?`
    ///
    /// elif chains nest into the previous else_blk slot so the resulting
    /// Stmt tree is a strict if/else binary tree.
    public fn parse_if(self) -> rawptr {
        self.advance();   // consume 'if'
        self.expect_kind(tk_LPAREN(), "'('");
        let s = stmt_alloc(st_IF());
        stmt_set_cond(s, self.parse_expr());
        self.expect_kind(tk_RPAREN(), "')'");
        stmt_set_then_blk(s, self.parse_block());
        if (self.check(tk_KEYWORD_ELIF()) || self.lex() == "elif") {
            stmt_set_else_blk(s, self.parse_if_as_elif());
        } else if (self.accept(tk_KEYWORD_ELSE())) {
            if (self.check(tk_KEYWORD_IF())) {
                stmt_set_else_blk(s, self.parse_if());
            } else {
                stmt_set_else_blk(s, self.parse_block());
            }
        }
        return s;
    }

    public fn parse_if_as_elif(self) -> rawptr {
        self.advance();   // consume 'elif'
        self.expect_kind(tk_LPAREN(), "'('");
        let s = stmt_alloc(st_IF());
        stmt_set_cond(s, self.parse_expr());
        self.expect_kind(tk_RPAREN(), "')'");
        stmt_set_then_blk(s, self.parse_block());
        if (self.check(tk_KEYWORD_ELIF()) || self.lex() == "elif") {
            stmt_set_else_blk(s, self.parse_if_as_elif());
        } else if (self.accept(tk_KEYWORD_ELSE())) {
            if (self.check(tk_KEYWORD_IF())) {
                stmt_set_else_blk(s, self.parse_if());
            } else {
                stmt_set_else_blk(s, self.parse_block());
            }
        }
        return s;
    }

    public fn parse_if_expr(self) -> rawptr {
        self.advance();   // consume 'if'
        return self.parse_if_expr_after_keyword();
    }

    public fn parse_if_expr_after_keyword(self) -> rawptr {
        self.expect_kind(tk_LPAREN(), "'('");
        let e = expr_alloc(ex_IF_EXPR());
        expr_set_lhs(e, self.parse_expr());
        self.expect_kind(tk_RPAREN(), "')'");
        expr_set_rhs(e, self.parse_if_expr_block());
        if (self.check(tk_KEYWORD_ELIF()) || self.lex() == "elif") {
            expr_set_args(e, self.parse_if_expr_as_elif());
        } else if (self.accept(tk_KEYWORD_ELSE())) {
            if (self.check(tk_KEYWORD_IF())) {
                expr_set_args(e, self.parse_if_expr());
            } else {
                expr_set_args(e, self.parse_if_expr_block());
            }
        }
        return e;
    }

    public fn parse_if_expr_as_elif(self) -> rawptr {
        self.advance();   // consume 'elif'
        return self.parse_if_expr_after_keyword();
    }

    /// `while (cond) { … }`
    public fn parse_while(self) -> rawptr {
        self.advance();   // consume 'while'
        self.expect_kind(tk_LPAREN(), "'('");
        let s = stmt_alloc(st_WHILE());
        stmt_set_cond(s, self.parse_expr());
        self.expect_kind(tk_RPAREN(), "')'");
        stmt_set_body(s, self.parse_block());
        return s;
    }

    public fn parse_break(self) -> rawptr {
        self.advance();
        let s = stmt_alloc(st_BREAK());
        if (self.kind() == tk_IDENT()) {
            stmt_set_name(s, self.lex());
            self.advance();
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    public fn parse_continue(self) -> rawptr {
        self.advance();
        let s = stmt_alloc(st_CONTINUE());
        if (self.kind() == tk_IDENT()) {
            stmt_set_name(s, self.lex());
            self.advance();
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    /// `return [expr] ;`
    public fn parse_return(self) -> rawptr {
        self.advance();
        let s = stmt_alloc(st_RETURN());
        if (self.kind() != tk_SEMI()) {
            stmt_set_init(s, self.parse_expr());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    public fn parse_for_collection_expr(self) -> rawptr {
        // `for x in <path> { body }` — the `{` opens the loop body, never a
        // struct/class instance literal.  Accept a bare identifier or a
        // `::`-qualified path (`T::fields`, `pkg::T::fields`), which is what
        // reflection-style iteration and qualified statics use.  Without this
        // the path parse reaches `parse_call_member`, sees `IDENT {`, and
        // commits to a struct literal, so the body is consumed as field
        // initializers and the user sees `expected ':'`.
        if (self.kind() == tk_IDENT()) {
            let saved_idx = self.cur_idx;
            let saved_cur = self.cur;
            var e = expr_alloc(ex_IDENT());
            expr_set_name(e, self.lex());
            self.advance();
            while (self.kind() == tk_COLONCOLON()
                   && self.kind_at(self.cur_idx + 1) == tk_IDENT()) {
                self.advance();
                let seg = self.lex();
                self.advance();
                let m = expr_alloc(ex_MEMBER());
                expr_set_lhs(m, e);
                expr_set_name(m, seg);
                e = m;
            }
            if (self.kind() == tk_LBRACE()) {
                return e;
            }
            // Not a bare path followed by a body: rewind and let the ordinary
            // expression parser handle the whole collection expression.
            self.cur_idx = saved_idx;
            self.cur = saved_cur;
            if (self.cur != null) {
                ast_set_current_loc(token_line(self.cur), token_col(self.cur));
            }
        }
        return self.parse_expr();
    }

    public fn parse_for_like(self) -> rawptr {
        var is_foreach = (self.kind() == tk_KEYWORD_FOREACH());
        self.advance();   // consume 'for' / 'foreach'
        if (!is_foreach
            && self.kind() == tk_IDENT()
            && self.kind_at(self.cur_idx + 1) == tk_KEYWORD_IN()) {
            let s_bare = stmt_alloc(st_FOREACH());
            stmt_set_name(s_bare, self.lex());
            self.advance();
            self.expect_kind(tk_KEYWORD_IN(), "'in'");
            stmt_set_cond(s_bare, self.parse_for_collection_expr());
            stmt_set_body(s_bare, self.parse_block());
            return s_bare;
        }
        self.expect_kind(tk_LPAREN(), "'('");
        // Detect `for (i in expr)` — lookahead for IDENT followed by `in`.
        if (!is_foreach && self.kind() == tk_IDENT()) {
            let saved = self.cur_idx;
            self.advance();
            let saw_in = (self.kind() == tk_KEYWORD_IN());
            self.cur_idx = saved;
            self.cur = lex_token_at(self.lex_handle, self.cur_idx);
            if (self.cur != null) {
                ast_set_current_loc(token_line(self.cur), token_col(self.cur));
            }
            if (saw_in) { is_foreach = true; }
        }
        if (is_foreach) {
            // `for (var x in expr) { body }`
            let s = stmt_alloc(st_FOREACH());
            if (self.kind() == tk_IDENT()) {
                stmt_set_name(s, self.lex());
                self.advance();
            }
            // consume 'in' keyword if present
            if (self.kind() == tk_KEYWORD_IN() || self.kind() == tk_IDENT() || self.kind() == tk_KEYWORD_IMPORT()) {
                self.advance();
            }
            stmt_set_cond(s, self.parse_for_collection_expr());
            self.expect_kind(tk_RPAREN(), "')'");
            stmt_set_body(s, self.parse_block());
            return s;
        }
        // `for (init; cond; incr) { body }`
        let s = stmt_alloc(st_FOR());
        // init
        if (!self.check(tk_SEMI())) {
            if (self.kind() == tk_KEYWORD_LET()) {
                stmt_set_init(s, self.parse_let());
            } else if (self.kind() == tk_KEYWORD_VAR()) {
                stmt_set_init(s, self.parse_var());
            } else {
                // expression init
                let init_e = self.parse_expr();
                let init_s = stmt_alloc(st_EXPR());
                stmt_set_init(init_s, init_e);
                stmt_set_init(s, init_s);
                self.expect_kind(tk_SEMI(), "';'");
            }
        } else {
            self.advance(); // skip ';'
        }
        // cond
        if (!self.check(tk_SEMI())) {
            stmt_set_cond(s, self.parse_expr());
        }
        self.expect_kind(tk_SEMI(), "';'");
        // incr — parse as expression, store in a synthetic st_EXPR
        if (!self.check(tk_RPAREN())) {
            let incr_e = self.parse_expr();
            let incr_s = stmt_alloc(st_EXPR());
            stmt_set_init(incr_s, incr_e);
            stmt_set_body(s, incr_s); // temporarily store incr here
        }
        self.expect_kind(tk_RPAREN(), "')'");
        // body — if there's an incr, body block will be built in codegen
        let body_block = self.parse_block();
        if (stmt_get_body(s) != null) {
            // append body before incr: store body in then_blk, incr in body
            stmt_set_then_blk(s, body_block);
        } else {
            stmt_set_body(s, body_block);
        }
        return s;
    }

    public fn parse_match_stmt(self) -> rawptr {
        self.advance();   // consume 'match'
        let s = stmt_alloc(st_MATCH());
        // scrutinee
        if (self.check(tk_LPAREN())) {
            self.advance();
            stmt_set_init(s, self.parse_expr());
            self.expect_kind(tk_RPAREN(), "')'");
        } elif (!self.check(tk_LBRACE())) {
            // The parenthesized spelling remains canonical, but a match
            // subject is an expression and does not need redundant grouping.
            // Parse `match value { ... }` and `match make() { ... }` instead
            // of leaving the subject token to the `{` recovery path.
            let saved_struct_ctx_stmt2 = self.suppress_struct_literal_ctx;
            self.suppress_struct_literal_ctx = true;
            stmt_set_init(s, self.parse_expr());
            self.suppress_struct_literal_ctx = saved_struct_ctx_stmt2;
        }
        // arms
        if (!self.expect_kind(tk_LBRACE(), "'{'")) {
            self.synchronize_statement();
            return s;
        }
        var arm_head: rawptr = null;
        var arm_tail: rawptr = null;
        while (!self.check(tk_RBRACE()) && !self.check(tk_EOF())) {
            let before = self.cur_idx;
            let arm = stmt_alloc(st_EXPR());
            if (self.kind() == tk_KEYWORD_DEFAULT()) {
                self.advance();
                let null_pat = expr_alloc(ex_NULL_LIT());
                expr_set_name(null_pat, "__match_default");
                stmt_set_init(arm, null_pat);
            } else if (self.kind() == tk_KEYWORD_CASE()) {
                self.advance();
                stmt_set_init(arm, self.parse_expr());
            } else {
                // bare expression pattern
                stmt_set_init(arm, self.parse_expr());
            }
            if (self.accept(tk_KEYWORD_IF())) {
                stmt_set_cond(arm, self.parse_expr());
            }
            // expect '=>' or ':'
            if (self.check(tk_FATARROW()) || self.check(tk_ARROW())) {
                self.advance();
            } else if (self.check(tk_COLON())) {
                self.advance();
            }
            // body
            if (self.check(tk_LBRACE())) {
                stmt_set_body(arm, self.parse_block());
            } else {
                let body_s = self.parse_stmt();
                stmt_set_body(arm, body_s);
            }
            // link
            if (arm_head == null) {
                arm_head = arm;
                arm_tail = arm;
            } else {
                stmt_set_next(arm_tail, arm);
                arm_tail = arm;
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}'");
        stmt_set_body(s, arm_head);
        return s;
    }

    /// Expression form of `match`.
    ///
    /// The statement and expression forms deliberately share the same arm
    /// representation: the expression's `lhs` is the scrutinee and `args`
    /// is a chain of `st_EXPR` arm records.  Each arm stores its pattern in
    /// `init`, an optional guard in `cond`, and its value-producing body in
    /// `body`.  Keeping the arm shape identical lets sema/HIR/MIR reuse the
    /// enum payload binding and guard rules of statement match.
    public fn parse_match_expr(self) -> rawptr {
        self.advance(); // consume `match`
        let e = expr_alloc(ex_MATCH_EXPR());
        if (self.check(tk_LPAREN())) {
            self.advance();
            expr_set_lhs(e, self.parse_expr());
            self.expect_kind(tk_RPAREN(), "')'");
        } elif (!self.check(tk_LBRACE())) {
            // Match expressions use the same expression grammar as match
            // statements.  Accept the natural `match value { ... }` form so
            // callers do not need grouping solely to satisfy the parser.
            let saved_struct_ctx = self.suppress_struct_literal_ctx;
            self.suppress_struct_literal_ctx = true;
            expr_set_lhs(e, self.parse_expr());
            self.suppress_struct_literal_ctx = saved_struct_ctx;
        }
        if (!self.expect_kind(tk_LBRACE(), "'{'")) {
            return e;
        }
        var arm_head: rawptr = null;
        var arm_tail: rawptr = null;
        while (!self.check(tk_RBRACE()) && !self.check(tk_EOF())) {
            let before = self.cur_idx;
            let arm = stmt_alloc(st_EXPR());
            if (self.kind() == tk_KEYWORD_DEFAULT()) {
                self.advance();
                let null_pat = expr_alloc(ex_NULL_LIT());
                expr_set_name(null_pat, "__match_default");
                stmt_set_init(arm, null_pat);
            } else if (self.kind() == tk_KEYWORD_CASE()) {
                self.advance();
                stmt_set_init(arm, self.parse_expr());
            } else {
                stmt_set_init(arm, self.parse_expr());
            }
            if (self.accept(tk_KEYWORD_IF())) {
                stmt_set_cond(arm, self.parse_expr());
            }
            if (self.check(tk_FATARROW()) || self.check(tk_ARROW())) {
                self.advance();
            } else if (self.check(tk_COLON())) {
                self.advance();
            } else {
                self.report_error("expected '=>' after match expression pattern");
            }
            if (self.check(tk_LBRACE())) {
                stmt_set_body(arm, self.parse_block());
            } else {
                let value_stmt = stmt_alloc(st_EXPR());
                stmt_set_init(value_stmt, self.parse_expr());
                stmt_set_body(arm, value_stmt);
            }
            if (arm_head == null) {
                arm_head = arm;
                arm_tail = arm;
            } else {
                stmt_set_next(arm_tail, arm);
                arm_tail = arm;
            }
            // Both separators are accepted so expression arms can be written
            // in the same style as existing statement arms.
            self.accept(tk_COMMA());
            self.accept(tk_SEMI());
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}'");
        expr_set_args(e, arm_head);
        return e;
    }

    public fn parse_match_arm_stmt(self) -> rawptr {
        self.advance();
        while (self.kind() != tk_FATARROW()
            && self.kind() != tk_LBRACE()
            && self.kind() != tk_SEMI()
            && self.kind() != tk_RBRACE()
            && self.kind() != tk_EOF()) {
            if (self.kind() == tk_LPAREN()) {
                self.skip_balanced(tk_LPAREN(), tk_RPAREN());
            } else if (self.kind() == tk_LBRACKET()) {
                self.skip_balanced(tk_LBRACKET(), tk_RBRACKET());
            } else if (self.kind() == tk_LT()) {
                self.skip_angle_payload();
            } else {
                self.advance();
            }
        }
        self.accept(tk_FATARROW());
        if (self.check(tk_LBRACE())) {
            self.skip_balanced(tk_LBRACE(), tk_RBRACE());
        } else {
            while (self.kind() != tk_SEMI()
                && self.kind() != tk_RBRACE()
                && self.kind() != tk_KEYWORD_CASE()
                && self.kind() != tk_KEYWORD_DEFAULT()
                && self.kind() != tk_EOF()) {
                if (self.kind() == tk_LPAREN()) {
                    self.skip_balanced(tk_LPAREN(), tk_RPAREN());
                } else if (self.kind() == tk_LBRACE()) {
                    self.skip_balanced(tk_LBRACE(), tk_RBRACE());
                } else {
                    self.advance();
                }
            }
            self.accept(tk_SEMI());
        }
        let s = stmt_alloc(st_EXPR());
        let e = expr_alloc(ex_NULL_LIT());
        stmt_set_init(s, e);
        return s;
    }

    public fn parse_defer_stmt(self) -> rawptr {
        self.advance();   // consume 'defer'
        let s = stmt_alloc(st_DEFER());
        if (self.check(tk_LBRACE())) {
            stmt_set_init(s, self.parse_block());
        } else {
            stmt_set_init(s, self.parse_stmt());
        }
        return s;
    }

    public fn parse_yield_stmt(self) -> rawptr {
        self.advance();   // consume 'yield'
        if (self.kind() == tk_KEYWORD_RETURN()) {
            return self.parse_return();
        }
        let s = stmt_alloc(st_EXPR());
        let e = expr_alloc(ex_AWAIT());
        if (!self.check(tk_SEMI())) {
            expr_set_lhs(e, self.parse_expr());
        }
        stmt_set_init(s, e);
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    public fn parse_unsafe_stmt(self) -> rawptr {
        self.advance();
        if (self.check(tk_LBRACE())) {
            let block = self.parse_block();
            if (block != null) {
                // Mark the block so HIR building can lower the enclosed
                // pointer places with the unchecked policy.  Sema does not
                // write semantic fields on block statements, so the flag is
                // stable through resolution.
                stmt_set_semantic(block, expr_sem_NONE(), null, stmt_flag_unsafe_block());
            }
            return block;
        }
        if (self.kind() == tk_KEYWORD_LET() || self.kind() == tk_KEYWORD_VAR()) {
            var binding: rawptr = null;
            if (self.kind() == tk_KEYWORD_LET()) {
                binding = self.parse_let();
            } else {
                binding = self.parse_var();
            }
            if (binding != null) {
                let flags = stmt_get_semantic_flags(binding);
                stmt_set_semantic(binding, expr_sem_NONE(), null,
                                  flags | stmt_flag_unsafe_local());
            }
            return binding;
        }
        self.report_error("expect '{' / let / var after unsafe");
        return self.parse_skip_stmt();
    }

    public fn parse_static_assert_stmt(self) -> rawptr {
        self.advance();   // consume 'static_assert'
        let s = stmt_alloc(st_STATIC_ASSERT());
        if (self.accept(tk_LPAREN())) {
            stmt_set_cond(s, self.parse_expr());
            if (self.accept(tk_COMMA())) {
                while (self.kind() != tk_RPAREN() && self.kind() != tk_EOF()) {
                    if (self.kind() == tk_LPAREN()) {
                        self.skip_balanced(tk_LPAREN(), tk_RPAREN());
                    } else if (self.kind() == tk_LBRACE()) {
                        self.skip_balanced(tk_LBRACE(), tk_RBRACE());
                    } else if (self.kind() == tk_LBRACKET()) {
                        self.skip_balanced(tk_LBRACKET(), tk_RBRACKET());
                    } else {
                        self.advance();
                    }
                }
            }
            self.expect_kind(tk_RPAREN(), "')' after static_assert");
        } else {
            stmt_set_cond(s, self.parse_expr());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    public fn parse_skip_stmt(self) -> rawptr {
        while (self.kind() != tk_SEMI()
            && self.kind() != tk_RBRACE()
            && self.kind() != tk_EOF()) {
            if (self.kind() == tk_LPAREN()) {
                self.skip_balanced(tk_LPAREN(), tk_RPAREN());
            } else if (self.kind() == tk_LBRACE()) {
                self.skip_balanced(tk_LBRACE(), tk_RBRACE());
            } else {
                self.advance();
            }
        }
        self.accept(tk_SEMI());
        let s = stmt_alloc(st_EXPR());
        let e = expr_alloc(ex_NULL_LIT());
        stmt_set_init(s, e);
        return s;
    }

    /// `{ stmt* }`
    public fn parse_block(self) -> rawptr {
        if (!self.expect_kind(tk_LBRACE(), "'{'")) { return null; }
        let s = stmt_alloc(st_BLOCK());
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let inner = self.parse_stmt();
            if (inner != null) {
                if (head == null) {
                    head = inner;
                    tail = inner;
                } else {
                    stmt_set_next(tail, inner);
                    tail = inner;
                }
            } else {
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}'");
        stmt_set_body(s, head);
        return s;
    }

    /// If-expression branches are statement blocks, but the final value may be
    /// written as a tail expression without a semicolon.
    public fn parse_if_expr_block(self) -> rawptr {
        if (!self.expect_kind(tk_LBRACE(), "'{'")) { return null; }
        let s = stmt_alloc(st_BLOCK());
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            var inner: rawptr = null;
            let k = self.kind();
            if (k == tk_KEYWORD_LET()
                || k == tk_KEYWORD_VAR()
                || k == tk_KEYWORD_IF()
                || k == tk_KEYWORD_WHILE()
                || k == tk_KEYWORD_FOR()
                || k == tk_KEYWORD_FOREACH()
                || k == tk_KEYWORD_MATCH()
                || k == tk_KEYWORD_CASE()
                || k == tk_KEYWORD_DEFAULT()
                || k == tk_KEYWORD_DEFER()
                || k == tk_KEYWORD_UNSAFE()
                || k == tk_KEYWORD_STATIC_ASSERT()
                || k == tk_KEYWORD_BREAK()
                || k == tk_KEYWORD_CONTINUE()
                || k == tk_KEYWORD_YIELD()
                || k == tk_KEYWORD_RETURN()
                || k == tk_LBRACE()) {
                inner = self.parse_stmt();
            } else {
                inner = stmt_alloc(st_EXPR());
                stmt_set_init(inner, self.parse_expr());
                if (!self.check(tk_RBRACE())) {
                    self.expect_kind(tk_SEMI(), "';'");
                } else {
                    self.accept(tk_SEMI());
                }
            }
            if (inner != null) {
                if (head == null) {
                    head = inner;
                    tail = inner;
                } else {
                    stmt_set_next(tail, inner);
                    tail = inner;
                }
            } else {
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}'");
        stmt_set_body(s, head);
        return s;
    }

    /// `expr ;` (catch-all: assignment, function call, member access, etc.)
    public fn parse_expr_stmt(self) -> rawptr {
        let s = stmt_alloc(st_EXPR());
        stmt_set_init(s, self.parse_expr());
        self.expect_kind(tk_SEMI(), "';'");
        return s;
    }

    // ── Declaration parsing ─────────────────────────────────────────

    /// One top-level declaration, dispatched on the leading keyword.
    /// Returns null on a hard parse error so the driver can resync.
    public fn parse_decl(self) -> rawptr {
        var doc: string = self.current_doc();
        var attrs = self.collect_leading_attributes();
        if (doc.len == 0) { doc = self.current_doc(); }
        var markers: string = "";
        while (self.lex() == "export" || self.lex() == "async"
            || self.lex() == "coroutine" || self.lex() == "corountine"
            || self.lex() == "task" || self.kind() == tk_KEYWORD_COMPTIME()
            || self.kind() == tk_KEYWORD_UNSAFE()) {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        let k = self.kind();
        if (attrs.len > 0 && k == tk_LBRACE()) {
            return self.parse_attributed_decl_block(attrs.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_MODULE()) { return self.attach_decl_meta(self.parse_module(), "", attrs.clone(), doc.clone(), markers.clone()); }
        if (k == tk_KEYWORD_USE() || k == tk_KEYWORD_IMPORT()) {
            return self.attach_decl_meta(self.parse_use(), "", attrs.clone(), doc.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_EXTERN()) {
            let ex = self.append_meta_to_decl_chain(self.parse_extern(), attrs.clone(), markers.clone());
            if (ex != null && doc.len > 0) { decl_set_doc(ex, doc); }
            return ex;
        }
        if (k == tk_KEYWORD_IMPL())   { return self.attach_decl_meta(self.parse_impl_decl(), "", attrs.clone(), doc.clone(), markers.clone()); }
        if (k == tk_KEYWORD_CONCEPT()) { return self.attach_decl_meta(self.parse_concept_decl(false), "", attrs.clone(), doc.clone(), markers.clone()); }
        if (k == tk_KEYWORD_TYPE() || self.lex() == "newtype") {
            return self.attach_decl_meta(self.parse_type_alias_decl(false), "", attrs.clone(), doc.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_CONST())  { return self.attach_decl_meta(self.parse_const_decl(), "", attrs.clone(), doc.clone(), markers.clone()); }
        if (k == tk_KEYWORD_LET() || k == tk_KEYWORD_VAR()) {
            return self.attach_decl_meta(self.parse_global_var_decl(), "", attrs.clone(), doc.clone(), markers.clone());
        }

        var is_pub: bool = false;
        var visibility: string = "";
        if (self.accept(tk_KEYWORD_PUBLIC())) {
            is_pub = true;
            visibility = "public";
        } else if (self.lex() == "private") {
            visibility = "private";
            self.advance();
        } else if (self.lex() == "internal") {
            visibility = "internal";
            self.advance();
        } else if (self.lex() == "protected") {
            visibility = "protected";
            self.advance();
        }
        let attrs_after_visibility = self.collect_leading_attributes();
        if (attrs_after_visibility.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_visibility;
        }
        var is_static: bool = false;
        if (self.accept(tk_KEYWORD_STATIC())) {
            is_static = true;
            markers = markers + "|marker:static";
        }
        while (self.lex() == "override" || self.lex() == "virtual" || self.lex() == "final") {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        let attrs_after_static = self.collect_leading_attributes();
        if (attrs_after_static.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_static;
        }

        let k2 = self.kind();
        if (k2 == tk_KEYWORD_CONST()) {
            return self.attach_decl_meta(self.parse_const_decl_ex(is_pub, is_static), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_LET() || k2 == tk_KEYWORD_VAR()) {
            return self.attach_decl_meta(self.parse_global_var_decl_ex(is_pub, is_static), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_STRUCT()) {
            return self.attach_decl_meta(self.parse_struct(is_pub, "", ""), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_CLASS())  {
            return self.attach_decl_meta(self.parse_class(is_pub, "", ""), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_INTERFACE()) {
            return self.attach_decl_meta(self.parse_interface(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_CONCEPT()) {
            return self.attach_decl_meta(self.parse_concept_decl(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_TYPE() || self.lex() == "newtype") {
            return self.attach_decl_meta(self.parse_type_alias_decl(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_ENUM())   {
            return self.attach_decl_meta(self.parse_enum(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_ERROR())  {
            return self.attach_decl_meta(self.parse_error_decl(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k2 == tk_KEYWORD_FN())     {
            return self.attach_decl_meta(self.parse_fn(is_pub, is_static), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }

        self.report_error("expect 'fn' or 'struct' or 'class' or 'interface' or 'enum' or 'error' or 'extern' or 'use' or 'module'");
        return null;
    }

    public fn is_module_path_segment(self) -> bool {
        if (self.kind() == tk_IDENT()) { return true; }
        let lx = self.lex();
        if (policy_primitive_type_kind(lx) != 0) { return true; }
        if (lx == "error" || lx == "type" || lx == "module") { return true; }
        if (lx == "interface" || lx == "static" || lx == "override") { return true; }
        return false;
    }

    public fn is_soft_name_token(self) -> bool {
        if (self.kind() == tk_IDENT()) { return true; }
        let lx = self.lex();
        if (lx == "type" || lx == "module" || lx == "error") { return true; }
        if (lx == "static" || lx == "override" || lx == "interface") { return true; }
        return false;
    }

    public fn parse_soft_name(self, what: string) -> string {
        if (!self.is_soft_name_token()) {
            self.report_error("expect " + what);
            return "";
        }
        let out = self.lex();
        self.advance();
        return out;
    }

    public fn parse_operator_decl_name(self, what: string) -> string {
        if (self.kind() != tk_IDENT() && self.lex() != "as") {
            self.report_error("expect " + what);
            return "";
        }
        if (self.lex() != "operator") {
            let out = self.lex();
            self.advance();
            return out;
        }
        self.advance();
        if (self.accept(tk_LBRACKET())) {
            self.expect_kind(tk_RBRACKET(), "']' after operator[");
            return "operator[]";
        }
        if (self.kind() == tk_PLUS()
            || self.kind() == tk_MINUS()
            || self.kind() == tk_STAR()
            || self.kind() == tk_SLASH()
            || self.kind() == tk_PERCENT()
            || self.kind() == tk_EQ()
            || self.kind() == tk_EQEQ()
            || self.kind() == tk_NEQ()
            || self.kind() == tk_LT()
            || self.kind() == tk_GT()
            || self.kind() == tk_LE()
            || self.kind() == tk_GE()
            || self.kind() == tk_AMP()
            || self.kind() == tk_PIPE()
            || self.kind() == tk_CARET()
            || self.kind() == tk_LSHIFT()
            || self.kind() == tk_RSHIFT()
            || self.kind() == tk_PLUSEQ()
            || self.kind() == tk_MINUSEQ()
            || self.kind() == tk_STAREQ()
            || self.kind() == tk_SLASHEQ()
            || self.kind() == tk_PERCENTEQ()
            || self.kind() == tk_AMPEQ()
            || self.kind() == tk_PIPEEQ()
            || self.kind() == tk_CARETEQ()
            || self.kind() == tk_LSHIFTEQ()
            || self.kind() == tk_RSHIFTEQ()
            || self.kind() == tk_PLUSPLUS()
            || self.kind() == tk_MINUSMINUS()
            || self.kind() == tk_NOT()
            || self.kind() == tk_TILDE()) {
            let suffix = self.lex();
            self.advance();
            return "operator" + suffix;
        }
        return "operator";
    }

    public fn parse_module_path_segment(self, what: string) -> string {
        if (!self.is_module_path_segment()) {
            self.report_error("expect " + what);
            return "";
        }
        let out = self.lex();
        self.advance();
        return out;
    }

    public fn parse_import_path(self, is_use: bool) -> string {
        var name = self.parse_module_path_segment("module path segment");
        while (!self.at_end()) {
            var has_sep: bool = false;
            if (self.accept(tk_COLONCOLON())) {
                has_sep = true;
            } else if (is_use && self.accept(tk_DOT())) {
                has_sep = true;
            }
            if (!has_sep) { return name; }

            if (self.check(tk_LBRACE())) { return name; }
            if (self.check(tk_STAR())) {
                self.advance();
                return name;
            }

            let next = self.parse_module_path_segment("module path segment");
            if (next.len == 0) { return name; }
            if (name.len > 0) {
                name = name + "." + next;
            } else {
                name = next;
            }
        }
        return name;
    }

    public fn parse_version_selector_suffix(self) -> string {
        if (!self.accept(tk_AT())) { return ""; }
        var version = "";
        while (!self.at_end()) {
            let k = self.kind();
            if (k == tk_LBRACKET() || k == tk_LPAREN() || k == tk_SEMI()
                || k == tk_COMMA() || k == tk_RPAREN() || k == tk_RBRACE()) {
                break;
            }
            if (k != tk_INT() && k != tk_FLOAT() && k != tk_DOT()
                && k != tk_MINUS() && k != tk_PLUS() && k != tk_IDENT()) {
                break;
            }
            version = version + self.lex();
            self.advance();
        }
        if (version.len == 0) {
            self.report_error("expect version after '@'");
            return "";
        }
        var out = "@" + version;
        if (self.accept(tk_LBRACKET())) {
            if (self.kind() != tk_STRING() && self.kind() != tk_IDENT()) {
                self.report_error("expect variant string inside version selector");
            } else {
                var variant = self.lex();
                if (self.kind() == tk_IDENT()) { variant = "\"" + variant + "\""; }
                out = out + "[" + variant + "]";
                self.advance();
            }
            self.expect_kind(tk_RBRACKET(), "']' after version variant");
        }
        return out;
    }

    /// `module a.b.c;` and block-form `module a.b { ... }`.
    public fn parse_module(self) -> rawptr {
        self.advance();   // consume 'module'
        let name = self.module_full_name(self.parse_dotted_name("module path"));
        let d = decl_alloc(de_MODULE(), name);
        if (self.accept(tk_LBRACE())) {
            let saved_prefix = self.module_prefix;
            self.module_prefix = name;
            var inner_head: rawptr = null;
            while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
                let before = self.cur_idx;
                let inner = self.parse_decl();
                if (inner != null) {
                    inner_head = self.append_local_decl_chain(inner_head, inner);
                } else {
                    self.synchronize();
                }
                self.ensure_progress(before);
            }
            self.expect_kind(tk_RBRACE(), "'}' to close module body");
            self.module_prefix = saved_prefix;
            let table = self.build_module_rewrite_table(inner_head, name);
            parser_rewrite_decl_chain(inner_head, table);
            parser_qual_dispose(table);
            let end_d = decl_alloc(de_MODULE(), "__module_end");
            if (inner_head == null) {
                decl_set_next(d, end_d);
            } else {
                decl_set_next(d, inner_head);
                decl_set_next(parser_decl_chain_tail(inner_head), end_d);
            }
            return d;
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    /// `use std.fs;` / `import std::fs;` → DE_USE with module path.
    public fn parse_use(self) -> rawptr {
        let is_use = self.kind() == tk_KEYWORD_USE();
        self.advance();   // consume 'use' or 'import'

        if (is_use && self.kind() == tk_IDENT()) {
            let saved_idx = self.cur_idx;
            let saved_cur = self.cur;
            let alias_name = self.lex();
            self.advance();
            if (self.accept(tk_EQ())) {
                // `use Alias = full.module.path;`
                let alias_target = self.parse_import_path(true)
                    + self.parse_version_selector_suffix();
                let d_alias = decl_alloc(de_USE(), alias_target);
                decl_set_meta(d_alias, alias_name);
                self.expect_kind(tk_SEMI(), "';'");
                return d_alias;
            }
            self.cur_idx = saved_idx;
            self.cur = saved_cur;
            if (self.cur != null) {
                ast_set_current_loc(token_line(self.cur), token_col(self.cur));
            }
        }

        let name = self.parse_import_path(is_use)
            + self.parse_version_selector_suffix();
        if (self.check(tk_LBRACE())) {
            self.skip_balanced(tk_LBRACE(), tk_RBRACE());
        }
        var as_alias: string = "";
        if (self.lex() == "as") {
            self.advance();
            if (self.is_module_path_segment()) {
                as_alias = self.lex();
                self.advance();
            } else {
                self.report_error("expect alias name");
            }
        }
        let d = decl_alloc(de_USE(), name);
        if (as_alias.len > 0) {
            decl_set_meta(d, as_alias);
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    public fn parse_dotted_name(self, what: string) -> string {
        var name = self.parse_module_path_segment(what);
        while (self.accept(tk_DOT())) {
            if (!self.is_module_path_segment()) {
                self.report_error("expect module path segment after '.' in " + what);
                return name;
            }
            name = name + "." + self.lex();
            self.advance();
        }
        return name;
    }

    /// `extern "C" { fn name(ps) -> T; ... }` and DCI object declarations
    /// such as `extern "dci" { class A { A(); fn/field signatures... } }`.
    /// `extern "cpp"` remains the source-compatible C++ DCI profile spelling.
    /// The block remains a DE_EXTERN_FN wrapper so existing top-level
    /// declaration plumbing can splice/import its members by ABI.
    public fn parse_extern(self) -> rawptr {
        self.advance();   // consume 'extern'
        var abi = "C";
        if (self.kind() == tk_STRING()) {
            abi = string_token_to_cooked(self.lex());
            self.advance();
        }
        let is_cpp = self.extern_abi_is_cpp(abi.clone());
        let uses_dci = self.extern_abi_uses_dci_surface(abi.clone());
        var dci_abi = "dci";
        if (is_cpp) { dci_abi = "cpp"; }
        self.expect_kind(tk_LBRACE(), "'{' after extern ABI");
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let inner_attrs = self.collect_leading_attributes();
            var parsed: rawptr = null;
            if (uses_dci && self.kind() == tk_KEYWORD_CLASS()) {
                parsed = self.parse_extern_dci_class(false, dci_abi.clone());
            } else if (uses_dci && self.kind() == tk_KEYWORD_STRUCT()) {
                parsed = self.parse_extern_dci_class(true, dci_abi.clone());
            } else if (self.kind() == tk_KEYWORD_TYPE() || self.lex() == "newtype") {
                let td = self.parse_type_alias_decl(false);
                parsed = td;
            } else if (self.kind() == tk_KEYWORD_LET() || self.kind() == tk_KEYWORD_VAR()) {
                let vd = self.parse_global_var_decl_ex(false, false);
                if (vd != null) {
                    var meta = decl_get_meta(vd);
                    meta = meta + "|extern_var";
                    decl_set_meta(vd, meta);
                }
                parsed = vd;
            } else if (self.kind() != tk_KEYWORD_FN()) {
                if (uses_dci) {
                    self.report_error("expect 'class', 'struct', 'fn', 'type' or 'var' inside extern DCI block");
                } else {
                    self.report_error("expect 'fn' or 'type' or 'var' inside extern block");
                }
                self.synchronize();
            } else {
                parsed = self.parse_extern_fn();
            }
            if (parsed != null) {
                if (inner_attrs.len > 0) {
                    parsed = self.append_meta_to_decl_chain(parsed, inner_attrs.clone(), "");
                }
                if (uses_dci) {
                    self.mark_extern_dci_decl_tree(parsed, dci_abi.clone());
                }
                if (head == null) {
                    head = parsed;
                    tail = parser_decl_chain_tail(parsed);
                } else {
                    decl_set_next(tail, parsed);
                    tail = parser_decl_chain_tail(parsed);
                }
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close extern block");
        var block_name = "extern_C_block";
        if (is_cpp) { block_name = "extern_cpp_block"; }
        else if (uses_dci) { block_name = "extern_dci_block"; }
        let block = decl_alloc(de_EXTERN_FN(), block_name);
        decl_set_members(block, head);
        if (uses_dci) {
            decl_set_meta(block, self.extern_dci_decl_markers(dci_abi));
        } else {
            decl_set_meta(block, "|extern_abi:C");
        }
        return block;
    }

    public fn parse_extern_dci_class(self, is_struct: bool, abi: string) -> rawptr {
        self.advance();   // consume 'class' or 'struct'
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect DCI class name");
            return null;
        }
        let name = self.parse_dotted_name("DCI class name");
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_CLASS(), name);
        var kind_name = "class";
        if (is_struct) { kind_name = "struct"; }
        decl_set_generic_params(d, self.parse_decl_suffix_markers(generics, kind_name));
        decl_set_is_public(d, true);
        decl_set_meta(d, self.extern_dci_decl_markers(abi.clone()));
        self.expect_kind(tk_LBRACE(), "'{' to open extern DCI class body");
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let m = self.parse_extern_dci_class_member(name, generics, abi.clone());
            if (m != null) {
                parser_ensure_method_self_param(m, name);
                self.mark_extern_dci_decl_tree(m, abi.clone());
                if (head == null) { head = m; tail = parser_decl_chain_tail(m); }
                else {
                    decl_set_next(tail, m);
                    tail = parser_decl_chain_tail(m);
                }
            } else {
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close extern DCI class body");
        self.accept(tk_SEMI());
        decl_set_members(d, head);
        return d;
    }

    public fn parse_extern_cpp_class(self, is_struct: bool) -> rawptr {
        return self.parse_extern_dci_class(is_struct, "cpp");
    }

    /// `fn name(ps) -> T;` (no body, used inside extern "C" blocks)
    public fn parse_extern_fn(self) -> rawptr {
        self.advance();   // consume 'fn'
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect extern fn name");
            self.synchronize();
            return null;
        }
        let name = self.parse_soft_name("field name");
        // DCI open generic: `fn twice<T>(v: T) -> T;` inside `extern "dci"`.
        // The declaration stays open — concrete instances are chosen by the
        // call sites and materialized by the Active Adapter at build time.
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_EXTERN_FN(), name);
        if (generics.len > 0) {
            decl_set_generic_params(d, generics + "|dci_open");
        }
        decl_set_is_public(d, true);
        self.expect_kind(tk_LPAREN(), "'('");
        decl_set_params(d, self.parse_params());
        self.expect_kind(tk_RPAREN(), "')'");
        if (self.accept(tk_ARROW())) {
            decl_set_ty(d, self.parse_type());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    public fn parse_optional_generic_params(self) -> string {
        if (!self.accept(tk_LT())) {
            return "";
        }
        var names: string = "";
        var const_param: bool = false;
        while (self.kind() != tk_GT() && self.kind() != tk_RSHIFT() && self.kind() != tk_EOF()) {
            if (self.kind() == tk_KEYWORD_CONST()) {
                const_param = true;
                self.advance();
                continue;
            }
            if (self.kind() == tk_IDENT()) {
                if (names.len > 0) {
                    names = names + ",";
                }
                names = names + self.lex();
                if (const_param) {
                    names = names + "^const";
                }
                const_param = false;
                self.advance();
                while (self.kind() != tk_COMMA()
                    && self.kind() != tk_GT()
                    && self.kind() != tk_EOF()) {
                    self.advance();
                }
            } else {
                let lx2 = self.lex();
                if (policy_primitive_type_kind(lx2) != 0) {
                    if (names.len > 0) {
                        names = names + ",";
                    }
                    names = names + lx2;
                    self.advance();
                } else {
                    self.advance();
                }
            }
            if (self.kind() == tk_COMMA()) {
                self.advance();
            }
        }
        if (self.kind() == tk_RSHIFT()) {
            self.advance();
        } else {
            self.expect_kind(tk_GT(), "'>' after generic params");
        }
        return names;
    }

    /// Record a base clause's template arguments next to the `|impl:` list.
    ///
    /// The list keeps its historical shape (a dotted base arrives as one
    /// comma-separated segment per path component, and the lookup that consumes
    /// it matches on the last segment), so nothing that reads `|impl:` changes.
    /// A base clause's arguments, however, used to be dropped on the floor --
    /// which is why a Vyx subclass of a *generic* foreign base could not name
    /// the closed instance it inherits: the descriptor lookup needs
    /// `native.Sink<i32>`, not `native.Sink`.  They live in their own trailing
    /// segment, keyed by the base's last segment:
    ///
    ///     |baseargs:Sink|i32;Other|Pair2<i32,f64>
    ///
    /// `;` and `|` cannot appear in a type text, and a fresh segment keeps
    /// every existing `|impl:<name>,` membership test working untouched.
    fn parser_base_args_append(self, rows: string, base: string, args: string) -> string {
        if (base.len == 0 || args.len == 0) { return rows; }
        var out = rows;
        if (out.len == 0) { out = "|baseargs:"; } else { out = out.clone() + ";"; }
        return out + base + "|" + args;
    }

    public fn parse_decl_suffix_markers(self, generics: string, kind_name: string) -> string {
        var out = generics + "|kind:" + kind_name;
        if (self.accept(tk_COLON())) {
            out = out.clone() + "|impl:";
            var base_args = "";
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_KEYWORD_WHERE()
                && self.kind() != tk_EOF()) {
                if (self.kind() == tk_IDENT() || self.kind() == tk_KEYWORD_INTERFACE()) {
                    let seg = self.lex();
                    out = out.clone() + seg.clone() + ",";
                    self.advance();
                    // `Sink<i32>` and the turbofish `Sink::<i32>` name the same
                    // instance; the `::` between them is not part of the name.
                    while (self.kind() == tk_COLONCOLON()) { self.advance(); }
                    if (self.kind() == tk_LT()) {
                        let payload = self.read_angle_payload_text();
                        base_args = self.parser_base_args_append(base_args, seg, payload);
                    }
                } else if (self.kind() == tk_LT()) {
                    self.skip_angle_payload();
                } else {
                    self.advance();
                }
            }
            out = out.clone() + base_args;
        }
        if (self.accept(tk_KEYWORD_WHERE())) {
            out = out.clone() + "|where:";
            while (self.kind() != tk_LBRACE() && self.kind() != tk_EOF()) {
                let where_seg = self.lex().clone();
                out = out.clone() + where_seg;
                self.advance();
            }
        }
        return out;
    }

    public fn parse_nested_record(self, is_pub: bool, parent_name: string, parent_generics: string) -> rawptr {
        if (self.kind() == tk_KEYWORD_CLASS()) {
            return self.parse_class(is_pub, parent_name, parent_generics);
        }
        if (self.kind() == tk_KEYWORD_STRUCT()) {
            return self.parse_struct(is_pub, parent_name, parent_generics);
        }
        return null;
    }

    /// `struct NAME { fields }` — represented as DE_CLASS in the bootstrap AST.
    public fn parse_struct(self, is_pub: bool, parent_name: string, parent_generics: string) -> rawptr {
        self.advance();   // consume 'struct'
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect struct name");
            return null;
        }
        let name = self.parse_dotted_name("struct name");
        let generics = self.parse_optional_generic_params();
        let full_name = parser_qualify_nested_name(parent_name, name);
        let merged_generics = parser_merge_nested_generics(parent_generics, generics);
        let d = decl_alloc(de_CLASS(), full_name);
        decl_set_generic_params(d, self.parse_decl_suffix_markers(merged_generics, "struct"));
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LBRACE(), "'{' to open struct body");
        var head: rawptr = null;
        var tail: rawptr = null;
        var nested: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            var doc: string = self.current_doc();
            var attrs = self.collect_leading_attributes();
            if (doc.len == 0) { doc = self.current_doc(); }
            var visibility: string = "";
            var is_field_pub: bool = false;
            if (self.accept(tk_KEYWORD_PUBLIC())) {
                is_field_pub = true;
                visibility = "public";
            } else if (self.lex() == "private" || self.lex() == "internal" || self.lex() == "protected") {
                visibility = self.lex();
                self.advance();
            }
            let attrs_after_vis = self.collect_leading_attributes();
            if (attrs_after_vis.len > 0) {
                if (attrs.len > 0) { attrs = attrs + ","; }
                attrs = attrs + attrs_after_vis;
            }
            // Nested `struct` / `class` in a struct body: hoisted to module
            // scope under `<parent>.<name>` (see the Nested records block).
            if (self.kind() == tk_KEYWORD_STRUCT() || self.kind() == tk_KEYWORD_CLASS()) {
                let nd = self.parse_nested_record(is_field_pub, full_name, merged_generics);
                if (nd != null) { nested = self.append_local_decl_chain(nested, nd); }
                self.ensure_progress(before);
                continue;
            }
            if (self.is_soft_name_token()) {
                var f = self.parse_field(is_field_pub);
                if (f != null) {
                    f = self.attach_decl_meta(f, visibility.clone(), attrs.clone(), doc.clone(), "");
                    if (head == null) { head = f; tail = f; }
                    else {
                        decl_set_next(tail, f);
                        tail = f;
                    }
                }
            } else {
                self.report_error("expect field declaration in struct body");
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close struct body");
        decl_set_members(d, head);
        return self.append_local_decl_chain(d, nested);
    }

    /// `error NAME { Variant, Other(payload); ... }`.
    /// Payload type lists are consumed so the cursor stays in sync; the
    /// bootstrap representation keeps one `DE_VARIANT` per arm, enough for
    /// codegen to reproduce the host's no-payload negative error-code table.
    public fn parse_error_decl(self, is_pub: bool) -> rawptr {
        self.advance();   // consume 'error'
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect error name");
            return null;
        }
        let name = self.lex();
        self.advance();
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_CLASS(), name);
        decl_set_generic_params(d, self.parse_decl_suffix_markers(generics, "error"));
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LBRACE(), "'{' to open error body");
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            if (self.kind() == tk_KEYWORD_FN()
                || self.kind() == tk_KEYWORD_PUBLIC()
                || self.lex() == "private"
                || self.kind() == tk_KEYWORD_STATIC()) {
                let m = self.parse_class_member(name, generics);
                if (m != null) {
                    if (!parser_string_contains(decl_get_meta(m), "|vis:")) {
                        decl_set_is_public(m, true);
                    }
                    if (head == null) { head = m; tail = m; }
                    else {
                        decl_set_next(tail, m);
                        tail = m;
                    }
                }
            } else if (self.kind() == tk_IDENT()) {
                let vname = self.lex();
                self.advance();
                let vd = decl_alloc(de_VARIANT(), vname);
                var ret_name = name.clone();
                if (generics.len > 0) {
                    ret_name = ret_name.clone() + "::<" + generics + ">";
                }
                decl_set_ty(vd, tref_alloc(ty_CLASS(), ret_name));
                var vmeta = generics + "|kind:variant";
                if (self.check(tk_LPAREN())) {
                    decl_set_params(vd, self.parse_variant_payload_params());
                    vmeta = vmeta.clone() + "|payload";
                }
                decl_set_generic_params(vd, vmeta);
                if (head == null) { head = vd; tail = vd; }
                else {
                    decl_set_next(tail, vd);
                    tail = vd;
                }
                if (self.kind() == tk_COMMA() || self.kind() == tk_SEMI()) {
                    self.advance();
                }
            } else {
                self.advance();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close error body");
        decl_set_members(d, head);
        return d;
    }

    public fn parse_interface_method(self, is_pub: bool) -> rawptr {
        self.advance();
        let name = self.parse_operator_decl_name("interface method name");
        if (name.len == 0) { return null; }
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_METHOD(), name);
        decl_set_generic_params(d, generics);
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LPAREN(), "'('");
        decl_set_params(d, self.parse_params());
        self.expect_kind(tk_RPAREN(), "')'");
        if (self.accept(tk_ARROW())) {
            decl_set_ty(d, self.parse_type());
        } else {
            decl_set_ty(d, tref_alloc(ty_VOID(), ""));
        }
        var has_where: bool = false;
        if (self.accept(tk_KEYWORD_WHERE())) {
            has_where = true;
        } else if (self.accept(tk_KEYWORD_REQUIRES())) {
            has_where = true;
        }
        if (has_where) {
            decl_set_generic_params(d, generics + "|where:");
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                decl_set_generic_params(d, decl_get_generic_params(d) + self.lex());
                self.advance();
            }
        }
        if (self.check(tk_LBRACE())) {
            decl_set_body(d, self.parse_block());
        } else {
            self.accept(tk_SEMI());
        }
        return d;
    }

    public fn parse_interface(self, is_pub: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect interface name");
            return null;
        }
        let name = self.lex();
        self.advance();
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_CLASS(), name);
        decl_set_generic_params(d, self.parse_decl_suffix_markers(generics, "interface"));
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LBRACE(), "'{' to open interface body");
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            var member: rawptr = null;
            var pub_member: bool = true;
            while (self.kind() == tk_AT()) { self.skip_attribute(); }
            if (self.accept(tk_KEYWORD_PUBLIC())) { pub_member = true; }
            if (self.kind() == tk_KEYWORD_FN()) {
                member = self.parse_interface_method(pub_member);
            } else if (self.kind() == tk_KEYWORD_CONST()) {
                member = self.parse_const_member(pub_member);
            } else if (self.kind() == tk_KEYWORD_TYPE()) {
                member = self.parse_type_member(pub_member);
            } else {
                self.advance();
            }
            if (member != null) {
                parser_ensure_method_self_param(member, name);
                if (head == null) { head = member; tail = member; }
                else {
                    decl_set_next(tail, member);
                    tail = member;
                }
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close interface body");
        decl_set_members(d, head);
        return d;
    }

    public fn parse_enum(self, is_pub: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect enum name");
            return null;
        }
        let name = self.parse_dotted_name("enum name");
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_ENUM(), name);
        decl_set_generic_params(d, self.parse_decl_suffix_markers(generics, "enum"));
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LBRACE(), "'{' to open enum body");
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            if (self.kind() == tk_KEYWORD_FN()
                || self.kind() == tk_KEYWORD_PUBLIC()
                || self.kind() == tk_KEYWORD_STATIC()
                || self.kind() == tk_KEYWORD_CONST()
                || self.kind() == tk_KEYWORD_TYPE()
                || self.lex() == "private"
                || self.lex() == "internal"
                || self.lex() == "protected"
                || self.lex() == "override"
                || self.kind() == tk_AT()) {
                let member = self.parse_class_member(name, generics);
                if (member != null) {
                    if (!parser_string_contains(decl_get_meta(member), "|vis:")) {
                        decl_set_is_public(member, true);
                    }
                    parser_ensure_method_self_param(member, name);
                    if (head == null) { head = member; tail = member; }
                    else {
                        decl_set_next(tail, member);
                        tail = member;
                    }
                }
            } else if (self.kind() == tk_IDENT()) {
                let vname = self.lex();
                self.advance();
                let vd = decl_alloc(de_VARIANT(), vname);
                var ret_name = name.clone();
                if (generics.len > 0) {
                    ret_name = ret_name.clone() + "::<" + generics + ">";
                }
                decl_set_ty(vd, tref_alloc(ty_CLASS(), ret_name));
                var vmeta = generics + "|kind:variant";
                if (self.check(tk_LPAREN())) {
                    decl_set_params(vd, self.parse_variant_payload_params());
                    vmeta = vmeta.clone() + "|payload";
                }
                decl_set_generic_params(vd, vmeta);
                if (head == null) { head = vd; tail = vd; }
                else {
                    decl_set_next(tail, vd);
                    tail = vd;
                }
                if (self.kind() == tk_COMMA() || self.kind() == tk_SEMI()) {
                    self.advance();
                }
            } else {
                self.advance();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close enum body");
        decl_set_members(d, head);
        return d;
    }

    public fn parse_variant_payload_params(self) -> rawptr {
        self.expect_kind(tk_LPAREN(), "'(' after enum variant");
        var head: rawptr = null;
        var tail: rawptr = null;
        var idx: i32 = 0;
        while (self.kind() != tk_RPAREN()
            && self.kind() != tk_RBRACE()
            && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let f = decl_alloc(de_FIELD(), "_" + idx.toString());
            decl_set_ty(f, self.parse_type());
            if (head == null) { head = f; tail = f; }
            else {
                decl_set_next(tail, f);
                tail = f;
            }
            idx = idx + 1;
            if (self.kind() == tk_COMMA()) {
                self.advance();
            } else if (self.kind() != tk_RPAREN() && self.kind() != tk_RBRACE()) {
                self.report_error("expect ',' or ')' in enum variant payload");
                self.synchronize();
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RPAREN(), "')' after enum variant payload");
        return head;
    }

    public fn parse_impl_type_name(self, what: string) -> string {
        if (policy_primitive_type_kind(self.lex()) != 0) {
            let name = self.lex();
            self.advance();
            return name;
        }
        return self.parse_dotted_name(what);
    }

    public fn parse_impl_decl(self) -> rawptr {
        self.advance();
        var generics: string = "";
        var where_text: string = "";
        if (self.kind() == tk_LT()) {
            self.advance();
            while (self.kind() != tk_GT()
                && self.kind() != tk_RSHIFT()
                && self.kind() != tk_EOF()) {
                if (self.kind() == tk_IDENT()) {
                    let pname = self.lex();
                    if (generics.len > 0) { generics = generics + ","; }
                    generics = generics + pname;
                    self.advance();
                    if (self.accept(tk_COLON())) {
                        if (where_text.len > 0) { where_text = where_text + ","; }
                        where_text = where_text + pname + ":";
                        while (self.kind() != tk_COMMA()
                            && self.kind() != tk_GT()
                            && self.kind() != tk_RSHIFT()
                            && self.kind() != tk_EOF()) {
                            if (self.kind() == tk_LT()) {
                                self.skip_angle_payload();
                            } else {
                                where_text = where_text + self.lex();
                                self.advance();
                            }
                        }
                    }
                } else {
                    self.advance();
                }
                if (self.kind() == tk_COMMA()) { self.advance(); }
            }
            if (self.kind() == tk_RSHIFT()) {
                self.advance();
            } else {
                self.expect_kind(tk_GT(), "'>' after impl generic params");
            }
        }
        var first_name: string = "";
        var trait_name: string = "";
        var target_name: string = "";
        if (parser_is_impl_target_token(self.kind(), self.lex())) {
            first_name = self.parse_impl_type_name("impl type");
            if (self.kind() == tk_LT()) {
                self.skip_angle_payload();
            }
        }
        if (self.lex() == "for") {
            trait_name = first_name.clone();
            self.advance();
            if (parser_is_impl_target_token(self.kind(), self.lex())) {
                target_name = self.parse_impl_type_name("impl target");
                if (self.kind() == tk_LT()) {
                    self.skip_angle_payload();
                }
            }
        } else {
            target_name = first_name.clone();
        }
        if (self.accept(tk_KEYWORD_WHERE())) {
            if (where_text.len > 0) { where_text = where_text + ","; }
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                if (self.kind() == tk_LT()) {
                    self.skip_angle_payload();
                } else if (self.kind() == tk_LPAREN()) {
                    self.skip_balanced(tk_LPAREN(), tk_RPAREN());
                } else {
                    where_text = where_text + self.lex();
                    self.advance();
                }
            }
        } else {
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                if (self.kind() == tk_LT()) {
                    self.skip_angle_payload();
                } else if (self.kind() == tk_LPAREN()) {
                    self.skip_balanced(tk_LPAREN(), tk_RPAREN());
                } else {
                    self.advance();
                }
            }
        }
        var meta = "|kind:impl";
        if (trait_name.len > 0) {
            meta = meta.clone() + "|impl:" + trait_name + ",";
        }
        if (generics.len > 0) {
            meta = meta.clone() + "|generics:" + generics + "|";
        }
        if (where_text.len > 0) {
            meta = meta.clone() + "|where:" + where_text + "|";
        }
        meta = meta.clone() + "|members:";
        var head: rawptr = null;
        var tail: rawptr = null;
        if (self.accept(tk_LBRACE())) {
            while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
                let before = self.cur_idx;
                let m = self.parse_class_member(target_name, "");
                if (m != null) {
                    let member_seg = decl_get_name(m).clone() + ",";
                    meta = meta.clone() + member_seg;
                    if (decl_get_kind(m) == de_METHOD() && !decl_get_is_static(m)) {
                        let first = decl_get_params(m);
                        if (first == null || decl_get_name(first) != "self") {
                            let self_param = decl_alloc(de_FIELD(), "self");
                            decl_set_ty(self_param, parser_impl_self_type(target_name.clone()));
                            parser_mark_self_receiver(self_param, "compat");
                            decl_set_next(self_param, first);
                            decl_set_params(m, self_param);
                            let member_meta = decl_get_meta(m).clone();
                            decl_set_meta(m, member_meta + "|impl_synthetic_self");
                        } else {
                            parser_mark_self_receiver(first, "compat");
                            if (decl_get_ty(first) == null) {
                                decl_set_ty(first, parser_impl_self_type(target_name.clone()));
                            }
                        }
                    }
                    if (head == null) { head = m; tail = m; }
                    else {
                        decl_set_next(tail, m);
                        tail = m;
                    }
                } else {
                    self.synchronize();
                }
                self.ensure_progress(before);
            }
            self.expect_kind(tk_RBRACE(), "'}' to close impl body");
        } else {
            self.accept(tk_SEMI());
        }
        let d = decl_alloc(de_CLASS(), target_name);
        decl_set_generic_params(d, meta);
        decl_set_members(d, head);
        return d;
    }

    public fn parse_concept_decl(self, is_pub: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect concept name");
            self.skip_until_body_or_semi();
            if (self.check(tk_LBRACE())) {
                self.skip_balanced(tk_LBRACE(), tk_RBRACE());
            } else {
                self.accept(tk_SEMI());
            }
            return decl_alloc(de_MODULE(), "__concept_error");
        }
        let name = self.lex();
        self.advance();
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_CLASS(), name.clone());
        decl_set_generic_params(d, generics + "|kind:interface|kind:concept");
        decl_set_is_public(d, is_pub);
        while (self.kind() != tk_LBRACE()
            && self.kind() != tk_SEMI()
            && self.kind() != tk_EOF()) {
            if (self.kind() == tk_LPAREN()) {
                self.skip_balanced(tk_LPAREN(), tk_RPAREN());
            } else if (self.kind() == tk_LT()) {
                self.skip_angle_payload();
            } else {
                self.advance();
            }
        }
        if (!self.accept(tk_LBRACE())) {
            self.accept(tk_SEMI());
            return d;
        }
        var head: rawptr = null;
        var tail: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            var member: rawptr = null;
            var pub_member: bool = true;
            while (self.kind() == tk_AT()) { self.skip_attribute(); }
            if (self.accept(tk_KEYWORD_PUBLIC())) { pub_member = true; }
            if (self.kind() == tk_KEYWORD_FN()) {
                member = self.parse_interface_method(pub_member);
            } else if (self.kind() == tk_KEYWORD_CONST()) {
                member = self.parse_const_member(pub_member);
            } else if (self.kind() == tk_KEYWORD_TYPE()) {
                member = self.parse_type_member(pub_member);
            } else {
                self.advance();
            }
            if (member != null) {
                parser_ensure_method_self_param(member, name);
                if (head == null) { head = member; tail = member; }
                else {
                    decl_set_next(tail, member);
                    tail = member;
                }
            }
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close concept body");
        decl_set_members(d, head);
        return d;
    }

    public fn parse_type_alias_decl(self, is_pub: bool) -> rawptr {
        let is_newtype = (self.lex() == "newtype");
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect type alias name");
            self.synchronize();
            return decl_alloc(de_MODULE(), "__type_alias_error");
        }
        let name = self.parse_dotted_name("type alias name");
        let d = decl_alloc(de_TYPE_ALIAS(), name);
        decl_set_is_public(d, is_pub);
        var generics: string = "";
        if (self.kind() == tk_LT()) {
            generics = self.parse_optional_generic_params();
        }
        if (is_newtype) {
            decl_set_generic_params(d, generics + "|kind:newtype");
        } else {
            decl_set_generic_params(d, generics + "|kind:type_alias");
        }
        self.expect_kind(tk_EQ(), "'=' in type alias");
        if (self.kind() != tk_SEMI() && self.kind() != tk_EOF()) {
            decl_set_ty(d, self.parse_type());
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    public fn parse_const_decl(self) -> rawptr {
        return self.parse_const_decl_ex(false, false);
    }

    public fn parse_const_decl_ex(self, is_pub: bool, is_static: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect const name");
            self.synchronize();
            return decl_alloc(de_MODULE(), "__const_error");
        }
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_CONST(), name);
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, is_static);
        if (self.accept(tk_COLON())) {
            decl_set_ty(d, self.parse_type());
        }
        if (self.accept(tk_EQ())) {
            let init = self.parse_expr();
            let cell = stmt_alloc(st_EXPR());
            stmt_set_init(cell, init);
            decl_set_body(d, cell);
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    public fn parse_global_var_decl(self) -> rawptr {
        return self.parse_global_var_decl_ex(false, false);
    }

    public fn parse_global_var_decl_ex(self, is_pub: bool, is_static: bool) -> rawptr {
        let is_var = (self.kind() == tk_KEYWORD_VAR());
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect global variable name");
            self.synchronize();
            return decl_alloc(de_MODULE(), "__global_var_error");
        }
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_GLOBAL_VAR(), name);
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, is_static);
        if (is_var) {
            decl_set_generic_params(d, "|kind:var");
        } else {
            decl_set_generic_params(d, "|kind:let");
        }
        if (self.accept(tk_COLON())) {
            decl_set_ty(d, self.parse_type());
        }
        if (self.accept(tk_EQ())) {
            let init = self.parse_expr();
            let cell = stmt_alloc(st_EXPR());
            stmt_set_init(cell, init);
            decl_set_body(d, cell);
        }
        self.expect_kind(tk_SEMI(), "';'");
        return d;
    }

    /// `class NAME { fields; methods }`
    public fn parse_class(self, is_pub: bool, parent_name: string, parent_generics: string) -> rawptr {
        self.advance();   // consume 'class'
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect class name");
            return null;
        }
        let name = self.parse_dotted_name("class name");
        let generics = self.parse_optional_generic_params();
        let full_name = parser_qualify_nested_name(parent_name, name);
        let merged_generics = parser_merge_nested_generics(parent_generics, generics);
        let d = decl_alloc(de_CLASS(), full_name);
        decl_set_generic_params(d, self.parse_decl_suffix_markers(merged_generics, "class"));
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_LBRACE(), "'{' to open class body");
        var head: rawptr = null;
        var tail: rawptr = null;
        var nested: rawptr = null;
        while (self.kind() != tk_RBRACE() && self.kind() != tk_EOF()) {
            let before = self.cur_idx;
            let m = self.parse_class_member(full_name, merged_generics);
            if (m != null && decl_get_kind(m) == de_CLASS()) {
                // A nested record (see parse_class_member): it belongs at
                // module scope, not in this record's member list.
                nested = self.append_local_decl_chain(nested, m);
                self.ensure_progress(before);
                continue;
            }
            if (m != null) {
                // Back-fill the `self` receiver's type so the lower
                // pipeline does not see a typeless parameter. Only
                // instance methods (DE_METHOD with is_static == false)
                // get a `self`; a static method's first parameter is
                // a normal typed argument and must not be touched.
                parser_ensure_method_self_param(m, full_name);
                if (head == null) { head = m; tail = m; }
                else {
                    decl_set_next(tail, m);
                    tail = m;
                }
            } else {
                self.synchronize();
            }
            // Hard guarantee that EVERY class-body iteration consumes at
            // least one token. parse_class_member can return a valid
            // Decl while leaving the cursor parked on (for example) an
            // unexpected token after a malformed field declaration; the
            // next iteration would then re-parse the same byte stream
            // and never escape. ensure_progress() is the safety belt.
            self.ensure_progress(before);
        }
        self.expect_kind(tk_RBRACE(), "'}' to close class body");
        self.accept(tk_SEMI());
        decl_set_members(d, head);
        return self.append_local_decl_chain(d, nested);
    }

    /// One class body line: `[public] [static] {field | method}`.
    public fn parse_class_member(self, owner_name: string, owner_generics: string) -> rawptr {
        var doc: string = self.current_doc();
        var attrs = self.collect_leading_attributes();
        if (doc.len == 0) { doc = self.current_doc(); }
        var markers: string = "";
        var is_pub: bool = false;
        var is_static: bool = false;
        while (self.lex() == "override" || self.lex() == "virtual" || self.lex() == "final") {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        var visibility: string = "";
        if (self.accept(tk_KEYWORD_PUBLIC())) {
            is_pub = true;
            visibility = "public";
        } else if (self.lex() == "private" || self.lex() == "internal" || self.lex() == "protected") {
            visibility = self.lex();
            self.advance();
        }
        let attrs_after_visibility = self.collect_leading_attributes();
        if (attrs_after_visibility.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_visibility;
        }
        if (self.accept(tk_KEYWORD_STATIC())) {
            is_static = true;
            markers = markers + "|marker:static";
        }
        while (self.lex() == "override" || self.lex() == "virtual" || self.lex() == "final") {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        let attrs_after_static = self.collect_leading_attributes();
        if (attrs_after_static.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_static;
        }
        let k = self.kind();
        if (k == tk_KEYWORD_STRUCT() || k == tk_KEYWORD_CLASS()) {
            // Nested `struct` / `class` inside this record's body.  The
            // resulting DE_CLASS decl is hoisted to module scope by
            // parse_struct / parse_class rather than becoming a member.
            return self.parse_nested_record(is_pub, owner_name, owner_generics);
        }
        if (owner_name.len > 0
            && self.kind() == tk_IDENT()
            && parser_ctor_name_matches(self.lex(), owner_name)
            && self.kind_at(self.cur_idx + 1) == tk_LPAREN()) {
            return self.attach_decl_meta(self.parse_constructor(is_pub, owner_name, owner_generics),
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + "|kind:constructor");
        }
        if (k == tk_KEYWORD_FN()) {
            return self.attach_decl_meta(self.parse_method(is_pub, is_static), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_CONST()) {
            return self.attach_decl_meta(self.parse_const_member(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_TYPE()) {
            return self.attach_decl_meta(self.parse_type_member(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (k == tk_KEYWORD_VAR() || k == tk_KEYWORD_LET()) {
            let field_is_var = (k == tk_KEYWORD_VAR());
            self.advance();
            let f = self.parse_field(is_pub);
            if (f != null) {
                if (field_is_var) {
                    decl_set_generic_params(f, "|kind:var");
                } else {
                    decl_set_generic_params(f, "|kind:let");
                }
            }
            return self.attach_decl_meta(f, visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        if (self.is_soft_name_token()) {
            return self.attach_decl_meta(self.parse_field(is_pub), visibility.clone(), attrs.clone(), doc.clone(), markers.clone());
        }
        self.report_error("expect field or method declaration");
        return null;
    }

    public fn extern_dci_member_markers(self, d: rawptr, is_ctor: bool, abi: string) -> string {
        var markers = self.extern_dci_decl_markers(abi.clone());
        if (decl_get_body(d) == null) {
            markers = markers + "|foreign_dci_native";
            if (self.extern_abi_is_cpp(abi.clone())) {
                markers = markers + "|foreign_cpp_native";
            }
        } else {
            markers = markers + "|foreign_dci_extension";
            if (self.extern_abi_is_cpp(abi.clone())) {
                markers = markers + "|foreign_cpp_extension";
            }
        }
        if (is_ctor) {
            markers = markers + "|foreign_dci_ctor";
            if (self.extern_abi_is_cpp(abi)) {
                markers = markers + "|foreign_cpp_ctor";
            }
        }
        return markers;
    }

    public fn extern_cpp_member_markers(self, d: rawptr, is_ctor: bool) -> string {
        return self.extern_dci_member_markers(d, is_ctor, "cpp");
    }

    /// DCI import class member syntax keeps constructor and field declarations
    /// declarative (`A();`, `data: i32;`), but methods are still Vyx functions:
    /// `fn func();`, `public static fn bump(x: i32) -> i32;`,
    /// `override final fn add(x: i32) -> i32;`.
    /// Methods with bodies are Vyx extension methods on the imported type.
    public fn parse_extern_dci_class_member(self,
                                            owner_name: string,
                                            owner_generics: string,
                                            abi: string) -> rawptr {
        var doc: string = self.current_doc();
        var attrs = self.collect_leading_attributes();
        if (doc.len == 0) { doc = self.current_doc(); }
        var markers: string = "";
        var is_pub: bool = false;
        var is_static: bool = false;
        while (self.lex() == "override" || self.lex() == "virtual" || self.lex() == "final") {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        var visibility: string = "";
        if (self.accept(tk_KEYWORD_PUBLIC())) {
            is_pub = true;
            visibility = "public";
        } else if (self.lex() == "private" || self.lex() == "internal" || self.lex() == "protected") {
            visibility = self.lex();
            self.advance();
        }
        let attrs_after_visibility = self.collect_leading_attributes();
        if (attrs_after_visibility.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_visibility;
        }
        if (self.accept(tk_KEYWORD_STATIC())) {
            is_static = true;
            markers = markers + "|marker:static";
        }
        while (self.lex() == "override" || self.lex() == "virtual" || self.lex() == "final") {
            markers = markers + "|marker:" + self.lex();
            self.advance();
        }
        let attrs_after_static = self.collect_leading_attributes();
        if (attrs_after_static.len > 0) {
            if (attrs.len > 0) { attrs = attrs + ","; }
            attrs = attrs + attrs_after_static;
        }
        let k = self.kind();
        if (owner_name.len > 0
            && self.owner_ctor_name_matches(owner_name)
            && self.kind_at(self.cur_idx + 1) == tk_LPAREN()) {
            let ctor = self.parse_constructor(is_pub, owner_name, owner_generics);
            let ctor_markers = markers + "|kind:constructor"
                + self.extern_dci_member_markers(ctor, true, abi.clone());
            return self.attach_decl_meta(ctor, visibility.clone(), attrs.clone(), doc.clone(), ctor_markers);
        }
        if (k == tk_TILDE()) {
            let dtor = self.parse_extern_dci_destructor(is_pub, owner_name);
            var dtor_markers = markers + "|kind:destructor"
                + self.extern_dci_member_markers(dtor, false, abi.clone())
                + "|foreign_dci_dtor";
            if (self.extern_abi_is_cpp(abi.clone())) {
                dtor_markers = dtor_markers + "|foreign_cpp_dtor";
            }
            return self.attach_decl_meta(dtor,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         dtor_markers);
        }
        if (k == tk_KEYWORD_FN()) {
            let md = self.parse_method(is_pub, is_static);
            return self.attach_decl_meta(md,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + self.extern_dci_member_markers(md, false, abi.clone()));
        }
        if (k == tk_KEYWORD_CONST()) {
            let c = self.parse_const_member(is_pub);
            return self.attach_decl_meta(c,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + self.extern_dci_decl_markers(abi.clone()));
        }
        if (k == tk_KEYWORD_TYPE()) {
            let t = self.parse_type_member(is_pub);
            return self.attach_decl_meta(t,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + self.extern_dci_decl_markers(abi.clone()));
        }
        if (k == tk_KEYWORD_VAR() || k == tk_KEYWORD_LET()) {
            let field_is_var = (k == tk_KEYWORD_VAR());
            self.advance();
            let f = self.parse_field(is_pub);
            if (f != null) {
                if (field_is_var) {
                    decl_set_generic_params(f, "|kind:var");
                } else {
                    decl_set_generic_params(f, "|kind:let");
                }
            }
            return self.attach_decl_meta(f,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + self.extern_dci_decl_markers(abi.clone()));
        }
        if (self.is_soft_name_token()) {
            if (self.kind_at(self.cur_idx + 1) == tk_LPAREN()) {
                self.report_error("DCI extern class methods must use `fn` syntax");
                return null;
            }
            let f2 = self.parse_field(is_pub);
            return self.attach_decl_meta(f2,
                                         visibility.clone(),
                                         attrs.clone(),
                                         doc.clone(),
                                         markers + self.extern_dci_decl_markers(abi));
        }
        self.report_error("expect DCI constructor, `fn` method, or field declaration");
        return null;
    }

    public fn parse_extern_cpp_class_member(self, owner_name: string, owner_generics: string) -> rawptr {
        return self.parse_extern_dci_class_member(owner_name, owner_generics, "cpp");
    }

    public fn parse_extern_dci_destructor(self, is_pub: bool, owner_name: string) -> rawptr {
        self.advance();
        let d = decl_alloc(de_METHOD(), "drop");
        decl_set_generic_params(d, "|kind:destructor");
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, false);
        decl_set_ty(d, tref_alloc(ty_VOID(), ""));
        if (!self.owner_ctor_name_matches(owner_name)) {
            self.report_error("expect DCI destructor owner name after '~'");
        } else {
            self.advance();
        }
        self.expect_kind(tk_LPAREN(), "'(' after destructor name");
        if (self.kind() != tk_RPAREN()) {
            self.report_error("DCI destructor declaration cannot have parameters");
            while (self.kind() != tk_RPAREN()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_RBRACE()
                && self.kind() != tk_EOF()) {
                self.advance();
            }
        }
        self.expect_kind(tk_RPAREN(), "')' after destructor parameters");
        self.expect_kind(tk_SEMI(), "';' after destructor declaration");
        return d;
    }

    public fn parse_extern_cpp_destructor(self, is_pub: bool, owner_name: string) -> rawptr {
        return self.parse_extern_dci_destructor(is_pub, owner_name);
    }

    public fn constructor_return_type_name(self, owner_name: string, owner_generics: string) -> string {
        if (owner_generics.len == 0) { return owner_name; }
        var args = "";
        var idx: i32 = 0;
        while (idx < 64) {
            var part = policy_generic_arg_at(owner_generics.clone(), idx);
            if (part.len == 0) { break; }
            var marker: i32 = -1;
            var scan: i32 = 0;
            while (scan < part.len) {
                if (part.charAt(scan) == 94) {
                    marker = scan;
                    scan = part.len as i32;
                } else {
                    scan = scan + 1;
                }
            }
            if (marker >= 0) { part = str_view_range(part, 0, marker); }
            if (part.len > 0) {
                if (args.len > 0) { args = args + ","; }
                args = args + part;
            }
            idx = idx + 1;
        }
        if (args.len == 0) { return owner_name; }
        return owner_name + "::<" + args + ">";
    }

    /// `ClassName(args) { body }` inside a class body. The syntax is a
    /// constructor declaration; internally it is a static method named
    /// `constructor` returning the concrete owner type.
    public fn parse_constructor(self, is_pub: bool, owner_name: string, owner_generics: string) -> rawptr {
        self.advance();   // consume owner class name
        let d = decl_alloc(de_METHOD(), "constructor");
        decl_set_generic_params(d, "|kind:constructor");
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, true);
        decl_set_ty(d, tref_alloc(ty_CLASS(), self.constructor_return_type_name(owner_name, owner_generics)));
        self.expect_kind(tk_LPAREN(), "'('");
        decl_set_params(d, self.parse_params());
        self.expect_kind(tk_RPAREN(), "')'");
        if (self.accept(tk_ARROW())) {
            decl_set_ty(d, self.parse_type());
        }
        var has_where: bool = false;
        if (self.accept(tk_KEYWORD_WHERE())) {
            has_where = true;
        } else if (self.accept(tk_KEYWORD_REQUIRES())) {
            has_where = true;
        }
        if (has_where) {
            decl_set_generic_params(d, decl_get_generic_params(d) + "|where:");
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                decl_set_generic_params(d, decl_get_generic_params(d) + self.lex());
                self.advance();
            }
        }
        if (self.check(tk_LBRACE())) {
            decl_set_body(d, self.parse_block());
        } else {
            self.expect_kind(tk_SEMI(), "'{' or ';'");
        }
        return d;
    }

    /// `NAME : TYPE [= EXPR]? [;]?`  — class field.
    ///
    /// `;` is OPTIONAL when the next token unambiguously starts another
    /// class-body member (`public`, `static`, `fn`, an identifier-named
    /// field) or closes the class (`}`). The host vyxc / bootstrap
    /// codebase itself uses field syntax without `;` (e.g.
    /// `bootstrap.parser` `Parser`), and the spec lets us treat the
    /// terminator as elidable. Insisting on `;` would otherwise emit
    /// one diagnostic per field for every class in the tree.
    public fn parse_field(self, is_pub: bool) -> rawptr {
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_FIELD(), name);
        decl_set_generic_params(d, "|kind:const");
        decl_set_is_public(d, is_pub);
        self.expect_kind(tk_COLON(), "':' before field type");
        decl_set_ty(d, self.parse_type());
        if (self.accept(tk_EQ())) {
            let init = self.parse_expr();
            let init_cell = stmt_alloc(st_EXPR());
            stmt_set_init(init_cell, init);
            decl_set_body(d, init_cell);
        }
        let nk = self.kind();
        if (nk == tk_SEMI()) {
            self.advance();
        } else if (nk == tk_KEYWORD_PUBLIC()
                || nk == tk_KEYWORD_STATIC()
                || nk == tk_KEYWORD_FN()
                || nk == tk_KEYWORD_VAR()
                || nk == tk_KEYWORD_LET()
                || nk == tk_IDENT()
                || self.is_soft_name_token()
                || nk == tk_RBRACE()) {
            // `;` elided — next token unambiguously opens the following
            // class member or closes the class body. No diagnostic.
        } else {
            self.report_error("expect ';' after field");
        }
        return d;
    }

    public fn parse_const_member(self, is_pub: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect const member name");
            return null;
        }
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_FIELD(), name);
        decl_set_generic_params(d, "|kind:assoc_const");
        decl_set_is_public(d, is_pub);
        if (self.accept(tk_COLON())) {
            decl_set_ty(d, self.parse_type());
        } else {
            decl_set_ty(d, tref_alloc(ty_I64(), ""));
        }
        if (self.accept(tk_EQ())) {
            let init = self.parse_expr();
            let cell = stmt_alloc(st_EXPR());
            stmt_set_init(cell, init);
            decl_set_body(d, cell);
        }
        self.accept(tk_SEMI());
        return d;
    }

    public fn parse_type_member(self, is_pub: bool) -> rawptr {
        self.advance();
        if (self.kind() != tk_IDENT()) {
            self.report_error("expect type member name");
            return null;
        }
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_FIELD(), name);
        decl_set_generic_params(d, "|kind:assoc_type");
        decl_set_is_public(d, is_pub);
        var ty: rawptr = tref_alloc(ty_CLASS(), name);
        if (self.accept(tk_EQ())) {
            ty = self.parse_type();
        }
        decl_set_ty(d, ty);
        self.accept(tk_SEMI());
        return d;
    }

    public fn parse_optional_cpp_method_cv(self, d: rawptr) {
        if (d == null) { return; }
        if (self.accept(tk_KEYWORD_CONST())) {
            decl_set_generic_params(d, decl_get_generic_params(d) + "|dci_const|cpp_const");
        }
    }

    /// `fn NAME(ps) -> T { body }` — class method
    public fn parse_method(self, is_pub: bool, is_static: bool) -> rawptr {
        self.advance();   // consume 'fn'
        let name = self.parse_operator_decl_name("method name");
        if (name.len == 0) { return null; }
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_METHOD(), name);
        decl_set_generic_params(d, generics);
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, is_static);
        self.expect_kind(tk_LPAREN(), "'('");
        decl_set_params(d, self.parse_params());
        self.expect_kind(tk_RPAREN(), "')'");
        self.parse_optional_cpp_method_cv(d);
        if (self.accept(tk_ARROW())) {
            decl_set_ty(d, self.parse_type());
        }
        var has_where: bool = false;
        if (self.accept(tk_KEYWORD_WHERE())) {
            has_where = true;
        } else if (self.accept(tk_KEYWORD_REQUIRES())) {
            has_where = true;
        }
        if (has_where) {
            decl_set_generic_params(d, generics + "|where:");
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                decl_set_generic_params(d, decl_get_generic_params(d) + self.lex());
                self.advance();
            }
        }
        if (self.check(tk_LBRACE())) {
            decl_set_body(d, self.parse_block());
        } else {
            self.expect_kind(tk_SEMI(), "'{' or ';'");
        }
        return d;
    }

    /// `[public] fn NAME(ps) -> T { body }` — free function
    public fn parse_fn(self, is_pub: bool, is_static: bool) -> rawptr {
        self.advance();   // consume 'fn'
        let name = self.parse_operator_decl_name("function name");
        if (name.len == 0) { return null; }
        let generics = self.parse_optional_generic_params();
        let d = decl_alloc(de_FN(), name);
        decl_set_generic_params(d, generics);
        decl_set_is_public(d, is_pub);
        decl_set_is_static(d, is_static);
        self.expect_kind(tk_LPAREN(), "'('");
        decl_set_params(d, self.parse_params());
        self.expect_kind(tk_RPAREN(), "')'");
        if (self.accept(tk_ARROW())) {
            decl_set_ty(d, self.parse_type());
        }
        var has_where: bool = false;
        if (self.accept(tk_KEYWORD_WHERE())) {
            has_where = true;
        } else if (self.accept(tk_KEYWORD_REQUIRES())) {
            has_where = true;
        }
        if (has_where) {
            decl_set_generic_params(d, generics + "|where:");
            while (self.kind() != tk_LBRACE()
                && self.kind() != tk_SEMI()
                && self.kind() != tk_EOF()) {
                decl_set_generic_params(d, decl_get_generic_params(d) + self.lex());
                self.advance();
            }
        }
        if (self.check(tk_LBRACE())) {
            decl_set_body(d, self.parse_block());
        } else {
            self.expect_kind(tk_SEMI(), "'{' or ';'");
        }
        return d;
    }

    /// Comma-separated `name : type` pairs. Returns a linked list of
    /// `Decl(DE_FIELD)` nodes hung off the caller's `params` slot.
    public fn parse_params(self) -> rawptr {
        if (self.kind() == tk_RPAREN()) { return null; }
        var head: rawptr = null;
        var tail: rawptr = null;
        var cont: bool = true;
        while (cont) {
            let one = self.parse_one_param();
            if (one != null) {
                if (head == null) { head = one; tail = one; }
                else {
                    decl_set_next(tail, one);
                    tail = one;
                }
            }
            if (!self.accept(tk_COMMA())) { cont = false; }
        }
        return head;
    }

    public fn parse_one_param(self) -> rawptr {
        var is_variadic: bool = false;
        if (self.kind() == tk_ELLIPSIS()) {
            let after_ellipsis = self.kind_at(self.cur_idx + 1);
            if (after_ellipsis == tk_RPAREN()
                || after_ellipsis == tk_COMMA()
                || after_ellipsis == tk_EOF()) {
                self.advance();
                let cva = decl_alloc(de_FIELD(), "__c_varargs");
                decl_set_generic_params(cva, "|c_varargs");
                return cva;
            }
            is_variadic = true;
            self.advance();
        }
        if (!is_variadic && self.kind() == tk_AMP()) {
            let next_kind = self.kind_at(self.cur_idx + 1);
            let next_next_kind = self.kind_at(self.cur_idx + 2);
            if (next_kind == tk_KEYWORD_SELF()
                || (next_kind == tk_KEYWORD_MUT()
                    && next_next_kind == tk_KEYWORD_SELF())) {
                let receiver = decl_alloc(de_FIELD(), "self");
                self.advance(); // '&'
                var mode = "shared";
                if (self.accept(tk_KEYWORD_MUT())) { mode = "mut"; }
                self.expect_kind(tk_KEYWORD_SELF(), "'self'");
                parser_mark_self_receiver(receiver, mode);
                return receiver;
            }
        }
        if (!is_variadic && self.lex() == "own") {
            if (self.kind_at(self.cur_idx + 1) == tk_KEYWORD_SELF()) {
                let own_receiver = decl_alloc(de_FIELD(), "self");
                self.advance(); // 'own'
                self.expect_kind(tk_KEYWORD_SELF(), "'self'");
                parser_mark_self_receiver(own_receiver, "own");
                return own_receiver;
            }
            self.report_error("`own` is only valid as `own self`");
            self.advance();
            return null;
        }
        var param_mut = false;
        if (!is_variadic && self.kind() == tk_KEYWORD_MUT()) {
            let after_mut = self.kind_at(self.cur_idx + 1);
            if (after_mut == tk_KEYWORD_SELF()) {
                let mut_receiver = decl_alloc(de_FIELD(), "self");
                self.advance(); // 'mut'
                self.expect_kind(tk_KEYWORD_SELF(), "'self'");
                parser_mark_self_receiver(mut_receiver, "own_mut");
                return mut_receiver;
            }
            param_mut = true;
            self.advance(); // 'mut'
        }
        let pk = self.kind();
        if (pk != tk_KEYWORD_SELF() && !self.is_soft_name_token()) {
            self.report_error("expect parameter name");
            return null;
        }
        let name = self.lex();
        self.advance();
        let d = decl_alloc(de_FIELD(), name);
        if (is_variadic) {
            decl_set_generic_params(d, "|variadic");
        }
        if (param_mut) {
            decl_set_generic_params(d, decl_get_generic_params(d) + "|param:mut");
        }
        // `self` receiver in instance methods is bound by name only —
        // no `: TYPE` follows. We leave `ty` null here; `parse_class`
        // back-fills it with `tref_alloc(ty_CLASS(), <enclosing-class>)`
        // once it knows the owning class name. Any other parameter must
        // still carry an explicit type annotation.
        if (name == "self" && self.kind() != tk_COLON()) {
            parser_mark_self_receiver(d, "compat");
            return d;
        }
        if (name == "self") { parser_mark_self_receiver(d, "compat"); }
        self.expect_kind(tk_COLON(), "':' after parameter name");
        if (self.kind() == tk_ELLIPSIS()) {
            self.advance();
            decl_set_generic_params(d, decl_get_generic_params(d) + "|variadic");
            decl_set_ty(d, self.parse_type());
        } else {
            decl_set_ty(d, self.parse_type());
        }
        if (self.accept(tk_EQ())) {
            let init = self.parse_expr();
            let cell = stmt_alloc(st_EXPR());
            stmt_set_init(cell, init);
            decl_set_body(d, cell);
        }
        return d;
    }

    // ── Top-level driver ────────────────────────────────────────────
    //
    // `run` walks the entire token stream and accumulates the top-level
    // decl chain into self.decls_head / self.decls_tail / self.decls_count.

    public fn run(self) {
        while (!self.at_end()) {
            let before = self.cur_idx;
            let d = self.parse_decl();
            if (d != null) {
                self.append_decl_chain(d);
            } else {
                self.synchronize();
                // At top level an unmatched closing brace has no owner. The
                // nested recovery paths preserve it for their enclosing loop,
                // while the root parser consumes it without a second cascade.
                self.accept(tk_RBRACE());
            }
            self.ensure_progress(before);
        }
    }
}

// ════════════════════════════════════════════════════════════════════
//   Public entry points (ABI-stable for main.vyx)
// ════════════════════════════════════════════════════════════════════

/// Parse one translation unit from a `lex_source` rawptr handle.
/// Returns a `Unit`-as-rawptr, or null when parser diagnostics were emitted.
/// An empty but syntactically valid input becomes `decls = null, decl_count = 0`.
public fn parse_unit(lex_handle: rawptr) -> rawptr {
    let p = Parser.create(lex_handle);
    p.run();
    if (p.error_count > 0) {
        return null;
    }
    let unit = unit_alloc();
    unit_set_decls(unit, p.decls_head);
    unit_set_decl_count(unit, p.decls_count);
    return unit;
}

/// Read-only count of parse errors observed so far. `state` is meant
/// to be a Parser rawptr; callers that don't have one (or that pass
/// null) get a safe 0 back.
public fn parser_error_count(state: rawptr) -> i32 {
    if (state == null) { return 0; }
    let p = state as Parser;
    return p.error_count;
}

/// Optional teardown hook. The Parser owns no malloc'd buffers
/// (everything goes through ast_alloc / lex result), so this is a
/// null-safe no-op.
public fn parser_dispose(state: rawptr) -> i32 {
    if (state == null) { return 0; }
    return 0;
}
