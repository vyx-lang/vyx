module bootstrap.sema;

use std.clone;
use std.fs;
use std.string;
use bootstrap.ast;
use bootstrap.lexer;
use bootstrap.parser;
use bootstrap.policy;
use bootstrap.canon;
use bootstrap.diag;
use bootstrap.effect;
use bootstrap.mono_scheduler;
use bootstrap.fact_base;
use bootstrap.trait_solver;
use bootstrap.lang_items;
use bootstrap.template_artifact;

/// Semantic analysis — bootstrap **pipeline order** is a 1:1 structural mirror of
/// `vyx::Sema::analyze(TranslationUnit&)` in **`src/Sema/Sema.cpp` (L725–L1453)**.
/// Entry: `Sema.run_host_analyze_pipeline` → same phase sequence as the C++ driver.
///
/// 「一比一」在此指：**阶段划分与调用顺序**与宿主一致；各阶段内部语义须从下列 C++ 区域逐段翻译，
/// 直至与 `SemaDecl.cpp` / `SemaExpr.cpp` / `SemaStmt.cpp` / `SemaResolve.cpp` / `SemaGeneric.cpp` 等一致。
///
/// | Phase | `Sema.cpp` (approx) | Bootstrap |
/// |-------|---------------------|-----------|
/// | Reset ODR / per-TU state | L728–733 | `host_analyze_reset_odr_state` *(clears `file_module`)* |
/// | `declModule_` replay (`__module` stack) | L735–808 | `host_analyze_build_decl_module_map` *(sets `file_module`)* |
/// | Pass 0: import markers / aliases | L810–845 | `host_analyze_pass0_import_aliases` *(walk `DE_USE` → `seed_use`)* |
/// | `applyPreludeImports` | L847–853 | `host_analyze_apply_prelude_imports` |
/// | `scanLangItemAttributes` | L855–858 | `host_analyze_scan_lang_item_attributes` |
/// | Phase A: prim `impl Trait for Prim` → FactBase | L860–896 | `host_analyze_phase_a_primitive_impl_facts` |
/// | First pass: register type decls (+ extern) | L898–1088 | **merged into** `collect_decls` |
/// | Std short-name alias pass | L1090–1124 | `host_analyze_register_std_short_name_aliases` *(qualified class → bare `Name` sym)* |
/// | Pre-register function sigs + overload groups | L1126–1317 | **merged into** `collect_decls` |
/// | `synthesizeDeriveMethods` | L1340 | `host_analyze_synthesize_derive_methods` |
/// | `analyzeDecl` — non-`Function` | L1350–1355 | `host_analyze_decl_pass_non_functions` |
/// | `injectStructuralTraitDefaults` | L1356 | `host_analyze_inject_structural_trait_defaults` |
/// | `analyzeDecl` — `Function` only | L1357–1362 | `host_analyze_decl_pass_functions` |
/// | `analyzeAllMethodBodies` | L1367–1383 | `host_analyze_all_method_bodies` |
/// | Circular `Ref<>` warning pass | L1385–1437 | `host_analyze_ref_cycle_check` |
/// | Flush `pendingInstantiations_` | L1440–1443 | `host_analyze_append_pending_instantiations` |
/// | Telemetry dumps | L1445–1452 | `host_analyze_dump_*` |
/// | *(bodies / expr types)* | `SemaExpr.cpp` / `SemaStmt.cpp` / … | **`resolve_unit`**（bootstrap 合并体） |
///
/// All state that must survive a function return is malloc-backed:
///   * Symbol-table entries (`SymEntry`) live as 56 B malloc'd byte
///     records (name ptr/len + decl rawptr + ty rawptr + next rawptr).
///   * The Sema-state handle returned by `analyze_unit` is a 16 B
///     malloc'd byte record holding (error_count, class_count,
///     func_count) so `check_program / infer_types / resolve_names`
///     can read those counters after the producing scope is gone.
///
/// `Sema` itself remains a Vyx class because it is created as a local
/// inside `analyze_unit` and only ever consumed via `self.method(…)`.
/// Inside that scope, host vyxc commits `self.field` writes back to
/// the heap object as expected; we just never let the class instance
/// itself escape the scope.
///
/// Pass 1 `Sema.collect_decls`: register every CLASS / FN / EXTERN_FN
/// top-level + per-class FIELD / METHOD; flag duplicate names.
/// Pass 2 `Sema.resolve_unit`: walk every fn/method body, populate
/// `expr.ty`, enforce bootstrap typing rules and lexical scopes.
///
/// Both passes execute back-to-back inside `analyze_unit`. The
/// returned rawptr is the Sema-state handle described above, NOT a
/// re-cast Vyx class.

extern "C" {
    fn vyx_lsp_bind_source(path: rawptr, length: rawptr) -> rawptr;
    fn vyx_lsp_bind_parse_push(path: rawptr);
    fn vyx_lsp_bind_parse_pop();
    fn vyx_lsp_bind_root() -> rawptr;
    fn vyx_lsp_bind_decl_is_root(node: rawptr) -> i32;
    fn vyx_lsp_bind_decl_needed(node: rawptr) -> i32;
    fn vyx_lsp_bind_decl_scope(node: rawptr, scope: rawptr, length: i64);
    fn vyx_lsp_bind_parse_errors(count: i32);
    fn vyx_lsp_bind_sibling() -> rawptr;
    fn vyx_lsp_bind_prepare(unit: rawptr);
    fn vyx_lsp_bind_next_type() -> rawptr;
    fn vyx_lsp_bind_owner(node: rawptr) -> rawptr;
    fn vyx_lsp_bind_role(node: rawptr) -> i32;
    fn vyx_lsp_bind_name(node: rawptr) -> rawptr;
    fn vyx_lsp_bind_target(node: rawptr, target: rawptr);
    fn vyx_lsp_bind_module(node: rawptr, name: rawptr, length: i64);
    fn vyx_lsp_bind_generic_target(node: rawptr, owner: rawptr, name: rawptr, length: i64) -> i32;
    fn vyx_lsp_bind_finish(errors: i32);
    fn vyx_lsp_bind_copy(from: rawptr, to: rawptr);

    fn getenv(name: rawptr) -> rawptr;
    fn vyx_frontend_alloc(size: u64) -> rawptr;
    fn vyx_frontend_free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: u64) -> i32;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strstr(haystack: rawptr, needle: rawptr) -> rawptr;
    fn vyx_string_contains(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
    fn vyx_string_starts_with(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_platform() -> i32;
    fn vyx_bootstrap_file_size(path: rawptr) -> i64;
    fn strlen(s: rawptr) -> i64;
    fn vyx_type_text_cache_get(ty: rawptr) -> rawptr;
    fn vyx_type_text_cache_put(ty: rawptr, s: rawptr, len: i64);
    fn vyx_type_text_cache_clear();
    fn vyx_intern_bytes(s: rawptr, len: i64) -> rawptr;
    fn vyx_intern_concat2(a: rawptr, alen: i64, b: rawptr, blen: i64) -> rawptr;
    fn vyx_intern_concat3(a: rawptr, alen: i64, b: rawptr, blen: i64, c: rawptr, clen: i64) -> rawptr;
    fn vyx_intern_concat4(a: rawptr, alen: i64, b: rawptr, blen: i64, c: rawptr, clen: i64, d: rawptr, dlen: i64) -> rawptr;
}

// ════════════════════════════════════════════════════════════════════
//   SymEntry — malloc'd 56 B linked-list record.
//
//   Layout:
//     0..7   name_ptr : rawptr
//     8..15  name_len : i64
//     16..23 decl     : rawptr
//     24..31 ty       : rawptr (TypeRef*)
//     32..39 next     : rawptr (next SymEntry)
//     40..43 is_const : i32
//     44..47 alloc_state : i32 (pointer allocation/borrow fact)
//     48..55 borrow_source : rawptr (canonical source SymEntry for views/aliases)
//     56..59 shared_borrows : i32 (live immutable views of this region root)
//     60..63 mutable_borrows: i32 (live mutable views of this region root)
//     64..71 borrow_loc: rawptr (source location of the borrow expression)
// ════════════════════════════════════════════════════════════════════

fn sema_alloc_state_none() -> i32 { return 0; }
fn sema_alloc_state_empty() -> i32 { return 1; }
fn sema_alloc_state_owned_single() -> i32 { return 2; }
fn sema_alloc_state_owned_array() -> i32 { return 3; }
fn sema_alloc_state_borrowed_immutable() -> i32 { return 4; }
fn sema_alloc_state_borrowed_mutable() -> i32 { return 5; }
fn sema_alloc_state_unknown_pointer() -> i32 { return 6; }
fn sema_alloc_state_compat_alias() -> i32 { return 7; }
fn sema_alloc_state_dead() -> i32 { return 8; }
fn sema_alloc_state_compat_this() -> i32 { return 9; }

fn sema_receiver_mode_none() -> i32 { return 0; }
fn sema_receiver_mode_compat() -> i32 { return 1; }
fn sema_receiver_mode_own() -> i32 { return 2; }
fn sema_receiver_mode_shared() -> i32 { return 3; }
fn sema_receiver_mode_mut() -> i32 { return 4; }
fn sema_receiver_mode_own_mut() -> i32 { return 5; }

fn sema_receiver_mode(param: rawptr) -> i32 {
    if (param == null || decl_get_name(param) != "self") {
        return sema_receiver_mode_none();
    }
    let markers = decl_get_generic_params(param);
    if (string_contains(markers, "|receiver:own_mut")) { return sema_receiver_mode_own_mut(); }
    if (string_contains(markers, "|receiver:own")) { return sema_receiver_mode_own(); }
    if (string_contains(markers, "|receiver:shared")) { return sema_receiver_mode_shared(); }
    if (string_contains(markers, "|receiver:mut")) { return sema_receiver_mode_mut(); }
    return sema_receiver_mode_compat();
}

fn sema_receiver_mode_is_consuming(mode: i32) -> bool {
    return mode == sema_receiver_mode_own()
        || mode == sema_receiver_mode_own_mut();
}

fn sema_alloc_state_from_type(ty: rawptr) -> i32 {
    if (ty == null) { return sema_alloc_state_none(); }
    let k = tref_get_kind(ty);
    if (k == ty_REF()) { return sema_alloc_state_borrowed_immutable(); }
    if (k == ty_MUTREF()) { return sema_alloc_state_borrowed_mutable(); }
    return sema_alloc_state_none();
}

fn sema_mark_receiver_mode_if_missing(param: rawptr, mode: string) {
    if (param == null || decl_get_name(param) != "self") { return; }
    let markers = decl_get_generic_params(param);
    if (!string_contains(markers, "|receiver:")) {
        decl_set_generic_params(param, markers + "|receiver:" + mode);
    }
}

fn sema_mark_receiver_compat_if_missing(param: rawptr) {
    sema_mark_receiver_mode_if_missing(param, "compat");
}

fn sym_alloc(name: string) -> rawptr {
    let p = vyx_frontend_alloc(72);
    if (p == null) { return null; }
    memset(p, 0, 72);
    let buf = ast_dup_c_string(name);
    ast_write_rawptr(p, buf);
    ast_write_i64(ptr_offset(p, 8), name.len);
    return p;
}

fn sym_get_name(p: rawptr) -> string {
    if (p == null) { return ""; }
    let buf = ast_read_rawptr(p);
    let len = ast_read_i64(ptr_offset(p, 8));
    if (buf == null) { return ""; }
    return from_cstr_view_len(buf, len);
}

fn sym_get_decl(p: rawptr) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, 16));
}

fn sym_get_ty(p: rawptr) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, 24));
}

fn sym_get_next(p: rawptr) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, 32));
}

fn sym_get_is_const(p: rawptr) -> bool {
    if (p == null) { return false; }
    return ast_read_i32(ptr_offset(p, 40)) != 0;
}

fn sym_get_alloc_state(p: rawptr) -> i32 {
    if (p == null) { return sema_alloc_state_none(); }
    return ast_read_i32(ptr_offset(p, 44));
}

fn sym_get_borrow_source(p: rawptr) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, 48));
}

fn sym_get_shared_borrows(p: rawptr) -> i32 {
    if (p == null) { return 0; }
    return ast_read_i32(ptr_offset(p, 56));
}

fn sym_get_mutable_borrows(p: rawptr) -> i32 {
    if (p == null) { return 0; }
    return ast_read_i32(ptr_offset(p, 60));
}

fn sym_get_borrow_loc(p: rawptr) -> rawptr {
    if (p == null) { return null; }
    return ast_read_rawptr(ptr_offset(p, 64));
}

fn sym_set_decl(p: rawptr, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, 16), v);
}

fn sym_set_ty(p: rawptr, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, 24), v);
}

fn sym_set_next(p: rawptr, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, 32), v);
}

fn sym_set_is_const(p: rawptr, v: bool) {
    if (p == null) { return; }
    var n: i32 = 0;
    if (v) { n = 1; }
    ast_write_i32(ptr_offset(p, 40), n);
}

fn sym_set_alloc_state(p: rawptr, v: i32) {
    if (p == null) { return; }
    ast_write_i32(ptr_offset(p, 44), v);
}

fn sym_set_borrow_source(p: rawptr, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, 48), v);
}

fn sym_set_shared_borrows(p: rawptr, v: i32) {
    if (p == null) { return; }
    ast_write_i32(ptr_offset(p, 56), v);
}

fn sym_set_mutable_borrows(p: rawptr, v: i32) {
    if (p == null) { return; }
    ast_write_i32(ptr_offset(p, 60), v);
}

fn sym_set_borrow_loc(p: rawptr, v: rawptr) {
    if (p == null) { return; }
    ast_write_rawptr(ptr_offset(p, 64), v);
}

fn sym_region_root(p: rawptr) -> rawptr {
    var cur = p;
    var guard: i32 = 0;
    while (cur != null && guard < 128) {
        let state = sym_get_alloc_state(cur);
        if (state != sema_alloc_state_compat_alias()
            && state != sema_alloc_state_borrowed_immutable()
            && state != sema_alloc_state_borrowed_mutable()) {
            return cur;
        }
        let next = sym_get_borrow_source(cur);
        if (next == null || next == cur) { return cur; }
        cur = next;
        guard = guard + 1;
    }
    return cur;
}

fn sym_pointer_unusable_state(p: rawptr) -> i32 {
    if (p == null) { return sema_alloc_state_none(); }
    let local_state = sym_get_alloc_state(p);
    if (local_state == sema_alloc_state_empty()
        || local_state == sema_alloc_state_dead()) {
        return local_state;
    }
    let root = sym_region_root(p);
    if (root != null && sym_get_alloc_state(root) == sema_alloc_state_dead()) {
        return sema_alloc_state_dead();
    }
    return local_state;
}

fn sym_register_borrow(view: rawptr) {
    if (view == null) { return; }
    let state = sym_get_alloc_state(view);
    if (state != sema_alloc_state_borrowed_immutable()
        && state != sema_alloc_state_borrowed_mutable()) {
        return;
    }
    let root = sym_region_root(view);
    if (root == null || root == view) { return; }
    if (state == sema_alloc_state_borrowed_immutable()) {
        sym_set_shared_borrows(root, sym_get_shared_borrows(root) + 1);
    } else {
        sym_set_mutable_borrows(root, sym_get_mutable_borrows(root) + 1);
    }
}

fn sym_release_borrow(view: rawptr) {
    if (view == null) { return; }
    let state = sym_get_alloc_state(view);
    if (state != sema_alloc_state_borrowed_immutable()
        && state != sema_alloc_state_borrowed_mutable()) {
        return;
    }
    let root = sym_region_root(view);
    if (root == null || root == view) { return; }
    if (state == sema_alloc_state_borrowed_immutable()) {
        var count = sym_get_shared_borrows(root);
        if (count > 0) { count = count - 1; }
        sym_set_shared_borrows(root, count);
    } else {
        var count2 = sym_get_mutable_borrows(root);
        if (count2 > 0) { count2 = count2 - 1; }
        sym_set_mutable_borrows(root, count2);
    }
}

fn sym_release_scope_borrows(head: rawptr, stop: rawptr) {
    var cur = head;
    var guard: i32 = 0;
    while (cur != null && cur != stop && guard < 65536) {
        sym_release_borrow(cur);
        cur = sym_get_next(cur);
        guard = guard + 1;
    }
}

fn sym_end_borrow(view: rawptr) {
    if (view == null) { return; }
    sym_release_borrow(view);
    sym_set_alloc_state(view, sema_alloc_state_unknown_pointer());
    sym_set_borrow_source(view, null);
    sym_set_borrow_loc(view, null);
}

fn sym_is_borrow_guard(p: rawptr) -> bool {
    if (p == null) { return false; }
    return sym_get_name(p).startsWith("|borrow-guard:");
}

fn sym_borrow_guard_source_name(p: rawptr) -> string {
    if (!sym_is_borrow_guard(p)) { return sym_get_name(p); }
    let name = sym_get_name(p);
    if (name.len <= 14) { return "reference"; }
    return str_view_range(name, 14, name.len);
}

var g_sym_lookup_cache: rawptr = null;
let SYM_LOOKUP_CACHE_CAP: i32 = 8192;
// Sentinel for "this (head, name) is known absent" in the lookup cache.
var g_sym_miss: rawptr = null;

fn sym_lookup_cache_slot(idx: i32) -> rawptr {
    return g_sym_lookup_cache + (idx * 40);
}

fn sym_lookup_cache_hash(head: rawptr, name: string) -> i32 {
    var h: i64 = head as i64;
    if (h < 0) { h = 0 - h; }
    h = h % (SYM_LOOKUP_CACHE_CAP as i64);
    var i: i32 = 0;
    while (i < name.len) {
        h = ((h * 131) + (name.charAt(i) as i64)) % (SYM_LOOKUP_CACHE_CAP as i64);
        i = i + 1;
    }
    return h as i32;
}

fn sym_lookup_cache_ensure() {
    if (g_sym_lookup_cache != null) { return; }
    g_sym_lookup_cache = vyx_frontend_alloc((SYM_LOOKUP_CACHE_CAP * 40) as u64);
    if (g_sym_lookup_cache != null) {
        memset(g_sym_lookup_cache, 0, (SYM_LOOKUP_CACHE_CAP * 40) as u64);
    }
}

fn sym_lookup_cache_get(head: rawptr, name: string) -> rawptr {
    if (g_sym_lookup_cache == null || head == null || name.len == 0) { return null; }
    let slot = sym_lookup_cache_slot(sym_lookup_cache_hash(head, name));
    if (ast_read_i64(ptr_offset(slot, 32)) == 0) { return null; }
    if (ast_read_rawptr(slot) != head) { return null; }
    let key = ast_read_rawptr(ptr_offset(slot, 8));
    let len = ast_read_i64(ptr_offset(slot, 16));
    if (key == null || len != name.len) { return null; }
    if (len > 0 && memcmp(key, name.c_str(), len as u64) != 0) { return null; }
    return ast_read_rawptr(ptr_offset(slot, 24));
}

fn sym_lookup_cache_put(head: rawptr, name: string, found: rawptr) {
    if (g_sym_lookup_cache == null || head == null || name.len == 0 || found == null) { return; }
    sym_lookup_cache_put_any(head.clone(), name.clone(), found);
}

/// Raw slot write; `found` may be the miss token so absent names are
/// remembered.  Only the (head, name) key is verified on lookup, and a
/// chain is immutable for a fixed head, so a cached miss cannot go stale
/// within one analysis.
fn sym_lookup_cache_put_any(head: rawptr, name: string, found: rawptr) {
    if (g_sym_lookup_cache == null || head == null || name.len == 0) { return; }
    let slot = sym_lookup_cache_slot(sym_lookup_cache_hash(head, name));
    let old_key = ast_read_rawptr(ptr_offset(slot, 8));
    if (old_key != null) { vyx_frontend_free(old_key); }
    ast_write_rawptr(slot, head);
    ast_write_rawptr(ptr_offset(slot, 8), ast_dup_c_string(name));
    ast_write_i64(ptr_offset(slot, 16), name.len);
    ast_write_rawptr(ptr_offset(slot, 24), found);
    ast_write_i64(ptr_offset(slot, 32), 1);
}

/// `sym_lookup` used to leave misses uncached, so a name absent from the
/// chain re-scanned the whole chain on every query.  A dedicated token
/// distinguishes "known absent" from "no entry".
fn sym_lookup_miss_token() -> rawptr {
    if (g_sym_miss == null) { g_sym_miss = vyx_frontend_alloc(8); }
    return g_sym_miss;
}

fn sym_lookup_cache_reset() {
    if (g_sym_lookup_cache == null) { return; }
    var i: i32 = 0;
    while (i < SYM_LOOKUP_CACHE_CAP) {
        let slot = sym_lookup_cache_slot(i);
        let key = ast_read_rawptr(ptr_offset(slot, 8));
        if (key != null) { vyx_frontend_free(key); }
        memset(slot, 0, 40);
        i = i + 1;
    }
}

/// (head, name) memo for repeated linear scans over symbol chains.
/// Slot (48 bytes):
///   0 head | 8 key ptr | 16 key len | 24 value ptr | 32 value i64 | 40 occupied
let SEMA_MEMO_SLOT_SIZE: i32 = 48;
let SEMA_MEMO_CAP: i32 = 8192;
var g_overload_count_memo: rawptr = null;
var g_variant_owner_memo: rawptr = null;
var g_latest_class_memo: rawptr = null;
var g_use_alias_memo: rawptr = null;
var g_layout_score_memo: rawptr = null;
/// Set by `sema_expand_short_name` when a short name has multiple FQ candidates.
var g_sema_name_ambiguous: bool = false;
// Whether the one-shot |effective_imported marking pass has run for the
// current compilation unit (see sema_build_effective_imported_once).
var g_sema_eff_imported_built: bool = false;
// Recursion depth for the [res-in]/[res-out] tracing wrapper.
var g_res_fn_depth: i64 = 0;
// Indexes behind sema_module_path_registered (rebuilt per analysis).
var g_unit_mod_set: string = "";
var g_unit_mod_set_key: i32 = -1;
var g_registry_mod_set: string = "";
// Hash-set views of the two blobs above.  A membership probe used to be
// `string_contains(blob, "|mod|")`, which re-scanned a growing blob on
// every query (~265 K probes -> ~4.5 s of the boot crate).
var g_upr_map: rawptr = null;
var g_rpr_map: rawptr = null;
// 4-entry rotating cache for diagnostic source text, plus a read counter
// used to prove the single-entry cache was thrashing.
var g_diag_src_path0: string = "";
var g_diag_src_text0: string = "";
var g_diag_src_path1: string = "";
var g_diag_src_text1: string = "";
var g_diag_src_path2: string = "";
var g_diag_src_text2: string = "";
var g_diag_src_path3: string = "";
var g_diag_src_text3: string = "";

// ════════════════════════════════════════════════════════════════════
//   Name indexes for symbol/registry lookups
//
//   `sema_lookup_class_canonical` used to walk every class/enum symbol on
//   every query and recompute three derived names per entry; the boot crate
//   paid 37.5 M entry visits for it.  `sema_registry_module_exports_symbol`
//   re-parsed every registry line (124 lines, ~90 KB) per query -- 38 M
//   parses.  Both results are derivable from an index built once per unit.
// ════════════════════════════════════════════════════════════════════
let CI_CELL_SIZE: i64 = 16;
let CI_NONE: i64 = -1;

var g_ci_map: rawptr = null;        // name -> cell index + 1
var g_ci_cells: rawptr = null;      // cell: {node, next cell index}
var g_ci_cell_count: i64 = 0;
var g_ci_cell_cap: i64 = 0;
var g_ci_head: rawptr = null;       // classes_buf prefix already indexed
var g_ci_seen: rawptr = null;       // scratch: nodes of the new prefix
var g_ci_seen_cap: i64 = 0;

fn ci_cell_ptr(idx: i64) -> rawptr {
    return ptr_offset(g_ci_cells, idx * CI_CELL_SIZE);
}

fn ci_cell_node(idx: i64) -> rawptr {
    return ast_read_rawptr(ci_cell_ptr(idx));
}

fn ci_cell_next(idx: i64) -> i64 {
    return ast_read_i64(ptr_offset(ci_cell_ptr(idx), 8));
}

fn ci_cells_reserve(need: i64) {
    if (g_ci_cell_cap >= need) { return; }
    var cap = g_ci_cell_cap;
    if (cap <= 0) { cap = 4096; }
    while (cap < need) { cap = cap * 2; }
    let bytes = cap * CI_CELL_SIZE;
    let fresh = vyx_frontend_alloc(bytes as u64);
    if (fresh == null) { return; }
    memset(fresh, 0, bytes as u64);
    if (g_ci_cells != null && g_ci_cell_count > 0) {
        memcpy(fresh, g_ci_cells, (g_ci_cell_count * CI_CELL_SIZE) as u64);
        vyx_frontend_free(g_ci_cells);
    }
    g_ci_cells = fresh;
    g_ci_cell_cap = cap;
}

fn ci_alloc_cell(node: rawptr, next_idx: i64) -> i64 {
    ci_cells_reserve(g_ci_cell_count + 1);
    if (g_ci_cells == null || g_ci_cell_count >= g_ci_cell_cap) { return CI_NONE; }
    let idx = g_ci_cell_count;
    let p = ci_cell_ptr(idx);
    ast_write_rawptr(p, node);
    ast_write_i64(ptr_offset(p, 8), next_idx);
    g_ci_cell_count = idx + 1;
    return idx;
}

fn ci_seen_reserve(need: i64) {
    if (g_ci_seen_cap >= need) { return; }
    var cap = g_ci_seen_cap;
    if (cap <= 0) { cap = 1024; }
    while (cap < need) { cap = cap * 2; }
    let bytes = cap * 8;
    let fresh = vyx_frontend_alloc(bytes as u64);
    if (fresh == null) { return; }
    memset(fresh, 0, bytes as u64);
    if (g_ci_seen != null && g_ci_seen_cap > 0) { vyx_frontend_free(g_ci_seen); }
    g_ci_seen = fresh;
    g_ci_seen_cap = cap;
}

fn ci_dispose() {
    if (g_ci_cells != null) { vyx_frontend_free(g_ci_cells); }
    if (g_ci_seen != null) { vyx_frontend_free(g_ci_seen); }
    if (g_ci_map != null) { sema_string_state_map_dispose(g_ci_map); }
    g_ci_cells = null;
    g_ci_seen = null;
    g_ci_map = null;
    g_ci_cell_count = 0;
    g_ci_cell_cap = 0;
    g_ci_seen_cap = 0;
    g_ci_head = null;
}

fn ci_chain_add(key: string, node: rawptr) {
    if (key.len == 0 || g_ci_map == null) { return; }
    let found = sema_string_state_map_get(g_ci_map, key);
    var head_idx: i64 = CI_NONE;
    if (found > 0) { head_idx = (found as i64) - 1; }
    let idx = ci_alloc_cell(node, head_idx);
    if (idx < 0) { return; }
    g_ci_map = sema_string_state_map_put(g_ci_map, key, (idx + 1) as i32);
}

// ── short-name index over classes_buf ────────────────────────────────
// `sema_find_local_short_class_symbol` and
// `sema_find_imported_unique_short_class_symbol` each walked the whole
// class/enum chain per query (~18 K queries -> ~12 s of the boot crate),
// and they are the two leaves `sema_find_class_symbol` falls back to.
// Both only ever return a node whose declared name or symbol key ends in
// the queried segment, so a second chain keyed by that segment answers
// them in the same buffer order without touching unrelated entries.
var g_cs_map: rawptr = null;        // short segment -> cell index + 1
var g_cs_cells: rawptr = null;      // cell: {node, next cell index}
var g_cs_cell_count: i64 = 0;
var g_cs_cell_cap: i64 = 0;

fn cs_cell_ptr(idx: i64) -> rawptr {
    return ptr_offset(g_cs_cells, idx * CI_CELL_SIZE);
}

fn cs_cell_node(idx: i64) -> rawptr {
    return ast_read_rawptr(cs_cell_ptr(idx));
}

fn cs_cell_next(idx: i64) -> i64 {
    return ast_read_i64(ptr_offset(cs_cell_ptr(idx), 8));
}

fn cs_cells_reserve(need: i64) {
    if (g_cs_cell_cap >= need) { return; }
    var cap = g_cs_cell_cap;
    if (cap <= 0) { cap = 4096; }
    while (cap < need) { cap = cap * 2; }
    let bytes = cap * CI_CELL_SIZE;
    let fresh = vyx_frontend_alloc(bytes as u64);
    if (fresh == null) { return; }
    memset(fresh, 0, bytes as u64);
    if (g_cs_cells != null && g_cs_cell_count > 0) {
        memcpy(fresh, g_cs_cells, (g_cs_cell_count * CI_CELL_SIZE) as u64);
        vyx_frontend_free(g_cs_cells);
    }
    g_cs_cells = fresh;
    g_cs_cell_cap = cap;
}

fn cs_alloc_cell(node: rawptr, next_idx: i64) -> i64 {
    cs_cells_reserve(g_cs_cell_count + 1);
    if (g_cs_cells == null || g_cs_cell_count >= g_cs_cell_cap) { return CI_NONE; }
    let idx = g_cs_cell_count;
    let p = cs_cell_ptr(idx);
    ast_write_rawptr(p, node);
    ast_write_i64(ptr_offset(p, 8), next_idx);
    g_cs_cell_count = idx + 1;
    return idx;
}

fn cs_dispose() {
    if (g_cs_cells != null) { vyx_frontend_free(g_cs_cells); }
    if (g_cs_map != null) { sema_string_state_map_dispose(g_cs_map); }
    g_cs_cells = null;
    g_cs_map = null;
    g_cs_cell_count = 0;
    g_cs_cell_cap = 0;
}

fn cs_chain_add(key: string, node: rawptr) {
    if (key.len == 0 || g_cs_map == null) { return; }
    let found = sema_string_state_map_get(g_cs_map, key);
    var head_idx: i64 = CI_NONE;
    if (found > 0) { head_idx = (found as i64) - 1; }
    let idx = cs_alloc_cell(node, head_idx);
    if (idx < 0) { return; }
    g_cs_map = sema_string_state_map_put(g_cs_map, key, (idx + 1) as i32);
}

// ── function-name index over funcs_buf ───────────────────────────────
// `sema_find_func_symbol_in_module` walked every function symbol on every
// query (~600 K queries -> ~4.4 s of the boot crate) and returns the
// first chain entry whose symbol name equals the queried name and whose
// declaration belongs to the queried module.  Keying a chain on that
// symbol name reduces the walk to the (normally one- or two-entry)
// matching chain; the stored buffer position keeps the "first in buffer
// order" tie-break exact when the query expands to three names.
let CF_CELL_SIZE: i64 = 24;         // {node, next cell index, buffer position}

var g_cf_map: rawptr = null;        // symbol name -> cell index + 1
var g_cf_cells: rawptr = null;
var g_cf_cell_count: i64 = 0;
var g_cf_cell_cap: i64 = 0;
var g_cf_head: rawptr = null;       // funcs_buf prefix already indexed
var g_cf_next_pos: i64 = 0;         // monotone buffer position
var g_cf_seen: rawptr = null;       // scratch: nodes of the new prefix
var g_cf_seen_cap: i64 = 0;

fn cf_cell_ptr(idx: i64) -> rawptr {
    return ptr_offset(g_cf_cells, idx * CF_CELL_SIZE);
}

fn cf_cell_node(idx: i64) -> rawptr {
    return ast_read_rawptr(cf_cell_ptr(idx));
}

fn cf_cell_next(idx: i64) -> i64 {
    return ast_read_i64(ptr_offset(cf_cell_ptr(idx), 8));
}

fn cf_cell_pos(idx: i64) -> i64 {
    return ast_read_i64(ptr_offset(cf_cell_ptr(idx), 16));
}

fn cf_cells_reserve(need: i64) {
    if (g_cf_cell_cap >= need) { return; }
    var cap = g_cf_cell_cap;
    if (cap <= 0) { cap = 8192; }
    while (cap < need) { cap = cap * 2; }
    let bytes = cap * CF_CELL_SIZE;
    let fresh = vyx_frontend_alloc(bytes as u64);
    if (fresh == null) { return; }
    memset(fresh, 0, bytes as u64);
    if (g_cf_cells != null && g_cf_cell_count > 0) {
        memcpy(fresh, g_cf_cells, (g_cf_cell_count * CF_CELL_SIZE) as u64);
        vyx_frontend_free(g_cf_cells);
    }
    g_cf_cells = fresh;
    g_cf_cell_cap = cap;
}

fn cf_alloc_cell(node: rawptr, next_idx: i64, pos: i64) -> i64 {
    cf_cells_reserve(g_cf_cell_count + 1);
    if (g_cf_cells == null || g_cf_cell_count >= g_cf_cell_cap) { return CI_NONE; }
    let idx = g_cf_cell_count;
    let p = cf_cell_ptr(idx);
    ast_write_rawptr(p, node);
    ast_write_i64(ptr_offset(p, 8), next_idx);
    ast_write_i64(ptr_offset(p, 16), pos);
    g_cf_cell_count = idx + 1;
    return idx;
}

fn cf_seen_reserve(need: i64) {
    if (g_cf_seen_cap >= need) { return; }
    var cap = g_cf_seen_cap;
    if (cap <= 0) { cap = 2048; }
    while (cap < need) { cap = cap * 2; }
    let bytes = cap * 8;
    let fresh = vyx_frontend_alloc(bytes as u64);
    if (fresh == null) { return; }
    memset(fresh, 0, bytes as u64);
    if (g_cf_seen != null && g_cf_seen_cap > 0) { vyx_frontend_free(g_cf_seen); }
    g_cf_seen = fresh;
    g_cf_seen_cap = cap;
}

fn cf_dispose() {
    if (g_cf_cells != null) { vyx_frontend_free(g_cf_cells); }
    if (g_cf_seen != null) { vyx_frontend_free(g_cf_seen); }
    if (g_cf_map != null) { sema_string_state_map_dispose(g_cf_map); }
    g_cf_cells = null;
    g_cf_seen = null;
    g_cf_map = null;
    g_cf_cell_count = 0;
    g_cf_cell_cap = 0;
    g_cf_seen_cap = 0;
    g_cf_head = null;
    g_cf_next_pos = 0;
}

fn cf_chain_add(key: string, node: rawptr, pos: i64) {
    if (key.len == 0 || g_cf_map == null) { return; }
    let found = sema_string_state_map_get(g_cf_map, key);
    var head_idx: i64 = CI_NONE;
    if (found > 0) { head_idx = (found as i64) - 1; }
    let idx = cf_alloc_cell(node, head_idx, pos);
    if (idx < 0) { return; }
    g_cf_map = sema_string_state_map_put(g_cf_map, key, (idx + 1) as i32);
}

// ── memoised `use` prefixes for sema_expand_short_name ───────────────
// The candidate prefix set is a function of (unit decls, scope module)
// only, but the resolver rebuilt it by walking every decl of the unit for
// every one of ~34 K queries (~17 s of the boot crate).  Cache it on the
// unit head pointer plus the scope so a query inside one body is free.
var g_esn_head: rawptr = null;
var g_esn_unit: rawptr = null;
var g_esn_scope: string = "";
var g_esn_prefixes: string = "";
var g_esn_ready: bool = false;

fn esn_dispose() {
    g_esn_head = null;
    g_esn_unit = null;
    g_esn_scope = "";
    g_esn_prefixes = "";
    g_esn_ready = false;
}

let RI_MAX_MODULES: i64 = 8192;

var g_ri_map: rawptr = null;     // module base -> blob slot + 1
var g_ri_ptrs: rawptr = null;    // blob pointer per slot
var g_ri_lens: rawptr = null;    // blob length per slot
var g_ri_count: i64 = 0;

fn ri_dispose() {
    if (g_ri_ptrs != null) { vyx_frontend_free(g_ri_ptrs); }
    if (g_ri_lens != null) { vyx_frontend_free(g_ri_lens); }
    if (g_ri_map != null) { sema_string_state_map_dispose(g_ri_map); }
    g_ri_ptrs = null;
    g_ri_lens = null;
    g_ri_map = null;
    g_ri_count = 0;
}

fn sema_memo_slot(map: rawptr, idx: i32) -> rawptr {
    return map + (idx * SEMA_MEMO_SLOT_SIZE);
}

fn sema_memo_hash(head: rawptr, name: string) -> i32 {
    var h: i64 = head as i64;
    if (h < 0) { h = 0 - h; }
    h = h % (SEMA_MEMO_CAP as i64);
    var i: i32 = 0;
    while (i < name.len) {
        h = ((h * 131) + (name.charAt(i) as i64)) % (SEMA_MEMO_CAP as i64);
        i = i + 1;
    }
    return h as i32;
}

fn sema_memo_create() -> rawptr {
    let bytes = (SEMA_MEMO_CAP * SEMA_MEMO_SLOT_SIZE) as u64;
    let map = vyx_frontend_alloc(bytes);
    if (map != null) { memset(map, 0, bytes); }
    return map;
}

fn sema_memo_ensure() {
    if (g_overload_count_memo == null) { g_overload_count_memo = sema_memo_create(); }
    if (g_variant_owner_memo == null) { g_variant_owner_memo = sema_memo_create(); }
    if (g_latest_class_memo == null) { g_latest_class_memo = sema_memo_create(); }
    if (g_use_alias_memo == null) { g_use_alias_memo = sema_memo_create(); }
    if (g_layout_score_memo == null) { g_layout_score_memo = sema_memo_create(); }
}

fn sema_memo_lookup(map: rawptr, head: rawptr, name: string) -> rawptr {
    if (map == null || head == null) { return null; }
    let slot = sema_memo_slot(map, sema_memo_hash(head, name));
    if (ast_read_i64(ptr_offset(slot, 40)) == 0) { return null; }
    if (ast_read_rawptr(slot) != head) { return null; }
    let key = ast_read_rawptr(ptr_offset(slot, 8));
    let len = ast_read_i64(ptr_offset(slot, 16));
    if (len != name.len) { return null; }
    if (len > 0) {
        if (key == null || memcmp(key, name.c_str(), len as u64) != 0) { return null; }
    }
    return slot;
}

fn sema_memo_slot_value(slot: rawptr) -> rawptr {
    if (slot == null) { return null; }
    return ast_read_rawptr(ptr_offset(slot, 24));
}

fn sema_memo_slot_i64(slot: rawptr) -> i64 {
    if (slot == null) { return 0; }
    return ast_read_i64(ptr_offset(slot, 32));
}

fn sema_memo_slot_text(slot: rawptr) -> string {
    if (slot == null) { return ""; }
    let ptr = ast_read_rawptr(ptr_offset(slot, 24));
    var len = ast_read_i64(ptr_offset(slot, 32));
    if (len < 0) { len = 0 - len; }
    if (ptr == null || len <= 0) { return ""; }
    return from_cstr_view_len(ptr, len);
}

fn sema_memo_put_raw(map: rawptr, head: rawptr, name: string, value: rawptr, aux: i64) {
    if (map == null || head == null) { return; }
    let slot = sema_memo_slot(map, sema_memo_hash(head, name));
    let old_key = ast_read_rawptr(ptr_offset(slot, 8));
    if (old_key != null) { vyx_frontend_free(old_key); }
    let old_val = ast_read_rawptr(ptr_offset(slot, 24));
    let old_aux = ast_read_i64(ptr_offset(slot, 32));
    if (old_val != null && old_aux < 0) { vyx_frontend_free(old_val); }
    ast_write_rawptr(slot, head);
    if (name.len > 0) {
        ast_write_rawptr(ptr_offset(slot, 8), ast_dup_c_string(name));
    } else {
        ast_write_rawptr(ptr_offset(slot, 8), null);
    }
    ast_write_i64(ptr_offset(slot, 16), name.len);
    ast_write_rawptr(ptr_offset(slot, 24), value);
    ast_write_i64(ptr_offset(slot, 32), aux);
    ast_write_i64(ptr_offset(slot, 40), 1);
}

fn sema_memo_put(map: rawptr, head: rawptr, name: string, value: rawptr) {
    sema_memo_put_raw(map, head, name, value, 0);
}

fn sema_memo_put_i64(map: rawptr, head: rawptr, name: string, value: i64) {
    sema_memo_put_raw(map, head, name, null, value);
}

fn sema_memo_put_text(map: rawptr, head: rawptr, name: string, text: string) {
    var value: rawptr = null;
    var aux: i64 = 0;
    if (text.len > 0) {
        value = ast_dup_c_string(text);
        aux = 0 - (text.len as i64);
    }
    sema_memo_put_raw(map, head, name, value, aux);
}

fn sema_memo_reset_map(map: rawptr) {
    if (map == null) { return; }
    var i: i32 = 0;
    while (i < SEMA_MEMO_CAP) {
        let slot = sema_memo_slot(map, i);
        let key = ast_read_rawptr(ptr_offset(slot, 8));
        if (key != null) { vyx_frontend_free(key); }
        let value = ast_read_rawptr(ptr_offset(slot, 24));
        let aux = ast_read_i64(ptr_offset(slot, 32));
        if (value != null && aux < 0) { vyx_frontend_free(value); }
        memset(slot, 0, SEMA_MEMO_SLOT_SIZE as u64);
        i = i + 1;
    }
}

fn sema_resolve_memos_reset() {
    sema_memo_reset_map(g_overload_count_memo);
    sema_memo_reset_map(g_variant_owner_memo);
    sema_memo_reset_map(g_latest_class_memo);
    sema_memo_reset_map(g_use_alias_memo);
    sema_memo_reset_map(g_layout_score_memo);
}

fn sema_string_state_default_cap() -> i32 { return 8192; }

fn sema_string_state_hash(key: string, cap: i32) -> i32 {
    if (cap <= 0) { return 0; }
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < key.len) {
        h = ((h * 131) + (key.charAt(i) as i64) + 1) % (cap as i64);
        i = i + 1;
    }
    if (h < 0) { h = -h; }
    return h as i32;
}

fn sema_string_state_map_create(cap: i32) -> rawptr {
    var c = cap;
    if (c <= 0) { c = sema_string_state_default_cap(); }
    let map = vyx_frontend_alloc(24);
    if (map == null) { return null; }
    memset(map, 0, 24);
    let bytes = (c as i64) * 8;
    let buckets = vyx_frontend_alloc(bytes as u64);
    if (buckets == null) {
        vyx_frontend_free(map);
        return null;
    }
    memset(buckets, 0, bytes as u64);
    ast_write_rawptr(map, buckets);
    ast_write_i32(ptr_offset(map, 8), c);
    ast_write_i32(ptr_offset(map, 12), 0);
    ast_write_i32(ptr_offset(map, 16), 1);
    return map;
}

fn sema_string_state_map_epoch(map: rawptr) -> i32 {
    if (map == null) { return 0; }
    let epoch = ast_read_i32(ptr_offset(map, 16));
    if (epoch <= 0) { return 1; }
    return epoch;
}

fn sema_string_state_key_matches(node: rawptr, key: string) -> bool {
    if (node == null) { return false; }
    let kp = ast_read_rawptr(node);
    let kl = ast_read_i64(ptr_offset(node, 8));
    if (kp == null || kl != key.len) { return false; }
    if (kl == 0) { return key.len == 0; }
    return memcmp(kp, key.c_str(), kl as u64) == 0;
}

fn sema_string_state_map_get(map: rawptr, key: string) -> i32 {
    if (map == null || key.len == 0) { return 0; }
    let buckets = ast_read_rawptr(map);
    let cap = ast_read_i32(ptr_offset(map, 8));
    if (buckets == null || cap <= 0) { return 0; }
    let epoch = sema_string_state_map_epoch(map);
    let slot = sema_string_state_hash(key, cap);
    var cur = ast_read_rawptr(ptr_offset(buckets, (slot as i64) * 8));
    while (cur != null) {
        if (ast_read_i32(ptr_offset(cur, 20)) == epoch
            && sema_string_state_key_matches(cur, key)) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return 0;
}
fn sema_string_state_map_put(map: rawptr, key: string, value: i32) -> rawptr {
    if (key.len == 0 || value == 0) { return map; }
    var out = map;
    if (out == null) { out = sema_string_state_map_create(sema_string_state_default_cap()); }
    if (out == null) { return map; }
    let buckets = ast_read_rawptr(out);
    let cap = ast_read_i32(ptr_offset(out, 8));
    if (buckets == null || cap <= 0) { return out; }
    let epoch = sema_string_state_map_epoch(out);
    let slot = sema_string_state_hash(key, cap);
    let slot_ptr = ptr_offset(buckets, (slot as i64) * 8);
    var cur = ast_read_rawptr(slot_ptr);
    while (cur != null) {
        if (sema_string_state_key_matches(cur, key)) {
            ast_write_i32(ptr_offset(cur, 16), value);
            ast_write_i32(ptr_offset(cur, 20), epoch);
            return out;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = vyx_frontend_alloc(32);
    if (node == null) { return out; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_i32(ptr_offset(node, 20), epoch);
    ast_write_rawptr(ptr_offset(node, 24), ast_read_rawptr(slot_ptr));
    ast_write_rawptr(slot_ptr, node);
    ast_write_i32(ptr_offset(out, 12), ast_read_i32(ptr_offset(out, 12)) + 1);
    return out;
}

fn sema_string_state_map_clear(map: rawptr) -> rawptr {
    var out = map;
    if (out == null) { return sema_string_state_map_create(sema_string_state_default_cap()); }
    let epoch = ast_read_i32(ptr_offset(out, 16)) + 1;
    if (epoch > 0) {
        ast_write_i32(ptr_offset(out, 16), epoch);
        return out;
    }
    var cur_slot: i32 = 0;
    let buckets = ast_read_rawptr(out);
    let cap = ast_read_i32(ptr_offset(out, 8));
    if (buckets != null && cap > 0) {
        while (cur_slot < cap) {
            var cur = ast_read_rawptr(ptr_offset(buckets, (cur_slot as i64) * 8));
            while (cur != null) {
                let next = ast_read_rawptr(ptr_offset(cur, 24));
                let kp = ast_read_rawptr(cur);
                if (kp != null) { vyx_frontend_free(kp); }
                vyx_frontend_free(cur);
                cur = next;
            }
            ast_write_rawptr(ptr_offset(buckets, (cur_slot as i64) * 8), null);
            cur_slot = cur_slot + 1;
        }
    }
    ast_write_i32(ptr_offset(out, 12), 0);
    ast_write_i32(ptr_offset(out, 16), 1);
    return out;
}

fn sema_set_has(map: rawptr, key: string) -> bool {
    return sema_string_state_map_get(map, key) != 0;
}

fn sema_set_add(map: rawptr, key: string) -> rawptr {
    if (key.len == 0) { return map; }
    if (sema_set_has(map, key)) { return map; }
    return sema_string_state_map_put(map, key, 1);
}

fn sema_string_state_map_dispose(map: rawptr) {
    if (map == null) { return; }
    let buckets = ast_read_rawptr(map);
    let cap = ast_read_i32(ptr_offset(map, 8));
    if (buckets != null && cap > 0) {
        var i: i32 = 0;
        while (i < cap) {
            var cur = ast_read_rawptr(ptr_offset(buckets, (i as i64) * 8));
            while (cur != null) {
                let next = ast_read_rawptr(ptr_offset(cur, 24));
                let kp = ast_read_rawptr(cur);
                if (kp != null) { vyx_frontend_free(kp); }
                vyx_frontend_free(cur);
                cur = next;
            }
            i = i + 1;
        }
        vyx_frontend_free(buckets);
    }
    vyx_frontend_free(map);
}

fn sym_lookup(head: rawptr, name: string) -> rawptr {
    sym_lookup_cache_ensure();
    let cached = sym_lookup_cache_get(head, name);
    if (cached != null) {
        if (g_sym_miss != null && cached == g_sym_miss) { return null; }
        return cached;
    }
    var cur = head;
    while (cur != null) {
        let buf = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (buf != null && len == name.len) {
            if (len == 0 || memcmp(buf, name.c_str(), len as u64) == 0) {
                sym_lookup_cache_put(head, name, cur);
                return cur;
            }
        }
        cur = sym_get_next(cur);
    }
    let tok = sym_lookup_miss_token();
    if (tok != null) { sym_lookup_cache_put_any(head.clone(), name.clone(), tok); }
    return null;
}

fn sym_push_decl(head: rawptr, name: string, decl: rawptr) -> rawptr {
    let e = sym_alloc(name);
    sym_set_decl(e, decl);
    sym_set_next(e, head);
    return e;
}

fn sym_push_local(head: rawptr, name: string, ty: rawptr) -> rawptr {
    let e = sym_alloc(name);
    sym_set_ty(e, ty);
    sym_set_next(e, head);
    return e;
}

fn sym_push_local_ex(head: rawptr, name: string, ty: rawptr, is_const: bool) -> rawptr {
    let e = sym_alloc(name);
    sym_set_ty(e, ty);
    sym_set_is_const(e, is_const);
    sym_set_next(e, head);
    return e;
}

// ════════════════════════════════════════════════════════════════════
//   TypeRef helpers — thin wrappers around ast.tref_*
// ════════════════════════════════════════════════════════════════════

public fn tref_create_kind(kind: i32) -> rawptr {
    return tref_alloc(kind, "");
}

public fn tref_create_class(name: string) -> rawptr {
    return tref_alloc(ty_CLASS(), name);
}

fn sema_clone_type_ref(src: rawptr) -> rawptr {
    if (src == null) { return null; }
    let k = tref_get_kind(src);
    if (k == ty_ARRAY()) {
        return tref_alloc_array_expr(sema_clone_type_ref(tref_array_elem(src)),
                                     sema_clone_expr(tref_array_size_expr(src)));
    }
    if (k == ty_TUPLE()) {
        let n = tref_tuple_count(src);
        var buf: rawptr = null;
        if (n > 0) {
            buf = vyx_frontend_alloc((n * 8) as u64);
            var i: i64 = 0;
            while (i < n) {
                ast_write_rawptr(ptr_offset(buf, (i * 8) as i32),
                                 sema_clone_type_ref(tref_tuple_elem_at(src, i)));
                i = i + 1;
            }
        }
        return tref_alloc_tuple(buf, n);
    }
    if (k == ty_FN() || k == ty_CFN()) {
        let params_clone = sema_clone_type_ref(tref_fn_params(src));
        let ret_clone = sema_clone_type_ref(tref_fn_ret(src));
        if (k == ty_CFN()) { return tref_alloc_c_fn(params_clone, ret_clone); }
        return tref_alloc_fn(params_clone, ret_clone);
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return tref_alloc_ptr_like(k, sema_clone_type_ref(tref_pointee(src)));
    }
    return tref_alloc(k, tref_get_name(src));
}

fn sema_clone_decl_node(src: rawptr) -> rawptr {
    if (src == null) { return null; }
    let d = decl_alloc(decl_get_kind(src), decl_get_name(src));
    vyx_lsp_bind_copy(src, d);
    decl_set_is_public(d, decl_get_is_public(src));
    decl_set_is_static(d, decl_get_is_static(src));
    decl_set_ty(d, sema_clone_type_ref(decl_get_ty(src)));
    decl_set_params(d, sema_clone_decl_chain(decl_get_params(src)));
    decl_set_body(d, sema_clone_stmt_chain(decl_get_body(src)));
    decl_set_members(d, sema_clone_decl_chain(decl_get_members(src)));
    decl_set_generic_params(d, decl_get_generic_params(src));
    decl_set_meta(d, decl_get_meta(src));
    decl_set_doc(d, decl_get_doc(src));
    decl_set_loc(d,
                 decl_loc_line(src), decl_loc_col(src),
                 decl_loc_end_line(src), decl_loc_end_col(src));
    return d;
}

fn sema_clone_decl_chain(src: rawptr) -> rawptr {
    var head: rawptr = null;
    var tail: rawptr = null;
    var cur = src;
    while (cur != null) {
        let c = sema_clone_decl_node(cur);
        if (head == null) {
            head = c;
            tail = c;
        } else {
            decl_set_next(tail, c);
            tail = c;
        }
        cur = decl_get_next(cur);
    }
    return head;
}

fn sema_clone_stmt_node(src: rawptr) -> rawptr {
    if (src == null) { return null; }
    let s = stmt_alloc(stmt_get_kind(src));
    vyx_lsp_bind_copy(src, s);
    stmt_set_name(s, stmt_get_name(src));
    stmt_set_ty(s, sema_clone_type_ref(stmt_get_ty(src)));
    stmt_set_init(s, sema_clone_expr(stmt_get_init(src)));
    stmt_set_cond(s, sema_clone_expr(stmt_get_cond(src)));
    stmt_set_then_blk(s, sema_clone_stmt_chain(stmt_get_then_blk(src)));
    stmt_set_else_blk(s, sema_clone_stmt_chain(stmt_get_else_blk(src)));
    stmt_set_body(s, sema_clone_stmt_chain(stmt_get_body(src)));
    return s;
}

fn sema_clone_stmt_chain(src: rawptr) -> rawptr {
    var head: rawptr = null;
    var tail: rawptr = null;
    var cur = src;
    while (cur != null) {
        let c = sema_clone_stmt_node(cur);
        if (head == null) {
            head = c;
            tail = c;
        } else {
            stmt_set_next(tail, c);
            tail = c;
        }
        cur = stmt_get_next(cur);
    }
    return head;
}

fn sema_clone_expr(src: rawptr) -> rawptr {
    if (src == null) { return null; }
    let k = expr_get_kind(src);
    let e = expr_alloc(k);
    vyx_lsp_bind_copy(src, e);
    expr_set_op(e, expr_get_op(src));
    expr_set_int_val(e, expr_get_int_val(src));
    expr_set_str_val(e, expr_get_str_val(src));
    expr_set_name(e, expr_get_name(src));
    expr_set_ty(e, sema_clone_type_ref(expr_get_ty(src)));
    if (k == ex_CLOSURE()) {
        expr_set_lhs(e, sema_clone_stmt_chain(expr_get_lhs(src)));
        expr_set_rhs(e, sema_clone_type_ref(expr_get_rhs(src)));
        expr_set_args(e, sema_clone_decl_chain(expr_get_args(src)));
        expr_set_captures(e, sema_clone_stmt_chain(expr_get_captures(src)));
        return e;
    }
    if (k == ex_IF_EXPR()) {
        expr_set_lhs(e, sema_clone_expr(expr_get_lhs(src)));
        expr_set_rhs(e, sema_clone_stmt_chain(expr_get_rhs(src)));
        let else_part = expr_get_args(src);
        if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
            expr_set_args(e, sema_clone_expr(else_part));
        } else {
            expr_set_args(e, sema_clone_stmt_chain(else_part));
        }
        return e;
    }
    if (k == ex_NEW() || k == ex_DELETE()) {
        expr_set_lhs(e, sema_clone_expr(expr_get_lhs(src)));
        expr_set_rhs(e, sema_clone_expr(expr_get_rhs(src)));
        expr_set_args(e, sema_clone_stmt_chain(expr_get_args(src)));
        expr_set_captures(e, sema_clone_type_ref(expr_get_captures(src)));
        return e;
    }
    expr_set_lhs(e, sema_clone_expr(expr_get_lhs(src)));
    expr_set_rhs(e, sema_clone_expr(expr_get_rhs(src)));
    if (k == ex_TERNARY()) {
        expr_set_args(e, sema_clone_expr(expr_get_args(src)));
    } else {
        expr_set_args(e, sema_clone_stmt_chain(expr_get_args(src)));
    }
    if (k == ex_ARRAY_LIT()) {
        expr_set_captures(e, sema_clone_expr(expr_get_captures(src)));
    } else if (expr_get_captures(src) != null) {
        expr_set_captures(e, sema_clone_expr(expr_get_captures(src)));
    }
    return e;
}

// ════════════════════════════════════════════════════════════════════
//   TypeEnv — malloc-backed (name -> TypeRef*) substitution stack.
//
//   Mirrors host `GenericSubstitution` semantics from
//   `src/Sema/TemplateResolver.h`: a binding stack threaded through
//   clone_expr_env / clone_stmt_env / clone_type_ref_env so the
//   bootstrap monomorphisation path can substitute generic param
//   names without mutating the source AST.
//
//   Layout (32 B per node):
//     0..7   name_ptr : rawptr  (dup_c_string buffer; freed on dispose)
//     8..15  name_len : i64
//     16..23 type_ref : rawptr  (TypeRef*; owned by AST arena)
//     24..31 next     : rawptr  (next env node, or null at root)
//
//   The empty env is `null`. `sema_env_bind` prepends a fresh node and
//   returns the new head, so callers thread `env = sema_env_bind(env,
//   "T", ty)`. `sema_env_dispose` frees the chain in-order (name buffer
//   + node memory) without touching stored type_ref pointers (those
//   are owned by the AST arena and may outlive the env binding).
// ════════════════════════════════════════════════════════════════════

public fn sema_env_new() -> rawptr {
    return null;
}

public fn sema_env_bind(env: rawptr, name: string, ty: rawptr) -> rawptr {
    let node = vyx_frontend_alloc(32);
    if (node == null) { return env; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(name));
    ast_write_i64(ptr_offset(node, 8), name.len);
    ast_write_rawptr(ptr_offset(node, 16), ty);
    ast_write_rawptr(ptr_offset(node, 24), env);
    return node;
}

public fn sema_env_lookup(env: rawptr, name: string) -> rawptr {
    var cur = env;
    while (cur != null) {
        let buf = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (buf != null && len == name.len) {
            if (len == 0 || memcmp(buf, name.c_str(), len as u64) == 0) {
                return ast_read_rawptr(ptr_offset(cur, 16));
            }
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return null;
}

public fn sema_env_dispose(env: rawptr) {
    var cur = env;
    while (cur != null) {
        let nxt = ast_read_rawptr(ptr_offset(cur, 24));
        let buf = ast_read_rawptr(cur);
        if (buf != null) { vyx_frontend_free(buf); }
        vyx_frontend_free(cur);
        cur = nxt;
    }
}

// ────────────────────────────────────────────────────────────────────
//   Clone recursion-depth guard (MONO-006-CloneDepth).
//
//   Cap matches the task spec (256). The flag is per-process and
//   one-shot: subsequent overflows do not spam the diagnostic stream.
//   Diagnostics are reset between TUs by `diag_dispose()` /
//   `diag_reset_counts()`, so no separate clone-depth reset hook is
//   needed in this bootstrap mirror.
//   The depth cap is inlined at every call site as the literal `256`
//   instead of a module-level i64/i32 constant to avoid the host
//   vyxc codegen interning collision with `DIAG_FNV_*` constants in
//   `diag.vyx` (manifests as "verifyModule failed: Global variable
//   initializer type does not match global variable type" on
//   `g_diag_current_file` when duplicate-valued i64 module lets land).
// ────────────────────────────────────────────────────────────────────

// Depth-overflow flag for the env-aware clone path is intentionally
// NOT stored in a module-level `var` — the host vyxc codegen has an
// interning bug that flips `g_diag_current_file`'s (`var: string =
// "..."`) initializer type whenever sema gains an extra initialised
// module global. The flag is therefore re-derived on demand from
// `diag_error_count()` (`MONO-006-CloneDepth` is the only error code
// this helper emits, so a non-zero error count for that code means
// "already reported"). `diag_emit_at` dedups by `(code, file_hash,
// line, col, msg_hash, severity)` so repeat calls fold to a single
// rendered diagnostic regardless.

// ────────────────────────────────────────────────────────────────────
//   Module-level diagnostic anchor (WU1).
//
//   `g_sema_cur_loc` points at the 16 B SourceLoc tail of the AST
//   node the current Sema walk most recently entered. The walking
//   methods (`collect_decls`, `check_class_members`, `resolve_unit`,
//   `resolve_fn_with_owner_gp`, `resolve_stmt`, `resolve_expr`) stamp
//   it via the `sema_stamp_loc_from_*` free helpers at function
//   entry, so the instance method `report_error(self, msg)` — whose
//   35 callsites stay untouched per WU1 task item #4 — can hand
//   `g_sema_cur_loc` to `diag.emit_at` without taking a node
//   parameter.
//
//   The pointer references AST-node-owned memory; we never copy or
//   free it. `sema_clear_cur_loc()`, called from `analyze_unit`, is
//   the only writer that resets to `null` between TUs.
// ────────────────────────────────────────────────────────────────────

var g_sema_cur_loc: rawptr = null;

public fn sema_clear_cur_loc() {
    g_sema_cur_loc = null;
}

public fn sema_current_loc_ptr() -> rawptr {
    return g_sema_cur_loc;
}

public fn sema_stamp_loc_from_expr(e: rawptr) {
    if (e == null) { return; }
    let lp = expr_loc_ptr(e);
    if (lp == null) { return; }
    g_sema_cur_loc = lp;
}

public fn sema_stamp_loc_from_stmt(s: rawptr) {
    if (s == null) { return; }
    let lp = stmt_loc_ptr(s);
    if (lp == null) { return; }
    g_sema_cur_loc = lp;
}

public fn sema_stamp_loc_from_decl(d: rawptr) {
    if (d == null) { return; }
    let lp = decl_loc_ptr(d);
    if (lp == null) { return; }
    g_sema_cur_loc = lp;
}

fn sema_report_clone_depth_exceeded() {
    // Routed through diag so the host-aligned `MONO-006-CloneDepth`
    // code, file path, and severity counter all stay consistent with
    // every other Sema diagnostic. diag dedups by (code, file, line,
    // col, msg, severity) so repeat calls fold to a single rendered
    // diagnostic. The current ast-walk anchor (if any) gives users a
    // position to start triaging from; otherwise the renderer falls
    // back to "<file>:0:0".
    diag_emit_at(diag_sev_ERROR(),
                 diag_code_mono_clone_depth(),
                 g_sema_cur_loc,
                 "AST clone exceeded depth 256");
}

public fn sema_clone_depth_overflowed() -> bool {
    return diag_error_count() > 0;
}

// ────────────────────────────────────────────────────────────────────
//   Env-aware deep clone variants.
//
//   Mirror the existing structural `sema_clone_*` functions but accept
//   a TypeEnv plus a depth counter. On `ty_CLASS()` nodes whose name
//   is bound in the env, the bound TypeRef is deep-cloned in place of
//   the original, matching host `cloneTypeAnnotationWithSubst` (see
//   `src/Sema/SemaCloneHelpers.cpp`).
//
//   Pack / Dependent / Generic / Union TypeRef kinds do not exist as
//   first-class kinds in the bootstrap AST (those constructs ride on
//   `ty_CLASS()` + decl-side `generic_params` strings today), so the
//   substitution intentionally falls through `ty_CLASS()` for them
//   instead of synthesising AST kinds that the rest of the pipeline
//   does not yet understand.
// ────────────────────────────────────────────────────────────────────

// Class generic arguments are retained as a single textual TypeRef in the
// bootstrap AST.  Keep the environment substitution recursive so `T` and
// `Self.Assoc` close equally in `Vec::<...>`, nested calls, and signatures.
fn sema_clone_type_text_env(name: string, env: rawptr, depth: i32) -> string {
    if (name.len == 0 || env == null || depth >= 256) { return name; }
    let bound = sema_env_lookup(env, name);
    if (bound != null) {
        return type_text_from_ty(sema_clone_type_ref_env(bound, null, depth + 1));
    }
    let args = policy_generic_call_args(name.clone());
    if (args.len == 0) { return name; }
    let base = generic_call_base(name.clone());
    var out_args = "";
    var changed: bool = false;
    var index: i32 = 0;
    while (index < 64) {
        let part = generic_arg_at(args, index);
        if (part.len == 0) { break; }
        let part_ref = sema_type_name_to_ref(part);
        let cloned_part = sema_clone_type_ref_env(part_ref, env, depth + 1);
        let cloned_text = type_text_from_ty(cloned_part);
        if (cloned_text != part) { changed = true; }
        if (out_args.len > 0) { out_args = out_args + ","; }
        out_args = out_args + cloned_text;
        index = index + 1;
    }
    if (!changed) { return name; }
    return base + "::<" + out_args + ">";
}

public fn sema_clone_type_ref_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (src == null) { return null; }
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    let k = tref_get_kind(src);
    if (k == ty_CLASS()) {
        let name = tref_get_name(src);
        let cloned_name = sema_clone_type_text_env(name, env, depth + 1);
        if (cloned_name != name) { return sema_type_name_to_ref(cloned_name); }
        return tref_alloc(k, name);
        }
    if (k == ty_ARRAY()) {
        return tref_alloc_array_expr(sema_clone_type_ref_env(tref_array_elem(src), env, depth + 1),
                                     sema_clone_expr_env(tref_array_size_expr(src), env, depth + 1));
    }
    if (k == ty_TUPLE()) {
        let n = tref_tuple_count(src);
        var buf: rawptr = null;
        if (n > 0) {
            buf = vyx_frontend_alloc((n * 8) as u64);
            var i: i64 = 0;
            while (i < n) {
                ast_write_rawptr(ptr_offset(buf, (i * 8) as i32),
                                 sema_clone_type_ref_env(tref_tuple_elem_at(src, i), env, depth + 1));
                i = i + 1;
            }
        }
        return tref_alloc_tuple(buf, n);
    }
    if (k == ty_FN() || k == ty_CFN()) {
        let params_clone2 = sema_clone_type_ref_env(tref_fn_params(src), env, depth + 1);
        let ret_clone2 = sema_clone_type_ref_env(tref_fn_ret(src), env, depth + 1);
        if (k == ty_CFN()) { return tref_alloc_c_fn(params_clone2, ret_clone2); }
        return tref_alloc_fn(params_clone2, ret_clone2);
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return tref_alloc_ptr_like(k, sema_clone_type_ref_env(tref_pointee(src), env, depth + 1));
    }
    return tref_alloc(k, tref_get_name(src));
}

public fn sema_clone_expr_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (src == null) { return null; }
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    let k = expr_get_kind(src);
    let e = expr_alloc(k);
    vyx_lsp_bind_copy(src, e);
    expr_set_op(e, expr_get_op(src));
    expr_set_int_val(e, expr_get_int_val(src));
    expr_set_str_val(e, expr_get_str_val(src));
    let raw_name = expr_get_name(src);
    // Names of generic calls and type-qualified static members carry their
    // type arguments as text.  Rebind those arguments while cloning; bare
    // identifiers intentionally stay untouched because they may be locals
    // with the same spelling as a generic parameter.
    var cloned_name = raw_name;
    if (env != null && policy_generic_call_args(raw_name.clone()).len > 0) {
        cloned_name = sema_clone_type_text_env(raw_name, env, depth + 1);
    }
    expr_set_name(e, cloned_name);
    expr_set_ty(e, sema_clone_type_ref_env(expr_get_ty(src), env, depth + 1));
    if (k == ex_CLOSURE()) {
        expr_set_lhs(e, sema_clone_stmt_chain_env(expr_get_lhs(src), env, depth + 1));
        expr_set_rhs(e, sema_clone_type_ref_env(expr_get_rhs(src), env, depth + 1));
        expr_set_args(e, sema_clone_decl_chain_env(expr_get_args(src), env, depth + 1));
        expr_set_captures(e, sema_clone_stmt_chain_env(expr_get_captures(src), env, depth + 1));
        return e;
    }
    if (k == ex_IF_EXPR()) {
        expr_set_lhs(e, sema_clone_expr_env(expr_get_lhs(src), env, depth + 1));
        expr_set_rhs(e, sema_clone_stmt_chain_env(expr_get_rhs(src), env, depth + 1));
        let else_part = expr_get_args(src);
        if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
            expr_set_args(e, sema_clone_expr_env(else_part, env, depth + 1));
        } else {
            expr_set_args(e, sema_clone_stmt_chain_env(else_part, env, depth + 1));
        }
        return e;
    }
    if (k == ex_NEW() || k == ex_DELETE()) {
        expr_set_lhs(e, sema_clone_expr_env(expr_get_lhs(src), env, depth + 1));
        expr_set_rhs(e, sema_clone_expr_env(expr_get_rhs(src), env, depth + 1));
        expr_set_args(e, sema_clone_stmt_chain_env(expr_get_args(src), env, depth + 1));
        expr_set_captures(e, sema_clone_type_ref_env(expr_get_captures(src), env, depth + 1));
        return e;
    }
    expr_set_lhs(e, sema_clone_expr_env(expr_get_lhs(src), env, depth + 1));
    expr_set_rhs(e, sema_clone_expr_env(expr_get_rhs(src), env, depth + 1));
    if (k == ex_TERNARY()) {
        expr_set_args(e, sema_clone_expr_env(expr_get_args(src), env, depth + 1));
    } else {
        expr_set_args(e, sema_clone_stmt_chain_env(expr_get_args(src), env, depth + 1));
    }
    if (k == ex_ARRAY_LIT()) {
        expr_set_captures(e, sema_clone_expr_env(expr_get_captures(src), env, depth + 1));
    } else if (expr_get_captures(src) != null) {
        expr_set_captures(e, sema_clone_expr_env(expr_get_captures(src), env, depth + 1));
    }
    return e;
}

public fn sema_clone_stmt_node_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (src == null) { return null; }
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    let s = stmt_alloc(stmt_get_kind(src));
    vyx_lsp_bind_copy(src, s);
    stmt_set_name(s, stmt_get_name(src));
    stmt_set_ty(s, sema_clone_type_ref_env(stmt_get_ty(src), env, depth + 1));
    stmt_set_init(s, sema_clone_expr_env(stmt_get_init(src), env, depth + 1));
    stmt_set_cond(s, sema_clone_expr_env(stmt_get_cond(src), env, depth + 1));
    stmt_set_then_blk(s, sema_clone_stmt_chain_env(stmt_get_then_blk(src), env, depth + 1));
    stmt_set_else_blk(s, sema_clone_stmt_chain_env(stmt_get_else_blk(src), env, depth + 1));
    stmt_set_body(s, sema_clone_stmt_chain_env(stmt_get_body(src), env, depth + 1));
    return s;
}

public fn sema_clone_stmt_chain_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    var head: rawptr = null;
    var tail: rawptr = null;
    var cur = src;
    while (cur != null) {
        let c = sema_clone_stmt_node_env(cur, env, depth + 1);
        if (head == null) {
            head = c;
            tail = c;
        } else {
            stmt_set_next(tail, c);
            tail = c;
        }
        cur = stmt_get_next(cur);
    }
    return head;
}

public fn sema_clone_decl_node_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (src == null) { return null; }
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    let d = decl_alloc(decl_get_kind(src), decl_get_name(src));
    vyx_lsp_bind_copy(src, d);
    decl_set_is_public(d, decl_get_is_public(src));
    decl_set_is_static(d, decl_get_is_static(src));
    decl_set_ty(d, sema_clone_type_ref_env(decl_get_ty(src), env, depth + 1));
    decl_set_params(d, sema_clone_decl_chain_env(decl_get_params(src), env, depth + 1));
    decl_set_body(d, sema_clone_stmt_chain_env(decl_get_body(src), env, depth + 1));
    decl_set_members(d, sema_clone_decl_chain_env(decl_get_members(src), env, depth + 1));
    decl_set_generic_params(d, decl_get_generic_params(src));
    decl_set_meta(d, decl_get_meta(src));
    decl_set_doc(d, decl_get_doc(src));
    return d;
}

public fn sema_clone_decl_chain_env(src: rawptr, env: rawptr, depth: i32) -> rawptr {
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    var head: rawptr = null;
    var tail: rawptr = null;
    var cur = src;
    while (cur != null) {
        let c = sema_clone_decl_node_env(cur, env, depth + 1);
        if (head == null) {
            head = c;
            tail = c;
        } else {
            decl_set_next(tail, c);
            tail = c;
        }
        cur = decl_get_next(cur);
    }
    return head;
}

// ────────────────────────────────────────────────────────────────────
//   ast_hash — stable FNV-1a-style hash over an AST subtree.
//
//   Verification helper for clone idempotency: two structurally
//   identical Decl / Stmt / Expr / TypeRef trees produce the same
//   64-bit hash. Public sema-side API; not callable from samples
//   (the sample/compiler module split forbids that), but accessible
//   from other compiler-side regressions and future Mono drivers.
//
//   FNV-1a constants are inlined at every use site instead of being
//   exported as module-level i64 lets — see the depth-guard rationale
//   above for the host vyxc codegen collision this avoids.
// ────────────────────────────────────────────────────────────────────

fn ast_hash_string(h0: i64, s: string) -> i64 {
    var h = h0;
    var i: i32 = 0;
    while (i < s.len) {
        h = (h ^ (s.charAt(i) as i64)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

public fn ast_hash_type_ref(src: rawptr) -> i64 {
    if (src == null) { return 0; }
    var h: i64 = 1469598103934665603;
    let k = tref_get_kind(src);
    h = (h ^ (k as i64)) * 1099511628211;
    h = ast_hash_string(h, tref_get_name(src));
    if (k == ty_ARRAY()) {
        h = (h ^ ast_hash_type_ref(tref_array_elem(src))) * 1099511628211;
        h = (h ^ ast_hash_expr(tref_array_size_expr(src))) * 1099511628211;
    } else if (k == ty_TUPLE()) {
        let n = tref_tuple_count(src);
        var ti: i64 = 0;
        while (ti < n) {
            h = (h ^ ast_hash_type_ref(tref_tuple_elem_at(src, ti))) * 1099511628211;
            ti = ti + 1;
        }
    } else if (k == ty_FN() || k == ty_CFN()) {
        h = (h ^ ast_hash_type_ref(tref_fn_params(src))) * 1099511628211;
        h = (h ^ ast_hash_type_ref(tref_fn_ret(src))) * 1099511628211;
    } else if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        h = (h ^ ast_hash_type_ref(tref_pointee(src))) * 1099511628211;
    }
    return h;
}

public fn ast_hash_expr(src: rawptr) -> i64 {
    if (src == null) { return 0; }
    var h: i64 = 1469598103934665603;
    h = (h ^ (expr_get_kind(src) as i64)) * 1099511628211;
    h = (h ^ (expr_get_op(src) as i64)) * 1099511628211;
    h = (h ^ expr_get_int_val(src)) * 1099511628211;
    h = ast_hash_string(h, expr_get_name(src));
    h = ast_hash_string(h, expr_get_str_val(src));
    h = (h ^ ast_hash_type_ref(expr_get_ty(src))) * 1099511628211;
    h = (h ^ ast_hash_expr(expr_get_lhs(src))) * 1099511628211;
    h = (h ^ ast_hash_expr(expr_get_rhs(src))) * 1099511628211;
    return h;
}

public fn ast_hash_stmt(src: rawptr) -> i64 {
    var h: i64 = 1469598103934665603;
    var cur = src;
    while (cur != null) {
        h = (h ^ (stmt_get_kind(cur) as i64)) * 1099511628211;
        h = ast_hash_string(h, stmt_get_name(cur));
        h = (h ^ ast_hash_type_ref(stmt_get_ty(cur))) * 1099511628211;
        h = (h ^ ast_hash_expr(stmt_get_init(cur))) * 1099511628211;
        h = (h ^ ast_hash_expr(stmt_get_cond(cur))) * 1099511628211;
        h = (h ^ ast_hash_stmt(stmt_get_then_blk(cur))) * 1099511628211;
        h = (h ^ ast_hash_stmt(stmt_get_else_blk(cur))) * 1099511628211;
        h = (h ^ ast_hash_stmt(stmt_get_body(cur))) * 1099511628211;
        cur = stmt_get_next(cur);
    }
    return h;
}

public fn ast_hash_decl(src: rawptr) -> i64 {
    var h: i64 = 1469598103934665603;
    var cur = src;
    while (cur != null) {
        h = (h ^ (decl_get_kind(cur) as i64)) * 1099511628211;
        h = ast_hash_string(h, decl_get_name(cur));
        h = (h ^ ast_hash_type_ref(decl_get_ty(cur))) * 1099511628211;
        h = (h ^ ast_hash_decl(decl_get_params(cur))) * 1099511628211;
        h = (h ^ ast_hash_stmt(decl_get_body(cur))) * 1099511628211;
        h = (h ^ ast_hash_decl(decl_get_members(cur))) * 1099511628211;
        cur = decl_get_next(cur);
    }
    return h;
}

/// Detect a width-tagged integer suffix at the tail of an int-literal
/// lexeme (e.g. `42u8`, `100usize`, `7i64`). Returns the matching `ty_*`
/// constant or `0` when no recognised suffix is present.
fn infer_int_suffix(s: string) -> i32 {
    let n = s.len;
    if (n >= 5) {
        let suf5 = str_view_range(s, (n - 5) as i32, n as i32);
        if (suf5 == "isize") { return ty_ISIZE(); }
        if (suf5 == "usize") { return ty_USIZE(); }
    }
    if (n >= 3) {
        let suf3 = str_view_range(s, (n - 3) as i32, n as i32);
        if (suf3 == "u32") { return ty_U32(); }
        if (suf3 == "u64") { return ty_U64(); }
        if (suf3 == "u16") { return ty_U16(); }
        if (suf3 == "i16") { return ty_I16(); }
        if (suf3 == "i32") { return ty_I32(); }
        if (suf3 == "i64") { return ty_I64(); }
    }
    if (n >= 2) {
        let suf2 = str_view_range(s, (n - 2) as i32, n as i32);
        if (suf2 == "u8") { return ty_U8(); }
        if (suf2 == "i8") { return ty_I8(); }
    }
    return 0;
}

fn tref_label(p: rawptr) -> string {
    if (p == null) { return "<unknown>"; }
    let text = type_text_from_ty(p);
    if (text.len > 0) { return text; }
    return "<unknown>";
}

fn sema_param_is_c_varargs(p: rawptr) -> bool {
    if (p == null) { return false; }
    if (decl_get_name(p) == "__c_varargs") { return true; }
    return string_contains(decl_get_generic_params(p), "|c_varargs");
}

fn sema_param_ends_typed_arity(p: rawptr) -> bool {
    if (p == null) { return false; }
    if (sema_param_is_c_varargs(p)) { return true; }
    if (decl_get_name(p) == "args") { return true; }
    return string_contains(decl_get_generic_params(p), "|variadic");
}

fn sema_decl_has_named_attr(d: rawptr, attr: string) -> bool {
    if (d == null || attr.len == 0) { return false; }
    let meta = decl_get_meta(d);
    if (meta.len == 0) { return false; }
    return string_contains(meta, intern_cat3("@[", attr, "("))
        || string_contains(meta, intern_cat3("@[", attr, "]"))
        || string_contains(meta, intern_cat3("@", attr, "("))
        || string_contains(meta, intern_cat2(intern_cat2("@", attr), "|"))
        || string_contains(meta, intern_cat3("@", attr, ","));
}

fn sema_decl_is_c_abi_fn(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (decl_get_kind(d) == de_EXTERN_FN()) { return true; }
    let meta = decl_get_meta(d);
    if (string_contains(meta, "|extern_abi:C")) { return true; }
    if (string_contains(meta, "|marker:export")) { return true; }
    if (sema_decl_has_named_attr(d, "no_mangle")) { return true; }
    if (sema_decl_has_named_attr(d, "export")) { return true; }
    if (sema_decl_has_named_attr(d, "export_name")) { return true; }
    if (sema_decl_has_named_attr(d, "link_name")) { return true; }
    return false;
}

fn tref_fn_from_decl(d: rawptr) -> rawptr {
    if (d == null) { return tref_alloc_fn(tref_alloc_tuple(null, 0), tref_create_kind(ty_VOID())); }
    var count: i64 = 0;
    var p = decl_get_params(d);
    while (p != null) {
        if (!sema_param_is_c_varargs(p)) {
            count = count + 1;
        }
        p = decl_get_next(p);
    }
    var buf: rawptr = null;
    if (count > 0) {
        buf = vyx_frontend_alloc((count * 8) as u64);
        var i: i64 = 0;
        p = decl_get_params(d);
        while (p != null) {
            if (!sema_param_is_c_varargs(p)) {
                var pty = decl_get_ty(p);
                if (pty == null) { pty = tref_create_kind(ty_I32()); }
                ast_write_rawptr(ptr_offset(buf, (i * 8) as i32), pty);
                i = i + 1;
            }
            p = decl_get_next(p);
        }
    }
    var ret = decl_get_ty(d);
    if (ret == null) { ret = tref_create_kind(ty_VOID()); }
    if (sema_decl_is_c_abi_fn(d)) {
        return tref_alloc_c_fn(tref_alloc_tuple(buf, count), ret);
    }
    return tref_alloc_fn(tref_alloc_tuple(buf, count), ret);
}

/// Structural equality for first-class type shapes, nominal for classes.
///
/// PLAN_SEMA_ROOT_FIX WU2: nominal (`ty_CLASS`) equality routes through the
/// `bootstrap.canon` intern (`canon_type_eq_by_name`) so two spellings that
/// intern to the same id collapse without a per-call string compare. Falls
/// back to raw string equality when either name is empty (intern returns id
/// 0, reserved as "not interned"); this preserves existing behavior for
/// unnamed placeholder type refs the parser emits in error recovery paths.
fn type_eq(a: rawptr, b: rawptr) -> bool {
    if (a == null || b == null) { return false; }
    let ka = tref_get_kind(a);
    let kb = tref_get_kind(b);
    if (ka != kb) { return false; }
    if (ka == ty_CLASS()) {
        let na = tref_get_name(a);
        let nb = tref_get_name(b);
        return canon_type_eq_by_name(na, nb);
    }
    if (ka == ty_ARRAY()) {
        if (tref_array_size(a) != tref_array_size(b)) { return false; }
        return type_eq(tref_array_elem(a), tref_array_elem(b));
    }
    if (ka == ty_PTR() || ka == ty_REF() || ka == ty_MUTREF()) {
        return type_eq(tref_pointee(a), tref_pointee(b));
    }
    if (ka == ty_TUPLE()) {
        let ca = tref_tuple_count(a);
        if (ca != tref_tuple_count(b)) { return false; }
        var ti: i64 = 0;
        while (ti < ca) {
            if (!type_eq(tref_tuple_elem_at(a, ti), tref_tuple_elem_at(b, ti))) {
                return false;
            }
            ti = ti + 1;
        }
        return true;
    }
    if (ka == ty_FN() || ka == ty_CFN()) {
        if (!type_eq(tref_fn_ret(a), tref_fn_ret(b))) { return false; }
        return type_eq(tref_fn_params(a), tref_fn_params(b));
    }
    return true;
}

/// Parameter lists identical (arity + per-param types) — ODR / overload boundary.
fn decl_params_type_equal(a: rawptr, b: rawptr) -> bool {
    var pa = decl_get_params(a);
    var pb = decl_get_params(b);
    while (pa != null && pb != null) {
        let ta = decl_get_ty(pa);
        let tb = decl_get_ty(pb);
        if (!type_eq(ta, tb)) {
            return false;
        }
        pa = decl_get_next(pa);
        pb = decl_get_next(pb);
    }
    return pa == null && pb == null;
}

/// Existing func decl with same name + signature (host rejects true duplicates only).
fn sym_find_dup_fn_same_sig(head: rawptr, name: string, decl: rawptr) -> rawptr {
    var cur = head;
    while (cur != null) {
        if (sym_get_name(cur) == name) {
            let d = sym_get_decl(cur);
            if (d != null && decl_params_type_equal(d, decl)) {
                return cur;
            }
        }
        cur = sym_get_next(cur);
    }
    return null;
}

fn decl_marked_imported(d: rawptr) -> bool {
    return d != null && string_contains(decl_get_meta(d), "|imported");
}

/// Foreign `.vyi` / std / other-crate decls. Same-crate `--project-unit-sources`
/// siblings are tagged `|imported|project-local` so ODR still sees a merge, but
/// their bodies are part of this crate and must be type-checked.
fn decl_is_foreign_import(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    if (string_contains(meta, "|project-local")) { return false; }
    return string_contains(meta, "|imported");
}

fn decl_from_std_module(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    return string_contains(meta, "|from:std.") || string_contains(meta, "|from:std|");
}

fn sym_any_overloaded_name(head: rawptr, name: string) -> bool {
    var cur = head;
    var count: i32 = 0;
    while (cur != null) {
        if (sym_get_name(cur) == name && sym_get_decl(cur) != null) {
            count = count + 1;
            if (count > 1) { return true; }
        }
        cur = sym_get_next(cur);
    }
    return false;
}

/// Param vs argument: allow i32/i64 interchange like host numeric widening in calls.
fn type_eq_call_arg(param_ty: rawptr, arg_ty: rawptr) -> bool {
    if (type_eq(param_ty, arg_ty)) {
        return true;
    }
    let pk = tref_get_kind(param_ty);
    let ak = tref_get_kind(arg_ty);
    if (pk == ty_RAWPTR() || ak == ty_RAWPTR()) {
        return true;
    }
    if (type_kind_is_int(pk) && type_kind_is_int(ak)) {
        return true;
    }
    return false;
}

fn type_kind_is_signed_int(k: i32) -> bool {
    if (k == ty_I8()) { return true; }
    if (k == ty_I16()) { return true; }
    if (k == ty_I32()) { return true; }
    if (k == ty_I64()) { return true; }
    if (k == ty_ISIZE()) { return true; }
    return false;
}

fn type_kind_is_unsigned_int(k: i32) -> bool {
    if (k == ty_U8()) { return true; }
    if (k == ty_U16()) { return true; }
    if (k == ty_U32()) { return true; }
    if (k == ty_U64()) { return true; }
    if (k == ty_USIZE()) { return true; }
    return false;
}

fn type_kind_is_float(k: i32) -> bool {
    if (k == ty_F32()) { return true; }
    if (k == ty_F64()) { return true; }
    return false;
}

fn type_ref_is_floatish(t: rawptr) -> bool {
    if (t == null) { return false; }
    let k = tref_get_kind(t);
    if (type_kind_is_float(k)) { return true; }
    if (k == ty_CLASS()) {
        let n = tref_get_name(t);
        if (n == "f32" || n == "f64") { return true; }
    }
    return false;
}

fn type_ref_float_bits(t: rawptr) -> i32 {
    if (t == null) { return 0; }
    let k = tref_get_kind(t);
    if (k == ty_F32()) { return 32; }
    if (k == ty_F64()) { return 64; }
    if (k == ty_CLASS()) {
        let n = tref_get_name(t);
        if (n == "f32") { return 32; }
        if (n == "f64") { return 64; }
    }
    return 0;
}

fn type_ref_implicitly_convertible(from_ty: rawptr, to_ty: rawptr) -> bool {
    if (from_ty == null || to_ty == null) { return false; }
    let fk = tref_get_kind(from_ty);
    let tk = tref_get_kind(to_ty);
    if ((type_kind_is_signed_int(fk) && type_kind_is_signed_int(tk))
        || (type_kind_is_unsigned_int(fk) && type_kind_is_unsigned_int(tk))) {
        return true;
    }
    if (type_ref_is_floatish(from_ty) && type_ref_is_floatish(to_ty)) {
        let fb = type_ref_float_bits(from_ty);
        let tb = type_ref_float_bits(to_ty);
        if (fb > 0 && tb > 0 && fb <= tb) { return true; }
    }
    if (type_kind_is_int(fk) && type_ref_is_floatish(to_ty)) {
        return true;
    }
    return false;
}

fn sema_type_name_base_is_qualified(name: string) -> bool {
    let base = generic_call_base(name.clone());
    var i: i32 = 0;
    while (i < base.len) {
        if (base.charAt(i) == 46) { return true; }
        i = i + 1;
    }
    return false;
}

fn sema_type_name_text_compatible(a: string, b: string) -> bool {
    if (a.len == 0 || b.len == 0) { return false; }
    if (a == b) { return true; }
    let abase = generic_call_base(a.clone());
    let bbase = generic_call_base(b.clone());
    if (abase == bbase) {
        let aa0 = policy_generic_call_args(a.clone());
        let ba0 = policy_generic_call_args(b.clone());
        if (aa0.len == 0 && ba0.len == 0) { return true; }
    } else {
        if (sema_type_name_base_is_qualified(a)
            && sema_type_name_base_is_qualified(b)) {
            return false;
        }
        if (module_last_segment(abase.clone()) != module_last_segment(bbase.clone())) {
            return false;
        }
    }

    let aa = policy_generic_call_args(a.clone());
    let ba = policy_generic_call_args(b.clone());
    if (aa.len == 0 && ba.len == 0) { return true; }
    if (aa.len == 0 || ba.len == 0) { return false; }
    var idx: i32 = 0;
    while (idx < 64) {
        let ap = generic_arg_at(aa, idx);
        let bp = generic_arg_at(ba, idx);
        if (ap.len == 0 && bp.len == 0) { return true; }
        if (ap.len == 0 || bp.len == 0) { return false; }
        if (!sema_type_name_text_compatible(ap, bp)) { return false; }
        idx = idx + 1;
    }
    return false;
}

fn type_compatible(expected: rawptr, actual: rawptr) -> bool {
    // WP-ESC concession (fixpoint): a missing TypeRef is treated as
    // "not yet inferred" and stays compatible. Fail-closed here breaks
    // self-host inference sites that still pass null. Probe documents it.
    if (expected == null || actual == null) {
        return true;
    }
    if (type_eq_call_arg(expected, actual)) {
        return true;
    }
    let ek = tref_get_kind(expected);
    let ak = tref_get_kind(actual);
    if (ek == ty_RANGE() && ak == ty_CLASS()) {
        return module_last_segment(generic_call_base(tref_get_name(actual))) == "Range";
    }
    if (ak == ty_RANGE() && ek == ty_CLASS()) {
        return module_last_segment(generic_call_base(tref_get_name(expected))) == "Range";
    }
    // WP-ESC concession (fixpoint): either side rawptr is still universal.
    // Tightening to rawptr/ptr-only breaks FFI and self-host pointer casts.
    if (ek == ty_RAWPTR() || ak == ty_RAWPTR()) {
        return true;
    }
    if (ek == ty_ARRAY() || ak == ty_ARRAY()) {
        if (ek == ty_ARRAY() && ak == ty_ARRAY()) {
            return type_eq(expected, actual);
        }
        // A fixed array may decay only to a pointer whose pointee is exactly
        // one array element.  It is never assignment-compatible with an
        // arbitrary scalar/pointer merely because one side is an array.
        if (ek == ty_PTR() && ak == ty_ARRAY()) {
            let expected_elem = tref_pointee(expected);
            let actual_elem = tref_array_elem(actual);
            return expected_elem != null
                && actual_elem != null
                && type_eq_call_arg(expected_elem, actual_elem);
        }
        return false;
    }
    if (ek == ty_REF() || ek == ty_MUTREF()) {
        return true;
    }
    if (ak == ty_REF() || ak == ty_MUTREF()) {
        return true;
    }
    if (type_ref_is_floatish(expected) && type_ref_is_floatish(actual)) {
        return true;
    }
    if (type_ref_is_floatish(expected) && type_kind_is_int(ak)) {
        return true;
    }
    if (ek == ty_CLASS()) {
        let en = tref_get_name(expected);
        if (sema_pack_index_base(en.clone()).len > 0) {
            return true;
        }
        if (en == "Self" || en == "Item") {
            return true;
        }
    }
    if (ak == ty_CLASS()) {
        let an = tref_get_name(actual);
        if (sema_pack_index_base(an.clone()).len > 0) {
            return true;
        }
        if (an == "Self" || an == "Item") {
            return true;
        }
    }
    if (ek == ty_CLASS() && ak == ty_CLASS()) {
        let en2 = tref_get_name(expected);
        let an2 = tref_get_name(actual);
        if (sema_type_name_text_compatible(en2, an2)) { return true; }
        return false;
    }
    if (ek == ty_CLASS() || ak == ty_CLASS()) {
        return false;
    }
    // `new [T; n]()` yields `*[T; n]` — a pointer to the allocated array.
    // Allow it to decay to an element pointer `*T` exactly when the pointee
    // element matches, mirroring the array-value decay above; the underlying
    // value is already the base address of the buffer. Both sides are
    // pointers here, so this cannot live inside the ARRAY-kind block above.
    if (ek == ty_PTR() && ak == ty_PTR()) {
        let expected_pe = tref_pointee(expected);
        let actual_pa = tref_pointee(actual);
        if (expected_pe != null
            && actual_pa != null
            && tref_get_kind(actual_pa) == ty_ARRAY()
            && tref_get_kind(expected_pe) != ty_ARRAY()) {
            let actual_ae = tref_array_elem(actual_pa);
            return actual_ae != null && type_eq_call_arg(expected_pe, actual_ae);
        }
    }
    return false;
}

fn type_kind_is_int(k: i32) -> bool {
    if (k == ty_CHAR()) { return true; }
    if (k == ty_I8()) { return true; }
    if (k == ty_I16()) { return true; }
    if (k == ty_I32()) { return true; }
    if (k == ty_I64()) { return true; }
    if (k == ty_U8()) { return true; }
    if (k == ty_U16()) { return true; }
    if (k == ty_U32()) { return true; }
    if (k == ty_U64()) { return true; }
    if (k == ty_ISIZE()) { return true; }
    if (k == ty_USIZE()) { return true; }
    return false;
}

fn type_kind_int_bits(k: i32) -> i32 {
    if (k == ty_BOOL()) { return 8; }
    if (k == ty_CHAR()) { return 32; }
    if (k == ty_I8() || k == ty_U8()) { return 8; }
    if (k == ty_I16() || k == ty_U16()) { return 16; }
    if (k == ty_I32() || k == ty_U32()) { return 32; }
    if (k == ty_I64() || k == ty_U64()) { return 64; }
    if (k == ty_ISIZE() || k == ty_USIZE()) { return 64; }
    return 0;
}

fn type_ref_int_bits(p: rawptr) -> i32 {
    if (p == null) { return 0; }
    let k = tref_get_kind(p);
    let direct = type_kind_int_bits(k);
    if (direct > 0) { return direct; }
    if (k == ty_CLASS()) {
        let name = generic_call_base(tref_get_name(p));
        let prim = policy_primitive_type_kind(name);
        if (prim == 11) { return 8; }
        if (prim == 12) { return 32; }
        if (prim == 1 || prim == 2 || prim == 3
            || prim == 5 || prim == 6 || prim == 7) {
            return 32;
        }
        if (prim == 4 || prim == 8 || prim == 9 || prim == 10) {
            return 64;
        }
    }
    return 0;
}

fn sema_int_literal_fits_type_kind(v: i64, k: i32) -> bool {
    if (k == ty_CHAR()) {
        return v >= 0 && v <= 1114111 && !(v >= 55296 && v <= 57343);
    }
    if (k == ty_I8()) { return v >= -128 && v <= 127; }
    if (k == ty_I16()) { return v >= -32768 && v <= 32767; }
    if (k == ty_I32()) { return v >= -2147483648 && v <= 2147483647; }
    if (k == ty_I64()) { return true; }
    if (k == ty_ISIZE()) { return true; }
    if (k == ty_U8()) { return v >= 0 && v <= 255; }
    if (k == ty_U16()) { return v >= 0 && v <= 65535; }
    if (k == ty_U32()) { return v >= 0 && v <= 4294967295; }
    if (k == ty_U64()) { return v >= 0; }
    if (k == ty_USIZE()) { return v >= 0; }
    return false;
}

fn sema_integer_literal_score_for_param(pt: rawptr, literal_value: i64) -> i32 {
    if (pt == null) { return -1; }
    let pk = tref_get_kind(pt);
    if (!type_kind_is_int(pk)) { return -1; }
    if (!sema_int_literal_fits_type_kind(literal_value, pk)) { return -1; }

    // Unsuffixed integer literals default to i32.  Keep smaller/wider integer
    // overloads viable, but make the default deterministic instead of tying
    // every integer parameter with the same score.
    if (pk == ty_I32()) { return 8; }
    if (pk == ty_I64() || pk == ty_ISIZE()) {
        if (literal_value < -2147483648 || literal_value > 2147483647) {
            return 8;
        }
        return 7;
    }
    if (pk == ty_U32()) {
        if (literal_value > 2147483647) { return 7; }
        return 6;
    }
    if (pk == ty_U64() || pk == ty_USIZE()) {
        if (literal_value > 4294967295) { return 7; }
        return 5;
    }
    return 4;
}

fn sema_numeric_literal_score_for_param(pt: rawptr, arg_e: rawptr) -> i32 {
    if (pt == null || arg_e == null || expr_get_kind(arg_e) != ex_INT_LIT()) { return -1; }
    let lit = expr_get_str_val(arg_e);
    if (string_contains(lit, ".")) {
        if (!type_ref_is_floatish(pt)) { return -1; }
        if (type_ref_float_bits(pt) == 64) { return 8; }
        if (type_ref_float_bits(pt) == 32) { return 7; }
        return 6;
    }
    let suf = infer_int_suffix(lit);
    if (suf != 0) {
        var pk = tref_get_kind(pt);
        if (pk == ty_CLASS()) {
            pk = policy_primitive_type_kind(tref_get_name(pt));
        }
        if (pk == suf) { return 16; }
        return -1;
    }
    let int_score = sema_integer_literal_score_for_param(pt, expr_get_int_val(arg_e));
    if (int_score >= 0) { return int_score; }
    if (type_ref_is_floatish(pt)) { return 1; }
    return -1;
}

fn sema_binop_operator_method_name(op: i32) -> string {
    if (op == tk_PLUS()) { return "operator+"; }
    if (op == tk_MINUS()) { return "operator-"; }
    if (op == tk_STAR()) { return "operator*"; }
    if (op == tk_SLASH()) { return "operator/"; }
    if (op == tk_PERCENT()) { return "operator%"; }
    if (op == tk_EQEQ()) { return "operator=="; }
    if (op == tk_NEQ()) { return "operator!="; }
    if (op == tk_LT()) { return "operator<"; }
    if (op == tk_GT()) { return "operator>"; }
    if (op == tk_LE()) { return "operator<="; }
    if (op == tk_GE()) { return "operator>="; }
    if (op == tk_AMP()) { return "operator&"; }
    if (op == tk_PIPE()) { return "operator|"; }
    if (op == tk_CARET()) { return "operator^"; }
    if (op == tk_LSHIFT()) { return "operator<<"; }
    if (op == tk_RSHIFT()) { return "operator>>"; }
    return "";
}

fn sema_method_name_matches_lookup(candidate: string, requested: string) -> bool {
    if (candidate == requested) { return true; }
    let legacy = policy_operator_legacy_method_name(requested);
    if (legacy.len > 0 && candidate == legacy) { return true; }
    let symbol = policy_operator_symbol_method_name(requested);
    if (symbol.len > 0 && candidate == symbol) { return true; }
    return false;
}

fn type_is_boolish(p: rawptr) -> bool {
    if (p == null) { return false; }
    let k = tref_get_kind(p);
    if (k == ty_BOOL()) { return true; }
    if (type_ref_int_bits(p) > 0) { return true; }
    if (k == ty_RAWPTR() || k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) { return true; }
    if (k == ty_VOID()) { return true; }
    if (k == ty_CLASS()) { return true; }
    return false;
}

fn sema_const_i64_known(e: rawptr) -> bool {
    if (e == null) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT() || k == ex_BOOL_LIT() || k == ex_CHAR_LIT()) { return true; }
    if (k == ex_UNARY()) { return sema_const_i64_known(expr_get_lhs(e)); }
    if (k == ex_BIN()) {
        return sema_const_i64_known(expr_get_lhs(e)) && sema_const_i64_known(expr_get_rhs(e));
    }
    if (k == ex_TERNARY()) {
        if (!sema_const_i64_known(expr_get_lhs(e))) { return false; }
        if (sema_const_i64_value(expr_get_lhs(e)) != 0) {
            return sema_const_i64_known(expr_get_rhs(e));
        }
        return sema_const_i64_known(expr_get_args(e));
    }
    if (k == ex_COMPTIME()) { return sema_const_i64_known(expr_get_lhs(e)); }
    return false;
}

fn sema_const_i64_value(e: rawptr) -> i64 {
    if (e == null) { return 0; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT() || k == ex_BOOL_LIT() || k == ex_CHAR_LIT()) {
        return expr_get_int_val(e);
    }
    if (k == ex_COMPTIME()) {
        return sema_const_i64_value(expr_get_lhs(e));
    }
    if (k == ex_TERNARY()) {
        if (sema_const_i64_value(expr_get_lhs(e)) != 0) {
            return sema_const_i64_value(expr_get_rhs(e));
        }
        return sema_const_i64_value(expr_get_args(e));
    }
    if (k == ex_UNARY()) {
        let op = expr_get_op(e);
        let v = sema_const_i64_value(expr_get_lhs(e));
        if (op == tk_NOT()) { if (v == 0) { return 1; } return 0; }
        if (op == tk_MINUS()) { return 0 - v; }
        if (op == tk_TILDE()) { return (0 - v) - 1; }
        return v;
    }
    if (k == ex_BIN()) {
        let op = expr_get_op(e);
        let l = sema_const_i64_value(expr_get_lhs(e));
        let r = sema_const_i64_value(expr_get_rhs(e));
        if (op == tk_PLUS()) { return l + r; }
        if (op == tk_MINUS()) { return l - r; }
        if (op == tk_STAR()) { return l * r; }
        if (op == tk_SLASH()) { if (r == 0) { return 0; } return l / r; }
        if (op == tk_PERCENT()) { if (r == 0) { return 0; } return l % r; }
        if (op == tk_EQEQ()) { if (l == r) { return 1; } return 0; }
        if (op == tk_NEQ()) { if (l != r) { return 1; } return 0; }
        if (op == tk_LT()) { if (l < r) { return 1; } return 0; }
        if (op == tk_LE()) { if (l <= r) { return 1; } return 0; }
        if (op == tk_GT()) { if (l > r) { return 1; } return 0; }
        if (op == tk_GE()) { if (l >= r) { return 1; } return 0; }
        if (op == tk_AND()) { if (l != 0 && r != 0) { return 1; } return 0; }
        if (op == tk_OR()) { if (l != 0 || r != 0) { return 1; } return 0; }
        if (op == tk_AMP()) { return l & r; }
        if (op == tk_PIPE()) { return l | r; }
        if (op == tk_CARET()) { return l ^ r; }
        if (op == tk_LSHIFT()) { return l << (r as i32); }
        if (op == tk_RSHIFT()) { return l >> (r as i32); }
    }
    return 0;
}

fn sema_decl_is_comptime_callable(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    if ((string_contains(meta, "|attrs:comptime") || string_contains(meta, "@[comptime"))
        && !string_contains(meta, "|effect:comptime|")) { return false; }
    if (string_contains(meta, "|marker:comptime")) { return true; }
    if (string_contains(meta, "|attrs:comptime")) { return true; }
    if (string_contains(meta, "@[comptime")) { return true; }
    return false;
}

fn sema_ct_env_has(env: string, name: string) -> bool {
    if (env.len == 0 || name.len == 0) { return false; }
    let prefix = intern_cat2(name, "=");
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= env.len) {
        if (i == env.len || env.charAt(i) == 10) {
            let line = str_view_range(env, start, i);
            if (string_starts_with(line, prefix)) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn sema_ct_env_get(env: string, name: string) -> i64 {
    if (env.len == 0 || name.len == 0) { return 0; }
    let prefix = intern_cat2(name, "=");
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= env.len) {
        if (i == env.len || env.charAt(i) == 10) {
            let line = str_view_range(env, start, i);
            if (string_starts_with(line, prefix)) {
                let num = str_view_range(line, prefix.len, line.len);
                var sign: i64 = 1;
                var pi: i32 = 0;
                var outv: i64 = 0;
                if (num.len > 0 && num.charAt(0) == 45) {
                    sign = -1;
                    pi = 1;
                }
                while (pi < num.len) {
                    let c = num.charAt(pi);
                    if (c < 48 || c > 57) { break; }
                    outv = outv * 10 + ((c - 48) as i64);
                    pi = pi + 1;
                }
                return outv * sign;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn sema_ct_env_set(env: string, name: string, v: i64) -> string {
    let prefix = intern_cat2(name, "=");
    let next = prefix + policy_i64_to_string(v);
    if (env.len == 0) { return next; }
    var out: string = "";
    var replaced: bool = false;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= env.len) {
        if (i == env.len || env.charAt(i) == 10) {
            let line = str_view_range(env, start, i);
            if (line.len > 0) {
                if (string_starts_with(line, prefix)) {
                    if (out.len > 0) { out = out + "\n"; }
                    out = out + next;
                    replaced = true;
                } else {
                    if (out.len > 0) { out = out + "\n"; }
                    out = out + line;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (!replaced) {
        if (out.len > 0) { out = out + "\n"; }
        out = out + next;
    }
    return out;
}

fn sema_expr_rewrite_int(e: rawptr, v: i64) {
    if (e == null) { return; }
    expr_set_kind(e, ex_INT_LIT());
    expr_set_int_val(e, v);
    expr_set_str_val(e, policy_i64_to_string(v));
    expr_set_lhs(e, null);
    expr_set_rhs(e, null);
    expr_set_args(e, null);
    expr_set_name(e, "");
    expr_set_semantic(e, expr_sem_NONE(), null, null, 0);
}

fn sema_ct_env_clear(env: string, name: string) -> string {
    let prefix = intern_cat2(name, "=");
    if (env.len == 0) { return ""; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= env.len) {
        if (i == env.len || env.charAt(i) == 10) {
            let line = str_view_range(env, start, i);
            if (line.len > 0 && !string_starts_with(line, prefix)) {
                if (out.len > 0) { out = out + "\n"; }
                out = out + line;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn sema_ct_call_name(e: rawptr) -> string {
    if (e == null) { return ""; }
    let lhs = expr_get_lhs(e);
    if (lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
        return expr_get_name(lhs);
    }
    return expr_get_name(e);
}

fn sema_ct_is_io_builtin(name: string) -> bool {
    return name == "print" || name == "println" || name == "ct_file_size";
}

fn sema_ct_loop_budget() -> i32 { return 1000000; }

var g_sema_ct_io_silent: i32 = 0;

fn sema_ct_bin_value(op: i32, l: i64, r: i64) -> i64 {
    if (op == tk_PLUS()) { return l + r; }
    if (op == tk_MINUS()) { return l - r; }
    if (op == tk_STAR()) { return l * r; }
    if (op == tk_SLASH()) { if (r == 0) { return 0; } return l / r; }
    if (op == tk_PERCENT()) { if (r == 0) { return 0; } return l % r; }
    if (op == tk_EQEQ()) { if (l == r) { return 1; } return 0; }
    if (op == tk_NEQ()) { if (l != r) { return 1; } return 0; }
    if (op == tk_LT()) { if (l < r) { return 1; } return 0; }
    if (op == tk_LE()) { if (l <= r) { return 1; } return 0; }
    if (op == tk_GT()) { if (l > r) { return 1; } return 0; }
    if (op == tk_GE()) { if (l >= r) { return 1; } return 0; }
    if (op == tk_AND()) { if (l != 0 && r != 0) { return 1; } return 0; }
    if (op == tk_OR()) { if (l != 0 || r != 0) { return 1; } return 0; }
    if (op == tk_AMP()) { return l & r; }
    if (op == tk_PIPE()) { return l | r; }
    if (op == tk_CARET()) { return l ^ r; }
    if (op == tk_LSHIFT()) { return l << (r as i32); }
    if (op == tk_RSHIFT()) { return l >> (r as i32); }
    return 0;
}

fn sema_ct_apply_assign(op: i32, oldv: i64, rhs: i64) -> i64 {
    if (op == tk_EQ() || op == 0) { return rhs; }
    if (op == tk_PLUSEQ()) { return oldv + rhs; }
    if (op == tk_MINUSEQ()) { return oldv - rhs; }
    if (op == tk_STAREQ()) { return oldv * rhs; }
    if (op == tk_SLASHEQ()) { if (rhs == 0) { return 0; } return oldv / rhs; }
    if (op == tk_PERCENTEQ()) { if (rhs == 0) { return 0; } return oldv % rhs; }
    if (op == tk_LSHIFTEQ()) { return oldv << (rhs as i32); }
    if (op == tk_RSHIFTEQ()) { return oldv >> (rhs as i32); }
    if (op == tk_AMPEQ()) { return oldv & rhs; }
    if (op == tk_PIPEEQ()) { return oldv | rhs; }
    if (op == tk_CARETEQ()) { return oldv ^ rhs; }
    return rhs;
}

fn sema_ct_print_arg(ae: rawptr, env: string, depth: i32) {
    if (ae == null) { return; }
    if (expr_get_kind(ae) == ex_STR_LIT()) {
        print(expr_get_str_val(ae));
        return;
    }
    print(policy_i64_to_string(sema_ct_eval_value(ae, env, depth)));
}

fn sema_ct_eval_known(e: rawptr, env: string, depth: i32) -> bool {
    if (e == null || depth > 32) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT() || k == ex_BOOL_LIT() || k == ex_CHAR_LIT()) { return true; }
    if (k == ex_STR_LIT()) { return true; }
    if (k == ex_COMPTIME() || k == ex_CAST()) {
        return sema_ct_eval_known(expr_get_lhs(e), env, depth + 1);
    }
    if (k == ex_IDENT()) { return sema_ct_env_has(env, expr_get_name(e)); }
    if (k == ex_UNARY()) { return sema_ct_eval_known(expr_get_lhs(e), env, depth + 1); }
    if (k == ex_BIN()) {
        return sema_ct_eval_known(expr_get_lhs(e), env, depth + 1)
            && sema_ct_eval_known(expr_get_rhs(e), env, depth + 1);
    }
    if (k == ex_TERNARY()) {
        if (!sema_ct_eval_known(expr_get_lhs(e), env, depth + 1)) { return false; }
        if (sema_ct_eval_value(expr_get_lhs(e), env, depth + 1) != 0) {
            return sema_ct_eval_known(expr_get_rhs(e), env, depth + 1);
        }
        return sema_ct_eval_known(expr_get_args(e), env, depth + 1);
    }
    if (k == ex_CALL()) {
        let cname = sema_ct_call_name(e);
        var acell = expr_get_args(e);
        if (sema_ct_is_io_builtin(cname)) {
            if (cname == "ct_file_size") {
                if (acell == null) { return false; }
                let path_e = stmt_get_init(acell);
                return path_e != null && expr_get_kind(path_e) == ex_STR_LIT();
            }
            while (acell != null) {
                let ae = stmt_get_init(acell);
                if (ae == null) { return false; }
                if (expr_get_kind(ae) != ex_STR_LIT() && !sema_ct_eval_known(ae, env, depth + 1)) {
                    return false;
                }
                acell = stmt_get_next(acell);
            }
            return true;
        }
        let fdecl = expr_get_semantic_target(e);
        if (fdecl == null || !sema_decl_is_comptime_callable(fdecl)) { return false; }
        while (acell != null) {
            let ae2 = stmt_get_init(acell);
            if (!sema_ct_eval_known(ae2, env, depth + 1)) { return false; }
            acell = stmt_get_next(acell);
        }
        let saved_io = g_sema_ct_io_silent;
        g_sema_ct_io_silent = 1;
        let ok = sema_ct_exec_fn_known(fdecl, e, env, depth + 1);
        g_sema_ct_io_silent = saved_io;
        return ok;
    }
    return false;
}

fn sema_ct_eval_value(e: rawptr, env: string, depth: i32) -> i64 {
    if (e == null) { return 0; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT() || k == ex_BOOL_LIT() || k == ex_CHAR_LIT()) {
        return expr_get_int_val(e);
    }
    if (k == ex_STR_LIT()) { return 0; }
    if (k == ex_COMPTIME() || k == ex_CAST()) {
        return sema_ct_eval_value(expr_get_lhs(e), env, depth + 1);
    }
    if (k == ex_IDENT()) { return sema_ct_env_get(env, expr_get_name(e)); }
    if (k == ex_UNARY()) {
        let op = expr_get_op(e);
        let v = sema_ct_eval_value(expr_get_lhs(e), env, depth + 1);
        if (op == tk_NOT()) { if (v == 0) { return 1; } return 0; }
        if (op == tk_MINUS()) { return 0 - v; }
        if (op == tk_TILDE()) { return (0 - v) - 1; }
        return v;
    }
    if (k == ex_BIN()) {
        let op = expr_get_op(e);
        let l = sema_ct_eval_value(expr_get_lhs(e), env, depth + 1);
        let r = sema_ct_eval_value(expr_get_rhs(e), env, depth + 1);
        return sema_ct_bin_value(op, l, r);
    }
    if (k == ex_TERNARY()) {
        if (sema_ct_eval_value(expr_get_lhs(e), env, depth + 1) != 0) {
            return sema_ct_eval_value(expr_get_rhs(e), env, depth + 1);
        }
        return sema_ct_eval_value(expr_get_args(e), env, depth + 1);
    }
    if (k == ex_CALL()) {
        let cname = sema_ct_call_name(e);
        if (cname == "print" || cname == "println") {
            if (g_sema_ct_io_silent == 0) {
                var acell = expr_get_args(e);
                while (acell != null) {
                    sema_ct_print_arg(stmt_get_init(acell), env, depth + 1);
                    acell = stmt_get_next(acell);
                }
                if (cname == "println") { print("\n"); }
            }
            return 0;
        }
        if (cname == "ct_file_size") {
            let acell2 = expr_get_args(e);
            if (acell2 == null) { return 0; }
            let path_e = stmt_get_init(acell2);
            if (path_e == null || expr_get_kind(path_e) != ex_STR_LIT()) { return 0; }
            let path = expr_get_str_val(path_e);
            return vyx_bootstrap_file_size(path.c_str());
        }
        let fdecl = expr_get_semantic_target(e);
        return sema_ct_exec_fn_value(fdecl, e, env, depth + 1);
    }
    return 0;
}

fn sema_ct_bind_call_env(fdecl: rawptr, call_e: rawptr, env: string, depth: i32) -> string {
    var next = env;
    var p = decl_get_params(fdecl);
    var acell = expr_get_args(call_e);
    while (p != null) {
        let pname = decl_get_name(p);
        if (pname != "self") {
            if (acell == null) { return ""; }
            let ae = stmt_get_init(acell);
            if (!sema_ct_eval_known(ae, env, depth)) { return ""; }
            next = sema_ct_env_set(next, pname, sema_ct_eval_value(ae, env, depth));
            acell = stmt_get_next(acell);
        }
        p = decl_get_next(p);
    }
    return next;
}

fn sema_ct_exec_stmts(s: rawptr, env: string, depth: i32) -> string {
    var cur = s;
    var next = env;
    while (cur != null) {
        next = sema_ct_exec_stmt(cur, next, depth);
        if (sema_ct_env_has(next, "__ct_ret")) { return next; }
        if (sema_ct_env_has(next, "__ct_fail")) { return next; }
        if (sema_ct_env_has(next, "__ct_break")) { return next; }
        if (sema_ct_env_has(next, "__ct_continue")) { return next; }
        cur = stmt_get_next(cur);
    }
    return next;
}

fn sema_ct_exec_assign_ident(lhs: rawptr, rhs: rawptr, op: i32, env: string, depth: i32) -> string {
    if (lhs == null || expr_get_kind(lhs) != ex_IDENT()) {
        return sema_ct_env_set(env, "__ct_fail", 1);
    }
    if (!sema_ct_eval_known(rhs, env, depth + 1)) {
        return sema_ct_env_set(env, "__ct_fail", 1);
    }
    let name = expr_get_name(lhs);
    let oldv = sema_ct_env_get(env, name);
    let newv = sema_ct_apply_assign(op, oldv, sema_ct_eval_value(rhs, env, depth + 1));
    return sema_ct_env_set(env, name, newv);
}

fn sema_ct_exec_expr(ex: rawptr, env: string, depth: i32) -> string {
    if (ex == null) { return env; }
    let ek = expr_get_kind(ex);
    if (ek == ex_ASSIGN()) {
        return sema_ct_exec_assign_ident(expr_get_lhs(ex), expr_get_rhs(ex), expr_get_op(ex), env, depth);
    }
    if (ek == ex_CALL()) {
        if (!sema_ct_eval_known(ex, env, depth + 1)) {
            return sema_ct_env_set(env, "__ct_fail", 1);
        }
        sema_ct_eval_value(ex, env, depth + 1);
        return env;
    }
    return env;
}

fn sema_ct_exec_loop_body(body: rawptr, env: string, depth: i32) -> string {
    let next = sema_ct_exec_stmt(body, env, depth);
    return next;
}

fn sema_ct_exec_stmt(s: rawptr, env: string, depth: i32) -> string {
    if (s == null || depth > 32) { return sema_ct_env_set(env, "__ct_fail", 1); }
    let k = stmt_get_kind(s);
    if (k == st_BLOCK()) {
        return sema_ct_exec_stmts(stmt_get_body(s), env, depth + 1);
    }
    if (k == st_RETURN()) {
        let re = stmt_get_init(s);
        if (re == null) { return sema_ct_env_set(env, "__ct_ret", 0); }
        if (!sema_ct_eval_known(re, env, depth + 1)) {
            return sema_ct_env_set(env, "__ct_fail", 1);
        }
        return sema_ct_env_set(env, "__ct_ret", sema_ct_eval_value(re, env, depth + 1));
    }
    if (k == st_LET() || k == st_VAR()) {
        let init = stmt_get_init(s);
        if (init == null) { return sema_ct_env_set(env, stmt_get_name(s), 0); }
        if (!sema_ct_eval_known(init, env, depth + 1)) {
            return sema_ct_env_set(env, "__ct_fail", 1);
        }
        return sema_ct_env_set(env, stmt_get_name(s), sema_ct_eval_value(init, env, depth + 1));
    }
    if (k == st_IF()) {
        let cond = stmt_get_cond(s);
        if (!sema_ct_eval_known(cond, env, depth + 1)) {
            return sema_ct_env_set(env, "__ct_fail", 1);
        }
        if (sema_ct_eval_value(cond, env, depth + 1) != 0) {
            return sema_ct_exec_stmt(stmt_get_then_blk(s), env, depth + 1);
        }
        let else_blk = stmt_get_else_blk(s);
        if (else_blk != null) {
            return sema_ct_exec_stmt(else_blk, env, depth + 1);
        }
        return env;
    }
    if (k == st_BREAK()) {
        return sema_ct_env_set(env, "__ct_break", 1);
    }
    if (k == st_CONTINUE()) {
        return sema_ct_env_set(env, "__ct_continue", 1);
    }
    if (k == st_WHILE()) {
        var next = env;
        var iters: i32 = 0;
        let budget = sema_ct_loop_budget();
        while (iters < budget) {
            let cond = stmt_get_cond(s);
            if (!sema_ct_eval_known(cond, next, depth + 1)) {
                return sema_ct_env_set(next, "__ct_fail", 1);
            }
            if (sema_ct_eval_value(cond, next, depth + 1) == 0) { return next; }
            next = sema_ct_exec_loop_body(stmt_get_body(s), next, depth);
            if (sema_ct_env_has(next, "__ct_ret") || sema_ct_env_has(next, "__ct_fail")) { return next; }
            if (sema_ct_env_has(next, "__ct_break")) {
                return sema_ct_env_clear(next, "__ct_break");
            }
            if (sema_ct_env_has(next, "__ct_continue")) {
                next = sema_ct_env_clear(next, "__ct_continue");
            }
            iters = iters + 1;
        }
        return sema_ct_env_set(next, "__ct_fail", 1);
    }
    if (k == st_FOR()) {
        var next = env;
        let init_s = stmt_get_init(s);
        if (init_s != null) {
            next = sema_ct_exec_stmt(init_s, next, depth);
            if (sema_ct_env_has(next, "__ct_ret") || sema_ct_env_has(next, "__ct_fail")) { return next; }
        }
        var loop_body = stmt_get_body(s);
        var incr_s: rawptr = null;
        let then_blk = stmt_get_then_blk(s);
        if (then_blk != null) {
            loop_body = then_blk;
            incr_s = stmt_get_body(s);
        }
        var iters: i32 = 0;
        let budget = sema_ct_loop_budget();
        while (iters < budget) {
            let cond = stmt_get_cond(s);
            if (cond != null) {
                if (!sema_ct_eval_known(cond, next, depth + 1)) {
                    return sema_ct_env_set(next, "__ct_fail", 1);
                }
                if (sema_ct_eval_value(cond, next, depth + 1) == 0) { return next; }
            }
            if (loop_body != null) {
                next = sema_ct_exec_loop_body(loop_body, next, depth);
                if (sema_ct_env_has(next, "__ct_ret") || sema_ct_env_has(next, "__ct_fail")) { return next; }
                if (sema_ct_env_has(next, "__ct_break")) {
                    return sema_ct_env_clear(next, "__ct_break");
                }
                if (sema_ct_env_has(next, "__ct_continue")) {
                    next = sema_ct_env_clear(next, "__ct_continue");
                }
            }
            if (incr_s != null) {
                next = sema_ct_exec_stmt(incr_s, next, depth);
                if (sema_ct_env_has(next, "__ct_ret") || sema_ct_env_has(next, "__ct_fail")) { return next; }
            }
            iters = iters + 1;
        }
        return sema_ct_env_set(next, "__ct_fail", 1);
    }
    if (k == st_EXPR()) {
        return sema_ct_exec_expr(stmt_get_init(s), env, depth);
    }
    return sema_ct_env_set(env, "__ct_fail", 1);
}

fn sema_ct_exec_fn_result(fdecl: rawptr, call_e: rawptr, env: string, depth: i32) -> string {
    if (fdecl == null || call_e == null) { return sema_ct_env_set("", "__ct_fail", 1); }
    let bound = sema_ct_bind_call_env(fdecl, call_e, env, depth);
    if (bound.len == 0 && decl_get_params(fdecl) != null) {
        let first = decl_get_params(fdecl);
        if (first != null && decl_get_name(first) != "self") {
            return sema_ct_env_set("", "__ct_fail", 1);
        }
    }
    return sema_ct_exec_stmt(decl_get_body(fdecl), bound, depth + 1);
}

fn sema_ct_exec_fn_known(fdecl: rawptr, call_e: rawptr, env: string, depth: i32) -> bool {
    let result = sema_ct_exec_fn_result(fdecl, call_e, env, depth);
    return sema_ct_env_has(result, "__ct_ret") && !sema_ct_env_has(result, "__ct_fail");
}

fn sema_ct_exec_fn_value(fdecl: rawptr, call_e: rawptr, env: string, depth: i32) -> i64 {
    return sema_ct_env_get(sema_ct_exec_fn_result(fdecl, call_e, env, depth), "__ct_ret");
}

fn sema_try_fold_comptime_call(e: rawptr) {
    if (e == null || expr_get_kind(e) != ex_CALL()) { return; }
    let fdecl = expr_get_semantic_target(e);
    if (fdecl == null || !sema_decl_is_comptime_callable(fdecl)) { return; }
    if (!sema_ct_eval_known(e, "", 0)) { return; }
    sema_expr_rewrite_int(e, sema_ct_eval_value(e, "", 0));
}

fn numeric_result_ty(lk: i32, rk: i32) -> rawptr {
    if (lk == rk) { return tref_create_kind(lk); }
    let lb = type_kind_int_bits(lk);
    let rb = type_kind_int_bits(rk);
    if (rb > lb) { return tref_create_kind(rk); }
    if (lb > 0) { return tref_create_kind(lk); }
    return tref_create_kind(ty_I32());
}

fn numeric_float_result_ty(lt: rawptr, rt: rawptr) -> rawptr {
    let lb = type_ref_float_bits(lt);
    let rb = type_ref_float_bits(rt);
    if (lb >= rb && lb > 0) { return lt; }
    if (rb > 0) { return rt; }
    return tref_create_kind(ty_F64());
}

fn sema_expr_is_float_literal(e: rawptr) -> bool {
    if (e == null) { return false; }
    if (expr_get_kind(e) != ex_INT_LIT()) { return false; }
    return string_contains(expr_get_str_val(e), ".");
}

fn sema_binop_contextualizes_float_literal(op: i32) -> bool {
    return op == tk_PLUS() || op == tk_MINUS()
        || op == tk_STAR() || op == tk_SLASH()
        || op == tk_PERCENT()
        || op == tk_LT() || op == tk_LE()
        || op == tk_GT() || op == tk_GE()
        || op == tk_EQEQ() || op == tk_NEQ();
}

fn sema_contextualize_float_literal(e: rawptr, target_ty: rawptr) -> rawptr {
    if (!sema_expr_is_float_literal(e)) { return null; }
    if (type_ref_float_bits(target_ty) != 32) { return null; }
    let ty = tref_create_kind(ty_F32());
    expr_set_ty(e, ty);
    return ty;
}

/// Trailing segment of a dotted module/type path.
public fn module_last_segment(path: string) -> string {
    let n = path.len;
    if (n == 0) {
        return "";
    }
    var i: i64 = n;
    while (i > 0) {
        i = i - 1;
        if (path.charAt(i as i32) == 46) {
            return str_view_range(path, (i + 1) as i32, n as i32);
        }
    }
    return path;
}

fn module_parent_path(path: string) -> string {
    let n = path.len;
    if (n == 0) { return ""; }
    var i: i64 = n;
    while (i > 0) {
        i = i - 1;
        if (path.charAt(i as i32) == 46) {
            if (i == 0) { return ""; }
            return str_view_range(path, 0, i as i32);
        }
    }
    return "";
}

fn module_path_is_same_or_child(path: string, parent: string) -> bool {
    if (path.len == 0 || parent.len == 0) { return false; }
    if (path == parent) { return true; }
    return path.len > parent.len + 1
        && path.startsWith(parent)
        && path.charAt(parent.len) == 46;
}

fn module_root_segment(path: string) -> string {
    if (path.len == 0) { return ""; }
    var i: i32 = 0;
    while (i < path.len) {
        if (path.charAt(i) == 46) {
            if (i == 0) { return ""; }
            return str_view_range(path, 0, i);
        }
        i = i + 1;
    }
    return path;
}

fn sema_vis_is_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn sema_vis_trim(s: string) -> string {
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end && sema_vis_is_space(s.charAt(start))) {
        start = start + 1;
    }
    while (end > start && sema_vis_is_space(s.charAt(end - 1))) {
        end = end - 1;
    }
    if (start == 0 && end == (s.len as i32)) { return s; }
    return str_view_range(s, start, end);
}

fn sema_vis_matching_outer_parens(s: string) -> bool {
    let t = sema_vis_trim(s);
    if (t.len < 2) { return false; }
    if (t.charAt(0) != 40 || t.charAt((t.len - 1) as i32) != 41) { return false; }
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < t.len) {
        let c = t.charAt(i);
        if (c == 40) {
            depth = depth + 1;
        } elif (c == 41) {
            depth = depth - 1;
            if (depth == 0 && i != t.len - 1) { return false; }
        }
        if (depth < 0) { return false; }
        i = i + 1;
    }
    return depth == 0;
}

fn sema_vis_strip_outer_parens(s: string) -> string {
    var out = sema_vis_trim(s);
    var changed: bool = true;
    while (changed && sema_vis_matching_outer_parens(out)) {
        changed = false;
        let end = (out.len - 1) as i32;
        out = sema_vis_trim(str_view_range(out, 1, end));
        changed = true;
    }
    return out;
}

fn sema_vis_find_top_addsub(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) {
            depth = depth + 1;
        } elif (c == 40) {
            depth = depth - 1;
        } elif (depth == 0 && (c == 43 || c == 45)) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn sema_vis_find_top_and(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) {
            depth = depth + 1;
        } elif (c == 40) {
            depth = depth - 1;
        } elif (depth == 0 && c == 38) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn sema_vis_path_list_contains(payload: string, caller_module: string) -> bool {
    if (payload.len == 0 || caller_module.len == 0) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    var depth: i32 = 0;
    while (i <= payload.len) {
        if (i == payload.len || (payload.charAt(i) == 44 && depth == 0)) {
            let part = sema_vis_trim(str_view_range(payload, start, i));
            if (part == caller_module || module_path_is_same_or_child(caller_module, part)) { return true; }
            start = i + 1;
        } else {
            let c = payload.charAt(i);
            if (c == 40) { depth = depth + 1; }
            elif (c == 41 && depth > 0) { depth = depth - 1; }
        }
        i = i + 1;
    }
    return false;
}

fn sema_vis_friend_list_contains(payload: string, caller_module: string) -> bool {
    let caller_pkg = module_root_segment(caller_module);
    if (payload.len == 0 || caller_pkg.len == 0) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= payload.len) {
        if (i == payload.len || payload.charAt(i) == 44) {
            let part = sema_vis_trim(str_view_range(payload, start, i));
            if (part == caller_pkg) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn sema_vis_atom_allows(atom_raw: string,
                        caller_module: string,
                        source_module: string,
                        source_imported: bool) -> bool {
    let atom = sema_vis_trim(atom_raw);
    if (atom.len == 0) { return false; }
    if (atom == "world" || atom == "public") { return true; }
    if (atom == "none") { return false; }
    if (atom == "self") { return !source_imported; }
    if (atom == "mod") {
        return caller_module.len > 0
            && source_module.len > 0
            && caller_module == source_module;
    }
    if (atom == "super") {
        if (caller_module.len == 0 || source_module.len == 0) { return false; }
        if (caller_module == source_module) { return true; }
        return caller_module == module_parent_path(source_module);
    }
    if (atom == "tree") {
        return module_path_is_same_or_child(caller_module, source_module);
    }
    if (atom == "package") {
        if (!source_imported) { return true; }
        let caller_pkg = module_root_segment(caller_module);
        let source_pkg = module_root_segment(source_module);
        return caller_pkg.len > 0 && caller_pkg == source_pkg;
    }
    if (atom.startsWith("in(") && atom.len >= 4 && atom.charAt((atom.len - 1) as i32) == 41) {
        return sema_vis_path_list_contains(str_view_range(atom, 3, (atom.len - 1) as i32),
                                           caller_module);
    }
    if (atom.startsWith("friend(") && atom.len >= 8 && atom.charAt((atom.len - 1) as i32) == 41) {
        return sema_vis_friend_list_contains(str_view_range(atom, 7, (atom.len - 1) as i32),
                                             caller_module);
    }
    return false;
}

fn sema_vis_expr_allows(expr_raw: string,
                        caller_module: string,
                        source_module: string,
                        source_imported: bool) -> bool {
    let expr = sema_vis_strip_outer_parens(expr_raw);
    if (expr.len == 0) { return false; }
    let addsub = sema_vis_find_top_addsub(expr);
    if (addsub >= 0) {
        let lhs = sema_vis_expr_allows(str_view_range(expr, 0, addsub),
                                       caller_module,
                                       source_module,
                                       source_imported);
        let rhs = sema_vis_expr_allows(str_view_range(expr, addsub + 1, expr.len),
                                       caller_module,
                                       source_module,
                                       source_imported);
        if (expr.charAt(addsub) == 43) { return lhs || rhs; }
        return lhs && !rhs;
    }
    let and_pos = sema_vis_find_top_and(expr);
    if (and_pos >= 0) {
        return sema_vis_expr_allows(str_view_range(expr, 0, and_pos),
                                    caller_module,
                                    source_module,
                                    source_imported)
            && sema_vis_expr_allows(str_view_range(expr, and_pos + 1, expr.len),
                                    caller_module,
                                    source_module,
                                    source_imported);
    }
    return sema_vis_atom_allows(expr, caller_module, source_module, source_imported);
}

fn sema_meta_attr_value(meta: string, attr: string) -> string {
    if (meta.len == 0 || attr.len == 0) { return ""; }
    if (!string_contains(meta, "|attrs:")) { return ""; }
    var pat = intern_cat3("@[", attr, "(");
    var pos = meta.indexOf(pat);
    if (pos < 0) {
        pat = intern_cat3("@", attr, "(");
        pos = meta.indexOf(pat);
    }
    if (pos < 0) { return ""; }

    let start = (pos + pat.len) as i32;
    var i = start;
    var depth: i32 = 1;
    while (i < meta.len) {
        let ch = meta.charAt(i);
        if (ch == 40) {
            depth = depth + 1;
        } elif (ch == 41) {
            depth = depth - 1;
            if (depth == 0) {
                return str_view_range(meta, start, i);
            }
        }
        i = i + 1;
    }
    return "";
}

fn sema_decl_visibility_expr(d: rawptr) -> string {
    if (d == null) { return "self"; }
    let meta = decl_get_meta(d);
    var expr = sema_meta_attr_value(meta, "vis");
    if (expr.len == 0) { expr = sema_meta_attr_value(meta, "visibility"); }
    if (expr.len > 0) { return sema_vis_trim(expr); }
    if (string_contains(meta, "|vis:public")) { return "world"; }
    if (string_contains(meta, "|vis:private")) { return "self"; }
    if (string_contains(meta, "|vis:internal")) { return "package"; }
    if (string_contains(meta, "|vis:protected")) { return "tree"; }
    if (decl_get_is_public(d)) { return "world"; }
    return "self";
}

fn sema_decl_visibility_is_none(d: rawptr) -> bool {
    return sema_vis_strip_outer_parens(sema_decl_visibility_expr(d)) == "none";
}

fn sema_use_decl_alias_name(meta: string) -> string {
    if (meta.len == 0) { return ""; }
    if (meta.charAt(0) == 124) { return ""; }
    // Driver import marking appends `|imported|from:…` onto existing meta.
    // The alias is the bare prefix before the first `|`.
    var i: i32 = 0;
    while (i < meta.len) {
        if (meta.charAt(i) == 124) {
            return str_view_range(meta, 0, i);
        }
        i = i + 1;
    }
    return meta;
}

fn sema_name_matches_qualified_or_short(a: string, b: string) -> bool {
    return policy_type_name_equal(a, b);
}

fn generic_list_contains(list: string, name: string) -> bool {
    if (list.len == 0 || name.len == 0) {
        return false;
    }
    let n = list.len;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        if (i == n || list.charAt(i as i32) == 44 || list.charAt(i as i32) == 124) {
            let part = str_view_range(list, start as i32, i as i32);
            if (generic_param_canonical_name(part) == generic_param_canonical_name(name)) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn generic_param_canonical_name(raw: string) -> string {
    if (raw.len == 0) { return ""; }
    var i: i64 = 0;
    while (i < raw.len) {
        if (raw.charAt(i as i32) == 94) {
            return str_view_range(raw, 0, i as i32);
        }
        i = i + 1;
    }
    return raw;
}

fn generic_param_is_const(raw: string) -> bool {
    if (raw.len < 6) { return false; }
    return str_view_range(raw, (raw.len - 6) as i32, raw.len as i32) == "^const";
}

fn generic_param_raw_at(gp: string, want_idx: i32) -> string {
    let n = gp.len;
    var idx: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        if (i == n || gp.charAt(i as i32) == 44 || gp.charAt(i as i32) == 124) {
            if (idx == want_idx) {
                return str_view_range(gp, start as i32, i as i32);
            }
            idx = idx + 1;
            start = i + 1;
            if (i < n && gp.charAt(i as i32) == 124) {
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}

public fn string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    return vyx_string_contains(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

public fn string_starts_with(hay: string, needle: string) -> bool {
    return vyx_string_starts_with(hay.c_str(), hay.len as u64, needle.c_str(), needle.len as u64) != 0;
}

fn type_nominally_equal(a: rawptr, b: rawptr) -> bool {
    if (type_eq(a, b)) { return true; }
    if (a == null || b == null) { return false; }
    if (tref_get_kind(a) != ty_CLASS() || tref_get_kind(b) != ty_CLASS()) {
        return false;
    }
    let an = tref_get_name(a);
    let bn = tref_get_name(b);
    return policy_type_name_equal(an, bn);
}

fn sema_pack_index_base(name: string) -> string {
    if (name.len < 4) { return ""; }
    if (name.charAt((name.len - 1) as i32) != 93) { return ""; }
    var i: i64 = 0;
    while (i < name.len) {
        if (name.charAt(i as i32) == 91) {
            if (i == 0) { return ""; }
            return str_view_range(name, 0, i as i32);
        }
        i = i + 1;
    }
    return "";
}

fn sema_pack_index_value(name: string) -> i32 {
    if (name.len < 4) { return -1; }
    var lb: i64 = -1;
    var i: i64 = 0;
    while (i < name.len) {
        if (name.charAt(i as i32) == 91) { lb = i; }
        i = i + 1;
    }
    if (lb < 0 || lb + 1 >= name.len - 1) { return -1; }
    let inner = str_view_range(name, (lb + 1) as i32, (name.len - 1) as i32);
    if (inner.len == 0) { return -1; }
    return parse_int_literal(inner) as i32;
}

fn generic_name_looks_like_placeholder(name: string) -> bool {
    if (name.len == 0) { return false; }
    let c = name.charAt(0);
    return c >= 65 && c <= 90;
}

fn string_is_all_caps_ident(name: string) -> bool {
    if (name.len == 0) { return false; }
    var saw_upper: bool = false;
    var i: i64 = 0;
    while (i < name.len) {
        let c = name.charAt(i as i32);
        if (c >= 65 && c <= 90) {
            saw_upper = true;
        } else if (c >= 48 && c <= 57) {
        } else if (c == 95) {
        } else {
            return false;
        }
        i = i + 1;
    }
    return saw_upper;
}

fn type_name_is_primitive_text(name: string) -> bool {
    return policy_primitive_type_kind(name) != 0;
}

fn primitive_impl_lookup_name(name: string) -> string {
    if (name == "str") { return "string"; }
    return name;
}

fn intern_str_view(p: rawptr) -> string {
    if (p == null) { return ""; }
    return from_cstr_view_len(p, strlen(p));
}

fn intern_lit(s: string) -> string {
    return intern_str_view(vyx_intern_bytes(s.c_str(), s.len));
}

fn type_text_from_ty(ty: rawptr) -> string {
    if (ty == null) { return intern_lit(""); }
    let cached = vyx_type_text_cache_get(ty);
    if (cached != null) {
        return intern_str_view(cached);
    }
    let text = type_text_from_ty_compute(ty);
    vyx_type_text_cache_put(ty, text.c_str(), text.len);
    return text;
}

fn type_text_from_ty_compute(ty: rawptr) -> string {
    if (ty == null) { return intern_lit(""); }
    let k = tref_get_kind(ty);
    if (k == ty_I8()) { return intern_lit("i8"); }
    if (k == ty_I16()) { return intern_lit("i16"); }
    if (k == ty_I32()) { return intern_lit("i32"); }
    if (k == ty_I64()) { return intern_lit("i64"); }
    if (k == ty_U8()) { return intern_lit("u8"); }
    if (k == ty_U16()) { return intern_lit("u16"); }
    if (k == ty_U32()) { return intern_lit("u32"); }
    if (k == ty_U64()) { return intern_lit("u64"); }
    if (k == ty_ISIZE()) { return intern_lit("isize"); }
    if (k == ty_USIZE()) { return intern_lit("usize"); }
    if (k == ty_F32()) { return intern_lit("f32"); }
    if (k == ty_F64()) { return intern_lit("f64"); }
    if (k == ty_BOOL()) { return intern_lit("bool"); }
    if (k == ty_CHAR()) { return intern_lit("char"); }
    if (k == ty_STRING()) { return intern_lit("str"); }
    if (k == ty_RAWPTR()) { return intern_lit("rawptr"); }
    if (k == ty_VOID()) { return intern_lit("void"); }
    if (k == ty_RANGE()) { return intern_lit("Range"); }
    if (k == ty_CLASS()) { return intern_lit(tref_get_name(ty)); }
    if (k == ty_PTR()) { return intern_cat2("*", type_text_from_ty(tref_pointee(ty))); }
    if (k == ty_REF()) { return intern_cat2("&", type_text_from_ty(tref_pointee(ty))); }
    if (k == ty_MUTREF()) { return intern_cat2("&mut ", type_text_from_ty(tref_pointee(ty))); }
    if (k == ty_ARRAY()) {
        let size_expr = tref_array_size_expr(ty);
        var size_text = intern_lit("?");
        if (sema_const_i64_known(size_expr)) {
            size_text = intern_lit(sema_const_i64_value(size_expr).toString());
        } else if (size_expr != null && expr_get_kind(size_expr) == ex_IDENT()) {
            size_text = intern_lit(expr_get_name(size_expr));
        }
        return intern_lit("[" + type_text_from_ty(tref_array_elem(ty)) + ";" + size_text + "]");
    }
    if (k == ty_TUPLE()) {
        var tuple_text = "(";
        let tuple_count = tref_tuple_count(ty);
        var tuple_index: i64 = 0;
        while (tuple_index < tuple_count) {
            if (tuple_index > 0) { tuple_text = tuple_text + ","; }
            tuple_text = tuple_text + type_text_from_ty(tref_tuple_elem_at(ty, tuple_index));
            tuple_index = tuple_index + 1;
        }
        return intern_lit(tuple_text + ")");
    }
        if (k == ty_FN() || k == ty_CFN()) {
        var out = "fn(";
        if (k == ty_CFN()) { out = "cfn("; }
        let params = tref_fn_params(ty);
        let n_params = tref_tuple_count(params);
        var i: i64 = 0;
        while (i < n_params) {
            if (i > 0) { out = out + ","; }
            out = out + type_text_from_ty(tref_tuple_elem_at(params, i));
            i = i + 1;
        }
        out = out + ")->";
        out = out + type_text_from_ty(tref_fn_ret(ty));
        return intern_lit(out);
    }
    return intern_lit("");
}

fn generic_param_at(gp: string, want_idx: i32) -> string {
    return generic_param_canonical_name(generic_param_raw_at(gp, want_idx));
}

fn generic_arg_at(args: string, want_idx: i32) -> string {
    return policy_generic_arg_at(args, want_idx);
}

fn generic_args_reference_params(args: string, params: string) -> bool {
    if (args.len == 0 || params.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 64) {
        let part = generic_arg_at(args, i);
        if (part.len == 0) { return false; }
        if (generic_list_contains(params, part)) { return true; }
        let inner = policy_generic_call_args(part.clone());
        if (inner.len > 0 && generic_args_reference_params(inner, params)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn generic_param_count(gp: string) -> i32 {
    if (gp.len == 0 || gp.charAt(0) == 124) { return 0; }
    var count: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= gp.len) {
        if (i == gp.len || gp.charAt(i as i32) == 44 || gp.charAt(i as i32) == 124) {
            let part = str_view_range(gp, start as i32, i as i32);
            if (part.len > 0) { count = count + 1; }
            if (i < gp.len && gp.charAt(i as i32) == 124) {
                return count;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn generic_arg_count(args: string) -> i32 {
    if (args.len == 0) { return 0; }
    var count: i32 = 0;
    while (count < 64) {
        let part = generic_arg_at(args, count);
        if (part.len == 0) { return count; }
        count = count + 1;
    }
    return count;
}

fn generic_param_head(gp: string) -> string {
    let n = gp.len;
    var i: i64 = 0;
    while (i < n) {
        if (gp.charAt(i as i32) == 124) {
            return str_view_range(gp, 0, i as i32);
        }
        i = i + 1;
    }
    return gp;
}

fn generic_param_meta(gp: string) -> string {
    let n = gp.len;
    var i: i64 = 0;
    while (i < n) {
        if (gp.charAt(i as i32) == 124) {
            return str_view_range(gp, i as i32, n as i32);
        }
        i = i + 1;
    }
    return "";
}

fn merge_generic_params(owner_gp: string, method_gp: string) -> string {
    let owner_head = generic_param_head(owner_gp);
    let method_head = generic_param_head(method_gp);
    var head = owner_head;
    if (method_head.len > 0) {
        if (head.len > 0) {
            head = head + "," + method_head;
        } else {
            head = method_head;
        }
    }
    let owner_meta = generic_param_meta(owner_gp);
    let method_meta = generic_param_meta(method_gp);
    if (owner_meta.len == 0) { return head + method_meta; }
    if (method_meta.len == 0) { return head + owner_meta; }
    return head + owner_meta + method_meta;
}

fn sym_find_generic_fn_same_arity(head: rawptr, name: string, arity: i32) -> rawptr {
    var cur = head;
    while (cur != null) {
        if (sym_get_name(cur) == name) {
            let d = sym_get_decl(cur);
            if (d != null && generic_param_count(decl_get_generic_params(d)) == arity) {
                return cur;
            }
        }
        cur = sym_get_next(cur);
    }
    return null;
}

fn sema_fn_type_name_to_ref(name: string) -> rawptr {
    var is_c_fn: bool = false;
    var params_start: i32 = -1;
    if (string_starts_with(name, "unsafe fn(")) {
        is_c_fn = true;
        params_start = 10;
    } else if (string_starts_with(name, "fn(")) {
        params_start = 3;
    } else {
        return null;
    }

    var close_idx: i32 = -1;
    var depth: i32 = 0;
    var i: i32 = params_start;
    while ((i as i64) < name.len) {
        let c = name.charAt(i);
        if (c == 40) {
            depth = depth + 1;
        } else if (c == 41) {
            if (depth == 0) {
                close_idx = i;
                i = name.len as i32;
            } else {
                depth = depth - 1;
            }
        }
        i = i + 1;
    }
    if (close_idx < 0) { return null; }
    let arrow_idx = close_idx + 1;
    if ((arrow_idx as i64) + 2 > name.len) { return null; }
    if (name.charAt(arrow_idx) != 45 || name.charAt(arrow_idx + 1) != 62) {
        return null;
    }

    let params_text = str_view_range(name, params_start, close_idx);
    let ret_text = str_view_range(name, arrow_idx + 2, name.len as i32);
    var count: i64 = 0;
    while (generic_arg_at(params_text, count as i32).len > 0) {
        count = count + 1;
    }
    var buf: rawptr = null;
    if (count > 0) {
        buf = vyx_frontend_alloc((count * 8) as u64);
        var pi: i64 = 0;
        while (pi < count) {
            let part = generic_arg_at(params_text, pi as i32);
            ast_write_rawptr(ptr_offset(buf, (pi * 8) as i32),
                             sema_type_name_to_ref(part));
            pi = pi + 1;
        }
    }
    let params = tref_alloc_tuple(buf, count);
    let ret = sema_type_name_to_ref(ret_text);
    if (is_c_fn) { return tref_alloc_c_fn(params, ret); }
    return tref_alloc_fn(params, ret);
}

fn sema_type_name_to_ref(name: string) -> rawptr {
    let normalized = name.trim();
    if (normalized.startsWith("&mut ")) {
        let pointee = str_view_range(normalized, 5, normalized.len).trim();
        if (pointee.len > 0) {
            return tref_alloc_ptr_like(ty_MUTREF(), sema_type_name_to_ref(pointee));
        }
    }
    if (normalized.startsWith("&mut") && normalized.len > 4) {
        let pointee2 = str_view_range(normalized, 4, normalized.len).trim();
        if (pointee2.len > 0) {
            return tref_alloc_ptr_like(ty_MUTREF(), sema_type_name_to_ref(pointee2));
        }
    }
    if (normalized.startsWith("&") && normalized.len > 1) {
        let pointee3 = str_view_range(normalized, 1, normalized.len).trim();
        if (pointee3.len > 0) {
            return tref_alloc_ptr_like(ty_REF(), sema_type_name_to_ref(pointee3));
        }
    }
    if (normalized.startsWith("*") && normalized.len > 1) {
        let pointee4 = str_view_range(normalized, 1, normalized.len).trim();
        if (pointee4.len > 0) {
            return tref_alloc_ptr_like(ty_PTR(), sema_type_name_to_ref(pointee4));
        }
    }
    let fn_ref = sema_fn_type_name_to_ref(normalized);
    if (fn_ref != null) { return fn_ref; }
    let prim = policy_primitive_type_kind(normalized);
    if (prim == 1) { return tref_alloc(ty_I8(), ""); }
    if (prim == 2) { return tref_alloc(ty_I16(), ""); }
    if (prim == 3) { return tref_alloc(ty_I32(), ""); }
    if (prim == 4) { return tref_alloc(ty_I64(), ""); }
    if (prim == 5) { return tref_alloc(ty_U8(), ""); }
    if (prim == 6) { return tref_alloc(ty_U16(), ""); }
    if (prim == 7) { return tref_alloc(ty_U32(), ""); }
    if (prim == 8) { return tref_alloc(ty_U64(), ""); }
    if (prim == 9) { return tref_alloc(ty_ISIZE(), ""); }
    if (prim == 10) { return tref_alloc(ty_USIZE(), ""); }
    if (prim == 11) { return tref_alloc(ty_BOOL(), ""); }
    if (prim == 12) { return tref_alloc(ty_CHAR(), ""); }
    if (prim == 13) { return tref_alloc(ty_STRING(), ""); }
    if (prim == 14) { return tref_alloc(ty_RAWPTR(), ""); }
    if (prim == 15) { return tref_alloc(ty_VOID(), ""); }
    if (prim == 16) { return tref_alloc(ty_F32(), ""); }
    if (prim == 17) { return tref_alloc(ty_F64(), ""); }
    return tref_alloc(ty_CLASS(), normalized);
}

fn sema_result_ok_type_ref(ty: rawptr) -> rawptr {
    if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return null; }
    let name = tref_get_name(ty);
    let base = module_last_segment(generic_call_base(name.clone()));
    if (base != "Result") { return null; }
    let args = policy_generic_call_args(name.clone());
    if (args.len == 0) { return null; }
    let ok_name = generic_arg_at(args, 0);
    if (ok_name.len == 0) { return null; }
    return sema_type_name_to_ref(ok_name);
}

fn sema_result_err_type_ref(ty: rawptr) -> rawptr {
    if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return null; }
    let name = tref_get_name(ty);
    let base = module_last_segment(generic_call_base(name.clone()));
    if (base != "Result") { return null; }
    let args = policy_generic_call_args(name.clone());
    if (args.len == 0) { return null; }
    let err_name = generic_arg_at(args, 1);
    if (err_name.len == 0) { return null; }
    return sema_type_name_to_ref(err_name);
}

fn sema_option_inner_type_ref(ty: rawptr) -> rawptr {
    if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return null; }
    let name = tref_get_name(ty);
    let base = module_last_segment(generic_call_base(name.clone()));
    if (base != "Option") { return null; }
    let args = policy_generic_call_args(name.clone());
    if (args.len == 0) { return null; }
    let inner_name = generic_arg_at(args, 0);
    if (inner_name.len == 0) { return null; }
    return sema_type_name_to_ref(inner_name);
}

fn sema_async_result_type_ref(ty: rawptr) -> rawptr {
    if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return null; }
    let name = tref_get_name(ty);
    let base = module_last_segment(generic_call_base(name.clone()));
    if (policy_type_name_equal(base, "Promise") == 0
        && policy_type_name_equal(base, "Task") == 0) {
        return null;
    }
    let args = policy_generic_call_args(name.clone());
    if (args.len == 0) { return null; }
    let inner_name = generic_arg_at(args, 0);
    if (inner_name.len == 0) { return null; }
    return sema_type_name_to_ref(inner_name);
}

fn sema_decl_is_async_callable(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    // Async/task lowering is an Effect-owned semantic decision.  The early
    // Effect preparation pass stamps this compiler-owned marker before call
    // resolution; raw attribute text must not be enough to synthesize a Task
    // return type or pull in std.vio.  Keep the legacy markers as a narrow
    // compatibility path for declarations produced by older imported
    // artifacts, but require the new marker whenever source attrs are present.
    let has_async_attr = string_contains(meta, "|attrs:async")
        || string_contains(meta, "|attrs:task")
        || string_contains(meta, "@[async")
        || string_contains(meta, "@async")
        || string_contains(meta, "@[task")
        || string_contains(meta, "@task");
    if (has_async_attr && !string_contains(meta, "|effect:async|")) { return false; }
    if (string_contains(meta, "|effect:async|")) { return true; }
    if (string_contains(meta, "|marker:async")) { return true; }
    if (string_contains(meta, "|marker:task")) { return true; }
    return false;
}

fn sema_task_type_for_async_return(ret_ty: rawptr) -> rawptr {
    var payload = ret_ty;
    if (payload == null || tref_get_kind(payload) == ty_VOID()) {
        payload = tref_create_kind(ty_I32());
    }
    let payload_name = type_text_from_ty(payload);
    if (payload_name.len == 0) { return tref_create_class("Task::<i32>"); }
    return tref_create_class("Task::<" + payload_name + ">");
}

fn sema_substitute_generic_text(name: string, gp: string, args: string) -> string {
    if (name.len == 0 || gp.len == 0 || args.len == 0) { return name; }
    var i: i32 = 0;
    while (i < 64) {
        let p = generic_param_at(gp, i);
        if (p.len == 0) { return name; }
        if (p == name) {
            let a = generic_arg_at(args, i);
            if (a.len > 0) { return a; }
            return name;
        }
        if (name.len > p.len
            && str_view_range(name, 0, p.len as i32) == p
            && name.charAt(p.len as i32) == 46) {
            let a2 = generic_arg_at(args, i);
            if (a2.len > 0) {
                return a2 + str_view_range(name, p.len as i32, name.len as i32);
            }
            return name;
        }
        i = i + 1;
    }
    return name;
}

fn sema_type_text_contains_generic_atom(text: string, atom: string) -> bool {
    if (text.len == 0 || atom.len == 0) { return false; }
    if (text == atom) { return true; }
    if (text.len > atom.len
        && str_view_range(text, 0, atom.len as i32) == atom
        && text.charAt(atom.len as i32) == 46) {
        return true;
    }
    let inner = policy_generic_call_args(text.clone());
    if (inner.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 64) {
        let part = generic_arg_at(inner, i);
        if (part.len == 0) { return false; }
        if (sema_type_text_contains_generic_atom(part, atom)) { return true; }
        i = i + 1;
    }
    return false;
}

fn sema_substitute_generic_type_text(name: string, gp: string, args: string) -> string {
    if (name.len == 0 || gp.len == 0 || args.len == 0) { return name; }
    let direct = sema_substitute_generic_text(name.clone(), gp, args);
    if (direct != name && sema_type_text_contains_generic_atom(direct, name)) {
        return direct;
    }
    let base = generic_call_base(direct.clone());
    let inner = policy_generic_call_args(direct.clone());
    if (inner.len == 0) { return direct; }
    var out_args: string = "";
    var i: i32 = 0;
    while (i < 64) {
        let part = generic_arg_at(inner, i);
        if (part.len == 0) {
            return base + "::<" + out_args + ">";
        }
        if (out_args.len > 0) { out_args = out_args + ","; }
        out_args = out_args + sema_substitute_generic_type_text(part, gp, args);
        i = i + 1;
    }
    return base + "::<" + out_args + ">";
}

fn sema_string_is_i64_lit(s: string) -> bool {
    let clean = sema_vis_trim(s);
    let n = clean.len;
    if (n == 0) { return false; }
    var i: i32 = 0;
    if (clean.charAt(0) == 45) {
        if (n == 1) { return false; }
        i = 1;
    }
    while (i < n) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn sema_parse_i64_lit(s: string) -> i64 {
    let clean = sema_vis_trim(s);
    var sign: i64 = 1;
    var i: i32 = 0;
    if (clean.len > 0 && clean.charAt(0) == 45) {
        sign = -1;
        i = 1;
    }
    var out: i64 = 0;
    while (i < clean.len) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return 0; }
        out = out * 10 + ((c - 48) as i64);
        i = i + 1;
    }
    return out * sign;
}

fn sema_const_generic_arg_for_param(gp: string, args: string, name: string) -> string {
    if (gp.len == 0 || args.len == 0 || name.len == 0) { return ""; }
    var i: i32 = 0;
    while (i < 64) {
        let p = generic_param_at(gp, i);
        if (p.len == 0) { return ""; }
        if (p == name) { return sema_vis_trim(generic_arg_at(args, i)); }
        i = i + 1;
    }
    return "";
}

fn sema_substitute_const_generic_stmt_chain_with_args(src: rawptr,
                                                      gp: string,
                                                      args: string,
                                                      depth: i32) -> rawptr {
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    var head: rawptr = null;
    var tail: rawptr = null;
    var cur = src;
    while (cur != null) {
        let s = stmt_alloc(stmt_get_kind(cur));
        stmt_set_name(s, stmt_get_name(cur));
        stmt_set_ty(s, sema_substitute_type_with_args(stmt_get_ty(cur), gp, args));
        stmt_set_init(s, sema_substitute_const_generic_expr_with_args(stmt_get_init(cur), gp, args, depth + 1));
        stmt_set_cond(s, sema_substitute_const_generic_expr_with_args(stmt_get_cond(cur), gp, args, depth + 1));
        stmt_set_then_blk(s, sema_substitute_const_generic_stmt_chain_with_args(stmt_get_then_blk(cur), gp, args, depth + 1));
        stmt_set_else_blk(s, sema_substitute_const_generic_stmt_chain_with_args(stmt_get_else_blk(cur), gp, args, depth + 1));
        stmt_set_body(s, sema_substitute_const_generic_stmt_chain_with_args(stmt_get_body(cur), gp, args, depth + 1));
        if (head == null) {
            head = s;
            tail = s;
        } else {
            stmt_set_next(tail, s);
            tail = s;
        }
        cur = stmt_get_next(cur);
    }
    return head;
}

fn sema_substitute_const_generic_expr_with_args(src: rawptr,
                                                gp: string,
                                                args: string,
                                                depth: i32) -> rawptr {
    if (src == null) { return null; }
    if (depth >= 256) {
        sema_report_clone_depth_exceeded();
        return null;
    }
    let k = expr_get_kind(src);
    if (k == ex_IDENT()) {
        let bound = sema_const_generic_arg_for_param(gp, args, expr_get_name(src));
        if (bound.len > 0) {
            if (sema_string_is_i64_lit(bound)) {
                return sema_expr_int_lit(sema_parse_i64_lit(bound));
            }
            let out_ident = sema_expr_ident(bound);
            expr_set_ty(out_ident, sema_substitute_type_with_args(expr_get_ty(src), gp, args));
            return out_ident;
        }
    }

    let out = expr_alloc(k);
    expr_set_op(out, expr_get_op(src));
    expr_set_int_val(out, expr_get_int_val(src));
    expr_set_str_val(out, expr_get_str_val(src));
    expr_set_name(out, expr_get_name(src));
    expr_set_ty(out, sema_substitute_type_with_args(expr_get_ty(src), gp, args));
    if (k == ex_CLOSURE()) {
        expr_set_lhs(out, sema_substitute_const_generic_stmt_chain_with_args(expr_get_lhs(src), gp, args, depth + 1));
        expr_set_rhs(out, sema_substitute_type_with_args(expr_get_rhs(src), gp, args));
        expr_set_args(out, sema_clone_decl_chain_env(expr_get_args(src), null, depth + 1));
        expr_set_captures(out, sema_substitute_const_generic_stmt_chain_with_args(expr_get_captures(src), gp, args, depth + 1));
        return out;
    }
    if (k == ex_IF_EXPR()) {
        expr_set_lhs(out, sema_substitute_const_generic_expr_with_args(expr_get_lhs(src), gp, args, depth + 1));
        expr_set_rhs(out, sema_substitute_const_generic_stmt_chain_with_args(expr_get_rhs(src), gp, args, depth + 1));
        let else_part = expr_get_args(src);
        if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
            expr_set_args(out, sema_substitute_const_generic_expr_with_args(else_part, gp, args, depth + 1));
        } else {
            expr_set_args(out, sema_substitute_const_generic_stmt_chain_with_args(else_part, gp, args, depth + 1));
        }
        return out;
    }
    if (k == ex_NEW() || k == ex_DELETE()) {
        expr_set_lhs(out, sema_substitute_const_generic_expr_with_args(expr_get_lhs(src), gp, args, depth + 1));
        expr_set_rhs(out, sema_substitute_const_generic_expr_with_args(expr_get_rhs(src), gp, args, depth + 1));
        expr_set_args(out, sema_substitute_const_generic_stmt_chain_with_args(expr_get_args(src), gp, args, depth + 1));
        expr_set_captures(out, sema_substitute_type_with_args(expr_get_captures(src), gp, args));
        return out;
    }
    expr_set_lhs(out, sema_substitute_const_generic_expr_with_args(expr_get_lhs(src), gp, args, depth + 1));
    expr_set_rhs(out, sema_substitute_const_generic_expr_with_args(expr_get_rhs(src), gp, args, depth + 1));
    if (k == ex_TERNARY()) {
        expr_set_args(out, sema_substitute_const_generic_expr_with_args(expr_get_args(src), gp, args, depth + 1));
    } else {
        expr_set_args(out, sema_substitute_const_generic_stmt_chain_with_args(expr_get_args(src), gp, args, depth + 1));
    }
    if (k == ex_ARRAY_LIT()) {
        expr_set_captures(out, sema_substitute_const_generic_expr_with_args(expr_get_captures(src), gp, args, depth + 1));
    } else if (expr_get_captures(src) != null) {
        expr_set_captures(out, sema_substitute_const_generic_expr_with_args(expr_get_captures(src), gp, args, depth + 1));
    }
    if (sema_const_i64_known(out)) {
        return sema_expr_int_lit(sema_const_i64_value(out));
    }
    return out;
}

public fn sema_substitute_type_with_args(ty: rawptr, gp: string, args: string) -> rawptr {
    if (ty == null || gp.len == 0 || args.len == 0) { return ty; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS()) {
        let name = tref_get_name(ty);
        let pack_base = sema_pack_index_base(name.clone());
        if (pack_base.len > 0 && generic_list_contains(gp, pack_base)) {
            let pack_idx = sema_pack_index_value(name.clone());
            if (pack_idx >= 0) {
                let packed_arg = generic_arg_at(args, pack_idx);
                if (packed_arg.len > 0) {
                    return sema_type_name_to_ref(packed_arg);
                }
            }
        }
        let concrete_name = sema_substitute_generic_type_text(name.clone(), gp, args);
        if (concrete_name != name) { return sema_type_name_to_ref(concrete_name); }
        return ty;
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return tref_alloc_ptr_like(k, sema_substitute_type_with_args(tref_pointee(ty), gp, args));
    }
    if (k == ty_ARRAY()) {
        let elem_sub = sema_substitute_type_with_args(tref_array_elem(ty), gp, args);
        let size_sub = sema_substitute_const_generic_expr_with_args(tref_array_size_expr(ty), gp, args, 0);
        if (sema_const_i64_known(size_sub)) {
            return tref_alloc_array(elem_sub, sema_const_i64_value(size_sub));
        }
        return tref_alloc_array_expr(elem_sub, size_sub);
    }
    if (k == ty_TUPLE()) {
        let count = tref_tuple_count(ty);
        var buf: rawptr = null;
        if (count > 0) {
            buf = vyx_frontend_alloc((count * 8) as u64);
            var i2: i64 = 0;
            while (i2 < count) {
                ast_write_rawptr(ptr_offset(buf, (i2 * 8) as i32),
                                 sema_substitute_type_with_args(tref_tuple_elem_at(ty, i2), gp, args));
                i2 = i2 + 1;
            }
        }
        return tref_alloc_tuple(buf, count);
    }
    if (k == ty_FN() || k == ty_CFN()) {
        let params_sub = sema_substitute_type_with_args(tref_fn_params(ty), gp, args);
        let ret_sub = sema_substitute_type_with_args(tref_fn_ret(ty), gp, args);
        if (k == ty_CFN()) { return tref_alloc_c_fn(params_sub, ret_sub); }
        return tref_alloc_fn(params_sub, ret_sub);
    }
    return ty;
}

fn where_generic_requires_trait(gp: string, gname: string, trait_name: string) -> bool {
    if (gname.len == 0 || trait_name.len == 0) { return false; }
    if (!string_contains(gp, "|where:")) { return false; }
    if (string_contains(gp, "all<" + gname + ">:" + trait_name)) { return true; }
    if (!string_contains(gp, gname + ":")) { return false; }
    if (string_contains(gp, gname + ":" + trait_name)) { return true; }
    if (string_contains(gp, "+" + trait_name)) { return true; }
    return false;
}

fn where_generic_requires_kind_struct(gp: string, gname: string) -> bool {
    if (gname.len == 0) { return false; }
    if (!string_contains(gp, "|where:")) { return false; }
    return string_contains(gp, gname + "::kind==\"struct\"");
}

fn where_generic_requires_kind_not_struct(gp: string, gname: string) -> bool {
    if (gname.len == 0) { return false; }
    if (!string_contains(gp, "|where:")) { return false; }
    return string_contains(gp, gname + "::kind!=\"struct\"");
}

fn sema_where_text(gp: string) -> string {
    let marker = "|where:";
    let pos = str_index_of(gp, marker);
    if (pos < 0) { return ""; }
    let start = pos + marker.len;
    var end = start;
    while (end < gp.len && gp.charAt(end) != 124) {
        end = end + 1;
    }
    if (end <= start) { return ""; }
    return str_view_range(gp, start, end);
}

fn type_name_is_generic(generics: string, ty: rawptr) -> bool {
    if (ty == null) { return false; }
    if (tref_get_kind(ty) != ty_CLASS()) { return false; }
    return generic_list_contains(generics, tref_get_name(ty));
}

fn type_ref_mentions_generic_params(generics: string, ty: rawptr) -> bool {
    if (ty == null || generics.len == 0) { return false; }
    let text = type_text_from_ty(ty);
    if (text.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 64) {
        let p = generic_param_at(generics, i);
        if (p.len == 0) { return false; }
        if (sema_type_text_contains_generic_atom(text, p)) { return true; }
        i = i + 1;
    }
    return false;
}

fn decl_has_template_head(d: rawptr) -> bool {
    let gp = decl_get_generic_params(d);
    let n = gp.len;
    if (n == 0) { return false; }
    if (gp.charAt(0) == 124) { return false; }
    return true;
}

fn sema_concrete_generic_name(name: string) -> bool {
    if (policy_primitive_type_kind(name) != 0) { return true; }
    if (name.len > 0 && !generic_name_looks_like_placeholder(name)) { return true; }
    return false;
}

fn sema_generic_args_closed(args: string) -> bool {
    if (args.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 64) {
        let part = generic_arg_at(args, i);
        if (part.len == 0) { return i > 0; }
        if (!sema_concrete_generic_name(part)) { return false; }
        i = i + 1;
    }
    return true;
}

fn sema_string_method_kind(name: string) -> i32 {
    return policy_string_method_kind(name);
}

fn sema_meta_is_full_concrete_spec(meta: string) -> bool {
    if (meta.len == 0 || meta.charAt(0) == 124) { return false; }
    var saw: bool = false;
    let n = meta.len;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= n) {
        if (i == n || meta.charAt(i) == 44 || meta.charAt(i) == 124) {
            let part = str_view_range(meta, start, i);
            if (part.len == 0) { return false; }
            if (!sema_concrete_generic_name(part)) { return false; }
            saw = true;
            if (i < n && meta.charAt(i) == 124) { return saw; }
            start = i + 1;
        }
        i = i + 1;
    }
    return saw;
}

fn sema_generic_params_prefix(meta: string) -> string {
    let n = meta.len;
    var i: i32 = 0;
    while (i < n) {
        if (meta.charAt(i) == 124) {
            return str_view_range(meta, 0, i);
        }
        i = i + 1;
    }
    return meta;
}

fn sema_specialized_class_key(name: string, meta: string) -> string {
    let args = sema_generic_params_prefix(meta);
    if (args.len == 0) { return name; }
    return name + "::<" + args + ">";
}

fn sym_find_full_spec_fn_same_args(head: rawptr, name: string, args: string) -> rawptr {
    var cur = head;
    while (cur != null) {
        if (sym_get_name(cur) == name) {
            let d = sym_get_decl(cur);
            if (d != null
                && sema_meta_is_full_concrete_spec(decl_get_generic_params(d))
                && sema_generic_params_prefix(decl_get_generic_params(d)) == args) {
                return cur;
            }
        }
        cur = sym_get_next(cur);
    }
    return null;
}

fn sema_first_return_expr(s: rawptr) -> rawptr {
    if (s == null) { return null; }
    let k = stmt_get_kind(s);
    if (k == st_RETURN()) { return stmt_get_init(s); }
    if (k == st_BLOCK()) {
        var cur = stmt_get_body(s);
        while (cur != null) {
            let found = sema_first_return_expr(cur);
            if (found != null) { return found; }
            cur = stmt_get_next(cur);
        }
    }
    if (k == st_IF()) {
        let found_then = sema_first_return_expr(stmt_get_then_blk(s));
        if (found_then != null) { return found_then; }
        return sema_first_return_expr(stmt_get_else_blk(s));
    }
    return null;
}

fn sema_last_expr_in_block(s: rawptr) -> rawptr {
    if (s == null || stmt_get_kind(s) != st_BLOCK()) { return null; }
    var cur = stmt_get_body(s);
    var last: rawptr = null;
    while (cur != null) {
        last = cur;
        cur = stmt_get_next(cur);
    }
    if (last != null && stmt_get_kind(last) == st_EXPR()) {
        return stmt_get_init(last);
    }
    if (last != null && stmt_get_kind(last) == st_RETURN()) {
        return stmt_get_init(last);
    }
    return null;
}

fn generic_lists_overlap(outer: string, inner: string) -> bool {
    if (outer.len == 0 || inner.len == 0) {
        return false;
    }
    let n = inner.len;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        if (i == n || inner.charAt(i as i32) == 44) {
            let part = str_view_range(inner, start as i32, i as i32);
            if (generic_list_contains(outer, part)) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn turbofish_start(name: string) -> i64 {
    let n = name.len;
    var i: i64 = 0;
    while (i + 2 < n) {
        if (name.charAt(i as i32) == 58
            && name.charAt((i + 1) as i32) == 58
            && name.charAt((i + 2) as i32) == 60) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

public fn generic_plain_angle_start(name: string) -> i64 {
    return policy_generic_plain_angle_start(name);
}

public fn generic_call_base(name: string) -> string {
    return policy_generic_call_base(name);
}

public fn generic_call_args(name: string) -> string {
    return policy_generic_call_args(name);
}

fn decl_has_where_marker(d: rawptr) -> bool {
    let gp = decl_get_generic_params(d);
    return string_contains(gp, "|where");
}

/// Canonical class name for symbol entry (short-name alias → underlying `Decl` name).
fn sym_class_canonical_name(entry: rawptr) -> string {
    if (entry == null) {
        return "";
    }
    let entry_name = sym_get_name(entry);
    if (policy_generic_call_has_args(entry_name) != 0) {
        return entry_name;
    }
    let d = sym_get_decl(entry);
    if (d == null) {
        return entry_name;
    }
    return decl_get_name(d);
}

// ════════════════════════════════════════════════════════════════════
//   Host builtins — names the hosted runtime exposes for free, so
//   unit sema must not flag them as unknown identifiers / calls.
//   Return-type table mirrors what `vyx_rt` / codegen emit.
// ════════════════════════════════════════════════════════════════════

fn is_host_builtin(name: string) -> bool {
    if (name == "assert") { return true; }
    if (name == "assert_eq") { return true; }
    if (name == "panic") { return true; }
    if (name == "sizeof") { return true; }
    if (name == "repr_sizeof") { return true; }
    if (name == "alignof") { return true; }
    if (name == "construct") { return true; }
    if (name == "alloc") { return true; }
    if (name == "dealloc") { return true; }
    if (name == "transmute") { return true; }
    if (name == "typeof") { return true; }
    if (name == "typeinfo") { return true; }
    if (name == "type_name") { return true; }
    if (name == "reflect_manifest") { return true; }
    if (name == "reflect_method_ptr_by_id") { return true; }
    if (name == "reflect_method_value") { return true; }
    if (name == "reflect_name") { return true; }
    if (name == "field_count") { return true; }
    if (name == "field_name") { return true; }
    if (name == "field_type") { return true; }
    if (name == "hash") { return true; }
    if (name == "compare") { return true; }
    if (name == "operator_eq" || name == "operator==") { return true; }
    if (name == "format") { return true; }
    if (name == "print") { return true; }
    if (name == "println") { return true; }
    if (name == "ct_file_size") { return true; }
    if (name == "argCount") { return true; }
    if (name == "getArg") { return true; }
    if (name == "malloc") { return true; }
    if (name == "realloc") { return true; }
    if (name == "free") { return true; }
    if (name == "memcpy") { return true; }
    if (name == "memmove") { return true; }
    if (name == "memcmp") { return true; }
    if (name == "memset") { return true; }
    if (name == "strlen") { return true; }
    if (name == "to_rawptr") { return true; }
    if (name == "ptr_offset") { return true; }
    if (name == "ptr_read_u8") { return true; }
    if (name == "ptr_read_i32") { return true; }
    if (name == "ptr_read_i64") { return true; }
    if (name == "ptr_write_i32") { return true; }
    if (name == "ptr_write_i64") { return true; }
    if (name == "from_cstr") { return true; }
    if (name == "from_cstr_len") { return true; }
    if (name == "from_cstr_view_len") { return true; }
    if (name == "from_raw_string_parts") { return true; }
    if (name == "int_to_string") { return true; }
    if (name == "bool_to_string") { return true; }
    return false;
}

fn sema_builtin_requires_type_layout(name: string) -> bool {
    if (name == "sizeof" || name == "repr_sizeof" || name == "alignof") { return true; }
    if (name == "field_count" || name == "field_name" || name == "field_type") { return true; }
    return false;
}

fn builtin_return_ty(name: string) -> rawptr {
    if (name == "assert") { return tref_create_kind(ty_VOID()); }
    if (name == "assert_eq") { return tref_create_kind(ty_VOID()); }
    if (name == "panic") { return tref_create_kind(ty_VOID()); }
    if (name == "sizeof") { return tref_create_kind(ty_I64()); }
    if (name == "repr_sizeof") { return tref_create_kind(ty_I64()); }
    if (name == "alignof") { return tref_create_kind(ty_I64()); }
    if (name == "construct") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "alloc") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "dealloc") { return tref_create_kind(ty_VOID()); }
    if (name == "transmute") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "typeof") { return tref_create_kind(ty_STRING()); }
    if (name == "typeinfo") { return tref_create_kind(ty_STRING()); }
    if (name == "type_name") { return tref_create_kind(ty_STRING()); }
    if (name == "reflect_manifest") { return tref_create_kind(ty_STRING()); }
    if (name == "reflect_method_ptr_by_id") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "reflect_method_value") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "reflect_name") { return tref_create_kind(ty_STRING()); }
    if (name == "field_count") { return tref_create_kind(ty_I32()); }
    if (name == "field_name") { return tref_create_kind(ty_STRING()); }
    if (name == "field_type") { return tref_create_kind(ty_STRING()); }
    if (name == "hash") { return tref_create_kind(ty_I64()); }
    if (name == "compare") { return tref_create_kind(ty_I32()); }
    if (name == "operator_eq" || name == "operator==") { return tref_create_kind(ty_BOOL()); }
    if (name == "format") { return tref_create_kind(ty_STRING()); }
    if (name == "print") { return tref_create_kind(ty_VOID()); }
    if (name == "println") { return tref_create_kind(ty_VOID()); }
    if (name == "ct_file_size") { return tref_create_kind(ty_I64()); }
    if (name == "malloc") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "realloc") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "free") { return tref_create_kind(ty_VOID()); }
    if (name == "memcpy") { return tref_create_kind(ty_VOID()); }
    if (name == "memmove") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "memcmp") { return tref_create_kind(ty_I32()); }
    if (name == "memset") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "strlen") { return tref_create_kind(ty_I64()); }
    if (name == "argCount") { return tref_create_kind(ty_I32()); }
    if (name == "getArg") { return tref_create_kind(ty_STRING()); }
    if (name == "to_rawptr") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "ptr_offset") { return tref_create_kind(ty_RAWPTR()); }
    if (name == "ptr_read_u8") { return tref_create_kind(ty_I32()); }
    if (name == "ptr_read_i32") { return tref_create_kind(ty_I32()); }
    if (name == "ptr_read_i64") { return tref_create_kind(ty_I64()); }
    if (name == "ptr_write_i32") { return tref_create_kind(ty_VOID()); }
    if (name == "ptr_write_i64") { return tref_create_kind(ty_VOID()); }
    if (name == "from_cstr") { return tref_create_kind(ty_STRING()); }
    if (name == "from_cstr_len") { return tref_create_kind(ty_STRING()); }
    if (name == "from_cstr_view_len") { return tref_create_kind(ty_STRING()); }
    if (name == "from_raw_string_parts") { return tref_create_kind(ty_STRING()); }
    if (name == "int_to_string") { return tref_create_kind(ty_STRING()); }
    if (name == "bool_to_string") { return tref_create_kind(ty_STRING()); }
    return tref_create_kind(ty_RAWPTR());
}

fn duplicate_flat_helper_allowed(name: string) -> bool {
    if (name == "malloc") { return true; }
    if (name == "free") { return true; }
    if (name == "memcpy") { return true; }
    if (name == "memset") { return true; }
    if (name == "strlen") { return true; }
    if (name == "ptr_read_u8") { return true; }
    if (name == "string_contains") { return true; }
    if (name == "generic_call_base") { return true; }
    if (name == "generic_call_args") { return true; }
    return false;
}

fn sema_is_reserved_user_class_name(name: string) -> bool {
    if (name == "Box") { return true; }
    if (name == "Ref") { return true; }
    if (name == "Scope") { return true; }
    if (name == "Weak") { return true; }
    return false;
}

fn sema_profile_mark(level: i32, label: string, start_ms: i64) -> i64 {
    if (level <= 0) { return start_ms; }
    let now = vyx_bootstrap_now_ms();
    print("[sema-prof] " + label + ": " + policy_i64_to_string(now - start_ms) + " ms");
    return now;
}

// Per-phase wall-time accumulators for the host analyze pipeline (printed at
// pipeline end under VYX_MIR_TIMING=1).  Phases run strictly in sequence, so
// the sums are disjoint wall time.
var g_sema_phase_sums: string = "";

fn sema_phase_enter() -> i64 {
    return vyx_bootstrap_now_ms();
}

fn sema_phase_done(label: string, start_ms: i64) {
    g_sema_phase_sums = g_sema_phase_sums + label + "="
                        + policy_i64_to_string(vyx_bootstrap_now_ms() - start_ms) + "ms ";
}

public fn sema_phase_sums_text() -> string {
    return g_sema_phase_sums;
}

public fn sema_phase_sums_reset() {
    g_sema_phase_sums = "";
}

fn sema_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn sema_env_enabled(name: string) -> bool {
    let value = sema_env_value(name).trim();
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE"
        || value == "no" || value == "NO" || value == "off" || value == "OFF") {
        return false;
    }
    return true;
}

fn sema_parse_i64(text: string) -> i64 {
    let s = text.trim();
    if (s.len == 0) { return 0; }
    var i: i32 = 0;
    var sign: i64 = 1;
    var out: i64 = 0;
    if (s.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (s.charAt(0) == 43) {
        i = 1;
    }
    while (i < s.len) {
        let c = s.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

var g_sema_resolve_timing_enabled: i32 = -1;
var g_sema_resolve_slow_threshold_ms: i64 = -1;

fn sema_resolve_timing_enabled() -> bool {
    if (g_sema_resolve_timing_enabled < 0) {
        if (sema_env_enabled("VYX_SEMA_RESOLVE_TIMING")) {
            g_sema_resolve_timing_enabled = 1;
        } else {
            g_sema_resolve_timing_enabled = 0;
        }
    }
    return g_sema_resolve_timing_enabled == 1;
}

fn sema_resolve_slow_threshold_ms() -> i64 {
    if (g_sema_resolve_slow_threshold_ms < 0) {
        let parsed = sema_parse_i64(sema_env_value("VYX_SEMA_SLOW_BODY_MS"));
        if (parsed > 0) {
            g_sema_resolve_slow_threshold_ms = parsed;
        } else {
            g_sema_resolve_slow_threshold_ms = 50;
        }
    }
    return g_sema_resolve_slow_threshold_ms;
}

fn sema_derive_token_char(c: i32) -> bool {
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 48 && c <= 57) { return true; }
    if (c == 95 || c == 46) { return true; }
    return false;
}

fn sema_derive_trait_key(name: string) -> string {
    let last = module_last_segment(name);
    if (last == "Hash") { return "Hashable"; }
    return last;
}

fn sema_derive_trait_matches(a: string, b: string) -> bool {
    return sema_derive_trait_key(a) == sema_derive_trait_key(b);
}

fn sema_decl_derives_trait(d: rawptr, trait_name: string) -> bool {
    if (d == null || trait_name.len == 0) { return false; }
    let meta = decl_get_meta(d);
    if (meta.len == 0) { return false; }
    if (string_contains(meta, "derive(")
        && !string_contains(meta, "|effect:derive|")) { return false; }
    let prefix = "derive(";
    var i: i32 = 0;
    while (i + prefix.len <= meta.len) {
        var hit: bool = true;
        var k: i32 = 0;
        while (k < prefix.len && hit) {
            if (meta.charAt(i + k) != prefix.charAt(k)) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            var j: i32 = i + (prefix.len as i32);
            var start: i32 = -1;
            while (j <= meta.len) {
                var c: i32 = 0;
                if (j < meta.len) { c = meta.charAt(j); }
                let is_tok = j < meta.len && sema_derive_token_char(c);
                if (is_tok && start < 0) {
                    start = j;
                } else if (!is_tok && start >= 0) {
                    let tok = str_view_range(meta, start, j);
                    if (sema_derive_trait_matches(tok, trait_name)) {
                        return true;
                    }
                    start = -1;
                }
                if (j < meta.len && (c == 41 || c == 93 || c == 124)) {
                    break;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

fn sema_expr_ident(name: string) -> rawptr {
    let e = expr_alloc(ex_IDENT());
    expr_set_name(e, name);
    return e;
}

fn sema_expr_int_lit(v: i64) -> rawptr {
    let e = expr_alloc(ex_INT_LIT());
    expr_set_int_val(e, v);
    expr_set_str_val(e, policy_i64_to_string(v));
    return e;
}

fn sema_expr_bool_lit(v: bool) -> rawptr {
    let e = expr_alloc(ex_BOOL_LIT());
    if (v) {
        expr_set_int_val(e, 1);
        expr_set_str_val(e, "true");
    } else {
        expr_set_int_val(e, 0);
        expr_set_str_val(e, "false");
    }
    return e;
}

fn sema_expr_string_lit(v: string) -> rawptr {
    let e = expr_alloc(ex_STR_LIT());
    expr_set_str_val(e, v);
    return e;
}

fn sema_expr_bin(op: i32, lhs: rawptr, rhs: rawptr) -> rawptr {
    let e = expr_alloc(ex_BIN());
    expr_set_op(e, op);
    expr_set_lhs(e, lhs);
    expr_set_rhs(e, rhs);
    return e;
}

fn sema_expr_assign(lhs: rawptr, rhs: rawptr) -> rawptr {
    let e = expr_alloc(ex_ASSIGN());
    expr_set_op(e, tk_EQ());
    expr_set_lhs(e, lhs);
    expr_set_rhs(e, rhs);
    return e;
}

fn sema_expr_member(lhs: rawptr, name: string) -> rawptr {
    let e = expr_alloc(ex_MEMBER());
    expr_set_lhs(e, lhs);
    expr_set_name(e, name);
    return e;
}

fn sema_arg_cell(value: rawptr) -> rawptr {
    let c = stmt_alloc(st_EXPR());
    stmt_set_init(c, value);
    return c;
}

fn sema_arg_append(head: rawptr, cell: rawptr) -> rawptr {
    if (head == null) { return cell; }
    var cur = head;
    while (stmt_get_next(cur) != null) {
        cur = stmt_get_next(cur);
    }
    stmt_set_next(cur, cell);
    return head;
}

fn sema_expr_call(callee: rawptr, args: rawptr) -> rawptr {
    let e = expr_alloc(ex_CALL());
    expr_set_lhs(e, callee);
    expr_set_args(e, args);
    return e;
}

fn sema_expr_method_call(receiver: rawptr, name: string, args: rawptr) -> rawptr {
    return sema_expr_call(sema_expr_member(receiver, name), args);
}

fn sema_expr_self_field(field_name: string) -> rawptr {
    return sema_expr_member(sema_expr_ident("self"), field_name);
}

fn sema_expr_other_field(field_name: string) -> rawptr {
    return sema_expr_member(sema_expr_ident("other"), field_name);
}

fn sema_stmt_return(value: rawptr) -> rawptr {
    let s = stmt_alloc(st_RETURN());
    stmt_set_init(s, value);
    return s;
}

fn sema_stmt_var(name: string, ty: rawptr, init: rawptr) -> rawptr {
    let s = stmt_alloc(st_VAR());
    stmt_set_name(s, name);
    stmt_set_ty(s, ty);
    stmt_set_init(s, init);
    return s;
}

fn sema_stmt_expr(value: rawptr) -> rawptr {
    let s = stmt_alloc(st_EXPR());
    stmt_set_init(s, value);
    return s;
}

fn sema_stmt_block(body: rawptr) -> rawptr {
    let s = stmt_alloc(st_BLOCK());
    stmt_set_body(s, body);
    return s;
}

fn sema_stmt_if_return(cond: rawptr, ret_value: rawptr) -> rawptr {
    let s = stmt_alloc(st_IF());
    stmt_set_cond(s, cond);
    stmt_set_then_blk(s, sema_stmt_block(sema_stmt_return(ret_value)));
    return s;
}

fn sema_stmt_append(head: rawptr, stmt: rawptr) -> rawptr {
    if (head == null) { return stmt; }
    var cur = head;
    while (stmt_get_next(cur) != null) {
        cur = stmt_get_next(cur);
    }
    stmt_set_next(cur, stmt);
    return head;
}

fn sema_struct_init_add_field(head: rawptr,
                              field_name: string,
                              value: rawptr) -> rawptr {
    let cell = stmt_alloc(st_EXPR());
    stmt_set_name(cell, field_name);
    stmt_set_init(cell, value);
    return sema_arg_append(head, cell);
}

fn sema_expr_struct_init(type_name: string, fields: rawptr) -> rawptr {
    let e = expr_alloc(ex_STRUCT_INIT());
    expr_set_name(e, type_name);
    expr_set_args(e, fields);
    return e;
}

fn sema_expr_call_ident(name: string, args: rawptr) -> rawptr {
    return sema_expr_call(sema_expr_ident(name), args);
}

fn sema_hash_mix(acc: rawptr, hv: rawptr) -> rawptr {
    return sema_expr_bin(
        tk_PLUS(),
        sema_expr_bin(tk_STAR(), acc, sema_expr_int_lit(31)),
        hv);
}

fn sema_match_arm(pattern: rawptr, body: rawptr) -> rawptr {
    let arm = stmt_alloc(st_EXPR());
    stmt_set_init(arm, pattern);
    stmt_set_body(arm, body);
    return arm;
}

fn sema_match_default_arm(body: rawptr) -> rawptr {
    let null_pat = expr_alloc(ex_NULL_LIT());
    expr_set_name(null_pat, "__match_default");
    return sema_match_arm(null_pat, body);
}

fn sema_stmt_match(scrutinee: rawptr, arms: rawptr) -> rawptr {
    let s = stmt_alloc(st_MATCH());
    stmt_set_init(s, scrutinee);
    stmt_set_body(s, arms);
    return s;
}

fn sema_decl_self_type_name(cd: rawptr) -> string {
    if (cd == null) { return ""; }
    let base = decl_get_name(cd);
    let gp = generic_param_head(decl_get_generic_params(cd));
    if (gp.len == 0) { return base; }
    return base + "::<" + gp + ">";
}

fn sema_decl_is_constructor(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (decl_get_name(d) != "constructor") { return false; }
    return string_contains(decl_get_generic_params(d), "|kind:constructor");
}

fn sema_decl_mark_trait_impl(cd: rawptr, trait_name: string) {
    if (cd == null || trait_name.len == 0) { return; }
    let key = sema_derive_trait_key(trait_name);
    let gp = decl_get_generic_params(cd);
    if (string_contains(gp, "|impl:" + key + ",")
        || string_contains(gp, "|" + key + ",")
        || string_contains(gp, key + ",")) {
        return;
    }
    decl_set_generic_params(cd, gp + "|impl:" + key + ",");
}

// ════════════════════════════════════════════════════════════════════
//   Sema — analyser state. Lives only as a local inside `analyze_unit`;
//   never escapes to a caller via `as rawptr`. The relevant counters
//   are serialized into a malloc'd handle right before return.
// ════════════════════════════════════════════════════════════════════

public class Sema {
    public classes_buf: rawptr
    public class_count: i32
    public funcs_buf: rawptr
    public func_count: i32
    public cur_locals: rawptr
    public locals_count: i32
    /// Hidden function-lifetime guards for references captured by closures.
    /// Kept outside cur_locals so a closure moved out of a nested block cannot
    /// shorten the captured region to the closure's definition block.
    public capture_borrow_guards: rawptr
    public moved_buf: rawptr
    public moved_count: i32
    public error_count: i32
    public cur_ret_ty: rawptr
    public loop_depth: i32
    public cur_generic_params: string
    public cur_owner_class: string
    public cur_owner_decl: rawptr
    /// Function/method whose body is being typed. Namespace for `use` sugar.
    public cur_body_decl: rawptr
    /// Module of the unit currently receiving collect/signature passes.
    public cur_chunk_module: string
    public in_imported_scope: bool
    /// Nested `unsafe { }` / `unsafe let|var` depth. Ownership diagnostics
    /// (E3100 / E3101) are suppressed while this is positive.
    public unsafe_depth: i32
    /// File/translation-unit `module a.b.c;` path (mirrors `currentModule_` / decl scoping baseline).
    public file_module: string
    /// Registry snapshot built by the driver: `module<TAB>path` per line.
    public import_registry: string
    /// Root unit currently being analyzed; lazy-loaded modules append here.
    public current_unit: rawptr
    /// Tail of `current_unit` for O(1) append.
    public current_tail: rawptr
    /// Pending module queue, newline-separated.
    public pending_imports: string
    /// Modules currently in-flight during lazy load (`M:`/`F:`/`M:#` keys).
    public loading_imports: rawptr
    /// Modules already materialized (module-name keys).
    public loaded_imports: rawptr
    /// Files already parsed and appended by the lazy loader (normalized path keys).
    public loaded_paths: rawptr
    /// Exact type layouts force-merged after a path-level partial load.
    public forced_layout_targets: rawptr
    /// Stable positive/negative states for layout targets and target/path pairs.
    /// Unlike the general lazy-symbol cache, the registry is immutable for one
    /// Sema run, so layout misses never need epoch invalidation.
    public layout_load_cache: rawptr
    /// Negative cache for symbol-triggered lazy loads. Cleared whenever a
    /// module is materialized so misses cannot become stale.
    public lazy_symbol_miss_cache: rawptr
    /// Changes before lazy import passes may mutate symbols, aliases or use
    /// scopes. Only compared across one synchronous module-load attempt;
    /// this is not a global cache key for all semantic queries.
    public lazy_import_epoch: i64
    /// Cache for "does any currently pending import export this symbol?".
    /// Values are invalidated together with lazy_symbol_miss_cache whenever
    /// pending/module state changes in a way that can reveal new symbols.
    public lazy_pending_symbol_cache: rawptr
    /// Signature type refs already walked in the current lazy-load epoch.
    /// Cleared whenever a module is materialized because newly available
    /// declarations can make an earlier no-op type walk useful again.
    public lazy_type_ref_cache: rawptr
    public profile_lazy_sig_decl_count: i64
    public profile_lazy_type_ref_calls: i64
    public profile_lazy_pending_calls: i64
    public profile_registry_symbol_queries: i64
    public profile_registry_symbol_ms: i64
    public profile_module_load_calls: i64
    public profile_module_load_ms: i64
    /// PLAN_SEMA_ROOT_FIX S4/S5 sidecar — mirror of `vyx::Sema::monoScheduler_`.
    /// Opaque handle managed by `bootstrap.mono_scheduler`; lifetime tied
    /// to this Sema instance, released by `analyze_unit`.
    public mono_scheduler: rawptr
    /// PLAN_SEMA_ROOT_FIX S2/S3 sidecar — mirror of `vyx::Sema::factBase_`.
    /// Opaque handle managed by `bootstrap.fact_base`; populated by
    /// `host_analyze_phase_a_primitive_impl_facts` and frozen only after
    /// lazy-loaded modules finish materializing so late registrants still
    /// land in the same fact table. Released by `analyze_unit` on the way out.
    public fact_base: rawptr
    /// MOSP fact-dimension ledger.  Attributes are normalized here before
    /// lowering; handlers only receive registered schemas and never execute
    /// source text during this collection pass.
    public effect_plan: rawptr
    /// R5 lang-item registry sidecar — mirror of `vyx::Sema::langItems_`.
    /// Opaque handle managed by `bootstrap.lang_items`; populated by
    /// `host_analyze_scan_lang_item_attributes`, consulted by future
    /// derive / auto-wrap / `?`-sugar passes. Released by `analyze_unit`.
    public lang_items: rawptr
    /// Controls human-facing analysis telemetry. IR dump modes disable this
    /// so stdout remains a clean HIR/MIR stream.
    public emit_stats: bool
    /// Enables the stronger Sema walk required before building executable HIR.
    public prepare_hir_facts: bool
    public prepare_imported_hir_facts: bool
    public hir_fact_root_names: string
    /// During `lhs |> call(...)`, Sema scores the right-hand call as if `lhs`
    /// were its first argument. HIR/MIR keep the AST unchanged and inject the
    /// prefix value during lowering, so this context is deliberately transient.
    public pipe_call_context: rawptr
    public pipe_prefix_expr: rawptr
    /// LHS of the assignment currently being resolved, if any. Used so
    /// `place = place.consuming_method(...)` can move a field out of
    /// `&mut self` / C++-this and write it back in the same statement.
    public pending_reinit_place: rawptr
    /// Partial moves of `local.field` via `mut self` / `own self` methods.
    /// The parent local stays usable as a place so the field can be written
    /// back; using the local as a value while any field is still moved is
    /// E3100.
    public field_moved_buf: rawptr
    public place_depth: i32
    public resolving_assign_lhs: bool
    public diag_src_cache_path: string
    public diag_src_cache_text: string

    public static fn create() -> Sema {
        let sched = mono_scheduler_alloc();
        let fb = fact_base_alloc();
        let li = lang_items_alloc();
        return Sema {
            classes_buf: null,
            class_count: 0,
            funcs_buf: null,
            func_count: 0,
            cur_locals: null,
            locals_count: 0,
            capture_borrow_guards: null,
            moved_buf: null,
            moved_count: 0,
            error_count: 0,
            cur_ret_ty: null,
            loop_depth: 0,
            cur_generic_params: "",
            cur_owner_class: "",
            cur_owner_decl: null,
            cur_body_decl: null,
            cur_chunk_module: "",
            in_imported_scope: false,
            unsafe_depth: 0,
            file_module: "",
            import_registry: "",
            current_unit: null,
            current_tail: null,
            pending_imports: "",
            loading_imports: sema_string_state_map_create(8192),
            loaded_imports: sema_string_state_map_create(8192),
            loaded_paths: sema_string_state_map_create(8192),
            forced_layout_targets: sema_string_state_map_create(8192),
            layout_load_cache: sema_string_state_map_create(8192),
            lazy_symbol_miss_cache: sema_string_state_map_create(8192),
            lazy_import_epoch: 0,
            lazy_pending_symbol_cache: sema_string_state_map_create(8192),
            lazy_type_ref_cache: sema_string_state_map_create(8192),
            profile_lazy_sig_decl_count: 0,
            profile_lazy_type_ref_calls: 0,
            profile_lazy_pending_calls: 0,
            profile_registry_symbol_queries: 0,
            profile_registry_symbol_ms: 0,
            profile_module_load_calls: 0,
            profile_module_load_ms: 0,
            mono_scheduler: sched,
            fact_base: fb,
            effect_plan: effect_plan_alloc(),
            lang_items: li,
            emit_stats: true,
            prepare_hir_facts: false,
            prepare_imported_hir_facts: true,
            hir_fact_root_names: "",
            pipe_call_context: null,
            pipe_prefix_expr: null,
            pending_reinit_place: null,
            field_moved_buf: null,
            place_depth: 0,
            resolving_assign_lhs: false,
            diag_src_cache_path: "",
            diag_src_cache_text: ""
        };
    }

    public fn sema_module_matches(self, requested: string, actual: string) -> bool {
        if (requested.len == 0 || actual.len == 0) { return false; }
        if (policy_module_selector_index(requested) >= 0) {
            return requested == actual;
        }
        if (requested == actual) { return true; }
        if (actual.len > requested.len + 1
            && actual.startsWith(requested)
            && actual.charAt(requested.len) == 46) {
            return true;
        }
        return false;
    }

    public fn sema_loaded_module_covers_request(self, loaded: string, requested: string) -> bool {
        if (loaded.len == 0 || requested.len == 0) { return false; }
        return loaded == requested;
    }


public fn sema_registry_line_module(self, line: string) -> string {
        var i: i32 = 0;
        while (i < line.len) {
            if (line.charAt(i) == 9) {
                return str_view_range(line, 0, i);
            }
            i = i + 1;
        }
        return "";
    }

    public fn sema_registry_line_path(self, line: string) -> string {
        var i: i32 = 0;
        while (i < line.len) {
            if (line.charAt(i) == 9) {
                let start = i + 1;
                var j: i32 = start;
                while (j < line.len && line.charAt(j) != 9) {
                    j = j + 1;
                }
                return str_view_range(line, start, j);
            }
            i = i + 1;
        }
        return "";
    }

    public fn sema_path_stem(self, path: string) -> string {
        if (path.len == 0) { return ""; }
        var start: i32 = 0;
        var dot: i32 = path.len as i32;
        var i: i32 = 0;
        while (i < path.len) {
            let c = path.charAt(i);
            if (c == 47 || c == 92) {
                start = i + 1;
                dot = path.len as i32;
            } else if (c == 46) {
                dot = i;
            }
            i = i + 1;
        }
        if (dot < start) { dot = path.len as i32; }
        return str_view_range(path, start, dot);
    }

    public fn sema_registry_line_symbols(self, line: string) -> string {
        var tabs: i32 = 0;
        var i: i32 = 0;
        while (i < line.len) {
            if (line.charAt(i) == 9) {
                tabs = tabs + 1;
                if (tabs == 2) {
                    return str_view_range(line, i + 1, line.len);
                }
            }
            i = i + 1;
        }
        return "";
    }


public fn sema_registry_line_has_symbol(self, line: string, sym: string) -> bool {
        if (sym.len == 0) { return false; }
        let symbols = self.sema_registry_line_symbols(line);
        if (symbols.len == 0) { return false; }
        return string_contains(symbols, intern_cat3("|", sym, "|"));
    }

    public fn sema_registry_request_matches_line(self, mod: string, line: string) -> bool {
        if (mod.len == 0 || line.len == 0) { return false; }
        let lm = self.sema_registry_line_module(line);
        if (policy_module_selector_index(mod) >= 0) {
            return lm == mod;
        }
        if (self.sema_module_matches(mod, lm)) { return true; }
        if (policy_module_selector_index(lm) >= 0) { return false; }
        let req_stem = module_last_segment(mod);
        if (req_stem.len == 0) { return false; }
        let path_stem = self.sema_path_stem(self.sema_registry_line_path(line));
        return path_stem.len > 0 && req_stem == path_stem;
    }

    /// Namespace of the body being typed. Same-named modules merge, so this is
    /// the C# namespace of the current chunk — not the package entry file.

public fn sema_scope_module(self) -> string {
        if (self.cur_chunk_module.len > 0) {
            return policy_module_base(self.cur_chunk_module);
        }
        if (self.cur_body_decl != null) {
            let body_mod = self.decl_source_module(self.cur_body_decl, self.cur_owner_decl);
            if (body_mod.len > 0) { return policy_module_base(body_mod); }
        }
        if (self.cur_owner_decl != null) {
            let owner_mod = self.decl_source_module(self.cur_owner_decl, null);
            if (owner_mod.len > 0) { return policy_module_base(owner_mod); }
        }
        return policy_module_base(self.file_module);
    }


public fn sema_use_decl_in_scope(self, d: rawptr, scope: string) -> bool {
        if (d == null) { return false; }
        let from = self.extract_from_module(decl_get_meta(d));
        if (from.len > 0) {
            return policy_module_base(from) == scope;
        }
        if (decl_marked_imported(d)) { return false; }
        return policy_module_base(self.file_module) == scope;
    }


public fn sema_type_canonical_name(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        let name = generic_call_base(decl_get_name(d));
        if (name.len == 0) { return ""; }
        // A binding module groups declarations; the producer owns their type
        // identity. Its exact DCI name is not a new Vyx module-local class.
        if (self.decl_is_foreign_dci(d)) { return name; }
        if (string_contains(name, ".")) { return name; }
        let mod = policy_module_base(self.decl_source_module(d, null));
        if (mod.len > 0) { return intern_dot(mod, name); }
        return name;
    }


public fn sema_namespace_exists(self, mod: string) -> bool {
        if (mod.len == 0) { return false; }
        if (self.sema_pending_has(mod) || self.sema_loaded_covers(mod)) { return true; }
        if (self.current_unit != null) {
            var dcur = unit_get_decls(self.current_unit);
            while (dcur != null) {
                if (decl_get_kind(dcur) == de_MODULE()) {
                    if (policy_module_base(decl_get_name(dcur)) == mod) { return true; }
                }
                dcur = decl_get_next(dcur);
            }
        }
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null
                && (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM())) {
                if (policy_module_base(self.decl_source_module(d, null)) == mod) { return true; }
            }
            scan = sym_get_next(scan);
        }
        var fscan = self.funcs_buf;
        while (fscan != null) {
            let fd = sym_get_decl(fscan);
            if (fd != null && policy_module_base(self.decl_source_module(fd, null)) == mod) {
                return true;
            }
            fscan = sym_get_next(fscan);
        }
        if (self.import_registry.len == 0) { return false; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (policy_module_base(self.sema_registry_line_module(line)) == mod) { return true; }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }


public fn sema_is_namespace_prefix(self, prefix: string) -> bool {
        if (prefix.len == 0) { return false; }
        if (self.sema_namespace_exists(prefix.clone())) { return true; }
        let child_pat = prefix + ".";
        if (self.current_unit != null) {
            var dcur = unit_get_decls(self.current_unit);
            while (dcur != null) {
                if (decl_get_kind(dcur) == de_MODULE()) {
                    let mn = policy_module_base(decl_get_name(dcur));
                    if (mn.len > child_pat.len && mn.startsWith(child_pat)) { return true; }
                }
                dcur = decl_get_next(dcur);
            }
        }
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null) {
                let sm = policy_module_base(self.decl_source_module(d, null));
                if (sm.len > child_pat.len && sm.startsWith(child_pat)) { return true; }
            }
            scan = sym_get_next(scan);
        }
        if (self.import_registry.len == 0) { return false; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let lm = policy_module_base(self.sema_registry_line_module(str_view_range(self.import_registry, start, i)));
                if (lm == prefix || (lm.len > child_pat.len && lm.startsWith(child_pat))) { return true; }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    /// Exact module path in pending/loaded/unit/registry. No class-table scan.
    ///
    /// This is the single hottest predicate in the compiler: it is consulted for
    /// nearly every qualified name (~2.6e5 calls while analyzing
    /// src/core/sema.vyx).  The derived indexes below turn the two linear scans
    /// into O(1) membership tests.

public fn sema_module_path_registered(self, mod: string) -> bool {
        if (mod.len == 0) { return false; }
        if (self.sema_pending_has(mod) || self.sema_loaded_covers(mod)) { return true; }
        if (self.current_unit != null) {
            self.sema_unit_module_names_cached();
            if (g_upr_map != null && sema_string_state_map_get(g_upr_map, mod.clone()) > 0) {
                return true;
            }
        }
        if (self.import_registry.len > 0) {
            self.sema_registry_module_bases_cached();
            if (g_rpr_map != null && sema_string_state_map_get(g_rpr_map, mod.clone()) > 0) {
                return true;
            }
        }
        return false;
    }

    /// Index of every `module` declaration's canonical base in the current unit.
    /// Rebuilt only when the unit's top-level decl count changes.
    fn sema_unit_module_names_cached(self) -> string {
        if (self.current_unit == null) { return ""; }
        let decl_count = unit_get_decl_count(self.current_unit);
        if (g_unit_mod_set.len > 0 && g_unit_mod_set_key == decl_count) {
            return g_unit_mod_set;
        }
        var out = "|";
        g_upr_map = sema_string_state_map_clear(g_upr_map);
        var dcur = unit_get_decls(self.current_unit);
        while (dcur != null) {
            if (decl_get_kind(dcur) == de_MODULE()) {
                let base = policy_module_base(decl_get_name(dcur));
                out = out + base + "|";
                if (base.len > 0 && g_upr_map != null) {
                    g_upr_map = sema_string_state_map_put(g_upr_map, base.clone(), (1 as i32));
                }
            }
            dcur = decl_get_next(dcur);
        }
        g_unit_mod_set = out;
        g_unit_mod_set_key = decl_count;
        return out;
    }

    /// Index of every canonical module base present in the import registry.
    /// The registry is bound exactly once per analysis (see
    /// analyze_unit_with_registry_options_codegen_roots) and never mutated, so
    /// building this once is exact.
    fn sema_registry_module_bases_cached(self) -> string {
        if (g_registry_mod_set.len > 0) { return g_registry_mod_set; }
        var out = "|";
        g_rpr_map = sema_string_state_map_clear(g_rpr_map);
        if (self.import_registry.len > 0) {
            var start: i32 = 0;
            var i: i32 = 0;
            while (i <= self.import_registry.len) {
                if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                    let line = str_view_range(self.import_registry, start, i);
                    let lm = policy_module_base(self.sema_registry_line_module(line));
                    if (lm.len > 0) {
                        out = out + lm + "|";
                        if (g_rpr_map != null) {
                            g_rpr_map = sema_string_state_map_put(g_rpr_map, lm.clone(), (1 as i32));
                        }
                    }
                    start = i + 1;
                }
                i = i + 1;
            }
        }
        g_registry_mod_set = out;
        return out;
    }

    /// Registry query only: exact module line lists `name`. Never parses.

public fn sema_registry_module_exports_symbol(self, mod: string, name: string) -> bool {
        return self.ri_module_exports_symbol(mod.clone(), name.clone());
        if (self.import_registry.len == 0 || mod.len == 0 || name.len == 0) { return false; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (policy_module_base(self.sema_registry_line_module(line)) == mod
                    && self.sema_registry_line_has_symbol(line, name)) {
                    return true;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    /// `Module.Type` (class/enum in that module), not a registered module path.
    public fn sema_name_is_type_path(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        let base = generic_call_base(name.clone());
        if (base.len == 0) { return false; }
        if (self.sema_lookup_class_canonical(base.clone()) != null) { return true; }
        let parent = module_parent_path(base.clone());
        let short = module_last_segment(base.clone());
        if (parent.len == 0 || short.len == 0 || short == base) { return false; }
        if (self.sema_module_path_registered(base.clone())) { return false; }
        if (self.sema_find_func_symbol_in_module(short.clone(), parent.clone()) != null) {
            return false;
        }
        if (self.sema_named_in_module(parent.clone(), short.clone())) { return true; }
        return self.sema_registry_module_exports_symbol(parent.clone(), short.clone());
    }

    /// True if `mod` declares type/func `name`. A child *module* `mod.name` is
    /// not an export of `mod`; glob `use mod.name` binds names *from* that child.

public fn sema_module_exports_name(self, mod: string, name: string) -> bool {
        if (mod.len == 0 || name.len == 0) { return false; }
        if (self.sema_named_in_module(mod.clone(), name.clone())) { return true; }
        return self.sema_registry_module_exports_symbol(mod.clone(), name.clone());
    }


    fn ci_index_node(self, node: rawptr) {
        let d = sym_get_decl(node);
        if (d == null) { return; }
        let kind = decl_get_kind(d);
        if (kind != de_CLASS() && kind != de_ENUM()) { return; }
        let cname = generic_call_base(decl_get_name(d));
        let sname = generic_call_base(sym_get_name(node));
        ci_chain_add(cname.clone(), node);
        if (sname != cname) { ci_chain_add(sname.clone(), node); }
        let canonical = self.sema_type_canonical_name(d);
        if (canonical != cname && canonical != sname) { ci_chain_add(canonical.clone(), node); }
        let cshort = module_last_segment(cname.clone());
        let sshort = module_last_segment(sname.clone());
        if (cshort.len > 0) { cs_chain_add(cshort.clone(), node); }
        if (sshort.len > 0 && sshort != cshort) { cs_chain_add(sshort.clone(), node); }
    }

    /// Bring the index up to date with `self.classes_buf`.  New symbols sit
    /// at the front of the chain, so only that prefix is visited; indexing it
    /// from the oldest node forward keeps every per-name chain in buffer
    /// order.  Entries are appended to a chain by prepending its cell, so the
    /// replay below sees exactly the order the linear scan used to produce.
    fn ci_kick(self) {
        if (g_ci_map == null) {
            g_ci_map = sema_string_state_map_create(16384);
            g_ci_head = null;
            g_ci_cell_count = 0;
        }
        if (g_cs_map == null) {
            g_cs_map = sema_string_state_map_create(16384);
            g_cs_cell_count = 0;
        }
        if (self.classes_buf == g_ci_head) { return; }
        var n: i64 = 0;
        var cur = self.classes_buf;
        while (cur != null && cur != g_ci_head) {
            ci_seen_reserve(n + 1);
            if (g_ci_seen == null) { return; }
            ast_write_rawptr(ptr_offset(g_ci_seen, n * 8), cur);
            n = n + 1;
            cur = sym_get_next(cur);
        }
        var i: i64 = n;
        while (i > 0) {
            i = i - 1;
            self.ci_index_node(ast_read_rawptr(ptr_offset(g_ci_seen, i * 8)));
        }
        g_ci_head = self.classes_buf;
    }

    /// Index-backed `sema_lookup_class_canonical`.  The chain holds exactly
    /// the entries whose short name, symbol key or canonical name equals
    /// `want`, in buffer order, so this fold is the original scan restricted
    /// to its matches.
    fn sema_lookup_class_canonical_indexed(self, want: string) -> rawptr {
        self.ci_kick();
        if (g_ci_map == null) { return null; }
        let found = sema_string_state_map_get(g_ci_map, want.clone());
        if (found <= 0) { return null; }
        var best: rawptr = null;
        var best_module: string = "";
        var idx: i64 = (found as i64) - 1;
        while (idx >= 0) {
            let node = ci_cell_node(idx);
            let d = sym_get_decl(node);
            if (d != null) {
                let candidate_module = self.decl_source_module(d, null);
                if (best == null) {
                    best = node;
                    best_module = candidate_module;
                } else if (self.sema_versioned_module_pair(candidate_module.clone(), best_module.clone())) {
                    let version_cmp = policy_semver_compare(
                        policy_module_version(candidate_module.clone()),
                        policy_module_version(best_module.clone()));
                    if (version_cmp > 0
                        || (version_cmp == 0
                            && self.sema_layout_decl_score(d)
                                > self.sema_layout_decl_score(sym_get_decl(best)))) {
                        best = node;
                        best_module = candidate_module;
                    }
                } else if (candidate_module == best_module
                    && self.sema_layout_decl_score(d)
                        > self.sema_layout_decl_score(sym_get_decl(best))) {
                    best = node;
                }
            }
            idx = ci_cell_next(idx);
        }
        return best;
    }

    /// Full-chain fallback for `cs_local_short_candidate`, kept so the
    /// index is an optimisation and never a behavioural dependency: if the
    /// index could not be allocated the original scan still runs.
    fn cs_local_short_scan(self, base: string, scope: string) -> rawptr {
        var scan = self.classes_buf;
        while (scan != null) {
            let candidate_decl = sym_get_decl(scan);
            if (candidate_decl != null
                && (decl_get_kind(candidate_decl) == de_CLASS()
                    || decl_get_kind(candidate_decl) == de_ENUM())) {
                let sm = policy_module_base(self.decl_source_module(candidate_decl, null));
                let same_chunk = sm.len > 0 && sm == scope;
                if (!decl_marked_imported(candidate_decl) || same_chunk) {
                    let candidate_name = generic_call_base(decl_get_name(candidate_decl));
                    let symbol_name = generic_call_base(sym_get_name(scan));
                    if (candidate_name == base || symbol_name == base) {
                        return scan;
                    }
                    let cand_short = module_last_segment(candidate_name.clone());
                    if (cand_short == base && (sm.len == 0 || same_chunk)) {
                        return scan;
                    }
                }
            }
            scan = sym_get_next(scan);
        }
        return null;
    }

    /// Index-backed `sema_find_local_short_class_symbol`.  The short-name
    /// chain holds exactly the nodes that predicate can accept, in buffer
    /// order, so folding it yields the same first match as the full scan.
    fn cs_local_short_candidate(self, base: string, scope: string) -> rawptr {
        self.ci_kick();
        if (g_cs_map == null) { return self.cs_local_short_scan(base.clone(), scope.clone()); }
        let found = sema_string_state_map_get(g_cs_map, base.clone());
        if (found <= 0) { return null; }
        var idx: i64 = (found as i64) - 1;
        while (idx >= 0) {
            let node = cs_cell_node(idx);
            let candidate_decl = sym_get_decl(node);
            if (candidate_decl != null
                && (decl_get_kind(candidate_decl) == de_CLASS()
                    || decl_get_kind(candidate_decl) == de_ENUM())) {
                let sm = policy_module_base(self.decl_source_module(candidate_decl, null));
                let same_chunk = sm.len > 0 && sm == scope;
                if (!decl_marked_imported(candidate_decl) || same_chunk) {
                    let candidate_name = generic_call_base(decl_get_name(candidate_decl));
                    let symbol_name = generic_call_base(sym_get_name(node));
                    if (candidate_name == base || symbol_name == base) {
                        return node;
                    }
                    let cand_short = module_last_segment(candidate_name.clone());
                    if (cand_short == base && (sm.len == 0 || same_chunk)) {
                        return node;
                    }
                }
            }
            idx = cs_cell_next(idx);
        }
        return null;
    }

    /// Full-chain fallback for `cs_imported_unique_short_candidate`.
    fn cs_imported_unique_short_scan(self, want: string) -> rawptr {
        var found: rawptr = null;
        var found_fq: string = "";
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null
                && (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM())) {
                let gp = decl_get_generic_params(d);
                if (!string_contains(gp, "|kind:impl")
                    && !string_contains(gp, "|kind:interface")) {
                    let dn = generic_call_base(decl_get_name(d));
                    let sn = generic_call_base(sym_get_name(scan));
                    if (module_last_segment(dn.clone()) == want
                        || module_last_segment(sn.clone()) == want) {
                        var fq = sn.clone();
                        if (dn.len > fq.len) { fq = dn.clone(); }
                        if (found == null) {
                            found = scan;
                            found_fq = fq;
                        } else if (found_fq != fq
                                   && !sema_name_matches_qualified_or_short(found_fq, fq)) {
                            return null;
                        }
                    }
                }
            }
            scan = sym_get_next(scan);
        }
        return found;
    }

    /// Index-backed `sema_find_imported_unique_short_class_symbol`.  The
    /// ambiguity verdict needs every match, and the chain supplies exactly
    /// those in buffer order, so the fold is order-identical.
    fn cs_imported_unique_short_candidate(self, want: string) -> rawptr {
        self.ci_kick();
        if (g_cs_map == null) { return self.cs_imported_unique_short_scan(want.clone()); }
        let found_slot = sema_string_state_map_get(g_cs_map, want.clone());
        if (found_slot <= 0) { return null; }
        var found: rawptr = null;
        var found_fq: string = "";
        var idx: i64 = (found_slot as i64) - 1;
        while (idx >= 0) {
            let scan = cs_cell_node(idx);
            let d = sym_get_decl(scan);
            if (d != null
                && (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM())) {
                let gp = decl_get_generic_params(d);
                if (!string_contains(gp, "|kind:impl")
                    && !string_contains(gp, "|kind:interface")) {
                    let dn = generic_call_base(decl_get_name(d));
                    let sn = generic_call_base(sym_get_name(scan));
                    if (module_last_segment(dn.clone()) == want
                        || module_last_segment(sn.clone()) == want) {
                        var fq = sn.clone();
                        if (dn.len > fq.len) { fq = dn.clone(); }
                        if (found == null) {
                            found = scan;
                            found_fq = fq;
                        } else if (found_fq != fq
                                   && !sema_name_matches_qualified_or_short(found_fq, fq)) {
                            return null;
                        }
                    }
                }
            }
            idx = cs_cell_next(idx);
        }
        return found;
    }

    /// Bring the function index up to date with `self.funcs_buf`.  Same
    /// prefix replay as the class index: new symbols sit at the front, so
    /// only that prefix is visited, oldest first, which keeps every
    /// per-name chain in buffer order and every position monotone.
    fn cf_kick(self) {
        if (g_cf_map == null) {
            g_cf_map = sema_string_state_map_create(8192);
            g_cf_head = null;
            g_cf_cell_count = 0;
            g_cf_next_pos = 0;
        }
        if (self.funcs_buf == g_cf_head) { return; }
        var n: i64 = 0;
        var cur = self.funcs_buf;
        while (cur != null && cur != g_cf_head) {
            cf_seen_reserve(n + 1);
            if (g_cf_seen == null) { return; }
            ast_write_rawptr(ptr_offset(g_cf_seen, n * 8), cur);
            n = n + 1;
            cur = sym_get_next(cur);
        }
        var i: i64 = n;
        while (i > 0) {
            i = i - 1;
            let node = ast_read_rawptr(ptr_offset(g_cf_seen, i * 8));
            let sn = sym_get_name(node);
            let pos = g_cf_next_pos;
            g_cf_next_pos = pos + 1;
            if (sn.len > 0) { cf_chain_add(sn.clone(), node, pos); }
        }
        g_cf_head = self.funcs_buf;
    }

    /// Best cell of `key`'s chain whose declaration matches `module_name`.
    /// Every node in the chain already has `sym_get_name == key`, so this is
    /// exactly the original name test; the chain is in buffer order, so the
    /// first module match is also the earliest in buffer order.
    fn cf_chain_best(self, key: string, module_name: string) -> i64 {
        if (g_cf_map == null || key.len == 0) { return CI_NONE; }
        let found = sema_string_state_map_get(g_cf_map, key.clone());
        if (found <= 0) { return CI_NONE; }
        var idx: i64 = (found as i64) - 1;
        while (idx >= 0) {
            let node = cf_cell_node(idx);
            let d = sym_get_decl(node);
            if (self.sema_func_decl_matches_module(d, module_name)) {
                return idx;
            }
            idx = cf_cell_next(idx);
        }
        return CI_NONE;
    }

    /// Full-chain fallback for `cf_find_func_in_module`.  The original scan,
    /// kept so the index can never change behaviour, only cost.
    fn sema_find_func_symbol_in_module_scan(self, name: string, module_name: string) -> rawptr {
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        var cur = self.funcs_buf;
        while (cur != null) {
            let sn = sym_get_name(cur);
            if (sn == name || (base.len > 0 && sn == base) || (short.len > 0 && sn == short)) {
                let d = sym_get_decl(cur);
                if (self.sema_func_decl_matches_module(d, module_name)) {
                    return cur;
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    /// Index-backed `sema_find_func_symbol_in_module`.  The query expands to
    /// three symbol names; each chain yields its earliest module match, and
    /// the largest stored position is the earliest in `funcs_buf` order.
    fn cf_find_func_in_module(self, name: string, module_name: string) -> rawptr {
        self.cf_kick();
        if (g_cf_map == null) {
            return self.sema_find_func_symbol_in_module_scan(name.clone(), module_name.clone());
        }
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        var best_idx: i64 = CI_NONE;
        var best_pos: i64 = -1;
        let i1 = self.cf_chain_best(name.clone(), module_name.clone());
        if (i1 >= 0) { best_idx = i1; best_pos = cf_cell_pos(i1); }
        if (base.len > 0 && base != name) {
            let i2 = self.cf_chain_best(base.clone(), module_name.clone());
            if (i2 >= 0 && (best_idx < 0 || cf_cell_pos(i2) > best_pos)) {
                best_idx = i2;
                best_pos = cf_cell_pos(i2);
            }
        }
        if (short.len > 0 && short != name && short != base) {
            let i3 = self.cf_chain_best(short.clone(), module_name.clone());
            if (i3 >= 0 && (best_idx < 0 || cf_cell_pos(i3) > best_pos)) {
                best_idx = i3;
                best_pos = cf_cell_pos(i3);
            }
        }
        if (best_idx < 0) { return null; }
        return cf_cell_node(best_idx);
    }

    /// In-scope `use` prefixes of the current unit, memoised on the unit
    /// head plus the scope module.  The old per-query walk re-derived this
    /// set for every short name the resolver expanded.
    fn esn_use_prefixes(self, scope: string) -> string {
        if (self.current_unit == null) { return ""; }
        let head = unit_get_decls(self.current_unit);
        if (g_esn_ready && g_esn_unit == self.current_unit
            && g_esn_head == head && g_esn_scope == scope) {
            return g_esn_prefixes;
        }
        var out: string = "";
        var ucur = head;
        while (ucur != null) {
            if (decl_get_kind(ucur) == de_USE()
                && self.sema_use_decl_in_scope(ucur, scope.clone())) {
                if (sema_use_decl_alias_name(decl_get_meta(ucur)).len == 0) {
                    let prefix = generic_call_base(decl_get_name(ucur));
                    if (prefix.len > 0
                        && !string_contains("\n" + out.clone(), "\n" + prefix + "\n")) {
                        out = out + prefix + "\n";
                    }
                }
            }
            ucur = decl_get_next(ucur);
        }
        g_esn_unit = self.current_unit;
        g_esn_head = head;
        g_esn_scope = scope.clone();
        g_esn_prefixes = out.clone();
        g_esn_ready = true;
        return out;
    }

    /// Merge each registry module's symbol blobs once.  Lines are joined with
    /// a newline, which cannot occur inside a symbol name, so a membership
    /// probe can never match across a line boundary -- the merged blob answers
    /// exactly the disjunction of the original per-line probes.
    fn ri_ensure(self) {
        if (g_ri_map != null) { return; }
        g_ri_map = sema_string_state_map_create(1024);
        g_ri_ptrs = vyx_frontend_alloc((RI_MAX_MODULES * 8) as u64);
        g_ri_lens = vyx_frontend_alloc((RI_MAX_MODULES * 8) as u64);
        if (g_ri_ptrs == null || g_ri_lens == null || g_ri_map == null) { return; }
        memset(g_ri_ptrs, 0, (RI_MAX_MODULES * 8) as u64);
        memset(g_ri_lens, 0, (RI_MAX_MODULES * 8) as u64);
        let reg = self.import_registry;
        if (reg.len == 0) { return; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= reg.len) {
            if (i == reg.len || reg.charAt(i) == 10) {
                let line = str_view_range(reg, start, i);
                let mod = policy_module_base(self.sema_registry_line_module(line.clone()));
                let syms = self.sema_registry_line_symbols(line.clone());
                if (mod.len > 0 && syms.len > 0) {
                    let slot = sema_string_state_map_get(g_ri_map, mod.clone());
                    if (slot > 0) {
                        let si = (slot as i64) - 1;
                        let old_ptr = ast_read_rawptr(ptr_offset(g_ri_ptrs, si * 8));
                        let old_len = ast_read_i64(ptr_offset(g_ri_lens, si * 8));
                        var merged = syms.clone();
                        if (old_ptr != null && old_len > 0) {
                            merged = from_cstr_view_len(old_ptr, old_len) + "\n" + syms;
                            vyx_frontend_free(old_ptr);
                        }
                        ast_write_rawptr(ptr_offset(g_ri_ptrs, si * 8), ast_dup_c_string(merged));
                        ast_write_i64(ptr_offset(g_ri_lens, si * 8), merged.len as i64);
                    } else if (g_ri_count < RI_MAX_MODULES) {
                        let si = g_ri_count;
                        ast_write_rawptr(ptr_offset(g_ri_ptrs, si * 8), ast_dup_c_string(syms));
                        ast_write_i64(ptr_offset(g_ri_lens, si * 8), syms.len as i64);
                        g_ri_map = sema_string_state_map_put(g_ri_map, mod, (si + 1) as i32);
                        g_ri_count = si + 1;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    fn ri_module_exports_symbol(self, mod: string, name: string) -> bool {
        if (self.import_registry.len == 0 || mod.len == 0 || name.len == 0) { return false; }
        self.ri_ensure();
        if (g_ri_map == null || g_ri_ptrs == null) { return false; }
        let slot = sema_string_state_map_get(g_ri_map, mod.clone());
        if (slot <= 0) { return false; }
        let si = (slot as i64) - 1;
        let ptr = ast_read_rawptr(ptr_offset(g_ri_ptrs, si * 8));
        let len = ast_read_i64(ptr_offset(g_ri_lens, si * 8));
        if (ptr == null || len <= 0) { return false; }
        return string_contains(from_cstr_view_len(ptr, len), intern_cat3("|", name, "|"));
    }

public fn sema_lookup_class_canonical(self, fq: string) -> rawptr {
        if (fq.len == 0) { return null; }
        let want_i = generic_call_base(fq.clone());
        if (want_i.len > 0) { return self.sema_lookup_class_canonical_indexed(want_i.clone()); }
        let want = generic_call_base(fq.clone());
        var best: rawptr = null;
        var best_module: string = "";
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null
                && (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM())) {
                let cname = generic_call_base(decl_get_name(d));
                let sname = generic_call_base(sym_get_name(scan));
                let canonical = self.sema_type_canonical_name(d);
                if (cname == want || sname == want || canonical == want) {
                    let candidate_module = self.decl_source_module(d, null);
                    if (best == null) {
                        best = scan;
                        best_module = candidate_module;
                    } else if (self.sema_versioned_module_pair(candidate_module, best_module)) {
                        let version_cmp = policy_semver_compare(
                            policy_module_version(candidate_module),
                            policy_module_version(best_module));
                        if (version_cmp > 0
                            || (version_cmp == 0
                                && self.sema_layout_decl_score(d)
                                    > self.sema_layout_decl_score(sym_get_decl(best)))) {
                            best = scan;
                            best_module = candidate_module;
                        }
                    } else if (candidate_module == best_module
                        && self.sema_layout_decl_score(d)
                            > self.sema_layout_decl_score(sym_get_decl(best))) {
                        best = scan;
                    }
                }
            }
            scan = sym_get_next(scan);
        }
        return best;
    }

    public fn sema_has_type_canonical(self, fq: string) -> bool {
        return self.sema_lookup_class_canonical(fq) != null;
    }

    /// Table query only. Never parses or analyzes a file.

public fn sema_class_in_table(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (sym_lookup(self.classes_buf, name) != null) { return true; }
        let base = generic_call_base(name.clone());
        if (base.len > 0 && base != name && sym_lookup(self.classes_buf, base) != null) {
            return true;
        }
        if (base.len > 0 && self.sema_lookup_class_canonical(base) != null) { return true; }
        return false;
    }

    /// Table query: `mod.sym` is already a class or function in this Sema run.

public fn sema_named_in_module(self, mod: string, sym: string) -> bool {
        if (mod.len == 0 || sym.len == 0) { return false; }
        if (self.sema_find_func_symbol_in_module(sym.clone(), mod.clone()) != null) {
            return true;
        }
        let fq = intern_dot(mod, sym);
        if (self.sema_lookup_class_canonical(fq.clone()) != null) { return true; }
        let short_ent = sym_lookup(self.classes_buf, sym);
        if (short_ent != null) {
            let d = sym_get_decl(short_ent);
            if (d != null
                && (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM())
                && policy_module_base(self.decl_source_module(d, null)) == mod) {
                return true;
            }
        }
        return false;
    }

    public fn sema_has_named_entity(self, fq: string) -> bool {
        if (fq.len == 0) { return false; }
        if (self.sema_has_type_canonical(fq.clone())) { return true; }
        if (self.sema_namespace_exists(fq.clone())) { return true; }
        let parent = module_parent_path(generic_call_base(fq.clone()));
        let short = module_last_segment(generic_call_base(fq.clone()));
        if (parent.len > 0 && short.len > 0
            && self.sema_find_func_symbol_in_module(short.clone(), parent.clone()) != null) {
            return true;
        }
        return false;
    }

    public fn sema_use_alias_bind_raw(self, alias: string) -> string {
        if (self.current_unit == null || alias.len == 0) { return ""; }
        let scope = self.sema_scope_module();
        var found: string = "";
        var fallback: string = "";
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let meta = sema_use_decl_alias_name(decl_get_meta(cur));
                if (meta.len > 0 && meta == alias) {
                    let target = generic_call_base(decl_get_name(cur));
                    if (self.sema_use_decl_in_scope(cur, scope.clone())) {
                        found = target;
                        cur = null;
                    } else if (fallback.len == 0) {
                        fallback = target;
                        cur = decl_get_next(cur);
                    } else {
                        cur = decl_get_next(cur);
                    }
                } else {
                    cur = decl_get_next(cur);
                }
            } else {
                cur = decl_get_next(cur);
            }
        }
        if (found.len > 0) { return found; }
        return fallback;
    }


public fn sema_use_alias_target(self, alias: string) -> string {
        if (self.current_unit == null || alias.len == 0) { return ""; }
        let decls = unit_get_decls(self.current_unit);
        let scope = self.sema_scope_module();
        let memo_key = scope + "\t" + alias;
        sema_memo_ensure();
        let slot = sema_memo_lookup(g_use_alias_memo, decls, memo_key.clone());
        if (slot != null) { return sema_memo_slot_text(slot); }
        var hop = self.sema_use_alias_bind_raw(alias);
        var depth: i32 = 0;
        while (hop.len > 0 && depth < 32) {
            var dot: i32 = -1;
            var i: i32 = 0;
            while (i < hop.len && dot < 0) {
                if (hop.charAt(i) == 46) { dot = i; }
                i = i + 1;
            }
            var first = hop;
            var rest = "";
            if (dot > 0) {
                first = str_view_range(hop, 0, dot);
                rest = str_view_range(hop, dot, hop.len);
            }
            let next_hop = self.sema_use_alias_bind_raw(first);
            if (next_hop.len == 0) {
                sema_memo_put_text(g_use_alias_memo, decls, memo_key, hop);
                return hop;
            }
            hop = next_hop + rest;
            depth = depth + 1;
        }
        sema_memo_put_text(g_use_alias_memo, decls, memo_key, hop);
        return hop;
    }

    /// Expand a short name through alias / current+ancestor namespaces / glob `use`.
    /// `use` is sugar only; it does not hide FQ names. Ambiguous globs set
    /// `g_sema_name_ambiguous`. Visibility is `@[vis()]`, not `use`.

public fn sema_expand_short_name(self, name: string, report: bool) -> string {
        g_sema_name_ambiguous = false;
        if (name.len == 0) { return ""; }
        let base = generic_call_base(name.clone());
        if (base.len == 0) { return ""; }
        if (string_contains(base, ".")) { return ""; }
        let aliased = self.sema_use_alias_target(base.clone());
        if (aliased.len > 0) { return aliased; }
        if (self.sema_find_local_short_class_symbol(base.clone()) != null) { return ""; }
        let scope = self.sema_scope_module();
        var ns = scope.clone();
        while (ns.len > 0) {
            if (self.sema_module_exports_name(ns.clone(), base.clone())) {
                return intern_dot(ns, base);
            }
            ns = module_parent_path(ns);
        }
        if (self.current_unit != null) {
            var first_cand = "";
            var extra = "";
            var count: i32 = 0;
            let prefix_blob = self.esn_use_prefixes(scope.clone());
            var pstart: i32 = 0;
            var pi: i32 = 0;
            while (pi <= prefix_blob.len) {
                if (pi == prefix_blob.len || prefix_blob.charAt(pi) == 10) {
                    let prefix = str_view_range(prefix_blob, pstart, pi);
                    pstart = pi + 1;
                    if (prefix.len > 0) {
                        let cand2 = intern_dot(prefix, base);
                        if (self.sema_lookup_class_canonical(cand2.clone()) != null
                            || self.sema_named_in_module(prefix.clone(), base.clone())
                            || self.sema_module_exports_name(prefix.clone(), base.clone())
                            || self.sema_module_path_registered(cand2.clone())) {
                            if (count == 0) {
                                first_cand = cand2;
                                count = 1;
                            } else if (cand2 != first_cand
                                && (extra.len == 0 || !string_contains("\n" + extra + "\n",
                                                                       "\n" + cand2 + "\n"))) {
                                extra = extra + cand2 + "\n";
                                count = count + 1;
                            }
                        }
                    }
                }
                pi = pi + 1;
            }
            if (count == 1) { return first_cand; }
            if (count > 1) {
                g_sema_name_ambiguous = true;
                if (report) {
                    self.report_error_help(diag_code_sema_ambiguity(),
                                           g_sema_cur_loc,
                                           "name '" + base
                                               + "' is ambiguous; candidates include '"
                                               + first_cand + "'",
                                           "write a fully qualified name or add `use "
                                               + base + " = ...`");
                }
                return "";
            }
        }
        if (scope.len > 0) {
            var ns_mod = scope.clone();
            while (ns_mod.len > 0) {
                let child_mod = intern_dot(ns_mod, base);
                if (self.sema_module_path_registered(child_mod.clone())) {
                    return child_mod;
                }
                ns_mod = module_parent_path(ns_mod);
            }
        }
        return "";
    }

    /// Expand `Alias`, `Alias.Rest`, or a relative child/ancestor path.
    /// Inside `M1.M2`, `M3.T` → `M1.M2.M3.T` when `M1.M2.M3` is a module.
    /// Inside `M1.M2.M3`, `M2.T` → `M1.M2.T` when `M1.M2` is an ancestor.
    /// Unqualified non-alias names stay empty so `Option` is not rewritten.
    public fn sema_expand_relative_path(self, path: string) -> string {
        if (path.len == 0) { return ""; }
        let args = policy_generic_call_args(path.clone());
        let base = generic_call_base(path.clone());
        if (base.len == 0) { return ""; }
        var dot: i32 = -1;
        var i: i32 = 0;
        while (i < base.len && dot < 0) {
            if (base.charAt(i) == 46) { dot = i; }
            i = i + 1;
        }
        var first = base;
        var rest = "";
        if (dot > 0) {
            first = str_view_range(base, 0, dot);
            rest = str_view_range(base, dot, base.len);
        }
        let aliased = self.sema_use_alias_target(first.clone());
        if (aliased.len > 0) {
            var aliased_out = aliased + rest;
            if (args.len > 0) {
                aliased_out = aliased_out + "::<" + args + ">";
            }
            return aliased_out;
        }
        if (dot < 0) { return ""; }
        var ns = self.sema_scope_module();
        while (ns.len > 0) {
            let child_ns = intern_dot(ns, first);
            if (self.sema_module_path_registered(child_ns.clone())) {
                var out = intern_dot(ns, base);
                if (args.len > 0) {
                    out = out + "::<" + args + ">";
                }
                return out;
            }
            ns = module_parent_path(ns);
        }
        return "";
    }

    /// Rewrite `Alias.Rest` / relative `Child.Rest` to a fully qualified path.
    public fn sema_rewrite_use_alias_path(self, path: string) -> string {
        if (path.len == 0) { return path; }
        let expanded = self.sema_expand_relative_path(path.clone());
        if (expanded.len > 0) { return expanded; }
        return path;
    }

    /// Expand then load the declaring file. Lookup functions must not call this.
    public fn sema_materialize_named_type(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (type_name_is_primitive_text(name)
            || generic_list_contains(self.cur_generic_params, name)) {
            return false;
        }
        let rewritten = self.sema_rewrite_use_alias_path(name.clone());
        var fq = rewritten;
        var fq_base = generic_call_base(fq.clone());
        if (!string_contains(fq_base, ".")) {
            let expanded = self.sema_expand_short_name(fq_base.clone(), false);
            if (expanded.len > 0) {
                let args = policy_generic_call_args(fq.clone());
                fq = expanded;
                if (args.len > 0) {
                    fq = fq + "::<" + args + ">";
                }
                fq_base = generic_call_base(fq.clone());
            }
        }
        if (string_contains(fq_base, ".")) {
            return self.sema_load_qualified_type_symbol(fq);
        }
        return self.sema_lazy_load_pending_until_symbol(name);
    }

    /// Prefix of `alias.member` / `module.member` that names a module, not a type.
    public fn sema_module_prefix_target(self, prefix: string) -> string {
        if (prefix.len == 0 || prefix == "self") { return ""; }
        if (sym_lookup(self.cur_locals, prefix) != null) { return ""; }
        var expanded = self.sema_expand_short_name(prefix.clone(), false);
        if (expanded.len == 0) { expanded = self.sema_use_alias_target(prefix.clone()); }
        if (expanded.len == 0) { expanded = prefix.clone(); }
        if (self.sema_lookup_class_canonical(expanded.clone()) != null) { return ""; }
        if (self.sema_has_type_canonical(expanded.clone())) { return ""; }
        if (self.sema_name_is_type_path(expanded.clone())) { return ""; }
        // A top-level imported module is a valid namespace even when its
        // spelling has no dot (`use ProducerFree; ProducerFree::nested()`).
        // The old dotted-only guard skipped the module-qualified call fast
        // path, leaving the member resolver to treat the call as an unknown
        // value and return rawptr before generic substitution could run.
        if (!string_contains(expanded, ".")
            && expanded != "std"
            && !self.sema_namespace_exists(expanded.clone())) {
            return "";
        }
        if (self.sema_pending_has(expanded.clone()) || self.sema_loaded_covers(expanded.clone())) {
            return expanded;
        }
        if (string_contains(expanded, ".")
            && (self.sema_namespace_exists(expanded.clone())
                || self.sema_is_namespace_prefix(expanded.clone()))) {
            return expanded;
        }
        return "";
    }

    public fn sema_named_type_in_module(self, mod: string, name: string) -> bool {
        let qualified = intern_dot(mod, name);
        var entry = self.classes_buf;
        while (entry != null) {
            let d = sym_get_decl(entry);
            if (d != null && (decl_get_kind(d) == de_CLASS()
                || decl_get_kind(d) == de_ENUM() || decl_get_kind(d) == de_TYPE_ALIAS())
                && self.decl_source_module(d, null) == mod) {
                let declared = generic_call_base(decl_get_name(d));
                let symbol = generic_call_base(sym_get_name(entry));
                if (declared == name || declared == qualified || symbol == name || symbol == qualified) { return true; }
            }
            entry = sym_get_next(entry);
        }
        return false;
    }

    public fn sema_load_qualified_type_symbol(self, target: string) -> bool {
        if (target.len == 0) { return false; }
        let base = generic_call_base(target.clone());
        if (self.sema_class_in_table(target.clone()) || self.sema_class_in_table(base.clone())) {
            return true;
        }
        let sym = module_last_segment(base.clone());
        let mod = module_parent_path(base.clone());
        if (mod.len == 0 || sym.len == 0) { return false; }
        if (self.sema_named_type_in_module(mod.clone(), sym.clone())) { return true; }
        if (self.sema_load_module_symbol(mod, sym)) {
            if (self.sema_class_in_table(target.clone())
                || self.sema_class_in_table(base.clone())
                || self.sema_named_type_in_module(mod.clone(), sym.clone())) {
                return true;
            }
        }
        if (!self.sema_loaded_covers(mod)
            && !self.sema_registry_loaded_path_covers_module(mod.clone())) {
            self.sema_load_module(mod);
        }
        return self.sema_class_in_table(target.clone())
            || self.sema_class_in_table(base.clone())
            || self.sema_named_type_in_module(mod.clone(), sym.clone());
    }

    public fn sema_resolve_use_alias_type_name(self, alias: string) -> string {
        let target = self.sema_use_alias_target(alias);
        if (target.len == 0) { return ""; }
        if (self.sema_load_qualified_type_symbol(target.clone())) {
            let base = generic_call_base(target.clone());
            if (sym_lookup(self.classes_buf, target) != null) { return target; }
            if (base.len > 0 && sym_lookup(self.classes_buf, base) != null) {
                if (policy_generic_call_args(target.clone()).len > 0) { return target; }
                return base;
            }
        }
        return "";
    }

    public fn sema_load_type_alias_target_if_any(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        let target = self.sema_use_alias_target(name.clone());
        if (target.len == 0) { return false; }
        return self.sema_load_qualified_type_symbol(target);
    }

    public fn sema_layout_target_cache_key(self, target: string) -> string {
        return "layout-target:" + generic_call_base(target);
    }

    public fn sema_layout_path_cache_key(self, target: string, path: string) -> string {
        return "layout-path:" + generic_call_base(target) + "\n" + self.sema_normalize_path_key(path);
    }

    public fn sema_layout_cache_state(self, key: string) -> i32 {
        return sema_string_state_map_get(self.layout_load_cache, key);
    }

    public fn sema_layout_cache_note(self, key: string, state: i32) {
        if (key.len == 0 || state == 0) { return; }
        self.layout_load_cache = sema_string_state_map_put(self.layout_load_cache, key, state);
    }

    public fn sema_unit_find_declared_layout_type(self, unit: rawptr, target: string) -> rawptr {
        if (unit == null || target.len == 0) { return null; }
        let target_base = generic_call_base(target.clone());
        let target_mod = module_parent_path(target_base.clone());
        let unit_mod = self.sema_unit_module_name(unit);
        if (target_mod.len == 0 || unit_mod != target_mod) { return null; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if (kind == de_CLASS() || kind == de_ENUM()) {
                let declared = generic_call_base(decl_get_name(cur));
                if (declared == target_base
                    || (!string_contains(declared, ".")
                        && intern_dot(unit_mod, declared) == target_base)) {
                    return cur;
                }
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    public fn sema_layout_decl_is_exact(self, d: rawptr, target: string) -> bool {
        if (d == null || target.len == 0) { return false; }
        let kind = decl_get_kind(d);
        if (kind != de_CLASS() && kind != de_ENUM()) { return false; }
        if (generic_call_base(decl_get_name(d)) != generic_call_base(target)) { return false; }
        return string_contains(decl_get_meta(d), "|layout-exact|");
    }

    public fn sema_unit_has_exact_type_decl(self, unit: rawptr, target: string) -> bool {
        if (unit == null || target.len == 0) { return false; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (self.sema_layout_decl_is_exact(cur, target.clone())) { return true; }
            cur = decl_get_next(cur);
        }
        return false;
    }

    public fn sema_layout_decl_score(self, d: rawptr) -> i32 {
        if (d == null) { return 0; }
        sema_memo_ensure();
        let slot = sema_memo_lookup(g_layout_score_memo, d, "");
        if (slot != null) { return sema_memo_slot_i64(slot) as i32; }
        var score: i32 = 1;
        var member = decl_get_members(d);
        while (member != null) {
            let kind = decl_get_kind(member);
            if (kind == de_FIELD() || kind == de_VARIANT()) {
                score = score + 32;
            } else {
                score = score + 1;
            }
            member = decl_get_next(member);
        }
        sema_memo_put_i64(g_layout_score_memo, d, "", score as i64);
        return score;
    }

    public fn sema_layout_decl_is_foreign_shell(self, d: rawptr) -> bool {
        if (d == null || !decl_marked_imported(d) || self.sema_layout_decl_score(d) != 1) {
            return false;
        }
        let declared_module = module_parent_path(generic_call_base(decl_get_name(d)));
        let source_module = self.extract_from_module(decl_get_meta(d));
        return declared_module.len > 0
            && source_module.len > 0
            && declared_module != source_module;
    }

    public fn sema_mark_layout_decl_exact(self, d: rawptr, path: string) {
        if (d == null) { return; }
        var meta = decl_get_meta(d);
        if (!string_contains(meta, "|layout-exact|")) {
            meta = meta + "|layout-exact|";
        }
        if (!string_contains(meta, "|layout-source:")) {
            meta = meta + "layout-source:" + self.sema_normalize_path_key(path) + "|";
        }
        decl_set_meta(d, meta);
    }

    public fn sema_bind_exact_layout_decl(self, target: string, d: rawptr) {
        if (!self.sema_layout_decl_is_exact(d, target.clone())) { return; }
        let target_base = generic_call_base(target.clone());
        let current = sym_lookup(self.classes_buf, target_base.clone());
        if (current != null) {
            let current_decl = sym_get_decl(current);
            if (self.sema_layout_decl_is_exact(current_decl, target.clone())
                && self.sema_layout_decl_score(current_decl) >= self.sema_layout_decl_score(d)) {
                return;
            }
        }
        self.classes_buf = sym_push_decl(self.classes_buf, target_base, d);
    }

    public fn sema_forced_layout_target_seen(self, target: string) -> bool {
        if (target.len == 0) { return false; }
        return sema_set_has(self.forced_layout_targets, target);
    }

    public fn sema_note_forced_layout_target(self, target: string) {
        if (target.len == 0 || self.sema_forced_layout_target_seen(target.clone())) { return; }
        self.forced_layout_targets = sema_set_add(self.forced_layout_targets, target);
    }

    public fn sema_force_merge_type_layout_path(self,
                                                path: string,
                                                target: string) -> bool {
        if (path.len == 0 || target.len == 0) { return false; }
        if (self.sema_path_loaded(path)) {
            return self.sema_unit_has_exact_type_decl(self.current_unit, target)
                || self.sema_class_in_table(target.clone());
        }
        let cache_key = self.sema_layout_path_cache_key(target.clone(), path.clone());
        let cached = self.sema_layout_cache_state(cache_key.clone());
        if (cached == 1) {
            return self.sema_unit_has_exact_type_decl(self.current_unit, target);
        }
        if (cached == 2 || cached == 3) { return false; }
        self.sema_layout_cache_note(cache_key.clone(), 3);
        self.sema_mark_path_loaded(path.clone());
        let imported = self.sema_parse_module_file(path);
        if (imported == null) {
            self.sema_layout_cache_note(cache_key, 2);
            return false;
        }
        let exact_decl = self.sema_unit_find_declared_layout_type(imported, target.clone());
        if (exact_decl == null) {
            self.sema_layout_cache_note(cache_key, 2);
            return false;
        }
        self.sema_mark_layout_decl_exact(exact_decl, path.clone());
        let current = sym_lookup(self.classes_buf, generic_call_base(target.clone()));
        if (current != null) {
            let current_decl = sym_get_decl(current);
            if (self.sema_layout_decl_is_exact(current_decl, target.clone())
                && self.sema_layout_decl_score(current_decl) >= self.sema_layout_decl_score(exact_decl)) {
                self.sema_layout_cache_note(cache_key, 1);
                return true;
            }
        }
        self.sema_lazy_symbol_miss_clear();
        let actual_mod = self.sema_unit_module_name(imported);
        self.sema_queue_use_decls(imported);
        self.sema_mark_imported_unit(imported, actual_mod);
        self.sema_apply_loaded_module_passes(imported);
        let appended = self.sema_append_unit(self.current_unit, imported);
        if (appended > 0) {
            self.host_analyze_register_std_short_name_aliases(self.current_unit);
            self.host_analyze_inject_structural_trait_defaults(self.current_unit);
        }
        self.sema_bind_exact_layout_decl(target.clone(), exact_decl);
        self.sema_layout_cache_note(cache_key, 1);
        return self.sema_unit_has_exact_type_decl(self.current_unit, target);
    }

    public fn sema_load_type_layout_symbol(self, target: string) -> bool {
        if (target.len == 0) { return false; }
        let base = generic_call_base(target.clone());
        let local_type = self.sema_find_class_symbol(base.clone());
        if (local_type != null) {
            let local_decl = sym_get_decl(local_type);
            if (local_decl != null && !decl_marked_imported(local_decl)) {
                return true;
            }
        }
        let target_key = self.sema_layout_target_cache_key(base.clone());
        let target_state = self.sema_layout_cache_state(target_key.clone());
        if (target_state == 1) {
            return self.sema_unit_has_exact_type_decl(self.current_unit, base);
        }
        if (target_state == 2) { return false; }
        let sym = module_last_segment(base.clone());
        let mod = module_parent_path(base.clone());
        if (mod.len == 0 || sym.len == 0 || self.import_registry.len == 0) {
            self.sema_layout_cache_note(target_key, 2);
            return false;
        }
        var loaded_any = false;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (self.sema_registry_request_matches_line(mod.clone(), line.clone())
                    && self.sema_registry_line_has_symbol(line.clone(), sym.clone())) {
                    let path = self.sema_registry_line_path(line);
                    if (path.len > 0) {
                        if (self.sema_force_merge_type_layout_path(path, base.clone())) {
                            loaded_any = true;
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (loaded_any) {
            self.host_analyze_register_std_short_name_aliases(self.current_unit);
            self.host_analyze_inject_structural_trait_defaults(self.current_unit);
        }
        if (self.sema_unit_has_exact_type_decl(self.current_unit, base.clone())) {
            self.sema_note_forced_layout_target(base);
            self.sema_layout_cache_note(target_key, 1);
            return true;
        }
        self.sema_layout_cache_note(target_key, 2);
        return false;
    }

    public fn sema_builtin_type_arg_is_ambiguous(self, text: string) -> bool {
        if (self.current_unit == null || text.len == 0
            || sema_type_name_base_is_qualified(text)) {
            return false;
        }
        let wanted = generic_call_base(text.clone());
        if (wanted.len == 0 || type_name_is_primitive_text(wanted)
            || generic_list_contains(self.cur_generic_params, wanted)) {
            return false;
        }
        var exact_root = false;
        var first_qualified = "";
        var multiple_qualified = false;
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if (kind == de_CLASS() || kind == de_ENUM() || kind == de_TYPE_ALIAS()) {
                let declared = generic_call_base(decl_get_name(cur));
                if (declared == wanted) {
                    exact_root = true;
                } else if (module_last_segment(declared.clone()) == wanted) {
                    if (first_qualified.len == 0) {
                        first_qualified = declared;
                    } else if (declared != first_qualified) {
                        multiple_qualified = true;
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return !exact_root && multiple_qualified;
    }

    public fn sema_canonical_builtin_type_arg(self, text: string, depth: i32) -> string {
        if (text.len == 0 || depth > 32) { return text; }
        let rewritten_path = self.sema_rewrite_use_alias_path(text.clone());
        if (rewritten_path != text) {
            return self.sema_canonical_builtin_type_arg(rewritten_path, depth + 1);
        }
        if (policy_generic_call_has_args(text.clone()) != 0) {
            var base = generic_call_base(text.clone());
            let raw_alias_base = self.sema_use_alias_target(base.clone());
            if (raw_alias_base.len > 0) {
                self.sema_load_type_layout_symbol(raw_alias_base.clone());
            } else {
                self.sema_load_type_layout_symbol(base.clone());
            }
            let alias_base = self.sema_resolve_use_alias_type_name(base.clone());
            if (alias_base.len > 0 && alias_base != base) {
                base = alias_base;
            } else {
                let base_ent = self.sema_find_class_symbol(base.clone());
                if (base_ent != null) { base = sym_class_canonical_name(base_ent); }
            }
            let raw_args = policy_generic_call_args(text.clone());
            var out_args = "";
            var idx: i32 = 0;
            while (idx < 64) {
                let raw_arg = policy_generic_arg_at(raw_args.clone(), idx);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return base; }
                    return base + "::<" + out_args + ">";
                }
                if (out_args.len > 0) { out_args = out_args + ","; }
                out_args = out_args + self.sema_canonical_builtin_type_arg(raw_arg, depth + 1);
                idx = idx + 1;
            }
            return text;
        }
        if (type_name_is_primitive_text(text)
            || generic_list_contains(self.cur_generic_params, text)) {
            return text;
        }
        let raw_alias_target = self.sema_use_alias_target(text.clone());
        if (raw_alias_target.len > 0) {
            self.sema_load_type_layout_symbol(raw_alias_target.clone());
        } else {
            self.sema_load_type_layout_symbol(text.clone());
        }
        let alias_target = self.sema_resolve_use_alias_type_name(text.clone());
        if (alias_target.len > 0 && alias_target != text) {
            return self.sema_canonical_builtin_type_arg(alias_target, depth + 1);
        }
        // Preserve an unresolved short spelling when more than one qualified
        // layout type owns that tail name.  Picking the first symbol here
        // would erase the ambiguity from HIR/MIR and make backend behavior
        // depend on declaration order.
        if (self.sema_builtin_type_arg_is_ambiguous(text)) { return text; }
        var ent = self.sema_find_class_symbol(text.clone());
        if (ent == null) {
            self.sema_materialize_named_type(text.clone());
            ent = self.sema_find_class_symbol(text.clone());
        }
        if (ent != null) {
            let canonical = sym_class_canonical_name(ent);
            if (canonical.len > 0) { return canonical; }
        }
        return text;
    }

    public fn sema_canonical_builtin_type_args(self, args: string) -> string {
        var out = "";
        var idx: i32 = 0;
        while (idx < 64) {
            let raw_arg = policy_generic_arg_at(args.clone(), idx);
            if (raw_arg.len == 0) { return out; }
            if (out.len > 0) { out = out + ","; }
            out = out + self.sema_canonical_builtin_type_arg(raw_arg, 0);
            idx = idx + 1;
        }
        return args;
    }

    public fn sema_load_qualified_func_symbol(self, target: string) -> bool {
        if (target.len == 0) { return false; }
        let base = generic_call_base(target.clone());
        let sym = module_last_segment(base.clone());
        let mod = module_parent_path(base.clone());
        if (mod.len > 0 && self.sema_name_is_type_path(mod.clone())) {
            return false;
        }
        if (mod.len > 0 && sym.len > 0) {
            if (self.sema_find_func_symbol_in_module(sym, mod.clone()) != null) {
                return true;
            }
            if (self.sema_load_module_symbol(mod.clone(), sym.clone())) {
                if (self.sema_find_func_symbol_in_module(sym, mod.clone()) != null) {
                    return true;
                }
            }
            if (!self.sema_loaded_covers(mod.clone())) {
                self.sema_load_module(mod.clone());
                if (self.sema_find_func_symbol_in_module(sym, mod.clone()) != null) {
                    return true;
                }
            }
            return false;
        }
        if (self.sema_find_func_symbol(base.clone()) != null) { return true; }
        if (self.sema_lazy_load_pending_until_symbol(base.clone())) {
            return self.sema_find_func_symbol(base.clone()) != null;
        }
        return false;
    }

    public fn sema_resolve_use_alias_func_name(self, alias: string) -> string {
        let target = self.sema_use_alias_target(alias);
        if (target.len == 0) { return ""; }
        if (!self.sema_load_qualified_func_symbol(target.clone())) { return ""; }
        let base = generic_call_base(target.clone());
        let target_args = policy_generic_call_args(target.clone());
        let sym = module_last_segment(base.clone());
        let mod = module_parent_path(base.clone());
        var resolved = base.clone();
        if (mod.len > 0 && sym.len > 0
            && self.sema_find_func_symbol_in_module(sym.clone(), mod.clone()) != null) {
            resolved = sym.clone();
        } else if (self.sema_find_func_symbol(base.clone()) == null
            && sym.len > 0
            && self.sema_find_func_symbol(sym.clone()) != null) {
            resolved = sym.clone();
        }
        if (target_args.len > 0) {
            return generic_call_base(resolved) + "::<" + target_args + ">";
        }
        return generic_call_base(resolved);
    }

    public fn sema_current_unit_has_unaliased_use_module(self, module_name: string) -> bool {
        if (self.current_unit == null || module_name.len == 0) { return false; }
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let meta = decl_get_meta(cur);
                if (sema_use_decl_alias_name(meta).len == 0
                    && generic_call_base(decl_get_name(cur)) == module_name) {
                    return true;
                }
            }
            cur = decl_get_next(cur);
        }
        return false;
    }

    public fn sema_resolve_module_member_type_name(self, prefix: string, member_name: string) -> string {
        if (prefix.len == 0 || member_name.len == 0) { return ""; }
        var target_prefix = self.sema_use_alias_target(prefix.clone());
        if (target_prefix.len == 0) { target_prefix = prefix.clone(); }
        if (self.sema_name_is_type_path(target_prefix.clone())) { return ""; }
        if (!string_contains(target_prefix, ".") && target_prefix != "std"
            && !self.sema_module_path_registered(target_prefix.clone())) {
            return "";
        }
        let target = intern_dot(target_prefix, generic_call_base(member_name.clone()));
        if (self.sema_load_qualified_type_symbol(target.clone())) {
            return target;
        }
        return "";
    }

    public fn sema_member_chain_text(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) {
            let name = expr_get_name(e);
            if (name.len == 0) { return ""; }
            if (sym_lookup(self.cur_locals, name) != null) { return ""; }
            let expanded = self.sema_expand_short_name(name.clone(), false);
            if (expanded.len > 0) { return expanded; }
            let alias_target = self.sema_use_alias_target(name.clone());
            if (alias_target.len > 0) { return alias_target; }
            return name;
        }
        if (k == ex_MEMBER()) {
            let lhs_text = self.sema_member_chain_text(expr_get_lhs(e));
            if (lhs_text.len == 0) { return ""; }
            let raw_member = expr_get_name(e);
            let member_base = generic_call_base(raw_member.clone());
            if (member_base.len == 0) { return ""; }
            let member_args = policy_generic_call_args(raw_member.clone());
            if (member_args.len > 0) {
                return intern_cat4(intern_dot(lhs_text, member_base), "::<", member_args, ">");
            }
            return intern_dot(lhs_text, member_base);
        }
        return "";
    }

    public fn sema_mark_member_chain_namespace_prefix(self, e: rawptr) {
        if (e == null) { return; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) {
            if (expr_get_ty(e) == null) {
                expr_set_ty(e, tref_create_kind(ty_RAWPTR()));
            }
            if (expr_get_semantic_kind(e) == expr_sem_NONE()) {
                expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
            }
            return;
        }
        if (k == ex_MEMBER()) {
            self.sema_mark_member_chain_namespace_prefix(expr_get_lhs(e));
            if (expr_get_ty(e) == null) {
                expr_set_ty(e, tref_create_kind(ty_RAWPTR()));
            }
            if (expr_get_semantic_kind(e) == expr_sem_NONE()) {
                expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
            }
        }
    }

    public fn sema_resolve_member_chain_type_name(self, e: rawptr) -> string {
        let target = self.sema_member_chain_text(e);
        if (target.len == 0) { return ""; }
        let target_base = generic_call_base(target.clone());
        let target_args = policy_generic_call_args(target.clone());
        var ent = self.sema_find_class_symbol(target_base.clone());
        if (ent == null) { ent = self.sema_find_class_symbol(target.clone()); }
        if (ent != null) {
            let canonical = sym_get_name(ent);
            if (target_args.len > 0) { return canonical + "::<" + target_args + ">"; }
            return canonical;
        }
        let target_mod = module_parent_path(target_base.clone());
        let target_sym = module_last_segment(target_base.clone());
        if (target_mod.len == 0 || target_sym.len == 0) { return ""; }
        let can_load = self.sema_loaded_covers(target_mod.clone())
            || self.sema_registry_paths_for_symbol(target_mod.clone(), target_sym.clone()).len > 0
            || self.sema_registry_paths_for_module(target_mod.clone()).len > 0;
        if (!can_load) { return ""; }
        if (!self.sema_load_qualified_type_symbol(target.clone())) { return ""; }
        ent = self.sema_find_class_symbol(target_base.clone());
        if (ent == null) { ent = self.sema_find_class_symbol(target.clone()); }
        if (ent != null) {
            let canonical2 = sym_get_name(ent);
            if (target_args.len > 0) { return canonical2 + "::<" + target_args + ">"; }
            return canonical2;
        }
        return "";
    }

    /// Rewrite a qualified type path whose segments each may carry their own
    /// type arguments into the single flat spelling a hoisted nested record is
    /// registered under: `Holder::<i32>.Inner::<f64>` becomes
    /// `Holder.Inner::<i32,f64>`.  This mirrors `parser_canonical_type_path`;
    /// the parser hands that form to `parse_struct_init`, but a *constructor
    /// call* (`Holder<i32>::Inner(42)`) reaches sema as an ordinary member
    /// call, so the flattening has to happen here too.
    public fn sema_canonical_nested_record_name(self, text: string) -> string {
        if (text.len == 0) { return ""; }
        var flat: string = "";
        var all_args: string = "";
        var cur: string = "";
        var depth: i32 = 0;
        var i: i32 = 0;
        var n: i32 = text.len as i32;
        while (i <= n) {
            var piece: string = "";
            if (i >= n) {
                piece = cur;
            } else {
                let ch = text.charAt(i);
                if (ch == 60) { depth = depth + 1; }
                if (ch == 62) { if (depth > 0) { depth = depth - 1; } }
                if (ch == 46 && depth == 0) {
                    piece = cur;
                    cur = "";
                } else {
                    cur = cur + str_view_range(text, i as i64, (i + 1) as i64);
                }
            }
            if (piece.len > 0) {
                let base = generic_call_base(piece.clone());
                if (base.len == 0) { return ""; }
                let args = policy_generic_call_args(piece.clone());
                if (flat.len > 0) { flat = flat + "."; }
                flat = flat + base;
                if (args.len > 0) {
                    if (all_args.len > 0) { all_args = all_args + ","; }
                    all_args = all_args + args;
                }
            }
            i = i + 1;
        }
        if (flat.len == 0) { return ""; }
        if (all_args.len == 0) { return flat; }
        return flat + "::<" + all_args + ">";
    }

    /// Leading `.`-segment of a dotted path with any generic arguments
    /// removed: `Holder::<i32>.Inner` -> `Holder`, `abi_complex.Multi` ->
    /// `abi_complex`.
    public fn sema_path_head_base(self, text: string) -> string {
        if (text.len == 0) { return ""; }
        var head = text;
        var i: i32 = 0;
        while (i < text.len as i32) {
            if (text.charAt(i) == 46) {
                head = text.substring(0, i);
                break;
            }
            i = i + 1;
        }
        return generic_call_base(head);
    }

    /// Whether a qualified-path receiver can be a *type* path: its head names a
    /// module, or the path resolves to a declared type.
    ///
    /// `resolve_nested_record_ctor_call` needs this to tell
    /// `Holder<i32>::Inner(42)` / `t.Outer::<i32>.Inner(42)` -- where the
    /// receiver really is a type -- from `abi_complex.VecBox(3)`, where the
    /// receiver is only the first segment of a dotted *declared name* (the
    /// spelling every DCI provider type uses) and the ordinary
    /// module-qualified resolution has to bind the call.  Both spell the
    /// flattened name identically (`abi_complex.VecBox` vs `Outer.Inner`), so
    /// the name alone cannot decide it; the receiver can.
    public fn sema_path_head_is_module_or_type(self, head: string, full_text: string) -> bool {
        if (head.len == 0) { return false; }
        if (self.sema_module_prefix_target(head.clone()).len > 0) { return true; }
        if (self.sema_has_type_canonical(full_text.clone())) { return true; }
        return self.sema_name_is_type_path(full_text);
    }

    /// Number of `.`-separated segments in a type path that carries no type
    /// arguments (`generic_call_base` has already stripped those).
    public fn sema_plain_path_segment_count(self, text: string) -> i32 {
        if (text.len == 0) { return 0; }
        var count: i32 = 1;
        var i: i32 = 0;
        while (i < text.len as i32) {
            if (text.charAt(i) == 46) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    /// The record declaration registered under `name_base`, if any.  Mirrors
    /// `parse_struct_init`'s lookup and rejects non-record symbols (a variant
    /// or a function of the same name is not a nested record).  The lazy load
    /// is kept, but only for a name whose prefix is a module this unit can
    /// actually pull in -- see `sema_module_path_is_loadable`.
    public fn sema_nested_record_decl(self, name_base: string) -> rawptr {
        if (name_base.len == 0) { return null; }
        var ent = self.sema_find_latest_class_symbol(name_base.clone());
        if (ent == null) {
            // Lazy load, but only for a name that really is module-qualified:
            // `sema_load_module` answers a prefix that is not a module with a
            // hard `unknown module` diagnostic, and this lookup doubles as the
            // speculative probe behind `Enum.Variant(args)`, where the leading
            // "module" segment is the enum itself.  A hoisted nested record is
            // registered under its point-dotted name together with its parent,
            // so the symbol table already answers for it.
            let mod = module_parent_path(generic_call_base(name_base.clone()));
            if (mod.len > 0 && self.sema_module_path_is_loadable(mod.clone())) {
                self.sema_materialize_named_type(name_base.clone());
                ent = self.sema_find_latest_class_symbol(name_base.clone());
            }
        }
        if (ent == null) { return null; }
        let d = sym_get_decl(ent);
        if (d == null || decl_get_kind(d) != de_CLASS()) { return null; }
        return d;
    }

    /// Whether `mod` names a module this unit could actually pull in: already
    /// loaded, pending, or present in the import registry.  A speculative type
    /// probe must ask this before handing a name to `sema_materialize_named_type`,
    /// because that path reports `unknown module` for anything else.
    public fn sema_module_path_is_loadable(self, mod: string) -> bool {
        if (mod.len == 0) { return false; }
        if (self.sema_loaded_covers(mod.clone())) { return true; }
        if (self.sema_pending_has(mod.clone())) { return true; }
        if (self.sema_registry_loaded_path_covers_module(mod.clone())) { return true; }
        if (self.import_registry.len > 0
            && self.sema_registry_paths_for_module(mod.clone()).len > 0) {
            return true;
        }
        return false;
    }

    /// `Outer<i32>::Inner(42)` -- a nested record's constructor written as a
    /// qualified path.  The receiver is a *type* rather than a value and the
    /// member names the record hoisted under `<receiver>.<member>`; no member
    /// of the receiver declares that name, so the ordinary method lookup above
    /// fails and this turns the call into `Outer.Inner::<i32>`'s constructor.
    ///
    /// The receiver text arrives module-qualified (`t.Outer::<i32>`) while the
    /// record is registered under the spelling the source used
    /// (`Outer.Inner`), so the leading segments are dropped one at a time
    /// until the name resolves -- never below two segments, since a nested
    /// record always has a parent.  `VYX_NESTED_CTOR_TRACE=1` prints the
    /// shape, the flattened name and whether the lookup succeeded.
    public fn resolve_nested_record_ctor_call(self, call_e: rawptr, callee: rawptr) -> rawptr {
        let trace = sema_env_enabled("VYX_NESTED_CTOR_TRACE");
        if (call_e == null || callee == null) { return null; }
        if (expr_get_kind(callee) != ex_MEMBER()) { return null; }
        let member_name = expr_get_name(callee);
        if (member_name.len == 0) { return null; }
        let member_base = generic_call_base(member_name.clone());
        if (member_base.len == 0) { return null; }
        let receiver = expr_get_lhs(callee);
        if (receiver == null) { return null; }
        // Empty for a local -- a value receiver, which is a plain member call.
        let receiver_text = self.sema_raw_member_chain_text(receiver);
        if (receiver_text.len == 0) { return null; }
        // A qualified *type path* -- `alias.Record(args)` for a record reached
        // through its module, which is how every DCI provider type is spelled
        // -- is not a nested record.  Its head segment names a module, and the
        // ordinary module-qualified resolution below already binds it; this
        // pass would instead rewrite the callee into an `ex_IDENT` carrying the
        // dotted name, which no name lookup can resolve, and the file fails
        // with `E2000: unknown name 'abi_complex'`.  A nested record's receiver
        // is a type path: either its parent record (`Holder<i32>::Inner`) or a
        // module-qualified record (`t.Outer::<i32>`).  `abi_complex` is neither
        // -- it is only the first segment of a *dotted declared name*.
        let receiver_head = self.sema_path_head_base(receiver_text.clone());
        if (receiver_head.len > 0
            && receiver_head != "self"
            && !self.sema_path_head_is_module_or_type(receiver_head.clone(),
                                                     receiver_text.clone())) {
            return null;
        }
        // A member the receiver's own record declares is a call on that
        // member (`Outer<i32>::Inner::helper()`), not a constructor.
        let receiver_record = generic_call_base(
            self.sema_canonical_nested_record_name(receiver_text.clone()));
        if (receiver_record.len > 0) {
            let rdecl = self.sema_nested_record_decl(receiver_record.clone());
            if (rdecl != null
                && self.sema_class_declares_member_name(rdecl, member_base.clone())) {
                return null;
            }
        }
        let flat = self.sema_canonical_nested_record_name(receiver_text.clone()
                                                          + "."
                                                          + member_name);
        if (flat.len == 0) { return null; }
        var candidate = generic_call_base(flat.clone());
        var decl = null;
        while (true) {
            decl = self.sema_nested_record_decl(candidate.clone());
            if (decl != null) { break; }
            if (self.sema_plain_path_segment_count(candidate.clone()) <= 2) { break; }
            var dot: i32 = -1;
            var j: i32 = 0;
            while (j < candidate.len as i32) {
                if (candidate.charAt(j) == 46) { dot = j; break; }
                j = j + 1;
            }
            if (dot < 0) { break; }
            candidate = candidate.substring(dot + 1, candidate.len as i32);
        }
        if (trace) {
            print("[nested-ctor] recv=" + receiver_text + " member=" + member_name
                  + " flat=" + flat + " candidate=" + candidate
                  + (if (decl == null) { " found=no" } else { " found=yes" }) + "\n");
        }
        // Only a name that resolves exactly, otherwise the last-segment
        // fallback inside `resolve_class_constructor_call` could bind an
        // unrelated record that happens to share the nested record's name.
        if (decl == null) { return null; }
        if (self.sema_class_declares_member_name(decl, member_base.clone())) { return null; }
        let flat_args = policy_generic_call_args(flat.clone());
        let ty = self.resolve_class_constructor_call(call_e,
                                                    callee,
                                                    candidate.clone(),
                                                    flat_args);
        if (trace) {
            print("[nested-ctor] ctor of " + candidate + flat
                  + (if (ty == null) { " -> null" } else { " -> resolved" }) + "\n");
        }
        if (ty == null) { return null; }
        // Use the *unqualified* spelling: the hoisted record is registered as
        // `Holder.Inner::<i32>`, while `flat` still carries the module
        // expansion `sema_raw_member_chain_text` produced for the receiver
        // (`t.Holder.Inner::<i32>`).  Naming the callee with `flat` would
        // describe a symbol that does not exist.
        var canon_name = candidate.clone();
        if (flat_args.len > 0) { canon_name = canon_name + "::<" + flat_args + ">"; }
        expr_set_name(callee, canon_name);
        // HIR branches on the callee's *expression kind*: an `ex_MEMBER`
        // callee goes through member-method resolution, which has no notion of
        // a constructor reached through a type path, and it drops the METHOD
        // semantic this pass just installed -- the call then reaches MIR with
        // `target_kind=none` and codegen rejects it as a "function-value
        // callee".  A non-nested `Inner(43)` works because its callee is an
        // `ex_IDENT`.  Rewriting the callee into that same shape keeps the
        // constructor target.  Same treatment the module-qualified call above
        // applies to its own callee.
        expr_set_kind(callee, ex_IDENT());
        expr_set_lhs(callee, null);
        return ty;
    }

    /// `sema_member_chain_text` with the module expansion and `use`-alias
    /// rewriting left out: `Holder::<i32>.Inner`, exactly as written.  Returns
    /// "" when the head is a local (that is, when the chain is a value).
    public fn sema_raw_member_chain_text(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) {
            let name = expr_get_name(e);
            if (name.len == 0) { return ""; }
            if (sym_lookup(self.cur_locals, name) != null) { return ""; }
            return name;
        }
        if (k == ex_MEMBER()) {
            let lhs_text = self.sema_raw_member_chain_text(expr_get_lhs(e));
            if (lhs_text.len == 0) { return ""; }
            let raw_member = expr_get_name(e);
            let member_base = generic_call_base(raw_member.clone());
            if (member_base.len == 0) { return ""; }
            let member_args = policy_generic_call_args(raw_member.clone());
            if (member_args.len > 0) {
                return intern_cat4(intern_dot(lhs_text, member_base), "::<", member_args, ">");
            }
            return intern_dot(lhs_text, member_base);
        }
        return "";
    }

    public fn sema_class_declares_member_name(self,
                                              class_decl: rawptr,
                                              member_name: string) -> bool {
        if (class_decl == null || member_name.len == 0) { return false; }
        var mp = decl_get_members(class_decl);
        while (mp != null) {
            let name = decl_get_name(mp);
            if (name == member_name) { return true; }
            if (generic_call_base(name.clone()) == member_name) { return true; }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn sema_member_receiver_declares_member(self, receiver: rawptr, member_name: string) -> bool {
        if (receiver == null || member_name.len == 0) { return false; }
        let receiver_text = self.sema_member_chain_text(receiver);
        if (receiver_text.len == 0) { return false; }
        let receiver_base = generic_call_base(receiver_text.clone());
        var ent = self.sema_find_class_symbol(receiver_base.clone());
        if (ent == null) { ent = self.sema_find_class_symbol(receiver_text.clone()); }
        if (ent == null) { return false; }
        let d = sym_get_decl(ent);
        if (d == null) { return false; }
        var mp = decl_get_members(d);
        while (mp != null) {
            if (decl_get_name(mp) == member_name) { return true; }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn sema_normalize_path_key(self, path: string) -> string {
        var out = "";
        var i: i32 = 0;
        while (i < path.len) {
            let c = path.charAt(i);
            if (c == 92) {
                out = out + "/";
            } else {
                out = out + str_view_range(path, i, i + 1);
            }
            i = i + 1;
        }
        while (out.len >= 2 && str_view_range(out, 0, 2) == "./") {
            out = str_view_range(out, 2, out.len);
        }
        return out;
    }

    public fn sema_extract_source_path_meta(self, meta: string) -> string {
        let needle = "|source-path:";
        var i: i32 = 0;
        while ((i as i64) + needle.len <= meta.len) {
            var matched = true;
            var k: i32 = 0;
            while ((k as i64) < needle.len) {
                if (meta.charAt(i + k) != needle.charAt(k)) {
                    matched = false;
                    break;
                }
                k = k + 1;
            }
            if (matched) {
                let start = i + (needle.len as i32);
                var j = start;
                while ((j as i64) < meta.len && meta.charAt(j) != 124) {
                    j = j + 1;
                }
                if (j > start) {
                    return from_cstr_len(ptr_offset(meta.c_str(), start), (j - start) as i64);
                }
                return "";
            }
            i = i + 1;
        }
        return "";
    }

    public fn sema_path_loaded(self, path: string) -> bool {
        if (path.len == 0) { return true; }
        let key = self.sema_normalize_path_key(path);
        return sema_set_has(self.loaded_paths, key);
    }

    public fn sema_mark_path_loaded(self, path: string) {
        if (path.len == 0) { return; }
        let key = self.sema_normalize_path_key(path);
        if (key.len == 0 || self.sema_path_loaded(key)) { return; }
        self.loaded_paths = sema_set_add(self.loaded_paths, key);
    }

    public fn sema_registry_paths_for_module(self, mod: string) -> string {
        if (self.import_registry.len == 0 || mod.len == 0) { return ""; }
        var out = "";
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (self.sema_registry_request_matches_line(mod, line)) {
                    let path = self.sema_registry_line_path(line);
                    if (path.len > 0 && !self.sema_path_loaded(path)) {
                        out = out + path + "\n";
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return out;
    }

    public fn sema_registry_loaded_path_covers_module(self,
                                                      mod: string) -> bool {
        if (self.import_registry.len == 0 || mod.len == 0) { return false; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len
                || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (self.sema_registry_request_matches_line(mod, line)) {
                    let path = self.sema_registry_line_path(line);
                    if (path.len > 0 && self.sema_path_loaded(path)) {
                        return true;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn sema_registry_paths_for_module_facade(self, mod: string) -> string {
        if (self.import_registry.len == 0 || mod.len == 0) { return ""; }
        let target_stem = module_last_segment(mod);
        if (target_stem.len == 0) { return ""; }
        var out = "";
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                let lm = self.sema_registry_line_module(line);
                let path = self.sema_registry_line_path(line);
                if (lm == mod
                    && path.len > 0
                    && self.sema_path_stem(path) == target_stem
                    && !self.sema_path_loaded(path)) {
                    out = out + path + "\n";
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return out;
    }

    public fn sema_registry_paths_for_symbol(self, mod: string, sym: string) -> string {
        if (self.import_registry.len == 0 || mod.len == 0 || sym.len == 0) { return ""; }
        self.profile_registry_symbol_queries = self.profile_registry_symbol_queries + 1;
        var prof_start: i64 = 0;
        if (vyx_bootstrap_profile_level() > 0) { prof_start = vyx_bootstrap_now_ms(); }
        var out = "";
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (self.sema_registry_request_matches_line(mod, line)
                    && self.sema_registry_line_has_symbol(line, sym)) {
                    let path = self.sema_registry_line_path(line);
                    if (path.len > 0 && !self.sema_path_loaded(path)) {
                        out = out + path + "\n";
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (prof_start != 0) {
            self.profile_registry_symbol_ms = self.profile_registry_symbol_ms + (vyx_bootstrap_now_ms() - prof_start);
        }
        return out;
    }

    public fn sema_load_registry_symbol_any(self, sym: string) -> bool {
        if (self.import_registry.len == 0 || sym.len == 0) { return false; }
        var loaded_any: bool = false;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.import_registry.len) {
            if (i == self.import_registry.len || self.import_registry.charAt(i) == 10) {
                let line = str_view_range(self.import_registry, start, i);
                if (self.sema_registry_line_has_symbol(line, sym)) {
                    let mod = self.sema_registry_line_module(line);
                    let path = self.sema_registry_line_path(line);
                    if (mod.len > 0
                        && path.len > 0
                        && !self.sema_path_loaded(path)
                        && !self.sema_loaded_covers(mod)
                        && self.sema_pending_has(mod)) {
                        if (self.sema_load_module_path(mod, path)) {
                            loaded_any = true;
                            if (self.sema_symbol_known(sym)) {
                                return true;
                            }
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return loaded_any;
    }

    public fn sema_lazy_symbol_miss_seen(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        return sema_string_state_map_get(self.lazy_symbol_miss_cache, name) != 0;
    }

    public fn sema_lazy_symbol_miss_note(self, name: string) {
        if (name.len == 0) { return; }
        self.lazy_symbol_miss_cache = sema_string_state_map_put(self.lazy_symbol_miss_cache, name, 1);
    }

    public fn sema_lazy_symbol_miss_clear(self) {
        self.lazy_import_epoch = self.lazy_import_epoch + 1;
        self.lazy_symbol_miss_cache = sema_string_state_map_clear(self.lazy_symbol_miss_cache);
        self.lazy_pending_symbol_cache = sema_string_state_map_clear(self.lazy_pending_symbol_cache);
        self.lazy_type_ref_cache = sema_string_state_map_clear(self.lazy_type_ref_cache);
    }

    public fn sema_lazy_type_ref_seen(self, key: string) -> bool {
        if (key.len == 0) { return false; }
        return sema_string_state_map_get(self.lazy_type_ref_cache, key) != 0;
    }

    public fn sema_lazy_type_ref_note(self, key: string) {
        if (key.len == 0) { return; }
        self.lazy_type_ref_cache = sema_string_state_map_put(self.lazy_type_ref_cache, key, 1);
    }

    public fn sema_lazy_pending_symbol_state(self, sym: string) -> i32 {
        if (sym.len == 0) { return 0; }
        return sema_string_state_map_get(self.lazy_pending_symbol_cache, sym);
    }

    public fn sema_lazy_pending_symbol_note(self, sym: string, state: i32) {
        if (sym.len == 0 || state <= 0) { return; }
        self.lazy_pending_symbol_cache = sema_string_state_map_put(self.lazy_pending_symbol_cache, sym, state);
    }

    public fn sema_pending_registry_has_symbol_uncached(self, sym: string) -> bool {
        if (self.import_registry.len == 0 || self.pending_imports.len == 0 || sym.len == 0) {
            return false;
        }
        self.profile_registry_symbol_queries = self.profile_registry_symbol_queries + 1;
        var prof_start: i64 = 0;
        if (vyx_bootstrap_profile_level() > 0) { prof_start = vyx_bootstrap_now_ms(); }
        var reg_start: i32 = 0;
        var ri: i32 = 0;
        while (ri <= self.import_registry.len) {
            if (ri == self.import_registry.len || self.import_registry.charAt(ri) == 10) {
                let line = str_view_range(self.import_registry, reg_start, ri);
                if (self.sema_registry_line_has_symbol(line, sym)) {
                    var pend_start: i32 = 0;
                    var pi: i32 = 0;
                    while (pi <= self.pending_imports.len) {
                        if (pi == self.pending_imports.len || self.pending_imports.charAt(pi) == 10) {
                            let mod = str_view_range(self.pending_imports, pend_start, pi);
                            if (mod.len > 0 && self.sema_registry_request_matches_line(mod, line)) {
                                let path = self.sema_registry_line_path(line);
                                if (path.len > 0 && !self.sema_path_loaded(path)) {
                                    if (prof_start != 0) {
                                        self.profile_registry_symbol_ms = self.profile_registry_symbol_ms + (vyx_bootstrap_now_ms() - prof_start);
                                    }
                                    return true;
                                }
                            }
                            pend_start = pi + 1;
                        }
                        pi = pi + 1;
                    }
                }
                reg_start = ri + 1;
            }
            ri = ri + 1;
        }
        if (prof_start != 0) {
            self.profile_registry_symbol_ms = self.profile_registry_symbol_ms + (vyx_bootstrap_now_ms() - prof_start);
        }
        return false;
    }

    public fn sema_pending_registry_has_symbol(self, sym: string) -> bool {
        if (sym.len == 0) { return false; }
        let cached = self.sema_lazy_pending_symbol_state(sym);
        if (cached == 1) { return true; }
        if (cached == 2) { return false; }
        if (self.sema_pending_registry_has_symbol_uncached(sym)) {
            self.sema_lazy_pending_symbol_note(sym, 1);
            return true;
        }
        self.sema_lazy_pending_symbol_note(sym, 2);
        return false;
    }

    public fn sema_loaded_covers(self, mod: string) -> bool {
        if (mod.len == 0) { return false; }
        return sema_set_has(self.loaded_imports, mod);
    }

    public fn sema_pending_has(self, mod: string) -> bool {
        if (self.pending_imports.len == 0 || mod.len == 0) { return false; }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.pending_imports.len) {
            if (i == self.pending_imports.len || self.pending_imports.charAt(i) == 10) {
                let line = str_view_range(self.pending_imports, start, i);
                if (line == mod) { return true; }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn sema_queue_import(self, mod: string) {
        if (mod.len == 0) { return; }
        if (sema_set_has(self.loading_imports, intern_cat2("M:", mod))) { return; }
        if (self.sema_pending_has(mod)) { return; }
        self.pending_imports = self.pending_imports + mod + "\n";
        self.lazy_pending_symbol_cache = sema_string_state_map_clear(self.lazy_pending_symbol_cache);
        self.lazy_type_ref_cache = sema_string_state_map_clear(self.lazy_type_ref_cache);
    }

    public fn sema_pending_pop(self) -> string {
        if (self.pending_imports.len == 0) { return ""; }
        var i: i32 = 0;
        while (i < self.pending_imports.len) {
            if (self.pending_imports.charAt(i) == 10) {
                let mod = str_view_range(self.pending_imports, 0, i);
                if (i + 1 < self.pending_imports.len) {
                    self.pending_imports = str_view_range(self.pending_imports, i + 1, self.pending_imports.len);
                } else {
                    self.pending_imports = "";
                }
                self.lazy_pending_symbol_cache = sema_string_state_map_clear(self.lazy_pending_symbol_cache);
                self.lazy_type_ref_cache = sema_string_state_map_clear(self.lazy_type_ref_cache);
                return mod;
            }
            i = i + 1;
        }
        let mod = self.pending_imports;
        self.pending_imports = "";
        self.lazy_pending_symbol_cache = sema_string_state_map_clear(self.lazy_pending_symbol_cache);
        self.lazy_type_ref_cache = sema_string_state_map_clear(self.lazy_type_ref_cache);
        return mod;
    }

    public fn sema_find_func_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        var ent = sym_lookup(self.funcs_buf, name);
        if (ent != null) { return ent; }
        let base = generic_call_base(name.clone());
        if (base.len > 0 && base != name) {
            ent = sym_lookup(self.funcs_buf, base);
            if (ent != null) { return ent; }
        }
        let short = module_last_segment(base.clone());
        if (short.len > 0 && short != base) {
            ent = sym_lookup(self.funcs_buf, short);
            if (ent != null) { return ent; }
        }
        return null;
    }

    public fn sema_func_decl_matches_module(self, d: rawptr, module_name: string) -> bool {
        if (module_name.len == 0) { return true; }
        if (d == null) { return false; }
        return self.decl_source_module(d, null) == module_name;
    }


public fn sema_find_func_symbol_in_module(self, name: string, module_name: string) -> rawptr {
        if (name.len == 0 || module_name.len == 0) { return null; }
        return self.cf_find_func_in_module(name.clone(), module_name.clone());
    }

    public fn sema_use_target_covers_module(self, used: string, module_base: string) -> bool {
        if (used.len == 0 || module_base.len == 0) { return false; }
        let used_base = policy_module_base(generic_call_base(used));
        if (used_base == module_base) { return true; }
        let parent = module_parent_path(used_base);
        if (parent.len > 0 && policy_module_base(parent) == module_base) { return true; }
        return false;
    }


public fn sema_short_type_module_visible(self, module_name: string) -> bool {
        if (module_name.len == 0) { return false; }
        let module_base = policy_module_base(module_name);
        if (module_base.len == 0) { return false; }
        if (self.file_module.len > 0
            && policy_module_base(self.file_module.clone()) == module_base) {
            return true;
        }
        if (self.current_unit == null) { return false; }
        var owner_mod: string = "";
        if (self.in_imported_scope && self.cur_owner_decl != null) {
            owner_mod = self.decl_source_module(self.cur_owner_decl, null);
            if (owner_mod.len > 0 && policy_module_base(owner_mod) == module_base) {
                return true;
            }
        }
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            // Entry bodies see only the entry file's `use`s. Imported bodies
            // keep their own file's imports: Batch.vyx `use Zyn.Nut.Types`
            // must still see `Circle` while World.vyx is the compiling entry.
            if (decl_get_kind(cur) == de_USE()) {
                let imported_use = decl_marked_imported(cur);
                var belongs = !imported_use;
                if (imported_use && self.in_imported_scope) {
                    if (owner_mod.len == 0) {
                        belongs = true;
                    } else {
                        let use_from = self.extract_from_module(decl_get_meta(cur));
                        belongs = use_from.len > 0
                            && policy_module_base(use_from) == policy_module_base(owner_mod);
                    }
                }
                if (belongs) {
                    let used = generic_call_base(decl_get_name(cur));
                    if (imported_use) {
                        if (self.sema_use_target_covers_module(used, module_base)) { return true; }
                    } else if (policy_module_base(used) == module_base) {
                        return true;
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return false;
    }


public fn sema_find_class_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        var ent = sym_lookup(self.classes_buf, name);
        if (ent != null) { return ent; }
        let base = generic_call_base(name.clone());
        if (base.len > 0 && base != name) {
            ent = sym_lookup(self.classes_buf, base);
            if (ent != null) { return ent; }
        }
        let short = module_last_segment(base.clone());
        if (short.len > 0 && short == base) {
            let local = self.sema_find_local_short_class_symbol(base.clone());
            if (local != null) { return local; }
            let expanded = self.sema_expand_short_name(base.clone(), false);
            if (expanded.len > 0) {
                ent = self.sema_lookup_class_canonical(expanded);
                if (ent != null) { return ent; }
            }
            ent = self.sema_lookup_class_canonical(base);
            if (ent != null) { return ent; }
            ent = self.sema_find_imported_unique_short_class_symbol(base);
            if (ent != null) { return ent; }
        } else if (base.len > 0) {
            let relative = self.sema_expand_relative_path(base.clone());
            if (relative.len > 0) {
                ent = self.sema_lookup_class_canonical(generic_call_base(relative));
                if (ent != null) { return ent; }
            }
            ent = self.sema_lookup_class_canonical(base);
            if (ent != null) { return ent; }
        }
        return null;
    }

    /// `Result::<i32,PlatformError>` from another module's VYI keeps the
    /// error type short. Local/same-chunk lookup misses the imported
    /// `Mod.PlatformError` entry; pick it when the last segment is unique.
    public fn sema_find_imported_unique_short_class_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        let want = generic_call_base(name.clone());
        if (want.len == 0) { return null; }
        if (module_last_segment(want.clone()) != want) { return null; }
        return self.cs_imported_unique_short_candidate(want.clone());
    }


public fn sema_find_local_short_class_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        if (base.len == 0 || short.len == 0 || short != base) { return null; }
        // A local declaration must win before imported short-name aliases.
        // The symbol table can receive a later alias while lazily loading a
        // module, so scan the declaration chain instead of trusting its head.
        // The scope is loop-invariant; hoisting it keeps `sema_scope_module`
        // off a per-symbol path.
        let scope = policy_module_base(self.sema_scope_module());
        return self.cs_local_short_candidate(base.clone(), scope.clone());
    }

    /// True when the class declaration behind `sym` introduces type
    /// parameters.  Generic declarations must keep their source spelling: the
    /// materialisation path rewrites their instances to
    /// `<module>.Name::<args>` on its own, and qualifying only one side of
    /// that pair made every `return Some(v)` inside `std.core.Option` compare
    /// `Option` against `std.core.Option::<T>`.
    public fn sema_symbol_declares_generic_params(self, sym: rawptr) -> bool {
        if (sym == null) { return false; }
        let d = sym_get_decl(sym);
        if (d == null) { return false; }
        return generic_param_count(decl_get_generic_params(d)) > 0;
    }

    public fn sema_find_visible_short_class_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        let base = generic_call_base(name.clone());
        let expanded = self.sema_expand_short_name(base.clone(), false);
        if (expanded.len > 0) {
            let ent = self.sema_lookup_class_canonical(expanded);
            if (ent != null) { return ent; }
        }
        return self.sema_lookup_class_canonical(base);
    }

    /// A canonical type name can have one symbol-table entry per imported
    /// source version. `sym_lookup` only exposes insertion order, which is not
    /// a version policy and can therefore route ordinary method calls to an
    /// older class while constructor lookup correctly chose the latest one.
    /// Select the newest compatible declaration explicitly and prefer the
    /// richer merged declaration within the same version.
    public fn sema_find_latest_class_symbol(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        if (short.len > 0 && short == base) {
            return self.sema_find_latest_class_symbol_uncached(name);
        }
        sema_memo_ensure();
        let slot = sema_memo_lookup(g_latest_class_memo, self.classes_buf, name);
        if (slot != null) { return sema_memo_slot_value(slot); }
        let found = self.sema_find_latest_class_symbol_uncached(name);
        sema_memo_put(g_latest_class_memo, self.classes_buf, name, found);
        return found;
    }

    public fn sema_find_latest_class_symbol_uncached(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        var want = base.clone();
        if (short.len > 0 && short != base) {
            let relative = self.sema_expand_relative_path(base.clone());
            if (relative.len > 0) {
                want = generic_call_base(relative);
            }
        }
        let want_short = module_last_segment(want.clone());
        let requested_module = module_parent_path(want.clone());
        if (want_short.len > 0 && want_short == want) {
            let local = self.sema_find_local_short_class_symbol(base);
            if (local != null) { return local; }
            let expanded = self.sema_expand_short_name(base.clone(), false);
            if (expanded.len > 0) {
                var expanded_ent = self.sema_lookup_class_canonical(expanded);
                if (expanded_ent != null) { return expanded_ent; }
            }
        }
        var best: rawptr = null;
        var best_module: string = "";
        var scan = self.classes_buf;
        while (scan != null) {
            let candidate_decl = sym_get_decl(scan);
            if (candidate_decl != null
                && (decl_get_kind(candidate_decl) == de_CLASS()
                    || decl_get_kind(candidate_decl) == de_ENUM())) {
                let candidate_name = generic_call_base(decl_get_name(candidate_decl));
                let symbol_name = generic_call_base(sym_get_name(scan));
                let candidate_module = self.decl_source_module(candidate_decl, null);
                let canonical_short_match = requested_module.len > 0
                    && policy_module_base(candidate_module) == requested_module
                    && (module_last_segment(candidate_name.clone()) == want_short
                        || module_last_segment(symbol_name.clone()) == want_short);
                if (candidate_name == want || symbol_name == want
                    || candidate_name == base || symbol_name == base
                    || canonical_short_match) {
                    if (best == null) {
                        best = scan;
                        best_module = candidate_module;
                    } else if (self.sema_versioned_module_pair(candidate_module,
                                                               best_module)) {
                        let version_cmp = policy_semver_compare(
                            policy_module_version(candidate_module),
                            policy_module_version(best_module));
                        if (version_cmp > 0
                            || (version_cmp == 0
                                && self.sema_layout_decl_score(candidate_decl)
                                    > self.sema_layout_decl_score(sym_get_decl(best)))) {
                            best = scan;
                            best_module = candidate_module;
                        }
                    } else if (candidate_module == best_module
                        && self.sema_layout_decl_score(candidate_decl)
                            > self.sema_layout_decl_score(sym_get_decl(best))) {
                        best = scan;
                    }
                }
            }
            scan = sym_get_next(scan);
        }
        if (best != null) { return best; }
        return self.sema_find_class_symbol(name);
    }

    public fn sema_symbol_known(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (self.sema_find_func_symbol(name) != null) { return true; }
        if (self.sema_find_class_symbol(name) != null) { return true; }
        return false;
    }

    public fn sema_decl_chain_tail(self, head: rawptr) -> rawptr {
        var tail = head;
        while (tail != null && decl_get_next(tail) != null) {
            tail = decl_get_next(tail);
        }
        return tail;
    }

    public fn sema_unit_module_name(self, unit: rawptr) -> string {
        if (unit == null) { return ""; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_MODULE()) {
                return policy_module_identity_from_meta(decl_get_name(cur),
                                                        decl_get_meta(cur));
            }
            cur = decl_get_next(cur);
        }
        return "";
    }

    public fn sema_mark_imported_decl_chain(self, head: rawptr, module_name: string) {
        var cur = head;
        while (cur != null) {
            let meta = decl_get_meta(cur);
            if (!string_contains(meta, "|imported")) {
                var new_meta = meta + "|imported";
                if (module_name.len > 0) {
                    new_meta = new_meta + "|from:" + module_name;
                }
                decl_set_meta(cur, new_meta);
            }
            let members = decl_get_members(cur);
            if (members != null) {
                self.sema_mark_imported_decl_chain(members, module_name);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_mark_imported_unit(self, unit: rawptr, module_name: string) {
        if (unit == null) { return; }
        self.sema_mark_imported_decl_chain(unit_get_decls(unit), module_name);
    }

    public fn sema_decl_chain_count(self, head: rawptr) -> i32 {
        var cur = head;
        var n: i32 = 0;
        while (cur != null) {
            n = n + 1;
            cur = decl_get_next(cur);
        }
        return n;
    }

    public fn sema_platform_token_matches_current(self, token: string) -> bool {
        let requested_target = policy_cli_requested_target();
        if (requested_target.len > 0) {
            let requested_platform = policy_target_platform_name(requested_target);
            if (requested_platform.len == 0) { return false; }
            if (token == "posix") {
                return requested_platform == "linux"
                    || requested_platform == "android"
                    || requested_platform == "macos";
            }
            return policy_target_platform_name(token) == requested_platform;
        }
        let platform = vyx_bootstrap_platform();
        if (token == "posix") {
            return platform == 2 || platform == 3 || platform == 4;
        }
        if (token == "windows" || token == "win32" || token == "msvc") {
            return platform == 1;
        }
        if (token == "linux") {
            return platform == 2;
        }
        if (token == "android") {
            return platform == 3;
        }
        if (token == "macos" || token == "darwin" || token == "apple") {
            return platform == 4;
        }
        return false;
    }

    public fn sema_platform_attr_token_char(self, c: i32) -> bool {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        if (c == 95 || c == 45) { return true; }
        return false;
    }

    public fn sema_platform_clause_matches_current(self, meta: string, start: i32) -> bool {
        var i = start;
        var token: string = "";
        while (i < meta.len) {
            let c = meta.charAt(i);
            if (c == 41) {
                if (token.len > 0 && self.sema_platform_token_matches_current(token)) {
                    return true;
                }
                return false;
            }
            if (self.sema_platform_attr_token_char(c)) {
                token = token + str_view_range(meta, i, i + 1);
            } else {
                if (token.len > 0 && self.sema_platform_token_matches_current(token)) {
                    return true;
                }
                token = "";
            }
            i = i + 1;
        }
        if (token.len > 0) {
            return self.sema_platform_token_matches_current(token);
        }
        return false;
    }

    public fn sema_decl_active_on_current_platform(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let meta = decl_get_meta(d);
        var saw_platform = false;
        var i: i32 = 0;
        while (i + 9 <= meta.len) {
            if (str_view_range(meta, i, i + 9) == "platform(") {
                saw_platform = true;
                // A platform clause is semantic only after the registered
                // `platform.select` handler has accepted it.  Invalid or
                // unregistered spellings remain visible to the late Effect
                // pass so they fail with a diagnostic instead of silently
                // selecting a target.
                if (meta.indexOf("|effect:platform|") < 0) {
                    i = i + 1;
                    continue;
                }
                if (self.sema_platform_clause_matches_current(meta, i + 9)) {
                    return true;
                }
            }
            i = i + 1;
        }
        return !saw_platform;
    }

    public fn sema_filter_platform_decl_chain(self, head: rawptr) -> rawptr {
        var out_head: rawptr = null;
        var out_tail: rawptr = null;
        var cur = head;
        while (cur != null) {
            let next = decl_get_next(cur);
            decl_set_next(cur, null);
            if (self.sema_decl_active_on_current_platform(cur)) {
                let members = decl_get_members(cur);
                if (members != null) {
                    decl_set_members(cur, self.sema_filter_platform_decl_chain(members));
                }
                if (out_head == null) {
                    out_head = cur;
                    out_tail = cur;
                } else {
                    decl_set_next(out_tail, cur);
                    out_tail = cur;
                }
            }
            cur = next;
        }
        return out_head;
    }

    public fn host_analyze_filter_platform_decls(self, unit: rawptr) {
        if (unit == null) { return; }
        let filtered = self.sema_filter_platform_decl_chain(unit_get_decls(unit));
        unit_set_decls(unit, filtered);
        unit_set_decl_count(unit, self.sema_decl_chain_count(filtered));
    }

    public fn sema_decl_has_empty_body(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let k = decl_get_kind(d);
        if (k != de_FN() && k != de_METHOD()) { return false; }
        let body = decl_get_body(d);
        if (body == null) { return false; }
        if (stmt_get_kind(body) != st_BLOCK()) { return false; }
        return stmt_get_body(body) == null;
    }

    public fn sema_warn_empty_body_decl(self, d: rawptr) {
        if (!self.sema_decl_has_empty_body(d)) { return; }
        let meta = decl_get_meta(d);
        if (string_contains(meta, "|empty_body_warned")) { return; }
        sema_stamp_loc_from_decl(d);
        diag_emit_at(diag_sev_WARNING(),
                     diag_code_sema_generic(),
                     sema_current_loc_ptr(),
                     "unimplemented empty function body: " + decl_get_name(d));
        decl_set_meta(d, meta + "|empty_body_warned");
    }

    public fn sema_warn_empty_body_decl_chain(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            self.sema_warn_empty_body_decl(cur);
            let members = decl_get_members(cur);
            if (members != null) {
                self.sema_warn_empty_body_decl_chain(members);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn host_analyze_warn_empty_bodies(self, unit: rawptr) {
        if (unit == null) { return; }
        self.sema_warn_empty_body_decl_chain(unit_get_decls(unit));
    }

    public fn sema_append_unit(self, dst: rawptr, src: rawptr) -> i32 {
        if (dst == null || src == null) { return 0; }
        var head = unit_get_decls(src);
        if (head == null) { return 0; }
        let src_module = self.sema_unit_module_name(src);
        self.sema_mark_imported_unit(src, src_module);
        let src_tail = self.sema_decl_chain_tail(head);
        var imported: i32 = 0;
        var cur = head;
        while (cur != null) {
            imported = imported + 1;
            cur = decl_get_next(cur);
        }
        let dst_head = unit_get_decls(dst);
        if (dst_head == null) {
            unit_set_decls(dst, head);
            self.current_tail = src_tail;
        } else if (self.current_tail != null) {
            decl_set_next(self.current_tail, head);
            self.current_tail = src_tail;
        } else {
            let tail = self.sema_decl_chain_tail(dst_head);
            decl_set_next(tail, head);
            self.current_tail = src_tail;
        }
        unit_set_decl_count(dst, unit_get_decl_count(dst) + imported);
        return imported;
    }

    // `.vyi` files produced by the AOT interface emitter carry a versioned
    // AST graph after the ordinary signature text.  Keep extraction here
    // deliberately strict: once any artifact marker is present, malformed or
    // unverifiable payloads must fail closed instead of falling back to the
    // body-less interface text.  The decoder receives the canonical three-line
    // comment block emitted by the producer.
    fn sema_template_artifact_block(source: string) -> string {
        let begin_marker = "// VYX_TEMPLATE_ARTIFACT_BEGIN ";
        let payload_marker = "// VYX_TEMPLATE_ARTIFACT_PAYLOAD ";
        let end_marker = "// VYX_TEMPLATE_ARTIFACT_END";
        let begin = source.indexOf(begin_marker);
        if (begin < 0) { return ""; }
        let begin_tail = str_view_range(source, begin as i32, source.len as i32);
        let begin_nl = begin_tail.indexOf("\n");
        if (begin_nl < 0) { return ""; }
        let begin_end = (begin as i32) + (begin_nl as i32);

        let payload_search = str_view_range(source, (begin_end + 1), source.len as i32);
        let payload_rel = payload_search.indexOf(payload_marker);
        if (payload_rel < 0) { return ""; }
        let payload = (begin_end + 1) + (payload_rel as i32);
        let payload_tail = str_view_range(source, payload, source.len as i32);
        let payload_nl = payload_tail.indexOf("\n");
        if (payload_nl < 0) { return ""; }
        let payload_end = payload + (payload_nl as i32);

        let end_search = str_view_range(source, (payload_end + 1), source.len as i32);
        let end_rel = end_search.indexOf(end_marker);
        if (end_rel < 0) { return ""; }
        let end = (payload_end + 1) + (end_rel as i32);
        let end_tail = str_view_range(source, end, source.len as i32);
        let end_nl = end_tail.indexOf("\n");
        let end_line = if (end_nl < 0) {
            end_tail.trim()
        } else {
            str_view_range(end_tail, 0, end_nl as i32).trim()
        };
        if (end_line != end_marker) { return ""; }

        // Preserve the comment introducers: the artifact decoder validates the
        // exact producer spelling and hashes only the payload bytes.
        let begin_line = str_view_range(source, begin as i32, begin_end).trim();
        let payload_line = str_view_range(source, payload, payload_end).trim();
        let end_line_plain = str_view_range(source, end, end + end_marker.len).trim();
        if (begin_line.len == 0 || payload_line.len == 0 || end_line_plain != end_marker) {
            return "";
        }
        return begin_line + "\n" + payload_line + "\n" + end_line_plain;
    }

    fn sema_template_artifact_field(header: string, key: string) -> string {
        if (header.len == 0 || key.len == 0) { return ""; }
        let needle = key + "=";
        let at = header.indexOf(needle);
        if (at < 0) { return ""; }
        var start = (at as i32) + needle.len;
        var end = start;
        while (end < header.len && header.charAt(end) != 32 && header.charAt(end) != 9) {
            end = end + 1;
        }
        return str_view_range(header, start, end);
    }

    fn sema_template_artifact_stamp(self, header: string) -> string {
        var stamp = "|template-artifact|";
        let producer = self.sema_template_artifact_field(header, "producer");
        let module_id = self.sema_template_artifact_field(header, "module");
        let opts = self.sema_template_artifact_field(header, "opts");
        let surface = self.sema_template_artifact_field(header, "surface");
        let payload = self.sema_template_artifact_field(header, "payload");
        let version = self.sema_template_artifact_field(header, "v");
        if (version.len > 0) { stamp = stamp + "artifact-version:" + version + "|"; }
        if (producer.len > 0) { stamp = stamp + "artifact-producer:" + producer + "|"; }
        if (module_id.len > 0) { stamp = stamp + "artifact-module:" + module_id + "|"; }
        if (opts.len > 0) { stamp = stamp + "artifact-opts:" + opts + "|"; }
        if (surface.len > 0) { stamp = stamp + "artifact-surface:" + surface + "|"; }
        if (payload.len > 0) { stamp = stamp + "artifact-payload:" + payload + "|"; }
        return stamp;
    }

    fn sema_mark_template_artifact_decl_chain(self, head: rawptr, stamp: string) {
        var cur = head;
        while (cur != null) {
            let meta = decl_get_meta(cur);
            if (!string_contains(meta, "|template-artifact")) {
                decl_set_meta(cur, meta + stamp);
            }
            let members = decl_get_members(cur);
            if (members != null) {
                self.sema_mark_template_artifact_decl_chain(members, stamp);
            }
            cur = decl_get_next(cur);
        }
    }

    fn sema_mark_template_artifact_unit(self, unit: rawptr, artifact: string) {
        if (unit == null || artifact.len == 0) { return; }
        let header_end = artifact.indexOf("\n");
        if (header_end < 0) { return; }
        let header = str_view_range(artifact, 0, header_end as i32);
        var stamp = self.sema_template_artifact_stamp(header);
        let artifact_module = template_artifact_unit_module(unit);
        if (artifact_module.len > 0) {
            stamp = stamp + "artifact-module-name:" + artifact_module + "|";
        }
        self.sema_mark_template_artifact_decl_chain(unit_get_decls(unit), stamp);
    }

    public fn sema_parse_module_file(self, path: string) -> rawptr {
        if (path.len == 0) { return null; }
        let source = sema_source_read(path);
        if (source.len == 0 && !fileExists(path) && !sema_source_has_overlay(path)) { return null; }

        // A marker anywhere in the file opts the file into strict artifact
        // handling.  In particular, a truncated payload cannot silently turn
        // into a signature-only unit and lose private generic dependencies.
        let marker_at = source.indexOf("// VYX_TEMPLATE_ARTIFACT_");
        let is_vyi = path.endsWith(".vyi") || path.endsWith(".VYI");
        if (is_vyi && marker_at >= 0) {
            let artifact = self.sema_template_artifact_block(source);
            if (artifact.len == 0 || !template_artifact_has(source)) {
                return null;
            }
            // Decode against the complete `.vyi`, not the extracted block.
            // This preserves the producer's surface bytes for the decoder's
            // surface identity check while the strict block still guards
            // marker order and trailing garbage.
            let decoded = template_artifact_decode(source);
            if (decoded == null) { return null; }
            self.sema_mark_template_artifact_unit(decoded, artifact);
            self.sema_mark_unit_source_path(decoded, path);
            return decoded;
        }

        let lx = lex_source(source);
        if (lx == null) { return null; }
        if (lex_error_count(lx) > 0) {
            vyx_lsp_bind_parse_errors(lex_error_count(lx));
            lexer_dispose(lx);
            return null;
        }
        vyx_lsp_bind_parse_push(path.clone().c_str());
        let service_import_mode = parser_service_import_signatures(vyx_lsp_bind_root() != null);
        let unit = parse_unit(lx);
        parser_service_import_signatures(service_import_mode);
        vyx_lsp_bind_parse_pop();
        lexer_dispose(lx);
        if (unit == null) { return null; }
        parser_auto_qualify_std_modules(unit);
        parser_auto_qualify_imported_module_types(unit);
        return unit;
    }

    fn sema_stamp_source_path(self, d: rawptr, path: string) {
        if (d == null || path.len == 0) { return; }
        let meta = decl_get_meta(d);
        if (!string_contains(meta, "|source-path:")) {
            decl_set_meta(d, meta + "|source-path:" + path + "|");
        }
    }

    fn sema_stamp_source_path_tree(self, d: rawptr, path: string) {
        if (d == null) { return; }
        self.sema_stamp_source_path(d, path);
        var mp = decl_get_members(d);
        while (mp != null) {
            self.sema_stamp_source_path_tree(mp, path);
            mp = decl_get_next(mp);
        }
    }

    public fn sema_mark_unit_source_path(self, unit: rawptr, path: string) {
        if (unit == null || path.len == 0) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            self.sema_stamp_source_path_tree(cur, path);
            cur = decl_get_next(cur);
        }
    }


fn sema_decl_source_path(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        return self.sema_extract_source_path_meta(decl_get_meta(d));
    }

    fn sema_diag_cached_read(self, path: string) -> string {
        if (path.len == 0) { return ""; }
        // A single-entry cache thrashes whenever decls from two or more files
        // alternate, which turns every body resolution into a full source read.
        if (path == g_diag_src_path0) { return g_diag_src_text0; }
        if (path == g_diag_src_path1) { return g_diag_src_text1; }
        if (path == g_diag_src_path2) { return g_diag_src_text2; }
        if (path == g_diag_src_path3) { return g_diag_src_text3; }
        let src = sema_source_read(path);
        g_diag_src_path3 = g_diag_src_path2;
        g_diag_src_text3 = g_diag_src_text2;
        g_diag_src_path2 = g_diag_src_path1;
        g_diag_src_text2 = g_diag_src_text1;
        g_diag_src_path1 = g_diag_src_path0;
        g_diag_src_text1 = g_diag_src_text0;
        g_diag_src_path0 = path;
        g_diag_src_text0 = src;
        return src;
    }

    public fn sema_bind_unit_source_paths(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            let source_path = self.sema_extract_source_path_meta(decl_get_meta(cur));
            if (source_path.len > 0) {
                self.sema_mark_path_loaded(source_path);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_scan_loaded_imports(self, unit: rawptr) {
        if (unit == null) { return; }
        self.sema_bind_unit_source_paths(unit);
        var cur = unit_get_decls(unit);
        while (cur != null) {
            let cur_meta = decl_get_meta(cur);
            if (string_contains(cur_meta, "|imported")) {
                let from_mod = self.extract_from_module(cur_meta);
                if (from_mod.len > 0) {
                    self.loaded_imports = sema_set_add(self.loaded_imports, from_mod);
                }
            }
            if (decl_get_kind(cur) == de_USE()) {
                let target = decl_get_name(cur);
                let alias = sema_use_decl_alias_name(cur_meta);
                if (alias.len > 0) {
                    let parent = module_parent_path(generic_call_base(target.clone()));
                    if (parent.len > 0 && !self.sema_loaded_covers(parent.clone())) {
                        self.sema_queue_import(parent);
                    }
                } else if (!self.sema_loaded_covers(target.clone())) {
                    self.sema_queue_import(target);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_queue_use_decls(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let target = decl_get_name(cur);
                let alias = sema_use_decl_alias_name(decl_get_meta(cur));
                if (alias.len > 0) {
                    let parent = module_parent_path(generic_call_base(target.clone()));
                    if (parent.len > 0 && !self.sema_loaded_covers(parent.clone())) {
                        self.sema_queue_import(parent);
                    }
                } else if (!self.sema_loaded_covers(target.clone())) {
                    self.sema_queue_import(target);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_queue_migration_sources_decl_chain(self,
                                                      head: rawptr,
                                                      current_module: string) {
        if (head == null || current_module.len == 0) { return; }
        let module_base = policy_module_base(current_module);
        let module_variant = policy_module_variant(current_module);
        var cur = head;
        while (cur != null) {
            var attr_args = policy_meta_attribute_value(decl_get_meta(cur), "migrate");
            if (attr_args.len == 0) {
                attr_args = policy_meta_attribute_value(decl_get_meta(cur), "discard");
            }
            if (attr_args.len > 0) {
                let from_version = policy_strip_quoted_string(
                    policy_named_argument_value(attr_args, "fromVer"));
                if (from_version.len > 0) {
                    let source_module = policy_module_identity(module_base,
                                                               from_version,
                                                               module_variant);
                    if (source_module.len > 0 && source_module != current_module) {
                        self.sema_queue_import(source_module);
                    }
                }
            }
            let members = decl_get_members(cur);
            if (members != null) {
                self.sema_queue_migration_sources_decl_chain(members, current_module);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_queue_migration_sources(self, unit: rawptr, current_module: string) {
        if (unit == null) { return; }
        self.sema_queue_migration_sources_decl_chain(unit_get_decls(unit), current_module);
    }

    public fn sema_load_queued_imports(self) {
        var guard: i32 = 0;
        while (self.pending_imports.len > 0 && guard < 256) {
            let mod = self.sema_pending_pop();
            if (mod.len > 0
                && mod != "std"
                && !self.sema_loaded_covers(mod)) {
                let queued_paths = self.sema_registry_paths_for_module(mod);
                if (queued_paths.len > 0) {
                    self.sema_load_module(mod);
                }
            }
            guard = guard + 1;
        }
    }

    public fn sema_scan_lang_items_merge(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            let meta = decl_get_meta(cur);
            if (meta.len > 0) {
                let slot = sema_extract_lang_item_slot(meta);
                if (slot.len > 0) {
                    lang_items_register(self.lang_items, slot, cur);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_lazy_load_decl_signature_symbols(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            if (!decl_is_foreign_import(cur)) {
                self.sema_lazy_load_decl_signature_one(cur);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_lazy_load_decl_signature_symbols_all(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            self.sema_lazy_load_decl_signature_one(cur);
            cur = decl_get_next(cur);
        }
    }

    public fn sema_lazy_load_decl_signature_one(self, d: rawptr) {
        if (d == null) { return; }
        if (self.too_many_errors()) { return; }
        // Signatures in a unity crate belong to their declaring module. Resolve
        // aliases before call checking, independently of body traversal order.
        let saved_chunk = self.cur_chunk_module;
        let saved_body = self.cur_body_decl;
        let saved_owner = self.cur_owner_decl;
        let saved_owner_class = self.cur_owner_class;
        let saved_generics = self.cur_generic_params;
        self.cur_chunk_module = self.decl_source_module(d, saved_owner);
        self.cur_body_decl = d;
        self.cur_generic_params = merge_generic_params(saved_generics, decl_get_generic_params(d));
        if (decl_get_kind(d) == de_CLASS()) {
            self.cur_owner_decl = d;
            self.cur_owner_class = decl_get_name(d);
        }
        self.profile_lazy_sig_decl_count = self.profile_lazy_sig_decl_count + 1;
        self.sema_lazy_load_generic_bound_symbols(decl_get_generic_params(d));
        self.sema_lazy_load_type_ref_symbols(decl_get_ty(d));
        var p = decl_get_params(d);
        while (p != null && !self.too_many_errors()) {
            self.sema_lazy_load_generic_bound_symbols(decl_get_generic_params(p));
            self.sema_lazy_load_type_ref_symbols(decl_get_ty(p));
            p = decl_get_next(p);
        }
        var m = decl_get_members(d);
        while (m != null && !self.too_many_errors()) {
            self.sema_lazy_load_decl_signature_one(m);
            m = decl_get_next(m);
        }
        self.cur_chunk_module = saved_chunk;
        self.cur_body_decl = saved_body;
        self.cur_owner_decl = saved_owner;
        self.cur_owner_class = saved_owner_class;
        self.cur_generic_params = saved_generics;
    }

    public fn sema_apply_loaded_module_passes(self, unit: rawptr) {
        if (unit == null) { return; }
        let saved_chunk = self.cur_chunk_module;
        let saved_unit = self.current_unit;
        let chunk = self.sema_unit_module_name(unit);
        if (chunk.len > 0) { self.cur_chunk_module = chunk; }
        self.current_unit = unit;
        self.host_analyze_prepare_effect_markers(unit);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_filter_platform_decls(unit);
        sema_phase_done("host_analyze_filter_platform_decls_unit;", phase_t);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_pass0_import_aliases(unit);
        sema_phase_done("host_analyze_pass0_import_aliases_unit;", phase_t);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_apply_prelude_imports(unit);
        sema_phase_done("host_analyze_apply_prelude_imports_unit;", phase_t);
        self.sema_scan_lang_items_merge(unit);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_phase_a_primitive_impl_facts(unit);
        sema_phase_done("host_analyze_phase_a_primitive_impl_facts_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.collect_decls(unit);
        sema_phase_done("collect_decls_unit;", phase_t);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        var phase_t: i64 = sema_phase_enter();
        self.flatten_all_inherited_layouts();
        sema_phase_done("flatten_all_inherited_layouts_;", phase_t);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        self.sema_lazy_load_decl_signature_symbols_all(unit);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_register_std_short_name_aliases(unit);
        sema_phase_done("host_analyze_register_std_short_name_aliases_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_synthesize_derive_methods(unit);
        sema_phase_done("host_analyze_synthesize_derive_methods_unit;", phase_t);
        if (self.too_many_errors()) {
            self.current_unit = saved_unit;
            self.cur_chunk_module = saved_chunk;
            return;
        }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_phase_a_primitive_impl_facts(unit);
        sema_phase_done("host_analyze_phase_a_primitive_impl_facts_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_inject_structural_trait_defaults(unit);
        sema_phase_done("host_analyze_inject_structural_trait_defaults_unit;", phase_t);
        self.current_unit = saved_unit;
        self.cur_chunk_module = saved_chunk;
    }

    public fn sema_load_module_path_with_mode(self, mod: string, path: string, mark_full_module: bool) -> bool {
        if (self.too_many_errors()) { return false; }
        if (path.len == 0) { return false; }
        if (self.sema_path_loaded(path)) { return false; }
        self.sema_mark_path_loaded(path);
        self.profile_module_load_calls = self.profile_module_load_calls + 1;
        var prof_start: i64 = 0;
        if (vyx_bootstrap_profile_level() > 0) { prof_start = vyx_bootstrap_now_ms(); }
        let imported = self.sema_parse_module_file(path);
        if (imported == null) {
            self.report_error_help(diag_code_sema_undefined(),
                                   g_sema_cur_loc,
                                   "failed to load module '" + mod + "' from '" + path + "'",
                                   "fix the file path, or register the module in the package search path");
            if (prof_start != 0) {
                self.profile_module_load_ms = self.profile_module_load_ms + (vyx_bootstrap_now_ms() - prof_start);
            }
            return false;
        }
        self.sema_mark_unit_source_path(imported, path);
        self.sema_lazy_symbol_miss_clear();
        let actual_mod = self.sema_unit_module_name(imported);
        self.sema_queue_use_decls(imported);
        self.sema_mark_imported_unit(imported, actual_mod);
        self.sema_queue_migration_sources(imported, actual_mod);
        if (mark_full_module && actual_mod.len > 0) {
            self.sema_queue_import(actual_mod);
        }
        self.sema_apply_loaded_module_passes(imported);
        let n = self.sema_append_unit(self.current_unit, imported);
        if (mark_full_module && actual_mod.len > 0) {
            self.loaded_imports = sema_set_add(self.loaded_imports, actual_mod);
        }
        if (mark_full_module) {
            self.sema_load_queued_imports();
        }
        if (prof_start != 0) {
            self.profile_module_load_ms = self.profile_module_load_ms + (vyx_bootstrap_now_ms() - prof_start);
        }
        return n > 0;
    }

    public fn sema_load_module_path(self, mod: string, path: string) -> bool {
        return self.sema_load_module_path_with_mode(mod, path, true);
    }

    public fn sema_load_module_facade(self, mod: string) -> bool {
        if (self.too_many_errors()) { return false; }
        if (mod.len == 0 || mod == "std") { return false; }
        if (sema_set_has(self.loading_imports, intern_cat2("F:", mod))) { return false; }
        let paths = self.sema_registry_paths_for_module_facade(mod);
        if (paths.len == 0) { return false; }
        self.loading_imports = sema_set_add(self.loading_imports, intern_cat2("F:", mod));
        var loaded_any: bool = false;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= paths.len) {
            if (i == paths.len || paths.charAt(i) == 10) {
                let path = str_view_range(paths, start, i);
                if (path.len > 0 && self.sema_load_module_path_with_mode(mod, path, false)) {
                    loaded_any = true;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (loaded_any) {
            self.host_analyze_register_std_short_name_aliases(self.current_unit);
            self.host_analyze_inject_structural_trait_defaults(self.current_unit);
        }
        return loaded_any;
    }

    public fn sema_load_module_symbol(self, mod: string, sym: string) -> bool {
        if (mod.len == 0 || sym.len == 0) { return false; }
        if (self.sema_named_in_module(mod.clone(), sym.clone())) { return true; }
        if (sema_set_has(self.loading_imports, intern_cat4("M:", mod, "#", sym))) { return false; }
        if (self.import_registry.len == 0) { return false; }
        let paths = self.sema_registry_paths_for_symbol(mod, sym);
        if (paths.len == 0) { return false; }
        self.loading_imports = sema_set_add(self.loading_imports, intern_cat4("M:", mod, "#", sym));
        var loaded_any: bool = false;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= paths.len) {
            if (i == paths.len || paths.charAt(i) == 10) {
                let path = str_view_range(paths, start, i);
                if (path.len > 0 && self.sema_load_module_path_with_mode(mod, path, false)) {
                    loaded_any = true;
                    if (self.sema_named_in_module(mod.clone(), sym.clone())) {
                        break;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (loaded_any) {
            self.host_analyze_register_std_short_name_aliases(self.current_unit);
            self.host_analyze_inject_structural_trait_defaults(self.current_unit);
        }
        return loaded_any;
    }

    public fn sema_load_module(self, mod: string) -> bool {
        if (self.too_many_errors()) { return false; }
        if (mod.len == 0) { return false; }
        if (self.sema_name_is_type_path(mod.clone())) { return false; }
        if (!string_contains(mod, ".") && mod != "std"
            && !self.sema_module_path_registered(mod.clone())) {
            return false;
        }
        if (self.sema_loaded_covers(mod)) { return true; }
        if (sema_set_has(self.loading_imports, intern_cat2("M:", mod))) { return true; }
        if (self.sema_registry_loaded_path_covers_module(mod.clone())) {
            self.loaded_imports = sema_set_add(self.loaded_imports, mod);
            return true;
        }
        if (self.import_registry.len == 0) {
            self.report_error_help(diag_code_sema_undefined(),
                                   g_sema_cur_loc,
                                   "unknown module '" + mod + "'",
                                   "add a `use` import and list the module in the package registry");
            return false;
        }
        let paths = self.sema_registry_paths_for_module(mod);
        if (paths.len == 0) {
            self.report_error_help(diag_code_sema_undefined(),
                                   g_sema_cur_loc,
                                   "unknown module '" + mod + "'",
                                   "add a `use` import and list the module in the package registry");
            return false;
        }
        let saved_head = self.cur_locals;
        let saved_count = self.locals_count;
        let saved_ret = self.cur_ret_ty;
        let saved_gp = self.cur_generic_params;
        let saved_owner_class = self.cur_owner_class;
        let saved_owner_decl = self.cur_owner_decl;
        let saved_body_decl = self.cur_body_decl;
        let saved_imported = self.in_imported_scope;
        let saved_moved_head = self.moved_buf;
        let saved_moved_count = self.moved_count;
        let saved_field_moved = self.field_moved_buf;
        let saved_capture = self.capture_borrow_guards;
        self.cur_locals = null;
        self.locals_count = 0;
        self.cur_ret_ty = null;
        self.cur_generic_params = "";
        self.cur_owner_class = "";
        self.cur_owner_decl = null;
        self.cur_body_decl = null;
        self.moved_buf = null;
        self.moved_count = 0;
        self.field_moved_buf = null;
        self.capture_borrow_guards = null;

        self.loading_imports = sema_set_add(self.loading_imports, intern_cat2("M:", mod));
        var start: i32 = 0;
        var i: i32 = 0;
        var loaded_any: bool = false;
        while (i <= paths.len) {
            if (i == paths.len || paths.charAt(i) == 10) {
                let path = str_view_range(paths, start, i);
                if (path.len > 0 && self.sema_load_module_path(mod, path)) {
                    loaded_any = true;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (loaded_any) {
            self.host_analyze_register_std_short_name_aliases(self.current_unit);
            self.host_analyze_inject_structural_trait_defaults(self.current_unit);
            self.loaded_imports = sema_set_add(self.loaded_imports, mod);
        }

        self.cur_locals = saved_head;
        self.locals_count = saved_count;
        self.cur_ret_ty = saved_ret;
        self.cur_generic_params = saved_gp;
        self.cur_owner_class = saved_owner_class;
        self.cur_owner_decl = saved_owner_decl;
        self.cur_body_decl = saved_body_decl;
        self.in_imported_scope = saved_imported;
        self.moved_buf = saved_moved_head;
        self.moved_count = saved_moved_count;
        self.field_moved_buf = saved_field_moved;
        self.capture_borrow_guards = saved_capture;
        return loaded_any;
    }

    public fn sema_is_core_prelude_symbol(self, name: string) -> bool {
        if (name == "Result" || name == "Option") { return true; }
        if (name == "Ok" || name == "Err") { return true; }
        if (name == "Some" || name == "None") { return true; }
        return false;
    }

    /// Query each distinct spelling once. A plain name has name == base ==
    /// short; repeating a miss also repeats namespace and glob-use resolution.
    fn sema_symbol_variants_known(self, name: string, base: string, short: string) -> bool {
        if (self.sema_symbol_known(name)) { return true; }
        if (base.len > 0 && base != name && self.sema_symbol_known(base)) {
            return true;
        }
        return short.len > 0 && short != name && short != base
            && self.sema_symbol_known(short);
    }

    public fn sema_lazy_load_pending_until_symbol(self, name: string) -> bool {
        self.profile_lazy_pending_calls = self.profile_lazy_pending_calls + 1;
        if (name.len == 0) { return false; }
        let base = generic_call_base(name.clone());
        let short = module_last_segment(base.clone());
        if (self.sema_symbol_variants_known(name, base, short)) {
            return true;
        }
        if (self.sema_load_type_alias_target_if_any(name.clone())
            || (base.len > 0 && base != name && self.sema_load_type_alias_target_if_any(base.clone()))
            || (short.len > 0 && short != base && self.sema_load_type_alias_target_if_any(short.clone()))) {
            if (self.sema_symbol_variants_known(name, base, short)) {
                return true;
            }
        }
        let miss_key = intern_cat4(name, "#", base, intern_cat2("#", short));
        if (self.sema_lazy_symbol_miss_seen(miss_key)) { return false; }
        var progressed: bool = false;

        let pending_has_name = self.sema_pending_registry_has_symbol(name);
        let pending_has_base = base.len > 0
            && base != name
            && self.sema_pending_registry_has_symbol(base);
        let pending_has_short = short.len > 0
            && short != base
            && self.sema_pending_registry_has_symbol(short);
        if (pending_has_name || pending_has_base || pending_has_short) {
            let pending = self.pending_imports;
            var start: i32 = 0;
            var i: i32 = 0;
            while (i <= pending.len) {
                if (i == pending.len || pending.charAt(i) == 10) {
                    let mod = str_view_range(pending, start, i);
                    if (mod.len > 0) {
                        let epoch_before_load = self.lazy_import_epoch;
                        if (pending_has_name && self.sema_load_module_symbol(mod, name)) {
                            progressed = true;
                        }
                        if (pending_has_base && self.sema_load_module_symbol(mod, base)) {
                            progressed = true;
                        }
                        if (pending_has_short && self.sema_load_module_symbol(mod, short)) {
                            progressed = true;
                        }
                        // A loader's bool reports appended declarations, not
                        // all side effects. Nested imports and an empty/filtered
                        // import can change facts even if that bool is false.
                        // Re-query only across an actual import mutation window.
                        if (self.lazy_import_epoch != epoch_before_load
                            && self.sema_symbol_variants_known(name, base, short)) {
                            return true;
                        }
                    }
                    start = i + 1;
                }
                i = i + 1;
            }
        }

        if (self.sema_is_core_prelude_symbol(name)
            || (base.len > 0 && self.sema_is_core_prelude_symbol(base))
            || (short.len > 0 && self.sema_is_core_prelude_symbol(short))) {
            if (self.sema_load_module_symbol("std.core", name)) { progressed = true; }
            if (base.len > 0 && base != name && self.sema_load_module_symbol("std.core", base)) {
                progressed = true;
            }
            if (short.len > 0 && short != base && self.sema_load_module_symbol("std.core", short)) {
                progressed = true;
            }
            if (self.sema_symbol_variants_known(name, base, short)) {
                return true;
            }
        }
        if (pending_has_name && self.sema_load_registry_symbol_any(name)) { progressed = true; }
        if (pending_has_base && self.sema_load_registry_symbol_any(base)) {
            progressed = true;
        }
        if (pending_has_short && self.sema_load_registry_symbol_any(short)) {
            progressed = true;
        }
        let known_after = self.sema_symbol_variants_known(name, base, short);
        if (known_after) {
            return true;
        }
        if (progressed) {
            return false;
        }
        self.sema_lazy_symbol_miss_note(miss_key);
        return false;
    }

    // ────────────────────────────────────────────────────────────────
    //   Diagnostics — every helper bumps `error_count`.
    // ────────────────────────────────────────────────────────────────

    public fn too_many_errors(self) -> bool {
        return diag_too_many_errors();
    }

    /// Uncoded leftover path. Prefer `report_error_coded` / `error_unknown`
    /// / `error_mismatch_at`. If `msg` already carries `Exxxx:`, that tag
    /// is kept; otherwise this is `E3000`.
    public fn report_error_at(self, loc: rawptr, msg: string) {
        var anchor = loc;
        if (anchor == null) { anchor = g_sema_cur_loc; }
        let code = diag_classify_sema_message(msg);
        diag_emit_at(diag_sev_ERROR(), code, anchor, msg);
        self.error_count = self.error_count + 1;
    }

    /// Use the current ast-walk anchor for callers without a more precise
    /// expression location.
    public fn report_error(self, msg: string) {
        self.report_error_at(g_sema_cur_loc, msg);
    }

    /// `error_mismatch` always carries the `SEMA-005-TypeMismatch`
    /// code; the formatted message keeps the original "type mismatch
    /// <got> vs <want>" shape so existing transcripts and tests match.
    public fn error_mismatch(self, ctx: string, want: rawptr, got: rawptr) {
        self.error_mismatch_at(ctx, want, got, g_sema_cur_loc);
    }

    public fn error_mismatch_at(self,
                                ctx: string,
                                want: rawptr,
                                got: rawptr,
                                loc: rawptr) {
        let msg = ctx + ": type mismatch " + tref_label(got) + " vs " + tref_label(want);
        diag_emit_at(diag_sev_ERROR(),
                     diag_code_sema_type_mismatch(),
                     loc,
                     msg);
        self.error_count = self.error_count + 1;
        diag_emit_help_at(diag_code_sema_type_mismatch(),
                            loc,
                            "change the value to `" + tref_label(want)
                                + "`, or change the expected type from `"
                                + tref_label(want) + "` to `" + tref_label(got) + "`");
    }

    /// `error_unknown` is the dedicated name-lookup-miss path; routes
    /// to `SEMA-008-Undefined`. Used for unresolved identifiers that
    /// the dispatcher otherwise wouldn't see (the message is just the
    /// name, with no marker prefix).
    public fn error_unknown(self, name: string) {
        self.report_error_help(diag_code_sema_undefined(),
                               g_sema_cur_loc,
                               "unknown name '" + name + "'",
                               "check spelling, add a `use` import, or declare a local/function/type with this name");
    }

    /// WU6 hook — explicit code + loc when the caller already has the
    /// matching diagnostic class. Used by `sema_clone_*_env` family
    /// when they overflow the depth limit and by any future Sema/Mono
    /// helper that wants a specific host code.
    public fn report_error_coded(self, code: string, loc: rawptr, msg: string) {
        if (self.unsafe_depth > 0
            && (code == diag_code_v_move_001()
                || code == diag_code_v_borrow_invalidation())) {
            return;
        }
        var anchor = loc;
        if (anchor == null) { anchor = g_sema_cur_loc; }
        diag_emit_at(diag_sev_ERROR(), code, anchor, msg);
        self.error_count = self.error_count + 1;
    }

    public fn report_error_help(self, code: string, loc: rawptr, msg: string, help: string) {
        self.report_error_coded(code, loc, msg);
        var anchor = loc;
        if (anchor == null) { anchor = g_sema_cur_loc; }
        diag_emit_help_at(code, anchor, help);
    }

    public fn decl_has_attr(self, d: rawptr, attr: string) -> bool {
        if (d == null || attr.len == 0) { return false; }
        let meta = decl_get_meta(d);
        if (meta.len == 0) { return false; }
        return string_contains(meta, intern_cat3("@[", attr, "("))
            || string_contains(meta, intern_cat3("@[", attr, "]"))
            || string_contains(meta, intern_cat3("@", attr, "("))
            || string_contains(meta, intern_cat2(intern_cat2("@", attr), "|"))
            || string_contains(meta, intern_cat3("@", attr, ","));
    }

    public fn report_discarded_callable(self,
                                        d: rawptr,
                                        owner: rawptr,
                                        loc: rawptr,
                                        callable_name: string,
                                        is_method: bool) -> bool {
        if (!self.decl_has_attr(d, "discard")) { return false; }
        var kind_name = "function";
        if (is_method) { kind_name = "method"; }
        let current_module = self.decl_source_module(d, owner);
        let discard_args = policy_meta_attribute_value(decl_get_meta(d),
                                                       "discard");
        let from_version = policy_strip_quoted_string(
            policy_named_argument_value(discard_args, "fromVer"));
        var historical_name = callable_name.clone();
        if (from_version.len > 0) {
            historical_name = historical_name + "@" + from_version;
            let variant = policy_module_variant(current_module);
            if (variant.len > 0) {
                historical_name = historical_name + "[\"" + variant + "\"]";
            }
        }
        var message = kind_name + " '" + callable_name + "' is discarded";
        if (current_module.len > 0) {
            message = message + " in version '" + current_module + "'";
        }
        if (from_version.len > 0) {
            message = message + "; use '" + historical_name
                + "(...)' to select its historical version explicitly";
        } else {
            message = message + "; no active declaration is callable";
        }
        self.report_error_coded(diag_code_sema_version_policy(), loc, message);
        if (from_version.len > 0) {
            diag_emit_help_at(diag_code_sema_version_policy(),
                                loc,
                                "call '" + historical_name + "(...)' to use the discarded historical version");
        } else {
            diag_emit_help_at(diag_code_sema_version_policy(),
                                loc,
                                "remove this call, or restore a non-discarded declaration");
        }
        return true;
    }

    public fn type_base_name(self, ty_ref: rawptr) -> string {
        if (ty_ref == null) { return ""; }
        let k = tref_get_kind(ty_ref);
        if (k == ty_STRING()) { return "str"; }
        if (k != ty_CLASS()) { return ""; }
        let name = tref_get_name(ty_ref);
        let base = generic_call_base(name.clone());
        let dyn_iface = self.sema_dyn_iface_payload(base.clone());
        if (dyn_iface.len > 0) {
            return module_last_segment(dyn_iface);
        }
        return module_last_segment(base);
    }

    /// Parser stores `dyn Comp` as CLASS name `dynComp`. The payload is the
    /// interface last segment (`Comp` / `Probe.App.Comp` → `Comp`).
    public fn sema_dyn_iface_payload(self, name: string) -> string {
        let base = generic_call_base(name.clone());
        if (base.len <= 3 || !string_starts_with(base, "dyn")) { return ""; }
        let rest = str_view_range(base, 3, base.len as i32);
        if (rest.len == 0) { return ""; }
        let c0 = rest.charAt(0);
        if (!((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95)) {
            return "";
        }
        return rest;
    }

    public fn sema_lazy_load_type_ref_symbols(self, ty_ref: rawptr) -> bool {
        self.profile_lazy_type_ref_calls = self.profile_lazy_type_ref_calls + 1;
        if (ty_ref == null) { return false; }
        let k = tref_get_kind(ty_ref);
        var progressed: bool = false;
        if (k == ty_CLASS()) {
            let raw_name = tref_get_name(ty_ref);
            let rewritten_name = self.sema_rewrite_use_alias_path(raw_name.clone());
            if (rewritten_name.len > 0 && rewritten_name != raw_name) {
                tref_set_name(ty_ref, rewritten_name);
            }
            // A bare name written inside module `M` denotes `M.<name>`, but the
            // annotation stores the source spelling.  Two signatures of the
            // same type then compare unequal (`fn(A,B)->B` vs
            // `fn(T.App.A,T.App.B)->T.App.B`) whenever one of them happened to
            // be materialised by a call and the other did not — and lowering
            // the unqualified spelling yields an incomplete MIR type.
            //
            // Qualification is declaration-driven and runs for every declared
            // signature (`sema_lazy_load_decl_signature_one` walks parameters
            // and return types, recursing into `fn(...)`), so both spellings
            // converge on the qualified form and ordinary `type_eq` keeps
            // working unchanged.  Generic instances, generic declarations,
            // primitives and `dyn` payloads are deliberately left alone: they
            // already go through a single materialisation path, so owning one
            // of their two spellings here only creates a new mismatch.
            let bare_name = tref_get_name(ty_ref);
            var owner_sym: rawptr = null;
            if (bare_name.len > 0
                && !string_contains(bare_name, ".")
                && policy_generic_call_has_args(bare_name.clone()) == 0
                && !type_name_is_primitive_text(bare_name)
                && !generic_list_contains(self.cur_generic_params, bare_name)
                && self.sema_dyn_iface_payload(bare_name.clone()).len == 0) {
                owner_sym = self.sema_find_local_short_class_symbol(bare_name.clone());
            }
            if (owner_sym != null && !self.sema_symbol_declares_generic_params(owner_sym)
                && !self.decl_is_foreign_dci(sym_get_decl(owner_sym))) {
                let home = policy_module_base(self.sema_scope_module());
                if (home.len > 0) {
                    tref_set_name(ty_ref, home + "." + bare_name);
                }
            }
            var name = tref_get_name(ty_ref);
            if (type_name_is_generic(self.cur_generic_params, ty_ref)) {
                return false;
            }
            var dot_idx: i32 = -1;
            var scan_i: i32 = 0;
            while (scan_i < name.len && dot_idx < 0) {
                if (name.charAt(scan_i) == 46) {
                    dot_idx = scan_i;
                }
                scan_i = scan_i + 1;
            }
            if (dot_idx > 0) {
                let owner_name = str_view_range(name, 0, dot_idx);
                if (generic_list_contains(self.cur_generic_params, owner_name)) {
                    return false;
                }
            }
            let cache_key = "C:" + name;
            if (self.sema_lazy_type_ref_seen(cache_key)) { return false; }
            self.sema_lazy_type_ref_note(cache_key);
            var name_base = generic_call_base(name.clone());
            let dyn_iface = self.sema_dyn_iface_payload(name_base.clone());
            var load_name = name_base.clone();
            if (dyn_iface.len > 0) { load_name = dyn_iface; }
            if (!string_contains(load_name, ".")) {
                let expanded = self.sema_expand_short_name(load_name.clone(), false);
                if (expanded.len > 0) {
                    let name_args = policy_generic_call_args(name.clone());
                    var fq_name = expanded;
                    if (name_args.len > 0) {
                        fq_name = fq_name + "::<" + name_args + ">";
                    }
                    if (self.sema_load_qualified_type_symbol(fq_name.clone())) {
                        progressed = true;
                    }
                }
                if (self.sema_materialize_named_type(load_name.clone())) {
                    progressed = true;
                }
            } else if (self.sema_load_qualified_type_symbol(load_name.clone())) {
                progressed = true;
            }
            let base = generic_call_base(name.clone());
            let short = module_last_segment(base.clone());
            if (dyn_iface.len > 0
                && self.sema_lazy_load_pending_until_symbol(dyn_iface.clone())) {
                progressed = true;
            }
            if (name.len > 0 && self.sema_lazy_load_pending_until_symbol(name.clone())) {
                progressed = true;
            }
            if (base.len > 0 && base != name
                && self.sema_lazy_load_pending_until_symbol(base.clone())) {
                progressed = true;
            }
            if (short.len > 0 && short != base
                && self.sema_lazy_load_pending_until_symbol(short.clone())) {
                progressed = true;
            }
            let args = policy_generic_call_args(name.clone());
            if (args.len > 0) {
                var arg_i: i32 = 0;
                while (arg_i < 64) {
                    let arg_text = generic_arg_at(args, arg_i);
                    if (arg_text.len == 0) { break; }
                    if (!generic_list_contains(self.cur_generic_params, arg_text)
                        && self.sema_lazy_load_type_ref_symbols(tref_create_class(arg_text))) {
                        progressed = true;
                    }
                    arg_i = arg_i + 1;
                }
            }
            return progressed;
        }
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
            return self.sema_lazy_load_type_ref_symbols(tref_pointee(ty_ref));
        }
        if (k == ty_ARRAY()) {
            return self.sema_lazy_load_type_ref_symbols(tref_array_elem(ty_ref));
        }
        if (k == ty_FN() || k == ty_CFN()) {
            if (self.sema_lazy_load_type_ref_symbols(tref_fn_ret(ty_ref))) {
                progressed = true;
            }
            var i: i64 = 0;
            let n = tref_fn_param_count(ty_ref);
            while (i < n) {
                if (self.sema_lazy_load_type_ref_symbols(tref_fn_param_at(ty_ref, i))) {
                    progressed = true;
                }
                i = i + 1;
            }
            return progressed;
        }
        if (k == ty_TUPLE()) {
            var j: i64 = 0;
            let tn = tref_tuple_count(ty_ref);
            while (j < tn) {
                if (self.sema_lazy_load_type_ref_symbols(tref_tuple_elem_at(ty_ref, j))) {
                    progressed = true;
                }
                j = j + 1;
            }
        }
        return progressed;
    }

    public fn sema_generic_bound_token_char(self, c: i32) -> bool {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        if (c == 95 || c == 46) { return true; }
        return false;
    }

    public fn sema_generic_bound_token_maybe_trait(self, gp_head: string, token: string) -> bool {
        if (token.len == 0) { return false; }
        if (generic_list_contains(gp_head, token)) { return false; }
        let base = generic_call_base(token.clone());
        var short = module_last_segment(base.clone());
        if (short.len == 0) { short = base; }
        if (short.len == 0) { return false; }
        if (generic_list_contains(gp_head, short)) { return false; }
        let c = short.charAt(0);
        return c >= 65 && c <= 90;
    }

    public fn sema_lazy_load_generic_bound_symbols(self, gp: string) -> bool {
        if (gp.len == 0) { return false; }
        let where_text = sema_where_text(gp);
        if (where_text.len == 0) { return false; }
        let gp_head = generic_param_head(gp);
        var progressed: bool = false;
        var token: string = "";
        var i: i32 = 0;
        while (i <= where_text.len) {
            var c: i32 = 0;
            if (i < where_text.len) { c = where_text.charAt(i); }
            if (i < where_text.len && self.sema_generic_bound_token_char(c)) {
                token = token + str_view_range(where_text, i, i + 1);
            } else {
                if (self.sema_generic_bound_token_maybe_trait(gp_head, token.clone())) {
                    if (self.sema_lazy_load_pending_until_symbol(token.clone())) {
                        progressed = true;
                    }
                    let short = module_last_segment(generic_call_base(token.clone()));
                    if (short.len > 0
                        && short != token
                        && self.sema_lazy_load_pending_until_symbol(short)) {
                        progressed = true;
                    }
                }
                token = "";
            }
            i = i + 1;
        }
        return progressed;
    }

    public fn type_is_ref_like(self, ty_ref: rawptr) -> bool {
        let base = self.type_base_name(ty_ref);
        return base == "Ref";
    }

    public fn type_is_scope_like(self, ty_ref: rawptr) -> bool {
        let base = self.type_base_name(ty_ref);
        return base == "Scope";
    }

    public fn type_is_string_like(self, ty_ref: rawptr) -> bool {
        ty_ref = self.resolve_type_alias_ref(ty_ref);
        if (ty_ref == null) { return false; }
        if (tref_get_kind(ty_ref) == ty_STRING()) { return true; }
        let base = self.type_base_name(ty_ref);
        return base == "str" || base == "string" || base == "String";
    }

    public fn class_decl_for_type_base(self, base: string) -> rawptr {
        if (base.len == 0) { return null; }
        var lookup = generic_call_base(base.clone());
        var ent = self.sema_find_latest_class_symbol(lookup.clone());
        if (ent == null && self.sema_lazy_load_pending_until_symbol(base)) {
            ent = self.sema_find_latest_class_symbol(lookup.clone());
        }
        if (ent == null
            && (lookup == "Box" || lookup == "Ref" || lookup == "Weak" || lookup == "Scope")) {
            self.sema_load_module("std.ref");
            ent = self.sema_find_latest_class_symbol(lookup.clone());
        }
        if (ent == null) {
            let short = module_last_segment(lookup.clone());
            if (short.len > 0 && short != lookup) {
                ent = self.sema_find_latest_class_symbol(short);
            }
        }
        if (ent == null && string_starts_with(lookup, "dyn") && lookup.len > 3) {
            let iface_lookup = str_view_range(lookup, 3, lookup.len as i32);
            self.sema_materialize_named_type(iface_lookup.clone());
            ent = self.sema_find_latest_class_symbol(iface_lookup.clone());
            if (ent == null) {
                ent = self.sema_find_class_symbol(iface_lookup.clone());
            }
            if (ent == null && self.sema_lazy_load_pending_until_symbol(iface_lookup.clone())) {
                ent = self.sema_find_latest_class_symbol(iface_lookup.clone());
                if (ent == null) {
                    ent = self.sema_find_class_symbol(iface_lookup.clone());
                }
            }
            if (ent == null) {
                let iface_short = module_last_segment(iface_lookup.clone());
                if (iface_short.len > 0 && iface_short != iface_lookup) {
                    ent = self.sema_find_latest_class_symbol(iface_short);
                    if (ent == null) {
                        ent = self.sema_find_class_symbol(iface_short);
                    }
                }
            }
            if (ent != null) {
                let iface_decl = sym_get_decl(ent);
                if (iface_decl == null
                    || !string_contains(decl_get_generic_params(iface_decl), "|kind:interface")) {
                    ent = null;
                }
            }
        }
        if (ent == null) { return null; }
        return sym_get_decl(ent);
    }

    public fn class_decl_lists_parent(self, cd: rawptr, parent_name: string) -> bool {
        if (cd == null || parent_name.len == 0) { return false; }
        let clause = sema_impl_clause_text(decl_get_generic_params(cd));
        if (clause.len == 0) { return false; }
        let want = module_last_segment(parent_name.clone());
        var idx: i32 = 0;
        while (idx < 16) {
            let item = generic_arg_at(clause, idx);
            if (item.len == 0) { break; }
            if (item == parent_name || module_last_segment(item.clone()) == want) {
                return true;
            }
            idx = idx + 1;
        }
        return false;
    }

    public fn class_decl_direct_member(self, cd: rawptr, member_name: string) -> rawptr {
        if (cd == null || member_name.len == 0) { return null; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_name(mp) == member_name) { return mp; }
            mp = decl_get_next(mp);
        }
        return self.sema_field_alias_member(decl_get_members(cd), member_name);
    }

    public fn class_decl_member_deep(self, cd: rawptr, member_name: string, depth: i32) -> rawptr {
        if (cd == null || member_name.len == 0 || depth > 8) { return null; }
        let direct = self.class_decl_direct_member(cd, member_name);
        if (direct != null) { return direct; }
        var cur = self.classes_buf;
        while (cur != null) {
            let pd = sym_get_decl(cur);
            if (pd != null && pd != cd && self.class_decl_lists_parent(cd, decl_get_name(pd))) {
                let found = self.class_decl_member_deep(pd, member_name, depth + 1);
                if (found != null) { return found; }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn class_decl_member_owner_deep(self, cd: rawptr, member_name: string, depth: i32) -> rawptr {
        if (cd == null || member_name.len == 0 || depth > 8) { return null; }
        let direct = self.class_decl_direct_member(cd, member_name);
        if (direct != null) { return cd; }
        var cur = self.classes_buf;
        while (cur != null) {
            let pd = sym_get_decl(cur);
            if (pd != null && pd != cd && self.class_decl_lists_parent(cd, decl_get_name(pd))) {
                let owner = self.class_decl_member_owner_deep(pd, member_name, depth + 1);
                if (owner != null) { return owner; }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn class_decl_has_instance_drop(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && decl_get_name(mp) == "drop"
                && !decl_get_is_static(mp)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    /// C++-copy types expose `dup(&self) -> T`. By-value call args copy;
    /// assignment `let y = x` still moves.
    public fn class_decl_has_instance_dup(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && decl_get_name(mp) == "dup"
                && !decl_get_is_static(mp)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn class_decl_has_instance_destroy(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && decl_get_name(mp) == "destroy"
                && !decl_get_is_static(mp)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn type_has_copy_dup(self, ty_ref: rawptr) -> bool {
        let peeled = self.type_ref_peel_pointer(ty_ref);
        if (peeled == null || tref_get_kind(peeled) != ty_CLASS()) { return false; }
        var cd = self.class_decl_for_type_base(self.type_base_name(peeled));
        if (cd == null) {
            cd = self.class_decl_for_type_base(generic_call_base(tref_get_name(peeled)));
        }
        return self.class_decl_has_instance_dup(cd)
            || self.class_decl_has_instance_destroy(cd);
    }

    /// Zyn/Cacao `dup` types spell C++ mutable-this as `mut self`. Spec consume
    /// stays on types without `dup`, and on `own self` always.
    public fn receiver_mode_for_call(self, mode: i32, obj_ty: rawptr) -> i32 {
        if (mode == sema_receiver_mode_own_mut() && self.type_has_copy_dup(obj_ty)) {
            return sema_receiver_mode_compat();
        }
        return mode;
    }

    public fn method_is_cpp_dispose(self, method_name: string) -> bool {
        return method_name == "destroy" || method_name == "drop";
    }

    public fn type_is_heap_owning(self, ty_ref: rawptr) -> bool {
        return self.type_is_heap_owning_at(ty_ref, 0);
    }

    public fn type_is_heap_owning_at(self, ty_ref: rawptr, depth: i32) -> bool {
        if (ty_ref == null) { return false; }
        if (depth > 8) { return false; }
        ty_ref = self.resolve_type_alias_ref(ty_ref);
        let k = tref_get_kind(ty_ref);
        if (k == ty_STRING()) { return false; }
        if (k != ty_CLASS()) { return false; }
        let base = self.type_base_name(ty_ref);
        if (base == "string" || base == "String") { return true; }
        if (base == "Vec" || base == "Dict" || base == "HashMap" || base == "HashSet") { return true; }
        if (base == "Set" || base == "Stack" || base == "Queue" || base == "Deque") { return true; }
        if (base == "List" || base == "PriorityQueue" || base == "BTreeMap" || base == "BTreeSet") { return true; }
        if (base == "Box" || base == "Ref" || base == "Scope") { return true; }
        if (type_name_is_primitive_text(base)) { return false; }
        let cd = self.class_decl_for_type_base(base);
        if (self.class_decl_has_instance_drop(cd)) { return true; }
        if (cd == null) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_FIELD() && !decl_get_is_static(mp)) {
                if (self.type_is_heap_owning_at(decl_get_ty(mp), depth + 1)) {
                    return true;
                }
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    /// Scalars and raw pointers are Copy. A class is Copy only when the
    /// solver (or the remaining structural fallback) says it satisfies Copy.
    /// WP-ESC concession (extreme freeze): primitive `string` stays Copy
    /// so bootstrap sources that pass strings by value do not start
    /// failing E3100. Do not change this without a dedicated fixpoint run.
    public fn type_is_copy(self, ty_ref: rawptr) -> bool {
        ty_ref = self.resolve_type_alias_ref(ty_ref);
        if (ty_ref == null) { return false; }
        let k = tref_get_kind(ty_ref);
        if (k == ty_I8() || k == ty_I16() || k == ty_I32() || k == ty_I64()) { return true; }
        if (k == ty_U8() || k == ty_U16() || k == ty_U32() || k == ty_U64()) { return true; }
        if (k == ty_ISIZE() || k == ty_USIZE()) { return true; }
        if (k == ty_F32() || k == ty_F64() || k == ty_BOOL() || k == ty_CHAR()) { return true; }
        if (k == ty_RAWPTR() || k == ty_CFN() || k == ty_FN()) { return true; }
        if (k == ty_STRING()) { return true; }
        if (k == ty_REF() || k == ty_MUTREF() || k == ty_PTR()) { return false; }
        let base = self.type_base_name(ty_ref);
        if (base.len == 0) { return false; }
        if (base == "string" || base == "String") { return false; }
        return self.type_satisfies_trait(base, "Copy");
    }

    public fn type_is_move_only_heap_owning(self, ty_ref: rawptr) -> bool {
        if (!self.type_is_heap_owning(ty_ref)) { return false; }
        if (self.type_is_ref_like(ty_ref) || self.type_is_scope_like(ty_ref)) { return false; }
        return true;
    }

    public fn local_can_transfer_ownership(self, local_ent: rawptr, ty_ref: rawptr) -> bool {
        if (local_ent == null || ty_ref == null) { return false; }
        if (!self.type_is_heap_owning(ty_ref)) { return false; }
        // Primitive str/string was excluded by type_is_heap_owning. Owned
        // String has the same transfer rules as every other owning class.
        if (!sym_get_is_const(local_ent)) { return true; }
        return self.type_is_move_only_heap_owning(ty_ref);
    }

    public fn local_is_moved(self, local_ent: rawptr) -> bool {
        if (local_ent == null) { return false; }
        var cur = self.moved_buf;
        while (cur != null) {
            if (sym_get_decl(cur) == local_ent) { return true; }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn mark_local_moved(self, local_ent: rawptr, name: string) {
        if (local_ent == null || name.len == 0) { return; }
        if (self.local_is_moved(local_ent)) { return; }
        self.moved_buf = sym_push_decl(self.moved_buf, name, local_ent);
        self.moved_count = self.moved_count + 1;
    }

    public fn unmark_local_moved(self, local_ent: rawptr) {
        if (local_ent == null || self.moved_buf == null) { return; }
        var prev: rawptr = null;
        var cur = self.moved_buf;
        while (cur != null) {
            let next = sym_get_next(cur);
            if (sym_get_decl(cur) == local_ent) {
                if (prev == null) { self.moved_buf = next; }
                else { sym_set_next(prev, next); }
                if (self.moved_count > 0) { self.moved_count = self.moved_count - 1; }
                return;
            }
            prev = cur;
            cur = next;
        }
    }

    public fn field_is_moved(self, local_ent: rawptr, field: string) -> bool {
        if (local_ent == null || field.len == 0) { return false; }
        var cur = self.field_moved_buf;
        while (cur != null) {
            if (sym_get_decl(cur) == local_ent && generic_call_base(sym_get_name(cur)) == field) {
                return true;
            }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn local_has_moved_fields(self, local_ent: rawptr) -> bool {
        if (local_ent == null) { return false; }
        var cur = self.field_moved_buf;
        while (cur != null) {
            if (sym_get_decl(cur) == local_ent) { return true; }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn mark_field_moved(self, local_ent: rawptr, field: string) {
        if (local_ent == null || field.len == 0) { return; }
        if (self.field_is_moved(local_ent, field)) { return; }
        self.field_moved_buf = sym_push_decl(self.field_moved_buf, field, local_ent);
    }

    public fn unmark_field_moved(self, local_ent: rawptr, field: string) {
        if (local_ent == null || field.len == 0 || self.field_moved_buf == null) { return; }
        var prev: rawptr = null;
        var cur = self.field_moved_buf;
        while (cur != null) {
            let next = sym_get_next(cur);
            if (sym_get_decl(cur) == local_ent && generic_call_base(sym_get_name(cur)) == field) {
                if (prev == null) { self.field_moved_buf = next; }
                else { sym_set_next(prev, next); }
                return;
            }
            prev = cur;
            cur = next;
        }
    }

    fn clone_sym_decl_list(self, head: rawptr) -> rawptr {
        var out: rawptr = null;
        var cur = head;
        while (cur != null) {
            out = sym_push_decl(out, generic_call_base(sym_get_name(cur)), sym_get_decl(cur));
            cur = sym_get_next(cur);
        }
        return out;
    }

    fn sym_decl_list_len(self, head: rawptr) -> i32 {
        var n: i32 = 0;
        var cur = head;
        while (cur != null) {
            n = n + 1;
            cur = sym_get_next(cur);
        }
        return n;
    }

    fn union_moved_buf_from(self, extra: rawptr) {
        var cur = extra;
        while (cur != null) {
            self.mark_local_moved(sym_get_decl(cur), generic_call_base(sym_get_name(cur)));
            cur = sym_get_next(cur);
        }
    }

    fn union_field_moved_buf_from(self, extra: rawptr) {
        var cur = extra;
        while (cur != null) {
            self.mark_field_moved(sym_get_decl(cur), generic_call_base(sym_get_name(cur)));
            cur = sym_get_next(cur);
        }
    }

    fn sym_list_has_entity(self, head: rawptr, ent: rawptr) -> bool {
        var cur = head;
        while (cur != null) {
            if (sym_get_decl(cur) == ent) { return true; }
            cur = sym_get_next(cur);
        }
        return false;
    }

    fn sym_field_list_has(self, head: rawptr, ent: rawptr, field: string) -> bool {
        var cur = head;
        while (cur != null) {
            if (sym_get_decl(cur) == ent && sym_get_name(cur) == field) { return true; }
            cur = sym_get_next(cur);
        }
        return false;
    }

    fn sym_chain_has_node(self, head: rawptr, node: rawptr) -> bool {
        var cur = head;
        while (cur != null) {
            if (cur == node) { return true; }
            cur = sym_get_next(cur);
        }
        return false;
    }

    fn reject_loop_outer_ownership_transfer(self,
                                            pre_moved: rawptr,
                                            pre_fields: rawptr,
                                            pre_locals: rawptr,
                                            sp: rawptr,
                                            loop_word: string) {
        // The loop body is sema-resolved once but executed many times, so an
        // outer local moved (or a field moved out of an outer local) inside
        // the body would be read-as-moved / double-dropped from the second
        // iteration on.  Reject it at the source instead.
        var cur = self.moved_buf;
        while (cur != null) {
            let ent = sym_get_decl(cur);
            if (ent != null
                && !self.sym_list_has_entity(pre_moved, ent)
                && self.sym_chain_has_node(pre_locals, ent)) {
                self.report_error_coded(diag_code_v_move_001(),
                                        stmt_loc_ptr(sp),
                                        "cannot move '" + sym_get_name(ent) + "' inside a " + loop_word
                                            + "; ownership would not survive another iteration");
            }
            cur = sym_get_next(cur);
        }
        var fcur = self.field_moved_buf;
        while (fcur != null) {
            let ent = sym_get_decl(fcur);
            if (ent != null
                && !self.sym_field_list_has(pre_fields, ent, sym_get_name(fcur))
                && self.sym_chain_has_node(pre_locals, ent)) {
                self.report_error_coded(diag_code_v_move_001(),
                                        stmt_loc_ptr(sp),
                                        "cannot move field '" + sym_get_name(fcur) + "' out of '"
                                            + sym_get_name(ent) + "' inside a " + loop_word
                                            + "; ownership would not survive another iteration");
            }
            fcur = sym_get_next(fcur);
        }
    }

    fn set_move_state(self, moved: rawptr, fields: rawptr) {
        self.moved_buf = moved;
        self.field_moved_buf = fields;
        self.moved_count = self.sym_decl_list_len(moved);
    }

    public fn mark_receiver_moved(self, receiver: rawptr) {
        let local_ent = self.expr_root_local_entry(receiver);
        if (local_ent == null) { return; }
        self.mark_local_moved(local_ent, sym_get_name(local_ent));
    }

    public fn mark_identifier_moved_if_transfer(self, e: rawptr, ty_ref: rawptr, skip_shared: bool) {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return; }
        let name = expr_get_name(e);
        let local_ent = sym_lookup(self.cur_locals, name);
        if (local_ent == null) { return; }
        // Transfer the source's ownership. A str -> String conversion creates
        // owned storage; its destination type must not make the view move-only.
        let source_type = sym_get_ty(local_ent);
        let destination_type = self.resolve_type_alias_ref(ty_ref);
        if (destination_type != null && tref_get_kind(destination_type) == ty_STRING()
            && self.type_is_heap_owning(source_type) && self.type_is_string_like(source_type)) {
            return;
        }
        if (source_type != null) { ty_ref = self.resolve_type_alias_ref(source_type); }
        if (ty_ref == null) { return; }
        if (self.type_is_copy(ty_ref)) { return; }
        if (skip_shared && (self.type_is_ref_like(ty_ref) || self.type_is_scope_like(ty_ref))) {
            return;
        }
        if (!self.type_is_heap_owning(ty_ref)) { return; }
        if (!self.local_can_transfer_ownership(local_ent, ty_ref)) { return; }
        let region = sym_region_root(local_ent);
        if (region != null
            && (sym_get_shared_borrows(region) > 0
                || sym_get_mutable_borrows(region) > 0)) {
            self.report_error_coded(diag_code_v_borrow_invalidation(),
                                    expr_loc_ptr(e),
                                    "cannot move '" + name + "' while it is borrowed");
            return;
        }
        self.mark_local_moved(local_ent, name);
    }

    public fn param_is_reference(self, p: rawptr) -> bool {
        if (p == null) { return false; }
        let pty = decl_get_ty(p);
        if (pty == null) { return false; }
        let pk = tref_get_kind(pty);
        return pk == ty_REF() || pk == ty_MUTREF();
    }

    public fn mark_call_args_moved_for_params(self, call_e: rawptr, params: rawptr) {
        var pp = params;
        var ac = expr_get_args(call_e);
        while (ac != null && pp != null) {
            if (decl_get_name(pp) == "args" || string_contains(decl_get_generic_params(pp), "|variadic")) {
                return;
            }
            let av = stmt_get_init(ac);
            if (av != null && !self.param_is_reference(pp)) {
                var aty = expr_get_ty(av);
                if (aty == null) { aty = self.resolve_expr(av); }
                // Owned String must transfer even though it exposes destroy.
                // Keep the existing C++ handle compatibility for other types;
                // primitive str/string is not heap owning here.
                let owned_string = self.type_is_heap_owning(aty) && self.type_is_string_like(aty);
                if (!self.type_has_copy_dup(aty) || owned_string) {
                    self.mark_identifier_moved_if_transfer(av, decl_get_ty(pp), false);
                }
            }
            ac = stmt_get_next(ac);
            pp = decl_get_next(pp);
        }
    }

    public fn mark_function_call_arg_moves(self, call_e: rawptr, fdecl: rawptr) {
        if (call_e == null || fdecl == null) { return; }
        if (self.decl_has_attr(fdecl, "borrow_args")) { return; }
        self.mark_call_args_moved_for_params(call_e, decl_get_params(fdecl));
    }

    public fn find_method_decl_for_type(self, ty_ref: rawptr, method_name: string) -> rawptr {
        if (ty_ref == null || method_name.len == 0) { return null; }
        if (tref_get_kind(ty_ref) != ty_CLASS()) { return null; }
        let type_name = tref_get_name(ty_ref);
        var base = generic_call_base(type_name.clone());
        if (base.len == 0) { base = self.type_base_name(ty_ref); }
        var cd = self.class_decl_for_type_base(base.clone());
        if (cd == null) {
            let short_base = module_last_segment(base.clone());
            if (short_base.len > 0 && short_base != base) {
                cd = self.class_decl_for_type_base(short_base.clone());
                if (cd != null) { base = short_base; }
            }
        }
        if (cd == null) { return null; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                let owner_imported = string_contains(decl_get_meta(cd), "|imported");
                let mmeta = decl_get_meta(mp);
                if (!self.prepare_hir_facts
                    && !string_contains(mmeta, "|body_resolved")
                    && !string_contains(mmeta, "|body_resolving")) {
                    self.resolve_method_with_owner(mp, cd, owner_imported);
                    let mmeta2 = decl_get_meta(mp);
                    if (!string_contains(mmeta2, "|body_resolved")) {
                        decl_set_meta(mp, mmeta2 + "|body_resolved");
                    }
                }
                return mp;
            }
            mp = decl_get_next(mp);
        }
        if (self.sema_lazy_load_pending_until_symbol(base)
            || self.sema_lazy_load_pending_until_symbol(method_name)) {
            let cd2 = self.class_decl_for_type_base(base);
            if (cd2 != null) {
                var mp2 = decl_get_members(cd2);
                while (mp2 != null) {
                    if (decl_get_kind(mp2) == de_METHOD()
                        && sema_method_name_matches_lookup(decl_get_name(mp2), method_name)) {
                        let owner_imported2 = string_contains(decl_get_meta(cd2), "|imported");
                        let mmeta2 = decl_get_meta(mp2);
                        if (!self.prepare_hir_facts
                            && !string_contains(mmeta2, "|body_resolved")
                            && !string_contains(mmeta2, "|body_resolving")) {
                            self.resolve_method_with_owner(mp2, cd2, owner_imported2);
                            let mmeta3 = decl_get_meta(mp2);
                            if (!string_contains(mmeta3, "|body_resolved")) {
                                decl_set_meta(mp2, mmeta3 + "|body_resolved");
                            }
                        }
                        return mp2;
                    }
                    mp2 = decl_get_next(mp2);
                }
            }
        }
        if (method_name == "clone") {
            return self.find_method_decl_for_type(ty_ref, "dup");
        }
        return null;
    }

    public fn array_literal_score_for_param(self, pt: rawptr, arg_e: rawptr) -> i32 {
        if (pt == null || arg_e == null) { return -1; }
        if (tref_get_kind(pt) != ty_ARRAY() || expr_get_kind(arg_e) != ex_ARRAY_LIT()) {
            return -1;
        }
        let expected_count = tref_array_size(pt);
        let actual_count = self.stmt_list_count(expr_get_args(arg_e)) as i64;
        if (expected_count >= 0 && expected_count != actual_count) { return -1; }
        let elem_pt = tref_array_elem(pt);
        var score: i32 = 2;
        var cur = expr_get_args(arg_e);
        while (cur != null) {
            let elem_e = stmt_get_init(cur);
            var elem_at = expr_get_ty(elem_e);
            if (elem_at == null) { elem_at = self.resolve_expr(elem_e); }
            if (elem_pt != null && elem_at != null) {
                if (type_nominally_equal(elem_pt, elem_at)) {
                    score = score + 2;
                } else if (type_ref_implicitly_convertible(elem_at, elem_pt)) {
                    score = score + 1;
                } else {
                    return -1;
                }
            }
            cur = stmt_get_next(cur);
        }
        return score;
    }

    public fn method_decl_score_call(self,
                                     call_ep: rawptr,
                                     mdecl: rawptr,
                                     owner_decl: rawptr) -> i32 {
        if (call_ep == null || mdecl == null) { return -1; }
        var m_generics = decl_get_generic_params(mdecl);
        if (owner_decl != null) {
            m_generics = merge_generic_params(decl_get_generic_params(owner_decl),
                                              m_generics);
        }
        var pp = decl_get_params(mdecl);
        if (pp != null && decl_get_name(pp) == "self") {
            pp = decl_get_next(pp);
        }
        var ac = expr_get_args(call_ep);
        var prefix_pending = self.pipe_call_context == call_ep
            && self.pipe_prefix_expr != null;
        var score: i32 = 0;
        while (pp != null) {
            if (decl_get_name(pp) == "args" || string_contains(decl_get_generic_params(pp), "|variadic")) {
                return score;
            }
            var av: rawptr = null;
            if (prefix_pending) {
                av = self.pipe_prefix_expr;
                prefix_pending = false;
            } else if (ac != null) {
                av = stmt_get_init(ac);
                ac = stmt_get_next(ac);
            } else if (decl_get_body(pp) != null) {
                pp = decl_get_next(pp);
                continue;
            } else {
                return -1;
            }
            if (av == null) { return -1; }
            let pt = decl_get_ty(pp);
            var at = expr_get_ty(av);
            if (at == null) { at = self.resolve_expr(av); }
            let array_score = self.array_literal_score_for_param(pt, av);
            if (array_score >= 0) {
                score = score + array_score;
                pp = decl_get_next(pp);
            } else if (pt == null || at == null) {
                pp = decl_get_next(pp);
            } else if (tref_get_kind(pt) == ty_RAWPTR() || tref_get_kind(at) == ty_RAWPTR()) {
                pp = decl_get_next(pp);
            } else if (type_name_is_generic(m_generics, pt)) {
                pp = decl_get_next(pp);
            } else if (expr_get_kind(av) == ex_INT_LIT()) {
                let literal_score = sema_numeric_literal_score_for_param(pt, av);
                if (literal_score >= 0) {
                    score = score + literal_score;
                    pp = decl_get_next(pp);
                } else {
                    return -1;
                }
            } else if (type_nominally_equal(pt, at)) {
                score = score + 2;
                pp = decl_get_next(pp);
            } else if (self.types_compatible_user_value(pt, at)) {
                score = score + 1;
                pp = decl_get_next(pp);
            } else if (type_ref_implicitly_convertible(at, pt)) {
                score = score + 1;
                pp = decl_get_next(pp);
            } else {
                return -1;
            }
        }
        if (prefix_pending || ac != null) { return -1; }
        return score;
    }

    public fn find_method_decl_in_class_for_call(self,
                                                 cd: rawptr,
                                                 method_name: string,
                                                 call_ep: rawptr,
                                                 resolve_body: bool) -> rawptr {
        if (cd == null || method_name.len == 0) { return null; }
        var first: rawptr = null;
        var best: rawptr = null;
        var best_score: i32 = -1;
        var count: i32 = 0;
        var tied: bool = false;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                if (first == null) { first = mp; }
                count = count + 1;
                let score = self.method_decl_score_call(call_ep, mp, cd);
                if (score > best_score) {
                    best_score = score;
                    best = mp;
                    tied = false;
                } else if (score == best_score && score >= 0) {
                    let candidate_module = self.decl_source_module(mp, cd);
                    let best_module = self.decl_source_module(best, cd);
                    if (self.sema_versioned_module_pair(candidate_module,
                                                        best_module)) {
                        let version_cmp = policy_semver_compare(
                            policy_module_version(candidate_module),
                            policy_module_version(best_module));
                        if (version_cmp > 0) {
                            best = mp;
                            tied = false;
                        } else if (version_cmp == 0) {
                            tied = true;
                        }
                    } else {
                        tied = true;
                    }
                }
            }
            mp = decl_get_next(mp);
        }
        var picked = best;
        if (picked == null && first != null) {
            if (count > 1 || !self.decl_call_arity_matches(call_ep, first)) {
                self.report_no_matching_overload_for_call(method_name,
                                                          call_ep,
                                                          first,
                                                          count);
            }
            // Keep the legacy single-candidate type-inference path. Owner
            // class generics can still be unresolved at this early Sema
            // point; arity is the only failure that is always definitive.
            picked = first;
        }
        if (tied && count > 1) {
            self.report_error_coded(diag_code_sema_ambiguity(),
                                    g_sema_cur_loc,
                                    "ambiguous method call to '" + method_name + "'");
        }
        if (picked != null && resolve_body && !self.prepare_hir_facts) {
            let owner_imported = string_contains(decl_get_meta(cd), "|imported");
            let mmeta = decl_get_meta(picked);
            if (!string_contains(mmeta, "|body_resolved")
                && !string_contains(mmeta, "|body_resolving")) {
                self.resolve_method_with_owner(picked, cd, owner_imported);
                let mmeta2 = decl_get_meta(picked);
                if (!string_contains(mmeta2, "|body_resolved")) {
                    decl_set_meta(picked, mmeta2 + "|body_resolved");
                }
            }
        }
        return picked;
    }

    public fn find_discarded_method_decl_in_class_for_call(self,
                                                            cd: rawptr,
                                                            method_name: string,
                                                            call_ep: rawptr) -> rawptr {
        if (cd == null || method_name.len == 0 || call_ep == null) { return null; }
        var best: rawptr = null;
        var best_score: i32 = -1;
        var best_module: string = "";
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                let score = self.method_decl_score_call(call_ep, mp, cd);
                if (score >= 0) {
                    let candidate_module = self.decl_source_module(mp, cd);
                    if (best == null || score > best_score) {
                        best = mp;
                        best_score = score;
                        best_module = candidate_module;
                    } else if (score == best_score
                        && self.sema_versioned_module_pair(candidate_module,
                                                           best_module)
                        && policy_semver_compare(
                            policy_module_version(candidate_module),
                            policy_module_version(best_module)) > 0) {
                        best = mp;
                        best_module = candidate_module;
                    }
                }
            }
            mp = decl_get_next(mp);
        }
        if (self.decl_has_attr(best, "discard")) { return best; }
        return null;
    }

    public fn class_decl_for_type_base_in_module(self,
                                                 type_base: string,
                                                 module_name: string) -> rawptr {
        if (self.current_unit == null
            || type_base.len == 0
            || module_name.len == 0) {
            return null;
        }
        let short_base = module_last_segment(type_base.clone());
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if ((kind == de_CLASS() || kind == de_ENUM())
                && self.decl_source_module(cur, null) == module_name) {
                let candidate = decl_get_name(cur);
                if (candidate == type_base
                    || candidate == short_base
                    || module_last_segment(candidate.clone()) == short_base) {
                    return cur;
                }
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    public fn sema_find_function_decl_in_unit_module_for_call(
        self,
        name: string,
        module_name: string,
        call_ep: rawptr) -> rawptr {
        if (self.current_unit == null
            || name.len == 0
            || module_name.len == 0) {
            return null;
        }
        var first: rawptr = null;
        var best: rawptr = null;
        var best_score: i32 = -1;
        var tied = false;
        var count: i32 = 0;
        var cur = unit_get_decls(self.current_unit);
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if ((kind == de_FN() || kind == de_EXTERN_FN())
                && decl_get_name(cur) == name
                && self.decl_source_module(cur, null) == module_name) {
                if (first == null) { first = cur; }
                count = count + 1;
                let score = self.overload_score_decl(call_ep, cur);
                if (score > best_score) {
                    best = cur;
                    best_score = score;
                    tied = false;
                } else if (score == best_score && score >= 0) {
                    tied = true;
                }
            }
            cur = decl_get_next(cur);
        }
        if (tied) {
            self.report_error_coded(diag_code_sema_ambiguity(),
                                    g_sema_cur_loc,
                                    "ambiguous call to '" + name
                                    + "' in versioned module '"
                                    + module_name + "'");
        }
        if (best == null && first != null) {
            if (count > 1 || !self.decl_call_arity_matches(call_ep, first)) {
                self.report_no_matching_overload_for_call(name,
                                                          call_ep,
                                                          first,
                                                          count);
            }
            return first;
        }
        return best;
    }

    public fn selected_method_module(self,
                                     raw_method_name: string,
                                     owner_decl: rawptr) -> string {
        if (policy_module_selector_index(raw_method_name) < 0
            || owner_decl == null) {
            return "";
        }
        let owner_module = self.decl_source_module(owner_decl, null);
        let owner_base = policy_module_base(owner_module.clone());
        let selected_version = policy_module_version(raw_method_name);
        var selected_variant = policy_module_variant(raw_method_name);
        if (selected_variant.len == 0) {
            selected_variant = policy_module_variant(owner_module);
        }
        return policy_module_identity(owner_base,
                                      selected_version,
                                      selected_variant);
    }

    public fn layout_parent_decl_at(self, cd: rawptr, want: i32) -> rawptr {
        if (cd == null || want < 0) { return null; }
        let clause = sema_impl_clause_text(decl_get_generic_params(cd));
        if (clause.len == 0) { return null; }
        var seen: i32 = 0;
        var idx: i32 = 0;
        while (idx < 16) {
            let parent_name = generic_arg_at(clause, idx);
            if (parent_name.len == 0) { break; }
            idx = idx + 1;
            var pent = sym_lookup(self.classes_buf, parent_name);
            if (pent == null) {
                pent = self.sema_find_class_symbol(parent_name);
            }
            if (pent == null) { continue; }
            let pd = sym_get_decl(pent);
            if (pd == null || pd == cd) { continue; }
            if (!self.decl_is_layout_class(pd)) { continue; }
            if (seen == want) { return pd; }
            seen = seen + 1;
        }
        return null;
    }

    public fn colon_parent_decl_at(self, cd: rawptr, want: i32) -> rawptr {
        if (cd == null || want < 0) { return null; }
        let clause = sema_impl_clause_text(decl_get_generic_params(cd));
        if (clause.len == 0) { return null; }
        var seen: i32 = 0;
        var idx: i32 = 0;
        while (idx < 16) {
            let parent_name = generic_arg_at(clause, idx);
            if (parent_name.len == 0) { break; }
            idx = idx + 1;
            var pent = sym_lookup(self.classes_buf, parent_name);
            if (pent == null) {
                pent = self.sema_find_class_symbol(parent_name);
            }
            if (pent == null) { continue; }
            let pd = sym_get_decl(pent);
            if (pd == null || pd == cd) { continue; }
            if (seen == want) { return pd; }
            seen = seen + 1;
        }
        return null;
    }

    public fn parent_class_decl_for_class_decl(self, cd: rawptr) -> rawptr {
        return self.layout_parent_decl_at(cd, 0);
    }

    public fn find_method_decl_in_class_tree_for_call(self,
                                                      cd: rawptr,
                                                      method_name: string,
                                                      call_ep: rawptr,
                                                      resolve_body: bool,
                                                      depth: i32) -> rawptr {
        if (cd == null || method_name.len == 0 || depth > 32) { return null; }
        let direct = self.find_method_decl_in_class_for_call(cd, method_name, call_ep, resolve_body);
        if (direct != null) { return direct; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.colon_parent_decl_at(cd, parent_i);
            if (parent_decl == null) { return null; }
            let found = self.find_method_decl_in_class_tree_for_call(parent_decl,
                                                                      method_name,
                                                                      call_ep,
                                                                      resolve_body,
                                                                      depth + 1);
            if (found != null) { return found; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    public fn find_method_decl_for_type_and_call(self,
                                                 ty_ref: rawptr,
                                                 method_name: string,
                                                 call_ep: rawptr,
                                                 resolve_body: bool) -> rawptr {
        if (ty_ref == null || method_name.len == 0) { return null; }
        if (tref_get_kind(ty_ref) != ty_CLASS()) { return null; }
        let type_name = tref_get_name(ty_ref);
        var base = generic_call_base(type_name.clone());
        if (base.len == 0) { base = self.type_base_name(ty_ref); }
        var cd = self.class_decl_for_type_base(base.clone());
        if (cd == null) {
            let short_base = module_last_segment(base.clone());
            if (short_base.len > 0 && short_base != base) {
                cd = self.class_decl_for_type_base(short_base.clone());
                if (cd != null) { base = short_base; }
            }
        }
        if (cd != null) {
            let picked = self.find_method_decl_in_class_tree_for_call(cd, method_name, call_ep, resolve_body, 0);
            if (picked != null) { return picked; }
        }
        if (self.sema_lazy_load_pending_until_symbol(base)
            || self.sema_lazy_load_pending_until_symbol(method_name)) {
            let cd2 = self.class_decl_for_type_base(base);
            if (cd2 != null) {
                return self.find_method_decl_in_class_for_call(cd2, method_name, call_ep, resolve_body);
            }
        }
        if (method_name == "clone") {
            return self.find_method_decl_for_type_and_call(ty_ref, "dup", call_ep, resolve_body);
        }
        return null;
    }

    public fn find_method_decl_signature_for_type(self, ty_ref: rawptr, method_name: string) -> rawptr {
        if (ty_ref == null || method_name.len == 0) { return null; }
        if (tref_get_kind(ty_ref) != ty_CLASS()) { return null; }
        let type_name = tref_get_name(ty_ref);
        var base = generic_call_base(type_name.clone());
        if (base.len == 0) { base = self.type_base_name(ty_ref); }
        var cd = self.class_decl_for_type_base(base.clone());
        if (cd == null) {
            let short_base = module_last_segment(base.clone());
            if (short_base.len > 0 && short_base != base) {
                cd = self.class_decl_for_type_base(short_base.clone());
            }
        }
        if (cd == null) { return null; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                return mp;
            }
            mp = decl_get_next(mp);
        }
        if (self.sema_lazy_load_pending_until_symbol(base)
            || self.sema_lazy_load_pending_until_symbol(method_name)) {
            let cd2 = self.class_decl_for_type_base(base);
            if (cd2 != null) {
                var mp2 = decl_get_members(cd2);
                while (mp2 != null) {
                    if (decl_get_kind(mp2) == de_METHOD()
                        && sema_method_name_matches_lookup(decl_get_name(mp2), method_name)) {
                        return mp2;
                    }
                    mp2 = decl_get_next(mp2);
                }
            }
        }
        if (method_name == "clone") {
            return self.find_method_decl_signature_for_type(ty_ref, "dup");
        }
        return null;
    }

    public fn deref_inner_type_for_type(self, ty_ref: rawptr) -> rawptr {
        if (ty_ref == null || tref_get_kind(ty_ref) != ty_CLASS()) { return null; }
        let method_decl = self.find_method_decl_signature_for_type(ty_ref, "deref");
        if (method_decl == null) { return null; }
        var ret_ty = decl_get_ty(method_decl);
        if (ret_ty == null) { return null; }
        let type_name = tref_get_name(ty_ref);
        let base = generic_call_base(type_name.clone());
        let args = policy_generic_call_args(type_name.clone());
        let owner_decl = self.class_decl_for_type_base(base);
        if (owner_decl != null && args.len > 0) {
            ret_ty = sema_substitute_type_with_args(ret_ty,
                                                    decl_get_generic_params(owner_decl),
                                                    args);
        }
        self.sema_lazy_load_type_ref_symbols(ret_ty);
        return ret_ty;
    }

    public fn method_call_is_borrow_like_static_factory(self, callee: rawptr) -> bool {
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()) { return false; }
        let obj = expr_get_lhs(callee);
        if (obj == null || expr_get_kind(obj) != ex_IDENT()) { return false; }
        let raw_method_name = expr_get_name(callee);
        let method_name = generic_call_base(raw_method_name);
        let raw_class_name = expr_get_name(obj);
        let class_name = module_last_segment(generic_call_base(raw_class_name));
        if (method_name == "of" && class_name == "Weak") { return true; }
        return false;
    }

    fn active_borrow_view_for_region(self, region: rawptr) -> rawptr {
        if (region == null) { return null; }
        var guard_view: rawptr = null;
        var local = self.cur_locals;
        while (local != null) {
            let state = sym_get_alloc_state(local);
            if ((state == sema_alloc_state_borrowed_immutable()
                || state == sema_alloc_state_borrowed_mutable())
                && sym_region_root(local) == region) {
                if (!sym_is_borrow_guard(local)) { return local; }
                if (guard_view == null) { guard_view = local; }
            }
            local = sym_get_next(local);
        }
        local = self.capture_borrow_guards;
        while (local != null) {
            let state2 = sym_get_alloc_state(local);
            if ((state2 == sema_alloc_state_borrowed_immutable()
                || state2 == sema_alloc_state_borrowed_mutable())
                && sym_region_root(local) == region
                && guard_view == null) {
                guard_view = local;
            }
            local = sym_get_next(local);
        }
        return guard_view;
    }

    fn check_method_receiver_borrow_conflict(self,
                                             callee: rawptr,
                                             receiver_root: rawptr,
                                             receiver_mode: i32,
                                             method_name: string) {
        if (callee == null || receiver_root == null) { return; }
        let receiver_state = sym_get_alloc_state(receiver_root);
        // Access through the borrow handle itself is the capability-authorized
        // path. The conflict applies to reaching the region again through its
        // original owner/alias while a derived view remains live.
        if (receiver_state == sema_alloc_state_borrowed_immutable()
            || receiver_state == sema_alloc_state_borrowed_mutable()
            || receiver_state == sema_alloc_state_compat_this()) {
            return;
        }
        let region = sym_region_root(receiver_root);
        if (region == null) { return; }
        let shared = sym_get_shared_borrows(region);
        let mutable = sym_get_mutable_borrows(region);
        var conflict: bool = false;
        if (mutable > 0) {
            conflict = true;
        } else if (shared > 0
            && receiver_mode != sema_receiver_mode_shared()) {
            conflict = true;
        }
        if (!conflict) { return; }
        let view = self.active_borrow_view_for_region(region);
        var view_name = "reference";
        if (view != null && sym_get_name(view).len > 0) {
            if (sym_is_borrow_guard(view)) {
                view_name = "captured reference '"
                    + sym_borrow_guard_source_name(view) + "'";
            } else {
                view_name = "reference '" + sym_get_name(view) + "'";
            }
        }
        self.report_error_coded(diag_code_v_borrow_invalidation(),
                                expr_loc_ptr(callee),
                                "borrowed " + view_name
                                    + " may be invalidated by call to '"
                                    + method_name + "'");
        if (view != null && sym_get_borrow_loc(view) != null) {
            diag_emit_at(diag_sev_NOTE(),
                         diag_code_v_borrow_invalidation(),
                         sym_get_borrow_loc(view),
                         view_name + " borrows this receiver's storage here");
        }
    }

    public fn mark_method_call_arg_moves(self, call_e: rawptr, callee: rawptr) {
        if (call_e == null || callee == null || expr_get_kind(callee) != ex_MEMBER()) { return; }
        let obj = expr_get_lhs(callee);
        if (obj == null) { return; }
        var obj_ty: rawptr = null;
        if (expr_get_semantic_kind(obj) == expr_sem_CLASS()) {
            obj_ty = expr_get_ty(obj);
        } else {
            obj_ty = self.resolve_expr(obj);
        }
        let raw_method_name = expr_get_name(callee);
        let method_name = generic_call_base(raw_method_name);
        var mdecl = expr_get_semantic_target(callee);
        if (mdecl == null) {
            mdecl = self.find_method_decl_for_type_and_call(obj_ty, method_name, call_e, false);
        }
        if (mdecl == null) {
            mdecl = self.find_method_decl_signature_for_type(obj_ty, method_name);
        }
        if (mdecl == null) { return; }
        var pp = decl_get_params(mdecl);
        if (!decl_get_is_static(mdecl)
            && pp != null
            && decl_get_name(pp) == "self") {
            var receiver_mode = self.receiver_mode_for_call(sema_receiver_mode(pp), obj_ty);
            // Unique rule: after peeling handles, a dyn trait object is a
            // shared vtable dispatch handle. Unmarked `self` (compat) on that
            // object does not consume the payload, so `&dyn T` / `dyn T` both
            // accept it. `own self` / `mut self` / `&mut self` stay exclusive.
            if (receiver_mode == sema_receiver_mode_compat()
                && self.type_ref_dyn_trait_name(obj_ty).len > 0) {
                receiver_mode = sema_receiver_mode_shared();
            }
            let receiver_root = self.expr_root_local_entry(obj);
            var receiver_state = sema_alloc_state_none();
            if (receiver_root != null) {
                receiver_state = sym_get_alloc_state(receiver_root);
            }
            let field_reinit = self.consume_is_field_reinit(obj);
            self.check_method_receiver_borrow_conflict(callee,
                                                       receiver_root,
                                                       receiver_mode,
                                                       method_name);
            if (receiver_state == sema_alloc_state_borrowed_immutable()
                && receiver_mode != sema_receiver_mode_shared()) {
                let cpp_this_on_copy = self.type_has_copy_dup(obj_ty)
                    && (receiver_mode == sema_receiver_mode_mut()
                        || receiver_mode == sema_receiver_mode_compat());
                if (!cpp_this_on_copy) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(callee),
                                            "cannot call a mutable or owning method through '&self'",
                                            "borrow `&mut self`, or call a `&self` method instead");
                }
            } else if (sema_receiver_mode_is_consuming(receiver_mode)
                && !field_reinit
                && (receiver_state == sema_alloc_state_borrowed_mutable()
                    || receiver_state == sema_alloc_state_compat_this())) {
                self.report_error_help(diag_code_v_move_001(),
                                        expr_loc_ptr(callee),
                                        "cannot move the receiver out of a borrowed 'self'",
                                        "end the borrow first, or take `own self`/`mut self` only on an owned value");
            } else if (receiver_mode == sema_receiver_mode_mut()
                && receiver_root != null
                && receiver_state != sema_alloc_state_borrowed_mutable()
                && receiver_state != sema_alloc_state_compat_this()
                && sym_get_is_const(receiver_root)
                && !self.method_is_cpp_dispose(method_name)
                && !self.type_has_copy_dup(obj_ty)
                && self.type_ref_dyn_trait_name(obj_ty).len == 0) {
                self.report_error_help(diag_code_v_borrow_invalidation(),
                                        expr_loc_ptr(callee),
                                        "cannot mutably borrow immutable receiver '"
                                            + sym_get_name(receiver_root) + "'",
                                        "declare the receiver `var` / `&mut`, or call a `&self` method");
            } else if (sema_receiver_mode_is_consuming(receiver_mode) && !field_reinit) {
                // `own self` / `mut self` are explicit language-level
                // ownership transfer. Unlike legacy inferred move parameters,
                // they do not depend on a drop-glue/heap-owning heuristic:
                // every receiver place becomes unusable until explicitly
                // reinitialized.
                let obj_lhs = expr_get_lhs(obj);
                if (expr_get_kind(obj) == ex_MEMBER()
                    && obj_lhs != null
                    && expr_get_kind(obj_lhs) == ex_IDENT()
                    && receiver_root != null) {
                    self.mark_field_moved(receiver_root, generic_call_base(expr_get_name(obj)));
                } else {
                    self.mark_receiver_moved(obj);
                }
            }
            pp = decl_get_next(pp);
        }
        if (self.decl_has_attr(mdecl, "borrow_args")) { return; }
        if (self.method_call_is_borrow_like_static_factory(callee)) { return; }
        self.mark_call_args_moved_for_params(call_e, pp);
    }

    public fn enum_decl_has_payload(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        var m = decl_get_members(d);
        while (m != null) {
            if (decl_get_kind(m) == de_VARIANT() && decl_get_params(m) != null) {
                return true;
            }
            m = decl_get_next(m);
        }
        return false;
    }

    public fn enum_decl_for_type(self, ty: rawptr) -> rawptr {
        if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return null; }
        let name = tref_get_name(ty);
        let base = generic_call_base(name.clone());
        var ent = sym_lookup(self.classes_buf, base);
        if (ent == null && self.sema_lazy_load_pending_until_symbol(base)) {
            ent = sym_lookup(self.classes_buf, base);
        }
        if (ent == null) { return null; }
        let d = sym_get_decl(ent);
        if (d != null && decl_get_kind(d) == de_ENUM()) { return d; }
        if (d != null && decl_get_kind(d) == de_CLASS()
            && string_contains(decl_get_generic_params(d), "|kind:error")) {
            return d;
        }
        return null;
    }

    public fn find_variant_owner_decl(self, variant_name: string) -> rawptr {
        if (variant_name.len == 0) { return null; }
        sema_memo_ensure();
        let slot = sema_memo_lookup(g_variant_owner_memo, self.classes_buf, variant_name);
        if (slot != null) { return sema_memo_slot_value(slot); }
        let found = self.find_variant_owner_decl_uncached(variant_name);
        sema_memo_put(g_variant_owner_memo, self.classes_buf, variant_name, found);
        return found;
    }

    public fn find_variant_owner_decl_uncached(self, variant_name: string) -> rawptr {
        if (variant_name.len == 0) { return null; }
        var found: rawptr = null;
        var found_imported: bool = false;
        var cur = self.classes_buf;
        while (cur != null) {
            let d = sym_get_decl(cur);
            if (d != null && (decl_get_kind(d) == de_ENUM()
                || (decl_get_kind(d) == de_CLASS()
                    && string_contains(decl_get_generic_params(d), "|kind:error")))) {
                if (self.find_enum_variant_decl(d, variant_name) != null) {
                    // Project-unit siblings carry the imported marker too,
                    // but are part of this crate and should retain local
                    // precedence.  Only foreign artifacts are ambiguous
                    // short-name providers.
                    let candidate_imported = decl_is_foreign_import(d);
                    if (found == null) {
                        found = d;
                        found_imported = candidate_imported;
                    } elif (found_imported && !candidate_imported) {
                        // A project-local enum wins over an imported short
                        // variant with the same spelling.
                        found = d;
                        found_imported = false;
                    } elif (!found_imported && candidate_imported) {
                        // Keep the already selected local owner.
                    } else {
                        // Two imported owners (or two local owners) make a
                        // bare `Ready`/`None` path ambiguous.  Returning null
                        // forces callers to use the scrutinee's enum type or
                        // a qualified constructor instead of silently binding
                        // the first module discovered.
                        return null;
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        if (found == null && self.sema_lazy_load_pending_until_symbol(variant_name)) {
            cur = self.classes_buf;
            while (cur != null) {
                let d2 = sym_get_decl(cur);
                if (d2 != null && (decl_get_kind(d2) == de_ENUM()
                    || (decl_get_kind(d2) == de_CLASS()
                        && string_contains(decl_get_generic_params(d2), "|kind:error")))) {
                    if (self.find_enum_variant_decl(d2, variant_name) != null) {
                        if (found == null) {
                            found = d2;
                            found_imported = decl_is_foreign_import(d2);
                        } elif (found_imported && !decl_is_foreign_import(d2)) {
                            found = d2;
                            found_imported = false;
                        } elif (!found_imported && decl_is_foreign_import(d2)) {
                            // Keep local owner.
                        } else {
                            return null;
                        }
                    }
                }
                cur = sym_get_next(cur);
            }
        }
        return found;
    }

    public fn type_ref_is_newtype(self, ty: rawptr) -> bool {
        if (ty == null || tref_get_kind(ty) != ty_CLASS()) { return false; }
        let name = tref_get_name(ty);
        let base = generic_call_base(name.clone());
        var ent = sym_lookup(self.classes_buf, base);
        if (ent == null && self.sema_lazy_load_pending_until_symbol(base)) {
            ent = sym_lookup(self.classes_buf, base);
        }
        if (ent == null) { return false; }
        let d = sym_get_decl(ent);
        if (d == null || decl_get_kind(d) != de_TYPE_ALIAS()) { return false; }
        return string_contains(decl_get_generic_params(d), "|kind:newtype");
    }

    public fn resolve_type_alias_ref(self, ty: rawptr) -> rawptr {
        var cur_ty = ty;
        var depth: i32 = 0;
        while (cur_ty != null && depth < 16) {
            if (tref_get_kind(cur_ty) != ty_CLASS()) { return cur_ty; }
            let name = tref_get_name(cur_ty);
            let base = generic_call_base(name.clone());
            var ent = sym_lookup(self.classes_buf, base);
            if (ent == null && self.sema_lazy_load_pending_until_symbol(base)) {
                ent = sym_lookup(self.classes_buf, base);
            }
            if (ent == null) { return cur_ty; }
            let d = sym_get_decl(ent);
            if (d == null || decl_get_kind(d) != de_TYPE_ALIAS()) { return cur_ty; }
            let target = decl_get_ty(d);
            if (target == null) { return cur_ty; }
            let gp = sema_generic_params_prefix(decl_get_generic_params(d));
            let args = policy_generic_call_args(name.clone());
            if (gp.len > 0 && args.len > 0) {
                let subst = sema_substitute_type_with_args(target, gp, args);
                if (subst != null) {
                    cur_ty = subst;
                } else {
                    cur_ty = target;
                }
            } else {
                cur_ty = target;
            }
            depth = depth + 1;
        }
        return cur_ty;
    }

    public fn foreach_element_type_from_collection(self, coll_ty: rawptr) -> rawptr {
        if (coll_ty == null) { return tref_create_kind(ty_I32()); }
        let resolved = self.resolve_type_alias_ref(coll_ty);
        if (resolved != null) { coll_ty = resolved; }
        let coll_kind = tref_get_kind(coll_ty);
        if (coll_kind == ty_REF() || coll_kind == ty_MUTREF()) {
            return self.foreach_element_type_from_collection(tref_pointee(coll_ty));
        }
        if (coll_kind == ty_STRING()) {
            return tref_create_kind(ty_CHAR());
        }
        if (coll_kind == ty_RANGE()) {
            return tref_create_kind(ty_I64());
        }
        if (coll_kind == ty_ARRAY()) {
            let elem_ty = tref_array_elem(coll_ty);
            if (elem_ty != null) { return sema_clone_type_ref(elem_ty); }
            return tref_create_kind(ty_I32());
        }
        if (coll_kind == ty_CLASS()) {
            let coll_name = tref_get_name(coll_ty);
            let coll_base = module_last_segment(generic_call_base(coll_name.clone()));
            if (coll_base == "Range") {
                return tref_create_kind(ty_I64());
            }
            if (coll_base == "StrBytes") {
                return tref_create_kind(ty_U8());
            }
            if (coll_base == "StrChars") {
                return tref_create_kind(ty_CHAR());
            }
            if (coll_base == "String") {
                return tref_create_kind(ty_CHAR());
            }
            let args = policy_generic_call_args(coll_name.clone());
            let first_arg = generic_arg_at(args, 0);
            if (first_arg.len > 0) {
                return sema_type_name_to_ref(first_arg);
            }
        }
        return tref_create_kind(ty_I32());
    }

    public fn types_compatible(self, expected: rawptr, actual: rawptr) -> bool {
        if (expected == null || actual == null) { return true; }
        let expected_resolved = self.resolve_type_alias_ref(expected);
        let actual_resolved = self.resolve_type_alias_ref(actual);
        if (expected_resolved != null && actual_resolved != null) {
            if (type_name_is_generic(self.cur_generic_params, expected_resolved)) { return true; }
            if (type_name_is_generic(self.cur_generic_params, actual_resolved)) { return true; }
            let result_ok = sema_result_ok_type_ref(expected_resolved);
            if (result_ok != null && self.types_compatible(result_ok, actual_resolved)) {
                return true;
            }
            if (self.type_ref_is_newtype(expected) || self.type_ref_is_newtype(actual)) {
                return type_eq(expected_resolved, actual_resolved);
            }
            let ekr = tref_get_kind(expected_resolved);
            let akr = tref_get_kind(actual_resolved);
            if ((ekr == ty_CFN() && akr == ty_FN()) || (ekr == ty_FN() && akr == ty_CFN())) {
                return false;
            }
            if ((ekr == ty_CFN() && akr == ty_CFN()) || (ekr == ty_FN() && akr == ty_FN())) {
                if (!type_eq(tref_fn_ret(expected_resolved), tref_fn_ret(actual_resolved))) { return false; }
                return type_eq(tref_fn_params(expected_resolved), tref_fn_params(actual_resolved));
            }
            if (self.type_is_string_like(expected_resolved)
                && self.type_is_string_like(actual_resolved)) {
                return true;
            }
            if (tref_get_kind(expected) == ty_CLASS() || tref_get_kind(actual) == ty_CLASS()) {
                if (ekr != ty_CLASS() || akr != ty_CLASS()) {
                    return type_compatible(expected_resolved, actual_resolved);
                }
            }
        }
        if (tref_get_kind(expected) == ty_CLASS() && tref_get_kind(actual) == ty_CLASS()) {
            let en = tref_get_name(expected);
            let an = tref_get_name(actual);
            let eb = module_last_segment(generic_call_base(en.clone()));
            let ab = module_last_segment(generic_call_base(an.clone()));
            if (eb == ab && eb.len > 0) {
                let ea = policy_generic_call_args(en);
                let aa = policy_generic_call_args(an);
                if (generic_args_reference_params(ea, self.cur_generic_params)
                    || generic_args_reference_params(aa, self.cur_generic_params)) {
                    return true;
                }
            }
        }
        return type_compatible(expected, actual);
    }

    /// User-facing value binding: call args, let/var, assignment, return.
    /// `types_compatible` still treats any `&T` as compatible with any slot
    /// (needed for method-receiver / borrow plumbing). Value slots must not.
    public fn type_ref_peel_pointer(self, ty: rawptr) -> rawptr {
        if (ty == null) { return null; }
        var cur = ty;
        var depth: i32 = 0;
        while (cur != null && depth < 4) {
            let k = tref_get_kind(cur);
            if (k != ty_PTR() && k != ty_REF() && k != ty_MUTREF()) {
                return cur;
            }
            cur = tref_pointee(cur);
            depth = depth + 1;
        }
        return cur;
    }

    public fn type_ref_dyn_trait_name(self, ty: rawptr) -> string {
        if (ty == null) { return ""; }
        let peeled = self.type_ref_peel_pointer(ty);
        if (peeled == null) { return ""; }
        var name = "";
        if (tref_get_kind(peeled) == ty_CLASS()) {
            name = tref_get_name(peeled);
        }
        if (name.len == 0) { name = type_text_from_ty(peeled); }
        let payload = self.sema_dyn_iface_payload(name);
        if (payload.len == 0) { return ""; }
        return module_last_segment(generic_call_base(payload));
    }

    public fn types_compatible_user_value(self, expected: rawptr, actual: rawptr) -> bool {
        if (expected == null || actual == null) { return true; }
        if (self.type_ref_is_unresolved_generic_placeholder(expected)) { return true; }
        if (self.type_ref_is_unresolved_generic_placeholder(actual)) { return true; }
        var expected_resolved = self.resolve_type_alias_ref(expected);
        var actual_resolved = self.resolve_type_alias_ref(actual);
        if (expected_resolved == null) { expected_resolved = expected; }
        if (actual_resolved == null) { actual_resolved = actual; }
        // Alias resolution can strip `dyn` off `dynScene`, leaving the
        // interface class. Read the source spelling first.
        var dyn_trait = self.type_ref_dyn_trait_name(expected);
        if (dyn_trait.len == 0) {
            dyn_trait = self.type_ref_dyn_trait_name(expected_resolved);
        }
        if (dyn_trait.len == 0) {
            let iface_n = self.type_base_name(expected_resolved);
            if (iface_n.len > 0 && self.sema_find_interface_decl(iface_n) != null) {
                dyn_trait = iface_n;
            }
        }
        if (dyn_trait.len > 0) {
            let actual_dyn = self.type_ref_dyn_trait_name(actual_resolved);
            if (actual_dyn == dyn_trait) { return true; }
            let actual_core = self.type_ref_peel_pointer(actual_resolved);
            var actual_name = "";
            var actual_base = "";
            if (actual_core != null) {
                actual_name = generic_call_base(tref_get_name(actual_core));
                actual_base = self.type_base_name(actual_core);
            }
            if (self.type_dyn_actual_satisfies(actual_name, actual_base, dyn_trait)) {
                return true;
            }
            if (sema_env_enabled("VYX_DUMP_DYN")) {
                print("[dyn] want=" + type_text_from_ty(expected)
                    + " want_res=" + type_text_from_ty(expected_resolved)
                    + " want_kind=" + policy_i64_to_string(tref_get_kind(expected_resolved) as i64));
                self.sema_dump_dyn_candidates(actual_name, dyn_trait);
            }
        } else if (sema_env_enabled("VYX_DUMP_DYN")) {
            let el = type_text_from_ty(expected);
            let al = type_text_from_ty(actual);
            if (string_starts_with(el, "dyn") || string_starts_with(al, "dyn")
                || string_contains(el, "Scene") || string_contains(al, "SceneBase")) {
                print("[dyn] SKIP want=" + el
                    + " want_res=" + type_text_from_ty(expected_resolved)
                    + " got=" + al);
            }
        }
        let ek = tref_get_kind(expected_resolved);
        let ak = tref_get_kind(actual_resolved);
        if ((ak == ty_REF() || ak == ty_MUTREF())
            && ek != ty_REF()
            && ek != ty_MUTREF()
            && ek != ty_PTR()
            && ek != ty_RAWPTR()) {
            return false;
        }
        if ((ek == ty_CFN() && ak == ty_FN()) || (ek == ty_FN() && ak == ty_CFN())) {
            return false;
        }
        // Unique rule: named integers widen, they do not silently narrow or
        // change signedness. Integer *literals* that fit are adopted on the
        // expression, not here.
        if (type_kind_is_int(ek) && type_kind_is_int(ak)) {
            if (type_eq(expected_resolved, actual_resolved)) { return true; }
            let same_sign = (type_kind_is_signed_int(ek) && type_kind_is_signed_int(ak))
                || (type_kind_is_unsigned_int(ek) && type_kind_is_unsigned_int(ak));
            if (!same_sign) { return false; }
            let expected_bits = type_kind_int_bits(ek);
            let actual_bits = type_kind_int_bits(ak);
            return expected_bits > 0 && actual_bits > 0 && actual_bits <= expected_bits;
        }
        // Unique rule: rawptr is an untyped address. It accepts pointer
        // handles, not integer/class values. The reverse (rawptr into a
        // non-pointer value slot) is also rejected here; typed `*T` still
        // goes through `types_compatible` so C FFI can pass `null`.
        if (ek == ty_RAWPTR()) {
            return ak == ty_RAWPTR() || ak == ty_PTR() || ak == ty_REF() || ak == ty_MUTREF();
        }
        if (ak == ty_RAWPTR()
            && ek != ty_RAWPTR()
            && ek != ty_PTR()
            && ek != ty_REF()
            && ek != ty_MUTREF()) {
            return false;
        }
        return self.types_compatible(expected_resolved, actual_resolved);
    }

    public fn expr_adopts_expected_generic_class(self,
                                                 expr: rawptr,
                                                 expected: rawptr,
                                                 actual: rawptr) -> bool {
        if (expr == null || expected == null || actual == null) { return false; }
        let ek = expr_get_kind(expr);
        if (ek != ex_CALL() && ek != ex_STRUCT_INIT()) { return false; }
        let expected_resolved = self.resolve_type_alias_ref(expected);
        let actual_resolved = self.resolve_type_alias_ref(actual);
        if (expected_resolved == null || actual_resolved == null) { return false; }
        if (tref_get_kind(expected_resolved) != ty_CLASS()
            || tref_get_kind(actual_resolved) != ty_CLASS()) {
            return false;
        }
        let expected_name = tref_get_name(expected_resolved);
        let actual_name = tref_get_name(actual_resolved);
        let expected_base = module_last_segment(generic_call_base(expected_name.clone()));
        let actual_base = module_last_segment(generic_call_base(actual_name.clone()));
        if (expected_base.len == 0 || actual_base.len == 0 || expected_base != actual_base) {
            return false;
        }
        let expected_args = policy_generic_call_args(expected_name.clone());
        let actual_args = policy_generic_call_args(actual_name.clone());
        if (expected_args.len == 0) { return false; }
        let args_already_match = expected_args == actual_args;
        if (ek == ex_CALL() && args_already_match) {
            return false;
        }
        if (!args_already_match) {
            let class_decl = self.class_decl_for_type_base(actual_base.clone());
            if (class_decl == null) { return false; }
            let class_generics = decl_get_generic_params(class_decl);
            if (class_generics.len == 0) { return false; }
            if (actual_args.len > 0
                && !generic_args_reference_params(actual_args, class_generics)) {
                return false;
            }
            if (actual_args.len > 0
                && generic_args_reference_params(expected_args, class_generics)) {
                return false;
            }
        }
        mono_scheduler_record_class_request_named(self.mono_scheduler, expected_name.clone());
        if (ek == ex_CALL()) {
            let callee = expr_get_lhs(expr);
            if (callee != null && expr_get_kind(callee) == ex_MEMBER()) {
                let recv = expr_get_lhs(callee);
                if (recv != null) {
                    expr_set_ty(recv, expected);
                    if (expr_get_kind(recv) == ex_IDENT()
                        || expr_get_kind(recv) == ex_MEMBER()) {
                        expr_set_name(recv, expected_name);
                    }
                }
            } else if (callee != null && expr_get_kind(callee) == ex_IDENT()) {
                expr_set_ty(callee, expected);
                expr_set_name(callee, expected_name);
            }
        } else if (ek == ex_STRUCT_INIT()) {
            expr_set_name(expr, expected_name);
            self.adopt_struct_init_expected_fields(expr, expected_resolved);
        }
        expr_set_ty(expr, expected);
        return true;
    }

    public fn infer_generic_arg_text_for_param(self,
                                               param_name: string,
                                               pattern_text: string,
                                               expected_text: string) -> string {
        if (param_name.len == 0 || pattern_text.len == 0 || expected_text.len == 0) { return ""; }
        if (pattern_text == param_name) { return expected_text; }
        let pattern_base = generic_call_base(pattern_text.clone());
        if (pattern_base == param_name || module_last_segment(pattern_base.clone()) == param_name) {
            return expected_text;
        }
        let pattern_args = policy_generic_call_args(pattern_text.clone());
        let expected_args = policy_generic_call_args(expected_text.clone());
        if (pattern_args.len == 0 || expected_args.len == 0) { return ""; }
        let expected_base = generic_call_base(expected_text.clone());
        if (module_last_segment(pattern_base.clone()) != module_last_segment(expected_base.clone())) {
            return "";
        }
        var i: i32 = 0;
        while (i < 64) {
            let pa = generic_arg_at(pattern_args, i);
            let ea = generic_arg_at(expected_args, i);
            if (pa.len == 0 || ea.len == 0) { return ""; }
            let inferred = self.infer_generic_arg_text_for_param(param_name, pa, ea);
            if (inferred.len > 0) { return inferred; }
            i = i + 1;
        }
        return "";
    }

    public fn infer_generic_args_from_expected_type(self,
                                                   generic_params: string,
                                                   pattern_ty: rawptr,
                                                   expected_ty: rawptr) -> string {
        if (generic_params.len == 0 || pattern_ty == null || expected_ty == null) { return ""; }
        let gp_count = generic_param_count(generic_params);
        if (gp_count <= 0) { return ""; }
        let pattern_text = type_text_from_ty(pattern_ty);
        let expected_text = type_text_from_ty(expected_ty);
        if (pattern_text.len == 0 || expected_text.len == 0) { return ""; }
        var out = "";
        var i: i32 = 0;
        while (i < gp_count) {
            let param_name = generic_param_at(generic_params, i);
            let inferred = self.infer_generic_arg_text_for_param(param_name,
                                                                 pattern_text.clone(),
                                                                 expected_text.clone());
            if (inferred.len == 0) { return ""; }
            if (out.len > 0) { out = out + ","; }
            out = out + inferred;
            i = i + 1;
        }
        return out;
    }

    public fn infer_generic_args_from_call_args(self,
                                                generic_params: string,
                                                fdecl: rawptr,
                                                call_expr: rawptr) -> string {
        if (generic_params.len == 0 || fdecl == null || call_expr == null) { return ""; }
        let gp_count = generic_param_count(generic_params);
        if (gp_count <= 0) { return ""; }
        var out = "";
        var pi: i32 = 0;
        while (pi < gp_count) {
            let param_name = generic_param_at(generic_params, pi);
            var inferred = "";
            var pp = decl_get_params(fdecl);
            if (decl_get_kind(fdecl) == de_METHOD()
                && pp != null
                && decl_get_name(pp) == "self") {
                pp = decl_get_next(pp);
            }
            var ac = expr_get_args(call_expr);
            var prefix_pending = self.pipe_call_context == call_expr
                && self.pipe_prefix_expr != null;
            while (pp != null && (prefix_pending || ac != null) && inferred.len == 0) {
                var arg_e: rawptr = null;
                if (prefix_pending) {
                    arg_e = self.pipe_prefix_expr;
                    prefix_pending = false;
                } else {
                    arg_e = stmt_get_init(ac);
                    ac = stmt_get_next(ac);
                }
                let param_ty = decl_get_ty(pp);
                var arg_ty: rawptr = null;
                if (arg_e != null) {
                    arg_ty = expr_get_ty(arg_e);
                    if (arg_ty == null) { arg_ty = self.resolve_expr(arg_e); }
                }
                if (param_ty != null && arg_ty != null) {
                    let got = self.infer_generic_arg_text_for_param(param_name,
                                                                    type_text_from_ty(param_ty),
                                                                    type_text_from_ty(arg_ty));
                    if (got.len > 0) { inferred = got; }
                }
                pp = decl_get_next(pp);
            }
            if (inferred.len == 0) { return ""; }
            if (out.len > 0) { out = out + ","; }
            out = out + inferred;
            pi = pi + 1;
        }
        return out;
    }

    public fn apply_expected_generic_call_args(self,
                                               call_expr: rawptr,
                                               fdecl: rawptr,
                                               inferred_args: string) -> bool {
        if (call_expr == null || fdecl == null || !sema_generic_args_closed(inferred_args)) { return false; }
        if (expr_get_kind(call_expr) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(call_expr);
        if (callee == null) { return false; }
        if (expr_get_kind(callee) == ex_IDENT()) {
            let raw_name = expr_get_name(callee);
            if (policy_generic_call_has_args(raw_name) != 0) { return true; }
            let base = generic_call_base(raw_name.clone());
            expr_set_name(callee, base + "::<" + inferred_args + ">");
            mono_scheduler_record_fn_request_named(self.mono_scheduler,
                                                   base + "::<" + inferred_args + ">");
            return true;
        }
        if (expr_get_kind(callee) == ex_MEMBER()) {
            let raw_name2 = expr_get_name(callee);
            if (policy_generic_call_has_args(raw_name2) != 0) { return true; }
            let base2 = generic_call_base(raw_name2.clone());
            expr_set_name(callee, base2 + "::<" + inferred_args + ">");
            let recv_ty = self.member_receiver_effective_type(callee);
            if (recv_ty != null && tref_get_kind(recv_ty) == ty_CLASS()) {
                mono_scheduler_record_method_request_named(self.mono_scheduler,
                                                          tref_get_name(recv_ty),
                                                          base2 + "::<" + inferred_args + ">");
            }
            return true;
        }
        return false;
    }

    public fn expr_adopts_expected_generic_return(self,
                                                  expr: rawptr,
                                                  expected: rawptr,
                                                  actual: rawptr) -> bool {
        if (expr == null || expected == null || actual == null) { return false; }
        if (self.type_ref_is_unresolved_generic_placeholder(expected)) { return false; }
        if (expr_get_kind(expr) != ex_CALL()) { return false; }
        let sem_kind = expr_get_semantic_kind(expr);
        if (sem_kind != expr_sem_DIRECT_FN() && sem_kind != expr_sem_METHOD()) {
            return false;
        }
        let fdecl = expr_get_semantic_target(expr);
        if (fdecl == null) { return false; }
        let fkind = decl_get_kind(fdecl);
        if (fkind != de_FN() && fkind != de_METHOD()) { return false; }
        let gp = decl_get_generic_params(fdecl);
        if (generic_param_count(gp) <= 0) { return false; }
        let ret_ty = decl_get_ty(fdecl);
        if (ret_ty == null) { return false; }
        let inferred_args = self.infer_generic_args_from_expected_type(gp, ret_ty, expected);
        if (!sema_generic_args_closed(inferred_args)) { return false; }
        if (!self.apply_expected_generic_call_args(expr, fdecl, inferred_args)) { return false; }
        let subst_ret = sema_substitute_type_with_args(ret_ty, gp, inferred_args);
        if (subst_ret != null) {
            if (!self.types_compatible(expected, subst_ret)
                && !type_ref_implicitly_convertible(subst_ret, expected)) {
                return false;
            }
            expr_set_ty(expr, subst_ret);
        } else {
            expr_set_ty(expr, expected);
        }
        return true;
    }

    public fn member_type_for_class_instance(self, instance_ty: rawptr, member_name: string) -> rawptr {
        if (instance_ty == null || member_name.len == 0) { return null; }
        let resolved = self.resolve_type_alias_ref(instance_ty);
        if (resolved == null || tref_get_kind(resolved) != ty_CLASS()) { return null; }
        let type_name = tref_get_name(resolved);
        let base = generic_call_base(type_name.clone());
        let args = policy_generic_call_args(type_name.clone());
        let cd = self.class_decl_for_type_base(base.clone());
        if (cd == null) { return null; }
        let mp = self.class_decl_member_deep(cd, member_name, 0);
        let owner = self.class_decl_member_owner_deep(cd, member_name, 0);
        if (mp == null || owner == null) { return null; }
        if (decl_get_kind(mp) == de_METHOD() || decl_get_kind(mp) == de_VARIANT()) { return null; }
        var member_ty = decl_get_ty(mp);
        if (member_ty != null && args.len > 0) {
            member_ty = sema_substitute_type_with_args(member_ty,
                                                       decl_get_generic_params(owner),
                                                       args);
        }
        return member_ty;
    }

    public fn adopt_struct_init_expected_fields(self, expr: rawptr, expected_ty: rawptr) {
        if (expr == null || expected_ty == null || expr_get_kind(expr) != ex_STRUCT_INIT()) { return; }
        var cell = expr_get_args(expr);
        while (cell != null) {
            let field_name = stmt_get_name(cell);
            let field_expr = stmt_get_init(cell);
            let field_ty = self.member_type_for_class_instance(expected_ty, field_name);
            if (field_expr != null && field_ty != null) {
                var actual_ty = expr_get_ty(field_expr);
                if (actual_ty == null) { actual_ty = self.resolve_expr(field_expr); }
                self.expr_adopts_expected_type(field_expr, field_ty, actual_ty);
            }
            cell = stmt_get_next(cell);
        }
    }

    public fn expr_adopts_expected_aggregate(self,
                                             expr: rawptr,
                                             expected: rawptr,
                                             actual: rawptr) -> bool {
        if (expr == null || expected == null || actual == null) { return false; }
        let ek = expr_get_kind(expr);
        let expected_resolved = self.resolve_type_alias_ref(expected);
        if (expected_resolved == null) { return false; }
        if (ek == ex_ARRAY_LIT() && tref_get_kind(expected_resolved) == ty_ARRAY()) {
            let elem_ty = tref_array_elem(expected_resolved);
            var cell = expr_get_args(expr);
            while (cell != null) {
                let elem_expr = stmt_get_init(cell);
                if (elem_expr != null && elem_ty != null) {
                    var elem_actual = expr_get_ty(elem_expr);
                    if (elem_actual == null) { elem_actual = self.resolve_expr(elem_expr); }
                    self.expr_adopts_expected_type(elem_expr, elem_ty, elem_actual);
                }
                cell = stmt_get_next(cell);
            }
            expr_set_ty(expr, expected);
            return true;
        }
        if (ek == ex_TUPLE_LIT() && tref_get_kind(expected_resolved) == ty_TUPLE()) {
            let want_count = tref_tuple_count(expected_resolved);
            var idx: i64 = 0;
            var cell2 = expr_get_args(expr);
            while (cell2 != null && idx < want_count) {
                let elem_expr2 = stmt_get_init(cell2);
                let elem_ty2 = tref_tuple_elem_at(expected_resolved, idx);
                if (elem_expr2 != null && elem_ty2 != null) {
                    var elem_actual2 = expr_get_ty(elem_expr2);
                    if (elem_actual2 == null) { elem_actual2 = self.resolve_expr(elem_expr2); }
                    self.expr_adopts_expected_type(elem_expr2, elem_ty2, elem_actual2);
                }
                idx = idx + 1;
                cell2 = stmt_get_next(cell2);
            }
            if (cell2 == null && idx == want_count) {
                expr_set_ty(expr, expected);
                return true;
            }
        }
        return false;
    }

    public fn expr_adopts_expected_type(self,
                                        expr: rawptr,
                                        expected: rawptr,
                                        actual: rawptr) -> bool {
        if (expr == null || expected == null || actual == null) { return false; }
        if (self.expr_adopts_expected_int_literal(expr, expected)) { return true; }
        if (sema_contextualize_float_literal(expr, expected) != null) { return true; }
        if (self.expr_adopts_expected_null(expr, expected)) { return true; }
        if (self.expr_matches_expected_variant(expr, expected)) { return true; }
        if (self.expr_adopts_expected_generic_return(expr, expected, actual)) { return true; }
        if (self.expr_adopts_expected_generic_class(expr, expected, actual)) { return true; }
        if (self.expr_adopts_expected_aggregate(expr, expected, actual)) { return true; }
        if (self.expr_adopts_expected_int_expr(expr, expected, actual)) { return true; }
        return false;
    }

    public fn expr_adopts_expected_int_expr(self,
                                            expr: rawptr,
                                            expected: rawptr,
                                            actual: rawptr) -> bool {
        if (expr == null || expected == null || actual == null) { return false; }
        var expected_resolved = self.resolve_type_alias_ref(expected);
        var actual_resolved = self.resolve_type_alias_ref(actual);
        if (expected_resolved == null) { expected_resolved = expected; }
        if (actual_resolved == null) { actual_resolved = actual; }
        let ek = tref_get_kind(expected_resolved);
        let ak = tref_get_kind(actual_resolved);
        if (!type_kind_is_int(ek) || !type_kind_is_int(ak)) { return false; }
        if (type_eq(expected_resolved, actual_resolved)) { return false; }
        let same_sign = (type_kind_is_signed_int(ek) && type_kind_is_signed_int(ak))
            || (type_kind_is_unsigned_int(ek) && type_kind_is_unsigned_int(ak));
        if (!same_sign) { return false; }
        expr_set_ty(expr, expected_resolved);
        return true;
    }

    public fn expr_adopts_expected_int_literal(self, expr: rawptr, expected: rawptr) -> bool {
        if (expr == null || expected == null) { return false; }
        if (expr_get_kind(expr) != ex_INT_LIT()) { return false; }
        var expected_resolved = self.resolve_type_alias_ref(expected);
        if (expected_resolved == null) { expected_resolved = expected; }
        let ek = tref_get_kind(expected_resolved);
        if (!type_kind_is_int(ek)) { return false; }
        if (!sema_int_literal_fits_type_kind(expr_get_int_val(expr), ek)) { return false; }
        expr_set_ty(expr, expected_resolved);
        return true;
    }

    public fn expr_adopts_expected_null(self, expr: rawptr, expected: rawptr) -> bool {
        if (expr == null || expected == null) { return false; }
        if (expr_get_kind(expr) != ex_NULL_LIT()) { return false; }
        var expected_resolved = self.resolve_type_alias_ref(expected);
        if (expected_resolved == null) { expected_resolved = expected; }
        let ek = tref_get_kind(expected_resolved);
        if (ek != ty_RAWPTR() && ek != ty_PTR() && ek != ty_REF() && ek != ty_MUTREF()) {
            return false;
        }
        expr_set_ty(expr, expected_resolved);
        return true;
    }

    public fn find_enum_variant_decl(self, enum_decl: rawptr, variant_name: string) -> rawptr {
        if (enum_decl == null || variant_name.len == 0) { return null; }
        var m = decl_get_members(enum_decl);
        while (m != null) {
            if (decl_get_kind(m) == de_VARIANT()
                && decl_get_name(m) == variant_name) {
                return m;
            }
            m = decl_get_next(m);
        }
        return null;
    }

    public fn expr_matches_expected_variant(self, expr: rawptr, expected: rawptr) -> bool {
        if (expr == null || expected == null) { return false; }
        let enum_decl = self.enum_decl_for_type(expected);
        if (enum_decl == null) { return false; }
        let ek = expr_get_kind(expr);
        if (ek == ex_IDENT()) {
            let vd = self.find_enum_variant_decl(enum_decl, expr_get_name(expr));
            if (vd != null && decl_get_params(vd) == null) {
                expr_set_ty(expr, expected);
                return true;
            }
            return false;
        }
        if (ek == ex_MEMBER()) {
            let member_name = generic_call_base(expr_get_name(expr));
            let vd_member = self.find_enum_variant_decl(enum_decl, member_name);
            if (vd_member != null) {
                expr_set_ty(expr, expected);
                return true;
            }
            return false;
        }
        if (ek == ex_CALL()) {
            let callee = expr_get_lhs(expr);
            if (callee == null) { return false; }
            var cname_full: string = "";
            if (expr_get_kind(callee) == ex_IDENT()) {
                cname_full = expr_get_name(callee);
            } else if (expr_get_kind(callee) == ex_MEMBER()) {
                cname_full = expr_get_name(callee);
            } else {
                return false;
            }
            let call_args = policy_generic_call_args(cname_full.clone());
            if (call_args.len > 0 && tref_get_kind(expected) == ty_CLASS()) {
                let expected_args = policy_generic_call_args(tref_get_name(expected));
                if (expected_args.len > 0 && expected_args != call_args) {
                    return false;
                }
            }
            let vd2 = self.find_enum_variant_decl(enum_decl, generic_call_base(cname_full));
            if (vd2 != null) {
                expr_set_ty(expr, expected);
                return true;
            }
        }
        return false;
    }

    public fn pattern_variant_name(self, pat: rawptr) -> string {
        if (pat == null) { return ""; }
        let pk = expr_get_kind(pat);
        if (pk == ex_IDENT()) { return generic_call_base(expr_get_name(pat)); }
        if (pk == ex_MEMBER()) { return generic_call_base(expr_get_name(pat)); }
        if (pk == ex_CALL()) {
            let callee = expr_get_lhs(pat);
            if (callee == null) { return ""; }
            if (expr_get_kind(callee) == ex_IDENT()) {
                return generic_call_base(expr_get_name(callee));
            }
            if (expr_get_kind(callee) == ex_MEMBER()) {
                return generic_call_base(expr_get_name(callee));
            }
        }
        return "";
    }

    public fn variant_payload_type_at(self,
                                      enum_ty: rawptr,
                                      variant_decl: rawptr,
                                      want_idx: i32) -> rawptr {
        if (enum_ty == null || variant_decl == null) { return tref_create_kind(ty_RAWPTR()); }
        let enum_name = tref_get_name(enum_ty);
        let enum_args = policy_generic_call_args(enum_name.clone());
        var enum_gp: string = "";
        let enum_decl = self.enum_decl_for_type(enum_ty);
        if (enum_decl != null) {
            enum_gp = decl_get_generic_params(enum_decl);
        }
        var p = decl_get_params(variant_decl);
        var idx: i32 = 0;
        while (p != null) {
            if (idx == want_idx) {
                return sema_substitute_type_with_args(decl_get_ty(p),
                                                      enum_gp,
                                                      enum_args);
            }
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return tref_create_kind(ty_RAWPTR());
    }

    public fn variant_callee_type_for_match(self,
                                            enum_ty: rawptr,
                                            enum_decl: rawptr,
                                            variant_decl: rawptr) -> rawptr {
        var fn_ty = tref_fn_from_decl(variant_decl);
        if (enum_ty == null || enum_decl == null || fn_ty == null) { return fn_ty; }
        let enum_name = tref_get_name(enum_ty);
        let enum_args = policy_generic_call_args(enum_name.clone());
        if (enum_args.len == 0) { return fn_ty; }
        return sema_substitute_type_with_args(fn_ty,
                                              decl_get_generic_params(enum_decl),
                                              enum_args);
    }

    public fn variant_owner_type_for_call(self,
                                          enum_decl: rawptr,
                                          variant_decl: rawptr,
                                          explicit_args: string,
                                          args_head: rawptr) -> string {
        if (enum_decl == null) { return ""; }
        let enum_name = decl_get_name(enum_decl);
        let enum_base = generic_call_base(enum_name.clone());
        if (explicit_args.len > 0) {
            return enum_base + "::<" + explicit_args + ">";
        }
        let gp = decl_get_generic_params(enum_decl);
        let gp_count = generic_param_count(gp);
        if (gp_count <= 0) { return enum_name; }
        var out_args = "";
        var pi: i32 = 0;
        while (pi < gp_count) {
            let param_name = generic_param_at(gp, pi);
            var inferred = "";
            var vp = decl_get_params(variant_decl);
            var ac = args_head;
            while (vp != null && ac != null) {
                let payload_ty = decl_get_ty(vp);
                let payload_text = type_text_from_ty(payload_ty);
                if (payload_text == param_name) {
                    let arg_expr = stmt_get_init(ac);
                    var arg_ty: rawptr = null;
                    if (arg_expr != null) {
                        arg_ty = expr_get_ty(arg_expr);
                        if (arg_ty == null) {
                            arg_ty = self.resolve_expr(arg_expr);
                        }
                    }
                    inferred = type_text_from_ty(arg_ty);
                    break;
                }
                vp = decl_get_next(vp);
                ac = stmt_get_next(ac);
            }
            if (inferred.len == 0) {
                return enum_name;
            }
            if (out_args.len > 0) { out_args = out_args + ","; }
            out_args = out_args + inferred;
            pi = pi + 1;
        }
        return enum_base + "::<" + out_args + ">";
    }

    public fn variant_callee_type_for_owner_text(self,
                                                 owner_type_name: string,
                                                 enum_decl: rawptr,
                                                 variant_decl: rawptr) -> rawptr {
        var fn_ty = tref_fn_from_decl(variant_decl);
        if (owner_type_name.len == 0 || enum_decl == null || fn_ty == null) { return fn_ty; }
        let enum_args = policy_generic_call_args(owner_type_name.clone());
        if (enum_args.len == 0) { return fn_ty; }
        return sema_substitute_type_with_args(fn_ty,
                                              decl_get_generic_params(enum_decl),
                                              enum_args);
    }

    public fn resolve_match_pattern(self, pat: rawptr, scrut_ty: rawptr) -> bool {
        let vname = self.pattern_variant_name(pat);
        if (vname.len == 0) { return false; }
        var enum_decl = self.enum_decl_for_type(scrut_ty);
        var effective_scrut_ty = scrut_ty;
        if (enum_decl == null) {
            enum_decl = self.find_variant_owner_decl(vname);
            if (enum_decl != null) {
                effective_scrut_ty = tref_create_class(decl_get_name(enum_decl));
            }
        }
        if (enum_decl == null) { return false; }
        let vd = self.find_enum_variant_decl(enum_decl, vname);
        if (vd == null) { return false; }
        expr_set_ty(pat, effective_scrut_ty);
        expr_set_semantic(pat, expr_sem_VARIANT(), vd, enum_decl, 0);
        if (expr_get_kind(pat) != ex_CALL()) { return true; }
        let pat_callee = expr_get_lhs(pat);
        if (pat_callee != null) {
            expr_set_ty(pat_callee, self.variant_callee_type_for_match(effective_scrut_ty,
                                                                       enum_decl,
                                                                       vd));
            expr_set_semantic(pat_callee, expr_sem_VARIANT(), vd, enum_decl, 0);
        }
        var ac = expr_get_args(pat);
        var idx: i32 = 0;
        while (ac != null) {
            let arg = stmt_get_init(ac);
            if (arg != null && expr_get_kind(arg) == ex_IDENT()) {
                let bind_name = expr_get_name(arg);
                let bind_ty = self.variant_payload_type_at(effective_scrut_ty, vd, idx);
                expr_set_ty(arg, bind_ty);
                if (bind_name != "_") {
                    self.cur_locals = sym_push_local(self.cur_locals, bind_name, bind_ty);
                    self.locals_count = self.locals_count + 1;
                    expr_set_semantic(arg, expr_sem_LOCAL(), self.cur_locals, null, 0);
                }
            } else if (arg != null) {
                self.resolve_expr(arg);
            }
            idx = idx + 1;
            ac = stmt_get_next(ac);
        }
        return true;
    }

    // ────────────────────────────────────────────────────────────────
    //   Pass 1 — collect_decls. Registers top-level CLASS / FN / EXT
    //   and validates per-class member uniqueness.
    // ────────────────────────────────────────────────────────────────

    public fn sema_versioned_module_pair(self, a: string, b: string) -> bool {
        if (a.len == 0 || b.len == 0 || a == b) { return false; }
        let av = policy_module_version(a);
        let bv = policy_module_version(b);
        if (av.len == 0 || bv.len == 0) { return false; }
        return policy_module_base(a) == policy_module_base(b)
            && policy_module_variant(a) == policy_module_variant(b);
    }

    fn sema_field_migrate_args(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        return policy_meta_attribute_value(decl_get_meta(d), "migrate");
    }

    fn sema_field_migrate_from_version(self, d: rawptr) -> string {
        let args = self.sema_field_migrate_args(d);
        if (args.len == 0) { return ""; }
        return policy_strip_quoted_string(
            policy_named_argument_value(args, "fromVer"));
    }

    fn sema_field_migrate_from_field(self, d: rawptr) -> string {
        let args = self.sema_field_migrate_args(d);
        if (args.len == 0) { return ""; }
        return policy_strip_quoted_string(
            policy_named_argument_value(args, "fromField"));
    }

    /// Resolve an old source spelling directly to the current field. The
    /// historical declaration is intentionally not kept as a second layout
    /// field when `fromField` is present: both names denote one storage slot.
    fn sema_field_alias_member(self, members: rawptr, old_name: string) -> rawptr {
        if (members == null || old_name.len == 0) { return null; }
        var cur = members;
        while (cur != null) {
            if (decl_get_kind(cur) == de_FIELD()
                && self.sema_field_migrate_from_field(cur) == old_name) {
                return cur;
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    fn sema_history_has_field(self, history: rawptr, field_name: string) -> bool {
        if (history == null || field_name.len == 0) { return false; }
        var cur = decl_get_members(history);
        while (cur != null) {
            if (decl_get_kind(cur) == de_FIELD()
                && decl_get_name(cur) == field_name) {
                return true;
            }
            cur = decl_get_next(cur);
        }
        return false;
    }

    /// Imported declarations retain their source path on the owning top-level
    /// class. Diagnostics emitted later during lazy version merging must
    /// temporarily restore that file/source context; otherwise a valid member
    /// location is rendered against the call-site file that triggered loading.
    fn sema_report_field_migration_error(self,
                                         owner: rawptr,
                                         field: rawptr,
                                         message: string) {
        let saved_path = diag_current_file();
        var saved_source = "";
        if (saved_path.len > 0 && saved_path != "<unknown>") {
            saved_source = sema_source_read(saved_path);
        }
        var source_path = "";
        if (owner != null) {
            source_path = self.sema_extract_source_path_meta(decl_get_meta(owner));
        }
        let switched = source_path.len > 0 && fileExists(source_path);
        if (switched) {
            diag_set_source_context(source_path, sema_source_read(source_path));
        }
        self.report_error_coded(diag_code_sema_version_policy(),
                                decl_loc_ptr(field),
                                message);
        if (switched) {
            diag_set_source_context(saved_path, saved_source);
        }
        if (owner != null) {
            let owner_meta = decl_get_meta(owner);
            if (!string_contains(owner_meta, "|version-field-invalid|")) {
                decl_set_meta(owner, owner_meta + "|version-field-invalid|");
            }
        }
    }

    fn sema_validate_field_migrations_for_history(self,
                                                   primary: rawptr,
                                                   history: rawptr,
                                                   history_module: string) {
        if (primary == null || history == null || history_module.len == 0) { return; }
        let history_version = policy_module_version(history_module);
        var cur = decl_get_members(primary);
        while (cur != null) {
            let from_field = self.sema_field_migrate_from_field(cur);
            let from_version = self.sema_field_migrate_from_version(cur);
            if (from_field.len > 0) {
                if (decl_get_kind(cur) != de_FIELD()) {
                    self.sema_report_field_migration_error(
                        primary,
                        cur,
                        "migrate(fromField=...) is only valid on fields");
                } else if (from_version.len == 0) {
                    self.sema_report_field_migration_error(
                        primary,
                        cur,
                        "field migration for '" + decl_get_name(cur)
                            + "' requires fromVer together with fromField");
                } else if (from_version == history_version) {
                    if (!self.sema_history_has_field(history, from_field)) {
                        self.sema_report_field_migration_error(
                            primary,
                            cur,
                            "field migration for '" + decl_get_name(cur)
                                + "' references missing source field '" + from_field
                                + "' in version '" + history_module + "'");
                    }
                    var prev = decl_get_members(primary);
                    while (prev != null && prev != cur) {
                        if (decl_get_kind(prev) == de_FIELD()
                            && self.sema_field_migrate_from_version(prev) == from_version
                            && self.sema_field_migrate_from_field(prev) == from_field) {
                            self.sema_report_field_migration_error(
                                primary,
                                cur,
                                "fields '" + decl_get_name(prev) + "' and '"
                                    + decl_get_name(cur) + "' both migrate source field '"
                                    + from_field + "' from version '" + from_version + "'");
                            break;
                        }
                        prev = decl_get_next(prev);
                    }
                }
            }
            cur = decl_get_next(cur);
        }
    }

    fn sema_current_field_for_history(self,
                                      primary_members: rawptr,
                                      history_field: rawptr,
                                      history_module: string) -> rawptr {
        if (primary_members == null || history_field == null) { return null; }
        let old_name = decl_get_name(history_field);
        let history_version = policy_module_version(history_module);
        var cur = primary_members;
        while (cur != null) {
            if (decl_get_kind(cur) == de_FIELD()) {
                let args = self.sema_field_migrate_args(cur);
                let from_field = self.sema_field_migrate_from_field(cur);
                let from_version = self.sema_field_migrate_from_version(cur);
                if (from_field.len > 0
                    && from_field == old_name
                    && from_version == history_version) {
                    return cur;
                }
                // An explicit field-level migrate without fromField means the
                // field is new in the current layout, even if its spelling
                // happens to equal a historical field.
                if (args.len == 0 && decl_get_name(cur) == old_name) {
                    return cur;
                }
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    public fn sema_merge_versioned_class_members(self,
                                                 primary: rawptr,
                                                 history: rawptr,
                                                 history_module: string) {
        if (primary == null || history == null || history_module.len == 0) { return; }
        let marker = "|version-merged:" + history_module + "|";
        if (string_contains(decl_get_meta(primary), marker)) { return; }
        self.sema_validate_field_migrations_for_history(primary,
                                                        history,
                                                        history_module);
        let primary_members = decl_get_members(primary);
        let cloned = sema_clone_decl_chain(decl_get_members(history));
        var filtered_head: rawptr = null;
        var filtered_tail: rawptr = null;
        var hp = cloned;
        while (hp != null) {
            let next = decl_get_next(hp);
            decl_set_next(hp, null);
            var append_history = true;
            if (decl_get_kind(hp) == de_FIELD()
                && self.sema_current_field_for_history(primary_members,
                                                       hp,
                                                       history_module) != null) {
                append_history = false;
            }
            if (append_history) {
                if (filtered_head == null) {
                    filtered_head = hp;
                    filtered_tail = hp;
                } else {
                    decl_set_next(filtered_tail, hp);
                    filtered_tail = hp;
                }
            }
            hp = next;
        }
        if (filtered_head != null) {
            if (primary_members == null) {
                decl_set_members(primary, filtered_head);
            } else {
                var tail = primary_members;
                while (decl_get_next(tail) != null) {
                    tail = decl_get_next(tail);
                }
                decl_set_next(tail, filtered_head);
            }
        }
        decl_set_meta(primary, decl_get_meta(primary) + marker);
    }

    public fn collect_decls(self, unit_ptr: rawptr) -> i32 {
        if (unit_ptr == null) { return 0; }
        var cur = unit_get_decls(unit_ptr);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            let k = decl_get_kind(cur);
            let name = decl_get_name(cur);
            if (k == de_CLASS()) {
                let cur_gp = decl_get_generic_params(cur);
                if (!string_contains(cur_gp, "|kind:impl")
                    && !string_contains(decl_get_meta(cur), "|imported")
                    && self.decl_source_module(cur, null) != "std.ref"
                    && sema_is_reserved_user_class_name(name.clone())) {
                    self.report_error_help(diag_code_sema_redefinition(),
                                            g_sema_cur_loc,
                                            "class name '" + name + "' is reserved for std smart-pointer types",
                                            "pick a different name, or write `impl " + name + "` to extend the std class");
                }
                var class_key = name;
                if (sema_meta_is_full_concrete_spec(cur_gp)) {
                    class_key = sema_specialized_class_key(name, cur_gp);
                    // PLAN_SEMA_ROOT_FIX S4: mirror every class instantiation
                    // pushed by Sema into the scheduler ledger so dump_stats
                    // matches `vyx::Sema::dumpMonoSchedulerStats` semantics.
                    mono_scheduler_record_class_request(self.mono_scheduler,
                                                       cur,
                                                       sema_generic_params_prefix(cur_gp));
                }
                let existing_class = sym_lookup(self.classes_buf, class_key.clone());
                if (existing_class != null
                    && !string_contains(cur_gp, "|kind:impl")
                    && !string_contains(cur_gp, "|kind:interface")) {
                    let existing_d = sym_get_decl(existing_class);
                    if (existing_d != null
                        && !string_contains(decl_get_generic_params(existing_d), "|kind:interface")
                        && sema_name_matches_qualified_or_short(decl_get_name(existing_d), name)) {
                        let clause = sema_impl_clause_text(cur_gp);
                        var iidx: i32 = 0;
                        while (iidx < 16) {
                            let parent = generic_arg_at(clause, iidx);
                            if (parent.len == 0) { break; }
                            iidx = iidx + 1;
                            sema_decl_mark_trait_impl(existing_d, parent);
                        }
                    }
                }
                if (existing_class != null && string_contains(cur_gp, "|kind:impl")) {
                    let cd = sym_get_decl(existing_class);
                    if (cd != null) {
                        let trait_name = sema_extract_impl_trait_meta(cur_gp);
                        if (trait_name.len > 0) {
                            sema_decl_mark_trait_impl(cd, trait_name);
                        }
                        self.apply_impl_members(cd, cur);
                    }
                } else if (existing_class != null
                    && sym_get_decl(existing_class) == cur) {
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && self.sema_layout_decl_is_exact(cur, class_key.clone())
                    && self.sema_layout_decl_score(cur)
                        >= self.sema_layout_decl_score(sym_get_decl(existing_class))) {
                    // A lazy facade may have registered an empty class shell
                    // under the precise external name. A force-loaded layout
                    // declaration is source-verified before reaching this
                    // branch, so replace the shell instead of diagnosing an
                    // ordinary user ODR conflict.
                    self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && decl_get_name(sym_get_decl(existing_class)) == class_key
                    && (self.sema_layout_decl_is_foreign_shell(cur)
                        || self.sema_layout_decl_is_foreign_shell(sym_get_decl(existing_class)))) {
                    // Separate interface facades may carry an empty shell for
                    // the same qualified class. Keep the richer imported
                    // declaration, while non-empty conflicts still diagnose.
                    if (self.sema_layout_decl_score(cur)
                        > self.sema_layout_decl_score(sym_get_decl(existing_class))) {
                        self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    }
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && self.extract_from_module(decl_get_meta(cur)) == self.extract_from_module(decl_get_meta(sym_get_decl(existing_class)))
                    && decl_get_name(sym_get_decl(existing_class)) == class_key) {
                    if (self.sema_layout_decl_score(cur)
                        > self.sema_layout_decl_score(sym_get_decl(existing_class))) {
                        self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    }
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && !decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && !string_contains(cur_gp, "|kind:impl")
                    && !decl_has_template_head(cur)
                    && (class_key == decl_get_name(cur)
                        || module_last_segment(class_key.clone()) == decl_get_name(cur)
                        || decl_get_name(sym_get_decl(existing_class)) == class_key
                        || module_last_segment(decl_get_name(sym_get_decl(existing_class)).clone()) == decl_get_name(cur))
                    && !decl_has_template_head(sym_get_decl(existing_class))
                    && decl_get_name(sym_get_decl(existing_class)) == class_key) {
                    self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    if (decl_get_name(cur) != class_key && sym_lookup(self.classes_buf, decl_get_name(cur)) == null) {
                        self.classes_buf = sym_push_decl(self.classes_buf, decl_get_name(cur), cur);
                    }
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && self.extract_from_module(decl_get_meta(cur)) == self.extract_from_module(decl_get_meta(sym_get_decl(existing_class)))
                    && decl_get_name(sym_get_decl(existing_class)) == class_key) {
                    if (self.sema_layout_decl_score(cur)
                        > self.sema_layout_decl_score(sym_get_decl(existing_class))) {
                        self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    }
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && !decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && !(decl_has_template_head(cur) || decl_has_template_head(sym_get_decl(existing_class)))) {
                    self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    let short_class_key = module_last_segment(class_key.clone());
                    if (short_class_key.len > 0 && short_class_key != class_key) {
                        self.classes_buf = sym_push_decl(self.classes_buf, short_class_key, cur);
                    }
                    self.check_class_members(cur);
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))
                    && self.sema_versioned_module_pair(
                        self.extract_from_module(decl_get_meta(cur)),
                        self.extract_from_module(decl_get_meta(sym_get_decl(existing_class))))) {
                    let current_module = self.extract_from_module(decl_get_meta(cur));
                    let existing_decl = sym_get_decl(existing_class);
                    let existing_module = self.extract_from_module(decl_get_meta(existing_decl));
                    if (policy_semver_compare(policy_module_version(current_module),
                                              policy_module_version(existing_module)) > 0) {
                        self.sema_merge_versioned_class_members(cur,
                                                                existing_decl,
                                                                existing_module);
                        self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    } else {
                        self.sema_merge_versioned_class_members(existing_decl,
                                                                cur,
                                                                current_module);
                    }
                } else if (existing_class != null
                    && !(decl_has_template_head(cur) || decl_has_template_head(sym_get_decl(existing_class)))) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate class " + class_key.clone());
                } else if (existing_class != null) {
                    self.check_class_members(cur);
                } else {
                    self.classes_buf = sym_push_decl(self.classes_buf, class_key.clone(), cur);
                    self.class_count = self.class_count + 1;
                    let short_class_key = module_last_segment(class_key.clone());
                    if (!decl_marked_imported(cur)
                        && short_class_key.len > 0
                        && short_class_key != class_key
                        && sym_lookup(self.classes_buf, short_class_key) == null) {
                        self.classes_buf = sym_push_decl(self.classes_buf, short_class_key, cur);
                    }
                    self.check_class_members(cur);
                }
            } else if (k == de_ENUM()) {
                let existing_class = sym_lookup(self.classes_buf, name);
                if (existing_class != null && sym_get_decl(existing_class) == cur) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_class != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate enum " + name);
                } else {
                    self.classes_buf = sym_push_decl(self.classes_buf, name, cur);
                    self.class_count = self.class_count + 1;
                }
                var vc = decl_get_members(cur);
                var tag_val: i32 = 0;
                while (vc != null && !self.too_many_errors()) {
                    if (decl_get_kind(vc) == de_VARIANT()) {
                        let vname = decl_get_name(vc);
                        self.funcs_buf = sym_push_decl(self.funcs_buf, vname, vc);
                        sym_set_ty(self.funcs_buf, tref_alloc(ty_CLASS(), name));
                        self.func_count = self.func_count + 1;
                        tag_val = tag_val + 1;
                    }
                    vc = decl_get_next(vc);
                }
            } else if (k == de_TYPE_ALIAS()) {
                let existing_class = sym_lookup(self.classes_buf, name);
                if (existing_class != null && sym_get_decl(existing_class) == cur) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_class != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_class))) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_class != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate type alias " + name);
                } else {
                    self.classes_buf = sym_push_decl(self.classes_buf, name, cur);
                    self.class_count = self.class_count + 1;
                }
            } else if (k == de_CONST()) {
                let existing_const = sym_lookup(self.funcs_buf, name);
                if (existing_const != null && sym_get_decl(existing_const) == cur) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_const != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_const))) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_const != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate const " + name);
                } else {
                    var cty = decl_get_ty(cur);
                    if (cty == null) { cty = tref_create_kind(ty_I32()); }
                    self.funcs_buf = sym_push_decl(self.funcs_buf, name, cur);
                    sym_set_ty(self.funcs_buf, cty);
                    self.func_count = self.func_count + 1;
                }
            } else if (k == de_GLOBAL_VAR()) {
                let existing_global = sym_lookup(self.funcs_buf, name);
                if (existing_global != null && sym_get_decl(existing_global) == cur) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_global != null
                    && decl_marked_imported(cur)
                    && decl_marked_imported(sym_get_decl(existing_global))) {
                    cur = decl_get_next(cur);
                    continue;
                } else if (existing_global != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate global variable " + name);
                } else {
                    var gty = decl_get_ty(cur);
                    if (gty == null) { gty = tref_create_kind(ty_I32()); }
                    self.funcs_buf = sym_push_decl(self.funcs_buf, name, cur);
                    sym_set_ty(self.funcs_buf, gty);
                    self.func_count = self.func_count + 1;
                }
            } else if (k == de_FN() || k == de_EXTERN_FN()) {
                if (k == de_EXTERN_FN() && ((decl_get_generic_flags(cur) & 256) != 0)) {
                    var child = decl_get_members(cur);
                    while (child != null) {
                        if (self.too_many_errors()) { break; }
                        let cname = decl_get_name(child);
                        if (decl_get_kind(child) == de_TYPE_ALIAS()) {
                            if (sym_lookup(self.classes_buf, cname) == null) {
                                self.classes_buf = sym_push_decl(self.classes_buf, cname, child);
                                self.class_count = self.class_count + 1;
                            }
                        } else if (decl_get_kind(child) == de_GLOBAL_VAR()) {
                            let existing_extern_global = sym_lookup(self.funcs_buf, cname);
                            if (existing_extern_global == null) {
                                var gty = decl_get_ty(child);
                                if (gty == null) { gty = tref_create_kind(ty_I32()); }
                                self.funcs_buf = sym_push_decl(self.funcs_buf, cname, child);
                                sym_set_ty(self.funcs_buf, gty);
                                self.func_count = self.func_count + 1;
                            }
                        } else if (decl_get_kind(child) == de_EXTERN_FN()
                            && sym_find_dup_fn_same_sig(self.funcs_buf, cname, child) != null) {
                            // Repeated extern C prototypes are legal in the
                            // host pipeline: SymbolTable::declare keeps the
                            // first binding. Std modules often
                            // repeat libc declarations across files.
                        } else if (decl_get_kind(child) == de_FN()
                            || decl_get_kind(child) == de_EXTERN_FN()) {
                            self.funcs_buf = sym_push_decl(self.funcs_buf, cname, child);
                            self.func_count = self.func_count + 1;
                        }
                        child = decl_get_next(child);
                    }
                } else if (k == de_EXTERN_FN() && ((decl_get_generic_flags(cur) & 512) != 0)) {
                    var child = decl_get_members(cur);
                    while (child != null) {
                        if (self.too_many_errors()) { break; }
                        let cname = decl_get_name(child);
                        if (decl_get_kind(child) == de_CLASS()) {
                            let existing_extern_class = sym_lookup(self.classes_buf, cname);
                            if (existing_extern_class == null) {
                                self.classes_buf = sym_push_decl(self.classes_buf, cname, child);
                                self.class_count = self.class_count + 1;
                                let short_extern_class = module_last_segment(cname.clone());
                                if (short_extern_class.len > 0
                                    && short_extern_class != cname
                                    && sym_lookup(self.classes_buf, short_extern_class) == null) {
                                    self.classes_buf = sym_push_decl(self.classes_buf, short_extern_class, child);
                                }
                            }
                            self.check_class_members(child);
                        } else if (decl_get_kind(child) == de_ENUM()) {
                            if (sym_lookup(self.classes_buf, cname) == null) {
                                self.classes_buf = sym_push_decl(self.classes_buf, cname, child);
                                self.class_count = self.class_count + 1;
                            }
                        } else if (decl_get_kind(child) == de_TYPE_ALIAS()) {
                            if (sym_lookup(self.classes_buf, cname) == null) {
                                self.classes_buf = sym_push_decl(self.classes_buf, cname, child);
                                self.class_count = self.class_count + 1;
                            }
                        } else if (decl_get_kind(child) == de_GLOBAL_VAR()) {
                            let existing_extern_global = sym_lookup(self.funcs_buf, cname);
                            if (existing_extern_global == null) {
                                var gty = decl_get_ty(child);
                                if (gty == null) { gty = tref_create_kind(ty_I32()); }
                                self.funcs_buf = sym_push_decl(self.funcs_buf, cname, child);
                                sym_set_ty(self.funcs_buf, gty);
                                self.func_count = self.func_count + 1;
                            }
                        } else if (decl_get_kind(child) == de_EXTERN_FN()
                            && sym_find_dup_fn_same_sig(self.funcs_buf, cname, child) != null) {
                            // Repeated extern C prototypes are legal in the
                            // host pipeline: SymbolTable::declare keeps the
                            // first binding. Std modules often
                            // repeat libc declarations across files.
                        } else if (decl_get_kind(child) == de_FN()
                            || decl_get_kind(child) == de_EXTERN_FN()) {
                            self.funcs_buf = sym_push_decl(self.funcs_buf, cname, child);
                            self.func_count = self.func_count + 1;
                        }
                        child = decl_get_next(child);
                    }
                } else if (sema_meta_is_full_concrete_spec(decl_get_generic_params(cur))) {
                    let spec_args = sema_generic_params_prefix(decl_get_generic_params(cur));
                    if (sym_find_full_spec_fn_same_args(self.funcs_buf, name, spec_args) != null) {
                        self.report_error_coded(diag_code_sema_redefinition(),
                                                g_sema_cur_loc,
                                                "redefinition of full template specialization '" + name + "::<" + spec_args + ">'");
                    } else {
                        self.funcs_buf = sym_push_decl(self.funcs_buf, name, cur);
                        self.func_count = self.func_count + 1;
                    }
                    // PLAN_SEMA_ROOT_FIX S4: free-fn full-spec push.
                    mono_scheduler_record_fn_request(self.mono_scheduler, cur, spec_args);
                } else if (generic_param_count(decl_get_generic_params(cur)) > 0) {
                    let arity = generic_param_count(decl_get_generic_params(cur));
                    let dup_generic = sym_find_generic_fn_same_arity(self.funcs_buf, name, arity);
                    if (dup_generic != null) {
                        if (!decl_marked_imported(cur)
                            && !decl_marked_imported(sym_get_decl(dup_generic))) {
                            self.report_error_coded(diag_code_sema_redefinition(),
                                                    g_sema_cur_loc,
                                                    "redefinition of generic function '" + name + "' with " + policy_i64_to_string(arity as i64) + " type parameter(s)");
                        } else if (!decl_marked_imported(cur)
                            && decl_marked_imported(sym_get_decl(dup_generic))) {
                            sym_set_decl(dup_generic, cur);
                        }
                    } else {
                        self.funcs_buf = sym_push_decl(self.funcs_buf, name, cur);
                        self.func_count = self.func_count + 1;
                    }
                } else {
                    let dup_fn = sym_find_dup_fn_same_sig(self.funcs_buf, name, cur);
                    if (dup_fn != null
                        && !duplicate_flat_helper_allowed(name)
                        && !decl_marked_imported(cur)
                        && !decl_marked_imported(sym_get_decl(dup_fn))) {
                        self.report_error_coded(diag_code_sema_duplicate(),
                                                g_sema_cur_loc,
                                                "duplicate function " + name);
                    } else if (dup_fn != null
                        && decl_marked_imported(cur)
                        && !decl_marked_imported(sym_get_decl(dup_fn))) {
                        sym_set_decl(dup_fn, cur);
                    } else if (dup_fn != null
                        && decl_marked_imported(cur)
                        && decl_marked_imported(sym_get_decl(dup_fn))
                        && self.sema_versioned_module_pair(
                            self.decl_source_module(cur, null),
                            self.decl_source_module(sym_get_decl(dup_fn),
                                                    null))) {
                        // Same-signature functions from distinct versions
                        // remain distinct overload candidates.  Exact
                        // selectors filter by source module; unqualified
                        // calls choose the newest compatible version.
                        self.funcs_buf = sym_push_decl(self.funcs_buf,
                                                       name,
                                                       cur);
                        self.func_count = self.func_count + 1;
                    } else if (dup_fn == null) {
                        self.funcs_buf = sym_push_decl(self.funcs_buf, name, cur);
                        self.func_count = self.func_count + 1;
                    }
                }
            }
            // DE_USE: `host_analyze_pass0_import_aliases` (matches `Sema.cpp` before prelude).
            // DE_MODULE: `host_analyze_build_decl_module_map`.
            cur = decl_get_next(cur);
        }
        var impl_cur = unit_get_decls(unit_ptr);
        while (impl_cur != null && !self.too_many_errors()) {
            if (decl_get_kind(impl_cur) == de_MODULE()) {
                self.apply_impl_marker(impl_cur);
            }
            impl_cur = decl_get_next(impl_cur);
        }
        return self.class_count + self.func_count;
    }

    /// Record an import request. The module is not materialized here;
    /// it enters the pending queue so lookup misses can load concrete
    /// symbol files later through the registry.  The same-named module
    /// facade file, when present (`std.collections` -> `collections.vyx`),
    /// is loaded immediately because it contains import/alias surface,
    /// not the whole sibling module closure.
    public fn seed_use(self, path: string) {
        self.sema_queue_import(path);
        self.sema_load_module_facade(path);
    }

    public fn seed_class_method(self, class_name: string, method_name: string, ret_kind: i32) {
        var cd: rawptr = null;
        let ent = sym_lookup(self.classes_buf, class_name);
        if (ent != null) {
            cd = sym_get_decl(ent);
            if (cd == null) { return; }
            if (self.class_decl_has_member(cd, method_name)) {
                return;
            }
        } else {
            cd = decl_alloc(de_CLASS(), class_name);
            self.classes_buf = sym_push_decl(self.classes_buf, class_name, cd);
            self.class_count = self.class_count + 1;
        }
        let md = decl_alloc(de_METHOD(), method_name);
        if (md == null) {
            return;
        }
        decl_set_is_static(md, true);
        decl_set_ty(md, tref_create_kind(ret_kind));
        decl_set_next(md, decl_get_members(cd));
        decl_set_members(cd, md);
        return;
    }

    public fn seed_trait_supers(self, trait_name: string, supers: string) {
        let ent = sym_lookup(self.classes_buf, trait_name);
        if (ent != null) {
            let d = sym_get_decl(ent);
            if (d != null && !string_contains(decl_get_generic_params(d), "|impl:")) {
                decl_set_generic_params(d, decl_get_generic_params(d) + "|impl:" + supers);
            }
            return;
        }
        let cd = decl_alloc(de_CLASS(), trait_name);
        decl_set_generic_params(cd, "|kind:interface|impl:" + supers);
        self.classes_buf = sym_push_decl(self.classes_buf, trait_name, cd);
        self.class_count = self.class_count + 1;
    }

    public fn seed_trait_method(self, trait_name: string, method_name: string) {
        var cd: rawptr = null;
        let ent = sym_lookup(self.classes_buf, trait_name);
        if (ent != null) {
            cd = sym_get_decl(ent);
        } else {
            cd = decl_alloc(de_CLASS(), trait_name);
            decl_set_generic_params(cd, "|kind:interface");
            self.classes_buf = sym_push_decl(self.classes_buf, trait_name, cd);
            self.class_count = self.class_count + 1;
        }
        if (cd == null) { return; }
        if (self.class_decl_has_member(cd, method_name)) { return; }
        let md = decl_alloc(de_METHOD(), method_name);
        decl_set_ty(md, tref_create_kind(ty_RAWPTR()));
        decl_set_next(md, decl_get_members(cd));
        decl_set_members(cd, md);
    }

    /// Push (name, return-ty) into `funcs_buf` if not already there.
    public fn seed_func(self, name: string, ret_kind: i32) {
        if (sym_lookup(self.funcs_buf, name) != null) { return; }
        self.funcs_buf = sym_push_decl(self.funcs_buf, name, null);
        sym_set_ty(self.funcs_buf, tref_create_kind(ret_kind));
        self.func_count = self.func_count + 1;
    }

    /// Verify FIELD names and METHOD signatures inside a single class are unique.
    public fn check_class_members(self, cls: rawptr) {
        var seen_fields: rawptr = null;
        var seen_methods: rawptr = null;
        let cls_name = decl_get_name(cls);
        let cls_generics = decl_get_generic_params(cls);
        var cur = decl_get_members(cls);
        while (cur != null) {
            sema_stamp_loc_from_decl(cur);
            let k = decl_get_kind(cur);
            let m_name = decl_get_name(cur);
            if (k == de_FIELD()) {
                if (sym_lookup(seen_fields, m_name) != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate member " + m_name + " in class " + cls_name);
                } else {
                    seen_fields = sym_push_decl(seen_fields, m_name, cur);
                }
            }
            if (k == de_METHOD()) {
                if (sym_find_dup_fn_same_sig(seen_methods, m_name, cur) != null) {
                    self.report_error_coded(diag_code_sema_duplicate(),
                                            g_sema_cur_loc,
                                            "duplicate member " + m_name + " in class " + cls_name);
                } else {
                    seen_methods = sym_push_decl(seen_methods, m_name, cur);
                }
            }
            if (k == de_METHOD() && generic_lists_overlap(cls_generics, decl_get_generic_params(cur))) {
                self.report_error_help(diag_code_sema_redefinition(),
                                        g_sema_cur_loc,
                                        "method generic parameter shadows class generic parameter in '" + cls_name + "'",
                                        "rename the method type parameter so it does not reuse a class generic name");
            }
            cur = decl_get_next(cur);
        }
    }

    public fn decl_is_interface_kind(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        return string_contains(decl_get_generic_params(d), "|kind:interface");
    }

    public fn decl_is_layout_class(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let gp = decl_get_generic_params(d);
        if (string_contains(gp, "|kind:interface")
            || string_contains(gp, "|kind:impl")
            || string_contains(gp, "|kind:type_alias")
            || string_contains(gp, "|kind:newtype")
            || string_contains(gp, "|kind:concept")) {
            return false;
        }
        return true;
    }

    public fn decl_is_foreign_dci(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let meta = decl_get_meta(d);
        return string_contains(meta, "|foreign_dci")
            || string_contains(meta, "|extern_abi:dci")
            || string_contains(meta, "|extern_abi:cpp")
            || string_contains(meta, "|foreign_cpp");
    }

    public fn class_decl_inherited_member(self, cd: rawptr, member_name: string, depth: i32) -> rawptr {
        if (cd == null || member_name.len == 0 || depth > 8) { return null; }
        var cur = self.classes_buf;
        while (cur != null) {
            let pd = sym_get_decl(cur);
            if (pd != null && pd != cd && self.class_decl_lists_parent(cd, decl_get_name(pd))) {
                let found = self.class_decl_member_deep(pd, member_name, depth + 1);
                if (found != null) { return found; }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn flatten_inherited_layout(self, cd: rawptr, depth: i32) {
        if (cd == null || depth > 8) { return; }
        let gp = decl_get_generic_params(cd);
        if (string_contains(gp, "|layout_flat:done")) { return; }
        if (string_contains(gp, "|kind:interface")
            || string_contains(gp, "|kind:impl")
            || string_contains(gp, "|kind:type_alias")
            || string_contains(gp, "|kind:newtype")) {
            return;
        }
        if (!string_contains(gp, "|impl:")) { return; }
        if (string_contains(gp, "|layout_flat:busy")) {
            self.report_error_help(diag_code_sema_generic(),
                                   g_sema_cur_loc,
                                   "cyclic inheritance in '" + decl_get_name(cd) + "'",
                                   "break the cycle by removing one parent, or extract a shared interface");
            return;
        }
        decl_set_generic_params(cd, gp + "|layout_flat:busy");
        let clause = sema_impl_clause_text(gp);
        var idx: i32 = 0;
        while (idx < 16) {
            let parent_name = generic_arg_at(clause, idx);
            if (parent_name.len == 0) { break; }
            idx = idx + 1;
            var pent = sym_lookup(self.classes_buf, parent_name);
            if (pent == null) {
                pent = self.sema_find_class_symbol(parent_name);
            }
            if (pent == null) { continue; }
            let pd = sym_get_decl(pent);
            if (pd == null || pd == cd) { continue; }
            if (!self.decl_is_layout_class(pd)) { continue; }
            self.flatten_inherited_layout(pd, depth + 1);
        }
        self.check_diamond_inheritance(cd);
        var gp_done = decl_get_generic_params(cd);
        decl_set_generic_params(cd, gp_done + "|layout_flat:done");
    }

    public fn layout_class_in_tree(self, root: rawptr, target: rawptr, depth: i32) -> bool {
        if (root == null || target == null || depth > 16) { return false; }
        if (root == target) { return true; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.layout_parent_decl_at(root, parent_i);
            if (parent_decl == null) { break; }
            if (self.layout_class_in_tree(parent_decl, target, depth + 1)) { return true; }
            parent_i = parent_i + 1;
        }
        return false;
    }

    public fn first_shared_layout_class(self, from: rawptr, other: rawptr, depth: i32) -> rawptr {
        if (from == null || other == null || depth > 16) { return null; }
        if (self.layout_class_in_tree(other, from, 0)) { return from; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.layout_parent_decl_at(from, parent_i);
            if (parent_decl == null) { break; }
            let shared = self.first_shared_layout_class(parent_decl, other, depth + 1);
            if (shared != null) { return shared; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    public fn check_diamond_inheritance(self, cd: rawptr) {
        if (cd == null) { return; }
        if (self.decl_is_foreign_dci(cd)) { return; }
        var i: i32 = 0;
        while (i < 16) {
            let left = self.layout_parent_decl_at(cd, i);
            if (left == null) { break; }
            var j = i + 1;
            while (j < 16) {
                let right = self.layout_parent_decl_at(cd, j);
                if (right == null) { break; }
                let shared = self.first_shared_layout_class(left, right, 0);
                if (shared != null) {
                    self.report_error_help(diag_code_sema_generic(),
                                           g_sema_cur_loc,
                                           "diamond inheritance: '" + decl_get_name(cd)
                                               + "' inherits both '" + decl_get_name(left)
                                               + "' and '" + decl_get_name(right) + "'",
                                           "they share class '" + decl_get_name(shared)
                                               + "'; flattened class layouts cannot merge two implementations of the same parent");
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    public fn layout_field_in_tree(self, cd: rawptr, field_name: string, depth: i32) -> bool {
        if (cd == null || field_name.len == 0 || depth > 16) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_FIELD() && decl_get_name(mp) == field_name) { return true; }
            mp = decl_get_next(mp);
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.layout_parent_decl_at(cd, parent_i);
            if (parent_decl == null) { break; }
            if (self.layout_field_in_tree(parent_decl, field_name, depth + 1)) { return true; }
            parent_i = parent_i + 1;
        }
        return false;
    }

    public fn report_layout_field_overlap(self, child: rawptr, from: rawptr, other: rawptr, walk: rawptr, depth: i32) {
        if (child == null || from == null || other == null || walk == null || depth > 16) { return; }
        var mp = decl_get_members(walk);
        while (mp != null) {
            if (decl_get_kind(mp) == de_FIELD()) {
                let fname = decl_get_name(mp);
                if (self.layout_field_in_tree(other, fname, 0)) {
                    self.report_error_help(diag_code_sema_generic(),
                                           g_sema_cur_loc,
                                           "duplicate inherited field '" + fname
                                               + "' in '" + decl_get_name(child) + "'",
                                           "'" + decl_get_name(from) + "' and '"
                                               + decl_get_name(other)
                                               + "' both contribute this field; rename one, or keep a single parent chain");
                }
            }
            mp = decl_get_next(mp);
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.layout_parent_decl_at(walk, parent_i);
            if (parent_decl == null) { break; }
            self.report_layout_field_overlap(child, from, other, parent_decl, depth + 1);
            parent_i = parent_i + 1;
        }
    }

    public fn check_inherited_field_clashes(self, cd: rawptr) {
        if (cd == null) { return; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_FIELD()) {
                let fname = decl_get_name(mp);
                var parent_i: i32 = 0;
                while (parent_i < 16) {
                    let parent_decl = self.layout_parent_decl_at(cd, parent_i);
                    if (parent_decl == null) { break; }
                    if (self.layout_field_in_tree(parent_decl, fname, 0)) {
                        self.report_error_help(diag_code_sema_generic(),
                                               g_sema_cur_loc,
                                               "duplicate inherited field '" + fname
                                                   + "' in '" + decl_get_name(cd) + "'",
                                               "a parent already has this field; rename the child field");
                    }
                    parent_i = parent_i + 1;
                }
            }
            mp = decl_get_next(mp);
        }
        var i: i32 = 0;
        while (i < 16) {
            let left = self.layout_parent_decl_at(cd, i);
            if (left == null) { break; }
            var j = i + 1;
            while (j < 16) {
                let right = self.layout_parent_decl_at(cd, j);
                if (right == null) { break; }
                if (self.first_shared_layout_class(left, right, 0) == null) {
                    self.report_layout_field_overlap(cd, left, right, left, 0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    public fn check_override_methods(self, cd: rawptr) {
        if (cd == null) { return; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && string_contains(decl_get_meta(mp), "|marker:override")) {
                let mname = decl_get_name(mp);
                if (self.class_decl_inherited_member(cd, mname, 0) == null) {
                    self.report_error_help(diag_code_sema_undefined(),
                                            g_sema_cur_loc,
                                            "method '" + mname
                                                + "' marked override but '"
                                                + decl_get_name(cd)
                                                + "' has no parent or trait method of that name",
                                            "remove `override`, or inherit/impl a method named '" + mname + "'");
                }
            }
            mp = decl_get_next(mp);
        }
    }

    public fn flatten_all_inherited_layouts(self) {
        var cur = self.classes_buf;
        while (cur != null) {
            let d = sym_get_decl(cur);
            self.flatten_inherited_layout(d, 0);
            self.check_inherited_field_clashes(d);
            self.check_override_methods(d);
            cur = sym_get_next(cur);
        }
    }

    public fn class_decl_has_member(self, cd: rawptr, mname: string) -> bool {
        if (cd == null || mname.len == 0) { return false; }
        let gp = decl_get_generic_params(cd);
        if (string_contains(gp, "|members:") && string_contains(gp, mname + ",")) {
            return true;
        }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_name(mp) == mname
                || (decl_get_kind(mp) == de_FIELD()
                    && self.sema_field_migrate_from_field(mp) == mname)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn add_impl_member_signature(self, cd: rawptr, mname: string) {
        if (cd == null || mname.len == 0) { return; }
        if (self.class_decl_has_member(cd, mname)) { return; }
        let md = decl_alloc(de_METHOD(), mname);
        decl_set_ty(md, tref_create_kind(ty_RAWPTR()));
        decl_set_next(md, decl_get_members(cd));
        decl_set_members(cd, md);
    }

    public fn add_impl_member_decl(self, cd: rawptr, member: rawptr) {
        if (cd == null || member == null) { return; }
        let mname = decl_get_name(member);
        if (mname.len == 0) { return; }
        if (self.class_decl_has_member(cd, mname)) { return; }
        decl_set_next(member, decl_get_members(cd));
        decl_set_members(cd, member);
    }

    public fn apply_impl_members(self, cd: rawptr, impl_decl: rawptr) {
        if (cd == null || impl_decl == null) { return; }
        let original_members = decl_get_members(impl_decl);
        var member = original_members;
        var own_count: i64 = 0;
        var collision = false;
        var tail: rawptr = null;
        while (member != null) {
            let name = decl_get_name(member);
            if (name.len > 0 && self.class_decl_has_member(cd, name)) {
                collision = true;
            }
            own_count = own_count + 1;
            tail = member;
            member = decl_get_next(member);
        }
        if (original_members != null) {
            if (collision) {
                // Preserve the previous class-member precedence when a class
                // already declares one of the impl's method names.
                decl_set_members(impl_decl, sema_clone_decl_chain(original_members));
                member = original_members;
                while (member != null) {
                    let next_member = decl_get_next(member);
                    self.add_impl_member_decl(cd, member);
                    member = next_member;
                }
            } else {
                // Attach the whole chain once: both owners keep the same raw
                // declarations for HIR body identity, and the impl's own
                // members remain a contiguous prefix.
                decl_set_next(tail, decl_get_members(cd));
                decl_set_members(cd, original_members);
            }
        }
        let gp = decl_get_generic_params(impl_decl);
        decl_set_generic_params(impl_decl,
                                gp + "|sema_impl_member_count:" + own_count.toString());
        var i: i32 = 0;
        var in_members: bool = false;
        var start: i32 = 0;
        while (i <= gp.len) {
            if (!in_members && i + 9 <= gp.len && str_view_range(gp, i, i + 9) == "|members:") {
                in_members = true;
                i = i + 9;
                start = i;
            } else if (in_members) {
                if (i == gp.len || gp.charAt(i) == 44 || gp.charAt(i) == 124) {
                    let m = str_view_range(gp, start, i);
                    if (m.len > 0) {
                        self.add_impl_member_signature(cd, m);
                    }
                    start = i + 1;
                    if (i < gp.len && gp.charAt(i) == 124) {
                        return;
                    }
                }
                i = i + 1;
            } else {
                i = i + 1;
            }
        }
    }

    public fn apply_impl_marker(self, impl_decl: rawptr) {
        if (impl_decl == null) { return; }
        let name = decl_get_name(impl_decl);
        if (!string_starts_with(name, "__impl:")) { return; }
        let target = str_view_range(name, 7, name.len as i32);
        if (target.len == 0) { return; }
        let ent = sym_lookup(self.classes_buf, target);
        if (ent == null) { return; }
        let cd = sym_get_decl(ent);
        if (cd == null) { return; }
        let trait_name = sema_extract_impl_trait_meta(decl_get_generic_params(impl_decl));
        if (trait_name.len > 0) {
            sema_decl_mark_trait_impl(cd, trait_name);
        }
        self.apply_impl_members(cd, impl_decl);
    }

    public fn trait_decl_member_kind(self, trait_decl: rawptr, mname: string) -> i32 {
        if (trait_decl == null || mname.len == 0) { return 0; }
        let mp = self.class_decl_member_deep(trait_decl, mname, 0);
        if (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()) { return 1; }
            if (decl_get_kind(mp) == de_FIELD()) {
                let mgp = decl_get_generic_params(mp);
                if (string_contains(mgp, "|kind:assoc_const")) { return 3; }
                if (string_contains(mgp, "|kind:assoc_type")) { return 2; }
                return 2;
            }
        }
        return 0;
    }

    public fn interface_extends_trait_depth(self, iface_name: string, target_trait: string, depth: i32) -> bool {
        if (sema_name_matches_qualified_or_short(iface_name, target_trait)) { return true; }
        if (depth > 6) { return false; }
        var ent = sym_lookup(self.classes_buf, iface_name);
        if (ent == null && self.sema_lazy_load_pending_until_symbol(iface_name)) {
            ent = sym_lookup(self.classes_buf, iface_name);
        }
        if (ent == null) { return false; }
        let id = sym_get_decl(ent);
        if (id == null) { return false; }
        let gp = decl_get_generic_params(id);
        if (!string_contains(gp, "|kind:interface")) { return false; }
        let target_short = module_last_segment(target_trait);
        if (string_contains(gp, target_trait + ",")
            || (target_short.len > 0 && string_contains(gp, target_short + ","))) {
            return true;
        }
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let tn = decl_get_name(td);
                let tn_short = module_last_segment(tn);
                let listed = string_contains(gp, tn + ",")
                              || (tn_short.len > 0 && string_contains(gp, tn_short + ","));
                if (!sema_name_matches_qualified_or_short(tn, iface_name) && listed) {
                    if (self.interface_extends_trait_depth(tn, target_trait, depth + 1)) {
                        return true;
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn generic_bound_includes_trait(self, gp: string, gname: string, trait_name: string) -> bool {
        let trait_short = module_last_segment(trait_name);
        if (where_generic_requires_trait(gp, gname, trait_name)
            || (trait_short.len > 0 && where_generic_requires_trait(gp, gname, trait_short))) {
            return true;
        }
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let direct = decl_get_name(td);
                let direct_short = module_last_segment(direct);
                if (where_generic_requires_trait(gp, gname, direct)
                    || (direct_short.len > 0 && where_generic_requires_trait(gp, gname, direct_short))) {
                    if (self.interface_extends_trait_depth(direct, trait_name, 0)) {
                        return true;
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn bound_trait_member_kind(self, gname: string, mname: string) -> i32 {
        if (gname.len == 0 || mname.len == 0) { return 0; }
        let gp = self.cur_generic_params;
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let tname = decl_get_name(td);
                let mk = self.trait_decl_member_kind(td, mname);
                if (mk != 0 && self.generic_bound_includes_trait(gp, gname, tname)) {
                    return mk;
                }
            }
            cur = sym_get_next(cur);
        }
        return 0;
    }

    public fn bound_trait_member_type(self, gname: string, mname: string) -> rawptr {
        if (gname.len == 0 || mname.len == 0) { return null; }
        let gp = self.cur_generic_params;
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let tname = decl_get_name(td);
                if (self.generic_bound_includes_trait(gp, gname, tname)) {
                    let mp = self.class_decl_member_deep(td, mname, 0);
                    if (mp != null) {
                        let mt = decl_get_ty(mp);
                        if (mt != null) {
                            return sema_substitute_type_with_args(mt,
                                                                  "Self",
                                                                  gname);
                        }
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn bound_trait_member_decl(self, gname: string, mname: string) -> rawptr {
        if (gname.len == 0 || mname.len == 0) { return null; }
        let gp = self.cur_generic_params;
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let tname = decl_get_name(td);
                if (self.generic_bound_includes_trait(gp, gname, tname)) {
                    let mp = self.class_decl_member_deep(td, mname, 0);
                    if (mp != null) { return mp; }
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn bound_trait_member_owner_decl(self, gname: string, mname: string) -> rawptr {
        if (gname.len == 0 || mname.len == 0) { return null; }
        let gp = self.cur_generic_params;
        var cur = self.classes_buf;
        while (cur != null) {
            let td = sym_get_decl(cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let tname = decl_get_name(td);
                if (self.generic_bound_includes_trait(gp, gname, tname)) {
                    let owner = self.class_decl_member_owner_deep(td, mname, 0);
                    if (owner != null) { return owner; }
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn primitive_operator_trait_for_method(self, method_name: string) -> string {
        let legacy_method_name = policy_operator_legacy_method_name(method_name);
        if (legacy_method_name.len > 0) {
            return self.primitive_operator_trait_for_method(legacy_method_name);
        }
        if (method_name == "operator_add") { return "Add"; }
        if (method_name == "operator_sub") { return "Sub"; }
        if (method_name == "operator_mul") { return "Mul"; }
        if (method_name == "operator_div") { return "Div"; }
        if (method_name == "operator_mod") { return "Mod"; }
        if (method_name == "operator_add_assign") { return "AddAssign"; }
        if (method_name == "operator_sub_assign") { return "SubAssign"; }
        if (method_name == "operator_mul_assign") { return "MulAssign"; }
        if (method_name == "operator_div_assign") { return "DivAssign"; }
        if (method_name == "operator_mod_assign") { return "ModAssign"; }
        if (method_name == "operator_band") { return "BitAnd"; }
        if (method_name == "operator_bor") { return "BitOr"; }
        if (method_name == "operator_bxor") { return "BitXor"; }
        if (method_name == "operator_shl") { return "Shl"; }
        if (method_name == "operator_shr") { return "Shr"; }
        if (method_name == "operator_band_assign") { return "BitAndAssign"; }
        if (method_name == "operator_bor_assign") { return "BitOrAssign"; }
        if (method_name == "operator_bxor_assign") { return "BitXorAssign"; }
        if (method_name == "operator_shl_assign") { return "ShlAssign"; }
        if (method_name == "operator_shr_assign") { return "ShrAssign"; }
        if (method_name == "operator_neg") { return "Neg"; }
        if (method_name == "operator_not") { return "Not"; }
        if (method_name == "operator_eq") { return "Eq"; }
        return "";
    }

    public fn load_primitive_impl_method_symbols(self, method_name: string) -> bool {
        var trait_name = self.primitive_operator_trait_for_method(method_name);
        if (method_name == "iter" || method_name == "bytes" || method_name == "chars") {
            trait_name = "StrIteratorExt";
        }
        if (trait_name.len == 0) { return false; }
        return self.sema_lazy_load_pending_until_symbol(trait_name);
    }

    public fn primitive_impl_method_type(self,
                                         recv_ty: rawptr,
                                         method_name: string,
                                         method_args: string) -> rawptr {
        if (recv_ty == null || method_name.len == 0) { return null; }
        let prim_name = type_text_from_ty(recv_ty);
        if (!type_name_is_primitive_text(prim_name)) { return null; }
        var loaded: bool = false;
        while (true) {
            var ent = sym_lookup(self.classes_buf, prim_name);
            if (ent == null) {
                let alias_name = primitive_impl_lookup_name(prim_name);
                if (alias_name != prim_name) {
                    ent = sym_lookup(self.classes_buf, alias_name);
                }
            }
            if (ent != null) {
                let cd = sym_get_decl(ent);
                if (cd != null) {
                    var mp = decl_get_members(cd);
                    while (mp != null) {
                        if (decl_get_kind(mp) == de_METHOD()
                            && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                            var mt = decl_get_ty(mp);
                            if (mt != null && method_args.len > 0) {
                                mt = sema_substitute_type_with_args(mt,
                                                                    decl_get_generic_params(mp),
                                                                    method_args);
                            }
                            return mt;
                        }
                        mp = decl_get_next(mp);
                    }
                }
            }
            if (loaded) { return null; }
            loaded = self.load_primitive_impl_method_symbols(method_name);
            if (!loaded) { return null; }
        }
        return null;
    }

    public fn type_is_struct_kind(self, type_name: string) -> bool {
        if (type_name.len == 0 || type_name_is_primitive_text(type_name)) { return false; }
        var ent = sym_lookup(self.classes_buf, type_name);
        if (ent == null && self.sema_lazy_load_pending_until_symbol(type_name)) {
            ent = sym_lookup(self.classes_buf, type_name);
        }
        if (ent == null) { return false; }
        let d = sym_get_decl(ent);
        if (d == null) { return false; }
        return string_contains(decl_get_generic_params(d), "|kind:struct");
    }

    public fn type_satisfies_trait(self, type_name: string, trait_name: string) -> bool {
        return self.type_satisfies_trait_depth(type_name, trait_name, 0);
    }

    public fn generic_params_impl_mentions(self, gp: string, trait_name: string) -> bool {
        if (gp.len == 0 || trait_name.len == 0) { return false; }
        let trait_short = module_last_segment(trait_name);
        if (string_contains(gp, "|impl:" + trait_name + ",")) { return true; }
        if (trait_short.len > 0 && string_contains(gp, "|impl:" + trait_short + ",")) {
            return true;
        }
        let clause = sema_impl_clause_text(gp);
        var idx: i32 = 0;
        while (idx < 16) {
            let parent = generic_arg_at(clause, idx);
            if (parent.len == 0) { break; }
            idx = idx + 1;
            if (sema_name_matches_qualified_or_short(parent, trait_name)) { return true; }
        }
        return false;
    }

    /// Prefer the real class over `impl Trait for Type` blocks that share
    /// the target type name in the symbol table.
    public fn type_subject_class_decl(self, type_name: string) -> rawptr {
        if (type_name.len == 0) { return null; }
        var local: rawptr = null;
        var imported: rawptr = null;
        var local_score: i32 = -1;
        var imported_score: i32 = -1;
        var cur = self.classes_buf;
        while (cur != null) {
            let d = sym_get_decl(cur);
            if (d != null) {
                let gp = decl_get_generic_params(d);
                if (!string_contains(gp, "|kind:impl")
                    && !string_contains(gp, "|kind:interface")) {
                    let matched = sema_name_matches_qualified_or_short(sym_get_name(cur), type_name)
                        || sema_name_matches_qualified_or_short(decl_get_name(d), type_name);
                    if (matched) {
                        var score: i32 = 0;
                        if (string_contains(gp, "|impl:")) { score = score + 100; }
                        var mp = decl_get_members(d);
                        while (mp != null) {
                            score = score + 1;
                            mp = decl_get_next(mp);
                        }
                        if (!decl_marked_imported(d)) {
                            if (score > local_score) {
                                local = d;
                                local_score = score;
                            }
                        } else if (score > imported_score) {
                            imported = d;
                            imported_score = score;
                        }
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        if (local != null && imported != null) {
            if (imported_score > local_score) { return imported; }
            return local;
        }
        if (local != null) { return local; }
        if (imported != null) { return imported; }
        var ent = sym_lookup(self.classes_buf, type_name);
        if (ent == null) {
            ent = self.sema_find_class_symbol(type_name);
        }
        if (ent == null) {
            ent = self.sema_find_latest_class_symbol(type_name);
        }
        if (ent == null) { return null; }
        return sym_get_decl(ent);
    }

    /// `impl Trait for Type` is a `de_CLASS` named after the target. FactBase
    /// may miss it when an interface supertrait list also carries `|impl:`.
    public fn type_unit_impl_satisfies(self, type_name: string, trait_name: string) -> bool {
        if (type_name.len == 0 || trait_name.len == 0) { return false; }
        let want = sema_derive_trait_key(trait_name);
        if (want.len == 0) { return false; }
        if (self.current_unit != null) {
            var d = unit_get_decls(self.current_unit);
            while (d != null) {
                if (decl_get_kind(d) == de_CLASS()
                    && sema_name_matches_qualified_or_short(decl_get_name(d), type_name)) {
                    let gp = decl_get_generic_params(d);
                    if (string_contains(gp, "|kind:impl")) {
                        let tr = sema_extract_impl_trait_meta(gp);
                        if (sema_derive_trait_key(tr) == want
                            || sema_name_matches_qualified_or_short(tr, trait_name)) { return true; }
                    }
                    if (!string_contains(gp, "|kind:impl")
                        && !string_contains(gp, "|kind:interface")
                        && self.generic_params_impl_mentions(gp, trait_name)) {
                        return true;
                    }
                }
                d = decl_get_next(d);
            }
        }
        var cur = self.classes_buf;
        while (cur != null) {
            let cd = sym_get_decl(cur);
            if (cd != null
                && (sema_name_matches_qualified_or_short(sym_get_name(cur), type_name)
                    || sema_name_matches_qualified_or_short(decl_get_name(cd), type_name))
                && self.generic_params_impl_mentions(decl_get_generic_params(cd), trait_name)) {
                return true;
            }
            cur = sym_get_next(cur);
        }
        return false;
    }

    public fn sema_find_interface_decl(self, trait_name: string) -> rawptr {
        if (trait_name.len == 0) { return null; }
        var found: rawptr = null;
        var found_score: i32 = -1;
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null && string_contains(decl_get_generic_params(d), "|kind:interface")) {
                if (sema_name_matches_qualified_or_short(sym_get_name(scan), trait_name)
                    || sema_name_matches_qualified_or_short(decl_get_name(d), trait_name)) {
                    var score: i32 = 0;
                    var mp = decl_get_members(d);
                    while (mp != null) {
                        score = score + 1;
                        mp = decl_get_next(mp);
                    }
                    if (score > found_score) {
                        found = d;
                        found_score = score;
                    }
                }
            }
            scan = sym_get_next(scan);
        }
        return found;
    }

    public fn class_decl_covers_interface(self, cd: rawptr, iface: rawptr) -> bool {
        if (cd == null || iface == null) { return false; }
        var has_req: bool = false;
        var mp = decl_get_members(iface);
        while (mp != null) {
            let mk = decl_get_kind(mp);
            if (mk == de_METHOD() || mk == de_FIELD()) {
                if (mk == de_METHOD() && decl_get_body(mp) != null) {
                } else {
                    has_req = true;
                    if (!self.class_decl_has_member(cd, decl_get_name(mp))) {
                        return false;
                    }
                }
            }
            mp = decl_get_next(mp);
        }
        return has_req;
    }

    public fn type_dyn_actual_satisfies(self, actual_name: string, actual_base: string, dyn_trait: string) -> bool {
        if (dyn_trait.len == 0) { return false; }
        if (actual_name.len > 0 && self.type_satisfies_trait(actual_name, dyn_trait)) {
            return true;
        }
        if (actual_base.len > 0 && actual_base != actual_name
            && self.type_satisfies_trait(actual_base, dyn_trait)) {
            return true;
        }
        if (actual_name.len > 0 && self.type_unit_impl_satisfies(actual_name, dyn_trait)) {
            return true;
        }
        if (actual_base.len > 0 && actual_base != actual_name
            && self.type_unit_impl_satisfies(actual_base, dyn_trait)) {
            return true;
        }
        if (actual_name.len > 0 && self.type_dyn_structurally_satisfies(actual_name, dyn_trait)) {
            return true;
        }
        if (actual_base.len > 0 && actual_base != actual_name
            && self.type_dyn_structurally_satisfies(actual_base, dyn_trait)) {
            return true;
        }
        var subj = self.type_subject_class_decl(actual_name);
        if (subj == null && actual_base.len > 0) {
            subj = self.type_subject_class_decl(actual_base);
        }
        if (subj != null && self.generic_params_impl_mentions(decl_get_generic_params(subj), dyn_trait)) {
            return true;
        }
        return false;
    }

    public fn type_dyn_structurally_satisfies(self, type_name: string, trait_name: string) -> bool {
        if (type_name.len == 0 || trait_name.len == 0) { return false; }
        let iface = self.sema_find_interface_decl(trait_name);
        if (iface == null) { return false; }
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null
                && !string_contains(decl_get_generic_params(d), "|kind:interface")
                && !string_contains(decl_get_generic_params(d), "|kind:impl")
                && (sema_name_matches_qualified_or_short(sym_get_name(scan), type_name)
                    || sema_name_matches_qualified_or_short(decl_get_name(d), type_name))) {
                if (self.generic_params_impl_mentions(decl_get_generic_params(d), trait_name)) {
                    return true;
                }
                if (self.class_decl_covers_interface(d, iface)) {
                    return true;
                }
            }
            scan = sym_get_next(scan);
        }
        return false;
    }

    public fn sema_dump_dyn_candidates(self, actual_name: string, dyn_trait: string) {
        var unit_impl = "0";
        if (self.type_unit_impl_satisfies(actual_name, dyn_trait)) { unit_impl = "1"; }
        print("[dyn] actual=" + actual_name + " trait=" + dyn_trait + " unit_impl=" + unit_impl);
        var scan = self.classes_buf;
        while (scan != null) {
            let d = sym_get_decl(scan);
            if (d != null) {
                let dn = decl_get_name(d);
                let sn = sym_get_name(scan);
                let dn_short = module_last_segment(dn);
                let sn_short = module_last_segment(sn);
                if (sema_name_matches_qualified_or_short(dn, actual_name)
                    || sema_name_matches_qualified_or_short(sn, actual_name)
                    || dn_short == dyn_trait
                    || sn_short == dyn_trait) {
                    var n: i32 = 0;
                    var mp = decl_get_members(d);
                    while (mp != null) {
                        n = n + 1;
                        mp = decl_get_next(mp);
                    }
                    var imp = "loc";
                    if (decl_marked_imported(d)) { imp = "imp"; }
                    print("[dyn] " + imp
                        + " sym=" + sn
                        + " decl=" + dn
                        + " members=" + policy_i64_to_string(n as i64)
                        + " gp=" + decl_get_generic_params(d));
                }
            }
            scan = sym_get_next(scan);
        }
    }

    /// `interface Child : Parent` stores parents in `|impl:Parent,`.
    public fn type_satisfies_trait_supers(self,
                                           type_name: string,
                                           trait_name: string,
                                           depth: i32) -> bool {
        var trait_decl = self.sema_find_interface_decl(trait_name);
        if (trait_decl == null) { return true; }
        let gp = decl_get_generic_params(trait_decl);
        if (!string_contains(gp, "|kind:interface")) { return true; }
        let clause = sema_impl_clause_text(gp);
        var idx: i32 = 0;
        while (idx < 16) {
            let parent = generic_arg_at(clause, idx);
            if (parent.len == 0) { break; }
            idx = idx + 1;
            if (!self.type_satisfies_trait_depth(type_name, parent, depth + 1)) {
                return false;
            }
        }
        return true;
    }

    public fn sema_blanket_where_holds(self,
                                       type_name: string,
                                       generics: string,
                                       where_text: string,
                                       depth: i32) -> bool {
        if (where_text.len == 0) { return true; }
        if (depth > 8) { return false; }
        var i: i32 = 0;
        while (i < where_text.len) {
            while (i < where_text.len
                && (where_text.charAt(i) == 44 || where_text.charAt(i) == 32)) {
                i = i + 1;
            }
            if (i >= where_text.len) { break; }
            var name_start = i;
            while (i < where_text.len) {
                let c = where_text.charAt(i);
                if (c == 58 || c == 44 || c == 43 || c == 32) { break; }
                i = i + 1;
            }
            let param = str_substring(where_text, name_start as i64, i as i64);
            while (i < where_text.len && where_text.charAt(i) == 32) { i = i + 1; }
            if (i >= where_text.len || where_text.charAt(i) != 58) { continue; }
            i = i + 1;
            var subject = param;
            if (sema_csv_has_name(generics, param) || param == type_name) {
                subject = type_name;
            }
            while (i < where_text.len && where_text.charAt(i) != 44) {
                while (i < where_text.len
                    && (where_text.charAt(i) == 43 || where_text.charAt(i) == 32)) {
                    i = i + 1;
                }
                if (i >= where_text.len || where_text.charAt(i) == 44) { break; }
                var tstart = i;
                while (i < where_text.len) {
                    let tc = where_text.charAt(i);
                    if (tc == 43 || tc == 44 || tc == 32) { break; }
                    i = i + 1;
                }
                let bound = str_substring(where_text, tstart as i64, i as i64);
                if (bound.len > 0
                    && !self.type_satisfies_trait_depth(subject, bound, depth + 1)) {
                    return false;
                }
            }
        }
        return true;
    }

    public fn type_satisfies_trait_depth(self, type_name: string, trait_name: string, depth: i32) -> bool {
        if (type_name.len == 0 || trait_name.len == 0) { return true; }
        if (depth > 8) { return false; }
        if (sema_name_matches_qualified_or_short(type_name, trait_name)) { return true; }
        let trait_short0 = module_last_segment(trait_name);
        if ((trait_short0 == "Copy" || trait_name == "Copy"
             || trait_short0 == "Clone" || trait_name == "Clone")
            && type_name_is_primitive_text(type_name)
            && type_name != "str" && type_name != "string" && type_name != "void") {
            return true;
        }
        self.sema_lazy_load_pending_until_symbol(trait_name);
        var solved = trait_solver_solve_type(self.fact_base, type_name, trait_name);
        if (solved != trait_solver_result_SAT()
            && self.type_unit_impl_satisfies(type_name, trait_name)) {
            solved = trait_solver_result_SAT();
        }
        if (solved == trait_solver_result_SAT()) {
            if (self.type_satisfies_trait_supers(type_name, trait_name, depth)) {
                return true;
            }
        }
        if (solved == trait_solver_result_NEEDS_BLANKET()) {
            let generics = trait_solver_blanket_generics(self.fact_base, type_name, trait_name);
            let where_text = trait_solver_blanket_where(self.fact_base, type_name, trait_name);
            if (self.sema_blanket_where_holds(type_name, generics, where_text, depth + 1)) {
                return self.type_satisfies_trait_supers(type_name, trait_name, depth);
            }
        }
        if (type_name_is_primitive_text(type_name)) {
            return false;
        }
        var cd = self.type_subject_class_decl(type_name);
        if (cd == null && self.sema_lazy_load_pending_until_symbol(type_name)) {
            cd = self.type_subject_class_decl(type_name);
        }
        if (cd == null) {
            let trait_ent_0 = sym_lookup(self.classes_buf, trait_name);
            if (trait_ent_0 == null) {
                self.sema_lazy_load_pending_until_symbol(trait_name);
            }
            return generic_list_contains(self.cur_generic_params, type_name);
        }
        let gp = decl_get_generic_params(cd);
        if (self.generic_params_impl_mentions(gp, trait_name)) {
            return self.type_satisfies_trait_supers(type_name, trait_name, depth);
        }
        let clause = sema_impl_clause_text(gp);
        var bidx: i32 = 0;
        while (bidx < 16) {
            let base = generic_arg_at(clause, bidx);
            if (base.len == 0) { break; }
            bidx = bidx + 1;
            if (sema_name_matches_qualified_or_short(base, type_name)) { continue; }
            if (self.type_satisfies_trait_depth(base, trait_name, depth + 1)) {
                return self.type_satisfies_trait_supers(type_name, trait_name, depth);
            }
        }
        var iface_cur = self.classes_buf;
        while (iface_cur != null) {
            let id = sym_get_decl(iface_cur);
            if (id != null && string_contains(decl_get_generic_params(id), "|kind:interface")) {
                let iname = decl_get_name(id);
                let iname_short = module_last_segment(iname);
                if ((string_contains(gp, "|impl:" + iname + ",")
                     || (iname_short.len > 0 && string_contains(gp, "|impl:" + iname_short + ",")))
                    && self.interface_extends_trait_depth(iname, trait_name, 0)) {
                    return self.type_satisfies_trait_supers(type_name, trait_name, depth);
                }
            }
            iface_cur = sym_get_next(iface_cur);
        }
        var trait_decl = self.sema_find_interface_decl(trait_name);
        if (trait_decl == null) {
            var trait_ent = sym_lookup(self.classes_buf, trait_name);
            if (trait_ent == null && self.sema_lazy_load_pending_until_symbol(trait_name)) {
                trait_ent = sym_lookup(self.classes_buf, trait_name);
            }
            if (trait_ent == null) { return false; }
            trait_decl = sym_get_decl(trait_ent);
        }
        if (trait_decl == null) { return false; }
        if (!string_contains(decl_get_generic_params(trait_decl), "|kind:interface")) { return false; }
        var mp = decl_get_members(trait_decl);
        while (mp != null) {
            let mk = decl_get_kind(mp);
            if (mk == de_METHOD() || mk == de_FIELD()) {
                if (mk == de_METHOD() && decl_get_body(mp) != null) {
                } else if (!self.class_decl_has_member(cd, decl_get_name(mp))) {
                    return false;
                }
            }
            mp = decl_get_next(mp);
        }
        return self.type_satisfies_trait_supers(type_name, trait_name, depth);
    }

    public fn where_arith_atom_value(self, gp: string, cargs: string, args_head: rawptr, text: string) -> i64 {
        let atom = sema_vis_trim(text);
        if (atom.len == 0) { return 0; }
        if (atom.endsWith(".len")) {
            return self.stmt_list_count(args_head) as i64;
        }
        if (sema_string_is_i64_lit(atom)) {
            return sema_parse_i64_lit(atom);
        }
        let concrete = sema_const_generic_arg_for_param(gp, cargs, atom);
        if (concrete.len > 0 && sema_string_is_i64_lit(concrete)) {
            return sema_parse_i64_lit(concrete);
        }
        return 0;
    }

    public fn where_arith_mul_value(self, gp: string, cargs: string, args_head: rawptr, text: string) -> i64 {
        var i: i32 = (text.len - 1) as i32;
        while (i >= 0) {
            let c = text.charAt(i);
            if (c == 42 || c == 37) {
                let lhs = self.where_arith_mul_value(gp, cargs, args_head, str_view_range(text, 0, i));
                let rhs = self.where_arith_atom_value(gp, cargs, args_head, str_view_range(text, i + 1, text.len));
                if (c == 42) { return lhs * rhs; }
                if (rhs == 0) { return 0; }
                return lhs % rhs;
            }
            i = i - 1;
        }
        return self.where_arith_atom_value(gp, cargs, args_head, text);
    }

    public fn where_arith_value(self, gp: string, cargs: string, args_head: rawptr, text: string) -> i64 {
        var i: i32 = (text.len - 1) as i32;
        while (i > 0) {
            let c = text.charAt(i);
            if (c == 43 || c == 45) {
                let lhs = self.where_arith_value(gp, cargs, args_head, str_view_range(text, 0, i));
                let rhs = self.where_arith_mul_value(gp, cargs, args_head, str_view_range(text, i + 1, text.len));
                if (c == 43) { return lhs + rhs; }
                return lhs - rhs;
            }
            i = i - 1;
        }
        return self.where_arith_mul_value(gp, cargs, args_head, text);
    }

    public fn where_compare_at(self, text: string, pos: i32) -> string {
        if (pos < 0 || pos >= text.len) { return ""; }
        let c = text.charAt(pos);
        if (c == 61 && pos + 1 < text.len && text.charAt(pos + 1) == 61) { return "=="; }
        if (c == 33 && pos + 1 < text.len && text.charAt(pos + 1) == 61) { return "!="; }
        if (c == 62) {
            if (pos + 1 < text.len && text.charAt(pos + 1) == 61) { return ">="; }
            return ">";
        }
        if (c == 60) {
            if (pos + 1 < text.len && text.charAt(pos + 1) == 61) { return "<="; }
            return "<";
        }
        return "";
    }

    public fn where_comparison_count(self, text: string) -> i32 {
        var count: i32 = 0;
        var i: i32 = 0;
        while (i < text.len) {
            let op = self.where_compare_at(text, i);
            if (op.len > 0) {
                count = count + 1;
                i = i + (op.len as i32);
            } else {
                i = i + 1;
            }
        }
        return count;
    }

    public fn check_const_where_constraints(self, d: rawptr, cargs: string, args_head: rawptr, ctx: string) {
        if (d == null) { return; }
        let gp = decl_get_generic_params(d);
        let where_text = sema_where_text(gp);
        if (where_text.len == 0) { return; }
        if (string_contains(where_text, "\"") || string_contains(where_text, "::kind")) { return; }
        if (self.where_comparison_count(where_text) != 1) { return; }
        var pos: i32 = 0;
        var op = "";
        while (pos < where_text.len && op.len == 0) {
            op = self.where_compare_at(where_text, pos);
            if (op.len == 0) { pos = pos + 1; }
        }
        if (op.len == 0) { return; }
        let lhs = self.where_arith_value(gp, cargs, args_head, str_view_range(where_text, 0, pos));
        let rhs = self.where_arith_value(gp, cargs, args_head, str_view_range(where_text, pos + op.len, where_text.len));
        var ok: bool = false;
        if (op == ">") { ok = lhs > rhs; }
        else if (op == ">=") { ok = lhs >= rhs; }
        else if (op == "<") { ok = lhs < rhs; }
        else if (op == "<=") { ok = lhs <= rhs; }
        else if (op == "==") { ok = lhs == rhs; }
        else if (op == "!=") { ok = lhs != rhs; }
        if (!ok) {
            self.report_error_help(diag_code_sema_trait_bound(),
                                   g_sema_cur_loc,
                                   "const predicate not satisfied in " + ctx + ": " + where_text,
                                   "change the const generic arguments so the where-clause comparison is true");
        }
    }

    public fn check_where_constraints(self, d: rawptr, cargs: string, args_head: rawptr, ctx: string) {
        if (d == null) { return; }
        let gp = decl_get_generic_params(d);
        if (!string_contains(gp, "|where:")) { return; }
        self.check_const_where_constraints(d, cargs, args_head, ctx);
        var iface_cur = self.classes_buf;
        while (iface_cur != null) {
            let td = sym_get_decl(iface_cur);
            if (td != null && string_contains(decl_get_generic_params(td), "|kind:interface")) {
                let trait_name = decl_get_name(td);
                if (string_contains(gp, "all<") && string_contains(gp, ":" + trait_name)) {
                    var ac = args_head;
                    while (ac != null) {
                        let av = stmt_get_init(ac);
                        let tn = type_text_from_ty(expr_get_ty(av));
                        if (!self.type_satisfies_trait(tn.clone(), trait_name.clone())) {
                                self.report_error_coded(diag_code_sema_trait_bound(),
                                                    g_sema_cur_loc,
                                                    "trait bound not satisfied in " + ctx + ": " + tn + " : " + trait_name);
                        }
                        ac = stmt_get_next(ac);
                    }
                }
                var pi: i32 = 0;
                var gname = generic_param_at(gp, pi);
                while (gname.len > 0) {
                    if (where_generic_requires_trait(gp, gname.clone(), trait_name.clone())) {
                        let concrete = generic_arg_at(cargs, pi);
                        if (concrete.len > 0 && !generic_list_contains(self.cur_generic_params, concrete.clone())) {
                            if (!self.type_satisfies_trait(concrete.clone(), trait_name.clone())) {
                                self.report_error_coded(diag_code_sema_trait_bound(),
                                                        g_sema_cur_loc,
                                                        "trait bound not satisfied in " + ctx + ": " + concrete + " : " + trait_name);
                            }
                        }
                    }
                    pi = pi + 1;
                    gname = generic_param_at(gp, pi);
                }
            }
            iface_cur = sym_get_next(iface_cur);
        }
        var ki: i32 = 0;
        var kg = generic_param_at(gp, ki);
        while (kg.len > 0) {
            let concrete = generic_arg_at(cargs, ki);
            if (concrete.len > 0 && !generic_list_contains(self.cur_generic_params, concrete.clone())) {
                if (where_generic_requires_kind_struct(gp, kg.clone()) && !self.type_is_struct_kind(concrete.clone())) {
                    self.report_error_coded(diag_code_sema_trait_bound(),
                                            g_sema_cur_loc,
                                            "kind constraint not satisfied in " + ctx + ": " + concrete + " is not struct");
                }
                if (where_generic_requires_kind_not_struct(gp, kg.clone()) && self.type_is_struct_kind(concrete.clone())) {
                    self.report_error_coded(diag_code_sema_trait_bound(),
                                            g_sema_cur_loc,
                                            "kind constraint not satisfied in " + ctx + ": " + concrete + " is struct");
                }
            }
            ki = ki + 1;
            kg = generic_param_at(gp, ki);
        }
    }

    public fn decl_variadic_param_name(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        var pp = decl_get_params(d);
        while (pp != null) {
            if (decl_get_name(pp) == "args" || string_contains(decl_get_generic_params(pp), "|variadic")) {
                return decl_get_name(pp);
            }
            pp = decl_get_next(pp);
        }
        return "";
    }

    public fn name_resolves_in_current_scope(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (sym_lookup(self.cur_locals, name) != null) { return true; }
        if (self.sema_find_func_symbol(name) != null) { return true; }
        if (self.sema_resolve_use_alias_func_name(name.clone()).len > 0) { return true; }
        if (self.sema_resolve_use_alias_type_name(name).len > 0) { return true; }
        let expanded_name = self.sema_expand_short_name(name.clone(), false);
        if (expanded_name.len > 0 && self.sema_lookup_class_canonical(expanded_name.clone()) != null) {
            return true;
        }
        let name_generic_args = policy_generic_call_args(name.clone());
        if (self.sema_find_latest_class_symbol(name) != null) { return true; }
        if (name_generic_args.len > 0 && self.sema_find_latest_class_symbol(generic_call_base(name.clone())) != null) {
            return true;
        }
        if (is_host_builtin(name)) { return true; }
        if (self.sema_lazy_load_pending_until_symbol(name)) {
            if (self.sema_find_func_symbol(name) != null) { return true; }
            if (self.sema_find_latest_class_symbol(name) != null) { return true; }
            if (name_generic_args.len > 0 && self.sema_find_latest_class_symbol(generic_call_base(name.clone())) != null) {
                return true;
            }
        }
        return false;
    }

    public fn stmt_list_count(self, head: rawptr) -> i32 {
        var n: i32 = 0;
        var cur = head;
        while (cur != null) {
            n = n + 1;
            cur = stmt_get_next(cur);
        }
        return n;
    }

    public fn check_pack_oob_expr(self, e: rawptr, pack_name: string, pack_len: i32, ctx: string) {
        if (e == null || pack_name.len == 0 || pack_len < 0) { return; }
        let k = expr_get_kind(e);
        if (k == ex_INDEX()) {
            let lhs = expr_get_lhs(e);
            let rhs = expr_get_rhs(e);
            if (lhs != null && rhs != null
                && expr_get_kind(lhs) == ex_IDENT()
                && expr_get_name(lhs) == pack_name
                && expr_get_kind(rhs) == ex_INT_LIT()
                && expr_get_int_val(rhs) >= (pack_len as i64)) {
                self.report_error_help(diag_code_sema_generic(),
                                        g_sema_cur_loc,
                                        "pack index out of range in " + ctx,
                                        "use an index less than the number of pack arguments passed at this call");
            }
            self.check_pack_oob_expr(lhs, pack_name, pack_len, ctx);
            self.check_pack_oob_expr(rhs, pack_name, pack_len, ctx);
            return;
        }
        if (k == ex_BIN() || k == ex_ASSIGN()) {
            self.check_pack_oob_expr(expr_get_lhs(e), pack_name, pack_len, ctx);
            self.check_pack_oob_expr(expr_get_rhs(e), pack_name, pack_len, ctx);
            return;
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF() || k == ex_MEMBER()) {
            self.check_pack_oob_expr(expr_get_lhs(e), pack_name, pack_len, ctx);
            return;
        }
        if (k == ex_CALL()) {
            self.check_pack_oob_expr(expr_get_lhs(e), pack_name, pack_len, ctx);
            var ac = expr_get_args(e);
            while (ac != null) {
                self.check_pack_oob_expr(stmt_get_init(ac), pack_name, pack_len, ctx);
                ac = stmt_get_next(ac);
            }
            return;
        }
        if (k == ex_STRUCT_INIT()) {
            var cell = expr_get_args(e);
            while (cell != null) {
                self.check_pack_oob_expr(stmt_get_init(cell), pack_name, pack_len, ctx);
                cell = stmt_get_next(cell);
            }
        }
    }

    public fn expr_is_pack_length_member(self, e: rawptr, pack_name: string) -> bool {
        if (e == null || pack_name.len == 0) { return false; }
        if (expr_get_kind(e) != ex_MEMBER()) { return false; }
        let m = expr_get_name(e);
        if (!(m == "len" || m == "length" || m == "size" || m == "count")) { return false; }
        let lhs = expr_get_lhs(e);
        if (lhs == null || expr_get_kind(lhs) != ex_IDENT()) { return false; }
        return expr_get_name(lhs) == pack_name;
    }

    public fn expr_is_pack_zero_len_guard(self, e: rawptr, pack_name: string) -> bool {
        if (e == null || pack_name.len == 0) { return false; }
        if (expr_get_kind(e) != ex_BIN()) { return false; }
        let lhs = expr_get_lhs(e);
        let rhs = expr_get_rhs(e);
        let op = expr_get_op(e);
        if (self.expr_is_pack_length_member(lhs, pack_name)
            && rhs != null
            && expr_get_kind(rhs) == ex_INT_LIT()) {
            let rv = expr_get_int_val(rhs);
            if (op == tk_EQEQ() && rv == 0) { return true; }
            if (op == tk_LE() && rv == 0) { return true; }
            if (op == tk_LT() && rv == 1) { return true; }
        }
        if (self.expr_is_pack_length_member(rhs, pack_name)
            && lhs != null
            && expr_get_kind(lhs) == ex_INT_LIT()) {
            let lv = expr_get_int_val(lhs);
            if (op == tk_EQEQ() && lv == 0) { return true; }
            if (op == tk_GE() && lv == 0) { return true; }
            if (op == tk_GT() && lv == -1) { return true; }
        }
        return false;
    }

    public fn stmt_always_returns(self, sp: rawptr) -> bool {
        if (sp == null) { return false; }
        let k = stmt_get_kind(sp);
        if (k == st_RETURN()) { return true; }
        if (k == st_BLOCK()) {
            var cur = stmt_get_body(sp);
            while (cur != null) {
                if (self.stmt_always_returns(cur)) { return true; }
                cur = stmt_get_next(cur);
            }
            return false;
        }
        if (k == st_IF()) {
            return self.stmt_always_returns(stmt_get_then_blk(sp))
                && self.stmt_always_returns(stmt_get_else_blk(sp));
        }
        return false;
    }

    public fn check_pack_oob_stmt(self, sp: rawptr, pack_name: string, pack_len: i32, ctx: string) {
        var cur = sp;
        while (cur != null) {
            let k = stmt_get_kind(cur);
            if (k == st_EXPR() || k == st_LET() || k == st_VAR() || k == st_RETURN()) {
                self.check_pack_oob_expr(stmt_get_init(cur), pack_name, pack_len, ctx);
            } else if (k == st_IF()) {
                self.check_pack_oob_expr(stmt_get_cond(cur), pack_name, pack_len, ctx);
                self.check_pack_oob_stmt(stmt_get_then_blk(cur), pack_name, pack_len, ctx);
                self.check_pack_oob_stmt(stmt_get_else_blk(cur), pack_name, pack_len, ctx);
                if (pack_len == 0
                    && self.expr_is_pack_zero_len_guard(stmt_get_cond(cur), pack_name)
                    && self.stmt_always_returns(stmt_get_then_blk(cur))) {
                    return;
                }
            } else if (k == st_WHILE()) {
                self.check_pack_oob_expr(stmt_get_cond(cur), pack_name, pack_len, ctx);
                self.check_pack_oob_stmt(stmt_get_body(cur), pack_name, pack_len, ctx);
            } else if (k == st_BLOCK()) {
                self.check_pack_oob_stmt(stmt_get_body(cur), pack_name, pack_len, ctx);
            }
            cur = stmt_get_next(cur);
        }
    }

    public fn check_generic_static_const_expr(self, e: rawptr, gp: string, ctx: string) {
        if (e == null || gp.len == 0) { return; }
        let k = expr_get_kind(e);
        if (k == ex_MEMBER()) {
            let lhs = expr_get_lhs(e);
            if (lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                let lname = expr_get_name(lhs);
                let mname = expr_get_name(e);
                if (generic_list_contains(gp, lname.clone()) && string_is_all_caps_ident(mname.clone())) {
                    if (self.bound_trait_member_kind(lname.clone(), mname.clone()) != 3) {
                        self.report_error_help(diag_code_sema_undefined(),
                                                g_sema_cur_loc,
                                                "associated const on generic parameter is not resolved in " + ctx + ": " + lname + "::" + mname,
                                                "add a trait bound that defines `" + lname + "::" + mname + "`, or name a concrete type");
                    }
                }
            }
            self.check_generic_static_const_expr(lhs, gp, ctx);
            return;
        }
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
            self.check_generic_static_const_expr(expr_get_lhs(e), gp, ctx);
            self.check_generic_static_const_expr(expr_get_rhs(e), gp, ctx);
            return;
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF()) {
            self.check_generic_static_const_expr(expr_get_lhs(e), gp, ctx);
            return;
        }
        if (k == ex_CALL()) {
            self.check_generic_static_const_expr(expr_get_lhs(e), gp, ctx);
            var ac = expr_get_args(e);
            while (ac != null) {
                self.check_generic_static_const_expr(stmt_get_init(ac), gp, ctx);
                ac = stmt_get_next(ac);
            }
            return;
        }
        if (k == ex_STRUCT_INIT()) {
            var cell = expr_get_args(e);
            while (cell != null) {
                self.check_generic_static_const_expr(stmt_get_init(cell), gp, ctx);
                cell = stmt_get_next(cell);
            }
        }
    }

    public fn check_generic_static_const_stmt(self, sp: rawptr, gp: string, ctx: string) {
        var cur = sp;
        while (cur != null) {
            let k = stmt_get_kind(cur);
            if (k == st_EXPR() || k == st_LET() || k == st_VAR() || k == st_RETURN()) {
                self.check_generic_static_const_expr(stmt_get_init(cur), gp, ctx);
            } else if (k == st_IF()) {
                self.check_generic_static_const_expr(stmt_get_cond(cur), gp, ctx);
                self.check_generic_static_const_stmt(stmt_get_then_blk(cur), gp, ctx);
                self.check_generic_static_const_stmt(stmt_get_else_blk(cur), gp, ctx);
            } else if (k == st_WHILE()) {
                self.check_generic_static_const_expr(stmt_get_cond(cur), gp, ctx);
                self.check_generic_static_const_stmt(stmt_get_body(cur), gp, ctx);
            } else if (k == st_BLOCK()) {
                self.check_generic_static_const_stmt(stmt_get_body(cur), gp, ctx);
            }
            cur = stmt_get_next(cur);
        }
    }

    public fn sema_lazy_load_expr_body_symbols(self, e: rawptr) {
        if (e == null || self.too_many_errors()) { return; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) {
            let name = expr_get_name(e);
            let generic_args = policy_generic_call_args(name.clone());
            if (name.len > 0 && generic_args.len > 0) {
                let base = generic_call_base(name.clone());
                if (sema_builtin_requires_type_layout(base)) {
                    self.sema_canonical_builtin_type_args(generic_args);
                }
                self.sema_lazy_load_pending_until_symbol(name);
            }
            return;
        }
        if (k == ex_MEMBER()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            return;
        }
        if (k == ex_CALL()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            var ac = expr_get_args(e);
            while (ac != null) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(ac));
                ac = stmt_get_next(ac);
            }
            return;
        }
        if (k == ex_CLOSURE()) {
            self.sema_lazy_load_type_ref_symbols(expr_get_rhs(e));
            var param = expr_get_args(e);
            while (param != null) {
                self.sema_lazy_load_type_ref_symbols(decl_get_ty(param));
                param = decl_get_next(param);
            }
            var capture = expr_get_captures(e);
            while (capture != null) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(capture));
                capture = stmt_get_next(capture);
            }
            self.sema_lazy_load_stmt_body_symbols(expr_get_lhs(e));
            return;
        }
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            self.sema_lazy_load_expr_body_symbols(expr_get_rhs(e));
            return;
        }
        if (k == ex_TERNARY()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            self.sema_lazy_load_expr_body_symbols(expr_get_rhs(e));
            self.sema_lazy_load_expr_body_symbols(expr_get_args(e));
            return;
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF() || k == ex_DEREF() || k == ex_COMPTIME() || k == ex_AWAIT() || k == ex_FAIL()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            return;
        }
        if (k == ex_CAST()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            self.sema_lazy_load_type_ref_symbols(expr_get_ty(e));
            return;
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            self.sema_lazy_load_expr_body_symbols(expr_get_lhs(e));
            if (k == ex_IF_EXPR()) {
                self.sema_lazy_load_stmt_body_symbols(expr_get_rhs(e));
                let else_part = expr_get_args(e);
                if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                    self.sema_lazy_load_expr_body_symbols(else_part);
                } else {
                    self.sema_lazy_load_stmt_body_symbols(else_part);
                }
            } else {
                var match_arm = expr_get_args(e);
                while (match_arm != null) {
                    self.sema_lazy_load_expr_body_symbols(stmt_get_init(match_arm));
                    self.sema_lazy_load_expr_body_symbols(stmt_get_cond(match_arm));
                    self.sema_lazy_load_stmt_body_symbols(stmt_get_body(match_arm));
                    match_arm = stmt_get_next(match_arm);
                }
            }
            return;
        }
        if (k == ex_STRUCT_INIT() || k == ex_FSTRING()
            || k == ex_ARRAY_LIT() || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            if (k == ex_STRUCT_INIT()) {
                let struct_name = expr_get_name(e);
                if (struct_name.len > 0
                    && policy_generic_call_args(struct_name.clone()).len > 0) {
                    self.sema_lazy_load_pending_until_symbol(struct_name);
                }
            }
            var cell = expr_get_args(e);
            while (cell != null) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(cell));
                cell = stmt_get_next(cell);
            }
            if (k == ex_ARRAY_LIT()) {
                self.sema_lazy_load_expr_body_symbols(expr_get_captures(e));
            }
        }
    }

    public fn sema_lazy_load_stmt_body_symbols(self, sp: rawptr) {
        var cur = sp;
        while (cur != null && !self.too_many_errors()) {
            let k = stmt_get_kind(cur);
            if (k == st_EXPR() || k == st_RETURN()) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(cur));
            } else if (k == st_LET() || k == st_VAR()) {
                self.sema_lazy_load_type_ref_symbols(stmt_get_ty(cur));
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(cur));
            } else if (k == st_IF()) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_cond(cur));
                self.sema_lazy_load_stmt_body_symbols(stmt_get_then_blk(cur));
                self.sema_lazy_load_stmt_body_symbols(stmt_get_else_blk(cur));
            } else if (k == st_WHILE() || k == st_FOREACH()) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_cond(cur));
                self.sema_lazy_load_stmt_body_symbols(stmt_get_body(cur));
            } else if (k == st_BLOCK()) {
                self.sema_lazy_load_stmt_body_symbols(stmt_get_body(cur));
            } else if (k == st_FOR()) {
                self.sema_lazy_load_stmt_body_symbols(stmt_get_init(cur));
                self.sema_lazy_load_expr_body_symbols(stmt_get_cond(cur));
                self.sema_lazy_load_stmt_body_symbols(stmt_get_then_blk(cur));
                self.sema_lazy_load_stmt_body_symbols(stmt_get_body(cur));
            } else if (k == st_MATCH()) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_init(cur));
                var arm = stmt_get_body(cur);
                while (arm != null) {
                    self.sema_lazy_load_expr_body_symbols(stmt_get_init(arm));
                    self.sema_lazy_load_expr_body_symbols(stmt_get_cond(arm));
                    self.sema_lazy_load_stmt_body_symbols(stmt_get_body(arm));
                    arm = stmt_get_next(arm);
                }
            } else if (k == st_DEFER()) {
                self.sema_lazy_load_stmt_body_symbols(stmt_get_init(cur));
            } else if (k == st_STATIC_ASSERT()) {
                self.sema_lazy_load_expr_body_symbols(stmt_get_cond(cur));
            }
            cur = stmt_get_next(cur);
        }
    }

    public fn sema_lazy_load_unit_body_symbols(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            if (decl_get_kind(cur) == de_FN() && !decl_marked_imported(cur)
                && self.sema_service_callable_needed(cur)) {
                self.sema_lazy_load_stmt_body_symbols(decl_get_body(cur));
            } else if (decl_get_kind(cur) == de_CLASS() && !decl_marked_imported(cur)) {
                var member = decl_get_members(cur);
                while (member != null && !self.too_many_errors()) {
                    if (decl_get_kind(member) == de_METHOD() && self.sema_service_callable_needed(member)) {
                        self.sema_lazy_load_stmt_body_symbols(decl_get_body(member));
                    }
                    member = decl_get_next(member);
                }
            } else if (decl_get_kind(cur) == de_ENUM() && !decl_marked_imported(cur)) {
                var emember = decl_get_members(cur);
                while (emember != null && !self.too_many_errors()) {
                    if (decl_get_kind(emember) == de_METHOD() && self.sema_service_callable_needed(emember)) {
                        self.sema_lazy_load_stmt_body_symbols(decl_get_body(emember));
                    }
                    emember = decl_get_next(emember);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    // ────────────────────────────────────────────────────────────────
    //   Pass 2 — resolve_unit drives resolve_fn → resolve_stmt →
    //   resolve_expr. ST_BLOCK saves/restores `cur_locals` for
    //   lexical scoping.
    // ────────────────────────────────────────────────────────────────

    public fn ensure_method_self_param(self, owner_decl: rawptr, method_decl: rawptr) {
        if (owner_decl == null || method_decl == null) { return; }
        if (decl_get_kind(method_decl) != de_METHOD()) { return; }
        let first_param = decl_get_params(method_decl);
        if (first_param != null && decl_get_name(first_param) == "self") {
            sema_mark_receiver_compat_if_missing(first_param);
            let self_type_name = sema_decl_self_type_name(owner_decl);
            let current_self_ty = decl_get_ty(first_param);
            if (current_self_ty == null
                || tref_get_kind(current_self_ty) == ty_RAWPTR()
                || (tref_get_kind(current_self_ty) == ty_CLASS()
                    && tref_get_name(current_self_ty) == decl_get_name(owner_decl))) {
                decl_set_ty(first_param, tref_create_class(self_type_name));
            }
            return;
        }
        if (!decl_get_is_static(method_decl)) {
            let self_param = decl_alloc(de_FIELD(), "self");
            decl_set_ty(self_param, tref_create_class(sema_decl_self_type_name(owner_decl)));
            sema_mark_receiver_compat_if_missing(self_param);
            decl_set_next(self_param, first_param);
            decl_set_params(method_decl, self_param);
        }
    }

    public fn resolve_unit(self, unit_ptr: rawptr) {
        if (unit_ptr == null) { return; }
        var cur = unit_get_decls(unit_ptr);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            let k = decl_get_kind(cur);
            if (k == de_FN()) {
                self.resolve_fn(cur);
            } else if (k == de_CONST()) {
                let body = decl_get_body(cur);
                if (body != null) {
                    let init = stmt_get_init(body);
                    let it = self.resolve_expr(init);
                    let want = decl_get_ty(cur);
                    if (want == null) {
                        decl_set_ty(cur, it);
                    } else {
                        let adopted = self.expr_adopts_expected_type(init, want, it);
                        if (!adopted && !self.types_compatible(want, it)) {
                            self.error_mismatch("const " + decl_get_name(cur), want, it);
                        }
                    }
                }
            } else if (k == de_GLOBAL_VAR()) {
                let body2 = decl_get_body(cur);
                if (body2 != null) {
                    let init2 = stmt_get_init(body2);
                    let it2 = self.resolve_expr(init2);
                    let want2 = decl_get_ty(cur);
                    if (want2 == null) {
                        decl_set_ty(cur, it2);
                    } else {
                        let adopted2 = self.expr_adopts_expected_type(init2, want2, it2);
                        if (!adopted2 && !self.types_compatible(want2, it2)) {
                            self.error_mismatch("global " + decl_get_name(cur), want2, it2);
                        }
                    }
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                var mp = decl_get_members(cur);
                let owner_gp = decl_get_generic_params(cur);
                let owner_imported = string_contains(decl_get_meta(cur), "|imported");
                let impl_count_text = sema_extract_meta_field(owner_gp,
                                                               "|sema_impl_member_count:");
                var impl_remaining: i64 = if (impl_count_text.len > 0) {
                    sema_parse_i64_lit(impl_count_text)
                } else { -1 };
                while (mp != null && impl_remaining != 0 && !self.too_many_errors()) {
                    if (decl_get_kind(mp) == de_METHOD()) {
                        self.ensure_method_self_param(cur, mp);
                        if (!owner_imported) {
                            self.resolve_method_with_owner(mp, cur, false);
                        }
                    }
                    mp = decl_get_next(mp);
                    if (impl_remaining > 0) { impl_remaining = impl_remaining - 1; }
                }
            } else if (k == de_EXTERN_FN() && ((decl_get_generic_flags(cur) & 512) != 0)) {
                var child = decl_get_members(cur);
                while (child != null) {
                    if (self.too_many_errors()) { break; }
                    if (decl_get_kind(child) == de_CLASS()) {
                        var cmp = decl_get_members(child);
                        while (cmp != null) {
                            if (self.too_many_errors()) { break; }
                            if (decl_get_kind(cmp) == de_METHOD() && decl_get_body(cmp) != null) {
                                self.ensure_method_self_param(child, cmp);
                                self.resolve_method_with_owner(cmp, child, false);
                            }
                            cmp = decl_get_next(cmp);
                        }
                    } else if (decl_get_kind(child) == de_FN() && decl_get_body(child) != null) {
                        self.resolve_fn(child);
                    }
                    child = decl_get_next(child);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_service_callable_needed(self, d: rawptr) -> bool {
        if (vyx_lsp_bind_root() == null || vyx_lsp_bind_decl_needed(d) != 0) { return true; }
        if (decl_get_ty(d) != null) { return false; }
        // A body with no value-return proves void without following its calls.
        if (decl_get_body(d) != null && !sema_stmt_has_value_return(decl_get_body(d))) {
            decl_set_ty(d, tref_create_kind(ty_VOID()));
            return false;
        }
        return self.cur_body_decl != null;
    }

    public fn resolve_fn(self, fn_decl: rawptr) {
        self.resolve_fn_with_owner_gp(fn_decl, "", string_contains(decl_get_meta(fn_decl), "|imported"));
    }

    public fn decl_owner_imported_in_chain(self, head: rawptr, target: rawptr, inherited_imported: bool) -> bool {
        var cur = head;
        while (cur != null) {
            let cur_imported = inherited_imported || decl_marked_imported(cur);
            let members = decl_get_members(cur);
            var member = members;
            while (member != null) {
                if (member == target) { return cur_imported; }
                member = decl_get_next(member);
            }
            if (members != null && self.decl_owner_imported_in_chain(members, target, cur_imported)) {
                return true;
            }
            cur = decl_get_next(cur);
        }
        return false;
    }

    /// One-shot O(decl-tree) precomputation of the `|effective_imported` /
    /// `|effective_local` markers that `decl_effectively_imported` consults.
    /// Without this pass every unseen decl pays a full
    /// `decl_owner_imported_in_chain` scan, which is quadratic: measured
    /// 117 s of 120 s total on src/core/sema.vyx, vs 6 s in the previous
    /// compiler generation.  Semantics are identical to the per-decl scan
    /// (see `decl_owner_imported_in_chain`): a decl inherits its owner
    /// chain's imported flag.
    public fn sema_mark_effective_imported_chain(self, head: rawptr, inherited: bool) {
        var cur = head;
        while (cur != null) {
            let owned = inherited || decl_marked_imported(cur);
            let meta = decl_get_meta(cur);
            if (owned) {
                if (!string_contains(meta, "|effective_imported")) {
                    decl_set_meta(cur, meta + "|effective_imported");
                }
            } else {
                if (!string_contains(meta, "|effective_local")) {
                    decl_set_meta(cur, meta + "|effective_local");
                }
            }
            self.sema_mark_effective_imported_chain(decl_get_members(cur), owned);
            cur = decl_get_next(cur);
        }
    }

    fn sema_build_effective_imported_once(self) {
        if (g_sema_eff_imported_built) { return; }
        g_sema_eff_imported_built = true;
        if (self.current_unit == null) { return; }
        self.sema_mark_effective_imported_chain(unit_get_decls(self.current_unit), false);
    }

    public fn decl_effectively_imported(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let meta = decl_get_meta(d);
        if (string_contains(meta, "|effective_imported")) { return true; }
        if (string_contains(meta, "|effective_local")) { return false; }
        if (decl_marked_imported(d)) { return true; }
        if (self.current_unit == null) { return false; }
        // Try a whole-tree marking pass before falling back to the per-decl
        // chain scan.  The fallback stays for decls synthesized after the
        // pass ran, so results never change.
        self.sema_build_effective_imported_once();
        let meta_after = decl_get_meta(d);
        if (string_contains(meta_after, "|effective_imported")) { return true; }
        if (string_contains(meta_after, "|effective_local")) { return false; }
        let imported = self.decl_owner_imported_in_chain(unit_get_decls(self.current_unit), d, false);
        let meta2 = decl_get_meta(d);
        if (imported) {
            if (!string_contains(meta2, "|effective_imported")) {
                decl_set_meta(d, meta2 + "|effective_imported");
            }
        } else {
            if (!string_contains(meta2, "|effective_local")) {
                decl_set_meta(d, meta2 + "|effective_local");
            }
        }
        return imported;
    }

    public fn find_owner_decl_in_decls(self, head: rawptr, target: rawptr) -> rawptr {
        var cur = head;
        while (cur != null) {
            let k = decl_get_kind(cur);
            if (k == de_CLASS() || k == de_ENUM()) {
                var mp = decl_get_members(cur);
                while (mp != null) {
                    if (mp == target) { return cur; }
                    mp = decl_get_next(mp);
                }
            }
            let nested = self.find_owner_decl_in_decls(decl_get_members(cur), target);
            if (nested != null) { return nested; }
            cur = decl_get_next(cur);
        }
        return null;
    }

    public fn find_owner_decl_for_member(self, member: rawptr) -> rawptr {
        if (member == null) { return null; }
        if (self.cur_owner_decl != null) {
            var mp = decl_get_members(self.cur_owner_decl);
            while (mp != null) {
                if (mp == member) { return self.cur_owner_decl; }
                mp = decl_get_next(mp);
            }
        }
        if (self.current_unit == null) { return null; }
        return self.find_owner_decl_in_decls(unit_get_decls(self.current_unit), member);
    }

    public fn sema_resolve_decl_body_if_needed(self, fn_decl: rawptr) {
        if (fn_decl == null) { return; }
        if (!self.sema_service_callable_needed(fn_decl)) { return; }
        if (self.too_many_errors()) { return; }
        if (decl_get_body(fn_decl) == null) { return; }
        if (self.prepare_hir_facts) { return; }
        let meta = decl_get_meta(fn_decl);
        if (string_contains(meta, "|body_resolved") || string_contains(meta, "|body_resolving")) {
            return;
        }
        // Unique rule: method bodies always see the owner's generic env
        // (param names plus `|where:` metadata). Never resolve a METHOD
        // through the free-function path with an empty owner_gp.
        if (decl_get_kind(fn_decl) == de_METHOD()) {
            var owner = self.find_owner_decl_for_member(fn_decl);
            var owner_imported: bool = string_contains(meta, "|imported");
            if (owner != null && string_contains(decl_get_meta(owner), "|imported")) {
                owner_imported = true;
            }
            self.resolve_method_with_owner(fn_decl, owner, owner_imported);
            return;
        }
        decl_set_meta(fn_decl, meta + "|body_resolving");
        self.resolve_fn(fn_decl);
        let meta2 = decl_get_meta(fn_decl);
        if (!string_contains(meta2, "|body_resolved")) {
            decl_set_meta(fn_decl, meta2 + "|body_resolved");
        }
    }

    public fn sema_resolve_imported_fn_if_needed(self, fn_decl: rawptr) {
        if (fn_decl == null) { return; }
        if (!self.sema_service_callable_needed(fn_decl)) { return; }
        if (self.too_many_errors()) { return; }
        if (decl_get_body(fn_decl) == null) { return; }
        let meta = decl_get_meta(fn_decl);
        if (!string_contains(meta, "|imported")) { return; }
        if (string_contains(meta, "|body_resolved") || string_contains(meta, "|body_resolving")) {
            return;
        }
        decl_set_meta(fn_decl, meta + "|body_resolving");
        self.resolve_fn(fn_decl);
        let meta2 = decl_get_meta(fn_decl);
        if (!string_contains(meta2, "|body_resolved")) {
            decl_set_meta(fn_decl, meta2 + "|body_resolved");
        }
    }

    public fn resolve_method_with_owner(self, method_decl: rawptr, owner_decl: rawptr, owner_imported: bool) {
        if (method_decl == null) { return; }
        if (!self.sema_service_callable_needed(method_decl)) { return; }
        if (self.too_many_errors()) { return; }
        if (self.prepare_hir_facts
            && !self.prepare_imported_hir_facts
            && (owner_imported || decl_is_foreign_import(method_decl))) {
            return;
        }
        var method_meta = decl_get_meta(method_decl);
        let method_has_body = decl_get_body(method_decl) != null;
        if (method_has_body
            && (string_contains(method_meta, "|body_resolved")
                || string_contains(method_meta, "|body_resolving"))) {
            return;
        }
        if (method_has_body) {
            decl_set_meta(method_decl, method_meta + "|body_resolving");
        }
        let saved_owner_class = self.cur_owner_class;
        let saved_owner_decl = self.cur_owner_decl;
        if (owner_decl != null) {
            let owner_name = decl_get_name(owner_decl);
            let owner_base = generic_call_base(owner_name.clone());
            let owner_short = module_last_segment(owner_base);
            self.cur_owner_class = owner_short;
            self.cur_owner_decl = owner_decl;
            var owner_gp = decl_get_generic_params(owner_decl);
            if (string_contains(owner_gp, "|kind:impl")
                && generic_param_head(owner_gp).len == 0) {
                let target = self.type_subject_class_decl(owner_name);
                if (target != null && target != owner_decl) {
                    owner_gp = merge_generic_params(decl_get_generic_params(target), owner_gp);
                }
            }
            self.resolve_fn_with_owner_gp(method_decl,
                                          owner_gp,
                                          owner_imported);
        } else {
            self.cur_owner_decl = null;
            self.resolve_fn_with_owner_gp(method_decl, "", owner_imported);
        }
        self.cur_owner_class = saved_owner_class;
        self.cur_owner_decl = saved_owner_decl;
        if (method_has_body) {
            let method_meta2 = decl_get_meta(method_decl);
            if (!string_contains(method_meta2, "|body_resolved")) {
                decl_set_meta(method_decl, method_meta2 + "|body_resolved");
            }
        }
    }

    public fn resolve_fn_with_owner_gp(self, fn_decl: rawptr, owner_gp: string, owner_imported: bool) {
        if (!self.sema_service_callable_needed(fn_decl)) { return; }
        let __prof_on = vyx_bootstrap_profile_level() > 0;
        var __t0: i64 = 0;
        if (__prof_on) {
            __t0 = vyx_bootstrap_now_ms();
            g_res_fn_depth = g_res_fn_depth + 1;
            print("[res-in] d=" + policy_i64_to_string(g_res_fn_depth)
                  + " t=" + policy_i64_to_string(__t0)
                  + " " + decl_get_name(fn_decl));
        }
        self.resolve_fn_with_owner_gp_inner(fn_decl, owner_gp, owner_imported);
        if (__prof_on) {
            let __t1 = vyx_bootstrap_now_ms();
            print("[res-out] d=" + policy_i64_to_string(g_res_fn_depth)
                  + " t=" + policy_i64_to_string(__t1)
                  + " dt=" + policy_i64_to_string(__t1 - __t0)
                  + " " + decl_get_name(fn_decl));
            g_res_fn_depth = g_res_fn_depth - 1;
        }
    }

    public fn resolve_fn_with_owner_gp_inner(self, fn_decl: rawptr, owner_gp: string, owner_imported: bool) {
        if (self.too_many_errors()) { return; }
        sema_stamp_loc_from_decl(fn_decl);
        let prof_level = vyx_bootstrap_profile_level();
        if (prof_level > 0) {
            print("[sema-resolve] " + decl_get_name(fn_decl));
        }
        let sema_profile_body = sema_resolve_timing_enabled();
        var prof_body_start: i64 = 0;
        if (sema_profile_body) {
            prof_body_start = vyx_bootstrap_now_ms();
        }
        let saved_head  = self.cur_locals;
        let saved_count = self.locals_count;
        let saved_ret   = self.cur_ret_ty;
        let saved_gp    = self.cur_generic_params;
        let saved_imported = self.in_imported_scope;
        let saved_owner_class = self.cur_owner_class;
        let saved_owner_decl = self.cur_owner_decl;
        let saved_body_decl = self.cur_body_decl;
        let saved_moved_head = self.moved_buf;
        let saved_moved_count = self.moved_count;
        let saved_field_moved = self.field_moved_buf;
        let saved_capture_borrow_guards = self.capture_borrow_guards;
        let saved_diag_path = diag_current_file();
        var saved_diag_source = "";
        if (saved_diag_path.len > 0 && saved_diag_path != "<unknown>") {
            saved_diag_source = self.sema_diag_cached_read(saved_diag_path);
        }
        var fn_source_path = self.sema_decl_source_path(fn_decl);
        if (fn_source_path.len == 0 && self.cur_owner_decl != null) {
            fn_source_path = self.sema_decl_source_path(self.cur_owner_decl);
        }
        var switched_diag = false;
        if (fn_source_path.len > 0 && fn_source_path != saved_diag_path) {
            diag_set_source_context(fn_source_path, self.sema_diag_cached_read(fn_source_path));
            switched_diag = true;
        }

        // A missing `-> T` is an inferred return type, not `void`.  Keep the
        // declaration unset while resolving the body; the first reachable
        // return establishes the type and later returns are checked against
        // it.  Body-less declarations still lower as void through the normal
        // null-type fallback used by interfaces/extern declarations.
        let infer_return_type = decl_get_ty(fn_decl) == null
            && decl_get_body(fn_decl) != null;
        self.cur_ret_ty = decl_get_ty(fn_decl);
        self.cur_generic_params = merge_generic_params(owner_gp, decl_get_generic_params(fn_decl));
        self.in_imported_scope = owner_imported || decl_is_foreign_import(fn_decl);
        self.cur_body_decl = fn_decl;
        self.cur_locals = null;
        self.locals_count = 0;
        self.moved_buf = null;
        self.moved_count = 0;
        self.field_moved_buf = null;
        self.capture_borrow_guards = null;

        self.sema_lazy_load_type_ref_symbols(self.cur_ret_ty);

        let gp = self.cur_generic_params;
        var gi: i64 = 0;
        while (gi < 64 && !self.too_many_errors()) {
            let graw = generic_param_raw_at(gp, gi as i32);
            if (graw.len == 0) { break; }
            let gname = generic_param_at(gp, gi as i32);
            if (gname.len > 0) {
                if (generic_param_is_const(graw)) {
                    self.cur_locals = sym_push_local_ex(self.cur_locals,
                                                        gname,
                                                        tref_create_kind(ty_I64()),
                                                        true);
                } else {
                    self.cur_locals = sym_push_local(self.cur_locals,
                                                     gname,
                                                     tref_create_class(gname));
                }
                self.locals_count = self.locals_count + 1;
            }
            gi = gi + 1;
        }

        // Constructors are static at the call site (`Type(args)`), but the
        // body initializes HIR's hidden ABI `self`. Bind it for name lookup
        // without adding a user-facing parameter (that would break arity).
        if (sema_decl_is_constructor(fn_decl)
            && self.cur_owner_decl != null
            && (decl_get_params(fn_decl) == null
                || decl_get_name(decl_get_params(fn_decl)) != "self")) {
            let ctor_self_ty = tref_create_class(sema_decl_self_type_name(self.cur_owner_decl));
            self.sema_lazy_load_type_ref_symbols(ctor_self_ty);
            self.cur_locals = sym_push_local_ex(self.cur_locals, "self", ctor_self_ty, false);
            sym_set_alloc_state(self.cur_locals, sema_alloc_state_compat_this());
            self.locals_count = self.locals_count + 1;
        }

        var pp = decl_get_params(fn_decl);
        while (pp != null && !self.too_many_errors()) {
            let p_name = decl_get_name(pp);
            var p_ty   = decl_get_ty(pp);
            if (string_contains(decl_get_generic_params(pp), "|variadic")) {
                p_ty = tref_alloc(ty_RAWPTR(), "varargs");
            }
            self.sema_lazy_load_type_ref_symbols(p_ty);
            // Host parser has no `mut` parameter syntax. Bootstrap params are
            // mutable locals (C ABI), including class-by-value handles.
            var p_const = false;
            var p_state = sema_alloc_state_from_type(p_ty);
            if (p_name == "self") {
                let receiver_mode = sema_receiver_mode(pp);
                if (receiver_mode == sema_receiver_mode_shared()) {
                    p_const = true;
                    p_state = sema_alloc_state_borrowed_immutable();
                } else if (receiver_mode == sema_receiver_mode_mut()) {
                    p_const = true;
                    p_state = sema_alloc_state_borrowed_mutable();
                } else if (receiver_mode == sema_receiver_mode_own()) {
                    p_const = true;
                    p_state = sema_alloc_state_none();
                } else if (receiver_mode == sema_receiver_mode_own_mut()) {
                    p_const = false;
                    if (self.type_has_copy_dup(p_ty)
                        || self.class_decl_has_instance_dup(self.cur_owner_decl)) {
                        p_state = sema_alloc_state_compat_this();
                    } else {
                        p_state = sema_alloc_state_none();
                    }
                } else {
                    p_const = false;
                    p_state = sema_alloc_state_compat_this();
                }
            }
            self.cur_locals = sym_push_local_ex(self.cur_locals, p_name, p_ty, p_const);
            // `sym.decl` marks the slot as a param. Mutability is `p_const`,
            // not "every parameter is const".
            sym_set_decl(self.cur_locals, pp);
            if (p_state != sema_alloc_state_none()) {
                sym_set_alloc_state(self.cur_locals, p_state);
            }
            decl_set_semantic(pp, expr_sem_LOCAL(), self.cur_locals, 0);
            self.locals_count = self.locals_count + 1;
            pp = decl_get_next(pp);
        }

        let body = decl_get_body(fn_decl);
        if (body != null && !self.too_many_errors()) {
            if (prof_level > 2) { print("[sema-fn-body-check] " + decl_get_name(fn_decl)); }
            self.check_generic_static_const_stmt(body, gp, decl_get_name(fn_decl));
            if (!self.too_many_errors()) {
                if (prof_level > 2) { print("[sema-fn-body-resolve] " + decl_get_name(fn_decl)); }
                self.resolve_stmt(body);
                if (prof_level > 2) { print("[sema-fn-body-done] " + decl_get_name(fn_decl)); }
            }
        }

        if (infer_return_type) {
            if (self.cur_ret_ty == null) {
                self.cur_ret_ty = tref_create_kind(ty_VOID());
            }
            decl_set_ty(fn_decl, sema_clone_type_ref(self.cur_ret_ty));
        }

        sym_release_scope_borrows(self.cur_locals, saved_head);
        sym_release_scope_borrows(self.capture_borrow_guards, null);
        self.cur_locals   = saved_head;
        self.locals_count = saved_count;
        self.cur_ret_ty   = saved_ret;
        self.cur_generic_params = saved_gp;
        self.in_imported_scope = saved_imported;
        self.cur_owner_class = saved_owner_class;
        self.cur_owner_decl = saved_owner_decl;
        self.cur_body_decl = saved_body_decl;
        self.moved_buf = saved_moved_head;
        self.moved_count = saved_moved_count;
        self.field_moved_buf = saved_field_moved;
        self.capture_borrow_guards = saved_capture_borrow_guards;
        if (switched_diag) {
            diag_set_source_context(saved_diag_path, saved_diag_source);
        }
        if (sema_profile_body) {
            let prof_elapsed = vyx_bootstrap_now_ms() - prof_body_start;
            if (prof_elapsed >= sema_resolve_slow_threshold_ms()) {
                print("[sema-resolve-slow] " + decl_get_name(fn_decl) + ": "
                      + policy_i64_to_string(prof_elapsed) + " ms");
            }
        }
    }

    /// Conservative NLL helper. A borrow local remains registered until its
    /// final syntactic use in the current lexical block. Nested blocks never
    /// retire borrows owned by an outer block; their owner block will do that
    /// while walking its own sibling chain.
    fn expr_mentions_local(self, e: rawptr, name: string) -> bool {
        if (e == null || name.len == 0) { return false; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) { return expr_get_name(e) == name; }
        if (k == ex_MEMBER() || k == ex_UNARY() || k == ex_ADDR_OF()
            || k == ex_DEREF() || k == ex_COMPTIME() || k == ex_AWAIT()
            || k == ex_CAST() || k == ex_FAIL()) {
            return self.expr_mentions_local(expr_get_lhs(e), name);
        }
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
            return self.expr_mentions_local(expr_get_lhs(e), name)
                || self.expr_mentions_local(expr_get_rhs(e), name);
        }
        if (k == ex_TERNARY()) {
            return self.expr_mentions_local(expr_get_lhs(e), name)
                || self.expr_mentions_local(expr_get_rhs(e), name)
                || self.expr_mentions_local(expr_get_args(e), name);
        }
    if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
        if (self.expr_mentions_local(expr_get_lhs(e), name)
            || (k == ex_IF_EXPR()
                && self.stmt_chain_mentions_local(expr_get_rhs(e), name))) {
            return true;
        }
        if (k == ex_IF_EXPR()) {
            let else_part = expr_get_args(e);
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                return self.expr_mentions_local(else_part, name);
            }
            return self.stmt_chain_mentions_local(else_part, name);
        }
        var match_arm = expr_get_args(e);
        while (match_arm != null) {
            if (self.expr_mentions_local(stmt_get_init(match_arm), name)
                || self.expr_mentions_local(stmt_get_cond(match_arm), name)
                || self.stmt_chain_mentions_local(stmt_get_body(match_arm), name)) {
                return true;
            }
            match_arm = stmt_get_next(match_arm);
        }
        return false;
        }
        if (k == ex_CALL() || k == ex_NEW()) {
            if (self.expr_mentions_local(expr_get_lhs(e), name)
                || self.expr_mentions_local(expr_get_rhs(e), name)) {
                return true;
            }
            var arg = expr_get_args(e);
            while (arg != null) {
                if (self.expr_mentions_local(stmt_get_init(arg), name)) { return true; }
                arg = stmt_get_next(arg);
            }
            return false;
        }
        if (k == ex_DELETE()) {
            return self.expr_mentions_local(expr_get_lhs(e), name)
                || self.expr_mentions_local(expr_get_rhs(e), name);
        }
        if (k == ex_STRUCT_INIT() || k == ex_FSTRING()
            || k == ex_ARRAY_LIT() || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            var cell = expr_get_args(e);
            while (cell != null) {
                if (self.expr_mentions_local(stmt_get_init(cell), name)) { return true; }
                cell = stmt_get_next(cell);
            }
            return false;
        }
        if (k == ex_CLOSURE()) {
            var capture = expr_get_captures(e);
            while (capture != null) {
                if (self.expr_mentions_local(stmt_get_init(capture), name)) { return true; }
                capture = stmt_get_next(capture);
            }
            return self.stmt_chain_mentions_local(expr_get_lhs(e), name);
        }
        return false;
    }

    fn stmt_tree_mentions_local(self, sp: rawptr, name: string) -> bool {
        if (sp == null) { return false; }
        let k = stmt_get_kind(sp);
        if (k == st_EXPR() || k == st_LET() || k == st_VAR()
            || k == st_RETURN()) {
            return self.expr_mentions_local(stmt_get_init(sp), name);
        }
        if (k == st_IF()) {
            return self.expr_mentions_local(stmt_get_cond(sp), name)
                || self.stmt_chain_mentions_local(stmt_get_then_blk(sp), name)
                || self.stmt_chain_mentions_local(stmt_get_else_blk(sp), name);
        }
        if (k == st_WHILE()) {
            return self.expr_mentions_local(stmt_get_cond(sp), name)
                || self.stmt_chain_mentions_local(stmt_get_body(sp), name);
        }
        if (k == st_BLOCK()) {
            return self.stmt_chain_mentions_local(stmt_get_body(sp), name);
        }
        if (k == st_FOR()) {
            return self.stmt_tree_mentions_local(stmt_get_init(sp), name)
                || self.expr_mentions_local(stmt_get_cond(sp), name)
                || self.stmt_tree_mentions_local(stmt_get_body(sp), name)
                || self.stmt_chain_mentions_local(stmt_get_then_blk(sp), name);
        }
        if (k == st_FOREACH()) {
            return self.expr_mentions_local(stmt_get_cond(sp), name)
                || self.stmt_chain_mentions_local(stmt_get_body(sp), name);
        }
        if (k == st_MATCH()) {
            if (self.expr_mentions_local(stmt_get_init(sp), name)) { return true; }
            var arm = stmt_get_body(sp);
            while (arm != null) {
                if (self.expr_mentions_local(stmt_get_init(arm), name)
                    || self.expr_mentions_local(stmt_get_cond(arm), name)
                    || self.stmt_chain_mentions_local(stmt_get_body(arm), name)) {
                    return true;
                }
                arm = stmt_get_next(arm);
            }
            return false;
        }
        if (k == st_DEFER()) {
            return self.stmt_tree_mentions_local(stmt_get_init(sp), name);
        }
        if (k == st_STATIC_ASSERT()) {
            return self.expr_mentions_local(stmt_get_cond(sp), name);
        }
        return false;
    }

    fn stmt_chain_mentions_local(self, sp: rawptr, name: string) -> bool {
        var cur = sp;
        while (cur != null) {
            if (self.stmt_tree_mentions_local(cur, name)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn stmt_reinitializes_local_without_read(self,
                                             sp: rawptr,
                                             name: string) -> bool {
        if (sp == null || stmt_get_kind(sp) != st_EXPR()) { return false; }
        let e = stmt_get_init(sp);
        if (e == null || expr_get_kind(e) != ex_ASSIGN()
            || expr_get_op(e) != tk_EQ()) {
            return false;
        }
        let lhs = expr_get_lhs(e);
        if (lhs == null || expr_get_kind(lhs) != ex_IDENT()
            || expr_get_name(lhs) != name) {
            return false;
        }
        return !self.expr_mentions_local(expr_get_rhs(e), name);
    }

    fn stmt_chain_uses_current_local_value(self,
                                           sp: rawptr,
                                           name: string) -> bool {
        var cur = sp;
        while (cur != null) {
            // A plain assignment creates a new value generation. Uses after
            // it belong to that generation and must not keep the previous
            // borrow alive.
            if (self.stmt_reinitializes_local_without_read(cur, name)) {
                return false;
            }
            if (self.stmt_tree_mentions_local(cur, name)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn make_borrow_guard(self, source: rawptr) -> rawptr {
        if (source == null || sym_is_borrow_guard(source)) { return null; }
        let state = sym_get_alloc_state(source);
        if (state != sema_alloc_state_borrowed_immutable()
            && state != sema_alloc_state_borrowed_mutable()) {
            return null;
        }
        let region = sym_region_root(source);
        if (region == null || region == source) { return null; }
        let guard = sym_alloc("|borrow-guard:" + sym_get_name(source));
        if (guard == null) { return null; }
        sym_set_ty(guard, sym_get_ty(source));
        sym_set_alloc_state(guard, state);
        sym_set_borrow_source(guard, region);
        sym_set_borrow_loc(guard, sym_get_borrow_loc(source));
        return guard;
    }

    fn push_lexical_borrow_guard(self, source: rawptr) {
        let guard = self.make_borrow_guard(source);
        if (guard == null) { return; }
        sym_set_next(guard, self.cur_locals);
        self.cur_locals = guard;
        self.locals_count = self.locals_count + 1;
        sym_register_borrow(guard);
    }

    fn push_capture_borrow_guard(self, source: rawptr) {
        let guard = self.make_borrow_guard(source);
        if (guard == null) { return; }
        sym_set_next(guard, self.capture_borrow_guards);
        self.capture_borrow_guards = guard;
        sym_register_borrow(guard);
    }

    /// A defer body or closure can use a borrow after its source name's last
    /// ordinary syntactic use. Materialize a hidden guard so rebinding the
    /// source handle does not silently release the captured region. Closure
    /// guards live for the function because the closure may leave its defining
    /// block; defer guards follow the defer statement's lexical block.
    fn retain_expr_capture_borrows(self, e: rawptr) {
        if (e == null) { return; }
        let scan_head = self.cur_locals;
        var local = scan_head;
        while (local != null) {
            let next = sym_get_next(local);
            let state = sym_get_alloc_state(local);
            if ((state == sema_alloc_state_borrowed_immutable()
                || state == sema_alloc_state_borrowed_mutable())
                && !sym_is_borrow_guard(local)
                && self.expr_mentions_local(e, sym_get_name(local))) {
                self.push_capture_borrow_guard(local);
            }
            local = next;
        }
    }

    fn retain_stmt_capture_borrows(self, sp: rawptr) {
        if (sp == null) { return; }
        let scan_head = self.cur_locals;
        var local = scan_head;
        while (local != null) {
            let next = sym_get_next(local);
            let state = sym_get_alloc_state(local);
            if ((state == sema_alloc_state_borrowed_immutable()
                || state == sema_alloc_state_borrowed_mutable())
                && !sym_is_borrow_guard(local)
                && self.stmt_tree_mentions_local(sp, sym_get_name(local))) {
                self.push_lexical_borrow_guard(local);
            }
            local = next;
        }
    }

    fn release_dead_block_borrows(self,
                                  head: rawptr,
                                  stop: rawptr,
                                  remaining: rawptr) {
        var local = head;
        while (local != null && local != stop) {
            let state = sym_get_alloc_state(local);
            if ((state == sema_alloc_state_borrowed_immutable()
                || state == sema_alloc_state_borrowed_mutable())
                && !sym_is_borrow_guard(local)
                && !self.stmt_chain_uses_current_local_value(
                    remaining,
                    sym_get_name(local))) {
                sym_end_borrow(local);
            }
            local = sym_get_next(local);
        }
    }

    public fn resolve_stmt(self, sp: rawptr) {
        if (sp == null) { return; }
        if (self.too_many_errors()) { return; }
        sema_stamp_loc_from_stmt(sp);
        let k = stmt_get_kind(sp);
        if (vyx_bootstrap_profile_level() > 3) {
            print("[sema-stmt] kind=" + policy_i64_to_string(k as i64) + " name=" + stmt_get_name(sp));
        }

        if (k == st_EXPR()) {
            self.resolve_expr(stmt_get_init(sp));
            return;
        }
        if (k == st_LET() || k == st_VAR()) {
            let unsafe_local = (stmt_get_semantic_flags(sp) & stmt_flag_unsafe_local()) != 0;
            if (unsafe_local) { self.unsafe_depth = self.unsafe_depth + 1; }
            var ty = stmt_get_ty(sp);
            let init = stmt_get_init(sp);
            if (init != null) {
                var it = self.resolve_expr(init);
                if (ty == null) {
                    ty = it;
                } else {
                    let adopted = self.expr_adopts_expected_type(init, ty, it);
                    if (!adopted && !self.types_compatible_user_value(ty, it)) {
                        self.error_mismatch("let/var " + stmt_get_name(sp), ty, it);
                    }
                }
            }
            if (ty == null) {
                ty = tref_create_kind(ty_I32());
            }
            if (self.type_is_string_like(ty) && !self.sema_symbol_known("str_length")) {
                self.sema_load_module("std.string");
            }
            if (init != null) {
                self.mark_identifier_moved_if_transfer(init, ty, true);
            }
            self.cur_locals = sym_push_local_ex(self.cur_locals, stmt_get_name(sp), ty, k == st_LET());
            var alloc_state = self.expr_alloc_state(init);
            if (init != null
                && expr_get_kind(init) == ex_IDENT()
                && ty != null
                && tref_get_kind(ty) == ty_PTR()) {
                alloc_state = sema_alloc_state_compat_alias();
            }
            if (alloc_state == sema_alloc_state_none() && ty != null) {
                let local_kind = tref_get_kind(ty);
                if (local_kind == ty_PTR() || local_kind == ty_REF()
                    || local_kind == ty_MUTREF() || local_kind == ty_RAWPTR()) {
                    alloc_state = sema_alloc_state_unknown_pointer();
                }
            }
            let typed_state = sema_alloc_state_from_type(ty);
            if (typed_state != sema_alloc_state_none()) {
                alloc_state = typed_state;
            }
            sym_set_alloc_state(self.cur_locals, alloc_state);
            if (alloc_state == sema_alloc_state_borrowed_immutable()
                || alloc_state == sema_alloc_state_borrowed_mutable()
                || alloc_state == sema_alloc_state_compat_alias()) {
                sym_set_borrow_source(self.cur_locals, self.expr_borrow_source(init));
            }
            if (alloc_state == sema_alloc_state_borrowed_immutable()
                || alloc_state == sema_alloc_state_borrowed_mutable()) {
                sym_set_borrow_loc(self.cur_locals, expr_loc_ptr(init));
            }
            sym_register_borrow(self.cur_locals);
            // Preserve parser-reserved qualifier bits (e.g. the `volatile`
            // local marker) across the LOCAL semantic write.
            let saved_flags = stmt_get_semantic_flags(sp);
            stmt_set_semantic(sp, expr_sem_LOCAL(), self.cur_locals,
                              saved_flags & (stmt_flag_volatile_local()
                                             | stmt_flag_unsafe_local()));
            self.locals_count = self.locals_count + 1;
            if (unsafe_local) { self.unsafe_depth = self.unsafe_depth - 1; }
            return;
        }
        if (k == st_IF()) {
            let ct = self.resolve_expr(stmt_get_cond(sp));
            if (!type_is_boolish(ct)) {
                self.error_mismatch("if cond", tref_create_kind(ty_BOOL()), ct);
            }
            let then_blk = stmt_get_then_blk(sp);
            let else_blk = stmt_get_else_blk(sp);
            let pre_moved = self.clone_sym_decl_list(self.moved_buf);
            let pre_fields = self.clone_sym_decl_list(self.field_moved_buf);
            self.resolve_stmt(then_blk);
            let then_returns = self.stmt_always_returns(then_blk);
            let then_moved = self.moved_buf;
            let then_fields = self.field_moved_buf;
            self.set_move_state(self.clone_sym_decl_list(pre_moved), self.clone_sym_decl_list(pre_fields));
            if (else_blk != null) {
                self.resolve_stmt(else_blk);
                let else_returns = self.stmt_always_returns(else_blk);
                if (then_returns && !else_returns) {
                } else if (else_returns && !then_returns) {
                    self.set_move_state(then_moved, then_fields);
                } else if (then_returns && else_returns) {
                    self.set_move_state(pre_moved, pre_fields);
                } else {
                    self.union_moved_buf_from(then_moved);
                    self.union_field_moved_buf_from(then_fields);
                }
            } else if (then_returns) {
                self.set_move_state(pre_moved, pre_fields);
            } else {
                self.set_move_state(self.clone_sym_decl_list(pre_moved), self.clone_sym_decl_list(pre_fields));
                self.union_moved_buf_from(then_moved);
                self.union_field_moved_buf_from(then_fields);
            }
            return;
        }
        if (k == st_WHILE()) {
            let ct = self.resolve_expr(stmt_get_cond(sp));
            if (!type_is_boolish(ct)) {
                self.error_mismatch("while cond", tref_create_kind(ty_BOOL()), ct);
            }
            self.loop_depth = self.loop_depth + 1;
            let pre_moved = self.clone_sym_decl_list(self.moved_buf);
            let pre_fields = self.clone_sym_decl_list(self.field_moved_buf);
            let pre_locals = self.cur_locals;
            self.resolve_stmt(stmt_get_body(sp));
            self.reject_loop_outer_ownership_transfer(pre_moved, pre_fields, pre_locals, sp, "while loop");
            self.loop_depth = self.loop_depth - 1;
            return;
        }
        if (k == st_RETURN()) {
            let ri = stmt_get_init(sp);
            if (ri == null) {
                if (self.cur_ret_ty == null) {
                    self.cur_ret_ty = tref_create_kind(ty_VOID());
                } else if (tref_get_kind(self.cur_ret_ty) != ty_VOID()) {
                    self.error_mismatch("return", self.cur_ret_ty, tref_create_kind(ty_VOID()));
                }
            } else {
                let rt = self.resolve_expr(ri);
                if (self.cur_ret_ty == null) {
                    if (rt == null) {
                        self.cur_ret_ty = tref_create_kind(ty_VOID());
                    } else {
                        self.cur_ret_ty = sema_clone_type_ref(rt);
                    }
                } else {
                    let adopted_ret = self.expr_adopts_expected_type(ri, self.cur_ret_ty, rt);
                    if (!adopted_ret && !self.types_compatible_user_value(self.cur_ret_ty, rt)) {
                        self.error_mismatch("return", self.cur_ret_ty, rt);
                    }
                }
            }
            return;
        }
        if (k == st_BLOCK()) {
            let unsafe_blk = (stmt_get_semantic_flags(sp) & stmt_flag_unsafe_block()) != 0;
            if (unsafe_blk) { self.unsafe_depth = self.unsafe_depth + 1; }
            let saved_head  = self.cur_locals;
            let saved_count = self.locals_count;
            var cur = stmt_get_body(sp);
            while (cur != null && !self.too_many_errors()) {
                self.release_dead_block_borrows(self.cur_locals,
                                                saved_head,
                                                cur);
                self.resolve_stmt(cur);
                cur = stmt_get_next(cur);
            }
            sym_release_scope_borrows(self.cur_locals, saved_head);
            self.cur_locals   = saved_head;
            self.locals_count = saved_count;
            if (unsafe_blk) { self.unsafe_depth = self.unsafe_depth - 1; }
            return;
        }
        if (k == st_FOR()) {
            let saved_head  = self.cur_locals;
            let saved_count = self.locals_count;
            let init_s = stmt_get_init(sp);
            if (init_s != null) { self.resolve_stmt(init_s); }
            let cond_e = stmt_get_cond(sp);
            if (cond_e != null) {
                let ct = self.resolve_expr(cond_e);
                if (!type_is_boolish(ct)) {
                    self.error_mismatch("for cond", tref_create_kind(ty_BOOL()), ct);
                }
            }
            let incr_s = stmt_get_body(sp);
            self.loop_depth = self.loop_depth + 1;
            let pre_moved = self.clone_sym_decl_list(self.moved_buf);
            let pre_fields = self.clone_sym_decl_list(self.field_moved_buf);
            let pre_locals = self.cur_locals;
            if (incr_s != null) { self.resolve_stmt(incr_s); }
            let body_s = stmt_get_then_blk(sp);
            if (body_s != null) { self.resolve_stmt(body_s); }
            self.reject_loop_outer_ownership_transfer(pre_moved, pre_fields, pre_locals, sp, "for loop");
            self.loop_depth = self.loop_depth - 1;
            sym_release_scope_borrows(self.cur_locals, saved_head);
            self.cur_locals = saved_head;
            self.locals_count = saved_count;
            return;
        }
        if (k == st_FOREACH()) {
            let saved_head2 = self.cur_locals;
            let saved_count2 = self.locals_count;
            let foreach_cond = stmt_get_cond(sp);
            if (foreach_cond != null && expr_get_kind(foreach_cond) == ex_IDENT()) {
                let foreach_name = expr_get_name(foreach_cond);
                if (!self.name_resolves_in_current_scope(foreach_name)) {
                    let foreach_line = expr_loc_line(foreach_cond);
                    let foreach_col = expr_loc_col(foreach_cond);
                    var foreach_start_col = foreach_col - (foreach_name.len as i32);
                    if (foreach_start_col < 1) { foreach_start_col = foreach_col; }
                    expr_set_loc(foreach_cond,
                                 foreach_line,
                                 foreach_start_col,
                                 foreach_line,
                                 foreach_col);
                    self.report_error_help(diag_code_sema_undefined(),
                                            expr_loc_ptr(foreach_cond),
                                            "unknown name '" + foreach_name + "'",
                                            "check spelling, or pass a collection that exists in this scope");
                }
            }
            let coll_ty = self.resolve_expr(foreach_cond);
            var iter_ty = self.foreach_element_type_from_collection(coll_ty);
            let iter_name = stmt_get_name(sp);
            if (iter_name.len > 0) {
                stmt_set_ty(sp, iter_ty);
                self.cur_locals = sym_push_local(self.cur_locals, iter_name, iter_ty);
                stmt_set_semantic(sp, expr_sem_LOCAL(), self.cur_locals, 0);
                self.locals_count = self.locals_count + 1;
            }
            self.loop_depth = self.loop_depth + 1;
            let pre_moved = self.clone_sym_decl_list(self.moved_buf);
            let pre_fields = self.clone_sym_decl_list(self.field_moved_buf);
            let pre_locals = self.cur_locals;
            self.resolve_stmt(stmt_get_body(sp));
            self.reject_loop_outer_ownership_transfer(pre_moved, pre_fields, pre_locals, sp, "foreach loop");
            self.loop_depth = self.loop_depth - 1;
            sym_release_scope_borrows(self.cur_locals, saved_head2);
            self.cur_locals = saved_head2;
            self.locals_count = saved_count2;
            return;
        }
        if (k == st_MATCH()) {
            let scrut_ty = self.resolve_expr(stmt_get_init(sp));
            // Each arm starts from the pre-match move state (only one arm
            // executes); after the match, a local moved in ANY arm counts as
            // maybe-moved and later uses are diagnosed.
            let pre_moved = self.clone_sym_decl_list(self.moved_buf);
            let pre_fields = self.clone_sym_decl_list(self.field_moved_buf);
            var acc_moved: rawptr = null;
            var acc_fields: rawptr = null;
            var arm = stmt_get_body(sp);
            while (arm != null && !self.too_many_errors()) {
                let saved_arm_head = self.cur_locals;
                let saved_arm_count = self.locals_count;
                let pat = stmt_get_init(arm);
                if (pat != null && !self.resolve_match_pattern(pat, scrut_ty)) {
                    self.resolve_expr(pat);
                }
                let guard = stmt_get_cond(arm);
                if (guard != null) {
                    let gt = self.resolve_expr(guard);
                    if (!type_is_boolish(gt)) {
                        self.error_mismatch("match guard", tref_create_kind(ty_BOOL()), gt);
                    }
                }
                self.resolve_stmt(stmt_get_body(arm));
                var mcur = self.moved_buf;
                while (mcur != null) {
                    if (!self.sym_list_has_entity(pre_moved, sym_get_decl(mcur))) {
                        acc_moved = sym_push_decl(acc_moved,
                                                  generic_call_base(sym_get_name(mcur)),
                                                  sym_get_decl(mcur));
                    }
                    mcur = sym_get_next(mcur);
                }
                var fcur = self.field_moved_buf;
                while (fcur != null) {
                    if (!self.sym_field_list_has(pre_fields, sym_get_decl(fcur), sym_get_name(fcur))) {
                        acc_fields = sym_push_decl(acc_fields,
                                                   sym_get_name(fcur),
                                                   sym_get_decl(fcur));
                    }
                    fcur = sym_get_next(fcur);
                }
                self.set_move_state(self.clone_sym_decl_list(pre_moved),
                                    self.clone_sym_decl_list(pre_fields));
                sym_release_scope_borrows(self.cur_locals, saved_arm_head);
                self.cur_locals = saved_arm_head;
                self.locals_count = saved_arm_count;
                arm = stmt_get_next(arm);
            }
            var macc = acc_moved;
            while (macc != null) {
                self.mark_local_moved(sym_get_decl(macc), sym_get_name(macc));
                macc = sym_get_next(macc);
            }
            var facc = acc_fields;
            while (facc != null) {
                self.mark_field_moved(sym_get_decl(facc), sym_get_name(facc));
                facc = sym_get_next(facc);
            }
            return;
        }
        if (k == st_DEFER()) {
            let deferred = stmt_get_init(sp);
            self.resolve_stmt(deferred);
            self.retain_stmt_capture_borrows(deferred);
            return;
        }
        if (k == st_STATIC_ASSERT()) {
            let ce = stmt_get_cond(sp);
            let ct = self.resolve_expr(ce);
            if (!type_is_boolish(ct)) {
                self.error_mismatch("static_assert", tref_create_kind(ty_BOOL()), ct);
                return;
            }
            if (sema_const_i64_known(ce) && sema_const_i64_value(ce) == 0) {
                self.report_error_help(diag_code_sema_control_flow(),
                                        g_sema_cur_loc,
                                        "static_assert failed",
                                        "make the condition constantly true, or remove the assertion");
            }
            return;
        }
        if (k == st_BREAK() || k == st_CONTINUE()) {
            if (self.loop_depth <= 0) {
                self.report_error_help(diag_code_sema_control_flow(),
                                        g_sema_cur_loc,
                                        "break/continue outside of loop",
                                        "move this statement inside a `while`/`for`/`foreach` loop");
            }
            return;
        }
    }

    fn expr_root_local_entry(self, e: rawptr) -> rawptr {
        if (e == null) { return null; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) {
            return sym_lookup(self.cur_locals, expr_get_name(e));
        }
        if (k == ex_UNARY() && expr_get_op(e) == unary_op_own()) {
            return self.expr_root_local_entry(expr_get_lhs(e));
        }
        if (k == ex_ADDR_OF()
            || k == ex_DEREF()
            || k == ex_INDEX()
            || k == ex_MEMBER()) {
            return self.expr_root_local_entry(expr_get_lhs(e));
        }
        return null;
    }

    fn expr_place_same_depth(self, a: rawptr, b: rawptr, depth: i32) -> bool {
        if (a == null || b == null || depth > 8) { return false; }
        let ak = expr_get_kind(a);
        if (ak != expr_get_kind(b)) { return false; }
        if (ak == ex_IDENT()) {
            return expr_get_name(a) == expr_get_name(b);
        }
        if (ak == ex_MEMBER()) {
            if (generic_call_base(expr_get_name(a)) != generic_call_base(expr_get_name(b))) {
                return false;
            }
            return self.expr_place_same_depth(expr_get_lhs(a), expr_get_lhs(b), depth + 1);
        }
        if (ak == ex_INDEX()
            || ak == ex_DEREF()
            || ak == ex_ADDR_OF()
            || (ak == ex_UNARY() && expr_get_op(a) == unary_op_own())) {
            return self.expr_place_same_depth(expr_get_lhs(a), expr_get_lhs(b), depth + 1);
        }
        return false;
    }

    fn assign_reinitializes_consumed_place(self, lhs: rawptr, rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return false; }
        if (expr_get_kind(rhs) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(rhs);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()) { return false; }
        return self.expr_place_same_depth(lhs, expr_get_lhs(callee), 0);
    }

    fn consume_is_field_reinit(self, receiver: rawptr) -> bool {
        if (self.pending_reinit_place == null || receiver == null) { return false; }
        if (expr_get_kind(self.pending_reinit_place) != ex_MEMBER()) { return false; }
        return self.expr_place_same_depth(self.pending_reinit_place, receiver, 0);
    }

    fn expr_borrow_source(self, e: rawptr) -> rawptr {
        if (e == null) { return null; }
        let k = expr_get_kind(e);
        if (k == ex_ADDR_OF()) {
            return self.expr_root_local_entry(expr_get_lhs(e));
        }
        if (k == ex_IDENT()) {
            let ent = sym_lookup(self.cur_locals, expr_get_name(e));
            if (ent != null) {
                return sym_region_root(ent);
            }
        }
        if (k == ex_UNARY() && expr_get_op(e) == unary_op_own()) {
            return self.expr_borrow_source(expr_get_lhs(e));
        }
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null && expr_get_kind(callee) == ex_MEMBER()) {
                return self.expr_root_local_entry(expr_get_lhs(callee));
            }
            // A free function returning a reference borrows from the first
            // address/reference argument unless a richer region contract is
            // available. This preserves the safe conservative behavior for
            // adapter and standard-library APIs without backend-specific
            // exceptions.
            var arg = expr_get_args(e);
            while (arg != null) {
                let source = self.expr_borrow_source(stmt_get_init(arg));
                if (source != null) { return source; }
                arg = stmt_get_next(arg);
            }
        }
        return null;
    }

    fn pointer_view_array_type(self, e: rawptr) -> rawptr {
        if (e == null) { return null; }
        let kind = expr_get_kind(e);
        if (kind == ex_IDENT()) {
            let view = sym_lookup(self.cur_locals, expr_get_name(e));
            if (view == null) { return null; }
            let source = sym_get_borrow_source(view);
            if (source == null) { return null; }
            let source_ty = sym_get_ty(source);
            if (source_ty != null && tref_get_kind(source_ty) == ty_ARRAY()) {
                return source_ty;
            }
            return null;
        }
        if (kind == ex_INDEX()) {
            let parent = self.pointer_view_array_type(expr_get_lhs(e));
            if (parent != null && tref_get_kind(parent) == ty_ARRAY()) {
                let elem = tref_array_elem(parent);
                if (elem != null && tref_get_kind(elem) == ty_ARRAY()) { return elem; }
            }
        }
        return null;
    }

    fn new_payload_is_reference_class(self, payload_ty: rawptr) -> bool {
        if (payload_ty == null || tref_get_kind(payload_ty) != ty_CLASS()) { return false; }
        let name = tref_get_name(payload_ty);
        if (name.len == 0 || type_name_is_generic(self.cur_generic_params, payload_ty)) { return false; }
        let base = generic_call_base(name.clone());
        let decl = self.class_decl_for_type_base(base);
        if (decl == null) { return false; }
        return !string_contains(decl_get_generic_params(decl), "|kind:struct");
    }

    fn new_result_type(self, payload_ty: rawptr) -> rawptr {
        if (payload_ty == null) { return tref_create_kind(ty_RAWPTR()); }
        return tref_alloc_ptr_like(ty_PTR(), payload_ty);
    }

    fn new_expr_alloc_state(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_NEW()) {
            return sema_alloc_state_unknown_pointer();
        }
        let payload_ty = expr_get_captures(e);
        if (payload_ty != null && tref_get_kind(payload_ty) == ty_ARRAY()) {
            return sema_alloc_state_owned_array();
        }
        if (self.new_payload_is_reference_class(payload_ty)) {
            return sema_alloc_state_owned_single();
        }
        return sema_alloc_state_owned_single();
    }

    fn expr_alloc_state(self, e: rawptr) -> i32 {
        if (e == null) { return sema_alloc_state_none(); }
        let k = expr_get_kind(e);
        if (k == ex_NEW()) { return self.new_expr_alloc_state(e); }
        if (k == ex_NULL_LIT()) { return sema_alloc_state_empty(); }
        if (k == ex_ADDR_OF()) {
            if (expr_get_op(e) == 1) { return sema_alloc_state_borrowed_mutable(); }
            return sema_alloc_state_borrowed_immutable();
        }
        if (k == ex_IDENT()) {
            let ent = sym_lookup(self.cur_locals, expr_get_name(e));
            if (ent != null) { return sym_get_alloc_state(ent); }
        }
        if (k == ex_UNARY() && expr_get_op(e) == unary_op_own()) {
            let moved_ty = expr_get_ty(e);
            if (moved_ty != null && tref_get_kind(moved_ty) == ty_PTR()) {
                let pointee = tref_pointee(moved_ty);
                if (pointee != null && tref_get_kind(pointee) == ty_ARRAY()) {
                    return sema_alloc_state_owned_array();
                }
                return sema_alloc_state_owned_single();
            }
            return self.expr_alloc_state(expr_get_lhs(e));
        }
        let ty = expr_get_ty(e);
        if (ty != null) {
            let tk = tref_get_kind(ty);
            if (tk == ty_REF()) { return sema_alloc_state_borrowed_immutable(); }
            if (tk == ty_MUTREF()) { return sema_alloc_state_borrowed_mutable(); }
            if (tk == ty_PTR() || tk == ty_REF() || tk == ty_MUTREF()
                || tk == ty_RAWPTR()) {
                return sema_alloc_state_unknown_pointer();
            }
        }
        return sema_alloc_state_none();
    }

    fn resolve_new_expr(self, e: rawptr) -> rawptr {
        let payload_ty = expr_get_captures(e);
        if (payload_ty == null) {
            self.report_error_help(diag_code_sema_generic(),
                                   expr_loc_ptr(e),
                                   "new requires an allocated payload type",
                                   "write `new T(...)` or `new T { ... }` with a concrete type `T`");
            let fallback = tref_create_kind(ty_RAWPTR());
            expr_set_ty(e, fallback);
            return fallback;
        }
        self.sema_lazy_load_type_ref_symbols(payload_ty);
        let allocator = expr_get_lhs(e);
        if (allocator != null) { self.resolve_expr(allocator); }

        let aggregate_init = expr_get_rhs(e);
        if (aggregate_init != null) {
            let aggregate_ty = self.resolve_expr(aggregate_init);
            self.expr_adopts_expected_type(aggregate_init, payload_ty, aggregate_ty);
        }

        var arg_count: i32 = 0;
        var arg = expr_get_args(e);
        while (arg != null) {
            let init = stmt_get_init(arg);
            let init_ty = self.resolve_expr(init);
            if (!self.new_payload_is_reference_class(payload_ty)
                && tref_get_kind(payload_ty) != ty_ARRAY()
                && init_ty != null
                && !self.types_compatible(payload_ty, init_ty)) {
                self.error_mismatch("new " + expr_get_name(e), payload_ty, init_ty);
            }
            arg_count = arg_count + 1;
            arg = stmt_get_next(arg);
        }

        if (!self.new_payload_is_reference_class(payload_ty)
            && tref_get_kind(payload_ty) != ty_ARRAY()
            && aggregate_init == null
            && arg_count > 1) {
            self.report_error_help(diag_code_sema_no_overload(),
                                   expr_loc_ptr(e),
                                   "new scalar/pointer initializer accepts at most one value",
                                   "pass a single initializer, or use a class constructor / struct `{...}` init");
        }

        if (self.new_payload_is_reference_class(payload_ty)
            && aggregate_init == null
            && (expr_get_op(e) & new_expr_has_paren_init()) != 0) {
            let callee = expr_alloc(ex_IDENT());
            expr_set_name(callee, tref_get_name(payload_ty));
            let call = expr_alloc(ex_CALL());
            expr_set_lhs(call, callee);
            expr_set_args(call, expr_get_args(e));
            let class_name = tref_get_name(payload_ty);
            let ctor_result = self.resolve_class_constructor_call(call,
                                                                  callee,
                                                                  class_name,
                                                                  policy_generic_call_args(class_name.clone()));
            if (ctor_result == null) {
                self.report_error_help(diag_code_sema_no_overload(),
                                        expr_loc_ptr(e),
                                        "new " + class_name + "(...) requires a matching constructor",
                                        "add a `new(...)` method on '" + class_name + "', or pass arguments that match an existing constructor");
            } else {
                expr_set_semantic(e,
                                  expr_sem_METHOD(),
                                  expr_get_semantic_target(call),
                                  expr_get_semantic_owner(call),
                                  expr_get_semantic_flags(e));
            }
        }

        let result_ty = self.new_result_type(payload_ty);
        expr_set_ty(e, result_ty);
        return result_ty;
    }

    fn resolve_delete_expr(self, e: rawptr) -> rawptr {
        let delete_loc = expr_loc_ptr(e);
        let allocator = expr_get_rhs(e);
        if (allocator != null) { self.resolve_expr(allocator); }
        let operand = expr_get_lhs(e);
        let operand_ty = self.resolve_expr(operand);
        let local = self.expr_root_local_entry(operand);
        var may_release_region: bool = true;
        if (operand_ty == null) {
            self.report_error_help(diag_code_sema_generic(),
                                   delete_loc,
                                   "delete requires a pointer expression",
                                   "delete a `*`/`rawptr`/owned handle, not a value or missing operand");
        } else {
            let state = self.expr_alloc_state(operand);
            if (state == sema_alloc_state_borrowed_immutable()
                || state == sema_alloc_state_borrowed_mutable()) {
                self.report_error_help(diag_code_v_borrow_invalidation(),
                                        delete_loc,
                                        "delete cannot release borrowed storage",
                                        "delete the owning handle, not an `&`/`&mut` view");
                may_release_region = false;
            }
            let kind = tref_get_kind(operand_ty);
            if (kind != ty_PTR() && kind != ty_RAWPTR() && kind != ty_CLASS()) {
                self.report_error_help(diag_code_sema_generic(),
                                        delete_loc,
                                        "delete requires an owned pointer/reference value",
                                        "delete an owned pointer/handle, or drop the `delete` if the value is not heap storage");
            }
            let explicit_payload = expr_get_captures(e);
            if (explicit_payload != null && kind == ty_PTR()) {
                let pointee = tref_pointee(operand_ty);
                if (pointee != null && !self.types_compatible(explicit_payload, pointee)) {
                    self.error_mismatch_at("delete payload", explicit_payload, pointee, delete_loc);
                }
            }
        }
        if (local != null && may_release_region) {
            let root = sym_region_root(local);
            if (root != null) {
                if (sym_get_shared_borrows(root) > 0
                    || sym_get_mutable_borrows(root) > 0) {
                    self.report_error_coded(diag_code_v_borrow_invalidation(),
                                            delete_loc,
                                            "cannot delete a pointer region while it is borrowed");
                    may_release_region = false;
                }
            }
            if (root != null && may_release_region) {
                let root_state = sym_get_alloc_state(root);
                if (root_state != sema_alloc_state_empty()
                    && root_state != sema_alloc_state_dead()) {
                    sym_set_alloc_state(root, sema_alloc_state_dead());
                }
            }
            if (may_release_region) { sym_set_alloc_state(local, sema_alloc_state_dead()); }
        }
        let out = tref_create_kind(ty_VOID());
        expr_set_ty(e, out);
        return out;
    }

    /// Returns a `TypeRef*`-typed rawptr; also writes the resolved
    /// type back into `expr.ty` so codegen can re-read it later.
    public fn resolve_expr(self, ep: rawptr) -> rawptr {
        if (ep == null) {
            return tref_create_kind(ty_VOID());
        }
        if (self.too_many_errors()) {
            return tref_create_kind(ty_I32());
        }
        sema_stamp_loc_from_expr(ep);
        let k = expr_get_kind(ep);
        let cached_ty = expr_get_ty(ep);
        if (cached_ty != null) {
            let cached_kind = tref_get_kind(cached_ty);
            if (self.prepare_hir_facts) {
                if (k != ex_IDENT()
                    && k != ex_CALL()
                    && k != ex_MEMBER()
                    && k != ex_INDEX()
                    && k != ex_ASSIGN()
                    && k != ex_DELETE()
                    && k != ex_ADDR_OF()
                    && k != ex_DEREF()
                    && k != ex_CAST()
                    && k != ex_COMPTIME()
                    && k != ex_UNARY()
                    && k != ex_MATCH_EXPR()) {
                    return cached_ty;
                }
                if (expr_get_semantic_kind(ep) != expr_sem_NONE()
                    && k != ex_ASSIGN()
                    && k != ex_DELETE()
                    && k != ex_INDEX()
                    && k != ex_ADDR_OF()
                    && k != ex_DEREF()
                    && k != ex_CAST()
                    && k != ex_COMPTIME()
                    && k != ex_UNARY()) {
                    return cached_ty;
                }
            } else if (k != ex_ASSIGN()
                && k != ex_DELETE()
                && k != ex_INDEX()
                && k != ex_ADDR_OF()
                && k != ex_DEREF()
                && k != ex_CAST()
                && k != ex_COMPTIME()
                && k != ex_UNARY()
                && (cached_kind != ty_RAWPTR()
                    || (k != ex_IDENT()
                        && k != ex_CALL()
                        && k != ex_MEMBER()
                        && k != ex_INDEX()
                        && k != ex_INT_LIT()
                        && k != ex_MATCH_EXPR()))) {
                return cached_ty;
            }
        }
        if (k == ex_INT_LIT()) {
            if (expr_get_ty(ep) == null) {
                let lx = expr_get_str_val(ep);
                if (string_contains(lx, ".")) {
                    expr_set_ty(ep, tref_create_kind(ty_F64()));
                } else {
                    let suf = infer_int_suffix(lx);
                    if (suf != 0) {
                        expr_set_ty(ep, tref_create_kind(suf));
                    } else if (sema_int_literal_fits_type_kind(expr_get_int_val(ep), ty_I32())) {
                        expr_set_ty(ep, tref_create_kind(ty_I32()));
                    } else {
                        expr_set_ty(ep, tref_create_kind(ty_I64()));
                    }
                }
            }
            return expr_get_ty(ep);
        }
        if (k == ex_STR_LIT()) {
            expr_set_ty(ep, tref_create_kind(ty_STRING()));
            return expr_get_ty(ep);
        }
        if (k == ex_BOOL_LIT()) {
            expr_set_ty(ep, tref_create_kind(ty_BOOL()));
            return expr_get_ty(ep);
        }
        if (k == ex_NULL_LIT()) {
            expr_set_ty(ep, tref_create_kind(ty_RAWPTR()));
            return expr_get_ty(ep);
        }
        if (k == ex_CHAR_LIT()) {
            expr_set_ty(ep, tref_create_kind(ty_CHAR()));
            return expr_get_ty(ep);
        }
        if (k == ex_FSTRING()) {
            // Walk the lit/expr stmt-cell chain so each interpolation
            // payload picks up its own ty. Codegen uses that ty to decide
            // whether to call `int_to_string` before handing the value to
            // `vyx_concat` — without this resolve sweep the inner exprs
            // stay typeless and the concat path silently degrades.
            var fcell = expr_get_args(ep);
            while (fcell != null) {
                let fpayload = stmt_get_init(fcell);
                if (fpayload != null) { self.resolve_expr(fpayload); }
                fcell = stmt_get_next(fcell);
            }
            expr_set_ty(ep, tref_create_kind(ty_STRING()));
            return expr_get_ty(ep);
        }
        if (k == ex_TERNARY()) {
            self.resolve_expr(expr_get_lhs(ep));
            let then_ty = self.resolve_expr(expr_get_rhs(ep));
            self.resolve_expr(expr_get_args(ep));
            if (then_ty != null) {
                expr_set_ty(ep, then_ty);
            } else {
                expr_set_ty(ep, tref_create_kind(ty_I32()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_IF_EXPR()) {
            let ct = self.resolve_expr(expr_get_lhs(ep));
            if (!type_is_boolish(ct)) {
                self.error_mismatch("if expr cond", tref_create_kind(ty_BOOL()), ct);
            }
            let then_blk = expr_get_rhs(ep);
            self.resolve_stmt(then_blk);
            var then_ty = expr_get_ty(sema_last_expr_in_block(then_blk));
            let else_part = expr_get_args(ep);
            var else_ty: rawptr = null;
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                else_ty = self.resolve_expr(else_part);
            } else if (else_part != null) {
                self.resolve_stmt(else_part);
                else_ty = expr_get_ty(sema_last_expr_in_block(else_part));
            }
            if (then_ty != null) {
                expr_set_ty(ep, then_ty);
            } else if (else_ty != null) {
                expr_set_ty(ep, else_ty);
            } else {
                expr_set_ty(ep, tref_create_kind(ty_I32()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_MATCH_EXPR()) {
            let scrut_ty = self.resolve_expr(expr_get_lhs(ep));
            var result_ty: rawptr = null;
            var arm = expr_get_args(ep);
            var arm_count: i32 = 0;
            while (arm != null && !self.too_many_errors()) {
                arm_count = arm_count + 1;
                let saved_head = self.cur_locals;
                let saved_count = self.locals_count;
                let pat = stmt_get_init(arm);
                if (pat != null && !self.resolve_match_pattern(pat, scrut_ty)) {
                    self.resolve_expr(pat);
                }
                let guard = stmt_get_cond(arm);
                if (guard != null) {
                    let guard_ty = self.resolve_expr(guard);
                    if (!type_is_boolish(guard_ty)) {
                        self.error_mismatch("match expression guard",
                                            tref_create_kind(ty_BOOL()), guard_ty);
                    }
                }
                let body = stmt_get_body(arm);
                self.resolve_stmt(body);
                var body_expr: rawptr = null;
                if (body != null && stmt_get_kind(body) == st_BLOCK()) {
                    body_expr = sema_last_expr_in_block(body);
                } else if (body != null
                           && (stmt_get_kind(body) == st_EXPR()
                               || stmt_get_kind(body) == st_RETURN())) {
                    body_expr = stmt_get_init(body);
                }
                let body_ty = if (body_expr != null) { expr_get_ty(body_expr) } else { null };
                if (body_ty != null) {
                    if (result_ty == null) {
                        result_ty = body_ty;
                    } else if (!self.types_compatible(result_ty, body_ty)) {
                        self.error_mismatch("match expression arm", result_ty, body_ty);
                    }
                } else {
                    // A value match must have a value in every arm.  Treat a
                    // statement-only block as a type error instead of
                    // silently manufacturing an i32 result below.
                    self.error_mismatch("match expression arm",
                                        tref_create_kind(ty_I32()),
                                        null);
                }
                self.cur_locals = saved_head;
                self.locals_count = saved_count;
                arm = stmt_get_next(arm);
            }
            if (arm_count == 0) {
                self.error_mismatch("match expression arm",
                                    tref_create_kind(ty_I32()),
                                    null);
            }
            if (result_ty == null) { result_ty = tref_create_kind(ty_I32()); }
            expr_set_ty(ep, result_ty);
            return result_ty;
        }
        if (k == ex_CAST()) {
            self.resolve_expr(expr_get_lhs(ep));
            // Parser stamps the target TypeRef into expr_get_ty(ep). Echo it
            // back via expr_set_ty so the result carries an explicit type;
            // legality is intentionally not checked at the bootstrap tier
            // (codegen picks sext/zext/trunc/bitcast/inttoptr/ptrtoint
            // based on source vs target kind).
            let target_ty = expr_get_ty(ep);
            if (target_ty == null) {
                expr_set_ty(ep, tref_create_kind(ty_I32()));
            } else {
                expr_set_ty(ep, target_ty);
            }
            return expr_get_ty(ep);
        }
        if (k == ex_NEW()) {
            return self.resolve_new_expr(ep);
        }
        if (k == ex_DELETE()) {
            return self.resolve_delete_expr(ep);
        }
        if (k == ex_DEREF()) {
            let inner_expr = expr_get_lhs(ep);
            let inner_ty = self.resolve_expr(inner_expr);
            let root = self.expr_root_local_entry(inner_expr);
            if (root != null) {
                let state = sym_pointer_unusable_state(root);
                if (state == sema_alloc_state_empty()) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(ep),
                                            "cannot dereference an empty pointer handle; allocate or bind valid storage first",
                                            "initialize the handle with `new` or a valid pointer before dereferencing");
                } else if (state == sema_alloc_state_dead()) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(ep),
                                            "cannot dereference a dangling pointer handle; its region was deleted",
                                            "stop using the handle after `delete`, or rebind it to a new allocation");
                } else {
                    let region = sym_region_root(root);
                    if (region != null
                        && sym_get_mutable_borrows(region) > 0
                        && sym_get_alloc_state(root) != sema_alloc_state_borrowed_mutable()) {
                        self.report_error_help(diag_code_v_borrow_invalidation(),
                                                expr_loc_ptr(ep),
                                                "cannot access a pointer region through this handle while it is mutably borrowed",
                                                "end the `&mut` borrow before dereferencing this handle");
                    }
                }
            }
            var elem: rawptr = null;
            if (inner_ty != null) {
                let ik = tref_get_kind(inner_ty);
                if (ik == ty_ARRAY()) {
                    elem = tref_array_elem(inner_ty);
                } else if (ik == ty_PTR() || ik == ty_REF() || ik == ty_MUTREF()) {
                    elem = tref_pointee(inner_ty);
                }
            }
            if (elem != null) {
                expr_set_ty(ep, elem);
            } else {
                expr_set_ty(ep, tref_create_kind(ty_I32()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_AWAIT()) {
            let at = self.resolve_expr(expr_get_lhs(ep));
            let rt = sema_async_result_type_ref(at);
            if (rt != null) {
                expr_set_ty(ep, rt);
            } else {
                expr_set_ty(ep, at);
            }
            return expr_get_ty(ep);
        }
        if (k == ex_INLINE_ASM()) {
            var acell = expr_get_args(ep);
            while (acell != null) {
                self.resolve_expr(stmt_get_init(acell));
                acell = stmt_get_next(acell);
            }
            let constraints = expr_get_name(ep);
            if (constraints.len > 0 && constraints.charAt(0) == 61) {
                expr_set_ty(ep, tref_create_kind(ty_I64()));
            } else {
                expr_set_ty(ep, tref_create_kind(ty_VOID()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_FAIL()) {
            let payload = expr_get_lhs(ep);
            if (payload != null) { self.resolve_expr(payload); }
            if (self.cur_ret_ty != null) {
                expr_set_ty(ep, self.cur_ret_ty);
            } else {
                expr_set_ty(ep, tref_create_kind(ty_I32()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_IDENT()) {
            let name = expr_get_name(ep);
            let lent = sym_lookup(self.cur_locals, name);
            if (lent != null) {
                if (self.local_is_moved(lent)) {
                    self.report_error_coded(diag_code_v_move_001(),
                                            expr_loc_ptr(ep),
                                            "use of moved value '" + name
                                                + "'; ownership was transferred");
                } else if (self.place_depth == 0 && self.local_has_moved_fields(lent)) {
                    self.report_error_coded(diag_code_v_move_001(),
                                            expr_loc_ptr(ep),
                                            "use of moved value '" + name
                                                + "'; a field was moved and not reinitialized");
                }
                expr_set_ty(ep, sym_get_ty(lent));
                expr_set_semantic(ep, expr_sem_LOCAL(), lent, null, 0);
                return expr_get_ty(ep);
            }
            let variant_owner_for_ident = self.find_variant_owner_decl(name);
            if (variant_owner_for_ident != null) {
                let variant_decl_for_ident = self.find_enum_variant_decl(variant_owner_for_ident, name);
                expr_set_ty(ep, tref_create_class(decl_get_name(variant_owner_for_ident)));
                expr_set_semantic(ep,
                                  expr_sem_VARIANT(),
                                  variant_decl_for_ident,
                                  variant_owner_for_ident,
                                  0);
                return expr_get_ty(ep);
            }
            var fn_lookup_name = name.clone();
            var fn_lookup_module: string = "";
            let fn_alias_target = self.sema_use_alias_target(name.clone());
            let fn_alias_name = self.sema_resolve_use_alias_func_name(name.clone());
            if (fn_alias_name.len > 0) {
                fn_lookup_name = generic_call_base(fn_alias_name.clone());
                fn_lookup_module = module_parent_path(generic_call_base(fn_alias_target.clone()));
                expr_set_name(ep, fn_lookup_name.clone());
            }
            var fent: rawptr = null;
            if (fn_lookup_module.len > 0) {
                fent = self.sema_find_func_symbol_in_module(fn_lookup_name.clone(), fn_lookup_module.clone());
            }
            if (fent == null) {
                fent = self.sema_find_func_symbol(fn_lookup_name.clone());
            }
            if (fent != null) {
                let fdecl = sym_get_decl(fent);
                if (fdecl != null && decl_get_kind(fdecl) == de_CONST()) {
                    var cty = decl_get_ty(fdecl);
                    if (cty == null) { cty = sym_get_ty(fent); }
                    if (cty == null) { cty = tref_create_kind(ty_I32()); }
                    expr_set_ty(ep, cty);
                    expr_set_semantic(ep, expr_sem_CONST(), fdecl, null, 0);
                    return expr_get_ty(ep);
                }
                if (fdecl != null && decl_get_kind(fdecl) == de_GLOBAL_VAR()) {
                    var gty = decl_get_ty(fdecl);
                    if (gty == null) { gty = sym_get_ty(fent); }
                    if (gty == null) { gty = tref_create_kind(ty_I32()); }
                    expr_set_ty(ep, gty);
                    expr_set_semantic(ep, expr_sem_GLOBAL(), fdecl, null, 0);
                    return expr_get_ty(ep);
                }
                if (fdecl != null && decl_get_kind(fdecl) == de_FN()) {
                    self.sema_resolve_decl_body_if_needed(fdecl);
                }
                expr_set_ty(ep, tref_fn_from_decl(fdecl));
                expr_set_semantic(ep, expr_sem_DIRECT_FN(), fdecl, null, 0);
                return expr_get_ty(ep);
            }
            let name_generic_args = policy_generic_call_args(name.clone());
            let expanded_type_name = self.sema_expand_short_name(name.clone(), true);
            if (g_sema_name_ambiguous) {
                expr_set_ty(ep, tref_create_kind(ty_RAWPTR()));
                expr_clear_semantic(ep);
                return expr_get_ty(ep);
            }
            if (expanded_type_name.len > 0 && string_contains(expanded_type_name, ".")) {
                self.sema_load_qualified_type_symbol(expanded_type_name.clone());
            } else if (string_contains(name, ".")) {
                self.sema_load_qualified_type_symbol(name.clone());
            }
            var aliased_type_name = self.sema_resolve_use_alias_type_name(name.clone());
            if (aliased_type_name.len == 0 && expanded_type_name.len > 0
                && self.sema_lookup_class_canonical(expanded_type_name.clone()) != null) {
                aliased_type_name = expanded_type_name;
            }
            if (aliased_type_name.len > 0) {
                var aliased_decl: rawptr = null;
                var aliased_ent = self.sema_lookup_class_canonical(aliased_type_name.clone());
                let aliased_base = generic_call_base(aliased_type_name.clone());
                if (aliased_ent == null && aliased_base.len > 0) {
                    aliased_ent = self.sema_lookup_class_canonical(aliased_base);
                }
                if (aliased_ent != null) { aliased_decl = sym_get_decl(aliased_ent); }
                var class_text = aliased_type_name;
                if (aliased_decl != null) {
                    let canon = self.sema_type_canonical_name(aliased_decl);
                    if (canon.len > 0) { class_text = canon; }
                }
                if (name_generic_args.len > 0) {
                    expr_set_ty(ep, tref_create_class(generic_call_base(class_text.clone()) + "::<" + name_generic_args + ">"));
                } else {
                    expr_set_ty(ep, tref_create_class(class_text));
                }
                expr_set_semantic(ep, expr_sem_CLASS(), aliased_decl, null, 0);
                return expr_get_ty(ep);
            }
            var class_lookup = name.clone();
            if (expanded_type_name.len > 0) { class_lookup = expanded_type_name; }
            var cent = self.sema_find_latest_class_symbol(class_lookup.clone());
            if (cent == null && name_generic_args.len > 0) {
                cent = self.sema_find_latest_class_symbol(generic_call_base(class_lookup.clone()));
            }
            if (cent == null && !is_host_builtin(name)) {
                let loaded_ident = self.sema_lazy_load_pending_until_symbol(name);
                if (loaded_ident) {
                    let fent2 = self.sema_find_func_symbol(name);
                    if (fent2 != null) {
                        let fdecl2 = sym_get_decl(fent2);
                        if (fdecl2 != null && decl_get_kind(fdecl2) == de_CONST()) {
                            var cty2 = decl_get_ty(fdecl2);
                            if (cty2 == null) { cty2 = sym_get_ty(fent2); }
                            if (cty2 == null) { cty2 = tref_create_kind(ty_I32()); }
                            expr_set_ty(ep, cty2);
                            expr_set_semantic(ep, expr_sem_CONST(), fdecl2, null, 0);
                            return expr_get_ty(ep);
                        }
                        if (fdecl2 != null && decl_get_kind(fdecl2) == de_GLOBAL_VAR()) {
                            var gty2 = decl_get_ty(fdecl2);
                            if (gty2 == null) { gty2 = sym_get_ty(fent2); }
                            if (gty2 == null) { gty2 = tref_create_kind(ty_I32()); }
                            expr_set_ty(ep, gty2);
                            expr_set_semantic(ep, expr_sem_GLOBAL(), fdecl2, null, 0);
                            return expr_get_ty(ep);
                        }
                        if (fdecl2 != null) {
                            if (decl_get_kind(fdecl2) == de_FN()) {
                                self.sema_resolve_decl_body_if_needed(fdecl2);
                            }
                            expr_set_ty(ep, tref_fn_from_decl(fdecl2));
                            expr_set_semantic(ep, expr_sem_DIRECT_FN(), fdecl2, null, 0);
                            return expr_get_ty(ep);
                        }
                    }
                    cent = self.sema_find_latest_class_symbol(class_lookup.clone());
                    if (cent == null && name_generic_args.len > 0) {
                        cent = self.sema_find_latest_class_symbol(generic_call_base(class_lookup.clone()));
                    }
                }
            }
            if (cent != null) {
                var class_text = self.sema_type_canonical_name(sym_get_decl(cent));
                if (class_text.len == 0) { class_text = sym_get_name(cent); }
                if (name_generic_args.len > 0) {
                    expr_set_ty(ep, tref_create_class(generic_call_base(class_text.clone()) + "::<" + name_generic_args + ">"));
                } else {
                    expr_set_ty(ep, tref_create_class(class_text));
                }
                expr_set_semantic(ep, expr_sem_CLASS(), sym_get_decl(cent), null, 0);
                return expr_get_ty(ep);
            }
            if (is_host_builtin(name)) {
                // Bare reference to a host builtin — treat as rawptr
                // fn-ref; actual return type is produced by resolve_call.
                expr_set_ty(ep, tref_create_kind(ty_RAWPTR()));
                expr_set_semantic(ep, expr_sem_BUILTIN(), null, null, 0);
                return expr_get_ty(ep);
            }
            if (self.sema_is_namespace_prefix(name.clone())
                || (expanded_type_name.len > 0
                    && self.sema_is_namespace_prefix(expanded_type_name.clone()))) {
                expr_set_ty(ep, tref_create_kind(ty_RAWPTR()));
                expr_set_semantic(ep, expr_sem_CLASS(), null, null, 0);
                return expr_get_ty(ep);
            }
            if (!self.in_imported_scope
                && name != "_"
                && name != "Self"
                && !generic_list_contains(self.cur_generic_params, name)) {
                self.report_error_help(diag_code_sema_undefined(),
                                        expr_loc_ptr(ep),
                                        "unknown name '" + name + "'",
                                        "check spelling, add a `use` import, or declare a local/function/type with this name");
            }
            expr_set_ty(ep, tref_create_kind(ty_RAWPTR()));
            expr_clear_semantic(ep);
            return expr_get_ty(ep);
        }
        if (k == ex_BIN()) {
            let lhs_e = expr_get_lhs(ep);
            let rhs_e = expr_get_rhs(ep);
            let op = expr_get_op(ep);
            var lt = self.resolve_expr(lhs_e);
            var rt: rawptr = null;
            if (op == tk_PIPEARROW()
                && rhs_e != null
                && expr_get_kind(rhs_e) == ex_CALL()) {
                let saved_pipe_call = self.pipe_call_context;
                let saved_pipe_prefix = self.pipe_prefix_expr;
                self.pipe_call_context = rhs_e;
                self.pipe_prefix_expr = lhs_e;
                rt = self.resolve_expr(rhs_e);
                self.pipe_call_context = saved_pipe_call;
                self.pipe_prefix_expr = saved_pipe_prefix;
            } else {
                rt = self.resolve_expr(rhs_e);
            }
            if (sema_binop_contextualizes_float_literal(op)) {
                if (type_ref_float_bits(lt) == 32) {
                    let new_rt = sema_contextualize_float_literal(rhs_e, lt);
                    if (new_rt != null) { rt = new_rt; }
                }
                if (type_ref_float_bits(rt) == 32) {
                    let new_lt = sema_contextualize_float_literal(lhs_e, rt);
                    if (new_lt != null) { lt = new_lt; }
                }
            }
            expr_set_ty(ep, self.resolve_bin_op(op, lt, rt));
            return expr_get_ty(ep);
        }
        if (k == ex_UNARY()) {
            let lt = self.resolve_expr(expr_get_lhs(ep));
            let op = expr_get_op(ep);
            if (op == unary_op_own()) {
                let source = expr_get_lhs(ep);
                let root = self.expr_root_local_entry(source);
                if (root == null) {
                    self.report_error_help(diag_code_v_move_001(),
                                            expr_loc_ptr(ep),
                                            "'own' requires a movable local handle/value",
                                            "apply `own` to a local, not a temporary or field projection");
                } else {
                    let state = sym_get_alloc_state(root);
                    if (state == sema_alloc_state_empty()) {
                        self.report_error_help(diag_code_v_move_001(),
                                                expr_loc_ptr(ep),
                                                "cannot move an empty pointer handle",
                                                "allocate or bind storage before using `own`");
                    } else if (state == sema_alloc_state_dead()) {
                        self.report_error_help(diag_code_v_move_001(),
                                                expr_loc_ptr(ep),
                                                "cannot move a dangling pointer handle",
                                                "rebind the handle after `delete` before moving it");
                    } else if (state == sema_alloc_state_borrowed_immutable()
                        || state == sema_alloc_state_borrowed_mutable()) {
                        self.report_error_help(diag_code_v_move_001(),
                                                expr_loc_ptr(ep),
                                                "cannot move ownership from a borrowed handle",
                                                "move the owning handle, not an `&`/`&mut` view");
                    } else if (state == sema_alloc_state_compat_alias()) {
                        self.report_error_help(diag_code_v_move_001(),
                                                expr_loc_ptr(ep),
                                                "cannot move ownership from a compatibility alias; move the owning handle instead",
                                                "use `own` on the original owning local");
                    } else {
                        let region = sym_region_root(root);
                        if (region != null
                            && (sym_get_shared_borrows(region) > 0
                                || sym_get_mutable_borrows(region) > 0)) {
                            self.report_error_help(diag_code_v_move_001(),
                                                    expr_loc_ptr(ep),
                                                    "cannot move pointer ownership while its region is borrowed",
                                                    "end all borrows of this region before moving");
                        } else {
                            self.mark_local_moved(root, sym_get_name(root));
                        }
                    }
                }
                expr_set_ty(ep, lt);
                return expr_get_ty(ep);
            }
            if (op == tk_QUESTION()) {
                let ok_ty = sema_result_ok_type_ref(lt);
                if (ok_ty != null) {
                    expr_set_ty(ep, ok_ty);
                    return expr_get_ty(ep);
                }
                let inner_ty = sema_option_inner_type_ref(lt);
                if (inner_ty != null) {
                    expr_set_ty(ep, inner_ty);
                    return expr_get_ty(ep);
                }
                expr_set_ty(ep, lt);
                return expr_get_ty(ep);
            }
            if (op == tk_NOT()) {
                expr_set_ty(ep, tref_create_kind(ty_BOOL()));
                return expr_get_ty(ep);
            }
            if (op == tk_MINUS()) {
                expr_set_ty(ep, lt);
                return expr_get_ty(ep);
            }
            expr_set_ty(ep, lt);
            return expr_get_ty(ep);
        }
        if (k == ex_CALL()) {
            expr_set_ty(ep, self.resolve_call(ep));
            sema_try_fold_comptime_call(ep);
            return expr_get_ty(ep);
        }
        if (k == ex_MEMBER()) {
            expr_set_ty(ep, self.resolve_member(ep));
            return expr_get_ty(ep);
        }
        if (k == ex_INDEX()) {
            let lhs_expr = expr_get_lhs(ep);
            var lhs_ty = self.resolve_expr(lhs_expr);
            let index_expr = expr_get_rhs(ep);
            self.resolve_expr(index_expr);
            let root = self.expr_root_local_entry(lhs_expr);
            if (root != null) {
                let state = sym_pointer_unusable_state(root);
                if (state == sema_alloc_state_empty()) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(ep),
                                            "cannot index an empty pointer handle; allocate or bind valid storage first",
                                            "initialize the handle with `new` or a valid pointer before indexing");
                } else if (state == sema_alloc_state_dead()) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(ep),
                                            "cannot index a dangling pointer handle; its region was deleted",
                                            "stop using the handle after `delete`, or rebind it to a new allocation");
                } else {
                    let region = sym_region_root(root);
                    if (region != null
                        && sym_get_mutable_borrows(region) > 0
                        && sym_get_alloc_state(root) != sema_alloc_state_borrowed_mutable()) {
                        self.report_error_help(diag_code_v_borrow_invalidation(),
                                                expr_loc_ptr(ep),
                                                "cannot access a pointer region through this handle while it is mutably borrowed",
                                                "end the `&mut` borrow before indexing through this handle");
                    }
                }
            }
            // Arrays index to their element. Typed pointers and references
            // use the same element rule; indexing never materializes an
            // unallocated pointer.
            if (lhs_ty != null) {
                let lhs_kind = tref_get_kind(lhs_ty);
                var elem: rawptr = null;
                let borrowed_array_ty = self.pointer_view_array_type(lhs_expr);
                if (borrowed_array_ty != null) {
                    let borrowed_size_expr = tref_array_size_expr(borrowed_array_ty);
                    if (index_expr != null
                        && borrowed_size_expr != null
                        && sema_const_i64_known(index_expr)
                        && sema_const_i64_known(borrowed_size_expr)) {
                        let borrowed_index = sema_const_i64_value(index_expr);
                        let borrowed_size = sema_const_i64_value(borrowed_size_expr);
                        if (borrowed_index < 0 || borrowed_index >= borrowed_size) {
                            self.report_error_help(diag_code_sema_generic(),
                                                    expr_loc_ptr(index_expr),
                                                    "array/pointer index " + borrowed_index.toString()
                                                        + " is out of bounds for length " + borrowed_size.toString(),
                                                    "use an index in 0.." + borrowed_size.toString());
                        }
                    }
                }
                if (lhs_kind == ty_ARRAY()) {
                    let size_expr = tref_array_size_expr(lhs_ty);
                    if (index_expr != null
                        && size_expr != null
                        && sema_const_i64_known(index_expr)
                        && sema_const_i64_known(size_expr)) {
                        let index_value = sema_const_i64_value(index_expr);
                        let array_size = sema_const_i64_value(size_expr);
                        if (index_value < 0 || index_value >= array_size) {
                            self.report_error_help(diag_code_sema_generic(),
                                                    expr_loc_ptr(index_expr),
                                                    "array/pointer index " + index_value.toString()
                                                        + " is out of bounds for length " + array_size.toString(),
                                                    "use an index in 0.." + array_size.toString());
                        }
                    }
                    elem = tref_array_elem(lhs_ty);
                } else if (lhs_kind == ty_PTR()
                    || lhs_kind == ty_REF()
                    || lhs_kind == ty_MUTREF()) {
                    // A direct borrow of an array is an array view: indexing
                    // consumes the outer array dimension. An ordinary
                    // pointer-to-array still indexes to its array pointee.
                    let pointee = tref_pointee(lhs_ty);
                    if ((lhs_kind == ty_REF() || lhs_kind == ty_MUTREF())
                        && pointee != null
                        && tref_get_kind(pointee) == ty_ARRAY()) {
                        elem = tref_array_elem(pointee);
                    } else {
                        elem = pointee;
                    }
                }
                if (elem != null) {
                    expr_set_ty(ep, elem);
                    return expr_get_ty(ep);
                }
            }
            expr_set_ty(ep, tref_create_kind(ty_I32()));
            return expr_get_ty(ep);
        }
        if (k == ex_ASSIGN()) {
            expr_set_ty(ep, self.resolve_assign(ep));
            return expr_get_ty(ep);
        }
        if (k == ex_ADDR_OF()) {
            let lhs = expr_get_lhs(ep);
            if (lhs == null) {
                self.report_error_help(diag_code_sema_generic(),
                                       expr_loc_ptr(ep),
                                       "&-of operand missing",
                                       "write `&expr` / `&mut expr` with a local, field, or index on the right");
            } else {
                let lhs_ty = self.resolve_expr(lhs);
                let op = expr_get_op(ep);
                let source_local = self.expr_root_local_entry(lhs);
                let region_root = sym_region_root(source_local);
                if (region_root != null) {
                    let shared_count = sym_get_shared_borrows(region_root);
                    let mutable_count = sym_get_mutable_borrows(region_root);
                    let source_state = sym_get_alloc_state(source_local);
                    if (op == 1) {
                        if (shared_count > 0
                            || (mutable_count > 0
                                && source_state != sema_alloc_state_borrowed_mutable())) {
                            self.report_error_coded(diag_code_v_borrow_invalidation(),
                                                    expr_loc_ptr(ep),
                                                    "cannot create mutable borrow while the pointer region is already borrowed");
                        }
                    } else if (mutable_count > 0
                        && source_state != sema_alloc_state_borrowed_mutable()) {
                        self.report_error_coded(diag_code_v_borrow_invalidation(),
                                                expr_loc_ptr(ep),
                                                "cannot create shared borrow while the pointer region is mutably borrowed");
                    }
                }
                if (op == 1) {
                    expr_set_ty(ep, tref_alloc_ptr_like(ty_MUTREF(), lhs_ty));
                } else {
                    expr_set_ty(ep, tref_alloc_ptr_like(ty_REF(), lhs_ty));
                }
                return expr_get_ty(ep);
            }
            let op = expr_get_op(ep);
            if (op == 1) {
                expr_set_ty(ep, tref_create_kind(ty_MUTREF()));
            } else {
                expr_set_ty(ep, tref_create_kind(ty_REF()));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_STRUCT_INIT()) {
            // `ClassName { f1: e1, f2: e2 }` literal. The leading IDENT is
            // stored in `expr.name`; field-initializer cells live in `args`
            // as a chain of ST_EXPR cells (cell.name = field name,
            // cell.init = value Expr, cell.next = next cell).
            var cname_full = expr_get_name(ep);
            let rewritten_init = self.sema_rewrite_use_alias_path(cname_full.clone());
            if (rewritten_init != cname_full) {
                expr_set_name(ep, rewritten_init);
                cname_full = rewritten_init;
            }
            let cname = generic_call_base(cname_full.clone());
            let cargs = policy_generic_call_args(cname_full.clone());
            // Drive resolution of each field-value sub-expression so any
            // identifier references inside survive the local scope walk.
            // Positional (unnamed) cells mark container list initialization
            // (`Vec<i32>{1, 2, 3}`); the MIR builder desugars it into
            // `with_capacity(n)` + one `push` per cell.
            var cell = expr_get_args(ep);
            var has_positional_cell = false;
            while (cell != null) {
                let v = stmt_get_init(cell);
                if (v != null) {
                    self.resolve_expr(v);
                }
                if (stmt_get_name(cell).len == 0) { has_positional_cell = true; }
                cell = stmt_get_next(cell);
            }
            var cent = self.sema_find_latest_class_symbol(cname);
            if (cent == null) {
                self.sema_materialize_named_type(cname.clone());
                cent = self.sema_find_latest_class_symbol(cname);
            }
            if (has_positional_cell && cent != null) {
                // Positional cells on a container-looking class (it has a
                // `push` member) require a static `from_array(items: *T,
                // n: i64)` — the HIR builder rewrites the literal into
                // `Type::from_array([e1..en], n)`.  Plain classes without
                // `push` keep the pre-existing positional-field-init path,
                // so only flag the container shape here.
                let list_cd = sym_get_decl(cent);
                let push_member = self.class_decl_member_deep(list_cd, "push", 0);
                if (push_member != null) {
                    let from_array_member = self.class_decl_member_deep(list_cd, "from_array", 0);
                    if (from_array_member == null) {
                        self.report_error_help(diag_code_sema_generic(),
                                                expr_loc_ptr(ep),
                                                "class '" + cname + "' does not support list initialization '{a, b, c}'",
                                                "add a static `from_array(items: *T, n: i64) -> " + cname + "` method (see std Vec), or write named fields");
                    }
                }
            }
            if (cent == null) {
                expr_set_ty(ep, tref_create_class(cname));
                return expr_get_ty(ep);
            }
            self.check_where_constraints(sym_get_decl(cent), cargs, expr_get_args(ep), cname);
            vyx_lsp_bind_target(ep, sym_get_decl(cent));
            self.check_struct_init_fields(ep, cent);
            if (cargs.len > 0) {
                expr_set_ty(ep, tref_create_class(cname_full));
            } else {
                expr_set_ty(ep, tref_create_class(sym_get_name(cent)));
            }
            return expr_get_ty(ep);
        }
        if (k == ex_CLOSURE()) {
            let saved_head = self.cur_locals;
            let saved_count = self.locals_count;
            let saved_ret = self.cur_ret_ty;
            var ret_closure = expr_get_rhs(ep);
            if (ret_closure == null) {
                self.cur_ret_ty = null;
            } else {
                self.cur_ret_ty = ret_closure;
            }

            var cap = expr_get_captures(ep);
            while (cap != null) {
                let cap_name = stmt_get_name(cap);
                let cap_move = stmt_get_init(cap);
                if (cap_move != null) {
                    let cap_ty = self.resolve_expr(cap_move);
                    stmt_set_ty(cap, cap_ty);
                    let cap_decl = decl_alloc(de_FIELD(), cap_name);
                    decl_set_ty(cap_decl, cap_ty);
                    self.cur_locals = sym_push_decl(self.cur_locals,
                                                    cap_name,
                                                    cap_decl);
                    sym_set_ty(self.cur_locals, cap_ty);
                    stmt_set_semantic(cap, expr_sem_LOCAL(), self.cur_locals, 0);
                } else {
                    let cap_source = sym_lookup(saved_head, cap_name);
                    if (cap_source == null) {
                        self.report_error_coded(diag_code_sema_undefined(),
                                                g_sema_cur_loc,
                                                "undefined closure capture '" + cap_name + "'");
                    } else {
                        let cap_ty2 = sym_get_ty(cap_source);
                        stmt_set_ty(cap, cap_ty2);
                        stmt_set_semantic(cap, expr_sem_LOCAL(), cap_source, 0);
                    }
                }
                cap = stmt_get_next(cap);
            }

            var p = expr_get_args(ep);
            while (p != null) {
                let pn = decl_get_name(p);
                let pt = decl_get_ty(p);
                self.cur_locals = sym_push_decl(self.cur_locals, pn, p);
                sym_set_ty(self.cur_locals, pt);
                decl_set_semantic(p, expr_sem_LOCAL(), self.cur_locals, 0);
                p = decl_get_next(p);
            }
            let body = expr_get_lhs(ep);
            if (body != null) {
                self.resolve_stmt(body);
            }
            if (ret_closure == null) {
                let first_ret = sema_first_return_expr(body);
                if (first_ret != null && expr_get_ty(first_ret) != null) {
                    ret_closure = expr_get_ty(first_ret);
                } else {
                    ret_closure = tref_create_kind(ty_VOID());
                }
            }
            var pcount: i64 = 0;
            var pp = expr_get_args(ep);
            while (pp != null) {
                pcount = pcount + 1;
                pp = decl_get_next(pp);
            }
            var pbuf: rawptr = null;
            if (pcount > 0) {
                pbuf = vyx_frontend_alloc((pcount * 8) as u64);
                var pi: i64 = 0;
                pp = expr_get_args(ep);
                while (pp != null) {
                    var cpty = decl_get_ty(pp);
                    if (cpty == null) { cpty = tref_create_kind(ty_I32()); }
                    ast_write_rawptr(ptr_offset(pbuf, (pi * 8) as i32), cpty);
                    pi = pi + 1;
                    pp = decl_get_next(pp);
                }
            }
            expr_set_ty(ep, tref_alloc_fn(tref_alloc_tuple(pbuf, pcount), ret_closure));
            sym_release_scope_borrows(self.cur_locals, saved_head);
            self.cur_locals = saved_head;
            self.locals_count = saved_count;
            self.cur_ret_ty = saved_ret;
            self.retain_expr_capture_borrows(ep);
            return expr_get_ty(ep);
        }
        if (k == ex_COMPTIME()) {
            let inner = expr_get_lhs(ep);
            if (inner != null) {
                self.resolve_expr(inner);
                sema_try_fold_comptime_call(inner);
                if (sema_const_i64_known(inner)) {
                    let folded = sema_const_i64_value(inner);
                    sema_expr_rewrite_int(ep, folded);
                    expr_set_ty(ep, expr_get_ty(inner));
                } else {
                    expr_set_ty(ep, expr_get_ty(inner));
                }
            } else {
                expr_set_ty(ep, tref_create_kind(ty_VOID()));
            }
            return expr_get_ty(ep);
        }

        if (k == ex_ARRAY_LIT()) {
            // Resolve all elements and infer element type from first.
            var elem_ty: rawptr = null;
            var count: i64 = 0;
            let repeat_e = expr_get_captures(ep);
            var cell = expr_get_args(ep);
            while (cell != null) {
                let elem_e = stmt_get_init(cell);
                if (elem_e != null) {
                    self.resolve_expr(elem_e);
                    if (elem_ty == null) {
                        elem_ty = expr_get_ty(elem_e);
                    }
                }
                count = count + 1;
                cell = stmt_get_next(cell);
            }
            if (repeat_e != null) {
                self.resolve_expr(repeat_e);
                if (expr_get_kind(repeat_e) == ex_INT_LIT()) {
                    count = expr_get_int_val(repeat_e);
                }
            }
            if (elem_ty == null) {
                elem_ty = tref_create_kind(ty_I32());
            }
            if (repeat_e != null && expr_get_kind(repeat_e) != ex_INT_LIT()) {
                expr_set_ty(ep, tref_alloc_array_expr(elem_ty, repeat_e));
                return expr_get_ty(ep);
            }
            expr_set_ty(ep, tref_alloc_array(elem_ty, count));
            return expr_get_ty(ep);
        }
        if (k == ex_TUPLE_LIT()) {
            // Resolve all elements, collect their types.
            var count: i64 = 0;
            var cell = expr_get_args(ep);
            while (cell != null) {
                let elem_e = stmt_get_init(cell);
                if (elem_e != null) { self.resolve_expr(elem_e); }
                count = count + 1;
                cell = stmt_get_next(cell);
            }
            // Build element TypeRef array
            var elems_buf: rawptr = null;
            if (count > 0) {
                elems_buf = vyx_frontend_alloc((count * 8) as u64);
                var i: i64 = 0;
                cell = expr_get_args(ep);
                while (cell != null && i < count) {
                    let elem_e = stmt_get_init(cell);
                    var et: rawptr = tref_create_kind(ty_I32());
                    if (elem_e != null) { et = expr_get_ty(elem_e); }
                    if (et == null) { et = tref_create_kind(ty_I32()); }
                    ast_write_rawptr(ptr_offset(elems_buf, (i * 8) as i32), et);
                    i = i + 1;
                    cell = stmt_get_next(cell);
                }
            }
            expr_set_ty(ep, tref_alloc_tuple(elems_buf, count));
            return expr_get_ty(ep);
        }

        expr_set_ty(ep, tref_create_kind(ty_VOID()));
        return expr_get_ty(ep);
    }

    public fn resolve_bin_op(self, op: i32, lt: rawptr, rt: rawptr) -> rawptr {
        let lk = tref_get_kind(lt);
        let rk = tref_get_kind(rt);
        if (op == tk_PLUS()
            && (self.type_is_string_like(lt) || self.type_is_string_like(rt))) {
            self.sema_lazy_load_pending_until_symbol("str_concat");
            if (!self.sema_symbol_known("str_concat")) {
                self.sema_load_module("std.string");
            }
        }

        if (op == tk_PIPEARROW()) {
            return rt;
        }
        if (op == tk_QUESTIONQUESTION()) {
            if (!self.types_compatible(lt, rt)) {
                self.error_mismatch("??", lt, rt);
            }
            return lt;
        }
        if (op == tk_DOTDOT() || op == tk_DOTDOTEQ()) {
            if (type_ref_int_bits(lt) <= 0 || type_ref_int_bits(rt) <= 0) {
                self.error_mismatch("range", tref_create_kind(ty_I64()), lt);
            }
            return tref_create_kind(ty_RANGE());
        }
        let lf_prim = type_ref_is_floatish(lt);
        let rf_prim = type_ref_is_floatish(rt);
        let li_prim = type_kind_is_int(lk);
        let ri_prim = type_kind_is_int(rk);
        if ((lf_prim && (rf_prim || ri_prim)) || (rf_prim && li_prim)) {
            if (op == tk_PLUS() || op == tk_MINUS()
                || op == tk_STAR() || op == tk_SLASH()
                || op == tk_PERCENT()) {
                return numeric_float_result_ty(lt, rt);
            }
            if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()
                || op == tk_EQEQ() || op == tk_NEQ()) {
                return tref_create_kind(ty_BOOL());
            }
        }
        // Typed pointer arithmetic and comparisons (`*T`): mirror the rawptr
        // rules. `ptr + int` / `ptr - int` keep the pointer type (element-
        // scaled at lowering), `int + ptr` is allowed symmetrically, and
        // relational/equality operators yield bool so `ptr == null` and
        // `ptr != ptr2` type-check without a rawptr round-trip.
        // `&T` / `&mut T` are borrowed views, but pointer arithmetic on them
        // is a first-class language feature (user decision 2026-09-13): the
        // borrow's address is well-defined inside its allocation, and the
        // backend already lowers borrow+int with Rust raw-pointer element
        // scaling (`lower_pointer_arithmetic_value`). `ptr + int` /
        // `ptr - int` keep the pointer type, `int + ptr` is allowed
        // symmetrically, and `ptr - ptr` yields an element count. Comparisons
        // yield bool (identity of the view).
        let lk_borrow = lk == ty_REF() || lk == ty_MUTREF();
        let rk_borrow = rk == ty_REF() || rk == ty_MUTREF();
        if (lk_borrow || rk_borrow) {
            if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()
                || op == tk_EQEQ() || op == tk_NEQ() || op == tk_MATCHOP()) {
                return tref_create_kind(ty_BOOL());
            }
            if ((op == tk_PLUS() || op == tk_MINUS()) && lk_borrow && type_kind_is_int(rk)) {
                return lt;
            }
            if (op == tk_PLUS() && rk_borrow && type_kind_is_int(lk)) {
                return rt;
            }
            if (op == tk_MINUS() && lk_borrow && rk_borrow) {
                // Pointer difference yields an element count.
                return tref_create_kind(ty_I64());
            }
            self.error_mismatch("binary operator", lt, rt);
            return tref_create_kind(ty_I32());
        }
        let lk_ptr = lk == ty_PTR();
        let rk_ptr = rk == ty_PTR();
        if (lk_ptr || rk_ptr) {
            if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()
                || op == tk_EQEQ() || op == tk_NEQ() || op == tk_MATCHOP()) {
                return tref_create_kind(ty_BOOL());
            }
            if ((op == tk_PLUS() || op == tk_MINUS()) && lk_ptr && type_kind_is_int(rk)) {
                return lt;
            }
            if (op == tk_PLUS() && rk_ptr && type_kind_is_int(lk)) {
                return rt;
            }
            if (op == tk_MINUS() && lk_ptr && rk_ptr) {
                // Pointer difference yields an element count.
                return tref_create_kind(ty_I64());
            }
            self.error_mismatch("binary operator", lt, rt);
            return tref_create_kind(ty_I32());
        }
        if (lk == ty_RAWPTR() || rk == ty_RAWPTR() || lk == ty_VOID() || rk == ty_VOID()) {
            if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()
                || op == tk_EQEQ() || op == tk_NEQ() || op == tk_MATCHOP()
                || op == tk_AND() || op == tk_OR()) {
                return tref_create_kind(ty_BOOL());
            }
            if (op == tk_PLUS() && (lk == ty_STRING() || rk == ty_STRING())) {
                return tref_create_kind(ty_STRING());
            }
            if ((op == tk_PLUS() || op == tk_MINUS()) && lk == ty_RAWPTR() && type_kind_is_int(rk)) {
                return tref_create_kind(ty_RAWPTR());
            }
            if (op == tk_PLUS() && rk == ty_RAWPTR() && type_kind_is_int(lk)) {
                return tref_create_kind(ty_RAWPTR());
            }
            return tref_create_kind(ty_I32());
        }
        if (lk == ty_CLASS() || rk == ty_CLASS()) {
            let op_method_name = sema_binop_operator_method_name(op);
            if (op_method_name.len > 0 && lk == ty_CLASS()) {
                let op_method = self.find_method_decl_for_type(lt, op_method_name);
                if (op_method != null) {
                    let op_ret = decl_get_ty(op_method);
                    if (op_ret != null) { return op_ret; }
                }
            }
            if (op == tk_NEQ() && lk == ty_CLASS()) {
                let eq_method = self.find_method_decl_for_type(lt, "operator_eq");
                if (eq_method != null) { return tref_create_kind(ty_BOOL()); }
            }
            if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()
                || op == tk_EQEQ() || op == tk_NEQ() || op == tk_MATCHOP()
                || op == tk_AND() || op == tk_OR()) {
                return tref_create_kind(ty_BOOL());
            }
            if (op == tk_PLUS() && (lk == ty_STRING() || rk == ty_STRING())) {
                return tref_create_kind(ty_STRING());
            }
            let lf = type_ref_is_floatish(lt);
            let rf = type_ref_is_floatish(rt);
            if (lf && rf) {
                return lt;
            }
            if (lf && type_kind_is_int(rk)) {
                return lt;
            }
            if (rf && type_kind_is_int(lk)) {
                return rt;
            }
            if (op == tk_PLUS() || op == tk_MINUS()
                || op == tk_STAR() || op == tk_SLASH()
                || op == tk_PERCENT()) {
                if (type_name_is_generic(self.cur_generic_params, lt)
                    && self.types_compatible(lt, rt)) {
                    return lt;
                }
                if (type_name_is_generic(self.cur_generic_params, rt)
                    && self.types_compatible(rt, lt)) {
                    return rt;
                }
            }
            return tref_create_kind(ty_I32());
        }

        if (op == tk_PLUS()) {
            if (lk == ty_STRING() && rk == ty_STRING()) {
                return tref_create_kind(ty_STRING());
            }
            if (type_kind_is_int(lk) && type_kind_is_int(rk)) {
                return numeric_result_ty(lk, rk);
            }
            self.error_mismatch("binary +", lt, rt);
            return tref_create_kind(ty_I32());
        }
        if (op == tk_MINUS() || op == tk_STAR() || op == tk_SLASH() || op == tk_PERCENT()) {
            if (type_kind_is_int(lk) && type_kind_is_int(rk)) {
                return numeric_result_ty(lk, rk);
            }
            self.error_mismatch("arith op", lt, rt);
            return tref_create_kind(ty_I32());
        }
        if (op == tk_PIPE() || op == tk_AMP() || op == tk_CARET()) {
            if (type_kind_is_int(lk) && type_kind_is_int(rk)) {
                return numeric_result_ty(lk, rk);
            }
            if (type_is_boolish(lt) && type_is_boolish(rt)) {
                return tref_create_kind(ty_I32());
            }
            self.error_mismatch("bitwise op", lt, rt);
            return tref_create_kind(ty_I32());
        }
        if (op == tk_LSHIFT() || op == tk_RSHIFT()) {
            if (type_kind_is_int(lk) && type_kind_is_int(rk)) {
                return lt;
            }
            self.error_mismatch("shift op", lt, rt);
            return tref_create_kind(ty_I32());
        }
        if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()) {
            if (type_kind_is_int(lk) && type_kind_is_int(rk)) {
                return tref_create_kind(ty_BOOL());
            }
            self.error_mismatch("compare", lt, rt);
            return tref_create_kind(ty_BOOL());
        }
        if (op == tk_MATCHOP()) {
            return tref_create_kind(ty_BOOL());
        }
        if (op == tk_EQEQ() || op == tk_NEQ()) {
            if (lk == rk) { return tref_create_kind(ty_BOOL()); }
            // e.g. `source.len == 0` — len is i64, literal 0 is i32.
            if ((lk == ty_I32() && rk == ty_I64()) || (lk == ty_I64() && rk == ty_I32())) {
                return tref_create_kind(ty_BOOL());
            }
            if (type_is_boolish(lt) && type_is_boolish(rt)) {
                return tref_create_kind(ty_BOOL());
            }
            self.error_mismatch("==/!=", lt, rt);
            return tref_create_kind(ty_BOOL());
        }
        if (op == tk_AND() || op == tk_OR()) {
            if (type_is_boolish(lt) && type_is_boolish(rt)) { return tref_create_kind(ty_BOOL()); }
            self.error_mismatch("logical &&/||", tref_create_kind(ty_BOOL()), lt);
            return tref_create_kind(ty_BOOL());
        }
        return tref_create_kind(ty_I32());
    }

    /// After `resolve_expr` on each argument, check arity and param types.
    public fn call_matches_decl(self, call_ep: rawptr, fdecl: rawptr) -> bool {
        return self.overload_score_decl(call_ep, fdecl) >= 0;
    }

    public fn overload_candidate_count(self, name: string) -> i32 {
        sema_memo_ensure();
        let slot = sema_memo_lookup(g_overload_count_memo, self.funcs_buf, name);
        if (slot != null) { return sema_memo_slot_i64(slot) as i32; }
        var cur = self.funcs_buf;
        var count: i32 = 0;
        while (cur != null) {
            if (sym_get_name(cur) == name && sym_get_decl(cur) != null) {
                count = count + 1;
            }
            cur = sym_get_next(cur);
        }
        sema_memo_put_i64(g_overload_count_memo, self.funcs_buf, name, count as i64);
        return count;
    }

    public fn overload_candidate_count_in_module(self, name: string, module_name: string) -> i32 {
        if (module_name.len == 0) { return self.overload_candidate_count(name); }
        var cur = self.funcs_buf;
        var count: i32 = 0;
        while (cur != null) {
            if (sym_get_name(cur) == name
                && sym_get_decl(cur) != null
                && self.sema_func_decl_matches_module(sym_get_decl(cur), module_name)) {
                count = count + 1;
            }
            cur = sym_get_next(cur);
        }
        return count;
    }

    public fn call_argument_count(self, call_ep: rawptr) -> i32 {
        if (call_ep == null) { return 0; }
        var count = self.stmt_list_count(expr_get_args(call_ep));
        if (self.pipe_call_context == call_ep && self.pipe_prefix_expr != null) {
            count = count + 1;
        }
        return count;
    }

    public fn decl_call_has_variadic_param(self, fdecl: rawptr) -> bool {
        if (fdecl == null) { return false; }
        var param = decl_get_params(fdecl);
        while (param != null) {
            if (sema_param_ends_typed_arity(param)) {
                return true;
            }
            param = decl_get_next(param);
        }
        return false;
    }

    public fn decl_visible_call_param_count(self, fdecl: rawptr) -> i32 {
        if (fdecl == null) { return 0; }
        var param = decl_get_params(fdecl);
        if (decl_get_kind(fdecl) == de_METHOD()
            && param != null
            && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        var count: i32 = 0;
        while (param != null) {
            if (sema_param_ends_typed_arity(param)) {
                return count;
            }
            count = count + 1;
            param = decl_get_next(param);
        }
        return count;
    }

    public fn decl_required_call_param_count(self, fdecl: rawptr) -> i32 {
        if (fdecl == null) { return 0; }
        var param = decl_get_params(fdecl);
        if (decl_get_kind(fdecl) == de_METHOD()
            && param != null
            && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        var count: i32 = 0;
        while (param != null) {
            if (sema_param_ends_typed_arity(param)) {
                return count;
            }
            if (decl_get_body(param) == null) {
                count = count + 1;
            }
            param = decl_get_next(param);
        }
        return count;
    }

    public fn decl_call_arity_matches(self, call_ep: rawptr, fdecl: rawptr) -> bool {
        if (fdecl == null) { return false; }
        let argc = self.call_argument_count(call_ep);
        let required = self.decl_required_call_param_count(fdecl);
        let maximum = self.decl_visible_call_param_count(fdecl);
        if (self.decl_call_has_variadic_param(fdecl)) {
            return argc >= required;
        }
        return argc >= required && argc <= maximum;
    }

    public fn decl_signature_text(self, fdecl: rawptr) -> string {
        if (fdecl == null) { return "fn <unknown>()"; }
        var out = "fn " + decl_get_name(fdecl) + "(";
        var param = decl_get_params(fdecl);
        var first = true;
        while (param != null) {
            if (!first) { out = out + ", "; }
            var param_name = decl_get_name(param);
            if (param_name.len == 0) { param_name = "_"; }
            if (param_name == "self") {
                let receiver_mode = sema_receiver_mode(param);
                if (receiver_mode == sema_receiver_mode_own()) {
                    out = out + "own self";
                } else if (receiver_mode == sema_receiver_mode_own_mut()) {
                    out = out + "mut self";
                } else if (receiver_mode == sema_receiver_mode_shared()) {
                    out = out + "&self";
                } else if (receiver_mode == sema_receiver_mode_mut()) {
                    out = out + "&mut self";
                } else {
                    out = out + "self";
                }
            } else {
                out = out + param_name;
                let param_ty = decl_get_ty(param);
                if (param_ty != null) {
                    out = out + ": " + type_text_from_ty(param_ty);
                }
            }
            if (sema_param_ends_typed_arity(param)) {
                out = out + "...";
            }
            first = false;
            param = decl_get_next(param);
        }
        out = out + ")";
        let ret_ty = decl_get_ty(fdecl);
        if (ret_ty != null) {
            out = out + " -> " + type_text_from_ty(ret_ty);
        }
        return out;
    }

    public fn report_overload_candidate_note(self,
                                              call_loc: rawptr,
                                              fdecl: rawptr) {
        if (fdecl == null) { return; }
        var note_loc = call_loc;
        var note_message = "candidate: " + self.decl_signature_text(fdecl);
        let source_module = self.decl_source_module(fdecl, null);
        if (source_module.len == 0 || source_module == self.file_module) {
            note_loc = decl_loc_ptr(fdecl);
            note_message = "candidate defined here: " + self.decl_signature_text(fdecl);
        } else {
            note_message = note_message + " from module '" + source_module + "'";
        }
        diag_emit_at(diag_sev_NOTE(),
                     diag_code_sema_no_overload(),
                     note_loc,
                     note_message);
    }

    public fn report_no_matching_overload_for_call(self,
                                                   name: string,
                                                   call_ep: rawptr,
                                                   representative: rawptr,
                                                   candidate_count: i32) {
        var call_loc = expr_loc_ptr(call_ep);
        let callee = expr_get_lhs(call_ep);
        if (callee != null) {
            let callee_loc = expr_loc_ptr(callee);
            if (callee_loc != null && ast_read_i32(callee_loc) > 0) {
                call_loc = callee_loc;
            }
        }
        let argc = self.call_argument_count(call_ep);
        var message = "no matching overload for call to '" + name + "': "
            + policy_i64_to_string(argc as i64) + " argument";
        if (argc != 1) { message = message + "s"; }
        message = message + " provided";
        if (candidate_count <= 1 && representative != null) {
            let required = self.decl_required_call_param_count(representative);
            let maximum = self.decl_visible_call_param_count(representative);
            let variadic = self.decl_call_has_variadic_param(representative);
            var arity_matches = argc >= required && argc <= maximum;
            if (variadic) { arity_matches = argc >= required; }
            if (!arity_matches) {
                if (argc < required) {
                    message = message + "; the only candidate requires ";
                    if (variadic || maximum > required) { message = message + "at least "; }
                    message = message + policy_i64_to_string(required as i64) + " argument";
                    if (required != 1) { message = message + "s"; }
                } else {
                    message = message + "; the only candidate accepts at most "
                        + policy_i64_to_string(maximum as i64) + " argument";
                    if (maximum != 1) { message = message + "s"; }
                }
            } else {
                message = message + "; the only candidate has incompatible parameter types";
            }
        } else {
            message = message + "; none of "
                + policy_i64_to_string(candidate_count as i64)
                + " candidates accepts this argument list";
        }
        self.report_error_coded(diag_code_sema_no_overload(), call_loc, message);
        self.report_overload_candidate_note(call_loc, representative);
        diag_emit_help_at(diag_code_sema_no_overload(),
                            call_loc,
                            "adjust the argument list to match a candidate shown below, or add an overload");
    }

    public fn overload_score_decl(self, call_ep: rawptr, fdecl: rawptr) -> i32 {
        if (call_ep == null || fdecl == null) { return -1; }
        let f_generics = decl_get_generic_params(fdecl);
        var pp = decl_get_params(fdecl);
        if (decl_get_kind(fdecl) == de_METHOD()
            && pp != null
            && decl_get_name(pp) == "self") {
            pp = decl_get_next(pp);
        }
        var ac = expr_get_args(call_ep);
        var prefix_pending = self.pipe_call_context == call_ep
            && self.pipe_prefix_expr != null;
        var score: i32 = 0;
        while (pp != null) {
            if (decl_get_name(pp) == "args" || string_contains(decl_get_generic_params(pp), "|variadic")) {
                return score;
            }
            var av: rawptr = null;
            if (prefix_pending) {
                av = self.pipe_prefix_expr;
                prefix_pending = false;
            } else if (ac != null) {
                av = stmt_get_init(ac);
                ac = stmt_get_next(ac);
            } else if (decl_get_body(pp) != null) {
                pp = decl_get_next(pp);
                continue;
            } else {
                return -1;
            }
            if (av == null) {
                return -1;
            }
            let pt = decl_get_ty(pp);
            var at = expr_get_ty(av);
            if (at == null) { at = self.resolve_expr(av); }
            if (pt == null || at == null) {
                pp = decl_get_next(pp);
            } else if (tref_get_kind(pt) == ty_RAWPTR() || tref_get_kind(at) == ty_RAWPTR()) {
                pp = decl_get_next(pp);
            } else if (type_name_is_generic(f_generics, pt)) {
                pp = decl_get_next(pp);
            } else if (expr_get_kind(av) == ex_INT_LIT()) {
                let literal_score = sema_numeric_literal_score_for_param(pt, av);
                if (literal_score >= 0) {
                    score = score + literal_score;
                    pp = decl_get_next(pp);
                } else {
                    return -1;
                }
            } else if (type_nominally_equal(pt, at)) {
                score = score + 2;
                pp = decl_get_next(pp);
            } else if (self.types_compatible_user_value(pt, at)) {
                score = score + 1;
                pp = decl_get_next(pp);
            } else if (type_ref_implicitly_convertible(at, pt)) {
                score = score + 1;
                pp = decl_get_next(pp);
            } else {
                return -1;
            }
        }
        if (prefix_pending || ac != null) {
            return -1;
        }
        return score;
    }

    // A struct/class literal's field type is often spelled with one of the
    // *owner declaration's* own template parameters (`struct Pair<A, B> {
    // first: A; }`).  Those names are placeholders in that position, even when
    // an unrelated type happens to share the same spelling somewhere else in
    // the module.  `type_ref_is_unresolved_generic_placeholder` cannot tell
    // that apart once the module also declares a real `A`, so consult the
    // literal's own declaration first.
    public fn field_type_is_owner_template_param(self, owner_decl: rawptr, field_ty: rawptr) -> bool {
        if (owner_decl == null || field_ty == null) { return false; }
        let owner_params = generic_param_head(decl_get_generic_params(owner_decl));
        if (owner_params.len == 0) { return false; }
        let resolved = self.resolve_type_alias_ref(field_ty);
        if (resolved == null) { return false; }
        return type_name_is_generic(owner_params, resolved);
    }

    public fn type_ref_is_unresolved_generic_placeholder(self, ty: rawptr) -> bool {
        if (ty == null) { return false; }
        let resolved = self.resolve_type_alias_ref(ty);
        if (resolved == null) { return false; }
        if (type_name_is_generic(self.cur_generic_params, resolved)) { return true; }
        if (tref_get_kind(resolved) != ty_CLASS()) { return false; }
        let name = tref_get_name(resolved);
        if (name.len == 0) { return false; }
        let base = module_last_segment(generic_call_base(name.clone()));
        if (base.len == 0) { return false; }
        if (policy_generic_call_args(name.clone()).len > 0) { return false; }
        if (policy_primitive_type_kind(base.clone()) != 0) { return false; }
        return self.class_decl_for_type_base(base) == null;
    }

    public fn type_ref_is_pointer_handle(self, ty: rawptr) -> bool {
        if (ty == null) { return false; }
        let resolved = self.resolve_type_alias_ref(ty);
        if (resolved == null) { return false; }
        let kind = tref_get_kind(resolved);
        return kind == ty_PTR() || kind == ty_REF()
            || kind == ty_MUTREF() || kind == ty_RAWPTR();
    }

    public fn type_ref_is_reflect_instance(self, ty: rawptr) -> bool {
        if (ty == null) { return false; }
        let resolved = self.resolve_type_alias_ref(ty);
        if (resolved == null || tref_get_kind(resolved) != ty_CLASS()) { return false; }
        let name = tref_get_name(resolved);
        if (name == "std.reflect.Instance") { return true; }
        let base = module_last_segment(generic_call_base(name.clone()));
        if (base != "Instance") { return false; }
        let cd = self.class_decl_for_type_base(base);
        if (cd == null) { return false; }
        return self.decl_source_module(cd, null) == "std.reflect";
    }

    public fn check_indirect_fn_call(self, call_ep: rawptr, fn_ty: rawptr) -> bool {
        let resolved = self.resolve_type_alias_ref(fn_ty);
        if (resolved == null) { return false; }
        let rk = tref_get_kind(resolved);
        if (rk != ty_FN() && rk != ty_CFN()) { return false; }
        let argc = self.stmt_list_count(expr_get_args(call_ep));
        let paramc = tref_fn_param_count(resolved) as i32;
        if (argc != paramc) {
            self.report_error_help(diag_code_sema_no_overload(),
                                   expr_loc_ptr(call_ep),
                                   "indirect function call expects "
                                       + policy_i64_to_string(paramc as i64)
                                       + " argument(s), got "
                                       + policy_i64_to_string(argc as i64),
                                   "pass exactly "
                                       + policy_i64_to_string(paramc as i64)
                                       + " argument(s), or call a function with a matching signature");
            return false;
        }
        var idx: i32 = 0;
        var ac = expr_get_args(call_ep);
        var ok: bool = true;
        while (idx < paramc) {
            let arg_e = stmt_get_init(ac);
            let want = tref_fn_param_at(resolved, idx as i64);
            var got = expr_get_ty(arg_e);
            if (got == null) {
                got = self.resolve_expr(arg_e);
            }
            if (want != null
                && got != null
                && !self.type_ref_is_unresolved_generic_placeholder(want)
                && !self.types_compatible(want, got)) {
                self.error_mismatch("indirect call arg", want, got);
                ok = false;
            }
            idx = idx + 1;
            ac = stmt_get_next(ac);
        }
        return ok;
    }

    public fn instantiate_param_type_for_call(self,
                                               call_ep: rawptr,
                                               fdecl: rawptr,
                                               param_ty: rawptr) -> rawptr {
        if (call_ep == null || param_ty == null) { return param_ty; }
        var ty = param_ty;
        let callee = expr_get_lhs(call_ep);
        if (callee == null) { return ty; }
        if (expr_get_kind(callee) == ex_MEMBER()) {
            let recv = expr_get_lhs(callee);
            var recv_ty = expr_get_ty(recv);
            if (recv_ty == null && recv != null) { recv_ty = self.resolve_expr(recv); }
            if (recv_ty != null) {
                let recv_kind = tref_get_kind(recv_ty);
                if (recv_kind == ty_PTR() || recv_kind == ty_REF() || recv_kind == ty_MUTREF()) {
                    let pointee = tref_pointee(recv_ty);
                    if (pointee != null) { recv_ty = pointee; }
                }
            }
            var owner = expr_get_semantic_owner(callee);
            if (owner == null) { owner = expr_get_semantic_owner(call_ep); }
            var class_gp = "";
            if (owner != null) { class_gp = decl_get_generic_params(owner); }
            if (class_gp.len == 0 && recv_ty != null && tref_get_kind(recv_ty) == ty_CLASS()) {
                let class_decl = self.class_decl_for_type_base(generic_call_base(tref_get_name(recv_ty)));
                if (class_decl != null) { class_gp = decl_get_generic_params(class_decl); }
            }
            var recv_args = "";
            if (recv_ty != null && tref_get_kind(recv_ty) == ty_CLASS()) {
                recv_args = policy_generic_call_args(tref_get_name(recv_ty));
            }
            if (class_gp.len > 0 && recv_args.len > 0) {
                ty = sema_substitute_type_with_args(ty, class_gp, recv_args);
            }
            if (fdecl != null) {
                let method_args = policy_generic_call_args(expr_get_name(callee));
                if (method_args.len > 0) {
                    ty = sema_substitute_type_with_args(ty, decl_get_generic_params(fdecl), method_args);
                }
            }
            return ty;
        }
        if (expr_get_kind(callee) == ex_IDENT() && fdecl != null) {
            let cargs = policy_generic_call_args(expr_get_name(callee));
            let fn_gp = decl_get_generic_params(fdecl);
            if (cargs.len > 0 && fn_gp.len > 0) {
                ty = sema_substitute_type_with_args(ty, fn_gp, cargs);
            }
        }
        return ty;
    }

    public fn call_param_type_still_generic(self,
                                             call_ep: rawptr,
                                             fdecl: rawptr,
                                             ty: rawptr) -> bool {
        if (fdecl != null && type_ref_mentions_generic_params(decl_get_generic_params(fdecl), ty)) {
            return true;
        }
        if (call_ep == null) { return false; }
        let callee = expr_get_lhs(call_ep);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()) { return false; }
        var owner = expr_get_semantic_owner(callee);
        if (owner == null) { owner = expr_get_semantic_owner(call_ep); }
        if (owner == null) { return false; }
        return type_ref_mentions_generic_params(decl_get_generic_params(owner), ty);
    }

    public fn adopt_expected_call_args(self, call_ep: rawptr, fdecl: rawptr) {
        if (call_ep == null || fdecl == null) { return; }
        var pp = decl_get_params(fdecl);
        if (decl_get_kind(fdecl) == de_METHOD()
            && pp != null
            && decl_get_name(pp) == "self") {
            pp = decl_get_next(pp);
        }
        var ac = expr_get_args(call_ep);
        var prefix_pending = self.pipe_call_context == call_ep
            && self.pipe_prefix_expr != null;
        while (pp != null && (prefix_pending || ac != null)) {
            if (decl_get_name(pp) == "args"
                || string_contains(decl_get_generic_params(pp), "|variadic")) {
                return;
            }
            var arg_e: rawptr = null;
            if (prefix_pending) {
                arg_e = self.pipe_prefix_expr;
                prefix_pending = false;
            } else {
                arg_e = stmt_get_init(ac);
                ac = stmt_get_next(ac);
            }
            let param_ty = self.instantiate_param_type_for_call(call_ep, fdecl, decl_get_ty(pp));
            if (arg_e != null && param_ty != null) {
                var arg_ty = expr_get_ty(arg_e);
                if (arg_ty == null) { arg_ty = self.resolve_expr(arg_e); }
                self.expr_adopts_expected_type(arg_e, param_ty, arg_ty);
            }
            pp = decl_get_next(pp);
        }
    }

    public fn check_direct_call_args(self, call_ep: rawptr, fdecl: rawptr) {
        if (call_ep == null || fdecl == null) { return; }
        var pp = decl_get_params(fdecl);
        if (decl_get_kind(fdecl) == de_METHOD()
            && pp != null
            && decl_get_name(pp) == "self") {
            pp = decl_get_next(pp);
        }
        var ac = expr_get_args(call_ep);
        var prefix_pending = self.pipe_call_context == call_ep
            && self.pipe_prefix_expr != null;
        while (pp != null && (prefix_pending || ac != null)) {
            if (sema_param_ends_typed_arity(pp)) {
                return;
            }
            var arg_e: rawptr = null;
            if (prefix_pending) {
                arg_e = self.pipe_prefix_expr;
                prefix_pending = false;
            } else {
                arg_e = stmt_get_init(ac);
                ac = stmt_get_next(ac);
            }
            let declared_ty = decl_get_ty(pp);
            let param_ty = self.instantiate_param_type_for_call(call_ep, fdecl, declared_ty);
            if (arg_e != null && param_ty != null) {
                var arg_ty = expr_get_ty(arg_e);
                if (arg_ty == null) { arg_ty = self.resolve_expr(arg_e); }
                // void here is "not yet a value type" (unresolved builtin such
                // as sizeof::<T>(), generic holes). Do not turn that into a
                // user-facing mismatch — string/class/ref mistakes are typed.
                if (arg_ty != null
                    && tref_get_kind(arg_ty) != ty_VOID()
                    && tref_get_kind(param_ty) != ty_VOID()
                    && !self.call_param_type_still_generic(call_ep, fdecl, param_ty)
                    && !self.type_ref_is_unresolved_generic_placeholder(param_ty)
                    && !self.type_ref_is_unresolved_generic_placeholder(arg_ty)
                    && !self.expr_adopts_expected_type(arg_e, param_ty, arg_ty)
                    && !self.types_compatible_user_value(param_ty, arg_ty)) {
                    self.error_mismatch_at("call arg", param_ty, arg_ty, expr_loc_ptr(arg_e));
                }
            }
            pp = decl_get_next(pp);
        }
    }

    public fn struct_init_has_named_field(self, ep: rawptr, fname: string) -> bool {
        if (ep == null || fname.len == 0) { return false; }
        var have = expr_get_args(ep);
        while (have != null) {
            if (stmt_get_name(have) == fname) { return true; }
            have = stmt_get_next(have);
        }
        return false;
    }

    /// Completeness check for a `T { ... }` struct literal.
    ///
    /// Only members that **actually occupy a storage slot** may be required
    /// here. `type Error = i32;` (associated type) and `const SIZE: i64 = 8;`
    /// (associated const) are parsed as `de_FIELD` nodes tagged with
    /// `|kind:assoc_type` / `|kind:assoc_const` (see
    /// `Parser.parse_type_member` / `parse_const_member`), and they have no
    /// layout slot at all — `hir_builder_decl_is_layout_field` already drops
    /// them at layout time.
    ///
    /// Filtering them out is what `derive_is_instance_field` exists for; asking
    /// the users to write `GlobalAllocator { Error: ... }` would produce a
    /// diagnostic with no legal fix, since the value has nowhere to go.
    public fn check_struct_init_required_fields(self,
                                                ep: rawptr,
                                                cd: rawptr,
                                                origin_name: string,
                                                depth: i32) {
        if (ep == null || cd == null || depth > 8) { return; }
        // Positional (unnamed) cells mark container list initialization
        // (`Vec<i32>{1, 2, 3}`) — there are no field slots to satisfy.
        var scan = expr_get_args(ep);
        while (scan != null) {
            if (stmt_get_name(scan).len == 0) { return; }
            scan = stmt_get_next(scan);
        }
        let clause = sema_impl_clause_text(decl_get_generic_params(cd));
        var idx: i32 = 0;
        while (idx < 16) {
            let parent_name = generic_arg_at(clause, idx);
            if (parent_name.len == 0) { break; }
            idx = idx + 1;
            var pent = sym_lookup(self.classes_buf, parent_name);
            if (pent == null) { pent = self.sema_find_class_symbol(parent_name); }
            if (pent == null) { continue; }
            let pd = sym_get_decl(pent);
            if (pd == null || pd == cd) { continue; }
            if (!self.decl_is_layout_class(pd)) { continue; }
            self.check_struct_init_required_fields(ep, pd, origin_name, depth + 1);
        }
        var req = decl_get_members(cd);
        while (req != null) {
            if (self.derive_is_instance_field(req)
                && decl_get_body(req) == null) {
                let need = decl_get_name(req);
                if (!self.struct_init_has_named_field(ep, need)) {
                    self.report_error_help(diag_code_sema_generic(),
                                            expr_loc_ptr(ep),
                                            "missing field '" + need + "' in '"
                                                + origin_name + "'",
                                            "add `" + need + ": ...` to the `{...}` initializer");
                }
            }
            req = decl_get_next(req);
        }
    }

    public fn check_struct_init_fields(self, ep: rawptr, class_ent: rawptr) {
        if (ep == null || class_ent == null) { return; }
        let cd = sym_get_decl(class_ent);
        if (cd == null) { return; }
        var cell = expr_get_args(ep);
        while (cell != null) {
            let fname = stmt_get_name(cell);
            var found = false;
            let mp = self.class_decl_member_deep(cd, fname, 0);
            if (mp != null && self.derive_is_instance_field(mp)) {
                vyx_lsp_bind_target(cell, mp);
                found = true;
                let field_meta = decl_get_meta(mp);
                if (string_contains(field_meta, "|vis:")
                    || string_contains(field_meta, "|attrs:@[vis(")) {
                    if (!self.decl_visibility_allows_current(mp, cd)) {
                        self.report_error_help(diag_code_sema_generic(),
                                                expr_loc_ptr(ep),
                                                "cannot initialize field '" + fname + "' of '"
                                                    + decl_get_name(cd) + "' with " + self.decl_visibility_label(mp),
                                                "initialize it from the declaring module, or widen its visibility");
                    }
                }
                let v = stmt_get_init(cell);
                let field_ty = decl_get_ty(mp);
                if (v != null && field_ty != null) {
                    var got = expr_get_ty(v);
                    if (got == null) { got = self.resolve_expr(v); }
                    if (got != null
                        && !self.field_type_is_owner_template_param(cd, field_ty)
                        && !self.type_ref_is_unresolved_generic_placeholder(field_ty)
                        && !self.expr_adopts_expected_type(v, field_ty, got)
                        && !self.types_compatible_user_value(field_ty, got)) {
                        self.error_mismatch_at("struct field '" + fname + "'",
                                               field_ty,
                                               got,
                                               expr_loc_ptr(v));
                    }
                }
            }
            if (!found && fname.len > 0) {
                self.report_error_help(diag_code_sema_generic(),
                                        expr_loc_ptr(ep),
                                        "unknown field '" + fname + "' in '"
                                            + decl_get_name(cd) + "'",
                                        "remove this field, or add `" + fname + "` to '" + decl_get_name(cd) + "'");
            }
            cell = stmt_get_next(cell);
        }
        self.check_struct_init_required_fields(ep, cd, decl_get_name(cd), 0);
    }

    public fn sym_find_generic_overload_for_args(self, name: string, args: string) -> rawptr {
        let arity = generic_arg_count(args);
        if (arity <= 0) { return null; }
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name) {
                let fd = sym_get_decl(cur);
                if (fd != null && generic_param_count(decl_get_generic_params(fd)) == arity) {
                    return cur;
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn sym_find_generic_overload_for_args_in_module(self,
                                                           name: string,
                                                           args: string,
                                                           module_name: string) -> rawptr {
        if (module_name.len == 0) {
            return self.sym_find_generic_overload_for_args(name, args);
        }
        let arity = generic_arg_count(args);
        if (arity <= 0) { return null; }
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name) {
                let fd = sym_get_decl(cur);
                if (fd != null
                    && generic_param_count(decl_get_generic_params(fd)) == arity
                    && self.sema_func_decl_matches_module(fd, module_name)) {
                    return cur;
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn sym_find_best_scored_overload(self, name: string, call_ep: rawptr) -> rawptr {
        var best_non_gen: rawptr = null;
        var best_gen: rawptr = null;
        var best_non_score: i32 = -1;
        var best_gen_score: i32 = -1;
        var tie_non: bool = false;
        var tie_gen: bool = false;
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name) {
                let fd = sym_get_decl(cur);
                if (fd != null) {
                    let s = self.overload_score_decl(call_ep, fd);
                    if (s >= 0) {
                        if (generic_param_count(decl_get_generic_params(fd)) > 0) {
                            if (s > best_gen_score) {
                                best_gen_score = s;
                                best_gen = cur;
                                tie_gen = false;
                            } else if (s == best_gen_score) {
                                let candidate_module = self.decl_source_module(fd,
                                                                               null);
                                let best_module = self.decl_source_module(
                                    sym_get_decl(best_gen),
                                    null);
                                if (self.sema_versioned_module_pair(candidate_module,
                                                                    best_module)) {
                                    let version_cmp = policy_semver_compare(
                                        policy_module_version(candidate_module),
                                        policy_module_version(best_module));
                                    if (version_cmp > 0) {
                                        best_gen = cur;
                                        tie_gen = false;
                                    } else if (version_cmp == 0) {
                                        tie_gen = true;
                                    }
                                } else {
                                    tie_gen = true;
                                }
                            }
                        } else {
                            if (s > best_non_score) {
                                best_non_score = s;
                                best_non_gen = cur;
                                tie_non = false;
                            } else if (s == best_non_score) {
                                let candidate_module2 = self.decl_source_module(fd,
                                                                                null);
                                let best_module2 = self.decl_source_module(
                                    sym_get_decl(best_non_gen),
                                    null);
                                if (self.sema_versioned_module_pair(candidate_module2,
                                                                    best_module2)) {
                                    let version_cmp2 = policy_semver_compare(
                                        policy_module_version(candidate_module2),
                                        policy_module_version(best_module2));
                                    if (version_cmp2 > 0) {
                                        best_non_gen = cur;
                                        tie_non = false;
                                    } else if (version_cmp2 == 0) {
                                        tie_non = true;
                                    }
                                } else {
                                    tie_non = true;
                                }
                            }
                        }
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        if (best_non_gen != null) {
            if (tie_non) {
                self.report_error_coded(diag_code_sema_ambiguity(),
                                        g_sema_cur_loc,
                                        "ambiguous call to '" + name + "'");
            }
            return best_non_gen;
        }
        if (best_gen != null) {
            if (tie_gen) {
                self.report_error_coded(diag_code_sema_ambiguity(),
                                        g_sema_cur_loc,
                                        "ambiguous call to '" + name + "'");
            }
            return best_gen;
        }
        return null;
    }

    public fn sym_find_best_scored_overload_in_module(self,
                                                      name: string,
                                                      module_name: string,
                                                      call_ep: rawptr) -> rawptr {
        if (module_name.len == 0) {
            return self.sym_find_best_scored_overload(name, call_ep);
        }
        var best_non_gen: rawptr = null;
        var best_gen: rawptr = null;
        var best_non_score: i32 = -1;
        var best_gen_score: i32 = -1;
        var tie_non: bool = false;
        var tie_gen: bool = false;
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name) {
                let fd = sym_get_decl(cur);
                if (fd != null && self.sema_func_decl_matches_module(fd, module_name)) {
                    let s = self.overload_score_decl(call_ep, fd);
                    if (s >= 0) {
                        if (generic_param_count(decl_get_generic_params(fd)) > 0) {
                            if (s > best_gen_score) {
                                best_gen_score = s;
                                best_gen = cur;
                                tie_gen = false;
                            } else if (s == best_gen_score) {
                                tie_gen = true;
                            }
                        } else {
                            if (s > best_non_score) {
                                best_non_score = s;
                                best_non_gen = cur;
                                tie_non = false;
                            } else if (s == best_non_score) {
                                tie_non = true;
                            }
                        }
                    }
                }
            }
            cur = sym_get_next(cur);
        }
        if (best_non_gen != null) {
            if (tie_non) {
                self.report_error_coded(diag_code_sema_ambiguity(),
                                        g_sema_cur_loc,
                                        "ambiguous call to '" + name + "' in module '" + module_name + "'");
            }
            return best_non_gen;
        }
        if (best_gen != null) {
            if (tie_gen) {
                self.report_error_coded(diag_code_sema_ambiguity(),
                                        g_sema_cur_loc,
                                        "ambiguous call to '" + name + "' in module '" + module_name + "'");
            }
            return best_gen;
        }
        return null;
    }

    /// Overload selection mirrors `SemaExprOps.cpp::analyzeCall`:
    /// single-candidate groups keep legacy permissiveness; mixed groups with
    /// turbofish pick the generic sibling by type-arg arity; plain calls score
    /// candidates by analyzed argument types and prefer non-generic winners.
    public fn sym_find_matching_overload(self, name: string, call_ep: rawptr) -> rawptr {
        let candidate_count = self.overload_candidate_count(name);
        if (candidate_count <= 0) { return sym_lookup(self.funcs_buf, name); }
        if (candidate_count == 1) {
            let only = self.sym_find_first_overload(name);
            let only_decl = sym_get_decl(only);
            if (only_decl != null && !self.decl_call_arity_matches(call_ep, only_decl)) {
                self.report_no_matching_overload_for_call(name,
                                                          call_ep,
                                                          only_decl,
                                                          1);
            }
            return only;
        }
        var explicit_args: string = "";
        let callee = expr_get_lhs(call_ep);
        if (callee != null && (expr_get_kind(callee) == ex_IDENT() || expr_get_kind(callee) == ex_MEMBER())) {
            explicit_args = policy_generic_call_args(expr_get_name(callee));
        }
        if (explicit_args.len > 0) {
            let picked = self.sym_find_generic_overload_for_args(name, explicit_args);
            if (picked != null) { return picked; }
        }
        let scored = self.sym_find_best_scored_overload(name, call_ep);
        if (scored != null) { return scored; }
        let first = self.sym_find_first_overload(name);
        self.report_no_matching_overload_for_call(name,
                                                  call_ep,
                                                  sym_get_decl(first),
                                                  candidate_count);
        return first;
    }

    public fn sym_find_matching_overload_in_module(self,
                                                   name: string,
                                                   module_name: string,
                                                   call_ep: rawptr) -> rawptr {
        if (module_name.len == 0) {
            return self.sym_find_matching_overload(name, call_ep);
        }
        let candidate_count = self.overload_candidate_count_in_module(name, module_name);
        if (candidate_count <= 0) { return null; }
        if (candidate_count == 1) {
            let only = self.sym_find_first_overload_in_module(name, module_name);
            let only_decl = sym_get_decl(only);
            if (only_decl != null && !self.decl_call_arity_matches(call_ep, only_decl)) {
                self.report_no_matching_overload_for_call(name,
                                                          call_ep,
                                                          only_decl,
                                                          1);
            }
            return only;
        }
        var explicit_args: string = "";
        let callee = expr_get_lhs(call_ep);
        if (callee != null && (expr_get_kind(callee) == ex_IDENT() || expr_get_kind(callee) == ex_MEMBER())) {
            explicit_args = policy_generic_call_args(expr_get_name(callee));
        }
        if (explicit_args.len > 0) {
            let picked = self.sym_find_generic_overload_for_args_in_module(name,
                                                                           explicit_args,
                                                                           module_name);
            if (picked != null) { return picked; }
        }
        let scored = self.sym_find_best_scored_overload_in_module(name, module_name, call_ep);
        if (scored != null) { return scored; }
        let first = self.sym_find_first_overload_in_module(name, module_name);
        self.report_no_matching_overload_for_call(name,
                                                  call_ep,
                                                  sym_get_decl(first),
                                                  candidate_count);
        return first;
    }

    public fn sym_find_first_overload(self, name: string) -> rawptr {
        let hit = sym_lookup(self.funcs_buf, name);
        if (hit != null && sym_get_decl(hit) != null) { return hit; }
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name && sym_get_decl(cur) != null) {
                return cur;
            }
            cur = sym_get_next(cur);
        }
        return null;
    }

    public fn sym_find_first_overload_in_module(self, name: string, module_name: string) -> rawptr {
        if (module_name.len == 0) { return self.sym_find_first_overload(name); }
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name && sym_get_decl(cur) != null) {
                let fd = sym_get_decl(cur);
                if (self.sema_func_decl_matches_module(fd, module_name)) {
                    return cur;
                }
            }
            cur = sym_get_next(cur);
        }
        return null;
    }


public fn decl_source_module(self, d: rawptr, owner_decl: rawptr) -> string {
        if (d != null) {
            let meta = decl_get_meta(d);
            let from_mod = self.extract_from_module(meta);
            if (from_mod.len > 0) { return from_mod; }
        }
        if (owner_decl != null) {
            let owner_meta = decl_get_meta(owner_decl);
            let owner_from = self.extract_from_module(owner_meta);
            if (owner_from.len > 0) { return owner_from; }
        }
        return self.file_module;
    }

    public fn decl_visibility_allows_current(self, d: rawptr, owner_decl: rawptr) -> bool {
        if (d == null) { return true; }
        if (self.in_imported_scope) { return true; }
        var subject = d;
        if (owner_decl != null) { subject = owner_decl; }
        let source_imported = decl_is_foreign_import(subject) || decl_is_foreign_import(d);
        let source_module = self.decl_source_module(d, owner_decl);
        // The accessibility scope of `vis(self)` is the module declaring the
        // CALLER, not the unit's entry module.  A unity crate merges many
        // modules into one unit and `host_analyze_build_decl_module_map`
        // leaves `file_module` pinned to the entry's module, so a call inside
        // std/ref's own methods (callee `ref_move_value_into`, vis self) was
        // checked against the entry module and rejected.  Resolve the caller
        // from the body currently being resolved, falling back to the unit
        // module exactly as before.
        var current_module = self.file_module;
        if (self.cur_body_decl != null) {
            let body_mod = self.decl_source_module(self.cur_body_decl, self.cur_owner_decl);
            if (body_mod.len > 0) { current_module = body_mod; }
        } else if (self.cur_owner_decl != null) {
            let owner_mod = self.decl_source_module(self.cur_owner_decl, null);
            if (owner_mod.len > 0) { current_module = owner_mod; }
        }
        let expr = sema_decl_visibility_expr(d);
        return sema_vis_expr_allows(expr, current_module, source_module, source_imported);
    }

    public fn decl_visibility_label(self, d: rawptr) -> string {
        return "vis(" + sema_decl_visibility_expr(d) + ")";
    }

    /// Check if a function with the given name exists but is blocked by visibility.
    /// Walks the funcs_buf symbol list; we don't keep a unit pointer on Sema.

public fn sema_function_visibility_blocked(self, name: string) -> bool {
        if (self.funcs_buf == null || name.len == 0) { return false; }
        var cur = self.funcs_buf;
        while (cur != null) {
            if (sym_get_name(cur) == name) {
                let d = sym_get_decl(cur);
                if (d != null && !self.decl_visibility_allows_current(d, null)) {
                    return true;
                }
            }
            cur = sym_get_next(cur);
        }
        return false;
    }

    /// Extract the source module name from a decl's meta (|from:module.name| tag).
    public fn extract_from_module(self, meta: string) -> string {
        var start: i32 = -1;
        var i: i32 = 0;
        while (i + 5 < meta.len) {
            if (meta.charAt(i) == 124
                && meta.charAt(i + 1) == 102
                && meta.charAt(i + 2) == 114
                && meta.charAt(i + 3) == 111
                && meta.charAt(i + 4) == 109
                && meta.charAt(i + 5) == 58) {
                start = i + 6;
                break;
            }
            i = i + 1;
        }
        if (start < 0) { return ""; }
        var end: i32 = start;
        while (end < meta.len && meta.charAt(end) != 124) {
            end = end + 1;
        }
        if (end <= start) { return ""; }
        return str_view_range(meta, start, end);
    }

    public fn pack_index_return_type_for_call(self,
                                              ret_ty: rawptr,
                                              args_head: rawptr,
                                              fdecl: rawptr) -> rawptr {
        if (ret_ty == null || fdecl == null) { return null; }
        if (tref_get_kind(ret_ty) != ty_CLASS()) { return null; }
        let ret_name = tref_get_name(ret_ty);
        let pack_base = sema_pack_index_base(ret_name.clone());
        if (pack_base.len == 0) { return null; }
        if (!generic_list_contains(decl_get_generic_params(fdecl), pack_base)) { return null; }
        let pack_idx = sema_pack_index_value(ret_name.clone());
        if (pack_idx < 0) { return null; }
        var ac = args_head;
        var ai: i32 = 0;
        while (ac != null) {
            if (ai == pack_idx) {
                let ae = stmt_get_init(ac);
                if (ae == null) { return null; }
                let aty = expr_get_ty(ae);
                if (aty != null) { return aty; }
                return self.resolve_expr(ae);
            }
            ai = ai + 1;
            ac = stmt_get_next(ac);
        }
        return null;
    }

    public fn member_expr_names_declared_method(self, member: rawptr) -> bool {
        if (member == null || expr_get_kind(member) != ex_MEMBER()) { return false; }
        let raw_method_name = expr_get_name(member);
        let recv = expr_get_lhs(member);
        if (recv == null) { return false; }
        var recv_ty = expr_get_ty(recv);
        if (recv_ty == null) { return false; }
        var method_name = raw_method_name;
        if (string_contains(raw_method_name, "<")) {
            method_name = generic_call_base(raw_method_name);
        }
        if (method_name.len == 0) { return false; }
        if (tref_get_kind(recv_ty) != ty_CLASS()) { return false; }
        let base = self.type_base_name(recv_ty);
        let cd = self.class_decl_for_type_base(base);
        if (cd == null) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn member_access_allowed_by_owner(self, obj: rawptr, cd: rawptr) -> bool {
        if (obj != null && expr_get_kind(obj) == ex_IDENT() && expr_get_name(obj) == "self") {
            return true;
        }
        if (cd != null) {
            if (self.cur_owner_decl != null && cd == self.cur_owner_decl) {
                return true;
            }
            if (self.cur_owner_class.len > 0) {
                let cd_name = decl_get_name(cd);
                let cd_base = generic_call_base(cd_name);
                let cd_short = module_last_segment(cd_base);
                if (self.cur_owner_class == cd_short) {
                    return true;
                }
            }
        }
        if (self.in_imported_scope) { return true; }
        return false;
    }

    public fn enforce_member_visibility(self,
                                        member_decl: rawptr,
                                        owner_decl: rawptr,
                                        obj: rawptr,
                                        owner_type_name: string,
                                        member_name: string) {
        if (member_decl == null || owner_decl == null) { return; }
        var enforce_visibility = !string_contains(decl_get_generic_params(owner_decl), "|kind:struct");
        if (!enforce_visibility) {
            // Struct members are public by default, but an explicit visibility
            // annotation (`@[vis(...)]` / private / internal / protected)
            // opts the field into visibility enforcement.
            let member_meta = decl_get_meta(member_decl);
            if (string_contains(member_meta, "|vis:")
                || string_contains(member_meta, "|attrs:@[vis(")) {
                enforce_visibility = true;
            }
        }
        if (enforce_visibility && sema_decl_visibility_is_none(member_decl)) {
            if (decl_get_kind(member_decl) == de_METHOD()) {
                self.report_error_help(diag_code_sema_generic(),
                                        g_sema_cur_loc,
                                        "method '" + member_name + "' of '" + owner_type_name + "' is hidden by " + self.decl_visibility_label(member_decl),
                                        "make the method `public`, or access it from a scope allowed by its visibility");
            } else if (decl_get_kind(member_decl) == de_FIELD()) {
                self.report_error_help(diag_code_sema_generic(),
                                        g_sema_cur_loc,
                                        "field '" + member_name + "' of '" + owner_type_name + "' is hidden by " + self.decl_visibility_label(member_decl),
                                        "make the field `public`, or access it from a scope allowed by its visibility");
            }
            return;
        }
        if (enforce_visibility
            && !self.member_access_allowed_by_owner(obj, owner_decl)
            && !self.decl_visibility_allows_current(member_decl, owner_decl)) {
            if (decl_get_kind(member_decl) == de_METHOD()) {
                self.report_error_help(diag_code_sema_generic(),
                                        g_sema_cur_loc,
                                        "cannot access method '" + member_name + "' of '" + owner_type_name + "' with " + self.decl_visibility_label(member_decl),
                                        "make the method `public`, or call it from the declaring module");
            } else if (decl_get_kind(member_decl) == de_FIELD()) {
                self.report_error_help(diag_code_sema_generic(),
                                        g_sema_cur_loc,
                                        "cannot access field '" + member_name + "' of '" + owner_type_name + "' with " + self.decl_visibility_label(member_decl),
                                        "make the field `public`, or access it from the declaring module");
            }
        }
    }

    public fn member_receiver_effective_type(self, member: rawptr) -> rawptr {
        if (member == null || expr_get_kind(member) != ex_MEMBER()) { return null; }
        let recv = expr_get_lhs(member);
        if (recv == null) { return null; }
        var recv_ty = expr_get_ty(recv);
        if (recv_ty == null) { recv_ty = self.resolve_expr(recv); }
        if (recv_ty == null) { return null; }
        let rk = tref_get_kind(recv_ty);
        if (rk == ty_PTR() || rk == ty_REF() || rk == ty_MUTREF()) {
            let pointee_ty = tref_pointee(recv_ty);
            if (pointee_ty != null) { return pointee_ty; }
        }
        return recv_ty;
    }

    public fn type_ref_call_target_allowed(self, ty_ref: rawptr) -> bool {
        if (ty_ref == null) { return false; }
        let resolved = self.resolve_type_alias_ref(ty_ref);
        if (resolved == null) { return false; }
        let rk = tref_get_kind(resolved);
        return rk == ty_FN() || rk == ty_CFN() || rk == ty_RAWPTR();
    }

    public fn report_field_called_as_method(self,
                                            member: rawptr,
                                            field_decl: rawptr,
                                            owner_decl: rawptr,
                                            owner_type_name: string) {
        if (member == null || field_decl == null) { return; }
        var owner_name = owner_type_name;
        if (owner_name.len == 0 && owner_decl != null) { owner_name = decl_get_name(owner_decl); }
        if (owner_name.len == 0) { owner_name = "?"; }
        let field_name = expr_get_name(member);
        self.report_error_help(diag_code_sema_undefined(),
                                expr_loc_ptr(member),
                                "field '" + field_name + "' of '" + owner_name
                                + "' is not callable",
                                "use '." + field_name + "' without '()'");
    }

    public fn report_unknown_member_call_if_known(self, member: rawptr, member_ty: rawptr) -> bool {
        if (member == null || expr_get_kind(member) != ex_MEMBER()) { return false; }
        let sem = expr_get_semantic_kind(member);
        if (sem == expr_sem_BUILTIN()
            || sem == expr_sem_METHOD()
            || sem == expr_sem_VARIANT()
            || sem == expr_sem_INDIRECT_FN()) {
            return false;
        }
        if (self.type_ref_call_target_allowed(member_ty)) { return false; }
        let receiver_ty = self.member_receiver_effective_type(member);
        if (receiver_ty == null || tref_get_kind(receiver_ty) != ty_CLASS()) { return false; }
        let receiver_name = tref_get_name(receiver_ty);
        let receiver_base = generic_call_base(receiver_name.clone());
        let cd = self.class_decl_for_type_base(receiver_base.clone());
        if (cd == null) { return false; }
        let member_name = generic_call_base(expr_get_name(member));
        if (sem == expr_sem_FIELD()) {
            self.report_field_called_as_method(member,
                                               expr_get_semantic_target(member),
                                               expr_get_semantic_owner(member),
                                               receiver_name);
            return true;
        }
        let mp = self.class_decl_member_deep(cd, member_name, 0);
        let owner = self.class_decl_member_owner_deep(cd, member_name, 0);
        if (mp != null && decl_get_kind(mp) == de_FIELD()) {
            self.report_field_called_as_method(member, mp, owner, receiver_name);
            return true;
        }
        self.report_error_help(diag_code_sema_undefined(),
                                expr_loc_ptr(member),
                                "undefined method '" + member_name
                                + "' for type '" + receiver_name + "'",
                                "check the method name, or add `fn " + member_name + "` on '" + receiver_name + "'");
        return true;
    }

    public fn method_return_type_for_member_call(self, call_e: rawptr, member: rawptr) -> rawptr {
        if (member == null || expr_get_kind(member) != ex_MEMBER()) { return null; }
        let recv = expr_get_lhs(member);
        if (recv == null) { return null; }
        let raw_method_name = expr_get_name(member);
        let selector_at = policy_module_selector_index(raw_method_name);
        var unselected_method_name = raw_method_name.clone();
        if (selector_at >= 0) {
            unselected_method_name = str_view_range(raw_method_name, 0, selector_at);
        }
        let method_name = generic_call_base(unselected_method_name.clone());
        let method_args = policy_generic_call_args(unselected_method_name);
        if (method_name.len == 0) { return null; }
        var recv_ty = self.resolve_expr(recv);
        // Method calls through *T, &T, and &mut T share T's overload set.
        // Leaving the pointer wrapper intact skips call-shape selection and
        // silently binds the first same-named declaration instead.
        if (recv_ty != null) {
            let recv_kind = tref_get_kind(recv_ty);
            if (recv_kind == ty_PTR() || recv_kind == ty_REF() || recv_kind == ty_MUTREF()) {
                let pointee_ty = tref_pointee(recv_ty);
                if (pointee_ty != null) { recv_ty = pointee_ty; }
            }
        }
        if (recv_ty == null || tref_get_kind(recv_ty) != ty_CLASS()) { return null; }
        let recv_name = tref_get_name(recv_ty);
        let recv_args = policy_generic_call_args(recv_name.clone());
        let recv_base = generic_call_base(recv_name.clone());
        var class_decl = self.class_decl_for_type_base(recv_base);
        if (class_decl == null && selector_at < 0) {
            let visible_ent = self.sema_find_visible_short_class_symbol(recv_base);
            if (visible_ent != null) {
                let visible_owner = sym_get_decl(visible_ent);
                let discarded_decl = self.find_discarded_method_decl_in_class_for_call(
                    visible_owner,
                    method_name,
                    call_e);
                if (self.report_discarded_callable(discarded_decl,
                                                   visible_owner,
                                                   expr_loc_ptr(member),
                                                   method_name,
                                                   true)) {
                    return tref_create_kind(ty_RAWPTR());
                }
            }
            return null;
        }
        var selected_owner = class_decl;
        let selected_module = self.selected_method_module(raw_method_name,
                                                          class_decl);
        if (selected_module.len > 0) {
            if (!self.sema_loaded_covers(selected_module)) {
                self.sema_load_module(selected_module);
            }
            selected_owner = self.class_decl_for_type_base_in_module(
                recv_base,
                selected_module);
            if (selected_owner == null) {
                self.report_error_help(diag_code_sema_version_policy(),
                                        expr_loc_ptr(member),
                                        "version '" + selected_module
                                            + "' does not define type '" + recv_base + "'",
                                        "pick a version that contains '" + recv_base + "', or drop the version selector");
                return tref_create_kind(ty_RAWPTR());
            }
        }
        var method_decl: rawptr = null;
        if (selected_owner != null) {
            let discarded_decl = self.find_discarded_method_decl_in_class_for_call(
                selected_owner,
                method_name,
                call_e);
            if (self.report_discarded_callable(discarded_decl,
                                               selected_owner,
                                               expr_loc_ptr(member),
                                               method_name,
                                               true)) {
                return tref_create_kind(ty_RAWPTR());
            }
            method_decl = self.find_method_decl_in_class_for_call(
                selected_owner,
                method_name,
                call_e,
                false);
        }
        if (method_decl == null && selected_module.len == 0) {
            method_decl = self.find_method_decl_for_type_and_call(recv_ty,
                                                                  method_name,
                                                                  call_e,
                                                                  false);
        }
        if (method_decl == null) {
            if (selected_module.len > 0) {
                self.report_error_help(diag_code_sema_version_policy(),
                                        expr_loc_ptr(member),
                                        "version '" + selected_module
                                            + "' has no matching method '" + method_name + "'",
                                        "call a method that exists in this version, or select the version that defines '" + method_name + "'");
            }
            return null;
        }
        if (selected_module.len == 0) {
            let method_module = self.decl_source_module(method_decl,
                                                        selected_owner);
            let owner_module = self.decl_source_module(selected_owner, null);
            if (method_module.len > 0 && method_module != owner_module) {
                let historical_owner = self.class_decl_for_type_base_in_module(
                    recv_base,
                    method_module);
                if (historical_owner != null) {
                    let historical_method = self.find_method_decl_in_class_for_call(
                        historical_owner,
                        method_name,
                        call_e,
                        false);
                    if (historical_method != null) {
                        method_decl = historical_method;
                        selected_owner = historical_owner;
                    }
                }
            }
        }
        if (self.report_discarded_callable(method_decl,
                                           selected_owner,
                                           expr_loc_ptr(member),
                                           method_name,
                                           true)) {
            return tref_create_kind(ty_RAWPTR());
        }
        if (!self.prepare_hir_facts) {
            let owner_imported = string_contains(decl_get_meta(selected_owner),
                                                 "|imported");
            let method_meta = decl_get_meta(method_decl);
            if (!string_contains(method_meta, "|body_resolved")
                && !string_contains(method_meta, "|body_resolving")) {
                self.resolve_method_with_owner(method_decl,
                                               selected_owner,
                                               owner_imported);
                let resolved_meta = decl_get_meta(method_decl);
                if (!string_contains(resolved_meta, "|body_resolved")) {
                    decl_set_meta(method_decl,
                                  resolved_meta + "|body_resolved");
                }
            }
        }
        var method_ty = decl_get_ty(method_decl);
        if (method_ty == null) {
            method_ty = tref_create_kind(ty_VOID());
        }
        self.enforce_member_visibility(method_decl,
                                       selected_owner,
                                       recv,
                                       recv_name,
                                       method_name);
        if (method_ty != null && recv_args.len > 0 && class_decl != null) {
            method_ty = sema_substitute_type_with_args(method_ty,
                                                       decl_get_generic_params(class_decl),
                                                       recv_args);
        }
        if (method_ty != null && method_args.len > 0) {
            method_ty = sema_substitute_type_with_args(method_ty,
                                                       decl_get_generic_params(method_decl),
                                                       method_args);
        }
        self.sema_lazy_load_type_ref_symbols(method_ty);
        expr_set_ty(member, method_ty);
        // Keep an explicit module selector intact. A later member-resolution
        // pass must not turn `method@version` back into an unqualified call.
        if (selector_at < 0) {
            expr_set_name(member,
                          method_name
                          + if (method_args.len > 0) {
                              "::<" + method_args + ">"
                          } else {
                              ""
                          });
        }
        expr_set_semantic(member,
                          expr_sem_METHOD(),
                          method_decl,
                          selected_owner,
                          0);
        return method_ty;
    }

    public fn resolve_class_constructor_call(self,
                                             call_e: rawptr,
                                             callee: rawptr,
                                             class_name_raw: string,
                                             class_args: string) -> rawptr {
        if (call_e == null || callee == null || class_name_raw.len == 0) { return null; }
        var class_name = generic_call_base(class_name_raw.clone());
        if (class_name.len == 0) { class_name = class_name_raw.clone(); }
        var ent = self.sema_find_latest_class_symbol(class_name.clone());
        if (ent == null) {
            let short_name = module_last_segment(class_name.clone());
            if (short_name.len > 0 && short_name != class_name) {
                ent = self.sema_find_latest_class_symbol(short_name.clone());
                if (ent != null) { class_name = short_name; }
            }
        }
        if (ent == null) { return null; }
        let class_decl = sym_get_decl(ent);
        if (class_decl == null) { return null; }
        // Field migration validation may have rejected this version family
        // while lazy-loading the class. Return a typed recovery value so the
        // original declaration diagnostic remains the only error instead of
        // falling through to the unrelated free-function lookup for `Type()`.
        if (string_contains(decl_get_meta(class_decl),
                            "|version-field-invalid|")) {
            return tref_create_kind(ty_RAWPTR());
        }
        let discarded_ctor = self.find_discarded_method_decl_in_class_for_call(
            class_decl,
            "constructor",
            call_e);
        if (self.report_discarded_callable(discarded_ctor,
                                           class_decl,
                                           expr_loc_ptr(callee),
                                           "constructor",
                                           true)) {
            return tref_create_kind(ty_RAWPTR());
        }
        let ctor_decl = self.find_method_decl_in_class_for_call(class_decl,
                                                                "constructor",
                                                                call_e,
                                                                false);
        if (ctor_decl == null) { return null; }
        if (self.report_discarded_callable(ctor_decl,
                                           class_decl,
                                           expr_loc_ptr(callee),
                                           decl_get_name(ctor_decl),
                                           true)) {
            return tref_create_kind(ty_RAWPTR());
        }
        var result_ty = decl_get_ty(ctor_decl);
        if (result_ty == null) { result_ty = tref_create_class(class_name); }
        if (class_args.len > 0) {
            mono_scheduler_record_class_request_named(self.mono_scheduler,
                                                     class_name + "::<" + class_args + ">");
            result_ty = sema_substitute_type_with_args(result_ty,
                                                       decl_get_generic_params(class_decl),
                                                       class_args);
            if (result_ty == null) {
                result_ty = tref_create_class(class_name + "::<" + class_args + ">");
            }
        }
        self.mark_function_call_arg_moves(call_e, ctor_decl);
        self.check_direct_call_args(call_e, ctor_decl);
        expr_set_ty(callee, tref_fn_from_decl(ctor_decl));
        expr_set_semantic(callee, expr_sem_METHOD(), ctor_decl, class_decl, 0);
        expr_set_semantic(call_e, expr_sem_METHOD(), ctor_decl, class_decl, 0);
        return result_ty;
    }

    public fn resolve_class_static_new_call(self,
                                            call_e: rawptr,
                                            callee: rawptr,
                                            class_name_raw: string,
                                            class_args: string) -> rawptr {
        if (call_e == null || callee == null || class_name_raw.len == 0) { return null; }
        var class_name = generic_call_base(class_name_raw.clone());
        if (class_name.len == 0) { class_name = class_name_raw.clone(); }
        var ent = self.sema_find_latest_class_symbol(class_name.clone());
        if (ent == null) {
            let short_name = module_last_segment(class_name.clone());
            if (short_name.len > 0 && short_name != class_name) {
                ent = self.sema_find_latest_class_symbol(short_name.clone());
                if (ent != null) { class_name = short_name; }
            }
        }
        if (ent == null) { return null; }
        let class_decl = sym_get_decl(ent);
        if (class_decl == null) { return null; }
        let discarded_new = self.find_discarded_method_decl_in_class_for_call(
            class_decl,
            "new",
            call_e);
        if (self.report_discarded_callable(discarded_new,
                                           class_decl,
                                           expr_loc_ptr(callee),
                                           "new",
                                           true)) {
            return tref_create_kind(ty_RAWPTR());
        }
        let new_decl = self.find_method_decl_in_class_for_call(class_decl,
                                                               "new",
                                                               call_e,
                                                               false);
        if (new_decl == null || !decl_get_is_static(new_decl)) { return null; }
        if (self.report_discarded_callable(new_decl,
                                           class_decl,
                                           expr_loc_ptr(callee),
                                           "new",
                                           true)) {
            return tref_create_kind(ty_RAWPTR());
        }
        var result_ty = decl_get_ty(new_decl);
        if (result_ty == null) { result_ty = tref_create_class(class_name); }
        var owner_type_name = class_name.clone();
        if (class_args.len > 0) {
            owner_type_name = class_name + "::<" + class_args + ">";
            mono_scheduler_record_class_request_named(self.mono_scheduler, owner_type_name.clone());
            result_ty = sema_substitute_type_with_args(result_ty,
                                                       decl_get_generic_params(class_decl),
                                                       class_args);
            if (result_ty == null) {
                result_ty = tref_create_class(owner_type_name.clone());
            }
        }
        self.enforce_member_visibility(new_decl, class_decl, callee, owner_type_name, "new");
        self.mark_function_call_arg_moves(call_e, new_decl);
        self.check_direct_call_args(call_e, new_decl);
        expr_set_ty(callee, tref_fn_from_decl(new_decl));
        expr_set_semantic(callee, expr_sem_METHOD(), new_decl, class_decl, 0);
        expr_set_semantic(call_e, expr_sem_METHOD(), new_decl, class_decl, 0);
        return result_ty;
    }

    public fn resolve_call(self, e: rawptr) -> rawptr {
        let callee = expr_get_lhs(e);
        if (callee == null) {
            self.report_error_help(diag_code_sema_undefined(),
                                   expr_loc_ptr(e),
                                   "call without callee",
                                   "write `name(...)` or `obj.method(...)` with a function or method on the left of `(`");
            return tref_create_kind(ty_VOID());
        }
        var arg_cell_pre = expr_get_args(e);
        while (arg_cell_pre != null) {
            let v_pre = stmt_get_init(arg_cell_pre);
            if (v_pre != null) {
                self.resolve_expr(v_pre);
            }
            arg_cell_pre = stmt_get_next(arg_cell_pre);
        }
        if (expr_get_kind(callee) == ex_MEMBER()) {
            let current_member_name = expr_get_name(callee);
            let current_member_base = generic_call_base(current_member_name.clone());
            if (policy_generic_call_has_args(current_member_name) == 0
                && (current_member_base == "map"
                    || current_member_base == "and_then"
                    || current_member_base == "andThen"
                    || current_member_base == "or_else"
                    || current_member_base == "orElse"
                    || current_member_base == "map_err"
                    || current_member_base == "mapErr")) {
                let only_arg_cell = expr_get_args(e);
                if (only_arg_cell != null && stmt_get_next(only_arg_cell) == null) {
                    let only_arg = stmt_get_init(only_arg_cell);
                    if (only_arg != null && expr_get_kind(only_arg) == ex_CLOSURE()) {
                        let closure_ty = expr_get_ty(only_arg);
                        if (closure_ty != null && tref_get_kind(closure_ty) == ty_FN()) {
                            let closure_ret = tref_fn_ret(closure_ty);
                            if (closure_ret != null) {
                                let obj_for_infer = expr_get_lhs(callee);
                                let obj_ty_for_infer = self.resolve_expr(obj_for_infer);
                                if (obj_ty_for_infer != null
                                    && tref_get_kind(obj_ty_for_infer) == ty_CLASS()) {
                                    let obj_base_for_infer = generic_call_base(tref_get_name(obj_ty_for_infer));
                                    if (obj_base_for_infer == "Option" || obj_base_for_infer == "Result") {
                                        expr_set_name(callee,
                                                      current_member_base
                                                      + "::<"
                                                      + type_text_from_ty(closure_ret)
                                                      + ">");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (expr_get_kind(callee) != ex_IDENT()) {
            // Member-call: `obj.method(...)` (instance) or
            // `Class.method(...)` (static). Both flow through
            // `resolve_member`, which already returns the method's
            // declared return type — for static path the receiver
            // IDENT is class-typed via the ex_IDENT branch; for the
            // instance path the receiver type comes from the local
            // scope. So the call expression's type is exactly the
            // resolved member type.
            if (expr_get_kind(callee) == ex_MEMBER()) {
                // `Outer<T>::Inner<U>(...)` -- a nested record constructor
                // written as a qualified path.  This must be tried *before*
                // `sema_resolve_member_chain_type_name` below: that one reads
                // the whole chain as a module-qualified type reference
                // (`t.HolderU.Inner` = "type `Inner` of module `t.HolderU`"),
                // and when the module part does not resolve it falls back to
                // the bare last segment, which binds a *same-named record of
                // another owner* -- `HolderU<i32>::Inner<f64>(2.5)` silently
                // became `Holder.Inner` and truncated the argument to i64.
                let nested_ctor_ty = self.resolve_nested_record_ctor_call(e, callee);
                if (nested_ctor_ty != null) { return nested_ctor_ty; }
                let member_class_name = self.sema_resolve_member_chain_type_name(callee);
                if (member_class_name.len > 0) {
                    self.sema_mark_member_chain_namespace_prefix(expr_get_lhs(callee));
                    let member_class_base = generic_call_base(member_class_name.clone());
                    let member_class_args = policy_generic_call_args(member_class_name.clone());
                    let ctor_ty = self.resolve_class_constructor_call(e,
                                                                      callee,
                                                                      member_class_base,
                                                                      member_class_args);
                    if (ctor_ty != null) { return ctor_ty; }
                    let static_new_ty = self.resolve_class_static_new_call(e,
                                                                           callee,
                                                                           member_class_base,
                                                                           member_class_args);
                    if (static_new_ty != null) { return static_new_ty; }
                }
                // Resolve `alias.fn()` / `module.fn()` before method lookup.
                // `method_return_type_for_member_call` does resolve_expr on the
                // prefix and would report E2000 for a use-alias that is not a value.
                let member_obj = expr_get_lhs(callee);
                if (member_obj != null) {
                    var module_name = "";
                    if (expr_get_kind(member_obj) == ex_IDENT()) {
                        module_name = self.sema_module_prefix_target(expr_get_name(member_obj));
                    } else {
                        module_name = self.sema_module_prefix_target(
                            self.sema_member_chain_text(member_obj));
                    }
                    if (module_name.len > 0
                        && !self.sema_name_is_type_path(module_name.clone())
                        && (self.sema_namespace_exists(module_name.clone())
                            || self.sema_loaded_covers(module_name.clone())
                            || self.sema_pending_has(module_name.clone()))) {
                        if (!self.sema_loaded_covers(module_name.clone())) {
                            self.sema_load_module(module_name.clone());
                        }
                        let raw_fn_name = expr_get_name(callee).clone();
                        let fn_name = generic_call_base(raw_fn_name.clone());
                        // A module-qualified free-function call reaches this
                        // fast path before the ordinary overload resolver.
                        // Keep the explicit turbofish here: the declaration
                        // is loaded from a `.vyi`, so its return type still
                        // contains the template parameter and must be closed
                        // with the call-site arguments below.
                        var mod_cargs = policy_generic_call_args(raw_fn_name);
                        var mod_fent = self.sema_find_func_symbol_in_module(fn_name.clone(),
                                                                           module_name.clone());
                        if (mod_fent == null) {
                            self.sema_load_qualified_func_symbol(intern_dot(module_name.clone(), fn_name.clone()));
                            mod_fent = self.sema_find_func_symbol_in_module(fn_name.clone(),
                                                                           module_name.clone());
                        }
                        if (mod_fent != null) {
                            mod_fent = self.sym_find_matching_overload_in_module(fn_name.clone(), module_name.clone(), e);
                            let mod_fdecl = sym_get_decl(mod_fent);
                            if (mod_fdecl != null && decl_get_kind(mod_fdecl) == de_FN()) {
                                self.sema_resolve_decl_body_if_needed(mod_fdecl);
                                self.adopt_expected_call_args(e, mod_fdecl);
                                if (mod_cargs.len == 0
                                    && generic_param_count(decl_get_generic_params(mod_fdecl)) > 0) {
                                    let inferred_mod_args = self.infer_generic_args_from_call_args(
                                        decl_get_generic_params(mod_fdecl), mod_fdecl, e);
                                    if (sema_generic_args_closed(inferred_mod_args)
                                        && self.apply_expected_generic_call_args(e,
                                                                                 mod_fdecl,
                                                                                 inferred_mod_args)) {
                                        mod_cargs = inferred_mod_args;
                                    }
                                }
                                self.check_direct_call_args(e, mod_fdecl);
                                self.mark_function_call_arg_moves(e, mod_fdecl);
                                self.sema_mark_member_chain_namespace_prefix(member_obj);
                                expr_set_kind(callee, ex_IDENT());
                                var lowered_fn_name = fn_name.clone();
                                if (mod_cargs.len > 0) {
                                    lowered_fn_name = fn_name + "::<" + mod_cargs + ">";
                                }
                                expr_set_name(callee, lowered_fn_name);
                                expr_set_lhs(callee, null);
                                expr_set_ty(callee, tref_fn_from_decl(mod_fdecl));
                                expr_set_semantic(callee, expr_sem_DIRECT_FN(), mod_fdecl, null, 0);
                                expr_set_semantic(e, expr_sem_DIRECT_FN(), mod_fdecl, null, 0);
                                var mod_ret = decl_get_ty(mod_fdecl);
                                if (mod_ret != null && mod_cargs.len > 0) {
                                    let subst_mod_ret = sema_substitute_type_with_args(
                                        mod_ret,
                                        decl_get_generic_params(mod_fdecl),
                                        mod_cargs);
                                    if (subst_mod_ret != null) { mod_ret = subst_mod_ret; }
                                }
                                if (mod_ret == null) {
                                    mod_ret = tref_create_kind(ty_VOID());
                                }
                                return mod_ret;
                            }
                        }
                    }
                }
                let declared_method_ty = self.method_return_type_for_member_call(e, callee);
                if (declared_method_ty != null) {
                    self.mark_method_call_arg_moves(e, callee);
                    self.check_direct_call_args(e, expr_get_semantic_target(callee));
                    expr_set_semantic(e,
                                      expr_sem_METHOD(),
                                      expr_get_semantic_target(callee),
                                      expr_get_semantic_owner(callee),
                                      expr_get_semantic_flags(callee));
                    return declared_method_ty;
                }
                let nested_ctor_ty = self.resolve_nested_record_ctor_call(e, callee);
                if (nested_ctor_ty != null) { return nested_ctor_ty; }
                let mty = self.resolve_expr(callee);
                if (expr_get_semantic_kind(callee) == expr_sem_METHOD()) {
                    let fallback_method_name = generic_call_base(expr_get_name(callee));
                    let fallback_owner = expr_get_semantic_owner(callee);
                    var fallback_discarded = self.find_discarded_method_decl_in_class_for_call(
                        fallback_owner,
                        fallback_method_name,
                        e);
                    if (fallback_discarded == null
                        && self.decl_has_attr(expr_get_semantic_target(callee), "discard")) {
                        fallback_discarded = expr_get_semantic_target(callee);
                    }
                    if (self.report_discarded_callable(fallback_discarded,
                                                       fallback_owner,
                                                       expr_loc_ptr(callee),
                                                       fallback_method_name,
                                                       true)) {
                        return tref_create_kind(ty_RAWPTR());
                    }
                }
                self.mark_method_call_arg_moves(e, callee);
                self.check_direct_call_args(e, expr_get_semantic_target(callee));
                if (mty == null) {
                    return tref_create_kind(ty_VOID());
                }
                if (expr_get_semantic_kind(callee) == expr_sem_BUILTIN()) {
                    expr_set_semantic(e,
                                      expr_sem_BUILTIN(),
                                      expr_get_semantic_target(callee),
                                      expr_get_semantic_owner(callee),
                                      expr_get_semantic_flags(callee));
                    return mty;
                }
                if (expr_get_semantic_kind(callee) == expr_sem_METHOD()) {
                    expr_set_semantic(e,
                                      expr_sem_METHOD(),
                                      expr_get_semantic_target(callee),
                                      expr_get_semantic_owner(callee),
                                      expr_get_semantic_flags(callee));
                    return mty;
                }
                if (expr_get_semantic_kind(callee) == expr_sem_VARIANT()) {
                    expr_set_semantic(e,
                                      expr_sem_VARIANT(),
                                      expr_get_semantic_target(callee),
                                      expr_get_semantic_owner(callee),
                                      expr_get_semantic_flags(callee));
                    return mty;
                }
                if (self.member_expr_names_declared_method(callee)) {
                    expr_set_semantic(e,
                                      expr_sem_METHOD(),
                                      expr_get_semantic_target(callee),
                                      expr_get_semantic_owner(callee),
                                      expr_get_semantic_flags(callee));
                    return mty;
                }
                let resolved_mty = self.resolve_type_alias_ref(mty);
                if (resolved_mty != null
                    && (tref_get_kind(resolved_mty) == ty_FN()
                        || tref_get_kind(resolved_mty) == ty_CFN())) {
                    self.check_indirect_fn_call(e, resolved_mty);
                    expr_set_semantic(e, expr_sem_INDIRECT_FN(), null, null, 0);
                    var member_fn_ret = tref_fn_ret(resolved_mty);
                    if (member_fn_ret == null) {
                        member_fn_ret = tref_create_kind(ty_VOID());
                    }
                    return member_fn_ret;
                }
                if (resolved_mty != null && tref_get_kind(resolved_mty) == ty_RAWPTR()) {
                    expr_set_semantic(e, expr_sem_INDIRECT_FN(), null, null, 0);
                    return mty;
                }
                if (self.report_unknown_member_call_if_known(callee, mty)) {
                    return tref_create_kind(ty_RAWPTR());
                }
                return mty;
            }
            let indirect_ty = self.resolve_expr(callee);
            let resolved_indirect_ty = self.resolve_type_alias_ref(indirect_ty);
            if (resolved_indirect_ty != null
                && (tref_get_kind(resolved_indirect_ty) == ty_FN()
                    || tref_get_kind(resolved_indirect_ty) == ty_CFN())) {
                self.check_indirect_fn_call(e, resolved_indirect_ty);
                expr_set_semantic(e, expr_sem_INDIRECT_FN(), null, null, 0);
                var indirect_fn_ret = tref_fn_ret(resolved_indirect_ty);
                if (indirect_fn_ret == null) {
                    indirect_fn_ret = tref_create_kind(ty_VOID());
                }
                return indirect_fn_ret;
            }
            if (resolved_indirect_ty != null && tref_get_kind(resolved_indirect_ty) == ty_RAWPTR()) {
                expr_set_semantic(e, expr_sem_INDIRECT_FN(), null, null, 0);
                return indirect_ty;
            }
            return tref_create_kind(ty_RAWPTR());
        }
        let selected_callee_name = expr_get_name(callee);
        let callee_selector_at = policy_module_selector_index(
            selected_callee_name);
        var cname_full = selected_callee_name.clone();
        if (callee_selector_at >= 0) {
            cname_full = str_view_range(selected_callee_name, 0,
                                                       callee_selector_at);
        }
        var cname = generic_call_base(cname_full.clone());
        var cargs = policy_generic_call_args(cname_full.clone());
        let local_callee = sym_lookup(self.cur_locals, cname);
        var alias_callee_module: string = "";
        var selected_versioned_function_decl: rawptr = null;

        if (local_callee == null) {
            let alias_target_for_call = self.sema_use_alias_target(cname.clone());
            let alias_func_for_call = self.sema_resolve_use_alias_func_name(cname.clone());
            if (alias_func_for_call.len > 0) {
                let alias_args = policy_generic_call_args(alias_func_for_call.clone());
                let call_args = cargs.clone();
                cname = generic_call_base(alias_func_for_call.clone());
                cargs = alias_args;
                if (cargs.len == 0) { cargs = call_args; }
                if (cargs.len > 0) {
                    cname_full = cname + "::<" + cargs + ">";
                } else {
                    cname_full = cname.clone();
                }
                expr_set_name(callee, cname_full.clone());
                alias_callee_module = module_parent_path(generic_call_base(alias_target_for_call.clone()));
            }
        }
        if (callee_selector_at >= 0 && local_callee == null) {
            let selected_version = policy_module_version(selected_callee_name);
            var selected_variant = policy_module_variant(selected_callee_name);
            var selected_base_module = policy_module_base(
                alias_callee_module.clone());
            var current_symbol = self.sema_find_func_symbol(cname.clone());
            if (current_symbol != null) {
                let current_decl = sym_get_decl(current_symbol);
                let current_module = self.decl_source_module(current_decl,
                                                             null);
                if (selected_base_module.len == 0) {
                    selected_base_module = policy_module_base(current_module);
                }
                if (selected_variant.len == 0) {
                    selected_variant = policy_module_variant(current_module);
                }
            }
            if (selected_base_module.len == 0) {
                selected_base_module = module_parent_path(cname.clone());
            }
            if (selected_base_module.len == 0) {
                self.report_error_help(diag_code_sema_version_policy(),
                                        expr_loc_ptr(e),
                                        "cannot determine module for versioned function '"
                                            + cname + "'",
                                        "write an explicit `name@version(...)` call, or import the function's module");
                return tref_create_kind(ty_RAWPTR());
            }
            let exact_callee_module = policy_module_identity(
                selected_base_module,
                selected_version,
                selected_variant);
            if (!self.sema_loaded_covers(exact_callee_module)) {
                self.sema_load_module(exact_callee_module);
            }
            alias_callee_module = exact_callee_module;
            selected_versioned_function_decl =
                self.sema_find_function_decl_in_unit_module_for_call(
                    cname,
                    exact_callee_module,
                    e);
            if (cargs.len > 0) {
                cname_full = cname + "::<" + cargs + ">";
            } else {
                cname_full = cname.clone();
            }
            expr_set_name(callee, cname_full.clone());
        }

        if (cargs.len > 0) {
            // PLAN_SEMA_ROOT_FIX S4: turbofish callsite — record the free-fn
            // instantiation against the scheduler so dump_stats reports a
            // non-zero `free_fns=` field whenever generic functions are
            // exercised. Variant constructors (Some/None/Ok/Err) flow
            // through the class table because they materialise an Option /
            // Result instance. Origin is Sema (observation point sits
            // inside `resolve_unit`, mirroring SemaGeneric.cpp L2470).
            if (cname == "Some" || cname == "None") {
                mono_scheduler_record_class_request_named(self.mono_scheduler,
                                                         "Option::<" + cargs + ">");
                let option_owner = self.class_decl_for_type_base("Option");
                let option_variant = self.find_enum_variant_decl(option_owner, cname);
                let option_owner_type = self.variant_owner_type_for_call(option_owner,
                                                                         option_variant,
                                                                         cargs,
                                                                         expr_get_args(e));
                expr_set_ty(callee, self.variant_callee_type_for_owner_text(option_owner_type,
                                                                            option_owner,
                                                                            option_variant));
                expr_set_semantic(callee,
                                  expr_sem_VARIANT(),
                                  option_variant,
                                  option_owner,
                                  0);
                expr_set_semantic(e,
                                  expr_sem_VARIANT(),
                                  option_variant,
                                  option_owner,
                                  0);
                return tref_create_class(option_owner_type);
            }
            if (cname == "Ok" || cname == "Err") {
                mono_scheduler_record_class_request_named(self.mono_scheduler,
                                                         "Result::<" + cargs + ">");
                let result_owner = self.class_decl_for_type_base("Result");
                let result_variant = self.find_enum_variant_decl(result_owner, cname);
                let result_owner_type = self.variant_owner_type_for_call(result_owner,
                                                                         result_variant,
                                                                         cargs,
                                                                         expr_get_args(e));
                expr_set_ty(callee, self.variant_callee_type_for_owner_text(result_owner_type,
                                                                            result_owner,
                                                                            result_variant));
                expr_set_semantic(callee,
                                  expr_sem_VARIANT(),
                                  result_variant,
                                  result_owner,
                                  0);
                expr_set_semantic(e,
                                  expr_sem_VARIANT(),
                                  result_variant,
                                  result_owner,
                                  0);
                return tref_create_class(result_owner_type);
            }
            mono_scheduler_record_fn_request_named(self.mono_scheduler,
                                                   cname + "::<" + cargs + ">");
        }

        if (local_callee != null) {
            let lty = sym_get_ty(local_callee);
            if (lty != null) {
                expr_set_ty(callee, lty);
                expr_set_semantic(callee, expr_sem_LOCAL(), local_callee, null, 0);
                let resolved_lty = self.resolve_type_alias_ref(lty);
                if (resolved_lty != null
                    && (tref_get_kind(resolved_lty) == ty_FN()
                        || tref_get_kind(resolved_lty) == ty_CFN())) {
                    self.check_indirect_fn_call(e, resolved_lty);
                    expr_set_semantic(e, expr_sem_INDIRECT_FN(), local_callee, null, 0);
                    var local_fn_ret = tref_fn_ret(resolved_lty);
                    if (local_fn_ret == null) {
                        local_fn_ret = tref_create_kind(ty_VOID());
                    }
                    return local_fn_ret;
                }
                if (resolved_lty != null && tref_get_kind(resolved_lty) == ty_RAWPTR()) {
                    expr_set_semantic(e, expr_sem_INDIRECT_FN(), local_callee, null, 0);
                    return tref_create_kind(ty_I32());
                }
            }
            return tref_create_kind(ty_I32());
        }

        if (is_host_builtin(cname) && cargs.len > 0) {
            let canonical_cargs = self.sema_canonical_builtin_type_args(cargs.clone());
            if (canonical_cargs.len > 0 && canonical_cargs != cargs) {
                cargs = canonical_cargs;
                cname_full = cname + "::<" + cargs + ">";
                expr_set_name(callee, cname_full.clone());
            }
        }

        if (is_host_builtin(cname)) {
            expr_set_ty(callee, tref_create_kind(ty_RAWPTR()));
            expr_set_semantic(callee, expr_sem_BUILTIN(), null, null, 0);
            if (cname == "construct") {
                let target_type_name = generic_arg_at(cargs, 0);
                if (target_type_name.len > 0) {
                    expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                    return sema_type_name_to_ref(target_type_name);
                }
            }
            if (cname == "reflect_method_value") {
                let target_type_name = generic_arg_at(cargs, 0);
                if (target_type_name.len > 0) {
                    expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                    return sema_type_name_to_ref(target_type_name);
                }
            }
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            return builtin_return_ty(cname);
        }
        let symbol_load_error_checkpoint = self.error_count;
        let diag_load_error_checkpoint = diag_error_count();
        self.sema_lazy_load_pending_until_symbol(cname);
        let short_cname = module_last_segment(cname.clone());
        var cname_sym: rawptr = null;
        if (alias_callee_module.len > 0) {
            cname_sym = self.sema_find_func_symbol_in_module(cname.clone(), alias_callee_module.clone());
        }
        if (cname_sym == null) {
            cname_sym = self.sema_find_func_symbol(cname);
        }
        if (cname_sym == null && short_cname.len > 0 && short_cname != cname && self.sema_find_func_symbol(short_cname) != null) {
            cname = short_cname;
        }
        let ctor_ty = self.resolve_class_constructor_call(e, callee, cname, cargs);
        if (ctor_ty != null) { return ctor_ty; }
        let static_new_ty = self.resolve_class_static_new_call(e, callee, cname, cargs);
        if (static_new_ty != null) { return static_new_ty; }
        let variant_owner = self.find_variant_owner_decl(cname);
        if (variant_owner != null) {
            let variant_decl = self.find_enum_variant_decl(variant_owner, cname);
            let variant_owner_type = self.variant_owner_type_for_call(variant_owner,
                                                                      variant_decl,
                                                                      cargs,
                                                                      expr_get_args(e));
            expr_set_ty(callee, self.variant_callee_type_for_owner_text(variant_owner_type,
                                                                        variant_owner,
                                                                        variant_decl));
            expr_set_semantic(callee,
                              expr_sem_VARIANT(),
                              variant_decl,
                              variant_owner,
                              0);
            expr_set_semantic(e,
                              expr_sem_VARIANT(),
                              variant_decl,
                              variant_owner,
                              0);
            return tref_create_class(variant_owner_type);
        }

        // A lazy module load can fail while validating the declaration that
        // would have supplied this callable (for example an invalid field
        // migration). Preserve that primary diagnostic instead of cascading
        // into a misleading `undefined function` at the triggering call site.
        if (self.error_count > symbol_load_error_checkpoint
            || diag_error_count() > diag_load_error_checkpoint) {
            return tref_create_kind(ty_RAWPTR());
        }

        var fent: rawptr = null;
        if (alias_callee_module.len > 0) {
            fent = self.sym_find_matching_overload_in_module(cname.clone(), alias_callee_module.clone(), e);
        }
        if (fent == null && selected_versioned_function_decl == null) {
            fent = self.sym_find_matching_overload(cname, e);
        }
        if (fent == null) {
            let seeded = sym_lookup(self.funcs_buf, cname);
            if (seeded != null && sym_get_decl(seeded) == null) {
                let sty = sym_get_ty(seeded);
                if (sty != null) {
                    return sty;
                }
            }
            let unresolved_loc = expr_loc_ptr(callee);
            if (unresolved_loc == null || ast_read_i32(unresolved_loc) <= 0) {
                // A recovery/HIR-fact pass can revisit the call after a lazy
                // import already failed. With no source anchor this would only
                // add a `<caller>:0:0 undefined function` cascade to the real
                // declaration diagnostic emitted above.
                return tref_create_kind(ty_RAWPTR());
            }
            if (sym_any_overloaded_name(self.funcs_buf, cname)) {
                fent = self.sym_find_first_overload(cname);
                if (fent == null) {
                    return tref_create_kind(ty_RAWPTR());
                }
                if (!self.in_imported_scope && fent != null) {
                    let vis_decl = sym_get_decl(fent);
                    if (vis_decl != null && !self.decl_visibility_allows_current(vis_decl, null)) {
                        self.report_error_help(diag_code_sema_generic(),
                                                expr_loc_ptr(callee),
                                                "cannot access function '" + cname + "' with " + self.decl_visibility_label(vis_decl),
                                                "make the function `public`, or call it from the declaring module");
                        return tref_create_kind(ty_RAWPTR());
                    }
                }
            } else {
                if (self.sema_function_visibility_blocked(cname)) {
                    self.report_error_help(diag_code_sema_generic(),
                                            expr_loc_ptr(callee),
                                            "cannot access function '" + cname
                                                + "' due to visibility",
                                            "make the function `public`, or call it from the declaring module");
                } else {
                    self.report_error_help(diag_code_sema_undefined(),
                                            expr_loc_ptr(callee),
                                            "undefined function '" + cname + "'",
                                            "check spelling, add a `use` import, or declare `fn " + cname + "`");
                }
                return tref_create_kind(ty_RAWPTR());
            }
        }
        var fdecl: rawptr = null;
        if (selected_versioned_function_decl != null) {
            fdecl = selected_versioned_function_decl;
        } else if (fent != null) {
            fdecl = sym_get_decl(fent);
        }
        if (!self.in_imported_scope
            && fdecl != null
            && !self.decl_visibility_allows_current(fdecl, null)) {
            self.report_error_help(diag_code_sema_generic(),
                                   expr_loc_ptr(callee),
                                   "cannot access function '" + cname + "' with " + self.decl_visibility_label(fdecl),
                                   "make the function `public`, or call it from the declaring module");
            return tref_create_kind(ty_RAWPTR());
        }
        if (fdecl == null) {
            let seeded_ty = sym_get_ty(fent);
            if (seeded_ty != null) {
                return seeded_ty;
            }
            return tref_create_kind(ty_VOID());
        }
        if (self.report_discarded_callable(fdecl,
                                           null,
                                           expr_loc_ptr(callee),
                                           cname,
                                           false)) {
            return tref_create_kind(ty_RAWPTR());
        }
        self.sema_resolve_decl_body_if_needed(fdecl);
        self.adopt_expected_call_args(e, fdecl);
        if (cargs.len == 0 && generic_param_count(decl_get_generic_params(fdecl)) > 0) {
            let inferred_call_args = self.infer_generic_args_from_call_args(
                decl_get_generic_params(fdecl), fdecl, e);
            if (sema_generic_args_closed(inferred_call_args)
                && self.apply_expected_generic_call_args(e, fdecl, inferred_call_args)) {
                cargs = inferred_call_args;
            }
        }
        self.check_direct_call_args(e, fdecl);
        self.mark_function_call_arg_moves(e, fdecl);
        expr_set_ty(callee, tref_fn_from_decl(fdecl));
        expr_set_semantic(callee, expr_sem_DIRECT_FN(), fdecl, null, 0);
        expr_set_semantic(e, expr_sem_DIRECT_FN(), fdecl, null, 0);
        if (cargs == "0" && decl_has_where_marker(fdecl)) {
            self.report_error_help(diag_code_sema_trait_bound(),
                                   expr_loc_ptr(e),
                                   "const predicate not satisfied for " + cname,
                                   "pass const generic arguments that satisfy the function's where-clause");
            return tref_create_kind(ty_VOID());
        }
        self.check_where_constraints(fdecl, cargs, expr_get_args(e), cname);
        let pack_name = self.decl_variadic_param_name(fdecl);
        if (pack_name.len > 0) {
            self.check_pack_oob_stmt(decl_get_body(fdecl),
                                     pack_name,
                                     self.stmt_list_count(expr_get_args(e)),
                                     cname);
        }
        let ret_ty = decl_get_ty(fdecl);
        let pack_ret_ty = self.pack_index_return_type_for_call(ret_ty, expr_get_args(e), fdecl);
        if (pack_ret_ty != null) { return pack_ret_ty; }
        if (decl_get_kind(fdecl) == de_VARIANT()) {
            if (cargs.len > 0) {
                return sema_substitute_type_with_args(ret_ty,
                                                      decl_get_generic_params(fdecl),
                                                      cargs);
            }
            if (ret_ty != null) { return ret_ty; }
            return tref_create_kind(ty_I32());
        }
        if (sema_decl_is_async_callable(fdecl)) {
            self.sema_load_module("std.vio");
        }
        if (sema_decl_is_async_callable(fdecl)
            && sema_async_result_type_ref(ret_ty) == null) {
            self.sema_lazy_load_pending_until_symbol("Task");
            let task_ty = sema_task_type_for_async_return(ret_ty);
            mono_scheduler_record_class_request_named(self.mono_scheduler,
                                                     tref_get_name(task_ty));
            return task_ty;
        }
        if (ret_ty != null && tref_get_kind(ret_ty) == ty_CLASS()) {
            let rn = tref_get_name(ret_ty);
            if (generic_list_contains(decl_get_generic_params(fdecl), rn) && cargs.len > 0) {
                let subst_direct_ret = sema_substitute_type_with_args(ret_ty,
                                                                       decl_get_generic_params(fdecl),
                                                                       cargs);
                if (subst_direct_ret != null) { return subst_direct_ret; }
            }
        }
        if (cargs.len > 0 && decl_has_template_head(fdecl)) {
            let subst_ret = sema_substitute_type_with_args(ret_ty,
                                                           decl_get_generic_params(fdecl),
                                                           cargs);
            if (subst_ret != null) { return subst_ret; }
        }
        if (ret_ty == null) {
            return tref_create_kind(ty_VOID());
        }
        return ret_ty;
    }

    public fn resolve_member(self, e: rawptr) -> rawptr {
        let obj = expr_get_lhs(e);
        let mname_full = expr_get_name(e);
        let member_selector_at = policy_module_selector_index(mname_full);
        var mname_unselected = mname_full.clone();
        if (member_selector_at >= 0) {
            mname_unselected = str_view_range(mname_full, 0, member_selector_at);
        }
        let mname = generic_call_base(mname_unselected.clone());
        let margs = policy_generic_call_args(mname_unselected);
        if (member_selector_at >= 0
            && expr_get_semantic_kind(e) == expr_sem_METHOD()
            && expr_get_semantic_target(e) != null) {
            return expr_get_ty(e);
        }
        if (mname == "hash") {
            self.sema_lazy_load_pending_until_symbol("Hashable");
            self.sema_lazy_load_pending_until_symbol("hash_i64");
            self.sema_lazy_load_pending_until_symbol("hash_i32");
            self.sema_lazy_load_pending_until_symbol("hash_string_key");
        }
        if (mname == "operator_eq" || mname == "operator==") {
            self.sema_lazy_load_pending_until_symbol("Eq");
            self.sema_lazy_load_pending_until_symbol("str_equals");
        }
        if (mname == "clone") {
            self.sema_lazy_load_pending_until_symbol("Clone");
            self.sema_lazy_load_pending_until_symbol("clone_str_dup");
        }
        if (mname == "compare") {
            self.sema_lazy_load_pending_until_symbol("str_compare");
        }
        let chain_type_name = self.sema_resolve_member_chain_type_name(e);
        // Static variant-constructor aliases on Option/Result type names
        // (`Option::<i32>.none()`, `Result::<i32, string>.ok()`, ...). The
        // receiver does not declare a real `none`/`ok` method, so without
        // this exclusion the chain check below hijacked the member as a
        // CLASS-typed expression and the call degraded to rawptr.
        let chain_base_for_variant = module_last_segment(generic_call_base(chain_type_name.clone()));
        let chain_is_variant_ctor = (chain_base_for_variant == "Option"
                                        && (mname == "some" || mname == "none"))
            || (chain_base_for_variant == "Result"
                && (mname == "ok" || mname == "err"));
        if (chain_type_name.len > 0
            && !chain_is_variant_ctor
            && !self.sema_member_receiver_declares_member(obj, mname)) {
            self.sema_mark_member_chain_namespace_prefix(obj);
            expr_set_ty(e, tref_create_class(chain_type_name.clone()));
            expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
            return expr_get_ty(e);
        }
        let obj_path = self.sema_member_chain_text(obj);
        if (obj_path.len > 0) {
            let next_path = intern_dot(obj_path, mname);
            if (self.sema_lookup_class_canonical(next_path.clone()) != null
                || self.sema_has_type_canonical(next_path.clone())) {
                self.sema_mark_member_chain_namespace_prefix(obj);
                expr_set_ty(e, tref_create_class(next_path.clone()));
                expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
                return expr_get_ty(e);
            }
            if (self.sema_namespace_exists(next_path.clone())
                || self.sema_is_namespace_prefix(next_path.clone())) {
                self.sema_mark_member_chain_namespace_prefix(obj);
                expr_set_ty(e, tref_create_kind(ty_RAWPTR()));
                expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
                return expr_get_ty(e);
            }
        }
        if (obj != null && obj_path.len > 0) {
            let prefix_name = obj_path;
            let module_name = self.sema_module_prefix_target(prefix_name);
                if (module_name.len > 0 && !self.sema_name_is_type_path(module_name.clone())) {
                    let module_type_name = self.sema_resolve_module_member_type_name(module_name.clone(),
                                                                                     mname_full.clone());
                    if (module_type_name.len > 0) {
                        expr_set_ty(e, tref_create_class(module_type_name.clone()));
                        expr_set_semantic(e, expr_sem_CLASS(), null, null, 0);
                        return expr_get_ty(e);
                    }
                    if (!self.sema_loaded_covers(module_name.clone())) {
                        self.sema_load_module(module_name.clone());
                    }
                var mod_fent = self.sema_find_func_symbol_in_module(mname.clone(), module_name.clone());
                if (mod_fent == null) {
                    self.sema_load_qualified_func_symbol(intern_dot(module_name.clone(), mname.clone()));
                    mod_fent = self.sema_find_func_symbol_in_module(mname.clone(), module_name.clone());
                }
                if (mod_fent != null) {
                    let mod_fdecl = sym_get_decl(mod_fent);
                    if (mod_fdecl != null && (decl_get_kind(mod_fdecl) == de_CONST()
                        || decl_get_kind(mod_fdecl) == de_GLOBAL_VAR())) {
                        var value_ty = decl_get_ty(mod_fdecl);
                        if (value_ty == null) { value_ty = sym_get_ty(mod_fent); }
                        if (value_ty == null) {
                            self.report_error_at(expr_loc_ptr(e), "module value has no resolved type: " + module_name + "." + mname);
                            return null;
                        }
                        self.sema_mark_member_chain_namespace_prefix(obj);
                        expr_set_kind(e, ex_IDENT());
                        expr_set_name(e, intern_dot(module_name, mname));
                        expr_set_lhs(e, null);
                        expr_set_ty(e, value_ty);
                        var value_sem = expr_sem_CONST();
                        if (decl_get_kind(mod_fdecl) == de_GLOBAL_VAR()) { value_sem = expr_sem_GLOBAL(); }
                        expr_set_semantic(e, value_sem, mod_fdecl, null, 0);
                        return value_ty;
                    }
                    if (mod_fdecl != null && decl_get_kind(mod_fdecl) == de_FN()) {
                        expr_set_kind(e, ex_IDENT());
                        expr_set_name(e, mname);
                        expr_set_lhs(e, null);
                        expr_set_ty(e, tref_fn_from_decl(mod_fdecl));
                        expr_set_semantic(e, expr_sem_DIRECT_FN(), mod_fdecl, null, 0);
                        return expr_get_ty(e);
                    }
                }
            }
        }
        self.place_depth = self.place_depth + 1;
        var ot = self.resolve_expr(obj);
        self.place_depth = self.place_depth - 1;
        if (!self.resolving_assign_lhs
            && obj != null
            && expr_get_kind(obj) == ex_IDENT()) {
            let field_root = sym_lookup(self.cur_locals, expr_get_name(obj));
            if (field_root != null && self.field_is_moved(field_root, mname)) {
                self.report_error_coded(diag_code_v_move_001(),
                                        expr_loc_ptr(e),
                                        "use of moved value '" + expr_get_name(obj) + "." + mname
                                            + "'; ownership was transferred");
            }
        }
        var ok = tref_get_kind(ot);
        if (ok == ty_PTR() || ok == ty_REF() || ok == ty_MUTREF()) {
            let pointee_ty = tref_pointee(ot);
            if (pointee_ty != null && tref_get_kind(pointee_ty) == ty_CLASS()) {
                ot = pointee_ty;
                ok = ty_CLASS();
            }
        }
        if (ok == ty_RAWPTR()
            && obj != null
            && expr_get_kind(obj) == ex_IDENT()
            && expr_get_name(obj) == "self"
            && self.cur_owner_decl != null) {
            ot = tref_create_class(sema_decl_self_type_name(self.cur_owner_decl));
            ok = ty_CLASS();
        }
        // PLAN_SEMA_ROOT_FIX S4: turbofish method callsite. The composite
        // mangled class name comes from the receiver's class TypeRef so
        // the recorded key matches the host's
        // `Monomorphize::buildMangledMethodName` form (`Class<args>.method`).
        // Sema-origin because the observation is part of `resolve_unit`.
        if (margs.len > 0 && ok == ty_CLASS()) {
            mono_scheduler_record_method_request_named(self.mono_scheduler,
                                                      tref_get_name(ot),
                                                      mname + "::<" + margs + ">");
        }
        // Built-in pointer methods on typed pointers and rawptr:
        // offset/add/sub/byte_offset/byte_add/byte_sub/offset_from/
        // byte_offset_from. These are compiler builtins (no user override),
        // dispatched by name in the lowerers.
        let ptr_method_kinds = ok == ty_PTR() || ok == ty_REF() || ok == ty_MUTREF()
            || ok == ty_RAWPTR();
        if (ptr_method_kinds) {
            let pmk = policy_pointer_method_kind(mname);
            if (pmk > 0) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                if (pmk == 7) {
                    // offset_from: element count (isize-shaped i64)
                    return tref_create_kind(ty_I64());
                }
                if (pmk == 8) {
                    // byte_offset_from: byte distance
                    return tref_create_kind(ty_I64());
                }
                // Stepping methods return the receiver's own pointer type.
                return ot;
            }
        }
        // Host string builtins. Primitive `str` methods live in the language
        // (`policy_string_method_kind`); they must not load `std.string` as a
        // side effect of `s.len` / `s.c_str()`.
        if (ok == ty_STRING()) {
            let smk = sema_string_method_kind(mname);
            if (smk == 9 || mname == "find" || mname == "indexOf") {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return tref_create_kind(ty_I64());
            }
            if (smk == 1 || smk == 15) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return tref_create_kind(ty_RAWPTR());
            }
            if (smk == 2 || smk == 4 || smk == 5 || smk == 6
                || smk == 7 || smk == 8 || smk == 16 || smk == 17) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return tref_create_kind(ty_STRING());
            }
            if (smk == 3) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return tref_create_kind(ty_I32());
            }
            if (smk == 10 || smk == 11 || smk == 12 || smk == 13 || smk == 14) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return tref_create_kind(ty_BOOL());
            }
            if (!self.sema_symbol_known("str_length")) {
                self.sema_load_module("std.string");
            }
            let string_impl_ty = self.primitive_impl_method_type(ot,
                                                                 mname,
                                                                 margs);
            if (string_impl_ty != null) {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                return string_impl_ty;
            }
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            if (is_host_builtin(mname)) {
                return builtin_return_ty(mname);
            }
            return tref_create_kind(ty_VOID());
        }
        let prim_impl_ty = self.primitive_impl_method_type(ot, mname, margs);
        if (prim_impl_ty != null) {
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            return prim_impl_ty;
        }
        // Numeric / bool / rawptr primitives expose minimal helpers.
        if (type_kind_is_int(ok) || ok == ty_F32() || ok == ty_F64()) {
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            if (sema_string_method_kind(mname) == 16) { return tref_create_kind(ty_STRING()); }
            return tref_create_kind(ty_RAWPTR());
        }
        if (ok == ty_BOOL()) {
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            if (sema_string_method_kind(mname) == 16) { return tref_create_kind(ty_STRING()); }
            return tref_create_kind(ty_RAWPTR());
        }
        if (ok == ty_RAWPTR()) {
            // No formal member API; codegen treats `.field` on rawptr
            // as a typed-load when receiver is annotated. Return void
            // here to prevent `class ?` mismatch storms.
            expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
            return tref_create_kind(ty_RAWPTR());
        }
        if (ok == ty_TUPLE()) {
            // Tuple field access: t.0, t.1, etc.
            let idx = parse_int_literal(mname);
            let cnt = tref_tuple_count(ot);
            if (idx >= 0 && idx < cnt) {
                let elem = tref_tuple_elem_at(ot, idx);
                if (elem != null) {
                    expr_set_semantic(e, expr_sem_FIELD(), null, null, idx as i32);
                    return elem;
                }
            }
            return tref_create_kind(ty_I32());
        }
        if (ok != ty_CLASS()) {
            return tref_create_kind(ty_RAWPTR());
        }
        let ot_name = tref_get_name(ot);
        let ot_base = generic_call_base(ot_name.clone());
        let ot_args = policy_generic_call_args(ot_name.clone());
        let builtin_owner = self.class_decl_for_type_base(ot_base);
        // Canonical type texts may carry their module prefix
        // (`std.core.Option::<i32>`); the builtin dispatch below keys on the
        // bare language name (`Option`), so normalize to the last segment.
        let ot_lang_base = module_last_segment(ot_base.clone());
        if (ot_lang_base == "Option") {
            let opt_method_decl = self.find_method_decl_signature_for_type(ot, mname);
            if (opt_method_decl != null) {
                expr_set_semantic(e, expr_sem_METHOD(), opt_method_decl, builtin_owner, 0);
            } else {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, builtin_owner, 0);
            }
            if (mname == "some" || mname == "none") {
                var opt_variant_name = "None";
                if (mname == "some") { opt_variant_name = "Some"; }
                let opt_variant_decl = self.find_enum_variant_decl(builtin_owner, opt_variant_name);
                expr_set_semantic(e, expr_sem_VARIANT(), opt_variant_decl, builtin_owner, 0);
                return ot;
            }
            if (mname == "isSome" || mname == "isNone"
                || mname == "is_some" || mname == "is_none") {
                return tref_create_kind(ty_BOOL());
            }
            let opt_inner = sema_option_inner_type_ref(ot);
            if ((mname == "unwrap" || mname == "unwrapOr" || mname == "unwrap_or")
                && opt_inner != null) {
                return opt_inner;
            }
            if (mname == "filter" || mname == "or_else" || mname == "orElse") {
                return ot;
            }
            if (mname == "map" || mname == "and_then" || mname == "andThen") {
                if (margs.len > 0) {
                    return tref_create_class("Option::<" + generic_arg_at(margs, 0) + ">");
                }
                return tref_create_kind(ty_RAWPTR());
            }
        }
        if (ot_lang_base == "Result") {
            let result_method_decl = self.find_method_decl_signature_for_type(ot, mname);
            if (result_method_decl != null) {
                expr_set_semantic(e, expr_sem_METHOD(), result_method_decl, builtin_owner, 0);
            } else {
                expr_set_semantic(e, expr_sem_BUILTIN(), null, builtin_owner, 0);
            }
            if (mname == "ok" || mname == "err") {
                var result_variant_name = "Err";
                if (mname == "ok") { result_variant_name = "Ok"; }
                let result_variant_decl = self.find_enum_variant_decl(builtin_owner, result_variant_name);
                expr_set_semantic(e, expr_sem_VARIANT(), result_variant_decl, builtin_owner, 0);
                return ot;
            }
            if (mname == "isOk" || mname == "isErr"
                || mname == "is_ok" || mname == "is_err") {
                return tref_create_kind(ty_BOOL());
            }
            let ok_ty = sema_result_ok_type_ref(ot);
            let err_ty = sema_result_err_type_ref(ot);
            if ((mname == "unwrap" || mname == "unwrapOr" || mname == "unwrap_or")
                && ok_ty != null) {
                return ok_ty;
            }
            if (mname == "unwrap_err" && err_ty != null) {
                return err_ty;
            }
            if ((mname == "map" || mname == "and_then" || mname == "andThen")
                && margs.len > 0 && err_ty != null) {
                return tref_create_class("Result::<" + generic_arg_at(margs, 0)
                                         + "," + type_text_from_ty(err_ty) + ">");
            }
            if ((mname == "map_err" || mname == "mapErr" || mname == "or_else" || mname == "orElse")
                && margs.len > 0 && ok_ty != null) {
                return tref_create_class("Result::<" + type_text_from_ty(ok_ty)
                                         + "," + generic_arg_at(margs, 0) + ">");
            }
        }
        if (generic_list_contains(self.cur_generic_params, ot_name)) {
            if (obj != null && expr_get_kind(obj) == ex_IDENT() && expr_get_name(obj) == ot_name) {
                expr_set_ty(obj, tref_create_class(ot_name));
                expr_set_semantic(obj, expr_sem_CLASS(), null, null, 0);
                if (mname == "kind" || mname == "name") {
                    expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                    return tref_create_kind(ty_STRING());
                }
                if (mname == "fields" || mname == "methods") {
                    expr_set_semantic(e, expr_sem_BUILTIN(), null, null, 0);
                    return tref_create_kind(ty_RAWPTR());
                }
                let static_mk = self.bound_trait_member_kind(ot_name, mname);
                if (static_mk == 2) {
                    expr_set_semantic(e,
                                      expr_sem_FIELD(),
                                      self.bound_trait_member_decl(ot_name, mname),
                                      self.bound_trait_member_owner_decl(ot_name, mname),
                                      0);
                    return tref_create_class(mname);
                }
                if (static_mk == 3) {
                    let static_ct = self.bound_trait_member_type(ot_name, mname);
                    expr_set_semantic(e,
                                      expr_sem_FIELD(),
                                      self.bound_trait_member_decl(ot_name, mname),
                                      self.bound_trait_member_owner_decl(ot_name, mname),
                                      0);
                    if (static_ct != null) { return static_ct; }
                    return tref_create_kind(ty_I64());
                }
                if (static_mk == 1) {
                    let static_mt = self.bound_trait_member_type(ot_name, mname);
                    expr_set_semantic(e,
                                      expr_sem_METHOD(),
                                      self.bound_trait_member_decl(ot_name, mname),
                                      self.bound_trait_member_owner_decl(ot_name, mname),
                                      0);
                    if (static_mt != null) {
                        if (tref_get_kind(static_mt) == ty_CLASS()) {
                            let static_mt_name = tref_get_name(static_mt);
                            if (static_mt_name == "Self" || static_mt_name == "Item") {
                                return tref_create_class(ot_name);
                            }
                        }
                        return static_mt;
                    }
                    return tref_create_kind(ty_RAWPTR());
                }
                if (string_is_all_caps_ident(mname)) {
                    if (self.bound_trait_member_kind(ot_name, mname) != 3) {
                        self.report_error_help(diag_code_sema_undefined(),
                                                g_sema_cur_loc,
                                                "associated const on generic parameter is not resolved: " + ot_name + "::" + mname,
                                                "add a trait bound that defines `" + ot_name + "::" + mname + "`, or name a concrete type");
                    }
                    return tref_create_kind(ty_RAWPTR());
                }
                if (!string_contains(self.cur_generic_params, ot_name + ":")) {
                    self.report_error_coded(diag_code_sema_undefined(),
                                            g_sema_cur_loc,
                                            "unknown reflection member " + ot_name + "::" + mname);
                }
                return tref_create_kind(ty_RAWPTR());
            }
            let inst_mk = self.bound_trait_member_kind(ot_name, mname);
            if (inst_mk == 1) {
                let inst_mt = self.bound_trait_member_type(ot_name, mname);
                expr_set_semantic(e,
                                  expr_sem_METHOD(),
                                  self.bound_trait_member_decl(ot_name, mname),
                                  self.bound_trait_member_owner_decl(ot_name, mname),
                                  0);
                if (inst_mt != null) { return inst_mt; }
                return tref_create_kind(ty_RAWPTR());
            }
            if (inst_mk == 2 || inst_mk == 3) {
                self.report_error_help(diag_code_sema_undefined(),
                                        g_sema_cur_loc,
                                        "associated member used as instance member: " + mname,
                                        "write `Type::" + mname + "` (or a type-qualified path), not an instance `.` access");
            }
            if (inst_mk == 0 && string_contains(self.cur_generic_params, ot_name + ":")) {
                // Bounded generic bodies are validated again after substitution.
                // Do not reject an uninstantiated `I: Trait<T>` body just because
                // the thin bootstrap solver cannot yet project every trait member.
                return tref_create_kind(ty_RAWPTR());
            }
            return tref_create_kind(ty_RAWPTR());
        }
        var member_lookup = ot_base.clone();
        let dyn_iface = self.sema_dyn_iface_payload(ot_base.clone());
        if (dyn_iface.len > 0) { member_lookup = dyn_iface; }
        var cls_ent = self.sema_find_latest_class_symbol(member_lookup);
        if (cls_ent == null && self.sema_lazy_load_pending_until_symbol(member_lookup)) {
            cls_ent = self.sema_find_latest_class_symbol(member_lookup);
        }
        var cd: rawptr = null;
        if (cls_ent != null) { cd = sym_get_decl(cls_ent); }
        if (cd == null) { cd = self.class_decl_for_type_base(ot_base); }
        if (cd == null) {
            return tref_create_kind(ty_RAWPTR());
        }
        var is_self_access: bool = false;
        if (obj != null && expr_get_kind(obj) == ex_IDENT() && expr_get_name(obj) == "self") {
            is_self_access = true;
        }
        var mp = decl_get_members(cd);
        var tag_idx: i32 = 0;
        while (mp != null) {
            let exact_match = decl_get_name(mp) == mname;
            let field_alias_match = decl_get_kind(mp) == de_FIELD()
                && self.sema_field_migrate_from_field(mp) == mname;
            if (exact_match || field_alias_match) {
                if (decl_get_kind(mp) == de_VARIANT()) {
                    expr_set_semantic(e, expr_sem_VARIANT(), mp, cd, tag_idx);
                    if (decl_get_kind(cd) == de_ENUM()) {
                        return ot;
                    }
                    return tref_create_kind(ty_I32());
                }
                if (decl_get_kind(mp) == de_METHOD()) {
                    let resolved_method = self.find_method_decl_for_type(ot, mname);
                    if (resolved_method != null) {
                        mp = resolved_method;
                    }
                    if (self.report_discarded_callable(mp,
                                                       cd,
                                                       expr_loc_ptr(e),
                                                       mname,
                                                       true)) {
                        return tref_create_kind(ty_RAWPTR());
                    }
                    expr_set_semantic(e, expr_sem_METHOD(), mp, cd, 0);
                } else {
                    expr_set_semantic(e, expr_sem_FIELD(), mp, cd, 0);
                }
                self.enforce_member_visibility(mp, cd, obj, ot_name, mname);
                var member_ty = decl_get_ty(mp);
                if (member_ty != null && ot_args.len > 0) {
                    member_ty = sema_substitute_type_with_args(member_ty,
                                                               decl_get_generic_params(cd),
                                                               ot_args);
                }
                if (member_ty != null && margs.len > 0) {
                    member_ty = sema_substitute_type_with_args(member_ty,
                                                               decl_get_generic_params(mp),
                                                               margs);
                }
                self.sema_lazy_load_type_ref_symbols(member_ty);
                return member_ty;
            }
            if (decl_get_kind(mp) == de_VARIANT()) { tag_idx = tag_idx + 1; }
            mp = decl_get_next(mp);
        }
        let inherited_mp = self.class_decl_member_deep(cd, mname, 0);
        let inherited_owner = self.class_decl_member_owner_deep(cd, mname, 0);
        if (inherited_mp != null && inherited_owner != null && inherited_owner != cd) {
            if (decl_get_kind(inherited_mp) == de_METHOD()) {
                if (self.report_discarded_callable(inherited_mp,
                                                   inherited_owner,
                                                   expr_loc_ptr(e),
                                                   mname,
                                                   true)) {
                    return tref_create_kind(ty_RAWPTR());
                }
                expr_set_semantic(e, expr_sem_METHOD(), inherited_mp, inherited_owner, 0);
            } else {
                expr_set_semantic(e, expr_sem_FIELD(), inherited_mp, inherited_owner, 0);
            }
            self.enforce_member_visibility(inherited_mp, inherited_owner, obj, ot_name, mname);
            var inherited_ty = decl_get_ty(inherited_mp);
            if (inherited_ty != null && ot_args.len > 0) {
                inherited_ty = sema_substitute_type_with_args(inherited_ty,
                                                              decl_get_generic_params(inherited_owner),
                                                              ot_args);
            }
            if (inherited_ty != null && margs.len > 0) {
                inherited_ty = sema_substitute_type_with_args(inherited_ty,
                                                              decl_get_generic_params(inherited_mp),
                                                              margs);
            }
            self.sema_lazy_load_type_ref_symbols(inherited_ty);
            return inherited_ty;
        }
        let method_decl = self.find_method_decl_for_type(ot, mname);
        if (method_decl != null) {
            if (self.report_discarded_callable(method_decl,
                                               cd,
                                               expr_loc_ptr(e),
                                               mname,
                                               true)) {
                return tref_create_kind(ty_RAWPTR());
            }
            expr_set_semantic(e, expr_sem_METHOD(), method_decl, cd, 0);
            var method_ty = decl_get_ty(method_decl);
            if (method_ty != null && ot_args.len > 0) {
                method_ty = sema_substitute_type_with_args(method_ty,
                                                           decl_get_generic_params(cd),
                                                           ot_args);
            }
            if (method_ty != null && margs.len > 0) {
                method_ty = sema_substitute_type_with_args(method_ty,
                                                           decl_get_generic_params(method_decl),
                                                           margs);
            }
            self.sema_lazy_load_type_ref_symbols(method_ty);
            return method_ty;
        }
        if (mname == "new"
            && obj != null
            && expr_get_kind(obj) == ex_IDENT()
            && expr_get_semantic_kind(obj) == expr_sem_CLASS()) {
            self.check_where_constraints(cd, ot_args, null, ot_base);
            expr_set_semantic(e, expr_sem_BUILTIN(), null, cd, 0);
            return ot;
        }
        let deref_inner_ty = self.deref_inner_type_for_type(ot);
        if (deref_inner_ty != null && tref_get_kind(deref_inner_ty) == ty_CLASS()) {
            let inner_name = tref_get_name(deref_inner_ty);
            let inner_base = generic_call_base(inner_name.clone());
            let inner_args = policy_generic_call_args(inner_name.clone());
            let inner_cd = self.class_decl_for_type_base(inner_base);
            if (inner_cd != null) {
                let inner_mp = self.class_decl_member_deep(inner_cd, mname, 0);
                let inner_owner = self.class_decl_member_owner_deep(inner_cd, mname, 0);
                if (inner_mp != null && inner_owner != null) {
                    if (decl_get_kind(inner_mp) == de_METHOD()) {
                        expr_set_semantic(e, expr_sem_METHOD(), inner_mp, inner_owner, 0);
                    } else {
                        expr_set_semantic(e, expr_sem_FIELD(), inner_mp, inner_owner, 0);
                    }
                    var inner_member_ty = decl_get_ty(inner_mp);
                    if (inner_member_ty != null && inner_args.len > 0) {
                        inner_member_ty = sema_substitute_type_with_args(inner_member_ty,
                                                                         decl_get_generic_params(inner_owner),
                                                                         inner_args);
                    }
                    if (inner_member_ty != null && margs.len > 0) {
                        inner_member_ty = sema_substitute_type_with_args(inner_member_ty,
                                                                         decl_get_generic_params(inner_mp),
                                                                         margs);
                    }
                    self.sema_lazy_load_type_ref_symbols(inner_member_ty);
                    return inner_member_ty;
                }
            }
        }
        return tref_create_kind(ty_RAWPTR());
    }

    public fn resolve_assign(self, e: rawptr) -> rawptr {
        let target = expr_get_lhs(e);
        if (target == null) {
            self.report_error_help(diag_code_sema_generic(),
                                   expr_loc_ptr(e),
                                   "assign without target",
                                   "write `place = value` with an ident, field, index, or deref on the left");
            return tref_create_kind(ty_VOID());
        }
        let tk = expr_get_kind(target);
        if (tk != ex_IDENT() && tk != ex_MEMBER()
            && tk != ex_INDEX() && tk != ex_DEREF()) {
            self.report_error_help(diag_code_sema_generic(),
                                   expr_loc_ptr(target),
                                   "assign target must be ident / member / index / deref",
                                   "assign to a local, field, `xs[i]`, or `*ptr`, not a call or literal");
        }
        let root = self.expr_root_local_entry(target);
        if (tk == ex_IDENT()
            && root != null
            && sym_get_is_const(root)) {
            // Zyn `&mut self` on dup/destroy types is C++ this. `self = x`
            // stores through the mutable this pointer (`*this = x`), it does
            // not rebind an immutable local.
            var allow_cpp_this_assign = false;
            if (sym_get_name(root) == "self"
                && sym_get_alloc_state(root) == sema_alloc_state_borrowed_mutable()
                && self.type_has_copy_dup(sym_get_ty(root))) {
                allow_cpp_this_assign = true;
            }
            if (!allow_cpp_this_assign) {
                self.report_error_help(diag_code_sema_generic(),
                                        expr_loc_ptr(target),
                                        "cannot assign to immutable binding '"
                                            + sym_get_name(root) + "'",
                                        "change `let` to `var` / `let mut`, or write `mut` on the parameter");
            }
        }
        if (root != null && tk != ex_IDENT()) {
            let root_state = sym_get_alloc_state(root);
            if (root_state == sema_alloc_state_borrowed_immutable()) {
                self.report_error_coded(diag_code_v_borrow_invalidation(),
                                        expr_loc_ptr(target),
                                        "cannot write through an immutable borrowed pointer/array view");
            } else if (sym_get_is_const(root)
                && root_state != sema_alloc_state_borrowed_mutable()
                && root_state != sema_alloc_state_compat_this()) {
                let root_ty = sym_get_ty(root);
                var class_handle = false;
                if (root_ty != null && tref_get_kind(root_ty) == ty_CLASS()) {
                    class_handle = true;
                }
                if (!class_handle) {
                    self.report_error_help(diag_code_v_borrow_invalidation(),
                                            expr_loc_ptr(target),
                                            "cannot write through immutable '"
                                                + sym_get_name(root) + "'",
                                            "use `mut self` / `&mut self` / `var`, or borrow `&mut`");
                }
            }
            let region_root = sym_region_root(root);
            if (region_root != null
                && root_state != sema_alloc_state_borrowed_immutable()
                && root_state != sema_alloc_state_borrowed_mutable()
                && sym_get_shared_borrows(region_root) > 0) {
                self.report_error_coded(diag_code_v_borrow_invalidation(),
                                        expr_loc_ptr(target),
                                        "cannot mutate a pointer region while it is borrowed");
            }
        }
        var lt: rawptr = null;
        if (tk == ex_IDENT() && root != null) {
            // Assignment is a legal reinitialization point for a moved local;
            // do not diagnose the destination as a read of its old value.
            lt = sym_get_ty(root);
            expr_set_ty(target, lt);
            expr_set_semantic(target, expr_sem_LOCAL(), root, null, 0);
        } else {
            let saved_assign_lhs = self.resolving_assign_lhs;
            self.resolving_assign_lhs = true;
            lt = self.resolve_expr(target);
            self.resolving_assign_lhs = saved_assign_lhs;
        }
        let rhs = expr_get_rhs(e);
        let saved_reinit = self.pending_reinit_place;
        if (tk == ex_MEMBER()) {
            self.pending_reinit_place = target;
        }
        let rt = self.resolve_expr(rhs);
        self.pending_reinit_place = saved_reinit;
        let rhs_is_own = rhs != null
            && expr_get_kind(rhs) == ex_UNARY()
            && expr_get_op(rhs) == unary_op_own();
        let rhs_region = self.expr_borrow_source(rhs);
        var old_region: rawptr = null;
        var old_state = sema_alloc_state_none();
        if (root != null) {
            old_region = sym_region_root(root);
            old_state = sym_get_alloc_state(root);
        }
        let assign_op = expr_get_op(e);
        if (assign_op == tk_PLUSEQ()
            && (self.type_is_string_like(lt) || self.type_is_string_like(rt))) {
            self.sema_lazy_load_pending_until_symbol("str_append_assign");
        }
        // A plain local has a final declared type at this point. Member/index/
        // deref destinations can still carry owner-generic substitutions that
        // are closed by HIR; diagnosing them here produces false concrete
        // mismatches (for example Vec<T>[i] while instantiating Vec<Stage>).
        if (tk == ex_IDENT()
            && rhs != null
            && lt != null
            && rt != null
            && !self.types_compatible_user_value(lt, rt)
            && !self.type_ref_is_unresolved_generic_placeholder(lt)
            && !self.type_ref_is_unresolved_generic_placeholder(rt)
            && !self.type_ref_is_reflect_instance(lt)) {
            let adopted = self.expr_adopts_expected_type(rhs, lt, rt);
            if (!adopted) {
                self.error_mismatch_at("assignment", lt, rt, expr_loc_ptr(rhs));
            }
        }
        // WYSIWYG: an index/member/deref destination whose type is a concrete
        // pointer (`*T`) is the pointer slot itself — assigning a
        // non-pointer value there would silently overwrite the handle in the
        // backend.  Reference destinations (`&mut T`) keep view semantics and
        // are deliberately not checked here; unresolved generic placeholders
        // stay deferred until instantiation closes them.
        if ((tk == ex_MEMBER() || tk == ex_INDEX() || tk == ex_DEREF())
            && rhs != null
            && lt != null
            && rt != null
            && !self.types_compatible_user_value(lt, rt)
            && !self.type_ref_is_unresolved_generic_placeholder(lt)
            && !self.type_ref_is_unresolved_generic_placeholder(rt)) {
            let dest_resolved = self.resolve_type_alias_ref(lt);
            if (dest_resolved != null && tref_get_kind(dest_resolved) == ty_PTR()) {
                let adopted_dest = self.expr_adopts_expected_type(rhs, lt, rt);
                if (!adopted_dest) {
                    self.error_mismatch_at("assignment", lt, rt, expr_loc_ptr(rhs));
                }
            }
        }
        self.mark_identifier_moved_if_transfer(rhs, lt, false);
        if (root != null
            && tk == ex_MEMBER()) {
            self.unmark_field_moved(root, generic_call_base(expr_get_name(target)));
        }
        if (root != null
            && (tk == ex_IDENT()
                || (tk == ex_MEMBER()
                    && self.assign_reinitializes_consumed_place(target, rhs)))) {
            self.unmark_local_moved(root);
        }
        if (tk == ex_IDENT()
            && root != null
            && self.type_ref_is_pointer_handle(lt)) {
            var next_state = self.expr_alloc_state(rhs);
            let rhs_is_plain_alias = rhs != null
                && expr_get_kind(rhs) == ex_IDENT()
                && lt != null
                && tref_get_kind(lt) == ty_PTR();
            if (rhs_is_plain_alias) {
                next_state = sema_alloc_state_compat_alias();
            }
            let same_region = rhs_region != null
                && old_region != null
                && rhs_region == old_region;
            if (!same_region
                && old_region == root
                && (sym_get_shared_borrows(old_region) > 0
                    || sym_get_mutable_borrows(old_region) > 0)) {
                self.report_error_help(diag_code_v_borrow_invalidation(),
                                        expr_loc_ptr(target),
                                        "cannot rebind a pointer handle while its region is borrowed",
                                        "end borrows of this region before rebinding the handle");
            }
            if (!rhs_is_own
                && !same_region
                && (old_state == sema_alloc_state_owned_single()
                    || old_state == sema_alloc_state_owned_array())) {
                diag_emit_at(diag_sev_WARNING(),
                             diag_code_sema_generic(),
                             expr_loc_ptr(target),
                             "rebind overwrites a live owning pointer handle; delete it or use 'own' assignment to avoid leaking the old region");
                var next_is_array_region: bool = false;
                if (rhs != null && expr_get_kind(rhs) == ex_ADDR_OF()) {
                    let borrowed_value = expr_get_lhs(rhs);
                    let borrowed_type = expr_get_ty(borrowed_value);
                    next_is_array_region = borrowed_type != null
                        && tref_get_kind(borrowed_type) == ty_ARRAY();
                }
                if ((old_state == sema_alloc_state_owned_single() && next_is_array_region)
                    || (old_state == sema_alloc_state_owned_array() && !next_is_array_region)) {
                    diag_emit_at(diag_sev_WARNING(),
                                 diag_code_sema_generic(),
                                 expr_loc_ptr(target),
                                 "pointer rebind changes the region layout/extent; existing single-object and array views are not interchangeable");
                }
            }
            if (same_region) {
                next_state = old_state;
            }
            if (next_state == sema_alloc_state_none() && lt != null) {
                let lhs_kind = tref_get_kind(lt);
                if (lhs_kind == ty_PTR() || lhs_kind == ty_REF()
                    || lhs_kind == ty_MUTREF() || lhs_kind == ty_RAWPTR()) {
                    next_state = sema_alloc_state_unknown_pointer();
                }
            }
            if (!same_region) { sym_release_borrow(root); }
            sym_set_alloc_state(root, next_state);
            if (next_state == sema_alloc_state_borrowed_immutable()
                || next_state == sema_alloc_state_borrowed_mutable()
                || next_state == sema_alloc_state_compat_alias()) {
                sym_set_borrow_source(root, rhs_region);
                if (next_state == sema_alloc_state_borrowed_immutable()
                    || next_state == sema_alloc_state_borrowed_mutable()) {
                    sym_set_borrow_loc(root, expr_loc_ptr(rhs));
                } else {
                    sym_set_borrow_loc(root, null);
                }
            } else if (same_region) {
                // Preserve the canonical owner/root relationship for a
                // self/same-region alias assignment.
            } else {
                sym_set_borrow_source(root, null);
                sym_set_borrow_loc(root, null);
            }
            if (!same_region) { sym_register_borrow(root); }
        }
        if (rt != null) {
            return rt;
        }
        return lt;
    }

    // ── Unknown nominal type-name validation (post-pipeline) ───────────
    //
    // A misspelled nominal type in a signature (`r: uszie=0`) used to slip
    // through Sema as an opaque ty_CLASS and detonate later inside the MIR
    // builder as a pile of `build_call: argument type mismatch` diagnostics
    // at an unrelated call site. This pass runs at the very end of the host
    // analyze pipeline — after every import has been loaded — and reports
    // any remaining unresolvable nominal type name at its declaration site.

    public fn host_analyze_validate_nominal_type_refs(self, unit: rawptr) {
        if (unit == null) { return; }
        if (self.too_many_errors()) { return; }
        self.sema_validate_decl_chain_type_refs(unit_get_decls(unit), "");
    }

    public fn sema_validate_decl_chain_type_refs(self, head: rawptr, owner_gp: string) {
        var cur = head;
        while (cur != null && !self.too_many_errors()) {
            if (!decl_marked_imported(cur)) {
                self.sema_validate_one_decl_type_refs(cur, owner_gp);
            }
            cur = decl_get_next(cur);
        }
    }

    public fn sema_validate_one_decl_type_refs(self, d: rawptr, owner_gp: string) {
        if (d == null) { return; }
        sema_stamp_loc_from_decl(d);
        let gp = decl_get_generic_params(d);
        // merge_generic_params understands the "|kind:…|generics:…" meta
        // markers impl headers carry, unlike plain "," concatenation.
        let combined = merge_generic_params(owner_gp, gp);
        let k = decl_get_kind(d);
        if (k == de_FN() || k == de_METHOD()) {
            self.sema_validate_type_ref_diag(decl_get_ty(d), combined, "return type");
            var p = decl_get_params(d);
            while (p != null && !self.too_many_errors()) {
                self.sema_validate_type_ref_diag(decl_get_ty(p), combined, "parameter");
                p = decl_get_next(p);
            }
            if (self.sema_service_callable_needed(d)) {
                self.sema_validate_stmt_chain_type_refs(decl_get_body(d), combined);
            }
        } else if (k == de_CLASS() || k == de_ENUM()) {
            var m = decl_get_members(d);
            while (m != null && !self.too_many_errors()) {
                self.sema_validate_one_decl_type_refs(m, combined);
                m = decl_get_next(m);
            }
        } else {
            self.sema_validate_type_ref_diag(decl_get_ty(d), combined, "type");
        }
    }

    public fn sema_validate_stmt_chain_type_refs(self, s: rawptr, gp: string) {
        while (s != null && !self.too_many_errors()) {
            sema_stamp_loc_from_stmt(s);
            let k = stmt_get_kind(s);
            if (k == st_LET() || k == st_VAR()) {
                self.sema_validate_type_ref_diag(stmt_get_ty(s), gp, "variable");
            }
            if (k == st_BLOCK() || k == st_WHILE() || k == st_FOR() || k == st_FOREACH()) {
                self.sema_validate_stmt_chain_type_refs(stmt_get_body(s), gp);
            } else if (k == st_IF()) {
                self.sema_validate_stmt_chain_type_refs(stmt_get_then_blk(s), gp);
                self.sema_validate_stmt_chain_type_refs(stmt_get_else_blk(s), gp);
                self.sema_validate_stmt_chain_type_refs(stmt_get_body(s), gp);
            }
            s = stmt_get_next(s);
        }
    }

    public fn sema_validate_type_ref_diag(self, ty: rawptr, gp: string, ctx: string) {
        if (ty == null) { return; }
        let k = tref_get_kind(ty);
        if (k == ty_CLASS()) {
            let raw = tref_get_name(ty);
            if (raw.len == 0) { return; }
            if (raw == "dyn" || string_starts_with(raw, "dyn ")) { return; }
            // `dyn Trait` references reach Sema with the keyword glued to the
            // trait name (`dynView`), and the trait itself is registered in
            // the interface table rather than the class table — the nominal
            // lookup below can never satisfy it, so exempt the whole family.
            if (string_starts_with(raw, "dyn") && raw.len > 3) { return; }
            let base = generic_call_base(raw.clone());
            if (base.len == 0) { return; }
            if (base == "self" || base == "Self") { return; }
            if (type_name_is_primitive_text(base.clone())) { return; }
            if (generic_list_contains(gp, base.clone())) { return; }
            // Associated types declared inside an interface (`type Error;`)
            // are only reachable through the impl clause that binds them;
            // they are never class-table entries.
            if (string_contains(gp, "|kind:assoc_type")) { return; }
            // Variadic type-pack indexing inside a signature (`Ts[0]`) names
            // one element of a parameter pack.  The pack itself is the
            // generic entry, so resolve the head segment against it.
            var pack_i: i32 = 0;
            var pack_bracket: i32 = -1;
            while (pack_i < base.len) {
                if (base.charAt(pack_i) == 91) { pack_bracket = pack_i; break; }
                pack_i = pack_i + 1;
            }
            if (pack_bracket > 0) {
                let pack_name = str_view_range(base, 0, pack_bracket);
                if (generic_list_contains(gp, pack_name.clone())) { return; }
            }
            // Monomorphized clones can carry template spellings (`*T`) with
            // an empty generic env; a 1-2 char uppercase name is always a
            // type parameter in practice, never a real record name.
            if (generic_name_looks_like_placeholder(base.clone()) && base.len <= 2) {
                return;
            }
            // `Owner.Item` where the owner segment itself is a generic param.
            var dot_i: i32 = -1;
            var scan: i32 = 0;
            while (scan < base.len) {
                if (base.charAt(scan) == 46) { dot_i = scan; break; }
                scan = scan + 1;
            }
            if (dot_i > 0) {
                let owner = str_view_range(base, 0, dot_i);
                if (generic_list_contains(gp, owner.clone())) { return; }
            }
            if (self.sema_class_in_table(base.clone())) { return; }
            if (self.sema_materialize_named_type(base.clone())
                && self.sema_class_in_table(base.clone())) { return; }
            let suggestion = self.sema_suggest_type_name(base.clone());
            var msg = "unknown type '" + base + "'";
            if (ctx.len > 0) { msg = msg + " in " + ctx; }
            var help = "check spelling, or add a `use` import for this type";
            if (suggestion.len > 0) {
                help = "did you mean '" + suggestion + "'?";
            }
            if (sema_env_enabled("VYX_DUMP_UNKNOWNTY")) {
                print("[unknown-ty] base=" + base + " gp=" + gp + " ctx=" + ctx);
            }
            self.report_error_help(diag_code_sema_undefined(),
                                   sema_current_loc_ptr(), msg, help);
            return;
        }
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
            self.sema_validate_type_ref_diag(tref_pointee(ty), gp, ctx);
            return;
        }
        if (k == ty_ARRAY()) {
            self.sema_validate_type_ref_diag(tref_array_elem(ty), gp, ctx);
            return;
        }
        if (k == ty_TUPLE()) {
            var j: i64 = 0;
            let tn = tref_tuple_count(ty);
            while (j < tn) {
                self.sema_validate_type_ref_diag(tref_tuple_elem_at(ty, j), gp, ctx);
                j = j + 1;
            }
            return;
        }
        if (k == ty_FN() || k == ty_CFN()) {
            self.sema_validate_type_ref_diag(tref_fn_ret(ty), gp, ctx);
            var pi: i64 = 0;
            let pn = tref_fn_param_count(ty);
            while (pi < pn) {
                self.sema_validate_type_ref_diag(tref_fn_param_at(ty, pi), gp, ctx);
                pi = pi + 1;
            }
            return;
        }
    }

    /// Nearest known type name within edit distance 2, else "". Names of
    /// length <= 2 never get a suggestion (single letters match nothing
    /// useful and produce noise like "did you mean 'i8'?").
    public fn sema_suggest_type_name(self, name: string) -> string {
        if (name.len <= 2) { return ""; }
        var best: string = "";
        var best_d: i32 = 3;
        let prims = "usize,isize,i8,i16,i32,i64,u8,u16,u32,u64,f32,f64,bool,str,string,char,rawptr,void";
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= prims.len) {
            if (i == prims.len || prims.charAt(i) == 44) {
                let cand = str_view_range(prims, start, i);
                let d = self.sema_type_edit_distance(name, cand, 2);
                if (d < best_d) { best_d = d; best = cand.clone(); }
                start = i + 1;
            }
            i = i + 1;
        }
        var scan = self.classes_buf;
        while (scan != null) {
            let d2 = sym_get_decl(scan);
            if (d2 != null
                && (decl_get_kind(d2) == de_CLASS() || decl_get_kind(d2) == de_ENUM())) {
                let full = generic_call_base(decl_get_name(d2));
                let short = module_last_segment(full.clone());
                let d3 = self.sema_type_edit_distance(name, short.clone(), 2);
                if (d3 < best_d) { best_d = d3; best = short.clone(); }
            }
            scan = sym_get_next(scan);
        }
        return best;
    }

    /// Bounded Levenshtein distance; returns cap+1 as soon as the distance
    /// provably exceeds `cap`. Names longer than 63 chars are rejected.
    public fn sema_type_edit_distance(self, a: string, b: string, cap: i32) -> i32 {
        let n: i32 = a.len;
        let m: i32 = b.len;
        if (n >= 64 || m >= 64) { return cap + 1; }
        if (n - m > cap || m - n > cap) { return cap + 1; }
        var prev = new [i32; 64]();
        var curr = new [i32; 64]();
        var j: i32 = 0;
        while (j <= m) { (*prev)[j] = j; j = j + 1; }
        var i2: i32 = 1;
        while (i2 <= n) {
            (*curr)[0] = i2;
            var best = (*curr)[0];
            j = 1;
            while (j <= m) {
                var v = (*prev)[j] + 1;
                let v2 = (*curr)[j - 1] + 1;
                if (v2 < v) { v = v2; }
                var v3 = (*prev)[j - 1] + 1;
                if (a.charAt(i2 - 1) == b.charAt(j - 1)) { v3 = (*prev)[j - 1]; }
                if (v3 < v) { v = v3; }
                (*curr)[j] = v;
                if (v < best) { best = v; }
                j = j + 1;
            }
            if (best > cap) { return cap + 1; }
            var tmp = prev;
            prev = curr;
            curr = tmp;
            i2 = i2 + 1;
        }
        let out = (*prev)[m];
        if (out > cap) { return cap + 1; }
        return out;
    }

    // ── Host `Sema::analyze` pipeline (see module header table) ─────────

    /// `Sema::analyze` — **same call order** as `src/Sema/Sema.cpp:725+`.
    public fn run_host_analyze_pipeline(self, unit: rawptr) {
        if (unit == null) {
            return;
        }
        let prof_level = vyx_bootstrap_profile_level();
        var prof_total: i64 = 0;
        var prof_mark: i64 = 0;
        if (prof_level > 0) {
            prof_total = vyx_bootstrap_now_ms();
            prof_mark = prof_total;
        }
        var phase_t: i64 = sema_phase_enter();
        self.sema_scan_loaded_imports(unit);
        sema_phase_done("sema_scan_loaded_imports_unit;", phase_t);
        // Effect handlers that participate in declaration selection (currently
        // platform filtering) must stamp their compiler-owned authorization
        // before that phase runs.  The final normalization below rebuilds the
        // frozen plan after all semantic passes; this early pass only supplies
        // validated markers and never publishes a manifest.
        self.host_analyze_prepare_effect_markers(unit);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_filter_platform_decls(unit);
        sema_phase_done("host_analyze_filter_platform_decls_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_warn_empty_bodies(unit);
        sema_phase_done("host_analyze_warn_empty_bodies_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_reset_odr_state(unit);
        sema_phase_done("host_analyze_reset_odr_state_unit;", phase_t);
        prof_mark = sema_profile_mark(prof_level, "reset_odr", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_build_decl_module_map(unit);
        sema_phase_done("host_analyze_build_decl_module_map_unit;", phase_t);
        prof_mark = sema_profile_mark(prof_level, "decl_module_map", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_pass0_import_aliases(unit);
        sema_phase_done("host_analyze_pass0_import_aliases_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "pass0_import_aliases", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_apply_prelude_imports(unit);
        sema_phase_done("host_analyze_apply_prelude_imports_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_scan_lang_item_attributes(unit);
        sema_phase_done("host_analyze_scan_lang_item_attributes_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_phase_a_primitive_impl_facts(unit);
        sema_phase_done("host_analyze_phase_a_primitive_impl_facts_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.collect_decls(unit);
        sema_phase_done("collect_decls_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "collect_decls", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.flatten_all_inherited_layouts();
        sema_phase_done("flatten_all_inherited_layouts_;", phase_t);
        if (self.too_many_errors()) { return; }
        let lazy_sig_decl_before = self.profile_lazy_sig_decl_count;
        let lazy_type_ref_before = self.profile_lazy_type_ref_calls;
        let lazy_pending_before = self.profile_lazy_pending_calls;
        let registry_queries_before = self.profile_registry_symbol_queries;
        let registry_ms_before = self.profile_registry_symbol_ms;
        let module_load_calls_before = self.profile_module_load_calls;
        let module_load_ms_before = self.profile_module_load_ms;
        var phase_t: i64 = sema_phase_enter();
        self.sema_lazy_load_decl_signature_symbols(unit);
        sema_phase_done("sema_lazy_load_decl_signature_symbols_unit;", phase_t);
        if (prof_level > 0) {
            print("[sema-prof] signature_lazy_counts: decls="
                  + policy_i64_to_string(self.profile_lazy_sig_decl_count - lazy_sig_decl_before)
                  + " type_refs="
                  + policy_i64_to_string(self.profile_lazy_type_ref_calls - lazy_type_ref_before)
                  + " pending="
                  + policy_i64_to_string(self.profile_lazy_pending_calls - lazy_pending_before)
                  + " registry_queries="
                  + policy_i64_to_string(self.profile_registry_symbol_queries - registry_queries_before)
                  + " registry_ms="
                  + policy_i64_to_string(self.profile_registry_symbol_ms - registry_ms_before)
                  + " module_loads="
                  + policy_i64_to_string(self.profile_module_load_calls - module_load_calls_before)
                  + " module_load_ms="
                  + policy_i64_to_string(self.profile_module_load_ms - module_load_ms_before));
        }
        prof_mark = sema_profile_mark(prof_level, "signature_lazy_symbols", prof_mark);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.sema_lazy_load_unit_body_symbols(unit);
        sema_phase_done("sema_lazy_load_unit_body_symbols_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_register_std_short_name_aliases(unit);
        sema_phase_done("host_analyze_register_std_short_name_aliases_unit;", phase_t);
        prof_mark = sema_profile_mark(prof_level, "std_short_aliases", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_synthesize_derive_methods(unit);
        sema_phase_done("host_analyze_synthesize_derive_methods_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_phase_a_primitive_impl_facts(unit);
        sema_phase_done("host_analyze_phase_a_primitive_impl_facts_unit;", phase_t);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_decl_pass_non_functions(unit);
        sema_phase_done("host_analyze_decl_pass_non_functions_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "decl_pass_non_functions", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_inject_structural_trait_defaults(unit);
        sema_phase_done("host_analyze_inject_structural_trait_defaults_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "structural_defaults", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_infer_missing_return_types(unit);
        sema_phase_done("host_analyze_infer_missing_return_types_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "infer_return_types", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_decl_pass_functions(unit);
        sema_phase_done("host_analyze_decl_pass_functions_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        prof_mark = sema_profile_mark(prof_level, "decl_pass_functions", prof_mark);
        // Local method bodies must be resolved in *both* modes.
        // `host_analyze_prepare_hir_facts` (the `prepare_hir_facts` branch) only
        // enters declarations named in `hir_fact_root_names`, but the HIR builder
        // materializes a body for every function *reachable* from those roots.
        // A non-exported helper method pulled in that way was lowered with
        // untyped expressions: a generic method call in a match scrutinee left
        // the `case Err(e)` binding with an empty type, and codegen failed with
        // "cannot allocate local e with invalid type ``".  Local top-level fns
        // already receive this unconditional treatment from
        // host_analyze_decl_pass_functions, so local methods match them here.
        // Imported owners are skipped inside the pass, which preserves the
        // expensive imported-fact pruning this mode exists for.
        if (!self.prepare_hir_facts || self.hir_fact_root_names.len > 0) {
            var phase_t: i64 = sema_phase_enter();
            self.host_analyze_all_method_bodies(unit);
            sema_phase_done("host_analyze_all_method_bodies_unit;", phase_t);
            if (self.too_many_errors()) { return; }
        }
        prof_mark = sema_profile_mark(prof_level, "all_method_bodies", prof_mark);
        if (self.prepare_hir_facts) {
            var phase_t: i64 = sema_phase_enter();
            self.host_analyze_prepare_hir_facts(unit);
            sema_phase_done("host_analyze_prepare_hir_facts_unit;", phase_t);
            if (self.too_many_errors()) { return; }
            prof_mark = sema_profile_mark(prof_level, "prepare_hir_facts", prof_mark);
        }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_validate_nominal_type_refs(unit);
        sema_phase_done("validate_nominal_type_refs_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_normalize_effects(unit);
        sema_phase_done("host_analyze_normalize_effects_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        fact_base_freeze(self.fact_base);
        effect_plan_freeze(self.effect_plan);
        prof_mark = sema_profile_mark(prof_level, "resolve_unit", prof_mark);
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_ref_cycle_check(unit);
        sema_phase_done("host_analyze_ref_cycle_check_unit;", phase_t);
        if (self.too_many_errors()) { return; }
        var phase_t: i64 = sema_phase_enter();
        self.host_analyze_append_pending_instantiations(unit);
        sema_phase_done("host_analyze_append_pending_instantiations_unit;", phase_t);
        if (self.emit_stats) {
            self.host_analyze_dump_solver_stats(unit);
            self.host_analyze_dump_mono_scheduler_stats(unit);
            lang_items_dump_stats(self.lang_items);
        }
        sema_profile_mark(prof_level, "total", prof_total);
    }

    public fn host_analyze_reset_odr_state(self, unit: rawptr) {
        self.file_module = "";
        return;
    }

    /// Replay top-level `module` declarations — first non-imported wins (entry file).
    public fn host_analyze_build_decl_module_map(self, unit: rawptr) {
        if (unit == null) {
            return;
        }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_MODULE()
                && !string_starts_with(decl_get_name(cur), "__")
                && !string_contains(decl_get_meta(cur), "|imported")) {
                self.file_module = decl_get_name(cur);
                return;
            }
            cur = decl_get_next(cur);
        }
        return;
    }

    /// Pass 0: `use` → queue pending imports (`Sema.cpp` import/alias pass subset).
    public fn host_analyze_pass0_import_aliases(self, unit: rawptr) {
        if (unit == null) {
            return;
        }
        var cur = unit_get_decls(unit);
        let current_mod = self.file_module;
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let target = decl_get_name(cur);
                let alias = sema_use_decl_alias_name(decl_get_meta(cur));
                if (alias.len > 0) {
                    let parent = module_parent_path(generic_call_base(target.clone()));
                    if (parent.len > 0 && parent != current_mod) {
                        self.seed_use(parent);
                    } else if (target != current_mod) {
                        self.seed_use(target);
                    }
                } else {
                    if (target != current_mod) {
                        self.seed_use(target);
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }

    /// R5 prelude pre-pass — bootstrap mirror of
    /// `vyx::Sema::applyPreludeImports` (src/Sema/Sema.cpp L591).
    ///
    /// Walks the unit's top-level `use` declarations and records which
    /// well-known stdlib modules were imported into the
    /// `lang_items` prelude-active bit mask. The host equivalent
    /// also re-binds `Some/None/Ok/Err` into the symbol table for the
    /// turbofish-free callsites; bootstrap's `resolve_call` already
    /// short-circuits the four variant names directly (sema.vyx
    /// L4365–L4373), so the binding step is unnecessary here — the
    /// prelude-active mask is the actionable telemetry future WUs
    /// (lang-item-driven derive synthesis, `?`-sugar auto-wrap)
    /// consult to know whether a given prelude module is in scope.
    public fn host_analyze_apply_prelude_imports(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let path = decl_get_name(cur);
                if (path == "std.core" || path == "std::core") {
                    lang_items_prelude_set(
                        self.lang_items,
                        lang_items_prelude_bit_std_core());
                } else if (path == "std.result" || path == "std::result") {
                    lang_items_prelude_set(
                        self.lang_items,
                        lang_items_prelude_bit_std_result());
                } else if (path == "std.io" || path == "std::io") {
                    lang_items_prelude_set(
                        self.lang_items,
                        lang_items_prelude_bit_std_io());
                } else if (path == "std.string" || path == "std::string") {
                    lang_items_prelude_set(
                        self.lang_items,
                        lang_items_prelude_bit_std_string());
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    /// R5 lang-item scan — bootstrap mirror of
    /// `vyx::Sema::scanLangItemAttributes` (src/Sema/Sema.cpp L560).
    ///
    /// Harvests every `@[lang_item("<slot>")]` attribute from the
    /// unit's top-level declarations and records the slot → Decl
    /// pointer mapping in the registry. The bootstrap parser stores
    /// attributes in `decl_get_meta()` under the `|attrs:` marker as
    /// a comma-separated list of `@name(args)` tokens; we scan for
    /// the literal substring `lang_item(` and slurp the
    /// quoted slot name between the parentheses.
    ///
    /// First-wins semantics — duplicate registrations are absorbed
    /// silently (see `bootstrap.lang_items` header for why bootstrap
    /// stays silent on duplicates).
    public fn host_analyze_scan_lang_item_attributes(self, unit: rawptr) {
        if (unit == null) { return; }
        lang_items_clear(self.lang_items);
        var cur = unit_get_decls(unit);
        while (cur != null) {
            let meta = decl_get_meta(cur);
            if (meta.len > 0) {
                let slot = sema_extract_lang_item_slot(meta);
                if (slot.len > 0) {
                    lang_items_register(self.lang_items, slot, cur);
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }

    /// MOSP fact-dimension normalization.  Parsing has already preserved the
    /// original `@[name(...)]` token in declaration metadata; this pass turns
    /// it into deterministic EffectFacts before the semantic state freezes.
    /// Unknown attributes remain facts with `unregistered` status and cannot
    /// trigger lowering until a handler schema is explicitly registered.
    public fn host_analyze_normalize_effects(self, unit: rawptr) {
        if (unit == null) { return; }
        if (self.effect_plan == null) {
            self.report_error("EffectPlan allocation failed; cannot analyze effect metadata");
            return;
        }
        effect_plan_clear(self.effect_plan);
        effect_plan_collect_unit(self.effect_plan, unit);
        // A source `effect { ... }` declaration is a fact producer, not an
        // executable declaration.  Bind it to the already registered
        // compiler handler before importing/publishing the package plan.
        // This pass is deliberately after ordinary attributes have been
        // collected so `reads` can refer to facts emitted by attributes in
        // the same unit.
        // A validated producer manifest is part of this unit's fact input;
        // merge it before sealing/publishing so downstream lowering sees the
        // same provenance and fingerprint as local declarations.
        effect_plan_import_manifest(self.effect_plan);
        // Real --dci and source-discovered contracts enter through the same
        // EffectPlan.  This keeps lifecycle/exception obligations, endpoint
        // checks, and dependency cycles fail-closed before the plan freezes;
        // the external Python validator remains producer tooling only.
        effect_plan_import_dci_paths(self.effect_plan);
        // Effect declarations may read facts imported from another package,
        // so bind them only after the producer manifest and DCI graph have
        // entered this unit's ledger.
        self.host_analyze_collect_effect_decls(unit);
        effect_plan_publish_manifest(self.effect_plan, unit);
        effect_plan_publish_dci_export(self.effect_plan, unit);
        // Registered schemas may reject a declaration target, malformed
        // arguments, or an unsupported compiler callback.  Keep those
        // obligations in the normal diagnostic stream before freezing the
        // fact plan; otherwise the ledger would observe a failure that users
        // cannot act on and semantic analysis could continue fail-open.
        let effect_obligations = effect_plan_obligation_count(self.effect_plan);
        effect_plan_emit_obligations_at(self.effect_plan, g_sema_cur_loc);
        if (effect_obligations > 0) {
            // diag_emit_at carries the actionable obligation detail, while
            // report_error also increments Sema's error count so the driver
            // cannot continue into HIR/MIR lowering after a rejected Effect.
            self.report_error("EffectPlan contains unresolved obligations; lowering was not authorized");
        } elif (effect_plan_failure_count(self.effect_plan) > 0) {
            self.report_error("EffectPlan dispatch failed; no lowering was authorized");
        }
        return;
    }

    // ------------------------------------------------------------------
    // Source-level Effect declarations
    // ------------------------------------------------------------------
    // The parser stores a declaration as `de_EFFECT` and keeps its fields in
    // generic_params.  The wire spelling is intentionally boring and stable:
    // `|effect|effect_name:<id>|effect_field:<key>=<token-text>`.  Sema owns
    // all checks here; no source string is executed and the declaration never
    // enters HIR.

    fn sema_effect_field(self, gp: string, key: string) -> string {
        if (gp.len == 0 || key.len == 0) { return ""; }
        let marker = "|effect_field:" + key + "=";
        let pos = str_index_of(gp, marker);
        if (pos < 0) { return ""; }
        let start = pos + marker.len;
        // Stop at the next canonical marker rather than relying on a
        // character walk over the packed metadata string.  The parser keeps
        // field values token-concatenated, so this also preserves commas,
        // brackets and dotted fact ids without consuming the following
        // marker when the declaration crosses module boundaries.
        let tail = str_substring(gp, start as i64, gp.len as i64);
        let next = str_index_of(tail, "|effect_field:");
        if (next < 0) { return tail.trim(); }
        return tail.substring(0, next as i32).trim();
    }

    fn sema_effect_list_item(self, value: string, ordinal: i32) -> string {
        if (value.len == 0 || ordinal < 0) { return ""; }
        var text = value.trim();
        if (text.startsWith("[") && text.endsWith("]")) {
            text = text.substring(1, text.len - 1).trim();
        }
        var item: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= text.len) {
            if (i == text.len || text.charAt(i) == 44) {
                if (item == ordinal) { return text.substring(start, i).trim(); }
                item = item + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    fn sema_effect_list_count(self, value: string) -> i32 {
        if (value.trim().len == 0 || value.trim() == "[]") { return 0; }
        var count: i32 = 0;
        var i: i32 = 0;
        var text = value.trim();
        if (text.startsWith("[") && text.endsWith("]")) {
            text = text.substring(1, text.len - 1).trim();
        }
        if (text.len == 0) { return 0; }
        count = 1;
        while (i < text.len) {
            if (text.charAt(i) == 44) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    fn sema_effect_token_valid(self, value: string) -> bool {
        let v = value.trim();
        if (v.len == 0) { return false; }
        var i: i32 = 0;
        while (i < v.len) {
            let c = v.charAt(i);
            let ok = (c == 95 || c == 46 || c == 58 || c == 36
                || (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122));
            if (!ok) { return false; }
            i = i + 1;
        }
        return true;
    }

    fn sema_effect_handler_attribute(self, handler: string) -> string {
        let h = handler.trim();
        if (h == "migrate.collect") { return "migrate"; }
        if (h == "reflect.collect") { return "reflect"; }
        if (h == "derive.expand") { return "derive"; }
        if (h == "comptime.evaluate") { return "comptime"; }
        if (h == "async.lower") { return "async"; }
        if (h == "task.lower") { return "task"; }
        if (h == "platform.select") { return "platform"; }
        if (h == "dce.retain") { return "retain"; }
        if (h == "dci.import") { return "dci_import"; }
        if (h == "dci.export") { return "dci_export"; }
        if (h.startsWith("record.")) { return h.substring(7, h.len); }
        return h;
    }

    fn sema_effect_fact_matches(self, row: string, wanted: string) -> bool {
        if (row.len == 0 || wanted.len == 0) { return false; }
        // Effect manifest rows use ASCII US as their field separator.  Read
        // references may use `subject.attribute`, the attribute name alone,
        // or a previously provided fact id.
        let subject = self.sema_effect_row_field(row, 0);
        let attribute = self.sema_effect_row_field(row, 1);
        if (subject.len == 0 || attribute.len == 0) { return false; }
        return wanted == subject || wanted == attribute
            || wanted == subject + "." + attribute
            || wanted == attribute + "." + subject;
    }

    fn sema_effect_row_field(self, row: string, wanted: i32) -> string {
        if (row.len == 0 || wanted < 0) { return ""; }
        var field: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= row.len) {
            if (i == row.len || row.charAt(i) == 31) {
                if (field == wanted) { return row.substring(start, i); }
                field = field + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    fn sema_effect_read_known(self, plan: rawptr, unit: rawptr, wanted: string) -> bool {
        if (wanted.len == 0) { return false; }
        // These are stable MOSP fact identities, independent of whether a
        // particular unit currently emits a corresponding attribute row.
        // They let a pure declaration describe its input contract while
        // still rejecting arbitrary misspellings below.
        if (wanted == "migrate.field_alias" || wanted == "reflect.registration"
            || wanted == "reflect.name_alias" || wanted == "stable_identity"
            || wanted == "retain_metadata" || wanted == "abi.layout"
            || wanted == "abi.lifecycle" || wanted == "abi.exception") {
            return true;
        }
        var i: i32 = 0;
        while (i < effect_plan_fact_count(plan)) {
            if (self.sema_effect_fact_matches(effect_plan_fact_at(plan, i), wanted)) { return true; }
            i = i + 1;
        }
        // `provides` from another source Effect is a declaration-local fact
        // and is not present in the ordinary AttributeFact table yet.
        var d = if (unit == null) { null; } else { unit_get_decls(unit); };
        while (d != null) {
            if (decl_get_kind(d) == de_EFFECT()) {
                let provides = self.sema_effect_field(decl_get_generic_params(d), "provides");
                var p: i32 = 0;
                let n = self.sema_effect_list_count(provides);
                while (p < n) {
                    if (self.sema_effect_list_item(provides, p) == wanted) { return true; }
                    p = p + 1;
                }
            }
            d = decl_get_next(d);
        }
        return false;
    }

    fn sema_effect_decl(self, d: rawptr, unit: rawptr) {
        if (d == null || decl_get_kind(d) != de_EFFECT() || self.effect_plan == null) { return; }
        let gp = decl_get_generic_params(d);
        let name = self.sema_effect_field(gp, "");
        // effect_name is not an effect_field entry, so read its dedicated
        // marker without accepting a lookalike prefix.
        var effect_name = "";
        let name_marker = "|effect_name:";
        let name_pos = gp.indexOf(name_marker);
        if (name_pos >= 0) {
            let start = name_pos + name_marker.len;
            var end = start;
            while (end < gp.len && gp.charAt(end) != 124) { end = end + 1; }
            effect_name = gp.substring(start, end).trim();
        }
        if (effect_name.len == 0) { effect_name = decl_get_name(d); }
        let phase = self.sema_effect_field(gp, "phase");
        let reads = self.sema_effect_field(gp, "reads");
        let writes = self.sema_effect_field(gp, "writes");
        let provides = self.sema_effect_field(gp, "provides");
        let reqs = self.sema_effect_field(gp, "requires");
        let capability = self.sema_effect_field(gp, "capability");
        var handler = self.sema_effect_field(gp, "handler");
        let version = self.sema_effect_field(gp, "version");
        let scope = self.sema_effect_field(gp, "scope");
        var valid = true;
        let key = "effect:" + effect_name;
        if (!string_contains(gp, "|effect|")) {
            effect_plan_add_obligation(self.effect_plan, key, "EFFECT-SYNTAX",
                "effect declaration is missing its canonical marker");
            valid = false;
        }
        if (string_contains(gp, "|effect_invalid")) {
            effect_plan_add_obligation(self.effect_plan, key, "EFFECT-SYNTAX",
                "effect declaration contains an invalid or duplicate field");
            valid = false;
        }
        if (effect_name.len == 0 || !self.sema_effect_token_valid(effect_name)) {
            effect_plan_add_obligation(self.effect_plan, key, "EFFECT-NAME",
                "effect name is empty or malformed");
            valid = false;
        }
        if (phase.len == 0 || reads.len == 0 || provides.len == 0
            || reqs.len == 0 || capability.len == 0) {
            effect_plan_add_obligation(self.effect_plan, key, "EFFECT-FIELD",
                "phase, reads, provides, requires and capability are required");
            valid = false;
        }
        // A declaration without `handler` is intentionally data-only: it
        // records a future fact contract and must not guess a compiler
        // callback from its effect name.  An explicit handler is checked
        // against the registered schema and may constrain its version.  The
        // capability list is a declaration of required facts; it is not an
        // authorization to invoke arbitrary host code.
        var handler_attr = "";
        var handler_version = "";
        if (handler.len > 0) {
            handler_attr = self.sema_effect_handler_attribute(handler);
            handler_version = effect_plan_handler_version(self.effect_plan, handler_attr);
            if (handler_version.len == 0) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-HANDLER",
                    "effect handler '" + handler + "' is not registered");
                valid = false;
            } elif (version.len > 0 && version != handler_version) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-VERSION",
                    "effect handler version does not match the registered schema");
                valid = false;
            }
        }
        var ci: i32 = 0;
        let cap_count = self.sema_effect_list_count(capability);
        while (ci < cap_count) {
            let requested = self.sema_effect_list_item(capability, ci);
            if (!self.sema_effect_token_valid(requested)
                || !self.sema_effect_capability_known(requested)) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-CAPABILITY",
                    "effect requests a malformed capability");
                valid = false;
            }
            ci = ci + 1;
        }
        var ri: i32 = 0;
        let read_count = self.sema_effect_list_count(reads);
        while (ri < read_count) {
            let read = self.sema_effect_list_item(reads, ri);
            if (!self.sema_effect_token_valid(read)
                || !self.sema_effect_read_known(self.effect_plan, unit, read)) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-READ",
                    "effect reads an unknown fact '" + read + "'");
                valid = false;
            }
            ri = ri + 1;
        }
        var pi: i32 = 0;
        let provide_count = self.sema_effect_list_count(provides);
        while (pi < provide_count) {
            if (!self.sema_effect_token_valid(self.sema_effect_list_item(provides, pi))) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-WRITE",
                    "effect provides a malformed fact id");
                valid = false;
            }
            pi = pi + 1;
        }
        var wi: i32 = 0;
        let write_count = self.sema_effect_list_count(writes);
        while (wi < write_count) {
            if (!self.sema_effect_token_valid(self.sema_effect_list_item(writes, wi))) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-WRITE",
                    "effect writes a malformed fact id");
                valid = false;
            }
            wi = wi + 1;
        }
        let status = if (valid) { "handled"; } else { "rejected"; };
        var fact_phase = phase;
        if (fact_phase.len == 0) { fact_phase = "declaration"; }
        var fact_scope = scope;
        if (fact_scope.len == 0) { fact_scope = "unit"; }
        let normalized = "phase=" + phase + ";handler=" + handler_attr
            + ";reads=" + reads + ";writes=" + writes
            + ";provides=" + provides + ";requires=" + reqs
            + ";capability=" + capability + ";version=" + version
            + ";scope=" + scope;
        effect_plan_add_fact(self.effect_plan,
            EffectFact.create(effect_name, "effect", normalized,
                              fact_phase, fact_scope, status));
        if (valid) {
            if (handler_attr.len > 0
                && !effect_plan_add_edge(self.effect_plan, "effect:" + effect_name,
                                         "effect:" + handler_attr, "handler")) {
                effect_plan_add_obligation(self.effect_plan, key, "EFFECT-DEPENDENCY",
                    "effect handler dependency was rejected");
            }
            // Keep the declaration visible to diagnostics/manifests while
            // preventing it from becoming a lowering marker or HIR item.
            decl_set_meta(d, decl_get_meta(d) + "|effect:handled|");
        }
    }

    fn sema_effect_capability_known(self, value: string) -> bool {
        let v = value.trim();
        if (v == "retain_metadata" || v == "compiler.core"
            || v == "effect.record" || v == "abi.lifecycle"
            || v == "abi.exception" || v == "layout" || v == "reflection") {
            return true;
        }
        return v.startsWith("effect.declarative.") && v.len > 20;
    }

    public fn host_analyze_collect_effect_decls(self, unit: rawptr) {
        if (unit == null || self.effect_plan == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_EFFECT()) { self.sema_effect_decl(cur, unit); }
            cur = decl_get_next(cur);
        }
    }

    /// Stamp compiler-owned Effect authorization before declaration-selection
    /// passes.  This deliberately does not import manifests, publish output,
    /// or emit diagnostics; the late normalization pass owns those actions.
    public fn host_analyze_prepare_effect_markers(self, unit: rawptr) {
        if (unit == null || self.effect_plan == null) { return; }
        effect_plan_clear(self.effect_plan);
        effect_plan_collect_unit(self.effect_plan, unit);
    }
    /// PLAN_SEMA_ROOT_FIX — S3 Phase A discovery.
    ///
    /// Walks every top-level `impl <Trait> for <Primitive>` declaration in
    /// source order and registers the `(Prim, Trait)` pair into
    /// `self.fact_base`. Mirrors the host C++ loop in
    /// `vyx::Sema::analyze` (src/Sema/Sema.cpp L886–L897):
    ///
    /// ```
    /// for (auto& decl : unit.declarations) {
    ///     if (!decl || decl->kind != DeclKind::Class) continue;
    ///     auto* cd = decl->as<ClassDecl>();
    ///     if (!cd || !cd->isImplBlock || !isPrimitiveTypeName(decl->name)) continue;
    ///     for (auto& traitName : cd->interfaces) {
    ///         recordPrimImplFact(decl->name, traitName);
    ///     }
    /// }
    /// factBase_.freeze();
    /// ```
    ///
    /// In the bootstrap AST an `impl` block is encoded as a `de_CLASS`
    /// decl whose `generic_params` meta string carries `|kind:impl` and
    /// `|impl:<TraitPath>,` (see `Parser.parse_impl_decl`). Bit 64 in
    /// `decl_get_generic_flags` is pre-set by `decl_compute_generic_flags`
    /// whenever the meta contains `|impl:`, so the walk is a single
    /// linked-list traversal with no string re-scan per node.
    public fn host_analyze_phase_a_primitive_impl_facts(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_CLASS()) {
                let flags = decl_get_generic_flags(cur);
                if ((flags & 64) != 0) {
                    let target = decl_get_name(cur);
                    let gp = decl_get_generic_params(cur);
                    // `interface Child : Parent` also stores `|impl:Parent,`.
                    // That is a supertrait list, not `impl Parent for Child`.
                    if (string_contains(gp, "|kind:interface")) {
                        cur = decl_get_next(cur);
                        continue;
                    }
                    let trait_name = sema_extract_impl_trait_meta(gp);
                    if (trait_name.len > 0 && target.len > 0) {
                        let generics = sema_extract_meta_field(gp, "|generics:");
                        let where_text = sema_extract_meta_field(gp, "|where:");
                        if (sema_csv_has_name(generics, target)) {
                            fact_base_register_blanket_impl(
                                self.fact_base, trait_name, target, generics, where_text);
                        } else if (policy_primitive_type_kind(target) != 0) {
                            fact_base_register_prim_impl(
                                self.fact_base, target, trait_name);
                        } else {
                            fact_base_register_type_impl(
                                self.fact_base, target, trait_name);
                        }
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    /// P4-A.2-style short name → same `Decl*` when qualified name is registered and bare unused.
    public fn host_analyze_register_std_short_name_aliases(self, unit: rawptr) {
        if (unit == null) {
            return;
        }
        var unaliased_use_modules: string = "|";
        var use_cur = unit_get_decls(unit);
        while (use_cur != null) {
            if (decl_get_kind(use_cur) == de_USE() && !decl_marked_imported(use_cur)) {
                let use_meta = decl_get_meta(use_cur);
                if (sema_use_decl_alias_name(use_meta).len == 0) {
                    let use_target = generic_call_base(decl_get_name(use_cur).clone());
                    if (use_target.len > 0
                        && !string_contains(unaliased_use_modules,
                                            "|" + use_target + "|")) {
                        unaliased_use_modules = unaliased_use_modules + use_target + "|";
                    }
                }
            }
            use_cur = decl_get_next(use_cur);
        }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_CLASS()) {
                let q = decl_get_name(cur);
                let shortn = module_last_segment(q);
                if (decl_marked_imported(cur)
                    && !decl_from_std_module(cur)) {
                    let from_mod = self.extract_from_module(decl_get_meta(cur));
                    if (!string_contains(unaliased_use_modules, "|" + from_mod + "|")) {
                        cur = decl_get_next(cur);
                        continue;
                    }
                }
                if (shortn == q) {
                    cur = decl_get_next(cur);
                    continue;
                }
                let short_ent = sym_lookup(self.classes_buf, shortn);
                if (short_ent != null) {
                    let short_decl = sym_get_decl(short_ent);
                    let qent_existing = sym_lookup(self.classes_buf, q);
                    var qdecl_existing: rawptr = null;
                    if (qent_existing != null) { qdecl_existing = sym_get_decl(qent_existing); }
                    if (short_decl != null
                        && qdecl_existing != null
                        && decl_marked_imported(short_decl)
                        && !decl_marked_imported(qdecl_existing)) {
                        self.classes_buf = sym_push_decl(self.classes_buf, shortn, qdecl_existing);
                    }
                    cur = decl_get_next(cur);
                    continue;
                }
                let qent = sym_lookup(self.classes_buf, q);
                if (qent == null) {
                    cur = decl_get_next(cur);
                    continue;
                }
                let cdecl = sym_get_decl(qent);
                if (cdecl == null) {
                    cur = decl_get_next(cur);
                    continue;
                }
                self.classes_buf = sym_push_decl(self.classes_buf, shortn, cdecl);
            }
            cur = decl_get_next(cur);
        }
        return;
    }

    public fn derive_is_instance_field(self, member: rawptr) -> bool {
        if (member == null) { return false; }
        if (decl_get_kind(member) != de_FIELD()) { return false; }
        let gp = decl_get_generic_params(member);
        if (string_contains(gp, "|kind:assoc_const")) { return false; }
        if (string_contains(gp, "|kind:assoc_type")) { return false; }
        if (decl_get_is_static(member)) { return false; }
        if (string_contains(decl_get_meta(member), "|marker:static")) { return false; }
        return true;
    }

    public fn derive_method_exists(self, cd: rawptr, method_name: string) -> bool {
        if (cd == null || method_name.len == 0) { return false; }
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_METHOD()
                && sema_method_name_matches_lookup(decl_get_name(mp), method_name)) {
                return true;
            }
            mp = decl_get_next(mp);
        }
        return false;
    }

    public fn derive_field_type_satisfies(self,
                                          cd: rawptr,
                                          field_decl: rawptr,
                                          trait_name: string) -> bool {
        if (cd == null || field_decl == null) { return true; }
        let ty = decl_get_ty(field_decl);
        let tn = type_text_from_ty(ty);
        let trait_key = sema_derive_trait_key(trait_name);
        if (tn.len == 0) {
            self.report_error_help(diag_code_sema_trait_bound(),
                                   g_sema_cur_loc,
                                   "@[derive(" + trait_key + ")] on '"
                                       + decl_get_name(cd)
                                       + "' cannot use field '"
                                       + decl_get_name(field_decl)
                                       + "': field type is unresolved",
                                   "give the field an explicit type that implements " + trait_key);
            return false;
        }
        if (trait_key == "Clone") {
            if (tn == "rawptr" || string_starts_with(tn, "*")) {
                self.report_error_help(diag_code_sema_trait_bound(),
                                        g_sema_cur_loc,
                                        "@[derive(Clone)] on '"
                                            + decl_get_name(cd)
                                            + "' cannot use field '"
                                            + decl_get_name(field_decl)
                                            + "' of type '"
                                            + tn
                                            + "': raw pointer fields need a handwritten clone()",
                                        "write a custom `clone()` instead of `@[derive(Clone)]`, or store an owned type");
                return false;
            }
        }
        let gp_head = generic_param_head(decl_get_generic_params(cd));
        if (generic_list_contains(gp_head, tn)) {
            return true;
        }
        if (self.type_satisfies_trait(tn.clone(), trait_key.clone())) {
            return true;
        }
        self.report_error_help(diag_code_sema_trait_bound(),
                               g_sema_cur_loc,
                               "@[derive(" + trait_key + ")] on '"
                                   + decl_get_name(cd)
                                   + "' cannot use field '"
                                   + decl_get_name(field_decl)
                                   + "' of type '"
                                   + tn
                                   + "': field type does not satisfy "
                                   + trait_key,
                               "impl " + trait_key + " for '" + tn + "', or drop that field from the derived type");
        return false;
    }

    public fn derive_fields_satisfy(self, cd: rawptr, trait_name: string) -> bool {
        if (cd == null) { return false; }
        var ok: bool = true;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                if (!self.derive_field_type_satisfies(cd, mp, trait_name)) {
                    ok = false;
                }
            } else if (decl_get_kind(mp) == de_VARIANT()) {
                var pp = decl_get_params(mp);
                while (pp != null) {
                    if (!self.derive_field_type_satisfies(cd, pp, trait_name)) {
                        ok = false;
                    }
                    pp = decl_get_next(pp);
                }
            }
            mp = decl_get_next(mp);
        }
        return ok;
    }

    public fn derive_append_method(self, cd: rawptr, md: rawptr) {
        if (cd == null || md == null) { return; }
        if (decl_get_members(cd) == null) {
            decl_set_members(cd, md);
            return;
        }
        var tail = decl_get_members(cd);
        while (decl_get_next(tail) != null) {
            tail = decl_get_next(tail);
        }
        decl_set_next(tail, md);
    }

    public fn derive_param(self, name: string, ty: rawptr) -> rawptr {
        let p = decl_alloc(de_FIELD(), name);
        decl_set_ty(p, ty);
        return p;
    }

    public fn derive_is_enum(self, cd: rawptr) -> bool {
        return cd != null && decl_get_kind(cd) == de_ENUM();
    }

    public fn derive_finish_method(self, cd: rawptr, md: rawptr) {
        if (cd == null || md == null) { return; }
        self.ensure_method_self_param(cd, md);
        self.derive_append_method(cd, md);
    }

    public fn derive_bind_name(self, prefix: string, idx: i32) -> string {
        return prefix + policy_i64_to_string(idx as i64);
    }

    public fn derive_variant_pattern(self, vd: rawptr, bind_prefix: string) -> rawptr {
        if (vd == null) { return sema_expr_ident("_"); }
        let vname = decl_get_name(vd);
        if (decl_get_params(vd) == null) {
            return sema_expr_ident(vname);
        }
        var args: rawptr = null;
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            args = sema_arg_append(
                args,
                sema_arg_cell(sema_expr_ident(self.derive_bind_name(bind_prefix, idx))));
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return sema_expr_call_ident(vname, args);
    }

    public fn derive_variant_ctor_cloned(self, vd: rawptr, bind_prefix: string) -> rawptr {
        if (vd == null) { return sema_expr_ident("self"); }
        let vname = decl_get_name(vd);
        if (decl_get_params(vd) == null) {
            return sema_expr_ident(vname);
        }
        var args: rawptr = null;
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            let bind = sema_expr_ident(self.derive_bind_name(bind_prefix, idx));
            args = sema_arg_append(
                args,
                sema_arg_cell(sema_expr_method_call(bind, "clone", null)));
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return sema_expr_call_ident(vname, args);
    }

    public fn derive_payload_eq_expr(self, vd: rawptr) -> rawptr {
        var cond: rawptr = null;
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            let term = sema_expr_method_call(
                sema_expr_ident(self.derive_bind_name("__vyx_s", idx)),
                "operator_eq",
                sema_arg_cell(sema_expr_ident(self.derive_bind_name("__vyx_o", idx))));
            if (cond == null) {
                cond = term;
            } else {
                cond = sema_expr_bin(tk_AND(), cond, term);
            }
            idx = idx + 1;
            p = decl_get_next(p);
        }
        if (cond == null) { return sema_expr_bool_lit(true); }
        return cond;
    }

    public fn derive_payload_ord_body(self, vd: rawptr) -> rawptr {
        var body: rawptr = null;
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            let cname = "__vyx_derive_cmp" + policy_i64_to_string(idx as i64);
            let cmp = sema_expr_method_call(
                sema_expr_ident(self.derive_bind_name("__vyx_s", idx)),
                "compare",
                sema_arg_cell(sema_expr_ident(self.derive_bind_name("__vyx_o", idx))));
            body = sema_stmt_append(body,
                                     sema_stmt_var(cname,
                                                   tref_create_kind(ty_I32()),
                                                   cmp));
            let neq = sema_expr_bin(tk_NEQ(),
                                     sema_expr_ident(cname),
                                     sema_expr_int_lit(0));
            body = sema_stmt_append(body,
                                     sema_stmt_if_return(neq,
                                                         sema_expr_ident(cname)));
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return sema_stmt_append(body, sema_stmt_return(sema_expr_int_lit(0)));
    }

    public fn derive_payload_hash_body(self, vd: rawptr, tag: i32) -> rawptr {
        var body: rawptr = sema_stmt_var("h",
                                          tref_create_kind(ty_I64()),
                                          sema_expr_int_lit(tag as i64));
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            let hv = sema_expr_method_call(
                sema_expr_ident(self.derive_bind_name("__vyx_h", idx)),
                "hash",
                null);
            body = sema_stmt_append(
                body,
                sema_stmt_expr(sema_expr_assign(sema_expr_ident("h"),
                                                sema_hash_mix(sema_expr_ident("h"), hv))));
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return sema_stmt_append(body, sema_stmt_return(sema_expr_ident("h")));
    }

    public fn derive_payload_fmt_expr(self, vd: rawptr, method_name: string) -> rawptr {
        let vname = decl_get_name(vd);
        if (decl_get_params(vd) == null) {
            return sema_expr_string_lit(vname);
        }
        var out: rawptr = sema_expr_string_lit(vname + "(");
        var first: bool = true;
        var idx: i32 = 0;
        var p = decl_get_params(vd);
        while (p != null) {
            if (!first) {
                out = sema_expr_bin(tk_PLUS(), out, sema_expr_string_lit(", "));
            }
            out = sema_expr_bin(
                tk_PLUS(),
                out,
                sema_expr_method_call(
                    sema_expr_ident(self.derive_bind_name("__vyx_g", idx)),
                    method_name,
                    null));
            first = false;
            idx = idx + 1;
            p = decl_get_next(p);
        }
        return sema_expr_bin(tk_PLUS(), out, sema_expr_string_lit(")"));
    }

    public fn derive_synthesize_eq(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        if (self.derive_method_exists(cd, "operator_eq")) {
            sema_decl_mark_trait_impl(cd, "Eq");
            return true;
        }
        if (!self.derive_fields_satisfy(cd, "Eq")) { return false; }
        if (self.derive_is_enum(cd)) { return self.derive_synthesize_enum_eq(cd); }
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "operator_eq");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_BOOL()));
        decl_set_params(md, self.derive_param("other", tref_create_class(self_ty_name)));

        var cond: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                let fname = decl_get_name(mp);
                let term = sema_expr_method_call(
                    sema_expr_self_field(fname),
                    "operator_eq",
                    sema_arg_cell(sema_expr_other_field(fname)));
                if (cond == null) {
                    cond = term;
                } else {
                    cond = sema_expr_bin(tk_AND(), cond, term);
                }
            }
            mp = decl_get_next(mp);
        }
        if (cond == null) { cond = sema_expr_bool_lit(true); }
        decl_set_body(md, sema_stmt_block(sema_stmt_return(cond)));
        self.derive_append_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Eq");
        return true;
    }

    public fn derive_synthesize_clone(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        if (self.derive_method_exists(cd, "clone")) {
            sema_decl_mark_trait_impl(cd, "Clone");
            return true;
        }
        if (!self.derive_fields_satisfy(cd, "Clone")) { return false; }
        if (self.derive_is_enum(cd)) { return self.derive_synthesize_enum_clone(cd); }
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "clone");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_class(self_ty_name));
        var fields: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                let fname = decl_get_name(mp);
                let cloned = sema_expr_method_call(sema_expr_self_field(fname),
                                                   "clone",
                                                   null);
                fields = sema_struct_init_add_field(fields, fname, cloned);
            }
            mp = decl_get_next(mp);
        }
        decl_set_body(md,
                      sema_stmt_block(
                          sema_stmt_return(
                              sema_expr_struct_init(self_ty_name, fields))));
        self.derive_append_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Clone");
        decl_set_meta(cd, decl_get_meta(cd) + "|clone:deep");
        return true;
    }

    public fn derive_synthesize_hash(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        if (self.derive_method_exists(cd, "hash")) {
            sema_decl_mark_trait_impl(cd, "Hashable");
            return true;
        }
        if (!self.derive_fields_satisfy(cd, "Hashable")) { return false; }
        if (self.derive_is_enum(cd)) { return self.derive_synthesize_enum_hash(cd); }
        let md = decl_alloc(de_METHOD(), "hash");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_I64()));
        var body: rawptr = sema_stmt_var("h",
                                         tref_create_kind(ty_I64()),
                                         sema_expr_int_lit(0));
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                let fname = decl_get_name(mp);
                let hv = sema_expr_method_call(sema_expr_self_field(fname),
                                               "hash",
                                               null);
                let mixed = sema_hash_mix(sema_expr_ident("h"), hv);
                body = sema_stmt_append(
                    body,
                    sema_stmt_expr(sema_expr_assign(sema_expr_ident("h"), mixed)));
            }
            mp = decl_get_next(mp);
        }
        body = sema_stmt_append(body, sema_stmt_return(sema_expr_ident("h")));
        decl_set_body(md, sema_stmt_block(body));
        self.derive_append_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Hashable");
        return true;
    }

    public fn derive_synthesize_ord(self, cd: rawptr) -> bool {
        if (cd == null) { return false; }
        if (self.derive_method_exists(cd, "compare")) {
            sema_decl_mark_trait_impl(cd, "Ord");
            return true;
        }
        if (!self.derive_fields_satisfy(cd, "Ord")) { return false; }
        if (self.derive_is_enum(cd)) { return self.derive_synthesize_enum_ord(cd); }
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "compare");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_I32()));
        decl_set_params(md, self.derive_param("other", tref_create_class(self_ty_name)));
        var body: rawptr = null;
        var idx: i32 = 0;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                let fname = decl_get_name(mp);
                let cname = "__vyx_derive_cmp" + policy_i64_to_string(idx as i64);
                let cmp = sema_expr_method_call(
                    sema_expr_self_field(fname),
                    "compare",
                    sema_arg_cell(sema_expr_other_field(fname)));
                body = sema_stmt_append(body,
                                        sema_stmt_var(cname,
                                                      tref_create_kind(ty_I32()),
                                                      cmp));
                let neq = sema_expr_bin(tk_NEQ(),
                                        sema_expr_ident(cname),
                                        sema_expr_int_lit(0));
                body = sema_stmt_append(body,
                                        sema_stmt_if_return(neq,
                                                            sema_expr_ident(cname)));
                idx = idx + 1;
            }
            mp = decl_get_next(mp);
        }
        body = sema_stmt_append(body, sema_stmt_return(sema_expr_int_lit(0)));
        decl_set_body(md, sema_stmt_block(body));
        self.derive_append_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Ord");
        return true;
    }

    public fn derive_synthesize_debug_like(self,
                                           cd: rawptr,
                                           trait_name: string,
                                           method_name: string) -> bool {
        if (cd == null) { return false; }
        if (self.derive_method_exists(cd, method_name)) {
            sema_decl_mark_trait_impl(cd, trait_name);
            return true;
        }
        if (!self.derive_fields_satisfy(cd, trait_name)) { return false; }
        if (self.derive_is_enum(cd)) {
            return self.derive_synthesize_enum_debug_like(cd, trait_name, method_name);
        }
        let is_debug = method_name == "debug";
        let md = decl_alloc(de_METHOD(), method_name);
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_STRING()));
        var out: rawptr = null;
        if (is_debug) {
            out = sema_expr_string_lit(decl_get_name(cd) + "{");
        }
        var first: bool = true;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (self.derive_is_instance_field(mp)) {
                let fname = decl_get_name(mp);
                if (out == null) {
                    out = sema_expr_method_call(sema_expr_self_field(fname),
                                                method_name,
                                                null);
                } else {
                    var prefix = ", ";
                    if (first && is_debug) { prefix = ""; }
                    if (is_debug) { prefix = prefix + fname + "="; }
                    out = sema_expr_bin(tk_PLUS(), out, sema_expr_string_lit(prefix));
                    out = sema_expr_bin(
                        tk_PLUS(),
                        out,
                        sema_expr_method_call(sema_expr_self_field(fname),
                                              method_name,
                                              null));
                }
                first = false;
            }
            mp = decl_get_next(mp);
        }
        if (out == null) { out = sema_expr_string_lit(""); }
        if (is_debug) {
            out = sema_expr_bin(tk_PLUS(), out, sema_expr_string_lit("}"));
        }
        decl_set_body(md, sema_stmt_block(sema_stmt_return(out)));
        self.derive_append_method(cd, md);
        sema_decl_mark_trait_impl(cd, trait_name);
        return true;
    }

    public fn derive_synthesize_enum_eq(self, cd: rawptr) -> bool {
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "operator_eq");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_BOOL()));
        decl_set_params(md, self.derive_param("other", tref_create_class(self_ty_name)));
        var arms: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_VARIANT()) {
                var inner: rawptr = null;
                inner = sema_stmt_append(
                    inner,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_o"),
                        sema_stmt_block(sema_stmt_return(self.derive_payload_eq_expr(mp)))));
                inner = sema_stmt_append(
                    inner,
                    sema_match_default_arm(
                        sema_stmt_block(sema_stmt_return(sema_expr_bool_lit(false)))));
                arms = sema_stmt_append(
                    arms,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_s"),
                        sema_stmt_block(sema_stmt_match(sema_expr_ident("other"), inner))));
            }
            mp = decl_get_next(mp);
        }
        arms = sema_stmt_append(
            arms,
            sema_match_default_arm(
                sema_stmt_block(sema_stmt_return(sema_expr_bool_lit(false)))));
        decl_set_body(md, sema_stmt_block(sema_stmt_match(sema_expr_ident("self"), arms)));
        self.derive_finish_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Eq");
        return true;
    }

    public fn derive_synthesize_enum_clone(self, cd: rawptr) -> bool {
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "clone");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_class(self_ty_name));
        var arms: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_VARIANT()) {
                arms = sema_stmt_append(
                    arms,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_c"),
                        sema_stmt_block(
                            sema_stmt_return(
                                self.derive_variant_ctor_cloned(mp, "__vyx_c")))));
            }
            mp = decl_get_next(mp);
        }
        arms = sema_stmt_append(
            arms,
            sema_match_default_arm(
                sema_stmt_block(sema_stmt_return(sema_expr_ident("self")))));
        decl_set_body(md, sema_stmt_block(sema_stmt_match(sema_expr_ident("self"), arms)));
        self.derive_finish_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Clone");
        decl_set_meta(cd, decl_get_meta(cd) + "|clone:deep");
        return true;
    }

    public fn derive_synthesize_enum_hash(self, cd: rawptr) -> bool {
        let md = decl_alloc(de_METHOD(), "hash");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_I64()));
        var arms: rawptr = null;
        var tag: i32 = 0;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_VARIANT()) {
                arms = sema_stmt_append(
                    arms,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_h"),
                        sema_stmt_block(self.derive_payload_hash_body(mp, tag))));
                tag = tag + 1;
            }
            mp = decl_get_next(mp);
        }
        arms = sema_stmt_append(
            arms,
            sema_match_default_arm(
                sema_stmt_block(sema_stmt_return(sema_expr_int_lit(0)))));
        decl_set_body(md, sema_stmt_block(sema_stmt_match(sema_expr_ident("self"), arms)));
        self.derive_finish_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Hashable");
        return true;
    }

    public fn derive_synthesize_enum_ord(self, cd: rawptr) -> bool {
        let self_ty_name = sema_decl_self_type_name(cd);
        let md = decl_alloc(de_METHOD(), "compare");
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_I32()));
        decl_set_params(md, self.derive_param("other", tref_create_class(self_ty_name)));
        var arms: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_VARIANT()) {
                var inner: rawptr = null;
                var earlier = decl_get_members(cd);
                while (earlier != null && earlier != mp) {
                    if (decl_get_kind(earlier) == de_VARIANT()) {
                        inner = sema_stmt_append(
                            inner,
                            sema_match_arm(
                                self.derive_variant_pattern(earlier, "__vyx_o"),
                                sema_stmt_block(sema_stmt_return(sema_expr_int_lit(1)))));
                    }
                    earlier = decl_get_next(earlier);
                }
                inner = sema_stmt_append(
                    inner,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_o"),
                        sema_stmt_block(self.derive_payload_ord_body(mp))));
                inner = sema_stmt_append(
                    inner,
                    sema_match_default_arm(
                        sema_stmt_block(sema_stmt_return(sema_expr_int_lit(-1)))));
                arms = sema_stmt_append(
                    arms,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_s"),
                        sema_stmt_block(sema_stmt_match(sema_expr_ident("other"), inner))));
            }
            mp = decl_get_next(mp);
        }
        arms = sema_stmt_append(
            arms,
            sema_match_default_arm(
                sema_stmt_block(sema_stmt_return(sema_expr_int_lit(0)))));
        decl_set_body(md, sema_stmt_block(sema_stmt_match(sema_expr_ident("self"), arms)));
        self.derive_finish_method(cd, md);
        sema_decl_mark_trait_impl(cd, "Ord");
        return true;
    }

    public fn derive_synthesize_enum_debug_like(self,
                                                cd: rawptr,
                                                trait_name: string,
                                                method_name: string) -> bool {
        let md = decl_alloc(de_METHOD(), method_name);
        decl_set_is_public(md, true);
        decl_set_ty(md, tref_create_kind(ty_STRING()));
        var arms: rawptr = null;
        var mp = decl_get_members(cd);
        while (mp != null) {
            if (decl_get_kind(mp) == de_VARIANT()) {
                arms = sema_stmt_append(
                    arms,
                    sema_match_arm(
                        self.derive_variant_pattern(mp, "__vyx_g"),
                        sema_stmt_block(
                            sema_stmt_return(
                                self.derive_payload_fmt_expr(mp, method_name)))));
            }
            mp = decl_get_next(mp);
        }
        arms = sema_stmt_append(
            arms,
            sema_match_default_arm(
                sema_stmt_block(sema_stmt_return(sema_expr_string_lit("")))));
        decl_set_body(md, sema_stmt_block(sema_stmt_match(sema_expr_ident("self"), arms)));
        self.derive_finish_method(cd, md);
        sema_decl_mark_trait_impl(cd, trait_name);
        return true;
    }

    public fn derive_report_unknown_traits(self, cd: rawptr) {
        if (cd == null) { return; }
        let meta = decl_get_meta(cd);
        let prefix = "derive(";
        var i: i32 = 0;
        while (i + prefix.len <= meta.len) {
            var hit: bool = true;
            var k: i32 = 0;
            while (k < prefix.len && hit) {
                if (meta.charAt(i + k) != prefix.charAt(k)) { hit = false; }
                k = k + 1;
            }
            if (hit) {
                var j: i32 = i + (prefix.len as i32);
                var start: i32 = -1;
                while (j <= meta.len) {
                    var c: i32 = 0;
                    if (j < meta.len) { c = meta.charAt(j); }
                    let is_tok = j < meta.len && sema_derive_token_char(c);
                    if (is_tok && start < 0) {
                        start = j;
                    } else if (!is_tok && start >= 0) {
                        let tok = str_view_range(meta, start, j);
                        let key = sema_derive_trait_key(tok);
                        if (!(key == "Eq"
                              || key == "Clone"
                              || key == "Hashable"
                              || key == "Ord"
                              || key == "Copy"
                              || key == "Debug"
                              || key == "Display")) {
                            self.report_error_help(diag_code_sema_trait_bound(),
                                                    g_sema_cur_loc,
                                                    "@[derive(" + tok + ")] on '"
                                                        + decl_get_name(cd)
                                                        + "': unknown trait name; supported traits are Eq, Ord, Clone, Copy, Hashable, Debug, Display",
                                                    "use one of Eq, Ord, Clone, Copy, Hashable, Debug, Display, or write a manual impl");
                        }
                        start = -1;
                    }
                    if (j < meta.len && (c == 41 || c == 93 || c == 124)) {
                        break;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    public fn host_analyze_synthesize_derive_methods(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_CLASS() || decl_get_kind(cur) == de_ENUM()) {
                let gp = decl_get_generic_params(cur);
                if (!string_contains(gp, "|kind:impl")
                    && !string_contains(gp, "|kind:interface")) {
                    self.derive_report_unknown_traits(cur);
                    if (sema_decl_derives_trait(cur, "Eq")) {
                        self.derive_synthesize_eq(cur);
                    }
                    if (sema_decl_derives_trait(cur, "Clone")) {
                        self.derive_synthesize_clone(cur);
                    }
                    if (sema_decl_derives_trait(cur, "Hashable")
                        || sema_decl_derives_trait(cur, "Hash")) {
                        self.derive_synthesize_hash(cur);
                    }
                    if (sema_decl_derives_trait(cur, "Ord")) {
                        self.derive_synthesize_ord(cur);
                    }
                    if (sema_decl_derives_trait(cur, "Debug")) {
                        self.derive_synthesize_debug_like(cur, "Debug", "debug");
                    }
                    if (sema_decl_derives_trait(cur, "Display")) {
                        self.derive_synthesize_debug_like(cur, "Display", "display");
                    }
                    if (sema_decl_derives_trait(cur, "Copy")) {
                        if (self.derive_fields_satisfy(cur, "Copy")) {
                            sema_decl_mark_trait_impl(cur, "Copy");
                        }
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    public fn host_analyze_decl_pass_non_functions(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            let k = decl_get_kind(cur);
            if (k == de_CONST()) {
                let body = decl_get_body(cur);
                if (body != null) {
                    let init = stmt_get_init(body);
                    let it = self.resolve_expr(init);
                    let want = decl_get_ty(cur);
                    if (want == null) {
                        decl_set_ty(cur, it);
                    } else {
                        let adopted = self.expr_adopts_expected_type(init, want, it);
                        if (!adopted && !self.types_compatible(want, it)) {
                            self.error_mismatch("const " + decl_get_name(cur), want, it);
                        }
                    }
                }
            } else if (k == de_GLOBAL_VAR()) {
                let body2 = decl_get_body(cur);
                if (body2 != null) {
                    let init2 = stmt_get_init(body2);
                    let it2 = self.resolve_expr(init2);
                    let want2 = decl_get_ty(cur);
                    if (want2 == null) {
                        decl_set_ty(cur, it2);
                    } else {
                        let adopted2 = self.expr_adopts_expected_type(init2, want2, it2);
                        if (!adopted2 && !self.types_compatible(want2, it2)) {
                            self.error_mismatch("global " + decl_get_name(cur), want2, it2);
                        }
                    }
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                var mp = decl_get_members(cur);
                while (mp != null && !self.too_many_errors()) {
                    if (decl_get_kind(mp) == de_FIELD()) {
                        self.sema_lazy_load_type_ref_symbols(decl_get_ty(mp));
                    }
                    if (decl_get_kind(mp) == de_METHOD()) {
                        self.ensure_method_self_param(cur, mp);
                    }
                    mp = decl_get_next(mp);
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    public fn host_analyze_inject_structural_trait_defaults(self, unit: rawptr) {
        if (unit == null) { return; }
        var cd_cur = unit_get_decls(unit);
        while (cd_cur != null && !self.too_many_errors()) {
            if (decl_get_kind(cd_cur) == de_CLASS()
                && !string_contains(decl_get_generic_params(cd_cur), "|kind:interface")
                && generic_param_count(decl_get_generic_params(cd_cur)) == 0) {
                var iface_cur = unit_get_decls(unit);
                while (iface_cur != null && !self.too_many_errors()) {
                    if (decl_get_kind(iface_cur) == de_CLASS()
                        && string_contains(decl_get_generic_params(iface_cur), "|kind:interface")
                        && generic_param_count(decl_get_generic_params(iface_cur)) == 0
                        && !string_contains(decl_get_generic_params(cd_cur),
                                            decl_get_name(iface_cur) + ",")) {
                        var has_default: bool = false;
                        var has_required: bool = false;
                        var all_required_met: bool = true;
                        // A default body that mentions `Self.Assoc` can only
                        // become a concrete structural member after the
                        // receiving class provides every associated type the
                        // source interface declares.  Do not attach a
                        // half-substituted body and defer the failure to HIR.
                        var all_assoc_types_met: bool = true;
                        var mp = decl_get_members(iface_cur);
                        while (mp != null && !self.too_many_errors()) {
                            if (decl_get_kind(mp) == de_METHOD()) {
                                if (decl_get_body(mp) != null) {
                                    has_default = true;
                                } else {
                                    has_required = true;
                                    if (!self.class_decl_has_member(cd_cur, decl_get_name(mp))) {
                                        all_required_met = false;
                                    }
                                }
                            } else if (decl_get_kind(mp) == de_FIELD()
                                       && string_contains(decl_get_generic_params(mp),
                                                          "|kind:assoc_type")) {
                                let concrete_assoc = self.class_decl_member_deep(
                                    cd_cur,
                                    decl_get_name(mp),
                                    0);
                                if (concrete_assoc == null
                                    || !string_contains(decl_get_generic_params(concrete_assoc),
                                                        "|kind:assoc_type")
                                    || decl_get_ty(concrete_assoc) == null) {
                                    all_assoc_types_met = false;
                                }
                            }
                            mp = decl_get_next(mp);
                        }
                        if (has_default && has_required && all_required_met && all_assoc_types_met) {
                            var dm = decl_get_members(iface_cur);
                            while (dm != null && !self.too_many_errors()) {
                                if (decl_get_kind(dm) == de_METHOD()
                                    && decl_get_body(dm) != null
                                    && !self.class_decl_has_member(cd_cur, decl_get_name(dm))) {
                                    // Structural defaults are concrete copies of the
                                    // interface body.  Substitute the receiver and
                                    // every `Self.Assoc` reference together so method
                                    // signatures, local annotations, and nested body
                                    // expressions cannot split between trait and
                                    // concrete-owner types.
                                    let self_type = tref_create_class(sema_decl_self_type_name(cd_cur));
                                    var clone_env = sema_env_new();
                                    clone_env = sema_env_bind(clone_env, "Self", self_type);
                                    var assoc_cur = decl_get_members(iface_cur);
                                    while (assoc_cur != null) {
                                        if (decl_get_kind(assoc_cur) == de_FIELD()
                                            && string_contains(decl_get_generic_params(assoc_cur),
                                                               "|kind:assoc_type")) {
                                            let assoc_name = decl_get_name(assoc_cur);
                                            let concrete_assoc = self.class_decl_member_deep(cd_cur,
                                                                                              assoc_name,
                                                                                              0);
                                            if (concrete_assoc != null && decl_get_ty(concrete_assoc) != null) {
                                                let concrete_ty = decl_get_ty(concrete_assoc);
                                                clone_env = sema_env_bind(clone_env,
                                                                          "Self." + assoc_name,
                                                                          concrete_ty);
                                                clone_env = sema_env_bind(clone_env,
                                                                          assoc_name,
                                                                          concrete_ty);
                                                // The parser currently normalizes this
                                                // spelling to `Self.Assoc`, but retain
                                                // the canonical source spelling too so
                                                // cloned/imported ASTs cannot bypass the
                                                // substitution contract.
                                                clone_env = sema_env_bind(clone_env,
                                                                          "Self::" + assoc_name,
                                                                          concrete_ty);
                                            }
                                        }
                                        assoc_cur = decl_get_next(assoc_cur);
                                    }
                                    let clone = sema_clone_decl_node_env(dm, clone_env, 0);
                                    sema_env_dispose(clone_env);
                                    if (clone != null) {
                                        let clone_self = decl_get_params(clone);
                                        if (clone_self != null && decl_get_name(clone_self) == "self") {
                                            // The source trait receiver is named
                                            // after the trait (rather than `Self`),
                                            // so it is not covered by the textual
                                            // TypeEnv binding above.  Rebind it
                                            // explicitly after the deep clone.
                                            decl_set_ty(clone_self,
                                                        tref_create_class(sema_decl_self_type_name(cd_cur)));
                                            sema_mark_receiver_compat_if_missing(clone_self);
                                        } else {
                                            self.ensure_method_self_param(cd_cur, clone);
                                        }
                                        decl_set_is_public(clone, true);
                                        decl_set_next(clone, decl_get_members(cd_cur));
                                        decl_set_members(cd_cur, clone);
                                    }
                                }
                                dm = decl_get_next(dm);
                            }
                        } else if (!has_default && has_required && all_required_met) {
                            decl_set_generic_params(cd_cur,
                                                    decl_get_generic_params(cd_cur)
                                                    + "|impl:"
                                                    + decl_get_name(iface_cur)
                                                    + ",");
                        }
                    }
                    iface_cur = decl_get_next(iface_cur);
                }
            }
            cd_cur = decl_get_next(cd_cur);
        }
        return;
    }
    public fn host_analyze_decl_pass_functions(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        var has_entry: bool = false;
        while (cur != null && !self.too_many_errors()) {
            if (decl_get_kind(cur) == de_FN()
                && !decl_marked_imported(cur)
                && decl_get_name(cur) == "main") {
                has_entry = true;
            }
            cur = decl_get_next(cur);
        }
        cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            if (decl_get_kind(cur) == de_FN()
                && !decl_is_foreign_import(cur)
                && (!has_entry || decl_get_name(cur) == "main")) {
                let meta = decl_get_meta(cur);
                if (!string_contains(meta, "|body_resolved")
                    && !string_contains(meta, "|body_resolving")) {
                    self.resolve_fn(cur);
                    let resolved_meta = decl_get_meta(cur);
                    if (!string_contains(resolved_meta, "|body_resolved")) {
                        decl_set_meta(cur, resolved_meta + "|body_resolved");
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    /// Infer every body-backed declaration whose return annotation was
    /// omitted before HIR signatures are frozen.  Project/codegen mode keeps
    /// imported source bodies in the merged AST but intentionally skips the
    /// expensive imported HIR-fact pass; without this focused signature pass
    /// those declarations were therefore registered as `void`, even though a
    /// later per-module build could infer the same body correctly.
    ///
    /// Temporarily use the normal lazy body resolver so dependencies are
    /// inferred in call order and recursion guards remain active.  Only
    /// declarations with a missing return type are entered here, so explicit
    /// signatures and body-less interface/extern declarations stay untouched.
    public fn host_analyze_infer_missing_return_types(self, unit: rawptr) {
        if (unit == null) { return; }
        let saved_prepare_hir_facts = self.prepare_hir_facts;
        let saved_prepare_imported_hir_facts = self.prepare_imported_hir_facts;
        self.prepare_hir_facts = false;
        self.prepare_imported_hir_facts = true;

        var cur = unit_get_decls(unit);
        let infer_prof = vyx_bootstrap_profile_level();
        var infer_ms: i64 = 0;
        while (cur != null && !self.too_many_errors()) {
            let k = decl_get_kind(cur);
            if (k == de_FN()
                && decl_get_body(cur) != null
                && decl_get_ty(cur) == null) {
                let t0 = vyx_bootstrap_now_ms();
                self.sema_resolve_decl_body_if_needed(cur);
                let dt0 = vyx_bootstrap_now_ms() - t0;
                infer_ms = infer_ms + dt0;
                if (infer_prof > 0 && dt0 >= 100) {
                    print("[infer-prof] fn " + decl_get_name(cur) + ": "
                          + policy_i64_to_string(dt0) + " ms");
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let owner_imported = decl_is_foreign_import(cur);
                var mp = decl_get_members(cur);
                while (mp != null && !self.too_many_errors()) {
                    if (decl_get_kind(mp) == de_METHOD()
                        && decl_get_body(mp) != null
                        && decl_get_ty(mp) == null) {
                        self.ensure_method_self_param(cur, mp);
                        let t1 = vyx_bootstrap_now_ms();
                        self.resolve_method_with_owner(mp, cur, owner_imported);
                        let dt1 = vyx_bootstrap_now_ms() - t1;
                        infer_ms = infer_ms + dt1;
                        if (infer_prof > 0 && dt1 >= 100) {
                            print("[infer-prof] method " + decl_get_name(cur) + "."
                                  + decl_get_name(mp) + ": "
                                  + policy_i64_to_string(dt1) + " ms");
                        }
                    }
                    mp = decl_get_next(mp);
                }
            }
            cur = decl_get_next(cur);
        }
        if (infer_prof > 0) {
            print("[infer-prof] accumulated_resolve_ms=" + policy_i64_to_string(infer_ms));
        }

        self.prepare_hir_facts = saved_prepare_hir_facts;
        self.prepare_imported_hir_facts = saved_prepare_imported_hir_facts;
        return;
    }
    public fn host_analyze_all_method_bodies(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        var has_entry: bool = false;
        while (cur != null && !self.too_many_errors()) {
            if (decl_get_kind(cur) == de_FN()
                && !decl_marked_imported(cur)
                && decl_get_name(cur) == "main") {
                has_entry = true;
            }
            cur = decl_get_next(cur);
        }
        cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            if (decl_get_kind(cur) == de_CLASS() || decl_get_kind(cur) == de_ENUM()) {
                var mp = decl_get_members(cur);
                let owner_gp = decl_get_generic_params(cur);
                let owner_imported = decl_is_foreign_import(cur);
                while (mp != null && !self.too_many_errors()) {
                    if (decl_get_kind(mp) == de_METHOD()) {
                        if (!owner_imported) {
                            self.ensure_method_self_param(cur, mp);
                            if (decl_get_body(mp) != null
                                && !has_entry
                                && !decl_has_template_head(cur)
                                && !decl_has_template_head(mp)) {
                                let mmeta = decl_get_meta(mp);
                                if (!string_contains(mmeta, "|body_resolved")
                                    && !string_contains(mmeta, "|body_resolving")) {
                                    self.resolve_method_with_owner(mp,
                                                                   cur,
                                                                   false);
                                    let mmeta2 = decl_get_meta(mp);
                                    if (!string_contains(mmeta2, "|body_resolved")) {
                                        decl_set_meta(mp, mmeta2 + "|body_resolved");
                                    }
                                }
                            }
                        }
                    }
                    mp = decl_get_next(mp);
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    public fn sema_resolve_hir_fact_body(self,
                                         fn_decl: rawptr,
                                         owner_decl: rawptr,
                                         owner_imported: bool) {
        if (fn_decl == null) { return; }
        if (self.too_many_errors()) { return; }
        if (decl_get_body(fn_decl) == null) { return; }
        let is_drop_method = decl_get_kind(fn_decl) == de_METHOD() && decl_get_name(fn_decl) == "drop";
        if (!self.prepare_imported_hir_facts
            && (owner_imported || decl_is_foreign_import(fn_decl))) {
            return;
        }
        if (!is_drop_method
            && !self.prepare_imported_hir_facts
            && (decl_is_foreign_import(fn_decl) || owner_imported)) {
            return;
        }
        if (!is_drop_method && decl_has_template_head(fn_decl)) { return; }
        if (!is_drop_method && owner_decl != null && decl_has_template_head(owner_decl)) { return; }
        let meta = decl_get_meta(fn_decl);
        if (string_contains(meta, "|body_resolved")) {
            if (!string_contains(meta, "|hir_facts_resolved")) {
                decl_set_meta(fn_decl, meta + "|hir_facts_resolved");
            }
            return;
        }
        if (string_contains(meta, "|hir_facts_resolved")
            || string_contains(meta, "|hir_facts_resolving")) {
            return;
        }
        decl_set_meta(fn_decl, meta + "|hir_facts_resolving");
        if (decl_get_kind(fn_decl) == de_METHOD()) {
            self.resolve_method_with_owner(fn_decl, owner_decl, owner_imported);
        } else {
            self.resolve_fn(fn_decl);
        }
        let meta2 = decl_get_meta(fn_decl);
        if (!string_contains(meta2, "|hir_facts_resolved")) {
            decl_set_meta(fn_decl, meta2 + "|hir_facts_resolved");
        }
    }

    public fn sema_hir_fact_root_selected(self, fn_decl: rawptr) -> bool {
        if (self.hir_fact_root_names.len == 0) { return true; }
        if (fn_decl == null) { return false; }
        let name = decl_get_name(fn_decl);
        if (name == "drop") { return true; }
        return string_contains("|" + self.hir_fact_root_names + "|", "|" + name + "|");
    }

    public fn host_analyze_prepare_hir_facts(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        while (cur != null && !self.too_many_errors()) {
            sema_stamp_loc_from_decl(cur);
            let k = decl_get_kind(cur);
            if (k == de_FN()) {
                if (self.sema_hir_fact_root_selected(cur)) {
                    self.sema_resolve_hir_fact_body(cur, null, false);
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let owner_imported = decl_is_foreign_import(cur);
                if (owner_imported && !self.prepare_imported_hir_facts) {
                    cur = decl_get_next(cur);
                    continue;
                }
                var mp = decl_get_members(cur);
                while (mp != null && !self.too_many_errors()) {
                    if (decl_get_kind(mp) == de_METHOD()) {
                        if (self.sema_hir_fact_root_selected(mp)) {
                            self.ensure_method_self_param(cur, mp);
                            self.sema_resolve_hir_fact_body(mp, cur, owner_imported);
                        }
                    }
                    mp = decl_get_next(mp);
                }
            }
            cur = decl_get_next(cur);
        }
        return;
    }
    /// Circular `Ref<>` / `Scope<>` chain warning — bootstrap mirror of
    /// `vyx::Sema::analyze`'s ref-cycle pass (src/Sema/Sema.cpp L1385–L1438).
    ///
    /// Algorithm (matches host shape):
    ///   1. Build an adjacency list `class/struct decl → set<target type>`
    ///      from every non-weak field whose annotation is a `Ref<T>`,
    ///      `MutRef<T>`, or `Scope<T>` instantiation.
    ///   2. Run DFS from each starting node; when a node already on the
    ///      current path is revisited the path slice forms a cycle.
    ///   3. Emit a SEMA-001 warning per unique cycle text.
    ///
    /// The graph is intentionally over-approximated: anything that
    /// looks like `Ref<...>` / `Scope<...>` by name counts. False
    /// positives surface as warnings only — they never block compile.
    /// Bootstrap currently does not track field-level `weak` markers,
    /// so the whole adjacency edge is added unconditionally; this is
    /// strictly more conservative (more warnings) than host, which is
    /// the safe direction for a warning-only pass.
    public fn host_analyze_ref_cycle_check(self, unit: rawptr) {
        if (unit == null) { return; }
        var cur = unit_get_decls(unit);
        var graph: rawptr = null;
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if (kind == de_CLASS()) {
                let owner_name = decl_get_name(cur);
                if (owner_name.len > 0) {
                    var member = decl_get_members(cur);
                    while (member != null) {
                        if (decl_get_kind(member) == de_FIELD()) {
                            let mty = decl_get_ty(member);
                            let tgt = sema_ref_cycle_extract_target(mty);
                            if (tgt.len > 0) {
                                graph = sema_ref_cycle_graph_add(
                                    graph, owner_name, tgt);
                            }
                        }
                        member = decl_get_next(member);
                    }
                }
            }
            cur = decl_get_next(cur);
        }
        sema_ref_cycle_dfs_and_report(graph);
        sema_ref_cycle_graph_dispose(graph);
        return;
    }
    /// Flush queued generic instantiations into `unit.declarations` —
    /// bootstrap counterpart to `vyx::Sema::analyze`'s
    /// `pendingInstantiations_` drain (src/Sema/Sema.cpp L1441–L1444).
    ///
    /// The host queue exists because Mono lives as a separate pass that
    /// hands back materialised specialisations after Sema has already
    /// finished walking declarations. The bootstrap codegen folds
    /// monomorphisation into emit time (`emit_generic_specialization_body`
    /// in `codegen.vyx`), so there is no per-Sema specialisation queue
    /// to drain: every turbofish callsite resolves to a freshly-emitted
    /// LLVM function during codegen, not a synthesised AST decl pushed
    /// back into the unit.
    ///
    /// The MonoScheduler ledger (`bootstrap.mono_scheduler`) still
    /// records each turbofish request so CI can compare counts with
    /// host; that is the bootstrap-equivalent observable. Telemetry is
    /// emitted by `host_analyze_dump_mono_scheduler_stats`; this entry
    /// point is therefore intentionally a no-op rather than a stub.
    public fn host_analyze_append_pending_instantiations(self, unit: rawptr) {
        return;
    }
    /// PLAN_SEMA_ROOT_FIX S3 telemetry — byte-exact mirror of
    /// `vyx::Sema::dumpSolverReconciliationStats` (src/Sema/Sema.cpp
    /// L162–L172). Early-returns when both `prim_queries` and
    /// `post_freeze_writes` are zero, matching the host guard.
    public fn host_analyze_dump_solver_stats(self, unit: rawptr) {
        fact_base_dump_solver_stats(self.fact_base);
        effect_plan_dump_stats(self.effect_plan);
        return;
    }
    /// PLAN_SEMA_ROOT_FIX S5 telemetry — byte-exact mirror of
    /// `vyx::Sema::dumpMonoSchedulerStats` (src/Sema/Sema.cpp L182–L192).
    /// Early-returns when no requests have been recorded; otherwise prints
    /// the `[S4 mono-sched] …` line consumed by CI parity gates.
    public fn host_analyze_dump_mono_scheduler_stats(self, unit: rawptr) {
        if (vyx_bootstrap_profile_level() <= 0) { return; }
        mono_scheduler_dump_stats(self.mono_scheduler);
        return;
    }
}

// ════════════════════════════════════════════════════════════════════
//   Sema-state handle (16 B malloc'd) — survives function returns.
//
//   Layout:
//     0..3   error_count : i32
//     4..7   class_count : i32
//     8..11  func_count  : i32
//     12..15 _pad        : i32
// ════════════════════════════════════════════════════════════════════

fn sema_handle_alloc(error_count: i32, class_count: i32, func_count: i32) -> rawptr {
    let h = vyx_frontend_alloc(16);
    if (h == null) { return null; }
    memset(h, 0, 16);
    ptr_write_i32(h, error_count);
    ptr_write_i32(ptr_offset(h, 4), class_count);
    ptr_write_i32(ptr_offset(h, 8), func_count);
    return h;
}

fn sema_handle_error_count(h: rawptr) -> i32 {
    if (h == null) { return 0; }
    return ptr_read_i32(h);
}

fn sema_handle_class_count(h: rawptr) -> i32 {
    if (h == null) { return 0; }
    return ptr_read_i32(ptr_offset(h, 4));
}

fn sema_handle_func_count(h: rawptr) -> i32 {
    if (h == null) { return 0; }
    return ptr_read_i32(ptr_offset(h, 8));
}

// ════════════════════════════════════════════════════════════════════
//   Public driver API
// ════════════════════════════════════════════════════════════════════

public fn analyze_unit_with_registry_options_ex(unit: rawptr,
                                                registry: string,
                                                emit_stats: bool,
                                                prepare_hir_facts: bool) -> rawptr {
    return analyze_unit_with_registry_options_codegen(unit,
                                                      registry,
                                                      emit_stats,
                                                      prepare_hir_facts,
                                                      true);
}


public fn analyze_unit_with_registry_options_codegen_roots(unit: rawptr,
                                                           registry: string,
                                                           emit_stats: bool,
                                                           prepare_hir_facts: bool,
                                                           prepare_imported_hir_facts: bool,
                                                           hir_fact_root_names: string) -> rawptr {
    sema_clear_cur_loc();
    vyx_type_text_cache_clear();
    g_sema_eff_imported_built = false;
    g_unit_mod_set = "";
    g_unit_mod_set_key = -1;
    g_registry_mod_set = "";
    g_upr_map = sema_string_state_map_clear(g_upr_map);
    g_rpr_map = sema_string_state_map_clear(g_rpr_map);
    // The lookup cache now remembers absent names too, so it must not carry
    // a verdict across units even if a head pointer gets recycled.
    sym_lookup_cache_reset();
    ci_dispose();
    ri_dispose();
    cs_dispose();
    cf_dispose();
    esn_dispose();
    let s = Sema.create();
    s.emit_stats = emit_stats;
    s.prepare_hir_facts = prepare_hir_facts;
    s.prepare_imported_hir_facts = prepare_imported_hir_facts;
    s.hir_fact_root_names = hir_fact_root_names;
    s.import_registry = registry;
    s.current_unit = unit;
    let service_root_ptr = vyx_lsp_bind_root();
    if (service_root_ptr != null && unit != null) {
        let service_root = from_cstr_view_len(service_root_ptr, strlen(service_root_ptr));
        s.sema_mark_unit_source_path(unit, service_root);
        s.current_tail = s.sema_decl_chain_tail(unit_get_decls(unit));
        var service_sibling_ptr = vyx_lsp_bind_sibling();
        while (service_sibling_ptr != null) {
            let service_sibling = from_cstr_view_len(service_sibling_ptr, strlen(service_sibling_ptr));
            let sibling_unit = s.sema_parse_module_file(service_sibling);
            if (sibling_unit != null) {
                s.sema_mark_unit_source_path(sibling_unit, service_sibling);
                s.sema_mark_imported_unit(sibling_unit, s.sema_unit_module_name(sibling_unit));
                s.sema_append_unit(unit, sibling_unit);
            }
            service_sibling_ptr = vyx_lsp_bind_sibling();
        }
    }
    if (unit != null) {
        s.current_tail = s.sema_decl_chain_tail(unit_get_decls(unit));
        let root_mod = s.sema_unit_module_name(unit);
        if (root_mod.len > 0) {
            s.loaded_imports = sema_set_add(s.loaded_imports, root_mod);
        }
        s.sema_bind_unit_source_paths(unit);
    }
    vyx_lsp_bind_prepare(unit);
    s.run_host_analyze_pipeline(unit);
    sema_export_service_bindings(s, unit);
    let h = sema_handle_alloc(s.error_count, s.class_count, s.func_count);
    sym_lookup_cache_reset();
    sema_resolve_memos_reset();
    sema_string_state_map_dispose(s.lazy_symbol_miss_cache);
    sema_string_state_map_dispose(s.lazy_pending_symbol_cache);
    sema_string_state_map_dispose(s.lazy_type_ref_cache);
    sema_string_state_map_dispose(s.layout_load_cache);
    sema_string_state_map_dispose(s.loaded_imports);
    sema_string_state_map_dispose(s.loading_imports);
    sema_string_state_map_dispose(s.loaded_paths);
    sema_string_state_map_dispose(s.forced_layout_targets);
    mono_scheduler_dispose(s.mono_scheduler);
    fact_base_dispose(s.fact_base);
    effect_plan_dispose(s.effect_plan);
    lang_items_dispose(s.lang_items);
    return h;
}

public fn analyze_unit_with_registry_options_codegen(unit: rawptr,
                                                     registry: string,
                                                     emit_stats: bool,
                                                     prepare_hir_facts: bool,
                                                     prepare_imported_hir_facts: bool) -> rawptr {
    return analyze_unit_with_registry_options_codegen_roots(unit,
                                                           registry,
                                                           emit_stats,
                                                           prepare_hir_facts,
                                                           prepare_imported_hir_facts,
                                                           "");
}

public fn analyze_unit_with_registry_options(unit: rawptr, registry: string, emit_stats: bool) -> rawptr {
    return analyze_unit_with_registry_options_ex(unit, registry, emit_stats, false);
}

public fn analyze_unit_with_registry(unit: rawptr, registry: string) -> rawptr {
    return analyze_unit_with_registry_options(unit, registry, true);
}

public fn analyze_unit(unit: rawptr) -> rawptr {
    return analyze_unit_with_registry(unit, "");
}

/// Long-running clients call this after extracting facts, before releasing the
/// parse/service frame. Batch compilation keeps its caches through lowering.
public fn sema_service_dispose() {
    sema_clear_cur_loc();
    vyx_type_text_cache_clear();
    sym_lookup_cache_reset();
    sema_resolve_memos_reset();
    ci_dispose(); ri_dispose(); cs_dispose(); cf_dispose(); esn_dispose();
    sema_string_state_map_dispose(g_upr_map); g_upr_map = null;
    sema_string_state_map_dispose(g_rpr_map); g_rpr_map = null;
    if (g_sym_lookup_cache != null) { vyx_frontend_free(g_sym_lookup_cache); g_sym_lookup_cache = null; }
    if (g_sym_miss != null) { vyx_frontend_free(g_sym_miss); g_sym_miss = null; }
    if (g_overload_count_memo != null) { vyx_frontend_free(g_overload_count_memo); g_overload_count_memo = null; }
    if (g_variant_owner_memo != null) { vyx_frontend_free(g_variant_owner_memo); g_variant_owner_memo = null; }
    if (g_latest_class_memo != null) { vyx_frontend_free(g_latest_class_memo); g_latest_class_memo = null; }
    if (g_use_alias_memo != null) { vyx_frontend_free(g_use_alias_memo); g_use_alias_memo = null; }
    if (g_layout_score_memo != null) { vyx_frontend_free(g_layout_score_memo); g_layout_score_memo = null; }
    g_unit_mod_set = ""; g_unit_mod_set_key = -1; g_registry_mod_set = "";
    g_diag_src_path0 = ""; g_diag_src_text0 = "";
    g_diag_src_path1 = ""; g_diag_src_text1 = "";
    g_diag_src_path2 = ""; g_diag_src_text2 = "";
    g_diag_src_path3 = ""; g_diag_src_text3 = "";
    g_sema_phase_sums = "";
    g_sema_eff_imported_built = false;
    canon_dispose();
    effect_service_dispose();
    template_artifact_service_dispose();
}

// ════════════════════════════════════════════════════════════════════
//   WU12 helpers — ref-cycle graph (malloc-backed linked list).
//
//   Each node is 32 B: `(owner_ptr, owner_len, target_ptr, target_len)`
//   followed by a `next` pointer. Bootstrap units carry at most a few
//   dozen ref edges (std + user code), so linear search per insert is
//   acceptable — building the full graph is O(E²) but E < 100 in
//   practice. The graph owns every key buffer (EXE-side malloc) and is
//   released wholesale by `sema_ref_cycle_graph_dispose`.
// ════════════════════════════════════════════════════════════════════

fn sema_ref_cycle_graph_add(graph: rawptr, owner: string, tgt: string) -> rawptr {
    // Allocate a 48 B node: owner_ptr/owner_len/tgt_ptr/tgt_len/next.
    let node = vyx_frontend_alloc(48);
    if (node == null) { return graph; }
    memset(node, 0, 48);
    let op = ast_dup_c_string(owner);
    let tp = ast_dup_c_string(tgt);
    ast_write_rawptr(node, op);
    ptr_write_i64(ptr_offset(node, 8), owner.len);
    ast_write_rawptr(ptr_offset(node, 16), tp);
    ptr_write_i64(ptr_offset(node, 24), tgt.len);
    ast_write_rawptr(ptr_offset(node, 32), graph);
    return node;
}

fn sema_ref_cycle_graph_dispose(graph: rawptr) {
    var cur = graph;
    while (cur != null) {
        let nxt = ast_read_rawptr(ptr_offset(cur, 32));
        let owner_buf = ast_read_rawptr(cur);
        let target_buf = ast_read_rawptr(ptr_offset(cur, 16));
        if (owner_buf != null) { vyx_frontend_free(owner_buf); }
        if (target_buf != null) { vyx_frontend_free(target_buf); }
        vyx_frontend_free(cur);
        cur = nxt;
    }
}

/// Pull the target type name out of a `Ref<T>` / `MutRef<T>` /
/// `Scope<T>` / `Box<T>` field annotation. Returns the empty string
/// when the annotation doesn't match any of those shapes.
fn sema_ref_cycle_extract_target(tref: rawptr) -> string {
    if (tref == null) { return ""; }
    let kind = tref_get_kind(tref);
    if (kind == ty_REF() || kind == ty_MUTREF() || kind == ty_PTR()) {
        let pointee = tref_pointee(tref);
        if (pointee == null) { return ""; }
        return tref_get_name(pointee);
    }
    if (kind == ty_CLASS()) {
        let nm = tref_get_name(tref);
        // Class-encoded smart-pointer surface: `Scope<T>` / `Box<T>` /
        // `Ref<T>` arrive here when the parser stamped a class type
        // with a mangled `Name<TArgs>` payload (e.g. `Scope::<MyT>`).
        let inner = sema_ref_cycle_inner_of_class(nm);
        if (inner.len > 0) { return inner; }
    }
    return "";
}

/// Given a mangled class name like `Scope::<MyT>` / `Ref<MyT>` /
/// `Box::<MyT>`, return `MyT`; otherwise return the empty string.
fn sema_ref_cycle_inner_of_class(name: string) -> string {
    if (name.len < 4) { return ""; }
    var i: i32 = 0;
    var marker_end: i32 = -1;
    let prefixes: i32 = 3;
    var matched: bool = false;
    if (name.charAt(0) == 82 && name.charAt(1) == 101 && name.charAt(2) == 102) {
        // "Ref"
        matched = true; marker_end = 3;
    } else if (name.len >= 5
            && name.charAt(0) == 83 && name.charAt(1) == 99
            && name.charAt(2) == 111 && name.charAt(3) == 112
            && name.charAt(4) == 101) {
        // "Scope"
        matched = true; marker_end = 5;
    } else if (name.len >= 3
            && name.charAt(0) == 66 && name.charAt(1) == 111
            && name.charAt(2) == 120) {
        // "Box"
        matched = true; marker_end = 3;
    } else if (name.len >= 6
            && name.charAt(0) == 77 && name.charAt(1) == 117
            && name.charAt(2) == 116 && name.charAt(3) == 82
            && name.charAt(4) == 101 && name.charAt(5) == 102) {
        // "MutRef"
        matched = true; marker_end = 6;
    }
    if (!matched) { return ""; }
    var p: i32 = marker_end;
    while (p < name.len && name.charAt(p) == 58) { p = p + 1; } // skip '::'
    if (p >= name.len || name.charAt(p) != 60) { return ""; }   // expect '<'
    let start = p + 1;
    var end: i32 = name.len as i32;
    if (end > 0 && name.charAt(end - 1) == 62) {                 // trim '>'
        end = end - 1;
    }
    if (end <= start) { return ""; }
    return str_substring(name, start as i64, end as i64);
}

/// DFS each starting node and emit a SEMA-001 warning per unique
/// cycle string (same dedup contract as host's `reported` set).
fn sema_ref_cycle_dfs_and_report(graph: rawptr) {
    if (graph == null) { return; }
    var start = graph;
    while (start != null) {
        let owner = sema_ref_cycle_node_owner(start);
        sema_ref_cycle_dfs_from(graph, owner);
        start = ast_read_rawptr(ptr_offset(start, 32));
    }
}

fn sema_ref_cycle_dfs_from(graph: rawptr, root: string) {
    // Bounded walk — 32 hops is well beyond any sane Ref<> nest depth
    // and keeps the recursion-free probe inexpensive even on the
    // pathological "every class refs every class" worst case.
    var cur: string = root;
    var hops: i32 = 0;
    while (hops < 32) {
        let next = sema_ref_cycle_graph_lookup(graph, cur);
        if (next.len == 0) { return; }
        if (next == root) {
            sema_ref_cycle_emit_warning(root, cur);
            return;
        }
        cur = next;
        hops = hops + 1;
    }
}

fn sema_ref_cycle_graph_lookup(graph: rawptr, owner: string) -> string {
    var cur = graph;
    while (cur != null) {
        if (sema_ref_cycle_node_owner(cur) == owner) {
            return sema_ref_cycle_node_target(cur);
        }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return "";
}

fn sema_ref_cycle_node_owner(node: rawptr) -> string {
    let p = ast_read_rawptr(node);
    let n = ptr_read_i64(ptr_offset(node, 8));
    if (p == null || n <= 0) { return ""; }
    return from_cstr_len(p, n);
}

fn sema_ref_cycle_node_target(node: rawptr) -> string {
    let p = ast_read_rawptr(ptr_offset(node, 16));
    let n = ptr_read_i64(ptr_offset(node, 24));
    if (p == null || n <= 0) { return ""; }
    return from_cstr_len(p, n);
}

fn sema_ref_cycle_emit_warning(root: string, last: string) {
    diag_emit(diag_sev_WARNING(),
              diag_code_sema_generic(),
              0, 0,
              "circular Ref<> chain detected starting at "
                  + root + " through " + last
                  + "; use 'weak' to break the cycle");
}

/// Extract the slot name from a decl meta string when an
/// `@[lang_item("<slot>")]` attribute is present. Returns the empty
/// string when the attribute is absent or malformed. The parser
/// stores attributes as `|attrs:@lang_item("result"),@deprecated,...`
/// so we look for the literal `lang_item(` prefix, skip the optional
/// opening quote, and copy until the closing quote / parenthesis.
fn sema_extract_lang_item_slot(meta: string) -> string {
    if (meta.len == 0) { return ""; }
    let prefix = "lang_item(";
    var i: i32 = 0;
    while (i + prefix.len <= meta.len) {
        var k: i32 = 0;
        var hit: bool = true;
        while (k < prefix.len && hit) {
            if (meta.charAt(i + k) != prefix.charAt(k)) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            var start: i32 = i + (prefix.len as i32);
            if (start < meta.len && meta.charAt(start) == 34) {
                start = start + 1;
            }
            var end: i32 = start;
            while (end < meta.len) {
                let c = meta.charAt(end);
                if (c == 34 || c == 41) { break; }
                end = end + 1;
            }
            if (end <= start) { return ""; }
            return str_substring(meta, start as i64, end as i64);
        }
        i = i + 1;
    }
    return "";
}

/// Extract the trait path from an `impl` decl's meta string
/// (`generic_params` for `de_CLASS` impl decls). The bootstrap
/// parser writes `|kind:impl|impl:<Trait>,|members:...` and the
/// `<Trait>` slice ends at the first `,` or `|` separator. Returns
/// the empty string if the marker is absent.
fn sema_extract_meta_field(meta: string, tag: string) -> string {
    if (meta.len == 0 || tag.len == 0) { return ""; }
    var i: i32 = 0;
    while (i + tag.len <= meta.len) {
        var k: i32 = 0;
        var hit: bool = true;
        while (k < tag.len && hit) {
            if (meta.charAt(i + k) != tag.charAt(k)) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            let start = (i + tag.len) as i64;
            var end = start;
            while (end < meta.len) {
                if (meta.charAt(end as i32) == 124) { break; }
                end = end + 1;
            }
            if (end <= start) { return ""; }
            return str_substring(meta, start, end);
        }
        i = i + 1;
    }
    return "";
}

fn sema_csv_has_name(csv: string, name: string) -> bool {
    if (csv.len == 0 || name.len == 0) { return false; }
    if (csv == name) { return true; }
    return string_contains("," + csv + ",", "," + name + ",");
}

fn sema_extract_impl_trait_meta(meta: string) -> string {
    if (meta.len == 0) { return ""; }
    let prefix = "|impl:";
    var i: i32 = 0;
    while (i + prefix.len <= meta.len) {
        var k: i32 = 0;
        var hit: bool = true;
        while (k < prefix.len && hit) {
            if (meta.charAt(i + k) != prefix.charAt(k)) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            let start = (i + prefix.len) as i64;
            var end = start;
            while (end < meta.len) {
                let c = meta.charAt(end as i32);
                if (c == 44 || c == 124) { break; }
                end = end + 1;
            }
            if (end <= start) { return ""; }
            return str_substring(meta, start, end);
        }
        i = i + 1;
    }
    return "";
}

fn sema_impl_clause_text(meta: string) -> string {
    if (meta.len == 0) { return ""; }
    let prefix = "|impl:";
    var i: i32 = 0;
    while (i + prefix.len <= meta.len) {
        var k: i32 = 0;
        var hit: bool = true;
        while (k < prefix.len && hit) {
            if (meta.charAt(i + k) != prefix.charAt(k)) { hit = false; }
            k = k + 1;
        }
        if (hit) {
            let start = (i + prefix.len) as i64;
            var end = start;
            while (end < meta.len) {
                if (meta.charAt(end as i32) == 124) { break; }
                end = end + 1;
            }
            if (end <= start) { return ""; }
            return str_substring(meta, start, end);
        }
        i = i + 1;
    }
    return "";
}

public fn check_program(s_ptr: rawptr, unit: rawptr) -> i32 {
    if (s_ptr == null) { return -1; }
    return sema_handle_error_count(s_ptr);
}

public fn resolve_names(scope: rawptr) -> i32 {
    if (scope == null) { return 0; }
    return sema_handle_class_count(scope) + sema_handle_func_count(scope);
}

public fn infer_types(unit: rawptr) -> i32 {
    if (unit == null) { return 0; }
    let h = analyze_unit(unit);
    if (h == null) { return 0; }
    return sema_handle_error_count(h);
}

public fn sema_dispose(state: rawptr) -> i32 {
    if (state == null) { return 0; }
    vyx_frontend_free(state);
    return 0;
}

// The editor asks Sema to resolve nominal annotations/import selectors while
// this file's analysis context is still alive. It does not keep Sema or ASTs.
public fn sema_source_has_overlay(path: string) -> bool {
    var length: i64 = 0;
    return vyx_lsp_bind_source(path.clone().c_str(), to_rawptr(&length)) != null;
}
fn sema_stmt_has_value_return(head: rawptr) -> bool {
    var cur = head;
    while (cur != null) {
        if (stmt_get_kind(cur) == st_RETURN() && stmt_get_init(cur) != null) { return true; }
        if (sema_stmt_has_value_return(stmt_get_then_blk(cur))
            || sema_stmt_has_value_return(stmt_get_else_blk(cur))
            || sema_stmt_has_value_return(stmt_get_body(cur))) { return true; }
        if ((stmt_get_kind(cur) == st_FOR() || stmt_get_kind(cur) == st_DEFER())
            && sema_stmt_has_value_return(stmt_get_init(cur))) { return true; }
        cur = stmt_get_next(cur);
    }
    return false;
}
public fn sema_source_read(path: string) -> string {
    var length: i64 = 0;
    let source = vyx_lsp_bind_source(path.clone().c_str(), to_rawptr(&length));
    if (source != null) { return str_from_parts(source, length, 0, 0); }
    return readFile(path);
}
fn sema_export_service_bindings(s: Sema, unit: rawptr) {
    if (vyx_lsp_bind_root() == null) { return; }
    var source_decl = unit_get_decls(unit);
    while (source_decl != null && !s.too_many_errors()) {
        let source_scope = s.decl_source_module(source_decl, null);
        vyx_lsp_bind_decl_scope(source_decl, source_scope.c_str(), source_scope.len);
        var source_member = decl_get_members(source_decl);
        while (source_member != null) {
            let member_scope = s.decl_source_module(source_member, source_decl);
            vyx_lsp_bind_decl_scope(source_member, member_scope.c_str(), member_scope.len);
            source_member = decl_get_next(source_member);
        }
        if (vyx_lsp_bind_decl_is_root(source_decl) != 0) {
            if (decl_get_kind(source_decl) == de_FN() && decl_get_body(source_decl) != null) {
                s.sema_resolve_decl_body_if_needed(source_decl);
            }
            if (decl_get_kind(source_decl) == de_CLASS()) {
                var method = decl_get_members(source_decl);
                while (method != null && !s.too_many_errors()) {
                    if (decl_get_kind(method) == de_METHOD() && decl_get_body(method) != null
                        && !decl_get_meta(method).contains("|body_resolved")) {
                        s.resolve_method_with_owner(method, source_decl, false);
                    }
                    method = decl_get_next(method);
                }
            }
        }
        source_decl = decl_get_next(source_decl);
    }
    vyx_lsp_bind_prepare(unit);
    let saved_body = s.cur_body_decl;
    let saved_owner = s.cur_owner_decl;
    let saved_owner_class = s.cur_owner_class;
    let saved_generics = s.cur_generic_params;
    var node = vyx_lsp_bind_next_type();
    while (node != null) {
        let owner = vyx_lsp_bind_owner(node);
        s.cur_body_decl = owner;
        s.cur_owner_decl = null;
        s.cur_generic_params = "";
        if (owner != null) { s.cur_generic_params = decl_get_generic_params(owner); }
        if (owner != null && decl_get_kind(owner) == de_CLASS()) { s.cur_owner_decl = owner; }
        else if (owner != null && decl_get_kind(owner) == de_METHOD()) {
            s.cur_owner_decl = s.find_owner_decl_for_member(owner);
            if (s.cur_owner_decl != null) {
                s.cur_generic_params = merge_generic_params(decl_get_generic_params(s.cur_owner_decl), s.cur_generic_params);
            }
        }
        s.cur_owner_class = "";
        if (s.cur_owner_decl != null) { s.cur_owner_class = decl_get_name(s.cur_owner_decl); }
        let role = vyx_lsp_bind_role(node);
        var spelling: string = "";
        if (role == 3) {
            let source_name = from_cstr_view_len(vyx_lsp_bind_name(node), strlen(vyx_lsp_bind_name(node)));
            if (generic_list_contains(s.cur_generic_params, source_name)) { spelling = source_name; }
            else if (tref_get_kind(node) == ty_CLASS()) { spelling = tref_get_name(node); }
        }
        else if (role == 6) { spelling = decl_get_name(node); }
        else if (role == 2 || role == 13 || role == 9) { spelling = s.sema_raw_member_chain_text(node); }
        if (spelling.len > 0 && owner != null
            && generic_list_contains(s.cur_generic_params, spelling)) {
            var generic_owner = owner;
            if (!generic_list_contains(decl_get_generic_params(owner), spelling)
                && s.cur_owner_decl != null) { generic_owner = s.cur_owner_decl; }
            vyx_lsp_bind_generic_target(node, generic_owner, spelling.c_str(), spelling.len);
            spelling = "";
        }
        if (spelling.len > 0) {
            let alias = s.sema_rewrite_use_alias_path(spelling.clone());
            if (alias.len > 0) { spelling = alias; }
            if (s.sema_namespace_exists(spelling.clone()) || s.sema_is_namespace_prefix(spelling.clone())) {
                vyx_lsp_bind_module(node, spelling.c_str(), spelling.len);
            }
            var ent = s.sema_find_class_symbol(spelling.clone());
            if (ent == null && s.sema_load_qualified_type_symbol(spelling.clone())) {
                ent = s.sema_find_class_symbol(spelling.clone());
            }
            if (ent == null && role == 6) {
                ent = s.sema_find_func_symbol_in_module(module_last_segment(spelling.clone()),
                                                       module_parent_path(spelling.clone()));
            }
            if (ent != null) { vyx_lsp_bind_target(node, sym_get_decl(ent)); }
        }
        node = vyx_lsp_bind_next_type();
    }
    s.cur_body_decl = saved_body;
    s.cur_owner_decl = saved_owner;
    s.cur_owner_class = saved_owner_class;
    s.cur_generic_params = saved_generics;
    vyx_lsp_bind_finish(s.error_count);
}
