module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

fn mir_builder_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn mir_builder_c_string_equals(ptr: rawptr, len: i64, value: string) -> bool {
    if (ptr == null || len != value.len) { return false; }
    if (len == 0) { return value.len == 0; }
    return strncmp(ptr, value.c_str(), len) == 0;
}

fn mir_builder_env_enabled(name: string) -> bool {
    let value = mir_builder_env_value(name).trim();
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE"
        || value == "no" || value == "NO" || value == "off" || value == "OFF") {
        return false;
    }
    return true;
}

fn mir_builder_parse_i64(text: string) -> i64 {
    let s = text.trim();
    if (s.len == 0) { return 0; }
    var i: i32 = 0;
    var sign: i64 = 1;
    var out: i64 = 0;
    if (s.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (s.charAt(0) == 43) {
        i = 1;
    }
    while (i < s.len) {
        let c = s.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

fn mir_builder_slow_body_threshold_ms() -> i64 {
    let parsed = mir_builder_parse_i64(mir_builder_env_value("VYX_MIR_BODY_SLOW_MS"));
    if (parsed > 0) { return parsed; }
    return 1000;
}

var g_mir_profile_malloc_bytes: i64 = 0;
var g_mir_profile_malloc_next: i64 = 67108864;
// Count of MIR function shells created after the initial function-table sync
// (late generic instantiations discovered during streaming materialization).
var g_mir_streaming_new_shells: i64 = 0;

public fn mir_builder_streaming_new_shells() -> i64 {
    return g_mir_streaming_new_shells;
}

fn mir_profile_malloc(size: u64) -> rawptr {
    let p = malloc(size);
    if (p != null && vyx_bootstrap_profile_level() > 0) {
        g_mir_profile_malloc_bytes = g_mir_profile_malloc_bytes + (size as i64);
        while (g_mir_profile_malloc_bytes >= g_mir_profile_malloc_next) {
            print("[mir-malloc] bytes=" + policy_i64_to_string(g_mir_profile_malloc_bytes));
            g_mir_profile_malloc_next = g_mir_profile_malloc_next + 67108864;
        }
    }
    return p;
}

fn mir_builder_i32_text(value: i32) -> string {
    return policy_i64_to_string(value as i64);
}

fn mir_builder_memory_mb_text(bytes: i64) -> string {
    if (bytes < 0) { return "-1"; }
    return policy_i64_to_string(bytes / 1048576);
}

fn mir_builder_release_temp_strings(mark: rawptr) {
    vyx_rt_string_arena_release(mark);
}
