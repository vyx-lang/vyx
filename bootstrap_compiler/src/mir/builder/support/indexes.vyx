module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

public class MirNameIdMap {
    public head: rawptr

    public static fn create() -> MirNameIdMap {
        return MirNameIdMap { head: null };
    }

    public fn put(self, key: string, value: i32) {
        if (key.len == 0 || value == mir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (mir_builder_c_string_equals(ptr, len, key)) {
                ast_write_i32(ptr_offset(cur, 16), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        let node = mir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), self.head);
        self.head = node;
    }

    public fn get(self, key: string) -> i32 {
        if (key.len == 0) { return mir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (mir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return mir_id_invalid();
    }
}

public class MirPairIdMap {
    public head: rawptr

    public static fn create() -> MirPairIdMap {
        return MirPairIdMap { head: null };
    }

    public fn key_matches(self, node: rawptr, owner: string, member: string) -> bool {
        if (node == null || owner.len == 0 || member.len == 0) { return false; }
        let owner_ptr = ast_read_rawptr(node);
        let owner_len = ast_read_i64(ptr_offset(node, 8));
        if (!mir_builder_c_string_equals(owner_ptr, owner_len, owner)) { return false; }
        let member_ptr = ast_read_rawptr(ptr_offset(node, 16));
        let member_len = ast_read_i64(ptr_offset(node, 24));
        return mir_builder_c_string_equals(member_ptr, member_len, member);
    }

    public fn put(self, owner: string, member: string, value: i32) {
        if (owner.len == 0 || member.len == 0 || value == mir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            if (self.key_matches(cur, owner, member)) {
                ast_write_i32(ptr_offset(cur, 32), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        let node = mir_profile_malloc(48);
        if (node == null) { return; }
        memset(node, 0, 48);
        ast_write_rawptr(node, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(node, 8), owner.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(node, 24), member.len);
        ast_write_i32(ptr_offset(node, 32), value);
        ast_write_rawptr(ptr_offset(node, 40), self.head);
        self.head = node;
    }

    public fn get(self, owner: string, member: string) -> i32 {
        if (owner.len == 0 || member.len == 0) { return mir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            if (self.key_matches(cur, owner, member)) {
                return ast_read_i32(ptr_offset(cur, 32));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return mir_id_invalid();
    }
}

public class MirIntPairIdMap {
    public head: rawptr

    public static fn create() -> MirIntPairIdMap {
        return MirIntPairIdMap { head: null };
    }

    public fn put(self, lhs: i32, rhs: i32, value: i32) {
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid() || value == 0) { return; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == lhs && ast_read_i32(ptr_offset(cur, 4)) == rhs) {
                ast_write_i32(ptr_offset(cur, 8), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        let node = mir_profile_malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_i32(node, lhs);
        ast_write_i32(ptr_offset(node, 4), rhs);
        ast_write_i32(ptr_offset(node, 8), value);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        self.head = node;
    }

    public fn get(self, lhs: i32, rhs: i32) -> i32 {
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return 0; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == lhs && ast_read_i32(ptr_offset(cur, 4)) == rhs) {
                return ast_read_i32(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return 0;
    }
}

fn mir_name_id_map_put(map: MirNameIdMap, key: string, value: i32) -> MirNameIdMap {
    if (key.len == 0 || value == mir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (mir_builder_c_string_equals(ptr, len, key)) {
            ast_write_i32(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = mir_profile_malloc(32);
    if (node == null) { return map; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    map.head = node;
    return map;
}

fn mir_name_id_map_get(map: MirNameIdMap, key: string) -> i32 {
    if (key.len == 0) { return mir_id_invalid(); }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (mir_builder_c_string_equals(ptr, len, key)) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return mir_id_invalid();
}

fn mir_pair_id_map_key_matches(node: rawptr, owner: string, member: string) -> bool {
    if (node == null || owner.len == 0 || member.len == 0) { return false; }
    let owner_ptr = ast_read_rawptr(node);
    let owner_len = ast_read_i64(ptr_offset(node, 8));
    if (!mir_builder_c_string_equals(owner_ptr, owner_len, owner)) { return false; }
    let member_ptr = ast_read_rawptr(ptr_offset(node, 16));
    let member_len = ast_read_i64(ptr_offset(node, 24));
    return mir_builder_c_string_equals(member_ptr, member_len, member);
}

fn mir_pair_id_map_put(map: MirPairIdMap, owner: string, member: string, value: i32) -> MirPairIdMap {
    if (owner.len == 0 || member.len == 0 || value == mir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        if (mir_pair_id_map_key_matches(cur, owner, member)) {
            ast_write_i32(ptr_offset(cur, 32), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    let node = mir_profile_malloc(48);
    if (node == null) { return map; }
    memset(node, 0, 48);
    ast_write_rawptr(node, ast_dup_c_string(owner));
    ast_write_i64(ptr_offset(node, 8), owner.len);
    ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
    ast_write_i64(ptr_offset(node, 24), member.len);
    ast_write_i32(ptr_offset(node, 32), value);
    ast_write_rawptr(ptr_offset(node, 40), map.head);
    map.head = node;
    return map;
}

fn mir_pair_id_map_get(map: MirPairIdMap, owner: string, member: string) -> i32 {
    if (owner.len == 0 || member.len == 0) { return mir_id_invalid(); }
    var cur = map.head;
    while (cur != null) {
        if (mir_pair_id_map_key_matches(cur, owner, member)) {
            return ast_read_i32(ptr_offset(cur, 32));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    return mir_id_invalid();
}

fn mir_int_pair_id_map_put(map: MirIntPairIdMap, lhs: i32, rhs: i32, value: i32) -> MirIntPairIdMap {
    map.put(lhs, rhs, value);
    return map;
}

fn mir_int_pair_id_map_get(map: MirIntPairIdMap, lhs: i32, rhs: i32) -> i32 {
    return map.get(lhs, rhs);
}

fn mir_name_id_map_dispose(map: MirNameIdMap) -> MirNameIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_pair_id_map_dispose(map: MirPairIdMap) -> MirPairIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 40));
        let owner_ptr = ast_read_rawptr(cur);
        let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        if (owner_ptr != null) { free(owner_ptr); }
        if (member_ptr != null) { free(member_ptr); }
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_int_pair_id_map_dispose(map: MirIntPairIdMap) -> MirIntPairIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 16));
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_i32_map_alloc(count: i32) -> rawptr {
    var n = count;
    if (n < 1) { n = 1; }
    if (n < 262144) { n = 262144; }
    let bytes = ((n + 1) * 4) as u64;
    let p = mir_profile_malloc(bytes);
    if (p != null) { memset(p, 0, bytes); }
    return p;
}

fn mir_i32_map_get(map: rawptr, id: i32) -> i32 {
    if (map == null || id <= 0) { return mir_id_invalid(); }
    return ast_read_i32(ptr_offset(map, id * 4));
}

fn mir_i32_map_put(map: rawptr, id: i32, value: i32) {
    if (map == null || id <= 0) { return; }
    ast_write_i32(ptr_offset(map, id * 4), value);
}

fn mir_i32_map_clear_for_count(map: rawptr, count: i32) -> rawptr {
    if (map == null) { return mir_i32_map_alloc(count); }
    var n = count;
    if (n < 1) { n = 1; }
    if (n < 262144) {
        let bytes = ((262145) * 4) as u64;
        memset(map, 0, bytes);
        return map;
    }
    free(map);
    return mir_i32_map_alloc(count);
}

fn mir_i32_map_dispose(map: rawptr) -> rawptr {
    if (map != null) { free(map); }
    return null;
}
