module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn copy_hir_expr_loc_to_value(self, value_id: i32) {
        if (value_id == mir_id_invalid()) { return; }
        let expr_id = self.unit.value_source_expr(value_id);
        if (expr_id == hir_id_invalid() || expr_id < 1 || expr_id > self.h.expr_cap) { return; }
        let expr_rec = self.h.expr_record(expr_id);
        if (expr_rec == null || ast_read_i32(expr_rec) != expr_id) { return; }
        let line = hir_unit_expr_loc_line(self.h, expr_id);
        if (line <= 0) { return; }
        self.unit.set_value_loc(
                               value_id,
                               line,
                               hir_unit_expr_loc_col(self.h, expr_id),
                               hir_unit_expr_loc_end_line(self.h, expr_id),
                               hir_unit_expr_loc_end_col(self.h, expr_id));
    }

    public fn copy_value_source_locs_since(self, value_mark: i32) {
        var value_id = value_mark + 1;
        while (value_id <= self.unit.value_count) {
            self.copy_hir_expr_loc_to_value(value_id);
            value_id = value_id + 1;
        }
    }

    public fn copy_hir_stmt_loc_to_block(self, block_id: i32) {
        if (block_id == mir_id_invalid()) { return; }
        let stmt_id = self.unit.block_source_stmt(block_id);
        if (stmt_id == hir_id_invalid() || stmt_id < 1 || stmt_id > self.h.stmt_cap) { return; }
        let stmt_rec = self.h.stmt_record(stmt_id);
        if (stmt_rec == null || ast_read_i32(stmt_rec) != stmt_id) { return; }
        let line = hir_unit_stmt_loc_line(self.h, stmt_id);
        if (line <= 0) { return; }
        self.unit.set_block_loc(block_id,
                                line,
                                hir_unit_stmt_loc_col(self.h, stmt_id),
                                hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                hir_unit_stmt_loc_end_col(self.h, stmt_id));
    }

    public fn copy_block_source_locs_since(self, block_mark: i32) {
        var block_id = block_mark + 1;
        while (block_id <= self.unit.block_count) {
            self.copy_hir_stmt_loc_to_block(block_id);
            block_id = block_id + 1;
        }
    }

    public fn copy_hir_source_loc_to_instr(self, instr_id: i32) {
        if (instr_id == mir_id_invalid()) { return; }
        let expr_id = self.unit.instr_source_expr(instr_id);
        if (expr_id != hir_id_invalid() && expr_id >= 1 && expr_id <= self.h.expr_cap) {
            let expr_rec = self.h.expr_record(expr_id);
            if (expr_rec != null && ast_read_i32(expr_rec) == expr_id) {
                let line = hir_unit_expr_loc_line(self.h, expr_id);
                if (line > 0) {
                    self.unit.set_instr_loc(instr_id,
                                            line,
                                            hir_unit_expr_loc_col(self.h, expr_id),
                                            hir_unit_expr_loc_end_line(self.h, expr_id),
                                            hir_unit_expr_loc_end_col(self.h, expr_id));
                    return;
                }
            }
        }
        let stmt_id = self.unit.instr_source_stmt(instr_id);
        if (stmt_id == hir_id_invalid() || stmt_id < 1 || stmt_id > self.h.stmt_cap) { return; }
        let stmt_rec = self.h.stmt_record(stmt_id);
        if (stmt_rec == null || ast_read_i32(stmt_rec) != stmt_id) { return; }
        let line2 = hir_unit_stmt_loc_line(self.h, stmt_id);
        if (line2 <= 0) { return; }
        self.unit.set_instr_loc(instr_id,
                                line2,
                                hir_unit_stmt_loc_col(self.h, stmt_id),
                                hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                hir_unit_stmt_loc_end_col(self.h, stmt_id));
    }

    public fn copy_instr_source_locs_since(self, instr_mark: i32) {
        var instr_id = instr_mark + 1;
        while (instr_id <= self.unit.instr_count) {
            self.copy_hir_source_loc_to_instr(instr_id);
            instr_id = instr_id + 1;
        }
    }

    public fn first_function_source_line(self, function_id: i32) -> i32 {
        var block_id = self.unit.function_first_block(function_id);
        while (block_id != mir_id_invalid()) {
            var instr_id = self.unit.block_first_instr(block_id);
            while (instr_id != mir_id_invalid()) {
                let line = self.unit.instr_loc_line(instr_id);
                if (line > 0) { return line; }
                instr_id = self.unit.instr_next(instr_id);
            }
            let block_line = self.unit.block_loc_line(block_id);
            if (block_line > 0) { return block_line; }
            block_id = self.unit.block_next(block_id);
        }
        return 1;
    }

    public fn copy_local_source_locs_since(self,
                                           local_mark: i32,
                                           function_id: i32,
                                           hir_function_id: i32) {
        let fallback_line = self.first_function_source_line(function_id);
        var local_id = local_mark + 1;
        while (local_id <= self.unit.local_count) {
            if (self.unit.local_function(local_id) == function_id) {
                let hir_local_id = self.unit.local_hir_id(local_id);
                var found: bool = false;
                var stmt_id: i32 = 1;
                while (!found && stmt_id <= self.h.stmt_count) {
                    if (self.h.stmt_function(stmt_id) == hir_function_id
                        && self.h.stmt_local(stmt_id) == hir_local_id) {
                        let line = hir_unit_stmt_loc_line(self.h, stmt_id);
                        if (line > 0) {
                            self.unit.set_local_loc(local_id,
                                                    line,
                                                    hir_unit_stmt_loc_col(self.h, stmt_id),
                                                    hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                                    hir_unit_stmt_loc_end_col(self.h, stmt_id));
                            found = true;
                        }
                    }
                    stmt_id = stmt_id + 1;
                }
                if (!found) {
                    self.unit.set_local_loc(local_id,
                                            fallback_line,
                                            1,
                                            fallback_line,
                                            1);
                }
            }
            local_id = local_id + 1;
        }
    }
}
