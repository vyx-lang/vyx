module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn fixed_array_length(self, type_id: i32) -> i64 {
        if (hir_type_table_kind(self.h.types, type_id) != ty_ARRAY()) { return -1; }
        let text = hir_type_table_text(self.h.types, type_id);
        var split = text.len - 2;
        while (split > 0 && text.charAt(split) != 59) { split -= 1; }
        if (split <= 0 || split + 1 >= text.len - 1) { return -1; }
        var length: i64 = 0;
        var index = split + 1;
        while (index < text.len - 1) {
            let ch = text.charAt(index);
            if (ch < 48 || ch > 57 || length > (9223372036854775807 - (ch - 48)) / 10) { return -1; }
            length = length * 10 + (ch - 48);
            index += 1;
        }
        return length;
    }

    // The local/temporary stores the homogeneous leaf destructor. Keep the
    // array shape in MIR and emit loops so large arrays do not grow codegen
    // memory or generated code in proportion to their number of elements.
    public fn emit_array_place_drop(self, place: i32, drop_fn: i32, stmt: i32, source: i32) {
        var guard = mir_id_invalid();
        if (self.unit.place_kind(place) == mir_place_local()) {
            guard = self.unit.local_drop_guard(self.unit.place_local(place));
        }
        var done = mir_id_invalid();
        if (guard != mir_id_invalid()) {
            let cleanup = self.add_block(stmt);
            done = self.add_block(stmt);
            self.terminate_current(mir_term_branch(), self.add_read_value(guard, source), cleanup, done, mir_id_invalid(), source);
            self.set_current_block(cleanup);
            self.emit_assign(guard, self.add_const_i64_value(0, source), stmt, source);
        }
        self.emit_array_element_drops(place, drop_fn, stmt, source);
        if (done != mir_id_invalid()) {
            self.terminate_current_goto(done);
            self.set_current_block(done);
        }
    }

    public fn emit_array_element_drops(self, place: i32, drop_fn: i32, stmt: i32, source: i32) {
        let type_id = self.unit.place_type(place);
        if (hir_type_table_kind(self.h.types, type_id) != ty_ARRAY()) {
            self.unit.add_instr(self.current_function_id, self.current_block_id, mir_instr_drop(), type_id,
                place, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_target_function(), drop_fn,
                stmt, source, 0, hir_id_invalid(), "array.element.drop");
            return;
        }
        let length = self.fixed_array_length(type_id);
        if (length < 0 || drop_fn == mir_id_invalid()) {
            self.report_error("cannot resolve fixed array element lifecycle or constant extent");
            return;
        }
        let position = self.add_temp_place(self.i64_type_id(), source, "array.drop.position");
        self.emit_assign(position, self.add_const_i64_value(length, source), stmt, source);
        let condition = self.add_block(stmt);
        let body = self.add_block(stmt);
        let exit = self.add_block(stmt);
        self.terminate_current_goto(condition);
        self.set_current_block(condition);
        let current = self.add_read_value(position, source);
        let more = self.add_binary_value(self.bool_type_id(), tk_GT(), current,
            self.add_const_i64_value(0, source), source, "array.drop.more");
        self.terminate_current(mir_term_branch(), more, body, exit, mir_id_invalid(), source);
        self.set_current_block(body);
        self.emit_assign(position, self.add_binary_value(self.i64_type_id(), tk_MINUS(), current,
            self.add_const_i64_value(1, source), source, "array.drop.step"), stmt, source);
        let element = self.unit.add_place(self.current_function_id, mir_place_index(),
            hir_type_table_elem(self.h.types, type_id), mir_id_invalid(), place, mir_id_invalid(),
            self.add_read_value(position, source), source, "array.drop.element");
        self.emit_array_element_drops(element, drop_fn, stmt, source);
        self.terminate_current_goto(condition);
        self.set_current_block(exit);
    }
}
