module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    // Storage scope is deliberately separate from drop_stack.  The latter
    // contains only auto-drop locals, whereas every source let/var needs a
    // StorageDead boundary even when it has scalar/no destructor semantics.
    public fn storage_stack_push(self, hir_local_id: i32) {
        if (hir_local_id == hir_id_invalid()) { return; }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_local_id);
        ast_write_rawptr(ptr_offset(node, 8), self.storage_stack_head);
        self.storage_stack_head = node;
    }

    public fn emit_storage_dead_for_hir_local(self, hir_local_id: i32, source_stmt_id: i32) {
        if (hir_local_id == hir_id_invalid() || self.current_block_terminated()) { return; }
        let place_id = mir_i32_map_get(self.place_map, hir_local_id);
        if (place_id == mir_id_invalid() || self.unit.place_kind(place_id) != mir_place_local()) { return; }
        let local_id = self.unit.place_local(place_id);
        if (local_id == mir_id_invalid()) { return; }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_storage_dead(),
                           self.unit.place_type(place_id),
                           place_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_target_none(),
                           mir_id_invalid(),
                           source_stmt_id,
                           hir_id_invalid(),
                           0,
                           local_id,
                           self.h.local_name(hir_local_id));
    }

    public fn emit_storage_dead_from_oldest_until(self, cur: rawptr, mark: rawptr, source_stmt_id: i32) {
        if (cur == null || cur == mark || self.current_block_terminated()) { return; }
        let next = ast_read_rawptr(ptr_offset(cur, 8));
        self.emit_storage_dead_from_oldest_until(next, mark, source_stmt_id);
        if (self.current_block_terminated()) { return; }
        self.emit_storage_dead_for_hir_local(ast_read_i32(cur), source_stmt_id);
    }

    public fn emit_storage_dead_until(self, mark: rawptr, source_stmt_id: i32) {
        self.emit_storage_dead_from_oldest_until(self.storage_stack_head, mark, source_stmt_id);
        self.storage_stack_head = mark;
    }

    public fn defer_stack_push(self, hir_stmt_id: i32) {
        if (hir_stmt_id == hir_id_invalid()) { return; }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_stmt_id);
        ast_write_rawptr(ptr_offset(node, 8), self.defer_stack_head);
        self.defer_stack_head = node;
    }

    public fn emit_defers_until(self, mark: rawptr, source_stmt_id: i32) {
        var cur = self.defer_stack_head;
        while (cur != null && cur != mark && !self.current_block_terminated()) {
            let stmt_id = ast_read_i32(cur);
            let next = ast_read_rawptr(ptr_offset(cur, 8));
            self.defer_stack_head = next;
            self.lower_stmt(self.h.stmt_child(stmt_id));
            cur = self.defer_stack_head;
        }
        self.defer_stack_head = mark;
    }

    public fn emit_scope_exit_until(self,
                                    defer_mark: rawptr,
                                    drop_mark: rawptr,
                                    storage_mark: rawptr,
                                    source_stmt_id: i32) {
        self.emit_defers_until(defer_mark, source_stmt_id);
        self.emit_drops_until(drop_mark, source_stmt_id);
        self.emit_storage_dead_until(storage_mark, source_stmt_id);
    }

    public fn emit_function_exit(self, source_stmt_id: i32) {
        self.emit_scope_exit_until(null, null, null, source_stmt_id);
    }
}
