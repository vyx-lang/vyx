module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn block_terminated(self, block_id: i32) -> bool {
        if (block_id == mir_id_invalid()) { return true; }
        return self.unit.block_term_kind(block_id) != mir_id_invalid();
    }

    public fn current_block_terminated(self) -> bool {
        return self.block_terminated(self.current_block_id);
    }

    public fn try_lower_static_if_stmt(self, stmt_id: i32) -> bool {
        let folded = self.eval_static_initializer(self.h.stmt_cond(stmt_id));
        if (!folded.ok) { return false; }
        if (folded.kind != mir_static_init_int()
            && folded.kind != mir_static_init_bool()
            && folded.kind != mir_static_init_char()) {
            return false;
        }
        if (folded.int_value != 0) {
            self.lower_stmt(self.h.stmt_child(stmt_id));
        } else {
            self.lower_stmt(self.h.stmt_else(stmt_id));
        }
        return true;
    }

    public fn add_block(self, source_stmt_id: i32) -> i32 {
        return self.unit.add_block( self.current_function_id, source_stmt_id);
    }

    public fn set_current_block(self, block_id: i32) {
        self.current_block_id = block_id;
    }

    public fn terminate_current(self,
                                term_kind: i32,
                                value_id: i32,
                                target_block_id: i32,
                                false_block_id: i32,
                                first_case_id: i32,
                                aux: i32) {
        if (self.current_block_id == mir_id_invalid()) { return; }
        if (self.current_block_terminated()) { return; }
        self.unit.set_block_terminator(
                                      self.current_block_id,
                                      term_kind,
                                      value_id,
                                      target_block_id,
                                      false_block_id,
                                      first_case_id,
                                      aux);
    }

    public fn terminate_current_goto(self, target_block_id: i32) {
        self.terminate_current(mir_term_goto(),
                               mir_id_invalid(),
                               target_block_id,
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_id_invalid());
    }
}
