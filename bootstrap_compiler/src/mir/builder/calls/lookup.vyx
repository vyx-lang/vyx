module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn function_target_by_name(self, name: string) -> i32 {
        if (name.len == 0) { return mir_id_invalid(); }
        let cached = mir_name_id_map_get(self.name_function_index,name);
        if (cached != mir_id_invalid() && self.function_has_executable_body(cached)) {
            self.mark_function_reachable(cached);
            return cached;
        }
        self.index_hir_function_lookups();
        let indexed_hir = mir_name_id_map_get(self.name_hir_function_index,name);
        if (indexed_hir != hir_id_invalid()) {
            let indexed_mir = self.indexed_hir_function_to_executable_mir(indexed_hir);
            if (indexed_mir != mir_id_invalid()) {
                self.name_function_index = mir_name_id_map_put(self.name_function_index,name, indexed_mir);
                self.mark_function_reachable(indexed_mir);
                return indexed_mir;
            }
        }
        var first_match: i32 = hir_id_invalid();
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.h.function_name(hir_fn) == name) {
                if (first_match == hir_id_invalid()) { first_match = hir_fn; }
                if (self.h.function_body(hir_fn) != hir_id_invalid()) {
                    let out = self.ensure_function_shell_for_hir(hir_fn);
                    if (out != mir_id_invalid() && self.function_has_executable_body(out)) {
                        self.name_function_index = mir_name_id_map_put(self.name_function_index,name, out);
                    }
                    return out;
                }
            }
            hir_fn = hir_fn + 1;
        }
        if (first_match != hir_id_invalid()) {
            return self.ensure_function_shell_for_hir(first_match);
        }
        return mir_id_invalid();
    }
}
