module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn lower_expr(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let k = self.h.expr_kind(expr_id);
        let expected_type_id = self.expected_expr_type_id;
        self.expected_expr_type_id = hir_id_invalid();
        var type_id = self.effective_expr_type(expr_id, expected_type_id);
        if (expected_type_id != hir_id_invalid()
            && self.type_dyn_trait_id(expected_type_id) != hir_id_invalid()
            && self.type_dyn_payload_id(self.h.expr_type(expr_id)) != hir_id_invalid()) {
            type_id = self.h.expr_type(expr_id);
            self.ensure_dyn_trait_methods_reachable(type_id, expected_type_id);
        }
        self.ensure_layouts_for_type(type_id);
        if (k == ex_INT_LIT()) {
            var value_kind = mir_value_const_int();
            if (self.type_id_is_float(type_id)) { value_kind = mir_value_const_float(); }
            return self.unit.add_value( self.current_function_id, value_kind, type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_BOOL_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_const_bool(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_STR_LIT() || k == ex_FSTRING()) {
            let v = self.unit.add_value( self.current_function_id, mir_value_const_str(), type_id,
                                       mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                       hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                       self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(v, self.h.expr_first_arg(expr_id));
            return v;
        }
        if (k == ex_CHAR_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_const_char(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_NULL_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_null(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_IDENT()) {
            if (self.h.expr_target_kind(expr_id) == hir_target_local()) {
                let place_id = mir_i32_map_get(self.place_map, self.h.expr_target_id(expr_id));
                let place_type = self.unit.place_type(place_id);
                if (type_id != hir_id_invalid()
                    && place_type != hir_id_invalid()
                    && type_id != place_type
                    && self.type_dyn_trait_id(type_id) != hir_id_invalid()) {
                    self.ensure_dyn_trait_methods_reachable(place_type, type_id);
                    return self.add_read_value_typed(place_id, type_id, expr_id);
                }
                return self.add_read_value(place_id, expr_id);
            }
            return self.unit.add_value(
                                      self.current_function_id,
                                      mir_value_target_ref(),
                                      type_id,
                                      mir_id_invalid(),
                                      self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                      self.target_id_from_hir_expr(expr_id),
                                      expr_id,
                                      hir_unit_expr_flags(self.h, expr_id),
                                      self.h.expr_op(expr_id),
                                      hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id),
                                      self.h.expr_value_text(expr_id));
        }
        if (k == ex_ASSIGN()) {
            let dest_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            // WYSIWYG assign-destination guard: a destination whose declared
            // type is a concrete pointer (`*T`) is the pointer slot itself.
            // Storing a scalar there would overwrite the handle instead of an
            // element, so reject it: the user means `p[0] = v` / `b[i][j] = v`
            // or an `operator[] -> &mut T` container.  Reference destinations
            // keep view semantics; unresolved generics stay deferred.
            if (self.h.expr_op(expr_id) == tk_EQ()
                && self.assign_dest_pointer_type_mismatch(self.h.expr_lhs(expr_id),
                                                          self.h.expr_rhs(expr_id))) {
                let lt = self.h.expr_type(self.h.expr_lhs(expr_id));
                let rt = self.h.expr_type(self.h.expr_rhs(expr_id));
                self.report_error("assignment destination '"
                                  + self.h.expr_value_text(self.h.expr_lhs(expr_id))
                                  + "' has pointer type " + self.type_text(lt)
                                  + " but the assigned value is " + self.type_text(rt)
                                  + "; index the pointer (dest[0] = value) or use a reference-returning operator[]");
                return mir_id_invalid();
            }
            let method_call = self.lower_assignment_method_call(expr_id, type_id);
            if (method_call != mir_id_invalid()) {
                let method_type = self.unit.value_type(method_call);
                if (dest_place != mir_id_invalid() && self.type_text(method_type) != "void") {
                    self.emit_assign(dest_place, method_call, hir_id_invalid(), expr_id);
                }
                return method_call;
            }
            let rhs_expr = self.h.expr_rhs(expr_id);
            let rhs_is_own = rhs_expr != hir_id_invalid()
                && self.h.expr_kind(rhs_expr) == ex_UNARY()
                && self.h.expr_op(rhs_expr) == unary_op_own();
            var rhs_value = mir_id_invalid();
            if (dest_place != mir_id_invalid()) {
                rhs_value = self.lower_expr_as(rhs_expr, self.unit.place_type(dest_place));
            } else {
                rhs_value = self.lower_expr(rhs_expr);
            }
            let assign_op = self.h.expr_op(expr_id);
            if (assign_op != tk_EQ() && dest_place != mir_id_invalid()) {
                let assign_method_name = mir_assign_operator_method_name(assign_op);
                if (assign_method_name.len > 0) {
                    let lhs_expr_a = self.h.expr_lhs(expr_id);
                    let rhs_expr_a = self.h.expr_rhs(expr_id);
                    let assign_call = self.lower_operator_method_call(lhs_expr_a, assign_method_name, rhs_expr_a, type_id, expr_id);
                    if (assign_call != mir_id_invalid()) {
                        let method_type = self.unit.value_type(assign_call);
                        if (self.type_text(method_type) != "void") {
                            self.emit_assign(dest_place, assign_call, hir_id_invalid(), expr_id);
                        }
                        return assign_call;
                    }
                }
                if (rhs_value == mir_id_invalid()) {
                    if (dest_place != mir_id_invalid()) {
                        rhs_value = self.lower_expr_as(self.h.expr_rhs(expr_id), self.unit.place_type(dest_place));
                    } else {
                        rhs_value = self.lower_expr(self.h.expr_rhs(expr_id));
                    }
                }
                let old_value = self.add_read_value(dest_place, expr_id);
                let result_type = self.unit.place_type(dest_place);
                let compound_value = self.unit.add_value(
                                                        self.current_function_id,
                                                        mir_value_binary(),
                                                        result_type,
                                                        mir_id_invalid(),
                                                        mir_target_none(),
                                                        mir_id_invalid(),
                                                        expr_id,
                                                        hir_unit_expr_flags(self.h, expr_id),
                                                        self.binary_op_for_assign_op(assign_op),
                                                        hir_unit_expr_int_value(self.h, expr_id),
                                                        self.h.expr_name(expr_id),
                                                        self.h.expr_value_text(expr_id));
                self.unit.set_value_lhs( compound_value, old_value);
                self.unit.set_value_rhs( compound_value, rhs_value);
                if (!self.assignment_rhs_refs_place_local(dest_place, self.h.expr_lhs(expr_id))
                    && !self.assignment_rhs_refs_place_local(dest_place, self.h.expr_rhs(expr_id))) {
                    self.drop_local_for_place_before_reassign(dest_place, expr_id);
                }
                self.emit_assign(dest_place, compound_value, hir_id_invalid(), expr_id);
                return compound_value;
            }
            if (rhs_is_own
                && !self.assignment_rhs_refs_place_local(dest_place, rhs_expr)) {
                self.emit_pointer_delete_for_place(dest_place, expr_id);
            }
            if (!self.assignment_rhs_refs_place_local(dest_place, rhs_expr)) {
                self.drop_local_for_place_before_reassign(dest_place, expr_id);
            }
            self.emit_assign(dest_place, rhs_value, hir_id_invalid(), expr_id);
            self.deactivate_assignment_source(rhs_expr, self.unit.place_type(dest_place), self.hir_local_for_place(dest_place));
            return rhs_value;
        }
        if (k == ex_BIN()) {
            if (self.h.expr_op(expr_id) == tk_PIPEARROW()) {
                return self.lower_pipe_expr(expr_id, type_id);
            }
            let logic_value = self.lower_short_circuit_binary_expr(expr_id, type_id);
            if (logic_value != mir_id_invalid()) { return logic_value; }
            let op = self.h.expr_op(expr_id);
            let method_name = mir_binop_operator_method_name(op);
            if (method_name.len > 0) {
                let lhs_expr = self.h.expr_lhs(expr_id);
                let rhs_expr = self.h.expr_rhs(expr_id);
                let overload_call = self.lower_operator_method_call(lhs_expr, method_name, rhs_expr, type_id, expr_id);
                if (overload_call != mir_id_invalid()) { return overload_call; }
                if (op == tk_NEQ()) {
                    let eq_call = self.lower_operator_method_call(lhs_expr, "operator==", rhs_expr, type_id, expr_id);
                    if (eq_call != mir_id_invalid()) {
                        let negated = self.unit.add_value( self.current_function_id, mir_value_unary(), type_id,
                                                        mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                                        hir_unit_expr_flags(self.h, expr_id), tk_NOT(),
                                                        hir_unit_expr_int_value(self.h, expr_id),
                                                        self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
                        self.unit.set_value_lhs( negated, eq_call);
                        return negated;
                    }
                }
            }
            let lhs_value = self.lower_expr(self.h.expr_lhs(expr_id));
            let rhs_value2 = self.lower_expr(self.h.expr_rhs(expr_id));
            let out = self.unit.add_value( self.current_function_id, mir_value_binary(), type_id,
                                         mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                         hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                         self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out, lhs_value);
            self.unit.set_value_rhs( out, rhs_value2);
            return out;
        }
        if (k == ex_AWAIT()) {
            return self.lower_await_expr(expr_id, type_id);
        }
        if (k == ex_UNARY() || k == ex_COMPTIME() || k == ex_FAIL()) {
            if (k == ex_UNARY()
                && (self.h.expr_op(expr_id) == tk_PLUSPLUS()
                    || self.h.expr_op(expr_id) == tk_MINUSMINUS())) {
                return self.lower_inc_dec_expr(expr_id);
            }
            let op_u = self.h.expr_op(expr_id);
            let method_name_u = mir_unary_operator_method_name(op_u);
            if (method_name_u.len > 0 && k == ex_UNARY()) {
                let lhs_expr_u = self.h.expr_lhs(expr_id);
                let overload_call_u = self.lower_operator_method_call(lhs_expr_u, method_name_u, hir_id_invalid(), type_id, expr_id);
                if (overload_call_u != mir_id_invalid()) { return overload_call_u; }
            }
            let inner_value = self.lower_expr(self.h.expr_lhs(expr_id));
            if (k == ex_UNARY() && self.h.expr_op(expr_id) == unary_op_own()) {
                let source_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
                let move_value = self.unit.add_value(
                                                    self.current_function_id,
                                                    mir_value_intrinsic(),
                                                    type_id,
                                                    source_place,
                                                    mir_target_none(),
                                                    mir_id_invalid(),
                                                    expr_id,
                                                    hir_unit_expr_flags(self.h, expr_id),
                                                    unary_op_own(),
                                                    0,
                                                    "__vyx_move_handle",
                                                    self.h.expr_value_text(expr_id));
                self.unit.set_value_lhs( move_value, inner_value);
                return move_value;
            }
            let out_un = self.unit.add_value( self.current_function_id, mir_value_unary(), type_id,
                                            mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                            hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                            self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_un, inner_value);
            return out_un;
        }
        if (k == ex_CAST()) {
            let lhs_expr = self.h.expr_lhs(expr_id);
            self.ensure_dyn_trait_methods_reachable(self.h.expr_type(lhs_expr), type_id);
            let cast_value = self.lower_expr(lhs_expr);
            let out_cast = self.unit.add_value( self.current_function_id, mir_value_cast(), type_id,
                                              mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_cast, cast_value);
            return out_cast;
        }
        if (k == ex_NEW()) {
            return self.lower_new_expr_value(expr_id, type_id);
        }
        if (k == ex_DELETE()) {
            return self.lower_delete_expr_value(expr_id, type_id);
        }
        if (k == ex_ADDR_OF()) {
            let addr_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            return self.unit.add_value( self.current_function_id, mir_value_address_of(), type_id,
                                      addr_place, mir_target_none(), mir_id_invalid(), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_DEREF() || k == ex_MEMBER() || k == ex_INDEX()) {
            if (k == ex_INDEX()) {
                // WYSIWYG: when the index expression's declared type is a
                // reference (`&mut T` / `&T` return from operator[]), the
                // value IS the reference handle — do not collapse it to the
                // element view.  Scalar contexts keep the element-view read.
                let want_ref_value = self.index_expr_wants_reference_value(expr_id, type_id);
                if (!want_ref_value) {
                    let index_place = self.lower_overloaded_index_place(expr_id, false);
                    if (index_place != mir_id_invalid()) { return self.add_read_value(index_place, expr_id); }
                }
                let index_overload = self.lower_operator_method_call(self.h.expr_lhs(expr_id), "operator[]", self.h.expr_rhs(expr_id), type_id, expr_id);
                if (index_overload != mir_id_invalid()) { return index_overload; }
                let pack_index_value = self.lower_pack_index_expr(expr_id);
                if (pack_index_value != mir_id_invalid()) { return pack_index_value; }
            }
            if (!(k == ex_MEMBER() && self.h.expr_target_kind(expr_id) == hir_target_function())) {
                let place = self.lower_expr_place(expr_id);
                if (place != mir_id_invalid()) { return self.add_read_value(place, expr_id); }
            }
            let target_ref = self.unit.add_value(
                                                self.current_function_id,
                                                mir_value_target_ref(),
                                                type_id,
                                                mir_id_invalid(),
                                                self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                                self.target_id_from_hir_expr(expr_id),
                                                expr_id,
                                                hir_unit_expr_flags(self.h, expr_id),
                                                self.h.expr_op(expr_id),
                                                hir_unit_expr_int_value(self.h, expr_id),
                                                self.h.expr_name(expr_id),
                                                self.h.expr_value_text(expr_id));
            var member_lhs_value = mir_id_invalid();
            if (k == ex_MEMBER() && self.h.expr_lhs(expr_id) != hir_id_invalid()) {
                member_lhs_value = self.lower_expr(self.h.expr_lhs(expr_id));
                self.unit.set_value_lhs( target_ref, member_lhs_value);
            }
            if (k == ex_MEMBER()
                && self.h.expr_target_kind(expr_id) == hir_target_builtin()
                && self.h.expr_name(expr_id) == "fields"
                && member_lhs_value != mir_id_invalid()) {
                self.ensure_layouts_for_type(self.unit.value_type(member_lhs_value));
            }
            return target_ref;
        }
        if (k == ex_CALL()) {
            return self.lower_call_expr_value(expr_id, type_id, mir_id_invalid(), hir_id_invalid());
        }
        if (k == ex_STRUCT_INIT() || k == ex_ARRAY_LIT() || k == ex_TUPLE_LIT()) {
            // Container list init (`Vec<i32>{1, 2, 3}`) is rewritten at the
            // HIR level into `Type::from_array([e1..en], n)` — see
            // hir_builder.build_container_list_init_from_array_call — so the
            // MIR aggregate path only ever sees real field inits here.
            self.ensure_layouts_for_type(type_id);
            let out_ag = self.unit.add_value( self.current_function_id, mir_value_aggregate(), type_id,
                                            mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                            self.target_id_from_hir_expr(expr_id), expr_id,
                                            hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                            self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(out_ag, self.h.expr_first_arg(expr_id));
            if (self.h.expr_aux(expr_id) != hir_id_invalid()) {
                self.unit.set_value_aux( out_ag, self.lower_expr(self.h.expr_aux(expr_id)));
            }
            return out_ag;
        }
        if (k == ex_TERNARY()) {
            let lhs_tern = self.lower_expr(self.h.expr_lhs(expr_id));
            let rhs_tern = self.lower_expr(self.h.expr_rhs(expr_id));
            let aux_tern = self.lower_expr(self.h.expr_aux(expr_id));
            let out_tern = self.unit.add_value( self.current_function_id, mir_value_control_result(), type_id,
                                              mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_tern, lhs_tern);
            self.unit.set_value_rhs( out_tern, rhs_tern);
            self.unit.set_value_aux( out_tern, aux_tern);
            return out_tern;
        }
        if (k == ex_IF_EXPR()) {
            return self.lower_control_if_expr(expr_id);
        }
        if (k == ex_CLOSURE()) {
            let closure_hir_fn = self.h.expr_target_id(expr_id);
            let closure_mir_fn = self.target_id_from_hir_expr(expr_id);
            self.lower_capture_init_values_for_function(closure_hir_fn, closure_mir_fn);
            return self.unit.add_value(
                                      self.current_function_id,
                                      mir_value_target_ref(),
                                      type_id,
                                      mir_id_invalid(),
                                      self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                      closure_mir_fn,
                                      expr_id,
                                      hir_unit_expr_flags(self.h, expr_id),
                                      self.h.expr_op(expr_id),
                                      hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id),
                                      self.h.expr_value_text(expr_id));
        }
        if (k == ex_MATCH_EXPR()) {
            return self.lower_match_expr(expr_id);
        }
        if (k == ex_INLINE_ASM()) {
            let out_intr = self.unit.add_value( self.current_function_id, mir_value_intrinsic(), type_id,
                                              mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                              self.target_id_from_hir_expr(expr_id), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(out_intr, self.h.expr_first_arg(expr_id));
            return out_intr;
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_intrinsic(),
                                  type_id,
                                  mir_id_invalid(),
                                  self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                  self.target_id_from_hir_expr(expr_id),
                                  expr_id,
                                  hir_unit_expr_flags(self.h, expr_id),
                                  self.h.expr_op(expr_id),
                                  hir_unit_expr_int_value(self.h, expr_id),
                                  self.h.expr_name(expr_id),
                                  self.h.expr_value_text(expr_id));
    }
}
