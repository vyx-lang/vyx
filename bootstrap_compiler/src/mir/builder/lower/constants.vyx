module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn add_const_i64_value(self, value: i64, source_expr_id: i32) -> i32 {
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_int(),
                                  self.i64_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  value,
                                  "",
                                  policy_i64_to_string(value));
    }

    public fn add_const_i32_value(self, value: i64, source_expr_id: i32) -> i32 {
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_int(),
                                  self.i32_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  value,
                                  "",
                                  policy_i64_to_string(value));
    }

    public fn add_const_bool_value(self, value: bool, source_expr_id: i32) -> i32 {
        var int_value: i64 = 0;
        var text_value = "false";
        if (value) {
            int_value = 1;
            text_value = "true";
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_bool(),
                                  self.bool_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  int_value,
                                  "",
                                  text_value);
    }

    public fn add_default_value_for_type(self, type_id: i32, source_expr_id: i32) -> i32 {
        if (type_id == hir_id_invalid()) { return mir_id_invalid(); }
        let kind = hir_type_table_kind(self.h.types, type_id);
        if (kind == ty_BOOL()) { return self.add_const_bool_value(false, source_expr_id); }
        var value_kind = mir_value_const_int();
        var text_value = "0";
        if (self.type_id_is_float(type_id)) {
            value_kind = mir_value_const_float();
            text_value = "0.0";
        } else if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF() || kind == ty_CLASS()) {
            value_kind = mir_value_null();
            text_value = "null";
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  value_kind,
                                  type_id,
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  0,
                                  "",
                                  text_value);
    }
}
