module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn target_kind_from_hir(self, hir_target_kind: i32) -> i32 {
        if (hir_target_kind == hir_target_function()) { return mir_target_function(); }
        if (hir_target_kind == hir_target_item()) { return mir_target_hir_item(); }
        if (hir_target_kind == hir_target_field()) { return mir_target_hir_field(); }
        if (hir_target_kind == hir_target_variant()) { return mir_target_hir_variant(); }
        if (hir_target_kind == hir_target_builtin()) { return mir_target_builtin(); }
        if (hir_target_kind == hir_target_local()) { return mir_target_local(); }
        if (hir_target_kind == hir_target_type()) { return mir_target_type(); }
        return mir_target_none();
    }

    public fn target_id_from_hir_expr(self, expr_id: i32) -> i32 {
        let hir_target_kind = self.h.expr_target_kind(expr_id);
        var hir_target_id = self.h.expr_target_id(expr_id);
        if (hir_target_kind == hir_target_function()) {
            if (hir_target_id == hir_id_invalid()) {
                self.index_hir_function_lookups();
                hir_target_id = mir_name_id_map_get(self.name_hir_function_index,self.h.expr_name(expr_id));
            }
            return self.ensure_function_shell_for_hir(hir_target_id);
        }
        if (hir_target_kind == hir_target_local()) {
            return mir_i32_map_get(self.local_map, hir_target_id);
        }
        return hir_target_id;
    }

    public fn add_read_value(self, place_id: i32, source_expr_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        return self.add_read_value_typed(place_id, self.unit.place_type(place_id), source_expr_id);
    }

    public fn value_flags_for_expr(self, source_expr_id: i32) -> i32 {
        if (source_expr_id == hir_id_invalid()) { return 0; }
        var flags = hir_unit_expr_flags(self.h, source_expr_id);
        if ((hir_unit_expr_move_drop_flags(self.h, source_expr_id) & hir_move_drop_flag_move_arg()) != 0) {
            flags = flags | mir_value_flag_move_arg();
        }
        return flags;
    }

    public fn mark_value_tree_move_arg(self, value_id: i32, depth: i32) {
        if (value_id == mir_id_invalid() || depth > 32) { return; }
        if (value_id < 1 || value_id > self.unit.value_count) { return; }
        if (self.unit.value_kind(value_id) == mir_value_read_place()) {
            self.unit.set_value_flags(
                                     value_id,
                                     self.unit.value_flags(value_id) | mir_value_flag_move_arg());
        }
        self.mark_value_tree_move_arg(self.unit.value_lhs(value_id), depth + 1);
        self.mark_value_tree_move_arg(self.unit.value_rhs(value_id), depth + 1);
        self.mark_value_tree_move_arg(self.unit.value_aux(value_id), depth + 1);
        var arg = self.unit.value_first_arg(value_id);
        var guard: i32 = 0;
        while (arg != mir_id_invalid() && guard <= self.unit.value_count) {
            self.mark_value_tree_move_arg(arg, depth + 1);
            arg = self.unit.value_next_arg(arg);
            guard = guard + 1;
        }
    }

    public fn param_local_moves_argument(self, param_local_id: i32) -> bool {
        if (param_local_id == hir_id_invalid()) { return false; }
        return (self.h.local_flags(param_local_id) & hir_local_flag_move_arg()) != 0;
    }

    public fn add_read_value_typed(self, place_id: i32, type_id: i32, source_expr_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_read_place(),
                                  type_id,
                                  place_id,
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  self.value_flags_for_expr(source_expr_id),
                                  0,
                                  0,
                                  self.unit.place_name(place_id),
                                  "");
    }
}
