module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;
use bootstrap.sema;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
}

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn full_expression_temp_for_expr(self, expr_id: i32) -> rawptr {
        var cur = self.full_expression_temps;
        while (cur != null) {
            if (ast_read_i32(cur) == expr_id) { return cur; }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return null;
    }

    public fn materialize_full_expression_owner(self, expr_id: i32, value_id: i32) -> i32 {
        if (expr_id == hir_id_invalid() || value_id == mir_id_invalid()) { return value_id; }
        if (hir_unit_expr_value_category(self.h, expr_id) != hir_value_cat_value()) { return value_id; }
        let type_id = self.unit.value_type(value_id);
        let owner_kind = hir_type_table_kind(self.h.types, type_id);
        if (owner_kind != ty_CLASS() && owner_kind != ty_ARRAY()) { return value_id; }
        // Descriptor-owned DCI records construct directly into final storage.
        // Their existing lifecycle lowering owns the place; a native value
        // materialization would introduce an illegal object copy.
        if (mir_unit_type_is_foreign_dci(&self.unit, type_id)) { return value_id; }
        var drop_hir_fn = hir_unit_expr_drop_function(self.h, expr_id);
        if (self.has_hir_codegen_builder) {
            let concrete_type_text = hir_type_table_text(self.h.types, type_id);
            let concrete_drop = hir_codegen_builder_handle_ensure_drop_instance_for_type_text(
                self.hir_codegen_builder, concrete_type_text);
            // Instantiating a destructor can grow any HIR table. The builder
            // frees the previous storage when it grows; refresh this view
            // before reading or writing an expression or publishing it back.
            self.refresh_from_codegen_builder();
            if (concrete_drop != hir_id_invalid()) {
                drop_hir_fn = concrete_drop;
                self.h.set_expr_drop_function(expr_id, concrete_drop);
            }
        }
        if (drop_hir_fn == hir_id_invalid()) { return value_id; }
        let k = self.h.expr_kind(expr_id);
        if (k != ex_CALL() && k != ex_STRUCT_INIT() && k != ex_ARRAY_LIT() && k != ex_TERNARY()
            && k != ex_IF_EXPR() && k != ex_MATCH_EXPR()) { return value_id; }
        // An overloaded assignment can return an existing place. Only actual
        // factory/aggregate/control results introduce a temporary owner.
        let vk = self.unit.value_kind(value_id);
        if (vk != mir_value_call() && vk != mir_value_aggregate()
            && vk != mir_value_control_result()
            && !(vk == mir_value_read_place()
                 && (k == ex_TERNARY() || k == ex_IF_EXPR() || k == ex_MATCH_EXPR()))) {
            return value_id;
        }
        if (k == ex_TERNARY() && vk == mir_value_control_result()) {
            self.unit.set_value_rhs(value_id,
                self.conditional_owner_arm(self.h.expr_rhs(expr_id), self.unit.value_rhs(value_id)));
            self.unit.set_value_aux(value_id,
                self.conditional_owner_arm(self.h.expr_aux(expr_id), self.unit.value_aux(value_id)));
        }
        let saved_drop_stack = self.drop_stack_head;
        let place_id = self.add_owned_temp_place(type_id, expr_id, "expr.owner", drop_hir_fn);
        // Full-expression lifetime is independent of lexical scope. A branch
        // must never destroy a lazily evaluated sibling before it is constructed.
        let drop_node = self.drop_stack_head;
        self.drop_stack_head = saved_drop_stack;
        if (drop_node != saved_drop_stack && drop_node != null) { free(drop_node); }
        let guard_place = self.add_temp_place_with_flags(self.bool_type_id(), expr_id,
                                                        "expr.live", mir_local_flag_drop_guard());
        self.unit.set_local_drop_guard(self.unit.place_local(place_id), guard_place);
        let out = self.unit.add_value(self.current_function_id, mir_value_materialize(), type_id,
                                       place_id, mir_target_none(), mir_id_invalid(), expr_id,
                                       self.value_flags_for_expr(expr_id), 0, 0, "expr.owner", "");
        self.unit.set_value_lhs(out, value_id);
        let node = mir_profile_malloc(24);
        if (node == null) {
            self.report_error("cannot record full-expression owner");
            return mir_id_invalid();
        }
        ast_write_i32(node, expr_id);
        ast_write_i32(ptr_offset(node, 4), self.unit.local_hir_id(self.unit.place_local(place_id)));
        ast_write_rawptr(ptr_offset(node, 8), self.full_expression_temps);
        ast_write_i32(ptr_offset(node, 16), out);
        ast_write_i32(ptr_offset(node, 20), 1);
        self.full_expression_temps = node;
        return out;
    }

    public fn conditional_owner_arm(self, expr_id: i32, value_id: i32) -> i32 {
        let temporary = self.full_expression_temp_for_expr(expr_id);
        if (temporary != null) {
            ast_write_i32(ptr_offset(temporary, 20), 0);
            return value_id;
        }
        if (self.unit.value_kind(value_id) != mir_value_read_place()) { return value_id; }
        let place = self.unit.value_place(value_id);
        if (self.unit.place_kind(place) != mir_place_local()) { return value_id; }
        let local = self.unit.place_local(place);
        if ((self.unit.local_flags(local) & mir_local_flag_auto_drop()) == 0) { return value_id; }
        if (self.unit.local_drop_guard(local) == mir_id_invalid()) {
            var guard_flags = mir_local_flag_drop_guard();
            if ((self.unit.local_flags(local) & mir_local_flag_param()) != 0) {
                guard_flags = guard_flags | mir_local_flag_guard_initially_live();
            }
            self.unit.set_local_drop_guard(local,
                self.add_temp_place_with_flags(self.bool_type_id(), expr_id, "move.live", guard_flags));
        }
        let out = self.unit.add_value(self.current_function_id, mir_value_move_place(),
            self.unit.value_type(value_id), place, mir_target_none(), mir_id_invalid(), expr_id,
            0, 0, 0, "conditional.move", "");
        self.unit.set_value_lhs(out, value_id);
        return out;
    }

    public fn emit_full_expression_temp_drop(self, node: rawptr, stmt_id: i32) {
        if (node == null || self.current_block_terminated()
            || ast_read_i32(ptr_offset(node, 20)) == 0) { return; }
        let hir_local = ast_read_i32(ptr_offset(node, 4));
        let value_id = ast_read_i32(ptr_offset(node, 16));
        let place_id = self.unit.value_place(value_id);
        let drop_fn = self.ensure_function_shell_for_hir(hir_unit_local_drop_function(self.h, hir_local));
        if (hir_type_table_kind(self.h.types, self.unit.place_type(place_id)) == ty_ARRAY()) {
            self.emit_array_place_drop(place_id, drop_fn, stmt_id, ast_read_i32(node));
            return;
        }
        self.unit.add_instr(self.current_function_id, self.current_block_id, mir_instr_drop(),
                             self.unit.place_type(place_id), place_id, mir_id_invalid(),
                             mir_id_invalid(), mir_id_invalid(), mir_target_function(), drop_fn,
                             stmt_id, ast_read_i32(node), 0, hir_local, "expr.owner");
    }

    public fn emit_pending_full_expression_drops(self, stmt_id: i32) {
        var cur = self.full_expression_temps;
        while (cur != null) {
            self.emit_full_expression_temp_drop(cur, stmt_id);
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
    }

    public fn full_expression_borrow_mentions_stmt(self, stmt_id: i32) -> bool {
        if (stmt_id <= 0 || stmt_id == hir_id_invalid() || stmt_id > self.h.stmt_count) { return false; }
        var cur = stmt_id;
        // A block's value comes from its tail, not from conditions or reads
        // performed earlier while computing that value.
        while (self.h.stmt_next(cur) != hir_id_invalid()) { cur = self.h.stmt_next(cur); }
        let kind = self.h.stmt_kind(cur);
        if (kind == hir_stmt_expr() || kind == hir_stmt_return()) {
            return self.full_expression_borrow_mentions_owner(self.h.stmt_expr(cur));
        }
        if (kind == hir_stmt_block()) {
            return self.full_expression_borrow_mentions_stmt(self.h.stmt_child(cur));
        }
        if (kind == hir_stmt_if()) {
            return self.full_expression_borrow_mentions_stmt(self.h.stmt_child(cur))
                || self.full_expression_borrow_mentions_stmt(self.h.stmt_else(cur));
        }
        return false;
    }

    public fn full_expression_call_returns_independent_storage(self, expr_id: i32) -> bool {
        if (self.h.expr_kind(expr_id) != ex_CALL()) { return false; }
        let callee = self.h.expr_lhs(expr_id);
        var target_kind = self.h.expr_target_kind(expr_id);
        var target = self.h.expr_target_id(expr_id);
        if (target_kind == hir_target_none() && callee != hir_id_invalid()) {
            target_kind = self.h.expr_target_kind(callee);
            target = self.h.expr_target_id(callee);
        }
        let result_kind = hir_type_table_kind(self.h.types, self.h.expr_type(expr_id));
        if (result_kind == ty_PTR() || result_kind == ty_RAWPTR()) {
            return target_kind == hir_target_function()
                && (self.h.function_flags(target) & hir_function_flag_independent_pointer_return()) != 0;
        }
        if (result_kind != ty_STRING()) { return false; }
        if (target_kind == hir_target_builtin()) {
            if (callee != hir_id_invalid() && self.h.expr_kind(callee) == ex_MEMBER()) {
                let receiver = self.h.expr_lhs(callee);
                if (hir_type_table_kind(self.h.types, self.h.expr_type(receiver)) != ty_STRING()) { return false; }
                let method = policy_string_method_kind(self.h.expr_name(callee));
                return policy_string_intrinsic_returns_independent_storage(method);
            }
            return policy_string_builtin_returns_independent_storage(self.h.builtin_name(target));
        }
        if (target_kind == hir_target_function() && self.has_hir_codegen_builder) {
            let result = hir_codegen_builder_handle_function_returns_independent_str(self.hir_codegen_builder, target);
            // A demanded return summary may briefly resolve a concrete callee.
            // Parameter/type registration can grow the shared HIR arenas.
            self.refresh_from_codegen_builder();
            return result;
        }
        return false;
    }

    public fn full_expression_borrow_mentions_owner(self, expr_id: i32) -> bool {
        if (expr_id <= 0 || expr_id == hir_id_invalid() || expr_id > self.h.expr_count) { return false; }
        let node = self.full_expression_temp_for_expr(expr_id);
        if (node != null && ast_read_i32(ptr_offset(node, 20)) != 0) { return true; }
        let k = self.h.expr_kind(expr_id);
        if (k == ex_IDENT() && self.h.expr_target_kind(expr_id) == hir_target_local()) {
            var borrow = self.full_expression_borrows;
            while (borrow != null) {
                if (ast_read_i32(borrow) == self.h.expr_target_id(expr_id)) { return true; }
                borrow = ast_read_rawptr(ptr_offset(borrow, 8));
            }
        }
        // Follow only fields owned by expression kinds that can carry a value.
        // Unconditionally walking lhs/rhs/aux lets literal nodes expose stale
        // positive IDs from a previous expression and falsely reject a later
        // `return 0` after a borrowed local was built.
        if (k == ex_CALL()) {
            var borrows = self.full_expression_borrow_mentions_owner(self.h.expr_lhs(expr_id))
                || self.full_expression_borrow_mentions_owner(self.h.expr_aux(expr_id));
            var arg = self.h.expr_first_arg(expr_id);
            while (!borrows && arg != hir_id_invalid()) {
                borrows = self.full_expression_borrow_mentions_owner(arg);
                arg = self.h.expr_next_arg(arg);
            }
            return borrows && !self.full_expression_call_returns_independent_storage(expr_id);
        }
        if (k == ex_BIN() && self.h.expr_op(expr_id) == tk_PIPEARROW()) {
            return self.full_expression_borrow_mentions_owner(self.h.expr_rhs(expr_id));
        }
        if (k == ex_TERNARY()) {
            if (self.full_expression_borrow_mentions_owner(self.h.expr_rhs(expr_id))) { return true; }
            if (self.full_expression_borrow_mentions_owner(self.h.expr_aux(expr_id))) { return true; }
        }
        if (k == ex_MEMBER() || k == ex_CAST() || k == ex_ADDR_OF()
            || k == ex_DEREF() || k == ex_INDEX()) {
            if (self.full_expression_borrow_mentions_owner(self.h.expr_lhs(expr_id))) { return true; }
        }
        if (k == ex_IF_EXPR()) {
            if (self.full_expression_borrow_mentions_stmt(self.h.expr_stmt_rhs(expr_id))) { return true; }
            if (self.full_expression_borrow_mentions_stmt(self.h.expr_stmt_aux(expr_id))) { return true; }
            if (self.full_expression_borrow_mentions_owner(self.h.expr_aux(expr_id))) { return true; }
        }
        if (k == ex_MATCH_EXPR()) {
            var arm = self.h.expr_stmt_rhs(expr_id);
            while (arm != hir_id_invalid()) {
                if (self.full_expression_borrow_mentions_stmt(self.h.stmt_child(arm))) { return true; }
                arm = self.h.stmt_next(arm);
            }
        }
        if (k == ex_STRUCT_INIT() || k == ex_TUPLE_LIT()
            || k == ex_ARRAY_LIT() || k == ex_TERNARY() || k == ex_IF_EXPR()
            || k == ex_MATCH_EXPR()) {
            var arg = self.h.expr_first_arg(expr_id);
            while (arg != hir_id_invalid()) {
                if (self.full_expression_borrow_mentions_owner(arg)) { return true; }
                arg = self.h.expr_next_arg(arg);
            }
        }
        return false;
    }

    public fn full_expression_result_can_borrow(self, type_id: i32) -> bool {
        let kind = hir_type_table_kind(self.h.types, type_id);
        return kind == ty_STRING() || kind == ty_REF() || kind == ty_MUTREF();
    }

    public fn extend_full_expression_borrow(self, mark: rawptr, expr_id: i32, type_id: i32,
                                            hir_local: i32, branch_result: bool) {
        let expression_kind = self.h.expr_kind(expr_id);
        let aggregate_result = expression_kind == ex_STRUCT_INIT()
            || expression_kind == ex_TUPLE_LIT()
            || expression_kind == ex_ARRAY_LIT();
        if (!self.full_expression_result_can_borrow(type_id) && !aggregate_result) { return; }
        var has_owner = self.full_expression_borrow_mentions_owner(expr_id);
        // A method receiver can hide the owner behind a lowered call node.
        // The mark bounds this fallback to the current full expression, so an
        // unrelated temporary from an earlier statement cannot be retained.
        if (!has_owner) {
            var probe = self.full_expression_temps;
            while (probe != null && probe != mark) {
                if (ast_read_i32(ptr_offset(probe, 20)) != 0) {
                    has_owner = true;
                    break;
                }
                probe = ast_read_rawptr(ptr_offset(probe, 8));
            }
        }
        if (!has_owner) { return; }
        if (self.full_expression_call_returns_independent_storage(expr_id)) { return; }
        // A view stored in a binding needs its backing temporary throughout
        // that binding's scope, including conditional construction guards.
        var node = self.full_expression_temps;
        while (node != null && node != mark) {
            if (ast_read_i32(ptr_offset(node, 20)) != 0) {
                let owner_local = ast_read_i32(ptr_offset(node, 4));
                // A regular binding already has a lexical drop-stack entry.
                // Keep its owner in that scope; only branch result temporaries
                // (which have no destination entry yet) need function-level
                // promotion to survive the branch join.
                let expression_kind = self.h.expr_kind(expr_id);
                let is_control_result = branch_result
                    || expression_kind == ex_IF_EXPR()
                    || expression_kind == ex_MATCH_EXPR()
                    || expression_kind == ex_TERNARY();
                if (self.drop_stack_find(hir_local) != null || !is_control_result) {
                    self.drop_stack_push(owner_local);
                } else {
                    self.promote_full_expression_borrow_owner(owner_local);
                }
                ast_write_i32(ptr_offset(node, 20), 0);
            }
            node = ast_read_rawptr(ptr_offset(node, 8));
        }
        let borrow = mir_profile_malloc(16);
        if (borrow == null) { self.report_error("cannot record temporary borrow provenance"); return; }
        ast_write_i32(borrow, hir_local);
        ast_write_rawptr(ptr_offset(borrow, 8), self.full_expression_borrows);
        self.full_expression_borrows = borrow;
    }

    public fn promote_full_expression_borrow_owner(self, hir_local: i32) {
        if (hir_local == hir_id_invalid() || !self.hir_local_has_drop(hir_local)) { return; }
        // The owner is intentionally moved past the branch scope.  Keep its
        // drop node linked because branch snapshots may point at it; mark it
        // inactive until the function-exit pass reactivates it and drops it.
        self.drop_stack_set_active(hir_local, false);
        if (self.lowering_return_expression) {
            self.full_expression_return_borrow_pending = true;
        }
        var cur = self.full_expression_borrow_owners;
        while (cur != null) {
            if (ast_read_i32(cur) == hir_local) { return; }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let node = mir_profile_malloc(16);
        if (node == null) { self.report_error("cannot record borrowed temporary owner"); return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_local);
        ast_write_rawptr(ptr_offset(node, 8), self.full_expression_borrow_owners);
        self.full_expression_borrow_owners = node;
    }

    public fn emit_full_expression_borrow_owner_drops(self, stmt_id: i32) {
        var cur = self.full_expression_borrow_owners;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 8));
            let hir_local = ast_read_i32(cur);
            if (!self.current_block_terminated()) {
                if (self.drop_stack_find(hir_local) == null) {
                    self.drop_stack_push(hir_local);
                } else {
                    self.drop_stack_set_active(hir_local, true);
                }
                self.emit_drop_for_hir_local(hir_local, stmt_id, hir_id_invalid(), true);
            }
            free(cur);
            cur = next;
        }
        self.full_expression_borrow_owners = null;
    }

    public fn check_full_expression_return_borrow(self, expr_id: i32, type_id: i32) {
        if (!self.full_expression_result_can_borrow(type_id)) {
            self.full_expression_return_borrow_pending = false;
            return;
        }
        let mentions_owner = self.full_expression_borrow_mentions_owner(expr_id);
        var invalid = self.full_expression_result_can_borrow(type_id)
            && (self.full_expression_return_borrow_pending
                || mentions_owner);
        if (invalid) {
            self.report_return_borrow_escape(expr_id);
        }
        self.full_expression_return_borrow_pending = false;
    }

    public fn report_return_borrow_escape(self, expr_id: i32) {
            let saved_path = diag_current_file().clone();
            let saved_source = diag_current_source();
            var source_path: str = "";
            if (self.has_hir_codegen_builder) {
                source_path = hir_codegen_builder_handle_function_source_path(self.hir_codegen_builder,
                                                                                self.current_hir_function_id);
            }
            let switched = source_path.len > 0 && source_path != saved_path;
            if (switched) { diag_set_source_context(source_path, sema_source_read(source_path)); }
            diag_emit_at(diag_sev_ERROR(), diag_code_v_borrow_escape(), hir_unit_expr_loc_ptr(self.h, expr_id),
                "returned view borrows an owning temporary or local destroyed at function exit");
            if (switched) { diag_set_source_context(saved_path, saved_source); }
            self.hir_codegen_error_count = self.hir_codegen_error_count + 1;
    }

    // One bit per current MIR place, released before this function is emitted.
    // Named view assignments need flow state: a stale initializer flag would
    // reject a view overwritten by a literal, or miss a later borrowed value.
    public fn return_borrow_state(self, source: rawptr) -> rawptr {
        let bytes = ((self.unit.place_count + 1) as u64) * 4;
        let state = mir_profile_malloc(bytes);
        if (state == null) { self.report_error("cannot allocate return-borrow flow state"); return null; }
        if (source == null) { memset(state, 0, bytes); }
        else { memcpy(state, source, bytes); }
        return state;
    }

    public fn return_borrow_merge(self, destination: rawptr, source: rawptr) -> bool {
        if (destination == null || source == null) { return false; }
        var changed = false;
        var i: i32 = 1;
        while (i <= self.unit.place_count) {
            let at = ptr_offset(destination, (i as i64) * 4);
            if (ast_read_i32(at) == 0 && ast_read_i32(ptr_offset(source, (i as i64) * 4)) != 0) {
                ast_write_i32(at, 1);
                changed = true;
            }
            i += 1;
        }
        return changed;
    }

    public fn return_borrow_set(self, state: rawptr, local: i32, borrowed: bool) {
        let place = mir_i32_map_get(self.place_map, local);
        if (state != null && place > 0 && place <= self.unit.place_count) {
            ast_write_i32(ptr_offset(state, (place as i64) * 4), borrowed ? 1 : 0);
        }
    }

    public fn return_borrow_expr(self, expr: i32, state: rawptr, control: rawptr) -> bool {
        if (state == null || expr <= 0 || expr == hir_id_invalid()) { return false; }
        let kind = self.h.expr_kind(expr);
        let type_kind = hir_type_table_kind(self.h.types, self.h.expr_type(expr));
        let carries = self.full_expression_result_can_borrow(self.h.expr_type(expr))
            || type_kind == ty_CLASS() || type_kind == ty_ARRAY() || type_kind == ty_PTR() || type_kind == ty_RAWPTR();
        if (kind == ex_IDENT() && self.h.expr_target_kind(expr) == hir_target_local()) {
            let local = self.h.expr_target_id(expr);
            let local_kind = hir_type_table_kind(self.h.types, self.h.local_type(local));
            if ((local_kind == ty_CLASS() || local_kind == ty_ARRAY())
                && (self.h.local_flags(local) & hir_local_flag_auto_drop()) != 0) { return true; }
            let place = mir_i32_map_get(self.place_map, local);
            return carries && place > 0 && place <= self.unit.place_count
                && ast_read_i32(ptr_offset(state, (place as i64) * 4)) != 0;
        }
        if (kind == ex_ASSIGN()) {
            let borrowed = self.return_borrow_expr(self.h.expr_rhs(expr), state, control);
            let lhs = self.h.expr_lhs(expr);
            if (self.h.expr_kind(lhs) == ex_IDENT() && self.h.expr_target_kind(lhs) == hir_target_local()) {
                self.return_borrow_set(state, self.h.expr_target_id(lhs), borrowed);
            }
            return carries && borrowed;
        }
        if (kind == ex_TERNARY() || kind == ex_IF_EXPR()) {
            self.return_borrow_expr(self.h.expr_lhs(expr), state, control);
            let a = self.return_borrow_state(state);
            let b = self.return_borrow_state(state);
            if (a == null || b == null) { free(a); free(b); return false; }
            var av = false;
            var bv = false;
            var ar = true;
            var br = true;
            if (kind == ex_TERNARY()) {
                av = self.return_borrow_expr(self.h.expr_rhs(expr), a, control);
                bv = self.return_borrow_expr(self.h.expr_aux(expr), b, control);
            } else {
                var result: i32 = 0;
                ar = self.return_borrow_chain(self.h.expr_stmt_rhs(expr), a, control, to_rawptr(&result));
                av = result != 0;
                if (self.h.expr_aux(expr) != hir_id_invalid()) {
                    bv = self.return_borrow_expr(self.h.expr_aux(expr), b, control);
                } else {
                    result = 0;
                    br = self.return_borrow_chain(self.h.expr_stmt_aux(expr), b, control, to_rawptr(&result));
                    bv = result != 0;
                }
            }
            if (ar) { memcpy(state, a, ((self.unit.place_count + 1) as u64) * 4); }
            else if (br) { memcpy(state, b, ((self.unit.place_count + 1) as u64) * 4); }
            if (ar && br) { self.return_borrow_merge(state, b); }
            free(a); free(b);
            return carries && ((ar && av) || (br && bv));
        }
        if (kind == ex_MATCH_EXPR()) {
            self.return_borrow_expr(self.h.expr_lhs(expr), state, control);
            let merged = self.return_borrow_state(null);
            if (merged == null) { return false; }
            var borrowed = false;
            var reaches = false;
            var arm = self.h.expr_stmt_rhs(expr);
            while (arm != hir_id_invalid()) {
                let branch = self.return_borrow_state(state);
                self.return_borrow_expr(self.h.stmt_cond(arm), branch, control);
                var result: i32 = 0;
                if (self.return_borrow_chain(self.h.stmt_child(arm), branch, control, to_rawptr(&result))) {
                    reaches = true;
                    borrowed = borrowed || result != 0;
                    self.return_borrow_merge(merged, branch);
                }
                free(branch);
                arm = self.h.stmt_next(arm);
            }
            if (reaches) { memcpy(state, merged, ((self.unit.place_count + 1) as u64) * 4); }
            free(merged);
            return carries && borrowed;
        }
        var borrowed = false;
        if (kind == ex_CALL() || kind == ex_MEMBER() || kind == ex_CAST()
            || kind == ex_DEREF() || kind == ex_ADDR_OF() || kind == ex_INDEX() || kind == ex_BIN()) {
            var lhs = self.h.expr_lhs(expr);
            if (kind == ex_CALL() && self.h.expr_kind(lhs) == ex_MEMBER()) { lhs = self.h.expr_lhs(lhs); }
            borrowed = self.return_borrow_expr(lhs, state, control);
        }
        if (kind == ex_BIN() && (self.h.expr_op(expr) == tk_AND() || self.h.expr_op(expr) == tk_OR())) {
            let branch = self.return_borrow_state(state);
            self.return_borrow_expr(self.h.expr_rhs(expr), branch, control);
            self.return_borrow_merge(state, branch);
            free(branch);
            return false;
        }
        if (kind == ex_BIN() || kind == ex_INDEX()) {
            let rhs = self.return_borrow_expr(self.h.expr_rhs(expr), state, control);
            if (kind == ex_BIN() && self.h.expr_op(expr) == tk_PIPEARROW()) { return carries && rhs; }
            borrowed = borrowed || rhs;
            if (kind == ex_BIN() && self.h.expr_op(expr) == tk_PLUS()
                && hir_type_table_kind(self.h.types, self.h.expr_type(self.h.expr_lhs(expr))) == ty_STRING()
                && hir_type_table_kind(self.h.types, self.h.expr_type(self.h.expr_rhs(expr))) == ty_STRING()) { return false; }
        }
        if (kind == ex_CALL()) {
            borrowed = self.return_borrow_expr(self.h.expr_aux(expr), state, control) || borrowed;
        }
        if (kind == ex_CALL() || kind == ex_STRUCT_INIT() || kind == ex_TUPLE_LIT()
            || kind == ex_ARRAY_LIT() || kind == ex_FSTRING()) {
            var arg = self.h.expr_first_arg(expr);
            while (arg != hir_id_invalid()) {
                borrowed = self.return_borrow_expr(arg, state, control) || borrowed;
                arg = self.h.expr_next_arg(arg);
            }
        }
        if (kind == ex_CALL() && self.full_expression_call_returns_independent_storage(expr)) { return false; }
        if (kind == ex_FSTRING()) { return false; }
        if (kind == ex_ADDR_OF()) {
            let lhs = self.h.expr_lhs(expr);
            if (self.h.expr_kind(lhs) == ex_IDENT() && self.h.expr_target_kind(lhs) == hir_target_local()) {
                let local = self.h.expr_target_id(lhs);
                // The reference points at this frame's slot even for a Copy
                // scalar. Taking the address of a reference parameter's value
                // is different from simply returning the parameter itself.
                return true;
            }
        }
        if ((type_kind == ty_CLASS() || type_kind == ty_ARRAY())
            && hir_unit_expr_value_category(self.h, expr) == hir_value_cat_value()
            && hir_unit_expr_drop_function(self.h, expr) != hir_id_invalid()) { return true; }
        return carries && borrowed;
    }

    public fn return_borrow_chain(self, first: i32, state: rawptr, control: rawptr, result: rawptr) -> bool {
        if (state == null) { return false; }
        var stmt = first;
        while (stmt != hir_id_invalid()) {
            let kind = self.h.stmt_kind(stmt);
            ast_write_i32(result, 0);
            if (kind == hir_stmt_return()) {
                let expr = self.h.stmt_expr(stmt);
                if (self.return_borrow_expr(expr, state, control)) { self.report_return_borrow_escape(expr); }
                return false;
            } else if (kind == hir_stmt_let() || kind == hir_stmt_var()) {
                self.return_borrow_set(state, self.h.stmt_local(stmt),
                    self.return_borrow_expr(self.h.stmt_expr(stmt), state, control));
            } else if (kind == hir_stmt_expr()) {
                ast_write_i32(result, self.return_borrow_expr(self.h.stmt_expr(stmt), state, control) ? 1 : 0);
            } else if (kind == hir_stmt_block()) {
                if (!self.return_borrow_chain(self.h.stmt_child(stmt), state, control, result)) { return false; }
            } else if (kind == hir_stmt_if()) {
                self.return_borrow_expr(self.h.stmt_cond(stmt), state, control);
                let a = self.return_borrow_state(state);
                let b = self.return_borrow_state(state);
                if (a == null || b == null) { free(a); free(b); return false; }
                let ar = self.return_borrow_chain(self.h.stmt_child(stmt), a, control, result);
                let br = self.return_borrow_chain(self.h.stmt_else(stmt), b, control, result);
                if (ar) { memcpy(state, a, ((self.unit.place_count + 1) as u64) * 4); }
                else if (br) { memcpy(state, b, ((self.unit.place_count + 1) as u64) * 4); }
                if (ar && br) { self.return_borrow_merge(state, b); }
                free(a); free(b);
                if (!ar && !br) { return false; }
            } else if (kind == hir_stmt_while() || kind == hir_stmt_for() || kind == hir_stmt_foreach()) {
                if (kind == hir_stmt_for()) {
                    if (!self.return_borrow_chain(self.h.stmt_child(stmt), state, control, result)) { return false; }
                }
                let entry = self.return_borrow_state(state);
                let breaks = self.return_borrow_state(null);
                let continues = self.return_borrow_state(null);
                let frame = mir_profile_malloc(32);
                if (frame == null || entry == null || breaks == null || continues == null) {
                    if (frame == null) { self.report_error("cannot allocate return-borrow loop state"); }
                    free(entry); free(breaks); free(continues); free(frame); return false;
                }
                ast_write_rawptr(frame, breaks);
                ast_write_rawptr(ptr_offset(frame, 8), continues);
                ast_write_rawptr(ptr_offset(frame, 16), control);
                ast_write_i32(ptr_offset(frame, 24), stmt);
                var changed = true;
                while (changed) {
                    let iteration = self.return_borrow_state(entry);
                    self.return_borrow_expr(self.h.stmt_cond(stmt), iteration, frame);
                    var body = self.h.stmt_child(stmt);
                    if (kind == hir_stmt_for()) { body = self.h.stmt_aux(stmt); }
                    let reaches = self.return_borrow_chain(body, iteration, frame, result);
                    if (ast_read_i32(continues) != 0) { self.return_borrow_merge(iteration, continues); }
                    if (reaches || ast_read_i32(continues) != 0) {
                        if (kind == hir_stmt_for()) { self.return_borrow_chain(self.h.stmt_else(stmt), iteration, frame, result); }
                        changed = self.return_borrow_merge(entry, iteration);
                    } else { changed = false; }
                    free(iteration);
                }
                memcpy(state, entry, ((self.unit.place_count + 1) as u64) * 4);
                let cond = self.h.stmt_cond(stmt);
                let always = cond != hir_id_invalid() && self.h.expr_kind(cond) == ex_BOOL_LIT()
                    && self.h.expr_int_value(cond) != 0;
                if (always) { memset(state, 0, ((self.unit.place_count + 1) as u64) * 4); }
                self.return_borrow_merge(state, breaks);
                let exits = !always || ast_read_i32(breaks) != 0;
                free(entry); free(breaks); free(continues); free(frame);
                if (!exits) { return false; }
            } else if (kind == hir_stmt_break() || kind == hir_stmt_continue()) {
                var frame = control;
                let label = self.h.stmt_name(stmt);
                while (frame != null && label.len > 0
                    && self.h.stmt_name(ast_read_i32(ptr_offset(frame, 24))) != label) {
                    frame = ast_read_rawptr(ptr_offset(frame, 16));
                }
                if (frame != null) {
                    var destination = ast_read_rawptr(frame);
                    if (kind == hir_stmt_continue()) { destination = ast_read_rawptr(ptr_offset(frame, 8)); }
                    ast_write_i32(destination, 1);
                    self.return_borrow_merge(destination, state);
                }
                return false;
            } else if (kind == hir_stmt_match()) {
                self.return_borrow_expr(self.h.stmt_cond(stmt), state, control);
                var arm = self.h.stmt_child(stmt);
                let merged = self.return_borrow_state(state);
                if (merged == null) { return false; }
                while (arm != hir_id_invalid()) {
                    let branch = self.return_borrow_state(state);
                    if (self.return_borrow_chain(self.h.stmt_child(arm), branch, control, result)) {
                        self.return_borrow_merge(merged, branch);
                    }
                    free(branch);
                    arm = self.h.stmt_next(arm);
                }
                memcpy(state, merged, ((self.unit.place_count + 1) as u64) * 4);
                free(merged);
            }
            stmt = self.h.stmt_next(stmt);
        }
        return true;
    }

    public fn check_named_return_borrows(self, body: i32) -> bool {
        if (!self.full_expression_result_can_borrow(self.h.function_return_type(self.current_hir_function_id))) { return true; }
        let before = self.hir_codegen_error_count;
        let state = self.return_borrow_state(null);
        var result: i32 = 0;
        let reaches = self.return_borrow_chain(body, state, null, to_rawptr(&result));
        if (reaches && result != 0) {
            let tail = self.implicit_return_stmt_for_body(body);
            if (tail != hir_id_invalid()) { self.report_return_borrow_escape(self.h.stmt_expr(tail)); }
        }
        free(state);
        return self.hir_codegen_error_count == before;
    }

    public fn finish_full_expression(self, mark: rawptr, stmt_id: i32) {
        while (self.full_expression_temps != null && self.full_expression_temps != mark) {
            let node = self.full_expression_temps;
            self.emit_full_expression_temp_drop(node, stmt_id);
            self.full_expression_temps = ast_read_rawptr(ptr_offset(node, 8));
            free(node);
        }
    }

    public fn lower_full_expression_condition(self, expr_id: i32, stmt_id: i32) -> i32 {
        let mark = self.full_expression_temps;
        let value_id = self.lower_expr(expr_id);
        if (self.full_expression_temps == mark) { return value_id; }
        let result = self.add_temp_place(self.unit.value_type(value_id), expr_id, "expr.condition");
        self.emit_assign(result, value_id, stmt_id, expr_id);
        self.finish_full_expression(mark, stmt_id);
        return self.add_read_value(result, expr_id);
    }
}
