module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn add_temp_place(self, type_id: i32, source_expr_id: i32, label: string) -> i32 {
        return self.add_temp_place_with_flags(type_id, source_expr_id, label, 0);
    }

    public fn add_temp_place_with_flags(self,
                                        type_id: i32,
                                        source_expr_id: i32,
                                        label: string,
                                        extra_flags: i32) -> i32 {
        let temp_name = label + "$" + policy_i64_to_string(source_expr_id as i64);
        let local_id = self.unit.add_local(
                                          self.current_function_id,
                                          hir_id_invalid(),
                                          temp_name,
                                          type_id,
                                          4 | extra_flags);
        let place_id = self.unit.add_place(
                                          self.current_function_id,
                                          mir_place_local(),
                                          type_id,
                                          local_id,
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          source_expr_id,
                                          temp_name);
        self.unit.set_local_place( local_id, place_id);
        return place_id;
    }

    public fn add_owned_temp_place(self,
                                   type_id: i32,
                                   source_expr_id: i32,
                                   label: string,
                                   drop_hir_function: i32) -> i32 {
        let temp_name = label + "$" + policy_i64_to_string(source_expr_id as i64);
        let hir_local = self.h.add_local(self.current_hir_function_id,
                                           temp_name,
                                           type_id,
                                           hir_local_flag_auto_drop());
        if (drop_hir_function != hir_id_invalid()) {
            self.h.set_local_drop_function(hir_local, drop_hir_function);
        }
        let local_id = self.unit.add_local(
                                          self.current_function_id,
                                          hir_local,
                                          temp_name,
                                          type_id,
                                          4 | mir_local_flag_auto_drop());
        let place_id = self.unit.add_place(
                                          self.current_function_id,
                                          mir_place_local(),
                                          type_id,
                                          local_id,
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          source_expr_id,
                                          temp_name);
        self.unit.set_local_place( local_id, place_id);
        mir_i32_map_put(self.local_map, hir_local, local_id);
        mir_i32_map_put(self.place_map, hir_local, place_id);
        self.drop_stack_push(hir_local);
        return place_id;
    }
}
