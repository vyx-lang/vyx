module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

public class MirStaticInitializer {
    public ok: bool
    public kind: i32
    public target_kind: i32
    public target_id: i32
    public int_value: i64
    public text: string

    public static fn invalid() -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: false,
            kind: mir_static_init_none(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: ""
        };
    }

    /// Named `of_int` (not `int_value`) because the host sema resolves a
    /// `Class.name(...)` static call against the same-named field first.
    public static fn of_int(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_int(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn bool_value(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_bool(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn char_value(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_char(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn str_value(value: string) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_str(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: value
        };
    }

    public static fn null_value() -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_null(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: ""
        };
    }

    public static fn item_ref(item_id: i32) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_item_ref(),
            target_kind: mir_target_hir_item(),
            target_id: item_id,
            int_value: 0,
            text: ""
        };
    }
}

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn type_id_is_float(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        let kind = hir_type_table_kind(self.h.types, type_id);
        return kind == ty_F32() || kind == ty_F64();
    }

    public fn eval_static_binary_int(self, op: i32, lhs: i64, rhs: i64) -> MirStaticInitializer {
        if (op == tk_PLUS()) { return MirStaticInitializer.of_int(lhs + rhs); }
        if (op == tk_MINUS()) { return MirStaticInitializer.of_int(lhs - rhs); }
        if (op == tk_STAR()) { return MirStaticInitializer.of_int(lhs * rhs); }
        if (op == tk_SLASH()) {
            if (rhs == 0) { return MirStaticInitializer.invalid(); }
            return MirStaticInitializer.of_int(lhs / rhs);
        }
        if (op == tk_PERCENT()) {
            if (rhs == 0) { return MirStaticInitializer.invalid(); }
            return MirStaticInitializer.of_int(lhs % rhs);
        }
        if (op == tk_AMP()) { return MirStaticInitializer.of_int(lhs & rhs); }
        if (op == tk_PIPE()) { return MirStaticInitializer.of_int(lhs | rhs); }
        if (op == tk_CARET()) { return MirStaticInitializer.of_int(lhs ^ rhs); }
        if (op == tk_LSHIFT()) { return MirStaticInitializer.of_int(lhs << (rhs as i32)); }
        if (op == tk_RSHIFT()) { return MirStaticInitializer.of_int(lhs >> (rhs as i32)); }
        if (op == tk_EQEQ()) {
            if (lhs == rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_NEQ()) {
            if (lhs != rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_LT()) {
            if (lhs < rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_LE()) {
            if (lhs <= rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_GT()) {
            if (lhs > rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_GE()) {
            if (lhs >= rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_AND()) {
            if (lhs != 0 && rhs != 0) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_OR()) {
            if (lhs != 0 || rhs != 0) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        return MirStaticInitializer.invalid();
    }

    public fn eval_static_item_initializer_depth(self, item_id: i32, depth: i32) -> MirStaticInitializer {
        if (depth > 64) { return MirStaticInitializer.invalid(); }
        if (item_id == hir_id_invalid() || item_id < 1 || item_id > self.h.item_count) {
            return MirStaticInitializer.invalid();
        }
        let item_kind = self.h.item_kind(item_id);
        if (item_kind != hir_item_const()) {
            return MirStaticInitializer.invalid();
        }
        let init_stmt = self.h.item_init(item_id);
        if (init_stmt == hir_id_invalid()) { return MirStaticInitializer.invalid(); }
        return self.eval_static_initializer_depth(self.h.stmt_expr(init_stmt), depth + 1);
    }

    public fn eval_static_initializer_depth(self, expr_id: i32, depth: i32) -> MirStaticInitializer {
        if (depth > 64) { return MirStaticInitializer.invalid(); }
        if (expr_id == hir_id_invalid()) { return MirStaticInitializer.invalid(); }
        let kind = self.h.expr_kind(expr_id);
        if (kind == ex_INT_LIT()) { return MirStaticInitializer.of_int(self.h.expr_int_value(expr_id)); }
        if (kind == ex_BOOL_LIT()) { return MirStaticInitializer.bool_value(self.h.expr_int_value(expr_id)); }
        if (kind == ex_CHAR_LIT()) { return MirStaticInitializer.char_value(self.h.expr_int_value(expr_id)); }
        if (kind == ex_STR_LIT()) { return MirStaticInitializer.str_value(self.h.expr_value_text(expr_id)); }
        if (kind == ex_NULL_LIT()) { return MirStaticInitializer.null_value(); }
        if (kind == ex_IDENT()
            && self.h.expr_target_kind(expr_id) == hir_target_item()) {
            let item_id = self.h.expr_target_id(expr_id);
            let folded = self.eval_static_item_initializer_depth(item_id, depth + 1);
            if (folded.ok && folded.kind != mir_static_init_none()) { return folded; }
            return MirStaticInitializer.item_ref(item_id);
        }
        if (kind == ex_CAST()) {
            return self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
        }
        if (kind == ex_UNARY()) {
            let inner = self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
            if (!inner.ok || inner.kind != mir_static_init_int()) { return MirStaticInitializer.invalid(); }
            let op = self.h.expr_op(expr_id);
            if (op == tk_MINUS()) { return MirStaticInitializer.of_int(0 - inner.int_value); }
            if (op == tk_PLUS()) { return inner; }
            return MirStaticInitializer.invalid();
        }
        if (kind == ex_BIN()) {
            let lhs = self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
            let rhs = self.eval_static_initializer_depth(self.h.expr_rhs(expr_id), depth + 1);
            if (!lhs.ok || !rhs.ok) { return MirStaticInitializer.invalid(); }
            if (lhs.kind != mir_static_init_int() || rhs.kind != mir_static_init_int()) {
                return MirStaticInitializer.invalid();
            }
            return self.eval_static_binary_int(self.h.expr_op(expr_id), lhs.int_value, rhs.int_value);
        }
        return MirStaticInitializer.invalid();
    }

    public fn eval_static_initializer(self, expr_id: i32) -> MirStaticInitializer {
        return self.eval_static_initializer_depth(expr_id, 0);
    }

    public fn build_static_items(self) {
        var item_id: i32 = self.static_item_scan_next;
        if (item_id < 1) { item_id = 1; }
        while (item_id <= self.h.item_count) {
            let item_kind = self.h.item_kind(item_id);
            if (item_kind == hir_item_const() || item_kind == hir_item_global()) {
                var static_exists = false;
                if (item_id <= self.unit.static_cap) {
                    static_exists = self.unit.static_exists(item_id);
                }
                if (!static_exists) {
                    let item_flags = self.h.item_flags(item_id);
                    var flags: i32 = 0;
                    if ((item_flags & hir_item_flag_external_storage()) != 0) {
                        flags = flags | mir_static_flag_external();
                    }
                    if ((item_flags & hir_item_flag_exported_storage()) != 0) {
                        flags = flags | mir_static_flag_exported();
                    }
                    if ((item_flags & hir_item_flag_odr_storage()) != 0) {
                        flags = flags | mir_static_flag_odr();
                    }
                    let module_name = self.h.item_source_module(item_id);
                    var storage_name = self.h.item_name(item_id);
                    let owner_item = self.h.item_owner(item_id);
                    if (owner_item != hir_id_invalid()) {
                        // The closed owner includes canonical generic args.
                        // Two owners' VALUE members and two instantiations of
                        // one owner must never share linker storage identity.
                        storage_name = self.h.item_name(owner_item) + "." + storage_name;
                    }
                    var init = MirStaticInitializer.null_value();
                    if ((flags & mir_static_flag_external()) != 0) {
                        // No initializer on an interface is a declaration,
                        // never an implicit zero-initialized definition.
                        init = MirStaticInitializer.invalid();
                    }
                    let init_stmt = self.h.item_init(item_id);
                    if (init_stmt != hir_id_invalid()) {
                        init = self.eval_static_initializer(self.h.stmt_expr(init_stmt));
                        if (!init.ok) {
                            init = MirStaticInitializer.invalid();
                        }
                    }
                    self.unit.add_static_item(
                                             item_id,
                                             item_kind,
                                             storage_name,
                                             self.h.item_type(item_id),
                                             init.kind,
                                             init.target_kind,
                                             init.target_id,
                                             init.int_value,
                                             init.text,
                                             module_name,
                                             flags);
                }
            }
            item_id = item_id + 1;
        }
        self.static_item_scan_next = self.h.item_count + 1;
    }
}
