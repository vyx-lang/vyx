module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn type_text_equivalent_at_depth(self, lhs: string, rhs: string, depth: i32) -> bool {
        if (lhs.len == 0 || rhs.len == 0 || depth > 64) { return false; }
        if (lhs == rhs) { return true; }
        let left_has_args = policy_generic_call_has_args(lhs.clone()) != 0;
        let right_has_args = policy_generic_call_has_args(rhs.clone()) != 0;
        if (left_has_args != right_has_args) { return false; }
        if (!left_has_args) {
            return mir_builder_last_path_segment(lhs) == mir_builder_last_path_segment(rhs);
        }
        let left_base = policy_generic_call_base(lhs.clone());
        let right_base = policy_generic_call_base(rhs.clone());
        if (mir_builder_last_path_segment(left_base) != mir_builder_last_path_segment(right_base)) {
            return false;
        }
        let left_args = policy_generic_call_args(lhs.clone());
        let right_args = policy_generic_call_args(rhs.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let left_arg = policy_generic_arg_at(left_args, idx);
            let right_arg = policy_generic_arg_at(right_args, idx);
            if (left_arg.len == 0 || right_arg.len == 0) {
                return left_arg.len == 0 && right_arg.len == 0;
            }
            if (!self.type_text_equivalent_at_depth(left_arg, right_arg, depth + 1)) { return false; }
            idx = idx + 1;
        }
        return false;
    }

    public fn type_ids_equivalent(self, lhs: i32, rhs: i32) -> bool {
        if (lhs == rhs) { return true; }
        if (lhs == hir_id_invalid() || rhs == hir_id_invalid()) { return false; }
        let cached = mir_int_pair_id_map_get(self.type_equivalence_index,lhs, rhs);
        if (cached == 1) { return true; }
        let lhs_text = self.type_text(lhs);
        let rhs_text = self.type_text(rhs);
        if (lhs_text.len == 0 || rhs_text.len == 0) { return false; }
        let out = self.type_text_equivalent_at_depth(lhs_text, rhs_text, 0);
        if (out) {
            self.type_equivalence_index = mir_int_pair_id_map_put(self.type_equivalence_index,lhs, rhs, 1);
            self.type_equivalence_index = mir_int_pair_id_map_put(self.type_equivalence_index,rhs, lhs, 1);
        }
        return out;
    }
}
