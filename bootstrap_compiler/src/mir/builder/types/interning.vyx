module bootstrap.mir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.diag;
use bootstrap.hir_builder;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_builder.MirUnitBuilder {
    public fn type_id_by_text(self, text: string) -> i32 {
        if (text.len == 0) { return mir_id_invalid(); }
        self.index_type_texts();
        return mir_name_id_map_get(self.type_text_id_index,text);
    }

    public fn index_type_texts(self) {
        var type_id: i32 = self.indexed_type_text_next;
        if (type_id < 1) { type_id = 1; }
        while (type_id <= self.h.types.count) {
            let text = hir_type_table_text(self.h.types, type_id);
            if (text.len > 0) {
                self.type_text_id_index = mir_name_id_map_put(self.type_text_id_index,text, type_id);
            }
            type_id = type_id + (1 as i32);
        }
        var next_type_text: i32 = self.h.types.count;
        next_type_text = next_type_text + 1;
        self.indexed_type_text_next = next_type_text;
    }

    public fn intern_type_id_by_text(self, text: string) -> i32 {
        if (text.len == 0) { return mir_id_invalid(); }
        let existing = self.type_id_by_text(text);
        if (existing != mir_id_invalid()) { return existing; }
        var out: i32 = hir_id_invalid();
        if (text == "i32") { out = self.h.types.intern_type_ref(tref_alloc(ty_I32(), "")); }
        else if (text == "i64") { out = self.h.types.intern_type_ref(tref_alloc(ty_I64(), "")); }
        else if (text == "bool") { out = self.h.types.intern_type_ref(tref_alloc(ty_BOOL(), "")); }
        else if (text == "char") { out = self.h.types.intern_type_ref(tref_alloc(ty_CHAR(), "")); }
        else if (text == "str" || text == "string" || text == "__String") { out = self.h.types.intern_type_ref(tref_alloc(ty_STRING(), "")); }
        else if (text == "rawptr") { out = self.h.types.intern_type_ref(tref_alloc(ty_RAWPTR(), "")); }
        else if (text == "void") { out = self.h.types.intern_type_ref(tref_alloc(ty_VOID(), "")); }
        else if (text == "f32") { out = self.h.types.intern_type_ref(tref_alloc(ty_F32(), "")); }
        else if (text == "f64") { out = self.h.types.intern_type_ref(tref_alloc(ty_F64(), "")); }
        else if (text == "i8") { out = self.h.types.intern_type_ref(tref_alloc(ty_I8(), "")); }
        else if (text == "i16") { out = self.h.types.intern_type_ref(tref_alloc(ty_I16(), "")); }
        else if (text == "u8") { out = self.h.types.intern_type_ref(tref_alloc(ty_U8(), "")); }
        else if (text == "u16") { out = self.h.types.intern_type_ref(tref_alloc(ty_U16(), "")); }
        else if (text == "u32") { out = self.h.types.intern_type_ref(tref_alloc(ty_U32(), "")); }
        else if (text == "u64") { out = self.h.types.intern_type_ref(tref_alloc(ty_U64(), "")); }
        else if (text == "isize") { out = self.h.types.intern_type_ref(tref_alloc(ty_ISIZE(), "")); }
        else if (text == "usize") { out = self.h.types.intern_type_ref(tref_alloc(ty_USIZE(), "")); }
        else { out = self.h.types.intern_type_ref(tref_alloc(ty_CLASS(), text)); }
        if (out != hir_id_invalid()) {
            self.type_text_id_index = mir_name_id_map_put(self.type_text_id_index,text, out);
            if (out >= self.indexed_type_text_next) {
                var next_indexed_type_text: i32 = out;
                next_indexed_type_text = next_indexed_type_text + 1;
                self.indexed_type_text_next = next_indexed_type_text;
            }
        }
        return out;
    }

    public fn append_type_arg_text(self, base: string, next: string) -> string {
        if (next.len == 0) { return base; }
        if (base.len == 0) { return next; }
        return base + "," + next;
    }

    public fn specialize_type_text_for_owner(self,
                                             text: string,
                                             pattern_owner_text: string,
                                             concrete_owner_text: string) -> string {
        if (text.len == 0) { return ""; }
        if (text == "Self") { return concrete_owner_text; }
        let pattern_args = policy_generic_call_args(pattern_owner_text.clone());
        let concrete_args = policy_generic_call_args(concrete_owner_text.clone());
        var arg_index: i32 = 0;
        while (arg_index < 128) {
            let pattern_arg = policy_generic_arg_at(pattern_args, arg_index);
            if (pattern_arg.len == 0) {
                arg_index = 128;
            } else {
                let concrete_arg = policy_generic_arg_at(concrete_args, arg_index);
                if (text == pattern_arg && concrete_arg.len > 0) { return concrete_arg; }
                arg_index = arg_index + 1;
            }
        }
        if (policy_generic_call_has_args(text.clone()) != 0) {
            let base = policy_generic_call_base(text.clone());
            let raw_args = policy_generic_call_args(text.clone());
            var out_args = "";
            var i: i32 = 0;
            while (i < 128) {
                let raw_arg = policy_generic_arg_at(raw_args, i);
                if (raw_arg.len == 0) {
                    i = 128;
                } else {
                    out_args = self.append_type_arg_text(out_args,
                                                         self.specialize_type_text_for_owner(raw_arg,
                                                                                            pattern_owner_text,
                                                                                            concrete_owner_text));
                    i = i + 1;
                }
            }
            if (out_args.len > 0) { return base + "::<" + out_args + ">"; }
            return base;
        }
        return text;
    }

    public fn i64_type_id(self) -> i32 {
        let existing = self.type_id_by_text("i64");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_I64(), ""));
    }

    public fn i32_type_id(self) -> i32 {
        let existing = self.type_id_by_text("i32");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_I32(), ""));
    }

    public fn bool_type_id(self) -> i32 {
        let existing = self.type_id_by_text("bool");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_BOOL(), ""));
    }
}
