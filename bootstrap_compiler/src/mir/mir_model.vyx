    public fn ensure_statics(self, want_count: i32) {
        if (want_count <= self.static_cap) { return; }
        var new_cap = self.static_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.static_buf, self.static_count, self.static_cap, mir_static_record_size(), want_count);
        if (new_buf == self.static_buf) { return; }
