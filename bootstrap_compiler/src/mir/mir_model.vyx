        self.case_cap = new_cap;
    }

    public fn function_record(&self, id: i32) -> rawptr { return mir_record_at(self.function_buf, id, mir_function_record_size()); }
    public fn block_record(&self, id: i32) -> rawptr { return mir_record_at(self.block_buf, id, mir_block_record_size()); }
    public fn local_record(&self, id: i32) -> rawptr { return mir_record_at(self.local_buf, id, mir_local_record_size()); }
    public fn field_record(&self, id: i32) -> rawptr { return mir_record_at(self.field_buf, id, mir_field_record_size()); }
    public fn variant_record(&self, id: i32) -> rawptr { return mir_record_at(self.variant_buf, id, mir_variant_record_size()); }
    public fn static_record(&self, id: i32) -> rawptr { return mir_record_at(self.static_buf, id, mir_static_record_size()); }
    public fn place_record(&self, id: i32) -> rawptr { return mir_record_at(self.place_buf, id, mir_place_record_size()); }
    public fn value_record(&self, id: i32) -> rawptr { return mir_record_at(self.value_buf, id, mir_value_record_size()); }
    public fn instr_record(&self, id: i32) -> rawptr { return mir_record_at(self.instr_buf, id, mir_instr_record_size()); }
    public fn case_record(&self, id: i32) -> rawptr { return mir_record_at(self.case_buf, id, mir_case_record_size()); }

    public fn add_function(self, hir_function_id: i32, hir_item_id: i32, name: string, ret_type_id: i32) -> i32 {
        let id = self.ids.alloc_function();
        self.ensure_functions(id);
        let rec = self.function_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), hir_function_id);
        ast_write_i32(ptr_offset(rec, 8), hir_item_id);
        ast_write_i32(ptr_offset(rec, 12), ret_type_id);
        ast_write_i32(ptr_offset(rec, 16), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), 0);
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), 0);
        ast_write_i32(ptr_offset(rec, 96), 0);
        ast_write_i32(ptr_offset(rec, 100), 0);
        ast_write_i32(ptr_offset(rec, 104), 0);
        // Offset 108 is reserved for the streaming-lowering body status.
        // It is not part of HIR function flags or the source-level ABI.
        ast_write_i32(ptr_offset(rec, 108), 0);
        mir_write_string(rec, 112, 120, "");
        mir_write_string(rec, 32, 40, name);
        if (id > self.function_count) { self.function_count = id; }
        return id;
    }

    public fn set_function_item_kind(self, function_id: i32, item_kind: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 96), item_kind);
    }

    public fn set_function_owner_item_kind(self, function_id: i32, item_kind: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 100), item_kind);
    }

    public fn set_function_flags(self, function_id: i32, flags: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 104), flags);
    }

    // Offset 108 is streaming-only bookkeeping.  It deliberately stays out
    // of source/HIR flags: backends can release a transient body while the
    // shared function signature remains part of the unit declaration index.
    fn function_stream_state(&self, function_id: i32) -> i32 {
        let rec = self.function_record(function_id);
        if (rec == null) { return 0; }
        return ast_read_i32(ptr_offset(rec, 108));
    }

    fn set_function_stream_state_bit(self,
                                      function_id: i32,
                                      bit: i32,
                                      enabled: bool) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        var state = ast_read_i32(ptr_offset(rec, 108));
        if (enabled) { state = state | bit; }
        else { state = state & (~bit); }
        ast_write_i32(ptr_offset(rec, 108), state);
    }

    public fn set_function_streamed_body_discarded(self,
                                                   function_id: i32,
                                                   discarded: bool) {
        self.set_function_stream_state_bit(function_id, 1, discarded);
    }

    public fn set_function_streamed_needs_closure_adapter(self,
                                                          function_id: i32,
                                                          needed: bool) {
        self.set_function_stream_state_bit(function_id, 2, needed);
    }

    public fn set_function_streamed_needs_raw_callback_adapter(self,
                                                               function_id: i32,
                                                               needed: bool) {
        self.set_function_stream_state_bit(function_id, 4, needed);
    }

    public fn set_function_generic_env(self, function_id: i32, params: string, args: string, owner_type: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        mir_write_string(rec, 48, 56, params);
        mir_write_string(rec, 64, 72, args);
        mir_write_string(rec, 80, 88, owner_type);
    }

    public fn set_function_symbol_discriminator(self,
                                                function_id: i32,
                                                discriminator: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        mir_write_string(rec, 112, 120, discriminator);
    }

    public fn add_block(self, function_id: i32, source_stmt_id: i32) -> i32 {
        let id = self.ids.alloc_block();
        self.ensure_blocks(id);
        let rec = self.block_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 12), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 16), 0);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 44), 0);
        ast_write_i32(ptr_offset(rec, 48), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 52), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 56), 0);
        ast_write_i32(ptr_offset(rec, 60), 0);
        ast_write_i32(ptr_offset(rec, 64), 0);
        ast_write_i32(ptr_offset(rec, 68), 0);
        if (function_id != mir_id_invalid()) {
            let fn_rec = self.function_record(function_id);
            if (fn_rec != null) {
                let first = ast_read_i32(ptr_offset(fn_rec, 24));
                if (first == mir_id_invalid()) {
                    ast_write_i32(ptr_offset(fn_rec, 24), id);
                } else {
                    var cur = first;
                    while (cur != mir_id_invalid()) {
                        let cur_rec = self.block_record(cur);
                        if (cur_rec == null) { cur = mir_id_invalid(); }
                        else {
                            let next = ast_read_i32(ptr_offset(cur_rec, 48));
                            if (next == mir_id_invalid()) {
                                ast_write_i32(ptr_offset(cur_rec, 48), id);
                                cur = mir_id_invalid();
                            } else {
                                cur = next;
                            }
                        }
                    }
                }
                var block_count = ast_read_i32(ptr_offset(fn_rec, 28));
                block_count = block_count + 1;
                ast_write_i32(ptr_offset(fn_rec, 28), block_count);
            }
        }
        if (id > self.block_count) { self.block_count = id; }
        return id;
    }

    public fn add_local(self, function_id: i32, hir_local_id: i32, name: string, type_id: i32, flags: i32) -> i32 {
        let id = self.ids.alloc_local();
        self.ensure_locals(id);
        let rec = self.local_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), hir_local_id);
        ast_write_i32(ptr_offset(rec, 12), type_id);
        ast_write_i32(ptr_offset(rec, 16), flags);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 48), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 56), 0);
        ast_write_i32(ptr_offset(rec, 60), 0);
        ast_write_i32(ptr_offset(rec, 64), 0);
        ast_write_i32(ptr_offset(rec, 68), 0);
        mir_write_string(rec, 32, 40, name);
        if (function_id != mir_id_invalid()) {
            let fn_rec = self.function_record(function_id);
            if (fn_rec != null) {
                let first = ast_read_i32(ptr_offset(fn_rec, 16));
                if (first == mir_id_invalid()) {
                    ast_write_i32(ptr_offset(fn_rec, 16), id);
                } else {
                    var cur = first;
                    while (cur != mir_id_invalid()) {
                        let cur_rec = self.local_record(cur);
                        if (cur_rec == null) { cur = mir_id_invalid(); }
                        else {
                            let next = ast_read_i32(ptr_offset(cur_rec, 24));
                            if (next == mir_id_invalid()) {
                                ast_write_i32(ptr_offset(cur_rec, 24), id);
                                cur = mir_id_invalid();
                            } else {
                                cur = next;
                            }
                        }
                    }
                }
                var local_count = ast_read_i32(ptr_offset(fn_rec, 20));
                local_count = local_count + 1;
                ast_write_i32(ptr_offset(fn_rec, 20), local_count);
            }
        }
        if (id > self.local_count) { self.local_count = id; }
        return id;
    }

    public fn set_local_place(self, local_id: i32, place_id: i32) {
        let rec = self.local_record(local_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 20), place_id); }
    }

    // A streamed body can be built before semantic resolution has pinned a
    // monomorphised callee's concrete return type, so the local's type is
    // snapshotted from a still-unresolved HIR slot.  Resolution patches the
    // HIR afterwards; when the body is rebuilt, the reused local must follow
    // the HIR, not the stale snapshot.
    public fn set_local_type(self, local_id: i32, type_id: i32) {
        let rec = self.local_record(local_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 12), type_id); }
    }

    // Local flags begin as the HIR ownership/lifetime flags copied by the MIR
    // builder.  MIR analyses may add lowering-neutral storage facts afterwards
    // without changing the packed local record layout or the source ABI.
    public fn set_local_flags(self, local_id: i32, flags: i32) {
        let rec = self.local_record(local_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 16), flags); }
    }

    public fn add_local_flags(self, local_id: i32, flags: i32) {
        let rec = self.local_record(local_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 16), ast_read_i32(ptr_offset(rec, 16)) | flags);
    }

    public fn remove_local_flags(self, local_id: i32, flags: i32) {
        let rec = self.local_record(local_id);
        if (rec == null) { return; }
        let current = ast_read_i32(ptr_offset(rec, 16));
        ast_write_i32(ptr_offset(rec, 16), current & (~flags));
    }

    public fn set_local_capture_source(self, local_id: i32, source_local_id: i32) {
        let rec = self.local_record(local_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 28), source_local_id); }
    }

    public fn set_local_capture_init_value(self, local_id: i32, value_id: i32) {
        let rec = self.local_record(local_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 48), value_id); }
    }

    public fn add_field_layout(self,
                               field_id: i32,
                               owner_item_id: i32,
                               owner_type_id: i32,
                               type_id: i32,
                               field_index: i32,
                               name: string) -> i32 {
        if (field_id == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_fields(field_id);
        let rec = self.field_record(field_id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, field_id);
        ast_write_i32(ptr_offset(rec, 4), owner_item_id);
        ast_write_i32(ptr_offset(rec, 8), owner_type_id);
        ast_write_i32(ptr_offset(rec, 12), type_id);
        ast_write_i32(ptr_offset(rec, 16), field_index);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        mir_write_string(rec, 24, 32, name);
        if (field_id > self.field_count) { self.field_count = field_id; }
        return field_id;
    }

    public fn add_variant_layout(self,
                                 variant_id: i32,
                                 owner_item_id: i32,
                                 owner_type_id: i32,
                                 tag: i32,
                                 name: string,
                                 payload_types: string,
                                 payload_count: i32) -> i32 {
        if (variant_id == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_variants(variant_id);
        let rec = self.variant_record(variant_id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, variant_id);
        ast_write_i32(ptr_offset(rec, 4), owner_item_id);
        ast_write_i32(ptr_offset(rec, 8), owner_type_id);
        ast_write_i32(ptr_offset(rec, 12), tag);
        ast_write_i32(ptr_offset(rec, 16), payload_count);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        mir_write_string(rec, 24, 32, name);
        mir_write_string(rec, 40, 48, payload_types);
        if (variant_id > self.variant_count) { self.variant_count = variant_id; }
        return variant_id;
    }

    public fn add_static_item(self,
                              item_id: i32,
                              item_kind: i32,
                              name: string,
                              type_id: i32,
                              init_kind: i32,
                              init_target_kind: i32,
                              init_target_id: i32,
                              init_int: i64,
                              init_text: string,
                              module_name: string) -> i32 {
        if (item_id == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_statics(item_id);
        let rec = self.static_record(item_id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, item_id);
        ast_write_i32(ptr_offset(rec, 4), item_kind);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), init_kind);
        ast_write_i32(ptr_offset(rec, 16), init_target_kind);
        ast_write_i32(ptr_offset(rec, 20), init_target_id);
        ast_write_i64(ptr_offset(rec, 24), init_int);
        mir_write_string(rec, 32, 40, name);
        mir_write_string(rec, 48, 56, init_text);
        mir_write_string(rec, 64, 72, module_name);
        if (item_id > self.static_count) { self.static_count = item_id; }
        return item_id;
    }

    public fn add_place(self,
                        function_id: i32,
                        kind: i32,
                        type_id: i32,
                        local_id: i32,
                        base_place_id: i32,
                        field_id: i32,
                        index_value_id: i32,
                        source_expr_id: i32,
                        name: string) -> i32 {
        let id = self.ids.alloc_place();
        self.ensure_places(id);
        let rec = self.place_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), local_id);
        ast_write_i32(ptr_offset(rec, 20), base_place_id);
        ast_write_i32(ptr_offset(rec, 24), field_id);
        ast_write_i32(ptr_offset(rec, 28), index_value_id);
        ast_write_i32(ptr_offset(rec, 32), source_expr_id);
        ast_write_i32(ptr_offset(rec, 36), 0);
        mir_write_string(rec, 40, 48, name);
        if (id > self.place_count) { self.place_count = id; }
        return id;
    }

    public fn add_value(self,
                        function_id: i32,
                        kind: i32,
                        type_id: i32,
                        place_id: i32,
                        target_kind: i32,
                        target_id: i32,
                        source_expr_id: i32,
                        flags: i32,
                        op: i32,
                        int_value: i64,
                        name: string,
                        text: string) -> i32 {
        let id = self.ids.alloc_value();
        self.ensure_values(id);
        let rec = self.value_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), place_id);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), target_kind);
        ast_write_i32(ptr_offset(rec, 44), target_id);
        ast_write_i32(ptr_offset(rec, 48), source_expr_id);
        ast_write_i32(ptr_offset(rec, 52), flags);
        ast_write_i32(ptr_offset(rec, 56), op);
        ast_write_i32(ptr_offset(rec, 60), mir_id_invalid());
        ast_write_i64(ptr_offset(rec, 64), int_value);
        mir_write_string(rec, 72, 80, name);
        mir_write_string(rec, 88, 96, text);
        ast_write_i32(ptr_offset(rec, 104), 0);
        ast_write_i32(ptr_offset(rec, 108), 0);
        ast_write_i32(ptr_offset(rec, 112), 0);
        ast_write_i32(ptr_offset(rec, 116), 0);
        if (id > self.value_count) { self.value_count = id; }
        return id;
    }

    public fn set_value_lhs(self, value_id: i32, lhs_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 20), lhs_id); }
    }

    public fn set_value_rhs(self, value_id: i32, rhs_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 24), rhs_id); }
    }

    public fn set_value_aux(self, value_id: i32, aux_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 28), aux_id); }
    }

    public fn set_value_first_arg(self, value_id: i32, arg_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 32), arg_id); }
    }

    public fn set_value_next_arg(self, value_id: i32, next_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 36), next_id); }
    }

    public fn set_value_flags(self, value_id: i32, flags: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 52), flags); }
    }

    // Copy propagation may retarget only a direct local read. Keeping the
    // ValueId stable preserves its source location and intrusive arg linkage.
    public fn set_value_place(self, value_id: i32, place_id: i32) -> bool {
        if (value_id < 1 || value_id > self.value_count
            || place_id < 1 || place_id > self.place_count) { return false; }
        let value_rec = self.value_record(value_id);
        let place_rec = self.place_record(place_id);
        if (value_rec == null || place_rec == null
            || ast_read_i32(value_rec) != value_id
            || ast_read_i32(place_rec) != place_id
            || self.value_kind(value_id) != mir_value_read_place()
            || self.value_function(value_id) != self.place_function(place_id)
            || self.value_type(value_id) != self.place_type(place_id)
            || self.place_kind(place_id) != mir_place_local()) {
            return false;
        }
        let local_id = self.place_local(place_id);
        if (local_id < 1 || local_id > self.local_count
            || self.local_record(local_id) == null
            || ast_read_i32(self.local_record(local_id)) != local_id
            || self.local_function(local_id) != self.value_function(value_id)
            || self.local_type(local_id) != self.value_type(value_id)
            || self.local_place(local_id) != place_id) {
            return false;
        }
        ast_write_i32(ptr_offset(value_rec, 16), place_id);
        return true;
    }

    public fn replace_value_with_integer_constant(self,
                                                   value_id: i32,
                                                   constant_kind: i32,
                                                   int_value: i64) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 12), constant_kind);
        ast_write_i32(ptr_offset(rec, 16), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), mir_target_none());
        ast_write_i32(ptr_offset(rec, 44), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 52), 0);
        ast_write_i32(ptr_offset(rec, 56), 0);
        ast_write_i32(ptr_offset(rec, 60), mir_id_invalid());
        ast_write_i64(ptr_offset(rec, 64), int_value);
        mir_write_string(rec, 72, 80, "");
        mir_write_string(rec, 88, 96, "");
    }

    public fn set_value_target(self, value_id: i32, target_kind: i32, target_id: i32) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 40), target_kind);
        ast_write_i32(ptr_offset(rec, 44), target_id);
    }

    public fn set_value_aggregate_field(self, value_id: i32, field_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 60), field_id); }
    }

    public fn set_value_loc(self, value_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 104), line);
        ast_write_i32(ptr_offset(rec, 108), col);
        ast_write_i32(ptr_offset(rec, 112), end_line);
        ast_write_i32(ptr_offset(rec, 116), end_col);
    }

    public fn value_loc_ptr(&self, value_id: i32) -> rawptr {
        let rec = self.value_record(value_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 104);
    }

    public fn block_loc_ptr(&self, block_id: i32) -> rawptr {
        let rec = self.block_record(block_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 56);
    }

    public fn local_loc_ptr(&self, local_id: i32) -> rawptr {
        let rec = self.local_record(local_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 56);
    }

    public fn instr_loc_ptr(&self, instr_id: i32) -> rawptr {
        let rec = self.instr_record(instr_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 80);
    }

    public fn value_loc_line(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 104)); }
    public fn value_loc_col(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 108)); }
    public fn value_loc_end_line(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 112)); }
    public fn value_loc_end_col(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 116)); }

    public fn set_block_loc(self, block_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.block_record(block_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 56), line);
        ast_write_i32(ptr_offset(rec, 60), col);
        ast_write_i32(ptr_offset(rec, 64), end_line);
        ast_write_i32(ptr_offset(rec, 68), end_col);
    }

    public fn set_local_loc(self, local_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.local_record(local_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 56), line);
        ast_write_i32(ptr_offset(rec, 60), col);
        ast_write_i32(ptr_offset(rec, 64), end_line);
        ast_write_i32(ptr_offset(rec, 68), end_col);
    }

    public fn set_instr_loc(self, instr_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.instr_record(instr_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 80), line);
        ast_write_i32(ptr_offset(rec, 84), col);
        ast_write_i32(ptr_offset(rec, 88), end_line);
        ast_write_i32(ptr_offset(rec, 92), end_col);
    }

    public fn add_instr(self,
                        function_id: i32,
                        block_id: i32,
                        kind: i32,
                        type_id: i32,
                        place_id: i32,
                        value_id: i32,
                        lhs_value_id: i32,
                        rhs_value_id: i32,
                        target_kind: i32,
                        target_id: i32,
                        source_stmt_id: i32,
                        source_expr_id: i32,
                        flags: i32,
                        aux: i32,
                        name: string) -> i32 {
        let id = self.ids.alloc_instr();
        self.ensure_instrs(id);
        let rec = self.instr_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), block_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), type_id);
        ast_write_i32(ptr_offset(rec, 20), place_id);
        ast_write_i32(ptr_offset(rec, 24), value_id);
        ast_write_i32(ptr_offset(rec, 28), lhs_value_id);
        ast_write_i32(ptr_offset(rec, 32), rhs_value_id);
        ast_write_i32(ptr_offset(rec, 36), target_kind);
        ast_write_i32(ptr_offset(rec, 40), target_id);
        ast_write_i32(ptr_offset(rec, 44), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 48), source_expr_id);
        ast_write_i32(ptr_offset(rec, 52), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 56), flags);
        ast_write_i32(ptr_offset(rec, 60), aux);
        mir_write_string(rec, 64, 72, name);
        ast_write_i32(ptr_offset(rec, 80), 0);
        ast_write_i32(ptr_offset(rec, 84), 0);
        ast_write_i32(ptr_offset(rec, 88), 0);
        ast_write_i32(ptr_offset(rec, 92), 0);
        if (block_id != mir_id_invalid()) {
            let block_rec = self.block_record(block_id);
            if (block_rec != null) {
                let first = ast_read_i32(ptr_offset(block_rec, 8));
                let last = ast_read_i32(ptr_offset(block_rec, 12));
                if (first == mir_id_invalid()) { ast_write_i32(ptr_offset(block_rec, 8), id); }
                if (last != mir_id_invalid()) {
                    let last_rec = self.instr_record(last);
                    if (last_rec != null) { ast_write_i32(ptr_offset(last_rec, 52), id); }
                }
                ast_write_i32(ptr_offset(block_rec, 12), id);
                var instr_count = ast_read_i32(ptr_offset(block_rec, 16));
                instr_count = instr_count + 1;
                ast_write_i32(ptr_offset(block_rec, 16), instr_count);
            }
        }
        if (id > self.instr_count) { self.instr_count = id; }
        return id;
    }

    public fn set_instr_value(self, instr_id: i32, value_id: i32) -> bool {
        if (instr_id < 1 || instr_id > self.instr_count
            || value_id < 1 || value_id > self.value_count) { return false; }
        let rec = self.instr_record(instr_id);
        let value_rec = self.value_record(value_id);
        if (rec == null || value_rec == null
            || ast_read_i32(rec) != instr_id
            || ast_read_i32(value_rec) != value_id) { return false; }
        let function_id = self.instr_function(instr_id);
        let block_id = self.instr_block(instr_id);
        if (function_id == mir_id_invalid()
            || block_id < 1 || block_id > self.block_count
            || self.block_record(block_id) == null
            || ast_read_i32(self.block_record(block_id)) != block_id
            || self.block_function(block_id) != function_id
            || self.block_is_removed(block_id)) { return false; }
        let old_value_id = self.instr_value(instr_id);
        if (old_value_id < 1 || old_value_id > self.value_count
            || self.value_record(old_value_id) == null
            || ast_read_i32(self.value_record(old_value_id)) != old_value_id
            || self.value_function(value_id) != function_id
            || self.value_function(old_value_id) != function_id
            || self.value_type(value_id) != self.value_type(old_value_id)) { return false; }
        let instr_type_id = self.instr_type(instr_id);
        if (instr_type_id != mir_id_invalid()
            && self.value_type(value_id) != instr_type_id) { return false; }
        ast_write_i32(ptr_offset(rec, 24), value_id);
        return true;
    }

    // An eliminated expression statement remains in the stable instruction
    // chain as an eval tombstone. Its source location stays available for
    // dumps, while an empty value makes both lowering and use-def treat it as
    // a semantic no-op.
    public fn clear_eval_instr_value(self, instr_id: i32) -> bool {
        if (instr_id < 1 || instr_id > self.instr_count) { return false; }
        let rec = self.instr_record(instr_id);
        if (rec == null || ast_read_i32(rec) != instr_id
            || self.instr_kind(instr_id) != mir_instr_eval()) { return false; }
        let function_id = self.instr_function(instr_id);
        let block_id = self.instr_block(instr_id);
        if (function_id == mir_id_invalid()
            || block_id < 1 || block_id > self.block_count
            || self.block_record(block_id) == null
            || ast_read_i32(self.block_record(block_id)) != block_id
            || self.block_function(block_id) != function_id
            || self.block_is_removed(block_id)
            || self.instr_value(instr_id) == mir_id_invalid()) {
            return false;
        }
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_target_none());
        ast_write_i32(ptr_offset(rec, 40), mir_id_invalid());
        return true;
    }

    public fn set_block_terminator(self,
                                   block_id: i32,
                                   kind: i32,
                                   value_id: i32,
                                   target_block_id: i32,
                                   false_block_id: i32,
                                   first_case_id: i32,
                                   aux: i32) {
        let rec = self.block_record(block_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 20), kind);
        ast_write_i32(ptr_offset(rec, 24), value_id);
        ast_write_i32(ptr_offset(rec, 28), target_block_id);
        ast_write_i32(ptr_offset(rec, 32), false_block_id);
        ast_write_i32(ptr_offset(rec, 36), first_case_id);
        ast_write_i32(ptr_offset(rec, 52), aux);
    }

    public fn set_function_block_chain(self,
                                       function_id: i32,
                                       first_block_id: i32,
                                       active_count: i32) -> bool {
        let function_rec = self.function_record(function_id);
        if (function_rec == null || ast_read_i32(function_rec) != function_id
            || active_count < 0) { return false; }
        if (first_block_id != mir_id_invalid()) {
            let block_rec = self.block_record(first_block_id);
            if (block_rec == null || ast_read_i32(block_rec) != first_block_id
                || self.block_function(first_block_id) != function_id
                || (self.block_flags(first_block_id) & mir_block_flag_removed()) != 0) {
                return false;
            }
        } else if (active_count != 0) {
            return false;
        }
        ast_write_i32(ptr_offset(function_rec, 24), first_block_id);
        ast_write_i32(ptr_offset(function_rec, 28), active_count);
        return true;
    }

    public fn set_block_next(self, block_id: i32, next_block_id: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id
            || (self.block_flags(block_id) & mir_block_flag_removed()) != 0) { return false; }
        if (next_block_id != mir_id_invalid()) {
            let next_rec = self.block_record(next_block_id);
            if (next_rec == null || ast_read_i32(next_rec) != next_block_id
                || self.block_function(next_block_id) != self.block_function(block_id)
                || (self.block_flags(next_block_id) & mir_block_flag_removed()) != 0) {
                return false;
            }
        }
        ast_write_i32(ptr_offset(rec, 48), next_block_id);
        return true;
    }

    public fn set_block_flags(self, block_id: i32, flags: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id) { return false; }
        ast_write_i32(ptr_offset(rec, 44), flags);
        return true;
    }

    public fn set_case_target_block(self, case_id: i32, target_block_id: i32) -> bool {
        let rec = self.case_record(case_id);
        if (rec == null || ast_read_i32(rec) != case_id) { return false; }
        let owner_block = self.case_owner_block(case_id);
        let owner_rec = self.block_record(owner_block);
        let target_rec = self.block_record(target_block_id);
        if (owner_block == mir_id_invalid()
            || owner_rec == null
            || ast_read_i32(owner_rec) != owner_block
            || (self.block_flags(owner_block) & mir_block_flag_removed()) != 0
            || target_block_id == mir_id_invalid()
            || target_rec == null
            || ast_read_i32(target_rec) != target_block_id
            || self.block_function(owner_block) != self.block_function(target_block_id)
            || (self.block_flags(target_block_id) & mir_block_flag_removed()) != 0) {
            return false;
        }
        ast_write_i32(ptr_offset(rec, 16), target_block_id);
        return true;
    }

    public fn tombstone_block(self, block_id: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id) { return false; }
        ast_write_i32(ptr_offset(rec, 44), self.block_flags(block_id) | mir_block_flag_removed());
        ast_write_i32(ptr_offset(rec, 48), mir_id_invalid());
        self.set_block_terminator(block_id,
                                  mir_term_unreachable(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid());
        return true;
    }

    public fn add_case(self,
                       owner_block_id: i32,
                       pattern_value_id: i32,
                       guard_value_id: i32,
                       target_block_id: i32,
                       source_stmt_id: i32,
                       text: string) -> i32 {
        let id = self.ids.alloc_case();
        self.ensure_cases(id);
        let rec = self.case_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), owner_block_id);
        ast_write_i32(ptr_offset(rec, 8), pattern_value_id);
        ast_write_i32(ptr_offset(rec, 12), guard_value_id);
        ast_write_i32(ptr_offset(rec, 16), target_block_id);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 28), 0);
        mir_write_string(rec, 32, 40, text);
        if (id > self.case_count) { self.case_count = id; }
        return id;
    }

    public fn set_reflection_manifest(self, manifest: string) {
        self.reflection_manifest = manifest;
    }

    public fn set_reflection_name_map(self, name_map: string) {
        self.reflection_name_map = name_map;
    }

    public fn set_foreign_cpp_includes(self, includes: string) {
        self.foreign_cpp_includes = includes;
    }

    public fn set_dci_stub_specs(self, specs: string) {
        self.dci_stub_specs = specs;
    }

    public fn set_dci_abi_text(self, text: string) {
        self.dci_abi_text = text;
        self.dci_abi_path = "";
        self.dci_abi_is_binary = false;
    }

    public fn set_dci_abi_source(self, text: string, path: string, is_binary: bool) {
        self.dci_abi_text = text;
        self.dci_abi_path = path;
        self.dci_abi_is_binary = is_binary;
    }

    public fn set_interface_supers(self, supers: string) {
        self.interface_supers = supers;
    }

    public fn set_case_next(self, case_id: i32, next_id: i32) {
        let rec = self.case_record(case_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 20), next_id); }
    }

    public fn discard_recent_body_records(self,
                                          function_id: i32,
                                          block_mark: i32,
                                          local_mark: i32,
                                          place_mark: i32,
                                          value_mark: i32,
                                           instr_mark: i32,
                                           case_mark: i32) {
        // Locals deliberately remain after a streamed body is released: later
        // declarations still need their parameter types and flags. Clear the
        // body-owned references first so a whole-unit verifier never follows a
        // PlaceId/ValueId whose table has just been rewound.
        var local_id = self.function_first_local(function_id);
        var local_guard: i32 = 0;
        while (local_id != mir_id_invalid() && local_guard <= self.local_count) {
            let local_rec = self.local_record(local_id);
            // Parameter locals can be created while signatures are prepared,
            // before this function's body marks were recorded. Clear by owner
            // instead of relying on the append range so those stale places do
            // not survive the body-table rewind.
            if (local_rec != null && self.local_function(local_id) == function_id) {
                ast_write_i32(ptr_offset(local_rec, 20), mir_id_invalid());
                ast_write_i32(ptr_offset(local_rec, 48), mir_id_invalid());
            }
            local_id = self.local_next(local_id);
            local_guard = local_guard + 1;
        }
        var id: i32 = place_mark + 1;
        while (id <= self.place_count) {
            let rec = self.place_record(id);
            mir_write_string(rec, 40, 48, "");
            if (rec != null) { memset(rec, 0, mir_place_record_size() as u64); }
            id = id + 1;
        }
        id = value_mark + 1;
        while (id <= self.value_count) {
            let rec = self.value_record(id);
            mir_write_string(rec, 72, 80, "");
            mir_write_string(rec, 88, 96, "");
            if (rec != null) { memset(rec, 0, mir_value_record_size() as u64); }
            id = id + 1;
        }
        id = instr_mark + 1;
        while (id <= self.instr_count) {
            let rec = self.instr_record(id);
            mir_write_string(rec, 64, 72, "");
            if (rec != null) { memset(rec, 0, mir_instr_record_size() as u64); }
            id = id + 1;
        }
        id = case_mark + 1;
        while (id <= self.case_count) {
            let rec = self.case_record(id);
            mir_write_string(rec, 32, 40, "");
            if (rec != null) { memset(rec, 0, mir_case_record_size() as u64); }
            id = id + 1;
        }
        id = block_mark + 1;
        while (id <= self.block_count) {
            let rec = self.block_record(id);
            if (rec != null) { memset(rec, 0, mir_block_record_size() as u64); }
            id = id + 1;
        }
        let fn_rec = self.function_record(function_id);
        if (fn_rec != null) {
            ast_write_i32(ptr_offset(fn_rec, 24), mir_id_invalid());
            ast_write_i32(ptr_offset(fn_rec, 28), 0);
        }
        self.block_count = block_mark;
        self.place_count = place_mark;
        self.value_count = value_mark;
        self.instr_count = instr_mark;
        self.case_count = case_mark;
        self.ids.next_block_id = block_mark + 1;
        self.ids.next_place_id = place_mark + 1;
        self.ids.next_value_id = value_mark + 1;
        self.ids.next_instr_id = instr_mark + 1;
        self.ids.next_case_id = case_mark + 1;
    }

    public fn function_hir_id(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn function_hir_item(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn function_return_type(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn function_first_local(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn function_local_count(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn function_first_block(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn function_block_count(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn function_name(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 32, 40); }
    public fn function_generic_params(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 48, 56); }
    public fn function_generic_args(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 64, 72); }
    public fn function_owner_type(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 80, 88); }
    public fn function_symbol_discriminator(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 112, 120); }
    public fn function_item_kind(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 96)); }
    public fn function_owner_item_kind(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 100)); }
    public fn function_flags(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 104)); }
    public fn function_streamed_body_discarded(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 1) != 0;
    }
    public fn function_streamed_needs_closure_adapter(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 2) != 0;
    }
    public fn function_streamed_needs_raw_callback_adapter(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 4) != 0;
    }

    public fn block_function(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn block_first_instr(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn block_last_instr(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn block_instr_count(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn block_term_kind(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn block_term_value(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn block_term_target(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn block_term_false(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }
    public fn block_term_first_case(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }
    public fn block_source_stmt(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }
    public fn block_flags(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }
    public fn block_is_removed(&self, id: i32) -> bool { return (self.block_flags(id) & mir_block_flag_removed()) != 0; }
    public fn block_next(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }
    public fn block_term_aux(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }
    public fn block_loc_line(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }
    public fn block_loc_col(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }
    public fn block_loc_end_line(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 64)); }
    public fn block_loc_end_col(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 68)); }

    public fn local_function(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn local_hir_id(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn local_type(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn local_flags(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn local_place(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn local_next(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn local_capture_source(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn local_name(&self, id: i32) -> string { return mir_read_string(self.local_record(id), 32, 40); }
    public fn local_capture_init_value(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }
    public fn local_loc_line(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }
    public fn local_loc_col(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }
    public fn local_loc_end_line(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 64)); }
    public fn local_loc_end_col(&self, id: i32) -> i32 { let r = self.local_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 68)); }

    public fn field_owner_item(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn field_owner_type(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn field_type(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn field_index(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return -1; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn field_name(&self, id: i32) -> string { return mir_read_string(self.field_record(id), 24, 32); }

    public fn field_count_for_type(&self, type_id: i32) -> i32 {
        var max_index: i32 = -1;
        var id: i32 = 1;
        while (id <= self.field_count) {
            let rec = self.field_record(id);
            if (rec != null && ast_read_i32(rec) == id && ast_read_i32(ptr_offset(rec, 8)) == type_id) {
                let idx = ast_read_i32(ptr_offset(rec, 16));
                if (idx > max_index) { max_index = idx; }
            }
            id = id + 1;
        }
        return max_index + 1;
    }

    public fn field_id_for_type_index(&self, type_id: i32, wanted_index: i32) -> i32 {
        var found = mir_id_invalid();
        var id: i32 = 1;
        while (id <= self.field_count) {
            let rec = self.field_record(id);
            if (rec != null
                && ast_read_i32(rec) == id
                && ast_read_i32(ptr_offset(rec, 8)) == type_id
                && ast_read_i32(ptr_offset(rec, 16)) == wanted_index) {
                // Later HIR items are the canonical/current layout when
                // versioned declarations share a type and field slot.
                found = id;
            }
            id = id + 1;
        }
        return found;
    }

    public fn variant_owner_type(&self, id: i32) -> i32 { let r = self.variant_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn variant_tag(&self, id: i32) -> i32 { let r = self.variant_record(id); if (r == null) { return -1; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn variant_payload_count(&self, id: i32) -> i32 { let r = self.variant_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn variant_name(&self, id: i32) -> string { return mir_read_string(self.variant_record(id), 24, 32); }
    public fn variant_payload_types(&self, id: i32) -> string { return mir_read_string(self.variant_record(id), 40, 48); }

    public fn static_exists(&self, id: i32) -> bool { let r = self.static_record(id); if (r == null) { return false; } return ast_read_i32(r) == id; }
    public fn static_item_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn static_type(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn static_init_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn static_init_target_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn static_init_target_id(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn static_init_int(&self, id: i32) -> i64 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i64(ptr_offset(r, 24)); }
    public fn static_name(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 32, 40); }
    public fn static_init_text(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 48, 56); }
    public fn static_module_name(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 64, 72); }

    public fn variant_count_for_type(&self, type_id: i32) -> i32 {
        var max_tag: i32 = -1;
        var id: i32 = 1;
        while (id <= self.variant_count) {
            let rec = self.variant_record(id);
            if (rec != null && ast_read_i32(rec) == id && ast_read_i32(ptr_offset(rec, 8)) == type_id) {
                let tag = ast_read_i32(ptr_offset(rec, 12));
                if (tag > max_tag) { max_tag = tag; }
            }
            id = id + 1;
        }
        return max_tag + 1;
    }

    public fn variant_id_for_type_tag(&self, type_id: i32, wanted_tag: i32) -> i32 {
        var id: i32 = 1;
        while (id <= self.variant_count) {
            let rec = self.variant_record(id);
            if (rec != null
                && ast_read_i32(rec) == id
                && ast_read_i32(ptr_offset(rec, 8)) == type_id
                && ast_read_i32(ptr_offset(rec, 12)) == wanted_tag) {
                return id;
            }
            id = id + 1;
        }
        return mir_id_invalid();
    }

    public fn variant_is_primary_for_type_tag(&self, variant_id: i32) -> bool {
        let rec = self.variant_record(variant_id);
        if (rec == null || ast_read_i32(rec) != variant_id) { return false; }
        let owner_type = ast_read_i32(ptr_offset(rec, 8));
        let tag = ast_read_i32(ptr_offset(rec, 12));
        return self.variant_id_for_type_tag(owner_type, tag) == variant_id;
    }

    public fn place_function(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn place_type(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn place_kind(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn place_local(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn place_base(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn place_field(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn place_index_value(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    // Idle slot at offset 36, reserved by add_place() as zero.  It stores the
    // pointer-check policy decided by the mir_ptr_hoist pass; see
    // mir_check_policy_* in mir_ids.vyx.
    public fn place_check_policy(&self, id: i32) -> i32 {
        let r = self.place_record(id);
        if (r == null) { return mir_check_policy_inline(); }
        return ast_read_i32(ptr_offset(r, 36));
    }

    public fn set_place_check_policy(self, id: i32, policy: i32) -> bool {
        if (id < 1 || id > self.place_count) { return false; }
        let r = self.place_record(id);
        if (r == null) { return false; }
        ast_write_i32(ptr_offset(r, 36), policy);
        return true;
    }
    public fn place_source_expr(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }
    public fn place_name(&self, id: i32) -> string { return mir_read_string(self.place_record(id), 40, 48); }

    public fn value_function(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn value_type(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn value_kind(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn value_place(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn value_lhs(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn value_rhs(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn value_aux(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn value_first_arg(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }
    public fn value_next_arg(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }
    public fn value_target_kind(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }
    public fn value_target_id(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }
    public fn value_source_expr(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }
    public fn value_flags(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }
    public fn value_op(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }
    public fn value_aggregate_field(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }
    public fn value_int(&self, id: i32) -> i64 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i64(ptr_offset(r, 64)); }
    public fn value_name(&self, id: i32) -> string { return mir_read_string(self.value_record(id), 72, 80); }
    public fn value_text(&self, id: i32) -> string { return mir_read_string(self.value_record(id), 88, 96); }

    public fn instr_function(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn instr_block(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn instr_kind(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn instr_type(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn instr_place(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn instr_value(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn instr_lhs(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn instr_rhs(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }
    public fn instr_target_kind(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }
    public fn instr_target_id(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }
    public fn instr_source_stmt(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }
    public fn instr_source_expr(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }
    public fn instr_next(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }
    public fn instr_flags(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }
    public fn instr_aux(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }
    public fn instr_name(&self, id: i32) -> string { return mir_read_string(self.instr_record(id), 64, 72); }
    public fn instr_loc_line(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 80)); }
    public fn instr_loc_col(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 84)); }
    public fn instr_loc_end_line(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 88)); }
    public fn instr_loc_end_col(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 92)); }

    public fn case_owner_block(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn case_pattern_value(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn case_guard_value(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn case_target_block(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn case_next(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn case_source_stmt(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
