}

public fn mir_unit_function_is_foreign_dci(m: &MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    return (m.function_flags(function_id) & hir_function_flag_foreign_dci()) != 0;
}

public fn mir_unit_function_is_foreign_cpp(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci(m, function_id);
}

public fn mir_unit_function_is_foreign_dci_ctor(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return false; }
    return (m.function_flags(function_id) & hir_function_flag_foreign_dci_ctor()) != 0;
}

public fn mir_unit_function_is_foreign_cpp_ctor(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_ctor(m, function_id);
}

public fn mir_unit_function_is_foreign_dci_dtor(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return false; }
    return (m.function_flags(function_id) & hir_function_flag_foreign_dci_dtor()) != 0;
}

public fn mir_unit_function_is_foreign_cpp_dtor(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_dtor(m, function_id);
}

public fn mir_unit_type_is_foreign_dci(m: &MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    return (hir_type_table_flags(m.types, type_id) & hir_type_flag_foreign_dci()) != 0;
}

public fn mir_unit_type_is_foreign_cpp(m: &MirUnit, type_id: i32) -> bool {
    return mir_unit_type_is_foreign_dci(m, type_id);
}

public fn mir_unit_local_is_source_param(m: &MirUnit, local_id: i32) -> bool {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    return (m.local_flags(local_id) & mir_local_flag_param()) != 0;
}

public fn mir_unit_local_is_self_receiver_param(m: &MirUnit, local_id: i32) -> bool {
    if (!mir_unit_local_is_source_param(m, local_id)) { return false; }
    return (m.local_flags(local_id) & mir_local_flag_self_receiver()) != 0;
}

public fn mir_unit_function_param_count(m: &MirUnit, function_id: i32) -> i32 {
    var out: i32 = 0;
    var local = m.function_first_local(function_id);
    while (local != mir_id_invalid()) {
        if (mir_unit_local_is_source_param(m, local)) { out = out + 1; }
        local = m.local_next(local);
    }
    return out;
}

public fn mir_unit_function_param_local_at(m: &MirUnit, function_id: i32, idx: i32) -> i32 {
    var seen: i32 = 0;
    var local = m.function_first_local(function_id);
    while (local != mir_id_invalid()) {
        if (mir_unit_local_is_source_param(m, local)) {
            if (seen == idx) { return local; }
            seen = seen + 1;
        }
        local = m.local_next(local);
    }
    return mir_id_invalid();
}

public fn mir_unit_function_param_type_at(m: &MirUnit, function_id: i32, idx: i32) -> i32 {
    let local = mir_unit_function_param_local_at(m, function_id, idx);
    if (local == mir_id_invalid()) { return mir_id_invalid(); }
    return m.local_type(local);
}

public fn mir_unit_find_type_by_text(m: &MirUnit, text: string) -> i32 {
    if (text.len == 0) { return mir_id_invalid(); }
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (hir_type_table_text(m.types, type_id) == text) { return type_id; }
        type_id = type_id + 1;
    }
    return mir_id_invalid();
}

public fn mir_unit_foreign_dci_owner_type_id(m: &MirUnit, function_id: i32) -> i32 {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return mir_id_invalid(); }
    let owner = m.function_owner_type(function_id);
    if (owner.len > 0) {
        let owner_id = mir_unit_find_type_by_text(m, owner);
        if (owner_id != mir_id_invalid()) { return owner_id; }
    }
    let self_local = mir_unit_function_param_local_at(m, function_id, 0);
    if (mir_unit_local_is_self_receiver_param(m, self_local)) {
        let self_type = m.local_type(self_local);
        if (mir_unit_type_is_foreign_dci(m, self_type)) { return self_type; }
    }
    if (mir_unit_function_is_foreign_dci_ctor(m, function_id)) {
        let ret_type = m.function_return_type(function_id);
        if (mir_unit_type_is_foreign_dci(m, ret_type)) { return ret_type; }
    }
    return mir_id_invalid();
}

public fn mir_unit_foreign_cpp_owner_type_id(m: &MirUnit, function_id: i32) -> i32 {
    return mir_unit_foreign_dci_owner_type_id(m, function_id);
}

public fn mir_unit_foreign_dci_owner_type_text(m: &MirUnit, function_id: i32) -> string {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return ""; }
    let owner = m.function_owner_type(function_id);
    if (owner.len > 0) { return owner; }
    let owner_id = mir_unit_foreign_dci_owner_type_id(m, function_id);
    if (owner_id != mir_id_invalid()) { return hir_type_table_text(m.types, owner_id); }
    return "";
}

public fn mir_unit_foreign_cpp_owner_type_text(m: &MirUnit, function_id: i32) -> string {
    return mir_unit_foreign_dci_owner_type_text(m, function_id);
}

public fn mir_unit_function_has_self_receiver_param(m: &MirUnit, function_id: i32) -> bool {
    let first = mir_unit_function_param_local_at(m, function_id, 0);
    return mir_unit_local_is_self_receiver_param(m, first);
}

public fn mir_unit_function_is_foreign_dci_method(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_ctor(m, function_id)) { return true; }
    if (mir_unit_function_is_foreign_dci_dtor(m, function_id)) { return true; }
    return mir_unit_foreign_dci_owner_type_text(m, function_id).len > 0;
}

public fn mir_unit_function_is_foreign_cpp_method(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_method(m, function_id);
}

public fn mir_unit_function_is_foreign_dci_instance_method(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci_method(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_ctor(m, function_id)) { return false; }
    return mir_unit_function_has_self_receiver_param(m, function_id);
}

public fn mir_unit_function_is_foreign_cpp_instance_method(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_instance_method(m, function_id);
}

public fn mir_unit_function_is_foreign_dci_static_method(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci_method(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_ctor(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_dtor(m, function_id)) { return false; }
    return !mir_unit_function_has_self_receiver_param(m, function_id);
}

public fn mir_unit_function_is_foreign_cpp_static_method(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_static_method(m, function_id);
}

public fn mir_unit_function_is_foreign_dci_const_method(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci_instance_method(m, function_id)) { return false; }
    return (m.function_flags(function_id) & hir_function_flag_foreign_dci_const_method()) != 0;
}

public fn mir_unit_function_is_foreign_cpp_const_method(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_const_method(m, function_id);
}

