module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn vyx_forget_string_len(s: rawptr);
}

/// Function record layout extends the legacy 112-byte payload with the stable
/// symbol discriminator at 112..127.  It is propagated from HIR provenance
/// and distinguishes ABI-identical bodies from different module versions.
fn mir_function_record_size() -> i32 { return 128; }
/// Block/local/instruction records carry a stable 16-byte SourceLoc tail.
/// HIR bodies are streamed and released before codegen finishes, so keeping
/// only HIR ids here is insufficient for debuggers and the MIR2CPP backend.
fn mir_block_record_size() -> i32 { return 72; }
fn mir_local_record_size() -> i32 { return 72; }
fn mir_field_record_size() -> i32 { return 40; }
fn mir_variant_record_size() -> i32 { return 56; }
/// Static records carry the declaring module as a stable namespace key.
/// HIR item ids are local to each compilation and cannot identify globals.
fn mir_static_record_size() -> i32 { return 80; }
fn mir_place_record_size() -> i32 { return 56; }
/// Value record layout keeps the legacy 0..103 fields and appends a 16-byte
/// SourceLoc tail at 104..119 copied from the originating HIR expr.
fn mir_value_record_size() -> i32 { return 120; }
fn mir_instr_record_size() -> i32 { return 96; }
fn mir_case_record_size() -> i32 { return 56; }

fn mir_record_at(buf: rawptr, id: i32, size: i32) -> rawptr {
    if (buf == null || id <= 0) { return null; }
    return ptr_offset(buf, (id - 1) * size);
}

fn mir_write_string(rec: rawptr, ptr_off: i32, len_off: i32, text: string) {
    if (rec == null) { return; }
    let slot = ptr_offset(rec, ptr_off);
    let old_ptr = ast_read_rawptr(slot);
    if (old_ptr != null) {
        vyx_forget_string_len(old_ptr);
        free(old_ptr);
    }
    if (text.len <= 0) {
        ast_write_rawptr(slot, null);
        ast_write_i64(ptr_offset(rec, len_off), 0);
        return;
    }
    ast_write_rawptr(slot, ast_dup_c_string(text));
    ast_write_i64(ptr_offset(rec, len_off), text.len);
}

fn mir_read_string(rec: rawptr, ptr_off: i32, len_off: i32) -> string {
    if (rec == null) { return ""; }
    let ptr = ast_read_rawptr(ptr_offset(rec, ptr_off));
    let len = ast_read_i64(ptr_offset(rec, len_off));
    if (ptr == null || len <= 0) { return ""; }
    return from_cstr_view_len(ptr, len);
}

public class MirUnit {
    public ids: MirIdAllocator
    public types: HirTypeTable
    public function_buf: rawptr
    public function_count: i32
    public function_cap: i32
    public block_buf: rawptr
    public block_count: i32
    public block_cap: i32
    public local_buf: rawptr
    public local_count: i32
    public local_cap: i32
    public field_buf: rawptr
    public field_count: i32
    public field_cap: i32
    public variant_buf: rawptr
    public variant_count: i32
    public variant_cap: i32
    public static_buf: rawptr
    public static_count: i32
    public static_cap: i32
    public place_buf: rawptr
    public place_count: i32
    public place_cap: i32
    public value_buf: rawptr
    public value_count: i32
    public value_cap: i32
    public instr_buf: rawptr
    public instr_count: i32
    public instr_cap: i32
    public case_buf: rawptr
    public case_count: i32
    public case_cap: i32
    public reflection_manifest: string
    public reflection_name_map: string
    public foreign_cpp_includes: string
    public dci_stub_specs: string
    public dci_abi_text: string
    public dci_abi_path: string
    public dci_abi_is_binary: bool
    public interface_supers: string

    // Return a by-value snapshot of this unit for read-only pass helpers.
    // The MIR pass pipeline threads the unit as `&mut MirUnit` so that growth
    // (add_value/add_instr) persists to the caller. Read-only helpers still
    // take `MirUnit` by value; feeding them `*m` miscompiles under the
    // self-host copy ABI (byval-deref of a mutref crashes), whereas a method
    // that returns `self` lowers through the native C aggregate path: small
    // (≤2 words, trivial) coerce / first-class struct; large via sret copy.
    // Method `self` is always a pointer so field writes GEP the object.
    // The snapshot shares this unit's heap tables (rawptr fields are copied
    // by value), so
    // in-place record edits by non-growth passes still persist through it.
    public fn view(self) -> MirUnit { return self; }

    public static fn create(types: HirTypeTable) -> MirUnit {
        let fn_cap0: i32 = 256;
        let block_cap0: i32 = 512;
        let local_cap0: i32 = 1024;
        let field_cap0: i32 = 1024;
        let variant_cap0: i32 = 1024;
        let static_cap0: i32 = 1024;
        let place_cap0: i32 = 2048;
        let value_cap0: i32 = 4096;
        let instr_cap0: i32 = 4096;
        let case_cap0: i32 = 512;
        let fn_buf0 = malloc((fn_cap0 * mir_function_record_size()) as u64);
        let block_buf0 = malloc((block_cap0 * mir_block_record_size()) as u64);
        let local_buf0 = malloc((local_cap0 * mir_local_record_size()) as u64);
        let field_buf0 = malloc((field_cap0 * mir_field_record_size()) as u64);
        let variant_buf0 = malloc((variant_cap0 * mir_variant_record_size()) as u64);
        let static_buf0 = malloc((static_cap0 * mir_static_record_size()) as u64);
        let place_buf0 = malloc((place_cap0 * mir_place_record_size()) as u64);
        let value_buf0 = malloc((value_cap0 * mir_value_record_size()) as u64);
        let instr_buf0 = malloc((instr_cap0 * mir_instr_record_size()) as u64);
        let case_buf0 = malloc((case_cap0 * mir_case_record_size()) as u64);
        if (fn_buf0 != null) { memset(fn_buf0, 0, (fn_cap0 * mir_function_record_size()) as u64); }
        if (block_buf0 != null) { memset(block_buf0, 0, (block_cap0 * mir_block_record_size()) as u64); }
        if (local_buf0 != null) { memset(local_buf0, 0, (local_cap0 * mir_local_record_size()) as u64); }
        if (field_buf0 != null) { memset(field_buf0, 0, (field_cap0 * mir_field_record_size()) as u64); }
        if (variant_buf0 != null) { memset(variant_buf0, 0, (variant_cap0 * mir_variant_record_size()) as u64); }
        if (static_buf0 != null) { memset(static_buf0, 0, (static_cap0 * mir_static_record_size()) as u64); }
        if (place_buf0 != null) { memset(place_buf0, 0, (place_cap0 * mir_place_record_size()) as u64); }
        if (value_buf0 != null) { memset(value_buf0, 0, (value_cap0 * mir_value_record_size()) as u64); }
        if (instr_buf0 != null) { memset(instr_buf0, 0, (instr_cap0 * mir_instr_record_size()) as u64); }
        if (case_buf0 != null) { memset(case_buf0, 0, (case_cap0 * mir_case_record_size()) as u64); }
        return MirUnit {
            ids: MirIdAllocator.create(),
            types: types,
            function_buf: fn_buf0,
            function_count: 0,
            function_cap: fn_cap0,
            block_buf: block_buf0,
            block_count: 0,
            block_cap: block_cap0,
            local_buf: local_buf0,
            local_count: 0,
            local_cap: local_cap0,
            field_buf: field_buf0,
            field_count: 0,
            field_cap: field_cap0,
            variant_buf: variant_buf0,
            variant_count: 0,
            variant_cap: variant_cap0,
            static_buf: static_buf0,
            static_count: 0,
            static_cap: static_cap0,
            place_buf: place_buf0,
            place_count: 0,
            place_cap: place_cap0,
            value_buf: value_buf0,
            value_count: 0,
            value_cap: value_cap0,
            instr_buf: instr_buf0,
            instr_count: 0,
            instr_cap: instr_cap0,
            case_buf: case_buf0,
            case_count: 0,
            case_cap: case_cap0,
            reflection_manifest: "",
            reflection_name_map: "",
            foreign_cpp_includes: "",
            dci_stub_specs: "",
            dci_abi_text: "",
            dci_abi_path: "",
            dci_abi_is_binary: false,
            interface_supers: ""
        };
    }

    public fn grow_table(self, old_buf: rawptr, old_count: i32, old_cap: i32, rec_size: i32, want_count: i32) -> rawptr {
        if (want_count <= old_cap) { return old_buf; }
        var new_cap = old_cap;
        if (new_cap <= 0) { new_cap = 128; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let alloc_bytes = (new_cap as i64) * (rec_size as i64);
        let new_buf = malloc(alloc_bytes as u64);
        if (new_buf == null) { return old_buf; }
        memset(new_buf, 0, alloc_bytes as u64);
        if (old_buf != null && old_count > 0) {
            let copy_bytes = (old_count as i64) * (rec_size as i64);
            memcpy(new_buf, old_buf, copy_bytes as u64);
        }
        if (old_buf != null) { free(old_buf); }
        return new_buf;
    }

    public fn ensure_functions(self, want_count: i32) {
        if (want_count <= self.function_cap) { return; }
        var new_cap = self.function_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.function_buf, self.function_count, self.function_cap, mir_function_record_size(), want_count);
        if (new_buf == self.function_buf) { return; }
        self.function_buf = new_buf;
        self.function_cap = new_cap;
    }

    public fn ensure_blocks(self, want_count: i32) {
        if (want_count <= self.block_cap) { return; }
        var new_cap = self.block_cap;
        if (new_cap <= 0) { new_cap = 512; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.block_buf, self.block_count, self.block_cap, mir_block_record_size(), want_count);
        if (new_buf == self.block_buf) { return; }
        self.block_buf = new_buf;
        self.block_cap = new_cap;
    }

    public fn ensure_locals(self, want_count: i32) {
        if (want_count <= self.local_cap) { return; }
        var new_cap = self.local_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.local_buf, self.local_count, self.local_cap, mir_local_record_size(), want_count);
        if (new_buf == self.local_buf) { return; }
        self.local_buf = new_buf;
        self.local_cap = new_cap;
    }

    public fn ensure_fields(self, want_count: i32) {
        if (want_count <= self.field_cap) { return; }
        var new_cap = self.field_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.field_buf, self.field_count, self.field_cap, mir_field_record_size(), want_count);
        if (new_buf == self.field_buf) { return; }
        self.field_buf = new_buf;
        self.field_cap = new_cap;
    }

    public fn ensure_variants(self, want_count: i32) {
        if (want_count <= self.variant_cap) { return; }
        var new_cap = self.variant_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.variant_buf, self.variant_count, self.variant_cap, mir_variant_record_size(), want_count);
        if (new_buf == self.variant_buf) { return; }
