fn mir_unit_diag_loc_valid(loc: rawptr) -> bool {
    return loc != null && ast_read_i32(loc) > 0;
}

fn mir_unit_diag_loc_for_value_depth(m: &MirUnit, value_id: i32, depth: i32) -> rawptr {
    if (depth > 16 || value_id < 1 || value_id > m.value_count) { return null; }
    let rec = m.value_record(value_id);
    if (rec == null || ast_read_i32(rec) != value_id) { return null; }
    let direct = m.value_loc_ptr(value_id);
    if (mir_unit_diag_loc_valid(direct)) { return direct; }
    let place_loc = mir_unit_diag_loc_for_place_depth(m, m.value_place(value_id), depth + 1);
    if (mir_unit_diag_loc_valid(place_loc)) { return place_loc; }
    let lhs_loc = mir_unit_diag_loc_for_value_depth(m, m.value_lhs(value_id), depth + 1);
    if (mir_unit_diag_loc_valid(lhs_loc)) { return lhs_loc; }
    let rhs_loc = mir_unit_diag_loc_for_value_depth(m, m.value_rhs(value_id), depth + 1);
    if (mir_unit_diag_loc_valid(rhs_loc)) { return rhs_loc; }
    let aux_loc = mir_unit_diag_loc_for_value_depth(m, m.value_aux(value_id), depth + 1);
    if (mir_unit_diag_loc_valid(aux_loc)) { return aux_loc; }
    return mir_unit_diag_loc_for_value_depth(m, m.value_first_arg(value_id), depth + 1);
}

fn mir_unit_diag_loc_for_place_depth(m: &MirUnit, place_id: i32, depth: i32) -> rawptr {
    if (depth > 16 || place_id < 1 || place_id > m.place_count) { return null; }
    let rec = m.place_record(place_id);
    if (rec == null || ast_read_i32(rec) != place_id) { return null; }
    let kind = m.place_kind(place_id);
    if (kind == mir_place_local()) {
        let loc = m.local_loc_ptr(m.place_local(place_id));
        if (mir_unit_diag_loc_valid(loc)) { return loc; }
    }
    let index_loc = mir_unit_diag_loc_for_value_depth(m, m.place_index_value(place_id), depth + 1);
    if (mir_unit_diag_loc_valid(index_loc)) { return index_loc; }
    return mir_unit_diag_loc_for_place_depth(m, m.place_base(place_id), depth + 1);
}

public fn mir_unit_diag_loc_for_value(m: &MirUnit, value_id: i32) -> rawptr {
    return mir_unit_diag_loc_for_value_depth(m, value_id, 0);
}

public fn mir_unit_diag_loc_for_place(m: &MirUnit, place_id: i32) -> rawptr {
    return mir_unit_diag_loc_for_place_depth(m, place_id, 0);
}

public fn mir_unit_diag_loc_for_local(m: &MirUnit, local_id: i32) -> rawptr {
    if (local_id < 1 || local_id > m.local_count) { return null; }
    let rec = m.local_record(local_id);
    if (rec == null || ast_read_i32(rec) != local_id) { return null; }
    let loc = m.local_loc_ptr(local_id);
    if (mir_unit_diag_loc_valid(loc)) { return loc; }
    return mir_unit_diag_loc_for_place_depth(m, m.local_place(local_id), 0);
}

public fn mir_unit_diag_loc_for_block(m: &MirUnit, block_id: i32) -> rawptr {
    if (block_id < 1 || block_id > m.block_count) { return null; }
    let rec = m.block_record(block_id);
    if (rec == null || ast_read_i32(rec) != block_id) { return null; }
    let loc = m.block_loc_ptr(block_id);
    if (mir_unit_diag_loc_valid(loc)) { return loc; }
    let term_loc = mir_unit_diag_loc_for_value_depth(m, m.block_term_value(block_id), 0);
    if (mir_unit_diag_loc_valid(term_loc)) { return term_loc; }
    let instr_loc = mir_unit_diag_loc_for_instr(m, m.block_first_instr(block_id));
    if (mir_unit_diag_loc_valid(instr_loc)) { return instr_loc; }
    return null;
}

public fn mir_unit_diag_loc_for_instr(m: &MirUnit, instr_id: i32) -> rawptr {
    if (instr_id < 1 || instr_id > m.instr_count) { return null; }
    let rec = m.instr_record(instr_id);
    if (rec == null || ast_read_i32(rec) != instr_id) { return null; }
    let loc = m.instr_loc_ptr(instr_id);
    if (mir_unit_diag_loc_valid(loc)) { return loc; }
    let value_loc = mir_unit_diag_loc_for_value_depth(m, m.instr_value(instr_id), 0);
    if (mir_unit_diag_loc_valid(value_loc)) { return value_loc; }
    let place_loc = mir_unit_diag_loc_for_place_depth(m, m.instr_place(instr_id), 0);
    if (mir_unit_diag_loc_valid(place_loc)) { return place_loc; }
    return null;
}

public fn mir_unit_diag_loc_for_function(m: &MirUnit, function_id: i32) -> rawptr {
    if (function_id < 1 || function_id > m.function_count) { return null; }
    let rec = m.function_record(function_id);
    if (rec == null || ast_read_i32(rec) != function_id) { return null; }
    let block_loc = mir_unit_diag_loc_for_block(m, m.function_first_block(function_id));
    if (mir_unit_diag_loc_valid(block_loc)) { return block_loc; }
    return mir_unit_diag_loc_for_local(m, m.function_first_local(function_id));
}

public fn mir_unit_diag_loc_for_case(m: &MirUnit, case_id: i32) -> rawptr {
    if (case_id < 1 || case_id > m.case_count) { return null; }
    let rec = m.case_record(case_id);
    if (rec == null || ast_read_i32(rec) != case_id) { return null; }
    let pattern_loc = mir_unit_diag_loc_for_value_depth(m, m.case_pattern_value(case_id), 0);
    if (mir_unit_diag_loc_valid(pattern_loc)) { return pattern_loc; }
    let guard_loc = mir_unit_diag_loc_for_value_depth(m, m.case_guard_value(case_id), 0);
    if (mir_unit_diag_loc_valid(guard_loc)) { return guard_loc; }
    return mir_unit_diag_loc_for_block(m, m.case_owner_block(case_id));
}

public fn mir_unit_diag_loc_for_type(m: &MirUnit, type_id: i32) -> rawptr {
    if (type_id == mir_id_invalid()) { return null; }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_type(value_id) == type_id) {
            let loc = mir_unit_diag_loc_for_value_depth(m, value_id, 0);
            if (mir_unit_diag_loc_valid(loc)) { return loc; }
        }
        value_id = value_id + 1;
    }
    var local_id: i32 = 1;
    while (local_id <= m.local_count) {
        if (m.local_type(local_id) == type_id) {
            let loc2 = mir_unit_diag_loc_for_local(m, local_id);
            if (mir_unit_diag_loc_valid(loc2)) { return loc2; }
        }
        local_id = local_id + 1;
    }
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (m.function_return_type(function_id) == type_id) {
            let loc3 = mir_unit_diag_loc_for_function(m, function_id);
            if (mir_unit_diag_loc_valid(loc3)) { return loc3; }
        }
        function_id = function_id + 1;
    }
    return null;
}

public fn mir_unit_diag_loc_for_field(m: &MirUnit, field_id: i32) -> rawptr {
    if (field_id == mir_id_invalid()) { return null; }
    var place_id: i32 = 1;
    while (place_id <= m.place_count) {
        if (m.place_field(place_id) == field_id) {
            let loc = mir_unit_diag_loc_for_place_depth(m, place_id, 0);
            if (mir_unit_diag_loc_valid(loc)) { return loc; }
        }
        place_id = place_id + 1;
    }
    if (field_id >= 1 && field_id <= m.field_count) {
        return mir_unit_diag_loc_for_type(m, m.field_owner_type(field_id));
    }
    return null;
}

public fn mir_unit_diag_first_loc(m: &MirUnit) -> rawptr {
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        let loc = mir_unit_diag_loc_for_function(m, function_id);
        if (mir_unit_diag_loc_valid(loc)) { return loc; }
        function_id = function_id + 1;
    }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        let loc2 = mir_unit_diag_loc_for_value_depth(m, value_id, 0);
        if (mir_unit_diag_loc_valid(loc2)) { return loc2; }
        value_id = value_id + 1;
    }
    return null;
}

