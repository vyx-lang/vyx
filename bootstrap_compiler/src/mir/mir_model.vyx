        self.place_cap = new_cap;
    }

    public fn ensure_values(self, want_count: i32) {
        if (want_count <= self.value_cap) { return; }
        var new_cap = self.value_cap;
        if (new_cap <= 0) { new_cap = 4096; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.value_buf, self.value_count, self.value_cap, mir_value_record_size(), want_count);
        if (new_buf == self.value_buf) { return; }
