public fn mir_unit_function_requires_dci_clang_stub(m: &MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid()) { return false; }
    return false;
}

public fn mir_unit_function_is_foreign_dci_free_function(m: &MirUnit, function_id: i32) -> bool {
    if (!mir_unit_function_is_foreign_dci(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_ctor(m, function_id)) { return false; }
    if (mir_unit_function_is_foreign_dci_dtor(m, function_id)) { return false; }
    return mir_unit_foreign_dci_owner_type_text(m, function_id).len == 0;
}

public fn mir_unit_function_is_foreign_cpp_free_function(m: &MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_free_function(m, function_id);
}

