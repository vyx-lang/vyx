public fn mir_unit_block_is_removed(m: &MirUnit, block_id: i32) -> bool {
    if (block_id < 1 || block_id > m.block_count) { return false; }
    return m.block_is_removed(block_id);
}

public fn mir_unit_instr_owner_is_removed(m: &MirUnit, instr_id: i32) -> bool {
    if (instr_id < 1 || instr_id > m.instr_count) { return false; }
    let owner = m.instr_block(instr_id);
    return owner != mir_id_invalid() && mir_unit_block_is_removed(m, owner);
}

public fn mir_unit_case_owner_is_removed(m: &MirUnit, case_id: i32) -> bool {
    if (case_id < 1 || case_id > m.case_count) { return false; }
    let owner = m.case_owner_block(case_id);
    return owner != mir_id_invalid() && mir_unit_block_is_removed(m, owner);
}

public fn mir_unit_case_is_active(m: &MirUnit, case_id: i32) -> bool {
    if (case_id < 1 || case_id > m.case_count) { return false; }
    let owner = m.case_owner_block(case_id);
    if (owner == mir_id_invalid()
        || mir_unit_block_is_removed(m, owner)
        || m.block_term_kind(owner) != mir_term_match()) { return false; }
    var current = m.block_term_first_case(owner);
    var guard: i32 = 0;
    while (current != mir_id_invalid()) {
        if (current == case_id) { return true; }
        current = m.case_next(current);
        guard = guard + 1;
        if (guard > m.case_count + 1) { return false; }
    }
    return false;
}

public fn mir_unit_add_case(m: &mut MirUnit,
                            owner_block_id: i32,
                            pattern_value_id: i32,
                            guard_value_id: i32,
                            target_block_id: i32,
                            source_stmt_id: i32,
                            text: string) -> i32 {
    return m.add_case(owner_block_id, pattern_value_id, guard_value_id, target_block_id, source_stmt_id, text);
}

public fn mir_unit_set_case_target_block(m: &mut MirUnit,
