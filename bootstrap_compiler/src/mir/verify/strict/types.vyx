module bootstrap.mir_verify;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_verify.MirVerifier {
    // ── strict closure checks (--mir-verify-strict) ─────────────────────
    // All helpers below are additive: they never run unless self.strict.

    public fn strict_type_kind(self, m: MirUnit, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return 0; }
        return hir_type_table_kind(m.types, type_id);
    }

    public fn strict_types_same_text(self, m: MirUnit, lhs: i32, rhs: i32) -> bool {
        return hir_type_table_text(m.types, lhs) == hir_type_table_text(m.types, rhs);
    }

    // 0 = identical TypeId, 1 = same text but different id (non-canonical),
    // 2 = different types.
    public fn strict_type_relation(self, m: MirUnit, expected: i32, actual: i32) -> i32 {
        if (expected == actual) { return 0; }
        if (expected == mir_id_invalid() || actual == mir_id_invalid()) { return 2; }
        if (self.strict_types_same_text(m, expected, actual)) { return 1; }
        return 2;
    }

    public fn strict_type_pair_text(self, m: MirUnit, expected: i32, actual: i32) -> string {
        return "expected #" + self.id_text(expected) + ":" + hir_type_table_text(m.types, expected)
             + " vs actual #" + self.id_text(actual) + ":" + hir_type_table_text(m.types, actual);
    }

    public fn strict_report_type_relation(self, m: MirUnit, cat: i32, expected: i32, actual: i32, where_text: string) {
        let rel = self.strict_type_relation(m, expected, actual);
        if (rel == 0) { return; }
        if (rel == 1) {
            self.record_strict(mv_strict_cat_canon(),
                               where_text + " uses non-canonical TypeId ("
                               + self.strict_type_pair_text(m, expected, actual) + ")");
            return;
        }
        self.record_strict(cat,
                           where_text + " type mismatch ("
                           + self.strict_type_pair_text(m, expected, actual) + ")");
    }

    // ── S7: zero-text closure (void by TypeId, no name/text inference) ─

    public fn strict_check_canonical_string_text(self, m: MirUnit) {
        var id: i32 = 1;
        while (id <= m.types.count) {
            self.focus_type(m, id);
            if (hir_type_table_record(m.types, id) != null) {
                let kind = hir_type_table_kind(m.types, id);
                let text = hir_type_table_text(m.types, id);
                if (kind == ty_STRING()) {
                    if (text != "str") {
                        self.record_strict(mv_strict_cat_text(),
                                           "type #" + self.id_text(id)
                                           + " is str ABI TypeId but text is `"
                                           + text
                                           + "`; expected `str` to match old codegen string ABI");
                    }
                } else {
                    if (text == "str" || mv_legacy_string_primitive_text(text)) {
                        self.record_strict(mv_strict_cat_text(),
                                           "type #" + self.id_text(id)
                                           + " has string primitive text `"
                                           + text
                                           + "` but kind is "
                                           + self.id_text(kind)
                                           + "; str ABI must be represented by ty_STRING");
                    }
                }
            }
            id = id + 1;
        }
    }

    public fn strict_check_void_and_text(self, m: MirUnit) {
        self.strict_check_canonical_string_text(m);
        var fid: i32 = 1;
        while (fid <= m.function_count) {
            self.focus_function(m, fid);
            let ret = m.function_return_type(fid);
            if (ret != mir_id_invalid()) {
                let kind = self.strict_type_kind(m, ret);
                let text = hir_type_table_text(m.types, ret);
                if (text == "void" && kind != ty_VOID()) {
                    self.record_strict(mv_strict_cat_text(),
                                       "function #" + self.id_text(fid) + " (" + m.function_name(fid)
                                       + ") return TypeId #" + self.id_text(ret)
                                       + " prints as void but kind is " + self.id_text(kind)
                                       + " (void decided by text, not TypeId)");
                }
                if (kind == ty_VOID() && text != "void") {
                    self.record_strict(mv_strict_cat_text(),
                                       "function #" + self.id_text(fid) + " (" + m.function_name(fid)
                                       + ") return TypeId #" + self.id_text(ret)
                                       + " has void kind but text `" + text + "`");
                }
            }
            fid = fid + 1;
        }
        var bid: i32 = 1;
        while (bid <= m.block_count) {
            self.focus_block(m, bid);
            if (m.block_is_removed( bid)) {
                bid = bid + 1;
                continue;
            }
            if (m.block_term_kind(bid) == mir_term_return()) {
                let owner = m.block_function(bid);
                let ret = m.function_return_type(owner);
                let kind = self.strict_type_kind(m, ret);
                let term_value = m.block_term_value(bid);
                if (term_value == mir_id_invalid() && kind != ty_VOID()) {
                    self.record_strict(mv_strict_cat_text(),
                                       "block #" + self.id_text(bid)
                                       + " returns empty value but function #" + self.id_text(owner)
                                       + " (" + m.function_name(owner) + ") return kind is "
                                       + self.id_text(kind) + " not void");
                }
                if (term_value != mir_id_invalid() && kind == ty_VOID()) {
                    self.record_strict(mv_strict_cat_text(),
                                       "block #" + self.id_text(bid)
                                       + " returns value #" + self.id_text(term_value)
                                       + " but function #" + self.id_text(owner)
                                       + " (" + m.function_name(owner) + ") is void by TypeId");
                }
            }
            bid = bid + 1;
        }
    }
}
