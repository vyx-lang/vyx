module bootstrap.mir_verify;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_verify.MirVerifier {
    public fn strict_check_calls_scope(self,
                                       m: MirUnit,
                                       scope: MirFunctionVerifyScope) {
        var value_id = scope.value_mark + 1;
        while (value_id <= m.value_count) {
            if (m.value_function(value_id) == scope.function_id
                && m.value_kind(value_id) == mir_value_call()
                && m.value_target_kind(value_id) == mir_target_function()) {
                let target = m.value_target_id(value_id);
                if (target >= 1 && target <= m.function_count) {
                    let where_text = "call value #" + self.id_text(value_id)
                        + " -> function #" + self.id_text(target)
                        + " (" + m.function_name(target) + ")";
                    let first_param = self.strict_first_user_param(m, target);
                    let param_count = self.strict_param_count_from(m, first_param);
                    let arg_count = self.strict_call_arg_count(m, value_id);
                    let is_extern = m.function_item_kind(target) == hir_item_extern_function();
                    if (is_extern) {
                        if (arg_count < param_count) {
                            self.record_strict(mv_strict_cat_call(),
                                               where_text + " arity mismatch: extern expects at least "
                                               + self.id_text(param_count) + " args, got "
                                               + self.id_text(arg_count));
                        }
                    } else if (arg_count != param_count) {
                        self.record_strict(mv_strict_cat_call(),
                                           where_text + " arity mismatch: expects "
                                           + self.id_text(param_count) + " args, got "
                                           + self.id_text(arg_count));
                    }
                    var param = first_param;
                    var arg = m.value_first_arg(value_id);
                    var arg_index: i32 = 0;
                    while (param != mir_id_invalid() && arg != mir_id_invalid()) {
                        self.strict_report_type_relation(m,
                                                         mv_strict_cat_call(),
                                                         m.local_type(param),
                                                         m.value_type(arg),
                                                         where_text + " arg " + self.id_text(arg_index));
                        param = self.strict_next_param(m, param);
                        arg = m.value_next_arg(arg);
                        arg_index = arg_index + 1;
                    }
                    self.strict_report_type_relation(m,
                                                     mv_strict_cat_call(),
                                                     m.function_return_type(target),
                                                     m.value_type(value_id),
                                                     where_text + " result");
                }
            }
            value_id = value_id + 1;
        }
    }
}
