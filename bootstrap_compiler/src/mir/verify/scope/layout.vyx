module bootstrap.mir_verify;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_verify.MirVerifier {
    public fn strict_check_field_places_scope(self,
                                              m: MirUnit,
                                              scope: MirFunctionVerifyScope) {
        var place_id = scope.place_mark + 1;
        while (place_id <= m.place_count) {
            self.focus_place(m, place_id);
            if (m.place_function(place_id) == scope.function_id
                && m.place_kind(place_id) == mir_place_field()) {
                let base = m.place_base(place_id);
                let field = m.place_field(place_id);
                if (base >= 1 && base <= m.place_count
                    && field >= 1 && field <= m.field_count) {
                    self.strict_report_type_relation(m,
                                                     mv_strict_cat_field(),
                                                     m.field_owner_type(field),
                                                     m.place_type(base),
                                                     "field place #" + self.id_text(place_id)
                                                     + " (field " + m.field_name(field) + ") base");
                }
            }
            place_id = place_id + 1;
        }
    }

    public fn strict_check_aggregate_layouts_scope(self,
                                                    m: MirUnit,
                                                    scope: MirFunctionVerifyScope) {
        var aggregate_id = scope.value_mark + 1;
        while (aggregate_id <= m.value_count) {
            self.focus_value(m, aggregate_id);
            if (m.value_function(aggregate_id) == scope.function_id
                && m.value_kind(aggregate_id) == mir_value_aggregate()
                && self.strict_type_kind(m, m.value_type(aggregate_id)) == ty_CLASS()) {
                var arg = m.value_first_arg(aggregate_id);
                var arg_index: i32 = 0;
                while (arg != mir_id_invalid()) {
                    let field_id = m.value_aggregate_field(arg);
                    if (field_id == mir_id_invalid()) {
                        self.record_strict(mv_strict_cat_text(),
                                           "aggregate value #" + self.id_text(aggregate_id)
                                           + " arg " + self.id_text(arg_index)
                                           + " has no FieldId (would fall back to positional/name guessing)");
                    } else if (field_id >= 1 && field_id <= m.field_count) {
                        self.strict_report_type_relation(m,
                                                         mv_strict_cat_layout(),
                                                         m.field_owner_type(field_id),
                                                         m.value_type(aggregate_id),
                                                         "aggregate value #" + self.id_text(aggregate_id)
                                                         + " arg " + self.id_text(arg_index)
                                                         + " (field " + m.field_name(field_id) + ") owner");
                    }
                    arg = m.value_next_arg(arg);
                    arg_index = arg_index + 1;
                }
            }
            aggregate_id = aggregate_id + 1;
        }
    }
}
