module bootstrap.mir_verify;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;

@[vis(world)]
impl bootstrap.mir_verify.MirVerifier {
    public fn strict_check_void_scope(self,
                                      m: MirUnit,
                                      scope: MirFunctionVerifyScope) {
        let return_type = m.function_return_type(scope.function_id);
        let return_kind = self.strict_type_kind(m, return_type);
        let return_text = hir_type_table_text(m.types, return_type);
        if (return_text == "void" && return_kind != ty_VOID()) {
            self.record_strict(mv_strict_cat_text(),
                               "function #" + self.id_text(scope.function_id) + " ("
                               + m.function_name(scope.function_id) + ") return TypeId #"
                               + self.id_text(return_type) + " prints as void but kind is "
                               + self.id_text(return_kind) + " (void decided by text, not TypeId)");
        }
        if (return_kind == ty_VOID() && return_text != "void") {
            self.record_strict(mv_strict_cat_text(),
                               "function #" + self.id_text(scope.function_id) + " ("
                               + m.function_name(scope.function_id) + ") return TypeId #"
                               + self.id_text(return_type) + " has void kind but text `"
                               + return_text + "`");
        }
        var block_id = scope.block_mark + 1;
        while (block_id <= m.block_count) {
            self.focus_block(m, block_id);
            if (!m.block_is_removed( block_id)
                && m.block_function(block_id) == scope.function_id
                && m.block_term_kind(block_id) == mir_term_return()) {
                let term_value = m.block_term_value(block_id);
                if (term_value == mir_id_invalid() && return_kind != ty_VOID()) {
                    self.record_strict(mv_strict_cat_text(),
                                       "block #" + self.id_text(block_id)
                                       + " returns empty value but function #"
                                       + self.id_text(scope.function_id) + " ("
                                       + m.function_name(scope.function_id)
                                       + ") return kind is " + self.id_text(return_kind)
                                       + " not void");
                }
                if (term_value != mir_id_invalid() && return_kind == ty_VOID()) {
                    self.record_strict(mv_strict_cat_text(),
                                       "block #" + self.id_text(block_id)
                                       + " returns value #" + self.id_text(term_value)
                                       + " but function #" + self.id_text(scope.function_id)
                                       + " (" + m.function_name(scope.function_id)
                                       + ") is void by TypeId");
                }
            }
            block_id = block_id + 1;
        }
    }
}
