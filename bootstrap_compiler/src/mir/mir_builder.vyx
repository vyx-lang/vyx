}
fn mir_builder_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn mir_builder_c_string_equals(ptr: rawptr, len: i64, value: string) -> bool {
    if (ptr == null || len != value.len) { return false; }
    if (len == 0) { return value.len == 0; }
    return strncmp(ptr, value.c_str(), len) == 0;
}

fn mir_builder_env_enabled(name: string) -> bool {
    let value = mir_builder_env_value(name).trim();
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE"
        || value == "no" || value == "NO" || value == "off" || value == "OFF") {
        return false;
    }
    return true;
}

fn mir_builder_parse_i64(text: string) -> i64 {
    let s = text.trim();
    if (s.len == 0) { return 0; }
    var i: i32 = 0;
    var sign: i64 = 1;
    var out: i64 = 0;
    if (s.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (s.charAt(0) == 43) {
        i = 1;
    }
    while (i < s.len) {
        let c = s.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

fn mir_builder_slow_body_threshold_ms() -> i64 {
    let parsed = mir_builder_parse_i64(mir_builder_env_value("VYX_MIR_BODY_SLOW_MS"));
    if (parsed > 0) { return parsed; }
    return 1000;
}

var g_mir_profile_malloc_bytes: i64 = 0;
var g_mir_profile_malloc_next: i64 = 67108864;
// Count of MIR function shells created after the initial function-table sync
// (late generic instantiations discovered during streaming materialization).
var g_mir_streaming_new_shells: i64 = 0;

public fn mir_builder_streaming_new_shells() -> i64 {
    return g_mir_streaming_new_shells;
}

fn mir_profile_malloc(size: u64) -> rawptr {
    let p = malloc(size);
    if (p != null && vyx_bootstrap_profile_level() > 0) {
        g_mir_profile_malloc_bytes = g_mir_profile_malloc_bytes + (size as i64);
        while (g_mir_profile_malloc_bytes >= g_mir_profile_malloc_next) {
            print("[mir-malloc] bytes=" + policy_i64_to_string(g_mir_profile_malloc_bytes));
            g_mir_profile_malloc_next = g_mir_profile_malloc_next + 67108864;
        }
    }
    return p;
}

fn mir_builder_string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    var i: i64 = 0;
    while (i + needle.len <= hay.len) {
        var j: i64 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt((i + j) as i32) != needle.charAt(j as i32)) { same = false; }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

fn mir_binop_operator_method_name(op: i32) -> string {
    if (op == tk_PLUS()) { return "operator+"; }
    if (op == tk_MINUS()) { return "operator-"; }
    if (op == tk_STAR()) { return "operator*"; }
    if (op == tk_SLASH()) { return "operator/"; }
    if (op == tk_PERCENT()) { return "operator%"; }
    if (op == tk_EQEQ()) { return "operator=="; }
    if (op == tk_NEQ()) { return "operator!="; }
    if (op == tk_LT()) { return "operator<"; }
    if (op == tk_GT()) { return "operator>"; }
    if (op == tk_LE()) { return "operator<="; }
    if (op == tk_GE()) { return "operator>="; }
    if (op == tk_AMP()) { return "operator&"; }
    if (op == tk_PIPE()) { return "operator|"; }
    if (op == tk_CARET()) { return "operator^"; }
    if (op == tk_LSHIFT()) { return "operator<<"; }
    if (op == tk_RSHIFT()) { return "operator>>"; }
    return "";
}

fn mir_unary_operator_method_name(op: i32) -> string {
    if (op == tk_MINUS()) { return "operator_neg"; }
    if (op == tk_NOT()) { return "operator_not"; }
    if (op == tk_TILDE()) { return "operator_bnot"; }
    return "";
}

fn mir_assign_operator_method_name(op: i32) -> string {
    if (op == tk_PLUSEQ()) { return "operator+="; }
    if (op == tk_MINUSEQ()) { return "operator-="; }
    if (op == tk_STAREQ()) { return "operator*="; }
    if (op == tk_SLASHEQ()) { return "operator/="; }
    if (op == tk_PERCENTEQ()) { return "operator%="; }
    if (op == tk_AMPEQ()) { return "operator&="; }
    if (op == tk_PIPEEQ()) { return "operator|="; }
    if (op == tk_CARETEQ()) { return "operator^="; }
    if (op == tk_LSHIFTEQ()) { return "operator<<="; }
    if (op == tk_RSHIFTEQ()) { return "operator>>="; }
    return "";
}

fn mir_primitive_method_binary_op(method_name: string) -> i32 {
    if (method_name == "operator_add" || method_name == "operator+") { return tk_PLUS(); }
    if (method_name == "operator_sub" || method_name == "operator-") { return tk_MINUS(); }
    if (method_name == "operator_mul" || method_name == "operator*") { return tk_STAR(); }
    if (method_name == "operator_div" || method_name == "operator/") { return tk_SLASH(); }
    if (method_name == "operator_mod" || method_name == "operator%") { return tk_PERCENT(); }
    if (method_name == "operator_eq" || method_name == "operator==") { return tk_EQEQ(); }
    if (method_name == "operator_ne" || method_name == "operator!=") { return tk_NEQ(); }
    if (method_name == "operator_lt" || method_name == "operator<") { return tk_LT(); }
    if (method_name == "operator_gt" || method_name == "operator>") { return tk_GT(); }
    if (method_name == "operator_le" || method_name == "operator<=") { return tk_LE(); }
    if (method_name == "operator_ge" || method_name == "operator>=") { return tk_GE(); }
    if (method_name == "operator_band" || method_name == "operator&") { return tk_AMP(); }
    if (method_name == "operator_bor" || method_name == "operator|") { return tk_PIPE(); }
    if (method_name == "operator_bxor" || method_name == "operator^") { return tk_CARET(); }
    if (method_name == "operator_shl" || method_name == "operator<<") { return tk_LSHIFT(); }
    if (method_name == "operator_shr" || method_name == "operator>>") { return tk_RSHIFT(); }
    if (method_name == "operator_add_assign" || method_name == "operator+=") { return tk_PLUS(); }
    if (method_name == "operator_sub_assign" || method_name == "operator-=") { return tk_MINUS(); }
    if (method_name == "operator_mul_assign" || method_name == "operator*=") { return tk_STAR(); }
    if (method_name == "operator_div_assign" || method_name == "operator/=") { return tk_SLASH(); }
    if (method_name == "operator_mod_assign" || method_name == "operator%=") { return tk_PERCENT(); }
    if (method_name == "operator_band_assign" || method_name == "operator&=") { return tk_AMP(); }
    if (method_name == "operator_bor_assign" || method_name == "operator|=") { return tk_PIPE(); }
    if (method_name == "operator_bxor_assign" || method_name == "operator^=") { return tk_CARET(); }
    if (method_name == "operator_shl_assign" || method_name == "operator<<=") { return tk_LSHIFT(); }
    if (method_name == "operator_shr_assign" || method_name == "operator>>=") { return tk_RSHIFT(); }
    return -1;
}

fn mir_primitive_method_unary_op(method_name: string) -> i32 {
    if (method_name == "operator_neg") { return tk_MINUS(); }
    if (method_name == "operator_not") { return tk_NOT(); }
    if (method_name == "operator_bnot") { return tk_TILDE(); }
    return -1;
}

fn mir_primitive_binary_returns_bool(op: i32) -> bool {
    return op == tk_EQEQ() || op == tk_NEQ()
        || op == tk_LT() || op == tk_GT()
        || op == tk_LE() || op == tk_GE();
}

fn mir_builder_method_marker_matches(function_name: string, marker: string) -> bool {
    if (function_name.len < marker.len) { return false; }
    var i: i64 = 0;
    while (i + marker.len <= function_name.len) {
        var j: i64 = 0;
        var same: bool = true;
        while (j < marker.len && same) {
            if (function_name.charAt((i + j) as i32) != marker.charAt(j as i32)) { same = false; }
            j = j + 1;
        }
        if (same) {
            let next_index = i + marker.len;
            if (next_index >= function_name.len) { return true; }
            let next_ch = function_name.charAt(next_index as i32);
            if (next_ch == 58 || next_ch == 60) { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn mir_builder_symbol_segment_for_name(name: string) -> string {
    return policy_mangle_part(name);
}

fn mir_builder_last_path_segment(name: string) -> string {
    if (name.len == 0) { return ""; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { start = i + 1; }
        i = i + 1;
    }
    return name.substring(start, name.len);
}

fn mir_builder_is_primitive_str_name(name: string) -> bool {
    return name == "str" || name == "string" || name == "__String";
}

fn mir_builder_generic_param_canonical(raw: string) -> string {
    if (raw.len == 0) { return ""; }
    var i: i32 = 0;
    while (i < raw.len) {
        if (raw.charAt(i) == 94) {
            return raw.substring(0, i);
        }
        i = i + 1;
    }
    return raw;
}

fn mir_builder_index_of_from(hay: string, needle: string, start: i32) -> i32 {
    if (needle.len == 0) { return start; }
    if (hay.len < needle.len || start < 0) { return -1; }
    var i: i32 = start;
    while ((i as i64) + needle.len <= hay.len) {
        var j: i64 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt(i + (j as i32)) != needle.charAt(j as i32)) { same = false; }
            j = j + 1;
        }
        if (same) { return i; }
        i = i + 1;
    }
    return -1;
}

fn mir_builder_i32_text(value: i32) -> string {
    return policy_i64_to_string(value as i64);
}

fn mir_builder_memory_mb_text(bytes: i64) -> string {
    if (bytes < 0) { return "-1"; }
    return policy_i64_to_string(bytes / 1048576);
}

fn mir_builder_release_temp_strings(mark: rawptr) {
    vyx_rt_string_arena_release(mark);
}

fn mir_builder_mir2_method_segment(function_name: string) -> string {
    if (!function_name.startsWith("mir2$")) { return ""; }
    let marker = "_3A_3A";
    let first = mir_builder_index_of_from(function_name, marker, 5);
    if (first < 0) { return ""; }
    let method_start = first + (marker.len as i32);
    let second = mir_builder_index_of_from(function_name, marker, method_start);
    if (second <= method_start) { return ""; }
    return function_name.substring(method_start, second);
}

fn mir_builder_type_name_has_open_template_atom(name: string) -> bool {
    if (name.len == 0) { return false; }
    let args = policy_generic_call_args(name.clone());
    if (args.len > 0) {
        var i: i32 = 0;
        while (i < 64) {
            let arg = policy_generic_arg_at(args, i);
            if (arg.len == 0) { return false; }
            if (mir_builder_type_name_has_open_template_atom(arg)) { return true; }
            i = i + 1;
        }
        return false;
    }
    if (name == "Self") { return true; }
    if (name.len == 1) {
        let c = name.charAt(0);
        if (c >= 65 && c <= 90) { return true; }
    }
    return false;
}

public class MirNameIdMap {
    public head: rawptr

    public static fn create() -> MirNameIdMap {
        return MirNameIdMap { head: null };
    }

    public fn put(self, key: string, value: i32) {
        if (key.len == 0 || value == mir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (mir_builder_c_string_equals(ptr, len, key)) {
                ast_write_i32(ptr_offset(cur, 16), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        let node = mir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), self.head);
        self.head = node;
    }

    public fn get(self, key: string) -> i32 {
        if (key.len == 0) { return mir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (mir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return mir_id_invalid();
    }
}

public class MirPairIdMap {
    public head: rawptr

    public static fn create() -> MirPairIdMap {
        return MirPairIdMap { head: null };
    }

    public fn key_matches(self, node: rawptr, owner: string, member: string) -> bool {
        if (node == null || owner.len == 0 || member.len == 0) { return false; }
        let owner_ptr = ast_read_rawptr(node);
        let owner_len = ast_read_i64(ptr_offset(node, 8));
        if (!mir_builder_c_string_equals(owner_ptr, owner_len, owner)) { return false; }
        let member_ptr = ast_read_rawptr(ptr_offset(node, 16));
        let member_len = ast_read_i64(ptr_offset(node, 24));
        return mir_builder_c_string_equals(member_ptr, member_len, member);
    }

    public fn put(self, owner: string, member: string, value: i32) {
        if (owner.len == 0 || member.len == 0 || value == mir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            if (self.key_matches(cur, owner, member)) {
                ast_write_i32(ptr_offset(cur, 32), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        let node = mir_profile_malloc(48);
        if (node == null) { return; }
        memset(node, 0, 48);
        ast_write_rawptr(node, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(node, 8), owner.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(node, 24), member.len);
        ast_write_i32(ptr_offset(node, 32), value);
        ast_write_rawptr(ptr_offset(node, 40), self.head);
        self.head = node;
    }

    public fn get(self, owner: string, member: string) -> i32 {
        if (owner.len == 0 || member.len == 0) { return mir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            if (self.key_matches(cur, owner, member)) {
                return ast_read_i32(ptr_offset(cur, 32));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return mir_id_invalid();
    }
}

public class MirIntPairIdMap {
    public head: rawptr

    public static fn create() -> MirIntPairIdMap {
        return MirIntPairIdMap { head: null };
    }

    public fn put(self, lhs: i32, rhs: i32, value: i32) {
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid() || value == 0) { return; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == lhs && ast_read_i32(ptr_offset(cur, 4)) == rhs) {
                ast_write_i32(ptr_offset(cur, 8), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        let node = mir_profile_malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_i32(node, lhs);
        ast_write_i32(ptr_offset(node, 4), rhs);
        ast_write_i32(ptr_offset(node, 8), value);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        self.head = node;
    }

    public fn get(self, lhs: i32, rhs: i32) -> i32 {
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return 0; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == lhs && ast_read_i32(ptr_offset(cur, 4)) == rhs) {
                return ast_read_i32(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return 0;
    }
}

fn mir_name_id_map_put(map: MirNameIdMap, key: string, value: i32) -> MirNameIdMap {
    if (key.len == 0 || value == mir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (mir_builder_c_string_equals(ptr, len, key)) {
            ast_write_i32(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = mir_profile_malloc(32);
    if (node == null) { return map; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    map.head = node;
    return map;
}

fn mir_name_id_map_get(map: MirNameIdMap, key: string) -> i32 {
    if (key.len == 0) { return mir_id_invalid(); }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (mir_builder_c_string_equals(ptr, len, key)) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return mir_id_invalid();
}

fn mir_pair_id_map_key_matches(node: rawptr, owner: string, member: string) -> bool {
    if (node == null || owner.len == 0 || member.len == 0) { return false; }
    let owner_ptr = ast_read_rawptr(node);
    let owner_len = ast_read_i64(ptr_offset(node, 8));
    if (!mir_builder_c_string_equals(owner_ptr, owner_len, owner)) { return false; }
    let member_ptr = ast_read_rawptr(ptr_offset(node, 16));
    let member_len = ast_read_i64(ptr_offset(node, 24));
    return mir_builder_c_string_equals(member_ptr, member_len, member);
}

fn mir_pair_id_map_put(map: MirPairIdMap, owner: string, member: string, value: i32) -> MirPairIdMap {
    if (owner.len == 0 || member.len == 0 || value == mir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        if (mir_pair_id_map_key_matches(cur, owner, member)) {
            ast_write_i32(ptr_offset(cur, 32), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    let node = mir_profile_malloc(48);
    if (node == null) { return map; }
    memset(node, 0, 48);
    ast_write_rawptr(node, ast_dup_c_string(owner));
    ast_write_i64(ptr_offset(node, 8), owner.len);
    ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
    ast_write_i64(ptr_offset(node, 24), member.len);
    ast_write_i32(ptr_offset(node, 32), value);
    ast_write_rawptr(ptr_offset(node, 40), map.head);
    map.head = node;
    return map;
}

fn mir_pair_id_map_get(map: MirPairIdMap, owner: string, member: string) -> i32 {
    if (owner.len == 0 || member.len == 0) { return mir_id_invalid(); }
    var cur = map.head;
    while (cur != null) {
        if (mir_pair_id_map_key_matches(cur, owner, member)) {
            return ast_read_i32(ptr_offset(cur, 32));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    return mir_id_invalid();
}

fn mir_int_pair_id_map_put(map: MirIntPairIdMap, lhs: i32, rhs: i32, value: i32) -> MirIntPairIdMap {
    map.put(lhs, rhs, value);
    return map;
}

fn mir_int_pair_id_map_get(map: MirIntPairIdMap, lhs: i32, rhs: i32) -> i32 {
    return map.get(lhs, rhs);
}

fn mir_name_id_map_dispose(map: MirNameIdMap) -> MirNameIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_pair_id_map_dispose(map: MirPairIdMap) -> MirPairIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 40));
        let owner_ptr = ast_read_rawptr(cur);
        let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        if (owner_ptr != null) { free(owner_ptr); }
        if (member_ptr != null) { free(member_ptr); }
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_int_pair_id_map_dispose(map: MirIntPairIdMap) -> MirIntPairIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 16));
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn mir_i32_map_alloc(count: i32) -> rawptr {
    var n = count;
    if (n < 1) { n = 1; }
    if (n < 262144) { n = 262144; }
    let bytes = ((n + 1) * 4) as u64;
    let p = mir_profile_malloc(bytes);
    if (p != null) { memset(p, 0, bytes); }
    return p;
}

fn mir_i32_map_get(map: rawptr, id: i32) -> i32 {
    if (map == null || id <= 0) { return mir_id_invalid(); }
    return ast_read_i32(ptr_offset(map, id * 4));
}

fn mir_i32_map_put(map: rawptr, id: i32, value: i32) {
    if (map == null || id <= 0) { return; }
    ast_write_i32(ptr_offset(map, id * 4), value);
}

fn mir_i32_map_clear_for_count(map: rawptr, count: i32) -> rawptr {
    if (map == null) { return mir_i32_map_alloc(count); }
    var n = count;
    if (n < 1) { n = 1; }
    if (n < 262144) {
        let bytes = ((262145) * 4) as u64;
        memset(map, 0, bytes);
        return map;
    }
    free(map);
    return mir_i32_map_alloc(count);
}

fn mir_i32_map_dispose(map: rawptr) -> rawptr {
    if (map != null) { free(map); }
    return null;
}

public class MirStaticInitializer {
    public ok: bool
    public kind: i32
    public target_kind: i32
    public target_id: i32
    public int_value: i64
    public text: string

    public static fn invalid() -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: false,
            kind: mir_static_init_none(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: ""
        };
    }

    /// Named `of_int` (not `int_value`) because the host sema resolves a
    /// `Class.name(...)` static call against the same-named field first.
    public static fn of_int(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_int(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn bool_value(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_bool(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn char_value(value: i64) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_char(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: value,
            text: ""
        };
    }

    public static fn str_value(value: string) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_str(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: value
        };
    }

    public static fn null_value() -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_null(),
            target_kind: mir_target_none(),
            target_id: mir_id_invalid(),
            int_value: 0,
            text: ""
        };
    }

    public static fn item_ref(item_id: i32) -> MirStaticInitializer {
        return MirStaticInitializer {
            ok: true,
            kind: mir_static_init_item_ref(),
            target_kind: mir_target_hir_item(),
            target_id: item_id,
            int_value: 0,
            text: ""
        };
    }
}

public class MirUnitBuilder {
    public h: HirUnit
    public hir_codegen_builder: rawptr
    public has_hir_codegen_builder: bool
    public hir_codegen_error_count: i32
    public unit: MirUnit
    public function_map: rawptr
    public reachable_function_map: rawptr
    public lowered_function_map: rawptr
    // HIR body provenance can become available only after another live body
    // registers a nested closed instance.  Keep that retry state in the
    // shared builder, rather than making either MIR consumer guess at a
    // backend-specific fallback.
    public deferred_materialization_map: rawptr
    public local_map: rawptr
    public place_map: rawptr
    public hir_open_template_cache: rawptr
    public name_function_index: MirNameIdMap
    public name_hir_function_index: MirNameIdMap
    public owner_method_function_index: MirPairIdMap
    public owner_method_hir_function_index: MirPairIdMap
    public field_name_index: MirPairIdMap
    public field_ordinal_index: MirPairIdMap
    public type_equivalence_index: MirIntPairIdMap
    public registered_type_atom_index: MirNameIdMap
    public type_text_id_index: MirNameIdMap
    public layout_type_index: MirNameIdMap
    public layout_type_id_map: rawptr
    public layout_materialized_type_id_map: rawptr
    public layout_owner_type_item_map: rawptr
    public field_owner_first_map: rawptr
    public field_owner_next_map: rawptr
    public variant_owner_first_map: rawptr
    public variant_owner_next_map: rawptr
    public field_owner_done_map: rawptr
    public variant_owner_done_map: rawptr
    public layout_item_count: i32
    public layout_owner_item_count: i32
    public type_open_template_cache: rawptr
    public indexed_hir_function_next: i32
    public indexed_type_atom_item_next: i32
    public indexed_type_text_next: i32
    public function_table_scan_next: i32
    public reachable_function_queue_head: rawptr
    public reachable_function_queue_tail: rawptr
    public current_function_id: i32
    public current_hir_function_id: i32
    public current_block_id: i32
    public break_target_block_id: i32
    public continue_target_block_id: i32
    public drop_stack_head: rawptr
    public defer_stack_head: rawptr
    // Source let/var storage is tracked independently from auto-drop state:
    // scalar locals need a lifetime boundary too, while temporary/drop-only
    // locals intentionally remain outside this lexical stack.
    public storage_stack_head: rawptr
    public break_drop_mark: rawptr
    public continue_drop_mark: rawptr
    public break_defer_mark: rawptr
    public continue_defer_mark: rawptr
    public break_storage_mark: rawptr
    public continue_storage_mark: rawptr
    public labeled_loop_head: rawptr
    public expected_expr_type_id: i32
    public static_item_scan_next: i32
    public field_item_scan_next: i32
    public variant_item_scan_next: i32
    public partition_codegen_roots: bool
    public emit_root_names: string
    public emit_root_names_specified: bool
    public dci_lifecycle_root: rawptr
    public dci_lifecycle_skip: bool
    // Lexical `unsafe { ... }` nesting depth.  While > 0, deref/index places
    // are created with the unchecked check-policy so backends skip the
    // checked-address audit for them.
    public unsafe_depth: i32
    public async_await_index: i32
    public async_pc_place_id: i32

    public static fn create(h: HirUnit) -> MirUnitBuilder {
        let mir_unit = MirUnit.create(h.types);
        mir_unit.set_reflection_manifest( hir_unit_reflection_manifest(h));
        mir_unit.set_reflection_name_map( hir_unit_reflection_name_map(h));
        mir_unit.set_foreign_cpp_includes( hir_unit_foreign_cpp_includes(h));
        mir_unit.set_dci_stub_specs( hir_unit_dci_stub_specs(h));
        mir_unit.set_interface_supers( hir_unit_interface_supers(h));
        var type_cache_cap: i32 = h.types.count;
        type_cache_cap = type_cache_cap + 1;
        return MirUnitBuilder {
            h: h,
            hir_codegen_builder: null,
            has_hir_codegen_builder: false,
            hir_codegen_error_count: 0,
            unit: mir_unit,
            function_map: mir_i32_map_alloc(h.function_count + 1),
            reachable_function_map: mir_i32_map_alloc(h.function_count + 1),
            lowered_function_map: mir_i32_map_alloc(h.function_count + 1),
            deferred_materialization_map: mir_i32_map_alloc(h.function_count + 1),
            local_map: mir_i32_map_alloc(h.local_count + 1),
            place_map: mir_i32_map_alloc(h.local_count + 1),
            hir_open_template_cache: mir_i32_map_alloc(h.function_count + 1),
            name_function_index: MirNameIdMap.create(),
            name_hir_function_index: MirNameIdMap.create(),
            owner_method_function_index: MirPairIdMap.create(),
            owner_method_hir_function_index: MirPairIdMap.create(),
            field_name_index: MirPairIdMap.create(),
            field_ordinal_index: MirPairIdMap.create(),
            type_equivalence_index: MirIntPairIdMap.create(),
            registered_type_atom_index: MirNameIdMap.create(),
            type_text_id_index: MirNameIdMap.create(),
            layout_type_index: MirNameIdMap.create(),
            layout_type_id_map: mir_i32_map_alloc(type_cache_cap),
            layout_materialized_type_id_map: mir_i32_map_alloc(type_cache_cap),
            layout_owner_type_item_map: mir_i32_map_alloc(type_cache_cap),
            field_owner_first_map: mir_i32_map_alloc(h.item_count + 1),
            field_owner_next_map: mir_i32_map_alloc(h.item_count + 1),
            variant_owner_first_map: mir_i32_map_alloc(h.item_count + 1),
            variant_owner_next_map: mir_i32_map_alloc(h.item_count + 1),
            field_owner_done_map: mir_i32_map_alloc(h.item_count + 1),
            variant_owner_done_map: mir_i32_map_alloc(h.item_count + 1),
            layout_item_count: 0,
            layout_owner_item_count: 0,
            type_open_template_cache: mir_i32_map_alloc(type_cache_cap),
            indexed_hir_function_next: 1,
            indexed_type_atom_item_next: 1,
            indexed_type_text_next: 1,
            function_table_scan_next: 1,
            reachable_function_queue_head: null,
            reachable_function_queue_tail: null,
            current_function_id: mir_id_invalid(),
            current_hir_function_id: hir_id_invalid(),
            current_block_id: mir_id_invalid(),
            break_target_block_id: mir_id_invalid(),
            continue_target_block_id: mir_id_invalid(),
            drop_stack_head: null,
            defer_stack_head: null,
            storage_stack_head: null,
            break_drop_mark: null,
            continue_drop_mark: null,
            break_defer_mark: null,
            continue_defer_mark: null,
            break_storage_mark: null,
            continue_storage_mark: null,
            labeled_loop_head: null,
            expected_expr_type_id: hir_id_invalid(),
            static_item_scan_next: 1,
            field_item_scan_next: 1,
            variant_item_scan_next: 1,
            partition_codegen_roots: false,
            emit_root_names: "",
            emit_root_names_specified: false,
            dci_lifecycle_root: null,
            dci_lifecycle_skip: false,
            unsafe_depth: 0,
            async_await_index: 0,
            async_pc_place_id: mir_id_invalid()
        };
    }

    public static fn create_for_codegen(builder: rawptr) -> MirUnitBuilder {
        var out = MirUnitBuilder.create(hir_codegen_builder_handle_unit(builder));
        out.hir_codegen_builder = builder;
        out.has_hir_codegen_builder = true;
        out.hir_codegen_error_count = 0;
        return out;
    }

    public fn type_text(self, type_id: i32) -> string {
        if (type_id == hir_id_invalid()) { return ""; }
        return hir_type_table_text(self.h.types, type_id);
    }

    // A partially materialized peer HIR can leave a chained call's expression
    // type as `void` even though its selected method has a concrete return
    // type.  Member-call recovery must use that callable return type as the
    // receiver type, otherwise the next link in `a.f().g()` is treated as a
    // builtin and lowers with a void result.
    public fn member_receiver_type_text(self, receiver_expr_id: i32) -> string {
        if (receiver_expr_id == hir_id_invalid()) { return ""; }
        let raw_type_id = self.h.expr_type(receiver_expr_id);
        var raw_text = self.resolve_type_text_in_function(self.current_function_id,
                                                          self.type_text(raw_type_id));
        if (raw_text.len > 0 && raw_text != "void" && raw_text != "rawptr") { return raw_text; }
        if (self.h.expr_kind(receiver_expr_id) == ex_CALL()) {
            var return_type_id = hir_id_invalid();
            if (self.h.expr_target_kind(receiver_expr_id) == hir_target_function()) {
                let hir_fn = self.h.expr_target_id(receiver_expr_id);
                if (hir_fn != hir_id_invalid()) {
                    return_type_id = self.h.function_return_type(hir_fn);
                }
                if (return_type_id == hir_id_invalid()) {
                    let mir_fn = self.target_id_from_hir_expr(receiver_expr_id);
                    if (mir_fn != mir_id_invalid()) {
                        return_type_id = self.unit.function_return_type(mir_fn);
                    }
                }
            }
            // The previous chain link may itself have been left unresolved in
            // the peer HIR. Recover that method shell by its already-known
            // receiver type/name and use the shell's concrete return type.
            if (return_type_id == hir_id_invalid()) {
                let previous_callee = self.h.expr_lhs(receiver_expr_id);
                if (previous_callee != hir_id_invalid()
                    && self.h.expr_kind(previous_callee) == ex_MEMBER()) {
                    let previous_owner = self.h.expr_lhs(previous_callee);
                    let previous_owner_type = self.member_receiver_type_text(previous_owner);
                    var previous_name = self.h.expr_name(previous_callee);
                    if (previous_name.len == 0) {
                        previous_name = self.h.expr_value_text(previous_callee);
                    }
                    if (previous_owner_type.len > 0 && previous_name.len > 0) {
                        let previous_target = self.imported_method_target_by_owner_type_and_call(
                            previous_owner_type,
                            previous_name,
                            receiver_expr_id,
                            false);
                        if (previous_target != mir_id_invalid()) {
                            return_type_id = self.unit.function_return_type(previous_target);
                        }
                    }
                    if (return_type_id == hir_id_invalid() && previous_name.len > 0) {
                        let previous_target_any = self.imported_method_target_by_name_and_call(
                            previous_name,
                            receiver_expr_id);
                        if (previous_target_any != mir_id_invalid()) {
                            return_type_id = self.unit.function_return_type(previous_target_any);
                        }
                    }
                }
            }
            if (return_type_id != hir_id_invalid()) {
                let return_text = self.resolve_type_text_in_function(self.current_function_id,
                                                                     self.type_text(return_type_id));
                if (return_text.len > 0 && return_text != "void") { return return_text; }
            }
        }
        return raw_text;
    }

    public fn diagnostic_loc_for_hir_function(self, hir_function_id: i32) -> rawptr {
        if (hir_function_id >= 1 && hir_function_id <= self.h.function_count) {
            let body = self.h.function_body(hir_function_id);
            if (body >= 1 && body <= self.h.stmt_count) {
                let loc = hir_unit_stmt_loc_ptr(self.h, body);
                if (loc != null && ast_read_i32(loc) > 0) { return loc; }
            }
        }
        let mir_loc = mir_unit_diag_loc_for_function(&self.unit, self.current_function_id);
        if (mir_loc != null) { return mir_loc; }
        return mir_unit_diag_first_loc(&self.unit);
    }

    public fn report_error_at_hir_function(self, hir_function_id: i32, message: string) {
        diag_emit_codegen_at(self.diagnostic_loc_for_hir_function(hir_function_id),
                             "MIR builder failed: " + message);
    }

    public fn report_error(self, message: string) {
        self.report_error_at_hir_function(self.current_hir_function_id, message);
    }

    public fn sync_from_hir(self, h: HirUnit) {
        let profile_level = vyx_bootstrap_profile_level();
        if (profile_level > 1) { print("[mir-build] sync-from-hir-enter"); }
        self.h = h;
        self.unit.types = self.h.types;
        self.unit.set_reflection_manifest( hir_unit_reflection_manifest(self.h));
        self.unit.set_reflection_name_map( hir_unit_reflection_name_map(self.h));
        self.unit.set_foreign_cpp_includes( hir_unit_foreign_cpp_includes(self.h));
        self.unit.set_dci_stub_specs( hir_unit_dci_stub_specs(self.h));
        self.unit.set_interface_supers( hir_unit_interface_supers(self.h));
        if (profile_level > 1) { print("[mir-build] sync-static-enter"); }
        self.build_static_items();
        if (profile_level > 1) { print("[mir-build] sync-function-table-enter"); }
        self.build_function_table();
        if (profile_level > 1) { print("[mir-build] sync-layouts-enter"); }
        if (!self.has_hir_codegen_builder) {
            self.build_field_layouts();
            self.build_variant_layouts();
        }
        if (profile_level > 1) { print("[mir-build] sync-from-hir-leave"); }
    }

    public fn refresh_from_codegen_builder(self) {
        if (!self.has_hir_codegen_builder) { return; }
        let before_items = self.h.item_count;
        let before_types = self.h.types.count;
        self.sync_from_hir(hir_codegen_builder_handle_unit(self.hir_codegen_builder));
        if (self.h.item_count != before_items || self.h.types.count != before_types) {
            self.reset_layout_indexes_for_current_hir();
        }
    }

    public fn refresh_hir_view_from_codegen_builder(self) {
        if (!self.has_hir_codegen_builder) { return; }
        self.h = hir_codegen_builder_handle_unit(self.hir_codegen_builder);
        self.unit.types = self.h.types;
        self.unit.set_reflection_manifest( hir_unit_reflection_manifest(self.h));
        self.unit.set_reflection_name_map( hir_unit_reflection_name_map(self.h));
        self.unit.set_foreign_cpp_includes( hir_unit_foreign_cpp_includes(self.h));
        self.unit.set_dci_stub_specs( hir_unit_dci_stub_specs(self.h));
        self.unit.set_interface_supers( hir_unit_interface_supers(self.h));
    }

    public fn clear_codegen_local_maps_after_mark(self, local_mark: i32) {
        var local_id = local_mark + 1;
        while (local_id <= self.h.local_count) {
            mir_i32_map_put(self.local_map, local_id, mir_id_invalid());
            mir_i32_map_put(self.place_map, local_id, mir_id_invalid());
            local_id = local_id + 1;
        }
    }

    public fn cleanup_hir_codegen_scope(self, hir_function_id: i32, stmt_mark: i32, expr_mark: i32, local_mark: i32) {
        if (!self.has_hir_codegen_builder) { return; }
        self.clear_codegen_local_maps_after_mark(local_mark);
        hir_codegen_builder_handle_finish_function_codegen(self.hir_codegen_builder,
                                                           hir_function_id,
                                                           stmt_mark,
                                                           expr_mark,
                                                           local_mark);
        self.refresh_hir_view_from_codegen_builder();
        if (hir_function_id > 0 && (hir_function_id % 64) == 0) {
            vyx_rt_heap_trim();
        }
    }

    public fn resolve_new_hir_codegen_facts(self) -> bool {
        if (!self.has_hir_codegen_builder) { return true; }
        var hunit = hir_codegen_builder_handle_unit(self.hir_codegen_builder);
        let resolve_left = hir_semantic_resolve_unit_silent(hunit);
        if (resolve_left > 0) {
            self.hir_codegen_error_count = self.hir_codegen_error_count + resolve_left;
            self.report_error("HIR materialization left "
                              + policy_i64_to_string(resolve_left as i64)
                              + " unresolved semantic targets");
            hir_codegen_builder_handle_set_unit(self.hir_codegen_builder, hunit);
            self.refresh_from_codegen_builder();
            return false;
        }
        let ownership_errors = hir_ownership_resolve_unit_silent(hunit);
        if (ownership_errors > 0) {
            self.hir_codegen_error_count = self.hir_codegen_error_count + ownership_errors;
            self.report_error("HIR materialization produced "
                              + policy_i64_to_string(ownership_errors as i64)
                              + " ownership errors");
            hir_codegen_builder_handle_set_unit(self.hir_codegen_builder, hunit);
            self.refresh_from_codegen_builder();
            return false;
        }
        hir_codegen_builder_handle_set_unit(self.hir_codegen_builder, hunit);
        self.refresh_from_codegen_builder();
        return true;
    }

    fn bind_dci_lifecycle_after_materialize(self, hunit: HirUnit, hir_function_id: i32) -> i32 {
        if (self.dci_lifecycle_skip) { return 0; }
        if (!mir_unit_has_dci_abi(&self.unit)) {
            self.dci_lifecycle_skip = true;
            return 0;
        }
        if (self.dci_lifecycle_root == null) {
            let path = mir_unit_dci_abi_path(&self.unit);
            if (dci_path_list_count(path.clone()) > 0) {
                let loaded = dci_load_contract_bundle(path.clone());
                if (loaded.roots == null) {
                    var detail = loaded.message;
                    if (detail.len == 0) { detail = "unknown DCIB error"; }
                    self.report_error_at_hir_function(hir_function_id,
                                                      "invalid DCI ABI contract: " + detail);
                    return 1;
                }
                self.dci_lifecycle_root = loaded.roots;
            } else {
                let text = mir_unit_dci_abi_text(&self.unit);
                if (text.len == 0) {
                    self.dci_lifecycle_skip = true;
                    return 0;
                }
                let parsed = cJSON_Parse(text.c_str());
                if (parsed == null) {
                    self.report_error_at_hir_function(hir_function_id, "invalid DCI ABI JSON");
                    return 1;
                }
                let bundle = cJSON_CreateArray();
                if (bundle == null || cJSON_AddItemToArray(bundle, parsed) == 0) {
                    if (bundle != null) { cJSON_Delete(bundle); }
                    else { cJSON_Delete(parsed); }
                    self.report_error_at_hir_function(hir_function_id,
                                                      "out of memory while loading DCI ABI JSON");
                    return 1;
                }
                self.dci_lifecycle_root = bundle;
            }
        }
        var errors: i32 = 0;
        var i: i32 = 0;
        let n = dci_bundle_count(self.dci_lifecycle_root);
        while (i < n) {
            let root = dci_bundle_root_at(self.dci_lifecycle_root, i);
            if (!dci_lifecycle_binding_is_declaration(root)) {
                errors = errors + hir_bind_dci_lifecycle_contract_root_borrowed(hunit, root);
            }
            i = i + 1;
        }
        return errors;
    }

    public fn ensure_hir_function_body_for_codegen(self, hir_function_id: i32, stmt_mark: i32, expr_mark: i32) -> bool {
        if (hir_function_id == hir_id_invalid()) { return false; }
        if (self.hir_function_has_executable_body(hir_function_id)) { return true; }
        if (!self.has_hir_codegen_builder) { return false; }
        let timing_enabled = mir_builder_env_enabled("VYX_MIR_BODY_TIMING");
        var timing_total_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_materialize_ms: i64 = 0;
        var timing_refresh_1_ms: i64 = 0;
        var timing_prepare_ms: i64 = 0;
        var timing_refresh_2_ms: i64 = 0;
        var timing_ownership_ms: i64 = 0;
        var timing_set_ms: i64 = 0;
        var timing_refresh_3_ms: i64 = 0;
        if (timing_enabled) {
            timing_total_start = vyx_bootstrap_now_ms();
            timing_mark = timing_total_start;
        }
        let materialized = hir_codegen_builder_handle_materialize_function_body(self.hir_codegen_builder, hir_function_id);
        if (timing_enabled) {
            let now_materialize = vyx_bootstrap_now_ms();
            timing_materialize_ms = now_materialize - timing_mark;
            timing_mark = now_materialize;
        }
        self.refresh_from_codegen_builder();
        if (timing_enabled) {
            let now_refresh_1 = vyx_bootstrap_now_ms();
            timing_refresh_1_ms = now_refresh_1 - timing_mark;
            timing_mark = now_refresh_1;
        }
        if (!materialized || self.h.function_body(hir_function_id) == hir_id_invalid()) {
            return self.hir_function_has_executable_body(hir_function_id);
        }
        hir_codegen_builder_handle_prepare_materialized_facts(self.hir_codegen_builder, hir_function_id);
        if (timing_enabled) {
            let now_prepare = vyx_bootstrap_now_ms();
            timing_prepare_ms = now_prepare - timing_mark;
            timing_mark = now_prepare;
        }
        self.refresh_hir_view_from_codegen_builder();
        if (timing_enabled) {
            let now_refresh_2 = vyx_bootstrap_now_ms();
            timing_refresh_2_ms = now_refresh_2 - timing_mark;
            timing_mark = now_refresh_2;
        }
        var hunit = self.h;
        let lifecycle_errors = self.bind_dci_lifecycle_after_materialize(hunit, hir_function_id);
        if (lifecycle_errors > 0) {
            self.hir_codegen_error_count = self.hir_codegen_error_count + lifecycle_errors;
            self.report_error_at_hir_function(
                hir_function_id,
                "HIR materialization produced "
                + policy_i64_to_string(lifecycle_errors as i64)
                + " DCI lifecycle errors");
            hir_codegen_builder_handle_set_unit(self.hir_codegen_builder, hunit);
            self.refresh_from_codegen_builder();
            return false;
        }
        let ownership_errors = hir_ownership_resolve_unit_range_silent(hunit,
                                                                       expr_mark,
                                                                       stmt_mark);
        if (timing_enabled) {
            let now_ownership = vyx_bootstrap_now_ms();
            timing_ownership_ms = now_ownership - timing_mark;
            timing_mark = now_ownership;
        }
        hir_codegen_builder_handle_set_unit(self.hir_codegen_builder, hunit);
        if (timing_enabled) {
            let now_set = vyx_bootstrap_now_ms();
            timing_set_ms = now_set - timing_mark;
            timing_mark = now_set;
        }
        if (ownership_errors > 0) {
            self.hir_codegen_error_count = self.hir_codegen_error_count + ownership_errors;
            self.refresh_from_codegen_builder();
            return false;
        }
        self.refresh_from_codegen_builder();
        if (timing_enabled) {
            let now_refresh_3 = vyx_bootstrap_now_ms();
            timing_refresh_3_ms = now_refresh_3 - timing_mark;
            let timing_total = now_refresh_3 - timing_total_start;
            if (timing_total >= mir_builder_slow_body_threshold_ms()) {
                print("[mir-hir-materialize-timing] fn=" + self.h.function_name(hir_function_id)
                      + " hir=" + mir_builder_i32_text(hir_function_id)
                      + " total=" + policy_i64_to_string(timing_total)
                      + " materialize=" + policy_i64_to_string(timing_materialize_ms)
                      + " refresh1=" + policy_i64_to_string(timing_refresh_1_ms)
                      + " prepare=" + policy_i64_to_string(timing_prepare_ms)
                      + " refresh2=" + policy_i64_to_string(timing_refresh_2_ms)
                      + " ownership=" + policy_i64_to_string(timing_ownership_ms)
                      + " set=" + policy_i64_to_string(timing_set_ms)
                      + " refresh3=" + policy_i64_to_string(timing_refresh_3_ms)
                      + " hlocals=" + mir_builder_i32_text(self.h.local_count)
                      + " hstmts=" + mir_builder_i32_text(self.h.stmt_count)
                      + " hexprs=" + mir_builder_i32_text(self.h.expr_count));
            }
        }
        return self.hir_function_has_executable_body(hir_function_id);
    }

    public fn type_text_equivalent_at_depth(self, lhs: string, rhs: string, depth: i32) -> bool {
        if (lhs.len == 0 || rhs.len == 0 || depth > 64) { return false; }
        if (lhs == rhs) { return true; }
        let left_has_args = policy_generic_call_has_args(lhs.clone()) != 0;
        let right_has_args = policy_generic_call_has_args(rhs.clone()) != 0;
        if (left_has_args != right_has_args) { return false; }
        if (!left_has_args) {
            return mir_builder_last_path_segment(lhs) == mir_builder_last_path_segment(rhs);
        }
        let left_base = policy_generic_call_base(lhs.clone());
        let right_base = policy_generic_call_base(rhs.clone());
        if (mir_builder_last_path_segment(left_base) != mir_builder_last_path_segment(right_base)) {
            return false;
        }
        let left_args = policy_generic_call_args(lhs.clone());
        let right_args = policy_generic_call_args(rhs.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let left_arg = policy_generic_arg_at(left_args, idx);
            let right_arg = policy_generic_arg_at(right_args, idx);
            if (left_arg.len == 0 || right_arg.len == 0) {
                return left_arg.len == 0 && right_arg.len == 0;
            }
            if (!self.type_text_equivalent_at_depth(left_arg, right_arg, depth + 1)) { return false; }
            idx = idx + 1;
        }
        return false;
    }

    public fn type_ids_equivalent(self, lhs: i32, rhs: i32) -> bool {
        if (lhs == rhs) { return true; }
        if (lhs == hir_id_invalid() || rhs == hir_id_invalid()) { return false; }
        let cached = mir_int_pair_id_map_get(self.type_equivalence_index,lhs, rhs);
        if (cached == 1) { return true; }
        let lhs_text = self.type_text(lhs);
        let rhs_text = self.type_text(rhs);
        if (lhs_text.len == 0 || rhs_text.len == 0) { return false; }
        let out = self.type_text_equivalent_at_depth(lhs_text, rhs_text, 0);
        if (out) {
            self.type_equivalence_index = mir_int_pair_id_map_put(self.type_equivalence_index,lhs, rhs, 1);
            self.type_equivalence_index = mir_int_pair_id_map_put(self.type_equivalence_index,rhs, lhs, 1);
        }
        return out;
    }

    public fn type_is_dyn_trait(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        if (hir_type_table_kind(self.h.types, type_id) != ty_CLASS()) { return false; }
        let text = self.type_text(type_id);
        if (text.len <= 3) { return false; }
        return text.startsWith("dyn");
    }

    // Unique rule: dyn is a property of the peeled type. `ref<dyn T>`,
    // `mutref<dyn T>`, and `ptr<dyn T>` are handles to the same trait object
    // as `dyn T`. Coercion and vtable reachability must not depend on the
    // outermost spelling.
    public fn type_peel_handle(self, type_id: i32) -> i32 {
        var cur = type_id;
        var depth: i32 = 0;
        while (depth < 4 && cur != hir_id_invalid()) {
            let kind = hir_type_table_kind(self.h.types, cur);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) {
                return cur;
            }
            let elem = hir_type_table_elem(self.h.types, cur);
            if (elem == hir_id_invalid()) { return cur; }
            cur = elem;
            depth = depth + 1;
        }
        return cur;
    }

    public fn type_dyn_trait_id(self, type_id: i32) -> i32 {
        let core = self.type_peel_handle(type_id);
        if (self.type_is_dyn_trait(core)) { return core; }
        return hir_id_invalid();
    }

    public fn type_dyn_payload_id(self, type_id: i32) -> i32 {
        let core = self.type_peel_handle(type_id);
        if (core == hir_id_invalid() || self.type_is_dyn_trait(core)) {
            return hir_id_invalid();
        }
        return core;
    }

    public fn dyn_trait_name_from_type_text(self, type_text: string) -> string {
        if (type_text.len <= 3) { return ""; }
        let base = policy_generic_call_base(type_text.clone());
        if (base.len <= 3 || !base.startsWith("dyn")) { return ""; }
        let trait_base = base.substring(3, base.len);
        if (trait_base.len == 0) { return ""; }
        let args = policy_generic_call_args(type_text.clone());
        if (args.len > 0) { return trait_base + "::<" + args + ">"; }
        return trait_base;
    }

    public fn type_text_matches_dyn_trait(self, type_text: string, dyn_type_id: i32) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || type_text.len == 0) { return false; }
        let dyn_text = self.type_text(dyn_type_id);
        let trait_text = self.dyn_trait_name_from_type_text(dyn_text);
        if (trait_text.len == 0) { return false; }
        if (type_text == dyn_text || type_text == trait_text) { return true; }
        if (policy_type_name_equal(type_text, trait_text)) { return true; }
        let type_base = policy_generic_call_base(type_text.clone());
        let trait_base = policy_generic_call_base(trait_text.clone());
        return mir_builder_last_path_segment(type_base) == mir_builder_last_path_segment(trait_base);
    }

    public fn interface_name_matches(self, a: string, b: string) -> bool {
        if (a.len == 0 || b.len == 0) { return false; }
        if (a == b || policy_type_name_equal(a, b)) { return true; }
        let abase = policy_generic_call_base(a.clone());
        let bbase = policy_generic_call_base(b.clone());
        if (abase == bbase || policy_type_name_equal(abase, bbase)) { return true; }
        return mir_builder_last_path_segment(abase) == mir_builder_last_path_segment(bbase);
    }

    public fn interface_extends_trait_name(self, iface_name: string, target_trait: string, depth: i32) -> bool {
        if (iface_name.len == 0 || target_trait.len == 0) { return false; }
        if (self.interface_name_matches(iface_name, target_trait)) { return true; }
        if (depth > 16) { return false; }
        let rows = hir_unit_interface_supers(self.h);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= rows.len) {
            if (i == rows.len || rows.charAt(i) == 59) {
                var sep: i32 = -1;
                var j = start;
                while (j < i) {
                    if (rows.charAt(j) == 62 && sep < 0) { sep = j; }
                    j = j + 1;
                }
                if (sep > start && sep + 1 < i) {
                    let child = rows.substring(start, sep);
                    let parent = rows.substring(sep + 1, i);
                    if (self.interface_name_matches(child, iface_name)) {
                        if (self.interface_name_matches(parent, target_trait)) { return true; }
                        if (self.interface_extends_trait_name(parent, target_trait, depth + 1)) {
                            return true;
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn dyn_trait_extends_type_text(self, dyn_type_id: i32, target_trait: string) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || target_trait.len == 0) { return false; }
        let trait_text = self.dyn_trait_name_from_type_text(self.type_text(dyn_type_id));
        if (trait_text.len == 0) { return false; }
        return self.interface_extends_trait_name(trait_text, target_trait, 0);
    }

    public fn hir_function_matches_dyn_trait(self, hir_function_id: i32, dyn_type_id: i32) -> bool {
        if (hir_function_id == hir_id_invalid() || !self.type_is_dyn_trait(dyn_type_id)) { return false; }
        let item_id = self.h.function_item(hir_function_id);
        if (item_id == hir_id_invalid()) { return false; }
        let owner_item = self.h.item_owner(item_id);
        if (owner_item == hir_id_invalid()) { return false; }
        if (self.h.item_kind(owner_item) != hir_item_interface()) { return false; }
        let owner_type_text = self.owner_type_text_for_hir_function(hir_function_id);
        if (self.type_text_matches_dyn_trait(owner_type_text, dyn_type_id)
            || self.dyn_trait_extends_type_text(dyn_type_id, owner_type_text)) {
            return true;
        }
        let first_local = self.h.function_first_local(hir_function_id);
        if (first_local != hir_id_invalid()) {
            let self_type_text = self.type_text(self.h.local_type(first_local));
            return self.type_text_matches_dyn_trait(self_type_text, dyn_type_id)
                   || self.dyn_trait_extends_type_text(dyn_type_id, self_type_text);
        }
        return false;
    }

    public fn hir_function_for_item(self, item_id: i32) -> i32 {
        if (item_id == hir_id_invalid()) { return hir_id_invalid(); }
        let direct = self.h.item_function(item_id);
        if (direct > 0) { return direct; }
        return hir_id_invalid();
    }

    public fn interface_item_for_dyn_trait(self, dyn_type_id: i32) -> i32 {
        if (!self.type_is_dyn_trait(dyn_type_id)) { return hir_id_invalid(); }
        let trait_text = self.dyn_trait_name_from_type_text(self.type_text(dyn_type_id));
        if (trait_text.len == 0) { return hir_id_invalid(); }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_interface()
                && self.type_text_matches_dyn_trait(self.h.item_name(item_id), dyn_type_id)) {
                return item_id;
            }
            item_id = item_id + 1;
        }
        return hir_id_invalid();
    }

    public fn ensure_dyn_trait_method_reachable(self,
                                                actual_type_id: i32,
                                                dyn_type_id: i32,
                                                prototype_hir_function_id: i32) {
        let payload_type_id = self.type_dyn_payload_id(actual_type_id);
        let peeled_dyn_type_id = self.type_dyn_trait_id(dyn_type_id);
        if (payload_type_id == hir_id_invalid()
            || peeled_dyn_type_id == hir_id_invalid()
            || prototype_hir_function_id == hir_id_invalid()) {
            return;
        }
        self.ensure_function_shell_for_hir(prototype_hir_function_id);
        let method_name = policy_generic_call_base(self.h.function_name(prototype_hir_function_id).clone());
        if (method_name.len == 0) { return; }
        self.function_target_by_owner_type_and_method(self.type_text(payload_type_id), method_name);
    }

    public fn ensure_dyn_trait_methods_reachable(self, actual_type_id: i32, expected_type_id: i32) {
        let dyn_type_id = self.type_dyn_trait_id(expected_type_id);
        if (dyn_type_id == hir_id_invalid()) { return; }
        if (self.type_dyn_trait_id(actual_type_id) == dyn_type_id) { return; }
        let payload_type_id = self.type_dyn_payload_id(actual_type_id);
        if (payload_type_id == hir_id_invalid() || payload_type_id == dyn_type_id) { return; }
        let interface_item = self.interface_item_for_dyn_trait(dyn_type_id);
        if (interface_item == hir_id_invalid()) { return; }
        var member_item = self.h.item_first_member(interface_item);
        while (member_item != hir_id_invalid()) {
            if (self.h.item_kind(member_item) == hir_item_method()) {
                let hir_fn = self.hir_function_for_item(member_item);
                if (hir_fn != hir_id_invalid()) {
                    self.ensure_dyn_trait_method_reachable(payload_type_id, dyn_type_id, hir_fn);
                }
            }
            member_item = self.h.item_next_sibling(member_item);
        }
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.hir_function_matches_dyn_trait(hir_fn, dyn_type_id)) {
                self.ensure_dyn_trait_method_reachable(payload_type_id, dyn_type_id, hir_fn);
            }
            hir_fn = hir_fn + 1;
        }
    }

    public fn type_id_has_open_template_atom(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        let cached = mir_i32_map_get(self.type_open_template_cache, type_id);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = self.type_name_has_open_template_atom(self.type_text(type_id));
        if (out) {
            mir_i32_map_put(self.type_open_template_cache, type_id, 2);
        } else {
            mir_i32_map_put(self.type_open_template_cache, type_id, 1);
        }
        return out;
    }

    public fn generic_env_has_open_template_atom(self, params: string, args: string, owner_type: string) -> bool {
        if (owner_type.len > 0 && self.type_name_has_open_template_atom(owner_type)) { return true; }
        if (params.len == 0) { return false; }
        var idx: i32 = 0;
        while (idx < 256) {
            let param = policy_generic_param_at(params, idx);
            if (param.len == 0) { return false; }
            let arg = policy_generic_arg_at(args, idx);
            if (arg.len == 0) { return false; }
            if (self.type_name_has_open_template_atom(arg)) { return true; }
            idx = idx + 1;
        }
        return true;
    }

    public fn type_atom_is_registered_item(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        self.index_registered_type_atoms();
        return mir_name_id_map_get(self.registered_type_atom_index,name) != mir_id_invalid();
    }

    public fn index_registered_type_atom_name(self, name: string) {
        if (name.len == 0) { return; }
        self.registered_type_atom_index = mir_name_id_map_put(self.registered_type_atom_index,name, 1);
        let base = policy_generic_call_base(name.clone());
        if (base.len > 0) {
            self.registered_type_atom_index = mir_name_id_map_put(self.registered_type_atom_index,base, 1);
            let base_last = mir_builder_last_path_segment(base);
            if (base_last.len > 0) {
                self.registered_type_atom_index = mir_name_id_map_put(self.registered_type_atom_index,base_last, 1);
            }
        }
        let last = mir_builder_last_path_segment(name);
        if (last.len > 0) {
            self.registered_type_atom_index = mir_name_id_map_put(self.registered_type_atom_index,last, 1);
        }
    }

    public fn index_registered_type_atoms(self) {
        var item_id: i32 = self.indexed_type_atom_item_next;
        if (item_id < 1) { item_id = 1; }
        while (item_id <= self.h.item_count) {
            let kind = self.h.item_kind(item_id);
            if (kind == hir_item_class()
                || kind == hir_item_enum()
                || kind == hir_item_interface()
                || kind == hir_item_type_alias()) {
                let item_name = self.h.item_name(item_id);
                self.index_registered_type_atom_name(item_name);
            }
            item_id = item_id + 1;
        }
        self.indexed_type_atom_item_next = self.h.item_count + 1;
    }

    public fn type_name_has_open_template_atom(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (name == "Range") { return false; }
        let args = policy_generic_call_args(name.clone());
        if (args.len > 0) {
            var i: i32 = 0;
            while (i < 64) {
                let arg = policy_generic_arg_at(args, i);
                if (arg.len == 0) { return false; }
                if (self.type_name_has_open_template_atom(arg)) { return true; }
                i = i + 1;
            }
            return false;
        }
        if (self.type_atom_is_registered_item(name)) { return false; }
        if (name == "Self") { return true; }
        if (self.type_structural_text_has_open_template_atom(name)) { return true; }
        if (name.len > 0) {
            let c = name.charAt(0);
            if (c >= 65 && c <= 90) { return true; }
        }
        return false;
    }

    public fn type_structural_text_has_open_template_atom(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        var start: i32 = -1;
        var in_array_len = false;
        var token_is_array_len = false;
        var i: i32 = 0;
        while (i <= text.len) {
            var c: i32 = 0;
            if (i < text.len) { c = text.charAt(i); }
            let is_ident = i < text.len
                && ((c >= 65 && c <= 90)
                    || (c >= 97 && c <= 122)
                    || (c >= 48 && c <= 57)
                    || c == 95
                || c == 46);
            if (is_ident) {
                if (start < 0) {
                    start = i;
                    token_is_array_len = in_array_len;
                }
            } else {
                if (start >= 0) {
                    let atom = text.substring(start, i);
                    if (self.type_structural_atom_is_open_template(atom, token_is_array_len)) { return true; }
                    start = -1;
                    token_is_array_len = false;
                }
                if (i < text.len) {
                    if (c == 59) {
                        in_array_len = true;
                    } else if (c == 93 || c == 44 || c == 41 || c == 62) {
                        in_array_len = false;
                    }
                }
            }
            i = i + 1;
        }
        return false;
    }

    public fn type_structural_atom_is_open_template(self, atom: string, array_len_atom: bool) -> bool {
        if (atom.len == 0) { return false; }
        if (atom == "Range") { return false; }
        if (atom == "fn") { return false; }
        if (atom == "cfn") { return false; }
        if (atom == "ptr") { return false; }
        if (atom == "mut") { return false; }
        if (atom == "const") { return false; }
        if (self.type_atom_is_registered_item(atom)) { return false; }
        if (atom == "Self") { return true; }
        let first = atom.charAt(0);
        if (first >= 48 && first <= 57) { return false; }
        if (atom.len == 1 && first >= 65 && first <= 90) { return true; }
        return array_len_atom && first >= 65 && first <= 90;
    }

    public fn hir_function_has_open_template_types(self, hir_function_id: i32) -> bool {
        if (hir_function_id == hir_id_invalid()) { return false; }
        let cached = mir_i32_map_get(self.hir_open_template_cache, hir_function_id);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        if (self.type_id_has_open_template_atom(self.h.function_return_type(hir_function_id))) {
            mir_i32_map_put(self.hir_open_template_cache, hir_function_id, 2);
            return true;
        }
        if (self.generic_env_has_open_template_atom(hir_unit_function_generic_params(self.h, hir_function_id),
                                                    hir_unit_function_generic_args(self.h, hir_function_id),
                                                    hir_unit_function_owner_type(self.h, hir_function_id))) {
            mir_i32_map_put(self.hir_open_template_cache, hir_function_id, 2);
            return true;
        }
        var local_id = self.h.function_first_local(hir_function_id);
        while (local_id != hir_id_invalid()) {
            if (self.type_id_has_open_template_atom(self.h.local_type(local_id))) {
                mir_i32_map_put(self.hir_open_template_cache, hir_function_id, 2);
                return true;
            }
            local_id = self.h.local_next(local_id);
        }
        mir_i32_map_put(self.hir_open_template_cache, hir_function_id, 1);
        return false;
    }

    public fn hir_function_has_executable_body(self, hir_function_id: i32) -> bool {
        if (hir_function_id == hir_id_invalid()) { return false; }
        if (self.h.function_body(hir_function_id) == hir_id_invalid()) { return false; }
        return !self.hir_function_has_open_template_types(hir_function_id);
    }

    public fn owner_type_text_for_hir_function(self, hir_function_id: i32) -> string {
        if (hir_function_id == hir_id_invalid()) { return ""; }
        let explicit_owner = hir_unit_function_owner_type(self.h, hir_function_id);
        if (explicit_owner.len > 0) { return explicit_owner; }
        let fn_item = self.h.function_item(hir_function_id);
        if (fn_item == hir_id_invalid()) { return ""; }
        let owner_item = self.h.item_owner(fn_item);
        if (owner_item == hir_id_invalid()) { return ""; }
        let owner_kind = self.h.item_kind(owner_item);
        if (owner_kind != hir_item_class()
            && owner_kind != hir_item_enum()
            && owner_kind != hir_item_interface()) {
            return "";
        }
        let owner_type_id = self.type_id_for_item(owner_item);
        if (owner_type_id != hir_id_invalid()) {
            let owner_text = self.type_text(owner_type_id);
            if (owner_text.len > 0) { return owner_text; }
        }
        return self.h.item_name(owner_item);
    }

    public fn method_index_key_for_function_name(self, function_name: string) -> string {
        if (function_name.len == 0) { return ""; }
        let mir2_method = mir_builder_mir2_method_segment(function_name);
        if (mir2_method.len > 0) { return mir2_method; }
        return policy_generic_call_base(function_name.clone());
    }

    public fn index_hir_function_lookup(self, hir_fn: i32) {
        if (hir_fn == hir_id_invalid() || hir_fn < 1 || hir_fn > self.h.function_count) { return; }
        if (self.hir_function_has_open_template_types(hir_fn)) { return; }
        let function_name = self.h.function_name(hir_fn);
        if (function_name.len > 0) {
            self.name_hir_function_index = mir_name_id_map_put(self.name_hir_function_index,function_name, hir_fn);
            let base_name = policy_generic_call_base(function_name.clone());
            if (base_name.len > 0) {
                self.name_hir_function_index = mir_name_id_map_put(self.name_hir_function_index,base_name, hir_fn);
            }
        }
        let owner_type = self.owner_type_text_for_hir_function(hir_fn);
        let method_key = self.method_index_key_for_function_name(function_name);
        if (method_key.len == 0) { return; }
        if (owner_type.len > 0) {
            self.owner_method_hir_function_index = mir_pair_id_map_put(self.owner_method_hir_function_index,owner_type, method_key, hir_fn);
        }
        let first_local = self.h.function_first_local(hir_fn);
        if (first_local != hir_id_invalid()
            && (self.h.local_flags(first_local) & hir_local_flag_self_receiver()) != 0) {
            let self_type = self.type_text(self.h.local_type(first_local));
            if (self_type.len > 0 && self_type != owner_type) {
                self.owner_method_hir_function_index = mir_pair_id_map_put(self.owner_method_hir_function_index,self_type, method_key, hir_fn);
            }
        }
    }

    public fn index_hir_function_lookups(self) {
        var hir_fn = self.indexed_hir_function_next;
        if (hir_fn < 1) { hir_fn = 1; }
        while (hir_fn <= self.h.function_count) {
            self.index_hir_function_lookup(hir_fn);
            hir_fn = hir_fn + 1;
        }
        self.indexed_hir_function_next = self.h.function_count + 1;
    }

    public fn indexed_hir_function_to_executable_mir(self, hir_fn: i32) -> i32 {
        if (hir_fn == hir_id_invalid()) { return mir_id_invalid(); }
        if (hir_fn < 1 || hir_fn > self.h.function_count) { return mir_id_invalid(); }
        if (self.hir_function_has_open_template_types(hir_fn)) { return mir_id_invalid(); }
        let mir_fn = self.ensure_function_shell_for_hir_quiet(hir_fn);
        if (mir_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_has_executable_body(mir_fn)) { return mir_fn; }
        return mir_id_invalid();
    }

    public fn indexed_method_target(self, owner_type: string, method_name: string) -> i32 {
        if (owner_type.len == 0 || method_name.len == 0) { return mir_id_invalid(); }
        self.index_hir_function_lookups();
        var hir_fn = mir_pair_id_map_get(self.owner_method_hir_function_index,owner_type, method_name);
        var mir_fn = self.indexed_hir_function_to_executable_mir(hir_fn);
        if (mir_fn != mir_id_invalid()) { return mir_fn; }
        let encoded_method = mir_builder_symbol_segment_for_name(method_name);
        if (encoded_method != method_name) {
            hir_fn = mir_pair_id_map_get(self.owner_method_hir_function_index,owner_type, encoded_method);
            mir_fn = self.indexed_hir_function_to_executable_mir(hir_fn);
            if (mir_fn != mir_id_invalid()) { return mir_fn; }
        }
        return mir_id_invalid();
    }

    public fn type_id_is_float(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        let kind = hir_type_table_kind(self.h.types, type_id);
        return kind == ty_F32() || kind == ty_F64();
    }

    public fn eval_static_binary_int(self, op: i32, lhs: i64, rhs: i64) -> MirStaticInitializer {
        if (op == tk_PLUS()) { return MirStaticInitializer.of_int(lhs + rhs); }
        if (op == tk_MINUS()) { return MirStaticInitializer.of_int(lhs - rhs); }
        if (op == tk_STAR()) { return MirStaticInitializer.of_int(lhs * rhs); }
        if (op == tk_SLASH()) {
            if (rhs == 0) { return MirStaticInitializer.invalid(); }
            return MirStaticInitializer.of_int(lhs / rhs);
        }
        if (op == tk_PERCENT()) {
            if (rhs == 0) { return MirStaticInitializer.invalid(); }
            return MirStaticInitializer.of_int(lhs % rhs);
        }
        if (op == tk_AMP()) { return MirStaticInitializer.of_int(lhs & rhs); }
        if (op == tk_PIPE()) { return MirStaticInitializer.of_int(lhs | rhs); }
        if (op == tk_CARET()) { return MirStaticInitializer.of_int(lhs ^ rhs); }
        if (op == tk_LSHIFT()) { return MirStaticInitializer.of_int(lhs << (rhs as i32)); }
        if (op == tk_RSHIFT()) { return MirStaticInitializer.of_int(lhs >> (rhs as i32)); }
        if (op == tk_EQEQ()) {
            if (lhs == rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_NEQ()) {
            if (lhs != rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_LT()) {
            if (lhs < rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_LE()) {
            if (lhs <= rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_GT()) {
            if (lhs > rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_GE()) {
            if (lhs >= rhs) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_AND()) {
            if (lhs != 0 && rhs != 0) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        if (op == tk_OR()) {
            if (lhs != 0 || rhs != 0) { return MirStaticInitializer.bool_value(1); }
            return MirStaticInitializer.bool_value(0);
        }
        return MirStaticInitializer.invalid();
    }

    public fn eval_static_item_initializer_depth(self, item_id: i32, depth: i32) -> MirStaticInitializer {
        if (depth > 64) { return MirStaticInitializer.invalid(); }
        if (item_id == hir_id_invalid() || item_id < 1 || item_id > self.h.item_count) {
            return MirStaticInitializer.invalid();
        }
        let item_kind = self.h.item_kind(item_id);
        if (item_kind != hir_item_const()) {
            return MirStaticInitializer.invalid();
        }
        let init_stmt = self.h.item_init(item_id);
        if (init_stmt == hir_id_invalid()) { return MirStaticInitializer.invalid(); }
        return self.eval_static_initializer_depth(self.h.stmt_expr(init_stmt), depth + 1);
    }

    public fn eval_static_initializer_depth(self, expr_id: i32, depth: i32) -> MirStaticInitializer {
        if (depth > 64) { return MirStaticInitializer.invalid(); }
        if (expr_id == hir_id_invalid()) { return MirStaticInitializer.invalid(); }
        let kind = self.h.expr_kind(expr_id);
        if (kind == ex_INT_LIT()) { return MirStaticInitializer.of_int(self.h.expr_int_value(expr_id)); }
        if (kind == ex_BOOL_LIT()) { return MirStaticInitializer.bool_value(self.h.expr_int_value(expr_id)); }
        if (kind == ex_CHAR_LIT()) { return MirStaticInitializer.char_value(self.h.expr_int_value(expr_id)); }
        if (kind == ex_STR_LIT()) { return MirStaticInitializer.str_value(self.h.expr_value_text(expr_id)); }
        if (kind == ex_NULL_LIT()) { return MirStaticInitializer.null_value(); }
        if (kind == ex_IDENT()
            && self.h.expr_target_kind(expr_id) == hir_target_item()) {
            let item_id = self.h.expr_target_id(expr_id);
            let folded = self.eval_static_item_initializer_depth(item_id, depth + 1);
            if (folded.ok && folded.kind != mir_static_init_none()) { return folded; }
            return MirStaticInitializer.item_ref(item_id);
        }
        if (kind == ex_CAST()) {
            return self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
        }
        if (kind == ex_UNARY()) {
            let inner = self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
            if (!inner.ok || inner.kind != mir_static_init_int()) { return MirStaticInitializer.invalid(); }
            let op = self.h.expr_op(expr_id);
            if (op == tk_MINUS()) { return MirStaticInitializer.of_int(0 - inner.int_value); }
            if (op == tk_PLUS()) { return inner; }
            return MirStaticInitializer.invalid();
        }
        if (kind == ex_BIN()) {
            let lhs = self.eval_static_initializer_depth(self.h.expr_lhs(expr_id), depth + 1);
            let rhs = self.eval_static_initializer_depth(self.h.expr_rhs(expr_id), depth + 1);
            if (!lhs.ok || !rhs.ok) { return MirStaticInitializer.invalid(); }
            if (lhs.kind != mir_static_init_int() || rhs.kind != mir_static_init_int()) {
                return MirStaticInitializer.invalid();
            }
            return self.eval_static_binary_int(self.h.expr_op(expr_id), lhs.int_value, rhs.int_value);
        }
        return MirStaticInitializer.invalid();
    }

    public fn eval_static_initializer(self, expr_id: i32) -> MirStaticInitializer {
        return self.eval_static_initializer_depth(expr_id, 0);
    }

    public fn build_static_items(self) {
        var module_name: string = "";
        var item_id: i32 = self.static_item_scan_next;
        if (item_id < 1) { item_id = 1; }
        // A HIR unit can contain the root source and imported interface
        // declarations.  Each declaration chain starts with its own module
        // item, so the first module in the unit is not necessarily the owner
        // of every following global.  Restore the active module when this
        // incremental scan resumes, then advance it as module items appear.
        var module_scan: i32 = 1;
        while (module_scan < item_id && module_scan <= self.h.item_count) {
            if (self.h.item_kind(module_scan) == hir_item_module()) {
                module_name = self.h.item_name(module_scan);
            }
            module_scan = module_scan + 1;
        }
        while (item_id <= self.h.item_count) {
            let item_kind = self.h.item_kind(item_id);
            if (item_kind == hir_item_module()) {
                module_name = self.h.item_name(item_id);
                item_id = item_id + 1;
                continue;
            }
            if (item_kind == hir_item_const() || item_kind == hir_item_global()) {
                var static_exists = false;
                if (item_id <= self.unit.static_cap) {
                    static_exists = self.unit.static_exists(item_id);
                }
                if (!static_exists) {
                    var init = MirStaticInitializer.null_value();
                    let init_stmt = self.h.item_init(item_id);
                    if (init_stmt != hir_id_invalid()) {
                        init = self.eval_static_initializer(self.h.stmt_expr(init_stmt));
                        if (!init.ok) {
                            init = MirStaticInitializer.invalid();
                        }
                    }
                    self.unit.add_static_item(
                                             item_id,
                                             item_kind,
                                             self.h.item_name(item_id),
                                             self.h.item_type(item_id),
                                             init.kind,
                                             init.target_kind,
                                             init.target_id,
                                             init.int_value,
                                             init.text,
                                             module_name);
                }
            }
            item_id = item_id + 1;
        }
        self.static_item_scan_next = self.h.item_count + 1;
    }

    public fn type_id_by_text(self, text: string) -> i32 {
        if (text.len == 0) { return mir_id_invalid(); }
        self.index_type_texts();
        return mir_name_id_map_get(self.type_text_id_index,text);
    }

    public fn index_type_texts(self) {
        var type_id: i32 = self.indexed_type_text_next;
        if (type_id < 1) { type_id = 1; }
        while (type_id <= self.h.types.count) {
            let text = hir_type_table_text(self.h.types, type_id);
            if (text.len > 0) {
                self.type_text_id_index = mir_name_id_map_put(self.type_text_id_index,text, type_id);
            }
            type_id = type_id + (1 as i32);
        }
        var next_type_text: i32 = self.h.types.count;
        next_type_text = next_type_text + 1;
        self.indexed_type_text_next = next_type_text;
    }

    public fn intern_type_id_by_text(self, text: string) -> i32 {
        if (text.len == 0) { return mir_id_invalid(); }
        let existing = self.type_id_by_text(text);
        if (existing != mir_id_invalid()) { return existing; }
        var out: i32 = hir_id_invalid();
        if (text == "i32") { out = self.h.types.intern_type_ref(tref_alloc(ty_I32(), "")); }
        else if (text == "i64") { out = self.h.types.intern_type_ref(tref_alloc(ty_I64(), "")); }
        else if (text == "bool") { out = self.h.types.intern_type_ref(tref_alloc(ty_BOOL(), "")); }
        else if (text == "char") { out = self.h.types.intern_type_ref(tref_alloc(ty_CHAR(), "")); }
        else if (text == "str" || text == "string" || text == "__String") { out = self.h.types.intern_type_ref(tref_alloc(ty_STRING(), "")); }
        else if (text == "rawptr") { out = self.h.types.intern_type_ref(tref_alloc(ty_RAWPTR(), "")); }
        else if (text == "void") { out = self.h.types.intern_type_ref(tref_alloc(ty_VOID(), "")); }
        else if (text == "f32") { out = self.h.types.intern_type_ref(tref_alloc(ty_F32(), "")); }
        else if (text == "f64") { out = self.h.types.intern_type_ref(tref_alloc(ty_F64(), "")); }
        else if (text == "i8") { out = self.h.types.intern_type_ref(tref_alloc(ty_I8(), "")); }
        else if (text == "i16") { out = self.h.types.intern_type_ref(tref_alloc(ty_I16(), "")); }
        else if (text == "u8") { out = self.h.types.intern_type_ref(tref_alloc(ty_U8(), "")); }
        else if (text == "u16") { out = self.h.types.intern_type_ref(tref_alloc(ty_U16(), "")); }
        else if (text == "u32") { out = self.h.types.intern_type_ref(tref_alloc(ty_U32(), "")); }
        else if (text == "u64") { out = self.h.types.intern_type_ref(tref_alloc(ty_U64(), "")); }
        else if (text == "isize") { out = self.h.types.intern_type_ref(tref_alloc(ty_ISIZE(), "")); }
        else if (text == "usize") { out = self.h.types.intern_type_ref(tref_alloc(ty_USIZE(), "")); }
        else { out = self.h.types.intern_type_ref(tref_alloc(ty_CLASS(), text)); }
        if (out != hir_id_invalid()) {
            self.type_text_id_index = mir_name_id_map_put(self.type_text_id_index,text, out);
            if (out >= self.indexed_type_text_next) {
                var next_indexed_type_text: i32 = out;
                next_indexed_type_text = next_indexed_type_text + 1;
                self.indexed_type_text_next = next_indexed_type_text;
            }
        }
        return out;
    }

    public fn append_type_arg_text(self, base: string, next: string) -> string {
        if (next.len == 0) { return base; }
        if (base.len == 0) { return next; }
        return base + "," + next;
    }

    public fn specialize_type_text_for_owner(self,
                                             text: string,
                                             pattern_owner_text: string,
                                             concrete_owner_text: string) -> string {
        if (text.len == 0) { return ""; }
        if (text == "Self") { return concrete_owner_text; }
        let pattern_args = policy_generic_call_args(pattern_owner_text.clone());
        let concrete_args = policy_generic_call_args(concrete_owner_text.clone());
        var arg_index: i32 = 0;
        while (arg_index < 128) {
            let pattern_arg = policy_generic_arg_at(pattern_args, arg_index);
            if (pattern_arg.len == 0) {
                arg_index = 128;
            } else {
                let concrete_arg = policy_generic_arg_at(concrete_args, arg_index);
                if (text == pattern_arg && concrete_arg.len > 0) { return concrete_arg; }
                arg_index = arg_index + 1;
            }
        }
        if (policy_generic_call_has_args(text.clone()) != 0) {
            let base = policy_generic_call_base(text.clone());
            let raw_args = policy_generic_call_args(text.clone());
            var out_args = "";
            var i: i32 = 0;
            while (i < 128) {
                let raw_arg = policy_generic_arg_at(raw_args, i);
                if (raw_arg.len == 0) {
                    i = 128;
                } else {
                    out_args = self.append_type_arg_text(out_args,
                                                         self.specialize_type_text_for_owner(raw_arg,
                                                                                            pattern_owner_text,
                                                                                            concrete_owner_text));
                    i = i + 1;
                }
            }
            if (out_args.len > 0) { return base + "::<" + out_args + ">"; }
            return base;
        }
        return text;
    }

    public fn i64_type_id(self) -> i32 {
        let existing = self.type_id_by_text("i64");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_I64(), ""));
    }

    public fn i32_type_id(self) -> i32 {
        let existing = self.type_id_by_text("i32");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_I32(), ""));
    }

    public fn bool_type_id(self) -> i32 {
        let existing = self.type_id_by_text("bool");
        if (existing != mir_id_invalid()) { return existing; }
        return self.h.types.intern_type_ref(tref_alloc(ty_BOOL(), ""));
    }

    public fn hir_pack_local_name(self, pack_name: string, index: i32) -> string {
        return pack_name + "$" + policy_i64_to_string(index as i64);
    }

    public fn hir_pack_local_at_in_current_function(self, pack_name: string, index: i32) -> i32 {
        if (pack_name.len == 0 || index < 0 || self.current_hir_function_id == hir_id_invalid()) {
            return hir_id_invalid();
        }
        let wanted = self.hir_pack_local_name(pack_name, index);
        var local_id = self.h.function_first_local(self.current_hir_function_id);
        while (local_id != hir_id_invalid()) {
            if (self.h.local_name(local_id) == wanted) { return local_id; }
            local_id = self.h.local_next(local_id);
        }
        return hir_id_invalid();
    }

    public fn hir_pack_local_count_in_current_function(self, pack_name: string) -> i32 {
        if (pack_name.len == 0) { return 0; }
        var count: i32 = 0;
        while (self.hir_pack_local_at_in_current_function(pack_name, count) != hir_id_invalid()) {
            count = count + 1;
        }
        return count;
    }

    public fn hir_pack_index_base_name(self, expr_id: i32) -> string {
        if (expr_id == hir_id_invalid() || self.h.expr_kind(expr_id) != ex_INDEX()) { return ""; }
        let base_expr = self.h.expr_lhs(expr_id);
        if (base_expr == hir_id_invalid() || self.h.expr_kind(base_expr) != ex_IDENT()) { return ""; }
        let pack_name = self.h.expr_name(base_expr);
        if (self.hir_pack_local_count_in_current_function(pack_name) <= 0) { return ""; }
        return pack_name;
    }

    public fn lower_pack_index_expr(self, expr_id: i32) -> i32 {
        let pack_name = self.hir_pack_index_base_name(expr_id);
        if (pack_name.len == 0) { return mir_id_invalid(); }
        let pack_count = self.hir_pack_local_count_in_current_function(pack_name);
        if (pack_count <= 0) { return mir_id_invalid(); }
        let first_local = self.hir_pack_local_at_in_current_function(pack_name, 0);
        if (first_local == hir_id_invalid()) { return mir_id_invalid(); }
        let result_type = self.h.local_type(first_local);
        let index_value = self.lower_expr_as(self.h.expr_rhs(expr_id), self.i64_type_id());
        if (index_value == mir_id_invalid() || self.current_block_terminated()) { return mir_id_invalid(); }
        let result_place = self.add_temp_place(result_type, expr_id, "packindex");
        let join_block = self.add_block(hir_id_invalid());
        var index: i32 = 0;
        while (index < pack_count) {
            let matched_block = self.add_block(hir_id_invalid());
            let next_block = self.add_block(hir_id_invalid());
            let expected_value = self.add_const_i64_value(index as i64, expr_id);
            let cond_value = self.add_binary_value(self.bool_type_id(),
                                                   tk_EQEQ(),
                                                   index_value,
                                                   expected_value,
                                                   expr_id,
                                                   "packindex.eq");
            if (cond_value == mir_id_invalid()) { return mir_id_invalid(); }
            self.terminate_current(mir_term_branch(),
                                   cond_value,
                                   matched_block,
                                   next_block,
                                   mir_id_invalid(),
                                   expr_id);

            self.set_current_block(matched_block);
            let hir_local = self.hir_pack_local_at_in_current_function(pack_name, index);
            let local_place = mir_i32_map_get(self.place_map, hir_local);
            let local_value = self.add_read_value(local_place, expr_id);
            self.emit_assign(result_place, local_value, hir_id_invalid(), expr_id);
            if (!self.current_block_terminated()) {
                self.terminate_current_goto(join_block);
            }

            self.set_current_block(next_block);
            index = index + 1;
        }
        if (!self.current_block_terminated()) {
            self.terminate_current(mir_term_unreachable(),
                                   mir_id_invalid(),
                                   mir_id_invalid(),
                                   mir_id_invalid(),
                                   mir_id_invalid(),
                                   expr_id);
        }
        self.set_current_block(join_block);
        return self.add_read_value(result_place, expr_id);
    }

    public fn add_binary_value(self,
                               type_id: i32,
                               op: i32,
                               lhs_value_id: i32,
                               rhs_value_id: i32,
                               source_expr_id: i32,
                               name: string) -> i32 {
        if (lhs_value_id == mir_id_invalid() || rhs_value_id == mir_id_invalid()) {
            return mir_id_invalid();
        }
        let out = self.unit.add_value(
                                     self.current_function_id,
                                     mir_value_binary(),
                                     type_id,
                                     mir_id_invalid(),
                                     mir_target_none(),
                                     mir_id_invalid(),
                                     source_expr_id,
                                     0,
                                     op,
                                     0,
                                     name,
                                     "");
        self.unit.set_value_lhs( out, lhs_value_id);
        self.unit.set_value_rhs( out, rhs_value_id);
        return out;
    }

    public fn type_base_text(self, text: string) -> string {
        if (policy_generic_call_has_args(text.clone()) != 0) {
            return policy_generic_call_base(text.clone());
        }
        return text;
    }

    public fn type_text_is_std_string_class(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        return mir_builder_last_path_segment(base) == "String";
    }

    public fn type_text_is_string_abi(self, text: string) -> bool {
        let resolved = self.resolve_type_text_in_function(self.current_function_id, text);
        return resolved == "str" || resolved == "string";
    }

    public fn builtin_member_fallback_allowed(self, receiver_expr_id: i32, member_name: string) -> bool {
        if (receiver_expr_id == hir_id_invalid() || member_name.len == 0) { return false; }
        let receiver_type_id = self.h.expr_type(receiver_expr_id);
        if (receiver_type_id == hir_id_invalid()) { return false; }
        let receiver_text = self.type_text(receiver_type_id);
        if (self.type_text_is_string_abi(receiver_text)) { return true; }
        // Built-in pointer methods on typed pointers / rawptr receivers.
        let receiver_kind = hir_type_table_kind(self.h.types, receiver_type_id);
        if ((receiver_kind == ty_PTR() || receiver_kind == ty_REF()
            || receiver_kind == ty_MUTREF() || receiver_kind == ty_RAWPTR())
            && policy_pointer_method_kind(member_name) > 0) {
            return true;
        }
        if (member_name == "toString" || member_name == "to_string") { return true; }
        return false;
    }

    public fn ensure_str_to_std_string_support(self, expr_id: i32, expected_type_id: i32) {
        if (expr_id == hir_id_invalid() || expected_type_id == hir_id_invalid()) { return; }
        let actual_type_id = self.h.expr_type(expr_id);
        if (actual_type_id == hir_id_invalid()) { return; }
        if (!self.type_text_is_std_string_class(self.type_text(expected_type_id))) { return; }
        if (self.type_text(actual_type_id) != "str" && self.type_text(actual_type_id) != "string") { return; }
        self.ensure_layouts_for_type(expected_type_id);
        let from_fn = self.function_target_by_owner_type_and_method(self.type_text(expected_type_id), "from");
        if (from_fn != mir_id_invalid()) {
            self.mark_function_reachable(from_fn);
        }
    }

    public fn append_csv(self, acc: string, item: string) -> string {
        if (acc.len == 0) { return item; }
        return acc + "," + item;
    }

    public fn function_generic_binding(self, function_id: i32, name: string) -> string {
        if (name.len == 0 || function_id == mir_id_invalid()) { return ""; }
        if (name == "Self") {
            let owner = self.unit.function_owner_type( function_id);
            if (owner.len > 0) { return owner; }
        }
        let params = self.unit.function_generic_params( function_id);
        let args = self.unit.function_generic_args( function_id);
        var idx: i32 = 0;
        while (idx < 64) {
            let param = mir_builder_generic_param_canonical(policy_generic_param_at(params, idx));
            if (param.len == 0) { return ""; }
            if (param == name) { return policy_generic_arg_at(args, idx); }
            idx = idx + 1;
        }
        return "";
    }

    public fn normalize_type_text(self, text: string) -> string {
        if (mir_builder_is_primitive_str_name(text)) { return "str"; }
        return text;
    }

    public fn resolve_type_text_in_function(self, function_id: i32, text: string) -> string {
        let normalized = self.normalize_type_text(text);
        if (normalized.len == 0) { return ""; }
        if (policy_generic_call_has_args(normalized.clone()) != 0) {
            let base = policy_generic_call_base(normalized.clone());
            let raw_args = policy_generic_call_args(normalized.clone());
            var out_args = "";
            var idx: i32 = 0;
            while (idx < 64) {
                let raw_arg = policy_generic_arg_at(raw_args, idx);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return self.normalize_type_text(base); }
                    return self.normalize_type_text(base) + "::<" + out_args + ">";
                }
                out_args = self.append_csv(out_args, self.resolve_type_text_in_function(function_id, raw_arg));
                idx = idx + 1;
            }
            return self.normalize_type_text(base) + "::<" + out_args + ">";
        }
        let bound = self.function_generic_binding(function_id, normalized);
        if (bound.len > 0 && bound != normalized) {
            return self.resolve_type_text_in_function(function_id, bound);
        }
        return normalized;
    }

    public fn type_id_for_resolved_text(self, function_id: i32, text: string) -> i32 {
        let resolved = self.resolve_type_text_in_function(function_id, text);
        if (resolved.len == 0) { return mir_id_invalid(); }
        return self.type_id_by_text(resolved);
    }

    public fn ensure_layouts_for_builtin_type_args(self, call_target_kind: i32, call_name: string) {
        if (policy_generic_call_has_args(call_name.clone()) == 0) { return; }
        let base = policy_generic_call_base(call_name.clone());
        var is_layout_builtin = call_target_kind == mir_target_builtin();
        if (!is_layout_builtin) {
            if (base == "sizeof" || base == "repr_sizeof" || base == "alignof"
                || base == "field_count" || base == "field_name"
                || base == "field_type" || base == "has_field") {
                is_layout_builtin = true;
            }
        }
        if (!is_layout_builtin) { return; }
        let args = policy_generic_call_args(call_name.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let arg_text = policy_generic_arg_at(args, idx);
            if (arg_text.len == 0) { return; }
            let type_id = self.type_id_for_resolved_text(self.current_function_id, arg_text);
            if (type_id != mir_id_invalid()) {
                self.ensure_layouts_for_type(type_id);
            }
            idx = idx + 1;
        }
    }

    public fn effective_expr_type(self, expr_id: i32, expected_type_id: i32) -> i32 {
        let actual_type_id = self.h.expr_type(expr_id);
        if (expected_type_id == hir_id_invalid()) { return actual_type_id; }
        if (actual_type_id == hir_id_invalid()) { return expected_type_id; }
        if (actual_type_id == expected_type_id) { return actual_type_id; }
        let actual_text = self.type_text(actual_type_id);
        let expected_text = self.type_text(expected_type_id);
        if (actual_text == expected_text) { return expected_type_id; }
        if (self.type_dyn_trait_id(expected_type_id) != hir_id_invalid()
            && self.type_dyn_payload_id(actual_type_id) != hir_id_invalid()) {
            self.ensure_dyn_trait_methods_reachable(actual_type_id, expected_type_id);
        }
        if (self.type_is_dyn_trait(expected_type_id) && !self.type_is_dyn_trait(actual_type_id)) {
            return expected_type_id;
        }
        if (policy_generic_call_has_args(expected_text.clone()) != 0
            && policy_generic_call_has_args(actual_text.clone()) == 0
            && self.type_base_text(expected_text) == actual_text) {
            return expected_type_id;
        }
        if (policy_generic_call_has_args(expected_text.clone()) != 0
            && policy_generic_call_has_args(actual_text.clone()) != 0
            && self.type_base_text(expected_text) == self.type_base_text(actual_text)
            && self.type_name_has_open_template_atom(actual_text)
            && !self.type_name_has_open_template_atom(expected_text)) {
            return expected_type_id;
        }
        return actual_type_id;
    }

    public fn lower_array_decay_expr_as(self, expr_id: i32, expected_type_id: i32) -> i32 {
        if (expr_id == hir_id_invalid() || expected_type_id == hir_id_invalid()) {
            return mir_id_invalid();
        }
        let source_type_id = self.h.expr_type(expr_id);
        if (source_type_id == hir_id_invalid()
            || hir_type_table_kind(self.h.types, source_type_id) != ty_ARRAY()
            || hir_type_table_kind(self.h.types, expected_type_id) != ty_PTR()) {
            return mir_id_invalid();
        }
        let source_elem_type = hir_type_table_elem(self.h.types, source_type_id);
        let pointer_elem_type = hir_type_table_elem(self.h.types, expected_type_id);
        if (source_elem_type == hir_id_invalid()
            || pointer_elem_type == hir_id_invalid()
            || !self.type_ids_equivalent(source_elem_type, pointer_elem_type)) {
            return mir_id_invalid();
        }
        var source_place = self.lower_expr_place(expr_id);
        if (source_place == mir_id_invalid()) {
            // Temporary array literal (e.g. a bare `[1, 2, 3]` call
            // argument, or the `[e1..en]` synthesized for `Vec<i32>{...}`
            // list initialization): there is no storage to address yet.
            // Materialize the aggregate into a temp place of the array
            // type, then decay that place.  The expected type must be
            // cleared while lowering so the aggregate keeps its real array
            // type instead of being rebuilt under the pointer type.
            let saved_expected = self.expected_expr_type_id;
            self.expected_expr_type_id = hir_id_invalid();
            let agg = self.lower_expr(expr_id);
            self.expected_expr_type_id = saved_expected;
            if (agg == mir_id_invalid()) { return mir_id_invalid(); }
            let temp_place = self.add_temp_place(source_type_id, expr_id, "array.decay");
            if (temp_place == mir_id_invalid()) { return mir_id_invalid(); }
            self.emit_assign(temp_place, agg, hir_id_invalid(), expr_id);
            source_place = temp_place;
        }
        let zero = self.add_const_i64_value(0, expr_id);
        if (zero == mir_id_invalid()) { return mir_id_invalid(); }
        let first_elem_place = self.unit.add_place(
                                                  self.current_function_id,
                                                  mir_place_index(),
                                                  source_elem_type,
                                                  mir_id_invalid(),
                                                  source_place,
                                                  mir_id_invalid(),
                                                  zero,
                                                  expr_id,
                                                  "array.decay");
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_address_of(),
                                  expected_type_id,
                                  first_elem_place,
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  expr_id,
                                  hir_unit_expr_flags(self.h, expr_id),
                                  self.h.expr_op(expr_id),
                                  hir_unit_expr_int_value(self.h, expr_id),
                                  "array.decay",
                                  self.h.expr_value_text(expr_id));
    }

    public fn lower_expr_as(self, expr_id: i32, expected_type_id: i32) -> i32 {
        self.ensure_str_to_std_string_support(expr_id, expected_type_id);
        let array_decay = self.lower_array_decay_expr_as(expr_id, expected_type_id);
        if (array_decay != mir_id_invalid()) { return array_decay; }
        let saved = self.expected_expr_type_id;
        self.expected_expr_type_id = expected_type_id;
        let out = self.lower_expr(expr_id);
        self.expected_expr_type_id = saved;
        if (out != mir_id_invalid()
            && expected_type_id != hir_id_invalid()
            && self.unit.value_type(out) != hir_id_invalid()
            && !self.type_ids_equivalent(self.unit.value_type(out), expected_type_id)) {
            self.ensure_dyn_trait_methods_reachable(self.unit.value_type(out), expected_type_id);
            let cast_value = self.unit.add_value(
                                                self.current_function_id,
                                                mir_value_cast(),
                                                expected_type_id,
                                                mir_id_invalid(),
                                                mir_target_none(),
                                                mir_id_invalid(),
                                                expr_id,
                                                hir_unit_expr_flags(self.h, expr_id),
                                                self.h.expr_op(expr_id),
                                                hir_unit_expr_int_value(self.h, expr_id),
                                                self.h.expr_name(expr_id),
                                                self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( cast_value, out);
            return cast_value;
        }
        return out;
    }

    public fn block_terminated(self, block_id: i32) -> bool {
        if (block_id == mir_id_invalid()) { return true; }
        return self.unit.block_term_kind(block_id) != mir_id_invalid();
    }

    public fn current_block_terminated(self) -> bool {
        return self.block_terminated(self.current_block_id);
    }

    public fn try_lower_static_if_stmt(self, stmt_id: i32) -> bool {
        let folded = self.eval_static_initializer(self.h.stmt_cond(stmt_id));
        if (!folded.ok) { return false; }
        if (folded.kind != mir_static_init_int()
            && folded.kind != mir_static_init_bool()
            && folded.kind != mir_static_init_char()) {
            return false;
        }
        if (folded.int_value != 0) {
            self.lower_stmt(self.h.stmt_child(stmt_id));
        } else {
            self.lower_stmt(self.h.stmt_else(stmt_id));
        }
        return true;
    }

    public fn add_block(self, source_stmt_id: i32) -> i32 {
        return self.unit.add_block( self.current_function_id, source_stmt_id);
    }

    public fn set_current_block(self, block_id: i32) {
        self.current_block_id = block_id;
    }

    public fn terminate_current(self,
                                term_kind: i32,
                                value_id: i32,
                                target_block_id: i32,
                                false_block_id: i32,
                                first_case_id: i32,
                                aux: i32) {
        if (self.current_block_id == mir_id_invalid()) { return; }
        if (self.current_block_terminated()) { return; }
        self.unit.set_block_terminator(
                                      self.current_block_id,
                                      term_kind,
                                      value_id,
                                      target_block_id,
                                      false_block_id,
                                      first_case_id,
                                      aux);
    }

    public fn terminate_current_goto(self, target_block_id: i32) {
        self.terminate_current(mir_term_goto(),
                               mir_id_invalid(),
                               target_block_id,
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_id_invalid());
    }

    public fn target_kind_from_hir(self, hir_target_kind: i32) -> i32 {
        if (hir_target_kind == hir_target_function()) { return mir_target_function(); }
        if (hir_target_kind == hir_target_item()) { return mir_target_hir_item(); }
        if (hir_target_kind == hir_target_field()) { return mir_target_hir_field(); }
        if (hir_target_kind == hir_target_variant()) { return mir_target_hir_variant(); }
        if (hir_target_kind == hir_target_builtin()) { return mir_target_builtin(); }
        if (hir_target_kind == hir_target_local()) { return mir_target_local(); }
        if (hir_target_kind == hir_target_type()) { return mir_target_type(); }
        return mir_target_none();
    }

    public fn target_id_from_hir_expr(self, expr_id: i32) -> i32 {
        let hir_target_kind = self.h.expr_target_kind(expr_id);
        var hir_target_id = self.h.expr_target_id(expr_id);
        if (hir_target_kind == hir_target_function()) {
            if (hir_target_id == hir_id_invalid()) {
                self.index_hir_function_lookups();
                hir_target_id = mir_name_id_map_get(self.name_hir_function_index,self.h.expr_name(expr_id));
            }
            return self.ensure_function_shell_for_hir(hir_target_id);
        }
        if (hir_target_kind == hir_target_local()) {
            return mir_i32_map_get(self.local_map, hir_target_id);
        }
        return hir_target_id;
    }

    public fn add_read_value(self, place_id: i32, source_expr_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        return self.add_read_value_typed(place_id, self.unit.place_type(place_id), source_expr_id);
    }

    public fn value_flags_for_expr(self, source_expr_id: i32) -> i32 {
        if (source_expr_id == hir_id_invalid()) { return 0; }
        var flags = hir_unit_expr_flags(self.h, source_expr_id);
        if ((hir_unit_expr_move_drop_flags(self.h, source_expr_id) & hir_move_drop_flag_move_arg()) != 0) {
            flags = flags | mir_value_flag_move_arg();
        }
        return flags;
    }

    public fn mark_value_tree_move_arg(self, value_id: i32, depth: i32) {
        if (value_id == mir_id_invalid() || depth > 32) { return; }
        if (value_id < 1 || value_id > self.unit.value_count) { return; }
        if (self.unit.value_kind(value_id) == mir_value_read_place()) {
            self.unit.set_value_flags(
                                     value_id,
                                     self.unit.value_flags(value_id) | mir_value_flag_move_arg());
        }
        self.mark_value_tree_move_arg(self.unit.value_lhs(value_id), depth + 1);
        self.mark_value_tree_move_arg(self.unit.value_rhs(value_id), depth + 1);
        self.mark_value_tree_move_arg(self.unit.value_aux(value_id), depth + 1);
        var arg = self.unit.value_first_arg(value_id);
        var guard: i32 = 0;
        while (arg != mir_id_invalid() && guard <= self.unit.value_count) {
            self.mark_value_tree_move_arg(arg, depth + 1);
            arg = self.unit.value_next_arg(arg);
            guard = guard + 1;
        }
    }

    public fn param_local_moves_argument(self, param_local_id: i32) -> bool {
        if (param_local_id == hir_id_invalid()) { return false; }
        return (self.h.local_flags(param_local_id) & hir_local_flag_move_arg()) != 0;
    }

    public fn add_read_value_typed(self, place_id: i32, type_id: i32, source_expr_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_read_place(),
                                  type_id,
                                  place_id,
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  self.value_flags_for_expr(source_expr_id),
                                  0,
                                  0,
                                  self.unit.place_name(place_id),
                                  "");
    }

    public fn copy_hir_expr_loc_to_value(self, value_id: i32) {
        if (value_id == mir_id_invalid()) { return; }
        let expr_id = self.unit.value_source_expr(value_id);
        if (expr_id == hir_id_invalid() || expr_id < 1 || expr_id > self.h.expr_cap) { return; }
        let expr_rec = self.h.expr_record(expr_id);
        if (expr_rec == null || ast_read_i32(expr_rec) != expr_id) { return; }
        let line = hir_unit_expr_loc_line(self.h, expr_id);
        if (line <= 0) { return; }
        self.unit.set_value_loc(
                               value_id,
                               line,
                               hir_unit_expr_loc_col(self.h, expr_id),
                               hir_unit_expr_loc_end_line(self.h, expr_id),
                               hir_unit_expr_loc_end_col(self.h, expr_id));
    }

    public fn copy_value_source_locs_since(self, value_mark: i32) {
        var value_id = value_mark + 1;
        while (value_id <= self.unit.value_count) {
            self.copy_hir_expr_loc_to_value(value_id);
            value_id = value_id + 1;
        }
    }

    public fn copy_hir_stmt_loc_to_block(self, block_id: i32) {
        if (block_id == mir_id_invalid()) { return; }
        let stmt_id = self.unit.block_source_stmt(block_id);
        if (stmt_id == hir_id_invalid() || stmt_id < 1 || stmt_id > self.h.stmt_cap) { return; }
        let stmt_rec = self.h.stmt_record(stmt_id);
        if (stmt_rec == null || ast_read_i32(stmt_rec) != stmt_id) { return; }
        let line = hir_unit_stmt_loc_line(self.h, stmt_id);
        if (line <= 0) { return; }
        self.unit.set_block_loc(block_id,
                                line,
                                hir_unit_stmt_loc_col(self.h, stmt_id),
                                hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                hir_unit_stmt_loc_end_col(self.h, stmt_id));
    }

    public fn copy_block_source_locs_since(self, block_mark: i32) {
        var block_id = block_mark + 1;
        while (block_id <= self.unit.block_count) {
            self.copy_hir_stmt_loc_to_block(block_id);
            block_id = block_id + 1;
        }
    }

    public fn copy_hir_source_loc_to_instr(self, instr_id: i32) {
        if (instr_id == mir_id_invalid()) { return; }
        let expr_id = self.unit.instr_source_expr(instr_id);
        if (expr_id != hir_id_invalid() && expr_id >= 1 && expr_id <= self.h.expr_cap) {
            let expr_rec = self.h.expr_record(expr_id);
            if (expr_rec != null && ast_read_i32(expr_rec) == expr_id) {
                let line = hir_unit_expr_loc_line(self.h, expr_id);
                if (line > 0) {
                    self.unit.set_instr_loc(instr_id,
                                            line,
                                            hir_unit_expr_loc_col(self.h, expr_id),
                                            hir_unit_expr_loc_end_line(self.h, expr_id),
                                            hir_unit_expr_loc_end_col(self.h, expr_id));
                    return;
                }
            }
        }
        let stmt_id = self.unit.instr_source_stmt(instr_id);
        if (stmt_id == hir_id_invalid() || stmt_id < 1 || stmt_id > self.h.stmt_cap) { return; }
        let stmt_rec = self.h.stmt_record(stmt_id);
        if (stmt_rec == null || ast_read_i32(stmt_rec) != stmt_id) { return; }
        let line2 = hir_unit_stmt_loc_line(self.h, stmt_id);
        if (line2 <= 0) { return; }
        self.unit.set_instr_loc(instr_id,
                                line2,
                                hir_unit_stmt_loc_col(self.h, stmt_id),
                                hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                hir_unit_stmt_loc_end_col(self.h, stmt_id));
    }

    public fn copy_instr_source_locs_since(self, instr_mark: i32) {
        var instr_id = instr_mark + 1;
        while (instr_id <= self.unit.instr_count) {
            self.copy_hir_source_loc_to_instr(instr_id);
            instr_id = instr_id + 1;
        }
    }

    public fn first_function_source_line(self, function_id: i32) -> i32 {
        var block_id = self.unit.function_first_block(function_id);
        while (block_id != mir_id_invalid()) {
            var instr_id = self.unit.block_first_instr(block_id);
            while (instr_id != mir_id_invalid()) {
                let line = self.unit.instr_loc_line(instr_id);
                if (line > 0) { return line; }
                instr_id = self.unit.instr_next(instr_id);
            }
            let block_line = self.unit.block_loc_line(block_id);
            if (block_line > 0) { return block_line; }
            block_id = self.unit.block_next(block_id);
        }
        return 1;
    }

    public fn copy_local_source_locs_since(self,
                                           local_mark: i32,
                                           function_id: i32,
                                           hir_function_id: i32) {
        let fallback_line = self.first_function_source_line(function_id);
        var local_id = local_mark + 1;
        while (local_id <= self.unit.local_count) {
            if (self.unit.local_function(local_id) == function_id) {
                let hir_local_id = self.unit.local_hir_id(local_id);
                var found: bool = false;
                var stmt_id: i32 = 1;
                while (!found && stmt_id <= self.h.stmt_count) {
                    if (self.h.stmt_function(stmt_id) == hir_function_id
                        && self.h.stmt_local(stmt_id) == hir_local_id) {
                        let line = hir_unit_stmt_loc_line(self.h, stmt_id);
                        if (line > 0) {
                            self.unit.set_local_loc(local_id,
                                                    line,
                                                    hir_unit_stmt_loc_col(self.h, stmt_id),
                                                    hir_unit_stmt_loc_end_line(self.h, stmt_id),
                                                    hir_unit_stmt_loc_end_col(self.h, stmt_id));
                            found = true;
                        }
                    }
                    stmt_id = stmt_id + 1;
                }
                if (!found) {
                    self.unit.set_local_loc(local_id,
                                            fallback_line,
                                            1,
                                            fallback_line,
                                            1);
                }
            }
            local_id = local_id + 1;
        }
    }

    public fn add_temp_place(self, type_id: i32, source_expr_id: i32, label: string) -> i32 {
        return self.add_temp_place_with_flags(type_id, source_expr_id, label, 0);
    }

    public fn add_temp_place_with_flags(self,
                                        type_id: i32,
                                        source_expr_id: i32,
                                        label: string,
                                        extra_flags: i32) -> i32 {
        let temp_name = label + "$" + policy_i64_to_string(source_expr_id as i64);
        let local_id = self.unit.add_local(
                                          self.current_function_id,
                                          hir_id_invalid(),
                                          temp_name,
                                          type_id,
                                          4 | extra_flags);
        let place_id = self.unit.add_place(
                                          self.current_function_id,
                                          mir_place_local(),
                                          type_id,
                                          local_id,
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          source_expr_id,
                                          temp_name);
        self.unit.set_local_place( local_id, place_id);
        return place_id;
    }

    public fn add_owned_temp_place(self,
                                   type_id: i32,
                                   source_expr_id: i32,
                                   label: string,
                                   drop_hir_function: i32) -> i32 {
        let temp_name = label + "$" + policy_i64_to_string(source_expr_id as i64);
        let hir_local = self.h.add_local(self.current_hir_function_id,
                                           temp_name,
                                           type_id,
                                           hir_local_flag_auto_drop());
        if (drop_hir_function != hir_id_invalid()) {
            self.h.set_local_drop_function(hir_local, drop_hir_function);
        }
        let local_id = self.unit.add_local(
                                          self.current_function_id,
                                          hir_local,
                                          temp_name,
                                          type_id,
                                          4 | mir_local_flag_auto_drop());
        let place_id = self.unit.add_place(
                                          self.current_function_id,
                                          mir_place_local(),
                                          type_id,
                                          local_id,
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          mir_id_invalid(),
                                          source_expr_id,
                                          temp_name);
        self.unit.set_local_place( local_id, place_id);
        mir_i32_map_put(self.local_map, hir_local, local_id);
        mir_i32_map_put(self.place_map, hir_local, place_id);
        self.drop_stack_push(hir_local);
        return place_id;
    }

    public fn add_const_i64_value(self, value: i64, source_expr_id: i32) -> i32 {
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_int(),
                                  self.i64_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  value,
                                  "",
                                  policy_i64_to_string(value));
    }

    public fn add_const_i32_value(self, value: i64, source_expr_id: i32) -> i32 {
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_int(),
                                  self.i32_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  value,
                                  "",
                                  policy_i64_to_string(value));
    }

    public fn add_const_bool_value(self, value: bool, source_expr_id: i32) -> i32 {
        var int_value: i64 = 0;
        var text_value = "false";
        if (value) {
            int_value = 1;
            text_value = "true";
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_const_bool(),
                                  self.bool_type_id(),
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  int_value,
                                  "",
                                  text_value);
    }

    public fn add_default_value_for_type(self, type_id: i32, source_expr_id: i32) -> i32 {
        if (type_id == hir_id_invalid()) { return mir_id_invalid(); }
        let kind = hir_type_table_kind(self.h.types, type_id);
        if (kind == ty_BOOL()) { return self.add_const_bool_value(false, source_expr_id); }
        var value_kind = mir_value_const_int();
        var text_value = "0";
        if (self.type_id_is_float(type_id)) {
            value_kind = mir_value_const_float();
            text_value = "0.0";
        } else if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF() || kind == ty_CLASS()) {
            value_kind = mir_value_null();
            text_value = "null";
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  value_kind,
                                  type_id,
                                  mir_id_invalid(),
                                  mir_target_none(),
                                  mir_id_invalid(),
                                  source_expr_id,
                                  0,
                                  0,
                                  0,
                                  "",
                                  text_value);
    }

    public fn add_assign_instr(self, place_id: i32, value_id: i32, source_stmt_id: i32, source_expr_id: i32, name: string) {
        if (place_id == mir_id_invalid() || value_id == mir_id_invalid()) { return; }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_assign(),
                           self.unit.place_type(place_id),
                           place_id,
                           value_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_target_none(),
                           mir_id_invalid(),
                           source_stmt_id,
                           source_expr_id,
                           0,
                           0,
                           name);
    }

    public fn emit_eval_value(self, value_id: i32, source_stmt_id: i32, source_expr_id: i32) {
        if (value_id == mir_id_invalid() || self.current_block_terminated()) { return; }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_eval(),
                           self.unit.value_type(value_id),
                           mir_id_invalid(),
                           value_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           self.unit.value_target_kind(value_id),
                           self.unit.value_target_id(value_id),
                           source_stmt_id,
                           source_expr_id,
                           0,
                           0,
                           self.unit.value_name(value_id));
    }

    public fn emit_assign(self, place_id: i32, value_id: i32, source_stmt_id: i32, source_expr_id: i32) {
        if (place_id == mir_id_invalid() || value_id == mir_id_invalid() || self.current_block_terminated()) { return; }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_assign(),
                           self.unit.place_type(place_id),
                           place_id,
                           value_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_target_none(),
                           mir_id_invalid(),
                           source_stmt_id,
                           source_expr_id,
                           0,
                           0,
                           self.unit.place_name(place_id));
        self.note_assignment_makes_local_live(place_id);
    }

    public fn materialize_return_value(self,
                                       value_id: i32,
                                       return_type_id: i32,
                                       source_stmt_id: i32,
                                       source_expr_id: i32) -> i32 {
        if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.type_text(return_type_id) == "void") { return mir_id_invalid(); }
        let result_place = self.add_temp_place(return_type_id, source_expr_id, "return");
        self.emit_assign(result_place, value_id, source_stmt_id, source_expr_id);
        return self.add_read_value(result_place, source_expr_id);
    }

    public fn hir_local_has_drop(self, hir_local_id: i32) -> bool {
        if (hir_local_id == hir_id_invalid()) { return false; }
        if (hir_unit_local_drop_function(self.h, hir_local_id) != hir_id_invalid()) { return true; }
        return self.hir_local_is_dci_stub_drop(hir_local_id);
    }

    public fn dci_stub_spec_field(self, line: string, index: i32) -> string {
        var cur: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= line.len) {
            var split = false;
            if (i == line.len) { split = true; }
            else if (line.charAt(i) == 9) { split = true; }
            if (split) {
                if (cur == index) { return line.substring(start, i); }
                cur = cur + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    public fn dci_stub_type_names_match(self, a: string, b: string) -> bool {
        if (a == b) { return true; }
        let aa = mir_builder_last_path_segment(policy_generic_call_base(a));
        let bb = mir_builder_last_path_segment(policy_generic_call_base(b));
        return aa.len > 0 && bb.len > 0 && aa == bb;
    }

    public fn hir_type_text_is_dci_stub_class(self, type_text: string) -> bool {
        if (type_text.len == 0) { return false; }
        let rows = hir_unit_dci_stub_specs(self.h);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= rows.len) {
            var split = false;
            if (i == rows.len) { split = true; }
            else if (rows.charAt(i) == 10) { split = true; }
            if (split) {
                let line = rows.substring(start, i).trim();
                if (self.dci_stub_spec_field(line, 0) == "class"
                    && self.dci_stub_type_names_match(self.dci_stub_spec_field(line, 1), type_text)) {
                    return true;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn hir_local_is_dci_stub_drop(self, hir_local_id: i32) -> bool {
        if (hir_local_id == hir_id_invalid()) { return false; }
        if ((self.h.local_flags(hir_local_id) & hir_local_flag_auto_drop()) == 0) { return false; }
        return self.hir_type_text_is_dci_stub_class(self.type_text(self.h.local_type(hir_local_id)));
    }

    public fn drop_stack_find(self, hir_local_id: i32) -> rawptr {
        var cur = self.drop_stack_head;
        while (cur != null) {
            if (ast_read_i32(cur) == hir_local_id) { return cur; }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return null;
    }

    public fn drop_stack_local_active(self, hir_local_id: i32) -> bool {
        let node = self.drop_stack_find(hir_local_id);
        if (node == null) { return false; }
        return ast_read_i32(ptr_offset(node, 4)) != 0;
    }

    public fn drop_stack_set_active(self, hir_local_id: i32, active: bool) {
        let node = self.drop_stack_find(hir_local_id);
        if (node == null) { return; }
        if (active) { ast_write_i32(ptr_offset(node, 4), 1); }
        else { ast_write_i32(ptr_offset(node, 4), 0); }
    }

    public fn drop_stack_snapshot(self) -> rawptr {
        var cur = self.drop_stack_head;
        var head: rawptr = null;
        while (cur != null) {
            let node = mir_profile_malloc(24);
            if (node != null) {
                memset(node, 0, 24);
                ast_write_rawptr(node, cur);
                ast_write_i32(ptr_offset(node, 8), ast_read_i32(ptr_offset(cur, 4)));
                ast_write_rawptr(ptr_offset(node, 16), head);
                head = node;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return head;
    }

    public fn drop_stack_restore_activity(self, snapshot: rawptr) {
        var cur = snapshot;
        while (cur != null) {
            let stack_node = ast_read_rawptr(cur);
            if (stack_node != null) {
                ast_write_i32(ptr_offset(stack_node, 4), ast_read_i32(ptr_offset(cur, 8)));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
    }

    public fn drop_stack_push(self, hir_local_id: i32) {
        if (!self.hir_local_has_drop(hir_local_id)) { return; }
        if (self.drop_stack_find(hir_local_id) != null) {
            self.drop_stack_set_active(hir_local_id, true);
            return;
        }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_local_id);
        ast_write_i32(ptr_offset(node, 4), 1);
        ast_write_rawptr(ptr_offset(node, 8), self.drop_stack_head);
        self.drop_stack_head = node;
    }

    public fn emit_drop_for_hir_local(self, hir_local_id: i32, source_stmt_id: i32, source_expr_id: i32, close_local: bool) {
        if (hir_local_id == hir_id_invalid() || self.current_block_terminated()) { return; }
        if (!self.drop_stack_local_active(hir_local_id)) { return; }
        let place_id = mir_i32_map_get(self.place_map, hir_local_id);
        let dci_stub_drop = self.hir_local_is_dci_stub_drop(hir_local_id);
        let drop_hir_fn = hir_unit_local_drop_function(self.h, hir_local_id);
        var drop_mir_fn = mir_id_invalid();
        if (!dci_stub_drop && drop_hir_fn != hir_id_invalid()) {
            drop_mir_fn = self.ensure_function_shell_for_hir(drop_hir_fn);
        }
        if (drop_mir_fn == mir_id_invalid() && !dci_stub_drop) { return; }
        var drop_target_kind = mir_target_function();
        if (drop_mir_fn == mir_id_invalid()) { drop_target_kind = mir_target_none(); }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_drop(),
                           self.h.local_type(hir_local_id),
                           place_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_id_invalid(),
                           drop_target_kind,
                           drop_mir_fn,
                           source_stmt_id,
                           source_expr_id,
                           0,
                           hir_local_id,
                           self.h.local_name(hir_local_id));
        if (close_local) { self.drop_stack_set_active(hir_local_id, false); }
    }

    public fn emit_drops_from_oldest_until(self, cur: rawptr, mark: rawptr, source_stmt_id: i32) {
        if (cur == null || cur == mark || self.current_block_terminated()) { return; }
        let next = ast_read_rawptr(ptr_offset(cur, 8));
        self.emit_drops_from_oldest_until(next, mark, source_stmt_id);
        if (self.current_block_terminated()) { return; }
        let hir_local_id = ast_read_i32(cur);
        self.emit_drop_for_hir_local(hir_local_id, source_stmt_id, hir_id_invalid(), true);
    }

    public fn emit_drops_until(self, mark: rawptr, source_stmt_id: i32) {
        self.emit_drops_from_oldest_until(self.drop_stack_head, mark, source_stmt_id);
        self.drop_stack_head = mark;
    }

    public fn emit_all_drops(self, source_stmt_id: i32) {
        self.emit_drops_until(null, source_stmt_id);
    }

    // Storage scope is deliberately separate from drop_stack.  The latter
    // contains only auto-drop locals, whereas every source let/var needs a
    // StorageDead boundary even when it has scalar/no destructor semantics.
    public fn push_labeled_loop(self,
                                 stmt_id: i32,
                                 break_block: i32,
                                 continue_block: i32,
                                 drop_mark: rawptr,
                                 defer_mark: rawptr,
                                 storage_mark: rawptr) {
        let name = self.h.stmt_name(stmt_id);
        if (name.len == 0) { return; }
        let node = mir_profile_malloc(80);
        if (node == null) { return; }
        memset(node, 0, 80);
        ast_write_rawptr(node, ast_dup_c_string(name));
        ast_write_i64(ptr_offset(node, 8), name.len);
        ast_write_i32(ptr_offset(node, 16), break_block);
        ast_write_i32(ptr_offset(node, 20), continue_block);
        ast_write_rawptr(ptr_offset(node, 24), drop_mark);
        ast_write_rawptr(ptr_offset(node, 32), drop_mark);
        ast_write_rawptr(ptr_offset(node, 40), defer_mark);
        ast_write_rawptr(ptr_offset(node, 48), defer_mark);
        ast_write_rawptr(ptr_offset(node, 56), storage_mark);
        ast_write_rawptr(ptr_offset(node, 64), storage_mark);
        ast_write_rawptr(ptr_offset(node, 72), self.labeled_loop_head);
        self.labeled_loop_head = node;
    }

    public fn pop_labeled_loop(self, stmt_id: i32) {
        let name = self.h.stmt_name(stmt_id);
        if (name.len == 0) { return; }
        let head = self.labeled_loop_head;
        if (head == null) { return; }
        self.labeled_loop_head = ast_read_rawptr(ptr_offset(head, 72));
    }

    public fn find_labeled_loop(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        var cur = self.labeled_loop_head;
        while (cur != null) {
            let nptr = ast_read_rawptr(cur);
            let nlen = ast_read_i64(ptr_offset(cur, 8));
            if (mir_builder_c_string_equals(nptr, nlen, name)) { return cur; }
            cur = ast_read_rawptr(ptr_offset(cur, 72));
        }
        return null;
    }

    // Storage scope is deliberately separate from drop_stack.  The latter
    // contains only auto-drop locals, whereas every source let/var needs a
    // StorageDead boundary even when it has scalar/no destructor semantics.
    public fn storage_stack_push(self, hir_local_id: i32) {
        if (hir_local_id == hir_id_invalid()) { return; }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_local_id);
        ast_write_rawptr(ptr_offset(node, 8), self.storage_stack_head);
        self.storage_stack_head = node;
    }

    public fn emit_storage_dead_for_hir_local(self, hir_local_id: i32, source_stmt_id: i32) {
        if (hir_local_id == hir_id_invalid() || self.current_block_terminated()) { return; }
        let place_id = mir_i32_map_get(self.place_map, hir_local_id);
        if (place_id == mir_id_invalid() || self.unit.place_kind(place_id) != mir_place_local()) { return; }
        let local_id = self.unit.place_local(place_id);
        if (local_id == mir_id_invalid()) { return; }
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_storage_dead(),
                           self.unit.place_type(place_id),
                           place_id,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_target_none(),
                           mir_id_invalid(),
                           source_stmt_id,
                           hir_id_invalid(),
                           0,
                           local_id,
                           self.h.local_name(hir_local_id));
    }

    public fn emit_storage_dead_from_oldest_until(self, cur: rawptr, mark: rawptr, source_stmt_id: i32) {
        if (cur == null || cur == mark || self.current_block_terminated()) { return; }
        let next = ast_read_rawptr(ptr_offset(cur, 8));
        self.emit_storage_dead_from_oldest_until(next, mark, source_stmt_id);
        if (self.current_block_terminated()) { return; }
        self.emit_storage_dead_for_hir_local(ast_read_i32(cur), source_stmt_id);
    }

    public fn emit_storage_dead_until(self, mark: rawptr, source_stmt_id: i32) {
        self.emit_storage_dead_from_oldest_until(self.storage_stack_head, mark, source_stmt_id);
        self.storage_stack_head = mark;
    }

    public fn defer_stack_push(self, hir_stmt_id: i32) {
        if (hir_stmt_id == hir_id_invalid()) { return; }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, hir_stmt_id);
        ast_write_rawptr(ptr_offset(node, 8), self.defer_stack_head);
        self.defer_stack_head = node;
    }

    public fn emit_defers_until(self, mark: rawptr, source_stmt_id: i32) {
        var cur = self.defer_stack_head;
        while (cur != null && cur != mark && !self.current_block_terminated()) {
            let stmt_id = ast_read_i32(cur);
            let next = ast_read_rawptr(ptr_offset(cur, 8));
            self.defer_stack_head = next;
            self.lower_stmt(self.h.stmt_child(stmt_id));
            cur = self.defer_stack_head;
        }
        self.defer_stack_head = mark;
    }

    public fn emit_scope_exit_until(self,
                                    defer_mark: rawptr,
                                    drop_mark: rawptr,
                                    storage_mark: rawptr,
                                    source_stmt_id: i32) {
        self.emit_defers_until(defer_mark, source_stmt_id);
        self.emit_drops_until(drop_mark, source_stmt_id);
        self.emit_storage_dead_until(storage_mark, source_stmt_id);
    }

    public fn emit_function_exit(self, source_stmt_id: i32) {
        self.emit_scope_exit_until(null, null, null, source_stmt_id);
    }

    // A constructor instance keeps its constructor identity on the HIR
    // function flag: the closed instance is filed under the mangled
    // `mir2$…` name, so the source-name test alone misses it.
    public fn hir_function_is_constructor_abi(self, hir_function_id: i32) -> bool {
        if (hir_function_id == hir_id_invalid()) { return false; }
        if ((hir_unit_function_flags(self.h, hir_function_id) & hir_function_flag_constructor()) != 0) { return true; }
        return self.h.function_name(hir_function_id) == "constructor";
    }

    // Check if a function should implicitly return the hidden constructor self.
    public fn return_type_is_constructor(self, hir_function_id: i32, return_type_id: i32) -> bool {
        if (!self.hir_function_is_constructor_abi(hir_function_id)) { return false; }
        let ret_text = self.type_text(return_type_id);
        if (ret_text == "void" || ret_text == "") { return false; }
        if (policy_primitive_type_kind(ret_text) != 0) { return false; }
        let local_id = self.h.function_first_local(hir_function_id);
        if (local_id == hir_id_invalid()) { return false; }
        return (self.h.local_flags(local_id) & hir_local_flag_self_receiver()) != 0;
    }

    // Create a read value (use site copy) for the self parameter, to return from a constructor.
    public fn implicit_self_return_value(self, hir_function_id: i32) -> i32 {
        let self_hir_local = self.h.function_first_local(hir_function_id);
        if (self_hir_local == hir_id_invalid()) { return mir_id_invalid(); }
        let mir_self_local = mir_i32_map_get(self.local_map, self_hir_local);
        if (mir_self_local == mir_id_invalid()) { return mir_id_invalid(); }
        let place_id = self.unit.local_place(mir_self_local);
        return self.add_read_value(place_id, hir_id_invalid());
    }

    public fn drop_local_for_place_before_reassign(self, place_id: i32, source_expr_id: i32) {
        if (place_id == mir_id_invalid()) { return; }
        if (self.unit.place_kind(place_id) != mir_place_local()) { return; }
        let mir_local_id = self.unit.place_local(place_id);
        let hir_local_id = self.unit.local_hir_id(mir_local_id);
        self.emit_drop_for_hir_local(hir_local_id, hir_id_invalid(), source_expr_id, false);
    }

    public fn emit_pointer_delete_for_place(self, place_id: i32, source_expr_id: i32) {
        if (place_id == mir_id_invalid() || self.unit.place_kind(place_id) != mir_place_local()) { return; }
        let pointer_type = self.unit.place_type(place_id);
        if (hir_type_table_kind(self.h.types, pointer_type) != ty_PTR()) { return; }
        let old_value = self.add_read_value(place_id, source_expr_id);
        if (old_value == mir_id_invalid()) { return; }
        let payload_type = hir_type_table_elem(self.h.types, pointer_type);
        let delete_value = self.unit.add_value(
                                              self.current_function_id,
                                              mir_value_intrinsic(),
                                              self.intern_type_id_by_text("void"),
                                              place_id,
                                              mir_target_type(),
                                              payload_type,
                                              source_expr_id,
                                              0,
                                              0,
                                              0,
                                              "__vyx_delete",
                                              self.type_text(payload_type));
        self.unit.set_value_lhs( delete_value, old_value);
        self.emit_eval_value(delete_value, hir_id_invalid(), source_expr_id);
    }

    public fn note_assignment_makes_local_live(self, place_id: i32) {
        if (place_id == mir_id_invalid()) { return; }
        if (self.unit.place_kind(place_id) != mir_place_local()) { return; }
        let mir_local_id = self.unit.place_local(place_id);
        let hir_local_id = self.unit.local_hir_id(mir_local_id);
        if (hir_local_id != hir_id_invalid() && self.hir_local_has_drop(hir_local_id)) {
            self.drop_stack_set_active(hir_local_id, true);
        }
    }

    public fn hir_local_for_place(self, place_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.place_kind(place_id) != mir_place_local()) { return hir_id_invalid(); }
        let mir_local_id = self.unit.place_local(place_id);
        return self.unit.local_hir_id(mir_local_id);
    }

    public fn expr_arg_chain_refs_hir_local(self, first_arg_id: i32, hir_local_id: i32) -> bool {
        if (hir_local_id == hir_id_invalid()) { return false; }
        var arg = first_arg_id;
        while (arg != hir_id_invalid()) {
            if (self.expr_refs_hir_local(arg, hir_local_id)) { return true; }
            arg = self.h.expr_next_arg(arg);
        }
        return false;
    }

    public fn stmt_tree_refs_hir_local(self, stmt_id: i32, hir_local_id: i32) -> bool {
        if (stmt_id == hir_id_invalid() || hir_local_id == hir_id_invalid()) { return false; }
        if (self.expr_refs_hir_local(self.h.stmt_expr(stmt_id), hir_local_id)
            || self.expr_refs_hir_local(self.h.stmt_cond(stmt_id), hir_local_id)) {
            return true;
        }
        if (self.stmt_chain_refs_hir_local(self.h.stmt_child(stmt_id), hir_local_id)
            || self.stmt_chain_refs_hir_local(self.h.stmt_else(stmt_id), hir_local_id)
            || self.stmt_chain_refs_hir_local(self.h.stmt_aux(stmt_id), hir_local_id)) {
            return true;
        }
        return false;
    }

    public fn stmt_chain_refs_hir_local(self, first_stmt_id: i32, hir_local_id: i32) -> bool {
        var cur = first_stmt_id;
        while (cur != hir_id_invalid()) {
            if (self.stmt_tree_refs_hir_local(cur, hir_local_id)) { return true; }
            cur = self.h.stmt_next(cur);
        }
        return false;
    }

    public fn expr_refs_hir_local(self, expr_id: i32, hir_local_id: i32) -> bool {
        if (expr_id == hir_id_invalid() || hir_local_id == hir_id_invalid()) { return false; }
        let k = self.h.expr_kind(expr_id);
        if (k == ex_IDENT()) {
            return self.h.expr_target_kind(expr_id) == hir_target_local()
                   && self.h.expr_target_id(expr_id) == hir_local_id;
        }
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_TERNARY()) {
            if (self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id)) { return true; }
            if (self.expr_refs_hir_local(self.h.expr_rhs(expr_id), hir_local_id)) { return true; }
            return self.expr_refs_hir_local(self.h.expr_aux(expr_id), hir_local_id);
        }
        if (k == ex_UNARY()
            || k == ex_ADDR_OF()
            || k == ex_DEREF()
            || k == ex_AWAIT()
            || k == ex_COMPTIME()
            || k == ex_FAIL()
            || k == ex_CAST()) {
            return self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id);
        }
        if (k == ex_CALL()) {
            if (self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id)) { return true; }
            return self.expr_arg_chain_refs_hir_local(self.h.expr_first_arg(expr_id), hir_local_id);
        }
        if (k == ex_MEMBER()) {
            return self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id);
        }
        if (k == ex_INDEX()) {
            if (self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id)) { return true; }
            return self.expr_refs_hir_local(self.h.expr_rhs(expr_id), hir_local_id);
        }
        if (k == ex_STRUCT_INIT()
            || k == ex_FSTRING()
            || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            return self.expr_arg_chain_refs_hir_local(self.h.expr_first_arg(expr_id), hir_local_id);
        }
        if (k == ex_ARRAY_LIT()) {
            if (self.expr_arg_chain_refs_hir_local(self.h.expr_first_arg(expr_id), hir_local_id)) { return true; }
            return self.expr_refs_hir_local(self.h.expr_aux(expr_id), hir_local_id);
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            if (self.expr_refs_hir_local(self.h.expr_lhs(expr_id), hir_local_id)) { return true; }
            if (k == ex_IF_EXPR()) {
                return self.expr_refs_hir_local(self.h.expr_aux(expr_id), hir_local_id);
            }
            return self.stmt_chain_refs_hir_local(self.h.expr_stmt_rhs(expr_id), hir_local_id);
        }
        if (k == ex_CLOSURE()) {
            if (self.expr_refs_hir_local(self.h.expr_rhs(expr_id), hir_local_id)) { return true; }
            return self.expr_refs_hir_local(self.h.expr_aux(expr_id), hir_local_id);
        }
        return false;
    }

    public fn assignment_rhs_refs_place_local(self, place_id: i32, rhs_expr_id: i32) -> bool {
        return self.expr_refs_hir_local(rhs_expr_id, self.hir_local_for_place(place_id));
    }

    public fn deactivate_moved_source_expr_except(self, expr_id: i32, except_hir_local_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let k = self.h.expr_kind(expr_id);
        if (k == ex_CAST() || k == ex_COMPTIME()
            || (k == ex_UNARY() && self.h.expr_op(expr_id) == unary_op_own())) {
            self.deactivate_moved_source_expr_except(self.h.expr_lhs(expr_id), except_hir_local_id);
            return;
        }
        if (k == ex_CALL()) {
            if (self.expr_is_variant_constructor_call(expr_id)) {
                self.deactivate_moved_arg_chain(self.h.expr_first_arg(expr_id), except_hir_local_id);
            }
            return;
        }
        if (k == ex_STRUCT_INIT() || k == ex_TUPLE_LIT() || k == ex_ARRAY_LIT()) {
            self.deactivate_moved_arg_chain(self.h.expr_first_arg(expr_id), except_hir_local_id);
            return;
        }
        if (k != ex_IDENT()) { return; }
        if (self.h.expr_target_kind(expr_id) != hir_target_local()) { return; }
        let hir_local_id = self.h.expr_target_id(expr_id);
        if (hir_local_id == hir_id_invalid() || hir_local_id == except_hir_local_id) { return; }
        if (!self.hir_local_has_drop(hir_local_id)) { return; }
        self.drop_stack_set_active(hir_local_id, false);
    }

    public fn expr_is_variant_constructor_call(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (self.h.expr_kind(expr_id) != ex_CALL()) { return false; }
        if (self.h.expr_target_kind(expr_id) == hir_target_variant()) { return true; }
        if (self.h.expr_sem_kind(expr_id) == expr_sem_VARIANT()) { return true; }
        let callee_expr_id = self.h.expr_lhs(expr_id);
        if (callee_expr_id == hir_id_invalid()) { return false; }
        if (self.h.expr_target_kind(callee_expr_id) == hir_target_variant()) { return true; }
        if (self.h.expr_sem_kind(callee_expr_id) == expr_sem_VARIANT()) { return true; }
        return false;
    }

    public fn deactivate_moved_arg_chain(self, first_arg_id: i32, except_hir_local_id: i32) {
        var arg = first_arg_id;
        while (arg != hir_id_invalid()) {
            self.deactivate_moved_source_expr_except(arg, except_hir_local_id);
            arg = self.h.expr_next_arg(arg);
        }
    }

    public fn first_user_param_for_call(self, hir_function_id: i32) -> i32 {
        var param = self.h.function_first_local(hir_function_id);
        if (param != hir_id_invalid()
            && (self.h.local_flags(param) & hir_local_flag_self_receiver()) != 0) {
            param = self.h.local_next(param);
        }
        return param;
    }

    public fn next_param_local(self, local_id: i32) -> i32 {
        var cur = self.h.local_next(local_id);
        while (cur != hir_id_invalid()) {
            if ((self.h.local_flags(cur) & hir_local_flag_param()) != 0) { return cur; }
            cur = self.h.local_next(cur);
        }
        return hir_id_invalid();
    }

    public fn deactivate_call_moved_prefix(self, call_expr_id: i32, prefix_expr_id: i32) {
        if (self.h.expr_target_kind(call_expr_id) != hir_target_function()) { return; }
        let hir_function_id = self.h.expr_target_id(call_expr_id);
        if (hir_function_id == hir_id_invalid()) { return; }
        let param = self.first_user_param_for_call(hir_function_id);
        if (param == hir_id_invalid()) { return; }
        if ((self.h.local_flags(param) & hir_local_flag_move_arg()) != 0) {
            self.deactivate_moved_source_expr_except(prefix_expr_id, hir_id_invalid());
        }
    }

    public fn deactivate_call_moved_args_from(self,
                                             call_expr_id: i32,
                                             first_arg_id: i32,
                                             skip_user_param_count: i32) {
        if (self.h.expr_target_kind(call_expr_id) != hir_target_function()) { return; }
        let hir_function_id = self.h.expr_target_id(call_expr_id);
        if (hir_function_id == hir_id_invalid()) { return; }
        var param = self.first_user_param_for_call(hir_function_id);
        var skip = skip_user_param_count;
        while (skip > 0 && param != hir_id_invalid()) {
            param = self.next_param_local(param);
            skip = skip - 1;
        }
        var arg = first_arg_id;
        while (arg != hir_id_invalid() && param != hir_id_invalid()) {
            if ((self.h.local_flags(param) & hir_local_flag_move_arg()) != 0) {
                self.deactivate_moved_source_expr_except(arg, hir_id_invalid());
            }
            arg = self.h.expr_next_arg(arg);
            param = self.next_param_local(param);
        }
    }

    public fn deactivate_call_moved_args(self, call_expr_id: i32) {
        if (call_expr_id != hir_id_invalid()
            && self.h.expr_target_kind(call_expr_id) == hir_target_builtin()) {
            let callee_expr_id = self.h.expr_lhs(call_expr_id);
            if (callee_expr_id != hir_id_invalid()) {
                let builtin_base = policy_generic_call_base(self.h.expr_name(callee_expr_id).clone());
                let first_arg = self.h.expr_first_arg(call_expr_id);
                if ((builtin_base == "new" || builtin_base == "construct")
                    && first_arg != hir_id_invalid()
                    && self.h.expr_next_arg(first_arg) == hir_id_invalid()) {
                    // Builtin one-argument value construction has no HIR
                    // function parameter record, so deactivate the source
                    // explicitly just as a consuming function call would;
                    // primitive/non-owning sources are naturally no-op.
                    self.deactivate_moved_source_expr_except(first_arg, hir_id_invalid());
                }
            }
            return;
        }
        self.deactivate_call_moved_args_from(call_expr_id, self.h.expr_first_arg(call_expr_id), 0);
    }

    public fn deactivate_call_moved_receiver(self, call_expr_id: i32) {
        if (call_expr_id == hir_id_invalid()) { return; }
        var target_fn = hir_id_invalid();
        if (self.h.expr_target_kind(call_expr_id) == hir_target_function()) {
            target_fn = self.h.expr_target_id(call_expr_id);
        }
        let callee = self.h.expr_lhs(call_expr_id);
        if (target_fn == hir_id_invalid()
            && callee != hir_id_invalid()
            && self.h.expr_target_kind(callee) == hir_target_function()) {
            target_fn = self.h.expr_target_id(callee);
        }
        if (target_fn == hir_id_invalid()) { return; }
        let first_param = self.h.function_first_local(target_fn);
        if (first_param == hir_id_invalid()
            || (self.h.local_flags(first_param) & hir_local_flag_self_receiver()) == 0
            || (self.h.local_flags(first_param) & hir_local_flag_move_arg()) == 0) {
            return;
        }
        if (callee == hir_id_invalid() || self.h.expr_kind(callee) != ex_MEMBER()) { return; }
        self.deactivate_moved_source_expr_except(self.h.expr_lhs(callee), hir_id_invalid());
    }

    public fn wrap_arg_value(self, payload_value_id: i32) -> i32 {
        if (payload_value_id == mir_id_invalid()) { return mir_id_invalid(); }
        let wrapper = self.unit.add_value(
                                         self.current_function_id,
                                         mir_value_arg(),
                                         self.unit.value_type(payload_value_id),
                                         mir_id_invalid(),
                                         mir_target_none(),
                                         mir_id_invalid(),
                                         self.unit.value_source_expr(payload_value_id),
                                         self.unit.value_flags(payload_value_id),
                                         self.unit.value_op(payload_value_id),
                                         self.unit.value_int(payload_value_id),
                                         self.unit.value_name(payload_value_id),
                                         self.unit.value_text(payload_value_id));
        if (wrapper == mir_id_invalid()) { return mir_id_invalid(); }
        self.unit.set_value_lhs( wrapper, payload_value_id);
        let field_id = self.unit.value_aggregate_field( payload_value_id);
        if (field_id != mir_id_invalid()) {
            self.unit.set_value_aggregate_field( wrapper, field_id);
        }
        return wrapper;
    }

    public fn append_value_arg(self, owner_value_id: i32, first_arg_id: i32, last_arg_id: i32, next_arg_id: i32) -> i32 {
        if (next_arg_id == mir_id_invalid()) { return last_arg_id; }
        let arg_node = self.wrap_arg_value(next_arg_id);
        if (arg_node == mir_id_invalid()) { return last_arg_id; }
        if (first_arg_id == mir_id_invalid()) {
            self.unit.set_value_first_arg( owner_value_id, arg_node);
        }
        if (last_arg_id != mir_id_invalid()) {
            self.unit.set_value_next_arg( last_arg_id, arg_node);
        }
        return arg_node;
    }

    public fn hir_arg_chain_has_named_arg(self, first_hir_arg_id: i32) -> bool {
        var cur = first_hir_arg_id;
        while (cur != hir_id_invalid()) {
            if (hir_unit_expr_arg_name(self.h, cur).len > 0) { return true; }
            cur = self.h.expr_next_arg(cur);
        }
        return false;
    }

    public fn hir_named_arg_for_param(self, first_hir_arg_id: i32, param_name: string) -> i32 {
        if (param_name.len == 0) { return hir_id_invalid(); }
        var cur = first_hir_arg_id;
        while (cur != hir_id_invalid()) {
            if (hir_unit_expr_arg_name(self.h, cur) == param_name) { return cur; }
            cur = self.h.expr_next_arg(cur);
        }
        return hir_id_invalid();
    }

    public fn next_positional_hir_arg(self, start_hir_arg_id: i32) -> i32 {
        var cur = start_hir_arg_id;
        while (cur != hir_id_invalid()) {
            if (hir_unit_expr_arg_name(self.h, cur).len == 0) { return cur; }
            cur = self.h.expr_next_arg(cur);
        }
        return hir_id_invalid();
    }

    public fn append_lowered_hir_arg(self,
                                     owner_value_id: i32,
                                     hir_arg_id: i32,
                                     expected_type_id: i32,
                                     first_arg_id: i32,
                                     last_arg_id: i32) -> i32 {
        if (hir_arg_id == hir_id_invalid()) { return last_arg_id; }
        var arg_value = mir_id_invalid();
        if (expected_type_id != hir_id_invalid()) {
            self.ensure_dyn_trait_methods_reachable(self.h.expr_type(hir_arg_id), expected_type_id);
            arg_value = self.lower_expr_as(hir_arg_id, expected_type_id);
        } else {
            arg_value = self.lower_expr(hir_arg_id);
        }
        if (arg_value == mir_id_invalid()) { return last_arg_id; }
        return self.append_value_arg(owner_value_id, first_arg_id, last_arg_id, arg_value);
    }

    public fn lower_named_call_arg_values_from(self,
                                               owner_value_id: i32,
                                               first_hir_arg_id: i32,
                                               target_mir_function_id: i32,
                                               first_arg_id: i32,
                                               last_arg_id: i32,
                                               skip_user_param_count: i32) -> bool {
        if (!self.hir_arg_chain_has_named_arg(first_hir_arg_id)) { return false; }
        if (target_mir_function_id == mir_id_invalid()) { return false; }
        let target_hir_function_id = self.unit.function_hir_id(target_mir_function_id);
        if (target_hir_function_id == hir_id_invalid()) { return false; }
        var first_arg = first_arg_id;
        var last_arg = last_arg_id;
        var param = self.first_user_param_for_call(target_hir_function_id);
        var skip = skip_user_param_count;
        while (skip > 0 && param != hir_id_invalid()) {
            param = self.next_param_local(param);
            skip = skip - 1;
        }
        var positional = first_hir_arg_id;
        while (param != hir_id_invalid()) {
            var hir_arg = self.hir_named_arg_for_param(first_hir_arg_id, self.h.local_name(param));
            if (hir_arg == hir_id_invalid()) {
                hir_arg = self.next_positional_hir_arg(positional);
                if (hir_arg != hir_id_invalid()) {
                    positional = self.h.expr_next_arg(hir_arg);
                }
            }
            if (hir_arg != hir_id_invalid()) {
                let previous_last_arg = last_arg;
                last_arg = self.append_lowered_hir_arg(owner_value_id,
                                                       hir_arg,
                                                       self.h.local_type(param),
                                                       first_arg,
                                                       last_arg);
                if (last_arg != previous_last_arg && self.param_local_moves_argument(param)) {
                    self.mark_value_tree_move_arg(last_arg, 0);
                }
                if (first_arg == mir_id_invalid()) {
                    first_arg = self.unit.value_first_arg(owner_value_id);
                }
            }
            param = self.next_param_local(param);
        }
        return true;
    }

    public fn lower_named_call_arg_values(self,
                                          owner_value_id: i32,
                                          first_hir_arg_id: i32,
                                          target_mir_function_id: i32) -> bool {
        return self.lower_named_call_arg_values_from(owner_value_id,
                                                     first_hir_arg_id,
                                                     target_mir_function_id,
                                                     mir_id_invalid(),
                                                     mir_id_invalid(),
                                                     0);
    }

    public fn field_id_for_type_and_name(self, owner_type_id: i32, field_name: string) -> i32 {
        if (owner_type_id == hir_id_invalid() || field_name.len == 0) { return hir_id_invalid(); }
        let owner_text = self.type_text(owner_type_id);
        if (owner_text.len > 0) {
            let cached = mir_pair_id_map_get(self.field_name_index,owner_text, field_name);
            if (cached != mir_id_invalid() && cached != -1) {
                self.ensure_field_layout_for_item(cached);
                return cached;
            }
        }
        let direct_owner_item = self.owner_item_for_layout_type(owner_type_id);
        if (direct_owner_item != hir_id_invalid()) {
            var item_id = self.first_field_item_for_owner(direct_owner_item);
            while (item_id != hir_id_invalid()) {
                if (self.h.item_name(item_id) == field_name) {
                    self.ensure_field_layout_for_item(item_id);
                    if (owner_text.len > 0) {
                        self.field_name_index = mir_pair_id_map_put(self.field_name_index,owner_text, field_name, item_id);
                    }
                    return item_id;
                }
                item_id = self.next_field_item(item_id);
            }
        }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_field()
                && self.h.item_name(item_id) == field_name) {
                let owner_item2 = self.h.item_owner(item_id);
                let field_owner_type2 = self.type_id_for_item(owner_item2);
                if (owner_item2 != hir_id_invalid()
                    && self.type_uses_closed_template_layout(owner_type_id, field_owner_type2, owner_item2)) {
                    self.ensure_field_layout_for_item(item_id);
                    if (owner_text.len > 0) {
                        self.field_name_index = mir_pair_id_map_put(self.field_name_index,owner_text, field_name, item_id);
                    }
                    return item_id;
                }
            }
            item_id = item_id + 1;
        }
        if (owner_text.len > 0) {
            self.field_name_index = mir_pair_id_map_put(self.field_name_index,owner_text, field_name, -1);
        }
        return hir_id_invalid();
    }

    public fn record_layout_fields_are_closed_for_owner_item(self, owner_item_id: i32) -> bool {
        if (owner_item_id == hir_id_invalid()) { return false; }
        var saw_field = false;
        var item_id = self.first_field_item_for_owner(owner_item_id);
        while (item_id != hir_id_invalid()) {
            saw_field = true;
            if (self.type_id_has_open_template_atom(self.h.item_type(item_id))) { return false; }
            item_id = self.next_field_item(item_id);
        }
        return saw_field;
    }

    public fn type_uses_closed_template_layout(self,
                                               concrete_type_id: i32,
                                               template_type_id: i32,
                                               template_owner_item_id: i32) -> bool {
        if (concrete_type_id == hir_id_invalid() || template_type_id == hir_id_invalid()) { return false; }
        let concrete_text = self.type_text(concrete_type_id);
        let template_text = self.type_text(template_type_id);
        if (concrete_text.len == 0 || template_text.len == 0) { return false; }
        if (policy_generic_call_has_args(concrete_text.clone()) == 0) { return false; }
        if (policy_generic_call_has_args(template_text.clone()) != 0) { return false; }
        let concrete_base = policy_generic_call_base(concrete_text.clone());
        if (!self.type_text_equivalent_at_depth(concrete_base, template_text, 0)) { return false; }
        return self.record_layout_fields_are_closed_for_owner_item(template_owner_item_id);
    }

    public fn field_id_for_type_and_index(self, owner_type_id: i32, field_index: i32) -> i32 {
        if (owner_type_id == hir_id_invalid() || field_index < 0) { return hir_id_invalid(); }
        let owner_text = self.type_text(owner_type_id);
        let index_text = policy_i64_to_string(field_index as i64);
        if (owner_text.len > 0) {
            let cached = mir_pair_id_map_get(self.field_ordinal_index,owner_text, index_text);
            if (cached != mir_id_invalid() && cached != -1) {
                self.ensure_field_layout_for_item(cached);
                return cached;
            }
        }
        let direct_owner_item = self.owner_item_for_layout_type(owner_type_id);
        if (direct_owner_item != hir_id_invalid()) {
            var item_id = self.first_field_item_for_owner(direct_owner_item);
            while (item_id != hir_id_invalid()) {
                var indexed_field = self.h.item_field_index(item_id);
                if (indexed_field < 0) {
                    indexed_field = self.field_index_in_owner(item_id, direct_owner_item);
                }
                if (indexed_field == field_index) {
                    self.ensure_field_layout_for_item(item_id);
                    if (owner_text.len > 0) {
                        self.field_ordinal_index = mir_pair_id_map_put(self.field_ordinal_index,owner_text, index_text, item_id);
                    }
                    return item_id;
                }
                item_id = self.next_field_item(item_id);
            }
        }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_field()) {
                let owner_item2 = self.h.item_owner(item_id);
                let field_owner_type2 = self.type_id_for_item(owner_item2);
                if (owner_item2 != hir_id_invalid()
                    && self.type_uses_closed_template_layout(owner_type_id, field_owner_type2, owner_item2)
                    && self.field_index_in_owner(item_id, owner_item2) == field_index) {
                    self.ensure_field_layout_for_item(item_id);
                    if (owner_text.len > 0) {
                        self.field_ordinal_index = mir_pair_id_map_put(self.field_ordinal_index,owner_text, index_text, item_id);
                    }
                    return item_id;
                }
            }
            item_id = item_id + 1;
        }
        if (owner_text.len > 0) {
            self.field_ordinal_index = mir_pair_id_map_put(self.field_ordinal_index,owner_text, index_text, -1);
        }
        return hir_id_invalid();
    }

    public fn variant_item_for_owner_type(self, owner_type_id: i32, variant_item_id: i32) -> i32 {
        if (owner_type_id == hir_id_invalid() || variant_item_id == hir_id_invalid()) { return variant_item_id; }
        let variant_name = self.h.item_name(variant_item_id);
        if (variant_name.len == 0) { return variant_item_id; }
        let current_owner_type = self.h.item_type(variant_item_id);
        if (current_owner_type == owner_type_id || self.type_text(current_owner_type) == self.type_text(owner_type_id)) {
            self.ensure_variant_layout_for_item(variant_item_id);
            return variant_item_id;
        }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_variant()
                && self.h.item_name(item_id) == variant_name) {
                let owner_item = self.h.item_owner(item_id);
                if (self.type_id_for_item(owner_item) == owner_type_id) {
                    self.ensure_variant_layout_for_item(item_id);
                    return item_id;
                }
            }
            item_id = item_id + 1;
        }
        self.ensure_variant_layout_for_item(variant_item_id);
        return variant_item_id;
    }

    public fn variant_payload_pattern_owner_text(self, variant_item_id: i32) -> string {
        if (variant_item_id == hir_id_invalid()) { return ""; }
        let direct = self.type_text(self.h.item_type(variant_item_id));
        if (direct.len > 0) { return direct; }
        return self.type_text(self.type_id_for_item(self.h.item_owner(variant_item_id)));
    }

    public fn variant_payload_type_id_for_owner(self,
                                                owner_type_id: i32,
                                                variant_item_id: i32,
                                                arg_index: i32) -> i32 {
        if (owner_type_id == hir_id_invalid() || variant_item_id == hir_id_invalid() || arg_index < 0) {
            return mir_id_invalid();
        }
        let payloads = self.h.item_variant_payload_types(variant_item_id);
        let payload_text = policy_generic_arg_at(payloads, arg_index);
        if (payload_text.len == 0) { return mir_id_invalid(); }
        let concrete_owner_text = self.type_text(owner_type_id);
        let pattern_owner_text = self.variant_payload_pattern_owner_text(variant_item_id);
        let specialized = self.specialize_type_text_for_owner(payload_text,
                                                              pattern_owner_text,
                                                              concrete_owner_text);
        return self.intern_type_id_by_text(specialized);
    }

    public fn lower_arg_values_from(self,
                                    owner_value_id: i32,
                                    first_hir_arg_id: i32,
                                    first_arg_id: i32,
                                    last_arg_id: i32,
                                    target_mir_function_id: i32,
                                    skip_user_param_count: i32) {
        var first_arg = first_arg_id;
        var last_arg = last_arg_id;
        let owner_is_aggregate = self.unit.value_kind(owner_value_id) == mir_value_aggregate();
        let owner_type_id = self.unit.value_type(owner_value_id);
        let owner_type_kind = hir_type_table_kind(self.h.types, owner_type_id);
        let owner_is_variant_call = self.unit.value_kind(owner_value_id) == mir_value_call()
            && self.unit.value_target_kind(owner_value_id) == mir_target_hir_variant();
        let owner_variant_id = self.unit.value_target_id(owner_value_id);
        var aggregate_arg_index: i32 = 0;
        var param = hir_id_invalid();
        var call_args_are_signature_bounded = false;
        if (!owner_is_aggregate
            && !owner_is_variant_call
            && self.unit.value_target_kind(owner_value_id) == mir_target_function()
            && target_mir_function_id != mir_id_invalid()) {
            let target_hir_function_id = self.unit.function_hir_id(target_mir_function_id);
            if (target_hir_function_id != hir_id_invalid()) {
                call_args_are_signature_bounded = true;
                param = self.first_user_param_for_call(target_hir_function_id);
                var skip = skip_user_param_count;
                while (skip > 0 && param != hir_id_invalid()) {
                    param = self.next_param_local(param);
                    skip = skip - 1;
                }
            }
        }
        var cur = first_hir_arg_id;
        while (cur != hir_id_invalid()) {
            if (call_args_are_signature_bounded && param == hir_id_invalid()) {
                if (target_mir_function_id == mir_id_invalid()
                    || (self.unit.function_flags(target_mir_function_id) & hir_function_flag_c_varargs()) == 0) {
                    break;
                }
            }
            var expected_arg_type = mir_id_invalid();
            if (owner_is_variant_call) {
                expected_arg_type = self.variant_payload_type_id_for_owner(owner_type_id,
                                                                           owner_variant_id,
                                                                           aggregate_arg_index);
            } else if (owner_is_aggregate && owner_type_kind != ty_ARRAY()) {
                // Unique rule: field initialization is a coercion site. The
                // field type is the expected type — same peel+dyn rule as
                // call arguments, let bindings, and returns.
                var field_id = hir_unit_expr_aggregate_field(self.h, cur);
                if (field_id == hir_id_invalid()) {
                    field_id = self.field_id_for_type_and_index(owner_type_id, aggregate_arg_index);
                }
                if (field_id != hir_id_invalid()) {
                    let mapped_field = self.field_id_for_type_and_name(owner_type_id, self.h.item_name(field_id));
                    if (mapped_field != hir_id_invalid()) { field_id = mapped_field; }
                    expected_arg_type = self.h.item_type(field_id);
                }
            } else if (param != hir_id_invalid()) {
                expected_arg_type = self.h.local_type(param);
            }
            var arg_value = mir_id_invalid();
            if (expected_arg_type != mir_id_invalid()) {
                self.ensure_dyn_trait_methods_reachable(self.h.expr_type(cur), expected_arg_type);
                arg_value = self.lower_expr_as(cur, expected_arg_type);
            } else {
                arg_value = self.lower_expr(cur);
            }
            if (arg_value != mir_id_invalid()) {
                var aggregate_field = hir_unit_expr_aggregate_field(self.h, cur);
                if (owner_is_aggregate && owner_type_kind != ty_ARRAY()) {
                    if (aggregate_field == hir_id_invalid()) {
                        aggregate_field = self.field_id_for_type_and_index(owner_type_id, aggregate_arg_index);
                    }
                }
                if (aggregate_field != hir_id_invalid()) {
                    let mapped_field = self.field_id_for_type_and_name(owner_type_id, self.h.item_name(aggregate_field));
                    if (mapped_field != hir_id_invalid()) { aggregate_field = mapped_field; }
                    self.unit.set_value_aggregate_field( arg_value, aggregate_field);
                }
                last_arg = self.append_value_arg(owner_value_id, first_arg, last_arg, arg_value);
                if (self.param_local_moves_argument(param) || owner_is_aggregate || owner_is_variant_call) {
                    self.mark_value_tree_move_arg(last_arg, 0);
                }
                if (first_arg == mir_id_invalid()) { first_arg = self.unit.value_first_arg(owner_value_id); }
                if (owner_is_aggregate) {
                    self.deactivate_moved_source_expr_except(cur, hir_id_invalid());
                }
                if (owner_is_aggregate) { aggregate_arg_index = aggregate_arg_index + 1; }
            }
            if (param != hir_id_invalid()) {
                param = self.next_param_local(param);
            }
            cur = self.h.expr_next_arg(cur);
        }
    }

    public fn lower_arg_values(self, owner_value_id: i32, first_hir_arg_id: i32) {
        self.lower_arg_values_from(owner_value_id,
                                   first_hir_arg_id,
                                   mir_id_invalid(),
                                   mir_id_invalid(),
                                   mir_id_invalid(),
                                   0);
    }

    public fn current_function_is_async_task(self) -> bool {
        if (self.current_function_id == mir_id_invalid()) { return false; }
        return (self.unit.function_flags(self.current_function_id) & hir_function_flag_async_task()) != 0;
    }

    public fn add_receiver_method_call(self,
                                         receiver_value: i32,
                                         target_fn: i32,
                                         result_type: i32,
                                         source_expr_id: i32,
                                         name: string) -> i32 {
        if (receiver_value == mir_id_invalid() || target_fn == mir_id_invalid()) {
            return mir_id_invalid();
        }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           self.unit.value_type(receiver_value),
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           0,
                                           0,
                                           0,
                                           name,
                                           "");
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           result_type,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           0,
                                           0,
                                           0,
                                           name,
                                           "");
        self.unit.set_value_lhs( call_value, callee_ref);
        return call_value;
    }

    public fn async_resume_block_for_index(self, index: i32) -> i32 {
        if (self.current_function_id == mir_id_invalid() || index <= 0) {
            return mir_id_invalid();
        }
        var block_id = self.unit.function_first_block(self.current_function_id);
        while (block_id != mir_id_invalid()) {
            if (self.unit.block_term_kind(block_id) == mir_term_yield()
                && self.unit.block_term_aux(block_id) == index) {
                return self.unit.block_term_target(block_id);
            }
            block_id = self.unit.block_next(block_id);
        }
        return mir_id_invalid();
    }

    public fn finish_async_dispatch(self, dispatch_block: i32, body_entry: i32) {
        if (dispatch_block == mir_id_invalid() || body_entry == mir_id_invalid()) { return; }
        if (self.unit.block_term_kind(dispatch_block) != mir_id_invalid()
            && self.unit.block_term_kind(dispatch_block) != 0) {
            return;
        }
        self.set_current_block(dispatch_block);
        if (self.async_pc_place_id == mir_id_invalid() || self.async_await_index <= 0) {
            if (!self.current_block_terminated()) {
                self.terminate_current_goto(body_entry);
            }
            return;
        }
        let pc_val = self.add_read_value(self.async_pc_place_id, hir_id_invalid());
        let zero = self.add_const_i32_value(0, hir_id_invalid());
        let eq0 = self.add_binary_value(self.bool_type_id(),
                                          tk_EQEQ(),
                                          pc_val,
                                          zero,
                                          hir_id_invalid(),
                                          "async.pc.eq0");
        var next_block = self.add_block(hir_id_invalid());
        self.terminate_current(mir_term_branch(),
                               eq0,
                               body_entry,
                               next_block,
                               mir_id_invalid(),
                               hir_id_invalid());
        var idx: i32 = 1;
        while (idx <= self.async_await_index) {
            self.set_current_block(next_block);
            let resume = self.async_resume_block_for_index(idx);
            let expected = self.add_const_i32_value(idx as i64, hir_id_invalid());
            let pc_again = self.add_read_value(self.async_pc_place_id, hir_id_invalid());
            let eq = self.add_binary_value(self.bool_type_id(),
                                            tk_EQEQ(),
                                            pc_again,
                                            expected,
                                            hir_id_invalid(),
                                            "async.pc.eq");
            var dest = resume;
            if (dest == mir_id_invalid()) { dest = body_entry; }
            if (idx == self.async_await_index) {
                let miss_block = self.add_block(hir_id_invalid());
                self.terminate_current(mir_term_branch(),
                                       eq,
                                       dest,
                                       miss_block,
                                       mir_id_invalid(),
                                       hir_id_invalid());
                self.set_current_block(miss_block);
                self.terminate_current(mir_term_unreachable(),
                                       mir_id_invalid(),
                                       mir_id_invalid(),
                                       mir_id_invalid(),
                                       mir_id_invalid(),
                                       hir_id_invalid());
            } else {
                next_block = self.add_block(hir_id_invalid());
                self.terminate_current(mir_term_branch(),
                                       eq,
                                       dest,
                                       next_block,
                                       mir_id_invalid(),
                                       hir_id_invalid());
            }
            idx = idx + 1;
        }
    }

    public fn lower_await_expr(self, expr_id: i32, type_id: i32) -> i32 {
        let receiver_expr = self.h.expr_lhs(expr_id);
        let receiver_value = self.lower_expr(receiver_expr);
        let target_fn = self.target_id_from_hir_expr(expr_id);
        if (self.current_function_is_async_task() && receiver_value != mir_id_invalid()) {
            let receiver_type = self.h.expr_type(receiver_expr);
            let poll_fn = self.function_target_by_owner_type_and_method(self.type_text(receiver_type), "poll");
            var take_fn = target_fn;
            if (take_fn == mir_id_invalid()) {
                take_fn = self.function_target_by_owner_type_and_method(self.type_text(receiver_type), "await_value");
            }
            if (poll_fn != mir_id_invalid() && take_fn != mir_id_invalid()) {
                self.async_await_index = self.async_await_index + 1;
                let await_index = self.async_await_index;
                let fut_place = self.add_temp_place(receiver_type, expr_id, "await.fut");
                self.emit_assign(fut_place, receiver_value, hir_id_invalid(), expr_id);
                let poll_block = self.add_block(hir_id_invalid());
                let yield_block = self.add_block(hir_id_invalid());
                let ready_block = self.add_block(hir_id_invalid());
                if (!self.current_block_terminated()) {
                    self.terminate_current_goto(poll_block);
                }
                self.set_current_block(poll_block);
                let fut_ref = self.add_read_value(fut_place, expr_id);
                let poll_call = self.add_receiver_method_call(fut_ref,
                                                                poll_fn,
                                                                self.bool_type_id(),
                                                                expr_id,
                                                                "poll");
                self.terminate_current(mir_term_branch(),
                                       poll_call,
                                       ready_block,
                                       yield_block,
                                       mir_id_invalid(),
                                       expr_id);
                self.set_current_block(yield_block);
                self.terminate_current(mir_term_yield(),
                                       fut_ref,
                                       poll_block,
                                       mir_id_invalid(),
                                       mir_id_invalid(),
                                       await_index);
                self.set_current_block(ready_block);
                let ready_fut = self.add_read_value(fut_place, expr_id);
                return self.add_receiver_method_call(ready_fut,
                                                     take_fn,
                                                     type_id,
                                                     expr_id,
                                                     "await_value");
            }
        }
        if (target_fn == mir_id_invalid()) {
            if (self.type_text(type_id) == "void") {
                if (receiver_value != mir_id_invalid()) { return receiver_value; }
                let yield_fn = self.function_target_by_name("__vio_await_yield");
                if (yield_fn != mir_id_invalid()) {
                    return self.add_direct_empty_arg_call(expr_id, type_id, yield_fn, "__vio_await_yield");
                }
            }
            let unresolved = self.unit.add_value(
                                               self.current_function_id,
                                               mir_value_intrinsic(),
                                               type_id,
                                               mir_id_invalid(),
                                               mir_target_none(),
                                               mir_id_invalid(),
                                               expr_id,
                                               hir_unit_expr_flags(self.h, expr_id),
                                               self.h.expr_op(expr_id),
                                               hir_unit_expr_int_value(self.h, expr_id),
                                               "await",
                                               self.type_text(self.h.expr_type(receiver_expr)));
            self.unit.set_value_lhs( unresolved, receiver_value);
            return unresolved;
        }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           self.h.expr_type(receiver_expr),
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "await_value",
                                           self.h.expr_name(expr_id));
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "await_value",
                                           self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( call_value, callee_ref);
        return call_value;
    }

    public fn function_target_by_name(self, name: string) -> i32 {
        if (name.len == 0) { return mir_id_invalid(); }
        let cached = mir_name_id_map_get(self.name_function_index,name);
        if (cached != mir_id_invalid() && self.function_has_executable_body(cached)) {
            self.mark_function_reachable(cached);
            return cached;
        }
        self.index_hir_function_lookups();
        let indexed_hir = mir_name_id_map_get(self.name_hir_function_index,name);
        if (indexed_hir != hir_id_invalid()) {
            let indexed_mir = self.indexed_hir_function_to_executable_mir(indexed_hir);
            if (indexed_mir != mir_id_invalid()) {
                self.name_function_index = mir_name_id_map_put(self.name_function_index,name, indexed_mir);
                self.mark_function_reachable(indexed_mir);
                return indexed_mir;
            }
        }
        var first_match: i32 = hir_id_invalid();
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.h.function_name(hir_fn) == name) {
                if (first_match == hir_id_invalid()) { first_match = hir_fn; }
                if (self.h.function_body(hir_fn) != hir_id_invalid()) {
                    let out = self.ensure_function_shell_for_hir(hir_fn);
                    if (out != mir_id_invalid() && self.function_has_executable_body(out)) {
                        self.name_function_index = mir_name_id_map_put(self.name_function_index,name, out);
                    }
                    return out;
                }
            }
            hir_fn = hir_fn + 1;
        }
        if (first_match != hir_id_invalid()) {
            return self.ensure_function_shell_for_hir(first_match);
        }
        return mir_id_invalid();
    }

    public fn type_text_is_awaitable(self, text: string) -> bool {
        let base = self.type_base_text(text);
        let last = mir_builder_last_path_segment(base);
        return last == "Task" || last == "Promise";
    }

    public fn awaitable_payload_type_id(self, type_id: i32) -> i32 {
        let text = self.type_text(type_id);
        if (!self.type_text_is_awaitable(text)) { return mir_id_invalid(); }
        let args = policy_generic_call_args(text.clone());
        var payload = policy_generic_arg_at(args, 0);
        if (payload.len == 0 || payload == "void") { payload = "i32"; }
        return self.type_id_by_text(payload);
    }

    public fn mark_async_call_support_reachable(self, target_fn: i32) {
        if (target_fn == mir_id_invalid()) { return; }
        self.mark_function_reachable(target_fn);
        self.function_target_by_name("vio_promise_state_new");
        self.function_target_by_name("vio_sched_spawn");
        self.function_target_by_name("vio_promise_state_reject");
        self.function_target_by_name("malloc");
        self.function_target_by_name("free");
        let return_type_id = self.unit.function_return_type(target_fn);
        let return_text = self.type_text(return_type_id);
        if (return_text.len > 0 && self.type_text_is_awaitable(return_text)) {
            self.function_target_by_owner_type_and_method(return_text, "await_value");
            self.function_target_by_owner_type_and_method(return_text, "poll");
            self.function_target_by_owner_type_and_method(return_text, "resolve");
            self.function_target_by_owner_type_and_method(return_text, "drop");
        }
        self.function_target_by_name("vio_async_frame_set");
        self.function_target_by_name("vio_async_frame_get");
        self.function_target_by_name("vio_async_pending_set");
        self.function_target_by_name("vio_async_take_pending");
    }

    public fn function_name_matches_method_direct(self, function_name: string, method_name: string) -> bool {
        if (function_name == method_name) { return true; }
        if (method_name.len == 0) { return false; }
        if (mir_builder_method_marker_matches(function_name, "::" + method_name)) { return true; }
        if (mir_builder_string_contains(function_name, "_3A_3A" + method_name + "_3A_3A")) { return true; }
        let encoded_method = mir_builder_symbol_segment_for_name(method_name);
        if (encoded_method != method_name) {
            return mir_builder_string_contains(function_name, "_3A_3A" + encoded_method + "_3A_3A");
        }
        return false;
    }

    public fn function_name_matches_method(self, function_name: string, method_name: string) -> bool {
        if (self.function_name_matches_method_direct(function_name, method_name)) { return true; }
        let legacy = policy_operator_legacy_method_name(method_name);
        if (legacy.len > 0 && self.function_name_matches_method_direct(function_name, legacy)) { return true; }
        let symbol = policy_operator_symbol_method_name(method_name);
        if (symbol.len > 0 && self.function_name_matches_method_direct(function_name, symbol)) { return true; }
        return false;
    }

    public fn function_has_executable_body(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_has_open_template_types(function_id)) { return false; }
        if (self.unit.function_first_block(function_id) != mir_id_invalid()) { return true; }
        if (self.unit.function_item_kind(function_id) == hir_item_extern_function()) { return true; }
        if ((self.unit.function_flags( function_id) & hir_function_flag_foreign_dci()) != 0) {
            return true;
        }
        if (self.function_is_imported_callable_declaration(function_id)) {
            return true;
        }
        let hir_fn = self.unit.function_hir_id(function_id);
        if (hir_fn == hir_id_invalid()) { return false; }
        return self.h.function_body(hir_fn) != hir_id_invalid();
    }

    public fn hir_function_can_materialize_executable_body(self, hir_fn: i32) -> bool {
        if (hir_fn == hir_id_invalid()) { return false; }
        if (hir_fn < 1 || hir_fn > self.h.function_count) { return false; }
        if (self.hir_function_has_open_template_types(hir_fn)) { return false; }
        if (self.h.function_body(hir_fn) != hir_id_invalid()) { return true; }
        if (!self.has_hir_codegen_builder) { return false; }
        if ((hir_unit_function_flags(self.h, hir_fn) & hir_function_flag_declaration_only()) != 0) {
            return false;
        }
        let item_id = self.h.function_item(hir_fn);
        if (item_id == hir_id_invalid()) { return false; }
        let owner_item = self.h.item_owner(item_id);
        if (owner_item != hir_id_invalid()
            && self.h.item_kind(owner_item) == hir_item_interface()) {
            return false;
        }
        return true;
    }

    /// True when the HIR builder could rebuild this function's body from its
    /// source declaration after the body has been released.  Unlike
    /// `hir_function_can_materialize_executable_body` this is a property of the
    /// function's provenance, so it stays true while the body is still present
    /// and stays false for a body that was synthesized inline (a lambda's
    /// `closure$N` function) and therefore cannot be rebuilt at all.
    public fn hir_function_body_is_recoverable(self, hir_fn: i32) -> bool {
        if (!self.has_hir_codegen_builder) { return false; }
        if (hir_fn == hir_id_invalid()) { return false; }
        return hir_codegen_builder_handle_function_body_is_recoverable(self.hir_codegen_builder, hir_fn);
    }

    public fn function_can_reach_executable_body(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_has_executable_body(function_id)) { return true; }
        return self.hir_function_can_materialize_executable_body(self.unit.function_hir_id(function_id));
    }

    public fn function_is_imported_callable_declaration(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.unit.function_first_block(function_id) != mir_id_invalid()) { return false; }
        if ((self.unit.function_flags( function_id) & hir_function_flag_imported_body()) == 0) { return false; }
        let name = self.unit.function_name(function_id);
        if (name.len >= 5 && name.substring(0, 5) == "mir2$") { return false; }
        if (self.unit.function_generic_args( function_id).len > 0) { return false; }
        return true;
    }

    public fn record_layout_prefix_compatible(self, derived_type_id: i32, prefix_type_id: i32) -> bool {
        if (derived_type_id == hir_id_invalid() || prefix_type_id == hir_id_invalid()) { return false; }
        if (self.type_ids_equivalent(derived_type_id, prefix_type_id)) { return true; }
        if (hir_type_table_kind(self.h.types, derived_type_id) != ty_CLASS()
            || hir_type_table_kind(self.h.types, prefix_type_id) != ty_CLASS()) {
            return false;
        }
        let derived_count = self.unit.field_count_for_type( derived_type_id);
        let prefix_count = self.unit.field_count_for_type( prefix_type_id);
        if (derived_count <= 0 || prefix_count <= 0 || prefix_count > derived_count) { return false; }
        var idx: i32 = 0;
        while (idx < prefix_count) {
            let derived_field = self.unit.field_id_for_type_index( derived_type_id, idx);
            let prefix_field = self.unit.field_id_for_type_index( prefix_type_id, idx);
            if (derived_field == hir_id_invalid() || prefix_field == hir_id_invalid()) { return false; }
            if (self.unit.field_name( derived_field) != self.unit.field_name( prefix_field)) {
                return false;
            }
            if (!self.type_ids_equivalent(self.unit.field_type( derived_field),
                                          self.unit.field_type( prefix_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn function_receiver_specificity_for_owner_type(self, hir_fn: i32, owner_type_id: i32) -> i32 {
        if (hir_fn == hir_id_invalid() || owner_type_id == hir_id_invalid()) { return 0; }
        let first_local = self.h.function_first_local(hir_fn);
        if (first_local == hir_id_invalid()) { return 0; }
        if ((self.h.local_flags(first_local) & hir_local_flag_self_receiver()) == 0) { return 0; }
        let self_type = self.h.local_type(first_local);
        if (self.type_ids_equivalent(owner_type_id, self_type)) { return 3; }
        if (self.record_layout_prefix_compatible(owner_type_id, self_type)) { return 1; }
        return 0;
    }

    public fn inherited_function_target_by_owner_type_and_method(self, owner_type: string, method_name: string) -> i32 {
        if (owner_type.len == 0 || method_name.len == 0) { return mir_id_invalid(); }
        let owner_type_id = self.type_id_by_text(owner_type);
        if (owner_type_id == hir_id_invalid()) { return mir_id_invalid(); }
        var best_match = mir_id_invalid();
        var best_specificity: i32 = 0;
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.function_name_matches_method(self.h.function_name(hir_fn), method_name)
                && !self.hir_function_has_open_template_types(hir_fn)) {
                let specificity = self.function_receiver_specificity_for_owner_type(hir_fn, owner_type_id);
                if (specificity > best_specificity) {
                    let candidate = self.ensure_function_shell_for_hir_quiet(hir_fn);
                    if (candidate != mir_id_invalid() && self.function_can_reach_executable_body(candidate)) {
                        best_match = candidate;
                        best_specificity = specificity;
                    }
                }
            }
            hir_fn = hir_fn + 1;
        }
        if (best_match != mir_id_invalid()) {
            self.owner_method_function_index = mir_pair_id_map_put(self.owner_method_function_index,owner_type, method_name, best_match);
            self.mark_function_reachable(best_match);
        }
        return best_match;
    }

    public fn function_has_open_template_types(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        let hir_fn = self.unit.function_hir_id(function_id);
        if (hir_fn == hir_id_invalid()) { return false; }
        return self.hir_function_has_open_template_types(hir_fn);
    }

    // Recover a static member only when its owner/name/arity identify one
    // imported declaration unambiguously.  Normal calls retain their exact
    // Sema-selected HIR target; this is solely the delayed-materialization
    // fallback for legacy call nodes whose target field stayed empty.
    public fn static_method_target_by_owner_type_and_call(self,
                                                              owner_type: string,
                                                              method_name: string,
                                                              call_expr_id: i32) -> i32 {
        if (owner_type.len == 0 || method_name.len == 0 || call_expr_id == hir_id_invalid()) {
            return mir_id_invalid();
        }
        var arg_count: i32 = 0;
        var arg_id = self.h.expr_first_arg(call_expr_id);
        while (arg_id != hir_id_invalid()) {
            arg_count = arg_count + 1;
            arg_id = self.h.expr_next_arg(arg_id);
        }
        var selected_match = mir_id_invalid();
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.owner_type_text_for_hir_function(hir_fn) == owner_type
                && self.function_name_matches_method(self.h.function_name(hir_fn), method_name)
                && !self.hir_function_has_open_template_types(hir_fn)) {
                let first_local = self.h.function_first_local(hir_fn);
                let has_self = first_local != hir_id_invalid()
                    && (self.h.local_flags(first_local) & hir_local_flag_self_receiver()) != 0;
                if (!has_self) {
                    var param_count: i32 = 0;
                    var local_id = first_local;
                    while (local_id != hir_id_invalid()) {
                        if ((self.h.local_flags(local_id) & hir_local_flag_param()) != 0) {
                            param_count = param_count + 1;
                        }
                        local_id = self.h.local_next(local_id);
                    }
                    if (param_count == arg_count) {
                        let candidate = self.ensure_function_shell_for_hir_quiet(hir_fn);
                        if (candidate != mir_id_invalid()) {
                            if (selected_match != mir_id_invalid() && selected_match != candidate) {
                                return mir_id_invalid();
                            }
                            selected_match = candidate;
                        }
                    }
                }
            }
            hir_fn = hir_fn + 1;
        }
        return selected_match;
    }

    public fn method_call_candidate_score(self,
                                          hir_fn: i32,
                                          owner_type: string,
                                          call_expr_id: i32,
                                          want_static: bool) -> i32 {
        if (hir_fn == hir_id_invalid()
            || owner_type.len == 0
            || call_expr_id == hir_id_invalid()
            || self.hir_function_has_open_template_types(hir_fn)) {
            return -1;
        }
        let candidate_owner = self.owner_type_text_for_hir_function(hir_fn);
        var score: i32 = 0;
        if (candidate_owner == owner_type) {
            score = 64;
        } elif (candidate_owner.len > 0 && policy_type_name_equal(candidate_owner, owner_type)) {
            score = 48;
        } else {
            return -1;
        }

        let first_local = self.h.function_first_local(hir_fn);
        let has_self = first_local != hir_id_invalid()
            && (self.h.local_flags(first_local) & hir_local_flag_self_receiver()) != 0;
        // Partial-module peer interfaces can lose the original receiver
        // semantic on a chained call (for example
        // `AppSurface.card(...).padding(...).child(...)`).  In that case
        // `want_static` may be inferred from the owner expression shape
        // rather than the resolved callable and can incorrectly match the
        // opposite calling convention.  Keep both candidates in the
        // ranking, preferring the convention indicated by Sema instead of
        // discarding the only valid imported declaration.
        if (want_static != has_self) {
            score = score + 8;
        } else {
            score = score + 1;
        }

        var param = first_local;
        if (has_self) {
            let owner_type_id = self.type_id_by_text(owner_type);
            if (owner_type_id != hir_id_invalid()) {
                let self_type_id = self.h.local_type(first_local);
                if (self.type_ids_equivalent(owner_type_id, self_type_id)) {
                    score = score + 16;
                }
            }
            param = self.h.local_next(param);
        }

        let first_arg = self.h.expr_first_arg(call_expr_id);
        let has_named_args = self.hir_arg_chain_has_named_arg(first_arg);
        var positional_arg = first_arg;
        var matched_params: i32 = 0;
        while (param != hir_id_invalid()) {
            if ((self.h.local_flags(param) & hir_local_flag_param()) == 0) {
                param = self.h.local_next(param);
                continue;
            }
            var arg = hir_id_invalid();
            if (has_named_args) {
                arg = self.hir_named_arg_for_param(first_arg, self.h.local_name(param));
                if (arg == hir_id_invalid()) {
                    arg = self.next_positional_hir_arg(positional_arg);
                    if (arg != hir_id_invalid()) {
                        positional_arg = self.h.expr_next_arg(arg);
                    }
                }
            } else {
                arg = positional_arg;
                if (arg != hir_id_invalid()) {
                    positional_arg = self.h.expr_next_arg(arg);
                }
            }
            if (arg == hir_id_invalid()) { return -1; }
            let arg_type = self.h.expr_type(arg);
            let param_type = self.h.local_type(param);
            if (arg_type == param_type) {
                score = score + 16;
            } elif (arg_type != hir_id_invalid()
                    && param_type != hir_id_invalid()
                    && self.type_ids_equivalent(arg_type, param_type)) {
                score = score + 12;
            } elif (arg_type != hir_id_invalid()
                    && param_type != hir_id_invalid()
                    && self.type_is_dyn_trait(param_type)
                    && self.type_text_matches_dyn_trait(self.type_text(arg_type), param_type)) {
                score = score + 4;
            } else {
                // Sema has already accepted this call.  Deferred partial-module
                // recovery only ranks duplicate imported declarations; literal
                // coercions and other implicit conversions need not have made
                // the HIR argument type identical to the formal type yet.
                score = score + 1;
            }
            matched_params = matched_params + 1;
            param = self.h.local_next(param);
        }

        var arg_count: i32 = 0;
        var arg_cursor = first_arg;
        while (arg_cursor != hir_id_invalid()) {
            arg_count = arg_count + 1;
            arg_cursor = self.h.expr_next_arg(arg_cursor);
        }
        if (arg_count != matched_params) { return -1; }

        let call_type = self.h.expr_type(call_expr_id);
        let return_type = self.h.function_return_type(hir_fn);
        if (call_type != hir_id_invalid()
            && return_type != hir_id_invalid()
            && hir_type_table_kind(self.h.types, call_type) != ty_VOID()) {
            if (call_type == return_type) {
                score = score + 8;
            } elif (self.type_ids_equivalent(call_type, return_type)) {
                score = score + 4;
            }
        }
        return score;
    }

    public fn imported_method_target_by_owner_type_and_call(self,
                                                             owner_type: string,
                                                             method_name: string,
                                                             call_expr_id: i32,
                                                             want_static: bool) -> i32 {
        if (owner_type.len == 0 || method_name.len == 0 || call_expr_id == hir_id_invalid()) {
            return mir_id_invalid();
        }
        var best_fn = hir_id_invalid();
        var best_score: i32 = -1;
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.function_name_matches_method(self.h.function_name(hir_fn), method_name)) {
                let score = self.method_call_candidate_score(hir_fn,
                                                             owner_type,
                                                             call_expr_id,
                                                             want_static);
                if (score > best_score) {
                    best_fn = hir_fn;
                    best_score = score;
                }
            }
            hir_fn = hir_fn + 1;
        }
        if (best_fn == hir_id_invalid()) { return mir_id_invalid(); }
        return self.ensure_function_shell_for_hir_quiet(best_fn);
    }

    // Last-resort recovery for a chained peer call whose receiver type was
    // erased to void/rawptr (or another primitive placeholder).  The method
    // name plus the already-checked argument signature is still sufficient in
    // the partial-module HIR; prefer the highest scoring instance declaration.
    public fn imported_method_target_by_name_and_call(self,
                                                       method_name: string,
                                                       call_expr_id: i32) -> i32 {
        if (method_name.len == 0 || call_expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        var best_fn = hir_id_invalid();
        var best_score: i32 = -1;
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.function_name_matches_method(self.h.function_name(hir_fn), method_name)
                && !self.hir_function_has_open_template_types(hir_fn)) {
                let first_local = self.h.function_first_local(hir_fn);
                let has_self = first_local != hir_id_invalid()
                    && (self.h.local_flags(first_local) & hir_local_flag_self_receiver()) != 0;
                if (has_self) {
                    var param = self.h.local_next(first_local);
                    let first_arg = self.h.expr_first_arg(call_expr_id);
                    var arg = first_arg;
                    var score: i32 = 0;
                    var ok = true;
                    while (param != hir_id_invalid()) {
                        if ((self.h.local_flags(param) & hir_local_flag_param()) != 0) {
                            if (arg == hir_id_invalid()) { ok = false; break; }
                            let arg_type = self.h.expr_type(arg);
                            let param_type = self.h.local_type(param);
                            if (arg_type == param_type) { score = score + 16; }
                            elif (arg_type != hir_id_invalid() && param_type != hir_id_invalid()
                                  && self.type_ids_equivalent(arg_type, param_type)) { score = score + 12; }
                            else { score = score + 1; }
                            arg = self.h.expr_next_arg(arg);
                        }
                        param = self.h.local_next(param);
                    }
                    if (ok && arg == hir_id_invalid()) {
                        if (score > best_score) {
                            best_fn = hir_fn;
                            best_score = score;
                        }
                    }
                }
            }
            hir_fn = hir_fn + 1;
        }
        if (best_fn == hir_id_invalid()) { return mir_id_invalid(); }
        return self.ensure_function_shell_for_hir_quiet(best_fn);
    }

    public fn function_target_by_owner_type_and_method(self, owner_type: string, method_name: string) -> i32 {
        if (owner_type.len == 0 || method_name.len == 0) { return mir_id_invalid(); }
        let cached = mir_pair_id_map_get(self.owner_method_function_index,owner_type, method_name);
        if (cached != mir_id_invalid() && self.function_can_reach_executable_body(cached)) {
            self.mark_function_reachable(cached);
            return cached;
        }
        let indexed = self.indexed_method_target(owner_type, method_name);
        if (indexed != mir_id_invalid() && self.function_can_reach_executable_body(indexed)) {
            self.owner_method_function_index = mir_pair_id_map_put(self.owner_method_function_index,owner_type, method_name, indexed);
            self.mark_function_reachable(indexed);
            return indexed;
        }
        var first_match = mir_id_invalid();
        var fn_id: i32 = 1;
        while (fn_id <= self.unit.function_count) {
            if (self.unit.function_owner_type(fn_id) == owner_type
                && self.function_name_matches_method(self.unit.function_name(fn_id), method_name)) {
                if (first_match == mir_id_invalid()) { first_match = fn_id; }
                if (self.function_can_reach_executable_body(fn_id)) {
                    self.owner_method_function_index = mir_pair_id_map_put(self.owner_method_function_index,owner_type, method_name, fn_id);
                    self.mark_function_reachable(fn_id);
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            if (self.owner_type_text_for_hir_function(hir_fn) == owner_type
                && self.function_name_matches_method(self.h.function_name(hir_fn), method_name)
                && !self.hir_function_has_open_template_types(hir_fn)) {
                let candidate = self.ensure_function_shell_for_hir_quiet(hir_fn);
                if (candidate != mir_id_invalid()) {
                    if (first_match == mir_id_invalid()) { first_match = candidate; }
                    if (self.function_can_reach_executable_body(candidate)) {
                        self.owner_method_function_index = mir_pair_id_map_put(self.owner_method_function_index,owner_type, method_name, candidate);
                        self.mark_function_reachable(candidate);
                        return candidate;
                    }
                }
            }
            hir_fn = hir_fn + 1;
        }
        return self.inherited_function_target_by_owner_type_and_method(owner_type, method_name);
    }

    public fn executable_method_target_by_receiver_type(self, receiver_type_id: i32, method_name: string) -> i32 {
        if (receiver_type_id == mir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        let receiver_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(receiver_type_id));
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        let owner_match = self.function_target_by_owner_type_and_method(receiver_text, method_name);
        if (owner_match != mir_id_invalid()) { return owner_match; }
        return mir_id_invalid();
    }

    public fn executable_method_target_by_receiver_expr(self, receiver_expr_id: i32, method_name: string) -> i32 {
        if (receiver_expr_id == hir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        if (self.h.expr_sem_kind(receiver_expr_id) == expr_sem_CLASS()) {
            let owner_text = self.resolve_type_text_in_function(self.current_function_id,
                                                                self.h.expr_name(receiver_expr_id));
            if (owner_text.len > 0) {
                let owner_match = self.function_target_by_owner_type_and_method(owner_text, method_name);
                if (owner_match != mir_id_invalid()) { return owner_match; }
            }
        }
        return self.executable_method_target_by_receiver_type(self.h.expr_type(receiver_expr_id), method_name);
    }

    public fn executable_method_target_for_call(self, call_expr_id: i32, target_fn: i32) -> i32 {
        if (target_fn != mir_id_invalid()
            && self.unit.function_owner_item_kind(target_fn) != hir_item_interface()) {
            let target_hir_fn = self.unit.function_hir_id(target_fn);
            if (target_hir_fn == hir_id_invalid()
                || !self.hir_function_has_open_template_types(target_hir_fn)) {
                if (self.function_can_reach_executable_body(target_fn)) {
                    return target_fn;
                }
            }
        }
        let callee_expr = self.h.expr_lhs(call_expr_id);
        if (callee_expr == hir_id_invalid()) { return target_fn; }
        if (self.h.expr_kind(callee_expr) != ex_MEMBER()) { return target_fn; }
        let receiver_expr = self.h.expr_lhs(callee_expr);
        if (receiver_expr == hir_id_invalid()) { return target_fn; }
        let method_name = self.h.expr_name(callee_expr);
        let resolved = self.executable_method_target_by_receiver_expr(receiver_expr, method_name);
        if (resolved == mir_id_invalid()) { return target_fn; }
        if (target_fn == mir_id_invalid()) { return resolved; }
        if (self.unit.function_owner_item_kind(target_fn) == hir_item_interface()
            && self.unit.function_owner_item_kind(resolved) != hir_item_interface()
            && self.function_can_reach_executable_body(resolved)) {
            return resolved;
        }
        if (!self.function_can_reach_executable_body(target_fn)
            && self.function_can_reach_executable_body(resolved)) {
            return resolved;
        }
        return target_fn;
    }

    public fn mark_iterator_method_reachable(self, receiver_type_id: i32, method_name: string) {
        let method_fn = self.executable_method_target_by_receiver_type(receiver_type_id, method_name);
        if (method_fn != mir_id_invalid()) {
            self.mark_function_reachable(method_fn);
        }
    }

    public fn mark_foreach_iterator_methods_reachable(self, iter_type_id: i32) {
        if (iter_type_id == hir_id_invalid()) { return; }
        self.mark_iterator_method_reachable(iter_type_id, "has_next");
        self.mark_iterator_method_reachable(iter_type_id, "next");
    }

    public fn lower_string_foreach_iterator(self, receiver_value: i32, source_expr_id: i32) -> i32 {
        if (receiver_value == mir_id_invalid()) { return mir_id_invalid(); }
        let receiver_type = self.unit.value_type(receiver_value);
        let receiver_kind = hir_type_table_kind(self.unit.types, receiver_type);
        let receiver_text = self.type_text(receiver_type);
        let receiver_base = mir_builder_last_path_segment(policy_generic_call_base(receiver_text.clone()));
        if (receiver_kind != ty_STRING() && receiver_base != "String") { return receiver_value; }

        let target_fn = self.executable_method_target_by_receiver_type(receiver_type, "iter");
        if (target_fn == mir_id_invalid()) { return receiver_value; }
        let result_type = self.unit.function_return_type(target_fn);
        if (result_type == mir_id_invalid()) { return receiver_value; }
        self.mark_function_reachable(target_fn);

        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           result_type,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           0,
                                           0,
                                           "iter",
                                           "");
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           result_type,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           0,
                                           0,
                                           "iter",
                                           "");
        self.unit.set_value_lhs( call_value, callee_ref);
        return call_value;
    }

    public fn return_expr_needs_awaitable_ready(self, return_type_id: i32, expr_id: i32) -> bool {
        if (return_type_id == mir_id_invalid() || expr_id == hir_id_invalid()) { return false; }
        let return_text = self.type_text(return_type_id);
        if (!self.type_text_is_awaitable(return_text)) { return false; }
        let expr_type = self.h.expr_type(expr_id);
        if (expr_type == return_type_id) { return false; }
        if (self.type_text(expr_type) == return_text) { return false; }
        if (self.type_text_is_awaitable(self.type_text(expr_type))) { return false; }
        return self.awaitable_payload_type_id(return_type_id) != mir_id_invalid();
    }

    public fn lower_awaitable_ready_return(self, expr_id: i32, return_type_id: i32) -> i32 {
        let payload_type_id = self.awaitable_payload_type_id(return_type_id);
        if (payload_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let return_text = self.type_text(return_type_id);
        let ready_fn = self.function_target_by_owner_type_and_method(return_text, "ready");
        if (ready_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let payload_value = self.lower_expr_as(expr_id, payload_type_id);
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           ready_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "ready",
                                           return_text);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           ready_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "ready",
                                           return_text);
        self.unit.set_value_lhs( call_value, callee_ref);
        self.append_value_arg(call_value, mir_id_invalid(), mir_id_invalid(), payload_value);
        return call_value;
    }

    public fn lower_awaitable_ready_default_return(self, return_type_id: i32, source_expr_id: i32) -> i32 {
        let payload_type_id = self.awaitable_payload_type_id(return_type_id);
        if (payload_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let return_text = self.type_text(return_type_id);
        let ready_fn = self.function_target_by_owner_type_and_method(return_text, "ready");
        if (ready_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let payload_value = self.add_default_value_for_type(payload_type_id, source_expr_id);
        if (payload_value == mir_id_invalid()) { return mir_id_invalid(); }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           ready_fn,
                                           source_expr_id,
                                           0,
                                           0,
                                           0,
                                           "ready",
                                           return_text);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           ready_fn,
                                           source_expr_id,
                                           0,
                                           0,
                                           0,
                                           "ready",
                                           return_text);
        self.unit.set_value_lhs( call_value, callee_ref);
        self.append_value_arg(call_value, mir_id_invalid(), mir_id_invalid(), payload_value);
        return call_value;
    }

    public fn add_direct_empty_arg_call(self, source_expr_id: i32, type_id: i32, target_fn: i32, name: string) -> i32 {
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           self.h.expr_op(source_expr_id),
                                           hir_unit_expr_int_value(self.h, source_expr_id),
                                           name,
                                           "");
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           self.h.expr_op(source_expr_id),
                                           hir_unit_expr_int_value(self.h, source_expr_id),
                                           name,
                                           "");
        self.unit.set_value_lhs( call_value, callee_ref);
        return call_value;
    }

    public fn refresh_mir_capture_source(self, hir_local_id: i32, mir_local_id: i32) {
        if (hir_local_id == hir_id_invalid() || mir_local_id == mir_id_invalid()) { return; }
        let source_hir_local = self.h.local_capture_source(hir_local_id);
        if (source_hir_local == hir_id_invalid()) { return; }
        let source_mir_local = mir_i32_map_get(self.local_map, source_hir_local);
        if (source_mir_local != mir_id_invalid()) {
            self.unit.set_local_capture_source( mir_local_id, source_mir_local);
        }
    }

    public fn local_map_entry_matches_function(self, mir_local_id: i32, mir_function_id: i32) -> bool {
        if (mir_local_id == mir_id_invalid() || mir_function_id == mir_id_invalid()) { return false; }
        return self.unit.local_function(mir_local_id) == mir_function_id;
    }

    public fn find_function_local_for_hir(self, mir_function_id: i32, hir_local_id: i32) -> i32 {
        if (mir_function_id == mir_id_invalid() || hir_local_id == hir_id_invalid()) { return mir_id_invalid(); }
        var local = self.unit.function_first_local(mir_function_id);
        while (local != mir_id_invalid()) {
            if (self.unit.local_hir_id(local) == hir_local_id
                && self.unit.local_function(local) == mir_function_id) {
                return local;
            }
            local = self.unit.local_next(local);
        }
        return mir_id_invalid();
    }

    public fn existing_function_local_for_hir(self, hir_local_id: i32, mir_function_id: i32) -> i32 {
        let mapped = mir_i32_map_get(self.local_map, hir_local_id);
        if (self.local_map_entry_matches_function(mapped, mir_function_id)) { return mapped; }
        return self.find_function_local_for_hir(mir_function_id, hir_local_id);
    }

    public fn local_has_live_place(self, mir_local_id: i32) -> bool {
        if (mir_local_id == mir_id_invalid()) { return false; }
        let place_id = self.unit.local_place(mir_local_id);
        if (place_id == mir_id_invalid() || place_id > self.unit.place_count) { return false; }
        return self.unit.place_kind(place_id) == mir_place_local();
    }

    public fn ensure_local_places_for_function(self, hir_function_id: i32, mir_function_id: i32) {
        var local_id = self.h.function_first_local(hir_function_id);
        while (local_id != hir_id_invalid()) {
            let existing = self.existing_function_local_for_hir(local_id, mir_function_id);
            if (existing != mir_id_invalid()) {
                self.ensure_layouts_for_type(self.h.local_type(local_id));
                // The HIR type is authoritative: a body first built before
                // semantic resolution pinned a monomorphised callee's return
                // type snapshots a placeholder (observed as `i64`) into the
                // reused local.  Without this re-assertion the rebuild keeps
                // the stale type and every field access on the local fails
                // with `field X belongs to T but base is i64` under multi-CGU.
                if (self.unit.local_type(existing) != self.h.local_type(local_id)) {
                    self.unit.set_local_type(existing, self.h.local_type(local_id));
                }
                mir_i32_map_put(self.local_map, local_id, existing);
                if (!self.local_has_live_place(existing)) {
                    let place_id = self.unit.add_place(
                                                      mir_function_id,
                                                      mir_place_local(),
                                                      self.h.local_type(local_id),
                                                      existing,
                                                      mir_id_invalid(),
                                                      mir_id_invalid(),
                                                      mir_id_invalid(),
                                                      hir_id_invalid(),
                                                      self.h.local_name(local_id));
                    self.unit.set_local_place( existing, place_id);
                    mir_i32_map_put(self.place_map, local_id, place_id);
                } else {
                    mir_i32_map_put(self.place_map, local_id, self.unit.local_place(existing));
                }
                self.refresh_mir_capture_source(local_id, existing);
                local_id = self.h.local_next(local_id);
                continue;
            }
            let mir_local = self.unit.add_local(
                                               mir_function_id,
                                               local_id,
                                               self.h.local_name(local_id),
                                               self.h.local_type(local_id),
                                               (self.h.local_flags(local_id) & ~hir_local_flag_volatile())
                                                   | ((self.h.local_flags(local_id) & hir_local_flag_volatile()) != 0
                                                      ? mir_local_flag_volatile() : 0));
            self.ensure_layouts_for_type(self.h.local_type(local_id));
            let place_id = self.unit.add_place(
                                              mir_function_id,
                                              mir_place_local(),
                                              self.h.local_type(local_id),
                                              mir_local,
                                              mir_id_invalid(),
                                              mir_id_invalid(),
                                              mir_id_invalid(),
                                              hir_id_invalid(),
                                              self.h.local_name(local_id));
            self.unit.set_local_place( mir_local, place_id);
            mir_i32_map_put(self.local_map, local_id, mir_local);
            mir_i32_map_put(self.place_map, local_id, place_id);
            self.refresh_mir_capture_source(local_id, mir_local);
            local_id = self.h.local_next(local_id);
        }
    }

    public fn lower_local_places_for_function(self, hir_function_id: i32) {
        self.ensure_local_places_for_function(hir_function_id, self.current_function_id);
    }

    public fn lower_capture_init_values_for_function(self, hir_function_id: i32, mir_function_id: i32) {
        if (hir_function_id == hir_id_invalid() || mir_function_id == mir_id_invalid()) { return; }
        self.ensure_local_places_for_function(hir_function_id, mir_function_id);
        var local_id = self.h.function_first_local(hir_function_id);
        while (local_id != hir_id_invalid()) {
            if ((self.h.local_flags(local_id) & hir_local_flag_capture()) != 0) {
                let init_expr = self.h.local_capture_init_expr(local_id);
                if (init_expr != hir_id_invalid()) {
                    let mir_local = mir_i32_map_get(self.local_map, local_id);
                    if (mir_local != mir_id_invalid()
                        && self.unit.local_capture_init_value(mir_local) == mir_id_invalid()) {
                        let init_value = self.lower_expr_as(init_expr, self.h.local_type(local_id));
                        if (init_value != mir_id_invalid()) {
                            self.unit.set_local_capture_init_value( mir_local, init_value);
                            // A named by-value capture keeps its materialized
                            // expression for the immediate lowering path, and
                            // also records the direct source local when there
                            // is one. Streaming LLVM can release the parent
                            // ValueId before it materializes the closure fat
                            // value; the source is then the conservative
                            // replay path rather than an unresolved capture.
                            if (self.unit.value_kind(init_value) == mir_value_read_place()) {
                                let init_place = self.unit.value_place(init_value);
                                if (init_place != mir_id_invalid()
                                    && self.unit.place_kind(init_place) == mir_place_local()) {
                                    let init_source = self.unit.place_local(init_place);
                                    if (init_source != mir_id_invalid()) {
                                        self.unit.set_local_capture_source( mir_local, init_source);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            local_id = self.h.local_next(local_id);
        }
    }

    public fn push_parameter_drops_for_function(self, hir_function_id: i32) {
        var local_id = self.h.function_first_local(hir_function_id);
        while (local_id != hir_id_invalid()) {
            if ((self.h.local_flags(local_id) & hir_local_flag_param()) != 0) {
                self.drop_stack_push(local_id);
            }
            local_id = self.h.local_next(local_id);
        }
    }

    public fn copy_signature_locals_for_bodyless_function(self, hir_function_id: i32, mir_function_id: i32) {
        if (hir_function_id == hir_id_invalid() || mir_function_id == mir_id_invalid()) { return; }
        var local_id = self.h.function_first_local(hir_function_id);
        while (local_id != hir_id_invalid()) {
            if ((self.h.local_flags(local_id) & hir_local_flag_param()) != 0) {
                let existing = self.existing_function_local_for_hir(local_id, mir_function_id);
                if (existing != mir_id_invalid()) {
                    mir_i32_map_put(self.local_map, local_id, existing);
                } else {
                    let mir_local = self.unit.add_local(
                                                       mir_function_id,
                                                       local_id,
                                                       self.h.local_name(local_id),
                                                       self.h.local_type(local_id),
                                                       (self.h.local_flags(local_id) & ~hir_local_flag_volatile())
                                                           | ((self.h.local_flags(local_id) & hir_local_flag_volatile()) != 0
                                                              ? mir_local_flag_volatile() : 0));
                    mir_i32_map_put(self.local_map, local_id, mir_local);
                    mir_i32_map_put(self.place_map, local_id, mir_id_invalid());
                }
            }
            local_id = self.h.local_next(local_id);
        }
    }

    public fn lower_expr_place(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let k = self.h.expr_kind(expr_id);
        if (k == ex_IDENT() && self.h.expr_target_kind(expr_id) == hir_target_local()) {
            return mir_i32_map_get(self.place_map, self.h.expr_target_id(expr_id));
        }
        if (k == ex_IDENT() && self.h.expr_target_kind(expr_id) == hir_target_item()) {
            return self.unit.add_place(
                                      self.current_function_id,
                                      mir_place_static(),
                                      self.h.expr_type(expr_id),
                                      self.h.expr_target_id(expr_id),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      expr_id,
                                      self.h.expr_name(expr_id));
        }
        if (k == ex_MEMBER() && self.h.expr_target_kind(expr_id) == hir_target_item()) {
            return self.unit.add_place(
                                      self.current_function_id,
                                      mir_place_static(),
                                      self.h.expr_type(expr_id),
                                      self.h.expr_target_id(expr_id),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      expr_id,
                                      self.h.expr_name(expr_id));
        }
        if (k == ex_MEMBER() && self.h.expr_target_kind(expr_id) == hir_target_field()) {
            let base_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            var base_for_field = base_place;
            if (base_for_field == mir_id_invalid()) {
                let base_value = self.lower_expr(self.h.expr_lhs(expr_id));
                if (base_value != mir_id_invalid()) {
                    base_for_field = self.add_temp_place(self.unit.value_type(base_value),
                                                         self.h.expr_lhs(expr_id),
                                                         "fieldbase");
                    self.emit_assign(base_for_field,
                                     base_value,
                                     hir_id_invalid(),
                                     self.h.expr_lhs(expr_id));
                }
            }
            var field_id = self.h.expr_target_id(expr_id);
            if (base_for_field != mir_id_invalid()) {
                let mapped_field = self.field_id_for_type_and_name(self.unit.place_type(base_for_field),
                                                                   self.h.item_name(field_id));
                if (mapped_field != mir_id_invalid()) { field_id = mapped_field; }
            }
            // Field lookup may be rebound from a same-short-name HIR target to
            // the field belonging to the actual receiver layout.  The MIR
            // place type must follow that final field identity as well; keeping
            // the stale HIR expression type creates an invalid layout such as
            // `StringBuilder.buf: rawptr` represented as `str`.
            var field_place_type = self.h.expr_type(expr_id);
            if (field_id != mir_id_invalid()) {
                field_place_type = self.h.item_type(field_id);
            }
            return self.unit.add_place(
                                      self.current_function_id,
                                      mir_place_field(),
                                      field_place_type,
                                      mir_id_invalid(),
                                      base_for_field,
                                      field_id,
                                      mir_id_invalid(),
                                      expr_id,
                                      self.h.expr_name(expr_id));
        }
        if (k == ex_INDEX()) {
            let overloaded_index_place = self.lower_overloaded_index_place(expr_id, true);
            if (overloaded_index_place != mir_id_invalid()) { return overloaded_index_place; }
            let base_index_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            let index_value = self.lower_expr(self.h.expr_rhs(expr_id));
            let index_place = self.unit.add_place(
                                      self.current_function_id,
                                      mir_place_index(),
                                      self.h.expr_type(expr_id),
                                      mir_id_invalid(),
                                      base_index_place,
                                      mir_id_invalid(),
                                      index_value,
                                      expr_id,
                                      self.h.expr_name(expr_id));
            return self.mark_place_unsafe_if_needed(index_place);
        }
        if (k == ex_DEREF()) {
            let base_deref_value = self.lower_expr(self.h.expr_lhs(expr_id));
            let deref_place = self.unit.add_place(
                                      self.current_function_id,
                                      mir_place_deref(),
                                      self.h.expr_type(expr_id),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      mir_id_invalid(),
                                      base_deref_value,
                                      expr_id,
                                      self.h.expr_name(expr_id));
            return self.mark_place_unsafe_if_needed(deref_place);
        }
        return mir_id_invalid();
    }

    // Stamps the unchecked check-policy on a deref/index place created while
    // lexically inside an `unsafe { ... }` block.  Backends consult this field
    // to skip the checked-address audit and emit a raw address instead.
    public fn mark_place_unsafe_if_needed(self, place_id: i32) -> i32 {
        if (place_id != mir_id_invalid() && self.unsafe_depth > 0) {
            self.unit.set_place_check_policy(
                                            place_id,
                                            mir_check_policy_unchecked());
        }
        return place_id;
    }

    public fn lower_control_if_expr(self, expr_id: i32) -> i32 {
        let result_place = self.add_temp_place_with_flags(self.h.expr_type(expr_id),
                                                           expr_id,
                                                           "ifexpr",
                                                           mir_local_flag_if_expr_result());
        let cond_value = self.lower_expr(self.h.expr_lhs(expr_id));
        let then_block = self.add_block(hir_unit_expr_stmt_rhs(self.h, expr_id));
        let else_block = self.add_block(hir_unit_expr_stmt_aux(self.h, expr_id));
        let join_block = self.add_block(hir_id_invalid());
        let branch_drop_mark = self.drop_stack_head;
        let branch_defer_mark = self.defer_stack_head;
        let branch_storage_mark = self.storage_stack_head;
        let branch_drop_state = self.drop_stack_snapshot();
        self.terminate_current(mir_term_branch(),
                               cond_value,
                               then_block,
                               else_block,
                               mir_id_invalid(),
                               expr_id);

        self.set_current_block(then_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        self.lower_stmt_into_place(hir_unit_expr_stmt_rhs(self.h, expr_id), result_place, expr_id);
        let then_reaches = !self.current_block_terminated();
        var then_end_state: rawptr = null;
        var then_cont_block: i32 = mir_id_invalid();
        if (then_reaches) {
            self.emit_scope_exit_until(branch_defer_mark,
                                       branch_drop_mark,
                                       branch_storage_mark,
                                       expr_id);
            then_cont_block = self.current_block_id;
            then_end_state = self.drop_stack_snapshot();
        }
        self.drop_stack_restore_activity(branch_drop_state);

        self.set_current_block(else_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        if (self.h.expr_aux(expr_id) != hir_id_invalid()) {
            let else_if_value = self.lower_control_if_expr(self.h.expr_aux(expr_id));
            self.emit_assign(result_place, else_if_value, hir_id_invalid(), self.h.expr_aux(expr_id));
        } else {
            self.lower_stmt_into_place(hir_unit_expr_stmt_aux(self.h, expr_id), result_place, expr_id);
        }
        let else_reaches = !self.current_block_terminated();
        var else_end_state: rawptr = null;
        var else_cont_block: i32 = mir_id_invalid();
        if (else_reaches) {
            self.emit_scope_exit_until(branch_defer_mark,
                                       branch_drop_mark,
                                       branch_storage_mark,
                                       expr_id);
            else_cont_block = self.current_block_id;
            else_end_state = self.drop_stack_snapshot();
        }
        self.drop_stack_restore_activity(branch_drop_state);

        self.set_current_block(then_cont_block);
        if (then_reaches) {
            self.drop_stack_restore_activity(then_end_state);
            if (else_reaches) {
                self.emit_branch_compensation_drops(else_end_state, expr_id);
            }
            then_end_state = self.drop_stack_snapshot();
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(else_cont_block);
        if (else_reaches) {
            self.drop_stack_restore_activity(else_end_state);
            if (then_reaches) {
                self.emit_branch_compensation_drops(then_end_state, expr_id);
            }
            else_end_state = self.drop_stack_snapshot();
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(join_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        self.merge_branch_join_drop_state(then_end_state, then_reaches,
                                          else_end_state, else_reaches,
                                          branch_drop_state);
        return self.add_read_value(result_place, expr_id);
    }

    public fn lower_stmt_chain_into_place(self, first_stmt_id: i32, result_place: i32, source_expr_id: i32) {
        var cur = first_stmt_id;
        while (cur != hir_id_invalid() && !self.current_block_terminated()) {
            let next = self.h.stmt_next(cur);
            if (next == hir_id_invalid() && self.h.stmt_kind(cur) == hir_stmt_expr()) {
                let expr_id = self.h.stmt_expr(cur);
                let value_id = self.lower_expr_as(expr_id, self.unit.place_type(result_place));
                self.emit_assign(result_place, value_id, cur, expr_id);
                self.deactivate_moved_source_expr_except(expr_id, hir_id_invalid());
                return;
            }
            self.lower_stmt(cur);
            cur = next;
        }
    }

    public fn lower_stmt_into_place(self, stmt_id: i32, result_place: i32, source_expr_id: i32) {
        if (stmt_id == hir_id_invalid() || result_place == mir_id_invalid() || self.current_block_terminated()) { return; }
        let k = self.h.stmt_kind(stmt_id);
        if (k == hir_stmt_expr()) {
            let expr_id = self.h.stmt_expr(stmt_id);
            let value_id = self.lower_expr_as(expr_id, self.unit.place_type(result_place));
            self.emit_assign(result_place, value_id, stmt_id, expr_id);
            self.deactivate_moved_source_expr_except(expr_id, hir_id_invalid());
            return;
        }
        if (k == hir_stmt_block()) {
            let saved_drop_stack = self.drop_stack_head;
            let saved_defer_stack = self.defer_stack_head;
            let saved_storage_stack = self.storage_stack_head;
            self.lower_stmt_chain_into_place(self.h.stmt_child(stmt_id), result_place, source_expr_id);
            if (!self.current_block_terminated()) {
                self.emit_scope_exit_until(saved_defer_stack,
                                           saved_drop_stack,
                                           saved_storage_stack,
                                           stmt_id);
            } else {
                self.drop_stack_head = saved_drop_stack;
                self.defer_stack_head = saved_defer_stack;
                self.storage_stack_head = saved_storage_stack;
            }
            return;
        }
        self.lower_stmt(stmt_id);
    }

    public fn lower_short_circuit_binary_expr(self, expr_id: i32, type_id: i32) -> i32 {
        let op = self.h.expr_op(expr_id);
        if (op != tk_AND() && op != tk_OR()) { return mir_id_invalid(); }
        var result_type = type_id;
        if (result_type == hir_id_invalid() || self.type_text(result_type).len == 0) {
            result_type = self.bool_type_id();
        }
        let result_place = self.add_temp_place(result_type, expr_id, "logic");
        let lhs_value = self.lower_expr(self.h.expr_lhs(expr_id));
        if (lhs_value == mir_id_invalid() || self.current_block_terminated()) { return mir_id_invalid(); }
        let rhs_block = self.add_block(self.h.expr_rhs(expr_id));
        let short_block = self.add_block(hir_id_invalid());
        let join_block = self.add_block(hir_id_invalid());
        if (op == tk_AND()) {
            self.terminate_current(mir_term_branch(),
                                   lhs_value,
                                   rhs_block,
                                   short_block,
                                   mir_id_invalid(),
                                   expr_id);
        } else {
            self.terminate_current(mir_term_branch(),
                                   lhs_value,
                                   short_block,
                                   rhs_block,
                                   mir_id_invalid(),
                                   expr_id);
        }

        self.set_current_block(rhs_block);
        let rhs_value = self.lower_expr_as(self.h.expr_rhs(expr_id), result_type);
        self.emit_assign(result_place, rhs_value, hir_id_invalid(), self.h.expr_rhs(expr_id));
        if (!self.current_block_terminated()) {
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(short_block);
        let short_value = self.add_const_bool_value(op == tk_OR(), expr_id);
        self.emit_assign(result_place, short_value, hir_id_invalid(), expr_id);
        if (!self.current_block_terminated()) {
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(join_block);
        return self.add_read_value(result_place, expr_id);
    }

    public fn binary_op_for_assign_op(self, op: i32) -> i32 {
        if (op == tk_PLUSEQ()) { return tk_PLUS(); }
        if (op == tk_MINUSEQ()) { return tk_MINUS(); }
        if (op == tk_STAREQ()) { return tk_STAR(); }
        if (op == tk_SLASHEQ()) { return tk_SLASH(); }
        if (op == tk_PERCENTEQ()) { return tk_PERCENT(); }
        if (op == tk_AMPEQ()) { return tk_AMP(); }
        if (op == tk_PIPEEQ()) { return tk_PIPE(); }
        if (op == tk_CARETEQ()) { return tk_CARET(); }
        if (op == tk_LSHIFTEQ()) { return tk_LSHIFT(); }
        if (op == tk_RSHIFTEQ()) { return tk_RSHIFT(); }
        return op;
    }

    public fn assignment_method_user_param(self, hir_function_id: i32) -> i32 {
        if (hir_function_id == hir_id_invalid()) { return hir_id_invalid(); }
        return self.first_user_param_for_call(hir_function_id);
    }

    public fn lower_operator_method_call(self,
                                          receiver_expr_id: i32,
                                          method_name: string,
                                          arg_expr_id: i32,
                                          result_type_id: i32,
                                          source_expr_id: i32) -> i32 {
        if (receiver_expr_id == hir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        let receiver_type_id = self.h.expr_type(receiver_expr_id);
        if (receiver_type_id == hir_id_invalid()) { return mir_id_invalid(); }
        let receiver_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(receiver_type_id));
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        let base_text = policy_generic_call_base(receiver_text.clone());
        if (policy_primitive_type_kind(base_text) != 0) { return mir_id_invalid(); }
        let target_fn = self.function_target_by_owner_type_and_method(receiver_text, method_name);
        if (target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let receiver_value = self.lower_expr(receiver_expr_id);
        if (receiver_value == mir_id_invalid()) { return mir_id_invalid(); }
        var call_result_type = result_type_id;
        let target_return_type = self.unit.function_return_type(target_fn);
        if (target_return_type != mir_id_invalid()
            && self.type_text(target_return_type) != "void") {
            call_result_type = target_return_type;
        }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           call_result_type,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           self.h.expr_op(source_expr_id),
                                           hir_unit_expr_int_value(self.h, source_expr_id),
                                           method_name,
                                           self.h.expr_value_text(source_expr_id));
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           call_result_type,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           source_expr_id,
                                           hir_unit_expr_flags(self.h, source_expr_id),
                                           self.h.expr_op(source_expr_id),
                                           hir_unit_expr_int_value(self.h, source_expr_id),
                                           method_name,
                                           self.h.expr_value_text(source_expr_id));
        self.unit.set_value_lhs( call_value, callee_ref);
        if (arg_expr_id != hir_id_invalid()) {
            let arg_value = self.lower_expr_as(arg_expr_id, self.h.expr_type(arg_expr_id));
            if (arg_value != mir_id_invalid()) {
                self.append_value_arg(call_value, mir_id_invalid(), mir_id_invalid(), arg_value);
            }
        }
        return call_value;
    }

    public fn lower_primitive_member_call_expr(self,
                                               call_expr_id: i32,
                                               result_type_id: i32,
                                               callee_expr_id: i32,
                                               call_target_kind: i32) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.h.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return mir_id_invalid();
        }
        let has_direct_function_target = call_target_kind == mir_target_function()
            || self.h.expr_target_kind(callee_expr_id) == hir_target_function();
        let method_name = self.h.expr_name(callee_expr_id);
        if (method_name.len == 0) { return mir_id_invalid(); }
        let receiver_expr_id = self.h.expr_lhs(callee_expr_id);
        if (receiver_expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let receiver_hir_type = self.h.expr_type(receiver_expr_id);
        if (receiver_hir_type == hir_id_invalid()) { return mir_id_invalid(); }
        var receiver_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(receiver_hir_type));
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        var receiver_base = policy_generic_call_base(receiver_text.clone());
        if (receiver_base.len == 0) { receiver_base = receiver_text; }
        let is_string_abi = receiver_base == "str" || receiver_base == "string";
        let is_primitive = policy_primitive_type_kind(receiver_base) != 0;
        if (method_name == "clone") {
            // Ownership contract: `.clone()` must produce an independent
            // value. Types with a user/stdlib `clone` method (String deep
            // copy, Vec Contract A, Ref Contract B) resolve through the
            // normal method path below. Everything else — primitives,
            // plain enums, fn pointers, dyn handles, Option/Result shells,
            // POD records without heap fields — is a value-semantic type
            // whose MIR value copy already IS an independent clone, so the
            // identity fallback is correct and keeps `Vec<T>.get` usable
            // for element types that never declared `impl Clone`.
            if (is_string_abi) { return mir_id_invalid(); }
            if (is_primitive) { return self.lower_expr(receiver_expr_id); }
            // A call site that already resolved to a concrete function target
            // is a method dispatch and must NEVER decay into a bitwise copy.
            // The recovery pass that sets it runs before this helper, while
            // `indexed_method_target` below cannot see the method yet: that
            // lookup requires a materialized MIR body, which by definition
            // does not exist for the first `.clone()` introducing it. Without
            // this guard `self.graph.clone()` aliased the source Vec buffer
            // and two destroys double-freed the heap (0xC0000374).
            if (call_target_kind == mir_target_function()) { return mir_id_invalid(); }
            // Exact `clone` on this owner only. Inherited prefix matches and
            // Zyn `dup` must not count: those made this branch skip the
            // identity copy, then the generic path looked up `clone` by name
            // and left an unresolved call (Vec.get / AppIntResource).
            if (self.indexed_method_target(receiver_text.clone(), "clone")
                != mir_id_invalid()) {
                return mir_id_invalid();
            }
            let recovered_clone_fn = self.imported_method_target_by_owner_type_and_call(receiver_text.clone(), "clone", call_expr_id, false);
            if (recovered_clone_fn != mir_id_invalid()) { return mir_id_invalid(); }
            return self.lower_expr(receiver_expr_id);
        }
        if (!is_primitive && !is_string_abi) {
            return mir_id_invalid();
        }
        if (has_direct_function_target) { return mir_id_invalid(); }
        let bin_op = mir_primitive_method_binary_op(method_name);
        if (bin_op >= 0) {
            let rhs_expr_id = self.h.expr_first_arg(call_expr_id);
            if (rhs_expr_id == hir_id_invalid()) { return mir_id_invalid(); }
            let lhs_value = self.lower_expr(receiver_expr_id);
            if (lhs_value == mir_id_invalid()) { return mir_id_invalid(); }
            let lhs_type = self.unit.value_type(lhs_value);
            let rhs_value = self.lower_expr_as(rhs_expr_id, lhs_type);
            if (rhs_value == mir_id_invalid()) { return mir_id_invalid(); }
            var out_type = lhs_type;
            if (mir_primitive_binary_returns_bool(bin_op)) {
                out_type = self.bool_type_id();
            } else if (result_type_id != mir_id_invalid()
                && self.type_text(result_type_id) != "rawptr"
                && self.type_text(result_type_id) != "void"
                && self.type_text(result_type_id).len > 0) {
                out_type = result_type_id;
            }
            self.deactivate_call_moved_args(call_expr_id);
            return self.add_binary_value(out_type,
                                         bin_op,
                                         lhs_value,
                                         rhs_value,
                                         call_expr_id,
                                         method_name);
        }
        let unary_op = mir_primitive_method_unary_op(method_name);
        if (unary_op >= 0) {
            let lhs_value_u = self.lower_expr(receiver_expr_id);
            if (lhs_value_u == mir_id_invalid()) { return mir_id_invalid(); }
            var out_type_u = self.unit.value_type(lhs_value_u);
            if (result_type_id != mir_id_invalid()
                && self.type_text(result_type_id) != "rawptr"
                && self.type_text(result_type_id) != "void"
                && self.type_text(result_type_id).len > 0) {
                out_type_u = result_type_id;
            }
            let out_un = self.unit.add_value(
                                            self.current_function_id,
                                            mir_value_unary(),
                                            out_type_u,
                                            mir_id_invalid(),
                                            mir_target_none(),
                                            mir_id_invalid(),
                                            call_expr_id,
                                            hir_unit_expr_flags(self.h, call_expr_id),
                                            unary_op,
                                            hir_unit_expr_int_value(self.h, call_expr_id),
                                            method_name,
                                            self.h.expr_value_text(call_expr_id));
            self.unit.set_value_lhs( out_un, lhs_value_u);
            return out_un;
        }
        return mir_id_invalid();
    }

    public fn primitive_compare_member_call_is_builtin(self,
                                                        callee_expr_id: i32) -> bool {
        if (callee_expr_id == hir_id_invalid()
            || self.h.expr_kind(callee_expr_id) != ex_MEMBER()
            || self.h.expr_name(callee_expr_id) != "compare") {
            return false;
        }
        let receiver_expr_id = self.h.expr_lhs(callee_expr_id);
        if (receiver_expr_id == hir_id_invalid()) { return false; }
        let receiver_type_id = self.h.expr_type(receiver_expr_id);
        if (receiver_type_id == hir_id_invalid()) { return false; }
        var receiver_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(receiver_type_id));
        if (receiver_text.len == 0) { return false; }
        var receiver_base = policy_generic_call_base(receiver_text.clone());
        if (receiver_base.len == 0) { receiver_base = receiver_text; }
        return policy_primitive_type_kind(receiver_base) != 0
            || receiver_base == "str"
            || receiver_base == "string";
    }

    public fn index_operator_target_for_expr(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid() || self.h.expr_kind(expr_id) != ex_INDEX()) { return mir_id_invalid(); }
        if (self.h.expr_target_kind(expr_id) == hir_target_function()) {
            let direct = self.target_id_from_hir_expr(expr_id);
            if (direct != mir_id_invalid()) { return direct; }
        }
        let receiver_expr_id = self.h.expr_lhs(expr_id);
        if (receiver_expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let receiver_type_id = self.h.expr_type(receiver_expr_id);
        if (receiver_type_id == hir_id_invalid()) { return mir_id_invalid(); }
        // A reference is a view of its pointee for overloaded indexing.  Use
        // the concrete owner type when recovering a target from older HIR
        // (or from a deferred place) so `&mut Vec<T>[i]` cannot fall back to
        // a lookup on the wrapper type itself.
        var lookup_type_id = receiver_type_id;
        let receiver_kind = hir_type_table_kind(self.h.types, receiver_type_id);
        if (receiver_kind == ty_REF() || receiver_kind == ty_MUTREF()
            || receiver_kind == ty_PTR()) {
            let pointee = hir_type_table_elem(self.h.types, receiver_type_id);
            if (pointee != mir_id_invalid()) {
                let pointee_kind = hir_type_table_kind(self.h.types, pointee);
                if (pointee_kind == ty_CLASS() || pointee_kind == ty_ARRAY()) {
                    lookup_type_id = pointee;
                }
            }
        }
        let receiver_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(lookup_type_id));
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        let base_text = policy_generic_call_base(receiver_text.clone());
        if (policy_primitive_type_kind(base_text) != 0) { return mir_id_invalid(); }
        return self.function_target_by_owner_type_and_method(receiver_text, "operator[]");
    }

    /// True when an overloaded index expression should keep its reference
    /// handle value instead of collapsing to the element view: the expected
    /// type (or, when unconstrained, the expression's own WYSIWYG type) is a
    /// reference.  Scalar expected types keep the element-view read.
    /// True only when the expected type explicitly asks for a reference:
    /// `var r: &mut T = v[i]`, a `&mut T` parameter, etc.  An unconstrained
    /// context (polymorphic builtins like print, inference sites) keeps the
    /// element view so `print(v[i])` and `v[i] + 1` read the value.  Code
    /// that wants the reference writes the annotation.
    /// True when the expected type explicitly asks for a reference:
    /// `var r: &mut T = v[i]`, a `&mut T` parameter, or WYSIWYG argument
    /// passing (typeof).  Value-consuming contexts read the element view;
    /// print/println dereference reference handles at the print site.
    public fn index_expr_wants_reference_value(self, expr_id: i32, expected_type_id: i32) -> bool {
        if (expected_type_id == mir_id_invalid() || expected_type_id == 0) { return false; }
        let kind = hir_type_table_kind(self.h.types, expected_type_id);
        if (kind == ty_REF() || kind == ty_MUTREF()) { return true; }
        let text = self.type_text(expected_type_id);
        let base = policy_generic_call_base(text.clone());
        return base == "ref" || base == "mutref";
    }

    public fn index_operator_place_type_from_return(self, return_type_id: i32) -> i32 {
        if (return_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        // WYSIWYG index types: the HIR expression keeps the declared return
        // type.  The deref PLACE, however, is the storage view: a reference
        // return (`&mut T` / `&T`) stores and loads the element through the
        // reference, so its place type is the pointee; a pointer return
        // (`*T`) is the pointer itself — element writes go through a further
        // index (`b[i][j] = x`) and never through this deref place.
        let kind = hir_type_table_kind(self.h.types, return_type_id);
        let return_text = self.type_text(return_type_id);
        let return_base = policy_generic_call_base(return_text.clone());
        let is_ref = kind == ty_REF() || kind == ty_MUTREF()
            || return_base == "ref" || return_base == "mutref";
        let is_ptr = kind == ty_PTR() || return_base == "ptr";
        if (is_ptr && !is_ref) { return mir_id_invalid(); }
        if (is_ref) {
            let elem = hir_type_table_elem(self.h.types, return_type_id);
            if (elem != mir_id_invalid() && !self.type_id_has_open_template_atom(elem)) { return elem; }
            let args = policy_generic_call_args(return_text.clone());
            let arg0 = policy_generic_arg_at(args, 0);
            if (arg0.len > 0 && !self.type_name_has_open_template_atom(arg0)) {
                return self.intern_type_id_by_text(arg0);
            }
            if (elem != mir_id_invalid()) { return elem; }
            return mir_id_invalid();
        }
        return mir_id_invalid();
    }

    /// WYSIWYG guard for `dest = value` where the destination expression's
    /// declared (HIR) type is a concrete pointer `*T`: the destination is the
    /// pointer slot, so a non-pointer value is a type error, not an element
    /// store.  Null literals and pointer/reference/rawptr values pass; open
    /// generic placeholders defer to instantiation.
    public fn assign_dest_pointer_type_mismatch(self, lhs_expr: i32, rhs_expr: i32) -> bool {
        if (lhs_expr == hir_id_invalid() || rhs_expr == hir_id_invalid()) { return false; }
        if (self.h.expr_kind(rhs_expr) == ex_NULL_LIT()) { return false; }
        // Only WYSIWYG element destinations (`b[i]`, `x.f`, `*p`) hand back a
        // pointer slot.  A bare `var p: *T = <array>` / `var a: [T;N] = [...]`
        // initializer also carries a pointer type on the destination after
        // array-to-pointer decay, but there the assignment is the ordinary
        // aggregate store — rejecting it would break every array variable
        // declaration.  (See tests/cases/pointer_array_decay_multidim.)
        let lhs_kind = self.h.expr_kind(lhs_expr);
        if (lhs_kind != ex_INDEX() && lhs_kind != ex_MEMBER() && lhs_kind != ex_DEREF()) { return false; }
        let lt = self.h.expr_type(lhs_expr);
        let rt = self.h.expr_type(rhs_expr);
        if (lt == mir_id_invalid() || lt == 0 || rt == mir_id_invalid() || rt == 0) { return false; }
        if (self.type_id_has_open_template_atom(lt) || self.type_id_has_open_template_atom(rt)) { return false; }
        let lkind = hir_type_table_kind(self.h.types, lt);
        if (lkind != ty_PTR()) { return false; }
        let rkind = hir_type_table_kind(self.h.types, rt);
        if (rkind == ty_PTR() || rkind == ty_REF() || rkind == ty_MUTREF() || rkind == ty_RAWPTR()) { return false; }
        if (self.type_text(rt) == "rawptr") { return false; }
        return true;
    }

    public fn lower_index_operator_call(self, expr_id: i32, return_type_id: i32, target_fn: i32) -> i32 {
        if (expr_id == hir_id_invalid() || target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let receiver_expr_id = self.h.expr_lhs(expr_id);
        if (receiver_expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let receiver_value = self.lower_expr(receiver_expr_id);
        if (receiver_value == mir_id_invalid()) { return mir_id_invalid(); }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "operator[]",
                                           self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           return_type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           "operator[]",
                                           self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( call_value, callee_ref);
        let arg_expr_id = self.h.expr_rhs(expr_id);
        if (arg_expr_id != hir_id_invalid()) {
            let arg_value = self.lower_expr_as(arg_expr_id, self.h.expr_type(arg_expr_id));
            if (arg_value != mir_id_invalid()) {
                self.append_value_arg(call_value, mir_id_invalid(), mir_id_invalid(), arg_value);
            }
        }
        return call_value;
    }

    /// `want_place` selects the channel: in place context a `*T`-returning
    /// operator[] is materialised into a temporary `*T` place so a further
    /// index (`b[i][j]`, WYSIWYG pointer stepping) has a real pointer base
    /// place; in value context the call value (the pointer handle) flows
    /// through unchanged.
    public fn lower_overloaded_index_place(self, expr_id: i32, want_place: bool) -> i32 {
        if (expr_id == hir_id_invalid() || self.h.expr_kind(expr_id) != ex_INDEX()) { return mir_id_invalid(); }
        let target_fn = self.index_operator_target_for_expr(expr_id);
        var return_type_id = mir_id_invalid();
        var place_type = mir_id_invalid();
        var address_value = mir_id_invalid();
        if (target_fn != mir_id_invalid()) {
            return_type_id = self.unit.function_return_type(target_fn);
            place_type = self.index_operator_place_type_from_return(return_type_id);
            if (place_type != mir_id_invalid()) {
                address_value = self.lower_index_operator_call(expr_id, return_type_id, target_fn);
            }
            if (want_place && place_type == mir_id_invalid() && return_type_id != mir_id_invalid()) {
                // Pointer-returning operator[] in place context: keep the
                // pointer handle addressable so nested pointer indexing and
                // `b[i][j] = x` element writes lower through the ordinary
                // pointer-index place path.
                let rkind = hir_type_table_kind(self.h.types, return_type_id);
                let rtext = self.type_text(return_type_id);
                let rbase = policy_generic_call_base(rtext.clone());
                let r_is_ref = rkind == ty_REF() || rkind == ty_MUTREF()
                    || rbase == "ref" || rbase == "mutref";
                let r_is_ptr = rkind == ty_PTR() || rbase == "ptr";
                if (r_is_ptr && !r_is_ref) {
                    let ptr_call = self.lower_index_operator_call(expr_id, return_type_id, target_fn);
                    if (ptr_call != mir_id_invalid()) {
                        let ptr_place = self.add_temp_place(return_type_id, expr_id, "idxptr");
                        self.emit_assign(ptr_place, ptr_call, hir_id_invalid(), expr_id);
                        return ptr_place;
                    }
                }
            }
        }
        if (address_value == mir_id_invalid()) {
            let expr_type = self.h.expr_type(expr_id);
            place_type = self.index_operator_place_type_from_return(expr_type);
            if (place_type == mir_id_invalid()) { return mir_id_invalid(); }
            address_value = self.lower_operator_method_call(self.h.expr_lhs(expr_id),
                                                            "operator[]",
                                                            self.h.expr_rhs(expr_id),
                                                            expr_type,
                                                            expr_id);
            if (address_value != mir_id_invalid()) {
                return_type_id = self.unit.value_type(address_value);
                let call_place_type = self.index_operator_place_type_from_return(return_type_id);
                if (call_place_type != mir_id_invalid()) { place_type = call_place_type; }
            }
        }
        if (place_type == mir_id_invalid()) { return mir_id_invalid(); }
        if (address_value == mir_id_invalid()) { return mir_id_invalid(); }
        let deref_place = self.unit.add_place(
                                  self.current_function_id,
                                  mir_place_deref(),
                                  place_type,
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  address_value,
                                  expr_id,
                                  self.h.expr_name(expr_id));
        return self.mark_place_unsafe_if_needed(deref_place);
    }

    public fn lower_assignment_method_call(self, expr_id: i32, type_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        if (self.h.expr_target_kind(expr_id) != hir_target_function()) { return mir_id_invalid(); }
        let hir_target_fn = self.h.expr_target_id(expr_id);
        let target_fn = self.target_id_from_hir_expr(expr_id);
        if (hir_target_fn == hir_id_invalid() || target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let lhs_expr = self.h.expr_lhs(expr_id);
        let rhs_expr = self.h.expr_rhs(expr_id);
        if (lhs_expr == hir_id_invalid() || rhs_expr == hir_id_invalid()) { return mir_id_invalid(); }
        let receiver_value = self.lower_expr(lhs_expr);
        if (receiver_value == mir_id_invalid()) { return mir_id_invalid(); }
        let callee_ref = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_target_ref(),
                                           self.h.expr_type(expr_id),
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           self.h.expr_name(expr_id),
                                           self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( callee_ref, receiver_value);
        let call_value = self.unit.add_value(
                                           self.current_function_id,
                                           mir_value_call(),
                                           type_id,
                                           mir_id_invalid(),
                                           mir_target_function(),
                                           target_fn,
                                           expr_id,
                                           hir_unit_expr_flags(self.h, expr_id),
                                           self.h.expr_op(expr_id),
                                           hir_unit_expr_int_value(self.h, expr_id),
                                           self.h.expr_name(expr_id),
                                           self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( call_value, callee_ref);
        let param = self.assignment_method_user_param(hir_target_fn);
        var arg_type = self.h.expr_type(rhs_expr);
        if (param != hir_id_invalid()) {
            arg_type = self.h.local_type(param);
        }
        let arg_value = self.lower_expr_as(rhs_expr, arg_type);
        self.append_value_arg(call_value, mir_id_invalid(), mir_id_invalid(), arg_value);
        if (param != hir_id_invalid()
            && (self.h.local_flags(param) & hir_local_flag_move_arg()) != 0) {
            self.deactivate_moved_source_expr_except(rhs_expr, hir_id_invalid());
        }
        return call_value;
    }

    /// Lower the canonical `String.append(integer.toString())` composition
    /// without materialising the intermediate owned `str`.  This is a MIR
    /// rewrite, so LLVM and MIR2CPP both consume the same direct call to the
    /// stdlib implementation.  Keep the match deliberately structural: an
    /// unrelated user `append` or `toString` must retain ordinary call
    /// semantics.
    public fn try_lower_std_string_append_integer_to_string(self,
                                                             expr_id: i32,
                                                             fallback_result_type_id: i32,
                                                             callee_expr_id: i32,
                                                             original_target_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || original_target_id == mir_id_invalid()
            || self.h.expr_kind(expr_id) != ex_CALL()
            || self.h.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return mir_id_invalid();
        }
        // The function owner is the canonical, fully-qualified identity.  Do
        // not use a tail-name test here: a user class named String is not the
        // std string lang-item.
        let append_owner = self.unit.function_owner_type(original_target_id);
        if ((append_owner != "std.string.String"
             && append_owner != "std.string.StringBuilder")
            || self.unit.function_name(original_target_id) != "append") {
            return mir_id_invalid();
        }
        let outer_arg = self.h.expr_first_arg(expr_id);
        if (outer_arg == hir_id_invalid()
            || self.h.expr_next_arg(outer_arg) != hir_id_invalid()
            || self.h.expr_kind(outer_arg) != ex_CALL()) {
            return mir_id_invalid();
        }
        let inner_callee = self.h.expr_lhs(outer_arg);
        if (inner_callee == hir_id_invalid()
            || self.h.expr_kind(inner_callee) != ex_MEMBER()) {
            return mir_id_invalid();
        }
        let inner_name = self.h.expr_name(inner_callee);
        if ((inner_name != "toString" && inner_name != "to_string")
            || self.h.expr_first_arg(outer_arg) != hir_id_invalid()) {
            return mir_id_invalid();
        }
        // Primitive textual conversion is a compiler builtin.  Requiring the
        // HIR builtin target prevents a same-named user method from being
        // folded into this fast path.
        if (self.h.expr_target_kind(inner_callee) != hir_target_builtin()
            && self.h.expr_sem_kind(inner_callee) != expr_sem_BUILTIN()) {
            return mir_id_invalid();
        }
        let integer_expr = self.h.expr_lhs(inner_callee);
        if (integer_expr == hir_id_invalid()) { return mir_id_invalid(); }
        let integer_type_id = self.h.expr_type(integer_expr);
        if (integer_type_id == hir_id_invalid()) { return mir_id_invalid(); }
        var integer_text = self.resolve_type_text_in_function(self.current_function_id,
                                                               self.type_text(integer_type_id));
        integer_text = policy_generic_call_base(integer_text);
        var append_method = "";
        var append_arg_type = mir_id_invalid();
        if (integer_text == "i8" || integer_text == "i16" || integer_text == "i32"
            || integer_text == "i64" || integer_text == "isize") {
            append_method = "appendI64";
            append_arg_type = self.i64_type_id();
        } elif (integer_text == "u8" || integer_text == "u16" || integer_text == "u32"
                 || integer_text == "u64" || integer_text == "usize") {
            append_method = "appendU64";
            append_arg_type = self.intern_type_id_by_text("u64");
        } else {
            return mir_id_invalid();
        }
        if (append_arg_type == mir_id_invalid()) { return mir_id_invalid(); }
        let append_target = self.function_target_by_owner_type_and_method(append_owner,
                                                                            append_method);
        if (append_target == mir_id_invalid()) { return mir_id_invalid(); }
        let string_receiver_expr = self.h.expr_lhs(callee_expr_id);
        if (string_receiver_expr == hir_id_invalid()) { return mir_id_invalid(); }
        // Match the source language's left-to-right member-call evaluation:
        // evaluate String receiver first, then the integer receiver.
        let string_receiver_value = self.lower_expr(string_receiver_expr);
        if (string_receiver_value == mir_id_invalid()) { return mir_id_invalid(); }
        let integer_value = self.lower_expr_as(integer_expr, append_arg_type);
        if (integer_value == mir_id_invalid()) { return mir_id_invalid(); }
        var result_type = fallback_result_type_id;
        let target_return_type = self.unit.function_return_type(append_target);
        if (target_return_type != mir_id_invalid()) { result_type = target_return_type; }
        let target_ref = self.unit.add_value(
                                            self.current_function_id,
                                            mir_value_target_ref(),
                                            result_type,
                                            mir_id_invalid(),
                                            mir_target_function(),
                                            append_target,
                                            callee_expr_id,
                                            hir_unit_expr_flags(self.h, callee_expr_id),
                                            self.h.expr_op(callee_expr_id),
                                            hir_unit_expr_int_value(self.h, callee_expr_id),
                                            append_method,
                                            self.h.expr_value_text(callee_expr_id));
        self.unit.set_value_lhs( target_ref, string_receiver_value);
        let out_call = self.unit.add_value(
                                          self.current_function_id,
                                          mir_value_call(),
                                          result_type,
                                          mir_id_invalid(),
                                          mir_target_function(),
                                          append_target,
                                          expr_id,
                                          hir_unit_expr_flags(self.h, expr_id),
                                          self.h.expr_op(expr_id),
                                          hir_unit_expr_int_value(self.h, expr_id),
                                          append_method,
                                          self.h.expr_value_text(expr_id));
        self.unit.set_value_lhs( out_call, target_ref);
        self.append_value_arg(out_call, mir_id_invalid(), mir_id_invalid(), integer_value);
        // The original String.append receiver ownership contract remains in
        // force; the elided builtin integer conversion owns no str temporary.
        self.deactivate_call_moved_receiver(expr_id);
        return out_call;
    }

    public fn lower_call_expr_value(self,
                                    expr_id: i32,
                                    type_id: i32,
                                    prefix_value_id: i32,
                                    prefix_source_expr_id: i32) -> i32 {
        var call_target_kind = self.target_kind_from_hir(self.h.expr_target_kind(expr_id));
        var call_target_id = self.target_id_from_hir_expr(expr_id);
        let callee_expr_id = self.h.expr_lhs(expr_id);
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_target_kind(callee_expr_id) == hir_target_variant()) {
            call_target_kind = mir_target_hir_variant();
            call_target_id = self.target_id_from_hir_expr(callee_expr_id);
        }
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_target_kind(callee_expr_id) == hir_target_builtin()) {
            call_target_kind = mir_target_builtin();
            call_target_id = self.target_id_from_hir_expr(callee_expr_id);
        }
        // HIR keeps the exact Sema-selected callable on a member callee while
        // some materialized call nodes intentionally retain no target of their
        // own. Preserve that canonical target before applying any name-based
        // fallback; this is required for imported static methods, whose MIR
        // shell is an external declaration in the consuming partition.
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && (self.h.expr_kind(callee_expr_id) == ex_IDENT()
                || self.h.expr_kind(callee_expr_id) == ex_MEMBER())
            && self.h.expr_target_kind(callee_expr_id) == hir_target_function()) {
            call_target_kind = mir_target_function();
            call_target_id = self.target_id_from_hir_expr(callee_expr_id);
        }
        // `str`/`string` views expose c_str/ptr/data as compiler builtins.
        // A stale peer HIR can accidentally attach the owned std.string.String
        // method shell instead; force the ABI-level builtin before direct-call
        // lowering so no undefined String.c_str symbol is emitted.
        if (callee_expr_id != hir_id_invalid()
            && self.string_abi_member_call_is_builtin(callee_expr_id)) {
            let string_receiver = self.h.expr_lhs(callee_expr_id);
            var string_member_name = self.h.expr_name(callee_expr_id);
            if (string_member_name.len == 0) {
                string_member_name = self.h.expr_value_text(callee_expr_id);
            }
            call_target_kind = mir_target_builtin();
            call_target_id = self.h.add_or_get_builtin(string_member_name,
                                                         expr_sem_BUILTIN(),
                                                         self.h.expr_type(string_receiver),
                                                         0);
        }
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            let owner_expr_id = self.h.expr_lhs(callee_expr_id);
            if (owner_expr_id != hir_id_invalid()
                && self.h.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) {
                let owner_type = self.type_text(self.h.expr_type(owner_expr_id));
                var member_method_name = self.h.expr_name(callee_expr_id);
                if (member_method_name.len == 0) {
                    member_method_name = self.h.expr_value_text(callee_expr_id);
                }
                let recovered_static_target = self.static_method_target_by_owner_type_and_call(
                    owner_type,
                    member_method_name,
                    expr_id);
                if (recovered_static_target != mir_id_invalid()) {
                    call_target_kind = mir_target_function();
                    call_target_id = recovered_static_target;
                }
            }
        }
        if ((call_target_kind == mir_target_none() || call_target_kind == mir_target_builtin())
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()
            && !self.string_abi_member_call_is_builtin(callee_expr_id)) {
            let owner_expr_id = self.h.expr_lhs(callee_expr_id);
            if (owner_expr_id != hir_id_invalid()) {
                var member_method_name = self.h.expr_name(callee_expr_id);
                if (member_method_name.len == 0) {
                    member_method_name = self.h.expr_value_text(callee_expr_id);
                }
                let want_static = self.h.expr_sem_kind(owner_expr_id) == expr_sem_CLASS();
                var owner_type = self.member_receiver_type_text(owner_expr_id);
                if (want_static) {
                    let named_owner = self.resolve_type_text_in_function(
                        self.current_function_id,
                        self.h.expr_name(owner_expr_id));
                    if (named_owner.len > 0) { owner_type = named_owner; }
                }
                let recovered_method = self.imported_method_target_by_owner_type_and_call(
                    owner_type,
                    member_method_name,
                    expr_id,
                    want_static);
                if (recovered_method != mir_id_invalid()) {
                    call_target_kind = mir_target_function();
                    call_target_id = recovered_method;
                } elif (!want_static
                         && (owner_type == "void" || owner_type == "rawptr"
                             || policy_primitive_type_kind(policy_generic_call_base(owner_type)) != 0)) {
                    let recovered_method_any = self.imported_method_target_by_name_and_call(
                        member_method_name,
                        expr_id);
                    if (recovered_method_any != mir_id_invalid()) {
                        call_target_kind = mir_target_function();
                        call_target_id = recovered_method_any;
                    }
                }
            }
        }
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            let member_builtin_name = self.h.expr_name(callee_expr_id);
            let member_receiver_expr_id = self.h.expr_lhs(callee_expr_id);
            if (self.builtin_member_fallback_allowed(member_receiver_expr_id, member_builtin_name)
                && (member_builtin_name == "toString" || member_builtin_name == "to_string"
                || member_builtin_name == "len" || member_builtin_name == "length"
                || member_builtin_name == "size" || member_builtin_name == "count"
                || member_builtin_name == "ptr" || member_builtin_name == "c_str"
                || member_builtin_name == "data" || member_builtin_name == "clone"
                || member_builtin_name == "repeat" || member_builtin_name == "find"
                || member_builtin_name == "indexOf" || member_builtin_name == "index_of"
                || member_builtin_name == "equals" || member_builtin_name == "substr"
                || member_builtin_name == "substring" || member_builtin_name == "charAt"
                || member_builtin_name == "char_at" || member_builtin_name == "charCodeAt"
                || member_builtin_name == "char_code_at" || member_builtin_name == "byteAt"
                || member_builtin_name == "contains" || member_builtin_name == "startsWith"
                || member_builtin_name == "starts_with" || member_builtin_name == "endsWith"
                || member_builtin_name == "ends_with" || member_builtin_name == "isEmpty"
                || member_builtin_name == "is_empty" || member_builtin_name == "trim"
                || member_builtin_name == "replace" || member_builtin_name == "toUpper"
                || member_builtin_name == "to_upper" || member_builtin_name == "toLower"
                || member_builtin_name == "to_lower")) {
                call_target_kind = mir_target_builtin();
                call_target_id = self.target_id_from_hir_expr(callee_expr_id);
            }
        }
        if (call_target_kind == mir_target_builtin()
            && call_target_id == mir_id_invalid()
            && callee_expr_id != hir_id_invalid()) {
            var builtin_name = self.h.expr_name(callee_expr_id);
            var builtin_owner_type = hir_id_invalid();
            if (self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
                let receiver_expr_id = self.h.expr_lhs(callee_expr_id);
                if (receiver_expr_id != hir_id_invalid()) {
                    builtin_owner_type = self.h.expr_type(receiver_expr_id);
                }
            }
            if (builtin_name.len > 0) {
                call_target_id = self.h.add_or_get_builtin(builtin_name,
                                                             expr_sem_BUILTIN(),
                                                             builtin_owner_type,
                                                             0);
            }
        }
        let primitive_member_value = self.lower_primitive_member_call_expr(expr_id,
                                                                           type_id,
                                                                           callee_expr_id,
                                                                           call_target_kind);
        if (primitive_member_value != mir_id_invalid()) {
            return primitive_member_value;
        }
        // A generic `T: Ord` call is closed by HIR to the selected primitive
        // impl method. Primitive/string compare is nevertheless a MIR builtin:
        // retaining the bodyless closed method shell here would emit an
        // undefined native symbol instead of the shared LLVM/MIR2CPP lowering.
        if (call_target_kind == mir_target_function()
            && self.primitive_compare_member_call_is_builtin(callee_expr_id)) {
            let receiver_expr_id = self.h.expr_lhs(callee_expr_id);
            call_target_kind = mir_target_builtin();
            call_target_id = self.h.add_or_get_builtin("compare",
                                                         expr_sem_BUILTIN(),
                                                         self.h.expr_type(receiver_expr_id),
                                                         0);
        }
        if (call_target_kind == mir_target_function()) {
            call_target_id = self.executable_method_target_for_call(expr_id, call_target_id);
            let direct_string_append = self.try_lower_std_string_append_integer_to_string(
                expr_id,
                type_id,
                callee_expr_id,
                call_target_id);
            if (direct_string_append != mir_id_invalid()) {
                return direct_string_append;
            }
            // `executable_method_target_for_call` can retarget a generic or
            // interface shell to a closed executable instance.  A direct MIR
            // call is a reachability edge regardless of how its final target
            // was selected; otherwise the shell is declared but never lowered
            // and the linker sees an undefined symbol.
            if (call_target_id != mir_id_invalid()
                && self.function_can_reach_executable_body(call_target_id)) {
                self.mark_function_reachable(call_target_id);
            }
            if (call_target_id != mir_id_invalid()
                && (self.unit.function_flags( call_target_id) & hir_function_flag_async_task()) != 0) {
                self.mark_async_call_support_reachable(call_target_id);
            }
        }
        if (call_target_kind == mir_target_hir_variant()) {
            call_target_id = self.variant_item_for_owner_type(type_id, call_target_id);
        }
        var call_result_type_id = type_id;
        // Built-in pointer methods: the HIR call node may carry a stale/void
        // type, but the result ABI is fully determined by the receiver's own
        // pointer type (stepping) or i64 (offset_from family).
        if (call_target_kind == mir_target_builtin()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            let pm_name = self.h.expr_name(callee_expr_id);
            let pm_kind = policy_pointer_method_kind(generic_call_base(pm_name));
            if (pm_kind > 0) {
                let recv_expr = self.h.expr_lhs(callee_expr_id);
                if (recv_expr != hir_id_invalid()) {
                    let recv_ty = self.h.expr_type(recv_expr);
                    if (recv_ty != hir_id_invalid()) {
                        if (pm_kind == 7 || pm_kind == 8) {
                            call_result_type_id = self.i64_type_id();
                        } else {
                            call_result_type_id = recv_ty;
                        }
                    }
                }
            }
        }
        if (call_target_kind == mir_target_function()
            && call_target_id != mir_id_invalid()) {
            let target_return_type = self.unit.function_return_type(call_target_id);
            if (target_return_type != mir_id_invalid()) {
                call_result_type_id = target_return_type;
            }
        }
        var callee_value = mir_id_invalid();
        if (call_target_kind == mir_target_function()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            callee_value = self.unit.add_value(
                                              self.current_function_id,
                                              mir_value_target_ref(),
                                              call_result_type_id,
                                              mir_id_invalid(),
                                              mir_target_function(),
                                              call_target_id,
                                              callee_expr_id,
                                              hir_unit_expr_flags(self.h, callee_expr_id),
                                              self.h.expr_op(callee_expr_id),
                                              hir_unit_expr_int_value(self.h, callee_expr_id),
                                              self.h.expr_name(callee_expr_id),
                                              self.h.expr_value_text(callee_expr_id));
            self.unit.set_value_lhs( callee_value, self.lower_expr(self.h.expr_lhs(callee_expr_id)));
        } else {
            callee_value = self.lower_expr(callee_expr_id);
            if (call_target_kind == mir_target_function()
                && callee_value != mir_id_invalid()
                && self.unit.value_kind(callee_value) == mir_value_target_ref()
                && self.unit.value_target_kind(callee_value) == mir_target_function()
                && self.unit.value_target_id(callee_value) != call_target_id) {
                self.unit.set_value_target( callee_value, mir_target_function(), call_target_id);
            }
            if (call_target_kind == mir_target_builtin()
                && callee_value != mir_id_invalid()
                && self.unit.value_kind(callee_value) == mir_value_target_ref()
                && self.unit.value_target_kind(callee_value) != mir_target_builtin()) {
                self.unit.set_value_target(
                                          callee_value,
                                          mir_target_builtin(),
                                          call_target_id);
            }
            if (call_target_kind == mir_target_hir_variant()
                && callee_value != mir_id_invalid()
                && self.unit.value_kind(callee_value) == mir_value_target_ref()
                && self.unit.value_target_kind(callee_value) == mir_target_hir_variant()
                && self.unit.value_target_id(callee_value) != call_target_id) {
                self.unit.set_value_target( callee_value, mir_target_hir_variant(), call_target_id);
            }
        }
        var call_name = self.h.expr_name(expr_id);
        var call_text = self.h.expr_value_text(expr_id);
        if (call_name.len == 0
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            call_name = self.h.expr_name(callee_expr_id);
        }
        if (call_target_kind == mir_target_builtin()
            && call_target_id != mir_id_invalid()) {
            let resolved_builtin_name = self.h.builtin_name(call_target_id);
            if (resolved_builtin_name.len > 0) {
                call_name = resolved_builtin_name;
            }
        }
        if (call_name.len == 0
            && call_target_kind == mir_target_builtin()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            call_name = self.h.expr_name(callee_expr_id);
        }
        if (call_target_kind == mir_target_none()
            && callee_expr_id != hir_id_invalid()
            && self.h.expr_kind(callee_expr_id) == ex_MEMBER()) {
            // Unresolved member call (HIR left sem/target empty, e.g.
            // `m.keys.get(i)` on a generic projection receiver): keep the
            // method name and receiver type text on the call value so
            // mir_verify can report a diagnosable error instead of an
            // opaque value id at LLVM lowering time. Resolved calls keep
            // their original name/text untouched.
            if (call_name.len == 0) {
                call_name = self.h.expr_name(callee_expr_id);
            }
            if (call_text.len == 0) {
                let receiver_expr_id = self.h.expr_lhs(callee_expr_id);
                if (receiver_expr_id != hir_id_invalid()) {
                    call_text = "recv=" + self.type_text(self.h.expr_type(receiver_expr_id));
                }
            }
        }
        var layout_call_name = call_name;
        if (layout_call_name.len == 0 && callee_expr_id != hir_id_invalid()) {
            layout_call_name = self.h.expr_name(callee_expr_id);
            if (layout_call_name.len == 0) {
                layout_call_name = self.h.expr_value_text(callee_expr_id);
            }
        }
        if (policy_generic_call_has_args(layout_call_name.clone()) == 0
            && callee_expr_id != hir_id_invalid()) {
            var generic_layout_call_name = self.h.expr_name(callee_expr_id);
            if (policy_generic_call_has_args(generic_layout_call_name.clone()) == 0) {
                generic_layout_call_name = self.h.expr_value_text(callee_expr_id);
            }
            if (policy_generic_call_has_args(generic_layout_call_name.clone()) != 0) {
                layout_call_name = generic_layout_call_name;
            }
        }
        self.ensure_layouts_for_builtin_type_args(call_target_kind, layout_call_name);
        let out_call = self.unit.add_value(
                                          self.current_function_id,
                                          mir_value_call(),
                                          call_result_type_id,
                                         mir_id_invalid(),
                                         call_target_kind,
                                         call_target_id,
                                         expr_id,
                                         hir_unit_expr_flags(self.h, expr_id),
                                         self.h.expr_op(expr_id),
                                         hir_unit_expr_int_value(self.h, expr_id),
                                         call_name,
                                         call_text);
        self.unit.set_value_lhs( out_call, callee_value);
        if (call_target_kind == mir_target_builtin()) {
            let builtin_base = policy_generic_call_base(call_name.clone());
            if (builtin_base == "construct" || builtin_base == "new") {
                // Builtins have no function signature locals, so the generic
                // argument lowering path cannot discover a concrete-to-dyn
                // conversion from a parameter type.  Preserve the source HIR
                // type here and make every concrete vtable method reachable
                // before the source body is discarded by streaming codegen.
                let construct_arg = self.h.expr_first_arg(expr_id);
                if (construct_arg != hir_id_invalid()
                    && self.h.expr_next_arg(construct_arg) == hir_id_invalid()) {
                    self.ensure_dyn_trait_methods_reachable(self.h.expr_type(construct_arg), type_id);
                }
            }
        }
        var first_arg = mir_id_invalid();
        var last_arg = mir_id_invalid();
        var skipped_params: i32 = 0;
        if (prefix_value_id != mir_id_invalid()) {
            last_arg = self.append_value_arg(out_call,
                                             mir_id_invalid(),
                                             mir_id_invalid(),
                                             prefix_value_id);
            first_arg = self.unit.value_first_arg(out_call);
            skipped_params = 1;
        }
        if (!self.lower_named_call_arg_values_from(out_call,
                                                   self.h.expr_first_arg(expr_id),
                                                   call_target_id,
                                                   first_arg,
                                                   last_arg,
                                                   skipped_params)) {
            self.lower_arg_values_from(out_call,
                                       self.h.expr_first_arg(expr_id),
                                       first_arg,
                                       last_arg,
                                       call_target_id,
                                       skipped_params);
        }
        if (prefix_source_expr_id != hir_id_invalid()) {
            self.deactivate_call_moved_prefix(expr_id, prefix_source_expr_id);
            self.deactivate_call_moved_args_from(expr_id, self.h.expr_first_arg(expr_id), 1);
        } else {
            self.deactivate_call_moved_receiver(expr_id);
            self.deactivate_call_moved_args(expr_id);
        }
        return out_call;
    }

    public fn lower_pipe_expr(self, expr_id: i32, type_id: i32) -> i32 {
        let lhs_expr = self.h.expr_lhs(expr_id);
        let rhs_expr = self.h.expr_rhs(expr_id);
        if (rhs_expr == hir_id_invalid() || self.h.expr_kind(rhs_expr) != ex_CALL()) {
            return mir_id_invalid();
        }
        let prefix_value = self.lower_expr(lhs_expr);
        if (prefix_value == mir_id_invalid()) { return mir_id_invalid(); }
        return self.lower_call_expr_value(rhs_expr, type_id, prefix_value, lhs_expr);
    }

    public fn lower_inc_dec_expr(self, expr_id: i32) -> i32 {
        let operand_expr = self.h.expr_lhs(expr_id);
        let op = self.h.expr_op(expr_id);
        var method_name_id = "operator_inc";
        if (op == tk_MINUSMINUS()) { method_name_id = "operator_dec"; }
        let inc_dec_call = self.lower_operator_method_call(operand_expr, method_name_id, hir_id_invalid(), self.h.expr_type(expr_id), expr_id);
        if (inc_dec_call != mir_id_invalid()) {
            let operand_place = self.lower_expr_place(operand_expr);
            if (operand_place != mir_id_invalid()) {
                self.emit_assign(operand_place, inc_dec_call, hir_id_invalid(), expr_id);
            }
            return inc_dec_call;
        }
        let operand_place = self.lower_expr_place(operand_expr);
        if (operand_place == mir_id_invalid()) { return mir_id_invalid(); }
        let old_value = self.add_read_value(operand_place, operand_expr);
        var binary_op = tk_PLUS();
        if (op == tk_MINUSMINUS()) { binary_op = tk_MINUS(); }
        let next_value = self.add_binary_value(self.unit.place_type(operand_place),
                                               binary_op,
                                               old_value,
                                               self.add_const_i64_value(1, expr_id),
                                               expr_id,
                                               "incdec");
        self.emit_assign(operand_place, next_value, hir_id_invalid(), expr_id);
        return next_value;
    }

    fn lower_new_expr_value(self, expr_id: i32, type_id: i32) -> i32 {
        if (self.h.expr_target_kind(expr_id) == hir_target_function()) {
            let constructor_fn = self.target_id_from_hir_expr(expr_id);
            if (constructor_fn == mir_id_invalid()) { return mir_id_invalid(); }
            let ctor_call = self.unit.add_value(
                                               self.current_function_id,
                                               mir_value_call(),
                                               type_id,
                                               mir_id_invalid(),
                                               mir_target_function(),
                                               constructor_fn,
                                               expr_id,
                                               hir_unit_expr_flags(self.h, expr_id),
                                               self.h.expr_op(expr_id),
                                               hir_unit_expr_int_value(self.h, expr_id),
                                               "constructor",
                                               self.h.expr_name(expr_id));
            self.lower_arg_values(ctor_call, self.h.expr_first_arg(expr_id));
            return ctor_call;
        }

        var payload_type = mir_id_invalid();
        if (self.h.expr_target_kind(expr_id) == hir_target_type()) {
            payload_type = self.h.expr_target_id(expr_id);
        }
        if (payload_type == mir_id_invalid()) {
            payload_type = self.type_id_for_resolved_text(self.current_function_id,
                                                          self.h.expr_name(expr_id));
        }
        if (payload_type == mir_id_invalid()) {
            payload_type = self.intern_type_id_by_text(self.h.expr_name(expr_id));
        }
        self.ensure_layouts_for_type(payload_type);
        let out = self.unit.add_value(
                                     self.current_function_id,
                                     mir_value_intrinsic(),
                                     type_id,
                                     mir_id_invalid(),
                                     mir_target_type(),
                                     payload_type,
                                     expr_id,
                                     hir_unit_expr_flags(self.h, expr_id),
                                     self.h.expr_op(expr_id),
                                     hir_unit_expr_int_value(self.h, expr_id),
                                     "__vyx_new",
                                     self.h.expr_name(expr_id));
        if (self.h.expr_lhs(expr_id) != hir_id_invalid()) {
            self.unit.set_value_lhs( out, self.lower_expr(self.h.expr_lhs(expr_id)));
        }
        if (self.h.expr_rhs(expr_id) != hir_id_invalid()) {
            self.unit.set_value_rhs(
                                   out,
                                   self.lower_expr_as(self.h.expr_rhs(expr_id), payload_type));
        }
        // Runtime-length array allocation carries the size expression value.
        if (self.h.expr_aux(expr_id) != hir_id_invalid()) {
            self.unit.set_value_aux(out, self.lower_expr(self.h.expr_aux(expr_id)));
        }
        self.lower_arg_values(out, self.h.expr_first_arg(expr_id));
        return out;
    }

    fn lower_delete_expr_value(self, expr_id: i32, type_id: i32) -> i32 {
        let operand_expr = self.h.expr_lhs(expr_id);
        let operand_value = self.lower_expr(operand_expr);
        let operand_place = self.lower_expr_place(operand_expr);
        var payload_type = mir_id_invalid();
        if (self.h.expr_target_kind(expr_id) == hir_target_type()) {
            payload_type = self.h.expr_target_id(expr_id);
        }
        if (payload_type == mir_id_invalid() && operand_expr != hir_id_invalid()) {
            let operand_type = self.h.expr_type(operand_expr);
            let operand_kind = hir_type_table_kind(self.h.types, operand_type);
            if (operand_kind == ty_PTR()
                || operand_kind == ty_REF()
                || operand_kind == ty_MUTREF()) {
                payload_type = hir_type_table_elem(self.h.types, operand_type);
            } else {
                payload_type = operand_type;
            }
        }
        let out = self.unit.add_value(
                                     self.current_function_id,
                                     mir_value_intrinsic(),
                                     type_id,
                                     operand_place,
                                     mir_target_type(),
                                     payload_type,
                                     expr_id,
                                     hir_unit_expr_flags(self.h, expr_id),
                                     self.h.expr_op(expr_id),
                                     hir_unit_expr_int_value(self.h, expr_id),
                                     "__vyx_delete",
                                     self.h.expr_name(expr_id));
        self.unit.set_value_lhs( out, operand_value);
        if (self.h.expr_rhs(expr_id) != hir_id_invalid()) {
            self.unit.set_value_rhs( out, self.lower_expr(self.h.expr_rhs(expr_id)));
        }
        return out;
    }

    public fn lower_expr(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return mir_id_invalid(); }
        let k = self.h.expr_kind(expr_id);
        let expected_type_id = self.expected_expr_type_id;
        self.expected_expr_type_id = hir_id_invalid();
        var type_id = self.effective_expr_type(expr_id, expected_type_id);
        if (expected_type_id != hir_id_invalid()
            && self.type_dyn_trait_id(expected_type_id) != hir_id_invalid()
            && self.type_dyn_payload_id(self.h.expr_type(expr_id)) != hir_id_invalid()) {
            type_id = self.h.expr_type(expr_id);
            self.ensure_dyn_trait_methods_reachable(type_id, expected_type_id);
        }
        self.ensure_layouts_for_type(type_id);
        if (k == ex_INT_LIT()) {
            var value_kind = mir_value_const_int();
            if (self.type_id_is_float(type_id)) { value_kind = mir_value_const_float(); }
            return self.unit.add_value( self.current_function_id, value_kind, type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_BOOL_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_const_bool(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_STR_LIT() || k == ex_FSTRING()) {
            let v = self.unit.add_value( self.current_function_id, mir_value_const_str(), type_id,
                                       mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                       hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                       self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(v, self.h.expr_first_arg(expr_id));
            return v;
        }
        if (k == ex_CHAR_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_const_char(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_NULL_LIT()) {
            return self.unit.add_value( self.current_function_id, mir_value_null(), type_id,
                                      mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)), self.target_id_from_hir_expr(expr_id), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_IDENT()) {
            if (self.h.expr_target_kind(expr_id) == hir_target_local()) {
                let place_id = mir_i32_map_get(self.place_map, self.h.expr_target_id(expr_id));
                let place_type = self.unit.place_type(place_id);
                if (type_id != hir_id_invalid()
                    && place_type != hir_id_invalid()
                    && type_id != place_type
                    && self.type_dyn_trait_id(type_id) != hir_id_invalid()) {
                    self.ensure_dyn_trait_methods_reachable(place_type, type_id);
                    return self.add_read_value_typed(place_id, type_id, expr_id);
                }
                return self.add_read_value(place_id, expr_id);
            }
            return self.unit.add_value(
                                      self.current_function_id,
                                      mir_value_target_ref(),
                                      type_id,
                                      mir_id_invalid(),
                                      self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                      self.target_id_from_hir_expr(expr_id),
                                      expr_id,
                                      hir_unit_expr_flags(self.h, expr_id),
                                      self.h.expr_op(expr_id),
                                      hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id),
                                      self.h.expr_value_text(expr_id));
        }
        if (k == ex_ASSIGN()) {
            let dest_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            // WYSIWYG assign-destination guard: a destination whose declared
            // type is a concrete pointer (`*T`) is the pointer slot itself.
            // Storing a scalar there would overwrite the handle instead of an
            // element, so reject it: the user means `p[0] = v` / `b[i][j] = v`
            // or an `operator[] -> &mut T` container.  Reference destinations
            // keep view semantics; unresolved generics stay deferred.
            if (self.h.expr_op(expr_id) == tk_EQ()
                && self.assign_dest_pointer_type_mismatch(self.h.expr_lhs(expr_id),
                                                          self.h.expr_rhs(expr_id))) {
                let lt = self.h.expr_type(self.h.expr_lhs(expr_id));
                let rt = self.h.expr_type(self.h.expr_rhs(expr_id));
                self.report_error("assignment destination '"
                                  + self.h.expr_value_text(self.h.expr_lhs(expr_id))
                                  + "' has pointer type " + self.type_text(lt)
                                  + " but the assigned value is " + self.type_text(rt)
                                  + "; index the pointer (dest[0] = value) or use a reference-returning operator[]");
                return mir_id_invalid();
            }
            let method_call = self.lower_assignment_method_call(expr_id, type_id);
            if (method_call != mir_id_invalid()) {
                let method_type = self.unit.value_type(method_call);
                if (dest_place != mir_id_invalid() && self.type_text(method_type) != "void") {
                    self.emit_assign(dest_place, method_call, hir_id_invalid(), expr_id);
                }
                return method_call;
            }
            let rhs_expr = self.h.expr_rhs(expr_id);
            let rhs_is_own = rhs_expr != hir_id_invalid()
                && self.h.expr_kind(rhs_expr) == ex_UNARY()
                && self.h.expr_op(rhs_expr) == unary_op_own();
            var rhs_value = mir_id_invalid();
            if (dest_place != mir_id_invalid()) {
                rhs_value = self.lower_expr_as(rhs_expr, self.unit.place_type(dest_place));
            } else {
                rhs_value = self.lower_expr(rhs_expr);
            }
            let assign_op = self.h.expr_op(expr_id);
            if (assign_op != tk_EQ() && dest_place != mir_id_invalid()) {
                let assign_method_name = mir_assign_operator_method_name(assign_op);
                if (assign_method_name.len > 0) {
                    let lhs_expr_a = self.h.expr_lhs(expr_id);
                    let rhs_expr_a = self.h.expr_rhs(expr_id);
                    let assign_call = self.lower_operator_method_call(lhs_expr_a, assign_method_name, rhs_expr_a, type_id, expr_id);
                    if (assign_call != mir_id_invalid()) {
                        let method_type = self.unit.value_type(assign_call);
                        if (self.type_text(method_type) != "void") {
                            self.emit_assign(dest_place, assign_call, hir_id_invalid(), expr_id);
                        }
                        return assign_call;
                    }
                }
                if (rhs_value == mir_id_invalid()) {
                    if (dest_place != mir_id_invalid()) {
                        rhs_value = self.lower_expr_as(self.h.expr_rhs(expr_id), self.unit.place_type(dest_place));
                    } else {
                        rhs_value = self.lower_expr(self.h.expr_rhs(expr_id));
                    }
                }
                let old_value = self.add_read_value(dest_place, expr_id);
                let result_type = self.unit.place_type(dest_place);
                let compound_value = self.unit.add_value(
                                                        self.current_function_id,
                                                        mir_value_binary(),
                                                        result_type,
                                                        mir_id_invalid(),
                                                        mir_target_none(),
                                                        mir_id_invalid(),
                                                        expr_id,
                                                        hir_unit_expr_flags(self.h, expr_id),
                                                        self.binary_op_for_assign_op(assign_op),
                                                        hir_unit_expr_int_value(self.h, expr_id),
                                                        self.h.expr_name(expr_id),
                                                        self.h.expr_value_text(expr_id));
                self.unit.set_value_lhs( compound_value, old_value);
                self.unit.set_value_rhs( compound_value, rhs_value);
                if (!self.assignment_rhs_refs_place_local(dest_place, self.h.expr_lhs(expr_id))
                    && !self.assignment_rhs_refs_place_local(dest_place, self.h.expr_rhs(expr_id))) {
                    self.drop_local_for_place_before_reassign(dest_place, expr_id);
                }
                self.emit_assign(dest_place, compound_value, hir_id_invalid(), expr_id);
                return compound_value;
            }
            if (rhs_is_own
                && !self.assignment_rhs_refs_place_local(dest_place, rhs_expr)) {
                self.emit_pointer_delete_for_place(dest_place, expr_id);
            }
            if (!self.assignment_rhs_refs_place_local(dest_place, rhs_expr)) {
                self.drop_local_for_place_before_reassign(dest_place, expr_id);
            }
            self.emit_assign(dest_place, rhs_value, hir_id_invalid(), expr_id);
            self.deactivate_moved_source_expr_except(rhs_expr, self.hir_local_for_place(dest_place));
            return rhs_value;
        }
        if (k == ex_BIN()) {
            if (self.h.expr_op(expr_id) == tk_PIPEARROW()) {
                return self.lower_pipe_expr(expr_id, type_id);
            }
            let logic_value = self.lower_short_circuit_binary_expr(expr_id, type_id);
            if (logic_value != mir_id_invalid()) { return logic_value; }
            let op = self.h.expr_op(expr_id);
            let method_name = mir_binop_operator_method_name(op);
            if (method_name.len > 0) {
                let lhs_expr = self.h.expr_lhs(expr_id);
                let rhs_expr = self.h.expr_rhs(expr_id);
                let overload_call = self.lower_operator_method_call(lhs_expr, method_name, rhs_expr, type_id, expr_id);
                if (overload_call != mir_id_invalid()) { return overload_call; }
                if (op == tk_NEQ()) {
                    let eq_call = self.lower_operator_method_call(lhs_expr, "operator==", rhs_expr, type_id, expr_id);
                    if (eq_call != mir_id_invalid()) {
                        let negated = self.unit.add_value( self.current_function_id, mir_value_unary(), type_id,
                                                        mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                                        hir_unit_expr_flags(self.h, expr_id), tk_NOT(),
                                                        hir_unit_expr_int_value(self.h, expr_id),
                                                        self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
                        self.unit.set_value_lhs( negated, eq_call);
                        return negated;
                    }
                }
            }
            let lhs_value = self.lower_expr(self.h.expr_lhs(expr_id));
            let rhs_value2 = self.lower_expr(self.h.expr_rhs(expr_id));
            let out = self.unit.add_value( self.current_function_id, mir_value_binary(), type_id,
                                         mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                         hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                         self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out, lhs_value);
            self.unit.set_value_rhs( out, rhs_value2);
            return out;
        }
        if (k == ex_AWAIT()) {
            return self.lower_await_expr(expr_id, type_id);
        }
        if (k == ex_UNARY() || k == ex_COMPTIME() || k == ex_FAIL()) {
            if (k == ex_UNARY()
                && (self.h.expr_op(expr_id) == tk_PLUSPLUS()
                    || self.h.expr_op(expr_id) == tk_MINUSMINUS())) {
                return self.lower_inc_dec_expr(expr_id);
            }
            let op_u = self.h.expr_op(expr_id);
            let method_name_u = mir_unary_operator_method_name(op_u);
            if (method_name_u.len > 0 && k == ex_UNARY()) {
                let lhs_expr_u = self.h.expr_lhs(expr_id);
                let overload_call_u = self.lower_operator_method_call(lhs_expr_u, method_name_u, hir_id_invalid(), type_id, expr_id);
                if (overload_call_u != mir_id_invalid()) { return overload_call_u; }
            }
            let inner_value = self.lower_expr(self.h.expr_lhs(expr_id));
            if (k == ex_UNARY() && self.h.expr_op(expr_id) == unary_op_own()) {
                let source_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
                let move_value = self.unit.add_value(
                                                    self.current_function_id,
                                                    mir_value_intrinsic(),
                                                    type_id,
                                                    source_place,
                                                    mir_target_none(),
                                                    mir_id_invalid(),
                                                    expr_id,
                                                    hir_unit_expr_flags(self.h, expr_id),
                                                    unary_op_own(),
                                                    0,
                                                    "__vyx_move_handle",
                                                    self.h.expr_value_text(expr_id));
                self.unit.set_value_lhs( move_value, inner_value);
                return move_value;
            }
            let out_un = self.unit.add_value( self.current_function_id, mir_value_unary(), type_id,
                                            mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                            hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                            self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_un, inner_value);
            return out_un;
        }
        if (k == ex_CAST()) {
            let lhs_expr = self.h.expr_lhs(expr_id);
            self.ensure_dyn_trait_methods_reachable(self.h.expr_type(lhs_expr), type_id);
            let cast_value = self.lower_expr(lhs_expr);
            let out_cast = self.unit.add_value( self.current_function_id, mir_value_cast(), type_id,
                                              mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_cast, cast_value);
            return out_cast;
        }
        if (k == ex_NEW()) {
            return self.lower_new_expr_value(expr_id, type_id);
        }
        if (k == ex_DELETE()) {
            return self.lower_delete_expr_value(expr_id, type_id);
        }
        if (k == ex_ADDR_OF()) {
            let addr_place = self.lower_expr_place(self.h.expr_lhs(expr_id));
            return self.unit.add_value( self.current_function_id, mir_value_address_of(), type_id,
                                      addr_place, mir_target_none(), mir_id_invalid(), expr_id,
                                      hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
        }
        if (k == ex_DEREF() || k == ex_MEMBER() || k == ex_INDEX()) {
            if (k == ex_INDEX()) {
                // WYSIWYG: when the index expression's declared type is a
                // reference (`&mut T` / `&T` return from operator[]), the
                // value IS the reference handle — do not collapse it to the
                // element view.  Scalar contexts keep the element-view read.
                let want_ref_value = self.index_expr_wants_reference_value(expr_id, type_id);
                if (!want_ref_value) {
                    let index_place = self.lower_overloaded_index_place(expr_id, false);
                    if (index_place != mir_id_invalid()) { return self.add_read_value(index_place, expr_id); }
                }
                let index_overload = self.lower_operator_method_call(self.h.expr_lhs(expr_id), "operator[]", self.h.expr_rhs(expr_id), type_id, expr_id);
                if (index_overload != mir_id_invalid()) { return index_overload; }
                let pack_index_value = self.lower_pack_index_expr(expr_id);
                if (pack_index_value != mir_id_invalid()) { return pack_index_value; }
            }
            if (!(k == ex_MEMBER() && self.h.expr_target_kind(expr_id) == hir_target_function())) {
                let place = self.lower_expr_place(expr_id);
                if (place != mir_id_invalid()) { return self.add_read_value(place, expr_id); }
            }
            let target_ref = self.unit.add_value(
                                                self.current_function_id,
                                                mir_value_target_ref(),
                                                type_id,
                                                mir_id_invalid(),
                                                self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                                self.target_id_from_hir_expr(expr_id),
                                                expr_id,
                                                hir_unit_expr_flags(self.h, expr_id),
                                                self.h.expr_op(expr_id),
                                                hir_unit_expr_int_value(self.h, expr_id),
                                                self.h.expr_name(expr_id),
                                                self.h.expr_value_text(expr_id));
            var member_lhs_value = mir_id_invalid();
            if (k == ex_MEMBER() && self.h.expr_lhs(expr_id) != hir_id_invalid()) {
                member_lhs_value = self.lower_expr(self.h.expr_lhs(expr_id));
                self.unit.set_value_lhs( target_ref, member_lhs_value);
            }
            if (k == ex_MEMBER()
                && self.h.expr_target_kind(expr_id) == hir_target_builtin()
                && self.h.expr_name(expr_id) == "fields"
                && member_lhs_value != mir_id_invalid()) {
                self.ensure_layouts_for_type(self.unit.value_type(member_lhs_value));
            }
            return target_ref;
        }
        if (k == ex_CALL()) {
            return self.lower_call_expr_value(expr_id, type_id, mir_id_invalid(), hir_id_invalid());
        }
        if (k == ex_STRUCT_INIT() || k == ex_ARRAY_LIT() || k == ex_TUPLE_LIT()) {
            // Container list init (`Vec<i32>{1, 2, 3}`) is rewritten at the
            // HIR level into `Type::from_array([e1..en], n)` — see
            // hir_builder.build_container_list_init_from_array_call — so the
            // MIR aggregate path only ever sees real field inits here.
            self.ensure_layouts_for_type(type_id);
            let out_ag = self.unit.add_value( self.current_function_id, mir_value_aggregate(), type_id,
                                            mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                            self.target_id_from_hir_expr(expr_id), expr_id,
                                            hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                            self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(out_ag, self.h.expr_first_arg(expr_id));
            if (self.h.expr_aux(expr_id) != hir_id_invalid()) {
                self.unit.set_value_aux( out_ag, self.lower_expr(self.h.expr_aux(expr_id)));
            }
            return out_ag;
        }
        if (k == ex_TERNARY()) {
            let lhs_tern = self.lower_expr(self.h.expr_lhs(expr_id));
            let rhs_tern = self.lower_expr(self.h.expr_rhs(expr_id));
            let aux_tern = self.lower_expr(self.h.expr_aux(expr_id));
            let out_tern = self.unit.add_value( self.current_function_id, mir_value_control_result(), type_id,
                                              mir_id_invalid(), mir_target_none(), mir_id_invalid(), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.unit.set_value_lhs( out_tern, lhs_tern);
            self.unit.set_value_rhs( out_tern, rhs_tern);
            self.unit.set_value_aux( out_tern, aux_tern);
            return out_tern;
        }
        if (k == ex_IF_EXPR()) {
            return self.lower_control_if_expr(expr_id);
        }
        if (k == ex_CLOSURE()) {
            let closure_hir_fn = self.h.expr_target_id(expr_id);
            let closure_mir_fn = self.target_id_from_hir_expr(expr_id);
            self.lower_capture_init_values_for_function(closure_hir_fn, closure_mir_fn);
            return self.unit.add_value(
                                      self.current_function_id,
                                      mir_value_target_ref(),
                                      type_id,
                                      mir_id_invalid(),
                                      self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                      closure_mir_fn,
                                      expr_id,
                                      hir_unit_expr_flags(self.h, expr_id),
                                      self.h.expr_op(expr_id),
                                      hir_unit_expr_int_value(self.h, expr_id),
                                      self.h.expr_name(expr_id),
                                      self.h.expr_value_text(expr_id));
        }
        if (k == ex_MATCH_EXPR()) {
            return self.lower_match_expr(expr_id);
        }
        if (k == ex_INLINE_ASM()) {
            let out_intr = self.unit.add_value( self.current_function_id, mir_value_intrinsic(), type_id,
                                              mir_id_invalid(), self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                              self.target_id_from_hir_expr(expr_id), expr_id,
                                              hir_unit_expr_flags(self.h, expr_id), self.h.expr_op(expr_id), hir_unit_expr_int_value(self.h, expr_id),
                                              self.h.expr_name(expr_id), self.h.expr_value_text(expr_id));
            self.lower_arg_values(out_intr, self.h.expr_first_arg(expr_id));
            return out_intr;
        }
        return self.unit.add_value(
                                  self.current_function_id,
                                  mir_value_intrinsic(),
                                  type_id,
                                  mir_id_invalid(),
                                  self.target_kind_from_hir(self.h.expr_target_kind(expr_id)),
                                  self.target_id_from_hir_expr(expr_id),
                                  expr_id,
                                  hir_unit_expr_flags(self.h, expr_id),
                                  self.h.expr_op(expr_id),
                                  hir_unit_expr_int_value(self.h, expr_id),
                                  self.h.expr_name(expr_id),
                                  self.h.expr_value_text(expr_id));
    }

    public fn lower_stmt_chain(self, first_stmt_id: i32) {
        var cur = first_stmt_id;
        while (cur != hir_id_invalid()) {
            if (self.current_block_terminated()) { return; }
            self.lower_stmt(cur);
            cur = self.h.stmt_next(cur);
        }
    }

    public fn last_stmt_in_chain(self, first_stmt_id: i32) -> i32 {
        var cur = first_stmt_id;
        var last = hir_id_invalid();
        while (cur != hir_id_invalid()) {
            last = cur;
            cur = self.h.stmt_next(cur);
        }
        return last;
    }

    public fn implicit_return_stmt_for_body(self, body_stmt_id: i32) -> i32 {
        if (body_stmt_id == hir_id_invalid()) { return hir_id_invalid(); }
        let k = self.h.stmt_kind(body_stmt_id);
        if (k == hir_stmt_expr()) { return body_stmt_id; }
        if (k == hir_stmt_block()) {
            let last = self.last_stmt_in_chain(self.h.stmt_child(body_stmt_id));
            if (last != hir_id_invalid() && self.h.stmt_kind(last) == hir_stmt_expr()) { return last; }
        }
        return hir_id_invalid();
    }

    public fn lower_body_before_implicit_return(self, body_stmt_id: i32, return_stmt_id: i32) -> bool {
        if (return_stmt_id == hir_id_invalid()) { return false; }
        if (body_stmt_id == return_stmt_id) { return true; }
        if (self.h.stmt_kind(body_stmt_id) != hir_stmt_block()) { return false; }
        var cur = self.h.stmt_child(body_stmt_id);
        while (cur != hir_id_invalid() && cur != return_stmt_id) {
            if (self.current_block_terminated()) { return true; }
            self.lower_stmt(cur);
            cur = self.h.stmt_next(cur);
        }
        return cur == return_stmt_id;
    }

    public fn try_lower_implicit_function_return(self, body_stmt_id: i32, return_type: i32) -> bool {
        if (self.type_text(return_type) == "void") { return false; }
        if (self.return_type_is_constructor(self.current_hir_function_id, return_type)) {
            return false;
        }
        let return_stmt = self.implicit_return_stmt_for_body(body_stmt_id);
        if (return_stmt == hir_id_invalid()) { return false; }
        let return_expr = self.h.stmt_expr(return_stmt);
        if (return_expr == hir_id_invalid()) { return false; }
        if (self.type_text(self.h.expr_type(return_expr)) == "void") { return false; }
        if (!self.lower_body_before_implicit_return(body_stmt_id, return_stmt)) { return false; }
        if (self.current_block_terminated()) { return true; }
        var ret_value = mir_id_invalid();
        if (self.return_expr_needs_awaitable_ready(return_type, return_expr)) {
            ret_value = self.lower_awaitable_ready_return(return_expr, return_type);
        } else {
            ret_value = self.lower_expr_as(return_expr, return_type);
        }
        self.deactivate_moved_source_expr_except(return_expr, hir_id_invalid());
        ret_value = self.materialize_return_value(ret_value, return_type, return_stmt, return_expr);
        self.emit_function_exit(return_stmt);
        self.terminate_current(mir_term_return(), ret_value, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), return_stmt);
        return true;
    }

    public fn drop_stack_snapshot_has(self, snapshot: rawptr, hir_local_id: i32) -> bool {
        var cur = snapshot;
        while (cur != null) {
            let stack_node = ast_read_rawptr(cur);
            if (stack_node != null && ast_read_i32(stack_node) == hir_local_id) { return true; }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return false;
    }

    public fn drop_stack_snapshot_active(self, snapshot: rawptr, hir_local_id: i32) -> bool {
        // Absent from the snapshot means the sibling branch never saw this
        // local (declared inside the other branch): no fact either way.
        var cur = snapshot;
        while (cur != null) {
            let stack_node = ast_read_rawptr(cur);
            if (stack_node != null && ast_read_i32(stack_node) == hir_local_id) {
                return ast_read_i32(ptr_offset(cur, 8)) != 0;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return true;
    }

    public fn emit_branch_compensation_drops(self, sibling_state: rawptr, source_stmt_id: i32) {
        // The sibling branch moved these locals away, so nothing after the
        // join will drop them; this branch still owns them and must release
        // them exactly once before handing control to the join.
        var cur = self.drop_stack_head;
        while (cur != null) {
            let hir_local_id = ast_read_i32(cur);
            if (self.drop_stack_local_active(hir_local_id)
                && self.drop_stack_snapshot_has(sibling_state, hir_local_id)
                && !self.drop_stack_snapshot_active(sibling_state, hir_local_id)) {
                self.emit_drop_for_hir_local(hir_local_id, source_stmt_id, hir_id_invalid(), true);
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
    }

    public fn merge_branch_join_drop_state(self,
                                           then_post: rawptr,
                                           then_reaches: bool,
                                           else_post: rawptr,
                                           else_reaches: bool,
                                           pre_state: rawptr) {
        // Join activity = AND over the branches that reach the join.  A local
        // moved in either reaching branch was already compensated (dropped)
        // in the branch that still owned it, so it must stay inactive here;
        // dropping it again at the join would be a double free.
        var cur = self.drop_stack_head;
        while (cur != null) {
            let hir_local_id = ast_read_i32(cur);
            var merged = true;
            var any_reaches = false;
            if (then_reaches) {
                merged = merged && self.drop_stack_snapshot_active(then_post, hir_local_id);
                any_reaches = true;
            }
            if (else_reaches) {
                merged = merged && self.drop_stack_snapshot_active(else_post, hir_local_id);
                any_reaches = true;
            }
            if (!any_reaches) { merged = self.drop_stack_snapshot_active(pre_state, hir_local_id); }
            self.drop_stack_set_active(hir_local_id, merged);
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
    }

    public fn lower_if_stmt(self, stmt_id: i32) {
        let cond_value = self.lower_expr(self.h.stmt_cond(stmt_id));
        let then_block = self.add_block(self.h.stmt_child(stmt_id));
        let else_block = self.add_block(self.h.stmt_else(stmt_id));
        let join_block = self.add_block(hir_id_invalid());
        let branch_drop_mark = self.drop_stack_head;
        let branch_defer_mark = self.defer_stack_head;
        let branch_storage_mark = self.storage_stack_head;
        let branch_drop_state = self.drop_stack_snapshot();
        self.terminate_current(mir_term_branch(), cond_value, then_block, else_block, mir_id_invalid(), stmt_id);

        // THEN branch: lowered fully, but its goto to the join is deferred
        // until the sibling branch's move facts are known — the compensation
        // pass below still has to append drops into this block.
        self.set_current_block(then_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        self.lower_stmt(self.h.stmt_child(stmt_id));
        let then_reaches = !self.current_block_terminated();
        var then_end_state: rawptr = null;
        var then_cont_block: i32 = mir_id_invalid();
        if (then_reaches) {
            self.emit_scope_exit_until(branch_defer_mark,
                                       branch_drop_mark,
                                       branch_storage_mark,
                                       stmt_id);
            // Nested control flow may have moved the continuation off the
            // branch's entry block; the goto and the compensation drops must
            // land on the block where the body actually ends.
            then_cont_block = self.current_block_id;
            then_end_state = self.drop_stack_snapshot();
        }
        self.drop_stack_restore_activity(branch_drop_state);

        // ELSE branch: same shape, starting from the pre-branch state.
        self.set_current_block(else_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        self.lower_stmt(self.h.stmt_else(stmt_id));
        let else_reaches = !self.current_block_terminated();
        var else_end_state: rawptr = null;
        var else_cont_block: i32 = mir_id_invalid();
        if (else_reaches) {
            self.emit_scope_exit_until(branch_defer_mark,
                                       branch_drop_mark,
                                       branch_storage_mark,
                                       stmt_id);
            else_cont_block = self.current_block_id;
            else_end_state = self.drop_stack_snapshot();
        }
        self.drop_stack_restore_activity(branch_drop_state);

        // Compensation + termination, now that both branches' move facts are
        // known: a local moved in the sibling but still owned here is dropped
        // here, once, at the branch exit.
        self.set_current_block(then_cont_block);
        if (then_reaches) {
            self.drop_stack_restore_activity(then_end_state);
            if (else_reaches) {
                self.emit_branch_compensation_drops(else_end_state, stmt_id);
            }
            then_end_state = self.drop_stack_snapshot();
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(else_cont_block);
        if (else_reaches) {
            self.drop_stack_restore_activity(else_end_state);
            if (then_reaches) {
                self.emit_branch_compensation_drops(then_end_state, stmt_id);
            }
            else_end_state = self.drop_stack_snapshot();
            self.terminate_current_goto(join_block);
        }

        self.set_current_block(join_block);
        self.drop_stack_head = branch_drop_mark;
        self.defer_stack_head = branch_defer_mark;
        self.storage_stack_head = branch_storage_mark;
        self.merge_branch_join_drop_state(then_end_state, then_reaches,
                                          else_end_state, else_reaches,
                                          branch_drop_state);
    }

    public fn lower_while_stmt(self, stmt_id: i32) {
        let cond_block = self.add_block(stmt_id);
        let body_block = self.add_block(self.h.stmt_child(stmt_id));
        let exit_block = self.add_block(hir_id_invalid());
        self.terminate_current_goto(cond_block);
        self.set_current_block(cond_block);
        let cond_value = self.lower_expr(self.h.stmt_cond(stmt_id));
        self.terminate_current(mir_term_branch(), cond_value, body_block, exit_block, mir_id_invalid(), stmt_id);

        let saved_break = self.break_target_block_id;
        let saved_continue = self.continue_target_block_id;
        let saved_break_drop = self.break_drop_mark;
        let saved_continue_drop = self.continue_drop_mark;
        let saved_break_defer = self.break_defer_mark;
        let saved_continue_defer = self.continue_defer_mark;
        let saved_break_storage = self.break_storage_mark;
        let saved_continue_storage = self.continue_storage_mark;
        let loop_drop_mark = self.drop_stack_head;
        let loop_defer_mark = self.defer_stack_head;
        let loop_storage_mark = self.storage_stack_head;
        let loop_drop_state = self.drop_stack_snapshot();
        self.break_target_block_id = exit_block;
        self.continue_target_block_id = cond_block;
        self.break_drop_mark = loop_drop_mark;
        self.continue_drop_mark = loop_drop_mark;
        self.break_defer_mark = loop_defer_mark;
        self.continue_defer_mark = loop_defer_mark;
        self.break_storage_mark = loop_storage_mark;
        self.continue_storage_mark = loop_storage_mark;
        self.push_labeled_loop(stmt_id,
                                exit_block,
                                cond_block,
                                loop_drop_mark,
                                loop_defer_mark,
                                loop_storage_mark);
        self.set_current_block(body_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.lower_stmt(self.h.stmt_child(stmt_id));
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(cond_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);
        self.pop_labeled_loop(stmt_id);
        self.break_target_block_id = saved_break;
        self.continue_target_block_id = saved_continue;
        self.break_drop_mark = saved_break_drop;
        self.continue_drop_mark = saved_continue_drop;
        self.break_defer_mark = saved_break_defer;
        self.continue_defer_mark = saved_continue_defer;
        self.break_storage_mark = saved_break_storage;
        self.continue_storage_mark = saved_continue_storage;
        self.set_current_block(exit_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
    }

    public fn lower_for_stmt(self, stmt_id: i32) {
        // The init declaration belongs to the for statement, not the
        // surrounding lexical block.  Keep a pre-init mark so exit_block can
        // close it after condition failure or break.
        let for_drop_mark = self.drop_stack_head;
        let for_defer_mark = self.defer_stack_head;
        let for_storage_mark = self.storage_stack_head;
        self.lower_stmt(self.h.stmt_child(stmt_id));
        if (self.current_block_terminated()) { return; }
        let cond_block = self.add_block(stmt_id);
        let body_block = self.add_block(self.h.stmt_aux(stmt_id));
        let step_block = self.add_block(self.h.stmt_else(stmt_id));
        let exit_block = self.add_block(hir_id_invalid());
        self.terminate_current_goto(cond_block);
        self.set_current_block(cond_block);
        let cond_value = self.lower_expr(self.h.stmt_cond(stmt_id));
        self.terminate_current(mir_term_branch(), cond_value, body_block, exit_block, mir_id_invalid(), stmt_id);

        let saved_break = self.break_target_block_id;
        let saved_continue = self.continue_target_block_id;
        let saved_break_drop = self.break_drop_mark;
        let saved_continue_drop = self.continue_drop_mark;
        let saved_break_defer = self.break_defer_mark;
        let saved_continue_defer = self.continue_defer_mark;
        let saved_break_storage = self.break_storage_mark;
        let saved_continue_storage = self.continue_storage_mark;
        let loop_drop_mark = self.drop_stack_head;
        let loop_defer_mark = self.defer_stack_head;
        let loop_storage_mark = self.storage_stack_head;
        let loop_drop_state = self.drop_stack_snapshot();
        self.break_target_block_id = exit_block;
        self.continue_target_block_id = step_block;
        self.break_drop_mark = loop_drop_mark;
        self.continue_drop_mark = loop_drop_mark;
        self.break_defer_mark = loop_defer_mark;
        self.continue_defer_mark = loop_defer_mark;
        self.break_storage_mark = loop_storage_mark;
        self.continue_storage_mark = loop_storage_mark;
        self.push_labeled_loop(stmt_id,
                                exit_block,
                                step_block,
                                loop_drop_mark,
                                loop_defer_mark,
                                loop_storage_mark);
        self.set_current_block(body_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.lower_stmt(self.h.stmt_aux(stmt_id));
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(step_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);
        self.set_current_block(step_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.lower_stmt(self.h.stmt_else(stmt_id));
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(cond_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);
        self.pop_labeled_loop(stmt_id);
        self.break_target_block_id = saved_break;
        self.continue_target_block_id = saved_continue;
        self.break_drop_mark = saved_break_drop;
        self.continue_drop_mark = saved_continue_drop;
        self.break_defer_mark = saved_break_defer;
        self.continue_defer_mark = saved_continue_defer;
        self.break_storage_mark = saved_break_storage;
        self.continue_storage_mark = saved_continue_storage;
        self.set_current_block(exit_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.emit_scope_exit_until(for_defer_mark,
                                   for_drop_mark,
                                   for_storage_mark,
                                   stmt_id);
    }

    public fn expr_is_direct_range(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (self.h.expr_kind(expr_id) != ex_BIN()) { return false; }
        let op = self.h.expr_op(expr_id);
        return op == tk_DOTDOT() || op == tk_DOTDOTEQ();
    }

    public fn lower_range_foreach_stmt(self, stmt_id: i32) -> bool {
        let range_expr = self.h.stmt_cond(stmt_id);
        if (!self.expr_is_direct_range(range_expr)) { return false; }
        let loop_place = mir_i32_map_get(self.place_map, self.h.stmt_local(stmt_id));
        if (loop_place == mir_id_invalid()) { return false; }
        let i64_type = self.i64_type_id();
        let start_expr = self.h.expr_lhs(range_expr);
        let end_expr = self.h.expr_rhs(range_expr);
        let start_value = self.lower_expr_as(start_expr, i64_type);
        var end_value = self.lower_expr_as(end_expr, i64_type);
        if (self.h.expr_op(range_expr) == tk_DOTDOTEQ()) {
            end_value = self.add_binary_value(i64_type,
                                              tk_PLUS(),
                                              end_value,
                                              self.add_const_i64_value(1, range_expr),
                                              range_expr,
                                              "range.end.inclusive");
        }
        let end_place = self.add_temp_place(i64_type, range_expr, "__range_end");
        self.emit_assign(loop_place, start_value, stmt_id, start_expr);
        self.emit_assign(end_place, end_value, stmt_id, end_expr);

        let cond_block = self.add_block(stmt_id);
        let body_block = self.add_block(self.h.stmt_child(stmt_id));
        let step_block = self.add_block(stmt_id);
        let exit_block = self.add_block(hir_id_invalid());
        self.terminate_current_goto(cond_block);
        self.set_current_block(cond_block);
        let current_value = self.add_read_value(loop_place, range_expr);
        let limit_value = self.add_read_value(end_place, range_expr);
        let cond_value = self.add_binary_value(self.bool_type_id(),
                                               tk_LT(),
                                               current_value,
                                               limit_value,
                                               range_expr,
                                               "range.cond");
        self.terminate_current(mir_term_branch(), cond_value, body_block, exit_block, mir_id_invalid(), stmt_id);

        let saved_break = self.break_target_block_id;
        let saved_continue = self.continue_target_block_id;
        let saved_break_drop = self.break_drop_mark;
        let saved_continue_drop = self.continue_drop_mark;
        let saved_break_defer = self.break_defer_mark;
        let saved_continue_defer = self.continue_defer_mark;
        let saved_break_storage = self.break_storage_mark;
        let saved_continue_storage = self.continue_storage_mark;
        let loop_drop_mark = self.drop_stack_head;
        let loop_defer_mark = self.defer_stack_head;
        let loop_storage_mark = self.storage_stack_head;
        let loop_drop_state = self.drop_stack_snapshot();
        self.break_target_block_id = exit_block;
        self.continue_target_block_id = step_block;
        self.break_drop_mark = loop_drop_mark;
        self.continue_drop_mark = loop_drop_mark;
        self.break_defer_mark = loop_defer_mark;
        self.continue_defer_mark = loop_defer_mark;
        self.break_storage_mark = loop_storage_mark;
        self.continue_storage_mark = loop_storage_mark;
        self.push_labeled_loop(stmt_id,
                                exit_block,
                                step_block,
                                loop_drop_mark,
                                loop_defer_mark,
                                loop_storage_mark);

        self.set_current_block(body_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.lower_stmt(self.h.stmt_child(stmt_id));
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(step_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);

        self.set_current_block(step_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        let step_current = self.add_read_value(loop_place, range_expr);
        let next_value = self.add_binary_value(self.unit.place_type(loop_place),
                                               tk_PLUS(),
                                               step_current,
                                               self.add_const_i64_value(1, range_expr),
                                               range_expr,
                                               "range.step");
        self.emit_assign(loop_place, next_value, stmt_id, range_expr);
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(cond_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);

        self.pop_labeled_loop(stmt_id);
        self.break_target_block_id = saved_break;
        self.continue_target_block_id = saved_continue;
        self.break_drop_mark = saved_break_drop;
        self.continue_drop_mark = saved_continue_drop;
        self.break_defer_mark = saved_break_defer;
        self.continue_defer_mark = saved_continue_defer;
        self.break_storage_mark = saved_break_storage;
        self.continue_storage_mark = saved_continue_storage;
        self.set_current_block(exit_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        return true;
    }

    public fn lower_foreach_stmt(self, stmt_id: i32) {
        if (self.lower_range_foreach_stmt(stmt_id)) { return; }
        let raw_iter_value = self.lower_expr(self.h.stmt_cond(stmt_id));
        var iter_value = self.lower_string_foreach_iterator(raw_iter_value,
                                                            self.h.stmt_cond(stmt_id));
        if (raw_iter_value != mir_id_invalid()
            && !(self.unit.value_kind(raw_iter_value) == mir_value_target_ref()
                 && self.unit.value_target_kind(raw_iter_value) == mir_target_builtin()
                 && (self.unit.value_name(raw_iter_value) == "fields"
                     || self.unit.value_name(raw_iter_value) == "methods"))) {
            self.mark_foreach_iterator_methods_reachable(self.unit.value_type(iter_value));
            let iter_place = self.add_temp_place(self.unit.value_type(iter_value),
                                                 self.h.stmt_cond(stmt_id),
                                                 "__foreach_iter");
            self.add_assign_instr(iter_place,
                                  iter_value,
                                  stmt_id,
                                  self.h.stmt_cond(stmt_id),
                                  "__foreach_iter");
            iter_value = self.add_read_value(iter_place, self.h.stmt_cond(stmt_id));
        }
        let index_place = self.add_temp_place(self.i64_type_id(),
                                              self.h.stmt_cond(stmt_id),
                                              "__foreach_index");
        self.add_assign_instr(index_place,
                              self.add_const_i64_value(0, self.h.stmt_cond(stmt_id)),
                              stmt_id,
                              self.h.stmt_cond(stmt_id),
                              "__foreach_index");
        let loop_block = self.add_block(stmt_id);
        let body_block = self.add_block(self.h.stmt_child(stmt_id));
        let exit_block = self.add_block(hir_id_invalid());
        self.terminate_current_goto(loop_block);
        self.set_current_block(loop_block);
        self.terminate_current(mir_term_foreach_next(),
                               iter_value,
                               body_block,
                               exit_block,
                               mir_id_invalid(),
                               index_place);

        let saved_break = self.break_target_block_id;
        let saved_continue = self.continue_target_block_id;
        let saved_break_drop = self.break_drop_mark;
        let saved_continue_drop = self.continue_drop_mark;
        let saved_break_defer = self.break_defer_mark;
        let saved_continue_defer = self.continue_defer_mark;
        let saved_break_storage = self.break_storage_mark;
        let saved_continue_storage = self.continue_storage_mark;
        let loop_drop_mark = self.drop_stack_head;
        let loop_defer_mark = self.defer_stack_head;
        let loop_storage_mark = self.storage_stack_head;
        let loop_drop_state = self.drop_stack_snapshot();
        self.break_target_block_id = exit_block;
        self.continue_target_block_id = loop_block;
        self.break_drop_mark = loop_drop_mark;
        self.continue_drop_mark = loop_drop_mark;
        self.break_defer_mark = loop_defer_mark;
        self.continue_defer_mark = loop_defer_mark;
        self.break_storage_mark = loop_storage_mark;
        self.continue_storage_mark = loop_storage_mark;
        self.push_labeled_loop(stmt_id,
                                exit_block,
                                loop_block,
                                loop_drop_mark,
                                loop_defer_mark,
                                loop_storage_mark);
        self.set_current_block(body_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
        self.unit.add_instr(
                           self.current_function_id,
                           self.current_block_id,
                           mir_instr_foreach_bind(),
                           self.h.stmt_type(stmt_id),
                           mir_i32_map_get(self.place_map, self.h.stmt_local(stmt_id)),
                           iter_value,
                           mir_id_invalid(),
                           mir_id_invalid(),
                           mir_target_none(),
                           mir_id_invalid(),
                           stmt_id,
                           self.h.stmt_cond(stmt_id),
                           0,
                           index_place,
                           self.h.stmt_name(stmt_id));
        self.lower_stmt(self.h.stmt_child(stmt_id));
        if (!self.current_block_terminated()) {
            self.emit_scope_exit_until(loop_defer_mark,
                                       loop_drop_mark,
                                       loop_storage_mark,
                                       stmt_id);
            self.terminate_current_goto(loop_block);
        }
        self.drop_stack_restore_activity(loop_drop_state);
        self.pop_labeled_loop(stmt_id);
        self.break_target_block_id = saved_break;
        self.continue_target_block_id = saved_continue;
        self.break_drop_mark = saved_break_drop;
        self.continue_drop_mark = saved_continue_drop;
        self.break_defer_mark = saved_break_defer;
        self.continue_defer_mark = saved_continue_defer;
        self.break_storage_mark = saved_break_storage;
        self.continue_storage_mark = saved_continue_storage;
        self.set_current_block(exit_block);
        self.drop_stack_head = loop_drop_mark;
        self.defer_stack_head = loop_defer_mark;
        self.storage_stack_head = loop_storage_mark;
    }

    public fn lower_match_stmt(self, stmt_id: i32) {
        let subject_expr = self.h.stmt_expr(stmt_id);
        let raw_subject_value = self.lower_expr(subject_expr);
        var subject_value = raw_subject_value;
        let subject_drop_outer_mark = self.drop_stack_head;
        var owned_subject_hir_local = hir_id_invalid();
        if (raw_subject_value != mir_id_invalid()) {
            // Every case dispatch must observe the value captured when the
            // match was entered.  Re-lowering a call (or reloading a local
            // mutated by a guard) changes match semantics.
            let subject_type = self.unit.value_type(raw_subject_value);
            let subject_category = hir_unit_expr_value_category(self.h, subject_expr);
            let subject_move_flags = hir_unit_expr_move_drop_flags(self.h, subject_expr);
            let subject_drop_fn = hir_unit_expr_drop_function(self.h, subject_expr);
            let subject_is_owned = subject_category == hir_value_cat_value()
                && (subject_move_flags & hir_move_drop_flag_borrow_arg()) == 0
                && (subject_drop_fn != hir_id_invalid()
                    || self.hir_type_text_is_dci_stub_class(self.type_text(subject_type)));
            var subject_place = mir_id_invalid();
            if (subject_is_owned) {
                subject_place = self.add_owned_temp_place(subject_type,
                                                          subject_expr,
                                                          "match_subject",
                                                          subject_drop_fn);
                owned_subject_hir_local = self.hir_local_for_place(subject_place);
            } else {
                subject_place = self.add_temp_place(subject_type,
                                                    subject_expr,
                                                    "match_subject");
            }
            self.emit_assign(subject_place, raw_subject_value, stmt_id, subject_expr);
            subject_value = self.add_read_value(subject_place, subject_expr);
        }
        var dispatch_block = self.current_block_id;
        let exit_block = self.add_block(hir_id_invalid());
        let match_drop_mark = self.drop_stack_head;
        let match_defer_mark = self.defer_stack_head;
        let match_storage_mark = self.storage_stack_head;
        let match_drop_state = self.drop_stack_snapshot();
        var lowering_default_arms = false;
        // Reaching arms, collected as {body_block, end_state, next} nodes:
        // their goto to the exit block is deferred until every arm's move
        // facts are known, so the compensation pass can still append drops.
        var reached_arms: rawptr = null;
        var arm = self.h.stmt_child(stmt_id);
        while (arm != hir_id_invalid() || !lowering_default_arms) {
            if (arm == hir_id_invalid()) {
                lowering_default_arms = true;
                arm = self.h.stmt_child(stmt_id);
            }
            if (arm == hir_id_invalid()) { break; }
            let next_arm = self.h.stmt_next(arm);
            let pattern_expr = self.h.stmt_expr(arm);
            let pattern_is_default = pattern_expr != hir_id_invalid()
                && self.h.expr_kind(pattern_expr) == ex_NULL_LIT()
                && self.h.expr_name(pattern_expr) == "__match_default";
            if (pattern_is_default != lowering_default_arms) {
                arm = next_arm;
                continue;
            }
            let next_dispatch = self.add_block(next_arm);
            let arm_block = self.add_block(arm);
            let body_block = self.add_block(self.h.stmt_child(arm));

            self.set_current_block(dispatch_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            let pat_value = self.lower_expr(pattern_expr);
            // Pattern lowering can expand short-circuit expressions into CFG.
            // The case belongs to, and must terminate, the resulting join block.
            let case_owner_block = self.current_block_id;
            let case_id = self.unit.add_case(
                                            case_owner_block,
                                            pat_value,
                                            mir_id_invalid(),
                                            arm_block,
                                            arm,
                                            self.h.stmt_name(arm));
            self.terminate_current(mir_term_match(),
                                   subject_value,
                                   mir_id_invalid(),
                                   next_dispatch,
                                   case_id,
                                   stmt_id);

            self.set_current_block(arm_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            self.unit.add_instr(
                               self.current_function_id,
                               self.current_block_id,
                               mir_instr_match_arm(),
                               self.h.stmt_type(arm),
                               mir_id_invalid(),
                               pat_value,
                               mir_id_invalid(),
                               subject_value,
                               mir_target_none(),
                               mir_id_invalid(),
                               arm,
                               self.h.stmt_expr(arm),
                               0,
                               0,
                               self.h.stmt_name(arm));

            let guard_expr = self.h.stmt_cond(arm);
            var guard_value = mir_id_invalid();
            if (guard_expr != hir_id_invalid()) {
                guard_value = self.lower_expr(guard_expr);
            }
            if (!self.current_block_terminated()) {
                if (guard_value != mir_id_invalid()) {
                    self.terminate_current(mir_term_branch(),
                                           guard_value,
                                           body_block,
                                           next_dispatch,
                                           mir_id_invalid(),
                                           arm);
                } else {
                    self.terminate_current_goto(body_block);
                }
            }

            self.set_current_block(body_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            self.lower_stmt(self.h.stmt_child(arm));
            if (!self.current_block_terminated()) {
                self.emit_scope_exit_until(match_defer_mark,
                                           match_drop_mark,
                                           match_storage_mark,
                                           arm);
                let arm_node = mir_profile_malloc(24);
                if (arm_node != null) {
                    memset(arm_node, 0, 24);
                    // Nested control flow may have moved the continuation off
                    // the body's entry block; record where the arm ends.
                    ast_write_i32(arm_node, self.current_block_id);
                    ast_write_rawptr(ptr_offset(arm_node, 8), self.drop_stack_snapshot());
                    ast_write_rawptr(ptr_offset(arm_node, 16), reached_arms);
                    reached_arms = arm_node;
                }
            }
            self.drop_stack_restore_activity(match_drop_state);
            dispatch_block = next_dispatch;
            arm = next_arm;
        }

        // Compensation pass: every reaching arm is still an open block here,
        // so each one can drop the locals a sibling arm moved away before any
        // of them hands control to the exit block.
        var arm_iter = reached_arms;
        while (arm_iter != null) {
            let arm_body_block = ast_read_i32(arm_iter);
            self.set_current_block(arm_body_block);
            self.drop_stack_restore_activity(ast_read_rawptr(ptr_offset(arm_iter, 8)));
            var sib = reached_arms;
            while (sib != null) {
                if (ast_read_i32(sib) != arm_body_block) {
                    self.emit_branch_compensation_drops(ast_read_rawptr(ptr_offset(sib, 8)), stmt_id);
                }
                sib = ast_read_rawptr(ptr_offset(sib, 16));
            }
            ast_write_rawptr(ptr_offset(arm_iter, 8), self.drop_stack_snapshot());
            self.terminate_current_goto(exit_block);
            arm_iter = ast_read_rawptr(ptr_offset(arm_iter, 16));
        }

        // Falling through every case is the explicit non-exhaustive path.
        // Backends lower an empty match with no fallback to unreachable/panic.
        self.set_current_block(dispatch_block);
        self.drop_stack_head = match_drop_mark;
        self.defer_stack_head = match_defer_mark;
        self.storage_stack_head = match_storage_mark;
        self.terminate_current(mir_term_match(),
                               subject_value,
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_id_invalid(),
                               stmt_id);
        self.set_current_block(exit_block);
        self.drop_stack_head = match_drop_mark;
        self.defer_stack_head = match_defer_mark;
        self.storage_stack_head = match_storage_mark;
        // Exit activity = AND over the reaching arms' post-compensation
        // states: a local moved in any arm was already dropped by every arm
        // that still owned it, so it must stay inactive here.
        var exit_cur = self.drop_stack_head;
        while (exit_cur != null) {
            let exit_local_id = ast_read_i32(exit_cur);
            var exit_merged = true;
            var exit_iter = reached_arms;
            while (exit_iter != null) {
                exit_merged = exit_merged
                    && self.drop_stack_snapshot_active(ast_read_rawptr(ptr_offset(exit_iter, 8)),
                                                       exit_local_id);
                exit_iter = ast_read_rawptr(ptr_offset(exit_iter, 16));
            }
            self.drop_stack_set_active(exit_local_id, exit_merged);
            exit_cur = ast_read_rawptr(ptr_offset(exit_cur, 8));
        }
        if (owned_subject_hir_local != hir_id_invalid()) {
            self.emit_drop_for_hir_local(owned_subject_hir_local,
                                         stmt_id,
                                         subject_expr,
                                         true);
            self.drop_stack_head = subject_drop_outer_mark;
        }
    }

    public fn lower_match_expr(self, expr_id: i32) -> i32 {
        let result_place = self.add_temp_place_with_flags(self.h.expr_type(expr_id),
                                                           expr_id,
                                                           "match_expr",
                                                           mir_local_flag_if_expr_result());
        let subject_expr = self.h.expr_lhs(expr_id);
        let raw_subject_value = self.lower_expr(subject_expr);
        var subject_value = raw_subject_value;
        let subject_drop_outer_mark = self.drop_stack_head;
        var owned_subject_hir_local = hir_id_invalid();
        if (raw_subject_value != mir_id_invalid()) {
            // Every case dispatch must observe the value captured when the
            // match was entered.  Re-lowering a call (or reloading a local
            // mutated by a guard) changes match semantics.
            let subject_type = self.unit.value_type(raw_subject_value);
            let subject_category = hir_unit_expr_value_category(self.h, subject_expr);
            let subject_move_flags = hir_unit_expr_move_drop_flags(self.h, subject_expr);
            let subject_drop_fn = hir_unit_expr_drop_function(self.h, subject_expr);
            let subject_is_owned = subject_category == hir_value_cat_value()
                && (subject_move_flags & hir_move_drop_flag_borrow_arg()) == 0
                && (subject_drop_fn != hir_id_invalid()
                    || self.hir_type_text_is_dci_stub_class(self.type_text(subject_type)));
            var subject_place = mir_id_invalid();
            if (subject_is_owned) {
                subject_place = self.add_owned_temp_place(subject_type,
                                                          subject_expr,
                                                          "match_subject",
                                                          subject_drop_fn);
                owned_subject_hir_local = self.hir_local_for_place(subject_place);
            } else {
                subject_place = self.add_temp_place(subject_type,
                                                    subject_expr,
                                                    "match_subject");
            }
            self.emit_assign(subject_place, raw_subject_value, expr_id, subject_expr);
            subject_value = self.add_read_value(subject_place, subject_expr);
        }
        var dispatch_block = self.current_block_id;
        let exit_block = self.add_block(hir_id_invalid());
        let match_drop_mark = self.drop_stack_head;
        let match_defer_mark = self.defer_stack_head;
        let match_storage_mark = self.storage_stack_head;
        let match_drop_state = self.drop_stack_snapshot();
        var lowering_default_arms = false;
        // Reaching arms, collected as {body_block, end_state, next} nodes:
        // their goto to the exit block is deferred until every arm's move
        // facts are known, so the compensation pass can still append drops.
        var reached_arms: rawptr = null;
        var arm = self.h.expr_stmt_rhs(expr_id);
        while (arm != hir_id_invalid() || !lowering_default_arms) {
            if (arm == hir_id_invalid()) {
                lowering_default_arms = true;
                arm = self.h.expr_stmt_rhs(expr_id);
            }
            if (arm == hir_id_invalid()) { break; }
            let next_arm = self.h.stmt_next(arm);
            let pattern_expr = self.h.stmt_expr(arm);
            let pattern_is_default = pattern_expr != hir_id_invalid()
                && self.h.expr_kind(pattern_expr) == ex_NULL_LIT()
                && self.h.expr_name(pattern_expr) == "__match_default";
            if (pattern_is_default != lowering_default_arms) {
                arm = next_arm;
                continue;
            }
            let next_dispatch = self.add_block(next_arm);
            let arm_block = self.add_block(arm);
            let body_block = self.add_block(self.h.stmt_child(arm));

            self.set_current_block(dispatch_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            let pat_value = self.lower_expr(pattern_expr);
            // Pattern lowering can expand short-circuit expressions into CFG.
            // The case belongs to, and must terminate, the resulting join block.
            let case_owner_block = self.current_block_id;
            let case_id = self.unit.add_case(
                                            case_owner_block,
                                            pat_value,
                                            mir_id_invalid(),
                                            arm_block,
                                            arm,
                                            self.h.stmt_name(arm));
            self.terminate_current(mir_term_match(),
                                   subject_value,
                                   mir_id_invalid(),
                                   next_dispatch,
                                   case_id,
                                   expr_id);

            self.set_current_block(arm_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            self.unit.add_instr(
                               self.current_function_id,
                               self.current_block_id,
                               mir_instr_match_arm(),
                               self.h.stmt_type(arm),
                               mir_id_invalid(),
                               pat_value,
                               mir_id_invalid(),
                               subject_value,
                               mir_target_none(),
                               mir_id_invalid(),
                               arm,
                               self.h.stmt_expr(arm),
                               0,
                               0,
                               self.h.stmt_name(arm));

            let guard_expr = self.h.stmt_cond(arm);
            var guard_value = mir_id_invalid();
            if (guard_expr != hir_id_invalid()) {
                guard_value = self.lower_expr(guard_expr);
            }
            if (!self.current_block_terminated()) {
                if (guard_value != mir_id_invalid()) {
                    self.terminate_current(mir_term_branch(),
                                           guard_value,
                                           body_block,
                                           next_dispatch,
                                           mir_id_invalid(),
                                           arm);
                } else {
                    self.terminate_current_goto(body_block);
                }
            }

            self.set_current_block(body_block);
            self.drop_stack_head = match_drop_mark;
            self.defer_stack_head = match_defer_mark;
            self.storage_stack_head = match_storage_mark;
            self.lower_stmt_into_place(self.h.stmt_child(arm), result_place, expr_id);
            if (!self.current_block_terminated()) {
                self.emit_scope_exit_until(match_defer_mark,
                                           match_drop_mark,
                                           match_storage_mark,
                                           arm);
                let arm_node = mir_profile_malloc(24);
                if (arm_node != null) {
                    memset(arm_node, 0, 24);
                    // Nested control flow may have moved the continuation off
                    // the body's entry block; record where the arm ends.
                    ast_write_i32(arm_node, self.current_block_id);
                    ast_write_rawptr(ptr_offset(arm_node, 8), self.drop_stack_snapshot());
                    ast_write_rawptr(ptr_offset(arm_node, 16), reached_arms);
                    reached_arms = arm_node;
                }
            }
            self.drop_stack_restore_activity(match_drop_state);
            dispatch_block = next_dispatch;
            arm = next_arm;
        }

        // Compensation pass: every reaching arm is still an open block here,
        // so each one can drop the locals a sibling arm moved away before any
        // of them hands control to the exit block.
        var arm_iter = reached_arms;
        while (arm_iter != null) {
            let arm_body_block = ast_read_i32(arm_iter);
            self.set_current_block(arm_body_block);
            self.drop_stack_restore_activity(ast_read_rawptr(ptr_offset(arm_iter, 8)));
            var sib = reached_arms;
            while (sib != null) {
                if (ast_read_i32(sib) != arm_body_block) {
                    self.emit_branch_compensation_drops(ast_read_rawptr(ptr_offset(sib, 8)), expr_id);
                }
                sib = ast_read_rawptr(ptr_offset(sib, 16));
            }
            ast_write_rawptr(ptr_offset(arm_iter, 8), self.drop_stack_snapshot());
            self.terminate_current_goto(exit_block);
            arm_iter = ast_read_rawptr(ptr_offset(arm_iter, 16));
        }

        // Falling through every case is the explicit non-exhaustive path.
        // Backends lower an empty match with no fallback to unreachable/panic.
        self.set_current_block(dispatch_block);
        self.drop_stack_head = match_drop_mark;
        self.defer_stack_head = match_defer_mark;
        self.storage_stack_head = match_storage_mark;
        self.terminate_current(mir_term_match(),
                               subject_value,
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_id_invalid(),
                               expr_id);
        self.set_current_block(exit_block);
        self.drop_stack_head = match_drop_mark;
        self.defer_stack_head = match_defer_mark;
        self.storage_stack_head = match_storage_mark;
        // Exit activity = AND over the reaching arms' post-compensation
        // states: a local moved in any arm was already dropped by every arm
        // that still owned it, so it must stay inactive here.
        var exit_cur = self.drop_stack_head;
        while (exit_cur != null) {
            let exit_local_id = ast_read_i32(exit_cur);
            var exit_merged = true;
            var exit_iter = reached_arms;
            while (exit_iter != null) {
                exit_merged = exit_merged
                    && self.drop_stack_snapshot_active(ast_read_rawptr(ptr_offset(exit_iter, 8)),
                                                       exit_local_id);
                exit_iter = ast_read_rawptr(ptr_offset(exit_iter, 16));
            }
            self.drop_stack_set_active(exit_local_id, exit_merged);
            exit_cur = ast_read_rawptr(ptr_offset(exit_cur, 8));
        }
        if (owned_subject_hir_local != hir_id_invalid()) {
            self.emit_drop_for_hir_local(owned_subject_hir_local,
                                         expr_id,
                                         subject_expr,
                                         true);
            self.drop_stack_head = subject_drop_outer_mark;
        }
        return self.add_read_value(result_place, expr_id);
    }

    public fn lower_stmt(self, stmt_id: i32) {
        if (stmt_id == hir_id_invalid() || self.current_block_terminated()) { return; }
        let k = self.h.stmt_kind(stmt_id);
        if (k == hir_stmt_expr()) {
            let expr_id = self.h.stmt_expr(stmt_id);
            if (expr_id != hir_id_invalid() && self.h.expr_kind(expr_id) == ex_FAIL()) {
                let return_type = self.h.function_return_type(self.current_hir_function_id);
                let ret_value = self.lower_expr_as(expr_id, return_type);
                self.deactivate_moved_source_expr_except(expr_id, hir_id_invalid());
                let materialized_ret = self.materialize_return_value(ret_value, return_type, stmt_id, expr_id);
                self.emit_function_exit(stmt_id);
                self.terminate_current(mir_term_return(), materialized_ret, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), stmt_id);
                return;
            }
            let expr_id2 = self.h.stmt_expr(stmt_id);
            let v = self.lower_expr(expr_id2);
            // A direct assignment emits its store during lower_expr and must
            // not be evaluated again. A void assignment overload, however,
            // has no result store to force evaluation: its call is the only
            // effect (for example Instance.rebindRaw). Keep that call as an
            // Eval instruction exactly once.
            if (self.h.expr_kind(expr_id2) != ex_ASSIGN()) {
                self.emit_eval_value(v, stmt_id, expr_id2);
            } else if (self.h.expr_target_kind(expr_id2) == hir_target_function()
                       && hir_type_table_kind(self.h.types, self.h.expr_type(expr_id2)) == ty_VOID()) {
                self.emit_eval_value(v, stmt_id, expr_id2);
            }
            return;
        }
        if (k == hir_stmt_let() || k == hir_stmt_var()) {
            let init_value = self.lower_expr_as(self.h.stmt_expr(stmt_id), self.h.stmt_type(stmt_id));
            let local_place = mir_i32_map_get(self.place_map, self.h.stmt_local(stmt_id));
            self.unit.add_instr(
                               self.current_function_id,
                               self.current_block_id,
                               mir_instr_storage_live(),
                               self.h.stmt_type(stmt_id),
                               local_place,
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_id_invalid(),
                               mir_target_none(),
                               mir_id_invalid(),
                               stmt_id,
                               self.h.stmt_expr(stmt_id),
                               0,
                               self.h.stmt_local(stmt_id),
                               self.h.stmt_name(stmt_id));
            self.drop_stack_push(self.h.stmt_local(stmt_id));
            self.storage_stack_push(self.h.stmt_local(stmt_id));
            self.emit_assign(local_place, init_value, stmt_id, self.h.stmt_expr(stmt_id));
            self.deactivate_moved_source_expr_except(self.h.stmt_expr(stmt_id), self.h.stmt_local(stmt_id));
            return;
        }
        if (k == hir_stmt_return()) {
            let return_type = self.h.function_return_type(self.current_hir_function_id);
            var ret_value = mir_id_invalid();
            if (self.return_expr_needs_awaitable_ready(return_type, self.h.stmt_expr(stmt_id))) {
                ret_value = self.lower_awaitable_ready_return(self.h.stmt_expr(stmt_id), return_type);
            } else {
                ret_value = self.lower_expr_as(self.h.stmt_expr(stmt_id), return_type);
            }
            self.deactivate_moved_source_expr_except(self.h.stmt_expr(stmt_id), hir_id_invalid());
            ret_value = self.materialize_return_value(ret_value, return_type, stmt_id, self.h.stmt_expr(stmt_id));
            self.emit_function_exit(stmt_id);
            self.terminate_current(mir_term_return(), ret_value, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), stmt_id);
            return;
        }
        if (k == hir_stmt_block()) {
            let saved_drop_stack = self.drop_stack_head;
            let saved_defer_stack = self.defer_stack_head;
            let saved_storage_stack = self.storage_stack_head;
            let saved_unsafe_depth = self.unsafe_depth;
            if (self.h.stmt_aux(stmt_id) == stmt_flag_unsafe_block()) {
                self.unsafe_depth = self.unsafe_depth + 1;
            }
            self.lower_stmt_chain(self.h.stmt_child(stmt_id));
            if (self.h.stmt_aux(stmt_id) == stmt_flag_unsafe_block()) {
                self.unsafe_depth = saved_unsafe_depth;
            }
            if (!self.current_block_terminated()) {
                self.emit_scope_exit_until(saved_defer_stack,
                                           saved_drop_stack,
                                           saved_storage_stack,
                                           stmt_id);
            } else {
                self.drop_stack_head = saved_drop_stack;
                self.defer_stack_head = saved_defer_stack;
                self.storage_stack_head = saved_storage_stack;
            }
            return;
        }
        if (k == hir_stmt_if()) {
            if (self.try_lower_static_if_stmt(stmt_id)) { return; }
            self.lower_if_stmt(stmt_id);
            return;
        }
        if (k == hir_stmt_while()) {
            self.lower_while_stmt(stmt_id);
            return;
        }
        if (k == hir_stmt_for()) {
            self.lower_for_stmt(stmt_id);
            return;
        }
        if (k == hir_stmt_foreach()) {
            self.lower_foreach_stmt(stmt_id);
            return;
        }
        if (k == hir_stmt_match()) {
            self.lower_match_stmt(stmt_id);
            return;
        }
        if (k == hir_stmt_break()) {
            var target = self.break_target_block_id;
            var drop_mark = self.break_drop_mark;
            var defer_mark = self.break_defer_mark;
            var storage_mark = self.break_storage_mark;
            let name = self.h.stmt_name(stmt_id);
            if (name.len > 0) {
                let frame = self.find_labeled_loop(name);
                if (frame != null) {
                    target = ast_read_i32(ptr_offset(frame, 16));
                    drop_mark = ast_read_rawptr(ptr_offset(frame, 24));
                    defer_mark = ast_read_rawptr(ptr_offset(frame, 40));
                    storage_mark = ast_read_rawptr(ptr_offset(frame, 56));
                }
            }
            if (target != mir_id_invalid()) {
                self.emit_scope_exit_until(defer_mark, drop_mark, storage_mark, stmt_id);
                self.terminate_current_goto(target);
            }
            else { self.terminate_current(mir_term_unreachable(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), stmt_id); }
            return;
        }
        if (k == hir_stmt_continue()) {
            var target = self.continue_target_block_id;
            var drop_mark = self.continue_drop_mark;
            var defer_mark = self.continue_defer_mark;
            var storage_mark = self.continue_storage_mark;
            let name = self.h.stmt_name(stmt_id);
            if (name.len > 0) {
                let frame = self.find_labeled_loop(name);
                if (frame != null) {
                    target = ast_read_i32(ptr_offset(frame, 20));
                    drop_mark = ast_read_rawptr(ptr_offset(frame, 32));
                    defer_mark = ast_read_rawptr(ptr_offset(frame, 48));
                    storage_mark = ast_read_rawptr(ptr_offset(frame, 64));
                }
            }
            if (target != mir_id_invalid()) {
                self.emit_scope_exit_until(defer_mark, drop_mark, storage_mark, stmt_id);
                self.terminate_current_goto(target);
            }
            else { self.terminate_current(mir_term_unreachable(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), stmt_id); }
            return;
        }
        if (k == hir_stmt_defer()) {
            self.defer_stack_push(stmt_id);
            return;
        }
        if (k == hir_stmt_static_assert()) {
            let cond = self.lower_expr(self.h.stmt_cond(stmt_id));
            self.unit.add_instr( self.current_function_id, self.current_block_id, mir_instr_static_assert(),
                               self.h.stmt_type(stmt_id), mir_id_invalid(), cond, mir_id_invalid(), mir_id_invalid(),
                               mir_target_none(), mir_id_invalid(), stmt_id, self.h.stmt_cond(stmt_id), 0, 0, self.h.stmt_name(stmt_id));
            return;
        }
    }

    public fn mark_function_reachable(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        if (function_id <= 0 || function_id > self.unit.function_count) {
            return;
        }
        if (self.partition_codegen_roots
            && self.current_function_id != mir_id_invalid()
            && function_id != self.current_function_id
            && (self.unit.function_flags( function_id) & hir_function_flag_codegen_root()) != 0
            && !self.mir_function_is_emit_root(function_id)) {
            return;
        }
        if (self.function_is_reachable(function_id)) { return; }
        let node = mir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, function_id);
        ast_write_rawptr(ptr_offset(node, 8), null);
        if (self.reachable_function_queue_tail != null) {
            ast_write_rawptr(ptr_offset(self.reachable_function_queue_tail, 8), node);
        } else {
            self.reachable_function_queue_head = node;
        }
        self.reachable_function_queue_tail = node;
        mir_i32_map_put(self.reachable_function_map, function_id, 2);
    }

    // Call lowering normally records each direct callee immediately.  Keep a
    // shared MIR-level closure pass as the authoritative backstop, however:
    // synthesized HIR builder calls and function-value references may have a
    // target reference without having passed through that direct-call path.
    // Both streaming consumers invoke this while the exact body is live, so
    // LLVM and MIR2CPP obtain an identical reachable-function closure without
    // retaining any body records.
    public fn enqueue_live_function_target_dependencies(self,
                                                        first_value: i32,
                                                        last_value: i32) {
        var value_id = first_value;
        while (value_id <= last_value && value_id <= self.unit.value_count) {
            if (self.unit.value_target_kind(value_id) == mir_target_function()) {
                let target = self.unit.value_target_id(value_id);
                // Reachability is an edge property, not a prediction about
                // whether the target currently has a materialized HIR body.
                // `stream_function` decides whether it becomes a definition
                // or remains an extern/declaration after asking the HIR
                // builder.  Filtering here loses lazily materializable
                // method bodies (notably compiler-internal builder methods).
                if (target != mir_id_invalid()) { self.mark_function_reachable(target); }
            }
            value_id = value_id + 1;
        }
    }

    public fn mark_function_lowered(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        mir_i32_map_put(self.lowered_function_map, function_id, 2);
    }

    public fn reset_function_codegen_marks(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        mir_i32_map_put(self.lowered_function_map, function_id, 0);
        mir_i32_map_put(self.reachable_function_map, function_id, 0);
    }

    public fn drop_reachable_queue(self) {
        var fn_id = self.pop_reachable_function();
        while (fn_id != mir_id_invalid()) {
            mir_i32_map_put(self.reachable_function_map, fn_id, 0);
            fn_id = self.pop_reachable_function();
        }
    }

    // A lazy HIR codegen request is intentionally retryable: resolving one
    // concrete call can register the raw declaration for another closed
    // instance.  Do not reinsert it into the current DFS (that would spin on
    // a still-missing source); the next shared prepare round activates it
    // after HIR reflection and concrete-type facts have been refreshed.
    public fn defer_function_materialization_retry(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        if (function_id <= 0 || function_id > self.unit.function_count) { return; }
        if (self.function_is_lowered(function_id)) { return; }
        mir_i32_map_put(self.deferred_materialization_map, function_id, 1);
    }

    public fn activate_deferred_function_materializations(self) {
        var function_id: i32 = 1;
        while (function_id <= self.unit.function_count) {
            if (mir_i32_map_get(self.deferred_materialization_map, function_id) == 1) {
                mir_i32_map_put(self.deferred_materialization_map, function_id, 0);
                // The original queue node was consumed before the failed
                // materialization.  Clear its reachability mark so the normal
                // queue insertion API owns the retry as well.
                mir_i32_map_put(self.reachable_function_map, function_id, 0);
                self.mark_function_reachable(function_id);
            }
            function_id = function_id + 1;
        }
    }

    public fn report_unresolved_deferred_function_materializations(self) -> i32 {
        var errors: i32 = 0;
        var function_id: i32 = 1;
        while (function_id <= self.unit.function_count) {
            if (mir_i32_map_get(self.deferred_materialization_map, function_id) == 1) {
                let hir_fn = self.unit.function_hir_id(function_id);
                self.report_error_at_hir_function(
                    hir_fn,
                    "reachable function body was still unavailable after streaming deferred retries: "
                    + self.unit.function_name(function_id));
                mir_i32_map_put(self.deferred_materialization_map, function_id, 2);
                errors = errors + 1;
            }
            function_id = function_id + 1;
        }
        return errors;
    }

    public fn pending_deferred_materializations(self) -> i32 {
        var pending: i32 = 0;
        var function_id: i32 = 1;
        while (function_id <= self.unit.function_count) {
            if (mir_i32_map_get(self.deferred_materialization_map, function_id) == 1) {
                pending = pending + 1;
            }
            function_id = function_id + 1;
        }
        return pending;
    }

    public fn function_is_reachable(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (function_id <= 0 || function_id > self.unit.function_count) { return false; }
        return mir_i32_map_get(self.reachable_function_map, function_id) == 2;
    }

    public fn function_is_lowered(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (function_id <= 0 || function_id > self.unit.function_count) { return false; }
        return mir_i32_map_get(self.lowered_function_map, function_id) == 2;
    }

    public fn pop_reachable_function(self) -> i32 {
        let node = self.reachable_function_queue_head;
        if (node == null) { return mir_id_invalid(); }
        let function_id = ast_read_i32(node);
        let next = ast_read_rawptr(ptr_offset(node, 8));
        self.reachable_function_queue_head = next;
        if (next == null) { self.reachable_function_queue_tail = null; }
        free(node);
        return function_id;
    }

    public fn suspend_reachable_function_queue(self) -> rawptr {
        let head = self.reachable_function_queue_head;
        var node = head;
        while (node != null) {
            let function_id = ast_read_i32(node);
            if (!self.function_is_lowered(function_id)) {
                mir_i32_map_put(self.reachable_function_map, function_id, 0);
            }
            node = ast_read_rawptr(ptr_offset(node, 8));
        }
        self.reachable_function_queue_head = null;
        self.reachable_function_queue_tail = null;
        return head;
    }

    public fn restore_reachable_function_queue(self, head: rawptr) {
        if (head == null) { return; }
        var tail = head;
        var node = head;
        while (node != null) {
            let function_id = ast_read_i32(node);
            if (!self.function_is_lowered(function_id)) {
                mir_i32_map_put(self.reachable_function_map, function_id, 2);
            }
            tail = node;
            node = ast_read_rawptr(ptr_offset(node, 8));
        }
        if (self.reachable_function_queue_tail != null) {
            ast_write_rawptr(ptr_offset(self.reachable_function_queue_tail, 8), head);
        } else {
            self.reachable_function_queue_head = head;
        }
        self.reachable_function_queue_tail = tail;
    }

    public fn hir_function_is_codegen_root(self, hir_fn: i32) -> bool {
        if (hir_fn == hir_id_invalid()) { return false; }
        if (self.hir_function_has_open_template_types(hir_fn)) { return false; }
        let fn_flags = hir_unit_function_flags(self.h, hir_fn);
        if ((fn_flags & hir_function_flag_foreign_cpp_override_method()) != 0) {
            let owner_type = self.owner_type_text_for_hir_function(hir_fn);
            let name = self.h.function_name(hir_fn);
            if (name != "constructor" && name != "drop"
                && self.hir_type_text_is_dci_stub_class(owner_type)) {
                // Native DCI stubs call this symbol from C++ and therefore it
                // has no MIR call edge from `main`. Keep it as an external
                // codegen root even when project export is partitioned.
                return true;
            }
        }
        if ((fn_flags & hir_function_flag_codegen_root()) != 0) {
            return true;
        }
        let item_id = self.h.function_item(hir_fn);
        if (item_id == hir_id_invalid()) { return false; }
        if (self.h.item_kind(item_id) == hir_item_function()
            && self.h.item_owner(item_id) == hir_id_invalid()
            && self.h.function_name(hir_fn) == "main") {
            return true;
        }
        return false;
    }

    public fn emit_root_name_allowed(self, name: string) -> bool {
        if (!self.emit_root_names_specified) { return true; }
        if (name.len == 0) { return false; }
        return mir_builder_string_contains("|" + self.emit_root_names + "|", "|" + name + "|");
    }

    public fn emit_root_generic_args_match(self, root_args: string, fn_args: string) -> bool {
        if (root_args.len == 0 || fn_args.len == 0) { return false; }
        var idx: i32 = 0;
        while (idx < 64) {
            let root_arg = policy_generic_arg_at(root_args, idx);
            let fn_arg = policy_generic_arg_at(fn_args, idx);
            if (root_arg.len == 0 || fn_arg.len == 0) {
                return root_arg.len == 0 && fn_arg.len == 0;
            }
            if (root_arg != fn_arg && !policy_type_name_equal(root_arg, fn_arg)) {
                return false;
            }
            idx = idx + 1;
        }
        return false;
    }

    public fn emit_root_generic_instance_allowed(self, hir_fn: i32) -> bool {
        if (!self.emit_root_names_specified) { return true; }
        if (hir_fn == hir_id_invalid()) { return false; }
        let fn_args = hir_unit_function_generic_args(self.h, hir_fn);
        if (fn_args.len == 0) { return false; }
        let fn_name = self.h.function_name(hir_fn);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.emit_root_names.len) {
            if (i == self.emit_root_names.len || self.emit_root_names.charAt(i) == 124) {
                let root_name = self.emit_root_names.substring(start, i);
                let root_args = policy_generic_call_args(root_name.clone());
                if (root_args.len > 0 && self.emit_root_generic_args_match(root_args, fn_args)) {
                    let base = policy_generic_call_base(root_name.clone());
                    let mangled_base = policy_mangle_part(base);
                    if (base.len > 0
                        && (mir_builder_string_contains(fn_name, base)
                            || mir_builder_string_contains(fn_name, mangled_base))) {
                        return true;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn hir_function_is_emit_root(self, hir_fn: i32) -> bool {
        if (!self.hir_function_is_codegen_root(hir_fn)) { return false; }
        if (!self.emit_root_names_specified) { return true; }
        let fn_flags = hir_unit_function_flags(self.h, hir_fn);
        if ((fn_flags & hir_function_flag_reflection_root()) != 0
            && (fn_flags & hir_function_flag_reflection_named_root()) == 0
            && self.emit_partition_owns_reflection_roots()) {
            return true;
        }
        if (self.emit_root_name_allowed(self.h.function_name(hir_fn))) { return true; }
        return self.emit_root_generic_instance_allowed(hir_fn);
    }

    public fn reflection_partition_anchor_name(self) -> string {
        var fallback = "";
        var hir_fn: i32 = 1;
        while (hir_fn <= self.h.function_count) {
            let item_id = self.h.function_item(hir_fn);
            if (item_id != hir_id_invalid()
                && self.h.item_kind(item_id) == hir_item_function()
                && self.h.item_owner(item_id) == hir_id_invalid()
                && !self.hir_function_has_open_template_types(hir_fn)) {
                let name = self.h.function_name(hir_fn);
                if (name == "main") { return name; }
                if (fallback.len == 0
                    && (hir_unit_function_flags(self.h, hir_fn)
                        & hir_function_flag_codegen_root()) != 0) {
                    fallback = name;
                }
            }
            hir_fn = hir_fn + 1;
        }
        return fallback;
    }

    public fn emit_partition_owns_reflection_roots(self) -> bool {
        if (!self.emit_root_names_specified) { return true; }
        let anchor = self.reflection_partition_anchor_name();
        if (anchor.len == 0) { return false; }
        return self.emit_root_name_allowed(anchor);
    }

    public fn mir_function_is_emit_root(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        let hir_fn = self.unit.function_hir_id(function_id);
        if (hir_fn != hir_id_invalid()) {
            return self.hir_function_is_emit_root(hir_fn);
        }
        if (!self.emit_root_names_specified) { return true; }
        return self.emit_root_name_allowed(self.unit.function_name(function_id));
    }

    public fn function_is_partition_external_root(self, function_id: i32) -> bool {
        if (!self.partition_codegen_roots) { return false; }
        if (function_id == mir_id_invalid()) { return false; }
        if (self.mir_function_is_emit_root(function_id)) { return false; }
        let hir_fn = self.unit.function_hir_id(function_id);
        if (hir_fn == hir_id_invalid()) { return false; }
        return self.hir_function_is_codegen_root(hir_fn);
    }

    public fn hir_function_is_partition_declaration_only(self, hir_fn: i32) -> bool {
        if (!self.partition_codegen_roots) { return false; }
        if (hir_fn == hir_id_invalid()) { return false; }
        if (self.hir_function_is_emit_root(hir_fn)) { return false; }
        let item_id = self.h.function_item(hir_fn);
        if (item_id != hir_id_invalid()
            && self.h.item_kind(item_id) == hir_item_extern_function()) {
            return true;
        }
        return (hir_unit_function_flags(self.h, hir_fn) & hir_function_flag_declaration_only()) != 0;
    }

    public fn function_is_partition_declaration_only(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return self.hir_function_is_partition_declaration_only(self.unit.function_hir_id(function_id));
    }

    public fn hir_function_is_interface_method(self, hir_fn: i32) -> bool {
        if (hir_fn == hir_id_invalid()) { return false; }
        let item_id = self.h.function_item(hir_fn);
        if (item_id == hir_id_invalid()) { return false; }
        let owner_item = self.h.item_owner(item_id);
        return owner_item != hir_id_invalid()
            && self.h.item_kind(owner_item) == hir_item_interface();
    }

    public fn build_function_table(self) {
        var hir_fn: i32 = self.function_table_scan_next;
        if (hir_fn < 1) { hir_fn = 1; }
        while (hir_fn <= self.h.function_count) {
            if (self.hir_function_is_codegen_root(hir_fn)) {
                let mir_fn = self.ensure_function_shell_for_hir_quiet(hir_fn);
                if (self.hir_function_is_emit_root(hir_fn)) {
                    self.mark_function_reachable(mir_fn);
                }
            } else if (self.hir_function_is_interface_method(hir_fn)
                       && !self.hir_function_has_open_template_types(hir_fn)) {
                // A dyn vtable describes the complete interface contract,
                // including inherited methods, not the methods called by
                // this partition. A DLL that only calls `dup` must compute
                // the same slots as the EXE that constructs the dyn value.
                // Keep closed interface signatures in every MIR unit. Quiet
                // shells do not retain default/implementation bodies or add
                // reachability edges; those still follow ordinary DCE.
                self.ensure_function_shell_for_hir_quiet(hir_fn);
            } else if ((hir_unit_function_flags(self.h, hir_fn) & hir_function_flag_imported_body()) != 0
                       && !self.hir_function_has_open_template_types(hir_fn)) {
                // Imported .vyi declarations have no body in this partition,
                // but a later materialized local body may call any of them.
                // Keep a MIR shell so that call edges retain the imported
                // symbol/ABI and LLVM can emit an external declaration.
                self.ensure_function_shell_for_hir_quiet(hir_fn);
            } else if (!self.partition_codegen_roots
                       && self.h.item_kind(self.h.function_item(hir_fn)) == hir_item_method()
                       && !self.hir_function_has_open_template_types(hir_fn)) {
                self.ensure_function_shell_for_hir_quiet(hir_fn);
            }
            hir_fn = hir_fn + 1;
        }
        self.function_table_scan_next = self.h.function_count + 1;
    }

    public fn ensure_function_shell_for_hir(self, hir_fn: i32) -> i32 {
        let mir_fn = self.ensure_function_shell_for_hir_quiet(hir_fn);
        if (mir_fn != mir_id_invalid()) {
            var should_mark = true;
            if (self.partition_codegen_roots
                && ((self.hir_function_is_codegen_root(hir_fn)
                     && !self.hir_function_is_emit_root(hir_fn))
                    || self.hir_function_is_partition_declaration_only(hir_fn))) {
                should_mark = false;
            }
            if (should_mark) {
                self.mark_function_reachable(mir_fn);
            }
        }
        return mir_fn;
    }

    public fn ensure_function_shell_for_hir_quiet(self, hir_fn: i32) -> i32 {
        if (hir_fn == hir_id_invalid()) { return mir_id_invalid(); }
        if (hir_fn < 1 || hir_fn > self.h.function_count) { return mir_id_invalid(); }
        let existing = mir_i32_map_get(self.function_map, hir_fn);
        if (existing != mir_id_invalid()) {
            return existing;
        }
        if (self.hir_function_has_open_template_types(hir_fn)) { return mir_id_invalid(); }
        let owner_type_text = self.owner_type_text_for_hir_function(hir_fn);
        let mir_fn = self.unit.add_function(
                                           hir_fn,
                                           self.h.function_item(hir_fn),
                                           self.h.function_name(hir_fn),
                                           self.h.function_return_type(hir_fn));
        if (mir_fn == mir_id_invalid()) { return mir_id_invalid(); }
        g_mir_streaming_new_shells = g_mir_streaming_new_shells + 1;
        self.unit.set_function_generic_env(
                                          mir_fn,
                                          hir_unit_function_generic_params(self.h, hir_fn),
                                          hir_unit_function_generic_args(self.h, hir_fn),
                                          owner_type_text);
        self.unit.set_function_symbol_discriminator(
            mir_fn,
            hir_unit_function_symbol_discriminator(self.h, hir_fn));
        self.unit.set_function_item_kind(
                                        mir_fn,
                                        self.h.item_kind(self.h.function_item(hir_fn)));
        self.unit.set_function_flags(
                                    mir_fn,
                                    hir_unit_function_flags(self.h, hir_fn));
        let owner_item = self.h.item_owner(self.h.function_item(hir_fn));
        if (owner_item != hir_id_invalid()) {
            self.unit.set_function_owner_item_kind(
                                                 mir_fn,
                                                 self.h.item_kind(owner_item));
        }
        mir_i32_map_put(self.function_map, hir_fn, mir_fn);
        self.copy_signature_locals_for_bodyless_function(hir_fn, mir_fn);
        return mir_fn;
    }

    public fn field_index_in_owner(self, field_item_id: i32, owner_item_id: i32) -> i32 {
        var index: i32 = 0;
        var item_id: i32 = 1;
        while (item_id < field_item_id) {
            if (self.h.item_kind(item_id) == hir_item_field()
                && self.h.item_owner(item_id) == owner_item_id) {
                index = index + 1;
            }
            item_id = item_id + 1;
        }
        return index;
    }

    public fn variant_index_in_owner(self, variant_item_id: i32, owner_item_id: i32) -> i32 {
        var index: i32 = 0;
        var item_id: i32 = 1;
        while (item_id < variant_item_id) {
            if (self.h.item_kind(item_id) == hir_item_variant()
                && self.h.item_owner(item_id) == owner_item_id) {
                index = index + 1;
            }
            item_id = item_id + 1;
        }
        return index;
    }

    public fn type_id_for_item(self, item_id: i32) -> i32 {
        let direct = self.h.item_type(item_id);
        if (direct != hir_id_invalid()) { return direct; }
        let name = self.h.item_name(item_id);
        if (name.len == 0) { return hir_id_invalid(); }
        return self.type_id_by_text(name);
    }

    public fn reset_layout_indexes_for_current_hir(self) {
        self.layout_type_index = mir_name_id_map_dispose(self.layout_type_index);
        var layout_type_cap: i32 = self.h.types.count;
        layout_type_cap = layout_type_cap + 1;
        self.layout_type_id_map = mir_i32_map_clear_for_count(self.layout_type_id_map, layout_type_cap);
        self.layout_materialized_type_id_map = mir_i32_map_clear_for_count(self.layout_materialized_type_id_map, layout_type_cap);
        self.layout_owner_type_item_map = mir_i32_map_clear_for_count(self.layout_owner_type_item_map, layout_type_cap);
        self.field_owner_first_map = mir_i32_map_clear_for_count(self.field_owner_first_map, self.h.item_count + 1);
        self.field_owner_next_map = mir_i32_map_clear_for_count(self.field_owner_next_map, self.h.item_count + 1);
        self.variant_owner_first_map = mir_i32_map_clear_for_count(self.variant_owner_first_map, self.h.item_count + 1);
        self.variant_owner_next_map = mir_i32_map_clear_for_count(self.variant_owner_next_map, self.h.item_count + 1);
        self.field_owner_done_map = mir_i32_map_clear_for_count(self.field_owner_done_map, self.h.item_count + 1);
        self.variant_owner_done_map = mir_i32_map_clear_for_count(self.variant_owner_done_map, self.h.item_count + 1);
        self.layout_item_count = self.h.item_count;
        self.layout_owner_item_count = 0;
    }

    public fn owner_item_has_layout_member(self, owner_item: i32) -> bool {
        if (owner_item == hir_id_invalid()) { return false; }
        var member = self.h.item_first_member(owner_item);
        var guard: i32 = 0;
        while (member != hir_id_invalid() && guard <= self.h.item_count) {
            let member_kind = self.h.item_kind(member);
            if (member_kind == hir_item_field() || member_kind == hir_item_variant()) { return true; }
            member = self.h.item_next_sibling(member);
            guard = guard + 1;
        }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_owner(item_id) == owner_item) {
                let item_kind = self.h.item_kind(item_id);
                if (item_kind == hir_item_field() || item_kind == hir_item_variant()) { return true; }
            }
            item_id = item_id + 1;
        }
        return false;
    }

    public fn string_abi_member_call_is_builtin(self, callee_expr_id: i32) -> bool {
        if (callee_expr_id == hir_id_invalid()
            || self.h.expr_kind(callee_expr_id) != ex_MEMBER()) { return false; }
        var name = self.h.expr_name(callee_expr_id);
        if (name.len == 0) { name = self.h.expr_value_text(callee_expr_id); }
        let builtin_name = name == "c_str" || name == "ptr" || name == "data"
            || name == "len" || name == "length" || name == "size" || name == "count"
            || name == "clone" || name == "repeat"
            || name == "find" || name == "indexOf" || name == "index_of"
            || name == "equals" || name == "contains"
            || name == "startsWith" || name == "starts_with"
            || name == "endsWith" || name == "ends_with"
            || name == "isEmpty" || name == "is_empty"
            || name == "substr" || name == "substring"
            || name == "charAt" || name == "char_at"
            || name == "charCodeAt" || name == "char_code_at" || name == "byteAt"
            || name == "trim" || name == "replace"
            || name == "toUpper" || name == "to_upper"
            || name == "toLower" || name == "to_lower";
        if (!builtin_name) { return false; }
        let receiver = self.h.expr_lhs(callee_expr_id);
        if (receiver == hir_id_invalid()) { return false; }
        return self.type_text_is_string_abi(self.type_text(self.h.expr_type(receiver)));
    }

    public fn owner_item_layout_member_count(self, owner_item: i32) -> i32 {
        if (owner_item == hir_id_invalid()) { return 0; }
        var count: i32 = 0;
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            if (self.h.item_owner(item_id) == owner_item) {
                let kind = self.h.item_kind(item_id);
                if (kind == hir_item_field() || kind == hir_item_variant()) {
                    count = count + 1;
                }
            }
            item_id = item_id + 1;
        }
        return count;
    }

    public fn ensure_layout_owner_type_index(self) {
        if (self.layout_owner_item_count == self.h.item_count) { return; }
        var layout_type_cap: i32 = self.h.types.count;
        layout_type_cap = layout_type_cap + 1;
        self.layout_owner_type_item_map = mir_i32_map_clear_for_count(self.layout_owner_type_item_map, layout_type_cap);
        self.field_owner_first_map = mir_i32_map_clear_for_count(self.field_owner_first_map, self.h.item_count + 1);
        self.field_owner_next_map = mir_i32_map_clear_for_count(self.field_owner_next_map, self.h.item_count + 1);
        self.variant_owner_first_map = mir_i32_map_clear_for_count(self.variant_owner_first_map, self.h.item_count + 1);
        self.variant_owner_next_map = mir_i32_map_clear_for_count(self.variant_owner_next_map, self.h.item_count + 1);
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            let kind = self.h.item_kind(item_id);
            if (kind == hir_item_class()
                || kind == hir_item_enum()
                || kind == hir_item_interface()) {
                let type_id = self.type_id_for_item(item_id);
                if (type_id != hir_id_invalid()) {
                    let existing_owner = mir_i32_map_get(self.layout_owner_type_item_map, type_id);
                    if (existing_owner == hir_id_invalid()
                        || self.owner_item_layout_member_count(item_id)
                            > self.owner_item_layout_member_count(existing_owner)) {
                        mir_i32_map_put(self.layout_owner_type_item_map, type_id, item_id);
                    }
                }
            } else if (kind == hir_item_field()) {
                let owner_item = self.h.item_owner(item_id);
                if (owner_item != hir_id_invalid()) {
                    let prev = mir_i32_map_get(self.field_owner_first_map, owner_item);
                    mir_i32_map_put(self.field_owner_next_map, item_id, prev);
                    mir_i32_map_put(self.field_owner_first_map, owner_item, item_id);
                }
            } else if (kind == hir_item_variant()) {
                let owner_variant_item = self.h.item_owner(item_id);
                if (owner_variant_item != hir_id_invalid()) {
                    let prev_variant = mir_i32_map_get(self.variant_owner_first_map, owner_variant_item);
                    mir_i32_map_put(self.variant_owner_next_map, item_id, prev_variant);
                    mir_i32_map_put(self.variant_owner_first_map, owner_variant_item, item_id);
                }
            }
            item_id = item_id + 1;
        }
        self.layout_owner_item_count = self.h.item_count;
    }

    public fn owner_item_for_layout_type(self, type_id: i32) -> i32 {
        if (type_id == hir_id_invalid()) { return hir_id_invalid(); }
        self.ensure_layout_owner_type_index();
        return mir_i32_map_get(self.layout_owner_type_item_map, type_id);
    }

    public fn first_field_item_for_owner(self, owner_item: i32) -> i32 {
        if (owner_item == hir_id_invalid()) { return hir_id_invalid(); }
        self.ensure_layout_owner_type_index();
        return mir_i32_map_get(self.field_owner_first_map, owner_item);
    }

    public fn next_field_item(self, item_id: i32) -> i32 {
        if (item_id == hir_id_invalid()) { return hir_id_invalid(); }
        return mir_i32_map_get(self.field_owner_next_map, item_id);
    }

    public fn first_variant_item_for_owner(self, owner_item: i32) -> i32 {
        if (owner_item == hir_id_invalid()) { return hir_id_invalid(); }
        self.ensure_layout_owner_type_index();
        return mir_i32_map_get(self.variant_owner_first_map, owner_item);
    }

    public fn next_variant_item(self, item_id: i32) -> i32 {
        if (item_id == hir_id_invalid()) { return hir_id_invalid(); }
        return mir_i32_map_get(self.variant_owner_next_map, item_id);
    }

    public fn build_field_layouts(self) {
        var item_id: i32 = self.field_item_scan_next;
        if (item_id < 1) { item_id = 1; }
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_field()) {
                var field_exists = false;
                if (item_id <= self.unit.field_cap) {
                    let existing = self.unit.field_record(item_id);
                    field_exists = existing != null
                        && ast_read_i32(existing) == item_id
                        && ast_read_i32(ptr_offset(existing, 8)) != mir_id_invalid()
                        && ast_read_i32(ptr_offset(existing, 12)) != mir_id_invalid();
                }
                if (!field_exists) {
                    let owner_item = self.h.item_owner(item_id);
                    var field_index = self.h.item_field_index(item_id);
                    if (field_index < 0) {
                        field_index = self.field_index_in_owner(item_id, owner_item);
                    }
                    let owner_type = self.type_id_for_item(owner_item);
                    // Keep a valid record for every referenced HIR FieldId.
                    // Versioned class layouts can reuse a numeric field index
                    // while retaining distinct historical FieldIds; the
                    // type/index lookup may pick the latest record, but MIR
                    // verification and semantic targets still need both.
                    self.unit.add_field_layout(
                                              item_id,
                                              owner_item,
                                              owner_type,
                                              self.h.item_type(item_id),
                                              field_index,
                                              self.h.item_name(item_id));
                }
            }
            item_id = item_id + 1;
        }
        self.field_item_scan_next = self.h.item_count + 1;
    }

    public fn build_variant_layouts(self) {
        var item_id: i32 = self.variant_item_scan_next;
        if (item_id < 1) { item_id = 1; }
        while (item_id <= self.h.item_count) {
            if (self.h.item_kind(item_id) == hir_item_variant()) {
                var variant_exists = false;
                if (item_id <= self.unit.variant_cap) {
                    let existing = self.unit.variant_record(item_id);
                    variant_exists = existing != null && ast_read_i32(existing) == item_id;
                }
                if (!variant_exists) {
                    let owner_item = self.h.item_owner(item_id);
                    var tag = self.h.item_variant_tag(item_id);
                    if (tag < 0) {
                        tag = self.variant_index_in_owner(item_id, owner_item);
                    }
                    self.unit.add_variant_layout(
                                                item_id,
                                                owner_item,
                                                self.type_id_for_item(owner_item),
                                                tag,
                                                self.h.item_name(item_id),
                                                self.h.item_variant_payload_types(item_id),
                                                self.h.item_variant_payload_count(item_id));
                }
            }
            item_id = item_id + 1;
        }
        self.variant_item_scan_next = self.h.item_count + 1;
    }

    public fn ensure_field_layout_for_item(self, item_id: i32) -> i32 {
        if (item_id == hir_id_invalid()
            || item_id < 1
            || item_id > self.h.item_count
            || self.h.item_kind(item_id) != hir_item_field()) {
            return hir_id_invalid();
        }
        let owner_item = self.h.item_owner(item_id);
        let owner_type = self.type_id_for_item(owner_item);
        self.ensure_field_layout_for_owner_item(owner_item);
        var field_index = self.h.item_field_index(item_id);
        if (field_index < 0) {
            field_index = self.field_index_in_owner(item_id, owner_item);
        }
        var item_record_valid = false;
        if (item_id <= self.unit.field_cap) {
            let item_record = self.unit.field_record(item_id);
            item_record_valid = item_record != null
                && ast_read_i32(item_record) == item_id
                && self.unit.field_owner_type( item_id)
                    != mir_id_invalid()
                && self.unit.field_type( item_id)
                    != mir_id_invalid();
        }
        if (!item_record_valid) {
            self.unit.add_field_layout(
                                      item_id,
                                      owner_item,
                                      owner_type,
                                      self.h.item_type(item_id),
                                      field_index,
                                      self.h.item_name(item_id));
        }
        return item_id;
    }

    public fn ensure_field_layout_for_owner_item(self, owner_item: i32) {
        if (owner_item == hir_id_invalid()) { return; }
        if (mir_i32_map_get(self.field_owner_done_map, owner_item) == 2) { return; }
        mir_i32_map_put(self.field_owner_done_map, owner_item, 2);
        let owner_type = self.type_id_for_item(owner_item);
        var scan = self.first_field_item_for_owner(owner_item);
        while (scan != hir_id_invalid()) {
            var field_index = self.h.item_field_index(scan);
            if (field_index < 0) {
                field_index = self.field_index_in_owner(scan, owner_item);
            }
            self.ensure_layouts_for_type(self.h.item_type(scan));
            var scan_record_valid = false;
            if (scan <= self.unit.field_cap) {
                let scan_record = self.unit.field_record(scan);
                scan_record_valid = scan_record != null
                    && ast_read_i32(scan_record) == scan
                    && self.unit.field_owner_type( scan)
                        != mir_id_invalid()
                    && self.unit.field_type( scan)
                        != mir_id_invalid();
            }
            if (!scan_record_valid) {
                self.unit.add_field_layout(
                                          scan,
                                          owner_item,
                                          owner_type,
                                          self.h.item_type(scan),
                                          field_index,
                                          self.h.item_name(scan));
            }
            scan = self.next_field_item(scan);
        }
    }

    public fn ensure_variant_layout_for_item(self, item_id: i32) -> i32 {
        if (item_id == hir_id_invalid()
            || item_id < 1
            || item_id > self.h.item_count
            || self.h.item_kind(item_id) != hir_item_variant()) {
            return hir_id_invalid();
        }
        let owner_item = self.h.item_owner(item_id);
        self.ensure_variant_layout_for_owner_item(owner_item);
        var tag = self.h.item_variant_tag(item_id);
        if (tag < 0) {
            tag = self.variant_index_in_owner(item_id, owner_item);
        }
        return self.unit.variant_id_for_type_tag( self.type_id_for_item(owner_item), tag);
    }

    public fn ensure_variant_layout_for_owner_item(self, owner_item: i32) {
        if (owner_item == hir_id_invalid()) { return; }
        if (mir_i32_map_get(self.variant_owner_done_map, owner_item) == 2) { return; }
        mir_i32_map_put(self.variant_owner_done_map, owner_item, 2);
        let owner_type = self.type_id_for_item(owner_item);
        var scan = self.first_variant_item_for_owner(owner_item);
        while (scan != hir_id_invalid()) {
            var tag = self.h.item_variant_tag(scan);
            if (tag < 0) {
                tag = self.variant_index_in_owner(scan, owner_item);
            }
            if (self.unit.variant_id_for_type_tag( owner_type, tag) == mir_id_invalid()) {
                self.unit.add_variant_layout(
                                            scan,
                                            owner_item,
                                            owner_type,
                                            tag,
                                            self.h.item_name(scan),
                                            self.h.item_variant_payload_types(scan),
                                            self.h.item_variant_payload_count(scan));
            }
            scan = self.next_variant_item(scan);
        }
    }

    public fn ensure_layouts_for_existing_type_text_args(self, type_text: string) {
        if (type_text.len == 0 || policy_generic_call_has_args(type_text.clone()) == 0) { return; }
        let args = policy_generic_call_args(type_text.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let arg_text = policy_generic_arg_at(args.clone(), idx);
            if (arg_text.len == 0) { return; }
            let arg_type = self.type_id_by_text(arg_text);
            if (arg_type != hir_id_invalid()) {
                self.ensure_layouts_for_type(arg_type);
            }
            idx = idx + 1;
        }
    }

    public fn ensure_codegen_layout_type_materialized(self, type_id: i32) {
        if (!self.has_hir_codegen_builder || type_id == hir_id_invalid()) { return; }
        if (mir_i32_map_get(self.layout_materialized_type_id_map, type_id) == 2) { return; }
        let type_text = self.type_text(type_id);
        if (type_text.len == 0
            || hir_type_table_kind(self.h.types, type_id) != ty_CLASS()) {
            mir_i32_map_put(self.layout_materialized_type_id_map, type_id, 2);
            return;
        }
        if (self.type_id_has_open_template_atom(type_id)) {
            mir_i32_map_put(self.layout_materialized_type_id_map, type_id, 2);
            return;
        }
        let before_items = self.h.item_count;
        let before_types = self.h.types.count;
        let ok = hir_codegen_builder_handle_ensure_concrete_type_text_ready(self.hir_codegen_builder, type_text);
        if (!ok) { return; }
        mir_i32_map_put(self.layout_materialized_type_id_map, type_id, 2);
        self.refresh_from_codegen_builder();
        if (self.h.item_count != before_items || self.h.types.count != before_types) {
            self.reset_layout_indexes_for_current_hir();
        }
    }

    public fn type_needs_item_layout_scan(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        let kind = hir_type_table_kind(self.h.types, type_id);
        if (kind == ty_CLASS()) { return true; }
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            self.ensure_layouts_for_type(hir_type_table_elem(self.h.types, type_id));
            return false;
        }
        if (kind == ty_ARRAY()) {
            self.ensure_layouts_for_type(hir_type_table_elem(self.h.types, type_id));
            return false;
        }
        return false;
    }

    public fn ensure_layouts_for_type(self, type_id: i32) {
        if (type_id == hir_id_invalid()) { return; }
        self.ensure_codegen_layout_type_materialized(type_id);
        if (!self.type_needs_item_layout_scan(type_id)) { return; }
        if (self.layout_item_count != self.h.item_count) {
            self.reset_layout_indexes_for_current_hir();
        }
        let owner_item_direct = self.owner_item_for_layout_type(type_id);
        if (mir_i32_map_get(self.layout_type_id_map, type_id) == 2) {
            if (owner_item_direct == hir_id_invalid()) { return; }
            let has_field_members = self.first_field_item_for_owner(owner_item_direct) != hir_id_invalid();
            let has_variant_members = self.first_variant_item_for_owner(owner_item_direct) != hir_id_invalid();
            let fields_missing = has_field_members && self.unit.field_count_for_type( type_id) <= 0;
            let variants_missing = has_variant_members && self.unit.variant_count_for_type( type_id) <= 0;
            if (!fields_missing && !variants_missing) { return; }
        }
        mir_i32_map_put(self.layout_type_id_map, type_id, 2);
        self.ensure_layouts_for_existing_type_text_args(self.type_text(type_id));
        if (owner_item_direct != hir_id_invalid()) {
            self.ensure_field_layout_for_owner_item(owner_item_direct);
            self.ensure_variant_layout_for_owner_item(owner_item_direct);
            return;
        }
        let concrete_text = self.type_text(type_id);
        if (concrete_text.len == 0 || policy_generic_call_has_args(concrete_text.clone()) == 0) {
            return;
        }
        var item_id: i32 = 1;
        while (item_id <= self.h.item_count) {
            let kind = self.h.item_kind(item_id);
            if (kind == hir_item_field() || kind == hir_item_variant()) {
                let owner_item = self.h.item_owner(item_id);
                let owner_type = self.type_id_for_item(owner_item);
                if (owner_item != hir_id_invalid()
                    && self.type_uses_closed_template_layout(type_id, owner_type, owner_item)) {
                    if (kind == hir_item_field()) {
                        self.ensure_field_layout_for_item(item_id);
                    } else {
                        self.ensure_variant_layout_for_item(item_id);
                    }
                }
            }
            item_id = item_id + 1;
        }
    }

    fn reachable_queue_len(self) -> i32 {
        var count: i32 = 0;
        var cur = self.reachable_function_queue_head;
        while (cur != null) {
            count = count + 1;
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return count;
    }

    public fn build_function_body(self, hir_function_id: i32) {
        var temp_string_mark = vyx_rt_string_arena_checkpoint();
        let mir_fn = self.ensure_function_shell_for_hir(hir_function_id);
        if (mir_fn == mir_id_invalid()) {
            mir_builder_release_temp_strings(temp_string_mark);
            return;
        }
        if (self.function_is_lowered(mir_fn)) {
            mir_builder_release_temp_strings(temp_string_mark);
            return;
        }
        var materialized_here = false;
        var stmt_mark: i32 = 0;
        var expr_mark: i32 = 0;
        var local_mark: i32 = 0;
        if (self.has_hir_codegen_builder) {
            // Snapshot before any work.  Marks of 0 make
            // `function_owns_latest_body_range` treat the whole HIR stmt/expr
            // table as this function's tail; after streaming discard has
            // zeroed earlier records that is often vacuously true, and
            // cleanup then truncates `stmt_count` to 0.
            stmt_mark = self.h.stmt_count;
            expr_mark = self.h.expr_count;
            local_mark = self.h.local_count;
        }
        let timing_enabled = mir_builder_env_enabled("VYX_MIR_BODY_TIMING");
        var timing_total_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_materialize_ms: i64 = 0;
        var timing_places_ms: i64 = 0;
        var timing_drops_ms: i64 = 0;
        var timing_stmt_ms: i64 = 0;
        var timing_copy_locs_ms: i64 = 0;
        var timing_cleanup_ms: i64 = 0;
        if (timing_enabled) {
            timing_total_start = vyx_bootstrap_now_ms();
            timing_mark = timing_total_start;
        }
        if (!self.hir_function_has_executable_body(hir_function_id)) {
            if (self.has_hir_codegen_builder) {
                stmt_mark = self.h.stmt_count;
                expr_mark = self.h.expr_count;
                local_mark = self.h.local_count;
            }
            self.ensure_hir_function_body_for_codegen(hir_function_id, stmt_mark, expr_mark);
            if (timing_enabled) {
                let now_materialize = vyx_bootstrap_now_ms();
                timing_materialize_ms = timing_materialize_ms + (now_materialize - timing_mark);
                timing_mark = now_materialize;
            }
            if (self.has_hir_codegen_builder
                && self.hir_function_has_executable_body(hir_function_id)
                && self.h.function_body(hir_function_id) != hir_id_invalid()) {
                materialized_here = true;
            }
        }
        if (!self.hir_function_has_executable_body(hir_function_id)) {
            // A closed, non-foreign function that still advertises a
            // materializable body must not silently become an LLVM declaration.
            // Keep declaration-only/interface/extern contracts valid, but make
            // a lost generic reachability edge fail at its source.
            let hir_item = self.h.function_item(hir_function_id);
            let hir_flags = hir_unit_function_flags(self.h, hir_function_id);
            let declaration_contract = (hir_flags & hir_function_flag_declaration_only()) != 0
                || (hir_flags & hir_function_flag_foreign_dci()) != 0
                || (hir_item != hir_id_invalid()
                    && self.h.item_kind(hir_item) == hir_item_extern_function())
                || self.function_is_imported_callable_declaration(mir_fn);
            if (!declaration_contract
                && self.hir_function_can_materialize_executable_body(hir_function_id)) {
                // `HirUnitBuilder.materialize_function_body_for_codegen`
                // explicitly leaves missing provenance retryable.  Preserve
                // that contract for both LLVM and MIR2CPP: the next shared
                // prepare round may have registered the concrete source.
                self.defer_function_materialization_retry(mir_fn);
                self.cleanup_hir_codegen_scope(hir_function_id, stmt_mark, expr_mark, local_mark);
                mir_builder_release_temp_strings(temp_string_mark);
                return;
            }
            self.mark_function_lowered(mir_fn);
            self.cleanup_hir_codegen_scope(hir_function_id, stmt_mark, expr_mark, local_mark);
            mir_builder_release_temp_strings(temp_string_mark);
            return;
        }
        if (self.unit.function_first_block(mir_fn) != mir_id_invalid()) {
            self.mark_function_lowered(mir_fn);
            self.cleanup_hir_codegen_scope(hir_function_id, stmt_mark, expr_mark, local_mark);
            mir_builder_release_temp_strings(temp_string_mark);
            return;
        }
        let profile_level = vyx_bootstrap_profile_level();
        let trace_enabled = mir_builder_env_enabled("VYX_MIR_MEM_TRACE");
        let heap_buckets_enabled = mir_builder_env_enabled("VYX_MIR_HEAP_BUCKETS");
        if ((profile_level > 0 || trace_enabled)
            && (profile_level > 1 || mir_fn <= 24 || (mir_fn % 32) == 0 || mir_fn >= 850)) {
            print("[mir-build] before fn=" + mir_builder_i32_text(mir_fn)
                  + " hir=" + mir_builder_i32_text(hir_function_id)
                  + " name=" + self.unit.function_name(mir_fn)
                  + " funcs=" + mir_builder_i32_text(self.unit.function_count)
                  + " queue=" + mir_builder_i32_text(self.reachable_queue_len())
                  + " hitems=" + mir_builder_i32_text(self.h.item_count)
                  + " hfuncs=" + mir_builder_i32_text(self.h.function_count)
                  + " hstmts=" + mir_builder_i32_text(self.h.stmt_count)
                  + " hexprs=" + mir_builder_i32_text(self.h.expr_count)
                  + " str_active_mb=" + mir_builder_memory_mb_text(vyx_rt_string_arena_active_bytes())
                  + " str_reserved_mb=" + mir_builder_memory_mb_text(vyx_rt_string_arena_reserved_bytes())
                  + " astdup_mb=" + mir_builder_memory_mb_text(vyx_rt_ast_dup_bytes_total())
                  + " astnode_mb=" + mir_builder_memory_mb_text(vyx_rt_ast_node_bytes_total())
                  + " rawdup_live_mb=" + mir_builder_memory_mb_text(vyx_rt_raw_dup_bytes_live())
                  + " rawdup_total_mb=" + mir_builder_memory_mb_text(vyx_rt_raw_dup_bytes_total())
                  + " strlen_entries=" + policy_i64_to_string(vyx_rt_string_len_entry_count())
                  + " heap_mb=" + mir_builder_memory_mb_text(vyx_rt_heap_used_bytes())
                  + " private_mb=" + mir_builder_memory_mb_text(vyx_rt_process_private_bytes())
                  + " working_mb=" + mir_builder_memory_mb_text(vyx_rt_process_working_set_bytes())
                  + " peak_private_mb=" + mir_builder_memory_mb_text(vyx_rt_process_peak_private_bytes())
                  + " peak_working_mb=" + mir_builder_memory_mb_text(vyx_rt_process_peak_working_set_bytes()));
        }
        self.mark_function_lowered(mir_fn);
        self.current_function_id = mir_fn;
        self.current_hir_function_id = hir_function_id;
        self.async_await_index = 0;
        self.async_pc_place_id = mir_id_invalid();
        self.break_target_block_id = mir_id_invalid();
        self.continue_target_block_id = mir_id_invalid();
        self.break_drop_mark = null;
        self.continue_drop_mark = null;
        self.break_defer_mark = null;
        self.continue_defer_mark = null;
        self.break_storage_mark = null;
        self.continue_storage_mark = null;
        self.labeled_loop_head = null;
        self.drop_stack_head = null;
        self.defer_stack_head = null;
        self.storage_stack_head = null;
        let body = self.h.function_body(hir_function_id);
        if (body == hir_id_invalid()) {
            self.cleanup_hir_codegen_scope(hir_function_id, stmt_mark, expr_mark, local_mark);
            mir_builder_release_temp_strings(temp_string_mark);
            return;
        }
        mir_builder_release_temp_strings(temp_string_mark);
        temp_string_mark = vyx_rt_string_arena_checkpoint();
        let mir_block_mark = self.unit.block_count;
        let mir_local_mark = self.unit.local_count;
        let mir_value_mark = self.unit.value_count;
        let mir_instr_mark = self.unit.instr_count;
        self.lower_local_places_for_function(hir_function_id);
        if (timing_enabled) {
            let now_places = vyx_bootstrap_now_ms();
            timing_places_ms = now_places - timing_mark;
            timing_mark = now_places;
        }
        self.push_parameter_drops_for_function(hir_function_id);
        if (timing_enabled) {
            let now_drops = vyx_bootstrap_now_ms();
            timing_drops_ms = now_drops - timing_mark;
            timing_mark = now_drops;
        }
        var entry = self.unit.add_block( mir_fn, body);
        var dispatch_block = mir_id_invalid();
        var body_entry = entry;
        if ((self.unit.function_flags(mir_fn) & hir_function_flag_async_task()) != 0) {
            dispatch_block = entry;
            self.async_pc_place_id = self.add_temp_place(self.i32_type_id(), body, "__async_pc");
            body_entry = self.unit.add_block( mir_fn, body);
            entry = body_entry;
        }
        self.current_block_id = entry;
        if (!self.try_lower_implicit_function_return(body, self.h.function_return_type(hir_function_id))) {
            self.lower_stmt(body);
        }
        if (!self.current_block_terminated()) {
            let ret_text = self.type_text(self.h.function_return_type(hir_function_id));
            if (ret_text == "void") {
                self.emit_function_exit(body);
                self.terminate_current(mir_term_return(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), body);
            } else if (self.type_text_is_awaitable(ret_text)) {
                let ready_ret_value = self.lower_awaitable_ready_default_return(self.h.function_return_type(hir_function_id), body);
                self.emit_function_exit(body);
                if (ready_ret_value != mir_id_invalid()) {
                    self.terminate_current(mir_term_return(), ready_ret_value, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), body);
                } else {
                    self.terminate_current(mir_term_unreachable(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), body);
                }
            } else {
                // For constructors (class-pointer-ABI), emit an implicit return of self.
                var mir_ret_value = mir_id_invalid();
                if (self.return_type_is_constructor(hir_function_id, self.h.function_return_type(hir_function_id))) {
                    mir_ret_value = self.implicit_self_return_value(hir_function_id);
                }
                self.emit_function_exit(body);
                if (mir_ret_value != mir_id_invalid()) {
                    self.terminate_current(mir_term_return(), mir_ret_value, mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), body);
                } else {
                    self.terminate_current(mir_term_unreachable(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), mir_id_invalid(), body);
                }
            }
        }
        if (dispatch_block != mir_id_invalid()) {
            self.finish_async_dispatch(dispatch_block, body_entry);
        }
        if (timing_enabled) {
            let now_stmt = vyx_bootstrap_now_ms();
            timing_stmt_ms = now_stmt - timing_mark;
            timing_mark = now_stmt;
        }
        self.copy_value_source_locs_since(mir_value_mark);
        self.copy_instr_source_locs_since(mir_instr_mark);
        self.copy_block_source_locs_since(mir_block_mark);
        self.copy_local_source_locs_since(mir_local_mark, mir_fn, hir_function_id);
        if (timing_enabled) {
            let now_copy = vyx_bootstrap_now_ms();
            timing_copy_locs_ms = now_copy - timing_mark;
            timing_mark = now_copy;
        }
        self.cleanup_hir_codegen_scope(hir_function_id, stmt_mark, expr_mark, local_mark);
        if (timing_enabled) {
            let now_cleanup = vyx_bootstrap_now_ms();
            timing_cleanup_ms = now_cleanup - timing_mark;
            let timing_total = now_cleanup - timing_total_start;
            if (timing_total >= mir_builder_slow_body_threshold_ms()) {
                print("[mir-body-timing] fn=" + self.unit.function_name(mir_fn)
                      + " mir=" + mir_builder_i32_text(mir_fn)
                      + " hir=" + mir_builder_i32_text(hir_function_id)
                      + " total=" + policy_i64_to_string(timing_total)
                      + " materialize=" + policy_i64_to_string(timing_materialize_ms)
                      + " places=" + policy_i64_to_string(timing_places_ms)
                      + " drops=" + policy_i64_to_string(timing_drops_ms)
                      + " stmt=" + policy_i64_to_string(timing_stmt_ms)
                      + " copy_locs=" + policy_i64_to_string(timing_copy_locs_ms)
                      + " cleanup=" + policy_i64_to_string(timing_cleanup_ms)
                      + " values=" + mir_builder_i32_text(self.unit.value_count - mir_value_mark)
                      + " instrs=" + mir_builder_i32_text(self.unit.instr_count)
                      + " hstmts=" + mir_builder_i32_text(self.h.stmt_count)
                      + " hexprs=" + mir_builder_i32_text(self.h.expr_count));
            }
        }
        if ((profile_level > 0 || trace_enabled)
            && (profile_level > 1 || mir_fn <= 24 || (mir_fn % 32) == 0)) {
            print("[mir-build] lowered fn=" + mir_builder_i32_text(mir_fn)
                  + " hir=" + mir_builder_i32_text(hir_function_id)
                  + " name=" + self.unit.function_name(mir_fn)
                  + " funcs=" + mir_builder_i32_text(self.unit.function_count)
                  + " queue=" + mir_builder_i32_text(self.reachable_queue_len())
                  + " blocks=" + mir_builder_i32_text(self.unit.block_count)
                  + " locals=" + mir_builder_i32_text(self.unit.local_count)
                  + " fields=" + mir_builder_i32_text(self.unit.field_count)
                  + " variants=" + mir_builder_i32_text(self.unit.variant_count)
                  + " statics=" + mir_builder_i32_text(self.unit.static_count)
                  + " places=" + mir_builder_i32_text(self.unit.place_count)
                  + " values=" + mir_builder_i32_text(self.unit.value_count)
                  + " instrs=" + mir_builder_i32_text(self.unit.instr_count)
                  + " cases=" + mir_builder_i32_text(self.unit.case_count)
                  + " caps=" + mir_builder_i32_text(self.unit.function_cap)
                  + "/" + mir_builder_i32_text(self.unit.block_cap)
                  + "/" + mir_builder_i32_text(self.unit.local_cap)
                  + "/" + mir_builder_i32_text(self.unit.place_cap)
                  + "/" + mir_builder_i32_text(self.unit.value_cap)
                  + "/" + mir_builder_i32_text(self.unit.instr_cap)
                  + "/" + mir_builder_i32_text(self.unit.case_cap)
                  + " hitems=" + mir_builder_i32_text(self.h.item_count)
                  + " hfuncs=" + mir_builder_i32_text(self.h.function_count)
                  + " hlocals=" + mir_builder_i32_text(self.h.local_count)
                  + " htypes=" + mir_builder_i32_text(self.h.types.count)
                  + " hstmts=" + mir_builder_i32_text(self.h.stmt_count)
                  + " hexprs=" + mir_builder_i32_text(self.h.expr_count)
                  + " hlocalcap=" + mir_builder_i32_text(self.h.local_cap)
                  + " hstmtcap=" + mir_builder_i32_text(self.h.stmt_cap)
                  + " hexprcap=" + mir_builder_i32_text(self.h.expr_cap)
                  + " str_active_mb=" + mir_builder_memory_mb_text(vyx_rt_string_arena_active_bytes())
                  + " str_reserved_mb=" + mir_builder_memory_mb_text(vyx_rt_string_arena_reserved_bytes())
                  + " astdup_mb=" + mir_builder_memory_mb_text(vyx_rt_ast_dup_bytes_total())
                  + " astnode_mb=" + mir_builder_memory_mb_text(vyx_rt_ast_node_bytes_total())
                  + " rawdup_live_mb=" + mir_builder_memory_mb_text(vyx_rt_raw_dup_bytes_live())
                  + " rawdup_total_mb=" + mir_builder_memory_mb_text(vyx_rt_raw_dup_bytes_total())
                  + " strlen_entries=" + policy_i64_to_string(vyx_rt_string_len_entry_count())
                  + " heap_mb=" + mir_builder_memory_mb_text(vyx_rt_heap_used_bytes())
                  + " private_mb=" + mir_builder_memory_mb_text(vyx_rt_process_private_bytes())
                  + " working_mb=" + mir_builder_memory_mb_text(vyx_rt_process_working_set_bytes())
                  + " peak_private_mb=" + mir_builder_memory_mb_text(vyx_rt_process_peak_private_bytes())
                  + " peak_working_mb=" + mir_builder_memory_mb_text(vyx_rt_process_peak_working_set_bytes()));
        }
        if (heap_buckets_enabled && (mir_fn == 1 || (mir_fn % 256) == 0)) {
            let heap_label = "lowered fn=" + mir_builder_i32_text(mir_fn)
                + " hir=" + mir_builder_i32_text(hir_function_id)
                + " name=" + self.unit.function_name(mir_fn);
            vyx_rt_heap_bucket_report(heap_label.c_str());
        }
        mir_builder_release_temp_strings(temp_string_mark);
    }

    public fn drain_reachable_function_bodies(self) {
        var fn_id = self.pop_reachable_function();
        while (fn_id != mir_id_invalid()) {
            if (!self.function_is_lowered(fn_id)) {
                if (self.function_is_partition_external_root(fn_id)
                    || self.function_is_partition_declaration_only(fn_id)) {
                    self.mark_function_lowered(fn_id);
                } else {
                    let hir_fn = self.unit.function_hir_id(fn_id);
                    if (hir_fn != hir_id_invalid()) {
                        self.build_function_body(hir_fn);
                    } else {
                        self.mark_function_lowered(fn_id);
                    }
                }
            }
            fn_id = self.pop_reachable_function();
        }
    }

    public fn drain_reachable_function_bodies_streaming_verify(self,
                                                                  opt_level: i32,
                                                                  strict: bool) -> i32 {
        var errors: i32 = 0;
        var fn_id = self.pop_reachable_function();
        while (fn_id != mir_id_invalid()) {
            if (!self.function_is_lowered(fn_id)) {
                if (self.function_is_partition_external_root(fn_id)
                    || self.function_is_partition_declaration_only(fn_id)) {
                    self.mark_function_lowered(fn_id);
                } else {
                    let hir_fn = self.unit.function_hir_id(fn_id);
                    if (hir_fn != hir_id_invalid()) {
                        let block_mark = self.unit.block_count;
                        let local_mark = self.unit.local_count;
                        let place_mark = self.unit.place_count;
                        let value_mark = self.unit.value_count;
                        let instr_mark = self.unit.instr_count;
                        let case_mark = self.unit.case_count;
                        self.build_function_body(hir_fn);
                        self.enqueue_live_function_target_dependencies(value_mark + 1,
                                                                          self.unit.value_count);
                        if (self.unit.function_first_block(fn_id) != mir_id_invalid()) {
                            errors = errors + mir_run_function_pass_pipeline(&mut self.unit,
                                                                               fn_id,
                                                                               opt_level,
                                                                               strict,
                                                                               block_mark,
                                                                               local_mark,
                                                                               place_mark,
                                                                               value_mark,
                                                                               instr_mark,
                                                                               case_mark);
                        }
                        self.unit.discard_recent_body_records(fn_id,
                                                               block_mark,
                                                               local_mark,
                                                               place_mark,
                                                               value_mark,
                                                               instr_mark,
                                                               case_mark);
                        self.unit.set_function_streamed_body_discarded(fn_id, true);
                    } else {
                        self.mark_function_lowered(fn_id);
                    }
                }
            }
            fn_id = self.pop_reachable_function();
        }
        return errors;
    }

    public fn stream_verify_reachable(self, opt_level: i32, strict: bool) -> i32 {
        self.prepare_streaming_codegen_round();
        var errors = self.drain_reachable_function_bodies_streaming_verify(opt_level, strict);
        self.prepare_streaming_codegen_round();
        errors = errors + self.drain_reachable_function_bodies_streaming_verify(opt_level, strict);
        // Two shared rounds cover reflection finalization.  Lazy trait/generic
        // bodies first reached in round 2 still need further prepare/drain
        // pairs: `defer_function_materialization_retry` only requeues on the
        // next prepare, and a function deferred in the last fixed round had
        // no further attempt.
        var deferred_retry: i32 = 0;
        while (self.pending_deferred_materializations() > 0 && deferred_retry < 64) {
            self.prepare_streaming_codegen_round();
            errors = errors + self.drain_reachable_function_bodies_streaming_verify(opt_level, strict);
            deferred_retry = deferred_retry + 1;
        }
        return errors;
    }

    public fn release_raw_node_chain(self, head: rawptr, next_offset: i32) {
        var cur = head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, next_offset));
            free(cur);
            cur = next;
        }
    }

    public fn release_build_state(self) {
        self.function_map = mir_i32_map_dispose(self.function_map);
        self.reachable_function_map = mir_i32_map_dispose(self.reachable_function_map);
        self.lowered_function_map = mir_i32_map_dispose(self.lowered_function_map);
        self.deferred_materialization_map = mir_i32_map_dispose(self.deferred_materialization_map);
        self.local_map = mir_i32_map_dispose(self.local_map);
        self.place_map = mir_i32_map_dispose(self.place_map);
        self.hir_open_template_cache = mir_i32_map_dispose(self.hir_open_template_cache);
        self.type_open_template_cache = mir_i32_map_dispose(self.type_open_template_cache);
        self.name_function_index = mir_name_id_map_dispose(self.name_function_index);
        self.name_hir_function_index = mir_name_id_map_dispose(self.name_hir_function_index);
        self.owner_method_function_index = mir_pair_id_map_dispose(self.owner_method_function_index);
        self.owner_method_hir_function_index = mir_pair_id_map_dispose(self.owner_method_hir_function_index);
        self.field_name_index = mir_pair_id_map_dispose(self.field_name_index);
        self.field_ordinal_index = mir_pair_id_map_dispose(self.field_ordinal_index);
        self.type_equivalence_index = mir_int_pair_id_map_dispose(self.type_equivalence_index);
        self.registered_type_atom_index = mir_name_id_map_dispose(self.registered_type_atom_index);
        self.type_text_id_index = mir_name_id_map_dispose(self.type_text_id_index);
        self.layout_type_index = mir_name_id_map_dispose(self.layout_type_index);
        self.layout_type_id_map = mir_i32_map_dispose(self.layout_type_id_map);
        self.layout_materialized_type_id_map = mir_i32_map_dispose(self.layout_materialized_type_id_map);
        self.layout_owner_type_item_map = mir_i32_map_dispose(self.layout_owner_type_item_map);
        self.field_owner_first_map = mir_i32_map_dispose(self.field_owner_first_map);
        self.field_owner_next_map = mir_i32_map_dispose(self.field_owner_next_map);
        self.variant_owner_first_map = mir_i32_map_dispose(self.variant_owner_first_map);
        self.variant_owner_next_map = mir_i32_map_dispose(self.variant_owner_next_map);
        self.field_owner_done_map = mir_i32_map_dispose(self.field_owner_done_map);
        self.variant_owner_done_map = mir_i32_map_dispose(self.variant_owner_done_map);
        self.layout_item_count = 0;
        self.layout_owner_item_count = 0;
        self.release_raw_node_chain(self.reachable_function_queue_head, 8);
        self.release_raw_node_chain(self.drop_stack_head, 8);
        self.release_raw_node_chain(self.defer_stack_head, 8);
        self.release_raw_node_chain(self.storage_stack_head, 8);
        self.reachable_function_queue_head = null;
        self.reachable_function_queue_tail = null;
        self.drop_stack_head = null;
        self.defer_stack_head = null;
        self.storage_stack_head = null;
        self.break_drop_mark = null;
        self.continue_drop_mark = null;
        self.break_defer_mark = null;
        self.continue_defer_mark = null;
        self.break_storage_mark = null;
        self.continue_storage_mark = null;
        if (self.dci_lifecycle_root != null) {
            cJSON_Delete(self.dci_lifecycle_root);
            self.dci_lifecycle_root = null;
        }
        self.dci_lifecycle_skip = false;
        if (self.has_hir_codegen_builder) {
            // The HIR codegen builder handle is borrowed from the caller.
            // The driver/LLVM lowering pipeline owns release+free.
            self.hir_codegen_builder = null;
            self.has_hir_codegen_builder = false;
        }
        vyx_rt_heap_trim();
    }

    public fn ensure_field_layout_for_ref(self, field_id: i32) {
        if (field_id == hir_id_invalid()
            || field_id < 1
            || field_id > self.h.item_count
            || self.h.item_kind(field_id) != hir_item_field()) {
            return;
        }
        self.ensure_field_layout_for_item(field_id);
    }

    public fn finalize_field_layouts_for_refs(self) {
        var place_id: i32 = 1;
        while (place_id <= self.unit.place_count) {
            self.ensure_field_layout_for_ref(self.unit.place_field(place_id));
            place_id = place_id + 1;
        }
        var value_id: i32 = 1;
        while (value_id <= self.unit.value_count) {
            self.ensure_field_layout_for_ref(self.unit.value_aggregate_field(value_id));
            value_id = value_id + 1;
        }
    }

    // This is the one backend-neutral boundary before a backend consumes the
    // reachable-function queue.  LLVM and MIR2CPP must observe the same HIR
    // view, root table, concrete layouts, and reflection metadata; only the
    // consumer of each transient MIR body is backend-specific.
    public fn prepare_streaming_codegen_round(self) {
        self.sync_from_hir(self.h);
        // Imported .vyi layouts can be required by reflection/layout builtins
        // before the first body forces a lazy field lookup.
        self.build_field_layouts();
        self.build_variant_layouts();
        if (self.has_hir_codegen_builder) {
            hir_codegen_builder_handle_finalize_reflection_metadata(self.hir_codegen_builder);
            self.function_table_scan_next = 1;
            self.refresh_from_codegen_builder();
            self.build_field_layouts();
            self.build_variant_layouts();
        }
        self.activate_deferred_function_materializations();
    }

    public fn build(self) -> MirUnit {
        self.prepare_streaming_codegen_round();
        self.drain_reachable_function_bodies();
        self.prepare_streaming_codegen_round();
        self.drain_reachable_function_bodies();
        var deferred_retry: i32 = 0;
        while (self.pending_deferred_materializations() > 0 && deferred_retry < 64) {
            self.prepare_streaming_codegen_round();
            self.drain_reachable_function_bodies();
            deferred_retry = deferred_retry + 1;
        }
        self.finalize_field_layouts_for_refs();
        let built = self.unit;
        self.release_build_state();
        return built;
    }
}

public fn mir_build_from_hir(h: HirUnit) -> MirUnit {
    let builder = MirUnitBuilder.create(h);
    return builder.build();
}

public fn mir_build_from_hir_codegen_builder_handle(hir_builder: rawptr) -> MirUnit {
    return mir_build_from_hir_codegen_builder_handle_with_emit_roots(hir_builder,
                                                                     "",
                                                                     false);
}

public fn mir_build_from_hir_codegen_builder_handle_with_emit_roots(hir_builder: rawptr,
                                                                    emit_root_names: string,
                                                                    emit_root_names_specified: bool) -> MirUnit {
    return mir_build_from_hir_codegen_builder_handle_with_emit_roots_and_dci(hir_builder,
                                                                             emit_root_names,
                                                                             emit_root_names_specified,
                                                                             "");
}

public fn mir_build_from_hir_codegen_builder_handle_with_emit_roots_and_dci(hir_builder: rawptr,
                                                                            emit_root_names: string,
                                                                            emit_root_names_specified: bool,
                                                                            dci_abi_text: string) -> MirUnit {
    let builder = MirUnitBuilder.create_for_codegen(hir_builder);
    // This path emits one linked MIR2CPP project, so there are no sibling
    // root-partition objects that could provide declaration-only bodies.
    builder.partition_codegen_roots = false;
    builder.emit_root_names = emit_root_names;
    builder.emit_root_names_specified = emit_root_names_specified;
    if (dci_abi_text.len > 0) {
        builder.unit.set_dci_abi_text( dci_abi_text.clone());
    }
    return builder.build();
}
