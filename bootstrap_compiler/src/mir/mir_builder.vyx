extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn getenv(name: rawptr) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strncmp(a: rawptr, b: rawptr, n: i64) -> i32;
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_rt_string_arena_checkpoint() -> rawptr;
    fn vyx_rt_string_arena_release(mark: rawptr);
    fn vyx_rt_string_arena_reserved_bytes() -> i64;
    fn vyx_rt_string_arena_active_bytes() -> i64;
    fn vyx_rt_ast_dup_bytes_total() -> i64;
    fn vyx_rt_ast_node_bytes_total() -> i64;
    fn vyx_rt_raw_dup_bytes_total() -> i64;
    fn vyx_rt_raw_dup_bytes_live() -> i64;
    fn vyx_rt_string_len_entry_count() -> i64;
    fn vyx_rt_process_private_bytes() -> i64;
    fn vyx_rt_process_working_set_bytes() -> i64;
    fn vyx_rt_process_peak_private_bytes() -> i64;
    fn vyx_rt_process_peak_working_set_bytes() -> i64;
    fn vyx_rt_heap_used_bytes() -> i64;
    fn vyx_rt_heap_bucket_report(label: rawptr);
    fn vyx_rt_heap_trim();
    fn cJSON_Parse(value: rawptr) -> rawptr;
    fn cJSON_Delete(item: rawptr);
    fn cJSON_CreateArray() -> rawptr;
