module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn set_reflection_manifest(self, manifest: string) {
        self.reflection_manifest = manifest;
    }

    public fn set_reflection_name_map(self, name_map: string) {
        self.reflection_name_map = name_map;
    }

    public fn set_foreign_cpp_includes(self, includes: string) {
        self.foreign_cpp_includes = includes;
    }

    public fn set_dci_stub_specs(self, specs: string) {
        self.dci_stub_specs = specs;
    }

    public fn set_dci_abi_text(self, text: string) {
        self.dci_abi_text = text;
        self.dci_abi_path = "";
        self.dci_abi_is_binary = false;
    }

    public fn set_dci_abi_source(self, text: string, path: string, is_binary: bool) {
        self.dci_abi_text = text;
        self.dci_abi_path = path;
        self.dci_abi_is_binary = is_binary;
    }

    public fn set_interface_supers(self, supers: string) {
        self.interface_supers = supers;
    }
}
