module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    // Declaration facts survive body streaming. A shared header keeps unit
    // views in sync when another conversion appends a new binding.
    public fn dyn_method_implementation(self, payload: i32, prototype: i32) -> i32 {
        if (self.dyn_method_bindings == null) { return hir_id_invalid(); }
        var node = ast_read_rawptr(self.dyn_method_bindings);
        while (node != null) {
            if (ast_read_i32(node) == payload && ast_read_i32(ptr_offset(node, 4)) == prototype) {
                return ast_read_i32(ptr_offset(node, 8));
            }
            node = ast_read_rawptr(ptr_offset(node, 16));
        }
        return hir_id_invalid();
    }

    public fn bind_dyn_method(self, payload: i32, prototype: i32, implementation: i32) -> bool {
        if (payload <= 0 || prototype <= 0 || implementation <= 0) { return false; }
        let existing = self.dyn_method_implementation(payload, prototype);
        if (existing != hir_id_invalid()) { return existing == implementation; }
        if (self.dyn_method_bindings == null) {
            self.dyn_method_bindings = malloc(8);
            if (self.dyn_method_bindings == null) { return false; }
            ast_write_rawptr(self.dyn_method_bindings, null);
        }
        let node = malloc(24);
        if (node == null) { return false; }
        ast_write_i32(node, payload);
        ast_write_i32(ptr_offset(node, 4), prototype);
        ast_write_i32(ptr_offset(node, 8), implementation);
        ast_write_i32(ptr_offset(node, 12), 0);
        ast_write_rawptr(ptr_offset(node, 16), ast_read_rawptr(self.dyn_method_bindings));
        ast_write_rawptr(self.dyn_method_bindings, node);
        return true;
    }

    public fn release_dyn_method_bindings(self) {
        if (self.dyn_method_bindings == null) { return; }
        var node = ast_read_rawptr(self.dyn_method_bindings);
        while (node != null) {
            let next = ast_read_rawptr(ptr_offset(node, 16));
            free(node);
            node = next;
        }
        free(self.dyn_method_bindings);
        self.dyn_method_bindings = null;
    }

    public fn set_reflection_manifest(self, manifest: string) {
        self.reflection_manifest = manifest;
    }

    public fn set_reflection_name_map(self, name_map: string) {
        self.reflection_name_map = name_map;
    }

    public fn set_foreign_cpp_includes(self, includes: string) {
        self.foreign_cpp_includes = includes;
    }

    public fn set_dci_stub_specs(self, specs: string) {
        self.dci_stub_specs = specs;
    }

    public fn set_dci_abi_text(self, text: string) {
        self.dci_abi_text = text;
        self.dci_abi_path = "";
        self.dci_abi_is_binary = false;
    }

    public fn set_dci_abi_source(self, text: string, path: string, is_binary: bool) {
        self.dci_abi_text = text;
        self.dci_abi_path = path;
        self.dci_abi_is_binary = is_binary;
    }

    public fn set_interface_supers(self, supers: string) {
        self.interface_supers = supers;
    }
}
