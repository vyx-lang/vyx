module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn ensure_statics(self, want_count: i32) {
        if (want_count <= self.static_cap) { return; }
        var new_cap = self.static_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.static_buf, self.static_count, self.static_cap, mir_static_record_size(), want_count);
        if (new_buf == self.static_buf) { return; }
        self.static_buf = new_buf;
        self.static_cap = new_cap;
    }

    public fn static_record(&self, id: i32) -> rawptr { return mir_record_at(self.static_buf, id, mir_static_record_size()); }

    public fn add_static_item(self,
                              item_id: i32,
                              item_kind: i32,
                              name: string,
                              type_id: i32,
                              init_kind: i32,
                              init_target_kind: i32,
                              init_target_id: i32,
                              init_int: i64,
                              init_text: string,
                              module_name: string,
                              flags: i32) -> i32 {
        if (item_id == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_statics(item_id);
        let rec = self.static_record(item_id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, item_id);
        ast_write_i32(ptr_offset(rec, 4), item_kind);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), init_kind);
        ast_write_i32(ptr_offset(rec, 16), init_target_kind);
        ast_write_i32(ptr_offset(rec, 20), init_target_id);
        ast_write_i64(ptr_offset(rec, 24), init_int);
        mir_write_string(rec, 32, 40, name);
        mir_write_string(rec, 48, 56, init_text);
        mir_write_string(rec, 64, 72, module_name);
        ast_write_i32(ptr_offset(rec, 80), flags);
        if (item_id > self.static_count) { self.static_count = item_id; }
        return item_id;
    }

    public fn static_exists(&self, id: i32) -> bool { let r = self.static_record(id); if (r == null) { return false; } return ast_read_i32(r) == id; }

    public fn static_item_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn static_type(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn static_init_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn static_init_target_kind(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn static_init_target_id(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn static_init_int(&self, id: i32) -> i64 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i64(ptr_offset(r, 24)); }

    public fn static_name(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 32, 40); }

    public fn static_init_text(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 48, 56); }

    public fn static_module_name(&self, id: i32) -> string { return mir_read_string(self.static_record(id), 64, 72); }

    public fn static_flags(&self, id: i32) -> i32 { let r = self.static_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 80)); }
}
