module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn ensure_fields(self, want_count: i32) {
        if (want_count <= self.field_cap) { return; }
        var new_cap = self.field_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.field_buf, self.field_count, self.field_cap, mir_field_record_size(), want_count);
        if (new_buf == self.field_buf) { return; }
        self.field_buf = new_buf;
        self.field_cap = new_cap;
    }

    public fn field_record(&self, id: i32) -> rawptr { return mir_record_at(self.field_buf, id, mir_field_record_size()); }

    public fn add_field_layout(self,
                               field_id: i32,
                               owner_item_id: i32,
                               owner_type_id: i32,
                               type_id: i32,
                               field_index: i32,
                               name: string) -> i32 {
        if (field_id == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_fields(field_id);
        let rec = self.field_record(field_id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, field_id);
        ast_write_i32(ptr_offset(rec, 4), owner_item_id);
        ast_write_i32(ptr_offset(rec, 8), owner_type_id);
        ast_write_i32(ptr_offset(rec, 12), type_id);
        ast_write_i32(ptr_offset(rec, 16), field_index);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        mir_write_string(rec, 24, 32, name);
        if (field_id > self.field_count) { self.field_count = field_id; }
        return field_id;
    }

    public fn field_owner_item(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn field_owner_type(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn field_type(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn field_index(&self, id: i32) -> i32 { let r = self.field_record(id); if (r == null) { return -1; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn field_name(&self, id: i32) -> string { return mir_read_string(self.field_record(id), 24, 32); }

    public fn field_count_for_type(&self, type_id: i32) -> i32 {
        var max_index: i32 = -1;
        var id: i32 = 1;
        while (id <= self.field_count) {
            let rec = self.field_record(id);
            if (rec != null && ast_read_i32(rec) == id && ast_read_i32(ptr_offset(rec, 8)) == type_id) {
                let idx = ast_read_i32(ptr_offset(rec, 16));
                if (idx > max_index) { max_index = idx; }
            }
            id = id + 1;
        }
        return max_index + 1;
    }

    public fn field_id_for_type_index(&self, type_id: i32, wanted_index: i32) -> i32 {
        var found = mir_id_invalid();
        var id: i32 = 1;
        while (id <= self.field_count) {
            let rec = self.field_record(id);
            if (rec != null
                && ast_read_i32(rec) == id
                && ast_read_i32(ptr_offset(rec, 8)) == type_id
                && ast_read_i32(ptr_offset(rec, 16)) == wanted_index) {
                // Later HIR items are the canonical/current layout when
                // versioned declarations share a type and field slot.
                found = id;
            }
            id = id + 1;
        }
        return found;
    }
}
