module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn set_value_aggregate_field(self, value_id: i32, field_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 60), field_id); }
    }

    public fn value_aggregate_field(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }

    public fn value_function(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    // Copy propagation may retarget only a direct local read. Keeping the
    // ValueId stable preserves its source location and intrusive arg linkage.
    public fn set_value_place(self, value_id: i32, place_id: i32) -> bool {
        if (value_id < 1 || value_id > self.value_count
            || place_id < 1 || place_id > self.place_count) { return false; }
        let value_rec = self.value_record(value_id);
        let place_rec = self.place_record(place_id);
        if (value_rec == null || place_rec == null
            || ast_read_i32(value_rec) != value_id
            || ast_read_i32(place_rec) != place_id
            || self.value_kind(value_id) != mir_value_read_place()
            || self.value_function(value_id) != self.place_function(place_id)
            || self.value_type(value_id) != self.place_type(place_id)
            || self.place_kind(place_id) != mir_place_local()) {
            return false;
        }
        let local_id = self.place_local(place_id);
        if (local_id < 1 || local_id > self.local_count
            || self.local_record(local_id) == null
            || ast_read_i32(self.local_record(local_id)) != local_id
            || self.local_function(local_id) != self.value_function(value_id)
            || self.local_type(local_id) != self.value_type(value_id)
            || self.local_place(local_id) != place_id) {
            return false;
        }
        ast_write_i32(ptr_offset(value_rec, 16), place_id);
        return true;
    }

    public fn value_place(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn ensure_values(self, want_count: i32) {
        if (want_count <= self.value_cap) { return; }
        var new_cap = self.value_cap;
        if (new_cap <= 0) { new_cap = 4096; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.value_buf, self.value_count, self.value_cap, mir_value_record_size(), want_count);
        if (new_buf == self.value_buf) { return; }
        self.value_buf = new_buf;
        self.value_cap = new_cap;
    }

    public fn value_record(&self, id: i32) -> rawptr { return mir_record_at(self.value_buf, id, mir_value_record_size()); }

    public fn add_value(self,
                        function_id: i32,
                        kind: i32,
                        type_id: i32,
                        place_id: i32,
                        target_kind: i32,
                        target_id: i32,
                        source_expr_id: i32,
                        flags: i32,
                        op: i32,
                        int_value: i64,
                        name: string,
                        text: string) -> i32 {
        let id = self.ids.alloc_value();
        self.ensure_values(id);
        let rec = self.value_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), place_id);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), target_kind);
        ast_write_i32(ptr_offset(rec, 44), target_id);
        ast_write_i32(ptr_offset(rec, 48), source_expr_id);
        ast_write_i32(ptr_offset(rec, 52), flags);
        ast_write_i32(ptr_offset(rec, 56), op);
        ast_write_i32(ptr_offset(rec, 60), mir_id_invalid());
        ast_write_i64(ptr_offset(rec, 64), int_value);
        mir_write_string(rec, 72, 80, name);
        mir_write_string(rec, 88, 96, text);
        ast_write_i32(ptr_offset(rec, 104), 0);
        ast_write_i32(ptr_offset(rec, 108), 0);
        ast_write_i32(ptr_offset(rec, 112), 0);
        ast_write_i32(ptr_offset(rec, 116), 0);
        if (id > self.value_count) { self.value_count = id; }
        return id;
    }

    public fn set_value_lhs(self, value_id: i32, lhs_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 20), lhs_id); }
    }

    public fn set_value_rhs(self, value_id: i32, rhs_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 24), rhs_id); }
    }

    public fn set_value_aux(self, value_id: i32, aux_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 28), aux_id); }
    }

    public fn set_value_first_arg(self, value_id: i32, arg_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 32), arg_id); }
    }

    public fn set_value_next_arg(self, value_id: i32, next_id: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 36), next_id); }
    }

    public fn set_value_flags(self, value_id: i32, flags: i32) {
        let rec = self.value_record(value_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 52), flags); }
    }

    public fn replace_value_with_integer_constant(self,
                                                   value_id: i32,
                                                   constant_kind: i32,
                                                   int_value: i64) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 12), constant_kind);
        ast_write_i32(ptr_offset(rec, 16), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), mir_target_none());
        ast_write_i32(ptr_offset(rec, 44), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 52), 0);
        ast_write_i32(ptr_offset(rec, 56), 0);
        ast_write_i32(ptr_offset(rec, 60), mir_id_invalid());
        ast_write_i64(ptr_offset(rec, 64), int_value);
        mir_write_string(rec, 72, 80, "");
        mir_write_string(rec, 88, 96, "");
    }

    public fn set_value_target(self, value_id: i32, target_kind: i32, target_id: i32) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 40), target_kind);
        ast_write_i32(ptr_offset(rec, 44), target_id);
    }

    public fn set_value_loc(self, value_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.value_record(value_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 104), line);
        ast_write_i32(ptr_offset(rec, 108), col);
        ast_write_i32(ptr_offset(rec, 112), end_line);
        ast_write_i32(ptr_offset(rec, 116), end_col);
    }

    public fn value_loc_ptr(&self, value_id: i32) -> rawptr {
        let rec = self.value_record(value_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 104);
    }

    public fn value_loc_line(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 104)); }

    public fn value_loc_col(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 108)); }

    public fn value_loc_end_line(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 112)); }

    public fn value_loc_end_col(&self, value_id: i32) -> i32 { let r = self.value_record(value_id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 116)); }

    public fn value_type(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn value_kind(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn value_lhs(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn value_rhs(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }

    public fn value_aux(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }

    public fn value_first_arg(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }

    public fn value_next_arg(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }

    public fn value_target_kind(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }

    public fn value_target_id(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }

    public fn value_source_expr(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }

    public fn value_flags(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }

    public fn value_op(&self, id: i32) -> i32 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }

    public fn value_int(&self, id: i32) -> i64 { let r = self.value_record(id); if (r == null) { return 0; } return ast_read_i64(ptr_offset(r, 64)); }

    public fn value_name(&self, id: i32) -> string { return mir_read_string(self.value_record(id), 72, 80); }

    public fn value_text(&self, id: i32) -> string { return mir_read_string(self.value_record(id), 88, 96); }
}
