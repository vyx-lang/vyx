module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn set_case_target_block(self, case_id: i32, target_block_id: i32) -> bool {
        let rec = self.case_record(case_id);
        if (rec == null || ast_read_i32(rec) != case_id) { return false; }
        let owner_block = self.case_owner_block(case_id);
        let owner_rec = self.block_record(owner_block);
        let target_rec = self.block_record(target_block_id);
        if (owner_block == mir_id_invalid()
            || owner_rec == null
            || ast_read_i32(owner_rec) != owner_block
            || (self.block_flags(owner_block) & mir_block_flag_removed()) != 0
            || target_block_id == mir_id_invalid()
            || target_rec == null
            || ast_read_i32(target_rec) != target_block_id
            || self.block_function(owner_block) != self.block_function(target_block_id)
            || (self.block_flags(target_block_id) & mir_block_flag_removed()) != 0) {
            return false;
        }
        ast_write_i32(ptr_offset(rec, 16), target_block_id);
        return true;
    }

    public fn case_owner_block(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn case_target_block(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn ensure_cases(self, want_count: i32) {
        if (want_count <= self.case_cap) { return; }
        var new_cap = self.case_cap;
        if (new_cap <= 0) { new_cap = 512; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.case_buf, self.case_count, self.case_cap, mir_case_record_size(), want_count);
        if (new_buf == self.case_buf) { return; }
        self.case_buf = new_buf;
        self.case_cap = new_cap;
    }

    public fn case_record(&self, id: i32) -> rawptr { return mir_record_at(self.case_buf, id, mir_case_record_size()); }

    public fn add_case(self,
                       owner_block_id: i32,
                       pattern_value_id: i32,
                       guard_value_id: i32,
                       target_block_id: i32,
                       source_stmt_id: i32,
                       text: string) -> i32 {
        let id = self.ids.alloc_case();
        self.ensure_cases(id);
        let rec = self.case_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), owner_block_id);
        ast_write_i32(ptr_offset(rec, 8), pattern_value_id);
        ast_write_i32(ptr_offset(rec, 12), guard_value_id);
        ast_write_i32(ptr_offset(rec, 16), target_block_id);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 28), 0);
        mir_write_string(rec, 32, 40, text);
        if (id > self.case_count) { self.case_count = id; }
        return id;
    }

    public fn set_case_next(self, case_id: i32, next_id: i32) {
        let rec = self.case_record(case_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 20), next_id); }
    }

    public fn case_next(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn case_source_stmt(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }

    public fn case_text(&self, id: i32) -> string { return mir_read_string(self.case_record(id), 32, 40); }

    public fn case_pattern_value(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn case_guard_value(&self, id: i32) -> i32 { let r = self.case_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
}
