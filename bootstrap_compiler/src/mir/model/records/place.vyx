module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn place_field(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }

    public fn place_function(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn place_local(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn ensure_places(self, want_count: i32) {
        if (want_count <= self.place_cap) { return; }
        var new_cap = self.place_cap;
        if (new_cap <= 0) { new_cap = 2048; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.place_buf, self.place_count, self.place_cap, mir_place_record_size(), want_count);
        if (new_buf == self.place_buf) { return; }
        self.place_buf = new_buf;
        self.place_cap = new_cap;
    }

    public fn place_record(&self, id: i32) -> rawptr { return mir_record_at(self.place_buf, id, mir_place_record_size()); }

    public fn add_place(self,
                        function_id: i32,
                        kind: i32,
                        type_id: i32,
                        local_id: i32,
                        base_place_id: i32,
                        field_id: i32,
                        index_value_id: i32,
                        source_expr_id: i32,
                        name: string) -> i32 {
        let id = self.ids.alloc_place();
        self.ensure_places(id);
        let rec = self.place_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), local_id);
        ast_write_i32(ptr_offset(rec, 20), base_place_id);
        ast_write_i32(ptr_offset(rec, 24), field_id);
        ast_write_i32(ptr_offset(rec, 28), index_value_id);
        ast_write_i32(ptr_offset(rec, 32), source_expr_id);
        ast_write_i32(ptr_offset(rec, 36), 0);
        mir_write_string(rec, 40, 48, name);
        if (id > self.place_count) { self.place_count = id; }
        return id;
    }

    public fn place_type(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn place_kind(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn place_base(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn place_index_value(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }

    // Idle slot at offset 36, reserved by add_place() as zero.  It stores the
    // pointer-check policy decided by the mir_ptr_hoist pass; see
    // mir_check_policy_* in mir_ids.vyx.
    public fn place_check_policy(&self, id: i32) -> i32 {
        let r = self.place_record(id);
        if (r == null) { return mir_check_policy_inline(); }
        return ast_read_i32(ptr_offset(r, 36));
    }

    public fn set_place_check_policy(self, id: i32, policy: i32) -> bool {
        if (id < 1 || id > self.place_count) { return false; }
        let r = self.place_record(id);
        if (r == null) { return false; }
        ast_write_i32(ptr_offset(r, 36), policy);
        return true;
    }

    public fn place_source_expr(&self, id: i32) -> i32 { let r = self.place_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }

    public fn place_name(&self, id: i32) -> string { return mir_read_string(self.place_record(id), 40, 48); }
}
