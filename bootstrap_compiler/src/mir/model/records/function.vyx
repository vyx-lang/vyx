module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn ensure_functions(self, want_count: i32) {
        if (want_count <= self.function_cap) { return; }
        var new_cap = self.function_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.function_buf, self.function_count, self.function_cap, mir_function_record_size(), want_count);
        if (new_buf == self.function_buf) { return; }
        self.function_buf = new_buf;
        self.function_cap = new_cap;
    }

    public fn function_record(&self, id: i32) -> rawptr { return mir_record_at(self.function_buf, id, mir_function_record_size()); }

    public fn add_function(self, hir_function_id: i32, hir_item_id: i32, name: string, ret_type_id: i32) -> i32 {
        let id = self.ids.alloc_function();
        self.ensure_functions(id);
        let rec = self.function_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), hir_function_id);
        ast_write_i32(ptr_offset(rec, 8), hir_item_id);
        ast_write_i32(ptr_offset(rec, 12), ret_type_id);
        ast_write_i32(ptr_offset(rec, 16), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), 0);
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), 0);
        ast_write_i32(ptr_offset(rec, 96), 0);
        ast_write_i32(ptr_offset(rec, 100), 0);
        ast_write_i32(ptr_offset(rec, 104), 0);
        // Offset 108 is reserved for the streaming-lowering body status.
        // It is not part of HIR function flags or the source-level ABI.
        ast_write_i32(ptr_offset(rec, 108), 0);
        mir_write_string(rec, 112, 120, "");
        mir_write_string(rec, 32, 40, name);
        if (id > self.function_count) { self.function_count = id; }
        return id;
    }

    public fn set_function_item_kind(self, function_id: i32, item_kind: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 96), item_kind);
    }

    public fn set_function_owner_item_kind(self, function_id: i32, item_kind: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 100), item_kind);
    }

    public fn set_function_flags(self, function_id: i32, flags: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 104), flags);
    }

    // Offset 108 is streaming-only bookkeeping.  It deliberately stays out
    // of source/HIR flags: backends can release a transient body while the
    // shared function signature remains part of the unit declaration index.
    fn function_stream_state(&self, function_id: i32) -> i32 {
        let rec = self.function_record(function_id);
        if (rec == null) { return 0; }
        return ast_read_i32(ptr_offset(rec, 108));
    }

    fn set_function_stream_state_bit(self,
                                      function_id: i32,
                                      bit: i32,
                                      enabled: bool) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        var state = ast_read_i32(ptr_offset(rec, 108));
        if (enabled) { state = state | bit; }
        else { state = state & (~bit); }
        ast_write_i32(ptr_offset(rec, 108), state);
    }

    public fn set_function_streamed_body_discarded(self,
                                                   function_id: i32,
                                                   discarded: bool) {
        self.set_function_stream_state_bit(function_id, 1, discarded);
    }

    public fn set_function_streamed_needs_closure_adapter(self,
                                                          function_id: i32,
                                                          needed: bool) {
        self.set_function_stream_state_bit(function_id, 2, needed);
    }

    public fn set_function_streamed_needs_raw_callback_adapter(self,
                                                               function_id: i32,
                                                               needed: bool) {
        self.set_function_stream_state_bit(function_id, 4, needed);
    }

    public fn set_function_generic_env(self, function_id: i32, params: string, args: string, owner_type: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        mir_write_string(rec, 48, 56, params);
        mir_write_string(rec, 64, 72, args);
        mir_write_string(rec, 80, 88, owner_type);
    }

    public fn set_function_symbol_discriminator(self,
                                                function_id: i32,
                                                discriminator: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        mir_write_string(rec, 112, 120, discriminator);
    }

    public fn set_function_block_chain(self,
                                       function_id: i32,
                                       first_block_id: i32,
                                       active_count: i32) -> bool {
        let function_rec = self.function_record(function_id);
        if (function_rec == null || ast_read_i32(function_rec) != function_id
            || active_count < 0) { return false; }
        if (first_block_id != mir_id_invalid()) {
            let block_rec = self.block_record(first_block_id);
            if (block_rec == null || ast_read_i32(block_rec) != first_block_id
                || self.block_function(first_block_id) != function_id
                || (self.block_flags(first_block_id) & mir_block_flag_removed()) != 0) {
                return false;
            }
        } else if (active_count != 0) {
            return false;
        }
        ast_write_i32(ptr_offset(function_rec, 24), first_block_id);
        ast_write_i32(ptr_offset(function_rec, 28), active_count);
        return true;
    }

    public fn function_hir_id(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn function_hir_item(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn function_return_type(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn function_first_local(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn function_local_count(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn function_first_block(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }

    public fn function_block_count(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }

    public fn function_name(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 32, 40); }

    public fn function_generic_params(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 48, 56); }

    public fn function_generic_args(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 64, 72); }

    public fn function_owner_type(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 80, 88); }

    public fn function_symbol_discriminator(&self, id: i32) -> string { return mir_read_string(self.function_record(id), 112, 120); }

    public fn function_item_kind(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 96)); }

    public fn function_owner_item_kind(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 100)); }

    public fn function_flags(&self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 104)); }

    public fn function_streamed_body_discarded(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 1) != 0;
    }

    public fn function_streamed_needs_closure_adapter(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 2) != 0;
    }

    public fn function_streamed_needs_raw_callback_adapter(&self, id: i32) -> bool {
        return (self.function_stream_state(id) & 4) != 0;
    }
}
