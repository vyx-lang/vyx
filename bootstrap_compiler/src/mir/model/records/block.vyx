module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn ensure_blocks(self, want_count: i32) {
        if (want_count <= self.block_cap) { return; }
        var new_cap = self.block_cap;
        if (new_cap <= 0) { new_cap = 512; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.block_buf, self.block_count, self.block_cap, mir_block_record_size(), want_count);
        if (new_buf == self.block_buf) { return; }
        self.block_buf = new_buf;
        self.block_cap = new_cap;
    }

    public fn block_record(&self, id: i32) -> rawptr { return mir_record_at(self.block_buf, id, mir_block_record_size()); }

    public fn add_block(self, function_id: i32, source_stmt_id: i32) -> i32 {
        let id = self.ids.alloc_block();
        self.ensure_blocks(id);
        let rec = self.block_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 12), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 16), 0);
        ast_write_i32(ptr_offset(rec, 20), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 44), 0);
        ast_write_i32(ptr_offset(rec, 48), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 52), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 56), 0);
        ast_write_i32(ptr_offset(rec, 60), 0);
        ast_write_i32(ptr_offset(rec, 64), 0);
        ast_write_i32(ptr_offset(rec, 68), 0);
        if (function_id != mir_id_invalid()) {
            let fn_rec = self.function_record(function_id);
            if (fn_rec != null) {
                let first = ast_read_i32(ptr_offset(fn_rec, 24));
                if (first == mir_id_invalid()) {
                    ast_write_i32(ptr_offset(fn_rec, 24), id);
                } else {
                    var cur = first;
                    while (cur != mir_id_invalid()) {
                        let cur_rec = self.block_record(cur);
                        if (cur_rec == null) { cur = mir_id_invalid(); }
                        else {
                            let next = ast_read_i32(ptr_offset(cur_rec, 48));
                            if (next == mir_id_invalid()) {
                                ast_write_i32(ptr_offset(cur_rec, 48), id);
                                cur = mir_id_invalid();
                            } else {
                                cur = next;
                            }
                        }
                    }
                }
                var block_count = ast_read_i32(ptr_offset(fn_rec, 28));
                block_count = block_count + 1;
                ast_write_i32(ptr_offset(fn_rec, 28), block_count);
            }
        }
        if (id > self.block_count) { self.block_count = id; }
        return id;
    }

    public fn block_loc_ptr(&self, block_id: i32) -> rawptr {
        let rec = self.block_record(block_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 56);
    }

    public fn set_block_loc(self, block_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.block_record(block_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 56), line);
        ast_write_i32(ptr_offset(rec, 60), col);
        ast_write_i32(ptr_offset(rec, 64), end_line);
        ast_write_i32(ptr_offset(rec, 68), end_col);
    }

    public fn set_block_terminator(self,
                                   block_id: i32,
                                   kind: i32,
                                   value_id: i32,
                                   target_block_id: i32,
                                   false_block_id: i32,
                                   first_case_id: i32,
                                   aux: i32) {
        let rec = self.block_record(block_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 20), kind);
        ast_write_i32(ptr_offset(rec, 24), value_id);
        ast_write_i32(ptr_offset(rec, 28), target_block_id);
        ast_write_i32(ptr_offset(rec, 32), false_block_id);
        ast_write_i32(ptr_offset(rec, 36), first_case_id);
        ast_write_i32(ptr_offset(rec, 52), aux);
    }

    public fn set_block_next(self, block_id: i32, next_block_id: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id
            || (self.block_flags(block_id) & mir_block_flag_removed()) != 0) { return false; }
        if (next_block_id != mir_id_invalid()) {
            let next_rec = self.block_record(next_block_id);
            if (next_rec == null || ast_read_i32(next_rec) != next_block_id
                || self.block_function(next_block_id) != self.block_function(block_id)
                || (self.block_flags(next_block_id) & mir_block_flag_removed()) != 0) {
                return false;
            }
        }
        ast_write_i32(ptr_offset(rec, 48), next_block_id);
        return true;
    }

    public fn set_block_flags(self, block_id: i32, flags: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id) { return false; }
        ast_write_i32(ptr_offset(rec, 44), flags);
        return true;
    }

    public fn tombstone_block(self, block_id: i32) -> bool {
        let rec = self.block_record(block_id);
        if (rec == null || ast_read_i32(rec) != block_id) { return false; }
        ast_write_i32(ptr_offset(rec, 44), self.block_flags(block_id) | mir_block_flag_removed());
        ast_write_i32(ptr_offset(rec, 48), mir_id_invalid());
        self.set_block_terminator(block_id,
                                  mir_term_unreachable(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid(),
                                  mir_id_invalid());
        return true;
    }

    public fn block_first_instr(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn block_last_instr(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn block_instr_count(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn block_term_kind(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn block_term_value(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }

    public fn block_term_target(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }

    public fn block_term_false(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }

    public fn block_term_first_case(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }

    public fn block_source_stmt(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }

    public fn block_flags(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }

    public fn block_is_removed(&self, id: i32) -> bool { return (self.block_flags(id) & mir_block_flag_removed()) != 0; }

    public fn block_next(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }

    public fn block_term_aux(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }

    public fn block_loc_line(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }

    public fn block_loc_col(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }

    public fn block_loc_end_line(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 64)); }

    public fn block_loc_end_col(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 68)); }

    public fn block_function(&self, id: i32) -> i32 { let r = self.block_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
}
