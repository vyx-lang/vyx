module bootstrap.mir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;

@[vis(world)]
impl bootstrap.mir_model.MirUnit {
    public fn instr_block(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }

    public fn instr_function(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }

    public fn ensure_instrs(self, want_count: i32) {
        if (want_count <= self.instr_cap) { return; }
        var new_cap = self.instr_cap;
        if (new_cap <= 0) { new_cap = 4096; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.instr_buf, self.instr_count, self.instr_cap, mir_instr_record_size(), want_count);
        if (new_buf == self.instr_buf) { return; }
        self.instr_buf = new_buf;
        self.instr_cap = new_cap;
    }

    public fn instr_record(&self, id: i32) -> rawptr { return mir_record_at(self.instr_buf, id, mir_instr_record_size()); }

    public fn instr_loc_ptr(&self, instr_id: i32) -> rawptr {
        let rec = self.instr_record(instr_id);
        if (rec == null) { return null; }
        return ptr_offset(rec, 80);
    }

    public fn set_instr_loc(self, instr_id: i32, line: i32, col: i32, end_line: i32, end_col: i32) {
        let rec = self.instr_record(instr_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 80), line);
        ast_write_i32(ptr_offset(rec, 84), col);
        ast_write_i32(ptr_offset(rec, 88), end_line);
        ast_write_i32(ptr_offset(rec, 92), end_col);
    }

    public fn add_instr(self,
                        function_id: i32,
                        block_id: i32,
                        kind: i32,
                        type_id: i32,
                        place_id: i32,
                        value_id: i32,
                        lhs_value_id: i32,
                        rhs_value_id: i32,
                        target_kind: i32,
                        target_id: i32,
                        source_stmt_id: i32,
                        source_expr_id: i32,
                        flags: i32,
                        aux: i32,
                        name: string) -> i32 {
        let id = self.ids.alloc_instr();
        self.ensure_instrs(id);
        let rec = self.instr_record(id);
        if (rec == null) { return mir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), block_id);
        ast_write_i32(ptr_offset(rec, 12), kind);
        ast_write_i32(ptr_offset(rec, 16), type_id);
        ast_write_i32(ptr_offset(rec, 20), place_id);
        ast_write_i32(ptr_offset(rec, 24), value_id);
        ast_write_i32(ptr_offset(rec, 28), lhs_value_id);
        ast_write_i32(ptr_offset(rec, 32), rhs_value_id);
        ast_write_i32(ptr_offset(rec, 36), target_kind);
        ast_write_i32(ptr_offset(rec, 40), target_id);
        ast_write_i32(ptr_offset(rec, 44), source_stmt_id);
        ast_write_i32(ptr_offset(rec, 48), source_expr_id);
        ast_write_i32(ptr_offset(rec, 52), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 56), flags);
        ast_write_i32(ptr_offset(rec, 60), aux);
        mir_write_string(rec, 64, 72, name);
        ast_write_i32(ptr_offset(rec, 80), 0);
        ast_write_i32(ptr_offset(rec, 84), 0);
        ast_write_i32(ptr_offset(rec, 88), 0);
        ast_write_i32(ptr_offset(rec, 92), 0);
        if (block_id != mir_id_invalid()) {
            let block_rec = self.block_record(block_id);
            if (block_rec != null) {
                let first = ast_read_i32(ptr_offset(block_rec, 8));
                let last = ast_read_i32(ptr_offset(block_rec, 12));
                if (first == mir_id_invalid()) { ast_write_i32(ptr_offset(block_rec, 8), id); }
                if (last != mir_id_invalid()) {
                    let last_rec = self.instr_record(last);
                    if (last_rec != null) { ast_write_i32(ptr_offset(last_rec, 52), id); }
                }
                ast_write_i32(ptr_offset(block_rec, 12), id);
                var instr_count = ast_read_i32(ptr_offset(block_rec, 16));
                instr_count = instr_count + 1;
                ast_write_i32(ptr_offset(block_rec, 16), instr_count);
            }
        }
        if (id > self.instr_count) { self.instr_count = id; }
        return id;
    }

    public fn instr_kind(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }

    public fn instr_type(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }

    public fn instr_lhs(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }

    public fn instr_rhs(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 32)); }

    public fn instr_target_kind(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 36)); }

    public fn instr_target_id(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 40)); }

    public fn instr_source_stmt(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 44)); }

    public fn instr_source_expr(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 48)); }

    public fn instr_next(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 52)); }

    public fn instr_flags(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 56)); }

    public fn instr_aux(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 60)); }

    public fn instr_name(&self, id: i32) -> string { return mir_read_string(self.instr_record(id), 64, 72); }

    public fn instr_loc_line(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 80)); }

    public fn instr_loc_col(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 84)); }

    public fn instr_loc_end_line(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 88)); }

    public fn instr_loc_end_col(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 92)); }

    public fn instr_place(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }

    public fn set_instr_value(self, instr_id: i32, value_id: i32) -> bool {
        if (instr_id < 1 || instr_id > self.instr_count
            || value_id < 1 || value_id > self.value_count) { return false; }
        let rec = self.instr_record(instr_id);
        let value_rec = self.value_record(value_id);
        if (rec == null || value_rec == null
            || ast_read_i32(rec) != instr_id
            || ast_read_i32(value_rec) != value_id) { return false; }
        let function_id = self.instr_function(instr_id);
        let block_id = self.instr_block(instr_id);
        if (function_id == mir_id_invalid()
            || block_id < 1 || block_id > self.block_count
            || self.block_record(block_id) == null
            || ast_read_i32(self.block_record(block_id)) != block_id
            || self.block_function(block_id) != function_id
            || self.block_is_removed(block_id)) { return false; }
        let old_value_id = self.instr_value(instr_id);
        if (old_value_id < 1 || old_value_id > self.value_count
            || self.value_record(old_value_id) == null
            || ast_read_i32(self.value_record(old_value_id)) != old_value_id
            || self.value_function(value_id) != function_id
            || self.value_function(old_value_id) != function_id
            || self.value_type(value_id) != self.value_type(old_value_id)) { return false; }
        let instr_type_id = self.instr_type(instr_id);
        if (instr_type_id != mir_id_invalid()
            && self.value_type(value_id) != instr_type_id) { return false; }
        ast_write_i32(ptr_offset(rec, 24), value_id);
        return true;
    }

    // An eliminated expression statement remains in the stable instruction
    // chain as an eval tombstone. Its source location stays available for
    // dumps, while an empty value makes both lowering and use-def treat it as
    // a semantic no-op.
    public fn clear_eval_instr_value(self, instr_id: i32) -> bool {
        if (instr_id < 1 || instr_id > self.instr_count) { return false; }
        let rec = self.instr_record(instr_id);
        if (rec == null || ast_read_i32(rec) != instr_id
            || self.instr_kind(instr_id) != mir_instr_eval()) { return false; }
        let function_id = self.instr_function(instr_id);
        let block_id = self.instr_block(instr_id);
        if (function_id == mir_id_invalid()
            || block_id < 1 || block_id > self.block_count
            || self.block_record(block_id) == null
            || ast_read_i32(self.block_record(block_id)) != block_id
            || self.block_function(block_id) != function_id
            || self.block_is_removed(block_id)
            || self.instr_value(instr_id) == mir_id_invalid()) {
            return false;
        }
        ast_write_i32(ptr_offset(rec, 24), mir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), mir_target_none());
        ast_write_i32(ptr_offset(rec, 40), mir_id_invalid());
        return true;
    }

    public fn instr_value(&self, id: i32) -> i32 { let r = self.instr_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
}
