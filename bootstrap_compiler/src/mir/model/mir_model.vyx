public fn mir_unit_set_dci_abi_text(m: &mut MirUnit, text: string) {
    m.set_dci_abi_text(text);
}

public fn mir_unit_dci_abi_text(m: &MirUnit) -> string {
    return m.dci_abi_text;
}

public fn mir_unit_set_dci_abi_source(m: &mut MirUnit,
                                      text: string,
                                      path: string,
                                      is_binary: bool) {
    m.set_dci_abi_source(text, path, is_binary);
}

public fn mir_unit_dci_abi_path(m: &MirUnit) -> string {
    return m.dci_abi_path;
}

public fn mir_unit_dci_abi_is_binary(m: &MirUnit) -> bool {
    return m.dci_abi_is_binary;
}

public fn mir_unit_has_dci_abi(m: &MirUnit) -> bool {
    return m.dci_abi_text.len > 0 || m.dci_abi_path.len > 0;
}

public fn mir_unit_set_interface_supers(m: &mut MirUnit, supers: string) {
    m.set_interface_supers(supers);
}

public fn mir_unit_interface_supers(m: &MirUnit) -> string {
    return m.interface_supers;
}

public fn mir_unit_discard_recent_body_records(m: &mut MirUnit,
                                               function_id: i32,
                                               block_mark: i32,
                                               local_mark: i32,
                                               place_mark: i32,
                                               value_mark: i32,
                                               instr_mark: i32,
                                               case_mark: i32) {
    m.discard_recent_body_records(function_id,
                                  block_mark,
                                  local_mark,
                                  place_mark,
                                  value_mark,
                                  instr_mark,
                                  case_mark);
}

public fn mir_unit_reflection_name_map(m: &MirUnit) -> string {
    return m.reflection_name_map;
}
