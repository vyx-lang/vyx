module bootstrap.mir_ids;

public fn mir_id_invalid() -> i32 { return 0; }

public fn mir_place_local() -> i32 { return 1; }
public fn mir_place_field() -> i32 { return 2; }
public fn mir_place_deref() -> i32 { return 3; }
public fn mir_place_index() -> i32 { return 4; }
public fn mir_place_static() -> i32 { return 5; }

public fn mir_value_const_int() -> i32 { return 1; }
public fn mir_value_const_bool() -> i32 { return 2; }
public fn mir_value_const_str() -> i32 { return 3; }
public fn mir_value_const_char() -> i32 { return 4; }
public fn mir_value_null() -> i32 { return 5; }
public fn mir_value_read_place() -> i32 { return 6; }
public fn mir_value_address_of() -> i32 { return 7; }
public fn mir_value_unary() -> i32 { return 8; }
public fn mir_value_binary() -> i32 { return 9; }
public fn mir_value_call() -> i32 { return 10; }
public fn mir_value_target_ref() -> i32 { return 11; }
public fn mir_value_aggregate() -> i32 { return 12; }
public fn mir_value_cast() -> i32 { return 13; }
public fn mir_value_control_result() -> i32 { return 14; }
public fn mir_value_intrinsic() -> i32 { return 15; }
public fn mir_value_const_float() -> i32 { return 16; }
public fn mir_value_arg() -> i32 { return 17; }

public fn mir_instr_eval() -> i32 { return 1; }
public fn mir_instr_assign() -> i32 { return 2; }
public fn mir_instr_storage_live() -> i32 { return 3; }
public fn mir_instr_static_assert() -> i32 { return 4; }
public fn mir_instr_defer() -> i32 { return 5; }
public fn mir_instr_foreach_bind() -> i32 { return 6; }
public fn mir_instr_match_arm() -> i32 { return 7; }
public fn mir_instr_drop() -> i32 { return 8; }
public fn mir_instr_storage_dead() -> i32 { return 9; }

public fn mir_term_return() -> i32 { return 1; }
public fn mir_term_goto() -> i32 { return 2; }
public fn mir_term_branch() -> i32 { return 3; }
public fn mir_term_match() -> i32 { return 4; }
public fn mir_term_foreach_next() -> i32 { return 5; }
public fn mir_term_unreachable() -> i32 { return 6; }
public fn mir_term_yield() -> i32 { return 7; }

public fn mir_target_none() -> i32 { return 0; }
public fn mir_target_function() -> i32 { return 1; }
public fn mir_target_hir_item() -> i32 { return 2; }
public fn mir_target_hir_field() -> i32 { return 3; }
public fn mir_target_hir_variant() -> i32 { return 4; }
public fn mir_target_builtin() -> i32 { return 5; }
public fn mir_target_local() -> i32 { return 6; }
public fn mir_target_type() -> i32 { return 7; }

public fn mir_static_init_none() -> i32 { return 0; }
public fn mir_static_init_int() -> i32 { return 1; }
public fn mir_static_init_bool() -> i32 { return 2; }
public fn mir_static_init_char() -> i32 { return 3; }
public fn mir_static_init_str() -> i32 { return 4; }
public fn mir_static_init_null() -> i32 { return 5; }
public fn mir_static_init_item_ref() -> i32 { return 6; }

/// External storage is a declaration even when an interface carries its
/// initializer for constant evaluation. Exported storage is an owned root.
public fn mir_static_flag_external() -> i32 { return 1; }
public fn mir_static_flag_exported() -> i32 { return 2; }
public fn mir_static_flag_odr() -> i32 { return 4; }

public fn mir_local_flag_param() -> i32 { return 1; }
public fn mir_local_flag_capture() -> i32 { return 2; }
public fn mir_local_flag_auto_drop() -> i32 { return 8; }
public fn mir_local_flag_move_arg() -> i32 { return 16; }
public fn mir_local_flag_self_receiver() -> i32 { return 32; }
public fn mir_local_flag_reference_capture() -> i32 { return 64; }
public fn mir_local_flag_if_expr_result() -> i32 { return 128; }
public fn mir_local_flag_self_shared_ref() -> i32 { return 256; }
public fn mir_local_flag_self_mut_ref() -> i32 { return 512; }
public fn mir_local_flag_self_compat() -> i32 { return 1024; }
// Bit 2048 was the removed automatic class-storage planner flag; native
// `class` is now a value type by default, so the flag and its planner are
// gone.  The value is intentionally left unallocated to keep the remaining
// bit values stable.

public fn mir_block_flag_removed() -> i32 { return 1; }

// The local is declared `volatile` (propagated from HIR local flags).
public fn mir_local_flag_volatile() -> i32 { return 4096; }

public fn mir_value_flag_move_arg() -> i32 { return 65536; }

// Place check-policy field (idle i32 slot at place record offset 36).
// inline    = emit the checked-address audit at every access (default).
// unchecked = the access is lexically inside an `unsafe { ... }` block; the
//             user explicitly opted out of the region/bounds audit, so
//             backends emit a raw address with no runtime check.
public fn mir_check_policy_inline() -> i32 { return 0; }
public fn mir_check_policy_unchecked() -> i32 { return 1; }

public class MirIdAllocator {
    public next_function_id: i32
    public next_block_id: i32
    public next_local_id: i32
    public next_place_id: i32
    public next_value_id: i32
    public next_instr_id: i32
    public next_case_id: i32

    public static fn create() -> MirIdAllocator {
        return MirIdAllocator {
            next_function_id: 1,
            next_block_id: 1,
            next_local_id: 1,
            next_place_id: 1,
            next_value_id: 1,
            next_instr_id: 1,
            next_case_id: 1
        };
    }

    public fn alloc_function(self) -> i32 {
        let id = self.next_function_id;
        self.next_function_id = self.next_function_id + 1;
        return id;
    }

    public fn alloc_block(self) -> i32 {
        let id = self.next_block_id;
        self.next_block_id = self.next_block_id + 1;
        return id;
    }

    public fn alloc_local(self) -> i32 {
        let id = self.next_local_id;
        self.next_local_id = self.next_local_id + 1;
        return id;
    }

    public fn alloc_place(self) -> i32 {
        let id = self.next_place_id;
        self.next_place_id = self.next_place_id + 1;
        return id;
    }

    public fn alloc_value(self) -> i32 {
        let id = self.next_value_id;
        self.next_value_id = self.next_value_id + 1;
        return id;
    }

    public fn alloc_instr(self) -> i32 {
        let id = self.next_instr_id;
        self.next_instr_id = self.next_instr_id + 1;
        return id;
    }

    public fn alloc_case(self) -> i32 {
        let id = self.next_case_id;
        self.next_case_id = self.next_case_id + 1;
        return id;
    }
}

public fn mir_id_alloc_function(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_function(); }
public fn mir_id_alloc_block(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_block(); }
public fn mir_id_alloc_local(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_local(); }
public fn mir_id_alloc_place(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_place(); }
public fn mir_id_alloc_value(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_value(); }
public fn mir_id_alloc_instr(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_instr(); }
public fn mir_id_alloc_case(ids: &mut MirIdAllocator) -> i32 { return ids.alloc_case(); }
