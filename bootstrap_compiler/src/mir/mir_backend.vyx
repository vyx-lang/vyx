module bootstrap.mir_backend;

use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;

/// Canonical MIR backend type facts.
///
/// This module owns target-independent classification.  C++ and LLVM may
/// choose different representation text or builder operations, but they must
/// ask this layer the same questions about a MIR type.

public fn mir_backend_type_kind(m: &MirUnit, type_id: i32) -> i32 {
    if (type_id == mir_id_invalid()) { return ty_VOID(); }
    return hir_type_table_kind(m.types, type_id);
}

public fn mir_backend_type_text(m: &MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid()) { return ""; }
    return hir_type_table_text(m.types, type_id);
}

public fn mir_backend_int_bits_for_kind(kind: i32) -> i32 {
    if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 8; }
    if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32()) { return 32; }
    if (kind == ty_I16() || kind == ty_U16()) { return 16; }
    if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()) { return 64; }
    return 0;
}

public fn mir_backend_kind_unsigned(kind: i32) -> bool {
    if (kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()) { return true; }
    return kind == ty_USIZE() || kind == ty_BOOL() || kind == ty_CHAR();
}

public fn mir_backend_kind_decimal_unsigned(kind: i32) -> bool {
    return kind != ty_BOOL() && kind != ty_CHAR() && mir_backend_kind_unsigned(kind);
}

public fn mir_backend_kind_float(kind: i32) -> bool {
    return kind == ty_F32() || kind == ty_F64();
}

public fn mir_backend_float_bits_for_kind(kind: i32) -> i32 {
    if (kind == ty_F32()) { return 32; }
    if (kind == ty_F64()) { return 64; }
    return 0;
}

public fn mir_backend_kind_pointer_like(kind: i32) -> bool {
    if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return true; }
    return kind == ty_FN() || kind == ty_CFN();
}

public fn mir_backend_kind_pointer_handle(kind: i32) -> bool {
    return kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF();
}

public fn mir_backend_kind_numeric(kind: i32) -> bool {
    return mir_backend_int_bits_for_kind(kind) > 0 || mir_backend_kind_float(kind);
}

public fn mir_backend_kind_scalar_abi(kind: i32) -> bool {
    return mir_backend_kind_numeric(kind) || mir_backend_kind_pointer_like(kind);
}
