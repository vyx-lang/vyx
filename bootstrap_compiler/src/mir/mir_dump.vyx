module bootstrap.mir_dump;

use bootstrap.hir_type_table;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.policy;

public class MirDumper {
    public enabled: bool

    public static fn create() -> MirDumper {
        return MirDumper { enabled: true };
    }

    public fn id_text(self, id: i32) -> string {
        return policy_i64_to_string(id as i64);
    }

    public fn type_text(self, m: MirUnit, id: i32) -> string {
        if (id == mir_id_invalid()) { return "-"; }
        return "#" + self.id_text(id) + ":" + hir_type_table_text(m.types, id);
    }

    public fn dump_functions(self, m: MirUnit) {
        print("mir2.functions " + self.id_text(m.function_count));
        var id: i32 = 1;
        while (id <= m.function_count) {
            print("  fn #" + self.id_text(id)
                  + " hir_fn=#" + self.id_text(m.function_hir_id(id))
                  + " hir_item=#" + self.id_text(m.function_hir_item(id))
                  + " name=" + m.function_name(id)
                  + " ret=" + self.type_text(m, m.function_return_type(id))
                  + " params=" + m.function_generic_params(id)
                  + " args=" + m.function_generic_args(id)
                  + " owner_type=" + m.function_owner_type(id)
                  + " owner_kind=" + self.id_text(m.function_owner_item_kind(id))
                  + " first_local=#" + self.id_text(m.function_first_local(id))
                  + " local_count=" + self.id_text(m.function_local_count(id))
                  + " first_block=#" + self.id_text(m.function_first_block(id))
                  + " block_count=" + self.id_text(m.function_block_count(id))
                  + " flags=" + self.id_text(m.function_flags(id)));
            id = id + 1;
        }
    }

    public fn dump_blocks(self, m: MirUnit) {
        print("mir2.blocks " + self.id_text(m.block_count));
        var id: i32 = 1;
        while (id <= m.block_count) {
            print("  block #" + self.id_text(id)
                  + " fn=#" + self.id_text(m.block_function(id))
                  + " removed=" + self.id_text(if (m.block_is_removed( id)) { 1 } else { 0 })
                  + " first_instr=#" + self.id_text(m.block_first_instr(id))
                  + " last_instr=#" + self.id_text(m.block_last_instr(id))
                  + " instr_count=" + self.id_text(m.block_instr_count(id))
                  + " term=" + self.id_text(m.block_term_kind(id))
                  + " term_value=#" + self.id_text(m.block_term_value(id))
                  + " target=#" + self.id_text(m.block_term_target(id))
                  + " false=#" + self.id_text(m.block_term_false(id))
                  + " first_case=#" + self.id_text(m.block_term_first_case(id))
                  + " source_stmt=#" + self.id_text(m.block_source_stmt(id))
                  + " aux=#" + self.id_text(m.block_term_aux(id))
                  + " next=#" + self.id_text(m.block_next(id)));
            id = id + 1;
        }
    }

    public fn dump_locals(self, m: MirUnit) {
        print("mir2.locals " + self.id_text(m.local_count));
        var id: i32 = 1;
        while (id <= m.local_count) {
            print("  local #" + self.id_text(id)
                  + " fn=#" + self.id_text(m.local_function(id))
                  + " hir_local=#" + self.id_text(m.local_hir_id(id))
                  + " name=" + m.local_name(id)
                  + " type=" + self.type_text(m, m.local_type(id))
                  + " flags=" + self.id_text(m.local_flags(id))
                  + " place=#" + self.id_text(m.local_place(id))
                  + " capture_source=#" + self.id_text(m.local_capture_source(id))
                  + " capture_init=#" + self.id_text(m.local_capture_init_value(id))
                  + " next=#" + self.id_text(m.local_next(id)));
            id = id + 1;
        }
    }

    public fn dump_fields(self, m: MirUnit) {
        print("mir2.fields " + self.id_text(m.field_count));
        var id: i32 = 1;
        while (id <= m.field_count) {
            print("  field #" + self.id_text(id)
                  + " owner_item=#" + self.id_text(m.field_owner_item(id))
                  + " owner_type=" + self.type_text(m, m.field_owner_type(id))
                  + " type=" + self.type_text(m, m.field_type(id))
                  + " index=" + self.id_text(m.field_index(id))
                  + " name=" + m.field_name(id));
            id = id + 1;
        }
    }

    public fn dump_static_init(self, m: MirUnit, id: i32) -> string {
        let k = m.static_init_kind(id);
        if (k == mir_static_init_int()) {
            return "int(" + policy_i64_to_string(m.static_init_int(id)) + ")";
        }
        if (k == mir_static_init_bool()) {
            return "bool(" + policy_i64_to_string(m.static_init_int(id)) + ")";
        }
        if (k == mir_static_init_char()) {
            return "char(" + policy_i64_to_string(m.static_init_int(id)) + ")";
        }
        if (k == mir_static_init_str()) {
            return "str(" + m.static_init_text(id) + ")";
        }
        if (k == mir_static_init_null()) {
            return "null";
        }
        if (k == mir_static_init_item_ref()) {
            return "item_ref(kind=" + self.id_text(m.static_init_target_kind(id))
                + ", id=#" + self.id_text(m.static_init_target_id(id)) + ")";
        }
        return "invalid(" + self.id_text(k) + ")";
    }

    public fn dump_statics(self, m: MirUnit) {
        print("mir2.statics " + self.id_text(m.static_count));
        var id: i32 = 1;
        while (id <= m.static_count) {
            if (m.static_exists(id)) {
                print("  static #" + self.id_text(id)
                      + " item_kind=" + self.id_text(m.static_item_kind(id))
                      + " name=" + m.static_name(id)
                      + " type=" + self.type_text(m, m.static_type(id))
                      + " init=" + self.dump_static_init(m, id));
            }
            id = id + 1;
        }
    }

    public fn dump_places(self, m: MirUnit) {
        print("mir2.places " + self.id_text(m.place_count));
        var id: i32 = 1;
        while (id <= m.place_count) {
            print("  place #" + self.id_text(id)
                  + " fn=#" + self.id_text(m.place_function(id))
                  + " kind=" + self.id_text(m.place_kind(id))
                  + " type=" + self.type_text(m, m.place_type(id))
                  + " local=#" + self.id_text(m.place_local(id))
                  + " base=#" + self.id_text(m.place_base(id))
                  + " field=#" + self.id_text(m.place_field(id))
                  + " index_value=#" + self.id_text(m.place_index_value(id))
                  + " source_expr=#" + self.id_text(m.place_source_expr(id))
                  + " name=" + m.place_name(id));
            id = id + 1;
        }
    }

    public fn dump_values(self, m: MirUnit) {
        print("mir2.values " + self.id_text(m.value_count));
        var id: i32 = 1;
        while (id <= m.value_count) {
            print("  value #" + self.id_text(id)
                  + " fn=#" + self.id_text(m.value_function(id))
                  + " kind=" + self.id_text(m.value_kind(id))
                  + " type=" + self.type_text(m, m.value_type(id))
                  + " place=#" + self.id_text(m.value_place(id))
                  + " lhs=#" + self.id_text(m.value_lhs(id))
                  + " rhs=#" + self.id_text(m.value_rhs(id))
                  + " aux=#" + self.id_text(m.value_aux(id))
                  + " first_arg=#" + self.id_text(m.value_first_arg(id))
                  + " next_arg=#" + self.id_text(m.value_next_arg(id))
                  + " target_kind=" + self.id_text(m.value_target_kind(id))
                  + " target=#" + self.id_text(m.value_target_id(id))
                  + " source_expr=#" + self.id_text(m.value_source_expr(id))
                  + " flags=" + self.id_text(m.value_flags(id))
                  + " op=" + self.id_text(m.value_op(id))
                  + " aggregate_field=#" + self.id_text(m.value_aggregate_field(id))
                  + " int=" + policy_i64_to_string(m.value_int(id))
                  + " name=" + m.value_name(id)
                  + " text=" + m.value_text(id));
            id = id + 1;
        }
    }

    public fn dump_instrs(self, m: MirUnit) {
        print("mir2.instrs " + self.id_text(m.instr_count));
        var id: i32 = 1;
        while (id <= m.instr_count) {
            if (mir_unit_instr_owner_is_removed(&m,  id)) {
                id = id + 1;
                continue;
            }
            print("  instr #" + self.id_text(id)
                  + " fn=#" + self.id_text(m.instr_function(id))
                  + " block=#" + self.id_text(m.instr_block(id))
                  + " kind=" + self.id_text(m.instr_kind(id))
                  + " type=" + self.type_text(m, m.instr_type(id))
                  + " place=#" + self.id_text(m.instr_place(id))
                  + " value=#" + self.id_text(m.instr_value(id))
                  + " lhs=#" + self.id_text(m.instr_lhs(id))
                  + " rhs=#" + self.id_text(m.instr_rhs(id))
                  + " target_kind=" + self.id_text(m.instr_target_kind(id))
                  + " target=#" + self.id_text(m.instr_target_id(id))
                  + " source_stmt=#" + self.id_text(m.instr_source_stmt(id))
                  + " source_expr=#" + self.id_text(m.instr_source_expr(id))
                  + " flags=" + self.id_text(m.instr_flags(id))
                  + " aux=#" + self.id_text(m.instr_aux(id))
                  + " next=#" + self.id_text(m.instr_next(id))
                  + " name=" + m.instr_name(id));
            id = id + 1;
        }
    }

    public fn dump_cases(self, m: MirUnit) {
        print("mir2.cases " + self.id_text(m.case_count));
        var id: i32 = 1;
        while (id <= m.case_count) {
            if (!mir_unit_case_is_active(&m,  id)) {
                id = id + 1;
                continue;
            }
            print("  case #" + self.id_text(id)
                  + " owner_block=#" + self.id_text(m.case_owner_block(id))
                  + " pattern=#" + self.id_text(m.case_pattern_value(id))
                  + " guard=#" + self.id_text(m.case_guard_value(id))
                  + " target_block=#" + self.id_text(m.case_target_block(id))
                  + " source_stmt=#" + self.id_text(m.case_source_stmt(id))
                  + " next=#" + self.id_text(m.case_next(id))
                  + " text=" + m.case_text(id));
            id = id + 1;
        }
    }

    public fn run(self, m: MirUnit) {
        print("mir2.unit functions=" + self.id_text(m.function_count)
              + " blocks=" + self.id_text(m.block_count)
              + " locals=" + self.id_text(m.local_count)
              + " places=" + self.id_text(m.place_count)
              + " values=" + self.id_text(m.value_count)
              + " instrs=" + self.id_text(m.instr_count)
              + " cases=" + self.id_text(m.case_count)
              + " types=" + self.id_text(m.types.count));
        self.dump_functions(m);
        self.dump_blocks(m);
        self.dump_locals(m);
        self.dump_fields(m);
        self.dump_statics(m);
        self.dump_places(m);
        self.dump_values(m);
        self.dump_instrs(m);
        self.dump_cases(m);
    }
}

public fn mir_dump_unit(m: MirUnit) {
    let dumper = MirDumper.create();
    dumper.run(m);
}
