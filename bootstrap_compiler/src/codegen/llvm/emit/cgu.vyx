module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn cgu_intern_key(self, key: string) -> i32 {
        var id: i32 = 1;
        var start: i32 = 0;
        var i: i32 = 0;
        let table = self.cgu_key_table;
        while (i <= table.len) {
            if (i == table.len || table.charAt(i) == 10) {
                if (i > start) {
                    if (table.substring(start, i) == key) { return id; }
                    id = id + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        self.cgu_key_table = self.cgu_key_table + key + "\n";
        return id;
    }

    public fn function_cgu_key(self, function_id: i32) -> string {
        let disc = mir_unit_function_symbol_discriminator(&self.m, function_id);
        if (disc.len >= 7 && disc.substring(0, 7) == "source=") {
            var end: i32 = 7;
            while (end < disc.len) {
                if (disc.charAt(end) == 124) { break; }
                end = end + 1;
            }
            let src = disc.substring(7, end);
            if (src.len > 0) { return src; }
        }
        if (self.debug_source_path.len > 0) { return self.debug_source_path; }
        return self.module_symbol_name;
    }

    public fn cgu_grow_collected(self) {
        var next = self.cgu_collected_cap * 2;
        if (next < 64) { next = 64; }
        let bytes = (next * 4) as u64;
        let ids = malloc(bytes);
        let sizes = malloc(bytes);
        let keys = malloc(bytes);
        let sig_off = malloc(bytes);
        let marks = malloc((next * CGU_RETAIN_STRIDE * 4) as u64);
        if (ids != null) { memset(ids, 0, bytes); }
        if (sizes != null) { memset(sizes, 0, bytes); }
        if (keys != null) { memset(keys, 0, bytes); }
        if (marks != null) { memset(marks, 0, (next * CGU_RETAIN_STRIDE * 4) as u64); }
        // 0xFF per byte is -1 per i32: "no signature snapshot for this slot".
        if (sig_off != null) { memset(sig_off, 255, bytes); }
        if (self.cgu_collected_ids != null && ids != null) {
            memcpy(ids, self.cgu_collected_ids, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_ids);
        }
        if (self.cgu_collected_sizes != null && sizes != null) {
            memcpy(sizes, self.cgu_collected_sizes, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_sizes);
        }
        if (self.cgu_collected_keys != null && keys != null) {
            memcpy(keys, self.cgu_collected_keys, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_keys);
        }
        if (self.dyn_sig_off != null && sig_off != null) {
            memcpy(sig_off, self.dyn_sig_off, (self.cgu_collected_n * 4) as u64);
            free(self.dyn_sig_off);
        }
        if (self.cgu_retain_marks != null && marks != null) {
            memcpy(marks, self.cgu_retain_marks,
                   (self.cgu_collected_n * CGU_RETAIN_STRIDE * 4) as u64);
            free(self.cgu_retain_marks);
        }
        self.cgu_collected_ids = ids;
        self.cgu_collected_sizes = sizes;
        self.cgu_collected_keys = keys;
        self.cgu_retain_marks = marks;
        self.dyn_sig_off = sig_off;
        self.cgu_collected_cap = next;
    }

    public fn grow_dyn_sig_buf(self, min_need: i32) {
        var next = self.dyn_sig_cap * 2;
        if (next < 256) { next = 256; }
        while (next < min_need) { next = next * 2; }
        let bytes = (next * 4) as u64;
        let buf = malloc(bytes);
        if (buf == null) { return; }
        if (self.dyn_sig_buf != null) {
            memcpy(buf, self.dyn_sig_buf, (self.dyn_sig_n * 4) as u64);
            free(self.dyn_sig_buf);
        }
        self.dyn_sig_buf = buf;
        self.dyn_sig_cap = next;
    }

    // Snapshot `[arity, param0_type, param1_type, ...]` for one partition slot.
    // Runs while the body is still materialized (immediately before the body is
    // released), which is the only point where the parameter locals of a
    // function owned by another unit can be read safely.
    public fn cgu_record_dyn_signature(self, slot: i32, function_id: i32) {
        if (self.dyn_sig_off == null) { return; }
        if (self.cgu_shell_sweep) { return; }
        var arity = self.function_source_param_count(function_id);
        if (arity < 1) { arity = 0; }
        let need = arity + 1;
        if (self.dyn_sig_buf == null || self.dyn_sig_n + need > self.dyn_sig_cap) {
            self.grow_dyn_sig_buf(self.dyn_sig_n + need);
            if (self.dyn_sig_buf == null) { return; }
        }
        let base = self.dyn_sig_n;
        ast_write_i32(ptr_offset(self.dyn_sig_buf, base * 4), arity);
        var i: i32 = 0;
        while (i < arity) {
            ast_write_i32(ptr_offset(self.dyn_sig_buf, (base + 1 + i) * 4),
                          self.function_source_param_type(function_id, i));
            i = i + 1;
        }
        self.dyn_sig_n = base + need;
        ast_write_i32(ptr_offset(self.dyn_sig_off, slot * 4), base);
    }

    // Index one partition slot under its method name for the `dyn` fallback.
    // The index stores `slot + 1` -- everything downstream needs the slot, not
    // just the function id, because the signature snapshot lives in a parallel
    // array -- and slot 0 has to survive the index's "id 0 means empty" guard.
    // Reached either from the one-shot pass below or incrementally from
    // `cgu_record_function`, which de-duplicates through `cgu_member_map`, so a
    // slot is never indexed twice.  Walking the whole partition on every lookup
    // is what made an earlier version of this fallback exhaust the string pool
    // while compiling the compiler.
    public fn remember_dyn_partition_slot(self, slot: i32) {
        if (self.dyn_partition_index == null) { return; }
        if (self.cgu_collected_ids == null) { return; }
        if (slot < 0 || slot >= self.cgu_collected_n) { return; }
        let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
        if (fn_id == mir_id_invalid()) { return; }
        if (mir_unit_function_owner_item_kind(&self.m, fn_id) == hir_item_interface()) { return; }
        let method_name = self.function_method_name(fn_id);
        if (method_name.len == 0) { return; }
        llvm_mir_method_candidate_index_put(self.dyn_partition_index,
                                            self.dyn_partition_index_cap,
                                            method_name,
                                            slot + 1);
    }

    // Fold any not-yet-indexed partition slots into `dyn_partition_index`.  The
    // index is built lazily so a build that never needs the `dyn` fallback pays
    // nothing, and it is extended incrementally so a lookup never rescans the
    // slots it has already seen.  Only the function *record* is read here (name,
    // owner, item kind); signatures come from `dyn_sig_off`, which was filled in
    // at record time while the bodies were still live.
    public fn ensure_dyn_partition_index(self) {
        if (self.dyn_partition_index == null || self.cgu_collected_ids == null) { return; }
        while (self.dyn_partition_index_n < self.cgu_collected_n) {
            self.remember_dyn_partition_slot(self.dyn_partition_index_n);
            self.dyn_partition_index_n = self.dyn_partition_index_n + 1;
        }
    }

    // Returns the collected slot the function was given, or -1 when it was not
    // recorded (invalid id, already a member, or the arrays could not grow).
    public fn cgu_record_function(self, function_id: i32, instr_delta: i32) -> i32 {
        if (function_id == mir_id_invalid()) { return -1; }
        if (llvm_mir_i32_map_get(self.cgu_member_map, function_id) != 0) { return -1; }
        if (self.cgu_collected_n >= self.cgu_collected_cap) { self.cgu_grow_collected(); }
        if (self.cgu_collected_ids == null) { return -1; }
        var size = instr_delta;
        if (size < 1) { size = 1; }
        let key_id = self.cgu_intern_key(self.function_cgu_key(function_id));
        ast_write_i32(ptr_offset(self.cgu_collected_ids, self.cgu_collected_n * 4), function_id);
        ast_write_i32(ptr_offset(self.cgu_collected_sizes, self.cgu_collected_n * 4), size);
        ast_write_i32(ptr_offset(self.cgu_collected_keys, self.cgu_collected_n * 4), key_id);
        self.cgu_collected_n = self.cgu_collected_n + 1;
        llvm_mir_i32_map_put(self.cgu_member_map, function_id, 1);
        // Snapshot the parameter signature right here: this is the last moment
        // at which the body is still materialized, and a body registered for a
        // sibling unit is released before that unit's `dyn` vtables are lowered.
        self.cgu_record_dyn_signature(self.cgu_collected_n - 1, function_id);
        if (policy_phase_summary_enabled() && ((self.cgu_collected_n % 256) == 0)) {
            print("[llvm-cgu] collect-fns=" + policy_i64_to_string(self.cgu_collected_n as i64));
        }
        return self.cgu_collected_n - 1;
    }

    // Collect walk: may this body be released, or must it stay in the arena
    // for the emit walk?
    //
    // The emit walk rebuilds every released body from its provenance, so a body
    // that has no provenance cannot be released -- the loss is permanent and
    // the emit walk then fails with `I0100 ... still unavailable after
    // streaming deferred retries`.  A lambda's synthesized `closure$N`
    // function is exactly such a body: it was built inline from the enclosing
    // expression and never had a declaration of its own.  `VYX_CGU_RETAIN=1`
    // turns the retention on for the whole unit; this keeps it to the bodies
    // that actually need it.
    public fn cgu_must_retain_collected_body(self, builder: &mut MirUnitBuilder, fn_id: i32) -> bool {
        if (self.cgu_retain_bodies) { return true; }
        let hir_fn = builder.unit.function_hir_id(fn_id);
        if (hir_fn == hir_id_invalid()) { return false; }
        return !builder.hir_function_body_is_recoverable(hir_fn);
    }

    // Must an otherwise releasable body be kept anyway, because something
    // retained was built inside it?
    //
    // The arena is a stack: a nested function's region sits directly above the
    // region of the body whose build pulled it in, and both share the same
    // tables.  `discard_recent_body_records` rewinds every counter to the
    // released body's *start* marks and zeroes every record above them, so
    // releasing an enclosing body destroys any retained body inside it; the
    // emit walk then copies the frozen marks of a region that holds nothing and
    // dies with `I0100 ... references invalid block #N`.  `retained_before` is
    // `cgu_retain_count` as it stood before this body was built, so a change
    // means a retained body lies inside this one and this body has to survive
    // until the emit walk is done -- regardless of whether *itself* it could
    // have been rebuilt from provenance.
    public fn cgu_must_retain_enclosing_body(self, retained_before: i32) -> bool {
        return self.cgu_retain_count != retained_before;
    }

    // Remember where a collected body lives so the emit walk can reuse it
    // instead of materialising the function again.  The body has to still be in
    // the arena, which is why the emit walk must not release it as it goes.
    // Membership of `cgu_retain_slot` -- not the unit-wide flag -- is what the
    // emit walk and the final release both key off, because
    // `cgu_must_retain_collected_body` can retain a single body on its own.
    public fn cgu_retain_record(self, slot: i32, function_id: i32, rec: rawptr) -> bool {
        if (slot < 0 || self.cgu_retain_marks == null) { return false; }
        if (self.cgu_retain_slot == null) {
            self.cgu_retain_slot = llvm_mir_alloc_i32_map(self.cgu_collected_cap + 1);
            if (self.cgu_retain_slot == null) { return false; }
        }
        let base = ptr_offset(self.cgu_retain_marks,
                              slot * CGU_RETAIN_STRIDE * 4);
        ast_write_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_BLOCK_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_LOCAL_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_PLACE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_VALUE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_INSTR_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_CASE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_CASE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_VALUE_END * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_VALUE_END)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_INSTR_END * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_INSTR_END)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_FUNC_MARK * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_FUNC_MARK)));
        llvm_mir_i32_map_put(self.cgu_retain_slot, function_id, slot + 1);
        self.cgu_retain_count = self.cgu_retain_count + 1;
        return true;
    }

    // True when the collect walk left a body behind for this function, in which
    // case the frozen marks are copied into `rec` and the emit walk can skip
    // straight to the MIR pass.
    public fn cgu_retain_load(self, function_id: i32, rec: rawptr) -> bool {
        if (self.cgu_retain_marks == null || self.cgu_retain_slot == null) { return false; }
        let at = llvm_mir_i32_map_get(self.cgu_retain_slot, function_id);
        if (at <= 0) { return false; }
        let base = ptr_offset(self.cgu_retain_marks, (at - 1) * CGU_RETAIN_STRIDE * 4);
        ast_write_i32(ptr_offset(rec, MIR_SLICE_BLOCK_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_LOCAL_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_PLACE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_VALUE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_INSTR_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_CASE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_CASE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_VALUE_END),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE_END * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_INSTR_END),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR_END * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_FUNC_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_FUNC_MARK * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_RETAINED), 1);
        return true;
    }

    public fn cgu_retain_note_emitted(self, function_id: i32, emitted: bool) {
        if (self.cgu_retain_marks == null || self.cgu_retain_slot == null) { return; }
        let at = llvm_mir_i32_map_get(self.cgu_retain_slot, function_id);
        if (at <= 0) { return; }
        let base = ptr_offset(self.cgu_retain_marks, (at - 1) * CGU_RETAIN_STRIDE * 4);
        if (emitted) {
            ast_write_i32(ptr_offset(base, CGU_RETAIN_EMITTED * 4), 1);
        }
    }

    // Give every retained body back to the arena once the whole emit phase is
    // done.  Bodies are released in reverse collected order: they were
    // materialised as a stack, so releasing from the top is what keeps each
    // `discard` from destroying a body that is still above it.
    public fn cgu_release_retained_bodies(self, builder: &mut MirUnitBuilder) {
        if (self.cgu_retain_marks == null || self.cgu_collected_ids == null) { return; }
        if (self.cgu_retain_slot == null) { return; }
        var i = self.cgu_collected_n - 1;
        while (i >= 0) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            // Only slots that actually kept a body.  `cgu_collect_from_shells`
            // appends functions with no body of their own, and their zeroed
            // marks would rewind the arena to the very bottom.
            if (llvm_mir_i32_map_get(self.cgu_retain_slot, fn_id) != i + 1) {
                i = i - 1;
                continue;
            }
            let base = ptr_offset(self.cgu_retain_marks, i * CGU_RETAIN_STRIDE * 4);
            self.discard_streaming_function_body(builder,
                                                 fn_id,
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_CASE * 4)));
            if (ast_read_i32(ptr_offset(base, CGU_RETAIN_EMITTED * 4)) != 0) {
                builder.unit.set_function_streamed_body_discarded(fn_id, true);
                self.m = builder.unit;
            }
            i = i - 1;
        }
    }

    public fn cgu_collect_from_shells(self, builder: &mut MirUnitBuilder) {
        if (self.cgu_member_map == null) {
            self.cgu_member_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        // Every function this sweep records has already had its body released by
        // the collect-only walk, so its parameter locals cannot be read (see
        // `cgu_shell_sweep` on `cgu_record_dyn_signature`).  Suppress the
        // snapshot instead of walking a dead `local_next` chain.
        self.cgu_shell_sweep = true;
        var fn_id: i32 = 1;
        let n = self.m.function_count;
        while (fn_id <= n) {
            if (builder.function_is_partition_external_root(fn_id)
                || builder.function_is_partition_declaration_only(fn_id)) {
                fn_id = fn_id + 1;
                continue;
            }
            let hir_fn = builder.unit.function_hir_id(fn_id);
            if (hir_fn == hir_id_invalid()) {
                fn_id = fn_id + 1;
                continue;
            }
            let flags = mir_unit_function_flags(&builder.unit, fn_id);
            if ((flags & hir_function_flag_imported_body()) != 0) {
                fn_id = fn_id + 1;
                continue;
            }
            self.cgu_record_function(fn_id, 1);
            fn_id = fn_id + 1;
        }
        self.cgu_shell_sweep = false;
        if (policy_phase_summary_enabled()) {
            print("[llvm-cgu] shells=" + policy_i64_to_string(n as i64)
                  + " collected=" + policy_i64_to_string(self.cgu_collected_n as i64));
        }
    }

    public fn cgu_key_count(self) -> i32 {
        var n: i32 = 0;
        var i: i32 = 0;
        let table = self.cgu_key_table;
        var start: i32 = 0;
        while (i <= table.len) {
            if (i == table.len || table.charAt(i) == 10) {
                if (i > start) { n = n + 1; }
                start = i + 1;
            }
            i = i + 1;
        }
        return n;
    }

    public fn cgu_partition_collected(self, max_units: i32) {
        let key_n = self.cgu_key_count();
        if (self.cgu_member_map == null) {
            self.cgu_member_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        if (self.cgu_static_defined_map == null) {
            self.cgu_static_defined_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        if (key_n <= 0 || self.cgu_collected_n <= 0) {
            self.cgu_unit_count = 1;
            return;
        }
        var limit = max_units;
        if (limit < 1) { limit = 1; }
        let parent = malloc(((key_n + 1) * 4) as u64);
        let key_size = malloc(((key_n + 1) * 4) as u64);
        let dense = malloc(((key_n + 1) * 4) as u64);
        if (parent == null || key_size == null || dense == null) {
            self.cgu_unit_count = 1;
            if (parent != null) { free(parent); }
            if (key_size != null) { free(key_size); }
            if (dense != null) { free(dense); }
            return;
        }
        memset(parent, 0, ((key_n + 1) * 4) as u64);
        memset(key_size, 0, ((key_n + 1) * 4) as u64);
        memset(dense, 0, ((key_n + 1) * 4) as u64);
        var k: i32 = 1;
        while (k <= key_n) {
            ast_write_i32(ptr_offset(parent, k * 4), k);
            k = k + 1;
        }
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let kid = ast_read_i32(ptr_offset(self.cgu_collected_keys, i * 4));
            let sz = ast_read_i32(ptr_offset(self.cgu_collected_sizes, i * 4));
            if (kid > 0 && kid <= key_n) {
                let cur = ast_read_i32(ptr_offset(key_size, kid * 4));
                ast_write_i32(ptr_offset(key_size, kid * 4), cur + sz);
            }
            i = i + 1;
        }
        var alive = key_n;
        while (alive > limit) {
            var best_a: i32 = 0;
            var best_b: i32 = 0;
            var best_sa: i32 = 0;
            var best_sb: i32 = 0;
            k = 1;
            while (k <= key_n) {
                if (llvm_cgu_find_root(parent, k) == k) {
                    let sz = ast_read_i32(ptr_offset(key_size, k * 4));
                    if (best_a == 0 || sz < best_sa) {
                        best_b = best_a;
                        best_sb = best_sa;
                        best_a = k;
                        best_sa = sz;
                    } elif (best_b == 0 || sz < best_sb) {
                        best_b = k;
                        best_sb = sz;
                    }
                }
                k = k + 1;
            }
            if (best_a == 0 || best_b == 0) { break; }
            ast_write_i32(ptr_offset(parent, best_b * 4), best_a);
            ast_write_i32(ptr_offset(key_size, best_a * 4), best_sa + best_sb);
            alive = alive - 1;
        }
        var next_dense: i32 = 1;
        k = 1;
        while (k <= key_n) {
            if (llvm_cgu_find_root(parent, k) == k) {
                ast_write_i32(ptr_offset(dense, k * 4), next_dense);
                next_dense = next_dense + 1;
            }
            k = k + 1;
        }
        self.cgu_unit_count = next_dense - 1;
        if (self.cgu_unit_count < 1) { self.cgu_unit_count = 1; }
        i = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            let kid = ast_read_i32(ptr_offset(self.cgu_collected_keys, i * 4));
            let root = llvm_cgu_find_root(parent, kid);
            var unit = ast_read_i32(ptr_offset(dense, root * 4));
            if (unit < 1) { unit = 1; }
            llvm_mir_i32_map_put(self.cgu_member_map, fn_id, unit);
            i = i + 1;
        }
        free(parent);
        free(key_size);
        free(dense);
    }

    public fn cgu_enqueue_members(self, builder: &mut MirUnitBuilder) {
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            if (llvm_mir_i32_map_get(self.cgu_member_map, fn_id) == self.cgu_emit_index) {
                builder.reset_function_codegen_marks(fn_id);
                builder.mark_function_reachable(fn_id);
            }
            i = i + 1;
        }
    }

    public fn cgu_reset_future_marks(self, builder: &mut MirUnitBuilder) {
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            if (llvm_mir_i32_map_get(self.cgu_member_map, fn_id) > self.cgu_emit_index) {
                builder.reset_function_codegen_marks(fn_id);
            }
            i = i + 1;
        }
    }

    public fn null_llvm_cached_handles(self) {
        self.string_ty = null;
        self.closure_fat_ty = null;
        self.pointer_handle_ty = null;
        self.current_function_value = null;
        self.current_entry_block = null;
        self.current_function_id = mir_id_invalid();
        self.current_block_id = mir_id_invalid();
        self.current_instr_id = mir_id_invalid();
        self.current_value_id = mir_id_invalid();
        self.current_place_id = mir_id_invalid();
        self.ptr_alias_domain = null;
        self.runtime_argc_global = null;
        self.runtime_argv_global = null;
        self.runtime_args_defined = false;
        self.last_print_call = null;
        self.builtin_print_fn = null; self.builtin_print_fty = null;
