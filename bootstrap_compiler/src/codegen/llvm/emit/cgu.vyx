    public fn reset_llvm_module_for_cgu(self) {
        if (self.mod != null) {
            vyx_rt_module_free(self.mod);
            self.mod = null;
        }
        let mod_name = self.module_symbol_name
                       + ".cgu"
                       + policy_i64_to_string(self.cgu_emit_index as i64);
        let triple = self.target_triple;
        let mod_h = vyx_rt_module_new(mod_name.c_str(),
                                      mod_name.len as u64,
                                      triple.c_str(),
                                      triple.len as u64);
        if (mod_h != null && llvm_mir_pic_from_argv()) {
            vyx_rt_set_relocation_model(mod_h, 2);
        }
        if (mod_h != null) { vyx_rt_builder_new(mod_h); }
        if (mod_h != null && self.debug_enabled) {
            vyx_rt_enable_debug(mod_h,
                                self.debug_source_path.c_str(),
                                self.debug_source_path.len as u64);
        }
        self.mod = mod_h;
        self.ty_i1 = vyx_rt_int_type(mod_h, 1);
        self.ty_i8 = vyx_rt_int_type(mod_h, 8);
        self.ty_i16 = vyx_rt_int_type(mod_h, 16);
        self.ty_i32 = vyx_rt_int_type(mod_h, 32);
        self.ty_i64 = vyx_rt_int_type(mod_h, 64);
        self.pointer_index_bits = vyx_rt_pointer_index_bits(mod_h);
        self.ty_pointer_index = null;
        if (self.pointer_index_bits > 0) {
            self.ty_pointer_index = vyx_rt_int_type(mod_h, self.pointer_index_bits);
        }
        self.ty_ptr = vyx_rt_ptr_ty(mod_h);
        self.ty_void = vyx_rt_void_ty(mod_h);
        llvm_mir_ptr_map_zero(self.function_values);
        llvm_mir_ptr_map_zero(self.function_types);
        llvm_mir_i32_map_zero(self.function_definition_emitted_map);
        llvm_mir_ptr_map_zero(self.function_closure_adapter_values);
        llvm_mir_ptr_map_zero(self.function_raw_callback_adapter_values);
        llvm_mir_ptr_map_zero(self.function_env_types);
        llvm_mir_ptr_map_zero(self.async_context_types);
        llvm_mir_ptr_map_zero(self.async_worker_values);
        llvm_mir_ptr_map_zero(self.async_worker_types);
        llvm_mir_ptr_map_zero(self.type_struct_values);
        llvm_mir_ptr_map_zero(self.dyn_vtable_type_values);
        llvm_mir_ptr_map_zero(self.hir_item_globals);
        llvm_mir_ptr_map_zero(self.block_values);
        llvm_mir_ptr_map_zero(self.local_slots);
        llvm_mir_ptr_map_zero(self.foreach_iterator_slots);
        llvm_mir_ptr_map_zero(self.value_cache);
        llvm_mir_ptr_map_zero(self.instr_deref_addr_cache);
        llvm_mir_ptr_map_zero(self.hoisted_borrow_handles);
        self.pending_value_first = 0;
        self.pending_value_last = 0;
        if (self.function_value_ranges != null) {
            free(self.function_value_ranges);
            self.function_value_ranges = null;
        }
        llvm_mir_ptr_map_zero(self.dci_stub_factory_values);
        llvm_mir_ptr_map_zero(self.dci_stub_destroy_values);
        llvm_mir_ptr_map_zero(self.dci_layout_by_type_cache);
        llvm_mir_ptr_map_zero(self.dci_symbol_object_cache);
        llvm_mir_free_raw_chain(self.dyn_method_adapter_head, 16);
        self.dyn_method_adapter_head = null;
        llvm_mir_free_raw_chain(self.reflected_method_adapter_head, 24);
        self.reflected_method_adapter_head = null;
        llvm_mir_free_raw_chain(self.dyn_vtable_head, 16);
        self.dyn_vtable_head = null;
        llvm_mir_free_raw_chain(self.dyn_trait_impl_cache_head, 16);
        self.dyn_trait_impl_cache_head = null;
        self.null_llvm_cached_handles();
        llvm_mir_dispose_symbol_index(self.function_symbol_index,
                                      self.function_symbol_index_cap,
                                      false);
        self.function_symbol_index = llvm_mir_symbol_index_new(self.function_symbol_index_cap);
        self.declared_function_scan_next = 1;
        self.adapter_need_cache_ready = false;
        if (self.str_lit_buf != null) {
            var n = self.string_lit_count;
            if (n > 8192) { n = 8192; }
            var si: i32 = 0;
            while (si < n) {
                policy_entry_clear(llvm_mir_entry_at(self.str_lit_buf, si));
                si = si + 1;
            }
        }
        self.string_lit_count = 0;
    }

    /// Optimize the current unit's module and write its object file.  The
    /// caller owns `self.mod` and keeps it alive; the pipelined path instead
    /// detaches the module and lets the emit thread run this work.
    public fn emit_object_now(self, path: string) -> i32 {
        if (self.mod == null || path.len == 0) { return 1; }
        let opt = llvm_mir_cli_opt_level();
        if (opt > 0) {
            let orc = vyx_rt_optimize(self.mod, opt);
            if (orc != 0) {
                var odetail = self.runtime_last_error();
                var omsg = "LLVM optimize failed for codegen unit "
                           + policy_i64_to_string(self.cgu_emit_index as i64)
                           + " (opt=" + policy_i64_to_string(opt as i64)
                           + ", rc=" + policy_i64_to_string(orc as i64) + ")";
                if (odetail.len > 0) { omsg = omsg + ": " + odetail; }
                self.report_error(omsg);
                return orc;
            }
        }
        let rc = llvm_mir_emit_module_file(self.mod, path.c_str(), path.len as u64, opt);
        if (rc != 0) {
            var edetail = self.runtime_last_error();
            var emsg = "object emission failed for codegen unit "
                       + policy_i64_to_string(self.cgu_emit_index as i64)
                       + " (rc=" + policy_i64_to_string(rc as i64) + ")";
            if (edetail.len > 0) { emsg = emsg + ": " + edetail; }
            self.report_error(emsg);
            return rc;
        }
        return 0;
    }

    public fn emit_cgu_objects_from_builder(self, builder: &mut MirUnitBuilder) -> bool {
        let limit = llvm_mir_codegen_unit_limit();
        self.cgu_partition_collected(limit);
        if (self.cgu_unit_count < 1) { self.cgu_unit_count = 1; }
        if (policy_phase_summary_enabled()) {
            print("[llvm-cgu] units=" + policy_i64_to_string(self.cgu_unit_count as i64)
                  + " functions=" + policy_i64_to_string(self.cgu_collected_n as i64)
                  + " modules=" + policy_i64_to_string(self.cgu_key_count() as i64));
        }
        if (self.cgu_unit_count <= 1) {
            self.cgu_emit_index = 1;
            self.declare_runtime_builtins();
            self.define_main_arg_runtime_helpers();
            builder.prepare_streaming_codegen_round();
            self.m = builder.unit;
            builder.drop_reachable_queue();
            self.cgu_enqueue_members(builder);
            self.declare_functions();
            self.emit_static_storage_roots();
            self.drain_streaming_builder_queue(builder);
            var deferred1: i32 = 0;
            while (builder.pending_deferred_materializations() > 0 && deferred1 < 64) {
                builder.prepare_streaming_codegen_round();
                self.m = builder.unit;
                self.declare_functions();
                self.emit_static_storage_roots();
                self.drain_streaming_builder_queue(builder);
                deferred1 = deferred1 + 1;
            }
            self.dci_synthesize_stub_wrappers();
            return self.error_count == 0;
        }
        let primary = llvm_mir_cli_output_path();
        let obj_opt = llvm_mir_cli_opt_level();
        let par_mode = llvm_cgu_parallel_mode();
        var emit_threads = llvm_cgu_env_emit_threads();
        if (emit_threads > self.cgu_unit_count - 1) {
            emit_threads = self.cgu_unit_count - 1;
        }
        // `off` keeps every unit on the main thread so the object bytes can be
        // diffed against a pooled build.
        if (par_mode == CGU_PAR_MODE_OFF) { emit_threads = 0; }
        var pipe_ok = false;
        if (primary.len > 0 && emit_threads > 0) {
            pipe_ok = cgu_pipe_start(self.cgu_unit_count, emit_threads);
        }
        if (policy_phase_summary_enabled()) {
            var par_line = "[llvm-cgu] parallel=" + llvm_cgu_parallel_mode_name(par_mode)
                           + " emit-threads=" + policy_i64_to_string(emit_threads as i64);
            if (pipe_ok) {
                par_line = par_line + " (lower serial, optimize+emit off-thread)";
            } else {
                par_line = par_line + " (fully serial)";
            }
            if (par_mode == CGU_PAR_MODE_FULL) {
                // Per-CGU parallel lowering is not a scheduling change: every
                // unit would need its own lowerer (the caches hanging off this
                // one are shared mutable state) and its own MIR arena, because
                // materialisation grows the arena that all units read through.
                par_line = par_line + " [full=reserved: per-CGU lowering needs a per-unit arena]";
            }
            if (policy_cgu_phases_enabled()) { par_line = par_line + " [phases=split]"; }
            print(par_line);
        }
        var cgu: i32 = 1;
        while (cgu <= self.cgu_unit_count) {
            self.cgu_emit_index = cgu;
            if (cgu > 1) { self.reset_llvm_module_for_cgu(); }
            self.declare_runtime_builtins();
            self.define_main_arg_runtime_helpers();
            builder.prepare_streaming_codegen_round();
            self.m = builder.unit;
            builder.drop_reachable_queue();
            self.cgu_enqueue_members(builder);
            self.declare_functions();
            self.emit_static_storage_roots();
            self.drain_streaming_builder_queue(builder);
            var deferred: i32 = 0;
            while (builder.pending_deferred_materializations() > 0 && deferred < 64) {
                builder.prepare_streaming_codegen_round();
                self.m = builder.unit;
                self.declare_functions();
                self.emit_static_storage_roots();
                self.drain_streaming_builder_queue(builder);
                deferred = deferred + 1;
            }
            if (cgu == 1) { self.dci_synthesize_stub_wrappers(); }
            if (primary.len > 0) {
                let unit_path = llvm_cgu_object_path(primary, cgu);
                var handled = false;
                // The last unit is emitted inline so `self.mod` is left valid
                // for the caller, exactly as in the all-serial path.
                if (pipe_ok && cgu < self.cgu_unit_count) {
                    let path_p = llvm_mir_dup_cstr(unit_path);
                    if (path_p != null
                        && cgu_pipe_submit(cgu, self.mod, path_p,
                                           unit_path.len as i64, obj_opt)) {
                        // Ownership moved to the emit thread: it optimizes,
                        // writes the object and frees the module.
                        self.mod = null;
                        handled = true;
                    } else if (path_p != null) {
                        free(path_p);
                    }
                }
                if (!handled) {
                    let erc = self.emit_object_now(unit_path);
                    if (erc != 0) {
                        if (pipe_ok) { cgu_pipe_finish(); cgu_pipe_dispose(); }
                        return false;
                    }
                }
            }
            self.cgu_reset_future_marks(builder);
            cgu = cgu + 1;
        }
        if (pipe_ok) { cgu_pipe_finish(); }
        if (primary.len > 0) {
            self.cgu_object_list = "";
            cgu = 1;
            while (cgu <= self.cgu_unit_count) {
                // Only the final unit is emitted inline; every earlier unit,
                // including unit 1, is dispatched to the pool.
                if (!pipe_ok || cgu == 1 || cgu == self.cgu_unit_count
                    || cgu_pipe_unit_ok(cgu)) {
                    if (self.cgu_object_list.len > 0) {
                        self.cgu_object_list = self.cgu_object_list + "\n";
                    }
                    self.cgu_object_list = self.cgu_object_list
                                           + llvm_cgu_object_path(primary, cgu);
                }
                cgu = cgu + 1;
            }
            if (self.cgu_object_list.len > 0) {
                writeFile(primary + ".cgu.list", self.cgu_object_list + "\n");
                self.cgu_emitted_objects = true;
            }
        }
        if (pipe_ok) {
            // Unit 1 is dispatched to the pool too (1 < cgu_unit_count), so its
            // slot must be inspected as well; only the final unit is inline.
            cgu = 1;
            while (cgu <= self.cgu_unit_count) {
                if (cgu != self.cgu_unit_count && !cgu_pipe_unit_ok(cgu)) {
                    self.report_error("object emission failed for codegen unit "
                                      + policy_i64_to_string(cgu as i64));
                }
                cgu = cgu + 1;
            }
            cgu_pipe_dispose();
        }
        return self.error_count == 0;
    }

    // Lower one streamed function, driving it through the four explicit
    // phases below.  The guards decide *whether* a function is lowered at all
    // (already done, owned by a sibling unit, declaration-only, ...); the
    // phases decide *how*.  Splitting them is what lets the lowering stage
    // eventually move off this thread: everything the phases share travels in
    // `slot`, not in the locals of this frame.
}
