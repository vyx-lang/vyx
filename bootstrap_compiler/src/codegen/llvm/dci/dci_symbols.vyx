module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn type_is_foreign_dci(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid() || type_id <= 0 || type_id > self.m.types.count) { return false; }
        if (!self.unit_has_dci_layout_inputs() && !self.unit_has_foreign_dci_types()) {
            return false;
        }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type != mir_id_invalid()
            && canonical_type > 0
            && canonical_type <= self.m.types.count
            && mir_unit_type_is_foreign_dci(&self.m, canonical_type)) {
            return true;
        }
        return mir_unit_type_is_foreign_dci(&self.m, type_id);
    }

    public fn unit_has_dci_layout_inputs(self) -> bool {
        if (mir_unit_has_dci_abi(&self.m)) { return true; }
        if (mir_unit_dci_stub_specs(&self.m).len > 0) { return true; }
        return mir_unit_foreign_cpp_includes(&self.m).len > 0;
    }

    public fn unit_has_foreign_dci_types(self) -> bool {
        if (self.foreign_dci_type_presence_cache != 0) {
            return self.foreign_dci_type_presence_cache == 2;
        }
        var type_id: i32 = 1;
        while (type_id <= self.m.types.count) {
            if (mir_unit_type_is_foreign_dci(&self.m, type_id)) {
                self.foreign_dci_type_presence_cache = 2;
                return true;
            }
            type_id = type_id + 1;
        }
        self.foreign_dci_type_presence_cache = 1;
        return false;
    }

    public fn type_id_without_ref(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return type_id; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_REF() || kind == ty_MUTREF() || kind == ty_PTR()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            if (elem != mir_id_invalid()) { return elem; }
        }
        return type_id;
    }

    public fn foreign_dci_abi_type_id(self, type_id: i32) -> i32 {
        return self.type_id_without_ref(type_id);
    }

    public fn dci_normalized_type_for_type(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        let kind0 = llvm_mir_type_kind(&self.m, type_id);
        if (kind0 == ty_REF() || kind0 == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            return "&" + self.dci_normalized_type_for_type(elem);
        }
        if (kind0 == ty_PTR()) {
            let elem2 = hir_type_table_elem(self.m.types, type_id);
            if (elem2 == mir_id_invalid()) { return "*void"; }
            return "*" + self.dci_normalized_type_for_type(elem2);
        }
        let type_id2 = self.foreign_dci_abi_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, type_id2);
        if (kind == ty_VOID()) { return "void"; }
        if (kind == ty_BOOL()) { return "bool"; }
        if (kind == ty_CHAR()) { return "char"; }
        if (kind == ty_I8()) { return "i8"; }
        if (kind == ty_U8()) { return "u8"; }
        if (kind == ty_I16()) { return "i16"; }
        if (kind == ty_U16()) { return "u16"; }
        if (kind == ty_I32()) { return "i32"; }
        if (kind == ty_U32()) { return "u32"; }
        if (kind == ty_I64() || kind == ty_ISIZE()) { return "i64"; }
        if (kind == ty_U64() || kind == ty_USIZE()) { return "u64"; }
        if (kind == ty_F32()) { return "f32"; }
        if (kind == ty_F64()) { return "f64"; }
        if (kind == ty_RAWPTR()) { return "*void"; }
        if (kind == ty_STRING() || self.type_is_str_abi(type_id2)) { return "*void"; }
        if (kind == ty_CLASS()) {
            return llvm_mir_type_text(&self.m, type_id2).replace("::", ".");
        }
        return llvm_mir_type_text(&self.m, type_id2).replace("::", ".");
    }

    public fn dci_canonical_type_name_text(self, raw: string) -> string {
        // Vyx spells a concrete generic instantiation with turbofish
        // (`fmt.basic_string_view::<char>`); after `::`->`.` that leaves a stray
        // `.` before `<`. A DCI contract spells the same C++ template
        // specialization as `fmt::basic_string_view<char>`. Normalising `.<`->`<`
        // makes both forms canonicalise identically so a Vyx instantiation matches
        // the contract record/field/parameter type.
        if (llvm_mir_dci_type_name_is_plain(raw)) { return raw; }
        return raw.trim()
            .replace("::", ".")
            .replace("class ", "")
            .replace("struct ", "")
            .replace("enum ", "")
            .replace(" <", "<")
            .replace("< ", "<")
            .replace(" >", ">")
            .replace("> ", ">")
            .replace(" ,", ",")
            .replace(", ", ",")
            .replace(" &", "&")
            .replace("& ", "&")
            .replace(" *", "*")
            .replace("* ", "*")
            .replace(".<", "<");
    }

    public fn dci_plain_type_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        if (lhs_raw.len == 0 || rhs_raw.len == 0) { return false; }
        if (llvm_mir_dci_type_name_is_plain(lhs_raw) && llvm_mir_dci_type_name_is_plain(rhs_raw)) {
            return lhs_raw == rhs_raw;
        }
        let lhs = self.dci_canonical_type_name_text(lhs_raw);
        let rhs = self.dci_canonical_type_name_text(rhs_raw);
        return lhs.len > 0 && rhs.len > 0 && lhs == rhs;
    }

    fn dci_resolve_alias_name(self, raw: string) -> string {
        var cur = self.dci_canonical_type_name_text(raw);
        if (cur.len == 0) { return ""; }
        self.dci_ensure_indexes();
        var hops: i32 = 0;
        while (hops < 16) {
            let alias = llvm_mir_dci_obj_index_first(self.dci_alias_index, self.dci_alias_index_cap, cur);
            if (alias == null) { break; }
            let target = self.dci_json_string(alias, "target");
            let next = self.dci_canonical_type_name_text(target);
            if (next.len == 0 || next == cur) { break; }
            cur = next;
            hops = hops + 1;
        }
        if (hops > 0) { return cur; }
        // A consumer-declared `@[repr(C)]` record reaches the producer's name
        // through agreement about its bytes, not through spelling.  Only a
        // name that no alias claimed is eligible: once the contract's own
        // alias table has spoken, its answer is authoritative.  (The bind used
        // to sit *after* this loop, which an early `return` on the first
        // alias-lookup miss silently bypassed -- a name with no aliases at
        // all, which is exactly what a consumer-spelled record is, never
        // reached it.)
        let bound = self.dci_consumer_record_bound_name(cur.clone());
        if (bound.len > 0) { return bound; }
        return cur;
    }

    /// The last dotted segment of a contract type name, or "" when the tail is
    /// not a plain identifier (`<`, `>`, `,` mean the name is a generic
    /// instance, whose tail belongs to an argument rather than to the record).
    fn dci_contract_layout_tail_name(self, type_name: string) -> string {
        if (type_name.len == 0) { return ""; }
        var i: i32 = type_name.len - 1;
        while (i >= 0) {
            let ch = type_name.charAt(i);
            if (ch == 46) { return type_name.substring(i + 1, type_name.len); }
            if (ch == 60 || ch == 62 || ch == 44) { return ""; }
            i = i - 1;
        }
        return type_name;
    }

    /// Bind a consumer-declared record to the producer record it describes.
    ///
    /// An instance closed over a record only the *consumer* declares
    /// (`class VyxHostTG<T> : native.SinkG<T>` with `T = VyxBox`) names the
    /// record the way Vyx spells it -- bare, because nothing imported it.  The
    /// producer's contract spells the same type with its crate prefix
    /// (`native.VyxBox`), because that is where the producer declared it.  The
    /// two never compare equal, so every name-keyed lookup fails: no symbol,
    /// and therefore no dispatch-table slot for `consume`.
    ///
    /// Matching the last segment alone would be a guess.  What makes the bind
    /// sound is that both sides describe the same bytes independently: Vyx
    /// derives size/alignment from the C rule (`@[repr(C)]` is what makes the
    /// record's layout *be* the C layout, floor included), and the producer
    /// measured them.  The name only resolves when those numbers agree, so a
    /// same-named-but-differently-shaped producer record keeps the loud
    /// "no layout" diagnostic instead of quietly acquiring an identity it
    /// cannot justify.  Everything else (unmeasured records, non-repr(C)
    /// classes, instances, pointers) falls through unchanged.
    fn dci_consumer_record_bound_name(self, raw: string) -> string {
        if (raw.len == 0) { return ""; }
        if (raw.contains(".") || raw.contains("<") || raw.contains(">")
            || raw.contains("*") || raw.contains("&") || raw.contains(",")) { return ""; }
        if (self.dci_json() == null) { return ""; }
        // Re-entrancy guard: the checks below ask whether the record already
        // has a descriptor entry, and that question resolves names -- which is
        // this function.  Answering it from inside ourselves would recurse
        // forever, so the inner call sees "not bound".
        if (self.dci_consumer_bind_depth > 0) { return ""; }
        self.dci_ensure_indexes();
        if (llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap,
                                         raw.clone()) != null) {
            return "";
        }
        // Candidate first, believed second: the layout array is small and the
        // type scan is not, so nothing walks the type table unless some
        // producer record already claims to be this bare name.
        var candidate: string = "";
        var cand_size: i64 = 0;
        var cand_align: i64 = 0;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n && candidate.len == 0) {
            let layouts = self.dci_exports_array_from(self.dci_contract_at(root_i), "layouts");
            var layout = dci_cjson_child(layouts);
            while (layout != null && candidate.len == 0) {
                let type_name = self.dci_json_string(layout, "type_name");
                if (self.dci_contract_layout_tail_name(type_name.clone()) == raw) {
                    cand_size = self.dci_json_i64(layout, "size");
                    cand_align = self.dci_json_i64(layout, "alignment");
                    if (cand_size > 0 && cand_align > 0) { candidate = type_name; }
                }
                layout = dci_cjson_next(layout);
            }
            root_i = root_i + 1;
        }
        if (candidate.len == 0) { return ""; }
        self.dci_consumer_bind_depth = self.dci_consumer_bind_depth + 1;
        var bound: string = "";
        let type_id = mir_unit_find_type_by_text(&self.m, raw.clone());
        if (type_id != mir_id_invalid() && self.dci_local_record_is_consumer_declared(type_id)) {
            if (self.dci_local_record_size(type_id) == cand_size
                && self.dci_local_record_align(type_id) == cand_align) {
                bound = candidate;
            }
        }
        self.dci_consumer_bind_depth = self.dci_consumer_bind_depth - 1;
        return bound;
    }

    public fn dci_type_alias_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        if (lhs_raw.len == 0 || rhs_raw.len == 0) { return false; }
        if (self.dci_json() == null) { return false; }
        self.dci_ensure_indexes();
        let lhs = self.dci_resolve_alias_name(lhs_raw);
        let rhs = self.dci_resolve_alias_name(rhs_raw);
        if (lhs.len > 0 && rhs.len > 0 && lhs == rhs) { return true; }
        let lhs_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap, lhs);
        let rhs_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap, rhs);
        return lhs_layout != null && lhs_layout == rhs_layout;
    }

    public fn dci_normalized_type_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        let lhs = lhs_raw.trim();
        let rhs = rhs_raw.trim();
        if (self.dci_plain_type_names_match(lhs, rhs)) { return true; }
        if (lhs.len == 0 || rhs.len == 0) { return false; }
        if (lhs.startsWith("*") && rhs.startsWith("*")) {
            return self.dci_normalized_type_names_match(lhs.substring(1, lhs.len),
                                                        rhs.substring(1, rhs.len));
        }
        if (lhs.startsWith("&") && rhs.startsWith("&")) {
            return self.dci_normalized_type_names_match(lhs.substring(1, lhs.len),
                                                        rhs.substring(1, rhs.len));
        }
        return self.dci_type_alias_names_match(lhs, rhs);
    }

    public fn dci_symbol_kind_for_function(self, function_id: i32) -> string {
        if (self.function_is_foreign_dci_ctor(function_id)) { return "constructor"; }
        if (self.function_is_foreign_dci_dtor(function_id)) { return "destructor"; }
        if (self.function_is_foreign_dci_free_function(function_id)) { return "function"; }
        return "method";
    }

    public fn dci_symbol_name_for_function(self, function_id: i32) -> string {
        if (self.function_is_foreign_dci_ctor(function_id)) { return "constructor"; }
        if (self.function_is_foreign_dci_dtor(function_id)) { return "destructor"; }
        if (!self.function_is_foreign_dci_free_function(function_id)) {
            let method = self.function_method_name(function_id);
            if (method.len > 0) { return method; }
        }
        return policy_generic_call_base(self.m.function_name(function_id).clone());
    }

    public fn dci_lifecycle_owner_terminal_name(self, owner_raw: string) -> string {
        let owner = self.dci_canonical_type_name_text(owner_raw);
        if (owner.len == 0) { return ""; }
        var start: i32 = 0;
        var depth: i32 = 0;
        var i: i32 = 0;
        while (i < owner.len) {
            let ch = owner.charAt(i);
            if (ch == 60) {
                depth = depth + 1;
            } else if (ch == 62 && depth > 0) {
                depth = depth - 1;
            } else if (ch == 46 && depth == 0) {
                start = i + 1;
            }
            i = i + 1;
        }
        var end: i32 = owner.len as i32;
        i = start;
        depth = 0;
        while (i < owner.len) {
            let ch2 = owner.charAt(i);
            if (ch2 == 60 && depth == 0) {
                end = i;
                break;
            }
            if (ch2 == 60) {
                depth = depth + 1;
            } else if (ch2 == 62 && depth > 0) {
                depth = depth - 1;
            }
            i = i + 1;
        }
        if (end <= start) { return ""; }
        return owner.substring(start, end);
    }

    public fn dci_symbol_member_name_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        let kind = self.dci_symbol_kind_for_function(function_id);
        let member_name = self.dci_json_string(sym, "member_name");
        if (kind == "constructor") {
            return member_name == "constructor";
        }
        if (kind == "destructor") {
            if (member_name == "destructor") { return true; }
            let terminal = self.dci_lifecycle_owner_terminal_name(
                self.dci_json_string(sym, "owner"));
            return terminal.len > 0 && member_name == "~" + terminal;
        }
        var symbol_name = member_name;
        if (symbol_name.len == 0) { symbol_name = self.dci_json_string(sym, "name"); }
        return symbol_name == self.dci_symbol_name_for_function(function_id);
    }

    public fn dci_symbol_receiver_param_count(self, function_id: i32) -> i32 {
        if (self.function_is_foreign_dci_instance_method(function_id)
            && !self.function_is_foreign_dci_ctor(function_id)) {
            return 1;
        }
        // A Vyx method overriding a foreign DCI instance method keeps the
        // receiver shape: source parameter 0 is `self`; ABI parameters start
        // at index 1, exactly as for a foreign declaration.
        if (self.function_is_dci_vyx_override_callback(function_id)
            && self.source_param_uses_self_pointer_abi(function_id, 0)) {
            return 1;
        }
        return 0;
    }

    public fn dci_type_object_name(self, type_obj: rawptr) -> string {
        return dci_abi_type_object_name(type_obj);
    }

    public fn dci_stub_state_field_addr(self, base_addr: rawptr, base_type_id: i32, field_id: i32) -> rawptr {
        let canonical = self.canonical_record_type_id(base_type_id);
        let derived = llvm_mir_type_text(&self.m, canonical);
        let symbol = "__dci_stub_field_" + policy_mangle_part(derived)
            + "_" + policy_mangle_part(mir_unit_field_name(&self.m, field_id));
        let params = malloc(8);
        ast_write_rawptr(params, self.ty_ptr);
        let fty = vyx_rt_fn_type(self.mod, self.ty_ptr, params, 1, 0);
        free(params);
        let fnv = vyx_rt_add_function(self.mod, symbol.c_str(), symbol.len as u64, fty);
        return vyx_rt_build_call1(self.mod, fty, fnv, base_addr, "dci.state".c_str(), 9);
    }

    public fn dci_type_object_matches_type(self, type_obj: rawptr, type_id: i32) -> bool {
        if (type_obj == null || type_id == mir_id_invalid()) { return false; }
        if (!dci_abi_reference_kind_supported(type_obj)) { return false; }
        if (self.dci_json_string(type_obj, "kind") == "function") {
            if (llvm_mir_type_kind(&self.m, type_id) != ty_CFN() || !dci_abi_is_cfn_pointer(type_obj)) { return false; }
            let signature = self.dci_json_item(type_obj, "signature");
            let params = self.dci_json_item(signature, "params");
            let count = cJSON_GetArraySize(params);
            if (self.fn_type_param_count(type_id) != count) { return false; }
            var i: i32 = 0;
            while (i < count) {
                if (!self.dci_type_object_matches_type(cJSON_GetArrayItem(params, i),
                    self.fn_type_param_type_at(type_id, i))) { return false; }
                i = i + 1;
            }
            return self.dci_type_object_matches_type(self.dci_json_item(signature, "return"),
                self.fn_type_return_type(type_id));
        }
        let lhs = self.dci_type_object_name(type_obj);
        let rhs = self.dci_normalized_type_for_type(type_id);
        if (self.dci_normalized_type_names_match(lhs, rhs)) { return true; }
        let enum_name = self.dci_json_string(type_obj, "enum_name");
        if (enum_name.len > 0) {
            if (self.dci_normalized_type_names_match(enum_name, rhs)) { return true; }
        }
        return false;
    }

    public fn dci_symbol_owner_matches_function(self, owner_text: string, function_id: i32) -> bool {
        return self.dci_symbol_owner_match_rank(owner_text, function_id) > 0;
    }

    public fn dci_symbol_owner_match_rank(self, owner_text: string, function_id: i32) -> i32 {
        if (self.function_is_foreign_dci_free_function(function_id)) {
            if (owner_text.len == 0) { return 2; }
            return 0;
        }
        let owner_type = self.foreign_dci_owner_type_id(function_id);
        if (owner_type != mir_id_invalid()) {
            if (self.dci_record_name_matches_type(owner_text, owner_type)) { return 2; }
            let symbol_kind = self.dci_symbol_kind_for_function(function_id);
            // Constructors and destructors belong to the complete object.  A
            // base lifecycle symbol is never an inherited overload of a
            // derived lifecycle declaration.
            if (symbol_kind == "constructor" || symbol_kind == "destructor") { return 0; }
            var derived_record = self.dci_record_name_for_type(owner_type);
            if (derived_record.len == 0) {
                derived_record = self.dci_record_name_for_type_text(self.foreign_dci_owner_type_text(function_id));
            }
            if (derived_record.len > 0) {
                if (self.dci_record_name_derives_from_record(derived_record, owner_text, 0)) { return 1; }
            }
            // Stub-spec fallback, same as the owner-text branch below: a Vyx
            // class inheriting a foreign DCI base has no contract layout of
            // its own, so the derives relation is the stub spec row.
            if (self.dci_stub_type_names_match(
                    self.dci_stub_base_for_type_text(self.foreign_dci_owner_type_text(function_id)),
                    owner_text)) { return 1; }
            return 0;
        }
        var owner_raw = self.foreign_dci_owner_type_text(function_id);
        if (owner_raw.len == 0) {
            // A Vyx override is not itself a foreign declaration, so the
            // foreign-owner resolver comes back empty; the MIR owner type is
            // the class whose stub spec names the base this symbol belongs to.
            owner_raw = self.m.function_owner_type(function_id);
        }
        if (self.dci_record_name_matches_text(owner_text, owner_raw)) { return 2; }
        let symbol_kind2 = self.dci_symbol_kind_for_function(function_id);
        if (symbol_kind2 == "constructor" || symbol_kind2 == "destructor") { return 0; }
        let derived_from_text = self.dci_record_name_for_type_text(owner_raw);
        if (derived_from_text.len > 0) {
            if (self.dci_record_name_derives_from_record(derived_from_text, owner_text, 0)) { return 1; }
        }
        // A Vyx override's class has no contract layout, so the record-name
        // resolver above cannot name it -- the derives relation lives in the
        // stub spec row, keyed on the MIR owner text itself.  (Nesting this
        // under the record-name guard would skip it for exactly the classes
        // that need it.)
        if (self.dci_stub_type_names_match(
                self.dci_stub_base_for_type_text(owner_raw), owner_text)) { return 1; }
        return 0;
    }

    public fn dci_symbol_params_match_function(self, params: rawptr, function_id: i32) -> bool {
        let receiver_params = self.dci_symbol_receiver_param_count(function_id);
        let source_count = self.function_source_param_count(function_id);
        let wanted = source_count - receiver_params;
        if (wanted < 0) { return false; }
        if (params == null || cJSON_IsArray(params) == 0) { return wanted == 0; }
        if (cJSON_GetArraySize(params) != wanted) { return false; }
        var idx: i32 = 0;
        while (idx < wanted) {
            let param_obj = cJSON_GetArrayItem(params, idx);
            let type_obj = self.dci_json_item(param_obj, "type");
            let param_type = self.function_source_param_type(function_id, idx + receiver_params);
            if (!self.dci_type_object_matches_type(type_obj, param_type)) { return false; }
            idx = idx + 1;
        }
        return true;
    }

    public fn dci_symbol_flags_match_function(self, sym: rawptr, function_id: i32) -> bool {
        if (self.function_is_foreign_dci_static_method(function_id)) {
            if (!self.dci_json_bool(sym, "is_static")) { return false; }
        }
        if (self.function_is_foreign_dci_instance_method(function_id)
            && !self.function_is_foreign_dci_ctor(function_id)) {
            if (self.dci_json_bool(sym, "is_static")) { return false; }
        }
        if (self.function_is_foreign_dci_const_method(function_id)
            != self.dci_json_bool(sym, "is_const")) {
            return false;
        }
        return true;
    }

    public fn dci_symbol_return_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        if (self.function_is_foreign_dci_ctor(function_id)
            || self.function_is_foreign_dci_dtor(function_id)) {
            return true;
        }
        let ret = self.dci_json_item(sym, "return");
        if (ret == null || cJSON_IsObject(ret) == 0) {
            return llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id)) == ty_VOID();
        }
        let type_obj = self.dci_json_item(ret, "type");
        return self.dci_type_object_matches_type(type_obj, self.m.function_return_type(function_id));
    }

    public fn dci_symbol_calling_convention_supported(self, sym: rawptr) -> bool {
        let cc = self.dci_symbol_calling_convention(sym);
        // Adapter contracts use C++ ABI-family labels; the runtime maps them
        // to LLVM's C calling convention for the supported MSVC profile.
        if (cc == "default" || cc == "system" || cc == "c"
            || cc == "cdecl" || cc == "cxx_free_function"
            || cc == "cxx_static_method" || cc == "cxx_method"
            || cc == "cxx_virtual_method" || cc == "cxx_constructor"
            || cc == "cxx_destructor" || cc == "win64" || cc == "x86_64_sysv"
            || cc == "stdcall" || cc == "fastcall" || cc == "thiscall"
            || cc == "vectorcall" || cc == "rust") {
            return true;
        }
        return false;
    }

    public fn dci_symbol_calling_convention(self, sym: rawptr) -> string {
        if (sym == null) { return ""; }
        let abi = self.dci_json_item(sym, "abi");
        var cc = self.dci_json_string(abi, "calling_convention");
        if (cc.len == 0) { cc = self.dci_json_string(sym, "calling_convention"); }
        return cc;
    }

    public fn dci_symbol_control_flow_boundary(self, sym: rawptr) -> string {
        if (sym != null) {
            let control = self.dci_json_item(sym, "control_flow");
            let symbol_boundary = self.dci_control_flow_boundary(control);
            if (symbol_boundary.len > 0) { return symbol_boundary; }
            let abi = self.dci_json_item(sym, "abi");
            let unwind = self.dci_json_string(abi, "unwind");
            if (unwind.len > 0) { return unwind; }
        }
        let root = self.dci_json();
        return self.dci_control_flow_boundary(self.dci_json_item(root, "control_flow"));
    }

    public fn dci_symbol_unwind_supported(self, sym: rawptr) -> bool {
        if (sym != null
            && !self.dci_control_flow_contract_supported(self.dci_json_item(sym, "control_flow"))) {
            return false;
        }
        if (!self.dci_control_flow_contract_supported(
                self.dci_json_item(self.dci_json(), "control_flow"))) {
            return false;
        }
        let boundary = self.dci_symbol_control_flow_boundary(sym);
        // A realizable translated boundary is accepted above by the contract
        // checks; its machine-level surface is no-unwind (the producer converts
        // to a value before crossing), so it is Direct-callable.
        if (boundary == "translated") { return true; }
        if (boundary == "shared_abi") { return true; }
        return self.dci_control_flow_boundary_supported(boundary);
    }

    public fn dci_symbol_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        if (sym == null || cJSON_IsObject(sym) == 0) { return false; }
        let kind_match = self.dci_json_string(sym, "kind") == self.dci_symbol_kind_for_function(function_id);
        let owner_match = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id) > 0;
        let member_match = self.dci_symbol_member_name_matches_function(sym, function_id);
        let params_match = self.dci_symbol_params_match_function(self.dci_json_item(sym, "params"), function_id);
        let flags_match = self.dci_symbol_flags_match_function(sym, function_id);
        let return_match = self.dci_symbol_return_matches_function(sym, function_id);
        let cc_match = self.dci_symbol_calling_convention_supported(sym);
        let unwind_match = self.dci_symbol_unwind_supported(sym);
        let link_match = self.dci_symbol_link_name(sym).len > 0;
        return kind_match && owner_match && member_match && params_match
            && flags_match && return_match && cc_match && unwind_match && link_match;
    }

    public fn dci_symbol_contract_items_equal(self,
                                               lhs: rawptr,
                                               rhs: rawptr,
                                               key: string) -> bool {
        let lhs_item = self.dci_json_item(lhs, key);
        let rhs_item = self.dci_json_item(rhs, key);
        if (lhs_item == null || rhs_item == null) { return lhs_item == rhs_item; }
        return cJSON_Compare(lhs_item, rhs_item, 1) != 0;
    }

    public fn dci_symbol_contracts_equivalent(self, lhs: rawptr, rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (self.dci_symbol_link_name(lhs) != self.dci_symbol_link_name(rhs)
            || self.dci_symbol_calling_convention(lhs)
                != self.dci_symbol_calling_convention(rhs)
            || self.dci_json_string(lhs, "kind") != self.dci_json_string(rhs, "kind")
            || self.dci_json_string(lhs, "owner") != self.dci_json_string(rhs, "owner")) {
            return false;
        }
        return self.dci_symbol_contract_items_equal(lhs, rhs, "params")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "return")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "abi")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "control_flow");
    }

    fn dci_matching_symbols_same_native(self, lhs: rawptr, rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (self.dci_symbol_contracts_equivalent(lhs, rhs)) { return true; }
        let lhs_link = self.dci_symbol_link_name(lhs);
        let rhs_link = self.dci_symbol_link_name(rhs);
        if (lhs_link.len == 0 || lhs_link != rhs_link) { return false; }
        if (self.dci_symbol_calling_convention(lhs)
                != self.dci_symbol_calling_convention(rhs)
            || self.dci_json_string(lhs, "kind") != self.dci_json_string(rhs, "kind")) {
            return false;
        }
        return self.dci_shared_link_type_names_compatible(
            self.dci_json_string(lhs, "owner"),
            self.dci_json_string(rhs, "owner"));
    }

    fn dci_prefer_matching_symbol(self, function_id: i32, current: rawptr, candidate: rawptr) -> rawptr {
        if (current == null) { return candidate; }
        if (candidate == null) { return current; }
        let want = self.foreign_dci_owner_type_text(function_id);
        let current_exact = self.dci_plain_type_names_match(
            self.dci_json_string(current, "owner"), want);
        let candidate_exact = self.dci_plain_type_names_match(
            self.dci_json_string(candidate, "owner"), want);
        if (candidate_exact && !current_exact) { return candidate; }
        return current;
    }

    fn dci_select_symbol_from_chain(self, function_id: i32, chain_head: rawptr) -> rawptr {
        var best_rank: i32 = 0;
        var best: rawptr = null;
        var best_rank_conflicts = false;
        var chain = chain_head;
        while (chain != null) {
            let sym = ast_read_rawptr(chain);
            if (self.dci_symbol_matches_function(sym, function_id)) {
                let rank = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id);
                if (rank > best_rank) {
                    best_rank = rank;
                    best = sym;
                    best_rank_conflicts = false;
                } else if (rank == best_rank && rank > 0 && best != null) {
                    if (self.dci_matching_symbols_same_native(best, sym)) {
                        best = self.dci_prefer_matching_symbol(function_id, best, sym);
                    } else {
                        best_rank_conflicts = true;
                    }
                }
            }
            chain = ast_read_rawptr(ptr_offset(chain, 8));
        }
        if (best_rank_conflicts) {
            self.report_error("conflicting DCI symbol contracts for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        return best;
    }

    fn dci_select_symbol_from_array(self, function_id: i32, symbols: rawptr) -> rawptr {
        var best_rank: i32 = 0;
        var best: rawptr = null;
        var best_rank_conflicts = false;
        var sym = dci_cjson_child(symbols);
        while (sym != null) {
            if (self.dci_symbol_matches_function(sym, function_id)) {
                let rank = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id);
                if (rank > best_rank) {
                    best_rank = rank;
                    best = sym;
                    best_rank_conflicts = false;
                } else if (rank == best_rank && rank > 0 && best != null) {
                    if (self.dci_matching_symbols_same_native(best, sym)) {
                        best = self.dci_prefer_matching_symbol(function_id, best, sym);
                    } else {
                        best_rank_conflicts = true;
                    }
                }
            }
            sym = dci_cjson_next(sym);
        }
        if (best_rank_conflicts) {
            self.report_error("conflicting DCI symbol contracts for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        return best;
    }

    // ── DCI open-generic instances ─────────────────────────────────────
    // The Active Adapter materializes the native entrypoint from the resolved
    // producer facts, so the ABI is derived from the MIR types instead of a
    // hand-written descriptor: pointers/primitives pass direct, records over
    // 8 bytes pass indirect (by value) and return sret — mirroring what a
    // closed contract would have declared for the same concrete type.

    public fn dci_open_type_size(self, type_id: i32) -> i64 {
        let storage = self.lower_storage_type(type_id);
        if (storage == null) { return 0; }
        return vyx_rt_type_alloc_size(self.mod, storage);
    }

    public fn dci_open_type_kind_word(self, type_id: i32) -> string {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_CLASS()) { return "record"; }
        return "primitive";
    }

    public fn dci_open_lowering_passing(self, type_id: i32) -> string {
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            return "direct";
        }
        let size = self.dci_open_type_size(type_id);
        if (size <= 0) { return "direct"; }
        if (size > 8) { return "indirect"; }
        // Win64 carries a 1/2/4/8-byte aggregate in a register and hands every
        // other size over by reference -- clang lowers a 3-byte struct to
        // `ptr` and returns one through sret.  Routing those to `indirect`
        // keeps the synthesized contract equal to what the producer does;
        // scalars are exactly 1/2/4/8 bytes and are unaffected.
        let canonical = self.canonical_record_type_id(type_id);
        if (llvm_mir_effective_target_is_windows()
            && llvm_mir_type_kind(&self.m, canonical) == ty_CLASS()
            && size != 1 && size != 2 && size != 4 && size != 8) {
            return "indirect";
        }
        return "direct";
    }

    public fn dci_open_lowering_json(self, type_id: i32, index: i32,
                                     is_return: bool) -> string {
        let passing = self.dci_open_lowering_passing(type_id);
        let size = self.dci_open_type_size(type_id);
        var index_part = "";
        if (!is_return) {
            index_part = "\"index\":" + index.toString() + ",";
        }
        if (passing == "direct") {
            return "{" + index_part + "\"passing\":\"direct\",\"size\":"
                   + size.toString() + "}";
        }
        if (is_return) {
            return "{\"passing\":\"sret\",\"alignment\":8,\"size\":"
                   + size.toString() + ",\"attributes\":[\"sret\"]}";
        }
        return "{" + index_part + "\"passing\":\"indirect\",\"alignment\":8"
               + ",\"size\":" + size.toString()
               + ",\"attributes\":[\"by_value\"]}";
    }

    public fn dci_open_type_json(self, type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, type_id);
        return "{\"name\":\"" + text + "\",\"kind\":\""
               + self.dci_open_type_kind_word(type_id)
               + "\",\"nullable\":false,\"reference\":\"value\"}";
    }

    /// Contract-equivalent symbol object for an open-generic DCI instance
    /// (`base__<args>`).  Parsed from synthesized JSON so every downstream
    /// contract validator runs unchanged.
    public fn dci_synthesize_open_instance_symbol(self, function_id: i32) -> rawptr {
        let name = self.m.function_name(function_id);
        var base = name;
        var suffix = "__";
        let args = mir_unit_function_generic_args(&self.m, function_id);
        var ai: i32 = 0;
        while (ai < 64) {
            let arg = policy_generic_arg_at(args, ai);
            if (arg.len == 0) { break; }
            if (ai > 0) { suffix = suffix + "_"; }
            suffix = suffix + policy_mangle_part(arg);
            ai = ai + 1;
        }
        if (name.endsWith(suffix) && suffix.len > 2) {
            base = name.substring(0, name.len - suffix.len);
        }

        var params_json = "";
        var lowerings_json = "";
        let param_count = self.function_source_param_count(function_id);
        var pi: i32 = 0;
        while (pi < param_count) {
            let param_type = self.function_source_param_type(function_id, pi);
            if (pi > 0) {
                params_json = params_json + ",";
                lowerings_json = lowerings_json + ",";
            }
            params_json = params_json
                + "{\"name\":\"v" + pi.toString()
                + "\",\"type\":" + self.dci_open_type_json(param_type)
                + ",\"location\":\"abi\",\"ownership\":\"copy\"}";
            lowerings_json = lowerings_json
                + self.dci_open_lowering_json(param_type, pi, false);
            pi = pi + 1;
        }

        let ret_type = self.m.function_return_type(function_id);
        let return_lowering = self.dci_open_lowering_json(ret_type, -1, true);
        var hidden = "";
        if (self.dci_open_lowering_passing(ret_type) == "indirect") {
            hidden = ",\"hidden_parameters\":[{\"passing\":\"sret\",\"alignment\":8"
                     + ",\"size\":" + self.dci_open_type_size(ret_type).toString()
                     + ",\"attributes\":[\"sret\"]}]";
        }

        let text = "{\"name\":\"" + base
            + "\",\"link_name\":\"" + name
            + "\",\"kind\":\"function\",\"calling_convention\":\"system\""
            + ",\"linkage\":\"external\",\"visibility\":\"public\""
            + ",\"params\":[" + params_json + "]"
            + ",\"return\":{\"type\":" + self.dci_open_type_json(ret_type)
            + ",\"location\":\"abi\",\"ownership\":\"copy\"}"
            + ",\"abi\":{\"calling_convention\":\"system\",\"variadic\":false"
            + ",\"parameters\":[" + lowerings_json + "]"
            + ",\"return\":" + return_lowering + hidden + "}"
            + ",\"control_flow\":{\"default_boundary\":\"no_unwind\""
            + ",\"propagation\":{\"mode\":\"forbidden\"}}}";
        let parsed = cJSON_Parse(text.c_str());
        if (parsed == null) {
            self.report_error("cannot synthesize open-generic DCI symbol for `"
                      + name + "`");
        }
        return parsed;
    }

    public fn dci_symbol_object_for_function(self, function_id: i32) -> rawptr {
        if (function_id == mir_id_invalid()) { return null; }
        if (!self.function_is_foreign_dci(function_id)
            && !self.function_is_dci_vyx_override_callback(function_id)) { return null; }
        // Open-generic instances derive their whole ABI from the MIR types;
        // they never consult a descriptor, so this check runs before the
        // DCI-ABI-mode gate below.
        if (self.function_name_is_foreign_dci_instance(function_id)) {
            let cached_open = llvm_mir_map_get(self.dci_symbol_object_cache, function_id);
            if (cached_open != null) { return cached_open; }
            let synthesized = self.dci_synthesize_open_instance_symbol(function_id);
            if (synthesized != null) {
                llvm_mir_map_put(self.dci_symbol_object_cache, function_id, synthesized);
            }
            return synthesized;
        }
        if (!mir_unit_has_dci_abi(&self.m)) { return null; }
        let cached = llvm_mir_map_get(self.dci_symbol_object_cache, function_id);
        if (cached != null) {
            if (cached == self.dci_lookup_miss) { return null; }
            return cached;
        }
        if (self.dci_json() == null) { return null; }
        self.dci_ensure_indexes();
        let kind = self.dci_symbol_kind_for_function(function_id);
        let member = self.dci_symbol_name_for_function(function_id);
        var best: rawptr = null;
        var scanned_index = false;
        if (kind.len > 0 && member.len > 0) {
            let chain = llvm_mir_dci_obj_index_lookup(self.dci_symbol_index,
                                                       self.dci_symbol_index_cap,
                                                       kind + "#" + member);
            if (chain != null) {
                best = self.dci_select_symbol_from_chain(function_id, chain);
                scanned_index = true;
            }
        }
        if (!scanned_index) {
            best = self.dci_select_symbol_from_array(function_id, self.dci_root_exports_array("symbols"));
        }
        if (best == null) {
            best = self.dci_translate_unwind_translator_for_function(function_id);
        }
        if (best == null) {
            if (llvm_mir_env_enabled("VYX_DCI_SYMBOL_TRACE")) {
                self.dci_trace_symbol_lookup(function_id, kind, member);
            }
            if (self.dci_lookup_miss != null) {
                llvm_mir_map_put(self.dci_symbol_object_cache, function_id, self.dci_lookup_miss);
            }
            return null;
        }
        llvm_mir_map_put(self.dci_symbol_object_cache, function_id, best);
        return best;
    }

    /// `VYX_DCI_SYMBOL_TRACE=1`: explain a failed descriptor lookup.  A rejected
    /// contract otherwise surfaces as a single opaque "no matching symbol"
    /// error, and the only way to learn *which* predicate rejected *which*
    /// candidate is to rebuild with prints inside the matcher.  This dumps the
    /// derived key plus a per-predicate verdict for every contract symbol
    /// sharing the kind, so the mismatch names itself.
    public fn dci_trace_symbol_lookup(self, function_id: i32, kind: string, member: string) {
        print("[dci-symbol] miss fn=" + self.m.function_name(function_id)
              + " kind=" + kind
              + " key_member=" + member
              + " derived_member=" + self.dci_symbol_name_for_function(function_id)
              + " owner_text=" + self.foreign_dci_owner_type_text(function_id));
        let symbols = self.dci_root_exports_array("symbols");
        var sym = dci_cjson_child(symbols);
        var dumped: i32 = 0;
        while (sym != null && dumped < 32) {
            if (cJSON_IsObject(sym) != 0 && self.dci_json_string(sym, "kind") == kind) {
                dumped = dumped + 1;
                var verdicts: string = "";
                verdicts = verdicts + " owner_rank="
                    + self.dci_symbol_owner_match_rank(
                          self.dci_json_string(sym, "owner"), function_id).toString();
                verdicts = verdicts + " member=" + dci_trace_verdict(
                    self.dci_symbol_member_name_matches_function(sym, function_id));
                verdicts = verdicts + " params=" + dci_trace_verdict(
                    self.dci_symbol_params_match_function(
                        self.dci_json_item(sym, "params"), function_id));
                verdicts = verdicts + " flags=" + dci_trace_verdict(
                    self.dci_symbol_flags_match_function(sym, function_id));
                verdicts = verdicts + " return=" + dci_trace_verdict(
                    self.dci_symbol_return_matches_function(sym, function_id));
                verdicts = verdicts + " cc=" + dci_trace_verdict(
                    self.dci_symbol_calling_convention_supported(sym));
                verdicts = verdicts + " unwind=" + dci_trace_verdict(
                    self.dci_symbol_unwind_supported(sym));
                verdicts = verdicts + " link=" + dci_trace_verdict(
                    self.dci_symbol_link_name(sym).len > 0);
                print("[dci-symbol]   cand owner=" + self.dci_json_string(sym, "owner")
                      + " member_name=" + self.dci_json_string(sym, "member_name")
                      + " match=" + dci_trace_verdict(
                            self.dci_symbol_matches_function(sym, function_id))
                      + verdicts);
            }
            sym = dci_cjson_next(sym);
        }
        print("[dci-symbol]   dumped=" + dumped.toString());
    }

    public fn dci_symbol_abi_object(self, function_id: i32) -> rawptr {
        let symbol = self.dci_symbol_object_for_function(function_id);
        if (symbol == null) { return null; }
        let abi = self.dci_json_item(symbol, "abi");
        if (abi == null || cJSON_IsObject(abi) == 0) { return null; }
        return abi;
    }

    public fn dci_abi_parameter_array(self, function_id: i32) -> rawptr {
        let abi = self.dci_symbol_abi_object(function_id);
        if (abi == null) { return null; }
        var params = self.dci_json_item(abi, "parameters");
        if (params == null) { params = self.dci_json_item(abi, "params"); }
        if (params == null || cJSON_IsArray(params) == 0) { return null; }
        return params;
    }

    public fn dci_abi_parameters_complete(self, function_id: i32) -> bool {
        let symbol = self.dci_symbol_object_for_function(function_id);
        if (symbol == null) {
            self.report_error("cannot resolve DCI symbol contract for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let source_params = self.dci_json_item(symbol, "params");
        var expected: i32 = 0;
        if (source_params != null) {
            if (cJSON_IsArray(source_params) == 0) {
                self.report_error("DCI source parameters must be an array for `"
                          + self.m.function_name(function_id) + "`");
                return false;
            }
            expected = cJSON_GetArraySize(source_params);
        }
        let lowered = self.dci_abi_parameter_array(function_id);
        if (lowered == null) {
            self.report_error("DCI ABI parameters are missing for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let lowered_count = cJSON_GetArraySize(lowered);
        if (lowered_count != expected) {
            self.report_error("DCI ABI parameter lowering count " + lowered_count.toString()
                      + " does not match " + expected.toString() + " source parameter(s) for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        var wanted: i32 = 0;
        while (wanted < expected) {
            var matches: i32 = 0;
            var lowering_index: i32 = 0;
            while (lowering_index < lowered_count) {
                let lowering = cJSON_GetArrayItem(lowered, lowering_index);
                if (lowering == null || cJSON_IsObject(lowering) == 0) {
                    self.report_error("invalid DCI ABI parameter lowering for `"
                              + self.m.function_name(function_id) + "`");
                    return false;
                }
                let index_item = self.dci_json_item(lowering, "index");
                var source_index = lowering_index;
                if (index_item != null) {
                    if (cJSON_IsNumber(index_item) == 0) {
                        self.report_error("DCI ABI parameter index must be numeric for `"
                                  + self.m.function_name(function_id) + "`");
                        return false;
                    }
                    let errs = self.error_count;
                    let source_index_i64 = self.dci_json_number_item_i64(index_item, "ABI parameter index");
                    if (self.error_count > errs) { return false; }
                    if (source_index_i64 < 0 || source_index_i64 > 2147483647) {
                        self.report_error("DCI ABI parameter index must be an integer for `"
                                  + self.m.function_name(function_id) + "`");
                        return false;
                    }
                    source_index = source_index_i64 as i32;
                }
                if (source_index < 0 || source_index >= expected) {
                    self.report_error("DCI ABI parameter index " + source_index.toString()
                              + " is out of range for `" + self.m.function_name(function_id) + "`");
                    return false;
                }
                if (source_index == wanted) { matches = matches + 1; }
                lowering_index = lowering_index + 1;
            }
            if (matches != 1) {
                self.report_error("DCI ABI parameter #" + wanted.toString()
                          + " is not covered exactly once for `"
                          + self.m.function_name(function_id) + "`");
                return false;
            }
            wanted = wanted + 1;
        }
        return true;
    }

    public fn dci_shared_link_canonical_type_name(self, raw: string) -> string {
        let normalized = self.dci_canonical_type_name_text(raw);
        if (normalized.len == 0) { return ""; }
        if (normalized.startsWith("*")) {
            let tail = self.dci_shared_link_canonical_type_name(
                normalized.substring(1, normalized.len));
            if (tail.len == 0) { return ""; }
            return "*" + tail;
        }
        if (normalized.startsWith("&")) {
            let tail2 = self.dci_shared_link_canonical_type_name(
                normalized.substring(1, normalized.len));
            if (tail2.len == 0) { return ""; }
            return "&" + tail2;
        }
        var current = normalized;
        var depth: i32 = 0;
        while (depth < 64) {
            var changed = false;
            var root_i: i32 = 0;
            let root_n = self.dci_contract_count();
            while (root_i < root_n && !changed) {
                let aliases = self.dci_exports_array_from(self.dci_contract_at(root_i), "aliases");
                if (aliases != null) {
                    var i: i32 = 0;
                    let n = cJSON_GetArraySize(aliases);
                    while (i < n) {
                        let alias = cJSON_GetArrayItem(aliases, i);
                        if (alias != null && cJSON_IsObject(alias) != 0) {
                            let alias_name = self.dci_json_string(alias, "name");
                            let target_name = self.dci_canonical_type_name_text(
                                self.dci_json_string(alias, "target"));
                            if (alias_name.len > 0 && target_name.len > 0
                                && self.dci_plain_type_names_match(current, alias_name)) {
                                if (target_name == current) { return current; }
                                current = target_name;
                                changed = true;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                }
                root_i = root_i + 1;
            }
            if (!changed) { return current; }
            depth = depth + 1;
        }
        // Alias cycles are not a proof of ABI equivalence.
        return "";
    }

    public fn dci_shared_link_type_names_compatible(self, lhs: string, rhs: string) -> bool {
        if (lhs.len == 0 || rhs.len == 0) { return lhs == rhs; }
        let lhs_canonical = self.dci_shared_link_canonical_type_name(lhs);
        let rhs_canonical = self.dci_shared_link_canonical_type_name(rhs);
        return lhs_canonical.len > 0 && rhs_canonical.len > 0
            && lhs_canonical == rhs_canonical;
    }

    public fn dci_shared_link_json_item_equal(self,
                                               lhs: rawptr,
                                               rhs: rawptr,
                                               key: string) -> bool {
        let lhs_item = self.dci_json_item(lhs, key);
        let rhs_item = self.dci_json_item(rhs, key);
        if (lhs_item == null || rhs_item == null) { return lhs_item == rhs_item; }
        return cJSON_Compare(lhs_item, rhs_item, 1) != 0;
    }

    public fn dci_shared_link_type_items_compatible(self,
                                                     lhs: rawptr,
                                                     rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (cJSON_IsString(lhs) != 0 && cJSON_IsString(rhs) != 0) {
            let lhs_raw = cJSON_GetStringValue(lhs);
            let rhs_raw = cJSON_GetStringValue(rhs);
            if (lhs_raw == null || rhs_raw == null) { return false; }
            return self.dci_shared_link_type_names_compatible(from_cstr(lhs_raw), from_cstr(rhs_raw));
        }
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) { return false; }
        let lhs_name = self.dci_json_string(lhs, "name");
        let rhs_name = self.dci_json_string(rhs, "name");
        if (!self.dci_shared_link_type_names_compatible(lhs_name, rhs_name)) { return false; }
        if (!self.dci_shared_link_json_item_equal(lhs, rhs, "kind")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "reference")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "reference_kind")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "nullable")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "pointee_const")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "size")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "alignment")) {
            return false;
        }
        return self.dci_shared_link_type_names_compatible(
            self.dci_json_string(lhs, "enum_name"),
            self.dci_json_string(rhs, "enum_name"));
    }

    public fn dci_shared_link_source_value_contracts_compatible(self,
                                                                  lhs: rawptr,
                                                                  rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        // Return values may be represented by a JSON null node rather than a
        // missing property.  Preserve that distinction while accepting equal
        // null contracts for constructors and destructors.
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) {
            return cJSON_Compare(lhs, rhs, 1) != 0;
        }
        return self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "type"),
                                                           self.dci_json_item(rhs, "type"))
            && self.dci_shared_link_json_item_equal(lhs, rhs, "location")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "ownership");
    }

    public fn dci_shared_link_abi_value_lowerings_compatible(self,
                                                              lhs: rawptr,
                                                              rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) { return false; }
        return self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "type"),
                                                           self.dci_json_item(rhs, "type"))
            && self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "coerce_to"),
                                                           self.dci_json_item(rhs, "coerce_to"))
            && self.dci_shared_link_json_item_equal(lhs, rhs, "passing")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "alignment")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "size")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "attributes")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "registers");
    }

    public fn dci_shared_link_receiver_contracts_compatible(self,
                                                              lhs_abi: rawptr,
                                                              rhs_abi: rawptr) -> bool {
        let lhs_receiver = self.dci_json_item(lhs_abi, "receiver");
        let rhs_receiver = self.dci_json_item(rhs_abi, "receiver");
        if (!self.dci_shared_link_abi_value_lowerings_compatible(lhs_receiver, rhs_receiver)) {
            return false;
        }
        return self.dci_shared_link_json_item_equal(lhs_receiver, rhs_receiver, "ownership")
            && self.dci_shared_link_json_item_equal(lhs_receiver, rhs_receiver, "this_adjust");
    }

    public fn dci_shared_link_hidden_parameters_compatible(self,
                                                             lhs_abi: rawptr,
                                                             rhs_abi: rawptr) -> bool {
        let lhs_hidden = self.dci_json_item(lhs_abi, "hidden_parameters");
        let rhs_hidden = self.dci_json_item(rhs_abi, "hidden_parameters");
        if (lhs_hidden == null || rhs_hidden == null) { return lhs_hidden == rhs_hidden; }
        if (cJSON_IsArray(lhs_hidden) == 0 || cJSON_IsArray(rhs_hidden) == 0) { return false; }
        let lhs_count = cJSON_GetArraySize(lhs_hidden);
        if (lhs_count != cJSON_GetArraySize(rhs_hidden)) { return false; }
        var i: i32 = 0;
        while (i < lhs_count) {
            if (!self.dci_shared_link_abi_value_lowerings_compatible(
                    cJSON_GetArrayItem(lhs_hidden, i), cJSON_GetArrayItem(rhs_hidden, i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn dci_shared_link_source_parameters_compatible(self,
                                                            lhs_function: i32,
                                                            rhs_function: i32) -> bool {
        let lhs_count = self.function_source_param_count(lhs_function);
        if (lhs_count != self.function_source_param_count(rhs_function)) { return false; }
        var i: i32 = 0;
        while (i < lhs_count) {
            if (!self.dci_shared_link_source_value_contracts_compatible(
                    self.dci_source_parameter_object(lhs_function, i),
                    self.dci_source_parameter_object(rhs_function, i))
                || !self.dci_shared_link_abi_value_lowerings_compatible(
                    self.dci_source_parameter_abi(lhs_function, i),
                    self.dci_source_parameter_abi(rhs_function, i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn dci_shared_link_abi_contracts_compatible(self,
                                                        lhs_function: i32,
                                                        rhs_function: i32) -> bool {
        let lhs_symbol = self.dci_symbol_object_for_function(lhs_function);
        let rhs_symbol = self.dci_symbol_object_for_function(rhs_function);
        if (lhs_symbol == null || rhs_symbol == null) { return false; }
        let lhs_abi = self.dci_json_item(lhs_symbol, "abi");
        let rhs_abi = self.dci_json_item(rhs_symbol, "abi");
        if (lhs_abi == null || rhs_abi == null
            || cJSON_IsObject(lhs_abi) == 0 || cJSON_IsObject(rhs_abi) == 0) {
            return false;
        }
        if (self.dci_symbol_link_name(lhs_symbol) != self.dci_symbol_link_name(rhs_symbol)
            || self.dci_symbol_calling_convention(lhs_symbol)
                != self.dci_symbol_calling_convention(rhs_symbol)
            || self.dci_json_string(lhs_symbol, "kind") != self.dci_json_string(rhs_symbol, "kind")
            || !self.dci_shared_link_type_names_compatible(
                self.dci_json_string(lhs_symbol, "owner"),
                self.dci_json_string(rhs_symbol, "owner"))
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "control_flow")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_static")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_virtual")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_override")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_final")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_const")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "this_adjust")
            || !self.dci_shared_link_json_item_equal(lhs_abi, rhs_abi, "variadic")
            || !self.dci_shared_link_json_item_equal(lhs_abi, rhs_abi, "unwind")) {
            return false;
        }
        return self.dci_shared_link_receiver_contracts_compatible(lhs_abi, rhs_abi)
            && self.dci_shared_link_source_parameters_compatible(lhs_function, rhs_function)
            && self.dci_shared_link_source_value_contracts_compatible(
                self.dci_json_item(lhs_symbol, "return"),
                self.dci_json_item(rhs_symbol, "return"))
            && self.dci_shared_link_abi_value_lowerings_compatible(
                self.dci_json_item(lhs_abi, "return"),
                self.dci_json_item(rhs_abi, "return"))
            && self.dci_shared_link_hidden_parameters_compatible(lhs_abi, rhs_abi);
    }

    public fn dci_shared_symbol_contracts_compatible(self,
                                                      lhs_function: i32,
                                                      rhs_function: i32) -> bool {
        let lhs_dci = self.function_is_foreign_dci(lhs_function);
        let rhs_dci = self.function_is_foreign_dci(rhs_function);
        if (lhs_dci != rhs_dci) { return false; }
        if (!lhs_dci) { return true; }
        return self.dci_shared_link_abi_contracts_compatible(lhs_function, rhs_function);
    }
}
