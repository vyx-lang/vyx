    public fn lower_fs_attrs_for_path_call(self, value_id: i32) -> rawptr {
        if (self.builtin_get_file_attrs_fn == null || self.builtin_get_file_attrs_fty == null) {
            self.report_error("GetFileAttributesA declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("filesystem path predicate requires exactly one argument");
            return null;
        }
        let path_id = self.call_arg_at(value_id, 0);
        let path_ptr = self.string_cstr_from_value(path_id);
        if (path_ptr == null) {
            self.report_error("cannot lower filesystem path argument");
            return null;
        }
        let attrs = vyx_rt_build_call1(self.mod,
                                       self.builtin_get_file_attrs_fty,
                                       self.builtin_get_file_attrs_fn,
                                       path_ptr,
                                       "mir.fs.attrs".c_str(),
                                       12);
        if (attrs == null) {
            self.report_error("cannot emit GetFileAttributesA call");
            return null;
        }
        return attrs;
    }

    public fn lower_fs_path_predicate_call(self, value_id: i32, name: string) -> rawptr {
        let attrs = self.lower_fs_attrs_for_path_call(value_id);
        if (attrs == null) { return null; }
        let invalid = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let exists = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_ne(),
                                       attrs,
                                       invalid,
                                       llvm_mir_empty_name(),
                                       0);
        if (name == "fileExists") { return self.bool_value_i8(exists); }
        let dir_bit = vyx_rt_build_and(self.mod,
                                       attrs,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 16, 0),
                                       llvm_mir_empty_name(),
                                       0);
        let is_dir = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_ne(),
                                       dir_bit,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                       llvm_mir_empty_name(),
                                       0);
        if (name == "isDir") {
            return self.bool_value_i8(vyx_rt_build_and(self.mod, exists, is_dir, llvm_mir_empty_name(), 0));
        }
        if (name == "isFile") {
            let not_dir = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            dir_bit,
                                            vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                            llvm_mir_empty_name(),
                                            0);
            return self.bool_value_i8(vyx_rt_build_and(self.mod, exists, not_dir, llvm_mir_empty_name(), 0));
        }
        self.report_error("unknown filesystem path predicate " + name);
        return null;
    }

    public fn lower_string_char_at_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var index_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            index_id = self.call_arg_at(value_id, 1);
        } else if (argc != 1) {
            self.report_error("charAt requires receiver plus index");
            return null;
        }
        if (receiver_id == mir_id_invalid() || index_id == mir_id_invalid()) {
            self.report_error("charAt call is missing receiver or index");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("charAt receiver is not str ABI");
            return null;
        }
        let s_value = self.lower_string_view_value(receiver_id);
        let s_ptr = self.string_ptr_value(s_value);
        let s_len = self.string_len_value(s_value);
        let idx = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 64);
        if (s_value == null || s_ptr == null || s_len == null || idx == null) {
            self.report_error("cannot lower charAt operands");
            return null;
        }
        let zero64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let idx_neg = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_slt(),
                                        idx,
                                        zero64,
                                        llvm_mir_empty_name(),
                                        0);
        let idx_ge_len = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_sge(),
                                           idx,
                                           s_len,
                                           llvm_mir_empty_name(),
                                           0);
        let out_of_range = vyx_rt_build_or(self.mod,
                                           idx_neg,
                                           idx_ge_len,
                                           llvm_mir_empty_name(),
                                           0);
        let result_slot = vyx_rt_build_alloca(self.mod,
                                             self.ty_i32,
                                             "mir.charAt.result".c_str(),
                                             17);
        let fail_name = "mir.charAt.fail." + policy_i64_to_string(value_id as i64);
        let load_name = "mir.charAt.load." + policy_i64_to_string(value_id as i64);
        let join_name = "mir.charAt.join." + policy_i64_to_string(value_id as i64);
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fail_name.c_str(),
                                          fail_name.len as u64);
        let load_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          load_name.c_str(),
                                          load_name.len as u64);
        let join_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          join_name.c_str(),
                                          join_name.len as u64);
        if (out_of_range == null || result_slot == null || fail_bb == null || load_bb == null || join_bb == null) {
            self.report_error("cannot create charAt control flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, out_of_range, fail_bb, load_bb);

        vyx_rt_position_at_end(self.mod, fail_bb);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i32, -1, 1), result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, load_bb);
        let ch_ptr = self.ptr_offset_bytes(s_ptr, idx, "mir.charAt.ptr");
        if (ch_ptr == null) {
            self.report_error("cannot compute charAt byte pointer");
            return null;
        }
        let ch = vyx_rt_build_load(self.mod,
                                   self.ty_i8,
                                   ch_ptr,
                                   "mir.charAt.byte".c_str(),
                                   15);
        let ch_i32 = vyx_rt_build_zext(self.mod,
                                       ch,
                                       self.ty_i32,
                                       llvm_mir_empty_name(),
                                       0);
        if (ch == null || ch_i32 == null) {
            self.report_error("cannot load charAt byte");
            return null;
        }
        vyx_rt_build_store(self.mod, ch_i32, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, join_bb);
        return vyx_rt_build_load(self.mod,
                                 self.ty_i32,
                                 result_slot,
                                 "mir.charAt.value".c_str(),
                                 16);
    }
}
