module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn lower_string_concat_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("str_concat requires exactly two arguments");
            return null;
        }
        return self.lower_string_concat_parts(self.call_arg_at(value_id, 0), self.call_arg_at(value_id, 1));
    }

    public fn lower_string_case_call(self, value_id: i32, to_upper: bool) -> rawptr {
        var receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string case-conversion call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string case-conversion receiver is not str ABI");
            return null;
        }
        var fn_value = self.builtin_string_to_lower_len_fn;
        var fn_type = self.builtin_string_to_lower_len_fty;
        if (to_upper) {
            fn_value = self.builtin_string_to_upper_len_fn;
            fn_type = self.builtin_string_to_upper_len_fty;
        }
        if (fn_value == null || fn_type == null) {
            self.report_error("string case-conversion len-aware declaration is unavailable");
            return null;
        }
        let source_value = self.lower_string_view_value(receiver_id);
        let source_ptr = self.string_ptr_value(source_value);
        let source_len = self.string_len_value(source_value);
        if (source_value == null || source_ptr == null || source_len == null) {
            self.report_error("cannot lower string case-conversion receiver");
            return null;
        }
        let raw_out = vyx_rt_build_call2(self.mod,
                                         fn_type,
                                         fn_value,
                                         source_ptr,
                                         source_len,
                                         "mir.str.case".c_str(),
                                         12);
        if (raw_out == null) {
            self.report_error("cannot emit string case-conversion call");
            return null;
        }
        let cap_v = vyx_rt_build_add(self.mod,
                                     source_len,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                     llvm_mir_empty_name(),
                                     0);
        if (cap_v == null) {
            self.report_error("cannot compute case-conversion capacity");
            return null;
        }
        return self.string_value_from_raw_parts_as_type(raw_out,
                                                        source_len,
                                                        cap_v,
                                                        vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                                        self.m.value_type(value_id));
    }

    public fn lower_string_trim_call(self, value_id: i32) -> rawptr {
        var receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string trim call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string trim receiver is not str ABI");
            return null;
        }
        if (self.builtin_string_trim_fn == null || self.builtin_string_trim_fty == null) {
            self.report_error("string trim declaration is unavailable");
            return null;
        }
        let source_ptr = self.string_cstr_from_value(receiver_id);
        if (source_ptr == null) {
            self.report_error("cannot lower string trim receiver");
            return null;
        }
        let raw_out = vyx_rt_build_call1(self.mod,
                                         self.builtin_string_trim_fty,
                                         self.builtin_string_trim_fn,
                                         source_ptr,
                                         "mir.str.trim".c_str(),
                                         12);
        if (raw_out == null) {
            self.report_error("cannot emit string trim call");
            return null;
        }
        return self.string_value_from_cstr_as_type(raw_out, self.m.value_type(value_id), 3);
    }

    public fn lower_string_replace_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var old_id = self.call_arg_at(value_id, 0);
        var new_id = self.call_arg_at(value_id, 1);
        if (argc == 3) {
            receiver_id = self.call_arg_at(value_id, 0);
            old_id = self.call_arg_at(value_id, 1);
            new_id = self.call_arg_at(value_id, 2);
        } else if (argc != 2) {
            self.report_error("replace requires receiver plus old/new strings");
            return null;
        }
        if (receiver_id == mir_id_invalid()
            || old_id == mir_id_invalid()
            || new_id == mir_id_invalid()) {
            self.report_error("replace call is missing receiver or arguments");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))
            || !self.type_is_string_view_type(self.m.value_type(old_id))
            || !self.type_is_string_view_type(self.m.value_type(new_id))) {
            self.report_error("replace operands must use str ABI");
            return null;
        }
        if (self.builtin_string_replace_fn == null || self.builtin_string_replace_fty == null) {
            self.report_error("string replace declaration is unavailable");
            return null;
        }
        let source_ptr = self.string_cstr_from_value(receiver_id);
        let old_ptr = self.string_cstr_from_value(old_id);
        let new_ptr = self.string_cstr_from_value(new_id);
        if (source_ptr == null || old_ptr == null || new_ptr == null) {
            self.report_error("cannot lower replace string operands");
            return null;
        }
        let raw_out = vyx_rt_build_call3(self.mod,
                                         self.builtin_string_replace_fty,
                                         self.builtin_string_replace_fn,
                                         source_ptr,
                                         old_ptr,
                                         new_ptr,
                                         "mir.str.replace".c_str(),
                                         15);
        if (raw_out == null) {
            self.report_error("cannot emit string replace call");
            return null;
        }
        return self.string_value_from_cstr_as_type(raw_out, self.m.value_type(value_id), 3);
    }

    public fn lower_string_equals_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        if (argc != 1 && argc != 2) {
            self.report_error("string equals requires receiver plus one argument");
            return null;
        }
        var lhs_id = self.receiver_for_builtin_call(value_id);
        var rhs_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            lhs_id = self.call_arg_at(value_id, 0);
            rhs_id = self.call_arg_at(value_id, 1);
        }
        return self.lower_string_equals_parts(lhs_id, rhs_id, false);
    }

    public fn lower_string_ptr_member_call(self, value_id: i32, member_name: string) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error(member_name + " requires a str receiver");
            return null;
        }
        if (self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            return self.string_cstr_from_value(receiver_id);
        }
        return self.lower_record_field_member_value(receiver_id, "ptr");
    }

    public fn lower_std_string_as_str_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let string_type = self.m.value_type(value_id);
        if (!self.type_is_std_string_class(string_type)) {
            self.report_error("value is not std String: " + llvm_mir_type_text(&self.m, string_type));
            return null;
        }
        let base_addr = self.lower_self_receiver_address(value_id, string_type);
        if (base_addr == null) {
            self.report_error("cannot materialize std String receiver");
            return null;
        }
        let ptr_gep = self.record_field_addr_for_type(base_addr, string_type, "ptr");
        let len_gep = self.record_field_addr_for_type(base_addr, string_type, "len");
        let owned_gep = self.record_field_addr_for_type(base_addr, string_type, "owned");
        let inline_gep = self.record_field_addr_for_type(base_addr, string_type, "inline0");
        if (ptr_gep == null || len_gep == null || owned_gep == null || inline_gep == null) {
            self.report_error("cannot address std String fields");
            return null;
        }
        let heap_ptr = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         ptr_gep,
                                         llvm_mir_empty_name(),
                                         0);
        let len_v = vyx_rt_build_load(self.mod,
                                      self.ty_i64,
                                      len_gep,
                                      llvm_mir_empty_name(),
                                      0);
        let owned_v = vyx_rt_build_load(self.mod,
                                        self.ty_i64,
                                        owned_gep,
                                        llvm_mir_empty_name(),
                                        0);
        let inline_ptr = vyx_rt_build_bitcast(self.mod,
                                              inline_gep,
                                              self.ty_ptr,
                                              "String.inline.ptr".c_str(),
                                              17);
        let is_heap = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        owned_v,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                        llvm_mir_empty_name(),
                                        0);
        let data_ptr = vyx_rt_build_select(self.mod,
                                           is_heap,
                                           heap_ptr,
                                           inline_ptr,
                                           "String.borrow.ptr".c_str(),
                                           17);
        if (heap_ptr == null || len_v == null || owned_v == null || inline_ptr == null || is_heap == null || data_ptr == null) {
            self.report_error("cannot lower std String borrowed view");
            return null;
        }
        return self.emit_string_value_from_parts(data_ptr,
                                                  len_v,
                                                  len_v,
                                                  vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn std_string_from_primitive_function(self, dst_type_id: i32) -> i32 {
        if (!self.type_is_std_string_class(dst_type_id)) { return mir_id_invalid(); }
        let dst_canonical = self.canonical_record_type_id(dst_type_id);
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_name_matches_method(self.m.function_name(fn_id), "from")
                && self.function_owner_matches_type(fn_id, dst_canonical)
                && self.function_source_param_count(fn_id) == 1
                && self.type_is_str_abi(self.function_source_param_type(fn_id, 0))
                && self.type_is_std_string_class(self.m.function_return_type(fn_id))) {
                let ret_canonical = self.canonical_record_type_id(self.m.function_return_type(fn_id));
                if (self.type_ids_compatible(ret_canonical, dst_canonical)
                    || self.type_ids_compatible(self.m.function_return_type(fn_id), dst_type_id)) {
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        return mir_id_invalid();
    }

    public fn function_owner_matches_type(self, function_id: i32, type_id: i32) -> bool {
        if (function_id == mir_id_invalid() || type_id == mir_id_invalid()) { return false; }
        let owner_text = self.m.function_owner_type(function_id);
        if (owner_text.len == 0) { return false; }
        let owner_type = self.type_id_by_text(owner_text);
        if (owner_type == mir_id_invalid()) { return false; }
        return self.type_ids_compatible(self.canonical_record_type_id(owner_type),
                                        self.canonical_record_type_id(type_id));
    }

    public fn lower_static_one_arg_call(self, target_fn: i32, arg_id: i32, result_name: string) -> rawptr {
        if (target_fn == mir_id_invalid() || arg_id == mir_id_invalid()) { return null; }
        let param_type = self.function_source_param_type(target_fn, 0);
        if (param_type == mir_id_invalid()) {
            self.report_error("cannot resolve parameter type for " + self.m.function_name(target_fn));
            return null;
        }
        let arg_value = self.lower_value_as(arg_id, param_type);
        if (arg_value == null) {
            self.report_error("cannot lower argument for " + self.m.function_name(target_fn));
            return null;
        }
        return self.lower_static_one_arg_raw_call(target_fn, arg_value, param_type, result_name);
    }

    public fn lower_static_one_arg_raw_call(self,
                                           target_fn: i32,
                                           arg_value: rawptr,
                                           arg_type: i32,
                                           result_name: string) -> rawptr {
        if (target_fn == mir_id_invalid() || arg_value == null || arg_type == mir_id_invalid()) { return null; }
        if (!self.declare_function_signature(target_fn)) {
            self.report_error("cannot declare function " + self.m.function_name(target_fn));
            return null;
        }
        let fn_value = llvm_mir_map_get(self.function_values, target_fn);
        let fn_type = llvm_mir_map_get(self.function_types, target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_error("cannot resolve function " + self.m.function_name(target_fn));
            return null;
        }
        let param_type = self.function_source_param_type(target_fn, 0);
        if (param_type == mir_id_invalid()) {
            self.report_error("cannot resolve parameter type for " + self.m.function_name(target_fn));
            return null;
        }
        let cast_arg = self.cast_value(arg_value, arg_type, param_type);
        if (cast_arg == null) {
            self.report_error("cannot lower raw argument for " + self.m.function_name(target_fn));
            return null;
        }
        let uses_sret = self.function_uses_hidden_sret(target_fn);
        var argc: i32 = 1;
        if (uses_sret) { argc = 2; }
        if (self.function_llvm_param_count(target_fn) != argc) {
            self.report_error("unexpected ABI parameter count for " + self.m.function_name(target_fn));
            return null;
        }
        let args = malloc((argc * 8) as u64);
        if (args == null) {
            self.report_error("cannot allocate call argument for " + self.m.function_name(target_fn));
            return null;
        }
        var sret_slot: rawptr = null;
        if (uses_sret) {
            let return_type = self.m.function_return_type(target_fn);
            let storage_type = self.lower_storage_type(return_type);
            if (storage_type == null) {
                free(args);
                self.report_error("cannot lower return storage for " + self.m.function_name(target_fn));
                return null;
            }
            sret_slot = vyx_rt_build_alloca(self.mod,
                                            storage_type,
                                            "mir.std.string.sret".c_str(),
                                            19);
            if (sret_slot == null) {
                free(args);
                self.report_error("cannot allocate return storage for " + self.m.function_name(target_fn)
                          + ": " + self.runtime_last_error());
                return null;
            }
            let alignment = self.native_aggregate_align_bytes(return_type);
            if (alignment > 0) { vyx_rt_set_alignment(self.mod, sret_slot, alignment as i32); }
            ast_write_rawptr(args, sret_slot);
            ast_write_rawptr(ptr_offset(args, 8), cast_arg);
        } else {
            ast_write_rawptr(args, cast_arg);
        }
        var call_name = result_name;
        if (uses_sret) { call_name = ""; }
        var out = self.build_abi_call(fn_type, fn_value, args, argc as u64, call_name, target_fn);
        if (out != null && !self.apply_dci_callsite_abi_attrs(target_fn, out)) { out = null; }
        if (out != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, out)) { out = null; }
        free(args);
        if (out == null) {
            self.report_error("cannot build call to " + self.m.function_name(target_fn)
                      + ": " + self.runtime_last_error());
            return null;
        }
        if (uses_sret) {
            let return_type = self.m.function_return_type(target_fn);
            let value_type = self.lower_type(return_type);
            if (value_type == null) {
                self.report_error("cannot lower return type for " + self.m.function_name(target_fn));
                return null;
            }
            out = vyx_rt_build_load(self.mod,
                                    value_type,
                                    sret_slot,
                                    result_name.c_str(),
                                    result_name.len as u64);
            if (out == null) {
                self.report_error("cannot load result of " + self.m.function_name(target_fn)
                          + ": " + self.runtime_last_error());
            }
        }
        return out;
    }

    public fn lower_str_raw_to_std_string_value(self, str_value: rawptr, dst_type_id: i32) -> rawptr {
        if (str_value == null || dst_type_id == mir_id_invalid()) { return null; }
        let from_fn = self.std_string_from_primitive_function(dst_type_id);
        if (from_fn == mir_id_invalid()) {
            self.report_error("converting str to std String requires std.string.String.from");
            return null;
        }
        let str_type = self.type_id_by_text("str");
        if (str_type == mir_id_invalid()) {
            self.report_error("cannot resolve canonical str type for std String conversion");
            return null;
        }
        return self.lower_static_one_arg_raw_call(from_fn,
                                                  str_value,
                                                  str_type,
                                                  "mir.std.string.from");
    }

    public fn lower_str_to_std_string_value(self, value_id: i32, dst_type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return null; }
        let from_fn = self.std_string_from_primitive_function(dst_type_id);
        if (from_fn == mir_id_invalid()) {
            self.report_error("converting str to std String requires std.string.String.from");
            return null;
        }
        return self.lower_static_one_arg_call(from_fn, value_id, "mir.std.string.from");
    }

    public fn lower_string_view_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let ty = self.m.value_type(value_id);
        if (self.type_is_str_abi(ty)) { return self.lower_value(value_id); }
        let kind = llvm_mir_type_kind(&self.m, ty);
        if ((kind == ty_REF() || kind == ty_MUTREF())
            && self.type_is_str_abi(hir_type_table_elem(self.m.types, ty))) {
            return self.reference_value_to_string(value_id, ty);
        }
        if (self.type_is_std_string_class(ty)) { return self.lower_std_string_as_str_value(value_id); }
        self.report_error("value is not string-view compatible: " + llvm_mir_type_text(&self.m, ty));
        return null;
    }

    public fn lower_string_field_member_value(self, value_id: i32, member_name: string) -> rawptr {
        let receiver_id = self.receiver_for_builtin_member_value(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error(member_name + " requires a str receiver");
            return null;
        }
        if (self.type_is_std_string_class(self.m.value_type(receiver_id))) {
            if (member_name == "ptr" || member_name == "c_str" || member_name == "data") {
                return self.string_cstr_from_value(receiver_id);
            }
            if (member_name == "len" || member_name == "length" || member_name == "size" || member_name == "count") {
                return self.string_len_from_value(receiver_id);
            }
            if (member_name == "cap" || member_name == "owned") {
                return self.lower_record_field_member_value(receiver_id, member_name);
            }
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            return self.lower_record_field_member_value(receiver_id, member_name);
        }
        let value = self.lower_string_view_value(receiver_id);
        if (value == null) {
            self.report_error("cannot lower str receiver for member " + member_name);
            return null;
        }
        if (member_name == "ptr" || member_name == "c_str" || member_name == "data") { return self.string_ptr_value(value); }
        if (member_name == "len" || member_name == "length" || member_name == "size" || member_name == "count") { return self.string_len_value(value); }
        if (member_name == "cap") { return self.string_cap_value(value); }
        if (member_name == "owned") { return self.string_owned_value(value); }
        self.report_error("unknown str member " + member_name);
        return null;
    }

    public fn lower_string_clone_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string clone requires a receiver");
            return null;
        }
        // `Clone<str>` is an ownership operation, not a borrowed view.
        // Use the additive length-aware runtime ABI rather than the legacy
        // bootstrap clone ABI: the latter may return shared or arena storage
        // that old compiler generations consume under a different contract.
        let source = self.lower_string_view_value(receiver_id);
        if (source == null) {
            self.report_error("cannot lower string clone receiver");
            return null;
        }
        let source_ptr = self.string_ptr_value(source);
        let source_len = self.string_len_value(source);
        if (source_ptr == null || source_len == null) {
            self.report_error("cannot extract string clone receiver bytes");
            return null;
        }
        if (self.builtin_string_clone_fn == null || self.builtin_string_clone_fty == null) {
            self.report_error("length-aware string clone declaration is unavailable");
            return null;
        }
        // The allocation and the eventual owned==3 release both execute in
        // vyx_rt. This avoids Windows JIT CRT-domain mismatches between an IR
        // malloc/free pair and runtime-produced string values.
        let copy = vyx_rt_build_call2(self.mod,
                                      self.builtin_string_clone_fty,
                                      self.builtin_string_clone_fn,
                                      source_ptr,
                                      source_len,
                                      "mir.str.clone".c_str(),
                                      13);
        let cap = vyx_rt_build_add(self.mod,
                                   source_len,
                                   vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                   llvm_mir_empty_name(),
                                   0);
        if (copy == null || cap == null) {
            self.report_error("cannot allocate string clone result");
            return null;
        }
        return self.emit_string_value_from_parts(copy,
                                                 source_len,
                                                 cap,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn lower_string_repeat_call(self, value_id: i32) -> rawptr {
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable for string repeat");
            return null;
        }
        let argc = self.call_arg_count(value_id);
        if (argc != 1 && argc != 2) {
            self.report_error("repeat requires receiver plus count");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var count_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            count_id = self.call_arg_at(value_id, 1);
        }
        if (receiver_id == mir_id_invalid() || count_id == mir_id_invalid()) {
            self.report_error("repeat call is missing receiver or count");
            return null;
        }
        let s_value = self.lower_string_view_value(receiver_id);
        let s_ptr = self.string_ptr_value(s_value);
        let s_len = self.string_len_value(s_value);
        let raw_count = self.int_value_to_bits(self.lower_value(count_id), self.m.value_type(count_id), 64);
        let zero = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let count_positive = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_sgt(),
                                               raw_count,
                                               zero,
                                               llvm_mir_empty_name(),
                                               0);
        let safe_count = vyx_rt_build_select(self.mod,
                                             count_positive,
                                             raw_count,
                                             zero,
                                             "mir.str.repeat.count".c_str(),
                                             20);
        let total_len = vyx_rt_build_mul(self.mod,
                                         s_len,
                                         safe_count,
                                         "mir.str.repeat.len".c_str(),
                                         18);
        let out_data = self.alloc_string_data_for_len(total_len);
        if (s_value == null || s_ptr == null || s_len == null || raw_count == null
            || count_positive == null || safe_count == null || total_len == null || out_data == null) {
            self.report_error("cannot lower repeat operands");
            return null;
        }
        let i_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.str.repeat.i".c_str(), 16);
        let off_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.str.repeat.off".c_str(), 18);
        if (i_slot == null || off_slot == null) {
            self.report_error("cannot allocate repeat loop slots");
            return null;
        }
        vyx_rt_build_store(self.mod, zero, i_slot);
        vyx_rt_build_store(self.mod, zero, off_slot);
        let cond_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.cond".c_str(),
                                          19);
        let body_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.body".c_str(),
                                          19);
        let done_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.done".c_str(),
                                          19);
        if (cond_bb == null || body_bb == null || done_bb == null) {
            self.report_error("cannot create repeat loop blocks");
            return null;
        }
        vyx_rt_build_br(self.mod, cond_bb);

        vyx_rt_position_at_end(self.mod, cond_bb);
        let i_cur = vyx_rt_build_load(self.mod, self.ty_i64, i_slot, "mir.str.repeat.i".c_str(), 16);
        let keep_going = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_slt(),
                                           i_cur,
                                           safe_count,
                                           llvm_mir_empty_name(),
                                           0);
        if (i_cur == null || keep_going == null) {
            self.report_error("cannot lower repeat loop condition");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, keep_going, body_bb, done_bb);

        vyx_rt_position_at_end(self.mod, body_bb);
        let off_cur = vyx_rt_build_load(self.mod, self.ty_i64, off_slot, "mir.str.repeat.off".c_str(), 18);
        let dst = self.ptr_offset_bytes(out_data, off_cur, "mir.str.repeat.dst");
        let copied = vyx_rt_build_call3(self.mod,
                                        self.builtin_memcpy_fty,
                                        self.builtin_memcpy_fn,
                                        dst,
                                        s_ptr,
                                        s_len,
                                        llvm_mir_empty_name(),
                                        0);
        let next_off = vyx_rt_build_add(self.mod, off_cur, s_len, llvm_mir_empty_name(), 0);
        let next_i = vyx_rt_build_add(self.mod,
                                      i_cur,
                                      vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                      llvm_mir_empty_name(),
                                      0);
        if (off_cur == null || dst == null || copied == null || next_off == null || next_i == null) {
            self.report_error("cannot lower repeat loop body");
            return null;
        }
        vyx_rt_build_store(self.mod, next_off, off_slot);
        vyx_rt_build_store(self.mod, next_i, i_slot);
        vyx_rt_build_br(self.mod, cond_bb);

        vyx_rt_position_at_end(self.mod, done_bb);
        let cap_v = vyx_rt_build_add(self.mod,
                                     total_len,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        if (cap_v == null) {
            self.report_error("cannot compute repeat result capacity");
            return null;
        }
        return self.emit_string_value_from_parts(out_data,
                                                 total_len,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_int_to_string_runtime_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("int_to_string requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let arg_value = self.int_value_to_bits(self.lower_value(arg_id), self.m.value_type(arg_id), 64);
        if (arg_value == null) {
            self.report_error("cannot lower int_to_string argument");
            return null;
        }
        return self.string_value_from_i64_to_string(arg_value);
    }

    public fn lower_bool_to_string_runtime_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("bool_to_string requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let arg_value = self.int_value_to_bits(self.lower_value(arg_id), self.m.value_type(arg_id), 32);
        if (arg_value == null) {
            self.report_error("cannot lower bool_to_string argument");
            return null;
        }
        return self.string_value_from_bool_to_string(arg_value);
    }

    public fn lower_strlen_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("strlen requires exactly one argument");
            return null;
        }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower strlen pointer argument");
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_strlen_fty,
                                  self.builtin_strlen_fn,
                                  ptr_v,
                                  "mir.strlen".c_str(),
                                  10);
    }

    public fn lower_arg_count_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 0) {
            self.report_error("argCount requires no arguments");
            return null;
        }
        if (self.builtin_arg_count_fn == null || self.builtin_arg_count_fty == null) {
            self.report_error("argCount declaration is unavailable");
            return null;
        }
        return vyx_rt_build_call(self.mod,
                                 self.builtin_arg_count_fty,
                                 self.builtin_arg_count_fn,
                                 null,
                                 0,
                                 "mir.argc".c_str(),
                                 8);
    }

    public fn lower_get_arg_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("getArg requires exactly one argument");
            return null;
        }
        if (self.builtin_get_arg_fn == null || self.builtin_get_arg_fty == null) {
            self.report_error("getArg declaration is unavailable");
            return null;
        }
        let index_id = self.call_arg_at(value_id, 0);
        let index_v = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 32);
        if (index_v == null) {
            self.report_error("cannot lower getArg index");
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_get_arg_fty,
                                  self.builtin_get_arg_fn,
                                  index_v,
                                  "mir.argv".c_str(),
                                  8);
    }

    public fn lower_from_cstr_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("from_cstr requires exactly one argument");
            return null;
        }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower from_cstr pointer argument");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr_v,
                                       "mir.from_cstr.len".c_str(),
                                       17);
        if (len_v == null) {
            self.report_error("cannot measure from_cstr input");
            return null;
        }
        return self.emit_string_value_from_parts(ptr_v,
                                                 len_v,
                                                 len_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn lower_from_cstr_len_call(self, value_id: i32, view: bool) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("from_cstr_len requires exactly two arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let len_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let len_v = self.int_value_to_bits(self.lower_value(len_id), self.m.value_type(len_id), 64);
        if (ptr_v == null || len_v == null) {
            self.report_error("cannot lower from_cstr_len arguments");
            return null;
        }
        if (view) {
            return self.emit_string_value_from_parts(ptr_v,
                                                     len_v,
                                                     len_v,
                                                     vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        }
        let dst = self.copied_string_data_from_cstr_len(ptr_v, len_v);
        if (dst == null) { return null; }
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        return self.emit_string_value_from_parts(dst,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_from_raw_string_parts_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 4) {
            self.report_error("from_raw_string_parts requires exactly four arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let len_id = self.call_arg_at(value_id, 1);
        let cap_id = self.call_arg_at(value_id, 2);
        let owned_id = self.call_arg_at(value_id, 3);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let len_v = self.int_value_to_bits(self.lower_value(len_id), self.m.value_type(len_id), 64);
        let cap_v = self.int_value_to_bits(self.lower_value(cap_id), self.m.value_type(cap_id), 64);
        let owned_v = self.int_value_to_bits(self.lower_value(owned_id), self.m.value_type(owned_id), 64);
        if (ptr_v == null || len_v == null || cap_v == null || owned_v == null) {
            self.report_error("cannot lower from_raw_string_parts arguments");
            return null;
        }
        return self.emit_string_value_from_parts(ptr_v, len_v, cap_v, owned_v);
    }

    public fn lower_string_substring_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var start_id = self.call_arg_at(value_id, 0);
        var end_id = self.call_arg_at(value_id, 1);
        if (argc == 3) {
            receiver_id = self.call_arg_at(value_id, 0);
            start_id = self.call_arg_at(value_id, 1);
            end_id = self.call_arg_at(value_id, 2);
        } else if (argc != 2) {
            self.report_error("substring requires receiver plus start/end");
            return null;
        }
        if (receiver_id == mir_id_invalid()
            || start_id == mir_id_invalid()
            || end_id == mir_id_invalid()) {
            self.report_error("substring call is missing receiver or bounds");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("substring receiver is not str ABI");
            return null;
        }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return null;
        }

        let source_value = self.lower_string_view_value(receiver_id);
        let source_ptr = self.string_ptr_value(source_value);
        let source_len = self.string_len_value(source_value);
        let start_raw = self.int_value_to_bits(self.lower_value(start_id), self.m.value_type(start_id), 64);
        let end_raw = self.int_value_to_bits(self.lower_value(end_id), self.m.value_type(end_id), 64);
        if (source_value == null || source_ptr == null || source_len == null || start_raw == null || end_raw == null) {
            self.report_error("cannot lower substring operands");
            return null;
        }

        let zero = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i64, 1, 0);
        let start_neg = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_slt(),
                                          start_raw,
                                          zero,
                                          llvm_mir_empty_name(),
                                          0);
        let st = vyx_rt_build_select(self.mod,
                                     start_neg,
                                     zero,
                                     start_raw,
                                     "mir.substr.start".c_str(),
                                     16);
        let end_gt_len = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_sgt(),
                                           end_raw,
                                           source_len,
                                           llvm_mir_empty_name(),
                                           0);
        let en = vyx_rt_build_select(self.mod,
                                     end_gt_len,
                                     source_len,
                                     end_raw,
                                     "mir.substr.end".c_str(),
                                     14);
        let st_ge_len = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_sge(),
                                          st,
                                          source_len,
                                          llvm_mir_empty_name(),
                                          0);
        let en_le_st = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_sle(),
                                         en,
                                         st,
                                         llvm_mir_empty_name(),
                                         0);
        let empty_cond = vyx_rt_build_or(self.mod,
                                         st_ge_len,
                                         en_le_st,
                                         llvm_mir_empty_name(),
                                         0);
        let new_len = vyx_rt_build_sub(self.mod,
                                       en,
                                       st,
                                       "mir.substr.len".c_str(),
                                       14);
        let str_ty = self.get_string_ty();
        let result_slot = vyx_rt_build_alloca(self.mod,
                                             str_ty,
                                             "mir.substr.result".c_str(),
                                             17);
        let empty_name = "mir.substr.empty." + policy_i64_to_string(value_id as i64);
        let alloc_name = "mir.substr.alloc." + policy_i64_to_string(value_id as i64);
        let null_name = "mir.substr.null." + policy_i64_to_string(value_id as i64);
        let fill_name = "mir.substr.fill." + policy_i64_to_string(value_id as i64);
        let join_name = "mir.substr.join." + policy_i64_to_string(value_id as i64);
        let empty_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           empty_name.c_str(),
                                           empty_name.len as u64);
        let alloc_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           alloc_name.c_str(),
                                           alloc_name.len as u64);
        let null_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          null_name.c_str(),
                                          null_name.len as u64);
        let fill_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fill_name.c_str(),
                                          fill_name.len as u64);
        let join_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          join_name.c_str(),
                                          join_name.len as u64);
        if (empty_cond == null
            || new_len == null
            || str_ty == null
            || result_slot == null
            || empty_bb == null
            || alloc_bb == null
            || null_bb == null
            || fill_bb == null
            || join_bb == null) {
            self.report_error("cannot create substring control flow");
            return null;
        }

        vyx_rt_build_cond_br(self.mod, empty_cond, empty_bb, alloc_bb);

        vyx_rt_position_at_end(self.mod, empty_bb);
        let empty_value = self.emit_str_value("");
        if (empty_value == null) {
            self.report_error("cannot lower empty substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, empty_value, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, alloc_bb);
        let alloc_size = vyx_rt_build_add(self.mod,
                                          new_len,
                                          one,
                                          llvm_mir_empty_name(),
                                          0);
        let buf = vyx_rt_build_call1(self.mod,
                                     self.builtin_malloc_fty,
                                     self.builtin_malloc_fn,
                                     alloc_size,
                                     "mir.substr.buf".c_str(),
                                     14);
        let is_null = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        buf,
                                        vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                        llvm_mir_empty_name(),
                                        0);
        if (alloc_size == null || buf == null || is_null == null) {
            self.report_error("cannot allocate substring buffer");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_null, null_bb, fill_bb);

        vyx_rt_position_at_end(self.mod, null_bb);
        let null_empty = self.emit_str_value("");
        if (null_empty == null) {
            self.report_error("cannot lower null substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, null_empty, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, fill_bb);
        let copy_src = self.ptr_offset_bytes(source_ptr, st, "mir.substr.src");
        let copy_end = self.ptr_offset_bytes(buf, new_len, "mir.substr.endptr");
        if (copy_src == null || copy_end == null) {
            self.report_error("cannot compute substring copy pointers");
            return null;
        }
        vyx_rt_build_call3(self.mod,
                           self.builtin_memcpy_fty,
                           self.builtin_memcpy_fn,
                           buf,
                           copy_src,
                           new_len,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_store(self.mod,
                           vyx_rt_const_int(self.mod, self.ty_i8, 0, 0),
                           copy_end);
        let out_value = self.emit_string_value_from_parts(buf,
                                                          new_len,
                                                          alloc_size,
                                                          vyx_rt_const_int(self.mod, self.ty_i64, 1, 0));
        if (out_value == null) {
            self.report_error("cannot assemble substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, out_value, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, join_bb);
        return vyx_rt_build_load(self.mod,
                                 str_ty,
                                 result_slot,
                                 "mir.substr.value".c_str(),
                                 16);
    }

    public fn lower_string_len_call(self, value_id: i32) -> rawptr {
        var receiver_id = self.receiver_for_builtin_member_value(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            receiver_id = self.m.value_lhs(value_id);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string length call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string length receiver is not str ABI");
            return null;
        }
        let value = self.lower_string_view_value(receiver_id);
        if (value == null) {
            self.report_error("cannot lower string length receiver");
            return null;
        }
        return self.string_len_value(value);
    }

    public fn lower_string_is_empty_call(self, value_id: i32) -> rawptr {
        let len_v = self.lower_string_len_call(value_id);
        if (len_v == null) {
            self.report_error("cannot lower string isEmpty receiver");
            return null;
        }
        return self.bool_value_i8(vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_eq(),
                                                    len_v,
                                                    vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                    llvm_mir_empty_name(),
                                                    0));
    }

    public fn lower_string_contains_call(self, value_id: i32) -> rawptr {
        if (self.builtin_string_index_of_fn == null || self.builtin_string_index_of_fty == null) {
            self.report_error("vyx_string_index_of declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("contains requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var needle_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            needle_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let needle_value = self.lower_string_view_value(needle_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let needle_ptr = self.string_ptr_value(needle_value);
        let hay_len = self.string_len_value(hay_value);
        let needle_len = self.string_len_value(needle_value);
        if (hay_value == null
            || needle_value == null
            || hay_ptr == null
            || needle_ptr == null
            || hay_len == null
            || needle_len == null) {
            self.report_error("cannot lower contains string operands");
            return null;
        }
        let found = vyx_rt_build_call4(self.mod,
                                       self.builtin_string_index_of_fty,
                                       self.builtin_string_index_of_fn,
                                       hay_ptr,
                                       hay_len,
                                       needle_ptr,
                                       needle_len,
                                       "mir.str.contains".c_str(),
                                       16);
        if (found == null) {
            self.report_error("cannot emit vyx_string_index_of for contains");
            return null;
        }
        let is_found = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_sge(),
                                         found,
                                         vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                         llvm_mir_empty_name(),
                                         0);
        return self.bool_value_i8(is_found);
    }

    public fn lower_string_starts_with_call(self, value_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("startsWith requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var prefix_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            prefix_id = self.call_arg_at(value_id, 1);
        }
        let hay_ptr = self.string_cstr_from_value(receiver_id);
        let prefix_ptr = self.string_cstr_from_value(prefix_id);
        let hay_len = self.string_len_from_value(receiver_id);
        let prefix_len = self.string_len_from_value(prefix_id);
        if (hay_ptr == null || prefix_ptr == null || hay_len == null || prefix_len == null) {
            self.report_error("cannot lower startsWith string operands");
            return null;
        }
        let prefix_fits = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ule(),
                                            prefix_len,
                                            hay_len,
                                            llvm_mir_empty_name(),
                                            0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            hay_ptr,
                                            prefix_ptr,
                                            prefix_len,
                                            "mir.str.prefix".c_str(),
                                            14);
        if (native_cmp == null) {
            self.report_error("cannot emit strncmp for startsWith");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        return self.bool_value_i8(vyx_rt_build_and(self.mod, prefix_fits, content_same, llvm_mir_empty_name(), 0));
    }

    public fn lower_string_ends_with_call(self, value_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("endsWith requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var suffix_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            suffix_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let suffix_value = self.lower_string_view_value(suffix_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let suffix_ptr = self.string_ptr_value(suffix_value);
        let hay_len = self.string_len_value(hay_value);
        let suffix_len = self.string_len_value(suffix_value);
        if (hay_value == null
            || suffix_value == null
            || hay_ptr == null
            || suffix_ptr == null
            || hay_len == null
            || suffix_len == null) {
            self.report_error("cannot lower endsWith string operands");
            return null;
        }
        let suffix_fits = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ule(),
                                            suffix_len,
                                            hay_len,
                                            llvm_mir_empty_name(),
                                            0);
        let offset = vyx_rt_build_sub(self.mod,
                                      hay_len,
                                      suffix_len,
                                      "mir.str.suffix.offset".c_str(),
                                      21);
        let safe_offset = vyx_rt_build_select(self.mod,
                                              suffix_fits,
                                              offset,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                              "mir.str.suffix.safe.offset".c_str(),
                                              26);
        let suffix_start = self.ptr_offset_bytes(hay_ptr, safe_offset, "mir.str.suffix.ptr");
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            suffix_start,
                                            suffix_ptr,
                                            suffix_len,
                                            "mir.str.suffix".c_str(),
                                            14);
        if (suffix_fits == null || offset == null || safe_offset == null || suffix_start == null || native_cmp == null) {
            self.report_error("cannot emit strncmp for endsWith");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        return self.bool_value_i8(vyx_rt_build_and(self.mod, suffix_fits, content_same, llvm_mir_empty_name(), 0));
    }

    public fn lower_string_index_of_call(self, value_id: i32) -> rawptr {
        if (self.builtin_string_index_of_fn == null || self.builtin_string_index_of_fty == null) {
            self.report_error("vyx_string_index_of declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("indexOf requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var needle_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            needle_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let needle_value = self.lower_string_view_value(needle_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let needle_ptr = self.string_ptr_value(needle_value);
        let hay_len = self.string_len_value(hay_value);
