module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn emit_str_ptr(self, text: string) -> rawptr {
        let cached = llvm_mir_entry_lookup_value(self.str_lit_buf,
                                                 self.string_lit_count,
                                                 text);
        if (cached != null) { return cached; }
        let name = ".str." + policy_i64_to_string(self.string_lit_count as i64);
        let ptr = vyx_rt_const_vyx_string_ptr(self.mod,
                                              text.c_str(),
                                              text.len as u64,
                                              name.c_str(),
                                              name.len as u64);
        if (ptr == null) {
            self.report_error("cannot materialize str literal");
            return null;
        }
        if (self.str_lit_buf == null) {
            self.report_error("str literal cache is unavailable");
            return null;
        }
        let slot = llvm_mir_entry_at(self.str_lit_buf, self.string_lit_count);
        llvm_mir_entry_write(slot, text, ptr, null);
        self.string_lit_count = self.string_lit_count + 1;
        return ptr;
    }

    public fn emit_string_value_from_parts(self, data_ptr: rawptr, len_v: rawptr, cap_v: rawptr, owned_v: rawptr) -> rawptr {
        let st = self.get_string_ty();
        if (st == null || data_ptr == null || len_v == null || cap_v == null || owned_v == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, st, "mir.str.tmp".c_str(), 11);
        if (tmp == null) {
            self.report_error("cannot allocate str temporary");
            return null;
        }
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let p0 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 0, 0), "str.ptr".c_str(), 7);
        let p1 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 1, 0), "str.len".c_str(), 7);
        let p2 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 2, 0), "str.cap".c_str(), 7);
        let p3 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 3, 0), "str.owned".c_str(), 9);
        if (p0 == null || p1 == null || p2 == null || p3 == null) {
            self.report_error("cannot address str fields");
            return null;
        }
        vyx_rt_build_store(self.mod, data_ptr, p0);
        vyx_rt_build_store(self.mod, len_v, p1);
        vyx_rt_build_store(self.mod, cap_v, p2);
        vyx_rt_build_store(self.mod, owned_v, p3);
        return vyx_rt_build_load(self.mod, st, tmp, "str.val".c_str(), 7);
    }

    public fn emit_str_value(self, text: string) -> rawptr {
        let ptr = self.emit_str_ptr(text);
        return self.emit_string_value_from_parts(ptr,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, text.len, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn string_field_value(self, value: rawptr, idx: i32, field_ty: rawptr, name: string) -> rawptr {
        let st = self.get_string_ty();
        if (st == null || value == null || field_ty == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, st, "mir.str.extract".c_str(), 15);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, value, tmp);
        let field = vyx_rt_build_gep2(self.mod,
                                      st,
                                      tmp,
                                      vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                      vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                      name.c_str(),
                                      name.len as u64);
        if (field == null) { return null; }
        return vyx_rt_build_load(self.mod, field_ty, field, name.c_str(), name.len as u64);
    }

    public fn string_ptr_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 0, self.ty_ptr, "str.ptr");
    }

    public fn string_len_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 1, self.ty_i64, "str.len");
    }

    public fn string_cap_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 2, self.ty_i64, "str.cap");
    }

    public fn string_owned_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 3, self.ty_i64, "str.owned");
    }

    public fn ptr_offset_bytes(self, base: rawptr, offset: rawptr, name: string) -> rawptr {
        if (base == null || offset == null) { return null; }
        return vyx_rt_build_gep1(self.mod,
                                 self.ty_i8,
                                 base,
                                 offset,
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn ptr_offset_elements(self, elem_ty: rawptr, base: rawptr, index: rawptr, name: string) -> rawptr {
        if (elem_ty == null || base == null || index == null) { return null; }
        return vyx_rt_build_gep1(self.mod,
                                 elem_ty,
                                 base,
                                 index,
                                 name.c_str(),
                                 name.len as u64);
    }

    // Apply semantic attributes only to runtime declarations created and held
    // here. Foreign C/DCI declarations share the bridge API but must retain
    // their contract-defined behavior rather than inherit name-based hints.
    public fn string_value_from_cstr(self, ptr: rawptr, owned: i64) -> rawptr {
        if (ptr == null) { return null; }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       "mir.strlen".c_str(),
                                       10);
        if (len_v == null) {
            self.report_error("cannot lower C string length");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, owned);
        if (cap_v == null) {
            self.report_error("cannot lower C string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(ptr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, owned, 0));
    }

    public fn string_capacity_for_cstr(self, len_v: rawptr, owned: i64) -> rawptr {
        if (len_v == null) { return null; }
        if (owned == 0) { return vyx_rt_const_int(self.mod, self.ty_i64, 0, 0); }
        return vyx_rt_build_add(self.mod,
                                len_v,
                                vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                llvm_mir_empty_name(),
                                0);
    }

    // The integer length ABIs return malloc-owned NUL-terminated buffers and
    // write their exact payload length. Keep these separate from
    // string_value_from_cstr: foreign/raw C pointers still require strlen.
    public fn string_value_from_integer_to_string(self,
                                                   value: rawptr,
                                                   use_unsigned: bool) -> rawptr {
        if (value == null) { return null; }
        var to_string_fn: rawptr = self.builtin_int_to_string_len_fn;
        var to_string_fty: rawptr = self.builtin_int_to_string_len_fty;
        if (use_unsigned) {
            to_string_fn = self.builtin_uint_to_string_len_fn;
            to_string_fty = self.builtin_uint_to_string_len_fty;
        }
        if (to_string_fn == null || to_string_fty == null) {
            self.report_error("integer to_string length declaration is unavailable");
            return null;
        }
        let len_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.intstr.len".c_str(), 14);
        let args = malloc(16);
        if (len_slot == null || args == null) {
            if (args != null) { free(args); }
            self.report_error("cannot allocate int_to_string length arguments");
            return null;
        }
        ast_write_rawptr(args, value);
        ast_write_rawptr(ptr_offset(args, 8), len_slot);
        let cstr = vyx_rt_build_call(self.mod,
                                     to_string_fty,
                                     to_string_fn,
                                     args,
                                     2,
                                     llvm_mir_empty_name(),
                                     0);
        free(args);
        let len_v = vyx_rt_build_load(self.mod, self.ty_i64, len_slot, "mir.intstr.len.v".c_str(), 16);
        if (cstr == null || len_v == null) {
            self.report_error("cannot lower int_to_string_len result");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, 3);
        if (cap_v == null) {
            self.report_error("cannot compute int_to_string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(cstr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn string_value_from_i64_to_string(self, value: rawptr) -> rawptr {
        return self.string_value_from_integer_to_string(value, false);
    }

    // bool_to_string owns the returned allocation, while its payload length
    // is fixed by the normalized boolean value. Avoid a second C-string scan.
    public fn string_value_from_bool_to_string(self, value: rawptr) -> rawptr {
        if (value == null) { return null; }
        if (self.builtin_bool_to_string_fn == null || self.builtin_bool_to_string_fty == null) {
            self.report_error("bool_to_string declaration is unavailable");
            return null;
        }
        let cstr = vyx_rt_build_call1(self.mod,
                                      self.builtin_bool_to_string_fty,
                                      self.builtin_bool_to_string_fn,
                                      value,
                                      llvm_mir_empty_name(),
                                      0);
        let nonzero = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_ne(),
                                        value,
                                        vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (cstr == null || nonzero == null) {
            self.report_error("cannot lower bool_to_string result");
            return null;
        }
        let len_v = vyx_rt_build_select(self.mod,
                                        nonzero,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                        vyx_rt_const_int(self.mod, self.ty_i64, 5, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (len_v == null) {
            self.report_error("cannot lower bool_to_string result");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, 3);
        if (cap_v == null) {
            self.report_error("cannot compute bool_to_string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(cstr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn string_value_from_cstr_as_type(self, ptr: rawptr, dst_type_id: i32, owned: i64) -> rawptr {
        if (ptr == null || dst_type_id == mir_id_invalid()) { return null; }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       "mir.strlen".c_str(),
                                       10);
        if (len_v == null) {
            self.report_error("cannot lower C string length");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, owned);
        if (cap_v == null) {
            self.report_error("cannot lower C string capacity");
            return null;
        }
        let primitive_value = self.emit_string_value_from_parts(ptr,
                                                                len_v,
                                                                cap_v,
                                                                vyx_rt_const_int(self.mod, self.ty_i64, owned, 0));
        if (primitive_value == null) {
            self.report_error("cannot build str ABI value");
            return null;
        }
        if (self.type_is_str_abi(dst_type_id)) {
            return primitive_value;
        }
        if (self.type_is_std_string_class(dst_type_id)) {
            return self.lower_str_raw_to_std_string_value(primitive_value, dst_type_id);
        }
        self.report_error("string runtime result cannot convert to " + llvm_mir_type_text(&self.m, dst_type_id));
        return null;
    }

    public fn string_value_from_raw_parts_as_type(self,
                                                 ptr: rawptr,
                                                 len_v: rawptr,
                                                 cap_v: rawptr,
                                                 owned_v: rawptr,
                                                 dst_type_id: i32) -> rawptr {
        if (ptr == null || len_v == null || cap_v == null || owned_v == null || dst_type_id == mir_id_invalid()) {
            return null;
        }
        let primitive_value = self.emit_string_value_from_parts(ptr, len_v, cap_v, owned_v);
        if (primitive_value == null) {
            self.report_error("cannot build str ABI value");
            return null;
        }
        if (self.type_is_str_abi(dst_type_id)) {
            return primitive_value;
        }
        if (self.type_is_std_string_class(dst_type_id)) {
            return self.lower_str_raw_to_std_string_value(primitive_value, dst_type_id);
        }
        self.report_error("string runtime result cannot convert to " + llvm_mir_type_text(&self.m, dst_type_id));
        return null;
    }

    public fn alloc_string_data_with_cap(self, len_v: rawptr, cap_v: rawptr) -> rawptr {
        if (len_v == null || cap_v == null) { return null; }
        if (self.builtin_pooled_string_alloc_fn == null || self.builtin_pooled_string_alloc_fty == null) {
            self.report_error("pooled string allocator declaration is unavailable");
            return null;
        }
        let data = vyx_rt_build_call1(self.mod,
                                      self.builtin_pooled_string_alloc_fty,
                                      self.builtin_pooled_string_alloc_fn,
                                      cap_v,
                                      "mir.str.pool.alloc".c_str(),
                                      18);
        if (data == null) {
            self.report_error("cannot allocate str buffer");
            return null;
        }
        let nul_pos = self.ptr_offset_bytes(data, len_v, "mir.str.nul");
        if (nul_pos == null) {
            self.report_error("cannot address str terminator");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), nul_pos);
        return data;
    }

    public fn alloc_string_data_with_cap_malloc(self, len_v: rawptr, cap_v: rawptr) -> rawptr {
        if (len_v == null || cap_v == null) { return null; }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        let data = vyx_rt_build_call1(self.mod,
                                      self.builtin_malloc_fty,
                                      self.builtin_malloc_fn,
                                      cap_v,
                                      "mir.str.malloc.alloc".c_str(),
                                      20);
        if (data == null) {
            self.report_error("cannot allocate str buffer");
            return null;
        }
        let nul_pos = self.ptr_offset_bytes(data, len_v, "mir.str.malloc.nul");
        if (nul_pos == null) {
            self.report_error("cannot address str terminator");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), nul_pos);
        return data;
    }

    public fn alloc_string_data_for_len(self, len_v: rawptr) -> rawptr {
        if (len_v == null) { return null; }
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        return self.alloc_string_data_with_cap(len_v, cap_v);
    }

    public fn copied_string_data_from_cstr_len(self, src: rawptr, len_v: rawptr) -> rawptr {
        if (src == null || len_v == null) { return null; }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return null;
        }
        let dst = self.alloc_string_data_for_len(len_v);
        if (dst == null) { return null; }
        let copied = vyx_rt_build_call3(self.mod,
                                        self.builtin_memcpy_fty,
                                        self.builtin_memcpy_fn,
                                        dst,
                                        src,
                                        len_v,
                                        llvm_mir_empty_name(),
                                        0);
        if (copied == null) {
            self.report_error("cannot copy str buffer");
            return null;
        }
        return dst;
    }
}
