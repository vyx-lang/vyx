module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn lower_operator_eq_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        var other_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) { other_id = self.call_arg_at(value_id, 1); }
        if (receiver_id == mir_id_invalid() || other_id == mir_id_invalid()) {
            self.report_error("operator== requires receiver and one argument");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let other_type = self.m.value_type(other_id);
        if (self.type_is_string_view_type(receiver_type) || self.type_is_string_view_type(other_type)) {
            return self.lower_string_equals_parts(receiver_id, other_id, false);
        }
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0 || llvm_mir_kind_pointer_like(receiver_kind)) {
            var lhs = self.lower_value(receiver_id);
            var rhs = self.lower_value_as(other_id, receiver_type);
            if (lhs == null || rhs == null) {
                self.report_error("cannot lower operator_eq operands");
                return null;
            }
            if (llvm_mir_kind_pointer_handle(receiver_kind)) {
                lhs = self.pointer_handle_address(lhs, "mir.operator_eq.lhs");
                rhs = self.pointer_handle_address(rhs, "mir.operator_eq.rhs");
                if (lhs == null || rhs == null) { return null; }
            }
            return self.bool_value_i8(vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), lhs, rhs, llvm_mir_empty_name(), 0));
        }
        self.report_error("cannot lower operator_eq receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_integral_compare_values(self,
                                            lhs_id: i32,
                                            rhs_id: i32,
                                            receiver_type: i32) -> rawptr {
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let lhs = self.lower_value_as(lhs_id, receiver_type);
        let rhs = self.lower_value_as(rhs_id, receiver_type);
        if (lhs == null || rhs == null) {
            self.report_error("cannot lower compare operands");
            return null;
        }
        var lt_pred = llvm_mir_icmp_slt();
        var gt_pred = llvm_mir_icmp_sgt();
        if (llvm_mir_kind_unsigned(receiver_kind)) {
            lt_pred = llvm_mir_icmp_ult();
            gt_pred = llvm_mir_icmp_ugt();
        }
        let lt = vyx_rt_build_icmp(self.mod, lt_pred, lhs, rhs, llvm_mir_empty_name(), 0);
        let gt = vyx_rt_build_icmp(self.mod, gt_pred, lhs, rhs, llvm_mir_empty_name(), 0);
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let lt_value = vyx_rt_build_select(self.mod, lt, neg_one, zero, llvm_mir_empty_name(), 0);
        return vyx_rt_build_select(self.mod, gt, one, lt_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_float_compare_values(self,
                                         lhs_id: i32,
                                         rhs_id: i32,
                                         receiver_type: i32) -> rawptr {
        let lhs = self.lower_value_as(lhs_id, receiver_type);
        let rhs = self.lower_value_as(rhs_id, receiver_type);
        if (lhs == null || rhs == null) {
            self.report_error("cannot lower floating compare operands");
            return null;
        }
        let zero_i1 = vyx_rt_const_int(self.mod, self.ty_i1, 0, 0);
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let self_nan = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_une(), lhs, lhs, llvm_mir_empty_name(), 0);
        let other_nan = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_une(), rhs, rhs, llvm_mir_empty_name(), 0);
        let self_not_nan = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), self_nan, zero_i1, llvm_mir_empty_name(), 0);
        let other_not_nan = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), other_nan, zero_i1, llvm_mir_empty_name(), 0);
        let both_nan = vyx_rt_build_and(self.mod, self_nan, other_nan, llvm_mir_empty_name(), 0);
        let self_nan_only = vyx_rt_build_and(self.mod, self_nan, other_not_nan, llvm_mir_empty_name(), 0);
        let other_nan_only = vyx_rt_build_and(self.mod, self_not_nan, other_nan, llvm_mir_empty_name(), 0);
        let lt = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_olt(), lhs, rhs, llvm_mir_empty_name(), 0);
        let gt = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_ogt(), lhs, rhs, llvm_mir_empty_name(), 0);
        let lt_value = vyx_rt_build_select(self.mod, lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let gt_value = vyx_rt_build_select(self.mod, gt, one, lt_value, llvm_mir_empty_name(), 0);
        let other_nan_value = vyx_rt_build_select(self.mod,
                                                  other_nan_only,
                                                  neg_one,
                                                  gt_value,
                                                  llvm_mir_empty_name(),
                                                  0);
        let self_nan_value = vyx_rt_build_select(self.mod,
                                                 self_nan_only,
                                                 one,
                                                 other_nan_value,
                                                 llvm_mir_empty_name(),
                                                 0);
        return vyx_rt_build_select(self.mod, both_nan, zero, self_nan_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_string_compare_parts(self, lhs_id: i32, rhs_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_cstr_from_value(lhs_id);
        let rhs_ptr = self.string_cstr_from_value(rhs_id);
        let lhs_len = self.string_len_from_value(lhs_id);
        let rhs_len = self.string_len_from_value(rhs_id);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower string compare operands");
            return null;
        }
        let lhs_shorter = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_slt(),
                                            lhs_len,
                                            rhs_len,
                                            llvm_mir_empty_name(),
                                            0);
        let shared_len = vyx_rt_build_select(self.mod,
                                             lhs_shorter,
                                             lhs_len,
                                             rhs_len,
                                             llvm_mir_empty_name(),
                                             0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            lhs_ptr,
                                            rhs_ptr,
                                            shared_len,
                                            "mir.str.compare".c_str(),
                                            15);
        if (native_cmp == null) {
            self.report_error("cannot emit strncmp for string compare");
            return null;
        }
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let cmp_lt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let cmp_gt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_sgt(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let bytes_lt_value = vyx_rt_build_select(self.mod, cmp_lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let bytes_value = vyx_rt_build_select(self.mod, cmp_gt, one, bytes_lt_value, llvm_mir_empty_name(), 0);
        let bytes_equal = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let len_lt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), lhs_len, rhs_len, llvm_mir_empty_name(), 0);
        let len_gt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_sgt(), lhs_len, rhs_len, llvm_mir_empty_name(), 0);
        let len_lt_value = vyx_rt_build_select(self.mod, len_lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let len_value = vyx_rt_build_select(self.mod, len_gt, one, len_lt_value, llvm_mir_empty_name(), 0);
        return vyx_rt_build_select(self.mod, bytes_equal, len_value, bytes_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_compare_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        var other_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) { other_id = self.call_arg_at(value_id, 1); }
        if (receiver_id == mir_id_invalid() || other_id == mir_id_invalid()) {
            self.report_error("compare requires receiver and one argument");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let other_type = self.m.value_type(other_id);
        if (self.type_is_string_view_type(receiver_type) || self.type_is_string_view_type(other_type)) {
            return self.lower_string_compare_parts(receiver_id, other_id);
        }
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0) {
            return self.lower_integral_compare_values(receiver_id, other_id, receiver_type);
        }
        if (receiver_kind == ty_F32() || receiver_kind == ty_F64()) {
            return self.lower_float_compare_values(receiver_id, other_id, receiver_type);
        }
        self.report_error("cannot lower compare receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_panic_call(self, value_id: i32) -> rawptr {
        var printed = false;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (!self.emit_print_value_mode(cur, true)) { return null; }
            printed = true;
            cur = self.m.value_next_arg(cur);
        }
        if (!printed) {
            if (self.emit_printf_cstr_line(self.emit_str_ptr("panic")) == null) { return null; }
        }
        if (self.builtin_exit_fn == null || self.builtin_exit_fty == null) {
            self.report_error("exit declaration is unavailable for panic lowering");
            return null;
        }
        vyx_rt_build_call1(self.mod,
                           self.builtin_exit_fty,
                           self.builtin_exit_fn,
                           vyx_rt_const_int(self.mod, self.ty_i32, 1, 1),
                           llvm_mir_empty_name(),
                           0);
        let ret_type = self.m.value_type(value_id);
        if (llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) { return null; }
        return vyx_rt_const_null(self.mod, self.lower_type(ret_type));
    }

    public fn lower_string_equals_raw_condition(self, lhs_value: rawptr, rhs_value: rawptr, negate: bool) -> rawptr {
        if (self.builtin_memcmp_fn == null || self.builtin_memcmp_fty == null) {
            self.report_error("memcmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_ptr_value(lhs_value);
        let rhs_ptr = self.string_ptr_value(rhs_value);
        let lhs_len = self.string_len_value(lhs_value);
        let rhs_len = self.string_len_value(rhs_value);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower raw string equality operands");
            return null;
        }
        let nullp = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let empty = self.emit_str_ptr("");
        let lhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            lhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let rhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            rhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let lhs_safe = vyx_rt_build_select(self.mod,
                                           lhs_is_null,
                                           empty,
                                           lhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let rhs_safe = vyx_rt_build_select(self.mod,
                                           rhs_is_null,
                                           empty,
                                           rhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let len_same = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         lhs_len,
                                         rhs_len,
                                         llvm_mir_empty_name(),
                                         0);
        let cmp_len = vyx_rt_build_select(self.mod,
                                          len_same,
                                          lhs_len,
                                          vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                          llvm_mir_empty_name(),
                                          0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcmp_fty,
                                            self.builtin_memcmp_fn,
                                            lhs_safe,
                                            rhs_safe,
                                            cmp_len,
                                            "mir.str.rawcmp".c_str(),
                                            14);
        if (native_cmp == null) {
            self.report_error("cannot emit memcmp for raw string equality");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        let same = vyx_rt_build_and(self.mod, len_same, content_same, llvm_mir_empty_name(), 0);
        if (negate) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     same,
                                     vyx_rt_const_int(self.mod, self.ty_i1, 0, 0),
                                     llvm_mir_empty_name(),
                                     0);
        }
        return same;
    }

    public fn lower_string_equals_condition(self, lhs_id: i32, rhs_id: i32, negate: bool) -> rawptr {
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-string-eq] lhs=" + policy_i64_to_string(lhs_id as i64)
                  + " lhs-kind=" + policy_i64_to_string(self.m.value_kind(lhs_id) as i64)
                  + " lhs-type=" + llvm_mir_type_text(&self.m, self.m.value_type(lhs_id))
                  + " rhs=" + policy_i64_to_string(rhs_id as i64)
                  + " rhs-kind=" + policy_i64_to_string(self.m.value_kind(rhs_id) as i64)
                  + " rhs-type=" + llvm_mir_type_text(&self.m, self.m.value_type(rhs_id))
                  + " negate=" + policy_i64_to_string(negate as i64));
        }
        if (self.builtin_memcmp_fn == null || self.builtin_memcmp_fty == null) {
            self.report_error("memcmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_cstr_from_value(lhs_id);
        let rhs_ptr = self.string_cstr_from_value(rhs_id);
        let lhs_len = self.string_len_from_value(lhs_id);
        let rhs_len = self.string_len_from_value(rhs_id);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower string equality operands");
            return null;
        }
        let nullp = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let empty = self.emit_str_ptr("");
        let lhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            lhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let rhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            rhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let lhs_safe = vyx_rt_build_select(self.mod,
                                           lhs_is_null,
                                           empty,
                                           lhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let rhs_safe = vyx_rt_build_select(self.mod,
                                           rhs_is_null,
                                           empty,
                                           rhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let len_same = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         lhs_len,
                                         rhs_len,
                                         llvm_mir_empty_name(),
                                         0);
        let cmp_len = vyx_rt_build_select(self.mod,
                                          len_same,
                                          lhs_len,
                                          vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                          llvm_mir_empty_name(),
                                          0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcmp_fty,
                                            self.builtin_memcmp_fn,
                                            lhs_safe,
                                            rhs_safe,
                                            cmp_len,
                                            "mir.str.cmp".c_str(),
                                            11);
        if (native_cmp == null) {
            self.report_error("cannot emit memcmp for string equality");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        let same = vyx_rt_build_and(self.mod, len_same, content_same, llvm_mir_empty_name(), 0);
        if (negate) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     same,
                                     vyx_rt_const_int(self.mod, self.ty_i1, 0, 0),
                                     llvm_mir_empty_name(),
                                     0);
        }
        return same;
    }

    public fn lower_string_equals_parts(self, lhs_id: i32, rhs_id: i32, negate: bool) -> rawptr {
        let cond = self.lower_string_equals_condition(lhs_id, rhs_id, negate);
        return self.bool_value_i8(cond);
    }

    public fn lower_string_binary_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        if (op == llvm_mir_tk_PLUS()) { return self.lower_string_concat_value(value_id); }
        if (op == llvm_mir_tk_EQEQ()) {
            return self.lower_string_equals_parts(self.m.value_lhs(value_id), self.m.value_rhs(value_id), false);
        }
        if (op == llvm_mir_tk_NEQ()) {
            return self.lower_string_equals_parts(self.m.value_lhs(value_id), self.m.value_rhs(value_id), true);
        }
        self.report_error("cannot lower string binary op " + policy_i64_to_string(op as i64));
        return null;
    }
}
