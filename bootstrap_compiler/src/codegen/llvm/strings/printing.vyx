module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn emit_printf_cstr(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        let fmt = self.emit_str_ptr("%s");
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_cstr_line(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        let fmt = self.emit_str_ptr("%s\n");
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_pointer(self, ptr: rawptr, newline: bool) -> rawptr {
        if (ptr == null) { return null; }
        var format = "%p";
        if (newline) { format = "%p\n"; }
        let fmt = self.emit_str_ptr(format);
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_str_slice(self, ptr: rawptr, len_v: rawptr) -> rawptr {
        if (ptr == null || len_v == null) { return null; }
        let fmt = self.emit_str_ptr("%.*s");
        let len_i32 = vyx_rt_build_trunc(self.mod, len_v, self.ty_i32, llvm_mir_empty_name(), 0);
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  len_i32,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_str_slice_line(self, ptr: rawptr, len_v: rawptr) -> rawptr {
        if (ptr == null || len_v == null) { return null; }
        let fmt = self.emit_str_ptr("%.*s\n");
        let len_i32 = vyx_rt_build_trunc(self.mod, len_v, self.ty_i32, llvm_mir_empty_name(), 0);
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  len_i32,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_newline(self) -> rawptr {
        let nl = self.emit_str_ptr("\n");
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  nl,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn value_to_cstr(self, value_id: i32) -> rawptr {
        let value_type = self.m.value_type(value_id);
        if (self.type_is_string_view_type(value_type)) {
            return self.string_cstr_from_value(value_id);
        }
        let arg_kind = llvm_mir_type_kind(&self.m, value_type);
        if (arg_kind == ty_STRING()) {
            if (self.m.value_kind(value_id) == mir_value_const_str() && self.m.value_first_arg(value_id) == mir_id_invalid()) {
                return self.emit_str_ptr(self.m.value_text(value_id));
            }
            return self.string_ptr_value(self.lower_value(value_id));
        }
        let bits = llvm_mir_int_bits_for_kind(arg_kind);
        if (bits > 0 && arg_kind != ty_BOOL()) {
            let as_i64 = self.int_value_to_bits(self.lower_value(value_id), value_type, 64);
            if (llvm_mir_kind_decimal_unsigned(arg_kind)) {
                return vyx_rt_build_call1(self.mod,
                                          self.builtin_uint_to_string_fty,
                                          self.builtin_uint_to_string_fn,
                                          as_i64,
                                          llvm_mir_empty_name(),
                                          0);
            }
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_int_to_string_fty,
                                      self.builtin_int_to_string_fn,
                                      as_i64,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (arg_kind == ty_BOOL()) {
            let as_i64_bool = self.int_value_to_bits(self.lower_value(value_id), value_type, 64);
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_int_to_string_fty,
                                      self.builtin_int_to_string_fn,
                                      as_i64_bool,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (llvm_mir_kind_float(arg_kind)) {
            return self.float_value_to_cstr(value_id);
        }
        if (llvm_mir_kind_pointer_like(arg_kind)) {
            return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
        }
        return null;
    }

    public fn lower_float_format_arg(self, value_id: i32) -> rawptr {
        let kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        var v = self.lower_value(value_id);
        if (v == null) {
            self.report_error("cannot lower float value for string formatting");
            return null;
        }
        if (kind == ty_F32()) {
            v = vyx_rt_build_fp_ext(self.mod,
                                    v,
                                    vyx_rt_float_type(self.mod, 64),
                                    llvm_mir_empty_name(),
                                    0);
        }
        if (v == null) {
            self.report_error("cannot promote float value for string formatting");
            return null;
        }
        return v;
    }

    public fn float_value_to_cstr(self, value_id: i32) -> rawptr {
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable for float formatting");
            return null;
        }
        let v = self.lower_float_format_arg(value_id);
        // Match the legacy codegen/std.fmt float string ABI: snprintf("%g").
        let buf = self.malloc_bytes_value(64, "mir.float.tostr.buf");
        let fmt = self.emit_str_ptr("%g");
        if (v == null || buf == null || fmt == null) {
            self.report_error("cannot prepare float formatting buffer");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate float formatting call arguments");
            return null;
        }
        ast_write_rawptr(args, buf);
        ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 64, 0));
        ast_write_rawptr(ptr_offset(args, 16), fmt);
        ast_write_rawptr(ptr_offset(args, 24), v);
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      args,
                                      4 as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(args);
        if (wrote == null) {
            self.report_error("cannot emit float formatting call");
            return null;
        }
        return buf;
    }

    // Use snprintf's sizing result directly for owning string values. This
    // avoids scanning the newly formatted data with strlen and avoids relying
    // on the fixed diagnostic buffer used by float_value_to_cstr.
    public fn float_value_to_string(self, value_id: i32) -> rawptr {
        return self.float_format_arg_to_string(self.lower_float_format_arg(value_id));
    }

    public fn float_format_arg_to_string(self, v: rawptr) -> rawptr {
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable for float string conversion");
            return null;
        }
        let fmt = self.emit_str_ptr("%g");
        if (v == null || fmt == null) {
            self.report_error("cannot prepare float string conversion");
            return null;
        }
        let size_args = malloc(32);
        if (size_args == null) {
            self.report_error("cannot allocate float sizing call arguments");
            return null;
        }
        ast_write_rawptr(size_args, vyx_rt_const_ptr_null(self.mod, self.ty_ptr));
        ast_write_rawptr(ptr_offset(size_args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        ast_write_rawptr(ptr_offset(size_args, 16), fmt);
        ast_write_rawptr(ptr_offset(size_args, 24), v);
        let needed32 = vyx_rt_build_call(self.mod,
                                         self.builtin_snprintf_fty,
                                         self.builtin_snprintf_fn,
                                         size_args,
                                         4 as u64,
                                         llvm_mir_empty_name(),
                                         0);
        free(size_args);
        if (needed32 == null) {
            self.report_error("cannot emit float sizing call");
            return null;
        }
        let sizing_failed = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_slt(),
                                              needed32,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              "mir.float.tostr.failed".c_str(),
                                              22);
        let safe_needed32 = vyx_rt_build_select(self.mod,
                                                 sizing_failed,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                 needed32,
                                                 "mir.float.tostr.safe_len".c_str(),
                                                 24);
        let len_v = vyx_rt_build_sext(self.mod,
                                       safe_needed32,
                                       self.ty_i64,
                                       "mir.float.tostr.len".c_str(),
                                       19);
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                     "mir.float.tostr.cap".c_str(),
                                     19);
        // Float interpolation releases this temporary through the ordinary
        // malloc ownership path. Keep its allocation ABI paired with that
        // release path rather than handing a pooled buffer to free().
        let buf = self.alloc_string_data_with_cap_malloc(len_v, cap_v);
        if (len_v == null || cap_v == null || buf == null) {
            self.report_error("cannot allocate float string output");
            return null;
        }
        let write_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            "mir.float.tostr.write".c_str(),
                                            21);
        let done_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           "mir.float.tostr.done".c_str(),
                                           20);
        if (sizing_failed == null || safe_needed32 == null || write_bb == null || done_bb == null) {
            self.report_error("cannot create float string conversion flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, sizing_failed, done_bb, write_bb);
        vyx_rt_position_at_end(self.mod, write_bb);
        let write_args = malloc(32);
        if (write_args == null) {
            self.report_error("cannot allocate float write call arguments");
            return null;
        }
        ast_write_rawptr(write_args, buf);
        ast_write_rawptr(ptr_offset(write_args, 8), cap_v);
        ast_write_rawptr(ptr_offset(write_args, 16), fmt);
        ast_write_rawptr(ptr_offset(write_args, 24), v);
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      write_args,
                                      4 as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(write_args);
        if (wrote == null) {
            self.report_error("cannot emit float write call");
            return null;
        }
        vyx_rt_build_br(self.mod, done_bb);
        vyx_rt_position_at_end(self.mod, done_bb);
        return self.emit_string_value_from_parts(buf,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 1, 0));
    }

    public fn string_value_is_consumed_temporary(self, value_id: i32, depth: i32) -> bool {
        if (value_id == mir_id_invalid() || depth > 16) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_arg() || kind == mir_value_cast()) {
            return self.string_value_is_consumed_temporary(self.m.value_lhs(value_id), depth + 1);
        }
        if (!self.type_is_string_view_type(self.m.value_type(value_id))) { return false; }
        if (kind == mir_value_const_str()) {
            return self.m.value_first_arg(value_id) != mir_id_invalid();
        }
        if (kind == mir_value_binary()) { return true; }
        if (kind == mir_value_call()) {
            // Every builtin string producer, including clone, has an
            // independent owned result. A concat/f-string consumer may
            // release that rvalue after it has copied its bytes.
            return true;
        }
        return false;
    }

    public fn release_consumed_string_temporary(self,
                                                value_id: i32,
                                                string_value: rawptr) -> bool {
        if (!self.string_value_is_consumed_temporary(value_id, 0)) { return true; }
        if (string_value == null) {
            self.report_error("cannot release consumed string temporary");
            return false;
        }
        let ptr = self.string_ptr_value(string_value);
        let owned = self.string_owned_value(string_value);
        if (ptr == null || owned == null) {
            self.report_error("cannot extract consumed string temporary storage");
            return false;
        }
        return self.release_replaced_string_storage(ptr, owned);
    }

    public fn emit_print_value_mode(self, value_id: i32, newline: bool) -> bool {
        if (value_id == mir_id_invalid()) { return true; }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
            print("[printmode] value=" + policy_i64_to_string(value_id as i64)
                  + " kind=" + policy_i64_to_string(arg_kind as i64)
                  + " nl=" + (newline ? "1" : "0"));
        }
        if (arg_kind == ty_STRING() && self.m.value_kind(value_id) == mir_value_const_str()) {
            var seg = self.m.value_first_arg(value_id);
            if (seg != mir_id_invalid()) {
                var next_seg = self.m.value_next_arg(seg);
                while (seg != mir_id_invalid()) {
                    next_seg = self.m.value_next_arg(seg);
                    if (!self.emit_print_value_mode(seg, newline && (next_seg == mir_id_invalid()))) { return false; }
                    seg = self.m.value_next_arg(seg);
                }
                return true;
            }
            let ptr = self.emit_str_ptr(self.m.value_text(value_id));
            let len_v = vyx_rt_const_int(self.mod, self.ty_i64, self.m.value_text(value_id).len, 0);
            if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptr, len_v); }
            else { self.last_print_call = self.emit_printf_str_slice(ptr, len_v); }
            return self.last_print_call != null;
        }
        if (arg_kind == ty_STRING()) {
            let str_v = self.lower_value(value_id);
            if (newline) {
                self.last_print_call = self.emit_printf_str_slice_line(self.string_ptr_value(str_v),
                                                                        self.string_len_value(str_v));
            } else {
                self.last_print_call = self.emit_printf_str_slice(self.string_ptr_value(str_v),
                                                                  self.string_len_value(str_v));
            }
            if (self.last_print_call == null) { return false; }
            return self.release_consumed_string_temporary(value_id, str_v);
        }
        if (arg_kind == ty_REF() || arg_kind == ty_MUTREF()) {
            // Reference view: print the pointee value, not the address.
            // `print(v[i])` over a `&mut T` operator[] reads like the element.
            let view_elem = hir_type_table_elem(self.m.types, self.m.value_type(value_id));
            if (view_elem != mir_id_invalid()) {
                let view_handle = self.lower_value(value_id);
                var view_addr: rawptr = null;
                if (view_handle != null) { view_addr = self.pointer_handle_address(view_handle, "mir.print.ref"); }
                var view_st: rawptr = null;
                if (view_addr != null) { view_st = self.lower_storage_type(view_elem); }
                if (view_addr != null && view_st != null) {
                    let view_loaded = vyx_rt_build_load(self.mod, view_st, view_addr, llvm_mir_empty_name(), 0);
                    let view_kind = llvm_mir_type_kind(&self.m, view_elem);
                    if (view_loaded != null && view_kind == ty_STRING()) {
                        // A container reference borrows the string storage.
                        // Printing it must preserve the slice length and must
                        // not consume the container's owning buffer.
                        let ptrs = self.string_ptr_value(view_loaded);
                        let lens = self.string_len_value(view_loaded);
                        if (ptrs == null || lens == null) { return false; }
                        if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptrs, lens); }
                        else { self.last_print_call = self.emit_printf_str_slice(ptrs, lens); }
                        return self.last_print_call != null;
                    } else if (view_loaded != null && (view_kind == ty_F32() || view_kind == ty_F64())) {
                        var as_double = view_loaded;
                        if (view_kind == ty_F32()) {
                            as_double = vyx_rt_build_fp_ext(self.mod, view_loaded, vyx_rt_float_type(self.mod, 64),
                                                         llvm_mir_empty_name(), 0);
                        }
                        let str_vf = self.float_format_arg_to_string(as_double);
                        if (str_vf == null) { return false; }
                        let ptrf = self.string_ptr_value(str_vf);
                        let lenf = self.string_len_value(str_vf);
                        let ownedf = self.string_owned_value(str_vf);
                        if (ptrf == null || lenf == null || ownedf == null) { return false; }
                        if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptrf, lenf); }
                        else { self.last_print_call = self.emit_printf_str_slice(ptrf, lenf); }
                        if (self.last_print_call == null) { return false; }
                        return self.release_replaced_string_storage(ptrf, ownedf);
                    } else if (view_loaded != null && view_kind == ty_BOOL()) {
                        let as_i32 = self.int_value_to_bits(view_loaded, view_elem, 32);
                        let str_vb = self.string_value_from_bool_to_string(as_i32);
                        if (str_vb != null) {
                            let ptrb = self.string_ptr_value(str_vb);
                            let lenb = self.string_len_value(str_vb);
                            let ownedb = self.string_owned_value(str_vb);
                            if (ptrb != null && lenb != null && ownedb != null) {
                                if (newline) {
                                    self.last_print_call = self.emit_printf_str_slice_line(ptrb, lenb);
                                } else {
                                    self.last_print_call = self.emit_printf_str_slice(ptrb, lenb);
                                }
                                if (self.last_print_call == null) { return false; }
                                return self.release_replaced_string_storage(ptrb, ownedb);
                            }
                        }
                    } else if (view_loaded != null && llvm_mir_int_bits_for_kind(view_kind) > 0) {
                        let as_i64 = self.int_value_to_bits(view_loaded, view_elem, 64);
                        let str_vi = self.string_value_from_integer_to_string(
                            as_i64,
                            llvm_mir_kind_decimal_unsigned(view_kind));
                        if (str_vi != null) {
                            let ptri = self.string_ptr_value(str_vi);
                            let leni = self.string_len_value(str_vi);
                            let ownedi = self.string_owned_value(str_vi);
                            if (ptri != null && leni != null && ownedi != null) {
                                if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
                                    print("[printref] int-view nl=" + (newline ? "1" : "0"));
                                }
                                // NOTE: Vyx `?:` evaluates BOTH branches — an
                                // if/else is required or both printf forms are
                                // emitted and the value prints twice.
                                if (newline) {
                                    self.last_print_call = self.emit_printf_str_slice_line(ptri, leni);
                                } else {
                                    self.last_print_call = self.emit_printf_str_slice(ptri, leni);
                                }
                                if (self.last_print_call == null) { return false; }
                                return self.release_replaced_string_storage(ptri, ownedi);
                            }
                        }
                    }
                }
            }
            // Non-scalar pointees fall through to the pointer form.
        }
        if (arg_kind == ty_RAWPTR()
            || arg_kind == ty_PTR()
            || arg_kind == ty_REF()
            || arg_kind == ty_MUTREF()
            || arg_kind == ty_CFN()) {
            if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
                print("[printref] ptr-form kind=" + policy_i64_to_string(arg_kind as i64));
            }
            var pointer_value = self.lower_value(value_id);
            if (llvm_mir_kind_pointer_handle(arg_kind)) {
                pointer_value = self.pointer_handle_address(pointer_value, "mir.print.ptr");
            }
            self.last_print_call = self.emit_printf_pointer(pointer_value, newline);
            return self.last_print_call != null;
        }
        // Scalar print must use the same owning string ABI as toString and
        // interpolation. The legacy C-string path lost the known length and
        // rendered booleans as 1/0 through int_to_string.
        let int_bits = llvm_mir_int_bits_for_kind(arg_kind);
        if (int_bits > 0) {
            var str_v2: rawptr = null;
            if (arg_kind == ty_BOOL()) {
                let as_i32 = self.int_value_to_bits(self.lower_value(value_id),
                                                     self.m.value_type(value_id),
                                                     32);
                str_v2 = self.string_value_from_bool_to_string(as_i32);
            } else {
                let as_i64 = self.int_value_to_bits(self.lower_value(value_id),
                                                     self.m.value_type(value_id),
                                                     64);
                str_v2 = self.string_value_from_integer_to_string(
                    as_i64,
                    llvm_mir_kind_decimal_unsigned(arg_kind));
            }
            if (str_v2 == null) {
                self.report_error("cannot lower scalar value for printing");
                return false;
            }
            let ptr2 = self.string_ptr_value(str_v2);
            let len2 = self.string_len_value(str_v2);
            let owned2 = self.string_owned_value(str_v2);
            if (ptr2 == null || len2 == null || owned2 == null) {
                self.report_error("cannot lower scalar value for printing");
                return false;
            }
            if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptr2, len2); }
            else { self.last_print_call = self.emit_printf_str_slice(ptr2, len2); }
            if (self.last_print_call == null) { return false; }
            return self.release_replaced_string_storage(ptr2, owned2);
        }
        let cptr = self.value_to_cstr(value_id);
        if (cptr == null) {
            self.report_error("cannot print value type " + llvm_mir_type_text(&self.m, self.m.value_type(value_id)));
            return false;
        }
        var printed: rawptr = null;
        if (newline) { printed = self.emit_printf_cstr_line(cptr); }
        else { printed = self.emit_printf_cstr(cptr); }
        if (llvm_mir_int_bits_for_kind(arg_kind) > 0) {
            if (self.builtin_runtime_string_free_fn != null
                && self.builtin_runtime_string_free_fty != null) {
                vyx_rt_build_call1(self.mod,
                                   self.builtin_runtime_string_free_fty,
                                   self.builtin_runtime_string_free_fn,
                                   cptr,
                                   llvm_mir_empty_name(),
                                   0);
            }
        } else if (llvm_mir_kind_float(arg_kind)) {
            if (self.builtin_free_fn != null && self.builtin_free_fty != null) {
                vyx_rt_build_call1(self.mod,
                                   self.builtin_free_fty,
                                   self.builtin_free_fn,
                                   cptr,
                                   llvm_mir_empty_name(),
                                   0);
            }
        }
        self.last_print_call = printed;
        return printed != null;
    }

    public fn emit_print_value(self, value_id: i32) -> bool {
        return self.emit_print_value_mode(value_id, false);
    }

    public fn lower_print_like_call(self, value_id: i32, name: string) -> rawptr {
        self.last_print_call = null;
        var cur = self.m.value_first_arg(value_id);
        if (cur == mir_id_invalid()) {
            self.last_print_call = self.emit_printf_newline();
            return self.last_print_call;
        }
        while (cur != mir_id_invalid()) {
            let next = self.m.value_next_arg(cur);
            if (!self.emit_print_value_mode(cur, next == mir_id_invalid())) { return null; }
            cur = next;
        }
        return self.last_print_call;
    }

    public fn concat_cstr_pair(self, lhs: rawptr, rhs: rawptr) -> rawptr {
        // `rhs` is always a freshly lowered segment; null means the segment
        // failed to lower. Swallowing it here used to silently drop
        // interpolation segments (e.g. f64 before float_value_to_cstr existed).
        if (rhs == null) {
            self.report_error("cannot lower interpolated string segment");
            return null;
        }
        if (lhs == null) { return rhs; }
        if (self.builtin_concat_fn == null || self.builtin_concat_fty == null) {
            self.report_error("string concat declaration is unavailable");
            return null;
        }
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_concat_fty,
                                  self.builtin_concat_fn,
                                  lhs,
                                  rhs,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn cstr_for_print_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return self.emit_str_ptr(""); }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        if (arg_kind == ty_STRING()
            && self.m.value_kind(value_id) == mir_value_const_str()
            && self.m.value_first_arg(value_id) != mir_id_invalid()) {
            var acc: rawptr = null;
            var seg = self.m.value_first_arg(value_id);
            while (seg != mir_id_invalid()) {
                acc = self.concat_cstr_pair(acc, self.cstr_for_print_value(seg));
                if (acc == null) { return null; }
                seg = self.m.value_next_arg(seg);
            }
            return acc;
        }
        return self.value_to_cstr(value_id);
    }

    public fn cstr_for_print_call(self, value_id: i32) -> rawptr {
        var acc: rawptr = null;
        var cur = self.m.value_first_arg(value_id);
        if (cur == mir_id_invalid()) { return self.emit_str_ptr(""); }
        while (cur != mir_id_invalid()) {
            acc = self.concat_cstr_pair(acc, self.cstr_for_print_value(cur));
            if (acc == null) { return null; }
            cur = self.m.value_next_arg(cur);
        }
        return acc;
    }

    public fn emit_runtime_print_cstr(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        if (self.builtin_print_fn == null || self.builtin_print_fty == null) {
            self.report_error("print declaration is unavailable");
            return null;
        }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       llvm_mir_empty_name(),
                                       0);
        if (len_v == null) {
            self.report_error("cannot measure print string");
            return null;
        }
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_print_fty,
                                  self.builtin_print_fn,
                                  ptr,
                                  len_v,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn lower_to_string_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("toString requires a receiver");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        if (receiver_kind == ty_STRING()) {
            return self.lower_value(receiver_id);
        }
        if (receiver_kind == ty_BOOL()) {
            let as_i32 = self.int_value_to_bits(self.lower_value(receiver_id), receiver_type, 32);
            return self.string_value_from_bool_to_string(as_i32);
        }
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0) {
            let as_i64 = self.int_value_to_bits(self.lower_value(receiver_id), receiver_type, 64);
            return self.string_value_from_integer_to_string(
                as_i64,
                llvm_mir_kind_decimal_unsigned(receiver_kind));
        }
        if (llvm_mir_kind_float(receiver_kind)) {
            return self.float_value_to_string(receiver_id);
        }
        if (llvm_mir_kind_pointer_like(receiver_kind)) {
            var string_pointer = self.lower_value(receiver_id);
            if (llvm_mir_kind_pointer_handle(receiver_kind)) {
                string_pointer = self.pointer_handle_address(string_pointer, "mir.to_string.ptr");
            }
            let ptr_as_i64 = vyx_rt_build_ptr_to_int(self.mod,
                                                     string_pointer,
                                                     self.ty_i64,
                                                     llvm_mir_empty_name(),
                                                     0);
            return self.string_value_from_i64_to_string(ptr_as_i64);
        }
        self.report_error("cannot lower toString receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_format_vararg_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let type_id = self.m.value_type(value_id);
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (self.type_is_string_view_type(type_id)) {
            return self.string_cstr_from_value(value_id);
        }
        if (kind == ty_F32()) {
            let v = self.lower_value(value_id);
            if (v == null) { return null; }
            return vyx_rt_build_fp_ext(self.mod,
                                       v,
                                       vyx_rt_float_type(self.mod, 64),
                                       llvm_mir_empty_name(),
                                       0);
        }
        if (kind == ty_F64()) { return self.lower_value(value_id); }
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits > 0) {
            return self.int_value_to_bits(self.lower_value(value_id), type_id, 64);
        }
        if (llvm_mir_kind_pointer_like(kind)) {
            return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
        }
        self.report_error("format argument type is unsupported: " + llvm_mir_type_text(&self.m, type_id));
        return null;
    }

    public fn lower_format_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        if (argc <= 0) {
            self.report_error("format requires a format string");
            return null;
        }
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable");
            return null;
        }
        let fmt_id = self.call_arg_at(value_id, 0);
        if (!self.type_is_string_view_type(self.m.value_type(fmt_id))) {
            self.report_error("format first argument must be str-compatible");
            return null;
        }
        let fmt_ptr = self.string_cstr_from_value(fmt_id);
        if (fmt_ptr == null) {
            self.report_error("cannot lower format string");
            return null;
        }
        let extra_count = argc - 1;
        var extra_buf: rawptr = null;
        if (extra_count > 0) {
            extra_buf = malloc((extra_count * 8) as u64);
            if (extra_buf == null) {
                self.report_error("cannot allocate format argument buffer");
                return null;
            }
        }
        var i: i32 = 0;
        while (i < extra_count) {
            let arg_id = self.call_arg_at(value_id, i + 1);
            let arg_value = self.lower_format_vararg_value(arg_id);
            if (arg_value == null) {
                if (extra_buf != null) { free(extra_buf); }
                self.report_error("cannot lower format argument #" + policy_i64_to_string(i as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(extra_buf, i * 8), arg_value);
            i = i + 1;
        }
        let total_arg_count = extra_count + 3;
        let size_args = malloc((total_arg_count * 8) as u64);
        if (size_args == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format sizing call arguments");
            return null;
        }
        ast_write_rawptr(size_args, vyx_rt_const_ptr_null(self.mod, self.ty_ptr));
        ast_write_rawptr(ptr_offset(size_args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        ast_write_rawptr(ptr_offset(size_args, 16), fmt_ptr);
        i = 0;
        while (i < extra_count) {
            ast_write_rawptr(ptr_offset(size_args, (i + 3) * 8),
                             ast_read_rawptr(ptr_offset(extra_buf, i * 8)));
            i = i + 1;
        }
        let needed32 = vyx_rt_build_call(self.mod,
                                         self.builtin_snprintf_fty,
                                         self.builtin_snprintf_fn,
                                         size_args,
                                         total_arg_count as u64,
                                         llvm_mir_empty_name(),
                                         0);
        free(size_args);
        if (needed32 == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot emit format sizing call");
            return null;
        }
        let needed64 = vyx_rt_build_sext(self.mod,
                                         needed32,
                                         self.ty_i64,
                                         "mir.format.len".c_str(),
                                         14);
        let data_size = vyx_rt_build_add(self.mod,
                                         needed64,
                                         vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                         "mir.format.cap".c_str(),
                                         14);
        let out_buf = self.alloc_string_data_with_cap(needed64, data_size);
        if (needed64 == null || data_size == null || out_buf == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format output");
            return null;
        }
        let write_args = malloc((total_arg_count * 8) as u64);
        if (write_args == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format write call arguments");
            return null;
        }
        ast_write_rawptr(write_args, out_buf);
        ast_write_rawptr(ptr_offset(write_args, 8), data_size);
        ast_write_rawptr(ptr_offset(write_args, 16), fmt_ptr);
        i = 0;
        while (i < extra_count) {
            ast_write_rawptr(ptr_offset(write_args, (i + 3) * 8),
                             ast_read_rawptr(ptr_offset(extra_buf, i * 8)));
            i = i + 1;
        }
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      write_args,
                                      total_arg_count as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(write_args);
        if (extra_buf != null) { free(extra_buf); }
        if (wrote == null) {
            self.report_error("cannot emit format write call");
            return null;
        }
        return self.emit_string_value_from_parts(out_buf,
                                                 needed64,
                                                 data_size,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    // These two runtime functions are the only standard-library Arc count
    // primitives. Lower them to LLVM seq_cst operations only for their exact
    // bodyless ABI declarations; arbitrary same-named Vyx functions keep the
    // ordinary call path.
}
