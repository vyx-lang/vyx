module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn type_is_array_iterable(self, type_id: i32) -> bool {
        let collection = self.foreach_collection_type_id(type_id);
        return collection != mir_id_invalid() && llvm_mir_type_kind(&self.m, collection) == ty_ARRAY();
    }

    public fn lower_array_foreach_has_next(self, iter_value: i32, index_place: i32,
                                            body_bb: rawptr, exit_bb: rawptr) {
        let array_type = self.foreach_collection_type_id(self.m.value_type(iter_value));
        let length = self.array_length_for_type(array_type);
        let index_addr = self.lower_place_addr(index_place);
        if (length < 0 || index_addr == null || body_bb == null || exit_bb == null) {
            self.report_error("cannot resolve fixed array foreach bounds");
            return;
        }
        let index = vyx_rt_build_load(self.mod, self.ty_i64, index_addr, llvm_mir_empty_name(), 0);
        let in_range = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), index,
            vyx_rt_const_int(self.mod, self.ty_i64, length, 0), llvm_mir_empty_name(), 0);
        if (in_range == null) { self.report_error("cannot compare fixed array foreach position"); return; }
        vyx_rt_build_cond_br(self.mod, in_range, body_bb, exit_bb);
    }

    public fn lower_array_foreach_bind(self, instr_id: i32) {
        let iter_value = self.m.instr_value(instr_id);
        let array_type = self.foreach_collection_type_id(self.m.value_type(iter_value));
        let element_type = hir_type_table_elem(self.m.types, array_type);
        let destination = self.m.instr_place(instr_id);
        if (element_type == mir_id_invalid() || element_type != self.m.place_type(destination)) {
            self.report_error("fixed array foreach requires its declared element type");
            return;
        }
        if (self.indexed_foreach_payload_requires_clone(element_type)) {
            self.report_error("fixed array foreach of owning elements requires an explicit reference or Clone lowering");
            return;
        }
        let storage = self.indexed_iterable_record_address(iter_value);
        let index_addr = self.lower_place_addr(self.m.instr_aux(instr_id));
        let destination_addr = self.lower_place_addr(destination);
        let array_ll = self.lower_type(array_type);
        let element_ll = self.lower_type(element_type);
        if (storage == null || index_addr == null || destination_addr == null
            || array_ll == null || element_ll == null) {
            self.report_error("cannot address fixed array foreach element");
            return;
        }
        let index = vyx_rt_build_load(self.mod, self.ty_i64, index_addr, llvm_mir_empty_name(), 0);
        let element = vyx_rt_build_gep2(self.mod, array_ll, storage,
            vyx_rt_const_int(self.mod, self.ty_i32, 0, 0), index, llvm_mir_empty_name(), 0);
        if (element == null) { self.report_error("cannot compute fixed array foreach element address"); return; }
        let value = vyx_rt_build_load(self.mod, element_ll, element, llvm_mir_empty_name(), 0);
        if (value == null) { self.report_error("cannot read fixed array foreach element"); return; }
        vyx_rt_build_store(self.mod, value, destination_addr);
        self.advance_indexed_iterable(index_addr, index);
    }
}
