        }
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_memmove_fty,
                                  self.builtin_memmove_fn,
                                  dst,
                                  src,
                                  n,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn lower_memset_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("memset requires exactly three arguments");
            return null;
        }
        if (self.builtin_memset_fn == null || self.builtin_memset_fty == null) {
            self.report_error("memset declaration is unavailable");
            return null;
        }
        let dst_id = self.call_arg_at(value_id, 0);
        let val_id = self.call_arg_at(value_id, 1);
        let n_id = self.call_arg_at(value_id, 2);
        let dst = self.lower_value_as(dst_id, self.type_id_by_text("rawptr"));
        let val = self.int_value_to_bits(self.lower_value(val_id), self.m.value_type(val_id), 32);
        let n = self.int_value_to_bits(self.lower_value(n_id), self.m.value_type(n_id), 64);
        if (dst == null || val == null || n == null) {
            self.report_error("cannot lower memset operands");
            return null;
        }
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_memset_fty,
                                  self.builtin_memset_fn,
                                  dst,
                                  val,
                                  n,
                                  llvm_mir_empty_name(),
                                  0);
    }
}
