module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn lower_atomic_load_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("vyx_atomic_load_i64 requires exactly one argument");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower vyx_atomic_load_i64 pointer");
            return null;
        }
        let out = vyx_rt_build_atomic_load(self.mod,
                                           self.ty_i64,
                                           ptr_v,
                                           "mir.atomic.load.i64".c_str(),
                                           19);
        if (out == null) { self.report_error("cannot emit atomic i64 load"); }
        return out;
    }

    public fn lower_atomic_fetch_add_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("vyx_atomic_fetch_add_i64 requires exactly two arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let delta_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let delta_v = self.int_value_to_bits(self.lower_value(delta_id), self.m.value_type(delta_id), 64);
        if (ptr_v == null || delta_v == null) {
            self.report_error("cannot lower vyx_atomic_fetch_add_i64 operands");
            return null;
        }
        let out = vyx_rt_build_atomicrmw_add(self.mod,
                                             ptr_v,
                                             delta_v,
                                             "mir.atomic.add.i64".c_str(),
                                             18);
        if (out == null) { self.report_error("cannot emit atomic i64 add"); }
        return out;
    }

    public fn lower_atomic_compare_exchange_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("vyx_atomic_compare_exchange_i64 requires exactly three arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let expected_id = self.call_arg_at(value_id, 1);
        let desired_id = self.call_arg_at(value_id, 2);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let expected_v = self.int_value_to_bits(self.lower_value(expected_id),
                                                self.m.value_type(expected_id),
                                                64);
        let desired_v = self.int_value_to_bits(self.lower_value(desired_id),
                                               self.m.value_type(desired_id),
                                               64);
        if (ptr_v == null || expected_v == null || desired_v == null) {
            self.report_error("cannot lower vyx_atomic_compare_exchange_i64 operands");
            return null;
        }
        let out = vyx_rt_build_atomic_cmpxchg(self.mod,
                                              ptr_v,
                                              expected_v,
                                              desired_v,
                                              "mir.atomic.cmpxchg.i64".c_str(),
                                              22);
        if (out == null) { self.report_error("cannot emit atomic i64 compare/exchange"); }
        return out;
    }

    public fn lower_malloc_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("malloc requires exactly one argument");
            return null;
        }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let size_v = self.int_value_to_bits(self.lower_value(arg_id), self.m.value_type(arg_id), 64);
        if (size_v == null) {
            self.report_error("cannot lower malloc size argument");
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_malloc_fty,
                                  self.builtin_malloc_fn,
                                  size_v,
                                  "mir.malloc".c_str(),
                                  10);
    }

    public fn lower_free_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("free requires exactly one argument");
            return null;
        }
        if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
            self.report_error("free declaration is unavailable");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let raw_v = self.lower_value(arg_id);
        if (raw_v == null) {
            self.report_error("cannot lower free pointer argument");
            return null;
        }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(arg_id));
        var ptr_v = raw_v;
        if (llvm_mir_kind_pointer_handle(arg_kind)) {
            let metadata = self.pointer_handle_metadata(raw_v, "mir.free");
            if (metadata == null) {
                self.report_error("cannot extract pointer region for free");
                return null;
            }
            let released_address = self.pointer_region_delete(metadata);
            if (released_address == null) {
                self.report_error("cannot invalidate pointer region for free");
                return null;
            }
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_free_fty,
                                      self.builtin_free_fn,
                                      released_address,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (!llvm_mir_kind_pointer_like(arg_kind)) {
            let bits = llvm_mir_int_bits_for_kind(arg_kind);
            if (bits <= 0) {
                self.report_error("free pointer argument is not pointer-like");
                return null;
            }
            var as_int = raw_v;
            if (bits < 64) { as_int = vyx_rt_build_zext(self.mod, raw_v, self.ty_i64, llvm_mir_empty_name(), 0); }
            if (bits > 64) { as_int = vyx_rt_build_trunc(self.mod, raw_v, self.ty_i64, llvm_mir_empty_name(), 0); }
            ptr_v = vyx_rt_build_int_to_ptr(self.mod, as_int, self.ty_ptr, llvm_mir_empty_name(), 0);
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_free_fty,
                                  self.builtin_free_fn,
                                  ptr_v,
                                  llvm_mir_empty_name(),
                                   0);
    }

    public fn lower_transmute_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("transmute requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let dst_type = self.m.value_type(value_id);
        let arg_type = self.m.value_type(arg_id);
        let arg_value = self.lower_value(arg_id);
        if (arg_value == null || dst_type == mir_id_invalid()) {
            self.report_error("cannot lower transmute operand");
            return null;
        }
        if (arg_type == dst_type) { return arg_value; }
        let arg_kind = llvm_mir_type_kind(&self.m, arg_type);
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type);
        if (llvm_mir_kind_pointer_like(arg_kind) && llvm_mir_kind_pointer_like(dst_kind)) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        if (llvm_mir_kind_pointer_like(arg_kind) && llvm_mir_int_bits_for_kind(dst_kind) > 0) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        if (llvm_mir_int_bits_for_kind(arg_kind) > 0 && llvm_mir_kind_pointer_like(dst_kind)) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        return self.cast_value(arg_value, arg_type, dst_type);
    }

    public fn lower_realloc_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("realloc requires exactly two arguments");
            return null;
        }
        if (self.builtin_realloc_fn == null || self.builtin_realloc_fty == null) {
            self.report_error("realloc declaration is unavailable");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let size_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let size_v = self.int_value_to_bits(self.lower_value(size_id), self.m.value_type(size_id), 64);
        if (ptr_v == null || size_v == null) {
            self.report_error("cannot lower realloc operands");
            return null;
        }
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_realloc_fty,
                                  self.builtin_realloc_fn,
                                  ptr_v,
                                  size_v,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn lower_memcmp_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("memcmp requires exactly three arguments");
            return null;
        }
        if (self.builtin_memcmp_fn == null || self.builtin_memcmp_fty == null) {
            self.report_error("memcmp declaration is unavailable");
            return null;
        }
        let lhs_id = self.call_arg_at(value_id, 0);
        let rhs_id = self.call_arg_at(value_id, 1);
        let len_id = self.call_arg_at(value_id, 2);
        let lhs_v = self.lower_value_as(lhs_id, self.type_id_by_text("rawptr"));
        let rhs_v = self.lower_value_as(rhs_id, self.type_id_by_text("rawptr"));
        let len_v = self.int_value_to_bits(self.lower_value(len_id), self.m.value_type(len_id), 64);
        if (lhs_v == null || rhs_v == null || len_v == null) {
            self.report_error("cannot lower memcmp operands");
            return null;
        }
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_memcmp_fty,
                                  self.builtin_memcmp_fn,
                                  lhs_v,
                                  rhs_v,
                                  len_v,
                                  "mir.memcmp".c_str(),
                                  10);
    }

    public fn lower_to_rawptr_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("to_rawptr requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let arg_kind = self.m.value_kind(arg_id);
        let rawptr_type = self.type_id_by_text("rawptr");
        if (arg_kind == mir_value_address_of()) {
            let place_id = self.m.value_place(arg_id);
            let addr = self.lower_place_addr(place_id);
            if (addr == null) {
                self.report_error("cannot lower to_rawptr place argument");
                return null;
            }
            let place_type = self.place_effective_type(place_id);
            if (self.type_is_class_pointer_abi(place_type)) {
                return self.ensure_class_object_addr_from_place_addr(place_id, addr, place_type);
            }
            return addr;
        }
        let arg_type_id = self.m.value_type(arg_id);
        let arg_type_kind = llvm_mir_type_kind(&self.m, arg_type_id);
        let arg_value = self.lower_value(arg_id);
        if (arg_value == null) {
            self.report_error("cannot lower to_rawptr value argument");
            return null;
        }
        if (self.type_is_str_abi(arg_type_id)) {
            return self.string_ptr_value(arg_value);
        }
        if (self.type_is_class_pointer_abi(arg_type_id)) {
            return arg_value;
        }
        if (llvm_mir_kind_pointer_like(arg_type_kind)) {
            return self.cast_value(arg_value, arg_type_id, rawptr_type);
        }
        let arg_bits = llvm_mir_int_bits_for_kind(arg_type_kind);
        if (arg_bits > 0) {
            return self.cast_value(arg_value, arg_type_id, rawptr_type);
        }
        let arg_type = self.lower_type(arg_type_id);
        if (arg_type == null) {
            self.report_error("cannot lower to_rawptr value argument");
            return null;
        }
        let slot = vyx_rt_build_alloca(self.mod,
                                       arg_type,
                                       "mir.to_rawptr.tmp".c_str(),
                                       17);
        if (slot == null) {
            self.report_error("cannot allocate to_rawptr temporary");
            return null;
        }
        vyx_rt_build_store(self.mod, arg_value, slot);
        return slot;
    }

    public fn lower_ptr_offset_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("ptr_offset requires exactly two arguments");
            return null;
        }
        let base_id = self.call_arg_at(value_id, 0);
        let offset_id = self.call_arg_at(value_id, 1);
        let base = self.lower_value_as(base_id, self.type_id_by_text("rawptr"));
        let offset = self.int_value_to_bits(self.lower_value(offset_id), self.m.value_type(offset_id), 64);
        if (base == null || offset == null) {
            self.report_error("cannot lower ptr_offset operands");
            return null;
        }
        return self.ptr_offset_bytes(base, offset, "mir.ptr.offset");
    }

    public fn lower_ptr_read_call(self, value_id: i32, builtin_name: string) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error(builtin_name + " requires exactly one argument");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower pointer operand for " + builtin_name);
            return null;
        }
        if (builtin_name == "ptr_read_u8") {
            let loaded_u8 = vyx_rt_build_load(self.mod,
                                              self.ty_i8,
                                              ptr_v,
                                              "mir.ptr.read.u8".c_str(),
                                              15);
            if (loaded_u8 == null) {
                self.report_error("cannot lower ptr_read_u8 load");
                return null;
            }
            return vyx_rt_build_zext(self.mod, loaded_u8, self.ty_i32, llvm_mir_empty_name(), 0);
        }
        if (builtin_name == "ptr_read_i32") {
            return vyx_rt_build_load(self.mod,
                                     self.ty_i32,
                                     ptr_v,
                                     "mir.ptr.read.i32".c_str(),
                                     16);
        }
        if (builtin_name == "ptr_read_i64") {
            return vyx_rt_build_load(self.mod,
                                     self.ty_i64,
                                     ptr_v,
                                     "mir.ptr.read.i64".c_str(),
                                     16);
        }
        self.report_error("unknown pointer read builtin " + builtin_name);
        return null;
    }

    public fn lower_ptr_write_call(self, value_id: i32, builtin_name: string) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error(builtin_name + " requires exactly two arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let value_arg_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower pointer operand for " + builtin_name);
            return null;
        }
        if (builtin_name == "ptr_write_i32") {
            let value_i32 = self.int_value_to_bits(self.lower_value(value_arg_id), self.m.value_type(value_arg_id), 32);
            if (value_i32 == null) {
                self.report_error("cannot lower ptr_write_i32 value");
                return null;
            }
            vyx_rt_build_store(self.mod, value_i32, ptr_v);
            return null;
        }
        if (builtin_name == "ptr_write_i64") {
            let value_i64 = self.int_value_to_bits(self.lower_value(value_arg_id), self.m.value_type(value_arg_id), 64);
            if (value_i64 == null) {
                self.report_error("cannot lower ptr_write_i64 value");
                return null;
            }
            vyx_rt_build_store(self.mod, value_i64, ptr_v);
            return null;
        }
        self.report_error("unknown pointer write builtin " + builtin_name);
        return null;
    }

    public fn lower_memcpy_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("memcpy requires exactly three arguments");
            return null;
        }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return null;
        }
        let dst_id = self.call_arg_at(value_id, 0);
        let src_id = self.call_arg_at(value_id, 1);
        let n_id = self.call_arg_at(value_id, 2);
        let dst = self.lower_value_as(dst_id, self.type_id_by_text("rawptr"));
        let src = self.lower_value_as(src_id, self.type_id_by_text("rawptr"));
        let n = self.int_value_to_bits(self.lower_value(n_id), self.m.value_type(n_id), 64);
        if (dst == null || src == null || n == null) {
            self.report_error("cannot lower memcpy operands");
            return null;
        }
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_memcpy_fty,
                                  self.builtin_memcpy_fn,
                                  dst,
                                  src,
                                  n,
                                  llvm_mir_empty_name(),
                                  0);
    }

