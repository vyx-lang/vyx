module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn dyn_trait_name(self, type_id: i32) -> string {
        if (!self.type_is_dyn_trait(type_id)) { return ""; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len <= 3) { return ""; }
        return from_cstr_len(text.c_str() + 3, text.len - 3);
    }

    public fn type_text_matches_dyn_trait_name(self, text: string, dyn_type_id: i32) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || text.len == 0) { return false; }
        let dyn_text = llvm_mir_type_text(&self.m, dyn_type_id);
        let trait_text = self.dyn_trait_name(dyn_type_id);
        if (text == dyn_text || text == trait_text) { return true; }
        if (policy_type_name_equal(text, trait_text)) { return true; }
        let text_base = policy_generic_call_base(text.clone());
        let trait_base = policy_generic_call_base(trait_text.clone());
        if (llvm_mir_last_path_segment(text_base) == llvm_mir_last_path_segment(trait_base)) { return true; }
        return false;
    }

    public fn interface_name_matches(self, a: string, b: string) -> bool {
        if (a.len == 0 || b.len == 0) { return false; }
        if (a == b || policy_type_name_equal(a, b)) { return true; }
        let abase = policy_generic_call_base(a.clone());
        let bbase = policy_generic_call_base(b.clone());
        if (abase == bbase || policy_type_name_equal(abase, bbase)) { return true; }
        return llvm_mir_last_path_segment(abase) == llvm_mir_last_path_segment(bbase);
    }

    public fn interface_extends_trait_name(self, iface_name: string, target_trait: string, depth: i32) -> bool {
        if (iface_name.len == 0 || target_trait.len == 0) { return false; }
        if (self.interface_name_matches(iface_name, target_trait)) { return true; }
        if (depth > 16) { return false; }
        let rows = mir_unit_interface_supers(&self.m);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= rows.len) {
            if (i == rows.len || rows.charAt(i) == 59) {
                var sep: i32 = -1;
                var j = start;
                while (j < i) {
                    if (rows.charAt(j) == 62 && sep < 0) { sep = j; }
                    j = j + 1;
                }
                if (sep > start && sep + 1 < i) {
                    let child = rows.substring(start, sep);
                    let parent = rows.substring(sep + 1, i);
                    if (self.interface_name_matches(child, iface_name)) {
                        if (self.interface_name_matches(parent, target_trait)) { return true; }
                        if (self.interface_extends_trait_name(parent, target_trait, depth + 1)) {
                            return true;
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn dyn_trait_extends_type_text(self, dyn_type_id: i32, target_trait: string) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || target_trait.len == 0) { return false; }
        let trait_text = self.dyn_trait_name(dyn_type_id);
        if (trait_text.len == 0) { return false; }
        return self.interface_extends_trait_name(trait_text, target_trait, 0);
    }

    public fn interface_function_matches_dyn_trait(self, fn_id: i32, dyn_type_id: i32) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id)) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, fn_id) != hir_item_interface()) { return false; }
        let owner_type_text = self.m.function_owner_type(fn_id);
        if (self.type_text_matches_dyn_trait_name(owner_type_text, dyn_type_id)
            || self.dyn_trait_extends_type_text(dyn_type_id, owner_type_text)) {
            return true;
        }
        let self_type = self.function_source_param_type(fn_id, 0);
        if (self_type != mir_id_invalid()
            && (self.type_text_matches_dyn_trait_name(llvm_mir_type_text(&self.m, self_type), dyn_type_id)
                || self.dyn_trait_extends_type_text(dyn_type_id, llvm_mir_type_text(&self.m, self_type)))) {
            return true;
        }
        return false;
    }

    public fn string_compare_lex(self, left: string, right: string) -> i32 {
        var idx: i32 = 0;
        while (idx < left.len && idx < right.len) {
            let lc = left.charAt(idx);
            let rc = right.charAt(idx);
            if (lc < rc) { return -1; }
            if (lc > rc) { return 1; }
            idx = idx + 1;
        }
        if (left.len < right.len) { return -1; }
        if (left.len > right.len) { return 1; }
        return 0;
    }

    public fn dyn_trait_type_abi_key(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return "?"; }
        var text = llvm_mir_type_text(&self.m, type_id);
        if (llvm_mir_is_primitive_str_name(text)) { text = "str"; }
        if (text.len == 0) { return "?"; }
        return text;
    }

    public fn dyn_trait_method_abi_key(self, function_id: i32) -> string {
        if (function_id == mir_id_invalid()) { return ""; }
        var out = self.function_method_name(function_id) + "(";
        var idx: i32 = 1;
        let count = self.function_source_param_count(function_id);
        while (idx < count) {
            if (idx > 1) { out = out + ","; }
            out = out + self.dyn_trait_type_abi_key(self.function_source_param_type(function_id, idx));
            idx = idx + 1;
        }
        out = out + ")->" + self.dyn_trait_type_abi_key(self.m.function_return_type(function_id));
        return out;
    }

    public fn dyn_trait_method_key_duplicate_before(self, type_id: i32, fn_id: i32) -> bool {
        if (!self.interface_function_matches_dyn_trait(fn_id, type_id)) { return false; }
        let wanted_order = self.dyn_trait_method_order_key(fn_id);
        let wanted_name = self.function_method_name(fn_id);
        var cur: i32 = 1;
        while (cur <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(cur, type_id)
                && self.dyn_trait_method_order_key(cur) < wanted_order
                && self.function_method_name(cur) == wanted_name
                && self.dyn_trait_method_signature_matches(cur, fn_id)) {
                return true;
            }
            cur = cur + 1;
        }
        return false;
    }

    public fn dyn_trait_method_duplicate_before(self, type_id: i32, fn_id: i32) -> bool {
        return self.dyn_trait_method_key_duplicate_before(type_id, fn_id);
    }

    public fn dyn_trait_method_order_key(self, function_id: i32) -> i32 {
        if (function_id == mir_id_invalid()) { return 2147483647; }
        let item_id = self.m.function_hir_item(function_id);
        if (item_id > 0) { return item_id; }
        return 1073741824 + function_id;
    }

    public fn dyn_trait_method_count_uncached(self, type_id: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id)) { return 0; }
        var out: i32 = 0;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(fn_id, type_id)
                && !self.dyn_trait_method_duplicate_before(type_id, fn_id)) {
                out = out + 1;
            }
            fn_id = fn_id + 1;
        }
        return out;
    }

    public fn dyn_trait_method_at_uncached(self, type_id: i32, wanted: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id) || wanted < 0) { return mir_id_invalid(); }
        var emitted: i32 = 0;
        var have_last = false;
        var last_order: i32 = -1;
        while (emitted <= wanted) {
            var best_fn = mir_id_invalid();
            var best_order = 2147483647;
            var fn_id: i32 = 1;
            while (fn_id <= self.m.function_count) {
                if (self.interface_function_matches_dyn_trait(fn_id, type_id)
                    && !self.dyn_trait_method_duplicate_before(type_id, fn_id)) {
                    let order = self.dyn_trait_method_order_key(fn_id);
                    if ((!have_last || order > last_order) && order < best_order) {
                        best_fn = fn_id;
                        best_order = order;
                    }
                }
                fn_id = fn_id + 1;
            }
            if (best_fn == mir_id_invalid()) { return mir_id_invalid(); }
            if (emitted == wanted) { return best_fn; }
            last_order = best_order;
            have_last = true;
            emitted = emitted + 1;
        }
        return mir_id_invalid();
    }

    public fn ensure_dyn_trait_method_cache(self, type_id: i32) {
        if (!self.type_is_dyn_trait(type_id)) { return; }
        let cached_count = llvm_mir_i32_map_get(self.dyn_trait_method_counts, type_id);
        if (cached_count != 0) { return; }
        let max_count = self.m.function_count;
        let list = malloc((max_count * 4) as u64);
        if (list == null) {
            llvm_mir_i32_map_put(self.dyn_trait_method_counts, type_id, 1);
            return;
        }
        var count: i32 = 0;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(fn_id, type_id)) {
                let order = self.dyn_trait_method_order_key(fn_id);
                var duplicate = false;
                var idx: i32 = 0;
                while (idx < count) {
                    let existing = ast_read_i32(ptr_offset(list, idx * 4));
                    if (self.function_method_name(existing) == self.function_method_name(fn_id)
                        && self.dyn_trait_method_signature_matches(existing, fn_id)) {
                        duplicate = true;
                        if (order < self.dyn_trait_method_order_key(existing)) {
                            ast_write_i32(ptr_offset(list, idx * 4), fn_id);
                        }
                        break;
                    }
                    idx = idx + 1;
                }
                if (!duplicate) {
                    var pos = count;
                    while (pos > 0
                        && order < self.dyn_trait_method_order_key(ast_read_i32(ptr_offset(list, (pos - 1) * 4)))) {
                        ast_write_i32(ptr_offset(list, pos * 4),
                                      ast_read_i32(ptr_offset(list, (pos - 1) * 4)));
                        pos = pos - 1;
                    }
                    ast_write_i32(ptr_offset(list, pos * 4), fn_id);
                    count = count + 1;
                }
            }
            fn_id = fn_id + 1;
        }
        llvm_mir_i32_map_put(self.dyn_trait_method_counts, type_id, count + 1);
        if (count <= 0) {
            free(list);
            return;
        }
        llvm_mir_map_put(self.dyn_trait_method_lists, type_id, list);
    }

    public fn dyn_trait_method_count(self, type_id: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id)) { return 0; }
        self.ensure_dyn_trait_method_cache(type_id);
        let cached = llvm_mir_i32_map_get(self.dyn_trait_method_counts, type_id);
        if (cached <= 0) { return 0; }
        return cached - 1;
    }

    public fn dyn_trait_method_at(self, type_id: i32, wanted: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id) || wanted < 0) { return mir_id_invalid(); }
        self.ensure_dyn_trait_method_cache(type_id);
        let count = self.dyn_trait_method_count(type_id);
        if (wanted >= count) { return mir_id_invalid(); }
        let list = llvm_mir_map_get(self.dyn_trait_method_lists, type_id);
        if (list == null) { return mir_id_invalid(); }
        return ast_read_i32(ptr_offset(list, wanted * 4));
    }

    public fn dyn_trait_interface_struct_name(self, type_id: i32) -> string {
        let iface_name = self.dyn_trait_name(type_id);
        if (iface_name.len == 0) { return ""; }
        return "__iface_" + policy_mangle_part(iface_name);
    }

    public fn dyn_trait_vtable_struct_name(self, type_id: i32) -> string {
        let iface_name = self.dyn_trait_name(type_id);
        if (iface_name.len == 0) { return ""; }
        return policy_mangle_part(iface_name) + "_vtable";
    }

    public fn get_or_create_dyn_trait_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let is_dyn = self.type_is_dyn_trait(type_id);
        if (!is_dyn) { return null; }
        let iface_name = self.dyn_trait_name(type_id);
        var name = "";
        if (iface_name.len > 0) {
            name = "__iface_" + policy_mangle_part(iface_name);
        }
        if (name.len == 0) { return null; }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create dyn trait type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate dyn trait field list for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize dyn trait type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn get_or_create_dyn_trait_vtable_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.dyn_vtable_type_values, type_id);
        if (cached != null) { return cached; }
        if (!self.type_is_dyn_trait(type_id)) { return null; }
        let slot_count = self.dyn_trait_method_count(type_id);
        if (slot_count <= 0) {
            self.report_error("dyn trait has no vtable methods: " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let name = self.dyn_trait_vtable_struct_name(type_id);
        if (name.len == 0) { return null; }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create dyn trait vtable type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.dyn_vtable_type_values, type_id, st);
        let fields = malloc((slot_count * 8) as u64);
        if (fields == null) {
            self.report_error("cannot allocate dyn trait vtable field list for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var idx: i32 = 0;
        while (idx < slot_count) {
            ast_write_rawptr(ptr_offset(fields, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, slot_count as u64, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize dyn trait vtable type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn build_dyn_method_adapter_type(self, prototype_fn: i32) -> rawptr {
        let source_count = self.function_source_param_count(prototype_fn);
        if (source_count <= 0) {
            self.report_error("dyn trait method has no receiver: " + self.m.function_name(prototype_fn));
            return null;
        }
        var params: rawptr = null;
        if (source_count > 0) {
            params = malloc((source_count * 8) as u64);
            if (params == null) {
                self.report_error("cannot allocate dyn method adapter signature for " + self.m.function_name(prototype_fn));
                return null;
            }
        }
        ast_write_rawptr(params, self.ty_ptr);
        var idx: i32 = 1;
        while (idx < source_count) {
            let param_type = self.function_source_param_type(prototype_fn, idx);
            if (param_type == mir_id_invalid()) {
                if (params != null) { free(params); }
                self.report_error("cannot resolve dyn method adapter parameter #" + policy_i64_to_string(idx as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(params, idx * 8), self.lower_type(param_type));
            idx = idx + 1;
        }
        let fty = vyx_rt_fn_type(self.mod,
                                 self.lower_type(self.m.function_return_type(prototype_fn)),
                                 params,
                                 source_count as u64,
                                 0);
        if (params != null) { free(params); }
        return fty;
    }

    public fn concrete_function_matches_dyn_method(self, prototype_fn: i32, concrete_fn: i32) -> bool {
        if (prototype_fn == mir_id_invalid() || concrete_fn == mir_id_invalid()) { return false; }
        if (!self.function_has_callable_body_or_import(concrete_fn)) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return false; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return false; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = self.function_source_param_count(concrete_fn);
        if (proto_count <= 0 || concrete_count != proto_count) { return false; }
        let concrete_self = self.function_source_param_type(concrete_fn, 0);
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn), self.m.function_return_type(concrete_fn))) {
            return false;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          self.function_source_param_type(concrete_fn, idx))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    // ── dyn materialization diagnostics (`VYX_DYN_PROBE=1`) ─────────────
    // Diagnostic twin of concrete_function_matches_dyn_method: identical
    // decision chain, but returns the first failing step as a code so a
    // `[dyn-probe]` trace can name the exact reason a concrete method was
    // rejected.  0 = accepted.
    public fn dyn_method_match_reason(self, prototype_fn: i32, concrete_fn: i32) -> i32 {
        if (prototype_fn == mir_id_invalid() || concrete_fn == mir_id_invalid()) { return 1; }
        if (!self.function_has_callable_body_or_import(concrete_fn)) { return 2; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return 3; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return 4; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = self.function_source_param_count(concrete_fn);
        if (proto_count <= 0 || concrete_count != proto_count) { return 5; }
        let concrete_self = self.function_source_param_type(concrete_fn, 0);
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return 6; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn),
                                      self.m.function_return_type(concrete_fn))) {
            return 7;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          self.function_source_param_type(concrete_fn, idx))) {
                return 8;
            }
            idx = idx + 1;
        }
        return 0;
    }

    public fn dyn_probe_list_fns(self, tag: string) {
        var rec_count: i32 = 0;
        var meth_count: i32 = 0;
        var names: string = "";
        var f: i32 = 1;
        while (f <= self.m.function_count) {
            let nm = self.m.function_name(f);
            if (nm.contains("BaseRecord")) { rec_count = rec_count + 1; }
            let mn = self.function_method_name(f);
            if (mn == "id" || mn == "score") {
                meth_count = meth_count + 1;
                if (meth_count <= 12) {
                    names = names + "\n[dyn-probe]     #" + policy_i64_to_string(f as i64)
                            + " m=" + mn + " " + nm;
                }
            }
            f = f + 1;
        }
        print("[dyn-probe] " + tag
              + " mir_fn_count=" + policy_i64_to_string(self.m.function_count as i64)
              + " BaseRecord_named=" + policy_i64_to_string(rec_count as i64)
              + " id_or_score_methods=" + policy_i64_to_string(meth_count as i64) + names);
    }

    public fn dyn_probe_dump(self, src_type_id: i32, prototype_fn: i32) {
        let method_name = self.function_method_name(prototype_fn);
        var head: string = "[dyn-probe] src=" + llvm_mir_type_text(&self.m, src_type_id)
                           + " proto=" + method_name
                           + " fn_count=" + policy_i64_to_string(self.m.function_count as i64)
                           + " cgu=" + policy_i64_to_string(self.cgu_emit_index as i64)
                           + " index_ready=";
        if (self.method_candidate_index_ready) { head = head + "1"; } else { head = head + "0"; }
        print(head);
        var pc = self.method_candidate_head(method_name.clone());
        var seen: i32 = 0;
        while (pc != null) {
            let cand = ast_read_i32(pc);
            print("[dyn-probe]   cand#" + policy_i64_to_string(cand as i64)
                  + " " + self.m.function_name(cand)
                  + " reason=" + policy_i64_to_string(self.dyn_method_match_reason(prototype_fn, cand) as i64)
                  + " self=" + llvm_mir_type_text(&self.m, self.function_source_param_type(cand, 0)));
            seen = seen + 1;
            pc = ast_read_rawptr(ptr_offset(pc, 8));
        }
        print("[dyn-probe]   candidates=" + policy_i64_to_string(seen as i64));
        var f: i32 = 1;
        while (f <= self.m.function_count) {
            let nm = self.m.function_name(f);
            if (nm.contains("BaseRecord") || nm.contains("WeightedRecord")) {
                var flags: string = " bodyless=";
                if (self.function_is_bodyless(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                flags = flags + " callable=";
                if (self.function_has_callable_body_or_import(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                flags = flags + " emitted=";
                if (self.function_definition_was_emitted(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                print("[dyn-probe]   fn#" + policy_i64_to_string(f as i64) + " " + nm + flags);
            }
            f = f + 1;
        }
    }

    // ── `dyn` lookup fallback over the codegen partition ────────────────
    // Sibling units are invisible to `method_candidate_head`: their bodies are
    // released once the partition recorded them, and every per-unit reset
    // clears the definition-emitted marks, so the shared candidate index --
    // which ordinary method resolution must keep seeing byte-for-byte
    // unchanged -- cannot list them.  The partition (`cgu_collected_ids`) is
    // the durable record of "this build defines that function", so scan it as
    // a fallback used only by the `dyn` vtable lookup.
    //
    // Receiver specificity mirrors `receiver_type_can_use_method_self_type`,
    // which compares an owner *type id*, so the owner text has to be resolved
    // back through the unit type table first -- comparing the text directly
    // would miss an inherited method (`WeightedRecord` reusing `BaseRecord`'s
    // implementation).  A tie at the best score is rejected rather than
    // guessed, so this can only ever recover a lookup that used to fail; it
    // cannot silently pick the wrong overload.
    public fn dyn_partition_receiver_score(self, src_type_id: i32, fn_id: i32) -> i32 {
        let owner_text = self.m.function_owner_type(fn_id);
        if (owner_text.len == 0) { return 0; }
        let receiver_text = llvm_mir_type_text(&self.m, src_type_id);
        if (receiver_text.len > 0 && owner_text == receiver_text) { return 4; }
        let owner_id = mir_unit_find_type_by_text(&self.m, owner_text);
        if (owner_id == mir_id_invalid()) { return 0; }
        if (self.type_ids_compatible(src_type_id, owner_id)) { return 3; }
        if (self.dci_type_derives_from(src_type_id, owner_id)) { return 2; }
        if (self.record_layout_prefix_compatible(src_type_id, owner_id)) { return 1; }
        if (self.record_layout_subobject_field_index(src_type_id, owner_id) >= 0) { return 1; }
        return 0;
    }

    // Signature half of `concrete_function_matches_dyn_method`, evaluated against
    // the snapshot taken while the body was still live.  The concrete side is
    // read from `dyn_sig_buf` and never from the local chain: releasing a
    // streamed body leaves the local table allocated but may rewire -- even
    // cycle -- its `local_next` chain (see the `local_guard` in
    // `discard_recent_body_records`), which is what made an earlier version of
    // this fallback fault inside the compiler.  The prototype, by contrast, is
    // local to this unit and never loses its declaration locals, so its
    // parameters are still read directly.  Keeping the parameter comparison is
    // what stops a same-name overload from being selected by name alone.
    public fn dyn_partition_signature_matches(self, prototype_fn: i32, slot: i32) -> bool {
        if (self.dyn_sig_off == null || self.dyn_sig_buf == null) { return false; }
        if (self.cgu_collected_ids == null) { return false; }
        if (slot < 0 || slot >= self.cgu_collected_n) { return false; }
        let base = ast_read_i32(ptr_offset(self.dyn_sig_off, slot * 4));
        if (base < 0 || base >= self.dyn_sig_n) { return false; }
        let concrete_fn = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
        if (concrete_fn == mir_id_invalid()) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return false; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return false; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = ast_read_i32(ptr_offset(self.dyn_sig_buf, base * 4));
        if (proto_count <= 0 || concrete_count != proto_count) { return false; }
        if (base + concrete_count > self.dyn_sig_n) { return false; }
        let concrete_self = ast_read_i32(ptr_offset(self.dyn_sig_buf, (base + 1) * 4));
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn),
                                      self.m.function_return_type(concrete_fn))) {
            return false;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            let concrete_param = ast_read_i32(ptr_offset(self.dyn_sig_buf, (base + 1 + idx) * 4));
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          concrete_param)) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn dyn_partition_candidate(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        if (self.cgu_emit_index <= 0 || self.dyn_partition_index == null) { return mir_id_invalid(); }
        if (prototype_fn == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_dyn_partition_index();
        let method_name = self.function_method_name(prototype_fn);
        if (method_name.len == 0) { return mir_id_invalid(); }
        var best: i32 = mir_id_invalid();
        var best_score: i32 = 0;
        var tied: bool = false;
        var cur = llvm_mir_method_candidate_index_lookup(self.dyn_partition_index,
                                                        self.dyn_partition_index_cap,
                                                        method_name);
        while (cur != null) {
            let slot = ast_read_i32(cur) - 1;
            cur = ast_read_rawptr(ptr_offset(cur, 8));
            if (slot < 0 || slot >= self.cgu_collected_n) { continue; }
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
            if (fn_id == mir_id_invalid() || fn_id == prototype_fn) { continue; }
            let score = self.dyn_partition_receiver_score(src_type_id, fn_id);
            if (score <= 0) { continue; }
            if (!self.dyn_partition_signature_matches(prototype_fn, slot)) { continue; }
            if (score > best_score) {
                best = fn_id;
                best_score = score;
                tied = false;
            } else {
                if (score == best_score) { tied = true; }
            }
        }
        if (policy_dyn_probe_enabled()) {
            var line: string = "[dyn-probe] partition src=" + llvm_mir_type_text(&self.m, src_type_id)
                               + " proto=" + method_name
                               + " best=" + policy_i64_to_string(best as i64)
                               + " score=" + policy_i64_to_string(best_score as i64)
                               + " tied=";
            if (tied) { line = line + "1"; } else { line = line + "0"; }
            print(line);
        }
        if (tied) { return mir_id_invalid(); }
        return best;
    }

    public fn emit_dyn_method_adapter_body(self,
                                           prototype_fn: i32,
                                           concrete_fn: i32,
                                           adapter_fn: rawptr,
                                           adapter_type: rawptr) {
        self.declare_function_signature(concrete_fn);
        let target_fn = llvm_mir_map_get(self.function_values, concrete_fn);
        let target_type = llvm_mir_map_get(self.function_types, concrete_fn);
        if (target_fn == null || target_type == null || adapter_fn == null || adapter_type == null) {
            self.report_error("cannot emit dyn method adapter for " + self.m.function_name(concrete_fn));
            return;
        }
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let name = self.function_symbol_name(concrete_fn) + "$dyn.entry";
        let bb = vyx_rt_append_block(self.mod, adapter_fn, name.c_str(), name.len as u64);
        if (bb == null) {
            self.report_error("cannot create dyn method adapter block for " + self.m.function_name(concrete_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let source_count = self.function_source_param_count(concrete_fn);
        let uses_sret = self.function_uses_hidden_sret(concrete_fn);
        let concrete_ret = self.m.function_return_type(concrete_fn);
        let proto_ret = self.m.function_return_type(prototype_fn);
        var llvm_argc: i32 = source_count;
        if (uses_sret) { llvm_argc = llvm_argc + 1; }
        var args: rawptr = null;
        if (llvm_argc > 0) {
            args = malloc((llvm_argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate dyn method adapter call arguments");
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
        }
        let data_param = vyx_rt_get_param(self.mod, adapter_fn, 0);
        if (data_param == null) {
            if (args != null) { free(args); }
            self.report_error("cannot read dyn method data parameter");
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        let concrete_self_type = self.function_source_param_type(concrete_fn, 0);
        var self_arg: rawptr = data_param;
        if (!self.source_param_uses_self_pointer_abi(concrete_fn, 0)) {
            self_arg = vyx_rt_build_load(self.mod,
                                         self.lower_type(concrete_self_type),
                                         data_param,
                                         "dyn.self".c_str(),
                                         8);
        }
        if (self_arg == null) {
            if (args != null) { free(args); }
            self.report_error("cannot lower dyn adapter receiver for " + self.m.function_name(concrete_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var out_idx: i32 = 0;
        var sret_slot: rawptr = null;
        if (uses_sret) {
            let sret_storage = self.lower_storage_type(concrete_ret);
            if (sret_storage == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn adapter sret storage for "
                          + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            sret_slot = vyx_rt_build_alloca(self.mod, sret_storage, "dyn.adapter.sret".c_str(), 16);
            let sret_align = self.native_aggregate_align_bytes(concrete_ret);
            if (sret_slot != null && sret_align > 0) {
                vyx_rt_set_alignment(self.mod, sret_slot, sret_align as i32);
            }
            if (sret_slot == null) {
                if (args != null) { free(args); }
                self.report_error("cannot allocate dyn adapter sret storage for "
                          + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            ast_write_rawptr(args, sret_slot);
            out_idx = 1;
        }
        ast_write_rawptr(ptr_offset(args, out_idx * 8), self_arg);
        out_idx = out_idx + 1;
        var idx: i32 = 1;
        while (idx < source_count) {
            let param_value = vyx_rt_get_param(self.mod, adapter_fn, idx as u64);
            let proto_type = self.function_source_param_type(prototype_fn, idx);
            let concrete_type = self.function_source_param_type(concrete_fn, idx);
            var arg_value = self.cast_value(param_value, proto_type, concrete_type);
            if (param_value == null || arg_value == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn adapter parameter #" + policy_i64_to_string(idx as i64)
                          + " for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            if (self.source_param_uses_native_byval_abi(concrete_fn, idx)) {
                let byval_storage = self.lower_storage_type(concrete_type);
                var byval_slot: rawptr = null;
                if (byval_storage != null) {
                    byval_slot = vyx_rt_build_alloca(self.mod, byval_storage, "dyn.adapter.byval".c_str(), 17);
                }
                let byval_align = self.native_aggregate_align_bytes(concrete_type);
                if (byval_slot != null && byval_align > 0) {
                    vyx_rt_set_alignment(self.mod, byval_slot, byval_align as i32);
                }
                if (byval_slot == null) {
                    if (args != null) { free(args); }
                    self.report_error("cannot materialize dyn adapter byval parameter #"
                              + policy_i64_to_string(idx as i64)
                              + " for " + self.m.function_name(concrete_fn));
                    if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                    return;
                }
                vyx_rt_build_store(self.mod, arg_value, byval_slot);
                arg_value = byval_slot;
            }
            ast_write_rawptr(ptr_offset(args, out_idx * 8), arg_value);
            out_idx = out_idx + 1;
            idx = idx + 1;
        }
        var call_name = "dyn.adapter.call";
        if (llvm_mir_type_kind(&self.m, concrete_ret) == ty_VOID() || uses_sret) { call_name = ""; }
        var result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_fn,
                                       args,
                                       llvm_argc as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        if (result != null && !self.apply_native_c_aggregate_abi_attrs(concrete_fn, result)) {
            result = null;
        }
        if (llvm_mir_type_kind(&self.m, proto_ret) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
        } else if (uses_sret) {
            if (result == null || sret_slot == null) {
                self.report_error("cannot emit dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            var ret_value: rawptr = sret_slot;
            if (!self.type_is_class_pointer_abi(concrete_ret)) {
                ret_value = vyx_rt_build_load(self.mod,
                                              self.lower_type(concrete_ret),
                                              sret_slot,
                                              "dyn.adapter.sret.val".c_str(),
                                              20);
            }
            ret_value = self.cast_value(ret_value, concrete_ret, proto_ret);
            if (ret_value == null) {
                self.report_error("cannot cast dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            vyx_rt_build_ret(self.mod, ret_value);
        } else if (result != null) {
            let ret_value = self.cast_value(result, concrete_ret, proto_ret);
            if (ret_value == null) {
                self.report_error("cannot cast dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            vyx_rt_build_ret(self.mod, ret_value);
        } else {
            self.report_error("cannot emit dyn adapter return for " + self.m.function_name(concrete_fn));
        }
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
    }

    public fn dyn_method_adapter_lookup(self, prototype_fn: i32, concrete_fn: i32) -> rawptr {
        var cur = self.dyn_method_adapter_head;
        while (cur != null) {
            if (ast_read_i32(cur) == prototype_fn
                && ast_read_i32(ptr_offset(cur, 4)) == concrete_fn) {
                return ast_read_rawptr(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return null;
    }

    public fn dyn_method_adapter_store(self, prototype_fn: i32, concrete_fn: i32, adapter_fn: rawptr) {
        if (adapter_fn == null) { return; }
        let node = malloc(24);
        if (node == null) {
            self.report_error("cannot allocate dyn method adapter cache entry");
            return;
        }
        ast_write_i32(node, prototype_fn);
        ast_write_i32(ptr_offset(node, 4), concrete_fn);
        ast_write_rawptr(ptr_offset(node, 8), adapter_fn);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_method_adapter_head);
        self.dyn_method_adapter_head = node;
    }

    public fn declare_dyn_method_adapter(self, prototype_fn: i32, concrete_fn: i32) -> rawptr {
        let existing = self.dyn_method_adapter_lookup(prototype_fn, concrete_fn);
        if (existing != null) { return existing; }
        let adapter_type = self.build_dyn_method_adapter_type(prototype_fn);
        if (adapter_type == null) { return null; }
        let name = self.function_symbol_name(concrete_fn)
            + "$dyn_adapter$"
            + policy_mangle_part(self.module_symbol_name)
            + "$"
            + policy_i64_to_string(prototype_fn as i64);
        let adapter_fn = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, adapter_type);
        if (adapter_fn == null) {
            self.report_error("cannot declare dyn method adapter " + name);
            return null;
        }
        vyx_rt_set_linkage(self.mod, adapter_fn, 1);
        self.dyn_method_adapter_store(prototype_fn, concrete_fn, adapter_fn);
        self.emit_dyn_method_adapter_body(prototype_fn, concrete_fn, adapter_fn, adapter_type);
        return adapter_fn;
    }

    public fn dyn_vtable_lookup(self, dyn_type_id: i32, src_type_id: i32) -> rawptr {
        var cur = self.dyn_vtable_head;
        while (cur != null) {
            if (ast_read_i32(cur) == dyn_type_id
                && ast_read_i32(ptr_offset(cur, 4)) == src_type_id) {
                return ast_read_rawptr(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return null;
    }

    public fn dyn_vtable_store(self, dyn_type_id: i32, src_type_id: i32, gv: rawptr) {
        if (gv == null) { return; }
        let node = malloc(24);
        if (node == null) {
            self.report_error("cannot allocate dyn vtable cache entry");
            return;
        }
        ast_write_i32(node, dyn_type_id);
        ast_write_i32(ptr_offset(node, 4), src_type_id);
        ast_write_rawptr(ptr_offset(node, 8), gv);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_vtable_head);
        self.dyn_vtable_head = node;
    }

    public fn dyn_vtable_global_name(self, src_type_id: i32, dyn_type_id: i32) -> string {
        let src_text = llvm_mir_type_text(&self.m, src_type_id);
        let iface_name = self.dyn_trait_name(dyn_type_id);
        if (src_text.len == 0 || iface_name.len == 0) { return ""; }
        if (policy_generic_call_has_args(src_text) != 0
            || policy_generic_call_has_args(iface_name) != 0) {
            return "mir.vtable."
                + policy_mangle_part(src_text)
                + "."
                + policy_mangle_part(iface_name);
        }
        return src_text + "_vtable_" + iface_name;
    }

    public fn get_or_create_dyn_vtable_global(self, src_type_id: i32, dyn_type_id: i32) -> rawptr {
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_type: i64 = 0;
        var timing_slots: i64 = 0;
        var timing_alloc: i64 = 0;
        var timing_impl: i64 = 0;
        var timing_adapter: i64 = 0;
        var timing_const: i64 = 0;
        var timing_global: i64 = 0;
        var timing_cache: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        let cached = self.dyn_vtable_lookup(dyn_type_id, src_type_id);
        if (cached != null) {
            return cached;
        }
        if (llvm_mir_timing_enabled()) {
            let now_type0 = vyx_bootstrap_now_ms();
            timing_cache = now_type0 - timing_mark;
            timing_mark = now_type0;
        }
        let vtable_ty = self.get_or_create_dyn_trait_vtable_ty(dyn_type_id);
        if (vtable_ty == null) { return null; }
        if (llvm_mir_timing_enabled()) {
            let now_type = vyx_bootstrap_now_ms();
            timing_type = now_type - timing_mark;
            timing_mark = now_type;
        }
        let slot_count = self.dyn_trait_method_count(dyn_type_id);
        if (slot_count <= 0) { return null; }
        if (llvm_mir_timing_enabled()) {
            let now_slots = vyx_bootstrap_now_ms();
            timing_slots = now_slots - timing_mark;
            timing_mark = now_slots;
        }
        let vals = malloc((slot_count * 8) as u64);
        if (vals == null) {
            self.report_error("cannot allocate dyn vtable initializer for "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " as "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_alloc = vyx_bootstrap_now_ms();
            timing_alloc = now_alloc - timing_mark;
            timing_mark = now_alloc;
        }
        var ok = true;
        var slot: i32 = 0;
        while (slot < slot_count) {
            let prototype_fn = self.dyn_trait_method_at(dyn_type_id, slot);
            var slot_mark: i64 = 0;
            if (llvm_mir_timing_enabled()) { slot_mark = vyx_bootstrap_now_ms(); }
            let impl_fn = self.dyn_trait_implementation_for_method(src_type_id, prototype_fn);
            if (llvm_mir_timing_enabled()) {
                let now_impl = vyx_bootstrap_now_ms();
                timing_impl = timing_impl + (now_impl - slot_mark);
                slot_mark = now_impl;
            }
            var adapter_fn: rawptr = null;
            if (impl_fn != mir_id_invalid()) {
                adapter_fn = self.dyn_method_adapter_lookup(prototype_fn, impl_fn);
                if (adapter_fn == null) {
                    adapter_fn = self.declare_dyn_method_adapter(prototype_fn, impl_fn);
                }
            }
            if (llvm_mir_timing_enabled()) {
                let now_adapter = vyx_bootstrap_now_ms();
                timing_adapter = timing_adapter + (now_adapter - slot_mark);
            }
            if (adapter_fn == null) {
                self.report_error("cannot materialize dyn vtable method `"
                          + self.function_method_name(prototype_fn)
                          + "` for "
                          + llvm_mir_type_text(&self.m, src_type_id)
                          + " as "
                          + llvm_mir_type_text(&self.m, dyn_type_id));
                ok = false;
            } else {
                ast_write_rawptr(ptr_offset(vals, slot * 8), adapter_fn);
            }
            slot = slot + 1;
        }
        if (!ok) {
            free(vals);
            return null;
        }
        let init_v = vyx_rt_const_named_struct(self.mod, vtable_ty, vals, slot_count as u64);
        free(vals);
        if (init_v == null) {
            self.report_error("cannot initialize dyn vtable constant for " + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_const = vyx_bootstrap_now_ms();
            timing_const = now_const - timing_mark - timing_impl - timing_adapter;
            if (timing_const < 0) { timing_const = 0; }
            timing_mark = now_const;
        }
        let global_name = self.dyn_vtable_global_name(src_type_id, dyn_type_id);
        if (global_name.len == 0) {
            self.report_error("cannot name dyn vtable global");
            return null;
        }
        let gv = vyx_rt_add_global(self.mod,
                                   vtable_ty,
                                   global_name.c_str(),
                                   global_name.len as u64);
        if (gv == null) {
            self.report_error("cannot declare dyn vtable global " + global_name);
            return null;
        }
        vyx_rt_set_initializer(self.mod, gv, init_v);
        vyx_rt_set_global_constant(self.mod, gv, 1);
        vyx_rt_set_linkage(self.mod, gv, 1);
        self.dyn_vtable_store(dyn_type_id, src_type_id, gv);
        if (llvm_mir_timing_enabled()) {
            let timing_total = vyx_bootstrap_now_ms() - timing_start;
            timing_global = timing_total - timing_cache - timing_type - timing_slots - timing_alloc - timing_impl - timing_adapter - timing_const;
            if (timing_global < 0) { timing_global = 0; }
            if (timing_total >= llvm_mir_slow_instr_threshold_ms()) {
                print("[mir-timing] dyn-vtable"
                      + " src=" + llvm_mir_type_text(&self.m, src_type_id)
                      + " dst=" + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " slots=" + policy_i64_to_string(slot_count as i64)
                      + " cache=" + timing_cache.toString()
                      + " type=" + timing_type.toString()
                      + " methods=" + timing_slots.toString()
                      + " alloc=" + timing_alloc.toString()
                      + " impl=" + timing_impl.toString()
                      + " adapter=" + timing_adapter.toString()
                      + " const=" + timing_const.toString()
                      + " global=" + timing_global.toString()
                      + " total=" + timing_total.toString() + " ms");
            }
        }
        return gv;
    }

    public fn dyn_trait_field_ptr(self, dyn_addr: rawptr, dyn_type_id: i32, idx: i32, name: string) -> rawptr {
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        if (dyn_addr == null || dyn_ty == null || idx < 0) { return null; }
        let field_count = 2;
        if (idx >= field_count) {
            self.report_error("dyn trait field index "
                      + policy_i64_to_string(idx as i64)
                      + " is outside "
                      + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " field_count="
                      + policy_i64_to_string(field_count as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 dyn_ty,
                                 dyn_addr,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn dyn_trait_field_value(self, dyn_value: rawptr, dyn_type_id: i32, idx: i32, name: string) -> rawptr {
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        if (dyn_value == null || dyn_ty == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, dyn_ty, "mir.dyn.extract".c_str(), 15);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, dyn_value, tmp);
        let field = self.dyn_trait_field_ptr(tmp, dyn_type_id, idx, name);
        if (field == null) { return null; }
        return vyx_rt_build_load(self.mod, self.ty_ptr, field, name.c_str(), name.len as u64);
    }

    public fn dyn_trait_method_signature_matches(self, candidate_fn: i32, prototype_fn: i32) -> bool {
        if (candidate_fn == mir_id_invalid() || prototype_fn == mir_id_invalid()) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(candidate_fn),
                                      self.m.function_return_type(prototype_fn))) {
            return false;
        }
        let candidate_count = self.function_source_param_count(candidate_fn);
        let prototype_count = self.function_source_param_count(prototype_fn);
        if (candidate_count != prototype_count) { return false; }
        var idx: i32 = 1;
        while (idx < prototype_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(candidate_fn, idx),
                                          self.function_source_param_type(prototype_fn, idx))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn dyn_trait_method_slot(self, dyn_type_id: i32, prototype_fn: i32) -> i32 {
        let count = self.dyn_trait_method_count(dyn_type_id);
        let wanted_name = self.function_method_name(prototype_fn);
        var slot: i32 = 0;
        while (slot < count) {
            let candidate = self.dyn_trait_method_at(dyn_type_id, slot);
            if (candidate != mir_id_invalid()
                && self.function_method_name(candidate) == wanted_name
                && self.dyn_trait_method_signature_matches(candidate, prototype_fn)) {
                return slot;
            }
            slot = slot + 1;
        }
        return -1;
    }

    public fn dyn_trait_impl_cache_get(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        var cur = self.dyn_trait_impl_cache_head;
        while (cur != null) {
            if (ast_read_i32(cur) == src_type_id
                && ast_read_i32(ptr_offset(cur, 4)) == prototype_fn) {
                return ast_read_i32(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return -2;
    }

    public fn dyn_trait_impl_cache_put(self, src_type_id: i32, prototype_fn: i32, impl_fn: i32) {
        if (src_type_id == mir_id_invalid() || prototype_fn == mir_id_invalid()) { return; }
        let node = malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_i32(node, src_type_id);
        ast_write_i32(ptr_offset(node, 4), prototype_fn);
        ast_write_i32(ptr_offset(node, 8), impl_fn);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_trait_impl_cache_head);
        self.dyn_trait_impl_cache_head = node;
    }

    public fn dyn_trait_implementation_for_method(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        let cached = self.dyn_trait_impl_cache_get(src_type_id, prototype_fn);
        if (cached != -2) { return cached; }
        if (policy_dyn_probe_enabled()) { self.dyn_probe_dump(src_type_id, prototype_fn); }
        let method_name = self.function_method_name(prototype_fn);
        let direct = self.executable_method_for_receiver_type(src_type_id, method_name);
        if (direct != mir_id_invalid()
            && self.concrete_function_matches_dyn_method(prototype_fn, direct)) {
            self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, direct);
            return direct;
        }
        var cur = self.method_candidate_head(method_name);
        while (cur != null) {
            let fn_id = ast_read_i32(cur);
            let first_local = self.function_source_param_local(fn_id, 0);
            if (first_local != mir_id_invalid()
                && self.receiver_type_can_use_method_self_type(src_type_id, self.m.local_type(first_local))
                && self.concrete_function_matches_dyn_method(prototype_fn, fn_id)) {
                self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, fn_id);
                return fn_id;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        // The candidate index only covers functions whose body or definition
        // mark is visible in *this* unit; in a split build the concrete method
        // may live in a sibling unit's object file.  Fall back to the codegen
        // partition, which remembers every function this build defines.
        let from_partition = self.dyn_partition_candidate(src_type_id, prototype_fn);
        if (from_partition != mir_id_invalid()) {
            self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, from_partition);
            return from_partition;
        }
        self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, mir_id_invalid());
        return mir_id_invalid();
    }

    public fn lower_value_to_dyn_trait(self, value_id: i32, dyn_type_id: i32) -> rawptr {
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_type: i64 = 0;
        var timing_probe: i64 = 0;
        var timing_payload: i64 = 0;
        var timing_slot: i64 = 0;
        var timing_vtable: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        var src_type_id = self.value_effective_type(value_id);
        if (src_type_id == mir_id_invalid()) { return null; }
        var payload_from_handle: rawptr = null;
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, src_type_id))) {
            let elem = hir_type_table_elem(self.m.types, src_type_id);
            if (self.type_is_dyn_trait(elem)) {
                let handle_dyn = self.lower_value(value_id);
                let addr_dyn = self.pointer_handle_address(handle_dyn, "mir.dyn.load");
                let dyn_ty_load = self.get_or_create_dyn_trait_ty(dyn_type_id);
                if (addr_dyn == null || dyn_ty_load == null) { return null; }
                return vyx_rt_build_load(self.mod, dyn_ty_load, addr_dyn, "mir.dyn.load".c_str(), 12);
            }
            if (elem != mir_id_invalid()) {
                let handle_src = self.lower_value(value_id);
                payload_from_handle = self.pointer_handle_address(handle_src, "mir.dyn.borrow");
                src_type_id = elem;
            }
        }
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        let src_ty = self.lower_type(src_type_id);
        if (llvm_mir_timing_enabled()) {
            let now_type = vyx_bootstrap_now_ms();
            timing_type = now_type - timing_mark;
            timing_mark = now_type;
        }
        if (dyn_ty == null || src_ty == null) {
            self.report_error("cannot lower dyn trait conversion type "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " -> "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        var payload: rawptr = null;
        let src_uses_pointer_repr = self.type_uses_self_pointer_abi(src_type_id);
        if (llvm_mir_timing_enabled()) {
            let now_probe = vyx_bootstrap_now_ms();
            timing_probe = now_probe - timing_mark;
            timing_mark = now_probe;
        }
        // The concrete value is spilled to storage the fat pointer points at.
        // dyn-by-value payloads are never freed (the callee borrows them), so
        // route them through the thread-local bump allocator rather than malloc:
        // it is far cheaper on this hot path, and a payload that turns out not to
        // escape is later stack-promoted by the runtime's non-escaping-allocation
        // pass (vyx_class_alloc_abi is the shape it recognises).
        if (payload_from_handle != null) {
            payload = payload_from_handle;
        } else if (src_uses_pointer_repr) {
            if (self.type_is_class_pointer_abi(src_type_id)) {
                payload = self.lower_value(value_id);
                if (payload == null) {
                    self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
            } else {
                let src_size_for_record = vyx_rt_type_alloc_size(self.mod, src_ty);
                if (src_size_for_record <= 0) {
                    self.report_error("invalid dyn trait payload size for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
                payload = self.class_alloc_bytes_value(src_size_for_record, "mir.dyn.payload.alloc");
                if (payload == null) { return null; }
                let src_record_value = self.lower_value(value_id);
                if (src_record_value == null) {
                    self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
                vyx_rt_build_store(self.mod, src_record_value, payload);
            }
        } else {
            let src_size = vyx_rt_type_alloc_size(self.mod, src_ty);
            if (src_size <= 0) {
                self.report_error("invalid dyn trait payload size for " + llvm_mir_type_text(&self.m, src_type_id));
                return null;
            }
            payload = self.class_alloc_bytes_value(src_size, "mir.dyn.payload.alloc");
            if (payload == null) { return null; }
            let src_value = self.lower_value(value_id);
            if (src_value == null) {
                self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                return null;
            }
            vyx_rt_build_store(self.mod, src_value, payload);
        }
        if (llvm_mir_timing_enabled()) {
            let now_payload = vyx_bootstrap_now_ms();
            timing_payload = now_payload - timing_mark;
            timing_mark = now_payload;
        }
        let dyn_slot = vyx_rt_build_alloca(self.mod, dyn_ty, "mir.dyn.value".c_str(), 13);
        if (dyn_slot == null) {
            self.report_error("cannot allocate dyn trait value for " + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        let data_field = self.dyn_trait_field_ptr(dyn_slot, dyn_type_id, 0, "dyn.data");
        if (data_field == null) {
            self.report_error("cannot address dyn trait data field");
            return null;
        }
        vyx_rt_build_store(self.mod, payload, data_field);
        if (llvm_mir_timing_enabled()) {
            let now_slot = vyx_bootstrap_now_ms();
            timing_slot = now_slot - timing_mark;
            timing_mark = now_slot;
        }
        let vtable = self.get_or_create_dyn_vtable_global(src_type_id, dyn_type_id);
        if (vtable == null) {
            self.report_error("cannot resolve dyn trait vtable for "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " as "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_vtable = vyx_bootstrap_now_ms();
            timing_vtable = now_vtable - timing_mark;
            timing_mark = now_vtable;
        }
        let vtable_field = self.dyn_trait_field_ptr(dyn_slot, dyn_type_id, 1, "dyn.vtable");
        if (vtable_field == null) {
            self.report_error("cannot address dyn trait vtable field");
            return null;
        }
        vyx_rt_build_store(self.mod, vtable, vtable_field);
        let out = vyx_rt_build_load(self.mod, dyn_ty, dyn_slot, "mir.dyn.val".c_str(), 11);
        if (llvm_mir_timing_enabled()) {
            let timing_total = vyx_bootstrap_now_ms() - timing_start;
            if (timing_total >= llvm_mir_slow_instr_threshold_ms()) {
                print("[mir-timing] dyn-conv fn #" + policy_i64_to_string(self.current_function_id as i64)
                      + " " + self.m.function_name(self.current_function_id)
                      + " value=" + policy_i64_to_string(value_id as i64)
                      + " src=" + llvm_mir_type_text(&self.m, src_type_id)
                      + " dst=" + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " type=" + timing_type.toString()
                      + " probe=" + timing_probe.toString()
                      + " payload=" + timing_payload.toString()
                      + " slot=" + timing_slot.toString()
                      + " vtable=" + timing_vtable.toString()
                      + " total=" + timing_total.toString() + " ms");
            }
        }
        return out;
    }

    public fn lower_dyn_trait_call(self, value_id: i32, prototype_fn: i32) -> rawptr {
        if (prototype_fn == mir_id_invalid()) { return null; }
        let receiver_id = self.direct_call_receiver(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("dyn trait call has no receiver for " + self.m.function_name(prototype_fn));
            return null;
        }
        var dyn_type_id = self.type_dyn_trait_id(self.function_source_param_type(prototype_fn, 0));
        if (dyn_type_id == mir_id_invalid()) {
            dyn_type_id = self.type_dyn_trait_id(self.m.value_type(receiver_id));
        }
        let dyn_type_ok = dyn_type_id != mir_id_invalid();
        var dyn_proto_ok = false;
        if (dyn_type_ok) {
            dyn_proto_ok = self.interface_function_matches_dyn_trait(prototype_fn, dyn_type_id);
        }
        if (!dyn_type_ok || !dyn_proto_ok) {
            self.report_error("cannot resolve dyn trait receiver type for " + self.m.function_name(prototype_fn));
            return null;
        }
        let method_slot = self.dyn_trait_method_slot(dyn_type_id, prototype_fn);
        if (method_slot < 0) {
            self.report_error("cannot resolve dyn trait method slot for " + self.m.function_name(prototype_fn));
            return null;
        }
        let dyn_value = self.lower_value_as(receiver_id, dyn_type_id);
        if (dyn_value == null) {
            self.report_error("cannot lower dyn trait receiver for " + self.m.function_name(prototype_fn));
            return null;
        }
        let data_ptr = self.dyn_trait_field_value(dyn_value, dyn_type_id, 0, "dyn.data");
        let vtable_ptr = self.dyn_trait_field_value(dyn_value, dyn_type_id, 1, "dyn.vtable");
        let vtable_ty = self.get_or_create_dyn_trait_vtable_ty(dyn_type_id);
        var method_ptr: rawptr = null;
        if (vtable_ptr != null && vtable_ty != null) {
            let fn_slot = vyx_rt_build_gep2(self.mod,
                                           vtable_ty,
                                           vtable_ptr,
                                           vyx_rt_const_int(self.mod, self.ty_i32, 0, 1),
                                           vyx_rt_const_int(self.mod, self.ty_i32, method_slot as i64, 1),
                                           "dyn.vtable.fn".c_str(),
                                           13);
            if (fn_slot != null) {
                method_ptr = vyx_rt_build_load(self.mod,
                                               self.ty_ptr,
                                               fn_slot,
                                               "dyn.method".c_str(),
                                               10);
            }
        }
        let fty = self.build_dyn_method_adapter_type(prototype_fn);
        if (data_ptr == null || method_ptr == null || fty == null) {
            self.report_error("cannot lower dyn trait dispatch fields for " + self.m.function_name(prototype_fn));
            return null;
        }
        let source_argc = self.call_arg_count(value_id);
        let expected_argc = self.function_source_param_count(prototype_fn) - 1;
        if (source_argc != expected_argc) {
            self.report_error("dyn trait call argument count mismatch for " + self.m.function_name(prototype_fn));
            return null;
        }
        let total_argc = source_argc + 1;
        var args: rawptr = null;
        if (total_argc > 0) {
            args = malloc((total_argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate dyn trait call arguments for " + self.m.function_name(prototype_fn));
                return null;
            }
        }
        ast_write_rawptr(args, data_ptr);
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_type = self.function_source_param_type(prototype_fn, i + 1);
            if (param_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve dyn trait call parameter #" + policy_i64_to_string(i as i64));
                return null;
            }
            let arg_val = self.lower_value_as(arg_id, param_type);
            if (arg_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn trait call argument #" + policy_i64_to_string(i as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(args, (i + 1) * 8), arg_val);
            i = i + 1;
        }
        var call_out_name = "mir.dyn.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.m.function_return_type(prototype_fn));
        if (ret_kind == ty_VOID()) { call_out_name = ""; }
        let out = vyx_rt_build_call(self.mod,
                                    fty,
                                    method_ptr,
                                    args,
                                    total_argc as u64,
                                    call_out_name.c_str(),
                                    call_out_name.len as u64);
        if (args != null) { free(args); }
        return out;
    }
}
