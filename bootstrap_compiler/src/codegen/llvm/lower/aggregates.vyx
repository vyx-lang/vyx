module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn lower_variant_tag_value(self, variant_id: i32) -> rawptr {
        let tag = mir_unit_variant_tag(&self.m, variant_id);
        if (tag < 0) {
            self.report_error("cannot resolve enum variant tag for variant #" + policy_i64_to_string(variant_id as i64));
            return null;
        }
        return vyx_rt_const_int(self.mod, self.ty_i32, tag as i64, 0);
    }

    public fn result_tag_for_variant_name(self, variant_name: string) -> rawptr {
        if (variant_name == "Ok") { return vyx_rt_const_int(self.mod, self.ty_i32, 0, 0); }
        if (variant_name == "Err") { return vyx_rt_const_int(self.mod, self.ty_i32, 1, 0); }
        self.report_error("unknown Result variant " + variant_name);
        return null;
    }

    public fn lower_array_aggregate_value(self, value_id: i32) -> rawptr {
        let type_id = self.value_effective_type(value_id);
        let elem_type = hir_type_table_elem(self.m.types, type_id);
        let elem_ty = self.lower_type(elem_type);
        let array_ty = self.lower_type(type_id);
        let array_len = self.array_length_for_type(type_id);
        if (elem_type == mir_id_invalid()
            || elem_ty == null
            || array_ty == null
            || array_len < 0) {
            self.report_error("cannot lower array aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, array_ty, "mir.array.aggregate".c_str(), 19);
        let zero_init = vyx_rt_const_null(self.mod, array_ty);
        if (tmp == null || zero_init == null) {
            self.report_error("cannot allocate array aggregate storage for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        let repeat_count_value = self.m.value_aux(value_id);
        if (repeat_count_value != mir_id_invalid()) {
            if (self.m.value_kind(repeat_count_value) != mir_value_const_int()) {
                self.report_error("array repeat count is not a compile-time integer for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let repeat_count = self.m.value_int(repeat_count_value);
            if (repeat_count != array_len) {
                self.report_error("array repeat count "
                          + policy_i64_to_string(repeat_count)
                          + " does not match "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_id = self.m.value_first_arg(value_id);
            if (elem_id == mir_id_invalid()) {
                self.report_error("array repeat aggregate has no element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (self.m.value_next_arg(elem_id) != mir_id_invalid()) {
                self.report_error("array repeat aggregate has more than one element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (mir_unit_value_aggregate_field(&self.m, elem_id) != mir_id_invalid()) {
                self.report_error("array repeat element has a record FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_value = self.lower_value_as(elem_id, elem_type);
            if (elem_value == null) {
                self.report_error("cannot lower array repeat element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var repeat_idx: i64 = 0;
            while (repeat_idx < array_len) {
                let elem_ptr = vyx_rt_build_gep2(self.mod,
                                                 array_ty,
                                                 tmp,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, repeat_idx, 0),
                                                 "mir.array.repeat.elem".c_str(),
                                                 21);
                if (elem_ptr == null) {
                    self.report_error("cannot address array repeat element #"
                              + policy_i64_to_string(repeat_idx)
                              + " for "
                              + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                vyx_rt_build_store(self.mod, elem_value, elem_ptr);
                repeat_idx = repeat_idx + 1;
            }
            return vyx_rt_build_load(self.mod, array_ty, tmp, "mir.array.aggregate.val".c_str(), 23);
        }
        var idx: i64 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (idx >= array_len) {
                self.report_error("array aggregate has too many elements for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (mir_unit_value_aggregate_field(&self.m, cur) != mir_id_invalid()) {
                self.report_error("array aggregate element has a record FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_ptr = vyx_rt_build_gep2(self.mod,
                                             array_ty,
                                             tmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i64, idx, 0),
                                             "mir.array.elem".c_str(),
                                             14);
            let elem_value = self.lower_value_as(cur, elem_type);
            if (elem_ptr == null || elem_value == null) {
                self.report_error("cannot lower array aggregate element #"
                          + policy_i64_to_string(idx)
                          + " for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            vyx_rt_build_store(self.mod, elem_value, elem_ptr);
            idx = idx + 1;
            cur = self.m.value_next_arg(cur);
        }
        if (idx != array_len) {
            self.report_error("array aggregate element count "
                      + policy_i64_to_string(idx)
                      + " does not match "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_build_load(self.mod, array_ty, tmp, "mir.array.aggregate.val".c_str(), 23);
    }

    // A record literal lowered inside a generic context can carry the OPEN
    // template type (e.g. `Pair` with fields T/U) while the destination slot
    // uses the closed instance layout (`Pair::<str,i64>`). Building the value
    // with the template layout and reading it back with the instance layout
    // silently corrupts every field past the first; when the destination is a
    // closed same-family record, the aggregate must adopt its layout.
    public fn aggregate_should_use_destination_layout(self, src_type_id: i32, dst_type_id: i32) -> bool {
        if (src_type_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return false; }
        if (src_type_id == dst_type_id) { return false; }
        let src_canonical = self.canonical_record_type_id(src_type_id);
        let dst_canonical = self.canonical_record_type_id(dst_type_id);
        if (src_canonical == dst_canonical) { return false; }
        if (mir_unit_field_count_for_type(&self.m, dst_canonical) <= 0) { return false; }
        let src_base = policy_generic_call_base(llvm_mir_type_text(&self.m, src_canonical).clone());
        let dst_base = policy_generic_call_base(llvm_mir_type_text(&self.m, dst_canonical).clone());
        if (!self.type_text_equivalent(src_base, dst_base)) { return false; }
        return !self.record_layout_fields_are_closed(src_canonical);
    }

    public fn lower_aggregate_value(self, value_id: i32) -> rawptr {
        return self.lower_aggregate_value_with_type(value_id, self.m.value_type(value_id));
    }

    public fn lower_aggregate_value_with_type(self, value_id: i32, type_id: i32) -> rawptr {
        if (llvm_mir_type_kind(&self.m, type_id) == ty_ARRAY()) {
            return self.lower_array_aggregate_value(value_id);
        }
        if (llvm_mir_type_kind(&self.m, type_id) == ty_TUPLE()) {
            return self.lower_tuple_aggregate_value(value_id);
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.lower_class_pointer_aggregate_value_with_type(value_id, type_id);
        }
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.lower_type(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (field_count <= 0) {
            if (self.m.value_first_arg(value_id) != mir_id_invalid()) {
                self.report_error("aggregate has fields but no record layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return vyx_rt_const_null(self.mod, record_ty);
        }
        let tmp = vyx_rt_build_alloca(self.mod, record_ty, "mir.aggregate".c_str(), 13);
        let seen = malloc((field_count * 4) as u64);
        if (tmp == null || seen == null) {
            self.report_error("cannot allocate aggregate storage");
            return null;
        }
        memset(seen, 0, (field_count * 4) as u64);
        let zero_init = vyx_rt_const_null(self.mod, record_ty);
        if (zero_init == null) {
            free(seen);
            self.report_error("cannot build aggregate zero initializer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            var field_id = mir_unit_value_aggregate_field(&self.m, cur);
            // Resolve against owner_type — the SAME id the record layout
            // (record_ty / field_count) was derived from — so field_index is
            // always taken from the layout actually GEPed into.
            field_id = self.remapped_field_for_base(owner_type, field_id);
            if (field_id == mir_id_invalid()
                || !self.field_owner_accepts_base_type(mir_unit_field_owner_type(&self.m, field_id), type_id)) {
                free(seen);
                self.report_error("aggregate field argument has no resolved FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let field_index = mir_unit_field_index(&self.m, field_id);
            if (field_index < 0 || field_index >= field_count) {
                free(seen);
                self.report_error("aggregate field index is out of range for " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            if (ast_read_i32(ptr_offset(seen, field_index * 4)) != 0) {
                free(seen);
                self.report_error("aggregate field is assigned more than once: " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            ast_write_i32(ptr_offset(seen, field_index * 4), 1);
            let field_ptr = vyx_rt_build_gep2(self.mod,
                                              record_ty,
                                              tmp,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              vyx_rt_const_int(self.mod, self.ty_i32, field_index as i64, 0),
                                              mir_unit_field_name(&self.m, field_id).c_str(),
                                              mir_unit_field_name(&self.m, field_id).len as u64);
            let field_value = self.lower_value_as(cur, mir_unit_field_type(&self.m, field_id));
            if (field_ptr == null || field_value == null) {
                free(seen);
                self.report_error("cannot lower aggregate field " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            vyx_rt_build_store(self.mod, field_value, field_ptr);
            cur = self.m.value_next_arg(cur);
        }
        free(seen);
        return vyx_rt_build_load(self.mod, record_ty, tmp, "mir.aggregate.val".c_str(), 17);
    }

    public fn lower_class_pointer_aggregate_value(self, value_id: i32) -> rawptr {
        return self.lower_class_pointer_aggregate_value_with_type(value_id, self.m.value_type(value_id));
    }

    // Initialize an already-selected class record destination from a MIR
    // aggregate.  The normal value path supplies a heap object; the shared
    // MIR automatic-storage plan supplies a local record alloca.  Keeping
    // field initialization here prevents LLVM and MIR2CPP from inventing
    // different storage rules for the same aggregate.
    public fn initialize_class_pointer_aggregate_into(self,
                                                      value_id: i32,
                                                      type_id: i32,
                                                      obj: rawptr) -> bool {
        if (obj == null) {
            self.report_error("cannot initialize null class aggregate destination for "
                              + llvm_mir_type_text(&self.m, type_id));
            return false;
        }
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.class_record_storage_ty(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower class aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return false;
        }
        var size_bytes = vyx_rt_type_alloc_size(self.mod, record_ty);
        let dci_size_bytes = self.dci_record_size_bytes_for_type(owner_type);
        if (dci_size_bytes > 0) {
            size_bytes = dci_size_bytes;
        } else if (self.type_is_foreign_dci(owner_type)) {
            self.report_error("missing DCI record layout for external type "
                              + llvm_mir_type_text(&self.m, owner_type));
            return false;
        }
        if (size_bytes <= 0) {
            var measured_fields = field_count;
            if (measured_fields <= 0) { measured_fields = 1; }
            size_bytes = ((measured_fields as i64) * 8) + 16;
        }
        let fully_initialized = value_id != mir_id_invalid()
            && field_count > 0
            && self.call_arg_count(value_id) >= field_count;
        if (!fully_initialized) {
            if (self.builtin_memset_fn == null || self.builtin_memset_fty == null) {
                self.report_error("memset is not declared before class aggregate initialization");
                return false;
            }
            let zeroed = vyx_rt_build_call3(self.mod,
                                             self.builtin_memset_fty,
                                             self.builtin_memset_fn,
                                             obj,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                             llvm_mir_empty_name(),
                                             0);
            if (zeroed == null) {
                self.report_error("cannot clear class object " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
        }
        if (field_count <= 0) {
            if (self.m.value_first_arg(value_id) != mir_id_invalid()) {
                self.report_error("class aggregate has fields but no record layout for " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
            return true;
        }
        let seen = malloc((field_count * 4) as u64);
        if (seen == null) {
            self.report_error("cannot allocate class aggregate field map");
            return false;
        }
        memset(seen, 0, (field_count * 4) as u64);
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            var field_id = mir_unit_value_aggregate_field(&self.m, cur);
            // Same layout-source unification as lower_aggregate_value: map
            // against owner_type, whose storage type is being GEPed into.
            field_id = self.remapped_field_for_base(owner_type, field_id);
            if (field_id == mir_id_invalid()
                || !self.field_owner_accepts_base_type(mir_unit_field_owner_type(&self.m, field_id), type_id)) {
                free(seen);
                self.report_error("class aggregate field argument has no resolved FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
            let field_index = mir_unit_field_index(&self.m, field_id);
            if (field_index < 0 || field_index >= field_count) {
                free(seen);
                self.report_error("class aggregate field index is out of range for " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            if (ast_read_i32(ptr_offset(seen, field_index * 4)) != 0) {
                free(seen);
                self.report_error("class aggregate field is assigned more than once: " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            ast_write_i32(ptr_offset(seen, field_index * 4), 1);
            var field_ptr: rawptr = null;
            if (self.foreign_dci_field_record_type(owner_type, field_id) != mir_id_invalid()) {
                field_ptr = self.dci_field_addr(obj, owner_type, field_id);
            } else if (self.type_is_dci_stub_class(owner_type)) {
                field_ptr = self.dci_stub_state_field_addr(obj, owner_type, field_id);
            } else {
                field_ptr = vyx_rt_build_gep2(self.mod,
                                              record_ty,
                                              obj,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              vyx_rt_const_int(self.mod, self.ty_i32, field_index as i64, 0),
                                              mir_unit_field_name(&self.m, field_id).c_str(),
                                              mir_unit_field_name(&self.m, field_id).len as u64);
            }
            let field_value = self.lower_value_as(cur, mir_unit_field_type(&self.m, field_id));
            if (field_ptr == null || field_value == null) {
                free(seen);
                self.report_error("cannot lower class aggregate field " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            vyx_rt_build_store(self.mod, field_value, field_ptr);
            cur = self.m.value_next_arg(cur);
        }
        free(seen);
        return true;
    }

    // Allocate the implicit `self` receiver storage for a constructor call.
    // A native value-ABI class constructs in automatic storage (C++ value
    // semantics): the caller supplies a zeroed stack record, the constructor
    // body writes fields through the `self` pointer, and the constructor
    // returns the record by value (see the self-pointer read path).  Only
    // foreign-DCI/pointer-ABI receivers keep the owning heap allocation.
    public fn lower_constructor_self_storage(self, type_id: i32) -> rawptr {
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(), type_id);
        }
        let record_ty = self.class_record_storage_ty(type_id);
        if (record_ty == null) {
            self.report_error("cannot lower constructor receiver type "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let slot = vyx_rt_build_alloca(self.mod, record_ty, "mir.ctor.self".c_str(), 13);
        if (slot == null) {
            self.report_error("cannot allocate constructor receiver storage for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let zero_init = vyx_rt_const_null(self.mod, record_ty);
        if (zero_init == null) {
            self.report_error("cannot zero-initialize constructor receiver for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, slot);
        return slot;
    }

    public fn lower_class_pointer_aggregate_value_with_type(self, value_id: i32, type_id: i32) -> rawptr {
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.class_record_storage_ty(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower class aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var size_bytes = vyx_rt_type_alloc_size(self.mod, record_ty);
        let dci_size_bytes = self.dci_record_size_bytes_for_type(owner_type);
        if (dci_size_bytes > 0) {
            size_bytes = dci_size_bytes;
        } else if (self.type_is_foreign_dci(owner_type)) {
            self.report_error("missing DCI record layout for external type "
                      + llvm_mir_type_text(&self.m, owner_type));
            return null;
        }
        if (size_bytes <= 0) {
            var measured_fields = field_count;
            if (measured_fields <= 0) { measured_fields = 1; }
            size_bytes = ((measured_fields as i64) * 8) + 16;
        }
        let obj = llvm_lifetime_allocate_class_storage(self.mod, size_bytes, "mir.class.alloc",
                                                        self.builtin_class_alloc_fty, self.builtin_class_alloc_fn,
                                                        self.builtin_malloc_fty, self.builtin_malloc_fn,
                                                        self.builtin_free_fn,
                                                        self.type_is_foreign_dci(owner_type));
        if (obj == null) {
            self.report_error("cannot allocate class object " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (!self.initialize_class_pointer_aggregate_into(value_id, type_id, obj)) { return null; }
        return obj;
    }

    public fn lower_tuple_aggregate_value(self, value_id: i32) -> rawptr {
        let type_id = self.m.value_type(value_id);
        let elem_count = self.tuple_element_count_for_type(type_id);
        let tuple_ty = self.lower_type(type_id);
        if (tuple_ty == null || elem_count <= 0) {
            self.report_error("cannot lower tuple aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, tuple_ty, "mir.tuple.aggregate".c_str(), 19);
        if (tmp == null) {
            self.report_error("cannot allocate tuple aggregate storage");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_null(self.mod, tuple_ty), tmp);
        var cur = self.m.value_first_arg(value_id);
        var idx: i32 = 0;
        while (cur != mir_id_invalid()) {
            if (idx >= elem_count) {
                self.report_error("tuple aggregate has too many elements for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_type = self.tuple_element_type_id(type_id, idx);
            let elem_value = self.lower_value_as(cur, elem_type);
            let elem_ptr = vyx_rt_build_gep2(self.mod,
                                             tuple_ty,
                                             tmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                             "tuple.elem".c_str(),
                                             10);
            if (elem_type == mir_id_invalid() || elem_value == null || elem_ptr == null) {
                self.report_error("cannot lower tuple element #" + policy_i64_to_string(idx as i64));
                return null;
            }
            vyx_rt_build_store(self.mod, elem_value, elem_ptr);
            cur = self.m.value_next_arg(cur);
            idx = idx + 1;
        }
        if (idx != elem_count) {
            self.report_error("tuple aggregate has " + policy_i64_to_string(idx as i64)
                      + " elements but expected " + policy_i64_to_string(elem_count as i64));
            return null;
        }
        return vyx_rt_build_load(self.mod, tuple_ty, tmp, "mir.tuple.val".c_str(), 13);
    }

    public fn lower_explicit_new_intrinsic(self, value_id: i32) -> rawptr {
        let payload_type = self.m.value_target_id(value_id);
        if (payload_type == mir_id_invalid()) {
            self.report_error("new allocation is missing its payload type");
            return null;
        }
        let init_value_id = self.m.value_rhs(value_id);
        let first_arg = self.m.value_first_arg(value_id);

        // Explicit `new` has an owning heap lifetime.  Do not route a class
        // aggregate initializer through the ordinary class-value path: that
        // path intentionally uses the small-object automatic/bump allocator
        // for non-escaping values, while `delete` must be able to release an
        // explicit allocation with the normal free ABI.
        if (self.type_is_class_pointer_abi(payload_type)
            && init_value_id != mir_id_invalid()) {
            let init_storage_ty = self.lower_storage_type(payload_type);
            if (init_storage_ty == null) {
                self.report_error("cannot lower allocated storage type "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            var init_bytes = vyx_rt_type_alloc_size(self.mod, init_storage_ty);
            let init_dci_bytes = self.dci_record_size_bytes_for_type(payload_type);
            if (init_dci_bytes > 0) {
                init_bytes = init_dci_bytes;
            }
            if (init_bytes <= 0) {
                var init_fields = mir_unit_field_count_for_type(&self.m,
                                                                 self.canonical_record_type_id(payload_type));
                if (init_fields <= 0) { init_fields = 1; }
                init_bytes = ((init_fields as i64) * 8) + 16;
            }
            let object = self.malloc_bytes_value(init_bytes,
                                                 "new." + llvm_mir_type_text(&self.m, payload_type));
            if (object == null) { return null; }
            if (!self.initialize_class_pointer_aggregate_into(init_value_id,
                                                               payload_type,
                                                               object)) {
                return null;
            }
            return self.pointer_handle_from_raw(object,
                                                payload_type,
                                                1,
                                                0,
                                                "mir.new.class");
        }

        // Runtime-length array allocation: `new [T; expr]()` with a
        // non-constant size. The payload type has no concrete LLVM length,
        // so allocate count * elem_size bytes; the count value arrives via
        // the value aux slot (built from the array size expression by the
        // HIR builder). The result is a handle over the element storage,
        // which then decays to `*T` like any other array allocation.
        // Generic instantiations record the payload either as `ptr<[T; e]>`
        // or as a textually-interned class named `[i32;c#83#r]`, so detect
        // runtime arrays by text, not just by type kind.
        var rt_payload = payload_type;
        if (llvm_mir_type_kind(&self.m, rt_payload) == ty_PTR()) {
            let rt_pe = hir_type_table_elem(self.m.types, rt_payload);
            if (rt_pe != mir_id_invalid()
                && llvm_mir_type_kind(&self.m, rt_pe) == ty_ARRAY()) {
                rt_payload = rt_pe;
            }
        }
        let rt_text = llvm_mir_type_text(&self.m, rt_payload);
        var rt_is_array = llvm_mir_type_kind(&self.m, rt_payload) == ty_ARRAY();
        if (!rt_is_array
            && llvm_mir_type_kind(&self.m, rt_payload) == ty_CLASS()
            && rt_text.len > 1
            && rt_text.charAt(0) == 91) {
            // Textually-interned array type (mono substitution artifact).
            rt_is_array = true;
        }
        if (llvm_mir_env_enabled("VYX_DUMP_RTARRAY")) {
            var aux_state = "set";
            if (self.m.value_aux(value_id) == mir_id_invalid()) { aux_state = "none"; }
            print("[rtarray] payload=" + llvm_mir_type_text(&self.m, payload_type)
                  + " rt_payload=" + rt_text
                  + " is_array=" + (rt_is_array as i64).toString()
                  + " len=" + self.array_length_from_type_text(rt_text).toString()
                  + " aux=" + aux_state);
        }
        if (rt_is_array
            && self.array_length_from_type_text(rt_text) < 0) {
            let rt_count_value = self.m.value_aux(value_id);
            if (rt_count_value == mir_id_invalid()) {
                self.report_error("array allocation has no concrete length: " + rt_text);
                return null;
            }
            if (init_value_id != mir_id_invalid() || first_arg != mir_id_invalid()) {
                self.report_error("runtime-length array allocation supports only an empty () initializer");
                return null;
            }
            var rt_elem_id = hir_type_table_elem(self.m.types, rt_payload);
            if (rt_elem_id == mir_id_invalid()) {
                rt_elem_id = self.rtarray_elem_type_id_from_text(rt_text);
            }
            if (rt_elem_id == mir_id_invalid()) {
                self.report_error("cannot lower runtime array element type " + rt_text);
                return null;
            }
            let rt_elem_ty = self.lower_type(rt_elem_id);
            if (rt_elem_ty == null) { return null; }
            var rt_elem_bytes = vyx_rt_type_alloc_size(self.mod, rt_elem_ty);
            if (rt_elem_bytes <= 0) { rt_elem_bytes = 1; }
            let rt_count_lowered = self.lower_value(rt_count_value);
            if (rt_count_lowered == null) { return null; }
            let rt_count_i64 = self.int_value_to_bits(rt_count_lowered,
                                                       self.m.value_type(rt_count_value),
                                                       64);
            if (rt_count_i64 == null) { return null; }
            let rt_bytes_v = vyx_rt_build_mul(self.mod,
                                               rt_count_i64,
                                               vyx_rt_const_int(self.mod, self.ty_i64, rt_elem_bytes, 0),
                                               "new.rtarray.bytes".c_str(),
                                               17);
            if (rt_bytes_v == null) { return null; }
            let rt_mem = self.malloc_bytes_runtime(rt_bytes_v, "new.rtarray");
            if (rt_mem == null) { return null; }
            return self.runtime_array_handle_from_raw(rt_mem,
                                                       rt_elem_id,
                                                       rt_bytes_v,
                                                       "new.rtarray");
        }

        let storage_ty = self.lower_storage_type(payload_type);
        if (storage_ty == null) {
            self.report_error("cannot lower allocated storage type "
                      + llvm_mir_type_text(&self.m, payload_type));
            return null;
        }
        let bytes = vyx_rt_type_alloc_size(self.mod, storage_ty);
        let mem = self.malloc_bytes_value(bytes,
                                          "new." + llvm_mir_type_text(&self.m, payload_type));
        if (mem == null) { return null; }

        var initialized: bool = false;
        if (init_value_id != mir_id_invalid()) {
            let init_value = self.lower_value_as(init_value_id, payload_type);
            if (init_value == null) {
                self.report_error("cannot lower aggregate initializer for new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, init_value, mem);
            initialized = true;
        } else if (first_arg != mir_id_invalid()) {
            let scalar_init = self.lower_value_as(first_arg, payload_type);
            if (scalar_init == null) {
                self.report_error("cannot lower initializer for new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, scalar_init, mem);
            initialized = true;
        }
        if (!initialized) {
            let zero = vyx_rt_const_null(self.mod, storage_ty);
            if (zero == null) {
                self.report_error("cannot zero initialize new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, zero, mem);
        }
        return self.pointer_handle_from_raw(mem,
                                            payload_type,
                                            1,
                                            0,
                                            "mir.new");
    }

    public fn lower_explicit_delete_intrinsic(self, value_id: i32) -> rawptr {
        let operand_id = self.m.value_lhs(value_id);
        if (operand_id == mir_id_invalid()) {
            self.report_error("delete is missing its pointer operand");
            return null;
        }
        let ptr = self.lower_value(operand_id);
        if (ptr == null) {
            self.report_error("cannot lower delete pointer operand");
            return null;
        }
        let operand_type = self.m.value_type(operand_id);
        let operand_kind = llvm_mir_type_kind(&self.m, operand_type);
        var released: rawptr = null;
        if (llvm_mir_kind_pointer_handle(operand_kind)) {
            let metadata = self.pointer_handle_metadata(ptr, "mir.delete");
            if (metadata == null) {
                self.report_error("cannot extract pointer region for delete");
                return null;
            }
            let released_address = self.pointer_region_delete(metadata);
            if (released_address == null) {
                self.report_error("cannot invalidate pointer region for delete");
                return null;
            }
            if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
                self.report_error("free is not declared before delete");
                return null;
            }
            released = vyx_rt_build_call1(self.mod,
                                          self.builtin_free_fty,
                                          self.builtin_free_fn,
                                          released_address,
                                          llvm_mir_empty_name(),
                                          0);
        } else {
            if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
                self.report_error("free is not declared before delete");
                return null;
            }
            released = vyx_rt_build_call1(self.mod,
                                          self.builtin_free_fty,
                                          self.builtin_free_fn,
                                          ptr,
                                          llvm_mir_empty_name(),
                                          0);
        }
        let operand_place = self.m.value_place(value_id);
        if (operand_place != mir_id_invalid()) {
            let place_addr = self.lower_place_addr(operand_place);
            let operand_ll_type = self.lower_type(operand_type);
            if (place_addr == null || operand_ll_type == null) {
                self.report_error("cannot clear pointer handle after delete");
                return null;
            }
            vyx_rt_build_store(self.mod,
                               vyx_rt_const_null(self.mod, operand_ll_type),
                               place_addr);
        }
        return released;
    }
}
