module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn static_assert_sizeof_known(self, value_id: i32) -> bool {
        if (self.m.value_kind(value_id) != mir_value_call()) { return false; }
        let name = self.builtin_name_for_call(value_id);
        if (policy_generic_call_base(name.clone()) != "sizeof") { return false; }
        let args = policy_generic_call_args(name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) { return false; }
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        if (type_id == mir_id_invalid()) { return false; }
        return self.value_storage_size(type_id) > 0;
    }

    public fn static_assert_sizeof_value(self, value_id: i32) -> i64 {
        let name = self.builtin_name_for_call(value_id);
        let args = policy_generic_call_args(name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        return self.value_storage_size(type_id);
    }

    public fn static_assert_i64_known(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_int()
            || kind == mir_value_const_bool()
            || kind == mir_value_const_char()) {
            return true;
        }
        if (kind == mir_value_call()) {
            return self.static_assert_sizeof_known(value_id);
        }
        if (kind == mir_value_cast()) {
            return self.static_assert_i64_known(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_PLUS() || op == llvm_mir_tk_MINUS() || op == llvm_mir_tk_TILDE()) {
                return self.static_assert_i64_known(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op2 = self.m.value_op(value_id);
            if (op2 == llvm_mir_tk_PLUS() || op2 == llvm_mir_tk_MINUS() || op2 == llvm_mir_tk_STAR()
                || op2 == llvm_mir_tk_SLASH() || op2 == llvm_mir_tk_PERCENT()
                || op2 == llvm_mir_tk_AMP() || op2 == llvm_mir_tk_PIPE() || op2 == llvm_mir_tk_CARET()
                || op2 == llvm_mir_tk_LSHIFT() || op2 == llvm_mir_tk_RSHIFT()) {
                if (!self.static_assert_i64_known(self.m.value_lhs(value_id))) { return false; }
                if (!self.static_assert_i64_known(self.m.value_rhs(value_id))) { return false; }
                if ((op2 == llvm_mir_tk_SLASH() || op2 == llvm_mir_tk_PERCENT())
                    && self.static_assert_i64_value(self.m.value_rhs(value_id)) == 0) {
                    return false;
                }
                return true;
            }
            return false;
        }
        if (kind == mir_value_control_result()) {
            if (!self.static_assert_bool_known(self.m.value_lhs(value_id))) { return false; }
            if (!self.static_assert_i64_known(self.m.value_rhs(value_id))) { return false; }
            return self.static_assert_i64_known(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn static_assert_i64_value(self, value_id: i32) -> i64 {
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_int()
            || kind == mir_value_const_bool()
            || kind == mir_value_const_char()) {
            return self.m.value_int(value_id);
        }
        if (kind == mir_value_call()) {
            return self.static_assert_sizeof_value(value_id);
        }
        if (kind == mir_value_cast()) {
            return self.static_assert_i64_value(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            let inner = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_MINUS()) { return 0 - inner; }
            if (op == llvm_mir_tk_TILDE()) { return ~inner; }
            return inner;
        }
        if (kind == mir_value_binary()) {
            let op2 = self.m.value_op(value_id);
            let lhs = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let rhs = self.static_assert_i64_value(self.m.value_rhs(value_id));
            if (op2 == llvm_mir_tk_PLUS()) { return lhs + rhs; }
            if (op2 == llvm_mir_tk_MINUS()) { return lhs - rhs; }
            if (op2 == llvm_mir_tk_STAR()) { return lhs * rhs; }
            if (op2 == llvm_mir_tk_SLASH()) { return lhs / rhs; }
            if (op2 == llvm_mir_tk_PERCENT()) { return lhs % rhs; }
            if (op2 == llvm_mir_tk_AMP()) { return lhs & rhs; }
            if (op2 == llvm_mir_tk_PIPE()) { return lhs | rhs; }
            if (op2 == llvm_mir_tk_CARET()) { return lhs ^ rhs; }
            if (op2 == llvm_mir_tk_LSHIFT()) { return lhs << rhs; }
            if (op2 == llvm_mir_tk_RSHIFT()) { return lhs >> rhs; }
        }
        if (kind == mir_value_control_result()) {
            if (self.static_assert_bool_value(self.m.value_lhs(value_id))) {
                return self.static_assert_i64_value(self.m.value_rhs(value_id));
            }
            return self.static_assert_i64_value(self.m.value_aux(value_id));
        }
        return 0;
    }

    public fn static_assert_bool_known(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_bool()) { return true; }
        if (kind == mir_value_const_int() || kind == mir_value_const_char()) { return true; }
        if (kind == mir_value_cast()) {
            return self.static_assert_bool_known(self.m.value_lhs(value_id))
                || self.static_assert_i64_known(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            if (self.m.value_op(value_id) == llvm_mir_tk_NOT()) {
                return self.static_assert_bool_known(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_AND() || op == llvm_mir_tk_OR()) {
                return self.static_assert_bool_known(self.m.value_lhs(value_id))
                    && self.static_assert_bool_known(self.m.value_rhs(value_id));
            }
            if (op == llvm_mir_tk_EQEQ() || op == llvm_mir_tk_NEQ()
                || op == llvm_mir_tk_LT() || op == llvm_mir_tk_LE()
                || op == llvm_mir_tk_GT() || op == llvm_mir_tk_GE()) {
                return self.static_assert_i64_known(self.m.value_lhs(value_id))
                    && self.static_assert_i64_known(self.m.value_rhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_control_result()) {
            if (!self.static_assert_bool_known(self.m.value_lhs(value_id))) { return false; }
            if (!self.static_assert_bool_known(self.m.value_rhs(value_id))) { return false; }
            return self.static_assert_bool_known(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn static_assert_bool_value(self, value_id: i32) -> bool {
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_bool()) { return self.m.value_int(value_id) != 0; }
        if (kind == mir_value_const_int() || kind == mir_value_const_char()) {
            return self.m.value_int(value_id) != 0;
        }
        if (kind == mir_value_cast()) {
            let inner = self.m.value_lhs(value_id);
            if (self.static_assert_bool_known(inner)) { return self.static_assert_bool_value(inner); }
            return self.static_assert_i64_value(inner) != 0;
        }
        if (kind == mir_value_unary()) {
            if (self.m.value_op(value_id) == llvm_mir_tk_NOT()) {
                return !self.static_assert_bool_value(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_AND()) {
                return self.static_assert_bool_value(self.m.value_lhs(value_id))
                    && self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            if (op == llvm_mir_tk_OR()) {
                return self.static_assert_bool_value(self.m.value_lhs(value_id))
                    || self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            let lhs = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let rhs = self.static_assert_i64_value(self.m.value_rhs(value_id));
            if (op == llvm_mir_tk_EQEQ()) { return lhs == rhs; }
            if (op == llvm_mir_tk_NEQ()) { return lhs != rhs; }
            if (op == llvm_mir_tk_LT()) { return lhs < rhs; }
            if (op == llvm_mir_tk_LE()) { return lhs <= rhs; }
            if (op == llvm_mir_tk_GT()) { return lhs > rhs; }
            if (op == llvm_mir_tk_GE()) { return lhs >= rhs; }
        }
        if (kind == mir_value_control_result()) {
            if (self.static_assert_bool_value(self.m.value_lhs(value_id))) {
                return self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            return self.static_assert_bool_value(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn lower_static_assert_instr(self, instr_id: i32) {
        let value_id = self.m.instr_value(instr_id);
        if (!self.static_assert_bool_known(value_id)) {
            self.report_error("static_assert condition is not compile-time evaluable in MIR instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        if (!self.static_assert_bool_value(value_id)) {
            self.report_error("static_assert failed in MIR instr #"
                      + policy_i64_to_string(instr_id as i64));
        }
    }

    // Heap-allocate a zeroed object for a class-pointer-ABI record type.
    // Mirrors the allocation half of lower_class_pointer_aggregate_value.
}
