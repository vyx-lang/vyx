module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn diagnostic_loc_for_value(self, value_id: i32) -> rawptr {
        return mir_unit_diag_loc_for_value(&self.m, value_id);
    }

    public fn diagnostic_loc(self) -> rawptr {
        var loc = mir_unit_diag_loc_for_instr(&self.m, self.current_instr_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_value(&self.m, self.current_value_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_place(&self.m, self.current_place_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_block(&self.m, self.current_block_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_function(&self.m, self.current_function_id);
        if (loc != null) { return loc; }
        return mir_unit_diag_first_loc(&self.m);
    }

    public fn report_error_at(self, loc: rawptr, msg: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        var anchor = loc;
        if (anchor == null || ast_read_i32(anchor) <= 0) { anchor = self.diagnostic_loc(); }
        diag_emit_codegen_at(anchor, text + msg);
    }

    public fn report_error(self, msg: string) {
        self.report_error_at(null, msg);
    }

    public fn report_error_at_value(self, value_id: i32, msg: string) {
        self.report_error_at(self.diagnostic_loc_for_value(value_id), msg);
    }

    /// A capability boundary rather than an internal invariant failure: the
    /// descriptor asks for an alignment this backend's foreign-value layout has
    /// no anchor type for.  Reported under its own code so the help text can
    /// say what *is* supported instead of telling the user to file a compiler
    /// bug (which is what the generic codegen code does).
    public fn report_unsupported_alignment(self, alignment: i64, type_text: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        var anchor = self.diagnostic_loc();
        if (anchor != null && ast_read_i32(anchor) <= 0) { anchor = null; }
        diag_emit_at(diag_sev_ERROR(),
                     diag_code_codegen_unsupported(),
                     anchor,
                     text + "foreign value layout alignment " + alignment.toString()
                     + " is not supported for " + type_text);
    }

    public fn report_unresolved_direct_call(self,
                                            value_id: i32,
                                            target_fn: i32,
                                            declaration_ok: bool) {
        let label = self.call_value_label(value_id);
        if (target_fn == mir_id_invalid()
            || target_fn < 1
            || target_fn > self.m.function_count) {
            self.report_error_at_value(value_id,
                                       "cannot call `" + label
                                       + "`: no callable function was selected"
                                       + self.call_value_context(value_id)
                                       + self.value_debug_suffix(value_id));
            return;
        }
        var reason = "the selected function could not be materialized";
        if (!declaration_ok && self.function_has_open_template_types(target_fn)) {
            reason = "the selected generic function still contains unbound template types";
        } else if (!declaration_ok) {
            reason = "the selected function has no declarable ABI signature";
        }
        let loc = self.diagnostic_loc_for_value(value_id);
        self.report_error_at_value(value_id,
                                   "cannot call `" + label + "`: " + reason
                                   + self.call_value_context(value_id)
                                   + self.value_debug_suffix(value_id));
        diag_emit_codegen_note_at(loc,
                                  "selected candidate: "
                                  + self.function_visible_signature(target_fn));
        let generic_params = mir_unit_function_generic_params(&self.m, target_fn);
        let generic_args = mir_unit_function_generic_args(&self.m, target_fn);
        if (generic_params.len > 0 || generic_args.len > 0) {
            diag_emit_codegen_note_at(loc,
                                      "generic substitution: `" + generic_params
                                      + "` => `" + generic_args + "`");
        }
    }

    public fn function_visible_param_count(self, function_id: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        var count: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (mir_unit_local_is_source_param(&self.m, local)
                && !mir_unit_local_is_self_receiver_param(&self.m, local)) {
                count = count + 1;
            }
            local = self.m.local_next(local);
        }
        return count;
    }

    public fn function_visible_signature(self, function_id: i32) -> string {
        if (function_id < 1 || function_id > self.m.function_count) {
            return "fn <unknown>()";
        }
        var out = "fn " + self.m.function_name(function_id) + "(";
        var first = true;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (mir_unit_local_is_source_param(&self.m, local)
                && !mir_unit_local_is_self_receiver_param(&self.m, local)) {
                if (!first) { out = out + ", "; }
                var param_name = self.m.local_name(local);
                if (param_name.len == 0) { param_name = "_"; }
                out = out + param_name + ": "
                    + llvm_mir_type_text(&self.m, self.m.local_type(local));
                first = false;
            }
            local = self.m.local_next(local);
        }
        out = out + ") -> "
            + llvm_mir_type_text(&self.m, self.m.function_return_type(function_id));
        return out;
    }

    public fn direct_call_same_name_candidate_count(self,
                                                    function_id: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        let name = self.m.function_name(function_id);
        var count: i32 = 0;
        var candidate: i32 = 1;
        while (candidate <= self.m.function_count) {
            if (self.m.function_name(candidate) == name) { count = count + 1; }
            candidate = candidate + 1;
        }
        return count;
    }

    public fn direct_call_matching_arity_candidate_count(self,
                                                         function_id: i32,
                                                         argc: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        let name = self.m.function_name(function_id);
        var count: i32 = 0;
        var candidate: i32 = 1;
        while (candidate <= self.m.function_count) {
            if (self.m.function_name(candidate) == name
                && self.function_visible_param_count(candidate) == argc) {
                count = count + 1;
            }
            candidate = candidate + 1;
        }
        return count;
    }

    public fn report_direct_call_arity_error(self,
                                             value_id: i32,
                                             function_id: i32,
                                             argc: i32) {
        let expected = self.function_visible_param_count(function_id);
        let candidate_count = self.direct_call_same_name_candidate_count(function_id);
        let matching_count = self.direct_call_matching_arity_candidate_count(function_id,
                                                                              argc);
        var message = "no matching overload for call to '"
            + self.m.function_name(function_id) + "': "
            + policy_i64_to_string(argc as i64) + " argument";
        if (argc != 1) { message = message + "s"; }
        message = message + " provided; ";
        if (candidate_count <= 1) {
            message = message + "the only candidate requires ";
        } else {
            message = message + "the selected candidate requires ";
        }
        message = message + policy_i64_to_string(expected as i64) + " argument";
        if (expected != 1) { message = message + "s"; }
        if (matching_count == 0 && candidate_count > 1) {
            message = message + "; no other candidate accepts "
                + policy_i64_to_string(argc as i64) + " argument";
            if (argc != 1) { message = message + "s"; }
        }
        message = message + "; candidate: "
            + self.function_visible_signature(function_id);
        self.report_error_at_value(value_id, message);
    }

    public fn report_error_with_context(self, msg: string, context: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        if (context.len > 0) {
            text = text + msg + " (" + context + ")";
        } else {
            text = text + msg;
        }
        diag_emit_codegen_at(self.diagnostic_loc(), text);
    }

    public fn value_debug_suffix(self, value_id: i32) -> string {
        if (vyx_bootstrap_profile_level() <= 0) { return ""; }
        if (value_id == mir_id_invalid()) { return ""; }
        return " [value #" + policy_i64_to_string(value_id as i64) + "]";
    }

    public fn call_value_label(self, value_id: i32) -> string {
        if (value_id == mir_id_invalid()) { return "<unknown>"; }
        var label = self.m.value_name(value_id);
        if (label.len == 0) {
            let callee_id = self.m.value_lhs(value_id);
            if (callee_id != mir_id_invalid()) {
                label = self.m.value_name(callee_id);
            }
        }
        if (label.len == 0) { label = "<unknown>"; }
        return label;
    }

    public fn call_value_context(self, value_id: i32) -> string {
        if (value_id == mir_id_invalid()) { return ""; }
        let text = self.m.value_text(value_id);
        if (text.len == 0) { return ""; }
        return " (" + text + ")";
    }

    public fn release_temp_strings(self, mark: rawptr) {
        vyx_rt_string_arena_release(mark);
    }

    public fn memory_mb_text(self, bytes: i64) -> string {
        if (bytes < 0) { return "-1"; }
        return policy_i64_to_string(bytes / 1048576);
    }

    public fn runtime_last_error(self) -> string {
        if (self.mod == null) { return ""; }
        let buf = malloc(4096);
        if (buf == null) { return ""; }
        let n = vyx_rt_get_last_error(self.mod, buf, 4096);
        var out = "";
        if (n > 0) { out = from_cstr_len(buf, n as i64); }
        free(buf);
        return out;
    }
}
