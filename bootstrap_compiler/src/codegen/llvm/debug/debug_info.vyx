module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn debug_value_line(self, value_id: i32) -> i32 {
        if (!self.debug_enabled || value_id <= 0 || value_id > self.m.value_count) {
            return 0;
        }
        let line = self.m.value_loc_line(value_id);
        if (line > 0) { return line; }
        let lhs = self.m.value_lhs(value_id);
        if (lhs > 0 && lhs != value_id) {
            let lhs_line = self.m.value_loc_line(lhs);
            if (lhs_line > 0) { return lhs_line; }
        }
        let rhs = self.m.value_rhs(value_id);
        if (rhs > 0 && rhs != value_id) {
            let rhs_line = self.m.value_loc_line(rhs);
            if (rhs_line > 0) { return rhs_line; }
        }
        return 0;
    }

    public fn debug_instr_line(self, instr_id: i32) -> i32 {
        if (!self.debug_enabled || instr_id <= 0 || instr_id > self.m.instr_count) {
            return 0;
        }
        var line = self.m.instr_loc_line(instr_id);
        if (line <= 0) { line = self.debug_value_line(self.m.instr_value(instr_id)); }
        if (line <= 0) { line = self.debug_value_line(self.m.instr_lhs(instr_id)); }
        if (line <= 0) { line = self.debug_value_line(self.m.instr_rhs(instr_id)); }
        return line;
    }

    public fn debug_instr_col(self, instr_id: i32) -> i32 {
        if (!self.debug_enabled || instr_id <= 0 || instr_id > self.m.instr_count) {
            return 1;
        }
        let col = self.m.instr_loc_col(instr_id);
        if (col > 0) { return col; }
        return 1;
    }

    public fn debug_function_line(self, function_id: i32) -> i32 {
        if (!self.debug_enabled) { return 1; }
        var block = self.m.function_first_block(function_id);
        while (block != mir_id_invalid()) {
            var instr = self.m.block_first_instr(block);
            while (instr != mir_id_invalid()) {
                let line = self.debug_instr_line(instr);
                if (line > 1) { return line - 1; }
                if (line > 0) { return line; }
                instr = self.m.instr_next(instr);
            }
            let term_line = self.debug_value_line(self.m.block_term_value(block));
            if (term_line > 0) { return term_line; }
            block = self.m.block_next(block);
        }
        return 1;
    }

    public fn set_debug_location_for_instr(self, instr_id: i32) {
        let line = self.debug_instr_line(instr_id);
        if (line > 0) { vyx_rt_debug_location(self.mod, line, self.debug_instr_col(instr_id)); }
    }

    public fn set_debug_location_for_terminator(self, block_id: i32) {
        var line = self.debug_value_line(self.m.block_term_value(block_id));
        var col: i32 = 1;
        if (line <= 0) {
            line = self.m.block_loc_line(block_id);
            let block_col = self.m.block_loc_col(block_id);
            if (block_col > 0) { col = block_col; }
        }
        if (line > 0) { vyx_rt_debug_location(self.mod, line, col); }
    }

    public fn declare_debug_locals_for_function(self, function_id: i32) {
        if (!self.debug_enabled || self.current_function_value == null) { return; }
        var source_arg_index: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (!self.local_is_capture(local)) {
                let name = self.m.local_name(local);
                let hir_local = self.m.local_hir_id(local);
                let slot = llvm_mir_map_get(self.local_slots, local);
                if (slot != null && hir_local != hir_id_invalid()
                    && name.len > 0 && !name.contains("$")) {
                    llvm_mir_i32_map_put(self.local_debug_pending, local, 1);
                    if (self.local_is_source_param(local)) {
                        source_arg_index = source_arg_index + 1;
                    }
                } else if (self.local_is_source_param(local)) {
                    source_arg_index = source_arg_index + 1;
                }
            }
            local = self.m.local_next(local);
        }
    }

    public fn emit_debug_local_at_assignment(self, local: i32, assignment: rawptr) {
        if (!self.debug_enabled || assignment == null || local == mir_id_invalid()) { return; }
        if (llvm_mir_i32_map_get(self.local_debug_pending, local) == 0) { return; }
        let name = self.m.local_name(local);
        let slot = llvm_mir_map_get(self.local_slots, local);
        if (slot == null || name.len == 0) { return; }
        let type_id = self.local_effective_type(local);
        let llvm_ty = self.lower_type(type_id);
        if (llvm_ty == null) { return; }
        var source_arg_index: i32 = 0;
        var arg_index: i32 = 0;
        if (self.local_is_source_param(local)) {
            var cursor = self.m.function_first_local(self.current_function_id);
            while (cursor != mir_id_invalid()) {
                if (self.local_is_source_param(cursor)) {
                    source_arg_index = source_arg_index + 1;
                    if (cursor == local) { arg_index = source_arg_index; }
                }
                cursor = self.m.local_next(cursor);
            }
        }
        var line = self.m.local_loc_line(local);
        if (line <= 0) { line = self.debug_function_line(self.current_function_id); }
        let type_name = llvm_mir_type_text(&self.m, type_id);
        let field_names = self.debug_record_field_names(type_id);
        let saved_block = vyx_rt_get_insert_block(self.mod);
        vyx_rt_position_before(self.mod, assignment);
        vyx_rt_debug_declare_local(self.mod,
                                   self.current_function_value,
                                   slot,
                                   llvm_ty,
                                   name.c_str(),
                                   name.len as u64,
                                   type_name.c_str(),
                                   type_name.len as u64,
                                   field_names.c_str(),
                                   field_names.len as u64,
                                   line,
                                   arg_index);
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
        llvm_mir_i32_map_put(self.local_debug_pending, local, 0);
    }

    public fn debug_record_field_names(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        let owner = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, owner) != ty_CLASS()) { return ""; }
        let count = mir_unit_field_count_for_type(&self.m, owner);
        if (count <= 0) { return ""; }
        var names = "";
        var index: i32 = 0;
        while (index < count) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, owner, index);
            if (field_id == mir_id_invalid()) { return ""; }
            let field_name = mir_unit_field_name(&self.m, field_id);
            if (field_name.len == 0) { return ""; }
            if (index > 0) { names = names + ","; }
            names = names + field_name;
            index = index + 1;
        }
        return names;
    }
}
