module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn call_arg_count(self, value_id: i32) -> i32 {
        var n: i32 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            n = n + 1;
            cur = self.m.value_next_arg(cur);
        }
        return n;
    }

    public fn call_arg_payload(self, arg_node_id: i32) -> i32 {
        if (arg_node_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.value_kind(arg_node_id) == mir_value_arg()) {
            let payload = self.m.value_lhs(arg_node_id);
            if (payload != mir_id_invalid()) { return payload; }
        }
        return arg_node_id;
    }

    public fn call_arg_at(self, value_id: i32, idx: i32) -> i32 {
        var i: i32 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (i == idx) { return self.call_arg_payload(cur); }
            i = i + 1;
            cur = self.m.value_next_arg(cur);
        }
        return mir_id_invalid();
    }

    public fn builtin_name_for_call(self, value_id: i32) -> string {
        let call_name = self.m.value_name(value_id);
        if (call_name.len > 0) { return call_name; }
        let lhs = self.m.value_lhs(value_id);
        if (lhs != mir_id_invalid()) {
            let lhs_name = self.m.value_name(lhs);
            if (lhs_name.len > 0) { return lhs_name; }
        }
        return "";
    }

    public fn resolved_call_name(self, value_id: i32) -> string {
        if (self.m.value_target_kind(value_id) == mir_target_builtin()) {
            return self.builtin_name_for_call(value_id);
        }
        let lhs = self.m.value_lhs(value_id);
        if (lhs != mir_id_invalid()) {
            let lhs_name = self.m.value_name(lhs);
            if (lhs_name.len > 0) { return lhs_name; }
        }
        if (self.m.value_target_kind(value_id) == mir_target_function()) {
            return self.m.function_name(self.m.value_target_id(value_id));
        }
        if (lhs != mir_id_invalid() && self.m.value_target_kind(lhs) == mir_target_function()) {
            return self.m.function_name(self.m.value_target_id(lhs));
        }
        return "";
    }

    public fn direct_call_receiver(self, value_id: i32) -> i32 {
        let callee = self.direct_call_callee(value_id);
        if (callee == mir_id_invalid()) { return mir_id_invalid(); }
        let target_fn = self.m.value_target_id(callee);
        if (target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_source_param_count(target_fn) <= self.call_arg_count(value_id)) {
            return mir_id_invalid();
        }
        let receiver = self.m.value_lhs(callee);
        if (receiver == mir_id_invalid()) { return mir_id_invalid(); }
        return receiver;
    }

    public fn call_receiver_type(self, value_id: i32) -> i32 {
        let receiver = self.direct_call_receiver(value_id);
        if (receiver == mir_id_invalid()) { return mir_id_invalid(); }
        return self.m.value_type(receiver);
    }

    public fn materialize_std_string_self_from_str_abi(self, value_id: i32, string_type: i32) -> rawptr {
        if (value_id == mir_id_invalid() || string_type == mir_id_invalid()) { return null; }
        let view = self.lower_string_view_value(value_id);
        let data_ptr = self.string_ptr_value(view);
        let len_v = self.string_len_value(view);
        if (view == null || data_ptr == null || len_v == null) {
            self.report_error("cannot lower str view for std String self");
            return null;
        }
        let owner_type = self.canonical_record_type_id(string_type);
        var record_ty = self.lower_type(owner_type);
        if (self.type_is_class_pointer_abi(owner_type)) {
            record_ty = self.class_record_storage_ty(owner_type);
        }
        if (record_ty == null) {
            self.report_error("cannot lower std String layout for self");
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, record_ty, "mir.str.as.String".c_str(), 18);
        if (tmp == null) {
            self.report_error("cannot allocate std String self temporary");
            return null;
        }
        let ptr_gep = self.record_field_addr_for_type(tmp, owner_type, "ptr");
        let len_gep = self.record_field_addr_for_type(tmp, owner_type, "len");
        let cap_gep = self.record_field_addr_for_type(tmp, owner_type, "cap");
        let owned_gep = self.record_field_addr_for_type(tmp, owner_type, "owned");
        let inline0_gep = self.record_field_addr_for_type(tmp, owner_type, "inline0");
        let inline1_gep = self.record_field_addr_for_type(tmp, owner_type, "inline1");
        let inline2_gep = self.record_field_addr_for_type(tmp, owner_type, "inline2");
        if (ptr_gep == null || len_gep == null || cap_gep == null || owned_gep == null
            || inline0_gep == null || inline1_gep == null || inline2_gep == null) {
            self.report_error("cannot address std String self fields");
            return null;
        }
        let zero64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        // owned=heap so `_data_ptr` reads `.ptr` (the str view bytes) instead of
        // SSO `inline0`. The temporary is not dropped; it only borrows the view.
        let heap_flag = vyx_rt_const_int(self.mod, self.ty_i64, 1, 0);
        vyx_rt_build_store(self.mod, data_ptr, ptr_gep);
        vyx_rt_build_store(self.mod, len_v, len_gep);
        vyx_rt_build_store(self.mod, len_v, cap_gep);
        vyx_rt_build_store(self.mod, heap_flag, owned_gep);
        vyx_rt_build_store(self.mod, zero64, inline0_gep);
        vyx_rt_build_store(self.mod, zero64, inline1_gep);
        vyx_rt_build_store(self.mod, zero64, inline2_gep);
        return tmp;
    }

    public fn lower_self_receiver_address(self, value_id: i32, type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let source_type_id = self.m.value_type(value_id);
        if (self.type_is_std_string_class(type_id) && self.type_is_str_abi(source_type_id)) {
            return self.materialize_std_string_self_from_str_abi(value_id, type_id);
        }
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, source_type_id))) {
            let handle = self.lower_value_as(value_id, source_type_id);
            let address = self.pointer_handle_address(handle, "mir.self.handle");
            if (handle == null || address == null) {
                self.report_error("cannot extract pointer handle receiver for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return self.adjust_dci_base_pointer(address,
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        if (self.heap_indirect_payload_matches(self.m.value_type(value_id), type_id)) {
            let payload_addr = self.lower_heap_indirect_payload_address(value_id, type_id);
            if (payload_addr != null) {
                return self.adjust_dci_base_pointer(payload_addr,
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
        }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_read_place() || kind == mir_value_address_of()) {
            let place_id = self.m.value_place(value_id);
            let addr = self.lower_place_addr(place_id);
            if (self.place_is_self_pointer_abi_slot(place_id)) {
                return self.adjust_dci_base_pointer(self.load_self_pointer_abi_slot(place_id, addr, type_id),
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
            if (self.type_is_class_pointer_abi(type_id)) {
                return self.adjust_dci_base_pointer(self.class_object_addr_from_place_addr(place_id, addr, type_id),
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
            return self.adjust_dci_base_pointer(addr,
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.adjust_dci_base_pointer(self.lower_value_as(value_id, type_id),
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        let ty = self.lower_type(type_id);
        let tmp = vyx_rt_build_alloca(self.mod, ty, "mir.self.arg".c_str(), 12);
        let value = self.lower_value_as(value_id, type_id);
        if (tmp == null || value == null) {
            self.report_error("cannot materialize receiver address for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, value, tmp);
        return tmp;
    }

    public fn lower_static_self_receiver_address(self, value_id: i32, type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let source_type_id = self.m.value_type(value_id);
        let item_id = self.m.value_target_id(value_id);
        let gv = self.get_or_create_hir_item_global(item_id, type_id, self.m.value_name(value_id));
        if (gv == null) { return null; }
        if (self.type_is_class_pointer_abi(type_id)) {
            let obj = vyx_rt_build_load(self.mod,
                                        self.ty_ptr,
                                        gv,
                                        "mir.global.self".c_str(),
                                        15);
            if (obj == null) {
                self.report_error("cannot load global class receiver for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return self.adjust_dci_base_pointer(obj,
                                                source_type_id,
                                                type_id,
                                                "dci.static.self.base");
        }
        return gv;
    }

    public fn place_is_direct_class_object_pointer(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        let kind = self.m.place_kind(place_id);
        if (kind == mir_place_deref()) { return true; }
        if (kind != mir_place_local()) { return false; }
        let local = self.m.place_local(place_id);
        if (local == mir_id_invalid()) { return false; }
        return self.local_uses_self_pointer_abi(self.m.place_function(place_id), local);
    }

    public fn place_is_self_pointer_abi_slot(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local = self.m.place_local(place_id);
        if (local == mir_id_invalid()) { return false; }
        return self.local_is_self_pointer_abi_slot(self.m.place_function(place_id), local);
    }

    public fn load_self_pointer_abi_slot(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.self.obj".c_str(),
                                    12);
        if (obj == null) {
            self.report_error("cannot load self object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn class_object_addr_from_place_addr(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        if (self.place_is_self_pointer_abi_slot(place_id)) {
            return self.load_self_pointer_abi_slot(place_id, place_addr, type_id);
        }
        if (!self.type_is_class_pointer_abi(type_id)) { return place_addr; }
        if (self.place_is_direct_class_object_pointer(place_id)) { return place_addr; }
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.class.obj".c_str(),
                                    13);
        if (obj == null) {
            self.report_error("cannot load class object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn ensure_class_object_addr_from_place_addr(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        if (self.place_is_self_pointer_abi_slot(place_id)) {
            return self.load_self_pointer_abi_slot(place_id, place_addr, type_id);
        }
        if (!self.type_is_class_pointer_abi(type_id)) { return place_addr; }
        if (self.place_is_direct_class_object_pointer(place_id)) { return place_addr; }
        if (self.current_function_value == null) {
            self.report_error("cannot materialize class storage outside a function for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let current_obj = vyx_rt_build_load(self.mod,
                                            self.ty_ptr,
                                            place_addr,
                                            "mir.class.obj".c_str(),
                                            13);
        if (current_obj == null) {
            self.report_error("cannot load class object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let is_null = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        current_obj,
                                        vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                        "mir.class.null".c_str(),
                                        14);
        let alloc_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           "mir.class.ensure.alloc".c_str(),
                                           22);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.class.ensure.cont".c_str(),
                                          21);
        if (is_null == null || alloc_bb == null || cont_bb == null) {
            self.report_error("cannot create class storage materialization flow for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_null, alloc_bb, cont_bb);
        vyx_rt_position_at_end(self.mod, alloc_bb);
        let new_obj = self.build_zeroed_class_object(type_id);
        if (new_obj == null) { return null; }
        vyx_rt_build_store(self.mod, new_obj, place_addr);
        vyx_rt_build_br(self.mod, cont_bb);
        vyx_rt_position_at_end(self.mod, cont_bb);
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.class.obj".c_str(),
                                    13);
        if (obj == null) {
            self.report_error("cannot reload materialized class object for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn receiver_for_builtin_call(self, value_id: i32) -> i32 {
        let callee = self.m.value_lhs(value_id);
        if (callee != mir_id_invalid()) {
            let receiver = self.m.value_lhs(callee);
            if (receiver != mir_id_invalid()) { return receiver; }
        }
        if (self.call_arg_count(value_id) > 0) { return self.call_arg_at(value_id, 0); }
        return mir_id_invalid();
    }

    public fn receiver_for_builtin_member_value(self, value_id: i32) -> i32 {
        if (self.m.value_kind(value_id) == mir_value_target_ref()) {
            let receiver = self.m.value_lhs(value_id);
            if (receiver != mir_id_invalid()) { return receiver; }
        }
        return self.receiver_for_builtin_call(value_id);
    }

    public fn lower_std_string_raw_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 0) { return null; }
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) { return null; }
        if (!self.type_is_std_string_class(self.m.value_type(receiver_id))) { return null; }
        return self.lower_std_string_as_str_value(receiver_id);
    }

    public fn lower_string_builder_create_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 0) { return null; }
        if (self.builtin_string_builder_create_fn == null || self.builtin_string_builder_create_fty == null) { return null; }
        let ret_type = self.m.value_type(value_id);
        let ret_text = llvm_mir_type_text(&self.m, ret_type);
        if (!ret_text.contains("StringBuilder")) { return null; }
        return vyx_rt_build_call(self.mod,
                                 self.builtin_string_builder_create_fty,
                                 self.builtin_string_builder_create_fn,
                                 null,
                                 0,
                                 "mir.stringbuilder.create".c_str(),
                                 24);
    }

    public fn lower_string_builder_append_i64_call(self, value_id: i32) -> bool {
        if (self.call_arg_count(value_id) != 1) { return false; }
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) { return false; }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type);
        if (!receiver_text.contains("StringBuilder")) { return false; }

        let arg_id = self.call_arg_at(value_id, 0);
        let arg_call_name = self.resolved_call_name(arg_id);
        if (!(arg_call_name == "toString" || arg_call_name == "to_string")) { return false; }
        let int_receiver_id = self.receiver_for_builtin_call(arg_id);
        if (int_receiver_id == mir_id_invalid()) { return false; }
        let int_receiver_type = self.m.value_type(int_receiver_id);
        let int_kind = llvm_mir_type_kind(&self.m, int_receiver_type);
        if (llvm_mir_int_bits_for_kind(int_kind) <= 0) { return false; }
        if (int_kind == ty_BOOL()) { return false; }

        let append_unsigned = llvm_mir_kind_decimal_unsigned(int_kind);
        var append_fn: rawptr = self.builtin_string_builder_append_i64_fn;
        var append_fty: rawptr = self.builtin_string_builder_append_i64_fty;
        if (append_unsigned) {
            append_fn = self.builtin_string_builder_append_u64_fn;
            append_fty = self.builtin_string_builder_append_u64_fty;
        }
        if (append_fn == null || append_fty == null) { return false; }

        let builder_addr = self.lower_self_receiver_address(receiver_id, receiver_type);
        let int_value = self.int_value_to_bits(self.lower_value(int_receiver_id), int_receiver_type, 64);
        if (builder_addr == null || int_value == null) {
            self.report_error("cannot lower StringBuilder.append integer fast path");
            return true;
        }
        vyx_rt_build_call2(self.mod,
                           append_fty,
                           append_fn,
                           builder_addr,
                           int_value,
                           llvm_mir_empty_name(),
                           0);
        return true;
    }
}
