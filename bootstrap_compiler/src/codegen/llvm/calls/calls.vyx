module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn lower_call_value(self, value_id: i32) -> rawptr {
        let call_name = self.resolved_call_name(value_id);
        let call_base_name = policy_generic_call_base(call_name.clone());
        let direct_target_for_name_dispatch = self.direct_call_target_function(value_id);
        // Built-in pointer methods on *T / &T / &mut T / rawptr receivers.
        if (direct_target_for_name_dispatch == mir_id_invalid()) {
            let pmk = policy_pointer_method_kind(call_base_name.clone());
            if (pmk > 0) {
                let receiver_probe = self.receiver_for_builtin_call(value_id);
                if (receiver_probe != mir_id_invalid()
                    && llvm_mir_kind_pointer_like(llvm_mir_type_kind(&self.m, self.m.value_type(receiver_probe)))) {
                    return self.lower_pointer_method_call(value_id, pmk);
                }
            }
        }
        if (call_base_name == "sizeof") { return self.lower_sizeof_call(value_id, call_name); }
        if (call_base_name == "repr_sizeof") { return self.lower_repr_sizeof_call(value_id, call_name); }
        if (call_base_name == "alignof") { return self.lower_alignof_call(value_id, call_name); }
        if (call_base_name == "typeof") { return self.lower_typeof_call(value_id); }
        if (call_base_name == "typeinfo") { return self.lower_typeinfo_call(value_id); }
        if (call_base_name == "type_name") { return self.lower_type_name_call(value_id, call_name); }
        if (call_base_name == "reflect_name") { return self.lower_reflect_name_call(value_id, call_name); }
        if (call_base_name == "reflect_manifest") { return self.lower_reflect_manifest_call(value_id); }
        if (call_base_name == "reflect_method_ptr_by_id") { return self.lower_reflect_method_ptr_by_id_call(value_id); }
        if (call_base_name == "reflect_method_value") { return self.lower_reflect_method_value_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_count") { return self.lower_field_count_call(value_id, call_name); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_name") { return self.lower_field_name_call(value_id, call_name); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_type") { return self.lower_field_type_call(value_id, call_name); }
        if (call_name == "print" || call_name == "println") {
            return self.lower_print_like_call(value_id, call_name);
        }
        if (call_name == "format" && direct_target_for_name_dispatch == mir_id_invalid()) {
            return self.lower_format_call(value_id);
        }
        if (call_name == "argCount") { return self.lower_arg_count_call(value_id); }
        if (call_name == "getArg") { return self.lower_get_arg_call(value_id); }
        if (call_name == "int_to_string") { return self.lower_int_to_string_runtime_call(value_id); }
        if (call_name == "bool_to_string") { return self.lower_bool_to_string_runtime_call(value_id); }
        if (call_name == "raw" || call_name == "_borrow_raw") {
            let raw_str = self.lower_std_string_raw_call(value_id);
            if (raw_str != null) { return raw_str; }
        }
        if (call_name == "clone") {
            let clone_receiver = self.receiver_for_builtin_call(value_id);
            if (clone_receiver != mir_id_invalid()
                && self.type_is_str_abi(self.m.value_type(clone_receiver))) {
                return self.lower_string_clone_call(value_id);
            }
        }
        if (call_name == "create") {
            let sb_create = self.lower_string_builder_create_call(value_id);
            if (sb_create != null) { return sb_create; }
        }
        if (call_name == "append" && self.lower_string_builder_append_i64_call(value_id)) { return null; }
        if (call_name == "get_unchecked") {
            let vec_get = self.lower_vec_get_unchecked_call(value_id);
            if (vec_get != null) { return vec_get; }
        }
        if (call_name == "set_unchecked" && self.lower_vec_set_unchecked_call(value_id)) { return null; }
        if (call_name == "push_unchecked" && self.lower_vec_push_unchecked_call(value_id)) { return null; }
        if (llvm_mir_effective_target_is_windows()
            && (call_name == "fileExists" || call_name == "isDir" || call_name == "isFile")) {
            return self.lower_fs_path_predicate_call(value_id, call_name);
        }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_concat") { return self.lower_string_concat_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_equals") { return self.lower_string_equals_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_length") { return self.lower_string_len_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_trim") { return self.lower_string_trim_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_replace") { return self.lower_string_replace_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_to_upper") { return self.lower_string_case_call(value_id, true); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_to_lower") { return self.lower_string_case_call(value_id, false); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_index_of") { return self.lower_string_index_of_call(value_id); }
        if (call_name == "isEmpty" || call_name == "is_empty") {
            let receiver_id = self.receiver_for_builtin_member_value(value_id);
            if (receiver_id != mir_id_invalid()
                && self.type_is_string_view_type(self.m.value_type(receiver_id))) {
                return self.lower_string_is_empty_call(value_id);
            }
        }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_substring") { return self.lower_string_substring_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_contains") { return self.lower_string_contains_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_starts_with") { return self.lower_string_starts_with_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_ends_with") { return self.lower_string_ends_with_call(value_id); }
        if ((call_name == "c_str" || call_name == "ptr" || call_name == "data")
            && direct_target_for_name_dispatch == mir_id_invalid()) {
            return self.lower_string_ptr_member_call(value_id, call_name);
        }
        if (call_name == "strlen") { return self.lower_strlen_call(value_id); }
        if (call_name == "from_cstr") { return self.lower_from_cstr_call(value_id); }
        if (call_name == "from_cstr_len") { return self.lower_from_cstr_len_call(value_id, false); }
        if (call_name == "from_cstr_view_len") { return self.lower_from_cstr_len_call(value_id, true); }
        if (call_name == "from_raw_string_parts") { return self.lower_from_raw_string_parts_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && (call_name == "str_char_at" || call_name == "charAt" || call_name == "char_at" || call_name == "byteAt")) {
            return self.lower_string_char_at_call(value_id);
        }
        if (self.type_is_option_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_option_variant_call(value_id);
        }
        if (self.type_is_result_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_result_variant_call(value_id);
        }
        if (self.type_is_plain_enum_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_enum_variant_call(value_id);
        }
        let option_callee_id = self.m.value_lhs(value_id);
        if (self.type_is_option_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_option_variant_call(value_id);
        }
        if (self.type_is_result_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_result_variant_call(value_id);
        }
        if (self.type_is_plain_enum_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_enum_variant_call(value_id);
        }
        if (call_name == "to_rawptr") { return self.lower_to_rawptr_call(value_id); }
        if (call_name == "ptr_offset") { return self.lower_ptr_offset_call(value_id); }
        if (call_name == "ptr_read_u8" || call_name == "ptr_read_i32" || call_name == "ptr_read_i64") {
            return self.lower_ptr_read_call(value_id, call_name);
        }
        if (call_name == "ptr_write_i32" || call_name == "ptr_write_i64") {
            return self.lower_ptr_write_call(value_id, call_name);
        }
        if ((call_name == "vyx_atomic_load_i64"
             || call_name == "__vyx_atomic_load_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_load_i64_call(value_id);
        }
        if ((call_name == "vyx_atomic_fetch_add_i64"
             || call_name == "__vyx_atomic_fetch_add_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_fetch_add_i64_call(value_id);
        }
        if ((call_name == "vyx_atomic_compare_exchange_i64"
             || call_name == "__vyx_atomic_compare_exchange_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_compare_exchange_i64_call(value_id);
        }
        if (call_name == "memcpy") { return self.lower_memcpy_call(value_id); }
        if (call_name == "memmove") { return self.lower_memmove_call(value_id); }
        if (call_name == "memset") { return self.lower_memset_call(value_id); }
        let can_lower_builtin_alloc_name = direct_target_for_name_dispatch == mir_id_invalid()
            || self.m.value_target_kind(value_id) == mir_target_builtin();
        if (can_lower_builtin_alloc_name && call_name == "malloc") { return self.lower_malloc_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "alloc") { return self.lower_malloc_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "free") { return self.lower_free_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "dealloc") { return self.lower_free_call(value_id); }
        if (call_name == "transmute") { return self.lower_transmute_call(value_id); }
        if (call_name == "assert") {
            self.lower_assert_call(value_id);
            return null;
        }
        if (call_name == "assert_eq") { return self.lower_assert_eq_call(value_id); }
        if (call_name == "realloc" && self.call_arg_count(value_id) == 2) { return self.lower_realloc_call(value_id); }
        if (call_name == "memcmp") { return self.lower_memcmp_call(value_id); }
        if (self.m.value_target_kind(value_id) == mir_target_builtin()) {
            let bname = self.builtin_name_for_call(value_id);
            let bbase = policy_generic_call_base(bname.clone());
            if (bbase == "sizeof") { return self.lower_sizeof_call(value_id, bname); }
            if (bbase == "repr_sizeof") { return self.lower_repr_sizeof_call(value_id, bname); }
            if (bbase == "alignof") { return self.lower_alignof_call(value_id, bname); }
            if (bbase == "typeof") { return self.lower_typeof_call(value_id); }
            if (bbase == "typeinfo") { return self.lower_typeinfo_call(value_id); }
            if (bbase == "type_name") { return self.lower_type_name_call(value_id, bname); }
            if (bbase == "reflect_name") { return self.lower_reflect_name_call(value_id, bname); }
            if (bbase == "reflect_manifest") { return self.lower_reflect_manifest_call(value_id); }
            if (bbase == "reflect_method_ptr_by_id") { return self.lower_reflect_method_ptr_by_id_call(value_id); }
            if (bbase == "reflect_method_value") { return self.lower_reflect_method_value_call(value_id); }
            if (bbase == "field_count") { return self.lower_field_count_call(value_id, bname); }
            if (bbase == "field_name") { return self.lower_field_name_call(value_id, bname); }
            if (bbase == "field_type") { return self.lower_field_type_call(value_id, bname); }
            if (bbase == "new" || bbase == "construct") {
                return self.lower_default_new_call(value_id, bbase);
            }
            if (bbase == "panic") { return self.lower_panic_call(value_id); }
            if (bbase == "assert") {
                self.lower_assert_call(value_id);
                return null;
            }
            if (bbase == "assert_eq") { return self.lower_assert_eq_call(value_id); }
            if (bbase == "hash") { return self.lower_hash_call(value_id); }
            if (bbase == "operator_eq" || bbase == "operator==") { return self.lower_operator_eq_call(value_id); }
            if (bbase == "compare") { return self.lower_compare_call(value_id); }
            if (bbase == "format") { return self.lower_format_call(value_id); }
            if (bbase == "argCount") { return self.lower_arg_count_call(value_id); }
            if (bbase == "getArg") { return self.lower_get_arg_call(value_id); }
            if (bbase == "int_to_string") { return self.lower_int_to_string_runtime_call(value_id); }
            if (bbase == "bool_to_string") { return self.lower_bool_to_string_runtime_call(value_id); }
            if (bname == "malloc") { return self.lower_malloc_call(value_id); }
            if (bname == "alloc") { return self.lower_malloc_call(value_id); }
            if (bname == "free") { return self.lower_free_call(value_id); }
            if (bname == "dealloc") { return self.lower_free_call(value_id); }
            if (bname == "realloc") { return self.lower_realloc_call(value_id); }
            if (bname == "memcmp") { return self.lower_memcmp_call(value_id); }
            if (bname == "transmute") { return self.lower_transmute_call(value_id); }
            if (bname == "to_rawptr") { return self.lower_to_rawptr_call(value_id); }
            if (bname == "ptr_offset") { return self.lower_ptr_offset_call(value_id); }
            if (bname == "ptr_read_u8" || bname == "ptr_read_i32" || bname == "ptr_read_i64") {
                return self.lower_ptr_read_call(value_id, bname);
            }
            if (bname == "ptr_write_i32" || bname == "ptr_write_i64") {
                return self.lower_ptr_write_call(value_id, bname);
            }
            if (bname == "memcpy") { return self.lower_memcpy_call(value_id); }
            if (bname == "memmove") { return self.lower_memmove_call(value_id); }
            if (bname == "memset") { return self.lower_memset_call(value_id); }
            if (bname == "toString" || bname == "to_string") { return self.lower_to_string_call(value_id); }
            if (bname == "c_str" || bname == "ptr" || bname == "data") { return self.lower_string_ptr_member_call(value_id, bname); }
            if (bname == "strlen") { return self.lower_strlen_call(value_id); }
            if (bname == "from_cstr") { return self.lower_from_cstr_call(value_id); }
            if (bname == "from_cstr_len") { return self.lower_from_cstr_len_call(value_id, false); }
            if (bname == "from_cstr_view_len") { return self.lower_from_cstr_len_call(value_id, true); }
            if (bname == "from_raw_string_parts") { return self.lower_from_raw_string_parts_call(value_id); }
            if (bname == "len" || bname == "length" || bname == "size" || bname == "count") { return self.lower_string_len_call(value_id); }
            if (bname == "clone") { return self.lower_string_clone_call(value_id); }
            if (bname == "repeat") { return self.lower_string_repeat_call(value_id); }
            if (bname == "isEmpty" || bname == "is_empty") { return self.lower_string_is_empty_call(value_id); }
            if (bname == "trim" || bname == "str_trim") { return self.lower_string_trim_call(value_id); }
            if (bname == "replace" || bname == "str_replace") { return self.lower_string_replace_call(value_id); }
            if (bname == "toUpper" || bname == "to_upper" || bname == "str_to_upper") { return self.lower_string_case_call(value_id, true); }
            if (bname == "toLower" || bname == "to_lower" || bname == "str_to_lower") { return self.lower_string_case_call(value_id, false); }
            if (bname == "substring" || bname == "substr") { return self.lower_string_substring_call(value_id); }
            if (bname == "contains") { return self.lower_string_contains_call(value_id); }
            if (bname == "equals") { return self.lower_string_equals_call(value_id); }
            if (bname == "startsWith" || bname == "starts_with") { return self.lower_string_starts_with_call(value_id); }
            if (bname == "endsWith" || bname == "ends_with") { return self.lower_string_ends_with_call(value_id); }
            if (bname == "find" || bname == "indexOf" || bname == "index_of") { return self.lower_string_index_of_call(value_id); }
            if (bname == "charAt" || bname == "char_at" || bname == "charCodeAt" || bname == "char_code_at" || bname == "byteAt") { return self.lower_string_char_at_call(value_id); }
            self.report_error("cannot lower builtin call " + bname);
            return null;
        }
        let callee_for_fn_value = self.m.value_lhs(value_id);
        if (callee_for_fn_value != mir_id_invalid()) {
            let callee_type_kind = llvm_mir_type_kind(&self.m, self.m.value_type(callee_for_fn_value));
            let callee_is_direct_symbol = self.m.value_kind(callee_for_fn_value) == mir_value_target_ref()
                && self.m.value_target_kind(callee_for_fn_value) == mir_target_function();
            if ((callee_type_kind == ty_FN() || callee_type_kind == ty_CFN())
                && !callee_is_direct_symbol) {
                return self.lower_fn_value_call(value_id);
            }
        }
        var has_direct_function_target = self.m.value_target_kind(value_id) == mir_target_function();
        if (!has_direct_function_target
            && callee_for_fn_value != mir_id_invalid()
            && self.m.value_target_kind(callee_for_fn_value) == mir_target_function()) {
            has_direct_function_target = true;
        }
        if (!has_direct_function_target && callee_for_fn_value != mir_id_invalid()) {
            let callee_kind = llvm_mir_type_kind(&self.m, self.m.value_type(callee_for_fn_value));
            if (callee_kind == ty_FN() || callee_kind == ty_CFN()) {
                return self.lower_fn_value_call(value_id);
            }
        }
        var target_fn = self.direct_call_target_function(value_id);
        if (target_fn != mir_id_invalid()
            && mir_unit_function_owner_item_kind(&self.m, target_fn) == hir_item_interface()) {
            let target_self_type = self.function_source_param_type(target_fn, 0);
            let receiver_type = self.call_receiver_type(value_id);
            let target_dyn = self.type_dyn_trait_id(target_self_type);
            let receiver_dyn = self.type_dyn_trait_id(receiver_type);
            if (target_dyn != mir_id_invalid()
                || (receiver_dyn != mir_id_invalid()
                    && self.interface_function_matches_dyn_trait(target_fn, receiver_dyn))) {
                return self.lower_dyn_trait_call(value_id, target_fn);
            }
            let concrete_target_fn = self.concrete_interface_call_target(value_id, target_fn);
            if (concrete_target_fn != mir_id_invalid()) {
                target_fn = concrete_target_fn;
            } else {
                let concrete_static_fn = self.concrete_static_interface_call_target(value_id, target_fn, call_name);
                if (concrete_static_fn != mir_id_invalid()) {
                    target_fn = concrete_static_fn;
                }
            }
        }
        let const_v = self.bodyless_i64_constant_call(value_id, target_fn, call_name);
        if (const_v != null) { return const_v; }
        let identity_v = self.bodyless_numeric_identity_call(value_id, target_fn, call_name);
        if (identity_v != null) { return identity_v; }
        let concrete_bodyless_static_fn = self.concrete_bodyless_static_call_target(value_id, target_fn, call_name);
        if (concrete_bodyless_static_fn != mir_id_invalid()) {
            target_fn = concrete_bodyless_static_fn;
        }
        if (self.bodyless_default_value_call(value_id, target_fn, call_name)) {
            return self.default_value_for_type(self.m.value_type(value_id));
        }
        if (target_fn != mir_id_invalid() && self.function_is_async_task_callable(target_fn)) {
            return self.lower_async_task_call(value_id, target_fn);
        }
        if (target_fn != mir_id_invalid()
            && self.function_uses_dci_virtual_dispatch(target_fn)
            && !self.dci_call_receiver_is_exact_value_object(value_id, target_fn)) {
            return self.lower_dci_virtual_call(value_id, target_fn);
        }
        var declaration_ok = false;
        if (target_fn != mir_id_invalid()) {
            declaration_ok = self.declare_function_signature(target_fn);
        }
        let fn_value = llvm_mir_map_get(self.function_values, target_fn);
        let fn_type = llvm_mir_map_get(self.function_types, target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_unresolved_direct_call(value_id, target_fn, declaration_ok);
            return null;
        }
        let source_argc = self.call_arg_count(value_id);
        let env_param_count = self.function_hidden_env_param_count(target_fn);
        let receiver_id = self.direct_call_receiver(value_id);
        var receiver_argc: i32 = 0;
        if (receiver_id != mir_id_invalid()) { receiver_argc = 1; }
        var implicit_self_argc: i32 = 0;
        var foreign_ctor_self_argc: i32 = 0;
        if (receiver_argc == 0 && target_fn != mir_id_invalid()
            && self.source_param_uses_self_pointer_abi(target_fn, 0)
            && self.function_is_native_constructor(target_fn)) {
            implicit_self_argc = 1;
        }
        if (receiver_argc == 0 && target_fn != mir_id_invalid()
            && self.function_is_foreign_dci_ctor(target_fn)) {
            foreign_ctor_self_argc = 1;
        }
        var packed_receiver = false;
        if (target_fn != mir_id_invalid()
            && self.dci_abi_passing(self.dci_source_parameter_abi(target_fn, 0)) == "inalloca"
            && self.dci_function_inalloca_count(target_fn) > 1) {
            packed_receiver = true;
        }
        var argc: i32 = 0;
        if (receiver_argc > 0 && !packed_receiver) { argc = receiver_argc; }
        if (target_fn != mir_id_invalid() && self.function_uses_hidden_sret(target_fn)) {
            argc = argc + 1;
        }
        var env_arg: rawptr = null;
        if (env_param_count > 0) {
            let callee_value_id = self.m.value_lhs(value_id);
            var closure_fat = null;
            if (callee_value_id != mir_id_invalid()) {
                closure_fat = self.lower_value(callee_value_id);
            }
            if (closure_fat == null) {
                closure_fat = self.build_closure_fat_value(target_fn);
            }
            env_arg = self.closure_fat_env_value(closure_fat);
            if (env_arg == null) {
                self.report_error("cannot resolve closure env for call to " + self.m.function_name(target_fn));
                return null;
            }
            argc = argc + env_param_count;
        }
        // Constructor calls need an implicit self-argument allocation.
        if (implicit_self_argc > 0) {
            argc = argc + 1;
        }
        if (foreign_ctor_self_argc > 0) {
            argc = argc + 1;
        }
        var split_i: i32 = 0;
        while (split_i < source_argc) {
            let split_param = split_i + receiver_argc + implicit_self_argc;
            argc = argc + self.dci_source_param_llvm_slots(target_fn, split_param);
            split_i = split_i + 1;
        }
        if (target_fn != mir_id_invalid() && self.dci_function_inalloca_count(target_fn) > 1) {
            argc = argc + 1;
        }
        var args: rawptr = null;
        if (argc > 0) {
            args = malloc((argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate direct call argument list for " + self.m.function_name(target_fn));
                return null;
            }
        }
        if (!self.dci_prepare_inalloca_call_frame(target_fn, args, argc)) {
            if (args != null) { free(args); }
            return null;
        }
        var out_idx: i32 = 0;
        var dci_sret_slot: rawptr = null;
        var member_sret_after = target_fn != mir_id_invalid()
            && receiver_argc > 0
            && env_param_count == 0
            && implicit_self_argc == 0
            && foreign_ctor_self_argc == 0
            && !packed_receiver
            && self.dci_member_sret_after_receiver(target_fn);
        if (target_fn != mir_id_invalid() && self.function_uses_hidden_sret(target_fn)) {
            let dci_return_type = self.m.function_return_type(target_fn);
            var dci_return_storage = self.lower_storage_type(dci_return_type);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                dci_return_storage = self.dci_translated_sret_ty(target_fn);
            }
            if (dci_return_storage == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower DCI sret storage for " + self.m.function_name(target_fn));
                return null;
            }
            if (self.type_is_class_pointer_abi(dci_return_type)) {
                dci_sret_slot = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(),
                                                                                   dci_return_type);
            } else {
                dci_sret_slot = vyx_rt_build_alloca(self.mod,
                                                    dci_return_storage,
                                                    "dci.sret".c_str(),
                                                    8);
                let dci_sret_alignment = self.dci_json_i64(self.dci_return_abi(target_fn),
                                                           "alignment");
                if (dci_sret_slot != null && dci_sret_alignment > 0) {
                    vyx_rt_set_alignment(self.mod,
                                         dci_sret_slot,
                                         dci_sret_alignment as i32);
                }
            }
            if (dci_sret_slot == null) {
                if (args != null) { free(args); }
                self.report_error("cannot allocate DCI sret storage for " + self.m.function_name(target_fn));
                return null;
            }
            if (member_sret_after) {
                ast_write_rawptr(ptr_offset(args, 1 * 8), dci_sret_slot);
            } else {
                ast_write_rawptr(ptr_offset(args, out_idx * 8), dci_sret_slot);
                out_idx = out_idx + 1;
            }
        }
        if (env_param_count > 0) {
            ast_write_rawptr(ptr_offset(args, out_idx * 8), env_arg);
            out_idx = out_idx + env_param_count;
        }
        if (receiver_argc > 0) {
            let receiver_type = self.function_source_param_type(target_fn, 0);
            if (receiver_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve receiver parameter type for " + self.m.function_name(target_fn));
                return null;
            }
            var receiver_val: rawptr = null;
            if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                && !self.m.static_exists(self.m.value_target_id(receiver_id))) {
                receiver_val = self.default_value_for_type(receiver_type);
            } else if (self.source_param_uses_self_pointer_abi(target_fn, 0)) {
                if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                    && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                    && self.m.static_exists(self.m.value_target_id(receiver_id))) {
                    receiver_val = self.lower_static_self_receiver_address(receiver_id, receiver_type);
                } else {
                    receiver_val = self.lower_self_receiver_address(receiver_id, receiver_type);
                }
            } else {
                receiver_val = self.lower_value_as(receiver_id, receiver_type);
            }
            if (receiver_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower receiver argument for " + self.m.function_name(target_fn));
                return null;
            }
            receiver_val = self.adjust_dci_direct_method_receiver(receiver_val,
                                                                  target_fn,
                                                                  "dci.method.this");
            if (receiver_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot adjust external DCI receiver for " + self.m.function_name(target_fn));
                return null;
            }
            if (packed_receiver) {
                var packed_ok = false;
                if (self.source_param_uses_self_pointer_abi(target_fn, 0)
                    || self.type_is_class_pointer_abi(receiver_type)) {
                    packed_ok = self.dci_store_packed_inalloca_pointer(target_fn,
                                                                       0,
                                                                       args,
                                                                       argc,
                                                                       receiver_val,
                                                                       receiver_type);
                } else {
                    packed_ok = self.dci_store_packed_inalloca_value(target_fn,
                                                                     0,
                                                                     args,
                                                                     argc,
                                                                     receiver_id,
                                                                     receiver_type);
                }
                if (!packed_ok) {
                    if (args != null) { free(args); }
                    return null;
                }
            } else {
                ast_write_rawptr(ptr_offset(args, out_idx * 8), receiver_val);
                out_idx = out_idx + 1;
                if (member_sret_after) { out_idx = out_idx + 1; }
            }
        }
        // For constructor calls without an explicit receiver: allocate the class
        // object and pass the pointer as the implicit self argument.
        var foreign_ctor_self_val: rawptr = null;
        var implicit_self_val: rawptr = null;
        if (foreign_ctor_self_argc > 0) {
            let foreign_ctor_receiver_type = self.foreign_dci_owner_type_id(target_fn);
            if (foreign_ctor_receiver_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot resolve external DCI constructor owner for `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
            foreign_ctor_self_val = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(),
                                                                                       foreign_ctor_receiver_type);
            if (foreign_ctor_self_val == null) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot allocate external DCI receiver for constructor `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
            ast_write_rawptr(ptr_offset(args, out_idx * 8), foreign_ctor_self_val);
            out_idx = out_idx + 1;
        }
        if (implicit_self_argc > 0) {
            let ctor_receiver_type = self.function_source_param_type(target_fn, 0);
            if (ctor_receiver_type != mir_id_invalid()) {
                if (self.type_is_dci_stub_class(ctor_receiver_type)) {
                    implicit_self_val = self.lower_dci_stub_factory_call(ctor_receiver_type);
                } else {
                    implicit_self_val = self.lower_constructor_self_storage(ctor_receiver_type);
                }
                if (implicit_self_val != null) {
                    ast_write_rawptr(ptr_offset(args, out_idx * 8), implicit_self_val);
                    out_idx = out_idx + 1;
                }
            }
            if (implicit_self_val == null) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot allocate receiver for constructor `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
        }
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_index = i + receiver_argc + implicit_self_argc;
            let param_type = self.call_arg_expected_type(target_fn, param_index, arg_id);
            if (param_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve argument parameter type #" + policy_i64_to_string(param_index as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            let next_idx = self.dci_append_call_argument(target_fn,
                                                         param_index,
                                                         arg_id,
                                                         param_type,
                                                         args,
                                                         out_idx,
                                                         argc);
            if (next_idx < 0) {
                if (args != null) { free(args); }
                self.report_error("cannot lower argument #" + policy_i64_to_string(i as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            out_idx = next_idx;
            i = i + 1;
        }
        var out_call_name = "mir.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.value_effective_type(value_id));
        if (ret_kind == ty_VOID() || foreign_ctor_self_argc > 0 || implicit_self_argc > 0
            || dci_sret_slot != null) { out_call_name = ""; }
        var out = self.build_abi_call(fn_type, fn_value, args, argc as u64, out_call_name, target_fn);
        if (out != null && !self.apply_dci_callsite_abi_attrs(target_fn, out)) { out = null; }
        if (out != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, out)) { out = null; }
        if (args != null) { free(args); }
        if (out != null && dci_sret_slot != null) {
            let dci_result_type = self.m.function_return_type(target_fn);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                out = self.dci_result_from_translated_sret(target_fn, dci_sret_slot);
            } else if (self.type_is_class_pointer_abi(dci_result_type)) {
                out = dci_sret_slot;
            } else {
                out = vyx_rt_build_load(self.mod,
                                        self.lower_type(dci_result_type),
                                        dci_sret_slot,
                                        "dci.sret.value".c_str(),
                                        14);
            }
        } else if (out != null
            && target_fn != mir_id_invalid()
            && self.dci_abi_passing(self.dci_return_abi(target_fn)) == "coerce") {
            out = self.dci_uncoerce_return_value(out,
                                                 target_fn,
                                                 self.m.function_return_type(target_fn));
        } else if (out != null
            && target_fn != mir_id_invalid()
            && self.function_return_uses_c_sysv_coerce(target_fn)) {
            out = self.c_sysv_uncoerce_value(out,
                                            self.m.function_return_type(target_fn),
                                            "c.abi.ret");
        }
        if (out != null && target_fn != mir_id_invalid()) {
            out = self.wrap_foreign_direct_pointer_return(out,
                                                          target_fn,
                                                          "foreign.return.ptr");
        }
        if (out == null) {
            if (source_argc != self.function_visible_param_count(target_fn)) {
                self.report_direct_call_arity_error(value_id, target_fn, source_argc);
            } else {
                self.report_error_at_value(value_id,
                    "cannot build direct call to `" + self.m.function_name(target_fn)
                    + "`: " + self.runtime_last_error());
                var dbg_i: i32 = 0;
                while (dbg_i < source_argc) {
                    let dbg_arg_id = self.call_arg_at(value_id, dbg_i);
                    let dbg_param_type = self.function_source_param_type(target_fn, dbg_i + receiver_argc + implicit_self_argc);
                    self.report_error("direct call argument "
                              + policy_i64_to_string(dbg_i as i64)
                              + " has type " + llvm_mir_type_text(&self.m, self.value_effective_type(dbg_arg_id))
                              + ", expected " + llvm_mir_type_text(&self.m, dbg_param_type));
                    dbg_i = dbg_i + 1;
                }
            }
        }
        if (foreign_ctor_self_argc > 0) {
            if (out == null && self.error_count > 0) { return null; }
            return foreign_ctor_self_val;
        }
        if (implicit_self_argc > 0) {
            if (out == null) {
                if (self.error_count > 0) { return null; }
                self.report_error("constructor `" + self.m.function_name(target_fn) + "` did not produce a return value");
                return null;
            }
            return out;
        }
        return out;
    }
}
