/// Lowerer contract: consume structured `MirUnit` plus DCI facts attached
/// on that unit, emit a backend artifact. Plugins:
///   * LLVM — `LlvmMirLowerer` / `mir_lowerer_run_llvm*` (acceptance + fixpoint)
///   * C++ source — `bootstrap.mir_cpp_lower` (`--emit=cpp` only; not a gate)
/// There is no second parallel LLVM pipeline and no flag that swaps the
/// acceptance backend.

extern "C" {
    fn getenv(name: rawptr) -> rawptr;
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn exit(status: i32);
    fn fflush(stream: rawptr) -> i32;
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: u64) -> i32;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strtod(s: rawptr, endptr: rawptr) -> f64;
    fn strstr(haystack: rawptr, needle: rawptr) -> rawptr;
    fn vyx_string_contains(hay: rawptr, hay_len: u64, needle: rawptr, needle_len: u64) -> i32;
    fn vyx_bootstrap_platform() -> i32;
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_rt_string_arena_checkpoint() -> rawptr;
    fn vyx_rt_string_arena_release(mark: rawptr);
    fn vyx_rt_string_arena_reserved_bytes() -> i64;
    fn vyx_rt_string_arena_active_bytes() -> i64;
    fn vyx_rt_ast_dup_bytes_total() -> i64;
    fn vyx_rt_ast_node_bytes_total() -> i64;
    fn vyx_rt_process_private_bytes() -> i64;
    fn vyx_rt_process_working_set_bytes() -> i64;
    fn vyx_rt_process_peak_private_bytes() -> i64;
    fn vyx_rt_process_peak_working_set_bytes() -> i64;
    fn vyx_rt_system_available_commit_bytes() -> i64;
    fn vyx_rt_heap_trim();
    fn vyx_tbb_cgu_pool_new(units: i32, workers: i32, emit: rawptr) -> rawptr;
    fn vyx_tbb_cgu_pool_submit(pool: rawptr, unit: i32, mod_h: rawptr,
                               path: rawptr, path_len: i64, opt: i32) -> i32;
    fn vyx_tbb_cgu_pool_finish(pool: rawptr);
    fn vyx_tbb_cgu_pool_unit_ok(pool: rawptr, unit: i32) -> i32;
    fn vyx_tbb_cgu_pool_free(pool: rawptr);
    fn cJSON_Parse(value: rawptr) -> rawptr;
    fn cJSON_Delete(item: rawptr);
    fn cJSON_GetObjectItemCaseSensitive(object: rawptr, string: rawptr) -> rawptr;
    fn cJSON_GetArraySize(array: rawptr) -> i32;
    fn cJSON_GetArrayItem(array: rawptr, index: i32) -> rawptr;
    fn cJSON_GetStringValue(item: rawptr) -> rawptr;
    fn cJSON_GetNumberValue(item: rawptr) -> f64;
    fn cJSON_IsTrue(item: rawptr) -> i32;
    fn cJSON_IsFalse(item: rawptr) -> i32;
    fn cJSON_IsString(item: rawptr) -> i32;
    fn cJSON_IsNumber(item: rawptr) -> i32;
    fn cJSON_IsArray(item: rawptr) -> i32;
    fn cJSON_IsObject(item: rawptr) -> i32;
    fn cJSON_Compare(a: rawptr, b: rawptr, case_sensitive: i32) -> i32;
    fn cJSON_CreateNull() -> rawptr;
    fn cJSON_CreateBool(boolean: i32) -> rawptr;
    fn cJSON_CreateNumber(number: f64) -> rawptr;
    fn cJSON_CreateString(text: rawptr) -> rawptr;
    fn cJSON_CreateArray() -> rawptr;
