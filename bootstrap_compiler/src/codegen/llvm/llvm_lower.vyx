        if (self.field_remap_cache != null) { llvm_mir_id_map_dispose(self.field_remap_cache); self.field_remap_cache = null; }
        if (self.dci_stub_factory_values != null) { llvm_mir_id_map_dispose(self.dci_stub_factory_values); self.dci_stub_factory_values = null; }
        if (self.dci_stub_destroy_values != null) { llvm_mir_id_map_dispose(self.dci_stub_destroy_values); self.dci_stub_destroy_values = null; }
        if (self.dci_layout_by_type_cache != null) { llvm_mir_id_map_dispose(self.dci_layout_by_type_cache); self.dci_layout_by_type_cache = null; }
        if (self.dci_record_name_cache != null) { llvm_mir_id_map_dispose(self.dci_record_name_cache); self.dci_record_name_cache = null; }
        // The slot array only holds borrowed cJSON object pointers; the objects
        // themselves belong to the derived-layout cache.
        if (self.dci_local_layout_slots != null) { free(self.dci_local_layout_slots); self.dci_local_layout_slots = null; }
        self.dci_local_layout_count = 0;
        if (self.dci_symbol_name_cache != null) { llvm_mir_id_map_dispose(self.dci_symbol_name_cache); self.dci_symbol_name_cache = null; }
        if (self.function_mangled_name_cache != null) { llvm_mir_id_map_dispose(self.function_mangled_name_cache); self.function_mangled_name_cache = null; }
    }

    public fn run(self) -> rawptr {
        if (self.mod == null) {
            self.report_error("cannot create LLVM module");
            self.release_aux_storage();
            return null;
        }
        let mir_pass_errors = mir_run_unit_pass_pipeline(&mut self.m,
                                                          self.mir_opt_level,
                                                          self.mir_verify_strict);
        if (mir_pass_errors > 0) {
            self.error_count = self.error_count + mir_pass_errors;
            return self.finish_module_handle();
        }
        self.profile_phase("start");
        self.declare_runtime_builtins();
        self.profile_phase("runtime-builtins");
        self.define_main_arg_runtime_helpers();
        self.profile_phase("runtime-helpers");
        self.declare_functions();
        self.profile_phase("functions-declared");
        self.emit_static_storage_roots();
        self.dci_synthesize_stub_wrappers();
        self.profile_phase("dci-stub-wrappers");
        self.declare_function_value_adapters();
        self.profile_phase("fn-value-adapters");
        self.declare_raw_callback_adapters();
        self.profile_phase("raw-callback-adapters");
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            let temp_string_mark = vyx_rt_string_arena_checkpoint();
            self.declare_blocks_for_function(fn_id);
            self.release_temp_strings(temp_string_mark);
            fn_id = fn_id + 1;
        }
        self.profile_phase("blocks-declared");
        fn_id = 1;
        while (fn_id <= self.m.function_count) {
            let temp_string_mark = vyx_rt_string_arena_checkpoint();
            if (vyx_bootstrap_profile_level() > 0 && fn_id >= 850) {
                self.profile_phase("before-lower-" + policy_i64_to_string(fn_id as i64)
                                   + "-" + self.m.function_name(fn_id));
            }
            self.prepare_function_value_range(fn_id);
            self.lower_function(fn_id);
            if (vyx_bootstrap_profile_level() > 0 && fn_id >= 850) {
                self.profile_phase("after-lower-" + policy_i64_to_string(fn_id as i64));
            }
            if (vyx_bootstrap_profile_level() > 0 && (fn_id % 100) == 0) {
                self.profile_phase("lowered-" + policy_i64_to_string(fn_id as i64));
            }
            self.release_temp_strings(temp_string_mark);
            fn_id = fn_id + 1;
        }
        self.profile_phase("functions-lowered");
        if (self.error_count > 0) {
            return self.finish_module_handle();
        }
        return self.finish_module_handle();
    }
}

public fn emit_mir_unit(m: MirUnit, mod_name: string) -> rawptr {
    return mir_lowerer_run_llvm(m, mod_name, 0);
}

/// LLVM plugin entry (whole-unit MIR already built). This is the
/// acceptance lowerer; MIR→C++ lives in mir_cpp_lower.vyx as a plugin.
public fn mir_llvm_plugin_is_acceptance_backend() -> bool {
    return true;
}

public fn mir_lowerer_run_llvm(m: MirUnit, mod_name: string, opt_level: i32) -> rawptr {
    return emit_mir_unit_with_opt_level(m, mod_name, opt_level);
}

public fn emit_mir_unit_with_opt_level(m: MirUnit,
                                       mod_name: string,
                                       opt_level: i32) -> rawptr {
    let lowerer = LlvmMirLowerer.create(m, mod_name, false);
    lowerer.mir_opt_level = opt_level;
    return lowerer.run();
}

public fn emit_mir_unit_with_linkage_mode(m: MirUnit,
                                          mod_name: string,
                                          export_root_linkage_mode: bool) -> rawptr {
    let lowerer = LlvmMirLowerer.create(m, mod_name, export_root_linkage_mode);
    return lowerer.run();
}

public fn emit_mir_unit_lazy_from_ast_with_method_roots(unit_ptr: rawptr,
                                                       mod_name: string,
                                                       export_all: bool,
                                                       export_method_roots: bool) -> rawptr {
    return emit_mir_unit_lazy_from_ast_with_export_roots(unit_ptr,
                                                        mod_name,
                                                        export_all,
                                                        export_method_roots,
                                                        "",
                                                        false,
                                                        "",
                                                        false,
                                                        "",
                                                        "",
                                                        false);
}

public fn emit_mir_unit_lazy_from_ast_with_export_roots(unit_ptr: rawptr,
                                                       mod_name: string,
                                                       export_all: bool,
                                                       export_method_roots: bool,
                                                       export_root_names: string,
                                                       export_root_names_specified: bool,
                                                       emit_root_names: string,
                                                       emit_root_names_specified: bool,
                                                       dci_abi_text: string,
                                                       dci_abi_path: string,
                                                       dci_abi_is_binary: bool) -> rawptr {
    var timing_total: i64 = 0;
    var timing_mark: i64 = 0;
    if (llvm_mir_timing_enabled()) {
        timing_total = vyx_bootstrap_now_ms();
        timing_mark = timing_total;
    }
    let hbuilder = hir_build_codegen_builder_handle_with_export_roots(unit_ptr,
                                                                      export_all,
                                                                      export_method_roots,
                                                                      export_root_names,
                                                                      export_root_names_specified);
    if (hbuilder == null) {
        diag_emit_codegen("code generation failed: failed to allocate HIR codegen builder");
        return null;
    }
    timing_mark = llvm_mir_timing_mark("lazy hir-build", timing_mark);
    var hunit = hir_codegen_builder_handle_unit(hbuilder);
    if (vyx_bootstrap_profile_level() > 0) {
        print("[llvm-mir-pipe] after-hir-build");
    }
    let resolve_left = hir_semantic_resolve_unit_silent(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    timing_mark = llvm_mir_timing_mark("lazy resolve", timing_mark);
    if (resolve_left > 0) {
        diag_emit_codegen("code generation failed: HIR semantic resolution left "
                          + policy_i64_to_string(resolve_left as i64)
                          + " unresolved target(s)");
        hir_codegen_builder_handle_release_codegen_state(hbuilder);
        hir_codegen_builder_handle_free(hbuilder);
        return null;
    }
    var lifecycle_errors: i32 = 0;
    if (dci_path_list_count(dci_abi_path.clone()) > 0) {
        lifecycle_errors = hir_bind_dci_lifecycle_paths(hunit, dci_abi_path.clone());
    } else if (dci_abi_text.len > 0) {
        lifecycle_errors = hir_bind_dci_lifecycle_contract(hunit, dci_abi_text.clone());
    }
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    if (lifecycle_errors > 0) {
        diag_emit_codegen("code generation failed: DCI lifecycle binding produced "
                          + policy_i64_to_string(lifecycle_errors as i64)
                          + " error(s)");
        hir_codegen_builder_handle_release_codegen_state(hbuilder);
        hir_codegen_builder_handle_free(hbuilder);
        return null;
    }
    let ownership_errors = hir_ownership_resolve_unit_silent(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    timing_mark = llvm_mir_timing_mark("lazy ownership", timing_mark);
    if (ownership_errors > 0) {
        diag_emit_codegen("code generation failed: HIR ownership resolution produced "
                          + policy_i64_to_string(ownership_errors as i64)
                          + " error(s)");
        hir_codegen_builder_handle_release_codegen_state(hbuilder);
        hir_codegen_builder_handle_free(hbuilder);
        return null;
    }
    let hir_errors = hir_verify_unit_silent(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    timing_mark = llvm_mir_timing_mark("lazy hir-verify", timing_mark);
    if (hir_errors > 0) {
        diag_emit_codegen("code generation failed: refusing invalid HIR unit before MIR build");
        hir_codegen_builder_handle_release_codegen_state(hbuilder);
        hir_codegen_builder_handle_free(hbuilder);
        return null;
    }
    let out = emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots(hbuilder,
                                                                            mod_name,
                                                                            export_all,
                                                                            emit_root_names,
                                                                            emit_root_names_specified,
                                                                            dci_abi_text.clone(),
                                                                            dci_abi_path.clone(),
                                                                            dci_abi_is_binary);
    timing_mark = llvm_mir_timing_mark("lazy stream-run", timing_mark);
    hir_codegen_builder_handle_release_codegen_state(hbuilder);
    hir_codegen_builder_handle_free(hbuilder);
    timing_mark = llvm_mir_timing_mark("lazy free-builder", timing_mark);
    if (vyx_bootstrap_profile_level() > 0) {
        print("[llvm-mir-pipe] after-llvm-emit");
    }
    llvm_mir_timing_mark("lazy total", timing_total);
    return out;
}

public fn emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots(hbuilder: rawptr,
                                                                       mod_name: string,
                                                                       export_all: bool,
                                                                       emit_root_names: string,
                                                                       emit_root_names_specified: bool,
                                                                       dci_abi_text: string,
                                                                       dci_abi_path: string,
                                                                       dci_abi_is_binary: bool) -> rawptr {
    return emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots_and_opt_level(
        hbuilder,
        mod_name,
        export_all,
        emit_root_names,
        emit_root_names_specified,
        dci_abi_text,
        dci_abi_path,
        dci_abi_is_binary,
        0,
        false);
}

public fn emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots_and_opt_level(
        hbuilder: rawptr,
        mod_name: string,
        export_all: bool,
        emit_root_names: string,
        emit_root_names_specified: bool,
        dci_abi_text: string,
        dci_abi_path: string,
        dci_abi_is_binary: bool,
        opt_level: i32,
        verify_strict: bool) -> rawptr {
    if (hbuilder == null) { return null; }
    var mbuilder = MirUnitBuilder.create_for_codegen(hbuilder);
    mbuilder.partition_codegen_roots = emit_root_names_specified;
    mbuilder.emit_root_names = emit_root_names;
    mbuilder.emit_root_names_specified = emit_root_names_specified;
    if (dci_abi_text.len > 0 || dci_abi_path.len > 0) {
        // Mutate the builder field in place. Passing `mbuilder.unit` into a
        // by-value `mir_unit_set_dci_abi_source` copies the large MirUnit
        // (sret/byval) and the DCI path write strands on the copy; streaming
        // then does `self.m = builder.unit` and lowering sees an empty ABI.
        mbuilder.unit.set_dci_abi_source(dci_abi_text.clone(),
                                         dci_abi_path.clone(),
                                         dci_abi_is_binary);
    }
    if (vyx_bootstrap_profile_level() > 0) {
        print("[llvm-mir] codegen-create-lowerer");
    }
    var lowerer = LlvmMirLowerer.create(mbuilder.unit, mod_name, export_all);
    if (vyx_bootstrap_profile_level() > 0) {
        print("[llvm-mir] codegen-run-streaming");
    }
    lowerer.partition_codegen_roots = emit_root_names_specified;
    lowerer.mir_opt_level = opt_level;
    lowerer.mir_verify_strict = verify_strict;
    return lowerer.run_streaming_from_builder(&mut mbuilder);
}

/// LLVM plugin entry (HIR builder → streaming MIR → LLVM). Acceptance path
/// for `--emit=ir|obj|exe|dll|lib`. Not used by `--emit=cpp`.
public fn mir_lowerer_run_llvm_streaming_from_hir(
        hbuilder: rawptr,
        mod_name: string,
        export_all: bool,
        emit_root_names: string,
        emit_root_names_specified: bool,
        dci_abi_text: string,
        dci_abi_path: string,
        dci_abi_is_binary: bool,
        opt_level: i32,
        verify_strict: bool) -> rawptr {
    return emit_mir_unit_from_hir_codegen_builder_handle_with_emit_roots_and_opt_level(
        hbuilder,
        mod_name,
        export_all,
        emit_root_names,
        emit_root_names_specified,
        dci_abi_text,
        dci_abi_path,
        dci_abi_is_binary,
        opt_level,
        verify_strict);
}

public fn emit_mir_unit_lazy_from_ast(unit_ptr: rawptr, mod_name: string, export_all: bool) -> rawptr {
    return emit_mir_unit_lazy_from_ast_with_method_roots(unit_ptr,
                                                        mod_name,
                                                        export_all,
                                                        export_all);
}

fn llvm_mir_module_last_error(mod_h: rawptr) -> string {
    if (mod_h == null) { return ""; }
    let err_buf = malloc(4096);
    if (err_buf == null) { return ""; }
    let nerr = vyx_rt_get_last_error(mod_h, err_buf, 4095);
    var detail = "";
    if (nerr > 0) {
        var copy_len = nerr;
        if (copy_len > 4095) { copy_len = 4095; }
        detail = from_cstr_len(err_buf, copy_len as i64);
    }
    free(err_buf);
    return detail;
}

fn llvm_mir_report_stage_error(stage: string, rc: i32, detail: string) {
    var message = "LLVM MIR " + stage + " failed with code "
        + policy_i64_to_string(rc as i64);
    if (detail.len > 0) { message = message + ": " + detail; }
    diag_emit_codegen(message);
}

public fn emit_to_file(cg_handle: rawptr, path: string) -> i32 {
    if (cg_handle == null) {
        llvm_mir_report_stage_error("IR emission", 1, "missing codegen handle");
        return 1;
    }
    var mod_h: rawptr = null;
    memcpy(to_rawptr(&mod_h), cg_handle, 8);
    if (mod_h == null) {
        llvm_mir_report_stage_error("IR emission", 1, "missing LLVM module");
        return 1;
    }

    let pr = vyx_rt_print_to_file(mod_h, path.c_str(), path.len as u64);
    let v = vyx_rt_verify(mod_h);
    if (v != 0) {
        llvm_mir_report_stage_error("module verification", v,
                                    llvm_mir_module_last_error(mod_h));
    }
    if (pr != 0) {
        llvm_mir_report_stage_error("IR file emission", pr,
                                    llvm_mir_module_last_error(mod_h));
        return pr;
    }
    if (v != 0) { return 2; }
    return 0;
}

public fn optimize_unit(cg_handle: rawptr, opt_level: i32) -> i32 {
    if (cg_handle == null) {
        llvm_mir_report_stage_error("optimization", 1, "missing codegen handle");
        return 1;
    }
    var mod_h: rawptr = null;
    memcpy(to_rawptr(&mod_h), cg_handle, 8);
    if (mod_h == null) {
        llvm_mir_report_stage_error("optimization", 1, "missing LLVM module");
        return 1;
    }
    var level = opt_level;
    if (level < 0) { level = 0; }
    if (level > 5) { level = 5; }
    let rc = vyx_rt_optimize(mod_h, level);
    if (rc != 0) {
        llvm_mir_report_stage_error("optimization", rc,
                                    llvm_mir_module_last_error(mod_h));
    }
    return rc;
}

public fn emit_object_to_file(cg_handle: rawptr, path: string, opt_level: i32) -> i32 {
    if (fileExists(path + ".cgu.list")) { return 0; }
    if (cg_handle == null) {
        llvm_mir_report_stage_error("object emission", 1, "missing codegen handle");
        return 1;
    }
    var mod_h: rawptr = null;
    memcpy(to_rawptr(&mod_h), cg_handle, 8);
    if (mod_h == null) {
        llvm_mir_report_stage_error("object emission", 1, "missing LLVM module");
        return 1;
    }
    let rc = llvm_mir_emit_module_file(mod_h, path.c_str(), path.len as u64, opt_level);
    if (rc != 0) {
        llvm_mir_report_stage_error("object emission", rc,
                                    llvm_mir_module_last_error(mod_h));
    }
    return rc;
}

public fn jit_run_main(cg_handle: rawptr, opt_level: i32, link_args: string) -> i32 {
    if (cg_handle == null) {
        llvm_mir_report_stage_error("JIT execution", -1, "missing codegen handle");
        return -1;
    }
    var mod_h: rawptr = null;
    memcpy(to_rawptr(&mod_h), cg_handle, 8);
    if (mod_h == null) {
        llvm_mir_report_stage_error("JIT execution", -1, "missing LLVM module");
        return -1;
    }
    let rc = vyx_rt_jit_run_main_with_args(mod_h,
                                           opt_level,
                                           link_args.c_str(),
                                           link_args.len as u64);
    if (rc < 0) {
        llvm_mir_report_stage_error("JIT execution", rc,
                                    llvm_mir_module_last_error(mod_h));
    }
    return rc;
}

public fn codegen_dispose(cg: rawptr) -> i32 {
    if (cg == null) { return 0; }
    var mod_h: rawptr = null;
    memcpy(to_rawptr(&mod_h), cg, 8);
    if (mod_h != null) { vyx_rt_module_free(mod_h); }
    free(cg);
    return 0;
}
