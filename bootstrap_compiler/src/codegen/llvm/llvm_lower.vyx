    public error_count: i32
    public str_lit_buf: rawptr
    public string_lit_count: i32
    public declared_function_scan_next: i32
    public function_symbol_index: rawptr
    public function_symbol_index_cap: i32
    public method_candidate_index: rawptr
    public method_candidate_index_cap: i32
    public method_candidate_index_ready: bool
    // Method-name index over the codegen partition.  `method_candidate_index`
    // cannot serve the `dyn` path in a split build (a sibling unit's function
    // has no body *here*), but it must stay byte-for-byte identical for
    // ordinary method resolution, so the partition gets its own index,
    // populated once from inside `cgu_record_function`.
    public dyn_partition_index: rawptr
    public dyn_partition_index_cap: i32
    // Number of partition slots already folded into `dyn_partition_index`.  The
    // index grows lazily, so a lookup only ever indexes slots it has not seen;
    // that also keeps it correct when the partition gains slots after the first
    // `dyn` query.
    public dyn_partition_index_n: i32
    // Per-slot signature snapshots for the partition.  A body is released right
    // after `cgu_record_function` accepts it, and the released local chain may
    // still be walked but must not be trusted (it can even be cyclic -- see the
    // `local_guard` in `discard_recent_body_records`), so the arity and the
    // parameter type ids are captured while the body is still live, into a flat
    // i32 buffer addressed by `dyn_sig_off[slot]` (-1 = none).
    public dyn_sig_off: rawptr
    public dyn_sig_buf: rawptr
    public dyn_sig_n: i32
    public dyn_sig_cap: i32
    // A snapshot needs a LIVE body: it walks the function's `local_next` chain.
    // `cgu_collect_from_shells` tops the partition up after the collect-only
    // walk has released every body, and a released chain is not merely stale --
    // `discard_recent_body_records` may leave it cyclic, so walking it hangs or
    // faults.  The sweep therefore records the function but leaves its slot at
    // -1 ("no signature"), which is also the honest answer: a function with no
    // body present cannot be a `dyn` vtable candidate.
    public cgu_shell_sweep: bool
    public cgu_collect_only: bool
    public cgu_emit_index: i32
    public cgu_unit_count: i32
    public cgu_member_map: rawptr
    public cgu_static_defined_map: rawptr
    public cgu_collected_ids: rawptr
    public cgu_collected_sizes: rawptr
    public cgu_collected_keys: rawptr
    public cgu_collected_n: i32
    public cgu_collected_cap: i32
    // Frozen marks of every body the collect walk left in the arena, indexed
    // by collected slot, plus a function-id -> slot map so the emit walk can
    // find them without rescanning.
    public cgu_retain_marks: rawptr
    public cgu_retain_slot: rawptr
    public cgu_retain_bodies: bool
    // Number of successful `cgu_retain_record` calls.  A body is materialised
    // as a *stack* -- a nested function's region sits above the region of the
    // body whose build pulled it in -- so releasing an enclosing body rewinds
    // the arena straight through every retained region below the top.  The
    // collect walk therefore asks, for each body it is about to release,
    // whether this counter moved while that body was being built: if it did, a
    // retained body lives inside, and the enclosing body has to be retained
    // too.  See `cgu_must_retain_enclosing_body`.
    public cgu_retain_count: i32
    public cgu_key_table: string
    public cgu_emitted_objects: bool
    public cgu_object_list: string

    public static fn create(m: MirUnit,
                            mod_name: string,
                            export_root_linkage_mode: bool) -> LlvmMirLowerer {
        vyx_rt_init();
        let triple = policy_cli_target_triple();
        let mod_h = vyx_rt_module_new(mod_name.c_str(),
                                      mod_name.len as u64,
                                      triple.c_str(),
                                      triple.len as u64);
        if (mod_h != null && llvm_mir_pic_from_argv()) {
            vyx_rt_set_relocation_model(mod_h, 2);
        }
        var initial_target_errors: i32 = 0;
        if (mod_h != null && triple.len > 0) {
            let err_buf = malloc(4096);
            let err_len = vyx_rt_get_last_error(mod_h, err_buf, 4095);
            if (err_len > 0) {
                var copy_len = err_len;
                if (copy_len > 4095) { copy_len = 4095; }
                var detail = "LLVM target lookup failed";
                if (err_buf != null) { detail = from_cstr_len(err_buf, copy_len as i64); }
                diag_emit_codegen("unsupported LLVM target triple `" + triple + "`: " + detail);
                initial_target_errors = 1;
            }
            if (err_buf != null) { free(err_buf); }
        }
        if (mod_h != null) { vyx_rt_builder_new(mod_h); }
        let debug_enabled = llvm_mir_cli_debug_enabled();
        let debug_source_path = llvm_mir_cli_source_path(mod_name);
        if (mod_h != null && debug_enabled) {
            vyx_rt_enable_debug(mod_h,
                                debug_source_path.c_str(),
                                debug_source_path.len as u64);
        }
        var type_struct_map_cap: i32 = m.types.count;
        type_struct_map_cap = type_struct_map_cap + 1;
        let str_slots = malloc((8192 * 32) as u64);
        if (str_slots != null) { memset(str_slots, 0, (8192 * 32) as u64); }
        let symbol_index_cap: i32 = 65536;
        let method_index_cap: i32 = 65536;
        let pointer_index_bits = vyx_rt_pointer_index_bits(mod_h);
        var pointer_index_ty: rawptr = null;
        if (pointer_index_bits > 0) {
            pointer_index_ty = vyx_rt_int_type(mod_h, pointer_index_bits);
        }
        let max_static = llvm_mir_max_static_item_target(m);
        return LlvmMirLowerer {
            m: m,
            module_symbol_name: mod_name,
            target_triple: triple,
            export_root_linkage_mode: export_root_linkage_mode,
            partition_codegen_roots: false,
            mir_opt_level: 0,
            mir_verify_strict: false,
            debug_enabled: debug_enabled,
            debug_source_path: debug_source_path,
            mod: mod_h,
            ty_i1: vyx_rt_int_type(mod_h, 1),
            ty_i8: vyx_rt_int_type(mod_h, 8),
            ty_i16: vyx_rt_int_type(mod_h, 16),
            ty_i32: vyx_rt_int_type(mod_h, 32),
            ty_i64: vyx_rt_int_type(mod_h, 64),
            pointer_index_bits: pointer_index_bits,
            ty_pointer_index: pointer_index_ty,
            ty_ptr: vyx_rt_ptr_ty(mod_h),
            ty_void: vyx_rt_void_ty(mod_h),
            string_ty: null,
            closure_fat_ty: null,
            pointer_handle_ty: null,
            function_values: llvm_mir_alloc_ptr_map(m.function_count + 1),
            function_types: llvm_mir_alloc_ptr_map(m.function_count + 1),
            function_definition_emitted_map: llvm_mir_alloc_i32_map(m.function_count + 1),
            function_closure_adapter_values: llvm_mir_alloc_ptr_map(m.function_count + 1),
            function_raw_callback_adapter_values: llvm_mir_alloc_ptr_map(m.function_count + 1),
            reflected_method_adapter_head: null,
            dyn_method_adapter_head: null,
            dyn_vtable_head: null,
            dyn_trait_impl_cache_head: null,
            function_env_types: llvm_mir_alloc_ptr_map(m.function_count + 1),
            async_context_types: llvm_mir_alloc_ptr_map(m.function_count + 1),
            async_worker_values: llvm_mir_alloc_ptr_map(m.function_count + 1),
            async_worker_types: llvm_mir_alloc_ptr_map(m.function_count + 1),
            async_ctx_temp_specs: llvm_mir_alloc_ptr_map(m.function_count + 1),
            current_body_local_first: 0,
            type_struct_values: llvm_mir_alloc_ptr_map(type_struct_map_cap),
            type_struct_body_field_counts: llvm_mir_alloc_i32_map(type_struct_map_cap),
            dyn_vtable_type_values: llvm_mir_alloc_ptr_map(type_struct_map_cap),
            dyn_trait_method_counts: llvm_mir_alloc_i32_map(type_struct_map_cap),
            dyn_trait_method_lists: llvm_mir_alloc_ptr_map(type_struct_map_cap),
            hir_item_globals: llvm_mir_alloc_ptr_map(max_static + 1),
            block_values: llvm_mir_alloc_ptr_map(m.block_count + 1),
            local_slots: llvm_mir_alloc_ptr_map(m.local_count + 1),
            local_debug_pending: llvm_mir_alloc_i32_map(m.local_count + 1),
            local_lifetime_marker_candidates: llvm_mir_alloc_i32_map(m.local_count + 1),
            local_lifetime_marker_live_orders: llvm_mir_alloc_i32_map(m.local_count + 1),
            local_lifetime_marker_dead_orders: llvm_mir_alloc_i32_map(m.local_count + 1),
            local_lifetime_marker_value_visit_budget: 0,
            local_lifetime_marker_value_query_failed: false,
            local_slot_reuse_candidates: llvm_mir_alloc_i32_map(m.local_count + 1),
            local_slot_reuse_sources: llvm_mir_alloc_i32_map(m.local_count + 1),
            foreach_iterator_slots: llvm_mir_alloc_ptr_map(m.value_count + 1),
            value_cache: llvm_mir_alloc_ptr_map(m.value_count + 1),
            instr_deref_addr_cache: llvm_mir_alloc_ptr_map(m.place_count + 2),
            hoisted_borrow_handles: llvm_mir_alloc_ptr_map(m.value_count + 1),
            pending_value_first: 0,
            pending_value_last: 0,
            function_value_ranges: null,
            direct_call_callee_value_map: llvm_mir_alloc_i32_map(m.value_count + 1),
            function_value_adapter_need_map: llvm_mir_alloc_i32_map(m.function_count + 1),
