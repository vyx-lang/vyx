    public fn release_aux_storage(self) {
        if (self.str_lit_buf != null) {
            var n = self.string_lit_count;
            if (n > 8192) { n = 8192; }
            var i: i32 = 0;
            while (i < n) {
                policy_entry_clear(llvm_mir_entry_at(self.str_lit_buf, i));
                i = i + 1;
            }
            free(self.str_lit_buf);
            self.str_lit_buf = null;
            self.string_lit_count = 0;
        }

        llvm_mir_dispose_symbol_index(self.function_symbol_index,
                                      self.function_symbol_index_cap,
                                      false);
        self.function_symbol_index = null;
        self.function_symbol_index_cap = 0;
        llvm_mir_dispose_symbol_index(self.method_candidate_index,
                                      self.method_candidate_index_cap,
                                      true);
        self.method_candidate_index = null;
        self.method_candidate_index_cap = 0;
        llvm_mir_dispose_symbol_index(self.dyn_partition_index,
                                      self.dyn_partition_index_cap,
                                      true);
        self.dyn_partition_index = null;
        self.dyn_partition_index_cap = 0;
        self.dyn_partition_index_n = 0;
        if (self.dyn_sig_off != null) { free(self.dyn_sig_off); self.dyn_sig_off = null; }
        if (self.dyn_sig_buf != null) { free(self.dyn_sig_buf); self.dyn_sig_buf = null; }
        self.dyn_sig_n = 0;
        self.dyn_sig_cap = 0;
        if (self.cgu_member_map != null) { llvm_mir_id_map_dispose(self.cgu_member_map); self.cgu_member_map = null; }
        if (self.cgu_static_defined_map != null) { llvm_mir_id_map_dispose(self.cgu_static_defined_map); self.cgu_static_defined_map = null; }
        if (self.cgu_collected_ids != null) { free(self.cgu_collected_ids); self.cgu_collected_ids = null; }
        if (self.cgu_collected_sizes != null) { free(self.cgu_collected_sizes); self.cgu_collected_sizes = null; }
        if (self.cgu_collected_keys != null) { free(self.cgu_collected_keys); self.cgu_collected_keys = null; }
        if (self.cgu_retain_marks != null) { free(self.cgu_retain_marks); self.cgu_retain_marks = null; }
        if (self.cgu_retain_slot != null) { llvm_mir_id_map_dispose(self.cgu_retain_slot); self.cgu_retain_slot = null; }
        self.cgu_retain_bodies = false;
        self.cgu_retain_count = 0;
        self.cgu_collected_n = 0;
        self.cgu_collected_cap = 0;

        llvm_mir_free_map_owned_values(self.dyn_trait_method_lists, self.m.types.count);
        llvm_mir_free_map_value_chains(self.type_compat_cache, self.m.types.count, 8);
        llvm_mir_free_map_value_chains(self.field_owner_accept_cache, self.m.types.count, 8);
        llvm_mir_free_map_value_chains(self.foreign_dci_field_record_cache, self.m.types.count, 8);
        llvm_mir_free_map_value_chains(self.field_remap_cache, self.m.field_count, 8);
        llvm_mir_free_map_owned_values(self.dci_record_name_cache, self.m.types.count);
        llvm_mir_free_map_owned_values(self.dci_symbol_name_cache, self.m.function_count);
        llvm_mir_free_map_owned_values(self.function_mangled_name_cache, self.m.function_count);
        self.dci_dispose_indexes();
        if (self.dci_symbol_object_cache != null) { llvm_mir_id_map_dispose(self.dci_symbol_object_cache); self.dci_symbol_object_cache = null; }
        if (self.dci_lookup_miss != null) { free(self.dci_lookup_miss); self.dci_lookup_miss = null; }

        llvm_mir_free_raw_chain(self.dyn_method_adapter_head, 16);
        self.dyn_method_adapter_head = null;
        llvm_mir_free_raw_chain(self.reflected_method_adapter_head, 24);
        self.reflected_method_adapter_head = null;
        llvm_mir_free_raw_chain(self.dyn_vtable_head, 16);
        self.dyn_vtable_head = null;
        llvm_mir_free_raw_chain(self.dyn_trait_impl_cache_head, 16);
        self.dyn_trait_impl_cache_head = null;
        var runtime_op = self.dci_runtime_operation_cache_head;
        while (runtime_op != null) {
            let next_runtime_op = ast_read_rawptr(ptr_offset(runtime_op, 32));
            let runtime_name = ast_read_rawptr(runtime_op);
            if (runtime_name != null) { free(runtime_name); }
            free(runtime_op);
            runtime_op = next_runtime_op;
        }
        self.dci_runtime_operation_cache_head = null;
        if (self.dci_json_bundle != null) {
            cJSON_Delete(self.dci_json_bundle);
            self.dci_json_bundle = null;
            self.dci_json_root = null;
        } else if (self.dci_json_root != null) {
            cJSON_Delete(self.dci_json_root);
            self.dci_json_root = null;
        }
        str_drop(self.dci_json_text_cache);
        self.dci_json_text_cache = "";

        if (self.function_values != null) { llvm_mir_id_map_dispose(self.function_values); self.function_values = null; }
        if (self.function_types != null) { llvm_mir_id_map_dispose(self.function_types); self.function_types = null; }
        if (self.function_definition_emitted_map != null) { llvm_mir_id_map_dispose(self.function_definition_emitted_map); self.function_definition_emitted_map = null; }
        if (self.function_closure_adapter_values != null) { llvm_mir_id_map_dispose(self.function_closure_adapter_values); self.function_closure_adapter_values = null; }
        if (self.function_raw_callback_adapter_values != null) { llvm_mir_id_map_dispose(self.function_raw_callback_adapter_values); self.function_raw_callback_adapter_values = null; }
        if (self.function_env_types != null) { llvm_mir_id_map_dispose(self.function_env_types); self.function_env_types = null; }
        if (self.async_context_types != null) { llvm_mir_id_map_dispose(self.async_context_types); self.async_context_types = null; }
        if (self.async_worker_values != null) { llvm_mir_id_map_dispose(self.async_worker_values); self.async_worker_values = null; }
        if (self.async_worker_types != null) { llvm_mir_id_map_dispose(self.async_worker_types); self.async_worker_types = null; }
        if (self.async_ctx_temp_specs != null) { llvm_mir_id_map_dispose(self.async_ctx_temp_specs); self.async_ctx_temp_specs = null; }
        if (self.type_struct_values != null) { llvm_mir_id_map_dispose(self.type_struct_values); self.type_struct_values = null; }
        if (self.type_struct_body_field_counts != null) { llvm_mir_id_map_dispose(self.type_struct_body_field_counts); self.type_struct_body_field_counts = null; }
        if (self.dyn_vtable_type_values != null) { llvm_mir_id_map_dispose(self.dyn_vtable_type_values); self.dyn_vtable_type_values = null; }
        if (self.dyn_trait_method_counts != null) { llvm_mir_id_map_dispose(self.dyn_trait_method_counts); self.dyn_trait_method_counts = null; }
        if (self.dyn_trait_method_lists != null) { llvm_mir_id_map_dispose(self.dyn_trait_method_lists); self.dyn_trait_method_lists = null; }
        if (self.hir_item_globals != null) { llvm_mir_id_map_dispose(self.hir_item_globals); self.hir_item_globals = null; }
        if (self.block_values != null) { llvm_mir_id_map_dispose(self.block_values); self.block_values = null; }
        if (self.local_slots != null) { llvm_mir_id_map_dispose(self.local_slots); self.local_slots = null; }
        if (self.local_debug_pending != null) { llvm_mir_id_map_dispose(self.local_debug_pending); self.local_debug_pending = null; }
        if (self.local_lifetime_marker_candidates != null) { llvm_mir_id_map_dispose(self.local_lifetime_marker_candidates); self.local_lifetime_marker_candidates = null; }
        if (self.local_lifetime_marker_live_orders != null) { llvm_mir_id_map_dispose(self.local_lifetime_marker_live_orders); self.local_lifetime_marker_live_orders = null; }
        if (self.local_lifetime_marker_dead_orders != null) { llvm_mir_id_map_dispose(self.local_lifetime_marker_dead_orders); self.local_lifetime_marker_dead_orders = null; }
        if (self.local_slot_reuse_candidates != null) { llvm_mir_id_map_dispose(self.local_slot_reuse_candidates); self.local_slot_reuse_candidates = null; }
        if (self.local_slot_reuse_sources != null) { llvm_mir_id_map_dispose(self.local_slot_reuse_sources); self.local_slot_reuse_sources = null; }
        if (self.foreach_iterator_slots != null) { llvm_mir_id_map_dispose(self.foreach_iterator_slots); self.foreach_iterator_slots = null; }
        if (self.value_cache != null) { llvm_mir_id_map_dispose(self.value_cache); self.value_cache = null; }
        if (self.instr_deref_addr_cache != null) { llvm_mir_id_map_dispose(self.instr_deref_addr_cache); self.instr_deref_addr_cache = null; }
        if (self.hoisted_borrow_handles != null) { llvm_mir_id_map_dispose(self.hoisted_borrow_handles); self.hoisted_borrow_handles = null; }
        if (self.function_value_ranges != null) { free(self.function_value_ranges); self.function_value_ranges = null; }
        if (self.direct_call_callee_value_map != null) { llvm_mir_id_map_dispose(self.direct_call_callee_value_map); self.direct_call_callee_value_map = null; }
        if (self.function_value_adapter_need_map != null) { llvm_mir_id_map_dispose(self.function_value_adapter_need_map); self.function_value_adapter_need_map = null; }
        if (self.raw_callback_adapter_use_map != null) { llvm_mir_id_map_dispose(self.raw_callback_adapter_use_map); self.raw_callback_adapter_use_map = null; }
        if (self.function_open_template_cache != null) { llvm_mir_id_map_dispose(self.function_open_template_cache); self.function_open_template_cache = null; }
        if (self.function_self_call_cache != null) { llvm_mir_id_map_dispose(self.function_self_call_cache); self.function_self_call_cache = null; }
        if (self.canonical_type_cache != null) { llvm_mir_id_map_dispose(self.canonical_type_cache); self.canonical_type_cache = null; }
