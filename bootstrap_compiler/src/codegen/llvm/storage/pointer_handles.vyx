module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn get_or_create_pointer_handle_ty(self) -> rawptr {
        if (self.pointer_handle_ty != null) { return self.pointer_handle_ty; }
        let name = "__VyxPointerHandle";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create LLVM pointer handle type");
            return null;
        }
        self.pointer_handle_ty = st;
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate LLVM pointer handle field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize LLVM pointer handle type");
            return null;
        }
        free(fields);
        return st;
    }

    public fn pointer_handle_null(self) -> rawptr {
        let ty = self.get_or_create_pointer_handle_ty();
        if (ty == null) { return null; }
        return vyx_rt_const_null(self.mod, ty);
    }

    public fn build_pointer_handle(self,
                                   address: rawptr,
                                   metadata: rawptr,
                                   name: string) -> rawptr {
        if (address == null || metadata == null) { return self.pointer_handle_null(); }
        var out = self.pointer_handle_null();
        if (out == null) { return null; }
        let address_name = name + ".address";
        out = vyx_rt_build_insert_value(self.mod,
                                        out,
                                        address,
                                        0,
                                        address_name.c_str(),
                                        address_name.len as u64);
        if (out == null) {
            self.report_error("cannot insert pointer handle address");
            return null;
        }
        let metadata_name = name + ".metadata";
        out = vyx_rt_build_insert_value(self.mod,
                                        out,
                                        metadata,
                                        1,
                                        metadata_name.c_str(),
                                        metadata_name.len as u64);
        if (out == null) {
            self.report_error("cannot insert pointer handle metadata");
        }
        return out;
    }

    public fn pointer_handle_address(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null) { return null; }
        if (vyx_rt_value_is_struct(handle) == 0) { return handle; }
        let part_name = name + ".address";
        return vyx_rt_build_extract_value(self.mod,
                                          handle,
                                          0,
                                          part_name.c_str(),
                                          part_name.len as u64);
    }

    public fn pointer_handle_metadata(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null) { return null; }
        if (vyx_rt_value_is_struct(handle) == 0) {
            return vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        }
        let part_name = name + ".metadata";
        return vyx_rt_build_extract_value(self.mod,
                                          handle,
                                          1,
                                          part_name.c_str(),
                                          part_name.len as u64);
    }

    public fn pointer_compare_scalar(self,
                                     value: rawptr,
                                     type_id: i32,
                                     name: string) -> rawptr {
        if (value == null) { return null; }
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            return self.pointer_handle_address(value, name);
        }
        return value;
    }

    public fn call_pointer_region_create(self,
                                         address: rawptr,
                                         bytes: i64,
                                         owned: i32,
                                         capability: i32) -> rawptr {
        if (address == null || bytes <= 0
            || self.pointer_region_create_fn == null
            || self.pointer_region_create_fty == null) {
            self.report_error("pointer region runtime is not available");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate pointer region call arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i64, bytes, 0));
        ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, owned as i64, 0));
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_region_create_fty,
                                    self.pointer_region_create_fn,
                                    args,
                                    4,
                                    "mir.ptr.region".c_str(),
                                    14);
        free(args);
        return out;
    }

    /// malloc whose size is an LLVM value (runtime-length array allocation).
    public fn malloc_bytes_runtime(self, size_v: rawptr, name: string) -> rawptr {
        if (size_v == null) { return null; }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc is not declared before " + name);
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_malloc_fty,
                                  self.builtin_malloc_fn,
                                  size_v,
                                  name.c_str(),
                                  name.len as u64);
    }

    /// pointer_region_create whose byte count is an LLVM value.
    public fn call_pointer_region_create_value(self,
                                               address: rawptr,
                                               bytes_v: rawptr,
                                               owned: i32,
                                               capability: i32) -> rawptr {
        if (address == null || bytes_v == null
            || self.pointer_region_create_fn == null
            || self.pointer_region_create_fty == null) {
            self.report_error("pointer region runtime is not available");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate pointer region call arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), bytes_v);
        ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, owned as i64, 0));
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_region_create_fty,
                                    self.pointer_region_create_fn,
                                    args,
                                    4,
                                    "mir.ptr.region".c_str(),
                                    14);
        free(args);
        return out;
    }

    /// Handle over a runtime-length array allocation: element-typed region
    /// with a dynamic byte count (no static dimension shape).
    public fn runtime_array_handle_from_raw(self,
                                             address: rawptr,
                                             elem_type: i32,
                                             bytes_v: rawptr,
                                             name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        let metadata = self.call_pointer_region_create_value(address, bytes_v, 1, 0);
        if (metadata == null) { return null; }
        if (!self.configure_pointer_region_array_shape(metadata, elem_type)) { return null; }
        return self.build_pointer_handle(address, metadata, name);
    }

    public fn pointer_handle_from_raw(self,
                                      address: rawptr,
                                      payload_type: i32,
                                      owned: i32,
                                      capability: i32,
                                      name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        var bytes: i64 = 1;
        if (payload_type != mir_id_invalid()) {
            let storage_ty = self.lower_storage_type(payload_type);
            if (storage_ty != null) {
                let measured = vyx_rt_type_alloc_size(self.mod, storage_ty);
                if (measured > 0) { bytes = measured; }
            }
        }
        let metadata = self.call_pointer_region_create(address, bytes, owned, capability);
        if (metadata == null) { return null; }
        if (!self.configure_pointer_region_array_shape(metadata, payload_type)) { return null; }
        return self.build_pointer_handle(address, metadata, name);
    }

    // Native DCI object pointers carry an address, without a Vyx allocation
    // region. Do not fabricate bounds or ownership for producer storage.
    // Native calls extract that address; consumer dereferences requiring a
    // region must use unsafe and establish the object's lifetime themselves.
    public fn pointer_handle_from_foreign_raw(self, address: rawptr, name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        return self.build_pointer_handle(
            address,
            vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
            name);
    }

    public fn pointer_array_rank(self, type_id: i32) -> i32 {
        var current = type_id;
        var rank: i32 = 0;
        while (current != mir_id_invalid()
            && llvm_mir_type_kind(&self.m, current) == ty_ARRAY()
            && rank < 64) {
            rank = rank + 1;
            current = hir_type_table_elem(self.m.types, current);
        }
        return rank;
    }

    public fn configure_pointer_region_array_shape(self,
                                                    metadata: rawptr,
                                                    payload_type: i32) -> bool {
        let rank = self.pointer_array_rank(payload_type);
        if (rank <= 0) { return true; }
        if (metadata == null || self.pointer_region_set_dimension_fn == null
            || self.pointer_region_set_dimension_fty == null) {
            self.report_error("pointer array-shape runtime is not available");
            return false;
        }
        var current = payload_type;
        var level: i32 = 0;
        while (level < rank) {
            let extent = self.array_length_for_type(current);
            let elem = hir_type_table_elem(self.m.types, current);
            let stride = self.value_storage_size(elem);
            if (extent <= 0 || elem == mir_id_invalid() || stride <= 0) {
                self.report_error("cannot configure pointer array shape for "
                          + llvm_mir_type_text(&self.m, payload_type));
                return false;
            }
            let args = malloc(40);
            if (args == null) {
                self.report_error("cannot allocate pointer array-shape arguments");
                return false;
            }
            ast_write_rawptr(args, metadata);
            ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i32, rank as i64, 0));
            ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, level as i64, 0));
            ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i64, extent, 0));
            ast_write_rawptr(ptr_offset(args, 32), vyx_rt_const_int(self.mod, self.ty_i64, stride, 0));
            let configured = vyx_rt_build_call(self.mod,
                                                self.pointer_region_set_dimension_fty,
                                                self.pointer_region_set_dimension_fn,
                                                args,
                                                5,
                                                llvm_mir_empty_name(),
                                                0);
            free(args);
            if (configured == null) {
                self.report_error("cannot configure pointer array dimension #" + level.toString());
                return false;
            }
            current = elem;
            level = level + 1;
        }
        return true;
    }

    public fn pointer_handle_retag(self,
                                   handle: rawptr,
                                   capability: i32,
                                   name: string) -> rawptr {
        if (handle == null || self.pointer_region_retag_fn == null
            || self.pointer_region_retag_fty == null) {
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        let tagged = vyx_rt_build_call2(self.mod,
                                        self.pointer_region_retag_fty,
                                        self.pointer_region_retag_fn,
                                        metadata,
                                        vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0),
                                        "mir.ptr.retag".c_str(),
                                        13);
        if (address == null || metadata == null || tagged == null) { return null; }
        return self.build_pointer_handle(address, tagged, name + ".retag");
    }

    public fn pointer_checked_address(self,
                                      handle: rawptr,
                                      index: rawptr,
                                      element_size: i64,
                                      pointer_depth: i32,
                                      name: string) -> rawptr {
        if (handle == null || index == null || element_size <= 0
            || self.pointer_checked_address_typed_fn == null
            || self.pointer_checked_address_typed_fty == null) {
            self.report_error("pointer checked-address runtime is not available");
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        if (address == null || metadata == null) { return null; }
        if (!llvm_mir_inline_pointer_checks_disabled()) {
            return self.emit_inline_pointer_checked_address(address,
                                                            metadata,
                                                            index,
                                                            element_size,
                                                            pointer_depth,
                                                            name);
        }
        let args = malloc(40);
        if (args == null) {
            self.report_error("cannot allocate pointer check arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), metadata);
        ast_write_rawptr(ptr_offset(args, 16), index);
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i64, element_size, 0));
        ast_write_rawptr(ptr_offset(args, 32), vyx_rt_const_int(self.mod, self.ty_i32, pointer_depth as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_checked_address_typed_fty,
                                    self.pointer_checked_address_typed_fn,
                                    args,
                                    5,
                                    name.c_str(),
                                    name.len as u64);
        free(args);
        return out;
    }

    /// Lazily-created anonymous alias-scope domain shared by every
    /// typed-pointer audit access in this module.  Declaring audit
    /// bookkeeping (region metadata, handle slots) and user payload memory
    /// as disjoint alias domains lets LICM hoist the whole inline check out
    /// of loops: without it, the payload store inside the loop clobbers the
    /// audit loads through opaque inttoptr/ptrtoint round-trips and forces a
    /// full re-audit per iteration.
    public fn pointer_alias_domain(self) -> rawptr {
        if (self.ptr_alias_domain == null) {
            self.ptr_alias_domain = vyx_rt_alias_scope_domain(self.mod);
        }
        return self.ptr_alias_domain;
    }

    /// Load through `slot` with the pointer-audit alias scope attached.
    /// kind selects the loaded type's build call; scope_kind 0 marks the
    /// access as audit bookkeeping (noalias w.r.t. payload memory).
    fn audited_load_i64(self, slot: rawptr, name: string) -> rawptr {
        let v = vyx_rt_build_load(self.mod, self.ty_i64, slot,
                                  name.c_str(), name.len as u64);
        if (v != null && self.ptr_alias_domain != null) {
            vyx_rt_set_alias_scopes(self.mod, v, self.ptr_alias_domain, 0);
        }
        return v;
    }

    fn audited_load_ptr(self, slot: rawptr, name: string) -> rawptr {
        let v = vyx_rt_build_load(self.mod, self.ty_ptr, slot,
                                  name.c_str(), name.len as u64);
        if (v != null && self.ptr_alias_domain != null) {
            vyx_rt_set_alias_scopes(self.mod, v, self.ptr_alias_domain, 0);
        }
        return v;
    }

    /// Payload load/store: belongs to the payload domain, noalias w.r.t.
    /// the audit bookkeeping the check chain reads.
    public fn payload_scoped_store(self, val: rawptr, addr: rawptr) -> rawptr {
        if (self.ptr_alias_domain == null) {
            vyx_rt_build_store(self.mod, val, addr);
            return null;
        }
        vyx_rt_set_alias_scopes_on_store(self.mod, val, addr, self.ptr_alias_domain, 1);
        return null;
    }

    // Straight-line expansion of rt_pointer_checked_address()'s contract
    // (metadata tag decode, region liveness, shape extent, multiplication
    // overflow and span audits).  Emitting the checks as visible IR instead
    // of an opaque `vyx_pointer_checked_address_typed` call restores LLVM
    // inlining/LICM/CSE for `*T` loops.  The C++ backend performs the
    // equivalent expansion inline via its `ptr_checked_address` template, so
    // both backends share one semantics owner contract.
    public fn emit_inline_pointer_checked_address(self,
                                                   address: rawptr,
                                                   metadata: rawptr,
                                                   index: rawptr,
                                                   element_size: i64,
                                                   pointer_depth: i32,
                                                   name: string) -> rawptr {
        if (self.builtin_abort_fn == null || self.builtin_abort_fty == null) {
            self.report_error("abort declaration is unavailable");
            return null;
        }
        // Ensure the audit/payload alias domain exists before any audited
        // load below attaches its scope metadata.
        let alias_domain = self.pointer_alias_domain();
        if (alias_domain == null) { return null; }
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".pchk.fail").c_str(),
                                          (name.clone() + ".pchk.fail").len as u64);
        let shape_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           (name.clone() + ".pchk.shape").c_str(),
                                           (name.clone() + ".pchk.shape").len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".pchk.cont").c_str(),
                                          (name.clone() + ".pchk.cont").len as u64);
        if (fail_bb == null || shape_bb == null || cont_bb == null) {
            self.report_error("cannot create inline pointer check blocks");
            return null;
        }
        // Entry: decode the capability-tagged metadata word and audit the
        // cheap preconditions (null address/region, dead region, negative
        // index).  element_size is a compile-time constant already validated
        // as > 0 by the caller.
        let meta_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                metadata,
                                                self.ty_i64,
                                                (name.clone() + ".pchk.meta").c_str(),
                                                (name.clone() + ".pchk.meta").len as u64);
        let region_bits = vyx_rt_build_and(self.mod,
                                           meta_bits,
                                           vyx_rt_const_int(self.mod, self.ty_i64, -4, 0),
                                           (name.clone() + ".pchk.rbits").c_str(),
                                           (name.clone() + ".pchk.rbits").len as u64);
        let region = vyx_rt_build_int_to_ptr(self.mod,
                                             region_bits,
                                             self.ty_ptr,
                                             (name.clone() + ".pchk.region").c_str(),
                                             (name.clone() + ".pchk.region").len as u64);
        // Liveness is read with a plain load: the C++ backend's inline
        // ptr_checked_address template reads the same flag non-atomically, and
        // a seq_cst atomic load is opaque to LICM, which would force the check
        // into every loop iteration.  A stale liveness=1 read can only delay a
        // dead-region abort by one access; it cannot admit an out-of-span
        // access because region_delete() also zeroes base/bytes, so the span
        // audit below still fails closed.
        // The liveness flag load is deliberately omitted in the inline path:
        // region_delete()/rt_invalidate_span() zero base and bytes before the
        // flag drops, so the span audit below already fails closed for dead
        // regions.  This matches the runtime's rt_pointer_checked_address()
        // and keeps every remaining check loop-invariant and hoistable.
        let zero_i64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let null_ptr = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let bad_address = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            address,
                                            null_ptr,
                                            llvm_mir_empty_name(),
                                            0);
        let bad_region = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_eq(),
                                           region,
                                           null_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let bad_index = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_slt(),
                                          index,
                                          zero_i64,
                                          llvm_mir_empty_name(),
                                          0);
        let fail_a = vyx_rt_build_or(self.mod, bad_address, bad_region, llvm_mir_empty_name(), 0);
        let fail_b = bad_index;
        let fail_entry = vyx_rt_build_or(self.mod, fail_a, fail_b, llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, fail_entry, fail_bb, shape_bb);

        // Shape resolution: peel the dimension record for this pointer depth.
        // Without shape info the stride is the element size and the shaped
        // bound check is vacuous.
        vyx_rt_position_at_end(self.mod, shape_bb);
        let max_i64 = vyx_rt_const_int(self.mod, self.ty_i64, 9223372036854775807, 0);
        let elem_stride = vyx_rt_const_int(self.mod, self.ty_i64, element_size, 0);
        var stride: rawptr = elem_stride;
        var bound: rawptr = max_i64;
        if (pointer_depth > 0) {
            let rank_slot = vyx_rt_build_gep1(self.mod,
                                              self.ty_i8,
                                              region,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 32, 0),
                                              (name.clone() + ".pchk.rslot").c_str(),
                                              (name.clone() + ".pchk.rslot").len as u64);
            let rank = self.audited_load_i64(rank_slot, name.clone() + ".pchk.rank");
            let dims_slot = vyx_rt_build_gep1(self.mod,
                                              self.ty_i8,
                                              region,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 40, 0),
                                              (name.clone() + ".pchk.dslot").c_str(),
                                              (name.clone() + ".pchk.dslot").len as u64);
            let dims = self.audited_load_ptr(dims_slot, name.clone() + ".pchk.dims");
            let depth_i64 = vyx_rt_const_int(self.mod, self.ty_i64, pointer_depth as i64, 0);
            let level = vyx_rt_build_sub(self.mod,
                                         rank,
                                         depth_i64,
                                         (name.clone() + ".pchk.level").c_str(),
                                         (name.clone() + ".pchk.level").len as u64);
            let rank_deep = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_sge(),
                                              rank,
                                              depth_i64,
                                              llvm_mir_empty_name(),
                                              0);
            let dims_ok = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ne(),
                                            dims,
                                            null_ptr,
                                            llvm_mir_empty_name(),
                                            0);
            let level_ok = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_sge(),
                                             level,
                                             zero_i64,
                                             llvm_mir_empty_name(),
                                             0);
            let dims_rank_ok = vyx_rt_build_and(self.mod, rank_deep, dims_ok, llvm_mir_empty_name(), 0);
            let dim_valid = vyx_rt_build_and(self.mod, dims_rank_ok, level_ok, llvm_mir_empty_name(), 0);
            let dim_bb = vyx_rt_append_block(self.mod,
                                             self.current_function_value,
                                             (name.clone() + ".pchk.dim").c_str(),
                                             (name.clone() + ".pchk.dim").len as u64);
            let merge_bb = vyx_rt_append_block(self.mod,
                                               self.current_function_value,
                                               (name.clone() + ".pchk.merge").c_str(),
                                               (name.clone() + ".pchk.merge").len as u64);
            if (dim_bb == null || merge_bb == null) {
                self.report_error("cannot create inline pointer shape blocks");
                return null;
            }
            vyx_rt_build_cond_br(self.mod, dim_valid, dim_bb, merge_bb);
            vyx_rt_position_at_end(self.mod, dim_bb);
            let sixteen = vyx_rt_const_int(self.mod, self.ty_i64, 16, 0);
            let dim_off = vyx_rt_build_mul(self.mod,
                                           level,
                                           sixteen,
                                           (name.clone() + ".pchk.doff").c_str(),
                                           (name.clone() + ".pchk.doff").len as u64);
            let extent_slot = vyx_rt_build_gep1(self.mod,
                                                self.ty_i8,
                                                dims,
                                                dim_off,
                                                (name.clone() + ".pchk.eslot").c_str(),
                                                (name.clone() + ".pchk.eslot").len as u64);
            let extent = self.audited_load_i64(extent_slot, name.clone() + ".pchk.extent");
            let stride_off = vyx_rt_build_add(self.mod,
                                              dim_off,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 8, 0),
                                              (name.clone() + ".pchk.soff").c_str(),
                                              (name.clone() + ".pchk.soff").len as u64);
            let stride_slot = vyx_rt_build_gep1(self.mod,
                                                self.ty_i8,
                                                dims,
                                                stride_off,
                                                (name.clone() + ".pchk.sslot2").c_str(),
                                                (name.clone() + ".pchk.sslot2").len as u64);
            let dim_stride = self.audited_load_i64(stride_slot, name.clone() + ".pchk.dstride");
            vyx_rt_build_br(self.mod, merge_bb);
            vyx_rt_position_at_end(self.mod, merge_bb);
            let extent_phi = vyx_rt_build_phi(self.mod,
                                              self.ty_i64,
                                              (name.clone() + ".pchk.extentsel").c_str(),
                                              (name.clone() + ".pchk.extentsel").len as u64);
            vyx_rt_add_incoming(self.mod, extent_phi, max_i64, shape_bb);
            vyx_rt_add_incoming(self.mod, extent_phi, extent, dim_bb);
            let stride_phi = vyx_rt_build_phi(self.mod,
                                              self.ty_i64,
                                              (name.clone() + ".pchk.stridesel").c_str(),
                                              (name.clone() + ".pchk.stridesel").len as u64);
            vyx_rt_add_incoming(self.mod, stride_phi, elem_stride, shape_bb);
            vyx_rt_add_incoming(self.mod, stride_phi, dim_stride, dim_bb);
            let extent_positive = vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_sgt(),
                                                    extent_phi,
                                                    zero_i64,
                                                    llvm_mir_empty_name(),
                                                    0);
            let stride_positive = vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_sgt(),
                                                    stride_phi,
                                                    zero_i64,
                                                    llvm_mir_empty_name(),
                                                    0);
            let shape_pos_ok = vyx_rt_build_and(self.mod,
                                                extent_positive,
                                                stride_positive,
                                                llvm_mir_empty_name(),
                                                0);
            let shaped = vyx_rt_build_and(self.mod, dim_valid, shape_pos_ok, llvm_mir_empty_name(), 0);
            stride = vyx_rt_build_select(self.mod,
                                         shaped,
                                         stride_phi,
                                         elem_stride,
                                         (name.clone() + ".pchk.stride").c_str(),
                                         (name.clone() + ".pchk.stride").len as u64);
            bound = vyx_rt_build_select(self.mod,
                                        shaped,
                                        extent_phi,
                                        max_i64,
                                        (name.clone() + ".pchk.bound").c_str(),
                                        (name.clone() + ".pchk.bound").len as u64);
        }

        // Common tail: shaped bound, multiplication overflow and span audits.
        let overflow_limit = vyx_rt_build_sdiv(self.mod,
                                               max_i64,
                                               stride,
                                               (name.clone() + ".pchk.lim").c_str(),
                                               (name.clone() + ".pchk.lim").len as u64);
        let overflows = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_sgt(),
                                          index,
                                          overflow_limit,
                                          llvm_mir_empty_name(),
                                          0);
        let out_of_extent = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_sge(),
                                              index,
                                              bound,
                                              llvm_mir_empty_name(),
                                              0);
        let base_slot = vyx_rt_build_gep1(self.mod,
                                          self.ty_i8,
                                          region,
                                          zero_i64,
                                          (name.clone() + ".pchk.bslot").c_str(),
                                          (name.clone() + ".pchk.bslot").len as u64);
        let base = self.audited_load_ptr(base_slot, name.clone() + ".pchk.base");
        let bytes_slot = vyx_rt_build_gep1(self.mod,
                                           self.ty_i8,
                                           region,
                                           vyx_rt_const_int(self.mod, self.ty_i64, 8, 0),
                                           (name.clone() + ".pchk.zslot").c_str(),
                                           (name.clone() + ".pchk.zslot").len as u64);
        let region_bytes = self.audited_load_i64(bytes_slot, name.clone() + ".pchk.bytes");
        let address_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                   address,
                                                   self.ty_i64,
                                                   (name.clone() + ".pchk.abits").c_str(),
                                                   (name.clone() + ".pchk.abits").len as u64);
        let base_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                base,
                                                self.ty_i64,
                                                (name.clone() + ".pchk.bbits").c_str(),
                                                (name.clone() + ".pchk.bbits").len as u64);
        let below_base = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_ult(),
                                           address_bits,
                                           base_bits,
                                           llvm_mir_empty_name(),
                                           0);
        let raw_offset = vyx_rt_build_sub(self.mod,
                                          address_bits,
                                          base_bits,
                                          (name.clone() + ".pchk.roff").c_str(),
                                          (name.clone() + ".pchk.roff").len as u64);
        let outside_span = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_ugt(),
                                             raw_offset,
                                             region_bytes,
                                             llvm_mir_empty_name(),
                                             0);
        let delta = vyx_rt_build_mul(self.mod,
                                     index,
                                     stride,
                                     (name.clone() + ".pchk.delta").c_str(),
                                     (name.clone() + ".pchk.delta").len as u64);
        let delta_overflow = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_sgt(),
                                               delta,
                                               region_bytes,
                                               llvm_mir_empty_name(),
                                               0);
        let room = vyx_rt_build_sub(self.mod,
                                    region_bytes,
                                    delta,
                                    (name.clone() + ".pchk.room").c_str(),
                                    (name.clone() + ".pchk.room").len as u64);
        let offset_overflow = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_sgt(),
                                                raw_offset,
                                                room,
                                                llvm_mir_empty_name(),
                                                0);
        let tail_room = vyx_rt_build_sub(self.mod,
                                         room,
                                         raw_offset,
                                         (name.clone() + ".pchk.tail").c_str(),
                                         (name.clone() + ".pchk.tail").len as u64);
        let access_overflow = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_sgt(),
                                                stride,
                                                tail_room,
                                                llvm_mir_empty_name(),
                                                0);
        let fail_c = vyx_rt_build_or(self.mod, overflows, out_of_extent, llvm_mir_empty_name(), 0);
        let fail_d = vyx_rt_build_or(self.mod, below_base, outside_span, llvm_mir_empty_name(), 0);
        let fail_e = vyx_rt_build_or(self.mod, delta_overflow, offset_overflow, llvm_mir_empty_name(), 0);
        let fail_cd = vyx_rt_build_or(self.mod, fail_c, fail_d, llvm_mir_empty_name(), 0);
        let fail_tail = vyx_rt_build_or(self.mod, fail_cd, vyx_rt_build_or(self.mod, fail_e, access_overflow, llvm_mir_empty_name(), 0), llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, fail_tail, fail_bb, cont_bb);

        vyx_rt_position_at_end(self.mod, fail_bb);
        vyx_rt_build_call(self.mod,
                          self.builtin_abort_fty,
                          self.builtin_abort_fn,
                          null,
                          0,
                          llvm_mir_empty_name(),
                          0);
        vyx_rt_build_unreachable(self.mod);

        vyx_rt_position_at_end(self.mod, cont_bb);
        return vyx_rt_build_gep1(self.mod,
                                 self.ty_i8,
                                 address,
                                 delta,
                                 (name.clone() + ".pchk.addr").c_str(),
                                 (name.clone() + ".pchk.addr").len as u64);
    }

    public fn pointer_handle_alive(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null || self.pointer_handle_alive_fn == null
            || self.pointer_handle_alive_fty == null) {
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        if (address == null || metadata == null) { return null; }
        let alive = vyx_rt_build_call2(self.mod,
                                       self.pointer_handle_alive_fty,
                                       self.pointer_handle_alive_fn,
                                       address,
                                       metadata,
                                       name.c_str(),
                                       name.len as u64);
        if (alive == null) { return null; }
        return vyx_rt_build_icmp(self.mod,
                                 llvm_mir_icmp_ne(),
                                 alive,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 llvm_mir_empty_name(),
                                 0);
    }

    public fn pointer_region_rank_value(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null || self.pointer_region_rank_fn == null
            || self.pointer_region_rank_fty == null) {
            return null;
        }
        let metadata = self.pointer_handle_metadata(handle, name);
        if (metadata == null) { return null; }
        return vyx_rt_build_call1(self.mod,
                                  self.pointer_region_rank_fty,
                                  self.pointer_region_rank_fn,
                                  metadata,
                                  name.c_str(),
                                  name.len as u64);
    }

    public fn pointer_type_depth(self, type_id: i32) -> i32 {
        var current = type_id;
        var depth: i32 = 0;
        while (current != mir_id_invalid() && depth < 64) {
            let kind = llvm_mir_type_kind(&self.m, current);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) { break; }
            depth = depth + 1;
            current = hir_type_table_elem(self.m.types, current);
        }
        return depth;
    }

    public fn pointer_index_shape_depth(self, pointer_type: i32) -> i32 {
        if (pointer_type == mir_id_invalid()) { return 0; }
        let pointee = hir_type_table_elem(self.m.types, pointer_type);
        if (pointee != mir_id_invalid()
            && llvm_mir_type_kind(&self.m, pointee) == ty_ARRAY()) {
            return 0;
        }
        return self.pointer_type_depth(pointer_type);
    }

    public fn pointer_projected_place_addr(self,
                                           handle: rawptr,
                                           checked_address: rawptr,
                                           result_type: i32,
                                           pointer_depth: i32,
                                           name: string) -> rawptr {
        if (handle == null || checked_address == null || result_type == mir_id_invalid()
            || !llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, result_type))) {
            return checked_address;
        }
        if (pointer_depth <= 0 || self.current_function_value == null) { return checked_address; }
        let rank = self.pointer_region_rank_value(handle, name + ".rank");
        let metadata = self.pointer_handle_metadata(handle, name + ".project");
        let handle_ty = self.get_or_create_pointer_handle_ty();
        if (rank == null || metadata == null || handle_ty == null) { return null; }
        let shaped = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_sge(),
                                       rank,
                                       vyx_rt_const_int(self.mod, self.ty_i32, pointer_depth as i64, 0),
                                       (name.clone() + ".is.shaped").c_str(),
                                       (name.clone() + ".is.shaped").len as u64);
        let projected_slot = vyx_rt_build_alloca(self.mod,
                                                 handle_ty,
                                                 (name.clone() + ".slot").c_str(),
                                                 (name.clone() + ".slot").len as u64);
        let shaped_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            (name.clone() + ".shaped").c_str(),
                                            (name.clone() + ".shaped").len as u64);
        let direct_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            (name.clone() + ".direct").c_str(),
                                            (name.clone() + ".direct").len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".cont").c_str(),
                                          (name.clone() + ".cont").len as u64);
        if (shaped == null || projected_slot == null || shaped_bb == null
            || direct_bb == null || cont_bb == null) {
            self.report_error("cannot create multidimensional pointer projection flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, shaped, shaped_bb, direct_bb);

        vyx_rt_position_at_end(self.mod, shaped_bb);
        let projected = self.build_pointer_handle(checked_address,
                                                  metadata,
                                                  name + ".value");
        if (projected == null) { return null; }
        vyx_rt_build_store(self.mod, projected, projected_slot);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, direct_bb);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, cont_bb);
        let slot_phi = vyx_rt_build_phi(self.mod,
                                        self.ty_ptr,
                                        (name.clone() + ".address").c_str(),
                                        (name.clone() + ".address").len as u64);
        if (slot_phi == null) {
            self.report_error("cannot select multidimensional pointer projection storage");
            return null;
        }
        vyx_rt_add_incoming(self.mod, slot_phi, projected_slot, shaped_bb);
        vyx_rt_add_incoming(self.mod, slot_phi, checked_address, direct_bb);
        return slot_phi;
    }

    public fn pointer_region_delete(self, metadata: rawptr) -> rawptr {
        if (metadata == null || self.pointer_region_delete_fn == null
            || self.pointer_region_delete_fty == null) {
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.pointer_region_delete_fty,
                                  self.pointer_region_delete_fn,
                                  metadata,
                                  llvm_mir_empty_name(),
                                  0);
    }
}
