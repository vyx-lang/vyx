module bootstrap.llvm_lifetime;

use bootstrap.ast;
use bootstrap.mir_ids;
use bootstrap.mir_model;

extern "C" {
    fn vyx_rt_const_int(h: rawptr, ty: rawptr, value: i64, sign_extend: i32) -> rawptr;
    fn vyx_rt_int_type(h: rawptr, bits: i32) -> rawptr;
    fn vyx_rt_build_call(h: rawptr, fty: rawptr, callee: rawptr,
                         args: rawptr, n: u64, name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_build_call1(h: rawptr, fty: rawptr, callee: rawptr,
                          a0: rawptr, name: rawptr, len: u64) -> rawptr;
    fn vyx_rt_track_eh_allocation(h: rawptr, object: rawptr, release: rawptr) -> i32;
}

// SPLIT2: the raw allocation/drop emission moved out of llvm_lower. The
// caller retains layout/receiver lowering and reports returned diagnostics.
public fn llvm_lifetime_allocate_class_storage(mod: rawptr,
                                                size: i64,
                                                name: string,
                                                class_fty: rawptr,
                                                class_fn: rawptr,
                                                malloc_fty: rawptr,
                                                malloc_fn: rawptr,
                                                free_fn: rawptr,
                                                foreign_dci: bool) -> rawptr {
    if (size <= 0) { return null; }
    var allocator = class_fn;
    var allocator_type = class_fty;
    // DCI constructors receive storage owned by the generated program.
    // The JIT class allocator can be an arena, whose slices cannot be freed.
    // Use the module's malloc/free pair for these complete native objects.
    if (foreign_dci || allocator == null || allocator_type == null) {
        allocator = malloc_fn;
        allocator_type = malloc_fty;
    }
    if (allocator == null || allocator_type == null) { return null; }
    let size_value = vyx_rt_const_int(mod, vyx_rt_int_type(mod, 64), size, 0);
    let object = vyx_rt_build_call1(mod, allocator_type, allocator, size_value,
                                    name.c_str(), name.len as u64);
    if (foreign_dci && object != null) {
        // Register the storage before constructor arguments can unwind. The
        // constructor emitter activates the destructor only after success.
        if (free_fn == null || vyx_rt_track_eh_allocation(mod, object, free_fn) != 0) { return null; }
    }
    return object;
}

public fn llvm_lifetime_finish_drop(m: &MirUnit,
                                     place_id: i32,
                                     target_fn: i32,
                                     mod: rawptr,
                                     fn_type: rawptr,
                                     fn_value: rawptr,
                                     args: rawptr,
                                     pointer_storage: bool,
                                     free_fty: rawptr,
                                     free_fn: rawptr) -> string {
    let destroyed = vyx_rt_build_call(mod, fn_type, fn_value, args, 1, "".c_str(), 0);
    if (destroyed == null) { return "cannot emit object destructor call"; }

    // Only a complete DCI destructor on an owning local needs the separate
    // storage release. Stable records live inline; pointer parameters borrow;
    // descriptor release/destroy operations manage their own allocator domain.
    // Native subclass factories were handled by lower_dci_stub_destroy_place.
    if (!pointer_storage || !mir_unit_function_is_foreign_dci_dtor(m, target_fn)) {
        return "";
    }
    if (m.place_kind(place_id) != mir_place_local()) { return ""; }
    if (mir_unit_local_is_source_param(m, m.place_local(place_id))) { return ""; }
    if (free_fty == null || free_fn == null) {
        return "DCI object storage deallocator is unavailable";
    }
    let released = vyx_rt_build_call1(mod, free_fty, free_fn,
                                       ast_read_rawptr(args), "".c_str(), 0);
    if (released == null) { return "cannot release DCI object storage after destruction"; }
    return "";
}
