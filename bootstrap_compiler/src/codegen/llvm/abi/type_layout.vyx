module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn int_type_for_bits(self, bits: i32) -> rawptr {
        if (bits <= 1) { return self.ty_i1; }
        if (bits <= 8) { return self.ty_i8; }
        if (bits <= 16) { return self.ty_i16; }
        if (bits <= 32) { return self.ty_i32; }
        return self.ty_i64;
    }

    public fn nonnegative_i64_text(self, text: string) -> bool {
        let clean = self.trim_type_text(text);
        if (clean.len == 0) { return false; }
        var i: i32 = 0;
        while (i < clean.len) {
            let ch = clean.charAt(i);
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn parse_nonnegative_i64(self, text: string) -> i64 {
        let clean = self.trim_type_text(text);
        if (!self.nonnegative_i64_text(clean)) { return -1; }
        var out: i64 = 0;
        var i: i32 = 0;
        while (i < clean.len) {
            let ch = clean.charAt(i);
            out = out * 10 + ((ch - 48) as i64);
            i = i + 1;
        }
        return out;
    }

    public fn array_length_from_type_text(self, text: string) -> i64 {
        let clean = self.trim_type_text(text);
        if (clean.len < 4) { return -1; }
        if (clean.charAt(0) != 91 || clean.charAt(clean.len - 1) != 93) { return -1; }
        var bracket_depth: i32 = 0;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                bracket_depth = bracket_depth + 1;
            } else if (ch == 93) {
                if (bracket_depth > 0) { bracket_depth = bracket_depth - 1; }
            } else if (ch == 60) {
                angle_depth = angle_depth + 1;
            } else if (ch == 62) {
                if (!(i > 0 && clean.charAt(i - 1) == 45) && angle_depth > 0) {
                    angle_depth = angle_depth - 1;
                }
            } else if (ch == 40) {
                paren_depth = paren_depth + 1;
            } else if (ch == 41) {
                if (paren_depth > 0) { paren_depth = paren_depth - 1; }
            } else if (ch == 59
                       && bracket_depth == 0
                       && angle_depth == 0
                       && paren_depth == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1 || split >= clean.len - 2) { return -1; }
        var len_text = self.trim_type_text(clean.substring(split + 1, clean.len - 1));
        if (len_text.len >= 2
            && len_text.charAt(0) == 40
            && len_text.charAt(len_text.len - 1) == 41) {
            len_text = self.trim_type_text(len_text.substring(1, len_text.len - 1));
        }
        return self.parse_nonnegative_i64(len_text);
    }

    public fn array_length_for_type(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return -1; }
        return self.array_length_from_type_text(llvm_mir_type_text(&self.m, type_id));
    }

    /// Element text of an array type text like "[i32;c#83#r]" → "i32".
    public fn rtarray_elem_text_from_type_text(self, text: string) -> string {
        let clean = self.trim_type_text(text);
        if (clean.len < 4) { return ""; }
        if (clean.charAt(0) != 91 || clean.charAt(clean.len - 1) != 93) { return ""; }
        var bracket_depth: i32 = 0;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                bracket_depth = bracket_depth + 1;
            } else if (ch == 93) {
                if (bracket_depth > 0) { bracket_depth = bracket_depth - 1; }
            } else if (ch == 60) {
                angle_depth = angle_depth + 1;
            } else if (ch == 62) {
                if (!(i > 0 && clean.charAt(i - 1) == 45) && angle_depth > 0) {
                    angle_depth = angle_depth - 1;
                }
            } else if (ch == 40) {
                paren_depth = paren_depth + 1;
            } else if (ch == 41) {
                if (paren_depth > 0) { paren_depth = paren_depth - 1; }
            } else if (ch == 59
                       && bracket_depth == 0
                       && angle_depth == 0
                       && paren_depth == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1) { return ""; }
        return self.trim_type_text(clean.substring(1, split));
    }

    /// MIR type id for the element of a runtime-length array type text.
    /// The textually-interned payload class carries no elem link, so derive
    /// the element from the spelling.
    public fn rtarray_elem_type_id_from_text(self, text: string) -> i32 {
        let elem_text = self.rtarray_elem_text_from_type_text(text);
        if (elem_text.len == 0) { return mir_id_invalid(); }
        if (elem_text == "i8") { return self.m.types.intern_type_ref(tref_alloc(ty_I8(), "")); }
        if (elem_text == "i16") { return self.m.types.intern_type_ref(tref_alloc(ty_I16(), "")); }
        if (elem_text == "i32") { return self.m.types.intern_type_ref(tref_alloc(ty_I32(), "")); }
        if (elem_text == "i64") { return self.m.types.intern_type_ref(tref_alloc(ty_I64(), "")); }
        if (elem_text == "u8") { return self.m.types.intern_type_ref(tref_alloc(ty_U8(), "")); }
        if (elem_text == "u16") { return self.m.types.intern_type_ref(tref_alloc(ty_U16(), "")); }
        if (elem_text == "u32") { return self.m.types.intern_type_ref(tref_alloc(ty_U32(), "")); }
        if (elem_text == "u64") { return self.m.types.intern_type_ref(tref_alloc(ty_U64(), "")); }
        if (elem_text == "isize") { return self.m.types.intern_type_ref(tref_alloc(ty_ISIZE(), "")); }
        if (elem_text == "usize") { return self.m.types.intern_type_ref(tref_alloc(ty_USIZE(), "")); }
        if (elem_text == "f32") { return self.m.types.intern_type_ref(tref_alloc(ty_F32(), "")); }
        if (elem_text == "f64") { return self.m.types.intern_type_ref(tref_alloc(ty_F64(), "")); }
        if (elem_text == "bool") { return self.m.types.intern_type_ref(tref_alloc(ty_BOOL(), "")); }
        if (elem_text == "char") { return self.m.types.intern_type_ref(tref_alloc(ty_CHAR(), "")); }
        if (elem_text == "str" || elem_text == "string") { return self.m.types.intern_type_ref(tref_alloc(ty_STRING(), "")); }
        if (elem_text == "rawptr") { return self.m.types.intern_type_ref(tref_alloc(ty_RAWPTR(), "")); }
        return self.m.types.intern_type_ref(tref_alloc(ty_CLASS(), elem_text));
    }

    public fn tuple_member_index(self, name: string) -> i32 {
        if (name.len == 0) { return -1; }
        var i: i32 = 0;
        if (name.charAt(0) == 95) { i = 1; }
        if (i >= name.len) { return -1; }
        var out: i32 = 0;
        while (i < name.len) {
            let c = name.charAt(i);
            if (c < 48 || c > 57) { return -1; }
            out = out * 10 + (c - 48);
            i = i + 1;
        }
        return out;
    }

    public fn tuple_element_count_for_type(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid() || llvm_mir_type_kind(&self.m, type_id) != ty_TUPLE()) { return 0; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) { return 0; }
        let inner = text.substring(1, text.len - 1);
        var count: i32 = 0;
        while (count < 256) {
            let part = policy_generic_arg_at(inner, count);
            if (part.len == 0) { return count; }
            count = count + 1;
        }
        return count;
    }

    public fn tuple_element_type_id(self, type_id: i32, index: i32) -> i32 {
        if (type_id == mir_id_invalid() || index < 0 || llvm_mir_type_kind(&self.m, type_id) != ty_TUPLE()) {
            return mir_id_invalid();
        }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) {
            return mir_id_invalid();
        }
        let inner = text.substring(1, text.len - 1);
        let elem_text = policy_generic_arg_at(inner, index);
        if (elem_text.len == 0) { return mir_id_invalid(); }
        return self.type_id_for_resolved_text(self.current_function_id, elem_text);
    }

    public fn type_text_base_is_qualified(self, text: string) -> bool {
        let base = policy_generic_call_base(text.clone());
        var i: i32 = 0;
        while (i < base.len) {
            if (base.charAt(i) == 46) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn type_text_is_unqualified_name(self, name: string) -> bool {
        var i: i32 = 0;
        while (i < name.len) {
            if (name.charAt(i) == 46) { return false; }
            i = i + 1;
        }
        return name.len > 0;
    }

    public fn type_text_equivalent_at_depth(self, lhs: string, rhs: string, depth: i32) -> bool {
        if (lhs.len == 0 || rhs.len == 0 || depth > 64) { return false; }
        let left = self.normalize_type_text(lhs);
        let right = self.normalize_type_text(rhs);
        if (left == right) { return true; }
        let left_has_args = policy_generic_call_has_args(left.clone()) != 0;
        let right_has_args = policy_generic_call_has_args(right.clone()) != 0;
        if (left_has_args != right_has_args) { return false; }
        if (!left_has_args) {
            return policy_type_name_equal(left, right);
        }
        let left_base = policy_generic_call_base(left.clone());
        let right_base = policy_generic_call_base(right.clone());
        if (!self.type_text_equivalent_at_depth(left_base, right_base, depth + 1)) { return false; }
        let left_args = policy_generic_call_args(left.clone());
        let right_args = policy_generic_call_args(right.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let left_arg = policy_generic_arg_at(left_args, idx);
            let right_arg = policy_generic_arg_at(right_args, idx);
            if (left_arg.len == 0 || right_arg.len == 0) {
                return left_arg.len == 0 && right_arg.len == 0;
            }
            if (!self.type_text_equivalent_at_depth(left_arg, right_arg, depth + 1)) { return false; }
            idx = idx + 1;
        }
        return false;
    }

    public fn type_text_equivalent(self, lhs: string, rhs: string) -> bool {
        return self.type_text_equivalent_at_depth(lhs, rhs, 0);
    }

    public fn record_layout_fields_are_closed(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let field_count = mir_unit_field_count_for_type(&self.m, type_id);
        if (field_count <= 0) { return false; }
        var idx: i32 = 0;
        while (idx < field_count) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, idx);
            if (field_id == mir_id_invalid()) { return false; }
            let field_type_text = llvm_mir_type_text(&self.m, mir_unit_field_type(&self.m, field_id));
            if (llvm_mir_type_name_has_open_template_atom(field_type_text)) { return false; }
            idx = idx + 1;
        }
        return true;
    }

    public fn closed_template_layout_for_generic_instance(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return mir_id_invalid(); }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0 || policy_generic_call_has_args(text.clone()) == 0) { return mir_id_invalid(); }
        let base = policy_generic_call_base(text.clone());
        // Pass 1 — exact (module-qualifier included) spelling match. This is
        // what legitimately folds `t.Vec::<i32>` onto the `t.Vec` entry.
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && policy_type_name_equal_qualified(base, llvm_mir_type_text(&self.m, id))
                && self.record_layout_fields_are_closed(id)) {
                return id;
            }
            id = id + 1;
        }
        // Pass 2 — last-dotted-segment fold, kept only for the qualified vs
        // unqualified spelling gap (`t.Vec` vs `Vec`). It must NOT be used to
        // guess between genuinely different records: nested records share
        // their leaf name by construction (`Holder.Inner` / `Zolder.Inner`),
        // so a non-unique outcome means the fold is ambiguous and borrowing
        // either layout would mis-type the fields. Bail out instead.
        var unique: i32 = mir_id_invalid();
        id = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && self.type_text_equivalent(base, llvm_mir_type_text(&self.m, id))
                && self.record_layout_fields_are_closed(id)) {
                if (unique != mir_id_invalid()) { return mir_id_invalid(); }
                unique = id;
            }
            id = id + 1;
        }
        return unique;
    }

    public fn canonical_record_type_id(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return type_id; }
        let cached = llvm_mir_i32_map_get(self.canonical_type_cache, type_id);
        if (cached != 0) { return cached; }
        var result = type_id;
        let raw_kind = llvm_mir_type_kind(&self.m, type_id);
        // Pointer/ref types stay themselves. `&spdlog.details.log_msg` contains
        // `.` so type_text_base_is_qualified is true; folding it onto the CLASS
        // layout made lower_type(REF) a raw pointer / size-align blob, and
        // pointer_handle_address extractvalue then aborted in LLVM.
        if (raw_kind == ty_PTR() || raw_kind == ty_REF() || raw_kind == ty_MUTREF()
            || raw_kind == ty_RAWPTR()
            || raw_kind == ty_FN() || raw_kind == ty_CFN()) {
            // A function-pointer type is never a record: it has no layout to
            // fold onto.  Without this it fell through to the equivalence
            // search below whenever its *text* looked module-qualified
            // (`fn(T.App.A,T.App.B)->T.App.B` contains dots, so
            // `type_text_base_is_qualified` is true) and got collapsed onto an
            // unrelated entry — in practice the return type `B`, which made
            // `lower_type` emit `%mir.struct.T.App.B` for a `fn(...)`
            // parameter.  The signature text (and its mangling) stayed
            // correct, so the damage only showed up as an LLVM verifier
            // failure when the calling unit was emitted separately.
            llvm_mir_i32_map_put(self.canonical_type_cache, type_id, type_id);
            return type_id;
        }
        let kind_is_class = raw_kind == ty_CLASS();
        let text = llvm_mir_type_text(&self.m, type_id);
        // Module-qualified entries (e.g. `gen_industrial.TextR`) may carry a
        // non-CLASS kind while the layout lives on the unqualified CLASS
        // entry; let those fall through to the equivalence search instead of
        // early-returning.
        if (!kind_is_class && !self.type_text_base_is_qualified(text)) { return type_id; }
        if (text.len == 0) { return type_id; }
        // Variant-bearing (enum) types can be registered more than once under
        // text-equivalent spellings (module-qualified vs plain). Collapse all
        // of them onto the smallest-id equivalent entry so enum ABI structs,
        // variant-owner comparisons, and payload layouts share one identity.
        if (kind_is_class && mir_unit_variant_count_for_type(&self.m, type_id) > 0) {
            var vrep: i32 = 1;
            while (vrep < type_id) {
                if (llvm_mir_type_kind(&self.m, vrep) == ty_CLASS()
                    && mir_unit_variant_count_for_type(&self.m, vrep) > 0
                    && self.type_text_equivalent(text, llvm_mir_type_text(&self.m, vrep))) {
                    llvm_mir_i32_map_put(self.canonical_type_cache, type_id, vrep);
                    return vrep;
                }
                vrep = vrep + 1;
            }
        }
        if (mir_unit_field_count_for_type(&self.m, type_id) <= 0) {
            // A fieldless class entry is a forward/import placeholder with no
            // authoritative layout: its own ABI flags are unreliable (a
            // value-struct class referenced via a pointer/import may surface
            // here as a CLASS placeholder that never received
            // hir_type_flag_value_struct).  Prefer a nominal candidate whose
            // value-struct ABI flag matches this entry, but fall back to any
            // complete same-named CLASS layout so a fieldless value-struct
            // placeholder still canonicalizes onto its real declaration
            // instead of reporting field_count=0.
            let placeholder_is_value_struct =
                (hir_type_table_flags(self.m.types, type_id) & hir_type_flag_value_struct()) != 0;
            var nominal_fallback: i32 = mir_id_invalid();
            var id: i32 = 1;
            while (id <= self.m.types.count) {
                if (id != type_id
                    && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                    && mir_unit_field_count_for_type(&self.m, id) > 0
                    && self.type_text_equivalent(text, llvm_mir_type_text(&self.m, id))) {
                    let candidate_is_value_struct =
                        (hir_type_table_flags(self.m.types, id) & hir_type_flag_value_struct()) != 0;
                    if (!kind_is_class || candidate_is_value_struct == placeholder_is_value_struct) {
                        result = id;
                        llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                        return result;
                    }
                    if (nominal_fallback == mir_id_invalid()) { nominal_fallback = id; }
                }
                id = id + 1;
            }
            if (nominal_fallback != mir_id_invalid()) {
                result = nominal_fallback;
                llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                return result;
            }
            // Enums own variants instead of fields: map a variant-less
            // generic enum instance (or qualified alias) onto the
            // variant-bearing equivalent so variant-owner comparisons and
            // payload layouts line up. Generic instances additionally match
            // the argless template entry by base name, mirroring
            // closed_template_layout_for_generic_instance for records.
            if (mir_unit_variant_count_for_type(&self.m, type_id) <= 0) {
                let has_args = policy_generic_call_has_args(text.clone()) != 0;
                let base_text = policy_generic_call_base(text.clone());
                var vid: i32 = 1;
                while (vid <= self.m.types.count) {
                    if (vid != type_id
                        && llvm_mir_type_kind(&self.m, vid) == ty_CLASS()
                        && mir_unit_variant_count_for_type(&self.m, vid) > 0) {
                        let vid_text = llvm_mir_type_text(&self.m, vid);
                        var matches = self.type_text_equivalent(text, vid_text);
                        if (!matches
                            && has_args
                            && policy_generic_call_has_args(vid_text.clone()) == 0
                            && self.type_text_equivalent(base_text, vid_text)) {
                            matches = true;
                        }
                        if (matches) {
                            result = vid;
                            llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                            return result;
                        }
                    }
                    vid = vid + 1;
                }
            }
        }
        // Borrow a template's layout only when this instance has no usable
        // layout of its own — i.e. its fields still carry open template atoms
        // (or it has none at all). A fully concrete instance must keep its own
        // layout: folding it onto a template merely because the last dotted
        // segment matches is how `A.Inner::<i32,f64>` picked up unrelated
        // `B.Inner`'s i64 field and spilled a double into an integer slot.
        let template_layout = self.closed_template_layout_for_generic_instance(type_id);
        if (template_layout != mir_id_invalid()
            && !self.record_layout_fields_are_closed(type_id)) {
            result = template_layout;
        }
        llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
        return result;
    }

    public fn finalize_record_ty_body(self, type_id: i32, st: rawptr, field_count: i32) -> rawptr {
        if (self.dci_type_uses_stable_value_layout(type_id)) {
            let layout = self.dci_layout_object_for_type(type_id);
            let size_bytes = self.dci_json_i64(layout, "size");
            let alignment = self.dci_json_i64(layout, "alignment");
            if (size_bytes == 0) {
                self.report_error("DCI zero-sized value layout requires an unsupported ignore ABI for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (size_bytes < 0 || alignment <= 0 || alignment > size_bytes) {
                self.report_error("invalid DCI value layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var anchor_ty = self.ty_i8;
            if (alignment == 2) { anchor_ty = self.ty_i16; }
            else if (alignment == 4) { anchor_ty = self.ty_i32; }
            else if (alignment == 8) { anchor_ty = self.ty_i64; }
            else if (alignment == 16) { anchor_ty = vyx_rt_int_type(self.mod, 128); }
            else if (alignment == 32) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 4); }
            else if (alignment == 64) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 8); }
            else if (alignment == 128) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 16); }
            else if (alignment != 1) {
                // A capability boundary, not an internal invariant.  The anchor
                // must be a type whose *own* ABI alignment is the record's,
                // because every generic storage path (local slot, load, store,
                // byval/sret default) inherits its alignment from the type
                // rather than from the descriptor.  Integers stop at i128 and
                // an array inherits its element's alignment, so 32 / 64 / 128
                // need a vector anchor; anything else has no anchor at all.
                self.report_unsupported_alignment(alignment,
                                                  llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (anchor_ty == null) {
                self.report_error("cannot build DCI value layout anchor for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var body_count: i32 = 1;
            if (size_bytes > alignment) { body_count = 2; }
            let body = malloc((body_count * 8) as u64);
            if (body == null) {
                self.report_error("cannot allocate DCI value layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            ast_write_rawptr(body, anchor_ty);
            if (body_count == 2) {
                let tail_ty = vyx_rt_array_ty(self.mod, self.ty_i8, (size_bytes - alignment) as u64);
                if (tail_ty == null) {
                    free(body);
                    self.report_error("cannot create DCI value layout tail for " + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(body, 8), tail_ty);
            }
            if (vyx_rt_struct_ty_set_body(self.mod, st, body, body_count as u64, 0) != 0) {
                free(body);
                self.report_error("cannot finalize DCI value type " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            free(body);
            let measured = vyx_rt_type_alloc_size(self.mod, st);
            if (measured != size_bytes) {
                self.report_error("DCI value layout size mismatch for " + llvm_mir_type_text(&self.m, type_id)
                          + ": descriptor=" + size_bytes.toString()
                          + " llvm=" + measured.toString());
                return null;
            }
            llvm_mir_i32_map_put(self.type_struct_body_field_counts, type_id, body_count + 1);
            return st;
        }
        var fields: rawptr = null;
        var final_field_count = field_count;
        if (self.type_is_foreign_dci(type_id) && final_field_count <= 0) {
            fields = malloc(8);
            if (fields == null) {
                self.report_error("cannot allocate empty external DCI object layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            ast_write_rawptr(fields, self.ty_i8);
            final_field_count = 1;
        }
        if (field_count > 0) {
            fields = malloc((field_count * 8) as u64);
            if (fields == null) {
                self.report_error("cannot allocate record field list for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var idx: i32 = 0;
            while (idx < field_count) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, idx);
                if (field_id == mir_id_invalid()) {
                    free(fields);
                    self.report_error("missing field layout for " + llvm_mir_type_text(&self.m, type_id)
                              + " index " + policy_i64_to_string(idx as i64));
                    return null;
                }
                let field_type = mir_unit_field_type(&self.m, field_id);
                let field_ll = self.lower_type(field_type);
                if (field_type == mir_id_invalid() || field_ll == null) {
                    free(fields);
                    self.report_error("cannot lower field layout for " + llvm_mir_type_text(&self.m, type_id)
                              + "." + mir_unit_field_name(&self.m, field_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(fields, idx * 8), field_ll);
                idx = idx + 1;
            }
        }
        var packed_flag: i32 = 0;
        if (self.type_repr_is_packed(type_id)) { packed_flag = 1; }
        var emit_fields = fields;
        var emit_count = final_field_count;
        let want_size = self.value_storage_size_fast(type_id);
        if (want_size > 0 && emit_count >= 0) {
            var laid: i64 = 0;
            var fi: i32 = 0;
            while (fi < field_count) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, fi);
                if (field_id != mir_id_invalid()) {
                    let ft = mir_unit_field_type(&self.m, field_id);
                    var fa = self.value_storage_align(ft);
                    if (packed_flag != 0) { fa = 1; }
                    if (fa <= 0) { fa = 1; }
                    let fs = self.value_storage_size_fast(ft);
                    if (fs > 0) {
                        laid = self.align_up_i64(laid, fa);
                        laid = laid + fs;
                    }
                }
                fi = fi + 1;
            }
            if (want_size > laid) {
                let pad = (want_size - laid) as u64;
                let pad_ty = vyx_rt_array_ty(self.mod, self.ty_i8, pad);
                if (pad_ty != null) {
                    let grown = malloc(((emit_count + 1) * 8) as u64);
                    if (grown != null) {
                        var copy_i: i32 = 0;
                        while (copy_i < emit_count) {
                            if (fields != null) {
                                ast_write_rawptr(ptr_offset(grown, copy_i * 8),
                                                 ast_read_rawptr(ptr_offset(fields, copy_i * 8)));
                            }
                            copy_i = copy_i + 1;
                        }
                        ast_write_rawptr(ptr_offset(grown, emit_count * 8), pad_ty);
                        if (fields != null) { free(fields); }
                        emit_fields = grown;
                        emit_count = emit_count + 1;
                        fields = grown;
                    }
                }
            }
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, emit_fields, emit_count as u64, packed_flag) != 0) {
            if (fields != null) { free(fields); }
            self.report_error("cannot finalize record type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (fields != null) { free(fields); }
        llvm_mir_i32_map_put(self.type_struct_body_field_counts, type_id, final_field_count + 1);
        return st;
    }

    public fn generic_record_instance_has_zero_field_template(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0 || policy_generic_call_has_args(text.clone()) == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        if (base.len == 0) { return false; }
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && self.type_text_equivalent(base, llvm_mir_type_text(&self.m, id))) {
                return mir_unit_field_count_for_type(&self.m, id) == 0
                    && mir_unit_variant_count_for_type(&self.m, id) == 0;
            }
            id = id + 1;
        }
        return false;
    }

    public fn get_or_create_record_ty(self, type_id: i32) -> rawptr {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type != type_id) { return self.get_or_create_record_ty(canonical_type); }
        let field_count = mir_unit_field_count_for_type(&self.m, type_id);
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) {
            if (llvm_mir_i32_map_get(self.type_struct_body_field_counts, type_id) == 0
                && field_count > 0) {
                return self.finalize_record_ty_body(type_id, cached, field_count);
            }
            if (llvm_mir_i32_map_get(self.type_struct_body_field_counts, type_id) == 0
                && field_count <= 0
                && self.generic_record_instance_has_zero_field_template(type_id)) {
                return self.finalize_record_ty_body(type_id, cached, field_count);
            }
            return cached;
        }
        let name = "mir.struct." + llvm_mir_type_text(&self.m, type_id);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create record type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        if (field_count <= 0
            && policy_generic_call_has_args(llvm_mir_type_text(&self.m, type_id).clone()) != 0
            && !self.generic_record_instance_has_zero_field_template(type_id)) {
            return st;
        }
        if (self.finalize_record_ty_body(type_id, st, field_count) == null) { return null; }
        return st;
    }

    public fn get_or_create_tuple_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let elem_count = self.tuple_element_count_for_type(type_id);
        let name = "mir.tuple." + llvm_mir_type_text(&self.m, type_id);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create tuple type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        var fields: rawptr = null;
        if (elem_count > 0) {
            fields = malloc((elem_count * 8) as u64);
            if (fields == null) {
                self.report_error("cannot allocate tuple field list for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var idx: i32 = 0;
            while (idx < elem_count) {
                let elem_type = self.tuple_element_type_id(type_id, idx);
                let elem_ll = self.lower_type(elem_type);
                if (elem_type == mir_id_invalid() || elem_ll == null) {
                    free(fields);
                    self.report_error("cannot lower tuple element #" + policy_i64_to_string(idx as i64)
                              + " for " + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(fields, idx * 8), elem_ll);
                idx = idx + 1;
            }
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, elem_count as u64, 0) != 0) {
            if (fields != null) { free(fields); }
            self.report_error("cannot finalize tuple type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (fields != null) { free(fields); }
        return st;
    }

    public fn type_is_dyn_trait(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len <= 3) { return false; }
        if (!text.startsWith("dyn")) { return false; }
        return mir_unit_field_count_for_type(&self.m, type_id) <= 0;
    }

    public fn type_dyn_trait_id(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        var cur = type_id;
        var depth: i32 = 0;
        while (depth < 4 && cur != mir_id_invalid()) {
            if (self.type_is_dyn_trait(cur)) { return cur; }
            let kind = llvm_mir_type_kind(&self.m, cur);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) {
                return mir_id_invalid();
            }
            cur = hir_type_table_elem(self.m.types, cur);
            depth = depth + 1;
        }
        return mir_id_invalid();
    }

    public fn type_is_class_pointer_abi(self, type_id: i32) -> bool {
        // Native value classes do NOT use this predicate; they follow the
        // unique C aggregate rule in type_uses_indirect_c_abi (sret/byval vs
        // coerce). This flag is only for foreign-DCI types without a stable
        // value layout, plus the remaining non-value_struct class forms.
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.class_pointer_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let canonical_type = self.canonical_record_type_id(type_id);
        var result = false;
        if (llvm_mir_type_kind(&self.m, canonical_type) == ty_CLASS()) {
            // Vyx subclasses of imported C++ types are heap factory objects
            // (vtable + C++ layout). They are never empty value-struct `{}`.
            if (self.type_is_dci_stub_class(canonical_type)) {
                result = true;
            } else if (mir_unit_type_is_foreign_dci(&self.m, canonical_type)
                && !self.dci_type_uses_stable_value_layout(canonical_type)) {
                result = true;
            } else if (!self.type_is_value_struct_abi(canonical_type)
                && !self.type_is_str_abi(canonical_type)
                && !self.type_is_dyn_trait(canonical_type)
                && !self.type_is_option_abi(canonical_type)
                && !self.type_is_result_abi(canonical_type)
                && !self.type_is_plain_enum_abi(canonical_type)) {
                result = true;
            }
        }
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.class_pointer_abi_cache, type_id, state);
        return result;
    }

    public fn class_pointer_abi_record_type(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.canonical_record_type_id(type_id);
        }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            if (self.type_is_class_pointer_abi(elem)) {
                return self.canonical_record_type_id(elem);
            }
        }
        return mir_id_invalid();
    }

    // A fieldless value-struct placeholder may reach lowering without ever
    // receiving hir_type_flag_value_struct (imported/forward class referenced
    // through a pointer). The authoritative fallback is: does any type in the
    // unit carry the value-struct flag under the same base name? Rather than
    // rescan every type on each query (the historical O(types) walk, which
    // turned this hot predicate into an O(types^2) explosion once native
    // classes became value structs), collect the value-struct base names once
    // into a hashed set and answer in O(1) thereafter.
    public fn ensure_value_struct_base_name_index(self) {
        if (self.value_struct_base_name_index_ready) { return; }
        self.value_struct_base_name_index_ready = true;
        var cap = self.m.types.count * 2 + 16;
        if (cap < 65536) { cap = 65536; }
        let buf = llvm_mir_symbol_index_new(cap);
        if (buf == null) { return; }
        self.value_struct_base_name_index = buf;
        self.value_struct_base_name_index_cap = cap;
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if ((hir_type_table_flags(self.m.types, id) & hir_type_flag_value_struct()) != 0) {
                var candidate_base = policy_generic_call_base(llvm_mir_type_text(&self.m, id).clone());
                if (candidate_base.len == 0) { candidate_base = llvm_mir_type_text(&self.m, id); }
                let candidate_last = self.last_path_segment(candidate_base);
                if (candidate_last.len > 0) {
                    llvm_mir_symbol_index_put_first(buf, cap, candidate_last, 1);
                }
            }
            id = id + 1;
        }
    }

    public fn compute_type_is_value_struct_abi(self, type_id: i32) -> bool {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        if (self.type_is_dci_stub_class(canonical_type)) { return false; }
        if (mir_unit_type_is_foreign_dci(&self.m, canonical_type)) {
            return self.dci_type_uses_stable_value_layout(canonical_type);
        }
        if ((hir_type_table_flags(self.m.types, canonical_type) & hir_type_flag_value_struct()) != 0) { return true; }
        let text = llvm_mir_type_text(&self.m, canonical_type);
        var base = policy_generic_call_base(text.clone());
        if (base.len == 0) { base = text; }
        let base_last = self.last_path_segment(base);
        if (base_last.len == 0) { return false; }
        self.ensure_value_struct_base_name_index();
        if (self.value_struct_base_name_index == null) { return false; }
        return llvm_mir_symbol_index_get(self.value_struct_base_name_index,
                                         self.value_struct_base_name_index_cap,
                                         base_last) != mir_id_invalid();
    }

    public fn type_text_kind_key(self, kind: i32, text: string) -> string {
        return "\nK" + kind.toString() + "\t" + text;
    }

    public fn ensure_type_text_index(self) {
        if (self.type_text_index_ready && self.type_text_index_types == self.m.types.count) {
            return;
        }
        if (self.type_text_index != null) {
            llvm_mir_dispose_symbol_index(self.type_text_index, self.type_text_index_cap, false);
            self.type_text_index = null;
        }
        self.type_text_index_ready = true;
        self.type_text_index_types = self.m.types.count;
        self.interned_rawptr_type_id = mir_id_invalid();
        self.interned_str_type_id = mir_id_invalid();
        self.interned_f32_type_id = mir_id_invalid();
        self.interned_f64_type_id = mir_id_invalid();
        var cap = self.m.types.count * 4 + 16;
        if (cap < 65536) { cap = 65536; }
        let buf = llvm_mir_symbol_index_new(cap);
        if (buf == null) { return; }
        self.type_text_index = buf;
        self.type_text_index_cap = cap;
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            let text = llvm_mir_type_text(&self.m, id);
            if (text.len > 0) {
                llvm_mir_symbol_index_put_first(buf, cap, text.clone(), id);
                let kind = llvm_mir_type_kind(&self.m, id);
                llvm_mir_symbol_index_put_first(buf, cap, self.type_text_kind_key(kind, text.clone()), id);
                if (text == "rawptr" && self.interned_rawptr_type_id == mir_id_invalid()) {
                    self.interned_rawptr_type_id = id;
                } else if (text == "str" && self.interned_str_type_id == mir_id_invalid()) {
                    self.interned_str_type_id = id;
                } else if (text == "f32" && self.interned_f32_type_id == mir_id_invalid()) {
                    self.interned_f32_type_id = id;
                } else if (text == "f64" && self.interned_f64_type_id == mir_id_invalid()) {
                    self.interned_f64_type_id = id;
                }
            }
            id = id + 1;
        }
    }

    public fn type_is_value_struct_abi(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.value_struct_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let result = self.compute_type_is_value_struct_abi(type_id);
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.value_struct_abi_cache, type_id, state);
        return result;
    }

    // Unique native C aggregate ABI (SysV x86_64 eightbytes):
    //   * Vyx-to-Vyx: ≤ 2 machine words stay first-class LLVM structs;
    //     larger aggregates use hidden sret + byval.
    //   * C calling convention (extern / no_mangle / csym): small aligned
    //     aggregates are coerced to the clang integer/SSE machine type
    //     (i64, [2 x i64], float/double); packed or unaligned fields and
    //     size > 16 use MEMORY (sret/byval).
    // Method `self` is always a pointer (see type_uses_self_pointer_abi).
    // Foreign DCI keeps its own descriptor; this rule is native Vyx only.
    public fn type_c_abi_word_bytes(self) -> i64 { return 8; }

    public fn type_c_abi_max_direct_bytes(self) -> i64 {
        return self.type_c_abi_word_bytes() * 2;
    }

    public fn type_is_native_c_aggregate(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        if (self.type_is_dyn_trait(canonical_type)) { return false; }
        if (self.type_is_class_pointer_abi(canonical_type)) { return false; }
        // DCI types keep descriptor-driven sret/byval/coerce. Applying the
        // native eightbyte rule turns a 16-byte string_view into a coerced
        // scalar, then rebuild_record_value_as extractvalue aborts.
        if (self.type_is_foreign_dci(canonical_type)) { return false; }
        return true;
    }

    public fn type_uses_indirect_c_abi(self, type_id: i32) -> bool {
        if (!self.type_is_native_c_aggregate(type_id)) { return false; }
        let bytes = self.value_storage_size(type_id);
        if (bytes <= 0) { return false; }
        if (bytes > self.type_c_abi_max_direct_bytes()) { return true; }
        // Win64: LLVM returns {f32,f32,f32,f32} in XMM0/XMM1 plus x87 ST0/ST1.
        // Later SSE copies of UiTheme/AppWorld clobber that; Color/Rectangle
        // layout then stores 0 and the GPU presents a blank clear color.
        if (llvm_mir_effective_target_is_windows() && bytes > self.type_c_abi_word_bytes()) {
            let cls = self.c_sysv_classify(type_id);
            if ((cls & 256) == 0) {
                let sse = self.c_sysv_cls_sse();
                let e0 = cls & 15;
                let e1 = (cls >> 4) & 15;
                if (e0 == sse || e1 == sse) { return true; }
            }
        }
        return false;
    }

    public fn class_record_storage_ty(self, type_id: i32) -> rawptr {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type == mir_id_invalid()) { return null; }
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return null; }
        return self.get_or_create_record_ty(canonical_type);
    }

    public fn lower_storage_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (self.type_is_class_pointer_abi(canonical_type)) {
            return self.class_record_storage_ty(canonical_type);
        }
        return self.lower_type(canonical_type);
    }

    public fn lower_value_storage_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        return self.lower_type(type_id);
    }

    public fn align_up_i64(self, value: i64, align: i64) -> i64 {
        if (align <= 1) { return value; }
        let rem = value % align;
        if (rem == 0) { return value; }
        return value + (align - rem);
    }

    public fn value_storage_size_fast(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical_type);
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
        if (kind == ty_I16() || kind == ty_U16()) { return 2; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
        if (llvm_mir_kind_pointer_handle(kind)) { return 16; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
            || kind == ty_F64() || llvm_mir_kind_pointer_like(kind)) {
            return 8;
        }
        if (self.type_is_str_abi(canonical_type)) { return 32; }
        if (kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.m.types, canonical_type);
            let count = self.array_length_for_type(canonical_type);
            if (elem_type == mir_id_invalid() || count < 0) { return 0; }
            let elem_size = self.value_storage_size_fast(elem_type);
            if (elem_size <= 0) { return 0; }
            return elem_size * count;
        }
        if (kind == ty_TUPLE()) {
            var offset: i64 = 0;
            var max_align: i64 = 1;
            let count2 = self.tuple_element_count_for_type(canonical_type);
            var idx: i32 = 0;
            while (idx < count2) {
                let elem_type2 = self.tuple_element_type_id(canonical_type, idx);
                let elem_size2 = self.value_storage_size_fast(elem_type2);
                if (elem_size2 <= 0) { return 0; }
                var elem_align = self.value_storage_align(elem_type2);
                if (elem_align <= 0) { elem_align = 8; }
                if (elem_align > max_align) { max_align = elem_align; }
                offset = self.align_up_i64(offset, elem_align);
                offset = offset + elem_size2;
                idx = idx + 1;
            }
            return self.align_up_i64(offset, max_align);
        }
        // Option/Result/enum are value-struct CLASSes with zero named fields.
        // Their payload lives in the variant ABI ({i32 tag, ...}), not in
        // `field_count`. Walking fields would report size 1 and Vec memcpy
        // would drop the payload (is_some survives, unwrap_or returns 0).
        if (kind == ty_CLASS()
            && (self.type_is_option_abi(canonical_type)
                || self.type_is_result_abi(canonical_type)
                || self.type_is_plain_enum_abi(canonical_type))) {
            return 0;
        }
        if (kind == ty_CLASS() && self.type_is_value_struct_abi(canonical_type)) {
            let packed = self.type_repr_is_packed(canonical_type);
            var offset3: i64 = 0;
            // A value class occupies its whole ABI slot when it is a field of
            // another record: `InnerClass { i32 }` has size 4 but a stride of
            // 8, so `Nested { inner: InnerClass, tail: u8 }` reports 16 and not
            // 8. The record itself is only padded to its widest field - the
            // 8-byte class floor belongs to `alignof::<T>()`, not to `sizeof`.
            // `finalize_record_ty_body` appends whatever tail padding is needed
            // to make the LLVM record size agree with this answer; it walks the
            // unfloored storage alignment on purpose, because that walk mirrors
            // where LLVM actually places the fields. Keep the two in step.
            var natural_align: i64 = 1;
            let field_n = mir_unit_field_count_for_type(&self.m, canonical_type);
            var fi: i32 = 0;
            while (fi < field_n) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, canonical_type, fi);
                if (field_id != mir_id_invalid()) {
                    let ft = mir_unit_field_type(&self.m, field_id);
                    let fs = self.value_storage_size_fast(ft);
                    if (fs <= 0) { return 0; }
                    var fa = self.value_abi_align(ft);
                    if (packed) { fa = 1; }
                    if (fa <= 0) { fa = 1; }
                    if (fa > natural_align) { natural_align = fa; }
                    offset3 = self.align_up_i64(offset3, fa);
                    offset3 = offset3 + self.align_up_i64(fs, fa);
                }
                fi = fi + 1;
            }
            offset3 = self.align_up_i64(offset3, natural_align);
            if (offset3 <= 0) { return 1; }
            return offset3;
        }
        return 0;
    }

    public fn value_storage_size(self, type_id: i32) -> i64 {
        let fast = self.value_storage_size_fast(type_id);
        if (fast > 0) { return fast; }
        let dci_size = self.dci_record_size_bytes_for_type(type_id);
        if (dci_size > 0) { return dci_size; }
        let ty = self.lower_storage_type(type_id);
        if (ty == null) { return 0; }
        let bytes = vyx_rt_type_alloc_size(self.mod, ty);
        if (bytes > 0) { return bytes; }
        return 0;
    }

    public fn copy_value_storage_to_addr(self,
                                         dst_addr: rawptr,
                                         value_id: i32,
                                         dst_type: i32,
                                         context: string) -> bool {
        if (dst_addr == null || value_id == mir_id_invalid() || dst_type == mir_id_invalid()) {
            self.report_error("cannot copy value storage for " + context);
            return false;
        }
        if (self.type_is_class_pointer_abi(dst_type)) {
            let src_addr = self.lower_self_receiver_address(value_id, dst_type);
            let size_bytes = self.value_storage_size(dst_type);
            if (src_addr == null || size_bytes <= 0) {
                self.report_error("cannot materialize class value storage for "
                          + context
                          + " type "
                          + llvm_mir_type_text(&self.m, dst_type));
                return false;
            }
            if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("memcpy declaration is unavailable");
                return false;
            }
            let copied = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcpy_fty,
                                            self.builtin_memcpy_fn,
                                            dst_addr,
                                            src_addr,
                                            vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                            llvm_mir_empty_name(),
                                            0);
            if (copied == null) {
                self.report_error("cannot copy class value storage for "
                          + context
                          + " type "
                          + llvm_mir_type_text(&self.m, dst_type));
                return false;
            }
            if (self.current_place_id != mir_id_invalid()
                && self.m.place_kind(self.current_place_id) == mir_place_local()) {
                self.emit_debug_local_at_assignment(self.m.place_local(self.current_place_id), copied);
            }
            return true;
        }
        let value = self.lower_value_as(value_id, dst_type);
        if (value == null) {
            self.report_error("cannot lower value for storage copy in "
                      + context
                      + " type "
                      + llvm_mir_type_text(&self.m, dst_type));
            return false;
        }
        vyx_rt_build_store(self.mod, value, dst_addr);
        return true;
    }

    public fn lower_type(self, type_id: i32) -> rawptr {
        if (self.type_is_option_abi(type_id)) { return self.get_or_create_option_ty(type_id); }
        if (self.type_is_result_abi(type_id)) { return self.get_or_create_result_ty(type_id); }
        let raw_kind = llvm_mir_type_kind(&self.m, type_id);
        if (raw_kind == ty_RAWPTR()) { return self.ty_ptr; }
        if (raw_kind == ty_PTR() || raw_kind == ty_REF() || raw_kind == ty_MUTREF()) {
            return self.get_or_create_pointer_handle_ty();
        }
        let canonical_type = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical_type);
        if (kind == ty_VOID()) { return self.ty_void; }
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return self.ty_i8; }
        if (kind == ty_I16() || kind == ty_U16()) { return self.ty_i16; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32()) { return self.ty_i32; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()) { return self.ty_i64; }
        if (kind == ty_F32()) { return vyx_rt_float_type(self.mod, 32); }
        if (kind == ty_F64()) { return vyx_rt_float_type(self.mod, 64); }
        if (kind == ty_RAWPTR()) { return self.ty_ptr; }
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            return self.get_or_create_pointer_handle_ty();
        }
        if (kind == ty_FN() || kind == ty_CFN()) { return self.ty_ptr; }
        if (kind == ty_STRING()) { return self.get_string_ty(); }
        if (kind == ty_TUPLE()) { return self.get_or_create_tuple_ty(canonical_type); }
        if (kind == ty_ARRAY()) {
            let cached_arr = llvm_mir_map_get(self.type_struct_values, canonical_type);
            if (cached_arr != null) { return cached_arr; }
            let elem = hir_type_table_elem(self.m.types, canonical_type);
            let count = self.array_length_for_type(canonical_type);
            if (elem == mir_id_invalid() || count < 0) {
                self.report_error("array type has no concrete length: " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            let elem_ty = self.lower_type(elem);
            if (elem_ty == null) {
                self.report_error("cannot lower array element type for " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            let array_ty = vyx_rt_array_ty(self.mod, elem_ty, count as u64);
            if (array_ty == null) {
                self.report_error("cannot create LLVM array type for " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            llvm_mir_map_put(self.type_struct_values, canonical_type, array_ty);
            return array_ty;
        }
        if (kind == ty_CLASS()) {
            let text = llvm_mir_type_text(&self.m, canonical_type);
            if (llvm_mir_is_primitive_str_name(text)) { return self.get_string_ty(); }
            if (self.type_is_dyn_trait(canonical_type)) { return self.get_or_create_dyn_trait_ty(canonical_type); }
            if (self.type_is_option_abi(canonical_type)) { return self.get_or_create_option_ty(canonical_type); }
            if (self.type_is_result_abi(canonical_type)) { return self.get_or_create_result_ty(canonical_type); }
            if (mir_unit_variant_count_for_type(&self.m, canonical_type) > 0
                && mir_unit_field_count_for_type(&self.m, canonical_type) == 0) {
                return self.get_or_create_enum_ty(canonical_type);
            }
            if (self.type_is_class_pointer_abi(canonical_type)) {
                return self.ty_ptr;
            }
            if (self.type_is_value_struct_abi(canonical_type)) {
                return self.get_or_create_record_ty(canonical_type);
            }
            return self.ty_ptr;
        }
        return self.ty_ptr;
    }

    public fn get_string_ty(self) -> rawptr {
        if (self.string_ty != null) { return self.string_ty; }
        let st = vyx_rt_struct_ty_named(self.mod, "__String".c_str(), 8);
        if (st == null) {
            self.report_error("cannot create str ABI type");
            return null;
        }
        let fields = malloc(32);
        if (fields == null) {
            self.report_error("cannot allocate str ABI field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_i64);
        ast_write_rawptr(ptr_offset(fields, 16), self.ty_i64);
        ast_write_rawptr(ptr_offset(fields, 24), self.ty_i64);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 4, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize str ABI type");
            return null;
        }
        free(fields);
        self.string_ty = st;
        return st;
    }

    public fn get_or_create_closure_fat_ty(self) -> rawptr {
        if (self.closure_fat_ty != null) { return self.closure_fat_ty; }
        let name = "__VyxClosureFat";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create closure fat type");
            return null;
        }
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate closure fat field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize closure fat type");
            return null;
        }
        free(fields);
        self.closure_fat_ty = st;
        return st;
    }

    public fn pair_bool_cache_get(self, table: rawptr, lhs: i32, rhs: i32) -> i32 {
        if (table == null || lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return 0; }
        let head = llvm_mir_map_get(table, lhs);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == rhs) { return ast_read_i32(ptr_offset(cur, 4)); }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return 0;
    }

    public fn pair_bool_cache_put(self, table: rawptr, lhs: i32, rhs: i32, state: i32) {
        if (table == null || lhs == mir_id_invalid() || rhs == mir_id_invalid() || state == 0) { return; }
        let head = llvm_mir_map_get(table, lhs);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == rhs) {
                ast_write_i32(ptr_offset(cur, 4), state);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let node = malloc(16);
        if (node == null) { return; }
        ast_write_i32(node, rhs);
        ast_write_i32(ptr_offset(node, 4), state);
        ast_write_rawptr(ptr_offset(node, 8), head);
        llvm_mir_map_put(table, lhs, node);
    }

    public fn type_ids_compatible(self, lhs: i32, rhs: i32) -> bool {
        if (lhs == rhs) { return true; }
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return false; }
        let cached = self.pair_bool_cache_get(self.type_compat_cache, lhs, rhs);
        if (cached != 0) { return cached == 2; }
        let lhs_text = llvm_mir_type_text(&self.m, lhs);
        let rhs_text = llvm_mir_type_text(&self.m, rhs);
        var result = lhs_text == rhs_text;
        if (!result && self.dci_type_derives_from(rhs, lhs)) { result = true; }
        if (!result && self.type_text_equivalent(lhs_text, rhs_text)) { result = true; }
        var state: i32 = 1;
        if (result) { state = 2; }
        self.pair_bool_cache_put(self.type_compat_cache, lhs, rhs, state);
        return result;
    }

    public fn type_uses_closed_template_record_layout(self,
                                                      concrete_type_id: i32,
                                                      template_type_id: i32) -> bool {
        if (concrete_type_id == mir_id_invalid() || template_type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, concrete_type_id) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, template_type_id) != ty_CLASS()) {
            return false;
        }
        if (!self.record_layout_fields_are_closed(template_type_id)) { return false; }
        let concrete_text = llvm_mir_type_text(&self.m, concrete_type_id);
        let template_text = llvm_mir_type_text(&self.m, template_type_id);
        if (concrete_text.len == 0 || template_text.len == 0) { return false; }
        if (policy_generic_call_has_args(concrete_text.clone()) == 0) { return false; }
        if (policy_generic_call_has_args(template_text.clone()) != 0) { return false; }
        let concrete_base = policy_generic_call_base(concrete_text.clone());
        return self.type_text_equivalent(concrete_base, template_text);
    }

    public fn field_owner_accepts_base_type(self, field_owner_type: i32, base_type_id: i32) -> bool {
        if (field_owner_type == mir_id_invalid() || base_type_id == mir_id_invalid()) { return false; }
        let cached = self.pair_bool_cache_get(self.field_owner_accept_cache, field_owner_type, base_type_id);
        if (cached != 0) { return cached == 2; }
        var result = false;
        if (self.type_ids_compatible(field_owner_type, base_type_id)) { result = true; }
        let canonical_owner = self.canonical_record_type_id(field_owner_type);
        let canonical_base = self.canonical_record_type_id(base_type_id);
        if (!result && self.type_ids_compatible(canonical_owner, canonical_base)) { result = true; }
        if (!result && self.record_layout_prefix_compatible(canonical_base, canonical_owner)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(base_type_id, field_owner_type)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(base_type_id, canonical_owner)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(canonical_base, canonical_owner)) { result = true; }
        var state: i32 = 1;
        if (result) { state = 2; }
        self.pair_bool_cache_put(self.field_owner_accept_cache, field_owner_type, base_type_id, state);
        return result;
    }

    public fn exact_field_id_for_type_name(self, type_id: i32, field_name: string) -> i32 {
        if (type_id == mir_id_invalid() || field_name.len == 0) { return mir_id_invalid(); }
        var found = mir_id_invalid();
        var field_id: i32 = 1;
        while (field_id <= self.m.field_count) {
            if (mir_unit_field_owner_type(&self.m, field_id) == type_id
                && mir_unit_field_name(&self.m, field_id) == field_name) {
                // Versioned layouts keep historical FieldIds alive.  The
                // later matching record belongs to the canonical/current
                // layout and therefore carries the correct current slot.
                found = field_id;
            }
            field_id = field_id + 1;
        }
        return found;
    }

    public fn resolve_field_for_base_type(self, base_type_id: i32, field_id: i32) -> i32 {
        if (base_type_id == mir_id_invalid() || field_id == mir_id_invalid()) { return mir_id_invalid(); }
        let field_name = mir_unit_field_name(&self.m, field_id);
        if (field_name.len == 0) { return field_id; }
        let exact_base = self.exact_field_id_for_type_name(base_type_id, field_name);
        if (exact_base != mir_id_invalid()) { return exact_base; }
        let canonical_base = self.canonical_record_type_id(base_type_id);
        let exact_canonical = self.exact_field_id_for_type_name(canonical_base, field_name);
        if (exact_canonical != mir_id_invalid()) { return exact_canonical; }
        let owner_type = mir_unit_field_owner_type(&self.m, field_id);
        if (self.field_owner_accepts_base_type(owner_type, base_type_id)
            || self.field_owner_accepts_base_type(owner_type, canonical_base)) {
            return field_id;
        }
        return mir_id_invalid();
    }

    // Cached front-end for resolve_field_for_base_type. Field remapping is a
    // pure function of (base_type_id, field_id) over immutable unit tables and
    // is queried per lowered instruction, so memoize it: the cache is indexed
    // by field_id and each entry is a small chain of
    // { base_type_id: i32, mapped_field_id: i32, next: ptr } nodes.
    public fn remapped_field_for_base(self, base_type_id: i32, field_id: i32) -> i32 {
        if (base_type_id == mir_id_invalid() || field_id == mir_id_invalid()) { return mir_id_invalid(); }
        let head = llvm_mir_map_get(self.field_remap_cache, field_id);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == base_type_id) { return ast_read_i32(ptr_offset(cur, 4)); }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let mapped = self.resolve_field_for_base_type(base_type_id, field_id);
        let node = malloc(16);
        if (node != null) {
            ast_write_i32(node, base_type_id);
            ast_write_i32(ptr_offset(node, 4), mapped);
            ast_write_rawptr(ptr_offset(node, 8), head);
            llvm_mir_map_put(self.field_remap_cache, field_id, node);
        }
        return mapped;
    }

    // Pure-type twin of lower_place_addr's field mapping pipeline: refine the
    // base place type, remap the FieldId onto it, apply the heap-indirect
    // rebase, then remap once more against the canonical layout. Emits no IR,
    // so place_effective_type can use it to answer type queries for
    // multi-level field chains (a.b.c) without touching codegen state.
    public fn mapped_field_id_for_place(self, place_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.place_kind(place_id) != mir_place_field()) { return mir_id_invalid(); }
        var field_id = self.m.place_field(place_id);
        if (field_id == mir_id_invalid()) { return mir_id_invalid(); }
        var field_base_type = self.place_effective_type(self.m.place_base(place_id));
        if (field_base_type == mir_id_invalid()) { return field_id; }
        let mapped = self.remapped_field_for_base(field_base_type, field_id);
        if (mapped != mir_id_invalid()) { field_id = mapped; }
        let field_owner_type = mir_unit_field_owner_type(&self.m, field_id);
        if (field_owner_type != mir_id_invalid()
            && !self.field_owner_accepts_base_type(field_owner_type, field_base_type)) {
            if (!self.heap_indirect_payload_matches(field_base_type, field_owner_type)) {
                return field_id;
            }
            field_base_type = field_owner_type;
        }
        let canonical_base = self.canonical_record_type_id(field_base_type);
        let mapped2 = self.remapped_field_for_base(canonical_base, field_id);
        if (mapped2 != mir_id_invalid()) { return mapped2; }
        return field_id;
    }

    public fn record_layout_prefix_compatible(self, derived_type_id: i32, prefix_type_id: i32) -> bool {
        if (derived_type_id == mir_id_invalid() || prefix_type_id == mir_id_invalid()) { return false; }
        let derived_type = self.canonical_record_type_id(derived_type_id);
        let prefix_type = self.canonical_record_type_id(prefix_type_id);
        if (self.type_ids_compatible(derived_type, prefix_type)) { return true; }
        if (llvm_mir_type_kind(&self.m, derived_type) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, prefix_type) != ty_CLASS()) {
            return false;
        }
        let derived_count = mir_unit_field_count_for_type(&self.m, derived_type);
        let prefix_count = mir_unit_field_count_for_type(&self.m, prefix_type);
        if (derived_count <= 0 || prefix_count <= 0 || prefix_count > derived_count) { return false; }
        var idx: i32 = 0;
        while (idx < prefix_count) {
            let derived_field = mir_unit_field_id_for_type_index(&self.m, derived_type, idx);
            let prefix_field = mir_unit_field_id_for_type_index(&self.m, prefix_type, idx);
            if (derived_field == mir_id_invalid() || prefix_field == mir_id_invalid()) { return false; }
            if (mir_unit_field_name(&self.m, derived_field) != mir_unit_field_name(&self.m, prefix_field)) {
                return false;
            }
            if (!self.type_ids_compatible(mir_unit_field_type(&self.m, derived_field),
                                          mir_unit_field_type(&self.m, prefix_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn record_layout_fields_match_at(self,
                                            derived_type: i32,
                                            start: i32,
                                            prefix_type: i32,
                                            prefix_count: i32) -> bool {
        if (derived_type == mir_id_invalid() || prefix_type == mir_id_invalid() || start < 0 || prefix_count <= 0) {
            return false;
        }
        var idx: i32 = 0;
        while (idx < prefix_count) {
            let derived_field = mir_unit_field_id_for_type_index(&self.m, derived_type, start + idx);
            let prefix_field = mir_unit_field_id_for_type_index(&self.m, prefix_type, idx);
            if (derived_field == mir_id_invalid() || prefix_field == mir_id_invalid()) { return false; }
            if (mir_unit_field_name(&self.m, derived_field) != mir_unit_field_name(&self.m, prefix_field)) {
                return false;
            }
            if (!self.type_ids_compatible(mir_unit_field_type(&self.m, derived_field),
                                          mir_unit_field_type(&self.m, prefix_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn record_layout_subobject_field_index(self, derived_type_id: i32, prefix_type_id: i32) -> i32 {
        if (derived_type_id == mir_id_invalid() || prefix_type_id == mir_id_invalid()) { return -1; }
        let derived_type = self.canonical_record_type_id(derived_type_id);
        let prefix_type = self.canonical_record_type_id(prefix_type_id);
        if (self.type_ids_compatible(derived_type, prefix_type)) { return 0; }
        if (llvm_mir_type_kind(&self.m, derived_type) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, prefix_type) != ty_CLASS()) {
            return -1;
        }
        let derived_count = mir_unit_field_count_for_type(&self.m, derived_type);
        let prefix_count = mir_unit_field_count_for_type(&self.m, prefix_type);
        if (prefix_count <= 0 || derived_count <= 0 || prefix_count > derived_count) { return -1; }
        var found: i32 = -1;
        var start: i32 = 0;
        while (start + prefix_count <= derived_count) {
            if (self.record_layout_fields_match_at(derived_type, start, prefix_type, prefix_count)) {
                if (found >= 0) { return -1; }
                found = start;
            }
            start = start + 1;
        }
        return found;
    }

    public fn receiver_type_can_use_method_self_type(self, receiver_type_id: i32, method_self_type_id: i32) -> bool {
        if (receiver_type_id == mir_id_invalid() || method_self_type_id == mir_id_invalid()) { return false; }
        if (self.type_ids_compatible(receiver_type_id, method_self_type_id)) { return true; }
        if (self.dci_type_derives_from(receiver_type_id, method_self_type_id)) { return true; }
        if (self.record_layout_prefix_compatible(receiver_type_id, method_self_type_id)) { return true; }
        return self.record_layout_subobject_field_index(receiver_type_id, method_self_type_id) >= 0;
    }

    public fn receiver_method_specificity(self, receiver_type_id: i32, function_id: i32) -> i32 {
        if (receiver_type_id == mir_id_invalid() || function_id == mir_id_invalid()) { return 0; }
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type_id);
        if (receiver_text.len > 0 && self.m.function_owner_type(function_id) == receiver_text) {
            return 3;
        }
        let first_local = self.function_source_param_local(function_id, 0);
        if (first_local == mir_id_invalid()) { return 0; }
        let self_type = self.m.local_type(first_local);
        if (self.type_ids_compatible(receiver_type_id, self_type)) { return 3; }
        if (self.dci_type_derives_from(receiver_type_id, self_type)) { return 1; }
        if (self.record_layout_prefix_compatible(receiver_type_id, self_type)) { return 1; }
        if (self.record_layout_subobject_field_index(receiver_type_id, self_type) >= 0) { return 1; }
        return 0;
    }

    public fn executable_method_for_receiver_type(self, receiver_type_id: i32, method_name: string) -> i32 {
        if (receiver_type_id == mir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type_id);
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        var best_match = mir_id_invalid();
        var best_exact: i32 = 0;
        var best_specificity: i32 = 0;
        var cur = self.method_candidate_head(method_name);
        while (cur != null) {
            let fn_id = ast_read_i32(cur);
            if (self.function_has_callable_body_or_import(fn_id)
                && self.function_name_matches_method(self.m.function_name(fn_id), method_name)) {
                let specificity = self.receiver_method_specificity(receiver_type_id, fn_id);
                let self_type = self.function_source_param_type(fn_id, 0);
                let exact = ((self_type != mir_id_invalid()
                              && self_type == receiver_type_id)
                             || llvm_mir_type_text(&self.m, self_type) == receiver_text) as i32;
                if (specificity > best_specificity
                    || (specificity == best_specificity && exact > best_exact)) {
                    best_match = fn_id;
                    best_specificity = specificity;
                    best_exact = exact;
                } else if (specificity == best_specificity
                    && exact == best_exact
                    && best_match != mir_id_invalid()
                    && self.function_has_callable_body_or_import(fn_id)
                    && !self.function_has_callable_body_or_import(best_match)) {
                    best_match = fn_id;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return best_match;
    }
}
