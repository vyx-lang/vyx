            self.builtin_remove_fty = vyx_rt_fn_type(self.mod, self.ty_i32, remove_params, 1, 0);
            self.builtin_remove_fn = vyx_rt_add_function(self.mod, "remove".c_str(), 6, self.builtin_remove_fty);
            free(remove_params);
        } else {
            self.report_error("cannot allocate remove signature");
        }
        let rename_params = malloc(16);
        if (rename_params != null) {
            ast_write_rawptr(rename_params, self.ty_ptr);
            ast_write_rawptr(ptr_offset(rename_params, 8), self.ty_ptr);
            self.builtin_rename_fty = vyx_rt_fn_type(self.mod, self.ty_i32, rename_params, 2, 0);
            self.builtin_rename_fn = vyx_rt_add_function(self.mod, "rename".c_str(), 6, self.builtin_rename_fty);
            free(rename_params);
        } else {
            self.report_error("cannot allocate rename signature");
        }
        if (!self.apply_integer_string_runtime_attrs()
            || !self.apply_readonly_runtime_attrs()
            || !self.apply_pointer_runtime_attrs()) { return; }
    }

    // Semantic attributes for the pointer-region runtime ABI.  These mirror
    // the implementation contracts in rt_pointer_*: region metadata blocks are
    // dedicated runtime allocations disjoint from user storage, the queries
    // never retain their arguments, and creation/registration calls return
    // freshly created blocks.  Without these facts LLVM must assume a `*T`
    // payload store may alias the region header, which pins every inline
    // bounds-check load inside loops.  Keep this list narrow: each attribute
    // states an implementation-level contract of the checked-in runtime.
    public fn apply_pointer_runtime_attrs(self) -> bool {
        // Region metadata is its own allocation family: the metadata block
        // returned by create/retag never overlaps user storage, and queries do
        // not capture their arguments.
        if (!self.apply_known_runtime_function_attr(self.pointer_region_create_fn,
                                                    "vyx_pointer_region_create",
                                                    "nounwind")
            || !self.apply_known_runtime_return_attr(self.pointer_region_create_fn,
                                                      "vyx_pointer_region_create",
                                                      "noalias")
            || !self.apply_known_runtime_return_attr(self.pointer_region_create_fn,
                                                      "vyx_pointer_region_create",
                                                      "nonnull")
            || !self.apply_known_runtime_param_attr(self.pointer_region_create_fn,
                                                     "vyx_pointer_region_create",
                                                     0,
                                                     "noalias")) {
            return false;
        }
        if (!self.apply_known_runtime_param_attr(self.pointer_region_retag_fn,
                                                  "vyx_pointer_region_retag",
                                                  0,
                                                  "captures(none)")) {
            return false;
        }
        if (!self.apply_known_runtime_function_attr(self.pointer_region_rank_fn,
                                                     "vyx_pointer_region_rank",
                                                     "readonly")
            || !self.apply_known_runtime_function_attr(self.pointer_region_rank_fn,
                                                       "vyx_pointer_region_rank",
                                                       "nounwind")
            || !self.apply_known_runtime_param_attr(self.pointer_region_rank_fn,
                                                     "vyx_pointer_region_rank",
                                                     0,
                                                     "readonly")
            || !self.apply_known_runtime_param_attr(self.pointer_region_rank_fn,
                                                     "vyx_pointer_region_rank",
                                                     0,
                                                     "captures(none)")) {
            return false;
        }
        return self.apply_known_runtime_function_attr(self.pointer_handle_alive_fn,
                                                       "vyx_pointer_handle_alive",
                                                       "nounwind")
            && self.apply_known_runtime_function_attr(self.pointer_handle_alive_fn,
                                                       "vyx_pointer_handle_alive",
                                                       "readonly");
    }

    public fn declare_main_arg_globals(self) -> bool {
        if (self.runtime_argc_global == null) {
            let argc_name = "_vyx_argc";
            self.runtime_argc_global = vyx_rt_add_global(self.mod,
                                                         self.ty_i32,
                                                         argc_name.c_str(),
                                                         argc_name.len as u64);
            if (self.runtime_argc_global == null) {
                self.report_error("cannot declare argc runtime global");
                return false;
            }
            vyx_rt_set_initializer(self.mod,
                                   self.runtime_argc_global,
                                   vyx_rt_const_int(self.mod, self.ty_i32, 0, 0));
            vyx_rt_set_linkage(self.mod, self.runtime_argc_global, 1);
        }
        if (self.runtime_argv_global == null) {
            let argv_name = "_vyx_argv";
            self.runtime_argv_global = vyx_rt_add_global(self.mod,
                                                         self.ty_ptr,
                                                         argv_name.c_str(),
                                                         argv_name.len as u64);
            if (self.runtime_argv_global == null) {
                self.report_error("cannot declare argv runtime global");
                return false;
            }
            vyx_rt_set_initializer(self.mod,
                                   self.runtime_argv_global,
                                   vyx_rt_const_ptr_null(self.mod, self.ty_ptr));
            vyx_rt_set_linkage(self.mod, self.runtime_argv_global, 1);
        }
        return true;
    }

    public fn emit_arg_count_helper_body(self) -> bool {
        if (self.builtin_arg_count_fn == null || self.builtin_arg_count_fty == null) {
            self.report_error("cannot define argc helper without declaration");
            return false;
        }
        let entry_name = "_vyx_get_argc_internal.entry";
        let bb = vyx_rt_append_block(self.mod,
                                     self.builtin_arg_count_fn,
                                     entry_name.c_str(),
                                     entry_name.len as u64);
        if (bb == null) {
            self.report_error("cannot create argc helper body");
            return false;
        }
        vyx_rt_position_at_end(self.mod, bb);
        var argc: rawptr = null;
        if (self.module_has_c_main_function()) {
            if (!self.declare_main_arg_globals()) { return false; }
            argc = vyx_rt_build_load(self.mod,
                                     self.ty_i32,
                                     self.runtime_argc_global,
                                     "argc".c_str(),
                                     4);
        } else {
            if (self.runtime_arg_count_fn == null || self.runtime_arg_count_fty == null) {
                self.report_error("cannot define argc helper without process runtime declaration");
                return false;
            }
            argc = vyx_rt_build_call(self.mod,
                                     self.runtime_arg_count_fty,
                                     self.runtime_arg_count_fn,
                                     null,
                                     0,
                                     "argc".c_str(),
                                     4);
        }
        if (argc == null) {
            self.report_error("cannot build argc helper result");
            return false;
        }
        vyx_rt_build_ret(self.mod, argc);
        return true;
    }

    public fn emit_get_arg_helper_body(self) -> bool {
        if (self.builtin_get_arg_fn == null || self.builtin_get_arg_fty == null) {
            self.report_error("cannot define getArg helper without declaration");
            return false;
        }
        let entry_name = "_vyx_get_arg_internal.entry";
        let bb = vyx_rt_append_block(self.mod,
                                     self.builtin_get_arg_fn,
                                     entry_name.c_str(),
                                     entry_name.len as u64);
        if (bb == null) {
            self.report_error("cannot create getArg helper body");
            return false;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let idx32 = vyx_rt_get_param(self.mod, self.builtin_get_arg_fn, 0);
        var cstr: rawptr = null;
        if (self.module_has_c_main_function()) {
            if (!self.declare_main_arg_globals()) { return false; }
            let argv = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         self.runtime_argv_global,
                                         "argv".c_str(),
                                         4);
            let idx64 = vyx_rt_build_sext(self.mod,
                                          idx32,
                                          self.ty_i64,
                                          "idx64".c_str(),
                                          5);
            let elem_ptr = vyx_rt_build_gep1(self.mod,
                                             self.ty_ptr,
                                             argv,
                                             idx64,
                                             "arg.ptr".c_str(),
                                             7);
            cstr = vyx_rt_build_load(self.mod,
                                     self.ty_ptr,
                                     elem_ptr,
                                     "arg.cstr".c_str(),
                                     8);
            if (argv == null || idx64 == null || elem_ptr == null || cstr == null) {
                self.report_error("cannot load argv runtime global");
                return false;
            }
        } else {
            if (self.runtime_get_arg_cstr_fn == null || self.runtime_get_arg_cstr_fty == null) {
                self.report_error("cannot define getArg helper without process runtime declaration");
                return false;
            }
            cstr = vyx_rt_build_call1(self.mod,
                                      self.runtime_get_arg_cstr_fty,
                                      self.runtime_get_arg_cstr_fn,
                                      idx32,
                                      "arg.cstr".c_str(),
                                      8);
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       cstr,
                                       "arg.len".c_str(),
                                       7);
        let cap_v = len_v;
        let out = self.emit_string_value_from_parts(cstr,
                                                    len_v,
                                                    cap_v,
                                                    vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        if (idx32 == null || cstr == null || len_v == null || cap_v == null || out == null) {
            self.report_error("cannot build getArg helper body");
            return false;
        }
        vyx_rt_build_ret(self.mod, out);
        return true;
    }

    public fn module_has_c_main_function(self) -> bool {
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_uses_c_main_abi(fn_id)
                && self.function_should_emit(fn_id)) {
                return true;
            }
            fn_id = fn_id + 1;
        }
        return false;
    }

    public fn define_main_arg_runtime_helpers(self) {
        if (self.runtime_args_defined) { return; }
        // Device modules have no hosted process arguments. Skip both the
        // internal helpers and the host runtime declarations they reference.
        if (self.target_triple.contains("nvptx")) { return; }
        self.runtime_args_defined = true;
        if (self.module_has_c_main_function() && !self.declare_main_arg_globals()) { return; }
        if (!self.emit_arg_count_helper_body()) { return; }
        if (!self.emit_get_arg_helper_body()) { return; }
        self.runtime_args_defined = true;
    }

    public fn runtime_external_function_key(self, function_id: i32) -> string {
        if (!self.function_is_bodyless(function_id)) { return ""; }
        let name = self.m.function_name(function_id);
        let n = self.function_source_param_count(function_id);
        if (name == "vyx_get_argc"
            && n == 0
            && self.function_return_int_bits(function_id) == 32) { return "argCount"; }
        if (name == "vyx_get_arg"
            && n == 1
            && self.function_param_int_bits_at(function_id, 0) == 32
            && self.function_return_kind(function_id) == ty_STRING()) { return "getArg"; }
        if (name == "malloc"
            && n == 1
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "malloc"; }
        if (name == "free"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_is_void(function_id)) { return "free"; }
        if (name == "vyx_forget_string_len"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_is_void(function_id)) { return "vyx_forget_string_len"; }
        if (name == "vyx_free_runtime_string"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_is_void(function_id)) { return "vyx_free_runtime_string"; }
        if (name == "vyx_free_pooled_string"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_is_void(function_id)) { return "vyx_free_pooled_string"; }
        // String.append{I64,U64} uses this decimal ABI directly.  Bind source
        // extern declarations to the canonical runtime declarations so LLVM
        // never emits a second `symbol.N` declaration with the same C ABI.
        // The latter is especially important for JIT, where only the canonical
        // runtime symbol exists in the process symbol table.
        if (name == "vyx_int_decimal_len_abi"
            && n == 1
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_return_int_bits(function_id) == 64) { return "vyx_int_decimal_len_abi"; }
        if (name == "vyx_uint_decimal_len_abi"
            && n == 1
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_return_int_bits(function_id) == 64) { return "vyx_uint_decimal_len_abi"; }
        if (name == "vyx_int_to_string_into_abi"
            && n == 2
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_int_bits(function_id) == 64) { return "vyx_int_to_string_into_abi"; }
        if (name == "vyx_uint_to_string_into_abi"
            && n == 2
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_int_bits(function_id) == 64) { return "vyx_uint_to_string_into_abi"; }
        if (name == "realloc"
            && n == 2
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "realloc"; }
        if (name == "memcpy"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "memcpy"; }
        if (name == "memmove"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "memmove"; }
        if (name == "memset"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 32
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "memset"; }
        if (name == "memcmp"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_return_int_bits(function_id) == 32) { return "memcmp"; }
        if (name == "strlen"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 64) { return "strlen"; }
        if (name == "strcmp"
            && n == 2
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_int_bits(function_id) == 32) { return "strcmp"; }
        if (name == "strncmp"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_return_int_bits(function_id) == 32) { return "strncmp"; }
        if (name == "strstr"
            && n == 2
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_is_pointer_abi(function_id)) { return "strstr"; }
        if (name == "abort"
            && n == 0
            && self.function_return_is_void(function_id)) { return "abort"; }
        if (name == "printf"
            && n >= 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "printf"; }
        if (name == "snprintf"
            && n >= 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_param_is_pointer_abi(function_id, 2)
            && self.function_return_int_bits(function_id) == 32) { return "snprintf"; }
        if (name == "GetFileAttributesA"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "GetFileAttributesA"; }
        if (name == "calloc"
            && n == 2
            && self.function_param_int_bits_at(function_id, 0) == 64
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_return_is_pointer_abi(function_id)) { return "calloc"; }
        if (name == "fopen"
            && n == 2
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_is_pointer_abi(function_id)) { return "fopen"; }
        if (name == "fclose"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "fclose"; }
        if (name == "fread"
            && n == 4
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_param_is_pointer_abi(function_id, 3)
            && self.function_return_int_bits(function_id) == 64) { return "fread"; }
        if (name == "fwrite"
            && n == 4
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_param_int_bits_at(function_id, 2) == 64
            && self.function_param_is_pointer_abi(function_id, 3)
            && self.function_return_int_bits(function_id) == 64) { return "fwrite"; }
        if (name == "fgetc"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "fgetc"; }
        if (name == "fputc"
            && n == 2
            && self.function_param_int_bits_at(function_id, 0) == 32
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_int_bits(function_id) == 32) { return "fputc"; }
        if (name == "feof"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "feof"; }
        if (name == "fseek"
            && n == 3
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_int_bits_at(function_id, 1) == 64
            && self.function_param_int_bits_at(function_id, 2) == 32
            && self.function_return_int_bits(function_id) == 32) { return "fseek"; }
        if (name == "ftell"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 64) { return "ftell"; }
        if (name == "remove"
            && n == 1
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_return_int_bits(function_id) == 32) { return "remove"; }
        if (name == "rename"
            && n == 2
            && self.function_param_is_pointer_abi(function_id, 0)
            && self.function_param_is_pointer_abi(function_id, 1)
            && self.function_return_int_bits(function_id) == 32) { return "rename"; }
        return "";
    }

    public fn runtime_external_function_value(self, key: string) -> rawptr {
        if (key == "argCount") { return self.builtin_arg_count_fn; }
        if (key == "getArg") { return self.builtin_get_arg_fn; }
        if (key == "malloc") { return self.builtin_malloc_fn; }
        if (key == "free") { return self.builtin_free_fn; }
        if (key == "vyx_forget_string_len") { return self.builtin_forget_string_len_fn; }
        if (key == "vyx_free_runtime_string") { return self.builtin_runtime_string_free_fn; }
        if (key == "vyx_free_pooled_string") { return self.builtin_pooled_string_free_fn; }
        if (key == "vyx_int_decimal_len_abi") { return self.builtin_int_decimal_len_fn; }
        if (key == "vyx_uint_decimal_len_abi") { return self.builtin_uint_decimal_len_fn; }
        if (key == "vyx_int_to_string_into_abi") { return self.builtin_int_to_string_into_fn; }
        if (key == "vyx_uint_to_string_into_abi") { return self.builtin_uint_to_string_into_fn; }
        if (key == "realloc") { return self.builtin_realloc_fn; }
        if (key == "memcpy") { return self.builtin_memcpy_fn; }
        if (key == "memmove") { return self.builtin_memmove_fn; }
        if (key == "memset") { return self.builtin_memset_fn; }
        if (key == "memcmp") { return self.builtin_memcmp_fn; }
        if (key == "strlen") { return self.builtin_strlen_fn; }
        if (key == "strcmp") { return self.builtin_strcmp_fn; }
        if (key == "strncmp") { return self.builtin_strncmp_fn; }
        if (key == "strstr") { return self.builtin_strstr_fn; }
        if (key == "vyx_string_contains") { return self.builtin_string_contains_fn; }
        if (key == "vyx_string_index_of") { return self.builtin_string_index_of_fn; }
        if (key == "abort") { return self.builtin_abort_fn; }
        if (key == "exit") { return self.builtin_exit_fn; }
        if (key == "printf") { return self.builtin_printf_fn; }
        if (key == "snprintf") { return self.builtin_snprintf_fn; }
        if (key == "GetFileAttributesA") { return self.builtin_get_file_attrs_fn; }
        if (key == "calloc") { return self.builtin_calloc_fn; }
        if (key == "fopen") { return self.builtin_fopen_fn; }
        if (key == "fclose") { return self.builtin_fclose_fn; }
        if (key == "fread") { return self.builtin_fread_fn; }
        if (key == "fwrite") { return self.builtin_fwrite_fn; }
        if (key == "fgetc") { return self.builtin_fgetc_fn; }
        if (key == "fputc") { return self.builtin_fputc_fn; }
        if (key == "feof") { return self.builtin_feof_fn; }
        if (key == "fseek") { return self.builtin_fseek_fn; }
        if (key == "ftell") { return self.builtin_ftell_fn; }
        if (key == "remove") { return self.builtin_remove_fn; }
        if (key == "rename") { return self.builtin_rename_fn; }
        return null;
    }

    public fn runtime_external_function_type(self, key: string) -> rawptr {
        if (key == "argCount") { return self.builtin_arg_count_fty; }
        if (key == "getArg") { return self.builtin_get_arg_fty; }
        if (key == "malloc") { return self.builtin_malloc_fty; }
        if (key == "free") { return self.builtin_free_fty; }
        if (key == "vyx_forget_string_len") { return self.builtin_forget_string_len_fty; }
        if (key == "vyx_free_runtime_string") { return self.builtin_runtime_string_free_fty; }
        if (key == "vyx_free_pooled_string") { return self.builtin_pooled_string_free_fty; }
        if (key == "vyx_int_decimal_len_abi") { return self.builtin_int_decimal_len_fty; }
        if (key == "vyx_uint_decimal_len_abi") { return self.builtin_uint_decimal_len_fty; }
        if (key == "vyx_int_to_string_into_abi") { return self.builtin_int_to_string_into_fty; }
        if (key == "vyx_uint_to_string_into_abi") { return self.builtin_uint_to_string_into_fty; }
        if (key == "realloc") { return self.builtin_realloc_fty; }
        if (key == "memcpy") { return self.builtin_memcpy_fty; }
        if (key == "memmove") { return self.builtin_memmove_fty; }
        if (key == "memset") { return self.builtin_memset_fty; }
        if (key == "memcmp") { return self.builtin_memcmp_fty; }
        if (key == "strlen") { return self.builtin_strlen_fty; }
        if (key == "strcmp") { return self.builtin_strcmp_fty; }
        if (key == "strncmp") { return self.builtin_strncmp_fty; }
        if (key == "strstr") { return self.builtin_strstr_fty; }
        if (key == "vyx_string_contains") { return self.builtin_string_contains_fty; }
        if (key == "vyx_string_index_of") { return self.builtin_string_index_of_fty; }
        if (key == "abort") { return self.builtin_abort_fty; }
        if (key == "exit") { return self.builtin_exit_fty; }
        if (key == "printf") { return self.builtin_printf_fty; }
        if (key == "snprintf") { return self.builtin_snprintf_fty; }
        if (key == "GetFileAttributesA") { return self.builtin_get_file_attrs_fty; }
        if (key == "calloc") { return self.builtin_calloc_fty; }
        if (key == "fopen") { return self.builtin_fopen_fty; }
        if (key == "fclose") { return self.builtin_fclose_fty; }
        if (key == "fread") { return self.builtin_fread_fty; }
        if (key == "fwrite") { return self.builtin_fwrite_fty; }
        if (key == "fgetc") { return self.builtin_fgetc_fty; }
        if (key == "fputc") { return self.builtin_fputc_fty; }
        if (key == "feof") { return self.builtin_feof_fty; }
        if (key == "fseek") { return self.builtin_fseek_fty; }
        if (key == "ftell") { return self.builtin_ftell_fty; }
        if (key == "remove") { return self.builtin_remove_fty; }
        if (key == "rename") { return self.builtin_rename_fty; }
        return null;
    }

    public fn bind_runtime_external_function(self, function_id: i32) -> bool {
        let key = self.runtime_external_function_key(function_id);
        if (key.len == 0) { return false; }
        let f = self.runtime_external_function_value(key);
        let fty = self.runtime_external_function_type(key);
        if (f == null || fty == null) {
            self.report_error("runtime external declaration is unavailable for " + key);
            return true;
        }
        llvm_mir_map_put(self.function_values, function_id, f);
        llvm_mir_map_put(self.function_types, function_id, fty);
        self.remember_declared_function_symbol(function_id, self.function_symbol_name(function_id));
        return true;
    }
}
