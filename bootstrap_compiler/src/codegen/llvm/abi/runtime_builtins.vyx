module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn apply_known_runtime_function_attr(self,
                                                fn_value: rawptr,
                                                symbol: string,
                                                attr: string) -> bool {
        if (fn_value == null) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_function_attr(self.mod,
                                     fn_value,
                                     attr.c_str(),
                                     attr.len as u64,
                                     null,
                                     0) != 0) {
            self.report_error("cannot apply runtime attribute `" + attr + "` to `"
                              + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_known_runtime_return_attr(self,
                                               fn_value: rawptr,
                                               symbol: string,
                                               attr: string) -> bool {
        if (fn_value == null) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_return_attr(self.mod,
                                   fn_value,
                                   attr.c_str(),
                                   attr.len as u64) != 0) {
            self.report_error("cannot apply runtime return attribute `" + attr
                              + "` to `" + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_known_runtime_param_attr(self,
                                             fn_value: rawptr,
                                             symbol: string,
                                             param_index: i32,
                                             attr: string) -> bool {
        if (fn_value == null || param_index < 0) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_param_abi_attr(self.mod,
                                      fn_value,
                                      param_index as u64,
                                      attr.c_str(),
                                      attr.len as u64,
                                      null,
                                      0) != 0) {
            self.report_error("cannot apply runtime parameter attribute `" + attr
                              + "` to `" + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_integer_string_runtime_attrs(self) -> bool {
        if (!self.apply_known_runtime_function_attr(self.builtin_int_decimal_len_fn,
                                                    "vyx_int_decimal_len_abi",
                                                    "readnone")
            || !self.apply_known_runtime_function_attr(self.builtin_int_decimal_len_fn,
                                                       "vyx_int_decimal_len_abi",
                                                       "nounwind")
            || !self.apply_known_runtime_function_attr(self.builtin_uint_decimal_len_fn,
                                                       "vyx_uint_decimal_len_abi",
                                                       "readnone")
            || !self.apply_known_runtime_function_attr(self.builtin_uint_decimal_len_fn,
                                                       "vyx_uint_decimal_len_abi",
                                                       "nounwind")) {
            return false;
        }

        if (!self.apply_known_runtime_function_attr(self.builtin_int_to_string_into_fn,
                                                    "vyx_int_to_string_into_abi",
                                                    "writeonly")
            || !self.apply_known_runtime_function_attr(self.builtin_int_to_string_into_fn,
                                                       "vyx_int_to_string_into_abi",
                                                       "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_int_to_string_into_fn,
                                                     "vyx_int_to_string_into_abi",
                                                     1,
                                                     "writeonly")
            || !self.apply_known_runtime_param_attr(self.builtin_int_to_string_into_fn,
                                                     "vyx_int_to_string_into_abi",
                                                     1,
                                                     "captures(none)")) {
            return false;
        }
        if (!self.apply_known_runtime_function_attr(self.builtin_uint_to_string_into_fn,
                                                    "vyx_uint_to_string_into_abi",
                                                    "writeonly")
            || !self.apply_known_runtime_function_attr(self.builtin_uint_to_string_into_fn,
                                                       "vyx_uint_to_string_into_abi",
                                                       "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_uint_to_string_into_fn,
                                                     "vyx_uint_to_string_into_abi",
                                                     1,
                                                     "writeonly")
            || !self.apply_known_runtime_param_attr(self.builtin_uint_to_string_into_fn,
                                                     "vyx_uint_to_string_into_abi",
                                                     1,
                                                     "captures(none)")) {
            return false;
        }

        if (!self.apply_known_runtime_function_attr(self.builtin_int_to_string_len_fn,
                                                    "int_to_string_len_abi",
                                                    "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_int_to_string_len_fn,
                                                     "int_to_string_len_abi",
                                                     1,
                                                     "writeonly")
            || !self.apply_known_runtime_param_attr(self.builtin_int_to_string_len_fn,
                                                     "int_to_string_len_abi",
                                                     1,
                                                     "captures(none)")) {
            return false;
        }
        return self.apply_known_runtime_function_attr(self.builtin_uint_to_string_len_fn,
                                                      "uint_to_string_len_abi",
                                                      "nounwind")
            && self.apply_known_runtime_param_attr(self.builtin_uint_to_string_len_fn,
                                                    "uint_to_string_len_abi",
                                                    1,
                                                    "writeonly")
            && self.apply_known_runtime_param_attr(self.builtin_uint_to_string_len_fn,
                                                    "uint_to_string_len_abi",
                                                    1,
                                                    "captures(none)");
    }

    // These declarations are read-only C queries with no retained pointer
    // state in their implementation contracts. Keep this list deliberately
    // narrow: allocators, I/O, mutable string helpers and foreign APIs remain
    // unannotated until their implementation-level contracts are audited.
    public fn apply_readonly_runtime_attrs(self) -> bool {
        if (!self.apply_known_runtime_function_attr(self.builtin_strlen_fn, "strlen", "readonly")
            || !self.apply_known_runtime_function_attr(self.builtin_strlen_fn, "strlen", "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_strlen_fn, "strlen", 0, "readonly")
            || !self.apply_known_runtime_param_attr(self.builtin_strlen_fn, "strlen", 0, "captures(none)")) {
            return false;
        }
        if (!self.apply_known_runtime_function_attr(self.builtin_strncmp_fn, "strncmp", "readonly")
            || !self.apply_known_runtime_function_attr(self.builtin_strncmp_fn, "strncmp", "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_strncmp_fn, "strncmp", 0, "readonly")
            || !self.apply_known_runtime_param_attr(self.builtin_strncmp_fn, "strncmp", 1, "readonly")
            || !self.apply_known_runtime_param_attr(self.builtin_strncmp_fn, "strncmp", 0, "captures(none)")
            || !self.apply_known_runtime_param_attr(self.builtin_strncmp_fn, "strncmp", 1, "captures(none)")) {
            return false;
        }
        if (!self.apply_known_runtime_function_attr(self.builtin_strcmp_fn, "strcmp", "readonly")
            || !self.apply_known_runtime_function_attr(self.builtin_strcmp_fn, "strcmp", "nounwind")
            || !self.apply_known_runtime_param_attr(self.builtin_strcmp_fn, "strcmp", 0, "readonly")
            || !self.apply_known_runtime_param_attr(self.builtin_strcmp_fn, "strcmp", 1, "readonly")
            || !self.apply_known_runtime_param_attr(self.builtin_strcmp_fn, "strcmp", 0, "captures(none)")
            || !self.apply_known_runtime_param_attr(self.builtin_strcmp_fn, "strcmp", 1, "captures(none)")) {
            return false;
        }
        return self.apply_known_runtime_function_attr(self.builtin_memcmp_fn, "memcmp", "readonly")
            && self.apply_known_runtime_function_attr(self.builtin_memcmp_fn, "memcmp", "nounwind")
            && self.apply_known_runtime_param_attr(self.builtin_memcmp_fn, "memcmp", 0, "readonly")
            && self.apply_known_runtime_param_attr(self.builtin_memcmp_fn, "memcmp", 1, "readonly")
            && self.apply_known_runtime_param_attr(self.builtin_memcmp_fn, "memcmp", 0, "captures(none)")
            && self.apply_known_runtime_param_attr(self.builtin_memcmp_fn, "memcmp", 1, "captures(none)");
    }

    public fn declare_runtime_builtins(self) {
        let print_params = malloc(16);
        if (print_params != null) {
            ast_write_rawptr(print_params, self.ty_ptr);
            ast_write_rawptr(ptr_offset(print_params, 8), self.ty_i64);
            self.builtin_print_fty = vyx_rt_fn_type(self.mod, self.ty_void, print_params, 2, 0);
            self.builtin_print_fn = vyx_rt_add_function(self.mod, "print".c_str(), 5, self.builtin_print_fty);
            self.builtin_println_fty = vyx_rt_fn_type(self.mod, self.ty_void, print_params, 2, 0);
            self.builtin_println_fn = vyx_rt_add_function(self.mod, "println".c_str(), 7, self.builtin_println_fty);
            free(print_params);
        }
        let printf_params = malloc(8);
        if (printf_params != null) {
            ast_write_rawptr(printf_params, self.ty_ptr);
            self.builtin_printf_fty = vyx_rt_fn_type(self.mod, self.ty_i32, printf_params, 1, 1);
            self.builtin_printf_fn = vyx_rt_add_function(self.mod, "printf".c_str(), 6, self.builtin_printf_fty);
            free(printf_params);
        }
        let snprintf_params = malloc(24);
        if (snprintf_params != null) {
            ast_write_rawptr(snprintf_params, self.ty_ptr);
            ast_write_rawptr(ptr_offset(snprintf_params, 8), self.ty_i64);
            ast_write_rawptr(ptr_offset(snprintf_params, 16), self.ty_ptr);
            self.builtin_snprintf_fty = vyx_rt_fn_type(self.mod, self.ty_i32, snprintf_params, 3, 1);
            self.builtin_snprintf_fn = vyx_rt_add_function(self.mod, "snprintf".c_str(), 8, self.builtin_snprintf_fty);
            free(snprintf_params);
        } else {
            self.report_error("cannot allocate snprintf signature");
        }
        let i64_params = malloc(8);
        if (i64_params != null) {
            ast_write_rawptr(i64_params, self.ty_i64);
            self.builtin_int_to_string_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, i64_params, 1, 0);
            self.builtin_int_to_string_fn = vyx_rt_add_function(self.mod, "int_to_string".c_str(), 13, self.builtin_int_to_string_fty);
            free(i64_params);
        }
        let u64_params = malloc(8);
        if (u64_params != null) {
            ast_write_rawptr(u64_params, self.ty_i64);
            self.builtin_uint_to_string_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, u64_params, 1, 0);
            self.builtin_uint_to_string_fn = vyx_rt_add_function(self.mod, "uint_to_string".c_str(), 14, self.builtin_uint_to_string_fty);
            free(u64_params);
        }
        let i64_len_params = malloc(16);
        if (i64_len_params != null) {
            ast_write_rawptr(i64_len_params, self.ty_i64);
            ast_write_rawptr(ptr_offset(i64_len_params, 8), self.ty_ptr);
            self.builtin_int_to_string_len_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, i64_len_params, 2, 0);
            self.builtin_int_to_string_len_fn = vyx_rt_add_function(self.mod, "int_to_string_len_abi".c_str(), 21, self.builtin_int_to_string_len_fty);
            free(i64_len_params);
        }
        let u64_len_params = malloc(16);
        if (u64_len_params != null) {
            ast_write_rawptr(u64_len_params, self.ty_i64);
            ast_write_rawptr(ptr_offset(u64_len_params, 8), self.ty_ptr);
            self.builtin_uint_to_string_len_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, u64_len_params, 2, 0);
            self.builtin_uint_to_string_len_fn = vyx_rt_add_function(self.mod, "uint_to_string_len_abi".c_str(), 22, self.builtin_uint_to_string_len_fty);
            free(u64_len_params);
        }
        let i64_decimal_params = malloc(8);
        if (i64_decimal_params != null) {
            ast_write_rawptr(i64_decimal_params, self.ty_i64);
            self.builtin_int_decimal_len_fty = vyx_rt_fn_type(self.mod, self.ty_i64, i64_decimal_params, 1, 0);
            self.builtin_int_decimal_len_fn = vyx_rt_add_function(self.mod,
                                                                  "vyx_int_decimal_len_abi".c_str(),
                                                                  23,
                                                                  self.builtin_int_decimal_len_fty);
            free(i64_decimal_params);
        }
        let u64_decimal_params = malloc(8);
        if (u64_decimal_params != null) {
            ast_write_rawptr(u64_decimal_params, self.ty_i64);
            self.builtin_uint_decimal_len_fty = vyx_rt_fn_type(self.mod, self.ty_i64, u64_decimal_params, 1, 0);
            self.builtin_uint_decimal_len_fn = vyx_rt_add_function(self.mod,
                                                                   "vyx_uint_decimal_len_abi".c_str(),
                                                                   24,
                                                                   self.builtin_uint_decimal_len_fty);
            free(u64_decimal_params);
        }
        let i64_into_params = malloc(16);
        if (i64_into_params != null) {
            ast_write_rawptr(i64_into_params, self.ty_i64);
            ast_write_rawptr(ptr_offset(i64_into_params, 8), self.ty_ptr);
            self.builtin_int_to_string_into_fty = vyx_rt_fn_type(self.mod, self.ty_i64, i64_into_params, 2, 0);
            self.builtin_int_to_string_into_fn = vyx_rt_add_function(self.mod,
                                                                     "vyx_int_to_string_into_abi".c_str(),
                                                                     26,
                                                                     self.builtin_int_to_string_into_fty);
            free(i64_into_params);
        }
        let u64_into_params = malloc(16);
        if (u64_into_params != null) {
            ast_write_rawptr(u64_into_params, self.ty_i64);
            ast_write_rawptr(ptr_offset(u64_into_params, 8), self.ty_ptr);
            self.builtin_uint_to_string_into_fty = vyx_rt_fn_type(self.mod, self.ty_i64, u64_into_params, 2, 0);
            self.builtin_uint_to_string_into_fn = vyx_rt_add_function(self.mod,
                                                                      "vyx_uint_to_string_into_abi".c_str(),
                                                                      27,
                                                                      self.builtin_uint_to_string_into_fty);
            free(u64_into_params);
        }
        self.builtin_string_builder_create_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, null, 0, 0);
        self.builtin_string_builder_create_fn = vyx_rt_add_function(self.mod,
                                                                   "vyx_string_builder_create_abi".c_str(),
                                                                   29,
                                                                   self.builtin_string_builder_create_fty);
        let builder_i64_params = malloc(16);
        if (builder_i64_params != null) {
            ast_write_rawptr(builder_i64_params, self.ty_ptr);
            ast_write_rawptr(ptr_offset(builder_i64_params, 8), self.ty_i64);
            self.builtin_string_builder_append_i64_fty = vyx_rt_fn_type(self.mod, self.ty_void, builder_i64_params, 2, 0);
            self.builtin_string_builder_append_i64_fn = vyx_rt_add_function(self.mod, "vyx_string_builder_append_i64_abi".c_str(), 33, self.builtin_string_builder_append_i64_fty);
            free(builder_i64_params);
        }
        let builder_u64_params = malloc(16);
        if (builder_u64_params != null) {
            ast_write_rawptr(builder_u64_params, self.ty_ptr);
            ast_write_rawptr(ptr_offset(builder_u64_params, 8), self.ty_i64);
            self.builtin_string_builder_append_u64_fty = vyx_rt_fn_type(self.mod, self.ty_void, builder_u64_params, 2, 0);
            self.builtin_string_builder_append_u64_fn = vyx_rt_add_function(self.mod, "vyx_string_builder_append_u64_abi".c_str(), 33, self.builtin_string_builder_append_u64_fty);
            free(builder_u64_params);
        }
        let class_alloc_params = malloc(8);
        if (class_alloc_params != null) {
            ast_write_rawptr(class_alloc_params, self.ty_i64);
            self.builtin_class_alloc_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, class_alloc_params, 1, 0);
            self.builtin_class_alloc_fn = vyx_rt_add_function(self.mod,
                                                             "vyx_class_alloc_abi".c_str(),
                                                             19,
                                                             self.builtin_class_alloc_fty);
            free(class_alloc_params);
        }
        let bool_params = malloc(8);
        if (bool_params != null) {
            ast_write_rawptr(bool_params, self.ty_i32);
            self.builtin_bool_to_string_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, bool_params, 1, 0);
            self.builtin_bool_to_string_fn = vyx_rt_add_function(self.mod, "bool_to_string".c_str(), 14, self.builtin_bool_to_string_fty);
            free(bool_params);
        }
        let strlen_params = malloc(8);
        if (strlen_params != null) {
            ast_write_rawptr(strlen_params, self.ty_ptr);
            self.builtin_strlen_fty = vyx_rt_fn_type(self.mod, self.ty_i64, strlen_params, 1, 0);
            self.builtin_strlen_fn = vyx_rt_add_function(self.mod, "strlen".c_str(), 6, self.builtin_strlen_fty);
            free(strlen_params);
        } else {
            self.report_error("cannot allocate strlen signature");
        }
        self.builtin_arg_count_fty = vyx_rt_fn_type(self.mod, self.ty_i32, null, 0, 0);
        if (!self.target_triple.contains("nvptx")) {
            self.builtin_arg_count_fn = vyx_rt_add_function(self.mod,
                                                            "_vyx_get_argc_internal".c_str(),
                                                            22,
                                                            self.builtin_arg_count_fty);
            if (self.builtin_arg_count_fn == null || self.builtin_arg_count_fty == null) {
                self.report_error("cannot declare argv count helper");
            } else {
                vyx_rt_set_linkage(self.mod, self.builtin_arg_count_fn, 1);
            }
        }
        let set_args_params = malloc(16);
        if (set_args_params != null) {
            ast_write_rawptr(set_args_params, self.ty_i32);
            ast_write_rawptr(ptr_offset(set_args_params, 8), self.ty_ptr);
            self.runtime_set_args_fty = vyx_rt_fn_type(self.mod,
                                                       self.ty_void,
                                                       set_args_params,
                                                       2,
                                                       0);
            self.runtime_set_args_fn = vyx_rt_add_function(self.mod,
                                                           "vyx_rt_set_args".c_str(),
                                                           15,
                                                           self.runtime_set_args_fty);
            free(set_args_params);
            if (self.runtime_set_args_fn == null || self.runtime_set_args_fty == null) {
                self.report_error("cannot declare process argument initializer");
            }
        } else {
            self.report_error("cannot allocate process argument initializer signature");
        }
        self.runtime_arg_count_fty = vyx_rt_fn_type(self.mod, self.ty_i32, null, 0, 0);
        self.runtime_arg_count_fn = vyx_rt_add_function(self.mod,
                                                        "argCount".c_str(),
                                                        8,
                                                        self.runtime_arg_count_fty);
        if (self.runtime_arg_count_fn == null || self.runtime_arg_count_fty == null) {
            self.report_error("cannot declare process argc runtime");
        }
        let get_arg_params = malloc(8);
        if (get_arg_params != null) {
            ast_write_rawptr(get_arg_params, self.ty_i32);
            self.builtin_get_arg_fty = vyx_rt_fn_type(self.mod,
                                                      self.get_string_ty(),
                                                      get_arg_params,
                                                      1,
                                                      0);
            if (!self.target_triple.contains("nvptx")) {
                self.builtin_get_arg_fn = vyx_rt_add_function(self.mod,
                                                              "_vyx_get_arg_internal".c_str(),
                                                              21,
                                                              self.builtin_get_arg_fty);
                if (self.builtin_get_arg_fn == null || self.builtin_get_arg_fty == null) {
                    self.report_error("cannot declare argv string helper");
                } else {
                    vyx_rt_set_linkage(self.mod, self.builtin_get_arg_fn, 1);
                }
            }
            self.runtime_get_arg_cstr_fty = vyx_rt_fn_type(self.mod,
                                                          self.ty_ptr,
                                                          get_arg_params,
                                                          1,
                                                          0);
            self.runtime_get_arg_cstr_fn = vyx_rt_add_function(self.mod,
                                                              "getArg".c_str(),
                                                              6,
                                                              self.runtime_get_arg_cstr_fty);
            if (self.runtime_get_arg_cstr_fn == null || self.runtime_get_arg_cstr_fty == null) {
                self.report_error("cannot declare process argv runtime");
            }
            free(get_arg_params);
        } else {
            self.report_error("cannot allocate argv string helper signature");
        }
        let malloc_params = malloc(8);
        if (malloc_params != null) {
            ast_write_rawptr(malloc_params, self.ty_i64);
            self.builtin_malloc_fty = vyx_rt_fn_type(self.mod, self.ty_ptr, malloc_params, 1, 0);
            // Generated copies/substrings also allocate here. Route all Vyx
            // allocation builtins through the executable's allocator so a
            // long-running frontend can release a complete request scope.
            // Outside a service scope these are ordinary CRT allocations.
            self.builtin_malloc_fn = vyx_rt_add_function(self.mod, "vyx_runtime_malloc".c_str(), 18, self.builtin_malloc_fty);
            self.builtin_pooled_string_alloc_fty = self.builtin_malloc_fty;
            self.builtin_pooled_string_alloc_fn = vyx_rt_add_function(
                self.mod,
                "vyx_string_alloc_abi".c_str(),
                20,
                self.builtin_pooled_string_alloc_fty);
            free(malloc_params);
        } else {
            self.report_error("cannot allocate malloc signature");
        }
        let free_params = malloc(8);
        if (free_params != null) {
            ast_write_rawptr(free_params, self.ty_ptr);
            self.builtin_free_fty = vyx_rt_fn_type(self.mod, self.ty_void, free_params, 1, 0);
            self.builtin_free_fn = vyx_rt_add_function(self.mod, "vyx_runtime_free".c_str(), 16, self.builtin_free_fty);
            self.builtin_pooled_string_free_fty = self.builtin_free_fty;
            self.builtin_pooled_string_free_fn = vyx_rt_add_function(
                self.mod,
                "vyx_free_pooled_string".c_str(),
                22,
                self.builtin_pooled_string_free_fty);
            self.builtin_forget_string_len_fty = vyx_rt_fn_type(self.mod,
                                                                self.ty_void,
                                                                free_params,
                                                                1,
                                                                0);
            self.builtin_forget_string_len_fn = vyx_rt_add_function(
                self.mod,
                "vyx_forget_string_len".c_str(),
                21,
                self.builtin_forget_string_len_fty);
            self.builtin_runtime_string_free_fty = vyx_rt_fn_type(self.mod,
                                                                  self.ty_void,
                                                                  free_params,
                                                                  1,
                                                                  0);
            self.builtin_runtime_string_free_fn = vyx_rt_add_function(
                self.mod,
                "vyx_free_runtime_string".c_str(),
                23,
                self.builtin_runtime_string_free_fty);
            free(free_params);
        } else {
            self.report_error("cannot allocate free signature");
        }
