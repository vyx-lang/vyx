module bootstrap.llvm_mir_lower;

@[vis(world)]
impl LlvmMirLowerer {
    public fn function_param_count(self, function_id: i32) -> i32 {
        return self.function_llvm_param_count(function_id);
    }

    public fn function_param_type(self, function_id: i32, idx: i32) -> i32 {
        return self.function_source_param_type(function_id, idx);
    }

    public fn debug_llvm_function_param_count(self, fn_value: rawptr) -> i32 {
        if (fn_value == null) { return -1; }
        var out: i32 = 0;
        while (out < 128) {
            if (vyx_rt_get_param(self.mod, fn_value, out as u64) == null) { return out; }
            out = out + 1;
        }
        return out;
    }

    public fn build_function_type(self, function_id: i32) -> rawptr {
        if (self.function_is_foreign_dci(function_id)
            && !self.dci_function_abi_lowerings_supported(function_id)) {
            return null;
        }
        let n = self.function_llvm_param_count(function_id);
        var params: rawptr = null;
        if (n > 0) { params = malloc((n * 8) as u64); }
        var idx: i32 = 0;
        let member_sret_after = self.dci_member_sret_after_receiver(function_id);
        if (self.function_uses_hidden_sret(function_id) && !member_sret_after) {
            ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        if (self.function_uses_c_main_abi(function_id)) {
            ast_write_rawptr(params, self.ty_i32);
            ast_write_rawptr(ptr_offset(params, 8), self.ty_ptr);
            idx = 2;
        }
        if (self.function_hidden_env_param_count(function_id) > 0) {
            ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        if (self.function_is_foreign_dci_ctor(function_id)) {
            ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        var source_idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) {
                let param_lowering = self.dci_source_parameter_abi(function_id, source_idx);
                let passing = self.dci_abi_passing(param_lowering);
                if (self.source_param_uses_self_pointer_abi(function_id, source_idx)) {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                } else if (self.foreign_c_handle_uses_raw_pointer_abi(
                               function_id,
                               self.local_effective_type(local))) {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                } else if (self.function_is_foreign_dci(function_id)
                    && self.dci_direct_handle_uses_raw_pointer_abi(
                           self.local_effective_type(local),
                           param_lowering)) {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                } else if (self.function_is_foreign_dci(function_id) && passing == "coerce") {
                    if (!self.dci_coerce_contract_supported(self.local_effective_type(local),
                                                            param_lowering,
                                                            "parameter #" + source_idx.toString()
                                                            + " of `" + self.m.function_name(function_id) + "`")) {
                        if (params != null) { free(params); }
                        return null;
                    }
                    let coerce_ty = self.dci_abi_coerce_type(param_lowering);
                    if (coerce_ty == null) {
                        self.report_error("DCI parameter has an unsupported coerce_to type in `"
                                   + self.m.function_name(function_id) + "`");
                        if (params != null) { free(params); }
                        return null;
                    }
                    ast_write_rawptr(ptr_offset(params, idx * 8), coerce_ty);
                } else if (self.function_is_foreign_dci(function_id) && passing == "split") {
                    if (!self.dci_split_contract_supported(self.local_effective_type(local),
                                                           param_lowering,
                                                           "parameter #" + source_idx.toString()
                                                           + " of `" + self.m.function_name(function_id) + "`")) {
                        if (params != null) { free(params); }
                        return null;
                    }
                    let piece_count = self.dci_register_count(param_lowering);
                    var piece: i32 = 0;
                    while (piece < piece_count) {
                        let piece_ty = self.dci_llvm_type_for_token(
                            self.dci_register_token_at(param_lowering, piece));
                        if (piece_ty == null) {
                            if (params != null) { free(params); }
                            return null;
                        }
                        ast_write_rawptr(ptr_offset(params, idx * 8), piece_ty);
                        idx = idx + 1;
                        piece = piece + 1;
                    }
                    idx = idx - 1;
                } else if (self.function_is_foreign_dci(function_id)
                    && (passing == "indirect" || passing == "byval"
                        || passing == "inalloca")) {
                    if (passing == "inalloca"
                        && self.dci_function_inalloca_count(function_id) > 1) {
                        idx = idx - 1;
                    } else {
                        ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                    }
                } else if (self.function_is_foreign_dci(function_id) && passing != "direct") {
                    self.report_error("unsupported DCI parameter passing `" + passing + "` in `"
                               + self.m.function_name(function_id) + "`");
                    if (params != null) { free(params); }
                    return null;
                } else if (self.function_is_foreign_dci(function_id)
                    && param_lowering == null
                    && self.type_is_foreign_dci(self.local_effective_type(local))) {
                    self.report_error("DCI parameter `" + self.m.local_name(local) + "` in `"
                               + self.m.function_name(function_id)
                               + "` has no aggregate ABI passing contract");
                    if (params != null) { free(params); }
                    return null;
                } else if (self.source_param_uses_native_byval_abi(function_id, source_idx)) {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                } else if (self.source_param_uses_c_sysv_coerce(function_id, source_idx)) {
                    let coerce_ty = self.c_sysv_coerce_llvm_type(self.local_effective_type(local));
                    if (coerce_ty == null) {
                        self.report_error("cannot build C SysV coerce type for parameter #"
                                   + source_idx.toString() + " of `"
                                   + self.m.function_name(function_id) + "`");
                        if (params != null) { free(params); }
                        return null;
                    }
                    ast_write_rawptr(ptr_offset(params, idx * 8), coerce_ty);
                } else {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.lower_type(self.local_effective_type(local)));
                }
                idx = idx + 1;
                source_idx = source_idx + 1;
                if (member_sret_after && source_idx == 1) {
                    ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
                    idx = idx + 1;
                }
            }
            local = self.m.local_next(local);
        }
        if (self.dci_function_inalloca_count(function_id) > 1) {
            ast_write_rawptr(ptr_offset(params, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        var is_vararg: i32 = 0;
        if (self.function_uses_c_varargs(function_id)) { is_vararg = 1; }
        let fty = vyx_rt_fn_type(self.mod,
                                 self.lower_function_return_type(function_id),
                                 params,
                                 n as u64,
                                 is_vararg);
        if (params != null) { free(params); }
        return fty;
    }

    public fn function_uses_c_main_abi(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        // NVPTX device compilation has no hosted process entry. A top-level
        // `main` remains an ordinary device function instead of receiving the
        // synthesized C argc/argv wrapper and host runtime symbols.
        if (self.target_triple.contains("nvptx")) { return false; }
        if (self.m.function_name(function_id) != "main") { return false; }
        if (self.m.function_owner_type(function_id).len != 0) { return false; }
        return self.m.function_item_kind(function_id) == hir_item_function();
    }

    public fn function_uses_i32_main_abi(self, function_id: i32) -> bool {
        if (!self.function_uses_c_main_abi(function_id)) { return false; }
        return llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id)) == ty_VOID();
    }

    public fn lower_function_return_type(self, function_id: i32) -> rawptr {
        if (self.function_uses_i32_main_abi(function_id)) { return self.ty_i32; }
        if (self.function_uses_hidden_sret(function_id)) { return self.ty_void; }
        if (self.function_is_foreign_dci_ctor(function_id)) {
            let lowering = self.dci_return_abi(function_id);
            let type_object = self.dci_json_item(lowering, "type");
            let reference = self.dci_json_string(type_object, "reference");
            if (self.dci_abi_passing(lowering) == "direct"
                && (reference == "pointer" || reference == "pointer_const"
                    || reference == "pointer_mut")) {
                return self.ty_ptr;
            }
            return self.ty_void;
        }
        if (self.function_is_foreign_dci_dtor(function_id)) { return self.ty_void; }
        let return_lowering = self.dci_return_abi(function_id);
        let passing = self.dci_abi_passing(return_lowering);
        if (self.function_is_foreign_dci(function_id) && passing == "sret") {
            return self.ty_void;
        }
        if (self.function_is_foreign_dci(function_id) && passing == "ignore") {
            if (llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id)) != ty_VOID()) {
                self.report_error("DCI ignore return passing requires void in `"
                           + self.m.function_name(function_id) + "`");
                return null;
            }
            return self.ty_void;
        }
        if (self.function_is_foreign_dci(function_id) && passing == "coerce") {
            if (!self.dci_coerce_contract_supported(self.m.function_return_type(function_id),
                                                    return_lowering,
                                                    "return of `" + self.m.function_name(function_id) + "`")) {
                return null;
            }
            let coerce_ty = self.dci_abi_coerce_type(return_lowering);
            if (coerce_ty == null) {
                self.report_error("DCI return has an unsupported coerce_to type in `"
                           + self.m.function_name(function_id) + "`");
            }
            return coerce_ty;
        }
        if (self.function_is_foreign_dci(function_id)
            && self.dci_direct_handle_uses_raw_pointer_abi(
                   self.m.function_return_type(function_id),
                   return_lowering)) {
            return self.ty_ptr;
        }
        if (self.foreign_c_handle_uses_raw_pointer_abi(
                function_id,
                self.m.function_return_type(function_id))) {
            return self.ty_ptr;
        }
        if (self.function_is_foreign_dci(function_id) && passing != "direct") {
            self.report_error("unsupported DCI return passing `" + passing + "` in `"
                       + self.m.function_name(function_id) + "`");
            return null;
        }
        if (self.function_is_foreign_dci(function_id)
            && return_lowering == null
            && self.type_is_foreign_dci(self.m.function_return_type(function_id))) {
            self.report_error("DCI function `" + self.m.function_name(function_id)
                       + "` has no aggregate return ABI contract");
            return null;
        }
        if (self.function_return_uses_c_sysv_coerce(function_id)) {
            let coerce_ret = self.c_sysv_coerce_llvm_type(self.m.function_return_type(function_id));
            if (coerce_ret == null) {
                self.report_error("cannot build C SysV coerce return type for `"
                           + self.m.function_name(function_id) + "`");
                return null;
            }
            return coerce_ret;
        }
        return self.lower_type(self.m.function_return_type(function_id));
    }

    public fn symbol_type_text(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return "unknown"; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0) { return "unknown"; }
        return text;
    }

    public fn c_abi_link_symbol(self, function_id: i32) -> string {
        if (function_id == mir_id_invalid()) { return ""; }
        let disc = mir_unit_function_symbol_discriminator(&self.m, function_id);
        if (disc.len < 5 || disc.substring(0, 5) != "csym:") { return ""; }
        var end: i32 = 5;
        while (end < disc.len) {
            if (disc.charAt(end) == 124) { break; }
            end = end + 1;
        }
        return disc.substring(5, end);
    }

    public fn function_uses_c_varargs(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return (mir_unit_function_flags(&self.m, function_id) & hir_function_flag_c_varargs()) != 0;
    }

    public fn call_arg_expected_type(self, function_id: i32, param_index: i32, arg_id: i32) -> i32 {
        let param_type = self.function_source_param_type(function_id, param_index);
        if (param_type != mir_id_invalid()) { return param_type; }
        if (self.function_uses_c_varargs(function_id)) {
            return self.value_effective_type(arg_id);
        }
        return mir_id_invalid();
    }

    public fn function_uses_c_calling_convention(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.c_abi_link_symbol(function_id).len > 0) { return true; }
        if (self.m.function_item_kind(function_id) == hir_item_extern_function()) { return true; }
        return (mir_unit_function_flags(&self.m, function_id) & hir_function_flag_no_mangle()) != 0;
    }

    public fn type_repr_is_packed(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical = self.canonical_record_type_id(type_id);
        return (hir_type_table_flags(self.m.types, canonical) & hir_type_flag_repr_packed()) != 0;
    }

    /// `@[repr(C)]`: the record's layout is the C layout, i.e. the class
    /// alignment floor does not apply.  This is what lets a consumer-declared
    /// record cross a DCI boundary: the producer's `struct`/`#[repr(C)]`
    /// instantiation has no floor either, so a floor on this side would move
    /// every field after the record and disagree with the measured layout.
    public fn type_repr_is_c(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical = self.canonical_record_type_id(type_id);
        return (hir_type_table_flags(self.m.types, canonical) & hir_type_flag_repr_c()) != 0;
    }

    public fn type_repr_explicit_align(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical = self.canonical_record_type_id(type_id);
        return hir_type_repr_align_from_flags(hir_type_table_flags(self.m.types, canonical)) as i64;
    }

    public fn function_uses_unmangled_abi_symbol(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.c_abi_link_symbol(function_id).len > 0) { return true; }
        if (self.m.function_item_kind(function_id) == hir_item_extern_function()) { return true; }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_no_mangle()) != 0) {
            return true;
        }
        if (self.m.function_name(function_id) == "main"
            && self.m.function_owner_type(function_id).len == 0
            && self.m.function_item_kind(function_id) == hir_item_function()) {
            return true;
        }
        return false;
    }

    public fn function_symbol_owner_text(self, function_id: i32) -> string {
        if (function_id == mir_id_invalid()) { return ""; }
        let owner = self.m.function_owner_type(function_id);
        if (owner.len > 0) { return owner; }
        let first_local = self.function_source_param_local(function_id, 0);
        if (self.local_is_self_receiver_param(first_local)) {
            return self.symbol_type_text(self.m.local_type(first_local));
        }
        return "";
    }

    public fn function_symbol_signature_suffix(self, function_id: i32) -> string {
        var out = "_R_" + policy_mangle_part(self.symbol_type_text(self.m.function_return_type(function_id)));
        out = out.clone() + "_P";
        let n = self.function_source_param_count(function_id);
        if (n <= 0) { return out.clone() + "_0"; }
        var idx: i32 = 0;
        while (idx < n) {
            let param_type = self.function_source_param_type(function_id, idx);
            out = out.clone() + "_" + policy_mangle_part(self.symbol_type_text(param_type));
            idx = idx + 1;
        }
        return out;
    }

    public fn intern_function_symbol_name(self, function_id: i32, symbol: string) -> string {
        if (function_id != mir_id_invalid()
            && symbol.len > 0
            && llvm_mir_map_get(self.function_mangled_name_cache, function_id) == null) {
            llvm_mir_map_put(self.function_mangled_name_cache, function_id, ast_dup_c_string(symbol.clone()));
        }
        return symbol;
    }

    public fn function_symbol_name(self, function_id: i32) -> string {
        if (function_id == mir_id_invalid()) { return ""; }
        let cached = llvm_mir_map_get(self.function_mangled_name_cache, function_id);
        if (cached != null) { return from_cstr(cached); }
        let name = self.m.function_name(function_id);
        if (name.len == 0) { return ""; }
        if (self.function_is_foreign_dci(function_id)) {
            // Open-generic DCI instances (`base__<args>`) are materialized by
            // the Active Adapter, not by the contract: their link symbol is
            // the flat instance name itself.
            if (mir_unit_function_generic_args(&self.m, function_id).len > 0
                && self.function_name_is_foreign_dci_instance(function_id)) {
                return self.intern_function_symbol_name(function_id, name);
            }
            let dci_symbol = self.dci_link_name_for_function(function_id);
            if (dci_symbol.len > 0) { return self.intern_function_symbol_name(function_id, dci_symbol); }
            if (!mir_unit_has_dci_abi(&self.m)) {
                self.report_error("external DCI declaration `" + self.m.function_name(function_id)
                           + "` requires a DCI descriptor");
            } else {
                let missing_owner = self.foreign_dci_owner_type_text(function_id);
                if (self.dci_symbol_kind_for_function(function_id) == "method"
                    && missing_owner.contains("<")) {
                    // Consumer-driven open-generic discovery: the method's
                    // closed instance is missing from every descriptor.  Record
                    // it in the `.dci_open` sidecar so the build can ask the
                    // producer adapter to close exactly this instance and
                    // re-lower, instead of requiring a hand-listed
                    // `--export-instance` for every generic trait/record
                    // instance the consumer happens to touch.
                    llvm_dci_open_note_instance(missing_owner.clone());
                }
                self.report_error("DCI Descriptor has no matching symbol for external declaration `"
                           + self.m.function_name(function_id)
                           + "` (kind=" + self.dci_symbol_kind_for_function(function_id)
                           + ", member=" + self.dci_symbol_name_for_function(function_id)
                           + ", owner=" + missing_owner.clone()
                           + ")");
            }
            return "";
        }
        let c_symbol = self.c_abi_link_symbol(function_id);
        if (c_symbol.len > 0) { return self.intern_function_symbol_name(function_id, c_symbol); }
        if (self.function_uses_unmangled_abi_symbol(function_id)) {
            return self.intern_function_symbol_name(function_id, name);
        }
        let owner = self.function_symbol_owner_text(function_id);
        var out = "__vyx";
        if (owner.len > 0) {
            out = out.clone() + "_M_" + policy_mangle_part(owner)
                      + "_N_" + policy_mangle_part(name);
        } else {
            out = out.clone() + "_F_" + policy_mangle_part(name);
        }
        if (self.m.function_item_kind(function_id) == hir_item_closure()) {
            out = out.clone() + "_L_" + policy_i64_to_string(function_id as i64);
        }
        let discriminator = mir_unit_function_symbol_discriminator(&self.m, function_id);
        if (discriminator.len > 0) {
            out = out.clone() + "_V_" + policy_mangle_part(discriminator);
        }
        return self.intern_function_symbol_name(function_id, out.clone() + self.function_symbol_signature_suffix(function_id));
    }

    public fn function_name_is_mir_generic_instance(self, function_id: i32) -> bool {
        let name = self.m.function_name(function_id);
        if (name.len < 5) { return false; }
        return name.substring(0, 5) == "mir2$";
    }

    /// A foreign-DCI open-generic instance: flat `<base>__<args>` link name
    /// materialized by the Active Adapter (never `mir2$`-prefixed, never
    /// contract-bound).
    public fn function_name_is_foreign_dci_instance(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        let name = self.m.function_name(function_id);
        if (name.len == 0 || name.startsWith("mir2$")) { return false; }
        if (mir_unit_function_generic_args(&self.m, function_id).len == 0) { return false; }
        return true;
    }

    /// `open <symbol> <base> <ret_text> <args_csv>` for the requests sidecar.
    public fn dci_open_request_line(self, function_id: i32) -> string {
        let name = self.m.function_name(function_id);
        var base = name;
        var suffix = "__";
        let args = mir_unit_function_generic_args(&self.m, function_id);
        var idx: i32 = 0;
        while (idx < 64) {
            let arg = policy_generic_arg_at(args, idx);
            if (arg.len == 0) { break; }
            if (idx > 0) { suffix = suffix + "_"; }
            suffix = suffix + policy_mangle_part(arg);
            idx = idx + 1;
        }
        if (name.endsWith(suffix) && suffix.len > 2) {
            base = name.substring(0, name.len - suffix.len);
        }
        let ret_text = llvm_mir_type_text(&self.m, self.m.function_return_type(function_id));
        return "open\t" + name + "\t" + base + "\t" + ret_text + "\t" + args;
    }

    public fn function_name_is_language_lowering_root(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (name == "__vio_await_yield") { return true; }
        return name.startsWith("vio_async_");
    }

    public fn function_definition_should_be_internal(self, function_id: i32) -> bool {
        // A root-partitioned compile repeats imported/helper bodies in every
        // chunk. Only explicitly exported roots may keep external linkage;
        // otherwise chunks define the same strong symbol many times. Normal
        // intra-process CGU splitting retains its cross-CGU linkage rule.
        if (self.cgu_emit_index > 0 && !self.export_root_linkage_mode) { return false; }
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_uses_unmangled_abi_symbol(function_id)) { return false; }
        if (self.function_is_dci_vyx_override_callback(function_id)) { return false; }
        if (self.function_name_is_language_lowering_root(self.m.function_name(function_id))) {
            return false;
        }
        if (self.m.function_first_block(function_id) == mir_id_invalid()) { return false; }
        if (self.export_root_linkage_mode
            && (mir_unit_function_flags(&self.m, function_id) & hir_function_flag_codegen_root()) == 0) {
            return true;
        }
        if (self.export_root_linkage_mode
            && (mir_unit_function_flags(&self.m, function_id) & hir_function_flag_codegen_root()) != 0) {
            return false;
        }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_imported_body()) != 0) { return true; }
        if (self.m.function_item_kind(function_id) == hir_item_closure()) { return true; }
        if (self.function_name_is_mir_generic_instance(function_id)) { return true; }
        if (mir_unit_function_generic_args(&self.m, function_id).len > 0) { return true; }
        return false;
    }

    public fn function_total_instr_count(self, function_id: i32) -> i32 {
        var total: i32 = 0;
        var block = self.m.function_first_block(function_id);
        while (block != mir_id_invalid()) {
            total = total + self.m.block_instr_count(block);
            block = self.m.block_next(block);
        }
        return total;
    }

    public fn compute_function_self_call_cache(self) {
        if (self.function_self_call_cache_ready) { return; }
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            llvm_mir_i32_map_put(self.function_self_call_cache, fn_id, 1);
            fn_id = fn_id + 1;
        }
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            let owner_fn = self.m.value_function(value_id);
            if (owner_fn != mir_id_invalid()
                && self.m.value_kind(value_id) == mir_value_call()
                && self.m.value_target_kind(value_id) == mir_target_function()
                && self.m.value_target_id(value_id) == owner_fn) {
                llvm_mir_i32_map_put(self.function_self_call_cache, owner_fn, 2);
            }
            value_id = value_id + 1;
        }
        self.function_self_call_cache_ready = true;
    }

    public fn compute_function_self_call_cache_for(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        if (llvm_mir_i32_map_get(self.function_self_call_cache, function_id) != 0) { return; }
        llvm_mir_i32_map_put(self.function_self_call_cache, function_id, 1);
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.m.value_function(value_id) == function_id
                && self.m.value_kind(value_id) == mir_value_call()
                && self.m.value_target_kind(value_id) == mir_target_function()
                && self.m.value_target_id(value_id) == function_id) {
                llvm_mir_i32_map_put(self.function_self_call_cache, function_id, 2);
                return;
            }
            value_id = value_id + 1;
        }
    }

    public fn function_calls_itself(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        self.compute_function_self_call_cache();
        self.compute_function_self_call_cache_for(function_id);
        return llvm_mir_i32_map_get(self.function_self_call_cache, function_id) == 2;
    }

    public fn function_should_force_inline(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (!self.function_definition_should_be_internal(function_id)) { return false; }
        if (self.m.function_first_block(function_id) == mir_id_invalid()) { return false; }
        if (self.function_hidden_env_param_count(function_id) > 0) { return false; }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_async_task()) != 0) { return false; }
        if (self.function_calls_itself(function_id)) { return false; }

        let blocks = self.m.function_block_count(function_id);
        let instrs = self.function_total_instr_count(function_id);
        let params = self.function_source_param_count(function_id);
        if (blocks <= 3 && instrs <= 24 && params <= 6) { return true; }
        if (self.function_name_is_mir_generic_instance(function_id)
            && blocks <= 6
            && instrs <= 64
            && params <= 8) {
            return true;
        }
        return false;
    }

    public fn apply_named_function_attr(self, function_id: i32, fn_value: rawptr, attr: string) -> bool {
        if (fn_value == null || attr.len == 0) { return false; }
        if (vyx_rt_set_function_attr(self.mod,
                                     fn_value,
                                     attr.c_str(),
                                     attr.len as u64,
                                     null,
                                     0) != 0) {
            self.report_error("cannot apply function attribute " + attr + ": "
                              + self.m.function_name(function_id));
            return false;
        }
        return true;
    }

    public fn apply_function_codegen_attrs(self, function_id: i32, fn_value: rawptr) {
        if (fn_value == null) { return; }
        let flags = mir_unit_function_flags(&self.m, function_id);
        let explicit_noinline = (flags & hir_function_flag_noinline()) != 0;
        let explicit_inline = (flags & hir_function_flag_inline_hint()) != 0;
        if (explicit_noinline) {
            self.apply_named_function_attr(function_id, fn_value, "noinline");
        } elif (explicit_inline) {
            self.apply_named_function_attr(function_id, fn_value, "inlinehint");
        } elif (self.function_should_force_inline(function_id)) {
            self.apply_named_function_attr(function_id, fn_value, "alwaysinline");
        }

        // `hot` wins for conflicting source annotations, matching the legacy
        // declaration codegen ordering while keeping LLVM's pair exclusive.
        if ((flags & hir_function_flag_hot()) != 0) {
            self.apply_named_function_attr(function_id, fn_value, "hot");
        } elif ((flags & hir_function_flag_cold()) != 0) {
            self.apply_named_function_attr(function_id, fn_value, "cold");
        }
        if (self.function_uses_c_calling_convention(function_id)) {
            vyx_rt_set_calling_convention(self.mod, fn_value, "c".c_str(), 1);
        }
        if ((flags & hir_function_flag_cuda_kernel()) != 0) {
            // NVPTX device-kernel entry: the backend turns this attribute
            // into a `.visible .entry` directive under the
            // `nvptx64-nvidia-cuda` target.  Inert on other targets.
            self.apply_named_function_attr(function_id, fn_value, "nvvm.kernel");
        }
    }

    public fn apply_function_definition_linkage(self, function_id: i32, fn_value: rawptr) {
        if (fn_value == null) { return; }
        if (self.function_definition_should_be_internal(function_id)) {
            vyx_rt_set_linkage(self.mod, fn_value, 1);
        } elif (self.function_name_is_mir_generic_instance(function_id)) {
            // A CGU owns each concrete instance, but its callers may live in
            // other LLVM modules. linkonce_odr can be removed when the owner
            // module has no local uses; weak_odr remains linkable while still
            // allowing identical instances from separate source units to fold.
            if (self.cgu_emit_index > 0) {
                vyx_rt_set_linkage(self.mod, fn_value, 4);
            } else {
                vyx_rt_set_linkage(self.mod, fn_value, 3);
            }
        }
    }

    public fn function_is_interface_prototype_body(self, function_id: i32) -> bool {
        if (self.m.function_first_block(function_id) == mir_id_invalid()) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, function_id) != hir_item_interface()) { return false; }
        return true;
    }

    public fn type_id_has_open_template_for_function(self, function_id: i32, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0) { return false; }
        let resolved = self.resolve_type_text_in_function(function_id, text);
        return self.type_name_has_open_template_atom_for_function(function_id, resolved);
    }

    public fn type_name_has_open_template_atom_for_function(self, function_id: i32, name: string) -> bool {
        if (name.len == 0) { return false; }
        let normalized = self.normalize_type_text(name);
        if (policy_generic_call_has_args(normalized) != 0) {
            let base = policy_generic_call_base(normalized.clone());
            if (self.type_name_has_open_template_atom_for_function(function_id, base)) { return true; }
            let args = policy_generic_call_args(normalized.clone());
            var i: i32 = 0;
            while (i < 64) {
                let a = policy_generic_arg_at(args, i);
                if (a.len == 0) { return false; }
                if (self.type_name_has_open_template_atom_for_function(function_id, a)) { return true; }
                i = i + 1;
            }
            return false;
        }
        let sep = llvm_mir_assoc_separator_index(normalized);
        if (sep >= 0) {
            let sep_len = llvm_mir_assoc_separator_len(normalized, sep);
            if (sep > 0 && sep + sep_len < normalized.len) {
                let owner_text = normalized.substring(0, sep);
                let member_text = normalized.substring(sep + sep_len, normalized.len);
                if (self.type_name_has_open_template_atom_for_function(function_id, owner_text)) { return true; }
                if (self.type_name_has_open_template_atom_for_function(function_id, member_text)) { return true; }
            }
        }
        if (self.type_atom_is_open_template_for_function(function_id, normalized)) { return true; }
        return self.type_text_has_open_template_atom_for_function(function_id, normalized);
    }

    public fn type_atom_is_open_template_for_function(self, function_id: i32, atom: string) -> bool {
        if (atom.len == 0) { return false; }
        if (atom == "Self") {
            let bound_self = self.function_generic_binding(function_id, atom);
            if (bound_self.len == 0 || bound_self == atom) { return true; }
            return self.type_name_has_open_template_atom_for_function(function_id, bound_self);
        }
        let params = mir_unit_function_generic_params(&self.m, function_id);
        let args = mir_unit_function_generic_args(&self.m, function_id);
        var param_index: i32 = 0;
        while (param_index < 64) {
            let p = llvm_mir_generic_param_canonical(policy_generic_param_at(params, param_index));
            if (p.len == 0) { break; }
            if (p == atom && llvm_mir_generic_param_name_is_template(p)) {
                let bound = policy_generic_arg_at(args, param_index);
                if (bound.len == 0 || bound == atom) { return true; }
                return self.type_name_has_open_template_atom_for_function(function_id, bound);
            }
            param_index = param_index + 1;
        }
        return false;
    }

    public fn type_text_has_open_template_atom_for_function(self, function_id: i32, text: string) -> bool {
        var i: i32 = 0;
        while (i < text.len) {
            let c = text.charAt(i);
            if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
                let start = i;
                i = i + 1;
                while (i < text.len) {
                    let c2 = text.charAt(i);
                    if ((c2 >= 65 && c2 <= 90)
                        || (c2 >= 97 && c2 <= 122)
                        || (c2 >= 48 && c2 <= 57)
                        || c2 == 95) {
                        i = i + 1;
                    } else {
                        let atom = text.substring(start, i);
                        if (self.type_atom_is_open_template_for_function(function_id, atom)) { return true; }
                        break;
                    }
                }
                if (i >= text.len) {
                    let atom2 = text.substring(start, i);
                    if (self.type_atom_is_open_template_for_function(function_id, atom2)) { return true; }
                }
            } else {
                i = i + 1;
            }
        }
        return false;
    }

    public fn mark_function_open_template_if_needed(self, function_id: i32, type_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        if (llvm_mir_i32_map_get(self.function_open_template_cache, function_id) == 2) { return; }
        if (self.type_id_has_open_template_for_function(function_id, type_id)) {
            llvm_mir_i32_map_put(self.function_open_template_cache, function_id, 2);
        }
    }

    public fn compute_function_open_template_cache(self) {
        if (self.function_open_template_cache_ready) { return; }
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            self.compute_function_open_template_cache_for(fn_id);
            fn_id = fn_id + 1;
        }
        self.function_open_template_cache_ready = true;
    }

    public fn compute_function_open_template_cache_for(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        let cached = llvm_mir_i32_map_get(self.function_open_template_cache, function_id);
        if (cached == 1 || cached == 2) { return; }
        llvm_mir_i32_map_put(self.function_open_template_cache, function_id, 1);
        self.mark_function_open_template_if_needed(function_id, self.m.function_return_type(function_id));
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            self.mark_function_open_template_if_needed(function_id, self.m.local_type(local));
            local = self.m.local_next(local);
        }
        if (self.m.function_first_block(function_id) == mir_id_invalid()) {
            return;
        }
        var place_id: i32 = 1;
        while (place_id <= self.m.place_count) {
            if (self.m.place_function(place_id) == function_id) {
                self.mark_function_open_template_if_needed(function_id, self.m.place_type(place_id));
            }
            place_id = place_id + 1;
        }
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.m.value_function(value_id) == function_id
                && self.m.value_name(value_id) != "_"
                && !(self.m.value_kind(value_id) == mir_value_target_ref()
                     && self.m.value_target_kind(value_id) == mir_target_hir_variant())) {
                self.mark_function_open_template_if_needed(function_id, self.m.value_type(value_id));
            }
            value_id = value_id + 1;
        }
        var instr_id: i32 = 1;
        while (instr_id <= self.m.instr_count) {
            if (!mir_unit_instr_owner_is_removed(&self.m, instr_id)
                && self.m.instr_function(instr_id) == function_id) {
                self.mark_function_open_template_if_needed(function_id, self.m.instr_type(instr_id));
            }
            instr_id = instr_id + 1;
        }
    }

    public fn function_has_open_template_types(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        self.compute_function_open_template_cache_for(function_id);
        return llvm_mir_i32_map_get(self.function_open_template_cache, function_id) == 2;
    }

    public fn invalidate_streaming_function_template_cache(self,
                                                           function_id: i32,
                                                           first_new_function: i32,
                                                           first_value: i32,
                                                           last_value: i32) {
        // Lazy HIR materialization can complete an existing generic shell and
        // create closed instances while this lowerer is alive. Any cached
        // open/closed result observed before that point describes the shell,
        // not the completed callable signature. Invalidate only the function
        // being materialized, newly-created functions, and direct targets in
        // the appended body so large projects do not pay a global rescan.
        if (function_id != mir_id_invalid()) {
            llvm_mir_i32_map_put(self.function_open_template_cache, function_id, 0);
            // A streamed function has no retained body before this append.
            // Refresh its recursion fact from the appended values below
            // instead of rescanning every value in the module at declaration.
            llvm_mir_i32_map_put(self.function_self_call_cache, function_id, 1);
        }
        var fn_id = first_new_function;
        if (fn_id < 1) { fn_id = 1; }
        while (fn_id <= self.m.function_count) {
            llvm_mir_i32_map_put(self.function_open_template_cache, fn_id, 0);
            llvm_mir_i32_map_put(self.function_self_call_cache, fn_id, 1);
            fn_id = fn_id + 1;
        }
        var value_id = first_value;
        if (value_id < 1) { value_id = 1; }
        while (value_id <= last_value) {
            let owner_fn = self.m.value_function(value_id);
            if (owner_fn != mir_id_invalid()
                && self.m.value_kind(value_id) == mir_value_call()
                && self.m.value_target_kind(value_id) == mir_target_function()
                && self.m.value_target_id(value_id) == owner_fn) {
                llvm_mir_i32_map_put(self.function_self_call_cache, owner_fn, 2);
            }
            if (self.m.value_target_kind(value_id) == mir_target_function()) {
                let target_fn = self.m.value_target_id(value_id);
                if (target_fn != mir_id_invalid()) {
                    llvm_mir_i32_map_put(self.function_open_template_cache, target_fn, 0);
                }
            }
            value_id = value_id + 1;
        }
        self.function_open_template_cache_ready = false;
    }

    public fn function_should_emit(self, function_id: i32) -> bool {
        if (self.cgu_emit_index > 0) {
            let member = llvm_mir_i32_map_get(self.cgu_member_map, function_id);
            if (member != 0 && member != self.cgu_emit_index) {
                return false;
            }
        }
        if (self.function_is_interface_prototype_body(function_id)) { return false; }
        if (self.function_is_bodyless(function_id)
            && mir_unit_function_item_kind(&self.m, function_id) != hir_item_extern_function()) {
            return false;
        }
        if (self.function_definition_was_emitted(function_id)) { return false; }
        if (self.function_symbol_has_prior_body(function_id)) { return false; }
        return !self.function_has_open_template_types(function_id);
    }

    public fn function_can_be_declared(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_is_interface_prototype_body(function_id)) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, function_id) == hir_item_interface()) { return false; }
        return !self.function_has_open_template_types(function_id);
    }

    public fn function_is_imported_callable_declaration(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (!self.function_is_bodyless(function_id)) { return false; }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_imported_body()) == 0) { return false; }
        let name = self.m.function_name(function_id);
        if (name.len >= 5 && name.substring(0, 5) == "mir2$") { return false; }
        if (mir_unit_function_generic_args(&self.m, function_id).len > 0) { return false; }
        return true;
    }

    public fn function_is_partition_external_root(self, function_id: i32) -> bool {
        if (!self.partition_codegen_roots) { return false; }
        if (function_id == mir_id_invalid()) { return false; }
        if (!self.function_is_bodyless(function_id)) { return false; }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_codegen_root()) == 0) {
            return false;
        }
        if (mir_unit_function_owner_item_kind(&self.m, function_id) == hir_item_interface()) {
            return false;
        }
        return true;
    }

    public fn function_definition_was_emitted(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (llvm_mir_i32_map_get(self.function_definition_emitted_map, function_id) == 2) {
            return true;
        }
        let symbol = self.function_symbol_name(function_id);
        let indexed = llvm_mir_symbol_index_get(self.function_symbol_index,
                                                self.function_symbol_index_cap,
                                                symbol);
        if (indexed != mir_id_invalid()
            && indexed != function_id
            && llvm_mir_i32_map_get(self.function_definition_emitted_map, indexed) == 2) {
            return true;
        }
        return false;
    }

    // The streaming-MIR discard marker is a verifier fact, not a symbol
    // lookup. Do not inherit a same-symbol alias here: only this exact
    // FunctionId may claim that its body was emitted and then released.
    public fn function_definition_was_directly_emitted(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return llvm_mir_i32_map_get(self.function_definition_emitted_map, function_id) == 2;
    }

    public fn mark_function_definition_emitted(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        llvm_mir_i32_map_put(self.function_definition_emitted_map, function_id, 2);
        if (self.method_candidate_index_ready) {
            self.remember_function_method_candidate(function_id);
        }
        let symbol = self.function_symbol_name(function_id);
        let indexed = llvm_mir_symbol_index_get(self.function_symbol_index,
                                                self.function_symbol_index_cap,
                                                symbol);
        if (indexed != mir_id_invalid()) {
            llvm_mir_i32_map_put(self.function_definition_emitted_map, indexed, 2);
        }
    }

    public fn function_has_callable_body_or_import(self, function_id: i32) -> bool {
        if (!self.function_can_be_declared(function_id)) { return false; }
        if (self.function_definition_was_emitted(function_id)) { return true; }
        if (!self.function_is_bodyless(function_id)) { return true; }
        if (self.function_is_partition_external_root(function_id)) { return true; }
        if (mir_unit_function_item_kind(&self.m, function_id) == hir_item_extern_function()) { return true; }
        return self.function_is_imported_callable_declaration(function_id);
    }

    public fn function_is_bodyless(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return self.m.function_first_block(function_id) == mir_id_invalid();
    }

    public fn function_symbol_has_prior_body(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.m.function_first_block(function_id) == mir_id_invalid()) { return false; }
        let symbol = self.function_symbol_name(function_id);
        if (symbol.len == 0) { return false; }
        // Declarations are scanned in FunctionId order and every eligible
        // earlier definition is entered in this symbol index.  The old full
        // prefix walk made initial declaration quadratic for large units
        // (8k+ functions in a split project).  A bodyless extern declaration
        // may legitimately own the first slot for a symbol, so preserve the
        // exact old scan only for that same-symbol collision case.
        let indexed = llvm_mir_symbol_index_get(self.function_symbol_index,
                                                self.function_symbol_index_cap,
                                                symbol);
        if (indexed != mir_id_invalid() && indexed < function_id) {
            if (self.m.function_first_block(indexed) != mir_id_invalid()
                && !self.function_is_interface_prototype_body(indexed)
                && !self.function_has_open_template_types(indexed)) {
                return true;
            }
        } else if (indexed == function_id
            || (indexed == mir_id_invalid()
                && self.function_symbol_index != null
                && self.m.function_count < self.function_symbol_index_cap)) {
            // put_first records the first owner. If that owner is this
            // function, or the exact index misses under a non-full table,
            // no earlier body shares the symbol. Falling through would scan
            // 1..function_id-1 and remangle every prior name on each emit.
            return false;
        }
        var cur: i32 = 1;
        while (cur < function_id) {
            if (self.m.function_first_block(cur) != mir_id_invalid()
                && !self.function_is_interface_prototype_body(cur)
                && self.function_symbol_name(cur) == symbol
                && !self.function_has_open_template_types(cur)) {
                return true;
            }
            cur = cur + 1;
        }
        return false;
    }

    public fn function_return_kind(self, function_id: i32) -> i32 {
        return llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id));
    }

    public fn function_param_kind_at(self, function_id: i32, idx: i32) -> i32 {
        return llvm_mir_type_kind(&self.m, self.function_source_param_type(function_id, idx));
    }

    public fn function_return_is_void(self, function_id: i32) -> bool {
        return self.function_return_kind(function_id) == ty_VOID();
    }

    public fn function_return_is_pointer_abi(self, function_id: i32) -> bool {
        return llvm_mir_kind_pointer_like(self.function_return_kind(function_id));
    }

    public fn function_param_is_pointer_abi(self, function_id: i32, idx: i32) -> bool {
        return llvm_mir_kind_pointer_like(self.function_param_kind_at(function_id, idx));
    }

    public fn function_return_int_bits(self, function_id: i32) -> i32 {
        return llvm_mir_int_bits_for_kind(self.function_return_kind(function_id));
    }

    public fn function_param_int_bits_at(self, function_id: i32, idx: i32) -> i32 {
        return llvm_mir_int_bits_for_kind(self.function_param_kind_at(function_id, idx));
    }

    public fn remember_declared_function_symbol(self, function_id: i32, symbol: string) {
        if (function_id == mir_id_invalid() || symbol.len == 0) { return; }
        llvm_mir_symbol_index_put_first(self.function_symbol_index,
                                        self.function_symbol_index_cap,
                                        symbol,
                                        function_id);
    }

    public fn declare_function_signature(self, function_id: i32) -> bool {
        if (!self.function_can_be_declared(function_id)) { return false; }
        if (llvm_mir_map_get(self.function_values, function_id) != null
            && llvm_mir_map_get(self.function_types, function_id) != null) {
            if (vyx_bootstrap_profile_level() > 2) {
                let cached_fn = llvm_mir_map_get(self.function_values, function_id);
                print("[llvm-mir-declare-sig] cached fn="
                      + policy_i64_to_string(function_id as i64)
                      + " src=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                      + " llvm=" + policy_i64_to_string(self.function_llvm_param_count(function_id) as i64)
                      + " actual=" + policy_i64_to_string(self.debug_llvm_function_param_count(cached_fn) as i64)
                      + " first_local=" + policy_i64_to_string(self.m.function_first_local(function_id) as i64)
                      + " name=" + self.m.function_name(function_id));
            }
            return true;
        }
        if (!self.function_is_foreign_dci(function_id)
            && self.bind_runtime_external_function(function_id)) {
            return llvm_mir_map_get(self.function_values, function_id) != null
                && llvm_mir_map_get(self.function_types, function_id) != null;
        }
        let name = self.function_symbol_name(function_id);
        let fty = self.build_function_type(function_id);
        if (fty == null) {
            self.report_error("cannot build function type for " + self.m.function_name(function_id));
            return false;
        }
        let bind_result = self.bind_existing_function_symbol(function_id, name, fty);
        if (bind_result > 0) { return true; }
        if (bind_result < 0) { return false; }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-mir-declare-sig] new fn="
                  + policy_i64_to_string(function_id as i64)
                  + " src=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                  + " llvm=" + policy_i64_to_string(self.function_llvm_param_count(function_id) as i64)
                  + " first_local=" + policy_i64_to_string(self.m.function_first_local(function_id) as i64)
                  + " symbol=" + name
                  + " name=" + self.m.function_name(function_id));
        }
        let f = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, fty);
        if (f == null) {
            self.report_error("cannot declare function " + name);
            return false;
        }
        self.apply_function_codegen_attrs(function_id, f);
        if (!self.apply_dci_function_abi_attrs(function_id, f)) { return false; }
        if (!self.apply_native_c_aggregate_abi_attrs(function_id, f)) { return false; }
        self.apply_dci_unwind_attrs(function_id, f);
        llvm_mir_map_put(self.function_values, function_id, f);
        llvm_mir_map_put(self.function_types, function_id, fty);
        self.remember_declared_function_symbol(function_id, name);
        return true;
    }

    // This comparison is deliberately narrower than dci_symbol_contracts_equivalent.
    // It is used only when two foreign declarations resolve to one linker symbol.
    // Source aliases may give that one native object distinct nominal owner and
    // receiver names, while their machine ABI remains identical.
    public fn bind_existing_function_symbol(self,
                                             function_id: i32,
                                             symbol: string,
                                             expected_type: rawptr) -> i32 {
        if (function_id == mir_id_invalid() || symbol.len == 0 || expected_type == null) { return 0; }
        let indexed = llvm_mir_symbol_index_get(self.function_symbol_index,
                                                self.function_symbol_index_cap,
                                                symbol);
        if (indexed != mir_id_invalid() && indexed != function_id) {
            let indexed_value = llvm_mir_map_get(self.function_values, indexed);
            let indexed_type = llvm_mir_map_get(self.function_types, indexed);
            if (indexed_value != null && indexed_type != null) {
                if (indexed_type != expected_type
                    || !self.dci_shared_symbol_contracts_compatible(function_id, indexed)) {
                    self.report_error("conflicting function contracts for shared link symbol `"
                              + symbol + "`");
                    return -1;
                }
                llvm_mir_map_put(self.function_values, function_id, indexed_value);
                llvm_mir_map_put(self.function_types, function_id, indexed_type);
                return 1;
            }
        } else if (indexed == function_id
            || (indexed == mir_id_invalid()
                && self.function_symbol_index != null
                && self.m.function_count < self.function_symbol_index_cap)) {
            // Every declaration path records its symbol only after both LLVM
            // maps are populated. Under the non-full exact index, a miss
            // therefore proves there is no prior compatible declaration.
            // indexed == this function is the same fact: we already own the
            // first slot, so the prefix walk cannot find an earlier bind.
            return 0;
        }
        var cur: i32 = 1;
        while (cur < function_id) {
            if (self.function_symbol_name(cur) == symbol) {
                let existing_value = llvm_mir_map_get(self.function_values, cur);
                let existing_type = llvm_mir_map_get(self.function_types, cur);
                if (existing_value != null && existing_type != null) {
                    if (existing_type != expected_type
                        || !self.dci_shared_symbol_contracts_compatible(function_id, cur)) {
                        self.report_error("conflicting function contracts for shared link symbol `"
                                  + symbol + "`");
                        return -1;
                    }
                    llvm_mir_map_put(self.function_values, function_id, existing_value);
                    llvm_mir_map_put(self.function_types, function_id, existing_type);
                    return 1;
                }
            }
            cur = cur + 1;
        }
        return 0;
    }

    public fn declare_functions(self) {
        var fn_id: i32 = self.declared_function_scan_next;
        if (fn_id < 1) { fn_id = 1; }
        while (fn_id <= self.m.function_count) {
            let temp_string_mark = vyx_rt_string_arena_checkpoint();
            if (self.function_should_emit(fn_id)) {
                if (self.function_is_foreign_dci(fn_id)
                    && self.function_name_is_foreign_dci_instance(fn_id)) {
                    // Record the closed instance for the Active Adapter, and
                    // first the consumer-declared records it is closed over:
                    // those are definitions the producer has never seen, and
                    // without them it cannot even name the instance.
                    self.dci_local_emit_open_support(fn_id);
                    g_dci_open_requests = g_dci_open_requests
                                          + self.dci_open_request_line(fn_id) + "\n";
                }
                if (vyx_bootstrap_profile_level() > 0
                    && ((fn_id % 100) == 0 || fn_id >= 900)) {
                    print("[llvm-mir-declare] before fn="
                          + policy_i64_to_string(fn_id as i64)
                          + " name=" + self.m.function_name(fn_id));
                }
                self.declare_function_signature(fn_id);
                if (vyx_bootstrap_profile_level() > 0
                    && ((fn_id % 100) == 0 || fn_id >= 900)) {
                    print("[llvm-mir-declare] after fn="
                          + policy_i64_to_string(fn_id as i64)
                          + " errors=" + policy_i64_to_string(self.error_count as i64));
                }
            }
            self.release_temp_strings(temp_string_mark);
            fn_id = fn_id + 1;
        }
        self.declared_function_scan_next = self.m.function_count + 1;
    }
}
