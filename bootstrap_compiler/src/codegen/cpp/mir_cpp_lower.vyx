module bootstrap.mir_cpp_lower;

/// OPTIONAL backend plugin: MIR → C++ source + CMake (`--emit=cpp`).
/// Not an acceptance backend. Hello-gate `--dump-mir2`, self-host
/// fixpoint, and DCI E2E all use the LLVM plugin in llvm_lower.vyx.
/// Failure or fallback-marker noise in this file must not block those gates.

use std.fs;
use std.string;
use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_abi;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;
use bootstrap.mir_builder;
use bootstrap.mir_backend;
use bootstrap.mir_ids;
use bootstrap.mir_model;
use bootstrap.mir_pass;
use bootstrap.mir_verify;
use bootstrap.policy;

public fn mir_cpp_plugin_name() -> string { return "cpp"; }
public fn mir_cpp_plugin_is_acceptance_backend() -> bool {
    return false;
}

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn vyx_bootstrap_mkdir_p(path: rawptr) -> i32;
    fn cJSON_Parse(text: rawptr) -> rawptr;
    fn cJSON_Delete(item: rawptr);
    fn cJSON_GetObjectItemCaseSensitive(object: rawptr, key: rawptr) -> rawptr;
    fn cJSON_GetArrayItem(array: rawptr, index: i32) -> rawptr;
    fn cJSON_GetArraySize(array: rawptr) -> i32;
    fn cJSON_GetStringValue(item: rawptr) -> rawptr;
    fn cJSON_GetNumberValue(item: rawptr) -> f64;
    fn cJSON_IsObject(item: rawptr) -> i32;
    fn cJSON_IsArray(item: rawptr) -> i32;
    fn cJSON_IsString(item: rawptr) -> i32;
    fn cJSON_IsNumber(item: rawptr) -> i32;
    fn cJSON_IsTrue(item: rawptr) -> i32;
    fn cJSON_IsFalse(item: rawptr) -> i32;
    fn cJSON_Compare(a: rawptr, b: rawptr, case_sensitive: i32) -> i32;
    fn cJSON_CreateArray() -> rawptr;
    fn cJSON_AddItemToArray(array: rawptr, item: rawptr) -> i32;
}

var g_mir_cpp_raw_callback_need_cache: rawptr = null;
var g_mir_cpp_raw_callback_need_value_buf: rawptr = null;
var g_mir_cpp_raw_callback_need_function_count: i32 = -1;
var g_mir_cpp_raw_callback_need_value_count: i32 = -1;
var g_mir_cpp_dci_root: rawptr = null;
var g_mir_cpp_dci_bundle: rawptr = null;
var g_mir_cpp_dci_source_key: string = "";

fn mir_cpp_report_error_at(loc: rawptr, message: string) {
    diag_emit_codegen_at(loc, "MIR C++ lowering failed: " + message);
}

fn mir_cpp_report_error(m: MirUnit, message: string) {
    mir_cpp_report_error_at(mir_unit_diag_first_loc(&m), message);
}

fn mir_cpp_report_error_at_value(m: MirUnit, value_id: i32, message: string) {
    mir_cpp_report_error_at(mir_unit_diag_loc_for_value(&m,  value_id), message);
}

fn mir_cpp_report_error_at_instr(m: MirUnit, instr_id: i32, message: string) {
    mir_cpp_report_error_at(mir_unit_diag_loc_for_instr(&m,  instr_id), message);
}

fn mir_cpp_report_error_at_function(m: MirUnit, function_id: i32, message: string) {
    mir_cpp_report_error_at(mir_unit_diag_loc_for_function(&m,  function_id), message);
}

fn mir_cpp_report_error_at_type(m: MirUnit, type_id: i32, message: string) {
    mir_cpp_report_error_at(mir_unit_diag_loc_for_type(&m,  type_id), message);
}

fn mir_cpp_dci_json_item(object: rawptr, key: string) -> rawptr {
    if (object == null || key.len == 0) { return null; }
    return cJSON_GetObjectItemCaseSensitive(object, key.c_str());
}

fn mir_cpp_dci_json_string(object: rawptr, key: string) -> string {
    let item = mir_cpp_dci_json_item(object, key);
    if (item == null || cJSON_IsString(item) == 0) { return ""; }
    let raw = cJSON_GetStringValue(item);
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn mir_cpp_dci_json_i64(object: rawptr, key: string) -> i64 {
    let item = mir_cpp_dci_json_item(object, key);
    if (item == null || cJSON_IsNumber(item) == 0) { return 0; }
    return cJSON_GetNumberValue(item) as i64;
}

fn mir_cpp_dci_json_exact_i64(object: rawptr, key: string, missing: i64) -> i64 {
    let item = mir_cpp_dci_json_item(object, key);
    if (item == null) { return missing; }
    if (cJSON_IsNumber(item) == 0) { return -1; }
    let raw = cJSON_GetNumberValue(item);
    if (raw != raw || raw < -9007199254740991.0 || raw > 9007199254740991.0) { return -1; }
    let integer = raw as i64;
    if ((integer as f64) != raw) { return -1; }
    return integer;
}

fn mir_cpp_dci_json_integer_valid(object: rawptr, key: string) -> bool {
    let item = mir_cpp_dci_json_item(object, key);
    if (item == null) { return true; }
    if (cJSON_IsNumber(item) == 0) { return false; }
    let raw = cJSON_GetNumberValue(item);
    if (raw != raw || raw < -9007199254740991.0 || raw > 9007199254740991.0) { return false; }
    return ((raw as i64) as f64) == raw;
}

fn mir_cpp_dci_json_array_is_empty(object: rawptr, key: string) -> bool {
    let item = mir_cpp_dci_json_item(object, key);
    return item == null || (cJSON_IsArray(item) != 0 && cJSON_GetArraySize(item) == 0);
}

fn mir_cpp_dci_power_of_two(value: i64) -> bool {
    if (value <= 0) { return false; }
    var power: i64 = 1;
    while (power < value && power < 4611686018427387904) { power = power * 2; }
    return power == value;
}

fn mir_cpp_dci_json_bool(object: rawptr, key: string) -> bool {
    let item = mir_cpp_dci_json_item(object, key);
    return item != null && cJSON_IsTrue(item) != 0;
}

fn mir_cpp_dci_dispose_bundle() {
    if (g_mir_cpp_dci_bundle != null) {
        cJSON_Delete(g_mir_cpp_dci_bundle);
    } else if (g_mir_cpp_dci_root != null) {
        cJSON_Delete(g_mir_cpp_dci_root);
    }
    g_mir_cpp_dci_bundle = null;
    g_mir_cpp_dci_root = null;
}

fn mir_cpp_dci_bundle(m: MirUnit) -> rawptr {
    if (!mir_unit_has_dci_abi(&m)) { return null; }
    let path = mir_unit_dci_abi_path(&m);
    let text = mir_unit_dci_abi_text(&m);
    var key = "json:" + text;
    if (dci_path_list_count(path.clone()) > 0) { key = "dcib:" + path; }
    if (g_mir_cpp_dci_bundle != null && g_mir_cpp_dci_source_key == key) {
        return g_mir_cpp_dci_bundle;
    }
    mir_cpp_dci_dispose_bundle();
    g_mir_cpp_dci_source_key = key;
    if (dci_path_list_count(path.clone()) > 0) {
        let loaded = dci_load_contract_bundle(path.clone());
        if (loaded.roots == null) {
            var detail = loaded.message;
            if (detail.len == 0) { detail = "unknown DCI error"; }
            mir_cpp_report_error(m, "invalid DCI contract: " + detail);
            return null;
        }
        g_mir_cpp_dci_bundle = loaded.roots;
        g_mir_cpp_dci_root = dci_bundle_root_at(g_mir_cpp_dci_bundle, 0);
    } else {
        g_mir_cpp_dci_root = cJSON_Parse(text.c_str());
        if (g_mir_cpp_dci_root == null) {
            mir_cpp_report_error(m, "invalid DCI JSON contract");
            return null;
        }
        let bundle = cJSON_CreateArray();
        if (bundle == null || cJSON_AddItemToArray(bundle, g_mir_cpp_dci_root) == 0) {
            if (bundle != null) { cJSON_Delete(bundle); }
            else { cJSON_Delete(g_mir_cpp_dci_root); }
            g_mir_cpp_dci_root = null;
            mir_cpp_report_error(m, "out of memory while loading DCI contracts");
            return null;
        }
        g_mir_cpp_dci_bundle = bundle;
    }
    var root_i: i32 = 0;
    let root_n = dci_bundle_count(g_mir_cpp_dci_bundle);
    while (root_i < root_n) {
        let root = dci_bundle_root_at(g_mir_cpp_dci_bundle, root_i);
        if (root == null || cJSON_IsObject(root) == 0) {
            mir_cpp_dci_dispose_bundle();
            mir_cpp_report_error(m, "DCI contract root is not an object");
            return null;
        }
        root_i = root_i + 1;
    }
    return g_mir_cpp_dci_bundle;
}

fn mir_cpp_dci_root(m: MirUnit) -> rawptr {
    mir_cpp_dci_bundle(m);
    return g_mir_cpp_dci_root;
}

fn mir_cpp_dci_contract_count(m: MirUnit) -> i32 {
    let bundle = mir_cpp_dci_bundle(m);
    if (bundle != null) { return dci_bundle_count(bundle); }
    if (g_mir_cpp_dci_root != null) { return 1; }
    return 0;
}

fn mir_cpp_dci_contract_at(m: MirUnit, index: i32) -> rawptr {
    let bundle = mir_cpp_dci_bundle(m);
    if (bundle != null) { return dci_bundle_root_at(bundle, index); }
    if (index == 0) { return g_mir_cpp_dci_root; }
    return null;
}

fn mir_cpp_dci_contract_path_at(m: MirUnit, index: i32) -> string {
    return dci_path_list_at(mir_unit_dci_abi_path(&m), index);
}

fn mir_cpp_dci_exports_array_from(root: rawptr, key: string) -> rawptr {
    let exports = mir_cpp_dci_json_item(root, "exports");
    let array = mir_cpp_dci_json_item(exports, key);
    if (array == null || cJSON_IsArray(array) == 0) { return null; }
    return array;
}

fn mir_cpp_dci_exports_array(m: MirUnit, key: string) -> rawptr {
    return mir_cpp_dci_exports_array_from(mir_cpp_dci_root(m), key);
}

fn mir_cpp_dci_root_is_rust(root: rawptr) -> bool {
    return dci_bundle_source_language(root) == "rust";
}

fn mir_cpp_dci_rust_root_index(m: MirUnit) -> i32 {
    var i: i32 = 0;
    let n = mir_cpp_dci_contract_count(m);
    while (i < n) {
        if (mir_cpp_dci_root_is_rust(mir_cpp_dci_contract_at(m, i))) { return i; }
        i = i + 1;
    }
    return -1;
}

fn mir_cpp_dci_rust_root(m: MirUnit) -> rawptr {
    let index = mir_cpp_dci_rust_root_index(m);
    if (index < 0) { return null; }
    return mir_cpp_dci_contract_at(m, index);
}

fn mir_cpp_output_is_rust_stub(path: string) -> bool {
    return path.toLower().endsWith(".rs");
}

fn mir_cpp_dci_canonical_type_name(raw: string) -> string {
    // Vyx spells a concrete generic instantiation with turbofish
    // (`fmt.basic_string_view::<char>`); after `::`->`.` that leaves a stray
    // `.` before `<`. A DCI contract spells the same C++ template
    // specialization as `fmt::basic_string_view<char>`. Normalising `.<`->`<`
    // makes both forms canonicalise to `fmt.basic_string_view<char>` so a Vyx
    // instantiation matches the contract record/field/parameter type.
    return raw.trim()
        .replace("::", ".")
        .replace("class ", "")
        .replace("struct ", "")
        .replace("enum ", "")
        .replace(" ", "")
        .replace(".<", "<");
}

fn mir_cpp_dci_contract_type_names_match(lhs: string, rhs: string) -> bool {
    let a = mir_cpp_dci_canonical_type_name(lhs);
    let b = mir_cpp_dci_canonical_type_name(rhs);
    return a.len > 0 && b.len > 0 && a == b;
}

fn mir_cpp_dci_layout_in_root(root: rawptr, type_name: string) -> rawptr {
    if (root == null || type_name.len == 0) { return null; }
    let layouts = mir_cpp_dci_exports_array_from(root, "layouts");
    if (layouts == null) { return null; }
    var index: i32 = 0;
    while (index < cJSON_GetArraySize(layouts)) {
        let layout = cJSON_GetArrayItem(layouts, index);
        if (mir_cpp_dci_contract_type_names_match(
                mir_cpp_dci_json_string(layout, "type_name"), type_name)) {
            return layout;
        }
        index = index + 1;
    }
    return null;
}

fn mir_cpp_dci_layout_for_type(m: MirUnit, type_id: i32) -> rawptr {
    if (!mir_unit_type_is_foreign_dci(&m,  type_id)) { return null; }
    return mir_cpp_dci_layout_for_name(m, mir_cpp_type_source_text(m, type_id));
}

fn mir_cpp_dci_layout_for_name(m: MirUnit, type_name: string) -> rawptr {
    if (type_name.len == 0) { return null; }
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let layout = mir_cpp_dci_layout_in_root(mir_cpp_dci_contract_at(m, root_i), type_name);
        if (layout != null) { return layout; }
        root_i = root_i + 1;
    }
    return null;
}

fn mir_cpp_dci_layout_is_rust(m: MirUnit, type_name: string) -> bool {
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let root = mir_cpp_dci_contract_at(m, root_i);
        let layout = mir_cpp_dci_layout_in_root(root, type_name);
        if (layout != null) {
            if (mir_cpp_dci_root_is_rust(root)) { return true; }
            let rust = mir_cpp_dci_json_item(layout, "rust");
            return rust != null && cJSON_IsObject(rust) != 0;
        }
        root_i = root_i + 1;
    }
    return false;
}

fn mir_cpp_dci_field_match_count(m: MirUnit,
                                 layout: rawptr,
                                 field_name: string,
                                 depth: i32) -> i32 {
    if (layout == null || field_name.len == 0 || depth > 32) { return 0; }
    var count: i32 = 0;
    let fields = mir_cpp_dci_json_item(layout, "fields");
    if (fields != null && cJSON_IsArray(fields) != 0) {
        var field_i: i32 = 0;
        while (field_i < cJSON_GetArraySize(fields)) {
            let field = cJSON_GetArrayItem(fields, field_i);
            if (mir_cpp_dci_json_string(field, "name") == field_name) { count = count + 1; }
            field_i = field_i + 1;
        }
    }
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases != null && cJSON_IsArray(bases) != 0) {
        var base_i: i32 = 0;
        while (base_i < cJSON_GetArraySize(bases)) {
            let base = cJSON_GetArrayItem(bases, base_i);
            let base_layout = mir_cpp_dci_layout_for_name(
                m, mir_cpp_dci_json_string(base, "type_name"));
            count = count + mir_cpp_dci_field_match_count(m, base_layout, field_name, depth + 1);
            base_i = base_i + 1;
        }
    }
    return count;
}

fn mir_cpp_dci_field_object(m: MirUnit,
                            layout: rawptr,
                            field_name: string,
                            depth: i32) -> rawptr {
    if (layout == null || field_name.len == 0 || depth > 32) { return null; }
    let fields = mir_cpp_dci_json_item(layout, "fields");
    if (fields != null && cJSON_IsArray(fields) != 0) {
        var field_i: i32 = 0;
        while (field_i < cJSON_GetArraySize(fields)) {
            let field = cJSON_GetArrayItem(fields, field_i);
            if (mir_cpp_dci_json_string(field, "name") == field_name) { return field; }
            field_i = field_i + 1;
        }
    }
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases != null && cJSON_IsArray(bases) != 0) {
        var base_i: i32 = 0;
        while (base_i < cJSON_GetArraySize(bases)) {
            let base = cJSON_GetArrayItem(bases, base_i);
            let base_layout = mir_cpp_dci_layout_for_name(
                m, mir_cpp_dci_json_string(base, "type_name"));
            let field = mir_cpp_dci_field_object(m, base_layout, field_name, depth + 1);
            if (field != null) { return field; }
            base_i = base_i + 1;
        }
    }
    return null;
}

fn mir_cpp_dci_base_constant_offset(base: rawptr) -> i64 {
    if (base == null || mir_cpp_dci_json_bool(base, "is_virtual")) { return -1; }
    let adjustment = mir_cpp_dci_json_item(base, "adjustment");
    if (adjustment == null) {
        return mir_cpp_dci_json_exact_i64(base, "offset", 0);
    }
    if (cJSON_IsObject(adjustment) == 0
        || mir_cpp_dci_json_string(adjustment, "kind") != "constant") {
        return -1;
    }
    return mir_cpp_dci_json_exact_i64(adjustment, "offset", -1);
}

fn mir_cpp_dci_base_path_count(m: MirUnit,
                               derived_name: string,
                               base_name: string,
                               depth: i32) -> i32 {
    if (derived_name.len == 0 || base_name.len == 0 || depth > 32) { return 0; }
    if (mir_cpp_dci_contract_type_names_match(derived_name, base_name)) { return 1; }
    let layout = mir_cpp_dci_layout_for_name(m, derived_name);
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases == null || cJSON_IsArray(bases) == 0) { return 0; }
    var count: i32 = 0;
    var base_i: i32 = 0;
    while (base_i < cJSON_GetArraySize(bases)) {
        let base = cJSON_GetArrayItem(bases, base_i);
        let direct_name = mir_cpp_dci_json_string(base, "type_name");
        count = count + mir_cpp_dci_base_path_count(m, direct_name, base_name, depth + 1);
        base_i = base_i + 1;
    }
    return count;
}

fn mir_cpp_dci_base_offset_between_names(m: MirUnit,
                                         derived_name: string,
                                         base_name: string,
                                         depth: i32) -> i64 {
    if (derived_name.len == 0 || base_name.len == 0 || depth > 32) { return -1; }
    if (mir_cpp_dci_contract_type_names_match(derived_name, base_name)) { return 0; }
    let layout = mir_cpp_dci_layout_for_name(m, derived_name);
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases == null || cJSON_IsArray(bases) == 0) { return -1; }
    var base_i: i32 = 0;
    while (base_i < cJSON_GetArraySize(bases)) {
        let base = cJSON_GetArrayItem(bases, base_i);
        let direct_name = mir_cpp_dci_json_string(base, "type_name");
        if (mir_cpp_dci_base_path_count(m, direct_name, base_name, depth + 1) > 0) {
            let direct_offset = mir_cpp_dci_base_constant_offset(base);
            let nested_offset = mir_cpp_dci_base_offset_between_names(
                m, direct_name, base_name, depth + 1);
            if (direct_offset < 0 || nested_offset < 0) { return -1; }
            return direct_offset + nested_offset;
        }
        base_i = base_i + 1;
    }
    return -1;
}

fn mir_cpp_dci_unique_base_offset(m: MirUnit,
                                  derived_name: string,
                                  base_name: string) -> i64 {
    if (mir_cpp_dci_base_path_count(m, derived_name, base_name, 0) != 1) { return -1; }
    return mir_cpp_dci_base_offset_between_names(m, derived_name, base_name, 0);
}

fn mir_cpp_dci_field_offset(m: MirUnit,
                            layout: rawptr,
                            field_name: string,
                            depth: i32) -> i64 {
    if (layout == null || field_name.len == 0 || depth > 32) { return -1; }
    let fields = mir_cpp_dci_json_item(layout, "fields");
    if (fields != null && cJSON_IsArray(fields) != 0) {
        var field_i: i32 = 0;
        while (field_i < cJSON_GetArraySize(fields)) {
            let field = cJSON_GetArrayItem(fields, field_i);
            if (mir_cpp_dci_json_string(field, "name") == field_name) {
                if (mir_cpp_dci_json_item(field, "bit_width") != null) { return -1; }
                return mir_cpp_dci_json_exact_i64(field, "offset", -1);
            }
            field_i = field_i + 1;
        }
    }
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases != null && cJSON_IsArray(bases) != 0) {
        var base_i: i32 = 0;
        while (base_i < cJSON_GetArraySize(bases)) {
            let base = cJSON_GetArrayItem(bases, base_i);
            let base_layout = mir_cpp_dci_layout_for_name(
                m, mir_cpp_dci_json_string(base, "type_name"));
            if (mir_cpp_dci_field_match_count(m, base_layout, field_name, depth + 1) > 0) {
                let base_offset = mir_cpp_dci_base_constant_offset(base);
                let field_offset = mir_cpp_dci_field_offset(m, base_layout, field_name, depth + 1);
                if (base_offset < 0 || field_offset < 0) { return -1; }
                return base_offset + field_offset;
            }
            base_i = base_i + 1;
        }
    }
    return -1;
}

fn mir_cpp_dci_layout_size(m: MirUnit, type_id: i32) -> i64 {
    return mir_cpp_dci_json_exact_i64(mir_cpp_dci_layout_for_type(m, type_id), "size", -1);
}

fn mir_cpp_dci_layout_alignment(m: MirUnit, type_id: i32) -> i64 {
    return mir_cpp_dci_json_exact_i64(mir_cpp_dci_layout_for_type(m, type_id), "alignment", -1);
}

fn mir_cpp_dci_symbol_kind_for_function(m: MirUnit, function_id: i32) -> string {
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) { return "constructor"; }
    if (mir_unit_function_is_foreign_dci_dtor(&m,  function_id)) { return "destructor"; }
    if (mir_unit_function_is_foreign_dci_free_function(&m,  function_id)) { return "function"; }
    return "method";
}

fn mir_cpp_dci_symbol_member_for_function(m: MirUnit, function_id: i32) -> string {
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) { return "constructor"; }
    if (mir_unit_function_is_foreign_dci_dtor(&m,  function_id)) { return "destructor"; }
    return policy_generic_call_base(m.function_name(function_id).clone());
}

fn mir_cpp_dci_normalized_type_for_type(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return ""; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        let elem = hir_type_table_elem(m.types, type_id);
        if (elem == mir_id_invalid()) { return "*void"; }
        return "*" + mir_cpp_dci_normalized_type_for_type(m, elem);
    }
    if (kind == ty_VOID()) { return "void"; }
    if (kind == ty_BOOL()) { return "bool"; }
    if (kind == ty_CHAR()) { return "char"; }
    if (kind == ty_I8()) { return "i8"; }
    if (kind == ty_U8()) { return "u8"; }
    if (kind == ty_I16()) { return "i16"; }
    if (kind == ty_U16()) { return "u16"; }
    if (kind == ty_I32()) { return "i32"; }
    if (kind == ty_U32()) { return "u32"; }
    if (kind == ty_I64() || kind == ty_ISIZE()) { return "i64"; }
    if (kind == ty_U64() || kind == ty_USIZE()) { return "u64"; }
    if (kind == ty_F32()) { return "f32"; }
    if (kind == ty_F64()) { return "f64"; }
    if (kind == ty_RAWPTR() || kind == ty_STRING()) { return "*void"; }
    return mir_cpp_type_source_text(m, type_id).replace("::", ".");
}

fn mir_cpp_dci_type_object_name(type_object: rawptr) -> string {
    if (type_object == null) { return ""; }
    let name = mir_cpp_dci_json_string(type_object, "name");
    let reference = mir_cpp_dci_json_string(type_object, "reference");
    if (reference == "pointer" || reference == "pointer_const" || reference == "pointer_mut") {
        let pointee = mir_cpp_dci_json_item(type_object, "pointee");
        if (pointee != null && cJSON_IsObject(pointee) != 0) {
            let inner = mir_cpp_dci_type_object_name(pointee);
            if (inner.len > 0) { return "*" + inner; }
        }
        if (name.len > 0) { return "*" + name; }
        return "*void";
    }
    if (reference == "reference") {
        let pointee2 = mir_cpp_dci_json_item(type_object, "pointee");
        if (pointee2 != null && cJSON_IsObject(pointee2) != 0) {
            let inner2 = mir_cpp_dci_type_object_name(pointee2);
            if (inner2.len > 0) { return "&" + inner2; }
        }
        if (name.len > 0) { return "&" + name; }
        return "&";
    }
    return name;
}

fn mir_cpp_dci_type_object_matches(m: MirUnit, type_object: rawptr, type_id: i32) -> bool {
    if (type_object == null || type_id == mir_id_invalid()) { return false; }
    if (mir_cpp_dci_json_string(type_object, "kind") == "function") {
        if (mir_cpp_type_kind(m, type_id) != ty_CFN() || !dci_abi_is_cfn_pointer(type_object)) { return false; }
        let signature = mir_cpp_dci_json_item(type_object, "signature");
        let params = mir_cpp_dci_json_item(signature, "params");
        let text = mir_cpp_type_source_text(m, type_id);
        let count = cJSON_GetArraySize(params);
        var i: i32 = 0;
        while (i < count) {
            let param_id = mir_cpp_find_type_by_source_text(m, dci_abi_cfn_param_text(text, i));
            if (!mir_cpp_dci_type_object_matches(m, cJSON_GetArrayItem(params, i), param_id)) { return false; }
            i = i + 1;
        }
        if (dci_abi_cfn_param_text(text, count).len > 0) { return false; }
        return mir_cpp_dci_type_object_matches(m, mir_cpp_dci_json_item(signature, "return"),
            hir_type_table_elem(m.types, type_id));
    }
    let declared = mir_cpp_dci_type_object_name(type_object);
    let actual = mir_cpp_dci_normalized_type_for_type(m, type_id);
    if (mir_cpp_dci_contract_type_names_match(declared, actual)) { return true; }
    let enum_name = mir_cpp_dci_json_string(type_object, "enum_name");
    return enum_name.len > 0 && mir_cpp_dci_contract_type_names_match(enum_name, actual);
}

fn mir_cpp_dci_receiver_param_count(m: MirUnit, function_id: i32) -> i32 {
    if (mir_unit_function_is_foreign_dci_instance_method(&m,  function_id)
        && !mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) {
        return 1;
    }
    return 0;
}

fn mir_cpp_dci_symbol_params_match(m: MirUnit, symbol: rawptr, function_id: i32) -> bool {
    let params = mir_cpp_dci_json_item(symbol, "params");
    let receiver_count = mir_cpp_dci_receiver_param_count(m, function_id);
    let wanted = mir_unit_function_param_count(&m,  function_id) - receiver_count;
    if (wanted < 0) { return false; }
    if (params == null || cJSON_IsArray(params) == 0) { return wanted == 0; }
    if (cJSON_GetArraySize(params) != wanted) { return false; }
    var index: i32 = 0;
    while (index < wanted) {
        let param = cJSON_GetArrayItem(params, index);
        let type_object = mir_cpp_dci_json_item(param, "type");
        let type_id = mir_unit_function_param_type_at(&m,  function_id, index + receiver_count);
        if (!mir_cpp_dci_type_object_matches(m, type_object, type_id)) { return false; }
        index = index + 1;
    }
    return true;
}

fn mir_cpp_dci_symbol_return_matches(m: MirUnit, symbol: rawptr, function_id: i32) -> bool {
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)
        || mir_unit_function_is_foreign_dci_dtor(&m,  function_id)) {
        return true;
    }
    let result = mir_cpp_dci_json_item(symbol, "return");
    if (result == null || cJSON_IsObject(result) == 0) {
        return mir_cpp_type_kind(m, m.function_return_type(function_id)) == ty_VOID();
    }
    return mir_cpp_dci_type_object_matches(m,
                                            mir_cpp_dci_json_item(result, "type"),
                                            m.function_return_type(function_id));
}

fn mir_cpp_dci_symbol_owner_matches(m: MirUnit, symbol: rawptr, function_id: i32) -> bool {
    let owner = mir_cpp_dci_json_string(symbol, "owner");
    if (mir_unit_function_is_foreign_dci_free_function(&m,  function_id)) { return owner.len == 0; }
    return mir_cpp_dci_contract_type_names_match(owner, mir_unit_foreign_dci_owner_type_text(&m,  function_id));
}

fn mir_cpp_dci_symbol_member_matches(m: MirUnit, symbol: rawptr, function_id: i32) -> bool {
    let wanted = mir_cpp_dci_symbol_member_for_function(m, function_id);
    let member = mir_cpp_dci_json_string(symbol, "member_name");
    if (wanted == "constructor") { return member == "constructor"; }
    if (wanted == "destructor") {
        if (member == "destructor") { return true; }
        let owner = mir_cpp_dci_json_string(symbol, "owner").replace("::", ".");
        return member == "~" + mir_cpp_last_path_segment(owner);
    }
    var actual = member;
    if (actual.len == 0) { actual = mir_cpp_dci_json_string(symbol, "name"); }
    return actual == wanted;
}

fn mir_cpp_dci_symbol_matches(m: MirUnit, symbol: rawptr, function_id: i32) -> bool {
    if (symbol == null || cJSON_IsObject(symbol) == 0) { return false; }
    if (mir_cpp_dci_json_string(symbol, "kind") != mir_cpp_dci_symbol_kind_for_function(m, function_id)) {
        return false;
    }
    if (!mir_cpp_dci_symbol_owner_matches(m, symbol, function_id)
        || !mir_cpp_dci_symbol_member_matches(m, symbol, function_id)
        || !mir_cpp_dci_symbol_params_match(m, symbol, function_id)
        || !mir_cpp_dci_symbol_return_matches(m, symbol, function_id)) {
        return false;
    }
    if (mir_unit_function_is_foreign_dci_static_method(&m,  function_id)
        && !mir_cpp_dci_json_bool(symbol, "is_static")) {
        return false;
    }
    if (mir_unit_function_is_foreign_dci_instance_method(&m,  function_id)
        && !mir_unit_function_is_foreign_dci_ctor(&m,  function_id)
        && mir_cpp_dci_json_bool(symbol, "is_static")) {
        return false;
    }
    if (mir_unit_function_is_foreign_dci_const_method(&m,  function_id)
        != mir_cpp_dci_json_bool(symbol, "is_const")) {
        return false;
    }
    return mir_cpp_dci_json_string(symbol, "link_name").len > 0
        || mir_cpp_dci_json_string(symbol, "mangled").len > 0;
}

fn mir_cpp_dci_symbol_for_function(m: MirUnit, function_id: i32) -> rawptr {
    if (!mir_unit_function_is_foreign_dci(&m,  function_id)) { return null; }
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let symbols = mir_cpp_dci_exports_array_from(mir_cpp_dci_contract_at(m, root_i), "symbols");
        if (symbols != null) {
            let count = cJSON_GetArraySize(symbols);
            var index: i32 = 0;
            while (index < count) {
                let symbol = cJSON_GetArrayItem(symbols, index);
                if (mir_cpp_dci_symbol_matches(m, symbol, function_id)) { return symbol; }
                index = index + 1;
            }
        }
        root_i = root_i + 1;
    }
    return null;
}

fn mir_cpp_dci_link_name(m: MirUnit, function_id: i32) -> string {
    let symbol = mir_cpp_dci_symbol_for_function(m, function_id);
    var name = mir_cpp_dci_json_string(symbol, "link_name");
    if (name.len == 0) { name = mir_cpp_dci_json_string(symbol, "mangled"); }
    return name;
}

fn mir_cpp_dci_abi_object(m: MirUnit, function_id: i32) -> rawptr {
    let abi = mir_cpp_dci_json_item(mir_cpp_dci_symbol_for_function(m, function_id), "abi");
    if (abi == null || cJSON_IsObject(abi) == 0) { return null; }
    return abi;
}

fn mir_cpp_dci_abi_parameters(m: MirUnit, function_id: i32) -> rawptr {
    let abi = mir_cpp_dci_abi_object(m, function_id);
    if (abi == null) { return null; }
    let canonical = mir_cpp_dci_json_item(abi, "parameters");
    let legacy = mir_cpp_dci_json_item(abi, "params");
    if (canonical != null && legacy != null && cJSON_Compare(canonical, legacy, 1) == 0) {
        return null;
    }
    var out = canonical;
    if (out == null) { out = legacy; }
    if (out == null || cJSON_IsArray(out) == 0) { return null; }
    return out;
}

fn mir_cpp_dci_parameter_source_index(lowering: rawptr, physical_index: i32) -> i32 {
    if (lowering == null || cJSON_IsObject(lowering) == 0) { return -1; }
    if (mir_cpp_dci_json_item(lowering, "index") == null) { return physical_index; }
    let index = mir_cpp_dci_json_exact_i64(lowering, "index", -1);
    if (index < 0 || index > 2147483647) { return -1; }
    return index as i32;
}

fn mir_cpp_dci_parameter_lowering(m: MirUnit,
                                  function_id: i32,
                                  source_index: i32) -> rawptr {
    let params = mir_cpp_dci_abi_parameters(m, function_id);
    if (params == null || source_index < 0) { return null; }
    let count = cJSON_GetArraySize(params);
    var matched: rawptr = null;
    var physical: i32 = 0;
    while (physical < count) {
        let lowering = cJSON_GetArrayItem(params, physical);
        if (mir_cpp_dci_parameter_source_index(lowering, physical) == source_index) {
            if (matched != null) { return null; }
            matched = lowering;
        }
        physical = physical + 1;
    }
    return matched;
}

fn mir_cpp_dci_alias_name(function_id: i32) -> string {
    return "vyx_dci_direct_" + mir_cpp_i32(function_id);
}

fn mir_cpp_i32(id: i32) -> string { return policy_i64_to_string(id as i64); }

fn mir_cpp_type_kind(m: MirUnit, type_id: i32) -> i32 {
    return mir_backend_type_kind(&m, type_id);
}

fn mir_cpp_type_source_text(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return ""; }
    return mir_backend_type_text(&m, type_id).clone();
}

fn mir_cpp_type_is_foreign_cpp(m: MirUnit, type_id: i32) -> bool {
    return mir_unit_type_is_foreign_cpp(&m,  type_id);
}

fn mir_cpp_function_is_foreign_cpp(m: MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_cpp(&m,  function_id);
}

fn mir_cpp_function_is_foreign_c(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) {
        return false;
    }
    return m.function_item_kind(function_id) == hir_item_extern_function()
        && !mir_cpp_function_is_foreign_cpp(m, function_id);
}

fn mir_cpp_type_is_pointer_handle(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    return mir_backend_kind_pointer_handle(mir_cpp_type_kind(m, type_id));
}

// A Vyx reference/pointer is a receiver view.  When a direct callee uses the
// normal class-reference ABI (`T&` in generated C++), pass the viewed object
// instead of materializing a temporary T from the pointer handle.
fn mir_cpp_pointer_receiver_expr_for_ref_param(m: MirUnit,
                                                value_id: i32,
                                                function_id: i32,
                                                param_index: i32) -> string {
    if (!mir_cpp_function_param_needs_ref_at(m, function_id, param_index)) { return ""; }
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return ""; }
    let source_type = m.value_type(value_id);
    if (!mir_cpp_type_is_pointer_handle(m, source_type)) { return ""; }
    let pointee_type = hir_type_table_elem(m.types, source_type);
    let param_type = mir_cpp_function_param_type_at(m, function_id, param_index);
    if (pointee_type == mir_id_invalid() || param_type == mir_id_invalid()) { return ""; }
    if (pointee_type != param_type
        && mir_cpp_type_text(m, pointee_type) != mir_cpp_type_text(m, param_type)) {
        return "";
    }
    return "vyx::ptr_deref_as<" + mir_cpp_type_text(m, param_type) + ">("
        + mir_cpp_value_expr(m, value_id) + ")";
}

fn mir_cpp_foreign_c_type_text(m: MirUnit, function_id: i32, type_id: i32) -> string {
    if (mir_cpp_function_is_foreign_c(m, function_id)
        && mir_cpp_type_is_pointer_handle(m, type_id)) {
        return "void*";
    }
    return mir_cpp_type_text(m, type_id);
}

fn mir_cpp_function_is_foreign_cpp_ctor(m: MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_cpp_ctor(&m,  function_id);
}

fn mir_cpp_function_is_vyx_ctor(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (mir_cpp_function_is_foreign_cpp_ctor(m, function_id)) { return false; }
    if (m.function_owner_type(function_id).len == 0) { return false; }
    // A constructor of a *closed generic instance* is filed under its mangled
    // item name (`mir2$ProbeA_3A_3A_3Ci32_3E_3A_3Aconstructor_3A_3A...`), so the
    // raw `function_name` is an identifier and never the literal `constructor`.
    // The `hir_function_flag_constructor()` bit is what carries the identity
    // across instantiation (same rule as `hir_function_is_constructor_abi`);
    // the method-segment test covers units raised before the flag existed, and
    // for a plain non-generic constructor the segment is the whole name.
    if ((m.function_flags( function_id) & hir_function_flag_constructor()) != 0) { return true; }
    return mir_cpp_function_method_name(m, function_id) == "constructor";
}

// Keep direct-call implicit-self handling identical to LLVM MIR lowering.
// Besides source-level `constructor`, generic class helpers such as Box::new
// carry a self-receiver MIR parameter and are invoked without an explicit
// receiver. LLVM materializes a default receiver for every class-pointer-ABI
// self parameter; MIR2CPP must do the same instead of emitting an arity-invalid
// C++ call.
fn mir_cpp_function_needs_implicit_self_arg(m: MirUnit, function_id: i32) -> bool {
    if (mir_cpp_function_is_vyx_ctor(m, function_id)) { return true; }
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    // Generic ownership constructors such as Box::new expose their default
    // payload as MIR parameter #0. LLVM's call builder pads the omitted
    // argument with null/default storage, so emit the same argument in C++.
    if (m.function_name(function_id).contains("_3A_3Anew_3A_3A")
        && m.function_owner_type(function_id).len > 0) {
        return true;
    }
    let first_local = mir_cpp_function_param_local_at(m, function_id, 0);
    if (first_local == mir_id_invalid()
        || (m.local_flags(first_local) & mir_local_flag_self_receiver()) == 0) {
        return false;
    }
    return mir_cpp_type_uses_class_reference_abi(m, m.local_type(first_local));
}

fn mir_cpp_type_source_is_pointer_like(text_raw: string) -> bool {
    let text = mir_cpp_trim(text_raw);
    if (text.startsWith("&") || text.startsWith("*")) { return true; }
    if (text.startsWith("ptr<") || text.startsWith("ref<") || text.startsWith("mutref<")) { return true; }
    if (text.startsWith("ptr::") || text.startsWith("ref::") || text.startsWith("mutref::")) { return true; }
    return false;
}

fn mir_cpp_function_source_name(m: MirUnit, function_id: i32) -> string {
    if (function_id == mir_id_invalid()) { return ""; }
    return m.function_name(function_id).clone();
}

fn mir_cpp_local_source_name(m: MirUnit, local_id: i32) -> string {
    if (local_id == mir_id_invalid()) { return ""; }
    return m.local_name(local_id).clone();
}

fn mir_cpp_static_source_name(m: MirUnit, static_id: i32) -> string {
    if (static_id == mir_id_invalid()) { return ""; }
    return m.static_name(static_id).clone();
}

fn mir_cpp_field_source_name(m: MirUnit, field_id: i32) -> string {
    if (field_id == mir_id_invalid()) { return ""; }
    return m.field_name(field_id).clone();
}

fn mir_cpp_value_source_name(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()) { return ""; }
    return m.value_name(value_id).clone();
}

fn mir_cpp_value_source_text(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()) { return ""; }
    return m.value_text(value_id).clone();
}

fn mir_cpp_instr_source_name(m: MirUnit, instr_id: i32) -> string {
    if (instr_id == mir_id_invalid()) { return ""; }
    return m.instr_name(instr_id).clone();
}

fn mir_cpp_join(dir: string, rel: string) -> string {
    if (dir.len == 0 || dir == ".") { return rel; }
    if (dir.endsWith("/") || dir.endsWith("\\")) { return dir + rel; }
    return dir + "/" + rel;
}

fn mir_cpp_mkdir(path: string) -> i32 {
    if (path.len == 0 || path == ".") { return 0; }
    return vyx_bootstrap_mkdir_p(path.c_str());
}

fn mir_cpp_is_ident_char(c: i32) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    return c == 95;
}

fn mir_cpp_is_digit_char(c: i32) -> bool {
    return c >= 48 && c <= 57;
}

fn mir_cpp_is_number_text(text: string) -> bool {
    if (text.len == 0) { return false; }
    var i: i32 = 0;
    while (i < text.len) {
        if (!mir_cpp_is_digit_char(text.charAt(i))) { return false; }
        i = i + 1;
    }
    return true;
}

fn mir_cpp_trim(text: string) -> string {
    var lo: i32 = 0;
    var hi: i32 = text.len as i32;
    while (lo < hi) {
        let c = text.charAt(lo);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        lo = lo + 1;
    }
    while (hi > lo) {
        let c2 = text.charAt(hi - 1);
        if (c2 != 32 && c2 != 9 && c2 != 10 && c2 != 13) { break; }
        hi = hi - 1;
    }
    return text.substring(lo, hi);
}

fn mir_cpp_string_find(hay: string, needle: string, start_at: i32) -> i32 {
    if (needle.len == 0) { return start_at; }
    if (hay.len == 0 || needle.len > hay.len) { return -1; }
    var i = start_at;
    if (i < 0) { i = 0; }
    while (i + needle.len <= hay.len) {
        var j: i32 = 0;
        var same = true;
        while (j < needle.len && same) {
            if (hay.charAt(i + j) != needle.charAt(j)) { same = false; }
            j = j + 1;
        }
        if (same) { return i; }
        i = i + 1;
    }
    return -1;
}

fn mir_cpp_top_level_csv_part(text: string, want: i32) -> string {
    var start: i32 = 0;
    var depth_angle: i32 = 0;
    var depth_paren: i32 = 0;
    var depth_bracket: i32 = 0;
    var idx: i32 = 0;
    var part_index: i32 = 0;
    while (idx <= text.len) {
        var split = false;
        if (idx == text.len) {
            split = true;
        } else {
            let ch = text.charAt(idx);
            if (ch == 60) { depth_angle = depth_angle + 1; }
            else if (ch == 62 && depth_angle > 0) { depth_angle = depth_angle - 1; }
            else if (ch == 40) { depth_paren = depth_paren + 1; }
            else if (ch == 41 && depth_paren > 0) { depth_paren = depth_paren - 1; }
            else if (ch == 91) { depth_bracket = depth_bracket + 1; }
            else if (ch == 93 && depth_bracket > 0) { depth_bracket = depth_bracket - 1; }
            else if (ch == 44 && depth_angle == 0 && depth_paren == 0 && depth_bracket == 0) { split = true; }
        }
        if (split) {
            if (part_index == want) { return mir_cpp_trim(text.substring(start, idx)); }
            part_index = part_index + 1;
            start = idx + 1;
        }
        idx = idx + 1;
    }
    return "";
}

fn mir_cpp_generic_arg_for_param(m: MirUnit, function_id: i32, param_name: string) -> string {
    let params = m.function_generic_params(function_id);
    let args = m.function_generic_args(function_id);
    var idx: i32 = 0;
    while (idx < 64) {
        let p = mir_cpp_top_level_csv_part(params, idx);
        if (p.len == 0) { return ""; }
        if (p == param_name) { return mir_cpp_top_level_csv_part(args, idx); }
        idx = idx + 1;
    }
    return "";
}

fn mir_cpp_sizeof_type_source_from_name(name: string) -> string {
    var open: i32 = -1;
    var close: i32 = -1;
    var i: i32 = 0;
    while (i < name.len) {
        let ch = name.charAt(i);
        if (ch == 60 && open < 0) { open = i; }
        if (ch == 62) { close = i; }
        i = i + 1;
    }
    if (open >= 0 && close > open) { return mir_cpp_trim(name.substring(open + 1, close)); }
    return "";
}

fn mir_cpp_sizeof_type_is_known(m: MirUnit, type_id: i32) -> bool {
    return mir_cpp_storage_size_for_type(m, type_id, 0) > 0;
}

fn mir_cpp_sizeof_expr(m: MirUnit, value_id: i32, name: string) -> string {
    var type_source = mir_cpp_sizeof_type_source_from_name(name);
    if (type_source.len > 0) {
        let mapped = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), type_source);
        if (mapped.len > 0) { type_source = mapped; }
        let type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
        let size = mir_cpp_storage_size_for_type(m, type_id, 0);
        if (size > 0) {
            return "static_cast<int64_t>(" + policy_i64_to_string(size) + ")";
        }
    }
    return "";
}

fn mir_cpp_repr_sizeof_type_text(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return ""; }
    if (hir_type_table_is_open(m.types, type_id)) { return ""; }
    let ty = mir_cpp_type_text(m, type_id);
    if (ty.len == 0 || ty == "void" || ty == "vyx::Any") { return ""; }
    return ty;
}

fn mir_cpp_repr_sizeof_expr(m: MirUnit, value_id: i32, name: string) -> string {
    var type_source = mir_cpp_sizeof_type_source_from_name(name);
    if (type_source.len > 0) {
        let mapped = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), type_source);
        if (mapped.len > 0) { type_source = mapped; }
        let type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
        let ty = mir_cpp_repr_sizeof_type_text(m, type_id);
        if (ty.len > 0) {
            return "static_cast<int64_t>(sizeof(" + ty + "))";
        }
    }
    return "";
}

fn mir_cpp_repr_sizeof_function_expr(m: MirUnit, function_id: i32) -> string {
    if (function_id == mir_id_invalid()
        || function_id <= 0
        || function_id > m.function_count) {
        return "";
    }
    var type_source = mir_cpp_top_level_csv_part(m.function_generic_args(function_id), 0);
    var binding_start: i32 = -1;
    var i: i32 = 0;
    while (i + 1 < type_source.len && binding_start < 0) {
        if (type_source.charAt(i) == 61 && type_source.charAt(i + 1) == 62) {
            binding_start = i + 2;
        }
        i = i + 1;
    }
    if (binding_start >= 0) {
        type_source = mir_cpp_top_level_csv_part(
            type_source.substring(binding_start, type_source.len), 0);
    }
    var type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
    if (type_id == mir_id_invalid()) {
        let function_name = m.function_name(function_id);
        binding_start = -1;
        i = 0;
        while (i + 1 < function_name.len && binding_start < 0) {
            if (function_name.charAt(i) == 61 && function_name.charAt(i + 1) == 62) {
                binding_start = i + 2;
            }
            i = i + 1;
        }
        if (binding_start >= 0) {
            type_source = mir_cpp_top_level_csv_part(
                function_name.substring(binding_start, function_name.len), 0);
            type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
        }
    }
    let ty = mir_cpp_repr_sizeof_type_text(m, type_id);
    if (ty.len == 0) { return ""; }
    return "static_cast<int64_t>(sizeof(" + ty + "))";
}

fn mir_cpp_storage_align_for_type(m: MirUnit, type_id: i32) -> i64 {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return 0; }
    if (hir_type_table_is_open(m.types, type_id)) { return 0; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
    if (kind == ty_I16() || kind == ty_U16()) { return 2; }
    if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
    if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
        || kind == ty_F64() || kind == ty_RAWPTR() || kind == ty_PTR()
        || kind == ty_REF() || kind == ty_MUTREF() || kind == ty_FN()
        || kind == ty_CFN() || kind == ty_STRING() || kind == ty_RANGE()) {
        return 8;
    }
    if (kind == ty_ARRAY()) {
        let elem_type = hir_type_table_elem(m.types, type_id);
        let elem_align = mir_cpp_storage_align_for_type(m, elem_type);
        if (elem_align > 0) { return elem_align; }
        return 0;
    }
    if (kind == ty_TUPLE()) {
        let text = mir_cpp_type_source_text(m, type_id);
        if (text.len >= 2 && text.startsWith("(") && text.endsWith(")")) {
            let inner = text.substring(1, text.len - 1);
            if (mir_cpp_trim(inner.clone()).len == 0) { return 1; }
            var out: i64 = 1;
            var idx: i32 = 0;
            while (idx < 256) {
                let elem_text = mir_cpp_top_level_csv_part(inner.clone(), idx);
                if (elem_text.len == 0) { return out; }
                let elem_type2 = mir_cpp_find_type_by_source_or_tail(m, elem_text);
                let elem_align2 = mir_cpp_storage_align_for_type(m, elem_type2);
                if (elem_align2 <= 0) { return 0; }
                if (elem_align2 > out) { out = elem_align2; }
                idx = idx + 1;
            }
            return 0;
        }
        return 0;
    }
    if (kind == ty_CLASS()) {
        if (mir_cpp_type_is_foreign_cpp(m, type_id)) {
            return mir_cpp_dci_layout_alignment(m, type_id);
        }
        return 8;
    }
    return 0;
}

fn mir_cpp_align_up(value: i64, align: i64) -> i64 {
    if (align <= 1) { return value; }
    let rem = value % align;
    if (rem == 0) { return value; }
    return value + (align - rem);
}

fn mir_cpp_parse_nonnegative_i64(text_raw: string) -> i64 {
    let text = mir_cpp_trim(text_raw);
    if (text.len == 0) { return -1; }
    var out: i64 = 0;
    var i: i32 = 0;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (ch < 48 || ch > 57) { return -1; }
        out = out * 10 + (ch - 48) as i64;
        i = i + 1;
    }
    return out;
}

fn mir_cpp_array_length_for_type(m: MirUnit, type_id: i32) -> i64 {
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.len < 3 || !text.startsWith("[") || !text.endsWith("]")) { return -1; }
    var semi: i32 = -1;
    var i: i32 = 1;
    while (i + 1 < text.len) {
        if (text.charAt(i) == 59) { semi = i; }
        i = i + 1;
    }
    if (semi <= 1) { return -1; }
    return mir_cpp_parse_nonnegative_i64(text.substring(semi + 1, text.len - 1));
}

fn mir_cpp_class_layout_base(m: MirUnit, type_id: i32) -> string {
    let source = mir_cpp_type_source_text(m, type_id);
    var base = policy_generic_call_base(source.clone());
    if (base.len == 0) { base = source; }
    return mir_cpp_last_path_segment(base);
}

fn mir_cpp_type_is_string_storage(m: MirUnit, type_id: i32) -> bool {
    let text = mir_cpp_type_source_text(m, type_id);
    return text == "str" || text == "string" || text == "__String";
}

fn mir_cpp_type_is_dyn_storage(m: MirUnit, type_id: i32) -> bool {
    return mir_cpp_type_source_text(m, type_id).startsWith("dyn")
        && m.field_count_for_type(type_id) <= 0;
}

fn mir_cpp_type_uses_storage_class_reference_abi(m: MirUnit, type_id: i32) -> bool {
    if (mir_cpp_type_kind(m, type_id) != ty_CLASS()) { return false; }
    if (mir_cpp_type_is_foreign_abi(m, type_id)) { return false; }
    if (mir_cpp_type_is_value_struct_abi(m, type_id)
        || mir_cpp_type_is_string_storage(m, type_id)
        || mir_cpp_type_is_dyn_storage(m, type_id)) {
        return false;
    }
    let base = mir_cpp_class_layout_base(m, type_id);
    if (base == "Option" || base == "Result") { return false; }
    if (m.variant_count_for_type(type_id) > 0 && m.field_count_for_type(type_id) == 0) {
        return false;
    }
    return true;
}

fn mir_cpp_class_generic_arg_type(m: MirUnit, type_id: i32, index: i32) -> i32 {
    let args = policy_generic_call_args(mir_cpp_type_source_text(m, type_id));
    let arg_text = policy_generic_arg_at(args, index);
    if (arg_text.len == 0) { return mir_id_invalid(); }
    return mir_cpp_find_type_by_source_or_tail(m, arg_text);
}

fn mir_cpp_record_lower_align(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32) { return 0; }
    let field_count = m.field_count_for_type(type_id);
    if (field_count <= 0) { return 0; }
    var max_align: i64 = 1;
    var index: i32 = 0;
    while (index < field_count) {
        let field_id = m.field_id_for_type_index(type_id, index);
        if (field_id == mir_id_invalid()) { return 0; }
        let field_align = mir_cpp_lower_type_align_for_type(m, m.field_type(field_id), depth + 1);
        if (field_align <= 0) { return 0; }
        if (field_align > max_align) { max_align = field_align; }
        index = index + 1;
    }
    return max_align;
}

fn mir_cpp_record_storage_size(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32) { return 0; }
    let field_count = m.field_count_for_type(type_id);
    if (field_count <= 0) { return 0; }
    var offset: i64 = 0;
    var max_align: i64 = 1;
    var index: i32 = 0;
    while (index < field_count) {
        let field_id = m.field_id_for_type_index(type_id, index);
        if (field_id == mir_id_invalid()) { return 0; }
        let field_type = m.field_type(field_id);
        let field_size = mir_cpp_lower_type_size_for_type(m, field_type, depth + 1);
        let field_align = mir_cpp_lower_type_align_for_type(m, field_type, depth + 1);
        if (field_size <= 0 || field_align <= 0) { return 0; }
        offset = mir_cpp_align_up(offset, field_align) + field_size;
        if (field_align > max_align) { max_align = field_align; }
        index = index + 1;
    }
    return mir_cpp_align_up(offset, max_align);
}

fn mir_cpp_tuple_lower_align(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32) { return 0; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.len < 2 || !text.startsWith("(") || !text.endsWith(")")) { return 0; }
    let inner = text.substring(1, text.len - 1);
    if (mir_cpp_trim(inner.clone()).len == 0) { return 0; }
    var max_align: i64 = 1;
    var index: i32 = 0;
    while (index < 256) {
        let elem_text = mir_cpp_top_level_csv_part(inner.clone(), index);
        if (elem_text.len == 0) { return max_align; }
        let elem_type = mir_cpp_find_type_by_source_or_tail(m, elem_text);
        let elem_align = mir_cpp_lower_type_align_for_type(m, elem_type, depth + 1);
        if (elem_align <= 0) { return 0; }
        if (elem_align > max_align) { max_align = elem_align; }
        index = index + 1;
    }
    return 0;
}

fn mir_cpp_tuple_storage_size(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32) { return 0; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.len < 2 || !text.startsWith("(") || !text.endsWith(")")) { return 0; }
    let inner = text.substring(1, text.len - 1);
    if (mir_cpp_trim(inner.clone()).len == 0) { return 0; }
    var offset: i64 = 0;
    var max_align: i64 = 1;
    var index: i32 = 0;
    while (index < 256) {
        let elem_text = mir_cpp_top_level_csv_part(inner.clone(), index);
        if (elem_text.len == 0) { return mir_cpp_align_up(offset, max_align); }
        let elem_type = mir_cpp_find_type_by_source_or_tail(m, elem_text);
        let elem_size = mir_cpp_lower_type_size_for_type(m, elem_type, depth + 1);
        let elem_align = mir_cpp_lower_type_align_for_type(m, elem_type, depth + 1);
        if (elem_size <= 0 || elem_align <= 0) { return 0; }
        offset = mir_cpp_align_up(offset, elem_align) + elem_size;
        if (elem_align > max_align) { max_align = elem_align; }
        index = index + 1;
    }
    return 0;
}

fn mir_cpp_option_lower_align(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    let payload_type = mir_cpp_class_generic_arg_type(m, type_id, 0);
    let payload_align = mir_cpp_lower_type_align_for_type(m, payload_type, depth + 1);
    if (payload_align <= 0) { return 0; }
    if (payload_align > 4) { return payload_align; }
    return 4;
}

fn mir_cpp_option_storage_size(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    let payload_type = mir_cpp_class_generic_arg_type(m, type_id, 0);
    let payload_size = mir_cpp_lower_type_size_for_type(m, payload_type, depth + 1);
    let payload_align = mir_cpp_lower_type_align_for_type(m, payload_type, depth + 1);
    if (payload_size <= 0 || payload_align <= 0) { return 0; }
    var max_align: i64 = 4;
    if (payload_align > max_align) { max_align = payload_align; }
    let end = mir_cpp_align_up(4, payload_align) + payload_size;
    return mir_cpp_align_up(end, max_align);
}

fn mir_cpp_result_lower_align(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    let ok_type = mir_cpp_class_generic_arg_type(m, type_id, 0);
    let err_type = mir_cpp_class_generic_arg_type(m, type_id, 1);
    let ok_align = mir_cpp_lower_type_align_for_type(m, ok_type, depth + 1);
    let err_align = mir_cpp_lower_type_align_for_type(m, err_type, depth + 1);
    if (ok_align <= 0 || err_align <= 0) { return 0; }
    var out: i64 = 4;
    if (ok_align > out) { out = ok_align; }
    if (err_align > out) { out = err_align; }
    return out;
}

fn mir_cpp_result_storage_size(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    let ok_type = mir_cpp_class_generic_arg_type(m, type_id, 0);
    let err_type = mir_cpp_class_generic_arg_type(m, type_id, 1);
    let ok_size = mir_cpp_lower_type_size_for_type(m, ok_type, depth + 1);
    let ok_align = mir_cpp_lower_type_align_for_type(m, ok_type, depth + 1);
    let err_size = mir_cpp_lower_type_size_for_type(m, err_type, depth + 1);
    let err_align = mir_cpp_lower_type_align_for_type(m, err_type, depth + 1);
    if (ok_size <= 0 || ok_align <= 0 || err_size <= 0 || err_align <= 0) { return 0; }
    var max_align: i64 = 4;
    if (ok_align > max_align) { max_align = ok_align; }
    if (err_align > max_align) { max_align = err_align; }
    var offset = mir_cpp_align_up(4, ok_align) + ok_size;
    offset = mir_cpp_align_up(offset, err_align) + err_size;
    return mir_cpp_align_up(offset, max_align);
}

fn mir_cpp_enum_lower_align(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32 || m.variant_count_for_type(type_id) <= 0) { return 0; }
    var max_align: i64 = 4;
    var variant_id: i32 = 1;
    while (variant_id <= m.variant_count) {
        if (m.variant_owner_type(variant_id) == type_id
            && m.variant_is_primary_for_type_tag(variant_id)) {
            let payloads = m.variant_payload_types(variant_id);
            var index: i32 = 0;
            while (index < m.variant_payload_count(variant_id)) {
                let payload_text = mir_cpp_top_level_csv_part(payloads.clone(), index);
                let payload_type = mir_cpp_find_type_by_source_or_tail(m, payload_text);
                let payload_align = mir_cpp_lower_type_align_for_type(m, payload_type, depth + 1);
                if (payload_text.len == 0 || payload_align <= 0) { return 0; }
                if (payload_align > max_align) { max_align = payload_align; }
                index = index + 1;
            }
        }
        variant_id = variant_id + 1;
    }
    return max_align;
}

fn mir_cpp_enum_storage_size(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32 || m.variant_count_for_type(type_id) <= 0) { return 0; }
    var offset: i64 = 4;
    var max_align: i64 = 4;
    var variant_id: i32 = 1;
    while (variant_id <= m.variant_count) {
        if (m.variant_owner_type(variant_id) == type_id
            && m.variant_is_primary_for_type_tag(variant_id)) {
            let payloads = m.variant_payload_types(variant_id);
            var index: i32 = 0;
            while (index < m.variant_payload_count(variant_id)) {
                let payload_text = mir_cpp_top_level_csv_part(payloads.clone(), index);
                let payload_type = mir_cpp_find_type_by_source_or_tail(m, payload_text);
                let payload_size = mir_cpp_lower_type_size_for_type(m, payload_type, depth + 1);
                let payload_align = mir_cpp_lower_type_align_for_type(m, payload_type, depth + 1);
                if (payload_text.len == 0 || payload_size <= 0 || payload_align <= 0) { return 0; }
                offset = mir_cpp_align_up(offset, payload_align) + payload_size;
                if (payload_align > max_align) { max_align = payload_align; }
                index = index + 1;
            }
        }
        variant_id = variant_id + 1;
    }
    return mir_cpp_align_up(offset, max_align);
}

// Record fields use LLVM lower_type ABI: ordinary classes are pointers here.
fn mir_cpp_lower_type_align_for_type(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32 || type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return 0; }
    if (hir_type_table_is_open(m.types, type_id)) { return 0; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
    if (kind == ty_I16() || kind == ty_U16()) { return 2; }
    if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
    if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
        || kind == ty_F64() || kind == ty_RAWPTR() || kind == ty_PTR()
        || kind == ty_REF() || kind == ty_MUTREF() || kind == ty_FN()
        || kind == ty_CFN() || kind == ty_STRING() || kind == ty_RANGE()) {
        return 8;
    }
    if (kind == ty_ARRAY()) {
        return mir_cpp_lower_type_align_for_type(m, hir_type_table_elem(m.types, type_id), depth + 1);
    }
    if (kind == ty_TUPLE()) { return mir_cpp_tuple_lower_align(m, type_id, depth + 1); }
    if (kind != ty_CLASS()) { return 0; }
    if (mir_cpp_type_is_foreign_abi(m, type_id)) {
        return mir_cpp_dci_layout_alignment(m, type_id);
    }
    if (mir_cpp_type_is_string_storage(m, type_id)) { return 8; }
    if (mir_cpp_type_is_dyn_storage(m, type_id)) { return 8; }
    let base = mir_cpp_class_layout_base(m, type_id);
    if (base == "Option") { return mir_cpp_option_lower_align(m, type_id, depth + 1); }
    if (base == "Result") { return mir_cpp_result_lower_align(m, type_id, depth + 1); }
    if (m.variant_count_for_type(type_id) > 0 && m.field_count_for_type(type_id) == 0) {
        return mir_cpp_enum_lower_align(m, type_id, depth + 1);
    }
    if (mir_cpp_type_has_variant_abi(m, type_id)) { return 0; }
    if (mir_cpp_type_is_value_struct_abi(m, type_id)) {
        return mir_cpp_record_lower_align(m, type_id, depth + 1);
    }
    return 8;
}

fn mir_cpp_lower_type_size_for_type(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32 || type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return 0; }
    if (hir_type_table_is_open(m.types, type_id)) { return 0; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
    if (kind == ty_I16() || kind == ty_U16()) { return 2; }
    if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
    if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
        || kind == ty_F64() || kind == ty_RAWPTR() || kind == ty_PTR()
        || kind == ty_REF() || kind == ty_MUTREF() || kind == ty_FN()
        || kind == ty_CFN() || kind == ty_RANGE()) {
        return 8;
    }
    if (kind == ty_STRING()) { return 32; }
    if (kind == ty_ARRAY()) {
        let elem_type = hir_type_table_elem(m.types, type_id);
        let elem_size = mir_cpp_lower_type_size_for_type(m, elem_type, depth + 1);
        let count = mir_cpp_array_length_for_type(m, type_id);
        if (elem_size <= 0 || count <= 0) { return 0; }
        return elem_size * count;
    }
    if (kind == ty_TUPLE()) { return mir_cpp_tuple_storage_size(m, type_id, depth + 1); }
    if (kind != ty_CLASS()) { return 0; }
    if (mir_cpp_type_is_foreign_abi(m, type_id)) {
        return mir_cpp_dci_layout_size(m, type_id);
    }
    if (mir_cpp_type_is_string_storage(m, type_id)) { return 32; }
    if (mir_cpp_type_is_dyn_storage(m, type_id)) { return 16; }
    let base = mir_cpp_class_layout_base(m, type_id);
    if (base == "Option") { return mir_cpp_option_storage_size(m, type_id, depth + 1); }
    if (base == "Result") { return mir_cpp_result_storage_size(m, type_id, depth + 1); }
    if (m.variant_count_for_type(type_id) > 0 && m.field_count_for_type(type_id) == 0) {
        return mir_cpp_enum_storage_size(m, type_id, depth + 1);
    }
    if (mir_cpp_type_has_variant_abi(m, type_id)) { return 0; }
    if (mir_cpp_type_is_value_struct_abi(m, type_id)) {
        return mir_cpp_record_storage_size(m, type_id, depth + 1);
    }
    return 8;
}

fn mir_cpp_storage_size_for_type(m: MirUnit, type_id: i32, depth: i32) -> i64 {
    if (depth > 32 || type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return 0; }
    if (hir_type_table_is_open(m.types, type_id)) { return 0; }
    if (mir_cpp_type_kind(m, type_id) == ty_CLASS()) {
        if (mir_cpp_type_is_foreign_abi(m, type_id)) {
            return mir_cpp_dci_layout_size(m, type_id);
        }
        // Top-level sizeof(class) measures the pointee record, unlike a class field.
        if (mir_cpp_type_uses_storage_class_reference_abi(m, type_id)) {
            return mir_cpp_record_storage_size(m, type_id, depth + 1);
        }
    }
    return mir_cpp_lower_type_size_for_type(m, type_id, depth + 1);
}

fn mir_cpp_alignof_expr(m: MirUnit, value_id: i32, name: string) -> string {
    var type_source = mir_cpp_sizeof_type_source_from_name(name);
    var type_id = mir_id_invalid();
    if (type_source.len > 0) {
        let mapped = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), type_source);
        if (mapped.len > 0) { type_source = mapped; }
        type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
    } else {
        let subject = m.value_first_arg(value_id);
        if (subject != mir_id_invalid()) { type_id = m.value_type(subject); }
    }
    let align = mir_cpp_storage_align_for_type(m, type_id);
    if (align <= 0) { return ""; }
    return "static_cast<int64_t>(" + policy_i64_to_string(align) + ")";
}

fn mir_cpp_ident(raw: string) -> string {
    var out: string = "";
    var i: i32 = 0;
    while (i < raw.len) {
        let c = raw.charAt(i);
        if (mir_cpp_is_ident_char(c)) {
            out = out + raw.substring(i, i + 1);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    if (out.len == 0) { out = "anon"; }
    let c0 = out.charAt(0);
    if (c0 >= 48 && c0 <= 57) { out = "_" + out; }
    if (out == "class" || out == "struct" || out == "return" || out == "template"
        || out == "typename" || out == "operator" || out == "namespace"
        || out == "public" || out == "private" || out == "protected"
        || out == "auto" || out == "static" || out == "void" || out == "int"
        || out == "new" || out == "delete" || out == "this" || out == "template") {
        out = out + "_";
    }
    return out;
}

fn mir_cpp_type_text_from_source(text_raw: string) -> string {
    let text = mir_cpp_trim(text_raw);
    if (text == "void") { return "void"; }
    if (text == "bool") { return "bool"; }
    if (text == "char") { return "char32_t"; }
    if (text == "i8") { return "int8_t"; }
    if (text == "i16") { return "int16_t"; }
    if (text == "i32") { return "int32_t"; }
    if (text == "i64") { return "int64_t"; }
    if (text == "u8") { return "uint8_t"; }
    if (text == "u16") { return "uint16_t"; }
    if (text == "u32") { return "uint32_t"; }
    if (text == "u64") { return "uint64_t"; }
    if (text == "isize") { return "int64_t"; }
    if (text == "usize") { return "uint64_t"; }
    if (text == "f32") { return "float"; }
    if (text == "f64") { return "double"; }
    if (text == "rawptr") { return "void*"; }
    if (text == "Range") { return "vyx::Range"; }
    if (text == "str" || text == "string" || text == "__String") { return "vyx::Str"; }
    if (mir_cpp_type_source_is_pointer_like(text)) {
        return "vyx::Ptr<vyx::Any>";
    }
    if (text.startsWith("fn")) { return "vyx::Closure"; }
    if (text.startsWith("cfn") || text.startsWith("unsafe fn")) { return "void*"; }
    if (text.startsWith("[") && text.endsWith("]")) {
        var semi: i32 = -1;
        var i: i32 = 1;
        while (i + 1 < text.len) {
            if (text.charAt(i) == 59) { semi = i; }
            i = i + 1;
        }
        if (semi > 1) {
            let elem_text = text.substring(1, semi);
            let len_text = mir_cpp_trim(text.substring(semi + 1, text.len - 1));
            return "std::array<" + mir_cpp_type_text_from_source(elem_text) + ", " + len_text + ">";
        }
    }
    if (text.startsWith("(") && text.endsWith(")")) {
        var inner = text.substring(1, text.len - 1);
        var out = "std::tuple<";
        var start: i32 = 0;
        var depth_paren: i32 = 0;
        var depth_bracket: i32 = 0;
        var depth_angle: i32 = 0;
        var first = true;
        var idx: i32 = 0;
        while (idx <= inner.len) {
            var split = false;
            if (idx == inner.len) {
                split = true;
            } else {
                let ch = inner.charAt(idx);
                if (ch == 40) { depth_paren = depth_paren + 1; }
                else if (ch == 41 && depth_paren > 0) { depth_paren = depth_paren - 1; }
                else if (ch == 91) { depth_bracket = depth_bracket + 1; }
                else if (ch == 93 && depth_bracket > 0) { depth_bracket = depth_bracket - 1; }
                else if (ch == 60) { depth_angle = depth_angle + 1; }
                else if (ch == 62 && depth_angle > 0) { depth_angle = depth_angle - 1; }
                else if (ch == 44 && depth_paren == 0 && depth_bracket == 0 && depth_angle == 0) { split = true; }
            }
            if (split) {
                let part = mir_cpp_trim(inner.substring(start, idx));
                if (part.len > 0) {
                    if (!first) { out = out + ", "; }
                    out = out + mir_cpp_type_text_from_source(part);
                    first = false;
                }
                start = idx + 1;
            }
            idx = idx + 1;
        }
        return out + ">";
    }
    return "vyx::Any";
}

fn mir_cpp_find_type_by_source_text(m: MirUnit, text_raw: string) -> i32 {
    let text = mir_cpp_trim(text_raw);
    if (text.len == 0) { return mir_id_invalid(); }
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_type_source_text(m, type_id) == text) { return type_id; }
        type_id = type_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_find_type_by_source_or_tail(m: MirUnit, text_raw: string) -> i32 {
    let exact = mir_cpp_find_type_by_source_text(m, text_raw);
    if (exact != mir_id_invalid()) { return exact; }
    let text = mir_cpp_trim(text_raw);
    if (text.len == 0) { return mir_id_invalid(); }
    var matched = mir_id_invalid();
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        let source = mir_cpp_type_source_text(m, type_id);
        if (source.endsWith("." + text) || source.endsWith("::" + text)) {
            if (matched != mir_id_invalid()) { return mir_id_invalid(); }
            matched = type_id;
        }
        type_id = type_id + 1;
    }
    return matched;
}

fn mir_cpp_type_tail_match_count(m: MirUnit, text_raw: string) -> i32 {
    let text = mir_cpp_trim(text_raw);
    if (text.len == 0) { return 0; }
    var count: i32 = 0;
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        let source = mir_cpp_type_source_text(m, type_id);
        if (source.endsWith("." + text) || source.endsWith("::" + text)) {
            count = count + 1;
        }
        type_id = type_id + 1;
    }
    return count;
}

fn mir_cpp_type_text_from_source_in_unit(m: MirUnit, text_raw: string) -> string {
    let text = mir_cpp_trim(text_raw);
    if (text.startsWith("(") && text.endsWith(")")) { return mir_cpp_tuple_type_text(m, text); }
    if (text.startsWith("[") && text.endsWith("]")) {
        var semi: i32 = -1;
        var i: i32 = 1;
        while (i + 1 < text.len) {
            if (text.charAt(i) == 59) { semi = i; }
            i = i + 1;
        }
        if (semi > 1) {
            let elem_text = text.substring(1, semi);
            let len_text = mir_cpp_trim(text.substring(semi + 1, text.len - 1));
            return "std::array<" + mir_cpp_type_text_from_source_in_unit(m, elem_text) + ", " + len_text + ">";
        }
    }
    // Structural pointer spellings must resolve through the MIR type table
    // before the context-free fallback, otherwise ptr<T>/ref<T>/mutref<T>
    // collapse to Ptr<Any> and function-value ABI matching diverges from LLVM.
    let known = mir_cpp_find_type_by_source_text(m, text);
    if (known != mir_id_invalid()) { return mir_cpp_type_text(m, known); }
    let primitive = mir_cpp_type_text_from_source(text);
    if (primitive != "vyx::Any") { return primitive; }
    return primitive;
}

fn mir_cpp_cpp_qualified_name(name_raw: string) -> string {
    let name = mir_cpp_trim(name_raw);
    var out = "";
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) {
            out = out + "::";
        } else {
            out = out + name.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_foreign_cpp_type_text_from_source(m: MirUnit, text_raw: string) -> string {
    let text = mir_cpp_trim(text_raw);
    if (policy_generic_call_has_args(text.clone()) != 0) {
        let base = policy_generic_call_base(text.clone());
        let raw_args = policy_generic_call_args(text.clone());
        var out = mir_cpp_cpp_qualified_name(base) + "<";
        var first = true;
        var idx: i32 = 0;
        while (idx < 64) {
            let part = policy_generic_arg_at(raw_args, idx);
            if (part.len == 0) { break; }
            if (!first) { out = out + ", "; }
            out = out + mir_cpp_type_text_from_source_in_unit(m, part);
            first = false;
            idx = idx + 1;
        }
        return out + ">";
    }
    return mir_cpp_cpp_qualified_name(text);
}

fn mir_cpp_tuple_type_text(m: MirUnit, text_raw: string) -> string {
    let text = mir_cpp_trim(text_raw);
    if (!text.startsWith("(") || !text.endsWith(")")) {
        return mir_cpp_type_text_from_source_in_unit(m, text);
    }
    var inner = text.substring(1, text.len - 1);
    var out = "std::tuple<";
    var start: i32 = 0;
    var depth_paren: i32 = 0;
    var depth_bracket: i32 = 0;
    var depth_angle: i32 = 0;
    var first = true;
    var idx: i32 = 0;
    while (idx <= inner.len) {
        var split = false;
        if (idx == inner.len) {
            split = true;
        } else {
            let ch = inner.charAt(idx);
            if (ch == 40) { depth_paren = depth_paren + 1; }
            else if (ch == 41 && depth_paren > 0) { depth_paren = depth_paren - 1; }
            else if (ch == 91) { depth_bracket = depth_bracket + 1; }
            else if (ch == 93 && depth_bracket > 0) { depth_bracket = depth_bracket - 1; }
            else if (ch == 60) { depth_angle = depth_angle + 1; }
            else if (ch == 62 && depth_angle > 0) { depth_angle = depth_angle - 1; }
            else if (ch == 44 && depth_paren == 0 && depth_bracket == 0 && depth_angle == 0) { split = true; }
        }
        if (split) {
            let part = mir_cpp_trim(inner.substring(start, idx));
            if (part.len > 0) {
                if (!first) { out = out + ", "; }
                out = out + mir_cpp_type_text_from_source_in_unit(m, part);
                first = false;
            }
            start = idx + 1;
        }
        idx = idx + 1;
    }
    return out + ">";
}

fn mir_cpp_function_is_no_mangle(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid()) { return false; }
    return (m.function_flags( function_id) & hir_function_flag_no_mangle()) != 0;
}

fn mir_cpp_function_name(m: MirUnit, function_id: i32) -> string {
    let name = mir_cpp_function_source_name(m, function_id);
    if (function_id == mir_cpp_entry_main_id(m)) { return "main"; }
    if (mir_cpp_function_is_foreign_cpp(m, function_id)) {
        return mir_cpp_dci_alias_name(function_id);
    }
    if (mir_cpp_function_is_dci_vyx_override_callback(m, function_id)) {
        return mir_cpp_vyx_llvm_symbol_name(m, function_id);
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function() && name == "getenv") {
        return "vyx_rt_getenv";
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function()
        && name == "__vyx_atomic_load_i64_intrinsic") {
        return "vyx_atomic_load_i64";
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function()
        && name == "__vyx_atomic_fetch_add_i64_intrinsic") {
        return "vyx_atomic_fetch_add_i64";
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function()
        && name == "__vyx_atomic_compare_exchange_i64_intrinsic") {
        return "vyx_atomic_compare_exchange_i64";
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function()) { return mir_cpp_ident(name); }
    if (mir_cpp_function_is_no_mangle(m, function_id)) { return mir_cpp_ident(name); }
    return "vyx_fn_" + mir_cpp_ident(name) + "_" + mir_cpp_i32(function_id);
}

fn mir_cpp_last_path_segment(name: string) -> string {
    if (name.len == 0) { return ""; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { start = i + 1; }
        i = i + 1;
    }
    return name.substring(start, name.len);
}

fn mir_cpp_demangle_part(name: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 95 && i + 2 < name.len) {
            let esc = name.substring(i, i + 3);
            if (esc == "_5F") { out = out + "_"; i = i + 3; continue; }
            if (esc == "_2E") { out = out + "."; i = i + 3; continue; }
            if (esc == "_3A") { out = out + ":"; i = i + 3; continue; }
            if (esc == "_3C") { out = out + "<"; i = i + 3; continue; }
            if (esc == "_3E") { out = out + ">"; i = i + 3; continue; }
            if (esc == "_2C") { out = out + ","; i = i + 3; continue; }
        }
        out = out + name.substring(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn mir_cpp_reflect_symbol_id(symbol_name: string) -> i64 {
    var h: i64 = 1125899907;
    var i: i32 = 0;
    while (i < symbol_name.len) {
        h = ((h * 131) + (symbol_name.charAt(i) as i64)) % 2147483647;
        if (h < 0) { h = -h; }
        i = i + 1;
    }
    if (h == 0) { return 1; }
    return h;
}

fn mir_cpp_specialized_symbol_from_args(base: string, args: string) -> string {
    var out = base + "__";
    var idx: i32 = 0;
    while (idx < 64) {
        let arg = policy_generic_arg_at(args, idx);
        if (arg.len == 0) { return out; }
        if (idx > 0) { out = out + "_"; }
        out = out + policy_mangle_part(arg);
        idx = idx + 1;
    }
    return out;
}

fn mir_cpp_primitive_method_symbol_base(class_base: string, method_name: string) -> string {
    var prim = class_base;
    let last = mir_cpp_last_path_segment(class_base);
    if (policy_primitive_type_kind(prim) == 0 && policy_primitive_type_kind(last) != 0) {
        prim = last;
    }
    if (policy_primitive_type_kind(prim) != 0) {
        return "__vyx_prim_" + policy_mangle_part(prim) + "_" + method_name;
    }
    return class_base + "_" + method_name;
}

fn mir_cpp_class_method_symbol_name(class_name: string, method_name: string) -> string {
    var base = class_name;
    var args: string = "";
    if (policy_generic_call_has_args(class_name) != 0) {
        base = policy_generic_call_base(class_name);
        args = policy_generic_call_args(class_name);
    }
    let flat = mir_cpp_primitive_method_symbol_base(base, method_name);
    if (args.len == 0) { return flat; }
    return mir_cpp_specialized_symbol_from_args(flat, args);
}

/// Source-level method name of a MIR function.
///
/// A *closed generic instance* member is registered under its mangled item name
/// (`mir2$ProbeA_3A_3A_3Ci32_3E_3A_3Aconsume_3A_3AT_2CSelf_3D_3E...`), so the raw
/// `function_name` is an identifier, not a name: the name a foreign stub has to
/// `impl` -- and the name a base descriptor method has to match -- is the
/// `method` segment inside it.  Segments that are themselves generic arguments
/// survive mangling with their `<` escape attached, so they start with `_3C`
/// and must be skipped; without that skip the owner's argument list (or the
/// generic parameter list) is returned instead of the method.
fn mir_cpp_function_method_name(m: MirUnit, function_id: i32) -> string {
    let name = mir_cpp_function_source_name(m, function_id);
    let marker = "_3A_3A";
    var start = mir_cpp_string_find(name, marker, 0);
    if (start < 0) { return mir_cpp_demangle_part(policy_generic_call_base(name.clone())); }
    start = start + (marker.len as i32);
    while (start <= name.len) {
        var method_end = mir_cpp_string_find(name, marker, start);
        if (method_end < 0) { method_end = name.len; }
        if (method_end > start) {
            let segment = name.substring(start, method_end);
            var generic_args = false;
            if (segment.len >= 3 && segment.substring(0, 3) == "_3C") {
                generic_args = true;
            } else if (segment.len >= 2 && segment.substring(0, 2) == "3C") {
                generic_args = true;
            }
            if (!generic_args) { return mir_cpp_demangle_part(segment); }
        }
        if (method_end >= name.len) { break; }
        start = method_end + (marker.len as i32);
    }
    return mir_cpp_demangle_part(policy_generic_call_base(name.clone()));
}

fn mir_cpp_reflected_method_owner_type_for_function(m: MirUnit, function_id: i32) -> string {
    let owner = m.function_owner_type(function_id);
    if (owner.len > 0) { return owner; }
    let first = mir_cpp_function_param_type_at(m, function_id, 0);
    if (first != mir_id_invalid()) { return mir_cpp_type_source_text(m, first); }
    return "";
}

fn mir_cpp_reflected_method_id_for_function(m: MirUnit, function_id: i32) -> i64 {
    if (function_id == mir_id_invalid() || !mir_cpp_function_has_body(m, function_id)) { return 0; }
    let owner_type = mir_cpp_reflected_method_owner_type_for_function(m, function_id);
    let method_name = mir_cpp_function_method_name(m, function_id);
    if (owner_type.len == 0 || method_name.len == 0) { return 0; }
    let method_id = mir_cpp_reflect_symbol_id(mir_cpp_class_method_symbol_name(owner_type, method_name));
    if (!mir_cpp_reflection_manifest_has_method_id(m, method_id)) { return 0; }
    return method_id;
}

fn mir_cpp_reflection_manifest_has_method_id(m: MirUnit, method_id: i64) -> bool {
    if (method_id <= 0) { return false; }
    let manifest = mir_unit_reflection_manifest(&m);
    if (manifest.len == 0) { return false; }
    return mir_cpp_string_find(manifest, "~" + policy_i64_to_string(method_id) + "~", 0) >= 0;
}

fn mir_cpp_is_entry_main(m: MirUnit, function_id: i32) -> bool {
    return function_id != mir_id_invalid() && function_id == mir_cpp_entry_main_id(m);
}

fn mir_cpp_is_c_runtime_extern(name: string) -> bool {
    if (name == "malloc" || name == "realloc" || name == "free") { return true; }
    if (name == "vyx_pointer_allocation_register"
        || name == "vyx_pointer_allocation_unregister"
        || name == "vyx_pointer_allocation_unregister_range"
        || name == "vyx_pointer_allocation_realloc") { return true; }
    if (name == "vyx_forget_string_len" || name == "vyx_free_runtime_string"
        || name == "vyx_free_pooled_string") { return true; }
    // Keep the decimal append ABI in the generated runtime rather than
    // requiring every standalone MIR2CPP project to link vyx_run_rt.
    // LlvmMirLower resolves the same std externs to its runtime ABI.
    if (name == "vyx_int_decimal_len_abi" || name == "vyx_int_to_string_into_abi"
        || name == "vyx_uint_decimal_len_abi" || name == "vyx_uint_to_string_into_abi") { return true; }
    if (name == "int_to_string" || name == "bool_to_string") { return true; }
    if (name == "calloc") { return true; }
    if (name == "memcpy" || name == "memmove" || name == "memset" || name == "memcmp") { return true; }
    // Keep this libc string family aligned with
    // LlvmMirLower.runtime_external_function_key().
    if (name == "strlen" || name == "strcmp" || name == "strncmp" || name == "strstr") { return true; }
    if (name == "getenv") { return true; }
    if (name == "strtoll" || name == "strtod" || name == "atof" || name == "atoi") { return true; }
    if (name == "fopen" || name == "fclose" || name == "fread" || name == "fwrite") { return true; }
    if (name == "fgetc" || name == "fputc" || name == "feof"
        || name == "fseek" || name == "ftell" || name == "remove" || name == "rename") { return true; }
    // These are declared by the C++ runtime headers already included by
    // `vyx_runtime.hpp`. Re-emitting Vyx's raw-pointer ABI prototype conflicts
    // with their FILE*/const char* declarations on POSIX hosts.
    if (name == "system") { return true; }
    if (name == "time") { return true; }
    if (name == "_beginthread") { return true; }
    return false;
}

fn mir_cpp_is_c_runtime_function_decl(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (!mir_cpp_is_c_runtime_extern(mir_cpp_function_source_name(m, function_id))) { return false; }
    return !mir_cpp_function_has_body(m, function_id);
}

fn mir_cpp_entry_main_id(m: MirUnit) -> i32 {
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_cpp_function_source_name(m, function_id) == "main"
            && m.function_owner_type(function_id).len == 0
            && m.function_item_kind(function_id) == hir_item_function()) {
            return function_id;
        }
        function_id = function_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_local_name(m: MirUnit, local_id: i32) -> string {
    let name = mir_cpp_local_source_name(m, local_id);
    return "vyx_local_" + mir_cpp_ident(name) + "_" + mir_cpp_i32(local_id);
}

fn mir_cpp_static_name(m: MirUnit, static_id: i32) -> string {
    let name = mir_cpp_static_source_name(m, static_id);
    return "vyx_static_" + mir_cpp_ident(name) + "_" + mir_cpp_i32(static_id);
}

fn mir_cpp_record_type_name(m: MirUnit, type_id: i32) -> string {
    let text = mir_cpp_type_source_text(m, type_id);
    if (mir_cpp_type_is_foreign_cpp(m, type_id)) {
        return "vyx_dci_type_" + mir_cpp_ident(text) + "_" + mir_cpp_i32(type_id);
    }
    return "vyx_type_" + mir_cpp_ident(text) + "_" + mir_cpp_i32(type_id);
}

fn mir_cpp_field_cpp_name(m: MirUnit, field_id: i32, field_index: i32) -> string {
    if (field_id != mir_id_invalid()) {
        let name = mir_cpp_field_source_name(m, field_id);
        if (name.len > 0) { return mir_cpp_ident(name); }
    }
    return "field_" + mir_cpp_i32(field_index);
}

fn mir_cpp_type_field_id_by_name(m: MirUnit, type_id: i32, name: string) -> i32 {
    if (type_id == mir_id_invalid() || name.len == 0) { return mir_id_invalid(); }
    var idx: i32 = 0;
    let n = m.field_count_for_type(type_id);
    while (idx < n) {
        let field_id = m.field_id_for_type_index(type_id, idx);
        if (field_id != mir_id_invalid() && mir_cpp_field_source_name(m, field_id) == name) {
            return field_id;
        }
        idx = idx + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_payload_field_name(index: i32) -> string {
    return "payload" + mir_cpp_i32(index);
}

fn mir_cpp_quote(text: string) -> string {
    var out = "\"";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 34) {
            out = out + "\\\"";
        } else if (c == 92) {
            out = out + "\\\\";
        } else if (c == 10) {
            out = out + "\\n";
        } else if (c == 13) {
            out = out + "\\r";
        } else if (c == 9) {
            out = out + "\\t";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn mir_cpp_type_text(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return "vyx::Any"; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text == "str" || text == "string" || text == "__String") { return "vyx::Str"; }
    if (text == "Range") { return "vyx::Range"; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        let elem_id = hir_type_table_elem(m.types, type_id);
        var elem_text = "vyx::Any";
        if (elem_id != mir_id_invalid()) { elem_text = mir_cpp_type_text(m, elem_id); }
        return "vyx::Ptr<" + elem_text + ">";
    }
    if (mir_cpp_type_source_is_pointer_like(text)) { return "vyx::Ptr<vyx::Any>"; }
    if (text.startsWith("(") && text.endsWith(")")) { return mir_cpp_tuple_type_text(m, text); }
    if (kind == ty_RANGE()) { return "vyx::Range"; }
    if (kind == ty_ARRAY()) {
        let elem_id = hir_type_table_elem(m.types, type_id);
        var elem_text = mir_cpp_type_text_from_source("");
        if (elem_id != mir_id_invalid()) { elem_text = mir_cpp_type_text(m, elem_id); }
        var len_text = "0";
        if (text.startsWith("[") && text.endsWith("]")) {
            var semi: i32 = -1;
            var i: i32 = 1;
            while (i + 1 < text.len) {
                if (text.charAt(i) == 59) { semi = i; }
                i = i + 1;
            }
            if (semi > 1) { len_text = mir_cpp_trim(text.substring(semi + 1, text.len - 1)); }
        }
        return "std::array<" + elem_text + ", " + len_text + ">";
    }
    if (kind == ty_TUPLE()) { return mir_cpp_tuple_type_text(m, text); }
    if (kind == ty_FN()) { return "vyx::Closure"; }
    if (kind == ty_CFN()) { return "void*"; }
    if (kind == ty_CLASS() && mir_cpp_type_is_dci_stub_class(m, type_id)) { return "void*"; }
    if (kind == ty_CLASS() && mir_cpp_type_is_foreign_cpp(m, type_id)) {
        return mir_cpp_record_type_name(m, type_id);
    }
    if (kind == ty_CLASS()) { return mir_cpp_record_type_name(m, type_id); }
    return mir_cpp_type_text_from_source(text);
}

fn mir_cpp_default_value_for_type(ty: string) -> string {
    // Volatile-qualified declarations prefix the plain type text; strip the
    // qualifier so the default initializer matches the underlying type.
    if (ty.startsWith("volatile ")) {
        return mir_cpp_default_value_for_type(ty.substring(9, ty.len));
    }
    if (ty == "void") { return ""; }
    if (ty == "bool") { return "false"; }
    if (ty == "vyx::Str") { return "vyx::Str{}"; }
    if (ty == "vyx::Range") { return "vyx::Range{}"; }
    if (ty == "vyx::Closure") { return "vyx::Closure{}"; }
    if (ty == "void*") { return "nullptr"; }
    if (ty.startsWith("vyx::Ptr<")) { return ty + "{}"; }
    if (ty == "vyx::Any") { return "vyx::Any{}"; }
    if (ty.startsWith("std::array<") || ty.startsWith("std::tuple<")) { return ty + "{}"; }
    if (ty.startsWith("vyx_type_")) { return ty + "{}"; }
    return ty + "{}";
}

fn mir_cpp_binop(op: i32) -> string {
    if (op == tk_PLUS()) { return "+"; }
    if (op == tk_MINUS()) { return "-"; }
    if (op == tk_STAR()) { return "*"; }
    if (op == tk_SLASH()) { return "/"; }
    if (op == tk_PERCENT()) { return "%"; }
    if (op == tk_EQEQ()) { return "=="; }
    if (op == tk_NEQ()) { return "!="; }
    if (op == tk_LT()) { return "<"; }
    if (op == tk_LE()) { return "<="; }
    if (op == tk_GT()) { return ">"; }
    if (op == tk_GE()) { return ">="; }
    if (op == tk_AND()) { return "&&"; }
    if (op == tk_OR()) { return "||"; }
    if (op == tk_AMP()) { return "&"; }
    if (op == tk_PIPE()) { return "|"; }
    if (op == tk_CARET()) { return "^"; }
    if (op == tk_LSHIFT()) { return "<<"; }
    if (op == tk_RSHIFT()) { return ">>"; }
    return "";
}

fn mir_cpp_unop(op: i32) -> string {
    if (op == tk_MINUS()) { return "-"; }
    if (op == tk_NOT()) { return "!"; }
    if (op == tk_TILDE()) { return "~"; }
    if (op == tk_STAR()) { return "*"; }
    if (op == tk_AMP()) { return "&"; }
    return "";
}

fn mir_cpp_default_expr(m: MirUnit, type_id: i32) -> string {
    return mir_cpp_default_value_for_type(mir_cpp_type_text(m, type_id));
}

fn mir_cpp_place_contains_local(m: MirUnit, place_id: i32, local_id: i32) -> bool {
    if (place_id == mir_id_invalid() || place_id <= 0 || place_id > m.place_count) { return false; }
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    let kind = m.place_kind(place_id);
    if (kind == mir_place_local()) { return m.place_local(place_id) == local_id; }
    if (kind == mir_place_field() || kind == mir_place_index() || kind == mir_place_deref()) {
        return mir_cpp_place_contains_local(m, m.place_base(place_id), local_id);
    }
    return false;
}

fn mir_cpp_function_mutates_local(m: MirUnit, function_id: i32, local_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    if (!mir_cpp_function_has_body(m, function_id)) { return false; }
    var block_id = m.function_first_block(function_id);
    while (block_id != mir_id_invalid()) {
        var instr_id = m.block_first_instr(block_id);
        while (instr_id != mir_id_invalid()) {
            if (m.instr_kind(instr_id) == mir_instr_assign()
                && mir_cpp_place_contains_local(m, m.instr_place(instr_id), local_id)) {
                return true;
            }
            instr_id = m.instr_next(instr_id);
        }
        block_id = m.block_next(block_id);
    }
    return false;
}

fn mir_cpp_function_self_local(m: MirUnit, function_id: i32) -> i32 {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) {
        return mir_id_invalid();
    }
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0
            && (m.local_flags(local_id) & mir_local_flag_self_receiver()) != 0) {
            return local_id;
        }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_call_target_function_id(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return mir_id_invalid(); }
    if (m.value_kind(value_id) != mir_value_call()) { return mir_id_invalid(); }
    if (m.value_target_kind(value_id) == mir_target_function()) {
        let direct = m.value_target_id(value_id);
        if (direct > 0 && direct <= m.function_count) { return direct; }
        return mir_id_invalid();
    }
    let lhs = m.value_lhs(value_id);
    if (lhs != mir_id_invalid() && lhs > 0 && lhs <= m.value_count
        && m.value_target_kind(lhs) == mir_target_function()) {
        let lhs_target = m.value_target_id(lhs);
        if (lhs_target > 0 && lhs_target <= m.function_count) { return lhs_target; }
    }
    return mir_id_invalid();
}

fn mir_cpp_value_reads_local(m: MirUnit, value_id: i32, local_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_read_place()) {
        return mir_cpp_place_contains_local(m, m.value_place(value_id), local_id);
    }
    if (m.value_lhs(value_id) != mir_id_invalid()
        && mir_cpp_value_reads_local(m, m.value_lhs(value_id), local_id)) {
        return true;
    }
    return false;
}

fn mir_cpp_call_receiver_reads_local(m: MirUnit, value_id: i32, local_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    let lhs = m.value_lhs(value_id);
    let receiver = mir_cpp_call_receiver_value(m, lhs);
    if (receiver != mir_id_invalid()) { return mir_cpp_value_reads_local(m, receiver, local_id); }
    let first = m.value_first_arg(value_id);
    if (first != mir_id_invalid()) { return mir_cpp_value_reads_local(m, first, local_id); }
    return false;
}

fn mir_cpp_function_mutates_self_with_depth(m: MirUnit, function_id: i32, depth: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (!mir_cpp_function_has_body(m, function_id)) { return false; }
    let self_local = mir_cpp_function_self_local(m, function_id);
    if (self_local == mir_id_invalid()) { return false; }
    if (mir_cpp_function_mutates_local(m, function_id, self_local)) { return true; }
    if (depth <= 0) { return false; }
    var block_id = m.function_first_block(function_id);
    while (block_id != mir_id_invalid()) {
        var instr_id = m.block_first_instr(block_id);
        while (instr_id != mir_id_invalid()) {
            let value_id = m.instr_value(instr_id);
            let callee = mir_cpp_call_target_function_id(m, value_id);
            if (callee != mir_id_invalid()
                && mir_cpp_function_has_body(m, callee)
                && mir_cpp_call_receiver_reads_local(m, value_id, self_local)
                && mir_cpp_function_mutates_self_with_depth(m, callee, depth - 1)) {
                return true;
            }
            instr_id = m.instr_next(instr_id);
        }
        block_id = m.block_next(block_id);
    }
    return false;
}

// 0 = value, 2 = mutable reference. Non-move aggregate receivers use T& so
// indirect mutations remain valid without copying large compiler state.
fn mir_cpp_self_receiver_ref_kind(m: MirUnit, local_id: i32) -> i32 {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return 0; }
    let flags = m.local_flags(local_id);
    if ((flags & mir_local_flag_self_receiver()) == 0) { return 0; }
    if ((flags & mir_local_flag_self_shared_ref()) != 0) { return 1; }
    if ((flags & mir_local_flag_self_mut_ref()) != 0) { return 2; }
    if ((flags & mir_local_flag_move_arg()) != 0) {
        // LLVM represents normal class receivers as object pointers even for
        // `own self`; ownership transfer is carried by MIR move/drop flags,
        // not by copying the aggregate at the ABI boundary. Emit T& here so
        // MIR2CPP observes the same identity and drop target. Primitive and
        // value-ABI receivers remain by value.
        if (mir_cpp_type_uses_class_reference_abi(m, m.local_type(local_id))) {
            return 2;
        }
        return 0;
    }
    let function_id = m.local_function(local_id);
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return 0; }
    let self_type_id = m.local_type(local_id);
    if (mir_cpp_type_is_foreign_cpp(m, self_type_id)) { return 2; }
    let self_ty = mir_cpp_type_text(m, self_type_id);
    if (!self_ty.startsWith("vyx_type_")) { return 0; }
    let ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
    if (ret_ty == self_ty) { return 0; }
    return 2;
}

fn mir_cpp_type_is_value_struct_abi(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if ((hir_type_table_flags(m.types, type_id) & hir_type_flag_value_struct()) != 0) { return true; }
    if (m.field_count_for_type(type_id) > 0) { return false; }
    var base = policy_generic_call_base(mir_cpp_type_source_text(m, type_id).clone());
    if (base.len == 0) { base = mir_cpp_type_source_text(m, type_id); }
    let last = mir_cpp_last_path_segment(base);
    if (last.len == 0) { return false; }
    var candidate: i32 = 1;
    while (candidate <= m.types.count) {
        if ((hir_type_table_flags(m.types, candidate) & hir_type_flag_value_struct()) != 0) {
            var candidate_base = policy_generic_call_base(mir_cpp_type_source_text(m, candidate).clone());
            if (candidate_base.len == 0) { candidate_base = mir_cpp_type_source_text(m, candidate); }
            if (mir_cpp_last_path_segment(candidate_base) == last) { return true; }
        }
        candidate = candidate + 1;
    }
    return false;
}

fn mir_cpp_type_has_variant_abi(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (m.variant_count_for_type(type_id) > 0) { return true; }
    if (m.field_count_for_type(type_id) > 0) { return false; }
    var base = policy_generic_call_base(mir_cpp_type_source_text(m, type_id).clone());
    if (base.len == 0) { base = mir_cpp_type_source_text(m, type_id); }
    let last = mir_cpp_last_path_segment(base);
    if (last.len == 0) { return false; }
    var candidate: i32 = 1;
    while (candidate <= m.types.count) {
        if (m.variant_count_for_type(candidate) > 0) {
            var candidate_base = policy_generic_call_base(mir_cpp_type_source_text(m, candidate).clone());
            if (candidate_base.len == 0) { candidate_base = mir_cpp_type_source_text(m, candidate); }
            if (mir_cpp_last_path_segment(candidate_base) == last) { return true; }
        }
        candidate = candidate + 1;
    }
    return false;
}

fn mir_cpp_type_is_foreign_abi(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (mir_cpp_type_is_foreign_cpp(m, type_id)) { return true; }
    var base = policy_generic_call_base(mir_cpp_type_source_text(m, type_id).clone());
    if (base.len == 0) { base = mir_cpp_type_source_text(m, type_id); }
    let last = mir_cpp_last_path_segment(base);
    if (last.len == 0) { return false; }
    var candidate: i32 = 1;
    while (candidate <= m.types.count) {
        if (mir_cpp_type_is_foreign_cpp(m, candidate)) {
            var candidate_base = policy_generic_call_base(mir_cpp_type_source_text(m, candidate).clone());
            if (candidate_base.len == 0) { candidate_base = mir_cpp_type_source_text(m, candidate); }
            if (mir_cpp_last_path_segment(candidate_base) == last) { return true; }
        }
        candidate = candidate + 1;
    }
    return false;
}

fn mir_cpp_type_uses_class_reference_abi(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (mir_cpp_type_kind(m, type_id) != ty_CLASS()) { return false; }
    if (mir_cpp_type_is_foreign_abi(m, type_id)) { return false; }
    if (mir_cpp_type_is_value_struct_abi(m, type_id)) { return false; }
    if (mir_cpp_type_text(m, type_id) == "vyx::Str") { return false; }
    if (mir_cpp_type_has_variant_abi(m, type_id)) { return false; }
    let source = mir_cpp_type_source_text(m, type_id);
    var base = policy_generic_call_base(source.clone());
    if (base.len == 0) { base = source; }
    let last = mir_cpp_last_path_segment(base);
    if (last == "Option" || last == "Result") { return false; }
    if (source.startsWith("dyn") && m.field_count_for_type(type_id) <= 0) { return false; }
    return mir_cpp_type_text(m, type_id).startsWith("vyx_type_");
}

fn mir_cpp_param_ref_kind(m: MirUnit, local_id: i32) -> i32 {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return 0; }
    if ((m.local_flags(local_id) & mir_local_flag_self_receiver()) != 0) {
        return mir_cpp_self_receiver_ref_kind(m, local_id);
    }
    if ((m.local_flags(local_id) & mir_local_flag_move_arg()) != 0) { return 0; }
    let function_id = m.local_function(local_id);
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return 0; }
    if (m.function_item_kind(function_id) == hir_item_extern_function()) { return 0; }
    if (mir_cpp_type_uses_class_reference_abi(m, m.local_type(local_id))) { return 2; }
    return 0;
}

fn mir_cpp_param_needs_ref(m: MirUnit, local_id: i32) -> bool {
    return mir_cpp_param_ref_kind(m, local_id) != 0;
}

fn mir_cpp_param_type_text(m: MirUnit, local_id: i32) -> string {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return "vyx::Any"; }
    let ty = mir_cpp_type_text(m, m.local_type(local_id));
    let ref_kind = mir_cpp_param_ref_kind(m, local_id);
    if (ref_kind == 1) { return "const " + ty + "&"; }
    if (ref_kind == 2) { return ty + "&"; }
    return ty;
}

fn mir_cpp_type_is_integer_text(ty: string) -> bool {
    if (ty == "bool" || ty == "char32_t") { return true; }
    if (ty == "int8_t" || ty == "int16_t" || ty == "int32_t" || ty == "int64_t") { return true; }
    if (ty == "uint8_t" || ty == "uint16_t" || ty == "uint32_t" || ty == "uint64_t") { return true; }
    return false;
}

fn mir_cpp_type_is_signed_integer_text(ty: string) -> bool {
    return ty == "int8_t" || ty == "int16_t" || ty == "int32_t" || ty == "int64_t";
}

fn mir_cpp_function_param_count(m: MirUnit, function_id: i32) -> i32 {
    var count: i32 = 0;
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0) {
            count = count + 1;
        }
        local_id = m.local_next(local_id);
    }
    return count;
}

fn mir_cpp_function_is_closure(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    return m.function_item_kind(function_id) == hir_item_closure();
}

fn mir_cpp_type_is_fn_value(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (mir_cpp_type_kind(m, type_id) == ty_FN()) { return true; }
    return mir_cpp_type_source_text(m, type_id).startsWith("fn");
}

fn mir_cpp_local_is_capture(m: MirUnit, local_id: i32) -> bool {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    return (m.local_flags(local_id) & mir_local_flag_capture()) != 0;
}

fn mir_cpp_local_is_reference_capture(m: MirUnit, local_id: i32) -> bool {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count) { return false; }
    return (m.local_flags(local_id) & mir_local_flag_reference_capture()) != 0;
}

fn mir_cpp_function_capture_count(m: MirUnit, function_id: i32) -> i32 {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return 0; }
    var out: i32 = 0;
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if (mir_cpp_local_is_capture(m, local_id)) { out = out + 1; }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    return out;
}

fn mir_cpp_closure_env_type_name(m: MirUnit, function_id: i32) -> string {
    return "vyx_closure_env_" + mir_cpp_ident(m.function_name(function_id)) + "_" + mir_cpp_i32(function_id);
}

fn mir_cpp_closure_capture_field_name(m: MirUnit, local_id: i32, index: i32) -> string {
    return "cap_" + mir_cpp_i32(index) + "_" + mir_cpp_ident(m.local_name(local_id));
}

fn mir_cpp_closure_adapter_name(m: MirUnit, function_id: i32) -> string {
    return mir_cpp_function_name(m, function_id) + "_vyx_closure_adapter";
}

fn mir_cpp_value_is_call_lhs(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    var call_id: i32 = 1;
    while (call_id <= m.value_count) {
        if (m.value_kind(call_id) == mir_value_call()
            && m.value_lhs(call_id) == value_id) {
            return true;
        }
        call_id = call_id + 1;
    }
    return false;
}

fn mir_cpp_function_has_closure_value_use(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (m.function_streamed_needs_closure_adapter(function_id)) { return true; }
    // Streamed bodies were already rendered and deliberately released. Their
    // value records are no longer available for this whole-unit scan.
    if (m.function_streamed_body_discarded(function_id)) { return false; }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_target_ref()
            && m.value_target_kind(value_id) == mir_target_function()
            && m.value_target_id(value_id) == function_id
            && !mir_cpp_value_is_call_lhs(m, value_id)
            && mir_cpp_type_is_fn_value(m, m.value_type(value_id))) {
            return true;
        }
        value_id = value_id + 1;
    }
    return false;
}

fn mir_cpp_function_needs_closure_adapter(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (mir_cpp_function_is_closure(m, function_id)) { return false; }
    if (mir_cpp_is_entry_main(m, function_id)) { return false; }
    if (!mir_cpp_function_has_body(m, function_id)) { return false; }
    return mir_cpp_function_has_closure_value_use(m, function_id);
}

fn mir_cpp_closure_code_name(m: MirUnit, function_id: i32) -> string {
    if (mir_cpp_function_is_closure(m, function_id)) { return mir_cpp_function_name(m, function_id); }
    if (mir_cpp_function_needs_closure_adapter(m, function_id)) { return mir_cpp_closure_adapter_name(m, function_id); }
    return mir_cpp_function_name(m, function_id);
}

fn mir_cpp_capture_init_expr(m: MirUnit, local_id: i32) -> string {
    let init_value = m.local_capture_init_value(local_id);
    if (init_value != mir_id_invalid()) {
        return mir_cpp_value_expr_for_type(m, init_value, m.local_type(local_id));
    }
    let source_local = m.local_capture_source(local_id);
    if (source_local != mir_id_invalid()) { return mir_cpp_local_name(m, source_local); }
    return mir_cpp_default_expr(m, m.local_type(local_id));
}

fn mir_cpp_closure_value_expr(m: MirUnit, function_id: i32) -> string {
    let code_name = mir_cpp_closure_code_name(m, function_id);
    if (!mir_cpp_function_is_closure(m, function_id)
        || mir_cpp_function_capture_count(m, function_id) <= 0) {
        return "vyx::make_closure(reinterpret_cast<void*>(&" + code_name + "), nullptr)";
    }
    let env_ty = mir_cpp_closure_env_type_name(m, function_id);
    var out = "([&]() { auto* vyx_env = new " + env_ty + "{";
    var first = true;
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if (mir_cpp_local_is_capture(m, local_id)) {
            if (!first) { out = out + ", "; }
            if (mir_cpp_local_is_reference_capture(m, local_id)) {
                let source_local = m.local_capture_source(local_id);
                if (source_local != mir_id_invalid()) {
                    out = out + "&" + mir_cpp_local_name(m, source_local);
                } else {
                    out = out + "nullptr";
                }
            } else {
                out = out + mir_cpp_capture_init_expr(m, local_id);
            }
            first = false;
        }
        local_id = m.local_next(local_id);
    }
    out = out + "}; return vyx::make_closure(reinterpret_cast<void*>(&" + code_name
        + "), static_cast<void*>(vyx_env)); }())";
    return out;
}

fn mir_cpp_find_method_by_owner_name(m: MirUnit, owner_type: string, name: string) -> i32 {
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (m.function_owner_type(function_id) == owner_type
            && mir_cpp_function_source_name(m, function_id) == name) {
            return function_id;
        }
        function_id = function_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_function_name_matches_method(mangled: string, name: string) -> bool {
    if (mangled == name) { return true; }
    if (name == "has_next" && mangled.contains("_3A_3Ahas_5Fnext_3A_3A")) { return true; }
    if (name == "next" && mangled.contains("_3A_3Anext_3A_3A")) { return true; }
    return false;
}

fn mir_cpp_find_method_by_owner_method_name(m: MirUnit, owner_type: string, name: string) -> i32 {
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (m.function_owner_type(function_id) == owner_type
            && mir_cpp_function_name_matches_method(mir_cpp_function_source_name(m, function_id), name)) {
            return function_id;
        }
        function_id = function_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_string_compare_operand(m: MirUnit, value_id: i32) -> string {
    let type_id = m.value_type(value_id);
    let cpp_ty = mir_cpp_type_text(m, type_id);
    if (cpp_ty == "vyx::Str") { return mir_cpp_value_expr(m, value_id); }
    let raw_expr = mir_cpp_std_string_raw_expr(m, value_id);
    if (raw_expr.len > 0) { return raw_expr; }
    return "";
}

/// Field syntax is uniform for values and borrowed receivers.  A reference
/// handle still owns the concrete pointee type, so project it to a C++ lvalue
/// before emitting `.field`; this mirrors LLVM's receiver auto-deref path.
fn mir_cpp_field_base_expr(m: MirUnit, base_place: i32, base_type: i32, field_id: i32) -> string {
    let base = mir_cpp_place_expr(m, base_place);
    if (base_type == mir_id_invalid()) { return base; }
    let kind = mir_cpp_type_kind(m, base_type);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        var pointee = hir_type_table_elem(m.types, base_type);
        // Some late materialized pointer views retain a shell type with no
        // fields while the resolved field retains the concrete owner layout.
        // Prefer that owner only for an otherwise layout-less pointee; a real
        // derived layout keeps its own record type and field remapping.
        let owner = m.field_owner_type(field_id);
        if (pointee != mir_id_invalid()
            && m.field_count_for_type(pointee) <= 0
            && owner != mir_id_invalid()
            && m.field_count_for_type(owner) > 0) {
            pointee = owner;
        }
        if (pointee != mir_id_invalid()
            && mir_cpp_type_kind(m, pointee) == ty_CLASS()) {
            return "vyx::ptr_deref_as<" + mir_cpp_type_text(m, pointee)
                + ">(" + base + ")";
        }
    }
    return base;
}

fn mir_cpp_place_expr(m: MirUnit, place_id: i32) -> string {
    if (place_id == mir_id_invalid()) { return "vyx::lvalue<vyx::Any>()"; }
    let kind = m.place_kind(place_id);
    if (kind == mir_place_local()) {
        return mir_cpp_local_name(m, m.place_local(place_id));
    }
    if (kind == mir_place_static()) {
        return mir_cpp_static_name(m, m.place_local(place_id));
    }
    if (kind == mir_place_deref()) {
        let ptr_value = m.place_index_value(place_id);
        if (m.place_check_policy(place_id) == mir_check_policy_unchecked()) {
            if (ptr_value != mir_id_invalid()) {
                return "vyx::ptr_deref_unchecked<" + mir_cpp_type_text(m, m.place_type(place_id))
                    + ">(" + mir_cpp_value_expr(m, ptr_value) + ")";
            }
            return "vyx::ptr_deref_unchecked<" + mir_cpp_type_text(m, m.place_type(place_id)) + ">(" + mir_cpp_place_expr(m, m.place_base(place_id)) + ")";
        }
        if (ptr_value != mir_id_invalid()) {
            return "vyx::ptr_deref_as<" + mir_cpp_type_text(m, m.place_type(place_id))
                + ">(" + mir_cpp_value_expr(m, ptr_value) + ")";
        }
        return "vyx::ptr_deref_as<" + mir_cpp_type_text(m, m.place_type(place_id)) + ">(" + mir_cpp_place_expr(m, m.place_base(place_id)) + ")";
    }
    if (kind == mir_place_field()) {
        let field_id = m.place_field(place_id);
        let base_place = m.place_base(place_id);
        let base_type = m.place_type(base_place);
        let base_expr = mir_cpp_field_base_expr(m, base_place, base_type, field_id);
        if (mir_cpp_type_is_dci_stub_class(m, base_type)) {
            let offset = mir_cpp_dci_stub_field_offset(m, base_type, field_id);
            if (offset >= 0) {
                return "(*std::launder(reinterpret_cast<"
                    + mir_cpp_type_text(m, m.place_type(place_id))
                    + "*>(reinterpret_cast<unsigned char*>(" + base_expr
                    + ") + " + policy_i64_to_string(offset) + ")))";
            }
        }
        if (mir_unit_type_is_foreign_dci(&m,  base_type)) {
            let field_name = mir_cpp_field_source_name(m, field_id);
            let layout = mir_cpp_dci_layout_for_type(m, base_type);
            let field = mir_cpp_dci_field_object(m, layout, field_name, 0);
            let offset = mir_cpp_dci_field_offset(m, layout, field_name, 0);
            if (mir_cpp_dci_field_match_count(m, layout, field_name, 0) == 1
                && field != null
                && offset >= 0
                && mir_cpp_dci_type_object_matches(
                    m, mir_cpp_dci_json_item(field, "type"), m.place_type(place_id))) {
                return "(*std::launder(reinterpret_cast<"
                    + mir_cpp_type_text(m, m.place_type(place_id))
                    + "*>(reinterpret_cast<unsigned char*>(&(" + base_expr
                    + ")) + " + policy_i64_to_string(offset) + ")))";
            }
        }
        if (base_type != mir_id_invalid()
            && mir_cpp_type_kind(m, base_type) == ty_TUPLE()
            && field_id != mir_id_invalid()) {
            let tuple_index = m.field_index(field_id);
            if (tuple_index >= 0) {
                return "std::get<" + mir_cpp_i32(tuple_index) + ">(" + mir_cpp_place_expr(m, base_place) + ")";
            }
        }
        return "(" + base_expr + ")."
            + mir_cpp_field_cpp_name(m, field_id, m.field_index(field_id));
    }
    if (kind == mir_place_index()) {
        let base_place = m.place_base(place_id);
        let base_type = m.place_type(base_place);
        let base_kind = mir_cpp_type_kind(m, base_type);
        let base_expr = mir_cpp_place_expr(m, base_place);
        let index_expr = mir_cpp_value_expr(m, m.place_index_value(place_id));
        if (base_kind == ty_PTR() || base_kind == ty_REF() || base_kind == ty_MUTREF()) {
            // MIR carries the semantic result after array-view decay. Trust
            // it before falling back to the pointer's nominal pointee.
            var elem_type = m.place_type(place_id);
            if (elem_type == mir_id_invalid()
                || mir_cpp_type_text(m, elem_type).len == 0
                || mir_cpp_type_kind(m, elem_type) == ty_VOID()) {
                elem_type = hir_type_table_elem(m.types, base_type);
            }
            if (m.place_check_policy(place_id) == mir_check_policy_unchecked()) {
                return "vyx::ptr_index_unchecked<" + mir_cpp_type_text(m, elem_type) + ">(" + base_expr + ", " + index_expr + ")";
            }
            return "vyx::ptr_index_as<" + mir_cpp_type_text(m, elem_type) + ">(" + base_expr + ", " + index_expr + ")";
        }
        return "(" + base_expr + ")[" + index_expr + "]";
    }
    return "vyx::lvalue<" + mir_cpp_type_text(m, m.place_type(place_id)) + ">()";
}

fn mir_cpp_arg_list(m: MirUnit, first_arg: i32) -> string {
    var out: string = "";
    var cur = first_arg;
    var first = true;
    while (cur != mir_id_invalid()) {
        if (!first) {
            out = out + ",";
            out = out + " ";
        }
        out = out + mir_cpp_value_expr(m, cur);
        first = false;
        cur = m.value_next_arg(cur);
    }
    return out;
}

fn mir_cpp_function_param_type_at(m: MirUnit, function_id: i32, param_index: i32) -> i32 {
    return mir_unit_function_param_type_at(&m,  function_id, param_index);
}

fn mir_cpp_function_param_local_at(m: MirUnit, function_id: i32, param_index: i32) -> i32 {
    return mir_unit_function_param_local_at(&m,  function_id, param_index);
}

fn mir_cpp_function_param_needs_ref_at(m: MirUnit, function_id: i32, param_index: i32) -> bool {
    let local_id = mir_cpp_function_param_local_at(m, function_id, param_index);
    if (local_id == mir_id_invalid()) { return false; }
    return mir_cpp_param_needs_ref(m, local_id);
}

fn mir_cpp_value_is_lvalue_expr(m: MirUnit, value_id: i32, depth: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (depth > 16) { return false; }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_read_place()) { return true; }
    if (kind == mir_value_arg() && m.value_lhs(value_id) != mir_id_invalid()) {
        return mir_cpp_value_is_lvalue_expr(m, m.value_lhs(value_id), depth + 1);
    }
    return false;
}

fn mir_cpp_arg_needs_ref_temp(m: MirUnit, function_id: i32, param_index: i32, value_id: i32) -> bool {
    if (!mir_cpp_function_param_needs_ref_at(m, function_id, param_index)) { return false; }
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (mir_cpp_pointer_receiver_expr_for_ref_param(m, value_id, function_id, param_index).len > 0) {
        return false;
    }
    let param_type = mir_cpp_function_param_type_at(m, function_id, param_index);
    if (param_type != mir_id_invalid()
        && param_type > 0
        && param_type <= m.types.count
        && mir_cpp_type_text(m, m.value_type(value_id)) != mir_cpp_type_text(m, param_type)) {
        return true;
    }
    return !mir_cpp_value_is_lvalue_expr(m, value_id, 0);
}

fn mir_cpp_fn_sig_text(m: MirUnit, type_id: i32) -> string {
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.startsWith("unsafe fn")) {
        return "cfn" + text.substring(9, text.len);
    }
    return text;
}

fn mir_cpp_fn_sig_params_text(m: MirUnit, type_id: i32) -> string {
    let text = mir_cpp_fn_sig_text(m, type_id);
    let open = mir_cpp_string_find(text, "(", 0);
    if (open < 0) { return ""; }
    var depth: i32 = 0;
    var i = open;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (ch == 40) { depth = depth + 1; }
        else if (ch == 41) {
            depth = depth - 1;
            if (depth == 0) { return text.substring(open + 1, i); }
        }
        i = i + 1;
    }
    return "";
}

fn mir_cpp_fn_sig_return_text(m: MirUnit, type_id: i32) -> string {
    let text = mir_cpp_fn_sig_text(m, type_id);
    let arrow = mir_cpp_string_find(text, "->", 0);
    if (arrow < 0) { return "void"; }
    return mir_cpp_trim(text.substring(arrow + 2, text.len));
}

fn mir_cpp_fn_sig_param_count(m: MirUnit, type_id: i32) -> i32 {
    let params = mir_cpp_fn_sig_params_text(m, type_id);
    if (mir_cpp_trim(params).len == 0) { return 0; }
    var count: i32 = 0;
    while (count < 128) {
        let part = mir_cpp_top_level_csv_part(params, count);
        if (part.len == 0) { return count; }
        count = count + 1;
    }
    return count;
}

fn mir_cpp_fn_sig_param_cpp_at(m: MirUnit, type_id: i32, index: i32) -> string {
    let part = mir_cpp_top_level_csv_part(mir_cpp_fn_sig_params_text(m, type_id), index);
    if (part.len == 0) { return "void*"; }
    let colon = mir_cpp_string_find(part, ":", 0);
    var ty_text = part;
    if (colon >= 0 && colon + 1 < part.len) {
        ty_text = mir_cpp_trim(part.substring(colon + 1, part.len));
    }
    return mir_cpp_type_text_from_source_in_unit(m, ty_text);
}

fn mir_cpp_fn_sig_return_cpp(m: MirUnit, type_id: i32) -> string {
    return mir_cpp_type_text_from_source_in_unit(m, mir_cpp_fn_sig_return_text(m, type_id));
}

fn mir_cpp_type_texts_compatible(lhs: string, rhs: string) -> bool {
    if (lhs == rhs) { return true; }
    return false;
}

fn mir_cpp_reflected_method_matches_fn_type(m: MirUnit, method_fn: i32, fn_type_id: i32) -> bool {
    if (method_fn == mir_id_invalid() || fn_type_id == mir_id_invalid()) { return false; }
    if (!mir_cpp_function_has_body(m, method_fn)) { return false; }
    let fn_kind = mir_cpp_type_kind(m, fn_type_id);
    if (fn_kind != ty_FN() && fn_kind != ty_CFN()) { return false; }
    let is_closure = mir_cpp_function_is_closure(m, method_fn);
    if (is_closure && fn_kind == ty_CFN()) { return false; }
    let source_count = mir_cpp_function_param_count(m, method_fn);
    if (source_count <= 0 && !is_closure) { return false; }
    let target_count = mir_cpp_fn_sig_param_count(m, fn_type_id);
    var source_arg_start: i32 = 1;
    var target_arg_start: i32 = 0;
    if (is_closure) {
        if (target_count != source_count) { return false; }
        source_arg_start = 0;
    } else if (fn_kind == ty_FN()) {
        if (target_count != source_count - 1) { return false; }
    } else {
        if (target_count != source_count) { return false; }
        if (target_count <= 0 || !mir_cpp_fn_sig_param_cpp_at(m, fn_type_id, 0).endsWith("*")) { return false; }
        target_arg_start = 1;
    }
    if (!mir_cpp_type_texts_compatible(mir_cpp_fn_sig_return_cpp(m, fn_type_id),
                                      mir_cpp_type_text(m, m.function_return_type(method_fn)))) {
        return false;
    }
    var source_idx = source_arg_start;
    var target_idx = target_arg_start;
    while (source_idx < source_count) {
        let source_ty = mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, method_fn, source_idx));
        let target_ty = mir_cpp_fn_sig_param_cpp_at(m, fn_type_id, target_idx);
        if (!mir_cpp_type_texts_compatible(source_ty, target_ty)) { return false; }
        source_idx = source_idx + 1;
        target_idx = target_idx + 1;
    }
    return true;
}

fn mir_cpp_reflected_method_adapter_name(m: MirUnit, method_fn: i32, fn_type_id: i32) -> string {
    return "vyx_reflect_method_" + mir_cpp_i32(method_fn) + "_as_" + mir_cpp_i32(fn_type_id);
}

fn mir_cpp_emit_reflected_method_adapter_decl(m: MirUnit, method_fn: i32, fn_type_id: i32) -> string {
    if (!mir_cpp_reflected_method_matches_fn_type(m, method_fn, fn_type_id)) { return ""; }
    let ret = mir_cpp_fn_sig_return_cpp(m, fn_type_id);
    let fn_kind = mir_cpp_type_kind(m, fn_type_id);
    var out = ret + " " + mir_cpp_reflected_method_adapter_name(m, method_fn, fn_type_id) + "(";
    var first = true;
    if (fn_kind == ty_FN()) {
        out = out + "void* vyx_reflect_receiver";
        first = false;
    }
    let target_count = mir_cpp_fn_sig_param_count(m, fn_type_id);
    var idx: i32 = 0;
    while (idx < target_count) {
        if (!first) { out = out + ", "; }
        out = out + mir_cpp_fn_sig_param_cpp_at(m, fn_type_id, idx)
            + " vyx_reflect_arg_" + mir_cpp_i32(idx);
        first = false;
        idx = idx + 1;
    }
    return out + ")";
}

fn mir_cpp_reflected_method_self_arg(m: MirUnit, method_fn: i32, receiver_expr: string) -> string {
    let self_type = mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, method_fn, 0));
    if (self_type == "void*" || self_type.len == 0) { return receiver_expr; }
    return "(*reinterpret_cast<" + self_type + "*>(" + receiver_expr + "))";
}

fn mir_cpp_emit_reflected_method_adapter_function(m: MirUnit, method_fn: i32, fn_type_id: i32) -> string {
    let decl = mir_cpp_emit_reflected_method_adapter_decl(m, method_fn, fn_type_id);
    if (decl.len == 0) { return ""; }
    let fn_kind = mir_cpp_type_kind(m, fn_type_id);
    var receiver_expr = "vyx_reflect_receiver";
    if (fn_kind == ty_CFN()) { receiver_expr = "vyx_reflect_arg_0"; }
    var call = mir_cpp_function_name(m, method_fn) + "(";
    var source_idx: i32 = 0;
    var target_idx: i32 = 0;
    var first_arg = true;
    if (mir_cpp_function_is_closure(m, method_fn)) {
        call = call + receiver_expr;
        first_arg = false;
    } else {
        call = call + mir_cpp_reflected_method_self_arg(m, method_fn, receiver_expr);
        first_arg = false;
        source_idx = 1;
        if (fn_kind == ty_CFN()) { target_idx = 1; }
    }
    while (source_idx < mir_cpp_function_param_count(m, method_fn)) {
        if (!first_arg) { call = call + ", "; }
        call = call + "vyx_reflect_arg_" + mir_cpp_i32(target_idx);
        first_arg = false;
        source_idx = source_idx + 1;
        target_idx = target_idx + 1;
    }
    call = call + ")";
    let ret = mir_cpp_fn_sig_return_cpp(m, fn_type_id);
    var out = decl + " {\n";
    if (ret == "void") {
        out = out + "    " + call + ";\n";
        out = out + "    return;\n";
    } else {
        out = out + "    return " + call + ";\n";
    }
    return out + "}\n\n";
}

fn mir_cpp_emit_reflected_method_adapter_decls(m: MirUnit) -> string {
    var out = "";
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (fn_id <= m.function_count) {
                let decl = mir_cpp_emit_reflected_method_adapter_decl(m, fn_id, type_id);
                if (decl.len > 0) { out = out + decl + ";\n"; }
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    return out;
}

fn mir_cpp_emit_reflected_method_adapter_functions(m: MirUnit) -> string {
    var out = "";
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (fn_id <= m.function_count) {
                out = out + mir_cpp_emit_reflected_method_adapter_function(m, fn_id, type_id);
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    return out;
}

fn mir_cpp_reflect_method_value_expr(m: MirUnit, value_id: i32) -> string {
    let target_type = m.value_type(value_id);
    let target_kind = mir_cpp_type_kind(m, target_type);
    let first_arg = m.value_first_arg(value_id);
    let argc = mir_cpp_call_arg_count(m, first_arg);
    var id_expr = "0";
    var receiver_expr = "nullptr";
    var id_type = "";
    if (argc > 0) {
        id_expr = mir_cpp_call_arg_expr_at(m, first_arg, 0);
        id_type = mir_cpp_type_text(m, m.value_type(first_arg));
    }
    if (argc > 1) { receiver_expr = "static_cast<void*>(" + mir_cpp_call_arg_expr_at(m, first_arg, 1) + ")"; }
    var id_init = "int64_t vyx_reflect_id = 0; std::string vyx_reflect_name{}; ";
    if (id_type == "vyx::Str") {
        id_init = id_init + "vyx_reflect_name = vyx::str_to_std(" + id_expr + "); ";
    } else if (id_type == "void*") {
        id_init = id_init + "vyx_reflect_id = static_cast<int64_t>(reinterpret_cast<intptr_t>(" + id_expr + ")); ";
    } else if (mir_cpp_type_is_integer_text(id_type) || id_type == "bool") {
        id_init = id_init + "vyx_reflect_id = static_cast<int64_t>(" + id_expr + "); ";
    }
    var out = "([&]() { " + id_init + "void* vyx_reflect_receiver = " + receiver_expr + "; ";
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        let method_id = mir_cpp_reflected_method_id_for_function(m, fn_id);
        if (method_id > 0 && mir_cpp_reflected_method_matches_fn_type(m, fn_id, target_type)) {
            let adapter = mir_cpp_reflected_method_adapter_name(m, fn_id, target_type);
            let owner_type = mir_cpp_reflected_method_owner_type_for_function(m, fn_id);
            let method_name = mir_cpp_function_method_name(m, fn_id);
            let method_symbol = mir_cpp_class_method_symbol_name(owner_type, method_name);
            out = out + "if (vyx_reflect_id == " + policy_i64_to_string(method_id)
                + " || vyx_reflect_name == " + mir_cpp_quote(method_symbol)
                + " || vyx_reflect_name == " + mir_cpp_quote(method_name) + ") { ";
            if (target_kind == ty_FN()) {
                out = out + "return vyx::make_closure(reinterpret_cast<void*>(&" + adapter + "), vyx_reflect_receiver); ";
            } else {
                out = out + "return reinterpret_cast<void*>(&" + adapter + "); ";
            }
            out = out + "} ";
        }
        fn_id = fn_id + 1;
    }
    var default_expr = mir_cpp_default_expr(m, target_type);
    if (target_kind == ty_CFN()) { default_expr = "static_cast<void*>(nullptr)"; }
    out = out + "return " + default_expr + "; }())";
    return out;
}

fn mir_cpp_arg_expr_for_param(m: MirUnit, value_id: i32, function_id: i32, param_index: i32) -> string {
    let param_type = mir_cpp_function_param_type_at(m, function_id, param_index);
    if (mir_cpp_function_is_foreign_c(m, function_id)
        && mir_cpp_type_is_pointer_handle(m, param_type)) {
        return "to_rawptr(" + mir_cpp_value_expr(m, value_id) + ")";
    }
    let receiver = mir_cpp_pointer_receiver_expr_for_ref_param(m, value_id, function_id, param_index);
    if (receiver.len > 0) { return receiver; }
    if (param_type != mir_id_invalid()) { return mir_cpp_value_expr_for_type(m, value_id, param_type); }
    return mir_cpp_value_expr(m, value_id);
}

fn mir_cpp_foreign_c_return_expr(m: MirUnit, function_id: i32, call_expr: string) -> string {
    if (!mir_cpp_function_is_foreign_c(m, function_id)) { return call_expr; }
    let type_id = m.function_return_type(function_id);
    if (!mir_cpp_type_is_pointer_handle(m, type_id)) { return call_expr; }
    let element_type_id = hir_type_table_elem(m.types, type_id);
    if (element_type_id == mir_id_invalid()) { return call_expr; }
    return "vyx::ptr_from_raw<" + mir_cpp_type_text(m, element_type_id)
        + ">(" + call_expr + ")";
}

fn mir_cpp_arg_list_for_function(m: MirUnit, function_id: i32, first_arg: i32) -> string {
    var out: string = "";
    var cur = first_arg;
    var first = true;
    var param_index: i32 = 0;
    while (cur != mir_id_invalid()) {
        if (!first) {
            out = out + ",";
            out = out + " ";
        }
        out = out + mir_cpp_arg_expr_for_param(m, cur, function_id, param_index);
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return out;
}

fn mir_cpp_arg_list_for_function_from_param(m: MirUnit, function_id: i32, first_arg: i32, param_index_start: i32) -> string {
    var out: string = "";
    var cur = first_arg;
    var first = true;
    var param_index: i32 = param_index_start;
    while (cur != mir_id_invalid()) {
        if (!first) {
            out = out + ",";
            out = out + " ";
        }
        out = out + mir_cpp_arg_expr_for_param(m, cur, function_id, param_index);
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return out;
}

fn mir_cpp_default_self_expr(m: MirUnit, function_id: i32) -> string {
    let self_type = mir_cpp_function_param_type_at(m, function_id, 0);
    if (mir_cpp_function_is_vyx_ctor(m, function_id)
        && mir_cpp_type_is_dci_stub_class(m, self_type)) {
        return mir_cpp_dci_stub_factory_symbol(mir_cpp_type_source_text(m, self_type)) + "()";
    }
    return mir_cpp_default_expr(m, self_type);
}

fn mir_cpp_call_with_default_self_arg(m: MirUnit, function_id: i32, first_arg: i32) -> string {
    var args = mir_cpp_default_self_expr(m, function_id);
    let rest = mir_cpp_arg_list_for_function_from_param(m, function_id, first_arg, 1);
    if (rest.len > 0) {
        args = args + ",";
        args = args + " ";
        args = args + rest;
    }
    return mir_cpp_function_name(m, function_id) + "(" + args + ")";
}

fn mir_cpp_emit_call_with_default_self_arg_to_file(m: MirUnit, file: &mut std.fs.File, function_id: i32, first_arg: i32) -> i32 {
    if (mir_cpp_append(file, mir_cpp_function_name(m, function_id)) != 0) { return -1; }
    if (mir_cpp_append(file, "(") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_default_self_expr(m, function_id)) != 0) { return -1; }
    let rest = mir_cpp_arg_list_for_function_from_param(m, function_id, first_arg, 1);
    if (rest.len > 0) {
        if (mir_cpp_append(file, ", ") != 0) { return -1; }
        if (mir_cpp_append(file, rest) != 0) { return -1; }
    }
    return mir_cpp_append(file, ")");
}

fn mir_cpp_call_has_ref_temp(m: MirUnit,
                             function_id: i32,
                             receiver: i32,
                             first_arg: i32,
                             has_default_self: bool) -> bool {
    var param_index: i32 = 0;
    if (receiver != mir_id_invalid()) {
        if (mir_cpp_arg_needs_ref_temp(m, function_id, param_index, receiver)) { return true; }
        param_index = param_index + 1;
    } else if (has_default_self) {
        if (mir_cpp_function_param_needs_ref_at(m, function_id, 0)) { return true; }
        param_index = 1;
    }
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        if (mir_cpp_arg_needs_ref_temp(m, function_id, param_index, cur)) { return true; }
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return false;
}

fn mir_cpp_call_with_ref_temps(m: MirUnit,
                               function_id: i32,
                               receiver: i32,
                               first_arg: i32,
                               has_default_self: bool) -> string {
    var declarations = "";
    var args = "";
    var first = true;
    var param_index: i32 = 0;
    if (receiver != mir_id_invalid()) {
        if (mir_cpp_arg_needs_ref_temp(m, function_id, param_index, receiver)) {
            let param_type = mir_cpp_function_param_type_at(m, function_id, param_index);
            let temp_name = "vyx_tmp_arg_" + mir_cpp_i32(param_index);
            declarations = declarations + mir_cpp_type_text(m, param_type) + " " + temp_name
                + " = " + mir_cpp_value_expr_for_type(m, receiver, param_type) + "; ";
            args = temp_name;
        } else {
            args = mir_cpp_arg_expr_for_param(m, receiver, function_id, param_index);
        }
        first = false;
        param_index = param_index + 1;
    } else if (has_default_self) {
        let self_type = mir_cpp_function_param_type_at(m, function_id, 0);
        if (mir_cpp_function_param_needs_ref_at(m, function_id, 0)) {
            declarations = declarations + mir_cpp_type_text(m, self_type)
                + " vyx_tmp_arg_0 = " + mir_cpp_default_self_expr(m, function_id) + "; ";
            args = "vyx_tmp_arg_0";
        } else {
            args = mir_cpp_default_self_expr(m, function_id);
        }
        first = false;
        param_index = 1;
    }
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        if (!first) { args = args + ", "; }
        if (mir_cpp_arg_needs_ref_temp(m, function_id, param_index, cur)) {
            let param_type2 = mir_cpp_function_param_type_at(m, function_id, param_index);
            let temp_name2 = "vyx_tmp_arg_" + mir_cpp_i32(param_index);
            declarations = declarations + mir_cpp_type_text(m, param_type2) + " " + temp_name2
                + " = " + mir_cpp_value_expr_for_type(m, cur, param_type2) + "; ";
            args = args + temp_name2;
        } else {
            args = args + mir_cpp_arg_expr_for_param(m, cur, function_id, param_index);
        }
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    let call = mir_cpp_function_name(m, function_id) + "(" + args + ")";
    let ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
    if (ret_ty == "void") {
        return "([&]() { " + declarations + call + "; }())";
    }
    return "([&]() { " + declarations + "return " + call + "; }())";
}

fn mir_cpp_std_string_raw_function(m: MirUnit, type_id: i32) -> i32 {
    if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
    let source_ty = mir_cpp_type_source_text(m, type_id);
    if (source_ty != "std.string.String") { return mir_id_invalid(); }
    return mir_cpp_find_method_by_owner_name(m, source_ty, "raw");
}

fn mir_cpp_std_string_raw_expr(m: MirUnit, value_id: i32) -> string {
    let source_ty = mir_cpp_type_source_text(m, m.value_type(value_id));
    if (source_ty != "std.string.String") { return ""; }
    let raw_fn = mir_cpp_std_string_raw_function(m, m.value_type(value_id));
    if (raw_fn == mir_id_invalid() || !mir_cpp_function_has_body(m, raw_fn)) {
        return "vyx::string_object_to_str(" + mir_cpp_value_expr(m, value_id) + ")";
    }
    if (mir_cpp_call_has_ref_temp(m, raw_fn, value_id, mir_id_invalid(), false)) {
        return mir_cpp_call_with_ref_temps(m, raw_fn, value_id, mir_id_invalid(), false);
    }
    return mir_cpp_function_name(m, raw_fn) + "(" + mir_cpp_value_expr(m, value_id) + ")";
}

fn mir_cpp_fstring_expr(m: MirUnit, value_id: i32) -> string {
    var cur = m.value_first_arg(value_id);
    if (cur == mir_id_invalid()) {
        return "vyx::str_lit(" + mir_cpp_quote(mir_cpp_value_source_text(m, value_id)) + ")";
    }
    var out: string = "";
    while (cur != mir_id_invalid()) {
        var seg = mir_cpp_value_expr(m, cur);
        if (mir_cpp_type_text(m, m.value_type(cur)) != "vyx::Str") {
            let raw_seg = mir_cpp_std_string_raw_expr(m, cur);
            if (raw_seg.len > 0) {
                seg = raw_seg;
            } else {
                seg = "vyx::to_string(" + seg + ")";
            }
        }
        if (out.len == 0) {
            out = seg;
        } else {
            out = "(" + out + " + " + seg + ")";
        }
        cur = m.value_next_arg(cur);
    }
    if (out.len == 0) { return "vyx::Str{}"; }
    return out;
}

fn mir_cpp_call_arg_count(m: MirUnit, first_arg: i32) -> i32 {
    var out: i32 = 0;
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        out = out + 1;
        cur = m.value_next_arg(cur);
    }
    return out;
}

fn mir_cpp_call_arg_expr_at(m: MirUnit, first_arg: i32, want_idx: i32) -> string {
    var cur = first_arg;
    var idx: i32 = 0;
    while (cur != mir_id_invalid()) {
        if (idx == want_idx) { return mir_cpp_value_expr(m, cur); }
        cur = m.value_next_arg(cur);
        idx = idx + 1;
    }
    return "vyx::Any{}";
}

fn mir_cpp_c_runtime_arg_expr(m: MirUnit,
                              function_id: i32,
                              first_arg: i32,
                              want_idx: i32) -> string {
    let expression = mir_cpp_call_arg_expr_at(m, first_arg, want_idx);
    if (!mir_cpp_function_is_foreign_c(m, function_id)) { return expression; }
    let param_type = mir_cpp_function_param_type_at(m, function_id, want_idx);
    if (mir_cpp_type_is_pointer_handle(m, param_type)) {
        return "to_rawptr(" + expression + ")";
    }
    return expression;
}

fn mir_cpp_call_arg_type_list(m: MirUnit, first_arg: i32) -> string {
    var out: string = "";
    var cur = first_arg;
    var first = true;
    while (cur != mir_id_invalid()) {
        if (!first) { out = out + ", "; }
        var ty = mir_cpp_type_text(m, m.value_type(cur));
        if (ty == "void") { ty = "vyx::Any"; }
        out = out + ty;
        first = false;
        cur = m.value_next_arg(cur);
    }
    return out;
}

fn mir_cpp_call_receiver_value(m: MirUnit, callee_value: i32) -> i32 {
    if (callee_value == mir_id_invalid()) { return mir_id_invalid(); }
    let receiver = m.value_lhs(callee_value);
    if (receiver == mir_id_invalid()) { return mir_id_invalid(); }
    if (m.value_kind(receiver) == mir_value_target_ref()) {
        let tk = m.value_target_kind(receiver);
        if (tk == mir_target_hir_item() && !m.static_exists(m.value_target_id(receiver))) { return mir_id_invalid(); }
        if (tk == mir_target_type()) { return mir_id_invalid(); }
    }
    return receiver;
}

fn mir_cpp_callee_has_type_receiver(m: MirUnit, callee_value: i32) -> bool {
    if (callee_value == mir_id_invalid()) { return false; }
    let receiver = m.value_lhs(callee_value);
    if (receiver == mir_id_invalid()) { return false; }
    if (m.value_kind(receiver) == mir_value_target_ref()
        && m.value_target_kind(receiver) == mir_target_type()) {
        return true;
    }
    if (m.value_kind(receiver) == mir_value_target_ref()
        && m.value_target_kind(receiver) == mir_target_hir_item()
        && !m.static_exists(m.value_target_id(receiver))) {
        return true;
    }
    return false;
}

fn mir_cpp_arg_list_with_receiver(m: MirUnit, receiver: i32, first_arg: i32) -> string {
    var out: string = "";
    var first = true;
    if (receiver != mir_id_invalid()) {
        out = out + mir_cpp_value_expr(m, receiver);
        first = false;
    }
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        if (!first) {
            out = out + ",";
            out = out + " ";
        }
        out = out + mir_cpp_value_expr(m, cur);
        first = false;
        cur = m.value_next_arg(cur);
    }
    return out;
}

fn mir_cpp_arg_list_with_receiver_for_function(m: MirUnit, function_id: i32, receiver: i32, first_arg: i32) -> string {
    var out: string = "";
    var first = true;
    var param_index: i32 = 0;
    if (receiver != mir_id_invalid()) {
        out = out + mir_cpp_arg_expr_for_param(m, receiver, function_id, param_index);
        first = false;
        param_index = param_index + 1;
    }
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        if (!first) {
            out = out + ",";
            out = out + " ";
        }
        out = out + mir_cpp_arg_expr_for_param(m, cur, function_id, param_index);
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return out;
}

fn mir_cpp_builtin_args_with_receiver(m: MirUnit, lhs: i32, first_arg: i32) -> string {
    var receiver = mir_id_invalid();
    if (lhs != mir_id_invalid()) { receiver = mir_cpp_call_receiver_value(m, lhs); }
    return mir_cpp_arg_list_with_receiver(m, receiver, first_arg);
}

fn mir_cpp_string_like_builtin(name: string) -> bool {
    if (name == "find" || name == "indexOf") { return true; }
    if (name == "contains" || name == "startsWith" || name == "endsWith") { return true; }
    if (name == "equals" || name == "isEmpty" || name == "is_empty") { return true; }
    if (name == "replace" || name == "trim" || name == "substring" || name == "toUpper" || name == "toLower") { return true; }
    if (name == "charAt" || name == "charCodeAt" || name == "char_at" || name == "char_code_at") { return true; }
    return false;
}

fn mir_cpp_c_runtime_call_expr(m: MirUnit,
                               name: string,
                               first_arg: i32,
                               function_id: i32) -> string {
    let a0 = mir_cpp_c_runtime_arg_expr(m, function_id, first_arg, 0);
    let a1 = mir_cpp_c_runtime_arg_expr(m, function_id, first_arg, 1);
    let a2 = mir_cpp_c_runtime_arg_expr(m, function_id, first_arg, 2);
    let a3 = mir_cpp_c_runtime_arg_expr(m, function_id, first_arg, 3);
    if (name == "vyx_forget_string_len") {
        return "vyx::forget_string_len(" + a0 + ")";
    }
    if (name == "vyx_free_runtime_string") {
        return "vyx::free_runtime_string(" + a0 + ")";
    }
    if (name == "vyx_free_pooled_string") {
        return "vyx::free_pooled_string(" + a0 + ")";
    }
    if (name == "vyx_int_decimal_len_abi") {
        return "vyx::int_decimal_len(" + a0 + ")";
    }
    if (name == "vyx_int_to_string_into_abi") {
        return "vyx::int_to_string_into(" + a0 + ", " + a1 + ")";
    }
    if (name == "vyx_uint_decimal_len_abi") {
        return "vyx::uint_decimal_len(" + a0 + ")";
    }
    if (name == "vyx_uint_to_string_into_abi") {
        return "vyx::uint_to_string_into(" + a0 + ", " + a1 + ")";
    }
    if (name == "vyx_pointer_allocation_register") {
        return "vyx::ptr_allocation_register(" + a0 + ", " + a1 + ")";
    }
    if (name == "vyx_pointer_allocation_unregister") {
        return "vyx::ptr_allocation_unregister(" + a0 + ")";
    }
    if (name == "vyx_pointer_allocation_unregister_range") {
        return "vyx::ptr_allocation_unregister_range(" + a0 + ", " + a1 + ")";
    }
    if (name == "vyx_pointer_allocation_realloc") {
        return "vyx::ptr_allocation_realloc(" + a0 + ", " + a1 + ", " + a2 + ")";
    }
    if (name == "int_to_string" || name == "bool_to_string") {
        return "vyx::to_string(" + a0 + ")";
    }
    if (name == "calloc") {
        return "std::calloc(static_cast<std::size_t>(" + a0
            + "), static_cast<std::size_t>(" + a1 + "))";
    }
    if (name == "strlen") {
        return "std::strlen(vyx::cstr(" + a0 + "))";
    }
    if (name == "strcmp") {
        return "std::strcmp(vyx::cstr(" + a0
            + "), vyx::cstr(" + a1 + "))";
    }
    if (name == "strncmp") {
        return "std::strncmp(vyx::cstr(" + a0
            + "), vyx::cstr(" + a1
            + "), static_cast<std::size_t>(" + a2 + "))";
    }
    if (name == "strstr") {
        return "std::strstr(const_cast<char*>(vyx::cstr(" + a0
            + ")), vyx::cstr(" + a1 + "))";
    }
    if (name == "getenv") {
        return "const_cast<char*>(std::getenv(vyx::cstr(" + a0 + ")))";
    }
    if (name == "malloc") { return "std::malloc(static_cast<std::size_t>(" + a0 + "))"; }
    if (name == "realloc") {
        return "std::realloc(" + a0
            + ", static_cast<std::size_t>(" + a1 + "))";
    }
    if (name == "free") { return "std::free(" + a0 + ")"; }
    if (name == "memcpy") {
        return "std::memcpy(" + a0
            + ", " + a1
            + ", static_cast<std::size_t>(" + a2 + "))";
    }
    if (name == "memmove") {
        return "std::memmove(" + a0
            + ", " + a1
            + ", static_cast<std::size_t>(" + a2 + "))";
    }
    if (name == "memset") {
        return "std::memset(" + a0
            + ", " + a1
            + ", static_cast<std::size_t>(" + a2 + "))";
    }
    if (name == "strtoll") {
        return "std::strtoll(vyx::cstr(" + a0
            + "), static_cast<char**>(" + a1
            + "), " + a2 + ")";
    }
    if (name == "strtod") {
        return "std::strtod(vyx::cstr(" + a0
            + "), static_cast<char**>(" + a1 + "))";
    }
    if (name == "atof") {
        return "std::atof(vyx::cstr(" + a0 + "))";
    }
    if (name == "atoi") {
        return "std::atoi(vyx::cstr(" + a0 + "))";
    }
    if (name == "fopen") {
        return "std::fopen(vyx::cstr(" + a0
            + "), vyx::cstr(" + a1 + "))";
    }
    if (name == "fclose") {
        return "std::fclose(static_cast<FILE*>(" + a0 + "))";
    }
    if (name == "fread") {
        return "std::fread(" + a0
            + ", static_cast<std::size_t>(" + a1
            + "), static_cast<std::size_t>(" + a2
            + "), static_cast<FILE*>(" + a3 + "))";
    }
    if (name == "fwrite") {
        return "std::fwrite(" + a0
            + ", static_cast<std::size_t>(" + a1
            + "), static_cast<std::size_t>(" + a2
            + "), static_cast<FILE*>(" + a3 + "))";
    }
    if (name == "fseek") {
        return "std::fseek(static_cast<FILE*>(" + a0
            + "), static_cast<long>(" + a1
            + "), " + a2 + ")";
    }
    if (name == "ftell") {
        return "std::ftell(static_cast<FILE*>(" + a0 + "))";
    }
    if (name == "remove") {
        return "std::remove(vyx::cstr(" + a0 + "))";
    }
    if (name == "rename") {
        return "std::rename(vyx::cstr(" + a0
            + "), vyx::cstr(" + a1 + "))";
    }
    if (name == "time") {
        return "std::time(vyx::timeptr(" + a0 + "))";
    }
    if (name == "_beginthread") {
        return "reinterpret_cast<void*>(static_cast<std::uintptr_t>(::_beginthread("
            + "reinterpret_cast<void (__cdecl *)(void*)>(" + a0 + "), "
            + "static_cast<unsigned>(" + a1 + "), " + a2 + ")))";
    }
    return "";
}

fn mir_cpp_typeof_type_name(m: MirUnit, value_id: i32, type_id: i32) -> string {
    var text = mir_cpp_type_source_text(m, type_id);
    if (text.len == 0) { return "unknown"; }
    let mapped = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), text);
    if (mapped.len > 0) { text = mapped; }
    return mir_cpp_type_name_from_source_text(text);
}

fn mir_cpp_type_name_from_source_text(text_raw: string) -> string {
    var text = text_raw.trim();
    if (text == "str" || text == "__String" || text == "std.string.String") { return "string"; }
    if (text == "i32" || text == "i64" || text == "f32" || text == "f64" || text == "bool") { return text; }
    if (text == "char") { return "char"; }
    return text;
}

fn mir_cpp_reflect_type_name_expr(m: MirUnit, value_id: i32, type_id: i32) -> string {
    return "vyx::str_lit(" + mir_cpp_quote(mir_cpp_typeof_type_name(m, value_id, type_id)) + ")";
}

fn mir_cpp_reflect_type_kind_name_from_text(text_raw: string) -> string {
    let text = mir_cpp_type_name_from_source_text(text_raw);
    if (text == "i8" || text == "i16" || text == "i32" || text == "i64") { return "int"; }
    if (text == "u8" || text == "u16" || text == "u32" || text == "u64") { return "int"; }
    if (text == "f32" || text == "f64") { return "float"; }
    if (text == "bool") { return "bool"; }
    if (text == "string") { return "string"; }
    if (text == "char") { return "char"; }
    return "class";
}

fn mir_cpp_reflect_type_kind_expr(m: MirUnit, value_id: i32, type_id: i32) -> string {
    return "vyx::str_lit(" + mir_cpp_quote(mir_cpp_reflect_type_kind_name_from_text(mir_cpp_typeof_type_name(m, value_id, type_id))) + ")";
}

fn mir_cpp_reflection_name_for_type_text(m: MirUnit, type_text_raw: string) -> string {
    let type_text = mir_cpp_trim(type_text_raw);
    if (type_text.len == 0) { return ""; }
    let raw_base = policy_generic_call_base(type_text.clone());
    let raw_short = mir_cpp_last_path_segment(raw_base);
    let map = mir_unit_reflection_name_map(&m);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= map.len) {
        var split = false;
        if (i == map.len) {
            split = true;
        } else if (map.charAt(i) == 10) {
            split = true;
        }
        if (split) {
            if (i > start) {
                let line = map.substring(start, i);
                let sep = mir_cpp_string_find(line, "~", 0);
                if (sep > 0 && sep + 1 < line.len) {
                    let raw = line.substring(0, sep);
                    let reflected = line.substring(sep + 1, line.len);
                    let raw_line_base = policy_generic_call_base(raw.clone());
                    let raw_line_short = mir_cpp_last_path_segment(raw_line_base);
                    if (raw == type_text
                        || raw_line_base == raw_base
                        || raw_line_short == raw_short
                        || policy_type_name_equal(raw, type_text)
                        || policy_type_name_equal(raw_line_base, raw_base)) {
                        return reflected;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return mir_cpp_type_name_from_source_text(type_text);
}

fn mir_cpp_reflection_name_for_type_id(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid()) { return ""; }
    return mir_cpp_reflection_name_for_type_text(m, mir_cpp_type_source_text(m, type_id));
}

fn mir_cpp_reflect_name_call_expr(m: MirUnit, value_id: i32, call_name: string) -> string {
    var type_text = policy_generic_arg_at(policy_generic_call_args(call_name.clone()), 0);
    if (type_text.len == 0) {
        type_text = policy_generic_arg_at(policy_generic_call_args(mir_cpp_value_source_text(m, value_id).clone()), 0);
    }
    if (type_text.len > 0) {
        let concrete = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), type_text);
        if (concrete.len > 0) { type_text = concrete; }
    }
    var reflected = "";
    if (type_text.len > 0) { reflected = mir_cpp_reflection_name_for_type_text(m, type_text); }
    if (reflected.len == 0) { reflected = mir_cpp_reflection_name_for_type_id(m, m.value_type(value_id)); }
    return "vyx::str_lit(" + mir_cpp_quote(reflected) + ")";
}

fn mir_cpp_typeof_expr(m: MirUnit, value_id: i32) -> string {
    var subject = m.value_first_arg(value_id);
    if (subject == mir_id_invalid()) { subject = m.value_lhs(value_id); }
    if (subject == mir_id_invalid()) { return "vyx::str_lit(\"unknown\")"; }
    return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(subject));
}

fn mir_cpp_array_length_text(m: MirUnit, type_id: i32) -> string {
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.startsWith("[") && text.endsWith("]")) {
        var semi: i32 = -1;
        var i: i32 = 1;
        while (i + 1 < text.len) {
            if (text.charAt(i) == 59) { semi = i; }
            i = i + 1;
        }
        if (semi > 1) { return mir_cpp_trim(text.substring(semi + 1, text.len - 1)); }
    }
    return "0";
}

fn mir_cpp_aggregate_expr(m: MirUnit, value_id: i32) -> string {
    let type_id = m.value_type(value_id);
    let kind = mir_cpp_type_kind(m, type_id);
    let ty = mir_cpp_type_text(m, type_id);
    if (kind == ty_CLASS() && ty == "void*") {
        let first = m.value_first_arg(value_id);
        if (first != mir_id_invalid()) { return mir_cpp_value_expr(m, first); }
        return "nullptr";
    }
    if (kind == ty_ARRAY() && m.value_aux(value_id) != mir_id_invalid()) {
        let elem_type = hir_type_table_elem(m.types, type_id);
        let elem_cpp = mir_cpp_type_text(m, elem_type);
        let len_text = mir_cpp_array_length_text(m, type_id);
        let elem_value = m.value_first_arg(value_id);
        return "vyx::array_repeat<" + elem_cpp + ", " + len_text + ">(" + mir_cpp_value_expr(m, elem_value) + ")";
    }
    if (kind == ty_CLASS()) {
        let field_count = m.field_count_for_type(type_id);
        if (field_count > 0) {
            var out = "([&]() { " + ty + " vyx_tmp{}; ";
            var cur = m.value_first_arg(value_id);
            var idx: i32 = 0;
            while (cur != mir_id_invalid()) {
                var field_id = m.value_aggregate_field(cur);
                if (field_id == mir_id_invalid()) { field_id = m.field_id_for_type_index(type_id, idx); }
                if (field_id != mir_id_invalid()) {
                    out = out + "vyx_tmp." + mir_cpp_ident(mir_cpp_field_source_name(m, field_id))
                        + " = " + mir_cpp_value_expr(m, cur) + "; ";
                }
                cur = m.value_next_arg(cur);
                idx = idx + 1;
            }
            return out + "return vyx_tmp; }())";
        }
        if (m.variant_count_for_type(type_id) > 0) {
            return ty + "{0, vyx::Any{}}";
        }
    }
    return ty + "{" + mir_cpp_arg_list(m, m.value_first_arg(value_id)) + "}";
}

fn mir_cpp_variant_owner_type(m: MirUnit, type_id: i32, variant_id: i32) -> i32 {
    if (variant_id != mir_id_invalid()) {
        let owner = m.variant_owner_type(variant_id);
        if (owner != mir_id_invalid()) { return owner; }
    }
    return type_id;
}

fn mir_cpp_variant_payload_max(m: MirUnit, type_id: i32) -> i32 {
    var max_payload: i32 = 0;
    var variant_id: i32 = 1;
    while (variant_id <= m.variant_count) {
        if (m.variant_owner_type(variant_id) == type_id) {
            let n = m.variant_payload_count(variant_id);
            if (n > max_payload) { max_payload = n; }
        }
        variant_id = variant_id + 1;
    }
    return max_payload;
}

fn mir_cpp_find_variant_by_owner_name(m: MirUnit, owner_type_id: i32, name: string) -> i32 {
    if (owner_type_id == mir_id_invalid() || name.len == 0) { return mir_id_invalid(); }
    var variant_id: i32 = 1;
    while (variant_id <= m.variant_count) {
        if (m.variant_owner_type(variant_id) == owner_type_id
            && m.variant_name(variant_id) == name) {
            return variant_id;
        }
        variant_id = variant_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_success_variant_id(m: MirUnit, type_id: i32) -> i32 {
    let ok_id = mir_cpp_find_variant_by_owner_name(m, type_id, "Ok");
    if (ok_id != mir_id_invalid()) { return ok_id; }
    return mir_cpp_find_variant_by_owner_name(m, type_id, "Some");
}

fn mir_cpp_failure_variant_id(m: MirUnit, type_id: i32) -> i32 {
    let err_id = mir_cpp_find_variant_by_owner_name(m, type_id, "Err");
    if (err_id != mir_id_invalid()) { return err_id; }
    return mir_cpp_find_variant_by_owner_name(m, type_id, "None");
}

fn mir_cpp_variant_payload_type_text_at(m: MirUnit, variant_id: i32, payload_index: i32) -> string {
    if (variant_id == mir_id_invalid()) { return "vyx::Any"; }
    let payloads = m.variant_payload_types(variant_id);
    let part = mir_cpp_top_level_csv_part(payloads, payload_index);
    if (part.len == 0) { return "vyx::Any"; }
    let exact = mir_cpp_type_text_from_source_in_unit(m, part);
    if (exact != "vyx::Any") { return exact; }
    let type_id = mir_cpp_find_type_by_source_or_tail(m, part);
    if (type_id != mir_id_invalid()) { return mir_cpp_type_text(m, type_id); }
    return exact;
}

fn mir_cpp_question_source_value(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
    if (m.value_kind(value_id) == mir_value_unary()
        && m.value_op(value_id) == tk_QUESTION()) {
        return m.value_lhs(value_id);
    }
    if (m.value_kind(value_id) == mir_value_cast()
        || m.value_kind(value_id) == mir_value_arg()) {
        return mir_cpp_question_source_value(m, m.value_lhs(value_id));
    }
    return mir_id_invalid();
}

fn mir_cpp_try_error_return_expr(m: MirUnit, source_type_id: i32, return_type_id: i32, temp_name: string) -> string {
    if (source_type_id == return_type_id
        || mir_cpp_type_text(m, source_type_id) == mir_cpp_type_text(m, return_type_id)) {
        return temp_name;
    }
    let fail_id = mir_cpp_failure_variant_id(m, return_type_id);
    if (fail_id == mir_id_invalid()) { return mir_cpp_default_expr(m, return_type_id); }
    if (m.variant_payload_count(fail_id) <= 0) {
        return mir_cpp_variant_construct_expr(m, return_type_id, fail_id, "", false);
    }
    let payload_ty = mir_cpp_variant_payload_type_text_at(m, fail_id, 0);
    var payload = "(" + temp_name + ").payload0";
    if (payload_ty != "vyx::Any") {
        payload = "vyx::any_cast_value<" + payload_ty + ">(" + payload + ")";
    }
    return mir_cpp_variant_construct_expr(m, return_type_id, fail_id, payload, true);
}

fn mir_cpp_try_success_expr(m: MirUnit, question_value: i32, return_or_target_type: i32, temp_name: string) -> string {
    let payload_ty = mir_cpp_type_text(m, m.value_type(question_value));
    var payload = "vyx::any_cast_value<" + payload_ty + ">((" + temp_name + ").payload0)";
    let target_ty = mir_cpp_type_text(m, return_or_target_type);
    if (payload_ty == target_ty) { return payload; }
    if (m.variant_count_for_type(return_or_target_type) > 0) {
        let ok_id = mir_cpp_success_variant_id(m, return_or_target_type);
        if (ok_id != mir_id_invalid()) {
            return mir_cpp_variant_construct_expr(m, return_or_target_type, ok_id, payload, true);
        }
    }
    return mir_cpp_value_expr_for_type_text(payload, payload_ty, target_ty);
}

fn mir_cpp_emit_try_guard(m: MirUnit,
                          source_type_id: i32,
                          return_type_id: i32,
                          temp_name: string) -> string {
    if (m.variant_count_for_type(source_type_id) <= 0
        || m.variant_count_for_type(return_type_id) <= 0) {
        return "";
    }
    let ok_id = mir_cpp_success_variant_id(m, source_type_id);
    if (ok_id == mir_id_invalid()) { return ""; }
    let ok_tag = m.variant_tag(ok_id);
    return "    if (vyx::tag(" + temp_name + ") != " + mir_cpp_i32(ok_tag) + ") { return "
        + mir_cpp_try_error_return_expr(m, source_type_id, return_type_id, temp_name) + "; }\n";
}

fn mir_cpp_value_expr_for_type_text(expr: string, source_ty: string, target_ty: string) -> string {
    if (target_ty == "bool") { return "vyx::truthy(" + expr + ")"; }
    if (source_ty == target_ty) { return expr; }
    if (target_ty == "vyx::Str") { return "vyx::to_string(" + expr + ")"; }
    if (target_ty == "void*") {
        if (mir_cpp_type_is_integer_text(source_ty)) {
            return "reinterpret_cast<void*>(static_cast<intptr_t>(" + expr + "))";
        }
        return "vyx::ptr(" + expr + ")";
    }
    if (mir_cpp_type_is_integer_text(target_ty) && source_ty == "void*") {
        return "static_cast<" + target_ty + ">(reinterpret_cast<intptr_t>(" + expr + "))";
    }
    return expr;
}

fn mir_cpp_variant_payload_value_expr(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()) { return "vyx::Any{}"; }
    if (m.value_kind(value_id) == mir_value_arg()
        && m.value_lhs(value_id) != mir_id_invalid()) {
        return mir_cpp_variant_payload_value_expr(m, m.value_lhs(value_id));
    }
    if (m.value_kind(value_id) == mir_value_cast()) {
        let src_value = m.value_lhs(value_id);
        let src_ty = mir_cpp_type_text(m, m.value_type(src_value));
        let dst_ty = mir_cpp_type_text(m, m.value_type(value_id));
        if (src_ty.startsWith("vyx_type_")
            && !dst_ty.startsWith("vyx_type_")
            && dst_ty != "vyx::Str"
            && dst_ty != "void*") {
            return mir_cpp_value_expr(m, src_value);
        }
    }
    return mir_cpp_value_expr(m, value_id);
}

fn mir_cpp_variant_construct_expr(m: MirUnit,
                                  type_id: i32,
                                  variant_id: i32,
                                  payload_expr: string,
                                  has_payload: bool) -> string {
    let ty = mir_cpp_type_text(m, type_id);
    var tag: i32 = 0;
    if (variant_id != mir_id_invalid()) { tag = m.variant_tag(variant_id); }
    let max_payload = mir_cpp_variant_payload_max(m, type_id);
    if (max_payload <= 0) { return ty + "{" + mir_cpp_i32(tag) + "}"; }
    var out = ty + "{" + mir_cpp_i32(tag);
    var idx: i32 = 0;
    while (idx < max_payload) {
        if (idx == 0 && has_payload) {
            out = out + ", vyx::Any(" + payload_expr + ")";
        } else {
            out = out + ", vyx::Any{}";
        }
        idx = idx + 1;
    }
    return out + "}";
}

fn mir_cpp_variant_expr(m: MirUnit, type_id: i32, variant_id: i32, first_arg: i32) -> string {
    let owner_type = mir_cpp_variant_owner_type(m, type_id, variant_id);
    let ty = mir_cpp_type_text(m, owner_type);
    var tag: i32 = 0;
    if (variant_id != mir_id_invalid()) { tag = m.variant_tag(variant_id); }
    var out = ty + "{" + mir_cpp_i32(tag);
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        out = out + ", vyx::Any(" + mir_cpp_variant_payload_value_expr(m, cur) + ")";
        cur = m.value_next_arg(cur);
    }
    return out + "}";
}

fn mir_cpp_variant_wrap_expr(m: MirUnit, type_id: i32, payload_expr: string) -> string {
    let ty = mir_cpp_type_text(m, type_id);
    let payload_count = mir_cpp_variant_payload_max(m, type_id);
    if (payload_count <= 0) { return ty + "{0}"; }
    var out = ty + "{0, vyx::Any(" + payload_expr + ")";
    var idx: i32 = 1;
    while (idx < payload_count) {
        out = out + ", vyx::Any{}";
        idx = idx + 1;
    }
    return out + "}";
}

fn mir_cpp_fail_variant_expr(m: MirUnit, value_id: i32) -> string {
    let result_type_id = m.value_type(value_id);
    if (m.variant_count_for_type(result_type_id) <= 0) { return ""; }
    let error_type_name = mir_cpp_value_source_name(m, value_id);
    let error_variant_name = mir_cpp_value_source_text(m, value_id);
    if (error_type_name.len == 0 || error_variant_name.len == 0) { return ""; }
    let error_type_id = mir_cpp_find_type_by_source_or_tail(m, error_type_name);
    if (error_type_id == mir_id_invalid()) { return ""; }
    let error_variant_id = mir_cpp_find_variant_by_owner_name(m, error_type_id, error_variant_name);
    if (error_variant_id == mir_id_invalid()) { return ""; }
    let result_err_id = mir_cpp_find_variant_by_owner_name(m, result_type_id, "Err");
    if (result_err_id == mir_id_invalid()) { return ""; }
    let payload = m.value_lhs(value_id);
    var error_expr = "";
    if (payload != mir_id_invalid()) {
        error_expr = mir_cpp_variant_construct_expr(m, error_type_id, error_variant_id,
                                                   mir_cpp_value_expr(m, payload), true);
    } else {
        error_expr = mir_cpp_variant_construct_expr(m, error_type_id, error_variant_id, "", false);
    }
    return mir_cpp_variant_construct_expr(m, result_type_id, result_err_id, error_expr, true);
}

fn mir_cpp_call_name(m: MirUnit, target_kind: i32, target_id: i32, name: string) -> string {
    if (target_kind == mir_target_function()) { return mir_cpp_function_name(m, target_id); }
    if (target_kind == mir_target_builtin()) { return mir_cpp_ident(name); }
    if (name.len > 0) { return mir_cpp_ident(name); }
    return "vyx_unknown_target_" + mir_cpp_i32(target_kind) + "_" + mir_cpp_i32(target_id);
}

fn mir_cpp_foreign_cpp_owner_type(m: MirUnit, function_id: i32) -> string {
    let owner = mir_unit_foreign_cpp_owner_type_text(&m,  function_id);
    if (owner.len == 0) { return ""; }
    return mir_cpp_foreign_cpp_type_text_from_source(m, owner);
}

fn mir_cpp_foreign_cpp_method_name(m: MirUnit, function_id: i32) -> string {
    let raw = mir_cpp_function_source_name(m, function_id);
    return policy_generic_call_base(raw.clone());
}

fn mir_cpp_foreign_cpp_method_call(m: MirUnit,
                                   function_id: i32,
                                   receiver: i32,
                                   first_arg: i32,
                                   args: string) -> string {
    let dci_args = mir_cpp_dci_call_args(m, function_id, first_arg);
    let dci_call = mir_cpp_dci_direct_call_expr(m, function_id, receiver, dci_args);
    if (dci_call.len > 0) { return mir_cpp_dci_return_expr(m, function_id, dci_call); }
    let method_name = mir_cpp_foreign_cpp_method_name(m, function_id);
    if (mir_unit_function_requires_dci_clang_stub(&m,  function_id)
        && receiver != mir_id_invalid()) {
        let dci_call = mir_cpp_dci_stub_method_call(m, function_id, receiver, args);
        if (dci_call.len > 0) { return dci_call; }
    }
    if (method_name == "operator[]") {
        if (receiver != mir_id_invalid()) {
            return mir_cpp_value_expr(m, receiver) + "[" + args + "]";
        }
    }
    if (receiver != mir_id_invalid()) {
        return mir_cpp_value_expr(m, receiver) + "." + mir_cpp_cpp_qualified_name(method_name) + "(" + args + ")";
    }
    let owner = mir_cpp_foreign_cpp_owner_type(m, function_id);
    if (owner.len > 0) {
        return owner + "::" + mir_cpp_cpp_qualified_name(method_name) + "(" + args + ")";
    }
    return mir_cpp_function_name(m, function_id) + "(" + args + ")";
}

fn mir_cpp_dci_function_has_receiver(m: MirUnit, function_id: i32) -> bool {
    return mir_unit_function_is_foreign_dci_ctor(&m,  function_id)
        || mir_unit_function_is_foreign_dci_instance_method(&m,  function_id);
}

fn mir_cpp_dci_constructor_abi_return_type(m: MirUnit, function_id: i32) -> string {
    let result = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "return");
    let type_object = mir_cpp_dci_json_item(result, "type");
    let name = mir_cpp_dci_json_string(type_object, "name");
    let reference = mir_cpp_dci_json_string(type_object, "reference");
    if (name == "void") { return "void"; }
    if (reference == "pointer" || reference == "pointer_const" || reference == "pointer_mut") {
        return "void*";
    }
    return "";
}

fn mir_cpp_dci_lowering_passing(lowering: rawptr) -> string {
    if (lowering == null || cJSON_IsObject(lowering) == 0) { return ""; }
    return mir_cpp_dci_json_string(lowering, "passing");
}

// MIR keeps Vyx pointers/references as two-word handles.  Direct DCI calls
// expose only the address word to the native C/C++ ABI, exactly like the LLVM
// lowerer.  All DCI C++ declaration/call/return paths consult this predicate.
fn mir_cpp_dci_direct_handle_uses_raw_pointer_abi(m: MirUnit,
                                                  type_id: i32,
                                                  lowering: rawptr) -> bool {
    if (mir_cpp_dci_lowering_passing(lowering) != "direct"
        || type_id == mir_id_invalid()
        || type_id <= 0
        || type_id > m.types.count) {
        return false;
    }
    let kind = mir_cpp_type_kind(m, type_id);
    if (!mir_backend_kind_pointer_handle(kind)) {
        return false;
    }
    // DCI 1.x permits the ABI lowering object to omit its redundant type
    // member. The selected symbol's source contract has already been matched
    // against this MIR type, so the semantic handle kind decides the physical
    // pointer ABI here as it does in the LLVM path.
    return true;
}

fn mir_cpp_dci_coerce_cpp_type(lowering: rawptr) -> string {
    if (mir_cpp_dci_lowering_passing(lowering) != "coerce") { return ""; }
    let coerce_to = mir_cpp_dci_json_item(lowering, "coerce_to");
    if (coerce_to == null || cJSON_IsObject(coerce_to) == 0) { return ""; }
    let reference = mir_cpp_dci_json_string(coerce_to, "reference");
    if (reference.len > 0 && reference != "value") { return ""; }
    let name = mir_cpp_dci_json_string(coerce_to, "name");
    if (name == "i8") { return "int8_t"; }
    if (name == "u8") { return "uint8_t"; }
    if (name == "bool") { return "bool"; }
    if (name == "i16") { return "int16_t"; }
    if (name == "u16") { return "uint16_t"; }
    if (name == "i32") { return "int32_t"; }
    if (name == "u32") { return "uint32_t"; }
    if (name == "i64") { return "int64_t"; }
    if (name == "u64") { return "uint64_t"; }
    if (name == "isize") { return "std::intptr_t"; }
    if (name == "usize") { return "std::uintptr_t"; }
    if (name == "ptr" || name == "rawptr" || name == "pointer") { return "void*"; }
    // A 16-byte, two-INTEGER-eightbyte aggregate (e.g. a {ptr,size} view) is
    // passed on x86_64 SysV exactly like an unsigned __int128: two consecutive
    // general-purpose registers. The DCI adapter only emits this coercion after
    // the selected compiler's machine-signature probe proves the aggregate is
    // trivially-copyable with both eightbytes INTEGER-classified.
    if (name == "i128") { return "__int128"; }
    if (name == "u128") { return "unsigned __int128"; }
    return "";
}

fn mir_cpp_dci_coerce_cpp_size(lowering: rawptr) -> i64 {
    let coerce_to = mir_cpp_dci_json_item(lowering, "coerce_to");
    let name = mir_cpp_dci_json_string(coerce_to, "name");
    if (name == "i8" || name == "u8" || name == "bool") { return 1; }
    if (name == "i16" || name == "u16") { return 2; }
    if (name == "i32" || name == "u32") { return 4; }
    if (name == "i64" || name == "u64" || name == "isize" || name == "usize"
        || name == "ptr" || name == "rawptr" || name == "pointer") {
        return 8;
    }
    if (name == "i128" || name == "u128") { return 16; }
    return 0;
}

fn mir_cpp_dci_coerce_supported(m: MirUnit, lowering: rawptr, semantic_type: i32) -> bool {
    if (mir_cpp_dci_lowering_passing(lowering) != "coerce"
        || !mir_cpp_dci_json_array_is_empty(lowering, "attributes")
        || !mir_cpp_dci_json_array_is_empty(lowering, "registers")
        || mir_cpp_dci_coerce_cpp_type(lowering).len == 0
        || !mir_cpp_dci_type_object_matches(m, mir_cpp_dci_json_item(lowering, "type"), semantic_type)) {
        return false;
    }
    if (mir_cpp_dci_json_item(lowering, "size") == null
        || mir_cpp_dci_json_item(lowering, "alignment") == null
        || !mir_cpp_dci_json_integer_valid(lowering, "size")
        || !mir_cpp_dci_json_integer_valid(lowering, "alignment")) {
        return false;
    }
    let size = mir_cpp_dci_json_exact_i64(lowering, "size", -1);
    let alignment = mir_cpp_dci_json_exact_i64(lowering, "alignment", -1);
    let semantic_size = mir_cpp_lower_type_size_for_type(m, semantic_type, 0);
    let semantic_alignment = mir_cpp_lower_type_align_for_type(m, semantic_type, 0);
    if (size <= 0 || size != mir_cpp_dci_coerce_cpp_size(lowering)
        || size != semantic_size || alignment <= 0
        || !mir_cpp_dci_power_of_two(alignment)
        || semantic_alignment <= 0 || alignment > semantic_alignment) {
        return false;
    }
    if (mir_cpp_type_kind(m, semantic_type) == ty_CLASS()
        && mir_unit_type_is_foreign_dci(&m,  semantic_type)) {
        let layout = mir_cpp_dci_layout_for_type(m, semantic_type);
        let traits = mir_cpp_dci_json_item(layout, "traits");
        if (traits == null || cJSON_IsObject(traits) == 0
            || !mir_cpp_dci_json_bool(traits, "trivially_copyable")) {
            return false;
        }
    }
    return true;
}

fn mir_cpp_dci_alias_return_type(m: MirUnit, function_id: i32) -> string {
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) {
        return mir_cpp_dci_constructor_abi_return_type(m, function_id);
    }
    if (mir_unit_function_is_foreign_dci_dtor(&m,  function_id)) { return "void"; }
    let result = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "return");
    if (mir_cpp_dci_lowering_passing(result) == "coerce") {
        return mir_cpp_dci_coerce_cpp_type(result);
    }
    if (mir_cpp_dci_direct_handle_uses_raw_pointer_abi(
            m, m.function_return_type(function_id), result)) {
        return "void*";
    }
    return mir_cpp_type_text(m, m.function_return_type(function_id));
}

fn mir_cpp_dci_alias_params(m: MirUnit, function_id: i32) -> string {
    var out = "";
    var first = true;
    if (mir_cpp_dci_function_has_receiver(m, function_id)) {
        out = "void* vyx_dci_self";
        first = false;
    }
    let receiver_count = mir_cpp_dci_receiver_param_count(m, function_id);
    var index = receiver_count;
    let count = mir_unit_function_param_count(&m,  function_id);
    while (index < count) {
        let local = mir_unit_function_param_local_at(&m,  function_id, index);
        if (local != mir_id_invalid()) {
            if (!first) { out = out + ", "; }
            var param_type = mir_cpp_type_text(m, m.local_type(local));
            let lowering = mir_cpp_dci_parameter_lowering(
                m, function_id, index - receiver_count);
            if (mir_cpp_dci_lowering_passing(lowering) == "coerce") {
                param_type = mir_cpp_dci_coerce_cpp_type(lowering);
            } else if (mir_cpp_dci_direct_handle_uses_raw_pointer_abi(
                           m, m.local_type(local), lowering)) {
                param_type = "void*";
            }
            out = out + param_type
                + " vyx_dci_arg_" + mir_cpp_i32(index - receiver_count);
            first = false;
        }
        index = index + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_direct_declarations(m: MirUnit) -> string {
    if (!mir_unit_has_dci_abi(&m)) { return ""; }
    var out = "#if defined(__clang__) || defined(__GNUC__)\n";
    var count: i32 = 0;
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_unit_function_is_foreign_dci(&m,  function_id)) {
            let link_name = mir_cpp_dci_link_name(m, function_id);
            if (link_name.len > 0) {
                out = out + "extern \"C\" " + mir_cpp_dci_alias_return_type(m, function_id)
                    + " " + mir_cpp_dci_alias_name(function_id)
                    + "(" + mir_cpp_dci_alias_params(m, function_id) + ") noexcept __asm__("
                    + mir_cpp_quote(link_name) + ");\n";
                count = count + 1;
            }
        }
        function_id = function_id + 1;
    }
    out = out + "#else\n#error \"MIR2CPP DCI direct calls require compiler asm-label support\"\n#endif\n\n";
    if (count == 0) { return ""; }
    return out;
}

fn mir_cpp_dci_receiver_bytes_expr(m: MirUnit, receiver: i32) -> string {
    if (receiver == mir_id_invalid()) { return ""; }
    if (mir_cpp_value_type_is_pointer_like(m, receiver)) {
        return "reinterpret_cast<unsigned char*>(to_rawptr("
            + mir_cpp_value_expr(m, receiver) + "))";
    }
    return "reinterpret_cast<unsigned char*>(&(" + mir_cpp_value_expr(m, receiver) + "))";
}

fn mir_cpp_dci_record_name_for_type(m: MirUnit, type_id_raw: i32) -> string {
    var type_id = type_id_raw;
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return ""; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        type_id = hir_type_table_elem(m.types, type_id);
    }
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return ""; }
    return mir_cpp_type_source_text(m, type_id);
}

fn mir_cpp_dci_receiver_pointer_expr(m: MirUnit,
                                     function_id: i32,
                                     receiver: i32) -> string {
    var bytes = mir_cpp_dci_receiver_bytes_expr(m, receiver);
    if (bytes.len == 0) { return ""; }
    var receiver_name = mir_cpp_dci_record_name_for_type(m, m.value_type(receiver));
    if (mir_cpp_type_is_dci_stub_class(m, m.value_type(receiver))) {
        receiver_name = mir_cpp_dci_stub_direct_foreign_base(m, m.value_type(receiver));
    }
    let owner_name = mir_unit_foreign_dci_owner_type_text(&m,  function_id);
    let base_adjust = mir_cpp_dci_unique_base_offset(m, receiver_name, owner_name);
    let symbol = mir_cpp_dci_symbol_for_function(m, function_id);
    if (base_adjust < 0 || !mir_cpp_dci_json_integer_valid(symbol, "this_adjust")) { return ""; }
    let adjust = base_adjust + mir_cpp_dci_json_exact_i64(symbol, "this_adjust", 0);
    if (adjust != 0) { bytes = "(" + bytes + " + " + policy_i64_to_string(adjust) + ")"; }
    return "reinterpret_cast<void*>(" + bytes + ")";
}

fn mir_cpp_dci_function_uses_virtual_dispatch(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid()
        || !mir_unit_function_is_foreign_dci_instance_method(&m,  function_id)
        || mir_unit_function_is_foreign_dci_dtor(&m,  function_id)
        || mir_unit_function_is_foreign_dci_final_method(&m,  function_id)) {
        return false;
    }
    return mir_unit_function_is_foreign_dci_virtual_method(&m,  function_id)
        || mir_unit_function_is_foreign_dci_override_method(&m,  function_id);
}

fn mir_cpp_dci_receiver_record_name(m: MirUnit, receiver: i32) -> string {
    if (receiver == mir_id_invalid() || receiver <= 0 || receiver > m.value_count) { return ""; }
    return mir_cpp_dci_record_name_for_type(m, m.value_type(receiver));
}

fn mir_cpp_dci_call_receiver_is_exact_value_object(m: MirUnit,
                                                    receiver: i32,
                                                    function_id: i32) -> bool {
    if (receiver == mir_id_invalid() || receiver <= 0 || receiver > m.value_count) { return false; }
    let type_id = m.value_type(receiver);
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return false; }
    return mir_cpp_dci_contract_type_names_match(
        mir_cpp_type_source_text(m, type_id),
        mir_unit_foreign_dci_owner_type_text(&m,  function_id));
}

fn mir_cpp_dci_dispatch_tables_from(root: rawptr) -> rawptr {
    let tables = mir_cpp_dci_exports_array_from(root, "dispatch_tables");
    if (tables != null && cJSON_GetArraySize(tables) > 0) { return tables; }
    return mir_cpp_dci_exports_array_from(root, "vtables");
}

fn mir_cpp_dci_dispatch_tables(m: MirUnit) -> rawptr {
    return mir_cpp_dci_dispatch_tables_from(mir_cpp_dci_root(m));
}

fn mir_cpp_dci_dispatch_entry_link_name(entry: rawptr) -> string {
    var out = mir_cpp_dci_json_string(entry, "link_name");
    if (out.len == 0) { out = mir_cpp_dci_json_string(entry, "mangled"); }
    return out;
}

fn mir_cpp_dci_dispatch_entry_for_function(m: MirUnit,
                                           table: rawptr,
                                           function_id: i32) -> rawptr {
    if (table == null || cJSON_IsObject(table) == 0) { return null; }
    let link_name = mir_cpp_dci_link_name(m, function_id);
    if (link_name.len == 0) { return null; }
    let entries = mir_cpp_dci_json_item(table, "entries");
    if (entries == null || cJSON_IsArray(entries) == 0) { return null; }
    var entry_i: i32 = 0;
    while (entry_i < cJSON_GetArraySize(entries)) {
        let entry = cJSON_GetArrayItem(entries, entry_i);
        if (mir_cpp_dci_dispatch_entry_link_name(entry) == link_name) { return entry; }
        entry_i = entry_i + 1;
    }
    return null;
}

fn mir_cpp_dci_dispatch_table_for_function(m: MirUnit, function_id: i32) -> rawptr {
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let tables = mir_cpp_dci_dispatch_tables_from(mir_cpp_dci_contract_at(m, root_i));
        if (tables != null) {
            var table_i: i32 = 0;
            while (table_i < cJSON_GetArraySize(tables)) {
                let table = cJSON_GetArrayItem(tables, table_i);
                if (mir_cpp_dci_dispatch_entry_for_function(m, table, function_id) != null) {
                    return table;
                }
                table_i = table_i + 1;
            }
        }
        root_i = root_i + 1;
    }
    return null;
}

fn mir_cpp_dci_virtual_slot_offset(m: MirUnit, function_id: i32) -> i64 {
    let table = mir_cpp_dci_dispatch_table_for_function(m, function_id);
    let entry = mir_cpp_dci_dispatch_entry_for_function(m, table, function_id);
    if (table == null || entry == null
        || !mir_cpp_dci_json_integer_valid(entry, "this_adjust")
        || !mir_cpp_dci_json_integer_valid(entry, "return_adjust")
        || mir_cpp_dci_json_exact_i64(entry, "this_adjust", 0) != 0
        || mir_cpp_dci_json_exact_i64(entry, "return_adjust", 0) != 0) {
        return -1;
    }
    let relative = mir_cpp_dci_json_item(entry, "address_point_relative_offset");
    if (relative != null) {
        if (cJSON_IsNumber(relative) == 0) { return -1; }
        return mir_cpp_dci_json_exact_i64(entry, "address_point_relative_offset", -1);
    }
    let offset = mir_cpp_dci_json_exact_i64(entry, "offset", -1);
    let address_point = mir_cpp_dci_json_exact_i64(table, "address_point_offset", -1);
    if (offset < 0 || address_point < 0) { return -1; }
    return offset - address_point;
}

fn mir_cpp_dci_virtual_receiver_supported(m: MirUnit,
                                          function_id: i32,
                                          receiver: i32) -> bool {
    let table = mir_cpp_dci_dispatch_table_for_function(m, function_id);
    if (table == null || mir_cpp_dci_virtual_slot_offset(m, function_id) < 0) { return false; }
    var receiver_name = mir_cpp_dci_receiver_record_name(m, receiver);
    if (mir_cpp_type_is_dci_stub_class(m, m.value_type(receiver))) {
        receiver_name = mir_cpp_dci_stub_direct_foreign_base(m, m.value_type(receiver));
    }
    if (receiver_name.len == 0) { return false; }
    let base_name = mir_cpp_dci_json_string(table, "base_class");
    if (base_name.len > 0) {
        return mir_cpp_dci_contract_type_names_match(receiver_name, base_name);
    }
    return mir_cpp_dci_contract_type_names_match(
        receiver_name,
        mir_cpp_dci_json_string(table, "class_name"));
}

fn mir_cpp_dci_virtual_call_expr(m: MirUnit,
                                 function_id: i32,
                                 receiver: i32,
                                 args: string) -> string {
    if (!mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)
        || mir_cpp_dci_call_receiver_is_exact_value_object(m, receiver, function_id)
        || !mir_cpp_dci_virtual_receiver_supported(m, function_id, receiver)) {
        return "";
    }
    let receiver_bytes = mir_cpp_dci_receiver_bytes_expr(m, receiver);
    let slot_offset = mir_cpp_dci_virtual_slot_offset(m, function_id);
    let return_type = mir_cpp_dci_alias_return_type(m, function_id);
    if (receiver_bytes.len == 0 || slot_offset < 0 || return_type.len == 0) { return ""; }
    var out = "([&]()";
    if (return_type != "void") { out = out + " -> " + return_type; }
    out = out + " { auto* vyx_dci_this = " + receiver_bytes + "; ";
    out = out + "auto vyx_dci_vtable = *reinterpret_cast<void***>(vyx_dci_this); ";
    out = out + "auto vyx_dci_virtual = reinterpret_cast<decltype(&"
        + mir_cpp_dci_alias_name(function_id)
        + ")>(*reinterpret_cast<void**>(reinterpret_cast<unsigned char*>(vyx_dci_vtable) + "
        + policy_i64_to_string(slot_offset) + ")); ";
    if (return_type != "void") { out = out + "return "; }
    out = out + "vyx_dci_virtual(reinterpret_cast<void*>(vyx_dci_this)";
    if (args.len > 0) { out = out + ", " + args; }
    return out + "); }())";
}

fn mir_cpp_dci_place_receiver_pointer_expr(m: MirUnit,
                                           function_id: i32,
                                           place_id: i32) -> string {
    if (place_id == mir_id_invalid()) { return ""; }
    let place_type = m.place_type(place_id);
    var bytes = "reinterpret_cast<unsigned char*>(&(" + mir_cpp_place_expr(m, place_id) + "))";
    var receiver_name = mir_cpp_dci_record_name_for_type(m, place_type);
    if (mir_cpp_type_is_dci_stub_class(m, place_type)) {
        bytes = "reinterpret_cast<unsigned char*>(" + mir_cpp_place_expr(m, place_id) + ")";
        receiver_name = mir_cpp_dci_stub_direct_foreign_base(m, place_type);
    }
    let owner_name = mir_unit_foreign_dci_owner_type_text(&m,  function_id);
    let base_adjust = mir_cpp_dci_unique_base_offset(m, receiver_name, owner_name);
    let symbol = mir_cpp_dci_symbol_for_function(m, function_id);
    if (base_adjust < 0 || !mir_cpp_dci_json_integer_valid(symbol, "this_adjust")) { return ""; }
    let adjust = base_adjust + mir_cpp_dci_json_exact_i64(symbol, "this_adjust", 0);
    if (adjust != 0) { bytes = "(" + bytes + " + " + policy_i64_to_string(adjust) + ")"; }
    return "reinterpret_cast<void*>(" + bytes + ")";
}

fn mir_cpp_dci_ctor_expr(m: MirUnit, function_id: i32, args: string) -> string {
    let owner_type = mir_unit_foreign_dci_owner_type_id(&m,  function_id);
    if (owner_type == mir_id_invalid()) { return ""; }
    let ty = mir_cpp_type_text(m, owner_type);
    var call_args = "reinterpret_cast<void*>(&vyx_dci_value)";
    if (args.len > 0) { call_args = call_args + ", " + args; }
    return "([&]() { " + ty + " vyx_dci_value{}; "
        + mir_cpp_dci_alias_name(function_id) + "(" + call_args
        + "); return vyx_dci_value; }())";
}

fn mir_cpp_dci_coerce_pack_expr(m: MirUnit,
                                semantic_type: i32,
                                value_expr: string,
                                lowering: rawptr) -> string {
    if (!mir_cpp_dci_coerce_supported(m, lowering, semantic_type)) { return ""; }
    let physical_type = mir_cpp_dci_coerce_cpp_type(lowering);
    return "([&]() -> " + physical_type + " { " + physical_type
        + " vyx_dci_bits{}; const auto& vyx_dci_source = (" + value_expr
        + "); static_assert(sizeof(vyx_dci_bits) == sizeof(vyx_dci_source)); "
        + "std::memcpy(&vyx_dci_bits, &vyx_dci_source, sizeof(vyx_dci_bits)); "
        + "return vyx_dci_bits; }())";
}

fn mir_cpp_dci_call_args(m: MirUnit, function_id: i32, first_arg: i32) -> string {
    var out = "";
    var current = first_arg;
    var source_index: i32 = 0;
    let receiver_count = mir_cpp_dci_receiver_param_count(m, function_id);
    while (current != mir_id_invalid()) {
        if (out.len > 0) { out = out + ", "; }
        var argument = mir_cpp_value_expr(m, current);
        let lowering = mir_cpp_dci_parameter_lowering(m, function_id, source_index);
        let semantic_type = mir_unit_function_param_type_at(&m,  function_id, source_index + receiver_count);
        if (mir_cpp_dci_lowering_passing(lowering) == "coerce") {
            argument = mir_cpp_dci_coerce_pack_expr(
                m, semantic_type, argument, lowering);
        } else if (mir_cpp_dci_direct_handle_uses_raw_pointer_abi(
                       m, semantic_type, lowering)) {
            argument = "to_rawptr(" + argument + ")";
        }
        out = out + argument;
        current = m.value_next_arg(current);
        source_index = source_index + 1;
    }
    return out;
}

fn mir_cpp_dci_return_expr(m: MirUnit, function_id: i32, call_expr: string) -> string {
    let lowering = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "return");
    let semantic_type_id = m.function_return_type(function_id);
    if (mir_cpp_dci_direct_handle_uses_raw_pointer_abi(
            m, semantic_type_id, lowering)) {
        let element_type_id = hir_type_table_elem(m.types, semantic_type_id);
        if (element_type_id == mir_id_invalid()) { return ""; }
        if (mir_unit_type_is_foreign_dci(&m,  element_type_id)
            || mir_cpp_type_is_dci_stub_class(m, element_type_id)) {
            return "vyx::ptr_from_foreign<" + mir_cpp_type_text(m, element_type_id)
                + ">(" + call_expr + ")";
        }
        return "vyx::ptr_from_raw<" + mir_cpp_type_text(m, element_type_id)
            + ">(" + call_expr + ")";
    }
    if (mir_cpp_dci_lowering_passing(lowering) != "coerce") { return call_expr; }
    if (!mir_cpp_dci_coerce_supported(m, lowering, semantic_type_id)) { return ""; }
    let semantic_type = mir_cpp_type_text(m, semantic_type_id);
    let physical_type = mir_cpp_dci_coerce_cpp_type(lowering);
    return "([&]() -> " + semantic_type + " { " + physical_type
        + " vyx_dci_bits = " + call_expr + "; " + semantic_type
        + " vyx_dci_value{}; static_assert(sizeof(vyx_dci_value) == sizeof(vyx_dci_bits)); "
        + "std::memcpy(&vyx_dci_value, &vyx_dci_bits, sizeof(vyx_dci_value)); "
        + "return vyx_dci_value; }())";
}

fn mir_cpp_dci_direct_call_expr(m: MirUnit,
                                function_id: i32,
                                receiver: i32,
                                args: string) -> string {
    if (!mir_unit_function_is_foreign_dci(&m,  function_id)
        || mir_cpp_dci_link_name(m, function_id).len == 0) {
        return "";
    }
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) {
        return mir_cpp_dci_ctor_expr(m, function_id, args);
    }
    if (mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)
        && !mir_cpp_dci_call_receiver_is_exact_value_object(m, receiver, function_id)) {
        return mir_cpp_dci_virtual_call_expr(m, function_id, receiver, args);
    }
    var call_args = "";
    if (mir_cpp_dci_function_has_receiver(m, function_id)) {
        call_args = mir_cpp_dci_receiver_pointer_expr(m, function_id, receiver);
        if (call_args.len == 0) { return ""; }
    }
    if (args.len > 0) {
        if (call_args.len > 0) { call_args = call_args + ", "; }
        call_args = call_args + args;
    }
    return mir_cpp_dci_alias_name(function_id) + "(" + call_args + ")";
}

fn mir_cpp_symbol_type_text(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return "unknown"; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text.len == 0) { return "unknown"; }
    return text;
}

fn mir_cpp_function_symbol_signature_suffix(m: MirUnit, function_id: i32) -> string {
    var out = "_R_" + policy_mangle_part(mir_cpp_symbol_type_text(m, m.function_return_type(function_id)));
    out = out.clone() + "_P";
    let n = mir_unit_function_param_count(&m,  function_id);
    if (n <= 0) { return out.clone() + "_0"; }
    var idx: i32 = 0;
    while (idx < n) {
        let local_id = mir_unit_function_param_local_at(&m,  function_id, idx);
        var type_id = mir_id_invalid();
        if (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count) {
            type_id = m.local_type(local_id);
        }
        out = out.clone() + "_" + policy_mangle_part(mir_cpp_symbol_type_text(m, type_id));
        idx = idx + 1;
    }
    return out;
}

fn mir_cpp_dci_clang_stub_symbol_name(m: MirUnit, function_id: i32) -> string {
    if (function_id == mir_id_invalid()) { return ""; }
    var owner = mir_unit_foreign_cpp_owner_type_text(&m,  function_id);
    if (owner.len == 0) { owner = "free"; }
    let method = policy_generic_call_base(mir_cpp_function_source_name(m, function_id).clone());
    return "__dci_stub_"
        + policy_mangle_part(owner)
        + "_"
        + policy_mangle_part(method)
        + mir_cpp_function_symbol_signature_suffix(m, function_id);
}

fn mir_cpp_value_type_is_pointer_like(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    let type_id = m.value_type(value_id);
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (mir_cpp_type_is_dci_stub_class(m, type_id)) { return true; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return true; }
    return mir_cpp_type_source_is_pointer_like(mir_cpp_type_source_text(m, type_id));
}

fn mir_cpp_dci_stub_receiver_expr(m: MirUnit, owner: string, receiver: i32) -> string {
    if (receiver == mir_id_invalid()) { return "nullptr"; }
    let receiver_expr = mir_cpp_value_expr(m, receiver);
    if (mir_cpp_value_type_is_pointer_like(m, receiver)) {
        return "reinterpret_cast<" + owner + "*>(" + receiver_expr + ")";
    }
    return "&(" + receiver_expr + ")";
}

fn mir_cpp_dci_stub_method_call(m: MirUnit, function_id: i32, receiver: i32, args: string) -> string {
    let owner = mir_cpp_foreign_cpp_owner_type(m, function_id);
    let symbol = mir_cpp_dci_clang_stub_symbol_name(m, function_id);
    if (owner.len == 0 || symbol.len == 0) { return ""; }
    var out = symbol + "(" + mir_cpp_dci_stub_receiver_expr(m, owner, receiver);
    if (args.len > 0) { out = out + ", " + args; }
    return out + ")";
}

fn mir_cpp_dci_stub_spec_field(line: string, wanted: i32) -> string {
    var start: i32 = 0;
    var field: i32 = 0;
    var i: i32 = 0;
    while (i <= line.len) {
        var split = false;
        if (i == line.len) { split = true; }
        else if (line.charAt(i) == 9) { split = true; }
        if (split) {
            if (field == wanted) { return line.substring(start, i).trim(); }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn mir_cpp_dci_type_args_part(name: string) -> string {
    var start: i32 = -1;
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        let ch = name.charAt(i);
        if (ch == 60) {
            if (depth == 0) { start = i; }
            depth = depth + 1;
        } else if (ch == 62 && depth > 0) {
            depth = depth - 1;
            if (depth == 0 && start >= 0) { return name.substring(start, i + 1); }
        }
        i = i + 1;
    }
    return "";
}

// Canonical spelling of a type name **including its arguments**.  This is the
// one that must be used when two closed instances of the same generic have to
// stay apart: `VyxHostTG<i32>` and `VyxHostTG<i64>` are different types, with
// different vtables and different override thunks.
//
// The old form stripped everything from `<` on (`policy_generic_call_base`), so
// every instance of one generic Vyx stub class collapsed onto one head -- and
// each spec row then emitted *all* instances' overrides into a single `impl`,
// which is what `duplicate definitions with name 'consume'` looks like from
// rustc.  Turbofish `<::` normalises to `<` exactly like
// `dci_canonical_type_name_text` does on the LLVM side.
fn mir_cpp_dci_type_name_canonical(name: string) -> string {
    return name.trim()
        .replace("::", ".")
        .replace(".<", "<")
        .replace("class ", "")
        .replace("struct ", "")
        .replace("enum ", "")
        .replace(" <", "<")
        .replace("< ", "<")
        .replace(" >", ">")
        .replace("> ", ">")
        .replace(" ,", ",")
        .replace(", ", ",");
}

fn mir_cpp_dci_type_names_match(a: string, b: string) -> bool {
    let canonical_a = mir_cpp_dci_type_name_canonical(a);
    let canonical_b = mir_cpp_dci_type_name_canonical(b);
    if (canonical_a == canonical_b) { return true; }
    // Different arguments are a different type, never a spelling difference.
    if (mir_cpp_dci_type_args_part(canonical_a)
        != mir_cpp_dci_type_args_part(canonical_b)) { return false; }
    if (canonical_a.contains(".") && canonical_b.contains(".")) { return false; }
    let al = mir_cpp_last_path_segment(canonical_a);
    let bl = mir_cpp_last_path_segment(canonical_b);
    return al.len > 0 && bl.len > 0 && al == bl;
}

fn mir_cpp_dci_stub_base_for(m: MirUnit, derived: string) -> string {
    let rows = mir_unit_dci_stub_specs(&m);
    let canonical_derived = mir_cpp_dci_type_name_canonical(derived);
    var exact_base = "";
    var exact_count: i32 = 0;
    var fallback_base = "";
    var fallback_count: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") {
                let d = mir_cpp_dci_stub_spec_field(line, 1);
                let base = mir_cpp_dci_stub_spec_field(line, 2);
                if (mir_cpp_dci_type_name_canonical(d) == canonical_derived) {
                    exact_base = base;
                    exact_count = exact_count + 1;
                } else if (mir_cpp_dci_type_names_match(d, derived)) {
                    fallback_base = base;
                    fallback_count = fallback_count + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (exact_count == 1) { return exact_base; }
    if (exact_count == 0 && fallback_count == 1) { return fallback_base; }
    return "";
}

fn mir_cpp_dci_stub_class_name(type_name: string) -> string {
    return "__dci_vyx_stub_" + policy_mangle_part(type_name);
}

fn mir_cpp_dci_stub_factory_symbol(type_name: string) -> string {
    return "__dci_stub_factory_" + policy_mangle_part(type_name);
}

fn mir_cpp_dci_stub_destroy_symbol(type_name: string) -> string {
    return "__dci_stub_destroy_" + policy_mangle_part(type_name);
}

fn mir_cpp_dci_stub_cpp_base_name(m: MirUnit, base_name: string) -> string {
    if (base_name.len == 0) { return ""; }
    if (mir_cpp_dci_layout_is_rust(m, base_name)) { return ""; }
    if (mir_cpp_dci_stub_base_for(m, base_name).len > 0) {
        return mir_cpp_dci_stub_class_name(base_name);
    }
    // A closed generic base carries type arguments spelled the consumer way
    // ("SinkG<VyxBox>").  The stub TU is compiled against the producer's
    // headers, so a record argument must be spelled as the real C++ type
    // declared there (see mir_cpp_dci_stub_cpp_type_text) -- the internal
    // vyx_type_* blob name would not even parse.
    if (policy_generic_call_has_args(base_name.clone()) != 0) {
        let base = policy_generic_call_base(base_name.clone());
        let raw_args = policy_generic_call_args(base_name.clone());
        var out = mir_cpp_cpp_qualified_name(base) + "<";
        var first = true;
        var idx: i32 = 0;
        while (idx < 64) {
            let part = policy_generic_arg_at(raw_args.clone(), idx);
            if (part.len == 0) { break; }
            if (!first) { out = out + ", "; }
            let known = mir_cpp_find_type_by_source_text(m, part);
            if (known != mir_id_invalid() && mir_cpp_type_kind(m, known) == ty_CLASS()) {
                out = out + mir_cpp_foreign_cpp_type_text_from_source(m, part);
            } else {
                out = out + mir_cpp_type_text_from_source_in_unit(m, part);
            }
            first = false;
            idx = idx + 1;
        }
        return out + ">";
    }
    return mir_cpp_foreign_cpp_type_text_from_source(m, base_name);
}

fn mir_cpp_function_is_dci_vyx_override(m: MirUnit, function_id: i32, owner: string) -> bool {
    if (function_id == mir_id_invalid() || owner.len == 0) { return false; }
    if (mir_unit_function_is_foreign_cpp(&m,  function_id)) { return false; }
    if ((m.function_flags( function_id) & hir_function_flag_foreign_cpp_override_method()) == 0) {
        return false;
    }
    if (!mir_cpp_dci_type_names_match(m.function_owner_type(function_id), owner)) { return false; }
    // Read the `method` segment: a closed generic instance member is registered
    // under a mangled item name, so the raw identifier never equals
    // `constructor`/`drop` and the filters below would silently never fire.
    let name = mir_cpp_function_method_name(m, function_id);
    if (name == "constructor" || name == "drop") { return false; }
    return true;
}

fn mir_cpp_function_is_dci_vyx_override_callback(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid()) { return false; }
    let owner = m.function_owner_type(function_id);
    return owner.len > 0 && mir_cpp_function_is_dci_vyx_override(m, function_id, owner);
}

fn mir_cpp_vyx_llvm_symbol_name(m: MirUnit, function_id: i32) -> string {
    if (function_id == mir_id_invalid()) { return ""; }
    let name = mir_cpp_function_source_name(m, function_id);
    if (name.len == 0) { return ""; }
    var owner = m.function_owner_type(function_id);
    if (owner.len == 0) {
        let first = mir_cpp_function_param_local_at(m, function_id, 0);
        if (first != mir_id_invalid()
            && (m.local_flags(first) & mir_local_flag_self_receiver()) != 0) {
            owner = mir_cpp_symbol_type_text(m, m.local_type(first));
        }
    }
    var out = "__vyx";
    if (owner.len > 0) {
        out = out.clone() + "_M_" + policy_mangle_part(owner)
                  + "_N_" + policy_mangle_part(name);
    } else {
        out = out.clone() + "_F_" + policy_mangle_part(name);
    }
    let discriminator = m.function_symbol_discriminator( function_id);
    if (discriminator.len > 0) {
        out = out.clone() + "_V_" + policy_mangle_part(discriminator);
    }
    return out.clone() + mir_cpp_function_symbol_signature_suffix(m, function_id);
}

// Real C++ spelling of a foreign element type (spdlog::details::log_msg,
// std::string, ...). Foreign records must use their genuine name, not the
// internal vyx_dci_type_* layout blob, so a generated override actually matches
// the third-party virtual.
fn mir_cpp_dci_stub_real_elem_text(m: MirUnit, elem_id: i32) -> string {
    if (elem_id == mir_id_invalid()) { return "void"; }
    let kind = mir_cpp_type_kind(m, elem_id);
    // DCI's C++ char identity is distinct from int8_t; the generic Vyx C++
    // renderer spells the language character as char32_t. Native pointer
    // signatures must retain the producer's character and pointer depth.
    if (kind == ty_CHAR()) { return "char"; }
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        return mir_cpp_dci_stub_param_cpp_type(m, elem_id);
    }
    if (mir_cpp_type_is_foreign_cpp(m, elem_id)) {
        return mir_cpp_foreign_cpp_type_text_from_source(m, mir_cpp_type_source_text(m, elem_id));
    }
    return mir_cpp_type_text(m, elem_id);
}

// C++ spelling of a record type at a DCI stub boundary.  The stub TU is
// compiled against the producer's headers, where the same C layout is
// declared: foreign records under their contract spelling, consumer-declared
// repr(C) records under the identical name both sides measured
// independently.  The internal vyx_type_* / vyx_dci_type_* blob names exist
// only inside the Vyx object; the stub TU could not even parse them.
fn mir_cpp_dci_stub_cpp_type_text(m: MirUnit, type_id: i32) -> string {
    return mir_cpp_foreign_cpp_type_text_from_source(m, mir_cpp_type_source_text(m, type_id));
}

// C++ parameter spelling of a DCI stub override. mir_cpp_type_text collapses
// &T / &mut T / *T to vyx::Ptr<...> and names foreign records with the internal
// blob type; neither overrides the real base virtual, so reference / pointer /
// by-value-foreign parameters are rendered with native C++ syntax and the real
// type name here.
fn mir_cpp_dci_stub_param_cpp_type(m: MirUnit, type_id: i32) -> string {
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_REF()) {
        return "const " + mir_cpp_dci_stub_real_elem_text(m, hir_type_table_elem(m.types, type_id)) + " &";
    }
    if (kind == ty_MUTREF()) {
        return mir_cpp_dci_stub_real_elem_text(m, hir_type_table_elem(m.types, type_id)) + " &";
    }
    if (kind == ty_PTR()) {
        return mir_cpp_dci_stub_real_elem_text(m, hir_type_table_elem(m.types, type_id)) + " *";
    }
    if (kind == ty_CLASS()) {
        // Foreign and consumer-declared records alike cross as their real C++
        // type; the override must spell the base virtual's parameter type.
        return mir_cpp_dci_stub_cpp_type_text(m, type_id);
    }
    return mir_cpp_type_text(m, type_id);
}

// Parameter type of the extern "C" Vyx callback thunk. Reference / pointer
// parameters cross the boundary as an opaque address that the Vyx side
// reinterprets through the DCI layout; value primitives cross unchanged.
fn mir_cpp_dci_stub_thunk_param_type(m: MirUnit, type_id: i32) -> string {
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_REF() || kind == ty_MUTREF() || kind == ty_PTR()) { return "void*"; }
    if (kind == ty_CLASS()) {
        // The declaration only has to agree with the Vyx-defined thunk on the
        // symbol and the C aggregate ABI, and both follow the measured layout.
        return mir_cpp_dci_stub_cpp_type_text(m, type_id);
    }
    return mir_cpp_type_text(m, type_id);
}

// Return type of a DCI stub override / thunk declaration: records spell as
// their real C++ type (see mir_cpp_dci_stub_cpp_type_text).
fn mir_cpp_dci_stub_return_cpp_type(m: MirUnit, function_id: i32) -> string {
    let type_id = m.function_return_type(function_id);
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
        return mir_cpp_dci_stub_param_cpp_type(m, type_id);
    }
    if (type_id != mir_id_invalid() && mir_cpp_type_kind(m, type_id) == ty_CLASS()) {
        return mir_cpp_dci_stub_cpp_type_text(m, type_id);
    }
    return mir_cpp_type_text(m, type_id);
}

// Expression forwarding an override parameter to the Vyx callback thunk.
fn mir_cpp_dci_stub_thunk_arg_expr(m: MirUnit, type_id: i32, param_expr: string) -> string {
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_REF() || kind == ty_MUTREF()) { return "(void*)(&" + param_expr + ")"; }
    if (kind == ty_PTR()) { return "(void*)(" + param_expr + ")"; }
    return param_expr;
}

fn mir_cpp_dci_stub_method_is_overridden(m: MirUnit, derived: string, member: string) -> bool {
    if (member.len == 0) { return false; }
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        if (mir_cpp_function_is_dci_vyx_override(m, fn_id, derived)
            && mir_cpp_function_method_name(m, fn_id) == member) {
            return true;
        }
        fn_id = fn_id + 1;
    }
    return false;
}

// Concrete-ize a base pure virtual the Vyx subclass does not override, so the
// generated stub class is instantiable. The signature is reconstructed from the
// contract vtable entry's display name (e.g.
// "void spdlog::sinks::sink::set_formatter(std::unique_ptr<spdlog::formatter>) [pure]").
// The body is fail-closed: it drops its arguments. Only *pure* virtuals are
// filled; a non-pure virtual already has a real implementation in the linked
// third-party library and must not be shadowed.
fn mir_cpp_dci_pure_virtual_default(m: MirUnit, entry: rawptr, derived: string) -> string {
    if (entry == null) { return ""; }
    if (mir_cpp_dci_json_string(entry, "kind") != "method") { return ""; }
    let owner = mir_cpp_dci_json_string(entry, "owner");
    let member = mir_cpp_dci_json_string(entry, "member_name");
    let display_raw = mir_cpp_dci_json_string(entry, "name");
    if (member.len == 0 || display_raw.len == 0) { return ""; }
    var display = display_raw.trim();
    if (!display.endsWith(" [pure]")) { return ""; }
    if (mir_cpp_dci_stub_method_is_overridden(m, derived, member)) { return ""; }
    display = display.substring(0, (display.len as i64) - 7).trim();
    let open = display.indexOf("(");
    if (open < 0) { return ""; }
    var depth: i64 = 0;
    var close: i64 = -1;
    var i: i64 = open;
    while (i < (display.len as i64)) {
        let ch = display.charAt(i);
        if (ch == 40) { depth = depth + 1; }
        else if (ch == 41) {
            depth = depth - 1;
            if (depth == 0) { close = i; break; }
        }
        i = i + 1;
    }
    if (close < 0) { return ""; }
    let params = display.substring(open + 1, close);
    let before = display.substring(0, open).trim();
    let trailing = display.substring(close + 1, display.len as i64).trim();
    let is_const = trailing.startsWith("const");
    var ret = "void";
    let suffix = owner + "::" + member;
    if (before.endsWith(suffix)) {
        ret = before.substring(0, (before.len as i64) - (suffix.len as i64)).trim();
    }
    if (ret.len == 0) { ret = "void"; }
    var out = "    " + ret + " " + member + "(" + params + ")";
    if (is_const) { out = out + " const"; }
    out = out + " noexcept override {";
    if (ret != "void") { out = out + " return {}; "; }
    out = out + "}\n";
    return out;
}

// Emit default implementations for every base pure virtual the Vyx subclass
// leaves unimplemented so `new __dci_vyx_stub_*` compiles against an abstract
// third-party base (e.g. spdlog::sinks::sink::set_formatter).
fn mir_cpp_emit_dci_stub_autofill(m: MirUnit, derived: string, base_name: string) -> string {
    var out = "";
    var seen = "";
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let vtables = mir_cpp_dci_dispatch_tables_from(mir_cpp_dci_contract_at(m, root_i));
        if (vtables != null) {
            let vcount = cJSON_GetArraySize(vtables);
            var vi: i32 = 0;
            while (vi < vcount) {
                let vt = cJSON_GetArrayItem(vtables, vi);
                if (mir_cpp_dci_contract_type_names_match(
                        mir_cpp_dci_json_string(vt, "class_name"), base_name)) {
                    let entries = mir_cpp_dci_json_item(vt, "entries");
                    if (entries != null && cJSON_IsArray(entries) != 0) {
                        let ecount = cJSON_GetArraySize(entries);
                        var ei: i32 = 0;
                        while (ei < ecount) {
                            let e = cJSON_GetArrayItem(entries, ei);
                            let member = mir_cpp_dci_json_string(e, "member_name");
                            let key = "|" + member + "|";
                            if (member.len > 0 && !seen.contains(key)) {
                                let filled = mir_cpp_dci_pure_virtual_default(m, e, derived);
                                if (filled.len > 0) {
                                    out = out + filled;
                                    seen = seen + key;
                                }
                            }
                            ei = ei + 1;
                        }
                    }
                }
                vi = vi + 1;
            }
        }
        root_i = root_i + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_stub_callback_decl(m: MirUnit, function_id: i32) -> string {
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let symbol = mir_cpp_vyx_llvm_symbol_name(m, function_id);
    if (ret_ty.len == 0 || symbol.len == 0) { return ""; }
    var out = "extern \"C\" " + ret_ty + " " + symbol + "(void* self";
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        out = out + ", " + mir_cpp_dci_stub_thunk_param_type(m, mir_cpp_function_param_type_at(m, function_id, idx))
              + " p" + mir_cpp_i32(idx);
        idx = idx + 1;
    }
    return out + ")" + mir_cpp_dci_callback_exception_spec(m) + ";\n";
}

fn mir_cpp_dci_callback_exception_spec(m: MirUnit) -> string {
    // Match the LLVM host body's participation in the contract's shared ABI.
    // A noexcept C++ declaration would terminate before Vyx cleanup can propagate.
    let control = mir_cpp_dci_json_item(mir_cpp_dci_root(m), "control_flow");
    let propagation = mir_cpp_dci_json_item(control, "propagation");
    if (mir_cpp_dci_control_flow_boundary(control) == "shared_abi"
        || mir_cpp_dci_json_string(propagation, "mode") == "shared_abi") { return ""; }
    return " noexcept";
}

fn mir_cpp_emit_dci_stub_callback_decl_to_file(m: MirUnit,
                                               file: &mut std.fs.File,
                                               function_id: i32) -> i32 {
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let symbol = mir_cpp_vyx_llvm_symbol_name(m, function_id);
    if (ret_ty.len == 0 || symbol.len == 0) { return 0; }
    if (mir_cpp_append(file, "extern \"C\" ") != 0) { return -1; }
    if (mir_cpp_append(file, ret_ty) != 0) { return -1; }
    if (mir_cpp_append(file, " ") != 0) { return -1; }
    if (mir_cpp_append(file, symbol) != 0) { return -1; }
    if (mir_cpp_append(file, "(void* self") != 0) { return -1; }
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        if (mir_cpp_append(file, ", ") != 0) { return -1; }
        if (mir_cpp_append(file, mir_cpp_dci_stub_thunk_param_type(m, mir_cpp_function_param_type_at(m, function_id, idx))) != 0) { return -1; }
        if (mir_cpp_append(file, " p") != 0) { return -1; }
        if (mir_cpp_append(file, mir_cpp_i32(idx)) != 0) { return -1; }
        idx = idx + 1;
    }
    return mir_cpp_append(file, ")" + mir_cpp_dci_callback_exception_spec(m) + ";\n");
}

fn mir_cpp_emit_dci_stub_override_method(m: MirUnit, function_id: i32) -> string {
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let symbol = mir_cpp_vyx_llvm_symbol_name(m, function_id);
    let method = mir_cpp_function_method_name(m, function_id);
    if (ret_ty.len == 0 || symbol.len == 0 || method.len == 0) { return ""; }
    var out = "    " + ret_ty + " " + mir_cpp_cpp_qualified_name(method) + "(";
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        if (idx > 1) { out = out + ", "; }
        out = out + mir_cpp_dci_stub_param_cpp_type(m, mir_cpp_function_param_type_at(m, function_id, idx))
              + " p" + mir_cpp_i32(idx);
        idx = idx + 1;
    }
    out = out + ")" + mir_cpp_dci_callback_exception_spec(m) + " override";
    if ((m.function_flags( function_id) & hir_function_flag_foreign_cpp_final_method()) != 0) {
        out = out + " final";
    }
    out = out + " {\n";
    var call = symbol + "(this";
    idx = 1;
    while (idx < n) {
        call = call + ", " + mir_cpp_dci_stub_thunk_arg_expr(
            m, mir_cpp_function_param_type_at(m, function_id, idx), "p" + mir_cpp_i32(idx));
        idx = idx + 1;
    }
    call = call + ")";
    if (ret_ty == "void") {
        out = out + "        " + call + ";\n";
    } else {
        out = out + "        return " + call + ";\n";
    }
    return out + "    }\n";
}

fn mir_cpp_emit_dci_stub_override_method_to_file(m: MirUnit,
                                                 file: &mut std.fs.File,
                                                 function_id: i32) -> i32 {
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let symbol = mir_cpp_vyx_llvm_symbol_name(m, function_id);
    let method = mir_cpp_function_method_name(m, function_id);
    if (ret_ty.len == 0 || symbol.len == 0 || method.len == 0) { return 0; }
    if (mir_cpp_append(file, "    ") != 0) { return -1; }
    if (mir_cpp_append(file, ret_ty) != 0) { return -1; }
    if (mir_cpp_append(file, " ") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_cpp_qualified_name(method)) != 0) { return -1; }
    if (mir_cpp_append(file, "(") != 0) { return -1; }
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        if (idx > 1 && mir_cpp_append(file, ", ") != 0) { return -1; }
        if (mir_cpp_append(file, mir_cpp_dci_stub_param_cpp_type(m, mir_cpp_function_param_type_at(m, function_id, idx))) != 0) { return -1; }
        if (mir_cpp_append(file, " p") != 0) { return -1; }
        if (mir_cpp_append(file, mir_cpp_i32(idx)) != 0) { return -1; }
        idx = idx + 1;
    }
    if (mir_cpp_append(file, ")" + mir_cpp_dci_callback_exception_spec(m) + " override") != 0) { return -1; }
    if ((m.function_flags( function_id) & hir_function_flag_foreign_cpp_final_method()) != 0) {
        if (mir_cpp_append(file, " final") != 0) { return -1; }
    }
    if (mir_cpp_append(file, " {\n") != 0) { return -1; }
    if (mir_cpp_append(file, "        ") != 0) { return -1; }
    if (ret_ty != "void" && mir_cpp_append(file, "return ") != 0) { return -1; }
    if (mir_cpp_append(file, symbol) != 0) { return -1; }
    if (mir_cpp_append(file, "(this") != 0) { return -1; }
    idx = 1;
    while (idx < n) {
        if (mir_cpp_append(file, ", ") != 0) { return -1; }
        if (mir_cpp_append(file, mir_cpp_dci_stub_thunk_arg_expr(
                m, mir_cpp_function_param_type_at(m, function_id, idx), "p" + mir_cpp_i32(idx))) != 0) { return -1; }
        idx = idx + 1;
    }
    if (mir_cpp_append(file, ");\n") != 0) { return -1; }
    return mir_cpp_append(file, "    }\n");
}

fn mir_cpp_emit_dci_stub_class(m: MirUnit, derived: string, base_name: string) -> string {
    if (derived.len == 0 || base_name.len == 0) { return ""; }
    let stub_name = mir_cpp_dci_stub_class_name(derived);
    let base_cpp = mir_cpp_dci_stub_cpp_base_name(m, base_name);
    if (stub_name.len == 0 || base_cpp.len == 0) { return ""; }
    var callback_decls = "";
    var methods = "";
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        if (mir_cpp_function_is_dci_vyx_override(m, fn_id, derived)) {
            callback_decls = callback_decls + mir_cpp_emit_dci_stub_callback_decl(m, fn_id);
            methods = methods + mir_cpp_emit_dci_stub_override_method(m, fn_id);
        }
        fn_id = fn_id + 1;
    }
    var out = callback_decls;
    if (out.len > 0) { out = out + "\n"; }
    out = out + "class " + stub_name + " : public " + base_cpp + " {\n";
    out = out + "public:\n";
    out = out + "    " + stub_name + "() : " + base_cpp + "() {}\n";
    out = out + mir_cpp_emit_dci_stub_state(m, derived, false);
    out = out + methods;
    out = out + mir_cpp_emit_dci_stub_autofill(m, derived, base_name);
    out = out + "};\n\n";
    out = out + mir_cpp_emit_dci_stub_state(m, derived, true);
    out = out + "extern \"C\" void* " + mir_cpp_dci_stub_factory_symbol(derived) + "() {\n";
    out = out + "    return new " + stub_name + "();\n";
    out = out + "}\n\n";
    out = out + "extern \"C\" void " + mir_cpp_dci_stub_destroy_symbol(derived) + "(void* p) {\n";
    out = out + "    delete reinterpret_cast<" + stub_name + "*>(p);\n";
    out = out + "}\n\n";
    return out;
}

fn mir_cpp_emit_dci_stub_class_to_file(m: MirUnit,
                                       file: &mut std.fs.File,
                                       derived: string,
                                       base_name: string) -> i32 {
    if (derived.len == 0 || base_name.len == 0) { return 0; }
    let stub_name = mir_cpp_dci_stub_class_name(derived);
    let base_cpp = mir_cpp_dci_stub_cpp_base_name(m, base_name);
    if (stub_name.len == 0 || base_cpp.len == 0) { return 0; }
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        let is_override = mir_cpp_function_is_dci_vyx_override(m, fn_id, derived);
        if (is_override) {
            if (mir_cpp_emit_dci_stub_callback_decl_to_file(m, file, fn_id) != 0) { return -1; }
        }
        fn_id = fn_id + 1;
    }
    if (m.function_count > 0) {
        if (mir_cpp_append(file, "\n") != 0) { return -1; }
    }
    if (mir_cpp_append(file, "class ") != 0) { return -1; }
    if (mir_cpp_append(file, stub_name) != 0) { return -1; }
    if (mir_cpp_append(file, " : public ") != 0) { return -1; }
    if (mir_cpp_append(file, base_cpp) != 0) { return -1; }
    if (mir_cpp_append(file, " {\npublic:\n    ") != 0) { return -1; }
    if (mir_cpp_append(file, stub_name) != 0) { return -1; }
    if (mir_cpp_append(file, "() : ") != 0) { return -1; }
    if (mir_cpp_append(file, base_cpp) != 0) { return -1; }
    if (mir_cpp_append(file, "() {}\n") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_emit_dci_stub_state(m, derived, false)) != 0) { return -1; }
    fn_id = 1;
    while (fn_id <= m.function_count) {
        if (mir_cpp_function_is_dci_vyx_override(m, fn_id, derived)) {
            if (mir_cpp_emit_dci_stub_override_method_to_file(m, file, fn_id) != 0) { return -1; }
        }
        fn_id = fn_id + 1;
    }
    if (mir_cpp_append(file, mir_cpp_emit_dci_stub_autofill(m, derived, base_name)) != 0) { return -1; }
    if (mir_cpp_append(file, "};\n\n") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_emit_dci_stub_state(m, derived, true)) != 0) { return -1; }
    if (mir_cpp_append(file, "extern \"C\" void* ") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_dci_stub_factory_symbol(derived)) != 0) { return -1; }
    if (mir_cpp_append(file, "() {\n    return new ") != 0) { return -1; }
    if (mir_cpp_append(file, stub_name) != 0) { return -1; }
    if (mir_cpp_append(file, "();\n}\n\nextern \"C\" void ") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_dci_stub_destroy_symbol(derived)) != 0) { return -1; }
    if (mir_cpp_append(file, "(void* p) {\n    delete reinterpret_cast<") != 0) { return -1; }
    if (mir_cpp_append(file, stub_name) != 0) { return -1; }
    return mir_cpp_append(file, "*>(p);\n}\n\n");
}

fn mir_cpp_emit_dci_stub_classes(m: MirUnit) -> string {
    let rows = mir_unit_dci_stub_specs(&m);
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") {
                out = out + mir_cpp_emit_dci_stub_class(m,
                                                        mir_cpp_dci_stub_spec_field(line, 1),
                                                        mir_cpp_dci_stub_spec_field(line, 2));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_native_virtual_stub_decl(m: MirUnit, function_id: i32) -> string {
    if (!mir_unit_function_is_foreign_cpp(&m,  function_id)) { return ""; }
    if (!mir_unit_function_requires_dci_clang_stub(&m,  function_id)) { return ""; }
    if (!mir_unit_function_is_foreign_cpp_instance_method(&m,  function_id)) { return ""; }
    let owner = mir_cpp_foreign_cpp_owner_type(m, function_id);
    if (owner.len == 0) { return ""; }
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let symbol = mir_cpp_dci_clang_stub_symbol_name(m, function_id);
    if (ret_ty.len == 0 || symbol.len == 0) { return ""; }
    var out = "extern \"C\" " + ret_ty + " " + symbol + "(" + owner + "* self";
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        let pty = mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, function_id, idx));
        out = out + ", " + pty + " p" + mir_cpp_i32(idx);
        idx = idx + 1;
    }
    return out + ");\n";
}

fn mir_cpp_emit_dci_stub_lifecycle_declarations(m: MirUnit) -> string {
    let rows = mir_unit_dci_stub_specs(&m);
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") {
                let derived = mir_cpp_dci_stub_spec_field(line, 1);
                if (derived.len > 0) {
                    out = out + "extern \"C\" void* "
                        + mir_cpp_dci_stub_factory_symbol(derived) + "();\n";
                    out = out + "extern \"C\" void "
                        + mir_cpp_dci_stub_destroy_symbol(derived) + "(void* p);\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_stub_declarations(m: MirUnit) -> string {
    var out = mir_cpp_emit_dci_stub_lifecycle_declarations(m);
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        out = out + mir_cpp_emit_dci_native_virtual_stub_decl(m, function_id);
        function_id = function_id + 1;
    }
    if (out.len > 0) { out = out + "\n"; }
    return out;
}

fn mir_cpp_emit_dci_native_virtual_stub(m: MirUnit, function_id: i32) -> string {
    if (!mir_unit_function_is_foreign_cpp(&m,  function_id)) { return ""; }
    if (!mir_unit_function_requires_dci_clang_stub(&m,  function_id)) { return ""; }
    if (!mir_unit_function_is_foreign_cpp_instance_method(&m,  function_id)) { return ""; }
    let owner = mir_cpp_foreign_cpp_owner_type(m, function_id);
    if (owner.len == 0) { return ""; }
    let ret_ty = mir_cpp_dci_stub_return_cpp_type(m, function_id);
    let method = mir_cpp_foreign_cpp_method_name(m, function_id);
    let symbol = mir_cpp_dci_clang_stub_symbol_name(m, function_id);
    if (ret_ty.len == 0 || method.len == 0 || symbol.len == 0) { return ""; }
    var out = "extern \"C\" " + ret_ty + " " + symbol + "(" + owner + "* self";
    let n = mir_cpp_function_param_count(m, function_id);
    var idx: i32 = 1;
    while (idx < n) {
        let pty = mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, function_id, idx));
        out = out + ", " + pty + " p" + mir_cpp_i32(idx);
        idx = idx + 1;
    }
    out = out + ") {\n";
    var call_args = "";
    idx = 1;
    while (idx < n) {
        if (call_args.len > 0) { call_args = call_args + ", "; }
        call_args = call_args + "p" + mir_cpp_i32(idx);
        idx = idx + 1;
    }
    let call = "self->" + mir_cpp_cpp_qualified_name(method) + "(" + call_args + ")";
    if (ret_ty == "void") {
        out = out + "    " + call + ";\n";
    } else {
        out = out + "    return " + call + ";\n";
    }
    out = out + "}\n\n";
    return out;
}

// Closed instances of an open-generic C++ base exist in exactly one object:
// this stub TU.  A template's virtual member is *pure* in the producer header
// and never instantiated there, so the consumer's direct-call ABI (the mangled
// member symbol recorded in the closed facts) has no definition anywhere --
// the rustc backend fills the same hole with a producer-side `dci.rust.dyn`
// dispatch shim.  Emit an explicit member specialization per closed instance;
// its body dispatches virtually, so the symbol resolves and the call lands on
// the inheriting stub's override.  Concrete (non-template) bases are skipped:
// their virtuals are defined in the producer object and a redefinition here
// would duplicate the symbol.
//
// The walk is data-driven over the descriptor roots (dispatch_tables + the
// matching symbol facts), not over MirUnit functions: the stub TU is emitted
// in its own process and the closed-instance functions carry no reliable
// per-function flags there.
fn mir_cpp_emit_dci_pure_virtual_member_definitions(m: MirUnit) -> string {
    var seen: string = "";
    var out = "";
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let root = mir_cpp_dci_contract_at(m, root_i);
        let tables = mir_cpp_dci_dispatch_tables_from(root);
        if (tables != null) {
            var table_i: i32 = 0;
            while (table_i < cJSON_GetArraySize(tables)) {
                let table = cJSON_GetArrayItem(tables, table_i);
                let class_name = mir_cpp_dci_json_string(table, "class_name");
                if (class_name.len > 0 && class_name.contains("<")) {
                    let owner = mir_cpp_dci_stub_cpp_base_name(m, class_name);
                    if (owner.len > 0 && owner.contains("<")) {
                        let entries = mir_cpp_dci_json_item(table, "entries");
                        if (entries != null && cJSON_IsArray(entries) != 0) {
                            var entry_i: i32 = 0;
                            while (entry_i < cJSON_GetArraySize(entries)) {
                                let entry = cJSON_GetArrayItem(entries, entry_i);
                                if (mir_cpp_dci_json_string(entry, "kind") == "method"
                                    && mir_cpp_dci_json_string(entry, "name").contains("[pure]")) {
                                    let mangled = mir_cpp_dci_dispatch_entry_link_name(entry);
                                    let member = mir_cpp_dci_json_string(entry, "member_name");
                                    if (mangled.len > 0 && member.len > 0) {
                                        let symbols = mir_cpp_dci_exports_array_from(root, "symbols");
                                        if (symbols != null) {
                                            var symbol_i: i32 = 0;
                                            while (symbol_i < cJSON_GetArraySize(symbols)) {
                                                let symbol = cJSON_GetArrayItem(symbols, symbol_i);
                                                if (mir_cpp_dci_dispatch_entry_link_name(symbol) == mangled) {
                                                    let abi = mir_cpp_dci_json_item(symbol, "abi");
                                                    let ret_ty = mir_cpp_dci_json_string(
                                                        mir_cpp_dci_json_item(
                                                            mir_cpp_dci_json_item(abi, "return"), "type"),
                                                        "cpp_type");
                                                    let params = mir_cpp_dci_json_item(abi, "parameters");
                                                    if (ret_ty.len > 0 && params != null
                                                        && cJSON_IsArray(params) != 0) {
                                                        let key = owner + "::" + member;
                                                        if (!seen.contains(key)) {
                                                            var param_text = "";
                                                            var call_args = "";
                                                            var param_i: i32 = 0;
                                                            var params_ok = true;
                                                            while (param_i < cJSON_GetArraySize(params)) {
                                                                let param = cJSON_GetArrayItem(params, param_i);
                                                                let pty = mir_cpp_dci_json_string(
                                                                    mir_cpp_dci_json_item(param, "type"), "cpp_type");
                                                                if (pty.len == 0) { params_ok = false; break; }
                                                                if (param_i > 0) {
                                                                    param_text = param_text + ", ";
                                                                    call_args = call_args + ", ";
                                                                }
                                                                param_text = param_text + pty + " p"
                                                                    + mir_cpp_i32(param_i);
                                                                call_args = call_args + "p" + mir_cpp_i32(param_i);
                                                                param_i = param_i + 1;
                                                            }
                                                            if (params_ok) {
                                                                var body = "    this->" + member + "(" + call_args + ")";
                                                                if (ret_ty != "void") {
                                                                    body = "    return this->" + member + "(" + call_args + ")";
                                                                }
                                                                out = out + "template <> " + ret_ty + " " + owner
                                                                    + "::" + member + "(" + param_text + ") {\n"
                                                                    + body + ";\n}\n\n";
                                                                seen = seen + key + "\n";
                                                            }
                                                        }
                                                        break;
                                                    }
                                                }
                                                symbol_i = symbol_i + 1;
                                            }
                                        }
                                    }
                                }
                                entry_i = entry_i + 1;
                            }
                        }
                    }
                }
                table_i = table_i + 1;
            }
        }
        root_i = root_i + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_stub_source(m: MirUnit) -> string {
    var out = "// generated by Vyx DCI Clang Stub emitter\n";
    out = out + "#include <cstdint>\n";
    out = out + mir_cpp_emit_foreign_cpp_includes(m);
    out = out + "\n";
    // The specializations must precede any implicit instantiation of the
    // instance's members (the stub classes below inherit the base).
    out = out + mir_cpp_emit_dci_pure_virtual_member_definitions(m);
    out = out + mir_cpp_emit_dci_stub_classes(m);
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        out = out + mir_cpp_emit_dci_native_virtual_stub(m, function_id);
        function_id = function_id + 1;
    }
    return out;
}

fn mir_cpp_dci_source_language(m: MirUnit) -> string {
    return dci_bundle_source_language(mir_cpp_dci_root(m));
}

fn mir_cpp_path_dirname(path: string) -> string {
    var last: i32 = -1;
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 47 || c == 92) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return "."; }
    return path.substring(0, last);
}

fn mir_cpp_path_is_absolute(path: string) -> bool {
    if (path.len >= 1 && (path.charAt(0) == 47 || path.charAt(0) == 92)) { return true; }
    if (path.len >= 2 && path.charAt(1) == 58) { return true; }
    return false;
}

fn mir_cpp_join_fs_path(dir: string, rel: string) -> string {
    if (rel.len == 0) { return dir; }
    if (mir_cpp_path_is_absolute(rel)) { return rel; }
    if (dir.len == 0) { return rel; }
    let last = dir.charAt(dir.len - 1);
    if (last == 47 || last == 92) { return dir + rel; }
    return dir + "/" + rel;
}

fn mir_cpp_rust_slash_path(path: string) -> string {
    var out = "";
    var i: i32 = 0;
    while (i < path.len) {
        let c = path.charAt(i);
        if (c == 92) {
            out = out + "/";
        } else {
            out = out + path.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_dci_rust_crate_name(m: MirUnit) -> string {
    let source = mir_cpp_dci_json_item(mir_cpp_dci_rust_root(m), "source");
    var name = mir_cpp_dci_json_string(source, "crate_name");
    if (name.len == 0 && mir_cpp_dci_rust_root(m) != null) { name = "native"; }
    return name;
}

fn mir_cpp_dci_rust_edition(m: MirUnit) -> string {
    let source = mir_cpp_dci_json_item(mir_cpp_dci_rust_root(m), "source");
    var edition = mir_cpp_dci_json_string(source, "edition");
    if (edition.len == 0) { edition = "2021"; }
    return edition;
}

fn mir_cpp_dci_rust_target(m: MirUnit) -> string {
    let target = mir_cpp_dci_json_item(mir_cpp_dci_rust_root(m), "target");
    var triple = mir_cpp_dci_json_string(target, "triple");
    if (triple.len == 0) {
        let first_target = mir_cpp_dci_json_item(mir_cpp_dci_root(m), "target");
        triple = mir_cpp_dci_json_string(first_target, "triple");
    }
    return triple;
}

fn mir_cpp_dci_rust_trait_path(m: MirUnit, type_name: string) -> string {
    let crate_name = mir_cpp_dci_rust_crate_name(m);
    let path = mir_cpp_dci_layout_rust_path(m, type_name);
    if (crate_name.len == 0 || path.len == 0) { return ""; }
    return crate_name + "::" + path;
}

fn mir_cpp_dci_rust_include_path(m: MirUnit) -> string {
    let rust_index = mir_cpp_dci_rust_root_index(m);
    if (rust_index < 0) { return ""; }
    let source = mir_cpp_dci_json_item(mir_cpp_dci_contract_at(m, rust_index), "source");
    let crate_root = mir_cpp_dci_json_string(source, "crate_root");
    let inputs = mir_cpp_dci_json_item(source, "inputs");
    var rel = "";
    if (inputs != null && cJSON_IsArray(inputs) != 0) {
        let n = cJSON_GetArraySize(inputs);
        var i: i32 = 0;
        while (i < n) {
            let item = cJSON_GetArrayItem(inputs, i);
            if (item != null && cJSON_IsString(item) != 0) {
                let raw = cJSON_GetStringValue(item);
                if (raw != null) {
                    let text = from_cstr(raw);
                    if (text.endsWith(".rs")) {
                        rel = text;
                        break;
                    }
                }
            }
            i = i + 1;
        }
    }
    if (rel.len == 0) { rel = crate_root; }
    if (rel.len == 0) { return ""; }
    if (fileExists(rel)) { return mir_cpp_rust_slash_path(rel); }
    var contract_path = mir_cpp_dci_contract_path_at(m, rust_index);
    if (contract_path.len == 0) { contract_path = mir_unit_dci_abi_path(&m); }
    let joined = mir_cpp_join_fs_path(mir_cpp_path_dirname(contract_path), rel);
    if (fileExists(joined)) { return mir_cpp_rust_slash_path(joined); }
    if (crate_root.len > 0 && fileExists(crate_root)) {
        return mir_cpp_rust_slash_path(crate_root);
    }
    return mir_cpp_rust_slash_path(joined);
}

fn mir_cpp_dci_layout_rust_path(m: MirUnit, type_name: string) -> string {
    let layout = mir_cpp_dci_layout_for_name(m, type_name);
    let rust = mir_cpp_dci_json_item(layout, "rust");
    var path = mir_cpp_dci_json_string(rust, "path");
    if (path.startsWith("crate::")) { path = path.substring(7, path.len); }
    // A closed instance spells its *argument* with the crate prefix too
    // (`crate::SinkG::<crate::Sample>`), and that inner one is not at the start
    // -- leaking it into the generated source gives `SinkG::<crate::Sample>`,
    // which rustc rejects.  Every occurrence has to go, not just the prefix.
    if (path.contains("crate::")) { path = path.replace("crate::", ""); }
    return path;
}

fn mir_cpp_dci_stub_rust_type(m: MirUnit, type_id: i32) -> string {
    if (type_id == mir_id_invalid()) { return "()"; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text == "i8" || text == "u8" || text == "i16" || text == "u16"
        || text == "i32" || text == "u32" || text == "i64" || text == "u64"
        || text == "isize" || text == "usize"
        || text == "f32" || text == "f64" || text == "bool" || text == "char") {
        return text;
    }
    if (text == "void") { return "()"; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_VOID()) { return "()"; }
    // A producer record used as an instance's type argument is a *value* on the
    // Rust side, not an opaque blob: the trait method's signature has to spell
    // it (`Sample`) or rustc reports E0053 against the trait's own signature.
    // Degrading to `*mut c_void` only papers over by-value arguments we cannot
    // name -- anything the contract knows, we can name.
    if (kind == ty_CLASS()) { return mir_cpp_dci_stub_rust_nominal(m, text); }
    return "*mut core::ffi::c_void";
}

fn mir_cpp_dci_stub_rust_nominal(m: MirUnit, text: string) -> string {
    if (text.len == 0) { return "*mut core::ffi::c_void"; }
    let direct = mir_cpp_dci_layout_rust_path(m, text.clone());
    if (direct.len > 0) { return direct; }
    let last = mir_cpp_last_path_segment(text.clone());
    if (last != text) {
        let by_last = mir_cpp_dci_layout_rust_path(m, last.clone());
        if (by_last.len > 0) { return by_last; }
    }
    let crate_name = mir_cpp_dci_rust_crate_name(m);
    if (crate_name.len > 0) {
        let by_crate = mir_cpp_dci_layout_rust_path(m, crate_name + "." + text);
        if (by_crate.len > 0) { return by_crate; }
    }
    return "*mut core::ffi::c_void";
}

fn mir_cpp_emit_dci_rust_stub_class(m: MirUnit, derived: string, base_name: string) -> string {
    if (derived.len == 0 || base_name.len == 0) { return ""; }
    let stub_name = mir_cpp_dci_stub_class_name(derived);
    let trait_path = mir_cpp_dci_rust_trait_path(m, base_name);
    if (stub_name.len == 0 || trait_path.len == 0) { return ""; }
    var callbacks = "";
    var methods = "";
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        if (mir_cpp_function_is_dci_vyx_override(m, fn_id, derived)) {
            let ret_ty = mir_cpp_dci_stub_rust_type(m, m.function_return_type(fn_id));
            let symbol = mir_cpp_vyx_llvm_symbol_name(m, fn_id);
            let method = mir_cpp_function_method_name(m, fn_id);
            var cb = "    fn " + symbol + "(self_: *mut core::ffi::c_void";
            var impl_sig = "    fn " + method + "(&self";
            var call = symbol + "(self as *const Self as *mut core::ffi::c_void";
            let n = mir_cpp_function_param_count(m, fn_id);
            var idx: i32 = 1;
            while (idx < n) {
                let pty = mir_cpp_dci_stub_rust_type(m, mir_cpp_function_param_type_at(m, fn_id, idx));
                let pname = "p" + mir_cpp_i32(idx);
                cb = cb + ", " + pname + ": " + pty;
                impl_sig = impl_sig + ", " + pname + ": " + pty;
                call = call + ", " + pname;
                idx = idx + 1;
            }
            callbacks = callbacks + cb + ") -> " + ret_ty + ";\n";
            if (ret_ty == "()") {
                methods = methods + impl_sig + ") {\n        unsafe { " + call + "); }\n    }\n";
            } else {
                methods = methods + impl_sig + ") -> " + ret_ty
                    + " {\n        unsafe { " + call + ") }\n    }\n";
            }
        }
        fn_id = fn_id + 1;
    }
    var out = "";
    if (callbacks.len > 0) {
        out = out + "unsafe extern \"C\" {\n" + callbacks + "}\n\n";
    }
    out = out + "#[repr(C)]\n";
    out = out + "pub struct " + stub_name + " {\n";
    out = out + "    pub vptr: *const (),\n";
    out = out + "}\n\n";
    out = out + "impl " + trait_path + " for " + stub_name + " {\n";
    out = out + methods;
    out = out + "}\n\n";
    out = out + "#[unsafe(no_mangle)]\n";
    out = out + "pub unsafe extern \"C\" fn " + mir_cpp_dci_stub_factory_symbol(derived)
        + "() -> *mut " + stub_name + " {\n";
    out = out + "    unsafe {\n";
    out = out + "        let ptr = Box::into_raw(Box::new(" + stub_name
        + " { vptr: core::ptr::null() }));\n";
    out = out + "        let obj: &dyn " + trait_path + " = &*ptr;\n";
    out = out + "        let fat: [*const (); 2] = core::mem::transmute_copy(&obj);\n";
    out = out + "        (*ptr).vptr = fat[1];\n";
    out = out + "        ptr\n";
    out = out + "    }\n";
    out = out + "}\n\n";
    out = out + "#[unsafe(no_mangle)]\n";
    out = out + "pub unsafe extern \"C\" fn " + mir_cpp_dci_stub_destroy_symbol(derived)
        + "(p: *mut " + stub_name + ") {\n";
    out = out + "    unsafe {\n";
    out = out + "        if !p.is_null() {\n";
    out = out + "            drop(Box::from_raw(p));\n";
    out = out + "        }\n";
    out = out + "    }\n";
    out = out + "}\n\n";
    return out;
}

fn mir_cpp_emit_dci_rust_stub_classes(m: MirUnit) -> string {
    let rows = mir_unit_dci_stub_specs(&m);
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") {
                out = out + mir_cpp_emit_dci_rust_stub_class(m,
                                                            mir_cpp_dci_stub_spec_field(line, 1),
                                                            mir_cpp_dci_stub_spec_field(line, 2));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_emit_dci_rust_stub_source(m: MirUnit) -> string {
    let crate_name = mir_cpp_dci_rust_crate_name(m);
    let producer = mir_cpp_dci_rust_include_path(m);
    var out = "// generated by Vyx DCI rustc Stub emitter\n";
    if (producer.len == 0) { return out; }
    out = out + "// dci-rust-producer=" + producer + "\n";
    out = out + "// dci-rust-crate-name=" + crate_name + "\n";
    out = out + "// dci-rust-edition=" + mir_cpp_dci_rust_edition(m) + "\n";
    out = out + "// dci-rust-target=" + mir_cpp_dci_rust_target(m) + "\n";
    out = out + "#![allow(dead_code, unused_imports, improper_ctypes_definitions, unused_unsafe, unsafe_op_in_unsafe_fn, clippy::all)]\n\n";
    if (crate_name.len > 0) {
        out = out + "extern crate " + crate_name + ";\n";
        out = out + "pub use " + crate_name + "::*;\n\n";
    }
    out = out + mir_cpp_emit_dci_rust_stub_classes(m);
    return out;
}

public fn mir_cpp_emit_dci_stub_source_file(m: MirUnit, output_path: string) -> i32 {
    let validate_rc = mir_cpp_validate_dci_stubs(m);
    if (validate_rc != 0) { return validate_rc; }
    if (mir_cpp_output_is_rust_stub(output_path)) {
        // The Rust stub path reached from `build` (the compiler shells out to
        // itself with `--emit=dci-stubs`) has no project-mode pre-validation,
        // unlike `mir_cpp_emit_streamed_cmake_project`.  Without this, a Vyx
        // subclass whose descriptor entry is missing -- e.g. a *generic* base
        // spelled without the closed instance's arguments -- emits a stub with
        // no `impl` at all and only fails at link time with
        // `undefined symbol: __dci_stub_factory_<X>`, pointing at no source.
        let rust_stub_validate_rc = mir_cpp_validate_dci_stubs(m);
        if (rust_stub_validate_rc != 0) { return rust_stub_validate_rc; }
        var rust_file = File.open(output_path, FileOptions {
            read: false,
            write: true,
            create: true,
            truncate: true,
            binary: true,
        });
        if (!rust_file.is_open()) { return -1; }
        var rust_result = rust_file.write_text(mir_cpp_emit_dci_rust_stub_source(m));
        let rust_close = rust_file.close();
        if (rust_result != 0) { return rust_result; }
        return rust_close;
    }
    var file = File.open(output_path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("// generated by Vyx DCI Clang Stub emitter\n");
    if (result == 0) { result = mir_cpp_append(&mut file, "#include <cstdint>\n"); }
    if (result == 0) { result = mir_cpp_append(&mut file, mir_cpp_emit_foreign_cpp_includes(m)); }
    if (result == 0) { result = mir_cpp_append(&mut file, "\n"); }
    // The specializations must precede any implicit instantiation of the
    // instance's members (the stub classes below inherit the base).
    if (result == 0) { result = mir_cpp_append(&mut file, mir_cpp_emit_dci_pure_virtual_member_definitions(m)); }

    let rows = mir_unit_dci_stub_specs(&m);
    var start: i32 = 0;
    var i: i32 = 0;
    while (result == 0 && i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") {
                result = mir_cpp_emit_dci_stub_class_to_file(m,
                                                             &mut file,
                                                             mir_cpp_dci_stub_spec_field(line, 1),
                                                             mir_cpp_dci_stub_spec_field(line, 2));
            }
            start = i + 1;
        }
        i = i + 1;
    }

    var function_id: i32 = 1;
    while (result == 0 && function_id <= m.function_count) {
        result = mir_cpp_append(&mut file, mir_cpp_emit_dci_native_virtual_stub(m, function_id));
        function_id = function_id + 1;
    }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_effective_call_name(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()
        || value_id <= 0
        || value_id > m.value_count
        || m.value_kind(value_id) != mir_value_call()) {
        return "";
    }
    let lhs = m.value_lhs(value_id);
    var call_name = mir_cpp_value_source_name(m, value_id);
    if (lhs != mir_id_invalid()
        && lhs > 0
        && lhs <= m.value_count
        && m.value_kind(lhs) == mir_value_target_ref()
        && (m.value_target_kind(value_id) != mir_target_builtin() || call_name.len == 0)) {
        let lhs_name = mir_cpp_value_source_name(m, lhs);
        if (lhs_name.len > 0) { call_name = lhs_name; }
    }
    return call_name;
}

fn mir_cpp_effective_call_target_kind(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid()
        || value_id <= 0
        || value_id > m.value_count
        || m.value_kind(value_id) != mir_value_call()) {
        return mir_target_none();
    }
    let lhs = m.value_lhs(value_id);
    if (lhs != mir_id_invalid()
        && lhs > 0
        && lhs <= m.value_count
        && m.value_kind(lhs) == mir_value_target_ref()
        && m.value_target_kind(lhs) != mir_target_none()) {
        return m.value_target_kind(lhs);
    }
    return m.value_target_kind(value_id);
}

// The semantic/MIR representation keeps `Clone<str>::clone` as a builtin
// member call, so its receiver is not part of `first_arg`.  Falling through
// to the generic builtin emitter used to produce a free `clone()` call and
// silently discard that receiver.  A Vyx string clone owns a separate byte
// buffer; keep that contract when exporting to C++ and evaluate the receiver
// exactly once in case it is itself a call expression.
fn mir_cpp_string_clone_call_expr(m: MirUnit, receiver: i32) -> string {
    if (receiver == mir_id_invalid() || !mir_cpp_type_is_string_storage(m, m.value_type(receiver))) {
        return "";
    }
    let source = mir_cpp_value_expr(m, receiver);
    return "([&]() { auto vyx_clone_source = " + source
        + "; return vyx::str_owned_bytes(vyx::str_data(vyx_clone_source), "
        + "static_cast<std::size_t>(vyx_clone_source.len)); }())";
}

fn mir_cpp_reflect_method_value_uses_fn_type(m: MirUnit, type_id: i32) -> bool {
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind != ty_FN() && kind != ty_CFN()) { return false; }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_call()
            && m.value_type(value_id) == type_id
            && mir_cpp_effective_call_target_kind(m, value_id) == mir_target_builtin()
            && mir_cpp_effective_call_name(m, value_id).startsWith("reflect_method_value")) {
            return true;
        }
        value_id = value_id + 1;
    }
    return false;
}

fn mir_cpp_call_expr(m: MirUnit, value_id: i32) -> string {
    let lhs = m.value_lhs(value_id);
    var call_name = mir_cpp_value_source_name(m, value_id);
    var call_base = policy_generic_call_base(call_name.clone());
    var target_kind = m.value_target_kind(value_id);
    var target_id = m.value_target_id(value_id);
    if (lhs != mir_id_invalid()) {
        if (m.value_kind(lhs) == mir_value_target_ref()) {
            let lhs_name = mir_cpp_value_source_name(m, lhs);
            if (lhs_name.len > 0
                && (target_kind != mir_target_builtin() || call_name.len == 0)) {
                call_name = lhs_name;
                call_base = policy_generic_call_base(call_name.clone());
            }
            if (m.value_target_kind(lhs) != mir_target_none()) { target_kind = m.value_target_kind(lhs); }
            if (m.value_target_id(lhs) != mir_id_invalid()) { target_id = m.value_target_id(lhs); }
        }
    }
    // Match LlvmMirLowerer.lower_call_value: layout builtins are dispatched
    // from the resolved call name before considering a direct function
    // target. Older seeds may attach a synthetic generic helper target while
    // still preserving the source-level `repr_sizeof::<T>` call name.
    if (call_base == "repr_sizeof") {
        let repr_size = mir_cpp_repr_sizeof_expr(m, value_id, call_name);
        if (repr_size.len > 0) { return repr_size; }
    }
    // Old bootstrap seeds bind the backend-representation builtin through a
    // synthetic generic helper. LLVM can execute that helper because its
    // source and physical record layouts coincide; generated C++ records may
    // use a wider physical representation (notably `vyx::Str`). Collapse the
    // same builtin before direct-call lowering so `repr_sizeof<T>` always
    // measures the representation consumed by this backend.
    if (target_kind == mir_target_function()
        && target_id != mir_id_invalid()
        && (policy_generic_call_base(m.function_name(target_id)) == "repr_sizeof"
            || m.function_name(target_id).startsWith("repr_sizeof::")
            || m.function_name(target_id).startsWith("mir2_repr_sizeof"))) {
        let repr_size = mir_cpp_repr_sizeof_function_expr(m, target_id);
        if (repr_size.len > 0) { return repr_size; }
    }
    if (target_kind == mir_target_hir_variant()) {
        return mir_cpp_variant_expr(m, m.value_type(value_id), target_id, m.value_first_arg(value_id));
    }
    if (lhs != mir_id_invalid() && m.value_target_kind(lhs) == mir_target_hir_variant()) {
        return mir_cpp_variant_expr(m, m.value_type(value_id), m.value_target_id(lhs), m.value_first_arg(value_id));
    }
    if (target_kind == mir_target_builtin() && (call_name == "toString" || call_name == "to_string")) {
        if (lhs != mir_id_invalid()) {
            let receiver = m.value_lhs(lhs);
            if (receiver != mir_id_invalid()) { return "vyx::to_string(" + mir_cpp_value_expr(m, receiver) + ")"; }
        }
    }
    if (call_name == "clone") {
        let clone_expr = mir_cpp_string_clone_call_expr(m, mir_cpp_call_receiver_value(m, lhs));
        if (clone_expr.len > 0) { return clone_expr; }
    }
    if (call_name == "int_to_string" || call_name == "bool_to_string") {
        return "vyx::to_string(" + mir_cpp_call_arg_expr_at(m, m.value_first_arg(value_id), 0) + ")";
    }
    if (target_kind != mir_target_function() && call_name.startsWith("sizeof")) {
        return mir_cpp_sizeof_expr(m, value_id, call_name);
    }
    if (target_kind != mir_target_function() && call_name.startsWith("repr_sizeof")) {
        return mir_cpp_repr_sizeof_expr(m, value_id, call_name);
    }
    if (target_kind != mir_target_function() && call_name.startsWith("alignof")) {
        return mir_cpp_alignof_expr(m, value_id, call_name);
    }
    if (target_kind != mir_target_function() && call_name == "typeof") {
        return mir_cpp_typeof_expr(m, value_id);
    }
    var c_runtime_name = call_name;
    if (target_kind == mir_target_function()
        && target_id != mir_id_invalid()
        && mir_cpp_is_c_runtime_function_decl(m, target_id)) {
        c_runtime_name = mir_cpp_function_source_name(m, target_id);
    }
    if (mir_cpp_is_c_runtime_extern(c_runtime_name)
        && (target_kind == mir_target_builtin()
            || (target_kind == mir_target_function()
                && target_id != mir_id_invalid()
                && mir_cpp_is_c_runtime_function_decl(m, target_id)))) {
        let c_call = mir_cpp_c_runtime_call_expr(
            m, c_runtime_name, m.value_first_arg(value_id), target_id);
        if (c_call.len > 0) {
            if (target_kind == mir_target_function()) {
                return mir_cpp_foreign_c_return_expr(m, target_id, c_call);
            }
            return c_call;
        }
    }
    if (call_name == "name"
        && lhs != mir_id_invalid()
        && target_kind != mir_target_function()
        && mir_cpp_type_text(m, m.value_type(value_id)) == "vyx::Str") {
        return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(lhs));
    }
    if (target_kind != mir_target_function() && call_name.startsWith("type_name")) {
        let type_args = policy_generic_call_args(call_name.clone());
        if (type_args.len > 0) {
            return "vyx::str_lit(" + mir_cpp_quote(mir_cpp_type_name_from_source_text(type_args)) + ")";
        }
        return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(value_id));
    }
    if (target_kind != mir_target_function() && call_name == "reflect_manifest") {
        return "vyx::str_lit(" + mir_cpp_quote(mir_unit_reflection_manifest(&m)) + ")";
    }
    if (target_kind != mir_target_function() && call_name.startsWith("reflect_name")) {
        return mir_cpp_reflect_name_call_expr(m, value_id, call_name);
    }
    if (target_kind != mir_target_function() && call_name.startsWith("reflect_method_value")) {
        return mir_cpp_reflect_method_value_expr(m, value_id);
    }
    if ((call_base == "new" || call_name == "new_" || call_base == "construct")
        && target_kind != mir_target_function()) {
        let ret_ty = mir_cpp_type_text(m, m.value_type(value_id));
        if (ret_ty != "void" && ret_ty != "vyx::Any") {
            var construct_name = call_base;
            if (call_name == "new_") { construct_name = "new"; }
            let first_arg = m.value_first_arg(value_id);
            let argc = mir_cpp_call_arg_count(m, first_arg);
            if (argc == 0) { return ret_ty + "{}"; }
            if (argc == 1) {
                return "static_cast<" + ret_ty + ">(" + mir_cpp_call_arg_expr_at(m, first_arg, 0) + ")";
            }
            mir_cpp_report_error_at_value(m,
                                          value_id,
                                          "builtin " + construct_name + " for `" + mir_cpp_type_text(m, m.value_type(value_id))
                                              + "` accepts zero arguments for value initialization or one value for move construction; got "
                                              + mir_cpp_i32(argc));
            return ret_ty + "{}";
        }
    }
    let args = mir_cpp_arg_list(m, m.value_first_arg(value_id));
    if (target_kind == mir_target_builtin() && (call_name == "print" || call_name == "println")) {
        if (call_name == "println") { return "vyx::println(" + args + ")"; }
        return "vyx::print(" + args + ")";
    }
    if (target_kind == mir_target_builtin()) {
        let receiver_args = mir_cpp_builtin_args_with_receiver(m, lhs, m.value_first_arg(value_id));
        if (call_name == "len" || call_name == "length" || call_name == "size" || call_name == "count") {
            return "vyx::len(" + receiver_args + ")";
        }
        if (call_name == "ptr" || call_name == "c_str") { return "vyx::ptr(" + receiver_args + ")"; }
        if (call_name == "cap" || call_name == "owned") {
            return "(" + receiver_args + ")." + call_name;
        }
        if (call_name == "compare") { return "vyx::compare(" + receiver_args + ")"; }
        if (mir_cpp_string_like_builtin(call_name)) { return "vyx::" + mir_cpp_ident(call_name) + "(" + receiver_args + ")"; }
        if (call_name == "panic") { return "vyx::panic_value<" + mir_cpp_type_text(m, m.value_type(value_id)) + ">(" + args + ")"; }
        if (call_name == "malloc") { return "std::malloc(" + args + ")"; }
        if (call_name == "realloc") { return "std::realloc(" + args + ")"; }
        if (call_name == "free") { return "std::free(" + args + ")"; }
        if (call_name == "memcpy") { return "std::memcpy(" + args + ")"; }
        if (call_name == "memmove") { return "std::memmove(" + args + ")"; }
        if (call_name == "memset") { return "std::memset(" + args + ")"; }
        if (call_name == "sizeof") { return "static_cast<int64_t>(0)"; }
    }
    var receiver = mir_id_invalid();
    if (lhs != mir_id_invalid()) { receiver = mir_cpp_call_receiver_value(m, lhs); }
    if (target_kind == mir_target_function()
        && target_id != mir_id_invalid()
        && mir_cpp_function_is_foreign_cpp_ctor(m, target_id)) {
        return mir_cpp_dci_ctor_expr(
            m, target_id, mir_cpp_dci_call_args(m, target_id, m.value_first_arg(value_id)));
    }
    if (target_kind == mir_target_function()
        && target_id != mir_id_invalid()
        && mir_cpp_function_is_foreign_cpp(m, target_id)) {
        if (receiver == mir_id_invalid()
            && mir_cpp_callee_has_type_receiver(m, lhs)) {
            return mir_cpp_foreign_cpp_method_call(
                m, target_id, mir_id_invalid(), m.value_first_arg(value_id), args);
        }
        return mir_cpp_foreign_cpp_method_call(
            m, target_id, receiver, m.value_first_arg(value_id), args);
    }
    if (target_kind == mir_target_function()
        && receiver == mir_id_invalid()
        && mir_cpp_function_param_count(m, target_id) > mir_cpp_call_arg_count(m, m.value_first_arg(value_id))) {
        receiver = mir_cpp_call_receiver_value(m, lhs);
    }
    if (target_kind == mir_target_function()
        && receiver == mir_id_invalid()
        && mir_cpp_callee_has_type_receiver(m, lhs)
        && mir_cpp_function_param_count(m, target_id) > mir_cpp_call_arg_count(m, m.value_first_arg(value_id))) {
        if (mir_cpp_call_has_ref_temp(m,
                                      target_id,
                                      mir_id_invalid(),
                                      m.value_first_arg(value_id),
                                      true)) {
            return mir_cpp_call_with_ref_temps(m,
                                               target_id,
                                               mir_id_invalid(),
                                               m.value_first_arg(value_id),
                                               true);
        }
        var call_args = mir_cpp_default_self_expr(m, target_id);
        let rest = mir_cpp_arg_list_for_function_from_param(m, target_id, m.value_first_arg(value_id), 1);
        if (rest.len > 0) { call_args = call_args + ", " + rest; }
        return mir_cpp_call_name(m, target_kind, target_id, call_name) + "(" + call_args + ")";
    }
    if (target_kind == mir_target_function() && receiver != mir_id_invalid()) {
        if (mir_cpp_call_has_ref_temp(m, target_id, receiver, m.value_first_arg(value_id), false)) {
            return mir_cpp_call_with_ref_temps(m, target_id, receiver, m.value_first_arg(value_id), false);
        }
        let call_out = mir_cpp_call_name(m, target_kind, target_id, call_name);
        let call_args = mir_cpp_arg_list_with_receiver_for_function(m, target_id, receiver, m.value_first_arg(value_id));
        return call_out + "(" + call_args + ")";
    }
    if (target_kind == mir_target_none() && lhs != mir_id_invalid()) {
        if (mir_cpp_type_is_fn_value(m, m.value_type(lhs))) {
            var call = "vyx::call<" + mir_cpp_type_text(m, m.value_type(value_id)) + ">("
                + mir_cpp_value_expr(m, lhs);
            if (args.len > 0) { call = call + ", " + args; }
            return call + ")";
        }
        var ret_ty = mir_cpp_type_text(m, m.value_type(value_id));
        if (ret_ty == "void") { ret_ty = "void"; }
        let arg_types = mir_cpp_call_arg_type_list(m, m.value_first_arg(value_id));
        return "reinterpret_cast<" + ret_ty + " (*)(" + arg_types + ")>("
            + mir_cpp_value_expr(m, lhs) + ")(" + args + ")";
    }
    if (target_kind == mir_target_function()) {
        let first_arg = m.value_first_arg(value_id);
        if (mir_cpp_function_needs_implicit_self_arg(m, target_id)
            && mir_cpp_function_param_count(m, target_id) > mir_cpp_call_arg_count(m, first_arg)) {
            if (mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, true)) {
                return mir_cpp_call_with_ref_temps(m, target_id, mir_id_invalid(), first_arg, true);
            }
            return mir_cpp_call_with_default_self_arg(m, target_id, first_arg);
        }
        if (mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, false)) {
            return mir_cpp_call_with_ref_temps(m, target_id, mir_id_invalid(), first_arg, false);
        }
        var call_out2 = mir_cpp_call_name(m, target_kind, target_id, call_name);
        call_out2 = call_out2 + "(";
        call_out2 = call_out2 + mir_cpp_arg_list_for_function(m, target_id, m.value_first_arg(value_id));
        call_out2 = call_out2 + ")";
        return mir_cpp_foreign_c_return_expr(m, target_id, call_out2);
    }
    return mir_cpp_call_name(m, target_kind, target_id, call_name) + "(" + args + ")";
}

fn mir_cpp_dci_pointer_cast_expr(m: MirUnit,
                                 value_id: i32,
                                 source_value: i32,
                                 source_expr: string) -> string {
    if (value_id == mir_id_invalid() || source_value == mir_id_invalid()) { return ""; }
    let target_type = m.value_type(value_id);
    let source_type = m.value_type(source_value);
    if (target_type == mir_id_invalid() || source_type == mir_id_invalid()) { return ""; }
    let target_kind = mir_cpp_type_kind(m, target_type);
    if (target_kind != ty_PTR() && target_kind != ty_REF() && target_kind != ty_MUTREF()) {
        return "";
    }
    let target_record = hir_type_table_elem(m.types, target_type);
    if (target_record == mir_id_invalid() || !mir_unit_type_is_foreign_dci(&m,  target_record)) {
        return "";
    }
    var source_name = mir_cpp_dci_record_name_for_type(m, source_type);
    let source_is_stub = mir_cpp_type_is_dci_stub_class(m, source_type);
    if (source_is_stub) {
        source_name = mir_cpp_dci_stub_direct_foreign_base(m, source_type);
    }
    let target_name = mir_cpp_dci_record_name_for_type(m, target_type);
    let offset = mir_cpp_dci_unique_base_offset(m, source_name, target_name);
    if (offset < 0) { return ""; }
    let source_kind = mir_cpp_type_kind(m, source_type);
    if (source_is_stub
        || source_kind == ty_PTR() || source_kind == ty_REF() || source_kind == ty_MUTREF()) {
        return "([&]() -> void* { auto* vyx_dci_source = reinterpret_cast<unsigned char*>("
            + source_expr + "); if (vyx_dci_source == nullptr) { return nullptr; } "
            + "return reinterpret_cast<void*>(vyx_dci_source + "
            + policy_i64_to_string(offset) + "); }())";
    }
    return "reinterpret_cast<void*>(reinterpret_cast<unsigned char*>(&(" + source_expr + ")) + "
        + policy_i64_to_string(offset) + ")";
}

fn mir_cpp_cast_expr(m: MirUnit, value_id: i32) -> string {
    let dst_ty = mir_cpp_type_text(m, m.value_type(value_id));
    let src_value = m.value_lhs(value_id);
    let src = mir_cpp_value_expr(m, src_value);
    let src_ty = mir_cpp_type_text(m, m.value_type(src_value));
    let dci_pointer_cast = mir_cpp_dci_pointer_cast_expr(m, value_id, src_value, src.clone());
    if (dci_pointer_cast.len > 0) { return dci_pointer_cast; }
    if (dst_ty == "vyx::Any") { return "vyx::Any(" + src + ")"; }
    if (dst_ty == "vyx::Str") {
        let raw_src = mir_cpp_std_string_raw_expr(m, src_value);
        if (raw_src.len > 0) { return raw_src; }
        return "vyx::to_string(" + src + ")";
    }
    if (mir_cpp_type_is_integer_text(dst_ty)
        && src_value != mir_id_invalid()
        && m.value_kind(src_value) == mir_value_target_ref()
        && m.value_target_kind(src_value) == mir_target_function()) {
        let target_function = m.value_target_id(src_value);
        var target_name = mir_cpp_function_name(m, target_function);
        if (mir_cpp_function_needs_raw_callback_adapter(m, target_function)) {
            target_name = mir_cpp_raw_callback_adapter_name(m, target_function);
        }
        return "static_cast<" + dst_ty + ">(reinterpret_cast<intptr_t>(&"
            + target_name + "))";
    }
    if (dst_ty == "void*") {
        if (src_value != mir_id_invalid()
            && m.value_kind(src_value) == mir_value_target_ref()
            && m.value_target_kind(src_value) == mir_target_function()) {
            return "reinterpret_cast<void*>(&"
                + mir_cpp_function_name(m, m.value_target_id(src_value)) + ")";
        }
        if (mir_cpp_type_is_integer_text(src_ty)) {
            return "reinterpret_cast<void*>(static_cast<intptr_t>(" + src + "))";
        }
        return "vyx::ptr(" + src + ")";
    }
    if (mir_cpp_type_is_integer_text(dst_ty) && src_ty == "void*") {
        return "static_cast<" + dst_ty + ">(reinterpret_cast<intptr_t>(" + src + "))";
    }
    if (m.variant_count_for_type(m.value_type(value_id)) > 0 && src_ty != dst_ty) {
        return mir_cpp_variant_wrap_expr(m, m.value_type(value_id), src);
    }
    if (m.variant_count_for_type(m.value_type(src_value)) > 0 && !dst_ty.startsWith("vyx_type_")) {
        return "vyx::any_cast_value<" + dst_ty + ">((" + src + ").payload0)";
    }
    if (dst_ty.startsWith("vyx_type_") && src_ty == "void*") {
        return "vyx::deref_or_default<" + dst_ty + ">(" + src + ")";
    }
    if (dst_ty.startsWith("vyx_type_") && src_ty.startsWith("vyx_type_")
        && m.field_count_for_type(m.value_type(value_id)) == 0) {
        return dst_ty + "(" + src + ")";
    }
    if (dst_ty.startsWith("vyx_type_") && src_ty.startsWith("vyx_type_")) {
        let data_field = mir_cpp_type_field_id_by_name(m, m.value_type(src_value), "data");
        if (data_field != mir_id_invalid()) {
            let data_ty = mir_cpp_type_text(m, m.field_type(data_field));
            if (data_ty == "void*") {
                return "vyx::deref_or_default<" + dst_ty + ">((" + src + ")."
                    + mir_cpp_field_cpp_name(m, data_field, m.field_index(data_field)) + ")";
            }
        }
    }
    // Newtype/wrapper cast into a single-field value record: place the source
    // value into the sole field.  This is how a monomorphized single-field
    // value-class constructor (`Wrap<T>(v)`) is lowered — the record has one
    // field whose type matches the source, so `T_record{ src }` reconstructs
    // it by value instead of dropping the payload (`vyx_type_...{}`).
    if (dst_ty.startsWith("vyx_type_")
        && m.field_count_for_type(m.value_type(value_id)) == 1) {
        let only_field = m.field_id_for_type_index(m.value_type(value_id), 0);
        if (only_field != mir_id_invalid()
            && mir_cpp_type_text(m, m.field_type(only_field)) == src_ty) {
            return dst_ty + "{" + src + "}";
        }
    }
    if (dst_ty.startsWith("std::array<") || dst_ty.startsWith("std::tuple<")
        || dst_ty.startsWith("vyx_type_")) {
        return dst_ty + "{}";
    }
    return "static_cast<" + dst_ty + ">(" + src + ")";
}

public fn mir_cpp_value_expr(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()) { return "vyx::Any{}"; }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_const_int()) { return policy_i64_to_string(m.value_int(value_id)); }
    if (kind == mir_value_const_bool()) {
        if (m.value_int(value_id) != 0) { return "true"; }
        return "false";
    }
    if (kind == mir_value_const_str()) {
        if (m.value_first_arg(value_id) != mir_id_invalid()) {
            return mir_cpp_fstring_expr(m, value_id);
        }
        return "vyx::str_lit(" + mir_cpp_quote(mir_cpp_value_source_text(m, value_id)) + ")";
    }
    if (kind == mir_value_const_char()) {
        return "static_cast<char32_t>(" + policy_i64_to_string(m.value_int(value_id)) + ")";
    }
    if (kind == mir_value_null()) {
        let ty = mir_cpp_type_text(m, m.value_type(value_id));
        if (ty == "void*") { return "nullptr"; }
        if (ty == "vyx::Str") { return "vyx::Str{}"; }
        return mir_cpp_default_value_for_type(ty);
    }
    if (kind == mir_value_read_place()) { return mir_cpp_place_expr(m, m.value_place(value_id)); }
    if (kind == mir_value_address_of()) {
        var capability = "vyx::PtrCapability::Shared";
        if (m.value_op(value_id) == 1) { capability = "vyx::PtrCapability::Mutable"; }
        let address_place = m.value_place(value_id);
        if (address_place != mir_id_invalid()) {
            if (m.value_name(value_id) == "array.decay"
                && m.place_kind(address_place) == mir_place_index()) {
                return "vyx::ptr_borrow_array(" + mir_cpp_place_expr(m, m.place_base(address_place))
                    + ", " + capability + ")";
            }
            if (m.place_kind(address_place) == mir_place_deref()) {
                let pointer_value = m.place_index_value(address_place);
                let result_elem = hir_type_table_elem(m.types, m.value_type(value_id));
                var result_elem_text = "vyx::Any";
                if (result_elem != mir_id_invalid()) { result_elem_text = mir_cpp_type_text(m, result_elem); }
                if (pointer_value != mir_id_invalid()) {
                    return "vyx::ptr_reborrow<" + result_elem_text + ">(" + mir_cpp_value_expr(m, pointer_value)
                        + ", " + capability + ")";
                }
            }
            return "vyx::ptr_borrow_value(" + mir_cpp_place_expr(m, address_place)
                + ", " + capability + ")";
        }
        return "vyx::ptr_borrow_value((" + mir_cpp_value_expr(m, m.value_lhs(value_id))
            + "), " + capability + ")";
    }
    if (kind == mir_value_unary()) {
        let op = mir_cpp_unop(m.value_op(value_id));
        if (m.value_op(value_id) == tk_NOT()) {
            return "(!" + mir_cpp_bool_expr(m, m.value_lhs(value_id)) + ")";
        }
        if (m.value_op(value_id) == tk_MINUS()) {
            let result_ty = mir_cpp_type_text(m, m.value_type(value_id));
            if (mir_cpp_type_is_signed_integer_text(result_ty)) {
                return "vyx::wrapping_neg<" + result_ty + ">"
                    + "("
                    + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")";
            }
        }
        if (op.len > 0) { return "(" + op + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")"; }
        let fail_expr = mir_cpp_fail_variant_expr(m, value_id);
        if (fail_expr.len > 0) { return fail_expr; }
        if (m.value_op(value_id) == tk_QUESTION()) {
            let lhs_id = m.value_lhs(value_id);
            let lhs_expr = mir_cpp_value_expr(m, lhs_id);
            if (m.variant_count_for_type(m.value_type(lhs_id)) > 0) {
                return "vyx::any_cast_value<" + mir_cpp_type_text(m, m.value_type(value_id))
                    + ">((" + lhs_expr + ").payload0)";
            }
            return lhs_expr;
        }
        return mir_cpp_value_expr(m, m.value_lhs(value_id));
    }
    if (kind == mir_value_binary()) {
        if (m.value_op(value_id) == tk_DOTDOT() || m.value_op(value_id) == tk_DOTDOTEQ()) {
            var end_expr = mir_cpp_value_expr(m, m.value_rhs(value_id));
            if (m.value_op(value_id) == tk_DOTDOTEQ()) { end_expr = "(" + end_expr + " + 1)"; }
            return "vyx::Range{static_cast<int64_t>(" + mir_cpp_value_expr(m, m.value_lhs(value_id))
                + "), static_cast<int64_t>(" + end_expr + ")}";
        }
        let op2 = mir_cpp_binop(m.value_op(value_id));
        if (op2.len > 0) {
            let lhs_ty = mir_cpp_type_text(m, m.value_type(m.value_lhs(value_id)));
            let rhs_ty = mir_cpp_type_text(m, m.value_type(m.value_rhs(value_id)));
            if (m.value_op(value_id) == tk_MINUS()
                && lhs_ty == "void*" && rhs_ty == "void*") {
                return "static_cast<int64_t>(reinterpret_cast<unsigned char*>("
                    + mir_cpp_value_expr(m, m.value_lhs(value_id))
                    + ") - reinterpret_cast<unsigned char*>("
                    + mir_cpp_value_expr(m, m.value_rhs(value_id)) + "))";
            }
            if ((m.value_op(value_id) == tk_PLUS() || m.value_op(value_id) == tk_MINUS())
                && lhs_ty == "void*" && mir_cpp_type_is_integer_text(rhs_ty)) {
                let byte_ptr = "reinterpret_cast<unsigned char*>(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")";
                return "static_cast<void*>((" + byte_ptr + " " + op2 + " "
                    + mir_cpp_value_expr(m, m.value_rhs(value_id)) + "))";
            }
            if (m.value_op(value_id) == tk_PLUS()
                && rhs_ty == "void*" && mir_cpp_type_is_integer_text(lhs_ty)) {
                return "static_cast<void*>((reinterpret_cast<unsigned char*>("
                    + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ") + "
                    + mir_cpp_value_expr(m, m.value_lhs(value_id)) + "))";
            }
            if (m.value_op(value_id) == tk_EQEQ() || m.value_op(value_id) == tk_NEQ()) {
                let lhs_str = mir_cpp_string_compare_operand(m, m.value_lhs(value_id));
                let rhs_str = mir_cpp_string_compare_operand(m, m.value_rhs(value_id));
                if (lhs_str.len > 0 && rhs_str.len > 0) {
                    return "(" + lhs_str + " " + op2 + " " + rhs_str + ")";
                }
            }
            let result_ty2 = mir_cpp_type_text(m, m.value_type(value_id));
            if (mir_cpp_type_is_signed_integer_text(result_ty2)) {
                var wrapping_op = "";
                if (m.value_op(value_id) == tk_PLUS()) { wrapping_op = "wrapping_add"; }
                else if (m.value_op(value_id) == tk_MINUS()) { wrapping_op = "wrapping_sub"; }
                else if (m.value_op(value_id) == tk_STAR()) { wrapping_op = "wrapping_mul"; }
                else if (m.value_op(value_id) == tk_LSHIFT()) { wrapping_op = "wrapping_shl"; }
                else if (m.value_op(value_id) == tk_RSHIFT()) { wrapping_op = "wrapping_lshr"; }
                if (wrapping_op.len > 0) {
                    return "vyx::" + wrapping_op + "<" + result_ty2 + ">"
                        + "("
                        + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ", "
                        + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ")";
                }
            }
            return "(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + " " + op2 + " "
                   + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ")";
        }
        if (m.value_op(value_id) == tk_QUESTIONQUESTION()) {
            return "vyx::coalesce(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ", "
                + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ")";
        }
        if (m.value_op(value_id) == tk_MATCHOP()) {
            return "vyx::matches(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ", "
                + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ")";
        }
        return "vyx::binary<" + mir_cpp_type_text(m, m.value_type(value_id)) + ">("
            + mir_cpp_i32(m.value_op(value_id)) + ", "
            + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ", "
            + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ")";
    }
    if (kind == mir_value_call()) { return mir_cpp_call_expr(m, value_id); }
    if (kind == mir_value_target_ref()) {
        let target_name = mir_cpp_value_source_name(m, value_id);
        if (m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return mir_cpp_variant_expr(m, m.value_type(value_id), m.value_target_id(value_id), mir_id_invalid());
        }
        if (m.value_target_kind(value_id) == mir_target_function()
            && mir_cpp_type_is_fn_value(m, m.value_type(value_id))) {
            return mir_cpp_closure_value_expr(m, m.value_target_id(value_id));
        }
        if (m.value_target_kind(value_id) == mir_target_hir_item()) {
            return mir_cpp_static_name(m, m.value_target_id(value_id));
        }
        if (mir_cpp_is_number_text(target_name)
            && m.value_lhs(value_id) != mir_id_invalid()) {
            return "std::get<" + target_name + ">(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")";
        }
        if (target_name.startsWith("_")
            && target_name.len > 1
            && mir_cpp_is_number_text(target_name.substring(1, target_name.len))
            && m.value_lhs(value_id) != mir_id_invalid()) {
            return "std::get<" + target_name.substring(1, target_name.len) + ">("
                + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")";
        }
        if (m.value_target_kind(value_id) == mir_target_builtin()
            && m.value_lhs(value_id) != mir_id_invalid()) {
            let receiver_expr = mir_cpp_value_expr(m, m.value_lhs(value_id));
            if (target_name == "fields") {
                let receiver_type = m.value_type(m.value_lhs(value_id));
                return "vyx::Range{0, " + mir_cpp_i32(m.field_count_for_type(receiver_type)) + "}";
            }
            if (target_name == "len" || target_name == "length" || target_name == "size" || target_name == "count") {
                return "vyx::len(" + receiver_expr + ")";
            }
            if (target_name == "ptr" || target_name == "c_str") {
                return "vyx::ptr(" + receiver_expr + ")";
            }
            if (target_name == "cap" || target_name == "owned") {
                return "(" + receiver_expr + ")." + target_name;
            }
        }
        if (target_name == "name" && mir_cpp_type_text(m, m.value_type(value_id)) == "vyx::Str") {
            let receiver = m.value_lhs(value_id);
            if (receiver != mir_id_invalid()) {
                return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(receiver));
            }
            return "vyx::str_lit(\"name\")";
        }
        if (target_name == "kind" && mir_cpp_type_text(m, m.value_type(value_id)) == "vyx::Str") {
            let receiver2 = m.value_lhs(value_id);
            if (receiver2 != mir_id_invalid()) {
                return mir_cpp_reflect_type_kind_expr(m, value_id, m.value_type(receiver2));
            }
            return "vyx::str_lit(\"class\")";
        }
        return mir_cpp_call_name(m, m.value_target_kind(value_id), m.value_target_id(value_id), target_name);
    }
    if (kind == mir_value_aggregate()) {
        return mir_cpp_aggregate_expr(m, value_id);
    }
    if (kind == mir_value_cast()) {
        return mir_cpp_cast_expr(m, value_id);
    }
    if (kind == mir_value_control_result()) {
        return "((" + mir_cpp_bool_expr(m, m.value_lhs(value_id)) + ") ? ("
            + mir_cpp_value_expr(m, m.value_rhs(value_id)) + ") : ("
            + mir_cpp_value_expr(m, m.value_aux(value_id)) + "))";
    }
    if (kind == mir_value_intrinsic()) {
        let intrinsic_name = mir_cpp_value_source_name(m, value_id);
        if (intrinsic_name == "__vyx_new") {
            let payload_type = m.value_target_id(value_id);
            let payload_text = mir_cpp_type_text(m, payload_type);
            let init_value = m.value_rhs(value_id);
            let first_arg = m.value_first_arg(value_id);
            if (init_value != mir_id_invalid()) {
                let init_text = mir_cpp_value_expr(m, init_value);
                let result_text = mir_cpp_type_text(m, m.value_type(value_id));
                if (result_text == payload_text) { return init_text; }
                return "vyx::ptr_new<" + payload_text + ">(" + init_text + ")";
            }
            if (first_arg != mir_id_invalid()) {
                return "vyx::ptr_new<" + payload_text + ">(" + mir_cpp_value_expr(m, first_arg) + ")";
            }
            return "vyx::ptr_new<" + payload_text + ">()";
        }
        if (intrinsic_name == "__vyx_delete") {
            let place_id = m.value_place(value_id);
            if (place_id != mir_id_invalid()) {
                let place_expr = mir_cpp_place_expr(m, place_id);
                return "vyx::ptr_delete(" + place_expr + ")";
            }
            return "vyx::ptr_delete_value(" + mir_cpp_value_expr(m, m.value_lhs(value_id)) + ")";
        }
        if (intrinsic_name == "__vyx_move_handle") {
            let source_place = mir_cpp_place_expr(m, m.value_place(value_id));
            let source_type = mir_cpp_type_text(m, m.value_type(value_id));
            return "([&](){ auto vyx_moved = " + source_place + "; "
                + source_place + " = " + mir_cpp_default_value_for_type(source_type)
                + "; return vyx_moved; }())";
        }
        if (intrinsic_name.startsWith("sizeof")) {
            return mir_cpp_sizeof_expr(m, value_id, intrinsic_name);
        }
        if (intrinsic_name.startsWith("repr_sizeof")) {
            return mir_cpp_repr_sizeof_expr(m, value_id, intrinsic_name);
        }
        if (intrinsic_name.startsWith("alignof")) {
            return mir_cpp_alignof_expr(m, value_id, intrinsic_name);
        }
        if (intrinsic_name == "type_name" || intrinsic_name == "reflect_name") {
            var subject = m.value_first_arg(value_id);
            if (subject == mir_id_invalid()) { subject = m.value_lhs(value_id); }
            if (subject != mir_id_invalid()) {
                return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(subject));
            }
            return mir_cpp_reflect_type_name_expr(m, value_id, m.value_type(value_id));
        }
        return "vyx::intrinsic<" + mir_cpp_type_text(m, m.value_type(value_id)) + ">(" + mir_cpp_quote(intrinsic_name) + ")";
    }
    if (kind == mir_value_const_float()) {
        let float_text = mir_cpp_value_source_text(m, value_id);
        if (float_text.len > 0) { return float_text; }
        return policy_i64_to_string(m.value_int(value_id)) + ".0";
    }
    if (kind == mir_value_arg()) {
        if (m.value_lhs(value_id) != mir_id_invalid()) { return mir_cpp_value_expr(m, m.value_lhs(value_id)); }
        let arg_text = mir_cpp_value_source_text(m, value_id);
        if (arg_text.len > 0 && mir_cpp_type_text(m, m.value_type(value_id)) == "vyx::Str") {
            return "vyx::str_lit(" + mir_cpp_quote(arg_text) + ")";
        }
        return mir_cpp_default_expr(m, m.value_type(value_id));
    }
    return mir_cpp_default_expr(m, m.value_type(value_id));
}

fn mir_cpp_value_expr_for_type(m: MirUnit, value_id: i32, type_id: i32) -> string {
    if (value_id != mir_id_invalid()
        && value_id > 0
        && value_id <= m.value_count
        && type_id == m.value_type(value_id)) {
        return mir_cpp_value_expr(m, value_id);
    }
    let expr = mir_cpp_value_expr(m, value_id);
    let target_ty = mir_cpp_type_text(m, type_id);
    if (expr == "vyx::Any{}" && target_ty != "vyx::Any") {
        return mir_cpp_default_value_for_type(target_ty);
    }
    let source_type_id = m.value_type(value_id);
    let source_ty = mir_cpp_type_text(m, source_type_id);
    if (target_ty == "bool") { return "vyx::truthy(" + expr + ")"; }
    if (source_ty == target_ty) { return expr; }
    if (target_ty == "vyx::Str") {
        let raw_src = mir_cpp_std_string_raw_expr(m, value_id);
        if (raw_src.len > 0) { return raw_src; }
        return "vyx::to_string(" + expr + ")";
    }
    if (target_ty == "void*") {
        if (mir_cpp_type_is_integer_text(source_ty)) {
            return "reinterpret_cast<void*>(static_cast<intptr_t>(" + expr + "))";
        }
        return "vyx::ptr(" + expr + ")";
    }
    if (mir_cpp_type_is_integer_text(target_ty) && source_ty == "void*") {
        return "static_cast<" + target_ty + ">(reinterpret_cast<intptr_t>(" + expr + "))";
    }
    if (m.variant_count_for_type(type_id) > 0 && source_ty != target_ty) {
        return mir_cpp_variant_wrap_expr(m, type_id, expr);
    }
    if (m.variant_count_for_type(source_type_id) > 0 && !target_ty.startsWith("vyx_type_")) {
        return "vyx::any_cast_value<" + target_ty + ">((" + expr + ").payload0)";
    }
    if (target_ty.startsWith("vyx_type_") && source_ty == "void*") {
        return "vyx::deref_or_default<" + target_ty + ">(" + expr + ")";
    }
    if (target_ty.startsWith("vyx_type_") && source_ty.startsWith("vyx_type_")
        && m.field_count_for_type(type_id) == 0) {
        return target_ty + "(" + expr + ")";
    }
    if (target_ty.startsWith("vyx_type_") && source_ty.startsWith("vyx_type_")) {
        let data_field = mir_cpp_type_field_id_by_name(m, source_type_id, "data");
        if (data_field != mir_id_invalid()) {
            let data_ty = mir_cpp_type_text(m, m.field_type(data_field));
            if (data_ty == "void*") {
                return "vyx::deref_or_default<" + target_ty + ">((" + expr + ")."
                    + mir_cpp_field_cpp_name(m, data_field, m.field_index(data_field)) + ")";
            }
        }
    }
    return expr;
}

fn mir_cpp_bool_expr(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid()) { return "false"; }
    let expr = mir_cpp_value_expr(m, value_id);
    return "vyx::truthy(" + expr + ")";
}

fn mir_cpp_foreach_method(m: MirUnit, iterator_value_id: i32, name: string) -> i32 {
    if (iterator_value_id == mir_id_invalid()) { return mir_id_invalid(); }
    let owner_type = mir_cpp_type_source_text(m, m.value_type(iterator_value_id));
    if (owner_type.len == 0) { return mir_id_invalid(); }
    return mir_cpp_find_method_by_owner_method_name(m, owner_type, name);
}

fn mir_cpp_foreach_next_condition(m: MirUnit, iterator_value_id: i32, index_place: i32) -> string {
    let has_next_id = mir_cpp_foreach_method(m, iterator_value_id, "has_next");
    if (has_next_id != mir_id_invalid()) {
        return mir_cpp_function_name(m, has_next_id) + "(" + mir_cpp_value_expr(m, iterator_value_id) + ")";
    }
    if (index_place != mir_id_invalid()) {
        return "vyx::foreach_next(" + mir_cpp_value_expr(m, iterator_value_id)
            + ", " + mir_cpp_place_expr(m, index_place) + ")";
    }
    return "vyx::foreach_next(" + mir_cpp_value_expr(m, iterator_value_id) + ")";
}

fn mir_cpp_foreach_bind_stmt(m: MirUnit, place_id: i32, iterator_value_id: i32, index_place: i32) -> string {
    let next_id = mir_cpp_foreach_method(m, iterator_value_id, "next");
    if (place_id != mir_id_invalid() && next_id != mir_id_invalid()) {
        let tmp = "vyx_foreach_next_" + mir_cpp_i32(place_id) + "_" + mir_cpp_i32(iterator_value_id);
        return "    ([&]() { auto " + tmp + " = " + mir_cpp_function_name(m, next_id) + "("
            + mir_cpp_value_expr(m, iterator_value_id) + "); if (vyx::tag(" + tmp + ") == 0) { "
            + mir_cpp_place_expr(m, place_id) + " = vyx::any_cast_value<"
            + mir_cpp_type_text(m, m.place_type(place_id)) + ">((" + tmp + ").payload0); } }());\n";
    }
    if (place_id != mir_id_invalid() && iterator_value_id != mir_id_invalid()) {
        if (index_place != mir_id_invalid()) {
            return "    vyx::foreach_bind(" + mir_cpp_place_expr(m, place_id) + ", "
                + mir_cpp_value_expr(m, iterator_value_id) + ", " + mir_cpp_place_expr(m, index_place) + ");\n";
        }
        return "    vyx::foreach_bind(" + mir_cpp_place_expr(m, place_id) + ", "
            + mir_cpp_value_expr(m, iterator_value_id) + ");\n";
    }
    return "    /* foreach_bind */\n";
}

fn mir_cpp_value_is_consumed_elsewhere(m: MirUnit, value_id: i32, current_instr_id: i32) -> bool {
    if (value_id == mir_id_invalid()) { return false; }
    var instr_id: i32 = 1;
    while (instr_id <= m.instr_count) {
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && instr_id != current_instr_id
            && m.instr_value(instr_id) == value_id) {
            let kind = m.instr_kind(instr_id);
            if (kind != mir_instr_eval()) { return true; }
        }
        instr_id = instr_id + 1;
    }
    var block_id: i32 = 1;
    while (block_id <= m.block_count) {
        if (!m.block_is_removed( block_id)
            && m.block_term_value(block_id) == value_id) { return true; }
        block_id = block_id + 1;
    }
    var case_id: i32 = 1;
    while (case_id <= m.case_count) {
        if (mir_unit_case_is_active(&m,  case_id)) {
            if (m.case_guard_value(case_id) == value_id) { return true; }
            if (m.case_pattern_value(case_id) == value_id) { return true; }
        }
        case_id = case_id + 1;
    }
    return false;
}

fn mir_cpp_pattern_bind_place(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
    if (m.value_kind(value_id) == mir_value_read_place()) {
        let place_id = m.value_place(value_id);
        if (place_id == mir_id_invalid() || m.place_kind(place_id) != mir_place_local()) {
            return mir_id_invalid();
        }
        let local_id = m.place_local(place_id);
        if (local_id == mir_id_invalid() || m.local_hir_id(local_id) == hir_id_invalid()) {
            return mir_id_invalid();
        }
        return place_id;
    }
    if (m.value_lhs(value_id) != mir_id_invalid()) {
        return mir_cpp_pattern_bind_place(m, m.value_lhs(value_id));
    }
    return mir_id_invalid();
}

fn mir_cpp_match_arm_subject_temp(m: MirUnit, instr_id: i32, subject_id: i32, pattern_id: i32) -> string {
    if (!mir_cpp_match_subject_needs_temp(m, subject_id)) { return ""; }
    let target_block = m.instr_block(instr_id);
    var case_id: i32 = 1;
    while (case_id <= m.case_count) {
        let owner_block = m.case_owner_block(case_id);
        if (mir_unit_case_is_active(&m,  case_id)
            && m.case_target_block(case_id) == target_block
            && m.case_pattern_value(case_id) == pattern_id
            && owner_block != mir_id_invalid()
            && m.block_term_value(owner_block) == subject_id) {
            return "vyx_match_subject_" + mir_cpp_i32(owner_block);
        }
        case_id = case_id + 1;
    }
    return "";
}

fn mir_cpp_match_arm_bindings(m: MirUnit, instr_id: i32) -> string {
    let pattern_id = m.instr_value(instr_id);
    let subject_id = m.instr_rhs(instr_id);
    if (pattern_id == mir_id_invalid() || subject_id == mir_id_invalid()) { return "    /* match_arm */\n"; }
    if (m.value_target_kind(pattern_id) != mir_target_hir_variant()
        && (m.value_lhs(pattern_id) == mir_id_invalid()
            || m.value_target_kind(m.value_lhs(pattern_id)) != mir_target_hir_variant())) {
        return "    /* match_arm */\n";
    }
    var subject = mir_cpp_match_arm_subject_temp(m, instr_id, subject_id, pattern_id);
    if (subject.len == 0) {
        subject = mir_cpp_value_expr_for_type(m, subject_id, m.value_type(pattern_id));
    }
    var out = "    /* match_arm */\n";
    var cur = m.value_first_arg(pattern_id);
    var payload_index: i32 = 0;
    while (cur != mir_id_invalid()) {
        let bind_place = mir_cpp_pattern_bind_place(m, cur);
        if (bind_place != mir_id_invalid()) {
            let ty = mir_cpp_type_text(m, m.place_type(bind_place));
            out = out + "    " + mir_cpp_place_expr(m, bind_place)
                + " = vyx::any_cast_value<" + ty + ">((" + subject + ")."
                + mir_cpp_payload_field_name(payload_index) + ");\n";
        }
        cur = m.value_next_arg(cur);
        payload_index = payload_index + 1;
    }
    return out;
}

fn mir_cpp_value_is_refcount_copy_source(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid()) { return false; }
    if ((m.value_flags(value_id) & mir_value_flag_move_arg()) != 0) { return false; }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_read_place()) { return true; }
    if (kind == mir_value_arg()
        || kind == mir_value_cast()) {
        return mir_cpp_value_is_refcount_copy_source(m, m.value_lhs(value_id));
    }
    return false;
}

fn mir_cpp_refcount_retain_stmt_for_assignment(m: MirUnit, place_id: i32, value_id: i32) -> string {
    if (!mir_cpp_value_is_refcount_copy_source(m, value_id)) { return ""; }
    if (place_id == mir_id_invalid() || m.place_kind(place_id) != mir_place_local()) { return ""; }
    let local_id = m.place_local(place_id);
    if (local_id == mir_id_invalid()
        || (m.local_flags(local_id) & mir_local_flag_auto_drop()) == 0) {
        return "";
    }
    if (m.value_kind(value_id) == mir_value_read_place()
        && m.value_place(value_id) == place_id) {
        return "";
    }
    let kind = mir_cpp_type_refcount_handle_kind(m, m.place_type(place_id));
    if (kind == "strong") {
        return "    vyx::retain_strong((" + mir_cpp_place_expr(m, place_id) + ").rc);\n";
    }
    if (kind == "weak") {
        return "    vyx::retain_weak((" + mir_cpp_place_expr(m, place_id) + ").rc);\n";
    }
    return "";
}

fn mir_cpp_type_is_dci_stub_class(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    if (mir_cpp_type_kind(m, type_id) != ty_CLASS()) { return false; }
    return mir_cpp_dci_stub_base_for(m, mir_cpp_type_source_text(m, type_id)).len > 0;
}

fn mir_cpp_dci_stub_direct_foreign_base(m: MirUnit, type_id: i32) -> string {
    if (!mir_cpp_type_is_dci_stub_class(m, type_id)) { return ""; }
    let base = mir_cpp_dci_stub_base_for(m, mir_cpp_type_source_text(m, type_id));
    if (base.len == 0 || mir_cpp_dci_stub_base_for(m, base).len > 0) { return ""; }
    if (mir_cpp_dci_layout_for_name(m, base) == null) { return ""; }
    return base;
}

fn mir_cpp_dci_stub_field_offset(m: MirUnit, type_id: i32, field_id: i32) -> i64 {
    if (field_id == mir_id_invalid()) { return -1; }
    let base = mir_cpp_dci_stub_direct_foreign_base(m, type_id);
    if (base.len == 0) { return -1; }
    let layout = mir_cpp_dci_layout_for_name(m, base);
    let field_name = mir_cpp_field_source_name(m, field_id);
    let field = mir_cpp_dci_field_object(m, layout, field_name, 0);
    if (mir_cpp_dci_field_match_count(m, layout, field_name, 0) != 1
        || field == null
        || !mir_cpp_dci_type_object_matches(
            m, mir_cpp_dci_json_item(field, "type"), m.field_type(field_id))) {
        return -1;
    }
    return mir_cpp_dci_field_offset(m, layout, field_name, 0);
}

// Consumer state belongs to the generated native subclass. The producer's
// compiler chooses its position after the foreign base; no Vyx offset is used.
// Owned aggregates require a separate destruction protocol and are rejected.
fn mir_cpp_dci_stub_state_field_supported(m: MirUnit, type_id: i32, field_id: i32) -> bool {
    let base = mir_cpp_dci_stub_direct_foreign_base(m, type_id);
    if (base.len == 0) { return false; }
    let layout = mir_cpp_dci_layout_for_name(m, base);
    if (mir_cpp_dci_field_match_count(m, layout, mir_cpp_field_source_name(m, field_id), 0) != 0) {
        return false;
    }
    let kind = mir_cpp_type_kind(m, m.field_type(field_id));
    return kind == ty_BOOL() || kind == ty_CHAR() || kind == ty_I8() || kind == ty_U8()
        || kind == ty_I16() || kind == ty_U16() || kind == ty_I32() || kind == ty_U32()
        || kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
        || kind == ty_F32() || kind == ty_F64() || kind == ty_RAWPTR() || kind == ty_PTR();
}

fn mir_cpp_emit_dci_stub_state(m: MirUnit, derived: string, accessors: bool) -> string {
    let type_id = mir_cpp_find_type_by_source_text(m, derived);
    if (type_id == mir_id_invalid()) { return ""; }
    var out = "";
    var index: i32 = 0;
    while (index < m.field_count_for_type(type_id)) {
        let field_id = m.field_id_for_type_index(type_id, index);
        if (mir_cpp_dci_stub_state_field_supported(m, type_id, field_id)) {
            let field = policy_mangle_part(mir_cpp_field_source_name(m, field_id));
            if (accessors) {
                out = out + "extern \"C\" void* __dci_stub_field_" + policy_mangle_part(derived)
                    + "_" + field + "(void* p) noexcept { return static_cast<"
                    + mir_cpp_dci_stub_class_name(derived) + "*>(p)->__vyx_state_" + field + "; }\n";
            } else {
                let field_type = m.field_type(field_id);
                var size = mir_cpp_lower_type_size_for_type(m, field_type, 0);
                // Consumer state stores Vyx values. A typed Vyx pointer owns
                // an address plus region metadata, unlike a C++ ABI pointer.
                if (mir_cpp_type_kind(m, field_type) == ty_PTR()) { size = 16; }
                let alignment = mir_cpp_lower_type_align_for_type(m, field_type, 0);
                out = out + "    alignas(" + policy_i64_to_string(alignment)
                    + ") unsigned char __vyx_state_" + field + "[" + policy_i64_to_string(size) + "]{};\n";
            }
        }
        index = index + 1;
    }
    return out;
}

fn mir_cpp_has_dci_stub_classes(m: MirUnit) -> bool {
    let rows = mir_unit_dci_stub_specs(&m);
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) { split = true; }
        else if (rows.charAt(i) == 10) { split = true; }
        if (split) {
            let line = rows.substring(start, i).trim();
            if (mir_cpp_dci_stub_spec_field(line, 0) == "class") { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn mir_cpp_dci_ctor_call_value(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) {
        return mir_id_invalid();
    }
    if (m.value_kind(value_id) == mir_value_call()) {
        let function_id = mir_cpp_call_target_function_id(m, value_id);
        if (function_id != mir_id_invalid()
            && mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) {
            return value_id;
        }
    }
    if (m.value_kind(value_id) == mir_value_cast()
        || m.value_kind(value_id) == mir_value_arg()) {
        return mir_cpp_dci_ctor_call_value(m, m.value_lhs(value_id));
    }
    return mir_id_invalid();
}

fn mir_cpp_dci_coerce_return_call_value(m: MirUnit, value_id: i32) -> i32 {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) {
        return mir_id_invalid();
    }
    if (m.value_kind(value_id) == mir_value_call()) {
        let function_id = mir_cpp_call_target_function_id(m, value_id);
        if (function_id != mir_id_invalid()
            && mir_unit_function_is_foreign_dci(&m,  function_id)) {
            let lowering = mir_cpp_dci_json_item(
                mir_cpp_dci_abi_object(m, function_id), "return");
            if (mir_cpp_dci_lowering_passing(lowering) == "coerce") { return value_id; }
        }
    }
    if (m.value_kind(value_id) == mir_value_cast()
        || m.value_kind(value_id) == mir_value_arg()) {
        return mir_cpp_dci_coerce_return_call_value(m, m.value_lhs(value_id));
    }
    return mir_id_invalid();
}

fn mir_cpp_dci_coerce_return_assignment_matches_type(m: MirUnit,
                                                      value_id: i32,
                                                      type_id: i32) -> bool {
    let call_value = mir_cpp_dci_coerce_return_call_value(m, value_id);
    if (call_value == mir_id_invalid()) { return false; }
    let function_id = mir_cpp_call_target_function_id(m, call_value);
    if (function_id == mir_id_invalid()) { return false; }
    let return_type = m.function_return_type(function_id);
    let lowering = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "return");
    return mir_cpp_dci_contract_type_names_match(
               mir_cpp_type_source_text(m, return_type), mir_cpp_type_source_text(m, type_id))
        && mir_cpp_dci_coerce_supported(m, lowering, return_type);
}

fn mir_cpp_dci_ctor_assignment_stmt(m: MirUnit, instr_id: i32) -> string {
    let call_value = mir_cpp_dci_ctor_call_value(m, m.instr_value(instr_id));
    if (call_value == mir_id_invalid()) { return ""; }
    let function_id = mir_cpp_call_target_function_id(m, call_value);
    if (function_id == mir_id_invalid() || mir_cpp_dci_link_name(m, function_id).len == 0) { return ""; }
    let place = m.instr_place(instr_id);
    if (place == mir_id_invalid()) { return ""; }
    var args = "reinterpret_cast<void*>(&(" + mir_cpp_place_expr(m, place) + "))";
    let explicit_args = mir_cpp_dci_call_args(m, function_id, m.value_first_arg(call_value));
    if (explicit_args.len > 0) { args = args + ", " + explicit_args; }
    return "    " + mir_cpp_dci_alias_name(function_id) + "(" + args + ");\n";
}

fn mir_cpp_dci_destructor_for_type(m: MirUnit, type_id: i32) -> i32 {
    if (type_id == mir_id_invalid() || !mir_unit_type_is_foreign_dci(&m,  type_id)) {
        return mir_id_invalid();
    }
    let wanted = mir_cpp_type_source_text(m, type_id);
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_unit_function_is_foreign_dci_dtor(&m,  function_id)
            && mir_cpp_dci_contract_type_names_match(mir_unit_foreign_dci_owner_type_text(&m,  function_id), wanted)) {
            return function_id;
        }
        function_id = function_id + 1;
    }
    return mir_id_invalid();
}

fn mir_cpp_dci_free_drop_arg(m: MirUnit,
                             function_id: i32,
                             place_id: i32,
                             value_id: i32) -> string {
    if (mir_unit_function_param_count(&m,  function_id) != 1) { return ""; }
    let local = mir_unit_function_param_local_at(&m,  function_id, 0);
    if (local == mir_id_invalid()) { return ""; }
    let param_type = mir_cpp_type_text(m, m.local_type(local));
    var address = "";
    if (place_id != mir_id_invalid()) {
        address = "&(" + mir_cpp_place_expr(m, place_id) + ")";
    } else if (value_id != mir_id_invalid()) {
        if (mir_cpp_value_type_is_pointer_like(m, value_id)) {
            address = mir_cpp_value_expr(m, value_id);
        } else {
            address = "&(" + mir_cpp_value_expr(m, value_id) + ")";
        }
    }
    if (address.len == 0) { return ""; }
    return "reinterpret_cast<" + param_type + ">(" + address + ")";
}

fn mir_cpp_dci_stub_drop_stmt(m: MirUnit, instr_id: i32) -> string {
    let place_id = m.instr_place(instr_id);
    if (place_id == mir_id_invalid()) { return ""; }
    let type_id = m.place_type(place_id);
    if (!mir_cpp_type_is_dci_stub_class(m, type_id)) { return ""; }
    let place = mir_cpp_place_expr(m, place_id);
    let destroy = mir_cpp_dci_stub_destroy_symbol(mir_cpp_type_source_text(m, type_id));
    return "    if (" + place + " != nullptr) { " + destroy + "(" + place
        + "); " + place + " = nullptr; }\n";
}

fn mir_cpp_dci_drop_stmt(m: MirUnit, instr_id: i32) -> string {
    let value_id = m.instr_value(instr_id);
    var function_id = mir_id_invalid();
    if (m.instr_target_kind(instr_id) == mir_target_function()) {
        let explicit_target = m.instr_target_id(instr_id);
        if (explicit_target != mir_id_invalid()
            && mir_unit_function_is_foreign_dci(&m,  explicit_target)) {
            function_id = explicit_target;
        }
    }
    if (function_id == mir_id_invalid() && value_id != mir_id_invalid()) {
        function_id = mir_cpp_dci_destructor_for_type(m, m.value_type(value_id));
    }
    let place_id = m.instr_place(instr_id);
    if (function_id == mir_id_invalid() && place_id != mir_id_invalid()) {
        function_id = mir_cpp_dci_destructor_for_type(m, m.place_type(place_id));
    }
    if (function_id == mir_id_invalid() || mir_cpp_dci_link_name(m, function_id).len == 0) { return ""; }
    if (mir_unit_function_is_foreign_dci_free_function(&m,  function_id)) {
        let arg = mir_cpp_dci_free_drop_arg(m, function_id, place_id, value_id);
        if (arg.len == 0) { return ""; }
        return "    " + mir_cpp_dci_alias_name(function_id) + "(" + arg + ");\n";
    }
    if (value_id != mir_id_invalid()) {
        let call = mir_cpp_dci_direct_call_expr(m, function_id, value_id, "");
        if (call.len > 0) { return "    " + call + ";\n"; }
    }
    if (place_id != mir_id_invalid()) {
        let receiver = mir_cpp_dci_place_receiver_pointer_expr(m, function_id, place_id);
        if (receiver.len > 0) {
            return "    " + mir_cpp_dci_alias_name(function_id) + "(" + receiver + ");\n";
        }
    }
    return "";
}

// This first scope-narrowing slice deliberately accepts only a small,
// block-local subset.  The flattened C++ backend uses goto labels, so a
// StorageLive/StorageDead pair that crosses blocks needs a structured CFG
// region proof before it can become a C++ lexical scope.
fn mir_cpp_local_scope_max_function_locals() -> i32 { return 256; }

fn mir_cpp_local_scope_type_is_primitive(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_BOOL() || kind == ty_CHAR()) { return true; }
    if (kind == ty_I8() || kind == ty_U8() || kind == ty_I16() || kind == ty_U16()) { return true; }
    if (kind == ty_I32() || kind == ty_U32() || kind == ty_I64() || kind == ty_U64()) { return true; }
    if (kind == ty_ISIZE() || kind == ty_USIZE()) { return true; }
    if (kind == ty_F32() || kind == ty_F64()) { return true; }
    return kind == ty_RAWPTR();
}

fn mir_cpp_local_scope_direct_local_place(m: MirUnit, place_id: i32, local_id: i32) -> bool {
    return place_id != mir_id_invalid()
        && place_id > 0
        && place_id <= m.place_count
        && m.place_kind(place_id) == mir_place_local()
        && m.place_local(place_id) == local_id;
}

// Return true for malformed or aggregate places as well.  Those are a
// conservative barrier for this scalar-only slice, not a claim that they
// necessarily reference `local_id`.
fn mir_cpp_local_scope_value_uses_local(m: MirUnit,
                                        value_id: i32,
                                        local_id: i32,
                                        depth: i32) -> bool {
    if (value_id == mir_id_invalid()) { return false; }
    if (value_id <= 0 || value_id > m.value_count || depth > 32) { return true; }
    let place_id = m.value_place(value_id);
    if (place_id != mir_id_invalid()) {
        if (place_id <= 0 || place_id > m.place_count || m.place_kind(place_id) != mir_place_local()) {
            return true;
        }
        if (m.place_local(place_id) == local_id) { return true; }
    }
    if (mir_cpp_local_scope_value_uses_local(m, m.value_lhs(value_id), local_id, depth + 1)) { return true; }
    if (mir_cpp_local_scope_value_uses_local(m, m.value_rhs(value_id), local_id, depth + 1)) { return true; }
    if (mir_cpp_local_scope_value_uses_local(m, m.value_aux(value_id), local_id, depth + 1)) { return true; }
    var arg_id = m.value_first_arg(value_id);
    var guard: i32 = 0;
    while (arg_id != mir_id_invalid()) {
        if (guard > m.value_count
            || mir_cpp_local_scope_value_uses_local(m, arg_id, local_id, depth + 1)) {
            return true;
        }
        arg_id = m.value_next_arg(arg_id);
        guard = guard + 1;
    }
    return false;
}

fn mir_cpp_local_scope_value_is_simple(m: MirUnit, value_id: i32, depth: i32) -> bool {
    if (value_id == mir_id_invalid()) { return true; }
    if (value_id <= 0 || value_id > m.value_count || depth > 32
        || !mir_cpp_local_scope_type_is_primitive(m, m.value_type(value_id))) {
        return false;
    }
    if (m.value_first_arg(value_id) != mir_id_invalid()
        || m.value_next_arg(value_id) != mir_id_invalid()) {
        return false;
    }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_const_int() || kind == mir_value_const_bool()
        || kind == mir_value_const_char() || kind == mir_value_null()
        || kind == mir_value_const_float()) {
        return true;
    }
    if (kind == mir_value_read_place()) {
        let place_id = m.value_place(value_id);
        return place_id != mir_id_invalid()
            && place_id > 0
            && place_id <= m.place_count
            && m.place_kind(place_id) == mir_place_local()
            && mir_cpp_local_scope_type_is_primitive(m, m.place_type(place_id));
    }
    if (kind == mir_value_unary() || kind == mir_value_cast() || kind == mir_value_arg()) {
        return mir_cpp_local_scope_value_is_simple(m, m.value_lhs(value_id), depth + 1)
            && m.value_rhs(value_id) == mir_id_invalid()
            && m.value_aux(value_id) == mir_id_invalid();
    }
    if (kind == mir_value_binary()) {
        return mir_cpp_local_scope_value_is_simple(m, m.value_lhs(value_id), depth + 1)
            && mir_cpp_local_scope_value_is_simple(m, m.value_rhs(value_id), depth + 1)
            && m.value_aux(value_id) == mir_id_invalid();
    }
    return false;
}

fn mir_cpp_local_scope_instr_mentions_local(m: MirUnit, instr_id: i32, local_id: i32) -> bool {
    let place_id = m.instr_place(instr_id);
    if (place_id != mir_id_invalid()) {
        if (place_id <= 0 || place_id > m.place_count || m.place_kind(place_id) != mir_place_local()) {
            return true;
        }
        if (m.place_local(place_id) == local_id) { return true; }
    }
    return mir_cpp_local_scope_value_uses_local(m, m.instr_value(instr_id), local_id, 0)
        || mir_cpp_local_scope_value_uses_local(m, m.instr_lhs(instr_id), local_id, 0)
        || mir_cpp_local_scope_value_uses_local(m, m.instr_rhs(instr_id), local_id, 0);
}

fn mir_cpp_local_scope_instr_is_supported(m: MirUnit,
                                           instr_id: i32,
                                           local_id: i32,
                                           live_instr: i32,
                                           dead_instr: i32) -> bool {
    let kind = m.instr_kind(instr_id);
    if (instr_id == live_instr) {
        return kind == mir_instr_storage_live()
            && mir_cpp_local_scope_direct_local_place(m, m.instr_place(instr_id), local_id);
    }
    if (instr_id == dead_instr) {
        return kind == mir_instr_storage_dead()
            && mir_cpp_local_scope_direct_local_place(m, m.instr_place(instr_id), local_id);
    }
    if (kind == mir_instr_eval()) {
        return mir_cpp_local_scope_value_is_simple(m, m.instr_value(instr_id), 0)
            && mir_cpp_local_scope_value_is_simple(m, m.instr_lhs(instr_id), 0)
            && mir_cpp_local_scope_value_is_simple(m, m.instr_rhs(instr_id), 0);
    }
    if (kind != mir_instr_assign()
        || m.instr_target_kind(instr_id) != mir_target_none()
        || m.instr_target_id(instr_id) != mir_id_invalid()) {
        return false;
    }
    let place_id = m.instr_place(instr_id);
    if (place_id == mir_id_invalid() || place_id <= 0 || place_id > m.place_count
        || m.place_kind(place_id) != mir_place_local()
        || !mir_cpp_local_scope_type_is_primitive(m, m.place_type(place_id))) {
        return false;
    }
    if (mir_cpp_question_source_value(m, m.instr_value(instr_id)) != mir_id_invalid()) { return false; }
    return mir_cpp_local_scope_value_is_simple(m, m.instr_value(instr_id), 0)
        && mir_cpp_local_scope_value_is_simple(m, m.instr_lhs(instr_id), 0)
        && mir_cpp_local_scope_value_is_simple(m, m.instr_rhs(instr_id), 0);
}

fn mir_cpp_local_scope_function_is_small(m: MirUnit, function_id: i32) -> bool {
    var local_id = m.function_first_local(function_id);
    var count: i32 = 0;
    while (local_id != mir_id_invalid()) {
        if (local_id <= 0 || local_id > m.local_count || m.local_function(local_id) != function_id) {
            return false;
        }
        count = count + 1;
        if (count > mir_cpp_local_scope_max_function_locals()) { return false; }
        local_id = m.local_next(local_id);
    }
    return true;
}

fn mir_cpp_local_scope_local_is_candidate(m: MirUnit, function_id: i32, local_id: i32) -> bool {
    if (local_id == mir_id_invalid() || local_id <= 0 || local_id > m.local_count
        || m.local_function(local_id) != function_id
        || m.local_hir_id(local_id) == hir_id_invalid()
        || !mir_cpp_local_scope_type_is_primitive(m, m.local_type(local_id))) {
        return false;
    }
    let flags = m.local_flags(local_id);
    if ((flags & mir_local_flag_param()) != 0
        || (flags & mir_local_flag_capture()) != 0
        || (flags & mir_local_flag_reference_capture()) != 0
        || (flags & mir_local_flag_auto_drop()) != 0
        || (flags & mir_local_flag_move_arg()) != 0
        || (flags & mir_local_flag_self_receiver()) != 0
        || (flags & mir_local_flag_if_expr_result()) != 0
        || !mir_cpp_local_scope_direct_local_place(m, m.local_place(local_id), local_id)) {
        return false;
    }

    var live_instr = mir_id_invalid();
    var dead_instr = mir_id_invalid();
    var live_block = mir_id_invalid();
    var dead_block = mir_id_invalid();
    var block_id = m.function_first_block(function_id);
    var block_guard: i32 = 0;
    while (block_id != mir_id_invalid()) {
        if (block_id <= 0 || block_id > m.block_count
            || m.block_function(block_id) != function_id
            || m.block_is_removed( block_id)) {
            return false;
        }
        var instr_id = m.block_first_instr(block_id);
        var instr_guard: i32 = 0;
        while (instr_id != mir_id_invalid()) {
            if (instr_id <= 0 || instr_id > m.instr_count
                || m.instr_function(instr_id) != function_id
                || m.instr_block(instr_id) != block_id) {
                return false;
            }
            if (mir_cpp_local_scope_direct_local_place(m, m.instr_place(instr_id), local_id)) {
                if (m.instr_kind(instr_id) == mir_instr_storage_live()) {
                    if (live_instr != mir_id_invalid()) { return false; }
                    live_instr = instr_id;
                    live_block = block_id;
                } else if (m.instr_kind(instr_id) == mir_instr_storage_dead()) {
                    if (dead_instr != mir_id_invalid()) { return false; }
                    dead_instr = instr_id;
                    dead_block = block_id;
                }
            }
            instr_id = m.instr_next(instr_id);
            instr_guard = instr_guard + 1;
            if (instr_guard > m.instr_count + 1) { return false; }
        }
        block_id = m.block_next(block_id);
        block_guard = block_guard + 1;
        if (block_guard > m.block_count + 1) { return false; }
    }
    if (live_instr == mir_id_invalid() || dead_instr == mir_id_invalid() || live_block != dead_block) {
        return false;
    }

    block_id = m.function_first_block(function_id);
    block_guard = 0;
    while (block_id != mir_id_invalid()) {
        var instr_id2 = m.block_first_instr(block_id);
        var instr_guard2: i32 = 0;
        var phase: i32 = 0;
        while (instr_id2 != mir_id_invalid()) {
            let mentions = mir_cpp_local_scope_instr_mentions_local(m, instr_id2, local_id);
            if (block_id == live_block) {
                if (instr_id2 == live_instr) {
                    if (phase != 0 || !mir_cpp_local_scope_instr_is_supported(
                        m, instr_id2, local_id, live_instr, dead_instr)) { return false; }
                    phase = 1;
                } else if (phase == 1) {
                    if (!mir_cpp_local_scope_instr_is_supported(
                        m, instr_id2, local_id, live_instr, dead_instr)) { return false; }
                    if (instr_id2 == dead_instr) { phase = 2; }
                } else if (mentions) {
                    return false;
                }
            } else if (mentions) {
                return false;
            }
            instr_id2 = m.instr_next(instr_id2);
            instr_guard2 = instr_guard2 + 1;
            if (instr_guard2 > m.instr_count + 1) { return false; }
        }
        if (block_id == live_block && phase != 2) { return false; }
        let term_value = m.block_term_value(block_id);
        if (mir_cpp_local_scope_value_uses_local(m, term_value, local_id, 0)) { return false; }
        block_id = m.block_next(block_id);
        block_guard = block_guard + 1;
        if (block_guard > m.block_count + 1) { return false; }
    }
    var case_id: i32 = 1;
    while (case_id <= m.case_count) {
        let owner = m.case_owner_block(case_id);
        if (owner != mir_id_invalid() && owner > 0 && owner <= m.block_count
            && m.block_function(owner) == function_id
            && (mir_cpp_local_scope_value_uses_local(m, m.case_pattern_value(case_id), local_id, 0)
                || mir_cpp_local_scope_value_uses_local(m, m.case_guard_value(case_id), local_id, 0))) {
            return false;
        }
        case_id = case_id + 1;
    }
    return true;
}

class MirCppLocalScopePlan {
    public function_id: i32
    public scoped_locals: string

    public static fn create(function_id: i32) -> MirCppLocalScopePlan {
        return MirCppLocalScopePlan { function_id: function_id, scoped_locals: "" };
    }

    public fn contains(self, local_id: i32) -> bool {
        return mir_cpp_id_set_contains(self.scoped_locals, local_id);
    }
}

fn mir_cpp_build_local_scope_plan(m: MirUnit, function_id: i32) -> MirCppLocalScopePlan {
    var plan = MirCppLocalScopePlan.create(function_id);
    if (!mir_cpp_local_scope_function_is_small(m, function_id)) { return plan; }
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if (mir_cpp_local_scope_local_is_candidate(m, function_id, local_id)) {
            plan.scoped_locals = plan.scoped_locals + mir_cpp_id_set_key(local_id);
        }
        local_id = m.local_next(local_id);
    }
    return plan;
}

fn mir_cpp_emit_instr_with_local_scope(m: MirUnit,
                                        instr_id: i32,
                                        scopes: MirCppLocalScopePlan) -> string {
    let kind = m.instr_kind(instr_id);
    let place_id = m.instr_place(instr_id);
    if ((kind == mir_instr_storage_live() || kind == mir_instr_storage_dead())
        && place_id != mir_id_invalid()
        && place_id > 0
        && place_id <= m.place_count
        && m.place_kind(place_id) == mir_place_local()) {
        let local_id = m.place_local(place_id);
        if (scopes.contains(local_id)) {
            if (kind == mir_instr_storage_live()) {
                var ty = mir_cpp_type_text(m, m.local_type(local_id));
                if ((m.local_flags(local_id) & mir_local_flag_volatile()) != 0) {
                    ty = "volatile " + ty;
                }
                return "    {\n        " + ty + " " + mir_cpp_local_name(m, local_id)
                    + " = " + mir_cpp_default_value_for_type(ty) + ";\n"
                    + "        /* storage_live " + mir_cpp_instr_source_name(m, instr_id) + " */\n";
            }
            return "        /* storage_dead " + mir_cpp_instr_source_name(m, instr_id) + " */\n    }\n";
        }
    }
    return mir_cpp_emit_instr(m, instr_id);
}

fn mir_cpp_llvm_compatible_aggregate_store_stmt(m: MirUnit, instr_id: i32) -> string {
    let place_id = m.instr_place(instr_id);
    let value_id = m.instr_value(instr_id);
    if (place_id == mir_id_invalid() || value_id == mir_id_invalid()
        || value_id <= 0 || value_id > m.value_count
        || m.value_kind(value_id) != mir_value_cast()) {
        return "";
    }
    let source_value = m.value_lhs(value_id);
    if (source_value == mir_id_invalid() || source_value <= 0 || source_value > m.value_count) { return ""; }
    let source_type = m.value_type(source_value);
    if (source_type == mir_id_invalid() || source_type <= 0 || source_type > m.types.count) { return ""; }
    let source_kind = mir_cpp_type_kind(m, source_type);
    if (source_kind != ty_ARRAY() && source_kind != ty_TUPLE()) { return ""; }
    if (m.place_type(place_id) == source_type) { return ""; }
    let temp = "vyx_aggregate_store_" + mir_cpp_i32(instr_id);
    return "    { auto " + temp + " = " + mir_cpp_value_expr(m, source_value)
        + "; std::memcpy(static_cast<void*>(&(" + mir_cpp_place_expr(m, place_id)
        + ")), static_cast<const void*>(&" + temp + "), sizeof("
        + mir_cpp_type_text(m, source_type) + ")); }\n";
}

fn mir_cpp_emit_instr(m: MirUnit, instr_id: i32) -> string {
    let kind = m.instr_kind(instr_id);
    if (kind == mir_instr_eval()) {
        let value_id = m.instr_value(instr_id);
        if (value_id == mir_id_invalid()) { return ""; }
        if (mir_cpp_value_is_consumed_elsewhere(m, value_id, instr_id)) { return ""; }
        return "    " + mir_cpp_value_expr(m, m.instr_value(instr_id)) + ";\n";
    }
    if (kind == mir_instr_assign()) {
        let dci_ctor = mir_cpp_dci_ctor_assignment_stmt(m, instr_id);
        if (dci_ctor.len > 0) { return dci_ctor; }
        // LLVM lower_value_as preserves an aggregate value when the MIR cast
        // target is scalar and its generic cast fallback cannot transform the
        // aggregate. The subsequent LLVM store therefore copies the complete
        // aggregate to the destination address. Reproduce that byte-for-byte
        // store in C++ instead of generating an ill-formed static_cast from
        // std::array/std::tuple to a scalar.
        let aggregate_store = mir_cpp_llvm_compatible_aggregate_store_stmt(m, instr_id);
        if (aggregate_store.len > 0) { return aggregate_store; }
        let question_source = mir_cpp_question_source_value(m, m.instr_value(instr_id));
        if (question_source != mir_id_invalid()) {
            let tmp = "vyx_try_" + mir_cpp_i32(instr_id);
            var out = "    auto " + tmp + " = " + mir_cpp_value_expr(m, question_source) + ";\n";
            out = out + mir_cpp_emit_try_guard(m,
                                               m.value_type(question_source),
                                               m.function_return_type(m.instr_function(instr_id)),
                                               tmp);
            out = out + "    " + mir_cpp_place_expr(m, m.instr_place(instr_id)) + " = "
                + mir_cpp_try_success_expr(m, m.instr_value(instr_id), m.place_type(m.instr_place(instr_id)), tmp)
                + ";\n";
            out = out + mir_cpp_refcount_retain_stmt_for_assignment(m, m.instr_place(instr_id), m.instr_value(instr_id));
            return out;
        }
        var assign_out = "    " + mir_cpp_place_expr(m, m.instr_place(instr_id)) + " = "
               + mir_cpp_value_expr_for_type(m, m.instr_value(instr_id), m.place_type(m.instr_place(instr_id))) + ";\n";
        assign_out = assign_out + mir_cpp_refcount_retain_stmt_for_assignment(m, m.instr_place(instr_id), m.instr_value(instr_id));
        return assign_out;
    }
    if (kind == mir_instr_storage_live()) {
        return "    /* storage_live " + mir_cpp_instr_source_name(m, instr_id) + " */\n";
    }
    // Keep MIR lifetime metadata out of C++ scope/destructor semantics. Real
    // destruction is emitted only for mir_instr_drop().
    if (kind == mir_instr_storage_dead()) {
        return "    /* storage_dead " + mir_cpp_instr_source_name(m, instr_id) + " */\n";
    }
    if (kind == mir_instr_static_assert()) {
        return "    if (!(" + mir_cpp_bool_expr(m, m.instr_value(instr_id)) + ")) { vyx::panic(\"static_assert failed\"); }\n";
    }
    if (kind == mir_instr_defer()) {
        let value_id = m.instr_value(instr_id);
        if (value_id == mir_id_invalid()) { return "    /* empty defer */\n"; }
        return "    auto vyx_defer_" + mir_cpp_i32(instr_id) + " = vyx::defer([&]() { "
            + mir_cpp_value_expr(m, value_id) + "; });\n";
    }
    if (kind == mir_instr_foreach_bind()) {
        let place_id = m.instr_place(instr_id);
        let value_id2 = m.instr_value(instr_id);
        let index_place = m.instr_aux(instr_id);
        return mir_cpp_foreach_bind_stmt(m, place_id, value_id2, index_place);
    }
    if (kind == mir_instr_match_arm()) {
        let bindings = mir_cpp_match_arm_bindings(m, instr_id);
        let dst = m.instr_place(instr_id);
        let val = m.instr_value(instr_id);
        if (dst != mir_id_invalid() && val != mir_id_invalid()) {
            return bindings + "    " + mir_cpp_place_expr(m, dst) + " = " + mir_cpp_value_expr(m, val) + ";\n";
        }
        return bindings;
    }
    if (kind == mir_instr_drop()) {
        let dci_stub_drop = mir_cpp_dci_stub_drop_stmt(m, instr_id);
        if (dci_stub_drop.len > 0) { return dci_stub_drop; }
        let dci_drop = mir_cpp_dci_drop_stmt(m, instr_id);
        if (dci_drop.len > 0) { return dci_drop; }
        if (m.instr_target_kind(instr_id) == mir_target_function()
            && m.instr_target_id(instr_id) != mir_id_invalid()
            && m.instr_place(instr_id) != mir_id_invalid()) {
            return "    " + mir_cpp_function_name(m, m.instr_target_id(instr_id))
                + "(" + mir_cpp_place_expr(m, m.instr_place(instr_id)) + ");\n";
        }
        return "    vyx::drop(" + mir_cpp_value_expr(m, m.instr_value(instr_id)) + ");\n";
    }
    return "    /* unknown MIR instr kind " + mir_cpp_i32(kind) + " */\n";
}

fn mir_cpp_match_pattern_is_default(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid()) { return true; }
    if (m.value_kind(value_id) == mir_value_null()
        && mir_cpp_value_source_name(m, value_id) == "__match_default") {
        return true;
    }
    return false;
}

fn mir_cpp_match_subject_needs_temp(m: MirUnit, subject_id: i32) -> bool {
    if (subject_id == mir_id_invalid()) { return false; }
    let kind = m.value_kind(subject_id);
    if (kind == mir_value_read_place()
        || kind == mir_value_const_int()
        || kind == mir_value_const_bool()
        || kind == mir_value_const_str()
        || kind == mir_value_const_char()
        || kind == mir_value_null()) {
        return false;
    }
    return true;
}

fn mir_cpp_match_subject_expr(m: MirUnit, subject_id: i32, subject_expr: string) -> string {
    if (subject_expr.len > 0) { return subject_expr; }
    return mir_cpp_value_expr(m, subject_id);
}

fn mir_cpp_match_condition_for_subject(m: MirUnit, subject_id: i32, pattern_id: i32, subject_expr: string) -> string {
    if (mir_cpp_match_pattern_is_default(m, pattern_id)) { return "true"; }
    let subject = mir_cpp_match_subject_expr(m, subject_id, subject_expr);
    if (subject_id != mir_id_invalid()) {
        let subject_type = m.value_type(subject_id);
        if (subject_type != mir_id_invalid()
            && m.variant_count_for_type(subject_type) > 0
            && m.value_kind(pattern_id) == mir_value_const_int()) {
            return "vyx::tag(" + subject + ") == " + policy_i64_to_string(m.value_int(pattern_id));
        }
    }
    if (m.value_target_kind(pattern_id) == mir_target_hir_variant()) {
        let variant_id = m.value_target_id(pattern_id);
        var variant_subject = subject_expr;
        if (variant_subject.len == 0) { variant_subject = mir_cpp_value_expr_for_type(m, subject_id, m.value_type(pattern_id)); }
        return "(vyx::tag(" + variant_subject + ") == " + mir_cpp_i32(m.variant_tag(variant_id))
            + mir_cpp_match_condition_payload_binds(m, pattern_id, variant_subject) + ")";
    }
    if (m.value_kind(pattern_id) == mir_value_call()
        && m.value_lhs(pattern_id) != mir_id_invalid()
        && m.value_target_kind(m.value_lhs(pattern_id)) == mir_target_hir_variant()) {
        let variant_id2 = m.value_target_id(m.value_lhs(pattern_id));
        var variant_subject2 = subject_expr;
        if (variant_subject2.len == 0) { variant_subject2 = mir_cpp_value_expr_for_type(m, subject_id, m.value_type(pattern_id)); }
        return "(vyx::tag(" + variant_subject2 + ") == " + mir_cpp_i32(m.variant_tag(variant_id2))
            + mir_cpp_match_condition_payload_binds(m, pattern_id, variant_subject2) + ")";
    }
    let bind_place = mir_cpp_pattern_bind_place(m, pattern_id);
    if (bind_place != mir_id_invalid()) {
        var bind_subject = subject_expr;
        if (bind_subject.len == 0) { bind_subject = mir_cpp_value_expr_for_type(m, subject_id, m.place_type(bind_place)); }
        return "((" + mir_cpp_place_expr(m, bind_place) + " = "
            + bind_subject + "), true)";
    }
    return "(" + subject + " == " + mir_cpp_value_expr(m, pattern_id) + ")";
}

fn mir_cpp_match_condition(m: MirUnit, subject_id: i32, pattern_id: i32) -> string {
    return mir_cpp_match_condition_for_subject(m, subject_id, pattern_id, "");
}

fn mir_cpp_match_condition_payload_binds(m: MirUnit, pattern_id: i32, subject_expr: string) -> string {
    var out = "";
    var cur = m.value_first_arg(pattern_id);
    var payload_index: i32 = 0;
    while (cur != mir_id_invalid()) {
        let bind_place = mir_cpp_pattern_bind_place(m, cur);
        if (bind_place != mir_id_invalid()) {
            let ty = mir_cpp_type_text(m, m.place_type(bind_place));
            out = out + " && ((" + mir_cpp_place_expr(m, bind_place)
                + " = vyx::any_cast_value<" + ty + ">((" + subject_expr + ")."
                + mir_cpp_payload_field_name(payload_index) + ")), true)";
        }
        cur = m.value_next_arg(cur);
        payload_index = payload_index + 1;
    }
    return out;
}

fn mir_cpp_emit_match_terminator(m: MirUnit, block_id: i32) -> string {
    let subject_id = m.block_term_value(block_id);
    var out = "";
    var subject_expr = "";
    if (mir_cpp_match_subject_needs_temp(m, subject_id)) {
        subject_expr = "vyx_match_subject_" + mir_cpp_i32(block_id);
        out = out + "    " + subject_expr + " = " + mir_cpp_value_expr(m, subject_id) + ";\n";
    }
    var default_target = mir_id_invalid();
    var cur = m.block_term_first_case(block_id);
    while (cur != mir_id_invalid()) {
        let pat = m.case_pattern_value(cur);
        let target = m.case_target_block(cur);
        if (mir_cpp_match_pattern_is_default(m, pat)) {
            default_target = target;
        } else {
            var cond = mir_cpp_match_condition_for_subject(m, subject_id, pat, subject_expr);
            let guard = m.case_guard_value(cur);
            if (guard != mir_id_invalid()) { cond = "(" + cond + ") && (" + mir_cpp_bool_expr(m, guard) + ")"; }
            out = out + "    if (" + cond + ") goto bb_" + mir_cpp_i32(target) + ";\n";
        }
        cur = m.case_next(cur);
    }
    if (default_target != mir_id_invalid()) {
        out = out + "    goto bb_" + mir_cpp_i32(default_target) + ";\n";
    } else if (m.block_term_false(block_id) != mir_id_invalid()) {
        out = out + "    goto bb_" + mir_cpp_i32(m.block_term_false(block_id)) + ";\n";
    } else {
        out = out + "    vyx::panic(\"non-exhaustive MIR match\");\n";
    }
    return out;
}

fn mir_cpp_emit_match_subject_decls(m: MirUnit, function_id: i32) -> string {
    var out = "";
    var block_id = m.function_first_block(function_id);
    while (block_id != mir_id_invalid()) {
        if (m.block_term_kind(block_id) == mir_term_match()) {
            let subject_id = m.block_term_value(block_id);
            if (mir_cpp_match_subject_needs_temp(m, subject_id)) {
                let ty = mir_cpp_type_text(m, m.value_type(subject_id));
                out = out + "    " + ty + " vyx_match_subject_" + mir_cpp_i32(block_id);
                let init = mir_cpp_default_value_for_type(ty);
                if (init.len > 0) { out = out + " = " + init; }
                out = out + ";\n";
            }
        }
        block_id = m.block_next(block_id);
    }
    return out;
}

fn mir_cpp_emit_dci_declarations(m: MirUnit) -> string {
    return mir_cpp_emit_dci_direct_declarations(m) + mir_cpp_emit_dci_stub_declarations(m);
}

fn mir_cpp_type_is_raw_callback_integer_target(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    let kind = mir_cpp_type_kind(m, type_id);
    if (kind == ty_BOOL() || kind == ty_CHAR()) { return true; }
    if (kind == ty_I8() || kind == ty_U8() || kind == ty_I16() || kind == ty_U16()) { return true; }
    if (kind == ty_I32() || kind == ty_U32() || kind == ty_I64() || kind == ty_U64()) { return true; }
    return kind == ty_ISIZE() || kind == ty_USIZE();
}

fn mir_cpp_type_is_raw_callback_pointer_target(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid() || type_id <= 0 || type_id > m.types.count) { return false; }
    let kind = mir_cpp_type_kind(m, type_id);
    return kind == ty_CFN() || kind == ty_RAWPTR() || kind == ty_PTR()
        || kind == ty_REF() || kind == ty_MUTREF();
}

fn mir_cpp_type_can_receive_raw_callback_context(m: MirUnit, type_id: i32) -> bool {
    return mir_cpp_type_is_raw_callback_integer_target(m, type_id)
        || mir_cpp_type_is_raw_callback_pointer_target(m, type_id);
}

fn mir_cpp_function_has_hidden_env(m: MirUnit, function_id: i32) -> bool {
    return mir_cpp_function_is_closure(m, function_id);
}

fn mir_cpp_function_raw_callback_abi_compatible(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || mir_cpp_function_has_hidden_env(m, function_id)) { return false; }
    if (mir_cpp_function_param_count(m, function_id) != 1) { return false; }
    if (!mir_cpp_type_can_receive_raw_callback_context(m,
                                                        mir_cpp_function_param_type_at(m, function_id, 0))) {
        return false;
    }
    let ret_kind = mir_cpp_type_kind(m, m.function_return_type(function_id));
    return ret_kind == ty_I32() || ret_kind == ty_U32();
}

fn mir_cpp_function_can_use_raw_callback_adapter(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || mir_cpp_function_has_hidden_env(m, function_id)) { return false; }
    let count = mir_cpp_function_param_count(m, function_id);
    if (count == 0) { return true; }
    if (count == 1) {
        return mir_cpp_type_can_receive_raw_callback_context(m,
                                                              mir_cpp_function_param_type_at(m, function_id, 0));
    }
    return false;
}

fn mir_cpp_reset_raw_callback_need_cache() {
    if (g_mir_cpp_raw_callback_need_cache != null) {
        free(g_mir_cpp_raw_callback_need_cache);
    }
    g_mir_cpp_raw_callback_need_cache = null;
    g_mir_cpp_raw_callback_need_value_buf = null;
    g_mir_cpp_raw_callback_need_function_count = -1;
    g_mir_cpp_raw_callback_need_value_count = -1;
}

fn mir_cpp_raw_callback_need_cache_matches(m: MirUnit) -> bool {
    if (g_mir_cpp_raw_callback_need_function_count != m.function_count
        || g_mir_cpp_raw_callback_need_value_count != m.value_count
        || g_mir_cpp_raw_callback_need_value_buf != m.value_buf) {
        return false;
    }
    return m.function_count == 0 || g_mir_cpp_raw_callback_need_cache != null;
}

fn mir_cpp_prepare_raw_callback_need_cache(m: MirUnit) -> bool {
    if (mir_cpp_raw_callback_need_cache_matches(m)) { return true; }
    mir_cpp_reset_raw_callback_need_cache();
    if (m.function_count < 0 || m.value_count < 0) { return false; }
    if (m.function_count == 0) {
        g_mir_cpp_raw_callback_need_value_buf = m.value_buf;
        g_mir_cpp_raw_callback_need_function_count = 0;
        g_mir_cpp_raw_callback_need_value_count = m.value_count;
        return true;
    }
    let cache = malloc(((m.function_count + 1) * 4) as u64);
    if (cache == null) { return false; }
    var function_id: i32 = 0;
    while (function_id <= m.function_count) {
        ast_write_i32(ptr_offset(cache, function_id * 4), 0);
        function_id = function_id + 1;
    }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_cast()
            && mir_cpp_type_is_raw_callback_integer_target(m, m.value_type(value_id))) {
            let lhs = m.value_lhs(value_id);
            if (lhs != mir_id_invalid()
                && m.value_kind(lhs) == mir_value_target_ref()
                && m.value_target_kind(lhs) == mir_target_function()
                && m.value_target_id(lhs) > 0
                && m.value_target_id(lhs) <= m.function_count
                && !mir_cpp_function_raw_callback_abi_compatible(m, m.value_target_id(lhs))) {
                ast_write_i32(ptr_offset(cache, m.value_target_id(lhs) * 4), 1);
            }
        }
        value_id = value_id + 1;
    }
    g_mir_cpp_raw_callback_need_cache = cache;
    g_mir_cpp_raw_callback_need_value_buf = m.value_buf;
    g_mir_cpp_raw_callback_need_function_count = m.function_count;
    g_mir_cpp_raw_callback_need_value_count = m.value_count;
    return true;
}

fn mir_cpp_function_needs_raw_callback_adapter(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) {
        return false;
    }
    if (m.function_streamed_needs_raw_callback_adapter(function_id)) { return true; }
    if (m.function_streamed_body_discarded(function_id)) { return false; }
    if (!mir_cpp_raw_callback_need_cache_matches(m)
        && !mir_cpp_prepare_raw_callback_need_cache(m)) {
        return false;
    }
    return ast_read_i32(ptr_offset(g_mir_cpp_raw_callback_need_cache, function_id * 4)) != 0;
}

fn mir_cpp_raw_callback_adapter_name(m: MirUnit, function_id: i32) -> string {
    return mir_cpp_function_name(m, function_id) + "_vyx_raw_callback_adapter";
}

fn mir_cpp_emit_terminator(m: MirUnit, function_id: i32, block_id: i32) -> string {
    let kind = m.block_term_kind(block_id);
    if (kind == mir_term_return()) {
        var ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
        if (mir_cpp_is_entry_main(m, function_id)) { ret_ty = "int"; }
        if (ret_ty == "void") { return "    return;\n"; }
        let ret_value = m.block_term_value(block_id);
        if (ret_value == mir_id_invalid()) {
            return "    return " + mir_cpp_default_value_for_type(ret_ty) + ";\n";
        }
        let question_source = mir_cpp_question_source_value(m, ret_value);
        if (question_source != mir_id_invalid()) {
            let tmp = "vyx_try_ret_" + mir_cpp_i32(block_id);
            var out = "    auto " + tmp + " = " + mir_cpp_value_expr(m, question_source) + ";\n";
            out = out + mir_cpp_emit_try_guard(m,
                                               m.value_type(question_source),
                                               m.function_return_type(function_id),
                                               tmp);
            out = out + "    return "
                + mir_cpp_try_success_expr(m, ret_value, m.function_return_type(function_id), tmp)
                + ";\n";
            return out;
        }
        return "    return " + mir_cpp_value_expr_for_type(m, ret_value, m.function_return_type(function_id)) + ";\n";
    }
    if (kind == mir_term_goto()) {
        return "    goto bb_" + mir_cpp_i32(m.block_term_target(block_id)) + ";\n";
    }
    if (kind == mir_term_branch()) {
        return "    if (" + mir_cpp_bool_expr(m, m.block_term_value(block_id)) + ") goto bb_"
               + mir_cpp_i32(m.block_term_target(block_id)) + "; else goto bb_"
               + mir_cpp_i32(m.block_term_false(block_id)) + ";\n";
    }
    if (kind == mir_term_match()) {
        return mir_cpp_emit_match_terminator(m, block_id);
    }
    if (kind == mir_term_foreach_next()) {
        let index_place2 = m.block_term_aux(block_id);
        return "    if (" + mir_cpp_foreach_next_condition(m, m.block_term_value(block_id), index_place2) + ") goto bb_"
            + mir_cpp_i32(m.block_term_target(block_id)) + "; else goto bb_"
            + mir_cpp_i32(m.block_term_false(block_id)) + ";\n";
    }
    if (kind == mir_term_unreachable()) {
        return "    vyx::panic(\"entered unreachable MIR block\");\n";
    }
    if (kind == mir_term_yield()) {
        return "    vyx::panic(\"MIR yield: C++ backend is not the await-split lowering\");\n";
    }
    return "    vyx::panic(\"unknown MIR terminator kind " + mir_cpp_i32(kind) + "\");\n";
}

fn mir_cpp_emit_function_decl(m: MirUnit, function_id: i32) -> string {
    if (mir_cpp_is_entry_main(m, function_id)) {
        return "int main(int argc, char** argv)";
    }
    var ret = mir_cpp_foreign_c_type_text(m, function_id, m.function_return_type(function_id));
    var out = ret + " " + mir_cpp_function_name(m, function_id) + "(";
    if (mir_cpp_function_is_dci_vyx_override_callback(m, function_id)
        || mir_cpp_function_is_no_mangle(m, function_id)) {
        out = "extern \"C\" " + out;
    } else if (m.function_item_kind(function_id) == hir_item_extern_function()
        && !mir_cpp_function_is_foreign_cpp(m, function_id)) {
        out = "extern \"C\" " + out;
    }
    var first = true;
    if (mir_cpp_function_is_closure(m, function_id)) {
        out = out + "void* vyx_closure_env";
        first = false;
    }
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0) {
            if (!first) { out = out + ", "; }
            var param_type = mir_cpp_param_type_text(m, local_id);
            if (mir_cpp_function_is_foreign_c(m, function_id)) {
                param_type = mir_cpp_foreign_c_type_text(m, function_id, m.local_type(local_id));
            }
            out = out + param_type + " ";
            out = out + mir_cpp_local_name(m, local_id);
            first = false;
        }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    out = out + ")";
    if (mir_cpp_function_is_dci_vyx_override_callback(m, function_id)) {
        out = out + mir_cpp_dci_callback_exception_spec(m);
    }
    return out;
}

fn mir_cpp_emit_function_decl_to_file(m: MirUnit, file: &mut std.fs.File, function_id: i32, suffix: string) -> i32 {
    if (mir_cpp_is_entry_main(m, function_id)) {
        if (mir_cpp_append(file, "int main(int argc, char** argv)") != 0) { return -1; }
        return mir_cpp_append(file, suffix);
    }
    if (mir_cpp_function_is_dci_vyx_override_callback(m, function_id)
        || mir_cpp_function_is_no_mangle(m, function_id)) {
        if (mir_cpp_append(file, "extern \"C\" ") != 0) { return -1; }
    } else if (m.function_item_kind(function_id) == hir_item_extern_function()
        && !mir_cpp_function_is_foreign_cpp(m, function_id)) {
        if (mir_cpp_append(file, "extern \"C\" ") != 0) { return -1; }
    }
    if (mir_cpp_append(file,
                       mir_cpp_foreign_c_type_text(
                           m, function_id, m.function_return_type(function_id))) != 0) { return -1; }
    if (mir_cpp_append(file, " ") != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_function_name(m, function_id)) != 0) { return -1; }
    if (mir_cpp_append(file, "(") != 0) { return -1; }
    var first = true;
    if (mir_cpp_function_is_closure(m, function_id)) {
        if (mir_cpp_append(file, "void* vyx_closure_env") != 0) { return -1; }
        first = false;
    }
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0) {
            if (!first && mir_cpp_append(file, ", ") != 0) { return -1; }
            var param_type = mir_cpp_param_type_text(m, local_id);
            if (mir_cpp_function_is_foreign_c(m, function_id)) {
                param_type = mir_cpp_foreign_c_type_text(m, function_id, m.local_type(local_id));
            }
            if (mir_cpp_append(file, param_type) != 0) { return -1; }
            if (mir_cpp_append(file, " ") != 0) { return -1; }
            if (mir_cpp_append(file, mir_cpp_local_name(m, local_id)) != 0) { return -1; }
            first = false;
        }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    if (mir_cpp_append(file, ")") != 0) { return -1; }
    if (mir_cpp_function_is_dci_vyx_override_callback(m, function_id)
        && mir_cpp_append(file, mir_cpp_dci_callback_exception_spec(m)) != 0) { return -1; }
    return mir_cpp_append(file, suffix);
}

fn mir_cpp_emit_closure_adapter_decl(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_needs_closure_adapter(m, function_id)) { return ""; }
    let ret = mir_cpp_type_text(m, m.function_return_type(function_id));
    var out = ret + " " + mir_cpp_closure_adapter_name(m, function_id) + "(void* vyx_closure_env";
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0) {
            out = out + ", " + mir_cpp_type_text(m, m.local_type(local_id))
                + " " + mir_cpp_local_name(m, local_id);
        }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    return out + ")";
}

fn mir_cpp_emit_closure_adapter_function(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_needs_closure_adapter(m, function_id)) { return ""; }
    let ret = mir_cpp_type_text(m, m.function_return_type(function_id));
    var args = "";
    var first = true;
    var local_id = m.function_first_local(function_id);
    var guard: i32 = 0;
    while (local_id != mir_id_invalid() && local_id > 0 && local_id <= m.local_count && guard <= m.local_count) {
        if ((m.local_flags(local_id) & mir_local_flag_param()) != 0) {
            if (!first) { args = args + ", "; }
            args = args + mir_cpp_local_name(m, local_id);
            first = false;
        }
        local_id = m.local_next(local_id);
        guard = guard + 1;
    }
    var out = mir_cpp_emit_closure_adapter_decl(m, function_id) + " {\n";
    out = out + "    (void)vyx_closure_env;\n";
    let call = mir_cpp_function_name(m, function_id) + "(" + args + ")";
    if (ret == "void") {
        out = out + "    " + call + ";\n";
        out = out + "    return;\n";
    } else {
        out = out + "    return " + call + ";\n";
    }
    return out + "}\n\n";
}

fn mir_cpp_emit_raw_callback_adapter_decl(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_needs_raw_callback_adapter(m, function_id)) { return ""; }
    return "int32_t " + mir_cpp_raw_callback_adapter_name(m, function_id)
        + "(void* vyx_raw_context)";
}

fn mir_cpp_emit_raw_callback_adapter_function(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_needs_raw_callback_adapter(m, function_id)) { return ""; }
    var args = "";
    if (mir_cpp_function_param_count(m, function_id) == 1) {
        let param_type_id = mir_cpp_function_param_type_at(m, function_id, 0);
        let param_type = mir_cpp_type_text(m, param_type_id);
        if (mir_cpp_type_is_raw_callback_integer_target(m, param_type_id)) {
            args = "static_cast<" + param_type
                + ">(reinterpret_cast<intptr_t>(vyx_raw_context))";
        } else if (param_type == "void*") {
            args = "vyx_raw_context";
        } else {
            args = "reinterpret_cast<" + param_type + ">(vyx_raw_context)";
        }
    }
    let call = mir_cpp_function_name(m, function_id) + "(" + args + ")";
    var out = mir_cpp_emit_raw_callback_adapter_decl(m, function_id) + " {\n";
    let ret_kind = mir_cpp_type_kind(m, m.function_return_type(function_id));
    if (ret_kind == ty_VOID()) {
        out = out + "    " + call + ";\n";
        out = out + "    return 0;\n";
    } else {
        out = out + "    return static_cast<int32_t>(" + call + ");\n";
    }
    return out + "}\n\n";
}

fn mir_cpp_emit_closure_env_definitions(m: MirUnit) -> string {
    var out = "";
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_cpp_function_is_closure(m, function_id)
            && mir_cpp_function_capture_count(m, function_id) > 0) {
            out = out + "struct " + mir_cpp_closure_env_type_name(m, function_id) + " {\n";
            var idx: i32 = 0;
            var local_id = m.function_first_local(function_id);
            while (local_id != mir_id_invalid()) {
                if (mir_cpp_local_is_capture(m, local_id)) {
                    var field_ty = mir_cpp_type_text(m, m.local_type(local_id));
                    if (mir_cpp_local_is_reference_capture(m, local_id)) { field_ty = field_ty + "*"; }
                    out = out + "    " + field_ty + " "
                        + mir_cpp_closure_capture_field_name(m, local_id, idx) + ";\n";
                    idx = idx + 1;
                }
                local_id = m.local_next(local_id);
            }
            out = out + "};\n\n";
        }
        function_id = function_id + 1;
    }
    return out;
}

fn mir_cpp_emit_closure_capture_bindings(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_is_closure(m, function_id)
        || mir_cpp_function_capture_count(m, function_id) <= 0) {
        return "";
    }
    let env_ty = mir_cpp_closure_env_type_name(m, function_id);
    var out = "    auto* vyx_closure_env_typed = static_cast<" + env_ty + "*>(vyx_closure_env);\n";
    out = out + "    if (vyx_closure_env_typed == nullptr) { vyx::panic(\"missing closure env\"); }\n";
    var idx: i32 = 0;
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if (mir_cpp_local_is_capture(m, local_id)) {
            let field = "vyx_closure_env_typed->" + mir_cpp_closure_capture_field_name(m, local_id, idx);
            if (mir_cpp_local_is_reference_capture(m, local_id)) {
                out = out + "    auto& " + mir_cpp_local_name(m, local_id) + " = *" + field + ";\n";
            } else {
                out = out + "    auto& " + mir_cpp_local_name(m, local_id) + " = " + field + ";\n";
            }
            idx = idx + 1;
        }
        local_id = m.local_next(local_id);
    }
    return out;
}

fn mir_cpp_function_has_body(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    // A materialized MIR block chain is authoritative. Override callbacks can
    // retain a declaration-only HIR flag inherited from their foreign base,
    // even though the Vyx override body has already been lowered.
    if (m.function_first_block(function_id) > 0) { return true; }
    // Streaming backends emit a body before releasing the transient block
    // chain. Keep it a definition in the shared declaration index so all
    // backend consumers retain the same callable surface.
    if (m.function_streamed_body_discarded(function_id)) { return true; }
    if (m.function_item_kind(function_id) == hir_item_extern_function()) { return false; }
    if ((m.function_flags(function_id) & hir_function_flag_declaration_only()) != 0) { return false; }
    return false;
}

fn mir_cpp_function_is_declaration_only(m: MirUnit, function_id: i32) -> bool {
    if (function_id == mir_id_invalid() || function_id <= 0 || function_id > m.function_count) { return false; }
    if (m.function_first_block(function_id) > 0) { return false; }
    if (m.function_item_kind(function_id) == hir_item_extern_function()) { return false; }
    if ((m.function_flags(function_id) & hir_function_flag_declaration_only()) != 0) { return true; }
    return true;
}

fn mir_cpp_type_is_opaque_record(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid()) { return false; }
    if (!mir_cpp_type_needs_record_decl(m, type_id)) { return false; }
    if (m.field_count_for_type(type_id) != 0) { return false; }
    if (m.variant_count_for_type(type_id) != 0) { return false; }
    return true;
}

fn mir_cpp_should_emit_dyn_dispatch_function(m: MirUnit, function_id: i32) -> bool {
    if (!mir_cpp_function_is_declaration_only(m, function_id)) { return false; }
    if (m.function_owner_item_kind(function_id) != hir_item_interface()) { return false; }
    if (!mir_cpp_dyn_dispatch_has_candidate(m, function_id)) { return false; }
    let self_type = mir_cpp_function_param_type_at(m, function_id, 0);
    return mir_cpp_type_is_opaque_record(m, self_type);
}

fn mir_cpp_dyn_dispatch_candidate_matches(m: MirUnit, prototype_id: i32, candidate_id: i32) -> bool {
    if (candidate_id == prototype_id) { return false; }
    if (!mir_cpp_function_has_body(m, candidate_id)) { return false; }
    if (mir_cpp_function_source_name(m, candidate_id) != mir_cpp_function_source_name(m, prototype_id)) { return false; }
    if (mir_cpp_function_param_count(m, candidate_id) != mir_cpp_function_param_count(m, prototype_id)) { return false; }
    if (mir_cpp_type_text(m, m.function_return_type(candidate_id)) != mir_cpp_type_text(m, m.function_return_type(prototype_id))) { return false; }
    let candidate_self_type = mir_cpp_function_param_type_at(m, candidate_id, 0);
    if (candidate_self_type == mir_id_invalid()) { return false; }
    if (mir_cpp_type_is_opaque_record(m, candidate_self_type)) { return false; }
    if (m.function_owner_type(candidate_id).len == 0) { return false; }
    return true;
}

fn mir_cpp_dyn_dispatch_has_candidate(m: MirUnit, prototype_id: i32) -> bool {
    var candidate_id: i32 = 1;
    while (candidate_id <= m.function_count) {
        if (mir_cpp_dyn_dispatch_candidate_matches(m, prototype_id, candidate_id)) {
            return true;
        }
        candidate_id = candidate_id + 1;
    }
    return false;
}

fn mir_cpp_dyn_dispatch_arg_expr(m: MirUnit, prototype_id: i32, candidate_id: i32, param_index: i32) -> string {
    let local_id = mir_cpp_function_param_local_at(m, prototype_id, param_index);
    if (local_id == mir_id_invalid()) { return mir_cpp_default_value_for_type(mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, candidate_id, param_index))); }
    let local_expr = mir_cpp_local_name(m, local_id);
    let source_ty = mir_cpp_type_text(m, m.local_type(local_id));
    let target_ty = mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, candidate_id, param_index));
    if (source_ty == target_ty) { return local_expr; }
    if (target_ty.startsWith("vyx_type_") && source_ty.startsWith("vyx_type_")) { return target_ty + "(" + local_expr + ")"; }
    return local_expr;
}

fn mir_cpp_emit_dyn_dispatch_function(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_should_emit_dyn_dispatch_function(m, function_id)) { return ""; }
    let self_local = mir_cpp_function_param_local_at(m, function_id, 0);
    if (self_local == mir_id_invalid()) { return ""; }
    let self_name = mir_cpp_local_name(m, self_local);
    var ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
    var out = mir_cpp_emit_function_decl(m, function_id) + " {\n";
    var candidate_id: i32 = 1;
    while (candidate_id <= m.function_count) {
        if (mir_cpp_dyn_dispatch_candidate_matches(m, function_id, candidate_id)) {
            let candidate_self_type = mir_cpp_function_param_type_at(m, candidate_id, 0);
            let candidate_self_ty = mir_cpp_type_text(m, candidate_self_type);
            out = out + "    if (auto vyx_dyn_self = std::any_cast<" + candidate_self_ty + ">(&" + self_name + ".opaque.object)) {\n";
            var call = mir_cpp_function_name(m, candidate_id) + "(*vyx_dyn_self";
            var param_index: i32 = 1;
            while (param_index < mir_cpp_function_param_count(m, function_id)) {
                call = call + ", " + mir_cpp_dyn_dispatch_arg_expr(m, function_id, candidate_id, param_index);
                param_index = param_index + 1;
            }
            call = call + ")";
            if (ret_ty == "void") {
                out = out + "        " + call + ";\n";
                out = out + "        return;\n";
            } else {
                out = out + "        return " + call + ";\n";
            }
            out = out + "    }\n";
        }
        candidate_id = candidate_id + 1;
    }
    if (ret_ty == "void") {
        out = out + "    return;\n";
    } else {
        out = out + "    return " + mir_cpp_default_value_for_type(ret_ty) + ";\n";
    }
    out = out + "}\n\n";
    return out;
}

fn mir_cpp_should_emit_function_decl(m: MirUnit, function_id: i32) -> bool {
    if (mir_cpp_function_is_foreign_cpp(m, function_id)) { return false; }
    if (m.function_item_kind(function_id) == hir_item_extern_function()
        && mir_cpp_is_c_runtime_extern(m.function_name(function_id))) {
        return false;
    }
    if (m.function_item_kind(function_id) == hir_item_extern_function()
        && mir_cpp_function_source_name(m, function_id) == "from_cstr_borrowed_cstr_len") {
        return false;
    }
    return true;
}

fn mir_cpp_emit_function(m: MirUnit, function_id: i32) -> string {
    if (!mir_cpp_function_has_body(m, function_id)) {
        return mir_cpp_emit_dyn_dispatch_function(m, function_id);
    }
    var out = mir_cpp_emit_function_decl(m, function_id) + " {\n";
    if (mir_cpp_is_entry_main(m, function_id)) {
        out = out + "    vyx::set_args(argc, argv);\n";
    }
    out = out + mir_cpp_emit_closure_capture_bindings(m, function_id);
    out = out + mir_cpp_emit_match_subject_decls(m, function_id);
    let local_scopes = mir_cpp_build_local_scope_plan(m, function_id);
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if (((m.local_flags(local_id) & mir_local_flag_param()) == 0)
            && !mir_cpp_local_is_capture(m, local_id)
            && !local_scopes.contains(local_id)) {
            var ty = mir_cpp_type_text(m, m.local_type(local_id));
            if ((m.local_flags(local_id) & mir_local_flag_volatile()) != 0) {
                ty = "volatile " + ty;
            }
            out = out + "    " + ty + " " + mir_cpp_local_name(m, local_id);
            let init = mir_cpp_default_value_for_type(ty);
            if (init.len > 0) { out = out + " = " + init; }
            out = out + ";\n";
        }
        local_id = m.local_next(local_id);
    }
    if (m.function_first_block(function_id) != mir_id_invalid()) {
        out = out + "    goto bb_" + mir_cpp_i32(m.function_first_block(function_id)) + ";\n";
    }
    var block_id = m.function_first_block(function_id);
    while (block_id != mir_id_invalid()) {
        out = out + "bb_" + mir_cpp_i32(block_id) + ":\n";
        var instr_id = m.block_first_instr(block_id);
        while (instr_id != mir_id_invalid()) {
            out = out + mir_cpp_emit_instr_with_local_scope(m, instr_id, local_scopes);
            instr_id = m.instr_next(instr_id);
        }
        out = out + mir_cpp_emit_terminator(m, function_id, block_id);
        block_id = m.block_next(block_id);
    }
    var ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
    if (mir_cpp_is_entry_main(m, function_id)) { ret_ty = "int"; }
    if (ret_ty != "void") {
        out = out + "    return " + mir_cpp_default_value_for_type(ret_ty) + ";\n";
    }
    out = out + "}\n\n";
    return out;
}

fn mir_cpp_append(file: &mut std.fs.File, text: string) -> i32 {
    if (text.len == 0) { return 0; }
    return file.write_text(text);
}

fn mir_cpp_emit_arg_list_for_function_to_file(m: MirUnit, file: &mut std.fs.File, function_id: i32, first_arg: i32) -> i32 {
    var cur = first_arg;
    var first = true;
    var param_index: i32 = 0;
    while (cur != mir_id_invalid()) {
        if (!first) {
            if (mir_cpp_append(file, ",") != 0) { return -1; }
            if (mir_cpp_append(file, " ") != 0) { return -1; }
        }
        if (mir_cpp_append(file, mir_cpp_arg_expr_for_param(m, cur, function_id, param_index)) != 0) { return -1; }
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return 0;
}

fn mir_cpp_emit_arg_list_with_receiver_for_function_to_file(m: MirUnit,
                                                            file: &mut std.fs.File,
                                                            function_id: i32,
                                                            receiver: i32,
                                                            first_arg: i32) -> i32 {
    var first = true;
    var param_index: i32 = 0;
    if (receiver != mir_id_invalid()) {
        if (mir_cpp_append(file, mir_cpp_arg_expr_for_param(m, receiver, function_id, param_index)) != 0) { return -1; }
        first = false;
        param_index = param_index + 1;
    }
    var cur = first_arg;
    while (cur != mir_id_invalid()) {
        if (!first) {
            if (mir_cpp_append(file, ",") != 0) { return -1; }
            if (mir_cpp_append(file, " ") != 0) { return -1; }
        }
        if (mir_cpp_append(file, mir_cpp_arg_expr_for_param(m, cur, function_id, param_index)) != 0) { return -1; }
        first = false;
        cur = m.value_next_arg(cur);
        param_index = param_index + 1;
    }
    return 0;
}

fn mir_cpp_can_stream_call_expr_to_file(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (m.value_kind(value_id) != mir_value_call()) { return false; }
    let lhs = m.value_lhs(value_id);
    var target_kind = m.value_target_kind(value_id);
    var target_id = m.value_target_id(value_id);
    if (lhs != mir_id_invalid() && lhs > 0 && lhs <= m.value_count) {
        if (m.value_kind(lhs) == mir_value_target_ref()) {
            if (m.value_target_kind(lhs) != mir_target_none()) { target_kind = m.value_target_kind(lhs); }
            if (m.value_target_id(lhs) != mir_id_invalid()) { target_id = m.value_target_id(lhs); }
        }
    }
    if (target_kind != mir_target_function()) { return false; }
    if (target_id == mir_id_invalid() || target_id <= 0 || target_id > m.function_count) { return false; }
    if (mir_cpp_function_is_foreign_cpp_ctor(m, target_id)) { return false; }
    if (mir_cpp_function_is_foreign_cpp(m, target_id)) { return false; }
    if (mir_cpp_function_is_foreign_c(m, target_id)
        && mir_cpp_type_is_pointer_handle(m, m.function_return_type(target_id))) {
        return false;
    }
    var receiver = mir_id_invalid();
    if (lhs != mir_id_invalid() && lhs > 0 && lhs <= m.value_count) {
        receiver = mir_cpp_call_receiver_value(m, lhs);
    }
    let first_arg = m.value_first_arg(value_id);
    // `first_arg` excludes a bound member receiver.  Inspect that receiver
    // before falling back to a synthesized default self; otherwise a
    // zero-argument value method (`value.toUpper()`) is emitted as
    // `Type{}`.  This mirrors LLVM's receiver-first direct-call lowering.
    if (receiver == mir_id_invalid()
        && mir_cpp_function_needs_implicit_self_arg(m, target_id)
        && mir_cpp_function_param_count(m, target_id) > mir_cpp_call_arg_count(m, first_arg)) {
        return !mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, true);
    }
    if (receiver != mir_id_invalid()) {
        return !mir_cpp_call_has_ref_temp(m, target_id, receiver, first_arg, false);
    }
    return !mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, false);
}

fn mir_cpp_try_emit_call_expr_to_file(m: MirUnit, file: &mut std.fs.File, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    if (m.value_kind(value_id) != mir_value_call()) { return false; }
    let lhs = m.value_lhs(value_id);
    var call_name = mir_cpp_value_source_name(m, value_id);
    var target_kind = m.value_target_kind(value_id);
    var target_id = m.value_target_id(value_id);
    if (lhs != mir_id_invalid() && lhs > 0 && lhs <= m.value_count) {
        if (m.value_kind(lhs) == mir_value_target_ref()) {
            let lhs_name = mir_cpp_value_source_name(m, lhs);
            if (lhs_name.len > 0) { call_name = lhs_name; }
            if (m.value_target_kind(lhs) != mir_target_none()) { target_kind = m.value_target_kind(lhs); }
            if (m.value_target_id(lhs) != mir_id_invalid()) { target_id = m.value_target_id(lhs); }
        }
    }
    if (call_name == "int_to_string" || call_name == "bool_to_string") {
        let helper_call = mir_cpp_c_runtime_call_expr(
            m, call_name, m.value_first_arg(value_id), mir_id_invalid());
        return helper_call.len > 0 && mir_cpp_append(file, helper_call) == 0;
    }
    if (target_kind != mir_target_function()) { return false; }
    if (target_id == mir_id_invalid() || target_id <= 0 || target_id > m.function_count) { return false; }
    if (mir_cpp_is_c_runtime_function_decl(m, target_id)) {
        let c_call = mir_cpp_c_runtime_call_expr(
            m,
            mir_cpp_function_source_name(m, target_id),
            m.value_first_arg(value_id),
            target_id);
        if (c_call.len > 0) {
            return mir_cpp_append(file, c_call) == 0;
        }
    }
    if (mir_cpp_function_is_foreign_cpp_ctor(m, target_id)) { return false; }
    if (mir_cpp_function_is_foreign_cpp(m, target_id)) { return false; }
    var receiver = mir_id_invalid();
    if (lhs != mir_id_invalid() && lhs > 0 && lhs <= m.value_count) {
        receiver = mir_cpp_call_receiver_value(m, lhs);
    }
    let first_arg = m.value_first_arg(value_id);
    // See mir_cpp_can_stream_call_expr_to_file: an explicit target-ref
    // receiver is not represented in first_arg and must win over the
    // receiver-less constructor/default-self fallback.
    if (receiver == mir_id_invalid()
        && mir_cpp_function_needs_implicit_self_arg(m, target_id)
        && mir_cpp_function_param_count(m, target_id) > mir_cpp_call_arg_count(m, first_arg)) {
        if (mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, true)) { return false; }
        return mir_cpp_emit_call_with_default_self_arg_to_file(m, file, target_id, first_arg) == 0;
    }
    if (receiver != mir_id_invalid()) {
        if (mir_cpp_call_has_ref_temp(m, target_id, receiver, first_arg, false)) { return false; }
        if (mir_cpp_append(file, mir_cpp_call_name(m, target_kind, target_id, call_name)) != 0) { return false; }
        if (mir_cpp_append(file, "(") != 0) { return false; }
        if (mir_cpp_emit_arg_list_with_receiver_for_function_to_file(m,
                                                                     file,
                                                                     target_id,
                                                                     receiver,
                                                                     first_arg) != 0) { return false; }
        if (mir_cpp_append(file, ")") != 0) { return false; }
        return true;
    }
    if (mir_cpp_call_has_ref_temp(m, target_id, mir_id_invalid(), first_arg, false)) { return false; }
    if (mir_cpp_append(file, mir_cpp_call_name(m, target_kind, target_id, call_name)) != 0) { return false; }
    if (mir_cpp_append(file, "(") != 0) { return false; }
    if (mir_cpp_emit_arg_list_for_function_to_file(m, file, target_id, first_arg) != 0) { return false; }
    return mir_cpp_append(file, ")") == 0;
}

fn mir_cpp_emit_function_to_file(m: MirUnit, file: &mut std.fs.File, function_id: i32) -> i32 {
    if (!mir_cpp_function_has_body(m, function_id)) {
        return mir_cpp_append(file, mir_cpp_emit_dyn_dispatch_function(m, function_id));
    }
    if (mir_cpp_emit_function_decl_to_file(m, file, function_id, " {\n") != 0) { return -1; }
    if (mir_cpp_is_entry_main(m, function_id)) {
        if (mir_cpp_append(file, "    vyx::set_args(argc, argv);\n") != 0) { return -1; }
    }
    if (mir_cpp_append(file, mir_cpp_emit_closure_capture_bindings(m, function_id)) != 0) { return -1; }
    if (mir_cpp_append(file, mir_cpp_emit_match_subject_decls(m, function_id)) != 0) { return -1; }
    let local_scopes = mir_cpp_build_local_scope_plan(m, function_id);
    var local_id = m.function_first_local(function_id);
    while (local_id != mir_id_invalid()) {
        if (((m.local_flags(local_id) & mir_local_flag_param()) == 0)
            && !mir_cpp_local_is_capture(m, local_id)
            && !local_scopes.contains(local_id)) {
            var ty = mir_cpp_type_text(m, m.local_type(local_id));
            if ((m.local_flags(local_id) & mir_local_flag_volatile()) != 0) {
                ty = "volatile " + ty;
            }
            var line = "    " + ty + " " + mir_cpp_local_name(m, local_id);
            let init = mir_cpp_default_value_for_type(ty);
            if (init.len > 0) { line = line + " = " + init; }
            if (mir_cpp_append(file, line + ";\n") != 0) { return -1; }
        }
        local_id = m.local_next(local_id);
    }
    if (m.function_first_block(function_id) != mir_id_invalid()) {
        if (mir_cpp_append(file, "    goto bb_" + mir_cpp_i32(m.function_first_block(function_id)) + ";\n") != 0) { return -1; }
    }
    var block_id = m.function_first_block(function_id);
    while (block_id != mir_id_invalid()) {
        if (mir_cpp_append(file, "bb_" + mir_cpp_i32(block_id) + ":\n") != 0) { return -1; }
        var instr_id = m.block_first_instr(block_id);
        while (instr_id != mir_id_invalid()) {
            var streamed_instr = false;
            if (m.instr_kind(instr_id) == mir_instr_assign()) {
                let assign_value = m.instr_value(instr_id);
                if (assign_value != mir_id_invalid() && assign_value > 0 && assign_value <= m.value_count) {
                    let assign_place = m.instr_place(instr_id);
                    if (assign_place != mir_id_invalid() && assign_place > 0 && assign_place <= m.place_count) {
                        if (m.value_kind(assign_value) == mir_value_call()) {
                            if (m.place_type(assign_place) == m.value_type(assign_value)) {
                                if (mir_cpp_can_stream_call_expr_to_file(m, assign_value)) {
                                    if (mir_cpp_append(file, "    ") != 0) { return -1; }
                                    if (mir_cpp_append(file, mir_cpp_place_expr(m, assign_place)) != 0) { return -1; }
                                    if (mir_cpp_append(file, " = ") != 0) { return -1; }
                                    if (!mir_cpp_try_emit_call_expr_to_file(m, file, assign_value)) { return -1; }
                                    if (mir_cpp_append(file, ";\n") != 0) { return -1; }
                                    if (mir_cpp_append(file, mir_cpp_refcount_retain_stmt_for_assignment(m,
                                                                                                          assign_place,
                                                                                                          assign_value)) != 0) { return -1; }
                                    streamed_instr = true;
                                }
                            }
                        }
                    }
                }
            }
            if (!streamed_instr && m.instr_kind(instr_id) == mir_instr_eval()) {
                let eval_value = m.instr_value(instr_id);
                if (!mir_cpp_value_is_consumed_elsewhere(m, eval_value, instr_id)) {
                    if (mir_cpp_can_stream_call_expr_to_file(m, eval_value)) {
                        if (mir_cpp_append(file, "    ") != 0) { return -1; }
                        if (!mir_cpp_try_emit_call_expr_to_file(m, file, eval_value)) { return -1; }
                        if (mir_cpp_append(file, ";\n") != 0) { return -1; }
                        streamed_instr = true;
                    }
                }
            }
            if (!streamed_instr) {
                if (mir_cpp_append(file, mir_cpp_emit_instr_with_local_scope(m, instr_id, local_scopes)) != 0) { return -1; }
            }
            instr_id = m.instr_next(instr_id);
        }
        if (mir_cpp_append(file, mir_cpp_emit_terminator(m, function_id, block_id)) != 0) { return -1; }
        block_id = m.block_next(block_id);
    }
    var ret_ty = mir_cpp_type_text(m, m.function_return_type(function_id));
    if (mir_cpp_is_entry_main(m, function_id)) { ret_ty = "int"; }
    if (ret_ty != "void") {
        if (mir_cpp_append(file, "    return " + mir_cpp_default_value_for_type(ret_ty) + ";\n") != 0) { return -1; }
    }
    return mir_cpp_append(file, "}\n\n");
}

fn mir_cpp_emit_functions_range_to_file(m: MirUnit, path: string, first_fn: i32, last_fn: i32) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#include \"vyx_generated.hpp\"\n\n");
    var fn_id = first_fn;
    while (result == 0 && fn_id <= last_fn && fn_id <= m.function_count) {
        result = mir_cpp_emit_function_to_file(m, &mut file, fn_id);
        fn_id = fn_id + 1;
    }
    fn_id = first_fn;
    while (result == 0 && fn_id <= last_fn && fn_id <= m.function_count) {
        result = mir_cpp_append(&mut file, mir_cpp_emit_closure_adapter_function(m, fn_id));
        if (result == 0) {
            result = mir_cpp_append(&mut file, mir_cpp_emit_raw_callback_adapter_function(m, fn_id));
        }
        fn_id = fn_id + 1;
    }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_type_needs_record_decl(m: MirUnit, type_id: i32) -> bool {
    if (type_id == mir_id_invalid()) { return false; }
    let text = mir_cpp_type_source_text(m, type_id);
    if (text == "str" || text == "string" || text == "__String") { return false; }
    if (mir_cpp_type_source_is_pointer_like(text)) { return false; }
    if (mir_cpp_type_is_dci_stub_class(m, type_id)) { return false; }
    if (mir_cpp_type_is_foreign_cpp(m, type_id)) {
        return mir_cpp_dci_layout_for_type(m, type_id) != null;
    }
    return mir_cpp_type_kind(m, type_id) == ty_CLASS();
}

fn mir_cpp_emit_type_forward_decls(m: MirUnit) -> string {
    var out = "";
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_type_needs_record_decl(m, type_id)) {
            out = out + "struct " + mir_cpp_record_type_name(m, type_id) + ";\n";
        }
        type_id = type_id + 1;
    }
    if (out.len > 0) { out = out + "\n"; }
    return out;
}

fn mir_cpp_emit_record_equality(m: MirUnit, type_id: i32, field_count: i32) -> string {
    let ty = mir_cpp_record_type_name(m, type_id);
    var out = "inline bool operator==(const " + ty + "& a, const " + ty + "& b) { return ";
    if (field_count <= 0) {
        out = out + "true";
    } else {
        var idx: i32 = 0;
        while (idx < field_count) {
            if (idx > 0) { out = out + " && "; }
            let field_id = m.field_id_for_type_index(type_id, idx);
            let field_name = mir_cpp_field_cpp_name(m, field_id, idx);
            out = out + "a." + field_name + " == b." + field_name;
            idx = idx + 1;
        }
    }
    out = out + "; }\n";
    out = out + "inline bool operator!=(const " + ty + "& a, const " + ty + "& b) { return !(a == b); }\n";
    return out;
}

fn mir_cpp_emit_variant_equality(m: MirUnit, type_id: i32, payload_count: i32) -> string {
    let ty = mir_cpp_record_type_name(m, type_id);
    var out = "inline bool operator==(const " + ty + "& a, const " + ty + "& b) { return a.tag == b.tag";
    var idx: i32 = 0;
    while (idx < payload_count) {
        out = out + " && a." + mir_cpp_payload_field_name(idx) + " == b." + mir_cpp_payload_field_name(idx);
        idx = idx + 1;
    }
    out = out + "; }\n";
    out = out + "inline bool operator!=(const " + ty + "& a, const " + ty + "& b) { return !(a == b); }\n";
    out = out + "inline bool operator==(const " + ty + "& a, int32_t tag) { return a.tag == tag; }\n";
    out = out + "inline bool operator==(int32_t tag, const " + ty + "& a) { return a.tag == tag; }\n";
    out = out + "inline bool operator!=(const " + ty + "& a, int32_t tag) { return !(a == tag); }\n";
    out = out + "inline bool operator!=(int32_t tag, const " + ty + "& a) { return !(a == tag); }\n";
    out = out + "namespace vyx { inline Str to_string(const ::" + ty + "& v) { return str_owned(std::to_string(v.tag)); } }\n";
    return out;
}

fn mir_cpp_type_has_data_rc_fields(m: MirUnit, type_id: i32) -> bool {
    if (m.field_count_for_type(type_id) != 2) { return false; }
    let f0 = m.field_id_for_type_index(type_id, 0);
    let f1 = m.field_id_for_type_index(type_id, 1);
    if (f0 == mir_id_invalid() || f1 == mir_id_invalid()) { return false; }
    return mir_cpp_field_source_name(m, f0) == "data" && mir_cpp_field_source_name(m, f1) == "rc";
}

fn mir_cpp_type_refcount_handle_kind(m: MirUnit, type_id: i32) -> string {
    if (!mir_cpp_type_has_data_rc_fields(m, type_id)) { return ""; }
    let text = mir_cpp_type_source_text(m, type_id);
    let base = mir_cpp_last_path_segment(policy_generic_call_base(text.clone()));
    if (base == "Ref") { return "strong"; }
    if (base == "Weak") { return "weak"; }
    return "";
}

fn mir_cpp_emit_refcount_handle_members(m: MirUnit, type_id: i32, ty: string) -> string {
    let kind = mir_cpp_type_refcount_handle_kind(m, type_id);
    if (kind.len == 0) { return ""; }
    var out = "";
    out = out + "    " + ty + "() = default;\n";
    out = out + "    " + ty + "(void* data_, void* rc_) : data(data_), rc(rc_) {}\n";
    return out;
}

fn mir_cpp_emit_type_definition(m: MirUnit, type_id: i32) -> string {
    if (!mir_cpp_type_needs_record_decl(m, type_id)) { return ""; }
    let ty = mir_cpp_record_type_name(m, type_id);
    if (mir_cpp_type_is_foreign_cpp(m, type_id)) {
        let size = mir_cpp_dci_layout_size(m, type_id);
        let alignment = mir_cpp_dci_layout_alignment(m, type_id);
        if (size <= 0 || alignment <= 0) { return ""; }
        return "struct alignas(" + policy_i64_to_string(alignment) + ") " + ty + " {\n"
            + "    unsigned char storage[" + policy_i64_to_string(size) + "]{};\n"
            + "};\n"
            + "static_assert(sizeof(" + ty + ") == " + policy_i64_to_string(size) + ");\n"
            + "static_assert(alignof(" + ty + ") == " + policy_i64_to_string(alignment) + ");\n\n";
    }
    let field_count = m.field_count_for_type(type_id);
    let variant_count = m.variant_count_for_type(type_id);
    if (variant_count > 0 && field_count == 0) {
        let payload_count = mir_cpp_variant_payload_max(m, type_id);
        var out = "struct " + ty + " {\n";
        out = out + "    int32_t tag = 0;\n";
        var payload_index: i32 = 0;
        while (payload_index < payload_count) {
            out = out + "    vyx::Any " + mir_cpp_payload_field_name(payload_index) + "{};\n";
            payload_index = payload_index + 1;
        }
        out = out + "};\n";
        out = out + mir_cpp_emit_variant_equality(m, type_id, payload_count);
        return out + "\n";
    }
    if (field_count > 0) {
        var out2 = "struct " + ty + " {\n";
        var idx: i32 = 0;
        while (idx < field_count) {
            let field_id = m.field_id_for_type_index(type_id, idx);
            var field_ty = "vyx::Any";
            if (field_id != mir_id_invalid()) { field_ty = mir_cpp_type_text(m, m.field_type(field_id)); }
            let field_name = mir_cpp_field_cpp_name(m, field_id, idx);
            let field_default = mir_cpp_default_value_for_type(field_ty);
            out2 = out2 + "    ";
            out2 = out2 + field_ty;
            out2 = out2 + " ";
            out2 = out2 + field_name;
            out2 = out2 + " = ";
            out2 = out2 + field_default;
            out2 = out2 + ";\n";
            idx = idx + 1;
        }
        out2 = out2 + mir_cpp_emit_refcount_handle_members(m, type_id, ty);
        out2 = out2 + "};\n";
        out2 = out2 + mir_cpp_emit_record_equality(m, type_id, field_count);
        return out2 + "\n";
    }
    var out3 = "struct " + ty + " {\n";
    out3 = out3 + "    vyx::Any opaque{};\n";
    out3 = out3 + "    " + ty + "() = default;\n";
    out3 = out3 + "    template <typename... Ts> explicit " + ty + "(const Ts&... xs) : opaque(vyx::make_any(xs...)) {}\n";
    out3 = out3 + "    template <typename T> " + ty + "& operator=(const T& v) { opaque = vyx::Any(v); return *this; }\n";
    out3 = out3 + "    explicit operator bool() const { return static_cast<bool>(opaque); }\n";
    out3 = out3 + "    operator int64_t() const { if (opaque.kind == vyx::Any::Kind::I64) return opaque.i; if (opaque.kind == vyx::Any::Kind::U64) return static_cast<int64_t>(opaque.u); return 0; }\n";
    out3 = out3 + "};\n";
    out3 = out3 + mir_cpp_emit_record_equality(m, type_id, 0);
    return out3 + "\n";
}

fn mir_cpp_emit_record_equality_to_file(m: MirUnit, file: &mut std.fs.File, type_id: i32, field_count: i32) -> i32 {
    let ty = mir_cpp_record_type_name(m, type_id);
    if (mir_cpp_append(file, "inline bool operator==(const " + ty + "& a, const " + ty + "& b) { return ") != 0) { return -1; }
    if (field_count <= 0) {
        if (mir_cpp_append(file, "true") != 0) { return -1; }
    } else {
        var idx: i32 = 0;
        while (idx < field_count) {
            if (idx > 0 && mir_cpp_append(file, " && ") != 0) { return -1; }
            let field_id = m.field_id_for_type_index(type_id, idx);
            let field_name = mir_cpp_field_cpp_name(m, field_id, idx);
            if (mir_cpp_append(file, "a." + field_name + " == b." + field_name) != 0) { return -1; }
            idx = idx + 1;
        }
    }
    return mir_cpp_append(file,
                          "; }\ninline bool operator!=(const " + ty + "& a, const " + ty
                          + "& b) { return !(a == b); }\n");
}

fn mir_cpp_emit_variant_equality_to_file(m: MirUnit, file: &mut std.fs.File, type_id: i32, payload_count: i32) -> i32 {
    let ty = mir_cpp_record_type_name(m, type_id);
    if (mir_cpp_append(file, "inline bool operator==(const " + ty + "& a, const " + ty + "& b) { return a.tag == b.tag") != 0) { return -1; }
    var idx: i32 = 0;
    while (idx < payload_count) {
        let payload_name = mir_cpp_payload_field_name(idx);
        if (mir_cpp_append(file, " && a." + payload_name + " == b." + payload_name) != 0) { return -1; }
        idx = idx + 1;
    }
    return mir_cpp_append(file,
                          "; }\n"
                          + "inline bool operator!=(const " + ty + "& a, const " + ty + "& b) { return !(a == b); }\n"
                          + "inline bool operator==(const " + ty + "& a, int32_t tag) { return a.tag == tag; }\n"
                          + "inline bool operator==(int32_t tag, const " + ty + "& a) { return a.tag == tag; }\n"
                          + "inline bool operator!=(const " + ty + "& a, int32_t tag) { return !(a == tag); }\n"
                          + "inline bool operator!=(int32_t tag, const " + ty + "& a) { return !(a == tag); }\n"
                          + "namespace vyx { inline Str to_string(const ::" + ty
                          + "& v) { return str_owned(std::to_string(v.tag)); } }\n");
}

fn mir_cpp_emit_type_definition_to_file(m: MirUnit, file: &mut std.fs.File, type_id: i32) -> i32 {
    if (!mir_cpp_type_needs_record_decl(m, type_id)) { return 0; }
    let ty = mir_cpp_record_type_name(m, type_id);
    if (mir_cpp_type_is_foreign_cpp(m, type_id)) {
        let size = mir_cpp_dci_layout_size(m, type_id);
        let alignment = mir_cpp_dci_layout_alignment(m, type_id);
        if (size <= 0 || alignment <= 0) { return -1; }
        return mir_cpp_append(file,
                              "struct alignas(" + policy_i64_to_string(alignment) + ") " + ty + " {\n"
                              + "    unsigned char storage[" + policy_i64_to_string(size) + "]{};\n"
                              + "};\n"
                              + "static_assert(sizeof(" + ty + ") == " + policy_i64_to_string(size) + ");\n"
                              + "static_assert(alignof(" + ty + ") == " + policy_i64_to_string(alignment) + ");\n\n");
    }
    let field_count = m.field_count_for_type(type_id);
    let variant_count = m.variant_count_for_type(type_id);
    if (variant_count > 0 && field_count == 0) {
        let payload_count = mir_cpp_variant_payload_max(m, type_id);
        if (mir_cpp_append(file, "struct " + ty + " {\n    int32_t tag = 0;\n") != 0) { return -1; }
        var payload_index: i32 = 0;
        while (payload_index < payload_count) {
            if (mir_cpp_append(file, "    vyx::Any " + mir_cpp_payload_field_name(payload_index) + "{};\n") != 0) { return -1; }
            payload_index = payload_index + 1;
        }
        if (mir_cpp_append(file, "};\n") != 0) { return -1; }
        if (mir_cpp_emit_variant_equality_to_file(m, file, type_id, payload_count) != 0) { return -1; }
        return mir_cpp_append(file, "\n");
    }
    if (field_count > 0) {
        if (mir_cpp_append(file, "struct " + ty + " {\n") != 0) { return -1; }
        var idx: i32 = 0;
        while (idx < field_count) {
            let field_id = m.field_id_for_type_index(type_id, idx);
            var field_ty = "vyx::Any";
            if (field_id != mir_id_invalid()) { field_ty = mir_cpp_type_text(m, m.field_type(field_id)); }
            let field_name = mir_cpp_field_cpp_name(m, field_id, idx);
            if (mir_cpp_append(file, "    " + field_ty + " " + field_name + " = "
                                     + mir_cpp_default_value_for_type(field_ty) + ";\n") != 0) { return -1; }
            idx = idx + 1;
        }
        if (mir_cpp_append(file, mir_cpp_emit_refcount_handle_members(m, type_id, ty)) != 0) { return -1; }
        if (mir_cpp_append(file, "};\n") != 0) { return -1; }
        if (mir_cpp_emit_record_equality_to_file(m, file, type_id, field_count) != 0) { return -1; }
        return mir_cpp_append(file, "\n");
    }
    if (mir_cpp_append(file,
                       "struct " + ty + " {\n"
                       + "    vyx::Any opaque{};\n"
                       + "    " + ty + "() = default;\n"
                       + "    template <typename... Ts> explicit " + ty + "(const Ts&... xs) : opaque(vyx::make_any(xs...)) {}\n"
                       + "    template <typename T> " + ty + "& operator=(const T& v) { opaque = vyx::Any(v); return *this; }\n"
                       + "    explicit operator bool() const { return static_cast<bool>(opaque); }\n"
                       + "    operator int64_t() const { if (opaque.kind == vyx::Any::Kind::I64) return opaque.i; if (opaque.kind == vyx::Any::Kind::U64) return static_cast<int64_t>(opaque.u); return 0; }\n"
                       + "};\n") != 0) { return -1; }
    if (mir_cpp_emit_record_equality_to_file(m, file, type_id, 0) != 0) { return -1; }
    return mir_cpp_append(file, "\n");
}

fn mir_cpp_id_set_key(id: i32) -> string {
    return "|" + mir_cpp_i32(id) + "|";
}

fn mir_cpp_id_set_contains(set_text: string, id: i32) -> bool {
    return set_text.contains(mir_cpp_id_set_key(id));
}

fn mir_cpp_type_field_dependencies_ready(m: MirUnit, type_id: i32, emitted: string) -> bool {
    let field_count = m.field_count_for_type(type_id);
    var idx: i32 = 0;
    while (idx < field_count) {
        let field_id = m.field_id_for_type_index(type_id, idx);
        if (field_id != mir_id_invalid()) {
            let dep = m.field_type(field_id);
            if (dep != mir_id_invalid()
                && dep != type_id
                && mir_cpp_type_needs_record_decl(m, dep)
                && !mir_cpp_id_set_contains(emitted, dep)) {
                return false;
            }
        }
        idx = idx + 1;
    }
    return true;
}

fn mir_cpp_emit_type_definitions(m: MirUnit) -> string {
    var out = "";
    var emitted = "";
    var emitted_count: i32 = 0;
    var progress = true;
    while (progress) {
        progress = false;
        var type_id: i32 = 1;
        while (type_id <= m.types.count) {
            if (mir_cpp_type_needs_record_decl(m, type_id)
                && !mir_cpp_id_set_contains(emitted, type_id)
                && mir_cpp_type_field_dependencies_ready(m, type_id, emitted)) {
                out = out + mir_cpp_emit_type_definition(m, type_id);
                emitted = emitted + mir_cpp_id_set_key(type_id);
                emitted_count = emitted_count + 1;
                progress = true;
            }
            type_id = type_id + 1;
        }
    }
    var type_id2: i32 = 1;
    while (type_id2 <= m.types.count) {
        if (mir_cpp_type_needs_record_decl(m, type_id2)
            && !mir_cpp_id_set_contains(emitted, type_id2)) {
            out = out + mir_cpp_emit_type_definition(m, type_id2);
        }
        type_id2 = type_id2 + 1;
    }
    return out;
}

fn mir_cpp_emit_type_definitions_range(m: MirUnit, first_emit: i32, last_emit: i32) -> string {
    var out = "#pragma once\n\n";
    var emitted = "";
    var emitted_count: i32 = 0;
    var progress = true;
    while (progress) {
        progress = false;
        var type_id: i32 = 1;
        while (type_id <= m.types.count) {
            if (mir_cpp_type_needs_record_decl(m, type_id)
                && !mir_cpp_id_set_contains(emitted, type_id)
                && mir_cpp_type_field_dependencies_ready(m, type_id, emitted)) {
                emitted_count = emitted_count + 1;
                if (emitted_count >= first_emit && emitted_count <= last_emit) {
                    out = out + mir_cpp_emit_type_definition(m, type_id);
                }
                emitted = emitted + mir_cpp_id_set_key(type_id);
                progress = true;
            }
            type_id = type_id + 1;
        }
    }
    var type_id2: i32 = 1;
    while (type_id2 <= m.types.count) {
        if (mir_cpp_type_needs_record_decl(m, type_id2)
            && !mir_cpp_id_set_contains(emitted, type_id2)) {
            emitted_count = emitted_count + 1;
            if (emitted_count >= first_emit && emitted_count <= last_emit) {
                out = out + mir_cpp_emit_type_definition(m, type_id2);
            }
            emitted = emitted + mir_cpp_id_set_key(type_id2);
        }
        type_id2 = type_id2 + 1;
    }
    return out;
}

fn mir_cpp_emit_type_definitions_range_to_file(m: MirUnit, path: string, first_emit: i32, last_emit: i32) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n\n");
    var emitted = "";
    var emitted_count: i32 = 0;
    var progress = true;
    while (result == 0 && progress) {
        progress = false;
        var type_id: i32 = 1;
        while (result == 0 && type_id <= m.types.count) {
            if (mir_cpp_type_needs_record_decl(m, type_id)
                && !mir_cpp_id_set_contains(emitted, type_id)
                && mir_cpp_type_field_dependencies_ready(m, type_id, emitted)) {
                emitted_count = emitted_count + 1;
                if (emitted_count >= first_emit && emitted_count <= last_emit) {
                    result = mir_cpp_emit_type_definition_to_file(m, &mut file, type_id);
                }
                emitted = emitted + mir_cpp_id_set_key(type_id);
                progress = true;
            }
            type_id = type_id + 1;
        }
    }
    var type_id2: i32 = 1;
    while (result == 0 && type_id2 <= m.types.count) {
        if (mir_cpp_type_needs_record_decl(m, type_id2)
            && !mir_cpp_id_set_contains(emitted, type_id2)) {
            emitted_count = emitted_count + 1;
            if (emitted_count >= first_emit && emitted_count <= last_emit) {
                result = mir_cpp_emit_type_definition_to_file(m, &mut file, type_id2);
            }
            emitted = emitted + mir_cpp_id_set_key(type_id2);
        }
        type_id2 = type_id2 + 1;
    }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_static_init_expr(m: MirUnit, static_id: i32) -> string {
    let ty = mir_cpp_type_text(m, m.static_type(static_id));
    let kind = m.static_init_kind(static_id);
    if (kind == mir_static_init_int()) { return policy_i64_to_string(m.static_init_int(static_id)); }
    if (kind == mir_static_init_bool()) {
        if (m.static_init_int(static_id) != 0) { return "true"; }
        return "false";
    }
    if (kind == mir_static_init_char()) {
        return "static_cast<char32_t>(" + policy_i64_to_string(m.static_init_int(static_id)) + ")";
    }
    if (kind == mir_static_init_str()) {
        return "vyx::str_lit(" + mir_cpp_quote(m.static_init_text(static_id)) + ")";
    }
    if (kind == mir_static_init_item_ref()) {
        let target_kind = m.static_init_target_kind(static_id);
        let target_id = m.static_init_target_id(static_id);
        if (target_kind == mir_target_function()) {
            if (mir_cpp_type_is_fn_value(m, m.static_type(static_id))) {
                return "vyx::make_closure(reinterpret_cast<void*>(&"
                    + mir_cpp_closure_code_name(m, target_id) + "), nullptr)";
            }
            return "reinterpret_cast<void*>(&" + mir_cpp_function_name(m, target_id) + ")";
        }
        if (target_kind == mir_target_hir_item()) { return mir_cpp_static_name(m, target_id); }
    }
    return mir_cpp_default_value_for_type(ty);
}

fn mir_cpp_emit_statics(m: MirUnit) -> string {
    var out = "";
    var static_id: i32 = 1;
    while (static_id <= m.static_count) {
        if (m.static_exists(static_id)) {
            let ty = mir_cpp_type_text(m, m.static_type(static_id));
            if (ty != "void") {
                out = out + ty + " " + mir_cpp_static_name(m, static_id)
                    + " = " + mir_cpp_static_init_expr(m, static_id) + ";\n";
            }
        }
        static_id = static_id + 1;
    }
    if (out.len > 0) { out = out + "\n"; }
    return out;
}

fn mir_cpp_emit_platform_source() -> string {
    // Keep platform-only implementation space out of the common generated
    // header. Runtime string release is deliberately resolved by the linker,
    // so it can never select a deallocator from an unrelated loaded module.
    var out = "#include \"vyx_runtime.hpp\"\n";
    out = out + "#include <limits>\n\n";
    out = out + "extern \"C\" int64_t vyx_atomic_load_i64(void* value) { if (value == nullptr) return 0; return std::atomic_ref<int64_t>(*static_cast<int64_t*>(value)).load(std::memory_order_seq_cst); }\n";
    out = out + "extern \"C\" int64_t vyx_atomic_fetch_add_i64(void* value, int64_t delta) { if (value == nullptr) return 0; return std::atomic_ref<int64_t>(*static_cast<int64_t*>(value)).fetch_add(delta, std::memory_order_seq_cst); }\n";
    out = out + "extern \"C\" int64_t vyx_atomic_compare_exchange_i64(void* value, int64_t expected, int64_t desired) { if (value == nullptr) return 0; auto atomic_value = std::atomic_ref<int64_t>(*static_cast<int64_t*>(value)); int64_t observed = expected; atomic_value.compare_exchange_strong(observed, desired, std::memory_order_seq_cst, std::memory_order_seq_cst); return observed; }\n\n";
    out = out + "extern \"C\" void* vyx_ref_alloc_abi(int64_t payload_size, int64_t payload_alignment) { constexpr std::size_t header = 24u; if (payload_size < 0 || payload_alignment <= 0) return nullptr; const auto requested_size = static_cast<std::uint64_t>(payload_size); const auto size = requested_size == 0u ? std::uint64_t{1u} : requested_size; const auto alignment = static_cast<std::uint64_t>(payload_alignment); if ((alignment & (alignment - 1u)) != 0u || size > std::numeric_limits<std::size_t>::max() || alignment > std::numeric_limits<std::size_t>::max() || size > std::numeric_limits<std::size_t>::max() - header || alignment - 1u > std::numeric_limits<std::size_t>::max() - header - static_cast<std::size_t>(size)) return nullptr; const auto total = header + static_cast<std::size_t>(alignment - 1u) + static_cast<std::size_t>(size); auto* control = static_cast<unsigned char*>(std::malloc(total)); if (control == nullptr) return nullptr; const auto start = reinterpret_cast<std::uintptr_t>(control + header); const auto bits = (start + alignment - 1u) & ~(alignment - 1u); void* payload = reinterpret_cast<void*>(bits); const int64_t one = 1; std::memcpy(control, &one, sizeof(one)); std::memcpy(control + 8u, &one, sizeof(one)); std::memcpy(control + 16u, &payload, sizeof(payload)); return control; }\n";
    out = out + "extern \"C\" void vyx_ref_free_abi(void* control) { std::free(control); }\n\n";
    out = out + "extern \"C\" void* vyx_aligned_alloc_abi(int64_t payload_size, int64_t payload_alignment) { constexpr std::size_t slot = sizeof(void*); if (payload_size < 0 || payload_alignment <= 0) return nullptr; const auto requested_size = static_cast<std::uint64_t>(payload_size); const auto size = requested_size == 0u ? std::uint64_t{1u} : requested_size; const auto alignment = static_cast<std::uint64_t>(payload_alignment); if ((alignment & (alignment - 1u)) != 0u || size > std::numeric_limits<std::size_t>::max() || alignment > std::numeric_limits<std::size_t>::max() || size > std::numeric_limits<std::size_t>::max() - slot || alignment - 1u > std::numeric_limits<std::size_t>::max() - slot - static_cast<std::size_t>(size)) return nullptr; const auto total = slot + static_cast<std::size_t>(alignment - 1u) + static_cast<std::size_t>(size); auto* base = static_cast<unsigned char*>(std::malloc(total)); if (base == nullptr) return nullptr; const auto start = reinterpret_cast<std::uintptr_t>(base + slot); const auto bits = (start + alignment - 1u) & ~(alignment - 1u); auto* payload = reinterpret_cast<unsigned char*>(bits); void* allocation_base = base; std::memcpy(payload - slot, &allocation_base, sizeof(allocation_base)); return payload; }\n";
    out = out + "extern \"C\" void vyx_aligned_free_abi(void* payload) { if (payload == nullptr) return; void* allocation_base = nullptr; auto* bytes = static_cast<unsigned char*>(payload); std::memcpy(&allocation_base, bytes - sizeof(void*), sizeof(allocation_base)); std::free(allocation_base); }\n";
    return out;
}

fn mir_cpp_emit_runtime_header() -> string {
    var out = "";
    out = out + "#pragma once\n";
    out = out + "#include <algorithm>\n";
    out = out + "#include <atomic>\n";
    out = out + "#include <any>\n";
    out = out + "#include <array>\n";
    out = out + "#include <charconv>\n";
    out = out + "#include <cctype>\n";
    out = out + "#include <cstddef>\n";
    out = out + "#include <cstdio>\n";
    out = out + "#include <cstring>\n";
    out = out + "#include <cstdint>\n";
    out = out + "#include <cstdlib>\n";
    out = out + "#include <ctime>\n";
    out = out + "#include <format>\n";
    out = out + "#include <functional>\n";
    out = out + "#include <iostream>\n";
    out = out + "#include <memory>\n";
    out = out + "#include <mutex>\n";
    out = out + "#include <new>\n";
    out = out + "#include <sstream>\n";
    out = out + "#include <string>\n";
    out = out + "#include <string_view>\n";
    out = out + "#include <system_error>\n";
    out = out + "#include <tuple>\n";
    out = out + "#include <type_traits>\n";
    out = out + "#include <utility>\n\n";
    out = out + "#include <vector>\n\n";
    out = out + "#if defined(VYX_LINKED_RUNTIME_STRING_FREE)\n";
    out = out + "extern \"C\" void vyx_free_runtime_string(char* value);\n";
    out = out + "extern \"C\" void vyx_free_pooled_string(char* value);\n";
    out = out + "extern \"C\" void* vyx_rt_string_arena_alloc(int64_t bytes);\n";
    out = out + "#endif\n\n";
    out = out + "namespace vyx {\n";
    out = out + "struct Any;\n";
    out = out + "enum class PtrCapability : std::uintptr_t { Compat = 0, Shared = 1, Mutable = 2 };\n";
    out = out + "struct PtrDimension { std::size_t extent = 0; std::size_t stride = 0; };\n";
    out = out + "struct alignas(8) PtrRegion { void* base = nullptr; std::size_t bytes = 0; bool alive = false; bool owned = false; void (*destroy)(void*) = nullptr; std::vector<PtrDimension> dimensions; };\n";
    out = out + "struct RawAllocation { void* base = nullptr; std::size_t bytes = 0; bool alive = false; };\n";
    out = out + "inline std::vector<std::unique_ptr<PtrRegion>>& ptr_regions() { static std::vector<std::unique_ptr<PtrRegion>> regions; return regions; }\n";
    out = out + "inline std::vector<std::unique_ptr<RawAllocation>>& ptr_allocations() { static std::vector<std::unique_ptr<RawAllocation>> allocations; return allocations; }\n";
    out = out + "inline std::mutex& ptr_regions_mutex() { static std::mutex mutex; return mutex; }\n";
    out = out + "inline bool ptr_address_in_span(void* address, void* base, std::size_t bytes) { if (address == nullptr || base == nullptr || bytes == 0u) return false; const auto current = reinterpret_cast<std::uintptr_t>(address); const auto start = reinterpret_cast<std::uintptr_t>(base); return current >= start && static_cast<std::size_t>(current - start) < bytes; }\n";
    out = out + "inline std::size_t ptr_registered_remaining(void* address) { if (address == nullptr) return 0u; std::lock_guard<std::mutex> lock(ptr_regions_mutex()); std::size_t best = 0u; for (const auto& allocation : ptr_allocations()) { if (!allocation->alive || !ptr_address_in_span(address, allocation->base, allocation->bytes)) continue; const auto remaining = allocation->bytes - static_cast<std::size_t>(reinterpret_cast<std::uintptr_t>(address) - reinterpret_cast<std::uintptr_t>(allocation->base)); if (allocation->base == address) return remaining; if (best == 0u || remaining < best) best = remaining; } return best; }\n";
    out = out + "inline void ptr_invalidate_registered_span(void* base, std::size_t bytes) { if (base == nullptr || bytes == 0u) return; std::lock_guard<std::mutex> lock(ptr_regions_mutex()); for (auto& allocation : ptr_allocations()) { if (allocation->alive && ptr_address_in_span(allocation->base, base, bytes)) allocation->alive = false; } for (auto& region : ptr_regions()) { if (region->alive && ptr_address_in_span(region->base, base, bytes)) { region->alive = false; region->base = nullptr; region->bytes = 0u; } } }\n";
    out = out + "inline void* ptr_allocation_register(void* base, std::int64_t bytes) { if (base == nullptr || bytes <= 0) return base; std::lock_guard<std::mutex> lock(ptr_regions_mutex()); for (auto& allocation : ptr_allocations()) { if (allocation->base == base) { allocation->bytes = static_cast<std::size_t>(bytes); allocation->alive = true; return base; } } auto allocation = std::make_unique<RawAllocation>(); allocation->base = base; allocation->bytes = static_cast<std::size_t>(bytes); allocation->alive = true; ptr_allocations().push_back(std::move(allocation)); return base; }\n";
    out = out + "inline void ptr_allocation_unregister(void* base) { if (base == nullptr) return; std::size_t bytes = 1u; { std::lock_guard<std::mutex> lock(ptr_regions_mutex()); for (const auto& allocation : ptr_allocations()) { if (allocation->alive && allocation->base == base) { bytes = allocation->bytes; break; } } } ptr_invalidate_registered_span(base, bytes); }\n";
    out = out + "inline void ptr_allocation_unregister_range(void* base, std::int64_t bytes) { if (base == nullptr || bytes <= 0) return; ptr_invalidate_registered_span(base, static_cast<std::size_t>(bytes)); }\n";
    out = out + "inline void* ptr_allocation_realloc(void* old_base, void* new_base, std::int64_t bytes) { if (new_base == nullptr) return nullptr; if (old_base != nullptr) ptr_allocation_unregister(old_base); return ptr_allocation_register(new_base, bytes); }\n";
    out = out + "inline PtrRegion* ptr_region_new(void* base, std::size_t bytes, bool owned, void (*destroy)(void*) = nullptr) { const auto registered = ptr_registered_remaining(base); if (registered > 0u) bytes = registered; auto region = std::make_unique<PtrRegion>(); region->base = base; region->bytes = bytes; region->alive = base != nullptr; region->owned = owned; region->destroy = destroy; auto* raw = region.get(); std::lock_guard<std::mutex> lock(ptr_regions_mutex()); ptr_regions().push_back(std::move(region)); return raw; }\n";
    out = out + "inline void* ptr_tag_metadata(PtrRegion* region, PtrCapability capability) { if (region == nullptr) return nullptr; auto bits = reinterpret_cast<std::uintptr_t>(region); return reinterpret_cast<void*>(bits | static_cast<std::uintptr_t>(capability)); }\n";
    out = out + "inline PtrRegion* ptr_region(void* metadata) { auto bits = reinterpret_cast<std::uintptr_t>(metadata); return reinterpret_cast<PtrRegion*>(bits & ~std::uintptr_t{3}); }\n";
    out = out + "inline PtrCapability ptr_capability(void* metadata) { return static_cast<PtrCapability>(reinterpret_cast<std::uintptr_t>(metadata) & std::uintptr_t{3}); }\n";
    out = out + "[[noreturn]] inline void ptr_fail(const char* message) { std::fputs(message, stderr); std::fputc('\\n', stderr); std::abort(); }\n";
    out = out + "template <typename T> struct Ptr;\n";
    out = out + "template <typename T> struct is_ptr_handle : std::false_type {};\n";
