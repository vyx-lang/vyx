    out = out + "template <typename Label, typename A, typename B> inline int32_t assert_eq(const Label&, const A& a, const B& b) { return (a == b) ? 0 : 1; }\n";
    out = out + "template <typename... Ts> inline vyx::Str format(vyx::Str fmt, const Ts&... xs) { return vyx::format_to_str(fmt, xs...); }\n";
    out = out + "inline vyx::Str from_cstr(const char* p) { return p == nullptr ? vyx::Str{} : vyx::str_owned_bytes(p, std::strlen(p)); }\n";
    out = out + "inline vyx::Str from_cstr(void* p) { return from_cstr(static_cast<const char*>(p)); }\n";
    out = out + "inline vyx::Str from_cstr_len(const char* p, int64_t n) { if (p == nullptr || n < 0) return vyx::Str{}; return vyx::str_owned_bytes(p, static_cast<std::size_t>(n)); }\n";
    out = out + "inline vyx::Str from_cstr_len(void* p, int64_t n) { return from_cstr_len(static_cast<const char*>(p), n); }\n";
    out = out + "inline vyx::Str from_cstr_len(std::nullptr_t, int64_t) { return vyx::Str{}; }\n";
    out = out + "inline vyx::Str from_cstr_view_len(const char* p, int64_t n) { if (p == nullptr || n < 0) return vyx::Str{}; return vyx::Str{p, n, 0, 0}; }\n";
    out = out + "inline vyx::Str from_cstr_view_len(void* p, int64_t n) { return from_cstr_view_len(static_cast<const char*>(p), n); }\n";
    out = out + "inline vyx::Str from_cstr_view_len(std::nullptr_t, int64_t) { return vyx::Str{}; }\n";
    out = out + "inline vyx::Str from_cstr_borrowed_cstr_len(const char* p, int64_t n) { return from_cstr_view_len(p, n); }\n";
    out = out + "inline vyx::Str from_cstr_borrowed_cstr_len(void* p, int64_t n) { return from_cstr_view_len(p, n); }\n";
    out = out + "inline vyx::Str from_cstr_borrowed_cstr_len(std::nullptr_t, int64_t) { return vyx::Str{}; }\n";
    out = out + "template <typename Owned> inline vyx::Str from_raw_string_parts(const char* p, int64_t len, int64_t cap, Owned owned) { if (p == nullptr || len < 0 || cap < 0) return vyx::Str{}; return vyx::Str{p, len, cap, static_cast<int64_t>(owned)}; }\n";
    out = out + "template <typename Owned> inline vyx::Str from_raw_string_parts(void* p, int64_t len, int64_t cap, Owned owned) { return from_raw_string_parts(static_cast<const char*>(p), len, cap, owned); }\n";
    out = out + "inline void* ptr_offset(void* p, int64_t n) { return static_cast<void*>(reinterpret_cast<unsigned char*>(p) + n); }\n";
    out = out + "inline void ptr_write_i8(void* p, int8_t v) { if (p != nullptr) { *reinterpret_cast<int8_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_i16(void* p, int16_t v) { if (p != nullptr) { *reinterpret_cast<int16_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_i32(void* p, int32_t v) { if (p != nullptr) { *reinterpret_cast<int32_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_i64(void* p, int64_t v) { if (p != nullptr) { *reinterpret_cast<int64_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_u8(void* p, uint8_t v) { if (p != nullptr) { *reinterpret_cast<uint8_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_u16(void* p, uint16_t v) { if (p != nullptr) { *reinterpret_cast<uint16_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_u32(void* p, uint32_t v) { if (p != nullptr) { *reinterpret_cast<uint32_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_u64(void* p, uint64_t v) { if (p != nullptr) { *reinterpret_cast<uint64_t*>(p) = v; } }\n";
    out = out + "inline void ptr_write_f32(void* p, float v) { if (p != nullptr) { *reinterpret_cast<float*>(p) = v; } }\n";
    out = out + "inline void ptr_write_f64(void* p, double v) { if (p != nullptr) { *reinterpret_cast<double*>(p) = v; } }\n";
    out = out + "template <typename T> inline void ptr_write(void* p, const T& v) { if (p != nullptr) { *reinterpret_cast<T*>(p) = v; } }\n";
    out = out + "inline int8_t ptr_read_i8(void* p) { return p == nullptr ? 0 : *reinterpret_cast<int8_t*>(p); }\n";
    out = out + "inline int16_t ptr_read_i16(void* p) { return p == nullptr ? 0 : *reinterpret_cast<int16_t*>(p); }\n";
    out = out + "inline int32_t ptr_read_i32(void* p) { return p == nullptr ? 0 : *reinterpret_cast<int32_t*>(p); }\n";
    out = out + "inline int64_t ptr_read_i64(void* p) { return p == nullptr ? 0 : *reinterpret_cast<int64_t*>(p); }\n";
    out = out + "inline uint8_t ptr_read_u8(void* p) { return p == nullptr ? 0 : *reinterpret_cast<uint8_t*>(p); }\n";
    out = out + "inline uint16_t ptr_read_u16(void* p) { return p == nullptr ? 0 : *reinterpret_cast<uint16_t*>(p); }\n";
    out = out + "inline uint32_t ptr_read_u32(void* p) { return p == nullptr ? 0 : *reinterpret_cast<uint32_t*>(p); }\n";
    out = out + "inline uint64_t ptr_read_u64(void* p) { return p == nullptr ? 0 : *reinterpret_cast<uint64_t*>(p); }\n";
    out = out + "inline float ptr_read_f32(void* p) { return p == nullptr ? 0.0f : *reinterpret_cast<float*>(p); }\n";
    out = out + "inline double ptr_read_f64(void* p) { return p == nullptr ? 0.0 : *reinterpret_cast<double*>(p); }\n";
    out = out + "template <typename T> inline T ptr_read(void* p) { return p == nullptr ? T{} : *reinterpret_cast<T*>(p); }\n";
    return out;
}
fn mir_cpp_padded_i32(id: i32, width: i32) -> string {
    var out = mir_cpp_i32(id);
    while (out.len < width) {
        out = "0" + out;
    }
    return out;
}

fn mir_cpp_emit_closure_env_definitions_range(m: MirUnit, first_fn: i32, last_fn: i32) -> string {
    var out = "#pragma once\n\n";
    var function_id: i32 = first_fn;
    while (function_id <= last_fn && function_id <= m.function_count) {
        if (mir_cpp_function_is_closure(m, function_id)
            && mir_cpp_function_capture_count(m, function_id) > 0) {
            out = out + "struct " + mir_cpp_closure_env_type_name(m, function_id) + " {\n";
            var idx: i32 = 0;
            var local_id = m.function_first_local(function_id);
            while (local_id != mir_id_invalid()) {
                if (mir_cpp_local_is_capture(m, local_id)) {
                    var field_ty = mir_cpp_type_text(m, m.local_type(local_id));
                    if (mir_cpp_local_is_reference_capture(m, local_id)) { field_ty = field_ty + "*"; }
                    out = out + "    " + field_ty + " "
                        + mir_cpp_closure_capture_field_name(m, local_id, idx) + ";\n";
                    idx = idx + 1;
                }
                local_id = m.local_next(local_id);
            }
            out = out + "};\n\n";
        }
        function_id = function_id + 1;
    }
    return out;
}

fn mir_cpp_function_chunk_size() -> i32 { return 48; }

fn mir_cpp_reflect_chunk_size() -> i32 { return 24; }

fn mir_cpp_type_chunk_size() -> i32 { return 24; }

fn mir_cpp_chunk_count(total: i32, chunk_size: i32) -> i32 {
    if (total <= 0) { return 0; }
    return (total + chunk_size - 1) / chunk_size;
}

fn mir_cpp_function_tu_rel(index: i32) -> string {
    return "src/tu_" + mir_cpp_padded_i32(index, 4) + ".cpp";
}

fn mir_cpp_reflect_tu_rel(index: i32) -> string {
    return "src/reflect_" + mir_cpp_padded_i32(index, 4) + ".cpp";
}

fn mir_cpp_function_decl_header_name(index: i32) -> string {
    return "vyx_fn_decls_" + mir_cpp_padded_i32(index, 4) + ".hpp";
}

fn mir_cpp_reflect_decl_header_name(index: i32) -> string {
    return "vyx_reflect_decls_" + mir_cpp_padded_i32(index, 4) + ".hpp";
}

fn mir_cpp_type_def_header_name(index: i32) -> string {
    return "vyx_type_defs_" + mir_cpp_padded_i32(index, 4) + ".hpp";
}

fn mir_cpp_closure_env_header_name(index: i32) -> string {
    return "vyx_closure_envs_" + mir_cpp_padded_i32(index, 4) + ".hpp";
}

fn mir_cpp_emit_function_decls_range(m: MirUnit, first_fn: i32, last_fn: i32) -> string {
    var out = "#pragma once\n#include \"vyx_types.hpp\"\n\n";
    var fn_id: i32 = first_fn;
    while (fn_id <= last_fn && fn_id <= m.function_count) {
        if (mir_cpp_should_emit_function_decl(m, fn_id)) {
            out = out + mir_cpp_emit_function_decl(m, fn_id) + ";\n";
        }
        fn_id = fn_id + 1;
    }
    fn_id = first_fn;
    while (fn_id <= last_fn && fn_id <= m.function_count) {
        let adapter_decl = mir_cpp_emit_closure_adapter_decl(m, fn_id);
        if (adapter_decl.len > 0) { out = out + adapter_decl + ";\n"; }
        let raw_adapter_decl = mir_cpp_emit_raw_callback_adapter_decl(m, fn_id);
        if (raw_adapter_decl.len > 0) { out = out + raw_adapter_decl + ";\n"; }
        fn_id = fn_id + 1;
    }
    return out + "\n";
}

fn mir_cpp_emit_function_decls_range_to_file(m: MirUnit, path: string, first_fn: i32, last_fn: i32) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n#include \"vyx_types.hpp\"\n\n");
    var fn_id: i32 = first_fn;
    while (result == 0 && fn_id <= last_fn && fn_id <= m.function_count) {
        if (mir_cpp_should_emit_function_decl(m, fn_id)) {
            result = mir_cpp_emit_function_decl_to_file(m, &mut file, fn_id, ";\n");
        }
        fn_id = fn_id + 1;
    }
    fn_id = first_fn;
    while (result == 0 && fn_id <= last_fn && fn_id <= m.function_count) {
        let adapter_decl = mir_cpp_emit_closure_adapter_decl(m, fn_id);
        if (adapter_decl.len > 0) { result = mir_cpp_append(&mut file, adapter_decl + ";\n"); }
        let raw_adapter_decl = mir_cpp_emit_raw_callback_adapter_decl(m, fn_id);
        if (result == 0 && raw_adapter_decl.len > 0) {
            result = mir_cpp_append(&mut file, raw_adapter_decl + ";\n");
        }
        fn_id = fn_id + 1;
    }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_function_decls(m: MirUnit) -> string {
    return mir_cpp_emit_function_decls_range(m, 1, m.function_count);
}

fn mir_cpp_emit_closure_adapter_decls(m: MirUnit) -> string {
    var out = "";
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        let adapter_decl = mir_cpp_emit_closure_adapter_decl(m, fn_id);
        if (adapter_decl.len > 0) { out = out + adapter_decl + ";\n"; }
        let raw_adapter_decl = mir_cpp_emit_raw_callback_adapter_decl(m, fn_id);
        if (raw_adapter_decl.len > 0) { out = out + raw_adapter_decl + ";\n"; }
        fn_id = fn_id + 1;
    }
    return out;
}

fn mir_cpp_emit_reflected_method_adapter_decls_range(m: MirUnit, first_type: i32, last_type: i32) -> string {
    var out = "#pragma once\n#include \"vyx_types.hpp\"\n\n";
    var type_id: i32 = first_type;
    while (type_id <= last_type && type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (fn_id <= m.function_count) {
                let decl = mir_cpp_emit_reflected_method_adapter_decl(m, fn_id, type_id);
                if (decl.len > 0) { out = out + decl + ";\n"; }
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    return out + "\n";
}

fn mir_cpp_emit_reflected_method_adapter_decls_range_to_file(m: MirUnit,
                                                             path: string,
                                                             first_type: i32,
                                                             last_type: i32) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n#include \"vyx_types.hpp\"\n\n");
    var type_id: i32 = first_type;
    while (result == 0 && type_id <= last_type && type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (result == 0 && fn_id <= m.function_count) {
                let decl = mir_cpp_emit_reflected_method_adapter_decl(m, fn_id, type_id);
                if (decl.len > 0) { result = mir_cpp_append(&mut file, decl + ";\n"); }
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    if (result == 0) { result = mir_cpp_append(&mut file, "\n"); }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_static_decls(m: MirUnit) -> string {
    var out = "#pragma once\n#include \"vyx_types.hpp\"\n\n";
    var static_id: i32 = 1;
    while (static_id <= m.static_count) {
        if (m.static_exists(static_id)) {
            let ty = mir_cpp_type_text(m, m.static_type(static_id));
            if (ty != "void") {
                out = out + "extern " + ty + " " + mir_cpp_static_name(m, static_id) + ";\n";
            }
        }
        static_id = static_id + 1;
    }
    return out;
}

fn mir_cpp_emit_type_forwards_header(m: MirUnit) -> string {
    var out = "#pragma once\n#include \"vyx_runtime.hpp\"\n"
        + mir_cpp_emit_foreign_cpp_includes(m)
        + "\n"
        + "// Generated MIR2 record forward declarations.\n\n";
    out = out + mir_cpp_emit_type_forward_decls(m);
    return out + "\n";
}

fn mir_cpp_emit_type_forwards_header_to_file(m: MirUnit, path: string) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n#include \"vyx_runtime.hpp\"\n");
    if (result == 0) { result = mir_cpp_append(&mut file, mir_cpp_emit_foreign_cpp_includes(m)); }
    if (result == 0) { result = mir_cpp_append(&mut file, "\n"); }
    if (result == 0) { result = mir_cpp_append(&mut file, "// Generated MIR2 record forward declarations.\n\n"); }
    if (result == 0) { result = mir_cpp_emit_type_forward_decls_to_file(m, &mut file); }
    if (result == 0) { result = mir_cpp_append(&mut file, "\n"); }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_types_header(m: MirUnit, module_name: string) -> string {
    var out = "#pragma once\n#include \"vyx_runtime.hpp\"\n"
        + "#include \"vyx_type_forwards.hpp\"\n\n"
        + "// Generated type declaration index for MIR2 module " + module_name + ".\n\n";
    let type_chunk_size = mir_cpp_type_chunk_size();
    let type_chunk_count = mir_cpp_chunk_count(m.types.count, type_chunk_size);
    var type_chunk: i32 = 0;
    while (type_chunk < type_chunk_count) {
        out = out + "#include \"" + mir_cpp_type_def_header_name(type_chunk) + "\"\n";
        type_chunk = type_chunk + 1;
    }
    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (fn_chunk < fn_chunk_count) {
        out = out + "#include \"" + mir_cpp_closure_env_header_name(fn_chunk) + "\"\n";
        fn_chunk = fn_chunk + 1;
    }
    return out + "\n";
}

fn mir_cpp_emit_types_header_to_file(m: MirUnit, path: string, module_name: string) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n#include \"vyx_runtime.hpp\"\n#include \"vyx_type_forwards.hpp\"\n\n");
    if (result == 0) {
        result = mir_cpp_append(&mut file, "// Generated type declaration index for MIR2 module " + module_name + ".\n\n");
    }
    let type_chunk_size = mir_cpp_type_chunk_size();
    let type_chunk_count = mir_cpp_chunk_count(m.types.count, type_chunk_size);
    var type_chunk: i32 = 0;
    while (result == 0 && type_chunk < type_chunk_count) {
        result = mir_cpp_append(&mut file, "#include \"" + mir_cpp_type_def_header_name(type_chunk) + "\"\n");
        type_chunk = type_chunk + 1;
    }
    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (result == 0 && fn_chunk < fn_chunk_count) {
        result = mir_cpp_append(&mut file, "#include \"" + mir_cpp_closure_env_header_name(fn_chunk) + "\"\n");
        fn_chunk = fn_chunk + 1;
    }
    if (result == 0) { result = mir_cpp_append(&mut file, "\n"); }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_generated_header(m: MirUnit, module_name: string) -> string {
    var out = "#pragma once\n"
        + "#include \"vyx_runtime.hpp\"\n"
        + "#include \"vyx_types.hpp\"\n\n"
        + "// Generated declaration index for MIR2 module " + module_name + ".\n\n";
    out = out + mir_cpp_emit_dci_declarations(m);
    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (fn_chunk < fn_chunk_count) {
        out = out + "#include \"" + mir_cpp_function_decl_header_name(fn_chunk) + "\"\n";
        fn_chunk = fn_chunk + 1;
    }
    let reflect_chunk_size = mir_cpp_reflect_chunk_size();
    let reflect_chunk_count = mir_cpp_chunk_count(m.types.count, reflect_chunk_size);
    var reflect_chunk: i32 = 0;
    while (reflect_chunk < reflect_chunk_count) {
        out = out + "#include \"" + mir_cpp_reflect_decl_header_name(reflect_chunk) + "\"\n";
        reflect_chunk = reflect_chunk + 1;
    }
    out = out + "#include \"vyx_static_decls.hpp\"\n";
    return out + "\n";
}

fn mir_cpp_emit_generated_header_to_file(m: MirUnit, path: string, module_name: string) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#pragma once\n"
                                 + "#include \"vyx_runtime.hpp\"\n"
                                 + "#include \"vyx_types.hpp\"\n\n"
                                 + "// Generated declaration index for MIR2 module " + module_name + ".\n\n");
    if (result == 0) { result = mir_cpp_append(&mut file, mir_cpp_emit_dci_declarations(m)); }
    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (result == 0 && fn_chunk < fn_chunk_count) {
        result = mir_cpp_append(&mut file, "#include \"" + mir_cpp_function_decl_header_name(fn_chunk) + "\"\n");
        fn_chunk = fn_chunk + 1;
    }
    let reflect_chunk_size = mir_cpp_reflect_chunk_size();
    let reflect_chunk_count = mir_cpp_chunk_count(m.types.count, reflect_chunk_size);
    var reflect_chunk: i32 = 0;
    while (result == 0 && reflect_chunk < reflect_chunk_count) {
        result = mir_cpp_append(&mut file, "#include \"" + mir_cpp_reflect_decl_header_name(reflect_chunk) + "\"\n");
        reflect_chunk = reflect_chunk + 1;
    }
    if (result == 0) { result = mir_cpp_append(&mut file, "#include \"vyx_static_decls.hpp\"\n\n"); }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_main_cpp(m: MirUnit, module_name: string) -> string {
    var out = "#include \"vyx_generated.hpp\"\n\n"
        + "// Generated MIR2CPP entry shim for module " + module_name + ".\n\n";
    if (mir_cpp_entry_main_id(m) == mir_id_invalid()) {
        out = out + "int main() { return 0; }\n";
    }
    return out;
}

fn mir_cpp_emit_statics_cpp(m: MirUnit) -> string {
    return "#include \"vyx_generated.hpp\"\n\n" + mir_cpp_emit_statics(m);
}

fn mir_cpp_emit_functions_range(m: MirUnit, first_fn: i32, last_fn: i32) -> string {
    var out = "#include \"vyx_generated.hpp\"\n\n";
    var fn_id = first_fn;
    while (fn_id <= last_fn && fn_id <= m.function_count) {
        out = out + mir_cpp_emit_function(m, fn_id);
        fn_id = fn_id + 1;
    }
    fn_id = first_fn;
    while (fn_id <= last_fn && fn_id <= m.function_count) {
        out = out + mir_cpp_emit_closure_adapter_function(m, fn_id);
        out = out + mir_cpp_emit_raw_callback_adapter_function(m, fn_id);
        fn_id = fn_id + 1;
    }
    return out;
}

fn mir_cpp_emit_reflected_method_adapter_functions_range(m: MirUnit,
                                                         first_type: i32,
                                                         last_type: i32) -> string {
    var out = "#include \"vyx_generated.hpp\"\n\n";
    var type_id = first_type;
    while (type_id <= last_type && type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (fn_id <= m.function_count) {
                out = out + mir_cpp_emit_reflected_method_adapter_function(m, fn_id, type_id);
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    return out;
}

fn mir_cpp_emit_reflected_method_adapter_functions_range_to_file(m: MirUnit,
                                                                 path: string,
                                                                 first_type: i32,
                                                                 last_type: i32) -> i32 {
    var file = File.open(path, FileOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        binary: true,
    });
    if (!file.is_open()) { return -1; }
    var result = file.write_text("#include \"vyx_generated.hpp\"\n\n");
    var type_id = first_type;
    while (result == 0 && type_id <= last_type && type_id <= m.types.count) {
        if (mir_cpp_reflect_method_value_uses_fn_type(m, type_id)) {
            var fn_id: i32 = 1;
            while (result == 0 && fn_id <= m.function_count) {
                result = mir_cpp_append(&mut file, mir_cpp_emit_reflected_method_adapter_function(m, fn_id, type_id));
                fn_id = fn_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    let close_rc = file.close();
    if (result != 0) { return result; }
    return close_rc;
}

fn mir_cpp_emit_cpp(m: MirUnit, module_name: string) -> string {
    var out = "#include \"vyx_runtime.hpp\"\n"
        + mir_cpp_emit_foreign_cpp_includes(m)
        + "\n";
    out = out + "// Generated from MIR2 module " + module_name + ".\n\n";
    out = out + mir_cpp_emit_dci_declarations(m);
    out = out + mir_cpp_emit_type_forward_decls(m);
    out = out + mir_cpp_emit_type_definitions(m);
    out = out + mir_cpp_emit_closure_env_definitions(m);
    out = out + mir_cpp_emit_function_decls(m);
    out = out + mir_cpp_emit_closure_adapter_decls(m);
    out = out + mir_cpp_emit_reflected_method_adapter_decls(m);
    out = out + "\n";
    out = out + mir_cpp_emit_statics(m);
    var fn_id: i32 = 1;
    while (fn_id <= m.function_count) {
        out = out + mir_cpp_emit_function(m, fn_id);
        fn_id = fn_id + 1;
    }
    fn_id = 1;
    while (fn_id <= m.function_count) {
        out = out + mir_cpp_emit_closure_adapter_function(m, fn_id);
        out = out + mir_cpp_emit_raw_callback_adapter_function(m, fn_id);
        fn_id = fn_id + 1;
    }
    out = out + mir_cpp_emit_reflected_method_adapter_functions(m);
    if (mir_cpp_entry_main_id(m) == mir_id_invalid()) {
        out = out + "int main() { return 0; }\n";
    }
    return out;
}

fn mir_cpp_cmake_quote(text: string) -> string {
    var out = "\"";
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 34) {
            out = out + "\\\"";
        } else if (c == 92) {
            out = out + "/";
        } else {
            out = out + text.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn mir_cpp_line_count(rows: string) -> i64 {
    var count: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) {
            split = true;
        } else if (rows.charAt(i) == 10) {
            split = true;
        }
        if (split) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn mir_cpp_line_at(rows: string, want: i64) -> string {
    var idx: i64 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) {
            split = true;
        } else if (rows.charAt(i) == 10) {
            split = true;
        }
        if (split) {
            if (i > start) {
                if (idx == want) { return rows.substring(start, i); }
                idx = idx + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn mir_cpp_rows_contains(rows: string, value: string) -> bool {
    var i: i64 = 0;
    let n = mir_cpp_line_count(rows.clone());
    while (i < n) {
        if (mir_cpp_line_at(rows.clone(), i).trim() == value) { return true; }
        i = i + 1;
    }
    return false;
}

fn mir_cpp_rows_have_c_source(rows: string) -> bool {
    var i: i64 = 0;
    let n = mir_cpp_line_count(rows.clone());
    while (i < n) {
        let item = mir_cpp_line_at(rows.clone(), i).trim();
        if (item.endsWith(".c")) { return true; }
        i = i + 1;
    }
    return false;
}

fn mir_cpp_rows_to_cmake_sources(rows: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = mir_cpp_line_count(rows.clone());
    while (i < n) {
        let item = mir_cpp_line_at(rows.clone(), i).trim();
        if (item.len > 0) {
            out = out + "  " + mir_cpp_cmake_quote(item) + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_rows_to_cmake_list(rows: string, indent: string) -> string {
    var out: string = "";
    var i: i64 = 0;
    let n = mir_cpp_line_count(rows.clone());
    while (i < n) {
        let item = mir_cpp_line_at(rows.clone(), i).trim();
        if (item.len > 0) {
            out = out + indent + mir_cpp_cmake_quote(item) + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_emit_type_forward_decls_to_file(m: MirUnit, file: &mut std.fs.File) -> i32 {
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_type_needs_record_decl(m, type_id)) {
            if (mir_cpp_append(file, "struct " + mir_cpp_record_type_name(m, type_id) + ";\n") != 0) { return -1; }
        }
        type_id = type_id + 1;
    }
    return mir_cpp_append(file, "\n");
}

fn mir_cpp_foreign_cpp_include_directive(raw: string) -> string {
    let item = raw.trim();
    if (item.len == 0) { return ""; }
    if ((item.startsWith("<") && item.endsWith(">"))
        || (item.startsWith("\"") && item.endsWith("\""))) {
        return "#include " + item + "\n";
    }
    return "#include \"" + item + "\"\n";
}

fn mir_cpp_normalize_include_path(raw: string) -> string {
    let item = raw.trim();
    if (item.len == 0) { return ""; }
    if ((item.startsWith("<") && item.endsWith(">"))
        || (item.startsWith("\"") && item.endsWith("\""))) {
        return item;
    }
    var out: string = "";
    var i: i32 = 0;
    while (i < item.len) {
        if (item.charAt(i) == 92) {
            out = out + "/";
        } else {
            out = out + item.substring(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn mir_cpp_include_rows_contains(rows: string, value: string) -> bool {
    let needle = value.trim();
    if (needle.len == 0) { return true; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (rows.substring(start, i).trim() == needle) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn mir_cpp_append_include_row(rows: string, raw: string) -> string {
    let clean = mir_cpp_normalize_include_path(raw);
    if (clean.len == 0 || mir_cpp_include_rows_contains(rows, clean)) { return rows; }
    if (rows.len == 0) { return clean; }
    return rows + "\n" + clean;
}

// Core DCI consumers (`extern "dci"` + dcib) do not require @[cpp_include].
// Reverse-callback stubs still need the Adapter's recorded headers so a
// Vyx subclass can inherit the real C++ base (e.g. abi_complex::AbstractSink).
fn mir_cpp_dci_source_header_rows(m: MirUnit, rows: string) -> string {
    var out = rows;
    var root_i: i32 = 0;
    let root_n = mir_cpp_dci_contract_count(m);
    while (root_i < root_n) {
        let root = mir_cpp_dci_contract_at(m, root_i);
        if (!mir_cpp_dci_root_is_rust(root)) {
            let headers = mir_cpp_dci_json_item(mir_cpp_dci_json_item(root, "source"), "headers");
            if (headers != null && cJSON_IsArray(headers) != 0) {
                let n = cJSON_GetArraySize(headers);
                var i: i32 = 0;
                while (i < n) {
                    let h = cJSON_GetArrayItem(headers, i);
                    if (h != null && cJSON_IsString(h) != 0) {
                        let raw = cJSON_GetStringValue(h);
                        if (raw != null) {
                            out = mir_cpp_append_include_row(out, from_cstr(raw));
                        }
                    }
                    i = i + 1;
                }
            }
        }
        root_i = root_i + 1;
    }
    return out;
}

fn mir_cpp_emit_foreign_cpp_includes(m: MirUnit) -> string {
    let rows = mir_cpp_dci_source_header_rows(m, mir_unit_foreign_cpp_includes(&m));
    var out = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        var split = false;
        if (i == rows.len) {
            split = true;
        } else if (rows.charAt(i) == 10) {
            split = true;
        }
        if (split) {
            out = out + mir_cpp_foreign_cpp_include_directive(rows.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (out.len > 0) { out = out + "\n"; }
    return out;
}

fn mir_cpp_emit_compile_options(target_name: string, cflags: string, cxxflags: string) -> string {
    let c_rows = mir_cpp_rows_to_cmake_list(cflags, "    ");
    let cxx_rows = mir_cpp_rows_to_cmake_list(cxxflags, "    ");
    if (c_rows.len == 0 && cxx_rows.len == 0) { return ""; }
    var out = "target_compile_options(" + target_name + " PRIVATE\n";
    if (c_rows.len > 0) {
        out = out + "  $" + "<$<COMPILE_LANGUAGE:C>:\n" + c_rows + "  >\n";
    }
    if (cxx_rows.len > 0) {
        out = out + "  $" + "<$<COMPILE_LANGUAGE:CXX>:\n" + cxx_rows + "  >\n";
    }
    return out + ")\n";
}

fn mir_cpp_links_runtime_string_allocator(libs: string) -> bool {
    return mir_cpp_rows_contains(libs.clone(), "vyx_compiler_backend")
        || mir_cpp_rows_contains(libs.clone(), "vyx_runtime")
        || mir_cpp_rows_contains(libs.clone(), "vyx_rt")
        || mir_cpp_rows_contains(libs.clone(), "vyx_run_rt")
        || mir_cpp_rows_contains(libs.clone(), "vyx_run_rt_static");
}

fn mir_cpp_links_shared_runtime(libs: string) -> bool {
    return mir_cpp_rows_contains(libs.clone(), "vyx_compiler_backend")
        || mir_cpp_rows_contains(libs.clone(), "vyx_rt")
        || mir_cpp_rows_contains(libs.clone(), "vyx_run_rt");
}

fn mir_cpp_emit_runtime_link_contract(target_name: string, libs: string) -> string {
    if (!mir_cpp_links_runtime_string_allocator(libs.clone())) { return ""; }
    var out = "target_compile_definitions(" + target_name
        + " PRIVATE VYX_LINKED_RUNTIME_STRING_FREE=1)\n";
    if (mir_cpp_links_shared_runtime(libs)) {
        out = out + "if(APPLE)\n"
            + "  set_property(TARGET " + target_name + " PROPERTY BUILD_RPATH \"@loader_path\")\n"
            + "  set_property(TARGET " + target_name + " PROPERTY INSTALL_RPATH \"@loader_path\")\n"
            + "elseif(UNIX AND NOT EMSCRIPTEN)\n"
            + "  set_property(TARGET " + target_name + " PROPERTY BUILD_RPATH \"$ORIGIN;$ORIGIN/lib\")\n"
            + "  set_property(TARGET " + target_name + " PROPERTY INSTALL_RPATH \"$ORIGIN;$ORIGIN/lib\")\n"
            + "endif()\n";
    }
    return out;
}

fn mir_cpp_emit_runtime_dll_copy(target_name: string, lib_paths: string, libs: string) -> string {
    if (!mir_cpp_links_shared_runtime(libs.clone())) { return ""; }
    if (lib_paths.trim().len == 0) { return ""; }
    var files: string = "";
    if (mir_cpp_rows_contains(libs.clone(), "vyx_compiler_backend")) {
        files = files
            + "  vyx_compiler_backend.dll\n"
            + "  libvyx_compiler_backend.so\n"
            + "  libvyx_compiler_backend.dylib\n";
    }
    if (mir_cpp_rows_contains(libs.clone(), "vyx_rt")) {
        files = files + "  vyx_rt.dll\n  libvyx_rt.so\n  libvyx_rt.dylib\n";
    }
    if (mir_cpp_rows_contains(libs, "vyx_run_rt")) {
        files = files + "  vyx_run_rt.dll\n  libvyx_run_rt.so\n  libvyx_run_rt.dylib\n";
    }
    return "set(VYX_RUNTIME_DIRS\n"
        + mir_cpp_rows_to_cmake_list(lib_paths, "    ")
        + ")\n"
        + "set(VYX_RUNTIME_FILES\n"
        + files
        + ")\n"
        + "foreach(_vyx_runtime_dir IN LISTS VYX_RUNTIME_DIRS)\n"
        + "  foreach(_vyx_runtime_file IN LISTS VYX_RUNTIME_FILES)\n"
        + "    if(EXISTS \"" + "$" + "{_vyx_runtime_dir}/" + "$" + "{_vyx_runtime_file}\")\n"
        + "      add_custom_command(TARGET " + target_name + " POST_BUILD\n"
        + "        COMMAND " + "$" + "{CMAKE_COMMAND} -E copy_if_different\n"
        + "          \"" + "$" + "{_vyx_runtime_dir}/" + "$" + "{_vyx_runtime_file}\"\n"
        + "          \"" + "$" + "<TARGET_FILE_DIR:" + target_name + ">\")\n"
        + "    endif()\n"
        + "  endforeach()\n"
        + "endforeach()\n";
}

fn mir_cpp_emit_bundled_std_copy(target_name: string) -> string {
    return "if(EXISTS \"" + "$" + "{CMAKE_CURRENT_SOURCE_DIR}/std\")\n"
        + "  add_custom_command(TARGET " + target_name + " POST_BUILD\n"
        + "    COMMAND " + "$" + "{CMAKE_COMMAND} -E copy_directory\n"
        + "      \"" + "$" + "{CMAKE_CURRENT_SOURCE_DIR}/std\"\n"
        + "      \"" + "$" + "<TARGET_FILE_DIR:" + target_name + ">/std\")\n"
        + "endif()\n";
}

fn mir_cpp_default_generated_sources() -> string {
    return "src/main.cpp\n"
        + "src/vyx_statics.cpp\n"
        + "src/vyx_platform.cpp\n";
}

fn mir_cpp_generated_sources_path(out_dir: string) -> string {
    return mir_cpp_join(out_dir, "vyx_generated_sources.txt");
}

fn mir_cpp_read_generated_sources(out_dir: string) -> string {
    let path = mir_cpp_generated_sources_path(out_dir);
    let rows = readFile(path.clone());
    if (rows.len == 0 && !fileExists(path)) { return mir_cpp_default_generated_sources(); }
    if (rows.trim().len == 0) { return mir_cpp_default_generated_sources(); }
    return rows;
}

fn mir_cpp_emit_cmake_config(project_name: string,
                             target_kind: string,
                             generated_sources: string,
                             native_sources: string,
                             include_paths: string,
                             lib_paths: string,
                             libs: string,
                             cflags: string,
                             cxxflags: string) -> string {
    let target_name = mir_cpp_ident(project_name);
    var languages = "CXX";
    if (mir_cpp_rows_have_c_source(native_sources.clone())) { languages = "C CXX"; }
    var kind = target_kind.trim();
    if (kind.len == 0) { kind = "executable"; }
    var out = "cmake_minimum_required(VERSION 3.20)\n"
        + "project(" + target_name + " LANGUAGES " + languages + ")\n\n"
        + "set(CMAKE_CXX_STANDARD 20)\n"
        + "set(CMAKE_CXX_STANDARD_REQUIRED ON)\n"
        + "set(CMAKE_CXX_EXTENSIONS OFF)\n"
        + "set(VYX_RUNTIME_DIR \"\" CACHE PATH \"Directory containing the target vyx runtime\")\n"
        + "set(VYX_EXTERNAL_LIB_DIRS \"\" CACHE STRING \"Additional target library directories\")\n\n"
        + "set(VYX_GENERATED_SOURCES\n"
        + mir_cpp_rows_to_cmake_sources(generated_sources)
        + mir_cpp_rows_to_cmake_sources(native_sources)
        + ")\n\n";
    if (kind == "static" || kind == "staticlib") {
        out = out + "add_library(" + target_name + " STATIC " + "$" + "{VYX_GENERATED_SOURCES})\n";
    } else if (kind == "shared" || kind == "dylib" || kind == "library") {
        out = out + "add_library(" + target_name + " SHARED " + "$" + "{VYX_GENERATED_SOURCES})\n";
    } else {
        out = out + "add_executable(" + target_name + " " + "$" + "{VYX_GENERATED_SOURCES})\n";
    }
    out = out + "target_include_directories(" + target_name + " PRIVATE\n"
        + "  include\n"
        + mir_cpp_rows_to_cmake_list(include_paths, "  ")
        + ")\n";
    if (lib_paths.trim().len > 0) {
        out = out + "target_link_directories(" + target_name + " PRIVATE\n"
            + mir_cpp_rows_to_cmake_list(lib_paths, "  ")
            + ")\n";
    }
    if (libs.trim().len > 0) {
        out = out + "target_link_libraries(" + target_name + " PRIVATE\n"
            + mir_cpp_rows_to_cmake_list(libs, "  ")
            + ")\n";
    }
    out = out + "if(WIN32)\n"
        + "  target_link_libraries(" + target_name + " PRIVATE ws2_32)\n"
        + "endif()\n";
    out = out + "if(UNIX AND CMAKE_DL_LIBS)\n"
        + "  target_link_libraries(" + target_name + " PRIVATE " + "$" + "{CMAKE_DL_LIBS})\n"
        + "endif()\n";
    out = out + "if(CMAKE_CXX_COMPILER_ID MATCHES \"Clang|GNU\")\n"
        + "  target_compile_options(" + target_name + " PRIVATE $" + "<$<COMPILE_LANGUAGE:CXX>:-Wno-parentheses-equality>)\n"
        + "endif()\n";
    out = out + mir_cpp_emit_runtime_link_contract(target_name, libs.clone());
    out = out + mir_cpp_emit_runtime_dll_copy(target_name, lib_paths, libs);
    out = out + mir_cpp_emit_bundled_std_copy(target_name);
    out = out + mir_cpp_emit_compile_options(target_name, cflags, cxxflags);
    return out;
}

fn mir_cpp_emit_cmake(project_name: string) -> string {
    return mir_cpp_emit_cmake_config(project_name, "executable", mir_cpp_default_generated_sources(), "", "", "", "", "", "");
}

fn mir_cpp_cli_sysroot() -> string {
    let argc = argCount();
    var i: i32 = 1;
    while (i < argc) {
        let arg = getArg(i);
        if (arg == "--") { return ""; }
        if (arg == "--sysroot" && i + 1 < argc) { return getArg(i + 1); }
        if (arg.startsWith("--sysroot=")) { return arg.substring(10, arg.len); }
        i = i + 1;
    }
    return "";
}

fn mir_cpp_target_cmake_system(target: string) -> string {
    let platform = policy_target_platform_name(target);
    if (platform == "windows") { return "Windows"; }
    if (platform == "linux") { return "Linux"; }
    if (platform == "android") { return "Android"; }
    if (platform == "macos") { return "Darwin"; }
    return "";
}

fn mir_cpp_target_cmake_processor(target: string) -> string {
    let arch = policy_target_arch_name(target);
    if (arch == "x64") { return "x86_64"; }
    if (arch == "arm64") { return "aarch64"; }
    if (arch == "x86") { return "x86"; }
    if (arch == "arm") { return "arm"; }
    return arch;
}

fn mir_cpp_target_android_abi(target: string) -> string {
    if (policy_target_platform_name(target) != "android") { return ""; }
    let arch = policy_target_arch_name(target);
    if (arch == "x64") { return "x86_64"; }
    if (arch == "arm64") { return "arm64-v8a"; }
    if (arch == "x86") { return "x86"; }
    if (arch == "arm") { return "armeabi-v7a"; }
    return "";
}

fn mir_cpp_emit_target_toolchain(canonical_triple: string,
                                 sysroot: string) -> string {
    let system_name = mir_cpp_target_cmake_system(canonical_triple.clone());
    let processor = mir_cpp_target_cmake_processor(canonical_triple.clone());
    let android_abi = mir_cpp_target_android_abi(canonical_triple.clone());
    var out = "# Generated by the Vyx MIR2CPP backend.\n"
        + "set(VYX_TARGET_TRIPLE " + mir_cpp_cmake_quote(canonical_triple) + " CACHE STRING \"Canonical Vyx target triple\" FORCE)\n";
    if (system_name.len > 0) {
        out = out + "set(CMAKE_SYSTEM_NAME " + mir_cpp_cmake_quote(system_name) + ")\n";
    }
    if (processor.len > 0) {
        out = out + "set(CMAKE_SYSTEM_PROCESSOR " + mir_cpp_cmake_quote(processor) + ")\n";
    }
    if (android_abi.len > 0) {
        out = out + "set(CMAKE_ANDROID_ARCH_ABI " + mir_cpp_cmake_quote(android_abi) + ")\n";
    }
    out = out
        + "set(CMAKE_C_COMPILER_TARGET " + mir_cpp_cmake_quote(canonical_triple) + " CACHE STRING \"C compiler target triple\" FORCE)\n"
        + "set(CMAKE_CXX_COMPILER_TARGET " + mir_cpp_cmake_quote(canonical_triple) + " CACHE STRING \"C++ compiler target triple\" FORCE)\n";
    if (sysroot.len > 0) {
        out = out + "set(CMAKE_SYSROOT " + mir_cpp_cmake_quote(sysroot) + " CACHE PATH \"Target sysroot\" FORCE)\n";
    }
    return out;
}

fn mir_cpp_emit_presets() -> string {
    return "{\n"
        + "  \"version\": 3,\n"
        + "  \"configurePresets\": [\n"
        + "    {\n"
        + "      \"name\": \"ninja-debug\",\n"
        + "      \"displayName\": \"Ninja Debug\",\n"
        + "      \"generator\": \"Ninja\",\n"
        + "      \"binaryDir\": \"" + "$" + "{sourceDir}/build/ninja-debug\",\n"
        + "      \"cacheVariables\": { \"CMAKE_BUILD_TYPE\": \"Debug\" }\n"
        + "    },\n"
        + "    {\n"
        + "      \"name\": \"ninja-release\",\n"
        + "      \"displayName\": \"Ninja Release\",\n"
        + "      \"generator\": \"Ninja\",\n"
        + "      \"binaryDir\": \"" + "$" + "{sourceDir}/build/ninja-release\",\n"
        + "      \"cacheVariables\": { \"CMAKE_BUILD_TYPE\": \"Release\" }\n"
        + "    }\n"
        + "  ],\n"
        + "  \"buildPresets\": [\n"
        + "    { \"name\": \"ninja-debug\", \"configurePreset\": \"ninja-debug\" },\n"
        + "    { \"name\": \"ninja-release\", \"configurePreset\": \"ninja-release\" }\n"
        + "  ]\n"
        + "}\n";
}

fn mir_cpp_emit_target_presets() -> string {
    return "{\n"
        + "  \"version\": 3,\n"
        + "  \"configurePresets\": [\n"
        + "    {\n"
        + "      \"name\": \"ninja-debug\",\n"
        + "      \"displayName\": \"Ninja Debug\",\n"
        + "      \"generator\": \"Ninja\",\n"
        + "      \"binaryDir\": \"" + "$" + "{sourceDir}/build/ninja-debug\",\n"
        + "      \"cacheVariables\": {\n"
        + "        \"CMAKE_BUILD_TYPE\": \"Debug\",\n"
        + "        \"CMAKE_TOOLCHAIN_FILE\": \"" + "$" + "{sourceDir}/cmake/vyx-target.cmake\"\n"
        + "      }\n"
        + "    },\n"
        + "    {\n"
        + "      \"name\": \"ninja-release\",\n"
        + "      \"displayName\": \"Ninja Release\",\n"
        + "      \"generator\": \"Ninja\",\n"
        + "      \"binaryDir\": \"" + "$" + "{sourceDir}/build/ninja-release\",\n"
        + "      \"cacheVariables\": {\n"
        + "        \"CMAKE_BUILD_TYPE\": \"Release\",\n"
        + "        \"CMAKE_TOOLCHAIN_FILE\": \"" + "$" + "{sourceDir}/cmake/vyx-target.cmake\"\n"
        + "      }\n"
        + "    }\n"
        + "  ],\n"
        + "  \"buildPresets\": [\n"
        + "    { \"name\": \"ninja-debug\", \"configurePreset\": \"ninja-debug\" },\n"
        + "    { \"name\": \"ninja-release\", \"configurePreset\": \"ninja-release\" }\n"
        + "  ]\n"
        + "}\n";
}

fn mir_cpp_emit_readme(project_name: string) -> string {
    let target_triple = policy_cli_target_triple();
    if (target_triple.len > 0) {
        return "# " + project_name + " MIR2CPP\n\n"
            + "Generated by `vyxc --src=project <project-dir> --emit=cpp -o <out-dir>`.\n\n"
            + "Target: `" + target_triple + "`\n\n"
            + "```sh\n"
            + "cmake --preset ninja-debug\n"
            + "cmake --build --preset ninja-debug\n"
            + "```\n";
    }
    return "# " + project_name + " MIR2CPP\n\n"
        + "Generated by `vyxc --src=project <project-dir> --emit=cpp -o <out-dir>`.\n\n"
        + "```powershell\n"
        + "cmake --preset ninja-debug\n"
        + "cmake --build --preset ninja-debug\n"
        + ".\\build\\ninja-debug\\" + mir_cpp_ident(project_name) + ".exe\n"
        + "```\n";
}

fn mir_cpp_type_reflection_member_allowed(name: string) -> bool {
    if (name == "name" || name == "kind" || name == "fields" || name == "methods") { return true; }
    return false;
}

fn mir_cpp_value_has_type_receiver(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    let lhs = m.value_lhs(value_id);
    if (lhs == mir_id_invalid() || lhs <= 0 || lhs > m.value_count) { return false; }
    if (m.value_kind(lhs) != mir_value_target_ref()) { return false; }
    let tk = m.value_target_kind(lhs);
    if (tk == mir_target_type()) { return true; }
    if (tk == mir_target_hir_item() && !m.static_exists(m.value_target_id(lhs))) { return true; }
    return false;
}

fn mir_cpp_value_is_foreign_dci_type_path(m: MirUnit, value_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    let type_id = m.value_type(value_id);
    return type_id != mir_id_invalid()
        && mir_unit_type_is_foreign_dci(&m,  type_id)
        && mir_cpp_dci_type_names_match(
            mir_cpp_value_source_name(m, value_id), mir_cpp_type_source_text(m, type_id));
}

fn mir_cpp_validate_target_refs(m: MirUnit) -> i32 {
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_target_ref()
            && m.value_target_kind(value_id) == mir_target_none()
            && mir_cpp_value_has_type_receiver(m, value_id)
            && !mir_cpp_value_is_foreign_dci_type_path(m, value_id)) {
            let name = mir_cpp_value_source_name(m, value_id);
            if (!mir_cpp_type_reflection_member_allowed(name)) {
                mir_cpp_report_error_at_value(m, value_id,
                                              "unresolved type reflection member `" + name + "`");
                return 1;
            }
        }
        value_id = value_id + 1;
    }
    return 0;
}

fn mir_cpp_layout_builtin_name(m: MirUnit, value_id: i32) -> string {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return ""; }
    let kind = m.value_kind(value_id);
    var name = "";
    if (kind == mir_value_call()) {
        if (mir_cpp_effective_call_target_kind(m, value_id) == mir_target_function()) { return ""; }
        name = mir_cpp_effective_call_name(m, value_id);
    } else if (kind == mir_value_intrinsic()) {
        name = mir_cpp_value_source_name(m, value_id);
    } else {
        return "";
    }
    let base = policy_generic_call_base(name.clone());
    if (base == "sizeof" || base == "repr_sizeof" || base == "alignof") { return name; }
    return "";
}

fn mir_cpp_validate_layout_builtin(m: MirUnit, value_id: i32, name: string) -> i32 {
    let base = policy_generic_call_base(name.clone());
    var type_source = mir_cpp_sizeof_type_source_from_name(name);
    var type_id = mir_id_invalid();
    if (type_source.len > 0) {
        let mapped = mir_cpp_generic_arg_for_param(m, m.value_function(value_id), type_source);
        if (mapped.len > 0) { type_source = mapped; }
        let exact = mir_cpp_find_type_by_source_text(m, type_source);
        if (exact == mir_id_invalid() && mir_cpp_type_tail_match_count(m, type_source) > 1) {
            mir_cpp_report_error_at_value(m, value_id,
                                          "ambiguous " + base + " type `" + type_source + "`");
            return 1;
        }
        type_id = mir_cpp_find_type_by_source_or_tail(m, type_source);
    } else if (base == "alignof") {
        let subject = m.value_first_arg(value_id);
        if (subject != mir_id_invalid()) { type_id = m.value_type(subject); }
    } else {
        mir_cpp_report_error_at_value(m, value_id,
                                      base + " requires one concrete type argument");
        return 1;
    }
    if (type_id == mir_id_invalid()
        || type_id <= 0
        || type_id > m.types.count
        || hir_type_table_is_open(m.types, type_id)) {
        mir_cpp_report_error_at_value(m, value_id,
                                      "cannot resolve " + base + " type `" + type_source + "`");
        return 1;
    }
    if (mir_cpp_storage_align_for_type(m, type_id) <= 0) {
        mir_cpp_report_error_at_value(m, value_id,
                                      "cannot lower " + base + " type `" + type_source + "`");
        return 1;
    }
    if (base == "sizeof") {
        if (!mir_cpp_sizeof_type_is_known(m, type_id)) {
            mir_cpp_report_error_at_value(m, value_id,
                                          "cannot lower sizeof type `" + type_source + "`");
            return 1;
        }
    } else if (base == "repr_sizeof") {
        if (!mir_cpp_sizeof_type_is_known(m, type_id)) {
            mir_cpp_report_error_at_value(m, value_id,
                                          "cannot lower repr_sizeof type `" + type_source + "`");
            return 1;
        }
        if (mir_cpp_repr_sizeof_type_text(m, type_id).len == 0) {
            mir_cpp_report_error_at_value(m, value_id,
                                          "cannot lower repr_sizeof type `" + type_source + "`");
            return 1;
        }
    }
    return 0;
}

fn mir_cpp_validate_layout_builtins(m: MirUnit) -> i32 {
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        let name = mir_cpp_layout_builtin_name(m, value_id);
        if (name.len > 0 && mir_cpp_validate_layout_builtin(m, value_id, name) != 0) {
            return 1;
        }
        value_id = value_id + 1;
    }
    return 0;
}

fn mir_cpp_validate_raw_function_casts(m: MirUnit) -> i32 {
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_cast()) {
            let lhs = m.value_lhs(value_id);
            if (lhs != mir_id_invalid()
                && m.value_kind(lhs) == mir_value_target_ref()
                && m.value_target_kind(lhs) == mir_target_function()) {
                let function_id = m.value_target_id(lhs);
                let dst_type = m.value_type(value_id);
                if (mir_cpp_type_is_raw_callback_pointer_target(m, dst_type)
                    && mir_cpp_function_has_hidden_env(m, function_id)) {
                    mir_cpp_report_error_at_value(
                        m, value_id,
                        "cannot expose capturing function "
                        + m.function_name(function_id) + " as a raw pointer");
                    return 1;
                }
                if (mir_cpp_type_is_raw_callback_integer_target(m, dst_type)
                    && mir_cpp_function_needs_raw_callback_adapter(m, function_id)) {
                    if (!mir_cpp_function_can_use_raw_callback_adapter(m, function_id)) {
                        mir_cpp_report_error_at_value(
                            m, value_id,
                            "cannot expose " + m.function_name(function_id)
                            + " as raw callback");
                        return 1;
                    }
                    let ret_type = m.function_return_type(function_id);
                    let ret_kind = mir_cpp_type_kind(m, ret_type);
                    if (ret_kind != ty_VOID()
                        && !mir_cpp_type_is_raw_callback_integer_target(m, ret_type)) {
                        mir_cpp_report_error_at_value(
                            m, value_id,
                            "raw callback adapter return must be void or integer for "
                            + m.function_name(function_id));
                        return 1;
                    }
                }
            }
        }
        value_id = value_id + 1;
    }
    return 0;
}

fn mir_cpp_dci_ctor_call_has_direct_assignment(m: MirUnit, call_value: i32) -> bool {
    var instr_id: i32 = 1;
    while (instr_id <= m.instr_count) {
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && m.instr_kind(instr_id) == mir_instr_assign()
            && mir_cpp_dci_ctor_call_value(m, m.instr_value(instr_id)) == call_value
            && m.instr_place(instr_id) != mir_id_invalid()) {
            return true;
        }
        instr_id = instr_id + 1;
    }
    return false;
}

fn mir_cpp_dci_effective_target_triple() -> string {
    let requested = policy_cli_target_triple();
    if (requested.len > 0) { return requested; }
    return policy_host_target_triple();
}

fn mir_cpp_dci_generic_target_cc(cc: string) -> bool {
    return cc == "default" || cc == "system" || cc == "c" || cc == "cdecl"
        || cc == "cxx_free_function" || cc == "cxx_static_method"
        || cc == "cxx_method" || cc == "cxx_constructor" || cc == "cxx_destructor";
}

fn mir_cpp_dci_calling_convention_is_target_default(symbol: rawptr) -> bool {
    let abi = mir_cpp_dci_json_item(symbol, "abi");
    let abi_cc = mir_cpp_dci_json_string(abi, "calling_convention");
    let symbol_cc = mir_cpp_dci_json_string(symbol, "calling_convention");
    if (abi_cc.len == 0 || (symbol_cc.len > 0 && symbol_cc != abi_cc)) { return false; }
    let triple = mir_cpp_dci_effective_target_triple();
    if (policy_target_arch_name(triple.clone()) != "x64") { return false; }
    let platform = policy_target_platform_name(triple.clone());
    if (platform == "windows") {
        if (!triple.contains("msvc")) { return false; }
        return abi_cc == "win64" || mir_cpp_dci_generic_target_cc(abi_cc);
    }
    if (platform == "linux" || platform == "macos") {
        return abi_cc == "x86_64_sysv" || mir_cpp_dci_generic_target_cc(abi_cc);
    }
    return false;
}

fn mir_cpp_dci_control_flow_boundary(control: rawptr) -> string {
    if (control == null || cJSON_IsObject(control) == 0) { return ""; }
    var boundary = mir_cpp_dci_json_string(control, "default_boundary");
    if (boundary.len == 0) { boundary = mir_cpp_dci_json_string(control, "boundary"); }
    if (boundary.len == 0) {
        boundary = mir_cpp_dci_json_string(mir_cpp_dci_json_item(control, "propagation"), "mode");
    }
    return boundary;
}

fn mir_cpp_dci_no_unwind_control_supported(control: rawptr, require_boundary: bool) -> bool {
    if (control == null || cJSON_IsObject(control) == 0) { return !require_boundary; }
    let boundary = mir_cpp_dci_control_flow_boundary(control);
    if (require_boundary && boundary.len == 0) { return false; }
    if (boundary.len > 0 && boundary != "no_unwind" && boundary != "forbidden") { return false; }
    let propagation = mir_cpp_dci_json_item(control, "propagation");
    if (propagation != null) {
        if (cJSON_IsObject(propagation) == 0
            || mir_cpp_dci_json_string(propagation, "mode") != "forbidden") {
            return false;
        }
    }
    let unwind = mir_cpp_dci_json_string(control, "unwind");
    if (unwind.len > 0 && unwind != "no_unwind" && unwind != "forbidden") { return false; }
    let action = mir_cpp_dci_json_string(control, "boundary_action");
    return action.len == 0 || action == "direct";
}

fn mir_cpp_dci_symbol_control_flow_supported(m: MirUnit, function_id: i32, symbol: rawptr) -> bool {
    if (!mir_cpp_dci_no_unwind_control_supported(
            mir_cpp_dci_json_item(mir_cpp_dci_root(m), "control_flow"), true)) {
        return false;
    }
    if (!mir_cpp_dci_no_unwind_control_supported(
            mir_cpp_dci_json_item(symbol, "control_flow"), false)) {
        return false;
    }
    let unwind = mir_cpp_dci_json_string(mir_cpp_dci_abi_object(m, function_id), "unwind");
    return unwind.len == 0 || unwind == "no_unwind" || unwind == "forbidden";
}

fn mir_cpp_dci_plain_direct_lowering(lowering: rawptr) -> bool {
    if (lowering == null || cJSON_IsObject(lowering) == 0
        || mir_cpp_dci_json_string(lowering, "passing") != "direct") {
        return false;
    }
    return mir_cpp_dci_json_array_is_empty(lowering, "attributes")
        && mir_cpp_dci_json_array_is_empty(lowering, "registers");
}

fn mir_cpp_dci_receiver_supported(m: MirUnit, function_id: i32, symbol: rawptr) -> bool {
    let receiver = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "receiver");
    if (!mir_cpp_dci_function_has_receiver(m, function_id)) {
        return receiver == null || cJSON_IsObject(receiver) == 0;
    }
    if (!mir_cpp_dci_plain_direct_lowering(receiver)) { return false; }
    let type_object = mir_cpp_dci_json_item(receiver, "type");
    let reference = mir_cpp_dci_json_string(type_object, "reference");
    if (reference != "pointer" && reference != "pointer_const" && reference != "pointer_mut") {
        return false;
    }
    if (!mir_cpp_dci_contract_type_names_match(
            mir_cpp_dci_json_string(type_object, "name"),
            mir_unit_foreign_dci_owner_type_text(&m,  function_id))) {
        return false;
    }
    if (!mir_cpp_dci_json_integer_valid(symbol, "this_adjust")
        || !mir_cpp_dci_json_integer_valid(receiver, "this_adjust")) {
        return false;
    }
    let symbol_adjust = mir_cpp_dci_json_exact_i64(symbol, "this_adjust", 0);
    let receiver_adjust = mir_cpp_dci_json_exact_i64(receiver, "this_adjust", symbol_adjust);
    return symbol_adjust == receiver_adjust;
}

fn mir_cpp_dci_parameters_supported(m: MirUnit, function_id: i32) -> bool {
    let abi = mir_cpp_dci_abi_object(m, function_id);
    let variadic = mir_cpp_dci_json_item(abi, "variadic");
    if (variadic != null && cJSON_IsFalse(variadic) == 0) { return false; }
    let parameters = mir_cpp_dci_abi_parameters(m, function_id);
    if (parameters == null) { return false; }
    let receiver_count = mir_cpp_dci_receiver_param_count(m, function_id);
    let explicit_count = mir_unit_function_param_count(&m,  function_id) - receiver_count;
    if (explicit_count < 0 || cJSON_GetArraySize(parameters) != explicit_count) { return false; }
    var source_index: i32 = 0;
    while (source_index < explicit_count) {
        let lowering = mir_cpp_dci_parameter_lowering(m, function_id, source_index);
        let type_id = mir_unit_function_param_type_at(&m,  function_id, source_index + receiver_count);
        if (type_id == mir_id_invalid()) { return false; }
        if (mir_cpp_dci_plain_direct_lowering(lowering)) {
            if (mir_cpp_type_kind(m, type_id) == ty_CLASS()) { return false; }
            let abi_type = mir_cpp_dci_json_item(lowering, "type");
            if (abi_type != null && !mir_cpp_dci_type_object_matches(m, abi_type, type_id)) {
                return false;
            }
        } else {
            if (mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)
                || !mir_cpp_dci_coerce_supported(m, lowering, type_id)) {
                return false;
            }
        }
        source_index = source_index + 1;
    }
    return mir_cpp_dci_json_array_is_empty(abi, "hidden_parameters");
}

fn mir_cpp_dci_return_supported(m: MirUnit, function_id: i32) -> bool {
    let result = mir_cpp_dci_json_item(mir_cpp_dci_abi_object(m, function_id), "return");
    if (mir_unit_function_is_foreign_dci_ctor(&m,  function_id)) {
        if (!mir_cpp_dci_plain_direct_lowering(result)) { return false; }
        let native = mir_cpp_dci_constructor_abi_return_type(m, function_id);
        let triple = mir_cpp_dci_effective_target_triple();
        if (policy_target_platform_name(triple.clone()) == "windows" && triple.contains("msvc")) {
            return native == "void*";
        }
        return native == "void";
    }
    let type_object = mir_cpp_dci_json_item(result, "type");
    if (mir_unit_function_is_foreign_dci_dtor(&m,  function_id)) {
        return mir_cpp_dci_plain_direct_lowering(result)
            && mir_cpp_dci_json_string(type_object, "name") == "void";
    }
    let return_type = m.function_return_type(function_id);
    if (mir_cpp_dci_plain_direct_lowering(result)) {
        if (mir_cpp_type_kind(m, return_type) == ty_CLASS()) { return false; }
        return mir_cpp_dci_type_object_matches(m, type_object, return_type);
    }
    if (mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)) { return false; }
    return mir_cpp_dci_coerce_supported(m, result, return_type);
}

fn mir_cpp_dci_direct_abi_supported(m: MirUnit, function_id: i32, symbol: rawptr) -> bool {
    if (symbol == null) { return false; }
    if (mir_cpp_dci_json_bool(symbol, "is_virtual")
        && !mir_unit_function_is_foreign_dci_dtor(&m,  function_id)
        && !mir_unit_function_is_foreign_dci_final_method(&m,  function_id)) {
        if (!mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)
            || mir_cpp_dci_virtual_slot_offset(m, function_id) < 0) {
            return false;
        }
    }
    if (!mir_cpp_dci_calling_convention_is_target_default(symbol)
        || !mir_cpp_dci_symbol_control_flow_supported(m, function_id, symbol)
        || !mir_cpp_dci_receiver_supported(m, function_id, symbol)
        || !mir_cpp_dci_parameters_supported(m, function_id)
        || !mir_cpp_dci_return_supported(m, function_id)) {
        return false;
    }
    return true;
}

fn mir_cpp_dci_virtual_calls_supported(m: MirUnit) -> bool {
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_call()) {
            let function_id = mir_cpp_call_target_function_id(m, value_id);
            if (function_id != mir_id_invalid()
                && mir_cpp_dci_function_uses_virtual_dispatch(m, function_id)) {
                let receiver = mir_cpp_call_receiver_value(m, m.value_lhs(value_id));
                if (receiver == mir_id_invalid()
                    || (!mir_cpp_dci_call_receiver_is_exact_value_object(m, receiver, function_id)
                        && !mir_cpp_dci_virtual_receiver_supported(m, function_id, receiver))) {
                    return false;
                }
            }
        }
        value_id = value_id + 1;
    }
    return true;
}

fn mir_cpp_dci_descriptor_target(m: MirUnit) -> rawptr {
    let root = mir_cpp_dci_root(m);
    let target = mir_cpp_dci_json_item(root, "target");
    if (target != null && cJSON_IsObject(target) != 0) { return target; }
    let source_target = mir_cpp_dci_json_item(mir_cpp_dci_json_item(root, "source"), "target");
    if (source_target != null && cJSON_IsObject(source_target) != 0) { return source_target; }
    return null;
}

fn mir_cpp_dci_target_supported(m: MirUnit) -> bool {
    let target = mir_cpp_dci_descriptor_target(m);
    if (target == null) { return false; }
    let descriptor_raw = mir_cpp_dci_json_string(target, "triple");
    let descriptor = policy_target_canonical_triple(descriptor_raw);
    let compiler = mir_cpp_dci_effective_target_triple();
    if (descriptor.len == 0 || compiler.len == 0 || descriptor != compiler) { return false; }
    if (policy_target_arch_name(descriptor.clone()) != "x64") { return false; }
    if (mir_cpp_dci_json_exact_i64(target, "pointer_width", -1) != 64) { return false; }
    return mir_cpp_dci_json_string(target, "endianness") == "little";
}

fn mir_cpp_dci_destroy_operation_link_name(operation: rawptr) -> string {
    var name = mir_cpp_dci_json_string(operation, "symbol");
    if (name.len == 0) { name = mir_cpp_dci_json_string(operation, "link_name"); }
    if (name.len == 0) { name = mir_cpp_dci_json_string(operation, "name"); }
    return name;
}

fn mir_cpp_dci_layout_lifecycle_supported(m: MirUnit, type_id: i32) -> bool {
    let layout = mir_cpp_dci_layout_for_type(m, type_id);
    let lifecycle = mir_cpp_dci_json_item(layout, "lifecycle");
    if (lifecycle == null || cJSON_IsObject(lifecycle) == 0) { return false; }
    let destruction = mir_cpp_dci_json_string(lifecycle, "destruction");
    if (destruction == "none" || destruction == "trivial") { return true; }
    if (destruction != "operation") { return false; }
    let operations = mir_cpp_dci_json_item(lifecycle, "operations");
    let destroy = mir_cpp_dci_json_item(operations, "destroy");
    if (destroy == null || cJSON_IsObject(destroy) == 0
        || mir_cpp_dci_json_string(destroy, "availability") != "required"
        || !mir_cpp_dci_json_bool(destroy, "no_unwind")) {
        return false;
    }
    let operation_link_name = mir_cpp_dci_destroy_operation_link_name(destroy);
    if (operation_link_name.len == 0) { return false; }
    let function_id = mir_cpp_dci_destructor_for_type(m, type_id);
    // Streaming materializes only reachable declarations. A base-view type
    // can carry a valid destroy contract without its unused destructor shell
    // being present; when the shell is reachable, still require an exact ABI
    // symbol match.
    if (function_id == mir_id_invalid()) { return true; }
    return operation_link_name == mir_cpp_dci_link_name(m, function_id);
}

fn mir_cpp_dci_assignments_supported(m: MirUnit) -> bool {
    var instr_id: i32 = 1;
    while (instr_id <= m.instr_count) {
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && m.instr_kind(instr_id) == mir_instr_assign()) {
            let place_id = m.instr_place(instr_id);
            if (place_id != mir_id_invalid()
                && mir_unit_type_is_foreign_dci(&m,  m.place_type(place_id))
                && mir_cpp_dci_ctor_call_value(m, m.instr_value(instr_id)) == mir_id_invalid()
                && !mir_cpp_dci_coerce_return_assignment_matches_type(
                    m, m.instr_value(instr_id), m.place_type(place_id))) {
                return false;
            }
        }
        instr_id = instr_id + 1;
    }
    return true;
}

fn mir_cpp_dci_field_places_supported(m: MirUnit) -> bool {
    var place_id: i32 = 1;
    while (place_id <= m.place_count) {
        if (m.place_kind(place_id) == mir_place_field()) {
            let base_place = m.place_base(place_id);
            let base_type = m.place_type(base_place);
            if (mir_unit_type_is_foreign_dci(&m,  base_type)) {
                let field_id = m.place_field(place_id);
                let field_name = mir_cpp_field_source_name(m, field_id);
                let layout = mir_cpp_dci_layout_for_type(m, base_type);
                let field = mir_cpp_dci_field_object(m, layout, field_name, 0);
                if (mir_cpp_dci_field_match_count(m, layout, field_name, 0) != 1
                    || field == null
                    || mir_cpp_dci_field_offset(m, layout, field_name, 0) < 0
                    || !mir_cpp_dci_type_object_matches(
                        m, mir_cpp_dci_json_item(field, "type"), m.place_type(place_id))) {
                    return false;
                }
            }
        }
        place_id = place_id + 1;
    }
    return true;
}

fn mir_cpp_dci_stub_ctor_call_matches_type(m: MirUnit,
                                           value_id: i32,
                                           type_id: i32) -> bool {
    if (value_id == mir_id_invalid() || value_id <= 0 || value_id > m.value_count) { return false; }
    let kind = m.value_kind(value_id);
    if (kind == mir_value_cast() || kind == mir_value_arg()) {
        return mir_cpp_dci_stub_ctor_call_matches_type(m, m.value_lhs(value_id), type_id);
    }
    if (kind != mir_value_call()) { return false; }
    let function_id = mir_cpp_call_target_function_id(m, value_id);
    if (!mir_cpp_function_is_vyx_ctor(m, function_id)) { return false; }
    let self_type = mir_cpp_function_param_type_at(m, function_id, 0);
    return self_type != mir_id_invalid()
        && mir_cpp_dci_type_names_match(mir_cpp_type_source_text(m, self_type),
                                        mir_cpp_type_source_text(m, type_id));
}

fn mir_cpp_dci_stub_ctor_assignment_count(m: MirUnit,
                                          call_value: i32,
                                          type_id: i32) -> i32 {
    var count: i32 = 0;
    var instr_id: i32 = 1;
    while (instr_id <= m.instr_count) {
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && m.instr_kind(instr_id) == mir_instr_assign()) {
            let place_id = m.instr_place(instr_id);
            if (place_id != mir_id_invalid()
                && mir_cpp_dci_stub_ctor_call_matches_type(
                    m, m.instr_value(instr_id), type_id)) {
                let assigned_call = m.instr_value(instr_id);
                var unwrapped = assigned_call;
                while (unwrapped != mir_id_invalid()
                    && (m.value_kind(unwrapped) == mir_value_cast()
                        || m.value_kind(unwrapped) == mir_value_arg())) {
                    unwrapped = m.value_lhs(unwrapped);
                }
                if (unwrapped == call_value
                    && mir_cpp_dci_type_names_match(
                        mir_cpp_type_source_text(m, m.place_type(place_id)),
                        mir_cpp_type_source_text(m, type_id))) {
                    count = count + 1;
                }
            }
        }
        instr_id = instr_id + 1;
    }
    return count;
}

fn mir_cpp_dci_stub_override_matches_base(m: MirUnit,
                                          override_id: i32,
                                          base_id: i32,
                                          base_name: string) -> bool {
    if (!mir_unit_function_is_foreign_dci_virtual_method(&m,  base_id)
        || mir_unit_function_is_foreign_dci_const_method(&m,  base_id)
        || !mir_cpp_dci_type_names_match(
            mir_unit_foreign_dci_owner_type_text(&m,  base_id), base_name)
        // The override may be a closed generic instance member, whose raw name is
        // a mangled identifier; the base (a foreign trait method) keeps its plain
        // source name.  Compare method segments so both sides read `consume`.
        || mir_cpp_function_method_name(m, override_id)
            != mir_cpp_function_method_name(m, base_id)
        || mir_cpp_type_text(m, m.function_return_type(override_id))
            != mir_cpp_type_text(m, m.function_return_type(base_id))) {
        return false;
    }
    let override_count = mir_cpp_function_param_count(m, override_id);
    let base_count = mir_cpp_function_param_count(m, base_id);
    if (override_count != base_count || override_count < 1) { return false; }
    var param_index: i32 = 1;
    while (param_index < override_count) {
        if (mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, override_id, param_index))
            != mir_cpp_type_text(m, mir_cpp_function_param_type_at(m, base_id, param_index))) {
            return false;
        }
        param_index = param_index + 1;
    }
    return true;
}

fn mir_cpp_dci_stub_override_base_match_count(m: MirUnit,
                                              override_id: i32,
                                              base_name: string) -> i32 {
    return mir_cpp_dci_stub_override_base_match_count_at(m, override_id, base_name, 0);
}

fn mir_cpp_dci_stub_override_base_match_count_at(m: MirUnit,
                                                 override_id: i32,
                                                 base_name: string,
                                                 depth: i32) -> i32 {
    // A declaration on the nearest base dominates the same virtual on its
    // ancestors. Keep separate inheritance branches distinct so ambiguous
    // contracts are rejected rather than choosing a method by its name alone.
    if (depth >= 64) { return 2; }
    var count: i32 = 0;
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_cpp_dci_stub_override_matches_base(
                m, override_id, function_id, base_name)) {
            count = count + 1;
        }
        function_id = function_id + 1;
    }
    if (count > 0) { return count; }
    let layout = mir_cpp_dci_layout_for_name(m, base_name);
    let bases = mir_cpp_dci_json_item(layout, "bases");
    if (bases == null || cJSON_IsArray(bases) == 0) { return 0; }
    var base_index: i32 = 0;
    while (base_index < cJSON_GetArraySize(bases)) {
        let base = cJSON_GetArrayItem(bases, base_index);
        let parent_name = mir_cpp_dci_json_string(base, "type_name");
        if (parent_name.len > 0) {
            count = count + mir_cpp_dci_stub_override_base_match_count_at(
                m, override_id, parent_name, depth + 1);
            if (count > 1) { return count; }
        }
        base_index = base_index + 1;
    }
    return count;
}

fn mir_cpp_validate_dci_stubs(m: MirUnit) -> i32 {
    if (!mir_cpp_has_dci_stub_classes(m)) { return 0; }
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_cpp_type_is_dci_stub_class(m, type_id)) {
            let derived = mir_cpp_type_source_text(m, type_id);
            let base = mir_cpp_dci_stub_base_for(m, derived);
            if (base.len == 0 || mir_cpp_dci_stub_base_for(m, base).len > 0) {
                mir_cpp_report_error_at_type(
                    m, type_id,
                    "nested DCI stub inheritance is unsupported for `" + derived + "`");
                return 1;
            }
            if (mir_cpp_dci_layout_for_name(m, base) == null) {
                mir_cpp_report_error_at_type(
                    m, type_id,
                    "DCI stub base has no descriptor layout for `" + derived + "`");
                return 1;
            }
            var field_index: i32 = 0;
            while (field_index < m.field_count_for_type(type_id)) {
                let field_id = m.field_id_for_type_index(type_id, field_index);
                if (mir_cpp_dci_stub_field_offset(m, type_id, field_id) < 0
                    && !mir_cpp_dci_stub_state_field_supported(m, type_id, field_id)) {
                    mir_cpp_report_error_at(
                        mir_unit_diag_loc_for_field(&m,  field_id),
                        "DCI stub field requires an exact foreign field or scalar/borrowed-pointer consumer state: `"
                        + derived + "." + mir_cpp_field_source_name(m, field_id) + "`");
                    return 1;
                }
                field_index = field_index + 1;
            }
            var override_id: i32 = 1;
            while (override_id <= m.function_count) {
                if (mir_cpp_function_is_dci_vyx_override(m, override_id, derived)
                    && mir_cpp_dci_stub_override_base_match_count(
                        m, override_id, base) != 1) {
                    mir_cpp_report_error_at_function(
                        m, override_id,
                        "DCI stub override has no unique supported virtual base method: "
                        + derived + "." + mir_cpp_function_method_name(m, override_id));
                    return 1;
                }
                override_id = override_id + 1;
            }
        }
        type_id = type_id + 1;
    }
    var instr_id: i32 = 1;
    while (instr_id <= m.instr_count) {
        let place_id = m.instr_place(instr_id);
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && m.instr_kind(instr_id) == mir_instr_assign()
            && place_id != mir_id_invalid()
            && mir_cpp_type_is_dci_stub_class(m, m.place_type(place_id))
            && !mir_cpp_dci_stub_ctor_call_matches_type(
                m, m.instr_value(instr_id), m.place_type(place_id))) {
            mir_cpp_report_error_at_instr(
                m, instr_id,
                "DCI stub object assignment requires its constructor result");
            return 1;
        }
        if (!mir_unit_instr_owner_is_removed(&m,  instr_id)
            && m.instr_kind(instr_id) == mir_instr_drop()
            && place_id == mir_id_invalid()
            && m.instr_value(instr_id) != mir_id_invalid()
            && mir_cpp_type_is_dci_stub_class(m, m.value_type(m.instr_value(instr_id)))) {
            mir_cpp_report_error_at_instr(
                m, instr_id,
                "DCI stub drop requires an addressable owning place");
            return 1;
        }
        instr_id = instr_id + 1;
    }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_call()) {
            let function_id = mir_cpp_call_target_function_id(m, value_id);
            if (mir_cpp_function_is_vyx_ctor(m, function_id)) {
                let self_type = mir_cpp_function_param_type_at(m, function_id, 0);
                if (mir_cpp_type_is_dci_stub_class(m, self_type)
                    && mir_cpp_dci_stub_ctor_assignment_count(m, value_id, self_type) != 1) {
                    mir_cpp_report_error_at_value(
                        m, value_id,
                        "DCI stub constructor must initialize exactly one final owning place");
                    return 1;
                }
            }
        }
        value_id = value_id + 1;
    }
    return 0;
}

fn mir_cpp_validate_dci(m: MirUnit) -> i32 {
    if (!mir_unit_has_dci_abi(&m)) {
        var missing_function: i32 = 1;
        while (missing_function <= m.function_count) {
            if (mir_unit_function_is_foreign_dci(&m,  missing_function)) {
                mir_cpp_report_error_at_function(
                    m, missing_function,
                    "external DCI declaration `" + m.function_name(missing_function)
                    + "` requires a DCI descriptor");
                return 1;
            }
            missing_function = missing_function + 1;
        }
        var missing_type: i32 = 1;
        while (missing_type <= m.types.count) {
            if (mir_unit_type_is_foreign_dci(&m,  missing_type)) {
                mir_cpp_report_error_at_type(
                    m, missing_type,
                    "external DCI type `" + mir_cpp_type_source_text(m, missing_type)
                    + "` requires a DCI descriptor");
                return 1;
            }
            missing_type = missing_type + 1;
        }
        return 0;
    }
    let root = mir_cpp_dci_root(m);
    if (root == null) { return 1; }
    let version = mir_cpp_dci_json_string(root, "dci");
    if (version != "1" && !version.startsWith("1.")) {
        mir_cpp_report_error(m, "unsupported DCI version `" + version + "`");
        return 1;
    }
    if (mir_cpp_dci_json_string(root, "kind") != "abi") {
        mir_cpp_report_error(m, "DCI contract kind must be `abi`");
        return 1;
    }
    if (!mir_cpp_dci_target_supported(m)) {
        let target = mir_cpp_dci_descriptor_target(m);
        let descriptor_triple = mir_cpp_dci_json_string(target, "triple");
        let compiler_triple = mir_cpp_dci_effective_target_triple();
        mir_cpp_report_error(m,
                             "unsupported DCI target: descriptor `" + descriptor_triple
                             + "`, compiler `" + compiler_triple + "`");
        return 1;
    }
    var type_id: i32 = 1;
    while (type_id <= m.types.count) {
        if (mir_unit_type_is_foreign_dci(&m,  type_id)) {
            let size = mir_cpp_dci_layout_size(m, type_id);
            let alignment = mir_cpp_dci_layout_alignment(m, type_id);
            if (size <= 0 || alignment <= 0 || !mir_cpp_dci_power_of_two(alignment)) {
                mir_cpp_report_error_at_type(
                    m, type_id,
                    "missing DCI layout for `" + mir_cpp_type_source_text(m, type_id) + "`");
                return 1;
            }
            if (!mir_cpp_dci_layout_lifecycle_supported(m, type_id)) {
                mir_cpp_report_error_at_type(
                    m, type_id,
                    "unsupported DCI lifecycle for `"
                    + mir_cpp_type_source_text(m, type_id) + "`");
                return 1;
            }
        }
        type_id = type_id + 1;
    }
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (mir_unit_function_is_foreign_dci(&m,  function_id)) {
            let symbol = mir_cpp_dci_symbol_for_function(m, function_id);
            if (symbol == null) {
                mir_cpp_report_error_at_function(
                    m, function_id,
                    "missing DCI symbol for `" + m.function_name(function_id) + "`");
                return 1;
            }
            if (!mir_cpp_dci_direct_abi_supported(m, function_id, symbol)) {
                mir_cpp_report_error_at_function(
                    m, function_id,
                    "unsupported direct DCI ABI for `" + m.function_name(function_id) + "`");
                return 1;
            }
        }
        function_id = function_id + 1;
    }
    if (!mir_cpp_dci_virtual_calls_supported(m)) {
        mir_cpp_report_error(m,
                             "unsupported DCI virtual dispatch receiver or table adjustment");
        return 1;
    }
    if (!mir_cpp_dci_field_places_supported(m)) {
        mir_cpp_report_error(m, "unsupported or ambiguous DCI field layout");
        return 1;
    }
    var value_id: i32 = 1;
    while (value_id <= m.value_count) {
        if (m.value_kind(value_id) == mir_value_call()) {
            let called = mir_cpp_call_target_function_id(m, value_id);
            if (called != mir_id_invalid()
                && mir_unit_function_is_foreign_dci_ctor(&m,  called)
                && !mir_cpp_dci_ctor_call_has_direct_assignment(m, value_id)) {
                mir_cpp_report_error_at_value(
                    m, value_id,
                    "DCI constructor `" + m.function_name(called)
                    + "` must initialize a final storage place directly");
                return 1;
            }
        }
        value_id = value_id + 1;
    }
    if (!mir_cpp_dci_assignments_supported(m)) {
        mir_cpp_report_error(m,
                             "DCI object assignment requires a direct constructor into final storage");
        return 1;
    }
    return 0;
}

// MIR2CPP consumes the same lazy MIR queue as LLVM.  A function body is
// rendered while its MIR records are live, then those records are released;
// signatures, layouts, and streaming facts remain in MirUnit for the final
// declaration/header pass.  This avoids a second, eager MIR universe solely
// for C++ export.
public class MirCppStreamingEmitter {
    public out_dir: string
    public module_name: string
    public initialized_function_chunks: string
    public error_count: i32

    public static fn create(out_dir: string, module_name: string) -> MirCppStreamingEmitter {
        return MirCppStreamingEmitter {
            out_dir: out_dir,
            module_name: module_name,
            initialized_function_chunks: "",
            error_count: 0,
        };
    }

    fn function_chunk_path(self, function_id: i32) -> string {
        let chunk = (function_id - 1) / mir_cpp_function_chunk_size();
        return mir_cpp_join(mir_cpp_join(self.out_dir.clone(), "src"),
                            "tu_" + mir_cpp_padded_i32(chunk, 4) + ".cpp");
    }

    fn function_chunk_key(self, function_id: i32) -> string {
        let chunk = (function_id - 1) / mir_cpp_function_chunk_size();
        return "|" + mir_cpp_padded_i32(chunk, 4) + "|";
    }

    fn ensure_function_chunk(self, function_id: i32) -> bool {
        let key = self.function_chunk_key(function_id);
        if (self.initialized_function_chunks.contains(key)) { return true; }
        let path = self.function_chunk_path(function_id);
        if (writeFile(path, "#include \"vyx_generated.hpp\"\n\n") != 0) {
            self.error_count = self.error_count + 1;
            return false;
        }
        self.initialized_function_chunks = self.initialized_function_chunks + key;
        return true;
    }

    fn capture_adapter_needs(self, m: MirUnit, first_value: i32, last_value: i32) {
        var value_id = first_value;
        while (value_id <= last_value && value_id <= m.value_count) {
            if (m.value_kind(value_id) == mir_value_target_ref()
                && m.value_target_kind(value_id) == mir_target_function()
                && !mir_cpp_value_is_call_lhs(m, value_id)
                && mir_cpp_type_is_fn_value(m, m.value_type(value_id))) {
                let target = m.value_target_id(value_id);
                if (target > 0 && target <= m.function_count) {
                    m.set_function_streamed_needs_closure_adapter(target, true);
                }
            }
            if (m.value_kind(value_id) == mir_value_cast()
                && mir_cpp_type_is_raw_callback_integer_target(m, m.value_type(value_id))) {
                let lhs = m.value_lhs(value_id);
                if (lhs != mir_id_invalid()
                    && m.value_kind(lhs) == mir_value_target_ref()
                    && m.value_target_kind(lhs) == mir_target_function()) {
                    let target2 = m.value_target_id(lhs);
                    if (target2 > 0 && target2 <= m.function_count
                        && !mir_cpp_function_raw_callback_abi_compatible(m, target2)) {
                        m.set_function_streamed_needs_raw_callback_adapter(target2, true);
                    }
                }
            }
            value_id = value_id + 1;
        }
    }

    fn emit_live_function(self, m: MirUnit, function_id: i32) -> bool {
        if (m.function_first_block(function_id) == mir_id_invalid()) { return true; }
        if (!self.ensure_function_chunk(function_id)) { return false; }
        let path = self.function_chunk_path(function_id);
        if (appendFile(path, mir_cpp_emit_function(m, function_id)) != 0) {
            self.error_count = self.error_count + 1;
            return false;
        }
        return true;
    }

    fn discard_live_function(self,
                             builder: &mut MirUnitBuilder,
                             function_id: i32,
                             block_mark: i32,
                             local_mark: i32,
                             place_mark: i32,
                             value_mark: i32,
                             instr_mark: i32,
                             case_mark: i32,
                             emitted: bool) {
        builder.unit.discard_recent_body_records(
                                             function_id,
                                             block_mark,
                                             local_mark,
                                             place_mark,
                                             value_mark,
                                             instr_mark,
                                             case_mark);
        if (emitted) {
            builder.unit.set_function_streamed_body_discarded(function_id, true);
        }
    }

    fn stream_function(self,
                       builder: &mut MirUnitBuilder,
                       function_id: i32,
                       opt_level: i32,
                       strict_verify: bool) -> bool {
        if (function_id == mir_id_invalid() || builder.function_is_lowered(function_id)) {
            return false;
        }
        if (builder.function_is_partition_external_root(function_id)
            || builder.function_is_partition_declaration_only(function_id)) {
            builder.mark_function_lowered(function_id);
            return false;
        }
        let hir_function_id = builder.unit.function_hir_id(function_id);
        if (hir_function_id == hir_id_invalid()) {
            builder.mark_function_lowered(function_id);
            return false;
        }
        let block_mark = builder.unit.block_count;
        let local_mark = builder.unit.local_count;
        let place_mark = builder.unit.place_count;
        let value_mark = builder.unit.value_count;
        let instr_mark = builder.unit.instr_count;
        let case_mark = builder.unit.case_count;

        // This is intentionally the same queue discipline as
        // LlvmMirLowerer.lower_streamed_function_from_builder: materialize a
        // parent, drain its new dependencies first, then consume the parent.
        let suspended_queue = builder.suspend_reachable_function_queue();
        builder.build_function_body(hir_function_id);
        builder.enqueue_live_function_target_dependencies(value_mark + 1,
                                                          builder.unit.value_count);
        if (builder.unit.function_first_block(function_id) == mir_id_invalid()) {
            builder.restore_reachable_function_queue(suspended_queue);
            self.discard_live_function(builder,
                                       function_id,
                                       block_mark,
                                       local_mark,
                                       place_mark,
                                       value_mark,
                                       instr_mark,
                                       case_mark,
                                       false);
            return false;
        }
        self.drain(builder, opt_level, strict_verify);
        builder.restore_reachable_function_queue(suspended_queue);

        let pass_errors = mir_run_function_pass_pipeline(&mut builder.unit,
                                                          function_id,
                                                          opt_level,
                                                          strict_verify,
                                                          block_mark,
                                                          local_mark,
                                                          place_mark,
                                                          value_mark,
                                                          instr_mark,
                                                          case_mark);
        if (pass_errors != 0) {
            self.error_count = self.error_count + pass_errors;
            self.discard_live_function(builder,
                                       function_id,
                                       block_mark,
                                       local_mark,
                                       place_mark,
                                       value_mark,
                                       instr_mark,
                                       case_mark,
                                       false);
            return false;
        }
        if (mir_cpp_validate_target_refs(builder.unit) != 0
            || mir_cpp_validate_layout_builtins(builder.unit) != 0
            || mir_cpp_validate_raw_function_casts(builder.unit) != 0) {
            self.error_count = self.error_count + 1;
            self.discard_live_function(builder,
                                       function_id,
                                       block_mark,
                                       local_mark,
                                       place_mark,
                                       value_mark,
                                       instr_mark,
                                       case_mark,
                                       false);
            return false;
        }
        self.capture_adapter_needs(builder.unit, value_mark + 1, builder.unit.value_count);
        let emitted = self.emit_live_function(builder.unit, function_id);
        self.discard_live_function(builder,
                                   function_id,
                                   block_mark,
                                   local_mark,
                                   place_mark,
                                   value_mark,
                                   instr_mark,
                                   case_mark,
                                   emitted);
        return emitted;
    }

    fn drain(self, builder: &mut MirUnitBuilder, opt_level: i32, strict_verify: bool) {
        var function_id = builder.pop_reachable_function();
        while (function_id != mir_id_invalid()) {
            self.stream_function(builder, function_id, opt_level, strict_verify);
            function_id = builder.pop_reachable_function();
        }
    }

    public fn run(self,
                  builder: &mut MirUnitBuilder,
                  opt_level: i32,
                  strict_verify: bool) -> i32 {
        let src_dir = mir_cpp_join(self.out_dir.clone(), "src");
        let include_dir = mir_cpp_join(self.out_dir.clone(), "include");
        mir_cpp_mkdir(self.out_dir.clone());
        mir_cpp_mkdir(src_dir);
        mir_cpp_mkdir(include_dir);

        builder.prepare_streaming_codegen_round();
        self.drain(builder, opt_level, strict_verify);
        builder.prepare_streaming_codegen_round();
        self.drain(builder, opt_level, strict_verify);
        var deferred_retry: i32 = 0;
        while (builder.pending_deferred_materializations() > 0 && deferred_retry < 64) {
            builder.prepare_streaming_codegen_round();
            self.drain(builder, opt_level, strict_verify);
            deferred_retry = deferred_retry + 1;
        }
        let deferred_body_errors = builder.report_unresolved_deferred_function_materializations();
        if (deferred_body_errors > 0) {
            self.error_count = self.error_count + deferred_body_errors;
        }
        builder.finalize_field_layouts_for_refs();
        let emit_rc = mir_cpp_emit_streamed_cmake_project(builder.unit,
                                                           self.out_dir.clone(),
                                                           self.module_name.clone());
        builder.release_build_state();
        if (self.error_count != 0) { return self.error_count; }
        return emit_rc;
    }
}

fn mir_cpp_streamed_function_sources(m: MirUnit) -> string {
    var out = "";
    let chunk_size = mir_cpp_function_chunk_size();
    let chunk_count = mir_cpp_chunk_count(m.function_count, chunk_size);
    var chunk: i32 = 0;
    while (chunk < chunk_count) {
        let first = chunk * chunk_size + 1;
        let last = first + chunk_size - 1;
        var function_id = first;
        var any = false;
        while (function_id <= last && function_id <= m.function_count) {
            if (m.function_streamed_body_discarded(function_id)) {
                any = true;
                break;
            }
            function_id = function_id + 1;
        }
        if (any) { out = out + mir_cpp_function_tu_rel(chunk) + "\n"; }
        chunk = chunk + 1;
    }
    return out;
}

fn mir_cpp_has_streamed_adapters(m: MirUnit) -> bool {
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        if (m.function_streamed_needs_closure_adapter(function_id)
            || m.function_streamed_needs_raw_callback_adapter(function_id)) {
            return true;
        }
        function_id = function_id + 1;
    }
    return false;
}

fn mir_cpp_emit_streamed_adapters_cpp(m: MirUnit) -> string {
    var out = "#include \"vyx_generated.hpp\"\n\n";
    var function_id: i32 = 1;
    while (function_id <= m.function_count) {
        out = out + mir_cpp_emit_closure_adapter_function(m, function_id);
        out = out + mir_cpp_emit_raw_callback_adapter_function(m, function_id);
        function_id = function_id + 1;
    }
    return out;
}

fn mir_cpp_emit_streamed_cmake_project(m: MirUnit, out_dir: string, module_name: string) -> i32 {
    let dci_validate_rc = mir_cpp_validate_dci(m);
    if (dci_validate_rc != 0) { return dci_validate_rc; }
    let dci_stub_validate_rc = mir_cpp_validate_dci_stubs(m);
    if (dci_stub_validate_rc != 0) { return dci_stub_validate_rc; }
    let project_name = "vyx_" + mir_cpp_ident(module_name);
    let src_dir = mir_cpp_join(out_dir.clone(), "src");
    let include_dir = mir_cpp_join(out_dir.clone(), "include");
    let requested_target = policy_cli_requested_target();
    let canonical_triple = policy_target_canonical_triple(requested_target.clone());
    mir_cpp_mkdir(out_dir.clone());
    mir_cpp_mkdir(src_dir.clone());
    mir_cpp_mkdir(include_dir.clone());

    let cmake_path = mir_cpp_join(out_dir.clone(), "CMakeLists.txt");
    let presets_path = mir_cpp_join(out_dir.clone(), "CMakePresets.json");
    let readme_path = mir_cpp_join(out_dir.clone(), "README.md");
    let runtime_path = mir_cpp_join(include_dir.clone(), "vyx_runtime.hpp");
    let generated_header_path = mir_cpp_join(include_dir.clone(), "vyx_generated.hpp");
    let types_header_path = mir_cpp_join(include_dir.clone(), "vyx_types.hpp");
    let type_forwards_path = mir_cpp_join(include_dir.clone(), "vyx_type_forwards.hpp");
    let static_decls_path = mir_cpp_join(include_dir.clone(), "vyx_static_decls.hpp");
    let main_cpp_path = mir_cpp_join(src_dir.clone(), "main.cpp");
    let statics_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_statics.cpp");
    let platform_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_platform.cpp");
    let dci_stubs_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_dci_stubs.cpp");
    let adapters_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_adapters.cpp");
    let generated_sources_path = mir_cpp_generated_sources_path(out_dir.clone());

    var generated_sources = "src/main.cpp\n"
        + "src/vyx_statics.cpp\n"
        + "src/vyx_platform.cpp\n"
        + mir_cpp_streamed_function_sources(m);
    writeFile(main_cpp_path, mir_cpp_emit_main_cpp(m, module_name.clone()));
    writeFile(statics_cpp_path, mir_cpp_emit_statics_cpp(m));
    writeFile(platform_cpp_path, mir_cpp_emit_platform_source());
    if (mir_cpp_has_streamed_adapters(m)) {
        writeFile(adapters_cpp_path, mir_cpp_emit_streamed_adapters_cpp(m));
        generated_sources = generated_sources + "src/vyx_adapters.cpp\n";
    }
    if (mir_cpp_has_dci_stub_classes(m)) {
        let dci_stubs_rc = mir_cpp_emit_dci_stub_source_file(m, dci_stubs_cpp_path);
        if (dci_stubs_rc != 0) { return dci_stubs_rc; }
        generated_sources = generated_sources + "src/vyx_dci_stubs.cpp\n";
    }

    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (fn_chunk < fn_chunk_count) {
        let first_fn = fn_chunk * fn_chunk_size + 1;
        let last_fn = first_fn + fn_chunk_size - 1;
        let declarations_rc = mir_cpp_emit_function_decls_range_to_file(
            m,
            mir_cpp_join(include_dir.clone(), mir_cpp_function_decl_header_name(fn_chunk)),
            first_fn,
            last_fn);
        if (declarations_rc != 0) { return declarations_rc; }
        writeFile(mir_cpp_join(include_dir.clone(), mir_cpp_closure_env_header_name(fn_chunk)),
                  mir_cpp_emit_closure_env_definitions_range(m, first_fn, last_fn));
        fn_chunk = fn_chunk + 1;
    }

    let type_chunk_size = mir_cpp_type_chunk_size();
    let type_chunk_count = mir_cpp_chunk_count(m.types.count, type_chunk_size);
    var type_chunk: i32 = 0;
    while (type_chunk < type_chunk_count) {
        let first_type = type_chunk * type_chunk_size + 1;
        let last_type = first_type + type_chunk_size - 1;
        let type_rc = mir_cpp_emit_type_definitions_range_to_file(
            m,
            mir_cpp_join(include_dir.clone(), mir_cpp_type_def_header_name(type_chunk)),
            first_type,
            last_type);
        if (type_rc != 0) { return type_rc; }
        type_chunk = type_chunk + 1;
    }

    let reflect_chunk_size = mir_cpp_reflect_chunk_size();
    let reflect_chunk_count = mir_cpp_chunk_count(m.types.count, reflect_chunk_size);
    var reflect_chunk: i32 = 0;
    while (reflect_chunk < reflect_chunk_count) {
        let first_type2 = reflect_chunk * reflect_chunk_size + 1;
        let last_type2 = first_type2 + reflect_chunk_size - 1;
        let reflect_fn_rc = mir_cpp_emit_reflected_method_adapter_functions_range_to_file(
            m,
            mir_cpp_join(out_dir.clone(), mir_cpp_reflect_tu_rel(reflect_chunk)),
            first_type2,
            last_type2);
        if (reflect_fn_rc != 0) { return reflect_fn_rc; }
        let reflect_decl_rc = mir_cpp_emit_reflected_method_adapter_decls_range_to_file(
            m,
            mir_cpp_join(include_dir.clone(), mir_cpp_reflect_decl_header_name(reflect_chunk)),
            first_type2,
            last_type2);
        if (reflect_decl_rc != 0) { return reflect_decl_rc; }
        generated_sources = generated_sources + mir_cpp_reflect_tu_rel(reflect_chunk) + "\n";
        reflect_chunk = reflect_chunk + 1;
    }

    writeFile(cmake_path, mir_cpp_emit_cmake_config(project_name.clone(),
                                                    "executable",
                                                    generated_sources.clone(),
                                                    "", "", "", "", "", ""));
    if (requested_target.len > 0) {
        let cmake_dir = mir_cpp_join(out_dir.clone(), "cmake");
        mir_cpp_mkdir(cmake_dir.clone());
        writeFile(mir_cpp_join(cmake_dir, "vyx-target.cmake"),
                  mir_cpp_emit_target_toolchain(canonical_triple,
                                                mir_cpp_cli_sysroot()));
        writeFile(presets_path, mir_cpp_emit_target_presets());
    } else {
        writeFile(presets_path, mir_cpp_emit_presets());
    }
    writeFile(readme_path, mir_cpp_emit_readme(project_name.clone()));
    writeFile(runtime_path, mir_cpp_emit_runtime_header());
    let forwards_rc = mir_cpp_emit_type_forwards_header_to_file(m, type_forwards_path.clone());
    if (forwards_rc != 0) { return forwards_rc; }
    let types_rc = mir_cpp_emit_types_header_to_file(m, types_header_path.clone(), module_name.clone());
    if (types_rc != 0) { return types_rc; }
    writeFile(static_decls_path, mir_cpp_emit_static_decls(m));
    let generated_rc = mir_cpp_emit_generated_header_to_file(m, generated_header_path, module_name);
    if (generated_rc != 0) { return generated_rc; }
    writeFile(generated_sources_path, generated_sources);
    return 0;
}

public fn mir_cpp_emit_cmake_project_streaming_from_builder(builder: &mut MirUnitBuilder,
                                                            out_dir: string,
                                                            module_name: string,
                                                            opt_level: i32,
                                                            strict_verify: bool) -> i32 {
    let emitter = MirCppStreamingEmitter.create(out_dir, module_name);
    return emitter.run(builder, opt_level, strict_verify);
}

public fn mir_cpp_emit_cmake_project(m: MirUnit, out_dir: string, module_name: string) -> i32 {
    if (!mir_cpp_prepare_raw_callback_need_cache(m)) {
        mir_cpp_report_error(m, "cannot allocate raw callback adapter cache");
        return 1;
    }
    let validate_rc = mir_cpp_validate_target_refs(m);
    if (validate_rc != 0) { return validate_rc; }
    let layout_validate_rc = mir_cpp_validate_layout_builtins(m);
    if (layout_validate_rc != 0) { return layout_validate_rc; }
    let callback_validate_rc = mir_cpp_validate_raw_function_casts(m);
    if (callback_validate_rc != 0) { return callback_validate_rc; }
    let dci_validate_rc = mir_cpp_validate_dci(m);
    if (dci_validate_rc != 0) { return dci_validate_rc; }
    let dci_stub_validate_rc = mir_cpp_validate_dci_stubs(m);
    if (dci_stub_validate_rc != 0) { return dci_stub_validate_rc; }
    let project_name = "vyx_" + mir_cpp_ident(module_name);
    let src_dir = mir_cpp_join(out_dir.clone(), "src");
    let include_dir = mir_cpp_join(out_dir.clone(), "include");
    let requested_target = policy_cli_requested_target();
    let canonical_triple = policy_target_canonical_triple(requested_target.clone());
    mir_cpp_mkdir(out_dir.clone());
    mir_cpp_mkdir(src_dir.clone());
    mir_cpp_mkdir(include_dir.clone());

    let cmake_path = mir_cpp_join(out_dir.clone(), "CMakeLists.txt");
    let presets_path = mir_cpp_join(out_dir.clone(), "CMakePresets.json");
    let readme_path = mir_cpp_join(out_dir.clone(), "README.md");
    let runtime_path = mir_cpp_join(include_dir.clone(), "vyx_runtime.hpp");
    let generated_header_path = mir_cpp_join(include_dir.clone(), "vyx_generated.hpp");
    let types_header_path = mir_cpp_join(include_dir.clone(), "vyx_types.hpp");
    let type_forwards_path = mir_cpp_join(include_dir.clone(), "vyx_type_forwards.hpp");
    let static_decls_path = mir_cpp_join(include_dir.clone(), "vyx_static_decls.hpp");
    let main_cpp_path = mir_cpp_join(src_dir.clone(), "main.cpp");
    let statics_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_statics.cpp");
    let platform_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_platform.cpp");
    let dci_stubs_cpp_path = mir_cpp_join(src_dir.clone(), "vyx_dci_stubs.cpp");
    let generated_sources_path = mir_cpp_generated_sources_path(out_dir.clone());

    var generated_sources = "src/main.cpp\n"
        + "src/vyx_statics.cpp\n"
        + "src/vyx_platform.cpp\n";
    writeFile(main_cpp_path, mir_cpp_emit_main_cpp(m, module_name.clone()));
    writeFile(statics_cpp_path, mir_cpp_emit_statics_cpp(m));
    writeFile(platform_cpp_path, mir_cpp_emit_platform_source());
    if (mir_cpp_has_dci_stub_classes(m)) {
        let dci_stubs_rc = mir_cpp_emit_dci_stub_source_file(m, dci_stubs_cpp_path);
        if (dci_stubs_rc != 0) { return dci_stubs_rc; }
        generated_sources = generated_sources + "src/vyx_dci_stubs.cpp\n";
    }

    let fn_chunk_size = mir_cpp_function_chunk_size();
    let fn_chunk_count = mir_cpp_chunk_count(m.function_count, fn_chunk_size);
    var fn_chunk: i32 = 0;
    while (fn_chunk < fn_chunk_count) {
        let rel = mir_cpp_function_tu_rel(fn_chunk);
        let first_fn = fn_chunk * fn_chunk_size + 1;
        let last_fn = first_fn + fn_chunk_size - 1;
        let functions_rc = mir_cpp_emit_functions_range_to_file(m,
                                                                 mir_cpp_join(out_dir.clone(), rel.clone()),
                                                                 first_fn,
                                                                 last_fn);
        if (functions_rc != 0) { return functions_rc; }
        let function_decls_rc = mir_cpp_emit_function_decls_range_to_file(m,
                                                                          mir_cpp_join(include_dir.clone(), mir_cpp_function_decl_header_name(fn_chunk)),
                                                                          first_fn,
                                                                          last_fn);
        if (function_decls_rc != 0) { return function_decls_rc; }
        writeFile(mir_cpp_join(include_dir.clone(), mir_cpp_closure_env_header_name(fn_chunk)),
                  mir_cpp_emit_closure_env_definitions_range(m, first_fn, last_fn));
        generated_sources = generated_sources + rel + "\n";
        fn_chunk = fn_chunk + 1;
    }

    let type_chunk_size = mir_cpp_type_chunk_size();
    let type_chunk_count = mir_cpp_chunk_count(m.types.count, type_chunk_size);
    var type_chunk: i32 = 0;
    while (type_chunk < type_chunk_count) {
        let first_type_emit = type_chunk * type_chunk_size + 1;
        let last_type_emit = first_type_emit + type_chunk_size - 1;
        let type_defs_rc = mir_cpp_emit_type_definitions_range_to_file(m,
                                                                       mir_cpp_join(include_dir.clone(), mir_cpp_type_def_header_name(type_chunk)),
                                                                       first_type_emit,
                                                                       last_type_emit);
        if (type_defs_rc != 0) { return type_defs_rc; }
        type_chunk = type_chunk + 1;
    }

    let reflect_chunk_size = mir_cpp_reflect_chunk_size();
    let reflect_chunk_count = mir_cpp_chunk_count(m.types.count, reflect_chunk_size);
    var reflect_chunk: i32 = 0;
    while (reflect_chunk < reflect_chunk_count) {
        let rel2 = mir_cpp_reflect_tu_rel(reflect_chunk);
        let first_type = reflect_chunk * reflect_chunk_size + 1;
        let last_type = first_type + reflect_chunk_size - 1;
        let reflect_functions_rc = mir_cpp_emit_reflected_method_adapter_functions_range_to_file(m,
                                                                                                  mir_cpp_join(out_dir.clone(), rel2.clone()),
                                                                                                  first_type,
                                                                                                  last_type);
        if (reflect_functions_rc != 0) { return reflect_functions_rc; }
        let reflect_decls_rc = mir_cpp_emit_reflected_method_adapter_decls_range_to_file(m,
                                                                                         mir_cpp_join(include_dir.clone(), mir_cpp_reflect_decl_header_name(reflect_chunk)),
                                                                                         first_type,
                                                                                         last_type);
        if (reflect_decls_rc != 0) { return reflect_decls_rc; }
        generated_sources = generated_sources + rel2 + "\n";
        reflect_chunk = reflect_chunk + 1;
    }

    writeFile(cmake_path, mir_cpp_emit_cmake_config(project_name.clone(),
                                                    "executable",
                                                    generated_sources.clone(),
                                                    "",
                                                    "",
                                                    "",
                                                    "",
                                                    "",
                                                    ""));
    if (requested_target.len > 0) {
        let cmake_dir = mir_cpp_join(out_dir.clone(), "cmake");
        mir_cpp_mkdir(cmake_dir.clone());
        writeFile(mir_cpp_join(cmake_dir, "vyx-target.cmake"),
                  mir_cpp_emit_target_toolchain(canonical_triple,
                                                mir_cpp_cli_sysroot()));
        writeFile(presets_path, mir_cpp_emit_target_presets());
    } else {
        writeFile(presets_path, mir_cpp_emit_presets());
    }
    writeFile(readme_path, mir_cpp_emit_readme(project_name.clone()));
    writeFile(runtime_path, mir_cpp_emit_runtime_header());
    let type_forwards_rc = mir_cpp_emit_type_forwards_header_to_file(m, type_forwards_path.clone());
    if (type_forwards_rc != 0) { return type_forwards_rc; }
    let types_header_rc = mir_cpp_emit_types_header_to_file(m, types_header_path.clone(), module_name.clone());
    if (types_header_rc != 0) { return types_header_rc; }
    writeFile(static_decls_path, mir_cpp_emit_static_decls(m));
    let generated_header_rc = mir_cpp_emit_generated_header_to_file(m,
                                                                     generated_header_path.clone(),
                                                                     module_name.clone());
    if (generated_header_rc != 0) { return generated_header_rc; }
    writeFile(generated_sources_path.clone(), generated_sources.clone());
    return 0;
}

public fn mir_cpp_configure_cmake_project(out_dir: string,
                                          project_name: string,
                                          target_kind: string,
                                          native_sources: string,
                                          include_paths: string,
                                          lib_paths: string,
                                          libs: string,
                                          cflags: string,
                                          cxxflags: string) -> i32 {
    let cmake_path = mir_cpp_join(out_dir.clone(), "CMakeLists.txt");
    let readme_path = mir_cpp_join(out_dir.clone(), "README.md");
    let project_id = "vyx_" + mir_cpp_ident(project_name);
    let generated_sources = mir_cpp_read_generated_sources(out_dir.clone());
    writeFile(cmake_path, mir_cpp_emit_cmake_config(project_id,
                                                    target_kind,
                                                    generated_sources,
                                                    native_sources,
                                                    include_paths,
                                                    lib_paths,
                                                    libs,
                                                    cflags,
                                                    cxxflags));
    writeFile(readme_path, mir_cpp_emit_readme(project_id));
    return 0;
}
