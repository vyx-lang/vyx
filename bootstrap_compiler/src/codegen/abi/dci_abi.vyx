module bootstrap.dci_abi;

use bootstrap.ast;
use bootstrap.dci_ids;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn cJSON_GetObjectItemCaseSensitive(obj: rawptr, key: rawptr) -> rawptr;
    fn cJSON_GetStringValue(obj: rawptr) -> rawptr;
    fn cJSON_IsString(obj: rawptr) -> i32;
    fn cJSON_IsObject(obj: rawptr) -> i32;
    fn cJSON_IsTrue(obj: rawptr) -> i32;
    fn cJSON_IsArray(obj: rawptr) -> i32;
    fn cJSON_GetNumberValue(obj: rawptr) -> f64;
    fn strcmp(lhs: rawptr, rhs: rawptr) -> i32;
}

// A native function pointer is a C callback, never a Vyx closure or a member
// pointer. Unsupported conventions and variadic/noexcept contracts fail closed.
public fn dci_abi_is_cfn_pointer(type_obj: rawptr) -> bool {
    if (dci_abi_json_string(type_obj, "kind") != "function"
        || dci_abi_json_string(type_obj, "reference") != "pointer"
        || dci_abi_json_string(type_obj, "calling_convention") != "cdecl") { return false; }
    let signature = dci_abi_json_item(type_obj, "signature");
    return cJSON_IsArray(dci_abi_json_item(signature, "params")) != 0
        && cJSON_IsObject(dci_abi_json_item(signature, "return")) != 0
        && cJSON_IsTrue(dci_abi_json_item(signature, "variadic")) == 0
        && cJSON_IsTrue(dci_abi_json_item(type_obj, "noexcept")) == 0;
}

fn dci_abi_cfn_param_end(text: string) -> i32 {
    if (!text.startsWith("cfn(")) { return -1; }
    var depth: i32 = 1;
    var i: i32 = 4;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (ch == 40) { depth = depth + 1; }
        if (ch == 41) { depth = depth - 1; }
        if (depth == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

public fn dci_abi_cfn_param_text(text: string, wanted: i32) -> string {
    let end = dci_abi_cfn_param_end(text);
    if (end < 0 || wanted < 0) { return ""; }
    var index: i32 = 0;
    var start: i32 = 4;
    var depth: i32 = 0;
    var angle: i32 = 0;
    var bracket: i32 = 0;
    var i = start;
    while (i <= end) {
        var split = i == end;
        if (!split) {
            let ch = text.charAt(i);
            if (ch == 40) { depth = depth + 1; }
            else if (ch == 41) { depth = depth - 1; }
            else if (ch == 60) { angle = angle + 1; }
            else if (ch == 62 && angle > 0) { angle = angle - 1; }
            else if (ch == 91) { bracket = bracket + 1; }
            else if (ch == 93) { bracket = bracket - 1; }
            else if (ch == 44 && depth == 0 && angle == 0 && bracket == 0) { split = true; }
        }
        if (split) {
            if (index == wanted) { return text.substring(start, i).trim(); }
            index = index + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

public fn dci_abi_cfn_return_text(text: string) -> string {
    let end = dci_abi_cfn_param_end(text);
    if (end < 0 || end + 3 >= text.len || text.substring(end + 1, end + 3) != "->") { return ""; }
    return text.substring(end + 3, text.len).trim();
}

fn dci_abi_json_item(obj: rawptr, key: string) -> rawptr {
    if (obj == null || key.len == 0) { return null; }
    return cJSON_GetObjectItemCaseSensitive(obj, key.c_str());
}

fn dci_abi_json_string(obj: rawptr, key: string) -> string {
    let item = dci_abi_json_item(obj, key);
    if (item == null || cJSON_IsString(item) == 0) { return ""; }
    let raw = cJSON_GetStringValue(item);
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

// Mechanically extracted from LlvmMirLowerer.dci_type_object_name.
public fn dci_abi_type_object_name(type_obj: rawptr) -> string {
    return dci_abi_type_object_name_with_leaf(type_obj, "");
}

fn dci_abi_type_object_name_with_leaf(type_obj: rawptr, canonical_leaf: string) -> string {
    if (type_obj == null) { return ""; }
    let binding = dci_abi_json_string(type_obj, "binding_name");
    if (binding.len > 0) {
        // The producer separately measures a named value view. Preserve the
        // original Rust type; a thin pointer never qualifies for this binding.
        let native = dci_abi_json_string(type_obj, "rust_type");
        let size = cJSON_GetNumberValue(dci_abi_json_item(type_obj, "size"));
        let align = cJSON_GetNumberValue(dci_abi_json_item(type_obj, "alignment"));
        if (cJSON_IsTrue(dci_abi_json_item(type_obj, "wide")) == 0
            || dci_abi_json_string(type_obj, "metadata_kind") != "len"
            || (align != 4.0 && align != 8.0) || size != align * 2.0) { return ""; }
        if (binding == "dci.RustStr") {
            if (native != "&str" && native != "&mut str" && native != "*const str" && native != "*mut str") { return ""; }
            return binding;
        }
        if (!binding.startsWith("dci.RustSlice_")
            || (!native.startsWith("&[") && !native.startsWith("&mut [")
                && !native.startsWith("*const [") && !native.startsWith("*mut ["))) { return ""; }
        return binding;
    }
    let name = dci_abi_json_string(type_obj, "name");
    // Some adapters qualify only the outer name (abi_complex.AbstractSink)
    // while its pointee retains the header-local spelling (AbstractSink).
    // Preserve that exact identity through the independently described layers.
    var leaf = canonical_leaf;
    if (leaf.len == 0) { leaf = name; }
    let reference = dci_abi_json_string(type_obj, "reference");
    if (reference == "pointer" || reference == "pointer_const" || reference == "pointer_mut") {
        // The adapter repeats the terminal name at every pointer layer.
        // Prefer the structured pointee: char** must remain **char, and
        // int*& must retain both its reference and pointer layer.
        let pointee = dci_abi_json_item(type_obj, "pointee");
        if (pointee != null && cJSON_IsObject(pointee) != 0) {
            let inner = dci_abi_type_object_name_with_leaf(pointee, leaf);
            if (inner.len > 0) { return "*" + inner; }
        }
        return "*" + leaf;
    }
    if (reference == "reference") {
        let pointee2 = dci_abi_json_item(type_obj, "pointee");
        if (pointee2 != null && cJSON_IsObject(pointee2) != 0) {
            let inner2 = dci_abi_type_object_name_with_leaf(pointee2, leaf);
            if (inner2.len > 0) { return "&" + inner2; }
        }
        return "&" + leaf;
    }
    return leaf;
}

// Vyx references are lvalue borrows. An imported C++ T&& overload cannot
// match one merely because both machine parameters happen to be pointers.
public fn dci_abi_reference_kind_supported(type_obj: rawptr) -> bool {
    let item = cJSON_GetObjectItemCaseSensitive(type_obj, "reference_kind".c_str());
    let kind = cJSON_GetStringValue(item);
    return kind == null || strcmp(kind, "rvalue".c_str()) != 0;
}

/// True when `raw` has no spaces/tabs, no `::`, and no `.<` turbofish residue.
/// Moved unchanged from `llvm_mir_lower.llvm_mir_dci_type_name_is_plain`.
public fn dci_type_name_is_plain(raw: string) -> bool {
    if (raw.len == 0) { return false; }
    var i: i32 = 0;
    while (i < raw.len) {
        let ch = raw.charAt(i);
        if (ch == 9 || ch == 32 || ch == 58) { return false; }
        if (ch == 46 && (i + 1) < raw.len && raw.charAt(i + 1) == 60) { return false; }
        i = i + 1;
    }
    return true;
}

/// Canonicalise a Vyx or C++ DCI type spelling to one dotted form.
/// Moved unchanged from `LlvmMirLowerer.dci_canonical_type_name_text`.
public fn dci_abi_canonical_type_name_text(raw: string) -> string {
    // Vyx spells a concrete generic instantiation with turbofish
    // (`fmt.basic_string_view::<char>`); after `::`->`.` that leaves a stray
    // `.` before `<`. A DCI contract spells the same C++ template
    // specialization as `fmt::basic_string_view<char>`. Normalising `.<`->`<`
    // makes both forms canonicalise identically so a Vyx instantiation matches
    // the contract record/field/parameter type.
    if (dci_type_name_is_plain(raw)) { return raw; }
    return raw.trim()
        .replace("::", ".")
        .replace("class ", "")
        .replace("struct ", "")
        .replace("enum ", "")
        .replace(" <", "<")
        .replace("< ", "<")
        .replace(" >", ">")
        .replace("> ", ">")
        .replace(" ,", ",")
        .replace(", ", ",")
        .replace(" &", "&")
        .replace("& ", "&")
        .replace(" *", "*")
        .replace("* ", "*")
        .replace(".<", "<");
}

/// Exact match after canonicalisation. Empty names never match.
/// Hot path compares DciTypeId. String equality is the deprecated
/// fallback when the intern table is empty or a name was not indexed.
public fn dci_abi_plain_type_names_match(lhs_raw: string, rhs_raw: string) -> bool {
    if (lhs_raw.len == 0 || rhs_raw.len == 0) { return false; }
    var lhs = lhs_raw;
    var rhs = rhs_raw;
    if (!(dci_type_name_is_plain(lhs_raw) && dci_type_name_is_plain(rhs_raw))) {
        lhs = dci_abi_canonical_type_name_text(lhs_raw);
        rhs = dci_abi_canonical_type_name_text(rhs_raw);
    }
    if (lhs.len == 0 || rhs.len == 0) { return false; }
    let id_l = dci_ids_lookup_type(lhs);
    let id_r = dci_ids_lookup_type(rhs);
    if (id_l > 0 && id_r > 0) { return id_l == id_r; }
    if (dci_ids_type_count() > 0 && (id_l == 0 || id_r == 0) && lhs != rhs) {
        return false;
    }
    return lhs == rhs;
}

/// One-field `{i8}` body for a foreign DCI type with empty layout.
/// Caller still reports the original error string if this returns null.
public fn dci_abi_alloc_empty_i8_layout(ty_i8: rawptr) -> rawptr {
    let fields = malloc(8);
    if (fields == null) { return null; }
    ast_write_rawptr(fields, ty_i8);
    return fields;
}

/// Touch the id shell so `dci_ids` stays in the import graph for WP-J.
public fn dci_abi_id_shell() -> i32 {
    return dci_type_id_invalid() + dci_layout_id_invalid() + dci_symbol_id_invalid();
}
