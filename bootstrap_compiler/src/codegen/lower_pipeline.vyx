module bootstrap.lower_pipeline;

use bootstrap.dci_dcib;
use bootstrap.hir_builder;
use bootstrap.hir_ownership_resolver;
use bootstrap.hir_semantic_resolver;
use bootstrap.hir_verify;
use bootstrap.policy;

extern "C" {
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_now_ms() -> i64;
}

/// Driver-owned HIR prepare: resolve + DCI bind + ownership + verify.
/// Diagnostics come from those passes. This function does not swallow
/// them (the silent helpers are gone) and does not wrap them as codegen failure.
/// Returns 0 when attributes are already in place for lowering.
public fn lower_pipeline_prepare_hir(hbuilder: rawptr,
                                     dci_abi_text: string,
                                     dci_abi_path: string) -> i32 {
    let timing = vyx_bootstrap_profile_level() > 0;
    var mark: i64 = 0;
    if (timing) { mark = vyx_bootstrap_now_ms(); }
    var hunit = hir_codegen_builder_handle_unit(hbuilder);
    let resolve_left = hir_semantic_resolve_unit(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    if (timing) {
        let now = vyx_bootstrap_now_ms();
        print("[hir-prepare-timing] semantic=" + policy_i64_to_string(now - mark));
        mark = now;
    }
    if (resolve_left > 0) { return resolve_left; }
    var lifecycle_errors: i32 = 0;
    if (dci_path_list_count(dci_abi_path.clone()) > 0) {
        lifecycle_errors = hir_bind_dci_lifecycle_paths(hunit, dci_abi_path.clone());
    } else if (dci_abi_text.len > 0) {
        lifecycle_errors = hir_bind_dci_lifecycle_contract(hunit, dci_abi_text.clone());
    }
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    if (lifecycle_errors > 0) { return lifecycle_errors; }
    if (timing) {
        let now = vyx_bootstrap_now_ms();
        print("[hir-prepare-timing] lifecycle=" + policy_i64_to_string(now - mark));
        mark = now;
    }
    let ownership_errors = hir_ownership_resolve_unit(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    if (ownership_errors > 0) { return ownership_errors; }
    if (timing) {
        let now = vyx_bootstrap_now_ms();
        print("[hir-prepare-timing] ownership=" + policy_i64_to_string(now - mark));
        mark = now;
    }
    let hir_errors = hir_verify_unit(hunit);
    hir_codegen_builder_handle_set_unit(hbuilder, hunit);
    if (timing) {
        print("[hir-prepare-timing] verify="
              + policy_i64_to_string(vyx_bootstrap_now_ms() - mark));
    }
    if (hir_errors > 0) { return hir_errors; }
    return 0;
}
