    }

    public fn lower_string_char_at_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var index_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            index_id = self.call_arg_at(value_id, 1);
        } else if (argc != 1) {
            self.report_error("charAt requires receiver plus index");
            return null;
        }
        if (receiver_id == mir_id_invalid() || index_id == mir_id_invalid()) {
            self.report_error("charAt call is missing receiver or index");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("charAt receiver is not str ABI");
            return null;
        }
        let s_value = self.lower_string_view_value(receiver_id);
        let s_ptr = self.string_ptr_value(s_value);
        let s_len = self.string_len_value(s_value);
        let idx = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 64);
        if (s_value == null || s_ptr == null || s_len == null || idx == null) {
            self.report_error("cannot lower charAt operands");
            return null;
        }
        let zero64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let idx_neg = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_slt(),
                                        idx,
                                        zero64,
                                        llvm_mir_empty_name(),
                                        0);
        let idx_ge_len = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_sge(),
                                           idx,
                                           s_len,
                                           llvm_mir_empty_name(),
                                           0);
        let out_of_range = vyx_rt_build_or(self.mod,
                                           idx_neg,
                                           idx_ge_len,
                                           llvm_mir_empty_name(),
                                           0);
        let result_slot = vyx_rt_build_alloca(self.mod,
                                             self.ty_i32,
                                             "mir.charAt.result".c_str(),
                                             17);
        let fail_name = "mir.charAt.fail." + policy_i64_to_string(value_id as i64);
        let load_name = "mir.charAt.load." + policy_i64_to_string(value_id as i64);
        let join_name = "mir.charAt.join." + policy_i64_to_string(value_id as i64);
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fail_name.c_str(),
                                          fail_name.len as u64);
        let load_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          load_name.c_str(),
                                          load_name.len as u64);
        let join_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          join_name.c_str(),
                                          join_name.len as u64);
        if (out_of_range == null || result_slot == null || fail_bb == null || load_bb == null || join_bb == null) {
            self.report_error("cannot create charAt control flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, out_of_range, fail_bb, load_bb);

        vyx_rt_position_at_end(self.mod, fail_bb);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i32, -1, 1), result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, load_bb);
        let ch_ptr = self.ptr_offset_bytes(s_ptr, idx, "mir.charAt.ptr");
        if (ch_ptr == null) {
            self.report_error("cannot compute charAt byte pointer");
            return null;
        }
        let ch = vyx_rt_build_load(self.mod,
                                   self.ty_i8,
                                   ch_ptr,
                                   "mir.charAt.byte".c_str(),
                                   15);
        let ch_i32 = vyx_rt_build_zext(self.mod,
                                       ch,
                                       self.ty_i32,
                                       llvm_mir_empty_name(),
                                       0);
        if (ch == null || ch_i32 == null) {
            self.report_error("cannot load charAt byte");
            return null;
        }
        vyx_rt_build_store(self.mod, ch_i32, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, join_bb);
        return vyx_rt_build_load(self.mod,
                                 self.ty_i32,
                                 result_slot,
                                 "mir.charAt.value".c_str(),
                                 16);
    }

    public fn reflected_method_owner_type_for_function(self, function_id: i32) -> string {
        let owner = self.m.function_owner_type(function_id);
        if (owner.len > 0) { return owner; }
        let first_local = self.function_source_param_local(function_id, 0);
        if (self.local_is_self_receiver_param(first_local)) {
            return llvm_mir_type_text(&self.m, self.m.local_type(first_local));
        }
        return "";
    }

    public fn reflected_method_id_for_function(self, function_id: i32) -> i64 {
        if (function_id == mir_id_invalid()) { return 0; }
        if (!self.function_can_be_declared(function_id)) { return 0; }
        let owner_type = self.reflected_method_owner_type_for_function(function_id);
        let method_name = self.function_method_name(function_id);
        if (owner_type.len == 0 || method_name.len == 0) { return 0; }
        let symbol = llvm_mir_class_method_symbol_name(owner_type, method_name);
        let method_id = llvm_mir_reflect_symbol_id(symbol);
        if (!self.reflection_manifest_has_method_id(method_id)) { return 0; }
        return method_id;
    }

    public fn reflection_manifest_has_method_id(self, method_id: i64) -> bool {
        if (method_id <= 0) { return false; }
        let manifest = mir_unit_reflection_manifest(&self.m);
        if (manifest.len == 0) { return false; }
        return llvm_mir_string_contains(manifest, "~" + policy_i64_to_string(method_id) + "~");
    }

    public fn reflected_method_matches_fn_type(self, method_fn: i32, fn_type_id: i32) -> bool {
        if (method_fn == mir_id_invalid() || fn_type_id == mir_id_invalid()) { return false; }
        if (!self.function_can_be_declared(method_fn)) { return false; }
        let fn_kind = llvm_mir_type_kind(&self.m, fn_type_id);
        if (fn_kind != ty_FN() && fn_kind != ty_CFN()) { return false; }
        let source_count = self.function_source_param_count(method_fn);
        if (source_count <= 0) { return false; }
        let first_local = self.function_source_param_local(method_fn, 0);
        let has_receiver = self.local_is_self_receiver_param(first_local);
        if (!has_receiver) { return false; }
        let target_count = self.fn_type_param_count(fn_type_id);
        var source_arg_start: i32 = 1;
        var target_arg_start: i32 = 0;
        if (fn_kind == ty_FN()) {
            if (target_count != source_count - 1) { return false; }
        } else {
            if (target_count != source_count) { return false; }
            let receiver_param = self.fn_type_param_type_at(fn_type_id, 0);
            if (receiver_param == mir_id_invalid()) { return false; }
            if (!llvm_mir_kind_pointer_like(llvm_mir_type_kind(&self.m, receiver_param))) { return false; }
            target_arg_start = 1;
        }
        if (!self.type_ids_compatible(self.fn_type_return_type(fn_type_id),
                                      self.m.function_return_type(method_fn))) {
            return false;
        }
        var source_idx = source_arg_start;
        var target_idx = target_arg_start;
        while (source_idx < source_count) {
            let source_type = self.function_source_param_type(method_fn, source_idx);
            let target_type = self.fn_type_param_type_at(fn_type_id, target_idx);
            if (!self.type_ids_compatible(source_type, target_type)) { return false; }
            source_idx = source_idx + 1;
            target_idx = target_idx + 1;
        }
        return true;
    }

    public fn reflected_method_adapter_type(self, method_fn: i32, fn_type_id: i32) -> rawptr {
        let fn_kind = llvm_mir_type_kind(&self.m, fn_type_id);
        if (fn_kind == ty_FN()) { return self.build_fn_value_call_type(fn_type_id, true); }
        if (fn_kind == ty_CFN()) { return self.build_fn_value_call_type(fn_type_id, false); }
        self.report_error("reflected method target is not a function type: " + llvm_mir_type_text(&self.m, fn_type_id));
        return null;
    }

    public fn emit_reflected_method_adapter_body(self,
                                                 value_id: i32,
                                                 method_fn: i32,
                                                 fn_type_id: i32,
                                                 adapter_fn: rawptr,
                                                 adapter_type: rawptr) {
        let target_fn = llvm_mir_map_get(self.function_values, method_fn);
        let target_type = llvm_mir_map_get(self.function_types, method_fn);
        if (target_fn == null || target_type == null || adapter_fn == null || adapter_type == null) {
            self.report_error("cannot emit reflected method adapter for " + self.m.function_name(method_fn));
            return;
        }
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let entry_name = "mir.reflect.method.adapter.entry";
        let bb = vyx_rt_append_block(self.mod, adapter_fn, entry_name.c_str(), entry_name.len as u64);
        if (bb == null) {
            self.report_error("cannot create reflected method adapter block for " + self.m.function_name(method_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let source_count = self.function_source_param_count(method_fn);
        var args: rawptr = null;
        if (source_count > 0) {
            args = malloc((source_count * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate reflected method adapter arguments");
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
        }
        let fn_kind = llvm_mir_type_kind(&self.m, fn_type_id);
        var adapter_param_index: i32 = 0;
        var target_param_index: i32 = 0;
        var receiver_param: rawptr = null;
        if (fn_kind == ty_FN()) {
            receiver_param = vyx_rt_get_param(self.mod, adapter_fn, 0);
            adapter_param_index = 1;
            target_param_index = 0;
        } else {
            receiver_param = vyx_rt_get_param(self.mod, adapter_fn, 0);
            adapter_param_index = 1;
            target_param_index = 1;
        }
        if (receiver_param == null) {
            if (args != null) { free(args); }
            self.report_error("cannot read reflected method receiver parameter for " + self.m.function_name(method_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var self_arg = receiver_param;
        let self_type = self.function_source_param_type(method_fn, 0);
        if (!self.source_param_uses_self_pointer_abi(method_fn, 0)) {
            self_arg = vyx_rt_build_load(self.mod,
                                         self.lower_type(self_type),
                                         receiver_param,
                                         "reflect.self".c_str(),
                                         12);
        }
        if (self_arg == null) {
            if (args != null) { free(args); }
            self.report_error("cannot lower reflected method receiver for " + self.m.function_name(method_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        ast_write_rawptr(args, self_arg);
        var source_idx: i32 = 1;
        while (source_idx < source_count) {
            let param_value = vyx_rt_get_param(self.mod, adapter_fn, adapter_param_index as u64);
            let source_type = self.function_source_param_type(method_fn, source_idx);
            let target_param_type = self.fn_type_param_type_at(fn_type_id, target_param_index);
            let arg_value = self.cast_value(param_value, target_param_type, source_type);
            if (param_value == null || arg_value == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower reflected method adapter parameter #"
                          + policy_i64_to_string(source_idx as i64)
                          + " for " + self.m.function_name(method_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            ast_write_rawptr(ptr_offset(args, source_idx * 8), arg_value);
            source_idx = source_idx + 1;
            adapter_param_index = adapter_param_index + 1;
            target_param_index = target_param_index + 1;
        }
        var call_name = "mir.reflect.method.call";
        let method_ret = self.m.function_return_type(method_fn);
        let target_ret = self.fn_type_return_type(fn_type_id);
        if (llvm_mir_type_kind(&self.m, method_ret) == ty_VOID()) { call_name = ""; }
        let result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_fn,
                                       args,
                                       source_count as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        if (llvm_mir_type_kind(&self.m, target_ret) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
        } else if (result != null) {
            let ret_value = self.cast_value(result, method_ret, target_ret);
            if (ret_value == null) {
                self.report_error("cannot cast reflected method adapter return for " + self.m.function_name(method_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            vyx_rt_build_ret(self.mod, ret_value);
        } else {
            self.report_error("cannot emit reflected method adapter return for " + self.m.function_name(method_fn));
        }
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
    }

    public fn reflected_method_adapter_lookup(self,
                                              value_id: i32,
                                              method_fn: i32) -> rawptr {
        var cur = self.reflected_method_adapter_head;
        while (cur != null) {
            if (ast_read_i32(cur) == value_id
                && ast_read_i32(ptr_offset(cur, 4)) == method_fn) {
                return ast_read_rawptr(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    public fn reflected_method_adapter_store(self,
                                             value_id: i32,
                                             method_fn: i32,
                                             adapter_fn: rawptr) -> bool {
        let node = malloc(32);
        if (node == null) { return false; }
        memset(node, 0, 32);
        ast_write_i32(node, value_id);
        ast_write_i32(ptr_offset(node, 4), method_fn);
        ast_write_rawptr(ptr_offset(node, 16), adapter_fn);
        ast_write_rawptr(ptr_offset(node, 24), self.reflected_method_adapter_head);
        self.reflected_method_adapter_head = node;
        return true;
    }

    public fn declare_reflected_method_adapter(self, value_id: i32, method_fn: i32, fn_type_id: i32) -> rawptr {
        let cached = self.reflected_method_adapter_lookup(value_id, method_fn);
        if (cached != null) { return cached; }
        if (!self.declare_function_signature(method_fn)) {
            self.report_error("cannot declare reflected method target " + self.m.function_name(method_fn));
            return null;
        }
        let adapter_type = self.reflected_method_adapter_type(method_fn, fn_type_id);
        if (adapter_type == null) { return null; }
        let name = "mir.reflect.method."
            + policy_mangle_part(self.module_symbol_name)
            + "."
            + policy_i64_to_string(value_id as i64)
            + "."
            + policy_i64_to_string(method_fn as i64);
        let adapter_fn = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, adapter_type);
        if (adapter_fn == null) {
            var detail = self.runtime_last_error();
            if (detail.len > 0) { detail = ": " + detail; }
            self.report_error("cannot declare reflected method adapter " + name + detail);
            return null;
        }
        vyx_rt_set_linkage(self.mod, adapter_fn, 1);
        if (!self.reflected_method_adapter_store(value_id, method_fn, adapter_fn)) {
            self.report_error("cannot cache reflected method adapter " + name);
            return null;
        }
        self.emit_reflected_method_adapter_body(value_id, method_fn, fn_type_id, adapter_fn, adapter_type);
        return adapter_fn;
    }

    public fn lower_reflected_method_raw_ptr_by_id(self, value_id: i32, id_value: rawptr) -> rawptr {
        if (id_value == null) { return null; }
        var out_value = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            let method_id = self.reflected_method_id_for_function(fn_id);
            if (method_id > 0) {
                self.declare_function_signature(fn_id);
                let fn_value = llvm_mir_map_get(self.function_values, fn_id);
                if (fn_value != null) {
                    let eq = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_eq(),
                                               id_value,
                                               vyx_rt_const_int(self.mod, self.ty_i64, method_id, 0),
                                               "reflect.method.ptr.id".c_str(),
                                               21);
                    if (eq != null) {
                        out_value = vyx_rt_build_select(self.mod,
                                                        eq,
                                                        fn_value,
                                                        out_value,
                                                        "reflect.method.ptr".c_str(),
                                                        18);
                    }
                }
            }
            fn_id = fn_id + 1;
        }
        return out_value;
    }

    public fn lower_reflect_method_ptr_by_id_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("reflect_method_ptr_by_id requires exactly one method id");
            return null;
        }
        let id_arg = self.call_arg_at(value_id, 0);
        let id_value = self.lower_value_as(id_arg, self.type_id_by_text("i64"));
        if (id_value == null) {
            self.report_error("cannot lower reflect_method_ptr_by_id method id");
            return null;
        }
        return self.lower_reflected_method_raw_ptr_by_id(value_id, id_value);
    }

    public fn lower_reflect_method_value_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("reflect_method_value requires id, receiver, and receiver flag");
            return null;
        }
        let id_arg = self.call_arg_at(value_id, 0);
        let receiver_arg = self.call_arg_at(value_id, 1);
        let target_type = self.m.value_type(value_id);
        let id_type = self.type_id_by_text("i64");
        let rawptr_type = self.type_id_by_text("rawptr");
        let id_value = self.lower_value_as(id_arg, id_type);
        let receiver_value = self.lower_value_as(receiver_arg, rawptr_type);
        if (id_value == null || receiver_value == null) {
            self.report_error("cannot lower reflect_method_value arguments");
            return null;
        }
        let target_kind = llvm_mir_type_kind(&self.m, target_type);
        if (target_kind != ty_FN() && target_kind != ty_CFN()) {
            if (target_kind == ty_RAWPTR()
                || target_kind == ty_PTR()
                || target_kind == ty_REF()
                || target_kind == ty_MUTREF()) {
                return self.lower_reflected_method_raw_ptr_by_id(value_id, id_value);
            }
            self.report_error("reflect_method_value target is not callable: "
                      + llvm_mir_type_text(&self.m, target_type));
            return null;
        }
        var out_value = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        var matched_any = false;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            let method_id = self.reflected_method_id_for_function(fn_id);
            if (method_id > 0 && self.reflected_method_matches_fn_type(fn_id, target_type)) {
                matched_any = true;
                let adapter = self.declare_reflected_method_adapter(value_id, fn_id, target_type);
                var candidate: rawptr = null;
                if (target_kind == ty_FN()) {
                    candidate = self.build_closure_fat_from_parts(adapter,
                                                                  receiver_value,
                                                                  "reflect.method."
                                                                  + policy_i64_to_string(value_id as i64)
                                                                  + "."
                                                                  + policy_i64_to_string(fn_id as i64));
                } else {
                    candidate = adapter;
                }
                if (candidate != null) {
                    let eq = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_eq(),
                                               id_value,
                                               vyx_rt_const_int(self.mod, self.ty_i64, method_id, 0),
                                               "reflect.method.value.id".c_str(),
                                               23);
                    if (eq != null) {
                        out_value = vyx_rt_build_select(self.mod,
                                                        eq,
                                                        candidate,
                                                        out_value,
                                                        "reflect.method.value".c_str(),
                                                        20);
                    }
                }
            }
            fn_id = fn_id + 1;
        }
        if (!matched_any) {
            self.report_error("reflect_method_value has no callable candidate for "
                      + llvm_mir_type_text(&self.m, target_type));
            return null;
        }
        return out_value;
    }

    public fn lower_fn_value_call(self, value_id: i32) -> rawptr {
        let callee_id = self.m.value_lhs(value_id);
        if (callee_id == mir_id_invalid()) {
            self.report_error("function-value call has no callee");
            return null;
        }
        let fn_type_id = self.m.value_type(callee_id);
        let fn_kind = llvm_mir_type_kind(&self.m, fn_type_id);
        let include_env = fn_kind == ty_FN();
        if (fn_kind != ty_FN() && fn_kind != ty_CFN()) {
            self.report_error("callee is not a function value for value #" + policy_i64_to_string(value_id as i64));
            return null;
        }
        let source_argc = self.call_arg_count(value_id);
        let expected_argc = self.fn_type_param_count(fn_type_id);
        if (fn_kind == ty_CFN()) {
            if (source_argc < expected_argc) {
                self.report_error("function-value call argument count mismatch for " + llvm_mir_type_text(&self.m, fn_type_id));
                return null;
            }
        } elif (source_argc != expected_argc) {
            self.report_error("function-value call argument count mismatch for " + llvm_mir_type_text(&self.m, fn_type_id));
            return null;
        }
        let fty = self.build_fn_value_call_type(fn_type_id, include_env);
        if (fty == null) { return null; }
        let callee_payload = self.lower_value(callee_id);
        if (callee_payload == null) {
            self.report_error("cannot lower function-value callee");
            return null;
        }
        var fn_ptr = callee_payload;
        var env_ptr: rawptr = null;
        var total_argc = source_argc;
        if (include_env) {
            fn_ptr = self.closure_fat_function_value(callee_payload);
            env_ptr = self.closure_fat_env_value(callee_payload);
            total_argc = source_argc + 1;
            if (fn_ptr == null || env_ptr == null) {
                self.report_error("cannot lower function-value fat pointer");
                return null;
            }
        }
        var args: rawptr = null;
        if (total_argc > 0) {
            args = malloc((total_argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate function-value call arguments");
                return null;
            }
        }
        var out_idx: i32 = 0;
        if (include_env) {
            ast_write_rawptr(args, env_ptr);
            out_idx = 1;
        }
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            var param_type = self.fn_type_param_type_at(fn_type_id, i);
            if (param_type == mir_id_invalid() && fn_kind == ty_CFN()) {
                param_type = self.value_effective_type(arg_id);
            }
            if (param_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve function-value parameter #" + policy_i64_to_string(i as i64));
                return null;
            }
            var arg_val = self.lower_value_as(arg_id, param_type);
            if (arg_val != null && !include_env && self.type_uses_c_sysv_direct_coerce(param_type)) {
                arg_val = self.c_sysv_coerce_value(arg_val, param_type, "c.abi.cfn.arg");
            } elif (arg_val != null && !include_env && self.type_uses_c_sysv_memory(param_type)) {
                arg_val = self.materialize_aggregate_pointer_argument(arg_id, param_type, "c.abi.cfn.byval");
            }
            if (arg_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower function-value argument #" + policy_i64_to_string(i as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(args, out_idx * 8), arg_val);
            out_idx = out_idx + 1;
            i = i + 1;
        }
        var call_out_name = "mir.fn.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        if (ret_kind == ty_VOID()) { call_out_name = ""; }
        var out = vyx_rt_build_call(self.mod,
                                    fty,
                                    fn_ptr,
                                    args,
                                    total_argc as u64,
                                    call_out_name.c_str(),
                                    call_out_name.len as u64);
        if (args != null) { free(args); }
        if (out != null && !include_env) {
            let ret_type = self.m.value_type(value_id);
            if (self.type_uses_c_sysv_direct_coerce(ret_type)) {
                out = self.c_sysv_uncoerce_value(out, ret_type, "c.abi.cfn.ret");
            }
        }
        return out;
    }

    public fn lower_dyn_trait_call(self, value_id: i32, prototype_fn: i32) -> rawptr {
        if (prototype_fn == mir_id_invalid()) { return null; }
        let receiver_id = self.direct_call_receiver(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("dyn trait call has no receiver for " + self.m.function_name(prototype_fn));
            return null;
        }
        var dyn_type_id = self.type_dyn_trait_id(self.function_source_param_type(prototype_fn, 0));
        if (dyn_type_id == mir_id_invalid()) {
            dyn_type_id = self.type_dyn_trait_id(self.m.value_type(receiver_id));
        }
        let dyn_type_ok = dyn_type_id != mir_id_invalid();
        var dyn_proto_ok = false;
        if (dyn_type_ok) {
            dyn_proto_ok = self.interface_function_matches_dyn_trait(prototype_fn, dyn_type_id);
        }
        if (!dyn_type_ok || !dyn_proto_ok) {
            self.report_error("cannot resolve dyn trait receiver type for " + self.m.function_name(prototype_fn));
            return null;
        }
        let method_slot = self.dyn_trait_method_slot(dyn_type_id, prototype_fn);
        if (method_slot < 0) {
            self.report_error("cannot resolve dyn trait method slot for " + self.m.function_name(prototype_fn));
            return null;
        }
        let dyn_value = self.lower_value_as(receiver_id, dyn_type_id);
        if (dyn_value == null) {
            self.report_error("cannot lower dyn trait receiver for " + self.m.function_name(prototype_fn));
            return null;
        }
        let data_ptr = self.dyn_trait_field_value(dyn_value, dyn_type_id, 0, "dyn.data");
        let vtable_ptr = self.dyn_trait_field_value(dyn_value, dyn_type_id, 1, "dyn.vtable");
        let vtable_ty = self.get_or_create_dyn_trait_vtable_ty(dyn_type_id);
        var method_ptr: rawptr = null;
        if (vtable_ptr != null && vtable_ty != null) {
            let fn_slot = vyx_rt_build_gep2(self.mod,
                                           vtable_ty,
                                           vtable_ptr,
                                           vyx_rt_const_int(self.mod, self.ty_i32, 0, 1),
                                           vyx_rt_const_int(self.mod, self.ty_i32, method_slot as i64, 1),
                                           "dyn.vtable.fn".c_str(),
                                           13);
            if (fn_slot != null) {
                method_ptr = vyx_rt_build_load(self.mod,
                                               self.ty_ptr,
                                               fn_slot,
                                               "dyn.method".c_str(),
                                               10);
            }
        }
        let fty = self.build_dyn_method_adapter_type(prototype_fn);
        if (data_ptr == null || method_ptr == null || fty == null) {
            self.report_error("cannot lower dyn trait dispatch fields for " + self.m.function_name(prototype_fn));
            return null;
        }
        let source_argc = self.call_arg_count(value_id);
        let expected_argc = self.function_source_param_count(prototype_fn) - 1;
        if (source_argc != expected_argc) {
            self.report_error("dyn trait call argument count mismatch for " + self.m.function_name(prototype_fn));
            return null;
        }
        let total_argc = source_argc + 1;
        var args: rawptr = null;
        if (total_argc > 0) {
            args = malloc((total_argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate dyn trait call arguments for " + self.m.function_name(prototype_fn));
                return null;
            }
        }
        ast_write_rawptr(args, data_ptr);
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_type = self.function_source_param_type(prototype_fn, i + 1);
            if (param_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve dyn trait call parameter #" + policy_i64_to_string(i as i64));
                return null;
            }
            let arg_val = self.lower_value_as(arg_id, param_type);
            if (arg_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn trait call argument #" + policy_i64_to_string(i as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(args, (i + 1) * 8), arg_val);
            i = i + 1;
        }
        var call_out_name = "mir.dyn.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.m.function_return_type(prototype_fn));
        if (ret_kind == ty_VOID()) { call_out_name = ""; }
        let out = vyx_rt_build_call(self.mod,
                                    fty,
                                    method_ptr,
                                    args,
                                    total_argc as u64,
                                    call_out_name.c_str(),
                                    call_out_name.len as u64);
        if (args != null) { free(args); }
        return out;
    }

    public fn function_is_async_task_callable(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return (mir_unit_function_flags(&self.m, function_id) & hir_function_flag_async_task()) != 0;
    }

    public fn async_local_is_pc(self, local_id: i32) -> bool {
        if (local_id == mir_id_invalid()) { return false; }
        return self.m.local_name(local_id).startsWith("__async_pc");
    }

    public fn async_local_is_frame_slot(self, function_id: i32, local_id: i32) -> bool {
        if (!self.function_is_async_task_callable(function_id)) { return false; }
        if (self.local_is_capture(local_id)) { return false; }
        return true;
    }

    public fn async_ctx_param_field(self, idx: i32) -> i32 {
        return 2 + idx;
    }

    // Body rebuilds can reuse HIR-backed locals, including named variables.
    // A reused local has a live place in the rebuilt body; older copies and
    // generated temporaries do not. Dropping a reused named local from the
    // frame puts it on the worker's stack across suspension.
    public fn async_local_precedes_current_body(self, local_id: i32) -> bool {
        return self.async_local_precedes_body_mark(local_id, self.current_body_local_first);
    }

    // Same question against an explicit body mark, for walks that run outside
    // the body they describe (the collect walk, whose mark travels in the
    // slice).
    public fn async_local_precedes_body_mark(self, local_id: i32, body_mark: i32) -> bool {
        if (local_id == mir_id_invalid()) { return true; }
        if (body_mark <= 0) { return false; }
        if (local_id > body_mark) { return false; }
        if (self.m.local_hir_id(local_id) == hir_id_invalid()) { return true; }
        let place = self.m.local_place(local_id);
        if (place == mir_id_invalid() || place > self.m.place_count) { return true; }
        return self.m.place_kind(place) != mir_place_local()
            || self.m.place_local(place) != local_id
            || self.m.place_function(place) != self.m.local_function(local_id);
    }

    public fn async_frame_temp_ordinal(self, function_id: i32, local_id: i32) -> i32 {
        var ord: i32 = 0;
        var cur = self.m.function_first_local(function_id);
        while (cur != mir_id_invalid()) {
            if (!self.local_is_source_param(cur)
                && !self.local_is_capture(cur)
                && !self.async_local_is_pc(cur)
                && !self.async_local_precedes_current_body(cur)) {
                if (cur == local_id) { return ord; }
                ord = ord + 1;
            }
            cur = self.m.local_next(cur);
        }
        return -1;
    }

    public fn async_ctx_field_for_local(self, function_id: i32, local_id: i32) -> i32 {
        if (self.async_local_is_pc(local_id)) { return 1; }
        if (self.local_is_source_param(local_id)) {
            // Parameters keep one chain entry per source parameter across
            // rebuilds -- the builder's local map hands the same MIR local back
            // -- so this walk needs no freshness filter, unlike the temporary
            // arm below. Spawn initializes these frame fields once. A mutable
            // parameter must keep subsequent assignments across suspension.
            var seen: i32 = 0;
            var cur = self.m.function_first_local(function_id);
            while (cur != mir_id_invalid()) {
                if (self.local_is_source_param(cur)) {
                    if (cur == local_id) { return self.async_ctx_param_field(seen); }
                    seen = seen + 1;
                }
                cur = self.m.local_next(cur);
            }
            return -1;
        }
        if (self.async_local_precedes_current_body(local_id)) { return -1; }
        let ord = self.async_frame_temp_ordinal(function_id, local_id);
        if (ord < 0) {
            // Not a stale local, so the chain is genuinely broken: keep the
            // hard failure the caller relied on before stale locals were
            // skipped.
            self.report_error("async temporary " + self.m.local_name(local_id)
                              + " is not in the local chain of "
                              + self.m.function_name(function_id));
            return -1;
        }
        return 2 + self.function_source_param_count(function_id) + ord;
    }

    public fn async_runtime_function(self, name: string) -> i32 {
        let fn_id = self.function_by_exact_name(name);
        if (fn_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (!self.declare_function_signature(fn_id)) { return mir_id_invalid(); }
        return fn_id;
    }

    public fn async_runtime_call0(self, name: string) -> rawptr {
        let fn_id = self.async_runtime_function(name);
        if (fn_id == mir_id_invalid()) { return null; }
        let fn_value = llvm_mir_map_get(self.function_values, fn_id);
        let fn_type = llvm_mir_map_get(self.function_types, fn_id);
        if (fn_value == null || fn_type == null) { return null; }
        return vyx_rt_build_call(self.mod, fn_type, fn_value, null, 0, name.c_str(), name.len as u64);
    }

    public fn async_runtime_call1(self, name: string, arg: rawptr) -> rawptr {
        let fn_id = self.async_runtime_function(name);
        if (fn_id == mir_id_invalid() || arg == null) { return null; }
        let fn_value = llvm_mir_map_get(self.function_values, fn_id);
        let fn_type = llvm_mir_map_get(self.function_types, fn_id);
        if (fn_value == null || fn_type == null) { return null; }
        return vyx_rt_build_call1(self.mod, fn_type, fn_value, arg, name.c_str(), name.len as u64);
    }

    public fn async_pc_local_for_function(self, function_id: i32) -> i32 {
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.async_local_is_pc(local)) { return local; }
            local = self.m.local_next(local);
        }
        return mir_id_invalid();
    }

    public fn async_type_text_is_awaitable(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        var probe = base;
        if (probe.len == 0) { probe = text; }
        let last = self.last_path_segment(probe);
        return last == "Task" || last == "Promise";
    }

    public fn async_payload_type_for_task_type(self, task_type_id: i32) -> i32 {
        if (task_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let text = llvm_mir_type_text(&self.m, task_type_id);
        if (!self.async_type_text_is_awaitable(text)) { return mir_id_invalid(); }
        let args = policy_generic_call_args(text.clone());
        var payload = policy_generic_arg_at(args, 0);
        if (payload.len == 0 || payload == "void") { payload = "i32"; }
        return self.type_id_by_text(payload);
    }

    public fn function_by_exact_name(self, name: string) -> i32 {
        if (name.len == 0) { return mir_id_invalid(); }
        var first_match = mir_id_invalid();
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.m.function_name(fn_id) == name) {
                if (first_match == mir_id_invalid()) { first_match = fn_id; }
                if (self.function_can_be_declared(fn_id)
                    && (self.m.function_first_block(fn_id) != mir_id_invalid()
                        || mir_unit_function_item_kind(&self.m, fn_id) == hir_item_extern_function())) {
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        if (first_match != mir_id_invalid() && self.function_can_be_declared(first_match)) {
            return first_match;
        }
        return mir_id_invalid();
    }

    public fn async_method_for_receiver_type(self, receiver_type_id: i32, method_name: string) -> i32 {
        if (receiver_type_id == mir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type_id);
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_can_be_declared(fn_id)
                && self.function_name_matches_method(self.m.function_name(fn_id), method_name)) {
                let owner_text = self.m.function_owner_type(fn_id);
                if (owner_text == receiver_text || self.type_text_equivalent(owner_text, receiver_text)) {
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        var best_match = mir_id_invalid();
        var best_specificity: i32 = 0;
        fn_id = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_can_be_declared(fn_id)
                && self.function_name_matches_method(self.m.function_name(fn_id), method_name)) {
                let specificity = self.receiver_method_specificity(receiver_type_id, fn_id);
                if (specificity > best_specificity) {
                    best_match = fn_id;
                    best_specificity = specificity;
                }
            }
            fn_id = fn_id + 1;
        }
        return best_match;
    }

    // The async context struct doubles as the coroutine frame: [state:ptr,
    // pc:i32], then the source parameters, then one slot per *temporary* local of
    // the target function.  Those temporary slots are derived from the callee's
    // locals, but under CGU every unit materialises only its own bodies, so the
    // unit that spawns a task cannot see the callee body and derives a context
    // shorter than the one the callee's own unit uses.  The spawn then allocates
    // a frame smaller than the callee writes into (observed as heap corruption
    // when the process exits).  The collect-only walk is the one point that
    // materialises every body once, so record the temporary-slot layout there --
    // type ids are stable across units because the MIR type table is -- and
    // replay it in every unit.  Layout: [temp_count, (type_id, force_ptr)*n].
    // `local_from` is the mark the collect walk froze for this body, so the
    // record holds that build's own temporaries even if the arena still carries
    // locals from an earlier round.
    public fn async_ctx_record_temp_specs(self, function_id: i32, local_from: i32) {
        if (function_id == mir_id_invalid()) { return; }
        if (self.async_ctx_temp_specs == null) { return; }
        if (!self.function_is_async_task_callable(function_id)) { return; }
        if (llvm_mir_map_get(self.async_ctx_temp_specs, function_id) != null) { return; }
        var temp_count: i32 = 0;
        var scan = self.m.function_first_local(function_id);
        while (scan != mir_id_invalid()) {
            if (!self.local_is_source_param(scan)
                && !self.local_is_capture(scan)
                && !self.async_local_is_pc(scan)
                && !self.async_local_precedes_body_mark(scan, local_from)) {
                temp_count = temp_count + 1;
            }
            scan = self.m.local_next(scan);
        }
        let spec = malloc(((1 + temp_count * 2) * 4) as u64);
        if (spec == null) { return; }
        ast_write_i32(spec, temp_count);
        var idx: i32 = 0;
        scan = self.m.function_first_local(function_id);
        while (scan != mir_id_invalid()) {
            if (!self.local_is_source_param(scan)
                && !self.local_is_capture(scan)
                && !self.async_local_is_pc(scan)
                && !self.async_local_precedes_body_mark(scan, local_from)) {
                let base = (1 + idx * 2) * 4;
                ast_write_i32(ptr_offset(spec, base), self.local_effective_type(scan));
                var force_ptr: i32 = 0;
                if (self.local_is_self_pointer_abi_slot(function_id, scan)) { force_ptr = 1; }
                ast_write_i32(ptr_offset(spec, base + 4), force_ptr);
                idx = idx + 1;
            }
            scan = self.m.local_next(scan);
        }
        llvm_mir_map_put(self.async_ctx_temp_specs, function_id, spec);
        if (policy_phase_summary_enabled()) {
            print("[async-ctx] record fn=" + policy_i64_to_string(function_id as i64)
                  + " name=" + self.m.function_name(function_id)
                  + " params=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                  + " temps=" + policy_i64_to_string(temp_count as i64));
        }
    }

    public fn get_or_create_async_context_type(self, target_fn: i32) -> rawptr {
        if (target_fn == mir_id_invalid()) { return null; }
        let cached = llvm_mir_map_get(self.async_context_types, target_fn);
        if (cached != null) { return cached; }
        let param_count = self.function_source_param_count(target_fn);
        // Prefer the layout recorded by the collect-only walk: in an emit unit
        // that does not own `target_fn` the body is not materialised, so
        // scanning locals here would under-count and hand the spawn a frame that
        // is too small.  The scan stays as the fallback for non-CGU builds and
        // for any function the collect walk did not reach.
        let temp_spec = llvm_mir_map_get(self.async_ctx_temp_specs, target_fn);
        var temp_count: i32 = 0;
        if (temp_spec != null) {
            temp_count = ast_read_i32(temp_spec);
        } else {
            var scan = self.m.function_first_local(target_fn);
            while (scan != mir_id_invalid()) {
                if (!self.local_is_source_param(scan)
                    && !self.local_is_capture(scan)
                    && !self.async_local_is_pc(scan)) {
                    temp_count = temp_count + 1;
                }
                scan = self.m.local_next(scan);
            }
        }
        let field_count = param_count + 2 + temp_count;
        if (policy_phase_summary_enabled()) {
            var src_kind: string = "scan";
            if (temp_spec != null) { src_kind = "spec"; }
            print("[async-ctx] create cgu=" + policy_i64_to_string(self.cgu_emit_index as i64)
                  + " fn=" + policy_i64_to_string(target_fn as i64)
                  + " " + src_kind
                  + " params=" + policy_i64_to_string(param_count as i64)
                  + " temps=" + policy_i64_to_string(temp_count as i64)
                  + " fields=" + policy_i64_to_string(field_count as i64));
        }
        let fields = malloc((field_count * 8) as u64);
        if (fields == null) {
            self.report_error("cannot allocate async context field list for " + self.m.function_name(target_fn));
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_i32);
        var idx: i32 = 0;
        while (idx < param_count) {
            let param_type = self.function_source_param_type(target_fn, idx);
            var field_ty = self.lower_type(param_type);
            if (self.source_param_uses_self_pointer_abi(target_fn, idx)) { field_ty = self.ty_ptr; }
            if (field_ty == null) {
                free(fields);
                self.report_error("cannot lower async parameter storage for " + self.m.function_name(target_fn));
                return null;
            }
            ast_write_rawptr(ptr_offset(fields, (idx + 2) * 8), field_ty);
            idx = idx + 1;
        }
        var temp_idx: i32 = 0;
        if (temp_spec != null) {
            while (temp_idx < temp_count) {
                let spec_base = (1 + temp_idx * 2) * 4;
                let recorded_type = ast_read_i32(ptr_offset(temp_spec, spec_base));
                let recorded_force_ptr = ast_read_i32(ptr_offset(temp_spec, spec_base + 4));
                var temp_ty = self.lower_type(recorded_type);
                if (recorded_force_ptr != 0) { temp_ty = self.ty_ptr; }
                if (temp_ty == null) { temp_ty = self.ty_ptr; }
                ast_write_rawptr(ptr_offset(fields, (2 + param_count + temp_idx) * 8), temp_ty);
                temp_idx = temp_idx + 1;
            }
        } else {
            var scan_local = self.m.function_first_local(target_fn);
            while (scan_local != mir_id_invalid()) {
                if (!self.local_is_source_param(scan_local)
                    && !self.local_is_capture(scan_local)
                    && !self.async_local_is_pc(scan_local)) {
                    let effective_type = self.local_effective_type(scan_local);
                    var temp_ty = self.lower_type(effective_type);
                    if (self.local_is_self_pointer_abi_slot(target_fn, scan_local)) { temp_ty = self.ty_ptr; }
                    if (temp_ty == null) { temp_ty = self.ty_ptr; }
                    ast_write_rawptr(ptr_offset(fields, (2 + param_count + temp_idx) * 8), temp_ty);
                    temp_idx = temp_idx + 1;
                }
                scan_local = self.m.local_next(scan_local);
            }
        }
        let name = self.function_symbol_name(target_fn) + "_async_ctx";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            free(fields);
            self.report_error("cannot create async context type for " + self.m.function_name(target_fn));
            return null;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, field_count as u64, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize async context type for " + self.m.function_name(target_fn));
            return null;
        }
        free(fields);
        llvm_mir_map_put(self.async_context_types, target_fn, st);
        return st;
    }

    public fn async_store_task_state(self, task_obj: rawptr, task_type_id: i32, state: rawptr) -> bool {
        if (task_obj == null || state == null || task_type_id == mir_id_invalid()) { return false; }
        let state_addr = self.record_field_addr_for_type(task_obj, task_type_id, "state");
        if (state_addr == null) { return false; }
        vyx_rt_build_store(self.mod, state, state_addr);
        return true;
    }

    public fn async_worker_call_method1(self,
                                        method_fn: i32,
                                        receiver: rawptr,
                                        receiver_type: i32,
                                        name: string) -> rawptr {
        if (method_fn == mir_id_invalid() || receiver == null) { return null; }
        // await_value may return an aggregate through hidden sret storage.
        // Use the normal ABI call path so a missing argument cannot silently
        // omit the await/resolve sequence and leave the outer task pending.
        return self.lower_static_one_arg_raw_call(method_fn, receiver, receiver_type, name);
    }

    public fn async_worker_call_resolve(self,
                                        resolve_fn: i32,
                                        task_obj: rawptr,
                                        task_type_id: i32,
                                        payload: rawptr,
                                        payload_type_id: i32) -> bool {
        if (resolve_fn == mir_id_invalid() || task_obj == null || payload == null) { return false; }
        if (!self.declare_function_signature(resolve_fn)) { return false; }
        let fn_value = llvm_mir_map_get(self.function_values, resolve_fn);
        let fn_type = llvm_mir_map_get(self.function_types, resolve_fn);
        if (fn_value == null || fn_type == null) { return false; }
        let self_param_type = self.function_source_param_type(resolve_fn, 0);
        let payload_param_type = self.function_source_param_type(resolve_fn, 1);
        var self_arg = task_obj;
        if (self_param_type != mir_id_invalid()) {
            self_arg = self.cast_value(task_obj, task_type_id, self_param_type);
        }
        var payload_arg = payload;
        if (payload_param_type != mir_id_invalid()) {
            payload_arg = self.cast_value(payload, payload_type_id, payload_param_type);
        }
        if (self_arg == null || payload_arg == null
            || self.function_llvm_param_count(resolve_fn) != 2) {
            self.report_error("cannot lower async resolve arguments for " + self.m.function_name(resolve_fn));
            return false;
        }
        if (self.source_param_uses_native_byval_abi(resolve_fn, 1)) {
            let storage_ty = self.lower_storage_type(payload_param_type);
            var slot: rawptr = null;
            if (storage_ty != null) {
                slot = vyx_rt_build_alloca(self.mod, storage_ty, "async.payload.byval".c_str(), 19);
            }
            if (slot == null) {
                self.report_error("cannot allocate async payload storage for " + self.m.function_name(resolve_fn));
                return false;
            }
            let alignment = self.native_aggregate_align_bytes(payload_param_type);
            if (alignment > 0) { vyx_rt_set_alignment(self.mod, slot, alignment as i32); }
            vyx_rt_build_store(self.mod, payload_arg, slot);
            payload_arg = slot;
        }
        let args = malloc(16);
        if (args == null) {
            self.report_error("cannot allocate async resolve call args");
            return false;
        }
        ast_write_rawptr(args, self_arg);
        ast_write_rawptr(ptr_offset(args, 8), payload_arg);
        var call = self.build_abi_call(fn_type, fn_value, args, 2, "", resolve_fn);
        if (call != null && !self.apply_native_c_aggregate_abi_attrs(resolve_fn, call)) { call = null; }
        free(args);
        if (call == null) {
            self.report_error("cannot build async resolve call for " + self.m.function_name(resolve_fn)
                              + ": " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn ensure_async_worker_for_function(self,
                                               target_fn: i32,
                                               task_type_id: i32,
                                               payload_type_id: i32) -> rawptr {
        if (target_fn == mir_id_invalid()) { return null; }
        let cached = llvm_mir_map_get(self.async_worker_values, target_fn);
        if (cached != null) { return cached; }
        if (self.function_hidden_env_param_count(target_fn) > 0) {
            self.report_error("async closure env calls are not supported yet for " + self.m.function_name(target_fn));
            return null;
        }
        let ctx_ty = self.get_or_create_async_context_type(target_fn);
        if (ctx_ty == null) { return null; }
        if (!self.declare_function_signature(target_fn)) {
            self.report_error("cannot declare async body function " + self.m.function_name(target_fn));
            return null;
        }
        let await_fn = self.async_method_for_receiver_type(task_type_id, "await_value");
        let resolve_fn = self.async_method_for_receiver_type(task_type_id, "resolve");
        let drop_fn = self.async_method_for_receiver_type(task_type_id, "drop");
        if (await_fn == mir_id_invalid() || resolve_fn == mir_id_invalid()) {
            self.report_error("async lowering cannot resolve Task await/resolve for "
                      + llvm_mir_type_text(&self.m, task_type_id));
            return null;
        }
        self.declare_function_signature(await_fn);
        self.declare_function_signature(resolve_fn);
        if (drop_fn != mir_id_invalid()) { self.declare_function_signature(drop_fn); }

        let pbuf = malloc(8);
        if (pbuf == null) {
            self.report_error("cannot allocate async worker type buffer");
            return null;
        }
        ast_write_rawptr(pbuf, self.ty_ptr);
        let worker_fty = vyx_rt_fn_type(self.mod, self.ty_i32, pbuf, 1, 0);
        free(pbuf);
        if (worker_fty == null) {
            self.report_error("cannot build async worker type for " + self.m.function_name(target_fn));
            return null;
        }
        let worker_name = self.function_symbol_name(target_fn) + "_async_worker";
        let worker_fn = vyx_rt_add_function(self.mod,
                                            worker_name.c_str(),
                                            worker_name.len as u64,
                                            worker_fty);
        if (worker_fn == null) {
            self.report_error("cannot create async worker " + worker_name);
            return null;
        }
        vyx_rt_set_linkage(self.mod, worker_fn, 1);
        llvm_mir_map_put(self.async_worker_values, target_fn, worker_fn);
        llvm_mir_map_put(self.async_worker_types, target_fn, worker_fty);

        let saved_function_id = self.current_function_id;
        let saved_function_value = self.current_function_value;
        let saved_entry_block = self.current_entry_block;
        let saved_block = vyx_rt_get_insert_block(self.mod);

        self.current_function_id = target_fn;
        self.current_function_value = worker_fn;
        self.current_entry_block = null;

        let entry_bb = vyx_rt_append_block(self.mod,
                                           worker_fn,
                                           "entry".c_str(),
                                           5);
        if (entry_bb == null) {
            self.report_error("cannot create async worker entry for " + self.m.function_name(target_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            self.current_function_id = saved_function_id;
            self.current_function_value = saved_function_value;
            self.current_entry_block = saved_entry_block;
            return worker_fn;
        }
        vyx_rt_position_at_end(self.mod, entry_bb);

        let ctx_param = vyx_rt_get_param(self.mod, worker_fn, 0);
        let zero32 = vyx_rt_const_int(self.mod, self.ty_i32, 0, 1);
        let one32 = vyx_rt_const_int(self.mod, self.ty_i32, 1, 1);
        self.async_runtime_call1("vio_async_frame_set", ctx_param);
        let state_ptr = vyx_rt_build_gep2(self.mod,
                                          ctx_ty,
                                          ctx_param,
                                          zero32,
                                          zero32,
                                          "async.state.ptr".c_str(),
                                          15);
        let state = vyx_rt_build_load(self.mod,
                                      self.ty_ptr,
                                      state_ptr,
                                      "async.state".c_str(),
                                      11);
        let param_count = self.function_source_param_count(target_fn);
        var body_args: rawptr = null;
        if (param_count > 0) {
            body_args = malloc((param_count * 8) as u64);
            if (body_args == null) {
                self.report_error("cannot allocate async worker body args for " + self.m.function_name(target_fn));
            }
        }
        var idx: i32 = 0;
        while (idx < param_count && body_args != null) {
            let param_type = self.function_source_param_type(target_fn, idx);
            var param_ll = self.lower_type(param_type);
            if (self.source_param_uses_self_pointer_abi(target_fn, idx)) { param_ll = self.ty_ptr; }
            let field_ptr = vyx_rt_build_gep2(self.mod,
                                              ctx_ty,
                                              ctx_param,
                                              zero32,
                                              vyx_rt_const_int(self.mod, self.ty_i32, (idx + 2) as i64, 1),
                                              "async.arg.ptr".c_str(),
                                              13);
            var arg_value = field_ptr;
            // The frame stores logical values; the native signature can pass
            // aggregate parameters indirectly through byval storage.
            if (!self.source_param_uses_native_byval_abi(target_fn, idx)) {
                arg_value = vyx_rt_build_load(self.mod,
                                               param_ll,
                                               field_ptr,
                                               "async.arg".c_str(),
                                               9);
            }
            if (arg_value == null) {
                self.report_error("cannot lower async worker parameter #" + policy_i64_to_string(idx as i64)
                                  + " for " + self.m.function_name(target_fn));
            }
            ast_write_rawptr(ptr_offset(body_args, idx * 8), arg_value);
            idx = idx + 1;
        }
        let body_fn = llvm_mir_map_get(self.function_values, target_fn);
        let body_fty = llvm_mir_map_get(self.function_types, target_fn);
        var inner_task: rawptr = null;
        if (body_fn != null && body_fty != null && (param_count == 0 || body_args != null)) {
            inner_task = self.build_abi_call(body_fty, body_fn, body_args, param_count as u64,
                                             "async.inner", target_fn);
            if (inner_task != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, inner_task)) {
                inner_task = null;
            }
            if (inner_task == null) {
                self.report_error("cannot build async body call for " + self.m.function_name(target_fn)
                                  + ": " + self.runtime_last_error());
            }
        } else {
            self.report_error("async worker cannot resolve body function " + self.m.function_name(target_fn));
        }
        if (body_args != null) { free(body_args); }

        let pending = self.async_runtime_call0("vio_async_take_pending");
        let pend_bb = vyx_rt_append_block(self.mod, worker_fn, "async.pending".c_str(), 13);
        let ready_bb = vyx_rt_append_block(self.mod, worker_fn, "async.ready".c_str(), 11);
        if (pending == null || pend_bb == null || ready_bb == null) {
            self.report_error("async worker cannot split pending/ready for " + self.m.function_name(target_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            self.current_function_id = saved_function_id;
            self.current_function_value = saved_function_value;
            self.current_entry_block = saved_entry_block;
            return worker_fn;
        }
        let is_pend = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_ne(),
                                        pending,
                                        zero32,
                                        "async.pend".c_str(),
                                        10);
        vyx_rt_build_cond_br(self.mod, is_pend, pend_bb, ready_bb);
        vyx_rt_position_at_end(self.mod, pend_bb);
        vyx_rt_build_ret(self.mod, zero32);
        vyx_rt_position_at_end(self.mod, ready_bb);

        let task_storage_ty = self.class_record_storage_ty(task_type_id);
        var inner_self: rawptr = inner_task;
        if (inner_task != null && task_storage_ty != null) {
            let inner_slot = vyx_rt_build_alloca(self.mod,
                                                 task_storage_ty,
                                                 "async.inner.task".c_str(),
                                                 16);
            if (inner_slot != null) {
                vyx_rt_build_store(self.mod, inner_task, inner_slot);
                inner_self = inner_slot;
            }
        }
        var payload: rawptr = null;
        if (inner_self != null) {
            payload = self.async_worker_call_method1(await_fn,
                                                     inner_self,
                                                     task_type_id,
                                                     "async.payload");
        }
        var outer_task = null;
        if (task_storage_ty != null) {
            outer_task = vyx_rt_build_alloca(self.mod,
                                             task_storage_ty,
                                             "async.outer.task".c_str(),
                                             16);
        }
        if (outer_task != null && self.async_store_task_state(outer_task, task_type_id, state)) {
            if (payload != null) {
                self.async_worker_call_resolve(resolve_fn,
                                               outer_task,
                                               task_type_id,
                                               payload,
                                               payload_type_id);
            }
        } else {
            self.report_error("async worker cannot materialize outer task for "
                      + llvm_mir_type_text(&self.m, task_type_id));
        }
        if (inner_self != null && drop_fn != mir_id_invalid()) {
            self.async_worker_call_method1(drop_fn,
                                           inner_self,
                                           task_type_id,
                                           "");
        }
        if (self.builtin_free_fn != null && self.builtin_free_fty != null && ctx_param != null) {
            vyx_rt_build_call1(self.mod,
                               self.builtin_free_fty,
                               self.builtin_free_fn,
                               ctx_param,
                               llvm_mir_empty_name(),
                               0);
        }
        vyx_rt_build_ret(self.mod, one32);

        self.current_function_id = saved_function_id;
        self.current_function_value = saved_function_value;
        self.current_entry_block = saved_entry_block;
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
        return worker_fn;
    }

    public fn lower_async_task_call(self, value_id: i32, target_fn: i32) -> rawptr {
        if (target_fn == mir_id_invalid()) { return null; }
        if (self.function_hidden_env_param_count(target_fn) > 0) {
            self.report_error_at_value(value_id,
                                       "async closure env calls are not supported yet for `"
                                       + self.m.function_name(target_fn)
                                       + "`");
            return null;
        }
        let task_type_id = self.value_effective_type(value_id);
        let payload_type_id = self.async_payload_type_for_task_type(task_type_id);
        if (payload_type_id == mir_id_invalid()) {
            self.report_error_at_value(value_id,
                                       "async call target does not return Task/Promise: `"
                                       + self.m.function_name(target_fn)
                                       + "`");
            return null;
        }
        let state_new_fn = self.function_by_exact_name("vio_promise_state_new");
        let run_fn = self.function_by_exact_name("vio_sched_spawn");
        let reject_fn = self.function_by_exact_name("vio_promise_state_reject");
        if (state_new_fn == mir_id_invalid() || run_fn == mir_id_invalid() || reject_fn == mir_id_invalid()) {
            self.report_error_at_value(value_id,
                                       "async lowering requires std.vio promise/run helpers");
            return null;
        }
        if (!self.declare_function_signature(state_new_fn)
            || !self.declare_function_signature(run_fn)
            || !self.declare_function_signature(reject_fn)) {
            self.report_error_at_value(value_id,
                                       "cannot declare async runtime helpers");
            return null;
        }
        let state_new_value = llvm_mir_map_get(self.function_values, state_new_fn);
        let state_new_type = llvm_mir_map_get(self.function_types, state_new_fn);
        let run_value = llvm_mir_map_get(self.function_values, run_fn);
        let run_type = llvm_mir_map_get(self.function_types, run_fn);
        let reject_value = llvm_mir_map_get(self.function_values, reject_fn);
        let reject_type = llvm_mir_map_get(self.function_types, reject_fn);
        if (state_new_value == null || state_new_type == null
            || run_value == null || run_type == null
            || reject_value == null || reject_type == null) {
            self.report_error_at_value(value_id,
                                       "cannot resolve async runtime helper symbols");
            return null;
        }
        let ctx_ty = self.get_or_create_async_context_type(target_fn);
        if (ctx_ty == null) { return null; }
        let worker_fn = self.ensure_async_worker_for_function(target_fn, task_type_id, payload_type_id);
        if (worker_fn == null) { return null; }

        let state = vyx_rt_build_call(self.mod,
                                      state_new_type,
                                      state_new_value,
                                      null,
                                      0,
                                      "async.state".c_str(),
                                      11);
        if (state == null) {
            self.report_error_at_value(value_id, "cannot create async promise state");
            return null;
        }
        var ctx_size = vyx_rt_type_alloc_size(self.mod, ctx_ty);
        if (ctx_size <= 0) { ctx_size = ((self.function_source_param_count(target_fn) + 2) * 8) as i64; }
        let ctx = self.malloc_bytes_value(ctx_size, "async.ctx");
        if (ctx == null) { return null; }
        let zero32 = vyx_rt_const_int(self.mod, self.ty_i32, 0, 1);
        let state_ptr = vyx_rt_build_gep2(self.mod,
                                          ctx_ty,
                                          ctx,
                                          zero32,
                                          zero32,
                                          "async.ctx.state".c_str(),
                                          15);
        vyx_rt_build_store(self.mod, state, state_ptr);
        let pc_ptr = vyx_rt_build_gep2(self.mod,
                                         ctx_ty,
                                         ctx,
                                         zero32,
                                         vyx_rt_const_int(self.mod, self.ty_i32, 1, 1),
                                         "async.ctx.pc".c_str(),
                                         12);
        vyx_rt_build_store(self.mod, zero32, pc_ptr);

        let source_argc = self.call_arg_count(value_id);
        let receiver_id = self.direct_call_receiver(value_id);
        var receiver_argc: i32 = 0;
        if (receiver_id != mir_id_invalid()) { receiver_argc = 1; }
        var implicit_self_argc: i32 = 0;
        if (receiver_argc == 0 && self.source_param_uses_self_pointer_abi(target_fn, 0)
            && self.function_is_native_constructor(target_fn)) {
            implicit_self_argc = 1;
        }
        var out_param_idx: i32 = 0;
        if (receiver_argc > 0) {
            let receiver_type = self.function_source_param_type(target_fn, 0);
            var receiver_val: rawptr = null;
            if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                && !self.m.static_exists(self.m.value_target_id(receiver_id))) {
                receiver_val = self.default_value_for_type(receiver_type);
            } else if (self.source_param_uses_self_pointer_abi(target_fn, 0)) {
                if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                    && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                    && self.m.static_exists(self.m.value_target_id(receiver_id))) {
                    receiver_val = self.lower_static_self_receiver_address(receiver_id, receiver_type);
                } else {
                    receiver_val = self.lower_self_receiver_address(receiver_id, receiver_type);
                }
            } else {
                receiver_val = self.lower_value_as(receiver_id, receiver_type);
            }
            if (receiver_val == null) {
                self.report_error_at_value(value_id,
                                           "cannot lower async receiver for `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
            let receiver_ptr = vyx_rt_build_gep2(self.mod,
                                                 ctx_ty,
                                                 ctx,
                                                 zero32,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 2, 1),
                                                 "async.ctx.arg".c_str(),
                                                 13);
            vyx_rt_build_store(self.mod, receiver_val, receiver_ptr);
            out_param_idx = 1;
        }
        if (implicit_self_argc > 0) {
            // Async spawn stores the receiver into a heap ctx consumed by a
            // worker after this frame returns, so the constructor receiver must
            // outlive the caller frame: keep the owning heap allocation here.
            let ctor_receiver_type = self.function_source_param_type(target_fn, 0);
            let ctor_self_val = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(), ctor_receiver_type);
            if (ctor_self_val != null) {
                let ctor_ptr = vyx_rt_build_gep2(self.mod,
                                                 ctx_ty,
                                                 ctx,
                                                 zero32,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 2, 1),
                                                 "async.ctx.arg".c_str(),
                                                 13);
                vyx_rt_build_store(self.mod, ctor_self_val, ctor_ptr);
                out_param_idx = 1;
            }
        }
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_index = i + receiver_argc + implicit_self_argc;
            let param_type = self.function_source_param_type(target_fn, param_index);
            if (param_type == mir_id_invalid()) {
                self.report_error("cannot resolve async argument parameter #"
                          + policy_i64_to_string(param_index as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            let arg_val = self.lower_value_as(arg_id, param_type);
            if (arg_val == null) {
                self.report_error("cannot lower async argument #"
                          + policy_i64_to_string(i as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            let arg_ptr = vyx_rt_build_gep2(self.mod,
                                            ctx_ty,
                                            ctx,
                                            zero32,
                                            vyx_rt_const_int(self.mod, self.ty_i32, (out_param_idx + 2) as i64, 1),
                                            "async.ctx.arg".c_str(),
                                            13);
            vyx_rt_build_store(self.mod, arg_val, arg_ptr);
            out_param_idx = out_param_idx + 1;
            i = i + 1;
        }

        let worker_addr = vyx_rt_build_ptr_to_int(self.mod,
                                                  worker_fn,
                                                  self.ty_i64,
                                                  "async.worker".c_str(),
                                                  12);
        let run_rc = vyx_rt_build_call2(self.mod,
                                        run_type,
                                        run_value,
                                        worker_addr,
                                        ctx,
                                        "async.run".c_str(),
                                        9);
        if (run_rc == null) {
            self.report_error_at_value(value_id, "cannot spawn async worker");
            return null;
        }
        let failed = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_ne(),
                                       run_rc,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                       "async.spawn.failed".c_str(),
                                       18);
        let reject_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            "async.reject".c_str(),
                                            12);
        let ok_bb = vyx_rt_append_block(self.mod,
                                        self.current_function_value,
                                        "async.ok".c_str(),
                                        8);
        if (failed == null || reject_bb == null || ok_bb == null) {
            self.report_error_at_value(value_id, "cannot build async spawn control flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, failed, reject_bb, ok_bb);
        vyx_rt_position_at_end(self.mod, reject_bb);
        let rc64 = vyx_rt_build_sext(self.mod, run_rc, self.ty_i64, llvm_mir_empty_name(), 0);
        vyx_rt_build_call2(self.mod,
                           reject_type,
                           reject_value,
                           state,
                           rc64,
                           llvm_mir_empty_name(),
                           0);
        if (self.builtin_free_fn != null && self.builtin_free_fty != null) {
            vyx_rt_build_call1(self.mod,
                               self.builtin_free_fty,
                               self.builtin_free_fn,
                               ctx,
                               llvm_mir_empty_name(),
                               0);
        }
        vyx_rt_build_br(self.mod, ok_bb);
        vyx_rt_position_at_end(self.mod, ok_bb);

        // Task/Promise is a native value struct (one rawptr field). Methods
        // take `self` as a pointer to that struct, matching Task.ready():
        // alloca + store state + load. Heap class-pointer objects would put
        // the object address into `.state`, and await would treat the Task
        // object as the promise state.
        let task_ty = self.class_record_storage_ty(task_type_id);
        if (task_ty == null) {
            self.report_error_at_value(value_id,
                                       "cannot materialize async task result for "
                                       + llvm_mir_type_text(&self.m, task_type_id));
            return null;
        }
        if (self.type_is_class_pointer_abi(task_type_id)) {
            let task_obj = self.build_zeroed_class_object(task_type_id);
            if (task_obj == null) { return null; }
            if (!self.async_store_task_state(task_obj, task_type_id, state)) {
                self.report_error_at_value(value_id,
                                           "cannot materialize async task result for "
                                           + llvm_mir_type_text(&self.m, task_type_id));
                return null;
            }
            return task_obj;
        }
        let task_slot = vyx_rt_build_alloca(self.mod,
                                            task_ty,
                                            "async.task".c_str(),
                                            10);
        if (task_slot == null) { return null; }
        if (!self.async_store_task_state(task_slot, task_type_id, state)) {
            self.report_error_at_value(value_id,
                                       "cannot materialize async task result for "
                                       + llvm_mir_type_text(&self.m, task_type_id));
            return null;
        }
        let task_val = vyx_rt_build_load(self.mod,
                                         task_ty,
                                         task_slot,
                                         "async.task.val".c_str(),
                                         14);
        if (task_val == null) { return null; }
        return task_val;
    }

    public fn lower_dci_virtual_call(self, value_id: i32, target_fn: i32) -> rawptr {
        if (!self.function_uses_dci_virtual_dispatch(target_fn)) { return null; }
        let receiver_id = self.direct_call_receiver(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error_at_value(value_id,
                                       "external DCI virtual call has no receiver for `"
                                       + self.m.function_name(target_fn)
                                       + "`");
            return null;
        }
        let expected_argc = self.function_source_param_count(target_fn) - 1;
        let source_argc = self.call_arg_count(value_id);
        if (expected_argc != source_argc) {
            self.report_error_at_value(value_id,
                                       "external DCI virtual call argument count mismatch for `"
                                       + self.m.function_name(target_fn)
                                       + "`");
            return null;
        }
        let receiver_type = self.function_source_param_type(target_fn, 0);
        if (receiver_type == mir_id_invalid()) {
            self.report_error("cannot resolve virtual receiver type for " + self.m.function_name(target_fn));
            return null;
        }
        var receiver_val: rawptr = null;
        if (self.m.value_kind(receiver_id) == mir_value_target_ref()
            && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
            && self.m.static_exists(self.m.value_target_id(receiver_id))) {
            receiver_val = self.lower_static_self_receiver_address(receiver_id, receiver_type);
        } else {
            receiver_val = self.lower_self_receiver_address(receiver_id, receiver_type);
        }
        if (receiver_val == null) {
            self.report_error("cannot lower external DCI virtual receiver for "
                      + self.m.function_name(target_fn));
            return null;
        }
        let vtable_base_offset = self.dci_vtable_base_offset_bytes_for_function(target_fn, receiver_type);
        if (vtable_base_offset < 0) {
            // Ask for this instance before failing: whoever regenerates the
            // contract learns the closed instances from the sidecar instead of
            // from a hand-written `--export-instance` list.
            llvm_dci_open_note_instance(self.foreign_dci_owner_type_text(target_fn));
            self.report_error("DCI Descriptor has no dispatch-table base offset for external virtual `"
                      + self.m.function_name(target_fn)
                      + "` (owner=" + self.foreign_dci_owner_type_text(target_fn)
                      + ")");
            return null;
        }
        if (vtable_base_offset > 0) {
            receiver_val = self.ptr_offset_bytes(receiver_val,
                                                 vyx_rt_const_int(self.mod,
                                                                  self.ty_i64,
                                                                  vtable_base_offset,
                                                                  1),
                                                 "dci.vbase");
            if (receiver_val == null) {
                self.report_error("cannot adjust DCI virtual receiver for "
                          + self.m.function_name(target_fn));
                return null;
            }
        }
        let slot_offset = self.dci_vtable_entry_slot_offset_for_function(target_fn);
        if (slot_offset < 0) {
            self.report_error("DCI Descriptor has no dispatch-table slot for external virtual `"
                      + self.m.function_name(target_fn)
                      + "` (owner=" + self.foreign_dci_owner_type_text(target_fn)
                      + ")");
            return null;
        }
        let vtable_ptr_slot = self.ptr_offset_bytes(receiver_val,
                                                    vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                    "dci.vptr.slot");
        let vtable_ptr = vyx_rt_build_load(self.mod,
                                           self.ty_ptr,
                                           vtable_ptr_slot,
                                           "dci.vptr".c_str(),
                                           8);
        if (vtable_ptr == null) {
            self.report_error("cannot load DCI vtable pointer for " + self.m.function_name(target_fn));
            return null;
        }
        let fn_slot = self.ptr_offset_bytes(vtable_ptr,
                                            vyx_rt_const_int(self.mod, self.ty_i64, slot_offset, 1),
                                            "dci.vfn.slot");
        let fn_value = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         fn_slot,
                                         "dci.vfn".c_str(),
                                         7);
        let fn_type = self.build_function_type(target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_error("cannot materialize DCI virtual call target for " + self.m.function_name(target_fn));
            return null;
        }
        var argc: i32 = 0;
        if (self.function_uses_hidden_sret(target_fn)) { argc = argc + 1; }
        argc = argc + self.dci_source_param_llvm_slots(target_fn, 0);
        var argc_i: i32 = 0;
        while (argc_i < source_argc) {
            argc = argc + self.dci_source_param_llvm_slots(target_fn, argc_i + 1);
            argc_i = argc_i + 1;
        }
        if (self.dci_function_inalloca_count(target_fn) > 1) { argc = argc + 1; }
        let args = malloc((argc * 8) as u64);
        if (args == null) {
            self.report_error("cannot allocate DCI virtual call argument list for "
                      + self.m.function_name(target_fn));
            return null;
        }
        if (!self.dci_prepare_inalloca_call_frame(target_fn, args, argc)) {
            free(args);
            return null;
        }
        var out_index: i32 = 0;
        var dci_sret_slot: rawptr = null;
        var virtual_member_sret_after = target_fn != mir_id_invalid()
            && self.dci_member_sret_after_receiver(target_fn);
        if (self.function_uses_hidden_sret(target_fn)) {
            let result_type = self.m.function_return_type(target_fn);
            var result_storage = self.lower_storage_type(result_type);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                result_storage = self.dci_translated_sret_ty(target_fn);
            }
            if (result_storage == null) {
                free(args);
                self.report_error("cannot lower DCI virtual sret storage for "
                          + self.m.function_name(target_fn));
                return null;
            }
            if (self.type_is_class_pointer_abi(result_type)) {
                dci_sret_slot = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(),
                                                                                   result_type);
            } else {
                dci_sret_slot = vyx_rt_build_alloca(self.mod,
                                                    result_storage,
                                                    "dci.virtual.sret".c_str(),
                                                    16);
                let sret_alignment = self.dci_json_i64(self.dci_return_abi(target_fn), "alignment");
                if (dci_sret_slot != null && sret_alignment > 0) {
                    vyx_rt_set_alignment(self.mod, dci_sret_slot, sret_alignment as i32);
                }
            }
            if (dci_sret_slot == null) {
                free(args);
                self.report_error("cannot allocate DCI virtual sret storage for "
                          + self.m.function_name(target_fn));
                return null;
            }
            if (virtual_member_sret_after) {
                ast_write_rawptr(ptr_offset(args, 1 * 8), dci_sret_slot);
            } else {
                ast_write_rawptr(ptr_offset(args, out_index * 8), dci_sret_slot);
                out_index = out_index + 1;
            }
        }
        if (self.dci_source_param_llvm_slots(target_fn, 0) > 0) {
            ast_write_rawptr(ptr_offset(args, out_index * 8), receiver_val);
            out_index = out_index + 1;
            if (virtual_member_sret_after) { out_index = out_index + 1; }
        } else if (self.dci_abi_passing(self.dci_source_parameter_abi(target_fn, 0)) == "inalloca"
            && self.dci_function_inalloca_count(target_fn) > 1) {
            if (!self.dci_store_packed_inalloca_pointer(target_fn,
                                                        0,
                                                        args,
                                                        argc,
                                                        receiver_val,
                                                        self.function_source_param_type(target_fn, 0))) {
                free(args);
                return null;
            }
        } else {
            free(args);
            self.report_error("cannot lower packed DCI virtual receiver for "
                      + self.m.function_name(target_fn));
            return null;
        }
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_type = self.function_source_param_type(target_fn, i + 1);
            if (param_type == mir_id_invalid()) {
                free(args);
                self.report_error("cannot resolve DCI virtual argument parameter #"
                          + policy_i64_to_string(i as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            let next_idx = self.dci_append_call_argument(target_fn,
                                                         i + 1,
                                                         arg_id,
                                                         param_type,
                                                         args,
                                                         out_index,
                                                         argc);
            if (next_idx < 0) {
                free(args);
                self.report_error("cannot lower DCI virtual argument #"
                          + policy_i64_to_string(i as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            out_index = next_idx;
            i = i + 1;
        }
        var out_call_name = "dci.virtual.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.value_effective_type(value_id));
        if (ret_kind == ty_VOID() || dci_sret_slot != null) { out_call_name = ""; }
        var out = self.build_abi_call(fn_type,
                                      fn_value,
                                      args,
                                      argc as u64,
                                      out_call_name,
                                      target_fn);
        if (out != null && !self.apply_dci_callsite_abi_attrs(target_fn, out)) { out = null; }
        if (out != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, out)) { out = null; }
        let call_cc = self.dci_symbol_calling_convention(self.dci_symbol_object_for_function(target_fn));
        if (out != null && call_cc.len > 0
            && vyx_rt_set_calling_convention(self.mod,
                                             out,
                                             call_cc.c_str(),
                                             call_cc.len as u64) != 0) {
            self.report_error("cannot apply DCI virtual calling convention `" + call_cc
                      + "` for `" + self.m.function_name(target_fn)
                      + "`: " + self.runtime_last_error());
            out = null;
        }
        free(args);
        if (out != null && dci_sret_slot != null) {
            let result_type2 = self.m.function_return_type(target_fn);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                out = self.dci_result_from_translated_sret(target_fn, dci_sret_slot);
            } else if (self.type_is_class_pointer_abi(result_type2)) {
                out = dci_sret_slot;
            } else {
                out = vyx_rt_build_load(self.mod,
                                        self.lower_type(result_type2),
                                        dci_sret_slot,
                                        "dci.virtual.sret.value".c_str(),
                                        22);
            }
        } else if (out != null
            && self.dci_abi_passing(self.dci_return_abi(target_fn)) == "coerce") {
            out = self.dci_uncoerce_return_value(out,
                                                 target_fn,
                                                 self.m.function_return_type(target_fn));
        }
        if (out != null) {
            out = self.wrap_foreign_direct_pointer_return(out,
                                                          target_fn,
                                                          "dci.virtual.return.ptr");
        }
        if (out == null) {
            self.report_error("cannot build DCI virtual call for "
                      + self.m.function_name(target_fn)
                      + " runtime=" + self.runtime_last_error());
        }
        return out;
    }

    public fn dci_materialize_indirect_argument(self,
                                                value_id: i32,
                                                type_id: i32,
                                                lowering: rawptr,
                                                label: string) -> rawptr {
        if (self.type_is_class_pointer_abi(type_id)) {
            self.report_error("DCI class-by-value indirect argument requires lifecycle materialization");
            return null;
        }
        let storage_type = self.lower_storage_type(type_id);
        let value = self.lower_value_as(value_id, type_id);
        if (storage_type == null || value == null) { return null; }
        let slot = vyx_rt_build_alloca(self.mod, storage_type, label.c_str(), label.len as u64);
        if (slot == null) { return null; }
        var alignment = self.dci_json_i64(lowering, "alignment");
        if (alignment <= 0) { alignment = self.dci_type_value_alignment(type_id); }
        if (alignment > 0) { vyx_rt_set_alignment(self.mod, slot, alignment as i32); }
        if (self.dci_abi_passing(lowering) == "inalloca") {
            if (vyx_rt_set_alloca_inalloca(self.mod, slot) != 0) {
                self.report_error("cannot mark DCI inalloca slot: "
                          + self.runtime_last_error());
                return null;
            }
        }
        vyx_rt_build_store(self.mod, value, slot);
        return slot;
    }

    public fn dci_value_parameter_lifecycle_supported(self,
                                                       function_id: i32,
                                                       source_index: i32,
                                                       type_id: i32) -> bool {
        let parameter = self.dci_source_parameter_object(function_id, source_index);
        let type_object = self.dci_json_item(parameter, "type");
        if (self.dci_json_string(type_object, "reference") != "value") { return true; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (!mir_unit_type_is_foreign_dci(&self.m, canonical_type)
            || llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) {
            return true;
        }
        if (!self.dci_type_uses_stable_value_layout(canonical_type)) {
            let lowering = self.dci_source_parameter_abi(function_id, source_index);
            let passing = self.dci_abi_passing(lowering);
            self.report_error("DCI class-by-value " + passing
                      + " argument requires lifecycle materialization");
            return false;
        }
        let layout = self.dci_layout_object_for_type(type_id);
        if (layout == null) { return true; }
        var has_trivial_evidence = false;
        var nontrivial = false;
        let pod_item = self.dci_json_item(layout, "is_pod");
        let trivial_destroy_item = self.dci_json_item(layout, "is_trivially_destructible");
        // A non-POD type is NOT thereby non-trivial to pass by value: POD also
        // demands a trivial default constructor, which is irrelevant to copying
        // an already-built object. What actually matters is trivially-copyable
        // (copy/move) + trivially-destructible, checked from the lifecycle below.
        // fmt::basic_string_view<char> is non-POD (user default ctor) yet fully
        // trivial to copy and destroy.
        if (trivial_destroy_item != null && cJSON_IsFalse(trivial_destroy_item) != 0) {
            nontrivial = true;
        }
        if (pod_item != null && cJSON_IsTrue(pod_item) != 0
            && trivial_destroy_item != null && cJSON_IsTrue(trivial_destroy_item) != 0) {
            has_trivial_evidence = true;
        }
        let lifecycle = self.dci_json_item(layout, "lifecycle");
        if (lifecycle != null && cJSON_IsObject(lifecycle) != 0) {
            let copy_semantics = self.dci_json_string(lifecycle, "copy_semantics");
            let move_semantics = self.dci_json_string(lifecycle, "move_semantics");
            let destruction = self.dci_json_string(lifecycle, "destruction");
            if (copy_semantics == "trivial" && move_semantics == "trivial"
                && (destruction == "trivial" || destruction == "none")) {
                has_trivial_evidence = true;
            }
            if ((copy_semantics.len > 0 && copy_semantics != "trivial")
                || (move_semantics.len > 0 && move_semantics != "trivial")
                || (destruction.len > 0 && destruction != "trivial" && destruction != "none")) {
                nontrivial = true;
            }
        }
        if (has_trivial_evidence && !nontrivial) { return true; }
        var ownership = self.dci_json_string(parameter, "ownership");
        if (ownership.len == 0) { ownership = "unspecified"; }
        self.report_error("DCI value parameter #" + source_index.toString()
                  + " of `" + self.m.function_name(function_id) + "` with ownership `"
                  + ownership
                  + "` requires lifecycle materialization because triviality is not proven");
        return false;
    }

    public fn dci_coerce_argument(self,
                                  value_id: i32,
                                  type_id: i32,
                                  lowering: rawptr) -> rawptr {
        if (!self.dci_coerce_contract_supported(type_id,
                                                lowering,
                                                "call argument")) {
            return null;
        }
        let coerce_type = self.dci_abi_coerce_type(lowering);
        let storage_type = self.lower_storage_type(type_id);
        let value = self.lower_value_as(value_id, type_id);
        if (coerce_type == null || storage_type == null || value == null) { return null; }
        if (self.type_is_class_pointer_abi(type_id)) {
            self.report_error("DCI class-by-value coerce argument requires lifecycle materialization");
            return null;
        }
        let slot = vyx_rt_build_alloca(self.mod, storage_type, "dci.coerce.arg".c_str(), 14);
        if (slot == null) { return null; }
        var alignment = self.dci_json_i64(lowering, "alignment");
        if (alignment <= 0) { alignment = self.dci_type_value_alignment(type_id); }
        if (alignment > 0) {
            vyx_rt_set_alignment(self.mod, slot, alignment as i32);
            if (vyx_rt_build_store_aligned(self.mod,
                                           value,
                                           slot,
                                           alignment as i32) == null) {
                self.report_error("cannot store DCI coerce argument with contract alignment");
                return null;
            }
            return vyx_rt_build_load_aligned(self.mod,
                                             coerce_type,
                                             slot,
                                             alignment as i32,
                                             "dci.coerce.bits".c_str(),
                                             15);
        }
        vyx_rt_build_store(self.mod, value, slot);
        return vyx_rt_build_load(self.mod,
                                 coerce_type,
                                 slot,
                                 "dci.coerce.bits".c_str(),
                                 15);
    }

    public fn dci_append_call_argument(self,
                                       function_id: i32,
                                       source_index: i32,
                                       value_id: i32,
                                       type_id: i32,
                                       args: rawptr,
                                       out_idx: i32,
                                       argc: i32) -> i32 {
        let lowering = self.dci_source_parameter_abi(function_id, source_index);
        if (self.function_is_foreign_dci(function_id)
            && self.dci_abi_passing(lowering) == "inalloca"
            && self.dci_function_inalloca_count(function_id) > 1) {
            if (!self.dci_value_parameter_lifecycle_supported(function_id,
                                                              source_index,
                                                              type_id)) {
                return -1;
            }
            if (!self.dci_store_packed_inalloca_value(function_id,
                                                      source_index,
                                                      args,
                                                      argc,
                                                      value_id,
                                                      type_id)) {
                return -1;
            }
            return out_idx;
        }
        if (self.function_is_foreign_dci(function_id)
            && self.dci_abi_passing(lowering) == "split") {
            if (!self.dci_split_contract_supported(type_id, lowering, "call argument")) {
                return -1;
            }
            let value = self.lower_value_as(value_id, type_id);
            let storage_type = self.lower_storage_type(type_id);
            if (value == null || storage_type == null) { return -1; }
            let slot = vyx_rt_build_alloca(self.mod, storage_type, "dci.split.arg".c_str(), 13);
            if (slot == null) { return -1; }
            var alignment = self.dci_json_i64(lowering, "alignment");
            if (alignment <= 0) { alignment = self.dci_type_value_alignment(type_id); }
            if (alignment > 0) {
                vyx_rt_set_alignment(self.mod, slot, alignment as i32);
                if (vyx_rt_build_store_aligned(self.mod, value, slot, alignment as i32) == null) {
                    return -1;
                }
            } else {
                vyx_rt_build_store(self.mod, value, slot);
            }
            let n = self.dci_register_count(lowering);
            var i: i32 = 0;
            var dest = out_idx;
            while (i < n) {
                let ty = self.dci_llvm_type_for_token(self.dci_register_token_at(lowering, i));
                let offset = self.dci_register_offset_at(lowering, i);
                if (ty == null || offset < 0) { return -1; }
                let piece_ptr = self.ptr_offset_bytes(slot,
                                                      vyx_rt_const_int(self.mod, self.ty_i64, offset, 0),
                                                      "dci.split.piece");
                let piece = vyx_rt_build_load(self.mod,
                                              ty,
                                              piece_ptr,
                                              "dci.split.bits".c_str(),
                                              14);
                if (piece == null) { return -1; }
                ast_write_rawptr(ptr_offset(args, dest * 8), piece);
                dest = dest + 1;
                i = i + 1;
            }
            return dest;
        }
        let arg_val = self.lower_dci_call_argument(function_id, source_index, value_id, type_id);
        if (arg_val == null) { return -1; }
        ast_write_rawptr(ptr_offset(args, out_idx * 8), arg_val);
        return out_idx + 1;
    }

    public fn lower_dci_call_argument(self,
                                      function_id: i32,
                                      source_index: i32,
                                      value_id: i32,
                                      type_id: i32) -> rawptr {
        // Foreign C/DCI declarations use a raw machine pointer. Direct-call
        // arguments are still Vyx two-word handles; extract the address before
        // build_call. Drop already does this via lower_place_addr.
        if (function_id != mir_id_invalid()
            && self.m.function_item_kind(function_id) == hir_item_extern_function()
            && llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            let wrapped = self.lower_value_as(value_id, type_id);
            if (wrapped != null) {
                let extracted = self.pointer_handle_address(wrapped, "dci.arg.raw");
                if (extracted != null) { return extracted; }
            }
        }
        if (!self.function_is_foreign_dci(function_id)) {
            if (self.foreign_c_handle_uses_raw_pointer_abi(function_id, type_id)) {
                return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
            }
            if (self.source_param_uses_self_pointer_abi(function_id, source_index)) {
                return self.lower_self_receiver_address(value_id, type_id);
            }
            if (self.source_param_uses_native_byval_abi(function_id, source_index)) {
                return self.materialize_aggregate_pointer_argument(value_id, type_id, "mir.byval.arg");
            }
            if (self.source_param_uses_c_sysv_coerce(function_id, source_index)) {
                let raw = self.lower_value_as(value_id, type_id);
                return self.c_sysv_coerce_value(raw, type_id, "c.abi.arg");
            }
            return self.lower_value_as(value_id, type_id);
        }
        let lowering = self.dci_source_parameter_abi(function_id, source_index);
        if (!self.dci_value_parameter_lifecycle_supported(function_id,
                                                          source_index,
                                                          type_id)) {
            return null;
        }
        let passing = self.dci_abi_passing(lowering);
        if (passing == "indirect" || passing == "byval" || passing == "inalloca") {
            return self.dci_materialize_indirect_argument(value_id,
                                                          type_id,
                                                          lowering,
                                                          "dci.indirect.arg");
        }
        if (passing == "coerce") {
            return self.dci_coerce_argument(value_id, type_id, lowering);
        }
        if (passing == "split") {
            self.report_error("DCI split argument must be expanded by the callsite for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        if (passing != "direct") {
            self.report_error("unsupported DCI call argument passing `" + passing + "` for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        if (self.dci_direct_handle_uses_raw_pointer_abi(type_id, lowering)) {
            return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
        }
        // A direct aggregate argument still has to reach the producer in the
        // shape its compiler chose: on Win64 that is one integer register for
        // a 1/2/4/8-byte record, not the two the LLVM backend would pick for a
        // bare `{i32,i32}`.  Passing the struct uncoerced also shifts every
        // argument after it, so the failure shows up as a wrong *earlier*
        // value rather than as a type error.
        if (self.dci_open_direct_param_uses_c_coerce(function_id, type_id)) {
            let raw = self.lower_value_as(value_id, type_id);
            return self.c_sysv_coerce_value(raw, type_id, "c.abi.dci.arg");
        }
        return self.lower_value_as(value_id, type_id);
    }

    public fn wrap_foreign_direct_pointer_return(self,
                                                 value: rawptr,
                                                 function_id: i32,
                                                 name: string) -> rawptr {
        if (value == null) { return value; }
        let type_id = self.m.function_return_type(function_id);
        var uses_raw_pointer_abi = self.foreign_c_handle_uses_raw_pointer_abi(
            function_id, type_id);
        if (self.function_is_foreign_dci(function_id)) {
            uses_raw_pointer_abi = self.dci_direct_handle_uses_raw_pointer_abi(
                type_id, self.dci_return_abi(function_id));
        }
        if (!uses_raw_pointer_abi) {
            return value;
        }
        let elem = hir_type_table_elem(self.m.types, type_id);
        // TypePointer: safe `*p` / `p[i]` on C (and scalar DCI) pointers need
        // a region. DCI class objects only extract the address for methods,
        // vtables, and field GEP.
        if (elem != mir_id_invalid()
            && (self.type_is_foreign_dci(elem) || self.type_is_dci_stub_class(elem))) {
            return self.pointer_handle_from_foreign_raw(value, name);
        }
        return self.pointer_handle_from_raw(value, elem, 0, 0, name);
    }

    public fn dci_uncoerce_return_value(self,
                                        value: rawptr,
                                        function_id: i32,
                                        type_id: i32) -> rawptr {
        if (value == null) { return null; }
        if (!self.dci_coerce_contract_supported(type_id,
                                                self.dci_return_abi(function_id),
                                                "return of `" + self.m.function_name(function_id) + "`")) {
            return null;
        }
        let storage_type = self.lower_storage_type(type_id);
        if (storage_type == null) { return null; }
        var slot: rawptr = null;
        if (self.type_is_class_pointer_abi(type_id)) {
            slot = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(), type_id);
        } else {
            slot = vyx_rt_build_alloca(self.mod, storage_type, "dci.coerce.ret".c_str(), 14);
        }
        if (slot == null) { return null; }
        var alignment = self.dci_json_i64(self.dci_return_abi(function_id), "alignment");
        if (alignment <= 0) { alignment = self.dci_type_value_alignment(type_id); }
        let return_lowering = self.dci_return_abi(function_id);
        let piece_count = self.dci_register_count(return_lowering);
        if (piece_count > 1) {
            if (alignment > 0) { vyx_rt_set_alignment(self.mod, slot, alignment as i32); }
            var piece: i32 = 0;
            while (piece < piece_count) {
                let offset = self.dci_register_offset_at(return_lowering, piece);
                if (offset < 0) { return null; }
                let part_name = "dci.ret.piece";
                let part = vyx_rt_build_extract_value(self.mod,
                                                      value,
                                                      piece,
                                                      part_name.c_str(),
                                                      part_name.len as u64);
                let dest = self.ptr_offset_bytes(slot,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, offset, 0),
                                                 "dci.ret.off");
                if (part == null || dest == null) { return null; }
                vyx_rt_build_store(self.mod, part, dest);
                piece = piece + 1;
            }
        } else if (alignment > 0) {
            vyx_rt_set_alignment(self.mod, slot, alignment as i32);
            if (vyx_rt_build_store_aligned(self.mod,
                                           value,
                                           slot,
                                           alignment as i32) == null) {
                self.report_error("cannot store DCI coerce return with contract alignment");
                return null;
            }
        } else {
            vyx_rt_build_store(self.mod, value, slot);
        }
        if (self.type_is_class_pointer_abi(type_id)) { return slot; }
        if (alignment > 0) {
            return vyx_rt_build_load_aligned(self.mod,
                                             self.lower_type(type_id),
                                             slot,
                                             alignment as i32,
                                             "dci.return.value".c_str(),
                                             16);
        }
        return vyx_rt_build_load(self.mod,
                                 self.lower_type(type_id),
                                 slot,
                                 "dci.return.value".c_str(),
                                 16);
    }

    public fn lower_call_value(self, value_id: i32) -> rawptr {
        let call_name = self.resolved_call_name(value_id);
        let call_base_name = policy_generic_call_base(call_name.clone());
        let direct_target_for_name_dispatch = self.direct_call_target_function(value_id);
        // Built-in pointer methods on *T / &T / &mut T / rawptr receivers.
        if (direct_target_for_name_dispatch == mir_id_invalid()) {
            let pmk = policy_pointer_method_kind(call_base_name.clone());
            if (pmk > 0) {
                let receiver_probe = self.receiver_for_builtin_call(value_id);
                if (receiver_probe != mir_id_invalid()
                    && llvm_mir_kind_pointer_like(llvm_mir_type_kind(&self.m, self.m.value_type(receiver_probe)))) {
                    return self.lower_pointer_method_call(value_id, pmk);
                }
            }
        }
        if (call_base_name == "sizeof") { return self.lower_sizeof_call(value_id, call_name); }
        if (call_base_name == "repr_sizeof") { return self.lower_repr_sizeof_call(value_id, call_name); }
        if (call_base_name == "alignof") { return self.lower_alignof_call(value_id, call_name); }
        if (call_base_name == "typeof") { return self.lower_typeof_call(value_id); }
        if (call_base_name == "typeinfo") { return self.lower_typeinfo_call(value_id); }
        if (call_base_name == "type_name") { return self.lower_type_name_call(value_id, call_name); }
        if (call_base_name == "reflect_name") { return self.lower_reflect_name_call(value_id, call_name); }
        if (call_base_name == "reflect_manifest") { return self.lower_reflect_manifest_call(value_id); }
        if (call_base_name == "reflect_method_ptr_by_id") { return self.lower_reflect_method_ptr_by_id_call(value_id); }
        if (call_base_name == "reflect_method_value") { return self.lower_reflect_method_value_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_count") { return self.lower_field_count_call(value_id, call_name); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_name") { return self.lower_field_name_call(value_id, call_name); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && call_base_name == "field_type") { return self.lower_field_type_call(value_id, call_name); }
        if (call_name == "print" || call_name == "println") {
            return self.lower_print_like_call(value_id, call_name);
        }
        if (call_name == "format" && direct_target_for_name_dispatch == mir_id_invalid()) {
            return self.lower_format_call(value_id);
        }
        if (call_name == "argCount") { return self.lower_arg_count_call(value_id); }
        if (call_name == "getArg") { return self.lower_get_arg_call(value_id); }
        if (call_name == "int_to_string") { return self.lower_int_to_string_runtime_call(value_id); }
        if (call_name == "bool_to_string") { return self.lower_bool_to_string_runtime_call(value_id); }
        if (call_name == "raw" || call_name == "_borrow_raw") {
            let raw_str = self.lower_std_string_raw_call(value_id);
            if (raw_str != null) { return raw_str; }
        }
        if (call_name == "clone") {
            let clone_receiver = self.receiver_for_builtin_call(value_id);
            if (clone_receiver != mir_id_invalid()
                && self.type_is_str_abi(self.m.value_type(clone_receiver))) {
                return self.lower_string_clone_call(value_id);
            }
        }
        if (call_name == "create") {
            let sb_create = self.lower_string_builder_create_call(value_id);
            if (sb_create != null) { return sb_create; }
        }
        if (call_name == "append" && self.lower_string_builder_append_i64_call(value_id)) { return null; }
        if (call_name == "get_unchecked") {
            let vec_get = self.lower_vec_get_unchecked_call(value_id);
            if (vec_get != null) { return vec_get; }
        }
        if (call_name == "set_unchecked" && self.lower_vec_set_unchecked_call(value_id)) { return null; }
        if (call_name == "push_unchecked" && self.lower_vec_push_unchecked_call(value_id)) { return null; }
        if (llvm_mir_effective_target_is_windows()
            && (call_name == "fileExists" || call_name == "isDir" || call_name == "isFile")) {
            return self.lower_fs_path_predicate_call(value_id, call_name);
        }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_concat") { return self.lower_string_concat_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_equals") { return self.lower_string_equals_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_length") { return self.lower_string_len_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_trim") { return self.lower_string_trim_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_replace") { return self.lower_string_replace_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_to_upper") { return self.lower_string_case_call(value_id, true); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_to_lower") { return self.lower_string_case_call(value_id, false); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_index_of") { return self.lower_string_index_of_call(value_id); }
        if (call_name == "isEmpty" || call_name == "is_empty") {
            let receiver_id = self.receiver_for_builtin_member_value(value_id);
            if (receiver_id != mir_id_invalid()
                && self.type_is_string_view_type(self.m.value_type(receiver_id))) {
                return self.lower_string_is_empty_call(value_id);
            }
        }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_substring") { return self.lower_string_substring_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_contains") { return self.lower_string_contains_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_starts_with") { return self.lower_string_starts_with_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid() && call_name == "str_ends_with") { return self.lower_string_ends_with_call(value_id); }
        if ((call_name == "c_str" || call_name == "ptr" || call_name == "data")
            && direct_target_for_name_dispatch == mir_id_invalid()) {
            return self.lower_string_ptr_member_call(value_id, call_name);
        }
        if (call_name == "strlen") { return self.lower_strlen_call(value_id); }
        if (call_name == "from_cstr") { return self.lower_from_cstr_call(value_id); }
        if (call_name == "from_cstr_len") { return self.lower_from_cstr_len_call(value_id, false); }
        if (call_name == "from_cstr_view_len") { return self.lower_from_cstr_len_call(value_id, true); }
        if (call_name == "from_raw_string_parts") { return self.lower_from_raw_string_parts_call(value_id); }
        if (direct_target_for_name_dispatch == mir_id_invalid()
            && (call_name == "str_char_at" || call_name == "charAt" || call_name == "char_at" || call_name == "byteAt")) {
            return self.lower_string_char_at_call(value_id);
        }
        if (self.type_is_option_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_option_variant_call(value_id);
        }
        if (self.type_is_result_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_result_variant_call(value_id);
        }
        if (self.type_is_plain_enum_abi(self.m.value_type(value_id))
            && self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
            return self.lower_enum_variant_call(value_id);
        }
        let option_callee_id = self.m.value_lhs(value_id);
        if (self.type_is_option_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_option_variant_call(value_id);
        }
        if (self.type_is_result_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_result_variant_call(value_id);
        }
        if (self.type_is_plain_enum_abi(self.m.value_type(value_id))
            && option_callee_id != mir_id_invalid()
            && self.m.value_target_kind(option_callee_id) == mir_target_hir_variant()) {
            return self.lower_enum_variant_call(value_id);
        }
        if (call_name == "to_rawptr") { return self.lower_to_rawptr_call(value_id); }
        if (call_name == "ptr_offset") { return self.lower_ptr_offset_call(value_id); }
        if (call_name == "ptr_read_u8" || call_name == "ptr_read_i32" || call_name == "ptr_read_i64") {
            return self.lower_ptr_read_call(value_id, call_name);
        }
        if (call_name == "ptr_write_i32" || call_name == "ptr_write_i64") {
            return self.lower_ptr_write_call(value_id, call_name);
        }
        if ((call_name == "vyx_atomic_load_i64"
             || call_name == "__vyx_atomic_load_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_load_i64_call(value_id);
        }
        if ((call_name == "vyx_atomic_fetch_add_i64"
             || call_name == "__vyx_atomic_fetch_add_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_fetch_add_i64_call(value_id);
        }
        if ((call_name == "vyx_atomic_compare_exchange_i64"
             || call_name == "__vyx_atomic_compare_exchange_i64_intrinsic")
            && direct_target_for_name_dispatch != mir_id_invalid()
            && self.function_is_bodyless(direct_target_for_name_dispatch)) {
            return self.lower_atomic_compare_exchange_i64_call(value_id);
        }
        if (call_name == "memcpy") { return self.lower_memcpy_call(value_id); }
        if (call_name == "memmove") { return self.lower_memmove_call(value_id); }
        if (call_name == "memset") { return self.lower_memset_call(value_id); }
        let can_lower_builtin_alloc_name = direct_target_for_name_dispatch == mir_id_invalid()
            || self.m.value_target_kind(value_id) == mir_target_builtin();
        if (can_lower_builtin_alloc_name && call_name == "malloc") { return self.lower_malloc_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "alloc") { return self.lower_malloc_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "free") { return self.lower_free_call(value_id); }
        if (can_lower_builtin_alloc_name && call_name == "dealloc") { return self.lower_free_call(value_id); }
        if (call_name == "transmute") { return self.lower_transmute_call(value_id); }
        if (call_name == "assert") {
            self.lower_assert_call(value_id);
            return null;
        }
        if (call_name == "assert_eq") { return self.lower_assert_eq_call(value_id); }
        if (call_name == "realloc" && self.call_arg_count(value_id) == 2) { return self.lower_realloc_call(value_id); }
        if (call_name == "memcmp") { return self.lower_memcmp_call(value_id); }
        if (self.m.value_target_kind(value_id) == mir_target_builtin()) {
            let bname = self.builtin_name_for_call(value_id);
            let bbase = policy_generic_call_base(bname.clone());
            if (bbase == "sizeof") { return self.lower_sizeof_call(value_id, bname); }
            if (bbase == "repr_sizeof") { return self.lower_repr_sizeof_call(value_id, bname); }
            if (bbase == "alignof") { return self.lower_alignof_call(value_id, bname); }
            if (bbase == "typeof") { return self.lower_typeof_call(value_id); }
            if (bbase == "typeinfo") { return self.lower_typeinfo_call(value_id); }
            if (bbase == "type_name") { return self.lower_type_name_call(value_id, bname); }
            if (bbase == "reflect_name") { return self.lower_reflect_name_call(value_id, bname); }
            if (bbase == "reflect_manifest") { return self.lower_reflect_manifest_call(value_id); }
            if (bbase == "reflect_method_ptr_by_id") { return self.lower_reflect_method_ptr_by_id_call(value_id); }
            if (bbase == "reflect_method_value") { return self.lower_reflect_method_value_call(value_id); }
            if (bbase == "field_count") { return self.lower_field_count_call(value_id, bname); }
            if (bbase == "field_name") { return self.lower_field_name_call(value_id, bname); }
            if (bbase == "field_type") { return self.lower_field_type_call(value_id, bname); }
            if (bbase == "new" || bbase == "construct") {
                return self.lower_default_new_call(value_id, bbase);
            }
            if (bbase == "panic") { return self.lower_panic_call(value_id); }
            if (bbase == "assert") {
                self.lower_assert_call(value_id);
                return null;
            }
            if (bbase == "assert_eq") { return self.lower_assert_eq_call(value_id); }
            if (bbase == "hash") { return self.lower_hash_call(value_id); }
            if (bbase == "operator_eq" || bbase == "operator==") { return self.lower_operator_eq_call(value_id); }
            if (bbase == "compare") { return self.lower_compare_call(value_id); }
            if (bbase == "format") { return self.lower_format_call(value_id); }
            if (bbase == "argCount") { return self.lower_arg_count_call(value_id); }
            if (bbase == "getArg") { return self.lower_get_arg_call(value_id); }
            if (bbase == "int_to_string") { return self.lower_int_to_string_runtime_call(value_id); }
            if (bbase == "bool_to_string") { return self.lower_bool_to_string_runtime_call(value_id); }
            if (bname == "malloc") { return self.lower_malloc_call(value_id); }
            if (bname == "alloc") { return self.lower_malloc_call(value_id); }
            if (bname == "free") { return self.lower_free_call(value_id); }
            if (bname == "dealloc") { return self.lower_free_call(value_id); }
            if (bname == "realloc") { return self.lower_realloc_call(value_id); }
            if (bname == "memcmp") { return self.lower_memcmp_call(value_id); }
            if (bname == "transmute") { return self.lower_transmute_call(value_id); }
            if (bname == "to_rawptr") { return self.lower_to_rawptr_call(value_id); }
            if (bname == "ptr_offset") { return self.lower_ptr_offset_call(value_id); }
            if (bname == "ptr_read_u8" || bname == "ptr_read_i32" || bname == "ptr_read_i64") {
                return self.lower_ptr_read_call(value_id, bname);
            }
            if (bname == "ptr_write_i32" || bname == "ptr_write_i64") {
                return self.lower_ptr_write_call(value_id, bname);
            }
            if (bname == "memcpy") { return self.lower_memcpy_call(value_id); }
            if (bname == "memmove") { return self.lower_memmove_call(value_id); }
            if (bname == "memset") { return self.lower_memset_call(value_id); }
            if (bname == "toString" || bname == "to_string") { return self.lower_to_string_call(value_id); }
            if (bname == "c_str" || bname == "ptr" || bname == "data") { return self.lower_string_ptr_member_call(value_id, bname); }
            if (bname == "strlen") { return self.lower_strlen_call(value_id); }
            if (bname == "from_cstr") { return self.lower_from_cstr_call(value_id); }
            if (bname == "from_cstr_len") { return self.lower_from_cstr_len_call(value_id, false); }
            if (bname == "from_cstr_view_len") { return self.lower_from_cstr_len_call(value_id, true); }
            if (bname == "from_raw_string_parts") { return self.lower_from_raw_string_parts_call(value_id); }
            if (bname == "len" || bname == "length" || bname == "size" || bname == "count") { return self.lower_string_len_call(value_id); }
            if (bname == "clone") { return self.lower_string_clone_call(value_id); }
            if (bname == "repeat") { return self.lower_string_repeat_call(value_id); }
            if (bname == "isEmpty" || bname == "is_empty") { return self.lower_string_is_empty_call(value_id); }
            if (bname == "trim" || bname == "str_trim") { return self.lower_string_trim_call(value_id); }
            if (bname == "replace" || bname == "str_replace") { return self.lower_string_replace_call(value_id); }
            if (bname == "toUpper" || bname == "to_upper" || bname == "str_to_upper") { return self.lower_string_case_call(value_id, true); }
            if (bname == "toLower" || bname == "to_lower" || bname == "str_to_lower") { return self.lower_string_case_call(value_id, false); }
            if (bname == "substring" || bname == "substr") { return self.lower_string_substring_call(value_id); }
            if (bname == "contains") { return self.lower_string_contains_call(value_id); }
            if (bname == "equals") { return self.lower_string_equals_call(value_id); }
            if (bname == "startsWith" || bname == "starts_with") { return self.lower_string_starts_with_call(value_id); }
            if (bname == "endsWith" || bname == "ends_with") { return self.lower_string_ends_with_call(value_id); }
            if (bname == "find" || bname == "indexOf" || bname == "index_of") { return self.lower_string_index_of_call(value_id); }
            if (bname == "charAt" || bname == "char_at" || bname == "charCodeAt" || bname == "char_code_at" || bname == "byteAt") { return self.lower_string_char_at_call(value_id); }
            self.report_error("cannot lower builtin call " + bname);
            return null;
        }
        let callee_for_fn_value = self.m.value_lhs(value_id);
        if (callee_for_fn_value != mir_id_invalid()) {
            let callee_type_kind = llvm_mir_type_kind(&self.m, self.m.value_type(callee_for_fn_value));
            let callee_is_direct_symbol = self.m.value_kind(callee_for_fn_value) == mir_value_target_ref()
                && self.m.value_target_kind(callee_for_fn_value) == mir_target_function();
            if ((callee_type_kind == ty_FN() || callee_type_kind == ty_CFN())
                && !callee_is_direct_symbol) {
                return self.lower_fn_value_call(value_id);
            }
        }
        var has_direct_function_target = self.m.value_target_kind(value_id) == mir_target_function();
        if (!has_direct_function_target
            && callee_for_fn_value != mir_id_invalid()
            && self.m.value_target_kind(callee_for_fn_value) == mir_target_function()) {
            has_direct_function_target = true;
        }
        if (!has_direct_function_target && callee_for_fn_value != mir_id_invalid()) {
            let callee_kind = llvm_mir_type_kind(&self.m, self.m.value_type(callee_for_fn_value));
            if (callee_kind == ty_FN() || callee_kind == ty_CFN()) {
                return self.lower_fn_value_call(value_id);
            }
        }
        var target_fn = self.direct_call_target_function(value_id);
        if (target_fn != mir_id_invalid()
            && mir_unit_function_owner_item_kind(&self.m, target_fn) == hir_item_interface()) {
            let target_self_type = self.function_source_param_type(target_fn, 0);
            let receiver_type = self.call_receiver_type(value_id);
            let target_dyn = self.type_dyn_trait_id(target_self_type);
            let receiver_dyn = self.type_dyn_trait_id(receiver_type);
            if (target_dyn != mir_id_invalid()
                || (receiver_dyn != mir_id_invalid()
                    && self.interface_function_matches_dyn_trait(target_fn, receiver_dyn))) {
                return self.lower_dyn_trait_call(value_id, target_fn);
            }
            let concrete_target_fn = self.concrete_interface_call_target(value_id, target_fn);
            if (concrete_target_fn != mir_id_invalid()) {
                target_fn = concrete_target_fn;
            } else {
                let concrete_static_fn = self.concrete_static_interface_call_target(value_id, target_fn, call_name);
                if (concrete_static_fn != mir_id_invalid()) {
                    target_fn = concrete_static_fn;
                }
            }
        }
        let const_v = self.bodyless_i64_constant_call(value_id, target_fn, call_name);
        if (const_v != null) { return const_v; }
        let identity_v = self.bodyless_numeric_identity_call(value_id, target_fn, call_name);
        if (identity_v != null) { return identity_v; }
        let concrete_bodyless_static_fn = self.concrete_bodyless_static_call_target(value_id, target_fn, call_name);
        if (concrete_bodyless_static_fn != mir_id_invalid()) {
            target_fn = concrete_bodyless_static_fn;
        }
        if (self.bodyless_default_value_call(value_id, target_fn, call_name)) {
            return self.default_value_for_type(self.m.value_type(value_id));
        }
        if (target_fn != mir_id_invalid() && self.function_is_async_task_callable(target_fn)) {
            return self.lower_async_task_call(value_id, target_fn);
        }
        if (target_fn != mir_id_invalid()
            && self.function_uses_dci_virtual_dispatch(target_fn)
            && !self.dci_call_receiver_is_exact_value_object(value_id, target_fn)) {
            return self.lower_dci_virtual_call(value_id, target_fn);
        }
        var declaration_ok = false;
        if (target_fn != mir_id_invalid()) {
            declaration_ok = self.declare_function_signature(target_fn);
        }
        let fn_value = llvm_mir_map_get(self.function_values, target_fn);
        let fn_type = llvm_mir_map_get(self.function_types, target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_unresolved_direct_call(value_id, target_fn, declaration_ok);
            return null;
        }
        let source_argc = self.call_arg_count(value_id);
        let env_param_count = self.function_hidden_env_param_count(target_fn);
        let receiver_id = self.direct_call_receiver(value_id);
        var receiver_argc: i32 = 0;
        if (receiver_id != mir_id_invalid()) { receiver_argc = 1; }
        var implicit_self_argc: i32 = 0;
        var foreign_ctor_self_argc: i32 = 0;
        if (receiver_argc == 0 && target_fn != mir_id_invalid()
            && self.source_param_uses_self_pointer_abi(target_fn, 0)
            && self.function_is_native_constructor(target_fn)) {
            implicit_self_argc = 1;
        }
        if (receiver_argc == 0 && target_fn != mir_id_invalid()
            && self.function_is_foreign_dci_ctor(target_fn)) {
            foreign_ctor_self_argc = 1;
        }
        var packed_receiver = false;
        if (target_fn != mir_id_invalid()
            && self.dci_abi_passing(self.dci_source_parameter_abi(target_fn, 0)) == "inalloca"
            && self.dci_function_inalloca_count(target_fn) > 1) {
            packed_receiver = true;
        }
        var argc: i32 = 0;
        if (receiver_argc > 0 && !packed_receiver) { argc = receiver_argc; }
        if (target_fn != mir_id_invalid() && self.function_uses_hidden_sret(target_fn)) {
            argc = argc + 1;
        }
        var env_arg: rawptr = null;
        if (env_param_count > 0) {
            let callee_value_id = self.m.value_lhs(value_id);
            var closure_fat = null;
            if (callee_value_id != mir_id_invalid()) {
                closure_fat = self.lower_value(callee_value_id);
            }
            if (closure_fat == null) {
                closure_fat = self.build_closure_fat_value(target_fn);
            }
            env_arg = self.closure_fat_env_value(closure_fat);
            if (env_arg == null) {
                self.report_error("cannot resolve closure env for call to " + self.m.function_name(target_fn));
                return null;
            }
            argc = argc + env_param_count;
        }
        // Constructor calls need an implicit self-argument allocation.
        if (implicit_self_argc > 0) {
            argc = argc + 1;
        }
        if (foreign_ctor_self_argc > 0) {
            argc = argc + 1;
        }
        var split_i: i32 = 0;
        while (split_i < source_argc) {
            let split_param = split_i + receiver_argc + implicit_self_argc;
            argc = argc + self.dci_source_param_llvm_slots(target_fn, split_param);
            split_i = split_i + 1;
        }
        if (target_fn != mir_id_invalid() && self.dci_function_inalloca_count(target_fn) > 1) {
            argc = argc + 1;
        }
        var args: rawptr = null;
        if (argc > 0) {
            args = malloc((argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate direct call argument list for " + self.m.function_name(target_fn));
                return null;
            }
        }
        if (!self.dci_prepare_inalloca_call_frame(target_fn, args, argc)) {
            if (args != null) { free(args); }
            return null;
        }
        var out_idx: i32 = 0;
        var dci_sret_slot: rawptr = null;
        var member_sret_after = target_fn != mir_id_invalid()
            && receiver_argc > 0
            && env_param_count == 0
            && implicit_self_argc == 0
            && foreign_ctor_self_argc == 0
            && !packed_receiver
            && self.dci_member_sret_after_receiver(target_fn);
        if (target_fn != mir_id_invalid() && self.function_uses_hidden_sret(target_fn)) {
            let dci_return_type = self.m.function_return_type(target_fn);
            var dci_return_storage = self.lower_storage_type(dci_return_type);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                dci_return_storage = self.dci_translated_sret_ty(target_fn);
            }
            if (dci_return_storage == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower DCI sret storage for " + self.m.function_name(target_fn));
                return null;
            }
            if (self.type_is_class_pointer_abi(dci_return_type)) {
                dci_sret_slot = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(),
                                                                                   dci_return_type);
            } else {
                dci_sret_slot = vyx_rt_build_alloca(self.mod,
                                                    dci_return_storage,
                                                    "dci.sret".c_str(),
                                                    8);
                let dci_sret_alignment = self.dci_json_i64(self.dci_return_abi(target_fn),
                                                           "alignment");
                if (dci_sret_slot != null && dci_sret_alignment > 0) {
                    vyx_rt_set_alignment(self.mod,
                                         dci_sret_slot,
                                         dci_sret_alignment as i32);
                }
            }
            if (dci_sret_slot == null) {
                if (args != null) { free(args); }
                self.report_error("cannot allocate DCI sret storage for " + self.m.function_name(target_fn));
                return null;
            }
            if (member_sret_after) {
                ast_write_rawptr(ptr_offset(args, 1 * 8), dci_sret_slot);
            } else {
                ast_write_rawptr(ptr_offset(args, out_idx * 8), dci_sret_slot);
                out_idx = out_idx + 1;
            }
        }
        if (env_param_count > 0) {
            ast_write_rawptr(ptr_offset(args, out_idx * 8), env_arg);
            out_idx = out_idx + env_param_count;
        }
        if (receiver_argc > 0) {
            let receiver_type = self.function_source_param_type(target_fn, 0);
            if (receiver_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve receiver parameter type for " + self.m.function_name(target_fn));
                return null;
            }
            var receiver_val: rawptr = null;
            if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                && !self.m.static_exists(self.m.value_target_id(receiver_id))) {
                receiver_val = self.default_value_for_type(receiver_type);
            } else if (self.source_param_uses_self_pointer_abi(target_fn, 0)) {
                if (self.m.value_kind(receiver_id) == mir_value_target_ref()
                    && self.m.value_target_kind(receiver_id) == mir_target_hir_item()
                    && self.m.static_exists(self.m.value_target_id(receiver_id))) {
                    receiver_val = self.lower_static_self_receiver_address(receiver_id, receiver_type);
                } else {
                    receiver_val = self.lower_self_receiver_address(receiver_id, receiver_type);
                }
            } else {
                receiver_val = self.lower_value_as(receiver_id, receiver_type);
            }
            if (receiver_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower receiver argument for " + self.m.function_name(target_fn));
                return null;
            }
            receiver_val = self.adjust_dci_direct_method_receiver(receiver_val,
                                                                  target_fn,
                                                                  "dci.method.this");
            if (receiver_val == null) {
                if (args != null) { free(args); }
                self.report_error("cannot adjust external DCI receiver for " + self.m.function_name(target_fn));
                return null;
            }
            if (packed_receiver) {
                var packed_ok = false;
                if (self.source_param_uses_self_pointer_abi(target_fn, 0)
                    || self.type_is_class_pointer_abi(receiver_type)) {
                    packed_ok = self.dci_store_packed_inalloca_pointer(target_fn,
                                                                       0,
                                                                       args,
                                                                       argc,
                                                                       receiver_val,
                                                                       receiver_type);
                } else {
                    packed_ok = self.dci_store_packed_inalloca_value(target_fn,
                                                                     0,
                                                                     args,
                                                                     argc,
                                                                     receiver_id,
                                                                     receiver_type);
                }
                if (!packed_ok) {
                    if (args != null) { free(args); }
                    return null;
                }
            } else {
                ast_write_rawptr(ptr_offset(args, out_idx * 8), receiver_val);
                out_idx = out_idx + 1;
                if (member_sret_after) { out_idx = out_idx + 1; }
            }
        }
        // For constructor calls without an explicit receiver: allocate the class
        // object and pass the pointer as the implicit self argument.
        var foreign_ctor_self_val: rawptr = null;
        var implicit_self_val: rawptr = null;
        if (foreign_ctor_self_argc > 0) {
            let foreign_ctor_receiver_type = self.foreign_dci_owner_type_id(target_fn);
            if (foreign_ctor_receiver_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot resolve external DCI constructor owner for `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
            foreign_ctor_self_val = self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(),
                                                                                       foreign_ctor_receiver_type);
            if (foreign_ctor_self_val == null) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot allocate external DCI receiver for constructor `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
            ast_write_rawptr(ptr_offset(args, out_idx * 8), foreign_ctor_self_val);
            out_idx = out_idx + 1;
        }
        if (implicit_self_argc > 0) {
            let ctor_receiver_type = self.function_source_param_type(target_fn, 0);
            if (ctor_receiver_type != mir_id_invalid()) {
                if (self.type_is_dci_stub_class(ctor_receiver_type)) {
                    implicit_self_val = self.lower_dci_stub_factory_call(ctor_receiver_type);
                } else {
                    implicit_self_val = self.lower_constructor_self_storage(ctor_receiver_type);
                }
                if (implicit_self_val != null) {
                    ast_write_rawptr(ptr_offset(args, out_idx * 8), implicit_self_val);
                    out_idx = out_idx + 1;
                }
            }
            if (implicit_self_val == null) {
                if (args != null) { free(args); }
                self.report_error_at_value(value_id,
                                           "cannot allocate receiver for constructor `"
                                           + self.m.function_name(target_fn)
                                           + "`");
                return null;
            }
        }
        var i: i32 = 0;
        while (i < source_argc) {
            let arg_id = self.call_arg_at(value_id, i);
            let param_index = i + receiver_argc + implicit_self_argc;
            let param_type = self.call_arg_expected_type(target_fn, param_index, arg_id);
            if (param_type == mir_id_invalid()) {
                if (args != null) { free(args); }
                self.report_error("cannot resolve argument parameter type #" + policy_i64_to_string(param_index as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            let next_idx = self.dci_append_call_argument(target_fn,
                                                         param_index,
                                                         arg_id,
                                                         param_type,
                                                         args,
                                                         out_idx,
                                                         argc);
            if (next_idx < 0) {
                if (args != null) { free(args); }
                self.report_error("cannot lower argument #" + policy_i64_to_string(i as i64)
                          + " for " + self.m.function_name(target_fn));
                return null;
            }
            out_idx = next_idx;
            i = i + 1;
        }
        var out_call_name = "mir.call";
        let ret_kind = llvm_mir_type_kind(&self.m, self.value_effective_type(value_id));
        if (ret_kind == ty_VOID() || foreign_ctor_self_argc > 0 || implicit_self_argc > 0
            || dci_sret_slot != null) { out_call_name = ""; }
        var out = self.build_abi_call(fn_type, fn_value, args, argc as u64, out_call_name, target_fn);
        if (out != null && !self.apply_dci_callsite_abi_attrs(target_fn, out)) { out = null; }
        if (out != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, out)) { out = null; }
        if (args != null) { free(args); }
        if (out != null && dci_sret_slot != null) {
            let dci_result_type = self.m.function_return_type(target_fn);
            if (self.dci_call_converts_translated_to_result(target_fn)) {
                out = self.dci_result_from_translated_sret(target_fn, dci_sret_slot);
            } else if (self.type_is_class_pointer_abi(dci_result_type)) {
                out = dci_sret_slot;
            } else {
                out = vyx_rt_build_load(self.mod,
                                        self.lower_type(dci_result_type),
                                        dci_sret_slot,
                                        "dci.sret.value".c_str(),
                                        14);
            }
        } else if (out != null
            && target_fn != mir_id_invalid()
            && self.dci_abi_passing(self.dci_return_abi(target_fn)) == "coerce") {
            out = self.dci_uncoerce_return_value(out,
                                                 target_fn,
                                                 self.m.function_return_type(target_fn));
        } else if (out != null
            && target_fn != mir_id_invalid()
            && self.function_return_uses_c_sysv_coerce(target_fn)) {
            out = self.c_sysv_uncoerce_value(out,
                                            self.m.function_return_type(target_fn),
                                            "c.abi.ret");
        }
        if (out != null && target_fn != mir_id_invalid()) {
            out = self.wrap_foreign_direct_pointer_return(out,
                                                          target_fn,
                                                          "foreign.return.ptr");
        }
        if (out == null) {
            if (source_argc != self.function_visible_param_count(target_fn)) {
                self.report_direct_call_arity_error(value_id, target_fn, source_argc);
            } else {
                self.report_error_at_value(value_id,
                    "cannot build direct call to `" + self.m.function_name(target_fn)
                    + "`: " + self.runtime_last_error());
                var dbg_i: i32 = 0;
                while (dbg_i < source_argc) {
                    let dbg_arg_id = self.call_arg_at(value_id, dbg_i);
                    let dbg_param_type = self.function_source_param_type(target_fn, dbg_i + receiver_argc + implicit_self_argc);
                    self.report_error("direct call argument "
                              + policy_i64_to_string(dbg_i as i64)
                              + " has type " + llvm_mir_type_text(&self.m, self.value_effective_type(dbg_arg_id))
                              + ", expected " + llvm_mir_type_text(&self.m, dbg_param_type));
                    dbg_i = dbg_i + 1;
                }
            }
        }
        if (foreign_ctor_self_argc > 0) {
            if (out == null && self.error_count > 0) { return null; }
            return foreign_ctor_self_val;
        }
        if (implicit_self_argc > 0) {
            if (out == null) {
                if (self.error_count > 0) { return null; }
                self.report_error("constructor `" + self.m.function_name(target_fn) + "` did not produce a return value");
                return null;
            }
            return out;
        }
        return out;
    }

    public fn lower_assert_call(self, value_id: i32) -> bool {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("assert requires exactly one argument");
            return false;
        }
        let cond_id = self.call_arg_at(value_id, 0);
        let cond = self.truthy_value(self.lower_value(cond_id), self.m.value_type(cond_id));
        if (cond == null) {
            self.report_error("cannot lower assert condition");
            return false;
        }
        let fail_name = "mir.assert.fail";
        let cont_name = "mir.assert.cont";
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fail_name.c_str(),
                                          fail_name.len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          cont_name.c_str(),
                                          cont_name.len as u64);
        if (fail_bb == null || cont_bb == null) {
            self.report_error("cannot create assert control blocks");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, cond, cont_bb, fail_bb);
        vyx_rt_position_at_end(self.mod, fail_bb);
        self.emit_printf_cstr(self.emit_str_ptr("assert failed\n"));
        vyx_rt_build_unreachable(self.mod);
        vyx_rt_position_at_end(self.mod, cont_bb);
        return true;
    }

    public fn lower_assert_eq_condition(self, lhs_id: i32, rhs_id: i32) -> rawptr {
        let lhs_type = self.m.value_type(lhs_id);
        let rhs_type = self.m.value_type(rhs_id);
        if (self.type_is_string_view_type(lhs_type) || self.type_is_string_view_type(rhs_type)) {
            return self.lower_string_equals_condition(lhs_id, rhs_id, false);
        }
        let lhs_kind = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind = llvm_mir_type_kind(&self.m, rhs_type);
        if (llvm_mir_kind_float(lhs_kind) || llvm_mir_kind_float(rhs_kind)) {
            let cmp_type = self.common_float_type_id(lhs_type, rhs_type, lhs_type);
            let lhs_v = self.lower_value_as(lhs_id, cmp_type);
            let rhs_v = self.lower_value_as(rhs_id, cmp_type);
            if (lhs_v == null || rhs_v == null) {
                self.report_error("cannot lower assert_eq floating operands");
                return null;
            }
            return vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_oeq(), lhs_v, rhs_v, llvm_mir_empty_name(), 0);
        }
        let lhs_bits = llvm_mir_int_bits_for_kind(lhs_kind);
        let rhs_bits = llvm_mir_int_bits_for_kind(rhs_kind);
        if (lhs_bits > 0 || rhs_bits > 0 || llvm_mir_kind_pointer_like(lhs_kind) || llvm_mir_kind_pointer_like(rhs_kind)
            || self.type_is_class_pointer_abi(lhs_type) || self.type_is_class_pointer_abi(rhs_type)) {
            var lhs_v2 = self.lower_value(lhs_id);
            var rhs_v2 = self.lower_value_as(rhs_id, lhs_type);
            if (lhs_v2 == null || rhs_v2 == null) {
                self.report_error("cannot lower assert_eq operands");
                return null;
            }
            lhs_v2 = self.pointer_compare_scalar(lhs_v2, lhs_type, "mir.assert.ptr.lhs");
            rhs_v2 = self.pointer_compare_scalar(rhs_v2, lhs_type, "mir.assert.ptr.rhs");
            return vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), lhs_v2, rhs_v2, llvm_mir_empty_name(), 0);
        }
        self.report_error("cannot lower assert_eq operands "
                  + llvm_mir_type_text(&self.m, lhs_type)
                  + " and "
                  + llvm_mir_type_text(&self.m, rhs_type));
        return null;
    }

    public fn lower_assert_eq_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        if (argc != 2 && argc != 3) {
            self.report_error("assert_eq requires two operands or label plus two operands");
            return null;
        }
        var lhs_index: i32 = 0;
        if (argc == 3) { lhs_index = 1; }
        let lhs_id = self.call_arg_at(value_id, lhs_index);
        let rhs_id = self.call_arg_at(value_id, lhs_index + 1);
        let cond = self.lower_assert_eq_condition(lhs_id, rhs_id);
        if (cond == null) { return null; }
        let fail_name = "mir.assert_eq.fail";
        let cont_name = "mir.assert_eq.cont";
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fail_name.c_str(),
                                          fail_name.len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          cont_name.c_str(),
                                          cont_name.len as u64);
        if (fail_bb == null || cont_bb == null) {
            self.report_error("cannot create assert_eq control blocks");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, cond, cont_bb, fail_bb);
        vyx_rt_position_at_end(self.mod, fail_bb);
        self.emit_printf_cstr(self.emit_str_ptr("assert_eq failed\n"));
        vyx_rt_build_unreachable(self.mod);
        vyx_rt_position_at_end(self.mod, cont_bb);
        return null;
    }

    public fn lower_drop_instr(self, instr_id: i32) {
        let place_id = self.m.instr_place(instr_id);
        let target_fn = self.m.instr_target_id(instr_id);
        if (place_id == mir_id_invalid()) {
            self.report_error("drop instr #" + policy_i64_to_string(instr_id as i64) + " is missing place");
            return;
        }
        if (self.lower_dci_stub_destroy_place(place_id)) { return; }
        if (target_fn == mir_id_invalid()) {
            self.report_error("drop instr #" + policy_i64_to_string(instr_id as i64) + " is missing place or target function");
            return;
        }
        self.declare_function_signature(target_fn);
        let fn_value = llvm_mir_map_get(self.function_values, target_fn);
        let fn_type = llvm_mir_map_get(self.function_types, target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_error("cannot resolve drop target for instr #" + policy_i64_to_string(instr_id as i64));
            return;
        }
        let receiver_type = self.function_source_param_type(target_fn, 0);
        if (receiver_type == mir_id_invalid()) {
            self.report_error("drop target has no self parameter for instr #" + policy_i64_to_string(instr_id as i64));
            return;
        }
        var receiver_arg: rawptr = null;
        if (self.source_param_uses_self_pointer_abi(target_fn, 0)) {
            let place_addr = self.lower_place_addr(place_id);
            receiver_arg = self.class_object_addr_from_place_addr(place_id, place_addr, receiver_type);
        } else if (llvm_mir_type_kind(&self.m, receiver_type) == ty_PTR()
            && hir_type_table_elem(self.m.types, receiver_type) == self.m.place_type(place_id)) {
            // A descriptor lifecycle destroy is a free function `fn(*T)`.
            // Preserve the local storage identity instead of loading T and
            // attempting an aggregate-to-pointer cast.
            receiver_arg = self.lower_place_addr(place_id);
        } else {
            let value_id = self.m.instr_value(instr_id);
            if (value_id != mir_id_invalid()) {
                receiver_arg = self.lower_value_as(value_id, receiver_type);
            } else {
                let addr = self.lower_place_addr(place_id);
                if (addr != null) {
                    let loaded = vyx_rt_build_load(self.mod,
                                                   self.lower_type(self.m.place_type(place_id)),
                                                   addr,
                                                   llvm_mir_empty_name(),
                                                   0);
                    receiver_arg = self.cast_value(loaded, self.m.place_type(place_id), receiver_type);
                }
            }
        }
        if (receiver_arg == null) {
            self.report_error("cannot lower drop receiver for instr #" + policy_i64_to_string(instr_id as i64));
            return;
        }
        let args = malloc(8);
        if (args == null) {
            self.report_error("cannot allocate drop call args for instr #" + policy_i64_to_string(instr_id as i64));
            return;
        }
        ast_write_rawptr(args, receiver_arg);
        let lifetime_error = llvm_lifetime_finish_drop(&self.m, place_id, target_fn,
                                                       self.mod, fn_type, fn_value, args,
                                                       self.type_is_class_pointer_abi(self.m.place_type(place_id)),
                                                       self.builtin_free_fty, self.builtin_free_fn);
        free(args);
        if (lifetime_error.len > 0) { self.report_error(lifetime_error); }
    }

    public fn track_shared_unwind_owner(self, place_id: i32, addr: rawptr) {
        if (!self.dci_caller_participates_in_shared_unwind()) { return; }
        let drop = llvm_unwind_drop_for_place(&self.m, self.current_function_id, place_id);
        if (drop == mir_id_invalid()) { return; }
        self.declare_function_signature(drop);
        let type_id = self.m.place_type(place_id);
        let object = self.class_object_addr_from_place_addr(place_id, addr, type_id);
        if (llvm_unwind_track_owner(&self.m, place_id, drop, self.mod, object,
                                     self.type_is_class_pointer_abi(type_id),
                                     self.function_values, self.builtin_free_fn) != 0) {
            self.report_error("cannot register constructed object for shared unwind");
        }
    }

    public fn load_record_field_from_addr(self, record_addr: rawptr, type_id: i32, field_name: string) -> rawptr {
        let field_id = self.field_id_for_type_name(type_id, field_name);
        if (field_id == mir_id_invalid()) {
            self.report_error("cannot resolve field `" + field_name + "` for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let field_addr = self.record_field_addr_for_type(record_addr, type_id, field_name);
        let field_type = mir_unit_field_type(&self.m, field_id);
        let field_ll = self.lower_type(field_type);
        if (field_addr == null || field_ll == null) {
            self.report_error("cannot load field `" + field_name + "` for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_build_load(self.mod,
                                 field_ll,
                                 field_addr,
                                 field_name.c_str(),
                                 field_name.len as u64);
    }

    public fn foreach_iterator_slot_for_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        if (self.m.value_kind(value_id) == mir_value_read_place()) {
            return self.lower_place_addr(self.m.value_place(value_id));
        }
        let cached = llvm_mir_map_get(self.foreach_iterator_slots, value_id);
        if (cached != null) { return cached; }
        let iter_type = self.m.value_type(value_id);
        let iter_ll = self.lower_type(iter_type);
        if (iter_ll == null) {
            self.report_error("cannot lower foreach iterator type " + llvm_mir_type_text(&self.m, iter_type));
            return null;
        }
        let slot = vyx_rt_build_alloca(self.mod, iter_ll, "mir.foreach.iter".c_str(), 16);
        let value = self.lower_value_as(value_id, iter_type);
        if (slot == null || value == null) {
            self.report_error("cannot materialize foreach iterator value #"
                      + policy_i64_to_string(value_id as i64));
            return null;
        }
        vyx_rt_build_store(self.mod, value, slot);
        llvm_mir_map_put(self.foreach_iterator_slots, value_id, slot);
        return slot;
    }

    public fn foreach_method_for_iterator(self, iter_type: i32, method_name: string) -> i32 {
        let method_fn = self.executable_method_for_receiver_type(iter_type, method_name);
        if (method_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_source_param_count(method_fn) != 1) { return mir_id_invalid(); }
        return method_fn;
    }

    public fn lower_iterator_method_call_from_slot(self,
                                                   method_fn: i32,
                                                   iter_slot: rawptr,
                                                   iter_type: i32,
                                                   result_name: string) -> rawptr {
        if (method_fn == mir_id_invalid() || iter_slot == null) { return null; }
        if (self.function_hidden_env_param_count(method_fn) != 0) {
            self.report_error("foreach iterator method has hidden environment: " + self.m.function_name(method_fn));
            return null;
        }
        if (!self.declare_function_signature(method_fn)) {
            self.report_error("cannot declare foreach iterator method " + self.m.function_name(method_fn));
            return null;
        }
        let fn_value = llvm_mir_map_get(self.function_values, method_fn);
        let fn_type = llvm_mir_map_get(self.function_types, method_fn);
        if (fn_value == null || fn_type == null) {
            self.report_error("cannot resolve foreach iterator method " + self.m.function_name(method_fn));
            return null;
        }
        let receiver_type = self.function_source_param_type(method_fn, 0);
        if (receiver_type == mir_id_invalid()) {
            self.report_error("foreach iterator method has no receiver: " + self.m.function_name(method_fn));
            return null;
        }
        let args = malloc(8);
        if (args == null) {
            self.report_error("cannot allocate foreach iterator call arguments");
            return null;
        }
        var receiver_arg: rawptr = null;
        if (self.source_param_uses_self_pointer_abi(method_fn, 0)) {
            if (self.type_is_class_pointer_abi(iter_type)) {
                receiver_arg = vyx_rt_build_load(self.mod,
                                                 self.ty_ptr,
                                                 iter_slot,
                                                 "mir.foreach.iter.obj".c_str(),
                                                 20);
            } else {
                receiver_arg = iter_slot;
            }
        } else {
            let loaded = vyx_rt_build_load(self.mod,
                                           self.lower_type(iter_type),
                                           iter_slot,
                                           llvm_mir_empty_name(),
                                           0);
            receiver_arg = self.cast_value(loaded, iter_type, receiver_type);
        }
        if (receiver_arg == null) {
            free(args);
            self.report_error("cannot lower foreach iterator receiver for " + self.m.function_name(method_fn));
            return null;
        }
        ast_write_rawptr(args, receiver_arg);
        var call_label = result_name;
        if (llvm_mir_type_kind(&self.m, self.m.function_return_type(method_fn)) == ty_VOID()) { call_label = ""; }
        let out = vyx_rt_build_call(self.mod,
                                    fn_type,
                                    fn_value,
                                    args,
                                    1,
                                    call_label.c_str(),
                                    call_label.len as u64);
        free(args);
        return out;
    }

    public fn type_is_standard_iterator_abi(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let text = llvm_mir_type_text(&self.m, type_id);
        if (policy_generic_call_has_args(text.clone()) == 0) { return false; }
        if (self.last_path_segment(policy_generic_call_base(text.clone())) != "Iterator") { return false; }
        let data_field = self.field_id_for_type_name(canonical_type, "data");
        let len_field = self.field_id_for_type_name(canonical_type, "len");
        let pos_field = self.field_id_for_type_name(canonical_type, "pos");
        if (vyx_bootstrap_profile_level() > 2
            && (data_field == mir_id_invalid()
                || len_field == mir_id_invalid()
                || pos_field == mir_id_invalid())) {
            print("[llvm-iter-abi] type=" + text
                  + " canonical=" + policy_i64_to_string(canonical_type as i64)
                  + " data=" + policy_i64_to_string(data_field as i64)
                  + " len=" + policy_i64_to_string(len_field as i64)
                  + " pos=" + policy_i64_to_string(pos_field as i64));
        }
        return data_field != mir_id_invalid()
            && len_field != mir_id_invalid()
            && pos_field != mir_id_invalid();
    }

    public fn standard_iterator_payload_type(self, type_id: i32) -> i32 {
        if (!self.type_is_standard_iterator_abi(type_id)) { return mir_id_invalid(); }
        let text = llvm_mir_type_text(&self.m, type_id);
        let args = policy_generic_call_args(text.clone());
        let payload_text = policy_generic_arg_at(args, 0);
        if (payload_text.len == 0) { return mir_id_invalid(); }
        let payload_type = self.type_id_by_text(payload_text);
        if (payload_type == mir_id_invalid()) {
            self.report_error("cannot resolve Iterator payload type " + payload_text);
        }
        return payload_type;
    }

    public fn foreach_collection_type_id(self, type_id: i32) -> i32 {
        var current = type_id;
        var depth: i32 = 0;
        while (current != mir_id_invalid() && depth <= self.m.types.count) {
            let kind = llvm_mir_type_kind(&self.m, current);
            if (kind != ty_REF() && kind != ty_MUTREF()) { return current; }
            current = hir_type_table_elem(self.m.types, current);
            depth = depth + 1;
        }
        return mir_id_invalid();
    }

    public fn indexed_iterable_record_address(self, iter_value: i32) -> rawptr {
        var iter_type = self.m.value_type(iter_value);
        let kind = llvm_mir_type_kind(&self.m, iter_type);
        if (kind == ty_REF() || kind == ty_MUTREF()) {
            var handle = self.lower_value_as(iter_value, iter_type);
            var depth: i32 = 0;
            while (depth <= self.m.types.count) {
                let elem = hir_type_table_elem(self.m.types, iter_type);
                if (elem == mir_id_invalid() || handle == null) { return null; }
                let bytes = self.value_storage_size(elem);
                if (bytes <= 0) {
                    self.report_error("cannot measure borrowed foreach collection " + llvm_mir_type_text(&self.m, elem));
                    return null;
                }
                let address = self.pointer_checked_address(handle,
                                                            vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                            bytes,
                                                            0,
                                                            "mir.foreach.borrow");
                let elem_kind = llvm_mir_type_kind(&self.m, elem);
                if (elem_kind != ty_REF() && elem_kind != ty_MUTREF()) { return address; }
                if (address == null) { return null; }
                handle = vyx_rt_build_load(self.mod, self.lower_type(elem), address, llvm_mir_empty_name(), 0);
                iter_type = elem;
                depth = depth + 1;
            }
            self.report_error("cyclic borrowed foreach collection type");
            return null;
        }
        let slot = self.foreach_iterator_slot_for_value(iter_value);
        if (slot == null) { return null; }
        if (self.type_is_class_pointer_abi(iter_type)) {
            return vyx_rt_build_load(self.mod, self.ty_ptr, slot, "mir.foreach.iter.obj".c_str(), 20);
        }
        return slot;
    }

    public fn type_is_standard_indexed_iterable_abi(self, type_id: i32) -> bool {
        type_id = self.foreach_collection_type_id(type_id);
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let text = llvm_mir_type_text(&self.m, type_id);
        let canonical_text = llvm_mir_type_text(&self.m, canonical_type);
        if (policy_generic_call_has_args(text.clone()) == 0
            && policy_generic_call_has_args(canonical_text.clone()) == 0) { return false; }
        let base = self.last_path_segment(policy_generic_call_base(text.clone()));
        if (base != "Vec") { return false; }
        if (self.field_id_for_type_name(canonical_type, "data") == mir_id_invalid()) { return false; }
        return self.field_id_for_type_name(canonical_type, "len") != mir_id_invalid();
    }

    public fn standard_indexed_iterable_payload_type(self, type_id: i32) -> i32 {
        type_id = self.foreach_collection_type_id(type_id);
        if (!self.type_is_standard_indexed_iterable_abi(type_id)) { return mir_id_invalid(); }
        var text = llvm_mir_type_text(&self.m, type_id);
        var args = policy_generic_call_args(text.clone());
        if (args.len == 0) {
            text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(type_id));
            args = policy_generic_call_args(text.clone());
        }
        let payload_text = policy_generic_arg_at(args, 0);
        if (payload_text.len == 0) { return mir_id_invalid(); }
        let payload_type = self.type_id_by_text(payload_text);
        if (payload_type == mir_id_invalid()) {
            self.report_error("cannot resolve iterable payload type " + payload_text);
        }
        return payload_type;
    }

    public fn lower_indexed_iterable_has_next(self,
                                              iter_value: i32,
                                              index_place: i32,
                                              body_bb: rawptr,
                                              exit_bb: rawptr) -> bool {
        let iter_type = self.canonical_record_type_id(self.foreach_collection_type_id(self.m.value_type(iter_value)));
        let iter_record_addr = self.indexed_iterable_record_address(iter_value);
        let len_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "len");
        let index_addr = self.lower_place_addr(index_place);
        let index_type = self.m.place_type(index_place);
        let index_ll_ty = self.lower_type(index_type);
        if (iter_record_addr == null || len_value == null || index_addr == null || index_ll_ty == null
            || body_bb == null || exit_bb == null) {
            self.report_error("cannot lower indexed foreach condition");
            return false;
        }
        let index_value = vyx_rt_build_load(self.mod,
                                            index_ll_ty,
                                            index_addr,
                                            "mir.foreach.index".c_str(),
                                            17);
        let in_range = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_slt(),
                                         index_value,
                                         len_value,
                                         llvm_mir_empty_name(),
                                         0);
        if (index_value == null || in_range == null) {
            self.report_error("cannot compare indexed foreach position");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, in_range, body_bb, exit_bb);
        return true;
    }

    public fn advance_indexed_iterable(self, index_addr: rawptr, index_value: rawptr) -> bool {
        if (index_addr == null || index_value == null) {
            self.report_error("cannot advance indexed foreach position");
            return false;
        }
        let next_pos = vyx_rt_build_add(self.mod,
                                        index_value,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (next_pos == null) {
            self.report_error("cannot compute next indexed foreach position");
            return false;
        }
        vyx_rt_build_store(self.mod, next_pos, index_addr);
        return true;
    }

    public fn lower_indexed_iterable_bind_instr(self, instr_id: i32) -> bool {
        let iter_value = self.m.instr_value(instr_id);
        let iter_value_type = self.foreach_collection_type_id(self.m.value_type(iter_value));
        let iter_type = self.canonical_record_type_id(iter_value_type);
        let iter_record_addr = self.indexed_iterable_record_address(iter_value);
        let index_place = self.m.instr_aux(instr_id);
        let index_addr = self.lower_place_addr(index_place);
        let index_type = self.m.place_type(index_place);
        let index_ll_ty = self.lower_type(index_type);
        let dst_place = self.m.instr_place(instr_id);
        let dst_addr = self.lower_place_addr(dst_place);
        let dst_type = self.m.place_type(dst_place);
        let payload_type = self.standard_indexed_iterable_payload_type(iter_value_type);
        let payload_ll = self.lower_type(payload_type);
        if (iter_record_addr == null || index_addr == null || index_ll_ty == null
            || dst_addr == null || payload_type == mir_id_invalid() || payload_ll == null) {
            self.report_error("cannot lower indexed foreach bind in instr #"
                      + policy_i64_to_string(instr_id as i64));
            return false;
        }
        let data_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "data");
        var payload_size = self.load_record_field_from_addr(iter_record_addr, iter_type, "elem_size");
        if (payload_size == null) {
            payload_size = vyx_rt_const_int(self.mod,
                                            self.ty_i64,
                                            self.value_storage_size(payload_type),
                                            0);
        }
        let index_value = vyx_rt_build_load(self.mod,
                                            index_ll_ty,
                                            index_addr,
                                            "mir.foreach.index".c_str(),
                                            17);
        if (data_value == null || payload_size == null || index_value == null) {
            self.report_error("cannot load indexed foreach element slot");
            return false;
        }
        let byte_offset = vyx_rt_build_mul(self.mod,
                                           index_value,
                                           payload_size,
                                           llvm_mir_empty_name(),
                                           0);
        let element_ptr = self.ptr_offset_bytes(data_value, byte_offset, "mir.foreach.elem");
        if (byte_offset == null || element_ptr == null) {
            self.report_error("cannot address indexed foreach element");
            return false;
        }
        if (self.type_ids_compatible(payload_type, dst_type)) {
            var dst_copy_addr = dst_addr;
            if (self.type_is_class_pointer_abi(dst_type)) {
                dst_copy_addr = self.ensure_class_object_addr_from_place_addr(dst_place, dst_addr, dst_type);
            }
            if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("memcpy declaration is unavailable");
                return false;
            }
            let copied = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcpy_fty,
                                            self.builtin_memcpy_fn,
                                            dst_copy_addr,
                                            element_ptr,
                                            payload_size,
                                            llvm_mir_empty_name(),
                                            0);
            if (copied == null) {
                self.report_error("cannot copy indexed foreach element");
                return false;
            }
        } else {
            let value_slot = vyx_rt_build_alloca(self.mod, payload_ll, "mir.foreach.elem.value".c_str(), 22);
            if (value_slot == null || self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("cannot allocate indexed foreach element storage");
                return false;
            }
            let copied2 = vyx_rt_build_call3(self.mod,
                                             self.builtin_memcpy_fty,
                                             self.builtin_memcpy_fn,
                                             value_slot,
                                             element_ptr,
                                             payload_size,
                                             llvm_mir_empty_name(),
                                             0);
            let payload_value = vyx_rt_build_load(self.mod,
                                                  payload_ll,
                                                  value_slot,
                                                  "mir.foreach.elem.value".c_str(),
                                                  22);
            let cast_value = self.cast_value(payload_value, payload_type, dst_type);
            if (copied2 == null || payload_value == null || cast_value == null) {
                self.report_error("cannot convert indexed foreach element");
                return false;
            }
            vyx_rt_build_store(self.mod, cast_value, dst_addr);
        }
        return self.advance_indexed_iterable(index_addr, index_value);
    }

    public fn lower_standard_iterator_invalidation_check(self, iter_slot: rawptr, iter_type: i32) -> bool {
        let canonical_type = self.canonical_record_type_id(iter_type);
        if (self.field_id_for_type_name(canonical_type, "source_gen") == mir_id_invalid()
            || self.field_id_for_type_name(canonical_type, "gen_snapshot") == mir_id_invalid()) {
            return true;
        }
        let source_gen = self.load_record_field_from_addr(iter_slot, canonical_type, "source_gen");
        let snapshot = self.load_record_field_from_addr(iter_slot, canonical_type, "gen_snapshot");
        if (source_gen == null || snapshot == null) {
            self.report_error("cannot lower Iterator invalidation guard");
            return false;
        }
        let has_source = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_ne(),
                                           source_gen,
                                           vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                           llvm_mir_empty_name(),
                                           0);
        let check_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           "mir.foreach.iter.check".c_str(),
                                           22);
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.foreach.iter.fail".c_str(),
                                          21);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.foreach.iter.cont".c_str(),
                                          21);
        if (has_source == null || check_bb == null || fail_bb == null || cont_bb == null) {
            self.report_error("cannot create Iterator invalidation guard blocks");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, has_source, check_bb, cont_bb);
        vyx_rt_position_at_end(self.mod, check_bb);
        let current_gen = vyx_rt_build_load(self.mod,
                                            self.ty_i64,
                                            source_gen,
                                            "mir.foreach.gen".c_str(),
                                            15);
        let changed = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_ne(),
                                        current_gen,
                                        snapshot,
                                        llvm_mir_empty_name(),
                                        0);
        if (current_gen == null || changed == null) {
            self.report_error("cannot compare Iterator generation");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, changed, fail_bb, cont_bb);
        vyx_rt_position_at_end(self.mod, fail_bb);
        if (self.emit_printf_cstr_line(self.emit_str_ptr("Iterator invalidated: source container was modified during iteration")) == null) {
            self.report_error("cannot emit Iterator invalidation diagnostic");
            return false;
        }
        if (self.builtin_abort_fn == null || self.builtin_abort_fty == null) {
            self.report_error("abort declaration is unavailable");
            return false;
        }
        vyx_rt_build_call(self.mod, self.builtin_abort_fty, self.builtin_abort_fn, null, 0, llvm_mir_empty_name(), 0);
        vyx_rt_build_unreachable(self.mod);
        vyx_rt_position_at_end(self.mod, cont_bb);
        return true;
    }

    public fn lower_standard_iterator_has_next(self, iter_value: i32, body_bb: rawptr, exit_bb: rawptr) -> bool {
        let raw_iter_type = self.m.value_type(iter_value);
        let iter_type = self.canonical_record_type_id(raw_iter_type);
        let iter_slot = self.foreach_iterator_slot_for_value(iter_value);
        var iter_record_addr = iter_slot;
        if (iter_slot != null && self.type_is_class_pointer_abi(raw_iter_type)) {
            iter_record_addr = vyx_rt_build_load(self.mod,
                                                 self.ty_ptr,
                                                 iter_slot,
                                                 "mir.foreach.iter.obj".c_str(),
                                                 20);
        }
        let pos_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "pos");
        let len_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "len");
        if (iter_slot == null || iter_record_addr == null || pos_value == null || len_value == null || body_bb == null || exit_bb == null) {
            self.report_error("cannot lower Iterator foreach condition");
            return false;
        }
        let in_range = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_slt(),
                                         pos_value,
                                         len_value,
                                         llvm_mir_empty_name(),
                                         0);
        if (in_range == null) {
            self.report_error("cannot compare Iterator position");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, in_range, body_bb, exit_bb);
        return true;
    }

    public fn advance_standard_iterator(self, iter_slot: rawptr, iter_type: i32, pos_value: rawptr) -> bool {
        let pos_addr = self.record_field_addr_for_type(iter_slot, iter_type, "pos");
        if (pos_addr == null || pos_value == null) {
            self.report_error("cannot advance Iterator position");
            return false;
        }
        let next_pos = vyx_rt_build_add(self.mod,
                                        pos_value,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (next_pos == null) {
            self.report_error("cannot compute next Iterator position");
            return false;
        }
        vyx_rt_build_store(self.mod, next_pos, pos_addr);
        return true;
    }

    public fn lower_standard_iterator_bind_instr(self, instr_id: i32) -> bool {
        let iter_value = self.m.instr_value(instr_id);
        let raw_iter_type = self.m.value_type(iter_value);
        let iter_type = self.canonical_record_type_id(raw_iter_type);
        let iter_slot = self.foreach_iterator_slot_for_value(iter_value);
        var iter_record_addr = iter_slot;
        if (iter_slot != null && self.type_is_class_pointer_abi(raw_iter_type)) {
            iter_record_addr = vyx_rt_build_load(self.mod,
                                                 self.ty_ptr,
                                                 iter_slot,
                                                 "mir.foreach.iter.obj".c_str(),
                                                 20);
        }
        let dst_place = self.m.instr_place(instr_id);
        let dst_addr = self.lower_place_addr(dst_place);
        let dst_type = self.place_effective_type(dst_place);
        let payload_type = self.standard_iterator_payload_type(raw_iter_type);
        let payload_ll = self.lower_type(payload_type);
        if (iter_slot == null || dst_addr == null || payload_type == mir_id_invalid() || payload_ll == null) {
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-iter-bind] instr=" + policy_i64_to_string(instr_id as i64)
                      + " iter-type=" + llvm_mir_type_text(&self.m, iter_type)
                      + " dst-type=" + llvm_mir_type_text(&self.m, dst_type)
                      + " payload-type=" + llvm_mir_type_text(&self.m, payload_type)
                      + " iter-slot=" + policy_i64_to_string((iter_slot != null) as i64)
                      + " dst-addr=" + policy_i64_to_string((dst_addr != null) as i64)
                      + " payload-valid=" + policy_i64_to_string((payload_type != mir_id_invalid()) as i64)
                      + " payload-ll=" + policy_i64_to_string((payload_ll != null) as i64));
            }
            self.report_error("cannot lower Iterator foreach bind in instr #"
                      + policy_i64_to_string(instr_id as i64));
            return false;
        }
        if (!self.lower_standard_iterator_invalidation_check(iter_record_addr, iter_type)) { return false; }
        let data_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "data");
        let pos_value = self.load_record_field_from_addr(iter_record_addr, iter_type, "pos");
        if (data_value == null || pos_value == null) {
            self.report_error("cannot load Iterator data slot");
            return false;
        }
        let payload_size = vyx_rt_const_int(self.mod,
                                            self.ty_i64,
                                            self.value_storage_size(payload_type),
                                            0);
        let byte_offset = vyx_rt_build_mul(self.mod,
                                           pos_value,
                                           payload_size,
                                           llvm_mir_empty_name(),
                                           0);
        let element_ptr = self.ptr_offset_bytes(data_value, byte_offset, "mir.foreach.elem");
        if (byte_offset == null || element_ptr == null) {
            self.report_error("cannot address Iterator element");
            return false;
        }
        if (self.type_ids_compatible(payload_type, dst_type)) {
            var dst_copy_addr = dst_addr;
            if (self.type_is_class_pointer_abi(dst_type)) {
                dst_copy_addr = self.ensure_class_object_addr_from_place_addr(dst_place, dst_addr, dst_type);
            }
            if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("memcpy declaration is unavailable");
                return false;
            }
            let copied = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcpy_fty,
                                            self.builtin_memcpy_fn,
                                            dst_copy_addr,
                                            element_ptr,
                                            payload_size,
                                            llvm_mir_empty_name(),
                                            0);
            if (copied == null) {
                self.report_error("cannot copy Iterator element");
                return false;
            }
        } else {
            let value_slot = vyx_rt_build_alloca(self.mod, payload_ll, "mir.foreach.elem.value".c_str(), 22);
            if (value_slot == null || self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("cannot allocate Iterator element storage");
                return false;
            }
            let copied2 = vyx_rt_build_call3(self.mod,
                                             self.builtin_memcpy_fty,
                                             self.builtin_memcpy_fn,
                                             value_slot,
                                             element_ptr,
                                             payload_size,
                                             llvm_mir_empty_name(),
                                             0);
            let payload_value = vyx_rt_build_load(self.mod,
                                                  payload_ll,
                                                  value_slot,
                                                  "mir.foreach.elem.value".c_str(),
                                                  22);
            let cast_value = self.cast_value(payload_value, payload_type, dst_type);
            if (copied2 == null || payload_value == null || cast_value == null) {
                self.report_error("cannot convert Iterator element");
                return false;
            }
            vyx_rt_build_store(self.mod, cast_value, dst_addr);
        }
        return self.advance_standard_iterator(iter_record_addr, iter_type, pos_value);
    }

    public fn lower_method_iterator_has_next(self, iter_value: i32, body_bb: rawptr, exit_bb: rawptr) -> bool {
        let iter_type = self.m.value_type(iter_value);
        let method_fn = self.foreach_method_for_iterator(iter_type, "has_next");
        if (method_fn == mir_id_invalid()) { return false; }
        let iter_slot = self.foreach_iterator_slot_for_value(iter_value);
        let result = self.lower_iterator_method_call_from_slot(method_fn, iter_slot, iter_type, "mir.foreach.has_next");
        let cond = self.truthy_value(result, self.m.function_return_type(method_fn));
        if (cond == null || body_bb == null || exit_bb == null) {
            self.report_error("cannot lower foreach has_next call for " + llvm_mir_type_text(&self.m, iter_type));
            return false;
        }
        vyx_rt_build_cond_br(self.mod, cond, body_bb, exit_bb);
        return true;
    }

    public fn lower_method_iterator_bind_instr(self, instr_id: i32) -> bool {
        let iter_value = self.m.instr_value(instr_id);
        let iter_type = self.m.value_type(iter_value);
        let method_fn = self.foreach_method_for_iterator(iter_type, "next");
        if (method_fn == mir_id_invalid()) { return false; }
        let iter_slot = self.foreach_iterator_slot_for_value(iter_value);
        let option_type = self.m.function_return_type(method_fn);
        if (!self.type_is_option_abi(option_type)) {
            self.report_error("foreach next method must return Option, got "
                      + llvm_mir_type_text(&self.m, option_type));
            return false;
        }
        let next_value = self.lower_iterator_method_call_from_slot(method_fn, iter_slot, iter_type, "mir.foreach.next");
        let payload_type = self.option_payload_type(option_type);
        let payload = self.option_payload_value(next_value, option_type);
        let dst_place = self.m.instr_place(instr_id);
        let dst_addr = self.lower_place_addr(dst_place);
        let dst_type = self.place_effective_type(dst_place);
        let cast_payload = self.cast_value(payload, payload_type, dst_type);
        if (next_value == null || payload_type == mir_id_invalid() || payload == null || dst_addr == null || cast_payload == null) {
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-iter-method-bind] instr=" + policy_i64_to_string(instr_id as i64)
                      + " iter-type=" + llvm_mir_type_text(&self.m, iter_type)
                      + " option-type=" + llvm_mir_type_text(&self.m, option_type)
                      + " payload-type=" + llvm_mir_type_text(&self.m, payload_type)
                      + " dst-type=" + llvm_mir_type_text(&self.m, dst_type));
            }
            self.report_error("cannot bind foreach next payload in instr #"
                      + policy_i64_to_string(instr_id as i64));
            return false;
        }
        vyx_rt_build_store(self.mod, cast_payload, dst_addr);
        return true;
    }

    public fn lower_foreach_bind_instr(self, instr_id: i32) {
        let iter_value = self.m.instr_value(instr_id);
        if (!self.value_is_reflection_iterable(iter_value)) {
            let iter_type = self.m.value_type(iter_value);
            let method_fn = self.foreach_method_for_iterator(iter_type, "next");
            let standard_iterator = self.type_is_standard_iterator_abi(iter_type);
            let standard_indexed = self.type_is_standard_indexed_iterable_abi(iter_type);
            if (vyx_bootstrap_profile_level() > 2) {
                let canonical_type = self.canonical_record_type_id(iter_type);
                print("[llvm-iter-dispatch] instr=" + policy_i64_to_string(instr_id as i64)
                      + " type=" + llvm_mir_type_text(&self.m, iter_type)
                      + " kind=" + policy_i64_to_string(llvm_mir_type_kind(&self.m, iter_type) as i64)
                      + " canonical=" + llvm_mir_type_text(&self.m, canonical_type)
                      + " method=" + policy_i64_to_string(method_fn as i64)
                      + " standard=" + policy_i64_to_string(standard_iterator as i64)
                      + " indexed=" + policy_i64_to_string(standard_indexed as i64));
            }
            if (standard_iterator) {
                self.lower_standard_iterator_bind_instr(instr_id);
                return;
            }
            if (standard_indexed) {
                self.lower_indexed_iterable_bind_instr(instr_id);
                return;
            }
            if (method_fn != mir_id_invalid() && self.lower_method_iterator_bind_instr(instr_id)) { return; }
            self.report_error("cannot lower foreach bind for iterator type "
                      + llvm_mir_type_text(&self.m, iter_type)
                      + " in instr #" + policy_i64_to_string(instr_id as i64));
            return;
        }
        let index_place = self.m.instr_aux(instr_id);
        let index_addr = self.lower_place_addr(index_place);
        let index_type = self.m.place_type(index_place);
        let index_ll_ty = self.lower_type(index_type);
        if (index_addr == null || index_ll_ty == null) {
            self.report_error("cannot lower reflection foreach index for instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        let index_value = vyx_rt_build_load(self.mod,
                                            index_ll_ty,
                                            index_addr,
                                            "mir.foreach.index".c_str(),
                                            17);
        let dst_place = self.m.instr_place(instr_id);
        let dst_addr = self.lower_place_addr(dst_place);
        let dst_type = self.m.place_type(dst_place);
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type);
        let dst_bits = llvm_mir_int_bits_for_kind(dst_kind);
        if (dst_addr == null || index_value == null) {
            self.report_error("cannot bind reflection foreach value in instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        if (dst_bits <= 0) {
            self.report_error("reflection foreach bind requires an integer destination, got "
                      + llvm_mir_type_text(&self.m, dst_type));
            return;
        }
        let cast_index = self.cast_value(index_value, index_type, dst_type);
        if (cast_index == null) {
            self.report_error("cannot cast reflection foreach index for instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        vyx_rt_build_store(self.mod, cast_index, dst_addr);
        let next_index = vyx_rt_build_add(self.mod,
                                          index_value,
                                          vyx_rt_const_int(self.mod, index_ll_ty, 1, 0),
                                          llvm_mir_empty_name(),
                                          0);
        if (next_index == null) {
            self.report_error("cannot advance reflection foreach index for instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        vyx_rt_build_store(self.mod, next_index, index_addr);
    }

    public fn allocate_locals_for_function(self, function_id: i32) {
        var frame: rawptr = null;
        var ctx_ty: rawptr = null;
        if (self.function_is_async_task_callable(function_id)) {
            frame = self.async_runtime_call0("vio_async_frame_get");
            ctx_ty = self.get_or_create_async_context_type(function_id);
        }
        let zero32 = vyx_rt_const_int(self.mod, self.ty_i32, 0, 1);
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (!self.local_is_capture(local)) {
                let effective_type = self.local_effective_type(local);
                if (effective_type == mir_id_invalid()
                    || llvm_mir_type_text(&self.m, effective_type).len == 0
                    || llvm_mir_type_kind(&self.m, effective_type) == ty_VOID()) {
                    self.report_error("cannot allocate local "
                                      + self.m.local_name(local)
                                      + " with invalid type `"
                                      + llvm_mir_type_text(&self.m, effective_type)
                                      + "`");
                    local = self.m.local_next(local);
                    continue;
                }
                var ty = self.lower_type(effective_type);
                if (vyx_bootstrap_profile_level() > 2) {
                    let canonical_type = self.canonical_record_type_id(effective_type);
                    print("[llvm-mir-local] fn=" + policy_i64_to_string(function_id as i64)
                          + " local=" + policy_i64_to_string(local as i64)
                          + " name=" + self.m.local_name(local)
                          + " type=" + policy_i64_to_string(effective_type as i64)
                          + " text=" + llvm_mir_type_text(&self.m, effective_type)
                          + " kind=" + policy_i64_to_string(llvm_mir_type_kind(&self.m, effective_type) as i64)
                          + " canonical=" + policy_i64_to_string(canonical_type as i64)
                          + " fields=" + policy_i64_to_string(mir_unit_field_count_for_type(&self.m, canonical_type) as i64)
                          + " body=" + policy_i64_to_string(llvm_mir_i32_map_get(self.type_struct_body_field_counts,
                                                                                 canonical_type) as i64));
                }
                if (self.local_is_self_pointer_abi_slot(function_id, local)) {
                    ty = self.ty_ptr;
                }
                if (ty == null) {
                    self.report_error("cannot lower local type for "
                                      + self.m.local_name(local)
                                      + " as `"
                                      + llvm_mir_type_text(&self.m, effective_type)
                                      + "`");
                    local = self.m.local_next(local);
                    continue;
                }
                let name = self.m.local_name(local);
                var slot: rawptr = null;
                var reuse_source = mir_id_invalid();
                // Earlier generated temporaries remain in the chain but are
                // absent from this body. HIR-backed locals are reused and keep
                // their frame slots even when their ids precede the body mark.
                var frame_field: i32 = -1;
                if (self.async_local_is_frame_slot(function_id, local)
                    && frame != null && ctx_ty != null) {
                    frame_field = self.async_ctx_field_for_local(function_id, local);
                }
                if (frame_field >= 0) {
                    slot = vyx_rt_build_gep2(self.mod,
                                             ctx_ty,
                                             frame,
                                             zero32,
                                             vyx_rt_const_int(self.mod, self.ty_i32, frame_field as i64, 1),
                                             name.c_str(),
                                             name.len as u64);
                } else {
                    reuse_source = self.local_slot_reuse_source_for(function_id, local);
                    if (reuse_source != mir_id_invalid()) {
                        let source_slot = llvm_mir_map_get(self.local_slots, reuse_source);
                        if (source_slot != null) {
                            slot = source_slot;
                            llvm_mir_i32_map_put(self.local_slot_reuse_sources, local, reuse_source);
                            llvm_mir_i32_map_put(self.local_slot_reuse_sources, reuse_source, -1);
                        } else {
                            reuse_source = mir_id_invalid();
                        }
                    }
                    if (slot == null) {
                        slot = vyx_rt_build_alloca(self.mod, ty, name.c_str(), name.len as u64);
                    }
                }
                if (slot == null) {
                    self.report_error("cannot allocate local " + name);
                } else {
                    if (reuse_source == mir_id_invalid()
                        && !self.async_local_is_frame_slot(function_id, local)) {
                        let dci_alignment = self.dci_type_value_alignment(effective_type);
                        if (dci_alignment > 0) {
                            vyx_rt_set_alignment(self.mod, slot, dci_alignment as i32);
                        }
                    }
                    llvm_mir_map_put(self.local_slots, local, slot);
                    if (reuse_source == mir_id_invalid()
                        && !self.async_local_is_frame_slot(function_id, local)
                        && self.type_is_class_pointer_abi(self.local_effective_type(local))) {
                        vyx_rt_build_store(self.mod,
                                           vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                           slot);
                    }
                }
            }
            local = self.m.local_next(local);
        }
    }

    public fn bind_captures_from_env(self, function_id: i32, env_param: rawptr) {
        if (self.function_capture_count(function_id) <= 0) { return; }
        if (env_param == null) {
            self.report_error("missing closure env parameter for " + self.m.function_name(function_id));
            return;
        }
        var idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_capture(local)) {
                let field_ptr = self.closure_env_field_ptr(function_id, env_param, idx, self.m.local_name(local));
                if (field_ptr == null) {
                    self.report_error("cannot bind captured local " + self.m.local_name(local));
                    return;
                }
                if (self.local_is_reference_capture(local)) {
                    let captured_slot = vyx_rt_build_load(self.mod,
                                                          self.ty_ptr,
                                                          field_ptr,
                                                          self.m.local_name(local).c_str(),
                                                          self.m.local_name(local).len as u64);
                    if (captured_slot == null) {
                        self.report_error("cannot bind reference capture " + self.m.local_name(local));
                        return;
                    }
                    llvm_mir_map_put(self.local_slots, local, captured_slot);
                } else {
                    llvm_mir_map_put(self.local_slots, local, field_ptr);
                }
                idx = idx + 1;
            }
            local = self.m.local_next(local);
        }
    }

    public fn store_params_for_function(self, function_id: i32) {
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-mir-store-params] fn="
                  + policy_i64_to_string(function_id as i64)
                  + " src=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                  + " llvm=" + policy_i64_to_string(self.function_llvm_param_count(function_id) as i64)
                  + " actual=" + policy_i64_to_string(self.debug_llvm_function_param_count(self.current_function_value) as i64)
                  + " first_local=" + policy_i64_to_string(self.m.function_first_local(function_id) as i64)
                  + " name=" + self.m.function_name(function_id));
        }
        var param_index: i32 = 0;
        if (self.function_uses_hidden_sret(function_id)) {
            param_index = 1;
        }
        if (self.function_uses_c_main_abi(function_id)) {
            if (!self.declare_main_arg_globals()) { return; }
            let argc_param = vyx_rt_get_param(self.mod, self.current_function_value, 0);
            let argv_param = vyx_rt_get_param(self.mod, self.current_function_value, 1);
            if (argc_param == null || argv_param == null) {
                self.report_error("cannot read C main argc/argv parameters");
                return;
            }
            if (self.runtime_set_args_fn == null || self.runtime_set_args_fty == null) {
                self.report_error("process argument initializer is unavailable");
                return;
            }
            let init_args = vyx_rt_build_call2(self.mod,
                                               self.runtime_set_args_fty,
                                               self.runtime_set_args_fn,
                                               argc_param,
                                               argv_param,
                                               llvm_mir_empty_name(),
                                               0);
            if (init_args == null) {
                self.report_error("cannot initialize process arguments");
                return;
            }
            vyx_rt_build_store(self.mod, argc_param, self.runtime_argc_global);
            vyx_rt_build_store(self.mod, argv_param, self.runtime_argv_global);
            param_index = 2;
        }
        if (self.function_hidden_env_param_count(function_id) > 0) {
            let env_param = vyx_rt_get_param(self.mod, self.current_function_value, param_index as u64);
            if (self.function_capture_count(function_id) > 0) {
                self.bind_captures_from_env(function_id, env_param);
            }
            param_index = param_index + 1;
        }
        var source_idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) {
                if (self.async_local_is_frame_slot(function_id, local)) {
                    // The spawn side already stored the logical argument in
                    // this frame slot. Rebinding on each worker poll would
                    // reset mutable parameters to their original values.
                    param_index = param_index + 1;
                    source_idx = source_idx + 1;
                } else if (self.dci_abi_passing(self.dci_source_parameter_abi(function_id, source_idx))
                    == "inalloca"
                    && self.dci_function_inalloca_count(function_id) > 1) {
                    source_idx = source_idx + 1;
                } else {
                let param = vyx_rt_get_param(self.mod, self.current_function_value, param_index as u64);
                if (param == null) {
                    self.report_error("cannot load LLVM parameter " + self.m.local_name(local));
                } else {
                    let slot = llvm_mir_map_get(self.local_slots, local);
                    if (slot == null) {
                        self.report_error("cannot bind parameter " + self.m.local_name(local));
                    } else if (self.source_param_uses_native_byval_abi(function_id, source_idx)) {
                        let struct_ty = self.lower_storage_type(self.local_effective_type(local));
                        let loaded = vyx_rt_build_load(self.mod,
                                                       struct_ty,
                                                       param,
                                                       "mir.byval.load".c_str(),
                                                       14);
                        if (struct_ty == null || loaded == null) {
                            self.report_error("cannot load byval parameter " + self.m.local_name(local));
                        } else {
                            let debug_store = vyx_rt_build_store(self.mod, loaded, slot);
                            self.emit_debug_local_at_assignment(local, debug_store);
                        }
                    } else if (self.source_param_uses_c_sysv_coerce(function_id, source_idx)) {
                        let restored = self.c_sysv_uncoerce_value(param,
                                                                 self.local_effective_type(local),
                                                                 "c.abi.param");
                        if (restored == null) {
                            self.report_error("cannot uncoerce C SysV parameter "
                                      + self.m.local_name(local));
                        } else {
                            let debug_store = vyx_rt_build_store(self.mod, restored, slot);
                            self.emit_debug_local_at_assignment(local, debug_store);
                        }
                    } else {
                        var stored = param;
                        if (self.source_param_incoming_is_raw_pointer_handle(function_id, source_idx)) {
                            stored = self.build_pointer_handle(
                                param,
                                vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                "mir.param.handle");
                            if (stored == null) {
                                self.report_error("cannot wrap raw-pointer parameter "
                                          + self.m.local_name(local));
                            }
                        }
                        if (stored != null) {
                            let debug_store = vyx_rt_build_store(self.mod, stored, slot);
                            self.emit_debug_local_at_assignment(local, debug_store);
                        }
                    }
                }
                param_index = param_index + 1;
                source_idx = source_idx + 1;
                }
            }
            local = self.m.local_next(local);
        }
        if (self.dci_function_inalloca_count(function_id) > 1) {
            let frame = vyx_rt_get_param(self.mod, self.current_function_value, param_index as u64);
            if (frame == null) {
                self.report_error("cannot load packed DCI inalloca frame for `"
                          + self.m.function_name(function_id) + "`");
                return;
            }
            var packed_idx: i32 = 0;
            var packed_local = self.m.function_first_local(function_id);
            while (packed_local != mir_id_invalid()) {
                if (self.local_is_source_param(packed_local)) {
                    if (self.dci_abi_passing(self.dci_source_parameter_abi(function_id, packed_idx))
                        == "inalloca") {
                        let slot = llvm_mir_map_get(self.local_slots, packed_local);
                        let field_ptr = self.dci_inalloca_frame_field_ptr(function_id,
                                                                          frame,
                                                                          packed_idx);
                        if (slot == null || field_ptr == null) {
                            self.report_error("cannot bind packed DCI inalloca parameter "
                                      + self.m.local_name(packed_local));
                        } else {
                            let debug_store = vyx_rt_build_store(self.mod, field_ptr, slot);
                            self.emit_debug_local_at_assignment(packed_local, debug_store);
                        }
                    }
                    packed_idx = packed_idx + 1;
                }
                packed_local = self.m.local_next(packed_local);
            }
        }
    }

    public fn declare_debug_locals_for_function(self, function_id: i32) {
        if (!self.debug_enabled || self.current_function_value == null) { return; }
        var source_arg_index: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (!self.local_is_capture(local)) {
                let name = self.m.local_name(local);
                let hir_local = self.m.local_hir_id(local);
                let slot = llvm_mir_map_get(self.local_slots, local);
                if (slot != null && hir_local != hir_id_invalid()
                    && name.len > 0 && !name.contains("$")) {
                    llvm_mir_i32_map_put(self.local_debug_pending, local, 1);
                    if (self.local_is_source_param(local)) {
                        source_arg_index = source_arg_index + 1;
                    }
                } else if (self.local_is_source_param(local)) {
                    source_arg_index = source_arg_index + 1;
                }
            }
            local = self.m.local_next(local);
        }
    }

    public fn emit_debug_local_at_assignment(self, local: i32, assignment: rawptr) {
        if (!self.debug_enabled || assignment == null || local == mir_id_invalid()) { return; }
        if (llvm_mir_i32_map_get(self.local_debug_pending, local) == 0) { return; }
        let name = self.m.local_name(local);
        let slot = llvm_mir_map_get(self.local_slots, local);
        if (slot == null || name.len == 0) { return; }
        let type_id = self.local_effective_type(local);
        let llvm_ty = self.lower_type(type_id);
        if (llvm_ty == null) { return; }
        var source_arg_index: i32 = 0;
        var arg_index: i32 = 0;
        if (self.local_is_source_param(local)) {
            var cursor = self.m.function_first_local(self.current_function_id);
            while (cursor != mir_id_invalid()) {
                if (self.local_is_source_param(cursor)) {
                    source_arg_index = source_arg_index + 1;
                    if (cursor == local) { arg_index = source_arg_index; }
                }
                cursor = self.m.local_next(cursor);
            }
        }
        var line = self.m.local_loc_line(local);
        if (line <= 0) { line = self.debug_function_line(self.current_function_id); }
        let type_name = llvm_mir_type_text(&self.m, type_id);
        let field_names = self.debug_record_field_names(type_id);
        let saved_block = vyx_rt_get_insert_block(self.mod);
        vyx_rt_position_before(self.mod, assignment);
        vyx_rt_debug_declare_local(self.mod,
                                   self.current_function_value,
                                   slot,
                                   llvm_ty,
                                   name.c_str(),
                                   name.len as u64,
                                   type_name.c_str(),
                                   type_name.len as u64,
                                   field_names.c_str(),
                                   field_names.len as u64,
                                   line,
                                   arg_index);
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
        llvm_mir_i32_map_put(self.local_debug_pending, local, 0);
    }

    public fn debug_record_field_names(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        let owner = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, owner) != ty_CLASS()) { return ""; }
        let count = mir_unit_field_count_for_type(&self.m, owner);
        if (count <= 0) { return ""; }
        var names = "";
        var index: i32 = 0;
        while (index < count) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, owner, index);
            if (field_id == mir_id_invalid()) { return ""; }
            let field_name = mir_unit_field_name(&self.m, field_id);
            if (field_name.len == 0) { return ""; }
            if (index > 0) { names = names + ","; }
            names = names + field_name;
            index = index + 1;
        }
        return names;
    }

    public fn static_assert_sizeof_known(self, value_id: i32) -> bool {
        if (self.m.value_kind(value_id) != mir_value_call()) { return false; }
        let name = self.builtin_name_for_call(value_id);
        if (policy_generic_call_base(name.clone()) != "sizeof") { return false; }
        let args = policy_generic_call_args(name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) { return false; }
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        if (type_id == mir_id_invalid()) { return false; }
        return self.value_storage_size(type_id) > 0;
    }

    public fn static_assert_sizeof_value(self, value_id: i32) -> i64 {
        let name = self.builtin_name_for_call(value_id);
        let args = policy_generic_call_args(name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        return self.value_storage_size(type_id);
    }

    public fn static_assert_i64_known(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_int()
            || kind == mir_value_const_bool()
            || kind == mir_value_const_char()) {
            return true;
        }
        if (kind == mir_value_call()) {
            return self.static_assert_sizeof_known(value_id);
        }
        if (kind == mir_value_cast()) {
            return self.static_assert_i64_known(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_PLUS() || op == llvm_mir_tk_MINUS() || op == llvm_mir_tk_TILDE()) {
                return self.static_assert_i64_known(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op2 = self.m.value_op(value_id);
            if (op2 == llvm_mir_tk_PLUS() || op2 == llvm_mir_tk_MINUS() || op2 == llvm_mir_tk_STAR()
                || op2 == llvm_mir_tk_SLASH() || op2 == llvm_mir_tk_PERCENT()
                || op2 == llvm_mir_tk_AMP() || op2 == llvm_mir_tk_PIPE() || op2 == llvm_mir_tk_CARET()
                || op2 == llvm_mir_tk_LSHIFT() || op2 == llvm_mir_tk_RSHIFT()) {
                if (!self.static_assert_i64_known(self.m.value_lhs(value_id))) { return false; }
                if (!self.static_assert_i64_known(self.m.value_rhs(value_id))) { return false; }
                if ((op2 == llvm_mir_tk_SLASH() || op2 == llvm_mir_tk_PERCENT())
                    && self.static_assert_i64_value(self.m.value_rhs(value_id)) == 0) {
                    return false;
                }
                return true;
            }
            return false;
        }
        if (kind == mir_value_control_result()) {
            if (!self.static_assert_bool_known(self.m.value_lhs(value_id))) { return false; }
            if (!self.static_assert_i64_known(self.m.value_rhs(value_id))) { return false; }
            return self.static_assert_i64_known(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn static_assert_i64_value(self, value_id: i32) -> i64 {
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_int()
            || kind == mir_value_const_bool()
            || kind == mir_value_const_char()) {
            return self.m.value_int(value_id);
        }
        if (kind == mir_value_call()) {
            return self.static_assert_sizeof_value(value_id);
        }
        if (kind == mir_value_cast()) {
            return self.static_assert_i64_value(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            let inner = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_MINUS()) { return 0 - inner; }
            if (op == llvm_mir_tk_TILDE()) { return ~inner; }
            return inner;
        }
        if (kind == mir_value_binary()) {
            let op2 = self.m.value_op(value_id);
            let lhs = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let rhs = self.static_assert_i64_value(self.m.value_rhs(value_id));
            if (op2 == llvm_mir_tk_PLUS()) { return lhs + rhs; }
            if (op2 == llvm_mir_tk_MINUS()) { return lhs - rhs; }
            if (op2 == llvm_mir_tk_STAR()) { return lhs * rhs; }
            if (op2 == llvm_mir_tk_SLASH()) { return lhs / rhs; }
            if (op2 == llvm_mir_tk_PERCENT()) { return lhs % rhs; }
            if (op2 == llvm_mir_tk_AMP()) { return lhs & rhs; }
            if (op2 == llvm_mir_tk_PIPE()) { return lhs | rhs; }
            if (op2 == llvm_mir_tk_CARET()) { return lhs ^ rhs; }
            if (op2 == llvm_mir_tk_LSHIFT()) { return lhs << rhs; }
            if (op2 == llvm_mir_tk_RSHIFT()) { return lhs >> rhs; }
        }
        if (kind == mir_value_control_result()) {
            if (self.static_assert_bool_value(self.m.value_lhs(value_id))) {
                return self.static_assert_i64_value(self.m.value_rhs(value_id));
            }
            return self.static_assert_i64_value(self.m.value_aux(value_id));
        }
        return 0;
    }

    public fn static_assert_bool_known(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_bool()) { return true; }
        if (kind == mir_value_const_int() || kind == mir_value_const_char()) { return true; }
        if (kind == mir_value_cast()) {
            return self.static_assert_bool_known(self.m.value_lhs(value_id))
                || self.static_assert_i64_known(self.m.value_lhs(value_id));
        }
        if (kind == mir_value_unary()) {
            if (self.m.value_op(value_id) == llvm_mir_tk_NOT()) {
                return self.static_assert_bool_known(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_AND() || op == llvm_mir_tk_OR()) {
                return self.static_assert_bool_known(self.m.value_lhs(value_id))
                    && self.static_assert_bool_known(self.m.value_rhs(value_id));
            }
            if (op == llvm_mir_tk_EQEQ() || op == llvm_mir_tk_NEQ()
                || op == llvm_mir_tk_LT() || op == llvm_mir_tk_LE()
                || op == llvm_mir_tk_GT() || op == llvm_mir_tk_GE()) {
                return self.static_assert_i64_known(self.m.value_lhs(value_id))
                    && self.static_assert_i64_known(self.m.value_rhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_control_result()) {
            if (!self.static_assert_bool_known(self.m.value_lhs(value_id))) { return false; }
            if (!self.static_assert_bool_known(self.m.value_rhs(value_id))) { return false; }
            return self.static_assert_bool_known(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn static_assert_bool_value(self, value_id: i32) -> bool {
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_bool()) { return self.m.value_int(value_id) != 0; }
        if (kind == mir_value_const_int() || kind == mir_value_const_char()) {
            return self.m.value_int(value_id) != 0;
        }
        if (kind == mir_value_cast()) {
            let inner = self.m.value_lhs(value_id);
            if (self.static_assert_bool_known(inner)) { return self.static_assert_bool_value(inner); }
            return self.static_assert_i64_value(inner) != 0;
        }
        if (kind == mir_value_unary()) {
            if (self.m.value_op(value_id) == llvm_mir_tk_NOT()) {
                return !self.static_assert_bool_value(self.m.value_lhs(value_id));
            }
            return false;
        }
        if (kind == mir_value_binary()) {
            let op = self.m.value_op(value_id);
            if (op == llvm_mir_tk_AND()) {
                return self.static_assert_bool_value(self.m.value_lhs(value_id))
                    && self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            if (op == llvm_mir_tk_OR()) {
                return self.static_assert_bool_value(self.m.value_lhs(value_id))
                    || self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            let lhs = self.static_assert_i64_value(self.m.value_lhs(value_id));
            let rhs = self.static_assert_i64_value(self.m.value_rhs(value_id));
            if (op == llvm_mir_tk_EQEQ()) { return lhs == rhs; }
            if (op == llvm_mir_tk_NEQ()) { return lhs != rhs; }
            if (op == llvm_mir_tk_LT()) { return lhs < rhs; }
            if (op == llvm_mir_tk_LE()) { return lhs <= rhs; }
            if (op == llvm_mir_tk_GT()) { return lhs > rhs; }
            if (op == llvm_mir_tk_GE()) { return lhs >= rhs; }
        }
        if (kind == mir_value_control_result()) {
            if (self.static_assert_bool_value(self.m.value_lhs(value_id))) {
                return self.static_assert_bool_value(self.m.value_rhs(value_id));
            }
            return self.static_assert_bool_value(self.m.value_aux(value_id));
        }
        return false;
    }

    public fn lower_static_assert_instr(self, instr_id: i32) {
        let value_id = self.m.instr_value(instr_id);
        if (!self.static_assert_bool_known(value_id)) {
            self.report_error("static_assert condition is not compile-time evaluable in MIR instr #"
                      + policy_i64_to_string(instr_id as i64));
            return;
        }
        if (!self.static_assert_bool_value(value_id)) {
            self.report_error("static_assert failed in MIR instr #"
                      + policy_i64_to_string(instr_id as i64));
        }
    }

    // Heap-allocate a zeroed object for a class-pointer-ABI record type.
    // Mirrors the allocation half of lower_class_pointer_aggregate_value.
    public fn build_zeroed_class_object(self, type_id: i32) -> rawptr {
        let owner_type = self.canonical_record_type_id(type_id);
        let record_ty = self.class_record_storage_ty(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower zero-init class type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var size_bytes = vyx_rt_type_alloc_size(self.mod, record_ty);
        let dci_size_bytes = self.dci_record_size_bytes_for_type(owner_type);
        if (dci_size_bytes > 0) {
            size_bytes = dci_size_bytes;
        } else if (self.type_is_foreign_dci(owner_type)) {
            self.report_error("missing DCI record layout for external type "
                      + llvm_mir_type_text(&self.m, owner_type));
            return null;
        }
        if (size_bytes <= 0) {
            var measured_fields = mir_unit_field_count_for_type(&self.m, owner_type);
            if (measured_fields <= 0) { measured_fields = 1; }
            size_bytes = ((measured_fields as i64) * 8) + 16;
        }
        let obj = llvm_lifetime_allocate_class_storage(self.mod, size_bytes, "mir.class.zeroinit",
                                                        self.builtin_class_alloc_fty, self.builtin_class_alloc_fn,
                                                        self.builtin_malloc_fty, self.builtin_malloc_fn,
                                                        self.builtin_free_fn,
                                                        self.type_is_foreign_dci(owner_type));
        if (obj == null) { return null; }
        if (self.builtin_memset_fn == null || self.builtin_memset_fty == null) {
            self.report_error("memset is not declared before class zero-initialization");
            return null;
        }
        let zeroed = vyx_rt_build_call3(self.mod,
                                        self.builtin_memset_fty,
                                        self.builtin_memset_fn,
                                        obj,
                                        vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                        vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (zeroed == null) {
            self.report_error("cannot clear zero-init class object " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn lower_instr(self, instr_id: i32) {
        self.current_instr_id = instr_id;
        // Deref addresses are only shared within a single instruction; the
        // next instruction must re-resolve (the pointer may have changed).
        llvm_mir_map_clear_range(self.instr_deref_addr_cache, 0, self.m.place_count + 2);
        self.current_value_id = self.m.instr_value(instr_id);
        self.current_place_id = self.m.instr_place(instr_id);
        let kind = self.m.instr_kind(instr_id);
        if (kind == mir_instr_eval()) {
            let value_id = self.m.instr_value(instr_id);
            if (value_id == mir_id_invalid()) { return; }
            if (self.m.value_kind(value_id) == mir_value_call()
                && self.resolved_call_name(value_id) == "assert") {
                self.lower_assert_call(value_id);
                return;
            }
            self.lower_value(value_id);
            return;
        }
        if (kind == mir_instr_assign()) {
            let place_id = self.m.instr_place(instr_id);
            let dst_type = self.place_effective_type(place_id);
            let addr = self.lower_place_addr(place_id);
            let value_id = self.m.instr_value(instr_id);
            if (addr == null) {
                self.report_error("cannot lower assignment destination for instr #"
                          + policy_i64_to_string(instr_id as i64)
                          + " place #" + policy_i64_to_string(place_id as i64)
                          + " type " + llvm_mir_type_text(&self.m, dst_type));
                return;
            }
            if (self.lower_string_append_assign_into_place(instr_id, place_id, value_id, addr, dst_type)) {
                return;
            }
            if (self.lower_dci_bitfield_store(place_id, addr, value_id, dst_type)) { return; }
            if (self.place_is_self_pointer_abi_slot(place_id)) {
                let ptr_val = self.lower_self_receiver_address(value_id, dst_type);
                if (ptr_val == null) {
                    self.report_error("cannot lower self pointer assignment value for instr #"
                              + policy_i64_to_string(instr_id as i64));
                    return;
                }
                vyx_rt_build_store(self.mod, ptr_val, addr);
                return;
            }
            if (self.type_is_class_pointer_abi(dst_type)
                && self.place_is_direct_class_object_pointer(place_id)) {
                if (!self.copy_value_storage_to_addr(addr,
                                                     value_id,
                                                     dst_type,
                                                     "assignment instr #"
                                                     + policy_i64_to_string(instr_id as i64))) {
                    self.report_error("cannot lower class storage assignment instr #"
                              + policy_i64_to_string(instr_id as i64));
                }
                self.track_shared_unwind_owner(place_id, addr);
                return;
            }
            var val = self.lower_value_as(value_id, dst_type);
            if (val == null) {
                self.report_error("cannot lower assignment value for instr #"
                          + policy_i64_to_string(instr_id as i64)
                          + " value #" + policy_i64_to_string(value_id as i64)
                          + " type " + llvm_mir_type_text(&self.m, self.value_effective_type(value_id)));
                self.report_error("cannot lower assignment instr #" + policy_i64_to_string(instr_id as i64));
                return;
            }
            if (self.assignment_should_retain_ref_handle(place_id, value_id, dst_type)) {
                val = self.retain_ref_handle_value(val, dst_type);
                if (val == null) {
                    self.report_error("cannot retain Ref assignment value for instr #"
                              + policy_i64_to_string(instr_id as i64));
                    return;
                }
            }
            if (self.place_is_volatile_local(place_id)) {
                vyx_rt_build_store_volatile(self.mod, val, addr);
            } else if (self.m.place_kind(place_id) == mir_place_deref()
                && self.ptr_alias_domain != null) {
                vyx_rt_set_alias_scopes_on_store(self.mod, val, addr, self.ptr_alias_domain, 1);
            } else {
                let stored = vyx_rt_build_store_instruction(self.mod, val, addr);
                if (stored != null && self.m.place_kind(place_id) == mir_place_local()) {
                    self.emit_debug_local_at_assignment(self.m.place_local(place_id), stored);
                }
            }
            self.track_shared_unwind_owner(place_id, addr);
            return;
        }
        if (kind == mir_instr_static_assert()) {
            self.lower_static_assert_instr(instr_id);
            return;
        }
        if (kind == mir_instr_drop()) {
            self.lower_drop_instr(instr_id);
            return;
        }
        if (kind == mir_instr_foreach_bind()) {
            self.lower_foreach_bind_instr(instr_id);
            return;
        }
        // Storage lifetime ends are optimizer metadata. They must not become a
        // Drop here: ownership destruction remains represented by mir_instr_drop.
        if (kind == mir_instr_storage_dead()) {
            if (self.local_lifetime_marker_selected(instr_id)) {
                let dead_place = self.m.instr_place(instr_id);
                let dead_addr = self.lower_place_addr(dead_place);
                if (!self.emit_local_lifetime_marker(instr_id, dead_addr, false)) { return; }
            }
            return;
        }
        if (kind == mir_instr_storage_live()) {
            let place_id2 = self.m.instr_place(instr_id);
            if (place_id2 == mir_id_invalid()) { return; }
            let addr2 = self.lower_place_addr(place_id2);
            let live_type = self.place_effective_type(place_id2);
            if (!self.emit_local_lifetime_marker(instr_id, addr2, true)) { return; }
            // `var x: SomeClass;` without an initializer: a class-pointer-ABI
            // local would otherwise hold a null handle and the first direct
            // field write (e.g. Dict::keys building a Vec field by field)
            // would dereference null. Materialize a zeroed object instead.
            // Initialized declarations keep the cheap null default — the
            // following assign overwrites the handle.
            if (self.type_is_class_pointer_abi(live_type)
                && self.m.instr_source_expr(instr_id) == mir_id_invalid()) {
                let obj2 = self.build_zeroed_class_object(live_type);
                if (addr2 == null || obj2 == null) {
                    self.report_error("cannot zero-initialize class storage for instr #" + policy_i64_to_string(instr_id as i64));
                    return;
                }
                let stored_obj = vyx_rt_build_store(self.mod, obj2, addr2);
                if (stored_obj != null && self.m.place_kind(place_id2) == mir_place_local()) {
                    self.emit_debug_local_at_assignment(self.m.place_local(place_id2), stored_obj);
                }
                return;
            }
            let init2 = self.default_value_for_type(live_type);
            if (addr2 == null || init2 == null) {
                self.report_error("cannot initialize storage for instr #" + policy_i64_to_string(instr_id as i64));
                return;
            }
            let stored_init = vyx_rt_build_store(self.mod, init2, addr2);
            if (stored_init != null && self.m.place_kind(place_id2) == mir_place_local()) {
                self.emit_debug_local_at_assignment(self.m.place_local(place_id2), stored_init);
            }
            return;
        }
        if (kind == mir_instr_match_arm()) { return; }
        self.report_error("cannot lower instr #" + policy_i64_to_string(instr_id as i64)
                  + " kind=" + policy_i64_to_string(kind as i64));
    }

    public fn is_default_match_pattern(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return true; }
        if (self.m.value_kind(value_id) == mir_value_null()
            && self.m.value_name(value_id) == "__match_default") {
            return true;
        }
        return false;
    }

    public fn option_pattern_variant_id(self, pattern_id: i32) -> i32 {
        var variant_id = self.m.value_target_id(pattern_id);
        if (self.m.value_target_kind(pattern_id) != mir_target_hir_variant()) {
            let callee_id = self.m.value_lhs(pattern_id);
            if (callee_id != mir_id_invalid()
                && self.m.value_target_kind(callee_id) == mir_target_hir_variant()) {
                variant_id = self.m.value_target_id(callee_id);
            }
        }
        return variant_id;
    }

    public fn option_pattern_payload_arg(self, pattern_id: i32) -> i32 {
        if (pattern_id == mir_id_invalid()) { return mir_id_invalid(); }
        return self.call_arg_payload(self.m.value_first_arg(pattern_id));
    }

    public fn option_pattern_tag_value(self, pattern_id: i32, option_type: i32) -> rawptr {
        if (!self.type_is_option_abi(option_type)) {
            self.report_error("Option match pattern requires Option subject type");
            return null;
        }
        let variant_id = self.option_pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve Option match pattern variant");
            return null;
        }
        return self.option_tag_for_variant(variant_id, mir_unit_variant_name(&self.m, variant_id));
    }

    public fn match_pattern_arg_is_bind_local(self, arg_id: i32) -> bool {
        let payload_id = self.call_arg_payload(arg_id);
        if (payload_id == mir_id_invalid()) { return false; }
        if (self.m.value_name(payload_id) == "_") { return false; }
        if (self.m.value_kind(payload_id) != mir_value_read_place()) { return false; }
        let place_id = self.m.value_place(payload_id);
        if (place_id == mir_id_invalid()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local_id = self.m.place_local(place_id);
        if (local_id == mir_id_invalid()) { return false; }
        // Builder temporaries are also read_place values, but only a source
        // pattern identifier has an originating HIR local to bind.
        return self.m.local_hir_id(local_id) != hir_id_invalid();
    }

    public fn match_pattern_is_subject_bind_local(self, subject_type: i32, pattern_id: i32) -> bool {
        if (!self.match_pattern_arg_is_bind_local(pattern_id)) { return false; }
        return self.type_ids_compatible(self.m.value_type(pattern_id), subject_type);
    }

    public fn emit_match_subject_bind(self, subject: rawptr, subject_type: i32, pattern_id: i32) -> bool {
        if (!self.match_pattern_is_subject_bind_local(subject_type, pattern_id)) { return true; }
        let place_id = self.m.value_place(pattern_id);
        let place_type = self.m.place_type(place_id);
        let cast_subject = self.cast_value(subject, subject_type, place_type);
        let dst = self.lower_place_addr(place_id);
        if (subject == null || cast_subject == null || dst == null) {
            self.report_error("cannot bind match subject");
            return false;
        }
        vyx_rt_build_store(self.mod, cast_subject, dst);
        return true;
    }

    public fn option_match_case_needs_payload_bind(self, subject_type: i32, pattern_id: i32) -> bool {
        if (!self.type_is_option_abi(subject_type)) { return false; }
        let variant_id = self.option_pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) { return false; }
        if (mir_unit_variant_name(&self.m, variant_id) != "Some") { return false; }
        return self.match_pattern_arg_is_bind_local(self.option_pattern_payload_arg(pattern_id));
    }

    public fn lower_option_payload_pattern_condition(self,
                                                     subject_payload: rawptr,
                                                     payload_type: i32,
                                                     pattern_arg_id: i32) -> rawptr {
        if (pattern_arg_id == mir_id_invalid()) { return null; }
        if (self.m.value_name(pattern_arg_id) == "_") {
            return vyx_rt_const_int(self.mod, self.ty_i1, 1, 0);
        }
        var pattern_value = self.lower_value_as(pattern_arg_id, payload_type);
        if (subject_payload == null || pattern_value == null) {
            self.report_error("cannot lower Option payload match pattern");
            return null;
        }
        let payload_kind = llvm_mir_type_kind(&self.m, payload_type);
        if (self.type_is_str_abi(payload_type)) {
            return self.lower_string_equals_raw_condition(subject_payload, pattern_value, false);
        }
        if (llvm_mir_int_bits_for_kind(payload_kind) > 0 || llvm_mir_kind_pointer_like(payload_kind)) {
            var lhs = self.pointer_compare_scalar(subject_payload,
                                                          payload_type,
                                                          "mir.option.ptr.lhs");
            pattern_value = self.pointer_compare_scalar(pattern_value,
                                                        payload_type,
                                                        "mir.option.ptr.rhs");
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     lhs,
                                     pattern_value,
                                     llvm_mir_empty_name(),
                                     0);
        }
        self.report_error("cannot lower Option payload pattern for " + llvm_mir_type_text(&self.m, payload_type));
        return null;
    }

    public fn emit_option_pattern_payload_bind(self,
                                               subject: rawptr,
                                               subject_type: i32,
                                               pattern_id: i32) -> bool {
        if (!self.option_match_case_needs_payload_bind(subject_type, pattern_id)) { return true; }
        let arg_id = self.option_pattern_payload_arg(pattern_id);
        let place_id = self.m.value_place(arg_id);
        let payload_type = self.option_payload_type(subject_type);
        let payload = self.option_payload_value(subject, subject_type);
        let place_type = self.m.place_type(place_id);
        let cast_payload = self.cast_value(payload, payload_type, place_type);
        let dst = self.lower_place_addr(place_id);
        if (payload == null || cast_payload == null || dst == null) {
            self.report_error("cannot bind Option match payload");
            return false;
        }
        vyx_rt_build_store(self.mod, cast_payload, dst);
        return true;
    }

    public fn result_pattern_payload_arg(self, pattern_id: i32) -> i32 {
        return self.call_arg_payload(self.m.value_first_arg(pattern_id));
    }

    public fn result_pattern_tag_value(self, pattern_id: i32, result_type: i32) -> rawptr {
        if (!self.type_is_result_abi(result_type)) {
            self.report_error("Result match pattern requires Result subject type");
            return null;
        }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve Result match pattern variant");
            return null;
        }
        return self.result_tag_for_variant_name(mir_unit_variant_name(&self.m, variant_id));
    }

    public fn result_match_case_needs_payload_bind(self, subject_type: i32, pattern_id: i32) -> bool {
        if (!self.type_is_result_abi(subject_type)) { return false; }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) { return false; }
        var arg_node_id = self.m.value_first_arg(pattern_id);
        while (arg_node_id != mir_id_invalid()) {
            if (self.match_pattern_arg_is_bind_local(arg_node_id)) { return true; }
            arg_node_id = self.m.value_next_arg(arg_node_id);
        }
        return false;
    }

    public fn result_payload_value_for_variant(self,
                                               subject: rawptr,
                                               subject_type: i32,
                                               variant_id: i32) -> rawptr {
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        if (variant_name == "Ok") { return self.result_ok_value(subject, subject_type); }
        if (variant_name == "Err") { return self.result_err_value(subject, subject_type); }
        self.report_error("unknown Result variant " + variant_name);
        return null;
    }

    public fn lower_result_payload_pattern_condition(self,
                                                     subject_payload: rawptr,
                                                     payload_type: i32,
                                                     pattern_arg_id: i32) -> rawptr {
        if (pattern_arg_id == mir_id_invalid()) { return null; }
        if (self.m.value_name(pattern_arg_id) == "_") {
            return vyx_rt_const_int(self.mod, self.ty_i1, 1, 0);
        }
        var pattern_value = self.lower_value_as(pattern_arg_id, payload_type);
        if (subject_payload == null || pattern_value == null) {
            self.report_error("cannot lower Result payload match pattern");
            return null;
        }
        let payload_kind = llvm_mir_type_kind(&self.m, payload_type);
        if (self.type_is_str_abi(payload_type)) {
            return self.lower_string_equals_raw_condition(subject_payload, pattern_value, false);
        }
        if (llvm_mir_int_bits_for_kind(payload_kind) > 0 || llvm_mir_kind_pointer_like(payload_kind)) {
            var lhs = self.pointer_compare_scalar(subject_payload,
                                                          payload_type,
                                                          "mir.result.ptr.lhs");
            pattern_value = self.pointer_compare_scalar(pattern_value,
                                                        payload_type,
                                                        "mir.result.ptr.rhs");
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     lhs,
                                     pattern_value,
                                     llvm_mir_empty_name(),
                                     0);
        }
        self.report_error("cannot lower Result payload pattern for " + llvm_mir_type_text(&self.m, payload_type));
        return null;
    }

    public fn emit_result_pattern_payload_bind(self,
                                               subject: rawptr,
                                               subject_type: i32,
                                               pattern_id: i32) -> bool {
        if (!self.result_match_case_needs_payload_bind(subject_type, pattern_id)) { return true; }
        let variant_id = self.pattern_variant_id(pattern_id);
        var variant_name: string = "";
        if (variant_id != mir_id_invalid()) {
            variant_name = mir_unit_variant_name(&self.m, variant_id);
        } else {
            // Generic-instance Result subjects can lack a variant target;
            // recover from the pattern's own name (`case Ok(..)`/`case Err(..)`).
            variant_name = self.m.value_name(pattern_id);
        }
        var payload_type = mir_id_invalid();
        var payload: rawptr = null;
        if (variant_name == "Ok") {
            payload_type = self.result_ok_type(subject_type);
            payload = self.result_ok_value(subject, subject_type);
        } elif (variant_name == "Err") {
            payload_type = self.result_err_type(subject_type);
            payload = self.result_err_value(subject, subject_type);
        } else {
            self.report_error("cannot resolve Result match pattern variant");
            return false;
        }
        var arg_node_id = self.m.value_first_arg(pattern_id);
        var arg_index: i32 = 0;
        while (arg_node_id != mir_id_invalid()) {
            let arg_id = self.call_arg_payload(arg_node_id);
            if (arg_index > 0) {
                self.report_error("Result pattern has more than one payload binding");
                return false;
            }
            if (self.match_pattern_arg_is_bind_local(arg_id)) {
                let place_id = self.m.value_place(arg_id);
                let place_type = self.m.place_type(place_id);
                let cast_payload = self.cast_value(payload, payload_type, place_type);
                let dst = self.lower_place_addr(place_id);
                if (payload_type == mir_id_invalid() || payload == null || cast_payload == null || dst == null) {
                    self.report_error("cannot bind Result match payload");
                    return false;
                }
                vyx_rt_build_store(self.mod, cast_payload, dst);
            }
            arg_index = arg_index + 1;
            arg_node_id = self.m.value_next_arg(arg_node_id);
        }
        return true;
    }

    public fn plain_enum_pattern_tag_value(self, pattern_id: i32, enum_type: i32) -> rawptr {
        if (!self.type_is_plain_enum_abi(enum_type)) {
            self.report_error("enum match pattern requires enum subject type (is_plain_enum_abi failed for type "
                + llvm_mir_type_text(&self.m, enum_type) + ")");
            return null;
        }
        let pattern_kind = self.m.value_kind(pattern_id);
        if (pattern_kind == mir_value_const_int()
            || pattern_kind == mir_value_const_char()
            || pattern_kind == mir_value_const_bool()) {
            return vyx_rt_const_int(self.mod, self.ty_i32, self.m.value_int(pattern_id), 1);
        }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) {
            let pat_name = self.m.value_name(pattern_id);
            let enum_name = llvm_mir_type_text(&self.m, enum_type);
            var msg = "cannot resolve enum match pattern";
            if (pat_name.len > 0) {
                msg = msg + " `" + pat_name + "`";
            }
            msg = msg + " for " + enum_name;
            if (vyx_bootstrap_profile_level() > 0) {
                let ctx = " [pattern_id=" + policy_i64_to_string(pattern_id as i64)
                    + " target_kind=" + policy_i64_to_string(self.m.value_target_kind(pattern_id) as i64)
                    + " target_id=" + policy_i64_to_string(self.m.value_target_id(pattern_id) as i64);
                if (self.m.value_lhs(pattern_id) != mir_id_invalid()) {
                    let lhs_id = self.m.value_lhs(pattern_id);
                    msg = msg + ctx
                        + " lhs_target_kind=" + policy_i64_to_string(self.m.value_target_kind(lhs_id) as i64)
                        + " lhs_target_id=" + policy_i64_to_string(self.m.value_target_id(lhs_id) as i64)
                        + "]";
                } else {
                    msg = msg + ctx + "]";
                }
            }
            self.report_error(msg);
            return null;
        }
        return self.lower_variant_tag_value(variant_id);
    }

    public fn plain_enum_match_case_needs_payload_bind(self, subject_type: i32, pattern_id: i32) -> bool {
        if (!self.type_is_plain_enum_abi(subject_type)) { return false; }
        let pattern_kind = self.m.value_kind(pattern_id);
        if (pattern_kind == mir_value_const_int()
            || pattern_kind == mir_value_const_char()
            || pattern_kind == mir_value_const_bool()) {
            return false;
        }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) { return false; }
        var arg_node_id = self.m.value_first_arg(pattern_id);
        while (arg_node_id != mir_id_invalid()) {
            if (self.match_pattern_arg_is_bind_local(arg_node_id)) { return true; }
            arg_node_id = self.m.value_next_arg(arg_node_id);
        }
        return false;
    }

    public fn lower_plain_enum_payload_pattern_condition(self,
                                                         subject_payload: rawptr,
                                                         payload_type: i32,
                                                         pattern_arg_id: i32) -> rawptr {
        if (pattern_arg_id == mir_id_invalid()) { return null; }
        if (self.m.value_name(pattern_arg_id) == "_") {
            return vyx_rt_const_int(self.mod, self.ty_i1, 1, 0);
        }
        var pattern_value = self.lower_value_as(pattern_arg_id, payload_type);
        if (subject_payload == null || pattern_value == null) {
            self.report_error("cannot lower enum payload match pattern");
            return null;
        }
        let payload_kind = llvm_mir_type_kind(&self.m, payload_type);
        if (self.type_is_str_abi(payload_type)) {
            return self.lower_string_equals_raw_condition(subject_payload, pattern_value, false);
        }
        if (llvm_mir_int_bits_for_kind(payload_kind) > 0 || llvm_mir_kind_pointer_like(payload_kind)) {
            var lhs = self.pointer_compare_scalar(subject_payload,
                                                          payload_type,
                                                          "mir.enum.ptr.lhs");
            pattern_value = self.pointer_compare_scalar(pattern_value,
                                                        payload_type,
                                                        "mir.enum.ptr.rhs");
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     lhs,
                                     pattern_value,
                                     llvm_mir_empty_name(),
                                     0);
        }
        self.report_error("cannot lower enum payload pattern for " + llvm_mir_type_text(&self.m, payload_type));
        return null;
    }

    public fn emit_plain_enum_pattern_payload_bind(self,
                                                   subject: rawptr,
                                                   subject_type: i32,
                                                   pattern_id: i32) -> bool {
        if (!self.plain_enum_match_case_needs_payload_bind(subject_type, pattern_id)) { return true; }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) { return false; }
        var arg_index: i32 = 0;
        var arg_node_id = self.m.value_first_arg(pattern_id);
        while (arg_node_id != mir_id_invalid()) {
            let arg_id = self.call_arg_payload(arg_node_id);
            if (self.match_pattern_arg_is_bind_local(arg_id)) {
                let place_id = self.m.value_place(arg_id);
                let payload_type = self.enum_variant_payload_type_at(subject_type, variant_id, arg_index);
                let payload = self.enum_payload_value(subject, subject_type, variant_id, arg_index);
                let place_type = self.m.place_type(place_id);
                let cast_payload = self.cast_value(payload, payload_type, place_type);
                let dst = self.lower_place_addr(place_id);
                if (payload == null || cast_payload == null || dst == null) {
                    self.report_error("cannot bind enum match payload");
                    return false;
                }
                vyx_rt_build_store(self.mod, cast_payload, dst);
            }
            arg_index = arg_index + 1;
            arg_node_id = self.m.value_next_arg(arg_node_id);
        }
        return true;
    }

    public fn match_case_needs_payload_bind(self, subject_type: i32, pattern_id: i32) -> bool {
        if (self.option_match_case_needs_payload_bind(subject_type, pattern_id)) { return true; }
        if (self.result_match_case_needs_payload_bind(subject_type, pattern_id)) { return true; }
        return self.plain_enum_match_case_needs_payload_bind(subject_type, pattern_id);
    }

    public fn emit_match_pattern_payload_bind(self,
                                              subject: rawptr,
                                              subject_type: i32,
                                              pattern_id: i32) -> bool {
        if (self.type_is_option_abi(subject_type)) {
            return self.emit_option_pattern_payload_bind(subject, subject_type, pattern_id);
        }
        if (self.type_is_result_abi(subject_type)) {
            return self.emit_result_pattern_payload_bind(subject, subject_type, pattern_id);
        }
        if (self.type_is_plain_enum_abi(subject_type)) {
            return self.emit_plain_enum_pattern_payload_bind(subject, subject_type, pattern_id);
        }
        return true;
    }

    public fn pattern_variant_owner_matches_type(self, pattern_id: i32, candidate_type: i32) -> bool {
        if (pattern_id == mir_id_invalid() || candidate_type == mir_id_invalid()) { return false; }
        let variant_id = self.pattern_variant_id(pattern_id);
        if (variant_id == mir_id_invalid()) { return false; }
        let owner_type = mir_unit_variant_owner_type(&self.m, variant_id);
        if (owner_type == mir_id_invalid()) { return false; }
        if (self.type_ids_compatible(owner_type, self.canonical_record_type_id(candidate_type))) { return true; }
        // Owner may be a duplicate registration of the same enum; compare
        // canonical identities as well.
        return self.type_ids_compatible(self.canonical_record_type_id(owner_type),
                                        self.canonical_record_type_id(candidate_type));
    }

    public fn match_pattern_selects_type(self, pattern_id: i32, candidate_type: i32) -> bool {
        if (pattern_id == mir_id_invalid() || candidate_type == mir_id_invalid()) { return false; }
        if (self.type_ids_compatible(self.m.value_type(pattern_id), candidate_type)) { return true; }
        return self.pattern_variant_owner_matches_type(pattern_id, candidate_type);
    }

    public fn match_effective_subject_type(self, block_id: i32) -> i32 {
        let subject_id = self.m.block_term_value(block_id);
        let source_type = self.m.value_type(subject_id);
        let payload_type = self.heap_indirect_payload_type(source_type);
        if (payload_type == mir_id_invalid()) { return source_type; }
        var case_id = self.m.block_term_first_case(block_id);
        while (case_id != mir_id_invalid()) {
            let pattern_id = self.m.case_pattern_value(case_id);
            if (!self.is_default_match_pattern(pattern_id)
                && self.match_pattern_selects_type(pattern_id, payload_type)) {
                return payload_type;
            }
            case_id = self.m.case_next(case_id);
        }
        return source_type;
    }

    public fn lower_match_case_condition(self, subject_id: i32, subject_type: i32, subject: rawptr, pattern_id: i32) -> rawptr {
        let pattern_type = self.m.value_type(pattern_id);
        if (self.match_pattern_is_subject_bind_local(subject_type, pattern_id)) {
            return vyx_rt_const_int(self.mod, self.ty_i1, 1, 0);
        }
        if (self.type_is_str_abi(subject_type) || self.type_is_str_abi(pattern_type)) {
            let pattern_value = self.lower_value_as(pattern_id, subject_type);
            if (pattern_value == null) { return null; }
            return self.lower_string_equals_raw_condition(subject, pattern_value, false);
        }
        if (self.type_is_option_abi(subject_type)) {
            let subject_tag = self.option_tag_value(subject, subject_type);
            let pattern_tag = self.option_pattern_tag_value(pattern_id, subject_type);
            if (subject_tag == null || pattern_tag == null) { return null; }
            var cond = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         subject_tag,
                                         pattern_tag,
                                         llvm_mir_empty_name(),
                                         0);
            let variant_id = self.option_pattern_variant_id(pattern_id);
            if (variant_id != mir_id_invalid()
                && mir_unit_variant_name(&self.m, variant_id) == "Some") {
                let payload_arg = self.option_pattern_payload_arg(pattern_id);
                if (payload_arg != mir_id_invalid()
                    && !self.match_pattern_arg_is_bind_local(payload_arg)
                    && self.m.value_name(payload_arg) != "_") {
                    let payload_type = self.option_payload_type(subject_type);
                    let payload = self.option_payload_value(subject, subject_type);
                    let payload_cond = self.lower_option_payload_pattern_condition(payload, payload_type, payload_arg);
                    if (payload_cond == null) { return null; }
                    cond = vyx_rt_build_and(self.mod, cond, payload_cond, llvm_mir_empty_name(), 0);
                }
            }
            return cond;
        }
        if (self.type_is_result_abi(subject_type)) {
            let subject_tag = self.result_tag_value(subject, subject_type);
            let pattern_tag = self.result_pattern_tag_value(pattern_id, subject_type);
            if (subject_tag == null || pattern_tag == null) { return null; }
            var cond_result = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_eq(),
                                                subject_tag,
                                                pattern_tag,
                                                llvm_mir_empty_name(),
                                                0);
            let variant_id_result = self.pattern_variant_id(pattern_id);
            if (variant_id_result != mir_id_invalid()) {
                var arg_index_result: i32 = 0;
                var payload_arg_node_result = self.m.value_first_arg(pattern_id);
                while (payload_arg_node_result != mir_id_invalid()) {
                    let payload_arg_result = self.call_arg_payload(payload_arg_node_result);
                    if (arg_index_result > 0) {
                        self.report_error("Result pattern has more than one payload condition");
                        return null;
                    }
                    if (!self.match_pattern_arg_is_bind_local(payload_arg_result)
                        && self.m.value_name(payload_arg_result) != "_") {
                        let payload_type_result = self.result_payload_type_for_variant(subject_type, variant_id_result);
                        let payload_result = self.result_payload_value_for_variant(subject, subject_type, variant_id_result);
                        let payload_cond_result = self.lower_result_payload_pattern_condition(payload_result,
                                                                                              payload_type_result,
                                                                                              payload_arg_result);
                        if (payload_cond_result == null) { return null; }
                        cond_result = vyx_rt_build_and(self.mod, cond_result, payload_cond_result, llvm_mir_empty_name(), 0);
                    }
                    arg_index_result = arg_index_result + 1;
                    payload_arg_node_result = self.m.value_next_arg(payload_arg_node_result);
                }
            }
            return cond_result;
        }
        if (self.type_is_plain_enum_abi(subject_type)) {
            let subject_tag = self.enum_tag_value(subject, subject_type);
            let pattern_tag = self.plain_enum_pattern_tag_value(pattern_id, subject_type);
            if (subject_tag == null || pattern_tag == null) { return null; }
            var cond2 = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_eq(),
                                          subject_tag,
                                          pattern_tag,
                                          llvm_mir_empty_name(),
                                          0);
            let first_payload_arg = self.m.value_first_arg(pattern_id);
            if (first_payload_arg == mir_id_invalid()) { return cond2; }
            let variant_id2 = self.pattern_variant_id(pattern_id);
            if (variant_id2 == mir_id_invalid()) {
                self.report_error("cannot lower enum payload pattern without a variant target");
                return null;
            }
            var arg_index: i32 = 0;
            var payload_arg_node = first_payload_arg;
            while (payload_arg_node != mir_id_invalid()) {
                let payload_arg = self.call_arg_payload(payload_arg_node);
                if (!self.match_pattern_arg_is_bind_local(payload_arg)
                    && self.m.value_name(payload_arg) != "_") {
                    let payload_type = self.enum_variant_payload_type_at(subject_type, variant_id2, arg_index);
                    let payload = self.enum_payload_value(subject, subject_type, variant_id2, arg_index);
                    let payload_cond = self.lower_plain_enum_payload_pattern_condition(payload, payload_type, payload_arg);
                    if (payload_cond == null) { return null; }
                    cond2 = vyx_rt_build_and(self.mod, cond2, payload_cond, llvm_mir_empty_name(), 0);
                }
                arg_index = arg_index + 1;
                payload_arg_node = self.m.value_next_arg(payload_arg_node);
            }
            return cond2;
        }
        let subject_kind = llvm_mir_type_kind(&self.m, subject_type);
        if (mir_unit_variant_count_for_type(&self.m, subject_type) <= 0
            && llvm_mir_int_bits_for_kind(subject_kind) <= 0
            && !llvm_mir_kind_pointer_like(subject_kind)) {
            self.report_error("cannot lower match equality for " + llvm_mir_type_text(&self.m, subject_type));
            return null;
        }
        var pat_val = self.lower_value_as(pattern_id, subject_type);
        if (pat_val == null) { return null; }
        let subject_scalar = self.pointer_compare_scalar(subject, subject_type, "mir.match.ptr.lhs");
        pat_val = self.pointer_compare_scalar(pat_val, subject_type, "mir.match.ptr.rhs");
        return vyx_rt_build_icmp(self.mod,
                                 llvm_mir_icmp_eq(),
                                 subject_scalar,
                                 pat_val,
                                 llvm_mir_empty_name(),
                                 0);
    }

    public fn lower_match_terminator(self, block_id: i32) {
        let subject_id = self.m.block_term_value(block_id);
        let subject_type = self.match_effective_subject_type(block_id);
        let subject = self.lower_value_as(subject_id, subject_type);
        if (subject == null) {
            self.report_error("cannot lower match subject in block #" + policy_i64_to_string(block_id as i64));
            return;
        }
        var default_target: rawptr = null;
        var case_id = self.m.block_term_first_case(block_id);
        while (case_id != mir_id_invalid()) {
            let pat_id = self.m.case_pattern_value(case_id);
            if (self.is_default_match_pattern(pat_id)) {
                default_target = llvm_mir_map_get(self.block_values, self.m.case_target_block(case_id));
            }
            case_id = self.m.case_next(case_id);
        }
        if (default_target == null) {
            default_target = llvm_mir_map_get(self.block_values, self.m.block_term_false(block_id));
        }
        case_id = self.m.block_term_first_case(block_id);
        while (case_id != mir_id_invalid()) {
            let pat_id2 = self.m.case_pattern_value(case_id);
            if (!self.is_default_match_pattern(pat_id2)) {
                let target_bb = llvm_mir_map_get(self.block_values, self.m.case_target_block(case_id));
                var cond = self.lower_match_case_condition(subject_id, subject_type, subject, pat_id2);
                if (target_bb == null || cond == null) {
                    self.report_error("cannot lower match case #" + policy_i64_to_string(case_id as i64));
                    return;
                }
                var hit_bb = target_bb;
                var bind_bb: rawptr = null;
                let needs_subject_bind = self.match_pattern_is_subject_bind_local(subject_type, pat_id2);
                let needs_payload_bind = self.match_case_needs_payload_bind(subject_type, pat_id2);
                let needs_bind = needs_subject_bind || needs_payload_bind;
                if (needs_bind) {
                    let bind_name = "mir.match.bind." + policy_i64_to_string(case_id as i64);
                    bind_bb = vyx_rt_append_block(self.mod,
                                                  self.current_function_value,
                                                  bind_name.c_str(),
                                                  bind_name.len as u64);
                    if (bind_bb == null) {
                        self.report_error("cannot create match bind block");
                        return;
                    }
                    hit_bb = bind_bb;
                }
                let guard_id = self.m.case_guard_value(case_id);
                if (guard_id != mir_id_invalid() && !needs_bind) {
                    let guard = self.truthy_value(self.lower_value(guard_id), self.m.value_type(guard_id));
                    if (guard == null) {
                        self.report_error("cannot lower match guard #" + policy_i64_to_string(case_id as i64));
                        return;
                    }
                    cond = vyx_rt_build_and(self.mod, cond, guard, llvm_mir_empty_name(), 0);
                }
                var next_case = self.m.case_next(case_id);
                while (next_case != mir_id_invalid()
                       && self.is_default_match_pattern(self.m.case_pattern_value(next_case))) {
                    next_case = self.m.case_next(next_case);
                }
                var miss_bb = default_target;
                var miss_is_unreachable = false;
                if (next_case != mir_id_invalid()) {
                    let name = "mir.match.next." + policy_i64_to_string(case_id as i64);
                    miss_bb = vyx_rt_append_block(self.mod,
                                                  self.current_function_value,
                                                  name.c_str(),
                                                  name.len as u64);
                } else if (miss_bb == null) {
                    let miss_name = "mir.match.unreachable." + policy_i64_to_string(case_id as i64);
                    miss_bb = vyx_rt_append_block(self.mod,
                                                  self.current_function_value,
                                                  miss_name.c_str(),
                                                  miss_name.len as u64);
                    miss_is_unreachable = true;
                }
                if (miss_bb == null) {
                    self.report_error("cannot resolve match miss target");
                    return;
                }
                vyx_rt_build_cond_br(self.mod, cond, hit_bb, miss_bb);
                if (bind_bb != null) {
                    vyx_rt_position_at_end(self.mod, bind_bb);
                    if (!self.emit_match_subject_bind(subject, subject_type, pat_id2)) {
                        return;
                    }
                    if (!self.emit_match_pattern_payload_bind(subject, subject_type, pat_id2)) {
                        return;
                    }
                    if (guard_id != mir_id_invalid()) {
                        let guard_after_bind = self.truthy_value(self.lower_value(guard_id), self.m.value_type(guard_id));
                        if (guard_after_bind == null) {
                            self.report_error("cannot lower match guard #" + policy_i64_to_string(case_id as i64));
                            return;
                        }
                        vyx_rt_build_cond_br(self.mod, guard_after_bind, target_bb, miss_bb);
                    } else {
                        vyx_rt_build_br(self.mod, target_bb);
                    }
                }
                if (next_case == mir_id_invalid()) {
                    if (miss_is_unreachable) {
                        vyx_rt_position_at_end(self.mod, miss_bb);
                        vyx_rt_build_unreachable(self.mod);
                    }
                    return;
                }
                vyx_rt_position_at_end(self.mod, miss_bb);
            }
            case_id = self.m.case_next(case_id);
        }
        if (default_target != null) {
            vyx_rt_build_br(self.mod, default_target);
        } else {
            vyx_rt_build_unreachable(self.mod);
        }
    }

    public fn lower_foreach_next_terminator(self, block_id: i32) {
        let iter_value = self.m.block_term_value(block_id);
        let body_bb = llvm_mir_map_get(self.block_values, self.m.block_term_target(block_id));
        let exit_bb = llvm_mir_map_get(self.block_values, self.m.block_term_false(block_id));
        if (!self.value_is_reflection_iterable(iter_value)) {
            if (self.type_is_standard_iterator_abi(self.m.value_type(iter_value))) {
                self.lower_standard_iterator_has_next(iter_value, body_bb, exit_bb);
                return;
            }
            if (self.type_is_standard_indexed_iterable_abi(self.m.value_type(iter_value))) {
                self.lower_indexed_iterable_has_next(iter_value,
                                                     self.m.block_term_aux(block_id),
                                                     body_bb,
                                                     exit_bb);
                return;
            }
            if (self.lower_method_iterator_has_next(iter_value, body_bb, exit_bb)) { return; }
            self.report_error("cannot lower foreach_next for iterator type "
                      + llvm_mir_type_text(&self.m, self.m.value_type(iter_value))
                      + " in block #" + policy_i64_to_string(block_id as i64));
            return;
        }
        let item_count = self.reflection_iterable_count(iter_value);
        if (item_count < 0) { return; }
        let index_place = self.m.block_term_aux(block_id);
        let index_addr = self.lower_place_addr(index_place);
        let index_type = self.m.place_type(index_place);
        let index_ll_ty = self.lower_type(index_type);
        if (index_addr == null || index_ll_ty == null || body_bb == null || exit_bb == null) {
            self.report_error("cannot lower reflection foreach_next in block #"
                      + policy_i64_to_string(block_id as i64));
            return;
        }
        let index_value = vyx_rt_build_load(self.mod,
                                            index_ll_ty,
                                            index_addr,
                                            "mir.foreach.index".c_str(),
                                            17);
        if (index_value == null) {
            self.report_error("cannot load reflection foreach index in block #"
                      + policy_i64_to_string(block_id as i64));
            return;
        }
        let limit_value = vyx_rt_const_int(self.mod, index_ll_ty, item_count as i64, 0);
        let in_range = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_slt(),
                                         index_value,
                                         limit_value,
                                         llvm_mir_empty_name(),
                                         0);
        if (in_range == null) {
            self.report_error("cannot compare reflection foreach index in block #"
                      + policy_i64_to_string(block_id as i64));
            return;
        }
        vyx_rt_build_cond_br(self.mod, in_range, body_bb, exit_bb);
    }

    public fn emit_return_value(self, function_id: i32, ret_v: rawptr) {
        if (self.function_uses_hidden_sret(function_id)) {
            let sret = vyx_rt_get_param(self.mod, self.current_function_value, 0);
            if (sret == null || ret_v == null) {
                self.report_error("cannot store sret return for " + self.m.function_name(function_id));
                return;
            }
            vyx_rt_build_store(self.mod, ret_v, sret);
            vyx_rt_build_ret_void(self.mod);
            return;
        }
        var outgoing = ret_v;
        if (self.foreign_c_handle_uses_raw_pointer_abi(
                function_id, self.m.function_return_type(function_id))) {
            outgoing = self.pointer_handle_address(ret_v, "c.abi.ptr.out");
            if (outgoing == null) {
                self.report_error("cannot extract native pointer return for " + self.m.function_name(function_id));
                return;
            }
        }
        if (self.function_return_uses_c_sysv_coerce(function_id)) {
            outgoing = self.c_sysv_coerce_value(ret_v,
                                               self.m.function_return_type(function_id),
                                               "c.abi.out");
            if (outgoing == null) {
                self.report_error("cannot coerce C SysV return for " + self.m.function_name(function_id));
                return;
            }
        }
        vyx_rt_build_ret(self.mod, outgoing);
    }

    public fn lower_terminator(self, block_id: i32) {
        let kind = self.m.block_term_kind(block_id);
        if (kind == mir_term_return()) {
            let ret_value_id = self.m.block_term_value(block_id);
            let ret_function = self.m.block_function(block_id);
            let ret_type = self.m.function_return_type(ret_function);
            if (ret_value_id == mir_id_invalid()
                && self.function_uses_i32_main_abi(ret_function)) {
                vyx_rt_build_ret(self.mod, vyx_rt_const_int(self.mod, self.ty_i32, 0, 0));
                return;
            }
            if (self.function_name_matches_method(self.m.function_name(ret_function), "constructor")
                && self.source_param_uses_self_pointer_abi(ret_function, 0)
                && llvm_mir_type_kind(&self.m, ret_type) != ty_VOID()
                && ret_value_id == mir_id_invalid()) {
                let self_local = self.function_source_param_local(ret_function, 0);
                let self_slot = llvm_mir_map_get(self.local_slots, self_local);
                if (self_slot == null) {
                    self.report_error("cannot resolve constructor self slot for "
                              + self.m.function_name(ret_function));
                    return;
                }
                let self_ptr = vyx_rt_build_load(self.mod,
                                                 self.ty_ptr,
                                                 self_slot,
                                                 "mir.ctor.self".c_str(),
                                                 13);
                if (self_ptr == null) {
                    self.report_error("cannot load constructor self pointer for "
                              + self.m.function_name(ret_function));
                    return;
                }
                if (self.function_uses_hidden_sret(ret_function)) {
                    let loaded = vyx_rt_build_load(self.mod,
                                                   self.lower_type(ret_type),
                                                   self_ptr,
                                                   "mir.ctor.sret".c_str(),
                                                   13);
                    self.emit_return_value(ret_function, loaded);
                } else {
                    vyx_rt_build_ret(self.mod, self_ptr);
                }
                return;
            }
            if (ret_value_id == mir_id_invalid() || llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) {
                vyx_rt_build_ret_void(self.mod);
            } else {
                let ret_v = self.lower_value_as(ret_value_id, ret_type);
                if (ret_v == null) {
                    self.report_error_at_value(ret_value_id,
                                               "cannot lower return value in block #"
                                               + policy_i64_to_string(block_id as i64));
                    return;
                }
                self.emit_return_value(ret_function, ret_v);
            }
            return;
        }
        if (kind == mir_term_goto()) {
            let target = llvm_mir_map_get(self.block_values, self.m.block_term_target(block_id));
            if (target == null) {
                self.report_error("cannot lower goto target for block #" + policy_i64_to_string(block_id as i64));
                return;
            }
            vyx_rt_build_br(self.mod, target);
            return;
        }
        if (kind == mir_term_branch()) {
            let cond_id = self.m.block_term_value(block_id);
            var branch_mark: i64 = 0;
            var branch_lower_ms: i64 = 0;
            var branch_truthy_ms: i64 = 0;
            var branch_target_ms: i64 = 0;
            if (llvm_mir_timing_enabled()) { branch_mark = vyx_bootstrap_now_ms(); }
            let cond_raw = self.lower_value(cond_id);
            if (llvm_mir_timing_enabled()) {
                let now_lower = vyx_bootstrap_now_ms();
                branch_lower_ms = now_lower - branch_mark;
                branch_mark = now_lower;
            }
            let cond = self.truthy_value(cond_raw, self.m.value_type(cond_id));
            if (llvm_mir_timing_enabled()) {
                let now_truthy = vyx_bootstrap_now_ms();
                branch_truthy_ms = now_truthy - branch_mark;
                branch_mark = now_truthy;
            }
            let then_bb = llvm_mir_map_get(self.block_values, self.m.block_term_target(block_id));
            let else_bb = llvm_mir_map_get(self.block_values, self.m.block_term_false(block_id));
            if (llvm_mir_timing_enabled()) {
                let now_target = vyx_bootstrap_now_ms();
                branch_target_ms = now_target - branch_mark;
                branch_mark = now_target;
            }
            if (cond == null || then_bb == null || else_bb == null) {
                if (cond == null && self.error_count > 0) { return; }
                var branch_detail = "";
                if (vyx_bootstrap_profile_level() > 0) {
                    branch_detail = " [block #" + policy_i64_to_string(block_id as i64) + "]";
                }
                if (cond == null) {
                    self.report_error_at_value(cond_id, "cannot lower branch condition" + branch_detail);
                } else {
                    self.report_error("cannot lower branch target" + branch_detail);
                }
                return;
            }
            vyx_rt_build_cond_br(self.mod, cond, then_bb, else_bb);
            if (llvm_mir_timing_enabled()) {
                let branch_total = branch_lower_ms + branch_truthy_ms + branch_target_ms + (vyx_bootstrap_now_ms() - branch_mark);
                if (branch_total >= llvm_mir_slow_instr_threshold_ms()) {
                    print("[mir-timing] branch fn #" + policy_i64_to_string(self.current_function_id as i64)
                          + " " + self.m.function_name(self.current_function_id)
                          + " block=" + policy_i64_to_string(block_id as i64)
                          + " cond=" + policy_i64_to_string(cond_id as i64)
                          + " cond_kind=" + policy_i64_to_string(self.m.value_kind(cond_id) as i64)
                          + " cond_type=" + llvm_mir_type_text(&self.m, self.m.value_type(cond_id))
                          + " lower=" + branch_lower_ms.toString()
                          + " truthy=" + branch_truthy_ms.toString()
                          + " targets=" + branch_target_ms.toString()
                          + " total=" + branch_total.toString() + " ms");
                }
            }
            return;
        }
        if (kind == mir_term_unreachable()) {
            vyx_rt_build_unreachable(self.mod);
            return;
        }
        if (kind == mir_term_match()) {
            self.lower_match_terminator(block_id);
            return;
        }
        if (kind == mir_term_foreach_next()) {
            self.lower_foreach_next_terminator(block_id);
            return;
        }
        if (kind == mir_term_yield()) {
            self.lower_async_yield_terminator(block_id);
            return;
        }
        self.report_error("cannot lower terminator kind=" + policy_i64_to_string(kind as i64)
                  + " in block #" + policy_i64_to_string(block_id as i64));
    }

    public fn lower_async_yield_terminator(self, block_id: i32) {
        let function_id = self.current_function_id;
        let pc_local = self.async_pc_local_for_function(function_id);
        let slot = llvm_mir_map_get(self.local_slots, pc_local);
        let aux = self.m.block_term_aux(block_id);
        if (slot != null) {
            vyx_rt_build_store(self.mod,
                               vyx_rt_const_int(self.mod, self.ty_i32, aux as i64, 0),
                               slot);
        } else {
            self.report_error("async yield missing __async_pc slot in "
                      + self.m.function_name(function_id));
        }
        self.async_runtime_call0("vio_async_pending_set");
        let ret_type = self.m.function_return_type(function_id);
        if (llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
            return;
        }
        let dummy = self.default_value_for_type(ret_type);
        if (dummy == null) {
            self.report_error("cannot lower async yield dummy return in block #"
                      + policy_i64_to_string(block_id as i64));
            return;
        }
        self.emit_return_value(function_id, dummy);
    }

    public fn lower_block(self, block_id: i32) {
        self.current_block_id = block_id;
        self.current_instr_id = mir_id_invalid();
        self.current_value_id = mir_id_invalid();
        self.current_place_id = mir_id_invalid();
        let bb = llvm_mir_map_get(self.block_values, block_id);
        if (bb == null) {
            self.report_error("missing LLVM block for MIR block #" + policy_i64_to_string(block_id as i64));
            return;
        }
        var timing_block_start: i64 = 0;
        var timing_instr_threshold: i64 = 0;
        var timing_instr_count: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_block_start = vyx_bootstrap_now_ms();
            timing_instr_threshold = llvm_mir_slow_instr_threshold_ms();
        }
        vyx_rt_position_at_end(self.mod, bb);
        var instr = self.m.block_first_instr(block_id);
        while (instr != mir_id_invalid()) {
            self.current_instr_id = instr;
            self.current_value_id = self.m.instr_value(instr);
            self.current_place_id = self.m.instr_place(instr);
            var timing_instr_start: i64 = 0;
            if (llvm_mir_timing_enabled()) { timing_instr_start = vyx_bootstrap_now_ms(); }
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-mir-instr] before fn="
                      + policy_i64_to_string(self.current_function_id as i64)
                      + " block=" + policy_i64_to_string(block_id as i64)
                      + " instr=" + policy_i64_to_string(instr as i64)
                      + " kind=" + policy_i64_to_string(self.m.instr_kind(instr) as i64)
                      + " value=" + policy_i64_to_string(self.m.instr_value(instr) as i64)
                      + " place=" + policy_i64_to_string(self.m.instr_place(instr) as i64));
            }
            self.set_debug_location_for_instr(instr);
            self.lower_instr(instr);
            if (llvm_mir_timing_enabled()) {
                timing_instr_count = timing_instr_count + 1;
                let timing_instr_elapsed = vyx_bootstrap_now_ms() - timing_instr_start;
                if (timing_instr_elapsed >= timing_instr_threshold) {
                    let instr_value = self.m.instr_value(instr);
                    var instr_value_kind: i32 = mir_id_invalid();
                    var instr_type_text: string = "";
                    if (instr_value != mir_id_invalid()) {
                        instr_value_kind = self.m.value_kind(instr_value);
                        instr_type_text = llvm_mir_type_text(&self.m, self.m.value_type(instr_value));
                    }
                    print("[mir-timing] instr fn #" + policy_i64_to_string(self.current_function_id as i64)
                          + " " + self.m.function_name(self.current_function_id)
                          + " block=" + policy_i64_to_string(block_id as i64)
                          + " instr=" + policy_i64_to_string(instr as i64)
                          + " kind=" + policy_i64_to_string(self.m.instr_kind(instr) as i64)
                          + " value=" + policy_i64_to_string(instr_value as i64)
                          + " value_kind=" + policy_i64_to_string(instr_value_kind as i64)
                          + " type=" + instr_type_text
                          + " elapsed=" + timing_instr_elapsed.toString() + " ms");
                }
            }
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-mir-instr] after fn="
                      + policy_i64_to_string(self.current_function_id as i64)
                      + " block=" + policy_i64_to_string(block_id as i64)
                      + " instr=" + policy_i64_to_string(instr as i64)
                      + " errors=" + policy_i64_to_string(self.error_count as i64));
            }
            instr = self.m.instr_next(instr);
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-mir-term] before fn="
                  + policy_i64_to_string(self.current_function_id as i64)
                  + " block=" + policy_i64_to_string(block_id as i64)
                  + " term=" + policy_i64_to_string(self.m.block_term_kind(block_id) as i64)
                  + " value=" + policy_i64_to_string(self.m.block_term_value(block_id) as i64));
        }
        var timing_term_start: i64 = 0;
        if (llvm_mir_timing_enabled()) { timing_term_start = vyx_bootstrap_now_ms(); }
        self.current_instr_id = mir_id_invalid();
        self.current_value_id = self.m.block_term_value(block_id);
        self.current_place_id = mir_id_invalid();
        self.set_debug_location_for_terminator(block_id);
        self.lower_terminator(block_id);
        var timing_term_elapsed: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_term_elapsed = vyx_bootstrap_now_ms() - timing_term_start;
            if (timing_term_elapsed >= timing_instr_threshold) {
                print("[mir-timing] term fn #" + policy_i64_to_string(self.current_function_id as i64)
                      + " " + self.m.function_name(self.current_function_id)
                      + " block=" + policy_i64_to_string(block_id as i64)
                      + " kind=" + policy_i64_to_string(self.m.block_term_kind(block_id) as i64)
                      + " value=" + policy_i64_to_string(self.m.block_term_value(block_id) as i64)
                      + " elapsed=" + timing_term_elapsed.toString() + " ms");
            }
            let timing_block_elapsed = vyx_bootstrap_now_ms() - timing_block_start;
            if (timing_block_elapsed >= llvm_mir_slow_fn_threshold_ms()) {
                print("[mir-timing] block fn #" + policy_i64_to_string(self.current_function_id as i64)
                      + " " + self.m.function_name(self.current_function_id)
                      + " block=" + policy_i64_to_string(block_id as i64)
                      + " instrs=" + timing_instr_count.toString()
                      + " term_ms=" + timing_term_elapsed.toString()
                      + " elapsed=" + timing_block_elapsed.toString() + " ms");
            }
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-mir-term] after fn="
                  + policy_i64_to_string(self.current_function_id as i64)
                  + " block=" + policy_i64_to_string(block_id as i64)
                  + " errors=" + policy_i64_to_string(self.error_count as i64));
        }
    }

    // ---------------------------------------------------------------------
    // Frame-invariant borrow hoisting.
    //
    // A borrow of a place rooted at a local slot with constant projections has
    // the same address on every evaluation, so re-creating its region inside a
    // loop is pure overhead: the runtime call measured ~60ns before the region
    // dedup cache and still ~2ns (an out-of-line call) after it, which made a
    // linked-list walk 2x slower than the equivalent C.
    //
    // Region descriptors for borrows are created with capability 1 or 2, and
    // vyx_pointer_region_delete aborts on both tags, so the compiler never
    // emits a release for one: they are immutable, never-freed descriptors of
    // (base, span).  Creating one at the frame entry instead of at every
    // evaluation therefore changes nothing observable.
    //
    // Places whose address is not frame invariant (a deref root, a computed
    // index) keep the ordinary per-evaluation create, as do class-object
    // pointers, whose address is read out of a slot that may not be
    // initialised yet at frame entry.
    public fn place_address_is_frame_invariant(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        var cursor = place_id;
        var depth: i32 = 0;
        while (depth < 64) {
            let kind = self.m.place_kind(cursor);
            if (kind == mir_place_local()) { return true; }
            if (kind == mir_place_field()) {
                cursor = self.m.place_base(cursor);
                depth = depth + 1;
                continue;
            }
            if (kind == mir_place_index()) {
                let index_value = self.m.place_index_value(cursor);
                if (index_value == mir_id_invalid()) { return false; }
                if (self.m.value_kind(index_value) != mir_value_const_int()) { return false; }
                cursor = self.m.place_base(cursor);
                depth = depth + 1;
                continue;
            }
            return false;
        }
        return false;
    }

    // Emits the region create for every frame-invariant `&place` in the
    // function's value range.  Runs while the frame entry block is still
    // unterminated, so the calls land there and dominate every use.
    public fn hoist_frame_invariant_borrow_regions(self, function_id: i32) {
        // OFF BY DEFAULT -- opt in with VYX_REGION_HOIST=1.
        //
        // This hoist contradicts the borrow-site region invariant documented
        // at the lowering that consumes these handles ("Each evaluation of a
        // borrow site must create a FRESH region"): vyx_pointer_region_create
        // returns refcount 1 and the compiler pairs it with exactly one
        // frame-end vyx_pointer_region_delete.  Handing every evaluation of a
        // site the same hoisted handle keeps a region alive on paper while the
        // runtime may already have released it -- a stack borrow reuses the
        // same address on every iteration, so the stale handle is
        // indistinguishable from a fresh one.  The result is UAF and heap
        // corruption.
        //
        // Measured: zyn_counter_app --gpu crashed 3/3 with 0xC0000374 right
        // after D3D12 root-signature creation; with the hoist disabled it
        // exits 0 3/3 with byte-identical output (frames=2 rendered=2
        // nodes=10 draws=160).  The crash site was
        // GlyphCache::cacheGlyphIndex -> Vec<CachedGlyph>::ensure_capacity,
        // reached with a corrupted frame.
        //
        // The runtime region dedup cache from the same change stays enabled:
        // it is sound (it only ever returns a descriptor that is still live)
        // and carried most of the win (ptrBench 606ms -> 34.5ms).  Only the
        // hoist, which took it to 17.5ms, is gated off.  Reviving it requires
        // the hoisted handle to acquire and release the region in lockstep
        // with create/delete instead of caching a bare pointer.
        if (!llvm_mir_env_enabled("VYX_REGION_HOIST")) { return; }
        if (self.hoisted_borrow_handles == null || self.current_entry_block == null) { return; }
        let first_value = self.pending_value_first;
        let last_value = self.pending_value_last;
        if (first_value <= 0 || last_value < first_value) { return; }
        llvm_mir_map_clear_range(self.hoisted_borrow_handles, first_value, last_value);
        var value_id = first_value;
        while (value_id <= last_value) {
            if (self.m.value_kind(value_id) == mir_value_address_of()
                && self.m.value_function(value_id) == function_id) {
                let place_id = self.m.value_place(value_id);
                if (place_id != mir_id_invalid()
                    && self.dci_bitfield_for_place(place_id) == null
                    && self.m.place_kind(place_id) != mir_place_deref()
                    && self.place_address_is_frame_invariant(place_id)) {
                    let place_type = self.place_effective_type(place_id);
                    if (place_type != mir_id_invalid()
                        && !self.type_is_class_pointer_abi(place_type)) {
                        var capability: i32 = 1;
                        if (self.m.value_op(value_id) == 1) { capability = 2; }
                        var region_payload_type = place_type;
                        if (self.m.place_kind(place_id) == mir_place_index()) {
                            let array_base = self.m.place_base(place_id);
                            let array_type = self.place_effective_type(array_base);
                            if (llvm_mir_type_kind(&self.m, array_type) == ty_ARRAY()) {
                                region_payload_type = array_type;
                            }
                        }
                        let address = self.lower_place_addr(place_id);
                        if (address != null) {
                            let handle = self.pointer_handle_from_raw(address,
                                                                      region_payload_type,
                                                                      0,
                                                                      capability,
                                                                      "mir.addr.hoist");
                            if (handle != null) {
                                llvm_mir_map_put(self.hoisted_borrow_handles, value_id, handle);
                            }
                        }
                    }
                }
            }
            value_id = value_id + 1;
        }
    }

    // (first_value, last_value) per function for the whole-unit pipeline,
    // which lowers a complete unit and has no per-function value mark.
    public fn build_function_value_ranges(self) {
        if (self.function_value_ranges != null) { return; }
        let count = self.m.function_count;
        if (count <= 0) { return; }
        let bytes = ((count as i64) + 1) * 16;
        let buffer = malloc(bytes as u64);
        if (buffer == null) { return; }
        memset(buffer, 0, bytes as u64);
        self.function_value_ranges = buffer;
        let total = self.m.value_count;
        var value_id: i32 = 1;
        while (value_id <= total) {
            let owner = self.m.value_function(value_id);
            if (owner > 0 && owner <= count) {
                let slot = ptr_offset(buffer, owner * 16);
                if (ast_read_i64(slot) == 0) { ast_write_i64(slot, value_id as i64); }
                ast_write_i64(ptr_offset(slot, 8), value_id as i64);
            }
            value_id = value_id + 1;
        }
    }

    fn function_range_value(self, function_id: i32, offset: i32) -> i32 {
        if (self.function_value_ranges == null || function_id <= 0
            || function_id > self.m.function_count) {
            return 0;
        }
        return ast_read_i64(ptr_offset(self.function_value_ranges,
                                        function_id * 16 + offset)) as i32;
    }

    public fn prepare_function_value_range(self, function_id: i32) {
        self.build_function_value_ranges();
        self.pending_value_first = self.function_range_value(function_id, 0);
        self.pending_value_last = self.function_range_value(function_id, 8);
    }

    public fn lower_function(self, function_id: i32) {
        let temp_string_mark = vyx_rt_string_arena_checkpoint();
        if (!self.function_should_emit(function_id)) {
            self.release_temp_strings(temp_string_mark);
            return;
        }
        if (self.m.function_first_block(function_id) == mir_id_invalid()) {
            self.release_temp_strings(temp_string_mark);
            return;
        }
        self.current_function_id = function_id;
        self.current_block_id = mir_id_invalid();
        self.current_instr_id = mir_id_invalid();
        self.current_value_id = mir_id_invalid();
        self.current_place_id = mir_id_invalid();
        self.current_function_value = llvm_mir_map_get(self.function_values, function_id);
        self.current_entry_block = llvm_mir_map_get(self.block_values, self.m.function_first_block(function_id));
        if (self.current_function_value == null || self.current_entry_block == null) {
            self.report_error("cannot enter function " + self.m.function_name(function_id));
            self.release_temp_strings(temp_string_mark);
            return;
        }
        self.apply_function_definition_linkage(function_id, self.current_function_value);
        self.apply_function_codegen_attrs(function_id, self.current_function_value);
        let debug_line = self.debug_function_line(function_id);
        if (self.debug_enabled) {
            let source_name = self.m.function_name(function_id);
            vyx_rt_debug_set_function(self.mod,
                                      self.current_function_value,
                                      source_name.c_str(),
                                      source_name.len as u64,
                                      debug_line);
        }
        self.prepare_local_lifetime_marker_candidates(function_id);
        if (self.error_count > 0) {
            self.release_temp_strings(temp_string_mark);
            return;
        }
        vyx_rt_position_at_end(self.mod, self.current_entry_block);
        if (self.debug_enabled) { vyx_rt_debug_location(self.mod, debug_line, 1); }
        self.allocate_locals_for_function(function_id);
        self.declare_debug_locals_for_function(function_id);
        self.store_params_for_function(function_id);
        self.hoist_frame_invariant_borrow_regions(function_id);
        var block = self.m.function_first_block(function_id);
        while (block != mir_id_invalid()) {
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-mir-block] before fn="
                      + policy_i64_to_string(function_id as i64)
                      + " block=" + policy_i64_to_string(block as i64)
                      + " instrs=" + policy_i64_to_string(self.m.block_instr_count(block) as i64)
                      + " term=" + policy_i64_to_string(self.m.block_term_kind(block) as i64)
                      + " value=" + policy_i64_to_string(self.m.block_term_value(block) as i64));
            }
            self.lower_block(block);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[llvm-mir-block] after fn="
                      + policy_i64_to_string(function_id as i64)
                      + " block=" + policy_i64_to_string(block as i64)
                      + " errors=" + policy_i64_to_string(self.error_count as i64));
            }
            block = self.m.block_next(block);
        }
        if (self.error_count == 0) {
            self.mark_function_definition_emitted(function_id);
        }
        self.release_temp_strings(temp_string_mark);
    }

    public fn profile_phase(self, label: string) {
        if (vyx_bootstrap_profile_level() <= 0) { return; }
        print("[llvm-mir] " + label
              + " funcs=" + policy_i64_to_string(self.m.function_count as i64)
              + " blocks=" + policy_i64_to_string(self.m.block_count as i64)
              + " values=" + policy_i64_to_string(self.m.value_count as i64)
              + " instrs=" + policy_i64_to_string(self.m.instr_count as i64)
              + " str_active_mb=" + self.memory_mb_text(vyx_rt_string_arena_active_bytes())
              + " str_reserved_mb=" + self.memory_mb_text(vyx_rt_string_arena_reserved_bytes())
              + " astdup_mb=" + self.memory_mb_text(vyx_rt_ast_dup_bytes_total())
              + " astnode_mb=" + self.memory_mb_text(vyx_rt_ast_node_bytes_total())
              + " private_mb=" + self.memory_mb_text(vyx_rt_process_private_bytes())
              + " working_mb=" + self.memory_mb_text(vyx_rt_process_working_set_bytes())
              + " peak_private_mb=" + self.memory_mb_text(vyx_rt_process_peak_private_bytes())
              + " peak_working_mb=" + self.memory_mb_text(vyx_rt_process_peak_working_set_bytes())
              + " errors=" + policy_i64_to_string(self.error_count as i64));
    }

    public fn clear_streaming_body_caches(self,
                                          block_mark: i32,
                                          local_mark: i32,
                                          place_mark: i32,
                                          value_mark: i32,
                                          instr_mark: i32,
                                          case_mark: i32) {
        llvm_mir_map_clear_range(self.block_values, block_mark + 1, self.m.block_count);
        llvm_mir_map_clear_range(self.local_slots, local_mark + 1, self.m.local_count);
        llvm_mir_i32_map_clear_range(self.local_lifetime_marker_candidates,
                                     local_mark + 1,
                                     self.m.local_count);
        llvm_mir_i32_map_clear_range(self.local_lifetime_marker_live_orders,
                                     local_mark + 1,
                                     self.m.local_count);
        llvm_mir_i32_map_clear_range(self.local_lifetime_marker_dead_orders,
                                     local_mark + 1,
                                     self.m.local_count);
        llvm_mir_i32_map_clear_range(self.local_slot_reuse_candidates,
                                     local_mark + 1,
                                     self.m.local_count);
        llvm_mir_i32_map_clear_range(self.local_slot_reuse_sources,
                                     local_mark + 1,
                                     self.m.local_count);
        llvm_mir_map_clear_range(self.foreach_iterator_slots, value_mark + 1, self.m.value_count);
        llvm_mir_map_clear_range(self.value_cache, value_mark + 1, self.m.value_count);
        llvm_mir_i32_map_clear_range(self.direct_call_callee_value_map, value_mark + 1, self.m.value_count);
    }

    public fn discard_streaming_function_body(self,
                                               builder: &mut MirUnitBuilder,
                                               function_id: i32,
                                               block_mark: i32,
                                               local_mark: i32,
                                               place_mark: i32,
                                               value_mark: i32,
                                               instr_mark: i32,
                                               case_mark: i32) {
        self.clear_streaming_body_caches(block_mark,
                                         local_mark,
                                         place_mark,
                                         value_mark,
                                         instr_mark,
                                         case_mark);
        mir_unit_discard_recent_body_records(&mut builder.unit,
                                             function_id,
                                             block_mark,
                                             local_mark,
                                             place_mark,
                                             value_mark,
                                             instr_mark,
                                             case_mark);
        self.m = builder.unit;
    }

    public fn scan_adapter_uses_for_value_range(self, first_value: i32, last_value: i32) {
        if (last_value < first_value) {
            self.adapter_need_cache_ready = true;
            return;
        }
        llvm_mir_i32_map_clear_range(self.direct_call_callee_value_map, first_value, last_value);
        var value_id = first_value;
        while (value_id <= last_value) {
            if (self.m.value_kind(value_id) == mir_value_call()) {
                let callee = self.m.value_lhs(value_id);
                if (callee != mir_id_invalid()
                    && self.m.value_target_kind(value_id) == mir_target_function()) {
                    llvm_mir_i32_map_put(self.direct_call_callee_value_map, callee, 2);
                }
            }
            value_id = value_id + 1;
        }
        value_id = first_value;
        while (value_id <= last_value) {
            let target_kind = self.m.value_target_kind(value_id);
            let target_id = self.m.value_target_id(value_id);
            if (target_kind == mir_target_function() && target_id != mir_id_invalid()) {
                if (self.type_is_fn_abi_destination(self.m.value_type(value_id))
                    && llvm_mir_i32_map_get(self.direct_call_callee_value_map, value_id) != 2) {
                    llvm_mir_i32_map_put(self.function_value_adapter_need_map, target_id, 2);
                }
            }
            if (self.m.value_kind(value_id) == mir_value_cast()
                && self.type_is_raw_callback_scalar_target(self.m.value_type(value_id))) {
                let lhs = self.m.value_lhs(value_id);
                if (lhs != mir_id_invalid()
                    && self.m.value_kind(lhs) == mir_value_target_ref()
                    && self.m.value_target_kind(lhs) == mir_target_function()) {
                    llvm_mir_i32_map_put(self.raw_callback_adapter_use_map,
                                         self.m.value_target_id(lhs),
                                         2);
                }
            }
            value_id = value_id + 1;
        }
        self.adapter_need_cache_ready = true;
    }

    public fn declare_streaming_adapters_for_value_range(self, first_value: i32, last_value: i32) {
        if (vyx_bootstrap_profile_level() > 1) {
            print("[llvm-mir-stream] adapters-scan range="
                  + policy_i64_to_string(first_value as i64)
                  + ".."
                  + policy_i64_to_string(last_value as i64));
        }
        self.scan_adapter_uses_for_value_range(first_value, last_value);
        var value_id = first_value;
        while (value_id <= last_value) {
            let target_kind = self.m.value_target_kind(value_id);
            let target_id = self.m.value_target_id(value_id);
            if (target_kind == mir_target_function() && target_id != mir_id_invalid()) {
                if (self.type_is_fn_abi_destination(self.m.value_type(value_id))
                    && llvm_mir_i32_map_get(self.direct_call_callee_value_map, value_id) != 2) {
                    if (vyx_bootstrap_profile_level() > 1) {
                        print("[llvm-mir-stream] fn-adapter value="
                              + policy_i64_to_string(value_id as i64)
                              + " target="
                              + policy_i64_to_string(target_id as i64)
                              + " name="
                              + self.m.function_name(target_id));
                    }
                    self.declare_function_value_adapter_for(target_id);
                }
            }
            if (self.m.value_kind(value_id) == mir_value_cast()
                && self.type_is_raw_callback_scalar_target(self.m.value_type(value_id))) {
                let lhs = self.m.value_lhs(value_id);
                if (lhs != mir_id_invalid()
                    && self.m.value_kind(lhs) == mir_value_target_ref()
                    && self.m.value_target_kind(lhs) == mir_target_function()) {
                    if (vyx_bootstrap_profile_level() > 1) {
                        print("[llvm-mir-stream] raw-adapter value="
                              + policy_i64_to_string(value_id as i64)
                              + " target="
                              + policy_i64_to_string(self.m.value_target_id(lhs) as i64)
                              + " name="
                              + self.m.function_name(self.m.value_target_id(lhs)));
                    }
                    self.declare_raw_callback_adapter_for(self.m.value_target_id(lhs));
                }
            }
            value_id = value_id + 1;
        }
        if (vyx_bootstrap_profile_level() > 1) {
            print("[llvm-mir-stream] adapters-done");
        }
    }

    public fn cgu_intern_key(self, key: string) -> i32 {
        var id: i32 = 1;
        var start: i32 = 0;
        var i: i32 = 0;
        let table = self.cgu_key_table;
        while (i <= table.len) {
            if (i == table.len || table.charAt(i) == 10) {
                if (i > start) {
                    if (table.substring(start, i) == key) { return id; }
                    id = id + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        self.cgu_key_table = self.cgu_key_table + key + "\n";
        return id;
    }

    public fn function_cgu_key(self, function_id: i32) -> string {
        let disc = mir_unit_function_symbol_discriminator(&self.m, function_id);
        if (disc.len >= 7 && disc.substring(0, 7) == "source=") {
            var end: i32 = 7;
            while (end < disc.len) {
                if (disc.charAt(end) == 124) { break; }
                end = end + 1;
            }
            let src = disc.substring(7, end);
            if (src.len > 0) { return src; }
        }
        if (self.debug_source_path.len > 0) { return self.debug_source_path; }
        return self.module_symbol_name;
    }

    public fn cgu_grow_collected(self) {
        var next = self.cgu_collected_cap * 2;
        if (next < 64) { next = 64; }
        let bytes = (next * 4) as u64;
        let ids = malloc(bytes);
        let sizes = malloc(bytes);
        let keys = malloc(bytes);
        let sig_off = malloc(bytes);
        let marks = malloc((next * CGU_RETAIN_STRIDE * 4) as u64);
        if (ids != null) { memset(ids, 0, bytes); }
        if (sizes != null) { memset(sizes, 0, bytes); }
        if (keys != null) { memset(keys, 0, bytes); }
        if (marks != null) { memset(marks, 0, (next * CGU_RETAIN_STRIDE * 4) as u64); }
        // 0xFF per byte is -1 per i32: "no signature snapshot for this slot".
        if (sig_off != null) { memset(sig_off, 255, bytes); }
        if (self.cgu_collected_ids != null && ids != null) {
            memcpy(ids, self.cgu_collected_ids, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_ids);
        }
        if (self.cgu_collected_sizes != null && sizes != null) {
            memcpy(sizes, self.cgu_collected_sizes, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_sizes);
        }
        if (self.cgu_collected_keys != null && keys != null) {
            memcpy(keys, self.cgu_collected_keys, (self.cgu_collected_n * 4) as u64);
            free(self.cgu_collected_keys);
        }
        if (self.dyn_sig_off != null && sig_off != null) {
            memcpy(sig_off, self.dyn_sig_off, (self.cgu_collected_n * 4) as u64);
            free(self.dyn_sig_off);
        }
        if (self.cgu_retain_marks != null && marks != null) {
            memcpy(marks, self.cgu_retain_marks,
                   (self.cgu_collected_n * CGU_RETAIN_STRIDE * 4) as u64);
            free(self.cgu_retain_marks);
        }
        self.cgu_collected_ids = ids;
        self.cgu_collected_sizes = sizes;
        self.cgu_collected_keys = keys;
        self.cgu_retain_marks = marks;
        self.dyn_sig_off = sig_off;
        self.cgu_collected_cap = next;
    }

    public fn grow_dyn_sig_buf(self, min_need: i32) {
        var next = self.dyn_sig_cap * 2;
        if (next < 256) { next = 256; }
        while (next < min_need) { next = next * 2; }
        let bytes = (next * 4) as u64;
        let buf = malloc(bytes);
        if (buf == null) { return; }
        if (self.dyn_sig_buf != null) {
            memcpy(buf, self.dyn_sig_buf, (self.dyn_sig_n * 4) as u64);
            free(self.dyn_sig_buf);
        }
        self.dyn_sig_buf = buf;
        self.dyn_sig_cap = next;
    }

    // Snapshot `[arity, param0_type, param1_type, ...]` for one partition slot.
    // Runs while the body is still materialized (immediately before the body is
    // released), which is the only point where the parameter locals of a
    // function owned by another unit can be read safely.
    public fn cgu_record_dyn_signature(self, slot: i32, function_id: i32) {
        if (self.dyn_sig_off == null) { return; }
        if (self.cgu_shell_sweep) { return; }
        var arity = self.function_source_param_count(function_id);
        if (arity < 1) { arity = 0; }
        let need = arity + 1;
        if (self.dyn_sig_buf == null || self.dyn_sig_n + need > self.dyn_sig_cap) {
            self.grow_dyn_sig_buf(self.dyn_sig_n + need);
            if (self.dyn_sig_buf == null) { return; }
        }
        let base = self.dyn_sig_n;
        ast_write_i32(ptr_offset(self.dyn_sig_buf, base * 4), arity);
        var i: i32 = 0;
        while (i < arity) {
            ast_write_i32(ptr_offset(self.dyn_sig_buf, (base + 1 + i) * 4),
                          self.function_source_param_type(function_id, i));
            i = i + 1;
        }
        self.dyn_sig_n = base + need;
        ast_write_i32(ptr_offset(self.dyn_sig_off, slot * 4), base);
    }

    // Index one partition slot under its method name for the `dyn` fallback.
    // The index stores `slot + 1` -- everything downstream needs the slot, not
    // just the function id, because the signature snapshot lives in a parallel
    // array -- and slot 0 has to survive the index's "id 0 means empty" guard.
    // Reached either from the one-shot pass below or incrementally from
    // `cgu_record_function`, which de-duplicates through `cgu_member_map`, so a
    // slot is never indexed twice.  Walking the whole partition on every lookup
    // is what made an earlier version of this fallback exhaust the string pool
    // while compiling the compiler.
    public fn remember_dyn_partition_slot(self, slot: i32) {
        if (self.dyn_partition_index == null) { return; }
        if (self.cgu_collected_ids == null) { return; }
        if (slot < 0 || slot >= self.cgu_collected_n) { return; }
        let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
        if (fn_id == mir_id_invalid()) { return; }
        if (mir_unit_function_owner_item_kind(&self.m, fn_id) == hir_item_interface()) { return; }
        let method_name = self.function_method_name(fn_id);
        if (method_name.len == 0) { return; }
        llvm_mir_method_candidate_index_put(self.dyn_partition_index,
                                            self.dyn_partition_index_cap,
                                            method_name,
                                            slot + 1);
    }

    // Fold any not-yet-indexed partition slots into `dyn_partition_index`.  The
    // index is built lazily so a build that never needs the `dyn` fallback pays
    // nothing, and it is extended incrementally so a lookup never rescans the
    // slots it has already seen.  Only the function *record* is read here (name,
    // owner, item kind); signatures come from `dyn_sig_off`, which was filled in
    // at record time while the bodies were still live.
    public fn ensure_dyn_partition_index(self) {
        if (self.dyn_partition_index == null || self.cgu_collected_ids == null) { return; }
        while (self.dyn_partition_index_n < self.cgu_collected_n) {
            self.remember_dyn_partition_slot(self.dyn_partition_index_n);
            self.dyn_partition_index_n = self.dyn_partition_index_n + 1;
        }
    }

    // Returns the collected slot the function was given, or -1 when it was not
    // recorded (invalid id, already a member, or the arrays could not grow).
    public fn cgu_record_function(self, function_id: i32, instr_delta: i32) -> i32 {
        if (function_id == mir_id_invalid()) { return -1; }
        if (llvm_mir_i32_map_get(self.cgu_member_map, function_id) != 0) { return -1; }
        if (self.cgu_collected_n >= self.cgu_collected_cap) { self.cgu_grow_collected(); }
        if (self.cgu_collected_ids == null) { return -1; }
        var size = instr_delta;
        if (size < 1) { size = 1; }
        let key_id = self.cgu_intern_key(self.function_cgu_key(function_id));
        ast_write_i32(ptr_offset(self.cgu_collected_ids, self.cgu_collected_n * 4), function_id);
        ast_write_i32(ptr_offset(self.cgu_collected_sizes, self.cgu_collected_n * 4), size);
        ast_write_i32(ptr_offset(self.cgu_collected_keys, self.cgu_collected_n * 4), key_id);
        self.cgu_collected_n = self.cgu_collected_n + 1;
        llvm_mir_i32_map_put(self.cgu_member_map, function_id, 1);
        // Snapshot the parameter signature right here: this is the last moment
        // at which the body is still materialized, and a body registered for a
        // sibling unit is released before that unit's `dyn` vtables are lowered.
        self.cgu_record_dyn_signature(self.cgu_collected_n - 1, function_id);
        if (policy_phase_summary_enabled() && ((self.cgu_collected_n % 256) == 0)) {
            print("[llvm-cgu] collect-fns=" + policy_i64_to_string(self.cgu_collected_n as i64));
        }
        return self.cgu_collected_n - 1;
    }

    // Collect walk: may this body be released, or must it stay in the arena
    // for the emit walk?
    //
    // The emit walk rebuilds every released body from its provenance, so a body
    // that has no provenance cannot be released -- the loss is permanent and
    // the emit walk then fails with `I0100 ... still unavailable after
    // streaming deferred retries`.  A lambda's synthesized `closure$N`
    // function is exactly such a body: it was built inline from the enclosing
    // expression and never had a declaration of its own.  `VYX_CGU_RETAIN=1`
    // turns the retention on for the whole unit; this keeps it to the bodies
    // that actually need it.
    public fn cgu_must_retain_collected_body(self, builder: &mut MirUnitBuilder, fn_id: i32) -> bool {
        if (self.cgu_retain_bodies) { return true; }
        let hir_fn = builder.unit.function_hir_id(fn_id);
        if (hir_fn == hir_id_invalid()) { return false; }
        return !builder.hir_function_body_is_recoverable(hir_fn);
    }

    // Must an otherwise releasable body be kept anyway, because something
    // retained was built inside it?
    //
    // The arena is a stack: a nested function's region sits directly above the
    // region of the body whose build pulled it in, and both share the same
    // tables.  `discard_recent_body_records` rewinds every counter to the
    // released body's *start* marks and zeroes every record above them, so
    // releasing an enclosing body destroys any retained body inside it; the
    // emit walk then copies the frozen marks of a region that holds nothing and
    // dies with `I0100 ... references invalid block #N`.  `retained_before` is
    // `cgu_retain_count` as it stood before this body was built, so a change
    // means a retained body lies inside this one and this body has to survive
    // until the emit walk is done -- regardless of whether *itself* it could
    // have been rebuilt from provenance.
    public fn cgu_must_retain_enclosing_body(self, retained_before: i32) -> bool {
        return self.cgu_retain_count != retained_before;
    }

    // Remember where a collected body lives so the emit walk can reuse it
    // instead of materialising the function again.  The body has to still be in
    // the arena, which is why the emit walk must not release it as it goes.
    // Membership of `cgu_retain_slot` -- not the unit-wide flag -- is what the
    // emit walk and the final release both key off, because
    // `cgu_must_retain_collected_body` can retain a single body on its own.
    public fn cgu_retain_record(self, slot: i32, function_id: i32, rec: rawptr) -> bool {
        if (slot < 0 || self.cgu_retain_marks == null) { return false; }
        if (self.cgu_retain_slot == null) {
            self.cgu_retain_slot = llvm_mir_alloc_i32_map(self.cgu_collected_cap + 1);
            if (self.cgu_retain_slot == null) { return false; }
        }
        let base = ptr_offset(self.cgu_retain_marks,
                              slot * CGU_RETAIN_STRIDE * 4);
        ast_write_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_BLOCK_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_LOCAL_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_PLACE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_VALUE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_INSTR_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_CASE * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_CASE_MARK)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_VALUE_END * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_VALUE_END)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_INSTR_END * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_INSTR_END)));
        ast_write_i32(ptr_offset(base, CGU_RETAIN_FUNC_MARK * 4),
                      ast_read_i32(ptr_offset(rec, MIR_SLICE_FUNC_MARK)));
        llvm_mir_i32_map_put(self.cgu_retain_slot, function_id, slot + 1);
        self.cgu_retain_count = self.cgu_retain_count + 1;
        return true;
    }

    // True when the collect walk left a body behind for this function, in which
    // case the frozen marks are copied into `rec` and the emit walk can skip
    // straight to the MIR pass.
    public fn cgu_retain_load(self, function_id: i32, rec: rawptr) -> bool {
        if (self.cgu_retain_marks == null || self.cgu_retain_slot == null) { return false; }
        let at = llvm_mir_i32_map_get(self.cgu_retain_slot, function_id);
        if (at <= 0) { return false; }
        let base = ptr_offset(self.cgu_retain_marks, (at - 1) * CGU_RETAIN_STRIDE * 4);
        ast_write_i32(ptr_offset(rec, MIR_SLICE_BLOCK_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_LOCAL_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_PLACE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_VALUE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_INSTR_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_CASE_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_CASE * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_VALUE_END),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE_END * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_INSTR_END),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR_END * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_FUNC_MARK),
                      ast_read_i32(ptr_offset(base, CGU_RETAIN_FUNC_MARK * 4)));
        ast_write_i32(ptr_offset(rec, MIR_SLICE_RETAINED), 1);
        return true;
    }

    public fn cgu_retain_note_emitted(self, function_id: i32, emitted: bool) {
        if (self.cgu_retain_marks == null || self.cgu_retain_slot == null) { return; }
        let at = llvm_mir_i32_map_get(self.cgu_retain_slot, function_id);
        if (at <= 0) { return; }
        let base = ptr_offset(self.cgu_retain_marks, (at - 1) * CGU_RETAIN_STRIDE * 4);
        if (emitted) {
            ast_write_i32(ptr_offset(base, CGU_RETAIN_EMITTED * 4), 1);
        }
    }

    // Give every retained body back to the arena once the whole emit phase is
    // done.  Bodies are released in reverse collected order: they were
    // materialised as a stack, so releasing from the top is what keeps each
    // `discard` from destroying a body that is still above it.
    public fn cgu_release_retained_bodies(self, builder: &mut MirUnitBuilder) {
        if (self.cgu_retain_marks == null || self.cgu_collected_ids == null) { return; }
        if (self.cgu_retain_slot == null) { return; }
        var i = self.cgu_collected_n - 1;
        while (i >= 0) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            // Only slots that actually kept a body.  `cgu_collect_from_shells`
            // appends functions with no body of their own, and their zeroed
            // marks would rewind the arena to the very bottom.
            if (llvm_mir_i32_map_get(self.cgu_retain_slot, fn_id) != i + 1) {
                i = i - 1;
                continue;
            }
            let base = ptr_offset(self.cgu_retain_marks, i * CGU_RETAIN_STRIDE * 4);
            self.discard_streaming_function_body(builder,
                                                 fn_id,
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_BLOCK * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_LOCAL * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_PLACE * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_VALUE * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_INSTR * 4)),
                                                 ast_read_i32(ptr_offset(base, CGU_RETAIN_CASE * 4)));
            if (ast_read_i32(ptr_offset(base, CGU_RETAIN_EMITTED * 4)) != 0) {
                builder.unit.set_function_streamed_body_discarded(fn_id, true);
                self.m = builder.unit;
            }
            i = i - 1;
        }
    }

    public fn cgu_collect_from_shells(self, builder: &mut MirUnitBuilder) {
        if (self.cgu_member_map == null) {
            self.cgu_member_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        // Every function this sweep records has already had its body released by
        // the collect-only walk, so its parameter locals cannot be read (see
        // `cgu_shell_sweep` on `cgu_record_dyn_signature`).  Suppress the
        // snapshot instead of walking a dead `local_next` chain.
        self.cgu_shell_sweep = true;
        var fn_id: i32 = 1;
        let n = self.m.function_count;
        while (fn_id <= n) {
            if (builder.function_is_partition_external_root(fn_id)
                || builder.function_is_partition_declaration_only(fn_id)) {
                fn_id = fn_id + 1;
                continue;
            }
            let hir_fn = builder.unit.function_hir_id(fn_id);
            if (hir_fn == hir_id_invalid()) {
                fn_id = fn_id + 1;
                continue;
            }
            let flags = mir_unit_function_flags(&builder.unit, fn_id);
            if ((flags & hir_function_flag_imported_body()) != 0) {
                fn_id = fn_id + 1;
                continue;
            }
            self.cgu_record_function(fn_id, 1);
            fn_id = fn_id + 1;
        }
        self.cgu_shell_sweep = false;
        if (policy_phase_summary_enabled()) {
            print("[llvm-cgu] shells=" + policy_i64_to_string(n as i64)
                  + " collected=" + policy_i64_to_string(self.cgu_collected_n as i64));
        }
    }

    public fn cgu_key_count(self) -> i32 {
        var n: i32 = 0;
        var i: i32 = 0;
        let table = self.cgu_key_table;
        var start: i32 = 0;
        while (i <= table.len) {
            if (i == table.len || table.charAt(i) == 10) {
                if (i > start) { n = n + 1; }
                start = i + 1;
            }
            i = i + 1;
        }
        return n;
    }

    public fn cgu_partition_collected(self, max_units: i32) {
        let key_n = self.cgu_key_count();
        if (self.cgu_member_map == null) {
            self.cgu_member_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        if (self.cgu_static_defined_map == null) {
            self.cgu_static_defined_map = llvm_mir_alloc_i32_map(self.m.function_count + 1);
        }
        if (key_n <= 0 || self.cgu_collected_n <= 0) {
            self.cgu_unit_count = 1;
            return;
        }
        var limit = max_units;
        if (limit < 1) { limit = 1; }
        let parent = malloc(((key_n + 1) * 4) as u64);
        let key_size = malloc(((key_n + 1) * 4) as u64);
        let dense = malloc(((key_n + 1) * 4) as u64);
        if (parent == null || key_size == null || dense == null) {
            self.cgu_unit_count = 1;
            if (parent != null) { free(parent); }
            if (key_size != null) { free(key_size); }
            if (dense != null) { free(dense); }
            return;
        }
        memset(parent, 0, ((key_n + 1) * 4) as u64);
        memset(key_size, 0, ((key_n + 1) * 4) as u64);
        memset(dense, 0, ((key_n + 1) * 4) as u64);
        var k: i32 = 1;
        while (k <= key_n) {
            ast_write_i32(ptr_offset(parent, k * 4), k);
            k = k + 1;
        }
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let kid = ast_read_i32(ptr_offset(self.cgu_collected_keys, i * 4));
            let sz = ast_read_i32(ptr_offset(self.cgu_collected_sizes, i * 4));
            if (kid > 0 && kid <= key_n) {
                let cur = ast_read_i32(ptr_offset(key_size, kid * 4));
                ast_write_i32(ptr_offset(key_size, kid * 4), cur + sz);
            }
            i = i + 1;
        }
        var alive = key_n;
        while (alive > limit) {
            var best_a: i32 = 0;
            var best_b: i32 = 0;
            var best_sa: i32 = 0;
            var best_sb: i32 = 0;
            k = 1;
            while (k <= key_n) {
                if (llvm_cgu_find_root(parent, k) == k) {
                    let sz = ast_read_i32(ptr_offset(key_size, k * 4));
                    if (best_a == 0 || sz < best_sa) {
                        best_b = best_a;
                        best_sb = best_sa;
                        best_a = k;
                        best_sa = sz;
                    } elif (best_b == 0 || sz < best_sb) {
                        best_b = k;
                        best_sb = sz;
                    }
                }
                k = k + 1;
            }
            if (best_a == 0 || best_b == 0) { break; }
            ast_write_i32(ptr_offset(parent, best_b * 4), best_a);
            ast_write_i32(ptr_offset(key_size, best_a * 4), best_sa + best_sb);
            alive = alive - 1;
        }
        var next_dense: i32 = 1;
        k = 1;
        while (k <= key_n) {
            if (llvm_cgu_find_root(parent, k) == k) {
                ast_write_i32(ptr_offset(dense, k * 4), next_dense);
                next_dense = next_dense + 1;
            }
            k = k + 1;
        }
        self.cgu_unit_count = next_dense - 1;
        if (self.cgu_unit_count < 1) { self.cgu_unit_count = 1; }
        i = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            let kid = ast_read_i32(ptr_offset(self.cgu_collected_keys, i * 4));
            let root = llvm_cgu_find_root(parent, kid);
            var unit = ast_read_i32(ptr_offset(dense, root * 4));
            if (unit < 1) { unit = 1; }
            llvm_mir_i32_map_put(self.cgu_member_map, fn_id, unit);
            i = i + 1;
        }
        free(parent);
        free(key_size);
        free(dense);
    }

    public fn cgu_enqueue_members(self, builder: &mut MirUnitBuilder) {
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            if (llvm_mir_i32_map_get(self.cgu_member_map, fn_id) == self.cgu_emit_index) {
                builder.reset_function_codegen_marks(fn_id);
                builder.mark_function_reachable(fn_id);
            }
            i = i + 1;
        }
    }

    public fn cgu_reset_future_marks(self, builder: &mut MirUnitBuilder) {
        var i: i32 = 0;
        while (i < self.cgu_collected_n) {
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, i * 4));
            if (llvm_mir_i32_map_get(self.cgu_member_map, fn_id) > self.cgu_emit_index) {
                builder.reset_function_codegen_marks(fn_id);
            }
            i = i + 1;
        }
    }

    public fn null_llvm_cached_handles(self) {
