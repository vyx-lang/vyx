        if (key == "fopen") { return self.builtin_fopen_fty; }
        if (key == "fclose") { return self.builtin_fclose_fty; }
        if (key == "fread") { return self.builtin_fread_fty; }
        if (key == "fwrite") { return self.builtin_fwrite_fty; }
        if (key == "fgetc") { return self.builtin_fgetc_fty; }
        if (key == "fputc") { return self.builtin_fputc_fty; }
        if (key == "feof") { return self.builtin_feof_fty; }
        if (key == "fseek") { return self.builtin_fseek_fty; }
        if (key == "ftell") { return self.builtin_ftell_fty; }
        if (key == "remove") { return self.builtin_remove_fty; }
        if (key == "rename") { return self.builtin_rename_fty; }
        return null;
    }

    public fn bind_runtime_external_function(self, function_id: i32) -> bool {
        let key = self.runtime_external_function_key(function_id);
        if (key.len == 0) { return false; }
        let f = self.runtime_external_function_value(key);
        let fty = self.runtime_external_function_type(key);
        if (f == null || fty == null) {
            self.report_error("runtime external declaration is unavailable for " + key);
            return true;
        }
        llvm_mir_map_put(self.function_values, function_id, f);
        llvm_mir_map_put(self.function_types, function_id, fty);
        self.remember_declared_function_symbol(function_id, self.function_symbol_name(function_id));
        return true;
    }

    public fn remember_declared_function_symbol(self, function_id: i32, symbol: string) {
        if (function_id == mir_id_invalid() || symbol.len == 0) { return; }
        llvm_mir_symbol_index_put_first(self.function_symbol_index,
                                        self.function_symbol_index_cap,
                                        symbol,
                                        function_id);
    }

    public fn debug_value_line(self, value_id: i32) -> i32 {
        if (!self.debug_enabled || value_id <= 0 || value_id > self.m.value_count) {
            return 0;
        }
        let line = self.m.value_loc_line(value_id);
        if (line > 0) { return line; }
        let lhs = self.m.value_lhs(value_id);
        if (lhs > 0 && lhs != value_id) {
            let lhs_line = self.m.value_loc_line(lhs);
            if (lhs_line > 0) { return lhs_line; }
        }
        let rhs = self.m.value_rhs(value_id);
        if (rhs > 0 && rhs != value_id) {
            let rhs_line = self.m.value_loc_line(rhs);
            if (rhs_line > 0) { return rhs_line; }
        }
        return 0;
    }

    public fn debug_instr_line(self, instr_id: i32) -> i32 {
        if (!self.debug_enabled || instr_id <= 0 || instr_id > self.m.instr_count) {
            return 0;
        }
        var line = self.m.instr_loc_line(instr_id);
        if (line <= 0) { line = self.debug_value_line(self.m.instr_value(instr_id)); }
        if (line <= 0) { line = self.debug_value_line(self.m.instr_lhs(instr_id)); }
        if (line <= 0) { line = self.debug_value_line(self.m.instr_rhs(instr_id)); }
        return line;
    }

    public fn debug_instr_col(self, instr_id: i32) -> i32 {
        if (!self.debug_enabled || instr_id <= 0 || instr_id > self.m.instr_count) {
            return 1;
        }
        let col = self.m.instr_loc_col(instr_id);
        if (col > 0) { return col; }
        return 1;
    }

    public fn debug_function_line(self, function_id: i32) -> i32 {
        if (!self.debug_enabled) { return 1; }
        var block = self.m.function_first_block(function_id);
        while (block != mir_id_invalid()) {
            var instr = self.m.block_first_instr(block);
            while (instr != mir_id_invalid()) {
                let line = self.debug_instr_line(instr);
                if (line > 1) { return line - 1; }
                if (line > 0) { return line; }
                instr = self.m.instr_next(instr);
            }
            let term_line = self.debug_value_line(self.m.block_term_value(block));
            if (term_line > 0) { return term_line; }
            block = self.m.block_next(block);
        }
        return 1;
    }

    public fn set_debug_location_for_instr(self, instr_id: i32) {
        let line = self.debug_instr_line(instr_id);
        if (line > 0) { vyx_rt_debug_location(self.mod, line, self.debug_instr_col(instr_id)); }
    }

    public fn set_debug_location_for_terminator(self, block_id: i32) {
        var line = self.debug_value_line(self.m.block_term_value(block_id));
        var col: i32 = 1;
        if (line <= 0) {
            line = self.m.block_loc_line(block_id);
            let block_col = self.m.block_loc_col(block_id);
            if (block_col > 0) { col = block_col; }
        }
        if (line > 0) { vyx_rt_debug_location(self.mod, line, col); }
    }

    public fn declare_function_signature(self, function_id: i32) -> bool {
        if (!self.function_can_be_declared(function_id)) { return false; }
        if (llvm_mir_map_get(self.function_values, function_id) != null
            && llvm_mir_map_get(self.function_types, function_id) != null) {
            if (vyx_bootstrap_profile_level() > 2) {
                let cached_fn = llvm_mir_map_get(self.function_values, function_id);
                print("[llvm-mir-declare-sig] cached fn="
                      + policy_i64_to_string(function_id as i64)
                      + " src=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                      + " llvm=" + policy_i64_to_string(self.function_llvm_param_count(function_id) as i64)
                      + " actual=" + policy_i64_to_string(self.debug_llvm_function_param_count(cached_fn) as i64)
                      + " first_local=" + policy_i64_to_string(self.m.function_first_local(function_id) as i64)
                      + " name=" + self.m.function_name(function_id));
            }
            return true;
        }
        if (!self.function_is_foreign_dci(function_id)
            && self.bind_runtime_external_function(function_id)) {
            return llvm_mir_map_get(self.function_values, function_id) != null
                && llvm_mir_map_get(self.function_types, function_id) != null;
        }
        let name = self.function_symbol_name(function_id);
        let fty = self.build_function_type(function_id);
        if (fty == null) {
            self.report_error("cannot build function type for " + self.m.function_name(function_id));
            return false;
        }
        let bind_result = self.bind_existing_function_symbol(function_id, name, fty);
        if (bind_result > 0) { return true; }
        if (bind_result < 0) { return false; }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-mir-declare-sig] new fn="
                  + policy_i64_to_string(function_id as i64)
                  + " src=" + policy_i64_to_string(self.function_source_param_count(function_id) as i64)
                  + " llvm=" + policy_i64_to_string(self.function_llvm_param_count(function_id) as i64)
                  + " first_local=" + policy_i64_to_string(self.m.function_first_local(function_id) as i64)
                  + " symbol=" + name
                  + " name=" + self.m.function_name(function_id));
        }
        let f = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, fty);
        if (f == null) {
            self.report_error("cannot declare function " + name);
            return false;
        }
        self.apply_function_codegen_attrs(function_id, f);
        if (!self.apply_dci_function_abi_attrs(function_id, f)) { return false; }
        if (!self.apply_native_c_aggregate_abi_attrs(function_id, f)) { return false; }
        self.apply_dci_unwind_attrs(function_id, f);
        llvm_mir_map_put(self.function_values, function_id, f);
        llvm_mir_map_put(self.function_types, function_id, fty);
        self.remember_declared_function_symbol(function_id, name);
        return true;
    }

    // This comparison is deliberately narrower than dci_symbol_contracts_equivalent.
    // It is used only when two foreign declarations resolve to one linker symbol.
    // Source aliases may give that one native object distinct nominal owner and
    // receiver names, while their machine ABI remains identical.
    public fn dci_shared_link_canonical_type_name(self, raw: string) -> string {
        let normalized = self.dci_canonical_type_name_text(raw);
        if (normalized.len == 0) { return ""; }
        if (normalized.startsWith("*")) {
            let tail = self.dci_shared_link_canonical_type_name(
                normalized.substring(1, normalized.len));
            if (tail.len == 0) { return ""; }
            return "*" + tail;
        }
        if (normalized.startsWith("&")) {
            let tail2 = self.dci_shared_link_canonical_type_name(
                normalized.substring(1, normalized.len));
            if (tail2.len == 0) { return ""; }
            return "&" + tail2;
        }
        var current = normalized;
        var depth: i32 = 0;
        while (depth < 64) {
            var changed = false;
            var root_i: i32 = 0;
            let root_n = self.dci_contract_count();
            while (root_i < root_n && !changed) {
                let aliases = self.dci_exports_array_from(self.dci_contract_at(root_i), "aliases");
                if (aliases != null) {
                    var i: i32 = 0;
                    let n = cJSON_GetArraySize(aliases);
                    while (i < n) {
                        let alias = cJSON_GetArrayItem(aliases, i);
                        if (alias != null && cJSON_IsObject(alias) != 0) {
                            let alias_name = self.dci_json_string(alias, "name");
                            let target_name = self.dci_canonical_type_name_text(
                                self.dci_json_string(alias, "target"));
                            if (alias_name.len > 0 && target_name.len > 0
                                && self.dci_plain_type_names_match(current, alias_name)) {
                                if (target_name == current) { return current; }
                                current = target_name;
                                changed = true;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                }
                root_i = root_i + 1;
            }
            if (!changed) { return current; }
            depth = depth + 1;
        }
        // Alias cycles are not a proof of ABI equivalence.
        return "";
    }

    public fn dci_shared_link_type_names_compatible(self, lhs: string, rhs: string) -> bool {
        if (lhs.len == 0 || rhs.len == 0) { return lhs == rhs; }
        let lhs_canonical = self.dci_shared_link_canonical_type_name(lhs);
        let rhs_canonical = self.dci_shared_link_canonical_type_name(rhs);
        return lhs_canonical.len > 0 && rhs_canonical.len > 0
            && lhs_canonical == rhs_canonical;
    }

    public fn dci_shared_link_json_item_equal(self,
                                               lhs: rawptr,
                                               rhs: rawptr,
                                               key: string) -> bool {
        let lhs_item = self.dci_json_item(lhs, key);
        let rhs_item = self.dci_json_item(rhs, key);
        if (lhs_item == null || rhs_item == null) { return lhs_item == rhs_item; }
        return cJSON_Compare(lhs_item, rhs_item, 1) != 0;
    }

    public fn dci_shared_link_type_items_compatible(self,
                                                     lhs: rawptr,
                                                     rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (cJSON_IsString(lhs) != 0 && cJSON_IsString(rhs) != 0) {
            let lhs_raw = cJSON_GetStringValue(lhs);
            let rhs_raw = cJSON_GetStringValue(rhs);
            if (lhs_raw == null || rhs_raw == null) { return false; }
            return self.dci_shared_link_type_names_compatible(from_cstr(lhs_raw), from_cstr(rhs_raw));
        }
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) { return false; }
        let lhs_name = self.dci_json_string(lhs, "name");
        let rhs_name = self.dci_json_string(rhs, "name");
        if (!self.dci_shared_link_type_names_compatible(lhs_name, rhs_name)) { return false; }
        if (!self.dci_shared_link_json_item_equal(lhs, rhs, "kind")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "reference")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "reference_kind")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "nullable")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "pointee_const")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "size")
            || !self.dci_shared_link_json_item_equal(lhs, rhs, "alignment")) {
            return false;
        }
        return self.dci_shared_link_type_names_compatible(
            self.dci_json_string(lhs, "enum_name"),
            self.dci_json_string(rhs, "enum_name"));
    }

    public fn dci_shared_link_source_value_contracts_compatible(self,
                                                                  lhs: rawptr,
                                                                  rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        // Return values may be represented by a JSON null node rather than a
        // missing property.  Preserve that distinction while accepting equal
        // null contracts for constructors and destructors.
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) {
            return cJSON_Compare(lhs, rhs, 1) != 0;
        }
        return self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "type"),
                                                           self.dci_json_item(rhs, "type"))
            && self.dci_shared_link_json_item_equal(lhs, rhs, "location")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "ownership");
    }

    public fn dci_shared_link_abi_value_lowerings_compatible(self,
                                                              lhs: rawptr,
                                                              rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (cJSON_IsObject(lhs) == 0 || cJSON_IsObject(rhs) == 0) { return false; }
        return self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "type"),
                                                           self.dci_json_item(rhs, "type"))
            && self.dci_shared_link_type_items_compatible(self.dci_json_item(lhs, "coerce_to"),
                                                           self.dci_json_item(rhs, "coerce_to"))
            && self.dci_shared_link_json_item_equal(lhs, rhs, "passing")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "alignment")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "size")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "attributes")
            && self.dci_shared_link_json_item_equal(lhs, rhs, "registers");
    }

    public fn dci_shared_link_receiver_contracts_compatible(self,
                                                              lhs_abi: rawptr,
                                                              rhs_abi: rawptr) -> bool {
        let lhs_receiver = self.dci_json_item(lhs_abi, "receiver");
        let rhs_receiver = self.dci_json_item(rhs_abi, "receiver");
        if (!self.dci_shared_link_abi_value_lowerings_compatible(lhs_receiver, rhs_receiver)) {
            return false;
        }
        return self.dci_shared_link_json_item_equal(lhs_receiver, rhs_receiver, "ownership")
            && self.dci_shared_link_json_item_equal(lhs_receiver, rhs_receiver, "this_adjust");
    }

    public fn dci_shared_link_hidden_parameters_compatible(self,
                                                             lhs_abi: rawptr,
                                                             rhs_abi: rawptr) -> bool {
        let lhs_hidden = self.dci_json_item(lhs_abi, "hidden_parameters");
        let rhs_hidden = self.dci_json_item(rhs_abi, "hidden_parameters");
        if (lhs_hidden == null || rhs_hidden == null) { return lhs_hidden == rhs_hidden; }
        if (cJSON_IsArray(lhs_hidden) == 0 || cJSON_IsArray(rhs_hidden) == 0) { return false; }
        let lhs_count = cJSON_GetArraySize(lhs_hidden);
        if (lhs_count != cJSON_GetArraySize(rhs_hidden)) { return false; }
        var i: i32 = 0;
        while (i < lhs_count) {
            if (!self.dci_shared_link_abi_value_lowerings_compatible(
                    cJSON_GetArrayItem(lhs_hidden, i), cJSON_GetArrayItem(rhs_hidden, i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn dci_shared_link_source_parameters_compatible(self,
                                                            lhs_function: i32,
                                                            rhs_function: i32) -> bool {
        let lhs_count = self.function_source_param_count(lhs_function);
        if (lhs_count != self.function_source_param_count(rhs_function)) { return false; }
        var i: i32 = 0;
        while (i < lhs_count) {
            if (!self.dci_shared_link_source_value_contracts_compatible(
                    self.dci_source_parameter_object(lhs_function, i),
                    self.dci_source_parameter_object(rhs_function, i))
                || !self.dci_shared_link_abi_value_lowerings_compatible(
                    self.dci_source_parameter_abi(lhs_function, i),
                    self.dci_source_parameter_abi(rhs_function, i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public fn dci_shared_link_abi_contracts_compatible(self,
                                                        lhs_function: i32,
                                                        rhs_function: i32) -> bool {
        let lhs_symbol = self.dci_symbol_object_for_function(lhs_function);
        let rhs_symbol = self.dci_symbol_object_for_function(rhs_function);
        if (lhs_symbol == null || rhs_symbol == null) { return false; }
        let lhs_abi = self.dci_json_item(lhs_symbol, "abi");
        let rhs_abi = self.dci_json_item(rhs_symbol, "abi");
        if (lhs_abi == null || rhs_abi == null
            || cJSON_IsObject(lhs_abi) == 0 || cJSON_IsObject(rhs_abi) == 0) {
            return false;
        }
        if (self.dci_symbol_link_name(lhs_symbol) != self.dci_symbol_link_name(rhs_symbol)
            || self.dci_symbol_calling_convention(lhs_symbol)
                != self.dci_symbol_calling_convention(rhs_symbol)
            || self.dci_json_string(lhs_symbol, "kind") != self.dci_json_string(rhs_symbol, "kind")
            || !self.dci_shared_link_type_names_compatible(
                self.dci_json_string(lhs_symbol, "owner"),
                self.dci_json_string(rhs_symbol, "owner"))
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "control_flow")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_static")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_virtual")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_override")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_final")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "is_const")
            || !self.dci_shared_link_json_item_equal(lhs_symbol, rhs_symbol, "this_adjust")
            || !self.dci_shared_link_json_item_equal(lhs_abi, rhs_abi, "variadic")
            || !self.dci_shared_link_json_item_equal(lhs_abi, rhs_abi, "unwind")) {
            return false;
        }
        return self.dci_shared_link_receiver_contracts_compatible(lhs_abi, rhs_abi)
            && self.dci_shared_link_source_parameters_compatible(lhs_function, rhs_function)
            && self.dci_shared_link_source_value_contracts_compatible(
                self.dci_json_item(lhs_symbol, "return"),
                self.dci_json_item(rhs_symbol, "return"))
            && self.dci_shared_link_abi_value_lowerings_compatible(
                self.dci_json_item(lhs_abi, "return"),
                self.dci_json_item(rhs_abi, "return"))
            && self.dci_shared_link_hidden_parameters_compatible(lhs_abi, rhs_abi);
    }

    public fn dci_shared_symbol_contracts_compatible(self,
                                                      lhs_function: i32,
                                                      rhs_function: i32) -> bool {
        let lhs_dci = self.function_is_foreign_dci(lhs_function);
        let rhs_dci = self.function_is_foreign_dci(rhs_function);
        if (lhs_dci != rhs_dci) { return false; }
        if (!lhs_dci) { return true; }
        return self.dci_shared_link_abi_contracts_compatible(lhs_function, rhs_function);
    }

    public fn bind_existing_function_symbol(self,
                                             function_id: i32,
                                             symbol: string,
                                             expected_type: rawptr) -> i32 {
        if (function_id == mir_id_invalid() || symbol.len == 0 || expected_type == null) { return 0; }
        let indexed = llvm_mir_symbol_index_get(self.function_symbol_index,
                                                self.function_symbol_index_cap,
                                                symbol);
        if (indexed != mir_id_invalid() && indexed != function_id) {
            let indexed_value = llvm_mir_map_get(self.function_values, indexed);
            let indexed_type = llvm_mir_map_get(self.function_types, indexed);
            if (indexed_value != null && indexed_type != null) {
                if (indexed_type != expected_type
                    || !self.dci_shared_symbol_contracts_compatible(function_id, indexed)) {
                    self.report_error("conflicting function contracts for shared link symbol `"
                              + symbol + "`");
                    return -1;
                }
                llvm_mir_map_put(self.function_values, function_id, indexed_value);
                llvm_mir_map_put(self.function_types, function_id, indexed_type);
                return 1;
            }
        } else if (indexed == function_id
            || (indexed == mir_id_invalid()
                && self.function_symbol_index != null
                && self.m.function_count < self.function_symbol_index_cap)) {
            // Every declaration path records its symbol only after both LLVM
            // maps are populated. Under the non-full exact index, a miss
            // therefore proves there is no prior compatible declaration.
            // indexed == this function is the same fact: we already own the
            // first slot, so the prefix walk cannot find an earlier bind.
            return 0;
        }
        var cur: i32 = 1;
        while (cur < function_id) {
            if (self.function_symbol_name(cur) == symbol) {
                let existing_value = llvm_mir_map_get(self.function_values, cur);
                let existing_type = llvm_mir_map_get(self.function_types, cur);
                if (existing_value != null && existing_type != null) {
                    if (existing_type != expected_type
                        || !self.dci_shared_symbol_contracts_compatible(function_id, cur)) {
                        self.report_error("conflicting function contracts for shared link symbol `"
                                  + symbol + "`");
                        return -1;
                    }
                    llvm_mir_map_put(self.function_values, function_id, existing_value);
                    llvm_mir_map_put(self.function_types, function_id, existing_type);
                    return 1;
                }
            }
            cur = cur + 1;
        }
        return 0;
    }

    public fn declare_functions(self) {
        var fn_id: i32 = self.declared_function_scan_next;
        if (fn_id < 1) { fn_id = 1; }
        while (fn_id <= self.m.function_count) {
            let temp_string_mark = vyx_rt_string_arena_checkpoint();
            if (self.function_should_emit(fn_id)) {
                if (self.function_is_foreign_dci(fn_id)
                    && self.function_name_is_foreign_dci_instance(fn_id)) {
                    // Record the closed instance for the Active Adapter, and
                    // first the consumer-declared records it is closed over:
                    // those are definitions the producer has never seen, and
                    // without them it cannot even name the instance.
                    self.dci_local_emit_open_support(fn_id);
                    g_dci_open_requests = g_dci_open_requests
                                          + self.dci_open_request_line(fn_id) + "\n";
                }
                if (vyx_bootstrap_profile_level() > 0
                    && ((fn_id % 100) == 0 || fn_id >= 900)) {
                    print("[llvm-mir-declare] before fn="
                          + policy_i64_to_string(fn_id as i64)
                          + " name=" + self.m.function_name(fn_id));
                }
                self.declare_function_signature(fn_id);
                if (vyx_bootstrap_profile_level() > 0
                    && ((fn_id % 100) == 0 || fn_id >= 900)) {
                    print("[llvm-mir-declare] after fn="
                          + policy_i64_to_string(fn_id as i64)
                          + " errors=" + policy_i64_to_string(self.error_count as i64));
                }
            }
            self.release_temp_strings(temp_string_mark);
            fn_id = fn_id + 1;
        }
        self.declared_function_scan_next = self.m.function_count + 1;
    }

    public fn build_function_value_adapter_type(self, function_id: i32) -> rawptr {
        let source_count = self.function_source_param_count(function_id);
        let total = source_count + 1;
        var params: rawptr = null;
        if (total > 0) {
            params = malloc((total * 8) as u64);
            if (params == null) {
                self.report_error("cannot allocate function-value adapter signature for " + self.m.function_name(function_id));
                return null;
            }
        }
        ast_write_rawptr(params, self.ty_ptr);
        var out_idx: i32 = 1;
        var source_idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) {
                if (self.source_param_uses_self_pointer_abi(function_id, source_idx)) {
                    ast_write_rawptr(ptr_offset(params, out_idx * 8), self.ty_ptr);
                } else {
                    ast_write_rawptr(ptr_offset(params, out_idx * 8), self.lower_type(self.local_effective_type(local)));
                }
                out_idx = out_idx + 1;
                source_idx = source_idx + 1;
            }
            local = self.m.local_next(local);
        }
        let fty = vyx_rt_fn_type(self.mod,
                                 self.lower_type(self.m.function_return_type(function_id)),
                                 params,
                                 total as u64,
                                 0);
        if (params != null) { free(params); }
        return fty;
    }

    /// A function-value adapter is entered through the closure fat ABI, whose
    /// signature exposes the *logical* parameter types and returns the logical
    /// result.  The target it forwards to may have a different machine shape:
    /// a large return becomes a hidden `sret` pointer and a large parameter is
    /// passed indirectly.  Callers therefore cannot forward their own incoming
    /// arguments verbatim; they must rebuild them in the target's LLVM order
    /// and materialize the hidden ones.  This is true exactly when those two
    /// shapes diverge.
    public fn function_value_adapter_needs_abi_marshal(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_uses_hidden_sret(function_id)) { return true; }
        var index: i32 = 0;
        while (index < self.function_source_param_count(function_id)) {
            if (self.source_param_uses_native_byval_abi(function_id, index)
                && !self.source_param_uses_self_pointer_abi(function_id, index)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public fn emit_function_value_adapter_body(self, function_id: i32, adapter_fn: rawptr, adapter_type: rawptr) {
        let target_fn = llvm_mir_map_get(self.function_values, function_id);
        let target_type = llvm_mir_map_get(self.function_types, function_id);
        if (target_fn == null || target_type == null || adapter_fn == null || adapter_type == null) {
            self.report_error("cannot emit function-value adapter for " + self.m.function_name(function_id));
            return;
        }
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let name = self.function_symbol_name(function_id) + "$fn_value_adapter.entry";
        let bb = vyx_rt_append_block(self.mod, adapter_fn, name.c_str(), name.len as u64);
        if (bb == null) {
            self.report_error("cannot create function-value adapter block for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let source_count = self.function_source_param_count(function_id);
        if (self.dci_module_default_shared_abi()) { llvm_unwind_prepare_adapter(self.mod, adapter_fn, self.target_triple); }
        // Incoming parameters start at LLVM index 1: index 0 is the hidden
        // closure-environment pointer of the fat closure ABI.
        var incoming: rawptr = null;
        if (source_count > 0) {
            incoming = malloc((source_count * 8) as u64);
            if (incoming == null) {
                self.report_error("cannot allocate function-value adapter arguments for " + self.m.function_name(function_id));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            var read_index: i32 = 0;
            while (read_index < source_count) {
                let param = vyx_rt_get_param(self.mod, adapter_fn, (read_index + 1) as u64);
                if (param == null) {
                    free(incoming);
                    self.report_error("cannot read function-value adapter parameter #" + policy_i64_to_string(read_index as i64)
                              + " for " + self.m.function_name(function_id));
                    if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                    return;
                }
                ast_write_rawptr(ptr_offset(incoming, read_index * 8), param);
                read_index = read_index + 1;
            }
        }
        let ret_type = self.m.function_return_type(function_id);
        let uses_sret = self.function_uses_hidden_sret(function_id);
        if (uses_sret && self.dci_member_sret_after_receiver(function_id)) {
            if (incoming != null) { free(incoming); }
            self.report_error("cannot emit function-value adapter for " + self.m.function_name(function_id)
                      + ": receiver-prefixed sret return is unsupported");
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var marshal_ok: bool = true;
        var slot_count: i32 = source_count;
        if (uses_sret) { slot_count = slot_count + 1; }
        var args: rawptr = null;
        if (slot_count > 0) {
            args = malloc((slot_count * 8) as u64);
            if (args == null) {
                if (incoming != null) { free(incoming); }
                self.report_error("cannot allocate function-value adapter forwarding arguments for " + self.m.function_name(function_id));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
        }
        var out_index: i32 = 0;
        var sret_slot: rawptr = null;
        if (uses_sret) {
            let sret_storage = self.lower_storage_type(ret_type);
            if (sret_storage == null) {
                marshal_ok = false;
            } else {
                sret_slot = vyx_rt_build_alloca(self.mod, sret_storage, "mir.fn.adapter.sret".c_str(), 19);
                var sret_align = self.native_aggregate_align_bytes(ret_type);
                if (sret_align <= 0) { sret_align = 8; }
                if (sret_slot == null) {
                    marshal_ok = false;
                } else {
                    vyx_rt_set_alignment(self.mod, sret_slot, sret_align as i32);
                }
            }
            if (!marshal_ok) {
                if (incoming != null) { free(incoming); }
                if (args != null) { free(args); }
                self.report_error("cannot materialize function-value adapter return slot for " + self.m.function_name(function_id));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            ast_write_rawptr(ptr_offset(args, out_index * 8), sret_slot);
            out_index = out_index + 1;
        }
        var source_index: i32 = 0;
        while (source_index < source_count && marshal_ok) {
            let forwarded = ast_read_rawptr(ptr_offset(incoming, source_index * 8));
            if (self.source_param_uses_native_byval_abi(function_id, source_index)
                && !self.source_param_uses_self_pointer_abi(function_id, source_index)) {
                // The target expects a pointer to the aggregate; the adapter
                // received it by value, so spill it to a slot first.
                let param_type = self.function_source_param_type(function_id, source_index);
                let storage = self.lower_storage_type(param_type);
                var byval_align = self.native_aggregate_align_bytes(param_type);
                if (byval_align <= 0) { byval_align = 8; }
                var slot: rawptr = null;
                if (storage != null && forwarded != null) {
                    slot = vyx_rt_build_alloca(self.mod, storage, "mir.fn.adapter.byval".c_str(), 20);
                } else {
                    marshal_ok = false;
                }
                if (marshal_ok && slot == null) { marshal_ok = false; }
                if (marshal_ok) {
                    vyx_rt_set_alignment(self.mod, slot, byval_align as i32);
                    vyx_rt_build_store(self.mod, forwarded, slot);
                    ast_write_rawptr(ptr_offset(args, out_index * 8), slot);
                    out_index = out_index + 1;
                }
            } else {
                ast_write_rawptr(ptr_offset(args, out_index * 8), forwarded);
                out_index = out_index + 1;
            }
            source_index = source_index + 1;
        }
        if (incoming != null) { free(incoming); }
        if (!marshal_ok) {
            if (args != null) { free(args); }
            self.report_error("cannot marshal function-value adapter arguments for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var call_name = "mir.fn.adapter.call";
        let target_returns_void = uses_sret
            || llvm_mir_type_kind(&self.m, ret_type) == ty_VOID();
        if (target_returns_void) { call_name = ""; }
        var result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_fn,
                                       args,
                                       slot_count as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        if (result != null && self.function_value_adapter_needs_abi_marshal(function_id)) {
            if (!self.apply_native_c_aggregate_abi_attrs(function_id, result)) { result = null; }
        }
        if (llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
        } elif (uses_sret) {
            let return_storage = self.lower_storage_type(ret_type);
            let loaded = vyx_rt_build_load(self.mod, return_storage, sret_slot, "mir.fn.adapter.ret".c_str(), 18);
            if (loaded == null) {
                self.report_error("cannot emit function-value adapter return for " + self.m.function_name(function_id));
            } else {
                vyx_rt_build_ret(self.mod, loaded);
            }
        } elif (result != null) {
            vyx_rt_build_ret(self.mod, result);
        } else {
            self.report_error("cannot emit function-value adapter return for " + self.m.function_name(function_id));
        }
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
    }

    public fn compute_adapter_need_cache(self) {
        if (self.adapter_need_cache_ready) { return; }
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.m.value_kind(value_id) == mir_value_call()) {
                let callee = self.m.value_lhs(value_id);
                if (callee != mir_id_invalid()
                    && self.m.value_target_kind(value_id) == mir_target_function()) {
                    llvm_mir_i32_map_put(self.direct_call_callee_value_map, callee, 2);
                }
            }
            value_id = value_id + 1;
        }
        value_id = 1;
        while (value_id <= self.m.value_count) {
            let target_kind = self.m.value_target_kind(value_id);
            let target_id = self.m.value_target_id(value_id);
            if (target_kind == mir_target_function() && target_id != mir_id_invalid()) {
                if (self.type_is_fn_abi_destination(self.m.value_type(value_id))
                    && llvm_mir_i32_map_get(self.direct_call_callee_value_map, value_id) != 2) {
                    llvm_mir_i32_map_put(self.function_value_adapter_need_map, target_id, 2);
                }
            }
            if (self.m.value_kind(value_id) == mir_value_cast()
                && self.type_is_raw_callback_scalar_target(self.m.value_type(value_id))) {
                let lhs = self.m.value_lhs(value_id);
                if (lhs != mir_id_invalid()
                    && self.m.value_kind(lhs) == mir_value_target_ref()
                    && self.m.value_target_kind(lhs) == mir_target_function()) {
                    llvm_mir_i32_map_put(self.raw_callback_adapter_use_map,
                                         self.m.value_target_id(lhs),
                                         2);
                }
            }
            value_id = value_id + 1;
        }
        self.adapter_need_cache_ready = true;
    }

    public fn function_needs_value_adapter(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        self.compute_adapter_need_cache();
        return llvm_mir_i32_map_get(self.function_value_adapter_need_map, function_id) == 2;
    }

    public fn value_is_direct_call_callee(self, callee_value_id: i32) -> bool {
        if (callee_value_id == mir_id_invalid()) { return false; }
        self.compute_adapter_need_cache();
        return llvm_mir_i32_map_get(self.direct_call_callee_value_map, callee_value_id) == 2;
    }

    public fn declare_function_value_adapters(self) {
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            self.declare_function_value_adapter_for(fn_id);
            fn_id = fn_id + 1;
        }
    }

    public fn declare_function_value_adapter_for(self, fn_id: i32) {
        let temp_string_mark = vyx_rt_string_arena_checkpoint();
        if (self.function_can_be_declared(fn_id) && self.function_needs_value_adapter(fn_id)) {
            if (llvm_mir_map_get(self.function_closure_adapter_values, fn_id) != null) {
                self.release_temp_strings(temp_string_mark);
                return;
            }
            self.declare_function_signature(fn_id);
            let fn_value = llvm_mir_map_get(self.function_values, fn_id);
            if (fn_value == null) {
                self.report_error("cannot declare function-value target " + self.m.function_name(fn_id));
                self.release_temp_strings(temp_string_mark);
                return;
            }
            if (self.function_hidden_env_param_count(fn_id) > 0) {
                llvm_mir_map_put(self.function_closure_adapter_values, fn_id, fn_value);
            } else {
                let adapter_type = self.build_function_value_adapter_type(fn_id);
                if (adapter_type != null) {
                    let name = self.function_symbol_name(fn_id)
                        + "$fn_value_adapter$"
                        + policy_mangle_part(self.module_symbol_name);
                    let adapter_fn = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, adapter_type);
                    if (adapter_fn == null) {
                        self.report_error("cannot declare function-value adapter " + name);
                    } else {
                        vyx_rt_set_linkage(self.mod, adapter_fn, 1);
                        llvm_mir_map_put(self.function_closure_adapter_values, fn_id, adapter_fn);
                        self.emit_function_value_adapter_body(fn_id, adapter_fn, adapter_type);
                    }
                }
            }
        }
        self.release_temp_strings(temp_string_mark);
    }

    public fn raw_callback_adapter_type(self) -> rawptr {
        let params = malloc(8);
        if (params == null) {
            self.report_error("cannot allocate raw callback adapter signature");
            return null;
        }
        ast_write_rawptr(params, self.ty_ptr);
        let fty = vyx_rt_fn_type(self.mod, self.ty_i32, params, 1, 0);
        free(params);
        return fty;
    }

    public fn function_raw_callback_return_compatible(self, function_id: i32) -> bool {
        let ret_kind = llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id));
        return ret_kind == ty_I32() || ret_kind == ty_U32();
    }

    public fn type_can_receive_raw_callback_context(self, type_id: i32) -> bool {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return true; }
        return llvm_mir_int_bits_for_kind(kind) > 0;
    }

    public fn function_is_raw_callback_abi_compatible(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_hidden_env_param_count(function_id) != 0) { return false; }
        if (self.function_source_param_count(function_id) != 1) { return false; }
        let param_type = self.function_source_param_type(function_id, 0);
        if (!self.type_can_receive_raw_callback_context(param_type)) { return false; }
        return self.function_raw_callback_return_compatible(function_id);
    }

    public fn function_can_use_raw_callback_adapter(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_hidden_env_param_count(function_id) != 0) { return false; }
        let source_count = self.function_source_param_count(function_id);
        if (source_count == 0) { return true; }
        if (source_count == 1) {
            return self.type_can_receive_raw_callback_context(self.function_source_param_type(function_id, 0));
        }
        return false;
    }

    public fn type_is_raw_callback_scalar_target(self, type_id: i32) -> bool {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        // Integer casts are the legacy thread/fiber callback shorthand.  A
        // pointer cast asks for the function's real address and must not be
        // rewritten to the canonical (rawptr) -> i32 adapter signature.
        return llvm_mir_int_bits_for_kind(kind) > 0;
    }

    public fn function_has_raw_callback_scalar_cast_use(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        self.compute_adapter_need_cache();
        return llvm_mir_i32_map_get(self.raw_callback_adapter_use_map, function_id) == 2;
    }

    public fn function_needs_raw_callback_adapter(self, function_id: i32) -> bool {
        if (!self.function_has_raw_callback_scalar_cast_use(function_id)) { return false; }
        return !self.function_is_raw_callback_abi_compatible(function_id);
    }

    public fn emit_raw_callback_adapter_body(self, function_id: i32, adapter_fn: rawptr, adapter_type: rawptr) {
        let target_fn = llvm_mir_map_get(self.function_values, function_id);
        let target_type = llvm_mir_map_get(self.function_types, function_id);
        if (target_fn == null || target_type == null || adapter_fn == null || adapter_type == null) {
            self.report_error("cannot emit raw callback adapter for " + self.m.function_name(function_id));
            return;
        }
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let name = self.function_symbol_name(function_id) + "$raw_callback_adapter.entry";
        let bb = vyx_rt_append_block(self.mod, adapter_fn, name.c_str(), name.len as u64);
        if (bb == null) {
            self.report_error("cannot create raw callback adapter block for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let source_count = self.function_source_param_count(function_id);
        var args: rawptr = null;
        if (self.dci_module_default_shared_abi()) { llvm_unwind_prepare_adapter(self.mod, adapter_fn, self.target_triple); }
        if (source_count > 0) {
            args = malloc((source_count * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate raw callback adapter arguments for " + self.m.function_name(function_id));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
        }
        if (source_count == 1) {
            let ctx_param = vyx_rt_get_param(self.mod, adapter_fn, 0);
            let rawptr_type = self.type_id_by_text("rawptr");
            let target_param_type = self.function_source_param_type(function_id, 0);
            let ctx_arg = self.cast_value(ctx_param, rawptr_type, target_param_type);
            if (ctx_param == null || rawptr_type == mir_id_invalid() || target_param_type == mir_id_invalid() || ctx_arg == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower raw callback context for " + self.m.function_name(function_id));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            ast_write_rawptr(args, ctx_arg);
        } else if (source_count != 0) {
            if (args != null) { free(args); }
            self.report_error("raw callback adapter requires zero or one source parameter for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var call_name = "mir.raw.callback.call";
        let ret_type = self.m.function_return_type(function_id);
        let ret_kind = llvm_mir_type_kind(&self.m, ret_type);
        if (ret_kind == ty_VOID()) { call_name = ""; }
        let result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_fn,
                                       args,
                                       source_count as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        if (ret_kind == ty_VOID()) {
            vyx_rt_build_ret(self.mod, vyx_rt_const_int(self.mod, self.ty_i32, 0, 0));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        let ret_bits = llvm_mir_int_bits_for_kind(ret_kind);
        if (ret_bits <= 0 || result == null) {
            self.report_error("raw callback adapter return must be void or integer for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        let out = self.int_value_to_bits(result, ret_type, 32);
        if (out == null) {
            self.report_error("cannot lower raw callback return for " + self.m.function_name(function_id));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_build_ret(self.mod, out);
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
    }

    public fn declare_raw_callback_adapters(self) {
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            self.declare_raw_callback_adapter_for(fn_id);
            fn_id = fn_id + 1;
        }
    }

    public fn declare_raw_callback_adapter_for(self, fn_id: i32) {
        let temp_string_mark = vyx_rt_string_arena_checkpoint();
        if (self.function_can_be_declared(fn_id) && self.function_needs_raw_callback_adapter(fn_id)) {
            if (llvm_mir_map_get(self.function_raw_callback_adapter_values, fn_id) != null) {
                self.release_temp_strings(temp_string_mark);
                return;
            }
            if (!self.function_can_use_raw_callback_adapter(fn_id)) {
                self.report_error("cannot expose " + self.m.function_name(fn_id) + " as raw callback");
            } else {
                self.declare_function_signature(fn_id);
                if (llvm_mir_map_get(self.function_values, fn_id) == null) {
                    self.report_error("cannot declare raw callback target " + self.m.function_name(fn_id));
                    self.release_temp_strings(temp_string_mark);
                    return;
                }
                let adapter_type = self.raw_callback_adapter_type();
                if (adapter_type != null) {
                    let name = self.function_symbol_name(fn_id)
                        + "$raw_callback_adapter$"
                        + policy_mangle_part(self.module_symbol_name);
                    let adapter_fn = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, adapter_type);
                    if (adapter_fn == null) {
                        self.report_error("cannot declare raw callback adapter " + name);
                    } else {
                        vyx_rt_set_linkage(self.mod, adapter_fn, 1);
                        llvm_mir_map_put(self.function_raw_callback_adapter_values, fn_id, adapter_fn);
                        self.emit_raw_callback_adapter_body(fn_id, adapter_fn, adapter_type);
                    }
                }
            }
        }
        self.release_temp_strings(temp_string_mark);
    }

    public fn declare_blocks_for_function(self, function_id: i32) {
        let temp_string_mark = vyx_rt_string_arena_checkpoint();
        if (!self.function_should_emit(function_id)) {
            self.release_temp_strings(temp_string_mark);
            return;
        }
        let fn_value = llvm_mir_map_get(self.function_values, function_id);
        var block = mir_unit_function_first_block(&self.m, function_id);
        while (block != mir_id_invalid()) {
            let name = "mir.bb." + policy_i64_to_string(block as i64);
            let bb = vyx_rt_append_block(self.mod, fn_value, name.c_str(), name.len as u64);
            if (bb == null) {
                self.report_error("cannot create LLVM block " + name);
            } else {
                llvm_mir_map_put(self.block_values, block, bb);
            }
            block = mir_unit_block_next(&self.m, block);
        }
        self.release_temp_strings(temp_string_mark);
    }

    public fn record_type_bases_match(self, src_type_id: i32, dst_type_id: i32) -> bool {
        if (src_type_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return false; }
        let src_text = llvm_mir_type_text(&self.m, src_type_id);
        let dst_text = llvm_mir_type_text(&self.m, dst_type_id);
        if (src_text.len == 0 || dst_text.len == 0) { return false; }
        let src_base = policy_generic_call_base(src_text.clone());
        let dst_base = policy_generic_call_base(dst_text.clone());
        return self.last_path_segment(src_base) == self.last_path_segment(dst_base);
    }

    public fn record_types_structurally_compatible(self, src_type_id: i32, dst_type_id: i32) -> bool {
        if (src_type_id == dst_type_id) { return true; }
        if (src_type_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, src_type_id) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, dst_type_id) != ty_CLASS()) {
            return false;
        }
        if (!self.record_type_bases_match(src_type_id, dst_type_id)) { return false; }
        let src_count = mir_unit_field_count_for_type(&self.m, src_type_id);
        let dst_count = mir_unit_field_count_for_type(&self.m, dst_type_id);
        if (src_count != dst_count) { return false; }
        var idx: i32 = 0;
        while (idx < src_count) {
            let src_field = mir_unit_field_id_for_type_index(&self.m, src_type_id, idx);
            let dst_field = mir_unit_field_id_for_type_index(&self.m, dst_type_id, idx);
            if (src_field == mir_id_invalid() || dst_field == mir_id_invalid()) { return false; }
            if (mir_unit_field_name(&self.m, src_field) != mir_unit_field_name(&self.m, dst_field)) { return false; }
            if (!self.type_ids_compatible(mir_unit_field_type(&self.m, src_field),
                                          mir_unit_field_type(&self.m, dst_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn rebuild_record_value_as(self, value: rawptr, src_type_id: i32, dst_type_id: i32) -> rawptr {
        if (value == null) { return null; }
        if (!self.record_types_structurally_compatible(src_type_id, dst_type_id)) { return null; }
        // Do not extractvalue MIR fields. After the unique C aggregate ABI,
        // class values may be pointers (method self) or DCI size/align blobs
        // (`{ i64, [N x i8] }`). extractvalue of field indices aborts in LLVM.
        // Compatible records share storage; a bitcast-equivalent identity is
        // enough for both native value structs and foreign DCI layouts.
        return value;
    }

    public fn cast_value(self, value: rawptr, src_type_id: i32, dst_type_id: i32) -> rawptr {
        if (value == null) { return null; }
        if (src_type_id == dst_type_id || dst_type_id == mir_id_invalid()) { return value; }
        if (src_type_id == mir_id_invalid()) {
            self.report_error("cannot cast value with unresolved source type to " + llvm_mir_type_text(&self.m, dst_type_id));
            return null;
        }
        // Same-text types are the same declared type registered twice (e.g.
        // Result<i32,E> inside a generic method body vs. its instantiated
        // return type).  Identical text means identical layout: pass the
        // value through instead of entering the record/DCI adjustment paths,
        // which return null for this identity shape.  (type_ids_compatible
        // already treats text equality as compatibility for the same reason;
        // note DCI derives-from must NOT take this shortcut.)
        if (llvm_mir_type_text(&self.m, src_type_id) == llvm_mir_type_text(&self.m, dst_type_id)) {
            return value;
        }
        let src_kind0 = llvm_mir_type_kind(&self.m, src_type_id);
        let dst_kind0 = llvm_mir_type_kind(&self.m, dst_type_id);
        let src_handle0 = llvm_mir_kind_pointer_handle(src_kind0);
        let dst_handle0 = llvm_mir_kind_pointer_handle(dst_kind0);
        if (src_handle0 && dst_handle0) {
            let src_handle_record = self.class_pointer_abi_record_type(src_type_id);
            let dst_handle_record = self.class_pointer_abi_record_type(dst_type_id);
            if (src_handle_record == mir_id_invalid()
                || dst_handle_record == mir_id_invalid()
                || src_handle_record == dst_handle_record) {
                return value;
            }
        } else {
            if (src_handle0 && dst_kind0 == ty_RAWPTR()) {
                return self.pointer_handle_address(value, "mir.cast.ptr");
            }
            if (dst_handle0 && src_kind0 == ty_RAWPTR()) {
                // An effective-rawptr value can already be a materialized
                // pointer handle (address_of always builds one).  Re-wrap its
                // own address + region metadata; feeding the handle struct to
                // the region-create call fails the runtime argument type
                // check and silently nulls the whole cast.
                if (vyx_rt_value_is_struct(value) != 0) {
                    let wrap_addr = self.pointer_handle_address(value, "mir.cast.ptr");
                    if (wrap_addr == null) { return null; }
                    let wrap_meta = self.pointer_handle_metadata(value, "mir.cast.ptr");
                    return self.build_pointer_handle(wrap_addr, wrap_meta, "mir.cast.ptr");
                }
                return self.pointer_handle_from_raw(value,
                                                    hir_type_table_elem(self.m.types, dst_type_id),
                                                    0,
                                                    0,
                                                    "mir.cast.ptr");
            }
        }
        let src_class_ptr_record = self.class_pointer_abi_record_type(src_type_id);
        let dst_class_ptr_record = self.class_pointer_abi_record_type(dst_type_id);
        if (src_class_ptr_record != mir_id_invalid() && dst_class_ptr_record != mir_id_invalid()) {
            if (src_class_ptr_record == dst_class_ptr_record) { return value; }
            let src_handle = llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, src_type_id));
            let dst_handle = llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, dst_type_id));
            var cast_input = value;
            var cast_metadata: rawptr = null;
            if (src_handle) {
                cast_input = self.pointer_handle_address(value, "mir.dci.cast");
                cast_metadata = self.pointer_handle_metadata(value, "mir.dci.cast");
                if (cast_input == null || cast_metadata == null) { return null; }
            }
            var cast_output: rawptr = null;
            if (self.type_is_foreign_dci(src_class_ptr_record)
                && self.type_is_foreign_dci(dst_class_ptr_record)) {
                if (self.dci_type_derives_from(src_class_ptr_record, dst_class_ptr_record)) {
                    cast_output = self.adjust_dci_base_pointer(cast_input,
                                                               src_class_ptr_record,
                                                               dst_class_ptr_record,
                                                               "dci.cast.base");
                } else {
                    cast_output = self.lower_dci_runtime_pointer_cast(cast_input,
                                                                      src_type_id,
                                                                      dst_type_id,
                                                                      src_class_ptr_record,
                                                                      dst_class_ptr_record);
                }
            } else {
                cast_output = self.adjust_dci_base_pointer(cast_input,
                                                           src_class_ptr_record,
                                                           dst_class_ptr_record,
                                                           "dci.cast.base");
            }
            if (cast_output == null) { return null; }
            if (src_handle && dst_handle) {
                return self.build_pointer_handle(cast_output,
                                                 cast_metadata,
                                                 "mir.dci.cast");
            }
            if (dst_handle) {
                return self.pointer_handle_from_foreign_raw(cast_output, "mir.dci.cast");
            }
            return cast_output;
        }
        let src_kind = llvm_mir_type_kind(&self.m, src_type_id);
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type_id);
        if (dst_kind == ty_VOID()) { return null; }
        let src_bits = llvm_mir_int_bits_for_kind(src_kind);
        let dst_bits = llvm_mir_int_bits_for_kind(dst_kind);
        let src_float_bits = llvm_mir_float_bits_for_kind(src_kind);
        let dst_float_bits = llvm_mir_float_bits_for_kind(dst_kind);
        // Reference view reads: a `&mut T` / `&T` value used where a scalar
        // or float is expected loads through the reference (C++ reference
        // semantics).  Raw pointers (`*T`) never auto-deref here — they stay
        // addresses/handles.
        if ((src_kind == ty_MUTREF() || src_kind == ty_REF())
            && (dst_bits > 0 || dst_float_bits > 0)) {
            let view_elem = hir_type_table_elem(self.m.types, src_type_id);
            if (view_elem != mir_id_invalid()) {
                let view_addr = self.pointer_handle_address(value, "mir.ref.view");
                if (view_addr != null) {
                    let view_st = self.lower_storage_type(view_elem);
                    if (view_st != null) {
                        let view_loaded = vyx_rt_build_load(self.mod, view_st, view_addr, llvm_mir_empty_name(), 0);
                        if (view_loaded != null) {
                            return self.cast_value(view_loaded, view_elem, dst_type_id);
                        }
                    }
                }
            }
        }
        if (self.type_is_plain_enum_abi(src_type_id) && dst_bits > 0) {
            let tag = self.enum_tag_value(value, src_type_id);
            if (tag == null) {
                self.report_error("cannot cast enum " + llvm_mir_type_text(&self.m, src_type_id) + " to integer");
                return null;
            }
            if (dst_bits == 32) { return tag; }
            let dst_ty = self.int_type_for_bits(dst_bits);
            if (dst_bits < 32) { return vyx_rt_build_trunc(self.mod, tag, dst_ty, llvm_mir_empty_name(), 0); }
            if (llvm_mir_kind_unsigned(dst_kind)) { return vyx_rt_build_zext(self.mod, tag, dst_ty, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_sext(self.mod, tag, dst_ty, llvm_mir_empty_name(), 0);
        }
        if (src_float_bits > 0 && dst_float_bits > 0) {
            if (src_float_bits == dst_float_bits) { return value; }
            let dst_ty = self.lower_type(dst_type_id);
            if (src_float_bits < dst_float_bits) {
                return vyx_rt_build_fp_ext(self.mod, value, dst_ty, llvm_mir_empty_name(), 0);
            }
            return vyx_rt_build_fp_trunc(self.mod, value, dst_ty, llvm_mir_empty_name(), 0);
        }
        if (src_bits > 0 && dst_float_bits > 0) {
            return vyx_rt_build_si_to_fp(self.mod, value, self.lower_type(dst_type_id), llvm_mir_empty_name(), 0);
        }
        if (src_float_bits > 0 && dst_bits > 0) {
            return vyx_rt_build_fp_to_si(self.mod, value, self.int_type_for_bits(dst_bits), llvm_mir_empty_name(), 0);
        }
        if (src_bits > 0 && dst_bits > 0) {
            if (src_bits == dst_bits) { return value; }
            let dst_ty = self.int_type_for_bits(dst_bits);
            if (src_bits > dst_bits) { return vyx_rt_build_trunc(self.mod, value, dst_ty, llvm_mir_empty_name(), 0); }
            if (llvm_mir_kind_unsigned(src_kind)) { return vyx_rt_build_zext(self.mod, value, dst_ty, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_sext(self.mod, value, dst_ty, llvm_mir_empty_name(), 0);
        }
        let src_handle2 = llvm_mir_kind_pointer_handle(src_kind);
        let dst_handle2 = llvm_mir_kind_pointer_handle(dst_kind);
        var pointer_scalar = value;
        if (src_handle2) {
            pointer_scalar = self.pointer_handle_address(value, "mir.cast");
            if (pointer_scalar == null) { return null; }
        }
        if (llvm_mir_kind_pointer_like(src_kind) && dst_bits > 0) {
            return vyx_rt_build_ptr_to_int(self.mod, pointer_scalar, self.int_type_for_bits(dst_bits), llvm_mir_empty_name(), 0);
        }
        if (src_bits > 0 && llvm_mir_kind_pointer_like(dst_kind)) {
            var as_int = value;
            if (src_bits < 64) { as_int = vyx_rt_build_zext(self.mod, value, self.ty_i64, llvm_mir_empty_name(), 0); }
            if (src_bits > 64) { as_int = vyx_rt_build_trunc(self.mod, value, self.ty_i64, llvm_mir_empty_name(), 0); }
            let raw_from_int = vyx_rt_build_int_to_ptr(self.mod, as_int, self.ty_ptr, llvm_mir_empty_name(), 0);
            if (dst_handle2) {
                return self.pointer_handle_from_raw(raw_from_int,
                                                    hir_type_table_elem(self.m.types, dst_type_id),
                                                    0,
                                                    0,
                                                    "mir.cast.int");
            }
            return raw_from_int;
        }
        if (llvm_mir_kind_pointer_like(src_kind) && llvm_mir_kind_pointer_like(dst_kind)) {
            if (src_handle2 && dst_handle2) { return value; }
            if (src_handle2) { return pointer_scalar; }
            if (dst_handle2) {
                return self.pointer_handle_from_raw(value,
                                                    hir_type_table_elem(self.m.types, dst_type_id),
                                                    0,
                                                    0,
                                                    "mir.cast.ptr");
            }
            return value;
        }
        if (src_kind == ty_CLASS() && dst_kind == ty_CLASS()) {
            let rebuilt = self.rebuild_record_value_as(value, src_type_id, dst_type_id);
            if (rebuilt != null) { return rebuilt; }
        }
        if (dst_kind == ty_CLASS()) { return value; }
        return value;
    }

    public fn truthy_value(self, value: rawptr, type_id: i32) -> rawptr {
        if (value == null) { return null; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits == 1) { return value; }
        if (bits > 0) {
            let v = self.cast_value(value, type_id, type_id);
            let zero = vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), 0, 0);
            return vyx_rt_build_icmp(self.mod, llvm_mir_icmp_ne(), v, zero, llvm_mir_empty_name(), 0);
        }
        if (llvm_mir_kind_float(kind)) {
            let zero_f = vyx_rt_const_real(self.mod, self.lower_type(type_id), 0.0);
            return vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_one(), value, zero_f, llvm_mir_empty_name(), 0);
        }
        if (llvm_mir_kind_pointer_handle(kind)) {
            return self.pointer_handle_alive(value, "mir.ptr.truthy");
        }
        if (llvm_mir_kind_pointer_like(kind)) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_ne(),
                                     value,
                                     vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                     llvm_mir_empty_name(),
                                     0);
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_ne(),
                                     value,
                                     vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                     llvm_mir_empty_name(),
                                     0);
        }
        return value;
    }

    public fn bool_value_i8(self, value_i1: rawptr) -> rawptr {
        if (value_i1 == null) { return null; }
        return vyx_rt_build_zext(self.mod, value_i1, self.ty_i8, llvm_mir_empty_name(), 0);
    }

    public fn int_value_to_bits(self, value: rawptr, src_type_id: i32, dst_bits: i32) -> rawptr {
        if (value == null) { return null; }
        let src_kind = llvm_mir_type_kind(&self.m, src_type_id);
        var src_bits = llvm_mir_int_bits_for_kind(src_kind);
        if (src_bits <= 0) { src_bits = dst_bits; }
        if (src_bits == dst_bits) { return value; }
        let dst_ty = self.int_type_for_bits(dst_bits);
        if (src_bits > dst_bits) { return vyx_rt_build_trunc(self.mod, value, dst_ty, llvm_mir_empty_name(), 0); }
        if (llvm_mir_kind_unsigned(src_kind)) { return vyx_rt_build_zext(self.mod, value, dst_ty, llvm_mir_empty_name(), 0); }
        return vyx_rt_build_sext(self.mod, value, dst_ty, llvm_mir_empty_name(), 0);
    }

    public fn int_value_to_pointer_index(self, value: rawptr, src_type_id: i32) -> rawptr {
        if (value == null || self.ty_pointer_index == null || self.pointer_index_bits <= 0) {
            return null;
        }
        let src_kind = llvm_mir_type_kind(&self.m, src_type_id);
        let src_bits = llvm_mir_int_bits_for_kind(src_kind);
        if (src_bits <= 0) { return null; }
        if (src_bits == self.pointer_index_bits) { return value; }
        if (src_bits > self.pointer_index_bits) {
            return vyx_rt_build_trunc(self.mod,
                                      value,
                                      self.ty_pointer_index,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (llvm_mir_kind_unsigned(src_kind)) {
            return vyx_rt_build_zext(self.mod,
                                     value,
                                     self.ty_pointer_index,
                                     llvm_mir_empty_name(),
                                     0);
        }
        return vyx_rt_build_sext(self.mod,
                                 value,
                                 self.ty_pointer_index,
                                 llvm_mir_empty_name(),
                                 0);
    }

    public fn address_arith_operand_i64(self, value_id: i32) -> rawptr {
        let type_id = self.m.value_type(value_id);
        let kind = llvm_mir_type_kind(&self.m, type_id);
        let value = self.lower_value(value_id);
        if (value == null) { return null; }
        if (llvm_mir_kind_pointer_like(kind)) {
            var scalar = value;
            if (llvm_mir_kind_pointer_handle(kind)) {
                scalar = self.pointer_handle_address(value, "mir.ptr.arith");
                if (scalar == null) { return null; }
            }
            return vyx_rt_build_ptr_to_int(self.mod,
                                           scalar,
                                           self.ty_i64,
                                           llvm_mir_empty_name(),
                                           0);
        }
        if (llvm_mir_int_bits_for_kind(kind) > 0) {
            return self.int_value_to_bits(value, type_id, 64);
        }
        self.report_error("cannot use " + llvm_mir_type_text(&self.m, type_id) + " in pointer arithmetic");
        return null;
    }

    public fn lower_pointer_arithmetic_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        let lhs_id = self.m.value_lhs(value_id);
        let rhs_id = self.m.value_rhs(value_id);
        let lhs_kind = llvm_mir_type_kind(&self.m, self.m.value_type(lhs_id));
        let rhs_kind = llvm_mir_type_kind(&self.m, self.m.value_type(rhs_id));
        let lhs_ptr = llvm_mir_kind_pointer_like(lhs_kind);
        let rhs_ptr = llvm_mir_kind_pointer_like(rhs_kind);
        if (op == llvm_mir_tk_PLUS()) {
            if (lhs_ptr == rhs_ptr) {
                self.report_error("pointer addition requires exactly one pointer operand");
                return null;
            }
        } else if (op == llvm_mir_tk_MINUS()) {
            if (!lhs_ptr || rhs_ptr) {
                self.report_error("pointer subtraction requires pointer minus integer");
                return null;
            }
        } else {
            self.report_error("unsupported pointer arithmetic op " + policy_i64_to_string(op as i64));
            return null;
        }
        let lhs_value = self.lower_value(lhs_id);
        let rhs_value = self.lower_value(rhs_id);
        if (lhs_value == null || rhs_value == null) {
            self.report_error("cannot lower pointer arithmetic operands");
            return null;
        }
        var base = lhs_value;
        var base_kind = lhs_kind;
        var offset_value = rhs_value;
        var offset_type = self.m.value_type(rhs_id);
        var base_type_id = self.m.value_type(lhs_id);
        if (op == llvm_mir_tk_PLUS()) {
            if (!lhs_ptr) {
                base = rhs_value;
                base_kind = rhs_kind;
                offset_value = lhs_value;
                offset_type = self.m.value_type(lhs_id);
                base_type_id = self.m.value_type(rhs_id);
            }
        }
        let offset_kind = llvm_mir_type_kind(&self.m, offset_type);
        if (llvm_mir_int_bits_for_kind(offset_kind) <= 0) {
            self.report_error("cannot lower pointer arithmetic operands");
            return null;
        }
        // Keep both operands lowered in source order, then convert the integer
        // to the module's address-space-0 GEP index width.
        var offset = self.int_value_to_pointer_index(offset_value, offset_type);
        if (offset == null) {
            self.report_error("cannot lower pointer arithmetic offset");
            return null;
        }
        if (op == llvm_mir_tk_MINUS()) {
            offset = vyx_rt_build_sub(self.mod,
                                      vyx_rt_const_int(self.mod, self.ty_pointer_index, 0, 0),
                                      offset,
                                      llvm_mir_empty_name(),
                                      0);
            if (offset == null) {
                self.report_error("cannot negate pointer arithmetic offset");
                return null;
            }
        }
        var base_address = base;
        var base_metadata: rawptr = null;
        if (llvm_mir_kind_pointer_handle(base_kind)) {
            base_address = self.pointer_handle_address(base, "mir.ptr.offset");
            base_metadata = self.pointer_handle_metadata(base, "mir.ptr.offset");
            if (base_address == null || base_metadata == null) { return null; }
        }
        // Element-scaled stepping: typed pointers (`*T`, `&T`, `&mut T`)
        // advance by whole elements (Rust raw-pointer semantics); rawptr
        // stays byte-addressed.
        var shifted: rawptr = null;
        if (llvm_mir_kind_pointer_handle(base_kind)
            && base_type_id != mir_id_invalid()) {
            let elem_type = hir_type_table_elem(self.m.types, base_type_id);
            if (elem_type != mir_id_invalid()) {
                let elem_storage = self.lower_storage_type(elem_type);
                if (elem_storage != null) {
                    let elem_size = vyx_rt_type_alloc_size(self.mod, elem_storage);
                    if (elem_size > 1) {
                        let scale = vyx_rt_const_int(self.mod,
                                                     self.ty_pointer_index,
                                                     elem_size,
                                                     0);
                        offset = vyx_rt_build_mul(self.mod,
                                                  offset,
                                                  scale,
                                                  "mir.ptr.elem.scale".c_str(),
                                                  18);
                        if (offset == null) { return null; }
                    }
                }
            }
        }
        shifted = vyx_rt_build_gep1(self.mod,
                                    self.ty_i8,
                                    base_address,
                                    offset,
                                    llvm_mir_empty_name(),
                                    0);
        if (shifted == null) { return null; }
        if (llvm_mir_kind_pointer_handle(base_kind)) {
            return self.build_pointer_handle(shifted, base_metadata, "mir.ptr.offset");
        }
        return shifted;
    }

    public fn lower_pointer_difference_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        if (op != llvm_mir_tk_MINUS()) {
            self.report_error("pointer difference requires subtraction");
            return null;
        }
        let lhs_id = self.m.value_lhs(value_id);
        let rhs_id = self.m.value_rhs(value_id);
        let lhs_kind = llvm_mir_type_kind(&self.m, self.m.value_type(lhs_id));
        let rhs_kind = llvm_mir_type_kind(&self.m, self.m.value_type(rhs_id));
        if (!llvm_mir_kind_pointer_like(lhs_kind) || !llvm_mir_kind_pointer_like(rhs_kind)) {
            self.report_error("pointer difference requires two pointer operands");
            return null;
        }
        let lhs_i64 = self.address_arith_operand_i64(lhs_id);
        let rhs_i64 = self.address_arith_operand_i64(rhs_id);
        if (lhs_i64 == null || rhs_i64 == null) {
            self.report_error("cannot lower pointer difference operands");
            return null;
        }
        let byte_diff = vyx_rt_build_sub(self.mod, lhs_i64, rhs_i64, llvm_mir_empty_name(), 0);
        if (byte_diff == null) { return null; }
        // Typed pointer difference yields the element count (Rust
        // `offset_from` semantics); rawptr difference stays in bytes.
        let lhs_type = self.m.value_type(lhs_id);
        if (llvm_mir_kind_pointer_handle(lhs_kind)
            && lhs_type != mir_id_invalid()) {
            let elem_type_d = hir_type_table_elem(self.m.types, lhs_type);
            if (elem_type_d != mir_id_invalid()) {
                let elem_storage_d = self.lower_storage_type(elem_type_d);
                if (elem_storage_d != null) {
                    let elem_size_d = vyx_rt_type_alloc_size(self.mod, elem_storage_d);
                    if (elem_size_d > 1) {
                        return vyx_rt_build_sdiv(self.mod,
                                                 byte_diff,
                                                 vyx_rt_const_int(self.mod,
                                                                  self.ty_i64,
                                                                  elem_size_d,
                                                                  0),
                                                 "mir.ptr.diff.elems".c_str(),
                                                 18);
                    }
                }
            }
        }
        return byte_diff;
    }

    // Built-in pointer methods (offset/add/sub/byte_*/offset_from family).
    // Receiver is a typed pointer handle or rawptr; arg is an integer.
    public fn lower_pointer_method_call(self, value_id: i32, kind: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("pointer method requires a receiver");
            return null;
        }
        let recv_type = self.m.value_type(receiver_id);
        let recv_kind = llvm_mir_type_kind(&self.m, recv_type);
        if (kind == 7 || kind == 8) {
            // offset_from / byte_offset_from: two pointer operands.
            let other_id = self.call_arg_at(value_id, 0);
            if (other_id == mir_id_invalid()) {
                self.report_error("offset_from requires one argument");
                return null;
            }
            let lhs_i64 = self.address_arith_operand_i64(receiver_id);
            let rhs_i64 = self.address_arith_operand_i64(other_id);
            if (lhs_i64 == null || rhs_i64 == null) {
                self.report_error("cannot lower offset_from operands");
                return null;
            }
            let byte_diff = vyx_rt_build_sub(self.mod, lhs_i64, rhs_i64,
                                             "mir.pm.diff".c_str(), 11);
            if (byte_diff == null) { return null; }
            if (kind == 8) { return byte_diff; }
            let elem_size = self.pointer_elem_size_for_method(recv_kind, recv_type);
            if (elem_size <= 1) { return byte_diff; }
            return vyx_rt_build_sdiv(self.mod,
                                     byte_diff,
                                     vyx_rt_const_int(self.mod, self.ty_i64, elem_size, 0),
                                     "mir.pm.from.elems".c_str(),
                                     17);
        }
        // Stepping methods: ptr ± scaled/unscaled offset.
        let arg_id = self.call_arg_at(value_id, 0);
        if (arg_id == mir_id_invalid()) {
            self.report_error("pointer step method requires one integer argument");
            return null;
        }
        let base = self.lower_value(receiver_id);
        if (base == null) { return null; }
        let arg_value = self.lower_value(arg_id);
        if (arg_value == null) { return null; }
        let arg_type = self.m.value_type(arg_id);
        var offset = self.int_value_to_pointer_index(arg_value, arg_type);
        if (offset == null) {
            self.report_error("cannot lower pointer method offset");
            return null;
        }
        var elem_size: i64 = 1;
        if (kind >= 1 && kind <= 3) {
            // Element-scaled methods.
            elem_size = self.pointer_elem_size_for_method(recv_kind, recv_type);
        }
        if (elem_size > 1) {
            offset = vyx_rt_build_mul(self.mod,
                                      offset,
                                      vyx_rt_const_int(self.mod, self.ty_pointer_index, elem_size, 0),
                                      "mir.pm.scale".c_str(),
                                      12);
            if (offset == null) { return null; }
        }
        if (kind == 3 || kind == 6) {
            offset = vyx_rt_build_sub(self.mod,
                                      vyx_rt_const_int(self.mod, self.ty_pointer_index, 0, 0),
                                      offset,
                                      llvm_mir_empty_name(),
                                      0);
            if (offset == null) { return null; }
        }
        var base_address = base;
        var base_metadata: rawptr = null;
        if (llvm_mir_kind_pointer_handle(recv_kind)) {
            base_address = self.pointer_handle_address(base, "mir.pm.addr");
            base_metadata = self.pointer_handle_metadata(base, "mir.pm.meta");
            if (base_address == null || base_metadata == null) { return null; }
        }
        let shifted = self.ptr_offset_bytes(base_address, offset, "mir.pm.step");
        if (shifted == null) { return null; }
        if (llvm_mir_kind_pointer_handle(recv_kind)) {
            return self.build_pointer_handle(shifted, base_metadata, "mir.pm.handle");
        }
        return shifted;
    }

    public fn pointer_elem_size_for_method(self, recv_kind: i32, recv_type: i32) -> i64 {
        if (!llvm_mir_kind_pointer_handle(recv_kind)) { return 1; }
        if (recv_type == mir_id_invalid()) { return 1; }
        let elem_type = hir_type_table_elem(self.m.types, recv_type);
        if (elem_type == mir_id_invalid()) { return 1; }
        let elem_storage = self.lower_storage_type(elem_type);
        if (elem_storage == null) { return 1; }
        let measured = vyx_rt_type_alloc_size(self.mod, elem_storage);
        if (measured <= 0) { return 1; }
        return measured;
    }

    public fn global_name_for_hir_item(self, item_id: i32, source_name: string, type_id: i32) -> string {
        // HIR item ids are compilation-local.  Imported units can assign a
        // different id to the same global when the consumer has declarations
        // before the import, so the id must never enter the linker identity.
        // The declaring module and source name are stable across producer and
        // consumer artifacts; keep the old module fallback for synthetic MIR
        // units that have no module declaration.
        var module_name = self.m.static_module_name(item_id);
        if (module_name.len == 0) { module_name = self.module_symbol_name; }
        var name = "mir.global." + policy_mangle_part(module_name);
        if (source_name.len > 0) { name = name + "." + policy_mangle_part(source_name); }
        // A global is unique within its declaring module, so a local type id
        // must not enter the linker identity.  Type aliases and qualification
        // spellings can differ between a producer and consumer while the
        // declaration still denotes the same storage.
        return name;
    }

    public fn const_int_for_static_type(self, item_id: i32, type_id: i32, value: i64, sign_extend: i32) -> rawptr {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits <= 0) {
            self.report_error("static item #" + policy_i64_to_string(item_id as i64)
                      + " has integer initializer for non-integer type "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), value, sign_extend);
    }

    public fn const_str_static_value(self, item_id: i32, text: string) -> rawptr {
        let st = self.get_string_ty();
        let ptr = self.emit_str_ptr(text);
        if (st == null || ptr == null) {
            self.report_error("cannot build string static initializer for item #"
                      + policy_i64_to_string(item_id as i64));
            return null;
        }
        let vals = malloc(32);
        if (vals == null) {
            self.report_error("cannot allocate string static initializer fields for item #"
                      + policy_i64_to_string(item_id as i64));
            return null;
        }
        ast_write_rawptr(vals, ptr);
        ast_write_rawptr(ptr_offset(vals, 8),
                         vyx_rt_const_int(self.mod, self.ty_i64, text.len, 0));
        ast_write_rawptr(ptr_offset(vals, 16),
                         vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        ast_write_rawptr(ptr_offset(vals, 24),
                         vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        let out = vyx_rt_const_named_struct(self.mod, st, vals, 4);
        free(vals);
        if (out == null) {
            self.report_error("cannot build string static initializer for item #"
                      + policy_i64_to_string(item_id as i64));
        }
        return out;
    }

    public fn const_null_for_static_type(self, item_id: i32, type_id: i32) -> rawptr {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (llvm_mir_kind_pointer_handle(kind)) {
            return self.pointer_handle_null();
        }
        if (llvm_mir_kind_pointer_like(kind)) {
            return vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        }
        let ll_ty = self.lower_type(type_id);
        if (ll_ty == null) {
            self.report_error("cannot build null static initializer for item #"
                      + policy_i64_to_string(item_id as i64)
                      + " type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_const_null(self.mod, ll_ty);
    }

    public fn const_for_static_item(self, item_id: i32, type_id: i32, depth: i32) -> rawptr {
        if (item_id == mir_id_invalid()) {
            self.report_error("static initializer references empty item id");
            return null;
        }
        if (depth > self.m.static_count + 1) {
            self.report_error("cyclic static initializer around item #"
                      + policy_i64_to_string(item_id as i64));
            return null;
        }
        if (!self.m.static_exists(item_id)) {
            self.report_error("missing MIR static record for item #"
                      + policy_i64_to_string(item_id as i64));
            return null;
        }
        let init_kind = self.m.static_init_kind(item_id);
        if (init_kind == mir_static_init_int()) {
            let sign_extend = 1;
            return self.const_int_for_static_type(item_id,
                                                  type_id,
                                                  self.m.static_init_int(item_id),
                                                  sign_extend);
        }
        if (init_kind == mir_static_init_bool()) {
            var v: i64 = 0;
            if (self.m.static_init_int(item_id) != 0) { v = 1; }
            return self.const_int_for_static_type(item_id, type_id, v, 0);
        }
        if (init_kind == mir_static_init_char()) {
            return self.const_int_for_static_type(item_id,
                                                  type_id,
                                                  self.m.static_init_int(item_id),
                                                  0);
        }
        if (init_kind == mir_static_init_str()) {
            if (!self.type_is_str_abi(type_id)) {
                self.report_error("static item #" + policy_i64_to_string(item_id as i64)
                          + " has string initializer for non-str type "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return self.const_str_static_value(item_id, self.m.static_init_text(item_id));
        }
        if (init_kind == mir_static_init_null()) {
            return self.const_null_for_static_type(item_id, type_id);
        }
        if (init_kind == mir_static_init_item_ref()) {
            let ref_id = self.m.static_init_target_id(item_id);
            if (self.m.static_init_target_kind(item_id) != mir_target_hir_item()
                || ref_id == mir_id_invalid()) {
                self.report_error("static item #" + policy_i64_to_string(item_id as i64)
                          + " has invalid item-ref initializer");
                return null;
            }
            return self.const_for_static_item(ref_id, type_id, depth + 1);
        }
        self.report_error("static item #" + policy_i64_to_string(item_id as i64)
                  + " has unsupported initializer kind "
                  + policy_i64_to_string(init_kind as i64));
        return null;
    }

    public fn get_or_create_hir_item_global(self, item_id: i32, type_id: i32, source_name: string) -> rawptr {
        if (item_id == mir_id_invalid()) { return null; }
        let cached = llvm_mir_map_get(self.hir_item_globals, item_id);
        if (cached != null) { return cached; }
        let ll_ty = self.lower_type(type_id);
        if (ll_ty == null) {
            self.report_error("cannot resolve global item type for " + source_name);
            return null;
        }
        let global_name = self.global_name_for_hir_item(item_id, source_name, type_id);
        let gv = vyx_rt_add_global(self.mod, ll_ty, global_name.c_str(), global_name.len as u64);
        if (gv == null) {
            self.report_error("cannot declare global item " + global_name);
            return null;
        }
        if (self.partition_codegen_roots) {
            vyx_rt_set_linkage(self.mod, gv, 1);
        }
        if (self.cgu_emit_index > 1
            && llvm_mir_i32_map_get(self.cgu_static_defined_map, item_id) == 2) {
            llvm_mir_map_put(self.hir_item_globals, item_id, gv);
            return gv;
        }
        let init = self.const_for_static_item(item_id, type_id, 0);
        if (init == null) {
            self.report_error("cannot initialize global item " + global_name);
            return null;
        }
        vyx_rt_set_initializer(self.mod, gv, init);
        if (self.cgu_emit_index > 0) {
            llvm_mir_i32_map_put(self.cgu_static_defined_map, item_id, 2);
        }
        if (self.m.static_exists(item_id)
            && self.m.static_item_kind(item_id) == hir_item_const()) {
            vyx_rt_set_global_constant(self.mod, gv, 1);
        }
        llvm_mir_map_put(self.hir_item_globals, item_id, gv);
        return gv;
    }

    /// True when the place ultimately names an MIR local declared `volatile`.
    /// Volatility propagates through field/index projections (C semantics:
    /// accessing any part of a volatile-qualified aggregate is a volatile
    /// access).  Deref projections keep their non-volatile access semantics —
    /// `volatile` on a pointer local qualifies the pointer, not the pointee.
    public fn place_is_volatile_local(self, place_id: i32) -> bool {
        var cur = place_id;
        while (cur != mir_id_invalid()) {
            let kind = self.m.place_kind(cur);
            if (kind == mir_place_local()) {
                let local = self.m.place_local(cur);
                if (local == mir_id_invalid()) { return false; }
                return (self.m.local_flags(local) & mir_local_flag_volatile()) != 0;
            }
            if (kind == mir_place_field() || kind == mir_place_index()) {
                cur = self.m.place_base(cur);
                continue;
            }
            return false;
        }
        return false;
    }

    public fn lower_place_addr(self, place_id: i32) -> rawptr {
        if (place_id == mir_id_invalid()) { return null; }
        var timing_place_start: i64 = 0;
        var timing_place_mark: i64 = 0;
        var timing_base_ms: i64 = 0;
        var timing_effective_ms: i64 = 0;
        var timing_remap1_ms: i64 = 0;
        var timing_owner_ms: i64 = 0;
        var timing_canon_ms: i64 = 0;
        var timing_remap2_ms: i64 = 0;
        var timing_object_ms: i64 = 0;
        var timing_type_ms: i64 = 0;
        var timing_storage_ms: i64 = 0;
        var timing_gep_ms: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_place_start = vyx_bootstrap_now_ms();
            timing_place_mark = timing_place_start;
        }
        let kind = self.m.place_kind(place_id);
        if (kind == mir_place_local()) {
            return llvm_mir_map_get(self.local_slots, self.m.place_local(place_id));
        }
        if (kind == mir_place_static()) {
            return self.get_or_create_hir_item_global(self.m.place_local(place_id),
                                                      self.m.place_type(place_id),
                                                      self.m.place_name(place_id));
        }
        if (kind == mir_place_deref()) {
            // Same-instruction reuse: `*p += 1` lowers the deref place twice
            // (read operand + store destination).  Resolving the handle is
            // expensive when the pointer local is volatile — the reload can
            // never be CSE'd — so check the per-instruction cache BEFORE
            // lowering the pointer value below.
            let cached_deref_early = llvm_mir_map_get(self.instr_deref_addr_cache, place_id);
            if (cached_deref_early != null) { return cached_deref_early; }
            let pointer_value_id = self.m.place_index_value(place_id);
            let pointer_value = self.lower_value(pointer_value_id);
            let pointer_type = self.m.value_type(pointer_value_id);
            if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, pointer_type))) {
                if (!self.place_skips_pointer_region_audit(place_id)) {
                let payload_type = self.place_effective_type(place_id);
                let payload_ty = self.lower_storage_type(payload_type);
                var bytes: i64 = 1;
                if (payload_ty != null) {
                    let measured = vyx_rt_type_alloc_size(self.mod, payload_ty);
                    if (measured > 0) { bytes = measured; }
                }
                let pointer_depth = self.pointer_index_shape_depth(pointer_type);
                let checked = self.pointer_checked_address(pointer_value,
                                                           vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                           bytes,
                                                           pointer_depth,
                                                           "mir.deref");
                return self.pointer_projected_place_addr(pointer_value,
                                                         checked,
                                                         payload_type,
                                                         pointer_depth,
                                                         "mir.deref.project");
                }
                let cached_deref = llvm_mir_map_get(self.instr_deref_addr_cache, place_id);
                if (cached_deref != null) { return cached_deref; }
                let raw_addr = self.pointer_handle_address(pointer_value, "mir.dci.deref");
                if (raw_addr != null) {
                    llvm_mir_map_put(self.instr_deref_addr_cache, place_id, raw_addr);
                }
                return raw_addr;
            }
            return pointer_value;
        }
        if (kind == mir_place_field()) {
            let base_place = self.m.place_base(place_id);
            let base_addr = self.lower_place_addr(base_place);
            if (llvm_mir_timing_enabled()) {
                let now_base = vyx_bootstrap_now_ms();
                timing_base_ms = now_base - timing_place_mark;
                timing_place_mark = now_base;
            }
            var field_id = self.m.place_field(place_id);
            // Validation of the field index happens AFTER remapping: a
            // template FieldId may have no layout slot while the concrete
            // instance field it maps onto does.
            if (base_addr == null || field_id == mir_id_invalid()) {
                self.report_error("cannot resolve field place #" + policy_i64_to_string(place_id as i64));
                return null;
            }
            var field_base_addr = base_addr;
            var field_base_type = self.place_effective_type(base_place);
            var field_base_is_dereferenced_receiver = false;
            // `&T` / `&mut T` are receiver views, not distinct field-owning
            // records.  HIR has already resolved the field against T; peel
            // the pointer handle here before layout validation so lowering
            // uses the same object address as an owned T receiver.
            let field_base_kind = llvm_mir_type_kind(&self.m, field_base_type);
            if (field_base_kind == ty_PTR()
                || field_base_kind == ty_REF()
                || field_base_kind == ty_MUTREF()) {
                let pointee_type = hir_type_table_elem(self.m.types, field_base_type);
                if (pointee_type != mir_id_invalid()) {
                    var handle_ty = self.lower_type(field_base_type);
                    // Self and DCI/C raw-pointer ABI slots are one machine
                    // pointer, not `{ptr, ptr}`. Load that width.
                    if (self.place_slot_holds_raw_pointer(base_place)) {
                        handle_ty = self.ty_ptr;
                    }
                    let handle = vyx_rt_build_load(self.mod,
                                                   handle_ty,
                                                   field_base_addr,
                                                   "mir.field.receiver.handle".c_str(),
                                                   25);
                    let deref_addr = self.pointer_handle_address(handle,
                                                                  "mir.field.receiver");
                    if (handle == null || deref_addr == null) {
                        self.report_error("cannot dereference field receiver "
                                  + llvm_mir_type_text(&self.m, field_base_type));
                        return null;
                    }
                    field_base_addr = deref_addr;
                    field_base_type = pointee_type;
                    field_base_is_dereferenced_receiver = true;
                }
            }
            if (llvm_mir_timing_enabled()) {
                let now_effective = vyx_bootstrap_now_ms();
                timing_effective_ms = now_effective - timing_place_mark;
                timing_place_mark = now_effective;
            }
            let mapped_field_id = self.remapped_field_for_base(field_base_type, field_id);
            if (llvm_mir_timing_enabled()) {
                let now_remap1 = vyx_bootstrap_now_ms();
                timing_remap1_ms = now_remap1 - timing_place_mark;
                timing_place_mark = now_remap1;
            }
            if (mapped_field_id != mir_id_invalid()) { field_id = mapped_field_id; }
            let field_owner_type = mir_unit_field_owner_type(&self.m, field_id);
            if (field_owner_type != mir_id_invalid()
                && !self.field_owner_accepts_base_type(field_owner_type, field_base_type)) {
                if (self.heap_indirect_payload_matches(field_base_type, field_owner_type)) {
                    field_base_addr = self.lower_heap_indirect_payload_address_from_place(base_place, field_owner_type);
                    field_base_type = field_owner_type;
                } else {
                    // Forensics for the multi-CGU "base is i64" corruption:
                    // print the raw ids so the stale-slot reuse (if any) is
                    // visible instead of only the resolved type text.
                    var diag_local: i32 = mir_id_invalid();
                    if (self.m.place_kind(base_place) == mir_place_local()) {
                        diag_local = self.m.place_local(base_place);
                    }
                    print("[i0100-diag] fn=" + self.m.function_name(self.current_function_id)
                          + " cgu=" + policy_i64_to_string(self.cgu_emit_index as i64)
                          + " base_place=" + policy_i64_to_string(base_place as i64)
                          + " place_kind=" + policy_i64_to_string(self.m.place_kind(base_place) as i64)
                          + " place_type=" + policy_i64_to_string(self.m.place_type(base_place) as i64)
                          + " local=" + policy_i64_to_string(diag_local as i64)
                          + " local_type=" + (diag_local != mir_id_invalid()
                                              ? policy_i64_to_string(self.m.local_type(diag_local) as i64)
                                              : "n/a")
                          + " local_type_text=" + (diag_local != mir_id_invalid()
                                              ? llvm_mir_type_text(&self.m, self.m.local_type(diag_local))
                                              : "n/a")
                          + " base_type_id=" + policy_i64_to_string(field_base_type as i64)
                          + " owner_type_id=" + policy_i64_to_string(field_owner_type as i64));
                    self.report_error("field " + mir_unit_field_name(&self.m, field_id)
                              + " belongs to " + llvm_mir_type_text(&self.m, field_owner_type)
                              + " but base is " + llvm_mir_type_text(&self.m, field_base_type)
                              + " [in " + self.m.function_name(self.current_function_id)
                              + " cgu=" + policy_i64_to_string(self.cgu_emit_index as i64) + "]");
                    return null;
                }
            }
            if (llvm_mir_timing_enabled()) {
                let now_owner = vyx_bootstrap_now_ms();
                timing_owner_ms = now_owner - timing_place_mark;
                timing_place_mark = now_owner;
            }
            field_base_type = self.canonical_record_type_id(field_base_type);
            if (llvm_mir_timing_enabled()) {
                let now_canon = vyx_bootstrap_now_ms();
                timing_canon_ms = now_canon - timing_place_mark;
                timing_place_mark = now_canon;
            }
            field_id = self.remapped_field_for_base(field_base_type, field_id);
            if (llvm_mir_timing_enabled()) {
                let now_remap2 = vyx_bootstrap_now_ms();
                timing_remap2_ms = now_remap2 - timing_place_mark;
                timing_place_mark = now_remap2;
            }
            if (field_id == mir_id_invalid()) {
                self.report_error("cannot map field place #" + policy_i64_to_string(place_id as i64)
                          + " onto " + llvm_mir_type_text(&self.m, field_base_type));
                return null;
            }
            if (self.place_is_self_pointer_abi_slot(base_place)) {
                field_base_addr = self.load_self_pointer_abi_slot(base_place, field_base_addr, field_base_type);
            } else if (self.type_is_class_pointer_abi(field_base_type)
                       && !self.place_is_direct_class_object_pointer(base_place)
                       && !field_base_is_dereferenced_receiver) {
                field_base_addr = self.class_object_addr_from_place_addr(base_place, field_base_addr, field_base_type);
            }
            if (llvm_mir_timing_enabled()) {
                let now_object = vyx_bootstrap_now_ms();
                timing_object_ms = now_object - timing_place_mark;
                timing_place_mark = now_object;
            }
            if (self.foreign_dci_field_record_type(field_base_type, field_id) != mir_id_invalid()) {
                return self.dci_field_addr(field_base_addr, field_base_type, field_id);
            }
            if (self.type_is_dci_stub_class(field_base_type)) {
                return self.dci_stub_state_field_addr(field_base_addr, field_base_type, field_id);
            }
            var base_ty = self.lower_type(field_base_type);
            if (llvm_mir_timing_enabled()) {
                let now_type = vyx_bootstrap_now_ms();
                timing_type_ms = now_type - timing_place_mark;
                timing_place_mark = now_type;
            }
            if (self.type_is_class_pointer_abi(field_base_type)
                || self.place_is_self_pointer_abi_slot(base_place)) {
                let storage_ty = self.class_record_storage_ty(field_base_type);
                if (storage_ty != null) { base_ty = storage_ty; }
            }
            if (llvm_mir_timing_enabled()) {
                let now_storage = vyx_bootstrap_now_ms();
                timing_storage_ms = now_storage - timing_place_mark;
                timing_place_mark = now_storage;
            }
            let field_index2 = mir_unit_field_index(&self.m, field_id);
            if (field_base_addr == null || base_ty == null || field_index2 < 0) {
                self.report_error("cannot resolve field base for " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            let field_count2 = mir_unit_field_count_for_type(&self.m, field_base_type);
            if (field_index2 >= field_count2) {
                self.report_error("field index "
                          + policy_i64_to_string(field_index2 as i64)
                          + " is outside layout "
                          + llvm_mir_type_text(&self.m, field_base_type)
                          + " field_count="
                          + policy_i64_to_string(field_count2 as i64)
                          + " for "
                          + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            let field_addr = vyx_rt_build_gep2(self.mod,
                                               base_ty,
                                               field_base_addr,
                                               vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                               vyx_rt_const_int(self.mod, self.ty_i32, field_index2 as i64, 0),
                                               mir_unit_field_name(&self.m, field_id).c_str(),
                                               mir_unit_field_name(&self.m, field_id).len as u64);
            if (llvm_mir_timing_enabled()) {
                let now_gep = vyx_bootstrap_now_ms();
                timing_gep_ms = now_gep - timing_place_mark;
                timing_place_mark = now_gep;
            }
            if (field_addr == null) {
                self.report_error("cannot build field address for "
                          + llvm_mir_type_text(&self.m, field_base_type)
                          + "."
                          + mir_unit_field_name(&self.m, field_id)
                          + " index "
                          + policy_i64_to_string(field_index2 as i64));
                return null;
            }
            if (llvm_mir_timing_enabled()) {
                let timing_place_elapsed = vyx_bootstrap_now_ms() - timing_place_start;
                if (timing_place_elapsed >= llvm_mir_slow_instr_threshold_ms()) {
                    print("[mir-timing] place-field fn #" + policy_i64_to_string(self.current_function_id as i64)
                          + " " + self.m.function_name(self.current_function_id)
                          + " place=" + policy_i64_to_string(place_id as i64)
                          + " field=" + mir_unit_field_name(&self.m, field_id)
                          + " base_type=" + llvm_mir_type_text(&self.m, field_base_type)
                          + " base=" + timing_base_ms.toString()
                          + " effective=" + timing_effective_ms.toString()
                          + " remap1=" + timing_remap1_ms.toString()
                          + " owner=" + timing_owner_ms.toString()
                          + " canon=" + timing_canon_ms.toString()
                          + " remap2=" + timing_remap2_ms.toString()
                          + " object=" + timing_object_ms.toString()
                          + " type=" + timing_type_ms.toString()
                          + " storage=" + timing_storage_ms.toString()
                          + " gep=" + timing_gep_ms.toString()
                          + " total=" + timing_place_elapsed.toString() + " ms");
                }
            }
            return field_addr;
        }
        if (kind == mir_place_index()) {
            return self.lower_index_place_addr(place_id);
        }
        self.report_error("cannot lower place #" + policy_i64_to_string(place_id as i64)
                  + " kind=" + policy_i64_to_string(kind as i64));
        return null;
    }

    public fn lower_heap_indirect_payload_address_from_place(self, place_id: i32, dst_type_id: i32) -> rawptr {
        if (place_id == mir_id_invalid()) { return null; }
        let src_type_id = self.m.place_type(place_id);
        let payload_type = self.heap_indirect_payload_type(src_type_id);
        if (payload_type == mir_id_invalid() || !self.type_ids_compatible(payload_type, dst_type_id)) {
            self.report_error("cannot resolve heap-indirected payload address from "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " to "
                      + llvm_mir_type_text(&self.m, dst_type_id));
            return null;
        }
        let raw_base_addr = self.lower_place_addr(place_id);
        let base_addr = self.class_object_addr_from_place_addr(place_id, raw_base_addr, src_type_id);
        let data_addr = self.record_field_addr_for_type(base_addr, src_type_id, "data");
        if (raw_base_addr == null || base_addr == null || data_addr == null) {
            self.report_error("cannot address heap-indirected storage for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        let data_ptr = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         data_addr,
                                         "mir.deref.data".c_str(),
                                         14);
        if (data_ptr == null) {
            self.report_error("cannot load heap-indirected payload address for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        return data_ptr;
    }

    public fn lower_index_place_addr(self, place_id: i32) -> rawptr {
        let base_place = self.m.place_base(place_id);
        let index_id = self.m.place_index_value(place_id);
        var trace_idx: bool = false;
        if (llvm_mir_env_enabled("VYX_TRACE_IDXPLACE")) {
            trace_idx = true;
            print("[idxplace] enter place=" + policy_i64_to_string(place_id as i64)
                  + " base=" + policy_i64_to_string(base_place as i64)
                  + " index=" + policy_i64_to_string(index_id as i64));
            fflush(null);
        }
        if (base_place == mir_id_invalid() || index_id == mir_id_invalid()) {
            self.report_error("index place is missing base or index for place #" + policy_i64_to_string(place_id as i64));
            return null;
        }
        var index_value = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 64);
        if (trace_idx) {
            print("[idxplace] index lowered -> " + (index_value == null ? "null" : "ok"));
            fflush(null);
        }
        if (index_value == null) {
            self.report_error("cannot lower index operand for place #" + policy_i64_to_string(place_id as i64));
            return null;
        }
        // Refine the base through place_effective_type (template field bases
        // resolve to the concrete instance layout) and derive the element
        // type from the refined base when the type table records one.
        let base_type = self.place_effective_type(base_place);
        let base_kind = llvm_mir_type_kind(&self.m, base_type);
        if (trace_idx) {
            print("[idxplace] base_type=" + llvm_mir_type_text(&self.m, base_type)
                  + " kind=" + policy_i64_to_string(base_kind as i64));
            fflush(null);
        }
        var result_type = self.m.place_type(place_id);
        let refined_elem = hir_type_table_elem(self.m.types, base_type);
        if (!self.type_is_concrete_runtime_type(result_type)
            && refined_elem != mir_id_invalid()) {
            result_type = refined_elem;
        }
        if (base_kind == ty_ARRAY()) {
            let base_addr = self.lower_place_addr(base_place);
            let array_ty = self.lower_type(base_type);
            let elem_ty = self.lower_type(result_type);
            if (base_addr == null || array_ty == null || elem_ty == null) {
                self.report_error("cannot lower array index base for place #" + policy_i64_to_string(place_id as i64));
                return null;
            }
            return vyx_rt_build_gep2(self.mod,
                                     array_ty,
                                     base_addr,
                                     vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                     index_value,
                                     "mir.index".c_str(),
                                     9);
        }
        if (base_kind == ty_PTR() || base_kind == ty_REF() || base_kind == ty_MUTREF()) {
            let base_addr2 = self.lower_place_addr(base_place);
            let base_ptr_ty = self.lower_type(base_type);
            let elem_ty2 = self.lower_type(result_type);
            if (base_addr2 == null || base_ptr_ty == null || elem_ty2 == null) {
                self.report_error("cannot lower pointer index base for place #" + policy_i64_to_string(place_id as i64));
                return null;
            }
            let base_ptr = vyx_rt_build_load(self.mod,
                                             base_ptr_ty,
                                             base_addr2,
                                             llvm_mir_empty_name(),
                                             0);
            if (!self.place_skips_pointer_region_audit(place_id)) {
            var bytes2 = vyx_rt_type_alloc_size(self.mod, elem_ty2);
            if (bytes2 <= 0) { bytes2 = 1; }
            let pointer_depth2 = self.pointer_index_shape_depth(base_type);
            let checked2 = self.pointer_checked_address(base_ptr,
                                                        index_value,
                                                        bytes2,
                                                        pointer_depth2,
                                                        "mir.index");
            return self.pointer_projected_place_addr(base_ptr,
                                                     checked2,
                                                     result_type,
                                                     pointer_depth2,
                                                     "mir.index.project");
            }
            // Unchecked (unsafe/DCI) index: peel the raw address out of the
            // pointer handle first.  DCI/C-ABI slots already hold one machine
            // pointer (pointer_handle_address passes it through), while Vyx
            // `*T` slots hold a `{address, metadata}` handle — GEP-ing the
            // handle struct directly is ill-typed.  Scale by the element
            // size via a typed GEP so `p[i]` matches the checked-path
            // semantics instead of advancing `i` bytes.
            let raw_index_base = self.pointer_handle_address(base_ptr, "mir.unsafe.index");
            if (raw_index_base == null) {
                self.report_error("cannot resolve unchecked pointer index base for place #"
                                  + policy_i64_to_string(place_id as i64));
                return null;
            }
            return self.ptr_offset_elements(elem_ty2,
                                            raw_index_base,
                                            index_value,
                                            "mir.unsafe.index");
        }
        if (base_kind == ty_RAWPTR()) {
            let base_addr3 = self.lower_place_addr(base_place);
            if (base_addr3 == null) {
                self.report_error("cannot lower rawptr index base for place #" + policy_i64_to_string(place_id as i64));
                return null;
            }
            let base_ptr3 = vyx_rt_build_load(self.mod,
                                              self.ty_ptr,
                                              base_addr3,
                                              llvm_mir_empty_name(),
                                              0);
            return self.ptr_offset_bytes(base_ptr3, index_value, "mir.rawptr.index");
        }
        self.report_error("index place base is not indexable: " + llvm_mir_type_text(&self.m, base_type));
        return null;
    }

    public fn lower_value_as(self, value_id: i32, dst_type_id: i32) -> rawptr {
        let fn_abi_value = self.lower_function_target_as_fn_abi(value_id, dst_type_id);
        if (fn_abi_value != null) { return fn_abi_value; }
        let direct_function_scalar = self.lower_direct_function_target_as_scalar(value_id, dst_type_id);
        if (direct_function_scalar != null) { return direct_function_scalar; }
        let src_type_id = self.value_effective_type(value_id);
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type_id);
        // `null` converted to a typed Vyx pointer is the canonical empty
        // two-word handle.  Do not lower it as a raw null and route it through
        // pointer_handle_from_raw(): that would allocate useless region
        // metadata for an address that can never denote storage.
        if (self.m.value_kind(value_id) == mir_value_null()
            && llvm_mir_kind_pointer_handle(dst_kind)) {
            return self.pointer_handle_null();
        }
        if ((dst_kind == ty_PTR() || dst_kind == ty_REF() || dst_kind == ty_MUTREF())
            && llvm_mir_type_kind(&self.m, src_type_id) == ty_CLASS()) {
            let dst_elem_type = hir_type_table_elem(self.m.types, dst_type_id);
            var class_to_ptr = false;
            if (dst_elem_type != mir_id_invalid()) {
                if (self.type_ids_compatible(src_type_id, dst_elem_type)) { class_to_ptr = true; }
                if (!class_to_ptr && self.dci_type_derives_from(src_type_id, dst_elem_type)) {
                    class_to_ptr = true;
                }
                if (!class_to_ptr && self.type_is_dci_stub_class(src_type_id)) {
                    class_to_ptr = true;
                }
            }
            if (class_to_ptr) {
                let src_addr = self.lower_self_receiver_address(value_id, src_type_id);
                if (src_addr != null) {
                    let adjusted = self.adjust_dci_base_pointer(src_addr,
                                                                src_type_id,
                                                                dst_elem_type,
                                                                "dci.value.ptr");
                    if (self.type_is_foreign_dci(src_type_id)
                        || self.type_is_foreign_dci(dst_elem_type)
                        || self.type_is_dci_stub_class(src_type_id)) {
                        return self.pointer_handle_from_foreign_raw(adjusted, "dci.value.ptr");
                    }
                    return self.pointer_handle_from_raw(adjusted,
                                                        dst_elem_type,
                                                        0,
                                                        0,
                                                        "dci.value.ptr");
                }
            }
        }
        if (dst_type_id != mir_id_invalid()
            && self.type_is_result_abi(dst_type_id)
            && !self.type_is_result_abi(src_type_id)) {
            return self.lower_result_ok_wrap_value(value_id, dst_type_id);
        }
        if (dst_type_id != mir_id_invalid()
            && self.type_is_std_string_class(dst_type_id)
            && self.type_is_str_abi(src_type_id)) {
            return self.lower_str_to_std_string_value(value_id, dst_type_id);
        }
        if (dst_type_id != mir_id_invalid()
            && self.type_is_str_abi(dst_type_id)
            && self.type_is_std_string_class(src_type_id)) {
            return self.lower_std_string_as_str_value(value_id);
        }
        if (dst_type_id != mir_id_invalid()
            && self.type_is_str_abi(dst_type_id)
            && (llvm_mir_type_kind(&self.m, src_type_id) == ty_REF()
                || llvm_mir_type_kind(&self.m, src_type_id) == ty_MUTREF())) {
            return self.reference_value_to_string(value_id, src_type_id);
        }
        // An explicit C/raw pointer-to-str conversion denotes a borrowed
        // NUL-terminated byte view. It must materialize the full Vyx string
        // ABI rather than preserving the LLVM pointer scalar under a str MIR
        // type; otherwise the next direct call receives `ptr` where it
        // requires `%__String`.
        if (dst_type_id != mir_id_invalid()
            && self.type_is_str_abi(dst_type_id)
            && llvm_mir_kind_pointer_like(llvm_mir_type_kind(&self.m, src_type_id))) {
            let raw_cstr = self.cast_value(self.lower_value(value_id),
                                           src_type_id,
                                           self.type_id_by_text("rawptr"));
            return self.string_value_from_cstr(raw_cstr, 0);
        }
        // Scalar -> str ABI casts (`i64 as string`, `f64 as string`, ...) must
        // materialize a full owning string value. cast_value() has no string
        // case and used to fall through `return value`, handing the raw scalar
        // bits back under a str type (empty / garbage strings, and concat on
        // that pseudo-string crashed). Route through the same to_string
        // channel the print/interpolation paths use.
        if (dst_type_id != mir_id_invalid()
            && self.type_is_str_abi(dst_type_id)) {
            let scalar_kind = llvm_mir_type_kind(&self.m, src_type_id);
            let scalar_bits = llvm_mir_int_bits_for_kind(scalar_kind);
            if (scalar_bits > 0 && scalar_kind != ty_BOOL()) {
                let as_i64 = self.int_value_to_bits(self.lower_value(value_id), src_type_id, 64);
                return self.string_value_from_integer_to_string(
                    as_i64,
                    llvm_mir_kind_decimal_unsigned(scalar_kind));
            }
            if (scalar_kind == ty_BOOL()) {
                let as_i32 = self.int_value_to_bits(self.lower_value(value_id), src_type_id, 32);
                return self.string_value_from_bool_to_string(as_i32);
            }
            if (llvm_mir_kind_float(scalar_kind)) {
                return self.float_value_to_string(value_id);
            }
        }
        if (dst_type_id != mir_id_invalid()) {
            let dst_dyn = self.type_dyn_trait_id(dst_type_id);
            if (dst_dyn != mir_id_invalid()) {
                let src_dyn = self.type_dyn_trait_id(src_type_id);
                var fat: rawptr = null;
                if (self.type_is_dyn_trait(src_type_id)) {
                    fat = self.lower_value(value_id);
                } else if (src_dyn == dst_dyn
                    && llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, src_type_id))) {
                    let handle = self.lower_value(value_id);
                    let addr = self.pointer_handle_address(handle, "mir.dyn.load");
                    let dyn_ty = self.get_or_create_dyn_trait_ty(dst_dyn);
                    if (addr != null && dyn_ty != null) {
                        fat = vyx_rt_build_load(self.mod, dyn_ty, addr, "mir.dyn.load".c_str(), 12);
                    }
                } else {
                    fat = self.lower_value_to_dyn_trait(value_id, dst_dyn);
                }
                if (fat == null) {
                    self.report_error("cannot lower dyn trait conversion "
                              + llvm_mir_type_text(&self.m, src_type_id)
                              + " -> "
                              + llvm_mir_type_text(&self.m, dst_type_id));
                    return null;
                }
                if (self.type_is_dyn_trait(dst_type_id)) { return fat; }
                if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, dst_type_id))) {
                    let dyn_ty2 = self.get_or_create_dyn_trait_ty(dst_dyn);
                    let slot = vyx_rt_build_alloca(self.mod, dyn_ty2, "mir.dyn.ref".c_str(), 11);
                    if (slot == null || dyn_ty2 == null) { return null; }
                    vyx_rt_build_store(self.mod, fat, slot);
                    return self.pointer_handle_from_raw(slot, dst_dyn, 0, 0, "mir.dyn.ref");
                }
                return fat;
            }
        }
        if (dst_type_id != mir_id_invalid()
            && self.heap_indirect_payload_matches(src_type_id, dst_type_id)) {
            return self.lower_heap_indirect_payload_value(value_id, dst_type_id);
        }
        var aggregate_value_id = value_id;
        if (self.m.value_kind(aggregate_value_id) == mir_value_arg()
            && self.m.value_lhs(aggregate_value_id) != mir_id_invalid()) {
            aggregate_value_id = self.m.value_lhs(aggregate_value_id);
        }
        if (dst_type_id != mir_id_invalid()
            && self.m.value_kind(aggregate_value_id) == mir_value_aggregate()
            && self.aggregate_should_use_destination_layout(self.value_effective_type(aggregate_value_id),
                                                            dst_type_id)) {
            return self.lower_aggregate_value_with_type(aggregate_value_id, dst_type_id);
        }
        let v = self.lower_value(value_id);
        let casted = self.cast_value(v, src_type_id, dst_type_id);
        if (casted == null) {
            var detail = "lower_value_as produced null for value #"
                       + policy_i64_to_string(value_id as i64)
                       + " kind "
                       + policy_i64_to_string(self.m.value_kind(value_id) as i64)
                       + " from "
                       + llvm_mir_type_text(&self.m, src_type_id)
                       + " to "
                       + llvm_mir_type_text(&self.m, dst_type_id);
            if (self.m.value_kind(value_id) == mir_value_target_ref()) {
                detail = detail + " target_kind="
                       + policy_i64_to_string(self.m.value_target_kind(value_id) as i64)
                       + " target_id="
                       + policy_i64_to_string(self.m.value_target_id(value_id) as i64)
                       + " name=" + self.m.value_name(value_id)
                       + " in function="
                       + self.m.function_name(self.m.value_function(value_id))
                       + " source_expr="
                       + policy_i64_to_string(self.m.value_source_expr(value_id) as i64);
            }
            self.report_error(detail);
        }
        return casted;
    }

    // A function-typed destination slot must receive a closure/fat pointer
    // (`__VyxClosureFat`), never a bare code address.  The kind check alone is
    // not sufficient: a duplicate generic registration or a closure-synthesized
    // function type can register the *text* `fn(...)` on a type entry whose
    // kind is a pointer shape.  A bare function value routed through such a
    // destination then falls into lower_direct_function_target_as_scalar(),
    // stores the raw symbol, and the consumer dereferences it as a fat pointer
    // (`callq *%rax` on a garbage code field).  Accept a `fn(`-textual
    // destination as a function ABI destination too.  `cfn(` and `unsafe fn(`
    // keep the raw C-callback path because they do not match this prefix.
    public fn type_is_fn_abi_destination(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) == ty_FN()) { return true; }
        let text = llvm_mir_type_text(&self.m, type_id);
        return text.len >= 3 && text.substring(0, 3) == "fn(";
    }

    public fn lower_function_target_as_fn_abi(self, value_id: i32, dst_type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return null; }
        if (self.m.value_kind(value_id) != mir_value_target_ref()) { return null; }
        if (self.m.value_target_kind(value_id) != mir_target_function()) { return null; }
        if (!self.type_is_fn_abi_destination(dst_type_id)) {
            if (llvm_mir_env_enabled("VYX_FNABI_TRACE")) {
                print("[fnabi-trace] skip value="
                      + policy_i64_to_string(value_id as i64)
                      + " target=" + self.m.function_name(self.m.value_target_id(value_id))
                      + " dst=" + policy_i64_to_string(dst_type_id as i64)
                      + " kind=" + policy_i64_to_string(llvm_mir_type_kind(&self.m, dst_type_id) as i64)
                      + " text=" + llvm_mir_type_text(&self.m, dst_type_id));
            }
            return null;
        }
        if (llvm_mir_type_kind(&self.m, dst_type_id) != ty_FN()
            && llvm_mir_env_enabled("VYX_FNABI_TRACE")) {
            print("[fnabi-trace] textual-fn dst value="
                  + policy_i64_to_string(value_id as i64)
                  + " target=" + self.m.function_name(self.m.value_target_id(value_id))
                  + " dst=" + policy_i64_to_string(dst_type_id as i64)
                  + " kind=" + policy_i64_to_string(llvm_mir_type_kind(&self.m, dst_type_id) as i64)
                  + " text=" + llvm_mir_type_text(&self.m, dst_type_id));
        }
        let target_fn = self.m.value_target_id(value_id);
        if (target_fn == mir_id_invalid()) { return null; }
        self.declare_function_signature(target_fn);
        return self.build_closure_fat_value(target_fn);
    }

    public fn lower_direct_function_target_as_scalar(self, value_id: i32, dst_type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return null; }
        if (self.m.value_kind(value_id) != mir_value_target_ref()) { return null; }
        if (self.m.value_target_kind(value_id) != mir_target_function()) { return null; }
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type_id);
        let dst_bits = llvm_mir_int_bits_for_kind(dst_kind);
        let wants_pointer = dst_kind == ty_CFN()
            || dst_kind == ty_RAWPTR()
            || dst_kind == ty_PTR()
            || dst_kind == ty_REF()
            || dst_kind == ty_MUTREF();
        if (dst_bits <= 0 && !wants_pointer) { return null; }
        let target_fn = self.m.value_target_id(value_id);
        self.declare_function_signature(target_fn);
        var fn_value = llvm_mir_map_get(self.function_values, target_fn);
        if (dst_bits > 0 && self.function_needs_raw_callback_adapter(target_fn)) {
            self.declare_raw_callback_adapter_for(target_fn);
            fn_value = llvm_mir_map_get(self.function_raw_callback_adapter_values, target_fn);
            if (fn_value == null) {
                self.report_error("cannot resolve raw callback adapter for " + self.m.function_name(target_fn));
                return null;
            }
        }
        if (dst_bits <= 0 && self.function_hidden_env_param_count(target_fn) != 0) {
            self.report_error("cannot expose capturing function "
                      + self.m.function_name(target_fn)
                      + " as a raw pointer");
            return null;
        }
        if (fn_value == null) {
            self.report_error("cannot resolve function address for " + self.m.function_name(target_fn));
            return null;
        }
        if (dst_bits > 0) {
            return vyx_rt_build_ptr_to_int(self.mod,
                                           fn_value,
                                           self.int_type_for_bits(dst_bits),
                                           llvm_mir_empty_name(),
                                           0);
        }
        if (llvm_mir_kind_pointer_handle(dst_kind)) {
            return self.pointer_handle_from_raw(fn_value,
                                                hir_type_table_elem(self.m.types, dst_type_id),
                                                0,
                                                0,
                                                "mir.fn.ptr");
        }
        if (llvm_mir_env_enabled("VYX_FNABI_TRACE")) {
            print("[fnabi-trace] bare-address value="
                  + policy_i64_to_string(value_id as i64)
                  + " target=" + self.m.function_name(target_fn)
                  + " dst=" + policy_i64_to_string(dst_type_id as i64)
                  + " kind=" + policy_i64_to_string(dst_kind as i64)
                  + " text=" + llvm_mir_type_text(&self.m, dst_type_id));
        }
        return fn_value;
    }

    public fn dyn_trait_field_ptr(self, dyn_addr: rawptr, dyn_type_id: i32, idx: i32, name: string) -> rawptr {
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        if (dyn_addr == null || dyn_ty == null || idx < 0) { return null; }
        let field_count = 2;
        if (idx >= field_count) {
            self.report_error("dyn trait field index "
                      + policy_i64_to_string(idx as i64)
                      + " is outside "
                      + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " field_count="
                      + policy_i64_to_string(field_count as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 dyn_ty,
                                 dyn_addr,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn dyn_trait_field_value(self, dyn_value: rawptr, dyn_type_id: i32, idx: i32, name: string) -> rawptr {
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        if (dyn_value == null || dyn_ty == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, dyn_ty, "mir.dyn.extract".c_str(), 15);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, dyn_value, tmp);
        let field = self.dyn_trait_field_ptr(tmp, dyn_type_id, idx, name);
        if (field == null) { return null; }
        return vyx_rt_build_load(self.mod, self.ty_ptr, field, name.c_str(), name.len as u64);
    }

    public fn dyn_trait_method_signature_matches(self, candidate_fn: i32, prototype_fn: i32) -> bool {
        if (candidate_fn == mir_id_invalid() || prototype_fn == mir_id_invalid()) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(candidate_fn),
                                      self.m.function_return_type(prototype_fn))) {
            return false;
        }
        let candidate_count = self.function_source_param_count(candidate_fn);
        let prototype_count = self.function_source_param_count(prototype_fn);
        if (candidate_count != prototype_count) { return false; }
        var idx: i32 = 1;
        while (idx < prototype_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(candidate_fn, idx),
                                          self.function_source_param_type(prototype_fn, idx))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn dyn_trait_method_slot(self, dyn_type_id: i32, prototype_fn: i32) -> i32 {
        let count = self.dyn_trait_method_count(dyn_type_id);
        let wanted_name = self.function_method_name(prototype_fn);
        var slot: i32 = 0;
        while (slot < count) {
            let candidate = self.dyn_trait_method_at(dyn_type_id, slot);
            if (candidate != mir_id_invalid()
                && self.function_method_name(candidate) == wanted_name
                && self.dyn_trait_method_signature_matches(candidate, prototype_fn)) {
                return slot;
            }
            slot = slot + 1;
        }
        return -1;
    }

    public fn dyn_trait_impl_cache_get(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        var cur = self.dyn_trait_impl_cache_head;
        while (cur != null) {
            if (ast_read_i32(cur) == src_type_id
                && ast_read_i32(ptr_offset(cur, 4)) == prototype_fn) {
                return ast_read_i32(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return -2;
    }

    public fn dyn_trait_impl_cache_put(self, src_type_id: i32, prototype_fn: i32, impl_fn: i32) {
        if (src_type_id == mir_id_invalid() || prototype_fn == mir_id_invalid()) { return; }
        let node = malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_i32(node, src_type_id);
        ast_write_i32(ptr_offset(node, 4), prototype_fn);
        ast_write_i32(ptr_offset(node, 8), impl_fn);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_trait_impl_cache_head);
        self.dyn_trait_impl_cache_head = node;
    }

    public fn dyn_trait_implementation_for_method(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        let cached = self.dyn_trait_impl_cache_get(src_type_id, prototype_fn);
        if (cached != -2) { return cached; }
        if (policy_dyn_probe_enabled()) { self.dyn_probe_dump(src_type_id, prototype_fn); }
        let method_name = self.function_method_name(prototype_fn);
        let direct = self.executable_method_for_receiver_type(src_type_id, method_name);
        if (direct != mir_id_invalid()
            && self.concrete_function_matches_dyn_method(prototype_fn, direct)) {
            self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, direct);
            return direct;
        }
        var cur = self.method_candidate_head(method_name);
        while (cur != null) {
            let fn_id = ast_read_i32(cur);
            let first_local = self.function_source_param_local(fn_id, 0);
            if (first_local != mir_id_invalid()
                && self.receiver_type_can_use_method_self_type(src_type_id, self.m.local_type(first_local))
                && self.concrete_function_matches_dyn_method(prototype_fn, fn_id)) {
                self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, fn_id);
                return fn_id;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        // The candidate index only covers functions whose body or definition
        // mark is visible in *this* unit; in a split build the concrete method
        // may live in a sibling unit's object file.  Fall back to the codegen
        // partition, which remembers every function this build defines.
        let from_partition = self.dyn_partition_candidate(src_type_id, prototype_fn);
        if (from_partition != mir_id_invalid()) {
            self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, from_partition);
            return from_partition;
        }
        self.dyn_trait_impl_cache_put(src_type_id, prototype_fn, mir_id_invalid());
        return mir_id_invalid();
    }

    public fn lower_value_to_dyn_trait(self, value_id: i32, dyn_type_id: i32) -> rawptr {
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_type: i64 = 0;
        var timing_probe: i64 = 0;
        var timing_payload: i64 = 0;
        var timing_slot: i64 = 0;
        var timing_vtable: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        var src_type_id = self.value_effective_type(value_id);
        if (src_type_id == mir_id_invalid()) { return null; }
        var payload_from_handle: rawptr = null;
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, src_type_id))) {
            let elem = hir_type_table_elem(self.m.types, src_type_id);
            if (self.type_is_dyn_trait(elem)) {
                let handle_dyn = self.lower_value(value_id);
                let addr_dyn = self.pointer_handle_address(handle_dyn, "mir.dyn.load");
                let dyn_ty_load = self.get_or_create_dyn_trait_ty(dyn_type_id);
                if (addr_dyn == null || dyn_ty_load == null) { return null; }
                return vyx_rt_build_load(self.mod, dyn_ty_load, addr_dyn, "mir.dyn.load".c_str(), 12);
            }
            if (elem != mir_id_invalid()) {
                let handle_src = self.lower_value(value_id);
                payload_from_handle = self.pointer_handle_address(handle_src, "mir.dyn.borrow");
                src_type_id = elem;
            }
        }
        let dyn_ty = self.get_or_create_dyn_trait_ty(dyn_type_id);
        let src_ty = self.lower_type(src_type_id);
        if (llvm_mir_timing_enabled()) {
            let now_type = vyx_bootstrap_now_ms();
            timing_type = now_type - timing_mark;
            timing_mark = now_type;
        }
        if (dyn_ty == null || src_ty == null) {
            self.report_error("cannot lower dyn trait conversion type "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " -> "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        var payload: rawptr = null;
        let src_uses_pointer_repr = self.type_uses_self_pointer_abi(src_type_id);
        if (llvm_mir_timing_enabled()) {
            let now_probe = vyx_bootstrap_now_ms();
            timing_probe = now_probe - timing_mark;
            timing_mark = now_probe;
        }
        // The concrete value is spilled to storage the fat pointer points at.
        // dyn-by-value payloads are never freed (the callee borrows them), so
        // route them through the thread-local bump allocator rather than malloc:
        // it is far cheaper on this hot path, and a payload that turns out not to
        // escape is later stack-promoted by the runtime's non-escaping-allocation
        // pass (vyx_class_alloc_abi is the shape it recognises).
        if (payload_from_handle != null) {
            payload = payload_from_handle;
        } else if (src_uses_pointer_repr) {
            if (self.type_is_class_pointer_abi(src_type_id)) {
                payload = self.lower_value(value_id);
                if (payload == null) {
                    self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
            } else {
                let src_size_for_record = vyx_rt_type_alloc_size(self.mod, src_ty);
                if (src_size_for_record <= 0) {
                    self.report_error("invalid dyn trait payload size for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
                payload = self.class_alloc_bytes_value(src_size_for_record, "mir.dyn.payload.alloc");
                if (payload == null) { return null; }
                let src_record_value = self.lower_value(value_id);
                if (src_record_value == null) {
                    self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                    return null;
                }
                vyx_rt_build_store(self.mod, src_record_value, payload);
            }
        } else {
            let src_size = vyx_rt_type_alloc_size(self.mod, src_ty);
            if (src_size <= 0) {
                self.report_error("invalid dyn trait payload size for " + llvm_mir_type_text(&self.m, src_type_id));
                return null;
            }
            payload = self.class_alloc_bytes_value(src_size, "mir.dyn.payload.alloc");
            if (payload == null) { return null; }
            let src_value = self.lower_value(value_id);
            if (src_value == null) {
                self.report_error("cannot lower dyn trait payload value for " + llvm_mir_type_text(&self.m, src_type_id));
                return null;
            }
            vyx_rt_build_store(self.mod, src_value, payload);
        }
        if (llvm_mir_timing_enabled()) {
            let now_payload = vyx_bootstrap_now_ms();
            timing_payload = now_payload - timing_mark;
            timing_mark = now_payload;
        }
        let dyn_slot = vyx_rt_build_alloca(self.mod, dyn_ty, "mir.dyn.value".c_str(), 13);
        if (dyn_slot == null) {
            self.report_error("cannot allocate dyn trait value for " + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        let data_field = self.dyn_trait_field_ptr(dyn_slot, dyn_type_id, 0, "dyn.data");
        if (data_field == null) {
            self.report_error("cannot address dyn trait data field");
            return null;
        }
        vyx_rt_build_store(self.mod, payload, data_field);
        if (llvm_mir_timing_enabled()) {
            let now_slot = vyx_bootstrap_now_ms();
            timing_slot = now_slot - timing_mark;
            timing_mark = now_slot;
        }
        let vtable = self.get_or_create_dyn_vtable_global(src_type_id, dyn_type_id);
        if (vtable == null) {
            self.report_error("cannot resolve dyn trait vtable for "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " as "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_vtable = vyx_bootstrap_now_ms();
            timing_vtable = now_vtable - timing_mark;
            timing_mark = now_vtable;
        }
        let vtable_field = self.dyn_trait_field_ptr(dyn_slot, dyn_type_id, 1, "dyn.vtable");
        if (vtable_field == null) {
            self.report_error("cannot address dyn trait vtable field");
            return null;
        }
        vyx_rt_build_store(self.mod, vtable, vtable_field);
        let out = vyx_rt_build_load(self.mod, dyn_ty, dyn_slot, "mir.dyn.val".c_str(), 11);
        if (llvm_mir_timing_enabled()) {
            let timing_total = vyx_bootstrap_now_ms() - timing_start;
            if (timing_total >= llvm_mir_slow_instr_threshold_ms()) {
                print("[mir-timing] dyn-conv fn #" + policy_i64_to_string(self.current_function_id as i64)
                      + " " + self.m.function_name(self.current_function_id)
                      + " value=" + policy_i64_to_string(value_id as i64)
                      + " src=" + llvm_mir_type_text(&self.m, src_type_id)
                      + " dst=" + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " type=" + timing_type.toString()
                      + " probe=" + timing_probe.toString()
                      + " payload=" + timing_payload.toString()
                      + " slot=" + timing_slot.toString()
                      + " vtable=" + timing_vtable.toString()
                      + " total=" + timing_total.toString() + " ms");
            }
        }
        return out;
    }

    public fn lower_variant_tag_value(self, variant_id: i32) -> rawptr {
        let tag = mir_unit_variant_tag(&self.m, variant_id);
        if (tag < 0) {
            self.report_error("cannot resolve enum variant tag for variant #" + policy_i64_to_string(variant_id as i64));
            return null;
        }
        return vyx_rt_const_int(self.mod, self.ty_i32, tag as i64, 0);
    }

    public fn result_tag_for_variant_name(self, variant_name: string) -> rawptr {
        if (variant_name == "Ok") { return vyx_rt_const_int(self.mod, self.ty_i32, 0, 0); }
        if (variant_name == "Err") { return vyx_rt_const_int(self.mod, self.ty_i32, 1, 0); }
        self.report_error("unknown Result variant " + variant_name);
        return null;
    }

    public fn lower_array_aggregate_value(self, value_id: i32) -> rawptr {
        let type_id = self.value_effective_type(value_id);
        let elem_type = hir_type_table_elem(self.m.types, type_id);
        let elem_ty = self.lower_type(elem_type);
        let array_ty = self.lower_type(type_id);
        let array_len = self.array_length_for_type(type_id);
        if (elem_type == mir_id_invalid()
            || elem_ty == null
            || array_ty == null
            || array_len < 0) {
            self.report_error("cannot lower array aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, array_ty, "mir.array.aggregate".c_str(), 19);
        let zero_init = vyx_rt_const_null(self.mod, array_ty);
        if (tmp == null || zero_init == null) {
            self.report_error("cannot allocate array aggregate storage for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        let repeat_count_value = self.m.value_aux(value_id);
        if (repeat_count_value != mir_id_invalid()) {
            if (self.m.value_kind(repeat_count_value) != mir_value_const_int()) {
                self.report_error("array repeat count is not a compile-time integer for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let repeat_count = self.m.value_int(repeat_count_value);
            if (repeat_count != array_len) {
                self.report_error("array repeat count "
                          + policy_i64_to_string(repeat_count)
                          + " does not match "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_id = self.m.value_first_arg(value_id);
            if (elem_id == mir_id_invalid()) {
                self.report_error("array repeat aggregate has no element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (self.m.value_next_arg(elem_id) != mir_id_invalid()) {
                self.report_error("array repeat aggregate has more than one element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (mir_unit_value_aggregate_field(&self.m, elem_id) != mir_id_invalid()) {
                self.report_error("array repeat element has a record FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_value = self.lower_value_as(elem_id, elem_type);
            if (elem_value == null) {
                self.report_error("cannot lower array repeat element for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var repeat_idx: i64 = 0;
            while (repeat_idx < array_len) {
                let elem_ptr = vyx_rt_build_gep2(self.mod,
                                                 array_ty,
                                                 tmp,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, repeat_idx, 0),
                                                 "mir.array.repeat.elem".c_str(),
                                                 21);
                if (elem_ptr == null) {
                    self.report_error("cannot address array repeat element #"
                              + policy_i64_to_string(repeat_idx)
                              + " for "
                              + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                vyx_rt_build_store(self.mod, elem_value, elem_ptr);
                repeat_idx = repeat_idx + 1;
            }
            return vyx_rt_build_load(self.mod, array_ty, tmp, "mir.array.aggregate.val".c_str(), 23);
        }
        var idx: i64 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (idx >= array_len) {
                self.report_error("array aggregate has too many elements for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (mir_unit_value_aggregate_field(&self.m, cur) != mir_id_invalid()) {
                self.report_error("array aggregate element has a record FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_ptr = vyx_rt_build_gep2(self.mod,
                                             array_ty,
                                             tmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i64, idx, 0),
                                             "mir.array.elem".c_str(),
                                             14);
            let elem_value = self.lower_value_as(cur, elem_type);
            if (elem_ptr == null || elem_value == null) {
                self.report_error("cannot lower array aggregate element #"
                          + policy_i64_to_string(idx)
                          + " for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            vyx_rt_build_store(self.mod, elem_value, elem_ptr);
            idx = idx + 1;
            cur = self.m.value_next_arg(cur);
        }
        if (idx != array_len) {
            self.report_error("array aggregate element count "
                      + policy_i64_to_string(idx)
                      + " does not match "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_build_load(self.mod, array_ty, tmp, "mir.array.aggregate.val".c_str(), 23);
    }

    // A record literal lowered inside a generic context can carry the OPEN
    // template type (e.g. `Pair` with fields T/U) while the destination slot
    // uses the closed instance layout (`Pair::<str,i64>`). Building the value
    // with the template layout and reading it back with the instance layout
    // silently corrupts every field past the first; when the destination is a
    // closed same-family record, the aggregate must adopt its layout.
    public fn aggregate_should_use_destination_layout(self, src_type_id: i32, dst_type_id: i32) -> bool {
        if (src_type_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return false; }
        if (src_type_id == dst_type_id) { return false; }
        let src_canonical = self.canonical_record_type_id(src_type_id);
        let dst_canonical = self.canonical_record_type_id(dst_type_id);
        if (src_canonical == dst_canonical) { return false; }
        if (mir_unit_field_count_for_type(&self.m, dst_canonical) <= 0) { return false; }
        let src_base = policy_generic_call_base(llvm_mir_type_text(&self.m, src_canonical).clone());
        let dst_base = policy_generic_call_base(llvm_mir_type_text(&self.m, dst_canonical).clone());
        if (!self.type_text_equivalent(src_base, dst_base)) { return false; }
        return !self.record_layout_fields_are_closed(src_canonical);
    }

    public fn lower_aggregate_value(self, value_id: i32) -> rawptr {
        return self.lower_aggregate_value_with_type(value_id, self.m.value_type(value_id));
    }

    public fn lower_aggregate_value_with_type(self, value_id: i32, type_id: i32) -> rawptr {
        if (llvm_mir_type_kind(&self.m, type_id) == ty_ARRAY()) {
            return self.lower_array_aggregate_value(value_id);
        }
        if (llvm_mir_type_kind(&self.m, type_id) == ty_TUPLE()) {
            return self.lower_tuple_aggregate_value(value_id);
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.lower_class_pointer_aggregate_value_with_type(value_id, type_id);
        }
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.lower_type(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (field_count <= 0) {
            if (self.m.value_first_arg(value_id) != mir_id_invalid()) {
                self.report_error("aggregate has fields but no record layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return vyx_rt_const_null(self.mod, record_ty);
        }
        let tmp = vyx_rt_build_alloca(self.mod, record_ty, "mir.aggregate".c_str(), 13);
        let seen = malloc((field_count * 4) as u64);
        if (tmp == null || seen == null) {
            self.report_error("cannot allocate aggregate storage");
            return null;
        }
        memset(seen, 0, (field_count * 4) as u64);
        let zero_init = vyx_rt_const_null(self.mod, record_ty);
        if (zero_init == null) {
            free(seen);
            self.report_error("cannot build aggregate zero initializer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            var field_id = mir_unit_value_aggregate_field(&self.m, cur);
            // Resolve against owner_type — the SAME id the record layout
            // (record_ty / field_count) was derived from — so field_index is
            // always taken from the layout actually GEPed into.
            field_id = self.remapped_field_for_base(owner_type, field_id);
            if (field_id == mir_id_invalid()
                || !self.field_owner_accepts_base_type(mir_unit_field_owner_type(&self.m, field_id), type_id)) {
                free(seen);
                self.report_error("aggregate field argument has no resolved FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let field_index = mir_unit_field_index(&self.m, field_id);
            if (field_index < 0 || field_index >= field_count) {
                free(seen);
                self.report_error("aggregate field index is out of range for " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            if (ast_read_i32(ptr_offset(seen, field_index * 4)) != 0) {
                free(seen);
                self.report_error("aggregate field is assigned more than once: " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            ast_write_i32(ptr_offset(seen, field_index * 4), 1);
            let field_ptr = vyx_rt_build_gep2(self.mod,
                                              record_ty,
                                              tmp,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              vyx_rt_const_int(self.mod, self.ty_i32, field_index as i64, 0),
                                              mir_unit_field_name(&self.m, field_id).c_str(),
                                              mir_unit_field_name(&self.m, field_id).len as u64);
            let field_value = self.lower_value_as(cur, mir_unit_field_type(&self.m, field_id));
            if (field_ptr == null || field_value == null) {
                free(seen);
                self.report_error("cannot lower aggregate field " + mir_unit_field_name(&self.m, field_id));
                return null;
            }
            vyx_rt_build_store(self.mod, field_value, field_ptr);
            cur = self.m.value_next_arg(cur);
        }
        free(seen);
        return vyx_rt_build_load(self.mod, record_ty, tmp, "mir.aggregate.val".c_str(), 17);
    }

    public fn lower_class_pointer_aggregate_value(self, value_id: i32) -> rawptr {
        return self.lower_class_pointer_aggregate_value_with_type(value_id, self.m.value_type(value_id));
    }

    // Initialize an already-selected class record destination from a MIR
    // aggregate.  The normal value path supplies a heap object; the shared
    // MIR automatic-storage plan supplies a local record alloca.  Keeping
    // field initialization here prevents LLVM and MIR2CPP from inventing
    // different storage rules for the same aggregate.
    public fn initialize_class_pointer_aggregate_into(self,
                                                      value_id: i32,
                                                      type_id: i32,
                                                      obj: rawptr) -> bool {
        if (obj == null) {
            self.report_error("cannot initialize null class aggregate destination for "
                              + llvm_mir_type_text(&self.m, type_id));
            return false;
        }
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.class_record_storage_ty(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower class aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return false;
        }
        var size_bytes = vyx_rt_type_alloc_size(self.mod, record_ty);
        let dci_size_bytes = self.dci_record_size_bytes_for_type(owner_type);
        if (dci_size_bytes > 0) {
            size_bytes = dci_size_bytes;
        } else if (self.type_is_foreign_dci(owner_type)) {
            self.report_error("missing DCI record layout for external type "
                              + llvm_mir_type_text(&self.m, owner_type));
            return false;
        }
        if (size_bytes <= 0) {
            var measured_fields = field_count;
            if (measured_fields <= 0) { measured_fields = 1; }
            size_bytes = ((measured_fields as i64) * 8) + 16;
        }
        let fully_initialized = value_id != mir_id_invalid()
            && field_count > 0
            && self.call_arg_count(value_id) >= field_count;
        if (!fully_initialized) {
            if (self.builtin_memset_fn == null || self.builtin_memset_fty == null) {
                self.report_error("memset is not declared before class aggregate initialization");
                return false;
            }
            let zeroed = vyx_rt_build_call3(self.mod,
                                             self.builtin_memset_fty,
                                             self.builtin_memset_fn,
                                             obj,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                             llvm_mir_empty_name(),
                                             0);
            if (zeroed == null) {
                self.report_error("cannot clear class object " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
        }
        if (field_count <= 0) {
            if (self.m.value_first_arg(value_id) != mir_id_invalid()) {
                self.report_error("class aggregate has fields but no record layout for " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
            return true;
        }
        let seen = malloc((field_count * 4) as u64);
        if (seen == null) {
            self.report_error("cannot allocate class aggregate field map");
            return false;
        }
        memset(seen, 0, (field_count * 4) as u64);
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            var field_id = mir_unit_value_aggregate_field(&self.m, cur);
            // Same layout-source unification as lower_aggregate_value: map
            // against owner_type, whose storage type is being GEPed into.
            field_id = self.remapped_field_for_base(owner_type, field_id);
            if (field_id == mir_id_invalid()
                || !self.field_owner_accepts_base_type(mir_unit_field_owner_type(&self.m, field_id), type_id)) {
                free(seen);
                self.report_error("class aggregate field argument has no resolved FieldId for " + llvm_mir_type_text(&self.m, type_id));
                return false;
            }
            let field_index = mir_unit_field_index(&self.m, field_id);
            if (field_index < 0 || field_index >= field_count) {
                free(seen);
                self.report_error("class aggregate field index is out of range for " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            if (ast_read_i32(ptr_offset(seen, field_index * 4)) != 0) {
                free(seen);
                self.report_error("class aggregate field is assigned more than once: " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            ast_write_i32(ptr_offset(seen, field_index * 4), 1);
            var field_ptr: rawptr = null;
            if (self.foreign_dci_field_record_type(owner_type, field_id) != mir_id_invalid()) {
                field_ptr = self.dci_field_addr(obj, owner_type, field_id);
            } else if (self.type_is_dci_stub_class(owner_type)) {
                field_ptr = self.dci_stub_state_field_addr(obj, owner_type, field_id);
            } else {
                field_ptr = vyx_rt_build_gep2(self.mod,
                                              record_ty,
                                              obj,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              vyx_rt_const_int(self.mod, self.ty_i32, field_index as i64, 0),
                                              mir_unit_field_name(&self.m, field_id).c_str(),
                                              mir_unit_field_name(&self.m, field_id).len as u64);
            }
            let field_value = self.lower_value_as(cur, mir_unit_field_type(&self.m, field_id));
            if (field_ptr == null || field_value == null) {
                free(seen);
                self.report_error("cannot lower class aggregate field " + mir_unit_field_name(&self.m, field_id));
                return false;
            }
            vyx_rt_build_store(self.mod, field_value, field_ptr);
            cur = self.m.value_next_arg(cur);
        }
        free(seen);
        return true;
    }

    // Allocate the implicit `self` receiver storage for a constructor call.
    // A native value-ABI class constructs in automatic storage (C++ value
    // semantics): the caller supplies a zeroed stack record, the constructor
    // body writes fields through the `self` pointer, and the constructor
    // returns the record by value (see the self-pointer read path).  Only
    // foreign-DCI/pointer-ABI receivers keep the owning heap allocation.
    public fn lower_constructor_self_storage(self, type_id: i32) -> rawptr {
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.lower_class_pointer_aggregate_value_with_type(mir_id_invalid(), type_id);
        }
        let record_ty = self.class_record_storage_ty(type_id);
        if (record_ty == null) {
            self.report_error("cannot lower constructor receiver type "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let slot = vyx_rt_build_alloca(self.mod, record_ty, "mir.ctor.self".c_str(), 13);
        if (slot == null) {
            self.report_error("cannot allocate constructor receiver storage for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let zero_init = vyx_rt_const_null(self.mod, record_ty);
        if (zero_init == null) {
            self.report_error("cannot zero-initialize constructor receiver for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, slot);
        return slot;
    }

    public fn lower_class_pointer_aggregate_value_with_type(self, value_id: i32, type_id: i32) -> rawptr {
        let owner_type = self.canonical_record_type_id(type_id);
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        let record_ty = self.class_record_storage_ty(owner_type);
        if (record_ty == null) {
            self.report_error("cannot lower class aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var size_bytes = vyx_rt_type_alloc_size(self.mod, record_ty);
        let dci_size_bytes = self.dci_record_size_bytes_for_type(owner_type);
        if (dci_size_bytes > 0) {
            size_bytes = dci_size_bytes;
        } else if (self.type_is_foreign_dci(owner_type)) {
            self.report_error("missing DCI record layout for external type "
                      + llvm_mir_type_text(&self.m, owner_type));
            return null;
        }
        if (size_bytes <= 0) {
            var measured_fields = field_count;
            if (measured_fields <= 0) { measured_fields = 1; }
            size_bytes = ((measured_fields as i64) * 8) + 16;
        }
        let obj = llvm_lifetime_allocate_class_storage(self.mod, size_bytes, "mir.class.alloc",
                                                        self.builtin_class_alloc_fty, self.builtin_class_alloc_fn,
                                                        self.builtin_malloc_fty, self.builtin_malloc_fn,
                                                        self.builtin_free_fn,
                                                        self.type_is_foreign_dci(owner_type));
        if (obj == null) {
            self.report_error("cannot allocate class object " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (!self.initialize_class_pointer_aggregate_into(value_id, type_id, obj)) { return null; }
        return obj;
    }

    public fn lower_tuple_aggregate_value(self, value_id: i32) -> rawptr {
        let type_id = self.m.value_type(value_id);
        let elem_count = self.tuple_element_count_for_type(type_id);
        let tuple_ty = self.lower_type(type_id);
        if (tuple_ty == null || elem_count <= 0) {
            self.report_error("cannot lower tuple aggregate type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, tuple_ty, "mir.tuple.aggregate".c_str(), 19);
        if (tmp == null) {
            self.report_error("cannot allocate tuple aggregate storage");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_null(self.mod, tuple_ty), tmp);
        var cur = self.m.value_first_arg(value_id);
        var idx: i32 = 0;
        while (cur != mir_id_invalid()) {
            if (idx >= elem_count) {
                self.report_error("tuple aggregate has too many elements for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let elem_type = self.tuple_element_type_id(type_id, idx);
            let elem_value = self.lower_value_as(cur, elem_type);
            let elem_ptr = vyx_rt_build_gep2(self.mod,
                                             tuple_ty,
                                             tmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                             "tuple.elem".c_str(),
                                             10);
            if (elem_type == mir_id_invalid() || elem_value == null || elem_ptr == null) {
                self.report_error("cannot lower tuple element #" + policy_i64_to_string(idx as i64));
                return null;
            }
            vyx_rt_build_store(self.mod, elem_value, elem_ptr);
            cur = self.m.value_next_arg(cur);
            idx = idx + 1;
        }
        if (idx != elem_count) {
            self.report_error("tuple aggregate has " + policy_i64_to_string(idx as i64)
                      + " elements but expected " + policy_i64_to_string(elem_count as i64));
            return null;
        }
        return vyx_rt_build_load(self.mod, tuple_ty, tmp, "mir.tuple.val".c_str(), 13);
    }

    public fn lower_explicit_new_intrinsic(self, value_id: i32) -> rawptr {
        let payload_type = self.m.value_target_id(value_id);
        if (payload_type == mir_id_invalid()) {
            self.report_error("new allocation is missing its payload type");
            return null;
        }
        let init_value_id = self.m.value_rhs(value_id);
        let first_arg = self.m.value_first_arg(value_id);

        // Explicit `new` has an owning heap lifetime.  Do not route a class
        // aggregate initializer through the ordinary class-value path: that
        // path intentionally uses the small-object automatic/bump allocator
        // for non-escaping values, while `delete` must be able to release an
        // explicit allocation with the normal free ABI.
        if (self.type_is_class_pointer_abi(payload_type)
            && init_value_id != mir_id_invalid()) {
            let init_storage_ty = self.lower_storage_type(payload_type);
            if (init_storage_ty == null) {
                self.report_error("cannot lower allocated storage type "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            var init_bytes = vyx_rt_type_alloc_size(self.mod, init_storage_ty);
            let init_dci_bytes = self.dci_record_size_bytes_for_type(payload_type);
            if (init_dci_bytes > 0) {
                init_bytes = init_dci_bytes;
            }
            if (init_bytes <= 0) {
                var init_fields = mir_unit_field_count_for_type(&self.m,
                                                                 self.canonical_record_type_id(payload_type));
                if (init_fields <= 0) { init_fields = 1; }
                init_bytes = ((init_fields as i64) * 8) + 16;
            }
            let object = self.malloc_bytes_value(init_bytes,
                                                 "new." + llvm_mir_type_text(&self.m, payload_type));
            if (object == null) { return null; }
            if (!self.initialize_class_pointer_aggregate_into(init_value_id,
                                                               payload_type,
                                                               object)) {
                return null;
            }
            return self.pointer_handle_from_raw(object,
                                                payload_type,
                                                1,
                                                0,
                                                "mir.new.class");
        }

        // Runtime-length array allocation: `new [T; expr]()` with a
        // non-constant size. The payload type has no concrete LLVM length,
        // so allocate count * elem_size bytes; the count value arrives via
        // the value aux slot (built from the array size expression by the
        // HIR builder). The result is a handle over the element storage,
        // which then decays to `*T` like any other array allocation.
        // Generic instantiations record the payload either as `ptr<[T; e]>`
        // or as a textually-interned class named `[i32;c#83#r]`, so detect
        // runtime arrays by text, not just by type kind.
        var rt_payload = payload_type;
        if (llvm_mir_type_kind(&self.m, rt_payload) == ty_PTR()) {
            let rt_pe = hir_type_table_elem(self.m.types, rt_payload);
            if (rt_pe != mir_id_invalid()
                && llvm_mir_type_kind(&self.m, rt_pe) == ty_ARRAY()) {
                rt_payload = rt_pe;
            }
        }
        let rt_text = llvm_mir_type_text(&self.m, rt_payload);
        var rt_is_array = llvm_mir_type_kind(&self.m, rt_payload) == ty_ARRAY();
        if (!rt_is_array
            && llvm_mir_type_kind(&self.m, rt_payload) == ty_CLASS()
            && rt_text.len > 1
            && rt_text.charAt(0) == 91) {
            // Textually-interned array type (mono substitution artifact).
            rt_is_array = true;
        }
        if (llvm_mir_env_enabled("VYX_DUMP_RTARRAY")) {
            var aux_state = "set";
            if (self.m.value_aux(value_id) == mir_id_invalid()) { aux_state = "none"; }
            print("[rtarray] payload=" + llvm_mir_type_text(&self.m, payload_type)
                  + " rt_payload=" + rt_text
                  + " is_array=" + (rt_is_array as i64).toString()
                  + " len=" + self.array_length_from_type_text(rt_text).toString()
                  + " aux=" + aux_state);
        }
        if (rt_is_array
            && self.array_length_from_type_text(rt_text) < 0) {
            let rt_count_value = self.m.value_aux(value_id);
            if (rt_count_value == mir_id_invalid()) {
                self.report_error("array allocation has no concrete length: " + rt_text);
                return null;
            }
            if (init_value_id != mir_id_invalid() || first_arg != mir_id_invalid()) {
                self.report_error("runtime-length array allocation supports only an empty () initializer");
                return null;
            }
            var rt_elem_id = hir_type_table_elem(self.m.types, rt_payload);
            if (rt_elem_id == mir_id_invalid()) {
                rt_elem_id = self.rtarray_elem_type_id_from_text(rt_text);
            }
            if (rt_elem_id == mir_id_invalid()) {
                self.report_error("cannot lower runtime array element type " + rt_text);
                return null;
            }
            let rt_elem_ty = self.lower_type(rt_elem_id);
            if (rt_elem_ty == null) { return null; }
            var rt_elem_bytes = vyx_rt_type_alloc_size(self.mod, rt_elem_ty);
            if (rt_elem_bytes <= 0) { rt_elem_bytes = 1; }
            let rt_count_lowered = self.lower_value(rt_count_value);
            if (rt_count_lowered == null) { return null; }
            let rt_count_i64 = self.int_value_to_bits(rt_count_lowered,
                                                       self.m.value_type(rt_count_value),
                                                       64);
            if (rt_count_i64 == null) { return null; }
            let rt_bytes_v = vyx_rt_build_mul(self.mod,
                                               rt_count_i64,
                                               vyx_rt_const_int(self.mod, self.ty_i64, rt_elem_bytes, 0),
                                               "new.rtarray.bytes".c_str(),
                                               17);
            if (rt_bytes_v == null) { return null; }
            let rt_mem = self.malloc_bytes_runtime(rt_bytes_v, "new.rtarray");
            if (rt_mem == null) { return null; }
            return self.runtime_array_handle_from_raw(rt_mem,
                                                       rt_elem_id,
                                                       rt_bytes_v,
                                                       "new.rtarray");
        }

        let storage_ty = self.lower_storage_type(payload_type);
        if (storage_ty == null) {
            self.report_error("cannot lower allocated storage type "
                      + llvm_mir_type_text(&self.m, payload_type));
            return null;
        }
        let bytes = vyx_rt_type_alloc_size(self.mod, storage_ty);
        let mem = self.malloc_bytes_value(bytes,
                                          "new." + llvm_mir_type_text(&self.m, payload_type));
        if (mem == null) { return null; }

        var initialized: bool = false;
        if (init_value_id != mir_id_invalid()) {
            let init_value = self.lower_value_as(init_value_id, payload_type);
            if (init_value == null) {
                self.report_error("cannot lower aggregate initializer for new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, init_value, mem);
            initialized = true;
        } else if (first_arg != mir_id_invalid()) {
            let scalar_init = self.lower_value_as(first_arg, payload_type);
            if (scalar_init == null) {
                self.report_error("cannot lower initializer for new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, scalar_init, mem);
            initialized = true;
        }
        if (!initialized) {
            let zero = vyx_rt_const_null(self.mod, storage_ty);
            if (zero == null) {
                self.report_error("cannot zero initialize new "
                          + llvm_mir_type_text(&self.m, payload_type));
                return null;
            }
            vyx_rt_build_store(self.mod, zero, mem);
        }
        return self.pointer_handle_from_raw(mem,
                                            payload_type,
                                            1,
                                            0,
                                            "mir.new");
    }

    public fn lower_explicit_delete_intrinsic(self, value_id: i32) -> rawptr {
        let operand_id = self.m.value_lhs(value_id);
        if (operand_id == mir_id_invalid()) {
            self.report_error("delete is missing its pointer operand");
            return null;
        }
        let ptr = self.lower_value(operand_id);
        if (ptr == null) {
            self.report_error("cannot lower delete pointer operand");
            return null;
        }
        let operand_type = self.m.value_type(operand_id);
        let operand_kind = llvm_mir_type_kind(&self.m, operand_type);
        var released: rawptr = null;
        if (llvm_mir_kind_pointer_handle(operand_kind)) {
            let metadata = self.pointer_handle_metadata(ptr, "mir.delete");
            if (metadata == null) {
                self.report_error("cannot extract pointer region for delete");
                return null;
            }
            let released_address = self.pointer_region_delete(metadata);
            if (released_address == null) {
                self.report_error("cannot invalidate pointer region for delete");
                return null;
            }
            if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
                self.report_error("free is not declared before delete");
                return null;
            }
            released = vyx_rt_build_call1(self.mod,
                                          self.builtin_free_fty,
                                          self.builtin_free_fn,
                                          released_address,
                                          llvm_mir_empty_name(),
                                          0);
        } else {
            if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
                self.report_error("free is not declared before delete");
                return null;
            }
            released = vyx_rt_build_call1(self.mod,
                                          self.builtin_free_fty,
                                          self.builtin_free_fn,
                                          ptr,
                                          llvm_mir_empty_name(),
                                          0);
        }
        let operand_place = self.m.value_place(value_id);
        if (operand_place != mir_id_invalid()) {
            let place_addr = self.lower_place_addr(operand_place);
            let operand_ll_type = self.lower_type(operand_type);
            if (place_addr == null || operand_ll_type == null) {
                self.report_error("cannot clear pointer handle after delete");
                return null;
            }
            vyx_rt_build_store(self.mod,
                               vyx_rt_const_null(self.mod, operand_ll_type),
                               place_addr);
        }
        return released;
    }

    public fn lower_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        var timing_value_start: i64 = 0;
        if (llvm_mir_timing_enabled()) { timing_value_start = vyx_bootstrap_now_ms(); }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_call() && llvm_mir_env_enabled("VYX_TRACE_IDXPLACE")) {
            var trace_target_name = "";
            if (self.m.value_target_kind(value_id) == mir_target_function()
                && self.m.value_target_id(value_id) != mir_id_invalid()) {
                trace_target_name = self.m.function_name(self.m.value_target_id(value_id));
            }
            print("[idxplace] lower_value call value=" + policy_i64_to_string(value_id as i64)
                  + " target=" + policy_i64_to_string(self.m.value_target_id(value_id) as i64)
                  + " fn=" + trace_target_name);
            fflush(null);
        }
        if (vyx_bootstrap_profile_level() > 2) {
            var target_name = "";
            if (self.m.value_target_kind(value_id) == mir_target_function()
                && self.m.value_target_id(value_id) != mir_id_invalid()) {
                target_name = self.m.function_name(self.m.value_target_id(value_id));
            }
            print("[llvm-mir-value] before fn="
                  + policy_i64_to_string(self.current_function_id as i64)
                  + " value=" + policy_i64_to_string(value_id as i64)
                  + " kind=" + policy_i64_to_string(kind as i64)
                  + " type=" + policy_i64_to_string(self.m.value_type(value_id) as i64)
                  + " lhs=" + policy_i64_to_string(self.m.value_lhs(value_id) as i64)
                  + " rhs=" + policy_i64_to_string(self.m.value_rhs(value_id) as i64)
                  + " aux=" + policy_i64_to_string(self.m.value_aux(value_id) as i64)
                  + " first_arg=" + policy_i64_to_string(self.m.value_first_arg(value_id) as i64)
                  + " next_arg=" + policy_i64_to_string(self.m.value_next_arg(value_id) as i64)
                  + " target_kind=" + policy_i64_to_string(self.m.value_target_kind(value_id) as i64)
                  + " target=" + policy_i64_to_string(self.m.value_target_id(value_id) as i64)
                  + " name=" + self.m.value_name(value_id)
                  + " target_name=" + target_name);
        }
        let cacheable = kind != mir_value_read_place();
        if (cacheable) {
            let cached = llvm_mir_map_get(self.value_cache, value_id);
            if (cached != null) { return cached; }
        }
        let type_id = self.value_effective_type(value_id);
        let type_kind = llvm_mir_type_kind(&self.m, type_id);
        var out: rawptr = null;
        if (kind == mir_value_arg()) {
            out = self.lower_value_as(self.m.value_lhs(value_id), type_id);
        } else if (kind == mir_value_const_int()) {
            var bits = llvm_mir_int_bits_for_kind(type_kind);
            if (bits <= 0) { bits = 64; }
            out = vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), self.m.value_int(value_id), 1);
        } else if (kind == mir_value_const_float()) {
            var text = self.m.value_text(value_id);
            if (text.len == 0) { text = policy_i64_to_string(self.m.value_int(value_id)); }
            let ll_ty = self.lower_type(type_id);
            if (ll_ty == null) {
                self.report_error("cannot lower float literal type " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            out = vyx_rt_const_real(self.mod, ll_ty, strtod(text.c_str(), null));
            if (out == null) {
                self.report_error("cannot lower float literal " + text);
                return null;
            }
        } else if (kind == mir_value_const_bool()) {
            out = vyx_rt_const_int(self.mod, self.ty_i8, self.m.value_int(value_id), 0);
        } else if (kind == mir_value_const_char()) {
            let char_type = self.lower_type(type_id);
            if (char_type == null) {
                self.report_error("cannot lower char literal type " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            out = vyx_rt_const_int(self.mod, char_type, self.m.value_int(value_id), 0);
        } else if (kind == mir_value_const_str()) {
            if (self.m.value_first_arg(value_id) != mir_id_invalid()) {
                out = self.lower_interpolated_string_value(value_id);
            } else {
                out = self.emit_str_value(self.m.value_text(value_id));
            }
        } else if (kind == mir_value_null()) {
            if (self.type_is_option_abi(type_id)) {
                out = self.build_option_value_from_parts(type_id,
                                                          vyx_rt_const_int(self.mod, self.ty_i32, 1, 0),
                                                          null);
            } else if (self.type_is_result_abi(type_id)) {
                out = self.build_result_value_from_parts(type_id,
                                                         vyx_rt_const_int(self.mod, self.ty_i32, 1, 0),
                                                         null,
                                                         null);
            } else if (llvm_mir_kind_pointer_handle(type_kind)) {
                out = self.pointer_handle_null();
            } else if (llvm_mir_kind_pointer_like(type_kind)) {
                out = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
            } else if (self.type_is_class_pointer_abi(type_id)) {
                out = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
            } else if (type_kind == ty_STRING()) {
                out = self.emit_str_value("");
            } else {
                out = vyx_rt_const_null(self.mod, self.lower_type(type_id));
            }
        } else if (kind == mir_value_read_place()) {
            let place_id = self.m.value_place(value_id);
            let addr = self.lower_place_addr(place_id);
            if (addr == null) {
                self.report_error("cannot lower read-place address for value #"
                          + policy_i64_to_string(value_id as i64));
                return null;
            }
            if (self.dci_bitfield_for_place(place_id) != null) {
                out = self.lower_dci_bitfield_read(place_id, addr, type_id);
                if (out == null) { return null; }
            } else if (self.place_is_self_pointer_abi_slot(place_id)) {
                let obj_addr = self.load_self_pointer_abi_slot(place_id, addr, type_id);
                if (obj_addr == null) { return null; }
                if (self.type_is_class_pointer_abi(type_id)) {
                    out = obj_addr;
                } else {
                    let load_ty0 = self.lower_type(type_id);
                    out = vyx_rt_build_load(self.mod, load_ty0, obj_addr, llvm_mir_empty_name(), 0);
                    if (out == null) {
                        self.report_error("cannot load self object value for value #"
                                  + policy_i64_to_string(value_id as i64)
                                  + " as "
                                  + llvm_mir_type_text(&self.m, type_id));
                        return null;
                    }
                }
            } else if (self.type_is_class_pointer_abi(type_id)
                && self.place_is_direct_class_object_pointer(place_id)) {
                out = addr;
            } else {
                // The address above was remapped onto the concrete layout
                // slot; load with the mapped field type (the value may still
                // carry the template field type) and normalize back to the
                // declared value type for downstream consumers.
                var load_type_id = type_id;
                if (self.m.place_kind(place_id) == mir_place_field()) {
                    let mapped_field = self.mapped_field_id_for_place(place_id);
                    if (mapped_field != mir_id_invalid()) {
                        let mapped_type = mir_unit_field_type(&self.m, mapped_field);
                        if (mapped_type != mir_id_invalid()) { load_type_id = mapped_type; }
                    }
                }
                let load_ty = self.lower_type(load_type_id);
                if (self.place_is_volatile_local(place_id)) {
                    out = vyx_rt_build_load_volatile(self.mod, load_ty, addr,
                                                     llvm_mir_empty_name(), 0);
                } else if (self.m.place_kind(place_id) == mir_place_deref()) {
                    out = vyx_rt_build_load(self.mod, load_ty, addr, llvm_mir_empty_name(), 0);
                    if (out != null && self.ptr_alias_domain != null) {
                        vyx_rt_set_alias_scopes(self.mod, out, self.ptr_alias_domain, 1);
                    }
                } else {
                    out = vyx_rt_build_load(self.mod, load_ty, addr, llvm_mir_empty_name(), 0);
                }
                if (out == null) {
                    self.report_error("cannot load place #"
                              + policy_i64_to_string(place_id as i64)
                              + " for value #"
                              + policy_i64_to_string(value_id as i64)
                              + " as "
                              + llvm_mir_type_text(&self.m, load_type_id));
                    return null;
                }
                if (load_type_id != type_id) {
                    out = self.cast_value(out, load_type_id, type_id);
                }
            }
        } else if (kind == mir_value_address_of()) {
            let hoisted_handle = llvm_mir_map_get(self.hoisted_borrow_handles, value_id);
            if (hoisted_handle != null) {
                llvm_mir_map_put(self.value_cache, value_id, hoisted_handle);
                return hoisted_handle;
            }
            let place_id2 = self.m.value_place(value_id);
            if (self.dci_bitfield_for_place(place_id2) != null) {
                self.report_error("DCI bitfield is not addressable for place #" + place_id2.toString());
                return null;
            }
            var capability: i32 = 1;
            if (self.m.value_op(value_id) == 1) { capability = 2; }
            if (self.m.place_kind(place_id2) == mir_place_deref()) {
                let source_value = self.m.place_index_value(place_id2);
                let source_type = self.m.value_type(source_value);
                if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, source_type))) {
                    let source_handle = self.lower_value(source_value);
                    out = self.pointer_handle_retag(source_handle,
                                                    capability,
                                                    "mir.addr.reborrow");
                    if (out == null) {
                        self.report_error("cannot lower pointer reborrow");
                    }
                    llvm_mir_map_put(self.value_cache, value_id, out);
                    return out;
                }
            }
            var addr2 = self.lower_place_addr(place_id2);
            let place_type2 = self.place_effective_type(place_id2);
            if (self.type_is_class_pointer_abi(place_type2)) {
                addr2 = self.class_object_addr_from_place_addr(place_id2, addr2, place_type2);
            }
            var region_payload_type = place_type2;
            // `&arr[i]` (plain address-of on an index place) must also hand out
            // a region covering the whole array, not just the single element:
            // the pointer is expected to stay valid for `ptr + k` arithmetic
            // across sibling elements. Same rule as array.decay.
            if (self.m.place_kind(place_id2) == mir_place_index()) {
                let array_base = self.m.place_base(place_id2);
                let array_type = self.place_effective_type(array_base);
                if (llvm_mir_type_kind(&self.m, array_type) == ty_ARRAY()) {
                    region_payload_type = array_type;
                }
            }
            // Each evaluation of a borrow site must create a FRESH region:
            // vyx_pointer_region_create returns refcount 1 and the compiler
            // pairs it with exactly one frame-end vyx_pointer_region_delete.
            // Caching the handle and reusing it for a later evaluation keeps
            // the handle while the region may already be freed (a stack
            // borrow reuses the same address every iteration), so the program
            // receives a dangling region: UAF, heap corruption, and a null
            // vtable call once D3D12/Renderer.create walks it.  Memoizing
            // here requires the cache to acquire and release the region in
            // lockstep with create/delete; until then, always create.
            out = self.pointer_handle_from_raw(addr2,
                                               region_payload_type,
                                               0,
                                               capability,
                                               "mir.addr");
        } else if (kind == mir_value_unary()) {
            out = self.lower_unary_value(value_id);
        } else if (kind == mir_value_binary()) {
            if (self.type_is_string_view_type(self.m.value_type(self.m.value_lhs(value_id)))
                || self.type_is_string_view_type(self.m.value_type(self.m.value_rhs(value_id)))
                || self.type_is_string_view_type(type_id)) {
                out = self.lower_string_binary_value(value_id);
            } else {
                out = self.lower_binary_value(value_id);
            }
        } else if (kind == mir_value_cast()) {
            out = self.lower_value_as(self.m.value_lhs(value_id), type_id);
        } else if (kind == mir_value_call()) {
            out = self.lower_call_value(value_id);
        } else if (kind == mir_value_target_ref()) {
            if (self.m.value_target_kind(value_id) == mir_target_hir_variant()) {
                if (self.type_is_option_abi(type_id)) {
                    out = self.lower_option_variant_ref(value_id);
                } else if (self.type_is_result_abi(type_id)) {
                    out = self.lower_result_variant_ref(value_id);
                } else if (self.type_is_plain_enum_abi(type_id)) {
                    out = self.lower_enum_variant_ref(value_id);
                } else {
                    out = self.lower_variant_tag_value(self.m.value_target_id(value_id));
                }
            } else if (self.m.value_target_kind(value_id) == mir_target_function()) {
                let target_fn_for_ref = self.m.value_target_id(value_id);
                if (target_fn_for_ref != mir_id_invalid()) {
                    self.declare_function_signature(target_fn_for_ref);
                }
                if (type_kind == ty_FN()) {
                    out = self.build_closure_fat_value(target_fn_for_ref);
                } else {
                    out = llvm_mir_map_get(self.function_values, target_fn_for_ref);
                }
            } else if (self.m.value_target_kind(value_id) == mir_target_hir_item()) {
                let gv = self.get_or_create_hir_item_global(self.m.value_target_id(value_id),
                                                            type_id,
                                                            self.m.value_name(value_id));
                if (gv != null) {
                    out = vyx_rt_build_load(self.mod,
                                            self.lower_type(type_id),
                                            gv,
                                            llvm_mir_empty_name(),
                                            0);
                }
            } else if (self.m.value_target_kind(value_id) == mir_target_builtin()) {
                let bname = self.m.value_name(value_id);
                if (self.tuple_member_index(bname) >= 0) {
                    out = self.lower_tuple_member_value(value_id, bname);
                } else if (bname == "len" || bname == "length" || bname == "size" || bname == "count") {
                    out = self.lower_string_len_call(value_id);
                } else if (bname == "ptr" || bname == "c_str" || bname == "data" || bname == "cap" || bname == "owned") {
                    out = self.lower_string_field_member_value(value_id, bname);
                } else if (bname == "name") {
                    out = self.lower_reflection_name_value(value_id);
                } else if (bname == "kind") {
                    out = self.lower_reflection_kind_value(value_id);
                } else if (bname == "fields" || bname == "methods") {
                    out = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
                } else {
                    self.report_error("cannot lower builtin value " + bname);
                }
            }
        } else if (kind == mir_value_aggregate()) {
            out = self.lower_aggregate_value(value_id);
        } else if (kind == mir_value_control_result()) {
            out = self.lower_control_value(value_id);
        } else if (kind == mir_value_intrinsic()) {
            let intrinsic_name = self.m.value_name(value_id);
            if (intrinsic_name == "__vyx_new") {
                out = self.lower_explicit_new_intrinsic(value_id);
            } else if (intrinsic_name == "__vyx_delete") {
                out = self.lower_explicit_delete_intrinsic(value_id);
            } else if (intrinsic_name == "__vyx_move_handle") {
                let moved_value = self.lower_value(self.m.value_lhs(value_id));
                let source_place = self.m.value_place(value_id);
                let source_addr = self.lower_place_addr(source_place);
                let source_type = self.m.value_type(value_id);
                let source_ll_type = self.lower_type(source_type);
                if (moved_value == null || source_addr == null || source_ll_type == null) {
                    self.report_error("cannot lower ownership move handle");
                    return null;
                }
                vyx_rt_build_store(self.mod,
                                   vyx_rt_const_null(self.mod, source_ll_type),
                                   source_addr);
                out = moved_value;
            } else {
                self.report_error("cannot lower intrinsic value " + intrinsic_name);
            }
        } else {
            self.report_error("cannot lower value #" + policy_i64_to_string(value_id as i64)
                      + " kind=" + policy_i64_to_string(kind as i64));
        }
        if (out != null && cacheable) { llvm_mir_map_put(self.value_cache, value_id, out); }
        if (llvm_mir_timing_enabled()) {
            let timing_value_elapsed = vyx_bootstrap_now_ms() - timing_value_start;
            if (timing_value_elapsed >= llvm_mir_slow_instr_threshold_ms()) {
                print("[mir-timing] value fn #" + policy_i64_to_string(self.current_function_id as i64)
                      + " " + self.m.function_name(self.current_function_id)
                      + " value=" + policy_i64_to_string(value_id as i64)
                      + " kind=" + policy_i64_to_string(kind as i64)
                      + " type=" + llvm_mir_type_text(&self.m, type_id)
                      + " lhs=" + policy_i64_to_string(self.m.value_lhs(value_id) as i64)
                      + " rhs=" + policy_i64_to_string(self.m.value_rhs(value_id) as i64)
                      + " place=" + policy_i64_to_string(self.m.value_place(value_id) as i64)
                      + " target_kind=" + policy_i64_to_string(self.m.value_target_kind(value_id) as i64)
                      + " target=" + policy_i64_to_string(self.m.value_target_id(value_id) as i64)
                      + " elapsed=" + timing_value_elapsed.toString() + " ms");
            }
        }
        if (vyx_bootstrap_profile_level() > 2) {
            var out_null_flag: i64 = 0;
            if (out == null) { out_null_flag = 1; }
            print("[llvm-mir-value] after fn="
                  + policy_i64_to_string(self.current_function_id as i64)
                  + " value=" + policy_i64_to_string(value_id as i64)
                  + " kind=" + policy_i64_to_string(kind as i64)
                  + " out_null=" + policy_i64_to_string(out_null_flag)
                  + " errors=" + policy_i64_to_string(self.error_count as i64));
        }
        return out;
    }

    public fn lower_unary_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        let inner_id = self.m.value_lhs(value_id);
        let type_id = self.m.value_type(value_id);
        let kind = llvm_mir_type_kind(&self.m, type_id);
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (op == llvm_mir_tk_QUESTION()) {
            return self.lower_result_try_value(value_id);
        }
        let inner = self.lower_value(inner_id);
        if (self.type_is_result_abi(type_id)
            && self.m.value_name(value_id).len > 0
            && self.m.value_text(value_id).len > 0) {
            return self.lower_result_fail_value(value_id);
        }
        if (op == llvm_mir_tk_MINUS()) {
            if (kind == ty_F32() || kind == ty_F64()) {
                let zero_f = vyx_rt_const_real(self.mod, self.lower_type(type_id), 0.0);
                return vyx_rt_build_fsub(self.mod,
                                         zero_f,
                                         self.cast_value(inner, self.m.value_type(inner_id), type_id),
                                         llvm_mir_empty_name(),
                                         0);
            }
            if (bits <= 0) {
                self.report_error("cannot apply unary minus to " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let zero = vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), 0, 1);
            return vyx_rt_build_sub(self.mod, zero, self.cast_value(inner, self.m.value_type(inner_id), type_id), llvm_mir_empty_name(), 0);
        }
        if (op == llvm_mir_tk_NOT()) {
            let b = self.truthy_value(inner, self.m.value_type(inner_id));
            let not_v = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_eq(),
                                          b,
                                          vyx_rt_const_int(self.mod, self.ty_i1, 0, 0),
                                          llvm_mir_empty_name(),
                                          0);
            return self.bool_value_i8(not_v);
        }
        if (op == llvm_mir_tk_TILDE()) {
            if (bits <= 0) {
                self.report_error("cannot apply bit-not to " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            let all_ones = vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), -1, 1);
            return vyx_rt_build_xor(self.mod, self.cast_value(inner, self.m.value_type(inner_id), type_id), all_ones, llvm_mir_empty_name(), 0);
        }
        return inner;
    }

    public fn lower_binary_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        let out_type = self.m.value_type(value_id);
        let lhs_id = self.m.value_lhs(value_id);
        let rhs_id = self.m.value_rhs(value_id);
        let lhs_type = self.m.value_type(lhs_id);
        let rhs_type = self.m.value_type(rhs_id);
        // Reference views: when a `&mut T` / `&T` operand participates in a
        // scalar arithmetic/compare expression, the whole binary acts on the
        // pointee values (C++ reference semantics).  Without this the
        // pointer-arithmetic dispatch below would treat the loaded element
        // as an address.
        let out_kind0 = llvm_mir_type_kind(&self.m, out_type);
        let lhs_kind0 = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind0 = llvm_mir_type_kind(&self.m, rhs_type);
        if (lhs_kind0 == ty_MUTREF() || lhs_kind0 == ty_REF()
            || rhs_kind0 == ty_MUTREF() || rhs_kind0 == ty_REF()
            || out_kind0 == ty_MUTREF() || out_kind0 == ty_REF()) {
            var lhs_view = lhs_type;
            var rhs_view = rhs_type;
            var out_view = out_type;
            if (lhs_kind0 == ty_MUTREF() || lhs_kind0 == ty_REF()) {
                let e = hir_type_table_elem(self.m.types, lhs_type);
                if (e != mir_id_invalid()) { lhs_view = e; }
            }
            if (rhs_kind0 == ty_MUTREF() || rhs_kind0 == ty_REF()) {
                let e = hir_type_table_elem(self.m.types, rhs_type);
                if (e != mir_id_invalid()) { rhs_view = e; }
            }
            if (out_kind0 == ty_MUTREF() || out_kind0 == ty_REF()) {
                let e = hir_type_table_elem(self.m.types, out_type);
                if (e != mir_id_invalid()) { out_view = e; }
            }
            if (llvm_mir_map_binop_pred_signed(op) >= 0
                || llvm_mir_map_binop_pred_float(op) >= 0
                || op == llvm_mir_tk_PLUS() || op == llvm_mir_tk_MINUS()
                || op == llvm_mir_tk_STAR() || op == llvm_mir_tk_SLASH()
                || op == llvm_mir_tk_PERCENT()) {
                return self.lower_scalar_binary_view(op, lhs_id, rhs_id, lhs_view, rhs_view, out_view);
            }
        }
        let lhs_kind = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind = llvm_mir_type_kind(&self.m, rhs_type);
        let float_pred = llvm_mir_map_binop_pred_float(op);
        if (float_pred >= 0 && (llvm_mir_kind_float(lhs_kind) || llvm_mir_kind_float(rhs_kind))) {
            let cmp_type = self.binary_float_compare_type_id(lhs_id, rhs_id, lhs_type, rhs_type, out_type);
            let lhs_cmp = self.lower_value_as(lhs_id, cmp_type);
            let rhs_cmp = self.lower_value_as(rhs_id, cmp_type);
            if (lhs_cmp == null || rhs_cmp == null) {
                self.report_error("cannot lower float compare operands");
                return null;
            }
            let cmp = vyx_rt_build_fcmp(self.mod, float_pred, lhs_cmp, rhs_cmp, llvm_mir_empty_name(), 0);
            if (cmp == null) {
                self.report_error("cannot emit float compare op "
                          + policy_i64_to_string(op as i64)
                          + " lhs=" + llvm_mir_type_text(&self.m, lhs_type)
                          + " rhs=" + llvm_mir_type_text(&self.m, rhs_type)
                          + " common=" + llvm_mir_type_text(&self.m, cmp_type)
                          + " runtime=" + self.runtime_last_error());
                return null;
            }
            return self.bool_value_i8(cmp);
        }
        var pred = llvm_mir_map_binop_pred_signed(op);
        if (pred >= 0) {
            let cmp_type = lhs_type;
            let cmp_kind = llvm_mir_type_kind(&self.m, cmp_type);
            if ((op == llvm_mir_tk_EQEQ() || op == llvm_mir_tk_NEQ())
                && self.type_is_heap_indirect_deref_type(lhs_type)
                && self.type_ids_compatible(lhs_type, rhs_type)) {
                let lhs_data = self.lower_record_field_member_value(lhs_id, "data");
                let rhs_data = self.lower_record_field_member_value(rhs_id, "data");
                if (lhs_data == null || rhs_data == null) {
                    self.report_error("cannot lower heap handle compare operands");
                    return null;
                }
                let cmp = vyx_rt_build_icmp(self.mod,
                                            pred,
                                            lhs_data,
                                            rhs_data,
                                            llvm_mir_empty_name(),
                                            0);
                if (cmp == null) {
                    self.report_error("cannot emit heap handle compare for "
                              + llvm_mir_type_text(&self.m, lhs_type)
                              + " runtime=" + self.runtime_last_error());
                    return null;
                }
                return self.bool_value_i8(cmp);
            }
            let cmp_bits = llvm_mir_int_bits_for_kind(cmp_kind);
            let cmp_pointer_like = llvm_mir_kind_pointer_like(cmp_kind)
                || self.type_is_class_pointer_abi(cmp_type);
            if (cmp_bits <= 0 && !cmp_pointer_like) {
                self.report_error("cannot lower non-scalar compare op "
                          + policy_i64_to_string(op as i64)
                          + " lhs=" + llvm_mir_type_text(&self.m, lhs_type)
                          + " rhs=" + llvm_mir_type_text(&self.m, rhs_type));
                return null;
            }
            if (llvm_mir_kind_unsigned(cmp_kind)) { pred = llvm_mir_map_binop_pred_unsigned(op); }
            var lhs_cmp = self.lower_value(lhs_id);
            var rhs_cmp = self.lower_value_as(rhs_id, cmp_type);
            if (lhs_cmp == null || rhs_cmp == null) {
                if (self.error_count > 0) { return null; }
                self.report_error_at_value(value_id, "cannot lower integer compare operands");
                return null;
            }
            if (llvm_mir_kind_pointer_handle(cmp_kind)) {
                lhs_cmp = self.pointer_handle_address(lhs_cmp, "mir.ptr.cmp.lhs");
                rhs_cmp = self.pointer_handle_address(rhs_cmp, "mir.ptr.cmp.rhs");
                if (lhs_cmp == null || rhs_cmp == null) {
                    self.report_error("cannot extract pointer compare operands");
                    return null;
                }
            }
            let cmp = vyx_rt_build_icmp(self.mod, pred, lhs_cmp, rhs_cmp, llvm_mir_empty_name(), 0);
            if (cmp == null) {
                self.report_error("cannot emit scalar compare op "
                          + policy_i64_to_string(op as i64)
                          + " lhs=" + llvm_mir_type_text(&self.m, lhs_type)
                          + " rhs=" + llvm_mir_type_text(&self.m, rhs_type)
                          + " runtime=" + self.runtime_last_error());
                return null;
            }
            return self.bool_value_i8(cmp);
        }
        if (op == llvm_mir_tk_AND() || op == llvm_mir_tk_OR()) {
            let lhs_b = self.bool_value_i8(self.truthy_value(self.lower_value(lhs_id), self.m.value_type(lhs_id)));
            let rhs_b = self.bool_value_i8(self.truthy_value(self.lower_value(rhs_id), self.m.value_type(rhs_id)));
            if (op == llvm_mir_tk_AND()) { return vyx_rt_build_and(self.mod, lhs_b, rhs_b, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_or(self.mod, lhs_b, rhs_b, llvm_mir_empty_name(), 0);
        }
        let out_kind = llvm_mir_type_kind(&self.m, out_type);
        let lhs_kind_for_ptr = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind_for_ptr = llvm_mir_type_kind(&self.m, rhs_type);
        if (op == llvm_mir_tk_MINUS()
            && llvm_mir_kind_pointer_like(lhs_kind_for_ptr)
            && llvm_mir_kind_pointer_like(rhs_kind_for_ptr)) {
            return self.lower_pointer_difference_value(value_id);
        }
        if (llvm_mir_kind_pointer_like(out_kind) && (op == llvm_mir_tk_PLUS() || op == llvm_mir_tk_MINUS())) {
            return self.lower_pointer_arithmetic_value(value_id);
        }
        if (llvm_mir_kind_float(out_kind)) {
            let lhs_f = self.lower_value_as(lhs_id, out_type);
            let rhs_f = self.lower_value_as(rhs_id, out_type);
            if (lhs_f == null || rhs_f == null) {
                self.report_error("cannot lower float binary operands");
                return null;
            }
            var float_out: rawptr = null;
            if (op == llvm_mir_tk_PLUS()) { float_out = vyx_rt_build_fadd(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            else if (op == llvm_mir_tk_MINUS()) { float_out = vyx_rt_build_fsub(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            else if (op == llvm_mir_tk_STAR()) { float_out = vyx_rt_build_fmul(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            else if (op == llvm_mir_tk_SLASH()) { float_out = vyx_rt_build_fdiv(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            else if (op == llvm_mir_tk_PERCENT()) { float_out = vyx_rt_build_frem(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            if (float_out != null) { return float_out; }
            self.report_error("cannot lower float binary op "
                      + policy_i64_to_string(op as i64)
                      + " type=" + llvm_mir_type_text(&self.m, out_type)
                      + " runtime=" + self.runtime_last_error());
            return null;
        }
        let lhs = self.lower_value_as(lhs_id, out_type);
        let rhs = self.lower_value_as(rhs_id, out_type);
        if (lhs == null || rhs == null) {
            self.report_error("cannot lower binary operands");
            return null;
        }
        if (op == llvm_mir_tk_PLUS()) { return vyx_rt_build_add(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_MINUS()) { return vyx_rt_build_sub(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_STAR()) { return vyx_rt_build_mul(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_SLASH()) {
            if (llvm_mir_kind_unsigned(out_kind)) { return vyx_rt_build_udiv(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_sdiv(self.mod, lhs, rhs, llvm_mir_empty_name(), 0);
        }
        if (op == llvm_mir_tk_PERCENT()) {
            if (llvm_mir_kind_unsigned(out_kind)) { return vyx_rt_build_urem(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_srem(self.mod, lhs, rhs, llvm_mir_empty_name(), 0);
        }
        if (op == llvm_mir_tk_AMP()) { return vyx_rt_build_and(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_PIPE()) { return vyx_rt_build_or(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_CARET()) { return vyx_rt_build_xor(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_LSHIFT()) { return vyx_rt_build_shl(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_RSHIFT()) { return vyx_rt_build_lshr(self.mod, lhs, rhs, llvm_mir_empty_name(), 0); }
        self.report_error("cannot lower binary op " + policy_i64_to_string(op as i64));
        return null;
    }

    /// Scalar binary over reference-view operands: both sides are lowered
    /// as their pointee types (`&mut T` operands deref through cast_value)
    /// and the operation is emitted as plain scalar arithmetic/compare.
    public fn lower_scalar_binary_view(self, op: i32, lhs_id: i32, rhs_id: i32,
                                       lhs_type: i32, rhs_type: i32, out_type: i32) -> rawptr {
        let pred = llvm_mir_map_binop_pred_signed(op);
        if (pred >= 0) {
            let lhs_c = self.lower_value_as(lhs_id, lhs_type);
            let rhs_c = self.lower_value_as(rhs_id, lhs_type);
            if (lhs_c == null || rhs_c == null) { return null; }
            var use_pred = pred;
            if (llvm_mir_kind_unsigned(llvm_mir_type_kind(&self.m, lhs_type))) {
                use_pred = llvm_mir_map_binop_pred_unsigned(op);
            }
            let cmp = vyx_rt_build_icmp(self.mod, use_pred, lhs_c, rhs_c, llvm_mir_empty_name(), 0);
            if (cmp == null) { return null; }
            return self.bool_value_i8(cmp);
        }
        let out_kind = llvm_mir_type_kind(&self.m, out_type);
        if (llvm_mir_kind_float(out_kind)) {
            let lhs_f = self.lower_value_as(lhs_id, out_type);
            let rhs_f = self.lower_value_as(rhs_id, out_type);
            if (lhs_f == null || rhs_f == null) { return null; }
            if (op == llvm_mir_tk_PLUS()) { return vyx_rt_build_fadd(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            if (op == llvm_mir_tk_MINUS()) { return vyx_rt_build_fsub(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            if (op == llvm_mir_tk_STAR()) { return vyx_rt_build_fmul(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            if (op == llvm_mir_tk_SLASH()) { return vyx_rt_build_fdiv(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            if (op == llvm_mir_tk_PERCENT()) { return vyx_rt_build_frem(self.mod, lhs_f, rhs_f, llvm_mir_empty_name(), 0); }
            return null;
        }
        let lhs_v = self.lower_value_as(lhs_id, out_type);
        let rhs_v = self.lower_value_as(rhs_id, out_type);
        if (lhs_v == null || rhs_v == null) { return null; }
        if (op == llvm_mir_tk_PLUS()) { return vyx_rt_build_add(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_MINUS()) { return vyx_rt_build_sub(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_STAR()) { return vyx_rt_build_mul(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0); }
        if (op == llvm_mir_tk_SLASH()) {
            if (llvm_mir_kind_unsigned(out_kind)) { return vyx_rt_build_udiv(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_sdiv(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0);
        }
        if (op == llvm_mir_tk_PERCENT()) {
            if (llvm_mir_kind_unsigned(out_kind)) { return vyx_rt_build_urem(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0); }
            return vyx_rt_build_srem(self.mod, lhs_v, rhs_v, llvm_mir_empty_name(), 0);
        }
        return null;
    }

    public fn lower_control_value(self, value_id: i32) -> rawptr {
        let cond = self.truthy_value(self.lower_value(self.m.value_lhs(value_id)), self.m.value_type(self.m.value_lhs(value_id)));
        let then_v = self.lower_value_as(self.m.value_rhs(value_id), self.m.value_type(value_id));
        let else_v = self.lower_value_as(self.m.value_aux(value_id), self.m.value_type(value_id));
        if (cond == null || then_v == null || else_v == null) { return null; }
        return vyx_rt_build_select(self.mod, cond, then_v, else_v, llvm_mir_empty_name(), 0);
    }

    public fn emit_printf_cstr(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        let fmt = self.emit_str_ptr("%s");
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_cstr_line(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        let fmt = self.emit_str_ptr("%s\n");
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_pointer(self, ptr: rawptr, newline: bool) -> rawptr {
        if (ptr == null) { return null; }
        var format = "%p";
        if (newline) { format = "%p\n"; }
        let fmt = self.emit_str_ptr(format);
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_str_slice(self, ptr: rawptr, len_v: rawptr) -> rawptr {
        if (ptr == null || len_v == null) { return null; }
        let fmt = self.emit_str_ptr("%.*s");
        let len_i32 = vyx_rt_build_trunc(self.mod, len_v, self.ty_i32, llvm_mir_empty_name(), 0);
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  len_i32,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_str_slice_line(self, ptr: rawptr, len_v: rawptr) -> rawptr {
        if (ptr == null || len_v == null) { return null; }
        let fmt = self.emit_str_ptr("%.*s\n");
        let len_i32 = vyx_rt_build_trunc(self.mod, len_v, self.ty_i32, llvm_mir_empty_name(), 0);
        return vyx_rt_build_call3(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  fmt,
                                  len_i32,
                                  ptr,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn emit_printf_newline(self) -> rawptr {
        let nl = self.emit_str_ptr("\n");
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_printf_fty,
                                  self.builtin_printf_fn,
                                  nl,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn value_to_cstr(self, value_id: i32) -> rawptr {
        let value_type = self.m.value_type(value_id);
        if (self.type_is_string_view_type(value_type)) {
            return self.string_cstr_from_value(value_id);
        }
        let arg_kind = llvm_mir_type_kind(&self.m, value_type);
        if (arg_kind == ty_STRING()) {
            if (self.m.value_kind(value_id) == mir_value_const_str() && self.m.value_first_arg(value_id) == mir_id_invalid()) {
                return self.emit_str_ptr(self.m.value_text(value_id));
            }
            return self.string_ptr_value(self.lower_value(value_id));
        }
        let bits = llvm_mir_int_bits_for_kind(arg_kind);
        if (bits > 0 && arg_kind != ty_BOOL()) {
            let as_i64 = self.int_value_to_bits(self.lower_value(value_id), value_type, 64);
            if (llvm_mir_kind_decimal_unsigned(arg_kind)) {
                return vyx_rt_build_call1(self.mod,
                                          self.builtin_uint_to_string_fty,
                                          self.builtin_uint_to_string_fn,
                                          as_i64,
                                          llvm_mir_empty_name(),
                                          0);
            }
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_int_to_string_fty,
                                      self.builtin_int_to_string_fn,
                                      as_i64,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (arg_kind == ty_BOOL()) {
            let as_i64_bool = self.int_value_to_bits(self.lower_value(value_id), value_type, 64);
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_int_to_string_fty,
                                      self.builtin_int_to_string_fn,
                                      as_i64_bool,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (llvm_mir_kind_float(arg_kind)) {
            return self.float_value_to_cstr(value_id);
        }
        if (llvm_mir_kind_pointer_like(arg_kind)) {
            return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
        }
        return null;
    }

    public fn lower_float_format_arg(self, value_id: i32) -> rawptr {
        let kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        var v = self.lower_value(value_id);
        if (v == null) {
            self.report_error("cannot lower float value for string formatting");
            return null;
        }
        if (kind == ty_F32()) {
            v = vyx_rt_build_fp_ext(self.mod,
                                    v,
                                    vyx_rt_float_type(self.mod, 64),
                                    llvm_mir_empty_name(),
                                    0);
        }
        if (v == null) {
            self.report_error("cannot promote float value for string formatting");
            return null;
        }
        return v;
    }

    public fn float_value_to_cstr(self, value_id: i32) -> rawptr {
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable for float formatting");
            return null;
        }
        let v = self.lower_float_format_arg(value_id);
        // Match the legacy codegen/std.fmt float string ABI: snprintf("%g").
        let buf = self.malloc_bytes_value(64, "mir.float.tostr.buf");
        let fmt = self.emit_str_ptr("%g");
        if (v == null || buf == null || fmt == null) {
            self.report_error("cannot prepare float formatting buffer");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate float formatting call arguments");
            return null;
        }
        ast_write_rawptr(args, buf);
        ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 64, 0));
        ast_write_rawptr(ptr_offset(args, 16), fmt);
        ast_write_rawptr(ptr_offset(args, 24), v);
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      args,
                                      4 as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(args);
        if (wrote == null) {
            self.report_error("cannot emit float formatting call");
            return null;
        }
        return buf;
    }

    // Use snprintf's sizing result directly for owning string values. This
    // avoids scanning the newly formatted data with strlen and avoids relying
    // on the fixed diagnostic buffer used by float_value_to_cstr.
    public fn float_value_to_string(self, value_id: i32) -> rawptr {
        return self.float_format_arg_to_string(self.lower_float_format_arg(value_id));
    }

    public fn float_format_arg_to_string(self, v: rawptr) -> rawptr {
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable for float string conversion");
            return null;
        }
        let fmt = self.emit_str_ptr("%g");
        if (v == null || fmt == null) {
            self.report_error("cannot prepare float string conversion");
            return null;
        }
        let size_args = malloc(32);
        if (size_args == null) {
            self.report_error("cannot allocate float sizing call arguments");
            return null;
        }
        ast_write_rawptr(size_args, vyx_rt_const_ptr_null(self.mod, self.ty_ptr));
        ast_write_rawptr(ptr_offset(size_args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        ast_write_rawptr(ptr_offset(size_args, 16), fmt);
        ast_write_rawptr(ptr_offset(size_args, 24), v);
        let needed32 = vyx_rt_build_call(self.mod,
                                         self.builtin_snprintf_fty,
                                         self.builtin_snprintf_fn,
                                         size_args,
                                         4 as u64,
                                         llvm_mir_empty_name(),
                                         0);
        free(size_args);
        if (needed32 == null) {
            self.report_error("cannot emit float sizing call");
            return null;
        }
        let sizing_failed = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_slt(),
                                              needed32,
                                              vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                              "mir.float.tostr.failed".c_str(),
                                              22);
        let safe_needed32 = vyx_rt_build_select(self.mod,
                                                 sizing_failed,
                                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                 needed32,
                                                 "mir.float.tostr.safe_len".c_str(),
                                                 24);
        let len_v = vyx_rt_build_sext(self.mod,
                                       safe_needed32,
                                       self.ty_i64,
                                       "mir.float.tostr.len".c_str(),
                                       19);
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                     "mir.float.tostr.cap".c_str(),
                                     19);
        // Float interpolation releases this temporary through the ordinary
        // malloc ownership path. Keep its allocation ABI paired with that
        // release path rather than handing a pooled buffer to free().
        let buf = self.alloc_string_data_with_cap_malloc(len_v, cap_v);
        if (len_v == null || cap_v == null || buf == null) {
            self.report_error("cannot allocate float string output");
            return null;
        }
        let write_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            "mir.float.tostr.write".c_str(),
                                            21);
        let done_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           "mir.float.tostr.done".c_str(),
                                           20);
        if (sizing_failed == null || safe_needed32 == null || write_bb == null || done_bb == null) {
            self.report_error("cannot create float string conversion flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, sizing_failed, done_bb, write_bb);
        vyx_rt_position_at_end(self.mod, write_bb);
        let write_args = malloc(32);
        if (write_args == null) {
            self.report_error("cannot allocate float write call arguments");
            return null;
        }
        ast_write_rawptr(write_args, buf);
        ast_write_rawptr(ptr_offset(write_args, 8), cap_v);
        ast_write_rawptr(ptr_offset(write_args, 16), fmt);
        ast_write_rawptr(ptr_offset(write_args, 24), v);
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      write_args,
                                      4 as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(write_args);
        if (wrote == null) {
            self.report_error("cannot emit float write call");
            return null;
        }
        vyx_rt_build_br(self.mod, done_bb);
        vyx_rt_position_at_end(self.mod, done_bb);
        return self.emit_string_value_from_parts(buf,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 1, 0));
    }

    public fn string_value_is_consumed_temporary(self, value_id: i32, depth: i32) -> bool {
        if (value_id == mir_id_invalid() || depth > 16) { return false; }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_arg() || kind == mir_value_cast()) {
            return self.string_value_is_consumed_temporary(self.m.value_lhs(value_id), depth + 1);
        }
        if (!self.type_is_string_view_type(self.m.value_type(value_id))) { return false; }
        if (kind == mir_value_const_str()) {
            return self.m.value_first_arg(value_id) != mir_id_invalid();
        }
        if (kind == mir_value_binary()) { return true; }
        if (kind == mir_value_call()) {
            // Every builtin string producer, including clone, has an
            // independent owned result. A concat/f-string consumer may
            // release that rvalue after it has copied its bytes.
            return true;
        }
        return false;
    }

    public fn release_consumed_string_temporary(self,
                                                value_id: i32,
                                                string_value: rawptr) -> bool {
        if (!self.string_value_is_consumed_temporary(value_id, 0)) { return true; }
        if (string_value == null) {
            self.report_error("cannot release consumed string temporary");
            return false;
        }
        let ptr = self.string_ptr_value(string_value);
        let owned = self.string_owned_value(string_value);
        if (ptr == null || owned == null) {
            self.report_error("cannot extract consumed string temporary storage");
            return false;
        }
        return self.release_replaced_string_storage(ptr, owned);
    }

    public fn emit_print_value_mode(self, value_id: i32, newline: bool) -> bool {
        if (value_id == mir_id_invalid()) { return true; }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
            print("[printmode] value=" + policy_i64_to_string(value_id as i64)
                  + " kind=" + policy_i64_to_string(arg_kind as i64)
                  + " nl=" + (newline ? "1" : "0"));
        }
        if (arg_kind == ty_STRING() && self.m.value_kind(value_id) == mir_value_const_str()) {
            var seg = self.m.value_first_arg(value_id);
            if (seg != mir_id_invalid()) {
                var next_seg = self.m.value_next_arg(seg);
                while (seg != mir_id_invalid()) {
                    next_seg = self.m.value_next_arg(seg);
                    if (!self.emit_print_value_mode(seg, newline && (next_seg == mir_id_invalid()))) { return false; }
                    seg = self.m.value_next_arg(seg);
                }
                return true;
            }
            let ptr = self.emit_str_ptr(self.m.value_text(value_id));
            let len_v = vyx_rt_const_int(self.mod, self.ty_i64, self.m.value_text(value_id).len, 0);
            if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptr, len_v); }
            else { self.last_print_call = self.emit_printf_str_slice(ptr, len_v); }
            return self.last_print_call != null;
        }
        if (arg_kind == ty_STRING()) {
            let str_v = self.lower_value(value_id);
            if (newline) {
                self.last_print_call = self.emit_printf_str_slice_line(self.string_ptr_value(str_v),
                                                                        self.string_len_value(str_v));
            } else {
                self.last_print_call = self.emit_printf_str_slice(self.string_ptr_value(str_v),
                                                                  self.string_len_value(str_v));
            }
            if (self.last_print_call == null) { return false; }
            return self.release_consumed_string_temporary(value_id, str_v);
        }
        if (arg_kind == ty_REF() || arg_kind == ty_MUTREF()) {
            // Reference view: print the pointee value, not the address.
            // `print(v[i])` over a `&mut T` operator[] reads like the element.
            let view_elem = hir_type_table_elem(self.m.types, self.m.value_type(value_id));
            if (view_elem != mir_id_invalid()) {
                let view_handle = self.lower_value(value_id);
                var view_addr: rawptr = null;
                if (view_handle != null) { view_addr = self.pointer_handle_address(view_handle, "mir.print.ref"); }
                var view_st: rawptr = null;
                if (view_addr != null) { view_st = self.lower_storage_type(view_elem); }
                if (view_addr != null && view_st != null) {
                    let view_loaded = vyx_rt_build_load(self.mod, view_st, view_addr, llvm_mir_empty_name(), 0);
                    let view_kind = llvm_mir_type_kind(&self.m, view_elem);
                    if (view_loaded != null && view_kind == ty_STRING()) {
                        // A container reference borrows the string storage.
                        // Printing it must preserve the slice length and must
                        // not consume the container's owning buffer.
                        let ptrs = self.string_ptr_value(view_loaded);
                        let lens = self.string_len_value(view_loaded);
                        if (ptrs == null || lens == null) { return false; }
                        if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptrs, lens); }
                        else { self.last_print_call = self.emit_printf_str_slice(ptrs, lens); }
                        return self.last_print_call != null;
                    } else if (view_loaded != null && (view_kind == ty_F32() || view_kind == ty_F64())) {
                        var as_double = view_loaded;
                        if (view_kind == ty_F32()) {
                            as_double = vyx_rt_build_fp_ext(self.mod, view_loaded, vyx_rt_float_type(self.mod, 64),
                                                         llvm_mir_empty_name(), 0);
                        }
                        let str_vf = self.float_format_arg_to_string(as_double);
                        if (str_vf == null) { return false; }
                        let ptrf = self.string_ptr_value(str_vf);
                        let lenf = self.string_len_value(str_vf);
                        let ownedf = self.string_owned_value(str_vf);
                        if (ptrf == null || lenf == null || ownedf == null) { return false; }
                        if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptrf, lenf); }
                        else { self.last_print_call = self.emit_printf_str_slice(ptrf, lenf); }
                        if (self.last_print_call == null) { return false; }
                        return self.release_replaced_string_storage(ptrf, ownedf);
                    } else if (view_loaded != null && view_kind == ty_BOOL()) {
                        let as_i32 = self.int_value_to_bits(view_loaded, view_elem, 32);
                        let str_vb = self.string_value_from_bool_to_string(as_i32);
                        if (str_vb != null) {
                            let ptrb = self.string_ptr_value(str_vb);
                            let lenb = self.string_len_value(str_vb);
                            let ownedb = self.string_owned_value(str_vb);
                            if (ptrb != null && lenb != null && ownedb != null) {
                                if (newline) {
                                    self.last_print_call = self.emit_printf_str_slice_line(ptrb, lenb);
                                } else {
                                    self.last_print_call = self.emit_printf_str_slice(ptrb, lenb);
                                }
                                if (self.last_print_call == null) { return false; }
                                return self.release_replaced_string_storage(ptrb, ownedb);
                            }
                        }
                    } else if (view_loaded != null && llvm_mir_int_bits_for_kind(view_kind) > 0) {
                        let as_i64 = self.int_value_to_bits(view_loaded, view_elem, 64);
                        let str_vi = self.string_value_from_integer_to_string(
                            as_i64,
                            llvm_mir_kind_decimal_unsigned(view_kind));
                        if (str_vi != null) {
                            let ptri = self.string_ptr_value(str_vi);
                            let leni = self.string_len_value(str_vi);
                            let ownedi = self.string_owned_value(str_vi);
                            if (ptri != null && leni != null && ownedi != null) {
                                if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
                                    print("[printref] int-view nl=" + (newline ? "1" : "0"));
                                }
                                // NOTE: Vyx `?:` evaluates BOTH branches — an
                                // if/else is required or both printf forms are
                                // emitted and the value prints twice.
                                if (newline) {
                                    self.last_print_call = self.emit_printf_str_slice_line(ptri, leni);
                                } else {
                                    self.last_print_call = self.emit_printf_str_slice(ptri, leni);
                                }
                                if (self.last_print_call == null) { return false; }
                                return self.release_replaced_string_storage(ptri, ownedi);
                            }
                        }
                    }
                }
            }
            // Non-scalar pointees fall through to the pointer form.
        }
        if (arg_kind == ty_RAWPTR()
            || arg_kind == ty_PTR()
            || arg_kind == ty_REF()
            || arg_kind == ty_MUTREF()
            || arg_kind == ty_CFN()) {
            if (llvm_mir_env_enabled("VYX_TRACE_PRINTMODE")) {
                print("[printref] ptr-form kind=" + policy_i64_to_string(arg_kind as i64));
            }
            var pointer_value = self.lower_value(value_id);
            if (llvm_mir_kind_pointer_handle(arg_kind)) {
                pointer_value = self.pointer_handle_address(pointer_value, "mir.print.ptr");
            }
            self.last_print_call = self.emit_printf_pointer(pointer_value, newline);
            return self.last_print_call != null;
        }
        // Scalar print must use the same owning string ABI as toString and
        // interpolation. The legacy C-string path lost the known length and
        // rendered booleans as 1/0 through int_to_string.
        let int_bits = llvm_mir_int_bits_for_kind(arg_kind);
        if (int_bits > 0) {
            var str_v2: rawptr = null;
            if (arg_kind == ty_BOOL()) {
                let as_i32 = self.int_value_to_bits(self.lower_value(value_id),
                                                     self.m.value_type(value_id),
                                                     32);
                str_v2 = self.string_value_from_bool_to_string(as_i32);
            } else {
                let as_i64 = self.int_value_to_bits(self.lower_value(value_id),
                                                     self.m.value_type(value_id),
                                                     64);
                str_v2 = self.string_value_from_integer_to_string(
                    as_i64,
                    llvm_mir_kind_decimal_unsigned(arg_kind));
            }
            if (str_v2 == null) {
                self.report_error("cannot lower scalar value for printing");
                return false;
            }
            let ptr2 = self.string_ptr_value(str_v2);
            let len2 = self.string_len_value(str_v2);
            let owned2 = self.string_owned_value(str_v2);
            if (ptr2 == null || len2 == null || owned2 == null) {
                self.report_error("cannot lower scalar value for printing");
                return false;
            }
            if (newline) { self.last_print_call = self.emit_printf_str_slice_line(ptr2, len2); }
            else { self.last_print_call = self.emit_printf_str_slice(ptr2, len2); }
            if (self.last_print_call == null) { return false; }
            return self.release_replaced_string_storage(ptr2, owned2);
        }
        let cptr = self.value_to_cstr(value_id);
        if (cptr == null) {
            self.report_error("cannot print value type " + llvm_mir_type_text(&self.m, self.m.value_type(value_id)));
            return false;
        }
        var printed: rawptr = null;
        if (newline) { printed = self.emit_printf_cstr_line(cptr); }
        else { printed = self.emit_printf_cstr(cptr); }
        if (llvm_mir_int_bits_for_kind(arg_kind) > 0) {
            if (self.builtin_runtime_string_free_fn != null
                && self.builtin_runtime_string_free_fty != null) {
                vyx_rt_build_call1(self.mod,
                                   self.builtin_runtime_string_free_fty,
                                   self.builtin_runtime_string_free_fn,
                                   cptr,
                                   llvm_mir_empty_name(),
                                   0);
            }
        } else if (llvm_mir_kind_float(arg_kind)) {
            if (self.builtin_free_fn != null && self.builtin_free_fty != null) {
                vyx_rt_build_call1(self.mod,
                                   self.builtin_free_fty,
                                   self.builtin_free_fn,
                                   cptr,
                                   llvm_mir_empty_name(),
                                   0);
            }
        }
        self.last_print_call = printed;
        return printed != null;
    }

    public fn emit_print_value(self, value_id: i32) -> bool {
        return self.emit_print_value_mode(value_id, false);
    }

    public fn call_arg_count(self, value_id: i32) -> i32 {
        var n: i32 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            n = n + 1;
            cur = self.m.value_next_arg(cur);
        }
        return n;
    }

    public fn call_arg_payload(self, arg_node_id: i32) -> i32 {
        if (arg_node_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.value_kind(arg_node_id) == mir_value_arg()) {
            let payload = self.m.value_lhs(arg_node_id);
            if (payload != mir_id_invalid()) { return payload; }
        }
        return arg_node_id;
    }

    public fn call_arg_at(self, value_id: i32, idx: i32) -> i32 {
        var i: i32 = 0;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (i == idx) { return self.call_arg_payload(cur); }
            i = i + 1;
            cur = self.m.value_next_arg(cur);
        }
        return mir_id_invalid();
    }

    public fn builtin_name_for_call(self, value_id: i32) -> string {
        let call_name = self.m.value_name(value_id);
        if (call_name.len > 0) { return call_name; }
        let lhs = self.m.value_lhs(value_id);
        if (lhs != mir_id_invalid()) {
            let lhs_name = self.m.value_name(lhs);
            if (lhs_name.len > 0) { return lhs_name; }
        }
        return "";
    }

    public fn resolved_call_name(self, value_id: i32) -> string {
        if (self.m.value_target_kind(value_id) == mir_target_builtin()) {
            return self.builtin_name_for_call(value_id);
        }
        let lhs = self.m.value_lhs(value_id);
        if (lhs != mir_id_invalid()) {
            let lhs_name = self.m.value_name(lhs);
            if (lhs_name.len > 0) { return lhs_name; }
        }
        if (self.m.value_target_kind(value_id) == mir_target_function()) {
            return self.m.function_name(self.m.value_target_id(value_id));
        }
        if (lhs != mir_id_invalid() && self.m.value_target_kind(lhs) == mir_target_function()) {
            return self.m.function_name(self.m.value_target_id(lhs));
        }
        return "";
    }

    public fn direct_call_receiver(self, value_id: i32) -> i32 {
        let callee = self.direct_call_callee(value_id);
        if (callee == mir_id_invalid()) { return mir_id_invalid(); }
        let target_fn = self.m.value_target_id(callee);
        if (target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_source_param_count(target_fn) <= self.call_arg_count(value_id)) {
            return mir_id_invalid();
        }
        let receiver = self.m.value_lhs(callee);
        if (receiver == mir_id_invalid()) { return mir_id_invalid(); }
        return receiver;
    }

    public fn call_receiver_type(self, value_id: i32) -> i32 {
        let receiver = self.direct_call_receiver(value_id);
        if (receiver == mir_id_invalid()) { return mir_id_invalid(); }
        return self.m.value_type(receiver);
    }

    public fn materialize_std_string_self_from_str_abi(self, value_id: i32, string_type: i32) -> rawptr {
        if (value_id == mir_id_invalid() || string_type == mir_id_invalid()) { return null; }
        let view = self.lower_string_view_value(value_id);
        let data_ptr = self.string_ptr_value(view);
        let len_v = self.string_len_value(view);
        if (view == null || data_ptr == null || len_v == null) {
            self.report_error("cannot lower str view for std String self");
            return null;
        }
        let owner_type = self.canonical_record_type_id(string_type);
        var record_ty = self.lower_type(owner_type);
        if (self.type_is_class_pointer_abi(owner_type)) {
            record_ty = self.class_record_storage_ty(owner_type);
        }
        if (record_ty == null) {
            self.report_error("cannot lower std String layout for self");
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, record_ty, "mir.str.as.String".c_str(), 18);
        if (tmp == null) {
            self.report_error("cannot allocate std String self temporary");
            return null;
        }
        let ptr_gep = self.record_field_addr_for_type(tmp, owner_type, "ptr");
        let len_gep = self.record_field_addr_for_type(tmp, owner_type, "len");
        let cap_gep = self.record_field_addr_for_type(tmp, owner_type, "cap");
        let owned_gep = self.record_field_addr_for_type(tmp, owner_type, "owned");
        let inline0_gep = self.record_field_addr_for_type(tmp, owner_type, "inline0");
        let inline1_gep = self.record_field_addr_for_type(tmp, owner_type, "inline1");
        let inline2_gep = self.record_field_addr_for_type(tmp, owner_type, "inline2");
        if (ptr_gep == null || len_gep == null || cap_gep == null || owned_gep == null
            || inline0_gep == null || inline1_gep == null || inline2_gep == null) {
            self.report_error("cannot address std String self fields");
            return null;
        }
        let zero64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        // owned=heap so `_data_ptr` reads `.ptr` (the str view bytes) instead of
        // SSO `inline0`. The temporary is not dropped; it only borrows the view.
        let heap_flag = vyx_rt_const_int(self.mod, self.ty_i64, 1, 0);
        vyx_rt_build_store(self.mod, data_ptr, ptr_gep);
        vyx_rt_build_store(self.mod, len_v, len_gep);
        vyx_rt_build_store(self.mod, len_v, cap_gep);
        vyx_rt_build_store(self.mod, heap_flag, owned_gep);
        vyx_rt_build_store(self.mod, zero64, inline0_gep);
        vyx_rt_build_store(self.mod, zero64, inline1_gep);
        vyx_rt_build_store(self.mod, zero64, inline2_gep);
        return tmp;
    }

    public fn lower_self_receiver_address(self, value_id: i32, type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let source_type_id = self.m.value_type(value_id);
        if (self.type_is_std_string_class(type_id) && self.type_is_str_abi(source_type_id)) {
            return self.materialize_std_string_self_from_str_abi(value_id, type_id);
        }
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, source_type_id))) {
            let handle = self.lower_value_as(value_id, source_type_id);
            let address = self.pointer_handle_address(handle, "mir.self.handle");
            if (handle == null || address == null) {
                self.report_error("cannot extract pointer handle receiver for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return self.adjust_dci_base_pointer(address,
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        if (self.heap_indirect_payload_matches(self.m.value_type(value_id), type_id)) {
            let payload_addr = self.lower_heap_indirect_payload_address(value_id, type_id);
            if (payload_addr != null) {
                return self.adjust_dci_base_pointer(payload_addr,
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
        }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_read_place() || kind == mir_value_address_of()) {
            let place_id = self.m.value_place(value_id);
            let addr = self.lower_place_addr(place_id);
            if (self.place_is_self_pointer_abi_slot(place_id)) {
                return self.adjust_dci_base_pointer(self.load_self_pointer_abi_slot(place_id, addr, type_id),
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
            if (self.type_is_class_pointer_abi(type_id)) {
                return self.adjust_dci_base_pointer(self.class_object_addr_from_place_addr(place_id, addr, type_id),
                                                    source_type_id,
                                                    type_id,
                                                    "dci.self.base");
            }
            return self.adjust_dci_base_pointer(addr,
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.adjust_dci_base_pointer(self.lower_value_as(value_id, type_id),
                                                source_type_id,
                                                type_id,
                                                "dci.self.base");
        }
        let ty = self.lower_type(type_id);
        let tmp = vyx_rt_build_alloca(self.mod, ty, "mir.self.arg".c_str(), 12);
        let value = self.lower_value_as(value_id, type_id);
        if (tmp == null || value == null) {
            self.report_error("cannot materialize receiver address for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_store(self.mod, value, tmp);
        return tmp;
    }

    public fn lower_static_self_receiver_address(self, value_id: i32, type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let source_type_id = self.m.value_type(value_id);
        let item_id = self.m.value_target_id(value_id);
        let gv = self.get_or_create_hir_item_global(item_id, type_id, self.m.value_name(value_id));
        if (gv == null) { return null; }
        if (self.type_is_class_pointer_abi(type_id)) {
            let obj = vyx_rt_build_load(self.mod,
                                        self.ty_ptr,
                                        gv,
                                        "mir.global.self".c_str(),
                                        15);
            if (obj == null) {
                self.report_error("cannot load global class receiver for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            return self.adjust_dci_base_pointer(obj,
                                                source_type_id,
                                                type_id,
                                                "dci.static.self.base");
        }
        return gv;
    }

    public fn place_is_direct_class_object_pointer(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        let kind = self.m.place_kind(place_id);
        if (kind == mir_place_deref()) { return true; }
        if (kind != mir_place_local()) { return false; }
        let local = self.m.place_local(place_id);
        if (local == mir_id_invalid()) { return false; }
        return self.local_uses_self_pointer_abi(self.m.place_function(place_id), local);
    }

    public fn place_is_self_pointer_abi_slot(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local = self.m.place_local(place_id);
        if (local == mir_id_invalid()) { return false; }
        return self.local_is_self_pointer_abi_slot(self.m.place_function(place_id), local);
    }

    public fn load_self_pointer_abi_slot(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.self.obj".c_str(),
                                    12);
        if (obj == null) {
            self.report_error("cannot load self object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn class_object_addr_from_place_addr(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        if (self.place_is_self_pointer_abi_slot(place_id)) {
            return self.load_self_pointer_abi_slot(place_id, place_addr, type_id);
        }
        if (!self.type_is_class_pointer_abi(type_id)) { return place_addr; }
        if (self.place_is_direct_class_object_pointer(place_id)) { return place_addr; }
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.class.obj".c_str(),
                                    13);
        if (obj == null) {
            self.report_error("cannot load class object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn ensure_class_object_addr_from_place_addr(self, place_id: i32, place_addr: rawptr, type_id: i32) -> rawptr {
        if (place_addr == null) { return null; }
        if (self.place_is_self_pointer_abi_slot(place_id)) {
            return self.load_self_pointer_abi_slot(place_id, place_addr, type_id);
        }
        if (!self.type_is_class_pointer_abi(type_id)) { return place_addr; }
        if (self.place_is_direct_class_object_pointer(place_id)) { return place_addr; }
        if (self.current_function_value == null) {
            self.report_error("cannot materialize class storage outside a function for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let current_obj = vyx_rt_build_load(self.mod,
                                            self.ty_ptr,
                                            place_addr,
                                            "mir.class.obj".c_str(),
                                            13);
        if (current_obj == null) {
            self.report_error("cannot load class object pointer for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let is_null = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        current_obj,
                                        vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                        "mir.class.null".c_str(),
                                        14);
        let alloc_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           "mir.class.ensure.alloc".c_str(),
                                           22);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.class.ensure.cont".c_str(),
                                          21);
        if (is_null == null || alloc_bb == null || cont_bb == null) {
            self.report_error("cannot create class storage materialization flow for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_null, alloc_bb, cont_bb);
        vyx_rt_position_at_end(self.mod, alloc_bb);
        let new_obj = self.build_zeroed_class_object(type_id);
        if (new_obj == null) { return null; }
        vyx_rt_build_store(self.mod, new_obj, place_addr);
        vyx_rt_build_br(self.mod, cont_bb);
        vyx_rt_position_at_end(self.mod, cont_bb);
        let obj = vyx_rt_build_load(self.mod,
                                    self.ty_ptr,
                                    place_addr,
                                    "mir.class.obj".c_str(),
                                    13);
        if (obj == null) {
            self.report_error("cannot reload materialized class object for "
                      + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return obj;
    }

    public fn lower_print_like_call(self, value_id: i32, name: string) -> rawptr {
        self.last_print_call = null;
        var cur = self.m.value_first_arg(value_id);
        if (cur == mir_id_invalid()) {
            self.last_print_call = self.emit_printf_newline();
            return self.last_print_call;
        }
        while (cur != mir_id_invalid()) {
            let next = self.m.value_next_arg(cur);
            if (!self.emit_print_value_mode(cur, next == mir_id_invalid())) { return null; }
            cur = next;
        }
        return self.last_print_call;
    }

    public fn concat_cstr_pair(self, lhs: rawptr, rhs: rawptr) -> rawptr {
        // `rhs` is always a freshly lowered segment; null means the segment
        // failed to lower. Swallowing it here used to silently drop
        // interpolation segments (e.g. f64 before float_value_to_cstr existed).
        if (rhs == null) {
            self.report_error("cannot lower interpolated string segment");
            return null;
        }
        if (lhs == null) { return rhs; }
        if (self.builtin_concat_fn == null || self.builtin_concat_fty == null) {
            self.report_error("string concat declaration is unavailable");
            return null;
        }
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_concat_fty,
                                  self.builtin_concat_fn,
                                  lhs,
                                  rhs,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn cstr_for_print_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return self.emit_str_ptr(""); }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(value_id));
        if (arg_kind == ty_STRING()
            && self.m.value_kind(value_id) == mir_value_const_str()
            && self.m.value_first_arg(value_id) != mir_id_invalid()) {
            var acc: rawptr = null;
            var seg = self.m.value_first_arg(value_id);
            while (seg != mir_id_invalid()) {
                acc = self.concat_cstr_pair(acc, self.cstr_for_print_value(seg));
                if (acc == null) { return null; }
                seg = self.m.value_next_arg(seg);
            }
            return acc;
        }
        return self.value_to_cstr(value_id);
    }

    public fn cstr_for_print_call(self, value_id: i32) -> rawptr {
        var acc: rawptr = null;
        var cur = self.m.value_first_arg(value_id);
        if (cur == mir_id_invalid()) { return self.emit_str_ptr(""); }
        while (cur != mir_id_invalid()) {
            acc = self.concat_cstr_pair(acc, self.cstr_for_print_value(cur));
            if (acc == null) { return null; }
            cur = self.m.value_next_arg(cur);
        }
        return acc;
    }

    public fn emit_runtime_print_cstr(self, ptr: rawptr) -> rawptr {
        if (ptr == null) { return null; }
        if (self.builtin_print_fn == null || self.builtin_print_fty == null) {
            self.report_error("print declaration is unavailable");
            return null;
        }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       llvm_mir_empty_name(),
                                       0);
        if (len_v == null) {
            self.report_error("cannot measure print string");
            return null;
        }
        return vyx_rt_build_call2(self.mod,
                                  self.builtin_print_fty,
                                  self.builtin_print_fn,
                                  ptr,
                                  len_v,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn string_value_from_cstr(self, ptr: rawptr, owned: i64) -> rawptr {
        if (ptr == null) { return null; }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       "mir.strlen".c_str(),
                                       10);
        if (len_v == null) {
            self.report_error("cannot lower C string length");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, owned);
        if (cap_v == null) {
            self.report_error("cannot lower C string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(ptr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, owned, 0));
    }

    public fn string_capacity_for_cstr(self, len_v: rawptr, owned: i64) -> rawptr {
        if (len_v == null) { return null; }
        if (owned == 0) { return vyx_rt_const_int(self.mod, self.ty_i64, 0, 0); }
        return vyx_rt_build_add(self.mod,
                                len_v,
                                vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                llvm_mir_empty_name(),
                                0);
    }

    // The integer length ABIs return malloc-owned NUL-terminated buffers and
    // write their exact payload length. Keep these separate from
    // string_value_from_cstr: foreign/raw C pointers still require strlen.
    public fn string_value_from_integer_to_string(self,
                                                   value: rawptr,
                                                   use_unsigned: bool) -> rawptr {
        if (value == null) { return null; }
        var to_string_fn: rawptr = self.builtin_int_to_string_len_fn;
        var to_string_fty: rawptr = self.builtin_int_to_string_len_fty;
        if (use_unsigned) {
            to_string_fn = self.builtin_uint_to_string_len_fn;
            to_string_fty = self.builtin_uint_to_string_len_fty;
        }
        if (to_string_fn == null || to_string_fty == null) {
            self.report_error("integer to_string length declaration is unavailable");
            return null;
        }
        let len_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.intstr.len".c_str(), 14);
        let args = malloc(16);
        if (len_slot == null || args == null) {
            if (args != null) { free(args); }
            self.report_error("cannot allocate int_to_string length arguments");
            return null;
        }
        ast_write_rawptr(args, value);
        ast_write_rawptr(ptr_offset(args, 8), len_slot);
        let cstr = vyx_rt_build_call(self.mod,
                                     to_string_fty,
                                     to_string_fn,
                                     args,
                                     2,
                                     llvm_mir_empty_name(),
                                     0);
        free(args);
        let len_v = vyx_rt_build_load(self.mod, self.ty_i64, len_slot, "mir.intstr.len.v".c_str(), 16);
        if (cstr == null || len_v == null) {
            self.report_error("cannot lower int_to_string_len result");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, 3);
        if (cap_v == null) {
            self.report_error("cannot compute int_to_string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(cstr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn string_value_from_i64_to_string(self, value: rawptr) -> rawptr {
        return self.string_value_from_integer_to_string(value, false);
    }

    // bool_to_string owns the returned allocation, while its payload length
    // is fixed by the normalized boolean value. Avoid a second C-string scan.
    public fn string_value_from_bool_to_string(self, value: rawptr) -> rawptr {
        if (value == null) { return null; }
        if (self.builtin_bool_to_string_fn == null || self.builtin_bool_to_string_fty == null) {
            self.report_error("bool_to_string declaration is unavailable");
            return null;
        }
        let cstr = vyx_rt_build_call1(self.mod,
                                      self.builtin_bool_to_string_fty,
                                      self.builtin_bool_to_string_fn,
                                      value,
                                      llvm_mir_empty_name(),
                                      0);
        let nonzero = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_ne(),
                                        value,
                                        vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (cstr == null || nonzero == null) {
            self.report_error("cannot lower bool_to_string result");
            return null;
        }
        let len_v = vyx_rt_build_select(self.mod,
                                        nonzero,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                        vyx_rt_const_int(self.mod, self.ty_i64, 5, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (len_v == null) {
            self.report_error("cannot lower bool_to_string result");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, 3);
        if (cap_v == null) {
            self.report_error("cannot compute bool_to_string capacity");
            return null;
        }
        return self.emit_string_value_from_parts(cstr,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn string_value_from_cstr_as_type(self, ptr: rawptr, dst_type_id: i32, owned: i64) -> rawptr {
        if (ptr == null || dst_type_id == mir_id_invalid()) { return null; }
        if (self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("strlen declaration is unavailable");
            return null;
        }
        let len_v = vyx_rt_build_call1(self.mod,
                                       self.builtin_strlen_fty,
                                       self.builtin_strlen_fn,
                                       ptr,
                                       "mir.strlen".c_str(),
                                       10);
        if (len_v == null) {
            self.report_error("cannot lower C string length");
            return null;
        }
        let cap_v = self.string_capacity_for_cstr(len_v, owned);
        if (cap_v == null) {
            self.report_error("cannot lower C string capacity");
            return null;
        }
        let primitive_value = self.emit_string_value_from_parts(ptr,
                                                                len_v,
                                                                cap_v,
                                                                vyx_rt_const_int(self.mod, self.ty_i64, owned, 0));
        if (primitive_value == null) {
            self.report_error("cannot build str ABI value");
            return null;
        }
        if (self.type_is_str_abi(dst_type_id)) {
            return primitive_value;
        }
        if (self.type_is_std_string_class(dst_type_id)) {
            return self.lower_str_raw_to_std_string_value(primitive_value, dst_type_id);
        }
        self.report_error("string runtime result cannot convert to " + llvm_mir_type_text(&self.m, dst_type_id));
        return null;
    }

    public fn string_value_from_raw_parts_as_type(self,
                                                 ptr: rawptr,
                                                 len_v: rawptr,
                                                 cap_v: rawptr,
                                                 owned_v: rawptr,
                                                 dst_type_id: i32) -> rawptr {
        if (ptr == null || len_v == null || cap_v == null || owned_v == null || dst_type_id == mir_id_invalid()) {
            return null;
        }
        let primitive_value = self.emit_string_value_from_parts(ptr, len_v, cap_v, owned_v);
        if (primitive_value == null) {
            self.report_error("cannot build str ABI value");
            return null;
        }
        if (self.type_is_str_abi(dst_type_id)) {
            return primitive_value;
        }
        if (self.type_is_std_string_class(dst_type_id)) {
            return self.lower_str_raw_to_std_string_value(primitive_value, dst_type_id);
        }
        self.report_error("string runtime result cannot convert to " + llvm_mir_type_text(&self.m, dst_type_id));
        return null;
    }

    public fn alloc_string_data_with_cap(self, len_v: rawptr, cap_v: rawptr) -> rawptr {
        if (len_v == null || cap_v == null) { return null; }
        if (self.builtin_pooled_string_alloc_fn == null || self.builtin_pooled_string_alloc_fty == null) {
            self.report_error("pooled string allocator declaration is unavailable");
            return null;
        }
        let data = vyx_rt_build_call1(self.mod,
                                      self.builtin_pooled_string_alloc_fty,
                                      self.builtin_pooled_string_alloc_fn,
                                      cap_v,
                                      "mir.str.pool.alloc".c_str(),
                                      18);
        if (data == null) {
            self.report_error("cannot allocate str buffer");
            return null;
        }
        let nul_pos = self.ptr_offset_bytes(data, len_v, "mir.str.nul");
        if (nul_pos == null) {
            self.report_error("cannot address str terminator");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), nul_pos);
        return data;
    }

    public fn alloc_string_data_with_cap_malloc(self, len_v: rawptr, cap_v: rawptr) -> rawptr {
        if (len_v == null || cap_v == null) { return null; }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        let data = vyx_rt_build_call1(self.mod,
                                      self.builtin_malloc_fty,
                                      self.builtin_malloc_fn,
                                      cap_v,
                                      "mir.str.malloc.alloc".c_str(),
                                      20);
        if (data == null) {
            self.report_error("cannot allocate str buffer");
            return null;
        }
        let nul_pos = self.ptr_offset_bytes(data, len_v, "mir.str.malloc.nul");
        if (nul_pos == null) {
            self.report_error("cannot address str terminator");
            return null;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), nul_pos);
        return data;
    }

    public fn alloc_string_data_for_len(self, len_v: rawptr) -> rawptr {
        if (len_v == null) { return null; }
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        return self.alloc_string_data_with_cap(len_v, cap_v);
    }

    public fn copied_string_data_from_cstr_len(self, src: rawptr, len_v: rawptr) -> rawptr {
        if (src == null || len_v == null) { return null; }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return null;
        }
        let dst = self.alloc_string_data_for_len(len_v);
        if (dst == null) { return null; }
        let copied = vyx_rt_build_call3(self.mod,
                                        self.builtin_memcpy_fty,
                                        self.builtin_memcpy_fn,
                                        dst,
                                        src,
                                        len_v,
                                        llvm_mir_empty_name(),
                                        0);
        if (copied == null) {
            self.report_error("cannot copy str buffer");
            return null;
        }
        return dst;
    }

    public fn type_is_str_abi(self, type_id: i32) -> bool {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_STRING()) { return true; }
        if (kind == ty_CLASS()) {
            let text = llvm_mir_type_text(&self.m, type_id);
            if (llvm_mir_is_primitive_str_name(text)) { return true; }
        }
        return false;
    }

    public fn type_is_std_string_class(self, type_id: i32) -> bool {
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let text = llvm_mir_type_text(&self.m, canonical_type);
        if (text.len == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        if (self.last_path_segment(base) != "String") { return false; }
        if (self.field_id_for_type_name(canonical_type, "ptr") == mir_id_invalid()) { return false; }
        if (self.field_id_for_type_name(canonical_type, "len") == mir_id_invalid()) { return false; }
        if (self.field_id_for_type_name(canonical_type, "cap") == mir_id_invalid()) { return false; }
        if (self.field_id_for_type_name(canonical_type, "owned") == mir_id_invalid()) { return false; }
        return self.field_id_for_type_name(canonical_type, "inline0") != mir_id_invalid();
    }

    public fn type_is_string_view_type(self, type_id: i32) -> bool {
        if (self.type_is_str_abi(type_id)) { return true; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_REF() || kind == ty_MUTREF()) {
            return self.type_is_str_abi(hir_type_table_elem(self.m.types, type_id));
        }
        return self.type_is_std_string_class(type_id);
    }

    public fn default_value_for_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) {
            self.report_error("cannot lower default_value with empty return type");
            return null;
        }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_VOID()) { return null; }
        if (self.type_is_str_abi(type_id)) { return self.emit_str_value(""); }
        if (self.type_is_option_abi(type_id)) {
            return self.build_option_value_from_parts(type_id,
                                                      vyx_rt_const_int(self.mod, self.ty_i32, 1, 0),
                                                      null);
        }
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits > 0) {
            return vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), 0, 0);
        }
        if (llvm_mir_kind_pointer_handle(kind)) {
            return self.pointer_handle_null();
        }
        if (llvm_mir_kind_pointer_like(kind)) {
            return vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        }
        let ll_ty = self.lower_type(type_id);
        if (ll_ty == null) {
            self.report_error("cannot lower default_value for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_const_null(self.mod, ll_ty);
    }

    public fn bodyless_default_value_call(self, value_id: i32, target_fn: i32, call_name: string) -> bool {
        if (call_name != "default_value") { return false; }
        if (target_fn == mir_id_invalid()) { return false; }
        if (self.call_arg_count(value_id) != 0) { return false; }
        if (self.function_can_be_declared(target_fn)) { return false; }
        return self.m.function_first_block(target_fn) == mir_id_invalid();
    }

    public fn lower_default_new_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let argc = self.call_arg_count(value_id);
        let type_id = self.m.value_type(value_id);
        if (argc == 1) {
            let source_id = self.call_arg_at(value_id, 0);
            let source = self.lower_value_as(source_id, type_id);
            if (source == null) {
                self.report_error("builtin " + builtin_name + " cannot construct `"
                                  + llvm_mir_type_text(&self.m, type_id)
                                  + "` from the provided value");
            }
            return source;
        }
        if (argc != 0) {
            self.report_error("builtin " + builtin_name + " for `"
                              + llvm_mir_type_text(&self.m, type_id)
                              + "` accepts zero arguments for value initialization or one value for move construction; got "
                              + policy_i64_to_string(argc as i64));
            return null;
        }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.build_zeroed_class_object(type_id);
        }
        return self.default_value_for_type(type_id);
    }

    public fn bodyless_i64_constant_known(self, call_name: string) -> bool {
        if (call_name == "string_sso_capacity") { return true; }
        if (call_name == "string_inline_flag") { return true; }
        if (call_name == "string_heap_flag") { return true; }
        if (call_name == "str_borrowed_flag") { return true; }
        if (call_name == "str_malloc_flag") { return true; }
        if (call_name == "str_header_flag") { return true; }
        if (call_name == "str_runtime_flag") { return true; }
        if (call_name == "str_pooled_flag") { return true; }
        return false;
    }

    public fn bodyless_i64_constant_value(self, call_name: string) -> i64 {
        if (call_name == "string_sso_capacity") { return 23; }
        if (call_name == "string_heap_flag") { return 1; }
        if (call_name == "str_malloc_flag") { return 1; }
        if (call_name == "str_header_flag") { return 2; }
        if (call_name == "str_runtime_flag") { return 3; }
        if (call_name == "str_pooled_flag") { return 4; }
        return 0;
    }

    public fn bodyless_i64_constant_call(self, value_id: i32, target_fn: i32, call_name: string) -> rawptr {
        if (!self.bodyless_i64_constant_known(call_name)) { return null; }
        if (target_fn == mir_id_invalid()) { return null; }
        if (self.call_arg_count(value_id) != 0) { return null; }
        if (self.m.function_first_block(target_fn) != mir_id_invalid()) { return null; }
        return vyx_rt_const_int(self.mod,
                                self.lower_type(self.m.value_type(value_id)),
                                self.bodyless_i64_constant_value(call_name),
                                0);
    }

    public fn kind_is_numeric_identity_scalar(self, kind: i32) -> bool {
        if (kind == ty_I8() || kind == ty_I16() || kind == ty_I32() || kind == ty_I64()) { return true; }
        if (kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()) { return true; }
        if (kind == ty_ISIZE() || kind == ty_USIZE()) { return true; }
        if (kind == ty_F32() || kind == ty_F64()) { return true; }
        return false;
    }

    public fn bodyless_numeric_identity_call(self, value_id: i32, target_fn: i32, call_name: string) -> rawptr {
        if (call_name != "zero" && call_name != "one") { return null; }
        if (target_fn == mir_id_invalid()) { return null; }
        if (self.call_arg_count(value_id) != 0) { return null; }
        if (self.m.function_first_block(target_fn) != mir_id_invalid()) { return null; }
        let type_id = self.m.value_type(value_id);
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (!self.kind_is_numeric_identity_scalar(kind)) { return null; }
        var numeric_value: i64 = 0;
        var real_value: f64 = 0.0;
        if (call_name == "one") {
            numeric_value = 1;
            real_value = 1.0;
        }
        if (llvm_mir_kind_float(kind)) {
            return vyx_rt_const_real(self.mod, self.lower_type(type_id), real_value);
        }
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits <= 0) { return null; }
        return vyx_rt_const_int(self.mod, self.int_type_for_bits(bits), numeric_value, 0);
    }

    public fn last_path_segment(self, name: string) -> string {
        var start: i32 = 0;
        var i: i32 = 0;
        while (i < name.len) {
            if (name.charAt(i) == 46) { start = i + 1; }
            i = i + 1;
        }
        return name.substring(start, name.len as i32);
    }

    public fn compute_type_is_result_abi(self, type_id: i32) -> bool {
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (policy_generic_call_has_args(text) == 0) { return false; }
        return self.last_path_segment(policy_generic_call_base(text)) == "Result";
    }

    public fn type_is_result_abi(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.result_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let result = self.compute_type_is_result_abi(type_id);
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.result_abi_cache, type_id, state);
        return result;
    }

    public fn compute_type_is_option_abi(self, type_id: i32) -> bool {
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (policy_generic_call_has_args(text) == 0) { return false; }
        return self.last_path_segment(policy_generic_call_base(text)) == "Option";
    }

    public fn type_is_option_abi(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.option_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let result = self.compute_type_is_option_abi(type_id);
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.option_abi_cache, type_id, state);
        return result;
    }

    public fn type_id_by_text(self, text: string) -> i32 {
        if (text.len == 0) { return mir_id_invalid(); }
        var normalized = text;
        if (llvm_mir_is_primitive_str_name(normalized)) { normalized = "str"; }
        self.ensure_type_text_index();
        if (normalized == "rawptr" && self.interned_rawptr_type_id != mir_id_invalid()) {
            return self.interned_rawptr_type_id;
        }
        if (normalized == "str" && self.interned_str_type_id != mir_id_invalid()) {
            return self.interned_str_type_id;
        }
        if (normalized == "f32" && self.interned_f32_type_id != mir_id_invalid()) {
            return self.interned_f32_type_id;
        }
        if (normalized == "f64" && self.interned_f64_type_id != mir_id_invalid()) {
            return self.interned_f64_type_id;
        }
        if (self.type_text_index != null) {
            let preferred_kind = self.preferred_type_kind_for_text(normalized);
            if (preferred_kind != 0) {
                let preferred = llvm_mir_symbol_index_get(self.type_text_index,
                                                          self.type_text_index_cap,
                                                          self.type_text_kind_key(preferred_kind, normalized));
                if (preferred != mir_id_invalid()) { return preferred; }
            }
            let exact = llvm_mir_symbol_index_get(self.type_text_index,
                                                  self.type_text_index_cap,
                                                  normalized);
            if (exact != mir_id_invalid()) { return exact; }
        } else {
            let preferred_kind = self.preferred_type_kind_for_text(normalized);
            if (preferred_kind != 0) {
                var preferred_id: i32 = 1;
                while (preferred_id <= self.m.types.count) {
                    if (llvm_mir_type_text(&self.m, preferred_id) == normalized
                        && llvm_mir_type_kind(&self.m, preferred_id) == preferred_kind) {
                        return preferred_id;
                    }
                    preferred_id = preferred_id + 1;
                }
            }
            var exact_id: i32 = 1;
            while (exact_id <= self.m.types.count) {
                if (llvm_mir_type_text(&self.m, exact_id) == normalized) { return exact_id; }
                exact_id = exact_id + 1;
            }
        }
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (self.type_text_equivalent(llvm_mir_type_text(&self.m, id), normalized)) { return id; }
            id = id + 1;
        }
        return mir_id_invalid();
    }

    public fn preferred_type_kind_for_text(self, text: string) -> i32 {
        let normalized = self.trim_type_text(text);
        // Generic argument placeholders may share text with the concrete
        // pointer type. Size/storage queries must select its structured kind.
        if (normalized.startsWith("*")) { return ty_PTR(); }
        if (normalized.startsWith("&mut ")) { return ty_MUTREF(); }
        if (normalized.startsWith("&")) { return ty_REF(); }
        let pointer_base = policy_generic_call_base(normalized.clone());
        if (pointer_base == "ptr") { return ty_PTR(); }
        if (pointer_base == "ref") { return ty_REF(); }
        if (pointer_base == "mutref") { return ty_MUTREF(); }
        if (normalized.len >= 4 && normalized.substring(0, 4) == "cfn(") { return ty_CFN(); }
        if (normalized.len >= 10 && normalized.substring(0, 10) == "unsafe fn(") { return ty_CFN(); }
        if (normalized.len >= 3 && normalized.substring(0, 3) == "fn(") { return ty_FN(); }
        return 0;
    }

    public fn type_is_heap_indirect_deref_type(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        var text = llvm_mir_type_text(&self.m, type_id);
        let canonical_type = self.canonical_record_type_id(type_id);
        if (policy_generic_call_has_args(text.clone()) == 0) {
            text = llvm_mir_type_text(&self.m, canonical_type);
        }
        if (policy_generic_call_has_args(text.clone()) == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        let segment = self.last_path_segment(base);
        if (segment != "Box" && segment != "Ref") { return false; }
        let data_field = self.field_id_for_type_name(canonical_type, "data");
        if (data_field == mir_id_invalid()) { return false; }
        return llvm_mir_type_kind(&self.m, mir_unit_field_type(&self.m, data_field)) == ty_RAWPTR();
    }

    public fn heap_indirect_payload_type(self, type_id: i32) -> i32 {
        if (!self.type_is_heap_indirect_deref_type(type_id)) { return mir_id_invalid(); }
        var text = llvm_mir_type_text(&self.m, type_id);
        if (policy_generic_call_has_args(text.clone()) == 0) {
            text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(type_id));
        }
        let args = policy_generic_call_args(text.clone());
        let payload_text = policy_generic_arg_at(args, 0);
        if (payload_text.len == 0) { return mir_id_invalid(); }
        return self.type_id_by_text(payload_text);
    }

    public fn heap_indirect_payload_matches(self, src_type_id: i32, dst_type_id: i32) -> bool {
        if (src_type_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return false; }
        let payload_type = self.heap_indirect_payload_type(src_type_id);
        if (payload_type == mir_id_invalid()) { return false; }
        return self.type_ids_compatible(payload_type, dst_type_id);
    }

    public fn type_is_ref_counted_handle(self, type_id: i32) -> bool {
        return self.ref_counted_handle_offset(type_id) >= 0;
    }

    public fn ref_counted_handle_offset(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return -1; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return -1; }
        let canonical_type = self.canonical_record_type_id(type_id);
        var text = llvm_mir_type_text(&self.m, type_id);
        if (policy_generic_call_has_args(text.clone()) == 0) {
            text = llvm_mir_type_text(&self.m, canonical_type);
        }
        if (policy_generic_call_has_args(text.clone()) == 0) { return -1; }
        let base = policy_generic_call_base(text.clone());
        let handle = self.last_path_segment(base);
        if (handle != "Ref" && handle != "Weak") { return -1; }
        let data_field = self.field_id_for_type_name(canonical_type, "data");
        let rc_field = self.field_id_for_type_name(canonical_type, "rc");
        if (data_field == mir_id_invalid() || rc_field == mir_id_invalid()) { return -1; }
        if (llvm_mir_type_kind(&self.m, mir_unit_field_type(&self.m, data_field)) != ty_RAWPTR()) { return -1; }
        if (llvm_mir_type_kind(&self.m, mir_unit_field_type(&self.m, rc_field)) != ty_RAWPTR()) { return -1; }
        if (handle == "Ref") { return 0; }
        return 8;
    }

    public fn place_is_owning_drop_local(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local_id = self.m.place_local(place_id);
        if (local_id == mir_id_invalid()) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_auto_drop()) != 0;
    }

    public fn value_reads_move_parameter(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_read_place()) { return false; }
        let place_id = self.m.value_place(value_id);
        if (place_id == mir_id_invalid()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local_id = self.m.place_local(place_id);
        if (local_id == mir_id_invalid()) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_move_arg()) != 0;
    }

    public fn value_reads_same_local_place(self, value_id: i32, place_id: i32) -> bool {
        if (value_id == mir_id_invalid() || place_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_read_place()) { return false; }
        let src_place = self.m.value_place(value_id);
        if (src_place == place_id) { return true; }
        if (self.m.place_kind(src_place) != mir_place_local()) { return false; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        return self.m.place_local(src_place) == self.m.place_local(place_id);
    }

    // `str` is a value view and does not carry a buffer reference count.  A
    // self-assignment may reclaim or mutate its old buffer only when no prior
    // MIR operation could have retained an alias.  This is deliberately a
    // local, intraprocedural proof: calls, address formation, captures, drops,
    // derived places, and unrecognized prior reads all reject the fast path.
    public fn string_append_value_mentions_local(self, value_id: i32, local_id: i32) -> bool {
        self.local_lifetime_marker_value_visit_budget = llvm_mir_lifetime_marker_max_value_visits();
        self.local_lifetime_marker_value_query_failed = false;
        let mentions = self.local_lifetime_marker_value_uses_local(value_id, local_id);
        return mentions || self.local_lifetime_marker_value_query_failed;
    }

    public fn string_append_prior_assign_is_self_update(self,
                                                        instr_id: i32,
                                                        place_id: i32,
                                                        local_id: i32) -> bool {
        if (self.m.instr_kind(instr_id) != mir_instr_assign()
            || self.m.instr_place(instr_id) != place_id) {
            return false;
        }
        let prior_value = self.m.instr_value(instr_id);
        if (prior_value == mir_id_invalid()
            || self.m.value_kind(prior_value) != mir_value_binary()
            || self.m.value_op(prior_value) != llvm_mir_tk_PLUS()) {
            return false;
        }
        let prior_lhs = self.m.value_lhs(prior_value);
        let prior_rhs = self.m.value_rhs(prior_value);
        return self.value_reads_same_local_place(prior_lhs, place_id)
            && !self.string_append_value_mentions_local(prior_rhs, local_id);
    }

    public fn string_append_local_is_proven_unique(self,
                                                   instr_id: i32,
                                                   place_id: i32) -> bool {
        if (instr_id == mir_id_invalid() || place_id == mir_id_invalid()
            || self.m.place_kind(place_id) != mir_place_local()) {
            return false;
        }
        let local_id = self.m.place_local(place_id);
        if (local_id == mir_id_invalid() || self.m.local_function(local_id) != self.current_function_id) {
            return false;
        }
        let rejected_flags = mir_local_flag_param()
            | mir_local_flag_capture()
            | mir_local_flag_move_arg()
            | mir_local_flag_self_receiver()
            | mir_local_flag_reference_capture();
        if ((self.m.local_flags(local_id) & rejected_flags) != 0
            || self.local_lifetime_marker_has_address_or_capture(local_id)) {
            return false;
        }

        var initialized: bool = false;
        var prior_id: i32 = 1;
        while (prior_id < instr_id) {
            if (!mir_unit_instr_owner_is_removed(&self.m, prior_id)
                && self.m.instr_function(prior_id) == self.current_function_id) {
                let prior_kind = self.m.instr_kind(prior_id);
                let prior_place = self.m.instr_place(prior_id);
                if (prior_place == place_id && prior_kind == mir_instr_storage_live()) {
                    // Initial storage has no value to alias.
                } else if (prior_place == place_id
                           && !initialized
                           && !self.string_append_value_mentions_local(self.m.instr_value(prior_id), local_id)) {
                    // The first direct assignment establishes this local. It
                    // may not read the local it initializes.
                    initialized = true;
                } else if (prior_place == place_id
                           && initialized
                           && self.string_append_prior_assign_is_self_update(prior_id,
                                                                              place_id,
                                                                              local_id)) {
                    // Earlier `local = local + suffix` updates preserve the
                    // same uniqueness proof when suffix is independent.
                } else if (self.string_append_value_mentions_local(self.m.instr_value(prior_id), local_id)
                           || self.string_append_value_mentions_local(self.m.instr_lhs(prior_id), local_id)
                           || self.string_append_value_mentions_local(self.m.instr_rhs(prior_id), local_id)
                           || prior_place == place_id) {
                    return false;
                }
            }
            prior_id = prior_id + 1;
        }
        return true;
    }

    public fn assignment_should_retain_ref_handle(self, place_id: i32, value_id: i32, dst_type_id: i32) -> bool {
        if (!self.type_is_ref_counted_handle(dst_type_id)) { return false; }
        if (!self.place_is_owning_drop_local(place_id)) { return false; }
        if (self.m.value_kind(value_id) != mir_value_read_place()) { return false; }
        if (self.value_reads_move_parameter(value_id)) { return false; }
        if (self.value_reads_same_local_place(value_id, place_id)) { return false; }
        return true;
    }

    public fn retain_ref_handle_value(self, value: rawptr, type_id: i32) -> rawptr {
        if (value == null || !self.type_is_ref_counted_handle(type_id)) { return value; }
        if (self.current_function_value == null) {
            self.report_error("cannot retain Ref handle outside a function");
            return null;
        }
        var rc_ptr: rawptr = null;
        var data_ptr: rawptr = null;
        var retained_value = value;
        if (self.type_is_class_pointer_abi(type_id)) {
            let rc_addr = self.record_field_addr_for_type(value, type_id, "rc");
            let data_addr = self.record_field_addr_for_type(value, type_id, "data");
            if (rc_addr != null && data_addr != null) {
                rc_ptr = vyx_rt_build_load(self.mod,
                                           self.ty_ptr,
                                           rc_addr,
                                           "mir.ref.rc".c_str(),
                                           10);
                data_ptr = vyx_rt_build_load(self.mod,
                                              self.ty_ptr,
                                              data_addr,
                                              "mir.ref.data".c_str(),
                                              12);
            }
        } else {
            rc_ptr = vyx_rt_build_extract_value(self.mod,
                                                value,
                                                1,
                                                "mir.ref.rc".c_str(),
                                                10);
        }
        if (rc_ptr == null) {
            self.report_error("cannot read Ref rc field for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        // Classes use pointer ABI, so a raw assignment otherwise aliases the
        // handle wrapper itself. Ref/Weak require value-handle semantics:
        // copy the two pointer fields into a distinct wrapper before updating
        // the matching strong or weak count.
        if (self.type_is_class_pointer_abi(type_id)) {
            let wrapper = self.build_zeroed_class_object(type_id);
            let wrapper_data = self.record_field_addr_for_type(wrapper, type_id, "data");
            let wrapper_rc = self.record_field_addr_for_type(wrapper, type_id, "rc");
            if (wrapper == null || wrapper_data == null || wrapper_rc == null || data_ptr == null) {
                self.report_error("cannot materialize independent Ref handle for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            vyx_rt_build_store(self.mod, data_ptr, wrapper_data);
            vyx_rt_build_store(self.mod, rc_ptr, wrapper_rc);
            retained_value = wrapper;
        }
        let live = vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_ne(),
                                     rc_ptr,
                                     vyx_rt_const_null(self.mod, self.ty_ptr),
                                     "mir.ref.live".c_str(),
                                     12);
        if (live == null) {
            self.report_error("cannot test Ref rc field for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let retain_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            "mir.ref.retain".c_str(),
                                            14);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.ref.retain.cont".c_str(),
                                          19);
        if (retain_bb == null || cont_bb == null) {
            self.report_error("cannot create Ref retain control flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, live, retain_bb, cont_bb);
        vyx_rt_position_at_end(self.mod, retain_bb);
        let count_offset = self.ref_counted_handle_offset(type_id);
        let count_ptr = self.ptr_offset_bytes(rc_ptr,
                                              vyx_rt_const_int(self.mod, self.ty_i64, count_offset, 0),
                                              "mir.ref.count.addr");
        let prior_count = vyx_rt_build_atomicrmw_add(self.mod,
                                                      count_ptr,
                                                      vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                                      "mir.ref.count.atomic_add".c_str(),
                                                      24);
        if (prior_count == null) {
            self.report_error("cannot atomically retain Ref for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        vyx_rt_build_br(self.mod, cont_bb);
        vyx_rt_position_at_end(self.mod, cont_bb);
        return retained_value;
    }

    public fn release_replaced_string_storage(self,
                                              base_ptr: rawptr,
                                              base_owned: rawptr) -> bool {
        if (base_ptr == null || base_owned == null || self.current_function_value == null) {
            self.report_error("cannot release replaced string storage");
            return false;
        }
        if (self.builtin_free_fn == null || self.builtin_free_fty == null
            || self.builtin_forget_string_len_fn == null
            || self.builtin_forget_string_len_fty == null
            || self.builtin_pooled_string_free_fn == null
            || self.builtin_pooled_string_free_fty == null
            || self.builtin_runtime_string_free_fn == null
            || self.builtin_runtime_string_free_fty == null) {
            self.report_error("string storage deallocator declarations are unavailable");
            return false;
        }
        let local_name = "mir.str.release.local";
        let check_name = "mir.str.release.check";
        let runtime_name = "mir.str.release.runtime";
        let pooled_name = "mir.str.release.pooled";
        let cont_name = "mir.str.release.cont";
        let local_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           local_name.c_str(),
                                           local_name.len as u64);
        let check_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           check_name.c_str(),
                                           check_name.len as u64);
        let runtime_bb = vyx_rt_append_block(self.mod,
                                             self.current_function_value,
                                             runtime_name.c_str(),
                                             runtime_name.len as u64);
        let pooled_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            pooled_name.c_str(),
                                            pooled_name.len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          cont_name.c_str(),
                                          cont_name.len as u64);
        let is_local = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         base_owned,
                                         vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                         llvm_mir_empty_name(),
                                         0);
        if (local_bb == null || check_bb == null || runtime_bb == null || pooled_bb == null
            || cont_bb == null || is_local == null) {
            self.report_error("cannot create string storage release control flow");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, is_local, local_bb, check_bb);

        vyx_rt_position_at_end(self.mod, local_bb);
        vyx_rt_build_call1(self.mod,
                           self.builtin_forget_string_len_fty,
                           self.builtin_forget_string_len_fn,
                           base_ptr,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_call1(self.mod,
                           self.builtin_free_fty,
                           self.builtin_free_fn,
                           base_ptr,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, check_bb);
        let is_runtime = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_eq(),
                                           base_owned,
                                           vyx_rt_const_int(self.mod, self.ty_i64, 3, 0),
                                           llvm_mir_empty_name(),
                                           0);
        if (is_runtime == null) {
            self.report_error("cannot classify replaced string storage");
            return false;
        }
        let pooled_check_name = "mir.str.release.pooled.check";
        let pooled_check_bb = vyx_rt_append_block(self.mod,
                                                  self.current_function_value,
                                                  pooled_check_name.c_str(),
                                                  pooled_check_name.len as u64);
        if (pooled_check_bb == null) {
            self.report_error("cannot create pooled string release branch");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, is_runtime, runtime_bb, pooled_check_bb);

        vyx_rt_position_at_end(self.mod, runtime_bb);
        vyx_rt_build_call1(self.mod,
                           self.builtin_runtime_string_free_fty,
                           self.builtin_runtime_string_free_fn,
                           base_ptr,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, pooled_check_bb);
        let is_pooled = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_eq(),
                                          base_owned,
                                          vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                          llvm_mir_empty_name(),
                                          0);
        if (is_pooled == null) {
            self.report_error("cannot classify pooled string storage");
            return false;
        }
        vyx_rt_build_cond_br(self.mod, is_pooled, pooled_bb, cont_bb);

        vyx_rt_position_at_end(self.mod, pooled_bb);
        vyx_rt_build_call1(self.mod,
                           self.builtin_pooled_string_free_fty,
                           self.builtin_pooled_string_free_fn,
                           base_ptr,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_br(self.mod, cont_bb);
        vyx_rt_position_at_end(self.mod, cont_bb);
        return true;
    }

    public fn lower_string_append_assign_into_place(self, instr_id: i32, place_id: i32, value_id: i32, dst_addr: rawptr, dst_type: i32) -> bool {
        if (place_id == mir_id_invalid() || value_id == mir_id_invalid() || dst_addr == null) { return false; }
        if (!self.type_is_str_abi(dst_type)) { return false; }
        if (self.m.value_kind(value_id) != mir_value_binary()) { return false; }
        if (self.m.value_op(value_id) != llvm_mir_tk_PLUS()) { return false; }
        if (!self.type_is_string_view_type(self.m.value_type(value_id))) { return false; }

        let lhs_id = self.m.value_lhs(value_id);
        let rhs_id = self.m.value_rhs(value_id);
        if (!self.value_reads_same_local_place(lhs_id, place_id)) { return false; }
        if (rhs_id == mir_id_invalid()) { return false; }
        if (!self.string_append_local_is_proven_unique(instr_id, place_id)) { return false; }
        let base_value = self.lower_string_view_value(lhs_id);
        let rhs_value = self.lower_string_view_value(rhs_id);
        if (base_value == null || rhs_value == null) {
            self.report_error("cannot lower string append-assign operands");
            return true;
        }
        let base_ptr = self.string_ptr_value(base_value);
        let base_len = self.string_len_value(base_value);
        let base_cap = self.string_cap_value(base_value);
        let base_owned = self.string_owned_value(base_value);
        let rhs_ptr = self.string_ptr_value(rhs_value);
        let rhs_len = self.string_len_value(rhs_value);
        if (base_ptr == null || base_len == null || base_cap == null || base_owned == null
            || rhs_ptr == null || rhs_len == null) {
            self.report_error("cannot extract string append-assign fields");
            return true;
        }
        if (self.current_function_value == null
            || self.builtin_malloc_fn == null || self.builtin_malloc_fty == null
            || self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null
            || self.builtin_memmove_fn == null || self.builtin_memmove_fty == null) {
            self.report_error("string append-assign lowering declarations are unavailable");
            return true;
        }

        // Allocation and deallocation stay in the generated module. This is
        // necessary for JIT code: a buffer from its CRT allocation domain must
        // never cross into a runtime DLL and later be released by IR free().
        let one = vyx_rt_const_int(self.mod, self.ty_i64, 1, 0);
        let min_cap = vyx_rt_const_int(self.mod, self.ty_i64, 64, 0);
        let total = vyx_rt_build_add(self.mod, base_len, rhs_len, "mir.str.append.len".c_str(), 18);
        let needed = vyx_rt_build_add(self.mod, total, one, "mir.str.append.needed".c_str(), 21);
        let doubled = vyx_rt_build_mul(self.mod, base_cap, vyx_rt_const_int(self.mod, self.ty_i64, 2, 0), "mir.str.append.double".c_str(), 21);
        let at_least_min = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_uge(), doubled, min_cap, llvm_mir_empty_name(), 0);
        let geometric = vyx_rt_build_select(self.mod, at_least_min, doubled, min_cap, "mir.str.append.geometric".c_str(), 24);
        let enough_growth = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_uge(), geometric, needed, llvm_mir_empty_name(), 0);
        let grown_cap = vyx_rt_build_select(self.mod, enough_growth, geometric, needed, "mir.str.append.cap".c_str(), 18);
        let is_local = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         base_owned,
                                         one,
                                         llvm_mir_empty_name(),
                                         0);
        let has_capacity = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_uge(),
                                             base_cap,
                                             needed,
                                             llvm_mir_empty_name(),
                                             0);
        let reuse = vyx_rt_build_and(self.mod, is_local, has_capacity, "mir.str.append.reuse".c_str(), 20);
        let reuse_name = "mir.str.append.reuse";
        let alloc_name = "mir.str.append.alloc";
        let join_name = "mir.str.append.join";
        let reuse_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           reuse_name.c_str(),
                                           reuse_name.len as u64);
        let alloc_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           alloc_name.c_str(),
                                           alloc_name.len as u64);
        let join_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          join_name.c_str(),
                                          join_name.len as u64);
        if (one == null || min_cap == null || total == null || needed == null
            || doubled == null || at_least_min == null || geometric == null
            || enough_growth == null || grown_cap == null || is_local == null
            || has_capacity == null || reuse == null || reuse_bb == null
            || alloc_bb == null || join_bb == null) {
            self.report_error("cannot create string append-assign control flow");
            return true;
        }
        vyx_rt_build_cond_br(self.mod, reuse, reuse_bb, alloc_bb);

        // memmove preserves self/slice append semantics when rhs aliases the
        // existing local buffer.
        vyx_rt_position_at_end(self.mod, reuse_bb);
        let reuse_tail = self.ptr_offset_bytes(base_ptr, base_len, "mir.str.append.reuse.tail");
        let reuse_end = self.ptr_offset_bytes(base_ptr, total, "mir.str.append.reuse.end");
        let reuse_copy = vyx_rt_build_call3(self.mod,
                                            self.builtin_memmove_fty,
                                            self.builtin_memmove_fn,
                                            reuse_tail,
                                            rhs_ptr,
                                            rhs_len,
                                            llvm_mir_empty_name(),
                                            0);
        if (reuse_tail == null || reuse_end == null || reuse_copy == null) {
            self.report_error("cannot emit in-place string append");
            return true;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), reuse_end);
        let reuse_end_bb = vyx_rt_get_insert_block(self.mod);
        vyx_rt_build_br(self.mod, join_bb);

        // A replacement allocation is made by the same malloc/free pair that
        // owns ordinary IR strings. Copy before releasing base so aliasing rhs
        // remains valid on the growth path too.
        vyx_rt_position_at_end(self.mod, alloc_bb);
        let allocated = vyx_rt_build_call1(self.mod,
                                            self.builtin_malloc_fty,
                                            self.builtin_malloc_fn,
                                            grown_cap,
                                            "mir.str.append.data".c_str(),
                                            19);
        let alloc_head_copy = vyx_rt_build_call3(self.mod,
                                                 self.builtin_memcpy_fty,
                                                 self.builtin_memcpy_fn,
                                                 allocated,
                                                 base_ptr,
                                                 base_len,
                                                 llvm_mir_empty_name(),
                                                 0);
        let alloc_tail = self.ptr_offset_bytes(allocated, base_len, "mir.str.append.alloc.tail");
        let alloc_tail_copy = vyx_rt_build_call3(self.mod,
                                                 self.builtin_memcpy_fty,
                                                 self.builtin_memcpy_fn,
                                                 alloc_tail,
                                                 rhs_ptr,
                                                 rhs_len,
                                                 llvm_mir_empty_name(),
                                                 0);
        let alloc_end = self.ptr_offset_bytes(allocated, total, "mir.str.append.alloc.end");
        if (allocated == null || alloc_head_copy == null || alloc_tail == null
            || alloc_tail_copy == null || alloc_end == null) {
            self.report_error("cannot emit replacement string append");
            return true;
        }
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i8, 0, 0), alloc_end);
        if (!self.release_replaced_string_storage(base_ptr, base_owned)) { return true; }
        let alloc_end_bb = vyx_rt_get_insert_block(self.mod);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, join_bb);
        let result_ptr = vyx_rt_build_phi(self.mod, self.ty_ptr, "mir.str.append.ptr".c_str(), 18);
        let result_cap = vyx_rt_build_phi(self.mod, self.ty_i64, "mir.str.append.result.cap".c_str(), 25);
        if (reuse_end_bb == null || alloc_end_bb == null || result_ptr == null || result_cap == null) {
            self.report_error("cannot join string append-assign result");
            return true;
        }
        vyx_rt_add_incoming(self.mod, result_ptr, base_ptr, reuse_end_bb);
        vyx_rt_add_incoming(self.mod, result_ptr, allocated, alloc_end_bb);
        vyx_rt_add_incoming(self.mod, result_cap, base_cap, reuse_end_bb);
        vyx_rt_add_incoming(self.mod, result_cap, grown_cap, alloc_end_bb);
        let out_value = self.emit_string_value_from_parts(result_ptr,
                                                          total,
                                                          result_cap,
                                                          one);
        if (out_value == null) {
            self.report_error("cannot assemble string append-assign result");
            return true;
        }
        vyx_rt_build_store(self.mod, out_value, dst_addr);
        return true;
    }

    public fn lower_heap_indirect_payload_address(self, value_id: i32, dst_type_id: i32) -> rawptr {
        let src_type_id = self.m.value_type(value_id);
        let payload_type = self.heap_indirect_payload_type(src_type_id);
        if (payload_type == mir_id_invalid() || !self.type_ids_compatible(payload_type, dst_type_id)) {
            self.report_error("cannot resolve heap-indirected payload address from "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " to "
                      + llvm_mir_type_text(&self.m, dst_type_id));
            return null;
        }
        let base_addr = self.lower_self_receiver_address(value_id, src_type_id);
        let data_addr = self.record_field_addr_for_type(base_addr, src_type_id, "data");
        if (base_addr == null || data_addr == null) {
            self.report_error("cannot address heap-indirected storage for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        let data_ptr = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         data_addr,
                                         "mir.deref.data".c_str(),
                                         14);
        if (data_ptr == null) {
            self.report_error("cannot load heap-indirected payload address for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        return data_ptr;
    }

    public fn lower_heap_indirect_payload_value(self, value_id: i32, dst_type_id: i32) -> rawptr {
        let src_type_id = self.m.value_type(value_id);
        let payload_type = self.heap_indirect_payload_type(src_type_id);
        if (payload_type == mir_id_invalid()) {
            self.report_error("cannot resolve heap-indirected payload type for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        let data_ptr = self.lower_heap_indirect_payload_address(value_id, payload_type);
        let payload_ll_ty = self.lower_type(payload_type);
        if (data_ptr == null || payload_ll_ty == null) {
            self.report_error("cannot address heap-indirected payload for "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        if (self.type_is_class_pointer_abi(payload_type)) {
            return self.cast_value(data_ptr, payload_type, dst_type_id);
        }
        let payload = vyx_rt_build_load(self.mod,
                                        payload_ll_ty,
                                        data_ptr,
                                        "mir.deref.value".c_str(),
                                        15);
        if (payload == null) {
            self.report_error("cannot load heap-indirected payload "
                      + llvm_mir_type_text(&self.m, payload_type)
                      + " from "
                      + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        return self.cast_value(payload, payload_type, dst_type_id);
    }

    public fn common_float_type_id(self, lhs_type: i32, rhs_type: i32, preferred_type: i32) -> i32 {
        let preferred_kind = llvm_mir_type_kind(&self.m, preferred_type);
        if (llvm_mir_kind_float(preferred_kind)) { return preferred_type; }
        let lhs_kind = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind = llvm_mir_type_kind(&self.m, rhs_type);
        if (lhs_kind == ty_F64() || rhs_kind == ty_F64()) {
            let f64_id = self.type_id_by_text("f64");
            if (f64_id != mir_id_invalid()) { return f64_id; }
            if (lhs_kind == ty_F64()) { return lhs_type; }
            return rhs_type;
        }
        if (lhs_kind == ty_F32() || rhs_kind == ty_F32()) {
            let f32_id = self.type_id_by_text("f32");
            if (f32_id != mir_id_invalid()) { return f32_id; }
            if (lhs_kind == ty_F32()) { return lhs_type; }
            return rhs_type;
        }
        if (preferred_type != mir_id_invalid()) { return preferred_type; }
        return lhs_type;
    }

    public fn binary_float_compare_type_id(self, lhs_id: i32, rhs_id: i32, lhs_type: i32, rhs_type: i32, out_type: i32) -> i32 {
        let lhs_kind = llvm_mir_type_kind(&self.m, lhs_type);
        let rhs_kind = llvm_mir_type_kind(&self.m, rhs_type);
        let lhs_is_literal = self.m.value_kind(lhs_id) == mir_value_const_float();
        let rhs_is_literal = self.m.value_kind(rhs_id) == mir_value_const_float();
        if (rhs_is_literal && lhs_kind == ty_F32()) { return lhs_type; }
        if (lhs_is_literal && rhs_kind == ty_F32()) { return rhs_type; }
        return self.common_float_type_id(lhs_type, rhs_type, out_type);
    }

    public fn append_csv(self, acc: string, item: string) -> string {
        if (acc.len == 0) { return item; }
        return acc + "," + item;
    }

    public fn function_generic_binding(self, function_id: i32, name: string) -> string {
        if (name.len == 0 || function_id == mir_id_invalid()) { return ""; }
        if (name == "Self") {
            let owner = mir_unit_function_owner_type(&self.m, function_id);
            if (owner.len > 0) { return owner; }
        }
        let params = mir_unit_function_generic_params(&self.m, function_id);
        let args = mir_unit_function_generic_args(&self.m, function_id);
        var i: i32 = 0;
        while (i < 64) {
            let p = llvm_mir_generic_param_canonical(policy_generic_param_at(params, i));
            if (p.len == 0) { return ""; }
            if (p == name) { return policy_generic_arg_at(args, i); }
            i = i + 1;
        }
        return "";
    }

    public fn normalize_type_text(self, text: string) -> string {
        if (llvm_mir_is_primitive_str_name(text)) { return "str"; }
        if (text.startsWith("*")) {
            return "ptr<" + self.normalize_type_text(text.substring(1, text.len).trim()) + ">";
        }
        if (text.startsWith("&mut ")) {
            return "mutref<" + self.normalize_type_text(text.substring(5, text.len).trim()) + ">";
        }
        if (text.startsWith("&")) {
            return "ref<" + self.normalize_type_text(text.substring(1, text.len).trim()) + ">";
        }
        return text;
    }

    public fn resolve_type_text_in_function(self, function_id: i32, text: string) -> string {
        let normalized = self.normalize_type_text(text);
        if (normalized.len == 0) { return ""; }
        if (policy_generic_call_has_args(normalized) != 0) {
            let base = policy_generic_call_base(normalized.clone());
            let raw_args = policy_generic_call_args(normalized.clone());
            var out_args = "";
            var i: i32 = 0;
            while (i < 64) {
                let raw_arg = policy_generic_arg_at(raw_args, i);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return self.normalize_type_text(base); }
                    return self.normalize_type_text(base) + "::<" + out_args + ">";
                }
                out_args = self.append_csv(out_args, self.resolve_type_text_in_function(function_id, raw_arg));
                i = i + 1;
            }
            return self.normalize_type_text(base) + "::<" + out_args + ">";
        }
        let bound = self.function_generic_binding(function_id, normalized);
        if (bound.len > 0 && bound != normalized) {
            return self.resolve_type_text_in_function(function_id, bound);
        }
        return normalized;
    }

    public fn resolve_type_text_for_owner(self, text: string, owner_text: string) -> string {
        let normalized = self.normalize_type_text(text);
        if (normalized.len == 0) { return ""; }
        if (policy_generic_call_has_args(normalized.clone()) != 0) {
            let base = policy_generic_call_base(normalized.clone());
            let raw_args = policy_generic_call_args(normalized.clone());
            var out_args = "";
            var idx: i32 = 0;
            while (idx < 64) {
                let raw_arg = policy_generic_arg_at(raw_args, idx);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return self.normalize_type_text(base); }
                    return self.normalize_type_text(base) + "::<" + out_args + ">";
                }
                out_args = self.append_csv(out_args, self.resolve_type_text_for_owner(raw_arg, owner_text));
                idx = idx + 1;
            }
            return self.normalize_type_text(base) + "::<" + out_args + ">";
        }
        let owner_args = policy_generic_call_args(owner_text.clone());
        if (llvm_mir_generic_param_name_is_template(normalized) && owner_args.len > 0) {
            let first_arg = policy_generic_arg_at(owner_args, 0);
            if (first_arg.len > 0) { return first_arg; }
        }
        return normalized;
    }

    public fn type_id_for_resolved_text(self, function_id: i32, text: string) -> i32 {
        let resolved = self.resolve_type_text_in_function(function_id, text);
        let type_id = self.type_id_by_text(resolved);
        if (type_id != mir_id_invalid()) { return type_id; }
        self.report_error("cannot resolve concrete MIR type `" + text + "` in function " + self.m.function_name(function_id));
        return mir_id_invalid();
    }

    public fn value_is_reflection_fields(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_target_ref()) { return false; }
        if (self.m.value_target_kind(value_id) != mir_target_builtin()) { return false; }
        return self.m.value_name(value_id) == "fields";
    }

    public fn value_is_reflection_methods(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_target_ref()) { return false; }
        if (self.m.value_target_kind(value_id) != mir_target_builtin()) { return false; }
        return self.m.value_name(value_id) == "methods";
    }

    public fn value_is_reflection_iterable(self, value_id: i32) -> bool {
        return self.value_is_reflection_fields(value_id) || self.value_is_reflection_methods(value_id);
    }

    public fn reflection_iterable_type_id(self, value_id: i32) -> i32 {
        if (!self.value_is_reflection_iterable(value_id)) { return mir_id_invalid(); }
        let lhs = self.m.value_lhs(value_id);
        if (lhs == mir_id_invalid()) { return mir_id_invalid(); }
        let raw_type = self.m.value_type(lhs);
        if (raw_type == mir_id_invalid()) { return mir_id_invalid(); }
        let text = llvm_mir_type_text(&self.m, raw_type);
        if (text.len == 0) { return raw_type; }
        let resolved = self.type_id_for_resolved_text(self.current_function_id, text);
        if (resolved != mir_id_invalid()) { return resolved; }
        return raw_type;
    }

    public fn reflection_fields_type_id(self, value_id: i32) -> i32 {
        if (!self.value_is_reflection_fields(value_id)) { return mir_id_invalid(); }
        return self.reflection_iterable_type_id(value_id);
    }

    public fn reflection_fields_count(self, value_id: i32) -> i32 {
        let type_id = self.reflection_iterable_type_id(value_id);
        if (type_id == mir_id_invalid()) {
            self.report_error("reflection fields iterator has no reflected type");
            return -1;
        }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return 0; }
        return mir_unit_field_count_for_type(&self.m, type_id);
    }

    public fn reflection_methods_count(self, value_id: i32) -> i32 {
        let type_id = self.reflection_iterable_type_id(value_id);
        if (type_id == mir_id_invalid()) {
            self.report_error("reflection methods iterator has no reflected type");
            return -1;
        }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return 0; }
        var count: i32 = 0;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (mir_unit_function_item_kind(&self.m, fn_id) == hir_item_method()
                && self.function_owner_matches_type(fn_id, type_id)) {
                count = count + 1;
            }
            fn_id = fn_id + 1;
        }
        return count;
    }

    public fn reflection_iterable_count(self, value_id: i32) -> i32 {
        if (self.value_is_reflection_fields(value_id)) { return self.reflection_fields_count(value_id); }
        if (self.value_is_reflection_methods(value_id)) { return self.reflection_methods_count(value_id); }
        return -1;
    }

    public fn trim_type_text(self, text: string) -> string {
        var start: i32 = 0;
        var end: i32 = text.len as i32;
        while (start < end && text.charAt(start) <= 32) { start = start + 1; }
        while (end > start && text.charAt(end - 1) <= 32) { end = end - 1; }
        return text.substring(start, end);
    }

    public fn fn_type_param_start(self, text: string) -> i32 {
        var i: i32 = 0;
        while (i < text.len) {
            if (text.charAt(i) == 40) { return i + 1; }
            i = i + 1;
        }
        return -1;
    }

    public fn fn_type_param_end(self, text: string) -> i32 {
        var i: i32 = 0;
        var depth: i32 = 0;
        while (i < text.len) {
            let ch = text.charAt(i);
            if (ch == 40) { depth = depth + 1; }
            if (ch == 41) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    public fn fn_type_signature_text_is_direct(self, text: string) -> bool {
        let clean = self.trim_type_text(text);
        if (clean.len >= 3 && clean.substring(0, 3) == "fn(") { return true; }
        if (clean.len >= 4 && clean.substring(0, 4) == "cfn(") { return true; }
        if (clean.len >= 10 && clean.substring(0, 10) == "unsafe fn(") { return true; }
        return false;
    }

    public fn fn_type_signature_text(self, fn_type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, fn_type_id);
        if (self.fn_type_signature_text_is_direct(text)) { return text; }
        let kind = llvm_mir_type_kind(&self.m, fn_type_id);
        if (kind != ty_FN() && kind != ty_CFN()) { return text; }
        let ret_id = hir_type_table_elem(self.m.types, fn_type_id);
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (id != fn_type_id
                && llvm_mir_type_kind(&self.m, id) == kind
                && hir_type_table_elem(self.m.types, id) == ret_id
                && self.fn_type_signature_text_is_direct(llvm_mir_type_text(&self.m, id))) {
                return llvm_mir_type_text(&self.m, id);
            }
            id = id + 1;
        }
        return text;
    }

    public fn fn_type_param_count(self, fn_type_id: i32) -> i32 {
        let text = self.fn_type_signature_text(fn_type_id);
        let start = self.fn_type_param_start(text);
        let end = self.fn_type_param_end(text);
        if (start < 0 || end < start) { return 0; }
        if (self.trim_type_text(text.substring(start, end)).len == 0) { return 0; }
        var count: i32 = 1;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var i = start;
        while (i < end) {
            let ch = text.charAt(i);
            if (ch == 60) { angle_depth = angle_depth + 1; }
            else if (ch == 62 && angle_depth > 0) { angle_depth = angle_depth - 1; }
            else if (ch == 40) { paren_depth = paren_depth + 1; }
            else if (ch == 41 && paren_depth > 0) { paren_depth = paren_depth - 1; }
            else if (ch == 44 && angle_depth == 0 && paren_depth == 0) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    public fn fn_type_param_text_at(self, fn_type_id: i32, wanted: i32) -> string {
        let text = self.fn_type_signature_text(fn_type_id);
        let start = self.fn_type_param_start(text);
        let end = self.fn_type_param_end(text);
        if (start < 0 || end < start) { return ""; }
        var idx: i32 = 0;
        var part_start = start;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var i = start;
        while (i <= end) {
            var split = false;
            if (i == end) {
                split = true;
            } else {
                let ch = text.charAt(i);
                if (ch == 60) { angle_depth = angle_depth + 1; }
                else if (ch == 62 && angle_depth > 0) { angle_depth = angle_depth - 1; }
                else if (ch == 40) { paren_depth = paren_depth + 1; }
                else if (ch == 41 && paren_depth > 0) { paren_depth = paren_depth - 1; }
                else if (ch == 44 && angle_depth == 0 && paren_depth == 0) { split = true; }
            }
            if (split) {
                if (idx == wanted) { return self.trim_type_text(text.substring(part_start, i)); }
                idx = idx + 1;
                part_start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    public fn fn_type_param_type_at(self, fn_type_id: i32, wanted: i32) -> i32 {
        var text = self.fn_type_param_text_at(fn_type_id, wanted);
        if (text.len == 0) { return mir_id_invalid(); }
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var colon_pos: i32 = -1;
        var i: i32 = 0;
        while (i < text.len) {
            let ch = text.charAt(i);
            if (ch == 60) { angle_depth = angle_depth + 1; }
            else if (ch == 62 && angle_depth > 0) { angle_depth = angle_depth - 1; }
            else if (ch == 40) { paren_depth = paren_depth + 1; }
            else if (ch == 41 && paren_depth > 0) { paren_depth = paren_depth - 1; }
            else if (ch == 58 && angle_depth == 0 && paren_depth == 0) {
                let next_is_colon = i + 1 < text.len && text.charAt(i + 1) == 58;
                let prev_is_colon = i > 0 && text.charAt(i - 1) == 58;
                if (!next_is_colon && !prev_is_colon) { colon_pos = i; }
            }
            i = i + 1;
        }
        if (colon_pos >= 0 && colon_pos + 1 < text.len) {
            text = self.trim_type_text(text.substring(colon_pos + 1, text.len));
        }
        return self.type_id_for_resolved_text(self.current_function_id, text);
    }

    public fn fn_type_return_text(self, fn_type_id: i32) -> string {
        let text = self.fn_type_signature_text(fn_type_id);
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var i: i32 = 0;
        while (i + 1 < text.len) {
            let ch = text.charAt(i);
            if (ch == 60) { angle_depth = angle_depth + 1; }
            else if (ch == 62 && angle_depth > 0) { angle_depth = angle_depth - 1; }
            else if (ch == 40) { paren_depth = paren_depth + 1; }
            else if (ch == 41 && paren_depth > 0) { paren_depth = paren_depth - 1; }
            else if (ch == 45 && text.charAt(i + 1) == 62
                     && angle_depth == 0 && paren_depth == 0) {
                return self.trim_type_text(text.substring(i + 2, text.len));
            }
            i = i + 1;
        }
        return "";
    }

    public fn fn_type_return_type(self, fn_type_id: i32) -> i32 {
        if (fn_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let recorded = hir_type_table_elem(self.m.types, fn_type_id);
        if (recorded != mir_id_invalid()) { return recorded; }
        let text = self.fn_type_return_text(fn_type_id);
        if (text.len == 0) { return mir_id_invalid(); }
        return self.type_id_for_resolved_text(self.current_function_id, text);
    }

    public fn build_fn_value_call_type(self, fn_type_id: i32, include_env: bool) -> rawptr {
        let source_count = self.fn_type_param_count(fn_type_id);
        var total = source_count;
        if (include_env) { total = total + 1; }
        var params: rawptr = null;
        if (total > 0) {
            params = malloc((total * 8) as u64);
            if (params == null) {
                self.report_error("cannot allocate function-value signature");
                return null;
            }
        }
        var out_idx: i32 = 0;
        if (include_env) {
            ast_write_rawptr(params, self.ty_ptr);
            out_idx = 1;
        }
        var i: i32 = 0;
        while (i < source_count) {
            let param_type = self.fn_type_param_type_at(fn_type_id, i);
            if (param_type == mir_id_invalid()) {
                if (params != null) { free(params); }
                self.report_error("cannot resolve function-value parameter type #" + policy_i64_to_string(i as i64));
                return null;
            }
            var param_ll = self.lower_type(param_type);
            if (!include_env && self.type_uses_c_sysv_direct_coerce(param_type)) {
                let coerce_param = self.c_sysv_coerce_llvm_type(param_type);
                if (coerce_param != null) { param_ll = coerce_param; }
            } elif (!include_env && self.type_uses_c_sysv_memory(param_type)) {
                param_ll = self.ty_ptr;
            }
            ast_write_rawptr(ptr_offset(params, out_idx * 8), param_ll);
            out_idx = out_idx + 1;
            i = i + 1;
        }
        let return_type = self.fn_type_return_type(fn_type_id);
        if (return_type == mir_id_invalid()) {
            if (params != null) { free(params); }
            self.report_error("cannot resolve function-value return type for " + llvm_mir_type_text(&self.m, fn_type_id));
            return null;
        }
        var ret_ll = self.lower_type(return_type);
        if (!include_env && self.type_uses_c_sysv_direct_coerce(return_type)) {
            let coerce_ret = self.c_sysv_coerce_llvm_type(return_type);
            if (coerce_ret != null) { ret_ll = coerce_ret; }
        } elif (!include_env && self.type_uses_c_sysv_memory(return_type)) {
            ret_ll = self.ty_void;
        }
        let fty = vyx_rt_fn_type(self.mod,
                                 ret_ll,
                                 params,
                                 total as u64,
                                 0);
        if (params != null) { free(params); }
        return fty;
    }

    public fn splitmix64_value(self, value: rawptr) -> rawptr {
        if (value == null) { return null; }
        let s30 = vyx_rt_build_lshr(self.mod,
                                    value,
                                    vyx_rt_const_int(self.mod, self.ty_i64, 30, 0),
                                    llvm_mir_empty_name(),
                                    0);
        let x30 = vyx_rt_build_xor(self.mod, value, s30, llvm_mir_empty_name(), 0);
        let m1 = vyx_rt_build_mul(self.mod,
                                  x30,
                                  vyx_rt_const_int(self.mod, self.ty_i64, -4658895280553007687, 1),
                                  llvm_mir_empty_name(),
                                  0);
        let s27 = vyx_rt_build_lshr(self.mod,
                                    m1,
                                    vyx_rt_const_int(self.mod, self.ty_i64, 27, 0),
                                    llvm_mir_empty_name(),
                                    0);
        let x27 = vyx_rt_build_xor(self.mod, m1, s27, llvm_mir_empty_name(), 0);
        let m2 = vyx_rt_build_mul(self.mod,
                                  x27,
                                  vyx_rt_const_int(self.mod, self.ty_i64, -7723592293110705685, 1),
                                  llvm_mir_empty_name(),
                                  0);
        let s31 = vyx_rt_build_lshr(self.mod,
                                    m2,
                                    vyx_rt_const_int(self.mod, self.ty_i64, 31, 0),
                                    llvm_mir_empty_name(),
                                    0);
        return vyx_rt_build_xor(self.mod, m2, s31, llvm_mir_empty_name(), 0);
    }

    public fn lower_storage_size_call(self, value_id: i32, builtin_name: string, label: string) -> rawptr {
        let args = policy_generic_call_args(builtin_name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) {
            self.report_error(label + " requires one concrete type argument");
            return null;
        }
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        if (type_id == mir_id_invalid()) { return null; }
        let bytes = self.value_storage_size(type_id);
        if (bytes <= 0) {
            self.report_error("cannot lower " + label + " type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_const_int(self.mod, self.ty_i64, bytes, 0);
    }

    public fn lower_sizeof_call(self, value_id: i32, builtin_name: string) -> rawptr {
        return self.lower_storage_size_call(value_id, builtin_name, "sizeof");
    }

    public fn lower_repr_sizeof_call(self, value_id: i32, builtin_name: string) -> rawptr {
        return self.lower_storage_size_call(value_id, builtin_name, "repr_sizeof");
    }

    public fn builtin_type_arg_id(self, builtin_name: string, label: string) -> i32 {
        let args = policy_generic_call_args(builtin_name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) {
            self.report_error(label + " requires one concrete type argument");
            return mir_id_invalid();
        }
        return self.type_id_for_resolved_text(self.current_function_id, type_text);
    }

    public fn value_storage_align(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical_type);
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
        if (kind == ty_I16() || kind == ty_U16()) { return 2; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
            || kind == ty_F64() || llvm_mir_kind_pointer_like(kind) || self.type_is_str_abi(canonical_type)) {
            return 8;
        }
        if (kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.m.types, canonical_type);
            let elem_align = self.value_storage_align(elem_type);
            if (elem_align > 0) { return elem_align; }
            return 8;
        }
        if (kind == ty_TUPLE()) {
            var out: i64 = 1;
            let count = self.tuple_element_count_for_type(canonical_type);
            var idx: i32 = 0;
            while (idx < count) {
                let elem_align2 = self.value_storage_align(self.tuple_element_type_id(canonical_type, idx));
                if (elem_align2 > out) { out = elem_align2; }
                idx = idx + 1;
            }
            if (out <= 0) { return 8; }
            return out;
        }
        if (kind == ty_CLASS() && self.type_is_value_struct_abi(canonical_type)) {
            let forced = self.type_repr_explicit_align(canonical_type);
            if (self.type_repr_is_packed(canonical_type)) {
                if (forced > 0) { return forced; }
                return 1;
            }
            var rec: i64 = 1;
            let field_n2 = mir_unit_field_count_for_type(&self.m, canonical_type);
            var fj: i32 = 0;
            while (fj < field_n2) {
                let field_id2 = mir_unit_field_id_for_type_index(&self.m, canonical_type, fj);
                if (field_id2 != mir_id_invalid()) {
                    let fa2 = self.value_storage_align(mir_unit_field_type(&self.m, field_id2));
                    if (fa2 > rec) { rec = fa2; }
                }
                fj = fj + 1;
            }
            // A foreign record's alignment is a fact the producer measured, not
            // something derivable from the consumer's field spellings: an
            // `alignas(64)` C++ struct reaches Vyx as a field of `[u64; 8]`,
            // whose widest alignment is 8.  Without this the descriptor's
            // alignment never reaches `alignof::<T>()`, and everything sized or
            // aligned through it (Box<T> and Ref<T> allocate with
            // `sizeof::<T>()` / `alignof::<T>()`) silently under-aligns.
            let contract_align = self.dci_type_value_alignment(canonical_type);
            if (contract_align > rec) { rec = contract_align; }
            if (forced > rec) { rec = forced; }
            if (rec <= 0) { return 1; }
            return rec;
        }
        return 8;
    }

    // ABI alignment as `alignof::<T>()` reports it, and as a value class
    // occupies when it is stored as a field of another record. Value classes
    // keep an 8-byte floor even when their widest field is narrower: the
    // storage walk above stays unfloored because it also drives the field
    // offsets and the tail padding of the LLVM record type, where an 8-byte
    // stride for a 4-byte payload would desynchronise the type from its size.
    // Mirrors `mir_cpp_storage_align_for_type`, which hard-codes 8 for classes.
    public fn value_abi_align(self, type_id: i32) -> i64 {
        let align = self.value_storage_align(type_id);
        if (type_id == mir_id_invalid()) { return align; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return align; }
        // `@[repr(C)]` opts out of the class floor: a C-layout record keeps the
        // alignment its widest field needs, exactly as the producer's
        // `struct`/`#[repr(C)]` does.  Everything else keeps the floor.
        if (self.type_repr_is_c(canonical_type)) { return align; }
        if (align < 8) { return 8; }
        return align;
    }

    public fn lower_alignof_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let args = policy_generic_call_args(builtin_name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        var type_id = mir_id_invalid();
        if (type_text.len > 0) {
            type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        } else if (self.call_arg_count(value_id) == 1) {
            type_id = self.m.value_type(self.call_arg_at(value_id, 0));
        } else {
            self.report_error("alignof requires one concrete type argument");
            return null;
        }
        if (type_id == mir_id_invalid()) { return null; }
        let align = self.value_abi_align(type_id);
        if (align <= 0) {
            self.report_error("cannot lower alignof type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        return vyx_rt_const_int(self.mod, self.ty_i64, align, 0);
    }

    public fn lower_field_count_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let type_id = self.builtin_type_arg_id(builtin_name, "field_count");
        if (type_id == mir_id_invalid()) { return null; }
        var count: i32 = 0;
        let owner_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, owner_type) == ty_CLASS()) {
            count = mir_unit_field_count_for_type(&self.m, owner_type);
        }
        return vyx_rt_const_int(self.mod, self.ty_i32, count as i64, 1);
    }

    public fn lower_reflection_field_index_arg(self, value_id: i32, builtin_name: string) -> i32 {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error(builtin_name + " requires exactly one field index argument");
            return -1;
        }
        let index_id = self.call_arg_at(value_id, 0);
        if (!self.static_assert_i64_known(index_id)) {
            self.report_error(builtin_name + " requires a compile-time field index");
            return -1;
        }
        let index_value = self.static_assert_i64_value(index_id);
        if (index_value < 0 || index_value > 2147483647) {
            self.report_error(builtin_name + " field index is out of range");
            return -1;
        }
        return index_value as i32;
    }

    public fn reflection_field_id_for_call(self, value_id: i32, builtin_name: string) -> i32 {
        let type_id = self.builtin_type_arg_id(builtin_name, policy_generic_call_base(builtin_name.clone()));
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let idx = self.lower_reflection_field_index_arg(value_id, policy_generic_call_base(builtin_name.clone()));
        if (idx < 0) { return mir_id_invalid(); }
        let owner_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, owner_type) != ty_CLASS()) { return mir_id_invalid(); }
        if (idx >= mir_unit_field_count_for_type(&self.m, owner_type)) { return mir_id_invalid(); }
        return mir_unit_field_id_for_type_index(&self.m, owner_type, idx);
    }

    public fn lower_field_name_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let field_id = self.reflection_field_id_for_call(value_id, builtin_name);
        if (field_id == mir_id_invalid()) { return self.emit_str_value(""); }
        return self.emit_str_value(mir_unit_field_name(&self.m, field_id));
    }

    public fn lower_field_type_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let field_id = self.reflection_field_id_for_call(value_id, builtin_name);
        if (field_id == mir_id_invalid()) { return self.emit_str_value(""); }
        return self.emit_str_value(self.reflection_type_text(mir_unit_field_type(&self.m, field_id)));
    }

    public fn reflection_name_for_type_text(self, type_text: string) -> string {
        if (type_text.len == 0) { return ""; }
        let raw_base = policy_generic_call_base(type_text);
        let raw_short = self.last_path_segment(raw_base);
        let map = mir_unit_reflection_name_map(&self.m);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= map.len) {
            if (i == map.len || map.charAt(i) == 10) {
                if (i > start) {
                    let line = map.substring(start, i);
                    var sep: i32 = -1;
                    var j: i32 = 0;
                    while (j < line.len && sep < 0) {
                        if (line.charAt(j) == 126) { sep = j; }
                        j = j + 1;
                    }
                    if (sep > 0 && sep + 1 < line.len) {
                        let raw = line.substring(0, sep);
                        let reflected = line.substring(sep + 1, line.len);
                        let raw_line_base = policy_generic_call_base(raw);
                        let raw_line_short = self.last_path_segment(raw_line_base);
                        if (raw == type_text
                            || raw_line_base == raw_base
                            || raw_line_short == raw_short
                            || policy_type_name_equal(raw, type_text)
                            || policy_type_name_equal(raw_line_base, raw_base)) {
                            return reflected;
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return self.reflection_type_text(self.type_id_for_resolved_text(self.current_function_id, type_text));
    }

    public fn reflection_name_for_type_id(self, type_id: i32) -> string {
        let text = self.reflection_type_text(type_id);
        if (text.len == 0) { return ""; }
        let reflected = self.reflection_name_for_type_text(text);
        if (reflected.len > 0) { return reflected; }
        return text;
    }

    public fn reflection_type_text(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        if (self.type_is_str_abi(type_id)) { return "string"; }
        return llvm_mir_type_text(&self.m, type_id);
    }

    public fn reflection_type_kind_text(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        if (self.type_is_str_abi(type_id)) { return "string"; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_BOOL()) { return "bool"; }
        if (kind == ty_F32() || kind == ty_F64()) { return "float"; }
        if (kind == ty_I8() || kind == ty_I16() || kind == ty_I32() || kind == ty_I64()
            || kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()
            || kind == ty_ISIZE() || kind == ty_USIZE()) {
            return "int";
        }
        if (kind == ty_FN() || kind == ty_CFN()) { return "fn"; }
        if (kind == ty_CLASS()) { return "class"; }
        return "primitive";
    }

    public fn lower_typeof_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("typeof requires exactly one operand");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        if (arg_id == mir_id_invalid()) {
            self.report_error("typeof operand is missing");
            return null;
        }
        let text = self.reflection_type_text(self.m.value_type(arg_id));
        if (text.len == 0) {
            self.report_error("typeof operand has no canonical type");
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_typeinfo_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) == 0) { return self.emit_str_value("void"); }
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("typeinfo requires exactly one operand");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        if (arg_id == mir_id_invalid()) {
            self.report_error("typeinfo operand is missing");
            return null;
        }
        let text = self.reflection_type_text(self.m.value_type(arg_id));
        if (text.len == 0) {
            self.report_error("typeinfo operand has no canonical type");
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_type_name_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let args = policy_generic_call_args(builtin_name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) {
            self.report_error("type_name requires one concrete type argument");
            return null;
        }
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        var text = "";
        if (type_id != mir_id_invalid()) {
            text = self.reflection_type_text(type_id);
        } else {
            text = type_text;
            if (llvm_mir_is_primitive_str_name(text)) { text = "string"; }
        }
        if (text.len == 0) {
            self.report_error("cannot resolve type_name argument " + type_text);
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_reflect_name_call(self, value_id: i32, builtin_name: string) -> rawptr {
        let args = policy_generic_call_args(builtin_name.clone());
        let type_text = policy_generic_arg_at(args, 0);
        if (type_text.len == 0) {
            self.report_error("reflect_name requires one concrete type argument");
            return null;
        }
        let type_id = self.type_id_for_resolved_text(self.current_function_id, type_text);
        var text = "";
        if (type_id != mir_id_invalid()) {
            text = self.reflection_name_for_type_id(type_id);
        }
        if (text.len == 0) { text = self.reflection_name_for_type_text(type_text); }
        if (text.len == 0) {
            self.report_error("cannot resolve reflect_name argument " + type_text);
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_reflect_manifest_call(self, value_id: i32) -> rawptr {
        return self.emit_str_value(mir_unit_reflection_manifest(&self.m));
    }

    public fn lower_reflection_name_value(self, value_id: i32) -> rawptr {
        let reflected_value_id = self.m.value_lhs(value_id);
        if (reflected_value_id == mir_id_invalid()) {
            self.report_error("T::name MIR value has no reflected operand");
            return null;
        }
        let reflected_type_id = self.m.value_type(reflected_value_id);
        let text = self.reflection_name_for_type_id(reflected_type_id);
        if (text.len == 0) {
            self.report_error("T::name reflected operand has no canonical type");
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_reflection_kind_value(self, value_id: i32) -> rawptr {
        let reflected_value_id = self.m.value_lhs(value_id);
        if (reflected_value_id == mir_id_invalid()) {
            self.report_error("T::kind MIR value has no reflected operand");
            return null;
        }
        let reflected_type_id = self.m.value_type(reflected_value_id);
        let text = self.reflection_type_kind_text(reflected_type_id);
        if (text.len == 0) {
            self.report_error("T::kind reflected operand has no canonical type");
            return null;
        }
        return self.emit_str_value(text);
    }

    public fn lower_hash_bytes_key_value(self, data: rawptr, len_v: rawptr, label: string) -> rawptr {
        if (data == null || len_v == null) { return null; }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable for string hash");
            return null;
        }
        let h_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".h").c_str(), (label + ".h").len as u64);
        let i_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".i").c_str(), (label + ".i").len as u64);
        let chunk_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".chunk").c_str(), (label + ".chunk").len as u64);
        let tail_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".tail").c_str(), (label + ".tail").len as u64);
        let shift_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".shift").c_str(), (label + ".shift").len as u64);
        let byte_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, (label + ".byte").c_str(), (label + ".byte").len as u64);
        if (h_slot == null || i_slot == null || chunk_slot == null || tail_slot == null || shift_slot == null || byte_slot == null) {
            self.report_error("cannot allocate string hash slots");
            return null;
        }

        let seeded = vyx_rt_build_xor(self.mod,
                                      len_v,
                                      vyx_rt_const_int(self.mod, self.ty_i64, -7046029254386353131, 1),
                                      llvm_mir_empty_name(),
                                      0);
        vyx_rt_build_store(self.mod, self.splitmix64_value(seeded), h_slot);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i64, 0, 0), i_slot);

        let chunk_cond_name = label + ".chunk.cond";
        let chunk_body_name = label + ".chunk.body";
        let tail_init_name = label + ".tail.init";
        let tail_cond_name = label + ".tail.cond";
        let tail_body_name = label + ".tail.body";
        let finish_cond_name = label + ".finish.cond";
        let finish_mix_name = label + ".finish.mix";
        let done_name = label + ".done";
        let chunk_cond = vyx_rt_append_block(self.mod, self.current_function_value, chunk_cond_name.c_str(), chunk_cond_name.len as u64);
        let chunk_body = vyx_rt_append_block(self.mod, self.current_function_value, chunk_body_name.c_str(), chunk_body_name.len as u64);
        let tail_init = vyx_rt_append_block(self.mod, self.current_function_value, tail_init_name.c_str(), tail_init_name.len as u64);
        let tail_cond = vyx_rt_append_block(self.mod, self.current_function_value, tail_cond_name.c_str(), tail_cond_name.len as u64);
        let tail_body = vyx_rt_append_block(self.mod, self.current_function_value, tail_body_name.c_str(), tail_body_name.len as u64);
        let finish_cond = vyx_rt_append_block(self.mod, self.current_function_value, finish_cond_name.c_str(), finish_cond_name.len as u64);
        let finish_mix = vyx_rt_append_block(self.mod, self.current_function_value, finish_mix_name.c_str(), finish_mix_name.len as u64);
        let done = vyx_rt_append_block(self.mod, self.current_function_value, done_name.c_str(), done_name.len as u64);
        if (chunk_cond == null || chunk_body == null || tail_init == null || tail_cond == null
            || tail_body == null || finish_cond == null || finish_mix == null || done == null) {
            self.report_error("cannot create string hash control flow");
            return null;
        }

        vyx_rt_build_br(self.mod, chunk_cond);

        vyx_rt_position_at_end(self.mod, chunk_cond);
        let i0 = vyx_rt_build_load(self.mod, self.ty_i64, i_slot, llvm_mir_empty_name(), 0);
        let i_plus_8 = vyx_rt_build_add(self.mod, i0, vyx_rt_const_int(self.mod, self.ty_i64, 8, 0), llvm_mir_empty_name(), 0);
        let has_chunk = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_sle(), i_plus_8, len_v, llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, has_chunk, chunk_body, tail_init);

        vyx_rt_position_at_end(self.mod, chunk_body);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i64, 0, 0), chunk_slot);
        let chunk_src = self.ptr_offset_bytes(data, i0, label + ".chunk.src");
        vyx_rt_build_call3(self.mod,
                           self.builtin_memcpy_fty,
                           self.builtin_memcpy_fn,
                           chunk_slot,
                           chunk_src,
                           vyx_rt_const_int(self.mod, self.ty_i64, 8, 0),
                           llvm_mir_empty_name(),
                           0);
        let chunk = vyx_rt_build_load(self.mod, self.ty_i64, chunk_slot, llvm_mir_empty_name(), 0);
        let h_before = vyx_rt_build_load(self.mod, self.ty_i64, h_slot, llvm_mir_empty_name(), 0);
        let h_xor_chunk = vyx_rt_build_xor(self.mod, h_before, chunk, llvm_mir_empty_name(), 0);
        vyx_rt_build_store(self.mod, self.splitmix64_value(h_xor_chunk), h_slot);
        vyx_rt_build_store(self.mod, i_plus_8, i_slot);
        vyx_rt_build_br(self.mod, chunk_cond);

        vyx_rt_position_at_end(self.mod, tail_init);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i64, 0, 0), tail_slot);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i64, 0, 0), shift_slot);
        vyx_rt_build_br(self.mod, tail_cond);

        vyx_rt_position_at_end(self.mod, tail_cond);
        let i_tail = vyx_rt_build_load(self.mod, self.ty_i64, i_slot, llvm_mir_empty_name(), 0);
        let has_tail = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), i_tail, len_v, llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, has_tail, tail_body, finish_cond);

        vyx_rt_position_at_end(self.mod, tail_body);
        vyx_rt_build_store(self.mod, vyx_rt_const_int(self.mod, self.ty_i64, 0, 0), byte_slot);
        let byte_src = self.ptr_offset_bytes(data, i_tail, label + ".byte.src");
        vyx_rt_build_call3(self.mod,
                           self.builtin_memcpy_fty,
                           self.builtin_memcpy_fn,
                           byte_slot,
                           byte_src,
                           vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                           llvm_mir_empty_name(),
                           0);
        let byte_word = vyx_rt_build_load(self.mod, self.ty_i64, byte_slot, llvm_mir_empty_name(), 0);
        let masked = vyx_rt_build_and(self.mod,
                                      byte_word,
                                      vyx_rt_const_int(self.mod, self.ty_i64, 255, 0),
                                      llvm_mir_empty_name(),
                                      0);
        let shift = vyx_rt_build_load(self.mod, self.ty_i64, shift_slot, llvm_mir_empty_name(), 0);
        let shifted = vyx_rt_build_shl(self.mod, masked, shift, llvm_mir_empty_name(), 0);
        let tail_before = vyx_rt_build_load(self.mod, self.ty_i64, tail_slot, llvm_mir_empty_name(), 0);
        vyx_rt_build_store(self.mod, vyx_rt_build_or(self.mod, tail_before, shifted, llvm_mir_empty_name(), 0), tail_slot);
        vyx_rt_build_store(self.mod,
                           vyx_rt_build_add(self.mod, shift, vyx_rt_const_int(self.mod, self.ty_i64, 8, 0), llvm_mir_empty_name(), 0),
                           shift_slot);
        vyx_rt_build_store(self.mod,
                           vyx_rt_build_add(self.mod, i_tail, vyx_rt_const_int(self.mod, self.ty_i64, 1, 0), llvm_mir_empty_name(), 0),
                           i_slot);
        vyx_rt_build_br(self.mod, tail_cond);

        vyx_rt_position_at_end(self.mod, finish_cond);
        let final_shift = vyx_rt_build_load(self.mod, self.ty_i64, shift_slot, llvm_mir_empty_name(), 0);
        let has_final_tail = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_sgt(),
                                               final_shift,
                                               vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                               llvm_mir_empty_name(),
                                               0);
        vyx_rt_build_cond_br(self.mod, has_final_tail, finish_mix, done);

        vyx_rt_position_at_end(self.mod, finish_mix);
        let h_final_before = vyx_rt_build_load(self.mod, self.ty_i64, h_slot, llvm_mir_empty_name(), 0);
        let tail_final = vyx_rt_build_load(self.mod, self.ty_i64, tail_slot, llvm_mir_empty_name(), 0);
        vyx_rt_build_store(self.mod, self.splitmix64_value(vyx_rt_build_xor(self.mod, h_final_before, tail_final, llvm_mir_empty_name(), 0)), h_slot);
        vyx_rt_build_br(self.mod, done);

        vyx_rt_position_at_end(self.mod, done);
        return vyx_rt_build_load(self.mod, self.ty_i64, h_slot, (label + ".value").c_str(), (label + ".value").len as u64);
    }

    public fn lower_hash_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("hash requires a receiver");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        if (self.type_is_string_view_type(receiver_type)) {
            let s = self.lower_string_view_value(receiver_id);
            if (s == null) {
                self.report_error("cannot lower string hash receiver");
                return null;
            }
            return self.lower_hash_bytes_key_value(self.string_ptr_value(s),
                                                   self.string_len_value(s),
                                                   "mir.hash.str." + policy_i64_to_string(value_id as i64));
        }
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0) {
            return self.splitmix64_value(self.int_value_to_bits(self.lower_value(receiver_id), receiver_type, 64));
        }
        if (llvm_mir_kind_pointer_like(receiver_kind)) {
            var hash_pointer = self.lower_value(receiver_id);
            if (llvm_mir_kind_pointer_handle(receiver_kind)) {
                hash_pointer = self.pointer_handle_address(hash_pointer, "mir.hash.ptr");
            }
            let ptr_int = vyx_rt_build_ptr_to_int(self.mod,
                                                  hash_pointer,
                                                  self.ty_i64,
                                                  llvm_mir_empty_name(),
                                                  0);
            return self.splitmix64_value(ptr_int);
        }
        self.report_error("cannot lower hash receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_operator_eq_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        var other_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) { other_id = self.call_arg_at(value_id, 1); }
        if (receiver_id == mir_id_invalid() || other_id == mir_id_invalid()) {
            self.report_error("operator== requires receiver and one argument");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let other_type = self.m.value_type(other_id);
        if (self.type_is_string_view_type(receiver_type) || self.type_is_string_view_type(other_type)) {
            return self.lower_string_equals_parts(receiver_id, other_id, false);
        }
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0 || llvm_mir_kind_pointer_like(receiver_kind)) {
            var lhs = self.lower_value(receiver_id);
            var rhs = self.lower_value_as(other_id, receiver_type);
            if (lhs == null || rhs == null) {
                self.report_error("cannot lower operator_eq operands");
                return null;
            }
            if (llvm_mir_kind_pointer_handle(receiver_kind)) {
                lhs = self.pointer_handle_address(lhs, "mir.operator_eq.lhs");
                rhs = self.pointer_handle_address(rhs, "mir.operator_eq.rhs");
                if (lhs == null || rhs == null) { return null; }
            }
            return self.bool_value_i8(vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), lhs, rhs, llvm_mir_empty_name(), 0));
        }
        self.report_error("cannot lower operator_eq receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_integral_compare_values(self,
                                            lhs_id: i32,
                                            rhs_id: i32,
                                            receiver_type: i32) -> rawptr {
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let lhs = self.lower_value_as(lhs_id, receiver_type);
        let rhs = self.lower_value_as(rhs_id, receiver_type);
        if (lhs == null || rhs == null) {
            self.report_error("cannot lower compare operands");
            return null;
        }
        var lt_pred = llvm_mir_icmp_slt();
        var gt_pred = llvm_mir_icmp_sgt();
        if (llvm_mir_kind_unsigned(receiver_kind)) {
            lt_pred = llvm_mir_icmp_ult();
            gt_pred = llvm_mir_icmp_ugt();
        }
        let lt = vyx_rt_build_icmp(self.mod, lt_pred, lhs, rhs, llvm_mir_empty_name(), 0);
        let gt = vyx_rt_build_icmp(self.mod, gt_pred, lhs, rhs, llvm_mir_empty_name(), 0);
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let lt_value = vyx_rt_build_select(self.mod, lt, neg_one, zero, llvm_mir_empty_name(), 0);
        return vyx_rt_build_select(self.mod, gt, one, lt_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_float_compare_values(self,
                                         lhs_id: i32,
                                         rhs_id: i32,
                                         receiver_type: i32) -> rawptr {
        let lhs = self.lower_value_as(lhs_id, receiver_type);
        let rhs = self.lower_value_as(rhs_id, receiver_type);
        if (lhs == null || rhs == null) {
            self.report_error("cannot lower floating compare operands");
            return null;
        }
        let zero_i1 = vyx_rt_const_int(self.mod, self.ty_i1, 0, 0);
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let self_nan = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_une(), lhs, lhs, llvm_mir_empty_name(), 0);
        let other_nan = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_une(), rhs, rhs, llvm_mir_empty_name(), 0);
        let self_not_nan = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), self_nan, zero_i1, llvm_mir_empty_name(), 0);
        let other_not_nan = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), other_nan, zero_i1, llvm_mir_empty_name(), 0);
        let both_nan = vyx_rt_build_and(self.mod, self_nan, other_nan, llvm_mir_empty_name(), 0);
        let self_nan_only = vyx_rt_build_and(self.mod, self_nan, other_not_nan, llvm_mir_empty_name(), 0);
        let other_nan_only = vyx_rt_build_and(self.mod, self_not_nan, other_nan, llvm_mir_empty_name(), 0);
        let lt = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_olt(), lhs, rhs, llvm_mir_empty_name(), 0);
        let gt = vyx_rt_build_fcmp(self.mod, llvm_mir_fcmp_ogt(), lhs, rhs, llvm_mir_empty_name(), 0);
        let lt_value = vyx_rt_build_select(self.mod, lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let gt_value = vyx_rt_build_select(self.mod, gt, one, lt_value, llvm_mir_empty_name(), 0);
        let other_nan_value = vyx_rt_build_select(self.mod,
                                                  other_nan_only,
                                                  neg_one,
                                                  gt_value,
                                                  llvm_mir_empty_name(),
                                                  0);
        let self_nan_value = vyx_rt_build_select(self.mod,
                                                 self_nan_only,
                                                 one,
                                                 other_nan_value,
                                                 llvm_mir_empty_name(),
                                                 0);
        return vyx_rt_build_select(self.mod, both_nan, zero, self_nan_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_string_compare_parts(self, lhs_id: i32, rhs_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_cstr_from_value(lhs_id);
        let rhs_ptr = self.string_cstr_from_value(rhs_id);
        let lhs_len = self.string_len_from_value(lhs_id);
        let rhs_len = self.string_len_from_value(rhs_id);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower string compare operands");
            return null;
        }
        let lhs_shorter = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_slt(),
                                            lhs_len,
                                            rhs_len,
                                            llvm_mir_empty_name(),
                                            0);
        let shared_len = vyx_rt_build_select(self.mod,
                                             lhs_shorter,
                                             lhs_len,
                                             rhs_len,
                                             llvm_mir_empty_name(),
                                             0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            lhs_ptr,
                                            rhs_ptr,
                                            shared_len,
                                            "mir.str.compare".c_str(),
                                            15);
        if (native_cmp == null) {
            self.report_error("cannot emit strncmp for string compare");
            return null;
        }
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i32, 1, 0);
        let neg_one = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let cmp_lt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let cmp_gt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_sgt(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let bytes_lt_value = vyx_rt_build_select(self.mod, cmp_lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let bytes_value = vyx_rt_build_select(self.mod, cmp_gt, one, bytes_lt_value, llvm_mir_empty_name(), 0);
        let bytes_equal = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_eq(), native_cmp, zero, llvm_mir_empty_name(), 0);
        let len_lt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_slt(), lhs_len, rhs_len, llvm_mir_empty_name(), 0);
        let len_gt = vyx_rt_build_icmp(self.mod, llvm_mir_icmp_sgt(), lhs_len, rhs_len, llvm_mir_empty_name(), 0);
        let len_lt_value = vyx_rt_build_select(self.mod, len_lt, neg_one, zero, llvm_mir_empty_name(), 0);
        let len_value = vyx_rt_build_select(self.mod, len_gt, one, len_lt_value, llvm_mir_empty_name(), 0);
        return vyx_rt_build_select(self.mod, bytes_equal, len_value, bytes_value, llvm_mir_empty_name(), 0);
    }

    public fn lower_compare_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        var other_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) { other_id = self.call_arg_at(value_id, 1); }
        if (receiver_id == mir_id_invalid() || other_id == mir_id_invalid()) {
            self.report_error("compare requires receiver and one argument");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let other_type = self.m.value_type(other_id);
        if (self.type_is_string_view_type(receiver_type) || self.type_is_string_view_type(other_type)) {
            return self.lower_string_compare_parts(receiver_id, other_id);
        }
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0) {
            return self.lower_integral_compare_values(receiver_id, other_id, receiver_type);
        }
        if (receiver_kind == ty_F32() || receiver_kind == ty_F64()) {
            return self.lower_float_compare_values(receiver_id, other_id, receiver_type);
        }
        self.report_error("cannot lower compare receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_panic_call(self, value_id: i32) -> rawptr {
        var printed = false;
        var cur = self.m.value_first_arg(value_id);
        while (cur != mir_id_invalid()) {
            if (!self.emit_print_value_mode(cur, true)) { return null; }
            printed = true;
            cur = self.m.value_next_arg(cur);
        }
        if (!printed) {
            if (self.emit_printf_cstr_line(self.emit_str_ptr("panic")) == null) { return null; }
        }
        if (self.builtin_exit_fn == null || self.builtin_exit_fty == null) {
            self.report_error("exit declaration is unavailable for panic lowering");
            return null;
        }
        vyx_rt_build_call1(self.mod,
                           self.builtin_exit_fty,
                           self.builtin_exit_fn,
                           vyx_rt_const_int(self.mod, self.ty_i32, 1, 1),
                           llvm_mir_empty_name(),
                           0);
        let ret_type = self.m.value_type(value_id);
        if (llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) { return null; }
        return vyx_rt_const_null(self.mod, self.lower_type(ret_type));
    }

    public fn result_arg_type(self, type_id: i32, idx: i32) -> i32 {
        if (!self.type_is_result_abi(type_id)) { return mir_id_invalid(); }
        let args = policy_generic_call_args(llvm_mir_type_text(&self.m, type_id));
        let arg_text = policy_generic_arg_at(args, idx);
        let arg_type = self.type_id_by_text(arg_text);
        if (arg_type == mir_id_invalid()) {
            self.report_error("cannot resolve Result type argument " + arg_text);
        }
        return arg_type;
    }

    public fn result_ok_type(self, type_id: i32) -> i32 {
        return self.result_arg_type(type_id, 0);
    }

    public fn result_err_type(self, type_id: i32) -> i32 {
        return self.result_arg_type(type_id, 1);
    }

    public fn option_payload_type(self, type_id: i32) -> i32 {
        if (!self.type_is_option_abi(type_id)) { return mir_id_invalid(); }
        let canonical = self.canonical_record_type_id(type_id);
        let elem = hir_type_table_elem(self.m.types, canonical);
        if (elem > 0) { return elem; }
        let args = policy_generic_call_args(llvm_mir_type_text(&self.m, type_id));
        let arg_text = policy_generic_arg_at(args, 0);
        let arg_type = self.type_id_by_text(arg_text);
        if (arg_type == mir_id_invalid()) {
            self.report_error("cannot resolve Option payload type " + arg_text);
        }
        return arg_type;
    }

    public fn get_or_create_option_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let payload_type = self.option_payload_type(type_id);
        if (payload_type == mir_id_invalid()) { return null; }
        let name = "mir.option." + policy_i64_to_string(type_id as i64);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create Option ABI type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        let payload_ll = self.lower_type(payload_type);
        if (payload_ll == null || llvm_mir_type_kind(&self.m, payload_type) == ty_VOID()) {
            self.report_error("cannot create Option ABI payload for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate Option ABI field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_i32);
        ast_write_rawptr(ptr_offset(fields, 8), payload_ll);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize Option ABI type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn option_field_ptr(self, storage: rawptr, option_type: i32, idx: i32, name: string) -> rawptr {
        let option_ty = self.get_or_create_option_ty(option_type);
        if (storage == null || option_ty == null) { return null; }
        if (idx < 0 || idx >= 2) {
            self.report_error("Option field index out of range for "
                      + llvm_mir_type_text(&self.m, option_type)
                      + ": "
                      + policy_i64_to_string(idx as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 option_ty,
                                 storage,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn build_option_value_from_parts(self,
                                            option_type: i32,
                                            tag_value: rawptr,
                                            payload_value: rawptr) -> rawptr {
        let option_ty = self.get_or_create_option_ty(option_type);
        let payload_type = self.option_payload_type(option_type);
        if (option_ty == null || payload_type == mir_id_invalid()) { return null; }
        var payload_v = payload_value;
        if (payload_v == null) { payload_v = vyx_rt_const_null(self.mod, self.lower_type(payload_type)); }
        let tmp = vyx_rt_build_alloca(self.mod, option_ty, "mir.option.tmp".c_str(), 14);
        if (tmp == null) {
            self.report_error("cannot allocate Option ABI temporary");
            return null;
        }
        let tag_ptr = self.option_field_ptr(tmp, option_type, 0, "option.tag");
        let payload_ptr = self.option_field_ptr(tmp, option_type, 1, "option.value");
        if (tag_ptr == null || payload_ptr == null || tag_value == null || payload_v == null) {
            self.report_error("cannot address Option ABI fields");
            return null;
        }
        vyx_rt_build_store(self.mod, tag_value, tag_ptr);
        vyx_rt_build_store(self.mod, payload_v, payload_ptr);
        return vyx_rt_build_load(self.mod, option_ty, tmp, "mir.option.val".c_str(), 14);
    }

    public fn option_tag_for_variant(self, variant_id: i32, variant_name: string) -> rawptr {
        let tag = mir_unit_variant_tag(&self.m, variant_id);
        if (tag < 0) {
            self.report_error("cannot resolve Option variant tag for " + variant_name);
            return null;
        }
        return vyx_rt_const_int(self.mod, self.ty_i32, tag as i64, 0);
    }

    public fn lower_option_variant_ref(self, value_id: i32) -> rawptr {
        let option_type = self.m.value_type(value_id);
        let variant_id = self.m.value_target_id(value_id);
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        if (!self.type_is_option_abi(option_type)) {
            self.report_error("Option variant reference requires Option type");
            return null;
        }
        if (variant_name != "None") {
            self.report_error("Option variant " + variant_name + " requires constructor call");
            return null;
        }
        return self.build_option_value_from_parts(option_type,
                                                  self.option_tag_for_variant(variant_id, variant_name),
                                                  null);
    }

    public fn lower_option_variant_call(self, value_id: i32) -> rawptr {
        let option_type = self.m.value_type(value_id);
        if (!self.type_is_option_abi(option_type)) {
            self.report_error("Option variant call requires Option return type");
            return null;
        }
        var variant_id = self.m.value_target_id(value_id);
        if (self.m.value_target_kind(value_id) != mir_target_hir_variant()) {
            let callee_id = self.m.value_lhs(value_id);
            if (callee_id != mir_id_invalid()
                && self.m.value_target_kind(callee_id) == mir_target_hir_variant()) {
                variant_id = self.m.value_target_id(callee_id);
            }
        }
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve Option constructor variant");
            return null;
        }
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        let argc = self.call_arg_count(value_id);
        let tag_v = self.option_tag_for_variant(variant_id, variant_name);
        if (variant_name == "None") {
            if (argc != 0) {
                self.report_error("Option.None constructor received arguments");
                return null;
            }
            return self.build_option_value_from_parts(option_type, tag_v, null);
        }
        if (variant_name == "Some") {
            if (argc != 1) {
                self.report_error("Option.Some constructor argument count mismatch");
                return null;
            }
            let payload_type = self.option_payload_type(option_type);
            if (payload_type == mir_id_invalid()) { return null; }
            let payload = self.lower_value_as(self.call_arg_at(value_id, 0), payload_type);
            if (payload == null) {
                self.report_error("cannot lower Option.Some payload");
                return null;
            }
            return self.build_option_value_from_parts(option_type, tag_v, payload);
        }
        self.report_error("unknown Option variant " + variant_name);
        return null;
    }

    public fn option_field_value(self, value: rawptr, option_type: i32, idx: i32, field_type: rawptr, name: string) -> rawptr {
        let option_ty = self.get_or_create_option_ty(option_type);
        if (value == null || option_ty == null || field_type == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, option_ty, "mir.option.extract".c_str(), 18);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, value, tmp);
        let ptr = self.option_field_ptr(tmp, option_type, idx, name);
        if (ptr == null) { return null; }
        return vyx_rt_build_load(self.mod, field_type, ptr, name.c_str(), name.len as u64);
    }

    public fn option_tag_value(self, value: rawptr, option_type: i32) -> rawptr {
        return self.option_field_value(value, option_type, 0, self.ty_i32, "option.tag");
    }

    public fn option_payload_value(self, value: rawptr, option_type: i32) -> rawptr {
        let payload_type = self.option_payload_type(option_type);
        if (payload_type == mir_id_invalid()) { return null; }
        return self.option_field_value(value,
                                       option_type,
                                       1,
                                       self.lower_type(payload_type),
                                       "option.payload");
    }

    public fn type_is_plain_enum_abi(self, type_id: i32) -> bool {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (self.type_is_option_abi(canonical_type) || self.type_is_result_abi(canonical_type)) { return false; }
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        return mir_unit_variant_count_for_type(&self.m, canonical_type) > 0
            && mir_unit_field_count_for_type(&self.m, canonical_type) == 0;
    }

    public fn pattern_variant_id(self, pattern_id: i32) -> i32 {
        var variant_id = self.m.value_target_id(pattern_id);
        if (self.m.value_target_kind(pattern_id) != mir_target_hir_variant()) {
            let callee_id = self.m.value_lhs(pattern_id);
            if (callee_id != mir_id_invalid()
                && self.m.value_target_kind(callee_id) == mir_target_hir_variant()) {
                variant_id = self.m.value_target_id(callee_id);
            }
        }
        return variant_id;
    }

    // Duplicate enum registrations (module-qualified vs plain text) own
    // parallel variant lists. Normalize any variant id onto the same-name
    // variant owned by the canonical (representative) enum entry so id
    // comparisons hold across the duplicates.
    public fn canonical_variant_id(self, variant_id: i32) -> i32 {
        if (variant_id == mir_id_invalid()) { return variant_id; }
        let owner = mir_unit_variant_owner_type(&self.m, variant_id);
        if (owner == mir_id_invalid()) { return variant_id; }
        let canonical_owner = self.canonical_record_type_id(owner);
        let tag = mir_unit_variant_tag(&self.m, variant_id);
        if (tag >= 0) {
            let primary = mir_unit_variant_id_for_type_tag(&self.m, canonical_owner, tag);
            if (primary != mir_id_invalid()) { return primary; }
        }
        if (canonical_owner == owner) { return variant_id; }
        let wanted_name = mir_unit_variant_name(&self.m, variant_id);
        var cur: i32 = 1;
        while (cur <= self.m.variant_count) {
            if (mir_unit_variant_owner_type(&self.m, cur) == canonical_owner
                && mir_unit_variant_name(&self.m, cur) == wanted_name) {
                return cur;
            }
            cur = cur + 1;
        }
        return variant_id;
    }

    public fn value_is_variant_constructor_for_type(self, value_id: i32, enum_type: i32, variant_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_call()) { return false; }
        if (self.canonical_record_type_id(self.m.value_type(value_id)) != self.canonical_record_type_id(enum_type)) { return false; }
        return self.canonical_variant_id(self.pattern_variant_id(value_id)) == self.canonical_variant_id(variant_id);
    }

    public fn value_is_fail_variant_for_type(self, value_id: i32, enum_type: i32, variant_id: i32) -> bool {
        if (value_id == mir_id_invalid() || variant_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_unary()) { return false; }
        let result_type = self.m.value_type(value_id);
        if (!self.type_is_result_abi(result_type)) { return false; }
        let err_type = self.result_err_type(result_type);
        if (self.canonical_record_type_id(err_type) != self.canonical_record_type_id(enum_type)) { return false; }
        return self.m.value_text(value_id) == mir_unit_variant_name(&self.m, variant_id);
    }

    public fn enum_variant_payload_count(self, enum_type: i32, variant_id: i32) -> i32 {
        let canonical_type = self.canonical_record_type_id(enum_type);
        var out: i32 = mir_unit_variant_payload_count(&self.m, self.canonical_variant_id(variant_id));
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.value_is_variant_constructor_for_type(value_id, canonical_type, variant_id)) {
                let argc = self.call_arg_count(value_id);
                if (argc > out) { out = argc; }
            } else if (self.value_is_fail_variant_for_type(value_id, canonical_type, variant_id)
                       && self.m.value_lhs(value_id) != mir_id_invalid()) {
                if (out < 1) { out = 1; }
            }
            value_id = value_id + 1;
        }
        return out;
    }

    public fn enum_declared_payload_type_at(self, enum_type: i32, variant_id: i32, arg_index: i32) -> i32 {
        if (arg_index < 0) { return mir_id_invalid(); }
        let canonical_variant = self.canonical_variant_id(variant_id);
        let payloads = mir_unit_variant_payload_types(&self.m, canonical_variant);
        if (payloads.len == 0) { return mir_id_invalid(); }
        let payload_text = policy_generic_arg_at(payloads, arg_index);
        if (payload_text.len == 0) { return mir_id_invalid(); }
        let direct = self.type_id_by_text(payload_text);
        if (direct != mir_id_invalid()) { return direct; }
        let enum_text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(enum_type));
        if (policy_generic_call_has_args(enum_text.clone()) != 0) {
            let resolved = self.resolve_type_text_for_owner(payload_text, enum_text);
            if (resolved.len > 0) {
                let resolved_type = self.type_id_by_text(resolved);
                if (resolved_type != mir_id_invalid()) { return resolved_type; }
            }
        }
        return mir_id_invalid();
    }

    public fn enum_variant_payload_type_at(self, enum_type: i32, variant_id: i32, arg_index: i32) -> i32 {
        let canonical_type = self.canonical_record_type_id(enum_type);
        let declared_type = self.enum_declared_payload_type_at(canonical_type, variant_id, arg_index);
        if (declared_type != mir_id_invalid()) { return declared_type; }
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.value_is_variant_constructor_for_type(value_id, canonical_type, variant_id)) {
                let arg_id = self.call_arg_at(value_id, arg_index);
                if (arg_id != mir_id_invalid()) { return self.m.value_type(arg_id); }
            } else if (arg_index == 0
                       && self.value_is_fail_variant_for_type(value_id, canonical_type, variant_id)) {
                let payload_id = self.m.value_lhs(value_id);
                if (payload_id != mir_id_invalid()) { return self.m.value_type(payload_id); }
            }
            value_id = value_id + 1;
        }
        self.report_error("cannot resolve enum payload type for variant " + mir_unit_variant_name(&self.m, variant_id));
        return mir_id_invalid();
    }

    public fn enum_payload_total_count(self, enum_type: i32) -> i32 {
        let canonical_type = self.canonical_record_type_id(enum_type);
        var out: i32 = 0;
        var variant_id: i32 = 1;
        while (variant_id <= self.m.variant_count) {
            if (mir_unit_variant_owner_type(&self.m, variant_id) == canonical_type
                && mir_unit_variant_is_primary_for_type_tag(&self.m, variant_id)) {
                out = out + self.enum_variant_payload_count(canonical_type, variant_id);
            }
            variant_id = variant_id + 1;
        }
        return out;
    }

    public fn enum_payload_field_index(self, enum_type: i32, variant_id: i32, arg_index: i32) -> i32 {
        let canonical_type = self.canonical_record_type_id(enum_type);
        let wanted_variant = self.canonical_variant_id(variant_id);
        var field_index: i32 = 1;
        var cur_variant: i32 = 1;
        while (cur_variant <= self.m.variant_count) {
            if (mir_unit_variant_owner_type(&self.m, cur_variant) == canonical_type
                && mir_unit_variant_is_primary_for_type_tag(&self.m, cur_variant)) {
                if (cur_variant == wanted_variant) { return field_index + arg_index; }
                field_index = field_index + self.enum_variant_payload_count(canonical_type, cur_variant);
            }
            cur_variant = cur_variant + 1;
        }
        return -1;
    }

    public fn get_or_create_enum_ty(self, type_id: i32) -> rawptr {
        let canonical_type = self.canonical_record_type_id(type_id);
        let cached = llvm_mir_map_get(self.type_struct_values, canonical_type);
        if (cached != null) { return cached; }
        let field_count = self.enum_payload_total_count(canonical_type) + 1;
        let name = "mir.enum." + llvm_mir_type_text(&self.m, canonical_type);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create enum ABI type " + llvm_mir_type_text(&self.m, canonical_type));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, canonical_type, st);
        let fields = malloc((field_count * 8) as u64);
        if (fields == null) {
            self.report_error("cannot allocate enum ABI field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_i32);
        var out_index: i32 = 1;
        var variant_id: i32 = 1;
        while (variant_id <= self.m.variant_count) {
            if (mir_unit_variant_owner_type(&self.m, variant_id) == canonical_type
                && mir_unit_variant_is_primary_for_type_tag(&self.m, variant_id)) {
                let payload_count = self.enum_variant_payload_count(canonical_type, variant_id);
                var arg_index: i32 = 0;
                while (arg_index < payload_count) {
                    let payload_type = self.enum_variant_payload_type_at(canonical_type, variant_id, arg_index);
                    let payload_ll = self.lower_type(payload_type);
                    if (payload_type == mir_id_invalid() || payload_ll == null) {
                        free(fields);
                        self.report_error("cannot lower enum payload type for " + mir_unit_variant_name(&self.m, variant_id));
                        return null;
                    }
                    ast_write_rawptr(ptr_offset(fields, out_index * 8), payload_ll);
                    out_index = out_index + 1;
                    arg_index = arg_index + 1;
                }
            }
            variant_id = variant_id + 1;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, field_count as u64, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize enum ABI type " + llvm_mir_type_text(&self.m, canonical_type));
            return null;
        }
        free(fields);
        return st;
    }

    public fn enum_field_ptr(self, storage: rawptr, enum_type: i32, idx: i32, name: string) -> rawptr {
        let enum_ty = self.get_or_create_enum_ty(enum_type);
        if (storage == null || enum_ty == null || idx < 0) { return null; }
        let canonical_type = self.canonical_record_type_id(enum_type);
        let field_count = self.enum_payload_total_count(canonical_type) + 1;
        if (idx >= field_count) {
            self.report_error("enum field index "
                      + policy_i64_to_string(idx as i64)
                      + " is outside "
                      + llvm_mir_type_text(&self.m, canonical_type)
                      + " field_count="
                      + policy_i64_to_string(field_count as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 enum_ty,
                                 storage,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn build_enum_value_from_variant(self, enum_type: i32, variant_id: i32, value_id: i32) -> rawptr {
        let enum_ty = self.get_or_create_enum_ty(enum_type);
        if (enum_ty == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, enum_ty, "mir.enum.tmp".c_str(), 12);
        if (tmp == null) {
            self.report_error("cannot allocate enum ABI temporary");
            return null;
        }
        let zero_init = vyx_rt_const_null(self.mod, enum_ty);
        let tag_ptr = self.enum_field_ptr(tmp, enum_type, 0, "enum.tag");
        let tag_v = self.lower_variant_tag_value(variant_id);
        if (zero_init == null || tag_ptr == null || tag_v == null) {
            self.report_error("cannot initialize enum ABI tag");
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        vyx_rt_build_store(self.mod, tag_v, tag_ptr);
        var arg_index: i32 = 0;
        var arg_id = self.m.value_first_arg(value_id);
        while (arg_id != mir_id_invalid()) {
            let field_index = self.enum_payload_field_index(enum_type, variant_id, arg_index);
            let payload_type = self.enum_variant_payload_type_at(enum_type, variant_id, arg_index);
            let payload_ptr = self.enum_field_ptr(tmp, enum_type, field_index, "enum.payload");
            let payload_val = self.lower_value_as(arg_id, payload_type);
            if (field_index < 0 || payload_type == mir_id_invalid() || payload_ptr == null || payload_val == null) {
                self.report_error("cannot lower enum payload for " + mir_unit_variant_name(&self.m, variant_id));
                return null;
            }
            vyx_rt_build_store(self.mod, payload_val, payload_ptr);
            arg_index = arg_index + 1;
            arg_id = self.m.value_next_arg(arg_id);
        }
        return vyx_rt_build_load(self.mod, enum_ty, tmp, "mir.enum.val".c_str(), 12);
    }

    public fn lower_enum_variant_call(self, value_id: i32) -> rawptr {
        let enum_type = self.m.value_type(value_id);
        var variant_id = self.pattern_variant_id(value_id);
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve enum constructor variant");
            return null;
        }
        return self.build_enum_value_from_variant(enum_type, variant_id, value_id);
    }

    public fn lower_enum_variant_ref(self, value_id: i32) -> rawptr {
        let enum_type = self.m.value_type(value_id);
        let variant_id = self.m.value_target_id(value_id);
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve enum variant reference");
            return null;
        }
        return self.build_enum_value_from_variant(enum_type, variant_id, value_id);
    }

    public fn enum_field_value(self, value: rawptr, enum_type: i32, idx: i32, field_type: rawptr, name: string) -> rawptr {
        let enum_ty = self.get_or_create_enum_ty(enum_type);
        if (value == null || enum_ty == null || field_type == null || idx < 0) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, enum_ty, "mir.enum.extract".c_str(), 16);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, value, tmp);
        let ptr = self.enum_field_ptr(tmp, enum_type, idx, name);
        if (ptr == null) { return null; }
        return vyx_rt_build_load(self.mod, field_type, ptr, name.c_str(), name.len as u64);
    }

    public fn enum_tag_value(self, value: rawptr, enum_type: i32) -> rawptr {
        return self.enum_field_value(value, enum_type, 0, self.ty_i32, "enum.tag");
    }

    public fn enum_payload_value(self, value: rawptr, enum_type: i32, variant_id: i32, arg_index: i32) -> rawptr {
        let payload_type = self.enum_variant_payload_type_at(enum_type, variant_id, arg_index);
        let field_index = self.enum_payload_field_index(enum_type, variant_id, arg_index);
        if (payload_type == mir_id_invalid() || field_index < 0) { return null; }
        return self.enum_field_value(value,
                                     enum_type,
                                     field_index,
                                     self.lower_type(payload_type),
                                     "enum.payload");
    }

    public fn get_or_create_result_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let ok_type = self.result_ok_type(type_id);
        let err_type = self.result_err_type(type_id);
        if (ok_type == mir_id_invalid() || err_type == mir_id_invalid()) { return null; }
        let name = "mir.result." + policy_i64_to_string(type_id as i64);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create Result ABI type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        let fields = malloc(24);
        if (fields == null) {
            self.report_error("cannot allocate Result ABI field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_i32);
        ast_write_rawptr(ptr_offset(fields, 8), self.lower_type(ok_type));
        ast_write_rawptr(ptr_offset(fields, 16), self.lower_type(err_type));
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 3, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize Result ABI type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn result_field_ptr(self, storage: rawptr, result_type: i32, idx: i32, name: string) -> rawptr {
        let result_ty = self.get_or_create_result_ty(result_type);
        if (storage == null || result_ty == null) { return null; }
        if (idx < 0 || idx >= 3) {
            self.report_error("Result field index out of range for "
                      + llvm_mir_type_text(&self.m, result_type)
                      + ": "
                      + policy_i64_to_string(idx as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 result_ty,
                                 storage,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn build_result_value_from_parts(self,
                                            result_type: i32,
                                            tag_value: rawptr,
                                            ok_value: rawptr,
                                            err_value: rawptr) -> rawptr {
        let result_ty = self.get_or_create_result_ty(result_type);
        let ok_type = self.result_ok_type(result_type);
        let err_type = self.result_err_type(result_type);
        if (result_ty == null || ok_type == mir_id_invalid() || err_type == mir_id_invalid()) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, result_ty, "mir.result.tmp".c_str(), 14);
        if (tmp == null) {
            self.report_error("cannot allocate Result ABI temporary");
            return null;
        }
        var ok_v = ok_value;
        var err_v = err_value;
        if (ok_v == null) { ok_v = vyx_rt_const_null(self.mod, self.lower_type(ok_type)); }
        if (err_v == null) { err_v = vyx_rt_const_null(self.mod, self.lower_type(err_type)); }
        let tag_ptr = self.result_field_ptr(tmp, result_type, 0, "result.tag");
        let ok_ptr = self.result_field_ptr(tmp, result_type, 1, "result.ok");
        let err_ptr = self.result_field_ptr(tmp, result_type, 2, "result.err");
        if (tag_ptr == null || ok_ptr == null || err_ptr == null || tag_value == null || ok_v == null || err_v == null) {
            self.report_error("cannot address Result ABI fields");
            return null;
        }
        vyx_rt_build_store(self.mod, tag_value, tag_ptr);
        vyx_rt_build_store(self.mod, ok_v, ok_ptr);
        vyx_rt_build_store(self.mod, err_v, err_ptr);
        return vyx_rt_build_load(self.mod, result_ty, tmp, "mir.result.val".c_str(), 14);
    }

    public fn variant_id_for_type_and_name(self, type_id: i32, variant_name: string) -> i32 {
        if (variant_name.len == 0) { return mir_id_invalid(); }
        let canonical_type = self.canonical_record_type_id(type_id);
        var variant_id: i32 = 1;
        while (variant_id <= self.m.variant_count) {
            if (mir_unit_variant_owner_type(&self.m, variant_id) == canonical_type
                && mir_unit_variant_name(&self.m, variant_id) == variant_name) {
                return variant_id;
            }
            variant_id = variant_id + 1;
        }
        return mir_id_invalid();
    }

    public fn build_enum_value_from_variant_payload(self,
                                                    enum_type: i32,
                                                    variant_id: i32,
                                                    payload_value_id: i32,
                                                    source_value_id: i32) -> rawptr {
        let enum_ty = self.get_or_create_enum_ty(enum_type);
        if (enum_ty == null || variant_id == mir_id_invalid()) { return null; }
        let payload_count = self.enum_variant_payload_count(enum_type, variant_id);
        if (payload_count > 1) {
            self.report_error("fail can only lower single-payload error variant " + mir_unit_variant_name(&self.m, variant_id));
            return null;
        }
        if (payload_count == 0 && payload_value_id != mir_id_invalid() && self.m.value_op(source_value_id) == 1) {
            self.report_error("error variant " + mir_unit_variant_name(&self.m, variant_id) + " does not accept fail payload");
            return null;
        }
        let tmp = vyx_rt_build_alloca(self.mod, enum_ty, "mir.fail.enum.tmp".c_str(), 17);
        let zero_init = vyx_rt_const_null(self.mod, enum_ty);
        let tag_ptr = self.enum_field_ptr(tmp, enum_type, 0, "enum.tag");
        let tag_v = self.lower_variant_tag_value(variant_id);
        if (tmp == null || zero_init == null || tag_ptr == null || tag_v == null) {
            self.report_error("cannot initialize fail enum value");
            return null;
        }
        vyx_rt_build_store(self.mod, zero_init, tmp);
        vyx_rt_build_store(self.mod, tag_v, tag_ptr);
        if (payload_count == 1) {
            let payload_type = self.enum_variant_payload_type_at(enum_type, variant_id, 0);
            let payload_ptr = self.enum_field_ptr(tmp,
                                                  enum_type,
                                                  self.enum_payload_field_index(enum_type, variant_id, 0),
                                                  "enum.payload");
            var payload_val: rawptr = null;
            if (payload_value_id == mir_id_invalid()) {
                payload_val = self.default_value_for_type(payload_type);
            } else {
                payload_val = self.lower_value_as(payload_value_id, payload_type);
            }
            if (payload_type == mir_id_invalid() || payload_ptr == null || payload_val == null) {
                self.report_error("cannot lower fail payload for " + mir_unit_variant_name(&self.m, variant_id));
                return null;
            }
            vyx_rt_build_store(self.mod, payload_val, payload_ptr);
        } else if (payload_value_id != mir_id_invalid()) {
            self.lower_value(payload_value_id);
        }
        return vyx_rt_build_load(self.mod, enum_ty, tmp, "mir.fail.enum".c_str(), 13);
    }

    public fn lower_result_fail_value(self, value_id: i32) -> rawptr {
        let result_type = self.m.value_type(value_id);
        if (!self.type_is_result_abi(result_type)) {
            self.report_error("fail requires Result value type");
            return null;
        }
        let err_type = self.result_err_type(result_type);
        if (err_type == mir_id_invalid()) { return null; }
        let payload_value_id = self.m.value_lhs(value_id);
        var err_payload: rawptr = null;
        if (self.type_is_plain_enum_abi(err_type)) {
            let variant_id = self.variant_id_for_type_and_name(err_type, self.m.value_text(value_id));
            if (variant_id == mir_id_invalid()) {
                self.report_error("cannot resolve fail error variant "
                          + llvm_mir_type_text(&self.m, err_type)
                          + "." + self.m.value_text(value_id));
                return null;
            }
            err_payload = self.build_enum_value_from_variant_payload(err_type,
                                                                     variant_id,
                                                                     payload_value_id,
                                                                     value_id);
        } else {
            if (payload_value_id == mir_id_invalid()) {
                self.report_error("fail for non-enum error type requires payload");
                return null;
            }
            err_payload = self.lower_value_as(payload_value_id, err_type);
        }
        if (err_payload == null) {
            self.report_error("cannot lower fail error payload");
            return null;
        }
        let result_err_tag = self.result_tag_for_variant_name("Err");
        if (result_err_tag == null) { return null; }
        return self.build_result_value_from_parts(result_type,
                                                  result_err_tag,
                                                  null,
                                                  err_payload);
    }

    public fn lower_result_ok_wrap_value(self, value_id: i32, result_type: i32) -> rawptr {
        let ok_type = self.result_ok_type(result_type);
        if (ok_type == mir_id_invalid()) { return null; }
        let payload = self.lower_value_as(value_id, ok_type);
        if (payload == null) {
            self.report_error("cannot lower Result Ok payload");
            return null;
        }
        return self.build_result_value_from_parts(result_type,
                                                  vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                  payload,
                                                  null);
    }

    public fn result_payload_type_for_variant(self, result_type: i32, variant_id: i32) -> i32 {
        if (!self.type_is_result_abi(result_type) || variant_id == mir_id_invalid()) { return mir_id_invalid(); }
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        if (variant_name == "Ok") { return self.result_ok_type(result_type); }
        if (variant_name == "Err") { return self.result_err_type(result_type); }
        self.report_error("unknown Result variant " + variant_name);
        return mir_id_invalid();
    }

    public fn lower_result_variant_ref(self, value_id: i32) -> rawptr {
        let result_type = self.m.value_type(value_id);
        if (!self.type_is_result_abi(result_type)) {
            self.report_error("Result variant reference requires Result type");
            return null;
        }
        let variant_id = self.m.value_target_id(value_id);
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        self.report_error("Result variant " + variant_name + " requires constructor call");
        return null;
    }

    public fn lower_result_variant_call(self, value_id: i32) -> rawptr {
        let result_type = self.m.value_type(value_id);
        if (!self.type_is_result_abi(result_type)) {
            self.report_error("Result variant call requires Result return type");
            return null;
        }
        var variant_id = self.m.value_target_id(value_id);
        if (self.m.value_target_kind(value_id) != mir_target_hir_variant()) {
            let callee_id = self.m.value_lhs(value_id);
            if (callee_id != mir_id_invalid()
                && self.m.value_target_kind(callee_id) == mir_target_hir_variant()) {
                variant_id = self.m.value_target_id(callee_id);
            }
        }
        if (variant_id == mir_id_invalid()) {
            self.report_error("cannot resolve Result constructor variant");
            return null;
        }
        let variant_name = mir_unit_variant_name(&self.m, variant_id);
        let argc = self.call_arg_count(value_id);
        if (argc != 1) {
            self.report_error("Result." + variant_name + " constructor argument count mismatch");
            return null;
        }
        let payload_type = self.result_payload_type_for_variant(result_type, variant_id);
        if (payload_type == mir_id_invalid()) { return null; }
        let payload = self.lower_value_as(self.call_arg_at(value_id, 0), payload_type);
        let tag_v = self.result_tag_for_variant_name(variant_name);
        if (payload == null || tag_v == null) {
            self.report_error("cannot lower Result." + variant_name + " payload");
            return null;
        }
        if (variant_name == "Ok") {
            return self.build_result_value_from_parts(result_type, tag_v, payload, null);
        }
        if (variant_name == "Err") {
            return self.build_result_value_from_parts(result_type, tag_v, null, payload);
        }
        self.report_error("unknown Result variant " + variant_name);
        return null;
    }

    public fn result_field_value(self, value: rawptr, result_type: i32, idx: i32, field_type: rawptr, name: string) -> rawptr {
        let result_ty = self.get_or_create_result_ty(result_type);
        if (value == null || result_ty == null || field_type == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, result_ty, "mir.result.extract".c_str(), 18);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, value, tmp);
        let ptr = self.result_field_ptr(tmp, result_type, idx, name);
        if (ptr == null) { return null; }
        return vyx_rt_build_load(self.mod, field_type, ptr, name.c_str(), name.len as u64);
    }

    public fn result_tag_value(self, value: rawptr, result_type: i32) -> rawptr {
        return self.result_field_value(value, result_type, 0, self.ty_i32, "result.tag");
    }

    public fn result_ok_value(self, value: rawptr, result_type: i32) -> rawptr {
        let ok_type = self.result_ok_type(result_type);
        if (ok_type == mir_id_invalid()) { return null; }
        return self.result_field_value(value, result_type, 1, self.lower_type(ok_type), "result.ok");
    }

    public fn result_err_value(self, value: rawptr, result_type: i32) -> rawptr {
        let err_type = self.result_err_type(result_type);
        if (err_type == mir_id_invalid()) { return null; }
        return self.result_field_value(value, result_type, 2, self.lower_type(err_type), "result.err");
    }

    public fn lower_result_try_value(self, value_id: i32) -> rawptr {
        let result_value_id = self.m.value_lhs(value_id);
        let result_type = self.m.value_type(result_value_id);
        if (!self.type_is_result_abi(result_type)) {
            self.report_error("question operator requires Result input");
            return null;
        }
        let result_value = self.lower_value_as(result_value_id, result_type);
        let tag = self.result_tag_value(result_value, result_type);
        if (result_value == null || tag == null) {
            self.report_error("cannot lower Result question operand");
            return null;
        }
        let is_err = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_eq(),
                                       tag,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 1, 0),
                                       llvm_mir_empty_name(),
                                       0);
        let err_name = "mir.try.err." + policy_i64_to_string(value_id as i64);
        let ok_name = "mir.try.ok." + policy_i64_to_string(value_id as i64);
        let err_bb = vyx_rt_append_block(self.mod,
                                         self.current_function_value,
                                         err_name.c_str(),
                                         err_name.len as u64);
        let ok_bb = vyx_rt_append_block(self.mod,
                                        self.current_function_value,
                                        ok_name.c_str(),
                                        ok_name.len as u64);
        if (is_err == null || err_bb == null || ok_bb == null) {
            self.report_error("cannot create Result question control flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_err, err_bb, ok_bb);

        vyx_rt_position_at_end(self.mod, err_bb);
        let ret_type = self.m.function_return_type(self.current_function_id);
        if (llvm_mir_type_kind(&self.m, ret_type) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
        } else if (self.type_is_result_abi(ret_type)) {
            if (ret_type == result_type) {
                self.emit_return_value(self.current_function_id, result_value);
            } else {
                let err_payload = self.result_err_value(result_value, result_type);
                let ret_err_type = self.result_err_type(ret_type);
                let cast_err = self.cast_value(err_payload, self.result_err_type(result_type), ret_err_type);
                let ret_result = self.build_result_value_from_parts(ret_type,
                                                                    vyx_rt_const_int(self.mod, self.ty_i32, 1, 0),
                                                                    null,
                                                                    cast_err);
                if (ret_result == null) { vyx_rt_build_ret_void(self.mod); }
                else { self.emit_return_value(self.current_function_id, ret_result); }
            }
        } else {
            var ret_v = self.result_err_value(result_value, result_type);
            if (ret_v == null) { ret_v = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1); }
            let cast_ret = self.cast_value(ret_v, self.result_err_type(result_type), ret_type);
            if (cast_ret == null) { vyx_rt_build_ret_void(self.mod); }
            else { self.emit_return_value(self.current_function_id, cast_ret); }
        }

        vyx_rt_position_at_end(self.mod, ok_bb);
        let ok_payload = self.result_ok_value(result_value, result_type);
        return self.cast_value(ok_payload, self.result_ok_type(result_type), self.m.value_type(value_id));
    }

    public fn string_cstr_from_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let ty = self.m.value_type(value_id);
        if (!self.type_is_string_view_type(ty)) {
            self.report_error("value is not string-view compatible: " + llvm_mir_type_text(&self.m, ty));
            return null;
        }
        if (self.m.value_kind(value_id) == mir_value_const_str()
            && self.m.value_first_arg(value_id) == mir_id_invalid()) {
            return self.emit_str_ptr(self.m.value_text(value_id));
        }
        return self.string_ptr_value(self.lower_string_view_value(value_id));
    }

    public fn string_len_from_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        if (self.m.value_kind(value_id) == mir_value_const_str()
            && self.m.value_first_arg(value_id) == mir_id_invalid()) {
            return vyx_rt_const_int(self.mod, self.ty_i64, self.m.value_text(value_id).len, 0);
        }
        return self.string_len_value(self.lower_string_view_value(value_id));
    }

    public fn reference_value_to_string(self, value_id: i32, reference_type: i32) -> rawptr {
        let elem = hir_type_table_elem(self.m.types, reference_type);
        let handle = self.lower_value(value_id);
        let addr = self.pointer_handle_address(handle, "mir.string.ref");
        let storage = self.lower_storage_type(elem);
        if (elem == mir_id_invalid() || addr == null || storage == null) {
            self.report_error_at_value(value_id, "cannot load reference for string conversion");
            return null;
        }
        let loaded = vyx_rt_build_load(self.mod, storage, addr, llvm_mir_empty_name(), 0);
        if (loaded == null) { return null; }
        let kind = llvm_mir_type_kind(&self.m, elem);
        if (self.type_is_str_abi(elem)) {
            // The container or caller owns this buffer. Interpolation can copy
            // its bytes but must not release it as a formatting temporary.
            let len = self.string_len_value(loaded);
            return self.emit_string_value_from_parts(self.string_ptr_value(loaded), len, len,
                                                      vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        }
        if (kind == ty_BOOL()) {
            return self.string_value_from_bool_to_string(self.int_value_to_bits(loaded, elem, 32));
        }
        if (llvm_mir_int_bits_for_kind(kind) > 0) {
            return self.string_value_from_integer_to_string(self.int_value_to_bits(loaded, elem, 64),
                                                             llvm_mir_kind_decimal_unsigned(kind));
        }
        if (llvm_mir_kind_float(kind)) {
            var as_double = loaded;
            if (kind == ty_F32()) {
                as_double = vyx_rt_build_fp_ext(self.mod, loaded, vyx_rt_float_type(self.mod, 64),
                                                llvm_mir_empty_name(), 0);
            }
            return self.float_format_arg_to_string(as_double);
        }
        self.report_error_at_value(value_id, "cannot convert reference to `"
                                   + llvm_mir_type_text(&self.m, elem) + "` to string");
        return null;
    }

    public fn string_value_for_interpolation_segment(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let value_type = self.m.value_type(value_id);
        if (self.type_is_string_view_type(value_type)) {
            return self.lower_string_view_value(value_id);
        }
        let kind = llvm_mir_type_kind(&self.m, value_type);
        if (kind == ty_REF() || kind == ty_MUTREF()) {
            return self.reference_value_to_string(value_id, value_type);
        }
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits > 0 && kind != ty_BOOL()) {
            let as_i64 = self.int_value_to_bits(self.lower_value(value_id), value_type, 64);
            if (as_i64 == null) {
                self.report_error("cannot lower integer interpolation segment");
                return null;
            }
            return self.string_value_from_integer_to_string(
                as_i64,
                llvm_mir_kind_decimal_unsigned(kind));
        }
        if (kind == ty_BOOL()) {
            if (self.builtin_bool_to_string_fn == null || self.builtin_bool_to_string_fty == null) {
                self.report_error("bool_to_string declaration is unavailable");
                return null;
            }
            let as_i32 = self.int_value_to_bits(self.lower_value(value_id), value_type, 32);
            let cstr = vyx_rt_build_call1(self.mod,
                                          self.builtin_bool_to_string_fty,
                                          self.builtin_bool_to_string_fn,
                                          as_i32,
                                          llvm_mir_empty_name(),
                                          0);
            let nonzero = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ne(),
                                            as_i32,
                                            vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                            llvm_mir_empty_name(),
                                            0);
            let len_v = vyx_rt_build_select(self.mod,
                                            nonzero,
                                            vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                            vyx_rt_const_int(self.mod, self.ty_i64, 5, 0),
                                            llvm_mir_empty_name(),
                                            0);
            if (cstr == null || len_v == null) {
                self.report_error("cannot lower bool interpolation segment");
                return null;
            }
            let cap_v2 = self.string_capacity_for_cstr(len_v, 3);
            return self.emit_string_value_from_parts(cstr,
                                                     len_v,
                                                     cap_v2,
                                                     vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
        }
        if (llvm_mir_kind_float(kind)) {
            return self.float_value_to_string(value_id);
        }
        let cstr2 = self.value_to_cstr(value_id);
        if (cstr2 == null || self.builtin_strlen_fn == null || self.builtin_strlen_fty == null) {
            self.report_error("cannot lower interpolation segment");
            return null;
        }
        let len2 = vyx_rt_build_call1(self.mod,
                                      self.builtin_strlen_fty,
                                      self.builtin_strlen_fn,
                                      cstr2,
                                      llvm_mir_empty_name(),
                                      0);
        if (len2 == null) {
            self.report_error("cannot measure interpolation segment");
            return null;
        }
        return self.emit_string_value_from_parts(cstr2,
                                                 len2,
                                                 len2,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn lower_interpolated_string_value(self, value_id: i32) -> rawptr {
        let seg_count = self.call_arg_count(value_id);
        if (seg_count <= 0) { return self.emit_str_value(""); }
        let part_values = malloc((seg_count * 8) as u64);
        let part_lens = malloc((seg_count * 8) as u64);
        let part_kinds = malloc((seg_count * 4) as u64);
        if (part_values == null || part_lens == null || part_kinds == null) {
            if (part_values != null) { free(part_values); }
            if (part_lens != null) { free(part_lens); }
            if (part_kinds != null) { free(part_kinds); }
            self.report_error("cannot allocate interpolation segment buffers");
            return null;
        }
        var total = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        var idx: i32 = 0;
        var seg = self.m.value_first_arg(value_id);
        while (seg != mir_id_invalid()) {
            let payload = self.call_arg_payload(seg);
            let payload_type = self.m.value_type(payload);
            let payload_kind = llvm_mir_type_kind(&self.m, payload_type);
            let payload_bits = llvm_mir_int_bits_for_kind(payload_kind);
            var stored_value: rawptr = null;
            var part_len: rawptr = null;
            var part_kind: i32 = 0;
            let format_unsigned = llvm_mir_kind_decimal_unsigned(payload_kind);

            if (payload_bits > 0 && payload_kind != ty_BOOL()
                && ((format_unsigned
                     && self.builtin_uint_decimal_len_fn != null
                     && self.builtin_uint_decimal_len_fty != null
                     && self.builtin_uint_to_string_into_fn != null
                     && self.builtin_uint_to_string_into_fty != null)
                    || (!format_unsigned
                        && self.builtin_int_decimal_len_fn != null
                        && self.builtin_int_decimal_len_fty != null
                        && self.builtin_int_to_string_into_fn != null
                        && self.builtin_int_to_string_into_fty != null))) {
                stored_value = self.int_value_to_bits(self.lower_value(payload), payload_type, 64);
                if (stored_value == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    self.report_error("cannot lower integer interpolation segment");
                    return null;
                }
                var decimal_len_fn: rawptr = self.builtin_int_decimal_len_fn;
                var decimal_len_fty: rawptr = self.builtin_int_decimal_len_fty;
                if (format_unsigned) {
                    decimal_len_fn = self.builtin_uint_decimal_len_fn;
                    decimal_len_fty = self.builtin_uint_decimal_len_fty;
                    part_kind = 5;
                } else {
                    part_kind = 1;
                }
                part_len = vyx_rt_build_call1(self.mod,
                                              decimal_len_fty,
                                              decimal_len_fn,
                                              stored_value,
                                              "mir.interp.int.len".c_str(),
                                              18);
            } else if (payload_kind == ty_BOOL()) {
                stored_value = self.int_value_to_bits(self.lower_value(payload), payload_type, 32);
                if (stored_value == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    self.report_error("cannot lower bool interpolation segment");
                    return null;
                }
                let nonzero = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_ne(),
                                                stored_value,
                                                vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                llvm_mir_empty_name(),
                                                0);
                part_len = vyx_rt_build_select(self.mod,
                                               nonzero,
                                               vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                               vyx_rt_const_int(self.mod, self.ty_i64, 5, 0),
                                               "mir.interp.bool.len".c_str(),
                                               20);
                part_kind = 2;
            } else {
                let part_value = self.string_value_for_interpolation_segment(payload);
                if (part_value == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    return null;
                }
                part_len = self.string_len_value(part_value);
                part_kind = 0;
                if (llvm_mir_kind_float(payload_kind)) {
                    stored_value = self.string_ptr_value(part_value);
                    part_kind = 3;
                } else if (self.string_value_is_consumed_temporary(payload, 0)) {
                    // Preserve all four ABI fields until the segment has been
                    // copied so allocator-domain ownership can be released.
                    stored_value = part_value;
                    part_kind = 4;
                } else {
                    stored_value = self.string_ptr_value(part_value);
                }
            }

            if (stored_value == null || part_len == null) {
                free(part_values);
                free(part_lens);
                free(part_kinds);
                self.report_error("cannot extract interpolation segment");
                return null;
            }
            ast_write_rawptr(ptr_offset(part_values, idx * 8), stored_value);
            ast_write_rawptr(ptr_offset(part_lens, idx * 8), part_len);
            ast_write_i32(ptr_offset(part_kinds, idx * 4), part_kind);
            total = vyx_rt_build_add(self.mod, total, part_len, llvm_mir_empty_name(), 0);
            if (total == null) {
                free(part_values);
                free(part_lens);
                free(part_kinds);
                self.report_error("cannot compute interpolation length");
                return null;
            }
            idx = idx + 1;
            seg = self.m.value_next_arg(seg);
        }
        let data = self.alloc_string_data_for_len(total);
        if (data == null) {
            free(part_values);
            free(part_lens);
            free(part_kinds);
            return null;
        }
        var off = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        idx = 0;
        while (idx < seg_count) {
            let kind_tag = ast_read_i32(ptr_offset(part_kinds, idx * 4));
            let stored = ast_read_rawptr(ptr_offset(part_values, idx * 8));
            let len_v = ast_read_rawptr(ptr_offset(part_lens, idx * 8));
            let dst = self.ptr_offset_bytes(data, off, "mir.interp.dst");
            if (stored == null || len_v == null || dst == null) {
                free(part_values);
                free(part_lens);
                free(part_kinds);
                self.report_error("cannot copy interpolation segment");
                return null;
            }
            if (kind_tag == 1 || kind_tag == 5) {
                var into_fn: rawptr = self.builtin_int_to_string_into_fn;
                var into_fty: rawptr = self.builtin_int_to_string_into_fty;
                if (kind_tag == 5) {
                    into_fn = self.builtin_uint_to_string_into_fn;
                    into_fty = self.builtin_uint_to_string_into_fty;
                }
                let wrote = vyx_rt_build_call2(self.mod,
                                               into_fty,
                                               into_fn,
                                               stored,
                                               dst,
                                               llvm_mir_empty_name(),
                                               0);
                if (wrote == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    self.report_error("cannot emit integer interpolation write");
                    return null;
                }
            } else {
                var src = stored;
                if (kind_tag == 2) {
                    let nonzero2 = vyx_rt_build_icmp(self.mod,
                                                     llvm_mir_icmp_ne(),
                                                     stored,
                                                     vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                                     llvm_mir_empty_name(),
                                                     0);
                    src = vyx_rt_build_select(self.mod,
                                              nonzero2,
                                              self.emit_str_ptr("true"),
                                              self.emit_str_ptr("false"),
                                               "mir.interp.bool.ptr".c_str(),
                                               20);
                } else if (kind_tag == 4) {
                    src = self.string_ptr_value(stored);
                }
                if (src == null || self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    self.report_error("cannot copy interpolation segment");
                    return null;
                }
                let copied = vyx_rt_build_call3(self.mod,
                                                self.builtin_memcpy_fty,
                                                self.builtin_memcpy_fn,
                                                dst,
                                                src,
                                                len_v,
                                                llvm_mir_empty_name(),
                                                0);
                if (copied == null) {
                    free(part_values);
                    free(part_lens);
                    free(part_kinds);
                    self.report_error("cannot emit interpolation copy");
                    return null;
                }
                if (kind_tag == 3) {
                    vyx_rt_build_call1(self.mod,
                                       self.builtin_forget_string_len_fty,
                                       self.builtin_forget_string_len_fn,
                                       stored,
                                       llvm_mir_empty_name(),
                                       0);
                    vyx_rt_build_call1(self.mod,
                                       self.builtin_free_fty,
                                       self.builtin_free_fn,
                                       stored,
                                       llvm_mir_empty_name(),
                                       0);
                } else if (kind_tag == 4) {
                    let owned = self.string_owned_value(stored);
                    if (owned == null || !self.release_replaced_string_storage(src, owned)) {
                        free(part_values);
                        free(part_lens);
                        free(part_kinds);
                        return null;
                    }
                }
            }
            off = vyx_rt_build_add(self.mod, off, len_v, llvm_mir_empty_name(), 0);
            if (off == null) {
                free(part_values);
                free(part_lens);
                free(part_kinds);
                self.report_error("cannot advance interpolation offset");
                return null;
            }
            idx = idx + 1;
        }
        free(part_values);
        free(part_lens);
        free(part_kinds);
        let cap_v = vyx_rt_build_add(self.mod,
                                     total,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                     llvm_mir_empty_name(),
                                     0);
        return self.emit_string_value_from_parts(data,
                                                 total,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_string_concat_values(self, lhs_value: rawptr, rhs_value: rawptr) -> rawptr {
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable for str concat");
            return null;
        }
        if (lhs_value == null || rhs_value == null) {
            self.report_error("cannot lower string concat operands");
            return null;
        }
        let lhs_ptr = self.string_ptr_value(lhs_value);
        let rhs_ptr = self.string_ptr_value(rhs_value);
        let lhs_len = self.string_len_value(lhs_value);
        let rhs_len = self.string_len_value(rhs_value);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot extract str concat operands");
            return null;
        }
        let total = vyx_rt_build_add(self.mod,
                                     lhs_len,
                                     rhs_len,
                                     llvm_mir_empty_name(),
                                     0);
        if (total == null) {
            self.report_error("cannot compute str concat length");
            return null;
        }
        let data_ptr = self.alloc_string_data_for_len(total);
        if (data_ptr == null) { return null; }
        let lhs_copy = vyx_rt_build_call3(self.mod,
                                          self.builtin_memcpy_fty,
                                          self.builtin_memcpy_fn,
                                          data_ptr,
                                          lhs_ptr,
                                          lhs_len,
                                          llvm_mir_empty_name(),
                                          0);
        let tail = self.ptr_offset_bytes(data_ptr, lhs_len, "mir.str.concat.tail");
        if (lhs_copy == null || tail == null) {
            self.report_error("cannot copy left str concat operand");
            return null;
        }
        let rhs_copy = vyx_rt_build_call3(self.mod,
                                          self.builtin_memcpy_fty,
                                          self.builtin_memcpy_fn,
                                          tail,
                                          rhs_ptr,
                                          rhs_len,
                                          llvm_mir_empty_name(),
                                          0);
        if (rhs_copy == null) {
            self.report_error("cannot copy right str concat operand");
            return null;
        }
        let cap_v = vyx_rt_build_add(self.mod,
                                     total,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        if (cap_v == null) {
            self.report_error("cannot compute str concat capacity");
            return null;
        }
        return self.emit_string_value_from_parts(data_ptr,
                                                 total,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_string_concat_parts(self, lhs_id: i32, rhs_id: i32) -> rawptr {
        let lhs_value = self.lower_string_view_value(lhs_id);
        let rhs_value = self.lower_string_view_value(rhs_id);
        return self.lower_string_concat_values(lhs_value, rhs_value);
    }

    public fn value_is_string_concat_node(self, value_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (self.m.value_kind(value_id) != mir_value_binary()) { return false; }
        if (self.m.value_op(value_id) != llvm_mir_tk_PLUS()) { return false; }
        return self.type_is_string_view_type(self.m.value_type(value_id));
    }

    public fn lower_string_concat_value(self, value_id: i32) -> rawptr {
        let cap: i32 = 4096;
        let stack = malloc((cap * 4) as u64);
        let leaves = malloc((cap * 4) as u64);
        if (stack == null || leaves == null) {
            if (stack != null) { free(stack); }
            if (leaves != null) { free(leaves); }
            self.report_error("cannot allocate str concat flatten stack");
            return null;
        }
        var sp: i32 = 0;
        var leaf_count: i32 = 0;
        ast_write_i32(stack, value_id);
        sp = 1;
        while (sp > 0) {
            sp = sp - 1;
            let cur = ast_read_i32(ptr_offset(stack, sp * 4));
            if (self.value_is_string_concat_node(cur)) {
                if (sp + 2 >= cap) {
                    free(stack);
                    free(leaves);
                    self.report_error("str concat expression is too deep");
                    return null;
                }
                ast_write_i32(ptr_offset(stack, sp * 4), self.m.value_rhs(cur));
                sp = sp + 1;
                ast_write_i32(ptr_offset(stack, sp * 4), self.m.value_lhs(cur));
                sp = sp + 1;
            } else {
                if (leaf_count >= cap) {
                    free(stack);
                    free(leaves);
                    self.report_error("str concat expression has too many operands");
                    return null;
                }
                ast_write_i32(ptr_offset(leaves, leaf_count * 4), cur);
                leaf_count = leaf_count + 1;
            }
        }
        if (leaf_count <= 0) {
            free(stack);
            free(leaves);
            self.report_error("str concat expression has no operands");
            return null;
        }
        var out = self.lower_string_view_value(ast_read_i32(leaves));
        var i: i32 = 1;
        while (i < leaf_count && out != null) {
            let rhs_value = self.lower_string_view_value(ast_read_i32(ptr_offset(leaves, i * 4)));
            out = self.lower_string_concat_values(out, rhs_value);
            i = i + 1;
        }
        free(stack);
        free(leaves);
        return out;
    }

    public fn lower_string_equals_raw_condition(self, lhs_value: rawptr, rhs_value: rawptr, negate: bool) -> rawptr {
        if (self.builtin_memcmp_fn == null || self.builtin_memcmp_fty == null) {
            self.report_error("memcmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_ptr_value(lhs_value);
        let rhs_ptr = self.string_ptr_value(rhs_value);
        let lhs_len = self.string_len_value(lhs_value);
        let rhs_len = self.string_len_value(rhs_value);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower raw string equality operands");
            return null;
        }
        let nullp = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let empty = self.emit_str_ptr("");
        let lhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            lhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let rhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            rhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let lhs_safe = vyx_rt_build_select(self.mod,
                                           lhs_is_null,
                                           empty,
                                           lhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let rhs_safe = vyx_rt_build_select(self.mod,
                                           rhs_is_null,
                                           empty,
                                           rhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let len_same = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         lhs_len,
                                         rhs_len,
                                         llvm_mir_empty_name(),
                                         0);
        let cmp_len = vyx_rt_build_select(self.mod,
                                          len_same,
                                          lhs_len,
                                          vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                          llvm_mir_empty_name(),
                                          0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcmp_fty,
                                            self.builtin_memcmp_fn,
                                            lhs_safe,
                                            rhs_safe,
                                            cmp_len,
                                            "mir.str.rawcmp".c_str(),
                                            14);
        if (native_cmp == null) {
            self.report_error("cannot emit memcmp for raw string equality");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        let same = vyx_rt_build_and(self.mod, len_same, content_same, llvm_mir_empty_name(), 0);
        if (negate) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     same,
                                     vyx_rt_const_int(self.mod, self.ty_i1, 0, 0),
                                     llvm_mir_empty_name(),
                                     0);
        }
        return same;
    }

    public fn lower_string_equals_condition(self, lhs_id: i32, rhs_id: i32, negate: bool) -> rawptr {
        if (vyx_bootstrap_profile_level() > 2) {
            print("[llvm-string-eq] lhs=" + policy_i64_to_string(lhs_id as i64)
                  + " lhs-kind=" + policy_i64_to_string(self.m.value_kind(lhs_id) as i64)
                  + " lhs-type=" + llvm_mir_type_text(&self.m, self.m.value_type(lhs_id))
                  + " rhs=" + policy_i64_to_string(rhs_id as i64)
                  + " rhs-kind=" + policy_i64_to_string(self.m.value_kind(rhs_id) as i64)
                  + " rhs-type=" + llvm_mir_type_text(&self.m, self.m.value_type(rhs_id))
                  + " negate=" + policy_i64_to_string(negate as i64));
        }
        if (self.builtin_memcmp_fn == null || self.builtin_memcmp_fty == null) {
            self.report_error("memcmp declaration is unavailable");
            return null;
        }
        let lhs_ptr = self.string_cstr_from_value(lhs_id);
        let rhs_ptr = self.string_cstr_from_value(rhs_id);
        let lhs_len = self.string_len_from_value(lhs_id);
        let rhs_len = self.string_len_from_value(rhs_id);
        if (lhs_ptr == null || rhs_ptr == null || lhs_len == null || rhs_len == null) {
            self.report_error("cannot lower string equality operands");
            return null;
        }
        let nullp = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let empty = self.emit_str_ptr("");
        let lhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            lhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let rhs_is_null = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            rhs_ptr,
                                            nullp,
                                            llvm_mir_empty_name(),
                                            0);
        let lhs_safe = vyx_rt_build_select(self.mod,
                                           lhs_is_null,
                                           empty,
                                           lhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let rhs_safe = vyx_rt_build_select(self.mod,
                                           rhs_is_null,
                                           empty,
                                           rhs_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let len_same = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_eq(),
                                         lhs_len,
                                         rhs_len,
                                         llvm_mir_empty_name(),
                                         0);
        let cmp_len = vyx_rt_build_select(self.mod,
                                          len_same,
                                          lhs_len,
                                          vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                          llvm_mir_empty_name(),
                                          0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcmp_fty,
                                            self.builtin_memcmp_fn,
                                            lhs_safe,
                                            rhs_safe,
                                            cmp_len,
                                            "mir.str.cmp".c_str(),
                                            11);
        if (native_cmp == null) {
            self.report_error("cannot emit memcmp for string equality");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        let same = vyx_rt_build_and(self.mod, len_same, content_same, llvm_mir_empty_name(), 0);
        if (negate) {
            return vyx_rt_build_icmp(self.mod,
                                     llvm_mir_icmp_eq(),
                                     same,
                                     vyx_rt_const_int(self.mod, self.ty_i1, 0, 0),
                                     llvm_mir_empty_name(),
                                     0);
        }
        return same;
    }

    public fn lower_string_equals_parts(self, lhs_id: i32, rhs_id: i32, negate: bool) -> rawptr {
        let cond = self.lower_string_equals_condition(lhs_id, rhs_id, negate);
        return self.bool_value_i8(cond);
    }

    public fn lower_string_binary_value(self, value_id: i32) -> rawptr {
        let op = self.m.value_op(value_id);
        if (op == llvm_mir_tk_PLUS()) { return self.lower_string_concat_value(value_id); }
        if (op == llvm_mir_tk_EQEQ()) {
            return self.lower_string_equals_parts(self.m.value_lhs(value_id), self.m.value_rhs(value_id), false);
        }
        if (op == llvm_mir_tk_NEQ()) {
            return self.lower_string_equals_parts(self.m.value_lhs(value_id), self.m.value_rhs(value_id), true);
        }
        self.report_error("cannot lower string binary op " + policy_i64_to_string(op as i64));
        return null;
    }

    public fn lower_string_concat_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("str_concat requires exactly two arguments");
            return null;
        }
        return self.lower_string_concat_parts(self.call_arg_at(value_id, 0), self.call_arg_at(value_id, 1));
    }

    public fn lower_string_case_call(self, value_id: i32, to_upper: bool) -> rawptr {
        var receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string case-conversion call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string case-conversion receiver is not str ABI");
            return null;
        }
        var fn_value = self.builtin_string_to_lower_len_fn;
        var fn_type = self.builtin_string_to_lower_len_fty;
        if (to_upper) {
            fn_value = self.builtin_string_to_upper_len_fn;
            fn_type = self.builtin_string_to_upper_len_fty;
        }
        if (fn_value == null || fn_type == null) {
            self.report_error("string case-conversion len-aware declaration is unavailable");
            return null;
        }
        let source_value = self.lower_string_view_value(receiver_id);
        let source_ptr = self.string_ptr_value(source_value);
        let source_len = self.string_len_value(source_value);
        if (source_value == null || source_ptr == null || source_len == null) {
            self.report_error("cannot lower string case-conversion receiver");
            return null;
        }
        let raw_out = vyx_rt_build_call2(self.mod,
                                         fn_type,
                                         fn_value,
                                         source_ptr,
                                         source_len,
                                         "mir.str.case".c_str(),
                                         12);
        if (raw_out == null) {
            self.report_error("cannot emit string case-conversion call");
            return null;
        }
        let cap_v = vyx_rt_build_add(self.mod,
                                     source_len,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                     llvm_mir_empty_name(),
                                     0);
        if (cap_v == null) {
            self.report_error("cannot compute case-conversion capacity");
            return null;
        }
        return self.string_value_from_raw_parts_as_type(raw_out,
                                                        source_len,
                                                        cap_v,
                                                        vyx_rt_const_int(self.mod, self.ty_i64, 4, 0),
                                                        self.m.value_type(value_id));
    }

    public fn lower_string_trim_call(self, value_id: i32) -> rawptr {
        var receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string trim call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string trim receiver is not str ABI");
            return null;
        }
        if (self.builtin_string_trim_fn == null || self.builtin_string_trim_fty == null) {
            self.report_error("string trim declaration is unavailable");
            return null;
        }
        let source_ptr = self.string_cstr_from_value(receiver_id);
        if (source_ptr == null) {
            self.report_error("cannot lower string trim receiver");
            return null;
        }
        let raw_out = vyx_rt_build_call1(self.mod,
                                         self.builtin_string_trim_fty,
                                         self.builtin_string_trim_fn,
                                         source_ptr,
                                         "mir.str.trim".c_str(),
                                         12);
        if (raw_out == null) {
            self.report_error("cannot emit string trim call");
            return null;
        }
        return self.string_value_from_cstr_as_type(raw_out, self.m.value_type(value_id), 3);
    }

    public fn lower_string_replace_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var old_id = self.call_arg_at(value_id, 0);
        var new_id = self.call_arg_at(value_id, 1);
        if (argc == 3) {
            receiver_id = self.call_arg_at(value_id, 0);
            old_id = self.call_arg_at(value_id, 1);
            new_id = self.call_arg_at(value_id, 2);
        } else if (argc != 2) {
            self.report_error("replace requires receiver plus old/new strings");
            return null;
        }
        if (receiver_id == mir_id_invalid()
            || old_id == mir_id_invalid()
            || new_id == mir_id_invalid()) {
            self.report_error("replace call is missing receiver or arguments");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))
            || !self.type_is_string_view_type(self.m.value_type(old_id))
            || !self.type_is_string_view_type(self.m.value_type(new_id))) {
            self.report_error("replace operands must use str ABI");
            return null;
        }
        if (self.builtin_string_replace_fn == null || self.builtin_string_replace_fty == null) {
            self.report_error("string replace declaration is unavailable");
            return null;
        }
        let source_ptr = self.string_cstr_from_value(receiver_id);
        let old_ptr = self.string_cstr_from_value(old_id);
        let new_ptr = self.string_cstr_from_value(new_id);
        if (source_ptr == null || old_ptr == null || new_ptr == null) {
            self.report_error("cannot lower replace string operands");
            return null;
        }
        let raw_out = vyx_rt_build_call3(self.mod,
                                         self.builtin_string_replace_fty,
                                         self.builtin_string_replace_fn,
                                         source_ptr,
                                         old_ptr,
                                         new_ptr,
                                         "mir.str.replace".c_str(),
                                         15);
        if (raw_out == null) {
            self.report_error("cannot emit string replace call");
            return null;
        }
        return self.string_value_from_cstr_as_type(raw_out, self.m.value_type(value_id), 3);
    }

    public fn lower_string_equals_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        if (argc != 1 && argc != 2) {
            self.report_error("string equals requires receiver plus one argument");
            return null;
        }
        var lhs_id = self.receiver_for_builtin_call(value_id);
        var rhs_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            lhs_id = self.call_arg_at(value_id, 0);
            rhs_id = self.call_arg_at(value_id, 1);
        }
        return self.lower_string_equals_parts(lhs_id, rhs_id, false);
    }

    public fn lower_string_ptr_member_call(self, value_id: i32, member_name: string) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error(member_name + " requires a str receiver");
            return null;
        }
        if (self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            return self.string_cstr_from_value(receiver_id);
        }
        return self.lower_record_field_member_value(receiver_id, "ptr");
    }

    public fn field_id_for_type_name(self, type_id: i32, field_name: string) -> i32 {
        if (type_id == mir_id_invalid() || field_name.len == 0) { return mir_id_invalid(); }
        let exact_base = self.exact_field_id_for_type_name(type_id, field_name);
        if (exact_base != mir_id_invalid()) { return exact_base; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let exact_canonical = self.exact_field_id_for_type_name(canonical_type, field_name);
        if (exact_canonical != mir_id_invalid()) { return exact_canonical; }
        var field_id: i32 = 1;
        while (field_id <= self.m.field_count) {
            if (mir_unit_field_name(&self.m, field_id) == field_name) {
                let owner = mir_unit_field_owner_type(&self.m, field_id);
                if (self.field_owner_accepts_base_type(owner, type_id)
                    && self.canonical_record_type_id(owner) == canonical_type) {
                    return field_id;
                }
            }
            field_id = field_id + 1;
        }
        return mir_id_invalid();
    }

    public fn record_field_addr_for_type(self, record_addr: rawptr, type_id: i32, field_name: string) -> rawptr {
        if (record_addr == null || type_id == mir_id_invalid() || field_name.len == 0) { return null; }
        let owner_type = self.canonical_record_type_id(type_id);
        let field_id = self.field_id_for_type_name(owner_type, field_name);
        if (field_id == mir_id_invalid()) {
            self.report_error("cannot resolve field `" + field_name + "` for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var record_ty = self.lower_type(owner_type);
        if (self.type_is_class_pointer_abi(owner_type)) {
            record_ty = self.class_record_storage_ty(owner_type);
        }
        let field_index = mir_unit_field_index(&self.m, field_id);
        if (record_ty == null || field_index < 0) {
            self.report_error("cannot address field `" + field_name + "` for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let field_count = mir_unit_field_count_for_type(&self.m, owner_type);
        if (field_index >= field_count) {
            self.report_error("field `" + field_name + "` index "
                      + policy_i64_to_string(field_index as i64)
                      + " is outside layout "
                      + llvm_mir_type_text(&self.m, owner_type)
                      + " field_count="
                      + policy_i64_to_string(field_count as i64));
            return null;
        }
        let out = vyx_rt_build_gep2(self.mod,
                                    record_ty,
                                    record_addr,
                                    vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                    vyx_rt_const_int(self.mod, self.ty_i32, field_index as i64, 0),
                                    field_name.c_str(),
                                    field_name.len as u64);
        if (out == null) {
            self.report_error("cannot build field address for `" + field_name + "`");
            return null;
        }
        return out;
    }

    public fn lower_record_field_member_value(self, receiver_id: i32, field_name: string) -> rawptr {
        if (receiver_id == mir_id_invalid()) { return null; }
        let receiver_type = self.m.value_type(receiver_id);
        let field_id = self.field_id_for_type_name(receiver_type, field_name);
        if (field_id == mir_id_invalid()) {
            self.report_error("cannot resolve field `" + field_name + "` for " + llvm_mir_type_text(&self.m, receiver_type));
            return null;
        }
        let base_addr = self.lower_self_receiver_address(receiver_id, receiver_type);
        let field_type = mir_unit_field_type(&self.m, field_id);
        let field_ty = self.lower_type(field_type);
        let ptr = self.record_field_addr_for_type(base_addr, receiver_type, field_name);
        if (base_addr == null || field_ty == null || ptr == null) {
            self.report_error("cannot address field `" + field_name + "` for " + llvm_mir_type_text(&self.m, receiver_type));
            return null;
        }
        return vyx_rt_build_load(self.mod, field_ty, ptr, field_name.c_str(), field_name.len as u64);
    }

    public fn lower_tuple_member_value(self, value_id: i32, member_name: string) -> rawptr {
        let receiver_id = self.m.value_lhs(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("tuple member `" + member_name + "` has no receiver");
            return null;
        }
        let tuple_type = self.m.value_type(receiver_id);
        if (llvm_mir_type_kind(&self.m, tuple_type) != ty_TUPLE()) {
            self.report_error("tuple member `" + member_name + "` receiver is not tuple: "
                      + llvm_mir_type_text(&self.m, tuple_type));
            return null;
        }
        let idx = self.tuple_member_index(member_name);
        let elem_count = self.tuple_element_count_for_type(tuple_type);
        if (idx < 0 || idx >= elem_count) {
            self.report_error("tuple member `" + member_name + "` is outside "
                      + llvm_mir_type_text(&self.m, tuple_type)
                      + " element_count="
                      + policy_i64_to_string(elem_count as i64));
            return null;
        }
        let elem_type = self.tuple_element_type_id(tuple_type, idx);
        let tuple_ty = self.lower_type(tuple_type);
        let elem_ty = self.lower_type(elem_type);
        let base_addr = self.lower_self_receiver_address(receiver_id, tuple_type);
        if (idx < 0 || elem_type == mir_id_invalid() || tuple_ty == null || elem_ty == null || base_addr == null) {
            self.report_error("cannot address tuple member `" + member_name + "`");
            return null;
        }
        let elem_ptr = vyx_rt_build_gep2(self.mod,
                                         tuple_ty,
                                         base_addr,
                                         vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                         vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                         member_name.c_str(),
                                         member_name.len as u64);
        if (elem_ptr == null) {
            self.report_error("cannot build tuple member address `" + member_name + "`");
            return null;
        }
        return vyx_rt_build_load(self.mod, elem_ty, elem_ptr, member_name.c_str(), member_name.len as u64);
    }

    public fn lower_std_string_as_str_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let string_type = self.m.value_type(value_id);
        if (!self.type_is_std_string_class(string_type)) {
            self.report_error("value is not std String: " + llvm_mir_type_text(&self.m, string_type));
            return null;
        }
        let base_addr = self.lower_self_receiver_address(value_id, string_type);
        if (base_addr == null) {
            self.report_error("cannot materialize std String receiver");
            return null;
        }
        let ptr_gep = self.record_field_addr_for_type(base_addr, string_type, "ptr");
        let len_gep = self.record_field_addr_for_type(base_addr, string_type, "len");
        let owned_gep = self.record_field_addr_for_type(base_addr, string_type, "owned");
        let inline_gep = self.record_field_addr_for_type(base_addr, string_type, "inline0");
        if (ptr_gep == null || len_gep == null || owned_gep == null || inline_gep == null) {
            self.report_error("cannot address std String fields");
            return null;
        }
        let heap_ptr = vyx_rt_build_load(self.mod,
                                         self.ty_ptr,
                                         ptr_gep,
                                         llvm_mir_empty_name(),
                                         0);
        let len_v = vyx_rt_build_load(self.mod,
                                      self.ty_i64,
                                      len_gep,
                                      llvm_mir_empty_name(),
                                      0);
        let owned_v = vyx_rt_build_load(self.mod,
                                        self.ty_i64,
                                        owned_gep,
                                        llvm_mir_empty_name(),
                                        0);
        let inline_ptr = vyx_rt_build_bitcast(self.mod,
                                              inline_gep,
                                              self.ty_ptr,
                                              "String.inline.ptr".c_str(),
                                              17);
        let is_heap = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        owned_v,
                                        vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                        llvm_mir_empty_name(),
                                        0);
        let data_ptr = vyx_rt_build_select(self.mod,
                                           is_heap,
                                           heap_ptr,
                                           inline_ptr,
                                           "String.borrow.ptr".c_str(),
                                           17);
        if (heap_ptr == null || len_v == null || owned_v == null || inline_ptr == null || is_heap == null || data_ptr == null) {
            self.report_error("cannot lower std String borrowed view");
            return null;
        }
        return self.emit_string_value_from_parts(data_ptr,
                                                  len_v,
                                                  len_v,
                                                  vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn std_string_from_primitive_function(self, dst_type_id: i32) -> i32 {
        if (!self.type_is_std_string_class(dst_type_id)) { return mir_id_invalid(); }
        let dst_canonical = self.canonical_record_type_id(dst_type_id);
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_name_matches_method(self.m.function_name(fn_id), "from")
                && self.function_owner_matches_type(fn_id, dst_canonical)
                && self.function_source_param_count(fn_id) == 1
                && self.type_is_str_abi(self.function_source_param_type(fn_id, 0))
                && self.type_is_std_string_class(self.m.function_return_type(fn_id))) {
                let ret_canonical = self.canonical_record_type_id(self.m.function_return_type(fn_id));
                if (self.type_ids_compatible(ret_canonical, dst_canonical)
                    || self.type_ids_compatible(self.m.function_return_type(fn_id), dst_type_id)) {
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        return mir_id_invalid();
    }

    public fn function_owner_matches_type(self, function_id: i32, type_id: i32) -> bool {
        if (function_id == mir_id_invalid() || type_id == mir_id_invalid()) { return false; }
        let owner_text = self.m.function_owner_type(function_id);
        if (owner_text.len == 0) { return false; }
        let owner_type = self.type_id_by_text(owner_text);
        if (owner_type == mir_id_invalid()) { return false; }
        return self.type_ids_compatible(self.canonical_record_type_id(owner_type),
                                        self.canonical_record_type_id(type_id));
    }

    public fn lower_static_one_arg_call(self, target_fn: i32, arg_id: i32, result_name: string) -> rawptr {
        if (target_fn == mir_id_invalid() || arg_id == mir_id_invalid()) { return null; }
        let param_type = self.function_source_param_type(target_fn, 0);
        if (param_type == mir_id_invalid()) {
            self.report_error("cannot resolve parameter type for " + self.m.function_name(target_fn));
            return null;
        }
        let arg_value = self.lower_value_as(arg_id, param_type);
        if (arg_value == null) {
            self.report_error("cannot lower argument for " + self.m.function_name(target_fn));
            return null;
        }
        return self.lower_static_one_arg_raw_call(target_fn, arg_value, param_type, result_name);
    }

    public fn lower_static_one_arg_raw_call(self,
                                           target_fn: i32,
                                           arg_value: rawptr,
                                           arg_type: i32,
                                           result_name: string) -> rawptr {
        if (target_fn == mir_id_invalid() || arg_value == null || arg_type == mir_id_invalid()) { return null; }
        if (!self.declare_function_signature(target_fn)) {
            self.report_error("cannot declare function " + self.m.function_name(target_fn));
            return null;
        }
        let fn_value = llvm_mir_map_get(self.function_values, target_fn);
        let fn_type = llvm_mir_map_get(self.function_types, target_fn);
        if (fn_value == null || fn_type == null) {
            self.report_error("cannot resolve function " + self.m.function_name(target_fn));
            return null;
        }
        let param_type = self.function_source_param_type(target_fn, 0);
        if (param_type == mir_id_invalid()) {
            self.report_error("cannot resolve parameter type for " + self.m.function_name(target_fn));
            return null;
        }
        let cast_arg = self.cast_value(arg_value, arg_type, param_type);
        if (cast_arg == null) {
            self.report_error("cannot lower raw argument for " + self.m.function_name(target_fn));
            return null;
        }
        let uses_sret = self.function_uses_hidden_sret(target_fn);
        var argc: i32 = 1;
        if (uses_sret) { argc = 2; }
        if (self.function_llvm_param_count(target_fn) != argc) {
            self.report_error("unexpected ABI parameter count for " + self.m.function_name(target_fn));
            return null;
        }
        let args = malloc((argc * 8) as u64);
        if (args == null) {
            self.report_error("cannot allocate call argument for " + self.m.function_name(target_fn));
            return null;
        }
        var sret_slot: rawptr = null;
        if (uses_sret) {
            let return_type = self.m.function_return_type(target_fn);
            let storage_type = self.lower_storage_type(return_type);
            if (storage_type == null) {
                free(args);
                self.report_error("cannot lower return storage for " + self.m.function_name(target_fn));
                return null;
            }
            sret_slot = vyx_rt_build_alloca(self.mod,
                                            storage_type,
                                            "mir.std.string.sret".c_str(),
                                            19);
            if (sret_slot == null) {
                free(args);
                self.report_error("cannot allocate return storage for " + self.m.function_name(target_fn)
                          + ": " + self.runtime_last_error());
                return null;
            }
            let alignment = self.native_aggregate_align_bytes(return_type);
            if (alignment > 0) { vyx_rt_set_alignment(self.mod, sret_slot, alignment as i32); }
            ast_write_rawptr(args, sret_slot);
            ast_write_rawptr(ptr_offset(args, 8), cast_arg);
        } else {
            ast_write_rawptr(args, cast_arg);
        }
        var call_name = result_name;
        if (uses_sret) { call_name = ""; }
        var out = self.build_abi_call(fn_type, fn_value, args, argc as u64, call_name, target_fn);
        if (out != null && !self.apply_dci_callsite_abi_attrs(target_fn, out)) { out = null; }
        if (out != null && !self.apply_native_c_aggregate_abi_attrs(target_fn, out)) { out = null; }
        free(args);
        if (out == null) {
            self.report_error("cannot build call to " + self.m.function_name(target_fn)
                      + ": " + self.runtime_last_error());
            return null;
        }
        if (uses_sret) {
            let return_type = self.m.function_return_type(target_fn);
            let value_type = self.lower_type(return_type);
            if (value_type == null) {
                self.report_error("cannot lower return type for " + self.m.function_name(target_fn));
                return null;
            }
            out = vyx_rt_build_load(self.mod,
                                    value_type,
                                    sret_slot,
                                    result_name.c_str(),
                                    result_name.len as u64);
            if (out == null) {
                self.report_error("cannot load result of " + self.m.function_name(target_fn)
                          + ": " + self.runtime_last_error());
            }
        }
        return out;
    }

    public fn lower_str_raw_to_std_string_value(self, str_value: rawptr, dst_type_id: i32) -> rawptr {
        if (str_value == null || dst_type_id == mir_id_invalid()) { return null; }
        let from_fn = self.std_string_from_primitive_function(dst_type_id);
        if (from_fn == mir_id_invalid()) {
            self.report_error("converting str to std String requires std.string.String.from");
            return null;
        }
        let str_type = self.type_id_by_text("str");
        if (str_type == mir_id_invalid()) {
            self.report_error("cannot resolve canonical str type for std String conversion");
            return null;
        }
        return self.lower_static_one_arg_raw_call(from_fn,
                                                  str_value,
                                                  str_type,
                                                  "mir.std.string.from");
    }

    public fn lower_str_to_std_string_value(self, value_id: i32, dst_type_id: i32) -> rawptr {
        if (value_id == mir_id_invalid() || dst_type_id == mir_id_invalid()) { return null; }
        let from_fn = self.std_string_from_primitive_function(dst_type_id);
        if (from_fn == mir_id_invalid()) {
            self.report_error("converting str to std String requires std.string.String.from");
            return null;
        }
        return self.lower_static_one_arg_call(from_fn, value_id, "mir.std.string.from");
    }

    public fn lower_string_view_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let ty = self.m.value_type(value_id);
        if (self.type_is_str_abi(ty)) { return self.lower_value(value_id); }
        let kind = llvm_mir_type_kind(&self.m, ty);
        if ((kind == ty_REF() || kind == ty_MUTREF())
            && self.type_is_str_abi(hir_type_table_elem(self.m.types, ty))) {
            return self.reference_value_to_string(value_id, ty);
        }
        if (self.type_is_std_string_class(ty)) { return self.lower_std_string_as_str_value(value_id); }
        self.report_error("value is not string-view compatible: " + llvm_mir_type_text(&self.m, ty));
        return null;
    }

    public fn lower_string_field_member_value(self, value_id: i32, member_name: string) -> rawptr {
        let receiver_id = self.receiver_for_builtin_member_value(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error(member_name + " requires a str receiver");
            return null;
        }
        if (self.type_is_std_string_class(self.m.value_type(receiver_id))) {
            if (member_name == "ptr" || member_name == "c_str" || member_name == "data") {
                return self.string_cstr_from_value(receiver_id);
            }
            if (member_name == "len" || member_name == "length" || member_name == "size" || member_name == "count") {
                return self.string_len_from_value(receiver_id);
            }
            if (member_name == "cap" || member_name == "owned") {
                return self.lower_record_field_member_value(receiver_id, member_name);
            }
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            return self.lower_record_field_member_value(receiver_id, member_name);
        }
        let value = self.lower_string_view_value(receiver_id);
        if (value == null) {
            self.report_error("cannot lower str receiver for member " + member_name);
            return null;
        }
        if (member_name == "ptr" || member_name == "c_str" || member_name == "data") { return self.string_ptr_value(value); }
        if (member_name == "len" || member_name == "length" || member_name == "size" || member_name == "count") { return self.string_len_value(value); }
        if (member_name == "cap") { return self.string_cap_value(value); }
        if (member_name == "owned") { return self.string_owned_value(value); }
        self.report_error("unknown str member " + member_name);
        return null;
    }

    public fn lower_string_clone_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string clone requires a receiver");
            return null;
        }
        // `Clone<str>` is an ownership operation, not a borrowed view.
        // Use the additive length-aware runtime ABI rather than the legacy
        // bootstrap clone ABI: the latter may return shared or arena storage
        // that old compiler generations consume under a different contract.
        let source = self.lower_string_view_value(receiver_id);
        if (source == null) {
            self.report_error("cannot lower string clone receiver");
            return null;
        }
        let source_ptr = self.string_ptr_value(source);
        let source_len = self.string_len_value(source);
        if (source_ptr == null || source_len == null) {
            self.report_error("cannot extract string clone receiver bytes");
            return null;
        }
        if (self.builtin_string_clone_fn == null || self.builtin_string_clone_fty == null) {
            self.report_error("length-aware string clone declaration is unavailable");
            return null;
        }
        // The allocation and the eventual owned==3 release both execute in
        // vyx_rt. This avoids Windows JIT CRT-domain mismatches between an IR
        // malloc/free pair and runtime-produced string values.
        let copy = vyx_rt_build_call2(self.mod,
                                      self.builtin_string_clone_fty,
                                      self.builtin_string_clone_fn,
                                      source_ptr,
                                      source_len,
                                      "mir.str.clone".c_str(),
                                      13);
        let cap = vyx_rt_build_add(self.mod,
                                   source_len,
                                   vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                   llvm_mir_empty_name(),
                                   0);
        if (copy == null || cap == null) {
            self.report_error("cannot allocate string clone result");
            return null;
        }
        return self.emit_string_value_from_parts(copy,
                                                 source_len,
                                                 cap,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 3, 0));
    }

    public fn lower_string_repeat_call(self, value_id: i32) -> rawptr {
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable for string repeat");
            return null;
        }
        let argc = self.call_arg_count(value_id);
        if (argc != 1 && argc != 2) {
            self.report_error("repeat requires receiver plus count");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var count_id = self.call_arg_at(value_id, 0);
        if (argc == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            count_id = self.call_arg_at(value_id, 1);
        }
        if (receiver_id == mir_id_invalid() || count_id == mir_id_invalid()) {
            self.report_error("repeat call is missing receiver or count");
            return null;
        }
        let s_value = self.lower_string_view_value(receiver_id);
        let s_ptr = self.string_ptr_value(s_value);
        let s_len = self.string_len_value(s_value);
        let raw_count = self.int_value_to_bits(self.lower_value(count_id), self.m.value_type(count_id), 64);
        let zero = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let count_positive = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_sgt(),
                                               raw_count,
                                               zero,
                                               llvm_mir_empty_name(),
                                               0);
        let safe_count = vyx_rt_build_select(self.mod,
                                             count_positive,
                                             raw_count,
                                             zero,
                                             "mir.str.repeat.count".c_str(),
                                             20);
        let total_len = vyx_rt_build_mul(self.mod,
                                         s_len,
                                         safe_count,
                                         "mir.str.repeat.len".c_str(),
                                         18);
        let out_data = self.alloc_string_data_for_len(total_len);
        if (s_value == null || s_ptr == null || s_len == null || raw_count == null
            || count_positive == null || safe_count == null || total_len == null || out_data == null) {
            self.report_error("cannot lower repeat operands");
            return null;
        }
        let i_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.str.repeat.i".c_str(), 16);
        let off_slot = vyx_rt_build_alloca(self.mod, self.ty_i64, "mir.str.repeat.off".c_str(), 18);
        if (i_slot == null || off_slot == null) {
            self.report_error("cannot allocate repeat loop slots");
            return null;
        }
        vyx_rt_build_store(self.mod, zero, i_slot);
        vyx_rt_build_store(self.mod, zero, off_slot);
        let cond_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.cond".c_str(),
                                          19);
        let body_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.body".c_str(),
                                          19);
        let done_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          "mir.str.repeat.done".c_str(),
                                          19);
        if (cond_bb == null || body_bb == null || done_bb == null) {
            self.report_error("cannot create repeat loop blocks");
            return null;
        }
        vyx_rt_build_br(self.mod, cond_bb);

        vyx_rt_position_at_end(self.mod, cond_bb);
        let i_cur = vyx_rt_build_load(self.mod, self.ty_i64, i_slot, "mir.str.repeat.i".c_str(), 16);
        let keep_going = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_slt(),
                                           i_cur,
                                           safe_count,
                                           llvm_mir_empty_name(),
                                           0);
        if (i_cur == null || keep_going == null) {
            self.report_error("cannot lower repeat loop condition");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, keep_going, body_bb, done_bb);

        vyx_rt_position_at_end(self.mod, body_bb);
        let off_cur = vyx_rt_build_load(self.mod, self.ty_i64, off_slot, "mir.str.repeat.off".c_str(), 18);
        let dst = self.ptr_offset_bytes(out_data, off_cur, "mir.str.repeat.dst");
        let copied = vyx_rt_build_call3(self.mod,
                                        self.builtin_memcpy_fty,
                                        self.builtin_memcpy_fn,
                                        dst,
                                        s_ptr,
                                        s_len,
                                        llvm_mir_empty_name(),
                                        0);
        let next_off = vyx_rt_build_add(self.mod, off_cur, s_len, llvm_mir_empty_name(), 0);
        let next_i = vyx_rt_build_add(self.mod,
                                      i_cur,
                                      vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                      llvm_mir_empty_name(),
                                      0);
        if (off_cur == null || dst == null || copied == null || next_off == null || next_i == null) {
            self.report_error("cannot lower repeat loop body");
            return null;
        }
        vyx_rt_build_store(self.mod, next_off, off_slot);
        vyx_rt_build_store(self.mod, next_i, i_slot);
        vyx_rt_build_br(self.mod, cond_bb);

        vyx_rt_position_at_end(self.mod, done_bb);
        let cap_v = vyx_rt_build_add(self.mod,
                                     total_len,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        if (cap_v == null) {
            self.report_error("cannot compute repeat result capacity");
            return null;
        }
        return self.emit_string_value_from_parts(out_data,
                                                 total_len,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_int_to_string_runtime_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("int_to_string requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let arg_value = self.int_value_to_bits(self.lower_value(arg_id), self.m.value_type(arg_id), 64);
        if (arg_value == null) {
            self.report_error("cannot lower int_to_string argument");
            return null;
        }
        return self.string_value_from_i64_to_string(arg_value);
    }

