        if (self.field_remap_cache != null) { llvm_mir_id_map_dispose(self.field_remap_cache); self.field_remap_cache = null; }
        if (self.dci_stub_factory_values != null) { llvm_mir_id_map_dispose(self.dci_stub_factory_values); self.dci_stub_factory_values = null; }
        if (self.dci_stub_destroy_values != null) { llvm_mir_id_map_dispose(self.dci_stub_destroy_values); self.dci_stub_destroy_values = null; }
        if (self.dci_layout_by_type_cache != null) { llvm_mir_id_map_dispose(self.dci_layout_by_type_cache); self.dci_layout_by_type_cache = null; }
        if (self.dci_record_name_cache != null) { llvm_mir_id_map_dispose(self.dci_record_name_cache); self.dci_record_name_cache = null; }
        // The slot array only holds borrowed cJSON object pointers; the objects
        // themselves belong to the derived-layout cache.
        if (self.dci_local_layout_slots != null) { free(self.dci_local_layout_slots); self.dci_local_layout_slots = null; }
        self.dci_local_layout_count = 0;
        if (self.dci_symbol_name_cache != null) { llvm_mir_id_map_dispose(self.dci_symbol_name_cache); self.dci_symbol_name_cache = null; }
        if (self.function_mangled_name_cache != null) { llvm_mir_id_map_dispose(self.function_mangled_name_cache); self.function_mangled_name_cache = null; }
    }

    public fn diagnostic_loc_for_value(self, value_id: i32) -> rawptr {
        return mir_unit_diag_loc_for_value(&self.m, value_id);
    }

    public fn diagnostic_loc(self) -> rawptr {
        var loc = mir_unit_diag_loc_for_instr(&self.m, self.current_instr_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_value(&self.m, self.current_value_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_place(&self.m, self.current_place_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_block(&self.m, self.current_block_id);
        if (loc != null) { return loc; }
        loc = mir_unit_diag_loc_for_function(&self.m, self.current_function_id);
        if (loc != null) { return loc; }
        return mir_unit_diag_first_loc(&self.m);
    }

    public fn report_error_at(self, loc: rawptr, msg: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        var anchor = loc;
        if (anchor == null || ast_read_i32(anchor) <= 0) { anchor = self.diagnostic_loc(); }
        diag_emit_codegen_at(anchor, text + msg);
    }

    public fn report_error(self, msg: string) {
        self.report_error_at(null, msg);
    }

    public fn report_error_at_value(self, value_id: i32, msg: string) {
        self.report_error_at(self.diagnostic_loc_for_value(value_id), msg);
    }

    /// A capability boundary rather than an internal invariant failure: the
    /// descriptor asks for an alignment this backend's foreign-value layout has
    /// no anchor type for.  Reported under its own code so the help text can
    /// say what *is* supported instead of telling the user to file a compiler
    /// bug (which is what the generic codegen code does).
    public fn report_unsupported_alignment(self, alignment: i64, type_text: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        var anchor = self.diagnostic_loc();
        if (anchor != null && ast_read_i32(anchor) <= 0) { anchor = null; }
        diag_emit_at(diag_sev_ERROR(),
                     diag_code_codegen_unsupported(),
                     anchor,
                     text + "foreign value layout alignment " + alignment.toString()
                     + " is not supported for " + type_text);
    }

    public fn report_unresolved_direct_call(self,
                                            value_id: i32,
                                            target_fn: i32,
                                            declaration_ok: bool) {
        let label = self.call_value_label(value_id);
        if (target_fn == mir_id_invalid()
            || target_fn < 1
            || target_fn > self.m.function_count) {
            self.report_error_at_value(value_id,
                                       "cannot call `" + label
                                       + "`: no callable function was selected"
                                       + self.call_value_context(value_id)
                                       + self.value_debug_suffix(value_id));
            return;
        }
        var reason = "the selected function could not be materialized";
        if (!declaration_ok && self.function_has_open_template_types(target_fn)) {
            reason = "the selected generic function still contains unbound template types";
        } else if (!declaration_ok) {
            reason = "the selected function has no declarable ABI signature";
        }
        let loc = self.diagnostic_loc_for_value(value_id);
        self.report_error_at_value(value_id,
                                   "cannot call `" + label + "`: " + reason
                                   + self.call_value_context(value_id)
                                   + self.value_debug_suffix(value_id));
        diag_emit_codegen_note_at(loc,
                                  "selected candidate: "
                                  + self.function_visible_signature(target_fn));
        let generic_params = mir_unit_function_generic_params(&self.m, target_fn);
        let generic_args = mir_unit_function_generic_args(&self.m, target_fn);
        if (generic_params.len > 0 || generic_args.len > 0) {
            diag_emit_codegen_note_at(loc,
                                      "generic substitution: `" + generic_params
                                      + "` => `" + generic_args + "`");
        }
    }

    public fn function_visible_param_count(self, function_id: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        var count: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (mir_unit_local_is_source_param(&self.m, local)
                && !mir_unit_local_is_self_receiver_param(&self.m, local)) {
                count = count + 1;
            }
            local = self.m.local_next(local);
        }
        return count;
    }

    public fn function_visible_signature(self, function_id: i32) -> string {
        if (function_id < 1 || function_id > self.m.function_count) {
            return "fn <unknown>()";
        }
        var out = "fn " + self.m.function_name(function_id) + "(";
        var first = true;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (mir_unit_local_is_source_param(&self.m, local)
                && !mir_unit_local_is_self_receiver_param(&self.m, local)) {
                if (!first) { out = out + ", "; }
                var param_name = self.m.local_name(local);
                if (param_name.len == 0) { param_name = "_"; }
                out = out + param_name + ": "
                    + llvm_mir_type_text(&self.m, self.m.local_type(local));
                first = false;
            }
            local = self.m.local_next(local);
        }
        out = out + ") -> "
            + llvm_mir_type_text(&self.m, self.m.function_return_type(function_id));
        return out;
    }

    public fn direct_call_same_name_candidate_count(self,
                                                    function_id: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        let name = self.m.function_name(function_id);
        var count: i32 = 0;
        var candidate: i32 = 1;
        while (candidate <= self.m.function_count) {
            if (self.m.function_name(candidate) == name) { count = count + 1; }
            candidate = candidate + 1;
        }
        return count;
    }

    public fn direct_call_matching_arity_candidate_count(self,
                                                         function_id: i32,
                                                         argc: i32) -> i32 {
        if (function_id < 1 || function_id > self.m.function_count) { return 0; }
        let name = self.m.function_name(function_id);
        var count: i32 = 0;
        var candidate: i32 = 1;
        while (candidate <= self.m.function_count) {
            if (self.m.function_name(candidate) == name
                && self.function_visible_param_count(candidate) == argc) {
                count = count + 1;
            }
            candidate = candidate + 1;
        }
        return count;
    }

    public fn report_direct_call_arity_error(self,
                                             value_id: i32,
                                             function_id: i32,
                                             argc: i32) {
        let expected = self.function_visible_param_count(function_id);
        let candidate_count = self.direct_call_same_name_candidate_count(function_id);
        let matching_count = self.direct_call_matching_arity_candidate_count(function_id,
                                                                              argc);
        var message = "no matching overload for call to '"
            + self.m.function_name(function_id) + "': "
            + policy_i64_to_string(argc as i64) + " argument";
        if (argc != 1) { message = message + "s"; }
        message = message + " provided; ";
        if (candidate_count <= 1) {
            message = message + "the only candidate requires ";
        } else {
            message = message + "the selected candidate requires ";
        }
        message = message + policy_i64_to_string(expected as i64) + " argument";
        if (expected != 1) { message = message + "s"; }
        if (matching_count == 0 && candidate_count > 1) {
            message = message + "; no other candidate accepts "
                + policy_i64_to_string(argc as i64) + " argument";
            if (argc != 1) { message = message + "s"; }
        }
        message = message + "; candidate: "
            + self.function_visible_signature(function_id);
        self.report_error_at_value(value_id, message);
    }

    public fn report_error_with_context(self, msg: string, context: string) {
        self.error_count = self.error_count + 1;
        var text = "";
        if (self.current_function_id != mir_id_invalid() && vyx_bootstrap_profile_level() > 0) {
            text = "while generating `" + self.m.function_name(self.current_function_id) + "`: ";
        }
        if (context.len > 0) {
            text = text + msg + " (" + context + ")";
        } else {
            text = text + msg;
        }
        diag_emit_codegen_at(self.diagnostic_loc(), text);
    }

    public fn value_debug_suffix(self, value_id: i32) -> string {
        if (vyx_bootstrap_profile_level() <= 0) { return ""; }
        if (value_id == mir_id_invalid()) { return ""; }
        return " [value #" + policy_i64_to_string(value_id as i64) + "]";
    }

    public fn call_value_label(self, value_id: i32) -> string {
        if (value_id == mir_id_invalid()) { return "<unknown>"; }
        var label = self.m.value_name(value_id);
        if (label.len == 0) {
            let callee_id = self.m.value_lhs(value_id);
            if (callee_id != mir_id_invalid()) {
                label = self.m.value_name(callee_id);
            }
        }
        if (label.len == 0) { label = "<unknown>"; }
        return label;
    }

    public fn call_value_context(self, value_id: i32) -> string {
        if (value_id == mir_id_invalid()) { return ""; }
        let text = self.m.value_text(value_id);
        if (text.len == 0) { return ""; }
        return " (" + text + ")";
    }

    public fn release_temp_strings(self, mark: rawptr) {
        vyx_rt_string_arena_release(mark);
    }

    public fn memory_mb_text(self, bytes: i64) -> string {
        if (bytes < 0) { return "-1"; }
        return policy_i64_to_string(bytes / 1048576);
    }

    public fn runtime_last_error(self) -> string {
        if (self.mod == null) { return ""; }
        let buf = malloc(4096);
        if (buf == null) { return ""; }
        let n = vyx_rt_get_last_error(self.mod, buf, 4096);
        var out = "";
        if (n > 0) { out = from_cstr_len(buf, n as i64); }
        free(buf);
        return out;
    }

    public fn int_type_for_bits(self, bits: i32) -> rawptr {
        if (bits <= 1) { return self.ty_i1; }
        if (bits <= 8) { return self.ty_i8; }
        if (bits <= 16) { return self.ty_i16; }
        if (bits <= 32) { return self.ty_i32; }
        return self.ty_i64;
    }

    public fn nonnegative_i64_text(self, text: string) -> bool {
        let clean = self.trim_type_text(text);
        if (clean.len == 0) { return false; }
        var i: i32 = 0;
        while (i < clean.len) {
            let ch = clean.charAt(i);
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    public fn parse_nonnegative_i64(self, text: string) -> i64 {
        let clean = self.trim_type_text(text);
        if (!self.nonnegative_i64_text(clean)) { return -1; }
        var out: i64 = 0;
        var i: i32 = 0;
        while (i < clean.len) {
            let ch = clean.charAt(i);
            out = out * 10 + ((ch - 48) as i64);
            i = i + 1;
        }
        return out;
    }

    public fn array_length_from_type_text(self, text: string) -> i64 {
        let clean = self.trim_type_text(text);
        if (clean.len < 4) { return -1; }
        if (clean.charAt(0) != 91 || clean.charAt(clean.len - 1) != 93) { return -1; }
        var bracket_depth: i32 = 0;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                bracket_depth = bracket_depth + 1;
            } else if (ch == 93) {
                if (bracket_depth > 0) { bracket_depth = bracket_depth - 1; }
            } else if (ch == 60) {
                angle_depth = angle_depth + 1;
            } else if (ch == 62) {
                if (!(i > 0 && clean.charAt(i - 1) == 45) && angle_depth > 0) {
                    angle_depth = angle_depth - 1;
                }
            } else if (ch == 40) {
                paren_depth = paren_depth + 1;
            } else if (ch == 41) {
                if (paren_depth > 0) { paren_depth = paren_depth - 1; }
            } else if (ch == 59
                       && bracket_depth == 0
                       && angle_depth == 0
                       && paren_depth == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1 || split >= clean.len - 2) { return -1; }
        var len_text = self.trim_type_text(clean.substring(split + 1, clean.len - 1));
        if (len_text.len >= 2
            && len_text.charAt(0) == 40
            && len_text.charAt(len_text.len - 1) == 41) {
            len_text = self.trim_type_text(len_text.substring(1, len_text.len - 1));
        }
        return self.parse_nonnegative_i64(len_text);
    }

    public fn array_length_for_type(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return -1; }
        return self.array_length_from_type_text(llvm_mir_type_text(&self.m, type_id));
    }

    /// Element text of an array type text like "[i32;c#83#r]" → "i32".
    public fn rtarray_elem_text_from_type_text(self, text: string) -> string {
        let clean = self.trim_type_text(text);
        if (clean.len < 4) { return ""; }
        if (clean.charAt(0) != 91 || clean.charAt(clean.len - 1) != 93) { return ""; }
        var bracket_depth: i32 = 0;
        var angle_depth: i32 = 0;
        var paren_depth: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                bracket_depth = bracket_depth + 1;
            } else if (ch == 93) {
                if (bracket_depth > 0) { bracket_depth = bracket_depth - 1; }
            } else if (ch == 60) {
                angle_depth = angle_depth + 1;
            } else if (ch == 62) {
                if (!(i > 0 && clean.charAt(i - 1) == 45) && angle_depth > 0) {
                    angle_depth = angle_depth - 1;
                }
            } else if (ch == 40) {
                paren_depth = paren_depth + 1;
            } else if (ch == 41) {
                if (paren_depth > 0) { paren_depth = paren_depth - 1; }
            } else if (ch == 59
                       && bracket_depth == 0
                       && angle_depth == 0
                       && paren_depth == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1) { return ""; }
        return self.trim_type_text(clean.substring(1, split));
    }

    /// MIR type id for the element of a runtime-length array type text.
    /// The textually-interned payload class carries no elem link, so derive
    /// the element from the spelling.
    public fn rtarray_elem_type_id_from_text(self, text: string) -> i32 {
        let elem_text = self.rtarray_elem_text_from_type_text(text);
        if (elem_text.len == 0) { return mir_id_invalid(); }
        if (elem_text == "i8") { return self.m.types.intern_type_ref(tref_alloc(ty_I8(), "")); }
        if (elem_text == "i16") { return self.m.types.intern_type_ref(tref_alloc(ty_I16(), "")); }
        if (elem_text == "i32") { return self.m.types.intern_type_ref(tref_alloc(ty_I32(), "")); }
        if (elem_text == "i64") { return self.m.types.intern_type_ref(tref_alloc(ty_I64(), "")); }
        if (elem_text == "u8") { return self.m.types.intern_type_ref(tref_alloc(ty_U8(), "")); }
        if (elem_text == "u16") { return self.m.types.intern_type_ref(tref_alloc(ty_U16(), "")); }
        if (elem_text == "u32") { return self.m.types.intern_type_ref(tref_alloc(ty_U32(), "")); }
        if (elem_text == "u64") { return self.m.types.intern_type_ref(tref_alloc(ty_U64(), "")); }
        if (elem_text == "isize") { return self.m.types.intern_type_ref(tref_alloc(ty_ISIZE(), "")); }
        if (elem_text == "usize") { return self.m.types.intern_type_ref(tref_alloc(ty_USIZE(), "")); }
        if (elem_text == "f32") { return self.m.types.intern_type_ref(tref_alloc(ty_F32(), "")); }
        if (elem_text == "f64") { return self.m.types.intern_type_ref(tref_alloc(ty_F64(), "")); }
        if (elem_text == "bool") { return self.m.types.intern_type_ref(tref_alloc(ty_BOOL(), "")); }
        if (elem_text == "char") { return self.m.types.intern_type_ref(tref_alloc(ty_CHAR(), "")); }
        if (elem_text == "str" || elem_text == "string") { return self.m.types.intern_type_ref(tref_alloc(ty_STRING(), "")); }
        if (elem_text == "rawptr") { return self.m.types.intern_type_ref(tref_alloc(ty_RAWPTR(), "")); }
        return self.m.types.intern_type_ref(tref_alloc(ty_CLASS(), elem_text));
    }

    public fn tuple_member_index(self, name: string) -> i32 {
        if (name.len == 0) { return -1; }
        var i: i32 = 0;
        if (name.charAt(0) == 95) { i = 1; }
        if (i >= name.len) { return -1; }
        var out: i32 = 0;
        while (i < name.len) {
            let c = name.charAt(i);
            if (c < 48 || c > 57) { return -1; }
            out = out * 10 + (c - 48);
            i = i + 1;
        }
        return out;
    }

    public fn tuple_element_count_for_type(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid() || llvm_mir_type_kind(&self.m, type_id) != ty_TUPLE()) { return 0; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) { return 0; }
        let inner = text.substring(1, text.len - 1);
        var count: i32 = 0;
        while (count < 256) {
            let part = policy_generic_arg_at(inner, count);
            if (part.len == 0) { return count; }
            count = count + 1;
        }
        return count;
    }

    public fn tuple_element_type_id(self, type_id: i32, index: i32) -> i32 {
        if (type_id == mir_id_invalid() || index < 0 || llvm_mir_type_kind(&self.m, type_id) != ty_TUPLE()) {
            return mir_id_invalid();
        }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) {
            return mir_id_invalid();
        }
        let inner = text.substring(1, text.len - 1);
        let elem_text = policy_generic_arg_at(inner, index);
        if (elem_text.len == 0) { return mir_id_invalid(); }
        return self.type_id_for_resolved_text(self.current_function_id, elem_text);
    }

    public fn type_text_base_is_qualified(self, text: string) -> bool {
        let base = policy_generic_call_base(text.clone());
        var i: i32 = 0;
        while (i < base.len) {
            if (base.charAt(i) == 46) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn type_text_is_unqualified_name(self, name: string) -> bool {
        var i: i32 = 0;
        while (i < name.len) {
            if (name.charAt(i) == 46) { return false; }
            i = i + 1;
        }
        return name.len > 0;
    }

    public fn type_text_equivalent_at_depth(self, lhs: string, rhs: string, depth: i32) -> bool {
        if (lhs.len == 0 || rhs.len == 0 || depth > 64) { return false; }
        let left = self.normalize_type_text(lhs);
        let right = self.normalize_type_text(rhs);
        if (left == right) { return true; }
        let left_has_args = policy_generic_call_has_args(left.clone()) != 0;
        let right_has_args = policy_generic_call_has_args(right.clone()) != 0;
        if (left_has_args != right_has_args) { return false; }
        if (!left_has_args) {
            return policy_type_name_equal(left, right);
        }
        let left_base = policy_generic_call_base(left.clone());
        let right_base = policy_generic_call_base(right.clone());
        if (!self.type_text_equivalent_at_depth(left_base, right_base, depth + 1)) { return false; }
        let left_args = policy_generic_call_args(left.clone());
        let right_args = policy_generic_call_args(right.clone());
        var idx: i32 = 0;
        while (idx < 64) {
            let left_arg = policy_generic_arg_at(left_args, idx);
            let right_arg = policy_generic_arg_at(right_args, idx);
            if (left_arg.len == 0 || right_arg.len == 0) {
                return left_arg.len == 0 && right_arg.len == 0;
            }
            if (!self.type_text_equivalent_at_depth(left_arg, right_arg, depth + 1)) { return false; }
            idx = idx + 1;
        }
        return false;
    }

    public fn type_text_equivalent(self, lhs: string, rhs: string) -> bool {
        return self.type_text_equivalent_at_depth(lhs, rhs, 0);
    }

    public fn record_layout_fields_are_closed(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let field_count = mir_unit_field_count_for_type(&self.m, type_id);
        if (field_count <= 0) { return false; }
        var idx: i32 = 0;
        while (idx < field_count) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, idx);
            if (field_id == mir_id_invalid()) { return false; }
            let field_type_text = llvm_mir_type_text(&self.m, mir_unit_field_type(&self.m, field_id));
            if (llvm_mir_type_name_has_open_template_atom(field_type_text)) { return false; }
            idx = idx + 1;
        }
        return true;
    }

    public fn closed_template_layout_for_generic_instance(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return mir_id_invalid(); }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0 || policy_generic_call_has_args(text.clone()) == 0) { return mir_id_invalid(); }
        let base = policy_generic_call_base(text.clone());
        // Pass 1 — exact (module-qualifier included) spelling match. This is
        // what legitimately folds `t.Vec::<i32>` onto the `t.Vec` entry.
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && policy_type_name_equal_qualified(base, llvm_mir_type_text(&self.m, id))
                && self.record_layout_fields_are_closed(id)) {
                return id;
            }
            id = id + 1;
        }
        // Pass 2 — last-dotted-segment fold, kept only for the qualified vs
        // unqualified spelling gap (`t.Vec` vs `Vec`). It must NOT be used to
        // guess between genuinely different records: nested records share
        // their leaf name by construction (`Holder.Inner` / `Zolder.Inner`),
        // so a non-unique outcome means the fold is ambiguous and borrowing
        // either layout would mis-type the fields. Bail out instead.
        var unique: i32 = mir_id_invalid();
        id = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && self.type_text_equivalent(base, llvm_mir_type_text(&self.m, id))
                && self.record_layout_fields_are_closed(id)) {
                if (unique != mir_id_invalid()) { return mir_id_invalid(); }
                unique = id;
            }
            id = id + 1;
        }
        return unique;
    }

    public fn canonical_record_type_id(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return type_id; }
        let cached = llvm_mir_i32_map_get(self.canonical_type_cache, type_id);
        if (cached != 0) { return cached; }
        var result = type_id;
        let raw_kind = llvm_mir_type_kind(&self.m, type_id);
        // Pointer/ref types stay themselves. `&spdlog.details.log_msg` contains
        // `.` so type_text_base_is_qualified is true; folding it onto the CLASS
        // layout made lower_type(REF) a raw pointer / size-align blob, and
        // pointer_handle_address extractvalue then aborted in LLVM.
        if (raw_kind == ty_PTR() || raw_kind == ty_REF() || raw_kind == ty_MUTREF()
            || raw_kind == ty_RAWPTR()
            || raw_kind == ty_FN() || raw_kind == ty_CFN()) {
            // A function-pointer type is never a record: it has no layout to
            // fold onto.  Without this it fell through to the equivalence
            // search below whenever its *text* looked module-qualified
            // (`fn(T.App.A,T.App.B)->T.App.B` contains dots, so
            // `type_text_base_is_qualified` is true) and got collapsed onto an
            // unrelated entry — in practice the return type `B`, which made
            // `lower_type` emit `%mir.struct.T.App.B` for a `fn(...)`
            // parameter.  The signature text (and its mangling) stayed
            // correct, so the damage only showed up as an LLVM verifier
            // failure when the calling unit was emitted separately.
            llvm_mir_i32_map_put(self.canonical_type_cache, type_id, type_id);
            return type_id;
        }
        let kind_is_class = raw_kind == ty_CLASS();
        let text = llvm_mir_type_text(&self.m, type_id);
        // Module-qualified entries (e.g. `gen_industrial.TextR`) may carry a
        // non-CLASS kind while the layout lives on the unqualified CLASS
        // entry; let those fall through to the equivalence search instead of
        // early-returning.
        if (!kind_is_class && !self.type_text_base_is_qualified(text)) { return type_id; }
        if (text.len == 0) { return type_id; }
        // Variant-bearing (enum) types can be registered more than once under
        // text-equivalent spellings (module-qualified vs plain). Collapse all
        // of them onto the smallest-id equivalent entry so enum ABI structs,
        // variant-owner comparisons, and payload layouts share one identity.
        if (kind_is_class && mir_unit_variant_count_for_type(&self.m, type_id) > 0) {
            var vrep: i32 = 1;
            while (vrep < type_id) {
                if (llvm_mir_type_kind(&self.m, vrep) == ty_CLASS()
                    && mir_unit_variant_count_for_type(&self.m, vrep) > 0
                    && self.type_text_equivalent(text, llvm_mir_type_text(&self.m, vrep))) {
                    llvm_mir_i32_map_put(self.canonical_type_cache, type_id, vrep);
                    return vrep;
                }
                vrep = vrep + 1;
            }
        }
        if (mir_unit_field_count_for_type(&self.m, type_id) <= 0) {
            // A fieldless class entry is a forward/import placeholder with no
            // authoritative layout: its own ABI flags are unreliable (a
            // value-struct class referenced via a pointer/import may surface
            // here as a CLASS placeholder that never received
            // hir_type_flag_value_struct).  Prefer a nominal candidate whose
            // value-struct ABI flag matches this entry, but fall back to any
            // complete same-named CLASS layout so a fieldless value-struct
            // placeholder still canonicalizes onto its real declaration
            // instead of reporting field_count=0.
            let placeholder_is_value_struct =
                (hir_type_table_flags(self.m.types, type_id) & hir_type_flag_value_struct()) != 0;
            var nominal_fallback: i32 = mir_id_invalid();
            var id: i32 = 1;
            while (id <= self.m.types.count) {
                if (id != type_id
                    && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                    && mir_unit_field_count_for_type(&self.m, id) > 0
                    && self.type_text_equivalent(text, llvm_mir_type_text(&self.m, id))) {
                    let candidate_is_value_struct =
                        (hir_type_table_flags(self.m.types, id) & hir_type_flag_value_struct()) != 0;
                    if (!kind_is_class || candidate_is_value_struct == placeholder_is_value_struct) {
                        result = id;
                        llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                        return result;
                    }
                    if (nominal_fallback == mir_id_invalid()) { nominal_fallback = id; }
                }
                id = id + 1;
            }
            if (nominal_fallback != mir_id_invalid()) {
                result = nominal_fallback;
                llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                return result;
            }
            // Enums own variants instead of fields: map a variant-less
            // generic enum instance (or qualified alias) onto the
            // variant-bearing equivalent so variant-owner comparisons and
            // payload layouts line up. Generic instances additionally match
            // the argless template entry by base name, mirroring
            // closed_template_layout_for_generic_instance for records.
            if (mir_unit_variant_count_for_type(&self.m, type_id) <= 0) {
                let has_args = policy_generic_call_has_args(text.clone()) != 0;
                let base_text = policy_generic_call_base(text.clone());
                var vid: i32 = 1;
                while (vid <= self.m.types.count) {
                    if (vid != type_id
                        && llvm_mir_type_kind(&self.m, vid) == ty_CLASS()
                        && mir_unit_variant_count_for_type(&self.m, vid) > 0) {
                        let vid_text = llvm_mir_type_text(&self.m, vid);
                        var matches = self.type_text_equivalent(text, vid_text);
                        if (!matches
                            && has_args
                            && policy_generic_call_has_args(vid_text.clone()) == 0
                            && self.type_text_equivalent(base_text, vid_text)) {
                            matches = true;
                        }
                        if (matches) {
                            result = vid;
                            llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
                            return result;
                        }
                    }
                    vid = vid + 1;
                }
            }
        }
        // Borrow a template's layout only when this instance has no usable
        // layout of its own — i.e. its fields still carry open template atoms
        // (or it has none at all). A fully concrete instance must keep its own
        // layout: folding it onto a template merely because the last dotted
        // segment matches is how `A.Inner::<i32,f64>` picked up unrelated
        // `B.Inner`'s i64 field and spilled a double into an integer slot.
        let template_layout = self.closed_template_layout_for_generic_instance(type_id);
        if (template_layout != mir_id_invalid()
            && !self.record_layout_fields_are_closed(type_id)) {
            result = template_layout;
        }
        llvm_mir_i32_map_put(self.canonical_type_cache, type_id, result);
        return result;
    }

    public fn finalize_record_ty_body(self, type_id: i32, st: rawptr, field_count: i32) -> rawptr {
        if (self.dci_type_uses_stable_value_layout(type_id)) {
            let layout = self.dci_layout_object_for_type(type_id);
            let size_bytes = self.dci_json_i64(layout, "size");
            let alignment = self.dci_json_i64(layout, "alignment");
            if (size_bytes == 0) {
                self.report_error("DCI zero-sized value layout requires an unsupported ignore ABI for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (size_bytes < 0 || alignment <= 0 || alignment > size_bytes) {
                self.report_error("invalid DCI value layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var anchor_ty = self.ty_i8;
            if (alignment == 2) { anchor_ty = self.ty_i16; }
            else if (alignment == 4) { anchor_ty = self.ty_i32; }
            else if (alignment == 8) { anchor_ty = self.ty_i64; }
            else if (alignment == 16) { anchor_ty = vyx_rt_int_type(self.mod, 128); }
            else if (alignment == 32) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 4); }
            else if (alignment == 64) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 8); }
            else if (alignment == 128) { anchor_ty = vyx_rt_vector_ty(self.mod, self.ty_i64, 16); }
            else if (alignment != 1) {
                // A capability boundary, not an internal invariant.  The anchor
                // must be a type whose *own* ABI alignment is the record's,
                // because every generic storage path (local slot, load, store,
                // byval/sret default) inherits its alignment from the type
                // rather than from the descriptor.  Integers stop at i128 and
                // an array inherits its element's alignment, so 32 / 64 / 128
                // need a vector anchor; anything else has no anchor at all.
                self.report_unsupported_alignment(alignment,
                                                  llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            if (anchor_ty == null) {
                self.report_error("cannot build DCI value layout anchor for "
                          + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var body_count: i32 = 1;
            if (size_bytes > alignment) { body_count = 2; }
            let body = malloc((body_count * 8) as u64);
            if (body == null) {
                self.report_error("cannot allocate DCI value layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            ast_write_rawptr(body, anchor_ty);
            if (body_count == 2) {
                let tail_ty = vyx_rt_array_ty(self.mod, self.ty_i8, (size_bytes - alignment) as u64);
                if (tail_ty == null) {
                    free(body);
                    self.report_error("cannot create DCI value layout tail for " + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(body, 8), tail_ty);
            }
            if (vyx_rt_struct_ty_set_body(self.mod, st, body, body_count as u64, 0) != 0) {
                free(body);
                self.report_error("cannot finalize DCI value type " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            free(body);
            let measured = vyx_rt_type_alloc_size(self.mod, st);
            if (measured != size_bytes) {
                self.report_error("DCI value layout size mismatch for " + llvm_mir_type_text(&self.m, type_id)
                          + ": descriptor=" + size_bytes.toString()
                          + " llvm=" + measured.toString());
                return null;
            }
            llvm_mir_i32_map_put(self.type_struct_body_field_counts, type_id, body_count + 1);
            return st;
        }
        var fields: rawptr = null;
        var final_field_count = field_count;
        if (self.type_is_foreign_dci(type_id) && final_field_count <= 0) {
            fields = malloc(8);
            if (fields == null) {
                self.report_error("cannot allocate empty external DCI object layout for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            ast_write_rawptr(fields, self.ty_i8);
            final_field_count = 1;
        }
        if (field_count > 0) {
            fields = malloc((field_count * 8) as u64);
            if (fields == null) {
                self.report_error("cannot allocate record field list for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var idx: i32 = 0;
            while (idx < field_count) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, idx);
                if (field_id == mir_id_invalid()) {
                    free(fields);
                    self.report_error("missing field layout for " + llvm_mir_type_text(&self.m, type_id)
                              + " index " + policy_i64_to_string(idx as i64));
                    return null;
                }
                let field_type = mir_unit_field_type(&self.m, field_id);
                let field_ll = self.lower_type(field_type);
                if (field_type == mir_id_invalid() || field_ll == null) {
                    free(fields);
                    self.report_error("cannot lower field layout for " + llvm_mir_type_text(&self.m, type_id)
                              + "." + mir_unit_field_name(&self.m, field_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(fields, idx * 8), field_ll);
                idx = idx + 1;
            }
        }
        var packed_flag: i32 = 0;
        if (self.type_repr_is_packed(type_id)) { packed_flag = 1; }
        var emit_fields = fields;
        var emit_count = final_field_count;
        let want_size = self.value_storage_size_fast(type_id);
        if (want_size > 0 && emit_count >= 0) {
            var laid: i64 = 0;
            var fi: i32 = 0;
            while (fi < field_count) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, type_id, fi);
                if (field_id != mir_id_invalid()) {
                    let ft = mir_unit_field_type(&self.m, field_id);
                    var fa = self.value_storage_align(ft);
                    if (packed_flag != 0) { fa = 1; }
                    if (fa <= 0) { fa = 1; }
                    let fs = self.value_storage_size_fast(ft);
                    if (fs > 0) {
                        laid = self.align_up_i64(laid, fa);
                        laid = laid + fs;
                    }
                }
                fi = fi + 1;
            }
            if (want_size > laid) {
                let pad = (want_size - laid) as u64;
                let pad_ty = vyx_rt_array_ty(self.mod, self.ty_i8, pad);
                if (pad_ty != null) {
                    let grown = malloc(((emit_count + 1) * 8) as u64);
                    if (grown != null) {
                        var copy_i: i32 = 0;
                        while (copy_i < emit_count) {
                            if (fields != null) {
                                ast_write_rawptr(ptr_offset(grown, copy_i * 8),
                                                 ast_read_rawptr(ptr_offset(fields, copy_i * 8)));
                            }
                            copy_i = copy_i + 1;
                        }
                        ast_write_rawptr(ptr_offset(grown, emit_count * 8), pad_ty);
                        if (fields != null) { free(fields); }
                        emit_fields = grown;
                        emit_count = emit_count + 1;
                        fields = grown;
                    }
                }
            }
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, emit_fields, emit_count as u64, packed_flag) != 0) {
            if (fields != null) { free(fields); }
            self.report_error("cannot finalize record type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (fields != null) { free(fields); }
        llvm_mir_i32_map_put(self.type_struct_body_field_counts, type_id, final_field_count + 1);
        return st;
    }

    public fn generic_record_instance_has_zero_field_template(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0 || policy_generic_call_has_args(text.clone()) == 0) { return false; }
        let base = policy_generic_call_base(text.clone());
        if (base.len == 0) { return false; }
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if (id != type_id
                && llvm_mir_type_kind(&self.m, id) == ty_CLASS()
                && policy_generic_call_has_args(llvm_mir_type_text(&self.m, id).clone()) == 0
                && self.type_text_equivalent(base, llvm_mir_type_text(&self.m, id))) {
                return mir_unit_field_count_for_type(&self.m, id) == 0
                    && mir_unit_variant_count_for_type(&self.m, id) == 0;
            }
            id = id + 1;
        }
        return false;
    }

    public fn get_or_create_record_ty(self, type_id: i32) -> rawptr {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type != type_id) { return self.get_or_create_record_ty(canonical_type); }
        let field_count = mir_unit_field_count_for_type(&self.m, type_id);
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) {
            if (llvm_mir_i32_map_get(self.type_struct_body_field_counts, type_id) == 0
                && field_count > 0) {
                return self.finalize_record_ty_body(type_id, cached, field_count);
            }
            if (llvm_mir_i32_map_get(self.type_struct_body_field_counts, type_id) == 0
                && field_count <= 0
                && self.generic_record_instance_has_zero_field_template(type_id)) {
                return self.finalize_record_ty_body(type_id, cached, field_count);
            }
            return cached;
        }
        let name = "mir.struct." + llvm_mir_type_text(&self.m, type_id);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create record type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        if (field_count <= 0
            && policy_generic_call_has_args(llvm_mir_type_text(&self.m, type_id).clone()) != 0
            && !self.generic_record_instance_has_zero_field_template(type_id)) {
            return st;
        }
        if (self.finalize_record_ty_body(type_id, st, field_count) == null) { return null; }
        return st;
    }

    public fn get_or_create_tuple_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let elem_count = self.tuple_element_count_for_type(type_id);
        let name = "mir.tuple." + llvm_mir_type_text(&self.m, type_id);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create tuple type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        var fields: rawptr = null;
        if (elem_count > 0) {
            fields = malloc((elem_count * 8) as u64);
            if (fields == null) {
                self.report_error("cannot allocate tuple field list for " + llvm_mir_type_text(&self.m, type_id));
                return null;
            }
            var idx: i32 = 0;
            while (idx < elem_count) {
                let elem_type = self.tuple_element_type_id(type_id, idx);
                let elem_ll = self.lower_type(elem_type);
                if (elem_type == mir_id_invalid() || elem_ll == null) {
                    free(fields);
                    self.report_error("cannot lower tuple element #" + policy_i64_to_string(idx as i64)
                              + " for " + llvm_mir_type_text(&self.m, type_id));
                    return null;
                }
                ast_write_rawptr(ptr_offset(fields, idx * 8), elem_ll);
                idx = idx + 1;
            }
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, elem_count as u64, 0) != 0) {
            if (fields != null) { free(fields); }
            self.report_error("cannot finalize tuple type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        if (fields != null) { free(fields); }
        return st;
    }

    public fn type_is_dyn_trait(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len <= 3) { return false; }
        if (!text.startsWith("dyn")) { return false; }
        return mir_unit_field_count_for_type(&self.m, type_id) <= 0;
    }

    public fn type_dyn_trait_id(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        var cur = type_id;
        var depth: i32 = 0;
        while (depth < 4 && cur != mir_id_invalid()) {
            if (self.type_is_dyn_trait(cur)) { return cur; }
            let kind = llvm_mir_type_kind(&self.m, cur);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) {
                return mir_id_invalid();
            }
            cur = hir_type_table_elem(self.m.types, cur);
            depth = depth + 1;
        }
        return mir_id_invalid();
    }

    public fn type_is_class_pointer_abi(self, type_id: i32) -> bool {
        // Native value classes do NOT use this predicate; they follow the
        // unique C aggregate rule in type_uses_indirect_c_abi (sret/byval vs
        // coerce). This flag is only for foreign-DCI types without a stable
        // value layout, plus the remaining non-value_struct class forms.
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.class_pointer_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let canonical_type = self.canonical_record_type_id(type_id);
        var result = false;
        if (llvm_mir_type_kind(&self.m, canonical_type) == ty_CLASS()) {
            // Vyx subclasses of imported C++ types are heap factory objects
            // (vtable + C++ layout). They are never empty value-struct `{}`.
            if (self.type_is_dci_stub_class(canonical_type)) {
                result = true;
            } else if (mir_unit_type_is_foreign_dci(&self.m, canonical_type)
                && !self.dci_type_uses_stable_value_layout(canonical_type)) {
                result = true;
            } else if (!self.type_is_value_struct_abi(canonical_type)
                && !self.type_is_str_abi(canonical_type)
                && !self.type_is_dyn_trait(canonical_type)
                && !self.type_is_option_abi(canonical_type)
                && !self.type_is_result_abi(canonical_type)
                && !self.type_is_plain_enum_abi(canonical_type)) {
                result = true;
            }
        }
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.class_pointer_abi_cache, type_id, state);
        return result;
    }

    public fn class_pointer_abi_record_type(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.type_is_class_pointer_abi(type_id)) {
            return self.canonical_record_type_id(type_id);
        }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            if (self.type_is_class_pointer_abi(elem)) {
                return self.canonical_record_type_id(elem);
            }
        }
        return mir_id_invalid();
    }

    // A fieldless value-struct placeholder may reach lowering without ever
    // receiving hir_type_flag_value_struct (imported/forward class referenced
    // through a pointer). The authoritative fallback is: does any type in the
    // unit carry the value-struct flag under the same base name? Rather than
    // rescan every type on each query (the historical O(types) walk, which
    // turned this hot predicate into an O(types^2) explosion once native
    // classes became value structs), collect the value-struct base names once
    // into a hashed set and answer in O(1) thereafter.
    public fn ensure_value_struct_base_name_index(self) {
        if (self.value_struct_base_name_index_ready) { return; }
        self.value_struct_base_name_index_ready = true;
        var cap = self.m.types.count * 2 + 16;
        if (cap < 65536) { cap = 65536; }
        let buf = llvm_mir_symbol_index_new(cap);
        if (buf == null) { return; }
        self.value_struct_base_name_index = buf;
        self.value_struct_base_name_index_cap = cap;
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            if ((hir_type_table_flags(self.m.types, id) & hir_type_flag_value_struct()) != 0) {
                var candidate_base = policy_generic_call_base(llvm_mir_type_text(&self.m, id).clone());
                if (candidate_base.len == 0) { candidate_base = llvm_mir_type_text(&self.m, id); }
                let candidate_last = self.last_path_segment(candidate_base);
                if (candidate_last.len > 0) {
                    llvm_mir_symbol_index_put_first(buf, cap, candidate_last, 1);
                }
            }
            id = id + 1;
        }
    }

    public fn compute_type_is_value_struct_abi(self, type_id: i32) -> bool {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        if (self.type_is_dci_stub_class(canonical_type)) { return false; }
        if (mir_unit_type_is_foreign_dci(&self.m, canonical_type)) {
            return self.dci_type_uses_stable_value_layout(canonical_type);
        }
        if ((hir_type_table_flags(self.m.types, canonical_type) & hir_type_flag_value_struct()) != 0) { return true; }
        let text = llvm_mir_type_text(&self.m, canonical_type);
        var base = policy_generic_call_base(text.clone());
        if (base.len == 0) { base = text; }
        let base_last = self.last_path_segment(base);
        if (base_last.len == 0) { return false; }
        self.ensure_value_struct_base_name_index();
        if (self.value_struct_base_name_index == null) { return false; }
        return llvm_mir_symbol_index_get(self.value_struct_base_name_index,
                                         self.value_struct_base_name_index_cap,
                                         base_last) != mir_id_invalid();
    }

    public fn type_text_kind_key(self, kind: i32, text: string) -> string {
        return "\nK" + kind.toString() + "\t" + text;
    }

    public fn ensure_type_text_index(self) {
        if (self.type_text_index_ready && self.type_text_index_types == self.m.types.count) {
            return;
        }
        if (self.type_text_index != null) {
            llvm_mir_dispose_symbol_index(self.type_text_index, self.type_text_index_cap, false);
            self.type_text_index = null;
        }
        self.type_text_index_ready = true;
        self.type_text_index_types = self.m.types.count;
        self.interned_rawptr_type_id = mir_id_invalid();
        self.interned_str_type_id = mir_id_invalid();
        self.interned_f32_type_id = mir_id_invalid();
        self.interned_f64_type_id = mir_id_invalid();
        var cap = self.m.types.count * 4 + 16;
        if (cap < 65536) { cap = 65536; }
        let buf = llvm_mir_symbol_index_new(cap);
        if (buf == null) { return; }
        self.type_text_index = buf;
        self.type_text_index_cap = cap;
        var id: i32 = 1;
        while (id <= self.m.types.count) {
            let text = llvm_mir_type_text(&self.m, id);
            if (text.len > 0) {
                llvm_mir_symbol_index_put_first(buf, cap, text.clone(), id);
                let kind = llvm_mir_type_kind(&self.m, id);
                llvm_mir_symbol_index_put_first(buf, cap, self.type_text_kind_key(kind, text.clone()), id);
                if (text == "rawptr" && self.interned_rawptr_type_id == mir_id_invalid()) {
                    self.interned_rawptr_type_id = id;
                } else if (text == "str" && self.interned_str_type_id == mir_id_invalid()) {
                    self.interned_str_type_id = id;
                } else if (text == "f32" && self.interned_f32_type_id == mir_id_invalid()) {
                    self.interned_f32_type_id = id;
                } else if (text == "f64" && self.interned_f64_type_id == mir_id_invalid()) {
                    self.interned_f64_type_id = id;
                }
            }
            id = id + 1;
        }
    }

    public fn type_is_value_struct_abi(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let cached = llvm_mir_i32_map_get(self.value_struct_abi_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let result = self.compute_type_is_value_struct_abi(type_id);
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.value_struct_abi_cache, type_id, state);
        return result;
    }

    // Unique native C aggregate ABI (SysV x86_64 eightbytes):
    //   * Vyx-to-Vyx: ≤ 2 machine words stay first-class LLVM structs;
    //     larger aggregates use hidden sret + byval.
    //   * C calling convention (extern / no_mangle / csym): small aligned
    //     aggregates are coerced to the clang integer/SSE machine type
    //     (i64, [2 x i64], float/double); packed or unaligned fields and
    //     size > 16 use MEMORY (sret/byval).
    // Method `self` is always a pointer (see type_uses_self_pointer_abi).
    // Foreign DCI keeps its own descriptor; this rule is native Vyx only.
    public fn type_c_abi_word_bytes(self) -> i64 { return 8; }

    public fn type_c_abi_max_direct_bytes(self) -> i64 {
        return self.type_c_abi_word_bytes() * 2;
    }

    public fn type_is_native_c_aggregate(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        if (self.type_is_dyn_trait(canonical_type)) { return false; }
        if (self.type_is_class_pointer_abi(canonical_type)) { return false; }
        // DCI types keep descriptor-driven sret/byval/coerce. Applying the
        // native eightbyte rule turns a 16-byte string_view into a coerced
        // scalar, then rebuild_record_value_as extractvalue aborts.
        if (self.type_is_foreign_dci(canonical_type)) { return false; }
        return true;
    }

    public fn type_uses_indirect_c_abi(self, type_id: i32) -> bool {
        if (!self.type_is_native_c_aggregate(type_id)) { return false; }
        let bytes = self.value_storage_size(type_id);
        if (bytes <= 0) { return false; }
        if (bytes > self.type_c_abi_max_direct_bytes()) { return true; }
        // Win64: LLVM returns {f32,f32,f32,f32} in XMM0/XMM1 plus x87 ST0/ST1.
        // Later SSE copies of UiTheme/AppWorld clobber that; Color/Rectangle
        // layout then stores 0 and the GPU presents a blank clear color.
        if (llvm_mir_effective_target_is_windows() && bytes > self.type_c_abi_word_bytes()) {
            let cls = self.c_sysv_classify(type_id);
            if ((cls & 256) == 0) {
                let sse = self.c_sysv_cls_sse();
                let e0 = cls & 15;
                let e1 = (cls >> 4) & 15;
                if (e0 == sse || e1 == sse) { return true; }
            }
        }
        return false;
    }

    public fn c_sysv_cls_none(self) -> i32 { return 0; }
    public fn c_sysv_cls_integer(self) -> i32 { return 1; }
    public fn c_sysv_cls_sse(self) -> i32 { return 2; }
    public fn c_sysv_cls_memory(self) -> i32 { return 3; }

    public fn c_sysv_merge_class(self, a: i32, b: i32) -> i32 {
        if (a == self.c_sysv_cls_none()) { return b; }
        if (b == self.c_sysv_cls_none()) { return a; }
        if (a == self.c_sysv_cls_memory() || b == self.c_sysv_cls_memory()) {
            return self.c_sysv_cls_memory();
        }
        if (a != b) { return self.c_sysv_cls_integer(); }
        return a;
    }

    public fn c_sysv_scalar_class(self, type_id: i32) -> i32 {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_F32() || kind == ty_F64()) { return self.c_sysv_cls_sse(); }
        if (kind == ty_VOID()) { return self.c_sysv_cls_none(); }
        return self.c_sysv_cls_integer();
    }

    public fn c_sysv_set_eightbyte(self, acc: i32, eb: i64, cls: i32) -> i32 {
        let mem = acc & 256;
        var e0 = acc & 15;
        var e1 = (acc >> 4) & 15;
        if (eb == 0) {
            e0 = self.c_sysv_merge_class(e0, cls);
            return mem | e0 | (e1 << 4);
        }
        if (eb == 1) {
            e1 = self.c_sysv_merge_class(e1, cls);
            return mem | e0 | (e1 << 4);
        }
        return acc | 256;
    }

    public fn c_sysv_classify_at(self, type_id: i32, base: i64, acc: i32) -> i32 {
        if ((acc & 256) != 0) { return acc; }
        if (type_id == mir_id_invalid()) { return acc | 256; }
        let canonical = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical);
        if (kind == ty_CLASS() && self.type_is_value_struct_abi(canonical)) {
            let packed = self.type_repr_is_packed(canonical);
            var offset: i64 = 0;
            let field_n = mir_unit_field_count_for_type(&self.m, canonical);
            var fi: i32 = 0;
            var next = acc;
            while (fi < field_n) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, fi);
                if (field_id != mir_id_invalid()) {
                    let ft = mir_unit_field_type(&self.m, field_id);
                    let fs = self.value_storage_size_fast(ft);
                    if (fs <= 0) { return acc | 256; }
                    var nat_align = self.value_storage_align(ft);
                    if (nat_align <= 0) { nat_align = 1; }
                    var place_align = nat_align;
                    if (packed) { place_align = 1; }
                    offset = self.align_up_i64(offset, place_align);
                    if ((offset % nat_align) != 0) { return acc | 256; }
                    next = self.c_sysv_classify_at(ft, base + offset, next);
                    offset = offset + fs;
                }
                fi = fi + 1;
            }
            return next;
        }
        if (kind == ty_ARRAY()) {
            let elem = hir_type_table_elem(self.m.types, canonical);
            let count = self.array_length_for_type(canonical);
            let elem_size = self.value_storage_size_fast(elem);
            if (elem == mir_id_invalid() || count < 0 || elem_size <= 0) { return acc | 256; }
            var idx: i32 = 0;
            var next_arr = acc;
            while (idx < count) {
                next_arr = self.c_sysv_classify_at(elem, base + (elem_size * (idx as i64)), next_arr);
                idx = idx + 1;
            }
            return next_arr;
        }
        if (kind == ty_TUPLE()) {
            var offset2: i64 = 0;
            let count2 = self.tuple_element_count_for_type(canonical);
            var ti: i32 = 0;
            var next_t = acc;
            while (ti < count2) {
                let et = self.tuple_element_type_id(canonical, ti);
                let es = self.value_storage_size_fast(et);
                if (es <= 0) { return acc | 256; }
                var ea = self.value_storage_align(et);
                if (ea <= 0) { ea = 1; }
                offset2 = self.align_up_i64(offset2, ea);
                next_t = self.c_sysv_classify_at(et, base + offset2, next_t);
                offset2 = offset2 + es;
                ti = ti + 1;
            }
            return next_t;
        }
        let bytes = self.value_storage_size_fast(canonical);
        if (bytes <= 0) { return acc | 256; }
        let cls = self.c_sysv_scalar_class(canonical);
        let start = base;
        let last = base + bytes - 1;
        if (start < 0 || last >= 16) { return acc | 256; }
        var eb = start / 8;
        let end_eb = last / 8;
        var next_s = acc;
        while (eb <= end_eb) {
            next_s = self.c_sysv_set_eightbyte(next_s, eb, cls);
            eb = eb + 1;
        }
        return next_s;
    }

    public fn c_sysv_classify(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) {
            return self.c_sysv_classify_at(type_id, 0, 0);
        }
        let cached = llvm_mir_i32_map_get(self.c_sysv_classify_cache, type_id);
        if (cached != 0) { return cached - 1; }
        let cls = self.c_sysv_classify_at(type_id, 0, 0);
        llvm_mir_i32_map_put(self.c_sysv_classify_cache, type_id, cls + 1);
        return cls;
    }

    public fn type_uses_c_sysv_memory(self, type_id: i32) -> bool {
        if (!self.type_is_native_c_aggregate(type_id)) { return false; }
        let bytes = self.value_storage_size(type_id);
        if (bytes <= 0 || bytes > self.type_c_abi_max_direct_bytes()) { return true; }
        return (self.c_sysv_classify(type_id) & 256) != 0;
    }

    public fn type_uses_c_sysv_direct_coerce(self, type_id: i32) -> bool {
        if (!self.type_is_native_c_aggregate(type_id)) { return false; }
        return !self.type_uses_c_sysv_memory(type_id);
    }

    public fn function_uses_c_sysv_aggregate_abi(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        // An open-generic instance has no descriptor at all: its parameter and
        // return types are the consumer's own MIR types, and the materialized
        // entrypoint was compiled by a C-ABI compiler (clang / rustc) that
        // applies the target's aggregate rule.  So the consumer has to answer
        // the same way -- opt-in here, and the existing coerce machinery
        // supplies the matching LLVM type and value conversion on both the
        // declaration and the callsite.  Checked before the blanket DCI guard
        // below, which would otherwise refuse every instance.
        if (self.function_name_is_foreign_dci_instance(function_id)) { return true; }
        // A DCI override callback is materialized as an extern "C" free
        // function too (the stub TU declares it with plain C types), so its
        // register-classified records coerce the same way.  The helper below
        // excludes every size the C free-function rule would not carry in a
        // register, and the member facts keep driving sret/indirect shapes.
        if (self.function_is_dci_vyx_override_callback(function_id)) { return true; }
        if (self.function_is_foreign_dci(function_id)) { return false; }
        return self.function_uses_c_calling_convention(function_id);
    }

    /// Whether a *direct* parameter of an open-generic instance has to be
    /// coerced to the target's C aggregate machine type.
    ///
    /// Only the direct case: a parameter the synthesized ABI already routed to
    /// `indirect`/`byval` travels as a pointer and is left alone.  This is the
    /// value-side twin of `source_param_uses_c_sysv_coerce`, which covers the
    /// signature side but is unreachable from the DCI argument path.
    public fn dci_open_direct_param_uses_c_coerce(self, function_id: i32,
                                                  type_id: i32) -> bool {
        if (function_id == mir_id_invalid() || type_id == mir_id_invalid()) { return false; }
        if (!self.function_name_is_foreign_dci_instance(function_id)) { return false; }
        if (self.dci_open_lowering_passing(type_id) != "direct") { return false; }
        return self.type_uses_c_sysv_direct_coerce(type_id);
    }

    public fn source_param_uses_c_sysv_coerce(self, function_id: i32, source_idx: i32) -> bool {
        if (!self.function_uses_c_sysv_aggregate_abi(function_id)) { return false; }
        if (self.source_param_uses_self_pointer_abi(function_id, source_idx)) { return false; }
        let param_type = self.function_source_param_type(function_id, source_idx);
        if (self.dci_override_crosses_as_c_register_record(function_id, param_type)) { return true; }
        return self.type_uses_c_sysv_direct_coerce(param_type);
    }

    public fn function_return_uses_c_sysv_coerce(self, function_id: i32) -> bool {
        if (!self.function_uses_c_sysv_aggregate_abi(function_id)) { return false; }
        let ret_type = self.m.function_return_type(function_id);
        if (self.dci_override_crosses_as_c_register_record(function_id, ret_type)) { return true; }
        return self.type_uses_c_sysv_direct_coerce(ret_type);
    }

    public fn c_sysv_named_pair_ty(self, left: rawptr, right: rawptr, name: string) -> rawptr {
        if (left == null || right == null) { return null; }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) { return null; }
        if (vyx_rt_get_struct_field_ty(self.mod, st, 0) != null) { return st; }
        let fields = malloc(16);
        if (fields == null) { return null; }
        ast_write_rawptr(fields, left);
        ast_write_rawptr(ptr_offset(fields, 8), right);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            return null;
        }
        free(fields);
        return st;
    }

    public fn c_sysv_coerce_llvm_type(self, type_id: i32) -> rawptr {
        let bytes = self.value_storage_size(type_id);
        if (bytes <= 0 || bytes > 16) { return null; }
        // Win64 answers with a different coercion than SysV: an aggregate that
        // fits in one machine word travels in a *single integer register*,
        // whatever its members are -- clang lowers `struct {float,float}` and
        // `struct {double}` to `i64`, not to an XMM value, so the SSE branch
        // below would pick the wrong class and the argument would arrive in
        // the wrong register file.  Sizes above one word keep the SysV
        // eightbyte rule (the DCI open-generic surface routes those to by
        // reference before asking here).  `<=` rather than `==` on the widths
        // so a padded 3-byte struct keeps answering the way it always did.
        if (llvm_mir_effective_target_is_windows()
            && bytes <= self.type_c_abi_word_bytes()) {
            if (bytes <= 1) { return self.ty_i8; }
            if (bytes <= 2) { return self.ty_i16; }
            if (bytes <= 4) { return self.ty_i32; }
            return self.ty_i64;
        }
        let cls = self.c_sysv_classify(type_id);
        if ((cls & 256) != 0) { return null; }
        let eb0 = cls & 15;
        let eb1 = (cls >> 4) & 15;
        if (bytes <= 8) {
            if (eb0 == self.c_sysv_cls_sse()) {
                if (bytes <= 4) { return vyx_rt_float_type(self.mod, 32); }
                return vyx_rt_float_type(self.mod, 64);
            }
            if (bytes <= 1) { return self.ty_i8; }
            if (bytes <= 2) { return self.ty_i16; }
            if (bytes <= 4) { return self.ty_i32; }
            return self.ty_i64;
        }
        if (eb0 == self.c_sysv_cls_sse() && eb1 == self.c_sysv_cls_sse()) {
            return vyx_rt_array_ty(self.mod, vyx_rt_float_type(self.mod, 64), 2);
        }
        if (eb0 == self.c_sysv_cls_sse() && eb1 == self.c_sysv_cls_integer()) {
            return self.c_sysv_named_pair_ty(vyx_rt_float_type(self.mod, 64), self.ty_i64, "c.abi.si");
        }
        if (eb0 == self.c_sysv_cls_integer() && eb1 == self.c_sysv_cls_sse()) {
            return self.c_sysv_named_pair_ty(self.ty_i64, vyx_rt_float_type(self.mod, 64), "c.abi.is");
        }
        return vyx_rt_array_ty(self.mod, self.ty_i64, 2);
    }

    public fn c_sysv_coerce_value(self, value: rawptr, type_id: i32, label: string) -> rawptr {
        let coerce_ty = self.c_sysv_coerce_llvm_type(type_id);
        let storage_ty = self.lower_storage_type(type_id);
        if (value == null || coerce_ty == null || storage_ty == null) { return null; }
        let slot = vyx_rt_build_alloca(self.mod, storage_ty, label.c_str(), label.len as u64);
        if (slot == null) { return null; }
        var alignment = self.value_storage_align(type_id);
        if (alignment <= 0) { alignment = 8; }
        vyx_rt_set_alignment(self.mod, slot, alignment as i32);
        vyx_rt_build_store(self.mod, value, slot);
        return vyx_rt_build_load(self.mod, coerce_ty, slot, label.c_str(), label.len as u64);
    }

    public fn c_sysv_uncoerce_value(self, bits: rawptr, type_id: i32, label: string) -> rawptr {
        let coerce_ty = self.c_sysv_coerce_llvm_type(type_id);
        let storage_ty = self.lower_storage_type(type_id);
        if (bits == null || coerce_ty == null || storage_ty == null) { return null; }
        let slot = vyx_rt_build_alloca(self.mod, storage_ty, label.c_str(), label.len as u64);
        if (slot == null) { return null; }
        var alignment = self.value_storage_align(type_id);
        if (alignment <= 0) { alignment = 8; }
        vyx_rt_set_alignment(self.mod, slot, alignment as i32);
        vyx_rt_build_store(self.mod, bits, slot);
        return vyx_rt_build_load(self.mod, storage_ty, slot, label.c_str(), label.len as u64);
    }

    public fn function_uses_hidden_sret(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        // An override callback whose record return crosses as an extern "C"
        // free function returns in RAX (1/2/4/8-byte record, C free-function
        // rule); the member-style sret fact of the vtable slot must not leak
        // into the thunk signature, which the stub TU declares without a
        // hidden return pointer.
        if (self.dci_override_crosses_as_c_register_record(
                function_id, self.m.function_return_type(function_id))) {
            return false;
        }
        if (self.dci_function_uses_sret(function_id)) { return true; }
        if (self.function_is_foreign_dci(function_id)) { return false; }
        if (self.function_uses_i32_main_abi(function_id)) { return false; }
        if (self.function_uses_c_calling_convention(function_id)) {
            return self.type_uses_c_sysv_memory(self.m.function_return_type(function_id));
        }
        return self.type_uses_indirect_c_abi(self.m.function_return_type(function_id));
    }

    public fn function_is_native_constructor(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_is_foreign_dci_ctor(function_id)) { return true; }
        return self.function_name_matches_method(self.m.function_name(function_id), "constructor");
    }

    public fn source_param_uses_native_byval_abi(self, function_id: i32, source_idx: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_is_foreign_dci(function_id)) { return false; }
        if (self.source_param_uses_dci_override_byval_abi(function_id, source_idx)) { return true; }
        if (self.source_param_uses_self_pointer_abi(function_id, source_idx)) { return false; }
        if (self.function_uses_c_calling_convention(function_id)) {
            return self.type_uses_c_sysv_memory(self.function_source_param_type(function_id, source_idx));
        }
        return self.type_uses_indirect_c_abi(self.function_source_param_type(function_id, source_idx));
    }

    public fn native_aggregate_align_bytes(self, type_id: i32) -> u64 {
        var align = self.dci_type_value_alignment(type_id);
        if (align <= 0) { align = 8; }
        return align as u64;
    }

    public fn materialize_aggregate_pointer_argument(self,
                                                     value_id: i32,
                                                     type_id: i32,
                                                     label: string) -> rawptr {
        let storage_type = self.lower_storage_type(type_id);
        let value = self.lower_value_as(value_id, type_id);
        if (storage_type == null || value == null) { return null; }
        let slot = vyx_rt_build_alloca(self.mod, storage_type, label.c_str(), label.len as u64);
        if (slot == null) { return null; }
        let alignment = self.native_aggregate_align_bytes(type_id);
        if (alignment > 0) { vyx_rt_set_alignment(self.mod, slot, alignment as i32); }
        vyx_rt_build_store(self.mod, value, slot);
        return slot;
    }

    public fn class_record_storage_ty(self, type_id: i32) -> rawptr {
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type == mir_id_invalid()) { return null; }
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return null; }
        return self.get_or_create_record_ty(canonical_type);
    }

    public fn lower_storage_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (self.type_is_class_pointer_abi(canonical_type)) {
            return self.class_record_storage_ty(canonical_type);
        }
        return self.lower_type(canonical_type);
    }

    public fn lower_value_storage_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        return self.lower_type(type_id);
    }

    public fn align_up_i64(self, value: i64, align: i64) -> i64 {
        if (align <= 1) { return value; }
        let rem = value % align;
        if (rem == 0) { return value; }
        return value + (align - rem);
    }

    public fn value_storage_size_fast(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical_type = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical_type);
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
        if (kind == ty_I16() || kind == ty_U16()) { return 2; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
        if (llvm_mir_kind_pointer_handle(kind)) { return 16; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()
            || kind == ty_F64() || llvm_mir_kind_pointer_like(kind)) {
            return 8;
        }
        if (self.type_is_str_abi(canonical_type)) { return 32; }
        if (kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.m.types, canonical_type);
            let count = self.array_length_for_type(canonical_type);
            if (elem_type == mir_id_invalid() || count < 0) { return 0; }
            let elem_size = self.value_storage_size_fast(elem_type);
            if (elem_size <= 0) { return 0; }
            return elem_size * count;
        }
        if (kind == ty_TUPLE()) {
            var offset: i64 = 0;
            var max_align: i64 = 1;
            let count2 = self.tuple_element_count_for_type(canonical_type);
            var idx: i32 = 0;
            while (idx < count2) {
                let elem_type2 = self.tuple_element_type_id(canonical_type, idx);
                let elem_size2 = self.value_storage_size_fast(elem_type2);
                if (elem_size2 <= 0) { return 0; }
                var elem_align = self.value_storage_align(elem_type2);
                if (elem_align <= 0) { elem_align = 8; }
                if (elem_align > max_align) { max_align = elem_align; }
                offset = self.align_up_i64(offset, elem_align);
                offset = offset + elem_size2;
                idx = idx + 1;
            }
            return self.align_up_i64(offset, max_align);
        }
        // Option/Result/enum are value-struct CLASSes with zero named fields.
        // Their payload lives in the variant ABI ({i32 tag, ...}), not in
        // `field_count`. Walking fields would report size 1 and Vec memcpy
        // would drop the payload (is_some survives, unwrap_or returns 0).
        if (kind == ty_CLASS()
            && (self.type_is_option_abi(canonical_type)
                || self.type_is_result_abi(canonical_type)
                || self.type_is_plain_enum_abi(canonical_type))) {
            return 0;
        }
        if (kind == ty_CLASS() && self.type_is_value_struct_abi(canonical_type)) {
            let packed = self.type_repr_is_packed(canonical_type);
            var offset3: i64 = 0;
            // A value class occupies its whole ABI slot when it is a field of
            // another record: `InnerClass { i32 }` has size 4 but a stride of
            // 8, so `Nested { inner: InnerClass, tail: u8 }` reports 16 and not
            // 8. The record itself is only padded to its widest field - the
            // 8-byte class floor belongs to `alignof::<T>()`, not to `sizeof`.
            // `finalize_record_ty_body` appends whatever tail padding is needed
            // to make the LLVM record size agree with this answer; it walks the
            // unfloored storage alignment on purpose, because that walk mirrors
            // where LLVM actually places the fields. Keep the two in step.
            var natural_align: i64 = 1;
            let field_n = mir_unit_field_count_for_type(&self.m, canonical_type);
            var fi: i32 = 0;
            while (fi < field_n) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, canonical_type, fi);
                if (field_id != mir_id_invalid()) {
                    let ft = mir_unit_field_type(&self.m, field_id);
                    let fs = self.value_storage_size_fast(ft);
                    if (fs <= 0) { return 0; }
                    var fa = self.value_abi_align(ft);
                    if (packed) { fa = 1; }
                    if (fa <= 0) { fa = 1; }
                    if (fa > natural_align) { natural_align = fa; }
                    offset3 = self.align_up_i64(offset3, fa);
                    offset3 = offset3 + self.align_up_i64(fs, fa);
                }
                fi = fi + 1;
            }
            offset3 = self.align_up_i64(offset3, natural_align);
            if (offset3 <= 0) { return 1; }
            return offset3;
        }
        return 0;
    }

    public fn value_storage_size(self, type_id: i32) -> i64 {
        let fast = self.value_storage_size_fast(type_id);
        if (fast > 0) { return fast; }
        let dci_size = self.dci_record_size_bytes_for_type(type_id);
        if (dci_size > 0) { return dci_size; }
        let ty = self.lower_storage_type(type_id);
        if (ty == null) { return 0; }
        let bytes = vyx_rt_type_alloc_size(self.mod, ty);
        if (bytes > 0) { return bytes; }
        return 0;
    }

    public fn copy_value_storage_to_addr(self,
                                         dst_addr: rawptr,
                                         value_id: i32,
                                         dst_type: i32,
                                         context: string) -> bool {
        if (dst_addr == null || value_id == mir_id_invalid() || dst_type == mir_id_invalid()) {
            self.report_error("cannot copy value storage for " + context);
            return false;
        }
        if (self.type_is_class_pointer_abi(dst_type)) {
            let src_addr = self.lower_self_receiver_address(value_id, dst_type);
            let size_bytes = self.value_storage_size(dst_type);
            if (src_addr == null || size_bytes <= 0) {
                self.report_error("cannot materialize class value storage for "
                          + context
                          + " type "
                          + llvm_mir_type_text(&self.m, dst_type));
                return false;
            }
            if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
                self.report_error("memcpy declaration is unavailable");
                return false;
            }
            let copied = vyx_rt_build_call3(self.mod,
                                            self.builtin_memcpy_fty,
                                            self.builtin_memcpy_fn,
                                            dst_addr,
                                            src_addr,
                                            vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                            llvm_mir_empty_name(),
                                            0);
            if (copied == null) {
                self.report_error("cannot copy class value storage for "
                          + context
                          + " type "
                          + llvm_mir_type_text(&self.m, dst_type));
                return false;
            }
            if (self.current_place_id != mir_id_invalid()
                && self.m.place_kind(self.current_place_id) == mir_place_local()) {
                self.emit_debug_local_at_assignment(self.m.place_local(self.current_place_id), copied);
            }
            return true;
        }
        let value = self.lower_value_as(value_id, dst_type);
        if (value == null) {
            self.report_error("cannot lower value for storage copy in "
                      + context
                      + " type "
                      + llvm_mir_type_text(&self.m, dst_type));
            return false;
        }
        vyx_rt_build_store(self.mod, value, dst_addr);
        return true;
    }

    public fn dyn_trait_name(self, type_id: i32) -> string {
        if (!self.type_is_dyn_trait(type_id)) { return ""; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len <= 3) { return ""; }
        return from_cstr_len(text.c_str() + 3, text.len - 3);
    }

    public fn type_text_matches_dyn_trait_name(self, text: string, dyn_type_id: i32) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || text.len == 0) { return false; }
        let dyn_text = llvm_mir_type_text(&self.m, dyn_type_id);
        let trait_text = self.dyn_trait_name(dyn_type_id);
        if (text == dyn_text || text == trait_text) { return true; }
        if (policy_type_name_equal(text, trait_text)) { return true; }
        let text_base = policy_generic_call_base(text.clone());
        let trait_base = policy_generic_call_base(trait_text.clone());
        if (llvm_mir_last_path_segment(text_base) == llvm_mir_last_path_segment(trait_base)) { return true; }
        return false;
    }

    public fn interface_name_matches(self, a: string, b: string) -> bool {
        if (a.len == 0 || b.len == 0) { return false; }
        if (a == b || policy_type_name_equal(a, b)) { return true; }
        let abase = policy_generic_call_base(a.clone());
        let bbase = policy_generic_call_base(b.clone());
        if (abase == bbase || policy_type_name_equal(abase, bbase)) { return true; }
        return llvm_mir_last_path_segment(abase) == llvm_mir_last_path_segment(bbase);
    }

    public fn interface_extends_trait_name(self, iface_name: string, target_trait: string, depth: i32) -> bool {
        if (iface_name.len == 0 || target_trait.len == 0) { return false; }
        if (self.interface_name_matches(iface_name, target_trait)) { return true; }
        if (depth > 16) { return false; }
        let rows = mir_unit_interface_supers(&self.m);
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= rows.len) {
            if (i == rows.len || rows.charAt(i) == 59) {
                var sep: i32 = -1;
                var j = start;
                while (j < i) {
                    if (rows.charAt(j) == 62 && sep < 0) { sep = j; }
                    j = j + 1;
                }
                if (sep > start && sep + 1 < i) {
                    let child = rows.substring(start, sep);
                    let parent = rows.substring(sep + 1, i);
                    if (self.interface_name_matches(child, iface_name)) {
                        if (self.interface_name_matches(parent, target_trait)) { return true; }
                        if (self.interface_extends_trait_name(parent, target_trait, depth + 1)) {
                            return true;
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

    public fn dyn_trait_extends_type_text(self, dyn_type_id: i32, target_trait: string) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id) || target_trait.len == 0) { return false; }
        let trait_text = self.dyn_trait_name(dyn_type_id);
        if (trait_text.len == 0) { return false; }
        return self.interface_extends_trait_name(trait_text, target_trait, 0);
    }

    public fn interface_function_matches_dyn_trait(self, fn_id: i32, dyn_type_id: i32) -> bool {
        if (!self.type_is_dyn_trait(dyn_type_id)) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, fn_id) != hir_item_interface()) { return false; }
        let owner_type_text = self.m.function_owner_type(fn_id);
        if (self.type_text_matches_dyn_trait_name(owner_type_text, dyn_type_id)
            || self.dyn_trait_extends_type_text(dyn_type_id, owner_type_text)) {
            return true;
        }
        let self_type = self.function_source_param_type(fn_id, 0);
        if (self_type != mir_id_invalid()
            && (self.type_text_matches_dyn_trait_name(llvm_mir_type_text(&self.m, self_type), dyn_type_id)
                || self.dyn_trait_extends_type_text(dyn_type_id, llvm_mir_type_text(&self.m, self_type)))) {
            return true;
        }
        return false;
    }

    public fn string_compare_lex(self, left: string, right: string) -> i32 {
        var idx: i32 = 0;
        while (idx < left.len && idx < right.len) {
            let lc = left.charAt(idx);
            let rc = right.charAt(idx);
            if (lc < rc) { return -1; }
            if (lc > rc) { return 1; }
            idx = idx + 1;
        }
        if (left.len < right.len) { return -1; }
        if (left.len > right.len) { return 1; }
        return 0;
    }

    public fn dyn_trait_type_abi_key(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return "?"; }
        var text = llvm_mir_type_text(&self.m, type_id);
        if (llvm_mir_is_primitive_str_name(text)) { text = "str"; }
        if (text.len == 0) { return "?"; }
        return text;
    }

    public fn dyn_trait_method_abi_key(self, function_id: i32) -> string {
        if (function_id == mir_id_invalid()) { return ""; }
        var out = self.function_method_name(function_id) + "(";
        var idx: i32 = 1;
        let count = self.function_source_param_count(function_id);
        while (idx < count) {
            if (idx > 1) { out = out + ","; }
            out = out + self.dyn_trait_type_abi_key(self.function_source_param_type(function_id, idx));
            idx = idx + 1;
        }
        out = out + ")->" + self.dyn_trait_type_abi_key(self.m.function_return_type(function_id));
        return out;
    }

    public fn dyn_trait_method_key_duplicate_before(self, type_id: i32, fn_id: i32) -> bool {
        if (!self.interface_function_matches_dyn_trait(fn_id, type_id)) { return false; }
        let wanted_order = self.dyn_trait_method_order_key(fn_id);
        let wanted_name = self.function_method_name(fn_id);
        var cur: i32 = 1;
        while (cur <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(cur, type_id)
                && self.dyn_trait_method_order_key(cur) < wanted_order
                && self.function_method_name(cur) == wanted_name
                && self.dyn_trait_method_signature_matches(cur, fn_id)) {
                return true;
            }
            cur = cur + 1;
        }
        return false;
    }

    public fn dyn_trait_method_duplicate_before(self, type_id: i32, fn_id: i32) -> bool {
        return self.dyn_trait_method_key_duplicate_before(type_id, fn_id);
    }

    public fn dyn_trait_method_order_key(self, function_id: i32) -> i32 {
        if (function_id == mir_id_invalid()) { return 2147483647; }
        let item_id = self.m.function_hir_item(function_id);
        if (item_id > 0) { return item_id; }
        return 1073741824 + function_id;
    }

    public fn dyn_trait_method_count_uncached(self, type_id: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id)) { return 0; }
        var out: i32 = 0;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(fn_id, type_id)
                && !self.dyn_trait_method_duplicate_before(type_id, fn_id)) {
                out = out + 1;
            }
            fn_id = fn_id + 1;
        }
        return out;
    }

    public fn dyn_trait_method_at_uncached(self, type_id: i32, wanted: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id) || wanted < 0) { return mir_id_invalid(); }
        var emitted: i32 = 0;
        var have_last = false;
        var last_order: i32 = -1;
        while (emitted <= wanted) {
            var best_fn = mir_id_invalid();
            var best_order = 2147483647;
            var fn_id: i32 = 1;
            while (fn_id <= self.m.function_count) {
                if (self.interface_function_matches_dyn_trait(fn_id, type_id)
                    && !self.dyn_trait_method_duplicate_before(type_id, fn_id)) {
                    let order = self.dyn_trait_method_order_key(fn_id);
                    if ((!have_last || order > last_order) && order < best_order) {
                        best_fn = fn_id;
                        best_order = order;
                    }
                }
                fn_id = fn_id + 1;
            }
            if (best_fn == mir_id_invalid()) { return mir_id_invalid(); }
            if (emitted == wanted) { return best_fn; }
            last_order = best_order;
            have_last = true;
            emitted = emitted + 1;
        }
        return mir_id_invalid();
    }

    public fn ensure_dyn_trait_method_cache(self, type_id: i32) {
        if (!self.type_is_dyn_trait(type_id)) { return; }
        let cached_count = llvm_mir_i32_map_get(self.dyn_trait_method_counts, type_id);
        if (cached_count != 0) { return; }
        let max_count = self.m.function_count;
        let list = malloc((max_count * 4) as u64);
        if (list == null) {
            llvm_mir_i32_map_put(self.dyn_trait_method_counts, type_id, 1);
            return;
        }
        var count: i32 = 0;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.interface_function_matches_dyn_trait(fn_id, type_id)) {
                let order = self.dyn_trait_method_order_key(fn_id);
                var duplicate = false;
                var idx: i32 = 0;
                while (idx < count) {
                    let existing = ast_read_i32(ptr_offset(list, idx * 4));
                    if (self.function_method_name(existing) == self.function_method_name(fn_id)
                        && self.dyn_trait_method_signature_matches(existing, fn_id)) {
                        duplicate = true;
                        if (order < self.dyn_trait_method_order_key(existing)) {
                            ast_write_i32(ptr_offset(list, idx * 4), fn_id);
                        }
                        break;
                    }
                    idx = idx + 1;
                }
                if (!duplicate) {
                    var pos = count;
                    while (pos > 0
                        && order < self.dyn_trait_method_order_key(ast_read_i32(ptr_offset(list, (pos - 1) * 4)))) {
                        ast_write_i32(ptr_offset(list, pos * 4),
                                      ast_read_i32(ptr_offset(list, (pos - 1) * 4)));
                        pos = pos - 1;
                    }
                    ast_write_i32(ptr_offset(list, pos * 4), fn_id);
                    count = count + 1;
                }
            }
            fn_id = fn_id + 1;
        }
        llvm_mir_i32_map_put(self.dyn_trait_method_counts, type_id, count + 1);
        if (count <= 0) {
            free(list);
            return;
        }
        llvm_mir_map_put(self.dyn_trait_method_lists, type_id, list);
    }

    public fn dyn_trait_method_count(self, type_id: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id)) { return 0; }
        self.ensure_dyn_trait_method_cache(type_id);
        let cached = llvm_mir_i32_map_get(self.dyn_trait_method_counts, type_id);
        if (cached <= 0) { return 0; }
        return cached - 1;
    }

    public fn dyn_trait_method_at(self, type_id: i32, wanted: i32) -> i32 {
        if (!self.type_is_dyn_trait(type_id) || wanted < 0) { return mir_id_invalid(); }
        self.ensure_dyn_trait_method_cache(type_id);
        let count = self.dyn_trait_method_count(type_id);
        if (wanted >= count) { return mir_id_invalid(); }
        let list = llvm_mir_map_get(self.dyn_trait_method_lists, type_id);
        if (list == null) { return mir_id_invalid(); }
        return ast_read_i32(ptr_offset(list, wanted * 4));
    }

    public fn dyn_trait_interface_struct_name(self, type_id: i32) -> string {
        let iface_name = self.dyn_trait_name(type_id);
        if (iface_name.len == 0) { return ""; }
        return "__iface_" + policy_mangle_part(iface_name);
    }

    public fn dyn_trait_vtable_struct_name(self, type_id: i32) -> string {
        let iface_name = self.dyn_trait_name(type_id);
        if (iface_name.len == 0) { return ""; }
        return policy_mangle_part(iface_name) + "_vtable";
    }

    public fn get_or_create_dyn_trait_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.type_struct_values, type_id);
        if (cached != null) { return cached; }
        let is_dyn = self.type_is_dyn_trait(type_id);
        if (!is_dyn) { return null; }
        let iface_name = self.dyn_trait_name(type_id);
        var name = "";
        if (iface_name.len > 0) {
            name = "__iface_" + policy_mangle_part(iface_name);
        }
        if (name.len == 0) { return null; }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create dyn trait type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.type_struct_values, type_id, st);
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate dyn trait field list for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize dyn trait type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn get_or_create_dyn_trait_vtable_ty(self, type_id: i32) -> rawptr {
        let cached = llvm_mir_map_get(self.dyn_vtable_type_values, type_id);
        if (cached != null) { return cached; }
        if (!self.type_is_dyn_trait(type_id)) { return null; }
        let slot_count = self.dyn_trait_method_count(type_id);
        if (slot_count <= 0) {
            self.report_error("dyn trait has no vtable methods: " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        let name = self.dyn_trait_vtable_struct_name(type_id);
        if (name.len == 0) { return null; }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create dyn trait vtable type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        llvm_mir_map_put(self.dyn_vtable_type_values, type_id, st);
        let fields = malloc((slot_count * 8) as u64);
        if (fields == null) {
            self.report_error("cannot allocate dyn trait vtable field list for " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        var idx: i32 = 0;
        while (idx < slot_count) {
            ast_write_rawptr(ptr_offset(fields, idx * 8), self.ty_ptr);
            idx = idx + 1;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, slot_count as u64, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize dyn trait vtable type " + llvm_mir_type_text(&self.m, type_id));
            return null;
        }
        free(fields);
        return st;
    }

    public fn get_or_create_pointer_handle_ty(self) -> rawptr {
        if (self.pointer_handle_ty != null) { return self.pointer_handle_ty; }
        let name = "__VyxPointerHandle";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create LLVM pointer handle type");
            return null;
        }
        self.pointer_handle_ty = st;
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate LLVM pointer handle field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize LLVM pointer handle type");
            return null;
        }
        free(fields);
        return st;
    }

    public fn pointer_handle_null(self) -> rawptr {
        let ty = self.get_or_create_pointer_handle_ty();
        if (ty == null) { return null; }
        return vyx_rt_const_null(self.mod, ty);
    }

    public fn build_pointer_handle(self,
                                   address: rawptr,
                                   metadata: rawptr,
                                   name: string) -> rawptr {
        if (address == null || metadata == null) { return self.pointer_handle_null(); }
        var out = self.pointer_handle_null();
        if (out == null) { return null; }
        let address_name = name + ".address";
        out = vyx_rt_build_insert_value(self.mod,
                                        out,
                                        address,
                                        0,
                                        address_name.c_str(),
                                        address_name.len as u64);
        if (out == null) {
            self.report_error("cannot insert pointer handle address");
            return null;
        }
        let metadata_name = name + ".metadata";
        out = vyx_rt_build_insert_value(self.mod,
                                        out,
                                        metadata,
                                        1,
                                        metadata_name.c_str(),
                                        metadata_name.len as u64);
        if (out == null) {
            self.report_error("cannot insert pointer handle metadata");
        }
        return out;
    }

    public fn pointer_handle_address(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null) { return null; }
        if (vyx_rt_value_is_struct(handle) == 0) { return handle; }
        let part_name = name + ".address";
        return vyx_rt_build_extract_value(self.mod,
                                          handle,
                                          0,
                                          part_name.c_str(),
                                          part_name.len as u64);
    }

    public fn pointer_handle_metadata(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null) { return null; }
        if (vyx_rt_value_is_struct(handle) == 0) {
            return vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        }
        let part_name = name + ".metadata";
        return vyx_rt_build_extract_value(self.mod,
                                          handle,
                                          1,
                                          part_name.c_str(),
                                          part_name.len as u64);
    }

    public fn pointer_compare_scalar(self,
                                     value: rawptr,
                                     type_id: i32,
                                     name: string) -> rawptr {
        if (value == null) { return null; }
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            return self.pointer_handle_address(value, name);
        }
        return value;
    }

    public fn call_pointer_region_create(self,
                                         address: rawptr,
                                         bytes: i64,
                                         owned: i32,
                                         capability: i32) -> rawptr {
        if (address == null || bytes <= 0
            || self.pointer_region_create_fn == null
            || self.pointer_region_create_fty == null) {
            self.report_error("pointer region runtime is not available");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate pointer region call arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i64, bytes, 0));
        ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, owned as i64, 0));
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_region_create_fty,
                                    self.pointer_region_create_fn,
                                    args,
                                    4,
                                    "mir.ptr.region".c_str(),
                                    14);
        free(args);
        return out;
    }

    /// malloc whose size is an LLVM value (runtime-length array allocation).
    public fn malloc_bytes_runtime(self, size_v: rawptr, name: string) -> rawptr {
        if (size_v == null) { return null; }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc is not declared before " + name);
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_malloc_fty,
                                  self.builtin_malloc_fn,
                                  size_v,
                                  name.c_str(),
                                  name.len as u64);
    }

    /// pointer_region_create whose byte count is an LLVM value.
    public fn call_pointer_region_create_value(self,
                                               address: rawptr,
                                               bytes_v: rawptr,
                                               owned: i32,
                                               capability: i32) -> rawptr {
        if (address == null || bytes_v == null
            || self.pointer_region_create_fn == null
            || self.pointer_region_create_fty == null) {
            self.report_error("pointer region runtime is not available");
            return null;
        }
        let args = malloc(32);
        if (args == null) {
            self.report_error("cannot allocate pointer region call arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), bytes_v);
        ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, owned as i64, 0));
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_region_create_fty,
                                    self.pointer_region_create_fn,
                                    args,
                                    4,
                                    "mir.ptr.region".c_str(),
                                    14);
        free(args);
        return out;
    }

    /// Handle over a runtime-length array allocation: element-typed region
    /// with a dynamic byte count (no static dimension shape).
    public fn runtime_array_handle_from_raw(self,
                                             address: rawptr,
                                             elem_type: i32,
                                             bytes_v: rawptr,
                                             name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        let metadata = self.call_pointer_region_create_value(address, bytes_v, 1, 0);
        if (metadata == null) { return null; }
        if (!self.configure_pointer_region_array_shape(metadata, elem_type)) { return null; }
        return self.build_pointer_handle(address, metadata, name);
    }

    public fn pointer_handle_from_raw(self,
                                      address: rawptr,
                                      payload_type: i32,
                                      owned: i32,
                                      capability: i32,
                                      name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        var bytes: i64 = 1;
        if (payload_type != mir_id_invalid()) {
            let storage_ty = self.lower_storage_type(payload_type);
            if (storage_ty != null) {
                let measured = vyx_rt_type_alloc_size(self.mod, storage_ty);
                if (measured > 0) { bytes = measured; }
            }
        }
        let metadata = self.call_pointer_region_create(address, bytes, owned, capability);
        if (metadata == null) { return null; }
        if (!self.configure_pointer_region_array_shape(metadata, payload_type)) { return null; }
        return self.build_pointer_handle(address, metadata, name);
    }

    // Native DCI object pointers carry an address, without a Vyx allocation
    // region. Do not fabricate bounds or ownership for producer storage.
    // Native calls extract that address; consumer dereferences requiring a
    // region must use unsafe and establish the object's lifetime themselves.
    public fn pointer_handle_from_foreign_raw(self, address: rawptr, name: string) -> rawptr {
        if (address == null) { return self.pointer_handle_null(); }
        return self.build_pointer_handle(
            address,
            vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
            name);
    }

    public fn pointer_array_rank(self, type_id: i32) -> i32 {
        var current = type_id;
        var rank: i32 = 0;
        while (current != mir_id_invalid()
            && llvm_mir_type_kind(&self.m, current) == ty_ARRAY()
            && rank < 64) {
            rank = rank + 1;
            current = hir_type_table_elem(self.m.types, current);
        }
        return rank;
    }

    public fn configure_pointer_region_array_shape(self,
                                                    metadata: rawptr,
                                                    payload_type: i32) -> bool {
        let rank = self.pointer_array_rank(payload_type);
        if (rank <= 0) { return true; }
        if (metadata == null || self.pointer_region_set_dimension_fn == null
            || self.pointer_region_set_dimension_fty == null) {
            self.report_error("pointer array-shape runtime is not available");
            return false;
        }
        var current = payload_type;
        var level: i32 = 0;
        while (level < rank) {
            let extent = self.array_length_for_type(current);
            let elem = hir_type_table_elem(self.m.types, current);
            let stride = self.value_storage_size(elem);
            if (extent <= 0 || elem == mir_id_invalid() || stride <= 0) {
                self.report_error("cannot configure pointer array shape for "
                          + llvm_mir_type_text(&self.m, payload_type));
                return false;
            }
            let args = malloc(40);
            if (args == null) {
                self.report_error("cannot allocate pointer array-shape arguments");
                return false;
            }
            ast_write_rawptr(args, metadata);
            ast_write_rawptr(ptr_offset(args, 8), vyx_rt_const_int(self.mod, self.ty_i32, rank as i64, 0));
            ast_write_rawptr(ptr_offset(args, 16), vyx_rt_const_int(self.mod, self.ty_i32, level as i64, 0));
            ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i64, extent, 0));
            ast_write_rawptr(ptr_offset(args, 32), vyx_rt_const_int(self.mod, self.ty_i64, stride, 0));
            let configured = vyx_rt_build_call(self.mod,
                                                self.pointer_region_set_dimension_fty,
                                                self.pointer_region_set_dimension_fn,
                                                args,
                                                5,
                                                llvm_mir_empty_name(),
                                                0);
            free(args);
            if (configured == null) {
                self.report_error("cannot configure pointer array dimension #" + level.toString());
                return false;
            }
            current = elem;
            level = level + 1;
        }
        return true;
    }

    public fn pointer_handle_retag(self,
                                   handle: rawptr,
                                   capability: i32,
                                   name: string) -> rawptr {
        if (handle == null || self.pointer_region_retag_fn == null
            || self.pointer_region_retag_fty == null) {
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        let tagged = vyx_rt_build_call2(self.mod,
                                        self.pointer_region_retag_fty,
                                        self.pointer_region_retag_fn,
                                        metadata,
                                        vyx_rt_const_int(self.mod, self.ty_i32, capability as i64, 0),
                                        "mir.ptr.retag".c_str(),
                                        13);
        if (address == null || metadata == null || tagged == null) { return null; }
        return self.build_pointer_handle(address, tagged, name + ".retag");
    }

    public fn pointer_checked_address(self,
                                      handle: rawptr,
                                      index: rawptr,
                                      element_size: i64,
                                      pointer_depth: i32,
                                      name: string) -> rawptr {
        if (handle == null || index == null || element_size <= 0
            || self.pointer_checked_address_typed_fn == null
            || self.pointer_checked_address_typed_fty == null) {
            self.report_error("pointer checked-address runtime is not available");
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        if (address == null || metadata == null) { return null; }
        if (!llvm_mir_inline_pointer_checks_disabled()) {
            return self.emit_inline_pointer_checked_address(address,
                                                            metadata,
                                                            index,
                                                            element_size,
                                                            pointer_depth,
                                                            name);
        }
        let args = malloc(40);
        if (args == null) {
            self.report_error("cannot allocate pointer check arguments");
            return null;
        }
        ast_write_rawptr(args, address);
        ast_write_rawptr(ptr_offset(args, 8), metadata);
        ast_write_rawptr(ptr_offset(args, 16), index);
        ast_write_rawptr(ptr_offset(args, 24), vyx_rt_const_int(self.mod, self.ty_i64, element_size, 0));
        ast_write_rawptr(ptr_offset(args, 32), vyx_rt_const_int(self.mod, self.ty_i32, pointer_depth as i64, 0));
        let out = vyx_rt_build_call(self.mod,
                                    self.pointer_checked_address_typed_fty,
                                    self.pointer_checked_address_typed_fn,
                                    args,
                                    5,
                                    name.c_str(),
                                    name.len as u64);
        free(args);
        return out;
    }

    /// Lazily-created anonymous alias-scope domain shared by every
    /// typed-pointer audit access in this module.  Declaring audit
    /// bookkeeping (region metadata, handle slots) and user payload memory
    /// as disjoint alias domains lets LICM hoist the whole inline check out
    /// of loops: without it, the payload store inside the loop clobbers the
    /// audit loads through opaque inttoptr/ptrtoint round-trips and forces a
    /// full re-audit per iteration.
    public fn pointer_alias_domain(self) -> rawptr {
        if (self.ptr_alias_domain == null) {
            self.ptr_alias_domain = vyx_rt_alias_scope_domain(self.mod);
        }
        return self.ptr_alias_domain;
    }

    /// Load through `slot` with the pointer-audit alias scope attached.
    /// kind selects the loaded type's build call; scope_kind 0 marks the
    /// access as audit bookkeeping (noalias w.r.t. payload memory).
    fn audited_load_i64(self, slot: rawptr, name: string) -> rawptr {
        let v = vyx_rt_build_load(self.mod, self.ty_i64, slot,
                                  name.c_str(), name.len as u64);
        if (v != null && self.ptr_alias_domain != null) {
            vyx_rt_set_alias_scopes(self.mod, v, self.ptr_alias_domain, 0);
        }
        return v;
    }

    fn audited_load_ptr(self, slot: rawptr, name: string) -> rawptr {
        let v = vyx_rt_build_load(self.mod, self.ty_ptr, slot,
                                  name.c_str(), name.len as u64);
        if (v != null && self.ptr_alias_domain != null) {
            vyx_rt_set_alias_scopes(self.mod, v, self.ptr_alias_domain, 0);
        }
        return v;
    }

    /// Payload load/store: belongs to the payload domain, noalias w.r.t.
    /// the audit bookkeeping the check chain reads.
    public fn payload_scoped_store(self, val: rawptr, addr: rawptr) -> rawptr {
        if (self.ptr_alias_domain == null) {
            vyx_rt_build_store(self.mod, val, addr);
            return null;
        }
        vyx_rt_set_alias_scopes_on_store(self.mod, val, addr, self.ptr_alias_domain, 1);
        return null;
    }

    // Straight-line expansion of rt_pointer_checked_address()'s contract
    // (metadata tag decode, region liveness, shape extent, multiplication
    // overflow and span audits).  Emitting the checks as visible IR instead
    // of an opaque `vyx_pointer_checked_address_typed` call restores LLVM
    // inlining/LICM/CSE for `*T` loops.  The C++ backend performs the
    // equivalent expansion inline via its `ptr_checked_address` template, so
    // both backends share one semantics owner contract.
    public fn emit_inline_pointer_checked_address(self,
                                                   address: rawptr,
                                                   metadata: rawptr,
                                                   index: rawptr,
                                                   element_size: i64,
                                                   pointer_depth: i32,
                                                   name: string) -> rawptr {
        if (self.builtin_abort_fn == null || self.builtin_abort_fty == null) {
            self.report_error("abort declaration is unavailable");
            return null;
        }
        // Ensure the audit/payload alias domain exists before any audited
        // load below attaches its scope metadata.
        let alias_domain = self.pointer_alias_domain();
        if (alias_domain == null) { return null; }
        let fail_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".pchk.fail").c_str(),
                                          (name.clone() + ".pchk.fail").len as u64);
        let shape_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           (name.clone() + ".pchk.shape").c_str(),
                                           (name.clone() + ".pchk.shape").len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".pchk.cont").c_str(),
                                          (name.clone() + ".pchk.cont").len as u64);
        if (fail_bb == null || shape_bb == null || cont_bb == null) {
            self.report_error("cannot create inline pointer check blocks");
            return null;
        }
        // Entry: decode the capability-tagged metadata word and audit the
        // cheap preconditions (null address/region, dead region, negative
        // index).  element_size is a compile-time constant already validated
        // as > 0 by the caller.
        let meta_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                metadata,
                                                self.ty_i64,
                                                (name.clone() + ".pchk.meta").c_str(),
                                                (name.clone() + ".pchk.meta").len as u64);
        let region_bits = vyx_rt_build_and(self.mod,
                                           meta_bits,
                                           vyx_rt_const_int(self.mod, self.ty_i64, -4, 0),
                                           (name.clone() + ".pchk.rbits").c_str(),
                                           (name.clone() + ".pchk.rbits").len as u64);
        let region = vyx_rt_build_int_to_ptr(self.mod,
                                             region_bits,
                                             self.ty_ptr,
                                             (name.clone() + ".pchk.region").c_str(),
                                             (name.clone() + ".pchk.region").len as u64);
        // Liveness is read with a plain load: the C++ backend's inline
        // ptr_checked_address template reads the same flag non-atomically, and
        // a seq_cst atomic load is opaque to LICM, which would force the check
        // into every loop iteration.  A stale liveness=1 read can only delay a
        // dead-region abort by one access; it cannot admit an out-of-span
        // access because region_delete() also zeroes base/bytes, so the span
        // audit below still fails closed.
        // The liveness flag load is deliberately omitted in the inline path:
        // region_delete()/rt_invalidate_span() zero base and bytes before the
        // flag drops, so the span audit below already fails closed for dead
        // regions.  This matches the runtime's rt_pointer_checked_address()
        // and keeps every remaining check loop-invariant and hoistable.
        let zero_i64 = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let null_ptr = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        let bad_address = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            address,
                                            null_ptr,
                                            llvm_mir_empty_name(),
                                            0);
        let bad_region = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_eq(),
                                           region,
                                           null_ptr,
                                           llvm_mir_empty_name(),
                                           0);
        let bad_index = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_slt(),
                                          index,
                                          zero_i64,
                                          llvm_mir_empty_name(),
                                          0);
        let fail_a = vyx_rt_build_or(self.mod, bad_address, bad_region, llvm_mir_empty_name(), 0);
        let fail_b = bad_index;
        let fail_entry = vyx_rt_build_or(self.mod, fail_a, fail_b, llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, fail_entry, fail_bb, shape_bb);

        // Shape resolution: peel the dimension record for this pointer depth.
        // Without shape info the stride is the element size and the shaped
        // bound check is vacuous.
        vyx_rt_position_at_end(self.mod, shape_bb);
        let max_i64 = vyx_rt_const_int(self.mod, self.ty_i64, 9223372036854775807, 0);
        let elem_stride = vyx_rt_const_int(self.mod, self.ty_i64, element_size, 0);
        var stride: rawptr = elem_stride;
        var bound: rawptr = max_i64;
        if (pointer_depth > 0) {
            let rank_slot = vyx_rt_build_gep1(self.mod,
                                              self.ty_i8,
                                              region,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 32, 0),
                                              (name.clone() + ".pchk.rslot").c_str(),
                                              (name.clone() + ".pchk.rslot").len as u64);
            let rank = self.audited_load_i64(rank_slot, name.clone() + ".pchk.rank");
            let dims_slot = vyx_rt_build_gep1(self.mod,
                                              self.ty_i8,
                                              region,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 40, 0),
                                              (name.clone() + ".pchk.dslot").c_str(),
                                              (name.clone() + ".pchk.dslot").len as u64);
            let dims = self.audited_load_ptr(dims_slot, name.clone() + ".pchk.dims");
            let depth_i64 = vyx_rt_const_int(self.mod, self.ty_i64, pointer_depth as i64, 0);
            let level = vyx_rt_build_sub(self.mod,
                                         rank,
                                         depth_i64,
                                         (name.clone() + ".pchk.level").c_str(),
                                         (name.clone() + ".pchk.level").len as u64);
            let rank_deep = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_sge(),
                                              rank,
                                              depth_i64,
                                              llvm_mir_empty_name(),
                                              0);
            let dims_ok = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ne(),
                                            dims,
                                            null_ptr,
                                            llvm_mir_empty_name(),
                                            0);
            let level_ok = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_sge(),
                                             level,
                                             zero_i64,
                                             llvm_mir_empty_name(),
                                             0);
            let dims_rank_ok = vyx_rt_build_and(self.mod, rank_deep, dims_ok, llvm_mir_empty_name(), 0);
            let dim_valid = vyx_rt_build_and(self.mod, dims_rank_ok, level_ok, llvm_mir_empty_name(), 0);
            let dim_bb = vyx_rt_append_block(self.mod,
                                             self.current_function_value,
                                             (name.clone() + ".pchk.dim").c_str(),
                                             (name.clone() + ".pchk.dim").len as u64);
            let merge_bb = vyx_rt_append_block(self.mod,
                                               self.current_function_value,
                                               (name.clone() + ".pchk.merge").c_str(),
                                               (name.clone() + ".pchk.merge").len as u64);
            if (dim_bb == null || merge_bb == null) {
                self.report_error("cannot create inline pointer shape blocks");
                return null;
            }
            vyx_rt_build_cond_br(self.mod, dim_valid, dim_bb, merge_bb);
            vyx_rt_position_at_end(self.mod, dim_bb);
            let sixteen = vyx_rt_const_int(self.mod, self.ty_i64, 16, 0);
            let dim_off = vyx_rt_build_mul(self.mod,
                                           level,
                                           sixteen,
                                           (name.clone() + ".pchk.doff").c_str(),
                                           (name.clone() + ".pchk.doff").len as u64);
            let extent_slot = vyx_rt_build_gep1(self.mod,
                                                self.ty_i8,
                                                dims,
                                                dim_off,
                                                (name.clone() + ".pchk.eslot").c_str(),
                                                (name.clone() + ".pchk.eslot").len as u64);
            let extent = self.audited_load_i64(extent_slot, name.clone() + ".pchk.extent");
            let stride_off = vyx_rt_build_add(self.mod,
                                              dim_off,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 8, 0),
                                              (name.clone() + ".pchk.soff").c_str(),
                                              (name.clone() + ".pchk.soff").len as u64);
            let stride_slot = vyx_rt_build_gep1(self.mod,
                                                self.ty_i8,
                                                dims,
                                                stride_off,
                                                (name.clone() + ".pchk.sslot2").c_str(),
                                                (name.clone() + ".pchk.sslot2").len as u64);
            let dim_stride = self.audited_load_i64(stride_slot, name.clone() + ".pchk.dstride");
            vyx_rt_build_br(self.mod, merge_bb);
            vyx_rt_position_at_end(self.mod, merge_bb);
            let extent_phi = vyx_rt_build_phi(self.mod,
                                              self.ty_i64,
                                              (name.clone() + ".pchk.extentsel").c_str(),
                                              (name.clone() + ".pchk.extentsel").len as u64);
            vyx_rt_add_incoming(self.mod, extent_phi, max_i64, shape_bb);
            vyx_rt_add_incoming(self.mod, extent_phi, extent, dim_bb);
            let stride_phi = vyx_rt_build_phi(self.mod,
                                              self.ty_i64,
                                              (name.clone() + ".pchk.stridesel").c_str(),
                                              (name.clone() + ".pchk.stridesel").len as u64);
            vyx_rt_add_incoming(self.mod, stride_phi, elem_stride, shape_bb);
            vyx_rt_add_incoming(self.mod, stride_phi, dim_stride, dim_bb);
            let extent_positive = vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_sgt(),
                                                    extent_phi,
                                                    zero_i64,
                                                    llvm_mir_empty_name(),
                                                    0);
            let stride_positive = vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_sgt(),
                                                    stride_phi,
                                                    zero_i64,
                                                    llvm_mir_empty_name(),
                                                    0);
            let shape_pos_ok = vyx_rt_build_and(self.mod,
                                                extent_positive,
                                                stride_positive,
                                                llvm_mir_empty_name(),
                                                0);
            let shaped = vyx_rt_build_and(self.mod, dim_valid, shape_pos_ok, llvm_mir_empty_name(), 0);
            stride = vyx_rt_build_select(self.mod,
                                         shaped,
                                         stride_phi,
                                         elem_stride,
                                         (name.clone() + ".pchk.stride").c_str(),
                                         (name.clone() + ".pchk.stride").len as u64);
            bound = vyx_rt_build_select(self.mod,
                                        shaped,
                                        extent_phi,
                                        max_i64,
                                        (name.clone() + ".pchk.bound").c_str(),
                                        (name.clone() + ".pchk.bound").len as u64);
        }

        // Common tail: shaped bound, multiplication overflow and span audits.
        let overflow_limit = vyx_rt_build_sdiv(self.mod,
                                               max_i64,
                                               stride,
                                               (name.clone() + ".pchk.lim").c_str(),
                                               (name.clone() + ".pchk.lim").len as u64);
        let overflows = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_sgt(),
                                          index,
                                          overflow_limit,
                                          llvm_mir_empty_name(),
                                          0);
        let out_of_extent = vyx_rt_build_icmp(self.mod,
                                              llvm_mir_icmp_sge(),
                                              index,
                                              bound,
                                              llvm_mir_empty_name(),
                                              0);
        let base_slot = vyx_rt_build_gep1(self.mod,
                                          self.ty_i8,
                                          region,
                                          zero_i64,
                                          (name.clone() + ".pchk.bslot").c_str(),
                                          (name.clone() + ".pchk.bslot").len as u64);
        let base = self.audited_load_ptr(base_slot, name.clone() + ".pchk.base");
        let bytes_slot = vyx_rt_build_gep1(self.mod,
                                           self.ty_i8,
                                           region,
                                           vyx_rt_const_int(self.mod, self.ty_i64, 8, 0),
                                           (name.clone() + ".pchk.zslot").c_str(),
                                           (name.clone() + ".pchk.zslot").len as u64);
        let region_bytes = self.audited_load_i64(bytes_slot, name.clone() + ".pchk.bytes");
        let address_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                   address,
                                                   self.ty_i64,
                                                   (name.clone() + ".pchk.abits").c_str(),
                                                   (name.clone() + ".pchk.abits").len as u64);
        let base_bits = vyx_rt_build_ptr_to_int(self.mod,
                                                base,
                                                self.ty_i64,
                                                (name.clone() + ".pchk.bbits").c_str(),
                                                (name.clone() + ".pchk.bbits").len as u64);
        let below_base = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_ult(),
                                           address_bits,
                                           base_bits,
                                           llvm_mir_empty_name(),
                                           0);
        let raw_offset = vyx_rt_build_sub(self.mod,
                                          address_bits,
                                          base_bits,
                                          (name.clone() + ".pchk.roff").c_str(),
                                          (name.clone() + ".pchk.roff").len as u64);
        let outside_span = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_ugt(),
                                             raw_offset,
                                             region_bytes,
                                             llvm_mir_empty_name(),
                                             0);
        let delta = vyx_rt_build_mul(self.mod,
                                     index,
                                     stride,
                                     (name.clone() + ".pchk.delta").c_str(),
                                     (name.clone() + ".pchk.delta").len as u64);
        let delta_overflow = vyx_rt_build_icmp(self.mod,
                                               llvm_mir_icmp_sgt(),
                                               delta,
                                               region_bytes,
                                               llvm_mir_empty_name(),
                                               0);
        let room = vyx_rt_build_sub(self.mod,
                                    region_bytes,
                                    delta,
                                    (name.clone() + ".pchk.room").c_str(),
                                    (name.clone() + ".pchk.room").len as u64);
        let offset_overflow = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_sgt(),
                                                raw_offset,
                                                room,
                                                llvm_mir_empty_name(),
                                                0);
        let tail_room = vyx_rt_build_sub(self.mod,
                                         room,
                                         raw_offset,
                                         (name.clone() + ".pchk.tail").c_str(),
                                         (name.clone() + ".pchk.tail").len as u64);
        let access_overflow = vyx_rt_build_icmp(self.mod,
                                                llvm_mir_icmp_sgt(),
                                                stride,
                                                tail_room,
                                                llvm_mir_empty_name(),
                                                0);
        let fail_c = vyx_rt_build_or(self.mod, overflows, out_of_extent, llvm_mir_empty_name(), 0);
        let fail_d = vyx_rt_build_or(self.mod, below_base, outside_span, llvm_mir_empty_name(), 0);
        let fail_e = vyx_rt_build_or(self.mod, delta_overflow, offset_overflow, llvm_mir_empty_name(), 0);
        let fail_cd = vyx_rt_build_or(self.mod, fail_c, fail_d, llvm_mir_empty_name(), 0);
        let fail_tail = vyx_rt_build_or(self.mod, fail_cd, vyx_rt_build_or(self.mod, fail_e, access_overflow, llvm_mir_empty_name(), 0), llvm_mir_empty_name(), 0);
        vyx_rt_build_cond_br(self.mod, fail_tail, fail_bb, cont_bb);

        vyx_rt_position_at_end(self.mod, fail_bb);
        vyx_rt_build_call(self.mod,
                          self.builtin_abort_fty,
                          self.builtin_abort_fn,
                          null,
                          0,
                          llvm_mir_empty_name(),
                          0);
        vyx_rt_build_unreachable(self.mod);

        vyx_rt_position_at_end(self.mod, cont_bb);
        return vyx_rt_build_gep1(self.mod,
                                 self.ty_i8,
                                 address,
                                 delta,
                                 (name.clone() + ".pchk.addr").c_str(),
                                 (name.clone() + ".pchk.addr").len as u64);
    }

    public fn pointer_handle_alive(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null || self.pointer_handle_alive_fn == null
            || self.pointer_handle_alive_fty == null) {
            return null;
        }
        let address = self.pointer_handle_address(handle, name);
        let metadata = self.pointer_handle_metadata(handle, name);
        if (address == null || metadata == null) { return null; }
        let alive = vyx_rt_build_call2(self.mod,
                                       self.pointer_handle_alive_fty,
                                       self.pointer_handle_alive_fn,
                                       address,
                                       metadata,
                                       name.c_str(),
                                       name.len as u64);
        if (alive == null) { return null; }
        return vyx_rt_build_icmp(self.mod,
                                 llvm_mir_icmp_ne(),
                                 alive,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 llvm_mir_empty_name(),
                                 0);
    }

    public fn pointer_region_rank_value(self, handle: rawptr, name: string) -> rawptr {
        if (handle == null || self.pointer_region_rank_fn == null
            || self.pointer_region_rank_fty == null) {
            return null;
        }
        let metadata = self.pointer_handle_metadata(handle, name);
        if (metadata == null) { return null; }
        return vyx_rt_build_call1(self.mod,
                                  self.pointer_region_rank_fty,
                                  self.pointer_region_rank_fn,
                                  metadata,
                                  name.c_str(),
                                  name.len as u64);
    }

    public fn pointer_type_depth(self, type_id: i32) -> i32 {
        var current = type_id;
        var depth: i32 = 0;
        while (current != mir_id_invalid() && depth < 64) {
            let kind = llvm_mir_type_kind(&self.m, current);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) { break; }
            depth = depth + 1;
            current = hir_type_table_elem(self.m.types, current);
        }
        return depth;
    }

    public fn pointer_index_shape_depth(self, pointer_type: i32) -> i32 {
        if (pointer_type == mir_id_invalid()) { return 0; }
        let pointee = hir_type_table_elem(self.m.types, pointer_type);
        if (pointee != mir_id_invalid()
            && llvm_mir_type_kind(&self.m, pointee) == ty_ARRAY()) {
            return 0;
        }
        return self.pointer_type_depth(pointer_type);
    }

    public fn pointer_projected_place_addr(self,
                                           handle: rawptr,
                                           checked_address: rawptr,
                                           result_type: i32,
                                           pointer_depth: i32,
                                           name: string) -> rawptr {
        if (handle == null || checked_address == null || result_type == mir_id_invalid()
            || !llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, result_type))) {
            return checked_address;
        }
        if (pointer_depth <= 0 || self.current_function_value == null) { return checked_address; }
        let rank = self.pointer_region_rank_value(handle, name + ".rank");
        let metadata = self.pointer_handle_metadata(handle, name + ".project");
        let handle_ty = self.get_or_create_pointer_handle_ty();
        if (rank == null || metadata == null || handle_ty == null) { return null; }
        let shaped = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_sge(),
                                       rank,
                                       vyx_rt_const_int(self.mod, self.ty_i32, pointer_depth as i64, 0),
                                       (name.clone() + ".is.shaped").c_str(),
                                       (name.clone() + ".is.shaped").len as u64);
        let projected_slot = vyx_rt_build_alloca(self.mod,
                                                 handle_ty,
                                                 (name.clone() + ".slot").c_str(),
                                                 (name.clone() + ".slot").len as u64);
        let shaped_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            (name.clone() + ".shaped").c_str(),
                                            (name.clone() + ".shaped").len as u64);
        let direct_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            (name.clone() + ".direct").c_str(),
                                            (name.clone() + ".direct").len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          (name.clone() + ".cont").c_str(),
                                          (name.clone() + ".cont").len as u64);
        if (shaped == null || projected_slot == null || shaped_bb == null
            || direct_bb == null || cont_bb == null) {
            self.report_error("cannot create multidimensional pointer projection flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, shaped, shaped_bb, direct_bb);

        vyx_rt_position_at_end(self.mod, shaped_bb);
        let projected = self.build_pointer_handle(checked_address,
                                                  metadata,
                                                  name + ".value");
        if (projected == null) { return null; }
        vyx_rt_build_store(self.mod, projected, projected_slot);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, direct_bb);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, cont_bb);
        let slot_phi = vyx_rt_build_phi(self.mod,
                                        self.ty_ptr,
                                        (name.clone() + ".address").c_str(),
                                        (name.clone() + ".address").len as u64);
        if (slot_phi == null) {
            self.report_error("cannot select multidimensional pointer projection storage");
            return null;
        }
        vyx_rt_add_incoming(self.mod, slot_phi, projected_slot, shaped_bb);
        vyx_rt_add_incoming(self.mod, slot_phi, checked_address, direct_bb);
        return slot_phi;
    }

    public fn pointer_region_delete(self, metadata: rawptr) -> rawptr {
        if (metadata == null || self.pointer_region_delete_fn == null
            || self.pointer_region_delete_fty == null) {
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.pointer_region_delete_fty,
                                  self.pointer_region_delete_fn,
                                  metadata,
                                  llvm_mir_empty_name(),
                                  0);
    }

    public fn lower_type(self, type_id: i32) -> rawptr {
        if (self.type_is_option_abi(type_id)) { return self.get_or_create_option_ty(type_id); }
        if (self.type_is_result_abi(type_id)) { return self.get_or_create_result_ty(type_id); }
        let raw_kind = llvm_mir_type_kind(&self.m, type_id);
        if (raw_kind == ty_RAWPTR()) { return self.ty_ptr; }
        if (raw_kind == ty_PTR() || raw_kind == ty_REF() || raw_kind == ty_MUTREF()) {
            return self.get_or_create_pointer_handle_ty();
        }
        let canonical_type = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical_type);
        if (kind == ty_VOID()) { return self.ty_void; }
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return self.ty_i8; }
        if (kind == ty_I16() || kind == ty_U16()) { return self.ty_i16; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32()) { return self.ty_i32; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE() || kind == ty_USIZE()) { return self.ty_i64; }
        if (kind == ty_F32()) { return vyx_rt_float_type(self.mod, 32); }
        if (kind == ty_F64()) { return vyx_rt_float_type(self.mod, 64); }
        if (kind == ty_RAWPTR()) { return self.ty_ptr; }
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            return self.get_or_create_pointer_handle_ty();
        }
        if (kind == ty_FN() || kind == ty_CFN()) { return self.ty_ptr; }
        if (kind == ty_STRING()) { return self.get_string_ty(); }
        if (kind == ty_TUPLE()) { return self.get_or_create_tuple_ty(canonical_type); }
        if (kind == ty_ARRAY()) {
            let cached_arr = llvm_mir_map_get(self.type_struct_values, canonical_type);
            if (cached_arr != null) { return cached_arr; }
            let elem = hir_type_table_elem(self.m.types, canonical_type);
            let count = self.array_length_for_type(canonical_type);
            if (elem == mir_id_invalid() || count < 0) {
                self.report_error("array type has no concrete length: " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            let elem_ty = self.lower_type(elem);
            if (elem_ty == null) {
                self.report_error("cannot lower array element type for " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            let array_ty = vyx_rt_array_ty(self.mod, elem_ty, count as u64);
            if (array_ty == null) {
                self.report_error("cannot create LLVM array type for " + llvm_mir_type_text(&self.m, canonical_type));
                return null;
            }
            llvm_mir_map_put(self.type_struct_values, canonical_type, array_ty);
            return array_ty;
        }
        if (kind == ty_CLASS()) {
            let text = llvm_mir_type_text(&self.m, canonical_type);
            if (llvm_mir_is_primitive_str_name(text)) { return self.get_string_ty(); }
            if (self.type_is_dyn_trait(canonical_type)) { return self.get_or_create_dyn_trait_ty(canonical_type); }
            if (self.type_is_option_abi(canonical_type)) { return self.get_or_create_option_ty(canonical_type); }
            if (self.type_is_result_abi(canonical_type)) { return self.get_or_create_result_ty(canonical_type); }
            if (mir_unit_variant_count_for_type(&self.m, canonical_type) > 0
                && mir_unit_field_count_for_type(&self.m, canonical_type) == 0) {
                return self.get_or_create_enum_ty(canonical_type);
            }
            if (self.type_is_class_pointer_abi(canonical_type)) {
                return self.ty_ptr;
            }
            if (self.type_is_value_struct_abi(canonical_type)) {
                return self.get_or_create_record_ty(canonical_type);
            }
            return self.ty_ptr;
        }
        return self.ty_ptr;
    }

    public fn get_string_ty(self) -> rawptr {
        if (self.string_ty != null) { return self.string_ty; }
        let st = vyx_rt_struct_ty_named(self.mod, "__String".c_str(), 8);
        if (st == null) {
            self.report_error("cannot create str ABI type");
            return null;
        }
        let fields = malloc(32);
        if (fields == null) {
            self.report_error("cannot allocate str ABI field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_i64);
        ast_write_rawptr(ptr_offset(fields, 16), self.ty_i64);
        ast_write_rawptr(ptr_offset(fields, 24), self.ty_i64);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 4, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize str ABI type");
            return null;
        }
        free(fields);
        self.string_ty = st;
        return st;
    }

    public fn get_or_create_closure_fat_ty(self) -> rawptr {
        if (self.closure_fat_ty != null) { return self.closure_fat_ty; }
        let name = "__VyxClosureFat";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create closure fat type");
            return null;
        }
        let fields = malloc(16);
        if (fields == null) {
            self.report_error("cannot allocate closure fat field list");
            return null;
        }
        ast_write_rawptr(fields, self.ty_ptr);
        ast_write_rawptr(ptr_offset(fields, 8), self.ty_ptr);
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, 2, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize closure fat type");
            return null;
        }
        free(fields);
        self.closure_fat_ty = st;
        return st;
    }

    public fn function_capture_count(self, function_id: i32) -> i32 {
        var out: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_capture(local)) { out = out + 1; }
            local = self.m.local_next(local);
        }
        return out;
    }

    public fn local_is_source_param(self, local_id: i32) -> bool {
        if (local_id == mir_id_invalid()) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_param()) != 0;
    }

    public fn local_is_capture(self, local_id: i32) -> bool {
        if (local_id == mir_id_invalid()) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_capture()) != 0;
    }

    public fn local_is_reference_capture(self, local_id: i32) -> bool {
        if (local_id == mir_id_invalid()) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_reference_capture()) != 0;
    }

    public fn local_is_self_receiver_param(self, local_id: i32) -> bool {
        if (!self.local_is_source_param(local_id)) { return false; }
        return (self.m.local_flags(local_id) & mir_local_flag_self_receiver()) != 0;
    }

    // This first lifetime-intrinsic slice deliberately accepts only plain
    // non-pointer scalar source locals. A raw pointer may carry an address of
    // local, foreign, or aliasing storage even when no MIR address_of node is
    // visible, so it is not positive evidence for an early lifetime end or a
    // reusable alloca. Aggregate, owning, DCI, and derived-place storage stay
    // outside the proof until escape/liveness are first-class analyses.
    public fn local_lifetime_marker_type_supported(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        return llvm_mir_int_bits_for_kind(kind) > 0 || llvm_mir_kind_float(kind);
    }

    public fn storage_instr_direct_local(self, instr_id: i32) -> i32 {
        if (instr_id == mir_id_invalid()) { return mir_id_invalid(); }
        let place_id = self.m.instr_place(instr_id);
        if (place_id == mir_id_invalid() || self.m.place_kind(place_id) != mir_place_local()) {
            return mir_id_invalid();
        }
        return self.m.place_local(place_id);
    }

    public fn local_lifetime_marker_has_address_or_capture(self, local_id: i32) -> bool {
        var value_id: i32 = 1;
        while (value_id <= self.m.value_count) {
            if (self.m.value_kind(value_id) == mir_value_address_of()) {
                let place_id = self.m.value_place(value_id);
                if (place_id != mir_id_invalid()
                    && self.m.place_kind(place_id) == mir_place_local()
                    && self.m.place_local(place_id) == local_id) {
                    return true;
                }
            }
            value_id = value_id + 1;
        }
        var other_local: i32 = 1;
        while (other_local <= self.m.local_count) {
            if (self.m.local_capture_source(other_local) == local_id) { return true; }
            other_local = other_local + 1;
        }
        return false;
    }

    // A non-direct place is intentionally a barrier here. This bounded proof
    // does not attempt alias analysis for fields, dereferences, indexes, or
    // malformed/cyclic value graphs.
    public fn local_lifetime_marker_value_uses_local(self,
                                                     value_id: i32,
                                                     local_id: i32) -> bool {
        if (value_id == mir_id_invalid()) { return false; }
        if (value_id <= 0 || value_id > self.m.value_count
            || self.local_lifetime_marker_value_visit_budget <= 0) {
            self.local_lifetime_marker_value_query_failed = true;
            return true;
        }
        self.local_lifetime_marker_value_visit_budget = self.local_lifetime_marker_value_visit_budget - 1;
        let place_id = self.m.value_place(value_id);
        if (place_id != mir_id_invalid()) {
            if (place_id <= 0 || place_id > self.m.place_count
                || self.m.place_kind(place_id) != mir_place_local()) {
                return true;
            }
            if (self.m.place_local(place_id) == local_id) { return true; }
        }
        if (self.m.value_target_kind(value_id) == mir_target_local()
            && self.m.value_target_id(value_id) == local_id) {
            return true;
        }
        if (self.local_lifetime_marker_value_uses_local(self.m.value_lhs(value_id),
                                                         local_id)) { return true; }
        if (self.local_lifetime_marker_value_uses_local(self.m.value_rhs(value_id),
                                                         local_id)) { return true; }
        if (self.local_lifetime_marker_value_uses_local(self.m.value_aux(value_id),
                                                         local_id)) { return true; }
        var arg_id = self.m.value_first_arg(value_id);
        var guard: i32 = 0;
        while (arg_id != mir_id_invalid()) {
            if (guard > self.m.value_count) {
                self.local_lifetime_marker_value_query_failed = true;
                return true;
            }
            if (self.local_lifetime_marker_value_uses_local(arg_id, local_id)) {
                return true;
            }
            arg_id = self.m.value_next_arg(arg_id);
            guard = guard + 1;
        }
        return false;
    }

    public fn local_lifetime_marker_instr_mentions_local(self,
                                                         instr_id: i32,
                                                         local_id: i32) -> bool {
        let place_id = self.m.instr_place(instr_id);
        if (place_id != mir_id_invalid()) {
            if (place_id <= 0 || place_id > self.m.place_count
                || self.m.place_kind(place_id) != mir_place_local()) {
                return true;
            }
            if (self.m.place_local(place_id) == local_id) { return true; }
        }
        if (self.m.instr_target_kind(instr_id) == mir_target_local()
            && self.m.instr_target_id(instr_id) == local_id) {
            return true;
        }
        return self.local_lifetime_marker_value_uses_local(self.m.instr_value(instr_id), local_id)
            || self.local_lifetime_marker_value_uses_local(self.m.instr_lhs(instr_id), local_id)
            || self.local_lifetime_marker_value_uses_local(self.m.instr_rhs(instr_id), local_id);
    }

    public fn local_lifetime_marker_candidate(self,
                                              function_id: i32,
                                              local_id: i32) -> bool {
        if (local_id == mir_id_invalid() || self.m.local_function(local_id) != function_id) {
            return false;
        }
        // Cross-block intervals need dominance/post-dominance and C++ scope
        // proofs. Do not infer either from lexical StorageDead records.
        if (self.m.function_block_count(function_id) != 1
            || self.m.function_local_count(function_id) > llvm_mir_lifetime_marker_max_function_locals()) {
            return false;
        }
        let block_id = self.m.function_first_block(function_id);
        if (block_id == mir_id_invalid() || self.m.block_term_kind(block_id) != mir_term_return()
            || self.m.block_instr_count(block_id) > llvm_mir_lifetime_marker_max_block_instrs()) {
            return false;
        }
        let flags = self.m.local_flags(local_id);
        let rejected_flags = mir_local_flag_param()
            | mir_local_flag_capture()
            | mir_local_flag_auto_drop()
            | mir_local_flag_move_arg()
            | mir_local_flag_self_receiver()
            | mir_local_flag_reference_capture()
            | mir_local_flag_if_expr_result();
        if ((flags & rejected_flags) != 0
            || !self.local_lifetime_marker_type_supported(self.local_effective_type(local_id))
            || self.local_is_self_pointer_abi_slot(function_id, local_id)) {
            return false;
        }
        let local_place = self.m.local_place(local_id);
        if (local_place == mir_id_invalid()
            || self.m.place_kind(local_place) != mir_place_local()
            || self.m.place_local(local_place) != local_id
            || self.local_lifetime_marker_has_address_or_capture(local_id)) {
            return false;
        }

        // A StorageDead marker is only legal metadata when no later MIR
        // instruction or terminator reads/writes the local. The old paired
        // marker check did not establish this, which would let LLVM optimize
        // a post-dead use as undefined behavior.
        self.local_lifetime_marker_value_visit_budget = llvm_mir_lifetime_marker_max_value_visits();
        self.local_lifetime_marker_value_query_failed = false;
        var phase: i32 = 0;
        var live_order: i32 = 0;
        var dead_order: i32 = 0;
        var instr_id = self.m.block_first_instr(block_id);
        var guard: i32 = 0;
        while (instr_id != mir_id_invalid()) {
            let instr_order = guard + 1;
            let instr_kind = self.m.instr_kind(instr_id);
            let direct_local = self.storage_instr_direct_local(instr_id);
            if (direct_local == local_id) {
                if (instr_kind == mir_instr_storage_live()) {
                    if (phase != 0) { return false; }
                    phase = 1;
                    live_order = instr_order;
                } else if (instr_kind == mir_instr_storage_dead()) {
                    if (phase != 1) { return false; }
                    phase = 2;
                    dead_order = instr_order;
                } else if (instr_kind == mir_instr_drop()) {
                    return false;
                } else if (phase != 1) {
                    return false;
                }
            } else {
                let mentions = self.local_lifetime_marker_instr_mentions_local(instr_id, local_id);
                if (self.local_lifetime_marker_value_query_failed
                    || (mentions && phase != 1)) {
                    return false;
                }
            }
            instr_id = self.m.instr_next(instr_id);
            guard = guard + 1;
            if (guard > self.m.instr_count + 1) { return false; }
        }
        let term_uses_local = self.local_lifetime_marker_value_uses_local(self.m.block_term_value(block_id), local_id);
        if (phase != 2 || self.local_lifetime_marker_value_query_failed || term_uses_local) {
            return false;
        }
        if (live_order <= 0 || dead_order <= live_order) { return false; }
        llvm_mir_i32_map_put(self.local_lifetime_marker_live_orders, local_id, live_order);
        llvm_mir_i32_map_put(self.local_lifetime_marker_dead_orders, local_id, dead_order);
        return true;
    }

    // Orders are recorded while walking the block instruction chain, rather
    // than inferred from InstrId. That makes pair selection O(1) per prior
    // local and keeps record-id allocation out of the lifetime proof.
    public fn local_lifetime_marker_interval_precedes(self,
                                                      function_id: i32,
                                                      earlier_local: i32,
                                                      later_local: i32) -> bool {
        if (earlier_local == mir_id_invalid() || later_local == mir_id_invalid()
            || earlier_local == later_local
            || llvm_mir_i32_map_get(self.local_lifetime_marker_candidates, earlier_local) != 1
            || llvm_mir_i32_map_get(self.local_lifetime_marker_candidates, later_local) != 1) {
            return false;
        }
        if (self.m.function_block_count(function_id) != 1) {
            return false;
        }
        let earlier_dead = llvm_mir_i32_map_get(self.local_lifetime_marker_dead_orders, earlier_local);
        let later_live = llvm_mir_i32_map_get(self.local_lifetime_marker_live_orders, later_local);
        return earlier_dead > 0 && later_live > 0 && earlier_dead < later_live;
    }

    // Reuse is stricter than lifetime metadata: it accepts only primitive
    // direct-place arithmetic/dataflow. Calls, DCI, aggregates, address/borrow
    // operations and hidden control-flow values all fail this whitelist.
    public fn local_slot_reuse_value_is_simple(self,
                                               value_id: i32,
                                               depth: i32) -> bool {
        if (value_id == mir_id_invalid()) { return true; }
        if (value_id <= 0 || value_id > self.m.value_count || depth > 16
            || self.local_lifetime_marker_value_visit_budget <= 0
            || !self.local_lifetime_marker_type_supported(self.m.value_type(value_id))) {
            return false;
        }
        self.local_lifetime_marker_value_visit_budget = self.local_lifetime_marker_value_visit_budget - 1;
        if (self.m.value_first_arg(value_id) != mir_id_invalid()
            || self.m.value_next_arg(value_id) != mir_id_invalid()) {
            return false;
        }
        let kind = self.m.value_kind(value_id);
        if (kind == mir_value_const_int() || kind == mir_value_const_bool()
            || kind == mir_value_const_char() || kind == mir_value_null()
            || kind == mir_value_const_float()) {
            return true;
        }
        if (kind == mir_value_read_place()) {
            let place_id = self.m.value_place(value_id);
            return place_id != mir_id_invalid()
                && place_id > 0
                && place_id <= self.m.place_count
                && self.m.place_kind(place_id) == mir_place_local()
                && self.local_lifetime_marker_type_supported(self.m.place_type(place_id));
        }
        if (kind == mir_value_unary() || kind == mir_value_cast() || kind == mir_value_arg()) {
            return self.local_slot_reuse_value_is_simple(self.m.value_lhs(value_id), depth + 1)
                && self.m.value_rhs(value_id) == mir_id_invalid()
                && self.m.value_aux(value_id) == mir_id_invalid();
        }
        if (kind == mir_value_binary()) {
            return self.local_slot_reuse_value_is_simple(self.m.value_lhs(value_id), depth + 1)
                && self.local_slot_reuse_value_is_simple(self.m.value_rhs(value_id), depth + 1)
                && self.m.value_aux(value_id) == mir_id_invalid();
        }
        return false;
    }

    public fn local_slot_reuse_instr_is_supported(self, instr_id: i32) -> bool {
        let kind = self.m.instr_kind(instr_id);
        if (kind == mir_instr_eval()) {
            return self.local_slot_reuse_value_is_simple(self.m.instr_value(instr_id), 0)
                && self.local_slot_reuse_value_is_simple(self.m.instr_lhs(instr_id), 0)
                && self.local_slot_reuse_value_is_simple(self.m.instr_rhs(instr_id), 0);
        }
        if (kind != mir_instr_assign()
            || self.m.instr_target_kind(instr_id) != mir_target_none()
            || self.m.instr_target_id(instr_id) != mir_id_invalid()) {
            return false;
        }
        let place_id = self.m.instr_place(instr_id);
        if (place_id == mir_id_invalid() || place_id <= 0 || place_id > self.m.place_count
            || self.m.place_kind(place_id) != mir_place_local()
            || !self.local_lifetime_marker_type_supported(self.m.place_type(place_id))) {
            return false;
        }
        return self.local_slot_reuse_value_is_simple(self.m.instr_value(instr_id), 0)
            && self.local_slot_reuse_value_is_simple(self.m.instr_lhs(instr_id), 0)
            && self.local_slot_reuse_value_is_simple(self.m.instr_rhs(instr_id), 0);
    }

    public fn local_slot_reuse_candidate(self,
                                         function_id: i32,
                                         local_id: i32) -> bool {
        if (llvm_mir_i32_map_get(self.local_lifetime_marker_candidates, local_id) != 1
            || self.m.local_hir_id(local_id) == hir_id_invalid()) {
            return false;
        }
        let block_id = self.m.function_first_block(function_id);
        if (block_id == mir_id_invalid() || self.m.function_block_count(function_id) != 1) {
            return false;
        }
        self.local_lifetime_marker_value_visit_budget = llvm_mir_lifetime_marker_max_value_visits();
        var phase: i32 = 0;
        var instr_id = self.m.block_first_instr(block_id);
        var guard: i32 = 0;
        while (instr_id != mir_id_invalid()) {
            let kind = self.m.instr_kind(instr_id);
            let direct_local = self.storage_instr_direct_local(instr_id);
            if (direct_local == local_id) {
                if (kind == mir_instr_storage_live()) {
                    if (phase != 0) { return false; }
                    phase = 1;
                } else if (kind == mir_instr_storage_dead()) {
                    if (phase != 1) { return false; }
                    phase = 2;
                } else if (phase != 1 || !self.local_slot_reuse_instr_is_supported(instr_id)) {
                    return false;
                }
            } else if (phase == 1 && !self.local_slot_reuse_instr_is_supported(instr_id)) {
                return false;
            }
            instr_id = self.m.instr_next(instr_id);
            guard = guard + 1;
            if (guard > self.m.instr_count + 1) { return false; }
        }
        return phase == 2;
    }

    public fn local_slot_reuse_type_compatible(self,
                                               earlier_local: i32,
                                               later_local: i32) -> bool {
        let earlier_type = self.local_effective_type(earlier_local);
        let later_type = self.local_effective_type(later_local);
        // Exact TypeId equality keeps LLVM storage type, ABI alignment, and
        // raw-pointer address space identical. Do not generalize this to a
        // size-based rule until alignment/alias proofs are first-class.
        return earlier_type != mir_id_invalid() && earlier_type == later_type;
    }

    public fn local_slot_reuse_source_for(self,
                                          function_id: i32,
                                          local_id: i32) -> i32 {
        if (llvm_mir_i32_map_get(self.local_slot_reuse_candidates, local_id) != 1
            || llvm_mir_i32_map_get(self.local_slot_reuse_sources, local_id) != 0) {
            return mir_id_invalid();
        }
        var best = mir_id_invalid();
        var prior = self.m.function_first_local(function_id);
        var guard: i32 = 0;
        while (prior != mir_id_invalid() && prior != local_id) {
            if (llvm_mir_i32_map_get(self.local_slot_reuse_candidates, prior) == 1
                // A root alloca is deliberately lent at most once. This
                // prevents a later lexical declaration from overlapping an
                // earlier pair through transitive aliasing.
                && llvm_mir_i32_map_get(self.local_slot_reuse_sources, prior) == 0
                && self.local_slot_reuse_type_compatible(prior, local_id)
                && llvm_mir_map_get(self.local_slots, prior) != null
                && self.local_lifetime_marker_interval_precedes(function_id, prior, local_id)) {
                best = prior;
            }
            prior = self.m.local_next(prior);
            guard = guard + 1;
            if (guard > self.m.local_count + 1) {
                self.report_error("cyclic local chain while selecting slot reuse source");
                return mir_id_invalid();
            }
        }
        return best;
    }

    public fn prepare_local_lifetime_marker_candidates(self, function_id: i32) {
        var local_id = self.m.function_first_local(function_id);
        var guard: i32 = 0;
        while (local_id != mir_id_invalid()) {
            llvm_mir_i32_map_put(self.local_lifetime_marker_live_orders, local_id, 0);
            llvm_mir_i32_map_put(self.local_lifetime_marker_dead_orders, local_id, 0);
            var state: i32 = 0;
            if (self.local_lifetime_marker_candidate(function_id, local_id)) { state = 1; }
            llvm_mir_i32_map_put(self.local_lifetime_marker_candidates, local_id, state);
            var reuse_state: i32 = 0;
            if (state == 1 && self.local_slot_reuse_candidate(function_id, local_id)) {
                reuse_state = 1;
            }
            llvm_mir_i32_map_put(self.local_slot_reuse_candidates, local_id, reuse_state);
            llvm_mir_i32_map_put(self.local_slot_reuse_sources, local_id, 0);
            local_id = self.m.local_next(local_id);
            guard = guard + 1;
            if (guard > self.m.local_count + 1) {
                self.report_error("cyclic local chain while preparing lifetime markers");
                return;
            }
        }
    }

    public fn local_lifetime_marker_selected(self, instr_id: i32) -> bool {
        let local_id = self.storage_instr_direct_local(instr_id);
        return local_id != mir_id_invalid()
            && llvm_mir_i32_map_get(self.local_lifetime_marker_candidates, local_id) == 1;
    }

    public fn emit_local_lifetime_marker(self,
                                         instr_id: i32,
                                         addr: rawptr,
                                         is_start: bool) -> bool {
        if (!self.local_lifetime_marker_selected(instr_id)) { return true; }
        if (addr == null) {
            self.report_error("missing direct alloca for lifetime marker on instr #"
                              + policy_i64_to_string(instr_id as i64));
            return false;
        }
        var marker: rawptr = null;
        if (is_start) { marker = vyx_rt_build_lifetime_start(self.mod, addr); }
        else { marker = vyx_rt_build_lifetime_end(self.mod, addr); }
        if (marker == null) {
            self.report_error("cannot emit LLVM lifetime marker for instr #"
                              + policy_i64_to_string(instr_id as i64));
            return false;
        }
        return true;
    }

    public fn function_has_closure_env_param(self, function_id: i32) -> bool {
        return mir_unit_function_item_kind(&self.m, function_id) == hir_item_closure();
    }

    public fn function_hidden_env_param_count(self, function_id: i32) -> i32 {
        if (self.function_has_closure_env_param(function_id)) { return 1; }
        return 0;
    }

    public fn function_is_foreign_dci(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci(&self.m, function_id);
    }

    public fn function_is_foreign_c(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        return self.m.function_item_kind(function_id) == hir_item_extern_function()
            && !self.function_is_foreign_dci(function_id);
    }

    public fn foreign_c_handle_uses_raw_pointer_abi(self,
                                                     function_id: i32,
                                                     type_id: i32) -> bool {
        // Native subclass thunks declare Vyx overrides as extern C functions.
        // Their pointer parameters and returns therefore carry one address,
        // just like imported C functions, rather than a Vyx pointer handle.
        if ((!self.function_is_foreign_c(function_id)
             && !self.function_is_dci_vyx_override_callback(function_id))
            || type_id == mir_id_invalid()
            || type_id <= 0
            || type_id > self.m.types.count) {
            return false;
        }
        return llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id));
    }

    public fn function_is_foreign_dci_ctor(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_ctor(&self.m, function_id);
    }

    public fn function_is_foreign_dci_dtor(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_dtor(&self.m, function_id);
    }

    public fn function_is_foreign_dci_instance_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_instance_method(&self.m, function_id);
    }

    public fn function_is_foreign_dci_static_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_static_method(&self.m, function_id);
    }

    public fn function_is_foreign_dci_const_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_const_method(&self.m, function_id);
    }

    public fn function_is_foreign_dci_virtual_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_virtual_method(&self.m, function_id);
    }

    public fn function_is_foreign_dci_override_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_override_method(&self.m, function_id);
    }

    public fn function_is_foreign_dci_final_method(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_final_method(&self.m, function_id);
    }

    public fn dci_dispose_indexes(self) {
        if (self.dci_layout_index != null) {
            llvm_mir_dispose_symbol_index(self.dci_layout_index, self.dci_layout_index_cap, true);
            self.dci_layout_index = null;
            self.dci_layout_index_cap = 0;
        }
        if (self.dci_symbol_index != null) {
            llvm_mir_dispose_symbol_index(self.dci_symbol_index, self.dci_symbol_index_cap, true);
            self.dci_symbol_index = null;
            self.dci_symbol_index_cap = 0;
        }
        if (self.dci_alias_index != null) {
            llvm_mir_dispose_symbol_index(self.dci_alias_index, self.dci_alias_index_cap, true);
            self.dci_alias_index = null;
            self.dci_alias_index_cap = 0;
        }
        self.dci_index_ready = false;
        if (self.dci_symbol_object_cache != null) {
            llvm_mir_map_clear_range(self.dci_symbol_object_cache, 1, self.m.function_count);
        }
    }

    fn dci_root_exports_array(self, key: string) -> rawptr {
        return self.dci_exports_array_from(self.dci_json_root, key);
    }

    fn dci_exports_array_from(self, root: rawptr, key: string) -> rawptr {
        let exports = self.dci_json_item(root, "exports");
        if (exports == null || cJSON_IsObject(exports) == 0) { return null; }
        let arr = self.dci_json_item(exports, key);
        if (arr == null || cJSON_IsArray(arr) == 0) { return null; }
        return arr;
    }

    fn dci_dispatch_tables_from(self, root: rawptr) -> rawptr {
        let tables = self.dci_exports_array_from(root, "dispatch_tables");
        if (tables != null && cJSON_GetArraySize(tables) > 0) { return tables; }
        return self.dci_exports_array_from(root, "vtables");
    }

    fn dci_contract_count(self) -> i32 {
        if (self.dci_json_bundle != null) { return dci_bundle_count(self.dci_json_bundle); }
        if (self.dci_json_root != null) { return 1; }
        return 0;
    }

    fn dci_contract_at(self, index: i32) -> rawptr {
        if (self.dci_json_bundle != null) { return dci_bundle_root_at(self.dci_json_bundle, index); }
        if (index == 0) { return self.dci_json_root; }
        return null;
    }

    fn dci_put_layout_name(self, name: string, obj: rawptr) {
        if (name.len == 0 || obj == null) { return; }
        llvm_mir_dci_obj_index_put(self.dci_layout_index, self.dci_layout_index_cap, name, obj);
        if (!llvm_mir_dci_type_name_is_plain(name)) {
            let canon = self.dci_canonical_type_name_text(name);
            if (canon.len > 0 && canon != name) {
                llvm_mir_dci_obj_index_put(self.dci_layout_index, self.dci_layout_index_cap, canon, obj);
            }
        }
    }

    fn dci_put_symbol_key(self, key: string, obj: rawptr) {
        if (key.len == 0 || obj == null) { return; }
        llvm_mir_dci_obj_index_put(self.dci_symbol_index, self.dci_symbol_index_cap, key, obj);
    }

    fn dci_put_alias_name(self, name: string, obj: rawptr) {
        if (name.len == 0 || obj == null) { return; }
        llvm_mir_dci_obj_index_put(self.dci_alias_index, self.dci_alias_index_cap, name, obj);
        if (!llvm_mir_dci_type_name_is_plain(name)) {
            let canon = self.dci_canonical_type_name_text(name);
            if (canon.len > 0 && canon != name) {
                llvm_mir_dci_obj_index_put(self.dci_alias_index, self.dci_alias_index_cap, canon, obj);
            }
        }
    }

    public fn dci_build_indexes(self) {
        self.dci_dispose_indexes();
        if (self.dci_json_root == null) { return; }
        self.dci_layout_index_cap = 65536;
        self.dci_layout_index = llvm_mir_symbol_index_new(self.dci_layout_index_cap);
        self.dci_symbol_index_cap = 131072;
        self.dci_symbol_index = llvm_mir_symbol_index_new(self.dci_symbol_index_cap);
        self.dci_alias_index_cap = 65536;
        self.dci_alias_index = llvm_mir_symbol_index_new(self.dci_alias_index_cap);
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let layouts = self.dci_exports_array_from(self.dci_contract_at(root_i), "layouts");
            var layout = dci_cjson_child(layouts);
            while (layout != null) {
                if (cJSON_IsObject(layout) != 0) {
                    self.dci_put_layout_name(self.dci_json_string(layout, "type_name"), layout);
                }
                layout = dci_cjson_next(layout);
            }
            root_i = root_i + 1;
        }
        var alias_round: i32 = 0;
        while (alias_round < 8) {
            root_i = 0;
            while (root_i < root_n) {
                let aliases = self.dci_exports_array_from(self.dci_contract_at(root_i), "aliases");
                var alias = dci_cjson_child(aliases);
                while (alias != null) {
                    if (cJSON_IsObject(alias) != 0) {
                        let alias_name = self.dci_json_string(alias, "name");
                        let target_name = self.dci_json_string(alias, "target");
                        self.dci_put_alias_name(alias_name, alias);
                        var target_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index,
                                                                          self.dci_layout_index_cap,
                                                                          target_name);
                        if (target_layout == null && !llvm_mir_dci_type_name_is_plain(target_name)) {
                            target_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index,
                                                                          self.dci_layout_index_cap,
                                                                          self.dci_canonical_type_name_text(target_name));
                        }
                        if (target_layout != null) {
                            self.dci_put_layout_name(alias_name, target_layout);
                        }
                    }
                    alias = dci_cjson_next(alias);
                }
                root_i = root_i + 1;
            }
            alias_round = alias_round + 1;
        }
        root_i = 0;
        while (root_i < root_n) {
            let symbols = self.dci_exports_array_from(self.dci_contract_at(root_i), "symbols");
            var symbol = dci_cjson_child(symbols);
            while (symbol != null) {
                if (cJSON_IsObject(symbol) != 0) {
                    self.dci_put_symbol_key(self.dci_json_string(symbol, "name"), symbol);
                    self.dci_put_symbol_key(self.dci_json_string(symbol, "semantic_id"), symbol);
                    self.dci_put_symbol_key(self.dci_json_string(symbol, "link_name"), symbol);
                    self.dci_put_symbol_key(self.dci_json_string(symbol, "mangled"), symbol);
                    let kind = self.dci_json_string(symbol, "kind");
                    var member = self.dci_json_string(symbol, "member_name");
                    if (member.len == 0) { member = self.dci_json_string(symbol, "name"); }
                    if (kind.len > 0 && member.len > 0) {
                        self.dci_put_symbol_key(kind + "#" + member, symbol);
                        let owner = self.dci_json_string(symbol, "owner");
                        if (owner.len > 0) {
                            self.dci_put_symbol_key(kind + "#" + member + "#" + owner, symbol);
                        }
                    }
                }
                symbol = dci_cjson_next(symbol);
            }
            root_i = root_i + 1;
        }
        self.dci_index_ready = true;
    }

    public fn dci_ensure_indexes(self) {
        if (self.dci_index_ready) { return; }
        if (self.dci_json_root == null) { return; }
        self.dci_build_indexes();
    }

    public fn dci_json(self) -> rawptr {
        let text = mir_unit_dci_abi_text(&self.m);
        let path = mir_unit_dci_abi_path(&self.m);
        if (!mir_unit_has_dci_abi(&self.m)) { return null; }
        var source_key = "json:" + text;
        if (path.len > 0) { source_key = "dcib:" + path; }
        if (self.dci_json_root != null && self.dci_json_text_cache == source_key) { return self.dci_json_root; }
        if (self.dci_json_bundle != null || self.dci_json_root != null) {
            self.dci_dispose_indexes();
            if (self.dci_json_bundle != null) {
                cJSON_Delete(self.dci_json_bundle);
            } else if (self.dci_json_root != null) {
                cJSON_Delete(self.dci_json_root);
            }
            self.dci_json_bundle = null;
            self.dci_json_root = null;
        }
        self.dci_json_text_cache = source_key;
        if (dci_path_list_count(path.clone()) > 0) {
            let loaded = dci_load_contract_bundle(path.clone());
            if (loaded.roots == null) {
                var detail = loaded.message;
                if (detail.len == 0) { detail = "unknown DCI error"; }
                self.report_error("invalid DCI ABI contract: " + detail);
                return null;
            }
            self.dci_json_bundle = loaded.roots;
            self.dci_json_root = dci_bundle_root_at(self.dci_json_bundle, 0);
        } else {
            self.dci_json_root = cJSON_Parse(text.c_str());
            if (self.dci_json_root == null) {
                self.report_error("invalid DCI ABI JSON");
                return null;
            }
            let bundle = cJSON_CreateArray();
            if (bundle == null || cJSON_AddItemToArray(bundle, self.dci_json_root) == 0) {
                if (bundle != null) { cJSON_Delete(bundle); }
                else { cJSON_Delete(self.dci_json_root); }
                self.dci_json_root = null;
                self.report_error("out of memory while loading DCI ABI JSON");
                return null;
            }
            self.dci_json_bundle = bundle;
        }
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let root = self.dci_contract_at(root_i);
            if (root == null || cJSON_IsObject(root) == 0) {
                cJSON_Delete(self.dci_json_bundle);
                self.dci_json_bundle = null;
                self.dci_json_root = null;
                self.report_error("DCI ABI root must be an object");
                return null;
            }
            if (!self.dci_validate_descriptor(root)) {
                cJSON_Delete(self.dci_json_bundle);
                self.dci_json_bundle = null;
                self.dci_json_root = null;
                return null;
            }
            root_i = root_i + 1;
        }
        self.dci_build_indexes();
        return self.dci_json_root;
    }

    public fn dci_json_item(self, obj: rawptr, key: string) -> rawptr {
        if (obj == null || key.len == 0) { return null; }
        return cJSON_GetObjectItemCaseSensitive(obj, key.c_str());
    }

    public fn dci_json_string(self, obj: rawptr, key: string) -> string {
        let item = self.dci_json_item(obj, key);
        if (item == null || cJSON_IsString(item) == 0) { return ""; }
        let raw = cJSON_GetStringValue(item);
        if (raw == null) { return ""; }
        return from_cstr(raw);
    }

    public fn dci_json_cstr(self, obj: rawptr, key: string) -> rawptr {
        let item = self.dci_json_item(obj, key);
        if (item == null || cJSON_IsString(item) == 0) { return null; }
        return cJSON_GetStringValue(item);
    }

    public fn dci_json_number_item_i64(self, item: rawptr, context: string) -> i64 {
        if (item == null || cJSON_IsNumber(item) == 0) {
            self.report_error("DCI JSON number is missing for " + context);
            return 0;
        }
        let raw = cJSON_GetNumberValue(item);
        if (raw != raw) {
            self.report_error("DCI JSON number `" + context + "` is NaN");
            return 0;
        }
        if (raw > 9007199254740992.0 || raw < -9007199254740992.0) {
            self.report_error("DCI JSON integer `" + context
                      + "` exceeds the cJSON exact range (±2^53)");
            return 0;
        }
        let n = raw as i64;
        if ((n as f64) != raw) {
            self.report_error("DCI JSON number `" + context + "` is not an integer");
            return 0;
        }
        return n;
    }

    public fn dci_json_i64(self, obj: rawptr, key: string) -> i64 {
        let item = self.dci_json_item(obj, key);
        if (item == null || cJSON_IsNumber(item) == 0) { return 0; }
        return self.dci_json_number_item_i64(item, key);
    }

    public fn dci_json_bool(self, obj: rawptr, key: string) -> bool {
        let item = self.dci_json_item(obj, key);
        if (item == null) { return false; }
        return cJSON_IsTrue(item) != 0;
    }

    public fn dci_json_array_contains_string(self, arr: rawptr, wanted: string) -> bool {
        if (arr == null || cJSON_IsArray(arr) == 0 || wanted.len == 0) { return false; }
        var item = dci_cjson_child(arr);
        while (item != null) {
            if (cJSON_IsString(item) != 0 && dci_cstr_eq(cJSON_GetStringValue(item), wanted)) {
                return true;
            }
            item = dci_cjson_next(item);
        }
        return false;
    }

    public fn dci_control_flow_boundary(self, control: rawptr) -> string {
        if (control == null || cJSON_IsObject(control) == 0) { return ""; }
        var boundary = self.dci_json_string(control, "default_boundary");
        if (boundary.len == 0) { boundary = self.dci_json_string(control, "boundary"); }
        if (boundary.len == 0) {
            let propagation = self.dci_json_item(control, "propagation");
            boundary = self.dci_json_string(propagation, "mode");
        }
        return boundary;
    }

    public fn dci_control_flow_boundary_supported(self, boundary: string) -> bool {
        return boundary.len == 0 || boundary == "no_unwind" || boundary == "forbidden"
            || boundary == "abort";
    }

    // Runtime realizability of a declared `translated` propagation boundary
    // (SPEC 11 / 16.4). A translated boundary means the producer side converts a
    // failing control flow into a value via a declared translator symbol before
    // crossing, so no foreign unwind ever reaches Vyx. The Consumer can execute
    // this at runtime iff the translator resolves to a uniquely exported Direct
    // function whose own leaf control-flow contract is itself no-unwind. Only the
    // translator's OWN boundary is inspected here so the check never recurses back
    // through the enclosing translated contract.
    public fn dci_translator_symbol_realizable(self, translator_ref: string) -> bool {
        if (translator_ref.len == 0) { return false; }
        let sym = self.dci_symbol_object_for_reference(translator_ref);
        if (sym == null) { return false; }
        if (self.dci_json_string(sym, "kind") != "function") { return false; }
        let leaf = self.dci_json_item(sym, "control_flow");
        if (leaf == null) { return true; }
        if (cJSON_IsObject(leaf) == 0) { return false; }
        let leaf_boundary = self.dci_control_flow_boundary(leaf);
        if (!self.dci_control_flow_boundary_supported(leaf_boundary)) { return false; }
        let leaf_prop = self.dci_json_item(leaf, "propagation");
        let leaf_mode = self.dci_json_string(leaf_prop, "mode");
        return leaf_mode.len == 0 || leaf_mode == "forbidden" || leaf_mode == "abort";
    }

    public fn dci_control_flow_contract_supported(self, control: rawptr) -> bool {
        if (control == null) { return true; }
        if (cJSON_IsObject(control) == 0) { return false; }
        let boundary = self.dci_control_flow_boundary(control);
        let propagation = self.dci_json_item(control, "propagation");
        let mode = self.dci_json_string(propagation, "mode");
        if (boundary == "translated" || mode == "translated") {
            var translator: string = "";
            if (propagation != null && cJSON_IsObject(propagation) != 0) {
                translator = self.dci_json_string(propagation, "translator_symbol");
            }
            if (mode == "shared_abi" || boundary == "shared_abi") { return false; }
            return self.dci_translator_symbol_realizable(translator);
        }
        if (boundary == "shared_abi" || mode == "shared_abi") {
            var abi: string = "";
            if (propagation != null && cJSON_IsObject(propagation) != 0) {
                abi = self.dci_json_string(propagation, "abi");
            }
            return llvm_unwind_shared_abi_supported(abi, self.target_triple);
        }
        if (!self.dci_control_flow_boundary_supported(boundary)) {
            return false;
        }
        return mode.len == 0 || mode == "forbidden" || mode == "abort";
    }

    // A declared cross-boundary propagation contract MUST carry the data both
    // sides need before the Consumer can even reason about it (SPEC 11.2). This
    // is orthogonal to whether Vyx can execute the mode: a `translated` boundary
    // without a translator symbol or a `shared_abi` boundary without a shared ABI
    // identity is malformed and must fail closed with a precise diagnostic rather
    // than the generic "unsupported propagation ABI" fallback.
    public fn dci_control_flow_boundary_data_error(self, control: rawptr) -> string {
        if (control == null || cJSON_IsObject(control) == 0) { return ""; }
        let propagation = self.dci_json_item(control, "propagation");
        var mode: string = "";
        if (propagation != null && cJSON_IsObject(propagation) != 0) {
            mode = self.dci_json_string(propagation, "mode");
        }
        let boundary = self.dci_control_flow_boundary(control);
        if (mode == "translated" || boundary == "translated") {
            var translator: string = "";
            if (propagation != null && cJSON_IsObject(propagation) != 0) {
                translator = self.dci_json_string(propagation, "translator_symbol");
            }
            if (translator.len == 0) {
                return "DCI control-flow boundary `translated` requires a declared translator symbol";
            }
        }
        if (mode == "shared_abi" || boundary == "shared_abi") {
            var abi: string = "";
            if (propagation != null && cJSON_IsObject(propagation) != 0) {
                abi = self.dci_json_string(propagation, "abi");
            }
            if (abi.len == 0) {
                return "DCI control-flow boundary `shared_abi` requires a declared shared propagation ABI";
            }
        }
        return "";
    }

    public fn dci_consumer_modes_contains(self, root: rawptr, mode: string) -> bool {
        let profile = self.dci_json_item(root, "profile");
        if (profile == null || cJSON_IsObject(profile) == 0) { return false; }
        let modes = self.dci_json_item(profile, "consumer_modes");
        if (modes == null || cJSON_IsArray(modes) == 0) { return false; }
        return self.dci_json_array_contains_string(modes, mode);
    }

    // Consumer recognition of normalized Stub requests (SPEC 8.2.1 / 16.1).
    // The Adapter emits language-neutral `exports.stub_requests`; the Core
    // Consumer validates them, requires the Stub Consumer mode, and enforces
    // that each requested wrapper is a fresh link identity that does not shadow
    // an already-exported Direct symbol. Concrete wrapper synthesis and call
    // rebinding are performed by a capability-matched Stub backend at build
    // time; nothing here is inferred from a source language name.
    public fn dci_validate_stub_requests(self,
                                         root: rawptr,
                                         exports: rawptr,
                                         has_stub_mode: bool) -> bool {
        let requests = self.dci_json_item(exports, "stub_requests");
        if (requests == null) { return true; }
        if (cJSON_IsArray(requests) == 0) {
            self.report_error("DCI exports.stub_requests must be an array");
            return false;
        }
        let n = cJSON_GetArraySize(requests);
        if (n == 0) { return true; }
        if (!has_stub_mode) {
            self.report_error("DCI descriptor declares stub_requests but the profile has no stub Consumer mode");
            return false;
        }
        var i: i32 = 0;
        while (i < n) {
            let request = cJSON_GetArrayItem(requests, i);
            if (request == null || cJSON_IsObject(request) == 0) {
                self.report_error("DCI stub request must be an object");
                return false;
            }
            let id = self.dci_json_string(request, "id");
            if (id.len == 0) {
                self.report_error("DCI stub request is missing an `id`");
                return false;
            }
            var j: i32 = 0;
            while (j < i) {
                let other = cJSON_GetArrayItem(requests, j);
                if (self.dci_json_string(other, "id") == id) {
                    self.report_error("duplicate DCI stub request id `" + id + "`");
                    return false;
                }
                j = j + 1;
            }
            let wrapper = self.dci_json_item(request, "wrapper");
            if (wrapper == null || cJSON_IsObject(wrapper) == 0) {
                self.report_error("DCI stub request `" + id + "` is missing its wrapper");
                return false;
            }
            let wrapper_link = self.dci_json_string(wrapper, "link_name");
            if (wrapper_link.len == 0) {
                self.report_error("DCI stub request `" + id + "` wrapper is missing a link_name");
                return false;
            }
            let synthesis = self.dci_json_item(request, "synthesis");
            let strategy = self.dci_json_string(synthesis, "strategy");
            // translate_unwind wrappers ARE the exported translator; collision
            // is required, not an error.  forward_direct still must not shadow.
            if (strategy != "translate_unwind"
                && self.dci_symbol_object_for_reference(wrapper_link) != null) {
                self.report_error("DCI stub request wrapper `" + wrapper_link
                          + "` collides with an exported symbol");
                return false;
            }
            var k: i32 = 0;
            while (k < i) {
                let other = cJSON_GetArrayItem(requests, k);
                let other_wrapper = self.dci_json_item(other, "wrapper");
                if (self.dci_json_string(other_wrapper, "link_name") == wrapper_link) {
                    self.report_error("duplicate DCI stub request wrapper `" + wrapper_link + "`");
                    return false;
                }
                k = k + 1;
            }
            let request_control = self.dci_json_item(request, "control_flow");
            if (request_control != null && cJSON_IsObject(request_control) != 0) {
                let request_boundary_error = self.dci_control_flow_boundary_data_error(request_control);
                if (request_boundary_error.len > 0) {
                    self.report_error(request_boundary_error);
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    // Find the imported foreign DCI function whose resolved link identity equals
    // `link_name`. The Consumer only synthesizes a wrapper over a target that the
    // consuming unit actually imports, so its full LLVM signature is already
    // materialized and can be forwarded verbatim.
    public fn dci_find_foreign_function_by_link(self, link_name: string) -> i32 {
        if (link_name.len == 0) { return mir_id_invalid(); }
        var function_id: i32 = 1;
        var found: i32 = mir_id_invalid();
        while (function_id <= self.m.function_count) {
            if (self.function_is_foreign_dci(function_id)
                && self.dci_link_name_for_function(function_id) == link_name) {
                found = function_id;
            }
            function_id = function_id + 1;
        }
        return found;
    }

    // General in-Consumer Stub wrapper synthesis (SPEC 8.2.1 / 16.1). For any
    // Direct `requires_stub` operation a request may opt into in-Consumer
    // synthesis via `synthesis.strategy`. `forward_direct` emits a forwarding
    // wrapper. `translate_unwind` is compiled by the producer Adapter; the
    // Consumer must import that translator and must not emit LLVM EH. The
    // wrapper link name is unique for `forward_direct` and must not shadow a
    // Direct symbol; `translate_unwind` requires the wrapper to BE the exported
    // translator. Requests without a `synthesis` block keep the previous
    // backend-routed behavior untouched.
    public fn dci_synthesize_stub_wrappers(self) -> bool {
        if (!mir_unit_has_dci_abi(&self.m)) { return true; }
        if (self.dci_json() == null) { return true; }
        var ok: bool = true;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let requests = self.dci_exports_array_from(self.dci_contract_at(root_i), "stub_requests");
            if (requests == null) {
                root_i = root_i + 1;
                continue;
            }
            let n = cJSON_GetArraySize(requests);
            var i: i32 = 0;
            while (i < n) {
                let request = cJSON_GetArrayItem(requests, i);
                let synthesis = self.dci_json_item(request, "synthesis");
                if (synthesis != null && cJSON_IsObject(synthesis) != 0) {
                let strategy = self.dci_json_string(synthesis, "strategy");
                if (strategy == "forward_direct" || strategy == "reverse_override") {
                    if (!self.dci_synthesize_forward_wrapper(request, synthesis)) {
                        ok = false;
                    }
                } else if (strategy == "translate_unwind") {
                    if (!self.dci_translate_unwind_request_supported(request, synthesis)) {
                        ok = false;
                    }
                } else if (strategy.len > 0) {
                    self.report_error("unsupported DCI stub wrapper synthesis strategy `"
                              + strategy + "`");
                    ok = false;
                } else {
                    self.report_error("DCI stub wrapper synthesis requires a `strategy`");
                    ok = false;
                }
            }
            i = i + 1;
        }
            root_i = root_i + 1;
        }
        return ok;
    }

    // `translate_unwind`: the producer compiled a catch translator. The Consumer
    // never synthesizes LLVM EH for that strategy (no personality, no
    // `__CxxFrameHandler3`, no landingpad). The wrapper link must resolve to an
    // exported no_unwind Direct function; the original may_unwind target stays
    // Direct-rejected. Host conversion to Result is Converter/frontend work.
    // `shared_abi` host definitions are a different path: they already carry
    // personality/`uwtable` and emit `invoke` plus a cleanup pad.
    public fn dci_translate_unwind_request_supported(self, request: rawptr, synthesis: rawptr) -> bool {
        let wrapper = self.dci_json_item(request, "wrapper");
        let wrapper_link = self.dci_json_string(wrapper, "link_name");
        if (wrapper_link.len == 0) {
            self.report_error("DCI translate_unwind wrapper is missing a link_name");
            return false;
        }
        var target_ref = self.dci_json_string(synthesis, "target");
        if (target_ref.len == 0) { target_ref = self.dci_json_string(request, "target"); }
        if (target_ref.len == 0) {
            self.report_error("DCI translate_unwind wrapper `" + wrapper_link
                      + "` has no target symbol");
            return false;
        }
        if (wrapper_link == target_ref) {
            self.report_error("DCI translate_unwind translator cannot be the may_unwind target");
            return false;
        }
        let translator = self.dci_symbol_lookup_unique(wrapper_link, true);
        if (translator == null) {
            self.report_error("DCI translate_unwind translator `" + wrapper_link
                      + "` is not an exported Direct symbol");
            return false;
        }
        if (!self.dci_translator_symbol_realizable(wrapper_link)) {
            self.report_error("DCI translate_unwind translator `" + wrapper_link
                      + "` is not Direct-callable under its leaf control-flow contract");
            return false;
        }
        return true;
    }

    public fn dci_host_return_is_result_failure(self, function_id: i32) -> bool {
        let result_type = self.m.function_return_type(function_id);
        if (!self.type_is_result_abi(result_type)) { return false; }
        let err_type = self.result_err_type(result_type);
        if (err_type == mir_id_invalid()) { return false; }
        return self.last_path_segment(llvm_mir_type_text(&self.m, err_type)) == "Failure";
    }

    public fn dci_symbol_name_matches_host(self, symbol_name: string, host: string) -> bool {
        if (symbol_name == host) { return true; }
        if (host.len == 0 || symbol_name.len <= host.len) { return false; }
        let prefix_len = symbol_name.len - host.len;
        if (symbol_name.substring(prefix_len, symbol_name.len) != host) { return false; }
        let ch = symbol_name.charAt(prefix_len - 1);
        return ch == 46 || ch == 58;
    }

    public fn dci_symbol_is_translate_unwind_target(self, target: rawptr, function_id: i32) -> bool {
        if (target == null || cJSON_IsObject(target) == 0) { return false; }
        if (self.dci_json_string(target, "kind") != self.dci_symbol_kind_for_function(function_id)) {
            return false;
        }
        if (self.dci_symbol_owner_match_rank(self.dci_json_string(target, "owner"), function_id) == 0) {
            return false;
        }
        if (!self.dci_symbol_params_match_function(self.dci_json_item(target, "params"), function_id)) {
            return false;
        }
        if (!self.dci_symbol_flags_match_function(target, function_id)) { return false; }
        let host = self.dci_symbol_name_for_function(function_id);
        if (self.dci_symbol_name_matches_host(self.dci_json_string(target, "name"), host)) {
            return true;
        }
        if (self.dci_symbol_name_matches_host(self.dci_json_string(target, "member_name"), host)) {
            return true;
        }
        return self.dci_symbol_name_matches_host(self.dci_symbol_link_name(target), host);
    }

    public fn dci_translate_unwind_translator_for_function(self, function_id: i32) -> rawptr {
        if (!self.function_is_foreign_dci(function_id)) { return null; }
        if (!self.dci_host_return_is_result_failure(function_id)) { return null; }
        var found: rawptr = null;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let requests = self.dci_exports_array_from(self.dci_contract_at(root_i), "stub_requests");
            if (requests == null) {
                root_i = root_i + 1;
                continue;
            }
            var request = dci_cjson_child(requests);
            while (request != null) {
                let synthesis = self.dci_json_item(request, "synthesis");
                if (self.dci_json_string(synthesis, "strategy") == "translate_unwind") {
                    var target_ref = self.dci_json_string(synthesis, "target");
                    if (target_ref.len == 0) { target_ref = self.dci_json_string(request, "target"); }
                    let target = self.dci_symbol_object_for_reference(target_ref);
                    if (self.dci_symbol_is_translate_unwind_target(target, function_id)) {
                        let wrapper = self.dci_json_item(request, "wrapper");
                        let wrapper_link = self.dci_json_string(wrapper, "link_name");
                        let translator = self.dci_symbol_object_for_reference(wrapper_link);
                        if (translator != null && self.dci_translator_symbol_realizable(wrapper_link)) {
                            if (found != null
                                && !self.dci_symbol_contracts_equivalent(found, translator)) {
                                self.report_error("conflicting DCI translate_unwind translators for `"
                                          + self.m.function_name(function_id) + "`");
                                return null;
                            }
                            found = translator;
                        }
                    }
                }
                request = dci_cjson_next(request);
            }
            root_i = root_i + 1;
        }
        return found;
    }

    public fn dci_call_converts_translated_to_result(self, function_id: i32) -> bool {
        if (!self.dci_host_return_is_result_failure(function_id)) { return false; }
        let symbol = self.dci_symbol_object_for_function(function_id);
        if (symbol == null) { return false; }
        let ret = self.dci_json_item(symbol, "return");
        let type_obj = self.dci_json_item(ret, "type");
        let name = self.dci_json_string(type_obj, "name");
        return name.contains("Translated");
    }

    public fn dci_translated_return_layout(self, function_id: i32) -> rawptr {
        let symbol = self.dci_symbol_object_for_function(function_id);
        let ret = self.dci_json_item(symbol, "return");
        let type_obj = self.dci_json_item(ret, "type");
        return self.dci_layout_object_for_record_name(self.dci_json_string(type_obj, "name"));
    }

    public fn dci_layout_blob_ty(self, layout: rawptr) -> rawptr {
        if (layout == null) { return null; }
        let size = self.dci_json_i64(layout, "size");
        if (size < 1) { return null; }
        return vyx_rt_array_ty(self.mod, self.ty_i8, size as u64);
    }

    public fn dci_translated_sret_ty(self, function_id: i32) -> rawptr {
        return self.dci_layout_blob_ty(self.dci_translated_return_layout(function_id));
    }

    public fn dci_layout_field_offset(self, layout: rawptr, field_name: string) -> i64 {
        let fields = self.dci_json_item(layout, "fields");
        if (fields == null || cJSON_IsArray(fields) == 0) { return -1; }
        let n = cJSON_GetArraySize(fields);
        var i: i32 = 0;
        while (i < n) {
            let field = cJSON_GetArrayItem(fields, i);
            if (self.dci_json_string(field, "name") == field_name) {
                return self.dci_json_i64(field, "offset");
            }
            i = i + 1;
        }
        return -1;
    }

    public fn dci_load_layout_field(self,
                                     base: rawptr,
                                     layout: rawptr,
                                     field_name: string,
                                     llvm_ty: rawptr,
                                     label: string) -> rawptr {
        if (base == null || llvm_ty == null) { return null; }
        let off = self.dci_layout_field_offset(layout, field_name);
        if (off < 0) { return null; }
        var addr = base;
        if (off > 0) {
            addr = self.ptr_offset_bytes(base,
                                         vyx_rt_const_int(self.mod, self.ty_i64, off, 1),
                                         label);
        }
        if (addr == null) { return null; }
        return vyx_rt_build_load(self.mod, llvm_ty, addr, label.c_str(), label.len as u64);
    }

    public fn dci_result_from_translated_sret(self, function_id: i32, sret_slot: rawptr) -> rawptr {
        let result_type = self.m.function_return_type(function_id);
        let layout = self.dci_translated_return_layout(function_id);
        if (sret_slot == null || layout == null) {
            self.report_error("DCI translate_unwind cannot read translator return for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        let tag8 = self.dci_load_layout_field(sret_slot, layout, "tag", self.ty_i8, "dci.tr.tag");
        if (tag8 == null) {
            self.report_error("DCI translate_unwind translator is missing field `tag`");
            return null;
        }
        let tag = vyx_rt_build_zext(self.mod, tag8, self.ty_i32, "dci.tr.tag32".c_str(), 12);
        let ok_type = self.result_ok_type(result_type);
        let err_type = self.result_err_type(result_type);
        var ok_v: rawptr = null;
        if (ok_type != mir_id_invalid() && llvm_mir_type_kind(&self.m, ok_type) != ty_VOID()) {
            let ok_ll = self.lower_type(ok_type);
            ok_v = self.dci_load_layout_field(sret_slot, layout, "ok", ok_ll, "dci.tr.ok");
            if (ok_v == null) {
                self.report_error("DCI translate_unwind translator is missing field `ok`");
                return null;
            }
        }
        let err_ll = self.lower_type(err_type);
        let err_v = self.dci_load_layout_field(sret_slot, layout, "err", err_ll, "dci.tr.err");
        if (err_v == null) {
            self.report_error("DCI translate_unwind translator is missing field `err`");
            return null;
        }
        return self.build_result_value_from_parts(result_type, tag, ok_v, err_v);
    }

    // `forward_direct`: the wrapper exposes the requested unique link name with
    // the exact ABI of the exported Direct target and forwards every argument to
    // it. Reusing the target's materialized LLVM function type means sret, byval,
    // coerce, this-pointer and hidden parameters are forwarded verbatim without
    // re-deriving the lowering. The synthesized wrapper is a genuine Direct
    // surface: calls that reference the wrapper name link against this definition,
    // so the Consumer no longer requires a matching external Stub backend for the
    // forwarding case.
    public fn dci_synthesize_forward_wrapper(self, request: rawptr, synthesis: rawptr) -> bool {
        let wrapper = self.dci_json_item(request, "wrapper");
        let wrapper_link = self.dci_json_string(wrapper, "link_name");
        if (wrapper_link.len == 0) {
            self.report_error("DCI forward_direct wrapper is missing a link_name");
            return false;
        }
        if (self.dci_find_foreign_function_by_link(wrapper_link) != mir_id_invalid()) {
            self.report_error("DCI forward_direct wrapper `" + wrapper_link
                      + "` collides with an imported symbol");
            return false;
        }
        var target_ref = self.dci_json_string(synthesis, "target");
        if (target_ref.len == 0) { target_ref = self.dci_json_string(request, "target"); }
        if (target_ref.len == 0) {
            self.report_error("DCI forward_direct wrapper `" + wrapper_link
                      + "` has no target symbol");
            return false;
        }
        let target_symbol = self.dci_symbol_object_for_reference(target_ref);
        if (target_symbol == null) {
            self.report_error("DCI forward_direct wrapper target `" + target_ref
                      + "` is not a uniquely resolvable exported symbol");
            return false;
        }
        // A synthesizable Direct wrapper must forward to a Direct-callable symbol;
        // routing to another requires_stub surface is not a Direct forward.
        if (!self.dci_symbol_unwind_supported(target_symbol)) {
            self.report_error("DCI forward_direct wrapper target `" + target_ref
                      + "` is not Direct-callable under the declared control-flow contract");
            return false;
        }
        let target_link = self.dci_symbol_link_name(target_symbol);
        let target_fn = self.dci_find_foreign_function_by_link(target_link);
        if (target_fn == mir_id_invalid()) {
            self.report_error("DCI forward_direct wrapper target `" + target_ref
                      + "` must be imported by the Consumer to synthesize a wrapper");
            return false;
        }
        if (!self.declare_function_signature(target_fn)) {
            self.report_error("cannot declare DCI forward_direct wrapper target `" + target_ref + "`");
            return false;
        }
        let target_value = llvm_mir_map_get(self.function_values, target_fn);
        let target_type = llvm_mir_map_get(self.function_types, target_fn);
        if (target_value == null || target_type == null) {
            self.report_error("cannot resolve DCI forward_direct wrapper target signature `"
                      + target_ref + "`");
            return false;
        }
        let wrapper_fn = vyx_rt_add_function(self.mod,
                                             wrapper_link.c_str(),
                                             wrapper_link.len as u64,
                                             target_type);
        if (wrapper_fn == null) {
            self.report_error("cannot declare DCI stub wrapper `" + wrapper_link + "`");
            return false;
        }
        vyx_rt_set_linkage(self.mod, wrapper_fn, 0);
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let entry_name = "dci.stub.wrapper.entry";
        let bb = vyx_rt_append_block(self.mod,
                                     wrapper_fn,
                                     entry_name.c_str(),
                                     entry_name.len as u64);
        if (bb == null) {
            self.report_error("cannot create DCI stub wrapper block for `" + wrapper_link + "`");
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return false;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let param_count = self.function_llvm_param_count(target_fn);
        var args: rawptr = null;
        if (param_count > 0) {
            args = malloc((param_count * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate DCI stub wrapper arguments");
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return false;
            }
            var idx: i32 = 0;
            while (idx < param_count) {
                let p = vyx_rt_get_param(self.mod, wrapper_fn, idx as u64);
                if (p == null) {
                    free(args);
                    self.report_error("cannot read DCI stub wrapper parameter");
                    if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                    return false;
                }
                ast_write_rawptr(ptr_offset(args, idx * 8), p);
                idx = idx + 1;
            }
        }
        let ret_is_void = self.dci_function_uses_sret(target_fn)
            || llvm_mir_type_kind(&self.m, self.m.function_return_type(target_fn)) == ty_VOID();
        var call_name = "dci.stub.wrapper.call";
        if (ret_is_void) { call_name = ""; }
        let result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_value,
                                       args,
                                       param_count as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        let cc = self.dci_symbol_calling_convention(target_symbol);
        if (result != null && cc.len > 0) {
            vyx_rt_set_calling_convention(self.mod, result, cc.c_str(), cc.len as u64);
        }
        if (ret_is_void) {
            vyx_rt_build_ret_void(self.mod);
        } else if (result != null) {
            vyx_rt_build_ret(self.mod, result);
        } else {
            self.report_error("cannot emit DCI stub wrapper return for `" + wrapper_link + "`");
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return false;
        }
        if (cc.len > 0) {
            vyx_rt_set_calling_convention(self.mod,
                                          wrapper_fn,
                                          cc.c_str(),
                                          cc.len as u64);
        }
        vyx_rt_set_function_attr(self.mod,
                                 wrapper_fn,
                                 "nounwind".c_str(),
                                 8,
                                 "".c_str(),
                                 0);
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
        return true;
    }

    public fn dci_symbol_link_name(self, obj: rawptr) -> string {
        var out = self.dci_json_string(obj, "link_name");
        if (out.len == 0) { out = self.dci_json_string(obj, "mangled"); }
        return out;
    }

    public fn dci_descriptor_target_triple(self, root: rawptr) -> string {
        if (root == null) { return ""; }
        let target = self.dci_json_item(root, "target");
        if (target != null && cJSON_IsObject(target) != 0) {
            let direct = self.dci_json_string(target, "triple");
            if (direct.len > 0) { return direct; }
        }
        let source = self.dci_json_item(root, "source");
        let legacy_target = self.dci_json_item(source, "target");
        return self.dci_json_string(legacy_target, "triple");
    }

    public fn dci_descriptor_target_object(self, root: rawptr) -> rawptr {
        if (root == null) { return null; }
        let target = self.dci_json_item(root, "target");
        if (target != null && cJSON_IsObject(target) != 0) { return target; }
        return self.dci_json_item(self.dci_json_item(root, "source"), "target");
    }

    public fn dci_validate_descriptor(self, root: rawptr) -> bool {
        if (root == null || cJSON_IsObject(root) == 0) {
            self.report_error("DCI descriptor root must be an object");
            return false;
        }
        let version = self.dci_json_string(root, "dci");
        if (version.len == 0) {
            self.report_error("DCI descriptor has no `dci` version");
            return false;
        }
        if (version != "1" && !version.startsWith("1.")) {
            self.report_error("unsupported DCI version `" + version + "`");
            return false;
        }
        let kind = self.dci_json_string(root, "kind");
        if (kind != "abi") {
            self.report_error("unsupported DCI descriptor kind `" + kind + "`");
            return false;
        }
        let schema = self.dci_json_item(root, "schema");
        if (schema != null && cJSON_IsObject(schema) != 0) {
            let schema_name = self.dci_json_string(schema, "name");
            let encoding = self.dci_json_string(schema, "encoding");
            if (schema_name.len > 0 && schema_name != "dci") {
                self.report_error("unsupported DCI schema `" + schema_name + "`");
                return false;
            }
            if (encoding.len > 0) {
                var expected_encoding: string = "json";
                if (mir_unit_dci_abi_is_binary(&self.m)) { expected_encoding = "dcib"; }
                if (encoding != expected_encoding) {
                    self.report_error("DCI encoding `" + encoding + "` does not match the imported "
                              + expected_encoding + " contract");
                    return false;
                }
            }
        }
        let exports = self.dci_json_item(root, "exports");
        if (exports == null || cJSON_IsObject(exports) == 0) {
            self.report_error("DCI descriptor has no `exports` object");
            return false;
        }
        let descriptor_target = self.dci_descriptor_target_triple(root);
        if (self.target_triple.len > 0
            && descriptor_target.len > 0
            && self.target_triple != descriptor_target) {
            self.report_error("DCI target mismatch: descriptor `" + descriptor_target
                      + "`, compiler `" + self.target_triple + "`");
            return false;
        }
        let target_object = self.dci_descriptor_target_object(root);
        if (target_object != null && cJSON_IsObject(target_object) != 0) {
            let pointer_width_item = self.dci_json_item(target_object, "pointer_width");
            if (pointer_width_item != null) {
                if (cJSON_IsNumber(pointer_width_item) == 0) {
                    self.report_error("DCI target pointer_width must be numeric");
                    return false;
                }
                let errs = self.error_count;
                let pointer_width = self.dci_json_number_item_i64(pointer_width_item, "pointer_width");
                if (self.error_count > errs) { return false; }
                if (pointer_width != 64) {
                    self.report_error("unsupported DCI target pointer width "
                              + pointer_width.toString());
                    return false;
                }
            }
            let endianness = self.dci_json_string(target_object, "endianness");
            if (endianness.len > 0 && endianness != "little") {
                self.report_error("unsupported DCI target endianness `" + endianness + "`");
                return false;
            }
        }
        let target_platform = self.dci_json_string(target_object, "platform");
        let target_architecture = self.dci_json_string(target_object, "architecture");
        var target_abi_family = self.dci_json_string(target_object, "abi_family");
        if (target_abi_family.len == 0) {
            target_abi_family = self.dci_json_string(target_object, "abi");
        }
        let requires_constructor_pointer_return =
            (target_platform == "windows" || descriptor_target.contains("windows"))
            && (target_architecture == "x86_64" || descriptor_target.startsWith("x86_64"))
            && (target_abi_family == "msvc" || descriptor_target.contains("msvc"));
        if (requires_constructor_pointer_return) {
            let symbols = self.dci_json_item(exports, "symbols");
            if (symbols != null && cJSON_IsArray(symbols) != 0) {
                var symbol = dci_cjson_child(symbols);
                while (symbol != null) {
                    if (dci_cstr_eq(self.dci_json_cstr(symbol, "kind"), "constructor")) {
                        let abi = self.dci_json_item(symbol, "abi");
                        let abi_return = self.dci_json_item(abi, "return");
                        let return_type = self.dci_json_item(abi_return, "type");
                        let owner = self.dci_json_string(symbol, "owner");
                        if (owner.len == 0
                            || !dci_cstr_eq(self.dci_json_cstr(abi_return, "passing"), "direct")
                            || !dci_cstr_eq(self.dci_json_cstr(return_type, "name"), owner)
                            || !dci_cstr_eq(self.dci_json_cstr(return_type, "kind"), "class")
                            || !dci_cstr_eq(self.dci_json_cstr(return_type, "reference"), "pointer")) {
                            self.report_error("DCI x86_64 MSVC constructor `"
                                      + self.dci_json_string(symbol, "name")
                                      + "` must return its owner pointer directly");
                            return false;
                        }
                    }
                    symbol = dci_cjson_next(symbol);
                }
            }
        }
        let profile = self.dci_json_item(root, "profile");
        if (profile != null) {
            if (cJSON_IsObject(profile) == 0) {
                self.report_error("DCI profile must be an object");
                return false;
            }
            let modes = self.dci_json_item(profile, "consumer_modes");
            if (modes == null || cJSON_IsArray(modes) == 0 || cJSON_GetArraySize(modes) == 0) {
                self.report_error("DCI profile has no consumer_modes");
                return false;
            }
            let has_direct = self.dci_json_array_contains_string(modes, "direct");
            let has_stub = self.dci_json_array_contains_string(modes, "stub");
            if (!has_direct && !has_stub) {
                self.report_error("DCI profile has no supported Consumer mode");
                return false;
            }
            var mode_i: i32 = 0;
            while (mode_i < cJSON_GetArraySize(modes)) {
                let mode_item = cJSON_GetArrayItem(modes, mode_i);
                if (mode_item == null || cJSON_IsString(mode_item) == 0) {
                    self.report_error("DCI consumer_modes entries must be strings");
                    return false;
                }
                let mode_raw = cJSON_GetStringValue(mode_item);
                if (mode_raw == null) {
                    self.report_error("DCI consumer_modes contains an invalid string");
                    return false;
                }
                let mode = from_cstr(mode_raw);
                if (mode != "direct" && mode != "stub") {
                    self.report_error("unsupported DCI Consumer mode `" + mode + "`");
                    return false;
                }
                mode_i = mode_i + 1;
            }
            if (!has_direct) {
                self.report_error("this DCI compilation requires the Direct Consumer mode");
                return false;
            }
        }
        let control = self.dci_json_item(root, "control_flow");
        if (control != null && cJSON_IsObject(control) != 0) {
            let boundary = self.dci_control_flow_boundary(control);
            let boundary_error = self.dci_control_flow_boundary_data_error(control);
            if (boundary_error.len > 0) {
                self.report_error(boundary_error);
                return false;
            }
            if (!self.dci_control_flow_contract_supported(control)) {
                self.report_error("DCI control-flow boundary `" + boundary
                          + "` requires an unsupported propagation ABI");
                return false;
            }
        }
        if (!self.dci_validate_stub_requests(root, exports,
                self.dci_consumer_modes_contains(root, "stub"))) {
            return false;
        }
        return true;
    }

    public fn dci_exports_array(self, key: string) -> rawptr {
        let root = self.dci_json();
        if (root == null) { return null; }
        let exports = self.dci_json_item(root, "exports");
        if (exports == null || cJSON_IsObject(exports) == 0) { return null; }
        let arr = self.dci_json_item(exports, key);
        if (arr == null || cJSON_IsArray(arr) == 0) { return null; }
        return arr;
    }

    public fn dci_dispatch_tables_array(self) -> rawptr {
        let tables = self.dci_exports_array("dispatch_tables");
        if (tables != null && cJSON_GetArraySize(tables) > 0) { return tables; }
        return self.dci_exports_array("vtables");
    }

    public fn dci_runtime_cast_operation_matches(self,
                                                  operation: rawptr,
                                                  source_record: string,
                                                  target_record: string) -> bool {
        if (operation == null || cJSON_IsObject(operation) == 0) { return false; }
        if (self.dci_json_bool(operation, "requires_stub")) { return false; }
        if (!self.dci_json_bool(operation, "no_unwind")) { return false; }
        let availability = self.dci_json_string(operation, "availability");
        if (availability == "unavailable") { return false; }
        let source_type = self.dci_json_string(operation, "source_type");
        let target_type = self.dci_json_string(operation, "target_type");
        if (source_type.len == 0 || target_type.len == 0) { return false; }
        if (!self.dci_record_name_matches_text(source_type, source_record)
            || !self.dci_record_name_matches_text(target_type, target_record)) {
            return false;
        }
        let failure = self.dci_json_string(operation, "failure");
        let null_behavior = self.dci_json_string(operation, "null_behavior");
        return failure == "null" && null_behavior == "return_null";
    }

    public fn dci_runtime_cast_operation_named(self,
                                                source_record: string,
                                                target_record: string,
                                                operation_name: string) -> rawptr {
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let runtime_operations = self.dci_exports_array_from(
                self.dci_contract_at(root_i), "runtime_type_operations");
            if (runtime_operations != null) {
                let n = cJSON_GetArraySize(runtime_operations);
                var i: i32 = 0;
                while (i < n) {
                    let runtime_type = cJSON_GetArrayItem(runtime_operations, i);
                    let declared_type = self.dci_json_string(runtime_type, "type_name");
                    if (self.dci_record_name_matches_text(declared_type, target_record)) {
                        let operations = self.dci_json_item(runtime_type, "operations");
                        let operation = self.dci_json_item(operations, operation_name);
                        if (self.dci_runtime_cast_operation_matches(operation,
                                                                    source_record,
                                                                    target_record)) {
                            return operation;
                        }
                    }
                    i = i + 1;
                }
            }
            root_i = root_i + 1;
        }
        return null;
    }

    public fn dci_runtime_cast_operation(self,
                                         source_record: string,
                                         target_record: string) -> rawptr {
        var matching_types: i32 = 0;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let runtime_operations = self.dci_exports_array_from(
                self.dci_contract_at(root_i), "runtime_type_operations");
            if (runtime_operations != null) {
                let runtime_count = cJSON_GetArraySize(runtime_operations);
                var runtime_index: i32 = 0;
                while (runtime_index < runtime_count) {
                    let runtime_type = cJSON_GetArrayItem(runtime_operations, runtime_index);
                    if (self.dci_record_name_matches_text(
                            self.dci_json_string(runtime_type, "type_name"),
                            target_record)) {
                        matching_types = matching_types + 1;
                    }
                    runtime_index = runtime_index + 1;
                }
            }
            root_i = root_i + 1;
        }
        if (matching_types > 1) {
            self.report_error("ambiguous DCI runtime type operations for `"
                      + target_record + "`");
            return null;
        }
        var operation = self.dci_runtime_cast_operation_named(source_record,
                                                               target_record,
                                                               "checked_downcast");
        if (operation == null) {
            operation = self.dci_runtime_cast_operation_named(source_record,
                                                               target_record,
                                                               "downcast");
        }
        if (operation == null) {
            operation = self.dci_runtime_cast_operation_named(source_record,
                                                               target_record,
                                                               "cast");
        }
        return operation;
    }

    public fn dci_symbol_lookup_unique(self, reference: string, report_conflict: bool) -> rawptr {
        if (reference.len == 0) { return null; }
        if (self.dci_json() == null) { return null; }
        self.dci_ensure_indexes();
        var result: rawptr = null;
        var chain = llvm_mir_dci_obj_index_lookup(self.dci_symbol_index, self.dci_symbol_index_cap, reference);
        if (chain != null) {
            while (chain != null) {
                let symbol = ast_read_rawptr(chain);
                let matches = dci_cstr_eq(self.dci_json_cstr(symbol, "name"), reference)
                    || dci_cstr_eq(self.dci_json_cstr(symbol, "semantic_id"), reference)
                    || dci_cstr_eq(self.dci_json_cstr(symbol, "link_name"), reference)
                    || dci_cstr_eq(self.dci_json_cstr(symbol, "mangled"), reference);
                if (matches) {
                    if (result != null
                        && !self.dci_symbol_contracts_equivalent(result, symbol)) {
                        if (report_conflict) {
                            self.report_error("conflicting DCI operation symbol reference `" + reference + "`");
                        }
                        return null;
                    }
                    result = symbol;
                }
                chain = ast_read_rawptr(ptr_offset(chain, 8));
            }
            return result;
        }
        let symbols = self.dci_root_exports_array("symbols");
        var symbol = dci_cjson_child(symbols);
        while (symbol != null) {
            let matches2 = dci_cstr_eq(self.dci_json_cstr(symbol, "name"), reference)
                || dci_cstr_eq(self.dci_json_cstr(symbol, "semantic_id"), reference)
                || dci_cstr_eq(self.dci_json_cstr(symbol, "link_name"), reference)
                || dci_cstr_eq(self.dci_json_cstr(symbol, "mangled"), reference);
            if (matches2) {
                if (result != null
                    && !self.dci_symbol_contracts_equivalent(result, symbol)) {
                    if (report_conflict) {
                        self.report_error("conflicting DCI operation symbol reference `" + reference + "`");
                    }
                    return null;
                }
                result = symbol;
            }
            symbol = dci_cjson_next(symbol);
        }
        return result;
    }

    public fn dci_symbol_object_for_reference(self, reference: string) -> rawptr {
        return self.dci_symbol_lookup_unique(reference, true);
    }

    public fn dci_runtime_cast_symbol_contract_matches(self,
                                                        symbol: rawptr,
                                                        source_type_id: i32,
                                                        target_type_id: i32) -> bool {
        if (symbol == null || self.dci_json_string(symbol, "kind") != "function") { return false; }
        if (!self.dci_symbol_calling_convention_supported(symbol)
            || !self.dci_symbol_unwind_supported(symbol)) {
            return false;
        }
        let params = self.dci_json_item(symbol, "params");
        if (params == null || cJSON_IsArray(params) == 0 || cJSON_GetArraySize(params) != 1) {
            return false;
        }
        let param = cJSON_GetArrayItem(params, 0);
        let param_type = self.dci_json_item(param, "type");
        if (!self.dci_type_object_matches_type(param_type, source_type_id)
            || !self.dci_json_bool(param_type, "nullable")
            || self.dci_json_string(param, "ownership") != "borrow") {
            return false;
        }
        let result = self.dci_json_item(symbol, "return");
        let result_type = self.dci_json_item(result, "type");
        if (result == null
            || !self.dci_type_object_matches_type(result_type, target_type_id)
            || !self.dci_json_bool(result_type, "nullable")
            || self.dci_json_string(result, "ownership") != "borrow") {
            return false;
        }
        let abi = self.dci_json_item(symbol, "abi");
        if (abi == null || cJSON_IsObject(abi) == 0) { return false; }
        let abi_params = self.dci_json_item(abi, "parameters");
        if (abi_params == null
            || cJSON_IsArray(abi_params) == 0
            || cJSON_GetArraySize(abi_params) != 1
            || self.dci_abi_passing(cJSON_GetArrayItem(abi_params, 0)) != "direct") {
            return false;
        }
        if (self.dci_abi_passing(self.dci_json_item(abi, "return")) != "direct") { return false; }
        let hidden = self.dci_json_item(abi, "hidden_parameters");
        return hidden == null || (cJSON_IsArray(hidden) != 0 && cJSON_GetArraySize(hidden) == 0);
    }

    public fn dci_runtime_operation_cache_node(self, symbol: string) -> rawptr {
        var node = self.dci_runtime_operation_cache_head;
        while (node != null) {
            let cached_name = ast_read_rawptr(node);
            if (cached_name != null && from_cstr(cached_name) == symbol) { return node; }
            node = ast_read_rawptr(ptr_offset(node, 32));
        }
        return null;
    }

    public fn dci_runtime_operation_function(self,
                                              symbol: rawptr,
                                              link_name: string) -> rawptr {
        let cached = self.dci_runtime_operation_cache_node(link_name);
        if (cached != null) {
            let cached_contract = ast_read_rawptr(ptr_offset(cached, 24));
            if (!self.dci_symbol_contracts_equivalent(cached_contract, symbol)) {
                self.report_error("conflicting DCI runtime operation contract for `" + link_name + "`");
                return null;
            }
            return cached;
        }
        var fn_value: rawptr = null;
        var fn_type: rawptr = null;
        var function_id: i32 = 1;
        while (function_id <= self.m.function_count) {
            if (self.function_is_foreign_dci(function_id)
                && self.dci_link_name_for_function(function_id) == link_name) {
                if (!self.declare_function_signature(function_id)) { return null; }
                let existing_value = llvm_mir_map_get(self.function_values, function_id);
                let existing_type = llvm_mir_map_get(self.function_types, function_id);
                if (fn_value != null && fn_value != existing_value) {
                    self.report_error("ambiguous DCI runtime operation declaration `" + link_name + "`");
                    return null;
                }
                fn_value = existing_value;
                fn_type = existing_type;
            }
            function_id = function_id + 1;
        }
        if (fn_value == null) {
            let params = malloc(8);
            if (params == null) {
                self.report_error("cannot allocate DCI runtime operation signature");
                return null;
            }
            ast_write_rawptr(params, self.ty_ptr);
            fn_type = vyx_rt_fn_type(self.mod, self.ty_ptr, params, 1, 0);
            free(params);
            if (fn_type == null) {
                self.report_error("cannot build DCI runtime operation signature `" + link_name + "`");
                return null;
            }
            fn_value = vyx_rt_add_function(self.mod,
                                           link_name.c_str(),
                                           link_name.len as u64,
                                           fn_type);
            if (fn_value == null) {
                self.report_error("cannot declare DCI runtime operation `" + link_name + "`");
                return null;
            }
        }
        let cc = self.dci_symbol_calling_convention(symbol);
        if (cc.len > 0
            && vyx_rt_set_calling_convention(self.mod,
                                             fn_value,
                                             cc.c_str(),
                                             cc.len as u64) != 0) {
            self.report_error("cannot apply DCI runtime operation calling convention `" + cc
                      + "` to `" + link_name + "`: " + self.runtime_last_error());
            return null;
        }
        vyx_rt_set_function_attr(self.mod,
                                 fn_value,
                                 "nounwind".c_str(),
                                 8,
                                 "".c_str(),
                                 0);
        let node = malloc(40);
        if (node == null) {
            self.report_error("cannot cache DCI runtime operation `" + link_name + "`");
            return null;
        }
        ast_write_rawptr(node, ast_dup_c_string(link_name.clone()));
        ast_write_rawptr(ptr_offset(node, 8), fn_value);
        ast_write_rawptr(ptr_offset(node, 16), fn_type);
        ast_write_rawptr(ptr_offset(node, 24), symbol);
        ast_write_rawptr(ptr_offset(node, 32), self.dci_runtime_operation_cache_head);
        self.dci_runtime_operation_cache_head = node;
        return node;
    }

    public fn lower_dci_runtime_pointer_cast(self,
                                              value: rawptr,
                                              source_type_id: i32,
                                              target_type_id: i32,
                                              source_record_id: i32,
                                              target_record_id: i32) -> rawptr {
        let source_record = self.dci_record_name_for_type(source_record_id);
        let target_record = self.dci_record_name_for_type(target_record_id);
        let operation = self.dci_runtime_cast_operation(source_record, target_record);
        if (operation == null) {
            self.report_error("DCI runtime cast `" + source_record + "` -> `" + target_record
                      + "` has no Direct checked-downcast operation");
            return null;
        }
        let intrinsic = self.dci_json_string(operation, "intrinsic");
        if (intrinsic.len > 0) {
            self.report_error("unsupported DCI runtime cast intrinsic `" + intrinsic + "`");
            return null;
        }
        let reference = self.dci_json_string(operation, "symbol");
        let symbol = self.dci_symbol_object_for_reference(reference);
        if (symbol == null || !self.dci_runtime_cast_symbol_contract_matches(symbol,
                                                                              source_type_id,
                                                                              target_type_id)) {
            self.report_error("invalid DCI checked-downcast symbol contract `" + reference + "`");
            return null;
        }
        let link_name = self.dci_symbol_link_name(symbol);
        let cache_node = self.dci_runtime_operation_function(symbol, link_name);
        if (cache_node == null) { return null; }
        let fn_value = ast_read_rawptr(ptr_offset(cache_node, 8));
        let fn_type = ast_read_rawptr(ptr_offset(cache_node, 16));
        let args = malloc(8);
        if (args == null) {
            self.report_error("cannot allocate DCI runtime cast argument");
            return null;
        }
        ast_write_rawptr(args, value);
        let out = vyx_rt_build_call(self.mod,
                                    fn_type,
                                    fn_value,
                                    args,
                                    1,
                                    "dci.runtime.cast".c_str(),
                                    16);
        free(args);
        let cc = self.dci_symbol_calling_convention(symbol);
        if (out != null && cc.len > 0
            && vyx_rt_set_calling_convention(self.mod,
                                             out,
                                             cc.c_str(),
                                             cc.len as u64) != 0) {
            self.report_error("cannot apply DCI runtime cast call convention `" + cc
                      + "`: " + self.runtime_last_error());
            return null;
        }
        return out;
    }

    public fn dci_record_name_matches_type(self, dci_record: string, type_id: i32) -> bool {
        if (type_id == mir_id_invalid() || dci_record.len == 0) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        return self.dci_plain_type_names_match(dci_record, text)
            || self.dci_type_alias_names_match(dci_record, text);
    }

    public fn dci_record_name_matches_text(self, dci_record: string, type_text: string) -> bool {
        if (dci_record.len == 0 || type_text.len == 0) { return false; }
        return self.dci_plain_type_names_match(dci_record, type_text)
            || self.dci_type_alias_names_match(dci_record, type_text);
    }

    fn dci_indexed_layout(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        if (self.dci_json() == null) { return null; }
        self.dci_ensure_indexes();
        var hit = llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap, type_text);
        if (hit != null) { return hit; }
        if (!llvm_mir_dci_type_name_is_plain(type_text)) {
            hit = llvm_mir_dci_obj_index_first(self.dci_layout_index,
                                               self.dci_layout_index_cap,
                                               self.dci_canonical_type_name_text(type_text));
        }
        return hit;
    }

    public fn dci_layout_object_for_record_name(self, record_name: string) -> rawptr {
        if (record_name.len == 0) { return null; }
        let hit = self.dci_indexed_layout(record_name);
        if (hit != null) { return hit; }
        let layouts = self.dci_root_exports_array("layouts");
        var obj = dci_cjson_child(layouts);
        while (obj != null) {
            let ty = self.dci_json_string(obj, "type_name");
            if (self.dci_record_name_matches_text(ty, record_name)) { return obj; }
            obj = dci_cjson_next(obj);
        }
        // A consumer-declared record instance has no descriptor entry, so the
        // name-keyed walk above cannot see it.  Field offsets, base walks and
        // the field-object lookup are all keyed by name, so the derived layouts
        // have to answer here as well as in the type-keyed lookup.
        return self.dci_local_layout_for_record_name(record_name);
    }

    /// Contract-only layout lookup: the descriptor's `layouts` array and nothing
    /// else.  The public lookup layers the locally derived consumer-record
    /// layouts on top of this; a synthesizer must ask *this* one so it can tell
    /// "the producer measured it" from "we derived it" without recursing.
    public fn dci_contract_layout_for_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        let type_text = llvm_mir_type_text(&self.m, type_id);
        let obj = self.dci_indexed_layout(type_text);
        if (obj != null) { return obj; }
        let layouts = self.dci_root_exports_array("layouts");
        var obj2 = dci_cjson_child(layouts);
        while (obj2 != null) {
            let ty2 = self.dci_json_string(obj2, "type_name");
            if (self.dci_record_name_matches_type(ty2, type_id)) { return obj2; }
            obj2 = dci_cjson_next(obj2);
        }
        return null;
    }

    public fn dci_layout_object_for_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        let cached = llvm_mir_map_get(self.dci_layout_by_type_cache, type_id);
        if (cached != null) { return cached; }
        var obj = self.dci_contract_layout_for_type(type_id);
        if (obj == null) { obj = self.dci_local_layout_object_for_type(type_id); }
        if (obj != null) {
            llvm_mir_map_put(self.dci_layout_by_type_cache, type_id, obj);
            return obj;
        }
        return null;
    }

    public fn dci_layout_object_for_type_text(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        let hit = self.dci_indexed_layout(type_text);
        if (hit != null) { return hit; }
        let layouts = self.dci_root_exports_array("layouts");
        var obj = dci_cjson_child(layouts);
        while (obj != null) {
            let ty = self.dci_json_string(obj, "type_name");
            if (self.dci_record_name_matches_text(ty, type_text)) { return obj; }
            obj = dci_cjson_next(obj);
        }
        return null;
    }

    // ── Locally derived layouts for consumer-declared records ─────────────
    //
    // An open-generic instance closed over a *consumer* record has no
    // descriptor entry: the record is not part of the producer's artifact, so
    // no adapter ever measured it, yet the consumer must know the layout
    // before it can emit IR.  The layout is therefore derived here from what
    // both sides can see -- primitive widths, descriptor-measured records, and
    // the C rule for `@[repr(C)]` records -- and emitted next to the open
    // requests (`record` / `layout` lines) so the producer can define the
    // record and *measure* the very same thing.  A derived layout is a claim
    // the producer verifies; it never replaces a measurement that exists,
    // because `dci_contract_layout_for_type` is asked first.
    //
    // The derivation is deliberately narrow, and every restriction is a
    // fail-closed choice rather than a guess: a record is derivable only when
    // it is `@[repr(C)]` (so the C rule *is* its layout, floor included), and
    // every component is either a scalar or a record that is itself measured
    // by the descriptor or `@[repr(C)]`.  References, handles, arrays, tuples,
    // enums, unmeasured foreign-DCI declarations, unmeasured nested instances
    // and non-`repr(C)` classes are refused, so a case we cannot reason about
    // keeps the old "no layout" diagnostic instead of silently getting a
    // make-believe one.

    public fn dci_local_scalar_size(self, type_id: i32) -> i64 {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_BOOL() || kind == ty_I8() || kind == ty_U8()) { return 1; }
        if (kind == ty_I16() || kind == ty_U16()) { return 2; }
        if (kind == ty_CHAR() || kind == ty_I32() || kind == ty_U32() || kind == ty_F32()) { return 4; }
        if (kind == ty_I64() || kind == ty_U64() || kind == ty_ISIZE()
            || kind == ty_USIZE() || kind == ty_F64()) { return 8; }
        return 0;
    }

    public fn dci_local_boundary_component_ok(self, type_id: i32, depth: i32) -> bool {
        if (type_id == mir_id_invalid() || depth > 8) { return false; }
        let canonical = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical);
        if (kind != ty_CLASS()) { return self.dci_local_scalar_size(canonical) > 0; }
        if (self.type_is_dyn_trait(canonical) || self.type_is_str_abi(canonical)
            || self.type_is_option_abi(canonical) || self.type_is_result_abi(canonical)) {
            return false;
        }
        if (mir_unit_variant_count_for_type(&self.m, canonical) > 0) { return false; }
        if (mir_unit_field_count_for_type(&self.m, canonical) <= 0) { return false; }
        // A record the descriptor already measured is safe by measurement: the
        // producer said what it is, and the derived layout uses that number.
        if (self.dci_contract_layout_for_type(canonical) != null) { return true; }
        // Everything else must *be* a C-layout record.  A plain Vyx class
        // keeps an 8-byte alignment floor that the producer's struct does not
        // have, so its size is not derivable from its fields; an unmeasured
        // foreign-DCI declaration is a type nobody has laid out at all.
        if (!self.type_repr_is_c(canonical)) { return false; }
        if (mir_unit_type_is_foreign_dci(&self.m, canonical)) { return false; }
        if (self.dci_local_instance_is_open_instance(canonical)) { return false; }
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id == mir_id_invalid()) { return false; }
            if (!self.dci_local_boundary_component_ok(mir_unit_field_type(&self.m, field_id),
                                                      depth + 1)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// A closed instance of a foreign-DCI generic, e.g. `Pair2<i32,TestS>`.
    /// Nested instances stay outside the derived surface: the producer's own
    /// generic could lay them out any way it likes.
    public fn dci_local_instance_is_open_instance(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (!mir_unit_type_is_foreign_dci(&self.m, type_id)) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0) { return false; }
        return policy_generic_call_has_args(text.clone()) != 0;
    }

    /// Size of one component of a locally derived layout.  The descriptor is
    /// the authority for anything it has measured; the C rule (no class
    /// alignment floor) answers for `@[repr(C)]` records.
    public fn dci_local_component_size(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical);
        if (kind != ty_CLASS()) { return self.dci_local_scalar_size(canonical); }
        let contract = self.dci_contract_layout_for_type(canonical);
        if (contract != null) {
            let measured = self.dci_json_i64(contract, "size");
            if (measured > 0) { return measured; }
        }
        return self.dci_local_record_size(canonical);
    }

    public fn dci_local_component_align(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical = self.canonical_record_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, canonical);
        if (kind != ty_CLASS()) { return self.dci_local_scalar_size(canonical); }
        let contract = self.dci_contract_layout_for_type(canonical);
        if (contract != null) {
            let measured = self.dci_json_i64(contract, "alignment");
            if (measured > 0) { return measured; }
        }
        return self.dci_local_record_align(canonical);
    }

    /// Field-sequence size of a record under the C rule.
    public fn dci_local_record_size(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical = self.canonical_record_type_id(type_id);
        let packed = self.type_repr_is_packed(canonical);
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        if (n <= 0) { return 0; }
        var offset: i64 = 0;
        var natural: i64 = 1;
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id == mir_id_invalid()) { return 0; }
            let field_type = mir_unit_field_type(&self.m, field_id);
            let field_size = self.dci_local_component_size(field_type);
            var field_align = self.dci_local_component_align(field_type);
            if (packed) { field_align = 1; }
            if (field_size <= 0 || field_align <= 0) { return 0; }
            if (field_align > natural) { natural = field_align; }
            offset = self.align_up_i64(offset, field_align);
            offset = offset + self.align_up_i64(field_size, field_align);
            i = i + 1;
        }
        if (offset <= 0) { return 0; }
        return self.align_up_i64(offset, natural);
    }

    public fn dci_local_record_align(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return 0; }
        let canonical = self.canonical_record_type_id(type_id);
        let forced = self.type_repr_explicit_align(canonical);
        if (self.type_repr_is_packed(canonical)) {
            if (forced > 0) { return forced; }
            return 1;
        }
        var out: i64 = 1;
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id != mir_id_invalid()) {
                let field_align = self.dci_local_component_align(mir_unit_field_type(&self.m, field_id));
                if (field_align > out) { out = field_align; }
            }
            i = i + 1;
        }
        if (forced > out) { out = forced; }
        if (out <= 0) { return 1; }
        return out;
    }

    public fn dci_local_boundary_type_name(self, type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, type_id);
        let canonical = self.dci_canonical_type_name_text(text.clone());
        if (canonical.len > 0) { return canonical; }
        return text;
    }

    public fn dci_local_boundary_type_json(self, type_id: i32) -> string {
        return "{\"name\":\"" + self.dci_local_boundary_type_name(type_id)
               + "\",\"kind\":\"" + self.dci_open_type_kind_word(type_id)
               + "\",\"nullable\":false,\"reference\":\"value\"}";
    }

    /// `{"name":..,"offset":..,"type":{..}},..` under the same walk the sizes
    /// above use, so offsets and size can never disagree.
    public fn dci_local_record_fields_json(self, type_id: i32) -> string {
        let canonical = self.canonical_record_type_id(type_id);
        let packed = self.type_repr_is_packed(canonical);
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        var offset: i64 = 0;
        var out = "";
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id == mir_id_invalid()) { return ""; }
            let field_type = mir_unit_field_type(&self.m, field_id);
            let field_size = self.dci_local_component_size(field_type);
            var field_align = self.dci_local_component_align(field_type);
            if (packed) { field_align = 1; }
            if (field_size <= 0 || field_align <= 0) { return ""; }
            offset = self.align_up_i64(offset, field_align);
            if (i > 0) { out = out + ","; }
            out = out + "{\"name\":\"" + mir_unit_field_name(&self.m, field_id)
                  + "\",\"offset\":" + offset.toString()
                  + ",\"is_readonly\":false,\"visibility\":\"public\",\"type\":"
                  + self.dci_local_boundary_type_json(field_type) + "}";
            offset = offset + self.align_up_i64(field_size, field_align);
            i = i + 1;
        }
        return out;
    }

    /// `name:type:offset,...` -- the record's definition in the shape a
    /// producer can turn into `struct`/`#[repr(C)]` source.
    public fn dci_local_record_fields_csv(self, type_id: i32) -> string {
        let canonical = self.canonical_record_type_id(type_id);
        let packed = self.type_repr_is_packed(canonical);
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        var offset: i64 = 0;
        var out = "";
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id == mir_id_invalid()) { return ""; }
            let field_type = mir_unit_field_type(&self.m, field_id);
            let field_size = self.dci_local_component_size(field_type);
            var field_align = self.dci_local_component_align(field_type);
            if (packed) { field_align = 1; }
            if (field_size <= 0 || field_align <= 0) { return ""; }
            offset = self.align_up_i64(offset, field_align);
            if (i > 0) { out = out + ","; }
            out = out + mir_unit_field_name(&self.m, field_id) + ":"
                  + self.dci_local_boundary_type_name(field_type) + ":"
                  + offset.toString();
            offset = offset + self.align_up_i64(field_size, field_align);
            i = i + 1;
        }
        return out;
    }

    /// A consumer-declared record is one the descriptor never measured, that
    /// is not itself a foreign-DCI declaration, and whose layout *is* the C
    /// layout because it says so (`@[repr(C)]`).  Without that flag the
    /// record's own layout carries the class alignment floor, which no
    /// producer's `struct` has, so there is nothing honest to tell the
    /// producer about it.
    public fn dci_local_record_is_consumer_declared(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical) != ty_CLASS()) { return false; }
        if (mir_unit_type_is_foreign_dci(&self.m, canonical)) { return false; }
        if (self.dci_contract_layout_for_type(canonical) != null) { return false; }
        if (!self.type_repr_is_c(canonical)) { return false; }
        if (mir_unit_variant_count_for_type(&self.m, canonical) > 0) { return false; }
        return mir_unit_field_count_for_type(&self.m, canonical) > 0;
    }

    /// `record` lines for every consumer-declared record reachable from
    /// `type_id`, nested ones included.  Deduplicated across the whole unit.
    public fn dci_local_record_support_lines(self, type_id: i32) -> string {
        if (!self.dci_local_record_is_consumer_declared(type_id)) { return ""; }
        let canonical = self.canonical_record_type_id(type_id);
        let name = self.dci_local_boundary_type_name(canonical);
        if (name.len == 0) { return ""; }
        if (self.dci_local_reported_names.contains("\n" + name + "\n")) { return ""; }
        let size = self.dci_local_record_size(canonical);
        let align = self.dci_local_record_align(canonical);
        let csv = self.dci_local_record_fields_csv(canonical);
        if (size <= 0 || align <= 0 || csv.len == 0) { return ""; }
        self.dci_local_reported_names = self.dci_local_reported_names
                                        + "\n" + name + "\n";
        var out = "record\t" + name + "\t" + size.toString() + "\t"
                  + align.toString() + "\t" + csv + "\n";
        // Nested consumer-declared records: their definitions have to be in
        // scope before this one, so they are emitted first.
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id != mir_id_invalid()) {
                out = self.dci_local_record_support_lines(mir_unit_field_type(&self.m, field_id)) + out;
            }
            i = i + 1;
        }
        return out;
    }

    public fn dci_local_instance_layout_derivable(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let canonical = self.canonical_record_type_id(type_id);
        if (llvm_mir_type_kind(&self.m, canonical) != ty_CLASS()) { return false; }
        // Only a *closed* instance (`Pair2<i32,TestS>`) is a consumer-side
        // declaration; an open declaration has no layout to derive.
        if (!self.dci_local_instance_is_open_instance(canonical)) { return false; }
        // A measured instance keeps its measurement -- asked first, refused here.
        if (self.dci_contract_layout_for_type(canonical) != null) { return false; }
        if (self.type_is_dyn_trait(canonical) || self.type_is_str_abi(canonical)
            || self.type_is_option_abi(canonical) || self.type_is_result_abi(canonical)) {
            return false;
        }
        if (mir_unit_variant_count_for_type(&self.m, canonical) > 0) { return false; }
        let n = mir_unit_field_count_for_type(&self.m, canonical);
        if (n <= 0) { return false; }
        // Every component must be reason-about-able, *and* at least one of them
        // must be a consumer-declared record.  An instance whose arguments are
        // all things the producer can already see (scalars, measured records)
        // is one the adapter was supposed to measure: its missing layout is a
        // contract bug, and it keeps the loud diagnostic instead of quietly
        // acquiring a derived one.
        var consumer_component = false;
        var i: i32 = 0;
        while (i < n) {
            let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
            if (field_id == mir_id_invalid()) { return false; }
            let field_type = mir_unit_field_type(&self.m, field_id);
            if (!self.dci_local_boundary_component_ok(field_type, 0)) { return false; }
            if (self.dci_local_record_is_consumer_declared(field_type)) {
                consumer_component = true;
            }
            i = i + 1;
        }
        return consumer_component;
    }

    /// Record every consumer-declared record reachable from `type_id` into the
    /// requests sidecar.  Called for each open-generic instance's parameter and
    /// return types, so the producer learns the *definition* of a type argument
    /// it has never seen -- the consumer-declared record -- before it is asked
    /// to monomorphize an instance over it.
    public fn dci_local_emit_support_for_type(self, type_id: i32) {
        if (type_id == mir_id_invalid()) { return; }
        g_dci_local_record_lines = g_dci_local_record_lines
                                   + self.dci_local_record_support_lines(type_id);
    }

    /// The same, for every type a closed instance mentions.  Emitted from the
    /// one place that also emits the instance's `open` line, so a request can
    /// never reach the producer without the definitions it needs.
    public fn dci_local_emit_open_support(self, function_id: i32) {
        let param_count = self.function_source_param_count(function_id);
        var pi: i32 = 0;
        while (pi < param_count) {
            self.dci_local_emit_support_for_type(
                self.function_source_param_type(function_id, pi));
            pi = pi + 1;
        }
        self.dci_local_emit_support_for_type(self.m.function_return_type(function_id));
    }

    /// Synthesize the descriptor-shaped layout of a closed instance whose type
    /// arguments include a consumer-declared record, and tell the producer what
    /// was derived so it can measure the same thing.
    ///
    /// Derived objects are kept in a small slot array so the name-keyed lookups
    /// (`dci_layout_object_for_record_name` and everything built on it) can find
    /// them too; a second type id that canonicalises to the same instance gets
    /// the same object back.  Only the sidecar lines are additionally
    /// deduplicated by name, since a plain Vyx record reaches this path through
    /// the support emitter instead.
    public fn dci_local_layout_object_for_type(self, type_id: i32) -> rawptr {
        if (type_id == mir_id_invalid()) { return null; }
        let canonical = self.canonical_record_type_id(type_id);
        if (!self.dci_local_instance_layout_derivable(canonical)) { return null; }
        let name = self.dci_local_boundary_type_name(canonical);
        if (name.len == 0) { return null; }
        let existing = self.dci_local_layout_for_record_name(name.clone());
        if (existing != null) { return existing; }
        let size = self.dci_local_record_size(canonical);
        let align = self.dci_local_record_align(canonical);
        let fields = self.dci_local_record_fields_json(canonical);
        if (size <= 0 || align <= 0 || fields.len == 0) { return null; }
        let json = "{\"type_name\":\"" + name + "\",\"size\":" + size.toString()
                   + ",\"alignment\":" + align.toString()
                   + ",\"representation\":\"stable\",\"bases\":[]"
                   + ",\"has_vtable\":false,\"is_pod\":true"
                   + ",\"is_trivially_destructible\":true"
                   + ",\"lifecycle\":{\"copy_semantics\":\"trivial\""
                   + ",\"move_semantics\":\"trivial\",\"destruction\":\"trivial\""
                   + ",\"moved_from_state\":\"valid\",\"operations\":{}"
                   + ",\"ownership_model\":\"value\"}"
                   + ",\"dci_local_derived\":true"
                   + ",\"fields\":[" + fields + "]}";
        let parsed = cJSON_Parse(json.c_str());
        if (parsed == null) { return null; }
        self.dci_register_local_layout(parsed);
        if (!self.dci_local_reported_names.contains("\n" + name + "\n")) {
            self.dci_local_reported_names = self.dci_local_reported_names
                                            + "\n" + name + "\n";
            let n = mir_unit_field_count_for_type(&self.m, canonical);
            var i: i32 = 0;
            while (i < n) {
                let field_id = mir_unit_field_id_for_type_index(&self.m, canonical, i);
                if (field_id != mir_id_invalid()) {
                    self.dci_local_emit_support_for_type(mir_unit_field_type(&self.m, field_id));
                }
                i = i + 1;
            }
            g_dci_local_record_lines = g_dci_local_record_lines
                                       + "layout\t" + name + "\t" + size.toString()
                                       + "\t" + align.toString() + "\n";
        }
        return parsed;
    }

    /// Register a derived layout so the name-keyed lookups can find it.  The
    /// name is read back out of the object (`type_name`) rather than stored
    /// beside it, so nothing here owns a string.
    fn dci_register_local_layout(self, obj: rawptr) {
        if (obj == null) { return; }
        if (self.dci_local_layout_slots == null) {
            self.dci_local_layout_slots = malloc((64 * 8) as u64);
            if (self.dci_local_layout_slots == null) { return; }
        }
        if (self.dci_local_layout_count >= 64) { return; }
        ast_write_rawptr(ptr_offset(self.dci_local_layout_slots,
                                    (self.dci_local_layout_count * 8) as i64),
                         obj);
        self.dci_local_layout_count = self.dci_local_layout_count + 1;
    }

    public fn dci_local_layout_for_record_name(self, name: string) -> rawptr {
        if (name.len == 0 || self.dci_local_layout_slots == null) { return null; }
        var i: i32 = 0;
        while (i < self.dci_local_layout_count) {
            let obj = ast_read_rawptr(ptr_offset(self.dci_local_layout_slots,
                                                 (i * 8) as i64));
            if (obj != null) {
                let stored = self.dci_json_string(obj, "type_name");
                if (stored.len > 0 && (stored == name
                    || self.dci_record_name_matches_text(stored.clone(), name.clone()))) {
                    return obj;
                }
            }
            i = i + 1;
        }
        return null;
    }

    public fn dci_type_uses_stable_value_layout(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }

        let canonical = self.canonical_record_type_id(type_id);
        if (!mir_unit_type_is_foreign_dci(&self.m, canonical)) { return false; }
        // extern "dci" C++ structs are represented as classes internally;
        // the Descriptor representation, not that parser-specific flag,
        // determines whether their value ABI is stable.
        if (llvm_mir_type_kind(&self.m, canonical) != ty_CLASS()) {
            return false;
        }
        let layout = self.dci_layout_object_for_type(canonical);
        if (layout == null) { return false; }
        let representation = self.dci_json_string(layout, "representation");
        return representation == "stable" || representation == "transparent";
    }

    public fn dci_type_value_alignment(self, type_id: i32) -> i64 {
        if (!self.dci_type_uses_stable_value_layout(type_id)) { return 0; }
        return self.dci_json_i64(self.dci_layout_object_for_type(type_id), "alignment");
    }

    public fn dci_record_name_for_type(self, type_id: i32) -> string {
        let cached = llvm_mir_map_get(self.dci_record_name_cache, type_id);
        if (cached != null) { return from_cstr(cached); }
        let obj = self.dci_layout_object_for_type(type_id);
        if (obj == null) { return ""; }
        let out = self.dci_json_string(obj, "type_name");
        llvm_mir_map_put(self.dci_record_name_cache, type_id, ast_dup_c_string(out.clone()));
        return out;
    }

    public fn dci_record_name_for_type_text(self, type_text: string) -> string {
        let obj = self.dci_layout_object_for_type_text(type_text);
        if (obj == null) { return ""; }
        return self.dci_json_string(obj, "type_name");
    }

    public fn dci_record_name_derives_from_type(self,
                                                derived_record: string,
                                                base_type_id: i32,
                                                depth: i32) -> bool {
        if (derived_record.len == 0 || base_type_id == mir_id_invalid() || depth > 16) { return false; }
        let layout = self.dci_layout_object_for_record_name(derived_record);
        if (layout == null) { return false; }
        let bases = self.dci_json_item(layout, "bases");
        if (bases == null || cJSON_IsArray(bases) == 0) { return false; }
        let n = cJSON_GetArraySize(bases);
        var i: i32 = 0;
        while (i < n) {
            let obj = cJSON_GetArrayItem(bases, i);
            let base = self.dci_json_string(obj, "type_name");
            if (self.dci_record_name_matches_type(base, base_type_id)) { return true; }
            if (self.dci_record_name_derives_from_type(base, base_type_id, depth + 1)) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn dci_record_name_derives_from_record(self,
                                                  derived_record: string,
                                                  base_record: string,
                                                  depth: i32) -> bool {
        if (derived_record.len == 0 || base_record.len == 0 || depth > 16) { return false; }
        let layout = self.dci_layout_object_for_record_name(derived_record);
        if (layout == null) { return false; }
        let bases = self.dci_json_item(layout, "bases");
        if (bases == null || cJSON_IsArray(bases) == 0) { return false; }
        let n = cJSON_GetArraySize(bases);
        var i: i32 = 0;
        while (i < n) {
            let obj = cJSON_GetArrayItem(bases, i);
            let base = self.dci_json_string(obj, "type_name");
            if (base == base_record || self.dci_record_name_matches_text(base, base_record)) { return true; }
            if (self.dci_record_name_derives_from_record(base, base_record, depth + 1)) { return true; }
            i = i + 1;
        }
        return false;
    }

    public fn dci_type_derives_from(self, derived_type_id: i32, base_type_id: i32) -> bool {
        if (derived_type_id == mir_id_invalid() || base_type_id == mir_id_invalid()) { return false; }
        if (self.dci_record_name_matches_type(self.dci_record_name_for_type(base_type_id), derived_type_id)) {
            return true;
        }
        let derived_record = self.dci_record_name_for_type(derived_type_id);
        if (derived_record.len == 0) { return false; }
        return self.dci_record_name_derives_from_type(derived_record, base_type_id, 0);
    }

    public fn dci_constant_base_adjustment_offset(self, base_object: rawptr) -> i64 {
        if (base_object == null) { return -1; }
        let adjustment = self.dci_json_item(base_object, "adjustment");
        if (adjustment == null) {
            if (self.dci_json_bool(base_object, "is_virtual")) { return -1; }
            let legacy_offset = self.dci_json_item(base_object, "offset");
            if (legacy_offset == null) { return 0; }
            if (cJSON_IsNumber(legacy_offset) == 0) { return -1; }
            return self.dci_json_i64(base_object, "offset");
        }
        if (self.dci_json_string(adjustment, "kind") != "constant") { return -1; }
        let offset = self.dci_json_item(adjustment, "offset");
        if (offset == null || cJSON_IsNumber(offset) == 0) { return -1; }
        if (self.dci_json_bool(base_object, "is_virtual")) {
            let null_preserving = self.dci_json_item(adjustment, "null_preserving");
            if (null_preserving == null
                || (cJSON_IsTrue(null_preserving) == 0 && cJSON_IsFalse(null_preserving) == 0)) {
                return -1;
            }
        }
        return self.dci_json_i64(adjustment, "offset");
    }

    public fn dci_base_offset_bytes_for_records(self,
                                                derived_record: string,
                                                base_record: string,
                                                depth: i32) -> i64 {
        if (derived_record.len == 0 || base_record.len == 0 || depth > 16) { return -1; }
        if (derived_record == base_record || self.dci_record_name_matches_text(derived_record, base_record)) {
            return 0;
        }
        let layout = self.dci_layout_object_for_record_name(derived_record);
        if (layout == null) { return -1; }
        let bases = self.dci_json_item(layout, "bases");
        if (bases == null || cJSON_IsArray(bases) == 0) { return -1; }
        let n = cJSON_GetArraySize(bases);
        var i: i32 = 0;
        while (i < n) {
            let obj = cJSON_GetArrayItem(bases, i);
            let base = self.dci_json_string(obj, "type_name");
            if (base == base_record || self.dci_record_name_matches_text(base, base_record)) {
                return self.dci_constant_base_adjustment_offset(obj);
            }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            let obj2 = cJSON_GetArrayItem(bases, i);
            let offset2 = self.dci_constant_base_adjustment_offset(obj2);
            if (offset2 < 0) {
                i = i + 1;
                continue;
            }
            let base2 = self.dci_json_string(obj2, "type_name");
            let sub2 = self.dci_base_offset_bytes_for_records(base2, base_record, depth + 1);
            if (sub2 >= 0) { return offset2 + sub2; }
            i = i + 1;
        }
        return -1;
    }

    public fn dci_base_offset_bytes_for_types(self, derived_type_id: i32, base_type_id: i32) -> i64 {
        if (derived_type_id == mir_id_invalid() || base_type_id == mir_id_invalid()) { return -1; }
        let derived_canonical = self.canonical_record_type_id(derived_type_id);
        let base_canonical = self.canonical_record_type_id(base_type_id);
        if (derived_canonical == base_canonical) { return 0; }
        let derived_record = self.dci_record_name_for_type(derived_canonical);
        let base_record = self.dci_record_name_for_type(base_canonical);
        if (derived_record.len == 0 || base_record.len == 0) { return -1; }
        return self.dci_base_offset_bytes_for_records(derived_record, base_record, 0);
    }

    public fn dci_apply_direct_base_adjustment(self,
                                               ptr_value: rawptr,
                                               base_object: rawptr,
                                               label: string) -> rawptr {
        if (ptr_value == null || base_object == null) { return null; }
        let adjustment = self.dci_json_item(base_object, "adjustment");
        var null_preserving = self.dci_json_bool(adjustment, "null_preserving");
        var adjustment_kind = self.dci_json_string(adjustment, "kind");
        if (adjustment_kind.len == 0) { adjustment_kind = "constant"; }
        if (adjustment_kind == "constant"
            && self.dci_json_item(adjustment, "null_preserving") == null) {
            null_preserving = true;
        }
        if (!null_preserving) {
            return self.dci_apply_direct_base_adjustment_nonnull(ptr_value, base_object, label);
        }
        if (self.current_function_value == null) {
            self.report_error("cannot emit null-preserving DCI adjustment outside a function");
            return null;
        }
        let is_null = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        ptr_value,
                                        vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                        (label.clone() + ".is.null").c_str(),
                                        (label.clone() + ".is.null").len as u64);
        let null_name = label.clone() + ".null";
        let adjust_name = label.clone() + ".nonnull";
        let cont_name = label.clone() + ".cont";
        let null_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          null_name.c_str(),
                                          null_name.len as u64);
        let adjust_bb = vyx_rt_append_block(self.mod,
                                            self.current_function_value,
                                            adjust_name.c_str(),
                                            adjust_name.len as u64);
        let cont_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          cont_name.c_str(),
                                          cont_name.len as u64);
        if (is_null == null || null_bb == null || adjust_bb == null || cont_bb == null) {
            self.report_error("cannot create null-preserving DCI adjustment flow");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_null, null_bb, adjust_bb);

        vyx_rt_position_at_end(self.mod, null_bb);
        let null_value = vyx_rt_const_ptr_null(self.mod, self.ty_ptr);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, adjust_bb);
        let adjusted = self.dci_apply_direct_base_adjustment_nonnull(ptr_value,
                                                                     base_object,
                                                                     label.clone() + ".value");
        if (adjusted == null) { return null; }
        let adjusted_end_bb = vyx_rt_get_insert_block(self.mod);
        vyx_rt_build_br(self.mod, cont_bb);

        vyx_rt_position_at_end(self.mod, cont_bb);
        let result = vyx_rt_build_phi(self.mod,
                                      self.ty_ptr,
                                      (label.clone() + ".result").c_str(),
                                      (label.clone() + ".result").len as u64);
        if (result == null) {
            self.report_error("cannot create null-preserving DCI adjustment result");
            return null;
        }
        vyx_rt_add_incoming(self.mod, result, null_value, null_bb);
        vyx_rt_add_incoming(self.mod, result, adjusted, adjusted_end_bb);
        return result;
    }

    public fn dci_apply_direct_base_adjustment_nonnull(self,
                                                       ptr_value: rawptr,
                                                       base_object: rawptr,
                                                       label: string) -> rawptr {
        if (ptr_value == null || base_object == null) { return null; }
        let adjustment = self.dci_json_item(base_object, "adjustment");
        var kind = self.dci_json_string(adjustment, "kind");
        if (self.dci_json_bool(base_object, "is_virtual")
            && (adjustment == null || kind.len == 0)) {
            self.report_error("DCI virtual base requires an explicit adjustment");
            return null;
        }
        if (kind.len == 0) {
            if (adjustment != null) {
                self.report_error("DCI base adjustment is missing its kind");
                return null;
            }
            kind = "constant";
        }
        if (kind == "constant") {
            if (self.dci_json_bool(base_object, "is_virtual")) {
                self.report_error("DCI virtual base cannot use a constant adjustment");
                return null;
            }
            var offset = self.dci_json_i64(base_object, "offset");
            if (adjustment != null && self.dci_json_item(adjustment, "offset") == null) {
                self.report_error("DCI constant base adjustment is missing its offset");
                return null;
            }
            if (adjustment != null) {
                offset = self.dci_json_i64(adjustment, "offset");
            }
            if (offset == 0) { return ptr_value; }
            return self.ptr_offset_bytes(ptr_value,
                                         vyx_rt_const_int(self.mod, self.ty_i64, offset, 1),
                                         label);
        }
        if (kind == "table") {
            if (adjustment == null
                || self.dci_json_item(adjustment, "table_pointer_offset") == null
                || (self.dci_json_item(adjustment, "table_entry_offset") == null
                    && self.dci_json_item(adjustment, "table_offset") == null)
                || self.dci_json_item(adjustment, "table_entry_size") == null) {
                self.report_error("incomplete DCI table base adjustment requires Stub mode");
                return null;
            }
            let table_pointer_offset = self.dci_json_i64(adjustment, "table_pointer_offset");
            var table_entry_offset = self.dci_json_i64(adjustment, "table_entry_offset");
            if (self.dci_json_item(adjustment, "table_entry_offset") == null) {
                table_entry_offset = self.dci_json_i64(adjustment, "table_offset");
            }
            var entry_size = self.dci_json_i64(adjustment, "table_entry_size");
            if (entry_size <= 0) { entry_size = 4; }
            let displacement_base = self.dci_json_i64(adjustment, "displacement_base_offset");
            if (entry_size != 1 && entry_size != 2 && entry_size != 4 && entry_size != 8) {
                self.report_error("unsupported DCI adjustment table entry size " + entry_size.toString());
                return null;
            }
            let table_pointer_addr = self.ptr_offset_bytes(ptr_value,
                                                           vyx_rt_const_int(self.mod,
                                                                            self.ty_i64,
                                                                            table_pointer_offset,
                                                                            1),
                                                           label.clone() + ".table.ptr.addr");
            let table_pointer = vyx_rt_build_load(self.mod,
                                                  self.ty_ptr,
                                                  table_pointer_addr,
                                                  (label.clone() + ".table.ptr").c_str(),
                                                  (label.clone() + ".table.ptr").len as u64);
            let entry_addr = self.ptr_offset_bytes(table_pointer,
                                                   vyx_rt_const_int(self.mod,
                                                                    self.ty_i64,
                                                                    table_entry_offset,
                                                                    1),
                                                   label.clone() + ".table.entry.addr");
            let entry_type = self.int_type_for_bits((entry_size * 8) as i32);
            var displacement = vyx_rt_build_load(self.mod,
                                                 entry_type,
                                                 entry_addr,
                                                 (label.clone() + ".table.entry").c_str(),
                                                 (label.clone() + ".table.entry").len as u64);
            if (displacement == null) { return null; }
            if (entry_size < 8) {
                if (self.dci_json_bool(adjustment, "table_entry_signed")) {
                    displacement = vyx_rt_build_sext(self.mod,
                                                      displacement,
                                                      self.ty_i64,
                                                      (label.clone() + ".table.sext").c_str(),
                                                      (label.clone() + ".table.sext").len as u64);
                } else {
                    displacement = vyx_rt_build_zext(self.mod,
                                                      displacement,
                                                      self.ty_i64,
                                                      (label.clone() + ".table.zext").c_str(),
                                                      (label.clone() + ".table.zext").len as u64);
                }
            }
            if (displacement_base != 0) {
                displacement = vyx_rt_build_add(self.mod,
                                                 displacement,
                                                 vyx_rt_const_int(self.mod,
                                                                  self.ty_i64,
                                                                  displacement_base,
                                                                  1),
                                                 (label.clone() + ".table.base").c_str(),
                                                 (label.clone() + ".table.base").len as u64);
            }
            return self.ptr_offset_bytes(ptr_value, displacement, label.clone() + ".table.result");
        }
        if (kind == "operation") {
            self.report_error("DCI base adjustment operation requires Stub mode");
            return null;
        }
        self.report_error("unsupported DCI base adjustment kind `" + kind + "`");
        return null;
    }

    public fn dci_base_adjustment_is_directly_executable(self, base_object: rawptr) -> bool {
        if (base_object == null) { return false; }
        let adjustment = self.dci_json_item(base_object, "adjustment");
        if (adjustment == null) { return !self.dci_json_bool(base_object, "is_virtual"); }
        let kind = self.dci_json_string(adjustment, "kind");
        if (kind == "constant") {
            let offset = self.dci_json_item(adjustment, "offset");
            if (offset == null || cJSON_IsNumber(offset) == 0) { return false; }
            return !self.dci_json_bool(base_object, "is_virtual");
        }
        if (kind != "table" || adjustment == null) { return false; }
        let table_pointer_offset = self.dci_json_item(adjustment, "table_pointer_offset");
        let table_entry_offset = self.dci_json_item(adjustment, "table_entry_offset");
        let legacy_table_offset = self.dci_json_item(adjustment, "table_offset");
        let table_entry_size = self.dci_json_item(adjustment, "table_entry_size");
        let table_entry_signed = self.dci_json_item(adjustment, "table_entry_signed");
        let displacement_base = self.dci_json_item(adjustment, "displacement_base_offset");
        let null_preserving = self.dci_json_item(adjustment, "null_preserving");
        if (table_pointer_offset == null || cJSON_IsNumber(table_pointer_offset) == 0) { return false; }
        if ((table_entry_offset == null || cJSON_IsNumber(table_entry_offset) == 0)
            && (legacy_table_offset == null || cJSON_IsNumber(legacy_table_offset) == 0)) {
            return false;
        }
        if (table_entry_size == null || cJSON_IsNumber(table_entry_size) == 0
            || displacement_base == null || cJSON_IsNumber(displacement_base) == 0) {
            return false;
        }
        if (table_entry_signed == null
            || (cJSON_IsTrue(table_entry_signed) == 0 && cJSON_IsFalse(table_entry_signed) == 0)
            || null_preserving == null
            || (cJSON_IsTrue(null_preserving) == 0 && cJSON_IsFalse(null_preserving) == 0)
            || self.dci_json_string(adjustment, "result") != "object_plus_base_plus_displacement") {
            return false;
        }
        let entry_size = self.dci_json_i64(adjustment, "table_entry_size");
        return entry_size == 1 || entry_size == 2 || entry_size == 4 || entry_size == 8;
    }

    public fn dci_adjust_pointer_between_records(self,
                                                 ptr_value: rawptr,
                                                 derived_record: string,
                                                 base_record: string,
                                                 depth: i32,
                                                 label: string) -> rawptr {
        if (ptr_value == null || derived_record.len == 0 || base_record.len == 0 || depth > 16) {
            return null;
        }
        if (derived_record == base_record
            || self.dci_record_name_matches_text(derived_record, base_record)) {
            return ptr_value;
        }
        let layout = self.dci_layout_object_for_record_name(derived_record);
        if (layout == null) { return null; }
        let bases = self.dci_json_item(layout, "bases");
        if (bases == null || cJSON_IsArray(bases) == 0) { return null; }
        let count = cJSON_GetArraySize(bases);
        var i: i32 = 0;
        while (i < count) {
            let base = cJSON_GetArrayItem(bases, i);
            let direct_name = self.dci_json_string(base, "type_name");
            if (direct_name == base_record
                || self.dci_record_name_matches_text(direct_name, base_record)) {
                if (!self.dci_base_adjustment_is_directly_executable(base)) {
                    i = i + 1;
                    continue;
                }
                return self.dci_apply_direct_base_adjustment(ptr_value, base, label);
            }
            i = i + 1;
        }
        i = 0;
        while (i < count) {
            let next_base = cJSON_GetArrayItem(bases, i);
            let next_name = self.dci_json_string(next_base, "type_name");
            if (self.dci_base_adjustment_is_directly_executable(next_base)
                && self.dci_record_name_derives_from_record(next_name, base_record, depth + 1)) {
                let next_ptr = self.dci_apply_direct_base_adjustment(ptr_value,
                                                                     next_base,
                                                                     label.clone() + ".step");
                if (next_ptr == null) { return null; }
                return self.dci_adjust_pointer_between_records(next_ptr,
                                                               next_name,
                                                               base_record,
                                                               depth + 1,
                                                               label);
            }
            i = i + 1;
        }
        return null;
    }

    public fn adjust_dci_base_pointer(self,
                                      ptr_value: rawptr,
                                      source_type_id: i32,
                                      target_type_id: i32,
                                      label: string) -> rawptr {
        if (ptr_value == null) { return null; }
        if (source_type_id == mir_id_invalid() || target_type_id == mir_id_invalid()) { return ptr_value; }
        if (!self.type_is_class_pointer_abi(source_type_id) || !self.type_is_class_pointer_abi(target_type_id)) {
            // Native value classes still flatten MI by GEP; only skip when
            // neither side is a CLASS record.
            let source_kind = llvm_mir_type_kind(&self.m, self.canonical_record_type_id(source_type_id));
            let target_kind = llvm_mir_type_kind(&self.m, self.canonical_record_type_id(target_type_id));
            if (source_kind != ty_CLASS() || target_kind != ty_CLASS()) {
                return ptr_value;
            }
        }
        let source_canonical = self.canonical_record_type_id(source_type_id);
        let target_canonical = self.canonical_record_type_id(target_type_id);
        if (source_canonical == target_canonical) { return ptr_value; }
        if (self.type_is_class_pointer_abi(source_type_id) && self.type_is_class_pointer_abi(target_type_id)) {
            let source_record = self.dci_record_name_for_type(source_canonical);
            let target_record = self.dci_record_name_for_type(target_canonical);
            let adjusted = self.dci_adjust_pointer_between_records(ptr_value,
                                                                   source_record,
                                                                   target_record,
                                                                   0,
                                                                   label);
            if (adjusted != null) { return adjusted; }
        }
        let vyx_idx = self.record_layout_subobject_field_index(source_canonical, target_canonical);
        if (vyx_idx > 0) {
            var base_ty = self.class_record_storage_ty(source_canonical);
            if (base_ty == null) { base_ty = self.lower_storage_type(source_canonical); }
            if (base_ty == null) {
                self.report_error("cannot lower flattened class layout for "
                          + llvm_mir_type_text(&self.m, source_canonical)
                          + " -> "
                          + llvm_mir_type_text(&self.m, target_canonical));
                return null;
            }
            let gep = vyx_rt_build_gep2(self.mod,
                                        base_ty,
                                        ptr_value,
                                        vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                        vyx_rt_const_int(self.mod, self.ty_i32, vyx_idx as i64, 0),
                                        label.c_str(),
                                        label.len as u64);
            if (gep == null) {
                self.report_error("cannot GEP flattened parent subobject "
                          + llvm_mir_type_text(&self.m, source_canonical)
                          + " -> "
                          + llvm_mir_type_text(&self.m, target_canonical));
                return null;
            }
            return gep;
        }
        if (vyx_idx == 0) { return ptr_value; }
        if (self.type_is_class_pointer_abi(source_type_id)
            && self.type_is_class_pointer_abi(target_type_id)
            && self.type_ids_compatible(target_canonical, source_canonical)) {
            self.report_error("missing DCI base adjustment "
                      + llvm_mir_type_text(&self.m, source_canonical)
                      + " -> "
                      + llvm_mir_type_text(&self.m, target_canonical));
            return null;
        }
        return ptr_value;
    }

    public fn dci_record_size_bytes_for_exact_type(self, type_id: i32) -> i64 {
        let obj = self.dci_layout_object_for_type(type_id);
        if (obj == null) { return -1; }
        return self.dci_json_i64(obj, "size");
    }

    public fn dci_field_offset_bits_for_record_name(self,
                                                    record_name: string,
                                                    field_name: string,
                                                    depth: i32) -> i64 {
        if (record_name.len == 0 || field_name.len == 0 || depth > 16) { return -1; }
        let layout = self.dci_layout_object_for_record_name(record_name);
        if (layout == null) { return -1; }
        let fields = self.dci_json_item(layout, "fields");
        var i: i32 = 0;
        if (fields != null && cJSON_IsArray(fields) != 0) {
            let n = cJSON_GetArraySize(fields);
            while (i < n) {
                let obj = cJSON_GetArrayItem(fields, i);
                if (self.dci_json_string(obj, "name") == field_name) {
                    return self.dci_json_i64(obj, "offset") * 8;
                }
                i = i + 1;
            }
        }
        let bases = self.dci_json_item(layout, "bases");
        if (bases != null && cJSON_IsArray(bases) != 0) {
            let nb = cJSON_GetArraySize(bases);
            i = 0;
            while (i < nb) {
                let obj2 = cJSON_GetArrayItem(bases, i);
                let base_offset_bytes = self.dci_constant_base_adjustment_offset(obj2);
                if (base_offset_bytes < 0) {
                    i = i + 1;
                    continue;
                }
                let base = self.dci_json_string(obj2, "type_name");
                let field_offset = self.dci_field_offset_bits_for_record_name(base, field_name, depth + 1);
                if (field_offset >= 0) { return base_offset_bytes * 8 + field_offset; }
                i = i + 1;
            }
        }
        return -1;
    }

    public fn dci_field_offset_bits_for_type(self, record_type_id: i32, field_name: string) -> i64 {
        if (!mir_unit_has_dci_abi(&self.m) || record_type_id == mir_id_invalid() || field_name.len == 0) { return -1; }
        let record_name = self.dci_record_name_for_type(record_type_id);
        if (record_name.len > 0) {
            return self.dci_field_offset_bits_for_record_name(record_name, field_name, 0);
        }
        return -1;
    }

    public fn dci_direct_field_object_for_record_name(self,
                                                      record_name: string,
                                                      field_name: string) -> rawptr {
        if (record_name.len == 0 || field_name.len == 0) { return null; }
        let layout = self.dci_layout_object_for_record_name(record_name);
        if (layout == null) { return null; }
        let fields = self.dci_json_item(layout, "fields");
        if (fields != null && cJSON_IsArray(fields) != 0) {
            let count = cJSON_GetArraySize(fields);
            var i: i32 = 0;
            while (i < count) {
                let field = cJSON_GetArrayItem(fields, i);
                if (self.dci_json_string(field, "name") == field_name) { return field; }
                i = i + 1;
            }
        }
        return null;
    }

    public fn dci_field_object_for_record_name(self,
                                               record_name: string,
                                               field_name: string,
                                               depth: i32) -> rawptr {
        if (record_name.len == 0 || field_name.len == 0 || depth > 16) { return null; }
        let direct = self.dci_direct_field_object_for_record_name(record_name, field_name);
        if (direct != null) { return direct; }
        let layout = self.dci_layout_object_for_record_name(record_name);
        if (layout == null) { return null; }
        let bases = self.dci_json_item(layout, "bases");
        if (bases != null && cJSON_IsArray(bases) != 0) {
            let base_count = cJSON_GetArraySize(bases);
            var base_index: i32 = 0;
            while (base_index < base_count) {
                let base = cJSON_GetArrayItem(bases, base_index);
                let found = self.dci_field_object_for_record_name(self.dci_json_string(base, "type_name"),
                                                                  field_name,
                                                                  depth + 1);
                if (found != null) { return found; }
                base_index = base_index + 1;
            }
        }
        return null;
    }

    public fn dci_bitfield_for_place(self, place_id: i32) -> rawptr {
        if (place_id == mir_id_invalid() || self.m.place_kind(place_id) != mir_place_field()) {
            return null;
        }
        let base_place = self.m.place_base(place_id);
        let base_type = self.canonical_record_type_id(self.place_effective_type(base_place));
        var field_id = self.remapped_field_for_base(base_type, self.m.place_field(place_id));
        if (field_id == mir_id_invalid()) { field_id = self.m.place_field(place_id); }
        if (field_id == mir_id_invalid()) { return null; }
        let record_type = self.foreign_dci_field_record_type(base_type, field_id);
        if (record_type == mir_id_invalid()) { return null; }
        let field = self.dci_field_object_for_record_name(self.dci_record_name_for_type(record_type),
                                                          mir_unit_field_name(&self.m, field_id),
                                                          0);
        if (field == null) { return null; }
        var bitfield = self.dci_json_item(field, "bitfield");
        if (bitfield == null) {
            let storage = self.dci_json_item(field, "storage");
            if (self.dci_json_string(storage, "kind") == "bitfield") { bitfield = storage; }
        }
        if (bitfield == null || cJSON_IsObject(bitfield) == 0) { return null; }
        return bitfield;
    }

    public fn dci_bitfield_storage_size(self, bitfield: rawptr) -> i64 {
        var out = self.dci_json_i64(bitfield, "storage_size");
        if (out <= 0) { out = self.dci_json_i64(bitfield, "unit_size"); }
        return out;
    }

    public fn dci_bitfield_operation_is_complete(self, operation: rawptr) -> bool {
        if (operation == null || cJSON_IsObject(operation) == 0) { return false; }
        if (self.dci_json_string(operation, "symbol").len > 0
            || self.dci_json_string(operation, "intrinsic").len > 0) {
            return true;
        }
        let table = self.dci_json_string(operation, "dispatch_table");
        let slot = self.dci_json_item(operation, "slot");
        return table.len > 0 && slot != null && cJSON_IsNumber(slot) != 0
            && self.dci_json_i64(operation, "slot") >= 0;
    }

    public fn require_dci_direct_bitfield_contract(self,
                                                   bitfield: rawptr,
                                                   place_id: i32) -> bool {
        let storage_offset = self.dci_json_item(bitfield, "storage_offset");
        let storage_size = self.dci_json_item(bitfield, "storage_size");
        let bit_offset = self.dci_json_item(bitfield, "bit_offset");
        let bit_width = self.dci_json_item(bitfield, "bit_width");
        let signed_value = self.dci_json_item(bitfield, "signed");
        let bit_order = self.dci_json_string(bitfield, "bit_order");
        let read_mode = self.dci_json_string(bitfield, "read");
        let write_mode = self.dci_json_string(bitfield, "write");
        if (bit_order == "target") {
            self.report_error("DCI bitfield bit_order `target` has no Direct Profile interpretation for place #"
                       + place_id.toString());
            return false;
        }
        if (storage_offset == null || cJSON_IsNumber(storage_offset) == 0
            || storage_size == null || cJSON_IsNumber(storage_size) == 0
            || bit_offset == null || cJSON_IsNumber(bit_offset) == 0
            || bit_width == null || cJSON_IsNumber(bit_width) == 0
            || signed_value == null
            || (cJSON_IsTrue(signed_value) == 0 && cJSON_IsFalse(signed_value) == 0)
            || (bit_order != "lsb0" && bit_order != "msb0")
            || (read_mode != "direct" && read_mode != "operation" && read_mode != "unavailable")
            || (write_mode != "direct" && write_mode != "operation" && write_mode != "unavailable")
            || (read_mode == "operation"
                && !self.dci_bitfield_operation_is_complete(
                    self.dci_json_item(bitfield, "read_operation")))
            || (write_mode == "operation"
                && !self.dci_bitfield_operation_is_complete(
                    self.dci_json_item(bitfield, "write_operation")))) {
            self.report_error("incomplete or unsupported DCI bitfield Direct contract for place #"
                       + place_id.toString());
            return false;
        }
        return true;
    }

    public fn dci_bitfield_effective_offset(self, bitfield: rawptr, storage_bits: i32) -> i32 {
        let raw = self.dci_json_i64(bitfield, "bit_offset") as i32;
        let width = self.dci_json_i64(bitfield, "bit_width") as i32;
        if (self.dci_json_string(bitfield, "bit_order") == "msb0") {
            return storage_bits - raw - width;
        }
        return raw;
    }

    public fn dci_bitfield_mask(self, width: i32) -> i64 {
        if (width >= 64) { return -1; }
        if (width <= 0) { return 0; }
        return ((1 as i64) << width) - 1;
    }

    public fn lower_dci_bitfield_read(self,
                                      place_id: i32,
                                      storage_addr: rawptr,
                                      value_type: i32) -> rawptr {
        let bitfield = self.dci_bitfield_for_place(place_id);
        if (bitfield == null) { return null; }
        if (!self.require_dci_direct_bitfield_contract(bitfield, place_id)) { return null; }
        let read_mode = self.dci_json_string(bitfield, "read");
        if (read_mode != "direct") {
            self.report_error("DCI bitfield read mode `" + read_mode
                      + "` is unsupported by the Direct Consumer for place #"
                      + place_id.toString());
            return null;
        }
        let storage_size = self.dci_bitfield_storage_size(bitfield);
        let storage_bits = (storage_size * 8) as i32;
        let width = self.dci_json_i64(bitfield, "bit_width") as i32;
        let offset = self.dci_bitfield_effective_offset(bitfield, storage_bits);
        let value_bits = llvm_mir_int_bits_for_kind(llvm_mir_type_kind(&self.m, value_type));
        if ((storage_bits != 8 && storage_bits != 16 && storage_bits != 32 && storage_bits != 64)
            || width <= 0 || width > storage_bits || offset < 0 || offset + width > storage_bits
            || value_bits <= 0) {
            self.report_error("invalid DCI bitfield read contract for place #" + place_id.toString());
            return null;
        }
        let storage_type = self.int_type_for_bits(storage_bits);
        var value = vyx_rt_build_load(self.mod,
                                      storage_type,
                                      storage_addr,
                                      "dci.bitfield.storage".c_str(),
                                      20);
        if (value == null) { return null; }
        if (offset > 0) {
            value = vyx_rt_build_lshr(self.mod,
                                      value,
                                      vyx_rt_const_int(self.mod, storage_type, offset as i64, 0),
                                      "dci.bitfield.shift".c_str(),
                                      18);
        }
        value = vyx_rt_build_and(self.mod,
                                 value,
                                 vyx_rt_const_int(self.mod,
                                                  storage_type,
                                                  self.dci_bitfield_mask(width),
                                                  0),
                                 "dci.bitfield.mask".c_str(),
                                 17);
        let destination_type = self.int_type_for_bits(value_bits);
        if (self.dci_json_bool(bitfield, "signed") && width < storage_bits) {
            let sign_bit = (1 as i64) << (width - 1);
            value = vyx_rt_build_xor(self.mod,
                                     value,
                                     vyx_rt_const_int(self.mod, storage_type, sign_bit, 0),
                                     "dci.bitfield.sign.flip".c_str(),
                                     23);
            value = vyx_rt_build_sub(self.mod,
                                     value,
                                     vyx_rt_const_int(self.mod, storage_type, sign_bit, 0),
                                     "dci.bitfield.sign.fill".c_str(),
                                     23);
        }
        if (value_bits > storage_bits) {
            if (self.dci_json_bool(bitfield, "signed")) {
                value = vyx_rt_build_sext(self.mod,
                                          value,
                                          destination_type,
                                          "dci.bitfield.sign".c_str(),
                                          17);
            } else {
                value = vyx_rt_build_zext(self.mod,
                                          value,
                                          destination_type,
                                          "dci.bitfield.zero".c_str(),
                                          17);
            }
        } else if (value_bits < storage_bits) {
            value = vyx_rt_build_trunc(self.mod,
                                       value,
                                       destination_type,
                                       "dci.bitfield.result".c_str(),
                                       19);
        }
        return value;
    }

    public fn lower_dci_bitfield_store(self,
                                       place_id: i32,
                                       storage_addr: rawptr,
                                       value_id: i32,
                                       value_type: i32) -> bool {
        let bitfield = self.dci_bitfield_for_place(place_id);
        if (bitfield == null) { return false; }
        if (!self.require_dci_direct_bitfield_contract(bitfield, place_id)) { return true; }
        let write_mode = self.dci_json_string(bitfield, "write");
        if (write_mode != "direct") {
            self.report_error("DCI bitfield write mode `" + write_mode
                      + "` is unsupported by the Direct Consumer for place #"
                      + place_id.toString());
            return true;
        }
        let storage_size = self.dci_bitfield_storage_size(bitfield);
        let storage_bits = (storage_size * 8) as i32;
        let width = self.dci_json_i64(bitfield, "bit_width") as i32;
        let offset = self.dci_bitfield_effective_offset(bitfield, storage_bits);
        let source_bits = llvm_mir_int_bits_for_kind(llvm_mir_type_kind(&self.m, value_type));
        if ((storage_bits != 8 && storage_bits != 16 && storage_bits != 32 && storage_bits != 64)
            || width <= 0 || width > storage_bits || offset < 0 || offset + width > storage_bits
            || source_bits <= 0) {
            self.report_error("invalid DCI bitfield write contract for place #" + place_id.toString());
            return true;
        }
        let storage_type = self.int_type_for_bits(storage_bits);
        var incoming = self.lower_value_as(value_id, value_type);
        if (incoming == null) { return true; }
        if (source_bits < storage_bits) {
            incoming = vyx_rt_build_zext(self.mod,
                                         incoming,
                                         storage_type,
                                         "dci.bitfield.extend".c_str(),
                                         19);
        } else if (source_bits > storage_bits) {
            incoming = vyx_rt_build_trunc(self.mod,
                                          incoming,
                                          storage_type,
                                          "dci.bitfield.trunc".c_str(),
                                          18);
        }
        let low_mask = self.dci_bitfield_mask(width);
        incoming = vyx_rt_build_and(self.mod,
                                    incoming,
                                    vyx_rt_const_int(self.mod, storage_type, low_mask, 0),
                                    "dci.bitfield.input".c_str(),
                                    18);
        if (offset > 0) {
            incoming = vyx_rt_build_shl(self.mod,
                                        incoming,
                                        vyx_rt_const_int(self.mod, storage_type, offset as i64, 0),
                                        "dci.bitfield.position".c_str(),
                                        21);
        }
        var shifted_mask = low_mask;
        if (offset > 0) { shifted_mask = low_mask << offset; }
        let old_value = vyx_rt_build_load(self.mod,
                                          storage_type,
                                          storage_addr,
                                          "dci.bitfield.old".c_str(),
                                          16);
        let cleared = vyx_rt_build_and(self.mod,
                                       old_value,
                                       vyx_rt_const_int(self.mod, storage_type, ~shifted_mask, 0),
                                       "dci.bitfield.clear".c_str(),
                                       18);
        let merged = vyx_rt_build_or(self.mod,
                                     cleared,
                                     incoming,
                                     "dci.bitfield.merge".c_str(),
                                     18);
        vyx_rt_build_store(self.mod, merged, storage_addr);
        return true;
    }

    public fn foreign_dci_field_record_type(self, base_type_id: i32, field_id: i32) -> i32 {
        if (field_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (!self.unit_has_dci_layout_inputs() && !self.unit_has_foreign_dci_types()) {
            return mir_id_invalid();
        }
        if (base_type_id != mir_id_invalid()) {
            let cached = self.pair_bool_cache_get(self.foreign_dci_field_record_cache, base_type_id, field_id);
            if (cached != 0) {
                return cached - 1;
            }
        }
        let field_name = mir_unit_field_name(&self.m, field_id);
        var result = mir_id_invalid();
        if (base_type_id != mir_id_invalid()
            && self.type_is_foreign_dci(base_type_id)
            && self.dci_direct_field_object_for_record_name(self.dci_record_name_for_type(base_type_id),
                                                            field_name) != null) {
            result = base_type_id;
        }
        let owner_type = mir_unit_field_owner_type(&self.m, field_id);
        if (result == mir_id_invalid()
            && owner_type != mir_id_invalid()
            && self.type_is_foreign_dci(owner_type)) {
            result = owner_type;
        }
        if (result == mir_id_invalid()
            && base_type_id != mir_id_invalid()
            && self.type_is_foreign_dci(base_type_id)) {
            result = base_type_id;
        }
        if (result == mir_id_invalid()) {
            let prefix_record = self.dci_foreign_prefix_record_type(base_type_id, field_name);
            if (prefix_record != mir_id_invalid()) { result = prefix_record; }
        }
        if (base_type_id != mir_id_invalid()) {
            self.pair_bool_cache_put(self.foreign_dci_field_record_cache, base_type_id, field_id, result + 1);
        }
        return result;
    }

    public fn dci_foreign_prefix_record_type(self, base_type_id: i32, field_name: string) -> i32 {
        if (base_type_id == mir_id_invalid()) { return mir_id_invalid(); }
        let canonical = self.canonical_record_type_id(base_type_id);
        var type_id: i32 = 1;
        while (type_id <= self.m.types.count) {
            if (type_id != canonical
                && self.type_is_foreign_dci(type_id)
                && self.record_layout_prefix_compatible(canonical, type_id)
                && self.dci_record_size_bytes_for_exact_type(type_id) > 0) {
                if (field_name.len == 0 || self.dci_field_offset_bits_for_type(type_id, field_name) >= 0) {
                    return type_id;
                }
            }
            type_id = type_id + 1;
        }
        return mir_id_invalid();
    }

    public fn dci_record_size_bytes_for_type(self, type_id: i32) -> i64 {
        if (type_id == mir_id_invalid()) { return -1; }
        if (!self.unit_has_dci_layout_inputs() && !self.unit_has_foreign_dci_types()) {
            return -1;
        }
        let canonical = self.canonical_record_type_id(type_id);
        if (self.type_is_foreign_dci(canonical)) {
            return self.dci_record_size_bytes_for_exact_type(canonical);
        }
        let prefix_record = self.dci_foreign_prefix_record_type(canonical, "");
        if (prefix_record != mir_id_invalid()) {
            return self.dci_record_size_bytes_for_exact_type(prefix_record);
        }
        var best: i64 = -1;
        var field_id: i32 = 1;
        while (field_id <= self.m.field_count) {
            let owner_type = mir_unit_field_owner_type(&self.m, field_id);
            if (owner_type != mir_id_invalid()
                && self.type_is_foreign_dci(owner_type)
                && self.field_owner_accepts_base_type(owner_type, canonical)) {
                let sz = self.dci_record_size_bytes_for_exact_type(owner_type);
                if (sz > best) { best = sz; }
            }
            field_id = field_id + 1;
        }
        return best;
    }

    public fn dci_field_addr(self, base_addr: rawptr, base_type_id: i32, field_id: i32) -> rawptr {
        let record_type = self.foreign_dci_field_record_type(base_type_id, field_id);
        if (record_type == mir_id_invalid()) { return null; }
        var record_base_addr = base_addr;
        let canonical_base = self.canonical_record_type_id(base_type_id);
        let canonical_record = self.canonical_record_type_id(record_type);
        if (canonical_base != canonical_record
            && self.dci_type_derives_from(canonical_base, canonical_record)) {
            record_base_addr = self.adjust_dci_base_pointer(base_addr,
                                                            canonical_base,
                                                            canonical_record,
                                                            "dci.field.base");
            if (record_base_addr == null) { return null; }
        }
        let field_name = mir_unit_field_name(&self.m, field_id);
        var offset_bits = self.dci_field_offset_bits_for_type(record_type, field_name);
        let field_object = self.dci_field_object_for_record_name(self.dci_record_name_for_type(record_type),
                                                                 field_name,
                                                                 0);
        if (field_object != null) {
            var bitfield = self.dci_json_item(field_object, "bitfield");
            if (bitfield == null) {
                let legacy_storage = self.dci_json_item(field_object, "storage");
                if (self.dci_json_string(legacy_storage, "kind") == "bitfield") {
                    bitfield = legacy_storage;
                }
            }
            if (bitfield != null) {
                var storage_offset = self.dci_json_i64(bitfield, "storage_offset");
                if (self.dci_json_item(bitfield, "storage_offset") == null) {
                    storage_offset = self.dci_json_i64(bitfield, "byte_offset");
                }
                offset_bits = storage_offset * 8;
            }
        }
        if (offset_bits < 0) {
            self.report_error("missing DCI field layout for "
                      + llvm_mir_type_text(&self.m, record_type)
                      + "."
                      + field_name);
            return null;
        }
        if ((offset_bits % 8) != 0) {
            self.report_error("DCI field storage is not byte-addressable for "
                      + llvm_mir_type_text(&self.m, record_type)
                      + "."
                      + field_name);
            return null;
        }
        return self.ptr_offset_bytes(record_base_addr,
                                     vyx_rt_const_int(self.mod, self.ty_i64, offset_bits / 8, 0),
                                     field_name);
    }

    public fn function_is_foreign_dci_free_function(self, function_id: i32) -> bool {
        return mir_unit_function_is_foreign_dci_free_function(&self.m, function_id);
    }

    public fn function_source_param_count(self, function_id: i32) -> i32 {
        var out: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) { out = out + 1; }
            local = self.m.local_next(local);
        }
        return out;
    }

    public fn function_llvm_param_count(self, function_id: i32) -> i32 {
        var out: i32 = 0;
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            out = out + self.dci_source_param_llvm_slots(function_id, source_index);
            source_index = source_index + 1;
        }
        if (self.function_uses_hidden_sret(function_id)) { out = out + 1; }
        if (self.function_is_foreign_dci_ctor(function_id)) { out = out + 1; }
        out = out + self.function_hidden_env_param_count(function_id);
        if (self.function_uses_c_main_abi(function_id)) { out = out + 2; }
        if (self.dci_function_inalloca_count(function_id) > 1) { out = out + 1; }
        return out;
    }

    public fn function_source_param_type(self, function_id: i32, idx: i32) -> i32 {
        var seen: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) {
                if (seen == idx) { return self.local_effective_type(local); }
                seen = seen + 1;
            }
            local = self.m.local_next(local);
        }
        return mir_id_invalid();
    }

    public fn function_source_param_local(self, function_id: i32, idx: i32) -> i32 {
        var seen: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_source_param(local)) {
                if (seen == idx) { return local; }
                seen = seen + 1;
            }
            local = self.m.local_next(local);
        }
        return mir_id_invalid();
    }

    // Interface-owner type names indexed by last path segment. The predicate
    // formerly rescanned every function in the unit (with a per-function string
    // compare) on each query; during lowering it is asked for nearly every type,
    // so that walk was an O(types * functions) hot spot (top of the mir_codegen
    // profile). policy_type_name_equal reduces to comparing policy_last_segment,
    // so collect the interface owner segments once into a hashed set and answer
    // in O(1). Rebuild if the function table grew (defensive; functions are
    // frozen by the lowering stage in practice).
    public fn ensure_interface_owner_name_index(self) {
        if (self.interface_owner_name_index_ready
            && self.interface_owner_name_index_functions == self.m.function_count) {
            return;
        }
        if (self.interface_owner_name_index != null) {
            llvm_mir_dispose_symbol_index(self.interface_owner_name_index, self.interface_owner_name_index_cap, false);
            self.interface_owner_name_index = null;
        }
        if (self.interface_trait_type_cache != null) {
            llvm_mir_id_map_dispose(self.interface_trait_type_cache);
            self.interface_trait_type_cache = llvm_mir_alloc_i32_map(self.m.types.count + 16);
        }
        self.interface_owner_name_index_ready = true;
        self.interface_owner_name_index_functions = self.m.function_count;
        var cap = self.m.function_count * 2 + 16;
        if (cap < 4096) { cap = 4096; }
        let buf = llvm_mir_symbol_index_new(cap);
        if (buf == null) { return; }
        self.interface_owner_name_index = buf;
        self.interface_owner_name_index_cap = cap;
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (mir_unit_function_owner_item_kind(&self.m, fn_id) == hir_item_interface()) {
                let owner = self.m.function_owner_type(fn_id);
                let seg = self.last_path_segment(owner);
                if (seg.len > 0) {
                    llvm_mir_symbol_index_put_first(buf, cap, seg, 1);
                }
            }
            fn_id = fn_id + 1;
        }
    }

    public fn compute_type_is_interface_trait_type(self, type_id: i32) -> bool {
        if (self.type_is_dyn_trait(type_id)) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0) { return false; }
        let seg = self.last_path_segment(text);
        if (seg.len == 0) { return false; }
        self.ensure_interface_owner_name_index();
        if (self.interface_owner_name_index == null) { return false; }
        return llvm_mir_symbol_index_get(self.interface_owner_name_index,
                                         self.interface_owner_name_index_cap,
                                         seg) != mir_id_invalid();
    }

    public fn type_is_interface_trait_type(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        self.ensure_interface_owner_name_index();
        let cached = llvm_mir_i32_map_get(self.interface_trait_type_cache, type_id);
        if (cached != 0) { return cached == 2; }
        let result = self.compute_type_is_interface_trait_type(type_id);
        var state: i32 = 1;
        if (result) { state = 2; }
        llvm_mir_i32_map_put(self.interface_trait_type_cache, type_id, state);
        return result;
    }

    public fn type_is_concrete_runtime_type(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, type_id) == ty_VOID()
            || llvm_mir_type_text(&self.m, type_id).len == 0) {
            return false;
        }
        if (self.type_is_interface_trait_type(type_id)) { return false; }
        if (self.type_id_has_open_template_for_function(self.current_function_id, type_id)) { return false; }
        return true;
    }

    public fn direct_call_callee(self, value_id: i32) -> i32 {
        if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
        let callee = self.m.value_lhs(value_id);
        if (callee != mir_id_invalid() && self.m.value_target_kind(callee) == mir_target_function()) {
            return callee;
        }
        return mir_id_invalid();
    }

    public fn direct_call_target_function(self, value_id: i32) -> i32 {
        if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.value_target_kind(value_id) == mir_target_function()) {
            return self.m.value_target_id(value_id);
        }
        let callee = self.direct_call_callee(value_id);
        if (callee != mir_id_invalid()) { return self.m.value_target_id(callee); }
        return mir_id_invalid();
    }

    public fn raw_call_target_return_type(self, value_id: i32) -> i32 {
        let target_fn = self.direct_call_target_function(value_id);
        if (target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        let ret_type = self.m.function_return_type(target_fn);
        if (self.type_is_concrete_runtime_type(ret_type)) { return ret_type; }
        return mir_id_invalid();
    }

    public fn local_assignment_concrete_type(self, local_id: i32) -> i32 {
        if (local_id == mir_id_invalid()) { return mir_id_invalid(); }
        let function_id = self.m.local_function(local_id);
        var block = self.m.function_first_block(function_id);
        while (block != mir_id_invalid()) {
            var instr = self.m.block_first_instr(block);
            while (instr != mir_id_invalid()) {
                if (self.m.instr_kind(instr) == mir_instr_assign()) {
                    let place_id = self.m.instr_place(instr);
                    if (place_id != mir_id_invalid()
                        && self.m.place_kind(place_id) == mir_place_local()
                        && self.m.place_local(place_id) == local_id) {
                        let value_id = self.m.instr_value(instr);
                        let direct_ret = self.raw_call_target_return_type(value_id);
                        if (direct_ret != mir_id_invalid()) { return direct_ret; }
                        let value_type = self.m.value_type(value_id);
                        if (self.type_is_concrete_runtime_type(value_type)) { return value_type; }
                    }
                }
                instr = self.m.instr_next(instr);
            }
            block = self.m.block_next(block);
        }
        return mir_id_invalid();
    }

    public fn local_effective_type(self, local_id: i32) -> i32 {
        if (local_id == mir_id_invalid()) { return mir_id_invalid(); }
        let raw_type = self.m.local_type(local_id);
        if (raw_type == mir_id_invalid()
            || llvm_mir_type_kind(&self.m, raw_type) == ty_VOID()
            || llvm_mir_type_text(&self.m, raw_type).len == 0) {
            let concrete_invalid = self.local_assignment_concrete_type(local_id);
            if (concrete_invalid != mir_id_invalid()) { return concrete_invalid; }
            return raw_type;
        }
        if (!self.type_is_interface_trait_type(raw_type)) { return raw_type; }
        let concrete = self.local_assignment_concrete_type(local_id);
        if (concrete != mir_id_invalid()) { return concrete; }
        return raw_type;
    }

    public fn place_effective_type(self, place_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.place_kind(place_id) == mir_place_local()) {
            return self.local_effective_type(self.m.place_local(place_id));
        }
        if (self.m.place_kind(place_id) == mir_place_field()) {
            // Multi-level field chains (a.b.c) record template field types in
            // MIR; refine through the remapped FieldId so nested bases report
            // the concrete instance layout type.
            let mapped = self.mapped_field_id_for_place(place_id);
            if (mapped != mir_id_invalid()) {
                let mapped_type = mir_unit_field_type(&self.m, mapped);
                if (mapped_type != mir_id_invalid()) { return mapped_type; }
            }
        }
        return self.m.place_type(place_id);
    }

    public fn place_skips_pointer_region_audit(self, place_id: i32) -> bool {
        if (self.m.place_check_policy(place_id) == mir_check_policy_unchecked()) {
            return true;
        }
        return self.type_is_foreign_dci(self.place_effective_type(place_id));
    }

    public fn call_arg_effective_type(self, value_id: i32, arg_index: i32) -> i32 {
        let arg = self.call_arg_at(value_id, arg_index);
        if (arg == mir_id_invalid()) { return mir_id_invalid(); }
        return self.value_effective_type(arg);
    }

    public fn concrete_function_matches_call_args(self, value_id: i32, candidate_fn: i32, receiver_type: i32) -> bool {
        if (candidate_fn == mir_id_invalid()) { return false; }
        if (self.m.function_first_block(candidate_fn) == mir_id_invalid()) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, candidate_fn) == hir_item_interface()) { return false; }
        let receiver_id = self.direct_call_receiver(value_id);
        var receiver_argc: i32 = 0;
        if (receiver_id != mir_id_invalid()) { receiver_argc = 1; }
        let source_count = self.function_source_param_count(candidate_fn);
        if (source_count != self.call_arg_count(value_id) + receiver_argc) { return false; }
        if (receiver_argc > 0) {
            if (!self.type_is_concrete_runtime_type(receiver_type)) { return false; }
            if (!self.type_ids_compatible(self.function_source_param_type(candidate_fn, 0), receiver_type)) { return false; }
        }
        var idx: i32 = 0;
        while (idx < self.call_arg_count(value_id)) {
            let arg_type = self.call_arg_effective_type(value_id, idx);
            let param_type = self.function_source_param_type(candidate_fn, idx + receiver_argc);
            if (arg_type == mir_id_invalid() || param_type == mir_id_invalid()) { return false; }
            if (!self.type_ids_compatible(param_type, arg_type)) { return false; }
            idx = idx + 1;
        }
        return true;
    }

    public fn concrete_interface_call_target(self, value_id: i32, prototype_fn: i32) -> i32 {
        if (prototype_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (mir_unit_function_owner_item_kind(&self.m, prototype_fn) != hir_item_interface()) { return mir_id_invalid(); }
        let method_name = self.function_method_name(prototype_fn);
        if (method_name.len == 0) { return mir_id_invalid(); }
        let receiver_id = self.direct_call_receiver(value_id);
        var receiver_type = mir_id_invalid();
        if (receiver_id != mir_id_invalid()) {
            receiver_type = self.value_effective_type(receiver_id);
            if (self.type_is_concrete_runtime_type(receiver_type)) {
                let direct = self.executable_method_for_receiver_type(receiver_type, method_name);
                if (direct != mir_id_invalid()
                    && self.concrete_function_matches_call_args(value_id, direct, receiver_type)) {
                    return direct;
                }
            }
        }
        var fn_id: i32 = 1;
        while (fn_id <= self.m.function_count) {
            if (self.function_name_matches_method(self.m.function_name(fn_id), method_name)
                && self.concrete_function_matches_call_args(value_id, fn_id, receiver_type)) {
                return fn_id;
            }
            fn_id = fn_id + 1;
        }
        return mir_id_invalid();
    }

    public fn concrete_static_interface_call_target(self,
                                                    value_id: i32,
                                                    prototype_fn: i32,
                                                    call_name: string) -> i32 {
        if (value_id == mir_id_invalid() || prototype_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (mir_unit_function_owner_item_kind(&self.m, prototype_fn) != hir_item_interface()) { return mir_id_invalid(); }
        if (self.direct_call_receiver(value_id) != mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_source_param_count(prototype_fn) != self.call_arg_count(value_id)) {
            return mir_id_invalid();
        }
        var method_name = self.function_method_name(prototype_fn);
        if (method_name.len == 0) { method_name = policy_generic_call_base(call_name.clone()); }
        if (method_name.len == 0) { return mir_id_invalid(); }
        let owner_type = self.value_effective_type(value_id);
        if (!self.type_is_concrete_runtime_type(owner_type)) { return mir_id_invalid(); }
        let direct = self.executable_method_for_receiver_type(owner_type, method_name);
        if (direct == mir_id_invalid()) { return mir_id_invalid(); }
        if (!self.concrete_function_matches_call_args(value_id, direct, mir_id_invalid())) {
            return mir_id_invalid();
        }
        return direct;
    }

    public fn concrete_bodyless_static_call_target(self,
                                                   value_id: i32,
                                                   target_fn: i32,
                                                   call_name: string) -> i32 {
        if (value_id == mir_id_invalid() || target_fn == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.function_first_block(target_fn) != mir_id_invalid()) { return mir_id_invalid(); }
        if (self.function_can_be_declared(target_fn)) { return mir_id_invalid(); }
        let item_kind = mir_unit_function_item_kind(&self.m, target_fn);
        let owner_kind = mir_unit_function_owner_item_kind(&self.m, target_fn);
        if (item_kind != hir_item_method() && owner_kind != hir_item_interface()) {
            return mir_id_invalid();
        }
        if (self.direct_call_receiver(value_id) != mir_id_invalid()) { return mir_id_invalid(); }
        var method_name = self.function_method_name(target_fn);
        if (method_name.len == 0) { method_name = policy_generic_call_base(call_name.clone()); }
        if (method_name.len == 0) { return mir_id_invalid(); }
        let owner_type = self.value_effective_type(value_id);
        if (!self.type_is_concrete_runtime_type(owner_type)) { return mir_id_invalid(); }
        let direct = self.executable_method_for_receiver_type(owner_type, method_name);
        if (direct == mir_id_invalid() || direct == target_fn) { return mir_id_invalid(); }
        if (!self.concrete_function_matches_call_args(value_id, direct, mir_id_invalid())) {
            return mir_id_invalid();
        }
        return direct;
    }

    public fn value_effective_type(self, value_id: i32) -> i32 {
        if (value_id == mir_id_invalid()) { return mir_id_invalid(); }
        let raw_type = self.m.value_type(value_id);
        let kind = self.m.value_kind(value_id);
        // Streaming MIR may retain a nominal import placeholder on a value
        // (`kind=void`, non-empty qualified text) after its local or selected
        // call has already been refined to a concrete runtime type.  Storage
        // allocation uses that refinement; reads must use the same type or
        // LLVM receives an invalid `load void` for an otherwise valid value.
        if (raw_type == mir_id_invalid()
            || llvm_mir_type_kind(&self.m, raw_type) == ty_VOID()
            || llvm_mir_type_text(&self.m, raw_type).len == 0) {
            if (kind == mir_value_read_place()) {
                let place_type = self.place_effective_type(self.m.value_place(value_id));
                if (self.type_is_concrete_runtime_type(place_type)) { return place_type; }
            }
            if (kind == mir_value_call()) {
                let direct_ret = self.raw_call_target_return_type(value_id);
                if (self.type_is_concrete_runtime_type(direct_ret)) { return direct_ret; }
            }
            if (kind == mir_value_arg() || kind == mir_value_cast()) {
                let inner_type = self.value_effective_type(self.m.value_lhs(value_id));
                if (self.type_is_concrete_runtime_type(inner_type)) { return inner_type; }
            }
            return raw_type;
        }
        if (kind == mir_value_arg()) {
            let payload_type = self.value_effective_type(self.m.value_lhs(value_id));
            if (self.type_is_concrete_runtime_type(payload_type)) { return payload_type; }
            return raw_type;
        }
        if (self.type_is_dyn_trait(raw_type)) {
            return raw_type;
        }
        if (!self.type_is_interface_trait_type(raw_type)) { return raw_type; }
        if (kind == mir_value_read_place()) {
            let place_type = self.place_effective_type(self.m.value_place(value_id));
            if (place_type != mir_id_invalid()) { return place_type; }
        }
        if (kind == mir_value_cast()) {
            let inner_type = self.value_effective_type(self.m.value_lhs(value_id));
            if (self.type_is_concrete_runtime_type(inner_type)) { return inner_type; }
        }
        if (kind == mir_value_call()) {
            let target_fn = self.direct_call_target_function(value_id);
            let concrete_target = self.concrete_interface_call_target(value_id, target_fn);
            if (concrete_target != mir_id_invalid()) {
                let concrete_ret = self.m.function_return_type(concrete_target);
                if (self.type_is_concrete_runtime_type(concrete_ret)) { return concrete_ret; }
            }
            let raw_ret = self.raw_call_target_return_type(value_id);
            if (raw_ret != mir_id_invalid()) { return raw_ret; }
        }
        return raw_type;
    }

    public fn function_name_matches_method_direct(self, function_name: string, method_name: string) -> bool {
        if (function_name == method_name) { return true; }
        if (method_name.len == 0) { return false; }
        let mangled = policy_mangle_part(method_name);
        if (function_name == mangled) { return true; }
        let marker = "_3A_3A";
        var start = llvm_mir_string_find(function_name, marker, 0);
        while (start >= 0) {
            let method_start = start + (marker.len as i32);
            var method_end = llvm_mir_string_find(function_name, marker, method_start);
            if (method_end < 0) { method_end = function_name.len as i32; }
            let segment = function_name.substring(method_start, method_end);
            if (segment == method_name || segment == mangled || llvm_mir_demangle_part(segment) == method_name) {
                return true;
            }
            start = llvm_mir_string_find(function_name, marker, method_start);
        }
        return false;
    }

    public fn function_name_matches_method(self, function_name: string, method_name: string) -> bool {
        if (self.function_name_matches_method_direct(function_name, method_name)) { return true; }
        let legacy = policy_operator_legacy_method_name(method_name);
        if (legacy.len > 0 && self.function_name_matches_method_direct(function_name, legacy)) { return true; }
        let symbol = policy_operator_symbol_method_name(method_name);
        if (symbol.len > 0 && self.function_name_matches_method_direct(function_name, symbol)) { return true; }
        return false;
    }

    public fn function_method_name(self, function_id: i32) -> string {
        let name = self.m.function_name(function_id);
        let marker = "_3A_3A";
        var start = llvm_mir_string_find(name, marker, 0);
        if (start < 0) { return llvm_mir_demangle_part(policy_generic_call_base(name.clone())); }
        start = start + (marker.len as i32);
        while (start <= name.len) {
            var method_end = llvm_mir_string_find(name, marker, start);
            if (method_end < 0) { method_end = name.len as i32; }
            if (method_end > start) {
                let segment = name.substring(start, method_end);
                var generic_args = false;
                // A generic-argument segment survives mangling with its `<`
                // escape attached (`Pair2::<f64,i32>::get_first` splits into
                // `_3Cf64_2Ci32_3E` / `get_5Ffirst`), so the marker-stripped
                // segment starts with `_3C`.  The former bare `3C` test could
                // never fire, which made the skip dead code and let the method
                // name resolve to the *argument list* for any owner that is
                // itself an instantiation.
                if (segment.len >= 3 && segment.substring(0, 3) == "_3C") {
                    generic_args = true;
                } elif (segment.len >= 2 && segment.substring(0, 2) == "3C") {
                    generic_args = true;
                }
                if (!generic_args) {
                    return llvm_mir_demangle_part(segment);
                }
            }
            if (method_end >= name.len) { break; }
            start = method_end + (marker.len as i32);
        }
        return llvm_mir_demangle_part(policy_generic_call_base(name.clone()));
    }

    public fn remember_method_candidate_name(self, method_name: string, function_id: i32) {
        if (method_name.len == 0 || function_id == mir_id_invalid()) { return; }
        llvm_mir_method_candidate_index_put(self.method_candidate_index,
                                            self.method_candidate_index_cap,
                                            method_name,
                                            function_id);
    }

    public fn remember_function_method_candidate(self, function_id: i32) {
        if (function_id == mir_id_invalid()) { return; }
        let method_name = self.function_method_name(function_id);
        self.remember_method_candidate_name(method_name, function_id);
        let legacy = policy_operator_legacy_method_name(method_name);
        if (legacy.len > 0 && legacy != method_name) {
            self.remember_method_candidate_name(legacy, function_id);
        }
        let symbol = policy_operator_symbol_method_name(method_name);
        if (symbol.len > 0 && symbol != method_name && symbol != legacy) {
            self.remember_method_candidate_name(symbol, function_id);
        }
    }

    public fn ensure_method_candidate_index(self) {
        if (self.method_candidate_index_ready) { return; }
        var fn_id: i32 = self.m.function_count;
        while (fn_id >= 1) {
            if (self.function_has_callable_body_or_import(fn_id)) {
                self.remember_function_method_candidate(fn_id);
            }
            fn_id = fn_id - 1;
        }
        self.method_candidate_index_ready = true;
    }

    public fn method_candidate_head(self, method_name: string) -> rawptr {
        if (method_name.len == 0) { return null; }
        self.ensure_method_candidate_index();
        let direct = llvm_mir_method_candidate_index_lookup(self.method_candidate_index,
                                                           self.method_candidate_index_cap,
                                                           method_name);
        if (direct != null) { return direct; }
        let legacy = policy_operator_legacy_method_name(method_name);
        if (legacy.len > 0) {
            let legacy_head = llvm_mir_method_candidate_index_lookup(self.method_candidate_index,
                                                                     self.method_candidate_index_cap,
                                                                     legacy);
            if (legacy_head != null) { return legacy_head; }
        }
        let symbol = policy_operator_symbol_method_name(method_name);
        if (symbol.len > 0) {
            return llvm_mir_method_candidate_index_lookup(self.method_candidate_index,
                                                          self.method_candidate_index_cap,
                                                          symbol);
        }
        return null;
    }

    public fn pair_bool_cache_get(self, table: rawptr, lhs: i32, rhs: i32) -> i32 {
        if (table == null || lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return 0; }
        let head = llvm_mir_map_get(table, lhs);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == rhs) { return ast_read_i32(ptr_offset(cur, 4)); }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return 0;
    }

    public fn pair_bool_cache_put(self, table: rawptr, lhs: i32, rhs: i32, state: i32) {
        if (table == null || lhs == mir_id_invalid() || rhs == mir_id_invalid() || state == 0) { return; }
        let head = llvm_mir_map_get(table, lhs);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == rhs) {
                ast_write_i32(ptr_offset(cur, 4), state);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let node = malloc(16);
        if (node == null) { return; }
        ast_write_i32(node, rhs);
        ast_write_i32(ptr_offset(node, 4), state);
        ast_write_rawptr(ptr_offset(node, 8), head);
        llvm_mir_map_put(table, lhs, node);
    }

    public fn type_ids_compatible(self, lhs: i32, rhs: i32) -> bool {
        if (lhs == rhs) { return true; }
        if (lhs == mir_id_invalid() || rhs == mir_id_invalid()) { return false; }
        let cached = self.pair_bool_cache_get(self.type_compat_cache, lhs, rhs);
        if (cached != 0) { return cached == 2; }
        let lhs_text = llvm_mir_type_text(&self.m, lhs);
        let rhs_text = llvm_mir_type_text(&self.m, rhs);
        var result = lhs_text == rhs_text;
        if (!result && self.dci_type_derives_from(rhs, lhs)) { result = true; }
        if (!result && self.type_text_equivalent(lhs_text, rhs_text)) { result = true; }
        var state: i32 = 1;
        if (result) { state = 2; }
        self.pair_bool_cache_put(self.type_compat_cache, lhs, rhs, state);
        return result;
    }

    public fn type_is_foreign_dci(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid() || type_id <= 0 || type_id > self.m.types.count) { return false; }
        if (!self.unit_has_dci_layout_inputs() && !self.unit_has_foreign_dci_types()) {
            return false;
        }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type != mir_id_invalid()
            && canonical_type > 0
            && canonical_type <= self.m.types.count
            && mir_unit_type_is_foreign_dci(&self.m, canonical_type)) {
            return true;
        }
        return mir_unit_type_is_foreign_dci(&self.m, type_id);
    }

    public fn unit_has_dci_layout_inputs(self) -> bool {
        if (mir_unit_has_dci_abi(&self.m)) { return true; }
        if (mir_unit_dci_stub_specs(&self.m).len > 0) { return true; }
        return mir_unit_foreign_cpp_includes(&self.m).len > 0;
    }

    public fn unit_has_foreign_dci_types(self) -> bool {
        if (self.foreign_dci_type_presence_cache != 0) {
            return self.foreign_dci_type_presence_cache == 2;
        }
        var type_id: i32 = 1;
        while (type_id <= self.m.types.count) {
            if (mir_unit_type_is_foreign_dci(&self.m, type_id)) {
                self.foreign_dci_type_presence_cache = 2;
                return true;
            }
            type_id = type_id + 1;
        }
        self.foreign_dci_type_presence_cache = 1;
        return false;
    }

    public fn type_id_without_ref(self, type_id: i32) -> i32 {
        if (type_id == mir_id_invalid()) { return type_id; }
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_REF() || kind == ty_MUTREF() || kind == ty_PTR()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            if (elem != mir_id_invalid()) { return elem; }
        }
        return type_id;
    }

    public fn foreign_dci_abi_type_id(self, type_id: i32) -> i32 {
        return self.type_id_without_ref(type_id);
    }

    public fn dci_normalized_type_for_type(self, type_id: i32) -> string {
        if (type_id == mir_id_invalid()) { return ""; }
        let kind0 = llvm_mir_type_kind(&self.m, type_id);
        if (kind0 == ty_REF() || kind0 == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.m.types, type_id);
            return "&" + self.dci_normalized_type_for_type(elem);
        }
        if (kind0 == ty_PTR()) {
            let elem2 = hir_type_table_elem(self.m.types, type_id);
            if (elem2 == mir_id_invalid()) { return "*void"; }
            return "*" + self.dci_normalized_type_for_type(elem2);
        }
        let type_id2 = self.foreign_dci_abi_type_id(type_id);
        let kind = llvm_mir_type_kind(&self.m, type_id2);
        if (kind == ty_VOID()) { return "void"; }
        if (kind == ty_BOOL()) { return "bool"; }
        if (kind == ty_CHAR()) { return "char"; }
        if (kind == ty_I8()) { return "i8"; }
        if (kind == ty_U8()) { return "u8"; }
        if (kind == ty_I16()) { return "i16"; }
        if (kind == ty_U16()) { return "u16"; }
        if (kind == ty_I32()) { return "i32"; }
        if (kind == ty_U32()) { return "u32"; }
        if (kind == ty_I64() || kind == ty_ISIZE()) { return "i64"; }
        if (kind == ty_U64() || kind == ty_USIZE()) { return "u64"; }
        if (kind == ty_F32()) { return "f32"; }
        if (kind == ty_F64()) { return "f64"; }
        if (kind == ty_RAWPTR()) { return "*void"; }
        if (kind == ty_STRING() || self.type_is_str_abi(type_id2)) { return "*void"; }
        if (kind == ty_CLASS()) {
            return llvm_mir_type_text(&self.m, type_id2).replace("::", ".");
        }
        return llvm_mir_type_text(&self.m, type_id2).replace("::", ".");
    }

    public fn dci_canonical_type_name_text(self, raw: string) -> string {
        // Vyx spells a concrete generic instantiation with turbofish
        // (`fmt.basic_string_view::<char>`); after `::`->`.` that leaves a stray
        // `.` before `<`. A DCI contract spells the same C++ template
        // specialization as `fmt::basic_string_view<char>`. Normalising `.<`->`<`
        // makes both forms canonicalise identically so a Vyx instantiation matches
        // the contract record/field/parameter type.
        if (llvm_mir_dci_type_name_is_plain(raw)) { return raw; }
        return raw.trim()
            .replace("::", ".")
            .replace("class ", "")
            .replace("struct ", "")
            .replace("enum ", "")
            .replace(" <", "<")
            .replace("< ", "<")
            .replace(" >", ">")
            .replace("> ", ">")
            .replace(" ,", ",")
            .replace(", ", ",")
            .replace(" &", "&")
            .replace("& ", "&")
            .replace(" *", "*")
            .replace("* ", "*")
            .replace(".<", "<");
    }

    public fn dci_plain_type_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        if (lhs_raw.len == 0 || rhs_raw.len == 0) { return false; }
        if (llvm_mir_dci_type_name_is_plain(lhs_raw) && llvm_mir_dci_type_name_is_plain(rhs_raw)) {
            return lhs_raw == rhs_raw;
        }
        let lhs = self.dci_canonical_type_name_text(lhs_raw);
        let rhs = self.dci_canonical_type_name_text(rhs_raw);
        return lhs.len > 0 && rhs.len > 0 && lhs == rhs;
    }

    fn dci_resolve_alias_name(self, raw: string) -> string {
        var cur = self.dci_canonical_type_name_text(raw);
        if (cur.len == 0) { return ""; }
        self.dci_ensure_indexes();
        var hops: i32 = 0;
        while (hops < 16) {
            let alias = llvm_mir_dci_obj_index_first(self.dci_alias_index, self.dci_alias_index_cap, cur);
            if (alias == null) { break; }
            let target = self.dci_json_string(alias, "target");
            let next = self.dci_canonical_type_name_text(target);
            if (next.len == 0 || next == cur) { break; }
            cur = next;
            hops = hops + 1;
        }
        if (hops > 0) { return cur; }
        // A consumer-declared `@[repr(C)]` record reaches the producer's name
        // through agreement about its bytes, not through spelling.  Only a
        // name that no alias claimed is eligible: once the contract's own
        // alias table has spoken, its answer is authoritative.  (The bind used
        // to sit *after* this loop, which an early `return` on the first
        // alias-lookup miss silently bypassed -- a name with no aliases at
        // all, which is exactly what a consumer-spelled record is, never
        // reached it.)
        let bound = self.dci_consumer_record_bound_name(cur.clone());
        if (bound.len > 0) { return bound; }
        return cur;
    }

    /// The last dotted segment of a contract type name, or "" when the tail is
    /// not a plain identifier (`<`, `>`, `,` mean the name is a generic
    /// instance, whose tail belongs to an argument rather than to the record).
    fn dci_contract_layout_tail_name(self, type_name: string) -> string {
        if (type_name.len == 0) { return ""; }
        var i: i32 = type_name.len - 1;
        while (i >= 0) {
            let ch = type_name.charAt(i);
            if (ch == 46) { return type_name.substring(i + 1, type_name.len); }
            if (ch == 60 || ch == 62 || ch == 44) { return ""; }
            i = i - 1;
        }
        return type_name;
    }

    /// Bind a consumer-declared record to the producer record it describes.
    ///
    /// An instance closed over a record only the *consumer* declares
    /// (`class VyxHostTG<T> : native.SinkG<T>` with `T = VyxBox`) names the
    /// record the way Vyx spells it -- bare, because nothing imported it.  The
    /// producer's contract spells the same type with its crate prefix
    /// (`native.VyxBox`), because that is where the producer declared it.  The
    /// two never compare equal, so every name-keyed lookup fails: no symbol,
    /// and therefore no dispatch-table slot for `consume`.
    ///
    /// Matching the last segment alone would be a guess.  What makes the bind
    /// sound is that both sides describe the same bytes independently: Vyx
    /// derives size/alignment from the C rule (`@[repr(C)]` is what makes the
    /// record's layout *be* the C layout, floor included), and the producer
    /// measured them.  The name only resolves when those numbers agree, so a
    /// same-named-but-differently-shaped producer record keeps the loud
    /// "no layout" diagnostic instead of quietly acquiring an identity it
    /// cannot justify.  Everything else (unmeasured records, non-repr(C)
    /// classes, instances, pointers) falls through unchanged.
    fn dci_consumer_record_bound_name(self, raw: string) -> string {
        if (raw.len == 0) { return ""; }
        if (raw.contains(".") || raw.contains("<") || raw.contains(">")
            || raw.contains("*") || raw.contains("&") || raw.contains(",")) { return ""; }
        if (self.dci_json() == null) { return ""; }
        // Re-entrancy guard: the checks below ask whether the record already
        // has a descriptor entry, and that question resolves names -- which is
        // this function.  Answering it from inside ourselves would recurse
        // forever, so the inner call sees "not bound".
        if (self.dci_consumer_bind_depth > 0) { return ""; }
        self.dci_ensure_indexes();
        if (llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap,
                                         raw.clone()) != null) {
            return "";
        }
        // Candidate first, believed second: the layout array is small and the
        // type scan is not, so nothing walks the type table unless some
        // producer record already claims to be this bare name.
        var candidate: string = "";
        var cand_size: i64 = 0;
        var cand_align: i64 = 0;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n && candidate.len == 0) {
            let layouts = self.dci_exports_array_from(self.dci_contract_at(root_i), "layouts");
            var layout = dci_cjson_child(layouts);
            while (layout != null && candidate.len == 0) {
                let type_name = self.dci_json_string(layout, "type_name");
                if (self.dci_contract_layout_tail_name(type_name.clone()) == raw) {
                    cand_size = self.dci_json_i64(layout, "size");
                    cand_align = self.dci_json_i64(layout, "alignment");
                    if (cand_size > 0 && cand_align > 0) { candidate = type_name; }
                }
                layout = dci_cjson_next(layout);
            }
            root_i = root_i + 1;
        }
        if (candidate.len == 0) { return ""; }
        self.dci_consumer_bind_depth = self.dci_consumer_bind_depth + 1;
        var bound: string = "";
        let type_id = mir_unit_find_type_by_text(&self.m, raw.clone());
        if (type_id != mir_id_invalid() && self.dci_local_record_is_consumer_declared(type_id)) {
            if (self.dci_local_record_size(type_id) == cand_size
                && self.dci_local_record_align(type_id) == cand_align) {
                bound = candidate;
            }
        }
        self.dci_consumer_bind_depth = self.dci_consumer_bind_depth - 1;
        return bound;
    }

    public fn dci_type_alias_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        if (lhs_raw.len == 0 || rhs_raw.len == 0) { return false; }
        if (self.dci_json() == null) { return false; }
        self.dci_ensure_indexes();
        let lhs = self.dci_resolve_alias_name(lhs_raw);
        let rhs = self.dci_resolve_alias_name(rhs_raw);
        if (lhs.len > 0 && rhs.len > 0 && lhs == rhs) { return true; }
        let lhs_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap, lhs);
        let rhs_layout = llvm_mir_dci_obj_index_first(self.dci_layout_index, self.dci_layout_index_cap, rhs);
        return lhs_layout != null && lhs_layout == rhs_layout;
    }

    public fn dci_normalized_type_names_match(self, lhs_raw: string, rhs_raw: string) -> bool {
        let lhs = lhs_raw.trim();
        let rhs = rhs_raw.trim();
        if (self.dci_plain_type_names_match(lhs, rhs)) { return true; }
        if (lhs.len == 0 || rhs.len == 0) { return false; }
        if (lhs.startsWith("*") && rhs.startsWith("*")) {
            return self.dci_normalized_type_names_match(lhs.substring(1, lhs.len),
                                                        rhs.substring(1, rhs.len));
        }
        if (lhs.startsWith("&") && rhs.startsWith("&")) {
            return self.dci_normalized_type_names_match(lhs.substring(1, lhs.len),
                                                        rhs.substring(1, rhs.len));
        }
        return self.dci_type_alias_names_match(lhs, rhs);
    }

    public fn dci_symbol_kind_for_function(self, function_id: i32) -> string {
        if (self.function_is_foreign_dci_ctor(function_id)) { return "constructor"; }
        if (self.function_is_foreign_dci_dtor(function_id)) { return "destructor"; }
        if (self.function_is_foreign_dci_free_function(function_id)) { return "function"; }
        return "method";
    }

    public fn dci_symbol_name_for_function(self, function_id: i32) -> string {
        if (self.function_is_foreign_dci_ctor(function_id)) { return "constructor"; }
        if (self.function_is_foreign_dci_dtor(function_id)) { return "destructor"; }
        if (!self.function_is_foreign_dci_free_function(function_id)) {
            let method = self.function_method_name(function_id);
            if (method.len > 0) { return method; }
        }
        return policy_generic_call_base(self.m.function_name(function_id).clone());
    }

    public fn dci_lifecycle_owner_terminal_name(self, owner_raw: string) -> string {
        let owner = self.dci_canonical_type_name_text(owner_raw);
        if (owner.len == 0) { return ""; }
        var start: i32 = 0;
        var depth: i32 = 0;
        var i: i32 = 0;
        while (i < owner.len) {
            let ch = owner.charAt(i);
            if (ch == 60) {
                depth = depth + 1;
            } else if (ch == 62 && depth > 0) {
                depth = depth - 1;
            } else if (ch == 46 && depth == 0) {
                start = i + 1;
            }
            i = i + 1;
        }
        var end: i32 = owner.len as i32;
        i = start;
        depth = 0;
        while (i < owner.len) {
            let ch2 = owner.charAt(i);
            if (ch2 == 60 && depth == 0) {
                end = i;
                break;
            }
            if (ch2 == 60) {
                depth = depth + 1;
            } else if (ch2 == 62 && depth > 0) {
                depth = depth - 1;
            }
            i = i + 1;
        }
        if (end <= start) { return ""; }
        return owner.substring(start, end);
    }

    public fn dci_symbol_member_name_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        let kind = self.dci_symbol_kind_for_function(function_id);
        let member_name = self.dci_json_string(sym, "member_name");
        if (kind == "constructor") {
            return member_name == "constructor";
        }
        if (kind == "destructor") {
            if (member_name == "destructor") { return true; }
            let terminal = self.dci_lifecycle_owner_terminal_name(
                self.dci_json_string(sym, "owner"));
            return terminal.len > 0 && member_name == "~" + terminal;
        }
        var symbol_name = member_name;
        if (symbol_name.len == 0) { symbol_name = self.dci_json_string(sym, "name"); }
        return symbol_name == self.dci_symbol_name_for_function(function_id);
    }

    public fn dci_symbol_receiver_param_count(self, function_id: i32) -> i32 {
        if (self.function_is_foreign_dci_instance_method(function_id)
            && !self.function_is_foreign_dci_ctor(function_id)) {
            return 1;
        }
        // A Vyx method overriding a foreign DCI instance method keeps the
        // receiver shape: source parameter 0 is `self`; ABI parameters start
        // at index 1, exactly as for a foreign declaration.
        if (self.function_is_dci_vyx_override_callback(function_id)
            && self.source_param_uses_self_pointer_abi(function_id, 0)) {
            return 1;
        }
        return 0;
    }

    public fn dci_type_object_name(self, type_obj: rawptr) -> string {
        return dci_abi_type_object_name(type_obj);
    }

    public fn dci_stub_state_field_addr(self, base_addr: rawptr, base_type_id: i32, field_id: i32) -> rawptr {
        let canonical = self.canonical_record_type_id(base_type_id);
        let derived = llvm_mir_type_text(&self.m, canonical);
        let symbol = "__dci_stub_field_" + policy_mangle_part(derived)
            + "_" + policy_mangle_part(mir_unit_field_name(&self.m, field_id));
        let params = malloc(8);
        ast_write_rawptr(params, self.ty_ptr);
        let fty = vyx_rt_fn_type(self.mod, self.ty_ptr, params, 1, 0);
        free(params);
        let fnv = vyx_rt_add_function(self.mod, symbol.c_str(), symbol.len as u64, fty);
        return vyx_rt_build_call1(self.mod, fty, fnv, base_addr, "dci.state".c_str(), 9);
    }

    public fn dci_type_object_matches_type(self, type_obj: rawptr, type_id: i32) -> bool {
        if (type_obj == null || type_id == mir_id_invalid()) { return false; }
        if (!dci_abi_reference_kind_supported(type_obj)) { return false; }
        if (self.dci_json_string(type_obj, "kind") == "function") {
            if (llvm_mir_type_kind(&self.m, type_id) != ty_CFN() || !dci_abi_is_cfn_pointer(type_obj)) { return false; }
            let signature = self.dci_json_item(type_obj, "signature");
            let params = self.dci_json_item(signature, "params");
            let count = cJSON_GetArraySize(params);
            if (self.fn_type_param_count(type_id) != count) { return false; }
            var i: i32 = 0;
            while (i < count) {
                if (!self.dci_type_object_matches_type(cJSON_GetArrayItem(params, i),
                    self.fn_type_param_type_at(type_id, i))) { return false; }
                i = i + 1;
            }
            return self.dci_type_object_matches_type(self.dci_json_item(signature, "return"),
                self.fn_type_return_type(type_id));
        }
        let lhs = self.dci_type_object_name(type_obj);
        let rhs = self.dci_normalized_type_for_type(type_id);
        if (self.dci_normalized_type_names_match(lhs, rhs)) { return true; }
        let enum_name = self.dci_json_string(type_obj, "enum_name");
        if (enum_name.len > 0) {
            if (self.dci_normalized_type_names_match(enum_name, rhs)) { return true; }
        }
        return false;
    }

    public fn dci_symbol_owner_matches_function(self, owner_text: string, function_id: i32) -> bool {
        return self.dci_symbol_owner_match_rank(owner_text, function_id) > 0;
    }

    public fn dci_symbol_owner_match_rank(self, owner_text: string, function_id: i32) -> i32 {
        if (self.function_is_foreign_dci_free_function(function_id)) {
            if (owner_text.len == 0) { return 2; }
            return 0;
        }
        let owner_type = self.foreign_dci_owner_type_id(function_id);
        if (owner_type != mir_id_invalid()) {
            if (self.dci_record_name_matches_type(owner_text, owner_type)) { return 2; }
            let symbol_kind = self.dci_symbol_kind_for_function(function_id);
            // Constructors and destructors belong to the complete object.  A
            // base lifecycle symbol is never an inherited overload of a
            // derived lifecycle declaration.
            if (symbol_kind == "constructor" || symbol_kind == "destructor") { return 0; }
            var derived_record = self.dci_record_name_for_type(owner_type);
            if (derived_record.len == 0) {
                derived_record = self.dci_record_name_for_type_text(self.foreign_dci_owner_type_text(function_id));
            }
            if (derived_record.len > 0) {
                if (self.dci_record_name_derives_from_record(derived_record, owner_text, 0)) { return 1; }
            }
            // Stub-spec fallback, same as the owner-text branch below: a Vyx
            // class inheriting a foreign DCI base has no contract layout of
            // its own, so the derives relation is the stub spec row.
            if (self.dci_stub_type_names_match(
                    self.dci_stub_base_for_type_text(self.foreign_dci_owner_type_text(function_id)),
                    owner_text)) { return 1; }
            return 0;
        }
        var owner_raw = self.foreign_dci_owner_type_text(function_id);
        if (owner_raw.len == 0) {
            // A Vyx override is not itself a foreign declaration, so the
            // foreign-owner resolver comes back empty; the MIR owner type is
            // the class whose stub spec names the base this symbol belongs to.
            owner_raw = self.m.function_owner_type(function_id);
        }
        if (self.dci_record_name_matches_text(owner_text, owner_raw)) { return 2; }
        let symbol_kind2 = self.dci_symbol_kind_for_function(function_id);
        if (symbol_kind2 == "constructor" || symbol_kind2 == "destructor") { return 0; }
        let derived_from_text = self.dci_record_name_for_type_text(owner_raw);
        if (derived_from_text.len > 0) {
            if (self.dci_record_name_derives_from_record(derived_from_text, owner_text, 0)) { return 1; }
        }
        // A Vyx override's class has no contract layout, so the record-name
        // resolver above cannot name it -- the derives relation lives in the
        // stub spec row, keyed on the MIR owner text itself.  (Nesting this
        // under the record-name guard would skip it for exactly the classes
        // that need it.)
        if (self.dci_stub_type_names_match(
                self.dci_stub_base_for_type_text(owner_raw), owner_text)) { return 1; }
        return 0;
    }

    public fn dci_symbol_params_match_function(self, params: rawptr, function_id: i32) -> bool {
        let receiver_params = self.dci_symbol_receiver_param_count(function_id);
        let source_count = self.function_source_param_count(function_id);
        let wanted = source_count - receiver_params;
        if (wanted < 0) { return false; }
        if (params == null || cJSON_IsArray(params) == 0) { return wanted == 0; }
        if (cJSON_GetArraySize(params) != wanted) { return false; }
        var idx: i32 = 0;
        while (idx < wanted) {
            let param_obj = cJSON_GetArrayItem(params, idx);
            let type_obj = self.dci_json_item(param_obj, "type");
            let param_type = self.function_source_param_type(function_id, idx + receiver_params);
            if (!self.dci_type_object_matches_type(type_obj, param_type)) { return false; }
            idx = idx + 1;
        }
        return true;
    }

    public fn dci_symbol_flags_match_function(self, sym: rawptr, function_id: i32) -> bool {
        if (self.function_is_foreign_dci_static_method(function_id)) {
            if (!self.dci_json_bool(sym, "is_static")) { return false; }
        }
        if (self.function_is_foreign_dci_instance_method(function_id)
            && !self.function_is_foreign_dci_ctor(function_id)) {
            if (self.dci_json_bool(sym, "is_static")) { return false; }
        }
        if (self.function_is_foreign_dci_const_method(function_id)
            != self.dci_json_bool(sym, "is_const")) {
            return false;
        }
        return true;
    }

    public fn dci_symbol_return_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        if (self.function_is_foreign_dci_ctor(function_id)
            || self.function_is_foreign_dci_dtor(function_id)) {
            return true;
        }
        let ret = self.dci_json_item(sym, "return");
        if (ret == null || cJSON_IsObject(ret) == 0) {
            return llvm_mir_type_kind(&self.m, self.m.function_return_type(function_id)) == ty_VOID();
        }
        let type_obj = self.dci_json_item(ret, "type");
        return self.dci_type_object_matches_type(type_obj, self.m.function_return_type(function_id));
    }

    public fn dci_symbol_calling_convention_supported(self, sym: rawptr) -> bool {
        let cc = self.dci_symbol_calling_convention(sym);
        // Adapter contracts use C++ ABI-family labels; the runtime maps them
        // to LLVM's C calling convention for the supported MSVC profile.
        if (cc == "default" || cc == "system" || cc == "c"
            || cc == "cdecl" || cc == "cxx_free_function"
            || cc == "cxx_static_method" || cc == "cxx_method"
            || cc == "cxx_virtual_method" || cc == "cxx_constructor"
            || cc == "cxx_destructor" || cc == "win64" || cc == "x86_64_sysv"
            || cc == "stdcall" || cc == "fastcall" || cc == "thiscall"
            || cc == "vectorcall" || cc == "rust") {
            return true;
        }
        return false;
    }

    public fn dci_symbol_calling_convention(self, sym: rawptr) -> string {
        if (sym == null) { return ""; }
        let abi = self.dci_json_item(sym, "abi");
        var cc = self.dci_json_string(abi, "calling_convention");
        if (cc.len == 0) { cc = self.dci_json_string(sym, "calling_convention"); }
        return cc;
    }

    public fn dci_symbol_control_flow_boundary(self, sym: rawptr) -> string {
        if (sym != null) {
            let control = self.dci_json_item(sym, "control_flow");
            let symbol_boundary = self.dci_control_flow_boundary(control);
            if (symbol_boundary.len > 0) { return symbol_boundary; }
            let abi = self.dci_json_item(sym, "abi");
            let unwind = self.dci_json_string(abi, "unwind");
            if (unwind.len > 0) { return unwind; }
        }
        let root = self.dci_json();
        return self.dci_control_flow_boundary(self.dci_json_item(root, "control_flow"));
    }

    public fn dci_symbol_unwind_supported(self, sym: rawptr) -> bool {
        if (sym != null
            && !self.dci_control_flow_contract_supported(self.dci_json_item(sym, "control_flow"))) {
            return false;
        }
        if (!self.dci_control_flow_contract_supported(
                self.dci_json_item(self.dci_json(), "control_flow"))) {
            return false;
        }
        let boundary = self.dci_symbol_control_flow_boundary(sym);
        // A realizable translated boundary is accepted above by the contract
        // checks; its machine-level surface is no-unwind (the producer converts
        // to a value before crossing), so it is Direct-callable.
        if (boundary == "translated") { return true; }
        if (boundary == "shared_abi") { return true; }
        return self.dci_control_flow_boundary_supported(boundary);
    }

    public fn dci_symbol_matches_function(self, sym: rawptr, function_id: i32) -> bool {
        if (sym == null || cJSON_IsObject(sym) == 0) { return false; }
        let kind_match = self.dci_json_string(sym, "kind") == self.dci_symbol_kind_for_function(function_id);
        let owner_match = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id) > 0;
        let member_match = self.dci_symbol_member_name_matches_function(sym, function_id);
        let params_match = self.dci_symbol_params_match_function(self.dci_json_item(sym, "params"), function_id);
        let flags_match = self.dci_symbol_flags_match_function(sym, function_id);
        let return_match = self.dci_symbol_return_matches_function(sym, function_id);
        let cc_match = self.dci_symbol_calling_convention_supported(sym);
        let unwind_match = self.dci_symbol_unwind_supported(sym);
        let link_match = self.dci_symbol_link_name(sym).len > 0;
        return kind_match && owner_match && member_match && params_match
            && flags_match && return_match && cc_match && unwind_match && link_match;
    }

    public fn dci_symbol_contract_items_equal(self,
                                               lhs: rawptr,
                                               rhs: rawptr,
                                               key: string) -> bool {
        let lhs_item = self.dci_json_item(lhs, key);
        let rhs_item = self.dci_json_item(rhs, key);
        if (lhs_item == null || rhs_item == null) { return lhs_item == rhs_item; }
        return cJSON_Compare(lhs_item, rhs_item, 1) != 0;
    }

    public fn dci_symbol_contracts_equivalent(self, lhs: rawptr, rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (self.dci_symbol_link_name(lhs) != self.dci_symbol_link_name(rhs)
            || self.dci_symbol_calling_convention(lhs)
                != self.dci_symbol_calling_convention(rhs)
            || self.dci_json_string(lhs, "kind") != self.dci_json_string(rhs, "kind")
            || self.dci_json_string(lhs, "owner") != self.dci_json_string(rhs, "owner")) {
            return false;
        }
        return self.dci_symbol_contract_items_equal(lhs, rhs, "params")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "return")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "abi")
            && self.dci_symbol_contract_items_equal(lhs, rhs, "control_flow");
    }

    fn dci_matching_symbols_same_native(self, lhs: rawptr, rhs: rawptr) -> bool {
        if (lhs == null || rhs == null) { return lhs == rhs; }
        if (self.dci_symbol_contracts_equivalent(lhs, rhs)) { return true; }
        let lhs_link = self.dci_symbol_link_name(lhs);
        let rhs_link = self.dci_symbol_link_name(rhs);
        if (lhs_link.len == 0 || lhs_link != rhs_link) { return false; }
        if (self.dci_symbol_calling_convention(lhs)
                != self.dci_symbol_calling_convention(rhs)
            || self.dci_json_string(lhs, "kind") != self.dci_json_string(rhs, "kind")) {
            return false;
        }
        return self.dci_shared_link_type_names_compatible(
            self.dci_json_string(lhs, "owner"),
            self.dci_json_string(rhs, "owner"));
    }

    fn dci_prefer_matching_symbol(self, function_id: i32, current: rawptr, candidate: rawptr) -> rawptr {
        if (current == null) { return candidate; }
        if (candidate == null) { return current; }
        let want = self.foreign_dci_owner_type_text(function_id);
        let current_exact = self.dci_plain_type_names_match(
            self.dci_json_string(current, "owner"), want);
        let candidate_exact = self.dci_plain_type_names_match(
            self.dci_json_string(candidate, "owner"), want);
        if (candidate_exact && !current_exact) { return candidate; }
        return current;
    }

    fn dci_select_symbol_from_chain(self, function_id: i32, chain_head: rawptr) -> rawptr {
        var best_rank: i32 = 0;
        var best: rawptr = null;
        var best_rank_conflicts = false;
        var chain = chain_head;
        while (chain != null) {
            let sym = ast_read_rawptr(chain);
            if (self.dci_symbol_matches_function(sym, function_id)) {
                let rank = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id);
                if (rank > best_rank) {
                    best_rank = rank;
                    best = sym;
                    best_rank_conflicts = false;
                } else if (rank == best_rank && rank > 0 && best != null) {
                    if (self.dci_matching_symbols_same_native(best, sym)) {
                        best = self.dci_prefer_matching_symbol(function_id, best, sym);
                    } else {
                        best_rank_conflicts = true;
                    }
                }
            }
            chain = ast_read_rawptr(ptr_offset(chain, 8));
        }
        if (best_rank_conflicts) {
            self.report_error("conflicting DCI symbol contracts for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        return best;
    }

    fn dci_select_symbol_from_array(self, function_id: i32, symbols: rawptr) -> rawptr {
        var best_rank: i32 = 0;
        var best: rawptr = null;
        var best_rank_conflicts = false;
        var sym = dci_cjson_child(symbols);
        while (sym != null) {
            if (self.dci_symbol_matches_function(sym, function_id)) {
                let rank = self.dci_symbol_owner_match_rank(self.dci_json_string(sym, "owner"), function_id);
                if (rank > best_rank) {
                    best_rank = rank;
                    best = sym;
                    best_rank_conflicts = false;
                } else if (rank == best_rank && rank > 0 && best != null) {
                    if (self.dci_matching_symbols_same_native(best, sym)) {
                        best = self.dci_prefer_matching_symbol(function_id, best, sym);
                    } else {
                        best_rank_conflicts = true;
                    }
                }
            }
            sym = dci_cjson_next(sym);
        }
        if (best_rank_conflicts) {
            self.report_error("conflicting DCI symbol contracts for `"
                      + self.m.function_name(function_id) + "`");
            return null;
        }
        return best;
    }

    // ── DCI open-generic instances ─────────────────────────────────────
    // The Active Adapter materializes the native entrypoint from the resolved
    // producer facts, so the ABI is derived from the MIR types instead of a
    // hand-written descriptor: pointers/primitives pass direct, records over
    // 8 bytes pass indirect (by value) and return sret — mirroring what a
    // closed contract would have declared for the same concrete type.

    public fn dci_open_type_size(self, type_id: i32) -> i64 {
        let storage = self.lower_storage_type(type_id);
        if (storage == null) { return 0; }
        return vyx_rt_type_alloc_size(self.mod, storage);
    }

    public fn dci_open_type_kind_word(self, type_id: i32) -> string {
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (kind == ty_CLASS()) { return "record"; }
        return "primitive";
    }

    public fn dci_open_lowering_passing(self, type_id: i32) -> string {
        if (llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            return "direct";
        }
        let size = self.dci_open_type_size(type_id);
        if (size <= 0) { return "direct"; }
        if (size > 8) { return "indirect"; }
        // Win64 carries a 1/2/4/8-byte aggregate in a register and hands every
        // other size over by reference -- clang lowers a 3-byte struct to
        // `ptr` and returns one through sret.  Routing those to `indirect`
        // keeps the synthesized contract equal to what the producer does;
        // scalars are exactly 1/2/4/8 bytes and are unaffected.
        let canonical = self.canonical_record_type_id(type_id);
        if (llvm_mir_effective_target_is_windows()
            && llvm_mir_type_kind(&self.m, canonical) == ty_CLASS()
            && size != 1 && size != 2 && size != 4 && size != 8) {
            return "indirect";
        }
        return "direct";
    }

    public fn dci_open_lowering_json(self, type_id: i32, index: i32,
                                     is_return: bool) -> string {
        let passing = self.dci_open_lowering_passing(type_id);
        let size = self.dci_open_type_size(type_id);
        var index_part = "";
        if (!is_return) {
            index_part = "\"index\":" + index.toString() + ",";
        }
        if (passing == "direct") {
            return "{" + index_part + "\"passing\":\"direct\",\"size\":"
                   + size.toString() + "}";
        }
        if (is_return) {
            return "{\"passing\":\"sret\",\"alignment\":8,\"size\":"
                   + size.toString() + ",\"attributes\":[\"sret\"]}";
        }
        return "{" + index_part + "\"passing\":\"indirect\",\"alignment\":8"
               + ",\"size\":" + size.toString()
               + ",\"attributes\":[\"by_value\"]}";
    }

    public fn dci_open_type_json(self, type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, type_id);
        return "{\"name\":\"" + text + "\",\"kind\":\""
               + self.dci_open_type_kind_word(type_id)
               + "\",\"nullable\":false,\"reference\":\"value\"}";
    }

    /// Contract-equivalent symbol object for an open-generic DCI instance
    /// (`base__<args>`).  Parsed from synthesized JSON so every downstream
    /// contract validator runs unchanged.
    public fn dci_synthesize_open_instance_symbol(self, function_id: i32) -> rawptr {
        let name = self.m.function_name(function_id);
        var base = name;
        var suffix = "__";
        let args = mir_unit_function_generic_args(&self.m, function_id);
        var ai: i32 = 0;
        while (ai < 64) {
            let arg = policy_generic_arg_at(args, ai);
            if (arg.len == 0) { break; }
            if (ai > 0) { suffix = suffix + "_"; }
            suffix = suffix + policy_mangle_part(arg);
            ai = ai + 1;
        }
        if (name.endsWith(suffix) && suffix.len > 2) {
            base = name.substring(0, name.len - suffix.len);
        }

        var params_json = "";
        var lowerings_json = "";
        let param_count = self.function_source_param_count(function_id);
        var pi: i32 = 0;
        while (pi < param_count) {
            let param_type = self.function_source_param_type(function_id, pi);
            if (pi > 0) {
                params_json = params_json + ",";
                lowerings_json = lowerings_json + ",";
            }
            params_json = params_json
                + "{\"name\":\"v" + pi.toString()
                + "\",\"type\":" + self.dci_open_type_json(param_type)
                + ",\"location\":\"abi\",\"ownership\":\"copy\"}";
            lowerings_json = lowerings_json
                + self.dci_open_lowering_json(param_type, pi, false);
            pi = pi + 1;
        }

        let ret_type = self.m.function_return_type(function_id);
        let return_lowering = self.dci_open_lowering_json(ret_type, -1, true);
        var hidden = "";
        if (self.dci_open_lowering_passing(ret_type) == "indirect") {
            hidden = ",\"hidden_parameters\":[{\"passing\":\"sret\",\"alignment\":8"
                     + ",\"size\":" + self.dci_open_type_size(ret_type).toString()
                     + ",\"attributes\":[\"sret\"]}]";
        }

        let text = "{\"name\":\"" + base
            + "\",\"link_name\":\"" + name
            + "\",\"kind\":\"function\",\"calling_convention\":\"system\""
            + ",\"linkage\":\"external\",\"visibility\":\"public\""
            + ",\"params\":[" + params_json + "]"
            + ",\"return\":{\"type\":" + self.dci_open_type_json(ret_type)
            + ",\"location\":\"abi\",\"ownership\":\"copy\"}"
            + ",\"abi\":{\"calling_convention\":\"system\",\"variadic\":false"
            + ",\"parameters\":[" + lowerings_json + "]"
            + ",\"return\":" + return_lowering + hidden + "}"
            + ",\"control_flow\":{\"default_boundary\":\"no_unwind\""
            + ",\"propagation\":{\"mode\":\"forbidden\"}}}";
        let parsed = cJSON_Parse(text.c_str());
        if (parsed == null) {
            self.report_error("cannot synthesize open-generic DCI symbol for `"
                      + name + "`");
        }
        return parsed;
    }

    public fn dci_symbol_object_for_function(self, function_id: i32) -> rawptr {
        if (function_id == mir_id_invalid()) { return null; }
        if (!self.function_is_foreign_dci(function_id)
            && !self.function_is_dci_vyx_override_callback(function_id)) { return null; }
        // Open-generic instances derive their whole ABI from the MIR types;
        // they never consult a descriptor, so this check runs before the
        // DCI-ABI-mode gate below.
        if (self.function_name_is_foreign_dci_instance(function_id)) {
            let cached_open = llvm_mir_map_get(self.dci_symbol_object_cache, function_id);
            if (cached_open != null) { return cached_open; }
            let synthesized = self.dci_synthesize_open_instance_symbol(function_id);
            if (synthesized != null) {
                llvm_mir_map_put(self.dci_symbol_object_cache, function_id, synthesized);
            }
            return synthesized;
        }
        if (!mir_unit_has_dci_abi(&self.m)) { return null; }
        let cached = llvm_mir_map_get(self.dci_symbol_object_cache, function_id);
        if (cached != null) {
            if (cached == self.dci_lookup_miss) { return null; }
            return cached;
        }
        if (self.dci_json() == null) { return null; }
        self.dci_ensure_indexes();
        let kind = self.dci_symbol_kind_for_function(function_id);
        let member = self.dci_symbol_name_for_function(function_id);
        var best: rawptr = null;
        var scanned_index = false;
        if (kind.len > 0 && member.len > 0) {
            let chain = llvm_mir_dci_obj_index_lookup(self.dci_symbol_index,
                                                       self.dci_symbol_index_cap,
                                                       kind + "#" + member);
            if (chain != null) {
                best = self.dci_select_symbol_from_chain(function_id, chain);
                scanned_index = true;
            }
        }
        if (!scanned_index) {
            best = self.dci_select_symbol_from_array(function_id, self.dci_root_exports_array("symbols"));
        }
        if (best == null) {
            best = self.dci_translate_unwind_translator_for_function(function_id);
        }
        if (best == null) {
            if (llvm_mir_env_enabled("VYX_DCI_SYMBOL_TRACE")) {
                self.dci_trace_symbol_lookup(function_id, kind, member);
            }
            if (self.dci_lookup_miss != null) {
                llvm_mir_map_put(self.dci_symbol_object_cache, function_id, self.dci_lookup_miss);
            }
            return null;
        }
        llvm_mir_map_put(self.dci_symbol_object_cache, function_id, best);
        return best;
    }

    /// `VYX_DCI_SYMBOL_TRACE=1`: explain a failed descriptor lookup.  A rejected
    /// contract otherwise surfaces as a single opaque "no matching symbol"
    /// error, and the only way to learn *which* predicate rejected *which*
    /// candidate is to rebuild with prints inside the matcher.  This dumps the
    /// derived key plus a per-predicate verdict for every contract symbol
    /// sharing the kind, so the mismatch names itself.
    public fn dci_trace_symbol_lookup(self, function_id: i32, kind: string, member: string) {
        print("[dci-symbol] miss fn=" + self.m.function_name(function_id)
              + " kind=" + kind
              + " key_member=" + member
              + " derived_member=" + self.dci_symbol_name_for_function(function_id)
              + " owner_text=" + self.foreign_dci_owner_type_text(function_id));
        let symbols = self.dci_root_exports_array("symbols");
        var sym = dci_cjson_child(symbols);
        var dumped: i32 = 0;
        while (sym != null && dumped < 32) {
            if (cJSON_IsObject(sym) != 0 && self.dci_json_string(sym, "kind") == kind) {
                dumped = dumped + 1;
                var verdicts: string = "";
                verdicts = verdicts + " owner_rank="
                    + self.dci_symbol_owner_match_rank(
                          self.dci_json_string(sym, "owner"), function_id).toString();
                verdicts = verdicts + " member=" + dci_trace_verdict(
                    self.dci_symbol_member_name_matches_function(sym, function_id));
                verdicts = verdicts + " params=" + dci_trace_verdict(
                    self.dci_symbol_params_match_function(
                        self.dci_json_item(sym, "params"), function_id));
                verdicts = verdicts + " flags=" + dci_trace_verdict(
                    self.dci_symbol_flags_match_function(sym, function_id));
                verdicts = verdicts + " return=" + dci_trace_verdict(
                    self.dci_symbol_return_matches_function(sym, function_id));
                verdicts = verdicts + " cc=" + dci_trace_verdict(
                    self.dci_symbol_calling_convention_supported(sym));
                verdicts = verdicts + " unwind=" + dci_trace_verdict(
                    self.dci_symbol_unwind_supported(sym));
                verdicts = verdicts + " link=" + dci_trace_verdict(
                    self.dci_symbol_link_name(sym).len > 0);
                print("[dci-symbol]   cand owner=" + self.dci_json_string(sym, "owner")
                      + " member_name=" + self.dci_json_string(sym, "member_name")
                      + " match=" + dci_trace_verdict(
                            self.dci_symbol_matches_function(sym, function_id))
                      + verdicts);
            }
            sym = dci_cjson_next(sym);
        }
        print("[dci-symbol]   dumped=" + dumped.toString());
    }

    public fn dci_symbol_abi_object(self, function_id: i32) -> rawptr {
        let symbol = self.dci_symbol_object_for_function(function_id);
        if (symbol == null) { return null; }
        let abi = self.dci_json_item(symbol, "abi");
        if (abi == null || cJSON_IsObject(abi) == 0) { return null; }
        return abi;
    }

    public fn dci_abi_parameter_array(self, function_id: i32) -> rawptr {
        let abi = self.dci_symbol_abi_object(function_id);
        if (abi == null) { return null; }
        var params = self.dci_json_item(abi, "parameters");
        if (params == null) { params = self.dci_json_item(abi, "params"); }
        if (params == null || cJSON_IsArray(params) == 0) { return null; }
        return params;
    }

    public fn dci_abi_parameters_complete(self, function_id: i32) -> bool {
        let symbol = self.dci_symbol_object_for_function(function_id);
        if (symbol == null) {
            self.report_error("cannot resolve DCI symbol contract for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let source_params = self.dci_json_item(symbol, "params");
        var expected: i32 = 0;
        if (source_params != null) {
            if (cJSON_IsArray(source_params) == 0) {
                self.report_error("DCI source parameters must be an array for `"
                          + self.m.function_name(function_id) + "`");
                return false;
            }
            expected = cJSON_GetArraySize(source_params);
        }
        let lowered = self.dci_abi_parameter_array(function_id);
        if (lowered == null) {
            self.report_error("DCI ABI parameters are missing for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let lowered_count = cJSON_GetArraySize(lowered);
        if (lowered_count != expected) {
            self.report_error("DCI ABI parameter lowering count " + lowered_count.toString()
                      + " does not match " + expected.toString() + " source parameter(s) for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        var wanted: i32 = 0;
        while (wanted < expected) {
            var matches: i32 = 0;
            var lowering_index: i32 = 0;
            while (lowering_index < lowered_count) {
                let lowering = cJSON_GetArrayItem(lowered, lowering_index);
                if (lowering == null || cJSON_IsObject(lowering) == 0) {
                    self.report_error("invalid DCI ABI parameter lowering for `"
                              + self.m.function_name(function_id) + "`");
                    return false;
                }
                let index_item = self.dci_json_item(lowering, "index");
                var source_index = lowering_index;
                if (index_item != null) {
                    if (cJSON_IsNumber(index_item) == 0) {
                        self.report_error("DCI ABI parameter index must be numeric for `"
                                  + self.m.function_name(function_id) + "`");
                        return false;
                    }
                    let errs = self.error_count;
                    let source_index_i64 = self.dci_json_number_item_i64(index_item, "ABI parameter index");
                    if (self.error_count > errs) { return false; }
                    if (source_index_i64 < 0 || source_index_i64 > 2147483647) {
                        self.report_error("DCI ABI parameter index must be an integer for `"
                                  + self.m.function_name(function_id) + "`");
                        return false;
                    }
                    source_index = source_index_i64 as i32;
                }
                if (source_index < 0 || source_index >= expected) {
                    self.report_error("DCI ABI parameter index " + source_index.toString()
                              + " is out of range for `" + self.m.function_name(function_id) + "`");
                    return false;
                }
                if (source_index == wanted) { matches = matches + 1; }
                lowering_index = lowering_index + 1;
            }
            if (matches != 1) {
                self.report_error("DCI ABI parameter #" + wanted.toString()
                          + " is not covered exactly once for `"
                          + self.m.function_name(function_id) + "`");
                return false;
            }
            wanted = wanted + 1;
        }
        return true;
    }

    public fn dci_source_parameter_object(self,
                                          function_id: i32,
                                          source_index: i32) -> rawptr {
        var descriptor_index = source_index;
        if (self.function_is_foreign_dci_instance_method(function_id)) {
            if (source_index == 0) { return null; }
            descriptor_index = source_index - 1;
        }
        let symbol = self.dci_symbol_object_for_function(function_id);
        let params = self.dci_json_item(symbol, "params");
        if (params == null || cJSON_IsArray(params) == 0
            || descriptor_index < 0 || descriptor_index >= cJSON_GetArraySize(params)) {
            return null;
        }
        return cJSON_GetArrayItem(params, descriptor_index);
    }

    public fn dci_source_parameter_abi(self, function_id: i32, source_index: i32) -> rawptr {
        var descriptor_index = source_index;
        if (self.function_is_foreign_dci_instance_method(function_id)) {
            if (source_index == 0) { return null; }
            descriptor_index = source_index - 1;
        }
        let params = self.dci_abi_parameter_array(function_id);
        if (params == null || descriptor_index < 0) { return null; }
        let n = cJSON_GetArraySize(params);
        var i: i32 = 0;
        var matched: rawptr = null;
        while (i < n) {
            let param = cJSON_GetArrayItem(params, i);
            let index_item = self.dci_json_item(param, "index");
            if (index_item != null && cJSON_IsNumber(index_item) != 0) {
                let errs = self.error_count;
                let index_i64 = self.dci_json_number_item_i64(index_item, "ABI parameter index");
                if (self.error_count > errs) { return null; }
                if (index_i64 == descriptor_index as i64) {
                    if (matched != null) {
                        self.report_error("duplicate DCI ABI parameter index "
                                  + descriptor_index.toString() + " for `"
                                  + self.m.function_name(function_id) + "`");
                        return null;
                    }
                    matched = param;
                }
            }
            i = i + 1;
        }
        if (matched != null) { return matched; }
        if (descriptor_index >= n) { return null; }
        let positional = cJSON_GetArrayItem(params, descriptor_index);
        if (self.dci_json_item(positional, "index") == null) { return positional; }
        return null;
    }

    public fn dci_return_abi(self, function_id: i32) -> rawptr {
        let abi = self.dci_symbol_abi_object(function_id);
        if (abi == null) { return null; }
        let ret = self.dci_json_item(abi, "return");
        if (ret == null || cJSON_IsObject(ret) == 0) { return null; }
        return ret;
    }

    public fn dci_abi_passing(self, lowering: rawptr) -> string {
        if (lowering == null) { return "direct"; }
        let item = self.dci_json_item(lowering, "passing");
        if (item == null) { return "<missing>"; }
        if (cJSON_IsString(item) == 0) { return "<invalid>"; }
        let raw = cJSON_GetStringValue(item);
        if (raw == null) { return "<invalid>"; }
        let passing = from_cstr(raw);
        if (passing.len == 0) { return "<invalid>"; }
        return passing;
    }

    // Vyx pointer/reference values are two-word semantic handles inside MIR.
    // A direct C/C++ DCI pointer/reference is still one physical machine
    // pointer at the foreign ABI boundary.  Keep this decision centralized so
    // declarations, direct calls and virtual calls cannot drift apart.
    public fn dci_direct_handle_uses_raw_pointer_abi(self,
                                                      type_id: i32,
                                                      lowering: rawptr) -> bool {
        if (self.dci_abi_passing(lowering) != "direct") { return false; }
        if (!llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, type_id))) {
            return false;
        }
        // Older but valid DCI descriptors carry the pointer/reference marker
        // only in the source parameter/return contract, not redundantly in the
        // ABI lowering object. Symbol matching has already verified that
        // semantic contract, so the MIR handle kind is authoritative here.
        return true;
    }

    public fn dci_abi_passing_known(self, passing: string) -> bool {
        return passing == "ignore" || passing == "direct" || passing == "indirect"
            || passing == "byval" || passing == "sret" || passing == "inalloca"
            || passing == "split" || passing == "coerce";
    }

    public fn require_dci_abi_passing(self, lowering: rawptr, context: string) -> bool {
        if (lowering == null) {
            self.report_error("missing DCI ABI lowering for " + context);
            return false;
        }
        let passing = self.dci_abi_passing(lowering);
        if (passing == "<missing>") {
            self.report_error("missing DCI ABI passing for " + context);
            return false;
        }
        if (passing == "<invalid>") {
            self.report_error("invalid DCI ABI passing for " + context);
            return false;
        }
        if (!self.dci_abi_passing_known(passing)) {
            self.report_error("unsupported DCI ABI passing `" + passing + "` for " + context);
            return false;
        }
        return true;
    }

    public fn dci_abi_decorations_supported(self,
                                             lowering: rawptr,
                                             context: string) -> bool {
        let passing = self.dci_abi_passing(lowering);
        let attributes = self.dci_json_item(lowering, "attributes");
        if (attributes != null) {
            if (cJSON_IsArray(attributes) == 0) {
                self.report_error("DCI ABI attributes must be an array for " + context);
                return false;
            }
            let attribute_count = cJSON_GetArraySize(attributes);
            var attribute_index: i32 = 0;
            while (attribute_index < attribute_count) {
                let attribute_item = cJSON_GetArrayItem(attributes, attribute_index);
                if (attribute_item == null || cJSON_IsString(attribute_item) == 0) {
                    self.report_error("DCI ABI attribute must be a string for " + context);
                    return false;
                }
                let attribute_raw = cJSON_GetStringValue(attribute_item);
                var attribute = "";
                if (attribute_raw != null) { attribute = from_cstr(attribute_raw); }
                let supported = (attribute == "sret" && passing == "sret")
                    || (attribute == "byval" && passing == "byval")
                    || (attribute == "inalloca" && passing == "inalloca")
                    || (attribute == "by_value"
                        && (passing == "indirect" || passing == "byval"
                            || passing == "inalloca"));
                if (!supported) {
                    self.report_error("unsupported DCI ABI attribute `" + attribute
                              + "` for " + context);
                    return false;
                }
                attribute_index = attribute_index + 1;
            }
        }
        let registers = self.dci_json_item(lowering, "registers");
        if (registers != null) {
            if (cJSON_IsArray(registers) == 0) {
                self.report_error("DCI ABI registers must be an array for " + context);
                return false;
            }
            if (cJSON_GetArraySize(registers) > 0
                && passing != "split"
                && passing != "coerce") {
                self.report_error("explicit DCI ABI register assignment is unsupported for " + context);
                return false;
            }
        }
        return true;
    }

    public fn dci_alignment_value_supported(self, alignment: i64) -> bool {
        return alignment > 0
            && alignment <= 2147483647
            && (alignment & (alignment - 1)) == 0;
    }

    public fn require_dci_abi_alignment(self, lowering: rawptr, context: string) -> bool {
        let item = self.dci_json_item(lowering, "alignment");
        if (item == null) { return true; }
        if (cJSON_IsNumber(item) == 0) {
            self.report_error("DCI ABI alignment must be numeric for " + context);
            return false;
        }
        let errs = self.error_count;
        let alignment = self.dci_json_number_item_i64(item, "ABI alignment for " + context);
        if (self.error_count > errs) { return false; }
        if (!self.dci_alignment_value_supported(alignment)) {
            self.report_error("DCI ABI alignment " + alignment.toString()
                      + " must be a representable power of two for " + context);
            return false;
        }
        return true;
    }

    public fn dci_function_abi_lowerings_supported(self, function_id: i32) -> bool {
        let function_name = self.m.function_name(function_id);
        let skip_result_storage = self.dci_call_converts_translated_to_result(function_id);
        let abi = self.dci_symbol_abi_object(function_id);
        let variadic = self.dci_json_item(abi, "variadic");
        if (variadic != null) {
            if (cJSON_IsTrue(variadic) != 0) {
                self.report_error("variadic DCI ABI is unsupported for `" + function_name + "`");
                return false;
            }
            if (cJSON_IsFalse(variadic) == 0) {
                self.report_error("DCI ABI variadic must be boolean for `" + function_name + "`");
                return false;
            }
        }
        let return_lowering = self.dci_return_abi(function_id);
        if (!self.require_dci_abi_passing(return_lowering,
                                          "return of `" + function_name + "`")
            || !self.require_dci_abi_alignment(return_lowering,
                                               "return of `" + function_name + "`")
            || !self.dci_class_value_return_lifecycle_supported(function_id)
            || (!skip_result_storage
                && !self.dci_abi_storage_contract_supported(
                    self.m.function_return_type(function_id),
                    return_lowering,
                    "return of `" + function_name + "`"))
            || !self.dci_abi_decorations_supported(return_lowering,
                                                    "return of `" + function_name + "`")) {
            return false;
        }
        if (!self.dci_abi_parameters_complete(function_id)) { return false; }
        let parameters = self.dci_abi_parameter_array(function_id);
        if (parameters != null) {
            let parameter_count = cJSON_GetArraySize(parameters);
            var parameter_index: i32 = 0;
            while (parameter_index < parameter_count) {
                let parameter_lowering = cJSON_GetArrayItem(parameters, parameter_index);
                if (!self.require_dci_abi_passing(parameter_lowering,
                                                  "parameter lowering #"
                                                  + parameter_index.toString()
                                                  + " of `" + function_name + "`")
                    || !self.require_dci_abi_alignment(parameter_lowering,
                                                    "parameter lowering #"
                                                    + parameter_index.toString()
                                                    + " of `" + function_name + "`")
                    || !self.dci_abi_decorations_supported(
                            parameter_lowering,
                            "parameter lowering #" + parameter_index.toString()
                            + " of `" + function_name + "`")) {
                    return false;
                }
                parameter_index = parameter_index + 1;
            }
        }
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            if (!self.dci_value_parameter_lifecycle_supported(
                    function_id,
                    source_index,
                    self.function_source_param_type(function_id, source_index))
                || !self.dci_abi_storage_contract_supported(
                    self.function_source_param_type(function_id, source_index),
                    self.dci_source_parameter_abi(function_id, source_index),
                    "parameter #" + source_index.toString()
                    + " of `" + function_name + "`")) {
                return false;
            }
            source_index = source_index + 1;
        }
        let hidden = self.dci_json_item(abi, "hidden_parameters");
        if (hidden != null && cJSON_IsArray(hidden) != 0) {
            let hidden_count = cJSON_GetArraySize(hidden);
            var hidden_index: i32 = 0;
            while (hidden_index < hidden_count) {
                let hidden_lowering = cJSON_GetArrayItem(hidden, hidden_index);
                if (!self.require_dci_abi_passing(hidden_lowering,
                                                  "hidden parameter #"
                                                  + hidden_index.toString()
                                                  + " of `" + function_name + "`")
                    || !self.require_dci_abi_alignment(hidden_lowering,
                                                    "hidden parameter #"
                                                    + hidden_index.toString()
                                                    + " of `" + function_name + "`")
                    || (self.dci_abi_passing(hidden_lowering) == "sret"
                        && !skip_result_storage
                        && !self.dci_abi_storage_contract_supported(
                                self.m.function_return_type(function_id),
                                hidden_lowering,
                                "hidden parameter #" + hidden_index.toString()
                                + " of `" + function_name + "`"))
                    || !self.dci_abi_decorations_supported(
                            hidden_lowering,
                            "hidden parameter #" + hidden_index.toString()
                            + " of `" + function_name + "`")) {
                    return false;
                }
                hidden_index = hidden_index + 1;
            }
        }
        return true;
    }

    public fn dci_class_value_return_lifecycle_supported(self, function_id: i32) -> bool {
        let type_id = self.m.function_return_type(function_id);
        let symbol = self.dci_symbol_object_for_function(function_id);
        let returned = self.dci_json_item(symbol, "return");
        let type_object = self.dci_json_item(returned, "type");
        if (self.dci_json_string(type_object, "reference") != "value") { return true; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (!mir_unit_type_is_foreign_dci(&self.m, canonical_type)
            || llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) {
            return true;
        }
        if (!self.dci_type_uses_stable_value_layout(canonical_type)) {
            self.report_error("DCI class-by-value return from `" + self.m.function_name(function_id)
                      + "` requires a stable or transparent value representation");
            return false;
        }
        let layout = self.dci_layout_object_for_type(type_id);
        // An operation-owned type is materialized by its checked Descriptor
        // create/copy/move operation.  Such an operation is the explicit
        // lifecycle boundary, rather than an implicit by-value copy.
        if (self.dci_function_is_lifecycle_value_materializer(function_id,
                                                              canonical_type)) {
            return true;
        }
        // is_pod is not required: a non-POD type (user default ctor) may still be
        // trivially copyable and trivially destructible, which is what makes a
        // by-value return safe. Trivially-destructible is the hard gate; the
        // trivial copy/move check below confirms the rest.
        if (layout == null
            || self.dci_json_item(layout, "is_trivially_destructible") == null
            || cJSON_IsTrue(self.dci_json_item(layout, "is_trivially_destructible")) == 0) {
            self.report_error("DCI class-by-value return from `" + self.m.function_name(function_id)
                      + "` has a nontrivial or incomplete lifecycle contract");
            return false;
        }
        let lifecycle = self.dci_json_item(layout, "lifecycle");
        if (lifecycle != null && cJSON_IsObject(lifecycle) != 0
            && self.dci_json_string(lifecycle, "copy_semantics") == "trivial"
            && self.dci_json_string(lifecycle, "move_semantics") == "trivial") {
            let destruction = self.dci_json_string(lifecycle, "destruction");
            if (destruction == "trivial" || destruction == "none") { return true; }
        }
        self.report_error("DCI class-by-value return from `" + self.m.function_name(function_id)
                  + "` requires lifecycle materialization");
        return false;
    }

    public fn dci_function_is_lifecycle_value_materializer(self,
                                                           function_id: i32,
                                                           type_id: i32) -> bool {
        let function_symbol = self.dci_symbol_object_for_function(function_id);
        if (function_symbol == null) { return false; }
        let type_name = llvm_mir_type_text(&self.m, type_id);
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let layouts = self.dci_exports_array_from(self.dci_contract_at(root_i), "layouts");
            if (layouts != null) {
                let count = cJSON_GetArraySize(layouts);
                var layout_index: i32 = 0;
                while (layout_index < count) {
                    let layout = cJSON_GetArrayItem(layouts, layout_index);
                    if (self.dci_record_name_matches_text(self.dci_json_string(layout, "type_name"),
                                                          type_name)) {
                        let lifecycle = self.dci_json_item(layout, "lifecycle");
                        let operations = self.dci_json_item(lifecycle, "operations");
                        let create = self.dci_json_item(operations, "create");
                        let copy = self.dci_json_item(operations, "copy");
                        let move = self.dci_json_item(operations, "move");
                        let create_symbol = self.dci_symbol_object_for_reference(
                            self.dci_json_string(create, "symbol"));
                        let copy_symbol = self.dci_symbol_object_for_reference(
                            self.dci_json_string(copy, "symbol"));
                        let move_symbol = self.dci_symbol_object_for_reference(
                            self.dci_json_string(move, "symbol"));
                        if ((create_symbol != null
                             && self.dci_symbol_contracts_equivalent(function_symbol, create_symbol))
                            || (copy_symbol != null
                                && self.dci_symbol_contracts_equivalent(function_symbol, copy_symbol))
                            || (move_symbol != null
                                && self.dci_symbol_contracts_equivalent(function_symbol, move_symbol))) {
                            return true;
                        }
                        return false;
                    }
                    layout_index = layout_index + 1;
                }
            }
            root_i = root_i + 1;
        }
        return false;
    }

    public fn dci_abi_storage_contract_supported(self,
                                                   type_id: i32,
                                                   lowering: rawptr,
                                                   context: string) -> bool {
        let passing = self.dci_abi_passing(lowering);
        if (passing == "coerce") {
            return self.dci_coerce_contract_supported(type_id, lowering, context);
        }
        if (passing == "split") {
            return self.dci_split_contract_supported(type_id, lowering, context);
        }
        if (passing != "indirect" && passing != "byval" && passing != "sret") {
            return true;
        }
        if (self.dci_json_item(lowering, "alignment") == null) {
            self.report_error("DCI " + passing + " ABI requires alignment for " + context);
            return false;
        }
        let size_item = self.dci_json_item(lowering, "size");
        if (size_item == null || cJSON_IsNumber(size_item) == 0) {
            self.report_error("DCI " + passing + " ABI requires a positive byte size for " + context);
            return false;
        }
        let errs = self.error_count;
        let declared_size = self.dci_json_number_item_i64(size_item, passing + " ABI size for " + context);
        if (self.error_count > errs) { return false; }
        if (declared_size < 1) {
            self.report_error("DCI " + passing + " ABI size must be a positive integer for " + context);
            return false;
        }
        let storage_type = self.lower_storage_type(type_id);
        if (storage_type == null) {
            self.report_error("cannot lower DCI ABI storage type for " + context);
            return false;
        }
        let storage_size = vyx_rt_type_alloc_size(self.mod, storage_type);
        if (storage_size <= 0 || declared_size != storage_size) {
            self.report_error("DCI " + passing + " ABI size mismatch for " + context
                      + ": descriptor=" + declared_size.toString()
                      + " storage=" + storage_size.toString());
            return false;
        }
        return true;
    }

    public fn dci_function_uses_sret(self, function_id: i32) -> bool {
        return self.dci_abi_passing(self.dci_return_abi(function_id)) == "sret";
    }

    // MSVC x64 hands member functions `this` in RCX and the hidden return
    // pointer in RDX; the hidden pointer leads only for free functions.  The
    // contract labels the symbol side: "win64"/"cxx_method" symbols are real
    // member functions, "system"/"c" shims are free functions.  Returns false
    // on non-Windows targets, where Itanium keeps sret first even for methods.
    public fn dci_member_sret_after_receiver(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (!self.function_is_foreign_dci(function_id)) { return false; }
        if (!self.dci_function_uses_sret(function_id)) { return false; }
        if (self.function_is_foreign_dci_ctor(function_id)) { return false; }
        if (self.dci_symbol_receiver_param_count(function_id) <= 0) { return false; }
        if (!self.source_param_uses_self_pointer_abi(function_id, 0)) { return false; }
        if (!llvm_mir_effective_target_is_windows()) { return false; }
        let sym = self.dci_symbol_object_for_function(function_id);
        let cc = self.dci_symbol_calling_convention(sym);
        return cc == "win64" || cc == "cxx_method" || cc == "cxx_virtual_method";
    }

    public fn dci_abi_type_name(self, item: rawptr) -> string {
        if (item == null) { return ""; }
        if (cJSON_IsString(item) != 0) {
            let raw = cJSON_GetStringValue(item);
            if (raw != null) { return from_cstr(raw); }
            return "";
        }
        if (cJSON_IsObject(item) != 0) { return self.dci_json_string(item, "name"); }
        return "";
    }

    public fn dci_abi_coerce_type(self, lowering: rawptr) -> rawptr {
        if (lowering == null) { return null; }
        let registers = self.dci_json_item(lowering, "registers");
        if (registers != null && cJSON_IsArray(registers) != 0
            && cJSON_GetArraySize(registers) > 0) {
            return self.dci_llvm_type_from_registers(lowering);
        }
        let name = self.dci_abi_type_name(self.dci_json_item(lowering, "coerce_to"));
        if (name == "i8" || name == "u8" || name == "bool") { return self.ty_i8; }
        if (name == "i16" || name == "u16") { return self.ty_i16; }
        if (name == "i32" || name == "u32") { return self.ty_i32; }
        if (name == "i64" || name == "u64" || name == "isize" || name == "usize") { return self.ty_i64; }
        if (name == "ptr" || name == "rawptr" || name == "pointer") { return self.ty_ptr; }
        if (name == "f32" || name == "float") { return vyx_rt_float_type(self.mod, 32); }
        if (name == "f64" || name == "double") { return vyx_rt_float_type(self.mod, 64); }
        if (name == "i128" || name == "u128") { return vyx_rt_int_type(self.mod, 128); }
        return null;
    }

    public fn dci_llvm_type_for_token(self, token: string) -> rawptr {
        if (token == "i8" || token == "u8") { return self.ty_i8; }
        if (token == "i16" || token == "u16") { return self.ty_i16; }
        if (token == "i32" || token == "u32") { return self.ty_i32; }
        if (token == "i64" || token == "u64") { return self.ty_i64; }
        if (token == "i128" || token == "u128") { return vyx_rt_int_type(self.mod, 128); }
        if (token == "ptr" || token == "pointer") { return self.ty_ptr; }
        if (token == "float" || token == "f32") { return vyx_rt_float_type(self.mod, 32); }
        if (token == "double" || token == "f64") { return vyx_rt_float_type(self.mod, 64); }
        return null;
    }

    public fn dci_register_count(self, lowering: rawptr) -> i32 {
        let registers = self.dci_json_item(lowering, "registers");
        if (registers == null || cJSON_IsArray(registers) == 0) { return 0; }
        return cJSON_GetArraySize(registers);
    }

    public fn dci_register_token_at(self, lowering: rawptr, index: i32) -> string {
        let registers = self.dci_json_item(lowering, "registers");
        if (registers == null || cJSON_IsArray(registers) == 0) { return ""; }
        let item = cJSON_GetArrayItem(registers, index);
        if (item == null || cJSON_IsString(item) == 0) { return ""; }
        let raw = cJSON_GetStringValue(item);
        if (raw == null) { return ""; }
        return from_cstr(raw);
    }

    public fn dci_register_offset_at(self, lowering: rawptr, index: i32) -> i64 {
        let offsets = self.dci_json_item(lowering, "register_offsets");
        if (offsets == null || cJSON_IsArray(offsets) == 0) { return -1; }
        let item = cJSON_GetArrayItem(offsets, index);
        if (item == null || cJSON_IsNumber(item) == 0) { return -1; }
        let errs = self.error_count;
        let n = self.dci_json_number_item_i64(item, "register_offsets");
        if (self.error_count > errs) { return -1; }
        return n;
    }

    public fn dci_llvm_type_from_registers(self, lowering: rawptr) -> rawptr {
        let n = self.dci_register_count(lowering);
        if (n <= 0) { return null; }
        if (n == 1) { return self.dci_llvm_type_for_token(self.dci_register_token_at(lowering, 0)); }
        var name = "dci.abi";
        var i: i32 = 0;
        while (i < n) {
            name = name + "." + self.dci_register_token_at(lowering, i);
            i = i + 1;
        }
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) { return null; }
        if (vyx_rt_get_struct_field_ty(self.mod, st, 0) != null) { return st; }
        let fields = malloc((n * 8) as u64);
        if (fields == null) { return null; }
        i = 0;
        while (i < n) {
            let ty = self.dci_llvm_type_for_token(self.dci_register_token_at(lowering, i));
            if (ty == null) {
                free(fields);
                return null;
            }
            ast_write_rawptr(ptr_offset(fields, i * 8), ty);
            i = i + 1;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, n as u64, 0) != 0) {
            free(fields);
            return null;
        }
        free(fields);
        return st;
    }

    public fn dci_function_inalloca_count(self, function_id: i32) -> i32 {
        if (!self.function_is_foreign_dci(function_id)) { return 0; }
        var n: i32 = 0;
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            if (self.dci_abi_passing(self.dci_source_parameter_abi(function_id, source_index))
                == "inalloca") {
                n = n + 1;
            }
            source_index = source_index + 1;
        }
        return n;
    }

    public fn dci_inalloca_field_index(self, function_id: i32, source_index: i32) -> i32 {
        var field: i32 = 0;
        var i: i32 = 0;
        while (i < self.function_source_param_count(function_id)) {
            if (self.dci_abi_passing(self.dci_source_parameter_abi(function_id, i)) == "inalloca") {
                if (i == source_index) { return field; }
                field = field + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn dci_inalloca_frame_type(self, function_id: i32) -> rawptr {
        let n = self.dci_function_inalloca_count(function_id);
        if (n < 2) { return null; }
        var name = "dci.inalloca." + self.function_symbol_name(function_id);
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) { return null; }
        if (vyx_rt_get_struct_field_ty(self.mod, st, 0) != null) { return st; }
        let fields = malloc((n * 8) as u64);
        if (fields == null) { return null; }
        var field: i32 = 0;
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            if (self.dci_abi_passing(self.dci_source_parameter_abi(function_id, source_index))
                == "inalloca") {
                let ty = self.lower_storage_type(self.function_source_param_type(function_id, source_index));
                if (ty == null) {
                    free(fields);
                    return null;
                }
                ast_write_rawptr(ptr_offset(fields, field * 8), ty);
                field = field + 1;
            }
            source_index = source_index + 1;
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, n as u64, 0) != 0) {
            free(fields);
            return null;
        }
        free(fields);
        return st;
    }

    public fn dci_inalloca_frame_alignment(self, function_id: i32) -> i64 {
        var align: i64 = 1;
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            let lowering = self.dci_source_parameter_abi(function_id, source_index);
            if (self.dci_abi_passing(lowering) == "inalloca") {
                var a = self.dci_json_i64(lowering, "alignment");
                if (a <= 0) {
                    a = self.dci_type_value_alignment(self.function_source_param_type(function_id, source_index));
                }
                if (a > align) { align = a; }
            }
            source_index = source_index + 1;
        }
        return align;
    }

    public fn dci_prepare_inalloca_call_frame(self,
                                              function_id: i32,
                                              args: rawptr,
                                              argc: i32) -> bool {
        if (self.dci_function_inalloca_count(function_id) < 2) { return true; }
        if (args == null || argc < 1) {
            self.report_error("DCI packed inalloca frame is missing for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let frame_ty = self.dci_inalloca_frame_type(function_id);
        if (frame_ty == null) {
            self.report_error("cannot build DCI packed inalloca type for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let slot = vyx_rt_build_alloca(self.mod, frame_ty, "dci.inalloca.frame".c_str(), 19);
        if (slot == null) {
            self.report_error("cannot allocate DCI packed inalloca frame for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        let align = self.dci_inalloca_frame_alignment(function_id);
        if (align > 0) { vyx_rt_set_alignment(self.mod, slot, align as i32); }
        if (vyx_rt_set_alloca_inalloca(self.mod, slot) != 0) {
            self.report_error("cannot mark DCI packed inalloca frame: "
                      + self.runtime_last_error());
            return false;
        }
        ast_write_rawptr(ptr_offset(args, (argc - 1) * 8), slot);
        return true;
    }

    public fn dci_apply_packed_inalloca_attr(self,
                                             function_id: i32,
                                             fn_or_call: rawptr,
                                             llvm_index: i32,
                                             context: string) -> bool {
        let frame_ty = self.dci_inalloca_frame_type(function_id);
        let align = self.dci_inalloca_frame_alignment(function_id);
        if (frame_ty == null
            || vyx_rt_set_param_abi_attr(self.mod,
                                         fn_or_call,
                                         llvm_index as u64,
                                         "inalloca".c_str(),
                                         8,
                                         frame_ty,
                                         align as u64) != 0) {
            self.report_error("cannot apply packed DCI inalloca ABI " + context
                      + " of `" + self.m.function_name(function_id)
                      + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn dci_inalloca_frame_field_ptr(self,
                                           function_id: i32,
                                           frame: rawptr,
                                           source_index: i32) -> rawptr {
        let frame_ty = self.dci_inalloca_frame_type(function_id);
        let field = self.dci_inalloca_field_index(function_id, source_index);
        if (frame == null || frame_ty == null || field < 0) { return null; }
        return vyx_rt_build_gep2(self.mod,
                                 frame_ty,
                                 frame,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, field as i64, 0),
                                 "dci.inalloca.field".c_str(),
                                 19);
    }

    public fn dci_packed_inalloca_frame_from_args(self, args: rawptr, argc: i32) -> rawptr {
        if (args == null || argc < 1) { return null; }
        return ast_read_rawptr(ptr_offset(args, (argc - 1) * 8));
    }

    public fn dci_store_packed_inalloca_value(self,
                                              function_id: i32,
                                              source_index: i32,
                                              args: rawptr,
                                              argc: i32,
                                              value_id: i32,
                                              type_id: i32) -> bool {
        let frame = self.dci_packed_inalloca_frame_from_args(args, argc);
        let dest = self.dci_inalloca_frame_field_ptr(function_id, frame, source_index);
        if (dest == null) {
            self.report_error("cannot address packed DCI inalloca field #"
                      + source_index.toString()
                      + " of `" + self.m.function_name(function_id) + "`");
            return false;
        }
        return self.copy_value_storage_to_addr(dest,
                                               value_id,
                                               type_id,
                                               "packed DCI inalloca of `"
                                               + self.m.function_name(function_id) + "`");
    }

    public fn dci_store_packed_inalloca_pointer(self,
                                                function_id: i32,
                                                source_index: i32,
                                                args: rawptr,
                                                argc: i32,
                                                src_ptr: rawptr,
                                                type_id: i32) -> bool {
        let frame = self.dci_packed_inalloca_frame_from_args(args, argc);
        let dest = self.dci_inalloca_frame_field_ptr(function_id, frame, source_index);
        let size_bytes = self.value_storage_size(type_id);
        if (dest == null || src_ptr == null || size_bytes <= 0) {
            self.report_error("cannot copy packed DCI inalloca pointer field #"
                      + source_index.toString()
                      + " of `" + self.m.function_name(function_id) + "`");
            return false;
        }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return false;
        }
        let copied = vyx_rt_build_call3(self.mod,
                                        self.builtin_memcpy_fty,
                                        self.builtin_memcpy_fn,
                                        dest,
                                        src_ptr,
                                        vyx_rt_const_int(self.mod, self.ty_i64, size_bytes, 0),
                                        llvm_mir_empty_name(),
                                        0);
        if (copied == null) {
            self.report_error("cannot memcpy packed DCI inalloca field #"
                      + source_index.toString()
                      + " of `" + self.m.function_name(function_id) + "`");
            return false;
        }
        return true;
    }

    public fn dci_source_param_llvm_slots(self, function_id: i32, source_index: i32) -> i32 {
        if (!self.function_is_foreign_dci(function_id)) { return 1; }
        let lowering = self.dci_source_parameter_abi(function_id, source_index);
        if (self.dci_abi_passing(lowering) == "inalloca"
            && self.dci_function_inalloca_count(function_id) > 1) {
            return 0;
        }
        if (self.dci_abi_passing(lowering) != "split") { return 1; }
        let n = self.dci_register_count(lowering);
        if (n > 0) { return n; }
        return 1;
    }

    public fn dci_split_contract_supported(self,
                                            type_id: i32,
                                            lowering: rawptr,
                                            context: string) -> bool {
        let n = self.dci_register_count(lowering);
        if (n < 2) {
            self.report_error("DCI split ABI requires compiler LLVM types for " + context);
            return false;
        }
        var i: i32 = 0;
        while (i < n) {
            if (self.dci_llvm_type_for_token(self.dci_register_token_at(lowering, i)) == null) {
                self.report_error("DCI split ABI has an unsupported LLVM type for " + context);
                return false;
            }
            if (self.dci_register_offset_at(lowering, i) < 0) {
                self.report_error("DCI split ABI requires register_offsets from the Descriptor for " + context);
                return false;
            }
            i = i + 1;
        }
        let storage_type = self.lower_storage_type(type_id);
        if (storage_type == null) {
            self.report_error("cannot lower DCI ABI storage type for " + context);
            return false;
        }
        let size_item = self.dci_json_item(lowering, "size");
        if (size_item == null || cJSON_IsNumber(size_item) == 0) {
            self.report_error("DCI split ABI requires a positive byte size for " + context);
            return false;
        }
        let errs = self.error_count;
        let declared_size = self.dci_json_number_item_i64(size_item, "split ABI size for " + context);
        if (self.error_count > errs) { return false; }
        let storage_size = vyx_rt_type_alloc_size(self.mod, storage_type);
        if (storage_size <= 0 || declared_size != storage_size) {
            self.report_error("DCI split ABI size mismatch for " + context
                      + ": descriptor=" + declared_size.toString()
                      + " storage=" + storage_size.toString());
            return false;
        }
        return true;
    }

    public fn dci_coerce_contract_supported(self,
                                             type_id: i32,
                                             lowering: rawptr,
                                             context: string) -> bool {
        let storage_type = self.lower_storage_type(type_id);
        let coerce_type = self.dci_abi_coerce_type(lowering);
        if (storage_type == null || coerce_type == null) {
            self.report_error("DCI coerce contract has an unsupported type for " + context);
            return false;
        }
        let storage_size = vyx_rt_type_alloc_size(self.mod, storage_type);
        let coerce_size = vyx_rt_type_alloc_size(self.mod, coerce_type);
        if (storage_size <= 0 || coerce_size <= 0 || storage_size != coerce_size) {
            self.report_error("DCI coerce size mismatch for " + context
                      + ": storage=" + storage_size.toString()
                      + " coerce=" + coerce_size.toString());
            return false;
        }
        let declared_size_item = self.dci_json_item(lowering, "size");
        if (declared_size_item == null || cJSON_IsNumber(declared_size_item) == 0) {
            self.report_error("DCI coerce ABI requires a positive byte size for " + context);
            return false;
        }
        let errs = self.error_count;
        let declared_size = self.dci_json_number_item_i64(declared_size_item, "coerce ABI size for " + context);
        if (self.error_count > errs) { return false; }
        if (declared_size < 1 || declared_size > 2147483647 || declared_size != storage_size) {
            self.report_error("DCI coerce declared size mismatch for " + context
                      + ": descriptor=" + declared_size.toString()
                      + " storage=" + storage_size.toString());
            return false;
        }
        return true;
    }

    public fn dci_link_name_for_function(self, function_id: i32) -> string {
        if (!mir_unit_has_dci_abi(&self.m) || function_id == mir_id_invalid()) { return ""; }
        let cached = llvm_mir_map_get(self.dci_symbol_name_cache, function_id);
        if (cached != null) { return from_cstr(cached); }
        var best_symbol: string = "";
        let best = self.dci_symbol_object_for_function(function_id);
        if (best != null) { best_symbol = self.dci_symbol_link_name(best); }
        llvm_mir_map_put(self.dci_symbol_name_cache, function_id, ast_dup_c_string(best_symbol.clone()));
        return best_symbol;
    }

    public fn dci_function_is_no_unwind(self, function_id: i32) -> bool {
        let sym = self.dci_symbol_object_for_function(function_id);
        let boundary = self.dci_symbol_control_flow_boundary(sym);
        // `translated` is machine-level no-unwind: the producer converts a failing
        // control flow into a value via the declared translator before crossing,
        // so no foreign unwind is ever allowed to propagate through Vyx frames.
        return boundary == "forbidden" || boundary == "no_unwind" || boundary == "abort"
            || boundary == "translated";
    }

    public fn dci_module_default_shared_abi(self) -> bool {
        if (!mir_unit_has_dci_abi(&self.m)) { return false; }
        let control = self.dci_json_item(self.dci_json(), "control_flow");
        let boundary = self.dci_control_flow_boundary(control);
        let mode = self.dci_json_string(self.dci_json_item(control, "propagation"), "mode");
        return boundary == "shared_abi" || mode == "shared_abi";
    }

    public fn dci_personality_symbol(self) -> string {
        var triple = self.target_triple;
        if (triple.len == 0) {
            triple = self.dci_descriptor_target_triple(self.dci_json());
        }
        if (triple.contains("windows") && triple.contains("msvc")) {
            return "__CxxFrameHandler3";
        }
        return "__gxx_personality_v0";
    }

    public fn apply_dci_unwind_attrs(self, function_id: i32, function_value: rawptr) {
        if (function_value == null) { return; }
        let foreign = self.function_is_foreign_dci(function_id);
        let has_body = self.m.function_first_block(function_id) != mir_id_invalid();
        var shared = false;
        if (foreign) {
            shared = self.dci_symbol_control_flow_boundary(
                self.dci_symbol_object_for_function(function_id)) == "shared_abi";
        } elif (has_body) {
            shared = self.dci_module_default_shared_abi();
        }
        if (shared) {
            // LLVM forbids personality on declarations. Foreign shared_abi
            // callees stay declarations; host functions become definitions.
            if (!foreign) {
                let pname = self.dci_personality_symbol();
                vyx_rt_set_function_attr(self.mod,
                                         function_value,
                                         "personality".c_str(),
                                         11,
                                         pname.c_str(),
                                         pname.len as u64);
            }
            vyx_rt_set_function_attr(self.mod,
                                     function_value,
                                     "uwtable".c_str(),
                                     7,
                                     "".c_str(),
                                     0);
            return;
        }
        if (has_body || (foreign && self.dci_function_is_no_unwind(function_id))) {
            vyx_rt_set_function_attr(self.mod,
                                     function_value,
                                     "nounwind".c_str(),
                                     8,
                                     "".c_str(),
                                     0);
        }
    }

    public fn dci_caller_participates_in_shared_unwind(self) -> bool {
        if (self.current_function_id == mir_id_invalid()) { return false; }
        if (self.function_is_foreign_dci(self.current_function_id)) { return false; }
        return self.dci_module_default_shared_abi();
    }

    public fn dci_call_needs_invoke(self, callee_function_id: i32) -> bool {
        if (!self.dci_caller_participates_in_shared_unwind()) { return false; }
        if (callee_function_id == mir_id_invalid()) { return false; }
        if (self.dci_function_is_no_unwind(callee_function_id)) { return false; }
        return true;
    }

    public fn build_abi_call(self,
                             fty: rawptr,
                             fn_value: rawptr,
                             args: rawptr,
                             argc: u64,
                             name: string,
                             callee_function_id: i32) -> rawptr {
        if (self.dci_caller_participates_in_shared_unwind() && callee_function_id != mir_id_invalid()) {
            let drop = llvm_unwind_drop_for_type(&self.m, self.current_function_id,
                                                 self.m.function_return_type(callee_function_id));
            if (drop != mir_id_invalid()) { self.declare_function_signature(drop); }
        }
        return llvm_unwind_build_call(&self.m, self.current_function_id, callee_function_id,
                                       self.mod, fty, fn_value, args, argc, name,
                                       self.dci_call_needs_invoke(callee_function_id),
                                       self.dci_caller_participates_in_shared_unwind(),
                                       self.function_values, self.function_types,
                                       self.builtin_free_fty, self.builtin_free_fn);
    }

    public fn dci_hidden_parameters_supported(self, function_id: i32) -> bool {
        let abi = self.dci_symbol_abi_object(function_id);
        if (abi == null) { return true; }
        let hidden = self.dci_json_item(abi, "hidden_parameters");
        let expected_sret = self.dci_function_uses_sret(function_id);
        if (hidden == null) { return true; }
        if (cJSON_IsArray(hidden) == 0) {
            self.report_error("DCI hidden_parameters must be an array for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        var expected_count: i32 = 0;
        if (expected_sret) { expected_count = 1; }
        if (cJSON_GetArraySize(hidden) != expected_count) {
            self.report_error("unsupported DCI hidden parameter contract for `"
                      + self.m.function_name(function_id) + "`");
            return false;
        }
        if (expected_sret) {
            let item = cJSON_GetArrayItem(hidden, 0);
            if (self.dci_abi_passing(item) != "sret") {
                self.report_error("DCI only supports an sret hidden parameter for `"
                          + self.m.function_name(function_id) + "`");
                return false;
            }
        }
        return true;
    }

    public fn apply_dci_function_abi_attrs(self, function_id: i32, function_value: rawptr) -> bool {
        if (function_value == null || !self.function_is_foreign_dci(function_id)) { return true; }
        if (!self.dci_abi_parameters_complete(function_id)) { return false; }
        if (!self.dci_hidden_parameters_supported(function_id)) { return false; }
        let symbol = self.dci_symbol_object_for_function(function_id);
        let cc = self.dci_symbol_calling_convention(symbol);
        if (cc.len > 0
            && vyx_rt_set_calling_convention(self.mod,
                                             function_value,
                                             cc.c_str(),
                                             cc.len as u64) != 0) {
            self.report_error("cannot apply DCI calling convention `" + cc + "` to `"
                      + self.m.function_name(function_id) + "`: " + self.runtime_last_error());
            return false;
        }
        var llvm_index: i32 = 0;
        let member_sret_after = self.dci_member_sret_after_receiver(function_id);
        if (self.dci_function_uses_sret(function_id)) {
            let return_type = self.m.function_return_type(function_id);
            var pointee_type = self.lower_storage_type(return_type);
            if (self.dci_call_converts_translated_to_result(function_id)) {
                pointee_type = self.dci_translated_sret_ty(function_id);
            }
            let alignment = self.dci_json_i64(self.dci_return_abi(function_id), "alignment");
            var sret_index: i32 = 0;
            if (member_sret_after) { sret_index = 1; }
            if (pointee_type == null
                || vyx_rt_set_param_abi_attr(self.mod,
                                             function_value,
                                             sret_index as u64,
                                             "sret".c_str(),
                                             4,
                                             pointee_type,
                                             alignment as u64) != 0) {
                self.report_error("cannot apply DCI sret ABI to `" + self.m.function_name(function_id)
                          + "`: " + self.runtime_last_error());
                return false;
            }
            if (member_sret_after) {
                llvm_index = 0;
            } else {
                llvm_index = 1;
            }
        }
        if (self.function_uses_c_main_abi(function_id)) { llvm_index = llvm_index + 2; }
        llvm_index = llvm_index + self.function_hidden_env_param_count(function_id);
        if (self.function_is_foreign_dci_ctor(function_id)) { llvm_index = llvm_index + 1; }
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            let lowering = self.dci_source_parameter_abi(function_id, source_index);
            let passing = self.dci_abi_passing(lowering);
            if (passing == "inalloca" && self.dci_function_inalloca_count(function_id) > 1) {
            } else if (passing == "byval" || passing == "inalloca") {
                let source_type = self.function_source_param_type(function_id, source_index);
                let pointee = self.lower_storage_type(source_type);
                let param_alignment = self.dci_json_i64(lowering, "alignment");
                var attr = "byval";
                if (passing == "inalloca") { attr = "inalloca"; }
                if (pointee == null
                    || vyx_rt_set_param_abi_attr(self.mod,
                                                 function_value,
                                                 llvm_index as u64,
                                                 attr.c_str(),
                                                 attr.len as u64,
                                                 pointee,
                                                 param_alignment as u64) != 0) {
                    self.report_error("cannot apply DCI " + passing + " ABI to parameter #"
                              + source_index.toString() + " of `" + self.m.function_name(function_id)
                              + "`: " + self.runtime_last_error());
                    return false;
                }
            } else if (passing == "indirect") {
                let param_alignment2 = self.dci_json_i64(lowering, "alignment");
                if (param_alignment2 > 0
                    && vyx_rt_set_param_abi_attr(self.mod,
                                                 function_value,
                                                 llvm_index as u64,
                                                 "align".c_str(),
                                                 5,
                                                 null,
                                                 param_alignment2 as u64) != 0) {
                    self.report_error("cannot apply DCI indirect alignment to parameter #"
                              + source_index.toString() + " of `" + self.m.function_name(function_id)
                              + "`: " + self.runtime_last_error());
                    return false;
                }
            }
            llvm_index = llvm_index + self.dci_source_param_llvm_slots(function_id, source_index);
            source_index = source_index + 1;
        }
        if (self.dci_function_inalloca_count(function_id) > 1) {
            if (!self.dci_apply_packed_inalloca_attr(function_id,
                                                     function_value,
                                                     llvm_index,
                                                     "on definition")) {
                return false;
            }
        }
        return true;
    }

    public fn apply_dci_callsite_abi_attrs(self, function_id: i32, call_value: rawptr) -> bool {
        if (call_value == null || !self.function_is_foreign_dci(function_id)) { return true; }
        var llvm_index: i32 = 0;
        let member_sret_after = self.dci_member_sret_after_receiver(function_id);
        if (self.dci_function_uses_sret(function_id)) {
            let return_type = self.m.function_return_type(function_id);
            var pointee_type = self.lower_storage_type(return_type);
            if (self.dci_call_converts_translated_to_result(function_id)) {
                pointee_type = self.dci_translated_sret_ty(function_id);
            }
            let alignment = self.dci_json_i64(self.dci_return_abi(function_id), "alignment");
            var sret_index: i32 = 0;
            if (member_sret_after) { sret_index = 1; }
            if (pointee_type == null
                || vyx_rt_set_param_abi_attr(self.mod,
                                             call_value,
                                             sret_index as u64,
                                             "sret".c_str(),
                                             4,
                                             pointee_type,
                                             alignment as u64) != 0) {
                self.report_error("cannot apply DCI sret ABI at callsite for `"
                          + self.m.function_name(function_id) + "`: " + self.runtime_last_error());
                return false;
            }
            if (member_sret_after) {
                llvm_index = 0;
            } else {
                llvm_index = 1;
            }
        }
        llvm_index = llvm_index + self.function_hidden_env_param_count(function_id);
        if (self.function_is_foreign_dci_ctor(function_id)) { llvm_index = llvm_index + 1; }
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            let lowering = self.dci_source_parameter_abi(function_id, source_index);
            let passing = self.dci_abi_passing(lowering);
            if (passing == "inalloca" && self.dci_function_inalloca_count(function_id) > 1) {
            } else if (passing == "byval" || passing == "inalloca") {
                let source_type = self.function_source_param_type(function_id, source_index);
                let pointee = self.lower_storage_type(source_type);
                let param_alignment = self.dci_json_i64(lowering, "alignment");
                var attr = "byval";
                if (passing == "inalloca") { attr = "inalloca"; }
                if (pointee == null
                    || vyx_rt_set_param_abi_attr(self.mod,
                                                 call_value,
                                                 llvm_index as u64,
                                                 attr.c_str(),
                                                 attr.len as u64,
                                                 pointee,
                                                 param_alignment as u64) != 0) {
                    self.report_error("cannot apply DCI " + passing
                              + " ABI at callsite to parameter #"
                              + source_index.toString() + " of `" + self.m.function_name(function_id)
                              + "`: " + self.runtime_last_error());
                    return false;
                }
            } else if (passing == "indirect") {
                let param_alignment2 = self.dci_json_i64(lowering, "alignment");
                if (param_alignment2 > 0
                    && vyx_rt_set_param_abi_attr(self.mod,
                                                 call_value,
                                                 llvm_index as u64,
                                                 "align".c_str(),
                                                 5,
                                                 null,
                                                 param_alignment2 as u64) != 0) {
                    self.report_error("cannot apply DCI indirect alignment at callsite to parameter #"
                              + source_index.toString() + " of `" + self.m.function_name(function_id)
                              + "`: " + self.runtime_last_error());
                    return false;
                }
            }
            llvm_index = llvm_index + self.dci_source_param_llvm_slots(function_id, source_index);
            source_index = source_index + 1;
        }
        if (self.dci_function_inalloca_count(function_id) > 1) {
            if (!self.dci_apply_packed_inalloca_attr(function_id,
                                                     call_value,
                                                     llvm_index,
                                                     "at callsite")) {
                return false;
            }
        }
        return true;
    }

    public fn apply_native_c_aggregate_abi_attrs(self, function_id: i32, fn_or_call: rawptr) -> bool {
        if (fn_or_call == null) { return false; }
        if (self.function_is_foreign_dci(function_id)) { return true; }
        var llvm_index: i32 = 0;
        if (self.function_uses_hidden_sret(function_id)) {
            let return_type = self.m.function_return_type(function_id);
            let pointee_type = self.lower_storage_type(return_type);
            let alignment = self.native_aggregate_align_bytes(return_type);
            if (pointee_type == null
                || vyx_rt_set_param_abi_attr(self.mod,
                                             fn_or_call,
                                             0,
                                             "sret".c_str(),
                                             4,
                                             pointee_type,
                                             alignment) != 0) {
                self.report_error("cannot apply native sret ABI to `"
                          + self.m.function_name(function_id)
                          + "`: " + self.runtime_last_error());
                return false;
            }
            llvm_index = 1;
        }
        if (self.function_uses_c_main_abi(function_id)) { llvm_index = llvm_index + 2; }
        llvm_index = llvm_index + self.function_hidden_env_param_count(function_id);
        var source_index: i32 = 0;
        while (source_index < self.function_source_param_count(function_id)) {
            if (self.source_param_uses_native_byval_abi(function_id, source_index)) {
                let source_type = self.function_source_param_type(function_id, source_index);
                let pointee = self.lower_storage_type(source_type);
                let param_alignment = self.native_aggregate_align_bytes(source_type);
                if (pointee == null
                    || vyx_rt_set_param_abi_attr(self.mod,
                                                 fn_or_call,
                                                 llvm_index as u64,
                                                 "byval".c_str(),
                                                 5,
                                                 pointee,
                                                 param_alignment) != 0) {
                    self.report_error("cannot apply native byval ABI to parameter #"
                              + source_index.toString() + " of `" + self.m.function_name(function_id)
                              + "`: " + self.runtime_last_error());
                    return false;
                }
            }
            llvm_index = llvm_index + 1;
            source_index = source_index + 1;
        }
        return true;
    }

    public fn function_uses_dci_virtual_dispatch(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (!self.function_is_foreign_dci_instance_method(function_id)) { return false; }
        if (self.function_is_foreign_dci_dtor(function_id)) { return false; }
        if (self.function_is_foreign_dci_final_method(function_id)) { return false; }
        return self.function_is_foreign_dci_virtual_method(function_id)
            || self.function_is_foreign_dci_override_method(function_id);
    }

    public fn dci_call_receiver_is_exact_value_object(self, value_id: i32, function_id: i32) -> bool {
        if (value_id == mir_id_invalid() || function_id == mir_id_invalid()) { return false; }
        let receiver_id = self.direct_call_receiver(value_id);
        if (receiver_id == mir_id_invalid()) { return false; }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        if (receiver_kind == ty_PTR() || receiver_kind == ty_REF() || receiver_kind == ty_MUTREF()) {
            return false;
        }
        let target_self_type = self.function_source_param_type(function_id, 0);
        if (target_self_type == mir_id_invalid()) { return false; }
        if (self.canonical_record_type_id(receiver_type) == self.canonical_record_type_id(target_self_type)) {
            return true;
        }
        return false;
    }

    public fn dci_direct_method_this_base_offset_bytes(self, function_id: i32) -> i64 {
        if (function_id == mir_id_invalid()) { return 0; }
        if (!self.function_is_foreign_dci_instance_method(function_id)) { return 0; }
        if (self.function_is_foreign_dci_ctor(function_id) || self.function_is_foreign_dci_dtor(function_id)) {
            return 0;
        }
        if (!self.function_is_foreign_dci_override_method(function_id)) { return 0; }
        let owner_type = self.foreign_dci_owner_type_id(function_id);
        var owner_record = "";
        if (owner_type != mir_id_invalid()) {
            owner_record = self.dci_record_name_for_type(owner_type);
        }
        if (owner_record.len == 0) {
            owner_record = self.dci_record_name_for_type_text(self.foreign_dci_owner_type_text(function_id));
        }
        if (owner_record.len == 0) { return 0; }
        let selected = self.dci_symbol_object_for_function(function_id);
        if (selected == null) { return -1; }
        var base_offset: i64 = 0;
        var base_found = false;
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let symbols = self.dci_exports_array_from(self.dci_contract_at(root_i), "symbols");
            if (symbols != null) {
            let n = cJSON_GetArraySize(symbols);
            var i: i32 = 0;
            while (i < n) {
                let candidate = cJSON_GetArrayItem(symbols, i);
                if (candidate != null && cJSON_IsObject(candidate) != 0
                    && self.dci_json_string(candidate, "kind") == "method"
                    && self.dci_json_bool(candidate, "is_virtual")
                    && self.dci_symbol_member_name_matches_function(candidate, function_id)
                    && self.dci_symbol_params_match_function(self.dci_json_item(candidate, "params"), function_id)
                    && self.dci_symbol_return_matches_function(candidate, function_id)
                    && self.dci_symbol_flags_match_function(candidate, function_id)) {
                    var candidate_owner = self.dci_json_string(candidate, "owner");
                    let normalized_owner = self.dci_record_name_for_type_text(candidate_owner);
                    if (normalized_owner.len > 0) { candidate_owner = normalized_owner; }
                    if (candidate_owner.len > 0
                        && !self.dci_record_name_matches_text(candidate_owner, owner_record)) {
                        let candidate_offset = self.dci_base_offset_bytes_for_records(owner_record,
                                                                                       candidate_owner,
                                                                                       0);
                        if (candidate_offset < 0) {
                            self.report_error("DCI direct override `" + self.m.function_name(function_id)
                                      + "` requires a non-constant receiver adjustment; use virtual dispatch or Stub mode");
                            return -1;
                        }
                        if (base_found && base_offset != candidate_offset) {
                            self.report_error("DCI direct override `" + self.m.function_name(function_id)
                                      + "` has ambiguous receiver adjustments; use virtual dispatch or Stub mode");
                            return -1;
                        }
                        base_offset = candidate_offset;
                        base_found = true;
                    }
                }
                i = i + 1;
            }
            }
            root_i = root_i + 1;
        }
        let this_adjust_item = self.dci_json_item(selected, "this_adjust");
        if (this_adjust_item == null) { return base_offset; }
        if (cJSON_IsNumber(this_adjust_item) == 0) {
            self.report_error("DCI direct override `" + self.m.function_name(function_id)
                      + "` has a non-numeric receiver adjustment");
            return -1;
        }
        let errs = self.error_count;
        let this_adjust = self.dci_json_number_item_i64(this_adjust_item, "this_adjust");
        if (self.error_count > errs) { return -1; }
        if (this_adjust < -2147483648 || this_adjust > 2147483647) {
            self.report_error("DCI direct override `" + self.m.function_name(function_id)
                      + "` receiver adjustment is outside the supported range");
            return -1;
        }
        return base_offset + this_adjust;
    }

    public fn adjust_dci_direct_method_receiver(self,
                                                receiver_val: rawptr,
                                                function_id: i32,
                                                label: string) -> rawptr {
        if (receiver_val == null) { return null; }
        let offset = self.dci_direct_method_this_base_offset_bytes(function_id);
        if (offset < 0) { return null; }
        if (offset == 0) { return receiver_val; }
        return self.ptr_offset_bytes(receiver_val,
                                     vyx_rt_const_int(self.mod, self.ty_i64, offset, 1),
                                     label);
    }

    public fn dci_vtable_entry_slot_offset_for_function(self, function_id: i32) -> i64 {
        if (function_id == mir_id_invalid()) { return -1; }
        let symbol = self.dci_link_name_for_function(function_id);
        if (symbol.len == 0) { return -1; }
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let vtables = self.dci_dispatch_tables_from(self.dci_contract_at(root_i));
            if (vtables != null) {
        let vt_count = cJSON_GetArraySize(vtables);
        var vt_i: i32 = 0;
        while (vt_i < vt_count) {
            let vt = cJSON_GetArrayItem(vtables, vt_i);
            if (vt != null && cJSON_IsObject(vt) != 0) {
                let ap_obj = self.dci_json_item(vt, "address_point_offset");
                if (ap_obj == null || cJSON_IsNumber(ap_obj) == 0) {
                    self.report_error("DCI vtable for `" + self.dci_json_string(vt, "class_name")
                               + "` has no address_point_offset");
                    return -1;
                }
                let errs = self.error_count;
                let address_point = self.dci_json_number_item_i64(ap_obj, "address_point_offset");
                if (self.error_count > errs) { return -1; }
                let entries = self.dci_json_item(vt, "entries");
                if (entries != null && cJSON_IsArray(entries) != 0) {
                    let entry_count = cJSON_GetArraySize(entries);
                    var entry_i: i32 = 0;
                    while (entry_i < entry_count) {
                        let entry = cJSON_GetArrayItem(entries, entry_i);
                        if (entry != null
                            && cJSON_IsObject(entry) != 0
                            && self.dci_symbol_link_name(entry) == symbol) {
                            if (self.dci_json_i64(entry, "this_adjust") != 0
                                || self.dci_json_i64(entry, "return_adjust") != 0) {
                                self.report_error("DCI dispatch entry for `"
                                          + self.m.function_name(function_id)
                                          + "` requires an unsupported call adjustment");
                                return -1;
                            }
                            let relative = self.dci_json_item(entry, "address_point_relative_offset");
                            if (relative != null && cJSON_IsNumber(relative) != 0) {
                                let rel_errs = self.error_count;
                                let rel = self.dci_json_number_item_i64(relative, "address_point_relative_offset");
                                if (self.error_count > rel_errs) { return -1; }
                                return rel;
                            }
                            return self.dci_json_i64(entry, "offset") - address_point;
                        }
                        entry_i = entry_i + 1;
                    }
                }
            }
            vt_i = vt_i + 1;
        }
            }
            root_i = root_i + 1;
        }
        return -1;
    }

    public fn dci_vtable_base_offset_bytes_for_function(self,
                                                        function_id: i32,
                                                        receiver_type_id: i32) -> i64 {
        if (function_id == mir_id_invalid()) { return -1; }
        let symbol = self.dci_link_name_for_function(function_id);
        if (symbol.len == 0) { return -1; }
        let receiver_record_type = self.canonical_record_type_id(receiver_type_id);
        let receiver_record = self.dci_record_name_for_type(receiver_record_type);
        var root_i: i32 = 0;
        let root_n = self.dci_contract_count();
        while (root_i < root_n) {
            let vtables = self.dci_dispatch_tables_from(self.dci_contract_at(root_i));
            if (vtables != null) {
        let vt_count = cJSON_GetArraySize(vtables);
        var vt_i: i32 = 0;
        while (vt_i < vt_count) {
            let vt = cJSON_GetArrayItem(vtables, vt_i);
            if (vt != null && cJSON_IsObject(vt) != 0) {
                let entries = self.dci_json_item(vt, "entries");
                if (entries != null && cJSON_IsArray(entries) != 0) {
                    let entry_count = cJSON_GetArraySize(entries);
                    var entry_i: i32 = 0;
                    while (entry_i < entry_count) {
                        let entry = cJSON_GetArrayItem(entries, entry_i);
                        if (entry != null
                            && cJSON_IsObject(entry) != 0
                            && self.dci_symbol_link_name(entry) == symbol) {
                            let base_class = self.dci_json_string(vt, "base_class");
                            let vt_class = self.dci_json_string(vt, "class_name");
                            // An omitted base has no describable adjustment.  It is only
                            // safe when the receiver is exactly the dispatch-table class.
                            if (base_class.len == 0) {
                                if (receiver_record.len > 0
                                    && self.dci_record_name_matches_text(receiver_record, vt_class)) {
                                    return 0;
                                }
                                self.report_error("DCI dispatch-table receiver adjustment is not statically described");
                                return -1;
                            }
                            if (receiver_record.len > 0) {
                                if (self.dci_record_name_matches_text(receiver_record, base_class)) {
                                    return 0;
                                }
                                let receiver_offset = self.dci_base_offset_bytes_for_records(receiver_record,
                                                                                            base_class,
                                                                                            0);
                                if (receiver_offset >= 0) { return receiver_offset; }
                            }
                            let vt_offset = self.dci_base_offset_bytes_for_records(vt_class, base_class, 0);
                            if (vt_offset >= 0) { return vt_offset; }
                            return -1;
                        }
                        entry_i = entry_i + 1;
                    }
                }
            }
            vt_i = vt_i + 1;
        }
            }
            root_i = root_i + 1;
        }
        return -1;
    }

    public fn type_uses_closed_template_record_layout(self,
                                                      concrete_type_id: i32,
                                                      template_type_id: i32) -> bool {
        if (concrete_type_id == mir_id_invalid() || template_type_id == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, concrete_type_id) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, template_type_id) != ty_CLASS()) {
            return false;
        }
        if (!self.record_layout_fields_are_closed(template_type_id)) { return false; }
        let concrete_text = llvm_mir_type_text(&self.m, concrete_type_id);
        let template_text = llvm_mir_type_text(&self.m, template_type_id);
        if (concrete_text.len == 0 || template_text.len == 0) { return false; }
        if (policy_generic_call_has_args(concrete_text.clone()) == 0) { return false; }
        if (policy_generic_call_has_args(template_text.clone()) != 0) { return false; }
        let concrete_base = policy_generic_call_base(concrete_text.clone());
        return self.type_text_equivalent(concrete_base, template_text);
    }

    public fn field_owner_accepts_base_type(self, field_owner_type: i32, base_type_id: i32) -> bool {
        if (field_owner_type == mir_id_invalid() || base_type_id == mir_id_invalid()) { return false; }
        let cached = self.pair_bool_cache_get(self.field_owner_accept_cache, field_owner_type, base_type_id);
        if (cached != 0) { return cached == 2; }
        var result = false;
        if (self.type_ids_compatible(field_owner_type, base_type_id)) { result = true; }
        let canonical_owner = self.canonical_record_type_id(field_owner_type);
        let canonical_base = self.canonical_record_type_id(base_type_id);
        if (!result && self.type_ids_compatible(canonical_owner, canonical_base)) { result = true; }
        if (!result && self.record_layout_prefix_compatible(canonical_base, canonical_owner)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(base_type_id, field_owner_type)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(base_type_id, canonical_owner)) { result = true; }
        if (!result && self.type_uses_closed_template_record_layout(canonical_base, canonical_owner)) { result = true; }
        var state: i32 = 1;
        if (result) { state = 2; }
        self.pair_bool_cache_put(self.field_owner_accept_cache, field_owner_type, base_type_id, state);
        return result;
    }

    public fn exact_field_id_for_type_name(self, type_id: i32, field_name: string) -> i32 {
        if (type_id == mir_id_invalid() || field_name.len == 0) { return mir_id_invalid(); }
        var found = mir_id_invalid();
        var field_id: i32 = 1;
        while (field_id <= self.m.field_count) {
            if (mir_unit_field_owner_type(&self.m, field_id) == type_id
                && mir_unit_field_name(&self.m, field_id) == field_name) {
                // Versioned layouts keep historical FieldIds alive.  The
                // later matching record belongs to the canonical/current
                // layout and therefore carries the correct current slot.
                found = field_id;
            }
            field_id = field_id + 1;
        }
        return found;
    }

    public fn resolve_field_for_base_type(self, base_type_id: i32, field_id: i32) -> i32 {
        if (base_type_id == mir_id_invalid() || field_id == mir_id_invalid()) { return mir_id_invalid(); }
        let field_name = mir_unit_field_name(&self.m, field_id);
        if (field_name.len == 0) { return field_id; }
        let exact_base = self.exact_field_id_for_type_name(base_type_id, field_name);
        if (exact_base != mir_id_invalid()) { return exact_base; }
        let canonical_base = self.canonical_record_type_id(base_type_id);
        let exact_canonical = self.exact_field_id_for_type_name(canonical_base, field_name);
        if (exact_canonical != mir_id_invalid()) { return exact_canonical; }
        let owner_type = mir_unit_field_owner_type(&self.m, field_id);
        if (self.field_owner_accepts_base_type(owner_type, base_type_id)
            || self.field_owner_accepts_base_type(owner_type, canonical_base)) {
            return field_id;
        }
        return mir_id_invalid();
    }

    // Cached front-end for resolve_field_for_base_type. Field remapping is a
    // pure function of (base_type_id, field_id) over immutable unit tables and
    // is queried per lowered instruction, so memoize it: the cache is indexed
    // by field_id and each entry is a small chain of
    // { base_type_id: i32, mapped_field_id: i32, next: ptr } nodes.
    public fn remapped_field_for_base(self, base_type_id: i32, field_id: i32) -> i32 {
        if (base_type_id == mir_id_invalid() || field_id == mir_id_invalid()) { return mir_id_invalid(); }
        let head = llvm_mir_map_get(self.field_remap_cache, field_id);
        var cur = head;
        while (cur != null) {
            if (ast_read_i32(cur) == base_type_id) { return ast_read_i32(ptr_offset(cur, 4)); }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let mapped = self.resolve_field_for_base_type(base_type_id, field_id);
        let node = malloc(16);
        if (node != null) {
            ast_write_i32(node, base_type_id);
            ast_write_i32(ptr_offset(node, 4), mapped);
            ast_write_rawptr(ptr_offset(node, 8), head);
            llvm_mir_map_put(self.field_remap_cache, field_id, node);
        }
        return mapped;
    }

    // Pure-type twin of lower_place_addr's field mapping pipeline: refine the
    // base place type, remap the FieldId onto it, apply the heap-indirect
    // rebase, then remap once more against the canonical layout. Emits no IR,
    // so place_effective_type can use it to answer type queries for
    // multi-level field chains (a.b.c) without touching codegen state.
    public fn mapped_field_id_for_place(self, place_id: i32) -> i32 {
        if (place_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.m.place_kind(place_id) != mir_place_field()) { return mir_id_invalid(); }
        var field_id = self.m.place_field(place_id);
        if (field_id == mir_id_invalid()) { return mir_id_invalid(); }
        var field_base_type = self.place_effective_type(self.m.place_base(place_id));
        if (field_base_type == mir_id_invalid()) { return field_id; }
        let mapped = self.remapped_field_for_base(field_base_type, field_id);
        if (mapped != mir_id_invalid()) { field_id = mapped; }
        let field_owner_type = mir_unit_field_owner_type(&self.m, field_id);
        if (field_owner_type != mir_id_invalid()
            && !self.field_owner_accepts_base_type(field_owner_type, field_base_type)) {
            if (!self.heap_indirect_payload_matches(field_base_type, field_owner_type)) {
                return field_id;
            }
            field_base_type = field_owner_type;
        }
        let canonical_base = self.canonical_record_type_id(field_base_type);
        let mapped2 = self.remapped_field_for_base(canonical_base, field_id);
        if (mapped2 != mir_id_invalid()) { return mapped2; }
        return field_id;
    }

    public fn record_layout_prefix_compatible(self, derived_type_id: i32, prefix_type_id: i32) -> bool {
        if (derived_type_id == mir_id_invalid() || prefix_type_id == mir_id_invalid()) { return false; }
        let derived_type = self.canonical_record_type_id(derived_type_id);
        let prefix_type = self.canonical_record_type_id(prefix_type_id);
        if (self.type_ids_compatible(derived_type, prefix_type)) { return true; }
        if (llvm_mir_type_kind(&self.m, derived_type) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, prefix_type) != ty_CLASS()) {
            return false;
        }
        let derived_count = mir_unit_field_count_for_type(&self.m, derived_type);
        let prefix_count = mir_unit_field_count_for_type(&self.m, prefix_type);
        if (derived_count <= 0 || prefix_count <= 0 || prefix_count > derived_count) { return false; }
        var idx: i32 = 0;
        while (idx < prefix_count) {
            let derived_field = mir_unit_field_id_for_type_index(&self.m, derived_type, idx);
            let prefix_field = mir_unit_field_id_for_type_index(&self.m, prefix_type, idx);
            if (derived_field == mir_id_invalid() || prefix_field == mir_id_invalid()) { return false; }
            if (mir_unit_field_name(&self.m, derived_field) != mir_unit_field_name(&self.m, prefix_field)) {
                return false;
            }
            if (!self.type_ids_compatible(mir_unit_field_type(&self.m, derived_field),
                                          mir_unit_field_type(&self.m, prefix_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn record_layout_fields_match_at(self,
                                            derived_type: i32,
                                            start: i32,
                                            prefix_type: i32,
                                            prefix_count: i32) -> bool {
        if (derived_type == mir_id_invalid() || prefix_type == mir_id_invalid() || start < 0 || prefix_count <= 0) {
            return false;
        }
        var idx: i32 = 0;
        while (idx < prefix_count) {
            let derived_field = mir_unit_field_id_for_type_index(&self.m, derived_type, start + idx);
            let prefix_field = mir_unit_field_id_for_type_index(&self.m, prefix_type, idx);
            if (derived_field == mir_id_invalid() || prefix_field == mir_id_invalid()) { return false; }
            if (mir_unit_field_name(&self.m, derived_field) != mir_unit_field_name(&self.m, prefix_field)) {
                return false;
            }
            if (!self.type_ids_compatible(mir_unit_field_type(&self.m, derived_field),
                                          mir_unit_field_type(&self.m, prefix_field))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn record_layout_subobject_field_index(self, derived_type_id: i32, prefix_type_id: i32) -> i32 {
        if (derived_type_id == mir_id_invalid() || prefix_type_id == mir_id_invalid()) { return -1; }
        let derived_type = self.canonical_record_type_id(derived_type_id);
        let prefix_type = self.canonical_record_type_id(prefix_type_id);
        if (self.type_ids_compatible(derived_type, prefix_type)) { return 0; }
        if (llvm_mir_type_kind(&self.m, derived_type) != ty_CLASS()
            || llvm_mir_type_kind(&self.m, prefix_type) != ty_CLASS()) {
            return -1;
        }
        let derived_count = mir_unit_field_count_for_type(&self.m, derived_type);
        let prefix_count = mir_unit_field_count_for_type(&self.m, prefix_type);
        if (prefix_count <= 0 || derived_count <= 0 || prefix_count > derived_count) { return -1; }
        var found: i32 = -1;
        var start: i32 = 0;
        while (start + prefix_count <= derived_count) {
            if (self.record_layout_fields_match_at(derived_type, start, prefix_type, prefix_count)) {
                if (found >= 0) { return -1; }
                found = start;
            }
            start = start + 1;
        }
        return found;
    }

    public fn receiver_type_can_use_method_self_type(self, receiver_type_id: i32, method_self_type_id: i32) -> bool {
        if (receiver_type_id == mir_id_invalid() || method_self_type_id == mir_id_invalid()) { return false; }
        if (self.type_ids_compatible(receiver_type_id, method_self_type_id)) { return true; }
        if (self.dci_type_derives_from(receiver_type_id, method_self_type_id)) { return true; }
        if (self.record_layout_prefix_compatible(receiver_type_id, method_self_type_id)) { return true; }
        return self.record_layout_subobject_field_index(receiver_type_id, method_self_type_id) >= 0;
    }

    public fn receiver_method_specificity(self, receiver_type_id: i32, function_id: i32) -> i32 {
        if (receiver_type_id == mir_id_invalid() || function_id == mir_id_invalid()) { return 0; }
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type_id);
        if (receiver_text.len > 0 && self.m.function_owner_type(function_id) == receiver_text) {
            return 3;
        }
        let first_local = self.function_source_param_local(function_id, 0);
        if (first_local == mir_id_invalid()) { return 0; }
        let self_type = self.m.local_type(first_local);
        if (self.type_ids_compatible(receiver_type_id, self_type)) { return 3; }
        if (self.dci_type_derives_from(receiver_type_id, self_type)) { return 1; }
        if (self.record_layout_prefix_compatible(receiver_type_id, self_type)) { return 1; }
        if (self.record_layout_subobject_field_index(receiver_type_id, self_type) >= 0) { return 1; }
        return 0;
    }

    public fn executable_method_for_receiver_type(self, receiver_type_id: i32, method_name: string) -> i32 {
        if (receiver_type_id == mir_id_invalid() || method_name.len == 0) { return mir_id_invalid(); }
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type_id);
        if (receiver_text.len == 0) { return mir_id_invalid(); }
        var best_match = mir_id_invalid();
        var best_exact: i32 = 0;
        var best_specificity: i32 = 0;
        var cur = self.method_candidate_head(method_name);
        while (cur != null) {
            let fn_id = ast_read_i32(cur);
            if (self.function_has_callable_body_or_import(fn_id)
                && self.function_name_matches_method(self.m.function_name(fn_id), method_name)) {
                let specificity = self.receiver_method_specificity(receiver_type_id, fn_id);
                let self_type = self.function_source_param_type(fn_id, 0);
                let exact = ((self_type != mir_id_invalid()
                              && self_type == receiver_type_id)
                             || llvm_mir_type_text(&self.m, self_type) == receiver_text) as i32;
                if (specificity > best_specificity
                    || (specificity == best_specificity && exact > best_exact)) {
                    best_match = fn_id;
                    best_specificity = specificity;
                    best_exact = exact;
                } else if (specificity == best_specificity
                    && exact == best_exact
                    && best_match != mir_id_invalid()
                    && self.function_has_callable_body_or_import(fn_id)
                    && !self.function_has_callable_body_or_import(best_match)) {
                    best_match = fn_id;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return best_match;
    }

    public fn type_uses_self_pointer_abi(self, type_id_raw: i32) -> bool {
        if (type_id_raw == mir_id_invalid()) { return false; }
        let type_id = self.canonical_record_type_id(type_id_raw);
        // Unique rule: method `self` is always a pointer so `self.field` is GEP.
        // ty_STRING() is not ty_CLASS(); without this, `impl` bodies could not
        // GEP `self.ptr` / `self.len`.
        if (self.type_is_str_abi(type_id)) { return true; }
        if (llvm_mir_type_kind(&self.m, type_id) != ty_CLASS()) { return false; }
        if (self.type_is_dyn_trait(type_id)) { return false; }
        return true;
    }

    public fn source_param_uses_self_pointer_abi(self, function_id: i32, source_idx: i32) -> bool {
        if (source_idx != 0) { return false; }
        let local = self.function_source_param_local(function_id, source_idx);
        if (local == mir_id_invalid()) { return false; }
        if (!self.local_is_self_receiver_param(local)) { return false; }
        let flags = self.m.local_flags(local);
        // Explicit Rust-style borrows are pointer ABI even for primitive or
        // value-aggregate impl receivers. This is the ABI-level distinction
        // that lets `&mut self` write through to the caller instead of
        // mutating a copied scalar. Class receivers already use this ABI for
        // compatibility `self` and owning `own self` below.
        if ((flags & mir_local_flag_self_shared_ref()) != 0
            || (flags & mir_local_flag_self_mut_ref()) != 0) {
            return true;
        }
        return self.type_uses_self_pointer_abi(self.local_effective_type(local));
    }

    public fn dci_stub_spec_field(self, line: string, wanted: i32) -> string {
        var start: i32 = 0;
        var field: i32 = 0;
        var i: i32 = 0;
        while (i <= line.len) {
            var split = false;
            if (i == line.len) { split = true; }
            else if (line.charAt(i) == 9) { split = true; }
            if (split) {
                if (field == wanted) { return line.substring(start, i).trim(); }
                field = field + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        return "";
    }

    public fn dci_stub_type_names_match(self, a: string, b: string) -> bool {
        let canonical_a = self.dci_canonical_type_name_text(a);
        let canonical_b = self.dci_canonical_type_name_text(b);
        if (canonical_a == canonical_b) { return true; }
        if (self.type_text_base_is_qualified(canonical_a)
            && self.type_text_base_is_qualified(canonical_b)) {
            return false;
        }
        return self.type_text_equivalent(canonical_a, canonical_b);
    }

    public fn dci_stub_base_for_type_text(self, derived: string) -> string {
        let rows = mir_unit_dci_stub_specs(&self.m);
        let canonical_derived = self.dci_canonical_type_name_text(derived);
        var exact_base = "";
        var exact_count: i32 = 0;
        var fallback_base = "";
        var fallback_count: i32 = 0;
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= rows.len) {
            var split = false;
            if (i == rows.len) { split = true; }
            else if (rows.charAt(i) == 10) { split = true; }
            if (split) {
                let line = rows.substring(start, i).trim();
                if (self.dci_stub_spec_field(line, 0) == "class") {
                    let d = self.dci_stub_spec_field(line, 1);
                    let base = self.dci_stub_spec_field(line, 2);
                    if (self.dci_canonical_type_name_text(d) == canonical_derived) {
                        exact_base = base;
                        exact_count = exact_count + 1;
                    } else if (self.dci_stub_type_names_match(d, derived)) {
                        fallback_base = base;
                        fallback_count = fallback_count + 1;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (exact_count == 1) { return exact_base; }
        if (exact_count == 0 && fallback_count == 1) { return fallback_base; }
        return "";
    }

    public fn type_is_dci_stub_class(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(type_id));
        if (text.len == 0) { return false; }
        return self.dci_stub_base_for_type_text(text).len > 0;
    }

    public fn function_is_dci_vyx_override_callback(self, function_id: i32) -> bool {
        if (function_id == mir_id_invalid()) { return false; }
        if (self.function_is_foreign_dci(function_id)) { return false; }
        if ((mir_unit_function_flags(&self.m, function_id) & hir_function_flag_foreign_dci_override_method()) == 0) {
            return false;
        }
        let owner = self.m.function_owner_type(function_id);
        if (owner.len == 0) { return false; }
        return self.dci_stub_base_for_type_text(owner).len > 0;
    }

    /// The override's contract word for how a source parameter crosses the
    /// boundary: `indirect`/`byval` arrive as a pointer to the aggregate.
    /// Source indices count the receiver; ABI parameters start after it.  The
    /// decision comes from the resolved contract symbol, so the override's
    /// materialized signature agrees with the producer-side shim that fills
    /// the vtable slot (rustc lowers a 12-byte C aggregate to sret + a
    /// by-reference parameter, which the native first-class rule would not).
    public fn source_param_uses_dci_override_byval_abi(self, function_id: i32, source_idx: i32) -> bool {
        if (!self.function_is_dci_vyx_override_callback(function_id)) { return false; }
        let abi_params = self.dci_abi_parameter_array(function_id);
        if (abi_params == null || cJSON_IsArray(abi_params) == 0) { return false; }
        let abi_idx = source_idx - self.dci_symbol_receiver_param_count(function_id);
        if (abi_idx < 0 || abi_idx >= cJSON_GetArraySize(abi_params)) { return false; }
        let passing = self.dci_abi_passing(cJSON_GetArrayItem(abi_params, abi_idx));
        return passing == "indirect" || passing == "byval";
    }

    /// A DCI override callback is materialized as an `extern "C"` free
    /// function: the stub TU declares it with plain C types, so a 1/2/4/8-byte
    /// record crosses in ONE integer register and returns in RAX (the C
    /// free-function rule) -- not the member rule, where every UDT return goes
    /// through the hidden pointer.  The DCI stable-value storage type (the
    /// `{anchor, [tail x i8]}` shape) is not register-class for LLVM's Win64
    /// CC, so these boundaries must coerce explicitly instead of leaking the
    /// storage type into the thunk signature.  Larger or non-register sizes
    /// keep the descriptor-driven sret/indirect facts.
    public fn dci_override_crosses_as_c_register_record(self, function_id: i32, type_id: i32) -> bool {
        if (function_id == mir_id_invalid() || type_id == mir_id_invalid()) { return false; }
        if (!self.function_is_dci_vyx_override_callback(function_id)) { return false; }
        if (!llvm_mir_effective_target_is_windows()) { return false; }
        let canonical_type = self.canonical_record_type_id(type_id);
        if (canonical_type == mir_id_invalid()) { return false; }
        if (llvm_mir_type_kind(&self.m, canonical_type) != ty_CLASS()) { return false; }
        if (self.type_is_class_pointer_abi(canonical_type)) { return false; }
        let bytes = self.dci_open_type_size(type_id);
        return bytes == 1 || bytes == 2 || bytes == 4 || bytes == 8;
    }

    public fn dci_stub_factory_symbol_for_type(self, type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(type_id));
        if (text.len == 0) { return ""; }
        return "__dci_stub_factory_" + policy_mangle_part(text);
    }

    public fn dci_stub_destroy_symbol_for_type(self, type_id: i32) -> string {
        let text = llvm_mir_type_text(&self.m, self.canonical_record_type_id(type_id));
        if (text.len == 0) { return ""; }
        return "__dci_stub_destroy_" + policy_mangle_part(text);
    }

    public fn get_or_declare_dci_stub_factory(self, type_id: i32) -> rawptr {
        if (!self.type_is_dci_stub_class(type_id)) { return null; }
        let canonical = self.canonical_record_type_id(type_id);
        let cached = llvm_mir_map_get(self.dci_stub_factory_values, canonical);
        if (cached != null) { return cached; }
        let symbol = self.dci_stub_factory_symbol_for_type(canonical);
        if (symbol.len == 0) { return null; }
        let fty = vyx_rt_fn_type(self.mod, self.ty_ptr, null, 0, 0);
        if (fty == null) {
            self.report_error("cannot declare DCI stub factory type for "
                      + llvm_mir_type_text(&self.m, canonical));
            return null;
        }
        let fnv = vyx_rt_add_function(self.mod, symbol.c_str(), symbol.len as u64, fty);
        if (fnv == null) {
            self.report_error("cannot declare DCI stub factory `" + symbol + "`");
            return null;
        }
        llvm_mir_map_put(self.dci_stub_factory_values, canonical, fnv);
        // The base instance this stub is built over, for the requests sidecar.
        llvm_dci_open_note_instance(
            self.dci_stub_base_for_type_text(llvm_mir_type_text(&self.m, canonical)));
        return fnv;
    }

    public fn lower_dci_stub_factory_call(self, type_id: i32) -> rawptr {
        let factory = self.get_or_declare_dci_stub_factory(type_id);
        if (factory == null) { return null; }
        let fty = vyx_rt_fn_type(self.mod, self.ty_ptr, null, 0, 0);
        let shared = self.dci_caller_participates_in_shared_unwind();
        var out: rawptr = null;
        if (shared) {
            out = vyx_rt_build_invoke(self.mod, fty, factory, null, 0,
                                       "dci.stub.new".c_str(), 12);
        } else {
            out = vyx_rt_build_call(self.mod,
                                    fty,
                                    factory,
                                    null,
                                    0,
                                    "dci.stub.new".c_str(),
                                    12);
        }
        if (out == null) {
            self.report_error("cannot call DCI stub factory for "
                      + llvm_mir_type_text(&self.m, type_id)
                      + " runtime=" + self.runtime_last_error());
        } elif (shared) {
            let destroy = self.get_or_declare_dci_stub_destroy(type_id);
            if (destroy == null || llvm_unwind_track_factory_owner(self.mod, out, destroy) != 0) {
                self.report_error("cannot register DCI factory object cleanup for "
                          + llvm_mir_type_text(&self.m, type_id)
                          + " runtime=" + self.runtime_last_error());
                return null;
            }
        }
        return out;
    }

    public fn get_or_declare_dci_stub_destroy(self, type_id: i32) -> rawptr {
        if (!self.type_is_dci_stub_class(type_id)) { return null; }
        let canonical = self.canonical_record_type_id(type_id);
        let cached = llvm_mir_map_get(self.dci_stub_destroy_values, canonical);
        if (cached != null) { return cached; }
        let symbol = self.dci_stub_destroy_symbol_for_type(canonical);
        if (symbol.len == 0) { return null; }
        let params = malloc(8);
        if (params == null) {
            self.report_error("cannot allocate DCI stub destroy signature params");
            return null;
        }
        ast_write_rawptr(params, self.ty_ptr);
        let fty = vyx_rt_fn_type(self.mod, self.ty_void, params, 1, 0);
        free(params);
        if (fty == null) {
            self.report_error("cannot declare DCI stub destroy type for "
                      + llvm_mir_type_text(&self.m, canonical));
            return null;
        }
        let fnv = vyx_rt_add_function(self.mod, symbol.c_str(), symbol.len as u64, fty);
        if (fnv == null) {
            self.report_error("cannot declare DCI stub destroy `" + symbol + "`");
            return null;
        }
        llvm_mir_map_put(self.dci_stub_destroy_values, canonical, fnv);
        return fnv;
    }

    public fn lower_dci_stub_destroy_place(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        let place_type = self.m.place_type(place_id);
        if (!self.type_is_dci_stub_class(place_type)) { return false; }
        let destroy = self.get_or_declare_dci_stub_destroy(place_type);
        if (destroy == null) { return true; }
        let place_addr = self.lower_place_addr(place_id);
        let receiver_arg = self.class_object_addr_from_place_addr(place_id, place_addr, place_type);
        if (receiver_arg == null) {
            self.report_error("cannot lower DCI stub destroy receiver for "
                      + llvm_mir_type_text(&self.m, place_type));
            return true;
        }
        let params = malloc(8);
        if (params == null) {
            self.report_error("cannot allocate DCI stub destroy call args");
            return true;
        }
        ast_write_rawptr(params, self.ty_ptr);
        let fty = vyx_rt_fn_type(self.mod, self.ty_void, params, 1, 0);
        ast_write_rawptr(params, receiver_arg);
        vyx_rt_build_call(self.mod,
                          fty,
                          destroy,
                          params,
                          1,
                          llvm_mir_empty_name(),
                          0);
        free(params);
        return true;
    }

    public fn local_is_self_pointer_abi_slot(self, function_id: i32, local_id: i32) -> bool {
        if (function_id == mir_id_invalid() || local_id == mir_id_invalid()) { return false; }
        let first_local = self.function_source_param_local(function_id, 0);
        if (first_local == mir_id_invalid() || first_local != local_id) { return false; }
        return self.source_param_uses_self_pointer_abi(function_id, 0);
    }

    public fn source_param_incoming_is_raw_pointer_handle(self,
                                                          function_id: i32,
                                                          source_idx: i32) -> bool {
        let local = self.function_source_param_local(function_id, source_idx);
        if (local == mir_id_invalid()) { return false; }
        if (self.local_is_self_pointer_abi_slot(function_id, local)) { return false; }
        let local_type = self.local_effective_type(local);
        if (!llvm_mir_kind_pointer_handle(llvm_mir_type_kind(&self.m, local_type))) {
            return false;
        }
        if (self.foreign_c_handle_uses_raw_pointer_abi(function_id, local_type)) {
            return true;
        }
        if (self.function_is_foreign_dci(function_id)
            && self.dci_direct_handle_uses_raw_pointer_abi(
                   local_type,
                   self.dci_source_parameter_abi(function_id, source_idx))) {
            return true;
        }
        return false;
    }

    public fn place_slot_holds_raw_pointer(self, place_id: i32) -> bool {
        if (place_id == mir_id_invalid()) { return false; }
        if (self.place_is_self_pointer_abi_slot(place_id)) { return true; }
        if (self.m.place_kind(place_id) != mir_place_local()) { return false; }
        let local = self.m.place_local(place_id);
        let function_id = self.m.place_function(place_id);
        if (local == mir_id_invalid() || function_id == mir_id_invalid()) { return false; }
        if (!self.local_is_source_param(local)) { return false; }
        var source_idx: i32 = 0;
        var cursor = self.m.function_first_local(function_id);
        while (cursor != mir_id_invalid()) {
            if (self.local_is_source_param(cursor)) {
                if (cursor == local) {
                    return self.source_param_incoming_is_raw_pointer_handle(function_id, source_idx);
                }
                source_idx = source_idx + 1;
            }
            cursor = self.m.local_next(cursor);
        }
        return false;
    }

    public fn local_uses_self_pointer_abi(self, function_id: i32, local_id: i32) -> bool {
        // Legacy codegen allocates a mutable slot for every source parameter,
        // including class receiver `self` whose LLVM ABI parameter is a raw
        // object pointer. Assignments such as `self = self.next()` update that
        // local slot, not the object pointed to by the incoming ABI parameter.
        return false;
    }

    public fn get_or_create_function_env_type(self, function_id: i32) -> rawptr {
        if (self.function_capture_count(function_id) <= 0) { return null; }
        let cached = llvm_mir_map_get(self.function_env_types, function_id);
        if (cached != null) { return cached; }
        let name = self.m.function_name(function_id) + ".env";
        let st = vyx_rt_struct_ty_named(self.mod, name.c_str(), name.len as u64);
        if (st == null) {
            self.report_error("cannot create closure env type for " + self.m.function_name(function_id));
            return null;
        }
        let n = self.function_capture_count(function_id);
        let fields = malloc((n * 8) as u64);
        if (fields == null) {
            self.report_error("cannot allocate closure env field list for " + self.m.function_name(function_id));
            return null;
        }
        var idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_capture(local)) {
                var field_ty = self.lower_type(self.local_effective_type(local));
                if (self.local_is_reference_capture(local)) { field_ty = self.ty_ptr; }
                ast_write_rawptr(ptr_offset(fields, idx * 8), field_ty);
                idx = idx + 1;
            }
            local = self.m.local_next(local);
        }
        if (vyx_rt_struct_ty_set_body(self.mod, st, fields, n as u64, 0) != 0) {
            free(fields);
            self.report_error("cannot finalize closure env type for " + self.m.function_name(function_id));
            return null;
        }
        free(fields);
        llvm_mir_map_put(self.function_env_types, function_id, st);
        return st;
    }

    public fn malloc_bytes_value(self, size: i64, name: string) -> rawptr {
        if (size <= 0) {
            self.report_error("invalid allocation size for " + name);
            return null;
        }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc is not declared before " + name);
            return null;
        }
        let size_v = vyx_rt_const_int(self.mod, self.ty_i64, size, 0);
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_malloc_fty,
                                  self.builtin_malloc_fn,
                                  size_v,
                                  name.c_str(),
                                  name.len as u64);
    }

    public fn class_alloc_bytes_value(self, size: i64, name: string) -> rawptr {
        if (size <= 0) {
            self.report_error("invalid class allocation size for " + name);
            return null;
        }
        if (self.builtin_class_alloc_fn == null || self.builtin_class_alloc_fty == null) {
            return self.malloc_bytes_value(size, name);
        }
        let size_v = vyx_rt_const_int(self.mod, self.ty_i64, size, 0);
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_class_alloc_fty,
                                  self.builtin_class_alloc_fn,
                                  size_v,
                                  name.c_str(),
                                  name.len as u64);
    }

    public fn closure_fat_field_ptr(self, fat: rawptr, idx: i32, name: string) -> rawptr {
        let fat_ty = self.get_or_create_closure_fat_ty();
        if (fat == null || fat_ty == null) { return null; }
        if (idx < 0 || idx >= 2) {
            self.report_error("closure fat field index out of range: " + policy_i64_to_string(idx as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 fat_ty,
                                 fat,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn closure_env_field_ptr(self, function_id: i32, env: rawptr, idx: i32, name: string) -> rawptr {
        let env_ty = self.get_or_create_function_env_type(function_id);
        if (env == null || env_ty == null) { return null; }
        let capture_count = self.function_capture_count(function_id);
        if (idx < 0 || idx >= capture_count) {
            self.report_error("closure env field index out of range for "
                      + self.m.function_name(function_id)
                      + ": "
                      + policy_i64_to_string(idx as i64));
            return null;
        }
        return vyx_rt_build_gep2(self.mod,
                                 env_ty,
                                 env,
                                 vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                 vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn build_closure_env_value(self, function_id: i32) -> rawptr {
        let capture_count = self.function_capture_count(function_id);
        if (capture_count <= 0) { return vyx_rt_const_ptr_null(self.mod, self.ty_ptr); }
        let env_ty = self.get_or_create_function_env_type(function_id);
        if (env_ty == null) { return null; }
        let env_size = vyx_rt_type_alloc_size(self.mod, env_ty);
        let env_mem = self.malloc_bytes_value(env_size, self.m.function_name(function_id) + ".env.alloc");
        if (env_mem == null) { return null; }
        var idx: i32 = 0;
        var local = self.m.function_first_local(function_id);
        while (local != mir_id_invalid()) {
            if (self.local_is_capture(local)) {
                var cap_value: rawptr = null;
                let init_value = self.m.local_capture_init_value(local);
                if (init_value != mir_id_invalid()) {
                    cap_value = self.lower_value_as(init_value, self.local_effective_type(local));
                } else {
                    let source_local = self.m.local_capture_source(local);
                    let source_slot = llvm_mir_map_get(self.local_slots, source_local);
                    if (source_local == mir_id_invalid() || source_slot == null) {
                        self.report_error("cannot resolve capture source for " + self.m.local_name(local)
                                  + " in " + self.m.function_name(function_id));
                        return null;
                    }
                    if (self.local_is_reference_capture(local)) {
                        cap_value = source_slot;
                    } else {
                        let source_value = vyx_rt_build_load(self.mod,
                                                             self.lower_type(self.m.local_type(source_local)),
                                                             source_slot,
                                                             self.m.local_name(local).c_str(),
                                                             self.m.local_name(local).len as u64);
                        cap_value = self.cast_value(source_value, self.local_effective_type(source_local), self.local_effective_type(local));
                    }
                }
                let field_ptr = self.closure_env_field_ptr(function_id, env_mem, idx, self.m.local_name(local));
                if (cap_value == null || field_ptr == null) {
                    self.report_error("cannot store capture " + self.m.local_name(local));
                    return null;
                }
                vyx_rt_build_store(self.mod, cap_value, field_ptr);
                idx = idx + 1;
            }
            local = self.m.local_next(local);
        }
        return env_mem;
    }

    public fn build_closure_fat_value(self, function_id: i32) -> rawptr {
        let fat_ty = self.get_or_create_closure_fat_ty();
        var fn_value = llvm_mir_map_get(self.function_closure_adapter_values, function_id);
        if (fn_value == null) {
            // A closure-value request is itself proof that this function needs
            // a value adapter: the adapter-need precomputation is keyed on the
            // MIR type kind and can miss a target whose type entry was interned
            // as a class stub carrying `fn(...)` text.  Declaring on demand
            // keeps the invariant "every closure fat pointer wraps an adapter"
            // airtight instead of emitting the raw code address into a
            // `__VyxClosureFat` slot.
            if (llvm_mir_i32_map_get(self.function_value_adapter_need_map, function_id) != 2) {
                llvm_mir_i32_map_put(self.function_value_adapter_need_map, function_id, 2);
            }
            self.declare_function_value_adapter_for(function_id);
            fn_value = llvm_mir_map_get(self.function_closure_adapter_values, function_id);
        }
        if (fat_ty == null || fn_value == null) {
            self.report_error("cannot build closure value for " + self.m.function_name(function_id));
            return null;
        }
        let fat_size = vyx_rt_type_alloc_size(self.mod, fat_ty);
        let fat_mem = self.malloc_bytes_value(fat_size, self.m.function_name(function_id) + ".fat.alloc");
        let env_mem = self.build_closure_env_value(function_id);
        if (fat_mem == null || env_mem == null) { return null; }
        let fn_field = self.closure_fat_field_ptr(fat_mem, 0, "closure.fn");
        let env_field = self.closure_fat_field_ptr(fat_mem, 1, "closure.env");
        if (fn_field == null || env_field == null) {
            self.report_error("cannot address closure fat fields");
            return null;
        }
        vyx_rt_build_store(self.mod, fn_value, fn_field);
        vyx_rt_build_store(self.mod, env_mem, env_field);
        return fat_mem;
    }

    public fn build_closure_fat_from_parts(self, fn_value: rawptr, env_value: rawptr, label: string) -> rawptr {
        let fat_ty = self.get_or_create_closure_fat_ty();
        if (fat_ty == null || fn_value == null) {
            self.report_error("cannot build reflected closure fat pointer for " + label);
            return null;
        }
        var env = env_value;
        if (env == null) { env = vyx_rt_const_ptr_null(self.mod, self.ty_ptr); }
        let fat_size = vyx_rt_type_alloc_size(self.mod, fat_ty);
        let fat_mem = self.malloc_bytes_value(fat_size, label + ".fat.alloc");
        if (fat_mem == null) { return null; }
        let fn_field = self.closure_fat_field_ptr(fat_mem, 0, label + ".fn");
        let env_field = self.closure_fat_field_ptr(fat_mem, 1, label + ".env");
        if (fn_field == null || env_field == null) {
            self.report_error("cannot address reflected closure fat fields for " + label);
            return null;
        }
        vyx_rt_build_store(self.mod, fn_value, fn_field);
        vyx_rt_build_store(self.mod, env, env_field);
        return fat_mem;
    }

    public fn closure_fat_function_value(self, fat: rawptr) -> rawptr {
        let fn_field = self.closure_fat_field_ptr(fat, 0, "closure.fn");
        if (fn_field == null) { return null; }
        return vyx_rt_build_load(self.mod, self.ty_ptr, fn_field, llvm_mir_empty_name(), 0);
    }

    public fn closure_fat_env_value(self, fat: rawptr) -> rawptr {
        let env_field = self.closure_fat_field_ptr(fat, 1, "closure.env");
        if (env_field == null) { return null; }
        return vyx_rt_build_load(self.mod, self.ty_ptr, env_field, llvm_mir_empty_name(), 0);
    }

    public fn build_dyn_method_adapter_type(self, prototype_fn: i32) -> rawptr {
        let source_count = self.function_source_param_count(prototype_fn);
        if (source_count <= 0) {
            self.report_error("dyn trait method has no receiver: " + self.m.function_name(prototype_fn));
            return null;
        }
        var params: rawptr = null;
        if (source_count > 0) {
            params = malloc((source_count * 8) as u64);
            if (params == null) {
                self.report_error("cannot allocate dyn method adapter signature for " + self.m.function_name(prototype_fn));
                return null;
            }
        }
        ast_write_rawptr(params, self.ty_ptr);
        var idx: i32 = 1;
        while (idx < source_count) {
            let param_type = self.function_source_param_type(prototype_fn, idx);
            if (param_type == mir_id_invalid()) {
                if (params != null) { free(params); }
                self.report_error("cannot resolve dyn method adapter parameter #" + policy_i64_to_string(idx as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(params, idx * 8), self.lower_type(param_type));
            idx = idx + 1;
        }
        let fty = vyx_rt_fn_type(self.mod,
                                 self.lower_type(self.m.function_return_type(prototype_fn)),
                                 params,
                                 source_count as u64,
                                 0);
        if (params != null) { free(params); }
        return fty;
    }

    public fn concrete_function_matches_dyn_method(self, prototype_fn: i32, concrete_fn: i32) -> bool {
        if (prototype_fn == mir_id_invalid() || concrete_fn == mir_id_invalid()) { return false; }
        if (!self.function_has_callable_body_or_import(concrete_fn)) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return false; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return false; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = self.function_source_param_count(concrete_fn);
        if (proto_count <= 0 || concrete_count != proto_count) { return false; }
        let concrete_self = self.function_source_param_type(concrete_fn, 0);
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn), self.m.function_return_type(concrete_fn))) {
            return false;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          self.function_source_param_type(concrete_fn, idx))) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    // ── dyn materialization diagnostics (`VYX_DYN_PROBE=1`) ─────────────
    // Diagnostic twin of concrete_function_matches_dyn_method: identical
    // decision chain, but returns the first failing step as a code so a
    // `[dyn-probe]` trace can name the exact reason a concrete method was
    // rejected.  0 = accepted.
    public fn dyn_method_match_reason(self, prototype_fn: i32, concrete_fn: i32) -> i32 {
        if (prototype_fn == mir_id_invalid() || concrete_fn == mir_id_invalid()) { return 1; }
        if (!self.function_has_callable_body_or_import(concrete_fn)) { return 2; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return 3; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return 4; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = self.function_source_param_count(concrete_fn);
        if (proto_count <= 0 || concrete_count != proto_count) { return 5; }
        let concrete_self = self.function_source_param_type(concrete_fn, 0);
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return 6; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn),
                                      self.m.function_return_type(concrete_fn))) {
            return 7;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          self.function_source_param_type(concrete_fn, idx))) {
                return 8;
            }
            idx = idx + 1;
        }
        return 0;
    }

    public fn dyn_probe_list_fns(self, tag: string) {
        var rec_count: i32 = 0;
        var meth_count: i32 = 0;
        var names: string = "";
        var f: i32 = 1;
        while (f <= self.m.function_count) {
            let nm = self.m.function_name(f);
            if (nm.contains("BaseRecord")) { rec_count = rec_count + 1; }
            let mn = self.function_method_name(f);
            if (mn == "id" || mn == "score") {
                meth_count = meth_count + 1;
                if (meth_count <= 12) {
                    names = names + "\n[dyn-probe]     #" + policy_i64_to_string(f as i64)
                            + " m=" + mn + " " + nm;
                }
            }
            f = f + 1;
        }
        print("[dyn-probe] " + tag
              + " mir_fn_count=" + policy_i64_to_string(self.m.function_count as i64)
              + " BaseRecord_named=" + policy_i64_to_string(rec_count as i64)
              + " id_or_score_methods=" + policy_i64_to_string(meth_count as i64) + names);
    }

    public fn dyn_probe_dump(self, src_type_id: i32, prototype_fn: i32) {
        let method_name = self.function_method_name(prototype_fn);
        var head: string = "[dyn-probe] src=" + llvm_mir_type_text(&self.m, src_type_id)
                           + " proto=" + method_name
                           + " fn_count=" + policy_i64_to_string(self.m.function_count as i64)
                           + " cgu=" + policy_i64_to_string(self.cgu_emit_index as i64)
                           + " index_ready=";
        if (self.method_candidate_index_ready) { head = head + "1"; } else { head = head + "0"; }
        print(head);
        var pc = self.method_candidate_head(method_name.clone());
        var seen: i32 = 0;
        while (pc != null) {
            let cand = ast_read_i32(pc);
            print("[dyn-probe]   cand#" + policy_i64_to_string(cand as i64)
                  + " " + self.m.function_name(cand)
                  + " reason=" + policy_i64_to_string(self.dyn_method_match_reason(prototype_fn, cand) as i64)
                  + " self=" + llvm_mir_type_text(&self.m, self.function_source_param_type(cand, 0)));
            seen = seen + 1;
            pc = ast_read_rawptr(ptr_offset(pc, 8));
        }
        print("[dyn-probe]   candidates=" + policy_i64_to_string(seen as i64));
        var f: i32 = 1;
        while (f <= self.m.function_count) {
            let nm = self.m.function_name(f);
            if (nm.contains("BaseRecord") || nm.contains("WeightedRecord")) {
                var flags: string = " bodyless=";
                if (self.function_is_bodyless(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                flags = flags + " callable=";
                if (self.function_has_callable_body_or_import(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                flags = flags + " emitted=";
                if (self.function_definition_was_emitted(f)) { flags = flags + "1"; } else { flags = flags + "0"; }
                print("[dyn-probe]   fn#" + policy_i64_to_string(f as i64) + " " + nm + flags);
            }
            f = f + 1;
        }
    }

    // ── `dyn` lookup fallback over the codegen partition ────────────────
    // Sibling units are invisible to `method_candidate_head`: their bodies are
    // released once the partition recorded them, and every per-unit reset
    // clears the definition-emitted marks, so the shared candidate index --
    // which ordinary method resolution must keep seeing byte-for-byte
    // unchanged -- cannot list them.  The partition (`cgu_collected_ids`) is
    // the durable record of "this build defines that function", so scan it as
    // a fallback used only by the `dyn` vtable lookup.
    //
    // Receiver specificity mirrors `receiver_type_can_use_method_self_type`,
    // which compares an owner *type id*, so the owner text has to be resolved
    // back through the unit type table first -- comparing the text directly
    // would miss an inherited method (`WeightedRecord` reusing `BaseRecord`'s
    // implementation).  A tie at the best score is rejected rather than
    // guessed, so this can only ever recover a lookup that used to fail; it
    // cannot silently pick the wrong overload.
    public fn dyn_partition_receiver_score(self, src_type_id: i32, fn_id: i32) -> i32 {
        let owner_text = self.m.function_owner_type(fn_id);
        if (owner_text.len == 0) { return 0; }
        let receiver_text = llvm_mir_type_text(&self.m, src_type_id);
        if (receiver_text.len > 0 && owner_text == receiver_text) { return 4; }
        let owner_id = mir_unit_find_type_by_text(&self.m, owner_text);
        if (owner_id == mir_id_invalid()) { return 0; }
        if (self.type_ids_compatible(src_type_id, owner_id)) { return 3; }
        if (self.dci_type_derives_from(src_type_id, owner_id)) { return 2; }
        if (self.record_layout_prefix_compatible(src_type_id, owner_id)) { return 1; }
        if (self.record_layout_subobject_field_index(src_type_id, owner_id) >= 0) { return 1; }
        return 0;
    }

    // Signature half of `concrete_function_matches_dyn_method`, evaluated against
    // the snapshot taken while the body was still live.  The concrete side is
    // read from `dyn_sig_buf` and never from the local chain: releasing a
    // streamed body leaves the local table allocated but may rewire -- even
    // cycle -- its `local_next` chain (see the `local_guard` in
    // `discard_recent_body_records`), which is what made an earlier version of
    // this fallback fault inside the compiler.  The prototype, by contrast, is
    // local to this unit and never loses its declaration locals, so its
    // parameters are still read directly.  Keeping the parameter comparison is
    // what stops a same-name overload from being selected by name alone.
    public fn dyn_partition_signature_matches(self, prototype_fn: i32, slot: i32) -> bool {
        if (self.dyn_sig_off == null || self.dyn_sig_buf == null) { return false; }
        if (self.cgu_collected_ids == null) { return false; }
        if (slot < 0 || slot >= self.cgu_collected_n) { return false; }
        let base = ast_read_i32(ptr_offset(self.dyn_sig_off, slot * 4));
        if (base < 0 || base >= self.dyn_sig_n) { return false; }
        let concrete_fn = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
        if (concrete_fn == mir_id_invalid()) { return false; }
        if (mir_unit_function_owner_item_kind(&self.m, concrete_fn) == hir_item_interface()) { return false; }
        let method_name = self.function_method_name(prototype_fn);
        if (!self.function_name_matches_method(self.m.function_name(concrete_fn), method_name)) { return false; }
        let proto_count = self.function_source_param_count(prototype_fn);
        let concrete_count = ast_read_i32(ptr_offset(self.dyn_sig_buf, base * 4));
        if (proto_count <= 0 || concrete_count != proto_count) { return false; }
        if (base + concrete_count > self.dyn_sig_n) { return false; }
        let concrete_self = ast_read_i32(ptr_offset(self.dyn_sig_buf, (base + 1) * 4));
        if (concrete_self == mir_id_invalid() || self.type_is_dyn_trait(concrete_self)) { return false; }
        if (!self.type_ids_compatible(self.m.function_return_type(prototype_fn),
                                      self.m.function_return_type(concrete_fn))) {
            return false;
        }
        var idx: i32 = 1;
        while (idx < proto_count) {
            let concrete_param = ast_read_i32(ptr_offset(self.dyn_sig_buf, (base + 1 + idx) * 4));
            if (!self.type_ids_compatible(self.function_source_param_type(prototype_fn, idx),
                                          concrete_param)) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    public fn dyn_partition_candidate(self, src_type_id: i32, prototype_fn: i32) -> i32 {
        if (self.cgu_emit_index <= 0 || self.dyn_partition_index == null) { return mir_id_invalid(); }
        if (prototype_fn == mir_id_invalid()) { return mir_id_invalid(); }
        self.ensure_dyn_partition_index();
        let method_name = self.function_method_name(prototype_fn);
        if (method_name.len == 0) { return mir_id_invalid(); }
        var best: i32 = mir_id_invalid();
        var best_score: i32 = 0;
        var tied: bool = false;
        var cur = llvm_mir_method_candidate_index_lookup(self.dyn_partition_index,
                                                        self.dyn_partition_index_cap,
                                                        method_name);
        while (cur != null) {
            let slot = ast_read_i32(cur) - 1;
            cur = ast_read_rawptr(ptr_offset(cur, 8));
            if (slot < 0 || slot >= self.cgu_collected_n) { continue; }
            let fn_id = ast_read_i32(ptr_offset(self.cgu_collected_ids, slot * 4));
            if (fn_id == mir_id_invalid() || fn_id == prototype_fn) { continue; }
            let score = self.dyn_partition_receiver_score(src_type_id, fn_id);
            if (score <= 0) { continue; }
            if (!self.dyn_partition_signature_matches(prototype_fn, slot)) { continue; }
            if (score > best_score) {
                best = fn_id;
                best_score = score;
                tied = false;
            } else {
                if (score == best_score) { tied = true; }
            }
        }
        if (policy_dyn_probe_enabled()) {
            var line: string = "[dyn-probe] partition src=" + llvm_mir_type_text(&self.m, src_type_id)
                               + " proto=" + method_name
                               + " best=" + policy_i64_to_string(best as i64)
                               + " score=" + policy_i64_to_string(best_score as i64)
                               + " tied=";
            if (tied) { line = line + "1"; } else { line = line + "0"; }
            print(line);
        }
        if (tied) { return mir_id_invalid(); }
        return best;
    }

    public fn emit_dyn_method_adapter_body(self,
                                           prototype_fn: i32,
                                           concrete_fn: i32,
                                           adapter_fn: rawptr,
                                           adapter_type: rawptr) {
        self.declare_function_signature(concrete_fn);
        let target_fn = llvm_mir_map_get(self.function_values, concrete_fn);
        let target_type = llvm_mir_map_get(self.function_types, concrete_fn);
        if (target_fn == null || target_type == null || adapter_fn == null || adapter_type == null) {
            self.report_error("cannot emit dyn method adapter for " + self.m.function_name(concrete_fn));
            return;
        }
        let saved_block = vyx_rt_get_insert_block(self.mod);
        let name = self.function_symbol_name(concrete_fn) + "$dyn.entry";
        let bb = vyx_rt_append_block(self.mod, adapter_fn, name.c_str(), name.len as u64);
        if (bb == null) {
            self.report_error("cannot create dyn method adapter block for " + self.m.function_name(concrete_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        vyx_rt_position_at_end(self.mod, bb);
        let source_count = self.function_source_param_count(concrete_fn);
        let uses_sret = self.function_uses_hidden_sret(concrete_fn);
        let concrete_ret = self.m.function_return_type(concrete_fn);
        let proto_ret = self.m.function_return_type(prototype_fn);
        var llvm_argc: i32 = source_count;
        if (uses_sret) { llvm_argc = llvm_argc + 1; }
        var args: rawptr = null;
        if (llvm_argc > 0) {
            args = malloc((llvm_argc * 8) as u64);
            if (args == null) {
                self.report_error("cannot allocate dyn method adapter call arguments");
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
        }
        let data_param = vyx_rt_get_param(self.mod, adapter_fn, 0);
        if (data_param == null) {
            if (args != null) { free(args); }
            self.report_error("cannot read dyn method data parameter");
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        let concrete_self_type = self.function_source_param_type(concrete_fn, 0);
        var self_arg: rawptr = data_param;
        if (!self.source_param_uses_self_pointer_abi(concrete_fn, 0)) {
            self_arg = vyx_rt_build_load(self.mod,
                                         self.lower_type(concrete_self_type),
                                         data_param,
                                         "dyn.self".c_str(),
                                         8);
        }
        if (self_arg == null) {
            if (args != null) { free(args); }
            self.report_error("cannot lower dyn adapter receiver for " + self.m.function_name(concrete_fn));
            if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
            return;
        }
        var out_idx: i32 = 0;
        var sret_slot: rawptr = null;
        if (uses_sret) {
            let sret_storage = self.lower_storage_type(concrete_ret);
            if (sret_storage == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn adapter sret storage for "
                          + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            sret_slot = vyx_rt_build_alloca(self.mod, sret_storage, "dyn.adapter.sret".c_str(), 16);
            let sret_align = self.native_aggregate_align_bytes(concrete_ret);
            if (sret_slot != null && sret_align > 0) {
                vyx_rt_set_alignment(self.mod, sret_slot, sret_align as i32);
            }
            if (sret_slot == null) {
                if (args != null) { free(args); }
                self.report_error("cannot allocate dyn adapter sret storage for "
                          + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            ast_write_rawptr(args, sret_slot);
            out_idx = 1;
        }
        ast_write_rawptr(ptr_offset(args, out_idx * 8), self_arg);
        out_idx = out_idx + 1;
        var idx: i32 = 1;
        while (idx < source_count) {
            let param_value = vyx_rt_get_param(self.mod, adapter_fn, idx as u64);
            let proto_type = self.function_source_param_type(prototype_fn, idx);
            let concrete_type = self.function_source_param_type(concrete_fn, idx);
            var arg_value = self.cast_value(param_value, proto_type, concrete_type);
            if (param_value == null || arg_value == null) {
                if (args != null) { free(args); }
                self.report_error("cannot lower dyn adapter parameter #" + policy_i64_to_string(idx as i64)
                          + " for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            if (self.source_param_uses_native_byval_abi(concrete_fn, idx)) {
                let byval_storage = self.lower_storage_type(concrete_type);
                var byval_slot: rawptr = null;
                if (byval_storage != null) {
                    byval_slot = vyx_rt_build_alloca(self.mod, byval_storage, "dyn.adapter.byval".c_str(), 17);
                }
                let byval_align = self.native_aggregate_align_bytes(concrete_type);
                if (byval_slot != null && byval_align > 0) {
                    vyx_rt_set_alignment(self.mod, byval_slot, byval_align as i32);
                }
                if (byval_slot == null) {
                    if (args != null) { free(args); }
                    self.report_error("cannot materialize dyn adapter byval parameter #"
                              + policy_i64_to_string(idx as i64)
                              + " for " + self.m.function_name(concrete_fn));
                    if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                    return;
                }
                vyx_rt_build_store(self.mod, arg_value, byval_slot);
                arg_value = byval_slot;
            }
            ast_write_rawptr(ptr_offset(args, out_idx * 8), arg_value);
            out_idx = out_idx + 1;
            idx = idx + 1;
        }
        var call_name = "dyn.adapter.call";
        if (llvm_mir_type_kind(&self.m, concrete_ret) == ty_VOID() || uses_sret) { call_name = ""; }
        var result = vyx_rt_build_call(self.mod,
                                       target_type,
                                       target_fn,
                                       args,
                                       llvm_argc as u64,
                                       call_name.c_str(),
                                       call_name.len as u64);
        if (args != null) { free(args); }
        if (result != null && !self.apply_native_c_aggregate_abi_attrs(concrete_fn, result)) {
            result = null;
        }
        if (llvm_mir_type_kind(&self.m, proto_ret) == ty_VOID()) {
            vyx_rt_build_ret_void(self.mod);
        } else if (uses_sret) {
            if (result == null || sret_slot == null) {
                self.report_error("cannot emit dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            var ret_value: rawptr = sret_slot;
            if (!self.type_is_class_pointer_abi(concrete_ret)) {
                ret_value = vyx_rt_build_load(self.mod,
                                              self.lower_type(concrete_ret),
                                              sret_slot,
                                              "dyn.adapter.sret.val".c_str(),
                                              20);
            }
            ret_value = self.cast_value(ret_value, concrete_ret, proto_ret);
            if (ret_value == null) {
                self.report_error("cannot cast dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            vyx_rt_build_ret(self.mod, ret_value);
        } else if (result != null) {
            let ret_value = self.cast_value(result, concrete_ret, proto_ret);
            if (ret_value == null) {
                self.report_error("cannot cast dyn adapter return for " + self.m.function_name(concrete_fn));
                if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
                return;
            }
            vyx_rt_build_ret(self.mod, ret_value);
        } else {
            self.report_error("cannot emit dyn adapter return for " + self.m.function_name(concrete_fn));
        }
        if (saved_block != null) { vyx_rt_position_at_end(self.mod, saved_block); }
    }

    public fn dyn_method_adapter_lookup(self, prototype_fn: i32, concrete_fn: i32) -> rawptr {
        var cur = self.dyn_method_adapter_head;
        while (cur != null) {
            if (ast_read_i32(cur) == prototype_fn
                && ast_read_i32(ptr_offset(cur, 4)) == concrete_fn) {
                return ast_read_rawptr(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return null;
    }

    public fn dyn_method_adapter_store(self, prototype_fn: i32, concrete_fn: i32, adapter_fn: rawptr) {
        if (adapter_fn == null) { return; }
        let node = malloc(24);
        if (node == null) {
            self.report_error("cannot allocate dyn method adapter cache entry");
            return;
        }
        ast_write_i32(node, prototype_fn);
        ast_write_i32(ptr_offset(node, 4), concrete_fn);
        ast_write_rawptr(ptr_offset(node, 8), adapter_fn);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_method_adapter_head);
        self.dyn_method_adapter_head = node;
    }

    public fn declare_dyn_method_adapter(self, prototype_fn: i32, concrete_fn: i32) -> rawptr {
        let existing = self.dyn_method_adapter_lookup(prototype_fn, concrete_fn);
        if (existing != null) { return existing; }
        let adapter_type = self.build_dyn_method_adapter_type(prototype_fn);
        if (adapter_type == null) { return null; }
        let name = self.function_symbol_name(concrete_fn)
            + "$dyn_adapter$"
            + policy_mangle_part(self.module_symbol_name)
            + "$"
            + policy_i64_to_string(prototype_fn as i64);
        let adapter_fn = vyx_rt_add_function(self.mod, name.c_str(), name.len as u64, adapter_type);
        if (adapter_fn == null) {
            self.report_error("cannot declare dyn method adapter " + name);
            return null;
        }
        vyx_rt_set_linkage(self.mod, adapter_fn, 1);
        self.dyn_method_adapter_store(prototype_fn, concrete_fn, adapter_fn);
        self.emit_dyn_method_adapter_body(prototype_fn, concrete_fn, adapter_fn, adapter_type);
        return adapter_fn;
    }

    public fn dyn_vtable_lookup(self, dyn_type_id: i32, src_type_id: i32) -> rawptr {
        var cur = self.dyn_vtable_head;
        while (cur != null) {
            if (ast_read_i32(cur) == dyn_type_id
                && ast_read_i32(ptr_offset(cur, 4)) == src_type_id) {
                return ast_read_rawptr(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return null;
    }

    public fn dyn_vtable_store(self, dyn_type_id: i32, src_type_id: i32, gv: rawptr) {
        if (gv == null) { return; }
        let node = malloc(24);
        if (node == null) {
            self.report_error("cannot allocate dyn vtable cache entry");
            return;
        }
        ast_write_i32(node, dyn_type_id);
        ast_write_i32(ptr_offset(node, 4), src_type_id);
        ast_write_rawptr(ptr_offset(node, 8), gv);
        ast_write_rawptr(ptr_offset(node, 16), self.dyn_vtable_head);
        self.dyn_vtable_head = node;
    }

    public fn dyn_vtable_global_name(self, src_type_id: i32, dyn_type_id: i32) -> string {
        let src_text = llvm_mir_type_text(&self.m, src_type_id);
        let iface_name = self.dyn_trait_name(dyn_type_id);
        if (src_text.len == 0 || iface_name.len == 0) { return ""; }
        if (policy_generic_call_has_args(src_text) != 0
            || policy_generic_call_has_args(iface_name) != 0) {
            return "mir.vtable."
                + policy_mangle_part(src_text)
                + "."
                + policy_mangle_part(iface_name);
        }
        return src_text + "_vtable_" + iface_name;
    }

    public fn get_or_create_dyn_vtable_global(self, src_type_id: i32, dyn_type_id: i32) -> rawptr {
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_type: i64 = 0;
        var timing_slots: i64 = 0;
        var timing_alloc: i64 = 0;
        var timing_impl: i64 = 0;
        var timing_adapter: i64 = 0;
        var timing_const: i64 = 0;
        var timing_global: i64 = 0;
        var timing_cache: i64 = 0;
        if (llvm_mir_timing_enabled()) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        let cached = self.dyn_vtable_lookup(dyn_type_id, src_type_id);
        if (cached != null) {
            return cached;
        }
        if (llvm_mir_timing_enabled()) {
            let now_type0 = vyx_bootstrap_now_ms();
            timing_cache = now_type0 - timing_mark;
            timing_mark = now_type0;
        }
        let vtable_ty = self.get_or_create_dyn_trait_vtable_ty(dyn_type_id);
        if (vtable_ty == null) { return null; }
        if (llvm_mir_timing_enabled()) {
            let now_type = vyx_bootstrap_now_ms();
            timing_type = now_type - timing_mark;
            timing_mark = now_type;
        }
        let slot_count = self.dyn_trait_method_count(dyn_type_id);
        if (slot_count <= 0) { return null; }
        if (llvm_mir_timing_enabled()) {
            let now_slots = vyx_bootstrap_now_ms();
            timing_slots = now_slots - timing_mark;
            timing_mark = now_slots;
        }
        let vals = malloc((slot_count * 8) as u64);
        if (vals == null) {
            self.report_error("cannot allocate dyn vtable initializer for "
                      + llvm_mir_type_text(&self.m, src_type_id)
                      + " as "
                      + llvm_mir_type_text(&self.m, dyn_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_alloc = vyx_bootstrap_now_ms();
            timing_alloc = now_alloc - timing_mark;
            timing_mark = now_alloc;
        }
        var ok = true;
        var slot: i32 = 0;
        while (slot < slot_count) {
            let prototype_fn = self.dyn_trait_method_at(dyn_type_id, slot);
            var slot_mark: i64 = 0;
            if (llvm_mir_timing_enabled()) { slot_mark = vyx_bootstrap_now_ms(); }
            let impl_fn = self.dyn_trait_implementation_for_method(src_type_id, prototype_fn);
            if (llvm_mir_timing_enabled()) {
                let now_impl = vyx_bootstrap_now_ms();
                timing_impl = timing_impl + (now_impl - slot_mark);
                slot_mark = now_impl;
            }
            var adapter_fn: rawptr = null;
            if (impl_fn != mir_id_invalid()) {
                adapter_fn = self.dyn_method_adapter_lookup(prototype_fn, impl_fn);
                if (adapter_fn == null) {
                    adapter_fn = self.declare_dyn_method_adapter(prototype_fn, impl_fn);
                }
            }
            if (llvm_mir_timing_enabled()) {
                let now_adapter = vyx_bootstrap_now_ms();
                timing_adapter = timing_adapter + (now_adapter - slot_mark);
            }
            if (adapter_fn == null) {
                self.report_error("cannot materialize dyn vtable method `"
                          + self.function_method_name(prototype_fn)
                          + "` for "
                          + llvm_mir_type_text(&self.m, src_type_id)
                          + " as "
                          + llvm_mir_type_text(&self.m, dyn_type_id));
                ok = false;
            } else {
                ast_write_rawptr(ptr_offset(vals, slot * 8), adapter_fn);
            }
            slot = slot + 1;
        }
        if (!ok) {
            free(vals);
            return null;
        }
        let init_v = vyx_rt_const_named_struct(self.mod, vtable_ty, vals, slot_count as u64);
        free(vals);
        if (init_v == null) {
            self.report_error("cannot initialize dyn vtable constant for " + llvm_mir_type_text(&self.m, src_type_id));
            return null;
        }
        if (llvm_mir_timing_enabled()) {
            let now_const = vyx_bootstrap_now_ms();
            timing_const = now_const - timing_mark - timing_impl - timing_adapter;
            if (timing_const < 0) { timing_const = 0; }
            timing_mark = now_const;
        }
        let global_name = self.dyn_vtable_global_name(src_type_id, dyn_type_id);
        if (global_name.len == 0) {
            self.report_error("cannot name dyn vtable global");
            return null;
        }
        let gv = vyx_rt_add_global(self.mod,
                                   vtable_ty,
                                   global_name.c_str(),
                                   global_name.len as u64);
        if (gv == null) {
            self.report_error("cannot declare dyn vtable global " + global_name);
            return null;
        }
        vyx_rt_set_initializer(self.mod, gv, init_v);
        vyx_rt_set_global_constant(self.mod, gv, 1);
        vyx_rt_set_linkage(self.mod, gv, 1);
        self.dyn_vtable_store(dyn_type_id, src_type_id, gv);
        if (llvm_mir_timing_enabled()) {
            let timing_total = vyx_bootstrap_now_ms() - timing_start;
            timing_global = timing_total - timing_cache - timing_type - timing_slots - timing_alloc - timing_impl - timing_adapter - timing_const;
            if (timing_global < 0) { timing_global = 0; }
            if (timing_total >= llvm_mir_slow_instr_threshold_ms()) {
                print("[mir-timing] dyn-vtable"
                      + " src=" + llvm_mir_type_text(&self.m, src_type_id)
                      + " dst=" + llvm_mir_type_text(&self.m, dyn_type_id)
                      + " slots=" + policy_i64_to_string(slot_count as i64)
                      + " cache=" + timing_cache.toString()
                      + " type=" + timing_type.toString()
                      + " methods=" + timing_slots.toString()
                      + " alloc=" + timing_alloc.toString()
                      + " impl=" + timing_impl.toString()
                      + " adapter=" + timing_adapter.toString()
                      + " const=" + timing_const.toString()
                      + " global=" + timing_global.toString()
                      + " total=" + timing_total.toString() + " ms");
            }
        }
        return gv;
    }

    public fn emit_str_ptr(self, text: string) -> rawptr {
        let cached = llvm_mir_entry_lookup_value(self.str_lit_buf,
                                                 self.string_lit_count,
                                                 text);
        if (cached != null) { return cached; }
        let name = ".str." + policy_i64_to_string(self.string_lit_count as i64);
        let ptr = vyx_rt_const_vyx_string_ptr(self.mod,
                                              text.c_str(),
                                              text.len as u64,
                                              name.c_str(),
                                              name.len as u64);
        if (ptr == null) {
            self.report_error("cannot materialize str literal");
            return null;
        }
        if (self.str_lit_buf == null) {
            self.report_error("str literal cache is unavailable");
            return null;
        }
        let slot = llvm_mir_entry_at(self.str_lit_buf, self.string_lit_count);
        llvm_mir_entry_write(slot, text, ptr, null);
        self.string_lit_count = self.string_lit_count + 1;
        return ptr;
    }

    public fn emit_string_value_from_parts(self, data_ptr: rawptr, len_v: rawptr, cap_v: rawptr, owned_v: rawptr) -> rawptr {
        let st = self.get_string_ty();
        if (st == null || data_ptr == null || len_v == null || cap_v == null || owned_v == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, st, "mir.str.tmp".c_str(), 11);
        if (tmp == null) {
            self.report_error("cannot allocate str temporary");
            return null;
        }
        let zero = vyx_rt_const_int(self.mod, self.ty_i32, 0, 0);
        let p0 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 0, 0), "str.ptr".c_str(), 7);
        let p1 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 1, 0), "str.len".c_str(), 7);
        let p2 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 2, 0), "str.cap".c_str(), 7);
        let p3 = vyx_rt_build_gep2(self.mod, st, tmp, zero, vyx_rt_const_int(self.mod, self.ty_i32, 3, 0), "str.owned".c_str(), 9);
        if (p0 == null || p1 == null || p2 == null || p3 == null) {
            self.report_error("cannot address str fields");
            return null;
        }
        vyx_rt_build_store(self.mod, data_ptr, p0);
        vyx_rt_build_store(self.mod, len_v, p1);
        vyx_rt_build_store(self.mod, cap_v, p2);
        vyx_rt_build_store(self.mod, owned_v, p3);
        return vyx_rt_build_load(self.mod, st, tmp, "str.val".c_str(), 7);
    }

    public fn emit_str_value(self, text: string) -> rawptr {
        let ptr = self.emit_str_ptr(text);
        return self.emit_string_value_from_parts(ptr,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, text.len, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
    }

    public fn string_field_value(self, value: rawptr, idx: i32, field_ty: rawptr, name: string) -> rawptr {
        let st = self.get_string_ty();
        if (st == null || value == null || field_ty == null) { return null; }
        let tmp = vyx_rt_build_alloca(self.mod, st, "mir.str.extract".c_str(), 15);
        if (tmp == null) { return null; }
        vyx_rt_build_store(self.mod, value, tmp);
        let field = vyx_rt_build_gep2(self.mod,
                                      st,
                                      tmp,
                                      vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                      vyx_rt_const_int(self.mod, self.ty_i32, idx as i64, 0),
                                      name.c_str(),
                                      name.len as u64);
        if (field == null) { return null; }
        return vyx_rt_build_load(self.mod, field_ty, field, name.c_str(), name.len as u64);
    }

    public fn string_ptr_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 0, self.ty_ptr, "str.ptr");
    }

    public fn string_len_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 1, self.ty_i64, "str.len");
    }

    public fn string_cap_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 2, self.ty_i64, "str.cap");
    }

    public fn string_owned_value(self, value: rawptr) -> rawptr {
        return self.string_field_value(value, 3, self.ty_i64, "str.owned");
    }

    public fn ptr_offset_bytes(self, base: rawptr, offset: rawptr, name: string) -> rawptr {
        if (base == null || offset == null) { return null; }
        return vyx_rt_build_gep1(self.mod,
                                 self.ty_i8,
                                 base,
                                 offset,
                                 name.c_str(),
                                 name.len as u64);
    }

    public fn ptr_offset_elements(self, elem_ty: rawptr, base: rawptr, index: rawptr, name: string) -> rawptr {
        if (elem_ty == null || base == null || index == null) { return null; }
        return vyx_rt_build_gep1(self.mod,
                                 elem_ty,
                                 base,
                                 index,
                                 name.c_str(),
                                 name.len as u64);
    }

    // Apply semantic attributes only to runtime declarations created and held
    // here. Foreign C/DCI declarations share the bridge API but must retain
    // their contract-defined behavior rather than inherit name-based hints.
    public fn apply_known_runtime_function_attr(self,
                                                fn_value: rawptr,
                                                symbol: string,
                                                attr: string) -> bool {
        if (fn_value == null) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_function_attr(self.mod,
                                     fn_value,
                                     attr.c_str(),
                                     attr.len as u64,
                                     null,
                                     0) != 0) {
            self.report_error("cannot apply runtime attribute `" + attr + "` to `"
                              + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_known_runtime_return_attr(self,
                                               fn_value: rawptr,
                                               symbol: string,
                                               attr: string) -> bool {
        if (fn_value == null) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_return_attr(self.mod,
                                   fn_value,
                                   attr.c_str(),
                                   attr.len as u64) != 0) {
            self.report_error("cannot apply runtime return attribute `" + attr
                              + "` to `" + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_known_runtime_param_attr(self,
                                             fn_value: rawptr,
                                             symbol: string,
                                             param_index: i32,
                                             attr: string) -> bool {
        if (fn_value == null || param_index < 0) {
            self.report_error("missing known runtime declaration `" + symbol + "`");
            return false;
        }
        if (vyx_rt_set_param_abi_attr(self.mod,
                                      fn_value,
                                      param_index as u64,
                                      attr.c_str(),
                                      attr.len as u64,
                                      null,
                                      0) != 0) {
            self.report_error("cannot apply runtime parameter attribute `" + attr
                              + "` to `" + symbol + "`: " + self.runtime_last_error());
            return false;
        }
        return true;
    }

    public fn apply_integer_string_runtime_attrs(self) -> bool {
        if (!self.apply_known_runtime_function_attr(self.builtin_int_decimal_len_fn,
                                                    "vyx_int_decimal_len_abi",
                                                    "readnone")
            || !self.apply_known_runtime_function_attr(self.builtin_int_decimal_len_fn,
                                                       "vyx_int_decimal_len_abi",
                                                       "nounwind")
            || !self.apply_known_runtime_function_attr(self.builtin_uint_decimal_len_fn,
                                                       "vyx_uint_decimal_len_abi",
                                                       "readnone")
            || !self.apply_known_runtime_function_attr(self.builtin_uint_decimal_len_fn,
                                                       "vyx_uint_decimal_len_abi",
