    public fn lower_from_cstr_len_call(self, value_id: i32, view: bool) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("from_cstr_len requires exactly two arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let len_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let len_v = self.int_value_to_bits(self.lower_value(len_id), self.m.value_type(len_id), 64);
        if (ptr_v == null || len_v == null) {
            self.report_error("cannot lower from_cstr_len arguments");
            return null;
        }
        if (view) {
            return self.emit_string_value_from_parts(ptr_v,
                                                     len_v,
                                                     len_v,
                                                     vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        }
        let dst = self.copied_string_data_from_cstr_len(ptr_v, len_v);
        if (dst == null) { return null; }
        let cap_v = vyx_rt_build_add(self.mod,
                                     len_v,
                                     vyx_rt_const_int(self.mod, self.ty_i64, 1, 1),
                                     llvm_mir_empty_name(),
                                     0);
        return self.emit_string_value_from_parts(dst,
                                                 len_v,
                                                 cap_v,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    public fn lower_from_raw_string_parts_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 4) {
            self.report_error("from_raw_string_parts requires exactly four arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let len_id = self.call_arg_at(value_id, 1);
        let cap_id = self.call_arg_at(value_id, 2);
        let owned_id = self.call_arg_at(value_id, 3);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let len_v = self.int_value_to_bits(self.lower_value(len_id), self.m.value_type(len_id), 64);
        let cap_v = self.int_value_to_bits(self.lower_value(cap_id), self.m.value_type(cap_id), 64);
        let owned_v = self.int_value_to_bits(self.lower_value(owned_id), self.m.value_type(owned_id), 64);
        if (ptr_v == null || len_v == null || cap_v == null || owned_v == null) {
            self.report_error("cannot lower from_raw_string_parts arguments");
            return null;
        }
        return self.emit_string_value_from_parts(ptr_v, len_v, cap_v, owned_v);
    }

    public fn lower_string_substring_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var start_id = self.call_arg_at(value_id, 0);
        var end_id = self.call_arg_at(value_id, 1);
        if (argc == 3) {
            receiver_id = self.call_arg_at(value_id, 0);
            start_id = self.call_arg_at(value_id, 1);
            end_id = self.call_arg_at(value_id, 2);
        } else if (argc != 2) {
            self.report_error("substring requires receiver plus start/end");
            return null;
        }
        if (receiver_id == mir_id_invalid()
            || start_id == mir_id_invalid()
            || end_id == mir_id_invalid()) {
            self.report_error("substring call is missing receiver or bounds");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("substring receiver is not str ABI");
            return null;
        }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        if (self.builtin_memcpy_fn == null || self.builtin_memcpy_fty == null) {
            self.report_error("memcpy declaration is unavailable");
            return null;
        }

        let source_value = self.lower_string_view_value(receiver_id);
        let source_ptr = self.string_ptr_value(source_value);
        let source_len = self.string_len_value(source_value);
        let start_raw = self.int_value_to_bits(self.lower_value(start_id), self.m.value_type(start_id), 64);
        let end_raw = self.int_value_to_bits(self.lower_value(end_id), self.m.value_type(end_id), 64);
        if (source_value == null || source_ptr == null || source_len == null || start_raw == null || end_raw == null) {
            self.report_error("cannot lower substring operands");
            return null;
        }

        let zero = vyx_rt_const_int(self.mod, self.ty_i64, 0, 0);
        let one = vyx_rt_const_int(self.mod, self.ty_i64, 1, 0);
        let start_neg = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_slt(),
                                          start_raw,
                                          zero,
                                          llvm_mir_empty_name(),
                                          0);
        let st = vyx_rt_build_select(self.mod,
                                     start_neg,
                                     zero,
                                     start_raw,
                                     "mir.substr.start".c_str(),
                                     16);
        let end_gt_len = vyx_rt_build_icmp(self.mod,
                                           llvm_mir_icmp_sgt(),
                                           end_raw,
                                           source_len,
                                           llvm_mir_empty_name(),
                                           0);
        let en = vyx_rt_build_select(self.mod,
                                     end_gt_len,
                                     source_len,
                                     end_raw,
                                     "mir.substr.end".c_str(),
                                     14);
        let st_ge_len = vyx_rt_build_icmp(self.mod,
                                          llvm_mir_icmp_sge(),
                                          st,
                                          source_len,
                                          llvm_mir_empty_name(),
                                          0);
        let en_le_st = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_sle(),
                                         en,
                                         st,
                                         llvm_mir_empty_name(),
                                         0);
        let empty_cond = vyx_rt_build_or(self.mod,
                                         st_ge_len,
                                         en_le_st,
                                         llvm_mir_empty_name(),
                                         0);
        let new_len = vyx_rt_build_sub(self.mod,
                                       en,
                                       st,
                                       "mir.substr.len".c_str(),
                                       14);
        let str_ty = self.get_string_ty();
        let result_slot = vyx_rt_build_alloca(self.mod,
                                             str_ty,
                                             "mir.substr.result".c_str(),
                                             17);
        let empty_name = "mir.substr.empty." + policy_i64_to_string(value_id as i64);
        let alloc_name = "mir.substr.alloc." + policy_i64_to_string(value_id as i64);
        let null_name = "mir.substr.null." + policy_i64_to_string(value_id as i64);
        let fill_name = "mir.substr.fill." + policy_i64_to_string(value_id as i64);
        let join_name = "mir.substr.join." + policy_i64_to_string(value_id as i64);
        let empty_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           empty_name.c_str(),
                                           empty_name.len as u64);
        let alloc_bb = vyx_rt_append_block(self.mod,
                                           self.current_function_value,
                                           alloc_name.c_str(),
                                           alloc_name.len as u64);
        let null_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          null_name.c_str(),
                                          null_name.len as u64);
        let fill_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          fill_name.c_str(),
                                          fill_name.len as u64);
        let join_bb = vyx_rt_append_block(self.mod,
                                          self.current_function_value,
                                          join_name.c_str(),
                                          join_name.len as u64);
        if (empty_cond == null
            || new_len == null
            || str_ty == null
            || result_slot == null
            || empty_bb == null
            || alloc_bb == null
            || null_bb == null
            || fill_bb == null
            || join_bb == null) {
            self.report_error("cannot create substring control flow");
            return null;
        }

        vyx_rt_build_cond_br(self.mod, empty_cond, empty_bb, alloc_bb);

        vyx_rt_position_at_end(self.mod, empty_bb);
        let empty_value = self.emit_str_value("");
        if (empty_value == null) {
            self.report_error("cannot lower empty substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, empty_value, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, alloc_bb);
        let alloc_size = vyx_rt_build_add(self.mod,
                                          new_len,
                                          one,
                                          llvm_mir_empty_name(),
                                          0);
        let buf = vyx_rt_build_call1(self.mod,
                                     self.builtin_malloc_fty,
                                     self.builtin_malloc_fn,
                                     alloc_size,
                                     "mir.substr.buf".c_str(),
                                     14);
        let is_null = vyx_rt_build_icmp(self.mod,
                                        llvm_mir_icmp_eq(),
                                        buf,
                                        vyx_rt_const_ptr_null(self.mod, self.ty_ptr),
                                        llvm_mir_empty_name(),
                                        0);
        if (alloc_size == null || buf == null || is_null == null) {
            self.report_error("cannot allocate substring buffer");
            return null;
        }
        vyx_rt_build_cond_br(self.mod, is_null, null_bb, fill_bb);

        vyx_rt_position_at_end(self.mod, null_bb);
        let null_empty = self.emit_str_value("");
        if (null_empty == null) {
            self.report_error("cannot lower null substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, null_empty, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, fill_bb);
        let copy_src = self.ptr_offset_bytes(source_ptr, st, "mir.substr.src");
        let copy_end = self.ptr_offset_bytes(buf, new_len, "mir.substr.endptr");
        if (copy_src == null || copy_end == null) {
            self.report_error("cannot compute substring copy pointers");
            return null;
        }
        vyx_rt_build_call3(self.mod,
                           self.builtin_memcpy_fty,
                           self.builtin_memcpy_fn,
                           buf,
                           copy_src,
                           new_len,
                           llvm_mir_empty_name(),
                           0);
        vyx_rt_build_store(self.mod,
                           vyx_rt_const_int(self.mod, self.ty_i8, 0, 0),
                           copy_end);
        let out_value = self.emit_string_value_from_parts(buf,
                                                          new_len,
                                                          alloc_size,
                                                          vyx_rt_const_int(self.mod, self.ty_i64, 1, 0));
        if (out_value == null) {
            self.report_error("cannot assemble substring result");
            return null;
        }
        vyx_rt_build_store(self.mod, out_value, result_slot);
        vyx_rt_build_br(self.mod, join_bb);

        vyx_rt_position_at_end(self.mod, join_bb);
        return vyx_rt_build_load(self.mod,
                                 str_ty,
                                 result_slot,
                                 "mir.substr.value".c_str(),
                                 16);
    }

    public fn lower_string_len_call(self, value_id: i32) -> rawptr {
        var receiver_id = self.receiver_for_builtin_member_value(value_id);
        if (receiver_id == mir_id_invalid() && self.call_arg_count(value_id) == 1) {
            receiver_id = self.call_arg_at(value_id, 0);
        }
        if (receiver_id == mir_id_invalid()) {
            receiver_id = self.m.value_lhs(value_id);
        }
        if (receiver_id == mir_id_invalid()) {
            self.report_error("string length call is missing a receiver");
            return null;
        }
        if (!self.type_is_string_view_type(self.m.value_type(receiver_id))) {
            self.report_error("string length receiver is not str ABI");
            return null;
        }
        let value = self.lower_string_view_value(receiver_id);
        if (value == null) {
            self.report_error("cannot lower string length receiver");
            return null;
        }
        return self.string_len_value(value);
    }

    public fn lower_string_is_empty_call(self, value_id: i32) -> rawptr {
        let len_v = self.lower_string_len_call(value_id);
        if (len_v == null) {
            self.report_error("cannot lower string isEmpty receiver");
            return null;
        }
        return self.bool_value_i8(vyx_rt_build_icmp(self.mod,
                                                    llvm_mir_icmp_eq(),
                                                    len_v,
                                                    vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                                    llvm_mir_empty_name(),
                                                    0));
    }

    public fn lower_string_contains_call(self, value_id: i32) -> rawptr {
        if (self.builtin_string_index_of_fn == null || self.builtin_string_index_of_fty == null) {
            self.report_error("vyx_string_index_of declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("contains requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var needle_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            needle_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let needle_value = self.lower_string_view_value(needle_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let needle_ptr = self.string_ptr_value(needle_value);
        let hay_len = self.string_len_value(hay_value);
        let needle_len = self.string_len_value(needle_value);
        if (hay_value == null
            || needle_value == null
            || hay_ptr == null
            || needle_ptr == null
            || hay_len == null
            || needle_len == null) {
            self.report_error("cannot lower contains string operands");
            return null;
        }
        let found = vyx_rt_build_call4(self.mod,
                                       self.builtin_string_index_of_fty,
                                       self.builtin_string_index_of_fn,
                                       hay_ptr,
                                       hay_len,
                                       needle_ptr,
                                       needle_len,
                                       "mir.str.contains".c_str(),
                                       16);
        if (found == null) {
            self.report_error("cannot emit vyx_string_index_of for contains");
            return null;
        }
        let is_found = vyx_rt_build_icmp(self.mod,
                                         llvm_mir_icmp_sge(),
                                         found,
                                         vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                         llvm_mir_empty_name(),
                                         0);
        return self.bool_value_i8(is_found);
    }

    public fn lower_string_starts_with_call(self, value_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("startsWith requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var prefix_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            prefix_id = self.call_arg_at(value_id, 1);
        }
        let hay_ptr = self.string_cstr_from_value(receiver_id);
        let prefix_ptr = self.string_cstr_from_value(prefix_id);
        let hay_len = self.string_len_from_value(receiver_id);
        let prefix_len = self.string_len_from_value(prefix_id);
        if (hay_ptr == null || prefix_ptr == null || hay_len == null || prefix_len == null) {
            self.report_error("cannot lower startsWith string operands");
            return null;
        }
        let prefix_fits = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ule(),
                                            prefix_len,
                                            hay_len,
                                            llvm_mir_empty_name(),
                                            0);
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            hay_ptr,
                                            prefix_ptr,
                                            prefix_len,
                                            "mir.str.prefix".c_str(),
                                            14);
        if (native_cmp == null) {
            self.report_error("cannot emit strncmp for startsWith");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        return self.bool_value_i8(vyx_rt_build_and(self.mod, prefix_fits, content_same, llvm_mir_empty_name(), 0));
    }

    public fn lower_string_ends_with_call(self, value_id: i32) -> rawptr {
        if (self.builtin_strncmp_fn == null || self.builtin_strncmp_fty == null) {
            self.report_error("strncmp declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("endsWith requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var suffix_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            suffix_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let suffix_value = self.lower_string_view_value(suffix_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let suffix_ptr = self.string_ptr_value(suffix_value);
        let hay_len = self.string_len_value(hay_value);
        let suffix_len = self.string_len_value(suffix_value);
        if (hay_value == null
            || suffix_value == null
            || hay_ptr == null
            || suffix_ptr == null
            || hay_len == null
            || suffix_len == null) {
            self.report_error("cannot lower endsWith string operands");
            return null;
        }
        let suffix_fits = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_ule(),
                                            suffix_len,
                                            hay_len,
                                            llvm_mir_empty_name(),
                                            0);
        let offset = vyx_rt_build_sub(self.mod,
                                      hay_len,
                                      suffix_len,
                                      "mir.str.suffix.offset".c_str(),
                                      21);
        let safe_offset = vyx_rt_build_select(self.mod,
                                              suffix_fits,
                                              offset,
                                              vyx_rt_const_int(self.mod, self.ty_i64, 0, 0),
                                              "mir.str.suffix.safe.offset".c_str(),
                                              26);
        let suffix_start = self.ptr_offset_bytes(hay_ptr, safe_offset, "mir.str.suffix.ptr");
        let native_cmp = vyx_rt_build_call3(self.mod,
                                            self.builtin_strncmp_fty,
                                            self.builtin_strncmp_fn,
                                            suffix_start,
                                            suffix_ptr,
                                            suffix_len,
                                            "mir.str.suffix".c_str(),
                                            14);
        if (suffix_fits == null || offset == null || safe_offset == null || suffix_start == null || native_cmp == null) {
            self.report_error("cannot emit strncmp for endsWith");
            return null;
        }
        let content_same = vyx_rt_build_icmp(self.mod,
                                             llvm_mir_icmp_eq(),
                                             native_cmp,
                                             vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                             llvm_mir_empty_name(),
                                             0);
        return self.bool_value_i8(vyx_rt_build_and(self.mod, suffix_fits, content_same, llvm_mir_empty_name(), 0));
    }

    public fn lower_string_index_of_call(self, value_id: i32) -> rawptr {
        if (self.builtin_string_index_of_fn == null || self.builtin_string_index_of_fty == null) {
            self.report_error("vyx_string_index_of declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1 && self.call_arg_count(value_id) != 2) {
            self.report_error("indexOf requires receiver plus one argument");
            return null;
        }
        var receiver_id = self.receiver_for_builtin_call(value_id);
        var needle_id = self.call_arg_at(value_id, 0);
        if (self.call_arg_count(value_id) == 2) {
            receiver_id = self.call_arg_at(value_id, 0);
            needle_id = self.call_arg_at(value_id, 1);
        }
        let hay_value = self.lower_string_view_value(receiver_id);
        let needle_value = self.lower_string_view_value(needle_id);
        let hay_ptr = self.string_ptr_value(hay_value);
        let needle_ptr = self.string_ptr_value(needle_value);
        let hay_len = self.string_len_value(hay_value);
        let needle_len = self.string_len_value(needle_value);
        if (hay_value == null
            || needle_value == null
            || hay_ptr == null
            || needle_ptr == null
            || hay_len == null
            || needle_len == null) {
            self.report_error("cannot lower indexOf string operands");
            return null;
        }
        let found = vyx_rt_build_call4(self.mod,
                                       self.builtin_string_index_of_fty,
                                       self.builtin_string_index_of_fn,
                                       hay_ptr,
                                       hay_len,
                                       needle_ptr,
                                       needle_len,
                                       "mir.str.index".c_str(),
                                       13);
        if (found == null) {
            self.report_error("cannot emit vyx_string_index_of");
            return null;
        }
        return found;
    }

    public fn lower_fs_attrs_for_path_call(self, value_id: i32) -> rawptr {
        if (self.builtin_get_file_attrs_fn == null || self.builtin_get_file_attrs_fty == null) {
            self.report_error("GetFileAttributesA declaration is unavailable");
            return null;
        }
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("filesystem path predicate requires exactly one argument");
            return null;
        }
        let path_id = self.call_arg_at(value_id, 0);
        let path_ptr = self.string_cstr_from_value(path_id);
        if (path_ptr == null) {
            self.report_error("cannot lower filesystem path argument");
            return null;
        }
        let attrs = vyx_rt_build_call1(self.mod,
                                       self.builtin_get_file_attrs_fty,
                                       self.builtin_get_file_attrs_fn,
                                       path_ptr,
                                       "mir.fs.attrs".c_str(),
                                       12);
        if (attrs == null) {
            self.report_error("cannot emit GetFileAttributesA call");
            return null;
        }
        return attrs;
    }

    public fn lower_fs_path_predicate_call(self, value_id: i32, name: string) -> rawptr {
        let attrs = self.lower_fs_attrs_for_path_call(value_id);
        if (attrs == null) { return null; }
        let invalid = vyx_rt_const_int(self.mod, self.ty_i32, -1, 1);
        let exists = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_ne(),
                                       attrs,
                                       invalid,
                                       llvm_mir_empty_name(),
                                       0);
        if (name == "fileExists") { return self.bool_value_i8(exists); }
        let dir_bit = vyx_rt_build_and(self.mod,
                                       attrs,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 16, 0),
                                       llvm_mir_empty_name(),
                                       0);
        let is_dir = vyx_rt_build_icmp(self.mod,
                                       llvm_mir_icmp_ne(),
                                       dir_bit,
                                       vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                       llvm_mir_empty_name(),
                                       0);
        if (name == "isDir") {
            return self.bool_value_i8(vyx_rt_build_and(self.mod, exists, is_dir, llvm_mir_empty_name(), 0));
        }
        if (name == "isFile") {
            let not_dir = vyx_rt_build_icmp(self.mod,
                                            llvm_mir_icmp_eq(),
                                            dir_bit,
                                            vyx_rt_const_int(self.mod, self.ty_i32, 0, 0),
                                            llvm_mir_empty_name(),
                                            0);
            return self.bool_value_i8(vyx_rt_build_and(self.mod, exists, not_dir, llvm_mir_empty_name(), 0));
        }
        self.report_error("unknown filesystem path predicate " + name);
        return null;
    }

    public fn receiver_for_builtin_call(self, value_id: i32) -> i32 {
        let callee = self.m.value_lhs(value_id);
        if (callee != mir_id_invalid()) {
            let receiver = self.m.value_lhs(callee);
            if (receiver != mir_id_invalid()) { return receiver; }
        }
        if (self.call_arg_count(value_id) > 0) { return self.call_arg_at(value_id, 0); }
        return mir_id_invalid();
    }

    public fn receiver_for_builtin_member_value(self, value_id: i32) -> i32 {
        if (self.m.value_kind(value_id) == mir_value_target_ref()) {
            let receiver = self.m.value_lhs(value_id);
            if (receiver != mir_id_invalid()) { return receiver; }
        }
        return self.receiver_for_builtin_call(value_id);
    }

    public fn lower_std_string_raw_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 0) { return null; }
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) { return null; }
        if (!self.type_is_std_string_class(self.m.value_type(receiver_id))) { return null; }
        return self.lower_std_string_as_str_value(receiver_id);
    }

    public fn lower_string_builder_create_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 0) { return null; }
        if (self.builtin_string_builder_create_fn == null || self.builtin_string_builder_create_fty == null) { return null; }
        let ret_type = self.m.value_type(value_id);
        let ret_text = llvm_mir_type_text(&self.m, ret_type);
        if (!ret_text.contains("StringBuilder")) { return null; }
        return vyx_rt_build_call(self.mod,
                                 self.builtin_string_builder_create_fty,
                                 self.builtin_string_builder_create_fn,
                                 null,
                                 0,
                                 "mir.stringbuilder.create".c_str(),
                                 24);
    }

    public fn lower_string_builder_append_i64_call(self, value_id: i32) -> bool {
        if (self.call_arg_count(value_id) != 1) { return false; }
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) { return false; }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_text = llvm_mir_type_text(&self.m, receiver_type);
        if (!receiver_text.contains("StringBuilder")) { return false; }

        let arg_id = self.call_arg_at(value_id, 0);
        let arg_call_name = self.resolved_call_name(arg_id);
        if (!(arg_call_name == "toString" || arg_call_name == "to_string")) { return false; }
        let int_receiver_id = self.receiver_for_builtin_call(arg_id);
        if (int_receiver_id == mir_id_invalid()) { return false; }
        let int_receiver_type = self.m.value_type(int_receiver_id);
        let int_kind = llvm_mir_type_kind(&self.m, int_receiver_type);
        if (llvm_mir_int_bits_for_kind(int_kind) <= 0) { return false; }
        if (int_kind == ty_BOOL()) { return false; }

        let append_unsigned = llvm_mir_kind_decimal_unsigned(int_kind);
        var append_fn: rawptr = self.builtin_string_builder_append_i64_fn;
        var append_fty: rawptr = self.builtin_string_builder_append_i64_fty;
        if (append_unsigned) {
            append_fn = self.builtin_string_builder_append_u64_fn;
            append_fty = self.builtin_string_builder_append_u64_fty;
        }
        if (append_fn == null || append_fty == null) { return false; }

        let builder_addr = self.lower_self_receiver_address(receiver_id, receiver_type);
        let int_value = self.int_value_to_bits(self.lower_value(int_receiver_id), int_receiver_type, 64);
        if (builder_addr == null || int_value == null) {
            self.report_error("cannot lower StringBuilder.append integer fast path");
            return true;
        }
        vyx_rt_build_call2(self.mod,
                           append_fty,
                           append_fn,
                           builder_addr,
                           int_value,
                           llvm_mir_empty_name(),
                           0);
        return true;
    }

    public fn type_is_std_vec_type(self, type_id: i32) -> bool {
        if (type_id == mir_id_invalid()) { return false; }
        let text = llvm_mir_type_text(&self.m, type_id);
        if (text.len == 0) { return false; }
        var base = policy_generic_call_base(text.clone());
        if (base.len == 0) { base = text; }
        let last = self.last_path_segment(base);
        if (last == "Vec") { return true; }
        return text.contains("Vec<") || text.contains("Vec::<");
    }

    public fn vec_receiver_for_call(self, value_id: i32) -> i32 {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) { return mir_id_invalid(); }
        if (self.type_is_std_vec_type(self.value_effective_type(receiver_id))) { return receiver_id; }
        return mir_id_invalid();
    }

    public fn foreign_dci_owner_type_id(self, function_id: i32) -> i32 {
        let owner_id = mir_unit_foreign_dci_owner_type_id(&self.m, function_id);
        if (owner_id != mir_id_invalid()) { return owner_id; }
        let owner = mir_unit_foreign_dci_owner_type_text(&self.m, function_id);
        if (owner.len > 0) { return self.type_id_by_text(owner); }
        return mir_id_invalid();
    }

    public fn foreign_dci_owner_type_text(self, function_id: i32) -> string {
        return mir_unit_foreign_dci_owner_type_text(&self.m, function_id);
    }

    public fn lower_vec_element_ptr_from_index(self,
                                               receiver_id: i32,
                                               index_v: rawptr,
                                               label: string) -> rawptr {
        if (receiver_id == mir_id_invalid() || index_v == null) { return null; }
        let receiver_type = self.value_effective_type(receiver_id);
        if (!self.type_is_std_vec_type(receiver_type)) { return null; }
        let base_addr = self.lower_self_receiver_address(receiver_id, receiver_type);
        if (base_addr == null) {
            self.report_error("cannot lower Vec receiver address");
            return null;
        }
        let data_v = self.load_record_field_from_addr(base_addr, receiver_type, "data");
        let elem_size_v = self.load_record_field_from_addr(base_addr, receiver_type, "elem_size");
        if (data_v == null || elem_size_v == null) {
            self.report_error("cannot load Vec data/elem_size fields");
            return null;
        }
        let byte_offset = vyx_rt_build_mul(self.mod,
                                           index_v,
                                           elem_size_v,
                                           (label + ".off").c_str(),
                                           (label + ".off").len as u64);
        if (byte_offset == null) {
            self.report_error("cannot compute Vec element byte offset");
            return null;
        }
        return self.ptr_offset_bytes(data_v, byte_offset, label);
    }

    public fn lower_vec_get_unchecked_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) { return null; }
        let receiver_id = self.vec_receiver_for_call(value_id);
        if (receiver_id == mir_id_invalid()) { return null; }
        let index_id = self.call_arg_at(value_id, 0);
        let idx_v = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 64);
        let elem_ptr = self.lower_vec_element_ptr_from_index(receiver_id, idx_v, "mir.vec.get");
        let elem_type = self.value_effective_type(value_id);
        let elem_ty = self.lower_type(elem_type);
        if (idx_v == null || elem_ptr == null || elem_ty == null) {
            self.report_error("cannot lower Vec.get_unchecked fast path");
            return null;
        }
        if (self.type_is_class_pointer_abi(elem_type)) {
            return elem_ptr;
        }
        return vyx_rt_build_load(self.mod,
                                 elem_ty,
                                 elem_ptr,
                                 "mir.vec.get.value".c_str(),
                                 17);
    }

    public fn lower_vec_set_unchecked_call(self, value_id: i32) -> bool {
        if (self.call_arg_count(value_id) != 2) { return false; }
        let receiver_id = self.vec_receiver_for_call(value_id);
        if (receiver_id == mir_id_invalid()) { return false; }
        let index_id = self.call_arg_at(value_id, 0);
        let value_arg_id = self.call_arg_at(value_id, 1);
        let idx_v = self.int_value_to_bits(self.lower_value(index_id), self.m.value_type(index_id), 64);
        let elem_ptr = self.lower_vec_element_ptr_from_index(receiver_id, idx_v, "mir.vec.set");
        let value_type = self.value_effective_type(value_arg_id);
        if (idx_v == null || elem_ptr == null) {
            self.report_error("cannot lower Vec.set_unchecked fast path");
            return true;
        }
        if (!self.copy_value_storage_to_addr(elem_ptr, value_arg_id, value_type, "Vec.set_unchecked")) {
            return true;
        }
        return true;
    }

    public fn lower_vec_push_unchecked_call(self, value_id: i32) -> bool {
        if (self.call_arg_count(value_id) != 1) { return false; }
        let receiver_id = self.vec_receiver_for_call(value_id);
        if (receiver_id == mir_id_invalid()) { return false; }
        let receiver_type = self.value_effective_type(receiver_id);
        let base_addr = self.lower_self_receiver_address(receiver_id, receiver_type);
        let len_ptr = self.record_field_addr_for_type(base_addr, receiver_type, "len");
        if (base_addr == null || len_ptr == null) {
            self.report_error("cannot lower Vec.push_unchecked receiver");
            return true;
        }
        let len_v = vyx_rt_build_load(self.mod,
                                      self.ty_i64,
                                      len_ptr,
                                      "mir.vec.push.len".c_str(),
                                      16);
        let elem_ptr = self.lower_vec_element_ptr_from_index(receiver_id, len_v, "mir.vec.push");
        let value_arg_id = self.call_arg_at(value_id, 0);
        let value_type = self.value_effective_type(value_arg_id);
        if (len_v == null || elem_ptr == null) {
            self.report_error("cannot lower Vec.push_unchecked fast path");
            return true;
        }
        if (!self.copy_value_storage_to_addr(elem_ptr, value_arg_id, value_type, "Vec.push_unchecked")) {
            return true;
        }
        let new_len = vyx_rt_build_add(self.mod,
                                       len_v,
                                       vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                       "mir.vec.push.newlen".c_str(),
                                       19);
        if (new_len == null) {
            self.report_error("cannot update Vec len in push_unchecked fast path");
            return true;
        }
        vyx_rt_build_store(self.mod, new_len, len_ptr);
        return true;
    }

    public fn lower_to_string_call(self, value_id: i32) -> rawptr {
        let receiver_id = self.receiver_for_builtin_call(value_id);
        if (receiver_id == mir_id_invalid()) {
            self.report_error("toString requires a receiver");
            return null;
        }
        let receiver_type = self.m.value_type(receiver_id);
        let receiver_kind = llvm_mir_type_kind(&self.m, receiver_type);
        if (receiver_kind == ty_STRING()) {
            return self.lower_value(receiver_id);
        }
        if (receiver_kind == ty_BOOL()) {
            let as_i32 = self.int_value_to_bits(self.lower_value(receiver_id), receiver_type, 32);
            return self.string_value_from_bool_to_string(as_i32);
        }
        let bits = llvm_mir_int_bits_for_kind(receiver_kind);
        if (bits > 0) {
            let as_i64 = self.int_value_to_bits(self.lower_value(receiver_id), receiver_type, 64);
            return self.string_value_from_integer_to_string(
                as_i64,
                llvm_mir_kind_decimal_unsigned(receiver_kind));
        }
        if (llvm_mir_kind_float(receiver_kind)) {
            return self.float_value_to_string(receiver_id);
        }
        if (llvm_mir_kind_pointer_like(receiver_kind)) {
            var string_pointer = self.lower_value(receiver_id);
            if (llvm_mir_kind_pointer_handle(receiver_kind)) {
                string_pointer = self.pointer_handle_address(string_pointer, "mir.to_string.ptr");
            }
            let ptr_as_i64 = vyx_rt_build_ptr_to_int(self.mod,
                                                     string_pointer,
                                                     self.ty_i64,
                                                     llvm_mir_empty_name(),
                                                     0);
            return self.string_value_from_i64_to_string(ptr_as_i64);
        }
        self.report_error("cannot lower toString receiver type " + llvm_mir_type_text(&self.m, receiver_type));
        return null;
    }

    public fn lower_format_vararg_value(self, value_id: i32) -> rawptr {
        if (value_id == mir_id_invalid()) { return null; }
        let type_id = self.m.value_type(value_id);
        let kind = llvm_mir_type_kind(&self.m, type_id);
        if (self.type_is_string_view_type(type_id)) {
            return self.string_cstr_from_value(value_id);
        }
        if (kind == ty_F32()) {
            let v = self.lower_value(value_id);
            if (v == null) { return null; }
            return vyx_rt_build_fp_ext(self.mod,
                                       v,
                                       vyx_rt_float_type(self.mod, 64),
                                       llvm_mir_empty_name(),
                                       0);
        }
        if (kind == ty_F64()) { return self.lower_value(value_id); }
        let bits = llvm_mir_int_bits_for_kind(kind);
        if (bits > 0) {
            return self.int_value_to_bits(self.lower_value(value_id), type_id, 64);
        }
        if (llvm_mir_kind_pointer_like(kind)) {
            return self.lower_value_as(value_id, self.type_id_by_text("rawptr"));
        }
        self.report_error("format argument type is unsupported: " + llvm_mir_type_text(&self.m, type_id));
        return null;
    }

    public fn lower_format_call(self, value_id: i32) -> rawptr {
        let argc = self.call_arg_count(value_id);
        if (argc <= 0) {
            self.report_error("format requires a format string");
            return null;
        }
        if (self.builtin_snprintf_fn == null || self.builtin_snprintf_fty == null) {
            self.report_error("snprintf declaration is unavailable");
            return null;
        }
        let fmt_id = self.call_arg_at(value_id, 0);
        if (!self.type_is_string_view_type(self.m.value_type(fmt_id))) {
            self.report_error("format first argument must be str-compatible");
            return null;
        }
        let fmt_ptr = self.string_cstr_from_value(fmt_id);
        if (fmt_ptr == null) {
            self.report_error("cannot lower format string");
            return null;
        }
        let extra_count = argc - 1;
        var extra_buf: rawptr = null;
        if (extra_count > 0) {
            extra_buf = malloc((extra_count * 8) as u64);
            if (extra_buf == null) {
                self.report_error("cannot allocate format argument buffer");
                return null;
            }
        }
        var i: i32 = 0;
        while (i < extra_count) {
            let arg_id = self.call_arg_at(value_id, i + 1);
            let arg_value = self.lower_format_vararg_value(arg_id);
            if (arg_value == null) {
                if (extra_buf != null) { free(extra_buf); }
                self.report_error("cannot lower format argument #" + policy_i64_to_string(i as i64));
                return null;
            }
            ast_write_rawptr(ptr_offset(extra_buf, i * 8), arg_value);
            i = i + 1;
        }
        let total_arg_count = extra_count + 3;
        let size_args = malloc((total_arg_count * 8) as u64);
        if (size_args == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format sizing call arguments");
            return null;
        }
        ast_write_rawptr(size_args, vyx_rt_const_ptr_null(self.mod, self.ty_ptr));
        ast_write_rawptr(ptr_offset(size_args, 8), vyx_rt_const_int(self.mod, self.ty_i64, 0, 0));
        ast_write_rawptr(ptr_offset(size_args, 16), fmt_ptr);
        i = 0;
        while (i < extra_count) {
            ast_write_rawptr(ptr_offset(size_args, (i + 3) * 8),
                             ast_read_rawptr(ptr_offset(extra_buf, i * 8)));
            i = i + 1;
        }
        let needed32 = vyx_rt_build_call(self.mod,
                                         self.builtin_snprintf_fty,
                                         self.builtin_snprintf_fn,
                                         size_args,
                                         total_arg_count as u64,
                                         llvm_mir_empty_name(),
                                         0);
        free(size_args);
        if (needed32 == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot emit format sizing call");
            return null;
        }
        let needed64 = vyx_rt_build_sext(self.mod,
                                         needed32,
                                         self.ty_i64,
                                         "mir.format.len".c_str(),
                                         14);
        let data_size = vyx_rt_build_add(self.mod,
                                         needed64,
                                         vyx_rt_const_int(self.mod, self.ty_i64, 1, 0),
                                         "mir.format.cap".c_str(),
                                         14);
        let out_buf = self.alloc_string_data_with_cap(needed64, data_size);
        if (needed64 == null || data_size == null || out_buf == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format output");
            return null;
        }
        let write_args = malloc((total_arg_count * 8) as u64);
        if (write_args == null) {
            if (extra_buf != null) { free(extra_buf); }
            self.report_error("cannot allocate format write call arguments");
            return null;
        }
        ast_write_rawptr(write_args, out_buf);
        ast_write_rawptr(ptr_offset(write_args, 8), data_size);
        ast_write_rawptr(ptr_offset(write_args, 16), fmt_ptr);
        i = 0;
        while (i < extra_count) {
            ast_write_rawptr(ptr_offset(write_args, (i + 3) * 8),
                             ast_read_rawptr(ptr_offset(extra_buf, i * 8)));
            i = i + 1;
        }
        let wrote = vyx_rt_build_call(self.mod,
                                      self.builtin_snprintf_fty,
                                      self.builtin_snprintf_fn,
                                      write_args,
                                      total_arg_count as u64,
                                      llvm_mir_empty_name(),
                                      0);
        free(write_args);
        if (extra_buf != null) { free(extra_buf); }
        if (wrote == null) {
            self.report_error("cannot emit format write call");
            return null;
        }
        return self.emit_string_value_from_parts(out_buf,
                                                 needed64,
                                                 data_size,
                                                 vyx_rt_const_int(self.mod, self.ty_i64, 4, 0));
    }

    // These two runtime functions are the only standard-library Arc count
    // primitives. Lower them to LLVM seq_cst operations only for their exact
    // bodyless ABI declarations; arbitrary same-named Vyx functions keep the
    // ordinary call path.
    public fn lower_atomic_load_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("vyx_atomic_load_i64 requires exactly one argument");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        if (ptr_v == null) {
            self.report_error("cannot lower vyx_atomic_load_i64 pointer");
            return null;
        }
        let out = vyx_rt_build_atomic_load(self.mod,
                                           self.ty_i64,
                                           ptr_v,
                                           "mir.atomic.load.i64".c_str(),
                                           19);
        if (out == null) { self.report_error("cannot emit atomic i64 load"); }
        return out;
    }

    public fn lower_atomic_fetch_add_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("vyx_atomic_fetch_add_i64 requires exactly two arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let delta_id = self.call_arg_at(value_id, 1);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let delta_v = self.int_value_to_bits(self.lower_value(delta_id), self.m.value_type(delta_id), 64);
        if (ptr_v == null || delta_v == null) {
            self.report_error("cannot lower vyx_atomic_fetch_add_i64 operands");
            return null;
        }
        let out = vyx_rt_build_atomicrmw_add(self.mod,
                                             ptr_v,
                                             delta_v,
                                             "mir.atomic.add.i64".c_str(),
                                             18);
        if (out == null) { self.report_error("cannot emit atomic i64 add"); }
        return out;
    }

    public fn lower_atomic_compare_exchange_i64_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 3) {
            self.report_error("vyx_atomic_compare_exchange_i64 requires exactly three arguments");
            return null;
        }
        let ptr_id = self.call_arg_at(value_id, 0);
        let expected_id = self.call_arg_at(value_id, 1);
        let desired_id = self.call_arg_at(value_id, 2);
        let ptr_v = self.lower_value_as(ptr_id, self.type_id_by_text("rawptr"));
        let expected_v = self.int_value_to_bits(self.lower_value(expected_id),
                                                self.m.value_type(expected_id),
                                                64);
        let desired_v = self.int_value_to_bits(self.lower_value(desired_id),
                                               self.m.value_type(desired_id),
                                               64);
        if (ptr_v == null || expected_v == null || desired_v == null) {
            self.report_error("cannot lower vyx_atomic_compare_exchange_i64 operands");
            return null;
        }
        let out = vyx_rt_build_atomic_cmpxchg(self.mod,
                                              ptr_v,
                                              expected_v,
                                              desired_v,
                                              "mir.atomic.cmpxchg.i64".c_str(),
                                              22);
        if (out == null) { self.report_error("cannot emit atomic i64 compare/exchange"); }
        return out;
    }

    public fn lower_malloc_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("malloc requires exactly one argument");
            return null;
        }
        if (self.builtin_malloc_fn == null || self.builtin_malloc_fty == null) {
            self.report_error("malloc declaration is unavailable");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let size_v = self.int_value_to_bits(self.lower_value(arg_id), self.m.value_type(arg_id), 64);
        if (size_v == null) {
            self.report_error("cannot lower malloc size argument");
            return null;
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_malloc_fty,
                                  self.builtin_malloc_fn,
                                  size_v,
                                  "mir.malloc".c_str(),
                                  10);
    }

    public fn lower_free_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("free requires exactly one argument");
            return null;
        }
        if (self.builtin_free_fn == null || self.builtin_free_fty == null) {
            self.report_error("free declaration is unavailable");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let raw_v = self.lower_value(arg_id);
        if (raw_v == null) {
            self.report_error("cannot lower free pointer argument");
            return null;
        }
        let arg_kind = llvm_mir_type_kind(&self.m, self.m.value_type(arg_id));
        var ptr_v = raw_v;
        if (llvm_mir_kind_pointer_handle(arg_kind)) {
            let metadata = self.pointer_handle_metadata(raw_v, "mir.free");
            if (metadata == null) {
                self.report_error("cannot extract pointer region for free");
                return null;
            }
            let released_address = self.pointer_region_delete(metadata);
            if (released_address == null) {
                self.report_error("cannot invalidate pointer region for free");
                return null;
            }
            return vyx_rt_build_call1(self.mod,
                                      self.builtin_free_fty,
                                      self.builtin_free_fn,
                                      released_address,
                                      llvm_mir_empty_name(),
                                      0);
        }
        if (!llvm_mir_kind_pointer_like(arg_kind)) {
            let bits = llvm_mir_int_bits_for_kind(arg_kind);
            if (bits <= 0) {
                self.report_error("free pointer argument is not pointer-like");
                return null;
            }
            var as_int = raw_v;
            if (bits < 64) { as_int = vyx_rt_build_zext(self.mod, raw_v, self.ty_i64, llvm_mir_empty_name(), 0); }
            if (bits > 64) { as_int = vyx_rt_build_trunc(self.mod, raw_v, self.ty_i64, llvm_mir_empty_name(), 0); }
            ptr_v = vyx_rt_build_int_to_ptr(self.mod, as_int, self.ty_ptr, llvm_mir_empty_name(), 0);
        }
        return vyx_rt_build_call1(self.mod,
                                  self.builtin_free_fty,
                                  self.builtin_free_fn,
                                  ptr_v,
                                  llvm_mir_empty_name(),
                                   0);
    }

    public fn lower_transmute_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 1) {
            self.report_error("transmute requires exactly one argument");
            return null;
        }
        let arg_id = self.call_arg_at(value_id, 0);
        let dst_type = self.m.value_type(value_id);
        let arg_type = self.m.value_type(arg_id);
        let arg_value = self.lower_value(arg_id);
        if (arg_value == null || dst_type == mir_id_invalid()) {
            self.report_error("cannot lower transmute operand");
            return null;
        }
        if (arg_type == dst_type) { return arg_value; }
        let arg_kind = llvm_mir_type_kind(&self.m, arg_type);
        let dst_kind = llvm_mir_type_kind(&self.m, dst_type);
        if (llvm_mir_kind_pointer_like(arg_kind) && llvm_mir_kind_pointer_like(dst_kind)) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        if (llvm_mir_kind_pointer_like(arg_kind) && llvm_mir_int_bits_for_kind(dst_kind) > 0) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        if (llvm_mir_int_bits_for_kind(arg_kind) > 0 && llvm_mir_kind_pointer_like(dst_kind)) {
            return self.cast_value(arg_value, arg_type, dst_type);
        }
        return self.cast_value(arg_value, arg_type, dst_type);
    }

    public fn lower_realloc_call(self, value_id: i32) -> rawptr {
        if (self.call_arg_count(value_id) != 2) {
            self.report_error("realloc requires exactly two arguments");
