fn hir_name_id_map_ensure_buckets(map: HirNameIdMap) -> HirNameIdMap {
    if (map.buckets != null && map.bucket_cap > 0) { return map; }
    map.bucket_cap = 65536;
    map.buckets = hir_builder_alloc_ptr_buckets(map.bucket_cap);
    if (map.buckets == null) {
        map.bucket_cap = 0;
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        let key = ast_borrow_c_string(ptr, len);
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        ast_write_rawptr(ptr_offset(cur, 32), ast_read_rawptr(slot_ptr));
        ast_write_rawptr(slot_ptr, cur);
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return map;
}

fn hir_name_id_map_put(map: HirNameIdMap, key: string, value: i32) -> HirNameIdMap {
    if (key.len == 0 || value == hir_id_invalid()) { return map; }
    map = hir_name_id_map_ensure_buckets(map);
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var cur = ast_read_rawptr(slot_ptr);
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                ast_write_i32(ptr_offset(cur, 16), value);
                return map;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return map; }
        memset(node, 0, 40);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), map.head);
        ast_write_rawptr(ptr_offset(node, 32), ast_read_rawptr(slot_ptr));
        map.head = node;
        ast_write_rawptr(slot_ptr, node);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            ast_write_i32(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = hir_profile_malloc(40);
    if (node == null) { return map; }
    memset(node, 0, 40);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    ast_write_rawptr(ptr_offset(node, 32), null);
    map.head = node;
    return map;
}

fn hir_name_id_map_put_first(map: HirNameIdMap, key: string, value: i32) -> HirNameIdMap {
    if (key.len == 0 || value == hir_id_invalid()) { return map; }
    if (hir_name_id_map_get(map, key) != hir_id_invalid()) { return map; }
    return hir_name_id_map_put(map, key, value);
}

fn hir_name_id_map_get(map: HirNameIdMap, key: string) -> i32 {
    if (key.len == 0) { return hir_id_invalid(); }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        var cur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return hir_id_invalid();
}

fn hir_name_id_map_dispose(map: HirNameIdMap) -> HirNameIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
            free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}

class HirPairRawMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirPairRawMap {
        return HirPairRawMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 40));
            let owner_ptr = ast_read_rawptr(cur);
            let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
            if (owner_ptr != null) { free(owner_ptr); }
            if (member_ptr != null) { free(member_ptr); }
            free(cur);
            cur = next;
        }
        if (self.buckets != null) { free(self.buckets); }
        self.head = null;
        self.buckets = null;
        self.bucket_cap = 0;
    }

    fn put(self, owner: string, member: string, value: rawptr) {
        if (owner.len == 0 || member.len == 0 || value == null) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                if (hir_pair_key_matches(bcur, owner, member)) {
                    ast_write_rawptr(ptr_offset(bcur, 32), value);
                    return;
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 48));
            }
            let bnode = hir_profile_malloc(56);
            if (bnode == null) { return; }
            memset(bnode, 0, 56);
            ast_write_rawptr(bnode, ast_dup_c_string(owner));
            ast_write_i64(ptr_offset(bnode, 8), owner.len);
            ast_write_rawptr(ptr_offset(bnode, 16), ast_dup_c_string(member));
            ast_write_i64(ptr_offset(bnode, 24), member.len);
            ast_write_rawptr(ptr_offset(bnode, 32), value);
            ast_write_rawptr(ptr_offset(bnode, 40), self.head);
            ast_write_rawptr(ptr_offset(bnode, 48), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            return;
        }
        var cur = self.head;
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                ast_write_rawptr(ptr_offset(cur, 32), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        let node = hir_profile_malloc(56);
        if (node == null) { return; }
        memset(node, 0, 56);
        ast_write_rawptr(node, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(node, 8), owner.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(node, 24), member.len);
        ast_write_rawptr(ptr_offset(node, 32), value);
        ast_write_rawptr(ptr_offset(node, 40), self.head);
        ast_write_rawptr(ptr_offset(node, 48), null);
        self.head = node;
    }

    fn get(self, owner: string, member: string) -> rawptr {
        if (owner.len == 0 || member.len == 0) { return null; }
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (hir_pair_key_matches(bcur, owner, member)) {
                    return ast_read_rawptr(ptr_offset(bcur, 32));
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 48));
            }
            return null;
        }
        var cur = self.head;
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                return ast_read_rawptr(ptr_offset(cur, 32));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return null;
    }

    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 65536;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let owner_ptr = ast_read_rawptr(cur);
            let owner_len = ast_read_i64(ptr_offset(cur, 8));
            let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
            let member_len = ast_read_i64(ptr_offset(cur, 24));
            let owner = ast_borrow_c_string(owner_ptr, owner_len);
            let member = ast_borrow_c_string(member_ptr, member_len);
            let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 48), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
    }
}

fn hir_pair_raw_map_create() -> HirPairRawMap {
    return HirPairRawMap.create();
}

fn hir_pair_key_matches(node: rawptr, owner: string, member: string) -> bool {
    if (node == null || owner.len == 0 || member.len == 0) { return false; }
    let owner_ptr = ast_read_rawptr(node);
    let owner_len = ast_read_i64(ptr_offset(node, 8));
    if (!hir_builder_c_string_equals(owner_ptr, owner_len, owner)) { return false; }
    let member_ptr = ast_read_rawptr(ptr_offset(node, 16));
    let member_len = ast_read_i64(ptr_offset(node, 24));
    return hir_builder_c_string_equals(member_ptr, member_len, member);
}

fn hir_pair_raw_map_put(map: HirPairRawMap, owner: string, member: string, value: rawptr) -> HirPairRawMap {
    if (owner.len == 0 || member.len == 0 || value == null) { return map; }
    map.ensure_buckets();
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var bcur = ast_read_rawptr(slot_ptr);
        while (bcur != null) {
            if (hir_pair_key_matches(bcur, owner, member)) {
                ast_write_rawptr(ptr_offset(bcur, 32), value);
                return map;
            }
            bcur = ast_read_rawptr(ptr_offset(bcur, 48));
        }
        let bnode = hir_profile_malloc(56);
        if (bnode == null) { return map; }
        memset(bnode, 0, 56);
        ast_write_rawptr(bnode, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(bnode, 8), owner.len);
        ast_write_rawptr(ptr_offset(bnode, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(bnode, 24), member.len);
        ast_write_rawptr(ptr_offset(bnode, 32), value);
        ast_write_rawptr(ptr_offset(bnode, 40), map.head);
        ast_write_rawptr(ptr_offset(bnode, 48), ast_read_rawptr(slot_ptr));
        map.head = bnode;
        ast_write_rawptr(slot_ptr, bnode);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        if (hir_pair_key_matches(cur, owner, member)) {
            ast_write_rawptr(ptr_offset(cur, 32), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    let node = hir_profile_malloc(56);
    if (node == null) { return map; }
    memset(node, 0, 56);
    ast_write_rawptr(node, ast_dup_c_string(owner));
    ast_write_i64(ptr_offset(node, 8), owner.len);
    ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
    ast_write_i64(ptr_offset(node, 24), member.len);
    ast_write_rawptr(ptr_offset(node, 32), value);
    ast_write_rawptr(ptr_offset(node, 40), map.head);
    ast_write_rawptr(ptr_offset(node, 48), null);
    map.head = node;
    return map;
}

fn hir_pair_raw_map_get(map: HirPairRawMap, owner: string, member: string) -> rawptr {
    if (owner.len == 0 || member.len == 0) { return null; }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), map.bucket_cap);
        var bcur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (bcur != null) {
            if (hir_pair_key_matches(bcur, owner, member)) {
                return ast_read_rawptr(ptr_offset(bcur, 32));
            }
            bcur = ast_read_rawptr(ptr_offset(bcur, 48));
        }
        return null;
    }
    var cur = map.head;
    while (cur != null) {
        if (hir_pair_key_matches(cur, owner, member)) {
            return ast_read_rawptr(ptr_offset(cur, 32));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    return null;
}

fn hir_pair_raw_map_dispose(map: HirPairRawMap) -> HirPairRawMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 40));
        let owner_ptr = ast_read_rawptr(cur);
        let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        if (owner_ptr != null) { free(owner_ptr); }
        if (member_ptr != null) { free(member_ptr); }
        free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}

class HirPairIdMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirPairIdMap {
        return HirPairIdMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 40));
            let owner_ptr = ast_read_rawptr(cur);
            let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
            if (owner_ptr != null) { free(owner_ptr); }
            if (member_ptr != null) { free(member_ptr); }
            free(cur);
            cur = next;
        }
        if (self.buckets != null) { free(self.buckets); }
        self.head = null;
        self.buckets = null;
        self.bucket_cap = 0;
    }

    fn put(self, owner: string, member: string, value: i32) {
        if (owner.len == 0 || member.len == 0 || value == hir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                ast_write_i32(ptr_offset(cur, 32), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        let node = hir_profile_malloc(48);
        if (node == null) { return; }
        memset(node, 0, 48);
        ast_write_rawptr(node, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(node, 8), owner.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(node, 24), member.len);
        ast_write_i32(ptr_offset(node, 32), value);
        ast_write_rawptr(ptr_offset(node, 40), self.head);
        self.head = node;
    }

    fn get(self, owner: string, member: string) -> i32 {
        if (owner.len == 0 || member.len == 0) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                return ast_read_i32(ptr_offset(cur, 32));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return hir_id_invalid();
    }
}

fn hir_pair_id_map_create() -> HirPairIdMap {
    return HirPairIdMap.create();
}

fn hir_pair_id_map_ensure_buckets(map: HirPairIdMap) -> HirPairIdMap {
    if (map.buckets != null && map.bucket_cap > 0) { return map; }
    map.bucket_cap = 65536;
    map.buckets = hir_builder_alloc_ptr_buckets(map.bucket_cap);
    if (map.buckets == null) {
        map.bucket_cap = 0;
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let owner_ptr = ast_read_rawptr(cur);
        let owner_len = ast_read_i64(ptr_offset(cur, 8));
        let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        let member_len = ast_read_i64(ptr_offset(cur, 24));
        let owner_key = ast_borrow_c_string(owner_ptr, owner_len);
        let member_key = ast_borrow_c_string(member_ptr, member_len);
        let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner_key, member_key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        ast_write_rawptr(ptr_offset(cur, 48), ast_read_rawptr(slot_ptr));
        ast_write_rawptr(slot_ptr, cur);
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    return map;
}

fn hir_pair_id_map_put(map: HirPairIdMap, owner: string, member: string, value: i32) -> HirPairIdMap {
    if (owner.len == 0 || member.len == 0 || value == hir_id_invalid()) { return map; }
    map = hir_pair_id_map_ensure_buckets(map);
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var cur = ast_read_rawptr(slot_ptr);
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                ast_write_i32(ptr_offset(cur, 32), value);
                return map;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 48));
        }
        let node = hir_profile_malloc(56);
        if (node == null) { return map; }
        memset(node, 0, 56);
        ast_write_rawptr(node, ast_dup_c_string(owner));
        ast_write_i64(ptr_offset(node, 8), owner.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
        ast_write_i64(ptr_offset(node, 24), member.len);
        ast_write_i32(ptr_offset(node, 32), value);
        ast_write_rawptr(ptr_offset(node, 40), map.head);
        ast_write_rawptr(ptr_offset(node, 48), ast_read_rawptr(slot_ptr));
        map.head = node;
        ast_write_rawptr(slot_ptr, node);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        if (hir_pair_key_matches(cur, owner, member)) {
            ast_write_i32(ptr_offset(cur, 32), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    let node = hir_profile_malloc(56);
    if (node == null) { return map; }
    memset(node, 0, 56);
    ast_write_rawptr(node, ast_dup_c_string(owner));
    ast_write_i64(ptr_offset(node, 8), owner.len);
    ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(member));
    ast_write_i64(ptr_offset(node, 24), member.len);
    ast_write_i32(ptr_offset(node, 32), value);
    ast_write_rawptr(ptr_offset(node, 40), map.head);
    ast_write_rawptr(ptr_offset(node, 48), null);
    map.head = node;
    return map;
}

fn hir_pair_id_map_get(map: HirPairIdMap, owner: string, member: string) -> i32 {
    if (owner.len == 0 || member.len == 0) { return hir_id_invalid(); }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_pair_hash_i32(owner, member), map.bucket_cap);
        var cur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (cur != null) {
            if (hir_pair_key_matches(cur, owner, member)) {
                return ast_read_i32(ptr_offset(cur, 32));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 48));
        }
        return hir_id_invalid();
    }
    var cur = map.head;
    while (cur != null) {
        if (hir_pair_key_matches(cur, owner, member)) {
            return ast_read_i32(ptr_offset(cur, 32));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 40));
    }
    return hir_id_invalid();
}

fn hir_pair_id_map_dispose(map: HirPairIdMap) -> HirPairIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 40));
        let owner_ptr = ast_read_rawptr(cur);
        let member_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        if (owner_ptr != null) { free(owner_ptr); }
        if (member_ptr != null) { free(member_ptr); }
        free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}

class HirIntIdMap {
    public head: rawptr

    public static fn create() -> HirIntIdMap {
        return HirIntIdMap { head: null };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 8));
            free(cur);
            cur = next;
        }
        self.head = null;
    }

    fn put(self, key: i32, value: i32) {
        if (key == hir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == key) {
                ast_write_i32(ptr_offset(cur, 4), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let node = hir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, key);
        ast_write_i32(ptr_offset(node, 4), value);
        ast_write_rawptr(ptr_offset(node, 8), self.head);
        self.head = node;
    }

    fn get(self, key: i32) -> i32 {
        if (key == hir_id_invalid()) { return -1; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == key) {
                return ast_read_i32(ptr_offset(cur, 4));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return -1;
    }
}

fn hir_int_id_map_create() -> HirIntIdMap {
    return HirIntIdMap.create();
}

fn hir_int_id_map_put(map: HirIntIdMap, key: i32, value: i32) -> HirIntIdMap {
    if (key == hir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_i32(cur) == key) {
            ast_write_i32(ptr_offset(cur, 4), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 8));
    }
    let node = hir_profile_malloc(16);
    if (node == null) { return map; }
    memset(node, 0, 16);
    ast_write_i32(node, key);
    ast_write_i32(ptr_offset(node, 4), value);
    ast_write_rawptr(ptr_offset(node, 8), map.head);
    map.head = node;
    return map;
}

fn hir_int_id_map_get(map: HirIntIdMap, key: i32) -> i32 {
    if (key == hir_id_invalid()) { return -1; }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_i32(cur) == key) {
            return ast_read_i32(ptr_offset(cur, 4));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 8));
    }
    return -1;
}

fn hir_int_id_map_dispose(map: HirIntIdMap) -> HirIntIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 8));
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn hir_i32_array_map_create(initial_count: i32) -> rawptr {
    var cap = initial_count;
    if (cap < 1024) { cap = 1024; }
    let header = hir_profile_malloc(16);
    if (header == null) { return null; }
    memset(header, 0, 16);
    let bytes = ((cap + 1) * 4) as u64;
    let buf = hir_profile_malloc(bytes);
    if (buf == null) {
        free(header);
        return null;
    }
    memset(buf, 0, bytes);
    ast_write_rawptr(header, buf);
    ast_write_i32(ptr_offset(header, 8), cap);
    return header;
}

fn hir_i32_array_map_get(map: rawptr, id: i32) -> i32 {
    if (map == null || id <= 0) { return -1; }
    let cap = ast_read_i32(ptr_offset(map, 8));
    if (id > cap) { return -1; }
    let buf = ast_read_rawptr(map);
    if (buf == null) { return -1; }
    let value = ast_read_i32(ptr_offset(buf, id * 4));
    if (value == 0) { return -1; }
    return value - 1;
}

fn hir_i32_array_map_ensure(map: rawptr, id: i32) -> rawptr {
    if (id <= 0) { return map; }
    var out = map;
    if (out == null) { out = hir_i32_array_map_create(id); }
    if (out == null) { return null; }
    var cap = ast_read_i32(ptr_offset(out, 8));
    if (id <= cap) { return out; }
    var new_cap = cap;
    if (new_cap < 1024) { new_cap = 1024; }
    while (new_cap < id) { new_cap = new_cap * 2; }
    let old_buf = ast_read_rawptr(out);
    let new_bytes = ((new_cap + 1) * 4) as u64;
    let new_buf = hir_profile_malloc(new_bytes);
    if (new_buf == null) { return out; }
    memset(new_buf, 0, new_bytes);
    if (old_buf != null && cap > 0) {
        memcpy(new_buf, old_buf, ((cap + 1) * 4) as u64);
        free(old_buf);
    }
    ast_write_rawptr(out, new_buf);
    ast_write_i32(ptr_offset(out, 8), new_cap);
    return out;
}

fn hir_i32_array_map_put(map: rawptr, id: i32, value: i32) -> rawptr {
    if (id <= 0 || value < 0) { return map; }
    var out = hir_i32_array_map_ensure(map, id);
    if (out == null) { return map; }
    let buf = ast_read_rawptr(out);
    if (buf == null) { return out; }
    ast_write_i32(ptr_offset(buf, id * 4), value + 1);
    return out;
}

fn hir_i32_array_map_dispose(map: rawptr) -> rawptr {
    if (map == null) { return null; }
    let buf = ast_read_rawptr(map);
    if (buf != null) { free(buf); }
    free(map);
    return null;
}

class HirStmtChain {
    public first: i32
    public last: i32
    public count: i32

    public static fn empty() -> HirStmtChain {
        return HirStmtChain { first: hir_id_invalid(), last: hir_id_invalid(), count: 0 };
    }
}

