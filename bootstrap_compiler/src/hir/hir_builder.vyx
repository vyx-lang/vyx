module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

extern "C" {
    fn getenv(name: rawptr) -> rawptr;
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strncmp(a: rawptr, b: rawptr, n: i64) -> i32;
    fn vyx_bootstrap_profile_level() -> i32;
    fn vyx_bootstrap_now_ms() -> i64;
    fn vyx_rt_process_private_bytes() -> i64;
    fn vyx_rt_process_working_set_bytes() -> i64;
    fn vyx_rt_heap_trim();
    fn vyx_forget_string_len(s: rawptr);
    fn cJSON_Parse(value: rawptr) -> rawptr;
    fn cJSON_Delete(item: rawptr);
    fn cJSON_GetObjectItemCaseSensitive(object: rawptr, string: rawptr) -> rawptr;
    fn cJSON_GetArraySize(array: rawptr) -> i32;
    fn cJSON_GetArrayItem(array: rawptr, index: i32) -> rawptr;
    fn cJSON_GetStringValue(item: rawptr) -> rawptr;
    fn cJSON_IsTrue(item: rawptr) -> i32;
    fn cJSON_IsString(item: rawptr) -> i32;
    fn cJSON_IsArray(item: rawptr) -> i32;
    fn cJSON_IsObject(item: rawptr) -> i32;
}
// Older bootstrap seeds resolve this as a generic helper. Current compilers
// reserve the same name as a backend-representation layout builtin.
fn repr_sizeof<T>() -> i64 {
    return sizeof::<T>();
}

fn hir_builder_env_value(name: string) -> string {
    let raw = getenv(name.c_str());
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

fn hir_builder_env_enabled(name: string) -> bool {
    let value = hir_builder_env_value(name).trim();
    if (value.len == 0) { return false; }
    if (value == "0" || value == "false" || value == "FALSE"
        || value == "no" || value == "NO" || value == "off" || value == "OFF") {
        return false;
    }
    return true;
}

fn hir_builder_parse_i64(text: string) -> i64 {
    let s = text.trim();
    if (s.len == 0) { return 0; }
    var i: i32 = 0;
    var sign: i64 = 1;
    var out: i64 = 0;
    if (s.charAt(0) == 45) {
        sign = -1;
        i = 1;
    } else if (s.charAt(0) == 43) {
        i = 1;
    }
    while (i < s.len) {
        let c = s.charAt(i);
        if (c < 48 || c > 57) { return out * sign; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out * sign;
}

fn hir_builder_slow_body_threshold_ms() -> i64 {
    let parsed = hir_builder_parse_i64(hir_builder_env_value("VYX_HIR_SLOW_BODY_MS"));
    if (parsed > 0) { return parsed; }
    return 1000;
}

fn hir_builder_slow_stmt_threshold_ms() -> i64 {
    let parsed = hir_builder_parse_i64(hir_builder_env_value("VYX_HIR_SLOW_STMT_MS"));
    if (parsed > 0) { return parsed; }
    return 100;
}

fn hir_builder_slow_expr_threshold_ms() -> i64 {
    let parsed = hir_builder_parse_i64(hir_builder_env_value("VYX_HIR_SLOW_EXPR_MS"));
    if (parsed > 0) { return parsed; }
    return 100;
}

fn hir_builder_c_string_equals(ptr: rawptr, len: i64, value: string) -> bool {
    if (ptr == null || len != value.len) { return false; }
    if (len == 0) { return value.len == 0; }
    return strncmp(ptr, value.c_str(), len) == 0;
}

var g_hir_profile_malloc_bytes: i64 = 0;
var g_hir_profile_malloc_next: i64 = 67108864;

fn hir_profile_malloc(size: u64) -> rawptr {
    let p = malloc(size);
    if (p != null && vyx_bootstrap_profile_level() > 0) {
        g_hir_profile_malloc_bytes = g_hir_profile_malloc_bytes + (size as i64);
        while (g_hir_profile_malloc_bytes >= g_hir_profile_malloc_next) {
            print("[hir-malloc] bytes=" + policy_i64_to_string(g_hir_profile_malloc_bytes));
            g_hir_profile_malloc_next = g_hir_profile_malloc_next + 67108864;
        }
    }
    return p;
}

fn hir_builder_memory_mb_text(bytes: i64) -> string {
    if (bytes < 0) { return "-1"; }
    return policy_i64_to_string(bytes / 1048576);
}

fn hir_builder_string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    var i: i64 = 0;
    while (i + needle.len <= hay.len) {
        var j: i64 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt((i + j) as i32) != needle.charAt(j as i32)) { same = false; }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_method_name_matches_lookup(candidate: string, requested: string) -> bool {
    if (candidate == requested) { return true; }
    let legacy = policy_operator_legacy_method_name(requested);
    if (legacy.len > 0 && candidate == legacy) { return true; }
    let symbol = policy_operator_symbol_method_name(requested);
    if (symbol.len > 0 && candidate == symbol) { return true; }
    return false;
}

fn hir_builder_symbol_segment_for_name(name: string) -> string {
    return policy_mangle_part(name);
}

fn hir_builder_assoc_separator_index(name: string) -> i32 {
    var last: i32 = -1;
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        let c = name.charAt(i);
        if (c == 60) {
            depth = depth + 1;
        } else if (c == 62) {
            if (depth > 0) { depth = depth - 1; }
        } else if (depth == 0) {
            if (c == 46) {
                last = i;
            } else if (c == 58 && i + 1 < name.len && name.charAt(i + 1) == 58) {
                if (!(i + 2 < name.len && name.charAt(i + 2) == 60)) {
                    last = i;
                }
                i = i + 1;
            }
        }
        i = i + 1;
    }
    return last;
}

fn hir_builder_assoc_separator_len(name: string, index: i32) -> i32 {
    if (index >= 0 && index < name.len && name.charAt(index) == 58) { return 2; }
    return 1;
}

fn hir_builder_type_text_needs_env_resolution(text: string) -> bool {
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 60 || c == 46) { return true; }
        if (c == 58 && i + 1 < text.len && text.charAt(i + 1) == 58) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_trim(s: string) -> string {
    if (s.len == 0) { return ""; }
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end) {
        let c = s.charAt(start);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        start = start + 1;
    }
    while (end > start) {
        let c = s.charAt(end - 1);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        end = end - 1;
    }
    return s.substring(start, end);
}

fn hir_builder_string_is_i64_lit(s: string) -> bool {
    let clean = hir_builder_trim(s);
    let n = clean.len;
    if (n == 0) { return false; }
    var i: i32 = 0;
    if (clean.charAt(0) == 45) {
        if (n == 1) { return false; }
        i = 1;
    }
    while (i < n) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn hir_builder_lit_is_float(s: string) -> bool {
    let n = s.len;
    if (n <= 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        let c = s.charAt(i);
        if (c == 46) { return true; }
        if (c == 101 || c == 69) {
            var j = i + 1;
            if (j < n) {
                let next = s.charAt(j);
                if (next == 43 || next == 45) { j = j + 1; }
            }
            if (j < n) {
                let digit = s.charAt(j);
                if (digit >= 48 && digit <= 57) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

fn hir_builder_parse_i64_lit(s: string) -> i64 {
    let clean = hir_builder_trim(s);
    var sign: i64 = 1;
    var i: i32 = 0;
    if (clean.len > 0 && clean.charAt(0) == 45) {
        sign = -1;
        i = 1;
    }
    var out: i64 = 0;
    while (i < clean.len) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return 0; }
        out = out * 10 + ((c - 48) as i64);
        i = i + 1;
    }
    return out * sign;
}

fn hir_builder_tuple_member_index(name: string) -> i32 {
    if (name.len == 0) { return -1; }
    var i: i32 = 0;
    if (name.charAt(0) == 95) { i = 1; }
    if (i >= name.len) { return -1; }
    var out: i32 = 0;
    while (i < name.len) {
        let c = name.charAt(i);
        if (c < 48 || c > 57) { return -1; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out;
}

fn hir_builder_decl_imported(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|imported");
}

// Versioned `.vyi` AST graph declarations carry executable generic bodies and
// private helper dependencies.  They remain imported for visibility/ODR, but
// unlike a signature-only interface they are an authoritative body source for
// AOT monomorphisation.
fn hir_builder_decl_template_artifact(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|template-artifact");
}

fn hir_builder_decl_is_foreign_dci(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|extern_abi:dci")
        || hir_builder_string_contains(decl_get_meta(d), "|foreign_dci")
        || hir_builder_string_contains(decl_get_meta(d), "|extern_abi:cpp")
        || hir_builder_string_contains(decl_get_meta(d), "|foreign_cpp");
}

fn hir_builder_decl_is_foreign_cpp(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|extern_abi:cpp")
        || hir_builder_string_contains(decl_get_meta(d), "|foreign_cpp");
}

// A native (non-foreign) `class`/`struct` record is a value type: it lives in
// automatic storage like a C++ value object and is passed/returned by value
// through the struct ABI.  `struct` already carries generic flag bit 4; plain
// `class` (no interface/error bit) now shares the same value ABI.  Foreign DCI
// records without a stable value layout, interfaces/traits (bit 2), error
// records (bit 1), and enums keep their own ABIs and are excluded here.
fn hir_builder_decl_is_value_type_record(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (decl_get_kind(d) != de_CLASS()) { return false; }
    let flags = decl_get_generic_flags(d);
    if ((flags & 2) != 0) { return false; }
    if ((flags & 1) != 0) { return false; }
    if (hir_builder_decl_is_foreign_dci(d)) { return false; }
    return true;
}

fn hir_builder_decl_is_foreign_dci_native(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && (hir_builder_string_contains(decl_get_meta(d), "|foreign_dci_native")
            || hir_builder_string_contains(decl_get_meta(d), "|foreign_cpp_native"));
}

fn hir_builder_decl_is_foreign_dci_ctor(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && (hir_builder_string_contains(decl_get_meta(d), "|foreign_dci_ctor")
            || hir_builder_string_contains(decl_get_meta(d), "|foreign_cpp_ctor")
            || hir_builder_string_contains(decl_get_generic_params(d), "|kind:constructor"));
}

fn hir_builder_decl_is_foreign_dci_dtor(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && (hir_builder_string_contains(decl_get_meta(d), "|foreign_dci_dtor")
            || hir_builder_string_contains(decl_get_meta(d), "|foreign_cpp_dtor")
            || hir_builder_string_contains(decl_get_generic_params(d), "|kind:destructor"));
}

fn hir_builder_decl_is_foreign_dci_const_method(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && (hir_builder_string_contains(decl_get_generic_params(d), "|dci_const")
            || hir_builder_string_contains(decl_get_generic_params(d), "|cpp_const"));
}

fn hir_builder_decl_has_marker(d: rawptr, marker: string) -> bool {
    if (d == null || marker.len == 0) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|marker:" + marker);
}

fn hir_builder_decl_is_foreign_dci_virtual_method(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && hir_builder_decl_has_marker(d, "virtual");
}

fn hir_builder_decl_is_foreign_dci_override_method(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && hir_builder_decl_has_marker(d, "override");
}

fn hir_builder_decl_is_foreign_dci_final_method(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_decl_is_foreign_dci(d)
        && hir_builder_decl_has_marker(d, "final");
}

fn hir_builder_decl_from_std_module(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    return hir_builder_string_contains(meta, "|from:std.")
        || hir_builder_string_contains(meta, "|from:std|");
}

fn hir_builder_decl_source_module(d: rawptr) -> string {
    if (d == null) { return ""; }
    let meta = decl_get_meta(d);
    let artifact_needle = "artifact-module-name:";
    let artifact_at = meta.indexOf(artifact_needle);
    if (artifact_at >= 0) {
        let start = artifact_at + artifact_needle.len;
        var end = start;
        while (end < meta.len && meta.charAt(end) != 124) { end = end + 1; }
        if (end > start) { return meta.substring(start, end); }
    }
    let needle = "|from:";
    var i: i32 = 0;
    while (i + needle.len <= meta.len) {
        if (meta.substring(i, i + needle.len) == needle) {
            let start = i + needle.len;
            var end = start;
            while (end < meta.len && meta.charAt(end) != 124) {
                end = end + 1;
            }
            if (end > start) { return meta.substring(start, end); }
            return "";
        }
        i = i + 1;
    }
    return "";
}

/// An imported version can intentionally retain the exact same language ABI
/// as another version.  Keep both the declaration's source module and its
/// physical owner module: migration merges can re-home a historical clone
/// beneath the newest class while retaining the old source marker.
/// Project-local crate members (from `--project-unit-sources`) also need a
/// module discriminator so same-named functions in different modules do
/// not collide inside one LLVM module.
fn hir_builder_decl_symbol_discriminator(d: rawptr, owner_decl: rawptr) -> string {
    // An interface-recorded `@[source(...)]` attribute is authoritative: the
    // producing DLL embedded that discriminator in its symbols, and the
    // consuming compile (whose decls are plain |imported|, not
    // |project-local|) must reproduce the same segment for the link to bind.
    let stamped = policy_meta_attribute_value(decl_get_meta(d), "source");
    if (stamped.len > 0) { return "source=" + stamped; }
    let source_module = hir_builder_decl_source_module(d);
    let owner_module = hir_builder_decl_source_module(owner_decl);
    if (policy_module_version(source_module).len == 0
        && policy_module_version(owner_module).len == 0) {
        if (d != null
            && hir_builder_string_contains(decl_get_meta(d), "|project-local")
            && source_module.len > 0) {
            return "source=" + source_module;
        }
        return "";
    }
    return "source=" + source_module + "|owner=" + owner_module;
}

fn hir_builder_decl_has_attr(d: rawptr, attr: string) -> bool {
    if (d == null || attr.len == 0) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), attr);
}

fn hir_builder_index_of(hay: string, needle: string) -> i32 {
    if (needle.len == 0) { return 0; }
    if (hay.len < needle.len) { return -1; }
    var i: i32 = 0;
    while (i + needle.len <= hay.len) {
        var j: i32 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt(i + j) != needle.charAt(j)) { same = false; }
            j = j + 1;
        }
        if (same) { return i; }
        i = i + 1;
    }
    return -1;
}

fn hir_builder_decl_has_exact_attr(d: rawptr, attr: string) -> bool {
    if (d == null || attr.len == 0) { return false; }
    let meta = decl_get_meta(d);
    if (!hir_builder_string_contains(meta, "|attrs:")) { return false; }
    if (hir_builder_index_of(meta, "@[" + attr + "]") >= 0) { return true; }
    if (hir_builder_index_of(meta, "@[" + attr + "(") >= 0) { return true; }
    if (hir_builder_index_of(meta, "@" + attr + "(") >= 0) { return true; }
    if (hir_builder_index_of(meta, "@" + attr + ",") >= 0) { return true; }
    if (hir_builder_index_of(meta, "@" + attr + "|") >= 0) { return true; }
    return meta.endsWith("@" + attr);
}

fn hir_builder_decl_attr_value(d: rawptr, attr: string) -> string {
    if (d == null || attr.len == 0) { return ""; }
    let meta = decl_get_meta(d);
    if (!hir_builder_string_contains(meta, "|attrs:")) { return ""; }
    var pat = "@[" + attr + "(";
    var pos = hir_builder_index_of(meta, pat);
    if (pos < 0) {
        pat = "@" + attr + "(";
        pos = hir_builder_index_of(meta, pat);
    }
    if (pos < 0) { return ""; }
    let start = pos + pat.len;
    var i = start;
    var depth: i32 = 1;
    while (i < meta.len) {
        let ch = meta.charAt(i);
        if (ch == 40) {
            depth = depth + 1;
        } elif (ch == 41) {
            depth = depth - 1;
            if (depth == 0) { return meta.substring(start, i); }
        }
        i = i + 1;
    }
    return "";
}

/// The source spelling of a field replaced by a field-level migration.
/// A migrated field is one storage slot: the historical spelling is only a
/// lookup alias and must never materialize as a second HIR/MIR layout field.
fn hir_builder_field_migrate_from_field(d: rawptr) -> string {
    if (d == null || decl_get_kind(d) != de_FIELD()) { return ""; }
    // Historical field aliases are a lowering consequence of a validated
    // MOSP migrate.collect result.  Sema may inspect the source spelling for
    // diagnostics, but HIR must not materialize an alias from unvalidated
    // metadata alone.
    if (!hir_builder_string_contains(decl_get_meta(d), "|effect:migrate|")) { return ""; }
    let args = hir_builder_decl_attr_value(d, "migrate");
    if (args.len == 0) { return ""; }
    return policy_strip_quoted_string(
        policy_named_argument_value(args, "fromField"));
}

/// True when `d` carries `@[discard(...)]` — a *tombstone*.
///
/// A discarded symbol is deliberately body-less: the annotation records
/// "this name stopped existing in this version", and the declaration
/// survives purely so version resolution can still resolve the historical
/// spelling (`add4@1.0.0["_1"]`) for callers that pin an older version.
/// It is metadata about a removal, never a definition, so demanding a
/// function body from one is a category error.
///
/// `Sema.report_discarded_callable` already turns every actual *use* into a
/// precise diagnostic pointing at that historical spelling; what must never
/// happen is the codegen reachability sweep asking a tombstone for a body.
fn hir_builder_decl_is_discarded(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    if (meta.len == 0) { return false; }
    return hir_builder_string_contains(meta, "@[discard(")
        || hir_builder_string_contains(meta, "@discard(");
}

fn hir_builder_strip_quotes(s: string) -> string {
    if (s.len >= 2 && s.charAt(0) == 34 && s.charAt(s.len - 1) == 34) {
        return s.substring(1, s.len - 1);
    }
    return s;
}

fn hir_builder_first_string_arg(value: string) -> string {
    var start: i32 = -1;
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 34) {
            if (start < 0) {
                start = i + 1;
            } else {
                return value.substring(start, i);
            }
        }
        i = i + 1;
    }
    return "";
}

fn hir_builder_line_blob_contains(rows: string, value: string) -> bool {
    let needle = hir_builder_trim(value);
    if (needle.len == 0) { return true; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (hir_builder_trim(rows.substring(start, i)) == needle) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn hir_builder_append_unique_line(rows: string, value: string) -> string {
    let clean = hir_builder_trim(value);
    if (clean.len == 0 || hir_builder_line_blob_contains(rows, clean)) { return rows; }
    if (rows.len == 0) { return clean; }
    return rows + "\n" + clean;
}

fn hir_builder_append_string_args_as_lines(rows: string, value: string) -> string {
    var out = rows;
    var start: i32 = -1;
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 34) {
            if (start < 0) {
                start = i + 1;
            } else {
                out = hir_builder_append_unique_line(out, value.substring(start, i));
                start = -1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn hir_builder_append_cpp_include_attr_value(rows: string, value: string) -> string {
    var out = hir_builder_append_string_args_as_lines(rows, value);
    if (out != rows) { return out; }
    let clean = hir_builder_trim(hir_builder_strip_quotes(value));
    if (clean.len == 0) { return out; }
    return hir_builder_append_unique_line(out, clean);
}

fn hir_builder_append_cpp_include_attrs(rows: string, d: rawptr) -> string {
    var out = rows;
    var value = hir_builder_decl_attr_value(d, "cpp_include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    value = hir_builder_decl_attr_value(d, "cxx_include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    value = hir_builder_decl_attr_value(d, "include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    return out;
}

fn hir_builder_alias_blob_from_attr(value: string) -> string {
    let alias_pos = hir_builder_index_of(value, "alias=");
    if (alias_pos < 0) { return ""; }
    var i = alias_pos + 6;
    while (i < value.len && value.charAt(i) == 32) { i = i + 1; }
    var out: string = "";
    if (i < value.len && value.charAt(i) == 91) {
        i = i + 1;
        var quote_start: i32 = -1;
        while (i < value.len && value.charAt(i) != 93) {
            let ch = value.charAt(i);
            if (ch == 34) {
                if (quote_start < 0) {
                    quote_start = i + 1;
                } else {
                    if (out.len > 0) { out = out + ","; }
                    out = out + value.substring(quote_start, i);
                    quote_start = -1;
                }
            }
            i = i + 1;
        }
        return out;
    }
    if (i < value.len && value.charAt(i) == 34) {
        return hir_builder_first_string_arg(value.substring(i, value.len));
    }
    return "";
}

fn hir_builder_decl_has_hidden_attr(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "hidden")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "Hidden")) { return true; }
    return hir_builder_decl_has_exact_attr(d, "HIDDEN");
}

fn hir_builder_decl_has_reflect_attr(d: rawptr) -> bool {
    if (d == null) { return false; }
    // Reflection metadata and method roots may only consume an accepted
    // compiler-owned Effect result. Unknown/custom attributes stay inert.
    if (!hir_builder_string_contains(decl_get_meta(d), "|effect:reflect|")) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "reflect")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "Reflect")) { return true; }
    return hir_builder_decl_has_exact_attr(d, "REFLECT");
}

fn hir_builder_vis_is_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn hir_builder_vis_trim(s: string) -> string {
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end && hir_builder_vis_is_space(s.charAt(start))) { start = start + 1; }
    while (end > start && hir_builder_vis_is_space(s.charAt(end - 1))) { end = end - 1; }
    if (start == 0 && end == (s.len as i32)) { return s; }
    return s.substring(start, end);
}

fn hir_builder_vis_outer_parens(s: string) -> bool {
    let t = hir_builder_vis_trim(s);
    if (t.len < 2) { return false; }
    if (t.charAt(0) != 40 || t.charAt(t.len - 1) != 41) { return false; }
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < t.len) {
        let c = t.charAt(i);
        if (c == 40) {
            depth = depth + 1;
        } elif (c == 41) {
            depth = depth - 1;
            if (depth == 0 && i != t.len - 1) { return false; }
        }
        if (depth < 0) { return false; }
        i = i + 1;
    }
    return depth == 0;
}

fn hir_builder_vis_strip_outer_parens(s: string) -> string {
    var out = hir_builder_vis_trim(s);
    var changed: bool = true;
    while (changed && hir_builder_vis_outer_parens(out)) {
        changed = false;
        out = hir_builder_vis_trim(out.substring(1, out.len - 1));
        changed = true;
    }
    return out;
}

fn hir_builder_vis_find_top_addsub(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && (c == 43 || c == 45)) { return i; }
        i = i - 1;
    }
    return -1;
}

fn hir_builder_vis_find_top_and(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && c == 38) { return i; }
        i = i - 1;
    }
    return -1;
}

fn hir_builder_vis_expr_exports_world(expr_raw: string) -> bool {
    let expr = hir_builder_vis_strip_outer_parens(expr_raw);
    if (expr.len == 0) { return false; }
    let addsub = hir_builder_vis_find_top_addsub(expr);
    if (addsub >= 0) {
        let lhs = hir_builder_vis_expr_exports_world(expr.substring(0, addsub));
        let rhs = hir_builder_vis_expr_exports_world(expr.substring(addsub + 1, expr.len));
        if (expr.charAt(addsub) == 43) { return lhs || rhs; }
        return lhs && !rhs;
    }
    let and_pos = hir_builder_vis_find_top_and(expr);
    if (and_pos >= 0) {
        return hir_builder_vis_expr_exports_world(expr.substring(0, and_pos))
            && hir_builder_vis_expr_exports_world(expr.substring(and_pos + 1, expr.len));
    }
    return expr == "world" || expr == "public";
}

fn hir_builder_decl_visibility_expr(d: rawptr) -> string {
    if (d == null) { return "self"; }
    var expr = hir_builder_decl_attr_value(d, "vis");
    if (expr.len == 0) { expr = hir_builder_decl_attr_value(d, "visibility"); }
    if (expr.len > 0) { return hir_builder_vis_trim(expr); }
    let meta = decl_get_meta(d);
    if (hir_builder_string_contains(meta, "|vis:public")) { return "world"; }
    if (hir_builder_string_contains(meta, "|vis:private")) { return "self"; }
    if (hir_builder_string_contains(meta, "|vis:internal")) { return "package"; }
    if (hir_builder_string_contains(meta, "|vis:protected")) { return "tree"; }
    if (decl_get_is_public(d)) { return "world"; }
    return "self";
}

fn hir_builder_decl_exports_world(d: rawptr) -> bool {
    return hir_builder_vis_expr_exports_world(hir_builder_decl_visibility_expr(d));
}

fn hir_builder_decl_visibility_is_none(d: rawptr) -> bool {
    return hir_builder_vis_strip_outer_parens(hir_builder_decl_visibility_expr(d)) == "none";
}

fn hir_builder_reflect_decl_name(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return decl_get_name(d); }
    let first_string = hir_builder_first_string_arg(value);
    if (first_string.len > 0) { return first_string; }
    value = hir_builder_strip_quotes(value);
    if (value.len == 0) { return decl_get_name(d); }
    if (hir_builder_index_of(value, "alias=") >= 0 || hir_builder_index_of(value, "visibility=") >= 0) {
        return decl_get_name(d);
    }
    return value;
}

fn hir_builder_reflect_alias_blob(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return ""; }
    return hir_builder_alias_blob_from_attr(value);
}

fn hir_builder_reflect_attr_visibility(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return ""; }
    if (hir_builder_index_of(value, "visibility=private") >= 0) { return "private"; }
    if (hir_builder_index_of(value, "visibility=internal") >= 0) { return "internal"; }
    if (hir_builder_index_of(value, "visibility=protected") >= 0) { return "protected"; }
    if (hir_builder_index_of(value, "visibility=public") >= 0) { return "public"; }
    return "";
}

fn hir_builder_decl_is_assoc_const(d: rawptr) -> bool {
    if (d == null) { return false; }
    return (decl_get_generic_flags(d) & 8) != 0;
}

fn hir_builder_decl_is_assoc_type(d: rawptr) -> bool {
    if (d == null || decl_get_kind(d) != de_FIELD()) { return false; }
    return (decl_get_generic_flags(d) & 16) != 0;
}

fn hir_builder_decl_is_layout_field(d: rawptr) -> bool {
    if (d == null || decl_get_kind(d) != de_FIELD()) { return false; }
    if (hir_builder_decl_is_assoc_const(d) || hir_builder_decl_is_assoc_type(d)) { return false; }
    return true;
}

fn hir_builder_decl_is_variadic_param(d: rawptr) -> bool {
    if (d == null) { return false; }
    return (decl_get_generic_flags(d) & 32) != 0;
}

fn hir_builder_count_non_variadic_params(params: rawptr) -> i32 {
    var n: i32 = 0;
    var cur = params;
    while (cur != null) {
        if (!hir_builder_decl_is_variadic_param(cur)) { n = n + 1; }
        cur = decl_get_next(cur);
    }
    return n;
}

fn hir_builder_reflect_kind_for_type_name(name: string) -> string {
    if (name.len == 0) { return "class"; }
    let prim = policy_primitive_type_kind(name);
    if (prim == 11) { return "bool"; }
    if (prim == 13) { return "string"; }
    if (name == "Range") { return "range"; }
    if (prim == 16 || prim == 17) { return "float"; }
    if (prim == 1 || prim == 2 || prim == 3 || prim == 4 || prim == 5
        || prim == 6 || prim == 7 || prim == 8 || prim == 9 || prim == 10) {
        return "int";
    }
    if (prim == 14 || prim == 15) { return name; }
    return "class";
}

fn hir_builder_reflect_symbol_id(symbol_name: string) -> i64 {
    var h: i64 = 1125899907;
    var i: i32 = 0;
    while (i < symbol_name.len) {
        h = ((h * 131) + (symbol_name.charAt(i) as i64)) % 2147483647;
        if (h < 0) { h = -h; }
        i = i + 1;
    }
    if (h == 0) { return 1; }
    return h;
}

fn hir_builder_method_decl_has_receiver(method_decl: rawptr) -> bool {
    if (method_decl == null) { return false; }
    let first_param = decl_get_params(method_decl);
    return first_param != null && decl_get_name(first_param) == "self";
}

fn hir_builder_self_receiver_is_owning(param: rawptr) -> bool {
    if (param == null || decl_get_name(param) != "self") { return false; }
    let markers = decl_get_generic_params(param);
    return hir_builder_string_contains(markers, "|receiver:own_mut")
        || hir_builder_string_contains(markers, "|receiver:own");
}

fn hir_builder_self_receiver_mode_flags(param: rawptr) -> i32 {
    if (param == null || decl_get_name(param) != "self") { return 0; }
    let markers = decl_get_generic_params(param);
    if (hir_builder_string_contains(markers, "|receiver:own_mut")
        || hir_builder_string_contains(markers, "|receiver:own")) {
        return hir_local_flag_move_arg();
    }
    if (hir_builder_string_contains(markers, "|receiver:shared")) {
        return hir_local_flag_self_shared_ref();
    }
    if (hir_builder_string_contains(markers, "|receiver:mut")) {
        return hir_local_flag_self_mut_ref();
    }
    return hir_local_flag_self_compat();
}

fn hir_builder_method_decl_has_synthetic_impl_self(method_decl: rawptr) -> bool {
    if (method_decl == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(method_decl), "|impl_synthetic_self");
}

fn hir_builder_method_decl_matches_static_use(method_decl: rawptr, want_static: bool) -> bool {
    if (method_decl == null) { return false; }
    if (want_static) {
        if (decl_get_is_static(method_decl)) { return true; }
        if (hir_builder_method_decl_has_synthetic_impl_self(method_decl)) { return true; }
        return !hir_builder_method_decl_has_receiver(method_decl);
    }
    return !decl_get_is_static(method_decl);
}

fn hir_builder_specialized_symbol_from_args(base: string, args: string) -> string {
    var out = base + "__";
    var idx: i32 = 0;
    while (idx < 64) {
        let arg = policy_generic_arg_at(args, idx);
        if (arg.len == 0) { return out; }
        if (idx > 0) { out = out.clone() + "_"; }
        let mangled_arg = policy_mangle_part(arg);
        out = out.clone() + mangled_arg;
        idx = idx + 1;
    }
    return out;
}

fn hir_builder_method_symbol_segment(method_name: string) -> string {
    var i: i32 = 0;
    while (i < method_name.len) {
        let c = method_name.charAt(i);
        let is_digit = c >= 48 && c <= 57;
        let is_upper = c >= 65 && c <= 90;
        let is_lower = c >= 97 && c <= 122;
        if (!(is_digit || is_upper || is_lower || c == 95)) {
            return policy_mangle_part(method_name);
        }
        i = i + 1;
    }
    return method_name;
}

fn hir_builder_primitive_method_symbol_base(class_base: string, method_name: string) -> string {
    var prim = class_base;
    let last = hir_builder_last_path_segment(class_base);
    let method_segment = hir_builder_method_symbol_segment(method_name);
    if (policy_primitive_type_kind(prim) == 0 && policy_primitive_type_kind(last) != 0) {
        prim = last;
    }
    if (policy_primitive_type_kind(prim) != 0) {
        return "__vyx_prim_" + policy_mangle_part(prim) + "_" + method_segment;
    }
    return class_base + "_" + method_segment;
}

fn hir_builder_class_method_symbol_name(class_name: string, method_name: string) -> string {
    var base = class_name;
    var args: string = "";
    if (policy_generic_call_has_args(class_name) != 0) {
        base = policy_generic_call_base(class_name);
        args = policy_generic_call_args(class_name);
    }
    let flat = hir_builder_primitive_method_symbol_base(base, method_name);
    if (args.len == 0) { return flat; }
    return hir_builder_specialized_symbol_from_args(flat, args);
}

fn hir_builder_decl_is_task_callable(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    // MOSP Effect owns async/task authorization.  Sema has already validated
    // the handler schema and stamped this marker for a planned callback;
    // accepting it here makes the result observable by the real coroutine
    // lowering instead of leaving async as a planner-only fact.
    if (hir_builder_string_contains(meta, "|effect:async|")) { return true; }
    // Keep old markers for imported artifacts, but do not let a raw source
    // attribute bypass MOSP's validated async/task handler.  Sema prepares
    // this marker before HIR construction; malformed or unregistered attrs
    // therefore cannot silently turn a function into a coroutine.
    let has_async_attr = hir_builder_string_contains(meta, "|attrs:async")
        || hir_builder_string_contains(meta, "|attrs:task")
        || hir_builder_string_contains(meta, "@[async")
        || hir_builder_string_contains(meta, "@async")
        || hir_builder_string_contains(meta, "@[task")
        || hir_builder_string_contains(meta, "@task");
    if (has_async_attr) { return false; }
    if (hir_builder_string_contains(meta, "|marker:async")) { return true; }
    if (hir_builder_string_contains(meta, "|marker:task")) { return true; }
    return false;
}

fn hir_builder_decl_template_head(d: rawptr) -> bool {
    if (d == null) { return false; }
    let gp = decl_get_generic_params(d);
    if (gp.len == 0) { return false; }
    if (gp.charAt(0) == 124) { return false; }
    if (hir_builder_meta_is_full_concrete_spec(gp)) { return false; }
    return true;
}

fn hir_builder_generic_name_looks_like_placeholder(name: string) -> bool {
    if (name.len == 0) { return false; }
    let c = name.charAt(0);
    return c >= 65 && c <= 90;
}

fn hir_builder_is_primitive_str_name(name: string) -> bool {
    return name == "str" || name == "string" || name == "__String";
}

fn hir_builder_concrete_generic_name(name: string) -> bool {
    if (policy_primitive_type_kind(name) != 0) { return true; }
    if (hir_builder_is_primitive_str_name(name)) { return true; }
    if (name.len > 0 && !hir_builder_generic_name_looks_like_placeholder(name)) { return true; }
    return false;
}

fn hir_builder_meta_is_full_concrete_spec(meta: string) -> bool {
    if (meta.len == 0 || meta.charAt(0) == 124) { return false; }
    var saw: bool = false;
    let n = meta.len;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= n) {
        if (i == n || meta.charAt(i) == 44 || meta.charAt(i) == 124) {
            let part = meta.substring(start, i);
            if (part.len == 0) { return false; }
            if (!hir_builder_concrete_generic_name(part)) { return false; }
            saw = true;
            if (i < n && meta.charAt(i) == 124) { return saw; }
            start = i + 1;
        }
        i = i + 1;
    }
    return saw;
}

fn hir_builder_decl_template_params(d: rawptr) -> string {
    if (d == null) { return ""; }
    let gp = decl_get_generic_params(d);
    if (hir_builder_meta_is_full_concrete_spec(gp)) { return ""; }
    return hir_builder_generic_head(gp);
}

fn hir_builder_decl_concrete_spec_args(d: rawptr) -> string {
    if (d == null) { return ""; }
    let gp = decl_get_generic_params(d);
    if (!hir_builder_meta_is_full_concrete_spec(gp)) { return ""; }
    return hir_builder_generic_head(gp);
}

fn hir_builder_body_ready(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_string_contains(decl_get_meta(d), "|hir_facts_resolved");
}

fn hir_builder_body_resolved(d: rawptr) -> bool {
    if (d == null) { return false; }
    let meta = decl_get_meta(d);
    return hir_builder_string_contains(meta, "|hir_facts_resolved")
        || hir_builder_string_contains(meta, "|body_resolved");
}

fn hir_builder_generic_head(gp: string) -> string {
    if (gp.len == 0) { return ""; }
    var i: i32 = 0;
    while (i < gp.len) {
        if (gp.charAt(i) == 124) {
            return gp.substring(0, i);
        }
        i = i + 1;
    }
    return gp;
}

fn hir_builder_peel_handle_type_text(text: string) -> string {
    var cur = text;
    var depth: i32 = 0;
    while (depth < 4 && cur.len > 0) {
        let base = policy_generic_call_base(cur.clone());
        if (base != "ref" && base != "mutref" && base != "ptr") { return cur; }
        let inner = policy_generic_arg_at(policy_generic_call_args(cur.clone()), 0);
        if (inner.len == 0) { return cur; }
        cur = inner;
        depth = depth + 1;
    }
    return cur;
}

fn hir_builder_generic_param_canonical(raw: string) -> string {
    if (raw.len == 0) { return ""; }
    var i: i32 = 0;
    while (i < raw.len) {
        if (raw.charAt(i) == 94) {
            return raw.substring(0, i);
        }
        i = i + 1;
    }
    return raw;
}

fn hir_builder_generic_param_at(params: string, idx: i32) -> string {
    return hir_builder_generic_param_canonical(policy_generic_param_at(params, idx));
}

fn hir_builder_const_arg_for_param(params: string, args: string, name: string) -> string {
    var idx: i32 = 0;
    while (idx < 64) {
        let p = hir_builder_generic_param_at(params, idx);
        if (p.len == 0) { return ""; }
        if (p == name) { return policy_generic_arg_at(args, idx); }
        idx = idx + 1;
    }
    return "";
}

fn hir_builder_const_expr_known(e: rawptr, params: string, args: string) -> bool {
    if (e == null) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT()) { return !hir_builder_lit_is_float(expr_get_str_val(e)); }
    if (k == ex_IDENT()) {
        let a = hir_builder_const_arg_for_param(params, args, expr_get_name(e));
        return hir_builder_string_is_i64_lit(a);
    }
    if (k == ex_UNARY() && expr_get_op(e) == tk_MINUS()) {
        return hir_builder_const_expr_known(expr_get_lhs(e), params, args);
    }
    if (k == ex_BIN()) {
        return hir_builder_const_expr_known(expr_get_lhs(e), params, args)
            && hir_builder_const_expr_known(expr_get_rhs(e), params, args);
    }
    return false;
}

fn hir_builder_const_expr_value(e: rawptr, params: string, args: string) -> i64 {
    if (e == null) { return 0; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT()) {
        if (hir_builder_lit_is_float(expr_get_str_val(e))) { return 0; }
        return expr_get_int_val(e);
    }
    if (k == ex_IDENT()) {
        return hir_builder_parse_i64_lit(hir_builder_const_arg_for_param(params, args, expr_get_name(e)));
    }
    if (k == ex_UNARY() && expr_get_op(e) == tk_MINUS()) {
        return 0 - hir_builder_const_expr_value(expr_get_lhs(e), params, args);
    }
    if (k == ex_BIN()) {
        let lhs = hir_builder_const_expr_value(expr_get_lhs(e), params, args);
        let rhs = hir_builder_const_expr_value(expr_get_rhs(e), params, args);
        let op = expr_get_op(e);
        if (op == tk_PLUS()) { return lhs + rhs; }
        if (op == tk_MINUS()) { return lhs - rhs; }
        if (op == tk_STAR()) { return lhs * rhs; }
        if (op == tk_SLASH()) {
            if (rhs == 0) { return 0; }
            return lhs / rhs;
        }
        if (op == tk_PERCENT()) {
            if (rhs == 0) { return 0; }
            return lhs % rhs;
        }
        if (op == tk_EQEQ()) {
            if (lhs == rhs) { return 1; }
            return 0;
        }
        if (op == tk_NEQ()) {
            if (lhs != rhs) { return 1; }
            return 0;
        }
        if (op == tk_LT()) {
            if (lhs < rhs) { return 1; }
            return 0;
        }
        if (op == tk_LE()) {
            if (lhs <= rhs) { return 1; }
            return 0;
        }
        if (op == tk_GT()) {
            if (lhs > rhs) { return 1; }
            return 0;
        }
        if (op == tk_GE()) {
            if (lhs >= rhs) { return 1; }
            return 0;
        }
    }
    return 0;
}

fn hir_builder_type_expr_text(e: rawptr) -> string {
    if (e == null) { return ""; }
    let k = expr_get_kind(e);
    if (k == ex_INT_LIT()) { return policy_i64_to_string(expr_get_int_val(e)); }
    if (k == ex_IDENT()) { return expr_get_name(e); }
    if (k == ex_BOOL_LIT()) {
        if (expr_get_int_val(e) == 0) { return "false"; }
        return "true";
    }
    if (k == ex_BIN()) {
        return hir_builder_type_expr_text(expr_get_lhs(e))
            + "#" + policy_i64_to_string(expr_get_op(e) as i64)
            + "#" + hir_builder_type_expr_text(expr_get_rhs(e));
    }
    if (k == ex_UNARY()) {
        return "u" + policy_i64_to_string(expr_get_op(e) as i64)
            + "(" + hir_builder_type_expr_text(expr_get_lhs(e)) + ")";
    }
    let name = expr_get_name(e);
    if (name.len > 0) {
        return "expr" + policy_i64_to_string(k as i64) + ":" + name;
    }
    return "expr" + policy_i64_to_string(k as i64);
}

fn hir_builder_const_expr_contains_param(e: rawptr, param: string) -> bool {
    if (e == null || param.len == 0) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_IDENT()) { return expr_get_name(e) == param; }
    if (k == ex_UNARY()) {
        return hir_builder_const_expr_contains_param(expr_get_lhs(e), param);
    }
    if (k == ex_BIN()) {
        return hir_builder_const_expr_contains_param(expr_get_lhs(e), param)
            || hir_builder_const_expr_contains_param(expr_get_rhs(e), param);
    }
    return false;
}

fn hir_builder_const_expr_has_template_atom(e: rawptr) -> bool {
    if (e == null) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_IDENT()) {
        return hir_builder_type_name_has_template_atom(expr_get_name(e));
    }
    if (k == ex_UNARY()) {
        return hir_builder_const_expr_has_template_atom(expr_get_lhs(e));
    }
    if (k == ex_BIN()) {
        return hir_builder_const_expr_has_template_atom(expr_get_lhs(e))
            || hir_builder_const_expr_has_template_atom(expr_get_rhs(e));
    }
    return false;
}

fn hir_builder_generic_contains(params: string, name: string) -> bool {
    if (params.len == 0 || name.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 64) {
        let p = hir_builder_generic_param_at(params, i);
        if (p.len == 0) { return false; }
        if (p == name) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_append_csv(base: string, next: string) -> string {
    if (next.len == 0) { return base; }
    if (base.len == 0) { return next; }
    return base + "," + next;
}

fn hir_builder_generic_arg_count(args: string) -> i32 {
    var count: i32 = 0;
    while (count < 256) {
        let part = policy_generic_arg_at(args, count);
        if (part.len == 0) { return count; }
        count = count + 1;
    }
    return count;
}

fn hir_builder_generic_param_count(params: string) -> i32 {
    var count: i32 = 0;
    while (count < 256) {
        let part = hir_builder_generic_param_at(params, count);
        if (part.len == 0) { return count; }
        count = count + 1;
    }
    return count;
}

fn hir_builder_env_args_cover_params(params: string, args: string) -> bool {
    if (params.len == 0) { return true; }
    var i: i32 = 0;
    while (i < 256) {
        let param = hir_builder_generic_param_at(params, i);
        if (param.len == 0) { return true; }
        if (policy_generic_arg_at(args, i).len == 0) { return false; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_generic_params_have_template_atom(params: string) -> bool {
    if (params.len == 0) { return false; }
    var i: i32 = 0;
    while (i < 256) {
        let part = hir_builder_generic_param_at(params, i);
        if (part.len == 0) { return false; }
        if (hir_builder_type_name_has_template_atom(part)) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_variadic_param(param: rawptr) -> bool {
    if (param == null) { return false; }
    // Variadic-ness is decided solely by the parser's `|variadic` marker,
    // mirroring the legacy codegen's decl_is_variadic_param (flag bit 32).
    // A name-based "args" heuristic used to live here and hijacked ordinary
    // params that happened to be called `args`: the pack path then expanded
    // them to zero locals, leaving body references with an empty LocalId.
    return hir_builder_string_contains(decl_get_generic_params(param), "|variadic");
}

fn hir_builder_c_varargs_param(param: rawptr) -> bool {
    if (param == null) { return false; }
    if (decl_get_name(param) == "__c_varargs") { return true; }
    return hir_builder_string_contains(decl_get_generic_params(param), "|c_varargs");
}

fn hir_builder_decl_has_c_varargs(d: rawptr) -> bool {
    if (d == null) { return false; }
    var param = decl_get_params(d);
    while (param != null) {
        if (hir_builder_c_varargs_param(param)) { return true; }
        param = decl_get_next(param);
    }
    return false;
}

fn hir_builder_parse_positive_i64(s: string) -> i64 {
    var n: i64 = 0;
    var i: i32 = 0;
    var any: bool = false;
    while (i < s.len) {
        let c = s.charAt(i);
        if (c >= 48 && c <= 57) {
            n = n * 10 + ((c - 48) as i64);
            any = true;
        } elif (any) {
            break;
        }
        i = i + 1;
    }
    if (!any) { return 0; }
    return n;
}

fn hir_builder_sanitize_align(n: i64) -> i64 {
    if (n == 1 || n == 2 || n == 4 || n == 8 || n == 16 || n == 32 || n == 64) {
        return n;
    }
    return 0;
}

fn hir_builder_decl_is_packed(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "packed")) { return true; }
    let repr = hir_builder_decl_attr_value(d, "repr");
    return hir_builder_string_contains(repr, "packed");
}

fn hir_builder_decl_repr_align(d: rawptr) -> i64 {
    if (d == null) { return 0; }
    let align_attr = hir_builder_decl_attr_value(d, "align");
    if (align_attr.len > 0) {
        let n = hir_builder_sanitize_align(hir_builder_parse_positive_i64(align_attr));
        if (n > 0) { return n; }
    }
    let repr = hir_builder_decl_attr_value(d, "repr");
    let pos = hir_builder_index_of(repr, "align(");
    if (pos >= 0) {
        return hir_builder_sanitize_align(hir_builder_parse_positive_i64(repr.substring(pos + 6, repr.len)));
    }
    return 0;
}

fn hir_builder_decl_has_repr_c(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "repr")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "packed")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "align")) { return true; }
    return false;
}

fn hir_builder_strip_c_symbol_name(raw: string) -> string {
    let quoted = hir_builder_first_string_arg(raw);
    if (quoted.len > 0) { return quoted; }
    return hir_builder_strip_quotes(hir_builder_trim(raw));
}

fn hir_builder_arg_expr_at(args: rawptr, want_idx: i32) -> rawptr {
    var idx: i32 = 0;
    var cur = args;
    while (cur != null) {
        if (idx == want_idx) { return stmt_get_init(cur); }
        idx = idx + 1;
        cur = stmt_get_next(cur);
    }
    return null;
}

fn hir_builder_type_ref_name(ty: rawptr) -> string {
    if (ty == null) { return ""; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS()) { return tref_get_name(ty); }
    if (k == ty_STRING()) { return "str"; }
    if (k == ty_I32()) { return "i32"; }
    if (k == ty_I64()) { return "i64"; }
    if (k == ty_BOOL()) { return "bool"; }
    if (k == ty_CHAR()) { return "char"; }
    if (k == ty_RAWPTR()) { return "rawptr"; }
    if (k == ty_F32()) { return "f32"; }
    if (k == ty_F64()) { return "f64"; }
    if (k == ty_I8()) { return "i8"; }
    if (k == ty_I16()) { return "i16"; }
    if (k == ty_U8()) { return "u8"; }
    if (k == ty_U16()) { return "u16"; }
    if (k == ty_U32()) { return "u32"; }
    if (k == ty_U64()) { return "u64"; }
    if (k == ty_ISIZE()) { return "isize"; }
    if (k == ty_USIZE()) { return "usize"; }
    return tref_get_name(ty);
}

fn hir_builder_param_pack_type_name(param: rawptr) -> string {
    if (param == null) { return ""; }
    return hir_builder_generic_param_canonical(hir_builder_type_ref_name(decl_get_ty(param)));
}

fn hir_builder_last_path_segment(name: string) -> string {
    if (name.len == 0) { return ""; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        if (name.charAt(i) == 46) { start = i + 1; }
        i = i + 1;
    }
    if (start == 0) { return name; }
    return name.substring(start, name.len);
}

/// Length of the `generic_params` marker name that starts at `i`, or 0 when
/// `i` is not the `|` of a `|name:` marker.
///
/// Markers are the only `|` that may follow the `|baseargs:` payload, and the
/// payload itself is free to contain `|`: it separates a base's name from its
/// arguments (`|baseargs:Sink|i32`).  So "the next `|`" is *not* the end of the
/// segment and a plain character scan would stop after `Sink` -- finding
/// nothing.  Every marker name is `[a-z_]+` (`kind`, `impl`, `where`, `attrs`,
/// `extern_abi`, ...), which distinguishes them from a type text such as `i32`
/// or `Vec<i32>`.
fn hir_builder_gp_marker_len_at(gp: string, i: i32) -> i32 {
    if (i < 0 || i >= gp.len) { return 0; }
    if (gp.charAt(i) != 124) { return 0; }
    var j = i + 1;
    while (j < gp.len) {
        let c = gp.charAt(j);
        if (c == 58) { break; }
        if (c != 95 && (c < 97 || c > 122)) { return 0; }
        j = j + 1;
    }
    if (j >= gp.len || j == i + 1) { return 0; }
    return j - i - 1;
}

/// Template arguments of a base clause, as captured by the parser into the
/// trailing `|baseargs:` segment (see `parse_decl_suffix_markers`).
///
///     `class VyxHost : native.Sink<i32>`  ->  `|baseargs:Sink|i32`
///
/// Returns "" when the base was spelled without arguments, which is the
/// ordinary case for every non-template foreign base.  The key is the base's
/// *last* segment so a fully qualified base clause and the declaration it
/// resolves to agree on which entry applies.
fn hir_builder_base_clause_args(gp: string, base_name: string) -> string {
    let prefix = "|baseargs:";
    let pos = hir_builder_index_of(gp, prefix);
    if (pos < 0) { return ""; }
    let seg_start = pos + prefix.len;
    var seg_end = gp.len;
    var scan = seg_start;
    while (scan < gp.len) {
        if (hir_builder_gp_marker_len_at(gp, scan) > 0) { seg_end = scan; break; }
        scan = scan + 1;
    }
    if (seg_end <= seg_start) { return ""; }
    let key = hir_builder_last_path_segment(base_name);
    if (key.len == 0) { return ""; }
    var item_start = seg_start;
    var i = seg_start;
    while (i <= seg_end) {
        if (i == seg_end || gp.charAt(i) == 59) {
            let item = gp.substring(item_start, i);
            var bar: i32 = -1;
            var j: i32 = 0;
            while (j < item.len) {
                if (item.charAt(j) == 124) { bar = j; break; }
                j = j + 1;
            }
            if (bar > 0 && item.substring(0, bar) == key) {
                return item.substring(bar + 1, item.len);
            }
            item_start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn hir_builder_token_char(c: i32) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    return c == 95;
}

/// Substitute whole identifier tokens of a type text through a params/args
/// environment (`T` -> `i32`).  Token-wise, so `T` never matches inside
/// `TDebug`, and substituting `T,U -> U,T` cannot clobber itself.
fn hir_builder_substitute_env_in_type_text(text: string, params: string, args: string) -> string {
    if (text.len == 0 || params.len == 0 || args.len == 0) { return text; }
    var out = "";
    var i: i32 = 0;
    while (i < text.len) {
        if (!hir_builder_token_char(text.charAt(i))) {
            out = out + text.substring(i, i + 1);
            i = i + 1;
            continue;
        }
        var j = i;
        while (j < text.len && hir_builder_token_char(text.charAt(j))) { j = j + 1; }
        let token = text.substring(i, j);
        var replacement = "";
        var pi: i32 = 0;
        while (pi < 64) {
            let param_name = policy_generic_arg_at(params, pi);
            if (param_name.len == 0) { break; }
            if (param_name == token) {
                replacement = policy_generic_arg_at(args, pi);
                break;
            }
            pi = pi + 1;
        }
        if (replacement.len > 0) { out = out + replacement; } else { out = out + token; }
        i = j;
    }
    return out;
}

fn hir_builder_type_base_name(name: string) -> string {
    if (name.len == 0) { return ""; }
    let base = policy_generic_call_base(name);
    if (base.len > 0) { return hir_builder_last_path_segment(base); }
    return hir_builder_last_path_segment(name);
}

fn hir_builder_type_owner_match_key(name: string) -> string {
    let base = hir_builder_type_base_name(name);
    if (hir_builder_is_primitive_str_name(base)) { return "string"; }
    return base;
}

fn hir_builder_str_lang_owner_names_match(a: string, b: string) -> bool {
    if (a.len == 0 || b.len == 0) { return false; }
    if (hir_builder_type_owner_names_match(a, b)) { return true; }
    let a_last = hir_builder_last_path_segment(hir_builder_type_base_name(a));
    let b_last = hir_builder_last_path_segment(hir_builder_type_base_name(b));
    if (a_last.len == 0 || b_last.len == 0) { return false; }
    let a_str = hir_builder_is_primitive_str_name(a_last) || a_last == "String";
    let b_str = hir_builder_is_primitive_str_name(b_last) || b_last == "String";
    return a_str && b_str;
}

fn hir_builder_type_owner_names_match(a: string, b: string) -> bool {
    if (a.len == 0 || b.len == 0) { return false; }
    if (a == b) { return true; }
    return hir_builder_type_owner_match_key(a) == hir_builder_type_owner_match_key(b);
}

fn hir_builder_trait_match_key(name: string) -> string {
    let last = hir_builder_last_path_segment(policy_generic_call_base(name));
    if (last == "Hash") { return "Hashable"; }
    return last;
}

fn hir_builder_trait_names_match(a: string, b: string) -> bool {
    if (a.len == 0 || b.len == 0) { return false; }
    if (a == b || policy_type_name_equal(a, b)) { return true; }
    return hir_builder_trait_match_key(a) == hir_builder_trait_match_key(b);
}

fn hir_builder_impl_trait_at(meta: string, wanted_index: i32) -> string {
    if (meta.len == 0 || wanted_index < 0) { return ""; }
    let prefix = "|impl:";
    var pos = hir_builder_index_of(meta, prefix);
    if (pos < 0) { return ""; }
    var start = pos + prefix.len;
    var index: i32 = 0;
    var i = start;
    while (i <= meta.len) {
        if (i == meta.len || meta.charAt(i) == 44 || meta.charAt(i) == 124) {
            let item = meta.substring(start, i);
            if (item.len > 0) {
                if (index == wanted_index) { return item; }
                index = index + 1;
            }
            start = i + 1;
            if (i < meta.len && meta.charAt(i) == 124) { return ""; }
        }
        i = i + 1;
    }
    return "";
}

fn hir_builder_type_text_is_awaitable(name: string) -> bool {
    let base = hir_builder_type_base_name(name);
    return base == "Task" || base == "Promise";
}

fn hir_builder_task_type_text_for_payload(payload: string) -> string {
    var inner = payload;
    if (inner.len == 0 || inner == "void") { inner = "i32"; }
    return "Task::<" + inner + ">";
}

fn hir_builder_owner_args_for_params(owner_params: string, owner_type_name: string) -> string {
    if (owner_params.len == 0 || owner_type_name.len == 0) { return ""; }
    let type_args = policy_generic_call_args(owner_type_name.clone());
    var out = "";
    var type_arg_index: i32 = 0;
    var i: i32 = 0;
    while (i < 64) {
        let param_name = hir_builder_generic_param_at(owner_params, i);
        if (param_name.len == 0) { return out; }
        var arg_name = "";
        if (param_name == "Self") {
            arg_name = owner_type_name;
        } else {
            arg_name = policy_generic_arg_at(type_args, type_arg_index);
            type_arg_index = type_arg_index + 1;
        }
        if (arg_name.len == 0) { return ""; }
        out = hir_builder_append_csv(out, arg_name);
        i = i + 1;
    }
    return out;
}

fn hir_builder_generic_params_prefix(params: string, count: i32) -> string {
    if (params.len == 0 || count <= 0) { return ""; }
    var out = "";
    var i: i32 = 0;
    while (i < count) {
        let p = hir_builder_generic_param_at(params, i);
        if (p.len == 0) { return out; }
        out = hir_builder_append_csv(out, p);
        i = i + 1;
    }
    return out;
}

fn hir_builder_generic_params_after(params: string, count: i32) -> string {
    if (params.len == 0) { return ""; }
    var out = "";
    var i: i32 = count;
    while (i < 64) {
        let p = hir_builder_generic_param_at(params, i);
        if (p.len == 0) { return out; }
        out = hir_builder_append_csv(out, p);
        i = i + 1;
    }
    return out;
}

fn hir_builder_params_with_args(params: string, args: string) -> string {
    if (params.len == 0 || args.len == 0) { return ""; }
    var out = "";
    var i: i32 = 0;
    while (i < 64) {
        let p = hir_builder_generic_param_at(params, i);
        if (p.len == 0) { return out; }
        let a = policy_generic_arg_at(args, i);
        if (a.len > 0) { out = hir_builder_append_csv(out, p); }
        i = i + 1;
    }
    return out;
}

fn hir_builder_template_params_matching_owner_text(pattern: string, owner_type_name: string) -> string {
    if (pattern.len == 0 || owner_type_name.len == 0) { return ""; }
    let pattern_args = policy_generic_call_args(pattern);
    let owner_args = policy_generic_call_args(owner_type_name);
    if (pattern_args.len == 0 || owner_args.len == 0) { return ""; }
    let pattern_base = policy_generic_call_base(pattern);
    let owner_base = policy_generic_call_base(owner_type_name);
    if (!policy_type_name_equal(pattern_base, owner_base)) { return ""; }
    var out = "";
    var i: i32 = 0;
    while (i < 64) {
        let p = policy_generic_arg_at(pattern_args, i);
        let a = policy_generic_arg_at(owner_args, i);
        if (p.len == 0 || a.len == 0) { return out; }
        if (hir_builder_type_name_has_template_atom(p)) {
            out = hir_builder_append_csv(out, hir_builder_generic_param_canonical(p));
        }
        i = i + 1;
    }
    return out;
}

fn hir_builder_env_key(params: string, args: string) -> string {
    if (params.len == 0 && args.len == 0) { return ""; }
    return hir_builder_generic_head(params) + "=>" + args;
}

fn hir_builder_function_instance_name(base: string, owner_type: string, params: string, args: string) -> string {
    var raw = base;
    if (owner_type.len > 0) { raw = owner_type + "::" + base; }
    let env = hir_builder_env_key(params, args);
    if (env.len > 0) { raw = raw.clone() + "::" + env; }
    return "mir2$" + policy_mangle_part(raw);
}

/// Link name for a DCI open-generic instance: `<base>__<arg1>_<arg2>...`
/// with each argument mangled.  Unlike the `mir2$` instance names this is a
/// valid flat C symbol — the Active Adapter materializes the native
/// entrypoint under exactly this name, so no `mir2$` unmasking pass is ever
/// needed and the requests sidecar can name it directly.
fn hir_builder_foreign_dci_instance_name(base: string, args: string) -> string {
    var out = base + "__";
    var i: i32 = 0;
    while (i < 64) {
        let arg = policy_generic_arg_at(args, i);
        if (arg.len == 0) { break; }
        if (i > 0) { out = out + "_"; }
        out = out + policy_mangle_part(arg);
        i = i + 1;
    }
    return out;
}

fn hir_builder_type_name_has_template_atom(name: string) -> bool {
    if (name.len == 0) { return false; }
    let args = policy_generic_call_args(name.clone());
    if (args.len > 0) {
        var i: i32 = 0;
        while (i < 64) {
            let a = policy_generic_arg_at(args, i);
            if (a.len == 0) { return false; }
            if (hir_builder_type_name_has_template_atom(a)) { return true; }
            i = i + 1;
        }
        return false;
    }
    if (name == "Self") { return true; }
    if (name.len == 1) {
        let c = name.charAt(0);
        if (c >= 65 && c <= 90) { return true; }
    }
    return false;
}

fn hir_builder_type_name_contains_template_param(name: string, param: string) -> bool {
    if (name.len == 0 || param.len == 0) { return false; }
    if (name == param) { return true; }
    let args = policy_generic_call_args(name.clone());
    if (args.len > 0) {
        var i: i32 = 0;
        while (i < 64) {
            let a = policy_generic_arg_at(args, i);
            if (a.len == 0) { return false; }
            if (hir_builder_type_name_contains_template_param(a, param)) { return true; }
            i = i + 1;
        }
    }
    let sep = hir_builder_assoc_separator_index(name);
    if (sep >= 0) {
        let sep_len = hir_builder_assoc_separator_len(name, sep);
        if (sep > 0 && sep + sep_len < name.len) {
            if (hir_builder_type_name_contains_template_param(name.substring(0, sep), param)) { return true; }
            if (hir_builder_type_name_contains_template_param(name.substring(sep + sep_len, name.len), param)) { return true; }
        }
    }
    return false;
}

fn hir_builder_identifier_char(c: i32) -> bool {
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 48 && c <= 57) { return true; }
    return c == 95;
}

fn hir_builder_type_text_contains_template_param(text: string, param: string) -> bool {
    if (text.len == 0 || param.len == 0) { return false; }
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (!hir_builder_identifier_char(c)) {
            i = i + 1;
        } else {
            let start = i;
            i = i + 1;
            while (i < text.len && hir_builder_identifier_char(text.charAt(i))) {
                i = i + 1;
            }
            if (i - start == param.len && text.substring(start, i) == param) {
                return true;
            }
        }
    }
    return false;
}

fn hir_builder_type_ref_has_template_atom(ty: rawptr) -> bool {
    if (ty == null) { return false; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS()) {
        return hir_builder_type_name_has_template_atom(tref_get_name(ty));
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return hir_builder_type_ref_has_template_atom(tref_pointee(ty));
    }
    if (k == ty_ARRAY()) {
        return hir_builder_type_ref_has_template_atom(tref_array_elem(ty))
            || hir_builder_const_expr_has_template_atom(tref_array_size_expr(ty));
    }
    if (k == ty_TUPLE()) {
        var i: i64 = 0;
        while (i < tref_tuple_count(ty)) {
            if (hir_builder_type_ref_has_template_atom(tref_tuple_elem_at(ty, i))) { return true; }
            i = i + 1;
        }
        return false;
    }
    if (k == ty_FN() || k == ty_CFN()) {
        if (hir_builder_type_ref_has_template_atom(tref_fn_ret(ty))) { return true; }
        var i2: i64 = 0;
        while (i2 < tref_fn_param_count(ty)) {
            if (hir_builder_type_ref_has_template_atom(tref_fn_param_at(ty, i2))) { return true; }
            i2 = i2 + 1;
        }
        return false;
    }
    return false;
}

fn hir_builder_type_ref_contains_template_param(ty: rawptr, param: string) -> bool {
    if (ty == null || param.len == 0) { return false; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS()) {
        return hir_builder_type_name_contains_template_param(tref_get_name(ty), param);
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return hir_builder_type_ref_contains_template_param(tref_pointee(ty), param);
    }
    if (k == ty_ARRAY()) {
        return hir_builder_type_ref_contains_template_param(tref_array_elem(ty), param)
            || hir_builder_const_expr_contains_param(tref_array_size_expr(ty), param);
    }
    if (k == ty_TUPLE()) {
        var i: i64 = 0;
        while (i < tref_tuple_count(ty)) {
            if (hir_builder_type_ref_contains_template_param(tref_tuple_elem_at(ty, i), param)) { return true; }
            i = i + 1;
        }
        return false;
    }
    if (k == ty_FN() || k == ty_CFN()) {
        if (hir_builder_type_ref_contains_template_param(tref_fn_ret(ty), param)) { return true; }
        var i2: i64 = 0;
        while (i2 < tref_fn_param_count(ty)) {
            if (hir_builder_type_ref_contains_template_param(tref_fn_param_at(ty, i2), param)) { return true; }
            i2 = i2 + 1;
        }
        return false;
    }
    return false;
}

fn hir_builder_append_inferred_template_param(out: string, name: string, excluded: string) -> string {
    if (name.len == 0 || name == "Self") { return out; }
    let canon = hir_builder_generic_param_canonical(name);
    if (canon.len == 0) { return out; }
    if (hir_builder_generic_contains(out, canon)) { return out; }
    if (hir_builder_generic_contains(excluded, canon)) { return out; }
    return hir_builder_append_csv(out, canon);
}

fn hir_builder_collect_template_params_from_type_name(name: string, out: string, excluded: string) -> string {
    if (name.len == 0) { return out; }
    let args = policy_generic_call_args(name.clone());
    if (args.len > 0) {
        var out_args = out;
        var arg_index: i32 = 0;
        while (arg_index < 64) {
            let arg = policy_generic_arg_at(args, arg_index);
            if (arg.len == 0) { return out_args; }
            out_args = hir_builder_collect_template_params_from_type_name(arg, out_args, excluded);
            arg_index = arg_index + 1;
        }
        return out_args;
    }
    let sep = hir_builder_assoc_separator_index(name);
    if (sep >= 0) {
        let sep_len = hir_builder_assoc_separator_len(name, sep);
        var out_assoc = out;
        if (sep > 0) {
            out_assoc = hir_builder_collect_template_params_from_type_name(name.substring(0, sep),
                                                                           out_assoc,
                                                                           excluded);
        }
        if (sep + sep_len < name.len) {
            out_assoc = hir_builder_collect_template_params_from_type_name(name.substring(sep + sep_len, name.len),
                                                                           out_assoc,
                                                                           excluded);
        }
        return out_assoc;
    }
    if (name.len == 1) {
        let c = name.charAt(0);
        if (c >= 65 && c <= 90) {
            return hir_builder_append_inferred_template_param(out, name, excluded);
        }
    }
    return out;
}

fn hir_builder_collect_template_params_from_type_ref(ty: rawptr, out: string, excluded: string) -> string {
    if (ty == null) { return out; }
    let k = tref_get_kind(ty);
    if (k == ty_CLASS()) {
        return hir_builder_collect_template_params_from_type_name(tref_get_name(ty), out, excluded);
    }
    if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
        return hir_builder_collect_template_params_from_type_ref(tref_pointee(ty), out, excluded);
    }
    if (k == ty_ARRAY()) {
        var out_arr = hir_builder_collect_template_params_from_type_ref(tref_array_elem(ty), out, excluded);
        let size_e = tref_array_size_expr(ty);
        if (size_e != null && expr_get_kind(size_e) == ex_IDENT()) {
            out_arr = hir_builder_append_inferred_template_param(out_arr, expr_get_name(size_e), excluded);
        }
        return out_arr;
    }
    if (k == ty_TUPLE()) {
        var out_tuple = out;
        var i: i64 = 0;
        while (i < tref_tuple_count(ty)) {
            out_tuple = hir_builder_collect_template_params_from_type_ref(tref_tuple_elem_at(ty, i),
                                                                          out_tuple,
                                                                          excluded);
            i = i + 1;
        }
        return out_tuple;
    }
    if (k == ty_FN() || k == ty_CFN()) {
        var out_fn = hir_builder_collect_template_params_from_type_ref(tref_fn_ret(ty), out, excluded);
        var i2: i64 = 0;
        while (i2 < tref_fn_param_count(ty)) {
            out_fn = hir_builder_collect_template_params_from_type_ref(tref_fn_param_at(ty, i2),
                                                                       out_fn,
                                                                       excluded);
            i2 = i2 + 1;
        }
        return out_fn;
    }
    return out;
}

fn hir_builder_inferred_decl_template_params_except(d: rawptr, excluded: string) -> string {
    if (d == null) { return ""; }
    var out = hir_builder_collect_template_params_from_type_ref(decl_get_ty(d), "", excluded);
    var param = decl_get_params(d);
    while (param != null) {
        out = hir_builder_collect_template_params_from_type_ref(decl_get_ty(param), out, excluded);
        param = decl_get_next(param);
    }
    return out;
}

fn hir_builder_expr_has_template_type(e: rawptr) -> bool {
    if (e == null) { return false; }
    if (hir_builder_type_ref_has_template_atom(expr_get_ty(e))) { return true; }
    if (hir_builder_type_name_has_template_atom(expr_get_name(e))) { return true; }
    let k = expr_get_kind(e);
    if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_TERNARY()) {
        if (hir_builder_expr_has_template_type(expr_get_lhs(e))) { return true; }
        if (hir_builder_expr_has_template_type(expr_get_rhs(e))) { return true; }
        return hir_builder_expr_has_template_type(expr_get_args(e));
    }
    if (k == ex_UNARY()
        || k == ex_ADDR_OF()
        || k == ex_DEREF()
        || k == ex_CAST()
        || k == ex_AWAIT()
        || k == ex_COMPTIME()
        || k == ex_FAIL()) {
        return hir_builder_expr_has_template_type(expr_get_lhs(e));
    }
    if (k == ex_CALL()) {
        if (hir_builder_expr_has_template_type(expr_get_lhs(e))) { return true; }
        return hir_builder_stmt_chain_has_template_type(expr_get_args(e));
    }
    if (k == ex_MEMBER()) {
        return hir_builder_expr_has_template_type(expr_get_lhs(e));
    }
    if (k == ex_INDEX()) {
        if (hir_builder_expr_has_template_type(expr_get_lhs(e))) { return true; }
        return hir_builder_expr_has_template_type(expr_get_rhs(e));
    }
    if (k == ex_STRUCT_INIT()
        || k == ex_FSTRING()
        || k == ex_TUPLE_LIT()
        || k == ex_INLINE_ASM()) {
        return hir_builder_stmt_chain_has_template_type(expr_get_args(e));
    }
    if (k == ex_ARRAY_LIT()) {
        if (hir_builder_stmt_chain_has_template_type(expr_get_args(e))) { return true; }
        return hir_builder_expr_has_template_type(expr_get_captures(e));
    }
    if (k == ex_CLOSURE()) {
        if (hir_builder_stmt_chain_has_template_type(expr_get_captures(e))) { return true; }
        if (hir_builder_stmt_chain_has_template_type(expr_get_lhs(e))) { return true; }
        return hir_builder_type_ref_has_template_atom(expr_get_rhs(e));
    }
    if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
        if (hir_builder_expr_has_template_type(expr_get_lhs(e))) { return true; }
        if (k == ex_IF_EXPR()) {
            if (hir_builder_stmt_chain_has_template_type(expr_get_rhs(e))) { return true; }
            let else_part = expr_get_args(e);
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                return hir_builder_expr_has_template_type(else_part);
            }
            return hir_builder_stmt_chain_has_template_type(else_part);
        }
        return hir_builder_stmt_chain_has_template_type(expr_get_args(e));
    }
    return false;
}

fn hir_builder_expr_contains_template_param(e: rawptr, param: string) -> bool {
    if (e == null || param.len == 0) { return false; }
    if (hir_builder_type_ref_contains_template_param(expr_get_ty(e), param)) { return true; }
    if (hir_builder_type_name_contains_template_param(expr_get_name(e), param)) { return true; }
    let k = expr_get_kind(e);
    if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_TERNARY()) {
        if (hir_builder_expr_contains_template_param(expr_get_lhs(e), param)) { return true; }
        if (hir_builder_expr_contains_template_param(expr_get_rhs(e), param)) { return true; }
        return hir_builder_expr_contains_template_param(expr_get_args(e), param);
    }
    if (k == ex_UNARY()
        || k == ex_ADDR_OF()
        || k == ex_DEREF()
        || k == ex_CAST()
        || k == ex_AWAIT()
        || k == ex_COMPTIME()
        || k == ex_FAIL()) {
        return hir_builder_expr_contains_template_param(expr_get_lhs(e), param);
    }
    if (k == ex_CALL()) {
        if (hir_builder_expr_contains_template_param(expr_get_lhs(e), param)) { return true; }
        return hir_builder_stmt_chain_contains_template_param(expr_get_args(e), param);
    }
    if (k == ex_MEMBER()) {
        return hir_builder_expr_contains_template_param(expr_get_lhs(e), param);
    }
    if (k == ex_INDEX()) {
        if (hir_builder_expr_contains_template_param(expr_get_lhs(e), param)) { return true; }
        return hir_builder_expr_contains_template_param(expr_get_rhs(e), param);
    }
    if (k == ex_STRUCT_INIT()
        || k == ex_FSTRING()
        || k == ex_TUPLE_LIT()
        || k == ex_INLINE_ASM()) {
        return hir_builder_stmt_chain_contains_template_param(expr_get_args(e), param);
    }
    if (k == ex_ARRAY_LIT()) {
        if (hir_builder_stmt_chain_contains_template_param(expr_get_args(e), param)) { return true; }
        return hir_builder_expr_contains_template_param(expr_get_captures(e), param);
    }
    if (k == ex_CLOSURE()) {
        if (hir_builder_stmt_chain_contains_template_param(expr_get_captures(e), param)) { return true; }
        if (hir_builder_stmt_chain_contains_template_param(expr_get_lhs(e), param)) { return true; }
        return hir_builder_type_ref_contains_template_param(expr_get_rhs(e), param);
    }
    if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
        if (hir_builder_expr_contains_template_param(expr_get_lhs(e), param)) { return true; }
        if (k == ex_IF_EXPR()) {
            if (hir_builder_stmt_chain_contains_template_param(expr_get_rhs(e), param)) { return true; }
            let else_part = expr_get_args(e);
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                return hir_builder_expr_contains_template_param(else_part, param);
            }
            return hir_builder_stmt_chain_contains_template_param(else_part, param);
        }
        return hir_builder_stmt_chain_contains_template_param(expr_get_args(e), param);
    }
    return false;
}

fn hir_builder_stmt_has_template_type(s: rawptr) -> bool {
    if (s == null) { return false; }
    if (hir_builder_type_ref_has_template_atom(stmt_get_ty(s))) { return true; }
    if (hir_builder_expr_has_template_type(stmt_get_init(s))) { return true; }
    if (hir_builder_expr_has_template_type(stmt_get_cond(s))) { return true; }
    if (hir_builder_stmt_chain_has_template_type(stmt_get_then_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_template_type(stmt_get_else_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_template_type(stmt_get_body(s))) { return true; }
    return false;
}

fn hir_builder_stmt_contains_template_param(s: rawptr, param: string) -> bool {
    if (s == null || param.len == 0) { return false; }
    if (hir_builder_type_ref_contains_template_param(stmt_get_ty(s), param)) { return true; }
    if (hir_builder_expr_contains_template_param(stmt_get_init(s), param)) { return true; }
    if (hir_builder_expr_contains_template_param(stmt_get_cond(s), param)) { return true; }
    if (hir_builder_stmt_chain_contains_template_param(stmt_get_then_blk(s), param)) { return true; }
    if (hir_builder_stmt_chain_contains_template_param(stmt_get_else_blk(s), param)) { return true; }
    if (hir_builder_stmt_chain_contains_template_param(stmt_get_body(s), param)) { return true; }
    return false;
}

fn hir_builder_stmt_chain_has_template_type(s: rawptr) -> bool {
    var cur = s;
    while (cur != null) {
        if (hir_builder_stmt_has_template_type(cur)) { return true; }
        cur = stmt_get_next(cur);
    }
    return false;
}

fn hir_builder_stmt_chain_contains_template_param(s: rawptr, param: string) -> bool {
    var cur = s;
    while (cur != null) {
        if (hir_builder_stmt_contains_template_param(cur, param)) { return true; }
        cur = stmt_get_next(cur);
    }
    return false;
}

fn hir_builder_decl_body_has_template_type(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (hir_builder_type_ref_has_template_atom(decl_get_ty(d))) { return true; }
    var param = decl_get_params(d);
    while (param != null) {
        if (hir_builder_type_ref_has_template_atom(decl_get_ty(param))) { return true; }
        param = decl_get_next(param);
    }
    return hir_builder_stmt_chain_has_template_type(decl_get_body(d));
}

fn hir_builder_decl_contains_template_param(d: rawptr, param: string) -> bool {
    if (d == null || param.len == 0) { return false; }
    if (hir_builder_type_ref_contains_template_param(decl_get_ty(d), param)) { return true; }
    var p = decl_get_params(d);
    while (p != null) {
        if (hir_builder_type_ref_contains_template_param(decl_get_ty(p), param)) { return true; }
        p = decl_get_next(p);
    }
    return hir_builder_stmt_chain_contains_template_param(decl_get_body(d), param);
}

fn hir_builder_expr_is_self_ident(e: rawptr) -> bool {
    if (e == null || expr_get_kind(e) != ex_IDENT()) { return false; }
    return expr_get_name(e) == "self";
}

fn hir_builder_expr_has_self_member_access(e: rawptr) -> bool {
    if (e == null) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_MEMBER()) {
        if (hir_builder_expr_is_self_ident(expr_get_lhs(e))) { return true; }
        return hir_builder_expr_has_self_member_access(expr_get_lhs(e));
    }
    if (k == ex_CALL()) {
        if (hir_builder_expr_has_self_member_access(expr_get_lhs(e))) { return true; }
        return hir_builder_stmt_chain_has_self_member_access(expr_get_args(e));
    }
    if (k == ex_UNARY()
        || k == ex_ADDR_OF()
        || k == ex_DEREF()
        || k == ex_AWAIT()
        || k == ex_COMPTIME()) {
        return hir_builder_expr_has_self_member_access(expr_get_lhs(e));
    }
    if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
        if (hir_builder_expr_has_self_member_access(expr_get_lhs(e))) { return true; }
        return hir_builder_expr_has_self_member_access(expr_get_rhs(e));
    }
    if (k == ex_CLOSURE()) {
        if (hir_builder_stmt_chain_has_self_member_access(expr_get_captures(e))) { return true; }
        return hir_builder_stmt_chain_has_self_member_access(expr_get_lhs(e));
    }
    if (k == ex_CAST()) {
        return hir_builder_expr_has_self_member_access(expr_get_lhs(e));
    }
    if (k == ex_TERNARY()) {
        if (hir_builder_expr_has_self_member_access(expr_get_lhs(e))) { return true; }
        if (hir_builder_expr_has_self_member_access(expr_get_rhs(e))) { return true; }
        return hir_builder_expr_has_self_member_access(expr_get_args(e));
    }
    if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
        if (hir_builder_expr_has_self_member_access(expr_get_lhs(e))) { return true; }
        if (k == ex_IF_EXPR()) {
            if (hir_builder_stmt_chain_has_self_member_access(expr_get_rhs(e))) { return true; }
            let else_part = expr_get_args(e);
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                return hir_builder_expr_has_self_member_access(else_part);
            }
            return hir_builder_stmt_chain_has_self_member_access(else_part);
        }
        return hir_builder_stmt_chain_has_self_member_access(expr_get_args(e));
    }
    if (k == ex_FSTRING()
        || k == ex_ARRAY_LIT()
        || k == ex_TUPLE_LIT()
        || k == ex_STRUCT_INIT()
        || k == ex_INLINE_ASM()) {
        if (hir_builder_stmt_chain_has_self_member_access(expr_get_args(e))) { return true; }
        if (k == ex_ARRAY_LIT()) {
            return hir_builder_expr_has_self_member_access(expr_get_captures(e));
        }
        return false;
    }
    if (k == ex_FAIL()) {
        return hir_builder_expr_has_self_member_access(expr_get_lhs(e));
    }
    return hir_builder_stmt_chain_has_self_member_access(expr_get_args(e));
}

fn hir_builder_stmt_has_self_member_access(s: rawptr) -> bool {
    if (s == null) { return false; }
    if (hir_builder_expr_has_self_member_access(stmt_get_init(s))) { return true; }
    if (hir_builder_expr_has_self_member_access(stmt_get_cond(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_access(stmt_get_then_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_access(stmt_get_else_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_access(stmt_get_body(s))) { return true; }
    return false;
}

fn hir_builder_stmt_chain_has_self_member_access(s: rawptr) -> bool {
    var cur = s;
    while (cur != null) {
        if (hir_builder_stmt_has_self_member_access(cur)) { return true; }
        cur = stmt_get_next(cur);
    }
    return false;
}

fn hir_builder_decl_body_has_self_member_access(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_stmt_chain_has_self_member_access(decl_get_body(d));
}

fn hir_builder_expr_has_self_member_call(e: rawptr) -> bool {
    if (e == null) { return false; }
    let k = expr_get_kind(e);
    if (k == ex_CALL()) {
        let callee = expr_get_lhs(e);
        if (callee != null
            && expr_get_kind(callee) == ex_MEMBER()
            && hir_builder_expr_is_self_ident(expr_get_lhs(callee))) {
            return true;
        }
        if (hir_builder_expr_has_self_member_call(callee)) { return true; }
        return hir_builder_stmt_chain_has_self_member_call(expr_get_args(e));
    }
    if (k == ex_MEMBER()) {
        return hir_builder_expr_has_self_member_call(expr_get_lhs(e));
    }
    if (k == ex_UNARY()
        || k == ex_ADDR_OF()
        || k == ex_DEREF()
        || k == ex_AWAIT()
        || k == ex_COMPTIME()) {
        return hir_builder_expr_has_self_member_call(expr_get_lhs(e));
    }
    if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
        if (hir_builder_expr_has_self_member_call(expr_get_lhs(e))) { return true; }
        return hir_builder_expr_has_self_member_call(expr_get_rhs(e));
    }
    if (k == ex_CLOSURE()) {
        if (hir_builder_stmt_chain_has_self_member_call(expr_get_captures(e))) { return true; }
        return hir_builder_stmt_chain_has_self_member_call(expr_get_lhs(e));
    }
    if (k == ex_CAST()) {
        return hir_builder_expr_has_self_member_call(expr_get_lhs(e));
    }
    if (k == ex_TERNARY()) {
        if (hir_builder_expr_has_self_member_call(expr_get_lhs(e))) { return true; }
        if (hir_builder_expr_has_self_member_call(expr_get_rhs(e))) { return true; }
        return hir_builder_expr_has_self_member_call(expr_get_args(e));
    }
    if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
        if (hir_builder_expr_has_self_member_call(expr_get_lhs(e))) { return true; }
        if (k == ex_IF_EXPR()) {
            if (hir_builder_stmt_chain_has_self_member_call(expr_get_rhs(e))) { return true; }
            let else_part = expr_get_args(e);
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                return hir_builder_expr_has_self_member_call(else_part);
            }
            return hir_builder_stmt_chain_has_self_member_call(else_part);
        }
        return hir_builder_stmt_chain_has_self_member_call(expr_get_args(e));
    }
    if (k == ex_FSTRING()
        || k == ex_ARRAY_LIT()
        || k == ex_TUPLE_LIT()
        || k == ex_STRUCT_INIT()
        || k == ex_INLINE_ASM()) {
        if (hir_builder_stmt_chain_has_self_member_call(expr_get_args(e))) { return true; }
        if (k == ex_ARRAY_LIT()) {
            return hir_builder_expr_has_self_member_call(expr_get_captures(e));
        }
        return false;
    }
    if (k == ex_FAIL()) {
        return hir_builder_expr_has_self_member_call(expr_get_lhs(e));
    }
    return hir_builder_stmt_chain_has_self_member_call(expr_get_args(e));
}

fn hir_builder_stmt_has_self_member_call(s: rawptr) -> bool {
    if (s == null) { return false; }
    if (hir_builder_expr_has_self_member_call(stmt_get_init(s))) { return true; }
    if (hir_builder_expr_has_self_member_call(stmt_get_cond(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_call(stmt_get_then_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_call(stmt_get_else_blk(s))) { return true; }
    if (hir_builder_stmt_chain_has_self_member_call(stmt_get_body(s))) { return true; }
    return false;
}

fn hir_builder_stmt_chain_has_self_member_call(s: rawptr) -> bool {
    var cur = s;
    while (cur != null) {
        if (hir_builder_stmt_has_self_member_call(cur)) { return true; }
        cur = stmt_get_next(cur);
    }
    return false;
}

fn hir_builder_decl_body_has_self_member_call(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_builder_stmt_chain_has_self_member_call(decl_get_body(d));
}

fn hir_builder_decl_members_have_template_type(d: rawptr) -> bool {
    if (d == null) { return false; }
    var member = decl_get_members(d);
    while (member != null) {
        if (hir_builder_decl_body_has_template_type(member)) { return true; }
        member = decl_get_next(member);
    }
    return false;
}

fn hir_builder_decl_signature_matches(a: rawptr, b: rawptr) -> bool {
    if (a == null || b == null) { return false; }
    if (decl_get_kind(a) != decl_get_kind(b)) { return false; }
    if (decl_get_name(a) != decl_get_name(b)) { return false; }
    if (hir_builder_decl_template_params(a) != hir_builder_decl_template_params(b)) {
        return false;
    }
    if (hir_builder_type_ref_name(decl_get_ty(a)) != hir_builder_type_ref_name(decl_get_ty(b))) {
        return false;
    }
    var pa = decl_get_params(a);
    var pb = decl_get_params(b);
    while (pa != null && pb != null) {
        if (hir_builder_type_ref_name(decl_get_ty(pa)) != hir_builder_type_ref_name(decl_get_ty(pb))) {
            return false;
        }
        pa = decl_get_next(pa);
        pb = decl_get_next(pb);
    }
    return pa == null && pb == null;
}

fn hir_builder_decl_specialization_shape_matches(a: rawptr, b: rawptr) -> bool {
    if (a == null || b == null) { return false; }
    if (decl_get_kind(a) != decl_get_kind(b)) { return false; }
    if (decl_get_name(a) != decl_get_name(b)) { return false; }
    if (decl_get_is_static(a) != decl_get_is_static(b)) { return false; }
    return hir_builder_decl_param_count(a) == hir_builder_decl_param_count(b);
}

fn hir_builder_decl_param_count(d: rawptr) -> i32 {
    var count: i32 = 0;
    var p = decl_get_params(d);
    while (p != null) {
        count = count + 1;
        p = decl_get_next(p);
    }
    return count;
}

fn hir_builder_item_kind_from_decl(d: rawptr) -> i32 {
    let k = decl_get_kind(d);
    // A source-level MOSP Effect declaration is a compile-time fact producer.
    // Sema has already bound and validated it in EffectPlan; it has no value,
    // type, body, or symbol and must never become a HIR/codegen item.
    if (k == de_EFFECT()) { return hir_id_invalid(); }
    if (k == de_FN()) { return hir_item_function(); }
    if (k == de_EXTERN_FN()) { return hir_item_extern_function(); }
    if (k == de_CLASS()) {
        if (hir_builder_string_contains(decl_get_generic_params(d), "|kind:interface")) {
            return hir_item_interface();
        }
        return hir_item_class();
    }
    if (k == de_ENUM()) { return hir_item_enum(); }
    if (k == de_FIELD()) {
        if (hir_builder_string_contains(decl_get_generic_params(d), "|kind:assoc_const")) {
            return hir_item_const();
        }
        return hir_item_field();
    }
    if (k == de_METHOD()) { return hir_item_method(); }
    if (k == de_VARIANT()) { return hir_item_variant(); }
    if (k == de_CONST()) { return hir_item_const(); }
    if (k == de_GLOBAL_VAR()) { return hir_item_global(); }
    if (k == de_TYPE_ALIAS()) { return hir_item_type_alias(); }
    if (k == de_MODULE()) { return hir_item_module(); }
    return hir_item_module();
}

fn hir_builder_decl_is_assoc_const_member(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (decl_get_kind(d) != de_FIELD()) { return false; }
    return hir_builder_string_contains(decl_get_generic_params(d), "|kind:assoc_const");
}

fn hir_builder_stmt_kind_from_ast(k: i32) -> i32 {
    if (k == st_EXPR()) { return hir_stmt_expr(); }
    if (k == st_LET()) { return hir_stmt_let(); }
    if (k == st_VAR()) { return hir_stmt_var(); }
    if (k == st_IF()) { return hir_stmt_if(); }
    if (k == st_WHILE()) { return hir_stmt_while(); }
    if (k == st_BREAK()) { return hir_stmt_break(); }
    if (k == st_CONTINUE()) { return hir_stmt_continue(); }
    if (k == st_RETURN()) { return hir_stmt_return(); }
    if (k == st_BLOCK()) { return hir_stmt_block(); }
    if (k == st_FOR()) { return hir_stmt_for(); }
    if (k == st_FOREACH()) { return hir_stmt_foreach(); }
    if (k == st_MATCH()) { return hir_stmt_match(); }
    if (k == st_DEFER()) { return hir_stmt_defer(); }
    if (k == st_STATIC_ASSERT()) { return hir_stmt_static_assert(); }
    return hir_stmt_expr();
}

class HirPointerMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32
    public item_raws: rawptr
    public item_cap: i32
    public function_raws: rawptr
    public function_cap: i32

    public static fn create() -> HirPointerMap {
        return HirPointerMap {
            head: null,
            buckets: null,
            bucket_cap: 0,
            item_raws: null,
            item_cap: 0,
            function_raws: null,
            function_cap: 0
        };
    }

    fn raw_hash(self, key: rawptr) -> i32 {
        var v = (key as i64) >> 4;
        if (v < 0) { v = -v; }
        v = ((v % 2147483647) * 131 + ((v >> 8) % 2147483647) * 17) % 2147483647;
        if (v < 0) { v = v + 2147483647; }
        return (v & 0x7fffffff) as i32;
    }

    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 16384;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let key = ast_read_rawptr(cur);
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 32), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
    }

    fn ensure_item_raw_cap(self, want_id: i32) {
        if (want_id <= 0 || want_id <= self.item_cap) { return; }
        var new_cap = self.item_cap;
        if (new_cap < 1024) { new_cap = 1024; }
        while (new_cap < want_id) { new_cap = new_cap * 2; }
        let bytes = (new_cap as i64) * 8;
        let new_buf = hir_profile_malloc(bytes as u64);
        if (new_buf == null) { return; }
        memset(new_buf, 0, bytes as u64);
        if (self.item_raws != null && self.item_cap > 0) {
            memcpy(new_buf, self.item_raws, ((self.item_cap as i64) * 8) as u64);
            free(self.item_raws);
        }
        self.item_raws = new_buf;
        self.item_cap = new_cap;
    }

    fn ensure_function_raw_cap(self, want_id: i32) {
        if (want_id <= 0 || want_id <= self.function_cap) { return; }
        var new_cap = self.function_cap;
        if (new_cap < 1024) { new_cap = 1024; }
        while (new_cap < want_id) { new_cap = new_cap * 2; }
        let bytes = (new_cap as i64) * 8;
        let new_buf = hir_profile_malloc(bytes as u64);
        if (new_buf == null) { return; }
        memset(new_buf, 0, bytes as u64);
        if (self.function_raws != null && self.function_cap > 0) {
            memcpy(new_buf, self.function_raws, ((self.function_cap as i64) * 8) as u64);
            free(self.function_raws);
        }
        self.function_raws = new_buf;
        self.function_cap = new_cap;
    }

    fn put(self, key: rawptr, item_id: i32, function_id: i32, item_kind: i32) {
        if (key == null) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) {
                    ast_write_i32(ptr_offset(bcur, 8), item_id);
                    ast_write_i32(ptr_offset(bcur, 12), function_id);
                    ast_write_i32(ptr_offset(bcur, 16), item_kind);
                    if (item_id != hir_id_invalid()) {
                        self.ensure_item_raw_cap(item_id);
                        if (self.item_raws != null && item_id <= self.item_cap) {
                            ast_write_rawptr(ptr_offset(self.item_raws, ((item_id - 1) as i64) * 8), key);
                        }
                    }
                    if (function_id != hir_id_invalid()) {
                        self.ensure_function_raw_cap(function_id);
                        if (self.function_raws != null && function_id <= self.function_cap) {
                            ast_write_rawptr(ptr_offset(self.function_raws, ((function_id - 1) as i64) * 8), key);
                        }
                    }
                    return;
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            let bnode = hir_profile_malloc(40);
            if (bnode == null) { return; }
            memset(bnode, 0, 40);
            ast_write_rawptr(bnode, key);
            ast_write_i32(ptr_offset(bnode, 8), item_id);
            ast_write_i32(ptr_offset(bnode, 12), function_id);
            ast_write_i32(ptr_offset(bnode, 16), item_kind);
            ast_write_rawptr(ptr_offset(bnode, 24), self.head);
            ast_write_rawptr(ptr_offset(bnode, 32), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            if (item_id != hir_id_invalid()) {
                self.ensure_item_raw_cap(item_id);
                if (self.item_raws != null && item_id <= self.item_cap) {
                    ast_write_rawptr(ptr_offset(self.item_raws, ((item_id - 1) as i64) * 8), key);
                }
            }
            if (function_id != hir_id_invalid()) {
                self.ensure_function_raw_cap(function_id);
                if (self.function_raws != null && function_id <= self.function_cap) {
                    ast_write_rawptr(ptr_offset(self.function_raws, ((function_id - 1) as i64) * 8), key);
                }
            }
            return;
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return; }
        memset(node, 0, 40);
        ast_write_rawptr(node, key);
        ast_write_i32(ptr_offset(node, 8), item_id);
        ast_write_i32(ptr_offset(node, 12), function_id);
        ast_write_i32(ptr_offset(node, 16), item_kind);
        ast_write_rawptr(ptr_offset(node, 24), self.head);
        self.head = node;
        if (item_id != hir_id_invalid()) {
            self.ensure_item_raw_cap(item_id);
            if (self.item_raws != null && item_id <= self.item_cap) {
                ast_write_rawptr(ptr_offset(self.item_raws, ((item_id - 1) as i64) * 8), key);
            }
        }
        if (function_id != hir_id_invalid()) {
            self.ensure_function_raw_cap(function_id);
            if (self.function_raws != null && function_id <= self.function_cap) {
                ast_write_rawptr(ptr_offset(self.function_raws, ((function_id - 1) as i64) * 8), key);
            }
        }
    }

    fn item(self, key: rawptr) -> i32 {
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) { return ast_read_i32(ptr_offset(bcur, 8)); }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            return hir_id_invalid();
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) { return ast_read_i32(ptr_offset(cur, 8)); }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return hir_id_invalid();
    }

    fn function(self, key: rawptr) -> i32 {
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) { return ast_read_i32(ptr_offset(bcur, 12)); }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            return hir_id_invalid();
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) { return ast_read_i32(ptr_offset(cur, 12)); }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return hir_id_invalid();
    }

    fn kind(self, key: rawptr) -> i32 {
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) { return ast_read_i32(ptr_offset(bcur, 16)); }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            return hir_target_none();
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) { return ast_read_i32(ptr_offset(cur, 16)); }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return hir_target_none();
    }

    fn raw_for_item(self, item_id: i32) -> rawptr {
        if (item_id == hir_id_invalid()) { return null; }
        if (self.item_raws != null && item_id > 0 && item_id <= self.item_cap) {
            let cached = ast_read_rawptr(ptr_offset(self.item_raws, ((item_id - 1) as i64) * 8));
            if (cached != null) { return cached; }
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(ptr_offset(cur, 8)) == item_id) { return ast_read_rawptr(cur); }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn raw_for_function(self, function_id: i32) -> rawptr {
        if (function_id == hir_id_invalid()) { return null; }
        if (self.function_raws != null && function_id > 0 && function_id <= self.function_cap) {
            let cached = ast_read_rawptr(ptr_offset(self.function_raws, ((function_id - 1) as i64) * 8));
            if (cached != null) { return cached; }
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(ptr_offset(cur, 12)) == function_id) { return ast_read_rawptr(cur); }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }
}

class HirLocalScope {
    public head: rawptr

    public static fn create() -> HirLocalScope {
        return HirLocalScope { head: null };
    }

    fn push(self, name: string, local_id: i32, type_id: i32, function_id: i32, target: rawptr) {
        if (name.len == 0) { return; }
        let node = hir_profile_malloc(56);
        if (node == null) { return; }
        memset(node, 0, 56);
        ast_write_rawptr(node, ast_dup_c_string(name));
        ast_write_i64(ptr_offset(node, 8), name.len);
        ast_write_i32(ptr_offset(node, 16), local_id);
        ast_write_i32(ptr_offset(node, 20), type_id);
        ast_write_i32(ptr_offset(node, 24), function_id);
        ast_write_rawptr(ptr_offset(node, 32), self.head);
        ast_write_rawptr(ptr_offset(node, 40), target);
        self.head = node;
    }

    fn restore(self, saved: rawptr) {
        self.head = saved;
    }

    fn drop_to(self, saved: rawptr) {
        var cur = self.head;
        while (cur != null && cur != saved) {
            let next = ast_read_rawptr(ptr_offset(cur, 32));
            let name_ptr = ast_read_rawptr(cur);
            if (name_ptr != null) { free(name_ptr); }
            free(cur);
            cur = next;
        }
        self.head = saved;
    }

    fn lookup(self, name: string) -> i32 {
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, name)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }

    fn lookup_target(self, target: rawptr) -> i32 {
        if (target == null) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(ptr_offset(cur, 40)) == target) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }
}

fn hir_pointer_map_put(map: HirPointerMap, key: rawptr, item_id: i32, function_id: i32, item_kind: i32) -> HirPointerMap {
    map.put(key, item_id, function_id, item_kind);
    return map;
}

fn hir_pointer_map_item(map: HirPointerMap, key: rawptr) -> i32 {
    return map.item(key);
}

fn hir_pointer_map_function(map: HirPointerMap, key: rawptr) -> i32 {
    return map.function(key);
}

fn hir_pointer_map_raw_for_item(map: HirPointerMap, item_id: i32) -> rawptr {
    return map.raw_for_item(item_id);
}

fn hir_pointer_map_raw_for_function(map: HirPointerMap, function_id: i32) -> rawptr {
    return map.raw_for_function(function_id);
}

fn hir_pointer_map_dispose(map: HirPointerMap) -> HirPointerMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        free(cur);
        cur = next;
    }
    map.head = null;
    if (map.buckets != null) { free(map.buckets); }
    if (map.item_raws != null) { free(map.item_raws); }
    if (map.function_raws != null) { free(map.function_raws); }
    map.buckets = null;
    map.bucket_cap = 0;
    map.item_raws = null;
    map.function_raws = null;
    map.item_cap = 0;
    map.function_cap = 0;
    return map;
}

fn hir_local_scope_push(scope: HirLocalScope,
                        name: string,
                        local_id: i32,
                        type_id: i32,
                        function_id: i32,
                        target: rawptr) -> HirLocalScope {
    scope.push(name, local_id, type_id, function_id, target);
    return scope;
}

fn hir_local_scope_restore(scope: HirLocalScope, saved: rawptr) -> HirLocalScope {
    scope.restore(saved);
    return scope;
}

fn hir_local_scope_drop_to(scope: HirLocalScope, saved: rawptr) -> HirLocalScope {
    scope.drop_to(saved);
    return scope;
}

fn hir_local_scope_lookup_target(scope: HirLocalScope, target: rawptr) -> i32 {
    return scope.lookup_target(target);
}

fn hir_local_scope_lookup(scope: HirLocalScope, name: string) -> i32 {
    return scope.lookup(name);
}

fn hir_local_scope_dispose(scope: HirLocalScope) -> HirLocalScope {
    return hir_local_scope_drop_to(scope, null);
}

fn hir_local_scope_find_node(head: rawptr, target: rawptr) -> rawptr {
    if (target == null) { return null; }
    var cur = head;
    while (cur != null) {
        if (ast_read_rawptr(ptr_offset(cur, 40)) == target) { return cur; }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return null;
}

fn hir_local_scope_find_node_by_name(head: rawptr, name: string) -> rawptr {
    if (name.len == 0) { return null; }
    var cur = head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, name)) { return cur; }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return null;
}

fn hir_local_scope_node_name(node: rawptr) -> string {
    if (node == null) { return ""; }
    let ptr = ast_read_rawptr(node);
    let len = ast_read_i64(ptr_offset(node, 8));
    if (ptr == null || len <= 0) { return ""; }
    return from_cstr_view_len(ptr, len);
}

fn hir_local_scope_node_type(node: rawptr) -> i32 {
    if (node == null) { return hir_id_invalid(); }
    return ast_read_i32(ptr_offset(node, 20));
}

fn hir_local_scope_node_local(node: rawptr) -> i32 {
    if (node == null) { return hir_id_invalid(); }
    return ast_read_i32(ptr_offset(node, 16));
}

fn hir_local_scope_node_target(node: rawptr) -> rawptr {
    if (node == null) { return null; }
    return ast_read_rawptr(ptr_offset(node, 40));
}

class HirGenericBindingMap {
    public head: rawptr

    public static fn create() -> HirGenericBindingMap {
        return HirGenericBindingMap { head: null };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 32));
            let name_ptr = ast_read_rawptr(cur);
            let value_ptr = ast_read_rawptr(ptr_offset(cur, 16));
            if (name_ptr != null) { free(name_ptr); }
            if (value_ptr != null) { free(value_ptr); }
            free(cur);
            cur = next;
        }
        self.head = null;
    }

    fn bind(self, name: string, value: string) {
        if (name.len == 0 || value.len == 0) { return; }
        var cur = self.head;
        while (cur != null) {
            let np = ast_read_rawptr(cur);
            let nl = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(np, nl, name)) {
                // `value` may itself be a view of this node's current
                // allocation. Duplicate it before releasing that storage.
                let new_value = ast_dup_c_string(value);
                if (new_value == null) { return; }
                let old_value = ast_read_rawptr(ptr_offset(cur, 16));
                if (old_value != null) { free(old_value); }
                ast_write_rawptr(ptr_offset(cur, 16), new_value);
                ast_write_i64(ptr_offset(cur, 24), value.len);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return; }
        memset(node, 0, 40);
        ast_write_rawptr(node, ast_dup_c_string(name));
        ast_write_i64(ptr_offset(node, 8), name.len);
        ast_write_rawptr(ptr_offset(node, 16), ast_dup_c_string(value));
        ast_write_i64(ptr_offset(node, 24), value.len);
        ast_write_rawptr(ptr_offset(node, 32), self.head);
        self.head = node;
    }

    fn lookup(self, name: string) -> string {
        if (name.len == 0) { return ""; }
        var cur = self.head;
        while (cur != null) {
            let np = ast_read_rawptr(cur);
            let nl = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(np, nl, name)) {
                let vp = ast_read_rawptr(ptr_offset(cur, 16));
                let vl = ast_read_i64(ptr_offset(cur, 24));
                // Bindings are scratch state and are disposed immediately
                // after generic argument selection. Never let an instance
                // key retain a borrowed view into this map.
                if (vp != null && vl > 0) { return from_cstr_view_len(vp, vl).clone(); }
                return "";
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return "";
    }
}

fn hir_generic_binding_map_dispose(map: HirGenericBindingMap) -> HirGenericBindingMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 32));
        let name_ptr = ast_read_rawptr(cur);
        let value_ptr = ast_read_rawptr(ptr_offset(cur, 16));
        if (name_ptr != null) { free(name_ptr); }
        if (value_ptr != null) { free(value_ptr); }
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

class HirPackBindings {
    public head: rawptr

    public static fn create() -> HirPackBindings {
        return HirPackBindings { head: null };
    }

    fn restore(self, saved_head: rawptr) {
        self.head = saved_head;
    }

    fn drop_to(self, saved_head: rawptr) {
        var cur = self.head;
        while (cur != null && cur != saved_head) {
            let next = ast_read_rawptr(ptr_offset(cur, 32));
            let name_ptr = ast_read_rawptr(cur);
            let locals_buf = ast_read_rawptr(ptr_offset(cur, 16));
            if (name_ptr != null) { free(name_ptr); }
            if (locals_buf != null) { free(locals_buf); }
            free(cur);
            cur = next;
        }
        self.head = saved_head;
    }

    fn bind(self, name: string, locals_buf: rawptr, count: i32) {
        if (name.len == 0 || count < 0) { return; }
        var cur = self.head;
        while (cur != null) {
            let np = ast_read_rawptr(cur);
            let nl = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(np, nl, name)) {
                let old_buf = ast_read_rawptr(ptr_offset(cur, 16));
                if (old_buf != null && old_buf != locals_buf) { free(old_buf); }
                ast_write_rawptr(ptr_offset(cur, 16), locals_buf);
                ast_write_i32(ptr_offset(cur, 24), count);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return; }
        memset(node, 0, 40);
        ast_write_rawptr(node, ast_dup_c_string(name));
        ast_write_i64(ptr_offset(node, 8), name.len);
        ast_write_rawptr(ptr_offset(node, 16), locals_buf);
        ast_write_i32(ptr_offset(node, 24), count);
        ast_write_rawptr(ptr_offset(node, 32), self.head);
        self.head = node;
    }

    fn find(self, name: string) -> rawptr {
        if (name.len == 0) { return null; }
        var cur = self.head;
        while (cur != null) {
            let np = ast_read_rawptr(cur);
            let nl = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(np, nl, name)) { return cur; }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return null;
    }

    fn count(self, name: string) -> i32 {
        let node = self.find(name);
        if (node == null) { return 0; }
        return ast_read_i32(ptr_offset(node, 24));
    }

    fn local_at(self, name: string, idx: i32) -> i32 {
        let node = self.find(name);
        if (node == null || idx < 0) { return hir_id_invalid(); }
        let count = ast_read_i32(ptr_offset(node, 24));
        if (idx >= count) { return hir_id_invalid(); }
        let locals_buf = ast_read_rawptr(ptr_offset(node, 16));
        if (locals_buf == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(locals_buf, idx * 4));
    }
}

fn hir_pack_bindings_restore(bindings: HirPackBindings, saved_head: rawptr) -> HirPackBindings {
    bindings.head = saved_head;
    return bindings;
}

fn hir_pack_bindings_drop_to(bindings: HirPackBindings, saved_head: rawptr) -> HirPackBindings {
    bindings.drop_to(saved_head);
    return bindings;
}

fn hir_pack_bindings_bind(bindings: HirPackBindings, name: string, locals_buf: rawptr, count: i32) -> HirPackBindings {
    if (name.len == 0 || count < 0) { return bindings; }
    var cur = bindings.head;
    while (cur != null) {
        let np = ast_read_rawptr(cur);
        let nl = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(np, nl, name)) {
            let old_buf = ast_read_rawptr(ptr_offset(cur, 16));
            if (old_buf != null && old_buf != locals_buf) { free(old_buf); }
            ast_write_rawptr(ptr_offset(cur, 16), locals_buf);
            ast_write_i32(ptr_offset(cur, 24), count);
            return bindings;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    let node = hir_profile_malloc(40);
    if (node == null) { return bindings; }
    memset(node, 0, 40);
    ast_write_rawptr(node, ast_dup_c_string(name));
    ast_write_i64(ptr_offset(node, 8), name.len);
    ast_write_rawptr(ptr_offset(node, 16), locals_buf);
    ast_write_i32(ptr_offset(node, 24), count);
    ast_write_rawptr(ptr_offset(node, 32), bindings.head);
    bindings.head = node;
    return bindings;
}

fn hir_pack_bindings_find(bindings: HirPackBindings, name: string) -> rawptr {
    if (name.len == 0) { return null; }
    var cur = bindings.head;
    while (cur != null) {
        let np = ast_read_rawptr(cur);
        let nl = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(np, nl, name)) { return cur; }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return null;
}

fn hir_pack_bindings_count(bindings: HirPackBindings, name: string) -> i32 {
    let node = hir_pack_bindings_find(bindings, name);
    if (node == null) { return 0; }
    return ast_read_i32(ptr_offset(node, 24));
}

fn hir_pack_bindings_local_at(bindings: HirPackBindings, name: string, idx: i32) -> i32 {
    let node = hir_pack_bindings_find(bindings, name);
    if (node == null || idx < 0) { return hir_id_invalid(); }
    let count = ast_read_i32(ptr_offset(node, 24));
    if (idx >= count) { return hir_id_invalid(); }
    let locals_buf = ast_read_rawptr(ptr_offset(node, 16));
    if (locals_buf == null) { return hir_id_invalid(); }
    return ast_read_i32(ptr_offset(locals_buf, idx * 4));
}

fn hir_pack_bindings_dispose(bindings: HirPackBindings) -> HirPackBindings {
    return hir_pack_bindings_drop_to(bindings, null);
}

class HirDeclInstanceMap {
    public head: rawptr

    public static fn create() -> HirDeclInstanceMap {
        return HirDeclInstanceMap { head: null };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 40));
            let key_ptr = ast_read_rawptr(ptr_offset(cur, 8));
            if (key_ptr != null) { free(key_ptr); }
            free(cur);
            cur = next;
        }
        self.head = null;
    }

    fn put(self, decl_ptr: rawptr, key: string, item_id: i32, function_id: i32) {
        if (decl_ptr == null || key.len == 0) { return; }
        var cur = self.head;
        while (cur != null) {
            let d0 = ast_read_rawptr(cur);
            let kp0 = ast_read_rawptr(ptr_offset(cur, 8));
            let kl0 = ast_read_i64(ptr_offset(cur, 16));
            if (d0 == decl_ptr && hir_builder_c_string_equals(kp0, kl0, key)) {
                ast_write_i32(ptr_offset(cur, 24), item_id);
                ast_write_i32(ptr_offset(cur, 28), function_id);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        let node = hir_profile_malloc(48);
        if (node == null) { return; }
        memset(node, 0, 48);
        ast_write_rawptr(node, decl_ptr);
        ast_write_rawptr(ptr_offset(node, 8), ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 16), key.len);
        ast_write_i32(ptr_offset(node, 24), item_id);
        ast_write_i32(ptr_offset(node, 28), function_id);
        ast_write_rawptr(ptr_offset(node, 40), self.head);
        self.head = node;
    }

    fn item(self, decl_ptr: rawptr, key: string) -> i32 {
        if (decl_ptr == null || key.len == 0) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            let d0 = ast_read_rawptr(cur);
            let kp0 = ast_read_rawptr(ptr_offset(cur, 8));
            let kl0 = ast_read_i64(ptr_offset(cur, 16));
            if (d0 == decl_ptr && hir_builder_c_string_equals(kp0, kl0, key)) {
                return ast_read_i32(ptr_offset(cur, 24));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return hir_id_invalid();
    }

    fn function(self, decl_ptr: rawptr, key: string) -> i32 {
        if (decl_ptr == null || key.len == 0) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            let d0 = ast_read_rawptr(cur);
            let kp0 = ast_read_rawptr(ptr_offset(cur, 8));
            let kl0 = ast_read_i64(ptr_offset(cur, 16));
            if (d0 == decl_ptr && hir_builder_c_string_equals(kp0, kl0, key)) {
                return ast_read_i32(ptr_offset(cur, 28));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return hir_id_invalid();
    }

    // Instance shells deliberately do not overwrite decl_map: a declaration
    // can own both its direct function and many closed instances.  Recover
    // the source declaration by FunctionId when a reachability request starts
    // from an erased Sema target (for example a trait prototype rebounded to
    // a concrete implementation).
    fn decl_for_function(self, function_id: i32) -> rawptr {
        if (function_id == hir_id_invalid()) { return null; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(ptr_offset(cur, 28)) == function_id) {
                return ast_read_rawptr(cur);
            }
            cur = ast_read_rawptr(ptr_offset(cur, 40));
        }
        return null;
    }
}

class HirRawOwnerMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirRawOwnerMap {
        return HirRawOwnerMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn raw_hash(self, key: rawptr) -> i32 {
        var v = (key as i64) >> 4;
        if (v < 0) { v = -v; }
        v = ((v % 2147483647) * 131 + ((v >> 8) % 2147483647) * 17) % 2147483647;
        if (v < 0) { v = v + 2147483647; }
        return (v & 0x7fffffff) as i32;
    }

    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 4096;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let key = ast_read_rawptr(cur);
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 24), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
    }

    fn put(self, key: rawptr, owner: rawptr) {
        if (key == null || owner == null) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) {
                    ast_write_rawptr(ptr_offset(bcur, 8), owner);
                    return;
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            let bnode = hir_profile_malloc(32);
            if (bnode == null) { return; }
            memset(bnode, 0, 32);
            ast_write_rawptr(bnode, key);
            ast_write_rawptr(ptr_offset(bnode, 8), owner);
            ast_write_rawptr(ptr_offset(bnode, 16), self.head);
            ast_write_rawptr(ptr_offset(bnode, 24), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            return;
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) {
                ast_write_rawptr(ptr_offset(cur, 8), owner);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        let node = hir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, key);
        ast_write_rawptr(ptr_offset(node, 8), owner);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        self.head = node;
    }

    fn get(self, key: rawptr) -> rawptr {
        if (key == null) { return null; }
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) {
                    return ast_read_rawptr(ptr_offset(bcur, 8));
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            return null;
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) {
                return ast_read_rawptr(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return null;
    }
}

class HirRawTypeIdMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirRawTypeIdMap {
        return HirRawTypeIdMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn raw_hash(self, key: rawptr) -> i32 {
        var v = (key as i64) >> 4;
        if (v < 0) { v = -v; }
        v = ((v % 2147483647) * 131 + ((v >> 8) % 2147483647) * 17) % 2147483647;
        if (v < 0) { v = v + 2147483647; }
        return (v & 0x7fffffff) as i32;
    }

    // TypeRef identity is queried for every HIR type construction.  A flat
    // chain turns a large imported unit into O(type_refs^2) pointer walks.
    // Keep the insertion chain for deterministic disposal, and add a stable
    // pointer-identity index solely for lookup.
    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 4096;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let key = ast_read_rawptr(cur);
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 24), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
    }

    fn put(self, key: rawptr, type_id: i32) {
        if (key == null || type_id == hir_id_invalid()) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) {
                    ast_write_i32(ptr_offset(bcur, 8), type_id);
                    return;
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            let bnode = hir_profile_malloc(32);
            if (bnode == null) { return; }
            memset(bnode, 0, 32);
            ast_write_rawptr(bnode, key);
            ast_write_i32(ptr_offset(bnode, 8), type_id);
            ast_write_rawptr(ptr_offset(bnode, 16), self.head);
            ast_write_rawptr(ptr_offset(bnode, 24), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            return;
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) {
                ast_write_i32(ptr_offset(cur, 8), type_id);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        let node = hir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, key);
        ast_write_i32(ptr_offset(node, 8), type_id);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        self.head = node;
    }

    fn get(self, key: rawptr) -> i32 {
        if (key == null) { return hir_id_invalid(); }
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(self.raw_hash(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                if (ast_read_rawptr(bcur) == key) { return ast_read_i32(ptr_offset(bcur, 8)); }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            return hir_id_invalid();
        }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) { return ast_read_i32(ptr_offset(cur, 8)); }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return hir_id_invalid();
    }
}

class HirRawIntMap {
    public head: rawptr

    public static fn create() -> HirRawIntMap {
        return HirRawIntMap { head: null };
    }

    fn put(self, key: rawptr, value: i32) {
        if (key == null) { return; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) {
                ast_write_i32(ptr_offset(cur, 8), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        let node = hir_profile_malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_rawptr(node, key);
        ast_write_i32(ptr_offset(node, 8), value);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        self.head = node;
    }

    fn get(self, key: rawptr) -> i32 {
        if (key == null) { return -1; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(cur) == key) {
                return ast_read_i32(ptr_offset(cur, 8));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return -1;
    }
}

class HirRawPairIntMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirRawPairIntMap {
        return HirRawPairIntMap { head: null, buckets: null, bucket_cap: 0 };
    }
}

fn hir_builder_raw_pair_hash_i32(a: rawptr, b: rawptr) -> i32 {
    var av = (a as i64) >> 4;
    var bv = (b as i64) >> 4;
    if (av < 0) { av = -av; }
    if (bv < 0) { bv = -bv; }
    let pa = av % 2147483647;
    let pb = bv % 2147483647;
    var h: i64 = (pa * 131 + pb * 313 + ((pa ^ pb) % 2147483647)) % 2147483647;
    if (h < 0) { h = h + 2147483647; }
    return (h & 0x7fffffff) as i32;
}

fn hir_raw_pair_int_map_ensure_buckets(map: HirRawPairIntMap) -> HirRawPairIntMap {
    if (map.buckets != null && map.bucket_cap > 0) { return map; }
    map.bucket_cap = 65536;
    map.buckets = hir_builder_alloc_ptr_buckets(map.bucket_cap);
    if (map.buckets == null) {
        map.bucket_cap = 0;
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let key_a = ast_read_rawptr(cur);
        let key_b = ast_read_rawptr(ptr_offset(cur, 8));
        let slot = hir_builder_hash_slot(hir_builder_raw_pair_hash_i32(key_a, key_b), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        ast_write_rawptr(ptr_offset(cur, 32), ast_read_rawptr(slot_ptr));
        ast_write_rawptr(slot_ptr, cur);
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return map;
}

fn hir_raw_pair_int_map_put(map: HirRawPairIntMap, key_a: rawptr, key_b: rawptr, value: i32) -> HirRawPairIntMap {
    if (key_a == null || key_b == null) { return map; }
    map = hir_raw_pair_int_map_ensure_buckets(map);
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_raw_pair_hash_i32(key_a, key_b), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var bucket_cur = ast_read_rawptr(slot_ptr);
        while (bucket_cur != null) {
            if (ast_read_rawptr(bucket_cur) == key_a
                && ast_read_rawptr(ptr_offset(bucket_cur, 8)) == key_b) {
                ast_write_i32(ptr_offset(bucket_cur, 16), value);
                return map;
            }
            bucket_cur = ast_read_rawptr(ptr_offset(bucket_cur, 32));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return map; }
        memset(node, 0, 40);
        ast_write_rawptr(node, key_a);
        ast_write_rawptr(ptr_offset(node, 8), key_b);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), map.head);
        ast_write_rawptr(ptr_offset(node, 32), ast_read_rawptr(slot_ptr));
        map.head = node;
        ast_write_rawptr(slot_ptr, node);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_rawptr(cur) == key_a && ast_read_rawptr(ptr_offset(cur, 8)) == key_b) {
            ast_write_i32(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = hir_profile_malloc(40);
    if (node == null) { return map; }
    memset(node, 0, 40);
    ast_write_rawptr(node, key_a);
    ast_write_rawptr(ptr_offset(node, 8), key_b);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    map.head = node;
    return map;
}

fn hir_raw_pair_int_map_get(map: HirRawPairIntMap, key_a: rawptr, key_b: rawptr) -> i32 {
    if (key_a == null || key_b == null) { return -1; }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_raw_pair_hash_i32(key_a, key_b), map.bucket_cap);
        var bucket_cur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (bucket_cur != null) {
            if (ast_read_rawptr(bucket_cur) == key_a
                && ast_read_rawptr(ptr_offset(bucket_cur, 8)) == key_b) {
                return ast_read_i32(ptr_offset(bucket_cur, 16));
            }
            bucket_cur = ast_read_rawptr(ptr_offset(bucket_cur, 32));
        }
        return -1;
    }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_rawptr(cur) == key_a && ast_read_rawptr(ptr_offset(cur, 8)) == key_b) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return -1;
}

fn hir_raw_pair_int_map_dispose(map: HirRawPairIntMap) -> HirRawPairIntMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}

